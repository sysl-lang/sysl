module sysl.sys

// What `sysl.math` asks of the C mathematics library, and the whole of what it asks.
//
// These are here rather than beside their callers for the reason the module exists: a name in
// `sysl.sys` is one the rest of the library may reach and nothing else may, so every declaration in
// the library that is not sysl is in one place and the surface a host has to supply can be read off
// a single file. The link names are libm's own, and each is bound to a `sysl_`-prefixed word for the
// same reason `putchar` is -- `sqrt`, `pow` and `floor` are words a program is entitled to declare
// itself, and `guide/fft` did exactly that before there was a module to ask.
//
// Two entry points per operation, because C names the widths apart and sysl has no overloading to
// hide it behind: `sqrt` takes a `double`, `sqrtf` a `float`. `sysl.math` is where that stops being
// visible, and it stops there by dispatching on the receiver's type rather than by a caller
// choosing.
//
// The transcendentals are here and the sign and comparison operations are not, and the line is
// deliberate. What C is asked for is what C has an *algorithm* for -- a correctly rounded root, a
// range-reduced sine, the base-2 exponent read straight out of the representation. An absolute value
// is a comparison and a negation, so `sysl.math` writes it in sysl and calls nothing.

// Roots, exponentials and logarithms.
private[sysl] extern "sqrt" sysl_sqrt(x: f64) -> f64
private[sysl] extern "sqrtf" sysl_sqrtf(x: f32) -> f32
private[sysl] extern "cbrt" sysl_cbrt(x: f64) -> f64
private[sysl] extern "cbrtf" sysl_cbrtf(x: f32) -> f32
private[sysl] extern "exp" sysl_exp(x: f64) -> f64
private[sysl] extern "expf" sysl_expf(x: f32) -> f32
private[sysl] extern "exp2" sysl_exp2(x: f64) -> f64
private[sysl] extern "exp2f" sysl_exp2f(x: f32) -> f32
private[sysl] extern "log" sysl_log(x: f64) -> f64
private[sysl] extern "logf" sysl_logf(x: f32) -> f32
private[sysl] extern "log2" sysl_log2(x: f64) -> f64
private[sysl] extern "log2f" sysl_log2f(x: f32) -> f32
private[sysl] extern "log10" sysl_log10(x: f64) -> f64
private[sysl] extern "log10f" sysl_log10f(x: f32) -> f32

// Powers, and the two-argument length that is written this way to keep the square of a large
// operand off the path.
private[sysl] extern "pow" sysl_pow(x: f64, y: f64) -> f64
private[sysl] extern "powf" sysl_powf(x: f32, y: f32) -> f32
private[sysl] extern "hypot" sysl_hypot(x: f64, y: f64) -> f64
private[sysl] extern "hypotf" sysl_hypotf(x: f32, y: f32) -> f32

// Circular trigonometry. `atan2` takes the two coordinates rather than their ratio, which is what
// makes it able to answer in all four quadrants.
private[sysl] extern "sin" sysl_sin(x: f64) -> f64
private[sysl] extern "sinf" sysl_sinf(x: f32) -> f32
private[sysl] extern "cos" sysl_cos(x: f64) -> f64
private[sysl] extern "cosf" sysl_cosf(x: f32) -> f32
private[sysl] extern "tan" sysl_tan(x: f64) -> f64
private[sysl] extern "tanf" sysl_tanf(x: f32) -> f32
private[sysl] extern "asin" sysl_asin(x: f64) -> f64
private[sysl] extern "asinf" sysl_asinf(x: f32) -> f32
private[sysl] extern "acos" sysl_acos(x: f64) -> f64
private[sysl] extern "acosf" sysl_acosf(x: f32) -> f32
private[sysl] extern "atan" sysl_atan(x: f64) -> f64
private[sysl] extern "atanf" sysl_atanf(x: f32) -> f32
private[sysl] extern "atan2" sysl_atan2(y: f64, x: f64) -> f64
private[sysl] extern "atan2f" sysl_atan2f(y: f32, x: f32) -> f32

// Hyperbolic trigonometry.
private[sysl] extern "sinh" sysl_sinh(x: f64) -> f64
private[sysl] extern "sinhf" sysl_sinhf(x: f32) -> f32
private[sysl] extern "cosh" sysl_cosh(x: f64) -> f64
private[sysl] extern "coshf" sysl_coshf(x: f32) -> f32
private[sysl] extern "tanh" sysl_tanh(x: f64) -> f64
private[sysl] extern "tanhf" sysl_tanhf(x: f32) -> f32

// Rounding to an integral value, all four of which answer in the float's own type: a `floor` that
// returned an integer would be undefined for the operands that do not fit one, and the caller who
// wants an integer is the one who knows the range.
private[sysl] extern "floor" sysl_floor(x: f64) -> f64
private[sysl] extern "floorf" sysl_floorf(x: f32) -> f32
private[sysl] extern "ceil" sysl_ceil(x: f64) -> f64
private[sysl] extern "ceilf" sysl_ceilf(x: f32) -> f32
private[sysl] extern "round" sysl_round(x: f64) -> f64
private[sysl] extern "roundf" sysl_roundf(x: f32) -> f32
private[sysl] extern "trunc" sysl_trunc(x: f64) -> f64
private[sysl] extern "truncf" sysl_truncf(x: f32) -> f32
private[sysl] extern "fmod" sysl_fmod(x: f64, y: f64) -> f64
private[sysl] extern "fmodf" sysl_fmodf(x: f32, y: f32) -> f32

// The sign transfer, which is a bit operation rather than a comparison and so belongs on this side
// of the line: it carries the sign of a zero and of a NaN, which `if x < 0` cannot see.
private[sysl] extern "copysign" sysl_copysign(x: f64, y: f64) -> f64
private[sysl] extern "copysignf" sysl_copysignf(x: f32, y: f32) -> f32
