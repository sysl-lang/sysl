module sh.sysl.compiler
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.env.{get as env_var}
import sysl.fs.{make_temp_dir, metadata, read_text, remove_file, walk, write_text}
import sysl.text.{parse_int, split, str_builder, Search}

// **The spans sweep: the same trees as the `--no-spans` sweeps, compared WITH their spans.**
//
// `tests_oracle.sysl` proves the two compilers build the same tree; this file measures how far apart
// they are on where each node was written. The reference prints a node's ANCHOR (`pos`: a call at
// its callee, an index at its `[`, a `match` at its scrutinee) and this compiler prints the node's
// EXTENT, so the two agree on most lines and differ on a known set of kinds. Every line that differs
// only in its span is put in one of three classes:
//
// - **extent** -- this compiler's extent is wrong: the reference's span reaches outside it (a
//   `Param` stopping before its default, a `Lambda` ending on the first line of its block, a
//   `Compare` starting at its left operand's `.field` rather than at the receiver), or sits inside it
//   on a kind the reference does not anchor (a `MatchArm` ending a column late);
// - **anchor** -- the reference's anchor sits inside this compiler's extent on a kind it anchors, or
//   the reference printed no span at all (a chained `Binary`), or the node is one of the four whose
//   span is neither here (`Index`, `TypeArgs`, `TypeAttr`, `Field`);
// - **other** -- this compiler printed no span where the reference did, the line differs in more
//   than its span, or the two trees are not the same length.
//
// **Each class and node kind is held to a ratchet**, `scripts/spans_ratchet.tsv` (see the ratchet
// section for how it allows for the trees growing): a kind with no row, or one rising faster than the
// trees, fails; one below its row passes and says which row to lower. Repairing extents takes out the
// `extent` rows; giving this tree an anchor of its own takes out the `anchor` rows; with no rows left
// `emit-ast` is byte-identical with spans. `SYSL_ORACLE_SUMMARY` receives every count.

private span_oracle() -> Option[string] = env_var("SYSL_ORACLE")

private span_present(path: string) -> bool = metadata(path).is_ok()

private span_source(path: string) -> bool = path.ends_with(".sysl") || path.ends_with(".lsysl")

// -- one printed line, taken apart --------------------------------------------------------------

// A node line of either tree: the node's kind (the first word starting with a capital), the span
// printed after it as two points, and the line with that span taken out -- which is what has to be
// the same on both sides for the difference to be about the span alone.
struct SpanLine
    kind: string
    span: Option[(int, int)]
    bare: string
end SpanLine

// `12:5` as one number that orders as the position does.
private span_point(text: string) -> Option[int]
    val colon = text.index_of(":") match
        Some(at) -> at
        None -> return None

    parse_int(text[..<colon]) match
        Err(_) -> None
        Ok(line) ->
            parse_int(text[colon + 1..]) match
                Err(_) -> None
                Ok(col) -> Some(line * 100000 + col)
end span_point

// `12:5-12:9` as its two points, or nothing where the word is not a span.
span_of_word(word: string) -> Option[(int, int)]
    val dash = word.index_of("-") match
        Some(at) -> at
        None -> return None

    span_point(word[..<dash]) match
        None -> None
        Some(a) ->
            span_point(word[dash + 1..]) match
                None -> None
                Some(b) -> Some((a, b))
end span_of_word

private capital(word: string) -> bool = word.bytes.len > 0 && word.bytes[0] >= u8('A') && word.bytes[0] <= u8('Z')

span_line(line: string) -> SpanLine
    val words = split(line, " ")
    var kind = ""
    var at: usize = 0
    var found = false

    for i in 0..<words.len
        if !found && capital(words[i])
            kind = words[i]
            at = i
            found = true

    if !found || at + 1 >= words.len then return SpanLine(kind, None, line)

    val span = span_of_word(words[at + 1])

    if span.is_none() then return SpanLine(kind, None, line)

    var bare = str_builder()

    for i in 0..<words.len
        if i != at + 1
            if i > 0 then bare.push(" ")

            bare.push(words[i])

    SpanLine(kind, span, bare.finish())
end span_line

// -- the three classes ----------------------------------------------------------------------------

enum SpanGap
    ExtentWrong
    AnchorNotExtent
    SpanOther

span_gap_word(g: SpanGap) -> string = g match
    ExtentWrong -> "extent"
    AnchorNotExtent -> "anchor"
    SpanOther -> "other"

// The kinds whose printed span is neither an extent nor the reference's anchor here, whatever the two
// spans are -- the anchor model's own rows.
private anchor_model_kind(kind: string) -> bool
    for name in ["Index", "TypeArgs", "TypeAttr", "Field"]
        if kind == name then return true

    false
end anchor_model_kind

// The kinds the reference anchors somewhere inside the node: a call at its callee, a statement at its
// expression, a member at its name without the `private` before it, and the rest of the reference's
// anchoring decisions.
private anchored_kind(kind: string) -> bool
    for name in ["Call", "ExprStmt", "WithExpr", "TryExpr", "PostIncDec", "ResultList", "MatchExpr",
                 "IfExpr", "Binary", "Block", "ValueArgType", "Lambda", "LambdaParam", "NamedArg",
                 "PatternDecl", "Ident", "MethodDecl", "Param", "LinkClause", "IncludeClause",
                 "ExternDecl", "StructDecl", "TypeDecl"]
        if kind == name then return true

    false
end anchored_kind

// Which class a line differing only in its span is in. **A typed node's span is its AST node's
// anchor**, so on the typed tree every kind counts as anchored.
classify_span(kind: string, theirs: Option[(int, int)], ours: Option[(int, int)],
              typed: bool) -> SpanGap
    theirs match
        None -> if ours.is_none() then SpanOther else AnchorNotExtent
        Some(r) ->
            ours match
                None -> SpanOther
                Some(s) ->
                    val inside = r.0 >= s.0 && r.1 <= s.1

                    if anchor_model_kind(kind) then AnchorNotExtent
                    else if inside && (typed || anchored_kind(kind)) then AnchorNotExtent
                    else ExtentWrong
end classify_span

// -- what a sweep found ---------------------------------------------------------------------------

struct SpanTally
    files: usize
    lines: usize
    extent: usize
    anchor: usize
    other: usize

    // `<class> <kind>` against how many lines, for the summary.
    kinds: Buf[(string, usize)]

    // The first few differing lines of every class, quoted from both sides with the class beside them,
    // so a row of the ratchet can be traced to the nodes it counts.
    first_lines: string
end SpanTally

private empty_tally() -> SpanTally = SpanTally(0, 0, 0, 0, 0, buf(), "")

tally_kind(counts: *Buf[(string, usize)], what: string)
    for i in 0..<counts.len()
        if counts.at(i).0 == what
            counts.set(i, (what, counts.at(i).1 + 1))
            return

    counts.push((what, 1))
end tally_kind

private count_gap(found: *SpanTally, gap: SpanGap, kind: string, label: string, theirs: string,
                  ours: string)
    gap match
        ExtentWrong -> found.extent += 1
        AnchorNotExtent -> found.anchor += 1
        SpanOther -> found.other += 1

    if found.extent + found.anchor + found.other <= 12 then
        found.first_lines = s"${found.first_lines}\n  $label (${span_gap_word(gap)}): reference [$theirs] ours [$ours]"

    tally_kind(&found.kinds, s"${span_gap_word(gap)} ${if kind == "" then "?" else kind}")
end count_gap

// Two renderings of one tree, compared line by line and every differing line classed.
compare_spanned(theirs: string, ours: string, label: string, typed: bool, found: *SpanTally)
    val a = split(theirs, "\n")
    val b = split(ours, "\n")

    found.files += 1

    if a.len != b.len
        count_gap(found, SpanOther, "TreeLength", label, s"${a.len} lines", s"${b.len} lines")
        return
    end if

    for i in 0..<a.len
        found.lines += 1

        if a[i] != b[i]
            val r = span_line(a[i])
            val s = span_line(b[i])

            val gap = if r.bare != s.bare then SpanOther
            else classify_span(r.kind, r.span, s.span, typed)

            count_gap(found, gap, r.kind, label, a[i], b[i])
end compare_spanned

// The tally's per-kind rows, one to a line, for the summary file.
private kind_rows(found: SpanTally) -> string
    var out = str_builder()

    for i in 0..<found.kinds.len()
        out.push(s"\n  ${found.kinds.at(i).1} ${found.kinds.at(i).0}")

    out.finish()
end kind_rows

// -- the ratchet ----------------------------------------------------------------------------------
//
// **The corpora grow with every commit** -- this compiler's own tree is one of them -- so a bare
// count of differing lines would rise with every new call anyone writes. The ratchet therefore holds
// each `<class> <kind>` to its DENSITY: a row records the lines it had when the ratchet was set, a
// `lines` row the size of the trees then, and a count may grow with the trees and a margin (a twentieth
// and ten lines) but no faster. A kind with no row fails outright -- a node newly placed wrongly is
// the regression this exists to catch -- and a count below its row passes and says to lower it.

// One row's count, read out of the file's text: tab-separated `<sweep> <class> <kind> <lines>` rows,
// `#` comments and blank lines aside. The trees' size is the row `<sweep> lines - <lines>`.
ratchet_of(text: string, sweep: string, class: string, kind: string) -> Option[usize]
    for line in split(text, "\n")
        if line != "" && !line.starts_with("#")
            val cols = split(line, "\t")

            if cols.len == 4 && cols[0] == sweep && cols[1] == class && cols[2] == kind
                parse_int(cols[3]) match
                    Ok(n) -> if n >= 0 then return Some(usize(n))
                    Err(_) -> ()

    None
end ratchet_of

// Every `<class> <kind>` row of one sweep, the `lines` row aside.
private ratchet_rows(text: string, sweep: string) -> Buf[string]
    var out: Buf[string] = buf()

    for line in split(text, "\n")
        if line != "" && !line.starts_with("#")
            val cols = split(line, "\t")

            if cols.len == 4 && cols[0] == sweep && cols[1] != "lines" then out.push(s"${cols[1]} ${cols[2]}")

    out
end ratchet_rows

// How many lines a row allows once the trees have grown from `base` lines to `now`.
ratchet_allows(row: usize, now: usize, base: usize) -> usize
    val scaled = if base == 0 || now <= base then row else row * now / base

    scaled + row / 20 + 10
end ratchet_allows

// One `<class> <kind>` count against its row: whether it holds, and what to say -- nothing where it
// sits at its row, the row to lower or delete where it fell, the failure where it rose past what the
// trees' growth allows or where the kind has no row at all.
ratchet_verdict(what: string, count: usize, row: Option[usize], now: usize, base: usize) -> (bool, string)
    row match
        None ->
            if count == 0 then (true, "")
            else (false, s"$what: $count lines and no ratchet row -- a node kind newly differs from " +
                         "the reference; the summary file quotes the first lines")
        Some(r) ->
            if count > ratchet_allows(r, now, base)
                (false, s"$what: $count lines, ABOVE the ratchet's $r (allowing ${ratchet_allows(r, now, base)} " +
                        s"at $now lines against $base) -- a span got further from the reference's")
            else if count == 0
                (true, s"$what: gone -- delete its row from scripts/spans_ratchet.tsv")
            else if count < r
                (true, s"$what: $count lines, below the ratchet's $r -- lower its row of " +
                       s"scripts/spans_ratchet.tsv to $count")
            else
                (true, "")
end ratchet_verdict

private count_of_kind(kinds: Buf[(string, usize)], key: string) -> usize
    for i in 0..<kinds.len()
        if kinds.at(i).0 == key then return kinds.at(i).1

    0
end count_of_kind

private row_of(text: string, sweep: string, key: string) -> Option[usize]
    val space = key.index_of(" ").unwrap_or(0)

    ratchet_of(text, sweep, key[..<space], key[space + 1..])
end row_of

// Every `<class> <kind>` of one sweep against the repository's ratchet; answers the failures, one to
// a line. `lines` is what the counts were taken over -- tree lines for a spans sweep, reports
// compared for a caret sweep (`tests_crt_caret_sweep.sysl`).
hold_to_ratchet(sweep: string, lines: usize, kinds: Buf[(string, usize)]) -> string
    val text = read_text("../scripts/spans_ratchet.tsv").unwrap_or("")
    var failures = str_builder()

    val base = ratchet_of(text, sweep, "lines", "-") match
        Some(n) -> n
        None ->
            failures.push(s"\nscripts/spans_ratchet.tsv has no '$sweep lines' row")
            0

    var asked: Buf[string] = buf()

    for i in 0..<kinds.len()
        asked.push(kinds.at(i).0)

    val listed = ratchet_rows(text, sweep)

    for i in 0..<listed.len()
        if count_of_kind(kinds, listed.at(i)) == 0 then asked.push(listed.at(i))

    for i in 0..<asked.len()
        val key = asked.at(i)
        val verdict = ratchet_verdict(s"$sweep $key", count_of_kind(kinds, key),
                                      row_of(text, sweep, key), lines, base)

        if verdict.1 != ""
            print(verdict.1)
            record_summary(verdict.1)

        if !verdict.0 then failures.push(s"\n${verdict.1}")

    failures.finish()
end hold_to_ratchet

private summary_of(sweep: string, unit: string, found: SpanTally) -> string =
    s"spans ($sweep): ${found.files} $unit, ${found.lines} lines, ${found.extent} extent, " +
    s"${found.anchor} anchor, ${found.other} other"

// -- emit-ast, with spans -------------------------------------------------------------------------

// One input, both trees with spans. A refusal on either side is left to the `--no-spans` sweep,
// which compares the two messages.
private ast_spans_one(binary: string, path: string, text: string, label: string, found: *SpanTally)
    val parsed = parse(source_of(path, text))

    if !parsed.ok() then return

    capture_oracle(binary, ["emit-ast", path]) match
        Err(_) -> ()
        Ok(answer) ->
            if answer.status.ok()
                compare_spanned(without_trailing_newlines(answer.text),
                                without_trailing_newlines(emit_ast(parsed.program, true)), label, false,
                                found)
end ast_spans_one

// A block written in a construct the reference reads as something else -- an `f"…"` specifier whose
// count is a hole (`reference/strings.md`), ordinary text and a hole to 0.0.162 -- builds a tree of
// another shape there, so it is left out here as the `--no-spans` sweep excuses it
// (`tests_oracle.sysl`'s `judge`).
private read_differently(text: string, listed: Buf[OnlyHere]) -> bool = self_hosted_construct(text, listed) match
    Some(c) -> read_otherwise(c)
    None -> false

private ast_spans_tree(binary: string, root: string, found: *SpanTally)
    for item in walk(root)
        item match
            Err(_) -> ()
            Ok(entry) ->
                if span_source(entry.path)
                    read_text(entry.path) match
                        Err(_) -> ()
                        Ok(text) -> ast_spans_one(binary, entry.path, text, entry.path, found)
end ast_spans_tree

@test("spans: emit-ast with spans differs from the reference no more than the ratchet allows")
spn_the_ast_spans_hold_the_ratchet()
    span_oracle() match
        None ->
            print("skipped: SYSL_ORACLE names no reference compiler on this machine")
            return
        Some(binary) ->
            var found = empty_tally()

            ast_spans_tree(binary, "sh", &found)

            for root in ["../library", "../../parsing"]
                if span_present(root) then ast_spans_tree(binary, root, &found)

            val pages = "../docs/content/reference"

            if span_present(pages)
                val dir = make_temp_dir("sysl-spans").unwrap()
                val scratch = dir + "/block.sysl"
                val listed = self_hosted_only()

                for item in walk(pages)
                    item match
                        Err(_) -> ()
                        Ok(entry) ->
                            if entry.path.ends_with(".md")
                                read_text(entry.path) match
                                    Err(_) -> ()
                                    Ok(page) ->
                                        val blocks = sysl_blocks(page)

                                        for i in 0..<blocks.len()
                                            if read_differently(blocks.at(i), listed) then continue

                                            write_text(scratch, blocks.at(i)).unwrap()
                                            ast_spans_one(binary, scratch, blocks.at(i),
                                                          s"${entry.path} block ${i + 1}", &found)

                remove_file(scratch)
            end if

            val summary = summary_of("emit-ast", "inputs", found)

            print(summary)
            record_summary(s"$summary${kind_rows(found)}${found.first_lines}")

            assert(found.files >= 500, s"the sweep read the corpora and the pages: ${found.files} inputs")
            assert_eq(hold_to_ratchet("emit-ast", found.lines, found.kinds), "")
end spn_the_ast_spans_hold_the_ratchet

// -- emit-typed, with spans -----------------------------------------------------------------------

// One block's functions, both typed trees with spans, over exactly the bodies the `--no-spans` typed
// sweep compares: analyzed without the library, a block this compiler had anything to say about left
// out, and a function the reference did not print left out.
private typed_spans_one(binary: string, path: string, text: string, label: string,
                        found: *SpanTally)
    val parsed = parse(source_of(path, text))

    if !parsed.ok() then return

    var units: Buf[Program] = buf()

    units.push(parsed.program)

    val ours = analyze_bodies(units, host_target())

    if ours.funcs.is_empty() || !ours.reported.is_empty() then return

    capture_oracle(binary, ["emit-typed", path]) match
        Err(_) -> ()
        Ok(answer) ->
            if answer.status.ok()
                val printed = printed_funcs(answer.text)

                for i in 0..<ours.funcs.len()
                    val f = ours.funcs.at(i)

                    block_named(printed, f.name) match
                        None -> ()
                        Some(theirs) ->
                            val before = set_typed_spans(true)
                            val mine = show_typed_func(f)

                            set_typed_spans(before)
                            compare_spanned(without_trailing_newlines(theirs),
                                            without_trailing_newlines(mine), s"$label ${f.name}", true,
                                            found)
end typed_spans_one

@test("spans: emit-typed with spans differs from the reference no more than the ratchet allows")
spn_the_typed_spans_hold_the_ratchet()
    span_oracle() match
        None ->
            print("skipped: SYSL_ORACLE names no reference compiler on this machine")
            return
        Some(binary) ->
            val pages = "../docs/content/reference"

            if !span_present(pages)
                print("skipped: the reference pages are not on this machine")
                return
            end if

            val dir = make_temp_dir("sysl-typed-spans").unwrap()
            val scratch = dir + "/block.sysl"
            var found = empty_tally()

            for item in walk(pages)
                item match
                    Err(_) -> ()
                    Ok(entry) ->
                        if entry.path.ends_with(".md")
                            read_text(entry.path) match
                                Err(_) -> ()
                                Ok(page) ->
                                    val blocks = sysl_blocks(page)

                                    for i in 0..<blocks.len()
                                        write_text(scratch, blocks.at(i)).unwrap()
                                        typed_spans_one(binary, scratch, blocks.at(i),
                                                        s"${entry.path} block ${i + 1}", &found)

            remove_file(scratch)

            val summary = summary_of("emit-typed", "functions", found)

            print(summary)
            record_summary(s"$summary${kind_rows(found)}${found.first_lines}")

            assert(found.files > 0, "the sweep compared something")
            assert_eq(hold_to_ratchet("emit-typed", found.lines, found.kinds), "")
end spn_the_typed_spans_hold_the_ratchet

// -- the classifier and the ratchet, without a reference ------------------------------------------

@test("spans: a node line is taken apart into its kind, its span and the line without it")
spn_a_line_is_taken_apart()
    val l = span_line("              expr: Call 101:34-101:39")

    assert_eq(l.kind, "Call")
    assert_eq(l.span.unwrap().0, 10100034)
    assert_eq(l.span.unwrap().1, 10100039)
    assert_eq(l.bare, "              expr: Call")

    val item = span_line("          - ExprStmt 3:1-12:4")

    assert_eq(item.kind, "ExprStmt")
    assert_eq(item.span.unwrap().0, 300001)
    assert_eq(item.span.unwrap().1, 1200004)
    assert_eq(item.bare, "          - ExprStmt")

    val plain = span_line("        body: TBlock")

    assert_eq(plain.kind, "TBlock")
    assert(plain.span.is_none(), "a kind with no span after it has none")
    assert_eq(plain.bare, "        body: TBlock")

    val field = span_line("            name: \"Foo 1:2-1:3\"")

    assert(field.span.is_none(), "a quoted word is not a kind, nor the span after it")
end spn_a_line_is_taken_apart

@test("spans: a word that is not two points is not a span")
spn_a_word_that_is_not_a_span()
    assert(span_of_word("12:5").is_none(), "one point")
    assert(span_of_word("a:b-c:d").is_none(), "not numbers")
    assert(span_of_word("1:2-3").is_none(), "a second point with no column")
    assert_eq(span_of_word("1:2-3:4").unwrap().0, 100002)
    assert_eq(span_of_word("1:2-3:4").unwrap().1, 300004)
end spn_a_word_that_is_not_a_span

@test("spans: a call anchored at its callee inside our extent is an anchor difference")
spn_an_anchor_inside_the_extent()
    val g = classify_span("Call", span_of_word("101:34-101:39"), span_of_word("101:34-101:52"), false)

    assert(g == AnchorNotExtent, span_gap_word(g))
end spn_an_anchor_inside_the_extent

@test("spans: a reference span reaching past our end, or starting before our start, is a wrong extent")
spn_a_span_outside_is_a_wrong_extent()
    // `Param` stopping before its default.
    val past = classify_span("Param", span_of_word("3:7-3:20"), span_of_word("3:7-3:13"), false)

    assert(past == ExtentWrong, span_gap_word(past))

    // `Compare` starting at its left operand's field rather than at the receiver.
    val later = classify_span("Compare", span_of_word("5:4-5:15"), span_of_word("5:6-5:15"), false)

    assert(later == ExtentWrong, span_gap_word(later))
end spn_a_span_outside_is_a_wrong_extent

@test("spans: a span inside ours on a kind the reference does not anchor is a wrong extent")
spn_inside_on_an_unanchored_kind()
    // `MatchArm` ending a column late here.
    val arm = classify_span("MatchArm", span_of_word("7:9-7:20"), span_of_word("7:9-7:21"), false)

    assert(arm == ExtentWrong, span_gap_word(arm))

    // The same two spans on the typed tree, where every span is an anchor.
    val typed = classify_span("TMatch", span_of_word("7:9-7:20"), span_of_word("7:9-7:21"), true)

    assert(typed == AnchorNotExtent, span_gap_word(typed))
end spn_inside_on_an_unanchored_kind

@test("spans: no span from the reference is an anchor difference, and none from us is other")
spn_a_missing_span()
    val theirs_none = classify_span("Binary", None, span_of_word("4:5-4:10"), false)

    assert(theirs_none == AnchorNotExtent, span_gap_word(theirs_none))

    val ours_none = classify_span("Binary", span_of_word("4:5-4:10"), None, false)

    assert(ours_none == SpanOther, span_gap_word(ours_none))
end spn_a_missing_span

@test("spans: the four anchor-model kinds are anchor differences wherever the two spans lie")
spn_the_anchor_model_kinds()
    // `TypeAttr` anchored at the `::` before the name this compiler spans.
    val attr = classify_span("TypeAttr", span_of_word("2:5-2:7"), span_of_word("2:7-2:10"), false)

    assert(attr == AnchorNotExtent, span_gap_word(attr))
end spn_the_anchor_model_kinds

@test("spans: a line differing in more than its span, or a tree of another length, is other")
spn_a_shape_difference_is_other()
    var found = empty_tally()

    compare_spanned("- Call 1:1-1:5\n    name: \"f\"", "- Call 1:1-1:9\n    name: \"g\"", "x", false,
                    &found)

    assert_eq(found.anchor, 1)
    assert_eq(found.other, 1)
    assert_eq(found.lines, 2)

    var short = empty_tally()

    compare_spanned("- Call 1:1-1:5\n- Ident 1:1-1:2", "- Call 1:1-1:5", "y", false, &short)

    assert_eq(short.other, 1)
    assert_eq(short.lines, 0)
end spn_a_shape_difference_is_other

@test("spans: identical trees count every line and class none of them")
spn_identical_trees_class_nothing()
    var found = empty_tally()

    compare_spanned("- Call 1:1-1:5\n    callee: Ident 1:1-1:2", "- Call 1:1-1:5\n    callee: Ident 1:1-1:2",
                    "z", false, &found)

    assert_eq(found.lines, 2)
    assert_eq(found.extent + found.anchor + found.other, 0)
end spn_identical_trees_class_nothing

@test("spans: a count above what its row allows fails, below its row passes and names the row to lower")
spn_the_ratchet_verdicts()
    val rose = ratchet_verdict("emit-ast extent Compare", 21, Some(10), 100, 100)

    assert(!rose.0, "a rise past the margin fails")
    assert(rose.1.contains("ABOVE"), rose.1)

    val margin = ratchet_verdict("emit-ast extent Compare", 20, Some(10), 100, 100)

    assert(margin.0, "a rise inside the margin passes")

    val fell = ratchet_verdict("emit-ast extent Compare", 9, Some(10), 100, 100)

    assert(fell.0, "a fall passes")
    assert(fell.1.contains("to 9"), fell.1)

    val gone = ratchet_verdict("emit-ast extent Compare", 0, Some(10), 100, 100)

    assert(gone.0, "a kind that vanished passes")
    assert(gone.1.contains("delete"), gone.1)

    val held = ratchet_verdict("emit-ast extent Compare", 10, Some(10), 100, 100)

    assert(held.0, "an equal count passes")
    assert_eq(held.1, "")
end spn_the_ratchet_verdicts

@test("spans: a kind with no ratchet row fails, and an absent one with none says nothing")
spn_a_kind_with_no_row()
    val fresh = ratchet_verdict("emit-ast extent Defer", 1, None, 100, 100)

    assert(!fresh.0, "a newly wrong kind fails")
    assert(fresh.1.contains("no ratchet row"), fresh.1)

    val absent = ratchet_verdict("emit-ast extent Defer", 0, None, 100, 100)

    assert(absent.0, "nothing to say")
    assert_eq(absent.1, "")
end spn_a_kind_with_no_row

@test("spans: a row allows growth with the trees, and no more than a twentieth and ten lines beyond it")
spn_the_ratchet_scales_with_the_trees()
    assert_eq(ratchet_allows(1000, 100, 100), 1060)
    assert_eq(ratchet_allows(1000, 200, 100), 2060)
    assert_eq(ratchet_allows(1000, 50, 100), 1060)

    // A tenfold rise in one kind's lines over trees grown a tenth is still a failure.
    assert(!ratchet_verdict("x", 10000, Some(1000), 110, 100).0, "density rose")
end spn_the_ratchet_scales_with_the_trees

@test("spans: the ratchet is read by sweep, class and kind, comments and blank lines aside")
spn_the_ratchet_is_read()
    val text = "# sweep\tclass\tkind\tlines\n\nemit-ast\tlines\t-\t900\nemit-ast\textent\tCompare\t42\n" +
               "emit-ast\tanchor\tCall\t7\nemit-typed\textent\tTFunc\t3\n"

    assert_eq(ratchet_of(text, "emit-ast", "lines", "-").unwrap_or(0), 900)
    assert_eq(ratchet_of(text, "emit-ast", "extent", "Compare").unwrap_or(0), 42)
    assert_eq(ratchet_of(text, "emit-ast", "anchor", "Call").unwrap_or(0), 7)
    assert_eq(ratchet_of(text, "emit-typed", "extent", "TFunc").unwrap_or(0), 3)
    assert(ratchet_of(text, "emit-typed", "anchor", "Call").is_none(), "a row not written is none")
    assert_eq(ratchet_rows(text, "emit-ast").len(), 2)
end spn_the_ratchet_is_read

// A sweep with no kind left to differ has no row but its size: `emit-ast` agrees with the reference
// span for span since the typed tree took the anchor and an `asm` arm its whole extent, and
// `emit-typed` since a member's function took its declaration's span.
@test("spans: the repository's ratchet carries the size of every sweep it holds")
spn_the_repository_ratchet_is_complete()
    val text = read_text("../scripts/spans_ratchet.tsv").unwrap_or("")

    for sweep in ["emit-ast", "emit-typed", "carets-ast", "carets-whole"]
        assert(ratchet_of(text, sweep, "lines", "-").is_some(), s"a '$sweep lines' row")

    for sweep in ["emit-ast", "emit-typed"]
        assert(ratchet_rows(text, sweep).is_empty(), s"no $sweep kind differs")
end spn_the_repository_ratchet_is_complete
