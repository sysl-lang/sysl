module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.{str_builder, StrBuilder}

// A call to a generic declaration: its type arguments worked out from what the call supplies, the
// instantiation made real, and the arguments checked against the signature that instantiation has.
//
// **Inference is bidirectional and the order is the whole of the precedence.** What already carries a
// type of its own settles a parameter first, the type the position expects settles what is left, and
// a bare literal's default only reaches a parameter nothing else did.

// `f[int](x)` -- the instantiation the reader named.
//
// **Written out, the type arguments are what settle the instantiation and nothing else is
// consulted**: not the arguments, and not the type the position expects. Their whole reason for
// existing is the call inference cannot reach, so a solve running first would report a failure about
// a question the reader has already answered.
written_generic_call(cx: &Analyzer, span: Span, written: string, targ_exprs: Buf[Expr],
                     args: Buf[Expr], expected: Option[Type]) -> TExpr
    val keys = function_keys(cx, written)

    if keys.is_empty() then return cx.err(span, s"undefined function '$written'")

    var key = keys.at(0)

    for i in 0..<keys.len()
        val f = cx.an.tables.funcs.get(keys.at(i))

        if f.is_some() && f.unwrap().decl.tparams.len() == targ_exprs.len() then key = keys.at(i)

    val f = cx.an.tables.funcs.get(key).unwrap()
    val decl = f.decl

    if decl.tparams.is_empty() then
        return cx.err(span, s"'$written' is not generic, so it has no type arguments to write — " +
                      s"the call is '$written(…)'")

    if decl.tparams.len() != targ_exprs.len() then
        return cx.err(span, s"'$written' takes ${quantity(decl.tparams.len(), "type argument")}, " +
                      s"but ${supplied_phrase(targ_exprs.len(), "type argument")}")

    var targs: Buf[Type] = buf()

    for i in 0..<targ_exprs.len()
        targs.push(written_type_arg(cx, targ_exprs.at(i)))

    // **A BOUND IS RESOLVED WHERE IT WAS WRITTEN, WHICH IS THE DECLARATION'S SCOPE AND NOT THE
    // CALLER'S.** `sysl.math.is_power_of_two[T: Bits + Ord]` writes `Bits` bare, and a caller that
    // imported `sysl.math` has the module and not that name -- so resolving the bound here would
    // leave it naming nothing, and every integer would be refused for not implementing the trait
    // the compiler supplies to all of them. `Ord` hid it, being auto-imported and so resolvable
    // from either place.
    if !check_param_bounds(cx.an, f.scope, span, key, decl.tparams, decl.bounds, targs, buf(),
                           "type parameter") then return bad_expr(span)

    val name = instantiate_func(cx.an, f.scope, decl, targs, false)
    val sig = cx.an.tables.members.func_insts.get(name)

    if sig.is_none() then return bad_expr(span)

    val bound = bind_arguments(cx, span, written, f, args, true)

    if bound.is_none() then return bad_expr(span)

    var ts: Buf[TExpr] = buf()
    val slots = bound.unwrap()

    for i in 0..<slots.len()
        val want = if i < sig.unwrap().params.len() then sig.unwrap().params.at(i).1 else Unknown

        slots.at(i) match
            Some(e) ->
                val t = argument_at(cx, decl, i, e, want)

                if disagree(texpr_type(t), want) then
                    cx.fault(e.span, s"'${decl.params.at(i).name}' of '$written' is " +
                             s"${type_show(want)}, but ${type_show(texpr_type(t))} was given")

                ts.push(t)
            None ->
                val inner = analyzer_for(cx.an, f.scope)

                inner.reported = Some(span)
                inner.here_src = caller_source(cx)
                ts.push(type_expr(inner, decl.params.at(i).default.unwrap(), Some(want)))

    cx.an.uses(name)
    TExpr(span, TCall(name, ts, sig.unwrap().ret, false))
end written_generic_call

// One type argument as a **call** writes it, which is an expression: brackets in an expression are
// indexing, so what a reader writes between them here is read back as the type it names.
written_type_arg(cx: &Analyzer, e: Expr) -> Type = *e.kind match
    Ident(n) -> resolve_type(cx.an, cx.scope, named_type(e.span, n), cx.subst)
    // A **value** argument is written as the number it is, which is the one place the two grammars
    // agree without a conversion. It travels at the width a length does, so a copy the reader named
    // and one a call read off an argument are the same instantiation and not two.
    IntLit(_, _, _) -> const_arg_at(cx, e)
    Index(head, one) -> applied_type_arg(cx, e.span, head, one_arg(one))
    TypeArgs(head, inner) -> applied_type_arg(cx, e.span, head, inner)
    // The three the two grammars share a spelling for. `*T` and `&T` are a unary operator in an
    // expression and a qualifier in a type; a tuple is parentheses either way. Everything else has
    // no spelling here at all, which the refusal below is what says.
    Unary(op, inner) ->
        if op == "*" then resolve_type(cx.an, cx.scope, type_ref(e.span,
            PtrType(written_type_ref(cx, inner))), cx.subst)
        else if op == "&" then resolve_type(cx.an, cx.scope, type_ref(e.span,
            RefType(written_type_ref(cx, inner), false)), cx.subst)
        else not_a_type_arg(cx, e)
    Tuple(parts) ->
        var written: Buf[TypeRef] = buf()

        for i in 0..<parts.len()
            written.push(written_type_ref(cx, parts.at(i)))

        resolve_type(cx.an, cx.scope, type_ref(e.span, TupleType(written, false)), cx.subst)
    // A dotted path is one name to the type grammar, so `mod.Box` is read as the word it is.
    Field(_, _) -> dotted_type_arg(cx, e)
    _ -> not_a_type_arg(cx, e)

private not_a_type_arg(cx: &Analyzer, e: Expr) -> Type
    cx.fault(e.span, "this is not a type — what is written in the brackets is a type argument, " +
             "and they read it out of the expression grammar, so a slice, a 'weak', a 'volatile', " +
             "a vector and a callable have no spelling here. Annotate what receives the result and " +
             "let the call infer it instead")

    Unknown
end not_a_type_arg

// The same, stopped one step earlier: a written type rather than a resolved one, so that a pointer
// to a pointer nests without each level being resolved on its own.
private written_type_ref(cx: &Analyzer, e: Expr) -> TypeRef = *e.kind match
    Ident(n) -> named_type(e.span, n)
    Unary(op, inner) ->
        if op == "*" then type_ref(e.span, PtrType(written_type_ref(cx, inner)))
        else if op == "&" then type_ref(e.span, RefType(written_type_ref(cx, inner), false))
        else
            not_a_type_arg(cx, e)
            named_type(e.span, "")
    Field(_, _) ->
        val path = dotted_path_of(e)

        if path.is_none()
            not_a_type_arg(cx, e)
            named_type(e.span, "")
        else named_type(e.span, path.unwrap())
    _ ->
        not_a_type_arg(cx, e)
        named_type(e.span, "")

private dotted_type_arg(cx: &Analyzer, e: Expr) -> Type
    val path = dotted_path_of(e)

    if path.is_none() then return not_a_type_arg(cx, e)

    resolve_type(cx.an, cx.scope, named_type(e.span, path.unwrap()), cx.subst)
end dotted_type_arg

// The name a written type argument applies its own arguments to -- `Box` in `Box[int]`, and the
// whole dotted path in `mod.Box[int]`, which is one name to the type grammar.
private dotted_path_of(e: Expr) -> Option[string] = *e.kind match
    Ident(n) -> Some(n)
    Field(inner, n) -> dotted_path_of(inner).map(head -> s"$head.$n")
    _ -> None

// A written number as a value argument, at the width every other value argument travels at.
private const_arg_at(cx: &Analyzer, e: Expr) -> Type
    val whole = resolve_type(cx.an, cx.scope, type_ref(e.span, ValueArgType(e)), cx.subst)

    whole match
        ConstArg(v, _) -> ConstArg(v, usize_type(word_bits(cx)))
        other -> other
end const_arg_at

private one_arg(e: Expr) -> Buf[Expr]
    var out: Buf[Expr] = buf()

    out.push(e)
    out
end one_arg

// A generic type applied to arguments, written the way an expression spells it.
private applied_type_arg(cx: &Analyzer, span: Span, head: Expr, inner: Buf[Expr]) -> Type
    val name = *head.kind match
        Ident(n) -> Some(n)
        _ -> None

    if name.is_none()
        cx.fault(span, "a type argument is a type, and this is not one")
        return Unknown
    end if

    var refs: Buf[TypeRef] = buf()

    for i in 0..<inner.len()
        *inner.at(i).kind match
            Ident(n) -> refs.push(named_type(inner.at(i).span, n))
            _ -> refs.push(type_ref(inner.at(i).span, ValueArgType(inner.at(i))))


    resolve_type(cx.an, cx.scope, type_ref(span, NamedType(name.unwrap(), refs)), cx.subst)
end applied_type_arg

// One call to a generic function.
generic_call(cx: &Analyzer, span: Span, written: string, key: string, f: Func, args: Buf[Expr],
             expected: Option[Type], report: bool) -> TExpr
    val bound = bind_arguments(cx, span, written, f, args, report)

    if bound.is_none() then return bad_expr(span)

    val slots = bound.unwrap()
    val decl = f.decl

    // **Asked before the solve rather than left to it**, because the solve can only report what it
    // failed to find and the answer here is that it was never going to find it: a parameter named in
    // neither the parameters nor the result is one nothing in a call could settle.
    val stuck = unsettleable(decl)

    if !stuck.is_empty()
        if report
            val names = quoted_and(stuck)
            val is_are = if stuck.len() == 1 then "is" else "are"
            val it_them = if stuck.len() == 1 then "it" else "them"

            cx.fault(span, s"$names $is_are in neither the parameters of '$written' nor its " +
                     s"result, so nothing in this call says what $it_them should be — write " +
                     s"$it_them out, as '$written[…](…)'")
        else cx.fault(span, "unsettleable")

        return bad_expr(span)
    end if

    val prov = provisional_args(cx, span, f, slots, expected)
    var param_refs: Buf[TypeRef] = buf()

    for i in 0..<decl.params.len()
        param_refs.push(decl.params.at(i).typ)

    val targs = solve(cx.an, f.scope, span, key, decl.tparams, param_refs, prov.tys, decl.ret_type,
                      expected, prov.soft, decl.bounds, buf())

    if !report
        for i in 0..<targs.len()
            if targs.at(i) == Unknown
                cx.fault(span, "not inferable")
                return bad_expr(span)

    // **An argument that could not be worked out ends the call rather than instantiating at it.**
    // The mistake that left it unknown has been reported where it was made -- or deliberately
    // suppressed as a consequence of one -- and a body made real at `?` would complain again from
    // inside the declaration, about a line the reader did not write.
    for i in 0..<targs.len()
        if targs.at(i) == Unknown then return bad_expr(span)

    // A type argument that does not meet what the declaration asked of it ends the call: the body
    // would be read at a type the bound was supposed to have ruled out, and every complaint that
    // came back would be a consequence of this one.
    if !check_param_bounds(cx.an, f.scope, span, key, decl.tparams, decl.bounds, targs, buf(),
                           "type parameter") then return bad_expr(span)

    val name = instantiate_func(cx.an, f.scope, decl, targs, false)
    val sig = cx.an.tables.members.func_insts.get(name)

    if sig.is_none() then return bad_expr(span)

    var ts: Buf[TExpr] = buf()

    for i in 0..<slots.len()
        val want = if i < sig.unwrap().params.len() then sig.unwrap().params.at(i).1 else Unknown

        slots.at(i) match
            Some(e) ->
                // A callable was read once, against the bound the solve had settled by then, and
                // the node is the one that reading made: reading it again would lower a second
                // closure for the one a program wrote.
                var t = bad_expr(e.span)

                if i < prov.kept.len() && prov.kept.at(i).is_some()
                    // **A callable is read against the BOUND its parameter states, which says
                    // nothing about how the parameter holds it.** A written `&Fn(…) -> T` is a
                    // trait object, so what came back is the closure's own struct and the position
                    // is what puts it behind the table -- exactly as it would for a parameter
                    // naming no type of the declaration's.
                    t = prov.kept.at(i).unwrap()

                    if disagree(texpr_type(t), want) then t = coerce(cx, t, want)
                else t = argument_at(cx, decl, i, e, want)

                if disagree(texpr_type(t), want)
                    if report then
                        cx.fault(e.span, s"'${decl.params.at(i).name}' of '$written' is " +
                                 s"${type_show(want)}, but ${type_show(texpr_type(t))} was given")
                    else cx.fault(e.span, "argument disagrees")

                ts.push(t)
            // A default that was read while the solve was settling is the node the program gets:
            // reading it again would lower a second closure for the one the declaration wrote.
            None ->
                if i < prov.kept.len() && prov.kept.at(i).is_some()
                    val kept = prov.kept.at(i).unwrap()

                    if disagree(texpr_type(kept), want) then ts.push(coerce(cx, kept, want))
                    else ts.push(kept)
                else
                    val inner = analyzer_for(cx.an, f.scope)

                    inner.reported = Some(span)
                    inner.here_src = caller_source(cx)
                    ts.push(type_expr(inner, decl.params.at(i).default.unwrap(), Some(want)))

    cx.an.uses(name)
    TExpr(span, TCall(name, ts, sig.unwrap().ret, false))
end generic_call

// One argument of a generic call, read at the parameter the solve arrived at.
//
// **An argument standing at a parameter that was still being solved was read with nothing expected
// of it**, so what a position would have done to it -- boxing a value into a `&T`, giving up the
// ability to write a view, erasing into an object -- is done *here*, once the parameter is known,
// rather than inside the reading. That is what makes `copy(bigger, self.elems[0..])` a writable view
// with the const view around it, which is what the position performs and what the reference records.
//
// A **literal** is the one case that cannot be repaired afterwards, because a literal does not
// convert -- it *is* the type its position gives it. So it is read against the parameter it turned
// out to have. A written-out array standing where a slice was asked for is the other: by the time
// there is an array to coerce, the storage has been made as one.
private argument_at(cx: &Analyzer, decl: FuncDecl, i: usize, e: Expr, want: Type) -> TExpr
    if i >= decl.params.len() || !ref_mentions(decl.params.at(i).typ, decl.tparams) ||
            is_literal(e) then
        return type_expr(cx, e, Some(want))

    // **The bare reading is a probe, so what it could not answer is not a complaint.** A form with
    // no type of its own -- a nullary variant of a generic enum, `None` standing at a `T` the solve
    // has since settled -- has nothing to say with nothing expected of it, and the parameter is what
    // it should have been read against all along. The probe is rewound and that reading is the one
    // the program gets.
    val mark = cx.an.complaints()
    val lowered = cx.an.closure_count
    val made = cx.an.closure_funcs.len()
    val bare = type_expr(cx, e, None)

    if cx.an.complaints() > mark
        cx.an.restore_complaints(mark)
        cx.an.closure_count = lowered
        cx.an.closure_funcs.truncate(made)

        return type_expr(cx, e, Some(want))
    end if

    if becomes_slice(texpr_type(bare), want) then return type_expr(cx, e, Some(want))

    val fitted = coerce(cx, bare, want)

    if !disagree(texpr_type(fitted), want) then return fitted

    // What the position could not repair is read again against the parameter, and kept only where
    // that answers -- otherwise the first reading is what the complaint should name.
    val again = type_expr(cx, e, Some(want))

    if disagree(texpr_type(again), want) then fitted else again
end argument_at

// A written-out array where a view of it was asked for, which is the one conversion the analysis
// performs rather than one the position repairs afterwards.
private becomes_slice(actual: Type, want: Type) -> bool
    unqualified(actual) match
        Array(_, _) -> unqualified(want) match
            Slice(_, _) -> true
            _ -> false
        _ -> false
end becomes_slice

// The type parameters a call can settle nothing about: the ones named in neither the parameters nor
// the result.
//
// A bare arrow is sugar for a bounded parameter, so a declaration written `f(g: A -> B)` carries the
// types in a *bound* rather than in a parameter -- and a walk over the written parameter types no
// longer sees them.
private unsettleable(d: FuncDecl) -> Buf[string]
    var out: Buf[string] = buf()

    for i in 0..<d.tparams.len()
        val tp = d.tparams.at(i)
        var one: Buf[string] = buf()

        one.push(tp)

        var named = false

        for j in 0..<d.params.len()
            if ref_mentions(d.params.at(j).typ, one) then named = true

        if d.ret_type.is_some() && ref_mentions(d.ret_type.unwrap(), one) then named = true

        for j in 0..<d.bounds.len()
            val nb = d.bounds.at(j)

            for k in 0..<nb.bounds.len()
                if any_ref_mentions(nb.bounds.at(k).args, one) then named = true

        if !named then out.push(tp)

    out
end unsettleable

private quoted_and(names: Buf[string]) -> string
    var b = str_builder()

    for i in 0..<names.len()
        if i > 0 then b.push(" and ")

        b.push(s"'${names.at(i)}'")

    b.finish()
end quoted_and

// What each argument reads as before the type arguments are known, and whether reading it took a
// **literal's default** for want of anything better -- which is what the tiering turns on.
//
// An argument standing at a parameter whose type names none of the declaration's own parameters is
// read against that type, exactly as a call to something non-generic reads it. Everything else is
// read on its own, with what it said put back: the reading is a guess made to solve with, and a
// complaint about a guess is one nobody asked for.
// **What the call's own position asks for is part of the reading**, and not only of the solve after
// it: a parameter named by the result alone is settled by nothing else, and a callable standing at a
// bound over it is then read with a result nothing fixed — so its body decides one, and the closure
// implements a call trait the declaration did not ask for.
private provisional_args(cx: &Analyzer, span: Span, f: Func, slots: Buf[Option[Expr]],
                         expected: Option[Type]) -> Provisional =
    provisional_of(cx, span, f.scope, f.decl.tparams, f.decl.params, f.decl.ret_type, f.decl.bounds,
                   slots, no_bindings(), expected)

// What a first reading of a call's arguments settled: the type each one came to, whether it was a
// literal's default, and the node itself where the argument is one that was **kept**.
//
// A callable is the one shape with no type of its own -- a closure's parameters come from its
// context and a bare function name is a callable only where one is asked for -- so it is held back
// from the first pass and read once the others have said what the parameter it stands at takes.
// The node is kept because reading it again would lower a second closure for the one a program
// wrote.
struct Provisional
    tys: Buf[Type]
    soft: Buf[bool]
    kept: Buf[Option[TExpr]]
end Provisional

// The reading itself, for a free function and for a member alike. `known` is what the caller
// already settled -- a member's receiver answers the type's own parameters before an argument is
// read -- and `expected` is what the call's own position asks for.
provisional_of(cx: &Analyzer, span: Span, scope: Scope, tparams: Buf[string], params: Buf[Param],
               result: Option[TypeRef], bounds: Buf[NamedBounds], slots: Buf[Option[Expr]],
               known: Buf[Binding], expected: Option[Type]) -> Provisional
    var tys: Buf[Type] = buf()
    var soft: Buf[bool] = buf()
    var kept: Buf[Option[TExpr]] = buf()
    var held: Buf[usize] = buf()

    // **A default stands exactly where the argument would have been**, so it says as much about a
    // type parameter as a written argument does -- and a call that left one out would otherwise have
    // nothing to settle that parameter from. It is read in the DECLARATION's own terms, which is
    // where its names mean what they meant.
    var written: Buf[Option[Expr]] = buf()

    for i in 0..<slots.len()
        if slots.at(i).is_some() then written.push(slots.at(i))
        else written.push(params.at(i).default)

    for i in 0..<slots.len()
        val p = params.at(i)

        kept.push(None)

        val e = written.at(i)
        val inner = arg_reader(cx, span, scope, slots.at(i).is_none())

        if e.is_none()
            tys.push(Unknown)
            soft.push(true)
        else if callable_arg(inner, e.unwrap())
            // Held back: an argument with no type of its own has nothing to unify, so the parameter
            // it stands at is settled by the others or by nothing at all -- and waiting cannot lose
            // the solution.
            held.push(i)
            tys.push(Unknown)
            soft.push(true)
        else if !ref_mentions(p.typ, unsolved_names(tparams, known))
            val want = resolve_type(cx.an, scope, p.typ, known)
            val t = sandboxed_arg(inner, e.unwrap(), Some(want))

            tys.push(texpr_type(t))
            soft.push(false)
        else
            val t = sandboxed_arg(inner, e.unwrap(), None)

            tys.push(texpr_type(t))
            soft.push(adaptable(e.unwrap(), t))

    if held.is_empty() then return Provisional(tys, soft, kept)

    // What the first pass settles, in the three tiers `solve` reads: what carries a type of its own
    // first, the expected type next, and a literal's default only where neither reached it. A held
    // argument is then read against that, which is what makes `collect([1, 2, 3], n -> s"<${n}>")`
    // a call whose closure knows what it takes.
    var param_refs: Buf[TypeRef] = buf()

    for i in 0..<params.len()
        param_refs.push(params.at(i).typ)

    var sub: Buf[Binding] = buf()

    for i in 0..<known.len()
        sub.push(known.at(i))

    for i in 0..<param_refs.len()
        if i < tys.len() && !soft.at(i) then
            unify(cx.an, scope, param_refs.at(i), tys.at(i), tparams, &sub)

    if sub.len() < tparams.len() && result.is_some() && expected.is_some() then
        unify(cx.an, scope, result.unwrap(), expected.unwrap(), tparams, &sub)

    if sub.len() < tparams.len()
        for i in 0..<param_refs.len()
            if i < tys.len() && soft.at(i) && tys.at(i) != Unknown then
                unify(cx.an, scope, param_refs.at(i), tys.at(i), tparams, &sub)

    // **By readiness rather than left to right**, so that a callable whose result settles what the
    // next one takes is read first whichever order the two were written in. A round that reads
    // nothing ends it.
    var pending = held
    var again = true

    while again && !pending.is_empty()
        again = false

        var later: Buf[usize] = buf()
        var ready: Buf[usize] = buf()
        var wants: Buf[Type] = buf()

        // **A ROUND SETTLES WHO IS IN IT BEFORE IT READS ANY OF THEM.** Reading one callable
        // settles type parameters, and letting that carry a later argument into the same round
        // would make the order the closures are lowered in depend on where in the list the settling
        // argument happened to sit. The number inside a closure's name is that order, so it is not
        // a detail: it is part of the symbol. An argument ready at the start of a round has nothing
        // unsolved in what it takes, so reading it against what the round started with loses
        // nothing.
        for i in 0..<pending.len()
            val at = pending.at(i)
            val want = held_want(cx, scope, params.at(at).typ, tparams, bounds, sub)

            if want.is_none() then later.push(at)
            else
                ready.push(at)
                wants.push(want.unwrap())

        for i in 0..<ready.len()
            val at = ready.at(i)
            val reader = arg_reader(cx, span, scope, slots.at(at).is_none())
            val t = type_expr(reader, written.at(at).unwrap(), Some(wants.at(i)))

            kept.set(at, Some(t))
            tys.set(at, texpr_type(t))
            unify(cx.an, scope, param_refs.at(at), texpr_type(t), tparams, &sub)

            // **What a callable yields is read back off it**, which is the other half of a call
            // handing one an open result: the parameter is now the closure's own struct, and that
            // struct implements the call trait its body determined -- so the bound's arguments,
            // written in the declaration's terms, are matched against the ones the closure turned
            // out to have. Without it a parameter named only by an arrow's result stays unknown,
            // and the next arrow is told nothing says what it takes by a call whose previous
            // argument had just said so.
            solve_from_callables(cx.an, scope, tparams, bounds, &sub)

            again = true

        pending = later

    Provisional(tys, soft, kept)
end provisional_of

// Who reads an argument: the caller for one a program wrote, and an analyzer in the declaration's
// own terms for a default -- which is what makes a default mean the same thing from every module
// that calls the function, and what makes a default of `__LINE__` name the caller's line.
private arg_reader(cx: &Analyzer, span: Span, scope: Scope, from_default: bool) -> &Analyzer
    if !from_default then return cx

    val inner = analyzer_for(cx.an, scope)

    inner.reported = Some(span)
    inner.here_src = caller_source(cx)
    inner
end arg_reader

// One reading of an argument with everything it said put back.
sandboxed_arg(cx: &Analyzer, e: Expr, expected: Option[Type]) -> TExpr
    val mark = cx.an.complaints()
    // **A reading that is thrown away lowers no closure**, because the argument is read again at the
    // parameter the solve arrived at and the second reading is the one the program gets. The counter
    // is what makes a closure's name its own, so leaving it forward here would number every closure
    // after a generic call one higher than the compilation actually lowered.
    val lowered = cx.an.closure_count
    val made = cx.an.closure_funcs.len()
    val t = type_expr(cx, e, expected)

    cx.an.restore_complaints(mark)
    cx.an.closure_count = lowered
    cx.an.closure_funcs.truncate(made)
    t
end sandboxed_arg

// Whether a written type names one of a list of type parameters, anywhere inside it.
ref_mentions(t: TypeRef, names: Buf[string]) -> bool
    if names.is_empty() then return false

    *t.kind match
        NamedType(n, args) -> holds_string(names, n) || any_ref_mentions(args, names)
        PtrType(inner) -> ref_mentions(inner, names)
        RefType(inner, _) -> ref_mentions(inner, names)
        WeakType(inner) -> ref_mentions(inner, names)
        VolatileType(inner) -> ref_mentions(inner, names)
        // A **length** names a value parameter the way an element names a type one, so a walk that
        // read only the element reported `N` as a parameter nothing in the call could settle.
        ArrayType(length, elem, _) ->
            (length.is_some() && expr_mentions(length.unwrap(), names)) || ref_mentions(elem, names)
        VectorType(lanes, elem) -> expr_mentions(lanes, names) || ref_mentions(elem, names)
        ValueArgType(e) -> expr_mentions(e, names)
        TupleType(parts, _) -> any_ref_mentions(parts, names)
        PackType(n) -> holds_string(names, n)
        FnType(params, ret, _) -> any_ref_mentions(params, names) || ref_mentions(ret, names)
        CFnType(params, ret) -> any_ref_mentions(params, names) || ref_mentions(ret, names)
        AssocType(base, _) -> ref_mentions(base, names)
        AssocArgType(_, inner) -> ref_mentions(inner, names)
        _ -> false
end ref_mentions

// Whether a written extent names one of them, which for a bare name is the whole of the question:
// an extent written as arithmetic over a parameter is refused at resolution rather than solved.
private expr_mentions(e: Expr, names: Buf[string]) -> bool = *e.kind match
    Ident(n) -> holds_string(names, n)
    _ -> false

any_ref_mentions(ts: Buf[TypeRef], names: Buf[string]) -> bool
    for i in 0..<ts.len()
        if ref_mentions(ts.at(i), names) then return true

    false
end any_ref_mentions

// -- the arguments a first pass holds back -------------------------------------------------------

// Whether an argument is a **callable**: the one shape with no type of its own, since a closure's
// parameters come from its context and a bare function name is a callable only where one is wanted.
//
// It is asked in the **caller's** scope, before anything enters the declaration's: asking it later
// would be asking whether the callee's module declares a function of that name.
callable_arg(cx: &Analyzer, e: Expr) -> bool = *written_arg(e).kind match
    Lambda(_, _, _) -> true
    BlockArg(_) -> true
    Ident(n) ->
        cx.lookup(n).is_none() && !function_keys(cx, n).is_empty()
    _ -> false

// What was actually written at an argument position, which for a filled default is inside the
// wrapper the binding put around it: a default stands exactly where the argument would have been,
// so what is asked about it is what would have been asked about the expression written there.
private written_arg(e: Expr) -> Expr = *e.kind match
    DefaultArg(_, inner) -> written_arg(inner)
    _ -> e

// The names a solve has still to answer.
private unsolved_names(tparams: Buf[string], known: Buf[Binding]) -> Buf[string]
    var out: Buf[string] = buf()

    for i in 0..<tparams.len()
        if bound_type(known, tparams.at(i)).is_none() then out.push(tparams.at(i))

    out
end unsolved_names

// What a held-back argument is read against, once the others have settled what they can.
//
// A **callable** wants its parameter's *bound*; everything else held back wants the parameter
// itself. Nothing at all where the parameter still names something undetermined, which leaves the
// closure to report that its parameters have no types -- the honest answer there, since they have
// none.
private held_want(cx: &Analyzer, scope: Scope, ptype: TypeRef, tparams: Buf[string],
                  bounds: Buf[NamedBounds], sub: Buf[Binding]) -> Option[Type]
    val shape = call_shape(cx, scope, ptype, tparams, bounds)

    if shape.is_some()
        val unsolved = unsolved_names(tparams, sub)

        // **Only what the closure TAKES has to be settled; what it yields may still be open.** A
        // closure takes its parameter types from its context and its result from its body, so a
        // result nothing here knows is the ordinary case rather than a difficulty.
        if !any_ref_mentions(shape.unwrap().1, unsolved)
            var args: Buf[Type] = buf()

            for i in 0..<shape.unwrap().1.len()
                args.push(resolve_type(cx.an, scope, shape.unwrap().1.at(i), sub))

            var yields = Unknown

            if shape.unwrap().2.is_some() && !ref_mentions(shape.unwrap().2.unwrap(), unsolved) then
                yields = resolve_type(cx.an, scope, shape.unwrap().2.unwrap(), sub)

            args.push(yields)
            return Some(Trait(shape.unwrap().0, args, buf()))
        end if

    if ref_mentions(ptype, unsolved_names(tparams, sub)) then return None

    Some(resolve_type(cx.an, scope, ptype, sub))
end held_want

// The two ways a parameter can ask for a callable, read down to one shape: the trait's key, what it
// takes, and what it yields.
//
// **A bare arrow and a boxed `&Fn` are the same question.** They differ in what they cost -- the
// arrow becomes a bounded type parameter and is called directly, the boxed one is a trait object
// and dispatches -- and in nothing else that matters here, since both state a signature the closure
// standing at them can be read against.
private call_shape(cx: &Analyzer, scope: Scope, ptype: TypeRef, tparams: Buf[string],
                   bounds: Buf[NamedBounds]) -> Option[(string, Buf[TypeRef], Option[TypeRef])]
    *ptype.kind match
        NamedType(name, args) ->
            if !args.is_empty() then return applied_call_shape(cx, scope, name, args)
            if !holds_string(tparams, name) then return applied_call_shape(cx, scope, name, args)

            for i in 0..<bounds.len()
                if bounds.at(i).name == name
                    val bs = bounds.at(i).bounds

                    for j in 0..<bs.len()
                        val found = applied_call_shape(cx, scope, bs.at(j).name, bs.at(j).args)

                        if found.is_some() then return found

            None
        FnType(params, ret, _) ->
            val key = lookup_trait_key(cx.an, scope, fn_base(params.len()))

            if key.is_none() then return None

            Some((key.unwrap(), params, Some(ret)))
        RefType(inner, _) -> call_shape(cx, scope, inner, tparams, bounds)
        PtrType(inner) -> call_shape(cx, scope, inner, tparams, bounds)
        _ -> None
end call_shape

// A trait written out with its arguments, where the trait is one of the call traits: the last
// argument is what it yields and the rest are what it takes.
private applied_call_shape(cx: &Analyzer, scope: Scope,
                           name: string, args: Buf[TypeRef]) -> Option[(string, Buf[TypeRef],
                                                                        Option[TypeRef])]
    if !fn_is_call(name) then return None

    val key = lookup_trait_key(cx.an, scope, name)

    if key.is_none() || args.is_empty() then return None

    var taken: Buf[TypeRef] = buf()

    for i in 0..<(args.len() - 1)
        taken.push(args.at(i))

    Some((key.unwrap(), taken, Some(args.at(args.len() - 1))))
end applied_call_shape
