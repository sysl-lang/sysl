module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.Search

// `@` and what follows it: the annotations a declaration carries, the `@assert` that is a
// declaration of its own, and the refusals for the ones written where they say nothing.
//
// **An annotation describes the declaration under it, and `@assert` describes nothing but itself.**
// That is the whole of what tells the two apart, and it is why the parentheses are not optional
// there: they are what make the line a declaration rather than a prefix.

// No annotations at all, which is what most declarations carry.
no_attrs() -> Buf[Attr] = buf()

// The words that belong in a file's header rather than above a declaration.
header_attr_word(w: string) -> bool
    if w.starts_with("no_") && w.len > 3 then return true

    for word in ["requires", "link", "include", "tests"]
        if word == w then return true

    false
end header_attr_word

// The word a `@` is followed by, or `""` where it is followed by no name at all.
attr_name(p: *Parser) -> string = p.peek_at(1) match
    Ident(n) -> n
    _ -> ""

// A statement opening with `@`.
parse_at_stmt(p: *Parser, start: Span) -> Stmt
    val word = attr_name(p)

    if header_attr_word(word)
        p.fault(start, "this attribute belongs in the file's header, on the lines directly after 'module' and before everything else — it is a property of the whole module, not of the statements below it")
        skip_line(p)
        return stmt(start.to(p.just_taken()), Bad)
    end if

    if word == "assert" then return parse_assert_decl(p, start)

    parse_attributed_decl(p, start)
end parse_at_stmt

// `@assert(cond)`, `@assert(cond, "why")` -- a condition settled while compiling.
private parse_assert_decl(p: *Parser, start: Span) -> Stmt
    p.bump()
    p.bump()

    if !p.at_kw("(")
        p.fault(start, "'@assert' takes its condition in parentheses — '@assert(sizeof(T) == 16)', with an optional message after a comma. It is the parentheses that make it this declaration rather than an annotation about the one under it")
        skip_line(p)
        return stmt(start.to(p.just_taken()), Bad)
    end if

    p.bump()

    val cond = parse_expr(p)
    var message: Option[string] = None

    if p.accept_kw(",") then message = accept_string(p)

    p.expect_kw(")")
    stmt(start.to(p.just_taken()), AssertDecl(cond, message))
end parse_assert_decl

// -- the annotations themselves -------------------------------------------------------------------

// Every annotation above one declaration, and the newlines between them: each is its own line and
// the declaration follows the last of them.
parse_attr_list(p: *Parser) -> Buf[Attr]
    var out: Buf[Attr] = buf()

    loop
        if !p.at_kw("@") && !p.at_kw("#") then break

        // **`@borrows` says something only on a trait's method.** A free function's body is right
        // here and the analysis reads the answer out of it, so a promise written above one would
        // restate what the compiler already knows and would go stale the moment the body changed.
        if p.at_kw("@") && attr_name(p) == "borrows"
            p.fault(p.here(), "'@borrows' is about a call whose body the compiler cannot see, so it says something only on a trait's method. A free function's body is right here and the analysis reads the answer out of it — a promise written above one would restate what the compiler already knows, and would go stale the moment the body changed")
            skip_line(p)
            break
        end if

        parse_attribute(p) match
            Some(a) -> out.push(a)
            None -> break

        p.skip_newlines()

    refuse_duplicates(p, out, "declaration")
    out
end parse_attr_list

// The annotations a member may carry: the ones about a parameter, and the three about the function
// the member lowers to.
parse_member_attrs(p: *Parser) -> Buf[Attr]
    var out: Buf[Attr] = buf()

    loop
        if !p.at_kw("@") && !p.at_kw("#") then break

        val at = p.here()
        val word = attr_name(p)

        if p.at_kw("#")
            refuse_hash_attr(p, at)
            break
        end if

        if !member_attr_word(word)
            if word == "assert"
                p.fault(at, "'@assert' stands where a declaration stands, and a type's body holds its members — write it beside the type rather than inside it, where 'sizeof' and 'offsetof' still name what it is about")
            else
                p.fault(at, "the only annotations a member may carry are the ones about a parameter — '@crossing', '@borrows', '@reads' and '@writes' — and the three about the function it lowers to, '@noinline', '@inline' and '@cold'. What the rest say is about a free function or about a type: what 'sysl test' calls, what recurses, what a symbol names, how fields are laid out. A member is neither, so it goes above a free function instead ('06')")

            skip_line(p)
            break
        end if

        parse_attribute(p) match
            Some(a) -> out.push(a)
            None -> break

        p.skip_newlines()

    refuse_duplicates(p, out, "member")
    out
end parse_member_attrs

private member_attr_word(w: string) -> bool
    for word in ["crossing", "borrows", "reads", "writes", "noinline", "inline", "cold"]
        if word == w then return true

    false
end member_attr_word

// An annotation written twice above one declaration says nothing the once does not.
private refuse_duplicates(p: *Parser, attrs: Buf[Attr], what: string)
    for i in 0..<attrs.len()
        for j in 0..<i
            if attr_word(attrs.at(i)) == attr_word(attrs.at(j))
                p.fault(p.here(), s"'@${attr_word(attrs.at(i))}' is written twice above one ${what}, and it says nothing the once does not")
                return
end refuse_duplicates

private refuse_hash_attr(p: *Parser, at: Span)
    p.bump()

    val name = parse_bound_name(p)

    p.fault(at, s"an annotation is written '@${name}' — '#' opens a directive, which gates lines before the lexer sees them and sits at the margin")
    skip_line(p)
end refuse_hash_attr

// One annotation.
parse_attribute(p: *Parser) -> Option[Attr]
    val at = p.here()

    if p.at_kw("#")
        refuse_hash_attr(p, at)
        return None
    end if

    p.bump()

    val word = p.peek() match
        Ident(n) -> n
        _ -> ""

    if word == ""
        p.want("an attribute")
        return None
    end if

    p.bump()

    if word == "test" then return Some(Test(parse_test_attr(p, at)))
    if word == "setup" then return Some(hook_attr(p, at, Setup))
    if word == "teardown" then return Some(hook_attr(p, at, Teardown))
    if word == "setup_all" then return Some(hook_attr(p, at, SetupAll))
    if word == "teardown_all" then return Some(hook_attr(p, at, TeardownAll))
    if word == "tailrec" then return Some(TailRec)
    if word == "pure" then return Some(Pure)
    if word == "ghost" then return Some(Ghost)
    if word == "packed" then return Some(Packed)
    if word == "reads" then return Some(Reads(parse_frame_names(p, "reads")))
    if word == "writes" then return Some(Writes(parse_frame_names(p, "writes")))
    if word == "align" then return Some(parse_align_attr(p))
    if word == "export" then return Some(parse_export_attr(p, at))
    if word == "section" then return Some(parse_section_attr(p))
    if word == "crossing" then return Some(Crossing(parse_named_list(p, "crossing")))
    if word == "borrows" then return Some(Borrows(parse_named_list(p, "borrows")))
    if word == "needs" then return Some(Needs(parse_named_list(p, "needs")))
    if word == "noinline" then return no_inlining_args(p, NoInline, "whether a call stays a call is the whole of what it says")
    if word == "inline" then return no_inlining_args(p, Inline, "it raises what the inliner will spend on this definition rather than naming a number")
    if word == "cold" then return no_inlining_args(p, Cold, "how rare a rare path is is not a number a program has")

    // `@thread_local` takes no parentheses for `@packed`'s reason: which thread-local model the
    // object gets is the back end's answer for the target, not something a program picks.
    if word == "thread_local" then return Some(ThreadLocal)

    // `@ignore` is the spelling other test frameworks use, answered with this one's: ignoring is
    // something a test is, so it is an argument to `@test` rather than an annotation of its own.
    if word == "ignore"
        p.fault(p.here(), "an ignored test is written '@test(ignore: \"why it is not run\")' — ignoring is something a test is, so it goes inside '@test' beside the description and 'should_trap', and a function that is not a test has no run to withhold")
        skip_line(p)
        return None
    end if

    p.fault(at, s"'${word}' is not an annotation a declaration takes — '@test', '@setup', '@teardown', '@setup_all', '@teardown_all', '@tailrec', '@pure', '@ghost', '@export', '@noinline', '@inline', '@cold', '@reads(...)', '@writes(...)' and '@crossing(...)' mark a function, '@packed' and '@align(n)' mark a struct's layout, '@export(\"...\")' names a struct in a generated C header, '@section(\"...\")' marks either a binding or a function, and '@needs(...)' marks a function or an 'extern'. '@no_<capability>', '@requires(...)', '@link(\"...\")' and '@tests' belong in the file's header")
    skip_line(p)
    None
end parse_attribute

// `@noinline`, `@inline` or `@cold`, none of which takes an argument (`reference/attributes.md §
// @noinline, @inline and @cold`). A `(` after one is a sentence rather than a parse failure for the
// reason a hook's is: the word has been read, so there is nothing else the line could have been.
private no_inlining_args(p: *Parser, a: Attr, because: string) -> Option[Attr]
    if p.at_kw("(")
        p.fault(p.here(), s"'@${attr_word(a)}' takes no arguments — ${because}")
        skip_line(p)
    end if

    Some(a)
end no_inlining_args

private hook_attr(p: *Parser, at: Span, kind: HookKind) -> Attr
    if p.at_kw("(")
        p.fault(p.here(), "a hook takes no arguments — when it runs is what the word says, and what it does is its body. There is nothing left for a parenthesis to carry")
        skip_line(p)
    end if

    Hook(HookAttr(at.to(p.just_taken()), kind))
end hook_attr

// `@reads(count)`, `@writes()` -- the module variables a frame covers. **The parentheses are what
// tell a frame that covers nothing from a function that never said**, so there is no bare form.
private parse_frame_names(p: *Parser, word: string) -> Buf[string]
    var out: Buf[string] = buf()

    if !p.accept_kw("(")
        p.fault(p.here(), s"'@${word}' names the module variables it covers, in parentheses — '@${word}(count)', or '@${word}()' for none. The parentheses are what tell a frame that covers nothing from a function that never said")
        return out
    end if

    if p.accept_kw(")") then return out

    loop
        p.name() match
            Some(n) -> out.push(n)
            None -> break

        if !p.accept_kw(",") then break

    p.expect_kw(")")
    out
end parse_frame_names

// `@crossing(state)`, `@borrows(bytes)`, `@needs(heap)` -- each names at least one thing, and there
// is no empty form: a declaration that names none says so by not writing the annotation.
private parse_named_list(p: *Parser, word: string) -> Buf[string]
    var out: Buf[string] = buf()

    if !p.accept_kw("(") || p.at_kw(")")
        p.fault(p.here(), named_list_refusal(word))
        skip_line(p)
        return out
    end if

    loop
        p.name() match
            Some(n) -> out.push(n)
            None -> break

        if !p.accept_kw(",") then break

    p.expect_kw(")")
    out
end parse_named_list

private named_list_refusal(word: string) -> string
    if word == "crossing" then return "'@crossing' names the parameters a value reaches another concurrency domain through, in parentheses — '@crossing(state)'. There is no empty form: a function that hands nothing across a boundary says so by not writing the annotation"

    if word == "borrows" then return "'@borrows' names the parameters a trait's method promises not to keep past the call, in parentheses — '@borrows(bytes)'. There is no empty form: a method that may keep what it is handed says so by not writing the annotation"

    "'@needs' names the capabilities reaching this declaration requires, in parentheses — '@needs(heap)', '@needs(os, posix)'. There is no empty form: a declaration that needs nothing beyond what its module has says so by not writing the annotation"
end named_list_refusal

private parse_align_attr(p: *Parser) -> Attr
    if !p.accept_kw("(")
        p.fault(p.here(), "'@align' names the boundary in parentheses — '@align(64)', or '@align(CACHE_LINE)' for a constant that says what the number is for. There is no bare form: an alignment with no number is not a weaker claim, it is no claim")
        return Align(expr(p.here(), Bad))
    end if

    val bound = parse_expr(p)

    p.expect_kw(")")
    Align(bound)
end parse_align_attr

// `@export`, `@export("mylib_parse")` -- the symbol a function is visible under from C, or the name
// a struct's `typedef` carries in a generated header.
private parse_export_attr(p: *Parser, at: Span) -> Attr
    if !p.accept_kw("(") then return Export(ExportAttr(at.to(p.just_taken()), None))

    var symbol: Option[string] = None

    p.peek() match
        StrLit(v) ->
            p.bump()
            symbol = Some(v)
        _ ->
            p.fault(p.here(), "'@export' names the C symbol as a string — '@export(\"mylib_parse\")' — or takes no parentheses at all, which exports the function under its own name")
            skip_line(p)
            return Export(ExportAttr(at.to(p.just_taken()), None))

    p.expect_kw(")")
    Export(ExportAttr(at.to(p.just_taken()), symbol))
end parse_export_attr

private parse_section_attr(p: *Parser) -> Attr
    val bad = "'@section' names the linker section as a string — '@section(\".vectors\")' on the storage or the definition that goes there. The spelling is the target's: '.noinit' and '.ramfunc' are ELF's, '__DATA,__mysection' is Mach-O's"

    if !p.accept_kw("(")
        p.fault(p.here(), bad)
        return Section("")
    end if

    val at = p.here()

    p.peek() match
        StrLit(v) ->
            p.bump()

            if v == ""
                p.fault(at, "'@section' names a section, and \"\" is not the name of one — a section's spelling is the target's, so there is nothing an empty one could resolve to")

            p.expect_kw(")")
            Section(v)
        _ ->
            p.fault(at, bad)
            skip_line(p)
            Section("")
end parse_section_attr

// `@test`, `@test("what it shows")`, `@test("...", should_trap)`, `@test(should_trap: "text")`,
// `@test(ignore: "why")` — a description, then `should_trap`, then `ignore`, each optional and in
// that order.
private parse_test_attr(p: *Parser, at: Span) -> TestAttr
    if !p.at_kw("(") then return TestAttr(at.to(p.just_taken()), None, false, None, None)

    if p.kw_at(1, ")")
        p.fault(p.here(), "'@test' takes a description or nothing at all, and '()' is neither — drop the parentheses, and the function's own name becomes its description")
        p.bump()
        p.bump()
        return TestAttr(at.to(p.just_taken()), None, false, None, None)
    end if

    p.bump()

    var display: Option[string] = None
    var should_trap = false
    var expected: Option[string] = None
    var ignored: Option[string] = None

    p.peek() match
        StrLit(v) ->
            p.bump()
            display = Some(v)
        _ -> ()

    if display.is_none() && !p.at_word("should_trap") && !p.at_word("ignore")
        p.fault(p.here(), "'@test' takes the description a report shows it under, written as a string — '@test(\"an index past the end is refused\")' — 'should_trap' for a run that is meant not to come back, optionally with the text such a run must have printed, and 'ignore: \"why\"' for a test that is compiled and not run. They compose, in that order")
        skip_line(p)
        return TestAttr(at.to(p.just_taken()), None, false, None, None)
    end if

    if display.is_some() && p.kw_at(0, ",") && (p.word_at(1, "should_trap") || p.word_at(1, "ignore"))
        p.bump()

    if p.accept_word("should_trap")
        should_trap = true

        if p.accept_kw(":") then expected = accept_string(p)

        if p.kw_at(0, ",") && p.word_at(1, "ignore") then p.bump()
    end if

    if p.accept_word("ignore")
        ignored = parse_ignore_reason(p)

        if ignored.is_none()
            skip_line(p)
            return TestAttr(at.to(p.just_taken()), display, should_trap, expected, None)
        end if
    end if

    if !p.accept_kw(")")
        p.fault(p.here(), "'@test' closes what it opened — the description, 'should_trap' and 'ignore' go between parentheses, in that order, and there is no ')' here to end them")

    TestAttr(at.to(p.just_taken()), display, should_trap, expected, ignored)
end parse_test_attr

// What follows `ignore` inside `@test(...)`: a `:` and the reason, which is not optional and may not
// be blank — an ignored test that does not say what it is waiting for is the one nobody comes back
// to. Having read the word there is nothing else the reader could have been writing, so every road
// that does not end in a reason ends in the one refusal, at the token where the reason went wrong.
private parse_ignore_reason(p: *Parser) -> Option[string]
    val refusal = "'ignore' needs the reason the test is not run, written as a string — '@test(ignore: \"the parser drops the second arm\")'. An ignored test that does not say why is one nobody comes back to"

    if !p.accept_kw(":")
        p.fault(p.here(), refusal)
        return None
    end if

    p.peek() match
        StrLit(v) ->
            p.bump()

            if v.trim().bytes.len == 0
                p.fault(p.here(), refusal)
                return None
            end if

            Some(v)
        _ ->
            p.fault(p.here(), refusal)
            None
end parse_ignore_reason

// -- folding an annotation onto what it marks -----------------------------------------------------

apply_func_attrs(f: *FuncDecl, attrs: Buf[Attr])
    for i in 0..<attrs.len()
        attrs.at(i) match
            Test(t) -> f.test = Some(t)
            Hook(h) -> f.hook = Some(h)
            TailRec -> f.tailrec = true
            Pure -> f.pure = true
            Ghost -> f.ghost = true
            Reads(ns) -> f.reads = Some(ns)
            Writes(ns) -> f.writes = Some(ns)
            Export(e) -> f.exported = Some(e)
            Section(s) -> f.section = Some(s)
            Crossing(ns) -> f.crossing = ns
            Needs(cs) -> f.needs = cs
            NoInline -> f.marks.noinline = true
            Inline -> f.marks.inline = true
            Cold -> f.marks.cold = true
            _ -> ()
end apply_func_attrs

apply_member_attrs(m: *MethodDecl, attrs: Buf[Attr])
    for i in 0..<attrs.len()
        attrs.at(i) match
            Crossing(ns) -> m.crossing = ns
            Borrows(ns) -> m.borrows = ns
            Reads(ns) -> m.reads = Some(ns)
            Writes(ns) -> m.writes = Some(ns)
            NoInline -> m.marks.noinline = true
            Inline -> m.marks.inline = true
            Cold -> m.marks.cold = true
            _ -> ()
end apply_member_attrs

// -- routing a declaration to the thing its annotations describe -----------------------------------

// A declaration with a line or more of annotation in front of it.
//
// **Reading an annotation commits the line to being an attributed declaration**, so a declaration
// that cannot carry one is answered with a sentence about what the annotation marks rather than
// with the grammar's complaint about the form it went on to try.
private parse_attributed_decl(p: *Parser, start: Span) -> Stmt
    val attrs = parse_attr_list(p)

    refuse_impossible_pairs(p, attrs)

    val vis = parse_visibility(p)
    val at = p.here()
    val storage = p.at_kw("val") || p.at_kw("var") || p.at_kw("static")

    // `@thread_local` is settled before anything asks which kind of declaration is coming: it marks
    // storage, so a declaration that lays none down has nothing for it to be about.
    if per_thread(attrs) && !storage
        p.fault(start, "'@thread_local' gives one 'var' a copy per thread, and this declares no storage at all — a 'const' is folded into every use, an 'extern' names storage this program does not lay down, and a function is code every thread runs the one copy of")
        skip_line(p)
        return stmt(start.to(p.just_taken()), Bad)
    end if

    if p.at_kw("struct") || (p.at_word("opaque") && p.kw_at(1, "struct"))
        // **`@packed`, `@align(n)` and `@export("...")` are the three that mark a struct**, and
        // anything else above one is about a function that is not here.
        refuse_unless(p, at, attrs, "struct")

        val hidden = p.at_word("opaque")

        if hidden then return laid_out(parse_opaque_struct(p, at, vis), attrs)

        return laid_out(parse_struct_decl(p, at, vis, false), attrs)
    end if

    // A layout beside `@export` marks a struct and only a struct: a `type` takes `@export` alone,
    // and a function or a binding lays nothing out.
    if has_export(attrs) && has_layout(attrs) && all_layout_or_export(attrs)
        p.fault(start, "'@packed' and '@align(n)' lay out a struct and '@export(\"...\")' names one in a generated header, so together they mark a struct — and this declares none")
        skip_line(p)
        return stmt(start.to(p.just_taken()), Bad)
    end if

    // `@align(n)` is the boundary one object's storage begins on and `@section("...")` places it,
    // and between them they are what a binding may carry.
    if storage
        refuse_unless(p, at, attrs, "binding")
        return placed(p, parse_stmt_at(p, false), attrs)
    end if

    // `@needs(...)` is the one annotation an `extern` takes -- it is the declaration the annotation
    // exists for, every other having a body the compiler reads instead.
    if p.at_kw("extern")
        refuse_unless(p, at, attrs, "extern")
        return parse_extern_decl(p, at, vis, capabilities_of(attrs))
    end if

    // A `type` names a scalar or a pointer for a generated header, which is the struct's request made
    // of a declaration with no fields -- so it takes `@export` alone and nothing that lays out.
    if p.at_kw("type") && all_are(attrs, "export")
        return exported_type(parse_type_decl(p, at, vis), attrs)

    refuse_unless(p, at, attrs, "function")

    try_func_decl(p, at, vis, attrs) match
        Some(d) -> return d
        None -> ()

    p.fault(start, attributed_refusal(attrs))
    skip_line(p)
    stmt(start.to(p.just_taken()), Bad)
end parse_attributed_decl

// That every annotation above this declaration is one the declaration may carry.
private refuse_unless(p: *Parser, at: Span, attrs: Buf[Attr], form: string)
    for i in 0..<attrs.len()
        if !may_carry(form, attrs.at(i))
            p.fault(at, attributed_refusal(attrs))
            return

private may_carry(form: string, a: Attr) -> bool
    if form == "struct" then return is_layout(a) || attr_word(a) == "export"
    if form == "binding" then return is_storage(a)
    if form == "extern" then return attr_word(a) == "needs"

    !is_layout(a) && attr_word(a) != "borrows"
end may_carry

// The sentence a declaration that carries none of these gets, chosen by what was written above it.
private attributed_refusal(attrs: Buf[Attr]) -> string
    if all_are(attrs, "needs")
        return "'@needs(...)' names what reaching a declaration requires, so it marks a function or an 'extern' — and this declares neither"

    if all_layout(attrs)
        return "'@packed' describes how a struct's fields are laid out, so it can only mark a struct — a 'var' or a 'val' has no fields to pack, and '@align(n)' is the one of the two that may stand above one"

    if all_are(attrs, "section")
        return "'@section(\"...\")' places one object in a linker section, so it marks a 'var', a 'val' or a function — a 'const' is folded into every use and has no storage to place, and an 'extern' names something this program does not define"

    if all_are(attrs, "export")
        return "'@export' names what C sees — a function's symbol, or the name a struct's or a type's 'typedef' carries in a generated header — and this declares none of them. A simple enum is spelled as the integer it is, so it has no name in the header to choose, and an 'extern' names something this program does not define"

    // The layout pair beside the name settles which kind was meant: `@packed` cannot mark a function,
    // so the group together can only be about a struct and the refusal need not offer the function
    // reading at all.
    if all_layout_or_export(attrs)
        return "'@packed' and '@align(n)' lay out a struct and '@export(\"...\")' names one in a generated header, so together they mark a struct — and this declares none"

    "an annotation marks a function, and only a function — neither what 'sysl test' calls nor what recurses is anything a declaration of another kind supplies. '@packed', '@align(n)' and '@export(\"...\")' are the three that mark a struct instead"
end attributed_refusal

// The pairs that cannot describe one declaration, whichever kind it turns out to be.
private refuse_impossible_pairs(p: *Parser, attrs: Buf[Attr])
    var runners = 0
    var pure = false
    var frame = false
    var packed = false
    var section = false
    var ghost = false
    var noinline = false
    var inline = false
    var marks = ""

    for i in 0..<attrs.len()
        attrs.at(i) match
            Test(_) -> runners += 1
            Hook(_) -> runners += 1
            Pure -> pure = true
            Reads(_) -> frame = true
            Writes(_) -> frame = true
            Packed -> packed = true
            Section(_) -> section = true
            Ghost -> ghost = true
            NoInline -> noinline = true
            Inline -> inline = true
            _ -> ()

        if is_inlining(attrs.at(i)) then marks = joined(marks, attr_word(attrs.at(i)))

    // `@test` and the four hooks each say *when* `sysl test` calls the function, and they name four
    // different moments. Two of them above one declaration is two requests, not a stricter one.
    if runners > 1
        var named = ""

        for i in 0..<attrs.len()
            attrs.at(i) match
                Test(_) -> named = joined(named, attr_word(attrs.at(i)))
                Hook(_) -> named = joined(named, attr_word(attrs.at(i)))
                _ -> ()

        p.fault(p.here(), s"${named} each say when 'sysl test' calls this function, and they name different moments — a function is a test or one of the hooks around one, and it is called once")
        return
    end if

    // `@pure` *is* `@reads() @writes()` plus its further bans, so the two together say one thing
    // twice -- and could be made to disagree, leaving nothing to say which claim was held to.
    if pure && frame
        p.fault(p.here(), "'@pure' already says '@reads()' and '@writes()', so a frame beside it says one thing twice — write the frame alone if the function touches module storage, and '@pure' alone if it touches none")
        return
    end if

    // `@noinline` forbids inlining and `@inline` asks for it, so the two above one declaration are
    // contradictory requests rather than a stronger one. Answered before `@ghost` is looked at,
    // because the pair is wrong whatever else stands beside it.
    if noinline && inline
        p.fault(p.here(), "'@noinline' forbids inlining and '@inline' asks for it, so they contradict above one declaration — write the one the definition is for, and '@cold' beside it if it is also reached rarely, which is a different thing to say")
        return
    end if

    // `@ghost` erases the function before codegen, so there is no definition for the optimizer to be
    // told anything about.
    if ghost && marks != ""
        p.fault(p.here(), s"${marks} tell the optimizer about a definition, and '@ghost' means there is none — a ghost function is erased before anything is emitted, so nothing is left to keep out of line, to absorb into a caller, or to place away from the hot path")
        return
    end if

    // `@thread_local` marks a binding and only a binding, so the only annotations it may stand beside
    // are the other two about storage.
    if per_thread(attrs) && !all_storage(attrs)
        p.fault(p.here(), "'@thread_local' gives one 'var' a copy per thread, so the only annotations it stands beside are the other two about storage — '@align(n)' and '@section(\"...\")'. The rest mark a function or a type, and neither is storage a thread could have its own of")
        return
    end if

    // `@packed` describes the arrangement of fields within a type and `@section` places one object,
    // so the two cannot be about the same declaration whichever kind it turns out to be.
    if packed && section
        p.fault(p.here(), "'@packed' lays out a struct's fields and '@section(\"...\")' places one object, so they cannot stand above one declaration — a type occupies no address of its own, and the storage that holds a packed value is what a section would be about")
end refuse_impossible_pairs

private joined(so_far: string, word: string) -> string
    if so_far == "" then return s"'@${word}'"

    s"${so_far} and '@${word}'"
end joined

// Whether an attribute tells the optimizer how a definition is reached -- `@noinline`, `@inline` and
// `@cold`. One category because the one thing any of them needs is a definition to be about, which
// is what `@ghost` takes away.
private is_inlining(a: Attr) -> bool = a match
    NoInline -> true
    Inline -> true
    Cold -> true
    _ -> false

// Whether an attribute is one of the three about a binding's storage -- the boundary it begins on,
// the section it sits in, and whether each thread has its own copy -- which is the set
// `@thread_local` may be written beside.
private is_storage(a: Attr) -> bool = a match
    Align(_) -> true
    Section(_) -> true
    ThreadLocal -> true
    _ -> false

private has_export(attrs: Buf[Attr]) -> bool
    for i in 0..<attrs.len()
        if attr_word(attrs.at(i)) == "export" then return true

    false
end has_export

private has_layout(attrs: Buf[Attr]) -> bool
    for i in 0..<attrs.len()
        if is_layout(attrs.at(i)) then return true

    false
end has_layout

private all_layout_or_export(attrs: Buf[Attr]) -> bool
    for i in 0..<attrs.len()
        if !is_layout(attrs.at(i)) && attr_word(attrs.at(i)) != "export" then return false

    true
end all_layout_or_export

// Whether a set of annotations asks for one copy per thread.
private per_thread(attrs: Buf[Attr]) -> bool
    for i in 0..<attrs.len()
        if attr_word(attrs.at(i)) == "thread_local" then return true

    false
end per_thread

private all_storage(attrs: Buf[Attr]) -> bool
    for i in 0..<attrs.len()
        if !is_storage(attrs.at(i)) then return false

    true
end all_storage

private is_layout(a: Attr) -> bool = a match
    Packed -> true
    Align(_) -> true
    _ -> false

private all_layout(attrs: Buf[Attr]) -> bool
    if attrs.is_empty() then return false

    for i in 0..<attrs.len()
        if !is_layout(attrs.at(i)) then return false

    true
end all_layout

private all_are(attrs: Buf[Attr], word: string) -> bool
    if attrs.is_empty() then return false

    for i in 0..<attrs.len()
        if attr_word(attrs.at(i)) != word then return false

    true
end all_are

// The capabilities a set of annotations names, flattened.
private capabilities_of(attrs: Buf[Attr]) -> Buf[string]
    var out: Buf[string] = buf()

    for i in 0..<attrs.len()
        attrs.at(i) match
            Needs(cs) ->
                for j in 0..<cs.len()
                    out.push(cs.at(j))
            _ -> ()

    out
end capabilities_of

// The layout pair and the C name, folded onto the struct they were written above.
private laid_out(s: Stmt, attrs: Buf[Attr]) -> Stmt
    *s.kind match
        StructDecl(d) ->
            var decl = d

            for i in 0..<attrs.len()
                attrs.at(i) match
                    Packed -> decl.packed = true
                    Align(n) -> decl.alignment = Some(n)
                    Export(e) -> decl.cname = Some(e)
                    _ -> ()

            stmt(s.span, StructDecl(decl))
        _ -> s
end laid_out

// The C name `@export` gives a `type` in a generated header.
private exported_type(s: Stmt, attrs: Buf[Attr]) -> Stmt
    *s.kind match
        TypeDecl(d) ->
            var decl = d

            for i in 0..<attrs.len()
                attrs.at(i) match
                    Export(e) -> decl.cname = Some(e)
                    _ -> ()

            stmt(s.span, TypeDecl(decl))
        _ -> s
end exported_type

// `@align(n)`, `@section("...")` and `@thread_local` folded onto whichever binding they were written
// above, reaching through the `static` wrapper to the declaration inside it.
private placed(p: *Parser, s: Stmt, attrs: Buf[Attr]) -> Stmt
    var align: Option[Expr] = None
    var section: Option[string] = None
    val thread_local = per_thread(attrs)

    // `@thread_local` is the one of the three that chooses between the two keywords, so it is
    // answered before the shared "names several" rule: a reader who wrote it above a `val` has a
    // mistake about what the attribute is for, whatever the count of names.
    if thread_local && !holds_a_var(s)
        p.fault(Span(s.span.end, s.span.end), "'@thread_local' gives one 'var' a copy per thread, and a 'val' never changes — so the one copy every 'val' already has is every thread's, and a per-thread constant is a constant. Write it above a 'var' if the threads need to disagree")
        return s
    end if

    for i in 0..<attrs.len()
        attrs.at(i) match
            Align(n) -> align = Some(n)
            Section(name) -> section = Some(name)
            _ -> ()

    *s.kind match
        ValDecl(n, t, v, vis, _, _) -> stmt(s.span, ValDecl(n, t, v, vis, align, section))
        VarDecl(n, t, v, vis, _, _, _) ->
            stmt(s.span, VarDecl(n, t, v, vis, align, section, thread_local))
        StaticDecl(inner) -> stmt(s.span, StaticDecl(placed(p, inner, attrs)))

        // **Both annotations are about one object**, so a binding that names several has nothing for
        // them to be about. The refusal names the annotation rather than the binding, since the
        // annotation is the half that has to go.
        MultiDecl(_, _, _) -> refuse_several(p, s, attrs)
        PatternDecl(_, _, _) -> refuse_several(p, s, attrs)
        _ -> s
end placed

// Two sentences rather than one about "an annotation", each naming the thing it is about: `@align`'s
// when that is all there is, `@section`'s otherwise.
private refuse_several(p: *Parser, s: Stmt, attrs: Buf[Attr]) -> Stmt
    if attrs.is_empty() then return s

    var about = "'@align(n)' is the boundary one object's storage begins on"

    if !all_are(attrs, "align") then about = "'@section(\"...\")' places one object"

    p.fault(Span(s.span.end, s.span.end), s"${about}, and a binding that names several has " +
        "no one object for it to be about \u{2014} declare them on lines of their own")
    s
end refuse_several

// Whether a binding is a `var` -- the one keyword `@thread_local` marks -- reaching through the
// `static` wrapper. A comma list and a pattern are `var`s too, refused a line later for naming
// several.
private holds_a_var(s: Stmt) -> bool = *s.kind match
    VarDecl(_, _, _, _, _, _, _) -> true
    MultiDecl(_, mutable, _) -> mutable
    PatternDecl(_, mutable, _) -> mutable
    StaticDecl(inner) -> holds_a_var(inner)
    _ -> false
