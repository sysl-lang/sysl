// The discrete Fourier transform, twice: the O(n log n) one that everybody uses and the O(n^2)
// one that is the definition.
//
// Having both is the point. The fast transform is a rearrangement of the slow one, and a
// rearrangement is exactly the kind of thing that can be subtly wrong and still produce plausible
// numbers, so the slow one is kept as the thing to compare against. The published values in
// `main.sysl` then anchor the pair, since two implementations by the same author agreeing proves
// only that they agree.

import sysl.math.tau
import sysl.math.Bits
import sysl.math.is_power_of_two
import sysl.math.complex.Complex
import sysl.slices.sort_stable_by

enum Fault
    Empty
    NotPowerOfTwo
    LengthsDiffer

    describe(self) -> string = self match
        Empty -> "a transform needs at least one sample"
        NotPowerOfTwo -> "this transform is radix 2, so the length must be a power of two"
        LengthsDiffer -> "the two signals must have the same length"
end Fault

// How many times the length halves, which for a power of two is the position of its one bit — and
// `transform` has already refused anything else by the time this is asked.
private bit_width(n: usize) -> usize = usize(n.trailing_zeros())

// The low `bits` bits, in the opposite order, which is where the bit-reversal permutation sends
// each index.
//
// **This was a loop for two reasons and neither of them survived the asking**, which is the whole
// argument for writing a program against a young language rather than reasoning about it.
//
// The first was that the width could not be asked for. It can: `count_ones() + count_zeros()` is the
// width by construction, at whatever `Self` turned out to be, which is what `sysl.math` means by
// keeping the second of that pair rather than leaving it to a subtraction. Nothing has to hard-code
// 64.
//
// The second was the **empty shift**, and it was a real obstacle rather than a mistaken one: a
// one-sample transform arrives with `bits` at zero, since `bit_width(1)` is `trailing_zeros(1)`,
// which is zero — so the amount is the whole width. That used to be undefined, and it did not merely
// give a wrong answer, it gave a different one between two runs of one binary. It is defined now:
// shifting a value all the way answers what shifting it all the way means, so this is total at every
// `bits` and needs no guard in front of it.
private reverse_bits(v: usize, bits: usize) -> usize
    val w = usize(v.count_ones() + v.count_zeros())

    v.reverse_bits() >> (w - bits)
end reverse_bits

// Cooley-Tukey, in place, iterative. `sign` is what separates the two directions: -1 for the
// forward transform's `e^(-2*pi*i*k/n)` and +1 for the inverse's conjugate kernel, which is the
// whole of the difference between them apart from the final scaling.
private transform(xs: []Complex[real], sign: f64) -> Result[unit, Fault]
    if xs.len == 0 then return Err(Empty)
    if !is_power_of_two(xs.len) then return Err(NotPowerOfTwo)

    var n = xs.len
    var bits = bit_width(n)

    // Sorting the samples into bit-reversed order first is what lets the butterflies run over
    // contiguous halves afterwards. Swapping only when `j > i` visits each pair once.
    for i in 0..<n
        var j = reverse_bits(i, bits)

        if j > i
            var t = xs[i]

            xs[i] = xs[j]
            xs[j] = t

    var span: usize = 2

    while span <= n
        var half = span / 2
        var step = sign * tau / f64(span)
        var start: usize = 0

        while start < n
            for k in 0..<half
                var w = Complex.expi(step * f64(k))
                var a = xs[start + k]
                var b = xs[start + k + half] * w

                xs[start + k] = a + b
                xs[start + k + half] = a - b

            start += span

        span <<= 1

    Ok(())
end transform

fft(xs: []Complex[real]) -> Result[unit, Fault] = transform(xs, -1.0)

// The inverse is the forward transform with the kernel conjugated and everything divided by n. That
// division is a `Complex` scaled by a real, which is `Mul[real]` rather than `Mul` — one trait at
// the argument list that names the operand it takes, and the reason `sysl.math.complex` writes each
// of the four arithmetic operators twice.
ifft(xs: []Complex[real]) -> Result[unit, Fault]
    transform(xs, 1.0)?

    var k = 1.0 / f64(xs.len)

    for i in 0..<xs.len do xs[i] *= k

    Ok(())
end ifft

// The definition, summed term by term. Quadratic and slow, and that is what it is for.
dft(xs: []Complex[real]) -> []Complex[real]
    var n = xs.len
    var out: []Complex[real] = [Complex.zero(); n]

    for k in 0..<n
        var acc: Complex[real] = Complex.zero()

        for t in 0..<n do acc = acc + xs[t] * Complex.expi(-tau * f64(k) * f64(t) / f64(n))

        out[k] = acc

    out
end dft

magnitudes(xs: []Complex[real]) -> []f64
    var out: []f64 = [0.0; xs.len]

    for i in 0..<xs.len do out[i] = xs[i].abs()

    out
end magnitudes

// A copy, since every transform here works in place and a caller usually wants to keep what it
// started with.
copy_of(xs: []Complex[real]) -> []Complex[real]
    var out: []Complex[real] = [Complex.zero(); xs.len]

    for i in 0..<xs.len do out[i] = xs[i]

    out
end copy_of

real_signal(values: []f64) -> []Complex[real]
    var out: []Complex[real] = [Complex.zero(); values.len]

    for i in 0..<values.len do out[i] = Complex(values[i], 0.0)

    out
end real_signal

// Circular convolution through the transform: multiply the spectra pointwise and come back. The
// direct sum below computes the same thing by its definition, and the two agreeing is the
// convolution theorem holding.
convolve(a: []Complex[real], b: []Complex[real]) -> Result[[]Complex[real], Fault]
    if a.len != b.len then return Err(LengthsDiffer)

    var fa = copy_of(a)
    var fb = copy_of(b)

    fft(fa)?
    fft(fb)?

    for i in 0..<fa.len do fa[i] = fa[i] * fb[i]

    ifft(fa)?

    Ok(fa)
end convolve

convolve_directly(a: []Complex[real], b: []Complex[real]) -> Result[[]Complex[real], Fault]
    if a.len != b.len then return Err(LengthsDiffer)

    var n = a.len
    var out: []Complex[real] = [Complex.zero(); n]

    for i in 0..<n
        var acc: Complex[real] = Complex.zero()

        for j in 0..<n do acc = acc + a[j] * b[(i + n - j) % n]

        out[i] = acc

    Ok(out)
end convolve_directly

// One bin of a spectrum, ordered by how much energy is in it. `Ord` is one method and the other
// three comparisons come from it (`14 §2`), which is what the sort below leans on.
//
// **Written out rather than derived, and that is the point of the example.** `deriving Ord` walks
// every field in declaration order, which here would compare `k` first and order the spectrum by
// frequency — the opposite of what this wants. A derived block is right when the order the fields
// happen to be in *is* the order the type means; where a type orders by one of its fields, saying so
// is the whole declaration.
struct Bin
    k: usize
    mag: f64

impl Ord for Bin
    lt(self, rhs: Bin) -> bool = self.mag < rhs.mag

impl Eq for Bin
    eq(self, rhs: Bin) -> bool = self.mag == rhs.mag

// Strongest first, and **stable** — bins of equal energy keep their frequency order, which is what
// makes the answer to "which bins" reproducible for a real signal, where every bin has a mirror of
// exactly the same magnitude.
//
// **This used to be a hand-written insertion sort here**, because the library had no sorting at all.
// It now has two, and the choice between them is exactly the distinction this function cared about:
// `sort` is faster and unstable, and would let the mirrored pair come back either way round.
// `sort_stable` is the one whose promise this depends on, and it merges through scratch the caller
// supplies rather than allocating — so the storage is visible here, which is the honest cost of a
// stable sort and was hidden while the insertion sort paid it in time instead.
//
// Descending by passing the comparison the other way round. Equal bins satisfy neither ordering, so
// they keep the order they arrived in, which is the whole point.
peaks(xs: []Complex[real]) -> []Bin
    var bins: []Bin = [Bin(0, 0.0); xs.len]
    var scratch: []Bin = [Bin(0, 0.0); xs.len]

    for i in 0..<xs.len do bins[i] = Bin(i, xs[i].abs())

    sort_stable_by(bins, scratch, (a, b) -> b < a)

    bins
end peaks

// The energy in a signal, which Parseval's theorem says the transform preserves up to the factor
// n. Summing the squared magnitudes avoids the square roots entirely, which is what `norm_sqr` is
// for — and it is never called `norm`, because C++ and Rust give that word opposite meanings.
energy(xs: []Complex[real]) -> f64
    var total = 0.0

    for i in 0..<xs.len do total += xs[i].norm_sqr()

    total
end energy
