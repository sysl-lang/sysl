module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.text.{replace_all, Search}

// **A body printed as soon as it is built is the body printed at the end** (`codegen.sysl`'s
// `compact`). Every build that only wants the module's text -- `build`, `run`, `emit-llvm`, a test
// build -- prints each function as it is lowered and lets go of its blocks; what is asked of a body
// after that is asked of what was kept beside it: the globals it names, for the borrowing entries
// something names. So the text is compared, whole and byte for byte, with the module built whole and
// printed once: calls once, in a loop and twice, the borrowing entries a program names and the ones it
// does not, closures, generics, exports, a test build with its dispatcher and hooks, and both
// optimization levels that differ in what they import.
//
// Not here: a `bf16` target lowered to bits, which keeps its blocks (`codegen_into`); an inline `asm`
// naming a borrowing entry, which `referenced_globals` keeps as text and reads as `named_entries`
// always read one; the memory the compaction saves, which is a measurement (`SYSL_TIMINGS=1`'s memory
// lines), not a test.

private cpt_ready() -> bool = std_root().is_ok() && clang_available()

private cpt_root(files: []const (string, string)) -> string
    val root = absolute_path(replace_all(make_temp_dir("sysl-cpt").unwrap(), "//", "/"))

    for i in 0..<files.len
        val dir = files[i].0.last_index_of("/")

        if dir.is_some() then make_dir_all(s"$root/${files[i].0[0..<dir.unwrap()]}").unwrap()

        write_text(s"$root/${files[i].0}", files[i].1).unwrap()

    root
end cpt_root

// The text a build of `files` lowers to, printed as each body is built (`compact`) or at the end.
private cpt_text(root: string, linking: bool, level: string, compact: bool) -> string =
    emit_llvm_text(root, None, level, buf(), None, linking, false, false, compact) match
        Err(why) -> s"refused: ${failure_text(why)}"
        Ok(made) -> if made.report.is_empty() then made.text else analysis_report(made.report)

// Both ways, for a build that links and for `emit-llvm`'s text, at `level`.
// `must` is text the module has to hold, so a cell is known to reach what it is about.
private cpt_same(files: []const (string, string), level: string = DefaultOptimization, must: string = "define ")
    val root = cpt_root(files)

    for linking in [true, false]
        val whole = cpt_text(root, linking, level, false)
        val streamed = cpt_text(root, linking, level, true)

        assert(!whole.starts_with("refused: "), whole)
        assert(whole.contains(must), s"no '$must' in\n$whole")
        assert(streamed == whole, s"linking $linking at -O$level: printed as built\n$streamed\nagainst, at the end\n$whole")

    remove_dir_all(root).unwrap_or(())
end cpt_same

// Calls of each kind: `once` from the entry outside any loop, `inner` once from it, `hot` from a loop,
// and `twice` from two calls of the entry's.
private val cpt_calls: []const (string, string) = [("main.sysl", raw"""
    inner(n: int) -> int = n * 7
    once(n: int) -> int = inner(n) + 1
    hot(n: int) -> int = n + 3
    twice(n: int) -> int = n - 2

    main()
        var total = once(4)

        for i in 0..<10
            total += hot(i)

        total += twice(1) + twice(2)
        print(total)
    """)]

// Kept as IR text: a differential of two printing paths, pinning no text of its own, so a change cannot stale it.
@test("cpt: a program's text is the same printed as each body is built as printed at the end, linked or not")
cpt_calls_text_is_the_same()
    if !cpt_ready() then return

    cpt_same(cpt_calls)

// guards: -O0 IR is identical with or without the pass
@test("cpt: and at -O0, which imports no copies")
cpt_unoptimized_text_is_the_same()
    if !cpt_ready() then return

    cpt_same(cpt_calls, "0")

// guards: borrowing entries emit identical IR with or without the pass
@test("cpt: the borrowing entries a program names, and the ones it leaves out, are the same either way")
cpt_borrowing_entries_are_the_same()
    if !cpt_ready() then return

    // A struct wider than two words that a reader only reads is lent by address (`.owned`), and its
    // ordinary entry is emitted only where something names it: here a call through a closure does,
    // and the direct call does not.
    cpt_same([("main.sysl", raw"""
        import sysl.buf.buf

        struct Wide
            a: int
            b: int
            c: int

        sum(w: Wide) -> int = w.a + w.b + w.c
        width(w: Wide) -> int = w.c - w.a

        main()
            val f = (w: Wide) -> width(w)
            var b = buf[int]()

            b.push(sum(Wide(1, 2, 3)))
            print(b[0], f(Wide(4, 5, 6)))
        """)], DefaultOptimization, ".owned")

// guards: closures, generics, exports and modules emit identical IR with or without it
@test("cpt: closures, generics, methods, exports and a second module are the same either way")
cpt_the_other_shapes_are_the_same()
    if !cpt_ready() then return

    cpt_same([("main.sysl", raw"""
        import m

        struct P
            x: int

        impl P
            read(self) -> int = self.x * 2

        same[T](x: T) -> T = x
        apply(f: (int) -> int) -> int = f(5)

        @export("cpt_twice")
        twice(n: i32) -> i32 = n * 2

        @export("cpt_soft", weak)
        soft(n: i32) -> i32 = n + 1

        print(m.step(3), P(4).read(), same(9), same("s"), apply(n -> n + 1), twice(4), soft(1))
        """), ("m/m.sysl", "module m\n\nstep(n: int) -> int = n - 1\n")])

// A package with tests, hooks, a test answering a `Result`, and a program `main` beside them.
private val cpt_suite: []const (string, string) = [
    ("sysl.hocon", "package { name = \"cpt\", version = \"0.1.0\" }\n"),
    ("main.sysl", raw"""
        add(a: int, b: int) -> int = a + b

        main()
            print(add(1, 2))

        @setup
        ready()
            print("ready")

        @teardown
        done()
            print("done")

        @test("adds")
        adds()
            assert_eq(add(1, 1), 2)

        @test("answers")
        answers() -> Result[unit, string]
            if add(1, 1) != 2 then return Err("no")
            Ok(())

        @test("loops")
        loops()
            var n = 0
            for i in 0..<5
                n += add(i, 1)
            assert_eq(n, 15)
        """)]

@test("cpt: a test build's text, its dispatcher and hooks included, is the same printed as each body is built")
cpt_test_build_text_is_the_same()
    if !cpt_ready() then return

    val root = cpt_root(cpt_suite)

    for level in [DefaultOptimization, "0"]
        val whole = test_build_of(root, None, level, buf(), false)
        val streamed = test_build_of(root, None, level, buf(), true)

        assert(whole.is_ok() && streamed.is_ok(), "both built")

        val a = whole.unwrap().emitted.text
        val b = streamed.unwrap().emitted.text

        assert(a.contains("sysl.test.named"), a)
        assert(b == a, s"at -O$level: printed as built\n$b\nagainst, at the end\n$a")

    remove_dir_all(root).unwrap_or(())
end cpt_test_build_text_is_the_same
