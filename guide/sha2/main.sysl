print("-- the same bytes, differently divided")

check("sha-224 of abc, one byte at a time", one_at_a_time(new_sha224(), abc), sha224(abc))
check("sha-256 of abc, one byte at a time", one_at_a_time(new_sha256(), abc), sha256(abc))
check("sha-384 of abc, one byte at a time", one_at_a_time(new_sha384(), abc), sha384(abc))
check("sha-512 of abc, one byte at a time", one_at_a_time(new_sha512(), abc), sha512(abc))
check("sha-224 of 200 bytes, one at a time", one_at_a_time(new_sha224(), p200), sha224(p200))
check("sha-256 of 200 bytes, one at a time", one_at_a_time(new_sha256(), p200), sha256(p200))
check("sha-384 of 200 bytes, one at a time", one_at_a_time(new_sha384(), p200), sha384(p200))
check("sha-512 of 200 bytes, one at a time", one_at_a_time(new_sha512(), p200), sha512(p200))

print("-- a million bytes in a thousand pieces")

var thousand_a = repeated(97, 1000)

check("sha-224 of a million a's", streamed(new_sha224(), thousand_a, 1000), "20794655980c91d8bbb4c1ea97618a4bf03f42581948b2ee4ee7ad67")
check("sha-256 of a million a's", streamed(new_sha256(), thousand_a, 1000), "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0")
check("sha-384 of a million a's", streamed(new_sha384(), thousand_a, 1000), "9d0e1809716474cb086e834e310a4a1ced149e9c00f248527972cec5704c2a5b07b8b3dc38ecc4ebae97ddd87f3d8985")
check("sha-512 of a million a's", streamed(new_sha512(), thousand_a, 1000), "e718483d0ce769644e2e42c7bc15b4638e1f98b13b2044285632a803afa973ebde0ff244877ea60a4cb0432ce577c31beb009c5c2c49aa2e4eadb217ad8cc09b")

print("-- the pieces both widths are built from")

var x32 = 0x12345678u32
var x64 = 0x0123456789abcdefu64

check("a 32-bit rotate by four", w32(rotr(x32, 4)), "81234567")
check("a 32-bit rotate all the way round but four", w32(rotr(x32, 28)), "23456781")
check("a 64-bit rotate by eight", w64(rotr(x64, 8)), "ef0123456789abcd")
check("a 64-bit rotate all the way round but eight", w64(rotr(x64, 56)), "23456789abcdef01")
check("a rotate composes with its complement", w32(rotr(rotr(x32, 4), 28)), w32(x32))
check("the top byte of a 32-bit word", f"${top_byte(x32)}%02x", "12")
check("the top byte of a 64-bit word", f"${top_byte(x64)}%02x", "01")
check("choose, at 32 bits", w32(ch(0xf0f0f0f0u32, 0xaaaaaaaau32, 0x55555555u32)), "a5a5a5a5")
check("choose, at 64 bits", w64(ch(0xf0f0f0f0f0f0f0f0u64, 0xaaaaaaaaaaaaaaaau64, 0x5555555555555555u64)), "a5a5a5a5a5a5a5a5")
check("majority, at 32 bits", w32(maj(0xff00ff00u32, 0x00ff00ffu32, 0xffff0000u32)), "ffff0000")
check("majority, at 64 bits", w64(maj(0xff00ff00ff00ff00u64, 0x00ff00ff00ff00ffu64, 0xffffffff00000000u64)), "ffffffff00000000")
check("majority of three equal words is that word", w32(maj(x32, x32, x32)), "12345678")
check("choose with a zero selector takes the third", w32(ch(0u32, x32, 0xaabbccddu32)), "aabbccdd")

var one32 = 1u32
var one64 = 1u64

check("the small sigma nought of one, at 32 bits", w32(one32.ssig0()), "02004000")
check("the small sigma one of one, at 32 bits", w32(one32.ssig1()), "0000a000")
check("the big sigma nought of one, at 32 bits", w32(one32.bsig0()), "40080400")
check("the big sigma one of one, at 32 bits", w32(one32.bsig1()), "04200080")
check("the small sigma nought of one, at 64 bits", w64(one64.ssig0()), "8100000000000000")
check("the small sigma one of one, at 64 bits", w64(one64.ssig1()), "0000200000000008")
check("the big sigma nought of one, at 64 bits", w64(one64.bsig0()), "0000001042000000")
check("the big sigma one of one, at 64 bits", w64(one64.bsig1()), "0004400000800000")
check("a small sigma nought of something awkward", w32(0xdeadbeefu32.ssig0()), "abd31b0b")
check("a big sigma one of something awkward", w32(0xdeadbeefu32.bsig1()), "345e14a3")
check("a small sigma nought of something awkward, at 64 bits", w64(x64.ssig0()), "6f92c77c6c4f1aa1")
check("a big sigma one of something awkward, at 64 bits", w64(x64.bsig1()), "7703112333475567")

check("the first round constant, at 32 bits", w32(one32.k(0)), "428a2f98")
check("the last round constant, at 32 bits", w32(one32.k(63)), "c67178f2")
check("the first round constant, at 64 bits", w64(one64.k(0)), "428a2f98d728ae22")
check("the last round constant, at 64 bits", w64(one64.k(79)), "6c44198c4a475817")
check("the round count, at 32 bits", str(one32.rounds), "64")
check("the round count, at 64 bits", str(one64.rounds), "80")
check("the width a word reports, at 32 bits", str(one32.bits), "32")
check("the width a word reports, at 64 bits", str(one64.bits), "64")

print("-- what the four do not share")

check("a truncated digest is not a prefix of the long one", str(sha256(abc)[0..<56] == sha224(abc)), "false")
check("and neither is the wide one", str(sha512(abc)[0..<96] == sha384(abc)), "false")
check("a 224-bit digest is 56 hex characters", str(sha224(abc).len), "56")
check("a 256-bit digest is 64", str(sha256(abc).len), "64")
check("a 384-bit digest is 96", str(sha384(abc).len), "96")
check("a 512-bit digest is 128", str(sha512(abc).len), "128")

var flipped = pattern(64)

flipped[0] ^= 1

check("one flipped bit moves almost every nibble of a 256-bit digest", str(apart(sha256(p64), sha256(flipped))), "63")
check("and almost every nibble of a 512-bit one", str(apart(sha512(p64), sha512(flipped))), "118")
check("the flipped message really is one bit away", str(p64[0] ^ flipped[0]), "1")

print("-- keyed hashing")

var hk0 = repeated(0x0b, 20)
var hm0 = "Hi There".bytes
check("hmac-sha-224, a 20-byte key", hmac224(hk0, hm0), "896fb1128abbdf196832107cd49df33f47b4b1169912ba4f53684b22")
check("hmac-sha-256, a 20-byte key", hmac256(hk0, hm0), "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7")
check("hmac-sha-384, a 20-byte key", hmac384(hk0, hm0), "afd03944d84895626b0825f4ab46907f15f9dadbe4101ec682aa034c7cebc59cfaea9ea9076ede7f4af152e8b2fa9cb6")
check("hmac-sha-512, a 20-byte key", hmac512(hk0, hm0), "87aa7cdea5ef619d4ff0b4241a1d6cb02379f4e2ce4ec2787ad0b30545e17cdedaa833b7d6b8a702038b274eaea3f4e4be9d914eeb61f1702e696c203a126854")

var hk1 = "Jefe".bytes
var hm1 = "what do ya want for nothing?".bytes
check("hmac-sha-224, a short text key", hmac224(hk1, hm1), "a30e01098bc6dbbf45690f3a7e9e6d0f8bbea2a39e6148008fd05e44")
check("hmac-sha-256, a short text key", hmac256(hk1, hm1), "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")
check("hmac-sha-384, a short text key", hmac384(hk1, hm1), "af45d2e376484031617f78d2b58a6b1b9c7ef464f5a01b47e42ec3736322445e8e2240ca5e69e2c78b3239ecfab21649")
check("hmac-sha-512, a short text key", hmac512(hk1, hm1), "164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737")

var hk2 = repeated(0xaa, 20)
var hm2 = repeated(0xdd, 50)
check("hmac-sha-224, 50 bytes under a 20-byte key", hmac224(hk2, hm2), "7fb3cb3588c6c1f6ffa9694d7d6ad2649365b0c1f65d69d1ec8333ea")
check("hmac-sha-256, 50 bytes under a 20-byte key", hmac256(hk2, hm2), "773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe")
check("hmac-sha-384, 50 bytes under a 20-byte key", hmac384(hk2, hm2), "88062608d3e6ad8a0aa2ace014c8a86f0aa635d947ac9febe83ef4e55966144b2a5ab39dc13814b94e3ab6e101a34f27")
check("hmac-sha-512, 50 bytes under a 20-byte key", hmac512(hk2, hm2), "fa73b0089d56a284efb0f0756c890be9b1b5dbdd8ee81a3655f83e33b2279d39bf3e848279a722c806b485a47e67c807b946a337bee8942674278859e13292fb")

var hk3 = counting(25)
var hm3 = repeated(0xcd, 50)
check("hmac-sha-224, a counting key", hmac224(hk3, hm3), "6c11506874013cac6a2abc1bb382627cec6a90d86efc012de7afec5a")
check("hmac-sha-256, a counting key", hmac256(hk3, hm3), "82558a389a443c0ea4cc819899f2083a85f0faa3e578f8077a2e3ff46729665b")
check("hmac-sha-384, a counting key", hmac384(hk3, hm3), "3e8a69b7783c25851933ab6290af6ca77a9981480850009cc5577c6e1f573b4e6801dd23c4a7d679ccf8a386c674cffb")
check("hmac-sha-512, a counting key", hmac512(hk3, hm3), "b0ba465637458c6990e5a8c5f61d4af7e576d97ff94b872de76f8050361ee3dba91ca5c11aa25eb4d679275cc5788063a5f19741120c4f2de2adebeb10a298dd")

var hk4 = repeated(0xaa, 131)
var hm4 = "Test Using Larger Than Block-Size Key - Hash Key First".bytes
check("hmac-sha-224, a key longer than a block", hmac224(hk4, hm4), "95e9a0db962095adaebe9b2d6f0dbce2d499f112f2d2b7273fa6870e")
check("hmac-sha-256, a key longer than a block", hmac256(hk4, hm4), "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54")
check("hmac-sha-384, a key longer than a block", hmac384(hk4, hm4), "4ece084485813e9088d2c63a041bc5b44f9ef1012a2b588f3cd11f05033ac4c60c2ef6ab4030fe8296248df163f44952")
check("hmac-sha-512, a key longer than a block", hmac512(hk4, hm4), "80b24263c7c1a3ebb71493c1dd7be8b49b46d1f41b4aeec1121b013783f8f3526b56d037e05f2598bd0fd2215d6a1e5295e64f73f63f0aec8b915a985d786598")

var hk5 = repeated(0xaa, 131)
var hm5 = longer_message()
check("hmac-sha-224, a long message under a long key", hmac224(hk5, hm5), "3a854166ac5d9f023f54d517d0b39dbd946770db9c2b95c9f6f565d1")
check("hmac-sha-256, a long message under a long key", hmac256(hk5, hm5), "9b09ffa71b942fcb27635fbcd5b0e944bfdc63644f0713938a7f51535c3a35e2")
check("hmac-sha-384, a long message under a long key", hmac384(hk5, hm5), "6617178e941f020d351e2f254e8fd32c602420feb0b8fb9adccebb82461e99c5a678cc31e799176d3860e6110c46523e")
check("hmac-sha-512, a long message under a long key", hmac512(hk5, hm5), "e37b6a775dc87dbaa4dfa9f96e5e3ffddebd71f8867289865df5a32d20cdc944b6022cac3c4982b10d5eeb55c3e4de15134676fb6de0446065c97440fa8c6a58")

var padded_key = repeated(0, 64)

padded_key[0] = 107

check("a short key is that key padded with zeroes to a block", hmac256("k".bytes, abc), hmac256(padded_key, abc))
check("a key of exactly one block is not the same as one byte more", str(hmac256(repeated(0xaa, 64), abc) == hmac256(repeated(0xaa, 65), abc)), "false")
check("the key matters", str(hmac256("k1".bytes, abc) == hmac256("k2".bytes, abc)), "false")
check("the message matters", str(hmac256("k".bytes, abc) == hmac256("k".bytes, alpha448)), "false")
check("a keyed hash is not the plain one", str(hmac256("".bytes, abc) == sha256(abc)), "false")

print("-- what a hasher refuses")

var unstarted: Sha[u32]
var eight: []u8 = [0u8; 8]
var thirtytwo: []u8 = [0u8; 32]
var thirtyone: []u8 = [0u8; 31]

check("a hasher that was never started", why(unstarted.finish(eight)), "this hasher was never given its initial values")

var cramped = new_sha256()

check("a digest buffer one byte too small", why(cramped.finish(thirtyone)), "the digest does not fit in the space provided")
check("and nothing was written into it", str(thirtyone[0]), "0")

var roomy = new_sha256()

check("a buffer of exactly the right size is enough", str(roomy.finish(thirtytwo).is_ok()), "true")
check("and it holds the digest", hex(thirtytwo), sha256("".bytes))

var wide = new_sha512()

check("a 512-bit digest does not fit where a 256-bit one does", why(wide.finish(thirtytwo)), "the digest does not fit in the space provided")
