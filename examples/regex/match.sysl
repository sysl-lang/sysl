// A program using the `rx` library, which is bound to POSIX regex through the C beside it.
//
// Unlike the other examples this one needs a library, so it takes two commands rather than one:
//
//     sbt "syslJVM/run build-lib examples/regex/lib -o /tmp/rx.syslib"
//     sbt "syslJVM/run run examples/regex/match.sysl --lib /tmp/rx.syslib"
//
// `build-lib` finds `regex.c` because it is in the library's tree, compiles it for the same target
// as the sysl, and archives both into `rx.syslib`. Nothing on this side knows C is involved.

import rx.*

show(re: Regex, s: string) =
    re.find(s) match
        Some(m) -> print(f"${s}%-8s ${m.start}..${m.end}")
        None -> print(f"${s}%-8s no match")

compile("^a+b+$") match
    Ok(re) ->
        show(re, "aab")
        show(re, "abbbb")
        show(re, "ba")
        re.free()

    Err(why) -> print(why)

// A pattern that is not one, which is the path a binding has to have an answer for. The message
// comes from the C library itself, through `from_cstring`.
compile("a[") match
    Ok(re) ->
        print("a[ compiled, and should not have")
        re.free()

    Err(why) -> print(f"a[ is not a pattern: ${why}")
