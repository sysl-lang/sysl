// Entry-style update as a place: `m.entry(k, init) += 1`, where `entry` puts `init` first if `k` is
// absent and answers the value's place (`-> ref V`), the body a dereference of a pointer a helper
// answers.

struct Sorted[K: Ord, V]
    keys: []K
    vals: []V
    len: usize

    place_or_put(*self, k: K, init: V) -> *V
        var i: usize = 0

        while i < self.len && self.keys[i] < k
            i += 1

        if i < self.len && !(k < self.keys[i]) then return &self.vals[i]

        slot_place(self.keys, self.len, k)
        slot_place(self.vals, self.len, init)
        self.len += 1
        &self.vals[self.len - 1]
    end place_or_put

    index_or_put(*self, k: K, init: V) -> usize
        var i: usize = 0

        while i < self.len && self.keys[i] < k
            i += 1

        if i < self.len && !(k < self.keys[i]) then return i

        slot_place(self.keys, self.len, k)
        slot_place(self.vals, self.len, init)
        self.len += 1
        self.len - 1
    end index_or_put

    entry(*self, k: K, init: V) -> ref V = *self.place_or_put(k, init)
end Sorted

var m: Sorted[string, int] = Sorted(slot_storage(4), slot_storage(4), 0)

for w in ["a", "b", "a", "a"]
    m.entry(w, 0) += 1

print(m.len, m.vals[0], m.vals[1])
