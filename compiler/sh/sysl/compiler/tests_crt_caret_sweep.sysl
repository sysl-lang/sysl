module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.text.{join, replace_all, split, str_builder, Search}

// **The caret sweep: where both compilers refuse an input, the WHOLE first report is compared** --
// the message, the `-->` line's line and column, the quoted line and the caret under it -- rather than
// the message alone. `tests_oracle.sysl` runs it inside two sweeps: the `emit-ast` sweep over the
// reference pages' blocks (parse refusals, rendered by `parse_report`) and the whole-program sweep
// (analysis refusals, rendered by `analysis_report`). The `-->` line is compared from its line and
// column, the two compilers being handed one file under one name but a caller's working directory
// being nobody's business.
//
// Every report that differs is put in one class -- `message` (the `error:` lines differ), `where`
// (the line or column differs), `caret` (only the caret line differs: its column or its width) or
// `other` (a line more or less, a quoted line that differs) -- and counted under its diagnostic's
// kind, which is the reference's message with every quoted name made `_` and cut to five words, so
// one row stands for one diagnostic however many names it quoted. The rows are held to the same
// ratchet as the spans (`scripts/spans_ratchet.tsv`, sweeps `carets-ast` and `carets-whole`). A
// difference this compiler makes on purpose is excused by name instead (`deliberate`), with its reason
// in the summary.

// What a caret sweep found: how many reports it compared, how many differed, and per
// `<class> <kind>` how many, with the first few quoted from both sides.
struct CaretTally
    compared: usize
    differing: usize
    kinds: Buf[(string, usize)]
    first_bad: string

    // The reports `deliberate` excused, each named with its reason, for the summary.
    excused: usize
    excused_reports: string
end CaretTally

empty_carets() -> CaretTally = CaretTally(0, 0, buf(), "", 0, "")

// **The refusals that differ from 0.0.162's on purpose**, by this compiler's message: a report whose
// difference is one of these is excused, named with its reason, and counted apart from the ratchet.
// Each is a self-hosted-only rule the user approved, so the reference cannot say the same thing.
deliberate(theirs: string, ours: string) -> Option[string]
    // `nan` and `infinity` are constants here alone (`wnf_`), so a `within` ending at `nan` is a
    // constant this compiler refuses for being NaN, where to 0.0.162 `nan` is no constant at all.
    if ours.starts_with("error: a 'within' bound may not be NaN")
        return Some("a 'within' bound at 'nan' -- 'nan' is a constant here alone (wnf_)")

    None
end deliberate

// The first report of a rendered refusal: from its first `error:` line to the blank line that ends it
// (or the next `error:`), each line without trailing spaces. Nothing where the text holds no error.
first_report(text: string) -> Buf[string]
    var out: Buf[string] = buf()

    for line in split(text, "\n")
        val held = line.trim_end()

        if out.is_empty()
            if held.starts_with("error: ") then out.push(held)
        else if held == "" || held.starts_with("error: ")
            return out
        else
            out.push(held)

    out
end first_report

// The line and column a `-->` line names, without the file: ` --> /tmp/x/block.sysl:3:7` is `3:7`.
// A line that is not one is answered as it stands.
report_place(line: string) -> string
    if !line.trim().starts_with("-->") then return line

    val bytes = line.bytes
    var colons = 0
    var i = bytes.len

    while i > 0
        i -= 1

        if bytes[i] == u8(':')
            colons += 1

            if colons == 2 then return line[i + 1..]

    line
end report_place

// Whether a report line is the caret line: nothing on it after the gutter's `|` but carets.
private is_caret_line(line: string) -> bool
    val bar = line.index_of("|") match
        Some(at) -> at
        None -> return false

    val rest = line[bar + 1..].trim()

    rest != "" && rest.bytes.len == count_carets(rest)
end is_caret_line

private count_carets(text: string) -> usize
    var n: usize = 0

    for i in 0..<text.bytes.len
        if text.bytes[i] == u8('^') then n += 1

    n
end count_carets

// Where a report's `-->` line is, or its length where it has none.
private place_line(r: Buf[string]) -> usize
    for i in 0..<r.len()
        if r.at(i).trim().starts_with("-->") then return i

    r.len()
end place_line

// Which class two first reports differ in, or "" where they are the same report.
//
// **The message is its `error:` line.** A line between it and the `-->` line is the C compiler's own
// output quoted into a refused `c const` block's message, naming the probe file each compiler wrote
// for itself, so it is clang's report rather than either compiler's.
report_gap(theirs: Buf[string], ours: Buf[string]) -> string
    if theirs.at(0) != ours.at(0) then return "message"

    val a = place_line(theirs)
    val b = place_line(ours)
    val a_place = if a < theirs.len() then report_place(theirs.at(a)) else ""
    val b_place = if b < ours.len() then report_place(ours.at(b)) else ""

    if a_place != b_place then return "where"
    if theirs.len() - a != ours.len() - b then return "other"

    var gap = ""

    for i in 1..<theirs.len() - a
        if theirs.at(a + i) != ours.at(b + i)
            if is_caret_line(theirs.at(a + i)) && is_caret_line(ours.at(b + i))
                if gap == "" then gap = "caret"
            else
                return "other"

    gap
end report_gap

// The diagnostic a message is: `error:` taken off, every quoted run made `_`, cut to five words, so
// `'x' of 'f' is int, but string was given` is `_ of _ is int,`.
diagnostic_kind(message: string) -> string
    val text = if message.starts_with("error: ") then message[7..] else message
    var out: Buf[string] = buf()
    var inside = false

    // A quote opens a name only at the start of a word, so the apostrophe in `target's` is text, and
    // a name may run over several words (`'@section("a b")'`) until a word holding the closing quote.
    for word in split(text, " ")
        if inside
            if word.contains("'") then inside = false

            continue
        end if

        if out.len() == 5 then break

        if word.starts_with("'")
            out.push("_")
            inside = !word[1..].contains("'")
        else
            out.push(word)

    join(out.view(), " ")
end diagnostic_kind

// One input both compilers refused: their two rendered refusals compared, the first report of each.
compare_reports(theirs: string, ours: string, label: string, found: *CaretTally)
    val a = first_report(theirs)
    val b = first_report(ours)

    if a.is_empty() || b.is_empty() then return

    found.compared += 1

    val gap = report_gap(a, b)

    if gap == "" then return

    deliberate(a.at(0), b.at(0)) match
        Some(why) ->
            found.excused += 1
            found.excused_reports = s"${found.excused_reports}\n  $label: $why"
            return
        None -> ()

    found.differing += 1
    tally_kind(&found.kinds, s"$gap ${diagnostic_kind(a.at(0))}")

    if found.differing <= 12
        var quote = str_builder()

        quote.push(s"\n  $label ($gap):")

        for i in 0..<a.len()
            quote.push(s"\n    reference | ${a.at(i)}")

        for i in 0..<b.len()
            quote.push(s"\n    ours      | ${b.at(i)}")

        found.first_bad = found.first_bad + quote.finish()
    end if
end compare_reports

// The sweep's line for the summary file.
caret_summary(sweep: string, found: CaretTally) -> string
    var out = str_builder()

    out.push(s"carets ($sweep): ${found.compared} refusals both compilers made, ${found.differing} " +
             s"reported differently, ${found.excused} excused as deliberate${found.excused_reports}")

    for i in 0..<found.kinds.len()
        out.push(s"\n  ${found.kinds.at(i).1} ${found.kinds.at(i).0}")

    out.push(found.first_bad)
    out.finish()
end caret_summary

// -- without a reference ---------------------------------------------------------------------------

private reference_text() -> string = raw"""
    error: 'x' of 'f' is int, but string was given
     --> /tmp/a/block.sysl:2:16
      |
    2 | val y: int = f("a")
      |                ^^^
    """

@test("carets: the first report is its error line to the blank line, trailing spaces gone")
crt_the_first_report_is_read()
    val r = first_report("warning: x\nerror: a  \n --> f.sysl:1:2\n  |\n1 | x\n  | ^\n\nerror: b\n")

    assert_eq(r.len(), 5)
    assert_eq(r.at(0), "error: a")
    assert_eq(r.at(4), "  | ^")
    assert(first_report("nothing went wrong").is_empty(), "no error, no report")
end crt_the_first_report_is_read

@test("carets: a --> line is compared by its line and column, not its file")
crt_the_place_drops_the_file()
    assert_eq(report_place(" --> /tmp/a/block.sysl:2:16"), "2:16")
    assert_eq(report_place(" --> block.sysl:12:1"), "12:1")
    assert_eq(report_place("  |"), "  |")
end crt_the_place_drops_the_file

@test("carets: the same report in two directories is no difference")
crt_the_same_report_agrees()
    val ours = replace_all(reference_text(), "/tmp/a/", "/var/b/")

    assert_eq(report_gap(first_report(reference_text()), first_report(ours)), "")
end crt_the_same_report_agrees

@test("carets: a report differing in its caret alone, its place, its message or its shape is classed so")
crt_the_classes()
    val theirs = first_report(reference_text())

    assert_eq(report_gap(theirs, first_report(replace_all(reference_text(), "^^^", "^^^^^^^^"))), "caret")
    assert_eq(report_gap(theirs, first_report(replace_all(reference_text(), "2:16", "2:14"))), "where")
    assert_eq(report_gap(theirs, first_report(replace_all(reference_text(), "string", "str"))), "message")
    assert_eq(report_gap(theirs, first_report(replace_all(reference_text(), "val y", "var y"))), "other")
end crt_the_classes

@test("carets: a deliberate divergence is excused by name and kept out of the classes")
crt_a_deliberate_divergence_is_excused()
    var found = empty_carets()
    val ours = replace_all(reference_text(), "'x' of 'f' is int, but string was given",
                           "a 'within' bound may not be NaN — every comparison with one is false")

    compare_reports(reference_text(), ours, "nan", &found)

    assert_eq(found.compared, 1)
    assert_eq(found.differing, 0)
    assert_eq(found.excused, 1)
    assert(found.excused_reports.contains("nan: a 'within' bound at 'nan'"), found.excused_reports)

@test("carets: the C compiler's own lines quoted into a message are not compared, the rest is")
crt_quoted_clang_output_is_skipped()
    val theirs = "error: the C compiler refused this file's 'c const' block:\n/tmp/a-1.c:2:1: fatal error\n" +
                 " --> /tmp/a/block.sysl:4:5\n  |\n4 |     N: usize = \"x\"\n  |     ^^^^^^^^^^^^\n"
    val ours = replace_all(replace_all(theirs, "/tmp/a-1.c:2:1", "/tmp/b/probe.c:1:1"), "/tmp/a/", "/v/")

    assert_eq(report_gap(first_report(theirs), first_report(ours)), "")
    assert_eq(report_gap(first_report(theirs), first_report(replace_all(ours, "4:5", "1:1"))), "where")

@test("carets: a diagnostic's kind is its message with the quoted names made _, five words long")
crt_the_kind_of_a_diagnostic()
    assert_eq(diagnostic_kind("error: 'x' of 'f' is int, but string was given"), "_ of _ is int,")
    assert_eq(diagnostic_kind("error: expression expected"), "expression expected")
    assert_eq(diagnostic_kind("error: 'a-b' is a target's name rather than"), "_ is a target's name")
    assert_eq(diagnostic_kind("error: '@section(\"a b\")' places one — object in"), "_ places one — object")
end crt_the_kind_of_a_diagnostic

@test("carets: a differing report is counted under its class and kind, quoted from both sides")
crt_a_difference_is_tallied()
    var found = empty_carets()

    compare_reports(reference_text(), reference_text(), "same", &found)
    compare_reports(reference_text(), replace_all(reference_text(), "^^^", "^"), "narrow", &found)
    compare_reports("", reference_text(), "one-sided", &found)

    assert_eq(found.compared, 2)
    assert_eq(found.differing, 1)
    assert_eq(found.kinds.len(), 1)
    assert_eq(found.kinds.at(0).0, "caret _ of _ is int,")
    assert(found.first_bad.contains("narrow (caret)"), found.first_bad)
end crt_a_difference_is_tallied
