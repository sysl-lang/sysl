module sh.sysl.compiler
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// What a `string`, a view, a method table, a sink, a `?` and an invariant become.
//
// **Every LLVM text here was read out of the reference compiler**, by handing the installed `sysl`
// the same source and quoting `emit-llvm` -- never composed from the rule.
//
// **Each program is lowered beside the library and pruned**, which is what the driver does: the
// forms below reach the library's own printing and its `Result`, and a body the reference kept and
// this one dropped is exactly the kind of difference worth a test. So each program carries a `main`
// that reaches the function under test.

private var str_library_cache: Buf[Program] = buf()
private var str_library_read: bool = false

private str_library() -> Buf[Program]
    if str_library_read then return str_library_cache

    str_library_read = true

    std_root() match
        Err(_) -> ()
        Ok(root) -> std_units(root, host_target()) match
            Err(_) -> ()
            Ok(units) -> str_library_cache = units

    str_library_cache
end str_library

private no_str_library() -> bool
    if str_library().is_empty()
        print("skipped: the standard module's source is not on this machine")
        return true

    false
end no_str_library

// One source lowered the way the driver lowers it -- analyzed beside the library, checked, pruned --
// and the LLVM text of the function named. A body this compiler could not finish answers with the
// form it reached, so a failure says why rather than only that.
private str_lowered(text: string, symbol: string) -> string
    val parsed = parse(source_of("test.sysl", text))

    if !parsed.ok() then return parsed.report.at(0).message

    var units: Buf[Program] = buf()
    val library = str_library()

    for i in 0..<library.len()
        units.push(library.at(i))

    units.push(parsed.program)

    val done = analyze_bodies(units, host_target())

    if !done.reported.is_empty() then return done.reported.at(0).diag.message

    val whole = program_of(done, done.main_module)

    var own: Buf[string] = buf()

    own.push(module_written(parsed.program))

    val promotions = post_analysis_checks(done.an, whole, own)
    val kept = prune(strip_tests(whole), own)
    val lowered = codegen_with_gaps(kept, host_target(), promotions)
    val texts = func_texts(ir_print_module(lowered.0))

    for i in 0..<texts.len()
        if texts.at(i).0 == symbol then return texts.at(i).1

    for i in 0..<lowered.1.len()
        if llvm_safe(lowered.1.at(i).0) == symbol then
            return s"not lowered: ${lowered.1.at(i).1}"

    s"no definition of '$symbol'"
end str_lowered

// What the same source is refused with, which is what an error path is proved against.
private str_refusal(text: string) -> string
    val parsed = parse(source_of("test.sysl", text))

    if !parsed.ok() then return parsed.report.at(0).message

    var units: Buf[Program] = buf()
    val library = str_library()

    for i in 0..<library.len()
        units.push(library.at(i))

    units.push(parsed.program)

    val done = analyze_bodies(units, host_target())

    if done.reported.is_empty() then return ""

    done.reported.at(0).diag.message
end str_refusal

@test("a string literal is the owner nothing frees, the bytes, and how many there are")
a_literal_is_three_words()
    if no_str_library() then return

    assert_eq(str_lowered(
                  "lit() -> string = \"hi\"\n" +
                  "main() = prints(lit())\n",
              "lit"),
              "define { ptr, ptr, i64 } @lit() {\n" +
              "entry:\n" +
              "  %t1 = extractvalue { ptr, ptr, i64 } { ptr null, ptr @.str1, i64 2 }, 0\n" +
              "  call void @arc.retain_maybe(ptr %t1)\n" +
              "  ret { ptr, ptr, i64 } { ptr null, ptr @.str1, i64 2 }\n" +
              "}\n")
end a_literal_is_three_words

@test("concatenation allocates a buffer, copies both halves in, and owns what comes back")
two_strings_join_into_a_fresh_one()
    if no_str_library() then return

    assert_eq(str_lowered(
                  "join(a: string, b: string) -> string = a + b\n" +
                  "main() = prints(join(\"a\", \"b\"))\n",
              "join"),
              "define { ptr, ptr, i64 } @join({ ptr, ptr, i64 } %a.param, { ptr, ptr, i64 } %b.param) {\n" +
              "entry:\n" +
              "  %a.addr = alloca { ptr, ptr, i64 }\n" +
              "  %b.addr = alloca { ptr, ptr, i64 }\n" +
              "  store { ptr, ptr, i64 } %a.param, ptr %a.addr\n" +
              "  %t1 = extractvalue { ptr, ptr, i64 } %a.param, 0\n" +
              "  call void @arc.retain_maybe(ptr %t1)\n" +
              "  store { ptr, ptr, i64 } %b.param, ptr %b.addr\n" +
              "  %t2 = extractvalue { ptr, ptr, i64 } %b.param, 0\n" +
              "  call void @arc.retain_maybe(ptr %t2)\n" +
              "  %t3 = load { ptr, ptr, i64 }, ptr %a.addr\n" +
              "  %t4 = load { ptr, ptr, i64 }, ptr %b.addr\n" +
              "  %t5 = extractvalue { ptr, ptr, i64 } %t3, 1\n" +
              "  %t6 = extractvalue { ptr, ptr, i64 } %t3, 2\n" +
              "  %t7 = extractvalue { ptr, ptr, i64 } %t4, 1\n" +
              "  %t8 = extractvalue { ptr, ptr, i64 } %t4, 2\n" +
              "  %t9 = call { ptr, ptr, i64 } @sysl.str.concat(ptr %t5, i64 %t6, ptr %t7, i64 %t8)\n" +
              "  %t10 = extractvalue { ptr, ptr, i64 } %t9, 0\n" +
              "  call void @arc.retain_maybe(ptr %t10)\n" +
              "  %t11 = extractvalue { ptr, ptr, i64 } %t9, 0\n" +
              "  call void @arc.release_maybe(ptr %t11)\n" +
              "  %t12 = load { ptr, ptr, i64 }, ptr %b.addr\n" +
              "  %t13 = extractvalue { ptr, ptr, i64 } %t12, 0\n" +
              "  call void @arc.release_maybe(ptr %t13)\n" +
              "  %t14 = load { ptr, ptr, i64 }, ptr %a.addr\n" +
              "  %t15 = extractvalue { ptr, ptr, i64 } %t14, 0\n" +
              "  call void @arc.release_maybe(ptr %t15)\n" +
              "  ret { ptr, ptr, i64 } %t9\n" +
              "}\n")
end two_strings_join_into_a_fresh_one

@test("a compound assignment on a string is the same join, stored back over what was there")
a_string_grows_in_place()
    if no_str_library() then return

    assert_eq(str_lowered(
                  "grow(a: string) -> string\n" +
                  "    var acc = a\n" +
                  "\n" +
                  "    acc += \"x\"\n" +
                  "    acc\n" +
                  "main() = prints(grow(\"a\"))\n",
              "grow"),
              "define { ptr, ptr, i64 } @grow({ ptr, ptr, i64 } %a.param) {\n" +
              "entry:\n" +
              "  %a.addr = alloca { ptr, ptr, i64 }\n" +
              "  %acc.addr = alloca { ptr, ptr, i64 }\n" +
              "  store { ptr, ptr, i64 } %a.param, ptr %a.addr\n" +
              "  %t1 = extractvalue { ptr, ptr, i64 } %a.param, 0\n" +
              "  call void @arc.retain_maybe(ptr %t1)\n" +
              "  %t2 = load { ptr, ptr, i64 }, ptr %a.addr\n" +
              "  %t3 = extractvalue { ptr, ptr, i64 } %t2, 0\n" +
              "  call void @arc.retain_maybe(ptr %t3)\n" +
              "  store { ptr, ptr, i64 } %t2, ptr %acc.addr\n" +
              "  %t4 = load { ptr, ptr, i64 }, ptr %acc.addr\n" +
              "  %t5 = extractvalue { ptr, ptr, i64 } %t4, 1\n" +
              "  %t6 = extractvalue { ptr, ptr, i64 } %t4, 2\n" +
              "  %t7 = extractvalue { ptr, ptr, i64 } { ptr null, ptr @.str1, i64 1 }, 1\n" +
              "  %t8 = extractvalue { ptr, ptr, i64 } { ptr null, ptr @.str1, i64 1 }, 2\n" +
              "  %t9 = call { ptr, ptr, i64 } @sysl.str.concat(ptr %t5, i64 %t6, ptr %t7, i64 %t8)\n" +
              "  %t10 = extractvalue { ptr, ptr, i64 } %t9, 0\n" +
              "  call void @arc.retain_maybe(ptr %t10)\n" +
              "  store { ptr, ptr, i64 } %t9, ptr %acc.addr\n" +
              "  %t11 = extractvalue { ptr, ptr, i64 } %t4, 0\n" +
              "  call void @arc.release_maybe(ptr %t11)\n" +
              "  %t12 = extractvalue { ptr, ptr, i64 } %t9, 0\n" +
              "  call void @arc.release_maybe(ptr %t12)\n" +
              "  %t13 = load { ptr, ptr, i64 }, ptr %acc.addr\n" +
              "  %t14 = extractvalue { ptr, ptr, i64 } %t13, 0\n" +
              "  call void @arc.retain_maybe(ptr %t14)\n" +
              "  %t15 = load { ptr, ptr, i64 }, ptr %acc.addr\n" +
              "  %t16 = extractvalue { ptr, ptr, i64 } %t15, 0\n" +
              "  call void @arc.release_maybe(ptr %t16)\n" +
              "  %t17 = load { ptr, ptr, i64 }, ptr %a.addr\n" +
              "  %t18 = extractvalue { ptr, ptr, i64 } %t17, 0\n" +
              "  call void @arc.release_maybe(ptr %t18)\n" +
              "  ret { ptr, ptr, i64 } %t13\n" +
              "}\n")
end a_string_grows_in_place

@test("equality on strings is one call and an icmp against its answer")
two_strings_compare_by_their_bytes()
    if no_str_library() then return

    assert_eq(str_lowered(
                  "same(a: string, b: string) -> bool = a == b\n" +
                  "main() = print(same(\"a\", \"b\"))\n",
              "same"),
              "define zeroext i1 @same({ ptr, ptr, i64 } %a.param, { ptr, ptr, i64 } %b.param) {\n" +
              "entry:\n" +
              "  %a.addr = alloca { ptr, ptr, i64 }\n" +
              "  %b.addr = alloca { ptr, ptr, i64 }\n" +
              "  store { ptr, ptr, i64 } %a.param, ptr %a.addr\n" +
              "  %t1 = extractvalue { ptr, ptr, i64 } %a.param, 0\n" +
              "  call void @arc.retain_maybe(ptr %t1)\n" +
              "  store { ptr, ptr, i64 } %b.param, ptr %b.addr\n" +
              "  %t2 = extractvalue { ptr, ptr, i64 } %b.param, 0\n" +
              "  call void @arc.retain_maybe(ptr %t2)\n" +
              "  %t3 = load { ptr, ptr, i64 }, ptr %a.addr\n" +
              "  %t4 = load { ptr, ptr, i64 }, ptr %b.addr\n" +
              "  %t5 = extractvalue { ptr, ptr, i64 } %t3, 1\n" +
              "  %t6 = extractvalue { ptr, ptr, i64 } %t3, 2\n" +
              "  %t7 = extractvalue { ptr, ptr, i64 } %t4, 1\n" +
              "  %t8 = extractvalue { ptr, ptr, i64 } %t4, 2\n" +
              "  %t9 = call i32 @sysl.str.cmp(ptr %t5, i64 %t6, ptr %t7, i64 %t8)\n" +
              "  %t10 = icmp eq i32 %t9, 0\n" +
              "  %t11 = load { ptr, ptr, i64 }, ptr %b.addr\n" +
              "  %t12 = extractvalue { ptr, ptr, i64 } %t11, 0\n" +
              "  call void @arc.release_maybe(ptr %t12)\n" +
              "  %t13 = load { ptr, ptr, i64 }, ptr %a.addr\n" +
              "  %t14 = extractvalue { ptr, ptr, i64 } %t13, 0\n" +
              "  call void @arc.release_maybe(ptr %t14)\n" +
              "  ret i1 %t10\n" +
              "}\n")
end two_strings_compare_by_their_bytes

@test("an ordering comparison reads the same -1 / 0 / 1 a subtraction would")
strings_order_by_their_bytes()
    if no_str_library() then return

    assert_eq(str_lowered(
                  "order(a: string, b: string) -> bool = a < b\n" +
                  "main() = print(order(\"a\", \"b\"))\n",
              "order"),
              "define zeroext i1 @order({ ptr, ptr, i64 } %a.param, { ptr, ptr, i64 } %b.param) {\n" +
              "entry:\n" +
              "  %a.addr = alloca { ptr, ptr, i64 }\n" +
              "  %b.addr = alloca { ptr, ptr, i64 }\n" +
              "  store { ptr, ptr, i64 } %a.param, ptr %a.addr\n" +
              "  %t1 = extractvalue { ptr, ptr, i64 } %a.param, 0\n" +
              "  call void @arc.retain_maybe(ptr %t1)\n" +
              "  store { ptr, ptr, i64 } %b.param, ptr %b.addr\n" +
              "  %t2 = extractvalue { ptr, ptr, i64 } %b.param, 0\n" +
              "  call void @arc.retain_maybe(ptr %t2)\n" +
              "  %t3 = load { ptr, ptr, i64 }, ptr %a.addr\n" +
              "  %t4 = load { ptr, ptr, i64 }, ptr %b.addr\n" +
              "  %t5 = extractvalue { ptr, ptr, i64 } %t3, 1\n" +
              "  %t6 = extractvalue { ptr, ptr, i64 } %t3, 2\n" +
              "  %t7 = extractvalue { ptr, ptr, i64 } %t4, 1\n" +
              "  %t8 = extractvalue { ptr, ptr, i64 } %t4, 2\n" +
              "  %t9 = call i32 @sysl.str.cmp(ptr %t5, i64 %t6, ptr %t7, i64 %t8)\n" +
              "  %t10 = icmp slt i32 %t9, 0\n" +
              "  %t11 = load { ptr, ptr, i64 }, ptr %b.addr\n" +
              "  %t12 = extractvalue { ptr, ptr, i64 } %t11, 0\n" +
              "  call void @arc.release_maybe(ptr %t12)\n" +
              "  %t13 = load { ptr, ptr, i64 }, ptr %a.addr\n" +
              "  %t14 = extractvalue { ptr, ptr, i64 } %t13, 0\n" +
              "  call void @arc.release_maybe(ptr %t14)\n" +
              "  ret i1 %t10\n" +
              "}\n")
end strings_order_by_their_bytes

@test("str of an integer widens to 64 bits and renders through one shared function")
an_integer_renders_through_the_shared_renderer()
    if no_str_library() then return

    assert_eq(str_lowered(
                  "si(n: int) -> string = str(n)\n" +
                  "main() = prints(si(1))\n",
              "si"),
              "define { ptr, ptr, i64 } @si(i32 %n.param) {\n" +
              "entry:\n" +
              "  %n.addr = alloca i32\n" +
              "  store i32 %n.param, ptr %n.addr\n" +
              "  %t1 = load i32, ptr %n.addr\n" +
              "  %t2 = sext i32 %t1 to i64\n" +
              "  %t3 = call { ptr, ptr, i64 } @sysl.str.int(i64 %t2, i1 1)\n" +
              "  %t4 = extractvalue { ptr, ptr, i64 } %t3, 0\n" +
              "  call void @arc.retain_maybe(ptr %t4)\n" +
              "  %t5 = extractvalue { ptr, ptr, i64 } %t3, 0\n" +
              "  call void @arc.release_maybe(ptr %t5)\n" +
              "  ret { ptr, ptr, i64 } %t3\n" +
              "}\n")
end an_integer_renders_through_the_shared_renderer

@test("str of an integer wider than 64 bits renders at that width rather than a clamped one")
a_wide_integer_renders_at_its_own_width()
    if no_str_library() then return

    assert_eq(str_lowered(
                  "sw(n: i128) -> string = str(n)\n" +
                  "main() = prints(sw(1))\n",
              "sw"),
              "define { ptr, ptr, i64 } @sw(i128 %n.param) {\n" +
              "entry:\n" +
              "  %n.addr = alloca i128\n" +
              "  store i128 %n.param, ptr %n.addr\n" +
              "  %t1 = load i128, ptr %n.addr\n" +
              "  %t2 = call { ptr, ptr, i64 } @sysl.str.int128(i128 %t1, i1 1)\n" +
              "  %t3 = extractvalue { ptr, ptr, i64 } %t2, 0\n" +
              "  call void @arc.retain_maybe(ptr %t3)\n" +
              "  %t4 = extractvalue { ptr, ptr, i64 } %t2, 0\n" +
              "  call void @arc.release_maybe(ptr %t4)\n" +
              "  ret { ptr, ptr, i64 } %t2\n" +
              "}\n")
end a_wide_integer_renders_at_its_own_width

@test("str of a bool selects between two constants and allocates nothing")
a_bool_renders_to_one_of_two_immortal_words()
    if no_str_library() then return

    assert_eq(str_lowered(
                  "sb(b: bool) -> string = str(b)\n" +
                  "main() = prints(sb(true))\n",
              "sb"),
              "define { ptr, ptr, i64 } @sb(i1 %b.param) {\n" +
              "entry:\n" +
              "  %b.addr = alloca i1\n" +
              "  store i1 %b.param, ptr %b.addr\n" +
              "  %t1 = load i1, ptr %b.addr\n" +
              "  %t2 = select i1 %t1, ptr @.true, ptr @.false\n" +
              "  %t3 = select i1 %t1, i64 4, i64 5\n" +
              "  %t4 = insertvalue { ptr, ptr, i64 } undef, ptr null, 0\n" +
              "  %t5 = insertvalue { ptr, ptr, i64 } %t4, ptr %t2, 1\n" +
              "  %t6 = insertvalue { ptr, ptr, i64 } %t5, i64 %t3, 2\n" +
              "  %t7 = extractvalue { ptr, ptr, i64 } %t6, 0\n" +
              "  call void @arc.retain_maybe(ptr %t7)\n" +
              "  %t8 = extractvalue { ptr, ptr, i64 } %t6, 0\n" +
              "  call void @arc.release_maybe(ptr %t8)\n" +
              "  ret { ptr, ptr, i64 } %t6\n" +
              "}\n")
end a_bool_renders_to_one_of_two_immortal_words

@test("str of a char lays the codepoint down and copies the bytes out")
a_char_renders_as_its_utf8_bytes()
    if no_str_library() then return

    assert_eq(str_lowered(
                  "sc(c: char) -> string = str(c)\n" +
                  "main() = prints(sc('a'))\n",
              "sc"),
              "define { ptr, ptr, i64 } @sc(i32 %c.param) {\n" +
              "entry:\n" +
              "  %c.addr = alloca i32\n" +
              "  store i32 %c.param, ptr %c.addr\n" +
              "  %t1 = load i32, ptr %c.addr\n" +
              "  %t2 = call { ptr, ptr, i64 } @sysl.str.char(i32 %t1)\n" +
              "  %t3 = extractvalue { ptr, ptr, i64 } %t2, 0\n" +
              "  call void @arc.retain_maybe(ptr %t3)\n" +
              "  %t4 = extractvalue { ptr, ptr, i64 } %t2, 0\n" +
              "  call void @arc.release_maybe(ptr %t4)\n" +
              "  ret { ptr, ptr, i64 } %t2\n" +
              "}\n")
end a_char_renders_as_its_utf8_bytes

@test("str of a float goes out through snprintf, which is what print uses too")
a_float_renders_through_c()
    if no_str_library() then return

    assert_eq(str_lowered(
                  "sf(f: f64) -> string = str(f)\n" +
                  "main() = prints(sf(1.5))\n",
              "sf"),
              "define { ptr, ptr, i64 } @sf(double %f.param) {\n" +
              "entry:\n" +
              "  %f.addr = alloca double\n" +
              "  store double %f.param, ptr %f.addr\n" +
              "  %t1 = load double, ptr %f.addr\n" +
              "  %t2 = call { ptr, ptr, i64 } @sysl.str.float(double %t1)\n" +
              "  %t3 = extractvalue { ptr, ptr, i64 } %t2, 0\n" +
              "  call void @arc.retain_maybe(ptr %t3)\n" +
              "  %t4 = extractvalue { ptr, ptr, i64 } %t2, 0\n" +
              "  call void @arc.release_maybe(ptr %t4)\n" +
              "  ret { ptr, ptr, i64 } %t2\n" +
              "}\n")
end a_float_renders_through_c

@test("format with an unsigned conversion widens as unsigned and prints through a %ll form")
an_unsigned_specifier_reads_the_value_at_its_own_width()
    if no_str_library() then return

    assert_eq(str_lowered(
                  "fx(n: u32) -> string = format(n, \"%x\")\n" +
                  "main() = prints(fx(1))\n",
              "fx"),
              "define { ptr, ptr, i64 } @fx(i32 %n.param) {\n" +
              "entry:\n" +
              "  %n.addr = alloca i32\n" +
              "  store i32 %n.param, ptr %n.addr\n" +
              "  %t2 = load i32, ptr %n.addr\n" +
              "  %t3 = zext i32 %t2 to i64\n" +
              "  %t1 = call { ptr, ptr, i64 } @sysl.str.fmt_i(ptr @.str1, i64 %t3)\n" +
              "  %t4 = extractvalue { ptr, ptr, i64 } %t1, 0\n" +
              "  call void @arc.retain_maybe(ptr %t4)\n" +
              "  %t5 = extractvalue { ptr, ptr, i64 } %t1, 0\n" +
              "  call void @arc.release_maybe(ptr %t5)\n" +
              "  ret { ptr, ptr, i64 } %t1\n" +
              "}\n")
end an_unsigned_specifier_reads_the_value_at_its_own_width

@test("format of a string hands C a terminated copy so width and justification are C's")
a_string_specifier_goes_through_a_nul_terminated_copy()
    if no_str_library() then return

    assert_eq(str_lowered(
                  "fs(s: string) -> string = format(s, \"%-10s\")\n" +
                  "main() = prints(fs(\"a\"))\n",
              "fs"),
              "define { ptr, ptr, i64 } @fs({ ptr, ptr, i64 } %s.param) {\n" +
              "entry:\n" +
              "  %s.addr = alloca { ptr, ptr, i64 }\n" +
              "  store { ptr, ptr, i64 } %s.param, ptr %s.addr\n" +
              "  %t1 = extractvalue { ptr, ptr, i64 } %s.param, 0\n" +
              "  call void @arc.retain_maybe(ptr %t1)\n" +
              "  %t3 = load { ptr, ptr, i64 }, ptr %s.addr\n" +
              "  %t4 = extractvalue { ptr, ptr, i64 } %t3, 1\n" +
              "  %t5 = extractvalue { ptr, ptr, i64 } %t3, 2\n" +
              "  %t2 = call { ptr, ptr, i64 } @sysl.str.fmt_s(ptr @.str1, ptr %t4, i64 %t5)\n" +
              "  %t6 = extractvalue { ptr, ptr, i64 } %t2, 0\n" +
              "  call void @arc.retain_maybe(ptr %t6)\n" +
              "  %t7 = extractvalue { ptr, ptr, i64 } %t2, 0\n" +
              "  call void @arc.release_maybe(ptr %t7)\n" +
              "  %t8 = load { ptr, ptr, i64 }, ptr %s.addr\n" +
              "  %t9 = extractvalue { ptr, ptr, i64 } %t8, 0\n" +
              "  call void @arc.release_maybe(ptr %t9)\n" +
              "  ret { ptr, ptr, i64 } %t2\n" +
              "}\n")
end a_string_specifier_goes_through_a_nul_terminated_copy

@test("format of a float widens to double and hands the specifier straight over")
a_float_specifier_passes_a_double()
    if no_str_library() then return

    assert_eq(str_lowered(
                  "ff(f: f32) -> string = format(f, \"%.2f\")\n" +
                  "main() = prints(ff(1.0))\n",
              "ff"),
              "define { ptr, ptr, i64 } @ff(float %f.param) {\n" +
              "entry:\n" +
              "  %f.addr = alloca float\n" +
              "  store float %f.param, ptr %f.addr\n" +
              "  %t2 = load float, ptr %f.addr\n" +
              "  %t3 = fpext float %t2 to double\n" +
              "  %t1 = call { ptr, ptr, i64 } @sysl.str.fmt_f(ptr @.str1, double %t3)\n" +
              "  %t4 = extractvalue { ptr, ptr, i64 } %t1, 0\n" +
              "  call void @arc.retain_maybe(ptr %t4)\n" +
              "  %t5 = extractvalue { ptr, ptr, i64 } %t1, 0\n" +
              "  call void @arc.release_maybe(ptr %t5)\n" +
              "  ret { ptr, ptr, i64 } %t1\n" +
              "}\n")
end a_float_specifier_passes_a_double

@test("a []u8 read as a string copies the bytes, since a string that could change was never validated")
bytes_taken_as_a_string_are_copied()
    if no_str_library() then return

    assert_eq(str_lowered(
                  "from_utf8_unchecked(b: []const u8) -> string = str_cast(b)\n" +
                  "main() = prints(from_utf8_unchecked(\"a\".bytes))\n",
              "from_utf8_unchecked"),
              "define { ptr, ptr, i64 } @from_utf8_unchecked({ ptr, ptr, i64 } %b.param) {\n" +
              "entry:\n" +
              "  %b.addr = alloca { ptr, ptr, i64 }\n" +
              "  store { ptr, ptr, i64 } %b.param, ptr %b.addr\n" +
              "  %t1 = extractvalue { ptr, ptr, i64 } %b.param, 0\n" +
              "  call void @arc.retain_maybe(ptr %t1)\n" +
              "  %t2 = load { ptr, ptr, i64 }, ptr %b.addr\n" +
              "  %t3 = extractvalue { ptr, ptr, i64 } %t2, 1\n" +
              "  %t4 = extractvalue { ptr, ptr, i64 } %t2, 2\n" +
              "  %t5 = call { ptr, ptr, i64 } @sysl.str.from_bytes(ptr %t3, i64 %t4)\n" +
              "  %t6 = extractvalue { ptr, ptr, i64 } %t5, 0\n" +
              "  call void @arc.retain_maybe(ptr %t6)\n" +
              "  %t7 = extractvalue { ptr, ptr, i64 } %t5, 0\n" +
              "  call void @arc.release_maybe(ptr %t7)\n" +
              "  %t8 = load { ptr, ptr, i64 }, ptr %b.addr\n" +
              "  %t9 = extractvalue { ptr, ptr, i64 } %t8, 0\n" +
              "  call void @arc.release_maybe(ptr %t9)\n" +
              "  ret { ptr, ptr, i64 } %t5\n" +
              "}\n")
end bytes_taken_as_a_string_are_copied

@test("a substring is bounds-checked and then checked to start and end between characters")
a_substring_checks_both_ends_fall_between_characters()
    if no_str_library() then return

    assert_eq(str_lowered(
                  "sub(s: string) -> string = s[1..<3]\n" +
                  "main() = prints(sub(\"abcd\"))\n",
              "sub"),
              "define { ptr, ptr, i64 } @sub({ ptr, ptr, i64 } %s.param) {\n" +
              "entry:\n" +
              "  %s.addr = alloca { ptr, ptr, i64 }\n" +
              "  store { ptr, ptr, i64 } %s.param, ptr %s.addr\n" +
              "  %t1 = extractvalue { ptr, ptr, i64 } %s.param, 0\n" +
              "  call void @arc.retain_maybe(ptr %t1)\n" +
              "  %t2 = load { ptr, ptr, i64 }, ptr %s.addr\n" +
              "  %t3 = extractvalue { ptr, ptr, i64 } %t2, 0\n" +
              "  %t4 = extractvalue { ptr, ptr, i64 } %t2, 1\n" +
              "  %t5 = extractvalue { ptr, ptr, i64 } %t2, 2\n" +
              "  %t6 = icmp ule i64 3, %t5\n" +
              "  br i1 %t6, label %bounds.ok1, label %bounds.bad2\n" +
              "bounds.bad2:\n" +
              "  call void @llvm.trap()\n" +
              "  unreachable\n" +
              "bounds.ok1:\n" +
              "  %t7 = icmp ule i64 1, 3\n" +
              "  br i1 %t7, label %bounds.ok3, label %bounds.bad4\n" +
              "bounds.bad4:\n" +
              "  call void @llvm.trap()\n" +
              "  unreachable\n" +
              "bounds.ok3:\n" +
              "  %t8 = call i1 @sysl.str.boundary(ptr %t4, i64 %t5, i64 1)\n" +
              "  br i1 %t8, label %boundary.ok5, label %boundary.bad6\n" +
              "boundary.bad6:\n" +
              "  call void @llvm.trap()\n" +
              "  unreachable\n" +
              "boundary.ok5:\n" +
              "  %t9 = call i1 @sysl.str.boundary(ptr %t4, i64 %t5, i64 3)\n" +
              "  br i1 %t9, label %boundary.ok7, label %boundary.bad8\n" +
              "boundary.bad8:\n" +
              "  call void @llvm.trap()\n" +
              "  unreachable\n" +
              "boundary.ok7:\n" +
              "  %t10 = getelementptr i8, ptr %t4, i64 1\n" +
              "  %t11 = sub i64 3, 1\n" +
              "  call void @arc.retain_maybe(ptr %t3)\n" +
              "  %t12 = insertvalue { ptr, ptr, i64 } zeroinitializer, ptr %t3, 0\n" +
              "  %t13 = insertvalue { ptr, ptr, i64 } %t12, ptr %t10, 1\n" +
              "  %t14 = insertvalue { ptr, ptr, i64 } %t13, i64 %t11, 2\n" +
              "  %t15 = extractvalue { ptr, ptr, i64 } %t14, 0\n" +
              "  call void @arc.retain_maybe(ptr %t15)\n" +
              "  %t16 = extractvalue { ptr, ptr, i64 } %t14, 0\n" +
              "  call void @arc.release_maybe(ptr %t16)\n" +
              "  %t17 = load { ptr, ptr, i64 }, ptr %s.addr\n" +
              "  %t18 = extractvalue { ptr, ptr, i64 } %t17, 0\n" +
              "  call void @arc.release_maybe(ptr %t18)\n" +
              "  ret { ptr, ptr, i64 } %t14\n" +
              "}\n")
end a_substring_checks_both_ends_fall_between_characters

@test("reading a string's bytes is nothing at all: the guarantee given up is the analyzer's business")
