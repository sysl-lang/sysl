// A stored closure that writes a capture and reads it back: an escaping counter, by value today and
// by value after. Must keep working.
static var later: &Fn() -> int = () -> 0

install(f: &Fn() -> int)
    later = f

run()
    var n = 10

    install(() ->
        n += 1
        n)

run()
print(later(), later())
