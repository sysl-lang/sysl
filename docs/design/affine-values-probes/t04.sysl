// Today: Drop types spelled without '&' are already built as '&T' silently -- so "a struct with
// Drop that is not boxed" cannot be the opt-in without changing what this program means.
struct Guard
    n: int

impl Drop for Guard
    drop(self) = print("unlock", self.n)

main()
    val g = Guard(1)
    val h = g
    print(h.n)
    print("end")
