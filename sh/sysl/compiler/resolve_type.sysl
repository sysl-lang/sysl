module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.math.bigint.{BigInt, from_int, to_string}
import sysl.math.decimal.{Decimal, of as decimal_of, parse as decimal_parse}
import sysl.text.Search

// A written type, resolved to the type it means.
//
// **This is where a name stops being a name.** `TypeRef` is what the source wrote and `Type` is what
// it means, and everything between the two is here: which declaration a name reaches, whether the
// reader is allowed to reach it, how many arguments it takes, and what its fields turn out to be
// once those arguments are filled in.
//
// **A named type is registered before its fields are resolved**, which is the whole of how a
// declaration that mentions itself terminates: `struct Node { next: *Node }` asks for `Node` while
// `Node` is still being built, and finds the record that is already there.

// What a type parameter stands for while a declaration is being resolved.
struct Binding
    name: string
    ty: Type
end Binding

// The bindings of no parameters at all.
no_bindings() -> Buf[Binding] = buf()

// What a name stands for in a set of bindings.
bound_type(subst: Buf[Binding], name: string) -> Option[Type]
    for i in 0..<subst.len()
        if subst.at(i).name == name then return Some(subst.at(i).ty)

    None
end bound_type

// One name in a substitution given a different type, since a substitution answers with the first
// binding of a name and a second appended after it would never be read.
rebind(subst: *Buf[Binding], name: string, ty: Type)
    for i in 0..<subst.len()
        if subst.at(i).name == name
            subst.set(i, Binding(name, ty))
            return

    subst.push(Binding(name, ty))

// The type a written one means.
resolve_type(a: &Analysis, scope: Scope, t: TypeRef, subst: Buf[Binding]) -> Type = *t.kind match
    NamedType(name, args) -> resolve_named(a, scope, t.span, name, args, subst)
    // **A hop is what makes a cycle finite**, so the four forms that point rather than hold are
    // counted -- and the count is what a type reached again is judged against.
    PtrType(inner) -> resolve_ptr(a, scope, inner, subst)
    RefType(inner, sync) -> resolve_ref(a, scope, t.span, inner, sync, subst)
    WeakType(inner) -> Weak(under_indirection(a, () -> resolve_pointee(a, scope, inner, subst, false)))
    // Everywhere but a field, an element and a pointee, what is being named is a **value** -- what a
    // binding holds, what a parameter receives, what a call hands back -- and a value read out of a
    // volatile place is an ordinary value, so there is nothing left for the qualifier to say.
    VolatileType(inner) ->
        val written = type_text(inner)

        a.fault(scope, t.span, s"'volatile $written' is the type of *storage*, and this is a value — " +
                s"what a read of a volatile place hands back is an ordinary '$written'. The qualifier " +
                "goes where the storage is named: a struct field, an element, or the pointee of a " +
                s"'*T', as '*volatile $written'")
        Unknown
    ArrayType(length, elem, read_only) ->
        resolve_array(a, scope, t.span, length, elem, read_only, subst)
    VectorType(lanes, elem) -> Vector(int(const_extent(a, scope, t.span, lanes, subst)),
                                      resolve_qualified(a, scope, elem, subst))
    TupleType(parts, results) -> resolve_tuple(a, scope, parts, results, subst)
    PackType(name) -> bound_type(subst, name).unwrap_or(Pack(buf()))
    CFnType(params, ret) ->
        CFn(resolve_list(a, scope, params, subst), resolve_type(a, scope, ret, subst))
    FnType(params, ret, bare) -> resolve_unboxed_callable(a, scope, t, params, ret, bare, subst)
    SomeType(_) -> Unknown
    // `T::Item` -- the associated type, which the member tables are what answer. It resolves like
    // anything else the moment the subject is known: the subject is resolved first, and a parameter
    // standing in for itself answers off the bounds it carries.
    AssocType(base, member) ->
        assoc_type(a, scope, t.span, resolve_type(a, scope, base, subst), member)
    AssocArgType(_, inner) -> resolve_type(a, scope, inner, subst)
    ValueArgType(e) -> const_argument(a, scope, t.span, e, subst)

// A type in one of the three positions a `volatile` may stand -- the pointee of a `*T`, an element,
// a struct field. What they share is that the storage named is **somebody else's**: a device's
// registers, reached through an address the program was handed.
resolve_qualified(a: &Analysis, scope: Scope, t: TypeRef, subst: Buf[Binding]) -> Type = *t.kind match
    VolatileType(inner) ->
        val ty = resolve_type(a, scope, inner, subst)

        if volatile_admits(a, scope, t.span, ty) then Volatile(ty) else Unknown
    _ -> resolve_type(a, scope, t, subst)

// Whether a `volatile` may qualify this type. The qualifier promises exactly the one load or the one
// store the source wrote, so it means something only where an access is one instruction; a register
// block is qualified one field at a time, and anything counted is refused outright.
private volatile_admits(a: &Analysis, scope: Scope, span: Span, t: Type) -> bool
    val shown = type_show(t)
    val head = s"'volatile $shown' is not a type: "

    // A constrained subtype is the claim that a value has been checked, and a register holds
    // whatever the device put there.
    if volatile_constrains(t)
        a.fault(scope, span, head + s"a register holds whatever the device put in it, and $shown " +
                "is the claim that a value has been checked. Declare the register at " +
                s"${type_show(underlying(t))} and convert what you read")
        return false
    end if

    val why = underlying(t) match
        Unknown -> return false
        Integer(_, _, _) -> return true
        Floating(_, _) -> return true
        Char -> return true
        Bool -> return true
        Enum(d) ->
            if d.simple then return true

            s"'$shown' carries a payload beside its tag, so touching one is more than the single " +
            "access the qualifier promises. A register field that is a set of named values is a " +
            "simple enum, which is one integer"
        _ ->
            if erased(t)
                "an object over a trait is a pair of words, so touching one is two accesses whatever " +
                "the source says — and the table beside the value is this program's, not a device's"
            else volatile_refusal(underlying(t), shown)

    if why.is_empty() then return true

    a.fault(scope, span, head + why)
    false
end volatile_admits

// The rest of the refusals, by shape; empty where the shape is admitted.
private volatile_refusal(t: Type, shown: string) -> string = t match
    Ptr(_) -> ""
    CFn(_, _) -> ""
    Ref(_, _) -> volatile_counted()
    Weak(_) -> volatile_counted()
    Slice(_, _) -> volatile_counted()
    Str -> volatile_counted()
    Struct(_) ->
        s"a register block is qualified one field at a time, so write 'volatile' on the fields of " +
        s"'$shown' that are registers — which is also what lets a shadow field in the middle of one " +
        "stay ordinary"
    _ -> "'volatile' qualifies a scalar or a raw pointer, since it promises the one load or the " +
         "one store the source wrote and nothing else"

private volatile_counted() -> string =
    "the qualifier says every access is emitted exactly as written, and a counted value's accesses " +
    "come with retains and releases that no rule here could hold still — device memory is reached " +
    "with a raw pointer"

// Whether a type constrains which VALUES it has, as against merely having an identity of its own: a
// bare `new` derivation asserts nothing about a value.
private volatile_constrains(t: Type) -> bool = t match
    Constrained(d) -> d.lo.is_some() || d.hi.is_some() || d.pred_fn.is_some() || volatile_constrains(d.base)
    _ -> false

// `&T` — and where `T` is a trait, the one place a trait object is formed, so the one place its
// formability is asked about.
//
// **An atomic reference promises that a second domain may hold the object**, which is a promise
// about everything the object holds (`reference/memory.md § Crossing a concurrency domain`). A trait
// object is the one pointee whose contents are not known here -- the type it forgot is settled
// where a value is erased into one, and that is where it is asked.
private resolve_ref(a: &Analysis, scope: Scope, span: Span, inner: TypeRef, sync: bool,
                    subst: Buf[Binding]) -> Type
    val ty = under_indirection(a, () -> resolve_pointee(a, scope, inner, subst, false))

    check_object_written(a, scope, inner, ty, "&", subst)

    if sync
        ty match
            Trait(_, _, _) -> ()
            _ -> check_shared(a, scope, span, ty)
    end if

    Ref(ty, sync)
end resolve_ref

// `*T` — and where `T` is a trait, a raw object, asked about as the counted one is.
private resolve_ptr(a: &Analysis, scope: Scope, inner: TypeRef, subst: Buf[Binding]) -> Type
    val ty = under_indirection(a, () -> resolve_pointee(a, scope, inner, subst, true))

    check_object_written(a, scope, inner, ty, "*", subst)
    Ptr(ty)
end resolve_ptr

// Every type of a list, in order.
resolve_list(a: &Analysis, scope: Scope, ts: Buf[TypeRef], subst: Buf[Binding]) -> Buf[Type]
    var out: Buf[Type] = buf()

    for i in 0..<ts.len()
        out.push(resolve_type(a, scope, ts.at(i), subst))

    out
end resolve_list

private resolve_array(a: &Analysis, scope: Scope, span: Span, length: Option[Expr], elem: TypeRef,
                      read_only: bool, subst: Buf[Binding]) -> Type
    // A fixed array HOLDS its elements and a slice POINTS at them, which is the whole of why one is
    // an indirection and the other is not.
    if length.is_none() then
        return Slice(under_indirection(a, () -> resolve_qualified(a, scope, elem, subst)), read_only)

    val e = resolve_qualified(a, scope, elem, subst)
    val written = length.unwrap()

    // A length over a type parameter has no value during the walk that checks the generic body
    // itself, there being no `T` yet — and that is not a mistake to report, since the body is
    // analyzed again for each instantiation with the parameter bound. The array stands at length
    // zero for that one walk. Anything else that will not fold is a length settled while the
    // program runs, which an array's cannot be.
    //
    // **A length whose fold REFUSED is not that mistake** -- a division by zero is a constant
    // expression that has no value, and it was told where the division is. The fold is made once
    // more keeping what it says, since the one above put its complaints back, and the array has no
    // type to be rather than a length nobody wrote.
    val refusals = a.const_refusals

    if !folds_to_extent(a, scope, span, written, subst)
        if const_refused_since(a, refusals)
            val inner = analyzer_for(a, scope)

            inner.subst = subst
            const_int(inner, written)
            return Unknown
        end if

        if !awaits_instantiation(a, scope, written, subst) then
            a.fault(scope, span, "an array length must be a constant — a literal, or a 'const' naming one")
    end if

    Array(int(const_extent(a, scope, span, written, subst)), e)
end resolve_array

// Whether this length reads as a constant at all, asked without leaving a complaint behind: the walk
// that answers it is the same one `const_extent` makes, and a length that does not fold is either a
// parameter awaiting its instantiation or the refusal above.
private folds_to_extent(a: &Analysis, scope: Scope, span: Span, e: Expr,
                        subst: Buf[Binding]) -> bool
    *e.kind match
        IntLit(_, _, _) -> return true
        _ -> ()

    val inner = analyzer_for(a, scope)

    inner.subst = subst

    val mark = a.complaints()
    val folded = const_int(inner, e)

    a.restore_complaints(mark)

    folded.is_some()
end folds_to_extent

// Whether a length stands over a type parameter that has not been given a type yet. A value
// parameter is bound to the same `Abstract` stand-in a type parameter gets, so it does not fold and
// is not an error either; a name bound to a value is not here, because that one folds.
private awaits_instantiation(a: &Analysis, scope: Scope, e: Expr, subst: Buf[Binding]) -> bool =
    *e.kind match
        Ident(n) -> bound_type(subst, n) match
            Some(t) -> t match
                Abstract(_, _) -> true
                _ -> false
            None -> false
        LayoutOf(_, tr) -> abstract_operand(a, scope, tr, subst)
        OffsetOf(tr, _) -> abstract_operand(a, scope, tr, subst)
        Unary(_, operand) -> awaits_instantiation(a, scope, operand, subst)
        Binary(_, l, r) ->
            awaits_instantiation(a, scope, l, subst) || awaits_instantiation(a, scope, r, subst)
        Compare(operands, _) ->
            operands.len() == 2 && (awaits_instantiation(a, scope, operands.at(0), subst) ||
                                    awaits_instantiation(a, scope, operands.at(1), subst))
        Call(callee, args) -> *callee.kind match
            Ident(_) ->
                args.len() == 1 && awaits_instantiation(a, scope, args.at(0), subst)
            _ -> false
        _ -> false

// Whether a measurement's subject is a type parameter standing for itself, which is what makes
// `sizeof(T)` a number this walk cannot have.
private abstract_operand(a: &Analysis, scope: Scope, tr: TypeRef, subst: Buf[Binding]) -> bool =
    underlying(resolve_type(a, scope, tr, subst)) match
        Abstract(_, _) -> true
        _ -> false

// A resolution run one hop further out than the one around it.
under_indirection(a: &Analysis, resolve: &Fn() -> Type) -> Type
    a.indirection += 1

    val out = resolve()

    a.indirection -= 1
    out
end under_indirection

// A resolution run inside a type-argument list, which is not on its own an answer to whether a type
// contains itself: whether `Buf[Node]` holds a `Node` depends on how `Buf` uses its parameter, and
// the question is asked again where the substitution is used.
under_type_arg(a: &Analysis, resolve: &Fn() -> Buf[Type]) -> Buf[Type]
    a.type_arg_depth += 1

    val out = resolve()

    a.type_arg_depth -= 1
    out
end under_type_arg

// Whether reaching an in-progress instantiation again is a legal cycle: it is exactly when at least
// one hop was crossed on the way back to it. Both counts are compared against where the type was
// ENTERED rather than against zero -- an argument list entered after it is what excuses a path, and
// never what a type does to itself.
// Answers whether it fired, because a field whose type is the shape being refused may not be
// RECORDED as that shape: the table would then hold a type that genuinely contains itself, and every
// pass that walks a layout would follow it for ever. What the field gets instead is `Unknown`, which
// is what everything downstream already means by "a mistake was reported here".
cycle_check(a: &Analysis, scope: Scope, span: Span, key: string) -> bool
    var found = false

    for i in 0..<a.resolving.len()
        val at = a.resolving.at(i)

        if at.0 == key && a.indirection <= at.1 && a.type_arg_depth <= at.2
            a.fault(scope, span,
                    s"type '${qualified_name(instance_base(key))}' contains itself, so it has no " +
                    "finite size")

            found = true

    found
end cycle_check

// The declared name an instance key was made from, which is what a diagnostic calls the type.
private instance_base(key: string) -> string
    val at = key.index_of("[")

    if at.is_none() then return key

    key[0..<at.unwrap()]
end instance_base

// What a type parameter stands for, asked the containment question the argument position deferred:
// a `T` used **by value** here is the containing type held by value, whatever hop the parameter was
// written behind.
//
// **The question is about what the argument REACHES, not about what it is.** Asking only whether the
// argument is itself in progress answers a mutual cycle wrong, because the other type on the cycle
// has usually finished by the time the generic's field substitutes it.
substituted(a: &Analysis, scope: Scope, span: Span, t: Type) -> Type
    if a.resolving.is_empty() then return t

    var found: Buf[string] = buf()
    var seen: Buf[string] = buf()

    reached_by_value(a, t, &seen, &found)

    var cut = false

    for i in 0..<found.len()
        if cycle_check(a, scope, span, found.at(i)) then cut = true

    if cut then Unknown else t
end substituted

// Every still-resolving type a layout reaches **without crossing a hop**, which is the whole of what
// makes a cycle infinite. A struct's fields, an enum variant's payload, a fixed array's elements and
// a constrained type's base are all held; a pointer, a reference, a weak reference and a slice all
// point, so the walk stops at them.
//
// **Every one of them rather than the first**, because `resolving` records the hop count each type
// was entered at and a walk can reach two entered at different ones.
private reached_by_value(a: &Analysis, t: Type, seen: *Buf[string], found: *Buf[string])
    t match
        Struct(d) ->
            val key = instance_key(d.base, d.targs)

            if is_resolving(a, key)
                if !holds_string(*found, key) then found.push(key)
            else if !holds_string(*seen, key)
                seen.push(key)

                for i in 0..<d.fields.len()
                    reached_by_value(a, d.fields.at(i).1, seen, found)
        Enum(d) ->
            val key = instance_key(d.base, d.targs)

            if is_resolving(a, key)
                if !holds_string(*found, key) then found.push(key)
            else if !holds_string(*seen, key)
                seen.push(key)

                for i in 0..<d.variants.len()
                    val v = d.variants.at(i)

                    for j in 0..<v.fields.len()
                        reached_by_value(a, v.fields.at(j).1, seen, found)
        Array(_, elem) -> reached_by_value(a, *elem, seen, found)
        Constrained(d) -> reached_by_value(a, d.base, seen, found)
        _ -> ()

private is_resolving(a: &Analysis, key: string) -> bool
    for i in 0..<a.resolving.len()
        if a.resolving.at(i).0 == key then return true

    false
end is_resolving

// A tuple is an ordinary struct declared by the compiler, and a result list is that tuple wearing a
// second name -- which is what tells `return a, b` from `return (a, b)`.
private resolve_tuple(a: &Analysis, scope: Scope, parts: Buf[TypeRef], results: bool,
                      subst: Buf[Binding]) -> Type
    // `(..A)` -- the tuple of a pack. The pack is **looked up** rather than resolved, because what
    // stands for it in the substitution is already the list of parts: for the walk that checks a
    // generic body that is the stand-ins, and for an instantiation it is the parts the subject
    // matched. Either way the tuple built here is an ordinary one, so nothing downstream of this
    // point knows a pack was written.
    val packed = sole_pack_parts(subst, parts)

    if packed.is_some()
        val d = registered_tuple(a, packed.unwrap())

        return if results then Results(d) else Struct(d)
    end if

    val ts = resolve_list(a, scope, parts, subst)
    val d = registered_tuple(a, ts)

    if results then Results(d) else Struct(d)
end resolve_tuple

// The parts a one-part tuple reference stands for, where it is written over a pack and that pack is
// bound. A name that stands for anything else is left to the ordinary walk, which reads it as the
// stand-in it is -- a shape mentioning a parameter, and so one nothing lays out.
private sole_pack_parts(subst: Buf[Binding], parts: Buf[TypeRef]) -> Option[Buf[Type]]
    if parts.len() != 1 then return None

    *parts.at(0).kind match
        PackType(n) -> bound_type(subst, n) match
            Some(Pack(elems)) -> Some(elems)
            _ -> None
        _ -> None
end sole_pack_parts

// The struct a tuple of these types is: `$tupleN`, its arguments the parts, its fields numbered.
tuple_type(ts: Buf[Type]) -> &StructType
    var fields: Buf[(string, Type)] = buf()

    for i in 0..<ts.len()
        fields.push((str(i), ts.at(i)))

    StructType(tuple_base(ts.len()), ts, fields, false, None, None, false)
end tuple_type

// The same, recorded -- so that one `(string, string)` is one type wherever it is written, and so
// that a compilation's list of what it laid out holds the tuples as well as the declared records.
//
// **After the parts, like every other record**, since a tuple is a struct the compiler declared and
// what it is made of is laid out before it is.
registered_tuple(a: &Analysis, ts: Buf[Type]) -> &StructType
    val made = tuple_type(ts)
    val key = instance_key(made.base, ts)
    val already = a.tables.struct_insts.get(key)

    if already.is_some()
        already.unwrap() match
            Struct(d) -> return d
            _ -> ()
    end if

    a.tables.struct_insts.put(key, Struct(made))
    made
end registered_tuple

// `int -> unit`, `(int, int) -> int` -- a callable as the arrow spelling writes it, for a message
// about the spelling. The result is last, as it is everywhere a call trait's arguments are held.
private bare_arrow_show(args: Buf[Type]) -> string
    val ret = type_show(args.at(args.len() - 1))

    if args.len() == 2 then return s"${type_show(args.at(0))} -> $ret"

    var out = "("

    for i in 0..<args.len() - 1
        if i > 0 then out = out + ", "

        out = out + type_show(args.at(i))

    s"$out) -> $ret"
end bare_arrow_show

// What stands behind a mode -- `&`, `*` or `weak` -- which is the one place a callable is a type: the
// trait object of the call trait, whichever of the two spellings wrote it.
// `qualified` is a raw pointer's pointee, which is the one of the three that may be `volatile`.
private resolve_pointee(a: &Analysis, scope: Scope, inner: TypeRef, subst: Buf[Binding],
                        qualified: bool) -> Type =
    *inner.kind match
        FnType(params, ret, _) -> resolve_fn_trait(a, scope, inner.span, params, ret, false, subst)
        _ -> if qualified then resolve_qualified(a, scope, inner, subst) else resolve_type(a, scope, inner, subst)

// **A callable is not a type: it is a trait**, and a trait stands where a type does only behind a
// mode. The bare arrow is a parameter's sugar and has a refusal of its own; `Fn(…) -> r` written
// where a concrete type is required names the box it should have been.
private resolve_unboxed_callable(a: &Analysis, scope: Scope, t: TypeRef, params: Buf[TypeRef],
                                 ret: TypeRef, bare: bool, subst: Buf[Binding]) -> Type
    val made = resolve_fn_trait(a, scope, t.span, params, ret, bare, subst)

    if bare || made == Unknown then return made

    val written = type_text(t)

    a.fault(scope, t.span, s"'$written' is a trait, and a trait is a type only behind a mode — " +
            s"write '&$written' for the boxed callable a concrete slot takes")
    Unknown
end resolve_unboxed_callable

// A written `Fn(a, b) -> r` is the callable trait of that arity, its arguments the parameters with
// the result last.
private resolve_fn_trait(a: &Analysis, scope: Scope, span: Span, params: Buf[TypeRef],
                         ret: TypeRef, bare: bool, subst: Buf[Binding]) -> Type
    // **The library declares four of them and no more**, so a wider one names a trait that is not
    // there — which would be reported as a missing name rather than as the limit it is.
    if params.len() > MaxCallableParams
        a.fault(scope, span, s"a callable takes up to $MaxCallableParams parameters and this one " +
                s"takes ${params.len()} — a call this wide reads better with the arguments named, " +
                "so pass a struct of them")
        return Unknown
    end if

    var args = resolve_list(a, scope, params, subst)

    args.push(resolve_type(a, scope, ret, subst))

    // **A bare arrow is a parameter's form and nothing else**, and by the time a type is resolved
    // every parameter that wrote one has been rewritten into the bound it is sugar for — so an arrow
    // arriving here stands somewhere a concrete type is required, where a callable is a box.
    if bare
        val boxed = s"&${type_show(Trait(fn_base(params.len()), args, buf()))}"

        a.fault(scope, span, s"'${bare_arrow_show(args)}' is a callable a function is passed and " +
                "does not keep, which only a parameter may be — anywhere a concrete type is " +
                s"required, a callable is boxed, so write '$boxed'")
        return Unknown
    end if

    // **The trait is FOUND rather than composed.** `Fn0` is `sysl$Fn0`, and a trait written under
    // its bare spelling would answer no to every question asked of the key -- so a closure standing
    // at a `&Fn() -> unit` would not be seen to implement the very trait the type names. The bare
    // name is kept only where the library is not there to be found, which is where nothing can
    // implement it either.
    val key = lookup_trait_key(a, scope, fn_base(params.len()))

    Trait(key.unwrap_or(fn_base(params.len())), args, buf())
end resolve_fn_trait

// How long a written extent is.
//
// **A literal is read here and anything else is folded**, because a length may be any constant
// expression: `[addr_bytes]u8` is an array of a hundred and twenty-eight bytes wherever the `const`
// naming that number can be reached. The fold is the same one an expression performs, run against
// the file the type was written in.
//
// **What does not fold stands at zero rather than being guessed at.** A length written in terms of a
// type parameter has no value during the walk that checks a generic declaration itself -- there is no
// `T` yet -- and every array the program actually gets is built again for each instantiation, where
// the measurement answers.
private const_extent(a: &Analysis, scope: Scope, span: Span, e: Expr,
                     subst: Buf[Binding]) -> usize
    *e.kind match
        IntLit(digits, base, _) -> return digits_value(digits, base)
        _ -> ()

    // Read in the terms the type was written in, and with whatever it says put back: a length that
    // does not fold is a length this walk cannot settle, and the walk that can settles it again.
    val inner = analyzer_for(a, scope)

    inner.subst = subst

    val mark = a.complaints()
    val folded = const_int(inner, e)

    a.restore_complaints(mark)

    if folded.is_none() then return 0

    val n = folded.unwrap().to_long().unwrap_or(-1)

    if n < 0 then return 0

    usize(n)
end const_extent

// A written value argument, as the identity a type carries it in: the number it stands for and the
// kind that says how to read it back.
//
// **A `bool` and a `char` are values a type's identity may hold** as much as an integer is -- each
// compares and each mangles -- so folding one to a number and calling it a length would make
// `Flag[true]` and `Flag[false]` one type. The kind is kept beside the number for the same reason
// the declared type is kept beside a constant: it is the half that makes the number mean something.
private const_argument(a: &Analysis, scope: Scope, span: Span, e: Expr,
                       subst: Buf[Binding]) -> Type
    val inner = analyzer_for(a, scope)

    inner.subst = subst

    val mark = a.complaints()
    val folded = const_fold(inner, e)

    a.restore_complaints(mark)

    folded match
        Some(ConstBool(b)) -> ConstArg(from_int(if b then 1 else 0), Bool)
        Some(ConstChar(c)) -> ConstArg(from_int(long(int(u32(c)))), Char)
        Some(ConstInt(v)) -> ConstArg(v, int_type())
        _ -> ConstArg(from_int(long(const_extent(a, scope, span, e, subst))), int_type())
end const_argument

private digits_value(digits: string, base: int) -> usize
    var n: usize = 0
    val b = digits.bytes

    for i in 0..<b.len
        val c = b[i]
        var d: usize = 16

        if c >= u8('0') && c <= u8('9') then d = usize(c - u8('0'))
        else if c >= u8('a') && c <= u8('f') then d = usize(c - u8('a')) + 10
        else if c >= u8('A') && c <= u8('F') then d = usize(c - u8('A')) + 10

        if d < usize(base) then n = n * usize(base) + d

    n
end digits_value

// Whether a plain decimal digit string parses as a 32-bit signed int the way the reference's own
// `String.toIntOption` would -- the bootstrap tells a width that merely exceeds the back end's
// ceiling from one so large it never became a number at all, and this is that same line.
private fits_i32(digits: string) -> bool
    val max_i32 = "2147483647"
    val b = digits.bytes

    if b.len < max_i32.len then return true
    if b.len > max_i32.len then return false

    val m = max_i32.bytes

    for i in 0..<b.len
        if b[i] < m[i] then return true
        if b[i] > m[i] then return false

    true
end fits_i32

// -- a name -------------------------------------------------------------------------------------

private resolve_named(a: &Analysis, scope: Scope, span: Span, name: string, args: Buf[TypeRef],
                      subst: Buf[Binding]) -> Type
    val targs = under_type_arg(a, () -> resolve_list(a, scope, args, subst))

    if args.is_empty() then
        val stood_for = bound_type(subst, name)

        // A parameter used here stands where the declaration wrote it, and what it stands for is
        // held exactly as the parameter is -- so this is where the argument position's deferral is
        // paid for.
        if stood_for.is_some() then return substituted(a, scope, span, stood_for.unwrap())

    if name == "never" then return Never
    // `Self` is bound by a trait or an `impl`; anywhere else it names nothing, and says why.
    if name == "Self"
        val bound = bound_type(subst, "Self")

        if bound.is_some() then return bound.unwrap()

        a.fault(scope, span, "'Self' names the type a trait is implemented for, so it is only " +
                "meaningful inside a 'trait' or an 'impl'")
        return Unknown
    end if

    val scalar = scalar_named(name, int(a.tables.target.pointer_bits()))

    if scalar.is_some() then return plain_type(a, scope, span, name, targs, scalar.unwrap())

    val width = width_type(a, scope, span, name)

    if width.is_some() then return plain_type(a, scope, span, name, targs, width.unwrap())

    val key = lookup_type_key(a, scope, name)

    if key.is_none() then
        val rivals = offered_by(a, scope, name, k -> a.tables.types.has(k))

        if rivals.len() > 1 then a.fault(scope, span, ambiguous_offer(name, rivals))
        else a.fault(scope, span, s"unknown type '$name'")

        return Unknown

    // **An argument that binds an associated type by name is not a type argument**, so it is taken
    // out before the arity is counted: `Keyed[int, Item = int]` applies one argument and binds one
    // associated type, and counting two would report a trait with one parameter as given two.
    val d = trait_decl_at(a, key.unwrap())

    if d.is_some()
        var positional: Buf[TypeRef] = buf()
        var named: Buf[(string, Type)] = buf()

        for i in 0..<args.len()
            *args.at(i).kind match
                AssocArgType(bound, inner) ->
                    named.push((bound, resolve_type(a, scope, inner, subst)))
                _ -> positional.push(args.at(i))

        return instantiate_trait(a, scope, span, name, key.unwrap(), d.unwrap(),
                                 resolve_list(a, scope, positional, subst), named)
    end if

    instantiate(a, scope, span, name, key.unwrap(),
                at_declared_widths(a, key.unwrap(), targs))
end resolve_named

// A written argument list, read **against the declaration whose parameters it fills** — which
// argument is a value is the declaration's fact and nothing the grammar can see, `Buf[4]` and
// `Buf[int]` being the same shape to a parser. So a value argument carries the type the declaration
// wrote for its parameter rather than the one a literal falls to on its own, and a member reading
// the parameter reads an ordinary value of that type.
private at_declared_widths(a: &Analysis, key: string, targs: Buf[Type]) -> Buf[Type]
    val pair = declared_values(a, key)

    if pair.1.is_empty() then return targs

    var out: Buf[Type] = buf()
    val home = a.tables.types.get(key).unwrap().scope

    for i in 0..<targs.len()
        val written = if i < pair.0.len() then binding_named(pair.1, pair.0.at(i)) else None

        targs.at(i) match
            ConstArg(v, ty) ->
                if written.is_none() then out.push(ConstArg(v, *ty))
                else out.push(ConstArg(v, resolve_type(a, home, written.unwrap(), no_bindings())))
            other -> out.push(other)

    out
end at_declared_widths

// A nominal declaration's type parameters and the ones of them it wrote a `const` type for.
private declared_values(a: &Analysis, key: string) -> (Buf[string], Buf[TypeBinding]) =
    a.tables.types.get(key) match
        None -> (buf(), buf())
        Some(d) -> d.kind match
            StructOf(sd) -> (sd.tparams, sd.tvalues)
            EnumOf(ed) -> (ed.tparams, ed.tvalues)
            _ -> (buf(), buf())

// A type that takes no arguments, told so where any were written.
private plain_type(a: &Analysis, scope: Scope, span: Span, name: string, targs: Buf[Type],
                   ty: Type) -> Type
    if !targs.is_empty() then a.fault(scope, span, s"type '$name' does not take type arguments")

    ty
end plain_type

// The width family: a letter and digits, and nothing else.
//
// **Once the shape matches, the name belongs to the family and a bad width is a diagnostic** --
// never a fall-through to "unknown type", which would send a reader looking for a missing
// declaration when what is wrong is the number they wrote.
width_type(a: &Analysis, scope: Scope, span: Span, name: string) -> Option[Type]
    val b = name.bytes

    if b.len < 2 then return None
    if b[0] != u8('i') && b[0] != u8('u') && b[0] != u8('f') then return None

    for i in 1..<b.len
        if b[i] < u8('0') || b[i] > u8('9') then return None

    val head = name[0..<1]
    val digits = name[1..<b.len]

    if b[1] == u8('0') then
        if all_zero(digits) then
            a.fault(scope, span, s"'$name' has no bits — the width families start at 1, and a " +
                    s"single bit is '${head}1'")
        else
            a.fault(scope, span, s"'$name' has a leading zero — a width is written plainly, as " +
                    s"'$head${without_leading_zeros(digits)}'")

        return Some(Unknown)

    if !fits_i32(digits) then
        a.fault(scope, span, s"'$name' is far wider than anything can hold")
        return Some(Unknown)

    val bits = int(digits_value(digits, 10))

    if b[0] == u8('f') then
        if bits == 16 || bits == 32 || bits == 64 then return Some(Floating(bits, false))

        // `bf16` is named rather than measured -- it is `f16`'s width and not its format -- so it is
        // not a width this shape could have produced, and the message names it where a reader
        // reaching for a sixteen-bit float would look.
        if bits == 128 then a.fault(scope, span, "'f128' is not lowered yet — the widest float is 'f64'")
        else a.fault(scope, span, s"'$name' is not an IEEE floating-point width; they are f16, f32, " +
                     "and f64, and the other sixteen-bit format is 'bf16'")

        return Some(Unknown)

    if bits >= 1 && bits <= MaxIntegerBits then return Some(Integer(bits, b[0] == u8('i'), false))

    a.fault(scope, span, s"'$name' is wider than the $MaxIntegerBits bits the back end lowers")
    Some(Unknown)
end width_type

private all_zero(digits: string) -> bool
    val b = digits.bytes

    for i in 0..<b.len
        if b[i] != u8('0') then return false

    true
end all_zero

private without_leading_zeros(digits: string) -> string
    val b = digits.bytes
    var i: usize = 0

    while i < b.len - 1 && b[i] == u8('0')
        i += 1

    digits[i..<b.len]
end without_leading_zeros

// Which declaration a written name reaches, in the terms of the file that wrote it.
//
// **The order is the reader's**: what they wrote themselves, what they imported by name, what their
// own module declares, and only then what a wildcard brought in.
lookup_type_key(a: &Analysis, scope: Scope, name: string) -> Option[string]
    val found = type_key_of(a, scope, name)

    // **Resolution is where a dependency between two modules is MADE**, so it is where one is
    // recorded: nothing earlier could see it, since which module an unqualified name reaches is the
    // whole question this answered.
    if found.is_some() then depends_on(a, scope, found.unwrap(), span_zero())

    found
end lookup_type_key

private type_key_of(a: &Analysis, scope: Scope, name: string) -> Option[string]
    val dotted = last_dot(name)

    if dotted.is_some() then return lookup_qualified(a, scope, name, dotted.unwrap())

    // This file's own file-private declaration of the spelling comes before the module's plain key,
    // where a sibling file took that one first.
    val here = file_private_key(a, scope.src.name, module_qualify(scope.module_name, name))

    if a.tables.types.has(here) && reachable_key(a, here, scope) then return Some(here)

    // **The reader's own module beats an import of the same name**, and a name imported by name beats
    // one a wildcard merely offers.
    // Each is asked of the innermost level of imports that answers, a block's before the file's.
    val im = answering_imports(a, scope, name, k -> a.tables.types.has(k))
    val bound = im.name_key(name)

    if bound.is_some() && a.tables.types.has(bound.unwrap()) then return bound

    // Two wildcards offering the spelling make it ambiguous rather than the first one's; the use
    // reports which.
    if offered_by(a, scope, name, k -> a.tables.types.has(k)).len() > 1 then return None

    var found: Option[string] = None

    // **The library is the one wildcard whose restriction is reported**, being reached without an
    // import and searched after everything else. A type it keeps is out of reach the way a function
    // it keeps is, and the refusal says which -- where every other wildcard offers only what the
    // reader may name, so a type it keeps is simply not there.
    var kept: Option[string] = None

    for i in 0..<im.wildcards.len()
        val at = im.wildcards.at(i)
        val key = module_qualify(at, name)

        if a.tables.types.has(key)
            if found.is_none() && reachable_key(a, key, scope) then found = Some(key)

            if at == AutoImportedModule && kept.is_none() && !reachable_key(a, key, scope) then
                kept = Some(key)

    if found.is_none() && a.tables.types.has(here) then return Some(here)

    if found.is_none() then return kept

    found
end type_key_of

// A name written with a dot in it: either a module path and a name, or a bound module alias and a
// name.
private lookup_qualified(a: &Analysis, scope: Scope, name: string, cut: usize) -> Option[string]
    val head = name[0..<cut]
    val last = name[cut + 1..<name.bytes.len]
    val aliased = scope.imports.module_as(head)

    if aliased.is_some() then
        val key = module_qualify(aliased.unwrap(), last)

        if a.tables.types.has(key) then return Some(key)

    // The head is a module path, so it is read through the package layer: a file of a fetched
    // package writing its own tree's name means that tree, and a consumer writing the name its
    // manifest bound means the package it bound.
    val key = module_qualify(in_package(a, scope.pkg, head), last)

    if a.tables.types.has(key) then Some(key) else None
end lookup_qualified

private last_dot(name: string) -> Option[usize]
    val b = name.bytes
    var found: Option[usize] = None

    for i in 0..<b.len
        if b[i] == u8('.') then found = Some(i)

    found
end last_dot

// Whether a key is one the reader's file may name.
reachable_key(a: &Analysis, key: string, from: Scope) -> bool = access_for(a, key) match
    Some(acc) -> reachable(acc, from)
    None -> true

// -- filling in a declaration ---------------------------------------------------------------------

// The type a declaration at these arguments is.
instantiate(a: &Analysis, scope: Scope, span: Span, written: string, key: string,
            targs: Buf[Type]) -> Type
    if !reachable_key(a, key, scope) then
        a.fault(scope, span, out_of_reach(a, key))
        return Unknown

    val decl = a.tables.types.get(key).unwrap()

    decl.kind match
        StructOf(d) -> instantiate_struct(a, scope, span, written, key, d, decl.scope, targs)
        EnumOf(d) -> instantiate_enum(a, scope, span, written, key, d, decl.scope, targs)
        TraitOf(d) -> instantiate_trait(a, scope, span, written, key, d, targs, buf())
        TypeOf(d) -> instantiate_named_subtype(a, scope, span, written, key, d, decl.scope, targs)
        CTypeOf(_) -> opaque_c_type(a, key)

// A `c type` block declares a name a C header owns: the compiler knows it is a type and nothing
// else about it, which is exactly an empty struct that never has its fields filled in.
private opaque_c_type(a: &Analysis, key: string) -> Type
    val already = a.tables.struct_insts.get(key)

    if already.is_some() then return already.unwrap()

    val made = Struct(StructType(key, buf(), buf(), false, None, None, false))

    a.tables.struct_insts.put(key, made)
    made
end opaque_c_type

// Whether the arity is right, and what to say when it is not.
private check_arity(a: &Analysis, scope: Scope, span: Span, written: string, tparams: Buf[string],
                    tdefaults: Buf[TypeBinding], targs: Buf[Type]) -> bool
    val least = tparams.len() - tdefaults.len()

    if targs.len() >= least && targs.len() <= tparams.len() then return true

    a.fault(scope, span, s"type '$written' ${arity_phrase(tparams.len(), least)}, but " +
            s"${quantity(targs.len(), "type argument")} ${if targs.len() == 1 then "was" else "were"} given")
    false
end check_arity

// How an arity is described when it is wrong. Shared with the trait-arity check, which asks the same
// question of a trait's parameter list.
arity_phrase(most: usize, least: usize) -> string =
    if least == most then s"takes ${quantity(most, "type argument")}"
    else s"takes between $least and $most type arguments"

// `1 type argument`, `2 type arguments`.
quantity(n: usize, noun: string) -> string = s"$n $noun${if n == 1 then "" else "s"}"

// The bindings a declaration's parameters take from the arguments this instantiation was made with.
private bindings_for(tparams: Buf[string], targs: Buf[Type]) -> Buf[Binding]
    var out: Buf[Binding] = buf()

    for i in 0..<tparams.len()
        out.push(Binding(tparams.at(i), if i < targs.len() then targs.at(i) else Unknown))

    out
end bindings_for

// The arguments a declaration was applied to, with the ones it was not given taken from the defaults
// it declares.
//
// They are filled left to right, each resolved under the arguments already fixed, so a later default
// may name an earlier parameter and `[A, B = A]` means what it reads as. A default is written in the
// file that declares it, so it is resolved in **that** file's terms rather than the applying one's.
filled_targs(a: &Analysis, home: Scope, tparams: Buf[string], tdefaults: Buf[TypeBinding],
             targs: Buf[Type]) -> Buf[Type]
    if targs.len() >= tparams.len() || tdefaults.is_empty() then return targs

    var filled: Buf[Type] = buf()

    for i in 0..<targs.len()
        filled.push(targs.at(i))

    for i in filled.len()..<tparams.len()
        var here: Buf[Binding] = buf()

        for j in 0..<filled.len()
            here.push(Binding(tparams.at(j), filled.at(j)))

        val w = binding_named(tdefaults, tparams.at(i))

        if w.is_none() then filled.push(Unknown)
        else filled.push(resolve_type(a, home, w.unwrap(), here))

    filled
end filled_targs

// A struct at these arguments.
//
// **The record is registered before its fields are resolved**, so a declaration that mentions itself
// finds the record already there rather than recursing for ever.
instantiate_struct(a: &Analysis, scope: Scope, span: Span, written: string, key: string,
                   d: StructDecl, home: Scope, written_targs: Buf[Type]) -> Type
    if !check_arity(a, scope, span, written, d.tparams, d.tdefaults, written_targs) then
        return Unknown

    val targs = filled_targs(a, home, d.tparams, d.tdefaults, written_targs)
    val inst = instance_key(key, targs)
    val already = a.tables.struct_insts.get(inst)

    if already.is_some() then return already.unwrap()

    val open = a.tables.in_progress.get(inst)

    if open.is_some()
        if cycle_check(a, scope, span, inst) then return Unknown

        return open.unwrap()

    // **`@align` is part of what the layout IS**, so it is folded here rather than left for whoever
    // asks the size: it is fixed while compiling and is part of what the module publishes.
    //
    // **So is the name a C header declares the aggregate under**, which is what `@export("...")` on
    // a struct chooses; where the attribute is written with no name of its own, the declaration's
    // bare name is what it chose.
    val made: &StructType = StructType(key, targs, buf(), d.packed,
                                       aligned_to(a, scope, span, written, d.alignment),
                                       exported_c_name(d), d.opaque)
    val ty = Struct(made)

    a.tables.in_progress.put(inst, ty)
    a.resolving.push((inst, a.indirection, a.type_arg_depth))

    val subst = bindings_for(d.tparams, targs)

    for i in 0..<d.fields.len()
        val f = d.fields.at(i)

        made.fields.push((f.name, resolve_qualified(a, home, f.typ, subst)))

    a.resolving.truncate(a.resolving.len() - 1)
    a.tables.in_progress.remove(inst)
    a.tables.struct_insts.put(inst, ty)
    ty
end instantiate_struct

// An enum at these arguments, by the same rule and for the same reason.
instantiate_enum(a: &Analysis, scope: Scope, span: Span, written: string, key: string, d: EnumDecl,
                 home: Scope, written_targs: Buf[Type]) -> Type
    if !check_arity(a, scope, span, written, d.tparams, d.tdefaults, written_targs) then
        return Unknown

    val targs = filled_targs(a, home, d.tparams, d.tdefaults, written_targs)
    val inst = instance_key(key, targs)
    val already = a.tables.enum_insts.get(inst)

    if already.is_some() then return already.unwrap()

    val open = a.tables.in_progress.get(inst)

    if open.is_some()
        if cycle_check(a, scope, span, inst) then return Unknown

        return open.unwrap()

    var simple = true

    for i in 0..<d.variants.len()
        if !d.variants.at(i).fields.is_empty() then simple = false

    // Whether this is the first instantiation of the declaration, which is what the complaints about
    // what was WRITTEN are held against: a discriminant is an integer in the source and no type
    // argument reaches it, so `Pair[int]` and `Pair[bool]` would otherwise say the same thing twice
    // about one line.
    val first = !a.tables.enum_tags_seen.has(key)

    a.tables.enum_tags_seen.put(key, true)

    var underlying = d.underlying match
        Some(t) -> resolve_type(a, home, t, no_bindings())
        None -> int_type()

    // A pinned underlying type is the storage the discriminants are laid in, so it has to be one
    // they can be laid in. A generic enum is turned away before this, at its declaration, since it
    // is never instantiated when nothing names it and the mistake is in the declaration either way.
    if d.underlying.is_some() && d.tparams.is_empty() && first
        if !simple
            a.fault(scope, span, s"only a simple enum has an underlying integer type — " +
                    s"'${d.name}' carries data")
        else
            underlying match
                Integer(_, _, _) -> ()
                _ ->
                    a.fault(scope, span, s"an enum's underlying type must be an integer, not " +
                            type_show(underlying))
                    underlying = int_type()
    end if

    val made: &EnumType = EnumType(key, targs, simple, buf(), underlying)
    val ty = Enum(made)

    a.tables.in_progress.put(inst, ty)
    a.resolving.push((inst, a.indirection, a.type_arg_depth))

    val subst = bindings_for(d.tparams, targs)

    // **A simple enum's tag is its discriminant, which is the value the program wrote.** A data
    // enum's is its position, since nothing may name one. So the two are assigned by different
    // rules, and only the first of them reads what was written after the `=`.
    val cx = analyzer_for(a, home)
    var next_tag = 0

    for i in 0..<d.variants.len()
        val v = d.variants.at(i)
        var fields: Buf[(string, Type)] = buf()

        for j in 0..<v.fields.len()
            fields.push((v.fields.at(j).name, resolve_type(a, home, v.fields.at(j).typ, subst)))

        var tag = next_tag

        if simple
            v.value match
                // A discriminant is any compile-time integer, so a negative one under a signed
                // underlying type folds from the unary negation the parser gives, and a `const` may
                // stand where a literal does.
                Some(written_value) ->
                    val refusals = a.const_refusals

                    const_int(cx, written_value) match
                        Some(n) -> tag = fitting_tag(a, scope, span, v.name, n, underlying, first)
                        None ->
                            // A constant whose own fold refused has been told once, where the
                            // mistake is; a variant reading it is not a second mistake.
                            if first && !const_refused_since(a, refusals) then
                                a.fault(scope, span,
                                        s"the value of variant '${v.name}' must be a constant integer")
                None -> tag = fitting_tag(a, scope, span, v.name, from_int(long(next_tag)),
                                          underlying, first)
        else if v.value.is_some() && first
            a.fault(scope, span,
                    s"variant '${v.name}' carries data, so it cannot also have an explicit value")

        next_tag = tag + 1
        made.variants.push(EnumVariant(v.name, tag, fields, !v.fields.is_empty()))

    // A simple enum's value *is* its identity -- there is nothing else to tell two variants apart --
    // so two names for one value leave the language unable to keep its own promises: the second
    // variant's `match` arm can never run, and the lowering becomes a switch with a repeated case
    // the assembler rejects outright. A data enum cannot reach this, since its tags are assigned in
    // order and it refuses an explicit value.
    if simple && first then refuse_repeated_tags(a, scope, span, made.variants)

    a.resolving.truncate(a.resolving.len() - 1)
    a.tables.in_progress.remove(inst)
    a.tables.enum_insts.put(inst, ty)

    for i in 0..<made.variants.len()
        a.tables.variant_names.put(made.variants.at(i).name, true)

    ty
end instantiate_enum

// One discriminant, checked against the storage the `: iN` annotation pinned -- which is the whole
// point of pinning it.
private fitting_tag(a: &Analysis, scope: Scope, span: Span, name: string, n: BigInt,
                    underlying: Type, report: bool) -> int
    underlying match
        Integer(bits, signed, _) ->
            if !fits(n, bits, signed) && report
                a.fault(scope, span, s"discriminant ${to_string(n)} of variant '$name' does not " +
                        s"fit ${type_show(underlying)}")
        _ -> ()

    int(n.to_long().unwrap_or(0))
end fitting_tag

private refuse_repeated_tags(a: &Analysis, scope: Scope, span: Span, variants: Buf[EnumVariant])
    for i in 0..<variants.len()
        for j in 0..<i
            if variants.at(j).tag == variants.at(i).tag
                a.fault(scope, span,
                        s"variants '${variants.at(j).name}' and '${variants.at(i).name}' both " +
                        s"stand for ${variants.at(i).tag}, and a simple enum's values are the " +
                        "whole of what tells its variants apart — a second name for one value is " +
                        "a 'const'")
                return
end refuse_repeated_tags

// The boundary a struct asked to begin on, where it asked for one. A boundary is a power of two,
// since an address is aligned by having low bits clear, and it has to be settled while compiling.
private aligned_to(a: &Analysis, scope: Scope, span: Span, written: string,
                   asked: Option[Expr]) -> Option[usize]
    if asked.is_none() then return None

    val cx = analyzer_for(a, scope)

    const_int(cx, asked.unwrap()) match
        None ->
            a.fault(scope, span, s"'@align' on '$written' needs a constant — a literal, a 'const', " +
                    "or the arithmetic over them. A layout is fixed while compiling and is part of " +
                    "what this module publishes, so it cannot wait on a value")
            None
        Some(n) ->
            val bytes = n.to_long().unwrap_or(0)

            if bytes <= 0 || !is_power_of_two(bytes)
                a.fault(scope, span, s"'@align(${to_string(n)})' on '$written' is not an " +
                        "alignment — a boundary is a power of two, since an address is aligned by " +
                        "having low bits clear")
                return None

            Some(usize(bytes))
end aligned_to

private is_power_of_two(n: long) -> bool
    var v = n

    while v > 1
        if v % 2 != 0 then return false

        v /= 2

    v == 1
end is_power_of_two

// A trait used as a type.
private instantiate_trait(a: &Analysis, scope: Scope, span: Span, written: string, key: string,
                          d: TraitDecl, targs: Buf[Type], named: Buf[(string, Type)]) -> Type
    // **An argument on a trait may bind an associated type rather than a parameter.** A trait with
    // no parameters and one associated type has only one thing a bare argument could mean, so
    // `Iterate[char]` and `Iterate[Item = char]` are one type -- which is why a trait with associated
    // types is not told it takes no arguments.
    if d.tparams.is_empty() && !targs.is_empty() then
        if d.assocs.is_empty() then
            a.fault(scope, span, s"trait '$written' does not take type arguments")
            return Unknown

        return Trait(key, buf(), joined_assocs(assoc_bindings(d, targs), named))

    if !d.tparams.is_empty() then
        if !check_arity(a, scope, span, written, d.tparams, d.tdefaults, targs) then return Unknown

    Trait(key, targs, named)
end instantiate_trait

private joined_assocs(a: Buf[(string, Type)], b: Buf[(string, Type)]) -> Buf[(string, Type)]
    var out: Buf[(string, Type)] = buf()

    for i in 0..<a.len()
        out.push(a.at(i))

    for i in 0..<b.len()
        out.push(b.at(i))

    out
end joined_assocs

// What arguments written on a trait with associated types bind: a named one binds the associated
// type it names, and a bare one binds the trait's only associated type.
private assoc_bindings(d: TraitDecl, targs: Buf[Type]) -> Buf[(string, Type)]
    var out: Buf[(string, Type)] = buf()

    for i in 0..<targs.len()
        val name = if i < d.assocs.len() then d.assocs.at(i).name else ""

        out.push((name, targs.at(i)))

    out
end assoc_bindings

// A named subtype: a constrained type where it narrows anything, and another spelling of its base
// where it does not.
//
// **Following one has to terminate**, so the chain is walked with the names already entered kept: a
// name that leads back to itself is refused where it is declared rather than followed until the
// stack runs out.
instantiate_named_subtype(a: &Analysis, scope: Scope, span: Span, written: string, key: string,
                          d: TypeDecl, home: Scope, targs: Buf[Type]) -> Type
    if !targs.is_empty() then
        a.fault(scope, span, s"'$written' is ${if is_plain_alias(d) then "an alias" else "a constrained subtype"} " +
                "and takes no type arguments")
        return Unknown

    val already = a.tables.constrained_insts.get(key)

    if already.is_some() then return already.unwrap()

    if a.tables.broken.has(key) then return Unknown

    // Entered before the base is resolved, so a chain that leads back here finds the mark rather
    // than the answer.
    a.tables.broken.put(key, true)

    val base = resolve_type(a, home, d.base, no_bindings())

    if type_eq(base, Unknown) then return Unknown

    var made = base

    // **WHAT THE DECLARATION NARROWED IS PART OF THE TYPE.** `type Age = int within 0..150` is not
    // an `int` wearing a name: its ends are what `Age::Min` and `Age::Max` answer, what `Age::Valid`
    // asks about, and what a literal standing at it is held to. Left off, every one of those reads
    // the base's range and says nothing about the type the reader declared.
    var lo: Option[Decimal] = None
    var hi: Option[Decimal] = None
    var exclusive = false

    if d.range.is_some()
        val r = d.range.unwrap()

        lo = range_end(a, home, r.lo)
        hi = range_end(a, home, r.hi)
        exclusive = r.exclusive_hi
    end if

    // A `where` predicate narrows the type without saying where to, which is why the ends are not
    // readable off such a declaration. What is recorded is the function the condition lowered to,
    // which is what a conversion into the type calls to test a value.
    val pred = if d.pred.is_none() then None else Some(pred_key(key))

    // An exported name with no constraint is the one shape that may stand for more than a number:
    // what it asks for is a `typedef`, and C writes one for a pointer as readily as for an integer.
    // Anything C cannot spell that way is refused here, under the export's reading.
    if is_exported_alias(d) && !typedefable(base) then
        a.fault(home, d.cname.unwrap().span,
                s"'${qualified_name(key)}' is exported to a C header as ${type_show(base)}, which C " +
                "has no way to spell as a typedef — a header names an integer, a float, 'bool', " +
                s"'char' or a pointer this way. ${typedef_advice(base)}")

    // Written bare, `@export` gives the header the declared name, as it does a struct's.
    val cname = d.cname match
        Some(e) -> Some(e.symbol.unwrap_or(module_bare(spelled_key(key))))
        None -> None

    if !is_plain_alias(d) then
        made = constrained_exported(key, base, d.derived, lo, hi, exclusive, pred, cname)

    a.tables.constrained_insts.put(key, made)
    made
end instantiate_named_subtype

// The number a written range end stands for, where it settles at all. A `within` may be written over
// floats as well as integers, so a literal is read as text and everything else is folded.
private range_end(a: &Analysis, scope: Scope, e: Expr) -> Option[Decimal]
    *e.kind match
        FloatLit(text, _) -> return decimal_parse(text)
        // `-0.5` is a negation of a float literal rather than a literal, and folding knows no floats.
        Unary(op, operand) -> *operand.kind match
            FloatLit(text, _) -> if op == "-" then return decimal_parse(text).map((d) -> -d)
            _ -> ()
        _ -> ()

    val cx = analyzer_for(a, scope)
    val mark = a.complaints()
    val folded = const_fold(cx, e)

    a.restore_complaints(mark)

    // A `char` range is a range over code points, so its ends are the numbers the characters are.
    folded match
        Some(ConstInt(n)) -> Some(decimal_of(n, 0))
        Some(ConstChar(c)) -> Some(decimal_of(from_int(long(u32(c))), 0))
        _ -> None
end range_end

// **Every constant declared at a constrained type holds a value its range admits**, settled while
// compiling -- a constant has no run time to be checked at. It is what makes a range on a constant
// worth writing: a `c const` measured from a header is a number nobody chose, so a range on the type
// it is read into is a claim about the configuration the program was built against. A `new` type
// and a `where` predicate are refused at the declaration (`check_const_named`) and are passed over.
//
// **Every constant is folded where it is declared, used or not** -- a constant is its value, so a
// value that does not fold, does not fit, or is of another kind is a mistake in the declaration and
// not in whichever use happens to read it first. The declared type is asked first: an aggregate is
// storage and is pointed at `val`, which is the answer a reader needs rather than a claim about
// constancy.
check_const_admits(a: &Analysis)
    for i in 0..<a.tables.consts.len()
        val v = a.tables.consts.at(i)
        val key = a.tables.consts.key_at(i)

        if v.typ.is_none() || v.init.is_none() then continue

        val t = resolve_type(a, v.scope, v.typ.unwrap(), no_bindings())

        if const_type_refused(a, v, t) then continue

        val cx = analyzer_for(a, v.scope)
        val mark = a.complaints()
        val refusals = a.const_refusals

        a.consts_in_progress.push(key)

        val folded = const_fold(cx, v.init.unwrap())

        a.consts_in_progress.truncate(a.consts_in_progress.len() - 1)

        // A fold that stopped at something it had to say -- a division by zero, a loop -- has said it,
        // and so has one that read a constant whose own fold refused: that complaint was made once,
        // where the mistake is, and saying this one would be the same mistake told twice.
        if folded.is_none()
            if a.complaints() == mark && !const_refused_since(a, refusals) then
                a.fault(v.scope, v.init.unwrap().span, s"the value of '${v.name}' is not a constant expression")

            continue
        end if

        t match
            Constrained(cd) ->
                if const_fits(a, v, folded.unwrap(), underlying(t)) then const_admitted(a, v, t, cd)
            _ -> const_fits(a, v, folded.unwrap(), t)
end check_const_admits

// Whether a constant's declared type is one it may not be, said where it is. A struct, an enum, a
// `new` type and a `where` predicate are told at the declaration by `check_const_named`, and are only
// passed over here.
private const_type_refused(a: &Analysis, v: ValueDecl, t: Type) -> bool
    val named = *v.typ.unwrap().kind match
        NamedType(_, _) -> true
        _ -> false

    val scalar = t match
        Integer(_, _, _) -> true
        Floating(_, _) -> true
        Bool -> true
        Char -> true
        Str -> true
        _ -> false

    if scalar then return false

    t match
        Constrained(cd) -> return cd.derived || cd.pred_fn.is_some()
        Unknown -> return true
        _ -> ()

    if named then return true

    val storage = t match
        Array(_, _) -> true
        Vector(_, _) -> true
        Struct(_) -> true
        _ -> false

    if storage then
        a.fault(v.scope, v.span, s"a constant is a scalar, and ${type_show(t)} is storage — write " +
                s"'${v.name}' as a 'val', which is laid into the object file as constant data")
    else
        a.fault(v.scope, v.span, s"a constant is a scalar, and ${type_show(t)} is not — '${v.name}'")

    true
end const_type_refused

// Whether a folded value is one the declared type holds, said at the VALUE where it is not -- the
// value is what does not fit, and it is where a refusal from inside the fold points too.
private const_fits(a: &Analysis, v: ValueDecl, value: Const, t: Type) -> bool
    val at = v.init.unwrap().span

    val kind_fits = value match
        ConstInt(_) -> t match
            Integer(_, _, _) -> true
            _ -> false
        ConstFloat(_) -> t match
            Floating(_, _) -> true
            _ -> false
        ConstBool(_) -> t match
            Bool -> true
            _ -> false
        ConstChar(_) -> t match
            Char -> true
            _ -> false
        ConstStr(_) -> t match
            Str -> true
            _ -> false

    if !kind_fits
        a.fault(v.scope, at, s"'${v.name}' is declared ${type_show(t)} but its value is " +
                const_kind(value))
        return false
    end if

    value match
        ConstInt(n) -> t match
            Integer(bits, signed, _) ->
                if !fits(n, bits, signed)
                    a.fault(v.scope, at, s"'${v.name}' does not fit ${type_show(t)}: ${to_string(n)}")
                    return false
                end if
            _ -> ()
        _ -> ()

    true
end const_fits

private const_admitted(a: &Analysis, v: ValueDecl, t: Type, cd: &ConstrainedType)
    if cd.derived || cd.pred_fn.is_some() || cd.lo.is_none() || cd.hi.is_none() then return

    val value = range_end(a, v.scope, v.init.unwrap())

    if value.is_none() then return

    val n = value.unwrap()
    val lo = cd.lo.unwrap()
    val hi = cd.hi.unwrap()
    val under = if cd.exclusive_hi then n < hi else n <= hi
    val top = if cd.exclusive_hi then s"under $hi" else s"$hi"

    if n < lo || !under then
        a.fault(v.scope, v.init.unwrap().span,
                s"'${v.name}' is $n, which ${type_show(t)} does not admit — it holds $lo to $top")
end const_admitted

// Whether a declaration is another spelling of its base rather than a type of its own.
//
// **A measured `c type` is written in exactly this shape and is not one.** It is a distinct scalar
// whose width came from the C compiler, so a signature naming it says `Tick` where a transparent
// alias would have said `uint` -- which is the whole point of writing one: the header owns the width
// and the program names the typedef.
//
// **Nor is an exported one**, for the same reason seen from the header's side: `@export` asks a
// generated header to spell the type by a name of its own, and a name that dissolved into its base
// here would leave nothing there to spell. It is built as a transparent type with no constraint,
// interchangeable with its base in both directions, as before.
is_plain_alias(d: TypeDecl) -> bool =
    !d.derived && d.range.is_none() && d.pred.is_none() && !d.from_c && d.cname.is_none()

// Whether a declaration is an alias a C header is asked to declare as a `typedef`.
private is_exported_alias(d: TypeDecl) -> bool =
    d.cname.is_some() && !d.derived && d.range.is_none() && d.pred.is_none()

// The name a C header declares a struct under, where the declaration asked for one -- the symbol it
// wrote, or its own bare name where it named the attribute and nothing else.
private exported_c_name(d: StructDecl) -> Option[string] = d.cname match
    Some(e) -> e.symbol match
        Some(sym) -> Some(sym)
        None -> Some(module_bare(d.name))
    None -> None
