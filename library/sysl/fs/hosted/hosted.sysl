module sysl.fs.hosted
@requires(os)

import sysl.fs.sys.Stat

// `sysl.fs.sys`'s hooks answered over the platform's C library, which is what every hosted target
// links. **Call `sysl.fs` instead** -- nothing here is meant to be called: each function below exists
// to be linked under a hook's symbol, and is public only because an `@export` may not be `private`.
//
// **Nothing imports this module, and nothing has to.** A hook a program reaches is answered by the
// library's own supplier wherever the target can run one (`reference/ffi.md § A module may supply
// another module's extern`), and this module requires `os`, so a freestanding target never takes it:
// there, the program answers the hooks itself, and one it leaves unanswered is refused by name when
// it is compiled. Where the program does answer a hook with an `@export` of its own and the library is
// compiled beside it, the program's definition is the one taken and this one is left out.
//
// **This is the only code in the library that reads `errno`**, and it reads it straight after the
// call that failed, with nothing between the two that could overwrite it. What it hands back is the
// number; `sysl.fs` turns it into an `IoError` once, in `from_errno`.
//
// **What only C can answer is answered by C beside this file**: the `O_*` values `open` takes, which
// differ between C libraries; `struct stat` and `struct dirent`, which every platform lays out its own
// way; `off_t`, whose width is the platform's; and the two calls that write into a buffer of
// `PATH_MAX`, which is a `#define`. Each shim does one call and hands back the plain answer, and the
// `errno` it leaves is read here. The shims under `__hosted__/` use only what wasi-libc has too; the
// two under `__posix__/` need a POSIX C library, and on any other target their hooks answer -1, "not
// supported on this target".

// `errno` is a **function** on every platform this builds for, not a variable -- C spells it as a
// macro expanding to a dereference so that a threaded program gets its own -- so the binding is to
// whatever that macro expands to rather than to a symbol called `errno`, which does not exist.
//
// **The gate is `bsd` rather than `macos`** -- `__error` is what every BSD libc calls this. **Android's
// Bionic is a Linux libc that does not spell it glibc's way**: its accessor is `__errno`, and it has
// no `__errno_location` at all.
#if bsd
private extern "__error" errno_location() -> *i32
#elif android
private extern "__errno" errno_location() -> *i32
#else
private extern "__errno_location" errno_location() -> *i32
#endif

/** What a hook answers for a C call that reports failure as a non-zero result: zero, or the number
 * the failure left behind. Asked straight after the call, so nothing can have overwritten it.
 */
private status(rc: int) -> int = if rc != 0 then errno_location()[0] else 0

/** `ENAMETOOLONG`: 63 on a BSD, 36 under glibc and Bionic, which is what a path too long for the
 * terminated copy below is answered with -- the code the C library would have given for it.
 */
#if bsd
private const name_too_long: int = 63
#else
private const name_too_long: int = 36
#endif

/** How long a path may be once a terminator is put after it. 4,096 bytes is what every Linux allows
 * and four times what macOS does, so a path this refuses is one no filesystem here can hold.
 */
private const path_room: usize = 4096

/** The path `p` of `n` bytes copied into `into` with a zero after it, which is the shape C wants and
 * a sysl `string` does not carry. False where it does not fit.
 */
private terminated(p: *u8, n: usize, into: []u8) -> bool
    if n >= into.len then return false

    for i in 0..<n do into[i] = p[i]

    into[n] = 0
    true
end terminated

// -- the C library, by symbol ------------------------------------------------------------------------

private extern "read" c_read(fd: int, into: *u8, n: usize) -> isize
private extern "write" c_write(fd: int, from: *u8, n: usize) -> isize
private extern "close" c_close(fd: int) -> int
private extern "unlink" c_unlink(path: *u8) -> int
private extern "rmdir" c_rmdir(path: *u8) -> int
private extern "rename" c_rename(from: *u8, to: *u8) -> int
private extern "access" c_access(path: *u8, how: int) -> int
private extern "chdir" c_chdir(path: *u8) -> int
private extern "getcwd" c_getcwd(into: *u8, room: usize) -> *u8
private extern "symlink" c_symlink(target: *u8, link: *u8) -> int
private extern "link" c_link(existing: *u8, fresh: *u8) -> int
private extern "readlink" c_readlink(path: *u8, into: *u8, room: usize) -> isize
private extern "opendir" c_opendir(path: *u8) -> *u8
private extern "closedir" c_closedir(d: *u8) -> int

// `mode_t` is the one argument whose width the C libraries disagree about -- sixteen bits on a BSD,
// thirty-two elsewhere -- and the declaration says so rather than passing the wider one and leaving
// the callee to ignore the top half. Getting it wrong is silent, which is why it is gated on `bsd`.
#if bsd
private extern "mkdir" c_mkdir(path: *u8, mode: u16) -> int

private made_dir(p: *u8, mode: u32) -> int = c_mkdir(p, u16(mode))
#else
private extern "mkdir" c_mkdir(path: *u8, mode: u32) -> int

private made_dir(p: *u8, mode: u32) -> int = c_mkdir(p, mode)
#endif

#if bsd
private extern "chmod" c_chmod(path: *u8, mode: u16) -> int

private changed_mode(p: *u8, mode: u32) -> int = c_chmod(p, u16(mode & 0o7777))
#elif posix
private extern "chmod" c_chmod(path: *u8, mode: u32) -> int

private changed_mode(p: *u8, mode: u32) -> int = c_chmod(p, mode & 0o7777)
#endif

// -- the shims beside this file ----------------------------------------------------------------------

private extern "sysl_fs_host_open" c_open(path: *u8, flags: u32, mode: u32) -> int
private extern "sysl_fs_host_lseek" c_lseek(fd: int, offset: long, whence: int) -> long
private extern "sysl_fs_host_ftruncate" c_ftruncate(fd: int, length: long) -> int
private extern "sysl_fs_host_truncate" c_truncate(path: *u8, length: long) -> int
private extern "sysl_fs_host_stat" c_stat(path: *u8, follow: int, out: *long) -> int
private extern "sysl_fs_host_fstat" c_fstat(fd: int, out: *long) -> int
private extern "sysl_fs_host_readdir" c_readdir(d: *u8) -> *u8

#if posix
private extern "sysl_fs_host_realpath" c_realpath(path: *u8, into: *u8, room: u64) -> long
private extern "sysl_fs_host_temp_dir" c_temp_dir(prefix: *u8, into: *u8, room: usize) -> int
#endif

// -- descriptors -------------------------------------------------------------------------------------

@export("sysl_fs_open")
supply_open(path: *u8, len: usize, flags: u32, mode: u32, fd: *int) -> int
    var c: [path_room]u8

    if !terminated(path, len, c[..]) then return name_too_long

    val opened = c_open(&c[0], flags, mode)

    if opened < 0 then return errno_location()[0]

    *fd = opened
    0
end supply_open

@export("sysl_fs_read")
supply_read(fd: int, into: *u8, room: usize, got: *usize) -> int
    val n = c_read(fd, into, room)

    if n < 0 then return errno_location()[0]

    *got = usize(n)
    0
end supply_read

@export("sysl_fs_write")
supply_write(fd: int, from: *u8, len: usize, put: *usize) -> int
    val n = c_write(fd, from, len)

    if n < 0 then return errno_location()[0]

    *put = usize(n)
    0
end supply_write

@export("sysl_fs_close")
supply_close(fd: int) -> int = status(c_close(fd))

@export("sysl_fs_seek")
supply_seek(fd: int, offset: long, whence: int, at: *long) -> int
    val to = c_lseek(fd, offset, whence)

    if to < 0 then return errno_location()[0]

    *at = to
    0
end supply_seek

@export("sysl_fs_fstat")
supply_fstat(fd: int, out: *Stat) -> int = status(c_fstat(fd, ptr_cast(out)))

@export("sysl_fs_ftruncate")
supply_ftruncate(fd: int, length: long) -> int = status(c_ftruncate(fd, length))

// -- paths -------------------------------------------------------------------------------------------

@export("sysl_fs_stat")
supply_stat(path: *u8, len: usize, follow: int, out: *Stat) -> int
    var c: [path_room]u8

    if !terminated(path, len, c[..]) then return name_too_long

    status(c_stat(&c[0], follow, ptr_cast(out)))
end supply_stat

@export("sysl_fs_truncate")
supply_truncate(path: *u8, len: usize, length: long) -> int
    var c: [path_room]u8

    if !terminated(path, len, c[..]) then return name_too_long

    status(c_truncate(&c[0], length))
end supply_truncate

@export("sysl_fs_mkdir")
supply_mkdir(path: *u8, len: usize, mode: u32) -> int
    var c: [path_room]u8

    if !terminated(path, len, c[..]) then return name_too_long

    status(made_dir(&c[0], mode))
end supply_mkdir

@export("sysl_fs_rmdir")
supply_rmdir(path: *u8, len: usize) -> int
    var c: [path_room]u8

    if !terminated(path, len, c[..]) then return name_too_long

    status(c_rmdir(&c[0]))
end supply_rmdir

@export("sysl_fs_unlink")
supply_unlink(path: *u8, len: usize) -> int
    var c: [path_room]u8

    if !terminated(path, len, c[..]) then return name_too_long

    status(c_unlink(&c[0]))
end supply_unlink

@export("sysl_fs_rename")
supply_rename(from: *u8, from_len: usize, to: *u8, to_len: usize) -> int
    var a: [path_room]u8
    var b: [path_room]u8

    if !terminated(from, from_len, a[..]) || !terminated(to, to_len, b[..]) then return name_too_long

    status(c_rename(&a[0], &b[0]))
end supply_rename

@export("sysl_fs_access")
supply_access(path: *u8, len: usize, how: int) -> int
    var c: [path_room]u8

    if !terminated(path, len, c[..]) then return name_too_long

    status(c_access(&c[0], how))
end supply_access

@export("sysl_fs_chmod")
supply_chmod(path: *u8, len: usize, mode: u32) -> int
#if posix
    var c: [path_room]u8

    if !terminated(path, len, c[..]) then return name_too_long

    status(changed_mode(&c[0], mode))
#else
    -1
#endif
end supply_chmod

// -- directories -------------------------------------------------------------------------------------

@export("sysl_fs_opendir")
supply_opendir(path: *u8, len: usize, dir: *usize) -> int
    var c: [path_room]u8

    if !terminated(path, len, c[..]) then return name_too_long

    val d = c_opendir(&c[0])

    if d == null then return errno_location()[0]

    *dir = usize(d)
    0
end supply_opendir

// The shim zeroes `errno` before it asks, because `readdir` answers the end of the listing and a
// failure with the same null: only a number left behind tells them apart.
@export("sysl_fs_readdir")
supply_readdir(dir: usize, into: *u8, room: usize, got: *usize) -> int
    val name = c_readdir(ptr_cast(dir))

    if name == null
        val why = errno_location()[0]

        if why != 0 then return why

        *got = 0
        return 0
    end if

    var n: usize = 0

    while name[n] != 0
        n += 1

    if n > room then return name_too_long

    for i in 0..<n do into[i] = name[i]

    *got = n
    0
end supply_readdir

@export("sysl_fs_closedir")
supply_closedir(dir: usize) -> int = status(c_closedir(ptr_cast(dir)))

@export("sysl_fs_getcwd")
supply_getcwd(into: *u8, room: usize, got: *usize) -> int
    if c_getcwd(into, room) == null then return errno_location()[0]

    var n: usize = 0

    while n < room && into[n] != 0
        n += 1

    *got = n
    0
end supply_getcwd

@export("sysl_fs_chdir")
supply_chdir(path: *u8, len: usize) -> int
    var c: [path_room]u8

    if !terminated(path, len, c[..]) then return name_too_long

    status(c_chdir(&c[0]))
end supply_chdir

@export("sysl_fs_temp_dir")
supply_temp_dir(prefix: *u8, len: usize, into: *u8, room: usize, got: *usize) -> int
#if posix
    var c: [path_room]u8

    if !terminated(prefix, len, c[..]) then return name_too_long

    val code = c_temp_dir(&c[0], into, room)

    if code != 0 then return code

    var n: usize = 0

    while n < room && into[n] != 0
        n += 1

    *got = n
    0
#else
    -1
#endif
end supply_temp_dir

// -- links -------------------------------------------------------------------------------------------

@export("sysl_fs_symlink")
supply_symlink(target: *u8, target_len: usize, link: *u8, link_len: usize) -> int
    var a: [path_room]u8
    var b: [path_room]u8

    if !terminated(target, target_len, a[..]) || !terminated(link, link_len, b[..]) then return name_too_long

    status(c_symlink(&a[0], &b[0]))
end supply_symlink

@export("sysl_fs_link")
supply_link(existing: *u8, existing_len: usize, fresh: *u8, fresh_len: usize) -> int
    var a: [path_room]u8
    var b: [path_room]u8

    if !terminated(existing, existing_len, a[..]) || !terminated(fresh, fresh_len, b[..])
        return name_too_long

    status(c_link(&a[0], &b[0]))
end supply_link

@export("sysl_fs_readlink")
supply_readlink(path: *u8, len: usize, into: *u8, room: usize, got: *usize) -> int
    var c: [path_room]u8

    if !terminated(path, len, c[..]) then return name_too_long

    val n = c_readlink(&c[0], into, room)

    if n < 0 then return errno_location()[0]

    *got = usize(n)
    0
end supply_readlink

@export("sysl_fs_realpath")
supply_realpath(path: *u8, len: usize, into: *u8, room: usize, got: *usize) -> int
#if posix
    var c: [path_room]u8

    if !terminated(path, len, c[..]) then return name_too_long

    val n = c_realpath(&c[0], into, u64(room))

    if n < 0 then return errno_location()[0]

    *got = usize(n)
    0
#else
    -1
#endif
end supply_realpath
