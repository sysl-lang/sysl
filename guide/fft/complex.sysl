// Complex numbers — a value type whose operators are its trait implementations.
//
// Everything here is `14` at work. `+` is `Add::add`, `*` is `Mul::mul`, `-` is `Sub::sub` in one
// position and `Neg::neg` in the other, and `!=` is a derivation over `Eq::eq` that this file never
// writes. A `Complex` is a plain struct with two fields, so it copies where it is assigned and is
// passed by value; nothing about giving it arithmetic changes that.

import sysl.buf.byte_sink
import sysl.math.tau

struct Complex
    re: f64
    im: f64

    conj(self) -> Complex = Complex(self.re, -self.im)

    // The squared magnitude, which is what division and comparison want — taking the root and
    // squaring it again would lose accuracy for nothing.
    norm(self) -> f64 = self.re * self.re + self.im * self.im

    abs(self) -> f64 = self.norm().sqrt()

    // Floating point makes equality the wrong question almost everywhere, so this is the one the
    // program actually asks.
    near(self, rhs: Complex, eps: f64) -> bool = (self - rhs).abs() < eps
end Complex

// The additive identity, promised by the type rather than by any value of it. `Zero` is declared
// here rather than reached for: `14 §7` records that no trait in the catalog declares a zero, and a
// program that wants one declares it, which is ordinary code now that a trait member may have no
// receiver at all. What it buys is `sum` below.
//
// The built-in it is implemented for is `int` and not `f64`, and that is not a preference. A type's
// members are one namespace whatever brought them, and `sysl.math`'s `Float` already declares a
// `zero` for both float widths -- so this trait, whose member is named for the thing it is, cannot
// be implemented for the two types this program does its arithmetic in. Nothing is imported to make
// that so: a member arrives with its type (`13 §2`), so the reservation holds in every program
// whether or not it ever mentions the module.
trait Zero
    zero() -> Self

impl Zero for int
    zero() -> int = 0

impl Zero for Complex
    zero() -> Complex = Complex(0.0, 0.0)

// The sum that `14 §7` names as the function which had to seed from `xs[0]` and put an `Option` in
// its signature to cope with an empty input. It starts at the type's own zero instead, so an empty
// sequence has the answer every other sequence has, and one body serves the built-in width and the
// type this program made.
sum[T: Add + Zero](xs: []const T) -> T
    var total = T.zero()

    for i in 0..<xs.len do total += xs[i]

    total
end sum

zero() -> Complex = Complex.zero()

one() -> Complex = Complex(1.0, 0.0)

// `e^(i*theta)` — the twiddle factor, and the only place trigonometry enters.
expi(theta: f64) -> Complex = Complex(theta.cos(), theta.sin())

polar(r: f64, theta: f64) -> Complex = expi(theta) * r

impl Add for Complex
    add(self, rhs: Complex) -> Complex = Complex(self.re + rhs.re, self.im + rhs.im)

impl Sub for Complex
    sub(self, rhs: Complex) -> Complex = Complex(self.re - rhs.re, self.im - rhs.im)

impl Mul for Complex
    mul(self, rhs: Complex) -> Complex =
        Complex(self.re * rhs.re - self.im * rhs.im, self.re * rhs.im + self.im * rhs.re)

// The complex numbers are a vector space over the reals, and scaling is the multiplication a
// transform performs most often — every sample of an inverse, every window function, every spectrum
// read in decibels. It is `Mul` at a second argument list rather than a second trait, because
// `2.0 + 3.0i` scaled by `2.0` is the same operation as multiplying it by `2.0 + 0.0i` and costs a
// quarter as much. Which of the two a `*` means is settled by the type of its right operand.
impl Mul[f64] for Complex
    mul(self, k: f64) -> Complex = Complex(self.re * k, self.im * k)

impl Div for Complex
    div(self, rhs: Complex) -> Complex
        var d = rhs.norm()

        Complex((self.re * rhs.re + self.im * rhs.im) / d, (self.im * rhs.re - self.re * rhs.im) / d)
    end div

impl Neg for Complex
    neg(self) -> Complex = Complex(-self.re, -self.im)

// Equality and nothing else. The complex numbers are not ordered, and `14 §2` makes `Eq` and `Ord`
// independent traits precisely so that a type may say so — there is no hierarchy to opt out of.
impl Eq for Complex
    eq(self, rhs: Complex) -> bool = self.re == rhs.re && self.im == rhs.im

// The specifier a part is rendered with: no field of its own, so that the field belongs to the
// value as a whole.
private plain() -> FormatSpec = FormatSpec(0, -1, false)

// A specifier describes the field the *whole* value lands in (`14 §2`), so the three pieces are
// gathered first and the field applied to what they came to. Padding each piece instead would put
// spaces inside the number. This program was written with its own twelve-line sink; `byte_sink`
// is that sink, in the prelude, which is where the second type to render more than one part would
// have wanted it.
impl Display for Complex
    display(self, out: *Writer, fmt: FormatSpec)
        var g = byte_sink()
        var neutral = plain()
        var negative = self.im < 0.0

        display_real(self.re, &g, neutral)
        display_str(if negative then "-" else "+", &g, neutral)
        display_real(if negative then -self.im else self.im, &g, neutral)
        display_str("i", &g, neutral)

        display_pad(g.text(), out, fmt)
    end display
