module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.{Search, StrBuilder, str_builder, from_utf8_unchecked, replace_all}

// Conditional compilation: the lines of a file that belong to the target being built for.
//
// A systems language needs one file to be able to say two things, because the two machines it is
// describing genuinely differ -- a syscall number, a struct a header lays out differently, a symbol
// one libc exports and the other does not. Everything else about a target is a fact the compiler
// reads; this is the one place a *program* gets to read one.
//
// **The gating is by line, and it happens before the lexer sees anything.** A line inside a branch
// this target is not being built for is replaced by an empty line -- replaced rather than removed,
// so every line below keeps the number it was written at and a diagnostic quotes the line it means.
// The directive lines go the same way, which is what makes them cost nothing: after this runs, the
// file is an ordinary sysl file that happens to have some blank lines in it, and nothing downstream
// knows any of it happened. It is the same trick the literate tangle plays on prose, for the same
// reason.
//
// **The cost, stated rather than worked around: the inactive branch is never syntax-checked.** That
// is C's cost too, and it is the price of gating text rather than trees. What is *not* given up is
// the conditions themselves -- every condition on every directive is read and checked here, in the
// branch being taken and the ones being skipped alike, so a misspelled symbol in the Linux half is
// caught by a macOS build.

// One open group.
//
// `taken` is whether *this* branch's lines are the ones being kept, and it already accounts for the
// groups enclosing this one -- so the whole stack being `taken` is exactly the condition for a line
// to survive. `chosen` is whether any branch of the group has been taken yet, which is what an
// `#elif` and an `#else` consult. `else_line` is where this group's `#else` is, or `0` for a group
// that has not reached one.
//
// `in_block` marks a group opened inside a text block, which has to close inside it too. `text` marks
// a group of the text's own -- a C `#if LIMIT > 2` or `#ifdef` and the lines down to its `#endif`,
// directive-shaped or not, which are all the block's text. It selects nothing: its `taken` is the
// enclosing one's, and it is on the stack only so that its own `#else` and `#endif` are known to be
// its own.
private struct Frame
    line: usize
    taken: bool
    chosen: bool
    else_line: usize
    in_block: bool
    text: bool
end Frame

// The directive a line carries: the word, and the column its argument would start at.
private struct Directive
    word: string
    at: usize
end Directive

// The source as this target sees it, or the first thing wrong with its directives.
//
// A file with no directives comes back **unchanged**: a compilation that gated nothing should be the
// compilation it would have been before any of this existed.
//
// `features` are the `feature_<name>` symbols of the package the file belongs to -- the features its
// own manifest declares that the resolution enabled, and no other package's.
gate(src: Source, target: Target, features: Buf[string] = buf()) -> Result[Source, Diagnostic]
    var on = defined(target)

    for item in features
        on.push(item)

    val lines = src.line_count()
    var stack: Buf[Frame] = buf()
    var keep: Buf[bool] = buf()
    var touched = false

    // Where the live code not yet read for literals begins (`inside_literal`).
    var scan_from: usize = 0

    // The stretch of literals the last directive-shaped line was found inside: where it began, and
    // where the code after it starts, or 0 outside every literal. A text block and a block comment can
    // share one stretch (`*/ s = """`), so each line in it is asked which it is inside.
    var block_from: usize = 0
    var block_end: usize = 0

    for line in 1..lines
        val text = from_utf8_unchecked(src.line_text(line))
        val start = src.line_span(line).start

        // Past the literal's end, a group opened inside it is one that crossed its end. The text's
        // own groups end with it: C in a text block need not balance.
        if block_end > 0 && start >= block_end
            crossing(src, stack, line - 1) match
                Some(bad) -> return Err(bad)
                None -> ()

            while stack.len() > 0 && stack.at(stack.len() - 1).in_block
                stack.pop()

            block_end = 0

        // A margin line inside a literal that opened in live code is asked whether it is sysl's. In a
        // block comment none is; in a text block a condition sysl can read gates, and everything
        // else is the block's text (`in_text_block`). An inactive branch is never read this way,
        // since it need not even lex.
        val found = directive_of(text) match
            Some(d) ->
                if block_end == 0 && all_taken(stack) && inside_literal(src, &scan_from, &block_from, start)
                    block_end = scan_from

                if block_end == 0 then Some(d)
                elif literal_reach_text(src, block_from, start).1 && in_text_block(d, text, line, &stack, on) then Some(d)
                else None
            None -> None

        found match
            None ->
                // A line survives when every open group is in its taken branch: an `#if` inside a
                // branch that was not taken selects nothing at all, however its own condition reads.
                val live = all_taken(stack)

                keep.push(live)

                if !live then touched = true
            Some(d) ->
                touched = true
                keep.push(false)

                // A directive line is not code, so live code starts again on the line after it --
                // unless it is inside a text block, which goes on past it.
                if block_end == 0 then scan_from = src.line_span(line + 1).start

                val word = d.word

                if word == "if"
                    val value = condition(src, line, text, d.at, word, on)?
                    var taken = false

                    if all_taken(stack) && value then taken = true

                    stack.push(Frame(line, taken, value, 0, block_end > 0, false))
                elif word == "elif"
                    if stack.len() == 0
                        return Err(fail_at(src, line, 1,
                            "'#elif' has no '#if' above it to be an alternative to"))

                    val top = stack.at(stack.len() - 1)

                    if top.else_line > 0
                        return Err(fail_at(src, line, 1,
                            s"'#elif' comes after the '#else' on line ${top.else_line}, which is already the alternative to everything above it"))

                    val value = condition(src, line, text, d.at, word, on)?
                    var taken = false

                    // `chosen` is what makes the branches exclusive rather than merely conditional:
                    // it says a branch of this group has already been taken, so no later one is,
                    // however its own condition reads.
                    if outer_taken(stack) && !top.chosen && value then taken = true

                    stack.set(stack.len() - 1, Frame(top.line, taken, top.chosen || value, top.else_line,
                        top.in_block, false))
                elif word == "else"
                    trailing(src, line, text, d.at, word) match
                        Some(bad) -> return Err(bad)
                        None -> ()

                    if stack.len() == 0
                        return Err(fail_at(src, line, 1,
                            "'#else' has no '#if' above it to be an alternative to"))

                    val top = stack.at(stack.len() - 1)

                    if top.else_line > 0
                        return Err(fail_at(src, line, 1,
                            s"this group already has an '#else', on line ${top.else_line}"))

                    var taken = false

                    if outer_taken(stack) && !top.chosen then taken = true

                    stack.set(stack.len() - 1, Frame(top.line, taken, true, line, top.in_block, false))
                elif word == "endif"
                    trailing(src, line, text, d.at, word) match
                        Some(bad) -> return Err(bad)
                        None -> ()

                    if stack.len() == 0
                        return Err(fail_at(src, line, 1, "'#endif' has no '#if' above it to close"))

                    stack.pop()
                else
                    return Err(fail_at(src, line, 1, not_word_message(word).unwrap()))

    // Reported at the `#if` rather than at the end of the file, because the `#if` is what the reader
    // has to go and look at: an unterminated group is a missing `#endif`, and with several groups
    // open the end of the file says nothing about which one is missing it. The outermost is named
    // because it is the one whose `#endif` would have to come last.
    if block_end > 0
        crossing(src, stack, lines) match
            Some(bad) -> return Err(bad)
            None -> ()

        while stack.len() > 0 && stack.at(stack.len() - 1).in_block
            stack.pop()

    if stack.len() > 0
        return Err(fail_at(src, stack.at(0).line, 1, "this '#if' is never closed — add an '#endif'"))

    if !touched then return Ok(src)

    var out = str_builder()

    for line in 1..lines
        if line > 1 then out.push_char('\n')
        if keep.at(line - 1) then out.push(line_raw(src, line))

    Ok(source_of(src.name, out.finish()))
end gate

// Whether the line starting at `start` is inside a literal -- a text block or a block comment -- that
// opened in the live code before it. The code from `scan_from` on is read with the lexer's own scans
// (`literal_reach`), a line's reach at a time, so a file with no directive reads nothing twice and a
// file with some reads only its live stretches. Where the answer is yes, `scan_from` is left at the
// code after the reach and `reach_start` where the reach began, which is where a line in it is asked
// which of its literals it is inside (`literal_reach_text`).
private inside_literal(src: Source, scan_from: *usize, reach_start: *usize, start: usize) -> bool
    while *scan_from < start
        *reach_start = *scan_from
        *scan_from = literal_reach(src, *scan_from) + 1

    *scan_from > start
end inside_literal

// Whether a directive-shaped line inside a text block is sysl's -- and where it is the text's own,
// what it opens or closes among the text's groups.
//
// **A condition sysl can read, over symbols sysl knows, gates; everything else is the text's.** The
// test is the live-code reading itself: `#if feature_http2` and `#if posix` gate, and `#if LIMIT > 2`,
// `#if defined(X)` and `#if NDEBUG` are C. A `feature_` name is read as it is in live code, where a
// feature the manifest does not declare is false rather than refused -- so a misspelled one gates its
// lines out, exactly as it would outside the block, instead of passing through as text. Every other
// directive word -- `#ifdef`, `#define`, `#include` -- is text, and a text `#if` or `#ifdef` opens a
// group of the text's own whose `#elif`, `#else` and `#endif` are text too, so a C conditional stays
// whole inside a sysl group or around one. An `#elif`, `#else` or `#endif` is sysl's only where the
// innermost group open is a sysl group opened in this block.
private in_text_block(d: Directive, text: string, line: usize, stack: *Buf[Frame], on: Buf[string]) -> bool
    val word = d.word
    val n = stack.len()
    val ours = n > 0 && stack.at(n - 1).in_block
    val texts = ours && stack.at(n - 1).text

    if word == "if"
        if read_condition(argument(text, d.at), d.at, "#if", on, symbols(), true).is_ok() then return true

        stack.push(Frame(line, all_taken(*stack), true, 0, true, true))
        return false

    if word == "ifdef" || word == "ifndef"
        stack.push(Frame(line, all_taken(*stack), true, 0, true, true))
        return false

    if word == "elif" || word == "else" || word == "endif"
        if ours && !texts then return true
        if word == "endif" && texts then stack.pop()

    false
end in_text_block

// A sysl group opened inside the text block that ends on line `closing` and is still open after it.
// The group is reported at its `#if`, with the block's last line named: gating a block's lines is
// something the block does, and a group reaching past it would gate code with the text's directives.
private crossing(src: Source, stack: Buf[Frame], closing: usize) -> Option[Diagnostic]
    for item in stack
        if item.in_block && !item.text
            return Some(fail_at(src, item.line, 1,
                s"this '#if' opens a group inside the text block that ends on line $closing, and the group has to close inside the block — add its '#endif' before line $closing"))

    None
end crossing

// Every symbol a condition may name, whatever the target.
//
// The set is **closed and derived**: the operating systems and processors the registry knows, plus
// the three system facts, the four floating-point ones, `thread_local` and the three address widths
// worth a name of their own, and nothing a project can add to. Derived so that a new
// system extends it by existing rather than by also being written down here, where the two could
// come to disagree.
//
// That it is closed is what lets a symbol nobody knows be refused, which is the whole reason to have
// a set rather than a predicate: a misspelling that read as false would gate code out of the build
// with nothing said, and silently missing code is the one failure this feature cannot have.
symbols() -> Buf[string]
    var out: Buf[string] = buf()
    val systems = all_os()
    val processors = all_cpus()

    for item in systems
        out.push(os_symbol(item))

    for item in processors
        out.push(cpu_symbol(item))

    out.push("hosted")
    out.push("posix")
    out.push("bsd")

    for item in fp_symbols()
        out.push(item)

    out.push("fma")
    out.push("fma_dp")
    out.push("thread_local")
    out.push("ptr16")
    out.push("ptr32")
    out.push("ptr64")
    out
end symbols

// The four facts about **floating point** a condition may ask: whether the machine has the
// registers (`fpu`), whether they hold a double (`fpu_dp`), and which float ABI passes a value
// (`hardfloat`, `softfp`). They are a fact of the whole target, not of the processor -- seven Arm
// rows share `thumb` and differ in exactly this -- and code that saves the registers (a `setjmp`, a
// context switch) has to know, because touching them where there are none faults.
fp_symbols() -> Buf[string]
    var out: Buf[string] = buf()

    out.push("fpu")
    out.push("fpu_dp")
    out.push("hardfloat")
    out.push("softfp")
    out
end fp_symbols

// The symbols that are **true** for a target. Everything in `symbols` and not in here is false;
// everything in neither is a mistake.
//
// `fma` and `fma_dp` say a fused multiply-add is one instruction at binary32 and at binary64 -- C's
// `FP_FAST_FMAF` and `FP_FAST_FMA` -- and are the machine's, so a directory cannot select on them.
//
// `thread_local` says a `@thread_local` is accepted here (`thread_local_accepted`), and is the one
// symbol that reads more than the target: on a bare AArch64 machine it is the root manifest's
// `codegen.thread_pointer` that decides, so every command settles the registers before it reads a
// condition.
//
// `ptr16`, `ptr32` and `ptr64` say an address is 16, 32 or 64 bits wide (`Target.pointer_bits`), so
// a type twice the width of `isize` -- a Forth double cell -- can be chosen without naming every
// processor. Every target answers exactly one. Like `fma` they are the machine's, so a directory
// cannot select on them.
defined(target: Target) -> Buf[string]
    var out = os_defined(target.os)

    out.push(cpu_symbol(target.cpu))

    if target.fp_registers() then out.push("fpu")
    if target.fp_double_registers() then out.push("fpu_dp")
    if target.hard_float_abi() then out.push("hardfloat")
    if target.soft_fp_abi() then out.push("softfp")
    if target.fused_single() then out.push("fma")
    if target.fused_double() then out.push("fma_dp")
    if thread_local_accepted(target) then out.push("thread_local")
    if target.pointer_bits() == 16 then out.push("ptr16")
    if target.pointer_bits() == 32 then out.push("ptr32")
    if target.pointer_bits() == 64 then out.push("ptr64")

    out
end defined

// The symbols an **operating system alone** settles, true for it and false for every other.
//
// This is the half a directory selects on, and the reason it is a function of a system rather than
// of a whole target: the walk that reads a tree has an operating system and no processor. Every one
// of these is also a `#if` symbol, because `defined` is this plus the processor -- the two places a
// source file can name a machine share a vocabulary, and here is where that stops being a claim and
// becomes an equation.
os_defined(os: Os) -> Buf[string]
    var out: Buf[string] = buf()

    out.push(os_symbol(os))

    if os_hosted(os) then out.push("hosted")
    if os_posix(os) then out.push("posix")
    if os_bsd(os) then out.push("bsd")

    out
end os_defined

// Every symbol a **directory** may select on -- the operating systems, plus the environment facts
// that are answerable without a processor.
//
// A processor symbol is deliberately not here: a directory is chosen by a walk that has no processor
// to ask, and source that varies by one is what `#if` is for.
directory_symbols() -> Buf[string]
    var out: Buf[string] = buf()
    val systems = all_os()

    for item in systems
        out.push(os_symbol(item))

    out.push("hosted")
    out.push("posix")
    out.push("bsd")
    out
end directory_symbols

// The whole vocabulary in one line, sorted, as a refusal names it.
symbols_listed() -> string = listed(symbols())

// A vocabulary in one line, sorted.
private listed(known: Buf[string]) -> string
    val sorted = sorted_strings(known)
    var out = ""

    for i in 0..<sorted.len()
        if i > 0 then out = out + ", "

        out = out + sorted.at(i)

    out
end listed

// The symbol a package's feature is named by in a condition: `server` is `feature_server`. The
// prefix keeps the two vocabularies apart, so a package cannot declare a feature called `linux` and
// gate on a word that means something else.
feature_symbol(name: string) -> string = "feature_" + name

// Whether a condition's word names a feature rather than a fact about the machine.
is_feature_symbol(word: string) -> bool = word.starts_with("feature_")

// Whether a condition's word names a `bool` option of the package, which is `option_<name>` and holds
// while the option is `true`. Like a feature's it is open: an option the manifest does not declare is
// false rather than refused.
is_option_symbol(word: string) -> bool = word.starts_with("option_")

// Whether a list of symbols holds one.
has(xs: Buf[string], s: string) -> bool
    for item in xs
        if item == s then return true

    false
end has

// -- reading a directive line ---------------------------------------------------------------------

// The words a directive line may open with, and the C spellings that are named rather than left to
// the grammar.
private is_directive_word(word: string) -> bool =
    word == "if" || word == "elif" || word == "else" || word == "endif" ||
        not_word_message(word).is_some()

// The C spellings sysl does not have, kept so that writing one is told what to write instead.
// Without this they fall through to the lexer as a stray `#` and a name, and the reader is left with
// a syntax error about a token rather than with the sentence they need.
private not_word_message(word: string) -> Option[string]
    if word == "ifdef"
        return Some("sysl has no '#ifdef' — a symbol is a fact about the target rather than something a build defines, so the test is written '#if <symbol>'")

    if word == "ifndef" then return Some("sysl has no '#ifndef' — write '#if !<symbol>'")
    if word == "elseif" then return Some("sysl spells this '#elif'")

    if word == "define"
        return Some(s"sysl has no '#define' — the symbols a condition may name are fixed by the target: ${symbols_listed()}")

    if word == "undef"
        return Some(s"sysl has no '#undef' — the symbols a condition may name are fixed by the target: ${symbols_listed()}")

    None
end not_word_message

// The directive a line carries, or nothing for an ordinary line.
//
// **A directive sits at the margin, column 1, and that is a rule rather than a convention.** It is
// what keeps the gate out of the channel the language reads block structure from: an indented `#if`
// would look like it takes part in an indentation it has nothing to do with, when in fact the line
// is gone before anything counts a column.
//
// What tells a directive from an annotation is the **sigil**, not the margin -- `#` gates lines, `@`
// says something about a declaration, and an annotation on a `module` header sits at column 1 too.
private directive_of(text: string) -> Option[Directive]
    if !text.starts_with("#") then return None

    val bs = text.bytes
    var i: usize = 1

    loop
        if i >= bs.len then break
        if !is_letter(bs[i]) then break

        i += 1

    val word = text[1..<i]

    if !is_directive_word(word) then return None

    // A word that reads as a name carrying on past the directive is left alone: `#iffy` is not `#if`
    // with `fy` after it, and recognizing it as one would turn a typo in an attribute's name into a
    // diagnostic about conditional compilation.
    if i < bs.len && (is_digit(bs[i]) || bs[i] == u8('_')) then return None

    Some(Directive(word, i + 1))
end directive_of

// What remains of a directive line after its word, with a trailing `//` comment dropped.
//
// A comment earns its place on these specifically: `#endif // linux` is how the reader of a long
// gated region is told which group just closed. There is nothing else on such a line for a `//` to
// be part of -- a condition has no strings in it -- so finding one is the whole of the work.
private argument(text: string, at: usize) -> string
    val rest = text[at - 1..<text.len]

    rest.index_of("//") match
        Some(n) -> rest[0..<n]
        None -> rest
end argument

// Refuses anything written after `#else` or `#endif`, neither of which takes an argument.
//
// Left unchecked, `#endif linux` -- C's old habit, and legal there -- would read as an `#endif` with
// the word quietly discarded, so the spelling most likely to arrive out of muscle memory would be
// the one thing here that failed silently.
private trailing(src: Source, line: usize, text: string, at: usize, word: string) -> Option[Diagnostic]
    val rest = argument(text, at)
    val bs = rest.bytes

    for i in 0..<bs.len
        if !is_blank(bs[i])
            return Some(fail_at(src, line, at + i,
                s"'#${word}' takes nothing after it, and '${rest.trim()}' is here"))

    None
end trailing

// -- the condition --------------------------------------------------------------------------------

// One token of a condition: what it is, what it says, and the column it was written at.
private struct CondTok
    kind: string
    text: string
    col: usize
end CondTok

// A condition being read, which is a token list and a position in it. `word` is what a complaint
// calls the place the condition was written (`#if`, or a manifest key), and `source` whether it gates
// a source file -- where a package's `feature_` symbols may be named as well as the closed set `known`.
private struct Cond
    word: string
    at: usize
    toks: Buf[CondTok]
    i: usize
    on: Buf[string]
    known: Buf[string]
    source: bool
end Cond

// What is wrong with a condition, and the column it is wrong at.
private struct CondFault
    col: usize
    message: string
end CondFault

// Whether a directive's condition holds for the symbols given, or what is wrong with it.
//
// **The condition is evaluated whether or not its branch could be taken**, so that a mistake in the
// half of a file this build is not compiling is still this build's problem. That is the one part of
// an inactive branch this pass checks, and it is the part most worth checking: the mistakes a
// condition can hold are exactly the ones that would otherwise gate code out with nothing said.
private condition(src: Source, line: usize, text: string, at: usize, word: string,
                  on: Buf[string]) -> Result[bool, Diagnostic]
    read_condition(argument(text, at), at, s"#$word", on, symbols(), true) match
        Ok(value) -> Ok(value)
        Err(fault) -> Err(fail_at(src, line, fault.col, fault.message))
end condition

// The symbols a dependency's `if` may name: everything a `#if` may, and `libc` -- the one capability
// that says what is linked under the program, which is what a dependency's own C collides with
// (`reference/packages.md § A dependency only some machines take`).
dependency_symbols() -> Buf[string]
    var out = symbols()

    out.push("libc")
    out
end dependency_symbols

// The symbols that are true for a machine as its project describes it, read by a dependency's `if`:
// what `#if` reads, and `libc` where the machine has a C library under the program.
dependency_defined(t: Target) -> Buf[string]
    var out = defined(t)

    if !t.lacks_capability("libc") then out.push("libc")

    out
end dependency_defined

// Whether a dependency's `if` holds for the symbols given, or what is wrong with it. The grammar and
// the checks are `#if`'s, so the two places a machine is asked about read one language; the
// vocabulary is `dependency_symbols`, and a feature is not in it -- `optional` is how a feature turns
// a dependency on.
dependency_condition(text: string, on: Buf[string]) -> Result[bool, string]
    if text.trim().is_empty()
        return Err("is empty — a condition names at least one fact of the machine, and a dependency " +
            "every machine takes is written without 'if'")

    read_condition(text, 0, "if", on, dependency_symbols(), false) match
        Ok(value) -> Ok(value)
        Err(fault) -> Err(s"is \"$text\", and ${fault.message}")
end dependency_condition

// The condition `arg` read against `on`, `at` being the column it starts at.
private read_condition(arg: string, at: usize, word: string, on: Buf[string], known: Buf[string],
                       source: bool) -> Result[bool, CondFault]
    val named = arg.trim()

    // A target's *name* is the thing a reader most plausibly reaches for and the one thing that
    // cannot be a symbol: it has a `-` in it, which no identifier carries. Left to the tokenizer they
    // are told a `-` is not an operator, which is true and no help.
    if target_named(named).is_some()
        return Err(CondFault(at + content_at(arg),
            s"'${named}' is a target's name rather than something a condition asks about — a condition asks about one fact of the machine at a time, so this is written '${replace_all(named, "-", " && ")}'"))

    var toks: Buf[CondTok] = buf()
    val bs = arg.bytes
    var i: usize = 0

    loop
        if i >= bs.len then break

        val b = bs[i]
        val col = at + i

        if is_blank(b)
            i += 1
        elif is_letter(b) || b == u8('_')
            var j = i

            loop
                if j >= bs.len then break
                if !is_letter(bs[j]) && !is_digit(bs[j]) && bs[j] != u8('_') then break

                j += 1

            toks.push(CondTok("name", arg[i..<j], col))
            i = j
        elif b == u8('&') && i + 1 < bs.len && bs[i + 1] == u8('&')
            toks.push(CondTok("&&", "&&", col))
            i += 2
        elif b == u8('|') && i + 1 < bs.len && bs[i + 1] == u8('|')
            toks.push(CondTok("||", "||", col))
            i += 2
        elif b == u8('!') || b == u8('(') || b == u8(')')
            toks.push(CondTok(arg[i..<i + 1], arg[i..<i + 1], col))
            i += 1
        else
            return Err(CondFault(col,
                s"a condition is built from symbols, '!', '&&', '||' and parentheses, and '${char_at(arg, i)}' is none of them"))

    var c = Cond(word, at, toks, 0, on, known, source)
    val value = cond_or(&c)?

    if c.i < c.toks.len()
        val extra = c.toks.at(c.i)

        return Err(CondFault(extra.col, s"the condition is complete before '${extra.text}'"))

    Ok(value)
end read_condition

// **Both sides are evaluated even where the result is already settled** -- this is a checker as much
// as an evaluator, and short-circuiting would let a misspelled symbol through whenever the other
// half of the condition happened to decide the answer.
private cond_or(c: *Cond) -> Result[bool, CondFault]
    var acc = cond_and(c)?

    loop
        if cond_kind(c) != "||" then break

        c.i += 1

        val rhs = cond_and(c)?

        acc = acc || rhs

    Ok(acc)
end cond_or

private cond_and(c: *Cond) -> Result[bool, CondFault]
    var acc = cond_unary(c)?

    loop
        if cond_kind(c) != "&&" then break

        c.i += 1

        val rhs = cond_unary(c)?

        acc = acc && rhs

    Ok(acc)
end cond_and

private cond_unary(c: *Cond) -> Result[bool, CondFault]
    if cond_kind(c) != "!" then return cond_atom(c)

    c.i += 1

    val value = cond_unary(c)?

    Ok(!value)
end cond_unary

private cond_atom(c: *Cond) -> Result[bool, CondFault]
    val kind = cond_kind(c)

    if kind == "" then return Err(CondFault(cond_end(c), s"'${c.word}' needs a condition after it"))

    val tok = c.toks.at(c.i)

    if kind == "name"
        c.i += 1

        // **The feature family is open where the target's symbols are closed**: a feature exists
        // because the manifest of the file being gated says so, so `feature_x` in a package that
        // declares no `x` is false rather than refused. A dependency's condition has no feature
        // family: `optional` is how a feature turns a dependency on.
        if c.source && !has(c.known, tok.text) && !is_feature_symbol(tok.text) && !is_option_symbol(tok.text)
            return Err(CondFault(tok.col,
                s"'${tok.text}' is not something a target says about itself — sysl knows ${listed(c.known)}. A feature this package's manifest declares is named '${feature_symbol(tok.text)}'"))

        if !c.source && !has(c.known, tok.text)
            return Err(CondFault(tok.col,
                s"'${tok.text}' is not something a dependency's condition can ask about the machine — it knows ${listed(c.known)}. A dependency a feature turns on is 'optional = true' and named by the feature"))

        return Ok(has(c.on, tok.text))

    if kind == "("
        c.i += 1

        val inner = cond_or(c)?

        if cond_kind(c) == ")"
            c.i += 1
            return Ok(inner)

        if cond_kind(c) == "" then return Err(CondFault(cond_end(c), "this '(' is never closed"))

        val next = c.toks.at(c.i)

        return Err(CondFault(next.col, s"this '(' wants a ')' before '${next.text}'"))

    Err(CondFault(tok.col, s"a condition needs a symbol here, and '${tok.text}' is what is written"))
end cond_atom

private cond_kind(c: *Cond) -> string
    if c.i >= c.toks.len() then return ""

    c.toks.at(c.i).kind
end cond_kind

// Where the condition ran out, for the errors that are about something missing rather than something
// written: past the last token there is, or at the argument itself when there are none.
private cond_end(c: *Cond) -> usize
    if c.toks.len() == 0 then return c.at

    val last = c.toks.at(c.toks.len() - 1)

    last.col + last.text.len
end cond_end

// -- the small mechanics --------------------------------------------------------------------------

private all_taken(stack: Buf[Frame]) -> bool
    for item in stack
        if !item.taken then return false

    true
end all_taken

// The same question about everything *enclosing* the innermost group, which is what an `#elif` and
// an `#else` ask: whether this group may contribute at all.
private outer_taken(stack: Buf[Frame]) -> bool
    if stack.len() == 0 then return true

    for i in 0..<stack.len() - 1
        if !stack.at(i).taken then return false

    true
end outer_taken

// A line as it was written, without its terminating newline and with the `\r` of a `\r\n` pair kept
// -- a file's line endings survive on the lines that survive.
private line_raw(src: Source, line: usize) -> string
    val start = src.line_span(line).start
    var stop = src.bytes.len

    if line < src.line_count() then stop = src.starts.at(line) - 1

    from_utf8_unchecked(src.bytes[start..<stop])
end line_raw

private fail_at(src: Source, line: usize, col: usize, message: string) -> Diagnostic =
    error(point(src.line_span(line).start + col - 1), message)

// Where a line's content begins, as an offset into it.
private content_at(text: string) -> usize
    val bs = text.bytes

    for i in 0..<bs.len
        if !is_blank(bs[i]) then return i

    0
end content_at

// The whole character an offset falls on, which is one byte for everything a condition may legally
// hold and more for the bytes it may not.
private char_at(text: string, i: usize) -> string
    val bs = text.bytes
    var n: usize = 1

    loop
        if i + n >= bs.len then break
        if bs[i + n] < u8(0x80) || bs[i + n] >= u8(0xC0) then break

        n += 1

    text[i..<i + n]
end char_at

private is_letter(b: u8) -> bool = (b >= u8('a') && b <= u8('z')) || (b >= u8('A') && b <= u8('Z'))

private is_digit(b: u8) -> bool = b >= u8('0') && b <= u8('9')

private is_blank(b: u8) -> bool = b == u8(' ') || b == u8('\t') || b == u8('\r')

private sorted_strings(xs: Buf[string]) -> Buf[string]
    var out: Buf[string] = buf()

    for value in xs
        var at = out.len()
        var placed = false

        for j in 0..<out.len()
            if !placed && before(value, out.at(j))
                at = j
                placed = true

        out.insert(at, value)

    out
end sorted_strings

private before(a: string, b: string) -> bool
    val x = a.bytes
    val y = b.bytes
    var n = x.len

    if y.len < n then n = y.len

    for i in 0..<n
        if x[i] != y[i] then return x[i] < y[i]

    x.len < y.len
end before
