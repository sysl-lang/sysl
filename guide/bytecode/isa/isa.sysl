// The instruction set two programs share: a stack machine's opcodes, the buffer a program is
// emitted into, and the reader that takes one apart again.
//
// This module exists to be depended on from both sides. A compiler writes bytes into a `Chunk` and
// a machine reads them out, and neither knows anything about the other — what they agree on is
// here, once, so that a change to an opcode's operand shape is a change to one file rather than to
// two that have to be kept in step by hand.
//
// The machine is a stack of integers with a fixed frame of variables beside it. An instruction is
// one byte, sometimes followed by an operand: a four-byte immediate, a one-byte variable slot, or
// a two-byte code address. Nothing is aligned and nothing is padded, which is the point of a
// bytecode — `width` is the only thing that knows how far one instruction reaches.

module isa

enum Op: u8
    Halt
    Push
    Load
    Store
    Print
    Neg
    Add
    Sub
    Mul
    Div
    Mod
    Lt
    Le
    Gt
    Ge
    Eq
    Ne
    Jmp
    Jz
end Op

// What follows an opcode in the code stream. Every question about instruction length, disassembly,
// and how far a decoder may read is answered from this one function, so an opcode that grows an
// operand cannot be half-taught to the machine.
enum Operand
    Bare
    Imm
    Slot
    Target
end Operand

operand(o: Op) -> Operand
    o match
        Push -> Imm
        Load -> Slot
        Store -> Slot
        Jmp -> Target
        Jz -> Target
        else Bare
end operand

// How many bytes one instruction occupies, its opcode included.
width(o: Op) -> usize
    operand(o) match
        Bare -> 1
        Imm -> 5
        Slot -> 2
        Target -> 3
end width

// The mnemonic a listing prints. Written as an exhaustive match rather than with an `else`, so
// adding an opcode is a compile error here until it is named.
name(o: Op) -> string
    o match
        Halt -> "halt"
        Push -> "push"
        Load -> "load"
        Store -> "store"
        Print -> "print"
        Neg -> "neg"
        Add -> "add"
        Sub -> "sub"
        Mul -> "mul"
        Div -> "div"
        Mod -> "mod"
        Lt -> "lt"
        Le -> "le"
        Gt -> "gt"
        Ge -> "ge"
        Eq -> "eq"
        Ne -> "ne"
        Jmp -> "jmp"
        Jz -> "jz"
end name

// ------------------------------------------------------------------------------------- the chunk

// How long a program may be and how many variables it may name.
const capacity: usize = 512

const max_slots: usize = 32

// A program: the bytes, how many of them there are, and how many variable slots the machine has to
// give it.
//
// **Emitting cannot fail.** A chunk that runs out of room sets `full` and drops what it was given,
// so the thousand emit calls a compiler makes need no error channel between them and the one place
// that cares asks once at the end. The alternative — a `Result` on every `byte` — would put a `?`
// on every line of the code generator to catch a condition that is the same condition each time.
struct Chunk
    code: [capacity]u8
    len: usize
    slots: usize
    full: bool

    empty() -> &Chunk
        var c: Chunk

        c
    end empty

    here(self) -> usize = self.len

    // The `return` is not a taste: an assignment is an expression, so a two-branch `if` whose
    // branches merely each end in one is checked as though those were its result, and `full = true`
    // against `len += 1` is a `bool` against a `usize`. Leaving early is what makes the branch a
    // statement again.
    byte(*self, b: u8)
        if self.len >= capacity
            self.full = true
            return

        self.code[self.len] = b
        self.len += 1
    end byte

    op(*self, o: Op)
        self.byte(u8(o))

    // Little-endian, two's complement, and masked at every step so the narrowing conversion is
    // total: `n >> 24` on a negative number carries the sign down, and `& 255` is what makes the
    // byte a byte again.
    imm(*self, n: int)
        self.byte(u8(n & 255))
        self.byte(u8((n >> 8) & 255))
        self.byte(u8((n >> 16) & 255))
        self.byte(u8((n >> 24) & 255))
    end imm

    slot(*self, s: usize)
        self.byte(u8(s))

    target(*self, t: usize)
        self.byte(u8(t & 255))
        self.byte(u8((t >> 8) & 255))
    end target

    // A jump is emitted before the code it jumps over exists, so its target is written as a zero
    // and overwritten here once the address is known. Out-of-range is silently ignored: a chunk
    // that has overflowed is already refused by whoever asks `full`, and a patch into the gap
    // beyond it has nothing to correct.
    patch(*self, at: usize, t: usize)
        if at + 1 < self.len
            self.code[at] = u8(t & 255)
            self.code[at + 1] = u8((t >> 8) & 255)
    end patch

    // The reading side. A byte that is no opcode is a `None` rather than a trap, because the whole
    // point of a decoder is that it is handed bytes nobody promised anything about.
    op_at(self, i: usize) -> Option[Op] = Op.try(self.code[i])

    imm_at(self, i: usize) -> int
        var low = int(self.code[i]) + int(self.code[i + 1]) * 256 + int(self.code[i + 2]) * 65536
        var high = int(self.code[i + 3])

        low + (if high >= 128 then high - 256 else high) * 16777216
    end imm_at

    slot_at(self, i: usize) -> usize = usize(self.code[i])

    target_at(self, i: usize) -> usize = usize(self.code[i]) + usize(self.code[i + 1]) * 256
end Chunk

// ------------------------------------------------------------------------------------- a listing

// A program as text, one instruction to a line, addresses in the left column so a jump's target
// can be read against the line it lands on.
//
// The listing stops where decoding does. A byte that is no opcode, or an operand that runs off the
// end of the chunk, is written as a `?` and ends the walk — a disassembler that guessed its way
// past a bad byte would print a plausible listing of a program that is not there.
disassemble(c: &Chunk) -> string
    var out = ""
    var pc: usize = 0

    while pc < c.len
        c.op_at(pc) match
            None ->
                out += f"${pc}%04d  ?\n"
                return out
            Some(o) ->
                if pc + width(o) > c.len
                    out += f"${pc}%04d  ${name(o)}%-5s ?\n"
                    return out

                out += line(c, pc, o) + "\n"
                pc += width(o)

    out
end disassemble

private line(c: &Chunk, pc: usize, o: Op) -> string
    var text = name(o)

    operand(o) match
        Bare -> f"${pc}%04d  ${text}%s"
        Imm -> f"${pc}%04d  ${text}%-5s ${c.imm_at(pc + 1)}%d"
        Slot -> f"${pc}%04d  ${text}%-5s ${c.slot_at(pc + 1)}%d"
        Target -> f"${pc}%04d  ${text}%-5s ${c.target_at(pc + 1)}%04d"
end line
