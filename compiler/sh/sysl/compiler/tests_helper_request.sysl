module sh.sysl.compiler
@tests

// What asking for a runtime helper costs as a program grows.
//
// **The check has to be no worse than linear in the helpers already asked for**, because a helper is
// named once per distinct type at the retain/release site that first needs it, and a program with
// many distinct counted types asks for many of them -- scanning the growing list of names already
// requested, once per ask, is quadratic in the number of distinct types a large program declares.
//
// The claim is a ratio rather than a bound, so it holds on a slow machine as well as a fast one: a
// program eight times larger may cost eight times as much to emit and not sixty-four times. How the
// two are measured under a loaded suite is `tests_lgr_linear_growth.sysl`'s.

import sysl.buf.{Buf, buf}

// `n` distinct struct types, each with a counted field, each walked through a function that forces
// a retain at its one call site -- so a distinct helper is requested once per type, and the program
// grows the requested list to `n` entries by the time it is done.
private helper_program(n: usize) -> string
    var lines: Buf[string] = buf()

    for i in 0..<n
        lines.push(s"struct T$i\n    name: string\nend T$i\n\n")
        lines.push(s"hold$i(p: T$i) -> string = p.name\n\n")

    lines.push("var got: string = \"\"\n\n")

    for i in 0..<n
        lines.push(s"var v$i = T$i(\"a\")\n")
        lines.push(s"got = hold$i(v$i)\n")

    var text = ""

    for line in lines
        text = text + line

    text
end helper_program

// One lowering of a program of `n` types, analysed once beforehand, as work to measure.
private helper_lowering(n: usize) -> &Fn() -> long
    val done = typed_of(helper_program(n))

    assert(done.reported.is_empty(), "the generated program is sound")

    val p = strip_tests(program_of(done, done.main_module))
    val promotions = check_escapes(done.an, p)
    val target = done.an.tables.target

    () -> processor_micros(() -> codegen_with_gaps(p, target, promotions))
end helper_lowering

@test("emitting a program with eight times as many distinct counted types costs about eight times as much, not sixty-four")
requesting_a_helper_is_not_quadratic()
    val g = growth_of(helper_lowering(300), helper_lowering(300 * GrowthFactor))

    assert(g.linear(), g.said("emitting the helpers of distinct counted types"))
end requesting_a_helper_is_not_quadratic
