{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "`", "close": "`", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"],
    ["`", "`"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(if|else if|for|while)\\b(?!.*\\b(then|do)\\s+[^/\\s]).*$|^\\s*(else|loop)\\s*(//.*)?$|^\\s*(struct|enum|trait|impl|union)\\b[^=]*$|^.*(->|=|\\bmatch|\\bthen|\\belse|\\bdo)\\s*(//.*)?$",
    "decreaseIndentPattern": "^\\s*(else|end)\\b"
  },
  "folding": {
    "offSide": true
  },
  "wordPattern": "`[^`\\n]+`|[A-Za-z_][A-Za-z0-9_]*|-?\\d[\\d_]*(\\.\\d[\\d_]*)?([eE][+-]?\\d+)?"
}
