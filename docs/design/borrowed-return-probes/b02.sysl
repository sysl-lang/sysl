// The same walk with no method: a field read out of the reference and a `match` on it. The
// reference page says a share read out of storage takes no count while nothing can move
// (memory.md § A share of something read out of storage …); compare b01's IR.
struct Node
    level: int
    kids: Option[Kids]

struct Kids
    nw: &Node
    ne: &Node
    sw: &Node
    se: &Node

leaf() -> &Node = Node(0, None)

walk(n: &Node) -> int
    n.kids match
        None -> 1
        Some(q) -> walk(q.nw) + walk(q.ne) + walk(q.sw) + walk(q.se)

val l = leaf()
val top: &Node = Node(1, Some(Kids(l, l, l, l)))

print(walk(top))
