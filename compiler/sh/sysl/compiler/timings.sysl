module sh.sysl.compiler

import sysl.env.get
import sysl.time.monotonic

// `SYSL_TIMINGS=1`: how long each phase of a compilation took, one line on standard error as each
// one ends -- `sysl: phase parse 182ms` -- so a build that is slow says where without a profiler.
// The compiler's own code keeps no frame pointers, so a sampler cannot walk its stacks; these lines
// are the instrument that can.
//
// A phase is measured from the end of the one before it, so the lines add up to the whole
// compilation with nothing counted twice. Unset, it costs one environment lookup per compilation.

private var timings_asked: int = -1
private var timings_since: long = 0

// Whether `SYSL_TIMINGS=1` was set, asked once.
private timings_on() -> bool
    if timings_asked < 0 then timings_asked = if get("SYSL_TIMINGS").unwrap_or("") == "1" then 1 else 0

    timings_asked == 1
end timings_on

// The clock started: the phases after it are measured from here.
phase_start()
    if timings_on() then timings_since = monotonic().us

// The phase called `name` ended now, and is said with how long it took since the last mark.
phase_done(name: string)
    if !timings_on() then return

    val now = monotonic().us

    eprints(s"sysl: phase $name ${(now - timings_since) / 1000}ms\n")
    timings_since = now
end phase_done
