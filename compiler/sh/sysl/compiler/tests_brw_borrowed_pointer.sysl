module sh.sysl.compiler
@tests

import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture
import sysl.text.Search

// **A trait's method borrows a raw pointer parameter for the call, as it does a slice**, by rule
// (`keeps.sysl`): a call through an object sees no body, so every implementation reached through one
// is held to letting the pointer go -- storing it, or handing it to something that keeps it, is
// refused where it gets out. Because it is verified, a pointer lent to a closure may go through a
// trait object.

private brw_outcome(text: string) -> (string, int)
    val root = make_temp_dir("sysl-brw-ptr").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", text).unwrap()

    val exe = s"$root/built"

    build_native_program(root, None, None, DefaultOptimization, Some(exe)) match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return (failure_text(why), -1)
        Ok(_) -> ()

    val said = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    said match
        Err(_) -> ("the program that was built could not be run", -1)
        Ok(out) -> (out.text + out.err.unwrap_or(""), shell_status(out.status))
end brw_outcome

private brw_prints(text: string, want: string)
    if xvr_no_library() then return

    val out = brw_outcome(text)

    assert_eq(out.0, want)
    assert_eq(out.1, 0)
end brw_prints

// Refused, saying each of `parts` -- the rule broken, and the source line it is broken on.
private brw_refuses(text: string, parts: []string)
    if xvr_no_library() then return

    val out = brw_outcome(text)

    assert_eq(out.1, -1, out.0)

    for part in parts
        assert(out.0.index_of(part).is_some(), out.0)
end brw_refuses

private brw_broken(how: string) -> string =
    s"'bump' keeps its parameter 'n' ($how), but a method of 'Bump' borrows its parameters for the call"

// A trait whose method takes a pointer.
private brw_bump(result: string) -> string = s"trait Bump\n    bump(*self, n: *int)$result\n\n"

// A cell handing its one field to a body for one call.
private brw_cell() -> string = raw"""
    struct Cell
        v: int

        with[R](*self, body: *int -> R) -> R = body(&self.v)

    """

private brw_adder() -> string = raw"""
    struct Adder
        by: int

    impl Bump for Adder
        bump(*self, n: *int)
            *n += self.by

    """

// -- a pointer a closure is lent may go through an object -------------------------------------------

@test("a pointer lent to a closure, passed through a trait object, is accepted")
brw_lent_through_a_promise()
    brw_prints(brw_bump("") + brw_adder() + brw_cell() + raw"""
        var c = Cell(1)
        var a = Adder(5)
        val b: *Bump = &a

        c.with((v) -> b.bump(v))
        c.with((v) -> b.bump(v))

        print(c.v)
        """, "11\n")

@test("an implementation that only reads and writes through a borrowed pointer is accepted")
brw_pointer_used_and_let_go()
    brw_prints(brw_bump("") + brw_adder() + raw"""
        var a = Adder(3)
        val b: *Bump = &a
        var x = 4

        b.bump(&x)

        print(x)
        """, "7\n")

// -- every implementation is held to it ---------------------------------------------------------------

@test("an implementation that stores a borrowed pointer in a field is refused where it stores it")
brw_pointer_kept_in_a_field()
    brw_refuses(brw_bump("") + raw"""
        struct Keeper
            held: *int

        impl Bump for Keeper
            bump(*self, n: *int)
                self.held = n

        var x = 3
        var k = Keeper(&x)
        val b: *Bump = &k
        var y = 9

        b.bump(&y)

        print(*k.held)
        """, [brw_broken("it is stored in 'self.held'"), "self.held = n"])

// Handing it back is not keeping it: the answer is lent for as long as the argument was, and the
// caller follows it as it follows the argument.
@test("one that hands it back is accepted")
brw_pointer_returned()
    brw_prints(brw_bump(" -> *int") + raw"""
        struct Echo
            calls: int

        impl Bump for Echo
            bump(*self, n: *int) -> *int
                self.calls += 1
                n

        var e = Echo(0)
        val b: *Bump = &e
        var y = 9

        print(*b.bump(&y))
        """, "9\n")

@test("one that stores it in a module variable is refused")
brw_pointer_kept_in_a_global()
    brw_refuses(brw_bump("") + raw"""
        static var spare = 0
        static var last: *int = &spare

        struct Logger
            calls: int

        impl Bump for Logger
            bump(*self, n: *int)
                last = n

        var l = Logger(0)
        val b: *Bump = &l
        var y = 9

        b.bump(&y)

        print(*last)
        """, [brw_broken("it is stored in 'last'"), "last = n"])

@test("and one that keeps a pointer it derived from it, into the storage it was lent")
brw_derived_pointer_kept()
    brw_refuses(raw"""
        struct Pair
            a: int
            b: int

        trait Bump
            bump(*self, n: *Pair)

        struct Keeper
            held: *int

        impl Bump for Keeper
            bump(*self, n: *Pair)
                self.held = &n.b

        var x = 3
        var k = Keeper(&x)
        val b: *Bump = &k
        var p = Pair(1, 2)

        b.bump(&p)
        """, [brw_broken("it is stored in 'self.held'"), "self.held = &n.b"])

@test("a pointer inside a struct parameter is held to the rule too")
brw_pointer_in_a_struct_kept()
    brw_refuses(raw"""
        struct Ref
            p: *int

        trait Take
            take(*self, r: Ref)

        struct Keeper
            held: *int

        impl Take for Keeper
            take(*self, r: Ref)
                self.held = r.p

        var x = 3
        var k = Keeper(&x)
        val t: *Take = &k
        var y = 9

        t.take(Ref(&y))
        """, ["'take' keeps its parameter 'r' (it is stored in 'self.held'), but a method of 'Take' " +
              "borrows its parameters", "self.held = r.p"])

@test("a generic trait's rule binds an implementation at the instance an object names")
brw_generic_trait_pointer_kept()
    brw_refuses(raw"""
        trait Hold[T]
            hold(*self, n: *T)

        struct Keeper
            held: *int

        impl Hold[int] for Keeper
            hold(*self, n: *int)
                self.held = n

        var x = 3
        var k = Keeper(&x)
        val h: *Hold[int] = &k
        var y = 9

        h.hold(&y)
        """, ["'hold' keeps its parameter 'n' (it is stored in 'self.held'), but a method of 'Hold",
              "self.held = n"])

// -- the receiver rule is unchanged -------------------------------------------------------------------

@test("a *self method passing a view of its receiver through a trait object is still accepted")
brw_receiver_view_through_an_object()
    brw_prints(raw"""
        trait Sink
            put(*self, bytes: []const u8)

        struct Counter
            n: usize

        impl Sink for Counter
            put(*self, bytes: []const u8)
                self.n += bytes.len

        struct Inner
            data: [4]u8

            feed(*self, s: *Sink)
                s.put(self.data[0..<4])

        struct Outer
            inner: Inner
            count: int

            invariant count >= 0

        var c = Counter(0)
        val s: *Sink = &c
        var o = Outer(Inner([1, 2, 3, 4]), 0)

        o.inner.feed(s)

        print(c.n)
        """, "4\n")
