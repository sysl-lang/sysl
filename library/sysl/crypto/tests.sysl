module sysl.crypto
@tests

import sysl.encoding.hex_string
import sysl.math.Bits

// What `sysl.crypto` claims, asserted in sysl.
//
// **The vectors are the published ones** — FIPS 180-4's own messages for the four digests, and
// RFC 4231's cases for HMAC. A hash tested on one input is a hash whose padding nothing has run, so
// the lengths below walk every boundary that matters: empty, one byte, the last byte that fits
// beside a 64-bit length field and the first that does not, a whole block either way, and the same
// again at the 128-byte block the wide pair uses.

// A message of a chosen length whose bytes are all different from one another for the first 256 —
// so a digest that is right by accident would have to be right about the order too.
private pattern(n: usize) -> []u8
    var m: []u8 = [0; n]

    for i in 0..<n do m[i] = u8((i * 7 + 3) & 255)

    m
end pattern

private repeated(b: u8, n: usize) -> []u8 = [b; n]

private counting(n: usize) -> []u8
    var m: []u8 = [0; n]

    for i in 0..<n do m[i] = u8(i + 1)

    m
end counting

// RFC 4231's seventh case, whose message is longer than a block for both widths.
private longer_message() -> []const u8 = "This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm.".bytes

// A digest of the same message handed over in pieces, which must be the digest of the whole.
private streamed[T: Word](s: Sha[T], chunk: []const u8, times: usize) -> string
    var h = s
    var out: []u8 = [0; 64]

    for i in 0..<times do h.update(chunk)

    h.finish(out[0..<h.dlen]).expect("a digest buffer sized from the hasher itself")

    hex_string(out[0..<h.dlen])
end streamed

private one_at_a_time[T: Word](s: Sha[T], data: []const u8) -> string
    var h = s
    var out: []u8 = [0; 64]

    for i in 0..<data.len do h.update(data[i..<i + 1])

    h.finish(out[0..<h.dlen]).expect("a digest buffer sized from the hasher itself")

    hex_string(out[0..<h.dlen])
end one_at_a_time

private w32(x: u32) -> string = f"$x%08x"
private w64(x: u64) -> string = f"$x%016x"

// What a hasher said when it refused.
private why(r: Result[unit, Fault]) -> string = r.expect_err("a hasher that was supposed to refuse").describe()

// How many places two strings of the same length differ in.
private apart(a: string, b: string) -> usize
    var n: usize = 0

    for i in 0..<a.len
        if a[i] != b[i] then n += 1

    n
end apart

private abc() -> []const u8 = "abc".bytes
private alpha448() -> []const u8 = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq".bytes
private alpha896() -> []const u8 = "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu".bytes


@test("the four digests of one message")
the_four_digests_of_abc()
    assert_eq(hex_string(sha224(abc())), "23097d223405d8228642a477bda255b32aadbce4bda0b3f7e36c9da7")
    assert_eq(hex_string(sha256(abc())), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    assert_eq(hex_string(sha384(abc())), "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7")
    assert_eq(hex_string(sha512(abc())), "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")
end the_four_digests_of_abc


@test("the two messages FIPS 180-4 uses")
the_standard_messages()
    assert_eq(hex_string(sha224(alpha448())), "75388b16512776cc5dba5da1fd890150b0c6455cb4f58b1952522525")
    assert_eq(hex_string(sha256(alpha448())), "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1")
    assert_eq(hex_string(sha384(alpha448())), "3391fdddfc8dc7393707a65b1b4709397cf8b1d162af05abfe8f450de5f36bc6b0455a8520bc4e6f5fe95b1fe3c8452b")
    assert_eq(hex_string(sha512(alpha448())), "204a8fc6dda82f0a0ced7beb8e08a41657c16ef468b228a8279be331a703c33596fd15c13b1b07f9aa1d3bea57789ca031ad85c7a71dd70354ec631238ca3445")
    assert_eq(hex_string(sha224(alpha896())), "c97ca9a559850ce97a04a96def6d99a9e0e0e2ab14e6b8df265fc0b3")
    assert_eq(hex_string(sha256(alpha896())), "cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1")
    assert_eq(hex_string(sha384(alpha896())), "09330c33f71147e83d192fc782cd1b4753111b173b3b05d22fa08086e3b0f712fcc7c71a557e2db966c3e9fa91746039")
    assert_eq(hex_string(sha512(alpha896())), "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909")
end the_standard_messages

@test("padding at every boundary, both block sizes")
padding_at_every_boundary()
    var p0 = pattern(0)
    assert_eq(hex_string(sha224(p0)), "d14a028c2a3a2bc9476102bb288234c415a2b01f828ea62ac5b3e42f")
    assert_eq(hex_string(sha256(p0)), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    assert_eq(hex_string(sha384(p0)), "38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b")
    assert_eq(hex_string(sha512(p0)), "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e")
    var p1 = pattern(1)
    assert_eq(hex_string(sha224(p1)), "15ebd4b8fdfc6905ea002a3efcc8faa71954739ee62bbbf16836eb5c")
    assert_eq(hex_string(sha256(p1)), "084fed08b978af4d7d196a7446a86b58009e636b611db16211b65a9aadff29c5")
    assert_eq(hex_string(sha384(p1)), "8a6c69af6fb6247635f837958446fb8f10e39bd5fbc244f7e635176339a3be614f6394247f01dbe1126c178c7bd48cb5")
    assert_eq(hex_string(sha512(p1)), "e45bf5817ddf94aa2f7a407071f0eedc6beb98f768b4cd33d1176d44d1563a45a5d7212290eb7670c6786b13591aedac86478993895e8b24e612014abaa6ba04")
    var p55 = pattern(55)
    assert_eq(hex_string(sha224(p55)), "703a7d6e61c83903b5db54ddf6dda2268211b47c90bbdac2ed306d8a")
    assert_eq(hex_string(sha256(p55)), "e7313d333c272e639f790978283f9eb392e843d0f29b7016828bb1daa4aac70b")
    assert_eq(hex_string(sha384(p55)), "fc2728f452750d08b5dbad1aea53202e7fc19c06894d13e36c433b0444a899277c49f16e0577c03db0f0605578836ef6")
    assert_eq(hex_string(sha512(p55)), "14fd424b1fcadee624da946ab03f7e1def7c0d6e00f689594319881a26ff30b875ba4c622ac13100c8cc784c9c2eb23159aecbb4a02e3999062f551193e2b256")
    var p56 = pattern(56)
    assert_eq(hex_string(sha224(p56)), "850fef35478d7a94a417713dbded4a39c18be2b40e6f20f47066d306")
    assert_eq(hex_string(sha256(p56)), "4324d65f3c103567f5589c710bc08f8523f929a9272e3af36fc968e52abc6c27")
    assert_eq(hex_string(sha384(p56)), "6c969a865f38d2eaac60b7963a84c97ba27bcb76e589cbe1e2e89ead6aee4ad0337a4268f054be49c604ddd99692036d")
    assert_eq(hex_string(sha512(p56)), "480fa85be41ef55a41208ca28ffc8743c91cf7d24758defe6f95bfb16de614fc86b701034896b047dd571de4318853d80e0809df162f1752cb26da6ddb94a0dd")
    var p63 = pattern(63)
    assert_eq(hex_string(sha224(p63)), "246a939bfdd1eedb1ad51b53a250d197b5752aab09580b7f1df50df7")
    assert_eq(hex_string(sha256(p63)), "81c80242132f230c3bd41b3e63bbcff16107339549214a99614ff26664625055")
    assert_eq(hex_string(sha384(p63)), "be67a9a1162c1d97f183980dc811f4f4f835b8b850eb32ecbf87397b26369bc6646a8f2234940dcff142b627c8e21ebb")
    assert_eq(hex_string(sha512(p63)), "ecd42a703a4e93e163d60d55e3785b1a763838b0351bc2e6f7c94b4bfb24f9aa15da5d744ebcebe11f0fc4315d45ba3a047b6e60e07448357f2795bf34b73502")
    var p64 = pattern(64)
    assert_eq(hex_string(sha224(p64)), "e480c1c21ffd3f109fc0cde0daf967c748932b64f8e259d98db17420")
    assert_eq(hex_string(sha256(p64)), "39e3d7b6b5d075d37d053ad89b24b41bef4f3c29760c84447cab3f3be1882241")
    assert_eq(hex_string(sha384(p64)), "99d26430f561864c2f7d90b68650b960c86c85d6bf7f54ceeee404bdd59663a7f05588b5c750b862a2a24f6a9ad4c050")
    assert_eq(hex_string(sha512(p64)), "8f3cc30b3fb5bf963688a46488249248ac2c67f0f85a145233c6c1e3c16dcd1df634c07d1d31da02576f65b9cf64e1c3fdb318b689b8a14e2e9552bcf30fb133")
    var p65 = pattern(65)
    assert_eq(hex_string(sha224(p65)), "574507bf89b5d3a0b5dcf4a684a645f27f058f3b11fde279d5b0e462")
    assert_eq(hex_string(sha256(p65)), "aacca6ff74fdbb296d165a45cecfa04e5127bc008770fbbdd48006f2d2fae95e")
    assert_eq(hex_string(sha384(p65)), "cada16d798ec25243470f7827eb89a2402d52680b092dffc0f59f5a919e5058aebf7ad79dba85c61b179d23534d7c855")
    assert_eq(hex_string(sha512(p65)), "22050d1b2c5bd016c4b04c3e84f513ffbbbc057f83dc9ab196fee6684e5ee19d98b84c6538b3c5e1fc67dbc484e9d0a198254e41d0fa0cf5106991e106632419")
    var p111 = pattern(111)
    assert_eq(hex_string(sha224(p111)), "5d5ba2469a7db3e3d5b622bdefbb8fef5582222b0f3dd41db4b62075")
    assert_eq(hex_string(sha256(p111)), "67d9492e628fd376e0b2efec8ca2b99b123e202cf620deb270728df979b2f73e")
    assert_eq(hex_string(sha384(p111)), "341388a9dc2275074e90cf394323761919761c805fd9e370977c9966a0e8c81a52135f02577670b0071638a4a26dbc31")
    assert_eq(hex_string(sha512(p111)), "68cffa6d0d76f309c9ce0d35280939f8e25990c43b7b086ccdf709be35b07d4ddba599541ff2b1c19d34ea49aeafb9659adb7ac3c0b078bb30a22d57fc6687ef")
    var p112 = pattern(112)
    assert_eq(hex_string(sha224(p112)), "df564afcb13bf4a0b08d0d3132418ad63f523107e6003f3506167a5b")
    assert_eq(hex_string(sha256(p112)), "96b928cff8528dbb99602c709a65b846cb6467acb8b722f0d758e4dc27bfc508")
    assert_eq(hex_string(sha384(p112)), "619cc5d06138526d70659eccf602d197e63e1050e22039a7feb40a30a5b2b08fb03729e291df12f8c576e6f1cd8af22a")
    assert_eq(hex_string(sha512(p112)), "d0865c524d1dddf7c23b799c413f5adcd7caefd3f66a9b49750ec81066012c25a8bcf94ddea6dc525691673097ca40e0101e897fc97218cfdb0704084e2bef4b")
    var p119 = pattern(119)
    assert_eq(hex_string(sha224(p119)), "6c9c99e7d1090cb995200ccc9fc757a4383d3a1004cc36bc266c7947")
    assert_eq(hex_string(sha256(p119)), "9ce7368e4daf32341631b492e80359dc9f594b48453cd0dd5bf0b19279cc177e")
    assert_eq(hex_string(sha384(p119)), "9c284d266fc91c33a7f6ecbb0326646b3ed15cc33fd8bf968267c21991ca1a434dd65c64ee22c7dd6f5423950f605560")
    assert_eq(hex_string(sha512(p119)), "236bdd7f38a611b5014b239245c381ae5d20a96f1e5b3178227c00056b7fa8c44ef54880085d82b7e20cd65f2bfda1326696c3f94a6a5bad0cb5ce289aa46167")
    var p120 = pattern(120)
    assert_eq(hex_string(sha224(p120)), "d733ebb80612c4699bfca3061aab0cd9e138ef73aecf1d0f23e75340")
    assert_eq(hex_string(sha256(p120)), "7836b787757e95e58b3ca5aec90b1b004e8deba1e50e9675af9cabf1a13a04b5")
    assert_eq(hex_string(sha384(p120)), "96faef865acb7c55ae34422444b4380e520de69f373ddb14c7ee2420c3f93cc220fca9952c0a4fe9dbfddf350ac40127")
    assert_eq(hex_string(sha512(p120)), "4bd16fefaa35cc2df9fbb8ff379ec04a4070ffd5d4992574af239fa175534df87cbedceeb96be08e15090a78b83a328a2900c5411683ab47bab914591048548f")
    var p127 = pattern(127)
    assert_eq(hex_string(sha224(p127)), "f2d23206c9419be75e54c12e79b49903565a9240f09d0bf15c548ed4")
    assert_eq(hex_string(sha256(p127)), "a8d23e75d936f303d248888d9b165ee543f4cbafcad3c9dd2a79bd84faa11d07")
    assert_eq(hex_string(sha384(p127)), "f8234ab81f5f9641c656680825a9bbb3c2616bcc80b65d5e479a4d96742e1b8742330c9e8256ef5f03caa932487044ca")
    assert_eq(hex_string(sha512(p127)), "e0b6a20f1c0c88970a9340152cd5a1c1ecf3d3b8de55102741879438079473540133b812706e5dbec322c8c9523b6fc8c6d16ee626e87ad5fe3d2916afedc369")
    var p128 = pattern(128)
    assert_eq(hex_string(sha224(p128)), "6df983e89c8c13cecdfb5f16fc67792ae3c4d062df69124d889a396f")
    assert_eq(hex_string(sha256(p128)), "d2742f1f4ac6bb7ca2b239ee18402ba8b3f9f8e652d2a72973c2b9ba11c08cf6")
    assert_eq(hex_string(sha384(p128)), "e8480e9c4dd90f88104a79cbaccec48edbd798a142b4f241d726dc252f1502350e824c7d18dadd59d7d716919fb8f9bf")
    assert_eq(hex_string(sha512(p128)), "99b16f17aa0b969a5b8f08f367719d516e330ccd2660b6f0688ec031dbc783de50a1cd185a2568dba75070a2403d17d4741d163578515dfd2ff756ddfe4d47b1")
    var p129 = pattern(129)
    assert_eq(hex_string(sha224(p129)), "cdb66bc3b48b8c446ba9e6220d9f9c25e2ed612094901834cde92dc6")
    assert_eq(hex_string(sha256(p129)), "307f8fc2c1622b92762e818d39a185d4d667ad49a4b07ceae1f4afa008a93ec4")
    assert_eq(hex_string(sha384(p129)), "430173387764874661acba1e914e50f6d0fbac534809e859b1da4396fad3d5f24c25c6a2d02486d8fbda3994713d981a")
    assert_eq(hex_string(sha512(p129)), "a1556e29185778aa5991e34b8884c840d589f0fbb4b8ed590e51e9ac4eb03a008125000db2671f8fe7f485b59a77b518670078ecb41a54b4cd02a7f1d2ca4c6d")
    var p200 = pattern(200)
    assert_eq(hex_string(sha224(p200)), "67e6d447872d6de5f0a53915ac4e88b60f08895e33f8453500d5bd30")
    assert_eq(hex_string(sha256(p200)), "2c7e18c942ef065b526a2d4e5546283749cd3ddfb51d8fc71f42717363685f46")
    assert_eq(hex_string(sha384(p200)), "8deb83535fa35d2f493c6c3695b1057b19232d2f531a0d398d2b958413855aa1594b6bcca0ddcbd24a981330a7ff1cc1")
    assert_eq(hex_string(sha512(p200)), "cca3c0276046ef9f2897bdfc3ec330f77f4959914b1462bd581b232ddb3e9aa98acf5f5a2b21c7f49d2e43721daa61a2b5cee6af6052dfeb766e66ddb0d1719c")
end padding_at_every_boundary


@test("RFC 4231's keyed-hash vectors")
keyed_hashing()
    var hk0 = repeated(0x0b, 20)
    var hm0 = "Hi There".bytes
    assert_eq(hex_string(hmac224(hk0, hm0)), "896fb1128abbdf196832107cd49df33f47b4b1169912ba4f53684b22")
    assert_eq(hex_string(hmac256(hk0, hm0)), "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7")
    assert_eq(hex_string(hmac384(hk0, hm0)), "afd03944d84895626b0825f4ab46907f15f9dadbe4101ec682aa034c7cebc59cfaea9ea9076ede7f4af152e8b2fa9cb6")
    assert_eq(hex_string(hmac512(hk0, hm0)), "87aa7cdea5ef619d4ff0b4241a1d6cb02379f4e2ce4ec2787ad0b30545e17cdedaa833b7d6b8a702038b274eaea3f4e4be9d914eeb61f1702e696c203a126854")
    var hk1 = "Jefe".bytes
    var hm1 = "what do ya want for nothing?".bytes
    assert_eq(hex_string(hmac224(hk1, hm1)), "a30e01098bc6dbbf45690f3a7e9e6d0f8bbea2a39e6148008fd05e44")
    assert_eq(hex_string(hmac256(hk1, hm1)), "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")
    assert_eq(hex_string(hmac384(hk1, hm1)), "af45d2e376484031617f78d2b58a6b1b9c7ef464f5a01b47e42ec3736322445e8e2240ca5e69e2c78b3239ecfab21649")
    assert_eq(hex_string(hmac512(hk1, hm1)), "164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737")
    var hk2 = repeated(0xaa, 20)
    var hm2 = repeated(0xdd, 50)
    assert_eq(hex_string(hmac224(hk2, hm2)), "7fb3cb3588c6c1f6ffa9694d7d6ad2649365b0c1f65d69d1ec8333ea")
    assert_eq(hex_string(hmac256(hk2, hm2)), "773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe")
    assert_eq(hex_string(hmac384(hk2, hm2)), "88062608d3e6ad8a0aa2ace014c8a86f0aa635d947ac9febe83ef4e55966144b2a5ab39dc13814b94e3ab6e101a34f27")
    assert_eq(hex_string(hmac512(hk2, hm2)), "fa73b0089d56a284efb0f0756c890be9b1b5dbdd8ee81a3655f83e33b2279d39bf3e848279a722c806b485a47e67c807b946a337bee8942674278859e13292fb")
    var hk3 = counting(25)
    var hm3 = repeated(0xcd, 50)
    assert_eq(hex_string(hmac224(hk3, hm3)), "6c11506874013cac6a2abc1bb382627cec6a90d86efc012de7afec5a")
    assert_eq(hex_string(hmac256(hk3, hm3)), "82558a389a443c0ea4cc819899f2083a85f0faa3e578f8077a2e3ff46729665b")
    assert_eq(hex_string(hmac384(hk3, hm3)), "3e8a69b7783c25851933ab6290af6ca77a9981480850009cc5577c6e1f573b4e6801dd23c4a7d679ccf8a386c674cffb")
    assert_eq(hex_string(hmac512(hk3, hm3)), "b0ba465637458c6990e5a8c5f61d4af7e576d97ff94b872de76f8050361ee3dba91ca5c11aa25eb4d679275cc5788063a5f19741120c4f2de2adebeb10a298dd")
    var hk4 = repeated(0xaa, 131)
    var hm4 = "Test Using Larger Than Block-Size Key - Hash Key First".bytes
    assert_eq(hex_string(hmac224(hk4, hm4)), "95e9a0db962095adaebe9b2d6f0dbce2d499f112f2d2b7273fa6870e")
    assert_eq(hex_string(hmac256(hk4, hm4)), "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54")
    assert_eq(hex_string(hmac384(hk4, hm4)), "4ece084485813e9088d2c63a041bc5b44f9ef1012a2b588f3cd11f05033ac4c60c2ef6ab4030fe8296248df163f44952")
    assert_eq(hex_string(hmac512(hk4, hm4)), "80b24263c7c1a3ebb71493c1dd7be8b49b46d1f41b4aeec1121b013783f8f3526b56d037e05f2598bd0fd2215d6a1e5295e64f73f63f0aec8b915a985d786598")
    var hk5 = repeated(0xaa, 131)
    var hm5 = longer_message()
    assert_eq(hex_string(hmac224(hk5, hm5)), "3a854166ac5d9f023f54d517d0b39dbd946770db9c2b95c9f6f565d1")
    assert_eq(hex_string(hmac256(hk5, hm5)), "9b09ffa71b942fcb27635fbcd5b0e944bfdc63644f0713938a7f51535c3a35e2")
    assert_eq(hex_string(hmac384(hk5, hm5)), "6617178e941f020d351e2f254e8fd32c602420feb0b8fb9adccebb82461e99c5a678cc31e799176d3860e6110c46523e")
    assert_eq(hex_string(hmac512(hk5, hm5)), "e37b6a775dc87dbaa4dfa9f96e5e3ffddebd71f8867289865df5a32d20cdc944b6022cac3c4982b10d5eeb55c3e4de15134676fb6de0446065c97440fa8c6a58")
end keyed_hashing

@test("the same bytes, differently divided")
streaming_agrees_with_one_call()
    var p200 = pattern(200)

    assert_eq(one_at_a_time(new_sha224().inner, abc()), hex_string(sha224(abc())))
    assert_eq(one_at_a_time(new_sha256().inner, abc()), hex_string(sha256(abc())))
    assert_eq(one_at_a_time(new_sha384().inner, abc()), hex_string(sha384(abc())))
    assert_eq(one_at_a_time(new_sha512().inner, abc()), hex_string(sha512(abc())))
    assert_eq(one_at_a_time(new_sha224().inner, p200), hex_string(sha224(p200)))
    assert_eq(one_at_a_time(new_sha256().inner, p200), hex_string(sha256(p200)))
    assert_eq(one_at_a_time(new_sha384().inner, p200), hex_string(sha384(p200)))
    assert_eq(one_at_a_time(new_sha512().inner, p200), hex_string(sha512(p200)))
end streaming_agrees_with_one_call

@test("a million bytes in a thousand pieces")
a_million_bytes()
    var thousand_a = repeated(97, 1000)

    assert_eq(streamed(new_sha224().inner, thousand_a, 1000), "20794655980c91d8bbb4c1ea97618a4bf03f42581948b2ee4ee7ad67")
    assert_eq(streamed(new_sha256().inner, thousand_a, 1000), "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0")
    assert_eq(streamed(new_sha384().inner, thousand_a, 1000), "9d0e1809716474cb086e834e310a4a1ced149e9c00f248527972cec5704c2a5b07b8b3dc38ecc4ebae97ddd87f3d8985")
    assert_eq(streamed(new_sha512().inner, thousand_a, 1000), "e718483d0ce769644e2e42c7bc15b4638e1f98b13b2044285632a803afa973ebde0ff244877ea60a4cb0432ce577c31beb009c5c2c49aa2e4eadb217ad8cc09b")
end a_million_bytes

@test("the pieces both widths are built from")
the_word_primitives()
    var x32: u32 = 0x12345678
    var x64 = 0x0123456789abcdefu64

    assert_eq(w32(x32.rotate_right(4)), "81234567")
    assert_eq(w32(x32.rotate_right(28)), "23456781")
    assert_eq(w64(x64.rotate_right(8)), "ef0123456789abcd")
    assert_eq(w64(x64.rotate_right(56)), "23456789abcdef01")
    assert_eq(w32(x32.rotate_right(4).rotate_right(28)), w32(x32))

    // The two amounts a hand-rolled `(x >> n) | (x << (bits - n))` could not answer: zero shifts by
    // the whole width, and a whole turn is the same shift once the amount has been reduced.
    assert_eq(w32(x32.rotate_right(0)), w32(x32))
    assert_eq(w32(x32.rotate_right(32)), w32(x32))

    assert_eq(f"${top_byte(x32)}%02x", "12")
    assert_eq(f"${top_byte(x64)}%02x", "01")
    assert_eq(w32(ch(0xf0f0f0f0u32, 0xaaaaaaaau32, 0x55555555u32)), "a5a5a5a5")
    assert_eq(w64(ch(0xf0f0f0f0f0f0f0f0u64, 0xaaaaaaaaaaaaaaaau64, 0x5555555555555555u64)), "a5a5a5a5a5a5a5a5")
    assert_eq(w32(maj(0xff00ff00u32, 0x00ff00ffu32, 0xffff0000u32)), "ffff0000")
    assert_eq(w64(maj(0xff00ff00ff00ff00u64, 0x00ff00ff00ff00ffu64, 0xffffffff00000000u64)), "ffffffff00000000")
    assert_eq(w32(maj(x32, x32, x32)), "12345678")
    assert_eq(w32(ch(0u32, x32, 0xaabbccddu32)), "aabbccdd")
end the_word_primitives

@test("the mixing functions, at both widths")
the_mixing_functions()
    var one32: u32 = 1
    var one64: u64 = 1
    var x64 = 0x0123456789abcdefu64

    assert_eq(w32(one32.ssig0()), "02004000")
    assert_eq(w32(one32.ssig1()), "0000a000")
    assert_eq(w32(one32.bsig0()), "40080400")
    assert_eq(w32(one32.bsig1()), "04200080")
    assert_eq(w64(one64.ssig0()), "8100000000000000")
    assert_eq(w64(one64.ssig1()), "0000200000000008")
    assert_eq(w64(one64.bsig0()), "0000001042000000")
    assert_eq(w64(one64.bsig1()), "0004400000800000")
    assert_eq(w32(0xdeadbeefu32.ssig0()), "abd31b0b")
    assert_eq(w32(0xdeadbeefu32.bsig1()), "345e14a3")
    assert_eq(w64(x64.ssig0()), "6f92c77c6c4f1aa1")
    assert_eq(w64(x64.bsig1()), "7703112333475567")
end the_mixing_functions

// The four facts about the width, asked of the width. No word is in hand for any of these, which is
// the whole point of their having no receiver.
@test("what a width answers with no word in hand")
the_width_answers_for_itself()
    assert_eq(w32(u32.round_key(0)), "428a2f98")
    assert_eq(w32(u32.round_key(63)), "c67178f2")
    assert_eq(w64(u64.round_key(0)), "428a2f98d728ae22")
    assert_eq(w64(u64.round_key(79)), "6c44198c4a475817")
    assert_eq(u32.word_rounds(), 64)
    assert_eq(u64.word_rounds(), 80)
    assert_eq(u32.word_bits(), 32)
    assert_eq(u64.word_bits(), 64)
    assert_eq(w32(u32.zero()), "00000000")
    assert_eq(w64(u64.zero()), "0000000000000000")
end the_width_answers_for_itself

@test("a digest is bytes, and its length is in its type")
a_digest_is_bytes()
    assert_eq(sha224(abc()).len, 28)
    assert_eq(sha256(abc()).len, 32)
    assert_eq(sha384(abc()).len, 48)
    assert_eq(sha512(abc()).len, 64)

    // The truncated pair are not prefixes of the untruncated ones — which is what the published
    // initial values for SHA-224 and SHA-384 are chosen to guarantee.
    assert(hex_string(sha256(abc()))[0..<56] != hex_string(sha224(abc())))
    assert(hex_string(sha512(abc()))[0..<96] != hex_string(sha384(abc())))
end a_digest_is_bytes

@test("one flipped bit moves almost every nibble")
the_avalanche()
    var p64 = pattern(64)
    var flipped = pattern(64)

    flipped[0] ^= 1

    assert_eq(p64[0] ^ flipped[0], 1)
    assert_eq(apart(hex_string(sha256(p64)), hex_string(sha256(flipped))), 63)
    assert_eq(apart(hex_string(sha512(p64)), hex_string(sha512(flipped))), 118)
end the_avalanche

@test("what a keyed hash distinguishes")
the_key_and_the_message_both_matter()
    var padded_key = repeated(0, 64)

    padded_key[0] = 107

    // A short key is that key padded with zeroes to a block, so the two spellings agree.
    assert_eq(hex_string(hmac256("k".bytes, abc())), hex_string(hmac256(padded_key, abc())))

    assert(hex_string(hmac256(repeated(0xaa, 64), abc())) != hex_string(hmac256(repeated(0xaa, 65), abc())))
    assert(hex_string(hmac256("k1".bytes, abc())) != hex_string(hmac256("k2".bytes, abc())))
    assert(hex_string(hmac256("k".bytes, abc())) != hex_string(hmac256("k".bytes, alpha448())))
    assert(hex_string(hmac256("".bytes, abc())) != hex_string(sha256(abc())))
end the_key_and_the_message_both_matter

@test("what a hasher refuses")
what_a_hasher_refuses()
    var unstarted: Sha[u32]
    var eight: []u8 = [0; 8]
    var thirtytwo: []u8 = [0; 32]
    var thirtyone: []u8 = [0; 31]

    assert_eq(why(unstarted.finish(eight)), "this hasher was never given its initial values")

    var cramped = new_sha256()

    assert_eq(why(cramped.finish(thirtyone)), "the digest does not fit in the space provided")
    assert_eq(thirtyone[0], 0)

    var roomy = new_sha256()

    assert(roomy.finish(thirtytwo).is_ok())
    assert_eq(hex_string(thirtytwo), hex_string(sha256("".bytes)))

    var wide = new_sha512()

    assert_eq(why(wide.finish(thirtytwo)), "the digest does not fit in the space provided")
end what_a_hasher_refuses

@test("an HMAC refuses what its hasher would")
what_an_hmac_refuses()
    var unstarted: Sha[u32]
    var tag: []u8 = [0; 32]
    var cramped: []u8 = [0; 31]

    assert_eq(why(hmac(unstarted, "k".bytes, abc(), tag)), "this hasher was never given its initial values")
    assert_eq(why(hmac(new_sha256().inner, "k".bytes, abc(), cramped)), "the digest does not fit in the space provided")
end what_an_hmac_refuses

// The four hashers are the public surface, and the generic behind them is not: a program reaches
// `Sha256`, never `Sha[u32]`, and never names `Word` at all.
@test("a concrete hasher streams, and copying one copies the hash in progress")
the_concrete_hashers()
    var h = new_sha256()
    var out: [32]u8

    h.update("a".bytes)
    h.update("b".bytes)
    h.update("c".bytes)
    h.finish(out[0..<32]).expect("a digest buffer of the right size")

    assert_eq(hex_string(out), hex_string(sha256("abc".bytes)))

    // A shared prefix hashed once and finished two ways — which is what makes the hasher a value
    // worth having rather than a detail of the one-shot form.
    var prefix = new_sha256()

    prefix.update("abc".bytes)

    var left = prefix
    var right = prefix
    var lo: [32]u8
    var ro: [32]u8

    left.update("d".bytes)
    right.update("e".bytes)
    left.finish(lo[0..<32]).expect("a digest buffer of the right size")
    right.finish(ro[0..<32]).expect("a digest buffer of the right size")

    assert_eq(hex_string(lo), hex_string(sha256("abcd".bytes)))
    assert_eq(hex_string(ro), hex_string(sha256("abce".bytes)))
end the_concrete_hashers

@test("each width's hasher agrees with its one-shot digest")
each_hasher_agrees()
    var a = new_sha224()
    var b = new_sha384()
    var c = new_sha512()
    var oa: [28]u8
    var ob: [48]u8
    var oc: [64]u8

    a.update("abc".bytes)
    b.update("abc".bytes)
    c.update("abc".bytes)
    a.finish(oa[0..<28]).expect("a digest buffer of the right size")
    b.finish(ob[0..<48]).expect("a digest buffer of the right size")
    c.finish(oc[0..<64]).expect("a digest buffer of the right size")

    assert_eq(hex_string(oa), hex_string(sha224("abc".bytes)))
    assert_eq(hex_string(ob), hex_string(sha384("abc".bytes)))
    assert_eq(hex_string(oc), hex_string(sha512("abc".bytes)))
end each_hasher_agrees

// `verify` is the comparison a tag wants, and what it must get right is not only the answer: it must
// give the same answer `==` would for every input, while reading all of both regardless.
@test("verify agrees with equality on every shape of input")
verify_agrees_with_equality()
    assert(verify(sha256("abc".bytes), sha256("abc".bytes)))
    assert(!verify(sha256("abc".bytes), sha256("abd".bytes)))

    // Same length, differing in the first byte and in the last — the two the early-exit version
    // would have told apart by how long it took.
    var a: [4]u8 = [1, 2, 3, 4]
    var first: [4]u8 = [9, 2, 3, 4]
    var last: [4]u8 = [1, 2, 3, 9]

    assert(verify(a[0..<4], a[0..<4]))
    assert(!verify(a[0..<4], first[0..<4]))
    assert(!verify(a[0..<4], last[0..<4]))

    // Lengths differ, which is public and answered directly.
    assert(!verify(a[0..<4], a[0..<3]))
    assert(!verify(a[0..<3], a[0..<4]))

    // Two empty strings are equal, and nothing is read.
    assert(verify(a[0..<0], a[0..<0]))
end verify_agrees_with_equality

@test("verify carries a tag it was given, which is what it is for")
verify_checks_a_tag()
    var key = "Jefe".bytes
    var msg = "what do ya want for nothing?".bytes
    var tag = hmac256(key, msg)

    assert(verify(tag, hmac256(key, msg)))

    // A tag for a different message, and a tag under a different key: both refused.
    assert(!verify(tag, hmac256(key, "what do ya want for something?".bytes)))
    assert(!verify(tag, hmac256("jefe".bytes, msg)))

    // One bit of the tag flipped is still refused — the case an accumulator that stopped early
    // would have taken longer to reach.
    var flipped = hmac256(key, msg)

    flipped[31] ^= 1

    assert(!verify(tag, flipped))
end verify_checks_a_tag
