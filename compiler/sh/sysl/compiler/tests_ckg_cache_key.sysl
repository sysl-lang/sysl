// -- linking ---------------------------------------------------------------------------------------

// A directory holding `libckgl.a`, whose `ckgl_value` answers `n`.
private ckg_archive(n: int) -> string
    val dir = lbr_temp("sysl-ckg-lib")
    val clang = find_clang(host_target(), None).unwrap()

    write_text(s"$dir/ckgl.c", s"int ckgl_value(void) { return $n; }\n").unwrap()
    capture(clang, ["-c", s"$dir/ckgl.c", "-o", s"$dir/ckgl.o"], "", [], true).unwrap()
    capture("/usr/bin/ar", ["rcs", s"$dir/libckgl.a", s"$dir/ckgl.o"], "", [], true).unwrap()
    dir
end ckg_archive

@test("--link-path keys the run cache: one library name found in two directories is two programs")
ckg_link_path_flag()
    if !ckg_ready() then return

    val two = ckg_archive(2)
    val nine = ckg_archive(9)
    val root = ckg_project(ckg_manifest("app", ""), "import cl", "cl.value()",
                           [("cl/cl.sysl", "module cl\n@link(\"ckgl\")\n\nextern \"ckgl_value\" value() -> int\n")])

    assert_eq(ckg_flags_seam(root, s"--link-path $two", s"--link-path $nine"),
              "2 | 9 | 2 | miss miss hit | different bytes")
    lbr_drop([root, two, nine])
end ckg_link_path_flag

