import sysl.buf.*
// A buffer of counted references: push, read through, and drop.
struct Probe
    n: long

impl Drop for Probe
    drop(self)
        ()

var total: long = 0

for round in 0..<120
    var b: Buf[&Probe] = buf()

    for i in 0..<250000
        b.push(Probe(long(i)))

    for k in 0..<4
        for i in 0..<b.len()
            total += b[i].n

print(total)
