module sysl.time

// The calendar's names before 0.10.0. Each is a tombstone: it declares nothing, and a program still
// using the old name is told the new one rather than that the name stands for nothing
// (`reference/attributes.md § @renamed and @removed`).

@renamed("Date", "0.10.0") type LocalDate
@renamed("Time", "0.10.0") type LocalTime
@renamed("DateTime", "0.10.0") type LocalDateTime
@renamed("YearMonthDay", "0.10.0") type Civil
@renamed("date", "0.10.0") date_at()
@renamed("time", "0.10.0") time_at()
@renamed("date_time", "0.10.0") datetime_at()
@removed("a zone resolves a reading itself — write 'zone.resolve(dt)'", "0.10.0") resolve()
