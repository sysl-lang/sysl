module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.fs.IoError
import sysl.process.{start, Child, Group, Output, Status}
import sysl.signal.{send, KILL}
import sysl.text.{from_utf8_unchecked, repeat, split, Search}
import sysl.time.{millis, monotonic, sleep, whole_millis, Duration}

// `sysl test` -- the `@test` functions of a source tree, run, and what a reader is told about them.
//
// **One build, one process per test.** The whole tree is compiled once, into a binary whose entry
// point takes a test's name and runs that test alone (`gen_test_main`); this then starts it once per
// test. A test that fails does so by trapping, and a trap takes its process with it -- so a run that
// shared one process would report the first failure and nothing after it. Paying for a process per
// test buys every test a verdict, and it is the cheap half: the compile is the slow one and there is
// only ever one of those.
//
// **The verdict is the exit status, and nothing else.** A test passes by returning. That is the whole
// protocol, and it is what lets a test assert with the language it is testing rather than with a
// framework: a broken `require`, a bounds violation, an `unwrap` of `None` -- each ends the process,
// and none of them needed to know it was running under a test. `@test(should_trap)` inverts the
// reading for a test whose subject *is* the check.
//
// **A module's hooks are read against that protocol rather than beside it.** `@setup` and `@teardown`
// run in the test's own process, which is what lets a setup leave something for the test to find --
// and is why a teardown after a test that trapped runs in a process of its own instead, there being
// nothing left of the first one. `@setup_all` and `@teardown_all` are their own invocations, so a
// module reaches its tests from one of them only through what outlives a process. Which part of a run
// ended it cannot be read from an exit status, so the dispatcher marks each boundary it crosses.
//
// **Every process is bounded, so a test that never ends is a failure rather than a hung run.** Each
// one is started in a process group of its own and given the run's limit (`--timeout`, five minutes
// unless asked otherwise) or its own (`@test(timeout: n)`); one that outlasts it is stopped, the whole
// group with it, and reported as timed out with whatever it had printed, and the run goes on to the
// next test. The other half is the test binary's own: it watches this process, and a runner that dies
// -- however it dies -- takes every test process and everything they started with it
// (`testprocess.c`), so nothing is left spinning under `init`.

// What was asked of a run, beyond which tree to run.
//
// `filter` selects by substring against both the reported name and the key, so a module's tests can
// be named by their module and one test by its own name. `fail_fast` stops at the first failure,
// which is what someone iterating on one wants and the opposite of what someone reading a report
// does -- hence a flag rather than a default either way. `jobs` is how many test processes may run
// at once (`run_selected`); one is a run of one at a time. `alone` are the texts naming the tests that
// run with nothing beside them (a manifest's `test.alone`), each read as `filter` is.
struct TestOptions
    filter: Option[string]
    fail_fast: bool
    jobs: usize
    alone: Buf[string]
end TestOptions

// One test, run. `detail` is absent exactly when the test passed; `output` is everything the run
// printed, on either stream, which a failure shows and a pass keeps to itself.
//
// **A row for a `@setup_all` or `@teardown_all` that did not come back is one of these too**, with
// the hook standing in for the test: a hook that runs alone has no test to hang its failure on, and
// what a row needs is a name, a file and a line, which a hook has. So the report grows a row rather
// than a second kind of row, and the header counts the tests instead of counting the rows.
//
// **An ignored test is one of these too, and it never ran**: its test carries the reason, `detail`
// is absent and `millis` is zero. It fails nothing — `passed` reads true, which an ignored test does
// not spoil — and it is counted apart in the summary.
//
// **A test that skipped itself is one of these as well, and it DID run**: `skipped` carries the reason
// it gave `skip` (`skip_reason`), `millis` is how long it took to find out, and it is counted with the
// ignored ones — a run that could not test something says so rather than calling it a pass.
struct Outcome
    test: TTest
    detail: Option[string]
    output: string
    millis: long
    skipped: Option[string]

    passed(self) -> bool = self.detail.is_none()

    // Why the test was not run, where it was ignored.
    ignored(self) -> Option[string] = self.test.ignored

    // Whether the row is a `skip` rather than a verdict: ignored by its annotation, or skipped by the
    // test itself and nothing after that failed.
    not_run(self) -> bool = self.passed() && (self.ignored().is_some() || self.skipped.is_some())
end Outcome

// Every selected test, run -- up to `opts.jobs` of them at once -- and reported in the order it was
// written, so that a reader following a failure down a file finds the tests where the file put them.
//
// **Running several at once changes nothing a report says.** Each test is a process of its own
// already, so one test reaches another's verdict only through what outlives a process -- a file, a
// port, a directory both name -- which is the test's own business under any runner that starts more
// than one, as it is under `cargo test`. A row is held back until every row above it is in, so the
// report reads exactly as a run of one at a time would have written it, and `jobs` of one *is* that
// run.
//
// A module's `@setup_all` is in before any of its tests starts, and its `@teardown_all` starts once
// every one of them is in. Other modules' tests wait for neither. A test `opts.alone` names waits
// until nothing is running, and nothing starts beside it.
//
// `fail_fast` stops the starting rather than the report: the tests already running finish and are
// reported, what has run is still reported, and the tests that never started are simply absent.
// Reporting them as skipped would be a third verdict for something that is not a verdict at all.
//
// **`emit` is called as the run goes, not once at the end** -- the header first, then a file's
// heading before its first row, then each row as soon as it and every row above it are in, then the
// summary once every test is. A suite that takes half an hour is watched from a log file while it
// runs rather than staying silent until it exits, and a run that is killed partway still has a
// report of everything up to the kill.
//
// `seconds` is the run's limit on each process it starts, zero for none; a test's own
// `@test(timeout: n)` takes its place for that test, in either direction.
//
// `refused` are the package's `tests/refused/` programs, already compiled and judged
// (`refused_outcome`): they are reported after the `@test` functions, as rows of the same report and
// counts of the same summary.
run_selected(exe: string, tests: Buf[TTest], opts: TestOptions, filtered: usize,
             emit: string -> unit, seconds: int = DefaultTestSeconds,
             refused: Buf[Outcome] = buf()) -> Buf[Outcome]
    var done: Buf[Outcome] = buf()
    var shown = ""
    var any_shown = false

    // Fixed before the first test runs, from every name a row could carry -- a test's own, or the
    // bare name of a hook that might stand in for one -- because the alternative is not printing a
    // row until the last test is known to be the widest, which is the whole run.
    var width = widest_row_name(tests)

    for item in refused
        if item.test.display.len > width then width = item.test.display.len

    emit(tests_header(tests.len() + refused.len(), filtered))

    var run = schedule_of(exe, by_module_order(tests), seconds, opts)
    var reported: usize = 0
    val most = if opts.jobs == 0 then 1 else opts.jobs

    loop
        run.start_up_to(most)

        while reported < run.rows.len() && run.settled.at(reported)
            run.rows.at(reported) match
                Some(outcome) ->
                    done.push(outcome)
                    show_outcome(outcome, width, &shown, &any_shown, emit)
                None -> ()

            reported += 1

        if run.flights.is_empty() then break

        run.land_any()

    for item in refused
        if run.stopped then break

        done.push(item)
        show_outcome(item, width, &shown, &any_shown, emit)

        if opts.fail_fast && !item.passed() then run.stopped = true

    emit(tests_summary(done))
    done
end run_selected

// A run in progress: the rows it owes, in the order they are reported, and the processes it has out.
//
// **A row is a slot, and a slot is settled exactly once** -- with an `Outcome` where it has a row to
// show, and with nothing where it has none: a hook that came back, a test that never started.
// `run_selected` reports the settled slots from the top down, stopping at the first that is not.
private struct Schedule
    exe: string
    seconds: int
    fail_fast: bool
    alone: Buf[string]
    groups: Buf[Buf[TTest]]
    lanes: Buf[Lane]
    rows: Buf[Option[Outcome]]
    settled: Buf[bool]
    flights: Buf[Flight]
    stopped: bool

    // The first lane not yet finished, so a long run does not walk the finished ones on every start.
    live: usize

    // Start whatever may start now, until `most` processes are out or nothing more may.
    //
    // The lanes are walked in order, so the tests are started in the order they were written and the
    // rows near the top -- the ones holding back the report -- are the first to be in.
    //
    // **A test running alone holds everything**, hooks included, and one that is to run alone waits
    // for the run to drain -- holding back what comes after it too, so the tests still start in the
    // order they were written.
    start_up_to(*self, most: usize)
        for f in self.flights
            if f.alone then return

        var g = self.live
        var held = false

        while g < self.lanes.len()
            var lane = self.lanes.at(g)

            if lane.phase == Begun
                // A module's `@setup_all` is a run of its own, before anything else in it, and
                // nothing of a module starts once the run has stopped.
                if self.stopped
                    lane.phase = Over
                    self.settle_from(lane.first, lane.first + lane.size(), None)
                else
                    lane.hooks.setup_all match
                        Some(h) ->
                            if self.flights.len() >= most then return

                            self.launch(g, lane.first, SetupAll, h.func, self.seconds)
                            lane.phase = SettingUp
                        None -> lane.phase = Testing

            if lane.phase == Testing
                // Where `@setup_all` did not come back, the module's tests do not run: there is no
                // test to hang the failure on, and reporting tests that never started would be a
                // third verdict for something that is not one.
                if !lane.booted || self.stopped
                    self.settle_from(lane.first + lane.lead() + lane.next,
                                     lane.first + lane.lead() + lane.count, None)
                    lane.next = lane.count
                end if

                while lane.next < lane.count
                    // An ignored test starts no process — not the test's, and not its `@setup` or
                    // `@teardown` either, since those bracket a run and there is none.
                    val t = self.groups.at(g).at(lane.next)
                    val row = lane.first + lane.lead() + lane.next

                    if t.ignored.is_some()
                        self.settle(row, Some(Outcome(t, None, "", 0, None)))
                    else
                        if self.flights.len() >= most then break

                        val alone = runs_alone(t, self.alone)

                        if alone && !self.flights.is_empty()
                            held = true
                            break
                        end if

                        self.launch(g, row, OneTest, t.func, t.timeout.unwrap_or(self.seconds), alone)
                        lane.out += 1

                        if alone
                            lane.next += 1
                            held = true
                            break
                        end if
                    end if

                    lane.next += 1

                // `@teardown_all` runs whatever became of the tests, and whatever became of
                // `@setup_all`: what it is for is releasing what the module took, and a module that
                // failed halfway has taken some of it.
                if lane.next == lane.count && lane.out == 0
                    lane.hooks.teardown_all match
                        Some(h) ->
                            if self.flights.len() < most
                                self.launch(g, lane.first + lane.lead() + lane.count, TeardownAll,
                                            h.func, self.seconds)
                                lane.phase = TearingDown
                        None -> lane.phase = Over
            end if

            self.lanes.set(g, lane)

            if held then return

            if lane.phase == Over && g == self.live then self.live += 1

            g += 1
    end start_up_to

    // Wait until at least one process out has ended, and take in what each that has came to.
    //
    // **The wait is a poll**, since a process is waited for one at a time and any of them may be the
    // next to end. A sweep that finds none ended sleeps a millisecond, which is nothing beside what one
    // test costs. A process past its limit is waited for outright, which is what stops it
    // (`Child.wait`).
    land_any(*self)
        loop
            var still: Buf[Flight] = buf()
            var landed: Buf[(Flight, BoundedRun)] = buf()

            for f in self.flights
                f.child match
                    None -> landed.push((f, BoundedRun(NotStarted, "", false)))
                    Some(child) ->
                        val over = f.limit > 0 &&
                            whole_millis(monotonic() - f.began) >= long(f.limit) * 1000
                        val answer = if over then child.wait().map((o) -> Some(o)) else child.try_wait()

                        answer match
                            Ok(None) -> still.push(f)
                            Ok(Some(o)) -> landed.push((f, bounded(child, Ok(o))))
                            Err(e) -> landed.push((f, bounded(child, Err(e))))

            self.flights = still

            for item in landed
                self.take(item.0, item.1)

            if !landed.is_empty() then return

            sleep(millis(1))
    end land_any

    // What one process that has ended came to, written into its slot and its lane.
    private take(*self, f: Flight, ran: BoundedRun)
        var lane = self.lanes.at(f.lane)
        val took = whole_millis(monotonic() - f.began)

        f.kind match
            OneTest ->
                val t = self.groups.at(f.lane).at(f.row - lane.first - lane.lead())
                val outcome = test_landed(self.exe, t, ran, took, f.limit, self.seconds)

                self.settle(f.row, Some(outcome))
                lane.out -= 1

                if self.fail_fast && !outcome.passed() then self.stopped = true
            SetupAll ->
                val h = lane.hooks.setup_all.unwrap()

                self.settle(f.row, self.hook_row(h, ran, took))
                lane.booted = ran.state == 0
                lane.phase = Testing
            TeardownAll ->
                val h = lane.hooks.teardown_all.unwrap()

                self.settle(f.row, self.hook_row(h, ran, took))
                lane.phase = Over

        self.lanes.set(f.lane, lane)
    end take

    // A module hook's slot: a row where it did not come back, and nothing where it did.
    private hook_row(*self, h: THook, ran: BoundedRun, took: long) -> Option[Outcome]
        if ran.state == 0 then return None

        if self.fail_fast then self.stopped = true

        Some(hook_outcome(h, HookRun(ran.state, unmarked_output(ran.raw), took,
                                     ending_of(ran.state, ran.timed_out, self.seconds))))
    end hook_row

    // One entry point of the test binary, started for the slot `row`, in a **process group of its
    // own** and bounded by `limit` seconds (none, for zero).
    //
    // One that cannot be started at all is out all the same, with no child: the next sweep takes it
    // in as the run a binary that never started comes to, rather than this taking it in under the
    // feet of the lane its caller is still holding.
    private launch(*self, lane: usize, row: usize, kind: FlightKind, name: string, limit: int,
                   alone: bool = false)
        val began = monotonic()
        val child = start(self.exe, [name], "", running_compiler_env().view(), true, limit * 1000,
                          group = Group.New).ok()

        self.flights.push(Flight(lane, row, kind, child, began, limit, alone))
    end launch

    private settle(*self, row: usize, outcome: Option[Outcome])
        self.rows.set(row, outcome)
        self.settled.set(row, true)

    private settle_from(*self, from: usize, to: usize, outcome: Option[Outcome])
        for row in from..<to
            self.settle(row, outcome)
end Schedule

// The slots of every group laid out in report order -- a module's `@setup_all`, its tests, its
// `@teardown_all` -- each unsettled.
private schedule_of(exe: string, groups: Buf[Buf[TTest]], seconds: int, opts: TestOptions) -> Schedule
    var lanes: Buf[Lane] = buf()
    var rows: Buf[Option[Outcome]] = buf()
    var settled: Buf[bool] = buf()

    for group in groups
        // A module whose selected tests are all ignored runs nothing at all, its `_all` hooks
        // included: they bracket the runs, and there are none to bracket.
        val hooks = if all_ignored(group) then no_hooks() else group.at(0).hooks
        val lane = Lane(hooks, rows.len(), group.len(), Begun, 0, 0, true)

        for _ in 0..<lane.size()
            rows.push(None)
            settled.push(false)

        lanes.push(lane)

    Schedule(exe, seconds, opts.fail_fast, opts.alone, groups, lanes, rows, settled, buf(), false, 0)
end schedule_of

// Whether a test is one of those `alone` names, each read as `--filter` reads its text.
private runs_alone(t: TTest, alone: Buf[string]) -> bool
    for item in alone
        if test_matches(t, Some(item)) then return true

    false
end runs_alone

// One module's part of a run: where its slots begin, how far its tests have got, and which of its
// hooks has run.
private struct Lane
    hooks: THooks
    first: usize
    count: usize
    phase: LanePhase
    next: usize

    // Tests started and not yet in.
    out: usize

    // Whether `@setup_all` came back, or there was none.
    booted: bool

    // Slots ahead of the first test: one for a `@setup_all`, none without.
    lead(self) -> usize = if self.hooks.setup_all.is_some() then 1 else 0

    size(self) -> usize =
        self.lead() + self.count + (if self.hooks.teardown_all.is_some() then 1 else 0)
end Lane

private enum LanePhase
    Begun
    SettingUp
    Testing
    TearingDown
    Over

// A process the run has out: which slot it answers, and what it is.
private struct Flight
    lane: usize
    row: usize
    kind: FlightKind
    child: Option[&Child]
    began: Duration
    limit: int

    // A test running with nothing beside it.
    alone: bool
end Flight

private enum FlightKind
    SetupAll
    OneTest
    TeardownAll

// One row, with its file's heading in front of it where this is the first row that file has had.
private show_outcome(o: Outcome, width: usize, shown: *string, any_shown: *bool,
                     emit: string -> unit)
    if !*any_shown || *shown != o.test.file
        emit(test_file_header(o.test.file))
        *shown = o.test.file
        *any_shown = true

    emit(test_row(o, width))
end show_outcome

// Whether every test of a module's group is ignored, so nothing of the module runs.
private all_ignored(group: Buf[TTest]) -> bool
    for item in group
        if item.ignored.is_none() then return false

    true
end all_ignored

// The widest name a row in this run could carry, fixed before anything is run so the first row can be
// emitted immediately. It covers both what the tests will show and the bare name of every hook their
// modules declare, since a failing `@setup_all` or `@teardown_all` reports under that name instead --
// so the padding a live row gets does not shift once a hook fails.
private widest_row_name(tests: Buf[TTest]) -> usize
    var width: usize = 0

    for t in tests
        if t.display.len > width then width = t.display.len

        val hooks = t.hooks.all()

        for j in 0..<hooks.len()
            val name = module_bare(hooks.at(j).func)

            if name.len > width then width = name.len

    width
end widest_row_name

// The selected tests grouped by the module that declared them, in the order the modules were first
// met.
//
// The grouping is what makes an `_all` hook run once, and the order is the tests' own so that a report
// still follows the source. A module with no hooks pays nothing for this: the group runs exactly the
// processes it would have run without one.
private by_module_order(tests: Buf[TTest]) -> Buf[Buf[TTest]]
    var names: Buf[string] = buf()
    var groups: Buf[Buf[TTest]] = buf()

    for item in tests
        val name = module_of(item.func)

        index_of_module(names, name) match
            Some(at) ->
                var group = groups.at(at)

                group.push(item)
                groups.set(at, group)
            None ->
                var group: Buf[TTest] = buf()

                group.push(item)
                names.push(name)
                groups.push(group)

    groups
end by_module_order

private index_of_module(names: Buf[string], name: string) -> Option[usize]
    for i in 0..<names.len()
        if names.at(i) == name then return Some(i)

    None
end index_of_module

// One test, run -- and its module's per-test hooks around it.
//
// **`@setup` runs inside the test's process**, so what it leaves in module storage is what the test
// finds. That is also why a fault in it cannot be told from a fault in the test by the exit status
// alone, and why the dispatcher leaves a mark on its way past: no mark means the run never got out of
// setup.
//
// **`@teardown` runs in that process where the test returned, and in one of its own where it did
// not.** A trap takes the process with it, so there is nothing left there to run a teardown in -- and
// honouring "teardown runs even when the test failed" any other way would mean not running it at all.
// What a fresh process can release is what outlives a process, which is what the hook is documented
// to be for.
//
// This is the test's process once it has ended, as `ran`, `took` milliseconds after it was started
// with `limit` seconds to run in. The teardown it could not reach runs here, before the test's row is
// in -- so the next test of a run of one at a time does not start until it is done.
private test_landed(exe: string, t: TTest, ran: BoundedRun, took: long, limit: int,
                    run_seconds: int) -> Outcome
    val raw = ran.raw
    val state = ran.state
    val output = unmarked_output(raw)
    val setup_ran = t.hooks.setup.is_none() || raw.has_byte(setup_byte())
    val entered_down = t.hooks.teardown.is_some() && raw.has_byte(test_byte())

    // A skip is the mark AND a clean exit: a test that failed before it called `skip` never wrote the
    // mark, and one that wrote it and then died did not skip. Asked first, since a `@setup` that
    // skips leaves no setup mark behind it and is the module saying none of its tests can run here.
    val skipped = if state == 0 && !ran.timed_out then skip_reason(raw) else None

    var detail: Option[string] = None

    if skipped.is_some()
        ()
    else if !setup_ran
        detail = Some(guarded_by_setup(t.hooks.setup.unwrap(), ending_of(state, ran.timed_out, limit)))
    else if entered_down && state != 0
        detail = Some(hook_ended(t.hooks.teardown.unwrap(), ending_of(state, ran.timed_out, limit)) +
            ", after the test returned")
    else if ran.timed_out
        // Whatever the test said it would do, it did not get to do it: a `should_trap` test that never
        // ends has not trapped, and a run that was stopped is not one that returned.
        detail = Some(timed_out_after(limit))
    else
        detail = test_verdict(t, state, output)

    // The teardown the process could not reach. Its own output joins the test's, since a reader
    // following one failure should not have to run the suite again to see the other.
    var trailing = ""

    if t.hooks.teardown.is_some() && !entered_down
        val h = t.hooks.teardown.unwrap()
        val r = run_test_hook(exe, h, run_seconds)

        trailing = r.output

        if r.status != 0 && detail.is_none() then detail = Some(hook_ended(h, r.ending))

    Outcome(t, detail, output + trailing, took, skipped)
end test_landed

// What one hook's own process did. `ending` is how a report says it did not come back, where it did
// not: an exit status, or the limit it outlasted.
struct HookRun
    status: int
    output: string
    millis: long
    ending: string
end HookRun

private run_test_hook(exe: string, h: THook, seconds: int) -> HookRun
    val started = monotonic()
    val ran = run_bounded(exe, h.func, seconds)

    HookRun(ran.state, unmarked_output(ran.raw), whole_millis(monotonic() - started),
            ending_of(ran.state, ran.timed_out, seconds))
end run_test_hook

// What one run of the test binary came to: the status a shell would report, everything it printed on
// either stream, and whether it was stopped for outlasting its limit -- which a status cannot say,
// since a program may exit with any number it likes.
struct BoundedRun
    state: int
    raw: string
    timed_out: bool
end BoundedRun

// One entry point of the test binary, run in a **process group of its own** and stopped once it has
// run for `seconds` (never, for zero).
//
// The group is what makes stopping it mean stopping everything it started. The library stops the
// process it was asked to run; a test that started a server, or a compiler that started a linker, has
// children of its own, and those are in the group -- so the group is ended too, once the test is. A
// test that returned is left alone: what it leaves running is its own business, and the runner's
// part is only the limit it set. Output goes to files rather than pipes (`sysl.process`), so what a
// stopped test printed before it was stopped is all still there to show.
private run_bounded(exe: string, name: string, seconds: int) -> BoundedRun =
    start(exe, [name], "", running_compiler_env().view(), true, seconds * 1000, group = Group.New) match
        Err(_) -> BoundedRun(NotStarted, "", false)
        Ok(child) -> bounded(child, child.wait())

// What a child of the test binary came to, from what its wait answered -- and, where it was stopped
// for outlasting its limit, the rest of its group stopped too. A wait that failed is a run with no
// status, as a binary that never started is.
private bounded(child: &Child, answer: Result[Output, IoError]) -> BoundedRun
    var state = NotStarted
    var raw = ""
    var timed_out = false

    answer match
        Err(_) -> ()
        Ok(o) ->
            raw = o.text + o.err.unwrap_or("")
            state = shell_status(o.status)

            o.status match
                TimedOut -> timed_out = true
                _ -> ()

    if timed_out then _ = send(-i64(child.group()), KILL)

    BoundedRun(state, raw, timed_out)
end bounded

// The run's limit where a run is not given one: long enough that no real test comes near it, short
// enough that a test that will never end costs a run five minutes rather than the rest of the night.
const DefaultTestSeconds: int = 300

// A run that was stopped for taking too long, as its report row says it.
timed_out_after(seconds: int) -> string = s"timed out after ${seconds}s"

// How a process that did not come back ended, as a report says it.
private ending_of(state: int, timed_out: bool, seconds: int) -> string =
    if timed_out then timed_out_after(seconds) else s"did not return — exit status $state"

// What a run reports where the binary could not be started at all. It is not a status any child left
// behind -- a process that never ran left none -- and the number is the shell's own word for a command
// it could not execute, so a reader who has seen one has already been told what it means.
const NotStarted: int = 127

// A hook's failure as a report row, since a hook that runs alone has no test to hang one on.
//
// It borrows `TTest` rather than growing the report a second kind of row: what a row needs is a name,
// a file and a line, and a hook has all three. It is shown under the name it was declared with, which
// is what a reader greps for.
private hook_outcome(h: THook, r: HookRun) -> Outcome =
    Outcome(TTest(h.func, module_bare(h.func), false, None, h.file, h.line, no_hooks(), None, None),
            Some(hook_ended(h, r.ending)), r.output, r.millis, None)

// A hook that did not come back, and how (`ending_of`).
private hook_ended(h: THook, ending: string) -> string =
    s"the module's '@${hook_word(h.kind)}', '${qualified_name(h.func)}', $ending"

private guarded_by_setup(h: THook, ending: string) -> string =
    s"${hook_ended(h, ending)}, so this test did not run"

// Whether a test's run was what the test said it would be, and if not, what it was instead.
//
// The status is read as the platform leaves it: zero for a function that returned, and anything else
// for a process that did not get there. **A trap is not told from an `exit`**, deliberately -- both
// are a test that did not come back, the language offers no way to distinguish them from inside, and
// a rule that read one as a pass and the other as a failure would rest on which signal a given
// machine's trap happens to raise.
test_verdict(t: TTest, state: int, output: string) -> Option[string]
    if !t.should_trap
        if state == 0 then return None

        return Some(s"did not return — exit status $state")
    end if

    if state == 0 then return Some("returned, and was expected to trap")

    t.expected match
        None -> None
        Some(want) ->
            if output.contains(want) then None
            else Some(s"trapped, but printed nothing holding \"$want\"")
end test_verdict

// A test is selected when the pattern is a substring of either name it has: the one a report shows
// and the key its module gives it. Two, because the two are what a reader has to hand -- a name read
// off a failing report, and a module named to run everything under it.
test_matches(t: TTest, filter: Option[string]) -> bool = filter match
    None -> true
    Some(f) -> t.display.contains(f) || module_show(t.func).contains(f)

// Those of a run's tests the filter keeps.
selected_tests(tests: Buf[TTest], filter: Option[string]) -> Buf[TTest] = selected_in(tests, filter, buf())

// Whether `file` is any of the files `--file` named; no name at all means every file.
file_in(file: string, within: Buf[string]) -> bool
    if within.is_empty() then return true

    for named in within
        if file_named(file, named) then return true

    false
end file_in

// Whether `file` is the source file `--file` names: the whole of its path, or its last components
// after a `/`, with or without the `.sysl`. **A whole component, never a substring**, so
// `--file tests_arc` is that one file and not `tests_arcs.sysl` beside it, and a name filter's
// substring rule never reaches a file by accident -- the two flags answer different questions.
file_named(file: string, named: string) -> bool
    if named == "" then return false

    for want in [named, named + ".sysl"]
        if file == want || file.ends_with("/" + want) then return true

    false
end file_named

// Those of a run's tests the filter keeps, and, where `--file` named any, that were written in one of
// them. A test is chosen once however many names reach its file.
selected_in(tests: Buf[TTest], filter: Option[string], within: Buf[string]) -> Buf[TTest]
    var out: Buf[TTest] = buf()

    for item in tests
        if file_in(item.file, within) && test_matches(item, filter) then out.push(item)

    out
end selected_in

// -- the report ---------------------------------------------------------------------------------------

// The header counts the **tests** that were selected, which is not the number of rows below it: a hook
// that did not come back gets a row of its own, and a module whose `@setup_all` failed has tests that
// were selected and never ran. Reading the count off the rows would say "running 4 tests" over three
// tests and a hook.
tests_header(selected: usize, filtered: usize) -> string
    val word = if selected == 1 then "test" else "tests"
    val of = if filtered > 0 then s" of ${selected + filtered}" else ""

    s"running $selected $word$of\n"
end tests_header

// The heading a file's rows are shown under -- once, before the first of them.
test_file_header(file: string) -> string = s"\n$file\n"

// One outcome's row, padded to `width` so every status column lines up regardless of which row's name
// happens to be the widest. A failure's own line says what happened; anything the run printed follows
// it, indented, and is shown **only** for a failure -- output from a test that passed is what the test
// was doing, not something anyone asked to read.
//
// An ignored test's row carries its reason where the time would be: it has no run to time, and the
// reason is the one thing its reader is owed. A test that skipped itself gets the same row with the
// word that says which of the two it was: `ignored` is the annotation's, `skipped` the run's own.
test_row(o: Outcome, width: usize) -> string
    val mark = if o.passed() then "ok  " else "FAIL"
    val pad = if o.test.display.len < width then repeat(" ", width - o.test.display.len) else ""

    var out = o.ignored() match
        Some(why) -> s"  skip  ${o.test.display}$pad  ignored: $why\n"
        None -> o.skipped match
            Some(why) if o.passed() -> s"  skip  ${o.test.display}$pad  skipped: $why\n"
            _ -> s"  $mark  ${o.test.display}$pad  ${o.millis}ms\n"

    o.detail match
        None -> ()
        Some(detail) ->
            out = out + s"        $detail\n"
            out = out + s"        at ${o.test.file}:${o.test.line}\n"

            val lines = text_lines(o.output)

            for item in lines
                out = out + s"        > ${item}\n"

    out
end test_row

// The closing line: how many of the rows passed, against how long the whole run took — and how many
// were ignored, where any were. **The ignored count appears only when it is not zero**, so a run that
// ignored nothing prints the line it always has and whatever reads that line keeps reading it. A test
// that skipped itself is counted there too: neither kind is a pass, and neither is a failure.
tests_summary(outcomes: Buf[Outcome]) -> string
    var failed: usize = 0
    var ignored: usize = 0
    var total: long = 0

    for item in outcomes
        if !item.passed() then failed += 1
        if item.not_run() then ignored += 1

        total += item.millis

    val skipped = if ignored > 0 then s", $ignored ignored" else ""

    s"\n${outcomes.len() - failed - ignored} passed, $failed failed$skipped — ${total}ms\n"
end tests_summary

// The whole report as one string, for a caller that wants the finished list rather than a run to
// watch. Given the same outcomes in the same order it is exactly what the concatenation of a live
// run's `emit` calls comes to, because both are built from these same four pieces.
tests_rendered(outcomes: Buf[Outcome], selected: usize, filtered: usize) -> string
    var out = ""
    val sink = &out

    tests_streamed(outcomes, selected, filtered, piece -> *sink = *sink + piece)
    out
end tests_rendered

// The same report handed to `emit` a piece at a time -- the header, each file's heading, each row, the
// summary -- which is the shape a live run emits it in, so watching a run and reading the finished
// report show one text.
//
// **The rows are grouped by the file each test was written in, the files in path order, and a file's
// rows in source order** whatever order the outcomes arrived in: the file is where a reader goes next.
tests_streamed(outcomes: Buf[Outcome], selected: usize, filtered: usize, emit: string -> unit)
    var width: usize = 0

    for item in outcomes
        if item.test.display.len > width then width = item.test.display.len

    emit(tests_header(selected, filtered))

    val files = files_in_order(outcomes)

    for item in files
        emit(test_file_header(item))

        val rows = rows_of_file(outcomes, item)

        for i in 0..<rows.len()
            emit(test_row(outcomes.at(rows.at(i)), width))

    emit(tests_summary(outcomes))
end tests_streamed

// Every file an outcome names, once each, in path order.
private files_in_order(outcomes: Buf[Outcome]) -> Buf[string]
    var files: Buf[string] = buf()

    for item in outcomes
        val file = item.test.file
        var at = files.len()
        var seen = false

        for j in 0..<files.len()
            if files.at(j) == file then seen = true

        if !seen
            files.push(file)

            // Moved down into place, so the list stays sorted as it grows.
            while at > 0 && files.at(at - 1) > file
                files.set(at, files.at(at - 1))
                at -= 1

            files.set(at, file)
        end if

    files
end files_in_order

// The indices of the outcomes written in `file`, ordered by line; outcomes on one line keep the order
// they arrived in.
private rows_of_file(outcomes: Buf[Outcome], file: string) -> Buf[usize]
    var rows: Buf[usize] = buf()

    for i in 0..<outcomes.len()
        if outcomes.at(i).test.file == file
            var at = rows.len()

            rows.push(i)

            while at > 0 && outcomes.at(rows.at(at - 1)).test.line > outcomes.at(i).test.line
                rows.set(at, rows.at(at - 1))
                at -= 1

            rows.set(at, i)

    rows
end rows_of_file

// -- what a run's output has in it --------------------------------------------------------------------

// The byte the dispatcher writes once `@setup` has returned, and the one it writes once the test
// itself has. **A dead process cannot report which part of it died**, and that is the whole of why a
// byte is written at all: the three run in one process, a fault anywhere in it ends that process, and
// the exit status is the same however far it got. So the dispatcher leaves a mark as it crosses each
// boundary, and the runner reads how far the run reached off what arrived.
//
// Both are control characters no source text can hold -- neither survives the lexer, so a test's own
// output cannot forge one -- and both are stripped from what a failure shows: they are the runner's
// channel and not the test's.
//
// **Read off the marks the emitter writes rather than written down a second time here**, because two
// statements of one byte is a byte the two halves will one day disagree about.
private setup_byte() -> u8 = setup_mark().bytes[0]

private test_byte() -> u8 = test_mark().bytes[0]

// The byte a test writes when it gives up: `skip(why)` prints it, then the reason and a newline, then
// ends the process with status 0. **It is the TEST's mark rather than the dispatcher's**, written by
// the library function every test calls rather than by the emitted entry point, so this is the one
// place in the compiler that states it and `sysl/testing/testing.sysl`'s `skip` is the other.
//
// Why a mark and a clean exit rather than an exit status of its own: the mark rides the channel this
// runner already reads, and the clean exit is what makes `skip` safe under a runner that predates it —
// there the test reads as one that returned, which is exactly what a test that printed a note and
// returned used to be. A reserved status would have turned every such run red instead.
skip_mark() -> string = "\u{3}"

private skip_byte() -> u8 = skip_mark().bytes[0]

// The reason a run gave `skip`, where it gave one: what follows the mark, up to the end of its line.
skip_reason(output: string) -> Option[string]
    val mark = skip_byte()

    for i in 0..<output.bytes.len
        if output.bytes[i] == mark
            var why: Buf[u8] = buf()

            for j in i + 1..<output.bytes.len
                if output.bytes[j] == u8('\n') then break

                why.push(output.bytes[j])

            return Some(from_utf8_unchecked(why.view()))
        end if

    None
end skip_reason

// A run's output as a reader should see it: the marks above taken out.
unmarked_output(output: string) -> string
    val setup = setup_byte()
    val test = test_byte()
    val skip = skip_byte()

    if !output.has_byte(setup) && !output.has_byte(test) && !output.has_byte(skip) then return output

    var out: Buf[u8] = buf()

    for i in 0..<output.bytes.len
        val b = output.bytes[i]

        if b != setup && b != test && b != skip then out.push(b)

    from_utf8_unchecked(out.view())
end unmarked_output

// The lines a run printed, with no empty line invented for the newline the last one ended with.
private text_lines(text: string) -> Buf[string]
    var out: Buf[string] = buf()

    if text == "" then return out

    val parts = split(text, "\n")

    for i in 0..<parts.len
        if i + 1 == parts.len && parts[i] == "" then ()
        else out.push(parts[i])

    out
end text_lines
