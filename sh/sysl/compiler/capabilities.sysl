module sh.sysl.compiler

import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}
import sysl.container.{Set, set}

// What a module says it needs of a machine, and what it gives up in exchange.
//
// **A capability is a property of the MODULE**, not of a file and not of a declaration, so every
// file of a module states the same clauses and its `@tests` files state one thing between them. What
// a clause leaves behind is the module's two sets -- what it requires, and what it narrowed away --
// and it is those the rest of the compiler asks.

const CapHeap: string = "heap"
const CapOs: string = "os"
const CapPosix: string = "posix"

// The capabilities there are, in the order a refusal lists them.
capability_core() -> Buf[string]
    var out: Buf[string] = buf()

    out.push(CapHeap)
    out.push(CapOs)
    out.push(CapPosix)
    out
end capability_core

// **The two directions are asked of different vocabularies.** A `requires` names a FACILITY the
// machine supplies and a narrowing names the CONDUCT a module gives up, and `alloc` and `heap` are
// the one pair where those are different words.
narrowed_by(word: string) -> Option[string] = word match
    "alloc" -> Some(CapHeap)
    "os" -> Some(CapOs)
    "posix" -> Some(CapPosix)
    _ -> None

// The word a narrowing is written with, for a capability named as a facility.
narrow_word(cap: string) -> string = cap match
    "heap" -> "alloc"
    _ -> cap

// Whether a name is a facility a machine supplies.
is_facility(name: string) -> bool = name == CapHeap || name == CapOs || name == CapPosix

// The environment capabilities a machine has by being the machine it is: an operating system unless
// it is freestanding, POSIX where the system's conventions are. **It is physical and deliberately
// not what a project provides** -- a manifest defaults every capability to provided, so a bare
// Cortex-M nominally offers `posix`, and a question asked of that would gate nothing.
inherent_capabilities(t: Target) -> Buf[string]
    var out: Buf[string] = buf()

    if os_hosted(t.os) then out.push(CapOs)
    if os_posix(t.os) then out.push(CapPosix)

    out
end inherent_capabilities

// A capability and the ones that come with it: requiring `posix` requires `os`.
capability_closure(cap: string) -> Buf[string]
    var out: Buf[string] = buf()

    out.push(cap)

    if cap == CapPosix then out.push(CapOs)

    out
end capability_closure

// Whether a clause is one the compiler actually enforces, which is what decides whether it is
// recorded at all.
private enforceable(c: CapabilityClause) -> bool = c.direction match
    Requires -> is_facility(c.name)
    Narrows -> narrowed_by(c.name).is_some()

// The capability a clause is about, as against the word it was written with.
private capability_of(c: CapabilityClause) -> string = c.direction match
    Requires -> c.name
    Narrows -> narrowed_by(c.name).unwrap_or(c.name)

// Reads every file's clauses, refuses the ones that are not clauses about anything, and holds the
// files of a module to agreeing.
//
// **The library's own headers are read and not checked.** They were checked when the library was
// built, so a complaint here would point at a file the program's author did not write.
read_capabilities(a: &Analysis, units: Buf[Program])
    for i in 0..<units.len()
        val unit = units.at(i)

        if !from_library(a, scope_of_unit(a, unit))
            for j in 0..<unit.capabilities.len()
                check_clause(a, unit, unit.capabilities.at(j))

            check_repeats(a, unit)

    check_module_agreement(a, units)
    record_capabilities(a, units)
end read_capabilities

// Refuses a clause that names nothing, or that names the facility where the conduct belongs.
private check_clause(a: &Analysis, u: Program, c: CapabilityClause)
    val scope = scope_of_unit(a, u)

    c.direction match
        Requires ->
            if !is_facility(c.name)
                // Naming what a module *does* where a facility belongs. `@requires(alloc)` is the
                // one that happens, since the narrowing beside it is spelled that way.
                if narrowed_by(c.name).is_some() then
                    a.fault(scope, c.span, s"'${c.name}' is what a module does, not something a " +
                            "machine has — a 'requires' names the facility, so this is " +
                            s"'@requires(${narrowed_by(c.name).unwrap()})'")
                else unknown_capability(a, scope, c)
        Narrows ->
            if narrowed_by(c.name).is_none()
                // The mirror image: naming the facility where the conduct belongs. `@no_heap` is
                // what a reader writes once, having seen `heap` in the config.
                if is_facility(c.name) then
                    a.fault(scope, c.span, s"'@no_${c.name}' says a machine has no ${c.name}, " +
                            "which is the project's to say and not this module's — what a module " +
                            "promises is what it does, so this is " +
                            s"'@no_${narrow_word(c.name)}'")
                else unknown_capability(a, scope, c)
end check_clause

private unknown_capability(a: &Analysis, scope: Scope, c: CapabilityClause)
    a.fault(scope, c.span, s"no capability is called '${c.name}' — the set is 'heap', 'os', 'posix'")

// Refuses a file that says the same thing about one capability twice, and one that says both things
// about it.
//
// The two are one check because they are one mistake: the module's set is what the clauses describe,
// and a capability appearing twice means the file's author believed two clauses were doing different
// work. Silently folding them would leave `no alloc` beside `requires alloc` meaning whichever the
// code happened to fold last.
private check_repeats(a: &Analysis, u: Program)
    val scope = scope_of_unit(a, u)

    for i in 0..<u.capabilities.len()
        val c = u.capabilities.at(i)

        if !enforceable(c) then continue

        // Grouped by the **capability** and not by the word, which is the whole reason this reads
        // the way it does: `@no_alloc` beside `requires heap` is one contradiction written in the
        // two vocabularies, and grouping by what was typed would have let it through.
        val cap = capability_of(c)
        val first = first_clause_about(u, cap)

        if first != i then continue

        val second = second_clause_about(u, cap)

        if second.is_none() then continue

        val other = u.capabilities.at(second.unwrap())

        if same_direction(c.direction, other.direction) then
            a.fault(scope, other.span, s"'${c.name}' is declared twice, and the second says " +
                    "nothing the first did not")
        else
            val both = if c.name != other.name then
                           s" — '@no_${narrow_word(cap)}' and 'requires $cap' are the two " +
                           "directions of one capability"
                       else ""

            a.fault(scope, other.span, s"'$cap' is both given up and required here, and a module " +
                    "cannot do without something it cannot be built without" + both)
end check_repeats

private same_direction(x: CapabilityDirection, y: CapabilityDirection) -> bool = x match
    Requires -> y match
        Requires -> true
        _ -> false
    Narrows -> y match
        Narrows -> true
        _ -> false

private first_clause_about(u: Program, cap: string) -> usize
    for i in 0..<u.capabilities.len()
        val c = u.capabilities.at(i)

        if enforceable(c) && capability_of(c) == cap then return i

    u.capabilities.len()
end first_clause_about

private second_clause_about(u: Program, cap: string) -> Option[usize]
    var seen = false

    for i in 0..<u.capabilities.len()
        val c = u.capabilities.at(i)

        if enforceable(c) && capability_of(c) == cap
            if seen then return Some(i)

            seen = true

    None
end second_clause_about

// Holds the files of one module to declaring the same clauses.
//
// **The files that ship and the files that do not are two groups, held apart.** A `@tests` file is
// dropped by every build but a test run, so the module's clause -- which is a promise about what a
// program linking this module may do -- is not a promise about it. The scaffolding is held to
// agreeing with *itself* for the reason the shipping files are held to agreeing with each other.
//
// The comparison is of the **set** of clauses rather than of the text: order between two clauses
// says nothing, and a file that wrote the same one twice is a separate mistake reported on its own
// line.
private check_module_agreement(a: &Analysis, units: Buf[Program])
    var seen: Buf[string] = buf()

    for i in 0..<units.len()
        val unit = units.at(i)

        if from_library(a, scope_of_unit(a, unit)) then continue

        val module_name = module_of_unit(unit)

        if holds_string(seen, module_name) then continue

        seen.push(module_name)

        agree_within(a, units, module_name, true)
        agree_within(a, units, module_name, false)
end check_module_agreement

private agree_within(a: &Analysis, units: Buf[Program], module_name: string, scaffolding: bool)
    var first: Option[Program] = None

    for i in 0..<units.len()
        val unit = units.at(i)

        if from_library(a, scope_of_unit(a, unit)) then continue
        if module_of_unit(unit) != module_name || unit.test_only != scaffolding then continue

        if first.is_none()
            first = Some(unit)
            continue
        end if

        if clauses_written(unit) == clauses_written(first.unwrap()) then continue

        // The two groups are held to agreeing for the same reason and are not held to each other,
        // so the sentence has to say which rule was broken -- a reader told that every file of the
        // module states the clause, having just been told a `@tests` file states its own, would
        // take one of the two for a lie.
        val whose = if scaffolding then
                        "the tests of a module are one body of scaffolding, so its '@tests' files " +
                        "state one thing between them"
                    else "a capability is a property of the module, so every one of its files " +
                         "states it"
        val whose_module = if module_name == "" then "the same module" else s"'$module_name'"

        a.fault(scope_of_unit(a, unit), disagreement_span(unit),
                s"${unit.src.name} and ${first.unwrap().src.name} are both files of " +
                s"$whose_module, and they declare different capabilities — $whose: " +
                s"${spell_clauses(unit)} against ${spell_clauses(first.unwrap())}")
end agree_within

// Where a disagreement is reported: the file's first clause, or its module header where it wrote
// none at all.
private disagreement_span(u: Program) -> Span
    if !u.capabilities.is_empty() then return u.capabilities.at(0).span

    u.module_name match
        Some(m) -> m.span
        None -> span_zero()
end disagreement_span

// One file's clauses as a set, so that the order two of them were written in says nothing.
private clauses_written(u: Program) -> string
    var out: Buf[string] = buf()

    for i in 0..<u.capabilities.len()
        val c = u.capabilities.at(i)
        val d = c.direction match
            Requires -> "requires"
            Narrows -> "narrows"

        out.push(s"$d ${c.name}")

    val sorted = sort_names(out)
    var joined = ""

    for i in 0..<sorted.len()
        joined = joined + sorted.at(i) + ";"

    joined
end clauses_written

// A file's clauses as a reader wrote them, for a message comparing two files.
private spell_clauses(u: Program) -> string
    if u.capabilities.is_empty() then return "none"

    var out = ""

    for i in 0..<u.capabilities.len()
        val c = u.capabilities.at(i)
        val one = c.direction match
            Narrows -> s"'@no_${c.name}'"
            Requires -> s"'@requires(${c.name})'"

        out = out + (if i > 0 then ", " else "") + one

    out
end spell_clauses

// -- what a module's clauses leave behind ----------------------------------------------------------

// Records each module's two sets, read off a file that **ships**: the header is one statement about
// the module however many files repeat it.
//
// Only the clauses the compiler enforces are kept, so a module that wrote something refused is left
// with the set it would have had without it -- which is what makes one mistake report once rather
// than again at every use of what the bad clause was about.
record_capabilities(a: &Analysis, units: Buf[Program])
    var seen: Buf[string] = buf()

    for i in 0..<units.len()
        val module_name = module_of_unit(units.at(i))

        if holds_string(seen, module_name) then continue

        seen.push(module_name)

        if supplied_unit(a, units.at(i)) then a.tables.supplied_modules.push(module_name)

        val shipped = first_file_of(units, module_name, false)
        val scaffolding = first_file_of(units, module_name, true)

        if shipped.is_some()
            record_module(a, module_name, shipped.unwrap())

        // After the module's own, because what the scaffolding states is an override of it.
        //
        // **A module with no `@tests` file still has tests' set, and it is the module's own**: a
        // `@test` written beside what it tests is scaffolding, and with no file taking anything back
        // it answers to the module's clause.
        if scaffolding.is_some()
            record_module_tests(a, module_name, shipped, scaffolding.unwrap())
        else
            for j in 0..<a.tables.module_narrows.len()
                val pair = a.tables.module_narrows.at(j)

                if pair.0 == module_name then a.tables.module_test_narrows.push(pair)
end record_capabilities

private first_file_of(units: Buf[Program], module_name: string, tests: bool) -> Option[Program]
    for i in 0..<units.len()
        val unit = units.at(i)

        if module_of_unit(unit) == module_name && unit.test_only == tests then return Some(unit)

    None
end first_file_of

private record_module(a: &Analysis, module_name: string, u: Program)
    for i in 0..<u.capabilities.len()
        val c = u.capabilities.at(i)

        if !enforceable(c) then continue

        val spread = implied_by(c)

        for j in 0..<spread.len()
            c.direction match
                Narrows -> a.tables.module_narrows.push((module_name, spread.at(j)))
                Requires ->
                    a.tables.module_requires.push((module_name, spread.at(j)))
                    unmet_by_target(a, module_name, u, c, spread.at(j))
end record_module

// Whether a file is one the program's author did not write: the standard module's, or one a
// library or a package handed over.
private supplied_unit(a: &Analysis, u: Program) -> bool =
    u.pkg.supplied || from_library(a, scope_of_unit(a, u))

// Refuses a module's requirement the machine does not meet, at the clause that states it.
//
// **What writing `requires` buys is this one clean error**, naming the module, the capability and
// the machine, where otherwise the build would fail somewhere inside whatever the module reached.
// Only the program's own modules are asked -- a library's clause is its author's -- and only a file
// that ships: a `@tests` file is analyzed and then dropped, so a requirement checked there would
// refuse a build over a facility only the discarded file wanted.
private unmet_by_target(a: &Analysis, module_name: string, u: Program, c: CapabilityClause,
                        cap: string)
    if !a.tables.target.lacks_capability(cap) then return
    if supplied_unit(a, u) then return

    val who = if module_name == ModuleRoot then "this module" else s"'$module_name'"

    a.fault(scope_of_unit(a, u), c.span,
            s"$who requires '$cap', and '${a.tables.target.name}' does not provide it — a " +
            "target's capabilities are what 'package.hocon' declares, so either the module cannot " +
            "be built for this machine or the config is understating it")
end unmet_by_target

// The tests' set is the module's own with the scaffolding's changes folded in, per capability: a
// `@tests` file writing no clause records the module's, one that requires a capability takes it back
// out of the narrowing, and one that narrows it narrows it whatever the module said.
//
// Only the narrowing is kept. What the scaffolding **requires** is not asked of the target, because
// every build but a test run analyzes a `@tests` file and then drops it.
private record_module_tests(a: &Analysis, module_name: string, shipped: Option[Program], u: Program)
    var taken_back: Buf[string] = buf()
    var narrowed: Buf[string] = buf()

    for i in 0..<u.capabilities.len()
        val c = u.capabilities.at(i)

        if !enforceable(c) then continue

        val spread = implied_by(c)

        for j in 0..<spread.len()
            c.direction match
                Requires -> taken_back.push(spread.at(j))
                Narrows -> narrowed.push(spread.at(j))

    // What the module gave up, less what the scaffolding took back.
    for i in 0..<a.tables.module_narrows.len()
        val pair = a.tables.module_narrows.at(i)

        if pair.0 == module_name && !holds_string(taken_back, pair.1) &&
                !holds_string(narrowed, pair.1) then
            a.tables.module_test_narrows.push(pair)

    for i in 0..<narrowed.len()
        a.tables.module_test_narrows.push((module_name, narrowed.at(i)))
        a.tables.module_test_own.push((module_name, narrowed.at(i)))
end record_module_tests

// A clause's capability and the ones that come with it, in whichever direction it points.
//
// The implication runs opposite ways for the two: **requiring** `posix` requires what `posix` needs,
// and **giving up** `os` gives up everything that needs `os`.
private implied_by(c: CapabilityClause) -> Buf[string]
    val cap = capability_of(c)

    c.direction match
        Requires -> capability_closure(cap)
        Narrows ->
            var out: Buf[string] = buf()

            out.push(cap)

            if cap == CapOs then out.push(CapPosix)

            out
end implied_by

// Whether a module gave a capability up, and the same asked of what its tests may do.
module_narrowed(a: &Analysis, module_name: string, cap: string) -> bool =
    holds_pair(a.tables.module_narrows, module_name, cap)

module_tests_narrowed(a: &Analysis, module_name: string, cap: string) -> bool =
    holds_pair(a.tables.module_test_narrows, module_name, cap)

// Whether the narrowing on the tests' side is one the `@tests` file wrote rather than one it
// inherited, which is what tells a reader which line to go and look at.
module_tests_own_narrowing(a: &Analysis, module_name: string, cap: string) -> bool =
    holds_pair(a.tables.module_test_own, module_name, cap)

private holds_pair(pairs: Buf[(string, string)], a: string, b: string) -> bool
    for i in 0..<pairs.len()
        if pairs.at(i).0 == a && pairs.at(i).1 == b then return true

    false
end holds_pair

// -- what a declaration needs, and whether the module reaching it has it ---------------------------

// Every declaration that wrote `@needs(...)`, as the capabilities it needs with their implications
// folded in -- a declaration needing `posix` needs `os`, whether or not it said so.
//
// Both tables are read because an `extern` is in both: a shim is filed so that a call resolves like
// any other, and the foreign declaration beside it is what a back end reads.
private declared_needs(a: &Analysis, cap: string) -> Buf[string]
    var out: Buf[string] = buf()

    for i in 0..<a.tables.funcs.len()
        if needs_capability(a.tables.funcs.at(i).decl.needs, cap) then out.push(a.tables.funcs.key_at(i))

    for i in 0..<a.tables.externs.len()
        val key = a.tables.externs.key_at(i)

        if !holds_string(out, key) && needs_capability(a.tables.externs.at(i).needs, cap) then
            out.push(key)

    out
end declared_needs

// Says that the body about to be read is `d`'s, for the edges it makes; hands back what was said
// before, which `leave_reaching` puts back. A body read while another is open -- an instantiation
// asked for from inside a call -- is its own declaration's and not the caller's.
enter_reaching(a: &Analysis, d: FuncDecl) -> (Buf[string], bool)
    val saved = (a.tables.reaching_needs, a.tables.reaching_test)

    a.tables.reaching_needs = covered_by(d.needs)
    a.tables.reaching_test = d.test.is_some()
    saved
end enter_reaching

// What a declaration's `@needs(...)` covers, implications folded in. A name nothing has heard of
// covers nothing; `check_needs_names` refuses it.
private covered_by(written: Buf[string]) -> Buf[string]
    var needs: Buf[string] = buf()
    val core = capability_core()

    for i in 0..<core.len()
        if needs_capability(written, core.at(i)) then needs.push(core.at(i))

    needs
end covered_by

// Says that what is about to be resolved is the SIGNATURE of a declaration needing `needs`, which is
// covered exactly as its body is: a parameter or result naming a type of a gated module is something
// only a caller of the declaration meets. **What the declaration covers replaces what the enclosing
// reading covered** -- a signature is its declaration's own, wherever the request to resolve it came
// from. `leave_reaching` puts back what was there.
enter_signature(a: &Analysis, needs: Buf[string]) -> (Buf[string], bool)
    val saved = (a.tables.reaching_needs, a.tables.reaching_test)

    a.tables.reaching_needs = covered_by(needs)
    saved
end enter_signature

// One type of a declaration's signature, resolved under that declaration's `@needs(...)`.
signature_type(a: &Analysis, needs: Buf[string], scope: Scope, written: TypeRef,
               subst: Buf[Binding]) -> Type
    val saved = enter_signature(a, needs)
    val ty = resolve_type(a, scope, written, subst)

    leave_reaching(a, saved)
    ty
end signature_type

// A declaration's RESULT, resolved under its `@needs(...)` -- the one signature position `never`
// may stand in, so it reads through `resolve_result` where a parameter reads through `resolve_type`.
signature_result(a: &Analysis, needs: Buf[string], scope: Scope, written: TypeRef,
                 subst: Buf[Binding]) -> Type
    val saved = enter_signature(a, needs)
    val ty = resolve_result(a, scope, written, subst)

    leave_reaching(a, saved)
    ty
end signature_result

leave_reaching(a: &Analysis, saved: (Buf[string], bool))
    a.tables.reaching_needs = saved.0
    a.tables.reaching_test = saved.1

// Records that the body lowered under `name` was read inside a declaration that wrote `@needs(...)`
// -- the declaration's own, or a closure or nested function written in it, which is reached only
// through it and filed under a name no declaration carries.
note_body_covers(a: &Analysis, name: string)
    if !a.tables.reaching_needs.is_empty() then
        a.tables.body_covers.push((name, a.tables.reaching_needs))

// Whether the body lowered under `name` is one whose declaration covers `cap`.
private body_covers(a: &Analysis, name: string, cap: string) -> bool
    for i in 0..<a.tables.body_covers.len()
        if a.tables.body_covers.at(i).0 == name && holds_string(a.tables.body_covers.at(i).1, cap) then
            return true

    false
end body_covers

private needs_capability(needs: Buf[string], cap: string) -> bool
    for i in 0..<needs.len()
        if !is_facility(needs.at(i)) then continue

        val spread = capability_closure(needs.at(i))

        if holds_string(spread, cap) then return true

    false
end needs_capability

// Refuses a `@needs` naming nothing, said the way a file header's clause says it -- one vocabulary,
// one message, whichever position the mistake was written in.
//
// `alloc` is the one worth its own sentence: it is what a module *does*, and a `@needs` names the
// facility, so somebody who wrote `@needs(alloc)` beside the `@no_alloc` they had just read meant
// `@needs(heap)`.
private check_needs_names(a: &Analysis)
    for i in 0..<a.tables.funcs.len()
        val f = a.tables.funcs.at(i)

        for j in 0..<f.decl.needs.len()
            val cap = f.decl.needs.at(j)

            if is_facility(cap) then continue

            if narrowed_by(cap).is_some() then
                a.fault(f.scope, f.span, s"'$cap' is what a module does, not something a machine " +
                        "has — a '@needs' names the facility, so this is " +
                        s"'@needs(${narrowed_by(cap).unwrap()})'")
            else
                a.fault(f.scope, f.span, s"no capability is called '$cap' — the set is 'heap', " +
                        "'os', 'posix'")
end check_needs_names

// Whether a module is without a capability -- because it gave the capability up, or because the
// target it is being built for never had it.
//
// **Only the module's half moves between a module and its tests.** A `@tests` file may take back
// what the module gave up, because the module's clause is a promise about what ships and the file
// does not ship; it cannot take back what the machine never had. The library is exempt from the
// target's half, as it is at an edge: its files are compiled into every program, and a mistake in
// them is not one this compilation's author can change.
private lacks(a: &Analysis, scope: Scope, module_name: string, cap: string, scaffolding: bool) -> bool
    val narrowed = if scaffolding then module_tests_narrowed(a, module_name, cap)
    else module_narrowed(a, module_name, cap)

    narrowed || target_lacks_for(a, scope, module_name, cap)
end lacks

// Whether the machine lacks an environment capability, asked for a module of the program's own.
private target_lacks_for(a: &Analysis, scope: Scope, module_name: string, cap: string) -> bool =
    is_environment(cap) && a.tables.target.lacks_capability(cap) && !from_library(a, scope) &&
        !holds_string(a.tables.supplied_modules, module_name)

// Which of the two put the capability out of reach, said the way the diagnostic needs it. A reader
// told their module "declared 'no os'" when no file of it says any such thing would go looking for a
// clause that is not there.
private why_lacking(a: &Analysis, module_name: string, cap: string, scaffolding: bool) -> string
    val word = narrow_word(cap)
    val here = if module_name == "" then "this module" else s"'$module_name'"

    if scaffolding && module_tests_own_narrowing(a, module_name, cap) then
        return s"the '@tests' file of $here declared '@no_$word'"

    val narrowed = if scaffolding then module_tests_narrowed(a, module_name, cap)
    else module_narrowed(a, module_name, cap)

    if narrowed then return s"$here declared '@no_$word'"

    target_lacks_it(a)
end why_lacking

// Refuses a `@needs(...)` naming something that is not a capability, and reports every reference
// from a module that does not have what the declaration it reaches requires.
//
// It runs beside the allocator-free check, over the same finished tree and for the same reason: what
// reaches what is a property of the typed program rather than of any one place in the analyzer.
check_decl_capabilities(a: &Analysis, funcs: Buf[TFunc], vals: Buf[TVal], vtables: Buf[TVtable])
    check_needs_names(a)

    val core = capability_core()

    // One walk per capability rather than one per declaration: what a reader has to change is the
    // reference, and a reference refused for two capabilities at once is one line with one fix.
    for c in 0..<core.len()
        val cap = core.at(c)
        val seeds = declared_needs(a, cap)

        // Almost every compilation writes no `@needs` at all, and the walk reads every body -- so
        // one with nothing to ask pays nothing for it.
        if seeds.is_empty() then continue

        val walk = reaches_over(funcs, vtables, seeds)

        for i in 0..<funcs.len()
            val f = funcs.at(i)

            // A generic is answered for by the body it was written as, exactly as `no_alloc.sysl`
            // answers it: an instantiation belongs to whoever chose the type, in a module of their
            // own, and is reported at *their* call.
            if a.tables.members.func_origin.has(f.name) then continue

            // A body whose own declaration needs the capability is left alone for it: what that body
            // reaches is charged to whoever reaches the declaration, and they are checked at their
            // call. Asked of its module instead, a program's own `@needs(os)` function on a machine
            // with no operating system would be refused for doing what its annotation says it does.
            if body_covers(a, f.name, cap) then continue

            val module_name = module_of(f.name)
            val scope = func_home(a, f.name)

            // The file rather than the emitted name, for the reason `no_alloc.sysl` gives: an
            // instantiation of a generic declared in a `@tests` file is filed under a name that file
            // never recorded.
            val scaffolding = test_only_file(a, scope.src.name)

            if !lacks(a, scope, module_name, cap, scaffolding) then continue

            blame_needs(a, walk, scope, f.body, cap,
                        why_lacking(a, module_name, cap, scaffolding))

        for i in 0..<vals.len()
            val v = vals.at(i)

            if v.init.is_none() then continue

            val module_name = module_of(v.symbol)
            val scaffolding = holds_string(a.tables.test_only, v.symbol)
            val d = a.tables.vals.get(v.symbol)
            val scope = if d.is_some() then d.unwrap().scope else empty_scope()

            if !lacks(a, scope, module_name, cap, scaffolding) then continue

            blame_needs_expr(a, walk, scope, v.init.unwrap(), cap,
                             why_lacking(a, module_name, cap, scaffolding))
end check_decl_capabilities

private blame_needs(a: &Analysis, walk: &Reaches, scope: Scope, b: TBlock, cap: string, why: string)
    walk_block_stmts(b, TWalk(false, e -> blame_needs_one(a, walk, scope, e, cap, why),
                              w -> (), st -> ()))
end blame_needs

private blame_needs_expr(a: &Analysis, walk: &Reaches, scope: Scope, e: TExpr, cap: string,
                         why: string)
    walk_texpr(e, TWalk(false, n -> blame_needs_one(a, walk, scope, n, cap, why), w -> (), st -> ()))
end blame_needs_expr

private blame_needs_one(a: &Analysis, walk: &Reaches, scope: Scope, e: TExpr, cap: string,
                        why: string)
    val mine = least_seed(walk, own_refs(e))

    if mine.is_none() then return
    if reaches_a_seed(walk, strict_refs(e)) then return

    a.fault(scope, e.span, s"this reaches '${qualified_name(mine.unwrap())}', which needs '$cap', " +
            s"and $why")
end blame_needs_one

// -- what a module that gave up an environment capability may not reach ----------------------------

// The two capabilities that gate whether a MODULE exists, as against what a body may do.
//
// `heap` changes what the *language* allows, so it is checked at each construction that makes heap
// storage and at each call arriving at one -- it has to be, the standard module being one module of
// which half allocates. `os` and `posix` gate which modules exist at all, which is a statement about
// a module rather than about any declaration in it: a program either may name `sysl.fs` or may not,
// and every declaration in that module is equally out of reach.
private is_environment(cap: string) -> bool = cap == CapOs || cap == CapPosix

// What each module needs an operating system for: its own clause plus everything it reaches.
//
// **A requirement is transitive**, since what a module offers is only reachable because the module
// is -- so a module that gave `os` up may not get at `sysl.fs` by going through something else that
// can. The answer is taken as a FIXPOINT over the edges rather than by a walk, because a program
// whose module graph has a cycle is a diagnostic of its own and must not also be a walk that never
// ends.
//
// **Only an edge the module SHIPS counts toward what it requires.** One made inside a declaration
// that wrote `@needs(...)` is charged to whoever reaches that declaration, and one made in a `@tests`
// file or a `@test` function is scaffolding every build but a test run drops -- neither says anything
// about what a program that links the module needs.
private environment_requirements(a: &Analysis) -> Buf[(string, string)]
    var out: Buf[(string, string)] = buf()

    for i in 0..<a.tables.module_requires.len()
        val pair = a.tables.module_requires.at(i)

        if is_environment(pair.1) && !holds_pair(out, pair.0, pair.1) then out.push(pair)

    var grew = true

    while grew
        grew = false

        for i in 0..<a.tables.capability_refs.len()
            val r = a.tables.capability_refs.at(i)

            if r.scaffolding || !r.charges() then continue

            for k in 0..<out.len()
                val cap = out.at(k).1

                if out.at(k).0 != r.to || holds_string(effective_needs(a, r), cap) ||
                   holds_pair(out, r.from, cap) then
                    continue

                out.push((r.from, cap))
                grew = true

    out
end environment_requirements

// What a reference covers, an `import` being charged by its uses.
//
// **An import is charged by what the references along its edge are charged with**: a file that
// imports `sysl.fs.write_bytes` for its one `@needs(os)` function has said what that function may
// write, not that the module reads files. So an import covers whatever EVERY shipping reference
// along the same edge covers -- nothing, the moment one of them sits in a declaration that wrote no
// `@needs`, which then charges the module at the import as it always did. An import nothing
// references is charged as written, there being no use to read it by.
private effective_needs(a: &Analysis, r: CapabilityRef) -> Buf[string]
    if !r.imported then return r.needs

    var lifted: Option[Buf[string]] = None
    var named_only = false

    for i in 0..<a.tables.capability_refs.len()
        val u = a.tables.capability_refs.at(i)

        if u.from != r.from || u.to != r.to || u.imported || u.scaffolding then continue

        // A use that only names a type runs nothing, so it is a use that covers everything.
        if !u.charges()
            named_only = true
            continue

        if lifted.is_none()
            lifted = Some(u.needs)
            continue

        var both: Buf[string] = buf()

        for j in 0..<u.needs.len()
            if holds_string(lifted.unwrap(), u.needs.at(j)) then both.push(u.needs.at(j))

        lifted = Some(both)

    if lifted.is_none() && named_only then return capability_core()

    var out: Buf[string] = buf()

    for i in 0..<r.needs.len()
        out.push(r.needs.at(i))

    if lifted.is_some()
        val more = lifted.unwrap()

        for i in 0..<more.len()
            if !holds_string(out, more.at(i)) then out.push(more.at(i))

    out
end effective_needs

// The capability one reference is refused for, which is the least by name where it is refused for
// more than one -- so the message does not vary between runs with the order a table happens to be in.
//
// **The two halves are one question**: a module's effective set is the target's intersected with its
// own narrowing, so a capability is out of reach whichever of the two removed it. The target's half
// is asked only of a reference the program's author made -- an edge inside a library is its
// author's, and a library's gated module refuses only the programs that actually reach it. What the
// declaration the reference was written in names in its `@needs` is that declaration's callers'
// question, not this one's.
private refused_for(a: &Analysis, e: CapabilityRef, needed: Buf[(string, string)]) -> Option[string]
    if !e.charges() then return None

    val core = capability_core()
    val ours = !from_library(a, e.scope) && !holds_string(a.tables.supplied_modules, e.from)
    val covers = effective_needs(a, e)

    for i in 0..<core.len()
        val cap = core.at(i)

        if !is_environment(cap) || holds_string(covers, cap) then continue
        if !holds_pair(needed, e.to, cap) then continue
        if module_narrowed(a, e.from, cap) then return Some(cap)
        if ours && a.tables.target.lacks_capability(cap) then return Some(cap)

    None
end refused_for

// Reports every reference into a module that requires an environment capability the reaching module
// gave up.
//
// **The edge is the unit, and the diagnostic lands at the reference that made it** -- the place a
// reader has to change -- rather than at the clause, which is where it would land if the check were
// about a module's own text. It runs beside the other whole-program checks, over the settled module
// graph, because an edge is made by a reference and a reference may be anywhere a body is.
check_gated_modules(a: &Analysis, funcs: Buf[TFunc], vals: Buf[TVal], vtables: Buf[TVtable])
    var any = false

    for i in 0..<a.tables.module_narrows.len()
        if is_environment(a.tables.module_narrows.at(i).1) then any = true

    if a.tables.target.lacks_capability(CapOs) || a.tables.target.lacks_capability(CapPosix) then
        any = true

    // Nothing narrowed anything and the machine has everything, which is almost every compilation:
    // the walk below reads every edge, and one with no question to ask should pay nothing for it.
    if !any then return

    settle_named_refs(a)
    note_call_refs(a, funcs, vals, vtables)

    val needed = environment_requirements(a)
    var told: Buf[(string, string)] = buf()

    // An edge is refused once, at the first reference to it that is refused -- one written inside a
    // declaration that wrote `@needs` for the capability is charged where that declaration is
    // reached instead, so the caret lands on a line there is something to change on. The edges are
    // read in the order their references were made, which is the order the module graph made them
    // in, plus the ones only a call made: a value of a gated type can arrive without its type being
    // written anywhere, and the call of its method is then the only reference there is.
    for i in 0..<a.tables.capability_refs.len()
        val edge = a.tables.capability_refs.at(i)

        if holds_pair(told, edge.from, edge.to) then continue

        told.push((edge.from, edge.to))

        // A value that can die is reported ahead of the rest: the destructor is the code it costs,
        // and the place it is held is the line to change, where an import that let it be named is
        // only what made that line possible.
        var first: Option[(CapabilityRef, string)] = None

        for j in i..<a.tables.capability_refs.len()
            val e = a.tables.capability_refs.at(j)

            if e.from != edge.from || e.to != edge.to then continue

            val cap = refused_for(a, e, needed)

            if cap.is_none() then continue

            if e.dies
                first = Some((e, cap.unwrap()))
                break

            if first.is_none() then first = Some((e, cap.unwrap()))

        if first.is_none() then continue

        val e = first.unwrap().0
        val cap = first.unwrap().1
        val why = if module_narrowed(a, e.from, cap) then gave_it_up(e.from, cap) else target_lacks_it(a)
        val what = if e.dies then s"a '${qualified_name(e.named)}' can die here, and its destructor"
        else "this"

        a.fault(e.scope, e.span, s"$what reaches '${qualified_name(e.to)}', which requires '$cap', and $why")
end check_gated_modules

// -- a type is charged for the code it runs -------------------------------------------------------

// Makes a reference that only NAMED a type an ordinary one where a value of the type can die there
// and the type, or something it holds, has a destructor -- the one piece of the type's code that runs
// without anybody calling it. It is asked here rather than where the name was read, because a type's
// fields are not all laid out until every declaration has been.
private settle_named_refs(a: &Analysis)
    val dying = destructor_holders(a)

    for i in 0..<a.tables.capability_refs.len()
        val r = a.tables.capability_refs.at(i)

        if r.named == "" || !holds_string(dying, r.named) then continue

        a.tables.capability_refs.set(i, CapabilityRef(r.from, r.to, r.scope, r.span, r.needs,
                                                      r.scaffolding, r.imported, r.named, true))
end settle_named_refs

// The declarations a value of which runs a destructor when it dies: every type a `Drop` block was
// written for, and every type that holds one -- in a field, a variant, a box, an array or a view --
// by the key a written name resolves to.
private destructor_holders(a: &Analysis) -> Buf[string]
    val drops = drops_declared(a)
    var out: Buf[string] = buf()

    if drops.is_empty() then return out

    for i in 0..<drops.len()
        out.push(drops.at(i))

    val tables = [a.tables.struct_insts, a.tables.enum_insts]

    for k in 0..<tables.len
        val t = tables[k]

        for i in 0..<t.len()
            val ty = t.at(i)
            val base = type_base(ty)

            if base == "" || holds_string(out, base) then continue

            var seen: Buf[string] = buf()

            if holds_destructor(ty, drops, &seen) then out.push(base)

    out
end destructor_holders

private type_base(t: Type) -> string = t match
    Struct(d) -> d.base
    Enum(d) -> d.base
    _ -> ""

// Whether a value of `t` runs a destructor when it dies. A raw pointer and a weak reference own
// nothing; a box, an array, a view and every field or payload own what they hold.
private holds_destructor(t: Type, drops: Buf[string], seen: *Buf[string]) -> bool
    t match
        Struct(d) ->
            if holds_string(drops, d.base) then return true
            if holds_string(*seen, d.name()) then return false

            seen.push(d.name())
            fields_hold(d.fields, drops, seen)
        Results(d) -> fields_hold(d.fields, drops, seen)
        Enum(d) ->
            if holds_string(drops, d.base) then return true
            if holds_string(*seen, d.name()) then return false

            seen.push(d.name())

            for i in 0..<d.variants.len()
                if fields_hold(d.variants.at(i).fields, drops, seen) then return true

            false
        Ref(inner, _) -> holds_destructor(*inner, drops, seen)
        Volatile(inner) -> holds_destructor(*inner, drops, seen)
        Array(_, elem) -> holds_destructor(*elem, drops, seen)
        Slice(elem, _) -> holds_destructor(*elem, drops, seen)
        Constrained(d) -> holds_destructor(d.base, drops, seen)
        Pack(elems) ->
            for i in 0..<elems.len()
                if holds_destructor(elems.at(i), drops, seen) then return true

            false
        _ -> false
end holds_destructor

private fields_hold(fields: Buf[(string, Type)], drops: Buf[string], seen: *Buf[string]) -> bool
    for i in 0..<fields.len()
        if holds_destructor(fields.at(i).1, drops, seen) then return true

    false
end fields_hold

// Records an edge for every call a shipping body makes into another module -- a method, an
// operator, a conversion, an invariant's check -- which is the code a type runs where a value of it
// is used. A value can arrive without its type being written (handed back by a call, read out of a
// field), and naming the type is no longer what charges for it, so the call has to.
//
// **An instantiation is answered for by the body it was written as**, as everywhere in this file:
// a generic's body calling its argument's method runs in whichever module chose the argument.
private note_call_refs(a: &Analysis, funcs: Buf[TFunc], vals: Buf[TVal], vtables: Buf[TVtable])
    var known: Set[string] = set()

    for i in 0..<a.tables.capability_refs.len()
        val r = a.tables.capability_refs.at(i)

        if r.charges() && !r.imported then known.add(ref_terms(r.from, r.to, r.needs, r.scaffolding))

    for i in 0..<funcs.len()
        val f = funcs.at(i)

        if a.tables.members.func_origin.has(f.name) then continue

        val scope = func_home(a, f.name)
        val scaffolding = test_only_file(a, scope.src.name) || holds_string(a.tables.test_only, f.name)
        var calls: Buf[(string, Span)] = buf()
        val sink = &calls

        walk_block_stmts(f.body, TWalk(false, e -> note_calls(sink, vtables, e), w -> (), st -> ()))
        charge_calls(a, &known, home_module(a, f.name), scope, body_needs(a, f.name), scaffolding, calls)

    for i in 0..<vals.len()
        val v = vals.at(i)

        if v.init.is_none() then continue

        val d = a.tables.vals.get(v.symbol)
        val scope = if d.is_some() then d.unwrap().scope else empty_scope()
        var calls: Buf[(string, Span)] = buf()
        val sink = &calls

        walk_texpr(v.init.unwrap(), TWalk(false, e -> note_calls(sink, vtables, e), w -> (), st -> ()))
        charge_calls(a, &known, module_of(v.symbol), scope, buf(), holds_string(a.tables.test_only, v.symbol),
                     calls)
end note_call_refs

// Records one charging reference per kind of use an edge has not yet seen, at the first call making it.
private charge_calls(a: &Analysis, known: *Set[string], from: string, scope: Scope, needs: Buf[string],
                     scaffolding: bool, calls: Buf[(string, Span)])
    for j in 0..<calls.len()
        val to = home_module(a, calls.at(j).0)

        if to == from || to == ModuleRoot || !a.tables.has_module(to) then continue

        // An edge already charged on the same terms gains nothing from the call.
        if !known.add(ref_terms(from, to, needs, scaffolding)) then continue

        a.tables.capability_refs.push(CapabilityRef(from, to, scope, calls.at(j).1, needs, scaffolding,
                                                    false, "", false))
end charge_calls

// What one node runs: the functions it calls or takes the address of, and the implementations behind
// a table it erased a value into.
private note_calls(sink: *Buf[(string, Span)], vtables: Buf[TVtable], e: TExpr)
    val refs = own_refs(e)

    for i in 0..<refs.calls.len()
        sink.push((refs.calls.at(i), e.span))

    for i in 0..<refs.erased.len()
        for k in 0..<vtables.len()
            val t = vtables.at(k)

            if t.name != refs.erased.at(i) then continue

            for m in 0..<t.slots.len()
                sink.push((t.slots.at(m).target, e.span))
end note_calls

// One key for the terms a charging reference is made on, its covered capabilities sorted by the
// order the core lists them in so two spellings of one set are one key.
private ref_terms(from: string, to: string, needs: Buf[string], scaffolding: bool) -> string
    val core = capability_core()
    var out = s"$from\t$to\t" + (if scaffolding then "tests" else "ships")

    for i in 0..<core.len()
        if holds_string(needs, core.at(i)) then out = out + "\t" + core.at(i)

    out
end ref_terms

// The module a body was written in, which is not always the one its symbol names: a member of an
// `impl` written for another module's type is lowered under the receiver's.
private home_module(a: &Analysis, name: string) -> string
    val home = a.tables.homes.get(name)

    if home.is_some() && home.unwrap().src.name != "" then return home.unwrap().module_name

    module_of(name)
end home_module

// What the declaration a body was read under covers, which is what reaching it is charged with.
private body_needs(a: &Analysis, name: string) -> Buf[string]
    for i in 0..<a.tables.body_covers.len()
        if a.tables.body_covers.at(i).0 == name then return a.tables.body_covers.at(i).1

    buf()
end body_needs

// Why an edge is refused where its module gave the capability up.
private gave_it_up(from: string, cap: string) -> string
    val here = if from == "" then "this module" else s"'$from'"

    s"$here declared 'no $cap' — an environment capability gates which modules exist, so a " +
        "module that gave one up may not reach one that needs it"
end gave_it_up

// Why an edge is refused where the machine never had the capability.
private target_lacks_it(a: &Analysis) -> string =
    s"'${a.tables.target.name}' does not provide it — a target's capabilities are what " +
        "'package.hocon' declares, so either this reference cannot be made on this machine or the " +
        "config is understating it"
