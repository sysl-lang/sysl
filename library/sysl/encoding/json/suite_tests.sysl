    refuses(&fails, "n_structure_open_array_comma", [0x5b, 0x2c])
    refuses(&fails, "n_structure_open_array_open_object", [0x5b, 0x7b])
    refuses(&fails, "n_structure_open_array_open_string", [0x5b, 0x22, 0x61])
    refuses(&fails, "n_structure_open_array_string", [0x5b, 0x22, 0x61, 0x22])
    refuses(&fails, "n_structure_open_object", [0x7b])
    refuses(&fails, "n_structure_open_object_close_array", [0x7b, 0x5d])
    refuses(&fails, "n_structure_open_object_comma", [0x7b, 0x2c])
    refuses(&fails, "n_structure_open_object_open_array", [0x7b, 0x5b])
    refuses(&fails, "n_structure_open_object_open_string", [0x7b, 0x22, 0x61])
    refuses(&fails, "n_structure_open_object_string_with_apostrophes", [0x7b, 0x27, 0x61, 0x27])
    refuses(&fails, "n_structure_open_open", [0x5b, 0x22, 0x5c, 0x7b, 0x5b, 0x22, 0x5c, 0x7b, 0x5b, 0x22, 0x5c, 0x7b, 0x5b, 0x22, 0x5c, 0x7b])
    refuses(&fails, "n_structure_single_eacute", [0xe9])
    refuses(&fails, "n_structure_single_star", [0x2a])
    refuses(&fails, "n_structure_trailing_#", [0x7b, 0x22, 0x61, 0x22, 0x3a, 0x22, 0x62, 0x22, 0x7d, 0x23, 0x7b, 0x7d])
    refuses(&fails, "n_structure_uescaped_LF_before_string", [0x5b, 0x5c, 0x75, 0x30, 0x30, 0x30, 0x41, 0x22, 0x22, 0x5d])
    refuses(&fails, "n_structure_unclosed_array", [0x5b, 0x31])
    refuses(&fails, "n_structure_unclosed_array_partial_null", [0x5b, 0x20, 0x66, 0x61, 0x6c, 0x73, 0x65, 0x2c, 0x20, 0x6e, 0x75, 0x6c])
    refuses(&fails, "n_structure_unclosed_array_unfinished_false", [0x5b, 0x20, 0x74, 0x72, 0x75, 0x65, 0x2c, 0x20, 0x66, 0x61, 0x6c, 0x73])
    refuses(&fails, "n_structure_unclosed_array_unfinished_true", [0x5b, 0x20, 0x66, 0x61, 0x6c, 0x73, 0x65, 0x2c, 0x20, 0x74, 0x72, 0x75])
    refuses(&fails, "n_structure_unclosed_object", [0x7b, 0x22, 0x61, 0x73, 0x64, 0x22, 0x3a, 0x22, 0x61, 0x73, 0x64, 0x22])
    refuses(&fails, "n_structure_unicode-identifier", [0xc3, 0xa5])
    refuses(&fails, "n_structure_whitespace_U+2060_word_joiner", [0x5b, 0xe2, 0x81, 0xa0, 0x5d])
    refuses(&fails, "n_structure_whitespace_formfeed", [0x5b, 0x0c, 0x5d])

    assert_eq(listed(fails), "")
end json_suite_refuses

@test("and the two that nest a hundred thousand deep are refused for their depth")
json_suite_refuses_the_deep_ones()
    var b: Buf[u8] = buf()

    for _ in 0..<100000 do b.push(u8('['))

    assert_eq(str(parse_bytes(b.view()).unwrap_err().fault), "arrays and objects nested more than 128 deep")

    var c: Buf[u8] = buf()

    for _ in 0..<50000 do c.extend("[{\"\":".bytes)

    assert(parse_bytes(c.view()).is_err())
end json_suite_refuses_the_deep_ones
