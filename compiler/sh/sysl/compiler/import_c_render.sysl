module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.slices.contains as ic_contains
import sysl.text.{Search, StrBuilder, join, split, str_builder, to_lower, to_upper}

// **What `sysl import-c` writes for what it read** (`import_c.sysl` reads it): the names, the type
// mapping, which records can be laid out, and the module's text.
//
// **The mapping is the house's, written once.** A `const char *` and a `void *` are `*u8`; a
// typedef'd record is a `struct` named for the typedef with the prefix and `_t` taken off; a handle
// is an `opaque struct`; a callback typedef is a `type` alias of a `*extern(...)`; an enum is a
// `c type`, so its width is the target's; C's `long` is a `c type` too, being four bytes on one
// machine and eight on the next. Explicit widths everywhere else, as the reference asks of foreign
// code.

// Where a type sits, which decides what C means by it: an array is storage in a field and a pointer
// in a parameter, `void` is only a result, and a record behind a pointer needs no layout.
private const IcAtField: int = 0
private const IcAtParam: int = 1
private const IcAtResult: int = 2
private const IcAtPointee: int = 3

// ## Names

private ic_upper_byte(c: u8) -> bool = c >= u8('A') && c <= u8('Z')

private ic_lower_or_digit(c: u8) -> bool = (c >= u8('a') && c <= u8('z')) || (c >= u8('0') && c <= u8('9'))

// `name` with the prefix taken off, matched without regard to case: `ts_` takes `ts_parser_new` to
// `parser_new` and `TSNode` to `Node`. Written without its underscore the prefix only matches where a
// capital or an underscore follows, so `ts_` does not take `tsunami` to `unami`.
private ic_strip(name: string, prefix: string) -> string
    if prefix == "" then return name

    val lower = to_lower(name)
    val p = to_lower(prefix)
    var out = name

    if lower.starts_with(p) && name.len > p.len
        out = name[p.len..<name.len]
    else
        val bare = if p.ends_with("_") then p[0..<p.len - 1] else p

        if bare != "" && lower.starts_with(bare) && name.len > bare.len
            val next = name.bytes[bare.len]

            if next == u8('_') || ic_upper_byte(next) then out = name[bare.len..<name.len]
        end if

    while out.starts_with("_") && out.len > 1 do out = out[1..<out.len]

    if out.bytes[0] >= u8('0') && out.bytes[0] <= u8('9') then name else out
end ic_strip

// A type's sysl name: prefix and `_t` off, then each underscore-separated piece capitalised --
// `uv_tcp_t` to `Tcp`, `fx_point` to `Point`, `TSQueryCursor` to `QueryCursor`.
ic_type_name(name: string, prefix: string) -> string
    var s = ic_strip(name, prefix)

    if s.ends_with("_t") && s.len > 2 then s = s[0..<s.len - 2]

    var out = str_builder()

    for piece in ic_pieces(s)
        out.push(to_upper(piece[0..<1]))
        out.push(piece[1..<piece.len])

    val made = out.finish()

    if made == "" then name else made
end ic_type_name

private ic_pieces(s: string) -> Buf[string]
    var out: Buf[string] = buf()
    var start: usize = 0

    for k in 0..<s.len + 1
        if k == s.len || s.bytes[k] == u8('_')
            if k > start then out.push(s[start..<k])

            start = k + 1
        end if

    out

// A constant's sysl name: prefix off, then SCREAMING_SNAKE -- `TSQuantifierZero` to
// `QUANTIFIER_ZERO`, `FX_MODE_ON` to `MODE_ON`.
ic_const_name(name: string, prefix: string) -> string = ic_screaming(ic_strip(name, prefix))

ic_screaming(s: string) -> string
    var out = str_builder()
    val b = s.bytes

    for k in 0..<b.len
        val c = b[k]

        if k > 0 && ic_upper_byte(c)
            val after_lower = ic_lower_or_digit(b[k - 1])
            val word_start = ic_upper_byte(b[k - 1]) && k + 1 < b.len && b[k + 1] >= u8('a') && b[k + 1] <= u8('z')

            if after_lower || word_start then out.push("_")
        end if

        out.push(s[k..<k + 1])

    to_upper(out.finish())
end ic_screaming

// A function's or a variable's sysl name: the prefix off and nothing else.
ic_value_name(name: string, prefix: string) -> string = ic_strip(name, prefix)

// A name as sysl must write it: a reserved word between backticks.
ic_ident(name: string) -> string = if is_reserved(name) then s"`$name`" else name

private ic_unique(used: *Buf[string], name: string) -> string
    var out = name
    var n = 2

    loop
        var taken = false

        for k in 0..<used.len()
            if used.at(k) == out then taken = true

        if !taken then break

        out = s"${name}_$n"
        n += 1

    used.push(out)
    out
end ic_unique

// ## Types

// A plain `char` is `i8` as a value -- it is signed on the machines most C is built for, and a value
// is where the sign is extended -- and `u8` behind a pointer, where it is bytes (`ic_map_named`).
private ic_builtin(spec: string) -> Option[string] = spec match
    "char" -> Some("i8")
    "signed char" -> Some("i8")
    "unsigned char" -> Some("u8")
    "short" -> Some("i16")
    "short int" -> Some("i16")
    "signed short" -> Some("i16")
    "unsigned short" -> Some("u16")
    "unsigned short int" -> Some("u16")
    "int" -> Some("i32")
    "signed" -> Some("i32")
    "signed int" -> Some("i32")
    "unsigned" -> Some("u32")
    "unsigned int" -> Some("u32")
    "long" -> Some("CLong")
    "long int" -> Some("CLong")
    "signed long" -> Some("CLong")
    "unsigned long" -> Some("CULong")
    "unsigned long int" -> Some("CULong")
    "long long" -> Some("i64")
    "long long int" -> Some("i64")
    "unsigned long long" -> Some("u64")
    "unsigned long long int" -> Some("u64")
    "__int128" -> Some("i128")
    "unsigned __int128" -> Some("u128")
    "float" -> Some("f32")
    "double" -> Some("f64")
    "_Bool" -> Some("bool")
    "bool" -> Some("bool")
    "int8_t" -> Some("i8")
    "int16_t" -> Some("i16")
    "int32_t" -> Some("i32")
    "int64_t" -> Some("i64")
    "uint8_t" -> Some("u8")
    "uint16_t" -> Some("u16")
    "uint32_t" -> Some("u32")
    "uint64_t" -> Some("u64")
    "size_t" -> Some("usize")
    "uintptr_t" -> Some("usize")
    "ssize_t" -> Some("isize")
    "ptrdiff_t" -> Some("isize")
    "intptr_t" -> Some("isize")
    _ -> None

private ic_numeric(sysl: string) -> bool = sysl match
    "i8" | "i16" | "i32" | "i64" | "i128" | "u8" | "u16" | "u32" | "u64" | "u128" -> true
    "usize" | "isize" | "f32" | "f64" | "CLong" | "CULong" -> true
    _ -> false

private ic_find_record(m: *IcModel, tag: string, id: string) -> Option[usize]
    for k in 0..<m.records.len()
        val r = m.records.at(k)

        // clang spells a tag the typedef names as that typedef: `typedef struct {...} T` is `struct T`.
        if (tag != "" && (r.tag == tag || (r.tag == "" && r.named == tag))) || (id != "" && r.id == id)
            return Some(k)

    None

private ic_find_enum(m: *IcModel, tag: string, id: string) -> Option[usize]
    for k in 0..<m.enums.len()
        val e = m.enums.at(k)

        if (tag != "" && (e.tag == tag || (e.tag == "" && e.named == tag))) || (id != "" && e.id == id)
            return Some(k)

    None

// The typedef called `name`, the header's own first.
private ic_find_typedef(m: *IcModel, name: string) -> Option[usize]
    var found: Option[usize] = None

    for k in 0..<m.typedefs.len()
        val t = m.typedefs.at(k)

        if t.name == name
            if t.main then return Some(k)

            if found.is_none() then found = Some(k)
        end if

    found

// A record from another header, named once and declared `opaque` where it is only pointed at.
private ic_foreign(m: *IcModel, c_name: string) -> string
    for f in m.foreign
        if f.1 == c_name then return f.0

    val name = ic_unique(&m.used, ic_type_name(c_name, ""))

    m.foreign.push((name, c_name))
    name

private ic_tagged(spec: string) -> (string, string) =
    if spec.starts_with("struct ") then ("struct", spec[7..<spec.len])
    else if spec.starts_with("union ") then ("union", spec[6..<spec.len])
    else if spec.starts_with("enum ") then ("enum", spec[5..<spec.len])
    else ("", spec)

// The function type a pointer's target is, through typedefs: `fx_cb` is not one, `fx_fn` in
// `typedef void fx_fn(int)` is.
private ic_func_of(t: IcType, m: *IcModel, depth: int) -> Option[IcType]
    if t.kind == IcFunc then return Some(t)

    if t.kind != IcNamed || depth > 32 then return None

    ic_find_typedef(m, t.name) match
        Some(k) -> ic_func_of(ic_parse(m.typedefs.at(k).qual), m, depth + 1)
        None -> None

// The last part of a path: what `--follow` is told to name a header by.
private ic_base_name(file: string) -> string
    val parts = split(file, "/")

    parts[parts.len - 1]

// Whether a record has C bitfields of its own, or in a member with no name of its own.
private ic_has_bits(m: *IcModel, r: IcRecord) -> bool
    for f in r.fields
        if f.bitfield then return true

        if f.inner != "" && f.name == ""
            ic_find_record(m, "", f.inner) match
                Some(k) ->
                    if ic_has_bits(m, m.records.at(k)) then return true
                None -> ()
        end if

    false

// A record of a followed header that something generated here uses: named the first time, and
// written out once everything that could reach it has been (`ic_render`). Before that -- while the
// layouts are being settled -- only whether it can be used matters.
private ic_reach(m: *IcModel, k: usize, alias: string) -> string
    if !m.reach_on then return "?"

    var r = m.records.at(k)

    if r.sysl == ""
        val base = if r.named != "" then r.named else if alias != "" then alias else r.tag

        r.sysl = ic_unique(&m.used, ic_type_name(base, m.prefix))
    end if

    r.reached = true
    m.records.set(k, r)
    r.sysl

// An enum of a followed header that something generated here uses, named the first time as a record
// is; its `c type` and constants are written with the header's own (`ic_render`).
private ic_reach_enum(m: *IcModel, k: usize) -> string
    if !m.reach_on then return "?"

    var e = m.enums.at(k)

    if e.sysl == "" then e.sysl = ic_unique(&m.used, ic_type_name(if e.named != "" then e.named else e.tag, m.prefix))

    e.reached = true
    m.enums.set(k, e)
    e.sysl

// **A record named in a declaration, as sysl writes it there**, or why it cannot be. `shown` is the
// C spelling a refusal quotes, and `alias` the typedef another header names the record by, which a
// record only pointed at is named for.
private ic_record_ref(shown: string, tag: string, alias: string, pos: int, m: *IcModel) -> Result[string, string]
    if tag.starts_with("(") || tag.contains("::(")
        return Err("an anonymous struct or union, which has no name to give it")

    val found = ic_find_record(m, tag, "")

    found match
        Some(k) ->
            val r = m.records.at(k)
            val usable = r.complete && r.why == ""

            if r.main && r.sysl != ""
                if pos == IcAtPointee then return Ok(r.sysl)
                if !usable then return Err(s"'$shown' by value, whose layout is not generated here")

                return Ok(r.sysl)
            end if

            if r.followed && (r.named != "" || alias != "" || r.tag != "")
                if pos != IcAtPointee && !usable then return Err(s"'$shown' by value, whose layout is not generated here")

                return Ok(ic_reach(m, k, alias))
            end if
        None -> ()

    if pos == IcAtPointee then return Ok(ic_foreign(m, if alias != "" then alias else tag))

    found match
        Some(k) ->
            val r = m.records.at(k)

            if r.complete && r.file != ""
                return Err(s"'$shown' by value, and it is declared by another header -- " +
                           s"'--follow ${ic_base_name(r.file)}' lays it out")
        None -> ()

    Err(s"'$shown' by value, and it is declared by another header")
end ic_record_ref

private ic_map_named(spec: string, pos: int, m: *IcModel, depth: int) -> Result[string, string]
    if spec == "void"
        return if pos == IcAtResult then Ok("") else Err("'void' where a value has to be")

    if spec == "char" && pos == IcAtPointee then return Ok("u8")

    ic_builtin(spec) match
        Some(s) ->
            if s == "CLong" then m.clong = true
            if s == "CULong" then m.culong = true

            return Ok(s)
        None -> ()

    if spec == "long double"
        return Err("'long double', whose format is the machine's -- see `c type`")

    val (kind, tag) = ic_tagged(spec)

    if kind == "struct" || kind == "union" then return ic_record_ref(spec, tag, "", pos, m)

    if kind == "enum"
        ic_find_enum(m, tag, "") match
            Some(k) ->
                val e = m.enums.at(k)

                if e.main && e.sysl != "" then return Ok(e.sysl)
                if e.followed && (e.named != "" || e.tag != "") then return Ok(ic_reach_enum(m, k))
            None -> ()

        return Err(s"'$spec', an enum declared by another header")
    end if

    ic_find_typedef(m, spec) match
        Some(k) ->
            val t = m.typedefs.at(k)
            val under = ic_parse(t.qual)

            // A typedef over a record answers to what the record can be where it is used; one over a
            // record another header declares is named for the typedef a program writes.
            if under.kind == IcNamed
                val (k2, tag) = ic_tagged(under.name)

                if k2 == "struct" || k2 == "union" then return ic_record_ref(spec, tag, if t.main then "" else spec, pos, m)
            end if

            if t.main && t.sysl != "" then return Ok(t.sysl)

            if depth > 32 then return Err(s"'$spec', a typedef chain too long to follow")

            ic_map(under, pos, m, depth + 1)
        None -> Err(s"'$spec', which no header read here declares")
end ic_map_named

// **A C type as sysl writes it**, or why it cannot be.
ic_map(t: IcType, pos: int, m: *IcModel, depth: int) -> Result[string, string]
    t.kind match
        IcBad -> Err(t.name)
        IcNamed -> ic_map_named(t.name, pos, m, depth)
        IcPtr ->
            val p = t.parts.at(0)

            if p.kind == IcNamed
                if p.name == "void" || p.name == "char" || p.name == "unsigned char" then return Ok("*u8")
                if p.name == "signed char" then return Ok("*i8")
            end if

            ic_func_of(p, m, depth) match
                Some(f) -> return ic_fnptr(f, m, depth)
                None -> ()

            Ok("*" + ic_map(p, IcAtPointee, m, depth)?)
        IcArr ->
            if pos == IcAtParam then return Ok("*" + ic_map(t.parts.at(0), IcAtPointee, m, depth)?)

            if pos != IcAtField then return Err("an array where C has none")

            if t.count < 0 then return Err("a flexible array member, whose length is the allocation's")

            Ok(s"[${t.count}]${ic_map(t.parts.at(0), IcAtField, m, depth)?}")
        IcFunc ->
            if pos == IcAtParam then ic_fnptr(t, m, depth) else Err("a function where a value has to be")
end ic_map

private ic_fnptr(f: IcType, m: *IcModel, depth: int) -> Result[string, string]
    if f.variadic then return Err("a pointer to a variadic function")

    var ps: Buf[string] = buf()

    for k in 1..<f.parts.len()
        ps.push(ic_map(f.parts.at(k), IcAtParam, m, depth)?)

    val r = ic_map(f.parts.at(0), IcAtResult, m, depth)?

    Ok(s"*extern(${join(ps.view(), ", ")}) -> ${if r == "" then "unit" else r}")

// ## Layout

// The C spelling of a record, as `sizeof` and `__builtin_offsetof` are handed it.
private ic_c_record(r: IcRecord) -> string =
    if r.named != "" then r.named else s"${if r.is_union then "union" else "struct"} ${r.tag}"

// How a member is named in a reason: by its name, or by what it is where it has none.
private ic_member_shown(f: IcField, m: *IcModel) -> string
    if f.name != "" then return s"'${f.name}'"
    if f.inner == "" then return "an unnamed bitfield"

    ic_find_record(m, "", f.inner) match
        Some(k) -> if m.records.at(k).is_union then "an anonymous union" else "an anonymous struct"
        None -> "an anonymous member"

// **A C bitfield as sysl declares it**: `T name : W` is `name: uW in T` (or `iW` where `T` is signed),
// an unnamed one `_: uW in T`, a zero-width one `_: in T`, and `_Bool b : 1` is `bool in bool`. Its
// unit has to be an integer of 8, 16, 32 or 64 bits, or `bool` (`attributes.md § C bitfields`).
private ic_bit_type(f: IcField, m: *IcModel) -> Result[string, string]
    val shown = ic_member_shown(f, m)
    val unit = ic_map(ic_parse(f.qual), IcAtField, m, 0) match
        Ok(t) -> t
        Err(why) -> return Err(s"has a bitfield ($shown) that is $why")

    if unit == "bool" then return Ok(if f.width == 0 then "in bool" else "bool in bool")

    val signed = unit == "i8" || unit == "i16" || unit == "i32" || unit == "i64"
    val unsigned = unit == "u8" || unit == "u16" || unit == "u32" || unit == "u64"

    if !signed && !unsigned
        return Err(s"has a bitfield ($shown) declared '${f.qual}', and a bitfield's unit is an integer of " +
                   "8, 16, 32 or 64 bits")

    if f.width == 0 then return Ok(s"in $unit")

    Ok(s"${if signed then "i" else "u"}${f.width} in $unit")
end ic_bit_type

// **Why a record's layout is withheld, or nothing.** `alone` is a record declared as a type of its
// own -- a named one, or the type of a named member -- rather than an anonymous member written in
// place: a union of that kind maps a member it cannot express as its bytes (`ic_emit_fields`), since
// it can carry the `@align` that keeps the union C's size and boundary.
private ic_why(m: *IcModel, r: IcRecord, alone: bool) -> string
    if r.why != "" then return r.why
    if r.fields.is_empty() then return "has no fields"

    for f in r.fields
        val shown = ic_member_shown(f, m)

        if f.aligned then return s"has a member ($shown) with an alignment attribute of its own"

        if f.inner != ""
            val k = ic_find_record(m, "", f.inner) match
                Some(found) -> found
                None -> return s"has a member ($shown) whose declaration was not found"

            val why = ic_why(m, m.records.at(k), f.name != "")

            if why != "" then return s"has a member ($shown) that $why"

            continue
        end if

        if f.bitfield
            ic_bit_type(f, m) match
                Ok(_) -> ()
                Err(why) -> return why

            continue
        end if

        ic_map(ic_parse(f.qual), IcAtField, m, 0) match
            Ok(_) -> ()
            Err(why) -> if !(r.is_union && alone) then return s"has a field ($shown) that is $why"

    ""
end ic_why

// **Which records are laid out.** A field holding a record by value needs that record laid out too,
// so withholding one can withhold another: this runs until nothing changes.
private ic_settle_layouts(m: *IcModel)
    var changed = true

    while changed
        changed = false

        for k in 0..<m.records.len()
            var r = m.records.at(k)

            if (!r.main && !r.followed) || !r.complete || r.nested || r.why != "" then continue
            if r.main && r.sysl == "" then continue

            r.why = ic_why(m, r, true)

            if r.why != ""
                m.records.set(k, r)
                changed = true
            end if
end ic_settle_layouts

// Where a record's storage is, as C is asked about it: `c` spells the named record it belongs to
// and `path` the members from there down to it, empty for that record itself.
struct IcPlace
    c: string
    path: string

private ic_size_of(p: IcPlace) -> string =
    if p.path == "" then s"sizeof(${p.c})" else s"sizeof(((${p.c} *)0)->${p.path})"

private ic_align_of(p: IcPlace) -> string =
    if p.path == "" then s"_Alignof(${p.c})" else s"__alignof__(((${p.c} *)0)->${p.path})"

private ic_offset_of(p: IcPlace, member: string) -> string =
    if p.path == "" then s"__builtin_offsetof(${p.c}, $member)"
    else s"__builtin_offsetof(${p.c}, ${p.path}.$member) - __builtin_offsetof(${p.c}, ${p.path})"

private ic_place_shown(p: IcPlace) -> string = if p.path == "" then p.c else s"${p.c}.${p.path}"

private ic_member_of(p: IcPlace, member: string) -> string = if p.path == "" then member else s"${p.path}.$member"

// Where a record's text goes: its declaration, its numbers, the checks on them.
struct IcSinks
    records: *StrBuilder
    layout: *StrBuilder
    asserts: *StrBuilder
    refused: *Buf[string]

// **One laid-out record**: `@packed`/`@align(n)` where C has them, the declaration, `SIZEOF_` (and
// `ALIGNOF_` where the boundary is not simply the fields') with a check each, and an offset and a
// check per member that has an address. The type of a named member declared with an unnamed record
// is a record of its own, written after this one.
private ic_emit_record(m: *IcModel, r: IcRecord, name: string, place: IcPlace, out: IcSinks)
    val upper = ic_screaming(name)
    var body = str_builder()
    var notes = str_builder()
    var members_layout = str_builder()
    var members_asserts = str_builder()
    var after: Buf[(IcRecord, string, IcPlace)] = buf()
    val members = IcSinks(out.records, &members_layout, &members_asserts, out.refused)

    val bytes = ic_emit_fields(m, r, name, upper, place, "    ", &body, &notes, &after, members)
    val aligned = r.is_union || r.align > 0 || bytes || ic_has_bits(m, r)

    out.records.push(notes.finish())

    if r.packed then out.records.push("@packed\n")

    if r.align > 0
        out.records.push(s"@align(${r.align})\n")
    else if bytes
        out.records.push(s"@align(ALIGNOF_$upper)\n")
    end if

    out.records.push(s"${if r.is_union then "union" else "struct"} $name\n")
    out.records.push(body.finish())
    out.records.push("\n")
    out.layout.push(s"    SIZEOF_$upper: usize = \"${ic_size_of(place)}\"\n")

    if aligned then out.layout.push(s"    ALIGNOF_$upper: usize = \"${ic_align_of(place)}\"\n")

    out.layout.push(members_layout.finish())
    out.asserts.push(s"@assert(sizeof($name) == SIZEOF_$upper, \"$name must match ${ic_place_shown(place)}\")\n")

    if aligned
        out.asserts.push(s"@assert(alignof($name) == ALIGNOF_$upper, \"$name must be aligned as " +
                         s"${ic_place_shown(place)} is\")\n")
    end if

    out.asserts.push(members_asserts.finish())

    for item in after
        ic_emit_record(m, item.0, item.1, item.2, out)
end ic_emit_record

// The members of `r`, written at `indent` into `body`: an anonymous member in place as a `union` or
// `struct` block, whose fields are the outer record's own, so their offsets are asked of it. Answers
// whether a union member was mapped as its bytes, which needs the union's boundary said outright.
private ic_emit_fields(m: *IcModel, r: IcRecord, name: string, upper: string, place: IcPlace, indent: string,
                       body: *StrBuilder, notes: *StrBuilder, after: *Buf[(IcRecord, string, IcPlace)],
                       out: IcSinks) -> bool
    var bytes = false

    for f in r.fields
        val field_const = s"OFFSETOF_${upper}_${to_upper(f.name)}"
        var sysl_name = ic_ident(f.name)

        if f.inner != ""
            val inner = m.records.at(ic_find_record(m, "", f.inner).unwrap())

            if f.name == ""
                body.push(s"$indent${if inner.is_union then "union" else "struct"}\n")

                if ic_emit_fields(m, inner, name, upper, place, indent + "    ", body, notes, after, out)
                    bytes = true
                continue
            end if

            val made = ic_unique(&m.used, name + ic_type_name(f.name, ""))

            body.push(s"$indent$sysl_name: $made\n")
            after.push((inner, made, IcPlace(place.c, ic_member_of(place, f.name))))
        else if f.bitfield
            body.push(s"$indent${if f.name == "" then "_" else sysl_name}: ${ic_bit_type(f, m).unwrap_or("?")}\n")
            continue
        else
            ic_map(ic_parse(f.qual), IcAtField, m, 0) match
                Ok(ty) -> body.push(s"$indent$sysl_name: $ty\n")
                Err(why) ->
                    // Only a union reaches here (`ic_why`): the member is its storage, and no more.
                    val size_const = s"SIZEOF_${upper}_${to_upper(f.name)}"
                    val shown = s"${ic_place_shown(place)}.${f.name}"

                    sysl_name = s"_${f.name}"
                    bytes = true
                    body.push(s"$indent$sysl_name: [$size_const]u8\n")
                    notes.push(s"// `$shown` is $why: here it is its bytes, as '$sysl_name'.\n")
                    out.layout.push(s"    $size_const: usize = \"sizeof(((${place.c} *)0)->" +
                                    s"${ic_member_of(place, f.name)})\"\n")
                    out.refused.push(s"$shown is $why -- its bytes here, as '$sysl_name'")

        out.layout.push(s"    $field_const: usize = \"${ic_offset_of(place, f.name)}\"\n")
        out.asserts.push(s"@assert(offsetof($name, $sysl_name) == $field_const, " +
                         s"\"${ic_place_shown(place)}.${f.name} moved\")\n")

    bytes
end ic_emit_fields

// ## The module

// The names the header's declarations take, decided before anything is mapped so that a use can
// come before its declaration.
private ic_name_everything(m: *IcModel)
    // A typedef names the record or enum it is written over, the first one doing so -- a followed
    // header's typedef too, which is how one of its records is named.
    for k in 0..<m.typedefs.len()
        val t = m.typedefs.at(k)

        if !t.main && !t.followed then continue

        val q = ic_parse(t.qual)

        if q.kind != IcNamed then continue

        val (kind, tag) = ic_tagged(q.name)
        val anon = tag.starts_with("(") || tag.contains("::(")
        val tag_key = if anon then "" else tag
        val id_key = t.owned

        if kind == "struct" || kind == "union"
            ic_find_record(m, tag_key, id_key) match
                Some(i) ->
                    var r = m.records.at(i)

                    if r.named == "" then r.named = t.name
                    if anon && t.main then r.main = true

                    m.records.set(i, r)
                None -> ()
        else if kind == "enum"
            ic_find_enum(m, tag_key, id_key) match
                Some(i) ->
                    var e = m.enums.at(i)

                    if e.named == "" then e.named = t.name
                    if anon && t.main then e.main = true

                    m.enums.set(i, e)
                None -> ()

    for k in 0..<m.records.len()
        var r = m.records.at(k)
        val base = if r.named != "" then r.named else r.tag

        if r.main && !r.nested && base != "" && !base.starts_with("(")
            r.sysl = ic_unique(&m.used, ic_type_name(base, m.prefix))
            m.records.set(k, r)
        end if

    for k in 0..<m.enums.len()
        var e = m.enums.at(k)
        val base = if e.named != "" then e.named else e.tag

        if e.main && base != ""
            e.sysl = ic_unique(&m.used, ic_type_name(base, m.prefix))
            m.enums.set(k, e)
        end if

    // A typedef the record or enum already answers to is not written twice; one over a function type
    // is written where it is used, there being no sysl type for a function that is not a pointer.
    for k in 0..<m.typedefs.len()
        var t = m.typedefs.at(k)

        if !t.main then continue

        val q = ic_parse(t.qual)
        val wanted = ic_type_name(t.name, m.prefix)
        var answered = false

        if q.kind == IcNamed
            val (kind, tag) = ic_tagged(q.name)
            val anon = tag.starts_with("(") || tag.contains("::(")

            if kind == "struct" || kind == "union"
                ic_find_record(m, if anon then "" else tag, t.owned) match
                    Some(i) ->
                        if m.records.at(i).sysl == wanted then answered = true
                    None -> ()
            else if kind == "enum"
                ic_find_enum(m, if anon then "" else tag, t.owned) match
                    Some(i) ->
                        if m.enums.at(i).sysl == wanted then answered = true
                    None -> ()
        end if

        if answered
            t.sysl = wanted
        else if q.kind != IcFunc
            t.sysl = ic_unique(&m.used, wanted)
        end if

        m.typedefs.set(k, t)
end ic_name_everything

// **The module's text**, every declaration that could not be generated pushed onto `refused`.
ic_render(m: *IcModel, spelled: string, opts: IcOptions, macros: Buf[string], bad_lines: Buf[long],
          refused: *Buf[string], shim: *StrBuilder) -> string
    ic_name_everything(m)
    ic_settle_layouts(m)

    // From here on, a followed header's record that is used is named and kept.
    m.reach_on = true

    var records = str_builder()
    var consts = str_builder()
    var layout = str_builder()
    var asserts = str_builder()
    val sinks = IcSinks(&records, &layout, &asserts, refused)

    for k in 0..<m.records.len()
        val r = m.records.at(k)

        if !r.main || r.sysl == "" || r.nested then continue

        val c = ic_c_record(r)
        val upper = ic_screaming(r.sysl)

        if !r.complete
            records.push(s"opaque struct ${r.sysl}\n\n")
        else if r.why != ""
            records.push(s"// `$c` ${r.why}.\n")
            records.push(s"// Opaque here: its storage is SIZEOF_$upper bytes, aligned to ALIGNOF_$upper.\n")
            records.push(s"opaque struct ${r.sysl}\n\n")
            layout.push(s"    SIZEOF_$upper: usize = \"sizeof($c)\"\n")
            layout.push(s"    ALIGNOF_$upper: usize = \"_Alignof($c)\"\n")
            refused.push(s"$c ${r.why} -- an opaque struct here, sized by SIZEOF_$upper and aligned by ALIGNOF_$upper")
        else
            ic_emit_record(m, r, r.sysl, IcPlace(c, ""), sinks)

    // The aliases: a callback's signature, and a typedef over a scalar or a pointer.
    var aliases = str_builder()

    for t in m.typedefs
        if !t.main || t.sysl == "" then continue

        val q = ic_parse(t.qual)

        if q.kind == IcNamed
            val (kind, _) = ic_tagged(q.name)

            if kind != "" && t.sysl == ic_type_name(t.name, m.prefix)
                // Answered by the record or enum itself, unless that took another typedef's name.
                var answered = false

                for r in m.records
                    if r.sysl == t.sysl then answered = true

                for e in m.enums
                    if e.sysl == t.sysl then answered = true

                if answered then continue
            end if
        end if

        ic_map(q, IcAtField, m, 0) match
            Ok(ty) -> aliases.push(s"type ${t.sysl} = $ty\n")
            Err(why) -> refused.push(s"${t.name}: the typedef is $why")

    // The entry points: an `extern` per function with a symbol, and through a wrapper in the shim
    // per `static` one.
    var externs = str_builder()
    var wrappers = str_builder()

    for f in m.funcs
        val q = ic_parse(f.qual)

        if q.kind != IcFunc
            refused.push(s"${f.name}: its type '${f.qual}' is not one this reader follows")
            continue
        end if

        val name = ic_ident(ic_value_name(f.name, m.prefix))

        if f.storage != "static"
            ic_extern(name, f.name, f.params, q, m) match
                Ok(line) -> externs.push(line + "\n")
                Err(why) -> refused.push(s"${f.name}: $why")

            continue
        end if

        val what = if f.inline then "a 'static inline' function" else "a 'static' function"
        var call_params: Buf[(string, string)] = buf()

        for i in 0..<f.param_quals.len()
            call_params.push((f.param_quals.at(i), ic_param_name(f.params, i)))

        ic_wrapped(name, f.name, what, f.qual, q, call_params, f.name, opts, m) match
            Ok((line, c)) ->
                externs.push(line + "\n")
                wrappers.push(c)
            Err(why) -> refused.push(s"${f.name}: $why")

    for v in m.vars
        ic_map(ic_parse(v.1), IcAtField, m, 0) match
            Ok(ty) ->
                val name = ic_ident(ic_value_name(v.0, m.prefix))
                val linked = if name == v.0 then "" else s"\"${v.0}\" "

                externs.push(s"extern $linked$name: $ty\n")
            Err(why) -> refused.push(s"${v.0}: the variable is $why")

    // The numbers: each enum's constants at its own `c type`, then the macros.
    var used_consts: Buf[string] = buf()
    var ctypes = str_builder()

    for e in m.enums
        if !e.main then continue

        val ty = if e.sysl != "" then e.sysl else "i32"

        if e.sysl != ""
            val c = if e.named != "" then e.named else s"enum ${e.tag}"

            ctypes.push(s"    ${e.sysl} = \"$c\"\n")
        end if

        for c in e.consts
            val name = ic_unique(&used_consts, ic_const_name(c, m.prefix))

            consts.push(s"    $name: $ty = \"$c\"\n")

    var macro_lines = str_builder()

    for k in 0..<macros.len()
        val name = macros.at(k)
        var bad = false

        for line in bad_lines
            if line == long(k) + 2 then bad = true

        if bad
            refused.push(s"$name: not a constant expression C can evaluate")
            continue
        end if

        var qual = ""

        for mt in m.macro_types
            if mt.0 == int(k) then qual = mt.1

        val t = ic_parse(qual)

        if t.kind == IcPtr && t.parts.at(0).kind == IcNamed && t.parts.at(0).name == "char"
            refused.push(s"$name: a string, and a 'c const' measures numbers only")
            continue
        end if

        val ty = if t.kind == IcNamed then ic_map(t, IcAtField, m, 0).unwrap_or("") else ""

        if !ic_numeric(ty)
            refused.push(s"$name: a '${ic_show(t)}', not a number")
            continue
        end if

        val cname = ic_unique(&used_consts, ic_const_name(name, m.prefix))

        macro_lines.push(s"    $cname: $ty = \"$name\"\n")

    // A function-like macro has no type of its own; one that is a call of a declared function, with
    // each of its parameters one whole argument, takes that function's types.
    for mac in m.fmacros
        val (callee, slots) = ic_macro_call(mac, m) match
            Ok(found) -> found
            Err(why) ->
                refused.push(s"${mac.name}: a function-like macro $why")
                continue

        val cq = ic_parse(callee.qual)
        var parts: Buf[IcType] = buf()
        var call_params: Buf[(string, string)] = buf()

        parts.push(cq.parts.at(0))

        for i in 0..<slots.len()
            parts.push(cq.parts.at(slots.at(i) + 1))
            call_params.push((callee.param_quals.at(slots.at(i)), mac.params.at(i)))

        val stripped = ic_value_name(mac.name, m.prefix)
        val name = ic_ident(if to_upper(stripped) == stripped then to_lower(stripped) else stripped)
        val q = IcType(IcFunc, "", 0, parts, false)

        ic_wrapped(name, mac.name, "a function-like macro", callee.qual, q, call_params, mac.name, opts, m) match
            Ok((line, c)) ->
                externs.push(line + "\n")
                wrappers.push(c)
            Err(why) -> refused.push(s"${mac.name}: $why")

    // The wrappers' file, which includes the header as the module does.
    if opts.shim != ""
        shim.push(s"/* Generated by `sysl import-c` from $spelled: a C wrapper for each 'static' function and\n")
        shim.push(" * function-like macro the module reaches, which have no symbol of their own. It is compiled\n")
        shim.push(" * where it sits, in the module's directory. Regenerate it rather than editing it. */\n")
        shim.push(s"#include \"$spelled\"\n")
        shim.push(wrappers.finish())
    end if

    // The followed headers' records that something above uses, each laid out where it can be; laying
    // one out can reach another, so this runs until nothing new is reached.
    var followed = str_builder()
    var written: Buf[string] = buf()
    val followed_sinks = IcSinks(&followed, &layout, &asserts, refused)
    var more = true

    while more
        more = false

        for k in 0..<m.records.len()
            val r = m.records.at(k)

            if !r.reached || ic_contains(written.view(), r.id) then continue

            written.push(r.id)
            more = true

            if r.complete && r.why == ""
                ic_emit_record(m, r, r.sysl, IcPlace(ic_c_record(r), ""), followed_sinks)
            else
                followed.push(s"opaque struct ${r.sysl}\n\n")

    // The followed headers' enums that something above uses -- a record just laid out among them --
    // each a `c type` with its constants, after the header's own.
    for e in m.enums
        if e.main || !e.reached then continue

        val c_name = if e.named != "" then e.named else s"enum ${e.tag}"

        ctypes.push(s"    ${e.sysl} = \"$c_name\"\n")

        for c in e.consts
            consts.push(s"    ${ic_unique(&used_consts, ic_const_name(c, m.prefix))}: ${e.sysl} = \"$c\"\n")

    // Only now, since a macro's type may be the first to need one.
    if m.clong then ctypes.push("    CLong = \"long\"\n")
    if m.culong then ctypes.push("    CULong = \"unsigned long\"\n")

    // Assembled in the order a reader wants: what it includes, the types, the numbers, the checks
    // and the calls.
    var out = str_builder()

    out.push(s"// Generated by `sysl import-c` from $spelled: the raw layer of a binding, one declaration per\n")
    out.push("// C declaration. Regenerate it rather than editing it -- what a program calls belongs in a\n")
    out.push("// module above this one.\n\n")

    if opts.module_name != "" then out.push(s"module ${opts.module_name}\n\n")
    if opts.link != "" then out.push(s"@link(\"${opts.link}\")\n\n")

    out.push(s"@include(\"$spelled\")\n\n")

    if !m.foreign.is_empty()
        out.push("// Declared by another header, and only ever pointed at here.\n")

        for f in m.foreign
            out.push(s"opaque struct ${f.0}\n")

        out.push("\n")
    end if

    val followed_text = followed.finish()

    if followed_text != ""
        out.push("// Declared by a header '--follow' named.\n")
        out.push(followed_text)
    end if

    out.push(records.finish())

    val alias_text = aliases.finish()

    if alias_text != "" then out.push(alias_text + "\n")

    val ctype_text = ctypes.finish()

    if ctype_text != "" then out.push(s"c type\n$ctype_text\n")

    val parts = [consts.finish(), macro_lines.finish(), layout.finish()]
    var first = true

    for p in parts
        if p == "" then continue

        out.push(if first then "c const\n" else "\n")
        out.push(p)
        first = false

    if !first then out.push("\n")

    val assert_text = asserts.finish()

    if assert_text != "" then out.push(assert_text + "\n")

    out.push(externs.finish())
    out.finish()
end ic_render

// A parameter's name as the header wrote it, or `p<i>` where it wrote none.
private ic_param_name(params: Buf[string], i: usize) -> string =
    if i < params.len() && params.at(i) != "" then params.at(i) else s"p$i"

// The `extern` declaring `name`, linked to the symbol `link`, of the function type `q`.
private ic_extern(name: string, link: string, params: Buf[string], q: IcType, m: *IcModel) -> Result[string, string]
    var ps: Buf[string] = buf()

    for k in 1..<q.parts.len()
        ps.push(s"${ic_ident(ic_param_name(params, k - 1))}: ${ic_map(q.parts.at(k), IcAtParam, m, 0)?}")

    if q.variadic then ps.push("...")

    val r = ic_map(q.parts.at(0), IcAtResult, m, 0)?
    val linked = if name == link then "" else s"\"$link\" "
    val result = if r == "" then "" else s" -> $r"

    Ok(s"extern $linked$name(${join(ps.view(), ", ")})$result")

// **The `extern` and the C wrapper for what has no symbol of its own** -- a `static` function, or a
// function-like macro typed by the function it calls. The wrapper is `sysl_<name>`, declared with
// the types clang gave (`call_params` is each parameter's type as clang spells it and its name) and
// calling `callee` with them. Without `--shim` nothing is written, and what would have been is said.
private ic_wrapped(name: string, c_name: string, what: string, qual: string, q: IcType, call_params: Buf[(string, string)],
                   callee: string, opts: IcOptions, m: *IcModel) -> Result[(string, string), string]
    if q.variadic then return Err(s"$what that takes '...', whose arguments a wrapper cannot pass on")

    val result = ic_result_text(qual) match
        Some(r) -> r
        None -> return Err(s"$what returning a function pointer, which its wrapper's declaration does not spell")

    var names: Buf[string] = buf()

    for p in call_params
        names.push(p.1)

    val link = s"sysl_$c_name"
    val line = ic_extern(name, link, names, q, m)?

    if opts.shim == ""
        return Err(s"$what has no symbol to link against -- '--shim <file.c>' writes the wrapper that reaches it")

    var decls: Buf[string] = buf()

    for p in call_params
        decls.push(ic_c_param(p.0, p.1))

    val args = join(names.view(), ", ")
    val ret = if result == "void" then "" else "return "
    val declared = if decls.is_empty() then "void" else join(decls.view(), ", ")

    Ok((line, s"\n$result $link($declared) {\n    $ret$callee($args);\n}\n"))
end ic_wrapped

// A function type's result as C spells it: `int (int)` is `int`. A result that is itself a function
// pointer is written around the parameters (`void (*(int))(void)`), and has no spelling here.
private ic_result_text(qual: string) -> Option[string]
    if !qual.ends_with(")") then return None

    var depth = 0
    var k = qual.len

    while k > 0
        k -= 1

        val c = qual.bytes[k]

        if c == u8(')') then depth += 1

        if c == u8('(')
            depth -= 1

            if depth == 0 then break
        end if

    val r = qual[0..<k].trim()

    if r == "" || r.contains("(") then None else Some(r)
end ic_result_text

// A parameter declared from clang's spelling of its type: `int x`, `const char *path`, and
// `__typeof__(void (*)(int)) cb` where the name would have to go inside the declarator.
private ic_c_param(qual: string, name: string) -> string =
    if qual.contains("(") || qual.contains("[") then s"__typeof__($qual) $name"
    else if qual.ends_with("*") then qual + name
    else s"$qual $name"

// `text` with the parentheses around the whole of it taken off, as often as they are there.
private ic_unwrapped(text: string) -> string
    var t = text.trim()

    while t.starts_with("(") && ic_closing(t, 0) == t.len - 1
        t = t[1..<t.len - 1].trim()

    t

// Where the bracket opened at `open` closes, or the text's length where it does not.
private ic_closing(text: string, open: usize) -> usize
    var depth = 0

    for k in open..<text.len
        val c = text.bytes[k]

        if c == u8('(') then depth += 1

        if c == u8(')')
            depth -= 1

            if depth == 0 then return k
        end if

    text.len
end ic_closing

// The arguments of a call's parenthesised list, split at its own commas.
private ic_arguments(text: string) -> Buf[string]
    var out: Buf[string] = buf()
    var depth = 0
    var start: usize = 0

    for k in 0..<text.len
        val c = text.bytes[k]

        if c == u8('(') || c == u8('[') then depth += 1
        if c == u8(')') || c == u8(']') then depth -= 1

        if c == u8(',') && depth == 0
            out.push(text[start..<k].trim())
            start = k + 1
        end if

    if text.trim() != "" then out.push(text[start..<text.len].trim())

    out
end ic_arguments

// Whether `word` appears in `text` as a whole identifier.
private ic_mentions(text: string, word: string) -> bool
    var k: usize = 0

    while k < text.len
        val c = text.bytes[k]

        if ic_word_byte(c)
            var e = k

            while e < text.len && ic_word_byte(text.bytes[e]) do e += 1

            if text[k..<e] == word then return true

            k = e
        else
            k += 1

    false
end ic_mentions

private ic_word_byte(c: u8) -> bool =
    (c >= u8('a') && c <= u8('z')) || (c >= u8('A') && c <= u8('Z')) || (c >= u8('0') && c <= u8('9')) ||
    c == u8('_')

// **What types a function-like macro**: a body that is one call of a function the header declares,
// each of the macro's parameters one whole argument of it and no other argument naming one. Answers
// the function and, per macro parameter, which of its parameters that is.
private ic_macro_call(mac: IcMacro, m: *IcModel) -> Result[(IcFunc, Buf[usize]), string]
    for p in mac.params
        if p == "..." || p.ends_with("...") then return Err("that takes '...'")

    val untyped = s"whose parameters ('${join(mac.params.view(), "', '")}') no function it calls gives a type"
    val body = ic_unwrapped(mac.body)
    var k: usize = 0

    while k < body.len && ic_word_byte(body.bytes[k]) do k += 1

    val callee = body[0..<k]
    val rest = body[k..<body.len].trim()

    if callee == "" || !rest.starts_with("(") || ic_closing(rest, 0) != rest.len - 1 then return Err(untyped)

    var called: Option[IcFunc] = None

    for f in m.funcs
        if f.name == callee then called = Some(f)

    val f = called match
        Some(found) -> found
        None -> return Err(untyped)

    val args = ic_arguments(rest[1..<rest.len - 1])
    var slots: Buf[usize] = buf()

    if args.len() > f.param_quals.len() then return Err(untyped)

    for p in mac.params
        var slot: Option[usize] = None

        for i in 0..<args.len()
            val a = ic_unwrapped(args.at(i))

            if a == p
                if slot.is_some() then return Err(untyped)

                slot = Some(i)
            else if ic_mentions(a, p)
                return Err(untyped)
            end if

        slot match
            Some(i) -> slots.push(i)
            None -> return Err(untyped)

    Ok((f, slots))
end ic_macro_call

// The text, with what was not generated said at its foot.
ic_finish(text: string, refused: Buf[string]) -> string
    if refused.is_empty() then return text

    var out = str_builder()

    out.push(text)

    if !text.ends_with("\n\n") then out.push("\n")

    out.push("// Not generated:\n//\n")

    for item in refused
        out.push(s"// - $item\n")

    out.finish()
