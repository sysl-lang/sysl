import sysl.buf.*
// A buffer of buffers, built and summed.
var total: long = 0

for round in 0..<3000
    var outer: Buf[Buf[long]] = buf()

    for i in 0..<1000
        var inner: Buf[long] = buf()

        for j in 0..<100
            inner.push(long(i + j))

        outer.push(inner)

    for i in 0..<outer.len()
        for j in 0..<outer[i].len()
            total += outer[i][j]

print(total)
