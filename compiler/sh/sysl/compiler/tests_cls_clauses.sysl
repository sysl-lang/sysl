        area(n: int) -> int
        area(0) = 2
        aera(_) = 1

        main()
            print(area(0))
        """, misnamed, "3:1")

    val out = cls_report("area(n: int) -> int\naera(0) = 2\naera(_) = 1\n\nmain()\n    print(area(0))\n")

    assert(out.count_of("error:") == 1, s"expected the one refusal, got: $out")

