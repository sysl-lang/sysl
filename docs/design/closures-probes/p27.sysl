// p26 with a counted value: the block's local is released when the block ends, and a closure holding
// its address, stored in the enclosing block, reads its bytes afterwards. Run under ASan.
run()
    var g: &Fn() -> string = () -> ""

    if true
        var s = "abc".copy()
        val p = &s

        g = () -> (*p).copy()

    print(g())

run()
