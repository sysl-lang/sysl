module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.math.bigint.{BigInt, cmp, from_int, to_string}

// The forms that make a sequence and the forms that read one: an array literal, a repeat, a
// subscript, a view, and a tuple.
//
// **What is being asked for decides which of two things a literal is.** The same `[1, 2, 3]` is an
// array where an array was wanted, a buffer where a view was, and a vector where a register was --
// because an array's length is part of its type, a view's is not in its type at all, and a
// register's is part of the instruction.

// The element type a position wants out of a sequence.
private element_wanted(t: Type) -> Option[Type] = repr(t) match
    Array(_, e) -> Some(*e)
    Slice(e, _) -> Some(*e)
    Vector(_, e) -> Some(*e)
    _ -> None

// A string literal where a `[N]u8` is wanted: the literal's UTF-8 bytes, one element each, as the
// array literal they spell. It is an array literal from here on, so it folds to constant data
// wherever one of byte literals does. `None` when the position does not want a byte array, and the
// literal stays a `string`.
bytes_literal(cx: &Analyzer, span: Span, text: string, expected: Option[Type]) -> Option[TExpr]
    if expected.is_none() then return None

    val want = expected.unwrap()

    repr(want) match
        Array(n, elem) ->
            if repr(*elem) != Integer(8, false, false) then return None

            val bytes = text.bytes

            if int(bytes.len) != n then
                return Some(cx.err(span, s"this string literal is ${bytes.len} bytes and " +
                                   s"${type_show(want)} holds $n — a string literal fills a byte " +
                                   "array only when its UTF-8 length is exactly the array's"))

            var ts: Buf[TExpr] = buf()

            for b in bytes
                ts.push(TExpr(span, TIntLit(from_int(long(b)), *elem)))

            Some(TExpr(span, TArrayLit(ts, Array(n, *elem))))
        _ -> None
end bytes_literal

array_literal(cx: &Analyzer, span: Span, elems: Buf[Expr], expected: Option[Type]) -> TExpr
    val elem_exp = expected.and_then(t -> element_wanted(t))
    var ts: Buf[TExpr] = buf()

    // With nothing asked of it, the literal's elements are operands that must share one type, and
    // they settle it the way the two sides of an operator do: a bare literal takes the type of an
    // element that has one, wherever that element stands. So `[1usize, 2, 7]` and `[1, 2usize, 7]`
    // are both `[3]usize` -- and `[1u8, 300]` is refused at the `300` for not fitting, rather than
    // for being an `int` nobody wrote. Where the position asks for an element type, every element
    // is read at that type and nothing here decides it. Elements of two types meet at the wider, as
    // the arms of an `if` do: `[b, n]` over a `byte` and an `int` is an `[int; 2]`.
    //
    // **Tuples meet part by part**, each part by the same rule: `[(0, 0), (big, 2)]` over a `long`
    // `big` is a `[2](long, int)`, the first `0` taking the type of the part at its place in the other
    // element, exactly as `[0, big]` does. Where the parts have no type to meet at, the elements are
    // read as they always were and the literal is refused for holding two types.
    val parts = if elem_exp.is_none() && shapes_tuples(elems) then tuple_parts_meet(cx, elems) else None

    if parts.is_some()
        for item in elems
            ts.push(type_expr(cx, item, parts))
    elif elem_exp.is_none() then ts = analyze_operands(cx, elems, None, true)
    else
        for item in elems
            ts.push(type_expr(cx, item, elem_exp))

    // An element whose type could not be worked out was refused where it was written, so the
    // literal is a consequence of that mistake rather than a second one: `[y, 1]` over a refused `y`.
    for item in ts
        if texpr_type(item) == Unknown then
            cx.an.poison_quietly()
            return bad_expr(span)

    for i in 0..<ts.len()
        val t = texpr_type(ts.at(i))

        if no_value(t) then
            cx.fault(span, s"an array cannot hold ${type_show(t)} values")
        else if !type_eq(t, texpr_type(ts.at(0))) then
            cx.fault(span, s"an array literal needs one element type, got " +
                     s"${type_show(texpr_type(ts.at(0)))} and ${type_show(t)}")

    val elem_ty = settled_element(ts, elem_exp)

    if elem_ty == Unknown && ts.is_empty() then
        return cx.err(span, "an empty array literal takes its element type from its context, and " +
                      "there is none here")

    if expected.is_none() then return TExpr(span, TArrayLit(ts, Array(int(ts.len()), elem_ty)))

    repr(expected.unwrap()) match
        // The buffer is storage this expression makes, so nobody else can be holding a writable
        // view of it and it takes whichever form was asked for.
        Slice(_, read_only) -> TExpr(span, TBufLit(ts, Slice(elem_ty, read_only)))
        // The lane count is part of the type, so a literal that does not fill it is a mistake with
        // an exact number in it -- unlike an array, whose length the literal is free to decide.
        Vector(n, _) ->
            if int(ts.len()) != n then
                cx.fault(span, s"${type_show(expected.unwrap())} has $n lanes and this literal has " +
                         s"${ts.len()} — a vector's width is part of its type, so the two have to " +
                         "agree")

            TExpr(span, TVectorLit(ts, Vector(n, elem_ty)))
        _ -> TExpr(span, TArrayLit(ts, Array(int(ts.len()), elem_ty)))
end array_literal

// `[v; n]` -- the form for an array whose element type has no zero, or has one that is not the
// wanted starting value. The value is evaluated **once** and copied into every element, which is
// what makes `[f(); 8]` mean one call rather than eight.
array_fill(cx: &Analyzer, span: Span, value: Expr, count: Expr, expected: Option[Type]) -> TExpr
    val elem_exp = expected.and_then(t -> element_wanted(t))
    val tv = type_expr(cx, value, elem_exp)
    val vt = texpr_type(tv)

    if no_value(vt) then cx.fault(span, s"an array cannot hold ${type_show(vt)} values")

    if expected.is_some() then
        repr(expected.unwrap()) match
            Vector(n, elem) -> return vector_fill(cx, span, tv, count, n, *elem, expected.unwrap())
            Slice(_, read_only) -> return buffer_fill(cx, span, tv, count, read_only)
            _ -> ()

    val refusals = cx.an.const_refusals
    val n = const_int(cx, count)

    // A count whose fold refused was told where the mistake is, and is not a second one here.
    if n.is_none() && const_refused_since(cx.an, refusals)
        cx.an.poison_quietly()
        return bad_expr(span)
    end if

    if n.is_none() then
        return cx.err(span, "an array's repeat count must be a constant, since it is the array's " +
                      "bound — a literal, or a 'const' naming one. A count computed while running " +
                      "makes storage instead, which is written where a '[]T' is expected")

    if cmp(n.unwrap(), from_int(0)) < 0 || too_many_elements(n.unwrap()) then
        return cx.err(span, s"an array cannot have ${to_string(n.unwrap())} elements")

    TExpr(span, TArrayFill(tv, Array(int(n.unwrap().to_long().unwrap_or(0)), vt)))
end array_fill

// `[v; n]` where a vector was asked for is the splat written out, accepted because the reader has
// written the array form of a thing a vector also has. The count is still checked against the lane
// count, since a vector that does not fill its width is the same mistake as a literal that does not.
private vector_fill(cx: &Analyzer, span: Span, tv: TExpr, count: Expr, lanes: int, elem: Type,
                    vec: Type) -> TExpr
    val n = const_int(cx, count)

    if n.is_none() then
        cx.fault(span, s"${type_show(vec)} has $lanes lanes, which is part of its type — so a " +
                 "repeat filling one needs a constant count")
    else if n.unwrap().to_long().unwrap_or(-1) != long(lanes) then
        cx.fault(span, s"${type_show(vec)} has $lanes lanes and this repeat makes " +
                 s"${to_string(n.unwrap())}")

    TExpr(span, TSplat(coerce(cx, tv, elem), vec))
end vector_fill

// A count is an index's twin, so it takes a transparent subtype for the same reason one does.
private buffer_fill(cx: &Analyzer, span: Span, tv: TExpr, count: Expr, read_only: bool) -> TExpr
    val tc = type_expr_bare(cx, count)
    val ct = texpr_type(tc)

    repr(ct) match
        Integer(_, _, _) -> ()
        _ -> if ct != Unknown then
                 cx.fault(span, s"a repeat count is a number of elements, and " +
                          s"${type_show(ct)} is not an integer")

    TExpr(span, TBufFill(tv, tc, Slice(texpr_type(tv), read_only)))
end buffer_fill

// The element type a literal settles on: the first element's where there is one, and the one the
// position asked for where there is not.
private settled_element(ts: Buf[TExpr], wanted: Option[Type]) -> Type
    if !ts.is_empty() then return texpr_type(ts.at(0))
    if wanted.is_some() then return wanted.unwrap()

    Unknown
end settled_element

// Whether an unannotated literal's elements have a tuple written out among them, anywhere down its
// rows -- the elements whose parts can meet one by one.
private shapes_tuples(es: Buf[Expr]) -> bool
    if es.len() < 2 then return false

    for e in es
        if mentions_tuple(e) then return true

    false
end shapes_tuples

private mentions_tuple(e: Expr) -> bool = *e.kind match
    Tuple(_) -> true
    ArrayLit(xs) -> xs.len() > 1 && shapes_tuples(xs) || xs.len() == 1 && mentions_tuple(xs.at(0))
    _ -> false

// The one type the elements meet at, worked out part by part, where every element then reads at it
// without a complaint -- and nothing where they do not, so the literal is read as it always was and
// its complaint is the one it always had.
//
// **Found by a reading thrown away whole**: the parts are read once to learn their types and once to
// check that every element takes the type they came to; the reading the program keeps is the one
// made at it afterwards.
private tuple_parts_meet(cx: &Analyzer, es: Buf[Expr]) -> Option[Type]
    val tried = begin_trial(cx)
    val met = parts_meet(cx, es)
    var clean = met.is_some() && !refused_since(cx, tried)

    if clean
        for e in es
            val t = texpr_type(type_expr(cx, e, met))

            if refused_since(cx, tried) || t == Unknown || disagree(t, met.unwrap()) then clean = false

    discard_trial(cx, tried)

    if clean then met else None
end tuple_parts_meet

// The type a column of expressions meets at: a tuple of what each column of their parts meets at
// where all of them are tuples of one arity, an array of what all their elements meet at where all
// are array literals of one length, and otherwise the type they settle on as the operands of an
// unannotated array literal, where that is one type.
private parts_meet(cx: &Analyzer, es: Buf[Expr]) -> Option[Type]
    val arity = shared_arity(es)

    if arity > 0
        var parts: Buf[Type] = buf()

        for j in 0..<arity
            var column: Buf[Expr] = buf()

            for e in es
                column.push(part_at(e, j))

            val t = parts_meet(cx, column)

            if t.is_none() then return None

            parts.push(t.unwrap())

        return Some(Struct(registered_tuple(cx.an, parts)))
    end if

    val rows = shared_row_length(es)

    if rows > 0
        var all: Buf[Expr] = buf()

        for e in es
            for i in 0..<rows
                all.push(part_at(e, i))

        val t = parts_meet(cx, all)

        return if t.is_some() then Some(Array(int(rows), t.unwrap())) else None
    end if

    val ts = analyze_operands(cx, es, None, true)

    if ts.is_empty() then return None

    val first = texpr_type(ts.at(0))

    if first == Unknown || no_value(first) then return None

    for t in ts
        if !type_eq(texpr_type(t), first) then return None

    Some(first)
end parts_meet

// How many parts every one of `es` has as a tuple written out, or 0 where they are not all one.
private shared_arity(es: Buf[Expr]) -> usize
    var n: usize = 0

    for e in es
        val k = *e.kind match
            Tuple(parts) -> parts.len()
            _ -> 0

        if k == 0 || n != 0 && k != n then return 0

        n = k

    n
end shared_arity

// How many elements every one of `es` has as an array literal, or 0 where they are not all one.
private shared_row_length(es: Buf[Expr]) -> usize
    var n: usize = 0

    for e in es
        val k = *e.kind match
            ArrayLit(xs) -> xs.len()
            _ -> 0

        if k == 0 || n != 0 && k != n then return 0

        n = k

    n
end shared_row_length

// Part `i` of a tuple or an array literal written out.
private part_at(e: Expr, i: usize) -> Expr = *e.kind match
    Tuple(parts) -> parts.at(i)
    ArrayLit(xs) -> xs.at(i)
    _ -> e

// -- reading one ---------------------------------------------------------------------------------

index_expr(cx: &Analyzer, span: Span, receiver: Expr, index: Expr,
           expected: Option[Type]) -> TExpr
    *index.kind match
        RangeExpr(lo, hi, inclusive) ->
            return slice_expr(cx, span, receiver, lo, hi, inclusive, expected)
        _ -> ()

    val raw = type_expr_bare(cx, receiver)

    if texpr_type(raw) == Unknown then return raw

    // `p[i]` on a raw pointer is C's, unchecked: the pointer is a bare address, so the subscript is
    // the address arithmetic C spells the same way. A pointer to an *array* keeps the checked form,
    // because that one has a length in its type to check against.
    val tr = repr(texpr_type(raw)) match
        Ptr(inner) -> *inner match
            Array(_, _) -> auto_deref(cx, raw)
            _ -> raw
        _ -> auto_deref(cx, raw)

    repr(texpr_type(tr)) match
        // A lane is read out of a register rather than through an address, so the index is held to
        // being a constant and checked here, where there is a number to name.
        Vector(lanes, elem) -> lane_expr(cx, span, tr, index, lanes, *elem)
        _ -> index_non_vector(cx, span, raw, tr, index, expected)
end index_expr

// Whether a subscript on this type reaches one of the two indexing traits, asked of a type that has
// no elements of its own. A built-in's subscript is never this: an array, a slice and a string are
// indexed by the compiler, and nothing a program writes competes with that.
indexes_through(a: &Analysis, trait_name: string, t: Type) -> bool =
    !impls_of(a, trait_name, owner_key(t)).is_empty()

// The same, asked of a written receiver before a statement has committed to being a store.
// Whatever goes wrong typing the receiver is left for the ordinary path to report, where it was
// written.
indexes_written(cx: &Analyzer, trait_name: string, receiver: Expr) -> bool
    val key = catalog_key(cx.an, trait_name)

    if key.is_none() then return false

    val tried = begin_trial(cx)
    val t = type_expr_bare(cx, receiver)

    discard_trial(cx, tried)

    if texpr_type(t) == Unknown then return false

    // A type indexed in place is written through the place, never through the trait's call. A raw
    // pointer's subscript is the pointer's own, so a write through `*Buf` keeps reaching `IndexSet`.
    val place_key = catalog_key(cx.an, "IndexPlace")
    val through_ptr = texpr_type(t) match
        Ptr(_) -> true
        _ -> false

    if !through_ptr && place_key.is_some() &&
       indexes_through(cx.an, place_key.unwrap(), receiver_type(texpr_type(t)))
        return false

    indexes_through(cx.an, key.unwrap(), receiver_type(texpr_type(t)))
end indexes_written

private lane_expr(cx: &Analyzer, span: Span, tr: TExpr, index: Expr, lanes: int,
                  elem: Type) -> TExpr
    // The index is analyzed for its *type* even though its value comes from folding, so that `v[k]`
    // where `k` is a string is told it is not an integer rather than told it is not a constant.
    not_fixing_at(cx, index)

    val ti = type_expr(cx, index, Some(usize_type(word_bits(cx))))

    repr(texpr_type(ti)) match
        Integer(_, _, _) -> ()
        other -> if other != Unknown then
                     cx.fault(index.span, s"an index must be an integer, not ${type_show(other)}")

    val n = const_int(cx, index)

    if n.is_none() then
        return cx.err(index.span, "a lane index is part of the instruction that reads it, so it " +
                      "has to be a constant — a literal, or a 'const' naming one. To index " +
                      s"${type_show(repr(texpr_type(tr)))} by a computed number, keep the values " +
                      s"in a '[$lanes]${type_show(elem)}'")

    val v = n.unwrap().to_long().unwrap_or(-1)

    if v < 0 || v >= long(lanes) then
        return cx.err(index.span, s"${type_show(repr(texpr_type(tr)))} has lanes 0 to " +
                      s"${lanes - 1}, and this is ${to_string(n.unwrap())}")

    TExpr(span, TLane(tr, int(v), unqualified(elem)))
end lane_expr

private index_non_vector(cx: &Analyzer, span: Span, raw: TExpr, tr: TExpr, index: Expr,
                         expected: Option[Type]) -> TExpr
    val elem = element(texpr_type(tr))

    if elem.is_none()
        // A type with no elements of its own is indexed through `Index`, whose one method the
        // subscript **is**. The index is not held to being an integer here: what a container is
        // read by is the trait's own argument, and a type that indexes by something else is
        // implementing a different `Index` rather than misusing this one.
        var args: Buf[Expr] = buf()

        args.push(index)

        // **`IndexPlace` makes the subscript a place**: `b[i]` is `*b.index_place(i)`, so a field
        // of the element is read where it lives, a write lands in it, and a `ref` can name it. It
        // is asked first, so a type that also has `Index` for generic code is still indexed in place.
        val place_key = catalog_key(cx.an, "IndexPlace")

        if place_key.is_some() && indexes_through(cx.an, place_key.unwrap(), texpr_type(tr))
            val call = call_member(cx, span, raw, "index_place", args, None)

            *call.kind match
                TCall(name, _, _, _) -> cx.an.tables.place_calls.put(name, true)
                _ -> ()

            return repr(texpr_type(call)) match
                Ptr(inner) -> TExpr(span, TDeref(call, *inner))
                _ -> call
        end if

        val key = catalog_key(cx.an, "Index")

        if key.is_some() && indexes_through(cx.an, key.unwrap(), texpr_type(tr)) then
            return call_member(cx, span, raw, "index", args, expected)

        // A parameter has no implementation to find -- a bound is not one -- so the subscript goes
        // the way every other use of a parameter goes: to the member machinery, which answers from
        // the bounds and complains where they license nothing.
        texpr_type(tr) match
            Abstract(_, _) -> return call_member(cx, span, raw, "index", args, expected)
            _ -> ()

        return cx.err(span, s"cannot index ${type_show(texpr_type(tr))}")
    end if

    // **A raw pointer's index is signed**: `*T` carries no length, so `p[-1]` names the element
    // before `p` exactly as C's does, and a literal index takes `isize` to say so. Everything with a
    // length counts from its start, so its literal stays a `usize` and a negative one is refused.
    val index_type = repr(texpr_type(tr)) match
        Ptr(_) -> isize_type(word_bits(cx))
        _ -> usize_type(word_bits(cx))

    // Any integer indexes, so an index is not a use that fixes a literal binding's type
    // (`var_first_use.sysl`): `xs[i]` leaves `i` to a use that does.
    not_fixing_at(cx, index)

    val ti = type_expr(cx, index, Some(index_type))

    // A transparent constrained subtype stands where its base does, so an `Index within 0..<n`
    // indexes without a cast. A derived one does not: `new` is nominal, and reaching the base is
    // exactly what a written conversion is for.
    repr(texpr_type(ti)) match
        // The element's qualifier stays on the receiver's type and comes off the value read out of
        // it, exactly as a field's does.
        Integer(_, _, _) -> TExpr(span, TIndex(tr, ti, unqualified(elem.unwrap())))
        other ->
            if other == Unknown then return bad_expr(span)

            cx.err(index.span, s"an index must be an integer, not ${type_show(other)}")
end index_non_vector

// A range subscript takes a view. The receiver is left *undereferenced* on purpose: for a heap
// array the reference is both where the elements are and what keeps them alive, and evaluating it
// once is what makes those the same object.
private slice_expr(cx: &Analyzer, span: Span, receiver: Expr, lo: Option[Expr], hi: Option[Expr],
                   inclusive: bool, expected: Option[Type]) -> TExpr
    if !inclusive && hi.is_none() then cx.fault(span, "an open-ended slice is written 'a[lo..]'")

    // **An array literal is the one receiver with no type of its own**, so a view of one is the one
    // place the view's expectation has to reach through to the elements.
    val hint = elem_hint(receiver, expected)
    val tr = type_expr(cx, receiver, hint)
    val rt = texpr_type(tr)

    if rt == Unknown then return tr

    val want_const = expected.is_some() && read_only_view(expected.unwrap())
    val elem = slice_elem(cx, span, rt, hi)

    if elem.is_none() then return bad_expr(span)

    // Part of a string is a string, not a `[]u8` -- the bytes between two character boundaries are
    // still well-formed UTF-8, which is what the check at those boundaries is for. Anything else is
    // read-only when what it views is: an array that is `val` storage, or another view that had
    // already given the ability up. Re-slicing is where the bit is easiest to drop, which would make
    // `xs[1..]` the way around `xs`.
    //
    // **A raw pointer, a `&[N]T` and a slice own nothing**, so the binding that holds one being
    // written once says nothing about the elements it leads to -- the same answer `p[i] = v` gets.
    val view_ty = view_of(rt, elem.unwrap(),
                          want_const || read_only_view(rt) || read_only_elements(cx, tr))

    // A view that may be written is an alias like any other, so it is refused where a `&` would be:
    // over storage inside a struct whose invariant reads it.
    check_sliceable(cx, span, tr, view_ty)

    TExpr(span, TSlice(tr, lo.map(b -> slice_bound(cx, b)), hi.map(b -> slice_bound(cx, b)),
                       inclusive, view_ty))
end slice_expr

// Part of a string is a string, not a `[]u8` -- the bytes between two character boundaries are
// still well-formed UTF-8, which is what the check at those boundaries is for.
private view_of(receiver: Type, elem: Type, read_only: bool) -> Type
    if receiver == Str then return Str

    Slice(elem, read_only)
end view_of

private elem_hint(receiver: Expr, expected: Option[Type]) -> Option[Type]
    if expected.is_none() then return None

    *receiver.kind match
        ArrayLit(es) -> expected.unwrap() match
            Slice(elem, _) -> Some(Array(int(es.len()), *elem))
            _ -> None
        _ -> None
end elem_hint

private slice_elem(cx: &Analyzer, span: Span, rt: Type, hi: Option[Expr]) -> Option[Type]
    // An exported alias of a pointer is sliced as the pointer it names.
    repr(rt) match
        Str -> return Some(byte_type())
        Ref(inner, sync) ->
            if sync then
                cx.fault(span, "a slice does not record whether its owner's count is atomic, so a " +
                         "'&sync' array cannot be sliced")

                return None

            *inner match
                Array(_, e) -> return Some(*e)
                _ -> ()
        Array(_, e) -> return Some(*e)
        Slice(e, _) -> return Some(*e)
        // A view of a `*T` region -- the shape every C function that fills a buffer hands back. The
        // pointer carries no length, so the end must be written and is taken on trust.
        Ptr(inner) ->
            *inner match
                Array(_, e) -> return Some(*e)
                _ ->
                    if hi.is_none() then
                        cx.fault(span, s"a ${type_show(rt)} carries no length, so a view of one " +
                                 "needs its end written — 'p[0..<n]' with the number of elements " +
                                 "that are really there")

                        return None

                    return Some(*inner)
        _ -> ()

    // A type read by a subscript through `Index` cannot be **sliced** through it: the index would
    // have to be a range, and a range is not yet a type a program can name, so there is nothing for
    // the trait's argument to be. Somebody who has written an `Index` and is reaching for the
    // neighbouring form is owed that rather than "cannot slice", which reads as though their type
    // were the wrong shape for an operation that exists.
    val key = catalog_key(cx.an, "Index")

    if key.is_some() && indexes_through(cx.an, key.unwrap(), rt)
        cx.fault(span, s"${type_show(rt)} is read by a subscript through " +
                 s"'${qualified_name(key.unwrap())}', but slicing through the trait is not built: the " +
                 "index would have to be a range, and a range is not yet a type a program can name")
        return None
    end if

    cx.fault(span, s"cannot slice ${type_show(rt)}")
    None
end slice_elem

// One end of a slice range: an index like any other, so any integer will do.
private slice_bound(cx: &Analyzer, e: Expr) -> TExpr
    not_fixing_at(cx, e)

    val t = type_expr(cx, e, Some(usize_type(word_bits(cx))))

    texpr_type(t) match
        Integer(_, _, _) -> t
        other ->
            if other == Unknown then return t

            cx.err(e.span, s"a slice bound must be an integer, not ${type_show(other)}")
end slice_bound

// A receiver read through the one pointer or reference that may stand in front of it.
//
// **One level and only one** (`reference/memory.md § Places`): selection, a subscript, a call and a
// walk all reach through a single mode, and a receiver carrying more is handed back still carrying
// the rest -- which is what lets each form say the shorthand stopped short rather than quietly
// reading through a `**T`.
auto_deref(cx: &Analyzer, t: TExpr) -> TExpr
    val inner = pointee(texpr_type(t))

    if inner.is_none() then return t

    TExpr(t.span, TDeref(t, unqualified(inner.unwrap())))
end auto_deref

// -- the rest of the sequence forms --------------------------------------------------------------

// A tuple is a struct whose base names how many parts it has, exactly as the reference compiler
// builds one -- so nothing tells a tuple from a struct but its name.
tuple_expr(cx: &Analyzer, span: Span, elements: Buf[Expr], expected: Option[Type]) -> TExpr
    var wanted: Buf[Type] = buf()

    if expected.is_some() then
        repr(expected.unwrap()) match
            Struct(d) -> if is_tuple(d) then
                             for item in d.fields
                                 wanted.push(item.1)
            _ -> ()

    var ts: Buf[TExpr] = buf()
    var parts: Buf[Type] = buf()

    for i in 0..<elements.len()
        val want = if i < wanted.len() then Some(wanted.at(i)) else None
        val t = type_expr(cx, elements.at(i), want)

        // A part is storage in the tuple, and a part that diverges leaves nothing to store.
        if texpr_type(t) == Never then
            cx.fault(elements.at(i).span, "a tuple part has to be a value, and this expression never produces one")

        ts.push(t)
        parts.push(texpr_type(t))

    TExpr(span, TStructNew(registered_tuple(cx.an, parts), ts))
end tuple_expr

// `sizeof(T)` and `alignof(T)` -- a property of the type, known once the type is.
// **A measurement is a `usize` whatever position it stands in.** How wide a type is is a property of
// the type rather than of the expression's surroundings, so a context asking for something else is
// asking for a conversion the reader has to write -- which is what makes `f() -> int = sizeof(int)`
// a mistake rather than a silent narrowing.
layout_of(cx: &Analyzer, span: Span, op: string, t: TypeRef, expected: Option[Type]) -> TExpr
    val ty = resolve_type(cx.an, cx.scope, t, cx.subst)
    val v = layout_bytes(cx, op, ty)

    if v.is_none()
        // A parameter awaiting its instantiation, or a type already complained about -- the deferral
        // `offset_of` makes. A default reading `sizeof(T)` is checked where it is written with `T`
        // standing for itself, and measured at each call at the width that call gave `T`.
        if ty == Unknown || mentions_abstract(ty) then return bad_expr(span)

        return cx.err(span, s"'$op' measures a type this compilation has no layout for")
    end if

    v.unwrap() match
        ConstInt(n) -> int_literal(cx, span, n, "", Some(usize_type(word_bits(cx))))
        _ -> bad_expr(span)
end layout_of

// `offsetof(T, field)` folds for the same reason and under the same deferral.
offset_of(cx: &Analyzer, span: Span, t: TypeRef, field: string, expected: Option[Type]) -> TExpr
    val ty = resolve_type(cx.an, cx.scope, t, cx.subst)
    val refusals = cx.an.const_refusals
    val v = offset_bytes(cx, span, ty, field)

    if v.is_none() && const_refused_since(cx.an, refusals) then return bad_expr(span)

    if v.is_none() then
        // A parameter awaiting its instantiation, or a type already complained about.
        if ty == Unknown || mentions_abstract(ty) then return bad_expr(span)

        return cx.err(span, s"'offsetof' measures a type this compilation has no layout for")

    v.unwrap() match
        ConstInt(n) -> int_literal(cx, span, n, "", Some(usize_type(word_bits(cx))))
        _ -> bad_expr(span)
end offset_of
