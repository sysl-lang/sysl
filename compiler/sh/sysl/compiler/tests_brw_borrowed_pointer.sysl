module sh.sysl.compiler
@tests

import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture
import sysl.text.Search

// **A trait's `@borrows` holds for a raw pointer parameter as it does for a slice**: every
// implementation is held to letting the pointer go -- storing it, returning it, or handing it to
// something that keeps it is refused at the place it gets out. Because it is verified, the lent
// rule (`@lends`) takes the promise too, and a lent pointer may go through a trait object whose
// method promised to borrow it.

private brw_outcome(text: string) -> (string, int)
    val root = make_temp_dir("sysl-brw-ptr").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", text).unwrap()

    val exe = s"$root/built"

    build_native_program(root, None, None, DefaultOptimization, Some(exe)) match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return (failure_text(why), -1)
        Ok(_) -> ()

    val said = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    said match
        Err(_) -> ("the program that was built could not be run", -1)
        Ok(out) -> (out.text + out.err.unwrap_or(""), shell_status(out.status))
end brw_outcome

private brw_prints(text: string, want: string)
    if xvr_no_library() then return

    val out = brw_outcome(text)

    assert_eq(out.0, want)
    assert_eq(out.1, 0)
end brw_prints

// Refused, saying each of `parts` -- the promise broken, and the source line it is broken on.
private brw_refuses(text: string, parts: []string)
    if xvr_no_library() then return

    val out = brw_outcome(text)

    assert_eq(out.1, -1, out.0)

    for part in parts
        assert(out.0.index_of(part).is_some(), out.0)
end brw_refuses

private brw_broken() -> string = "keeps what it is passed as 'n', but 'Bump' declares that parameter borrowed"

// A trait whose method takes a pointer, with or without the promise.
private brw_bump(promise: bool, result: string) -> string =
    "trait Bump\n" + (if promise then "    @borrows(n)\n" else "") + s"    bump(*self, n: *int)$result\n\n"

// A cell lending its one field to a body for one call.
private brw_cell() -> string = raw"""
    struct Cell
        v: int

        @lends(body)
        with[R](*self, body: *int -> R) -> R = body(&self.v)

    """

private brw_adder() -> string = raw"""
    struct Adder
        by: int

    impl Bump for Adder
        bump(*self, n: *int)
            *n += self.by

    """

// -- the lent rule takes the promise ------------------------------------------------------------------

@test("a lent pointer passed through a trait object whose method promises to borrow it is accepted")
brw_lent_through_a_promise()
    brw_prints(brw_bump(true, "") + brw_adder() + brw_cell() + raw"""
        var c = Cell(1)
        var a = Adder(5)
        val b: *Bump = &a

        c.with((v) -> b.bump(v))
        c.with((v) -> b.bump(v))

        print(c.v)
        """, "11\n")

@test("without the promise the same call is refused, the trait object being free to keep it")
brw_lent_without_a_promise()
    brw_refuses(brw_bump(false, "") + brw_adder() + brw_cell() + raw"""
        var c = Cell(1)
        var a = Adder(5)
        val b: *Bump = &a

        c.with((v) -> b.bump(v))
        """, ["'Cell.with' lends this body a pointer",
              "is passed through a trait object, which may hold on to it"])

@test("an implementation that only reads and writes through a borrowed pointer is accepted")
brw_pointer_used_and_let_go()
    brw_prints(brw_bump(true, "") + brw_adder() + raw"""
        var a = Adder(3)
        val b: *Bump = &a
        var x = 4

        b.bump(&x)

        print(x)
        """, "7\n")

// -- every implementation is held to it ---------------------------------------------------------------

@test("an implementation that stores a borrowed pointer in a field is refused where it stores it")
brw_pointer_kept_in_a_field()
    brw_refuses(brw_bump(true, "") + raw"""
        struct Keeper
            held: *int

        impl Bump for Keeper
            bump(*self, n: *int)
                self.held = n

        var x = 3
        var k = Keeper(&x)
        val b: *Bump = &k
        var y = 9

        b.bump(&y)

        print(*k.held)
        """, [brw_broken(), "self.held = n"])

@test("and one that hands it back")
brw_pointer_returned()
    brw_refuses(brw_bump(true, " -> *int") + raw"""
        struct Echo
            calls: int

        impl Bump for Echo
            bump(*self, n: *int) -> *int
                self.calls += 1
                n

        var e = Echo(0)
        val b: *Bump = &e
        var y = 9

        print(*b.bump(&y))
        """, [brw_broken()])

@test("and one that stores it in a module variable")
brw_pointer_kept_in_a_global()
    brw_refuses(brw_bump(true, "") + raw"""
        static var spare = 0
        static var last: *int = &spare

        struct Logger
            calls: int

        impl Bump for Logger
            bump(*self, n: *int)
                last = n

        var l = Logger(0)
        val b: *Bump = &l
        var y = 9

        b.bump(&y)

        print(*last)
        """, [brw_broken(), "last = n"])

@test("and one that keeps a pointer it derived from it, into the storage it was lent")
brw_derived_pointer_kept()
    brw_refuses(raw"""
        struct Pair
            a: int
            b: int

        trait Bump
            @borrows(n)
            bump(*self, n: *Pair)

        struct Keeper
            held: *int

        impl Bump for Keeper
            bump(*self, n: *Pair)
                self.held = &n.b

        var x = 3
        var k = Keeper(&x)
        val b: *Bump = &k
        var p = Pair(1, 2)

        b.bump(&p)
        """, [brw_broken(), "self.held = &n.b"])

@test("a pointer inside a struct parameter is held to the promise too")
brw_pointer_in_a_struct_kept()
    brw_refuses(raw"""
        struct Ref
            p: *int

        trait Take
            @borrows(r)
            take(*self, r: Ref)

        struct Keeper
            held: *int

        impl Take for Keeper
            take(*self, r: Ref)
                self.held = r.p

        var x = 3
        var k = Keeper(&x)
        val t: *Take = &k
        var y = 9

        t.take(Ref(&y))
        """, ["keeps what it is passed as 'r', but 'Take' declares that parameter borrowed",
              "self.held = r.p"])

@test("a generic trait's promise binds an implementation at the instance an object names")
brw_generic_trait_pointer_kept()
    brw_refuses(raw"""
        trait Hold[T]
            @borrows(n)
            hold(*self, n: *T)

        struct Keeper
            held: *int

        impl Hold[int] for Keeper
            hold(*self, n: *int)
                self.held = n

        var x = 3
        var k = Keeper(&x)
        val h: *Hold[int] = &k
        var y = 9

        h.hold(&y)
        """, ["keeps what it is passed as 'n', but 'Hold", "self.held = n"])

// -- the receiver rule is unchanged -------------------------------------------------------------------

@test("a *self method passing a view of its receiver through a trait object is still accepted")
brw_receiver_view_through_an_object()
    brw_prints(raw"""
        trait Sink
            put(*self, bytes: []const u8)

        struct Counter
            n: usize

        impl Sink for Counter
            put(*self, bytes: []const u8)
                self.n += bytes.len

        struct Inner
            data: [4]u8

            feed(*self, s: *Sink)
                s.put(self.data[0..<4])

        struct Outer
            inner: Inner
            count: int

            invariant count >= 0

        var c = Counter(0)
        val s: *Sink = &c
        var o = Outer(Inner([1, 2, 3, 4]), 0)

        o.inner.feed(s)

        print(c.n)
        """, "4\n")
