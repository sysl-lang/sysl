module sysl.tty.hosted
@requires(os, libc)
@tests

import sysl.tty.sys.Mode

// The packed integer is the whole agreement with the C beside this module, so its layout is pinned
// here: the five flags in the low byte in `Mode`'s order, `min` in the next byte and `time` in the
// one after.

@test("each flag is its own bit, in the order Mode names them")
each_flag_is_a_bit()
    assert_eq(packed(Mode(true, false, false, false, false, 0, 0)), 1)
    assert_eq(packed(Mode(false, true, false, false, false, 0, 0)), 2)
    assert_eq(packed(Mode(false, false, true, false, false, 0, 0)), 4)
    assert_eq(packed(Mode(false, false, false, true, false, 0, 0)), 8)
    assert_eq(packed(Mode(false, false, false, false, true, 0, 0)), 16)
end each_flag_is_a_bit

@test("min and time ride in the second and third bytes")
min_and_time_bytes()
    assert_eq(packed(Mode(false, false, false, false, false, 1, 0)), 256)
    assert_eq(packed(Mode(false, false, false, false, false, 0, 255)), 255 << 16)
end min_and_time_bytes

@test("unpacking a packed mode gives the mode back")
round_trip()
    val modes = [Mode(true, true, true, true, true, 1, 0), Mode(false, true, false, true, true, 0, 0),
                 Mode(false, false, false, true, true, 255, 255), Mode(true, false, true, false, true, 7, 3)]

    for m in modes
        assert(unpacked(packed(m)) == m, "a mode did not survive the trip")
end round_trip
