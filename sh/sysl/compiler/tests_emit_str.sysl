    assert_eq(str_lowered(
                  "part(xs: []const int, a: usize, b: usize) -> []const int = xs[a..<b]\n" +
                  "main()\n" +
                  "    val xs = [1, 2, 3]\n" +
                  "\n" +
                  "    print(part(xs[0..<3], 0, 1).len)\n",
              "part"),
              "define { ptr, ptr, i64 } @part({ ptr, ptr, i64 } %xs.param, i64 %a.param, i64 %b.param) {\n" +
              "entry:\n" +
              "  %xs.addr = alloca { ptr, ptr, i64 }\n" +
              "  %a.addr = alloca i64\n" +
              "  %b.addr = alloca i64\n" +
              "  store { ptr, ptr, i64 } %xs.param, ptr %xs.addr\n" +
              "  %t1 = extractvalue { ptr, ptr, i64 } %xs.param, 0\n" +
              "  call void @arc.retain_maybe(ptr %t1)\n" +
              "  store i64 %a.param, ptr %a.addr\n" +
              "  store i64 %b.param, ptr %b.addr\n" +
              "  %t2 = load { ptr, ptr, i64 }, ptr %xs.addr\n" +
              "  %t3 = extractvalue { ptr, ptr, i64 } %t2, 0\n" +
              "  %t4 = extractvalue { ptr, ptr, i64 } %t2, 1\n" +
              "  %t5 = extractvalue { ptr, ptr, i64 } %t2, 2\n" +
              "  %t6 = load i64, ptr %a.addr\n" +
              "  %t7 = load i64, ptr %b.addr\n" +
              "  %t8 = icmp ule i64 %t7, %t5\n" +
              "  br i1 %t8, label %bounds.ok1, label %bounds.bad2\n" +
              "bounds.bad2:\n" +
              "  call void @llvm.trap()\n" +
              "  unreachable\n" +
              "bounds.ok1:\n" +
              "  %t9 = icmp ule i64 %t6, %t7\n" +
              "  br i1 %t9, label %bounds.ok3, label %bounds.bad4\n" +
              "bounds.bad4:\n" +
              "  call void @llvm.trap()\n" +
              "  unreachable\n" +
              "bounds.ok3:\n" +
              "  %t10 = getelementptr i32, ptr %t4, i64 %t6\n" +
              "  %t11 = sub i64 %t7, %t6\n" +
              "  call void @arc.retain_maybe(ptr %t3)\n" +
              "  %t12 = insertvalue { ptr, ptr, i64 } zeroinitializer, ptr %t3, 0\n" +
              "  %t13 = insertvalue { ptr, ptr, i64 } %t12, ptr %t10, 1\n" +
              "  %t14 = insertvalue { ptr, ptr, i64 } %t13, i64 %t11, 2\n" +
              "  %t15 = extractvalue { ptr, ptr, i64 } %t14, 0\n" +
              "  call void @arc.retain_maybe(ptr %t15)\n" +
              "  %t16 = extractvalue { ptr, ptr, i64 } %t14, 0\n" +
              "  call void @arc.release_maybe(ptr %t16)\n" +
              "  %t17 = load { ptr, ptr, i64 }, ptr %xs.addr\n" +
              "  %t18 = extractvalue { ptr, ptr, i64 } %t17, 0\n" +
              "  call void @arc.release_maybe(ptr %t18)\n" +
              "  ret { ptr, ptr, i64 } %t14\n" +
              "}\n")
end a_slice_of_a_slice_narrows_and_shares_the_owner

