module sh.sysl.compiler

import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}
import sysl.container.{Map, map}

// What an object reached through an atomic reference may contain.
//
// **`&sync T` makes the REFERENCE safe to hold in two concurrency domains at once.** That is a
// promise about the count in `T`'s own box and about nothing else, so it is sound only where every
// count the object reaches is atomic too: a domain holding the object holds everything the object
// holds, and one ordinary count anywhere inside it is the same race one level down.
//
// **The walk stops at two things.** A `&sync U` is a leaf, because whatever *that* type reaches was
// settled where it was written -- the same argument that makes a `&T` a leaf for ARC. A `*U` is a
// leaf because it carries no count at all: it is the unsafe tier, and sharing through one is
// something a reader wrote on purpose.
//
// The strict half of the rule is asked where a `&sync T` is formed, and again at a `@crossing`
// parameter, where a facility says that what is passed there reaches another domain. The strict
// half is the right one to ask at a parameter, because a parameter copies nothing: the leniency the
// crossable list shows a view is about a channel that copies its bytes, and its leniency towards a
// `*T` is exactly what the annotation suspends.

// What stops an object being shareable: the field path that reaches it, its type, and the struct or
// enum whose field it is -- nothing where the object asked about is itself the thing in the way,
// which is also what an empty path means.
struct Unshareable
    path: Buf[string]
    ty: Type
    holder: Option[Type]
end Unshareable

// The part of a type that may not be shared, or nothing where every count it reaches is atomic.
unshareable(t: Type) -> Option[Unshareable] = share_walk(t, buf(), None, false)

// The same question of storage **laid down as data**, whose every view and string is a literal's
// and whose every reference is its type's empty one: no owner, so no count to keep. What can still come to hold one is a view written through -- a
// `[]T` in a `val` -- since a store into it puts there whatever the program made, so its elements
// are asked as ordinary values are.
laid_unshareable(t: Type) -> Option[Unshareable] = share_walk(t, buf(), None, true)

private share_walk(t: Type, path: Buf[string], holder: Option[Type],
                   laid: bool) -> Option[Unshareable] = t match
    Ref(_, sync) -> if sync || laid then None else Some(Unshareable(path, t, holder))
    Ptr(_) -> None
    Weak(_) -> if laid then None else Some(Unshareable(path, t, holder))
    Slice(elem, read_only) ->
        if !laid then Some(Unshareable(path, t, holder))
        else if read_only then None
        else share_walk(*elem, path, holder, false)
    Str -> if laid then None else Some(Unshareable(path, t, holder))

    // An array *is* its elements, so sharing one shares each of them; the path stops at the field,
    // since naming the element is what the reported type already does.
    Array(_, elem) -> share_walk(*elem, path, holder, laid)

    Constrained(d) -> share_walk(d.base, path, holder, laid)
    Struct(d) -> share_walk_fields(d.fields, path, "", t, laid)

    // A data enum shares one payload region, so every variant's fields are reachable from it.
    Enum(d) -> share_walk_variants(d.variants, path, t, laid)

    // A type parameter promises nothing about its counts, and nothing is decided here: the
    // instantiation resolves this type again with an argument in its place, and that is where the
    // question has an answer. A trait object is the same case one step further -- the type it forgot
    // is known where a value is erased into one, and that is where it is asked.
    _ -> None

private share_walk_fields(fields: Buf[(string, Type)], path: Buf[string],
                          prefix: string, holder: Type, laid: bool) -> Option[Unshareable]
    for item in fields
        val named = if prefix == "" then item.0 else s"$prefix(${item.0})"
        val found = share_walk(item.1, extended_path(path, named), Some(holder), laid)

        if found.is_some() then return found

    None
end share_walk_fields

private share_walk_variants(variants: Buf[EnumVariant], path: Buf[string],
                            holder: Type, laid: bool) -> Option[Unshareable]
    for item in variants
        val found = share_walk_fields(item.fields, path, item.name, holder, laid)

        if found.is_some() then return found

    None
end share_walk_variants

// A path with one more step on the end. **Built fresh rather than pushed onto**, since a `Buf`
// handed on is a second name for one buffer and the walk hands the same path to every field.
private extended_path(path: Buf[string], name: string) -> Buf[string]
    var out: Buf[string] = buf()

    for item in path
        out.push(item)

    out.push(name)
    out
end extended_path

// Why a `&sync T` may not be formed over `inner`, or nothing where it may. The complaint names the
// part in the way and what to do about it.
//
// **A closure is a struct a program wrote and did not name**, so nothing said about one repeats the
// name the compiler filed it under: it is "a closure", and what is in the way is something "it
// captures" (`reference/types.md § Function types`).
share_complaint(inner: Type, a: &Analysis, scope: Scope) -> Option[string]
    val part = unshareable(inner)

    if part.is_none() then return None

    val p = part.unwrap()
    val named = !is_closure_literal(inner)
    var head = "a closure shared between two domains may be called from either, so every count it " +
               "captures has to be atomic — "

    if named
        head = s"'&sync ${type_show(inner)}' may be reached from two domains at once, so every count " +
               "inside it has to be atomic — "

    val sealed = sealed_holder(p, a, scope)

    if sealed.is_some() then return Some(head + sealed_where(p, sealed.unwrap(), inner, !named))

    val where = if named || p.path.is_empty() then share_where(p, inner)
    else s"but the '${joined(p.path, ".")}' it captures reaches a '${type_show(p.ty)}'"

    Some(share_remedy(head + s"$where, ", p.ty))
end share_complaint

// The type a program wrote whose count is the one in the way, where that count lives in a type the
// program cannot name -- a container's core, declared `private` in the library -- or nothing where
// the reference is one the program can spell as a `&sync` itself.
//
// **The advice "hold it as a `&sync` core" names a declaration the reader may not write**, so where
// the box behind the reference is out of the reader's reach, what is said is about the holder: a
// `Buf` is shared through a count that is not atomic, and there is no spelling of one that crosses.
sealed_holder(p: Unshareable, a: &Analysis, scope: Scope) -> Option[Type]
    if p.holder.is_none() then return None

    val key = p.ty match
        Ref(inner, _) -> (*inner) match
            Struct(d) -> d.base
            Enum(d) -> d.base
            _ -> ""
        _ -> ""

    if key == "" || reachable_key(a, key, scope) then return None

    p.holder
end sealed_holder

// Where the sealed holder sits, said as `share_where` says a part: the object itself, something it
// holds directly, or something a named path inside it reaches -- and then why it cannot cross.
sealed_where(p: Unshareable, holder: Type, whole: Type, captured: bool) -> string
    var steps: Buf[string] = buf()

    for i in 0..<p.path.len() - 1
        steps.push(p.path.at(i))

    val shown = type_show(holder)
    val rest = sealed_rest()

    if steps.is_empty() && holder == whole then return s"but a '$shown' is $rest"
    if steps.is_empty() then return s"but it holds a '$shown', which is $rest"
    if captured then return s"but the '${joined(steps, ".")}' it captures is a '$shown', which is $rest"

    s"but its '${joined(steps, ".")}' is a '$shown', which is $rest"
end sealed_where

// Why a container whose core the reader cannot name stops at a domain's edge -- the end of every
// sentence `sealed_where` and the task-frame message say about one.
sealed_rest() -> string =
    "shared through a count that is not atomic, and no spelling of it can cross into a '&sync' ('06')"

// Holds a `&sync T` written at `span` to the rule about what `T` may contain -- now if every type's
// fields are in, and once they are if not.
check_shared(a: &Analysis, scope: Scope, span: Span, inner: Type)
    if a.shares_asked_at_trait then return

    if !a.types_hoisted
        a.shared_checks.push((inner, scope, span))
        return
    end if

    val why = share_complaint(inner, a, scope)

    if why.is_some() then a.fault(scope, span, why.unwrap())
end check_shared

// A type a trait implementation's member signature writes, resolved without asking the `&sync`
// question: the signature restates the trait's, and the trait's own is where it is asked.
restated(a: &Analysis, resolve: &Fn() -> Type) -> Type
    val before = a.shares_asked_at_trait

    a.shares_asked_at_trait = true

    val t = resolve()

    a.shares_asked_at_trait = before
    t
end restated

// Asks every question `check_shared` had to hold back, now that it has an answer.
settle_shared_checks(a: &Analysis)
    a.types_hoisted = true

    for c in a.shared_checks
        check_shared(a, c.1, c.2, c.0)

    a.shared_checks = buf()
end settle_shared_checks

// Why a value may not be handed to a `@crossing` parameter, or nothing where it may.
//
// `subject` is the caller's words for what is crossing -- the argument, or what the argument points
// at -- because the two shapes a boundary takes are worth telling apart at the call and are not
// something this walk can see. Everything after it is the same sentence a `&sync T` gets, and
// deliberately so: the question is the same one, and the answer a reader needs is the spelling that
// would have been sound.
crossing_complaint(subject: string, crossed: Type, a: &Analysis, scope: Scope) -> Option[string]
    val part = unshareable(crossed)

    if part.is_none() then return None

    val p = part.unwrap()
    val head = s"$subject reaches another concurrency domain, so every count inside it has to be atomic — "
    val sealed = sealed_holder(p, a, scope)

    if sealed.is_some() then return Some(head + sealed_where(p, sealed.unwrap(), crossed, false))

    Some(share_remedy(head + s"${share_where(p, crossed)}, ", p.ty))
end crossing_complaint

// Which part is in the way, said three ways: the object itself, something it holds directly, and
// something a named path inside it reaches.
private share_where(p: Unshareable, whole: Type) -> string
    if p.path.is_empty() && p.ty == whole then return s"but it is a '${type_show(p.ty)}'"
    if p.path.is_empty() then return s"but it holds a '${type_show(p.ty)}'"

    s"but its '${joined(p.path, ".")}' reaches a '${type_show(p.ty)}'"
end share_where

// What to do about the part in the way: a plain reference has an atomic spelling to reach for, a
// weak one has none yet, and a view has a distinction the language cannot draw.
share_remedy(head: string, ty: Type) -> string = ty match
    Ref(inner, _) -> head + s"whose count is not. Hold it as a '&sync ${type_show(*inner)}' ('06')"
    Weak(_) -> head + "and a weak count has no atomic form yet"
    _ -> head + share_view_remedy(if ty == Str then "bytes" else "elements")

private share_view_remedy(what: string) -> string =
    s"which owns its $what through a count that is not atomic. A literal's $what are immortal and " +
    s"would be safe to share, but nothing in the type says whether these are, so a shared object " +
    "holds no view at all ('06')"

// Holds each `@crossing` argument of one call to the rule about what may reach another domain.
//
// **The check is made at the CALL and reads the instantiated signature**, which is what makes it
// reach a facility the language does not own: a package's `task(…)` and the library's `spawn` are
// one shape here, and a generic parameter has a concrete type by the time this runs.
//
// **A `*T` parameter is looked *through*, and that is the whole of what the annotation buys.** A raw
// pointer is shareable because it carries no count of its own -- which says nothing about the object
// at the far end, and the object at the far end is what crossed. Everything else is asked about the
// parameter's own type, a parameter copying no buffer and sharing whatever it names.
//
// Reported at the **argument**, that being the thing that could have been written differently. A
// receiver among the parameters is skipped by construction: `@crossing` names a member's own
// parameters and `self` is not one of them.
check_crossings(cx: &Analyzer, crossing: Buf[string], shown: string, params: Buf[(string, Type)],
                args: Buf[TExpr])
    if crossing.is_empty() then return

    for i in 0..<params.len()
        if i >= args.len() then break
        if !holds_string(crossing, params.at(i).0) then continue

        check_crossing(cx, args.at(i), params.at(i).0, shown, params.at(i).1)
end check_crossings

// **A task in what crosses is noted rather than answered**: what its frame holds is read off the
// body of the async function that made it, which need not be typed yet (`task_domains.sysl`). The
// argument's own type is what is asked about there, since a parameter written `Task[T]` says nothing
// about which function made the one it is handed.
private check_crossing(cx: &Analyzer, arg: TExpr, pname: string, shown: string, pty: Type)
    val subject = pty match
        Ptr(_) -> s"what '$pname' of '$shown' points at"
        _ -> s"'$pname' of '$shown'"

    val why = pty match
        Ptr(inner) -> crossing_complaint(subject, *inner, cx.an, cx.scope)
        _ -> crossing_complaint(subject, pty, cx.an, cx.scope)

    if why.is_some() then cx.fault(arg.span, why.unwrap())
    else note_task_crossing(cx, arg.span, CrossArg(subject), arg)
end check_crossing

// -- module storage, reached from another domain ----------------------------------------------------

// **What a closure captures is asked at the closure; what it reaches through module storage is asked
// here**, over the whole program, because storage is named rather than captured and may be several
// calls down. A module `var` is one object every domain shares, so a count in it that is not atomic
// is the race a capture would have been -- touched by the body in the other domain and by whatever
// the rest of the program does with it.
//
// **Two kinds of body run in another domain.** A value erased into a `&sync` object: the object may
// be handed to another thread, and its methods run there -- a closure's body, a named function read
// into a `&sync Fn`. A `@crossing` parameter adds nothing to that list, since everything a crossing
// hands over that holds a count is held to being `&sync` at the call. And an interrupt handler,
// which the processor enters on top of whatever was running: one written in the `interrupt`
// convention, or an ordinary function marked `@domain(interrupt)` -- the shape a vector table written
// in assembly calls, which saves the interrupted registers itself and calls sysl as C would.
//
// **An `@export` is not a root**, though C may call one from anywhere: an export is how a C program,
// a JNI activity or a board's `main` enters sysl at all, and almost always from the one thread the
// program has. Holding every export to this would refuse every archive that keeps its state in a
// module `var`, for a second domain nothing says exists. `@domain(interrupt)` is how one says so.
//
// **A `val` filled at run time is asked as a `var` is**, since reading it takes a share of the same
// count; a `val` laid down as constant data is not, and neither is `@thread_local` storage, which is
// one copy per thread.

// Where a body that runs in another domain begins: the functions it starts at, where the refusal is
// placed, and the opening of the sentence that refuses it.
private struct DomainRoot
    funcs: Buf[string]
    scope: Scope
    span: Span
    head: string
end DomainRoot

private struct DomainRoots
    list: Buf[DomainRoot]
    // Whether anything in the program awaits a `park`, and so whether a `&Fn() -> unit` in module
    // storage may be a waker -- which changes the advice, a waker having no atomic spelling.
    parks: bool
end DomainRoots

// Holds the module storage every body in another domain reaches to the rule a capture is held to.
check_shared_storage(a: &Analysis, p: TProgram)
    val roots = domain_roots(a, p)

    if roots.list.is_empty() then return

    var vals: Map[string, usize] = map()

    for i in 0..<p.vals.len()
        vals.put(p.vals.at(i).symbol, i)

    for r in roots.list
        for item in storage_reached_in_domain(p, r.funcs)
            vals.get(item.0) match
                Some(i) ->
                    val why = storage_complaint(a, r, p.vals.at(i), item.1, roots.parks)

                    if why.is_some() then a.fault(r.scope, r.span, why.unwrap())
                None -> ()
end check_shared_storage

// Every erasure into a `&sync` object the program makes, and every interrupt handler it declares.
private domain_roots(a: &Analysis, p: TProgram) -> &DomainRoots
    val out: &DomainRoots = DomainRoots(buf(), false)

    var tables: Map[string, usize] = map()

    for i in 0..<p.vtables.len()
        tables.put(p.vtables.at(i).name, i)

    for i in 0..<p.funcs.len()
        val f = p.funcs.at(i)
        val home = func_home(a, f.name)

        walk_block_stmts(f.body, expr_walk(false, e -> note_sync_erasure(out, p, tables, home, e)))

        if f.conv.is_some()
            add_root(&out.list, DomainRoot(just(f.name), home, f.span,
                                           s"'${qualified_name(f.name)}' is an interrupt handler, entered " +
                                           "on top of whatever was running, so every count it reaches " +
                                           "has to be atomic — "))
        else if f.marks.domain.is_some()
            add_root(&out.list, DomainRoot(just(f.name), home, f.span,
                                           s"'${qualified_name(f.name)}' is entered in the " +
                                           s"'${f.marks.domain.unwrap()}' domain, on top of whatever was " +
                                           "running, so every count it reaches has to be atomic — "))
        end if

    val entry = entry_home(a)

    walk_stmts(p.main, expr_walk(false, e -> note_sync_erasure(out, p, tables, entry, e)))
    out
end domain_roots

private add_root(list: *Buf[DomainRoot], r: DomainRoot) = list.push(r)

private just(name: string) -> Buf[string]
    var out: Buf[string] = buf()

    out.push(name)
    out
end just

// A root where `e` erases a value into a `&sync` object: the functions its table points at.
private note_sync_erasure(out: &DomainRoots, p: TProgram, tables: Map[string, usize], home: Scope,
                          e: TExpr)
    *e.kind match
        TPark(_) -> out.parks = true
        TErase(operand, vtable, want) ->
            val sync = want match
                Ref(_, s) -> s
                _ -> false

            if !sync then return

            val at = tables.get(vtable)

            if at.is_none() then return

            var funcs: Buf[string] = buf()

            for slot in p.vtables.at(at.unwrap()).slots
                funcs.push(slot.target)

            val inner = erased_inner(texpr_type(operand))
            var head = "a closure shared between two domains may be called from either, so every count " +
                       "it reaches has to be atomic — "

            if !is_closure_literal(inner)
                head = s"a '${type_show(want)}' may be called from two domains at once, so every count " +
                       s"its '${type_show(inner)}' reaches has to be atomic — "

            add_root(&out.list, DomainRoot(funcs, home, e.span, head))
        _ -> ()
end note_sync_erasure

// The type a value was before it was boxed for an object.
private erased_inner(t: Type) -> Type = t match
    Ref(inner, _) -> *inner
    _ -> t

// Why one piece of module storage may not be reached from the root, or nothing where it may.
private storage_complaint(a: &Analysis, r: DomainRoot, v: TVal, reader: string,
                          parks: bool) -> Option[string]
    if v.thread_local then return None

    val part = if !v.writable && !v.computed then laid_unshareable(v.ty) else unshareable(v.ty)

    if part.is_none() then return None

    val p = part.unwrap()
    var subject = s"but the module storage '${qualified_name(v.symbol)}' it reaches"

    if !holds_string(r.funcs, reader) then subject = subject + s", which '${qualified_name(reader)}' reads,"

    val sealed = sealed_holder(p, a, r.scope)

    if sealed.is_some() then return Some(r.head + subject + storage_sealed(p, sealed.unwrap(), v.ty))

    if parks && p.ty == waker_type_in(a)
        return Some(r.head + subject + storage_where(p, v.ty) + ", whose count is not. If it holds a " +
                    "waker 'park' handed its registrar, no spelling makes that atomic: keep the waker in " +
                    "the executor's domain — have this one signal the executor, and the executor call " +
                    s"the waker. A callback of the program's own is held as a '&sync ${type_show(erased_inner(p.ty))}' " +
                    "('06')")
    end if

    Some(share_remedy(r.head + subject + storage_where(p, v.ty) + ", ", p.ty))
end storage_complaint

// Which part of the storage is in the way: the storage itself, something it holds directly, or
// something a named path inside it reaches.
private storage_where(p: Unshareable, whole: Type) -> string
    val shown = type_show(p.ty)

    if p.path.is_empty() && p.ty == whole then return s" is a '$shown'"
    if p.path.is_empty() then return s" holds a '$shown'"

    s" holds a '$shown' in its '${joined(p.path, ".")}'"
end storage_where

// The same, where the count in the way lives in a container whose core the reader cannot name.
private storage_sealed(p: Unshareable, holder: Type, whole: Type) -> string
    var steps: Buf[string] = buf()

    for i in 0..<p.path.len() - 1
        steps.push(p.path.at(i))

    val shown = type_show(holder)
    val rest = sealed_rest()

    if steps.is_empty() && holder == whole then return s" is a '$shown', which is $rest"
    if steps.is_empty() then return s" holds a '$shown', which is $rest"

    s" holds a '$shown' in its '${joined(steps, ".")}', which is $rest"
end storage_sealed
