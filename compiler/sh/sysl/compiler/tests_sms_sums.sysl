module sh.sysl.compiler
@tests

// `sysl.sum` -- what a resolved package's source was when it was first seen (`reference/packages.md
// § sysl.sum`).
//
// Reading is a pure function of the file's text, as `package.hocon`'s is, so none of these cases needs
// a package to exist. Every refusal quoted here is the reference's own words for the same line, read
// off `sysl build` over a project carrying it.

// A digest as one is written in the file: the algorithm, then sixty-four of one hex digit.
private sms_digest(of: string) -> string
    var out = DigestPrefix

    for i in 0..<64
        out = out + of

    out
end sms_digest

private sms_one() -> string = sms_digest("a")
private sms_two() -> string = sms_digest("b")

private sms_read(text: string) -> Sums = sums_read(text).unwrap()
private sms_refused(text: string) -> string = sums_read(text).unwrap_err()

@test("a file that records two packages")
sms_a_file_that_records_two_packages()
    val sums = sms_read(s"github.com/e/json v1.4.0 ${sms_one()}\ngithub.com/e/regex v0.4.0 ${sms_two()}\n")

    assert_eq(sum_of(sums, "github.com/e/json", Release(1, 4, 0)).unwrap(), sms_one())
    assert_eq(sum_of(sums, "github.com/e/regex", Release(0, 4, 0)).unwrap(), sms_two())

@test("a package no line covers")
sms_a_package_no_line_covers()
    val sums = sms_read(s"github.com/e/json v1.4.0 ${sms_one()}\n")

    assert(sum_of(sums, "github.com/e/json", Release(1, 5, 0)).is_none(), "no line covers v1.5.0")

@test("an empty file records nothing")
sms_an_empty_file_records_nothing()
    val sums = sms_read("")

    assert_eq(sums.entries.len(), empty_sums().entries.len())
    assert_eq(sums_render(sums), "")

@test("blank lines are not entries")
sms_blank_lines_are_not_entries()
    assert_eq(sms_read(s"\ngithub.com/e/json v1.4.0 ${sms_one()}\n\n").entries.len(), 1)

// Sorted and one per line, so that two runs resolving the same graph write the same bytes and a diff
// shows what changed rather than how a table was walked.
@test("what is written back is stable")
sms_what_is_written_back_is_stable()
    val text = s"github.com/e/json v1.4.0 ${sms_one()}\ngithub.com/e/regex v0.4.0 ${sms_two()}\n"

    assert_eq(sums_render(sms_read(text)), text)
    assert_eq(sums_render(sms_read(s"github.com/e/regex v0.4.0 ${sms_two()}\ngithub.com/e/json v1.4.0 ${sms_one()}\n")),
              text)

@test("a version's entries sort by version and not by their text")
sms_entries_sort_by_version_not_text()
    val ten = s"github.com/e/j v1.10.0 ${sms_one()}"
    val point = s"github.com/e/j v1.2.0 ${sms_two()}"

    assert_eq(sums_render(sms_read(s"$ten\n$point\n")), s"$point\n$ten\n")

@test("recording a package that was not there")
sms_recording_a_package_that_was_not_there()
    assert_eq(sums_render(sums_recording(empty_sums(), "github.com/e/json", Release(1, 4, 0), sms_one())),
              s"github.com/e/json v1.4.0 ${sms_one()}\n")

// The file exists to refuse things. One that skipped what it could not read would answer "no entry
// covers this package" for a package it was carrying an entry for.

@test("too few fields")
sms_too_few_fields()
    assert_eq(sms_refused("github.com/e/json v1.4.0"),
              "sysl.sum:1: a line is a coordinate, a version tag and a digest")

@test("a version with no tag on it")
sms_a_version_with_no_tag_on_it()
    assert_eq(sms_refused(s"github.com/e/json 1.4.0 ${sms_one()}"), "sysl.sum:1: '1.4.0' is not a version tag")

@test("a version tag that is not a version")
sms_a_version_tag_that_is_not_a_version()
    assert_eq(sms_refused(s"github.com/e/json vlatest ${sms_one()}"),
              "sysl.sum:1: 'latest' is not a version — a version is three numbers, as in '1.4.2'")

@test("a digest that names no algorithm")
sms_a_digest_that_names_no_algorithm()
    val bare = sms_one()[DigestPrefix.bytes.len..<sms_one().bytes.len]

    assert_eq(sms_refused(s"github.com/e/json v1.4.0 $bare"), s"sysl.sum:1: '$bare' is not a sha256: digest")

@test("a digest of the wrong length")
sms_a_digest_of_the_wrong_length()
    assert_eq(sms_refused(s"github.com/e/json v1.4.0 ${DigestPrefix}abc"),
              "sysl.sum:1: 'sha256:abc' is not a sha256: digest")

// Badly merged, or edited by hand. There is no reading of it under which one of the two is the answer,
// so neither is taken.
@test("one package recorded twice, differently")
sms_one_package_recorded_twice_differently()
    assert_eq(sms_refused(s"github.com/e/json v1.4.0 ${sms_one()}\ngithub.com/e/json v1.4.0 ${sms_two()}\n"),
              "sysl.sum: 'github.com/e/json v1.4.0' is recorded with two different digests")
