// A program using the `rx` library, which is bound to POSIX regex through the C beside it.
//
// A binding is a library rather than a single file, and `--lib` takes the tree it lives in:
//
//     sbt "syslJVM/run run bindings/regex/match.sysl --lib bindings/regex/lib"
//
// The walk that finds `rx.sysl` finds `regex.c` beside it, and it is compiled for the same target
// (`15 §7`). Nothing on this side knows C is involved.
//
// This once took two commands, because the C travelled only in a built artifact and a `--lib` source
// root had its own silently dropped -- which was the same hole that made a package carrying C
// unusable as a dependency. Both roads carry it now, so building the artifact first is a choice
// rather than a step, and is what a program compiled away from the library's source wants:
//
//     sbt "syslJVM/run build-lib bindings/regex/lib -o /tmp/rx.syslib"
//     sbt "syslJVM/run run bindings/regex/match.sysl --lib /tmp/rx.syslib"

import rx.*

show(re: Regex, s: string) =
    re.find(s) match
        Some(m) -> print(f"${s}%-8s ${m.start}..${m.end}")
        None -> print(f"${s}%-8s no match")

compile("^a+b+$") match
    Ok(re) ->
        show(re, "aab")
        show(re, "abbbb")
        show(re, "ba")
        re.free()

    Err(why) -> print(why)

// A pattern that is not one, which is the path a binding has to have an answer for. The message
// comes from the C library itself, through `from_cstring`.
compile("a[") match
    Ok(re) ->
        print("a[ compiled, and should not have")
        re.free()

    Err(why) -> print(f"a[ is not a pattern: ${why}")
