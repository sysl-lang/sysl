module sysl.text

import sysl.alloc.{AllocError, try_box}
import sysl.buf.{Buf, ByteSink, buf, buf_with_capacity, try_buf, try_buf_with_capacity}
import sysl.raw.str_alias
import sysl.slices.copy
import sysl.{digits_long, digits_ulong}

/** Text gathered a piece at a time, handed back as one string.
 *
 * It is here rather than in the compiler because only its last line needs to be underneath the
 * language: everything above `finish` is ordinary sysl over the same `Buf[u8]` a `ByteSink` uses,
 * and what no sysl body can write is turning owned bytes into a `string`, which is
 * `from_utf8_unchecked` of bytes this builder has held all along.
 *
 * It exists so that joining does not rebuild what it already has. `a + b` allocates a fresh buffer
 * every time, so gathering n pieces that way costs the sum of every prefix; a builder pays for each
 * piece once and grows geometrically.
 */
struct StrBuilder
    /** Not reachable from outside the module: `finish` takes these bytes to be UTF-8, so a byte
     * written from outside could make an invalid `string`. Reading them is `as_bytes`.
     */
    private[text] bytes: &Buf[u8]

    /** The bytes gathered so far, read-only. */
    as_bytes -> []const u8 = self.bytes.view()

    len -> usize = self.bytes.len()

    is_empty -> bool = self.bytes.is_empty()

    const push(*self, s: string)
        self.bytes.extend(s.bytes)

    /** A character's bytes, through the library's one encoder rather than `string(c)` -- which would
     * allocate a whole string per character only to copy its bytes back out.
     */
    const push_char(*self, c: char)
        var tmp: [4]u8

        self.bytes.extend(tmp[0..<encode_utf8(c, tmp[0..<4])])

    /** The numbers, rendered straight into the buffer.
     *
     * **These exist so that gathering a number costs no allocation.** The spelling without them is
     * `push(n.to_string())`, which builds a whole reference-counted `string` -- a heap object with a
     * refcount and a deallocation hook -- and then copies its bytes out and drops it, for a value
     * whose text is never more than a couple of dozen bytes and is wanted only inside this buffer.
     * A stack array and `digits_long` is the same rendering with none of that, and it is what
     * `sysl.render`'s `display_int` already does for the sink path.
     *
     * **They take `long` and `ulong` rather than each width**, which is the same bargain the
     * `print*` family makes: one member per width is the alternative, and the widening a caller
     * writes is cheaper to read than nine declarations. This used to say "with no overloading",
     * which `reference/declarations.md § Overloading` has since made false -- the members are
     * *members*, and a type's are one namespace whatever a module's names may do. A narrower integer
     * of the same sign reaches them as it stands, every `int` being a `long`; one that is not -- a
     * `ulong` at `push_int` -- is refused rather than reinterpreted.
     */
    const push_int(*self, n: long)
        var tmp: [24]u8
        val at = digits_long(n, tmp[0..<24])
        self.bytes.extend(tmp[at..<24])

    const push_uint(*self, n: ulong)
        var tmp: [24]u8
        val at = digits_ulong(n, tmp[0..<24])
        self.bytes.extend(tmp[at..<24])

    /** The rendering `str` and `print` give a float, so that a float gathered into a builder reads
     * the same as theirs. Agreeing with them matters more here than picking another rendering:
     * a program that builds half a line with a builder and half with an interpolation should not
     * be able to tell which half a number came through.
     */
    const push_real(*self, x: real)
        var sink = ByteSink(self.bytes)

        display_real(x, &sink, FormatSpec(0, -1, false))

    /** Two immortal literals, so this allocates nothing either -- and it is here rather than left to
     * the caller so that the set of things a builder takes without a `str` is the set `str` itself
     * renders directly.
     */
    const push_bool(*self, b: bool)
        self.push(if b then "true" else "false")

    // -- the fallible twins (`sysl.alloc`): each answers `AllocError` where the buffer had to grow and
    // the heap refused it, and gathers nothing where it does --------------------------------------

    try_push(*self, s: string) -> Result[unit, AllocError] = self.bytes.try_extend(s.bytes)

    try_push_char(*self, c: char) -> Result[unit, AllocError]
        var tmp: [4]u8

        self.bytes.try_extend(tmp[0..<encode_utf8(c, tmp[0..<4])])

    try_push_int(*self, n: long) -> Result[unit, AllocError]
        var tmp: [24]u8
        val at = digits_long(n, tmp[0..<24])
        self.bytes.try_extend(tmp[at..<24])

    try_push_uint(*self, n: ulong) -> Result[unit, AllocError]
        var tmp: [24]u8
        val at = digits_ulong(n, tmp[0..<24])
        self.bytes.try_extend(tmp[at..<24])

    /** The rendering is written a run at a time, so a refusal part way through takes back the runs
     * that went in before it.
     */
    try_push_real(*self, x: real) -> Result[unit, AllocError]
        val had = self.bytes.len()
        var sink = TrySink(self.bytes, false)

        display_real(x, &sink, FormatSpec(0, -1, false))

        if !sink.refused then return Ok(())

        self.bytes.truncate(had)
        Err(AllocError.OutOfMemory)
    end try_push_real

    try_push_bool(*self, b: bool) -> Result[unit, AllocError] = self.try_push(if b then "true" else "false")

    /** `finish`, answering `AllocError` where the heap refused the string's storage. The bytes are
     * copied once into storage of their own and the string is laid over it, sharing its owner.
     */
    try_finish(self) -> Result[string, AllocError]
        var out: Buf[u8] = try_buf_with_capacity(self.bytes.len(), 0)?

        out.extend(self.bytes.view())
        Ok(str_alias(out.view()))

    const clear(*self)
        self.bytes.clear()

    /** Every byte that went in came from a `string` or from `push_char`, so what is held is
     * well-formed by construction and there is nothing left to validate.
     */
    const finish(self) -> string = from_utf8_unchecked(self.bytes.view())
end StrBuilder

const str_builder() -> StrBuilder = StrBuilder(buf())

/** A builder that already has room for `n` bytes, for a caller who knows roughly how long the text
 * will be -- a line being assembled from fields, a buffer sized from what it is copying. What it
 * saves is the reallocate-and-copy at each doubling on the way up to `n`.
 *
 * It is a guess and nothing depends on it: too small and the buffer grows the way it always does,
 * too large and the slack is freed with the rest when the builder goes.
 */
const str_builder_with_capacity(n: usize) -> StrBuilder = StrBuilder(buf_with_capacity(n, 0))

/** `str_builder()`, answering `AllocError` where the heap refused the buffer behind it. */
try_str_builder() -> Result[StrBuilder, AllocError] = Ok(StrBuilder(try_box(try_buf()?)?))

/** `str_builder_with_capacity(n)`, answering `AllocError` as `try_buf_with_capacity` does. */
try_str_builder_with_capacity(n: usize) -> Result[StrBuilder, AllocError] =
    Ok(StrBuilder(try_box(try_buf_with_capacity(n, u8(0))?)?))

/** The sink `try_push_real` renders through: `ByteSink`'s write over `try_extend`, latching the first
 * refusal. Once latched it writes nothing more, so what went in before the refusal is a prefix the
 * caller can take back.
 */
private struct TrySink
    bytes: &Buf[u8]
    refused: bool

impl Fallible for TrySink
    override failed(*self) -> bool = self.refused

impl Writer for TrySink
    write(*self, bytes: []const u8)
        if self.refused then return

        self.refused = self.bytes.try_extend(bytes).is_err()

/** A string copied into the NUL-terminated shape C reads, and the owner of that copy -- a language
 * with no manual free has to say who frees it, so the bytes belong to a value with a lifetime
 * rather than to whoever remembers.
 *
 * `len` is one less than the storage because the terminator is not part of the text, and `ptr` is
 * what an `extern` taking a `char *` is given.
 */
struct CString
    bytes: []u8

    ptr -> *u8 = &self.bytes[0]

    len -> usize = self.bytes.len - 1
end CString

cstring(s: string) -> CString
    var b: []u8 = [0; s.len + 1]   // one byte longer than the text, and the fill is the terminator

    copy(b, s.bytes)

    CString(b)

/** `cstring(s)`, answering `AllocError` where the heap refused the copy -- `CapacityOverflow` where
 * the text and its terminator do not fit in a `usize`.
 */
try_cstring(s: string) -> Result[CString, AllocError]
    val n = s.len.checked_add(1).ok_or(AllocError.CapacityOverflow)?

    var b: Buf[u8] = try_buf_with_capacity(n, 0)?

    b.extend(s.bytes)
    b.push(0)
    Ok(CString(b.into_view()))
end try_cstring
