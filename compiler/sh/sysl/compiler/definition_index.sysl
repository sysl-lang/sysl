module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.container.{Set, set}

// Where the things a program names were declared -- go-to-definition, as data, and what an editor
// asks of a compiler beside anything a build does.
//
// **Every reference is recorded where the name is RESOLVED**, because that is the one moment both
// halves are in hand and unambiguous: the place the name is written, and the declaration the
// analyzer decided it means. After resolution a typed node carries a unique name for a local --
// unique within one function and no further -- and a key for everything else, which is not enough to
// find the binding again. So a local is noted where `name_expr` finds it in scope (its binding
// carries where it was bound, `Local.declared`), a call where `function_call` settles which
// declaration answers it, a nested function's call where the group names it, an address where
// `function_address` settles the overload, and module storage where `name_expr` reaches it.
//
// **It costs nothing when nobody asked.** `Analysis.index` is `None` for every build, and every
// recording site is one test of it; only `indexed_file` gives an analysis an index to fill.
//
// **What is covered is the reference compiler's `DefinitionIndex`**: locals and parameters, module
// `val`s and `var`s, `extern` variables, and calls -- a call to a generic reaching the generic rather
// than the instantiation it was compiled as. A type name, a struct field and a trait member are not
// covered, there as here.

// One name, written somewhere, standing for something declared somewhere else.
//
// `name` is what the declaration calls itself, which is not always how the reference spelled it: a
// name reached through an import is named with its module, as the declaration's own module calls it.
//
// **The spans are kept beside the positions**, because an editor counts columns in neither bytes nor
// characters but UTF-16 code units, and only the bytes can be counted again in any unit asked for.
// `detail` is what the analyzer knew about the thing at the moment it resolved the name -- a local's
// type, a function's signature -- which is what hover shows; empty where nothing was recorded.
struct Reference
    at_file: string
    at: Loc
    declared_file: string
    declared_at: Loc
    name: string
    at_span: Span
    declared_span: Span
    detail: string
end Reference

// The references one analysis made, in the order resolution reached them and each kept once.
//
// **A body is read more than once** -- a generic at its definition and again per instantiation, an
// overloaded call once per candidate -- so one name written once arrives here several times over,
// identically. Distinctness is about the walk rather than the program, which is why it is a set of
// what a reference says rather than of where it was written.
struct DefinitionIndex
    references: Buf[Reference]
    seen: Set[string]

    // Records one reference, unless it is already recorded.
    note(*self, src: Source, at: Span, home: Source, declared: Span, name: string, detail: string = "")
        val here = src.locate(at.start)
        val there = home.locate(declared.start)
        val key = s"${src.name}:${here.line}:${here.col}>${home.name}:${there.line}:${there.col}:$name"

        if self.seen.add(key) then
            self.references.push(Reference(src.name, here, home.name, there, name, at, declared, detail))
    end note
end DefinitionIndex

// An index with nothing in it, for an analysis an editor is asking.
definition_index() -> &DefinitionIndex = DefinitionIndex(buf(), set())

// What an editor asks for: the references the walk recorded, and every diagnostic it recorded on the
// way. **The two are not alternatives** -- a file being typed into is a file with a mistake in it, and
// that is exactly when it is asked where a name came from. This analysis does not escape at its first
// error, so a walk that recorded a mistake still has the whole index.
struct Indexing
    references: Buf[Reference]
    problems: Buf[Placed]

    // That the file is clean -- an index and nothing to report.
    is_clean(self) -> bool
        for problem in self.problems
            if problem.is_error() then return false

        true
    end is_clean
end Indexing

// What an editor's check asks of the analysis beyond the index: an answer before the whole of it,
// and a way to be told to stop.
//
// **The check comes in two tiers.** The first is what the program's own text says -- the parse, the
// declarations, every body the package wrote -- and `first_tier` is told its diagnostics as soon as
// it is done. The second is everything the whole program decides -- the instantiations, the library
// bodies reached, module storage evaluated, the whole-program checks such as `check_keeps` -- and its
// diagnostics are the analysis's own at the end, exactly what a build says.
//
// **`superseded` is asked at every step's boundary**, and once it answers true the analysis stops
// where it is and `abandoned` says so: the text it was reading has changed, so nothing it would go on
// to find is about the text the editor now holds.
//
// **`first_tier_only` ends the analysis once its first tier is told** -- the check of a package's own
// code without its `@tests` files, which a second analysis with them follows (`indexed_file`).
//
// **`retype_only` names the files whose bodies a first tier types** (`retype_kept.sysl`); every other
// file's are left to the diagnostics last told for it. It is set only with `first_tier_only`.
struct EditorCheck
    first_tier: &Fn(Buf[Placed]) -> unit
    superseded: &Fn() -> bool
    abandoned: bool
    first_tier_only: bool
    retype_only: Option[Set[string]]
end EditorCheck

editor_check(first_tier: &Fn(Buf[Placed]) -> unit, superseded: &Fn() -> bool,
             first_tier_only: bool = false, retype_only: Option[Set[string]] = None) -> &EditorCheck =
    EditorCheck(first_tier, superseded, false, first_tier_only, retype_only)

// Whether the editor's check this analysis is has been told to stop -- asked of the text the editor
// holds now, once per boundary, and remembered. A build is never told to.
editor_gave_up(a: &Analysis) -> bool = a.editor match
    None -> false
    Some(e) ->
        if !e.abandoned && e.superseded() then e.abandoned = true
        e.abandoned

// A reference from a name written at `at` in the file `cx` is reading, where the analysis is
// recording any.
note_reference(cx: &Analyzer, at: Span, home: Source, declared: Span, name: string, detail: string = "")
    cx.an.index match
        Some(ix) -> ix.note(cx.scope.src, at, home, declared, name, detail)
        None -> ()

// Where a binding's name is written, when it starts at `at` in the file being read -- bare, or
// quoted in backticks -- for the index to record as the binding's place (`Local.declared`). Nothing
// when no index is being filled, or when what is written there is not the name.
written_name(cx: &Analyzer, at: usize, name: string) -> Option[Span]
    if cx.an.index.is_none() then return None

    val b = cx.scope.src.bytes
    val start = if at < b.len && b[at] == u8('`') then at + 1 else at
    val n = name.bytes.len

    if n == 0 || start + n > b.len then return None

    for i in 0..<n
        if b[start + i] != name.bytes[i] then return None

    if start + n < b.len && lsp_word_byte(b[start + n]) then return None

    Some(Span(start, start + n))
end written_name

// The name a binding statement writes after its keyword (`val`, `var`, `ref`, `for`), the statement
// starting at `at`: the keyword, the blanks after it, then the name. Nothing where the statement
// starts with something else -- an attribute, a label -- and the binding's place stays the statement.
name_after_keyword(cx: &Analyzer, at: usize, name: string) -> Option[Span]
    if cx.an.index.is_none() then return None

    val b = cx.scope.src.bytes
    var i = at

    while i < b.len && b[i] >= u8('a') && b[i] <= u8('z')
        i += 1

    if i == at then return None

    while i < b.len && (b[i] == u8(' ') || b[i] == u8('\t'))
        i += 1

    written_name(cx, i, name)
end name_after_keyword

// A reference to a local, whose binding is in the file being read.
note_local_reference(cx: &Analyzer, at: Span, local: Local)
    if cx.an.index.is_none() then return

    local.declared match
        Some(where) ->
            note_reference(cx, at, cx.scope.src, where, local.name, s"${local.name}: ${type_show(local.ty)}")
        None -> ()
end note_local_reference

// A reference to a function the tables hold under `key`, named as its own module calls it.
note_func_reference(cx: &Analyzer, at: Span, key: string)
    if cx.an.index.is_none() then return

    val f = cx.an.tables.funcs.get(key)

    if f.is_none() then return

    val home = f.unwrap().scope
    val d = f.unwrap().decl

    // A result read off the body is shown at the type it was read as, as an inferred `val` is, and
    // as `sysl doc` shows it: no arrow for `unit`.
    val clause = if is_inferred_result(d.ret_type) then settled_result_of(cx.an, key).and_then(doc_result_of)
    else None
    val shown = clause match
        Some(c) -> s"${doc_func(d with { ret_type = None })}$c"
        None -> doc_func(d)

    note_reference(cx, at, home.src, f.unwrap().span, declared_name(home, d.name), shown)
end note_func_reference

// A reference to a member -- a method called, a property read -- filed under `fname`, the function
// it lowers to. Shown as `sysl doc` shows the member, with a result read off its body at that result.
note_member_reference(cx: &Analyzer, at: Span, fname: string, m: MethodDecl)
    if cx.an.index.is_none() then return

    val home = cx.an.tables.members.decl_scope.get(fname)
    val declared = cx.an.tables.members.decl_spans.get(fname)

    if home.is_none() || declared.is_none() then return

    val clause = if is_inferred_result(m.ret_type) then settled_result_of(cx.an, fname).and_then(doc_result_of)
    else None
    val shown = clause match
        Some(c) -> s"${doc_method(m with { ret_type = None })}$c"
        None -> doc_method(m)

    note_reference(cx, at, home.unwrap().src, declared.unwrap(), m.name, shown)
end note_member_reference

// A reference to module storage -- a `val`, a module `var` or an `extern` variable -- shown at the
// type it is stored at, which for a `val` written with none is its initializer's.
note_storage_reference(cx: &Analyzer, at: Span, d: ValueDecl, stored: Type)
    if cx.an.index.is_none() then return

    note_reference(cx, at, d.scope.src, d.span, declared_name(d.scope, d.name),
                   s"${d.name}: ${type_show(stored)}")
end note_storage_reference

// What a declaration calls itself: its name, qualified by its module where it has one.
private declared_name(home: Scope, name: string) -> string =
    if home.module_name == "" then name else s"${home.module_name}.$name"

// One file analyzed the way an editor asks for it: the compilation `emit-typed` reads, with an index
// to fill. The reference's `Analyzer.indexed`.
//
// An editor's check hands `editor` (`EditorCheck`); where it was told to stop, what comes back is
// whatever had been found by then, and `editor.abandoned` says it is not the whole.
//
// **An editor's first tier is the program's own code, without its `@tests` files** -- in the compiler's
// own tree four lines in five are tests, and none of them can change what the program's code means,
// since nothing outside a test file may name what one declares. So where the package has test files,
// a first analysis without them (but with `editing`, the document being typed into, if it is one, so
// its own mistakes come first) tells the first tier and stops; the whole compilation, tests and all,
// is then analyzed for the second, and what that says is the check's answer, exactly a build's.
indexed_file(path: string, editor: Option[&EditorCheck] = None, editing: string = "") -> Result[Indexing, Failure]
    val t = target_for(path, None)?
    val program = packaged_compilation_of(path, t)?
    val ix = definition_index()

    if editor.is_none()
        val done = analyze_produced(program.units, program.target, buf(), true, Some(ix))

        return Ok(Indexing(ix.references, done.reported))
    end if

    val e = editor.unwrap()
    val own = without_test_files(program.units, editing)

    // **Where an earlier check told a first tier, only what an edit can have changed is typed**
    // (`retype_kept.sysl`): the plan names those files, and the rest are told what was told for
    // them last time. What the first tier tells, whichever way it was made, is kept for the next.
    val plan = retype_plan(s"${absolute_path(path)}\u{1}${program.target.name}", own)
    val caught: &FirstTold = FirstTold(false, buf())
    val tell: &Fn(Buf[Placed]) -> unit = ds ->
        val merged = retype_merged(ds)

        caught.told = true
        caught.said = merged
        e.first_tier(merged)

    note_evaluations(true)

    if own.len() < program.units.len() || plan.is_some()
        val first = editor_check(tell, e.superseded, true, plan)

        analyze_produced(own, program.target, buf(), true, None, editor = Some(first))
        note_evaluations(false)

        if first.abandoned
            e.abandoned = true
            return Ok(Indexing(buf(), buf()))
        end if

        if caught.told then retype_commit(caught.said)

        val rest = editor_check(_ -> (), e.superseded)
        val done = analyze_produced(program.units, program.target, buf(), true, Some(ix), editor = Some(rest))

        if rest.abandoned then e.abandoned = true

        return Ok(Indexing(ix.references, done.reported))
    end if

    val whole = editor_check(tell, e.superseded)
    val done = analyze_produced(program.units, program.target, buf(), true, Some(ix), editor = Some(whole))

    note_evaluations(false)

    if caught.told then retype_commit(caught.said)

    if whole.abandoned then e.abandoned = true

    Ok(Indexing(ix.references, done.reported))
end indexed_file

// What an editor's first tier told, caught on its way to the editor so it can be kept.
private struct FirstTold
    told: bool
    said: Buf[Placed]
end FirstTold

// A compilation's files without its `@tests` files, except `editing`'s.
private without_test_files(units: Buf[Program], editing: string) -> Buf[Program]
    val kept_file = if editing == "" then "" else absolute_path(editing)
    var out: Buf[Program] = buf()

    for unit in units
        if !unit.test_only then out.push(unit)
        else if kept_file != "" && absolute_path(unit.src.name) == kept_file then out.push(unit)

    out
end without_test_files

// The same for a file of the standard library: the compilation `--std` reads, which is the library's
// tree alone, analyzed with no entry point to look for. Every file is one the compilation produces
// rather than one the standard module supplies, so every body is read and every mistake reported, as
// in `std_test_build_of`.
indexed_std(root: string, editor: Option[&EditorCheck] = None) -> Result[Indexing, Failure]
    val t = target_for(root, None)?
    val program = std_compilation_of(root, t)?
    val ix = definition_index()
    val done = analyze_produced(program.units, program.target, file_names(program.units), false, Some(ix),
                                editor = editor)

    Ok(Indexing(ix.references, done.reported))
end indexed_std
