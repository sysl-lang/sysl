module sh.sysl.compiler

import sysl.text.{str_builder, Search}

// `dso_local` on every symbol of a module built for a bare machine.
//
// **A bare ELF image is linked statically and loaded where it was linked to run, so no symbol it
// names can come from anywhere else** -- and clang says so, marking every declaration and every
// non-local definition `dso_local` for `aarch64-none-elf`, `thumbv*-none-eabi*`, `riscv*-unknown-elf`
// and `x86_64-unknown-none-elf`. Without the mark LLVM assumes an ELF symbol may be preempted and
// reaches it through the GOT, so `&` of an `extern` comes out as the address the image was LINKED at
// while `&` of the module's own storage, reached PC-relative, comes out as the address it is RUNNING
// at -- and code running before the MMU is on, or before a loader would have relocated it, gets two
// kinds of answer from one operator. Marked, every reference is direct: `adrp`/`add` against
// `R_AARCH64_ADR_PREL_PG_HI21`, never `ADR_GOT_PAGE`.
//
// It is applied to the text clang is handed (`toolchain.sysl`'s `for_clang`), which is also what
// `emit-llvm` prints, so the emitted module itself -- what the oracle comparisons read -- is
// untouched. **A hosted machine is left exactly as it is**: there a symbol may come from a shared
// library, and marking it local would be a promise the dynamic loader breaks.

// The text for `t`, every symbol marked where `t` binds them all inside one image.
bound_locally(ir: string, t: Target) -> string
    if !t.symbols_bind_locally() then return ir

    var b = str_builder()
    var start: usize = 0

    for i in 0..<ir.bytes.len
        if ir.bytes[i] == u8('\n')
            b.push(dso_local_line(ir[start..<i]))
            b.push_char('\n')
            start = i + 1

    if start < ir.bytes.len then b.push(dso_local_line(ir[start..<ir.bytes.len]))

    b.finish()
end bound_locally

// One line of a module with `dso_local` added where it says something: a `declare`, a `define` and a
// global's `@name = …` line, each at the top level. A private or internal symbol is local already, an
// intrinsic is no symbol, and `appending` is the `llvm.` lists'.
dso_local_line(line: string) -> string
    if line.starts_with("declare ") then return marked_after(line, 8)
    if line.starts_with("define ") then return marked_after(line, 7)
    if !line.starts_with("@") || line.starts_with("@llvm.") || line.starts_with("@\"llvm.")
        return line

    global_head(line) match
        Some(at) -> marked_after(line, at)
        None -> line
end dso_local_line

// Where the word after ` = ` begins on a global's line, or nothing where there is none.
private global_head(line: string) -> Option[usize]
    for i in 1..<line.bytes.len
        if bytes_at(line, i, " = ") then return Some(i + 3)

    None
end global_head

// `line` with `dso_local ` put after the linkage word that may begin at `at` -- unless the linkage
// is one that is local already, or the line says where the symbol binds itself.
private marked_after(line: string, from: usize) -> string
    var at = from
    val first = word_at(line, at)

    if first == "private" || first == "internal" || first == "appending" then return line
    if is_linkage_word(first) then at = at + first.bytes.len + 1

    val next = word_at(line, at)

    if next == "dso_local" || next == "dso_preemptable" then return line
    if names_intrinsic(line, at) then return line

    line[0..<at] + "dso_local " + line[at..<line.bytes.len]
end marked_after

// The linkages a symbol the linker sees may carry, any of which `dso_local` follows.
private is_linkage_word(w: string) -> bool =
    w == "external" || w == "extern_weak" || w == "weak" || w == "weak_odr" || w == "linkonce" ||
    w == "linkonce_odr" || w == "common" || w == "available_externally"

// The run of non-space bytes starting at `at`.
private word_at(line: string, at: usize) -> string
    var end_at = at

    while end_at < line.bytes.len && line.bytes[end_at] != u8(' ')
        end_at += 1

    line[at..<end_at]
end word_at

// Whether the first symbol after `at` on a `declare`/`define` line is an `llvm.` intrinsic, which is
// no symbol at all and takes no preemption specifier.
private names_intrinsic(line: string, at: usize) -> bool
    for i in at..<line.bytes.len
        if line.bytes[i] == u8('@')
            return bytes_at(line, i + 1, "llvm.") || bytes_at(line, i + 1, "\"llvm.")

    false
end names_intrinsic
