module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.env.{get as env_var}
import sysl.fs.{append_text, make_dir_all, make_temp_dir, metadata, read_text, remove_dir_all, walk, write_text}
import sysl.process.capture
import sysl.text.{replace_all, split, str_builder, Search}

// The site's executable documentation, run against this compiler.
//
// **A page on sysl.sh is not a picture of a program, it is the program**, and the reference's
// `DocsTests` proves that by compiling every `sysl` block the site shows: one followed by an
// `output` block is run and its stdout compared (an `output trap` block also requires the run to end
// on a trap, and a plain one that it does not), one followed by an `error` block is required to
// fail with the diagnostic the page quotes, and one followed by neither is a fragment nobody
// compiles. That is 1,220 executable blocks over 73 pages, and section 7 owes every one of them.
//
// **What this sweep is for is the half of the claim the differential sweeps cannot make.** They
// agree with the reference on the pages' *trees*, which says the two parsers read the same program;
// it does not say the program prints what the page says it prints, nor that a refusal this compiler
// makes is the refusal the page quotes. Only running it says that.
//
// **The classification is `DocsSupport`'s, condition for condition** -- how a fence is read, which
// claim attaches to which block, what `target=` and `build=c` change, and that a diagnostic has only
// to *contain* the words the page quotes. A sweep that classified differently would be measuring a
// different population and its number would mean nothing beside the reference's.
//
// It compiles and links about nine hundred programs, so it is gated: with `SYSL_DOCS` unset it
// returns at once, which is what keeps `sysl test .` the length it is.

// -- what a page says about a block ----------------------------------------------------------------

// What a page claims about one of its `sysl` blocks, which is decided by what follows it.
enum DocsClaim
    PagePrints
    PageRefuses
    PageShows

// A fenced block as the markdown holds it: the word after the backticks, whatever else was on that
// line, and the body.
struct DocsFence
    lang: string
    info: string
    body: string

// One `sysl` block, with where it came from -- a complaint has to name the page and the position on
// it, a reader of the complaint having only the page to go and fix.
//
// `target` is the machine the block is *about*, from a `target=` on the fence, and is empty for the
// ordinary case of a block about the language rather than about a processor. `archive` is `build=c`,
// and says the block is about the artifact a C project links rather than about a program.
//
// `traps` is an `output trap` block underneath: the program prints `expected` and then stops on a
// trap, which is the claim the page makes about it -- a run that comes back is as wrong as one that
// prints something else.
struct DocsBlock
    page: string
    nth: int
    source: string
    claim: DocsClaim
    expected: string
    target: string
    archive: bool
    traps: bool
end DocsBlock

// What one page, one section or the whole site came to.
struct DocsTally
    run_ok: int
    run_bad: int
    ref_ok: int
    ref_bad: int
    shown: int

    // Blocks carrying a `target=` or a `build=c`, which are honoured rather than skipped. It is
    // counted so that a reader can see the number is not zero by accident.
    attributed: int
end DocsTally

// What a shell reports for a program stopped by `SIGTRAP`: 128 + 5 (`shell_status`).
private val DocsTrapStatus: int = 133

private docs_add(a: DocsTally, b: DocsTally) -> DocsTally =
    DocsTally(a.run_ok + b.run_ok, a.run_bad + b.run_bad, a.ref_ok + b.ref_ok, a.ref_bad + b.ref_bad,
              a.shown + b.shown, a.attributed + b.attributed)

// -- reading a page --------------------------------------------------------------------------------

private docs_is_space(b: u8) -> bool = b == u8(' ') || b == u8('\t')

private docs_word_end(s: string) -> usize
    var i: usize = 0

    while i < s.len && !docs_is_space(s.bytes[i])
        i += 1

    i
end docs_word_end

// The value a fence's info string gives one key, or the empty string where it names none.
//
// **Anything that is not a `key=value` pair is ignored**, because the info string is also where a
// highlighter's own words go.
private docs_option(info: string, key: string) -> string
    val head = key + "="

    for word in split(info, " ")
        for part in split(word, "\t")
            if part.starts_with(head) then return part[head.len..]

    ""
end docs_option

// The fenced blocks of a page, in order.
//
// **Only a fence at the left margin opens one.** An indented fence is inside a list item or a block
// quote, where the prose around it owns the program rather than offering it to be run.
private docs_fences(text: string) -> Buf[DocsFence]
    var out: Buf[DocsFence] = buf()
    var held = str_builder()
    var open = false
    var lang = ""
    var info = ""

    for line in split(text, "\n")
        if line.starts_with("```")
            if open
                out.push(DocsFence(lang, info, held.finish()))

                held = str_builder()
                open = false
            else
                val head = line[3..].trim()
                val cut = docs_word_end(head)

                lang = head[0..<cut]
                info = head[cut..].trim()
                open = true
        else if open
            held.push(line)
            held.push_char('\n')

    out
end docs_fences

// What the fences after a `sysl` block say about it: the first `output` or `error` block to appear
// before the next `sysl` block.
//
// Not simply the very next fence, because a page reads *program, how to run it, what it prints* --
// with a `bash` block in the middle. What the rule does refuse is an `output` block belonging to a
// *later* program: the search stops at the next `sysl` block, so a claim can never attach to the
// wrong one.
//
// The third answer is whether the `output` block is written ```` ```output trap ````: the word
// `trap` on its fence says the program traps once it has printed what the block holds.
private docs_claim_after(fences: Buf[DocsFence], from: usize) -> (DocsClaim, string, bool)
    var i = from

    while i < fences.len()
        val f = fences.at(i)

        if f.lang == "sysl" then break
        if f.lang == "output" then return (DocsClaim.PagePrints, f.body, docs_has_word(f.info, "trap"))
        if f.lang == "error" then return (DocsClaim.PageRefuses, f.body, false)

        i += 1

    (DocsClaim.PageShows, "", false)
end docs_claim_after

// Whether `word` stands on its own among a fence's words.
private docs_has_word(info: string, word: string) -> bool
    for each in split(info, " ")
        for part in split(each, "\t")
            if part == word then return true

    false
end docs_has_word

// Every `sysl` block of one page, each paired with what the page claims about it.
//
// **The number a complaint quotes counts the `sysl` fences alone**, not every fence, because that is
// the number a reader counts scrolling down the page.
private docs_blocks(page: string, text: string) -> Buf[DocsBlock]
    val fences = docs_fences(text)
    var out: Buf[DocsBlock] = buf()
    var nth = 0

    for i in 0..<fences.len()
        val f = fences.at(i)

        if f.lang == "sysl"
            nth += 1

            val said = docs_claim_after(fences, i + 1)

            out.push(DocsBlock(page, nth, f.body, said.0, said.1, docs_option(f.info, "target"),
                               docs_option(f.info, "build") == "c", said.2))

    out
end docs_blocks

// Trailing whitespace is not a claim a page is making: a markdown fence keeps a final newline the
// author did not type and cannot see, so comparing raw text would fail every block for a reason no
// reader could act on.
private docs_normalize(text: string) -> string
    var b = str_builder()
    var first = true

    for line in split(text, "\n")
        if !first then b.push("\n")

        b.push(line.trim_end())
        first = false

    b.finish().trim()
end docs_normalize

private docs_indent(text: string) -> string
    var b = str_builder()

    for line in split(text, "\n")
        b.push("    ")
        b.push(line)
        b.push_char('\n')

    b.finish()
end docs_indent

// -- compiling one block -----------------------------------------------------------------------------

// The compilation a refusal is about: an ordinary program lowered as far as LLVM, or the artifact a
// C project links.
//
// **`build=c` is a different axis from `target=`.** One says which machine, the other which
// artifact, and a refusal about module storage belongs to the archive and to no other build --
// compiled as a program it never happens, whatever the machine.
private docs_compile(src: string, b: DocsBlock, archive_at: string) -> Result[unit, string]
    val named: Option[string] = if b.target == "" then None else Some(b.target)

    if b.archive
        build_c_archive(src, named, None, DefaultOptimization, Some(archive_at), None, (m) -> ()) match
            Err(why) -> return Err(failure_text(why))
            Ok(_) -> return Ok(())
    end if

    // A block that writes a test or a hook is about what `sysl test` says of it -- the one build that
    // keeps them -- so it is read with them kept.
    val tests = b.source.contains("@test") || b.source.contains("@setup") || b.source.contains("@teardown")

    emit_llvm_text(src, named, DefaultOptimization, buf(), None, false, tests) match
        Err(why) -> Err(why.message)
        Ok(made) ->
            if !made.report.is_empty() then return Err(analysis_report(made.report))

            Ok(())
end docs_compile

// A block the page says prints: built, linked, run, and its standard output held against the
// `output` block underneath it.
//
// **How it ended is half the claim.** An `output` block says the program comes back, and an
// `output trap` block says it stops on a trap (`SIGTRAP`, which a shell reports as 133) once it has
// printed what the block holds -- so a trap under a plain `output` block fails, and so does a program
// that comes back, or dies of anything else, under an `output trap` one. The trap's own message goes
// to standard error, which is not compared.
//
// **A page's block is what `sysl run` makes of it**, so it is built in `run`'s mode -- debug, where a
// plain integer overflow stops the program -- and not in the release mode a test process's own builds
// default to.
private docs_prints(src: string, exe: string, b: DocsBlock, where: string) -> Option[string]
    use_command_mode("run")

    val built = build_native_program(src, None, None, DefaultOptimization, Some(exe))

    use_command_mode("")

    built match
        Err(why) ->
            return Some(s"$where: expected it to run, but it did not compile:\n${failure_text(why)}")
        Ok(_) -> ()

    capture(exe, [], "", [], true) match
        Err(_) -> return Some(s"$where: expected it to run, and the program could not be started")
        Ok(said) ->
            val ended = shell_status(said.status)

            if b.traps && ended != DocsTrapStatus
                return Some(s"$where: the page says this traps, but it exited with $ended")

            if !b.traps && ended == DocsTrapStatus
                return Some(s"$where: expected it to run, but it trapped (exit status $ended) — a block " +
                            "that traps says so with 'output trap'")

            if !b.traps && !said.status.ok()
                return Some(s"$where: expected it to run, but it exited with $ended")

            val printed = docs_paged(said.text, src)

            if docs_normalize(printed) != docs_normalize(b.expected)
                return Some(s"$where: what it printed is not what the page says.\npage:\n" +
                            docs_indent(b.expected) + "program:\n" + docs_indent(printed))

    None
end docs_prints

// **A block on a page has no file name, so where a program prints its own path the page writes
// `<page>`** (`library/harness.md`'s test reports), and the path the block was built from is put
// back to that before comparing. Both spellings are replaced: a `TMPDIR` ending in `/` makes the
// temporary directory `.../T//sysl-docs…`, and a program may print the path either way.
private docs_paged(text: string, src: string) -> string
    var single = src

    while single.contains("//")
        single = replace_all(single, "//", "/")

    replace_all(replace_all(text, src, "<page>"), single, "<page>")
end docs_paged

@test("a program's own path in what a page's block printed reads as <page>, whichever way the slashes came")
docs_paged_names_the_page()
    val src = "/var/folders/x/T//sysl-docsAb12/main.sysl"

    assert_eq(docs_paged(s"$src:9:adds:PASS\n", src), "<page>:9:adds:PASS\n")
    assert_eq(docs_paged("/var/folders/x/T/sysl-docsAb12/main.sysl:4:x:FAIL\n", src), "<page>:4:x:FAIL\n")
    assert_eq(docs_paged("main.sysl:4\n", src), "main.sysl:4\n")

// -- a block that traps ----------------------------------------------------------------------------

// A page holding one program and the fence under it, read the way the sweep reads a page.
private rgp_block(program: string, under: string) -> DocsBlock =
    docs_blocks("p.md", "```sysl\n" + program + "```\n\n" + under).at(0)

// That block checked the way the sweep checks it, in a directory of its own.
private rgp_checked(program: string, under: string) -> Option[string]
    val dir = make_temp_dir("sysl-rgp").unwrap()
    val src = s"$dir/main.sysl"

    write_text(src, program).unwrap()

    val said = docs_check(src, s"$dir/program", s"$dir/program.a", rgp_block(program, under))

    remove_dir_all(dir).unwrap_or(())
    said
end rgp_checked

private rgp_ready() -> bool = std_root().is_ok() && clang_available()

// Three lines, then an index one past the end.
private rgp_trapper() -> string =
    "main()\n    val xs = [1, 2, 3]\n    var i = 0\n\n    loop\n        print(xs[i])\n        i += 1\n"

private rgp_three() -> string = "1\n2\n3\n"

@test("an 'output trap' fence marks its block as trapping, and only the word 'trap' does")
rgp_the_fence_word_is_read()
    val program = "main()\n    print(\"hi\")\n"

    assert(rgp_block(program, "```output trap\nhi\n```\n").traps, "output trap")
    assert(rgp_block(program, "```output\ttrap\nhi\n```\n").traps, "a tab separates words too")
    assert(!rgp_block(program, "```output\nhi\n```\n").traps, "plain output")
    assert(!rgp_block(program, "```output trapped\nhi\n```\n").traps, "a longer word is not the word")
    assert_eq(rgp_block(program, "```output trap\nhi\n```\n").claim, DocsClaim.PagePrints)
    assert_eq(rgp_block(program, "```output trap\nhi\n```\n").expected, "hi\n")

@test("a block under 'output trap' that prints what the page says and then traps passes")
rgp_a_trap_that_prints_the_page_passes()
    if !rgp_ready() then return

    val said = rgp_checked(rgp_trapper(), "```output trap\n" + rgp_three() + "```\n")

    assert(said.is_none(), said.unwrap_or(""))

@test("a block under 'output trap' that traps after printing something else fails, showing both")
rgp_a_trap_that_prints_otherwise_fails()
    if !rgp_ready() then return

    val said = rgp_checked(rgp_trapper(), "```output trap\n1\n9\n```\n").unwrap_or("")

    assert(said.contains("p.md, sysl block 1: what it printed is not what the page says"), said)
    assert(said.contains("9"), said)
    assert(said.contains("3"), said)

@test("a block under 'output trap' that comes back fails, naming its exit status")
rgp_a_marked_block_that_returns_fails()
    if !rgp_ready() then return

    val said = rgp_checked("main()\n    print(\"hi\")\n", "```output trap\nhi\n```\n").unwrap_or("")

    assert_eq(said, "p.md, sysl block 1: the page says this traps, but it exited with 0")

@test("a block under 'output trap' that panics instead fails: a panic is status 1, not a trap")
rgp_a_marked_block_that_panics_fails()
    if !rgp_ready() then return

    val said = rgp_checked("main()\n    print(\"hi\")\n    assert(false, \"no\")\n", "```output trap\nhi\n```\n")
        .unwrap_or("")

    assert_eq(said, "p.md, sysl block 1: the page says this traps, but it exited with 1")

@test("a block under a plain 'output' that traps fails, and says how to mark one that should")
rgp_an_unmarked_trap_fails()
    if !rgp_ready() then return

    val said = rgp_checked(rgp_trapper(), "```output\n" + rgp_three() + "```\n").unwrap_or("")

    assert_eq(said, "p.md, sysl block 1: expected it to run, but it trapped (exit status 133) — a block " +
                    "that traps says so with 'output trap'")

// A block the page says is refused: compiled, required to fail, and the diagnostic required to
// **contain** what the page quotes.
//
// The match is a substring because that is the reference's, and 327 of the site's `error` blocks
// quote a single clause of a message rather than the whole of one.
private docs_refuses(src: string, archive_at: string, b: DocsBlock, where: string) -> Option[string]
    if b.target != "" && target_named(b.target).is_none()
        return Some(s"$where: '${b.target}' is no machine this compiler has an entry for")

    docs_compile(src, b, archive_at) match
        Ok(_) -> Some(s"$where: the page says the compiler refuses this, and it compiled.\npage:\n" +
                      docs_indent(b.expected))
        Err(said) ->
            if said.contains(b.expected.trim()) then return None

            Some(s"$where: the compiler refused it, but not in the words the page quotes.\npage:\n" +
                 docs_indent(b.expected) + "compiler:\n" + docs_indent(said))
end docs_refuses

// One block checked, answering the complaint it has or nothing.
//
// **Every block answers rather than stopping the sweep**, so one run reports every page that has
// drifted instead of the first: documentation breaks in groups, one language fact invalidating the
// six pages that lean on it.
private docs_check(src: string, exe: string, archive_at: string, b: DocsBlock) -> Option[string]
    val where = s"${b.page}, sysl block ${b.nth}"

    if b.archive && b.claim == DocsClaim.PagePrints
        return Some(s"$where: a 'build=c' block cannot have an 'output' under it — there is no C " +
                    "project here to link it")

    // **A `build=c` block with no claim is compiled, where an ordinary fragment is not**, and that is
    // the point of allowing one: what a page says about an archive is usually that some shape works
    // there, and an archive does not run, so no `output` block is available to say so.
    if b.archive && b.claim == DocsClaim.PageShows
        docs_compile(src, b, archive_at) match
            Ok(_) -> return None
            Err(why) ->
                return Some(s"$where: the page shows this as an archive that builds, and it did " +
                            s"not:\n$why")

    // A `target=` says the block is about another machine, and the only honest thing to do with one
    // is compile it -- running it would need that machine.
    if b.target != "" && b.claim != DocsClaim.PageRefuses
        return Some(s"$where: 'target=' belongs on a block with an 'error' under it, which is " +
                    "compiled and not run")

    if b.claim == DocsClaim.PageShows then return None
    if b.claim == DocsClaim.PagePrints then return docs_prints(src, exe, b, where)

    docs_refuses(src, archive_at, b, where)
end docs_check

// A block that opens with a `module` header, written where its header says it sits: the reference
// compiles a block as a source with no place at all, and a file named on its own here sits at the
// project root, where a header is refused. So such a block becomes a tree, `<dir>/tree/<m/n>/main.sysl`,
// and the tree is what is compiled. Nothing where the block declares no module.
private docs_placed(dir: string, source: string) -> Option[string]
    val lines = split(source, "\n")

    for i in 0..<lines.len
        val line = lines[i].trim()

        if line == "" || line.starts_with("//") then continue

        if !line.starts_with("module ") then return None

        val parts = split(line["module ".bytes.len..<line.bytes.len].trim(), ".")
        var at = s"$dir/tree"

        for k in 0..<parts.len
            at = s"$at/${parts[k]}"

        make_dir_all(at).unwrap()
        write_text(s"$at/main.sysl", source).unwrap()
        return Some(s"$dir/tree")

    None
end docs_placed

// -- the sweep -------------------------------------------------------------------------------------

// Where the pages are: this repository's own `docs/content/`, which the compiler and its pages share
// a commit in. `SYSL_SITE` names a `sysl.sh` checkout instead, read where that repository keeps its
// pages — the same `docs/content` layout — which is what compares a site branch against this compiler.
private docs_root() -> string
    val named = env_var("SYSL_SITE")
    val root = if named.is_none() then "../docs/content"
    else named.unwrap() + "/docs/content"

    if metadata(root).is_ok() then root else ""
end docs_root

// The pages somebody wrote, which is every page except the generated API section.
//
// **`content/api/` is excluded by path**, as the reference excludes it: those pages are generated
// from the library's doc comments and are full of signature fragments a compiler correctly refuses.
// Every block on one is a fragment, so not one of them was ever compiled there either.
// **`SYSL_DOCS_ONLY` narrows the run to the pages whose name holds it**, which is what makes working
// a failure down affordable: the whole site is nine hundred links and one page is a few seconds.
private docs_pages(root: string) -> Buf[string]
    val only = env_var("SYSL_DOCS_ONLY").unwrap_or("")
    var out: Buf[string] = buf()

    for item in walk(root)
        item match
            Err(_) -> ()
            Ok(entry) ->
                if entry.path.ends_with(".md") && !entry.path.contains("/api/") &&
                   entry.path.contains(only)
                    out.push(entry.path)

    out
end docs_pages

// A page named the way the site names it, so a complaint quotes a path a reader recognises rather
// than one machine's directory layout.
private docs_short(root: string, page: string) -> string =
    if page.starts_with(root + "/") then page[root.len + 1..] else page

// The section a page belongs to -- `reference`, `tour`, `library`, `getting-started` -- which is the
// first segment of its name.
private docs_section(short: string) -> string
    val at = short.index_of("/")

    if at.is_none() then "." else short[0..<at.unwrap()]
end docs_section

private docs_counted(row: DocsTally, b: DocsBlock, ok: bool) -> DocsTally
    var out = row

    if b.target != "" || b.archive then out = out with { attributed = out.attributed + 1 }

    // A `build=c` block is compiled rather than run, whatever it claims, so it is counted with the
    // refusals: the sweep's two columns are "ran and printed" and "was compiled".
    if b.claim == DocsClaim.PageShows && !b.archive then return out with { shown = out.shown + 1 }

    if b.claim == DocsClaim.PagePrints && !b.archive
        if ok then return out with { run_ok = out.run_ok + 1 }

        return out with { run_bad = out.run_bad + 1 }
    end if

    if ok then return out with { ref_ok = out.ref_ok + 1 }

    out with { ref_bad = out.ref_bad + 1 }
end docs_counted

private docs_line(name: string, t: DocsTally) -> string =
    s"$name: runnable ${t.run_ok} ok ${t.run_bad} failed, refused ${t.ref_ok} ok ${t.ref_bad} " +
    s"failed, ${t.shown} fragments, ${t.attributed} by attribute"

// Where a run leaves its report, for a reader who wants the numbers rather than a verdict: the test
// runner shows what a passing test says to nobody. Each part of a sweep appends its own, so the file
// is removed before a run that should start it afresh.
private docs_record(report: Buf[string], named_by: string = "SYSL_DOCS_SUMMARY")
    val where = env_var(named_by)

    if where.is_none() then return

    var b = str_builder()

    for i in 0..<report.len()
        b.push(report.at(i))
        b.push_char('\n')

    append_text(where.unwrap(), b.finish()).unwrap_or(())
end docs_record

private docs_first_twenty(bad: Buf[string]) -> string
    var b = str_builder()
    val shown = if bad.len() < 20 then bad.len() else 20

    b.push(s"${bad.len()} of the site's blocks disagree with this compiler; the first ${shown}:\n")

    for i in 0..<shown
        b.push("\n")
        b.push(bad.at(i))
        b.push_char('\n')

    b.finish()
end docs_first_twenty

// -- the sweeps, dealt into parts -------------------------------------------------------------------

// **Each sweep is `DocsParts` tests, each checking its own share of the pages**, so that a run starting
// several tests at once runs the site several pages at a time -- and no one process holds every
// compilation of the site, which in one process came to sixteen gigabytes. A page is checked by
// exactly one part (`docs_parts`). A complaint names its page, so which part found it does not matter.
const DocsParts: usize = 24

// The part each page is checked by, `parts` standing for none yet: the heaviest page first, by the sysl blocks it shows, each dealt
// to the part holding the fewest blocks so far -- ties to the lower part, and between pages of one
// weight to the earlier name, so the dealing is the same on every machine. No part is lighter than
// it could be except under a page too heavy to share.
private docs_parts(root: string, pages: Buf[string], parts: usize) -> Buf[usize]
    var weight: Buf[usize] = buf()
    var part: Buf[usize] = buf()
    var load: Buf[usize] = buf()

    for page in pages
        weight.push(docs_blocks(docs_short(root, page), read_text(page).unwrap_or("")).len())
        part.push(parts)

    for _ in 0..<parts
        load.push(0)

    for _ in 0..<pages.len()
        var pick = pages.len()

        for i in 0..<pages.len()
            if part.at(i) != parts then continue

            if pick == pages.len() || weight.at(i) > weight.at(pick) ||
               (weight.at(i) == weight.at(pick) && pages.at(i) < pages.at(pick))
                pick = i

        var lightest: usize = 0

        for k in 1..<parts
            if load.at(k) < load.at(lightest) then lightest = k

        part.set(pick, lightest)
        load.set(lightest, load.at(lightest) + weight.at(pick))

    part
end docs_parts

// The pages part `part` checks, of the pages a run reads.
private docs_pages_of_part(root: string, part: usize) -> Buf[string]
    val pages = docs_pages(root)
    val dealt = docs_parts(root, pages, DocsParts)
    var out: Buf[string] = buf()

    for i in 0..<pages.len()
        if dealt.at(i) == part then out.push(pages.at(i))

    out
end docs_pages_of_part

// Every sysl block on part `part`'s pages compiles here, and prints or refuses what its page says.
//
// The report is a line for each page and one for the part. **`SYSL_DOCS_SUMMARY` gathers every
// part's report into one file**, each part appending its own as it finishes, so a run of the whole
// site still leaves every complaint in one place.
private docs_sweep_part(part: usize)
    if env_var("SYSL_DOCS").unwrap_or("") != "1"
        print("skipped: SYSL_DOCS is not set, so the site's pages were not run")
        return
    end if

    val root = docs_root()

    if root == ""
        print("skipped: no pages at '../docs/content' (run from 'compiler/') or at what SYSL_SITE names")
        return
    end if

    if std_root().is_err() || !clang_available()
        print("skipped: the library or the toolchain is not on this machine")
        return
    end if

    val pages = docs_pages_of_part(root, part)

    if pages.is_empty() then return

    // One process compiles every block of its pages, so the standard module is parsed once and kept
    // (`keep_std_units`) rather than parsed again for each block.
    keep_std_units(true)

    val dir = make_temp_dir("sysl-docs").unwrap()
    val src = s"$dir/main.sysl"
    val exe = s"$dir/program"
    val archive_at = s"$dir/program.a"

    var report: Buf[string] = buf()
    var bad: Buf[string] = buf()
    var total = DocsTally(0, 0, 0, 0, 0, 0)

    for page in pages
        val short = docs_short(root, page)
        val blocks = docs_blocks(short, read_text(page).unwrap_or(""))

        var row = DocsTally(0, 0, 0, 0, 0, 0)

        for i in 0..<blocks.len()
            val b = blocks.at(i)

            val placed = docs_placed(dir, b.source)
            var path = src

            if placed.is_some() then path = placed.unwrap()
            else write_text(src, b.source).unwrap()

            val said = docs_check(path, exe, archive_at, b)

            if placed.is_some() then remove_dir_all(s"$dir/tree").unwrap_or(())

            row = docs_counted(row, b, said.is_none())

            if said.is_some() then bad.push(said.unwrap())

        report.push(docs_line(short, row))
        total = docs_add(total, row)

    remove_dir_all(dir).unwrap_or(())
    report.push(docs_line(s"-- part ${part + 1} of $DocsParts", total))

    for i in 0..<report.len()
        print(report.at(i))

    // The complaints go into the summary rather than into the report the runner shows, which holds
    // the first twenty: a sweep worked down one cause at a time needs all of them.
    report.push("")

    for i in 0..<bad.len()
        report.push(bad.at(i))

    docs_record(report)
    assert(bad.is_empty(), docs_first_twenty(bad))
end docs_sweep_part

