module sh.sysl.compiler
@tests

// `@crossing(p)` -- a parameter hands a value to another concurrency domain -- and what it refuses
// (`reference/memory.md § @crossing — where the rule is asked`). What it may name is settled at the
// declaration; whether an argument may cross is asked at each call, of the argument, through the
// walk a `&sync T`'s pointee goes through, so a `*T`'s pointee is examined rather than waved through.

private val azb_node: string = "struct Node\n    v: int\n"
private val azb_job: string = "struct Job\n    node: &Node\n"

private azb_names_parameters() -> string =
    "names the parameters a value reaches another concurrency domain through"

@test("there is no bare form")
azb_cae_there_is_no_bare_form()
    if !azb_ready() then return

    azb_refused(azb_main("@crossing\nf(x: int) -> int = x\nprint(f(1))\n"), [azb_names_parameters()])

// `@reads()` is a real claim; this one would not be.
@test("nor an empty pair of parentheses")
azb_cae_nor_empty_parentheses()
    if !azb_ready() then return

    azb_refused(azb_main("@crossing()\nf(x: int) -> int = x\nprint(f(1))\n"), ["There is no empty form"])

@test("what stands in them is a name, not an expression")
azb_cae_a_name_not_an_expression()
    if !azb_ready() then return

    azb_refused(azb_main("@crossing(1)\nf(x: int) -> int = x\nprint(f(1))\n"), [azb_names_parameters()])

@test("a word that is not a parameter is refused by name")
azb_cae_a_word_that_is_not_a_parameter()
    if !azb_ready() then return

    azb_refused(azb_main("@crossing(stat)\nf(state: int) -> int = state\nprint(f(1))\n"),
                ["'@crossing' names 'stat', which is not a parameter of 'f'", "its parameters are 'state'"])

@test("and a function with no parameters says so")
azb_cae_a_function_with_no_parameters()
    if !azb_ready() then return

    azb_refused(azb_main("@crossing(state)\nf() -> int = 1\nprint(f())\n"), ["it takes none"])

@test("one named twice says nothing the once does not")
azb_cae_one_named_twice()
    if !azb_ready() then return

    azb_refused(azb_main("@crossing(a, a)\nf(a: int) -> int = a\nprint(f(1))\n"), ["names 'a' twice"])

// `*T` carries no count -- a fact about the pointer, not about the object at the far end.
@test("an object holding a plain reference may not be handed over")
azb_cae_an_object_holding_a_plain_reference()
    if !azb_ready() then return

    azb_refused(azb_main(azb_node + azb_job +
                         "@crossing(state)\nstart(state: *Job) -> int = state[0].node.v\n" +
                         "var n: &Node = Node(1)\nvar j = Job(n)\nprint(start(&j))\n"),
                ["what 'state' of 'start' points at reaches another concurrency domain",
                 "its 'node' reaches a '&Node'", "Hold it as a '&sync Node'"])

@test("nor one holding a string, whose buffer count is not atomic either")
azb_cae_nor_one_holding_a_string()
    if !azb_ready() then return

    azb_refused(azb_main("struct Job\n    label: string\n" +
                         "@crossing(state)\nstart(state: *Job) -> int = 1\n" +
                         "var j = Job(\"hi\")\nprint(start(&j))\n"),
                ["its 'label' reaches a 'string'", "a shared object holds no view at all"])

@test("a plain reference is the thing in the way")
azb_cae_a_plain_reference()
    if !azb_ready() then return

    azb_refused(azb_main(azb_node + "@crossing(state)\nstart(state: &Node) -> int = state.v\n" +
                         "var n: &Node = Node(1)\nprint(start(n))\n"),
                ["'state' of 'start' reaches another concurrency domain", "but it is a '&Node'"])

// The question is about the argument, so a generic facility is asked afresh per instantiation.
@test("a generic parameter is asked per instantiation")
azb_cae_a_generic_parameter()
    if !azb_ready() then return

    azb_refused(azb_main(azb_node + azb_job + "@crossing(state)\nstart[T](state: *T) -> unit = ()\n" +
                         "var n: &Node = Node(1)\nvar j = Job(n)\nstart(&j)\n"),
                ["what 'state' of 'start' points at reaches another concurrency domain",
                 "its 'node' reaches a '&Node'"])
