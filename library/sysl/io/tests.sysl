module sysl.io
@tests

import sysl.buf.{Buf, buf}

// What the whole-stream reads promise, asserted in sysl rather than beside it in Scala.
//
// The reading surface had no test file of its own until these were written: `Lines` is covered
// indirectly through `sysl.term.edit`, and `BytesReader` was covered by being used. A reader that
// answers SHORT is the case every one of these is really about, and it is the case a hand-rolled
// loop gets wrong -- so the fixture below is a reader that never fills what it is offered.

// -- a reader that answers short ------------------------------------------------------------------

// `bytes_reader_at_most` is the one already in the module: it hands back at most `most` bytes per
// call whatever it was offered, which is what a pipe with one write in it, a socket, or a terminal
// does. Nothing here would notice the difference against a reader that always fills.

@test("read_all gathers a stream that arrives in one piece")
read_all_one_piece()
    var r = bytes_reader([u8('h'), u8('i')])

    assert_eq(read_all(&r).len(), 2)

@test("read_all keeps going past a short read, which is not the end of anything")
read_all_past_short()
    var r = bytes_reader_at_most([u8('a'), u8('b'), u8('c'), u8('d'), u8('e')], 2)

    val got = read_all(&r)

    assert_eq(got.len(), 5)
    assert_eq(got[0], u8('a'))
    assert_eq(got[4], u8('e'))

@test("read_all of an empty stream is an empty buffer rather than a failure")
read_all_empty()
    var r = bytes_reader([])

    assert(read_all(&r).is_empty())

@test("read_all_text answers the text where the bytes are UTF-8")
read_all_text_ok()
    var r = bytes_reader_at_most([u8('h'), u8('e'), u8('y')], 1)

    read_all_text(&r) match
        Ok(s) -> assert_eq(s, "hey")
        Err(_) -> assert(false)

// The severity that is NOT taken: a whole stream is what arrives off a wire or out of a file
// somebody else wrote, so a caller is told rather than stopped.
@test("and reports rather than stopping where they are not")
read_all_text_bad()
    var r = bytes_reader([u8('h'), 255])

    read_all_text(&r) match
        Ok(_) -> assert(false)
        Err(e) -> assert_eq(e.offset, 1)

// -- filling a slice ------------------------------------------------------------------------------

@test("read_exact fills the whole slice across as many reads as it takes")
read_exact_fills()
    var r = bytes_reader_at_most([u8('a'), u8('b'), u8('c'), u8('d')], 1)
    var into: [4]u8 = [0; 4]

    val got = read_exact(&r, into)

    assert_eq(got.len, 4)
    assert_eq(got[3], u8('d'))

// The distinction the function exists for: `read` answering short is not the end of input, and
// `read_exact` stops only when there is genuinely nothing more.
@test("and stops at the end of input, handing back the prefix it did fill")
read_exact_short_stream()
    var r = bytes_reader([u8('a'), u8('b')])
    var into: [4]u8 = [0; 4]

    val got = read_exact(&r, into)

    assert_eq(got.len, 2)

@test("an empty request reads nothing and asks the reader for nothing")
read_exact_empty_request()
    var r = bytes_reader([u8('a')])
    var into: [1]u8 = [0; 1]

    assert_eq(read_exact(&r, into[0..<0]).len, 0)

// -- lines that are not text ----------------------------------------------------------------------

// "ok\n", then "a" 0xFF "b\n", then "z\n" -- a bad byte in the middle of the middle line.
private bad_middle() -> []const u8 =
    [u8('o'), u8('k'), 10, u8('a'), 255, u8('b'), 10, u8('z'), 10]

@test("line_text answers an ill-formed line as an error at its offset, rather than stopping")
line_text_answers()
    line_text([u8('h'), u8('i'), 13]) match
        Ok(s) -> assert_eq(s, "hi")
        Err(_) -> assert(false, "a well-formed line with its \\r trimmed")

    line_text([u8('a'), u8('b'), 255, 13]) match
        Ok(_) -> assert(false, "0xFF is never UTF-8")
        Err(e) ->
            assert_eq(e.offset, 2)
            assert(!e.truncated, "a byte no continuation could rescue")

@test("a 'for' over a cursor ends at a bad line, and the cursor it walked says where")
lines_end_at_a_bad_line()
    var r = bytes_reader(bad_middle())
    var c = lines(&r)
    var got: Buf[string] = buf()

    for line in c
        got.push(line)

    assert_eq(got.len(), 1)
    assert_eq(got[0], "ok")

    c.error() match
        None -> assert(false, "the loop ended early, and the cursor has to say why")
        Some(e) ->
            assert_eq(e.offset, 1)
            assert(!e.truncated, "0xFF is not a cut-short sequence")

@test("and the cursor stays ended: getline does not read past the bad line")
lines_stay_ended()
    var r = bytes_reader(bad_middle())
    var c = lines(&r)

    assert_eq(c.getline(), Some("ok"))
    assert(c.getline().is_none(), "the bad line")
    assert(c.getline().is_none(), "and 'z', which follows it, is not handed over")
    assert(c.error().is_some(), "the reason is kept")

@test("try_getline reads past the bad line, answering each line's own verdict")
try_getline_continues()
    var r = bytes_reader_at_most(bad_middle(), 2)
    var c = lines(&r)
    var said: Buf[string] = buf()

    loop
        c.try_getline() match
            None -> break
            Some(line) ->
                line match
                    Ok(s) -> said.push(s)
                    Err(e) -> said.push(s"bad at ${e.offset}")

    assert_eq(said.len(), 3)
    assert_eq(said[0], "ok")
    assert_eq(said[1], "bad at 1")
    assert_eq(said[2], "z")
    assert(c.error().is_none(), "try_getline answers; it sets no latch")

// "ok\n", then "x" and the first two bytes of the three-byte U+20AC, and the input ends there.
@test("a final line cut short inside a sequence is an error with 'truncated' set")
lines_truncated_at_the_end()
    val cut: []const u8 = [u8('o'), u8('k'), 10, u8('x'), 0xE2, 0x82]

    var r = bytes_reader(cut)
    var c = lines(&r)

    assert_eq(c.getline(), Some("ok"))
    assert(c.getline().is_none(), "the cut-short line")

    c.error() match
        None -> assert(false, "a truncated sequence is not text")
        Some(e) ->
            assert_eq(e.offset, 1)
            assert(e.truncated, "more bytes would have fixed it")

    var again = bytes_reader(cut)
    var d = lines(&again)

    assert(d.try_getline().is_some(), "ok")

    d.try_getline() match
        Some(Err(e)) -> assert(e.truncated, "the same verdict through the reporting walk")
        _ -> assert(false, "the cut-short line is an Err")

    assert(d.try_getline().is_none(), "and then the input has ended")

@test("a cursor that reached the end cleanly has no error")
lines_clean_end()
    var r = bytes_reader([u8('a'), 10, u8('b')])
    var c = lines(&r)

    assert_eq(c.getline(), Some("a"))
    assert_eq(c.getline(), Some("b"))
    assert(c.getline().is_none(), "the end")
    assert(c.error().is_none(), "the end is not an error")
