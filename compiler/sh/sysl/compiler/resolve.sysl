module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.fs.{is_file, read_text}
import sysl.text.Search

// The dependency graph, resolved.
//
// **Minimal Version Selection**: the version chosen for a package is *the highest minimum anybody
// asked for*, not the newest that exists. It is a walk taking a maximum rather than a search, which
// is what makes it a few hundred lines instead of a solver, and it gives three properties that fall
// out of the arithmetic rather than out of cleverness -- adding a dependency cannot silently upgrade
// an unrelated one, the answer is a function of the manifests reachable from this one, and upgrading
// is an edit to a file rather than a command that walks everything forward.
//
// **Selecting and materializing are two passes, and they have to be.** A floor can rise *after* the
// package it belongs to has been reached: a dependency named 1.2.0 and something further down the
// graph named 1.4.0, so what was read first is not what gets built. One pass that resolved names as
// it walked would have built the import table of a version it then stopped using. So the first pass
// reads manifests and does nothing but raise floors, and the second pass runs over the answer, by
// which time every version is final.

// One package of a resolved graph: where its source is, what it says about itself, and what the
// names in *its* import lines mean.
//
// `imports` is per-package and that is the whole of the two-layer identity. A package's own source
// says `json.Parser` and means whatever *it* calls `json`; a consumer of that package says
// `json.Parser` and may mean something else entirely. Both resolve through their own table to one
// canonical name, so the two never have to agree on a spelling and always agree on which code they
// linked.
struct ResolvedPackage
    // The canonical prefix its modules sit under, or the empty one for the project being built.
    canonical: string

    root: string
    manifest: Manifest

    // What each name this package writes at the head of an import line means.
    imports: Buf[(string, string)]

    version: Option[Release]
end ResolvedPackage

// Whether this is the project being built rather than something it depends on. The root project has
// no coordinate, and its modules keep the names they were written with.
is_root_package(p: &ResolvedPackage) -> bool = p.canonical.is_empty()

// One manifest asking for one coordinate at one floor, kept so that a reader can be told who wanted
// what.
//
// `asker` is named the way a reader can go and look it up: a fetched package by its coordinate, a
// path dependency by its label, and the root by whatever its manifest calls itself.
struct Claim
    coordinate: string
    asker: string
    version: Release
end Claim

// Everything a build needs from the package system: the packages in a stable order, the claims that
// decided their versions, and the `sysl.sum` that should be on disk afterwards.
struct Graph
    packages: Buf[ResolvedPackage]
    claims: Buf[Claim]
    sums: Sums
    sums_changed: bool

    // The features each package has enabled, keyed as `ResolvedPackage.canonical` is -- the root's
    // under the empty name. A package missing from it has enabled nothing (`enabled_of`).
    features: Buf[(string, Buf[string])]

    // Every coordinate and version whose manifest this resolution read, which is wider than what
    // `packages` holds: a floor that rose after its lower version was read leaves that version read
    // and unselected, and every resolution of the same manifests reads it again. So it is the set a
    // `sysl.sum` has to cover for a build to add nothing to it, which is what `sysl tidy` keeps.
    read: Buf[(string, Release)]
end Graph

// What the selecting pass carries: the version floors, who asked for them, the manifests read so
// far, the packages that are directories rather than coordinates, and the sums as they stand.
struct ResolveState
    selected: Buf[(string, Release)]
    claims: Buf[Claim]
    manifests: Buf[ReadPackage]
    locals: Buf[ReadPackage]
    sums: Sums
    changed: bool

    // What this round takes as enabled, which decides which optional dependencies each manifest is
    // read with (`pruned_manifest`). A package no round has reached has nothing turned on.
    enabled: Buf[(string, Buf[string])]

    // Every `--lib` source root that is a directory, with what its manifest says: the candidates to
    // stand in for a coordinate (`stand_in_for`).
    roots: Buf[(string, Manifest)]

    // The versions the whole workspace settled on, which every claim starts from (`floor_of`). Empty
    // outside a workspace.
    floors: Buf[(string, Release)]

    // Whether every manifest is read whole rather than pruned to the features a round enabled, which
    // is how the workspace's own selection reads them (`workspace_selection`).
    everything: bool
end ResolveState

// A state with nothing selected yet.
new_resolve_state(sums: Sums, enabled: Buf[(string, Buf[string])], roots: Buf[(string, Manifest)],
                  floors: Buf[(string, Release)], everything: bool) -> ResolveState =
    ResolveState(buf(), buf(), buf(), buf(), sums, false, enabled, roots, floors, everything)

// The `--lib` root that **is** the package `dep` names, where one is -- in which case that coordinate
// is never selected, fetched or read, anywhere in the graph (`reference/packages.md § A source root
// stands in for the package it is`). Cargo's `[patch]` and Go's `replace`, as one flag.
//
// **A root is that package when its `package.name` is the coordinate's repository name** -- the last
// segment of the path, a major-version suffix set aside, so `github.com/e/json/v2` is `json`. That is
// the one identity both sides state without anything being fetched: the coordinate names a
// repository, and a checkout of it -- a clone, a worktree, a fork -- carries that repository's
// manifest. Comparing modules instead would need the coordinate's tree, which is the very fetch an
// override exists to avoid; and the dependency's *label* is a name the consumer chose, which two
// manifests may spell differently, so the answer would depend on which edge the walk read first.
//
// A function of the coordinate alone, so every edge naming it gets the same answer.
private stand_in_for(state: &ResolveState, dep: &Dependency) -> Option[(string, Manifest)] =
    stood_in_by(state.roots, dep) match
        None -> None
        Some(i) -> Some(state.roots.at(i))

// Which of `roots` stands in for the coordinate `dep` names, by its position: the first whose
// `package.name` is the coordinate's repository name. The one rule both the selection and the
// features a root is asked for (`enabled_from`) go by, so the two cannot name different roots.
stood_in_by(roots: &Buf[(string, Manifest)], dep: &Dependency) -> Option[usize]
    val coordinate = dependency_coordinate(dep) match
        None -> return None
        Some(c) -> c

    val repository = repository_name(coordinate)

    for i in 0..<roots.len()
        if roots.at(i).1.name == repository then return Some(i)

    None
end stood_in_by

// A manifest that has been read, and where it was read from. The coordinate is the empty string for
// a package that arrived as a directory, which has none.
struct ReadPackage
    canonical: string
    coordinate: string
    version: Option[Release]
    dir: string
    manifest: Manifest
end ReadPackage

// Resolves the graph rooted at `root`, fetching whatever this machine has not got.
//
// `cache` is passed in rather than found here so that a test can resolve a whole graph without
// writing into the machine's own package cache -- the same reason the manifest reader takes text
// rather than a path.
//
// **Which features are on is a fixpoint over whole resolutions** (`features.sysl`): a round resolves
// against what the previous one enabled, works out what that graph's consumers ask for, and the climb
// stops at the first round that changes nothing. The comparison is over the enabled sets rather than
// over the packages, because the case it exists for is a feature turned on in a package that was
// already in the graph -- the same packages, different source. `testing` is `sysl test`'s, which turns
// on every feature the root declares where the request said nothing.
resolve_graph(root: string, written: &Manifest, sums: Sums, cache: string,
              request: FeatureRequest = no_feature_request(),
              testing: bool = false) -> Result[Graph, string]
    val config = bind_members(resolving_local_paths(written, root), root)?
    val root_set = root_enabled(config, request, testing)?
    var enabled: Buf[(string, Buf[string])] = buf()

    enabled.push(("", root_set))

    // **Inside a workspace, the versions are the workspace's** (`workspace_selection`): selected
    // once over every member's dependencies, before any round, and handed to each round as floors.
    val around = workspace_around(root)?
    val shared: Option[WorkspaceSelection] = around match
        None -> None
        Some(ws) -> Some(workspace_selection(ws, sums, cache)?)

    val start_sums = shared match
        None -> sums
        Some(s) -> s.sums

    val floors: Buf[(string, Release)] = shared match
        None -> buf()
        Some(s) -> s.selected

    var rounds = 0

    loop
        var built = resolve_once(root, config, start_sums, cache, enabled, floors)?
        var next = enabled_from(built.packages, root_packages()?, enabled)?

        next.push(("", root_set))

        if same_enabled(next, enabled)
            built.features = enabled

            shared match
                None -> ()
                Some(s) -> with_workspace_answer(&built, s)

            return Ok(built)
        end if

        if rounds >= FeatureRounds
            return Err(s"resolving which features are enabled did not settle after $FeatureRounds " +
                "rounds — a feature turning on a dependency whose own features turn on another is " +
                "expected, and this many of them in a row is not")
        end if

        enabled = next
        rounds += 1
end resolve_graph

// What a workspace's one selection settled: the version of every coordinate any member could reach,
// who asked for what, the sums afterwards, and every manifest it read.
struct WorkspaceSelection
    selected: Buf[(string, Release)]
    claims: Buf[Claim]
    sums: Sums
    changed: bool
    read: Buf[(string, Release)]
end WorkspaceSelection

// **One Minimal Version Selection over every member's dependencies**, so no two members can be built
// against two versions of one package: each member's own resolution then starts every floor here
// (`floor_of`).
//
// **Every manifest is read whole** -- every member's `dependencies` and `dev_dependencies`, and every
// optional dependency of every package -- because the answer has to hold for any build of any member
// with any features, which is what Cargo's one lockfile resolves too. A member's own graph is still
// only what it reaches: these are floors, not packages handed to its build. A member's
// `{ workspace = true }` entries add nothing here, every member being read in its own right.
workspace_selection(ws: &Workspace, sums: Sums, cache: string) -> Result[WorkspaceSelection, string]
    var state = new_resolve_state(sums, buf(), root_packages()?, buf(), true)

    for i in 0..<ws.members.len()
        val mb = ws.members.at(i)
        val m = resolving_local_paths(mb.manifest, mb.dir)
        var all: Buf[Dependency] = buf()
        var paths: Buf[Dependency] = buf()

        for j in 0..<m.dependencies.len()
            all.push(m.dependencies.at(j))

        for j in 0..<m.dev_dependencies.len()
            all.push(m.dev_dependencies.at(j))

        for j in 0..<all.len()
            all.at(j).origin match
                Local(_) -> paths.push(all.at(j))
                _ -> ()

        read_locals(paths, &state, cache)?
        demanding(&state, mb.name, all)

    select_versions(&state, cache)?

    var read: Buf[(string, Release)] = buf()

    for i in 0..<state.manifests.len()
        read.push((state.manifests.at(i).coordinate, state.manifests.at(i).version.unwrap()))

    Ok(WorkspaceSelection(state.selected, state.claims, state.sums, state.changed, read))
end workspace_selection

// A member's graph told what the workspace's selection knows: that the sums changed if it changed
// them, every manifest it read (which is what `sysl tidy` keeps a line for), and the claims other
// members made on the packages this member uses -- the line that explains a version this member never
// asked for.
private with_workspace_answer(g: *Graph, s: &WorkspaceSelection)
    if s.changed then g.sums_changed = true

    for i in 0..<s.read.len()
        var seen = false

        for j in 0..<g.read.len()
            if g.read.at(j).0 == s.read.at(i).0 && g.read.at(j).1 == s.read.at(i).1 then seen = true

        if !seen then g.read.push(s.read.at(i))

    for i in 0..<s.claims.len()
        val c = s.claims.at(i)
        var used = false
        var seen = false

        for j in 0..<g.packages.len()
            if g.packages.at(j).canonical == canonical_prefix(c.coordinate) then used = true

        for j in 0..<g.claims.len()
            val had = g.claims.at(j)

            if had.coordinate == c.coordinate && had.asker == c.asker && had.version == c.version
                seen = true

        if used && !seen then g.claims.push(c)
end with_workspace_answer

// One round: the whole resolution, against one round's idea of what is enabled.
private resolve_once(root: string, written: &Manifest, sums: Sums, cache: string,
                     enabled: Buf[(string, Buf[string])],
                     floors: Buf[(string, Release)]) -> Result[Graph, string]
    val config = pruned_manifest(written, enabled, "")

    // **A root is read as the package it is**: its optional dependencies are the ones the
    // features this round enabled for it turned on, and no others (`enabled_from`).
    val roots = pruned_roots(root_packages()?, enabled)
    var state = new_resolve_state(sums, enabled, roots, floors, false)

    read_locals(config.dependencies, &state, cache)?
    demanding(&state, root_asker(config), config.dependencies)

    // **A `--lib` source root's `dependencies` join the one graph**, so selection sees every claim
    // at once and a package two roots name is one copy at one version. A root's modules are filed
    // under the project's names, so what its manifest binds is bound into the project's own table,
    // at the level of what the project declared, after it and in the order the roots were given.
    // Its claims are the project's to answer for, and a listing says so.
    var declared: Buf[Dependency] = buf()

    for i in 0..<config.dependencies.len()
        declared.push(config.dependencies.at(i))

    for i in 0..<roots.len()
        val theirs = roots.at(i).1.dependencies

        read_locals(theirs, &state, cache)?
        demanding(&state, root_asker(config), theirs)

        for j in 0..<theirs.len()
            declared.push(theirs.at(j))

    select_versions(&state, cache)?

    val root_table = table_of(ManifestName, root, declared, state)?
    val settled = materialize(state)
    var packages: Buf[ResolvedPackage] = buf()

    packages.push(ResolvedPackage("", root, config, root_table, None))

    for i in 0..<settled.len()
        var p = settled.at(i)

        p.imports = table_of(package_owner(p), p.root, p.manifest.dependencies, state)?
        packages.push(p)

    check_floors(packages)?

    var read: Buf[(string, Release)] = buf()

    for i in 0..<state.manifests.len()
        val had = state.manifests.at(i)

        read.push((had.coordinate, had.version.unwrap()))

    Ok(Graph(packages, state.claims, state.sums, state.changed, enabled, read))
end resolve_once

// What the root calls itself when it is the one asking, since it has no coordinate to be named by.
//
// A manifest need not name its package, and a listing that then attributed a claim to the empty
// string would read as though nobody had asked for it -- which is the opposite of what the claim
// says.
root_asker(config: &Manifest) -> string =
    if config.name.is_empty() then "this project" else config.name

// A package as the person who has to act on the message thinks of it -- the name it calls itself and
// the tag they wrote, rather than the dotted canonical form the resolver keys on.
private package_named(p: &ResolvedPackage) -> string
    val name = if p.manifest.name.is_empty() then p.canonical else p.manifest.name

    p.version match
        None -> s"package $name"
        Some(v) -> s"package $name ${release_tag(v)}"
end package_named

// The other spelling, which labels a *manifest* being read rather than a package being refused.
private package_owner(p: &ResolvedPackage) -> string
    p.version match
        None -> p.canonical
        Some(v) -> s"${p.canonical} ${release_tag(v)}"
end package_owner

// Every dependency's stated floor against the compiler in hand, where this compiler is in a
// position to make a claim about one at all (`on_the_release_line`).
//
// **This is the whole point of the field**, and it is why the check is here rather than left to
// whatever fails later: a package using something the language grew fails somewhere *inside* itself,
// with a diagnostic pointing at a line in a tree the consumer did not write and nothing to say the
// compiler is what is wrong. The manifest is what turns that into one sentence naming the package,
// the floor and the compiler.
//
// The **root** is not checked here -- the driver does it, which is the funnel every command's own
// manifest comes through, and checking it twice would report it twice.
private check_floors(packages: &Buf[ResolvedPackage]) -> Result[unit, string]
    val v = compiler_version()

    if !on_the_release_line(v) then return Ok(())

    dependency_floor_refusal(packages, v) match
        None -> Ok(())
        Some(why) -> Err(why)
end check_floors

// The first dependency whose stated floor is newer than `compiler`, worded for the person who has to
// act on it -- the package by the name it calls itself and the tag that was asked for.
//
// The compiler is a parameter rather than read here so that the sentence can be asked for against a
// release-line version even while a development build makes no claim against its own
// (`on_the_release_line`).
dependency_floor_refusal(packages: &Buf[ResolvedPackage], compiler: string) -> Option[string]
    for i in 0..<packages.len()
        val p = packages.at(i)

        if is_root_package(p) then continue

        check_floor(package_named(p), p.manifest.floor, compiler) match
            None -> ()
            Some(why) -> return Some(why)

    None
end dependency_floor_refusal

// Every requirement raises a floor and nothing ever lowers one, which is the whole of selection --
// and every one of them is written down on the way past, whether or not it won.
//
// **This is the only place holding both halves at once.** Downstream has the answer and not the
// question: what is selected keeps a version with no memory of where it came from, and a version
// that was passed over has its manifest dropped on purpose. So a claim recomputed from the finished
// graph can only ever find the one that won, which is the half nobody needed to be told.
private demanding(state: *ResolveState, asker: string, deps: &Buf[Dependency])
    for i in 0..<deps.len()
        // A coordinate a source root stands in for takes no part in selection at all.
        if stand_in_for(*state, deps.at(i)).is_some() then continue

        deps.at(i).origin match
            Git(coordinate, asked) ->
                state.claims.push(Claim(coordinate, asker, asked))

                // **Inside a workspace a floor starts at the workspace's answer**, so a member's own
                // walk never reads -- or fetches, or records in `sysl.sum` -- a version the workspace
                // has already passed over.
                val version = floor_of(*state, coordinate, asked)
                var known = false
                var raised: Buf[(string, Release)] = buf()

                for j in 0..<state.selected.len()
                    val entry = state.selected.at(j)

                    if entry.0 != coordinate then raised.push(entry)
                    else
                        known = true

                        if release_before(entry.1, version) then raised.push((coordinate, version))
                        else raised.push(entry)

                if !known then raised.push((coordinate, version))

                state.selected = raised
            _ -> ()
end demanding

// What a claim of `asked` on `coordinate` is selected at: the workspace's version where that is
// higher, and the claim itself everywhere else.
private floor_of(state: &ResolveState, coordinate: string, asked: Release) -> Release
    for i in 0..<state.floors.len()
        val floor = state.floors.at(i)

        if floor.0 == coordinate && release_before(asked, floor.1) then return floor.1

    asked
end floor_of

// The version selection settled on for a coordinate, where it has settled on one.
private selected_version(state: &ResolveState, coordinate: string) -> Option[Release]
    for i in 0..<state.selected.len()
        if state.selected.at(i).0 == coordinate then return Some(state.selected.at(i).1)

    None
end selected_version

// A package's hash written into the sums where no line covered it yet.
//
// Asked against what is held rather than against how the package arrived, so that a project
// depending on something another project already fetched still records what it got. A line that is
// already there and already agrees is not a change, which is what keeps a build from rewriting the
// file every time.
private with_fetch(state: *ResolveState, dep: &Dependency, got: &Fetched)
    if got.hash.is_none() then return

    dep.origin match
        Git(coordinate, version) ->
            val hash = got.hash.unwrap()
            val already = sum_of(state.sums, coordinate, version)

            if already.is_none() || already.unwrap() != hash
                state.sums = sums_recording(state.sums, coordinate, version, hash)
                state.changed = true
        _ -> ()
end with_fetch

// The path dependencies of the **root** manifest, which are not part of version selection.
//
// A directory beside the consumer has no version to select and no coordinate to be identified by, so
// it takes no part in selection and is simply read. A *dependency* may not have one: a relative path
// in a fetched package would be relative to a checkout that only exists on the machine that made it,
// which is a build that works for its author and nobody else.
private read_locals(deps: &Buf[Dependency], state: *ResolveState,
                    cache: string) -> Result[unit, string]
    for i in 0..<deps.len()
        val dep = deps.at(i)

        if is_git_dependency(dep) then continue

        // The project and a source root, or two roots, naming one directory under one label is one
        // package read once.
        if already_local(*state, dep) then continue

        val got = fetch_ensure(dep, state.sums, cache)?
        val read = manifest_of_package(got.root)?
        val theirs = if state.everything then read
        else pruned_manifest(read, state.enabled, dependency_canonical(dep))

        // **A workspace member is the one directory whose own directories mean something**: the
        // workspace is one checkout, so a member's members and paths are read as the root's are.
        val member = is_member_dependency(dep)

        if !member
            for j in 0..<theirs.dependencies.len()
                if !is_git_dependency(theirs.dependencies.at(j))
                    return Err(s"'${dep.label}' is a path dependency that itself has a path " +
                        "dependency — a relative path only means something in the project it was " +
                        "written in")

        state.locals.push(ReadPackage(dependency_canonical(dep), "", None, got.root, theirs))
        demanding(state, dep.label, theirs.dependencies)

        if member then read_locals(theirs.dependencies, state, cache)?

    Ok(())
end read_locals

private already_local(state: &ResolveState, dep: &Dependency) -> bool
    val canonical = dependency_canonical(dep)
    val dir = dependency_dir(dep).unwrap_or("")

    for i in 0..<state.locals.len()
        val had = state.locals.at(i)

        if had.canonical == canonical && had.dir == dir then return true

    false
end already_local

// Every `--lib` source root that is a directory and its manifest, in the order the roots were given,
// each `path` read against the root's own directory. A root with no manifest answers the empty one,
// which depends on nothing; an artifact is not a root and is refused where roots are read.
root_packages() -> Result[Buf[(string, Manifest)], string]
    var out: Buf[(string, Manifest)] = buf()
    val libs = lib_roots()

    for i in 0..<libs.len()
        if !is_directory(libs.at(i)) then continue

        out.push((libs.at(i), manifest_of_package(libs.at(i))?))

    Ok(out)
end root_packages

// The roots' manifests as one round reads them, each pruned to what that round enabled for it under
// `lib_root_key` -- exactly what `pruned_manifest` does to a fetched package's.
pruned_roots(roots: Buf[(string, Manifest)], enabled: &Buf[(string, Buf[string])]) -> Buf[(string, Manifest)]
    var out: Buf[(string, Manifest)] = buf()

    for i in 0..<roots.len()
        val (dir, m) = roots.at(i)

        out.push((dir, pruned_manifest(m, enabled, lib_root_key(dir))))

    out
end pruned_roots

// Whether a build has a graph to resolve at all: the project's own `dependencies`, or a source
// root's.
wants_graph(m: &Manifest) -> bool
    if !m.dependencies.is_empty() then return true

    val libs = lib_roots()

    for i in 0..<libs.len()
        if !is_directory(libs.at(i)) then continue

        manifest_of_package(libs.at(i)) match
            Ok(theirs) -> if !theirs.dependencies.is_empty() then return true
            Err(_) -> return true

    false
end wants_graph

// The selecting pass: read the manifest of every floor, raise whatever it demands, repeat.
//
// It terminates because a floor only rises and a coordinate has finitely many versions, so each step
// either reads a pair nothing has read or finds none left and stops.
private select_versions(state: *ResolveState, cache: string) -> Result[unit, string]
    loop
        val next = unread_pair(*state)

        if next.is_none() then return Ok(())

        val coordinate = next.unwrap().0
        val version = next.unwrap().1
        val dep = plain_dependency(coordinate, Git(coordinate, version), None)
        val got = fetch_ensure(dep, state.sums, cache)?
        val read = manifest_of_package(got.root)?
        val theirs = if state.everything then read
        else pruned_manifest(read, state.enabled, canonical_prefix(coordinate))

        for j in 0..<theirs.dependencies.len()
            if !is_git_dependency(theirs.dependencies.at(j))
                return Err(s"$coordinate ${release_tag(version)} has a path dependency, which " +
                    "only means something in the project it was written in")

        with_fetch(state, dep, got)
        state.manifests.push(ReadPackage(canonical_prefix(coordinate), coordinate, Some(version),
                                         got.root, theirs))
        demanding(state, coordinate, theirs.dependencies)
end select_versions

// The lowest coordinate whose selected version has no manifest read for it yet.
private unread_pair(state: &ResolveState) -> Option[(string, Release)]
    var best: Option[(string, Release)] = None

    for i in 0..<state.selected.len()
        val entry = state.selected.at(i)
        var read = false

        for j in 0..<state.manifests.len()
            val had = state.manifests.at(j)

            if had.coordinate == entry.0 && had.version.unwrap() == entry.1 then read = true

        if read then continue

        if best.is_none() || entry.0 < best.unwrap().0 then best = Some(entry)

    best
end unread_pair

// Every package the build will read, at the version selection settled on.
//
// The manifests read hold every version that was *looked at*, which is more than what is used -- a
// floor that rose left the lower one behind. Reading the answer off what was selected rather than
// off the manifests is what drops those.
private materialize(state: &ResolveState) -> Buf[ResolvedPackage]
    var out: Buf[ResolvedPackage] = buf()

    val coordinates = sorted_labels(selected_coordinates(state))

    for i in 0..<coordinates.len()
        val name = coordinates.at(i)
        val version = selected_version(state, name).unwrap()

        for j in 0..<state.manifests.len()
            val had = state.manifests.at(j)

            if had.coordinate == name && had.version.unwrap() == version
                out.push(ResolvedPackage(canonical_prefix(name), had.dir, had.manifest, buf(),
                                         Some(version)))

    var labels: Buf[string] = buf()

    for i in 0..<state.locals.len()
        labels.push(state.locals.at(i).canonical)

    val ordered = sorted_labels(labels)

    for i in 0..<ordered.len()
        for j in 0..<state.locals.len()
            val had = state.locals.at(j)

            if had.canonical == ordered.at(i)
                out.push(ResolvedPackage(ordered.at(i), had.dir, had.manifest, buf(), None))

    out
end materialize

private selected_coordinates(state: &ResolveState) -> Buf[string]
    var out: Buf[string] = buf()

    for i in 0..<state.selected.len()
        out.push(state.selected.at(i).0)

    out
end selected_coordinates

// One entry of an import table: the name a file writes, what it canonically means, and which package
// put it there.
//
// The owner is carried beside the name and dropped at the end. The collision test is about
// *packages* -- two of them wanting one name -- and the target alone cannot answer that, since a
// mount stores the coordinate where an unmounted binding stores the coordinate and the module both.
struct MountedName
    written: string
    canonical: string
    owner: string
end MountedName

// One package's import table: what each name it writes at the head of an import line means.
//
// Built after selection, so a dependency that named 1.2.0 while something else named 1.4.0 gets the
// manifest of the version that is actually being built -- which is where its *name* comes from when
// no mount overrides it, and is exactly the thing one pass would have got wrong.
private table_of(owner: string, owner_root: string, deps: &Buf[Dependency],
                 state: &ResolveState) -> Result[Buf[(string, string)], string]
    var table = declared_table(owner, owner_root, deps, state)?
    val indirect = inherited(deps, state)?

    for i in 0..<indirect.len()
        val dep = plain_dependency(indirect.at(i).label, indirect.at(i).origin, None)
        val dir = their_root(dep, state)?
        val added = bindings_of(dep, dir) match
            Err(why) -> return Err(s"$owner: $why")
            Ok(got) -> got

        for j in 0..<added.len()
            table = inherit(owner, owner_root, table, added.at(j), dep, deps)?

    var out: Buf[(string, string)] = buf()

    for i in 0..<table.len()
        out.push((table.at(i).written, table.at(i).canonical))

    Ok(out)
end table_of

// The names a manifest's own `dependencies` block binds, which is what it wrote down.
//
// **A coordinate a `--lib` root stands in for binds that root's modules, under the names they
// already have** -- the root's files are filed under the project's own names, so the module a
// dependency's source writes as `geom` is the project's `geom` and nothing else. A mount still renames
// it for the manifest that wrote one. The root is left out of the collision check against itself,
// since being that package is exactly what it was asked to be; every other root and every other
// dependency is still checked as before.
private declared_table(owner: string, owner_root: string, deps: &Buf[Dependency],
                       state: &ResolveState) -> Result[Buf[MountedName], string]
    var table: Buf[MountedName] = buf()

    for i in 0..<deps.len()
        val dep = deps.at(i)
        val standing = stand_in_for(state, dep)
        val standing_dir = if standing.is_some() then standing.unwrap().0 else ""

        val added = if standing.is_some() then stand_in_bindings(dep, standing_dir)?
        else declared_bindings(owner, dep, state)?

        for j in 0..<added.len()
            no_collision(owner, owner_root, table, added.at(j).written, dep, standing_dir)?

        for j in 0..<added.len()
            table.push(added.at(j))

    Ok(table)
end declared_table

// What a dependency the build selected or read binds, from the tree it was settled on.
private declared_bindings(owner: string, dep: &Dependency,
                          state: &ResolveState) -> Result[Buf[MountedName], string]
    val dir = their_root(dep, state)?

    bindings_of(dep, dir) match
        Err(why) -> Err(s"$owner: $why")
        Ok(got) -> Ok(got)
end declared_bindings

// What a stood-in coordinate binds: each of the root's modules as itself, or under the mount. A root
// whose tree holds a malformed per-OS selector is refused as any package's is.
private stand_in_bindings(dep: &Dependency, dir: string) -> Result[Buf[MountedName], string]
    var out: Buf[MountedName] = buf()
    val owner = dependency_canonical(dep)

    val modules = package_modules(dir) match
        Err(e) -> return Err(e.message)
        Ok(m) -> m

    for i in 0..<modules.len()
        val m = modules.at(i)

        dep.mount match
            Some(mount) -> out.push(MountedName(package_qualify(mount, m), m, owner))
            None -> out.push(MountedName(m, m, owner))

    Ok(out)
end stand_in_bindings

// Every package reachable through the ones a manifest named, minus those it named itself.
//
// **Imports are transitive, and a manifest names what it *takes* rather than what it sees.** A
// dependency's public surface is made of its own dependencies' types, so a consumer that could not
// name them could not call the one function that package exists for. Requiring it to be declared
// anyway is asking for a line that says nothing a build could not work out.
//
// **Breadth first, so that nearer packages are offered a name first**, which is what makes the
// precedence below decidable at all.
private inherited(deps: &Buf[Dependency], state: &ResolveState) -> Result[Buf[Dependency], string]
    var queue: Buf[Dependency] = buf()
    var seen: Buf[string] = buf()
    var out: Buf[Dependency] = buf()

    for i in 0..<deps.len()
        queue.push(deps.at(i))

    var at: usize = 0

    while at < queue.len()
        val dep = queue.at(at)
        val canonical = dependency_canonical(dep)

        at += 1

        var already = false

        for i in 0..<seen.len()
            if seen.at(i) == canonical then already = true

        if already then continue

        seen.push(canonical)

        // A coordinate a source root stands in for offers nothing of its own to inherit -- the root's
        // modules are already the project's -- but what the root depends on is still reached through
        // it, exactly as the coordinate's own dependencies would have been.
        val standing = stand_in_for(state, dep)

        if standing.is_some()
            val root_deps = standing.unwrap().1.dependencies

            for i in 0..<root_deps.len()
                queue.push(root_deps.at(i))

            continue
        end if

        val theirs = their_manifest(dep, state)?

        for i in 0..<theirs.dependencies.len()
            queue.push(theirs.dependencies.at(i))

        var declared = false

        for i in 0..<deps.len()
            if dependency_canonical(deps.at(i)) == canonical then declared = true

        if !declared then out.push(dep)

    Ok(out)
end inherited

// One name a package further down the graph offers, placed or passed over.
//
// **Three levels of precedence, and only a tie inside one of them is refused.** The consumer's own
// modules win, then what its manifest declared, then what came in through something else -- and two
// packages at the *same* level wanting one name is the collision that is refused rather than
// resolved.
//
// **A name nobody asked for never takes one somebody wrote.** A project with its own `json/`, or a
// dependency it mounted as `json`, keeps that name however many packages three levels down offer a
// `json` of their own: passing over is not a silent winner, because the name that won is the one in
// front of the person reading the manifest.
private inherit(owner: string, owner_root: string, table: Buf[MountedName], binding: MountedName,
                dep: &Dependency, declared: &Buf[Dependency]) -> Result[Buf[MountedName], string]
    val local = binding.written
    val mine = dependency_canonical(dep)

    for i in 0..<table.len()
        val had = table.at(i)

        if !module_overlap(had.written, local) then continue

        if had.owner == mine then return Ok(table)

        for j in 0..<declared.len()
            if dependency_canonical(declared.at(j)) == had.owner then return Ok(table)

        return Err(s"$owner: '$local' and '${had.written}' cannot both be imported — " +
            s"${same_library(had.owner, mine)}, and both arrived through something else this " +
            s"project depends on. Name one of them in $ManifestName with a 'mount' to say which " +
            "name it takes here")

    val ours = package_modules(owner_root) match
        Err(e) -> return Err(e.message)
        Ok(m) -> m

    for i in 0..<ours.len()
        if module_overlap(ours.at(i), local) then return Ok(table)

    // A source root's modules stand at the project's own level, so they are offered the name first
    // on the same terms.
    if root_claiming(owner, local).is_some() then return Ok(table)

    var out = table

    out.push(MountedName(local, binding.canonical, mine))
    Ok(out)
end inherit

// The manifest of the version of `dep` that is being built, read off the selection rather than off
// the edge that asked for it -- the same rule the root below follows, for the same reason.
private their_manifest(dep: &Dependency, state: &ResolveState) -> Result[Manifest, string]
    val entry = their_entry(dep, state)?

    Ok(entry.manifest)
end their_manifest

// Where the version of `dep` that is being built has its source, which for a git dependency is the
// version selection settled on rather than the one this edge asked for.
private their_root(dep: &Dependency, state: &ResolveState) -> Result[string, string]
    val entry = their_entry(dep, state)?

    Ok(entry.dir)
end their_root

private their_entry(dep: &Dependency, state: &ResolveState) -> Result[ReadPackage, string]
    dep.origin match
        Git(coordinate, _) ->
            val version = selected_version(state, coordinate) match
                None -> return Err(s"'$coordinate' was never selected")
                Some(v) -> v

            for i in 0..<state.manifests.len()
                val had = state.manifests.at(i)

                if had.coordinate == coordinate && had.version.unwrap() == version
                    return Ok(had)

            Err(s"'$coordinate' was never read")

        _ ->
            val canonical = dependency_canonical(dep)

            for i in 0..<state.locals.len()
                if state.locals.at(i).canonical == canonical then return Ok(state.locals.at(i))

            Err(s"'${dep.label}' was never read")
end their_entry

// What a dependency binds in the manifest that named it.
//
// **With no mount, a package's modules come in under their own names.** That is what makes a mount
// optional: mandatory mounting would make every project's import lines differ from the library's own
// documentation, and an import line only matches the documentation if `sqlite.open` is what a
// consumer writes.
//
// **A name here is a module path and not a directory.** A package namespaced by reverse DNS offers
// `sh.sysl.table`; its `sh/` and `sh/sysl/` hold no source, so neither is a module and neither is a
// name it can be asked for.
//
// **A mount hangs the whole package under one segment**, which is the escape hatch for two
// dependencies wanting one name: mount one as `ejson` and its `json` is reached as `ejson.json`,
// leaving the project's own `json` alone. It is unchanged by any of the above -- a mount is a name
// the consumer chose, so there is no tree to read it off.
bindings_of(dep: &Dependency, dir: string) -> Result[Buf[MountedName], string]
    var out: Buf[MountedName] = buf()
    val canonical = dependency_canonical(dep)

    dep.mount match
        Some(mount) ->
            out.push(MountedName(mount, canonical, canonical))
            return Ok(out)
        None -> ()

    val modules = package_modules(dir) match
        Err(e) -> return Err(e.message)
        Ok(m) -> m

    if modules.is_empty()
        return Err(s"'${dep.label}' has no modules — a package is a tree of directories holding " +
            "source, each of them a module, and there is nothing here to import")

    for i in 0..<modules.len()
        out.push(MountedName(modules.at(i), package_qualify(canonical, modules.at(i)), canonical))

    Ok(out)
end bindings_of

// The two ways one module name can be claimed twice, both refused rather than resolved by order.
//
// A collision is an error and never a silent winner. The class path is the counter-example: the same
// package in two jars is decided by jar order, quietly, and what results is a program somebody has
// to bisect to understand.
//
// **What is compared is the module path**, so two packages that both namespace themselves under
// `sh.sysl` and offer `sh.sysl.sqlite` and `sh.sysl.linenoise` do not collide, because no import
// line can be read as either. The names they share are `sh` and `sh.sysl`, and neither package
// declares those -- a directory holding no source is not a module.
//
// **A root that IS the coordinate's package never collides with it**: it stands in for the
// coordinate (`stand_in_for`), which is then neither fetched nor bound, so its modules are the only
// ones by those names -- `standing` names it, and it is left out here. That is an explicit request,
// the reader having named the directory, and not the silent winner this refuses. What still arrives
// is a root that merely *holds* a module some coordinate also offers without being that package, and
// that is refused exactly as before, with a clause saying what would have made it an override.
private no_collision(owner: string, owner_root: string, table: &Buf[MountedName], local: string,
                     dep: &Dependency, standing: string) -> Result[unit, string]
    val mine = dependency_canonical(dep)

    for i in 0..<table.len()
        val had = table.at(i)

        if module_overlap(had.written, local) && had.owner != mine
            return Err(s"$owner: '$local' and '${had.written}' cannot both be imported — " +
                s"${same_library(had.owner, mine)}. Give one of them a 'mount' in $ManifestName " +
                "to say which name it takes here")

    // The consumer's own modules are in the same name space, and a project with a `json` directory
    // at its root taking a dependency that offers `json` is the common case rather than an exotic
    // one. Refused in the same words, because it is the same collision.
    val ours = package_modules(owner_root) match
        Err(e) -> return Err(e.message)
        Ok(m) -> m

    for i in 0..<ours.len()
        if module_overlap(ours.at(i), local)
            return Err(s"$owner: '$local' is both a module of this project and one $mine offers — " +
                "give the dependency a 'mount' to say what it is called here")

    // And a source root's, which are filed under the project's names rather than under a prefix of
    // their own: a root declaring `geom` beside a dependency offering `geom` is the same collision,
    // named by the root as the command line wrote it.
    //
    // A source root colliding with a coordinate is the case an override is for, so the refusal says
    // what would have made it one: the reader may have meant exactly that.
    root_claiming(owner, local, standing) match
        Some(given) ->
            val override_clause = dependency_coordinate(dep) match
                Some(coordinate) ->
                    ". A source root stands in for a coordinate only when it is that package — when " +
                    s"its $ManifestName names it '${repository_name(coordinate)}'"
                None -> ""

            Err(s"$owner: '$local' is both a module of the source root '$given' and one $mine " +
                "offers — give the dependency a 'mount' to say what it is called here" + override_clause)
        None -> Ok(())
end no_collision

// The `--lib` source root declaring a module that `local` would be read as, where the table being
// built is the project's own.
//
// **Only the project's table**, because a root's modules sit in the project's name space and in
// nobody else's: a package's own files read a written path through their own tree and their own
// manifest first, so what a root declares is no claim against them.
//
// `standing` is a root that stands in for the dependency being bound, which is that package rather
// than a claim against it, so it is passed over.
private root_claiming(owner: string, local: string, standing: string = "") -> Option[string]
    if owner != ManifestName then return None

    val libs = lib_roots()

    for i in 0..<libs.len()
        if !standing.is_empty() && libs.at(i) == standing then continue

        val theirs = package_modules(libs.at(i)).unwrap_or(buf())

        for j in 0..<theirs.len()
            if module_overlap(theirs.at(j), local) then return Some(libs.at(i))

    None
end root_claiming

// What to say about two packages claiming one module name, which is not always the same thing.
//
// **Two major versions of one library is the case worth naming, and transitive imports made it
// likely.** A major above the first rides in the coordinate, so `github.com/e/json` and
// `github.com/e/json/v2` are two *different* packages to selection -- it cannot fold them together,
// and it should not: they are allowed to be incompatible, which is what the suffix says. What they
// are not allowed to do is quietly both answer `json`, and their module names are identical because
// a module's name is its directory.
private same_library(a: string, b: string) -> string
    val one = slashed(a)
    val two = slashed(b)

    if without_major(one) == without_major(two) && one != two
        return s"$a and $b are two major versions of one library and both are in this graph, and " +
            "their modules have the same names"

    s"$a and $b claim the same module"
end same_library

// A canonical name back to the shape a coordinate has, which is what the major-version suffix is
// read off.
private slashed(name: string) -> string
    var out = ""

    for i in 0..<name.bytes.len
        out = out + (if name.bytes[i] == u8('.') then "/" else name[i..<(i + 1)])

    out
end slashed

// Whether two module paths claim ground the other needs: the same name, or one a path **inside** the
// other.
//
// The nesting half is what keeps the table unambiguous rather than merely unique. A package offering
// `sh.sysl` and another offering `sh.sysl.table` share no name, but `sh.sysl.table` read as an
// import answers to both -- and picking the longer would be the silent winner this whole rule exists
// to refuse.
module_overlap(a: string, b: string) -> bool =
    starts_with_module(a, b) || starts_with_module(b, a)

// A package's manifest, where it has one. A package with no file is a package that said nothing,
// exactly as a project with none is.
//
// **A dependency's unknown keys are worth saying more than a project's**, because this is the case
// the manifest cannot report for itself: a package written against a newer sysl than the one in
// hand, being built by the older one. The root says whose manifest it is, since the reader did not
// write this file.
manifest_of_package(root: string) -> Result[Manifest, string]
    val file = join_path(root, ManifestName)

    if !is_file(file) then return Ok(empty_manifest())

    val text = read_text(file) match
        Err(_) -> return Err(s"cannot read $file")
        Ok(got) -> got

    val m = read_manifest(text) match
        Err(why) -> return Err(s"$root: $why")
        Ok(got) -> got

    for i in 0..<m.warnings.len()
        eprints(s"$root: ${m.warnings.at(i)}\n")

    bind_members(resolving_local_paths(m, root), root)
end manifest_of_package

// A manifest with every `path` dependency read against `dir`, the directory that holds it
// (`resolved_against`). Called on every manifest the resolver reads, the project's among them, so a
// relative path means the directory beside *that* manifest wherever the build was started from.
resolving_local_paths(m: &Manifest, dir: string) -> Manifest
    var out = *m

    out.dependencies = resolved_all_against(m.dependencies, dir)
    out.dev_dependencies = resolved_all_against(m.dev_dependencies, dir)
    out
end resolving_local_paths

// Everything a compilation takes from the package system: the source of every package the graph
// reached, what the project's own files mean by the paths they import, and the directories a C walk
// visits.
//
// **It is the roots as well as the parsed trees, and that is the whole reason the third field
// exists**: a package may carry `.c` of its own, and what compiles that is a walk over the
// directory. The units hand back what was parsed, which says nothing about the files beside them.
struct PackageSources
    units: Buf[Program]
    root_mounts: Buf[(string, string)]
    roots: Buf[string]

    // The `#if` symbols the project's own enabled features define, for its own files.
    root_features: Buf[string]

    // The `#if` symbols each `--lib` root's enabled features define, for its own files, keyed by the
    // root as it was written.
    lib_features: Buf[(string, Buf[string])]
end PackageSources

// A project that depends on nothing, which is what an empty `dependencies` block means.
no_package_sources() -> PackageSources = PackageSources(buf(), buf(), buf(), buf(), buf())

// The symbols one `--lib` root's files are gated by.
lib_feature_symbols(s: &PackageSources, dir: string) -> Buf[string]
    for i in 0..<s.lib_features.len()
        if s.lib_features.at(i).0 == dir then return s.lib_features.at(i).1

    buf()
end lib_feature_symbols

// The graph resolved, fetched and read, for one project at one machine, each dependency's modules
// under the canonical prefix its coordinate gives them -- for every command, `emit-typed` included,
// so that a package has the same name wherever the program is asked about.
//
// **Each package's files are gated by its own features**: a symbol is a fact about the package whose
// manifest declared it, so the root's `feature_x` is invisible in a dependency and a dependency's in
// the root.
package_sources(root: string, m: &Manifest, t: Target) -> Result[PackageSources, Failure]
    if !wants_graph(m)
        // No graph, but the project's own features still decide which of its lines are compiled.
        val mine = root_enabled(resolving_local_paths(m, root), current_feature_request(),
                                feature_testing()) match
            Err(why) -> return Err(said(Refusal(why)))
            Ok(got) -> got

        var none = no_package_sources()

        none.root_features = feature_symbols(mine)

        // With no graph nothing names a root's coordinate, so each has its `default` on.
        val roots = root_packages() match
            Err(why) -> return Err(said(Refusal(why)))
            Ok(got) -> got

        for i in 0..<roots.len()
            val (dir, theirs) = roots.at(i)
            var asked: Buf[string] = buf()

            asked.push("default")
            none.lib_features.push((dir, feature_symbols(feature_closure(theirs.features, asked,
                                                                         theirs.dependencies))))

        return Ok(none)
    end if

    val graph = resolved_graph(root, m)?
    var out = no_package_sources()
    val libs = lib_roots()

    for i in 0..<libs.len()
        out.lib_features.push((libs.at(i),
                               feature_symbols(enabled_of(graph.features, lib_root_key(libs.at(i))))))

    for i in 0..<graph.packages.len()
        val p = graph.packages.at(i)

        if is_root_package(p)
            out.root_mounts = p.imports
            out.root_features = feature_symbols(enabled_of(graph.features, ""))
            continue

        out.roots.push(p.root)

        val found = collect(p.root, Some(t.os)) match
            Err(e) -> return Err(said(Refusal(e.message)))
            Ok(f) -> f

        if found.is_empty()
            return Err(said(Refusal(s"'${p.canonical}' holds no sysl source files")))

        // **The package's own terms, not the consumer's.** Its modules sit under the prefix its
        // coordinate gives them, and the paths its own files write at the head of an import line
        // mean whatever *its* manifest bound -- which is what makes a package's source read the
        // same whoever depends on it.
        val (manifest, name, version) = manifest_of_tree(p.root, p.manifest.name, p.manifest.version)
        val theirs = Packaging(p.canonical, p.imports, true, manifest, name, version)
        val gated = feature_symbols(enabled_of(graph.features, p.canonical))

        for j in 0..<found.len()
            val parsed = parse(found.at(j).src, t, gated)

            if !parsed.ok() then return Err(Reported(parse_report(parsed)))

            var unit = parsed.program

            unit.pkg = theirs
            out.units.push(unit)

    Ok(out)
end package_sources

// The graph alone, which is what a build and a listing of what a project takes have in common.
//
// **Writing the sums back is part of resolving rather than part of building.** A line is recorded
// because a package was fetched, and every caller here fetches; leaving it to the build would mean
// the first listing after adding a dependency downloaded a package and recorded nothing about what
// it got.
resolved_graph(root: string, m: &Manifest) -> Result[Graph, Refusal]
    // **A workspace has one `sysl.sum` and one `vendor/`, both at its root**, since it has one
    // resolution: a member reads and writes the workspace's.
    val home = resolution_root(root) match
        Err(why) -> return Err(Refusal(why))
        Ok(dir) -> dir

    val cache = cache_root(home) match
        Err(why) -> return Err(Refusal(why))
        Ok(dir) -> dir

    val sums = sums_at(home) match
        Err(why) -> return Err(Refusal(why))
        Ok(got) -> got

    val graph = resolve_graph(root, m, sums, cache, current_feature_request(), feature_testing()) match
        Err(why) -> return Err(Refusal(why))
        Ok(got) -> got

    if graph.sums_changed then write_sums(home, graph.sums)

    Ok(graph)
end resolved_graph

// The directory of every other tree the build with **every feature on** would take -- the packages
// that graph reaches and, where `roots`, the `--lib` source roots. Resolved afresh and never written
// back: it is asked only to tell a library a feature left out from a misspelt one (`link`).
all_feature_trees(root: string, m: &Manifest, roots: bool) -> Result[Buf[string], Refusal]
    var out: Buf[string] = buf()

    if wants_graph(m)
        val home = resolution_root(root) match
            Err(why) -> return Err(Refusal(why))
            Ok(dir) -> dir

        val cache = cache_root(home) match
            Err(why) -> return Err(Refusal(why))
            Ok(dir) -> dir

        val sums = sums_at(home) match
            Err(why) -> return Err(Refusal(why))
            Ok(got) -> got

        val graph = resolve_graph(root, m, sums, cache, FeatureRequest(buf(), false, true),
                                  feature_testing()) match
            Err(why) -> return Err(Refusal(why))
            Ok(got) -> got

        for i in 0..<graph.packages.len()
            val p = graph.packages.at(i)

            if !is_root_package(p) then out.push(p.root)
    end if

    if roots
        val libs = lib_roots()

        for i in 0..<libs.len()
            out.push(libs.at(i))
    end if

    Ok(out)
end all_feature_trees

// One tree a compilation was handed beside the project's own: a package its `dependencies` reached,
// or a source root a `--lib` named.
struct Handed
    // What a refusal about this tree calls it: a package's canonical prefix, since the consumer has
    // the coordinate they wrote in front of them where two packages may have written one `name`; a
    // source root exactly as the command line wrote it.
    who: string

    // Where its files are.
    dir: string

    // Whether it is a `--lib` source root rather than a package the graph reached. A root's modules
    // carry no prefix and its manifest is not the consumer's to be bound by in every respect, so a
    // reader of manifests asks this before reading one.
    from_lib: bool

    // Whether it sits where it is because a fetch put it there. A path dependency or a workspace
    // member is a directory of the reader's own, whose place reaches every `__FILE__` in it -- so the
    // run cache keys its path, as it keys the project's.
    fetched: bool
end Handed

// **Every other tree this build takes, which is one question and is asked in one place.** The C
// walk of a build and of an archive, the allocator claims, the installed libraries and the headers
// a build is answerable for, the words a `defines` refusal names a tree in, and the run cache's key
// all ask it -- and a tree that appeared in some of those answers and not the others would be a
// build that is wrong in a way only one command shows.
//
// The packages come first, in the order the graph resolved them, and then the source roots in the
// order they were written. A dependency that cannot be resolved is not a refusal here: whatever
// needed its *source* has already said so, and a build that got this far has one to walk.
handed_trees(root: string, m: &Manifest) -> Buf[Handed]
    var out: Buf[Handed] = buf()

    if wants_graph(m)
        resolved_graph(root, m) match
            Err(_) -> ()
            Ok(graph) ->
                for i in 0..<graph.packages.len()
                    val p = graph.packages.at(i)

                    if !is_root_package(p)
                        out.push(Handed(p.canonical, p.root, false, p.version.is_some()))
    end if

    val libs = lib_roots()

    for i in 0..<libs.len()
        out.push(Handed(libs.at(i), libs.at(i), true, false))

    out
end handed_trees
