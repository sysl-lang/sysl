module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.time.{monotonic, whole_micros}

// What gathering a program's tests costs as the program grows.
//
// **Every test and every hook is checked against the bodies that survived analysis**, and a program
// with many tests has many functions too, so that check has to be a lookup rather than a search: one
// that scans every function per test is quadratic in the two, and on this compiler's own tree it was
// most of what building the program cost.
//
// The claim is a ratio rather than a bound, so it holds on a slow machine as well as a fast one: a
// program four times larger may cost four times as much and not sixteen times.

// `n` tests, each calling a function of its own.
private tested_program(n: usize) -> string
    var lines: Buf[string] = buf()

    lines.push("main()\n    val n = f0(1)\n\n")

    for i in 0..<n
        lines.push(s"f$i(n: int) -> int = n + $i\n\n")
        lines.push(s"@test\nt$i()\n    val n = f$i(1)\n\n")

    var text = ""

    for i in 0..<lines.len()
        text = text + lines.at(i)

    text
end tested_program

// The best of three gatherings of one program, in microseconds, and how many tests it found.
private gather_cost(n: usize) -> (long, usize)
    val done = typed_of(tested_program(n))

    assert(done.reported.is_empty(), "the generated program is sound")

    var best: long = -1
    var found: usize = 0

    for round in 0..<3
        val started = monotonic()
        val p = program_of(done, done.main_module)
        val took = whole_micros(monotonic() - started)

        found = p.tests.len()

        if best < 0 || took < best then best = took

    (best, found)
end gather_cost

@test("gathering the tests of a program four times larger costs about four times as much")
gathering_tests_is_linear()
    val small = gather_cost(1000)
    val large = gather_cost(4000)

    assert_eq(small.1, 1000)
    assert_eq(large.1, 4000)

    val ratio = large.0 / (if small.0 > 0 then small.0 else 1)

    assert(ratio < 9, s"a 4x program took ${ratio}x as long to gather (${small.0} us, then ${large.0} us)")
end gathering_tests_is_linear
