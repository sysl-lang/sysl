// p06d: a default on the base trait that needs Self to implement a refining trait (Rust's
// `fn rev(self) where Self: DoubleEndedIterator`).
trait It
    type Item
    next(*self) -> Option[Self::Item]

    rev(self) -> RevIt[Self] where Self: Back = RevIt(self)

trait Back: It
    next_back(*self) -> Option[Self::Item]

struct RevIt[I]
    src: I

impl[I: Back] It for RevIt[I]
    type Item = I::Item
    next(*self) -> Option[I::Item] = self.src.next_back()

struct Span
    lo: int
    hi: int

impl It for Span
    type Item = int
    next(*self) -> Option[int]
        if self.lo >= self.hi then return None
        self.lo += 1
        Some(self.lo - 1)

impl Back for Span
    next_back(*self) -> Option[int]
        if self.lo >= self.hi then return None
        self.hi -= 1
        Some(self.hi)

main()
    var r = Span(0, 3).rev()
    print(r.next().unwrap())
