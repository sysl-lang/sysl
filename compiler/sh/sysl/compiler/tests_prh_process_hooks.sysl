module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.fs.is_file
import sysl.process.capture
import sysl.text.Search
import sysl.testing.skip

// **Starting, waiting for and signalling a child over `sysl.process.sys`, and a program answering it
// on a target with no C library.**
//
// `sysl.process` starts a child through the `sysl_proc_spawn` hook, waits through `sysl_proc_wait`,
// signals through `sysl_proc_kill` and names a capture file through `sysl_proc_temp_path`. On a hosted
// POSIX target the library's `sysl.process.hosted` answers them over `posix_spawn` and `waitpid`,
// under `weak` exports; on a freestanding one the program answers each hook it reaches with an
// `@export`, and one it leaves unanswered is refused when it is compiled (`emit_checks.sysl`'s
// `check_library_hooks`, the `sysl.process.sys` row). What the hosted answers do at run time is
// `library/sysl/process/hooks_tests.sysl`'s.

private val prh_target: string = "aarch64-freestanding"
private val prh_nm: string = "/opt/homebrew/opt/llvm/bin/llvm-nm"

private val prh_script: string =
    "ENTRY(kstart)\nSECTIONS\n{\n    . = 0x40080000;\n    .text : { KEEP(*(.text.boot)) *(.text .text.*) }\n" +
    "    .rodata : { *(.rodata .rodata.*) }\n    .data : { *(.data .data.*) }\n" +
    "    .bss (NOLOAD) : { *(.bss .bss.*) *(COMMON) }\n}\n"

// An image entered at `kstart`, laid out by the script, with the program's own heap.
private val prh_manifest: string =
    "package { name = \"img\", version = \"0.0.1\" }\n" +
    "allocator {\n  alloc = \"img_alloc\"\n  free  = \"img_free\"\n}\n" +
    s"targets {\n  $prh_target {\n    linker_script = \"link.ld\"\n    entry = \"kstart\"\n  }\n}\n"

// A shell's two moves -- a command with its output sent to a file, and a child started, signalled and
// waited for -- which between them reach every hook of `sysl.process.sys`.
private val prh_program: string = raw"""
    import sysl.process.{Stdio, run, start}
    import sysl.process.sys.Text

    go() -> int
        var n = 0

        if run("/bin/ls", ["/"], stdout = Stdio.ToPath("/listing")).is_ok() then n += 1

        start("/bin/spin") match
            Ok(c) ->
                c.kill(9)

                if c.wait().is_ok() then n += 2
            Err(_) -> ()

        n
    end go
    """

// What every bare image here defines for itself: its start, its heap (an address that is not null,
// so nothing after the first allocation folds away), the memory functions LLVM calls on a target
// with no C library, `putchar` and `exit`, and the six `sysl.fs.sys` hooks that writing a file,
// reading one back and handing one to a child as its input (which gives back what was read ahead) reach.
private val prh_runtime_core: string = raw"""
    @export("kstart")
    kstart() -> never
        val n = go()

        loop
            ()

    @export("img_alloc")
    img_alloc(n: usize) -> *u8 = ptr_cast(usize(0x4100_0000))

    @export("img_free")
    img_free(p: *u8) = ()

    @export("memset")
    mem_set(dst: *u8, c: int, n: usize) -> *u8
        val d: *volatile u8 = ptr_cast(dst)

        for i in 0..<n do d[i] = u8(c)

        dst

    @export("memcpy")
    mem_copy(dst: *u8, src: *u8, n: usize) -> *u8
        val d: *volatile u8 = ptr_cast(dst)

        for i in 0..<n do d[i] = src[i]

        dst

    @export("memmove")
    mem_move(dst: *u8, src: *u8, n: usize) -> *u8 = mem_copy(dst, src, n)

    @export("memcmp")
    mem_compare(a: *u8, b: *u8, n: usize) -> int = 0

    @export("putchar")
    k_putchar(c: int) -> int = c

    @export("exit")
    k_exit(code: int) -> never
        loop
            ()

    @export("sysl_fs_open")
    k_open(path: *u8, len: usize, flags: u32, mode: u32, fd: *int) -> int = -38

    @export("sysl_fs_read")
    k_read(fd: int, into: *u8, room: usize, got: *usize) -> int = -38

    @export("sysl_fs_write")
    k_write(fd: int, from: *u8, len: usize, put: *usize) -> int = -38

    @export("sysl_fs_close")
    k_close(fd: int) -> int = 0

    @export("sysl_fs_seek")
    k_seek(fd: int, offset: long, whence: int, at: *long) -> int = -29
    """

// The sixth, which a capture file reaches -- and `Child`'s destructor, which removes one.
private val prh_unlink: string = raw"""
    @export("sysl_fs_unlink")
    k_unlink(path: *u8, len: usize) -> int = -38
    """

private val prh_runtime: string = prh_runtime_core + prh_unlink

// The four hooks, answered as a kernel's process calls would be.
private val prh_hooks: string = raw"""
    @export("sysl_proc_spawn")
    k_spawn(path: *u8, path_len: usize, argv: *Text, argc: usize, envp: *Text, envc: usize,
            inherit_env: int, dir: *u8, dir_len: usize, stdin_fd: int, stdout_fd: int,
            stderr_fd: int, started: *i64, pgid: i64, foreground: int) -> i64 = 7

    @export("sysl_proc_wait")
    k_wait(pid: i64, started: i64, timeout_ms: i64, how: *int, value: *int) -> int = 0

    @export("sysl_proc_kill")
    k_kill(pid: i64, signal: int) -> int = 0

    @export("sysl_proc_temp_path")
    k_temp_path(into: *u8, room: usize) -> isize = -38
    """

private prh_tree(program: string) -> string
    var files = lbr_two("main.sysl", program, "package.hocon", prh_manifest)

    files.push(("link.ld", prh_script))
    lbr_tree(files)
end prh_tree

// What `sysl build` answers for the image, and where it wrote it.
private prh_build(p: string) -> ((int, string), string)
    val out = lbr_temp("sysl-prh-elf")

    (lbr_cli(["sysl", "build", "--target", prh_target, "-o", s"$out/img.elf", p]), out)
end prh_build

private prh_symbols(elf: string, undefined: bool) -> string
    val ran = if undefined then capture(prh_nm, ["-u", elf], "", [], true)
    else capture(prh_nm, [elf], "", [], true)

    ran match
        Ok(o) -> o.text
        Err(_) -> "llvm-nm could not be run"
end prh_symbols

// Whether an `llvm-nm` listing names `symbol`, as the last word of one of its lines.
private prh_names(listing: string, symbol: string) -> bool
    for line in lines_of(listing)
        if line == symbol || line.ends_with(s" $symbol") then return true

    false
end prh_names

private prh_link_ready() -> bool
    if !lbr_ready() then return false

    val lld = capture("ld.lld", ["--version"], "", [], true) match
        Ok(o) -> o.status.ok()
        Err(_) -> false

    if !lld then skip("ld.lld is not installed, so no image can be linked")
    if !is_file(prh_nm) then skip(s"there is no llvm-nm at $prh_nm to read the image")

    true
end prh_link_ready

// -- a bare image answering the hooks it reaches -----------------------------------------------------

@test("a freestanding program that spawns, waits and kills links with only its own process hooks")
prh_answered_hooks_link()
    if !prh_link_ready() then return

    val p = prh_tree(prh_program + prh_runtime + prh_hooks)
    val (said, out) = prh_build(p)

    assert(said.0 == 0, said.1)

    val elf = s"$out/img.elf"
    val all = prh_symbols(elf, false)

    assert_eq(prh_symbols(elf, true).trim(), "")

    // The program's own answers are the ones in the image, defined strong.
    for hook in ["sysl_proc_spawn", "sysl_proc_wait", "sysl_proc_kill", "sysl_proc_temp_path"]
        assert(all.contains(s" T $hook"), all)


    // And nothing of the hosted answer came with them.
    for name in ["posix_spawn", "posix_spawnp", "fork", "execvp", "waitpid", "kill", "mkstemp",
                 "sysl_proc_posix_start", "sysl_proc_posix_wait"]
        assert(!prh_names(all, name), s"'$name' is in the image")

    lbr_drop([p, out])
end prh_answered_hooks_link

// -- the hooks left unanswered -------------------------------------------------------------------------

@test("a freestanding program that spawns with no process hooks is refused, naming the four it reaches")
prh_unanswered_hooks_are_refused()
    if !lbr_ready() then return

    val p = prh_tree(prh_program + prh_runtime)
    val (said, out) = prh_build(p)

    assert(said.0 != 0, "built with every process hook unanswered")
    assert(said.1.contains(s"error: this program reaches 'sysl.process', and '$prh_target' " +
        "has no operating system under it for the standard library to answer a process or a user " +
        "with, so the program answers it: define 'sysl_proc_kill', 'sysl_proc_spawn', " +
        "'sysl_proc_temp_path', 'sysl_proc_wait' with '@export', each taking what its 'extern' in " +
        "'sysl.process.sys' declares and answering a process id, a user or group id, a length, one or " +
        "zero, or the code of an 'IoError' negated"), said.1)

    // Told before the link, so no linker names a symbol; and the filesystem's hooks, answered, are
    // not asked for.
    assert(!said.1.contains("undefined symbol"), said.1)
    assert(!said.1.contains("sysl.fs.sys"), said.1)

    lbr_drop([p, out])
end prh_unanswered_hooks_are_refused

// -- a hosted target -------------------------------------------------------------------------------------

@test("on a hosted target the library answers the process hooks under weak exports")
prh_hosted_library_answers_weakly()
    if !lbr_ready() then return

    val p = lbr_program(raw"""
        import sysl.process.{Stdio, run, start}

        print(run("true", stdout = Stdio.ToPath("x")).is_ok())

        val c = start("true").unwrap()

        c.kill()
        print(c.wait().is_ok())
        """)
    val said = lbr_cli(["sysl", "emit-llvm", "--no-std-lib", "--target", "x86_64-linux", p])

    lbr_drop([p])
    assert(said.0 == 0, said.1)

    for hook in ["sysl_proc_spawn", "sysl_proc_wait", "sysl_proc_kill", "sysl_proc_temp_path"]
        var defined = ""

        for line in lines_of(said.1)
            if line.starts_with("define ") && line.contains(s" @$hook(") then defined = line

        assert(defined.starts_with("define weak "), s"$hook: $defined")
    end for

    assert(said.1.contains("@sysl_proc_posix_start("), "the hosted answer does not call the shim")
end prh_hosted_library_answers_weakly

// -- who the program is, and a file's owner ---------------------------------------------------------

// `id`, `su` and `chown` between them: who the program is, a file given to it, and a move to another
// user -- the two identity hooks of `sysl.process.sys` and the `chown` hook of `sysl.fs.sys`.
private val prh_identity_program: string = raw"""
    import sysl.fs.set_owner
    import sysl.process.{group, real_user, set_group, set_user, user}

    go() -> int
        var n = 0

        if user() == real_user() then n += 1
        if set_owner("/home/alice/note", user(), group()).is_ok() then n += 2
        if set_group(100).is_ok() && set_user(1000).is_ok() then n += 4

        n
    end go
    """

// The three hooks, answered as a kernel with one user per process would answer them -- and nothing
// for `kill` or `wait`: `Child`'s destructor reaches those two, and a destructor is kept only where
// the program holds a value of its type, which a program asking who it is never does.
private val prh_identity_hooks: string = raw"""
    @export("sysl_proc_get_id")
    k_get_id(which: int) -> i64 = 1000

    @export("sysl_proc_set_id")
    k_set_id(which: int, id: u32) -> int = -1

    @export("sysl_fs_chown")
    k_chown(path: *u8, len: usize, owner: u32, group: u32) -> int = -38
    """

@test("a freestanding program that asks who it is and gives a file away links with only its own hooks")
prh_identity_hooks_link()
    if !prh_link_ready() then return

    val p = prh_tree(prh_identity_program + prh_runtime + prh_identity_hooks)
    val (said, out) = prh_build(p)

    assert(said.0 == 0, said.1)

    val elf = s"$out/img.elf"
    val all = prh_symbols(elf, false)

    assert_eq(prh_symbols(elf, true).trim(), "")

    for hook in ["sysl_proc_get_id", "sysl_proc_set_id", "sysl_fs_chown"]
        assert(all.contains(s" T $hook"), all)

    for name in ["getuid", "geteuid", "getgid", "getegid", "setuid", "setgid", "chown"]
        assert(!prh_names(all, name), s"'$name' is in the image")

    lbr_drop([p, out])
end prh_identity_hooks_link

@test("a freestanding program that asks who it is with no hooks is refused, naming the ones it reaches")
prh_identity_hooks_unanswered()
    if !lbr_ready() then return

    val p = prh_tree(prh_identity_program + prh_runtime)
    val (said, out) = prh_build(p)

    assert(said.0 != 0, "built with the identity hooks unanswered")
    assert(said.1.contains(s"error: this program reaches 'sysl.process', and '$prh_target' has no " +
        "operating system under it for the standard library to answer a process or a user with, so " +
        "the program answers it: define 'sysl_proc_get_id', 'sysl_proc_set_id' with '@export'"), said.1)
    assert(said.1.contains(s"error: this program reaches 'sysl.fs', and '$prh_target' has no " +
        "operating system under it for the standard library to answer a filesystem with, so the " +
        "program answers it: define 'sysl_fs_chown' with '@export'"), said.1)
    assert(!said.1.contains("undefined symbol"), said.1)

    lbr_drop([p, out])
end prh_identity_hooks_unanswered

@test("on a hosted target the library answers the identity and chown hooks under weak exports")
prh_hosted_identity_answers_weakly()
    if !lbr_ready() then return

    val p = lbr_program(raw"""
        import sysl.fs.set_owner
        import sysl.process.{group, set_user, user}

        print(set_owner("x", user(), group()).is_ok(), set_user(user()).is_ok())
        """)
    val said = lbr_cli(["sysl", "emit-llvm", "--no-std-lib", "--target", "x86_64-linux", p])

    lbr_drop([p])
    assert(said.0 == 0, said.1)

    for hook in ["sysl_proc_get_id", "sysl_proc_set_id", "sysl_fs_chown"]
        var defined = ""

        for line in lines_of(said.1)
            if line.starts_with("define ") && line.contains(s" @$hook(") then defined = line

        assert(defined.starts_with("define weak "), s"$hook: $defined")
    end for

    for c in ["@geteuid(", "@setuid(", "@chown("]
        assert(said.1.contains(c), s"the hosted answer does not call $c")
end prh_hosted_identity_answers_weakly

// -- a destructor is kept by its type, not by its module ---------------------------------------------

// A program reaching `sysl.process` for a pipe and its own identity, and never for a child: the
// module's `Child` has a destructor that waits, kills and removes a capture file, and none of it
// is the program's to answer, since no value of the type is ever made.
private val prh_no_child_program: string = raw"""
    import sysl.process.{pipe, user}

    go() -> int
        var n = 0

        if user() == 1000 then n += 1

        pipe() match
            Ok(_) -> n += 2
            Err(_) -> ()

        n
    end go
    """

private val prh_no_child_hooks: string = raw"""
    @export("sysl_proc_get_id")
    k_get_id(which: int) -> i64 = 1000

    @export("sysl_proc_pipe")
    k_pipe(read_end: *int, write_end: *int) -> int = -38
    """

@test("a program that never makes a Child links without the hooks Child's destructor reaches")
prh_no_child_no_child_hooks()
    if !prh_link_ready() then return

    val p = prh_tree(prh_no_child_program + prh_runtime_core + prh_no_child_hooks)
    val (said, out) = prh_build(p)

    assert(said.0 == 0, said.1)

    val elf = s"$out/img.elf"
    val all = prh_symbols(elf, false)

    assert_eq(prh_symbols(elf, true).trim(), "")
    for hook in ["sysl_proc_wait", "sysl_proc_kill", "sysl_fs_unlink", "sysl_proc_spawn"]
        assert(!prh_names(all, hook), s"'$hook' is in the image")

    for hook in ["sysl_proc_get_id", "sysl_proc_pipe"]
        assert(all.contains(s" T $hook"), all)

    lbr_drop([p, out])
end prh_no_child_no_child_hooks

@test("and with no hooks at all it is refused naming only the two it reaches, not the destructor's")
prh_no_child_unanswered()
    if !lbr_ready() then return

    val p = prh_tree(prh_no_child_program + prh_runtime_core)
    val (said, out) = prh_build(p)

    assert(said.0 != 0, "built with the process hooks unanswered")
    assert(said.1.contains(s"error: this program reaches 'sysl.process', and '$prh_target' has no " +
        "operating system under it for the standard library to answer a process or a user with, so " +
        "the program answers it: define 'sysl_proc_get_id', 'sysl_proc_pipe' with '@export'"), said.1)
    assert(!said.1.contains("sysl_fs_unlink"), said.1)

    lbr_drop([p, out])
end prh_no_child_unanswered

// The text handed to the back end, where an optimizer cannot have folded a destructor away: a program
// that makes a `Child` names `Child.drop` (defined, or declared where the library is precompiled),
// and one that never does names none.
@test("Child's destructor is in the program that makes a Child and in no other")
prh_child_drop_follows_the_type()
    if !lbr_ready() then return

    val with_child = prh_tree(prh_program + prh_runtime + prh_hooks)
    val made = lbr_cli(["sysl", "emit-llvm", "--target", prh_target, with_child])
    val without = prh_tree(prh_no_child_program + prh_runtime_core + prh_no_child_hooks)
    val never = lbr_cli(["sysl", "emit-llvm", "--target", prh_target, without])

    lbr_drop([with_child, without])
    assert(made.0 == 0, made.1)
    assert(never.0 == 0, never.1)
    assert(made.1.contains("void @sysl.process$Child.drop("), made.1)
    assert(!never.1.contains("Child.drop"), never.1)
end prh_child_drop_follows_the_type
