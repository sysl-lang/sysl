@test("a call on a trait object reads its table, loads the slot, and puts the data word in front")
a_call_through_a_table_loads_the_slot_and_passes_the_data_word()
    if no_str_library() then return

    assert_eq(str_lowered(
                  "trait Shape\n" +
                  "    area(self) -> int\n" +
                  "    name(*self) -> int\n" +
                  "\n" +
                  "struct Sq\n" +
                  "    n: int\n" +
                  "\n" +
                  "impl Shape for Sq\n" +
                  "    area(self) -> int = self.n * self.n\n" +
                  "    name(*self) -> int = self.n\n" +
                  "\n" +
                  "use(s: *Shape) -> int = s.area() + s.name()\n" +
                  "main()\n" +
                  "    var q = Sq(3)\n" +
                  "\n" +
                  "    print(use(&q))\n",
              "use"),
              "define i32 @use({ ptr, ptr } %s.param) {\n" +
              "entry:\n" +
              "  %s.addr = alloca { ptr, ptr }\n" +
              "  store { ptr, ptr } %s.param, ptr %s.addr\n" +
              "  %t1 = load { ptr, ptr }, ptr %s.addr\n" +
              "  %t2 = extractvalue { ptr, ptr } %t1, 0\n" +
              "  %t3 = extractvalue { ptr, ptr } %t1, 1\n" +
              "  %t4 = getelementptr { i64, [0 x ptr] }, ptr %t2, i32 0, i32 1, i64 0\n" +
              "  %t5 = load ptr, ptr %t4\n" +
              "  %t6 = call i32 %t5(ptr %t3)\n" +
              "  %t7 = load { ptr, ptr }, ptr %s.addr\n" +
              "  %t8 = extractvalue { ptr, ptr } %t7, 0\n" +
              "  %t9 = extractvalue { ptr, ptr } %t7, 1\n" +
              "  %t10 = getelementptr { i64, [0 x ptr] }, ptr %t8, i32 0, i32 1, i64 1\n" +
              "  %t11 = load ptr, ptr %t10\n" +
              "  %t12 = call i32 %t11(ptr %t9)\n" +
              "  %t13 = add i32 %t6, %t12\n" +
              "  ret i32 %t13\n" +
              "}\n")
end a_call_through_a_table_loads_the_slot_and_passes_the_data_word

@test("a slot whose implementation wants its receiver by value gets an adapter that loads it")
a_by_value_receiver_reaches_the_implementation_through_an_adapter()
    if no_str_library() then return

    assert_eq(str_lowered(
                  "trait Shape\n" +
                  "    area(self) -> int\n" +
                  "    name(*self) -> int\n" +
                  "\n" +
                  "struct Sq\n" +
                  "    n: int\n" +
                  "\n" +
                  "impl Shape for Sq\n" +
                  "    area(self) -> int = self.n * self.n\n" +
                  "    name(*self) -> int = self.n\n" +
                  "\n" +
                  "use(s: *Shape) -> int = s.area() + s.name()\n" +
                  "main()\n" +
                  "    var q = Sq(3)\n" +
                  "\n" +
                  "    print(use(&q))\n",
              "vt.adapt.Sq.area"),
              "define private i32 @vt.adapt.Sq.area(ptr %d) {\n" +
              "entry:\n" +
              "  %t1 = load %struct.Sq, ptr %d\n" +
              "  %t2 = call i32 @Sq.area(%struct.Sq %t1)\n" +
              "  ret i32 %t2\n" +
              "}\n")
end a_by_value_receiver_reaches_the_implementation_through_an_adapter

@test("str of a type with a Display writes into a growable buffer and finishes with its bytes")
a_value_renders_into_a_zeroed_stack_slot()
    if no_str_library() then return

    assert_eq(str_lowered(
                  "struct Pt\n" +
                  "    x: int\n" +
                  "    y: int\n" +
                  "\n" +
                  "impl Display for Pt\n" +
                  "    display(self, out: *Writer, spec: FormatSpec)\n" +
                  "        out.write(\"pt\".bytes)\n" +
                  "\n" +
                  "shown(p: Pt) -> string = str(p)\n" +
                  "main() = prints(shown(Pt(1, 2)))\n",
              "shown"),
              "define { ptr, ptr, i64 } @shown(%struct.Pt %p.param) {\n" +
              "entry:\n" +
              "  %p.addr = alloca %struct.Pt\n" +
              "  %t5 = alloca { ptr, i64, i64 }\n" +
              "  store %struct.Pt %p.param, ptr %p.addr\n" +
              "  %t1 = load %struct.Pt, ptr %p.addr\n" +
              "  %t2 = insertvalue %struct.sysl\u{24}FormatSpec undef, i32 0, 0\n" +
              "  %t3 = insertvalue %struct.sysl\u{24}FormatSpec %t2, i32 -1, 1\n" +
              "  %t4 = insertvalue %struct.sysl\u{24}FormatSpec %t3, i1 0, 2\n" +
              "  store { ptr, i64, i64 } zeroinitializer, ptr %t5\n" +
              "  %t6 = insertvalue { ptr, ptr } undef, ptr @sysl.vt.buf, 0\n" +
              "  %t7 = insertvalue { ptr, ptr } %t6, ptr %t5, 1\n" +
              "  call void @Pt.display(%struct.Pt %t1, { ptr, ptr } %t7, %struct.sysl\u{24}FormatSpec %t4)\n" +
              "  %t8 = call { ptr, ptr, i64 } @sysl.w.buf.finish(ptr %t5)\n" +
              "  %t9 = extractvalue { ptr, ptr, i64 } %t8, 0\n" +
              "  call void @arc.retain_maybe(ptr %t9)\n" +
              "  %t10 = extractvalue { ptr, ptr, i64 } %t8, 0\n" +
              "  call void @arc.release_maybe(ptr %t10)\n" +
              "  ret { ptr, ptr, i64 } %t8\n" +
              "}\n")
end a_value_renders_into_a_zeroed_stack_slot

@test("on failure a '?' returns at once with the error re-wrapped in this function's own result")
a_question_mark_returns_the_failure_rewrapped()
    if no_str_library() then return

    assert_eq(str_lowered(
                  "half(n: int) -> Result[int, string]\n" +
                  "    if n % 2 == 0 then Ok(n / 2) else Err(\"odd\")\n" +
                  "\n" +
                  "use(n: int) -> Result[int, string]\n" +
                  "    val v = half(n)?\n" +
                  "\n" +
                  "    Ok(v + 1)\n" +
                  "main() = print(use(4).unwrap())\n",
              "use"),
              "define %enum.sysl\u{24}Result.int.string @use(i32 %n.param) {\n" +
              "entry:\n" +
              "  %n.addr = alloca i32\n" +
              "  %v.addr = alloca i32\n" +
              "  %t5 = alloca %enum.sysl\u{24}Result.int.string\n" +
              "  store i32 %n.param, ptr %n.addr\n" +
              "  %t1 = load i32, ptr %n.addr\n" +
              "  %t2 = call %enum.sysl\u{24}Result.int.string @half(i32 %t1)\n" +
              "  %t3 = extractvalue %enum.sysl\u{24}Result.int.string %t2, 0\n" +
              "  %t4 = icmp eq i32 %t3, 0\n" +
              "  br i1 %t4, label %try.ok1, label %try.fail2\n" +
              "try.fail2:\n" +
              "  store %enum.sysl\u{24}Result.int.string %t2, ptr %t5\n" +
              "  %t6 = getelementptr %enum.sysl\u{24}Result.int.string, ptr %t5, i32 0, i32 1\n" +
              "  %t7 = load %sysl\u{24}Result.int.string.Err, ptr %t6\n" +
              "  %t8 = extractvalue %sysl\u{24}Result.int.string.Err %t7, 0\n" +
              "  %t9 = insertvalue %sysl\u{24}Result.int.string.Err undef, { ptr, ptr, i64 } %t8, 0\n" +
              "  store i32 1, ptr %t5\n" +
              "  %t10 = getelementptr %enum.sysl\u{24}Result.int.string, ptr %t5, i32 0, i32 1\n" +
              "  store %sysl\u{24}Result.int.string.Err %t9, ptr %t10\n" +
              "  %t11 = load %enum.sysl\u{24}Result.int.string, ptr %t5\n" +
              "  call void @arc.copy.sysl\u{24}Result.int.string(%enum.sysl\u{24}Result.int.string %t11)\n" +
              "  call void @arc.dispose.sysl\u{24}Result.int.string(%enum.sysl\u{24}Result.int.string %t2)\n" +
              "  ret %enum.sysl\u{24}Result.int.string %t11\n" +
              "try.ok1:\n" +
              "  store %enum.sysl\u{24}Result.int.string %t2, ptr %t5\n" +
              "  %t12 = getelementptr %enum.sysl\u{24}Result.int.string, ptr %t5, i32 0, i32 1\n" +
              "  %t13 = load %sysl\u{24}Result.int.string.Ok, ptr %t12\n" +
              "  %t14 = extractvalue %sysl\u{24}Result.int.string.Ok %t13, 0\n" +
              "  store i32 %t14, ptr %v.addr\n" +
              "  call void @arc.dispose.sysl\u{24}Result.int.string(%enum.sysl\u{24}Result.int.string %t2)\n" +
              "  %t15 = load i32, ptr %v.addr\n" +
              "  %t16 = add i32 %t15, 1\n" +
              "  %t17 = insertvalue %sysl\u{24}Result.int.string.Ok undef, i32 %t16, 0\n" +
              "  store i32 0, ptr %t5\n" +
              "  %t18 = getelementptr %enum.sysl\u{24}Result.int.string, ptr %t5, i32 0, i32 1\n" +
              "  store %sysl\u{24}Result.int.string.Ok %t17, ptr %t18\n" +
              "  %t19 = load %enum.sysl\u{24}Result.int.string, ptr %t5\n" +
              "  call void @arc.copy.sysl\u{24}Result.int.string(%enum.sysl\u{24}Result.int.string %t19)\n" +
              "  ret %enum.sysl\u{24}Result.int.string %t19\n" +
              "}\n")
end a_question_mark_returns_the_failure_rewrapped

@test("where the two error types differ a '?' calls the conversion and retains nothing after it")
a_converted_failure_arrives_owned()
    if no_str_library() then return

    assert_eq(str_lowered(
                  "struct Mine\n" +
                  "    n: int\n" +
                  "\n" +
                  "impl From[string] for Mine\n" +
                  "    from(s: string) -> Mine = Mine(int(s.len))\n" +
                  "\n" +
                  "half(n: int) -> Result[int, string]\n" +
                  "    if n % 2 == 0 then Ok(n / 2) else Err(\"odd\")\n" +
                  "\n" +
                  "widen(n: int) -> Result[int, Mine]\n" +
                  "    val v = half(n)?\n" +
                  "\n" +
                  "    Ok(v)\n" +
                  "main() = print(widen(4).unwrap())\n",
              "widen"),
              "define %enum.sysl\u{24}Result.int.Mine @widen(i32 %n.param) {\n" +
              "entry:\n" +
              "  %n.addr = alloca i32\n" +
              "  %v.addr = alloca i32\n" +
              "  %t5 = alloca %enum.sysl\u{24}Result.int.string\n" +
              "  %t11 = alloca %enum.sysl\u{24}Result.int.Mine\n" +
              "  store i32 %n.param, ptr %n.addr\n" +
              "  %t1 = load i32, ptr %n.addr\n" +
              "  %t2 = call %enum.sysl\u{24}Result.int.string @half(i32 %t1)\n" +
              "  %t3 = extractvalue %enum.sysl\u{24}Result.int.string %t2, 0\n" +
              "  %t4 = icmp eq i32 %t3, 0\n" +
              "  br i1 %t4, label %try.ok1, label %try.fail2\n" +
              "try.fail2:\n" +
              "  store %enum.sysl\u{24}Result.int.string %t2, ptr %t5\n" +
              "  %t6 = getelementptr %enum.sysl\u{24}Result.int.string, ptr %t5, i32 0, i32 1\n" +
              "  %t7 = load %sysl\u{24}Result.int.string.Err, ptr %t6\n" +
              "  %t8 = extractvalue %sysl\u{24}Result.int.string.Err %t7, 0\n" +
              "  %t9 = call %struct.Mine @Mine.from({ ptr, ptr, i64 } %t8)\n" +
              "  %t10 = insertvalue %sysl\u{24}Result.int.Mine.Err undef, %struct.Mine %t9, 0\n" +
              "  store i32 1, ptr %t11\n" +
              "  %t12 = getelementptr %enum.sysl\u{24}Result.int.Mine, ptr %t11, i32 0, i32 1\n" +
              "  store %sysl\u{24}Result.int.Mine.Err %t10, ptr %t12\n" +
              "  %t13 = load %enum.sysl\u{24}Result.int.Mine, ptr %t11\n" +
              "  call void @arc.dispose.sysl\u{24}Result.int.string(%enum.sysl\u{24}Result.int.string %t2)\n" +
              "  ret %enum.sysl\u{24}Result.int.Mine %t13\n" +
              "try.ok1:\n" +
              "  store %enum.sysl\u{24}Result.int.string %t2, ptr %t5\n" +
              "  %t14 = getelementptr %enum.sysl\u{24}Result.int.string, ptr %t5, i32 0, i32 1\n" +
              "  %t15 = load %sysl\u{24}Result.int.string.Ok, ptr %t14\n" +
              "  %t16 = extractvalue %sysl\u{24}Result.int.string.Ok %t15, 0\n" +
              "  store i32 %t16, ptr %v.addr\n" +
              "  call void @arc.dispose.sysl\u{24}Result.int.string(%enum.sysl\u{24}Result.int.string %t2)\n" +
              "  %t17 = load i32, ptr %v.addr\n" +
              "  %t18 = insertvalue %sysl\u{24}Result.int.Mine.Ok undef, i32 %t17, 0\n" +
              "  store i32 0, ptr %t11\n" +
              "  %t19 = getelementptr %enum.sysl\u{24}Result.int.Mine, ptr %t11, i32 0, i32 1\n" +
              "  store %sysl\u{24}Result.int.Mine.Ok %t18, ptr %t19\n" +
              "  %t20 = load %enum.sysl\u{24}Result.int.Mine, ptr %t11\n" +
              "  ret %enum.sysl\u{24}Result.int.Mine %t20\n" +
              "}\n")
end a_converted_failure_arrives_owned

@test("a '?' on an Option returns None at once rather than a re-wrapped payload")
an_option_question_mark_returns_none()
    if no_str_library() then return

    assert_eq(str_lowered(
                  "pick(n: int) -> Option[int]\n" +
                  "    if n > 0 then Some(n) else None\n" +
                  "\n" +
                  "chain(n: int) -> Option[int]\n" +
                  "    val v = pick(n)?\n" +
                  "\n" +
                  "    Some(v + 1)\n" +
                  "main() = print(chain(1).unwrap())\n",
              "chain"),
              "define %enum.sysl\u{24}Option.int @chain(i32 %n.param) {\n" +
              "entry:\n" +
              "  %n.addr = alloca i32\n" +
              "  %v.addr = alloca i32\n" +
              "  %t6 = alloca %enum.sysl\u{24}Option.int\n" +
              "  store i32 %n.param, ptr %n.addr\n" +
              "  %t1 = load i32, ptr %n.addr\n" +
              "  %t2 = call %enum.sysl\u{24}Option.int @pick(i32 %t1)\n" +
              "  %t3 = extractvalue %enum.sysl\u{24}Option.int %t2, 0\n" +
              "  %t4 = icmp eq i32 %t3, 0\n" +
              "  br i1 %t4, label %try.ok1, label %try.fail2\n" +
              "try.fail2:\n" +
              "  %t5 = insertvalue %enum.sysl\u{24}Option.int undef, i32 1, 0\n" +
              "  ret %enum.sysl\u{24}Option.int %t5\n" +
              "try.ok1:\n" +
              "  store %enum.sysl\u{24}Option.int %t2, ptr %t6\n" +
              "  %t7 = getelementptr %enum.sysl\u{24}Option.int, ptr %t6, i32 0, i32 1\n" +
              "  %t8 = load %sysl\u{24}Option.int.Some, ptr %t7\n" +
              "  %t9 = extractvalue %sysl\u{24}Option.int.Some %t8, 0\n" +
              "  store i32 %t9, ptr %v.addr\n" +
              "  %t10 = load i32, ptr %v.addr\n" +
              "  %t11 = add i32 %t10, 1\n" +
              "  %t12 = insertvalue %sysl\u{24}Option.int.Some undef, i32 %t11, 0\n" +
              "  store i32 0, ptr %t6\n" +
              "  %t13 = getelementptr %enum.sysl\u{24}Option.int, ptr %t6, i32 0, i32 1\n" +
              "  store %sysl\u{24}Option.int.Some %t12, ptr %t13\n" +
              "  %t14 = load %enum.sysl\u{24}Option.int, ptr %t6\n" +
              "  ret %enum.sysl\u{24}Option.int %t14\n" +
              "}\n")
end an_option_question_mark_returns_none

@test("a write that could break a struct's invariant re-reads the struct and traps on false")
a_write_through_a_reference_rechecks_the_invariant()
    if no_str_library() then return

    assert_eq(str_lowered(
                  "struct Range\n" +
                  "    lo: int\n" +
                  "    hi: int\n" +
                  "\n" +
                  "    invariant lo <= hi\n" +
                  "\n" +
                  "bump(r: *Range)\n" +
                  "    r.hi += 1\n" +
                  "main()\n" +
                  "    var r = Range(1, 2)\n" +
                  "\n" +
                  "    bump(&r)\n" +
                  "    print(r.hi)\n",
              "bump"),
              "define void @bump(ptr %r.param) {\n" +
              "entry:\n" +
              "  %r.addr = alloca ptr\n" +
              "  store ptr %r.param, ptr %r.addr\n" +
              "  %t1 = load ptr, ptr %r.addr\n" +
              "  %t2 = getelementptr %struct.Range, ptr %t1, i32 0, i32 1\n" +
              "  %t3 = load i32, ptr %t2\n" +
              "  %t4 = add i32 %t3, 1\n" +
              "  store i32 %t4, ptr %t2\n" +
              "  %t5 = load ptr, ptr %r.addr\n" +
              "  %t6 = load %struct.Range, ptr %t5\n" +
              "  %t7 = extractvalue %struct.Range %t6, 0\n" +
              "  %t8 = extractvalue %struct.Range %t6, 1\n" +
              "  %t9 = call i1 @Range\u{24}inv(i32 %t7, i32 %t8)\n" +
              "  br i1 %t9, label %invariant.ok1, label %invariant.bad2\n" +
              "invariant.bad2:\n" +
              "  call void @llvm.trap()\n" +
              "  unreachable\n" +
              "invariant.ok1:\n" +
              "  ret void\n" +
              "}\n")
end a_write_through_a_reference_rechecks_the_invariant


// -- what a destructor is kept by -------------------------------------------------------------------

@test("a destructor is a root: nothing in the program names it, and the release hook calls it")
a_destructor_survives_pruning()
    if no_str_library() then return

    assert_eq(str_lowered(
                  "struct Env\n" +
                  "    n: int\n" +
                  "\n" +
                  "impl Drop for Env\n" +
                  "    drop(self)\n" +
                  "        print(\"env closed\")\n" +
                  "\n" +
                  "main()\n" +
                  "    var e: &Env = Env(7)\n" +
                  "\n" +
                  "    print(e.n)\n",
              "Env.drop"),
              "define void @Env.drop(%struct.Env %self.param) {\n" +
              "entry:\n" +
              "  %self.addr = alloca %struct.Env\n" +
              "  store %struct.Env %self.param, ptr %self.addr\n" +
              "  call void @sysl$prints({ ptr, ptr, i64 } { ptr null, ptr @.str1, i64 10 })\n" +
              "  call void @sysl$printc(i32 10)\n" +
              "  ret void\n" +
              "}\n")
end a_destructor_survives_pruning

// -- what a `?` and a rendering refuse ---------------------------------------------------------------

@test("a '?' across two error types with no conversion names the block that would join them")
a_try_with_no_conversion_names_the_impl()
    if no_str_library() then return

    assert_eq(str_refusal(
                  "half(n: int) -> Result[int, string]\n" +
                  "    if n % 2 == 0 then Ok(n / 2) else Err(\"odd\")\n" +
                  "\n" +
                  "widen(n: int) -> Result[int, bool]\n" +
                  "    val v = half(n)?\n" +
                  "\n" +
                  "    Ok(v)\n" +
                  "\n" +
                  "main() = print(widen(4).unwrap())\n"),
              "'?' propagates a string error, but this function returns bool — a '?' converts " +
              "through 'sysl.From', so 'impl From[string] for bool' is what joins the two layers")
end a_try_with_no_conversion_names_the_impl

@test("printing a type with no 'Display' names the block to write")
printing_without_a_display_names_the_impl()
    if no_str_library() then return

    assert_eq(str_refusal("struct Pt\n    x: int\n\nmain() = print(Pt(1))\n"),
              "cannot print a Pt value — write an 'impl sysl.Display for Pt' to say how it renders")
end printing_without_a_display_names_the_impl

@test("a generic type's advice names the block's own parameters, not this value's arguments")
a_generic_display_advice_names_its_parameters()
    if no_str_library() then return

    assert_eq(str_refusal("struct Box[T]\n    v: T\n\nmain() = print(Box(1))\n"),
              "cannot print a Box[int] value — write an 'impl[T] sysl.Display for Box[T]' to say " +
              "how it renders")
end a_generic_display_advice_names_its_parameters

@test("making a string of a type with no 'Display' names the same block")
str_without_a_display_names_the_impl()
    if no_str_library() then return

    assert_eq(str_refusal("struct Pt\n    x: int\n\nmain() = prints(str(Pt(1)))\n"),
              "cannot make a string of a Pt value — write an 'impl sysl.Display for Pt' to say " +
              "how it renders")
end str_without_a_display_names_the_impl

@test("an object whose trait does not require 'Display' names the trait clause to widen")
an_object_without_display_names_the_bound()
    if no_str_library() then return

    assert_eq(str_refusal(
                  "trait Shape\n" +
                  "    area(self) -> int\n" +
                  "\n" +
                  "struct Sq\n" +
                  "    n: int\n" +
                  "\n" +
                  "impl Shape for Sq\n" +
                  "    area(self) -> int = self.n\n" +
                  "\n" +
                  "show(s: *Shape) = print(s)\n" +
                  "\n" +
                  "main()\n" +
                  "    var q = Sq(3)\n" +
                  "\n" +
                  "    show(&q)\n"),
              "cannot print a *Shape value — an object offers what its trait declares and what " +
              "that trait requires, so write 'trait Shape: sysl.Display' to keep the rendering " +
              "the value had before it was erased")
end an_object_without_display_names_the_bound

// -- the three parts a Display implementation is handed ----------------------------------------------

// A `0` is a flag and a digit both, and the flags are taken first, so `%08.2f` is width 8. A width of
// `0` and a precision of `-1` are what "neither was written" reads as, which is the only way `%s` and
// `%.0s` are told apart. Each row was read off the reference's `FormatSpec.parts`.
@test("a specifier's width, precision and justification")
the_parts_of_a_specifier()
    assert_eq(shown_parts("%s"), "0/-1/false", "nothing written")
    assert_eq(shown_parts("%.0s"), "0/0/false", "a precision of none is not no precision")
    assert_eq(shown_parts("%.3s"), "0/3/false", "a precision alone")
    assert_eq(shown_parts("%12s"), "12/-1/false", "a width alone")
    assert_eq(shown_parts("%-12s"), "12/-1/true", "and left-justified")
    assert_eq(shown_parts("%20.3s"), "20/3/false", "both")
    assert_eq(shown_parts("%08.2f"), "8/2/false", "a leading zero is a flag, so the width is 8")
    assert_eq(shown_parts("%0s"), "0/-1/false", "a lone zero is that flag and no width at all")
    assert_eq(shown_parts("%+ #10.4g"), "10/4/false", "every flag, none of them '-'")
end the_parts_of_a_specifier

private shown_parts(spec: string) -> string
    val p = spec_parts(spec)

    s"${p.0}/${p.1}/${p.2}"
end shown_parts
