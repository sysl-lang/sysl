module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.math.bigint.{BigInt, add, div_rem, from_int, mul, shl as big_shl, shr as big_shr, from_u64, to_u64}

// **The bytes a value is laid out in, while compiling.** The evaluator holds values, not memory, so
// a read through a pointer converted to another type (`ptr_cast[*u32](&bytes[0])`) is answered by
// laying the values it reaches out as the target lays them -- each scalar its width in bytes, in the
// target's byte order, an array its elements one after another -- and reading the bytes the read
// covers back as the type it reads. A write is the same in reverse. What has a layout here is the
// types whose bytes are their value: an integer of a width that is a power of two from eight bits
// up, a float, a `bool`, a `char`, and a fixed array of any of them. A struct, an enum, a pointer and
// anything that holds one is not, its padding and its addresses being the program's own.

// How many bytes a value of `t` is laid out in, or `None` where the evaluator does not lay it out.
laid_size(t: Type) -> Option[usize] = underlying(t) match
    Integer(bits, _, _) -> if bits >= 8 && (bits & (bits - 1)) == 0 then Some(usize(bits / 8)) else None
    Floating(bits, _) -> Some(usize(bits / 8))
    Bool -> Some(1)
    Char -> Some(4)
    Array(n, elem, _) -> laid_size(*elem).map(each -> usize(n) * each)
    _ -> None

// Whether `t` has bit patterns that are not values -- a `bool` other than 0 or 1, a `char` that is
// no scalar value -- so bytes written over one could leave what the program cannot hold.
laid_has_invalid(t: Type) -> bool = underlying(t) match
    Bool -> true
    Char -> true
    Array(_, elem, _) -> laid_has_invalid(*elem)
    _ -> false

// `v`, a value of `t`, laid out at the end of `out` in the byte order `little` names. False where `t`
// has no layout here or `v` is not a value of it.
laid_bytes(v: Const, t: Type, little: bool, out: Buf[u8]) -> bool = (v, underlying(t)) match
    (ConstInt(n), Integer(bits, _, _)) -> laid_int(n, bits, little, out)
    (ConstBool(b), Bool) -> laid_int(from_int(if b then 1 else 0), 8, little, out)
    (ConstChar(c), Char) -> laid_int(from_int(long(u32(c))), 32, little, out)
    (ConstFloat(f), Floating(64, _)) -> laid_int(from_u64(f.bits()), 64, little, out)
    (ConstFloat(f), Floating(32, _)) -> laid_int(from_u64(u64(f32(f).bits())), 32, little, out)
    (ConstFloat(f), Floating(16, brain)) ->
        laid_int(from_u64(u64(if brain then bf16(f).bits() else f16(f).bits())), 16, little, out)
    (ConstQuad(hi, lo), Floating(128, _)) -> laid_int(add(big_shl(from_u64(hi), 64), from_u64(lo)), 128, little, out)
    (ConstArray(xs), Array(n, elem, _)) -> laid_elements(xs, n, *elem, little, out)
    _ -> false

private laid_elements(xs: Buf[Const], n: int, elem: Type, little: bool, out: Buf[u8]) -> bool
    if xs.len() != usize(n) then return false

    for x in xs
        if !laid_bytes(x, elem, little, out) then return false

    true

// The low `bits` of `n`, as two's complement, in `bits / 8` bytes.
private laid_int(n: BigInt, bits: int, little: bool, out: Buf[u8]) -> bool
    var raw = wrap(n, bits, false)
    val unit = from_int(256)
    var low_first: Buf[u8] = buf()

    for _ in 0..<(bits / 8)
        val q = div_rem(raw, unit)

        low_first.push(u8(q.1.to_long().unwrap_or(0)))
        raw = q.0

    for i in 0..<low_first.len()
        out.push(low_first[if little then i else low_first.len() - 1 - i])

    true
end laid_int

// The value of `t` laid out in `bytes` from `from`, in the byte order `little` names: `None` where `t`
// has no layout here, the bytes run out, or they are no value of `t` (a `bool` byte other than 0 or
// 1, a `char` that is no scalar value).
value_of_bytes(bytes: Buf[u8], from: usize, t: Type, little: bool) -> Option[Const]
    val size = laid_size(t) match
        Some(n) -> n
        None -> return None

    if from + size > bytes.len() then return None

    underlying(t) match
        Integer(bits, signed, _) -> Some(ConstInt(wrap(int_of_bytes(bytes, from, size, little), bits, signed)))
        Bool ->
            val b = bytes[from]

            if b > 1 then None else Some(ConstBool(b == 1))
        Char ->
            val u = to_u64(int_of_bytes(bytes, from, 4, little)).unwrap_or(0xFFFFFFFF)

            if u > 0x10FFFF || (u >= 0xD800 && u <= 0xDFFF) then None else Some(ConstChar(char(u32(u))))
        Floating(128, _) ->
            val n = int_of_bytes(bytes, from, 16, little)
            val hi = to_u64(big_shr(n, 64)).unwrap_or(0)
            val lo = to_u64(wrap(n, 64, false)).unwrap_or(0)

            Some(ConstQuad(hi, lo))
        Floating(bits, brain) ->
            val u = to_u64(int_of_bytes(bytes, from, size, little)).unwrap_or(0)

            bits match
                64 -> Some(ConstFloat(real.from_bits(u)))
                32 -> Some(ConstFloat(real(f32.from_bits(u32(u)))))
                _ -> Some(ConstFloat(if brain then real(bf16.from_bits(u16(u))) else real(f16.from_bits(u16(u)))))
        Array(n, elem, _) ->
            val each = laid_size(*elem).unwrap_or(0)
            var out: Buf[Const] = buf()

            for i in 0..<usize(n)
                out.push(value_of_bytes(bytes, from + i * each, *elem, little)?)

            Some(ConstArray(out))
        _ -> None
end value_of_bytes

// `size` bytes from `from` read as one unsigned number.
private int_of_bytes(bytes: Buf[u8], from: usize, size: usize, little: bool) -> BigInt
    var n = from_int(0)
    val unit = from_int(256)

    for i in 0..<size
        val b = bytes[from + (if little then size - 1 - i else i)]

        n = add(mul(n, unit), from_int(long(b)))

    n
end int_of_bytes
