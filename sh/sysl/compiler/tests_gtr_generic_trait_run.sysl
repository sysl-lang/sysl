module sh.sysl.compiler
@tests

import sysl.text.Search

// A trait may take type parameters of its own, so what it promises is fixed by the implementation
// rather than by the trait alone: `trait Sink[T]` is a different promise for every `T`, and an
// `impl Sink[int] for A` says which one an `A` makes. The three places a trait is named all take the
// arguments the same way -- a bound (`[X: Sink[int]]`), an implementation (`impl Sink[int] for A`)
// and a trait object (`&Sink[int]`) -- and these run programs through each of them. Ported from the
// reference's `GenericTraitRunTests.scala` case for case.
//
// **Every output and every line of LLVM text here was read out of the reference compiler (0.0.159)**
// by handing the installed `sysl` the same program (`sysl run`, `sysl emit-llvm`). The harness is
// `tests_xvr_extern_var.sysl`'s: `xvr_ran` builds, links and runs a tree, `xvr_ir` lowers one.

private gtr_ran(text: string) -> string = xvr_ran([("main.sysl", text)])

private gtr_ir(text: string) -> string = xvr_ir([("main.sysl", text)])

// -- an implementation says which promise it makes ------------------------------------------------

@test("a method takes the type the implementation fixed")
gtr_method_takes_the_fixed_type()
    if xvr_no_library() then return

    assert_eq(gtr_ran(raw"""
        trait Sink[T]
            put(self, x: T) -> string
        struct A
            tag: int
        impl Sink[int] for A
            put(self, x: int) -> string = f"A${x}"
        print(A(0).put(3))
        """), "A3\n")

@test("two types implement one trait at two different arguments")
gtr_two_types_two_arguments()
    if xvr_no_library() then return

    assert_eq(gtr_ran(raw"""
        trait Sink[T]
            put(self, x: T) -> string
        struct A
            tag: int
        struct B
            tag: int
        impl Sink[int] for A
            put(self, x: int) -> string = f"A${x}"
        impl Sink[string] for B
            put(self, x: string) -> string = f"B${x}"
        print(A(0).put(3))
        print(B(0).put("z"))
        """), "A3\nBz\n")

@test("a trait takes more than one parameter")
gtr_more_than_one_parameter()
    if xvr_no_library() then return

    assert_eq(gtr_ran(raw"""
        trait Pairing[A, B]
            left(self) -> A
            right(self) -> B
        struct P
            n: int
        impl Pairing[int, string] for P
            left(self) -> int = self.n
            right(self) -> string = "r"
        var p = P(4)
        print(p.left())
        print(p.right())
        """), "4\nr\n")

@test("the argument may itself be a generic type")
gtr_argument_is_a_generic_type()
    if xvr_no_library() then return

    assert_eq(gtr_ran(raw"""
        trait Get[T]
            get(self) -> T
        struct Box[U]
            v: U
        struct W
            tag: int
        impl Get[Box[int]] for W
            get(self) -> Box[int] = Box(11)
        print(W(0).get().v)
        """), "11\n")

@test("a member may write its signature in the trait's own parameter name")
gtr_member_writes_the_trait_parameter()
    if xvr_no_library() then return

    assert_eq(gtr_ran(raw"""
        trait Tag[T]
            tag(self, x: T) -> T
        struct C
            v: int
        impl Tag[int] for C
            tag(self, x: T) -> T = x + 1
        print(C(0).tag(4))
        """), "5\n")

@test("a property is asked for at the implementation's argument")
gtr_property_at_the_argument()
    if xvr_no_library() then return

    assert_eq(gtr_ran(raw"""
        trait Sized[T]
            size -> T
        struct S
            v: int
        impl Sized[int] for S
            size -> int = 3
        print(S(0).size)
        """), "3\n")

// -- a bound names the trait at the arguments it wants --------------------------------------------

@test("a bounded body calls the method at those arguments")
gtr_bounded_body_calls_the_method()
    if xvr_no_library() then return

    assert_eq(gtr_ran(raw"""
        trait Into[T]
            into(self) -> T
        struct P
            v: int
        impl Into[int] for P
            into(self) -> int = self.v
        take[X: Into[int]](x: X) -> int = x.into()
        print(take(P(7)))
        """), "7\n")

@test("a bounded body reads a property through one")
gtr_bounded_body_reads_a_property()
    if xvr_no_library() then return

    assert_eq(gtr_ran(raw"""
        trait Sized[T]
            size -> T
        struct S
            v: int
        impl Sized[int] for S
            size -> int = 3
        big[X: Sized[int]](x: X) -> int = x.size + 1
        print(big(S(0)))
        """), "4\n")

@test("one of the declaration's own parameters may be the trait's argument")
gtr_own_parameter_is_the_argument()
    if xvr_no_library() then return

    assert_eq(gtr_ran(raw"""
        trait Into[T]
            into(self) -> T
        struct P
            v: int
        impl Into[int] for P
            into(self) -> int = self.v
        conv[X: Into[Y], Y](x: X) -> Y = x.into()
        var n: int = conv(P(5))
        print(n)
        """), "5\n")

@test("what a bound's argument yields carries its own bounds")
gtr_argument_carries_its_own_bounds()
    if xvr_no_library() then return

    assert_eq(gtr_ran(raw"""
        trait Into[T]
            into(self) -> T
        struct P
            v: int
        impl Into[int] for P
            into(self) -> int = self.v
        show[X: Into[Y], Y: Display](x: X) -> Y
            var y = x.into()
            print(y)
            y
        var n: int = show(P(6))
        print(n)
        """), "6\n6\n")

@test("a type's own parameters may be bounded by a generic trait")
gtr_type_parameter_bounded_by_generic_trait()
    if xvr_no_library() then return

    assert_eq(gtr_ran(raw"""
        trait Into[T]
            into(self) -> T
        struct P
            v: int
        impl Into[int] for P
            into(self) -> int = self.v
        struct Holder[X: Into[int]]
            item: X
            number(self) -> int = self.item.into()
        print(Holder(P(8)).number())
        """), "8\n")

// -- a trait object carries the arguments too ----------------------------------------------------

@test("a method dispatches through the table at the implementation's argument")
gtr_object_dispatches_at_the_argument()
    if xvr_no_library() then return

    assert_eq(gtr_ran(raw"""
        trait Sink[T]
            put(self, x: T) -> string
        struct A
            tag: int
        impl Sink[int] for A
            put(self, x: int) -> string = f"A${x}"
        var u: &Sink[int] = A(0)
        print(u.put(1))
        """), "A1\n")

@test("two objects at two arguments live side by side")
gtr_two_objects_two_arguments()
    if xvr_no_library() then return

    assert_eq(gtr_ran(raw"""
        trait Sink[T]
            put(self, x: T) -> string
        struct A
            tag: int
        struct B
            tag: int
        impl Sink[int] for A
            put(self, x: int) -> string = f"A${x}"
        impl Sink[string] for B
            put(self, x: string) -> string = f"B${x}"
        var u: &Sink[int] = A(0)
        var v: &Sink[string] = B(0)
        print(u.put(1))
        print(v.put("q"))
        """), "A1\nBq\n")

@test("a property is read through the table")
gtr_object_reads_a_property()
    if xvr_no_library() then return

    assert_eq(gtr_ran(raw"""
        trait Sized[T]
            size -> T
        struct S
            v: int
        impl Sized[int] for S
            size -> int = 3
        var o: &Sized[int] = S(0)
        print(o.size)
        """), "3\n")

@test("an object over a generic trait in a loop neither leaks nor frees twice")
gtr_object_in_a_loop()
    if xvr_no_library() then return

    assert_eq(gtr_ran(raw"""
        trait Sink[T]
            put(self, x: T) -> int
        struct A
            base: int
        impl Sink[int] for A
            put(self, x: int) -> int = self.base + x
        var total = 0
        for i in 0..<100
            var s: &Sink[int] = A(i)
            total = total + s.put(1)
        print(total)
        """), "5050\n")

// -- a default answers as well as a signature does ------------------------------------------------

@test("a default body calls the trait's own method")
gtr_default_calls_the_trait_method()
    if xvr_no_library() then return

    assert_eq(gtr_ran(raw"""
        trait Tag[T]
            tag(self) -> T
            twice(self) -> T = self.tag()
        struct Q
            v: int
        impl Tag[int] for Q
            tag(self) -> int = self.v
        print(Q(9).twice())
        """), "9\n")

@test("a default's parameters are the trait's, at the implementation's arguments")
gtr_default_parameters_at_the_arguments()
    if xvr_no_library() then return

    assert_eq(gtr_ran(raw"""
        trait Tag[T]
            tag(self) -> T
            pick(self, other: T) -> T = other
        struct Q
            v: int
        impl Tag[int] for Q
            tag(self) -> int = self.v
        print(Q(9).pick(2))
        """), "2\n")

@test("a generic type inherits one")
gtr_generic_type_inherits_a_default()
    if xvr_no_library() then return

    assert_eq(gtr_ran(raw"""
        trait Tag[T]
            tag(self) -> T
            twice(self) -> T = self.tag()
        struct Box[U]
            v: U
        impl[U] Tag[int] for Box[U]
            tag(self) -> int = 5
        print(Box("x").twice())
        print(Box(1).twice())
        """), "5\n5\n")

// -- every kind of subject may implement one ------------------------------------------------------

@test("a generic type, as a whole")
gtr_generic_type_as_a_whole()
    if xvr_no_library() then return

    assert_eq(gtr_ran(raw"""
        trait Get[T]
            get(self) -> T
        struct Box[U]
            v: U
        impl[U] Get[int] for Box[U]
            get(self) -> int = 7
        print(Box("x").get())
        """), "7\n")

@test("a composed shape")
gtr_composed_shape()
    if xvr_no_library() then return

    assert_eq(gtr_ran(raw"""
        trait Count[T]
            howMany(self) -> T
        impl[E] Count[int] for []E
            howMany(self) -> int = int(self.len)
        var a = [1, 2, 3]
        print(a[0..<3].howMany())
        """), "3\n")

@test("a built-in")
gtr_built_in()
    if xvr_no_library() then return

    assert_eq(gtr_ran(raw"""
        trait Widen[T]
            wide(self) -> T
        impl Widen[long] for int
            wide(self) -> long = long(self) + long(self)
        var n = 21
        print(n.wide())
        """), "42\n")

@test("a generic type conditionally, on a bound of its own")
gtr_generic_type_conditionally()
    if xvr_no_library() then return

    assert_eq(gtr_ran(raw"""
        trait Show
            show(self) -> int
        trait Get[T]
            get(self) -> T
        struct Box[U]
            v: U
        impl[U: Show] Get[int] for Box[U]
            get(self) -> int = self.v.show()
        struct P
            v: int
        impl Show for P
            show(self) -> int = self.v
        print(Box(P(3)).get())
        """), "3\n")

@test("'Self' and the trait's parameter stand side by side")
gtr_self_beside_the_parameter()
    if xvr_no_library() then return

    assert_eq(gtr_ran(raw"""
        trait Dup[T]
            dup(self) -> Self
            key(self) -> T
        struct Box[U]
            v: U
        impl[U] Dup[int] for Box[U]
            dup(self) -> Self = self
            key(self) -> T = 8
        print(Box(2).dup().key())
        """), "8\n")

// -- what the arguments reach in the emitted module -----------------------------------------------

@test("a table is named for the trait at its arguments")
gtr_table_named_at_the_arguments()
    if xvr_no_library() then return

    val out = gtr_ir(raw"""
        trait Sink[T]
            put(self, x: T) -> int
        struct A
            tag: int
        impl Sink[int] for A
            put(self, x: int) -> int = x
        var u: &Sink[int] = A(0)
        print(u.put(1))
        """)

    assert(out.contains("@vt.ref.Sink.int.A = private constant"), out)

@test("the members themselves are named for the type alone, since a type implements a trait once")
gtr_members_named_for_the_type_alone()
    if xvr_no_library() then return

    val out = gtr_ir(raw"""
        trait Sink[T]
            put(self, x: T) -> int
        struct A
            tag: int
        impl Sink[int] for A
            put(self, x: int) -> int = x
        print(A(0).put(1))
        """)

    assert(out.contains("define i32 @A.put("), out)
    assert_eq(xvr_count(out, "\ndefine i32 @A.put("), 1)

@test("one implementation per generic type, whatever its arguments")
gtr_one_implementation_per_generic_type()
    if xvr_no_library() then return

    val out = gtr_ir(raw"""
        trait Get[T]
            get(self) -> T
        struct Box[U]
            v: U
        impl[U] Get[int] for Box[U]
            get(self) -> int = 7
        print(Box(1).get())
        print(Box("x").get())
        """)

    assert_eq(xvr_count(out, "\ndefine i32 @Box."), 2)
