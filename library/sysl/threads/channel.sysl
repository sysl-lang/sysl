module sysl.threads
@requires(os)

import sysl.sync.*
import sysl.container.ring.{Ring, ring}

/** A bounded queue two threads hand values across, and the one place the language's rule about what
 * may leave a concurrency domain is enforced on a *value* rather than on an address
 * (`library/sync.md`, `reference/memory.md § Crossing a concurrency domain`).
 *
 * **It is what `Thread.join` says it does not have.** Everything else in this module shares by
 * *address*: `spawn` hands the new thread a `*T`, `Mutex[T]` hands a holder a `*T`, and what crosses
 * is a pointer whose far end both threads are looking at. A channel is the other shape — a value
 * goes in on one thread and comes out on another, and the two are never looking at one object.
 *
 * **The storage is the caller's, which is this module's house style rather than a limitation.**
 * `Mutex[T]` wraps a value the caller built and `spawn` takes an address the caller has; a channel
 * takes the slots. What that buys is that the type needs no allocator, so a channel is available to a
 * program that has given the heap up, and its capacity is a number the program chose.
 *
 * ```
 * var slots: [8]int = [0; 8]
 * var ch = channel(slots[..])
 *
 * spawn(&producer, &ch)
 *
 * loop
 *     ch.receive() match
 *         Some(v) -> print(v)
 *         None -> break
 * ```
 *
 * **A waiter sleeps**: a full `send` waits on one `Condvar` and an empty `receive` on the other, each
 * woken by the transfer that makes room or brings a value, and both woken by `close`.
 *
 * **The copying half of the crossing rule is NOT built.** `reference/memory.md § Crossing a
 * concurrency domain` allows a channel to take a heap-backed view *because it copies the bytes*, and
 * this one does not copy: a slot is assigned, which is the same share the sender held. So a view is
 * refused here exactly as it is at `spawn`, and the relaxation waits on something that copies.
 */
struct Channel[T]

    // Guards the ring and the closed flag; the two condition variables are waited on under it.
    private lock: Lock
    private has_room: Condvar
    private has_value: Condvar

    // The values, in a bounded ring over the storage the caller supplied.
    //
    // **A `Ring[T]` holds a `*T` and a count rather than a `[]T`, and that is the crossing rule
    // rather than a preference.** A view owns its elements through a count that is not atomic, so a
    // struct holding one may not reach another domain at all — which would refuse the channel at the
    // `spawn` that shares it. A raw pointer carries no count, so it crosses; the caller writes a slice
    // at `channel(…)` and never sees the pointer.
    private ring: Ring[T]

    // One once `close` has been called. Written under the lock, so a waiter that checked it under the
    // lock cannot miss the close; read outside it by `is_closed`, which is why it is atomic.
    private closed: i32

    /** How many values the channel can hold at once, which is the storage it was given. */
    capacity(*self) -> usize = self.ring.capacity()

    /** How many values are waiting to be taken. Read under the lock, so it is a fact rather than a
     * hint — of the moment it was read, which is all any such number can be.
     */
    len(*self) -> usize
        self.lock.lock()

        val n = self.ring.len()

        self.lock.unlock()
        n

    /** Whether `close` has been called. Read outside the lock, so it is a **hint** except in the one
     * case that matters: a thread that closed the channel itself.
     */
    is_closed(*self) -> bool = atomic_load(&self.closed, Acquire) != 0

    /** Stops the channel taking anything further, and lets every waiter go.
     *
     * A receiver goes on taking what is already inside — closing says no more will arrive, not that
     * what arrived is discarded — and a sender is refused from here on. Closing twice is harmless.
     */
    close(*self)
        self.lock.lock()
        atomic_store(&self.closed, 1, Release)
        self.lock.unlock()

        self.has_room.notify_all()
        self.has_value.notify_all()
    end close

    // **`@crossing(value)` is what holds a caller to the rule about what may reach another domain**,
    // written above `send` and `try_send` -- the two operations that put a value in. Marking the way
    // *in* is the whole of the check: nothing can be taken out that was not put in, so a channel whose
    // sends are held to the rule can hold nothing that breaks it.

    /** Puts a value in, waiting while the channel is full, and answers whether it went in.
     *
     * `false` is a closed channel and nothing else: the wait is unbounded, so the only thing that
     * ends it other than a free slot is somebody closing.
     */
    @crossing(value)
    @blocks
    send(*self, value: T) -> bool
        self.lock.lock()

        loop
            if self.is_closed()
                self.lock.unlock()
                return false

            if self.ring.push_back(value)
                self.lock.unlock()
                self.has_value.notify_one()
                return true

            self.has_room.wait_raw(&self.lock)
    end send

    /** Puts a value in if there is room, and answers whether it went. Never waits. */
    @crossing(value)
    try_send(*self, value: T) -> bool
        self.lock.lock()

        val went = !self.is_closed() && self.ring.push_back(value)

        self.lock.unlock()

        if went then self.has_value.notify_one()

        went
    end try_send

    /** Takes a value out, waiting while the channel is empty.
     *
     * `None` means the channel is closed **and drained**, which is what makes a receiver's loop
     * terminate: a closed channel with values still in it goes on answering `Some`.
     */
    @blocks
    receive(*self) -> Option[T]
        self.lock.lock()

        loop
            self.ring.pop_front() match
                Some(v) ->
                    self.lock.unlock()
                    self.has_room.notify_one()
                    return Some(v)
                None ->
                    if self.is_closed()
                        self.lock.unlock()
                        return None

                    self.has_value.wait_raw(&self.lock)
    end receive

    /** Takes a value out if there is one, and answers nothing where there is not. Never waits. */
    try_receive(*self) -> Option[T]
        self.lock.lock()

        val out = self.ring.pop_front()

        self.lock.unlock()

        if out.is_some() then self.has_room.notify_one()

        out
    end try_receive

end Channel

/** Builds an empty channel over storage the caller supplies.
 *
 * A function rather than an associated `new`, because the element type is inferred from the slots:
 * `channel(slots[..])` says everything, where `Channel[int].new(…)` would say the element type twice.
 *
 * **The slice is read here and not kept**: what is stored is its address and its length, so that the
 * channel may cross a domain. The storage has to outlive every thread that holds the channel, which is
 * the same contract `spawn(&body, &state)` already has with whatever `state` points at.
 */
channel[T](slots: []T) -> Channel[T] = Channel(Lock.new(), Condvar.new(), Condvar.new(), ring(slots), 0)
