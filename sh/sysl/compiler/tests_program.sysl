module sh.sysl.compiler
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.Search

// What a source means **as a program**, with the standard module beside it.
//
// **These need the library**, and that is the whole reason they are a file of their own: `Eq`, `Ord`
// and the ten arithmetic traits are ordinary declarations of the standard module, a member the
// compiler provides reads its signature off a trait the library declares, and `s.chars` is a call to
// a function the library writes. A source compiled on its own has none of that. Every test here is a
// program -- the library's trees, then the source -- and every one of them says so and returns where
// the library is not on the machine.

// The library's trees, parsed once for the whole file. Parsing them is most of what one of these
// costs, and the analysis is the thing being tested.
private var library_cache: Buf[Program] = buf()
private var library_read: bool = false

private library_trees() -> Buf[Program]
    if library_read then return library_cache

    library_read = true

    std_root() match
        Err(_) -> ()
        Ok(root) -> std_units(root, host_target()) match
            Err(_) -> ()
            Ok(units) -> library_cache = units

    library_cache
end library_trees

private no_library() -> bool
    if library_trees().is_empty()
        print("skipped: the standard module's source is not on this machine")
        return true

    false
end no_library

// One source typed beside the library, with one of its functions printed the reference compiler's
// way -- which is what says whether an operator reached an implementation or the machine.
private shown(text: string, name: string) -> string
    val parsed = parse(source_of("test.sysl", text))

    if !parsed.ok() then return parsed.report.at(0).message

    var units: Buf[Program] = buf()
    val library = library_trees()

    for i in 0..<library.len()
        units.push(library.at(i))

    units.push(parsed.program)

    val done = analyze_bodies(units, host_target())

    for i in 0..<done.funcs.len()
        if done.funcs.at(i).name == name then return show_typed_func(done.funcs.at(i))

    if !done.reported.is_empty() then return done.reported.at(0).diag.message

    s"no function named '$name'"
end shown

// Everything the program has to say about a source read beside the library.
private complaints(text: string) -> Buf[string]
    val parsed = parse(source_of("test.sysl", text))
    var out: Buf[string] = buf()

    if !parsed.ok()
        out.push(parsed.report.at(0).message)
        return out
    end if

    var units: Buf[Program] = buf()
    val library = library_trees()

    for i in 0..<library.len()
        units.push(library.at(i))

    units.push(parsed.program)

    val done = analyze_bodies(units, host_target())

    for i in 0..<done.reported.len()
        val where = done.reported.at(i).src.name

        if !where.starts_with("library/") then out.push(done.reported.at(i).diag.message)

    out
end complaints

// Whether a source compiled beside the library emits a body under a name, which is what says a
// program reached it.
private emits(text: string, name: string) -> bool
    val parsed = parse(source_of("test.sysl", text))

    if !parsed.ok() then return false

    var units: Buf[Program] = buf()
    val library = library_trees()

    for i in 0..<library.len()
        units.push(library.at(i))

    units.push(parsed.program)

    val done = analyze_bodies(units, host_target())

    for i in 0..<done.funcs.len()
        if done.funcs.at(i).name == name then return true

    false
end emits

// What a report said, as one line, for a failing assertion to show.
private listed(xs: Buf[string]) -> string
    var out = ""

    for i in 0..<xs.len()
        out = s"$out${if i > 0 then " | " else ""}${xs.at(i)}"

    out
end listed

private says(xs: Buf[string], message: string) -> bool
    for i in 0..<xs.len()
        if xs.at(i) == message then return true

    false
end says

private point() -> string =
    "struct P\n    x: int\n\n" +
    "impl Eq for P\n    eq(self, other: P) -> bool = self.x == other.x\n\n" +
    "impl Ord for P\n    lt(self, other: P) -> bool = self.x < other.x\n\n" +
    "impl Add for P\n    add(self, other: P) -> P = P(self.x + other.x)\n\n" +
    "impl Neg for P\n    neg(self) -> P = P(-self.x)\n\n"

@test("'==' on a type with an 'impl Eq' is the link its 'eq' performs")
equality_dispatches_through_eq()
    if no_library() then return

    val out = shown(point() + "use(a: P, b: P) -> bool = a == b\n", "use")

    assert(out.contains("dispatch: TDispatch"), out)
    assert(out.contains("name: \"P.eq\""), out)
    assert(out.contains("swap: false"), out)
    assert(out.contains("negate: false"), out)

@test("and '>' is that type's 'lt' with the operands exchanged")
greater_is_lt_swapped()
    if no_library() then return

    val out = shown(point() + "use(a: P, b: P) -> bool = a > b\n", "use")

    assert(out.contains("name: \"P.lt\""), out)
    assert(out.contains("swap: true"), out)
    assert(out.contains("negate: false"), out)

@test("and '<=' is that type's 'lt' negated")
at_most_is_lt_negated()
    if no_library() then return

    val out = shown(point() + "use(a: P, b: P) -> bool = a <= b\n", "use")

    assert(out.contains("name: \"P.lt\""), out)
    assert(out.contains("negate: true"), out)

@test("a scalar keeps its instruction, so nothing dispatches")
a_scalar_keeps_its_instruction()
    if no_library() then return

    val out = shown("use(a: int, b: int) -> bool = a == b\n", "use")

    assert(out.contains("dispatch: None"), out)

@test("'+' on a type with an 'impl Add' is a call to its 'add'")
addition_dispatches_through_add()
    if no_library() then return

    val out = shown(point() + "use(a: P, b: P) -> P = a + b\n", "use")

    assert(out.contains("TCall"), out)
    assert(out.contains("name: \"P.add\""), out)

@test("and a prefix '-' is a call to its 'neg'")
negation_dispatches_through_neg()
    if no_library() then return

    val out = shown(point() + "use(a: P) -> P = -a\n", "use")

    assert(out.contains("name: \"P.neg\""), out)

@test("a type implementing neither is refused where it stands")
a_type_with_no_membership_is_refused()
    if no_library() then return

    val said = complaints("struct Q\n    x: int\n\nuse(a: Q, b: Q) -> Q = a + b\n")

    assert(says(said, "operator '+' is not defined for Q"), s"${said.len()} said")

@test("a compound assignment reaches the same implementation, as a name")
a_compound_assignment_dispatches()
    if no_library() then return

    val src = point() + "use(a: P, b: P) -> P\n    var acc = a\n\n    acc += b\n    acc\n"
    val out = shown(src, "use")

    assert(out.contains("name: \"P.add\""), out)

// -- the members the compiler provides for a built-in ---------------------------------------------

// **The `iN` and `uN` families are open**, so a rotation or a population count cannot be a library
// implementation however small the list of widths is. What the catalog holds is the method and its
// trait; the signature is read off the trait's own declaration like any other.

private bits_import() -> string = "import sysl.math.{Bits, Signed}\n\n"

@test("a bit-surface member is an instruction, with its amount read at the trait's own parameter")
a_bit_member_is_an_instruction()
    if no_library() then return

    val out = shown(bits_import() + "use(x: uint) -> uint = x.rotate_left(3)\n", "use")

    assert(out.contains("TIntOp"), out)
    assert(out.contains("op: \"rotate_left\""), out)
    assert(out.contains("width: uint"), out)

@test("and a count answers the width the trait declares, not the type it was asked of")
a_count_answers_the_traits_own_result()
    if no_library() then return

    val out = shown(bits_import() + "use(x: ulong) -> uint = x.count_ones()\n", "use")

    assert(out.contains("op: \"count_ones\""), out)
    assert(out.contains("width: ulong"), out)
    assert(out.contains("ty: uint"), out)

@test("the magnitude is the signed integers and nothing else")
the_magnitude_is_signed_only()
    if no_library() then return

    val out = shown(bits_import() + "use(x: int) -> int = x.abs()\n", "use")

    assert(out.contains("op: \"abs\""), out)

    val said = complaints(bits_import() + "use(x: uint) -> uint = x.abs()\n")

    assert(says(said, "type 'uint' has no method 'abs'"), s"${said.len()} said")

@test("an identity is a number stated in the catalog, at the type it was asked of")
an_identity_is_a_number()
    if no_library() then return

    val out = shown("use() -> ulong = ulong.zero()\n", "use")

    assert(out.contains("TIntLit"), out)
    assert(out.contains("value: 0"), out)
    assert(out.contains("ty: ulong"), out)

@test("and a width is read off the type, at the width the trait answers in")
a_width_is_read_off_the_type()
    if no_library() then return

    val out = shown(bits_import() + "use() -> uint = ulong.width()\n", "use")

    assert(out.contains("value: 64"), out)
    assert(out.contains("ty: uint"), out)

@test("a catalog trait is found where the library put it, not where its spelling suggests")
a_catalog_trait_is_found_where_it_lives()
    if no_library() then return

    val out = shown(bits_import() + "use(x: uint) -> uint = x.leading_zeros()\n", "use")

    assert(out.contains("op: \"leading_zeros\""), out)

// -- what the library supplies for a built-in ------------------------------------------------------

@test("a string's characters are the library's cursor over its bytes, reached without being named")
a_strings_characters_are_the_librarys_cursor()
    if no_library() then return

    val out = shown("use(s: string) -> sysl.text.Chars = s.chars\n", "use")

    assert(out.contains("name: \"sysl.text$chars_of\""), out)
    assert(out.contains("TBytes"), out)

@test("a library name is found where the library put it, not under the standard module")
a_library_name_is_found_where_it_lives()
    if no_library() then return

    val said = complaints("use(s: string) -> sysl.text.Chars = s.chars\n")

    assert(said.is_empty(), s"${said.len()} said")

// -- a raw object -----------------------------------------------------------------------------------

private sink_decls() -> string =
    "struct S\n    n: int\n\n" +
    "impl sysl.Fallible for S\n\n" +
    "impl sysl.Writer for S\n    write(*self, bytes: []const u8) = self.n += 1\n\n"

@test("a pointer at a type that implements the trait goes behind the table a raw object carries")
a_pointer_is_erased_into_a_raw_object()
    if no_library() then return

    val out = shown(sink_decls() + "use(p: *S) -> *sysl.Writer = p\n", "use")

    assert(out.contains("TErase"), out)
    assert(out.contains("vtable: \"vt.sysl$Writer.S\""), out)

@test("and a value with no address of its own is told to take one")
a_value_needs_an_address()
    if no_library() then return

    val said = complaints(sink_decls() + "use(s: S) -> *sysl.Writer = s\n")

    assert(!said.is_empty(), "the value was refused")

// -- walking a cursor ------------------------------------------------------------------------------

@test("a 'for' over a type that implements 'Iterate' binds a cursor and matches what 'next' answers")
a_for_walks_a_cursor()
    if no_library() then return

    val src = "use(s: string) -> int\n" +
              "    var n = 0\n\n" +
              "    for c in s.chars\n" +
              "        n += 1\n\n" +
              "    n\n"
    val out = shown(src, "use")

    assert(out.contains("TIterate"), out)
    assert(out.contains("cursor: \"iter\""), out)
    assert(out.contains("cursorTy: sysl.text.Chars"), out)
    assert(out.contains("name: \"sysl.text$Chars.next\""), out)
    assert(out.contains("enumTy: sysl.Option[char]"), out)
    assert(out.contains("variant: EnumVariant"), out)

@test("and the cursor is advanced through its address, so the walk is over a copy")
a_cursor_is_advanced_through_its_address()
    if no_library() then return

    val src = "use(s: string) -> int\n" +
              "    var n = 0\n\n" +
              "    for c in s.chars\n" +
              "        n += 1\n\n" +
              "    n\n"
    val out = shown(src, "use")

    assert(out.contains("TAddrOf"), out)
    assert(out.contains("ty: *sysl.text.Chars"), out)

@test("a type implementing no 'Iterate' is still told what a 'for' walks")
a_type_with_no_cursor_is_refused()
    if no_library() then return

    val said = complaints("struct Q\n    x: int\n\nuse(q: Q)\n    for v in q\n        print(v)\n")

    assert(says(said, "walking a 'Q' through 'Iterate' is not typed yet"), s"${said.len()} said")

// -- three things only a whole program shows -------------------------------------------------------

@test("a declaration written out beats one a type parameter covers")
a_written_out_overload_wins()
    if no_library() then return

    val out = shown("import sysl.slices.copy\n\nuse(d: []u8, s: []const u8) -> usize = copy(d, s)\n",
                    "use")

    assert(out.contains("name: \"sysl.slices$copy.2\""), out)

@test("and a call the written-out one does not take still reaches the generic")
a_generic_overload_still_answers()
    if no_library() then return

    val out = shown("import sysl.slices.copy\n\nuse(d: []int, s: []const int) -> usize = copy(d, s)\n",
                    "use")

    assert(out.contains("name: \"sysl.slices$copy.int\""), out)

@test("a member of a file-private type is internal, since nothing outside the file can reach it")
a_member_of_a_private_type_is_internal()
    if no_library() then return

    val src = "use(s: string) -> int\n" +
              "    var n = 0\n\n" +
              "    for c in s.chars\n" +
              "        n += 1\n\n" +
              "    n\n"
    val out = shown(src, "sysl.text$Scan.width")

    assert(out.contains("internal: true"), out)

@test("an argument at a parameter still being solved is read bare, and the position converts it")
a_solved_argument_is_converted_by_its_position()
    if no_library() then return

    val out = shown("use(b: *sysl.buf.Buf[string], s: string) = b.push(s)\n",
                    "sysl.buf$Buf.push.string")

    assert(out.contains("TConstView"), out)
    assert(out.contains("sliceTy: []string"), out)

// -- closures ---------------------------------------------------------------------------------------

// A function taking a callable, which is the shape every closure test below stands at: the bare
// arrow is sugar for a bounded type parameter, so the call instantiates `apply` at the closure.
private applier() -> string = "apply(f: int -> int, x: int) -> int = f(x)\n"

// The body the **last** closure of a source lowered to. A closure's name is a counter over the whole
// compilation, so which number the source's own closure gets depends on how many the library lowered
// before it -- and what a test is asking about is the last one lowered, which is the source's.
private closure_body(text: string) -> string
    val parsed = parse(source_of("test.sysl", text))

    if !parsed.ok() then return parsed.report.at(0).message

    var units: Buf[Program] = buf()
    val library = library_trees()

    for i in 0..<library.len()
        units.push(library.at(i))

    units.push(parsed.program)

    val done = analyze_bodies(units, host_target())
    var found = ""

    for i in 0..<done.funcs.len()
        if done.funcs.at(i).name.ends_with(".call") &&
           done.funcs.at(i).name.starts_with("$closure") then
            found = show_typed_func(done.funcs.at(i))

    if found == "" && !done.reported.is_empty() then return done.reported.at(0).diag.message

    found
end closure_body

@test("a closure literal is a struct of what it captures, built where it is written")
a_closure_is_a_struct_of_its_captures()
    if no_library() then return

    val out = shown(applier() + "use(k: int) -> int = apply(n -> n + k, 3)\n", "use")

    assert(out.contains("TStructNew"), out)
    assert(out.contains("struct: a closure"), out)
    assert(out.contains("name: \"k\""), out)

@test("and the call is to the instantiation the closure's own struct made")
a_closure_instantiates_the_callable_it_stands_at()
    if no_library() then return

    val out = shown(applier() + "use(k: int) -> int = apply(n -> n + k, 3)\n", "use")

    assert(out.contains("name: \"apply.$closure"), out)

@test("a capture is read as a field of the environment the body was handed")
a_capture_reads_a_field_of_the_environment()
    if no_library() then return

    val out = closure_body(applier() + "use(k: int) -> int = apply(n -> n + k, 3)\n")

    assert(out.contains("_1: \"self\""), out)
    assert(out.contains("_2: *a closure"), out)
    assert(out.contains("TDeref"), out)
    assert(out.contains("index: 0"), out)

@test("and the body it lowers to is internal, since nothing outside can name it")
a_closure_body_is_internal()
    if no_library() then return

    val out = closure_body(applier() + "use(k: int) -> int = apply(n -> n + k, 3)\n")

    assert(out.contains("internal: true"), out)

@test("a closure capturing nothing is a struct with no fields")
a_closure_with_no_captures_has_no_fields()
    if no_library() then return

    val out = shown(applier() + "use() -> int = apply(n -> n + 1, 3)\n", "use")

    assert(out.contains("struct: a closure"), out)
    assert(out.contains("args: []"), out)

@test("a bare-arrow parameter is called through the call trait, taking its receiver by address")
a_callable_parameter_is_called_through_its_trait()
    if no_library() then return

    val out = closure_body(applier() + "use() -> int = apply(n -> n + 1, 3)\n")

    assert(out.contains("retTy: int"), out)
    assert(out.contains("_2: *a closure"), out)

@test("a declared function where a callable is wanted is the capture-free closure")
a_function_name_is_a_capture_free_closure()
    if no_library() then return

    val src = applier() + "double(n: int) -> int = n * 2\n\nuse() -> int = apply(double, 3)\n"
    val out = closure_body(src)

    assert(out.contains("_1: \"$a0\""), out)
    assert(out.contains("name: \"double\""), out)

@test("a closure's result comes from its body, and nothing has to say what it is")
a_closure_yields_what_its_body_yields()
    if no_library() then return

    val src = "apply(f: int -> string, x: int) -> string = f(x)\n\n" +
              "use() -> string = apply(n -> str(n), 3)\n"
    val out = closure_body(src)

    assert(out.contains("retTy: string"), out)

@test("a closure standing at a callable of another arity is refused where it stands")
a_closure_of_the_wrong_arity_is_refused()
    if no_library() then return

    val said = complaints(applier() + "use() -> int = apply((a: int, b: int) -> a, 3)\n")

    assert(says(said, "this closure takes 2 parameters, and what it is being used as takes 1"),
           s"${said.len()} said")

@test("a parameter nothing says the type of is reported against the parameter")
a_closure_parameter_with_no_type_says_so()
    if no_library() then return

    val said = complaints("use() -> int\n    val f = n -> n + 1\n\n    f(2)\n")

    assert(says(said, "'n' has no type here — nothing says what this closure takes, so write it: " +
                "'(n: …) -> …'"), s"${said.len()} said")

@test("a member with type parameters of its own is instantiated from the call")
a_generic_member_is_instantiated_from_its_call()
    if no_library() then return

    val out = shown("use(o: sysl.Option[int]) -> sysl.Option[string] = o.map(n -> str(n))\n", "use")

    assert(out.contains("sysl$Option.map"), out)

// -- the atomics ------------------------------------------------------------------------------------

// The ordering is a variant written at the call, so every atomic test brings the enum into scope.
private ordering_import() -> string = "import sysl.sync.Ordering\n\n"

@test("an atomic load reads the word its address points at, at the ordering written")
an_atomic_load_reads_a_word()
    if no_library() then return

    val src = ordering_import() + "use(p: *i32) -> i32 = atomic_load(p, Ordering.Acquire)\n"
    val out = shown(src, "use")

    assert(out.contains("TAtomic"), out)
    assert(out.contains("op: \"atomic_load\""), out)
    assert(out.contains("ordering: \"Acquire\""), out)

@test("a fence is nothing but its ordering, so it reaches no address")
a_fence_orders_what_is_around_it()
    if no_library() then return

    val out = shown(ordering_import() + "use() = atomic_fence(Ordering.SeqCst)\n", "use")

    assert(out.contains("TFence"), out)
    assert(out.contains("ordering: \"SeqCst\""), out)

@test("a load has nothing to release, so a releasing one is refused")
a_releasing_load_is_refused()
    if no_library() then return

    val said = complaints(ordering_import() +
                          "use(p: *i32) -> i32 = atomic_load(p, Ordering.Release)\n")

    assert(says(said, "a load has nothing to release, so 'Release' asks it to publish writes it " +
                "never made and there is no such instruction — write 'Acquire' to see what the " +
                "releasing side published, 'Relaxed' if nothing else follows from the read, or " +
                "'SeqCst'"), s"${said.len()} said")

@test("and a width the machine has no instruction for is refused where it is written")
an_atomic_at_an_odd_width_is_refused()
    if no_library() then return

    val said = complaints(ordering_import() +
                          "use(p: *sysl.Option[int], v: sysl.Option[int]) = " +
                          "atomic_store(p, v, Ordering.Relaxed)\n")

    assert(said.len() > 0, "the width was refused")

@test("a relaxed fence would order nothing, and the machine has no instruction for one")
a_relaxed_fence_is_refused()
    if no_library() then return

    val said = complaints(ordering_import() + "use() = atomic_fence(Ordering.Relaxed)\n")

    assert(says(said, "a fence is nothing but its ordering, so 'Relaxed' would ask for a barrier " +
                "that orders nothing — write 'Acquire', 'Release', 'AcqRel' or 'SeqCst', or drop " +
                "the fence. A relaxed *access* is the thing that is meaningful, and that is the " +
                "ordering on the operation itself"), s"${said.len()} said")

@test("a declaration of the name wins, since these forms take no name out of a program's vocabulary")
a_declared_atomic_name_wins()
    if no_library() then return

    val src = "atomic_load(n: int) -> int = n + 1\n\nuse() -> int = atomic_load(2)\n"
    val out = shown(src, "use")

    assert(out.contains("name: \"atomic_load\""), out)

// -- what a type's own name offers ------------------------------------------------------------------

@test("a simple enum maps a value to its position and a position back to a value")
an_enum_maps_between_values_and_positions()
    if no_library() then return

    val src = "enum Colour\n    Red\n    Green\n\nuse(c: Colour) -> int = Colour::Pos(c)\n"
    val out = shown(src, "use")

    assert(out.contains("TEnumAttr"), out)
    assert(out.contains("kind: \"Pos\""), out)
    assert(out.contains("retTy: int"), out)

@test("and a value to the name it was declared under")
an_enum_maps_a_value_to_its_name()
    if no_library() then return

    val src = "enum Colour\n    Red\n    Green\n\nuse(c: Colour) -> string = Colour::Image(c)\n"
    val out = shown(src, "use")

    assert(out.contains("kind: \"Image\""), out)
    assert(out.contains("retTy: string"), out)

@test("an enum's ends are its first and last variants, folded where they are written")
an_enum_has_ends()
    if no_library() then return

    val src = "enum Colour\n    Red\n    Green\n\nuse() -> Colour = Colour::Last\n"
    val out = shown(src, "use")

    assert(out.contains("TIntLit"), out)
    assert(out.contains("value: 1"), out)

@test("an integer type states the extremes it can hold, and they fold to literals")
an_integer_states_its_extremes()
    if no_library() then return

    val out = shown("use() -> u8 = u8::Max\n", "use")

    assert(out.contains("value: 255"), out)

@test("an integer is not a declared sequence, and its ends are named differently")
an_integer_has_no_first()
    if no_library() then return

    val said = complaints("use() -> u8 = u8::First\n")

    assert(says(said, "'u8' is an integer, not a declared sequence — its extremes are 'u8::Min' " +
                "and 'u8::Max'. 'First' and 'Last' name the ends of an enum's variants or of a " +
                "'within' range, which is a different question"), s"${said.len()} said")

@test("an enum carrying data has no ordinal maps to read")
a_data_enum_has_no_attributes()
    if no_library() then return

    val said = complaints("enum Shape\n    Dot\n    Line(n: int)\n\nuse(s: Shape) -> int = " +
                          "Shape::Pos(s)\n")

    assert(says(said, "'Shape::Pos' needs a simple enum, and 'Shape' carries data"),
           s"${said.len()} said")

@test("every type answers its own compile-time identity")
every_type_answers_an_identity()
    if no_library() then return

    val out = shown("struct P\n    x: int\n\nuse() -> usize = P::Id\n", "use")

    assert(out.contains("TIntLit"), out)
    assert(out.contains("ty: usize"), out)

// -- indexing through a trait -----------------------------------------------------------------------

@test("a type with no elements of its own is read by a subscript through 'Index'")
a_container_is_read_through_index()
    if no_library() then return

    val src = "struct Row\n    xs: sysl.buf.Buf[int]\n\n" +
              "impl sysl.Index[usize, int] for Row\n" +
              "    index(self, i: usize) -> int = self.xs[i]\n\n" +
              "use(r: Row) -> int = r[0]\n"
    val out = shown(src, "use")

    assert(out.contains("Row.index"), out)

@test("and set through 'IndexSet', which is a call rather than a store")
a_container_is_set_through_index_set()
    if no_library() then return

    val src = "struct Row\n    xs: sysl.buf.Buf[int]\n\n" +
              "impl sysl.IndexSet[usize, int] for Row\n" +
              "    index_set(*self, i: usize, v: int) = self.xs.set(i, v)\n\n" +
              "use(r: *Row) = r[0] = 3\n"
    val out = shown(src, "use")

    assert(out.contains("Row.index_set"), out)

@test("a compound assignment through the trait would evaluate the receiver twice")
a_compound_index_assignment_is_refused()
    if no_library() then return

    val said = complaints("struct Row\n    xs: sysl.buf.Buf[int]\n\n" +
                          "impl sysl.IndexSet[usize, int] for Row\n" +
                          "    index_set(*self, i: usize, v: int) = self.xs.set(i, v)\n\n" +
                          "use(r: *Row) = r[0] += 3\n")

    assert(says(said, "'+=' on an element read through 'Index' would evaluate the receiver and " +
                "the index twice — write it out as 'b[i] = b[i] + …'"), s"${said.len()} said")

// -- a function's address ---------------------------------------------------------------------------

@test("'&f' on a declared function is the address C's function pointer holds")
a_function_has_an_address()
    if no_library() then return

    val src = "twice(n: int) -> int = n * 2\n\n" +
              "use() -> *extern(int) -> int = &twice\n"
    val out = shown(src, "use")

    assert(out.contains("TFuncAddr"), out)
    assert(out.contains("name: \"twice\""), out)

@test("a variadic function is reached by calling it, since a tail has no width to state")
a_variadic_function_has_no_address()
    if no_library() then return

    val said = complaints("many(n: int, ...) -> int = n\n\n" +
                          "use() -> *extern(int) -> int = &many\n")

    assert(says(said, "'many' is variadic, and a '*extern' fixes the arguments a call passes — a " +
                "tail has no width a signature could state, so a variadic function is reached by " +
                "calling it"), s"${said.len()} said")

@test("an aggregate crosses to C in whichever registers that machine names, so its address is refused")
an_aggregate_signature_has_no_address()
    if no_library() then return

    val said = complaints("struct P\n    x: int\n    y: int\n\n" +
                          "take(p: P) -> int = p.x\n\n" +
                          "use() -> *extern(P) -> int = &take\n")

    assert(said.len() > 0, "the aggregate was refused")

// -- a variant with nothing to settle it --------------------------------------------------------------

@test("a nullary variant of a generic enum with nothing to settle it reports rather than picking")
a_bare_none_with_no_context_reports()
    if no_library() then return

    val said = complaints("use() -> int\n    val x = None\n\n    3\n")

    assert(says(said, "cannot infer the type argument 'T' of 'None' here — annotate the expected " +
                "type"), s"${said.len()} said")

@test("and the branch is held over for its sibling, which is what makes the 'if' read")
a_bare_none_is_held_over_for_its_sibling()
    if no_library() then return

    val out = shown("use(c: bool) -> sysl.Option[string] = if c then Some(\"a\") else None\n", "use")

    assert(out.contains("sysl.Option[string]"), out)

// -- what 'derives' writes ----------------------------------------------------------------------

@test("'derives Eq' walks a struct's fields, and the first disagreement decides")
derived_eq_walks_the_fields()
    if no_library() then return

    val src = "struct P derives Eq\n    x: int\n    y: int\n\n" +
              "use(a: P, b: P) -> bool = a == b\n"
    val out = shown(src, "P.eq")

    assert(out.contains("name: \"eq\"") || out.contains("retTy: bool"), out)
    assert(out.contains("TIf"), out)

@test("'derives Ord' is lexicographic, written as a ladder")
derived_ord_is_a_ladder()
    if no_library() then return

    val src = "struct P derives Eq, Ord\n    x: int\n    y: int\n\n" +
              "use(a: P, b: P) -> bool = a < b\n"
    val out = shown(src, "P.lt")

    assert(out.contains("retTy: bool"), out)
    assert(out.contains("TIf"), out)

@test("'derives Hash' mixes the fields in order with FNV's prime")
derived_hash_mixes_the_fields()
    if no_library() then return

    val src = "struct P derives Hash\n    x: int\n\nuse(a: P) -> u64 = a.hash()\n"
    val out = shown(src, "P.hash")

    assert(out.contains("retTy: ulong"), out)
    assert(out.contains("sysl$hash_u64"), out)

@test("'derives Display' renders a data enum's variant under its own name")
derived_display_renders_a_variant()
    if no_library() then return

    val src = "enum Shape derives Display\n    Dot\n    Line(n: int)\n\n" +
              "use(s: Shape) -> string = str(s)\n"
    val out = shown(src, "Shape.display")

    assert(out.contains("sysl$display_fill"), out)

@test("a simple enum is already 'Eq', so deriving one is refused at the word")
deriving_eq_on_a_simple_enum_is_refused()
    if no_library() then return

    val said = complaints("enum Colour derives Eq\n    Red\n    Green\n\n" +
                          "use(a: Colour) -> bool = a == a\n")

    assert(says(said, "a simple enum is already 'Eq' — no variant of it carries anything, so its " +
                "value is its discriminant and '==' is that comparison. Remove 'Eq' from the " +
                "'derives' clause; the other three are still worth deriving"), s"${said.len()} said")

@test("and a trait the compiler cannot write is refused by name")
deriving_an_unknown_trait_is_refused()
    if no_library() then return

    val said = complaints("trait Fancy\n    fancy(self) -> int\n\n" +
                          "struct P derives Fancy\n    x: int\n")

    assert(says(said, "'Fancy' is not a trait the compiler knows how to write — 'derives' names " +
                "Eq, Ord, Hash or Display, which are the four the library provides structurally " +
                "for every tuple. A trait of your own is implemented with an 'impl' block"),
           s"${said.len()} said")

// -- what the whole compiler's own sources found ---------------------------------------------------

@test("a closure standing at a boxed callable is erased into the object the type names")
a_closure_at_a_boxed_callable_is_erased()
    if no_library() then return

    val src = "take(f: &Fn() -> unit) = f()\n\nuse() = take(() -> ())\n"
    val out = shown(src, "use")

    assert(out.contains("TErase") || out.contains("vtable"), out)

@test("a module bound to a name is written before a dot, and the call reaches through it")
a_module_alias_qualifies_a_call()
    if no_library() then return

    val src = "import sysl.unicode\n\nuse(c: char) -> bool = unicode.is_alpha(c)\n"
    val out = shown(src, "use")

    assert(out.contains("sysl.unicode$is_alpha"), out)

@test("a generic enum's variant named through its enum is worked out from what it carries")
a_qualified_generic_variant_is_solved()
    if no_library() then return

    val src = "use(n: int) -> sysl.Option[int] = sysl.Option.Some(n)\n"
    val out = shown(src, "use")

    assert(out.contains("sysl.Option[int]"), out)

@test("and a nullary one takes the instantiation its position names")
a_qualified_nullary_variant_takes_its_position()
