module sysl.encoding.json
@tests

import sysl.buf.{Buf, buf}

// What `sysl.encoding.json` claims, asserted in sysl. JSONTestSuite's own cases are in
// `suite_tests.sysl`; these are the shapes of the tree, the writer, and where a refusal points.

private ok(text: string) -> Json = parse(text).unwrap()

// The refusal of `text`, rendered: `line:col: what`.
private refusal(text: string) -> string = parse(text) match
    Ok(j) -> s"accepted as $j"
    Err(e) -> str(e)

// -- reading --------------------------------------------------------------------------------------

@test("the scalars read as their variants")
json_reads_scalars()
    assert(ok("null").is_null())
    assert_eq(ok("true").as_bool(), Some(true))
    assert_eq(ok(" false ").as_bool(), Some(false))
    assert_eq(ok("\"hi\"").as_str(), Some("hi"))
    assert_eq(ok("0").as_int(), Some(0))
    assert_eq(ok("-17").as_int(), Some(-17))
end json_reads_scalars

@test("an integer stays an integer and a fraction or an exponent makes a real")
json_numbers_keep_their_kind()
    assert(ok("1") == Int(1))
    assert(ok("1.0") == Real(1.0))
    assert(ok("1e2") == Real(100.0))
    assert(ok("1E+2") == Real(100.0))
    assert(ok("-2.5e-1") == Real(-0.25))
    assert(ok("1") != ok("1.0"))
    assert_eq(ok("1.0").as_int(), None)
    assert_eq(ok("3").as_real(), Some(3.0))
end json_numbers_keep_their_kind

@test("the ends of a long are Ints and one past them is Big, digits kept")
json_long_edges()
    assert_eq(ok("9223372036854775807").as_int(), Some(9223372036854775807))
    assert_eq(ok("-9223372036854775808").as_int(), Some(-9223372036854775807 - 1))
    assert(ok("9223372036854775808") == Big("9223372036854775808"))
    assert(ok("-9223372036854775809") == Big("-9223372036854775809"))
    assert(ok("18446744073709551616") == Big("18446744073709551616"))
    assert(ok("123456789012345678901234567890") == Big("123456789012345678901234567890"))
    assert_eq(ok("100000000000000000000").as_real(), Some(1e20))
    assert_eq(ok("123456789012345678901234567890").to_string(),"123456789012345678901234567890")
end json_long_edges

@test("every escape decodes, a surrogate pair included")
json_escapes()
    assert_eq(ok("\"\\\" \\\\ \\/ \\b \\f \\n \\r \\t\"").as_str(), Some("\" \\ / \u{8} \u{c} \n \r \t"))
    assert_eq(ok("\"\\u0041\\u00e9\\u4e2D\"").as_str(), Some("A\u{e9}\u{4e2d}"))
    assert_eq(ok("\"\\ud83d\\ude00\"").as_str(), Some("\u{1F600}"))
    assert_eq(ok("\"\\uD834\\uDD1E\"").as_str(), Some("\u{1D11E}"))
    assert_eq(ok("\"a\\u0000b\"").as_str().unwrap().bytes.len, 3)
    assert_eq(ok("\"\u{1F600}\"").as_str(), Some("\u{1F600}"))
end json_escapes

@test("an object keeps its order and a name written twice, and get finds the first")
json_object_order()
    val j = ok("{\"b\": 1, \"a\": [true, null], \"b\": 2}")

    assert_eq(j.len(), 3)
    assert_eq(j.member(0).unwrap().key, "b")
    assert_eq(j.member(1).unwrap().key, "a")
    assert_eq(j.get("b").unwrap().as_int(), Some(1))
    assert_eq(j.get("a").unwrap().len(), 2)
    assert(j.get("a").unwrap().at(1).unwrap().is_null())
    assert(j.get("zz").is_none())
    assert(j.member(3).is_none())
    assert(j.get("a").unwrap().at(2).is_none())
    assert(ok("3").get("a").is_none())
    assert_eq(ok("3").len(), 0)
    assert_eq(j.to_string(), "{\"b\":1,\"a\":[true,null],\"b\":2}")
end json_object_order

@test("nesting to the limit reads and one past it is refused")
json_depth()
    var deep = ""

    for _ in 0..<max_depth do deep = deep + "["
    for _ in 0..<max_depth do deep = deep + "]"

    assert(parse(deep).is_ok())

    val over = "[" + deep + "]"

    assert_eq(refusal(over), s"1:${max_depth + 1}: arrays and objects nested more than 128 deep")
end json_depth

// -- where a refusal points -----------------------------------------------------------------------

@test("a refusal names its line and column, counting characters")
json_error_positions()
    assert_eq(refusal(""), "1:1: the text ends where a value was expected")
    assert_eq(refusal("   "), "1:4: the text ends where a value was expected")
    assert_eq(refusal("[1,]"), "1:4: a value expected")
    assert_eq(refusal("[1 2]"), "1:4: ',' or ']' expected")
    assert_eq(refusal("{\n  \"a\": 1,\n  \"b\" 2\n}"), "3:7: ':' expected")
    assert_eq(refusal("{\"a\":1,}"), "1:8: a member name expected")
    assert_eq(refusal("{\"a\":1 \"b\":2}"), "1:8: ',' or '}' expected")
    assert_eq(refusal("[1"), "1:3: the text ends where ',' or ']' was expected")
    assert_eq(refusal("{\"\u{e9}\u{e9}\": tru}"), "1:8: a value expected")
    assert_eq(refusal("1 2"), "1:3: more text after the value")
    assert_eq(refusal("[01]"), "1:2: a number may not have a leading zero")
    assert_eq(refusal("-"), "1:2: the text ends where a digit was expected")
    assert_eq(refusal("[1.]"), "1:4: a digit after the decimal point expected")
    assert_eq(refusal("1e+"), "1:4: the text ends where a digit in the exponent was expected")
    assert_eq(refusal("+1"), "1:1: a value expected")
    assert_eq(refusal("\"abc"), "1:1: this string is never closed")
    assert_eq(refusal("[\"a\\x\"]"), "1:4: not one of JSON's escapes: \\\" \\\\ \\/ \\b \\f \\n \\r \\t \\uXXXX")
    assert_eq(refusal("\"\\u12g4\""), "1:2: a \\u escape is four hexadecimal digits")
    assert_eq(refusal("\"\\ud800\""), "1:2: half of a surrogate pair, without the other half")
    assert_eq(refusal("\"\\ud800\\u0041\""), "1:2: half of a surrogate pair, without the other half")
    assert_eq(refusal("\"\\udc00\""), "1:2: half of a surrogate pair, without the other half")
    assert_eq(refusal("\"a\tb\""), "1:3: a control character has to be escaped inside a string")
    assert_eq(refusal("\r\n\r\n  x"), "3:3: a value expected")
end json_error_positions

@test("the error's fields are the place and the fault")
json_error_fields()
    val e = parse("[\n  1,\n  oops]").unwrap_err()

    assert_eq(e.line, 3)
    assert_eq(e.col, 3)
    assert_eq(e.offset, 9)
    assert_eq(e.fault.to_string(), "a value expected")
end json_error_fields

@test("bytes that are not UTF-8 inside a string are refused where they stand")
json_not_utf8()
    val bad: []const u8 = [0x22, 0x61, 0x5c, 0x6e, 0xff, 0x22]

    val e = parse_bytes(bad).unwrap_err()

    assert_eq(e.offset, 4)
    assert_eq(e.to_string(), "1:5: this string is not UTF-8")

    val good: []const u8 = [0x22, 0xc3, 0xa9, 0x22]

    assert_eq(parse_bytes(good).unwrap().as_str(), Some("\u{e9}"))
end json_not_utf8

// -- writing --------------------------------------------------------------------------------------

@test("the compact form has no space and a real keeps its point")
json_writes_compact()
    assert_eq(ok(" [ 1 , 2.5 , \"x\" , { \"k\" : null } , [ ] , { } ] ").to_string(), "[1,2.5,\"x\",{\"k\":null},[],{}]")
    assert_eq(Real(1.0).to_string(), "1.0")
    assert_eq(Real(0.1).to_string(), "0.1")
    assert_eq(Real(-0.0).to_string(), "-0.0")
    assert_eq(Real(1e300).to_string(), "1e+300")
    assert_eq(Real(1.0 / 3.0).to_string(), "0.3333333333333333")
    assert_eq(Real(infinity).to_string(), "null")
    assert_eq(Int(-9223372036854775807 - 1).to_string(), "-9223372036854775808")
end json_writes_compact

@test("a string writes with JSON's escapes and nothing more")
json_writes_strings()
    assert_eq(quoted("a\"b\\c/d"), "\"a\\\"b\\\\c/d\"")
    assert_eq(quoted("\n\r\t\u{8}\u{c}\u{1}\u{1f}"), "\"\\n\\r\\t\\b\\f\\u0001\\u001f\"")
    assert_eq(quoted("\u{e9}\u{1F600}"), "\"\u{e9}\u{1F600}\"")
    assert_eq(quoted(""), "\"\"")
end json_writes_strings

@test("pretty puts one thing to a line")
json_writes_pretty()
    val j = ok("{\"name\":\"sysl\",\"tags\":[\"systems\",\"small\"],\"none\":[],\"n\":{}}")

    assert_eq(pretty(j, 2), "{\n  \"name\": \"sysl\",\n  \"tags\": [\n    \"systems\",\n    \"small\"\n  ],\n  \"none\": [],\n  \"n\": {}\n}")
    assert_eq(pretty(ok("[1,[2]]"), 0), "[\n1,\n[\n2\n]\n]")
    assert_eq(pretty(Int(5), 4), "5")
end json_writes_pretty

@test("a document read, written and read again is the same document")
json_round_trips()
    val texts = ["{\"a\":[1,-2,3.5,1e-7,true,false,null],\"b\":{\"c\":\"\\u0000\\u001f\\\"\\\\\"}}",
        "[123456789012345678901234567890,-0.0,5e-324,1.7976931348623157e+308]",
        "\"\u{1F600}\\ud83d\\ude00\"", "[[[[]]],{},{\"\":\"\"}]"]

    for t in texts
        val j = ok(t)

        assert(ok(j.to_string()) == j)
        assert(ok(pretty(j, 3)) == j)
        assert_eq(ok(j.to_string()).to_string(), j.to_string())
end json_round_trips

@test("a tree built by hand writes as its document")
json_builds()
    var members: Buf[Member] = buf()
    var items: Buf[Json] = buf()

    items.push(Int(1))
    items.push(Str("two"))
    members.push(Member("list", Arr(items)))
    members.push(Member("ok", Bool(true)))

    val j = Obj(members)

    assert_eq(j.to_string(), "{\"list\":[1,\"two\"],\"ok\":true}")
    assert(ok(j.to_string()) == j)
end json_builds
