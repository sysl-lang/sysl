@test("a multiple assignment overwriting one copy and putting the parameter in the other")
pcr_multiple_assignment_swaps_one_back()
    pcr_refused(raw"""
        key(a: *int)
            var b = a
            var c = &spare
            b, c = c, b
            f1(&c)

        other()
            var y = 5
            key(&y)

        main()
            other()
            print(*held)
        """, pcr_lets_out("f1"))

@test("a struct holding the copy in a field, overwritten whole, the field stored")
pcr_struct_overwritten_whole()
    pcr_prints(raw"""
        struct H
            p: *int

        key(a: *int)
            var h = H(a)
            h = H(&spare)
            held = h.p

        other()
            var y = 5
            key(&y)

        main()
            other()
            print(*held)
        """, "7\n")

@test("a struct holding the copy in a field, only the field overwritten, is still followed")
pcr_struct_field_overwritten()
    pcr_refused(raw"""
        struct H
            p: *int

        key(a: *int)
            var h = H(a)
            h.p = &spare
            held = h.p

        other()
            var y = 5
            key(&y)

        main()
            other()
            print(*held)
        """, pcr_kept("it is stored in 'held'"))

@test("a pointer read through the parameter into a local, overwritten before it is stored")
pcr_read_value_overwritten()
    pcr_prints(raw"""
        relay(p: **int)
            var q = *p
            print(*q)
            q = &spare
            held = q

        other()
            var y = 5
            var x = &y
            relay(&x)

        main()
            other()
            print(*held)
        """, "5\n7\n")

@test("a pointer read through the parameter into a local, overwritten on one way only")
pcr_read_value_overwritten_on_one_way()
    pcr_refused(raw"""
        relay(p: **int)
            var q = *p
            if *q > 30 then q = &spare
            held = q

        other()
            var y = 5
            var x = &y
            relay(&x)

        main()
            other()
            print(*held)
        """, "'relay' lets what it reads through its parameter 'p' outlive the call")

@test("a closure made after the copy is overwritten, storing what it captured")
pcr_closure_made_after_the_overwrite()
    pcr_prints(raw"""
        key(a: *int)
            var b = a
            b = &spare
            val g = () -> held = b
            g()

        other()
            var y = 5
            key(&y)

        main()
            other()
            print(*held)
        """, "7\n")

@test("a closure made before the copy is overwritten, storing what it captured")
pcr_closure_made_before_the_overwrite()
    pcr_refused(raw"""
        key(a: *int)
            var b = a
            val g = () -> held = b
            b = &spare
            g()

        other()
            var y = 5
            key(&y)

        main()
            other()
            print(*held)
        """, "keeps its parameter 'a'")

@test("a closure built in a loop whose next turn finds the copy put back")
pcr_closure_built_in_a_loop()
    pcr_refused(raw"""
        key(a: *int)
            var b = a
            b = &spare
            for i in 0..<2
                val g = () -> held = b
                g()
                b = a

        other()
            var y = 5
            key(&y)

        main()
            other()
            print(*held)
        """, "keeps its parameter 'a'")

@test("a closure built after the overwrite, handed to a callee that runs it")
pcr_closure_handed_after_the_overwrite()
    pcr_prints(raw"""
        run_it(f: &Fn() -> unit) = f()

        key(a: *int)
            var b = a
            b = &spare
            run_it(() -> held = b)

        other()
            var y = 5
            key(&y)

        main()
            other()
            print(*held)
        """, "7\n")

@test("a copy overwritten by a 'defer', its address handed over before the way out")
pcr_overwritten_by_a_defer()
    pcr_refused(raw"""
        key(a: *int)
            var b = a
            defer b = &spare
            f1(&b)

        other()
            var y = 5
            key(&y)

        main()
            other()
            print(*held)
        """, pcr_lets_out("f1"))

@test("a copy overwritten in an outer loop's body, handed over in an inner loop")
pcr_overwritten_in_an_outer_loop()
    pcr_prints(raw"""
        key(a: *int)
            var b = a
            for i in 0..<2
                b = &spare
                for j in 0..<2
                    f1(&b)
                b = a

        other()
            var y = 5
            key(&y)

        main()
            other()
            print(*held)
        """, "7\n")

@test("a copy put back in an inner loop, handed over after it in the outer loop's body")
pcr_put_back_in_an_inner_loop()
    pcr_refused(raw"""
        key(a: *int)
            var b = a
            for i in 0..<2
                b = &spare
                for j in 0..<*a - 5
                    b = a
                f1(&b)

        other()
            var y = 5
            key(&y)

        main()
            other()
            print(*held)
        """, pcr_lets_out("f1"))

@test("a 'match' whose arm that does not overwrite the copy returns")
pcr_match_arm_returns()
    pcr_prints(raw"""
        key(a: *int)
            var b = a
            *a match
                5 -> b = &spare
                _ -> return
            f1(&b)

        other()
            var y = 5
            key(&y)

        main()
            other()
            print(*held)
        """, "7\n")

@test("a 'while' loop overwriting the copy, its address handed over after it")
pcr_while_loop_overwrites()
    pcr_refused(raw"""
        key(a: *int)
            var b = a
            var n = *a
            while n > 5
                b = &spare
                n -= 1
            f1(&b)

        other()
            var y = 5
            key(&y)

        main()
            other()
            print(*held)
        """, pcr_lets_out("f1"))

@test("a method overwriting a copy of its parameter before handing its address over")
pcr_method_overwrites()
    pcr_prints(raw"""
        struct S
            n: int

        impl S
            key(*self, a: *int)
                var b = a
                b = &spare
                f1(&b)

        other()
            var y = 5
            var s = S(1)
            s.key(&y)

        main()
            other()
            print(*held)
        """, "7\n")

@test("a generic function overwriting a copy of its parameter before handing its address over")
pcr_generic_overwrites()
    pcr_prints(raw"""
        key[T](a: *int, t: T)
            var b = a
            b = &spare
            f1(&b)

        other()
            var y = 5
            key(&y, 1)
            key(&y, true)

        main()
            other()
            print(*held)
        """, "7\n")

@test("a copy overwritten, then put back through a 'ref' naming it")
pcr_put_back_through_a_ref()
    pcr_refused(raw"""
        key(a: *int)
            var b = a
            ref r = b
            b = &spare
            r = a
            f1(&b)

        other()
            var y = 5
            key(&y)

        main()
            other()
            print(*held)
        """, pcr_lets_out("f1"))

@test("a copy overwritten through a 'ref' naming it")
pcr_overwritten_through_a_ref()
    pcr_refused(raw"""
        key(a: *int)
            var b = a
            ref r = b
            r = &spare
            f1(&b)

        other()
            var y = 5
            key(&y)

        main()
            other()
            print(*held)
        """, pcr_lets_out("f1"))

// TODO: un-ignore when what a body answers is gathered along its ways too (`answered`).
@test("an answer made of a copy overwritten before it is answered", ignore: "what a body answers is gathered flow-insensitively")
pcr_answers_an_overwritten_copy()
    pcr_prints(raw"""
        pick(a: *int) -> *int
            var b = a
            print(*b)
            b = &spare
            b

        other()
            var y = 5
            held = pick(&y)

        main()
            other()
            print(*held)
        """, "5\n7\n")

@test("a copy handed to a callee that keeps its address is followed as before")
pcr_address_kept_by_a_callee()
    pcr_refused(raw"""
        var stash: **int = null

        keep_it(p: **int)
            stash = p

        key(a: *int)
            var b = a
            b = &spare
            keep_it(&b)
            f1(&b)
            stash = null

        other()
            var y = 5
            key(&y)

        main()
            other()
            print(*held)
        """, pcr_lets_out("f1"))
