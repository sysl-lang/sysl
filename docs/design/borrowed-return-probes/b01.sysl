// The motivating shape (automata HashLife, branch hashlife-075): a reference-type node whose
// children sit in an Option of a struct of four references, and a by-value `quad(self)` that
// answers them. `emit-llvm` of `walk` shows what one `n.quad()` costs today.
struct Node
    level: int
    kids: Option[Kids]

    quad(self) -> Kids = self.kids.unwrap()

struct Kids
    nw: &Node
    ne: &Node
    sw: &Node
    se: &Node

leaf() -> &Node = Node(0, None)

walk(n: &Node) -> int
    if n.level == 0 then return 1

    val q = n.quad()

    walk(q.nw) + walk(q.ne) + walk(q.sw) + walk(q.se)

val l = leaf()
val top: &Node = Node(1, Some(Kids(l, l, l, l)))

print(walk(top))
