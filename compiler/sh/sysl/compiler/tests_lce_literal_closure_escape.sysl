module sh.sysl.compiler
@tests

import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.{capture, Var}
import sysl.text.{cstring, Search}

// An element read out of an array is part of the array's value, as a field is of a struct's, so the
// escape analysis follows `[x][0]` back to `x`. A closure handed to a callee that keeps it, inside an
// array literal that is then indexed -- `[kept(k -> k + o.n)][0]` returned -- leaves its frame as
// surely as `kept(...)` returned does. When the probe that decides a closure's box lost it at the
// index, the box was laid in the frame and captured `o` by the frame slot's address, and the closure
// was called after the frame was gone. The rule that refuses a frame address leaving its frame had
// the same hole: `[&y][0]` was returned unrefused.
//
// Every program runs on the counted heap (the right value, nothing left over, nothing given back
// twice); the reduction also under AddressSanitizer and at -O0 and -O2.
//
// Skipped cells, and why: an index of a view or a `Buf` reads storage the value only points at, and
// what a callee answers out of its own `Buf` is the answer summary's question, not the index's.

// -- the harness ----------------------------------------------------------------------------------

private extern "setenv" lce_c_setenv(name: *u8, value: *u8, overwrite: int) -> int
private extern "unsetenv" lce_c_unsetenv(name: *u8) -> int

private struct LceRun
    out: string
    err: string
    hooks: usize
end LceRun

// The program built at `level` and run: on the counted heap, or with `flags` handed to clang. Under
// AddressSanitizer a read of a frame that has returned is reported, not only one of freed heap.
private lce_run(text: string, counted: bool, flags: string, level: string) -> LceRun
    val root = make_temp_dir("sysl-lce").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", forms_imported(text)).unwrap()

    val exe = s"$root/built"

    if flags != ""
        val n = cstring("SYSL_EXTRA_CFLAGS")
        val v = cstring(flags)

        lce_c_setenv(n.ptr, v.ptr, 1)
    end if

    force_alloc_counting(counted)

    val made = build_native_program(s"$root/main.sysl", None, None, level, Some(exe))

    force_alloc_counting(false)

    if flags != ""
        val n = cstring("SYSL_EXTRA_CFLAGS")

        lce_c_unsetenv(n.ptr)
    end if

    made match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return LceRun(failure_text(why), "", 0)
        Ok(_) -> ()

    val hooks = capture("nm", ["-u", exe], "", [], true) match
        Ok(o) -> o.text.count_of("__asan_report")
        Err(_) -> 0

    val ran = capture(exe, [], "", [Var("ASAN_OPTIONS", "detect_stack_use_after_return=1")], true)

    remove_dir_all(root).unwrap_or(())

    ran match
        Err(_) -> LceRun("could not be started", "", hooks)
        Ok(o) -> LceRun(o.text, o.err.unwrap_or(""), hooks)
end lce_run

// The program printed `want` on the counted heap at `level`, and gave back everything it took once.
private lce_prints_at(text: string, want: string, level: string)
    if !enm_ready() then return

    val got = lce_run(text, true, "", level)

    assert_eq(got.out, want)
    assert_eq(got.err, "")
end lce_prints_at

private lce_prints(text: string, want: string) = lce_prints_at(text, want, DefaultOptimization)

// The program printed `want` under AddressSanitizer, instrumented, and nothing was reported.
private lce_asan(text: string, want: string)
    if !enm_ready() then return

    val got = lce_run(text, false, "-fsanitize=address -g", DefaultOptimization)

    assert(got.hooks > 0, s"not instrumented: ${got.out}")
    assert_eq(got.out, want)
    assert_eq(got.err, "")
end lce_asan

// The IR of a program, or its analysis report where it was refused.
private lce_ir(text: string) -> string
    val root = make_temp_dir("sysl-lce").unwrap()

    write_text(s"$root/main.sysl", forms_imported(text)).unwrap()

    val ir = emit_llvm_text(s"$root/main.sysl", None) match
        Err(why) -> failure_text(why)
        Ok(made) -> if made.report.is_empty() then made.text else analysis_report(made.report)

    remove_dir_all(root).unwrap_or(())
    ir
end lce_ir

// How many closure boxes the IR of a program lays in a frame.
private lce_frame_boxes(text: string) -> int
    var n = 0

    for line in lines_of(lce_ir(text)).view()
        if line.contains("= alloca %arc.$closure") then n += 1

    n
end lce_frame_boxes

// What every program below shares: a callee that keeps the closure it is handed inside another, and a
// `main` that calls `make`, scribbles over the stack `make` used, and only then runs what it made.
private const lce_base: string = raw"""
    import sysl.buf.{Buf, buf}

    struct Holder
        act: &Fn() -> int

    struct Owner
        n: int

    kept(run: &Fn(int) -> int) -> &Holder = Holder(() -> run(1))

    scribble(depth: int) -> int
        var a: [64]int = [0; 64]

        for i in 0..<64
            a[i] = i * depth + 77

        if depth > 0 then a[3] + scribble(depth - 1) else a[5]
    end scribble

    main()
        val o: &Owner = Owner(41)
        val h = make(o)
        print(scribble(8))
        print((h.act)())
    """

private lce_program(rest: string) -> string = lce_base + rest

private const lce_reduction: string = raw"""
    make(o: &Owner) -> &Holder = [kept(k -> k + o.n)][0]
    """

// -- the regression -------------------------------------------------------------------------------

@test("a closure handed to a keeping callee inside an indexed array literal outlives the frame")
lce_literal_element_call()
    lce_prints(lce_program(lce_reduction), "801\n42\n")

@test("and under AddressSanitizer: instrumented, and no read of a returned frame")
lce_literal_element_call_under_asan()
    lce_asan(lce_program(lce_reduction), "801\n42\n")

@test("and at -O0")
lce_literal_element_call_o0()
    lce_prints_at(lce_program(lce_reduction), "801\n42\n", "0")

@test("and at -O2")
lce_literal_element_call_o2()
    lce_prints_at(lce_program(lce_reduction), "801\n42\n", "2")

@test("its IR lays no closure box in the frame")
lce_literal_element_call_no_frame_box()
    if xvr_no_library() then return

    assert_eq(lce_frame_boxes(lce_program(lce_reduction)), 0)

// -- other aggregates -----------------------------------------------------------------------------

@test("a tuple's element hands the closure on")
lce_tuple_element()
    lce_prints(lce_program(raw"""
        make(o: &Owner) -> &Holder = (kept(k -> k + o.n), 1).0
        """), "801\n42\n")

@test("a struct literal's field hands the closure on")
lce_struct_field()
    lce_prints(lce_program(raw"""
        struct Wrap
            h: &Holder

        make(o: &Owner) -> &Holder = Wrap(kept(k -> k + o.n)).h
        """), "801\n42\n")

@test("a repeat literal's element hands the closure on, each copy counted")
lce_repeat_element()
    lce_prints(lce_program(raw"""
        make(o: &Owner) -> &Holder = [kept(k -> k + o.n); 3][2]
        """), "801\n42\n")

@test("a nested array literal hands the closure on through both indexes")
lce_nested_array()
    lce_prints(lce_program(raw"""
        make(o: &Owner) -> &Holder = [[kept(k -> k + o.n)], [kept(k -> k)]][0][0]
        """), "801\n42\n")

@test("an array local holding the literal hands the closure on")
lce_array_local()
    lce_prints(lce_program(raw"""
        make(o: &Owner) -> &Holder
            val a = [kept(k -> k + o.n), kept(k -> k)]
            a[0]
        """), "801\n42\n")

@test("an array of Bufs hands the closure on")
lce_array_of_bufs()
    lce_prints(lce_program(raw"""
        make(o: &Owner) -> &Holder
            var b: Buf[&Holder] = buf()

            b.push(kept(k -> k + o.n))

            val rows = [b]
            rows[0][0]
        """), "801\n42\n")

// -- the element itself ---------------------------------------------------------------------------

@test("a closure that is itself the element outlives the frame")
lce_closure_element()
    lce_prints(lce_program(raw"""
        make(o: &Owner) -> &Holder = Holder([() -> o.n + 1][0])
        """), "801\n42\n")

@test("an if expression as the element hands either arm's closure on")
lce_if_element()
    lce_prints(lce_program(raw"""
        pick(o: &Owner, c: bool) -> &Holder = [if c then kept(k -> k + o.n) else kept(k -> k - o.n)][0]

        make(o: &Owner) -> &Holder = pick(o, o.n > 0)
        """), "801\n42\n")

@test("a match expression as the element hands its arm's closure on")
lce_match_element()
    lce_prints(lce_program(raw"""
        make(o: &Owner) -> &Holder =
            [o.n match
                0 -> kept(k -> k)
                _ -> kept(k -> k + o.n)][0]
        """), "801\n42\n")

@test("a closure capturing several counted references, in a literal, keeps them all")
lce_several_counted_captures()
    lce_prints(lce_program(raw"""
        make(o: &Owner) -> &Holder
            val p: &Owner = Owner(100)
            val q: &Owner = Owner(1000)

            [kept(k -> k + o.n + p.n + q.n)][0]
        end make
        """), "801\n1142\n")

@test("a var captured by a closure that leaves through a literal is held by value")
lce_var_capture()
    lce_prints(lce_program(raw"""
        make(o: &Owner) -> &Holder
            var n = o.n
            val h = [kept(k -> k + n)][0]

            n = 0
            h
        end make
        """), "801\n42\n")

@test("a keeping callee marked @noinline still keeps the closure")
lce_noinline_callee()
    lce_prints(lce_program(raw"""
        @noinline
        keep_far(run: &Fn(int) -> int) -> &Holder = Holder(() -> run(1))

        make(o: &Owner) -> &Holder = [keep_far(k -> k + o.n)][0]
        """), "801\n42\n")

@test("the literal in a generic function hands the closure on")
lce_generic_function()
    lce_prints(lce_program(raw"""
        made[T](o: &Owner, pad: T) -> &Holder = [kept(k -> k + o.n)][0]

        make(o: &Owner) -> &Holder = made(o, 7)
        """), "801\n42\n")

@test("a generic callee answering an element of the literal it is handed hands the closure on")
lce_generic_callee()
    lce_prints(lce_program(raw"""
        first[T](xs: [2]T) -> T = xs[0]

        make(o: &Owner) -> &Holder = first([kept(k -> k + o.n), kept(k -> k)])
        """), "801\n42\n")

@test("a callee answering an element of a Buf it pushed its parameter into hands the closure on",
      ignore: "a callee's answer summary does not follow a parameter stored in a Buf the body made and read back")
lce_callee_buf_answer()
    lce_prints(lce_program(raw"""
        through(h: &Holder) -> &Holder
            var b: Buf[&Holder] = buf()

            b.push(h)
            b[0]
        end through

        make(o: &Owner) -> &Holder = through(kept(k -> k + o.n))
        """), "801\n42\n")

// -- other temporaries ----------------------------------------------------------------------------

@test("a reference temporary read out of a literal outlives it")
lce_reference_temporary()
    lce_prints(lce_program(raw"""
        twin(o: &Owner) -> &Owner = [o, Owner(o.n + 1)][1]

        make(o: &Owner) -> &Holder
            val t = twin(o)

            Holder(() -> t.n)
        end make
        """), "801\n42\n")

@test("a string temporary read out of a literal outlives it")
lce_string_temporary()
    lce_prints(lce_program(raw"""
        label(o: &Owner) -> string = [s"n=${o.n}", "none"][0]

        make(o: &Owner) -> &Holder
            val s = label(o)

            Holder(() -> int(s.len) * 10 + 2)
        end make
        """), "801\n42\n")

// -- what stays in the frame ----------------------------------------------------------------------

@test("a closure in a literal that is only called where it is made stays boxed in the frame")
lce_local_call_stays_in_the_frame()
    if xvr_no_library() then return

    val text = raw"""
        struct Owner
            n: int

        near(o: &Owner) -> int
            val fs: [1]&Fn(int) -> int = [(k: int) -> k + o.n]
            fs[0](1)

        main()
            val o: &Owner = Owner(41)
            print(near(o))
        """

    assert_eq(lce_frame_boxes(text), 1)
    lce_prints(text, "42\n")
end lce_local_call_stays_in_the_frame

// -- the frame-address rule -----------------------------------------------------------------------

private const lce_leak_report: string = "is returned, but it holds the address of a local of 'leak'"

@test("the address of a local read out of an array literal is refused as a result")
lce_address_through_literal_refused()
    if xvr_no_library() then return

    val ir = lce_ir(raw"""
        leak(n: int) -> *int
            var y = n
            [&y][0]
        end leak

        main()
            print(*leak(3))
        """)

    assert(ir.contains(s"'[&y][0]' $lce_leak_report"), ir)
end lce_address_through_literal_refused

@test("and so is one read out of an array local")
lce_address_through_array_local_refused()
    if xvr_no_library() then return

    val ir = lce_ir(raw"""
        leak(n: int) -> *int
            var y = n
            val a = [&y, &y]

            a[1]
        end leak

        main()
            print(*leak(3))
        """)

    assert(ir.contains(s"'a[1]' $lce_leak_report"), ir)
end lce_address_through_array_local_refused

@test("an address read out of a literal and used inside the frame is not refused")
lce_address_used_in_frame_accepted()
    lce_prints(raw"""
        near(n: int) -> int
            var y = n
            *[&y][0] + 1
        end near

        main()
            print(near(41))
        """, "42\n")
