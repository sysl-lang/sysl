// P18: the same question asked as a marker trait, which `if const F: Trait` settles today
trait Positional
end Positional

struct Json
end Json

struct Compact
end Compact

impl Positional for Compact
end Compact

shape[F]() -> string
    if const F: Positional
        "positions"
    else
        "keys"

print(shape[Json](), shape[Compact]())
