module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}

// juicer's own answers for the slug a page's heading is given -- the table `doc_slug` has to
// reproduce row for row (`tests_dmd_doc_markdown.sysl` asks it to).
//
// **Where the answers came from**: juicer-core 0.4.6 (the version `sysl-doc` 0.0.152 links), its
// `slugifyFor("github")` -- the function a page's `slugStyle: github` selects -- called on the JVM on
// each input, on 2026-09-30. juicer is a Scala library this compiler cannot link, so the answers are
// committed rather than asked for at test time; a juicer release that moves one is a row to re-derive.
//
// Three sets of rows: the heading shapes the reference's `SlugConformanceTests` names; every character
// from U+0020 to U+02FF alone and between an `a` and a `b`, which is that suite's sweep; and every
// `##` and `###` heading the reference's pages carry for the standard library and for
// `sysl-lang/parsing`, plus the three group titles this generator added.

dmd_slug_shapes() -> Buf[(string, string)]
    var rows: Buf[(string, string)] = buf()

    rows.push(("buf", "buf"))
    rows.push(("Buf", "buf"))
    rows.push(("parse_int", "parse_int"))
    rows.push(("starts_with", "starts_with"))
    rows.push(("Buf[T]", "buft"))
    rows.push(("[N]T", "nt"))
    rows.push(("Display for Vec2", "display-for-vec2"))
    rows.push(("Iterator[T] for Chars", "iteratort-for-chars"))
    rows.push(("sysl.text", "sysltext"))
    rows.push(("from_utf8_lossy", "from_utf8_lossy"))
    rows.push(("u8", "u8"))
    rows.push(("Index & IndexMut", "index--indexmut"))
    rows.push(("a  b", "a--b"))
    rows.push(("-leading-and-trailing-", "-leading-and-trailing-"))
    rows.push(("Grid Cell", "grid-cell"))
    rows.push(("", ""))
    rows
end dmd_slug_shapes

