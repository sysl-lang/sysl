module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.math.bigint.{BigInt, from_int}

// **Putting something on the heap**: the box a `&T` is, the buffer a sized run of elements is, and
// the view of one.
//
// Both are the same header -- a strong count, the hook that destroys the object, and a weak count --
// so the runtime works the same whatever it is holding and an object frees itself into whichever
// heap made it. A buffer adds the element count in front of the elements, because the hook is what
// destroys them and the hook is reached with no static type in sight. A box no code reaches without
// its type keeps the strong count alone (`compact_box.sysl`).

// Puts a value on the heap: one count for the reference this yields, the hook that will destroy it,
// and a copy of the payload -- whose own references the box now holds a share of.
gen_box(e: *Emit, value: TExpr, ref_ty: Type) -> Val
    if frame_boxed(e, value) then return gen_frame_box(e, value, ref_ty)

    val inner = ref_inner(ref_ty)

    // A large payload is written into the box rather than produced and then stored into it, for the
    // reason every other destination has: the value would be a first-class aggregate of kilobytes
    // for the length of one instruction. The address is not known until the box exists, so this is
    // the one destination that cannot be handed over before the expression runs.
    val large = e.layout.indirect(inner)
    val v = if large then VNothing else gen_expr(e, value)
    val zeroed = large && lays_bytes(e) && worth_zeroing(e, value, inner)
    val opened = open_box_zeroed(e, inner, zeroed)
    val slot = opened.1

    // **A payload that occupies nothing is not stored at all** -- a closure that captures nothing, an
    // empty struct. Its slot is one past the header, which is one past the end of the allocation, and
    // a zero-byte store there is one AddressSanitizer reports at `-O0`.
    //
    // A payload written into zeroed storage writes none of its zeros: the slot is marked for as long
    // as the payload is being written, and only for that long, since the same register name means
    // nothing once this body moves on.
    if large
        val mark = e.zeroed.len()

        if zeroed
            slot match
                VReg(n) -> e.zeroed.push(n)
                _ -> ()

        gen_into(e, slot, value)
        e.zeroed.truncate(mark)
    else if e.layout.size(inner) > 0
        retain_moving(e, value, inner, v, false)
        emit(e, InStore(lty(e, inner), v, slot, AccPlain, None))

    shared_box_payload(e, ref_ty, inner, slot)
    own_temp(e, opened.0, ref_ty)
end gen_box

// **A `&sync` box's strings are put in bytes with an atomic count before anyone else can reach it**
// (`emit_cross.sysl`'s `share_payload`), wherever a box is filled: from an expression here, or from a
// payload a `match` arm moves out of its scrutinee (`emit_pattern.sysl`'s `payload_move`).
shared_box_payload(e: *Emit, ref_ty: Type, inner: Type, slot: Val) = repr(ref_ty) match
    Ref(_, sync) -> if sync then share_payload(e, inner, slot)
    _ -> ()

// **Whether a box is worth taking zeroed**: where its payload's zeros fill at least a page, or are the
// whole of it. A zeroing call costs a small block what writing its zeros would have, so below a page
// only a payload with nothing else in it is taken that way; at a page and over, the block's zeros are
// pages the system has not yet handed over, and writing them is what hands them over.
private worth_zeroing(e: *Emit, value: TExpr, inner: Type) -> bool
    val zeros = zero_bytes(e, value)

    zeros > 0 && (zeros >= 4096 || zeros >= e.layout.size(inner))
end worth_zeroing

// How many of the bytes a value built in place writes are zeros the building leaves alone when its
// storage is zeroed already: the parts `gen_borrowed_into` walks into, down to the ones that are zero
// bits whole.
private zero_bytes(e: *Emit, x: TExpr) -> usize
    if zero_bit_expr(x) then return e.layout.size(texpr_type(x))

    *x.kind match
        TStructNew(decl, args) if plain_layout(decl) ->
            var n: usize = 0

            for a in args
                n += zero_bytes(e, a)

            n
        TArrayLit(elems, _) ->
            var n: usize = 0

            for a in elems
                n += zero_bytes(e, a)

            n
        _ -> 0
end zero_bytes

// A struct whose fields each have storage of their own, written one by one: not a union, and with no
// bits packed into a shared container.
private plain_layout(decl: &StructType) -> bool =
    !decl.union_layout && decl.c_bits.is_empty() && bitfield_ranges_of(Struct(decl)).is_none()

// Whether a value is zero bits whole, read off the tree before anything is generated: a zero of any
// scalar -- `+0.0` and not `-0.0`, whose sign bit is set -- `null`, `false`, a type's zero value, and
// fills, arrays and plain structs of nothing else.
zero_bit_expr(x: TExpr) -> bool = *x.kind match
    TIntLit(v, ty) ->
        underlying(ty) match
            Integer(_, _, _) -> v == from_int(0)
            _ -> false
    TBoolLit(b) -> !b
    TFloatLit(bits, _) -> bits == 0
    TNullLit(_) -> true
    TZero(_) -> true
    TArrayFill(v, _) -> zero_bit_expr(v)
    TArrayLit(elems, _) ->
        for item in elems
            if !zero_bit_expr(item) then return false

        true
    TStructNew(decl, args) ->
        if !plain_layout(decl) then return false

        for item in args
            if !zero_bit_expr(item) then return false

        true
    _ -> false

// A fill's value, generated once as the form promises, and answered as `zeroinitializer` where the
// tree says it is zero bits whole -- which a value that reached its type through an instruction (an
// `f32` literal is a `double` truncated) does not say of itself.
fill_value(e: *Emit, value: TExpr) -> Val
    val v = gen_expr(e, value)

    // Only where the fill is laid as bytes: an element-by-element store needs the value in its own
    // type, which `zeroinitializer` is not for a scalar.
    if lays_bytes(e) && zero_bit_expr(value) then VZero else v
end fill_value

// Whether the storage `dest` addresses is known to be zero bytes (`Emit.zeroed`).
is_zeroed(e: *Emit, dest: Val) -> bool = dest match
    VReg(n) ->
        for item in e.zeroed
            if item == n then return true

        false
    _ -> false

// Marks `p` -- a field or an element of `dest` -- as zeroed where `dest` is.
inherit_zeroed(e: *Emit, dest: Val, p: Val)
    if !is_zeroed(e, dest) then return

    p match
        VReg(n) -> e.zeroed.push(n)
        _ -> ()

// Whether a box is one the analysis laid in the frame: around a closure literal nothing reaches
// after the frame, or after the turn of a loop that builds it (`closure_mode.sysl`'s `framed_box`).
private frame_boxed(e: *Emit, value: TExpr) -> bool = *value.kind match
    TStructNew(st, _) -> e.framed_closures.has(st.base)
    _ -> false

// **A box laid in the frame** (`docs/design/closures.md` decision 8): the header and the payload a
// heap box has, in a slot of the frame, so a `&Fn` handed to a callee that only calls it allocates
// nothing. It is counted exactly as a heap box is -- a callee that takes a share and gives it back
// touches the slot's count -- and the last release runs the hook, which lets go of what the payload
// holds and gives no storage back: a payload holding nothing has no hook at all, which the runtime
// reads as nothing to do. Nothing reaches the box after the frame, nor after the turn of a loop that
// built it, so the slot is never asked about once it has been reused or given up.
private gen_frame_box(e: *Emit, value: TExpr, ref_ty: Type) -> Val
    val inner = ref_inner(ref_ty)
    val bn = box_lty(e, inner)
    val p = emit_alloca(e, fresh_reg(e), bn, box_storage_align(e, inner))
    val holds = owns_value(e, inner) || destructor_of(e, inner).is_some()
    val hook = if holds then VGlobal(request_helper(e, s"arc.dropframe.${mangle(inner)}", HrFrameDrop(inner)))
               else VNull

    emit(e, InStore(word_lty(e), VInt(from_int(1)), p, AccPlain, None))
    store_header_word(e, bn, p, 1, LPtr, hook)
    store_header_word(e, bn, p, 2, word_lty(e), VInt(from_int(1)))

    val slot = fresh_reg(e)

    var idx: Buf[IrArg] = buf()

    idx.push(ir_arg(l_i32(), VInt(from_int(0))))
    idx.push(ir_arg(l_i32(), VInt(from_int(long(box_payload_field(e, inner))))))
    emit(e, InGep(slot, bn, p, idx))

    if e.layout.indirect(inner) then gen_into(e, slot, value)
    else if e.layout.size(inner) > 0
        val v = gen_expr(e, value)

        retain_moving(e, value, inner, v, false)
        emit(e, InStore(lty(e, inner), v, slot, AccPlain, None))
    end if

    shared_box_payload(e, ref_ty, inner, slot)
    own_temp(e, p, ref_ty)
end gen_frame_box

// A box for `inner` with its header written and its payload not yet: the box, and the address its
// payload goes at. `gen_box` fills it from an expression; a `match` arm moving a large payload out of
// its scrutinee fills it straight from that storage (`payload_move`). Whoever fills it owns the box
// with `own_temp`.
open_box(e: *Emit, inner: Type) -> (Val, Val) = open_box_zeroed(e, inner, false)

// The same, over storage that is all zero bytes before the header is written where `zeroed` asks
// (`heap_call`).
private open_box_zeroed(e: *Emit, inner: Type, zeroed: bool) -> (Val, Val)
    val bn = box_lty(e, inner)
    val p = allocate_box(e, bn, inner, zeroed)

    emit(e, InStore(word_lty(e), VInt(from_int(1)), p, AccPlain, None))

    // One weak share stands for every strong reference together, so the storage outlives the object
    // exactly as long as some weak reference is still asking about it. A compact box has neither word
    // (`compact_box.sysl`).
    if !is_compact(e, inner)
        store_header_word(e, bn, p, 1, LPtr, drop_fn(e, inner))
        store_header_word(e, bn, p, 2, word_lty(e), VInt(from_int(1)))

    val slot = fresh_reg(e)

    var idx: Buf[IrArg] = buf()

    idx.push(ir_arg(l_i32(), VInt(from_int(0))))
    idx.push(ir_arg(l_i32(), VInt(from_int(long(box_payload_field(e, inner))))))
    emit(e, InGep(slot, bn, p, idx))
    (p, slot)
end open_box_zeroed

// The bytes one box occupies, asked of LLVM rather than computed here: a `getelementptr` one past
// null, read back as an integer, is the size of what was stepped over.
//
// **A null answer traps here, before anything is stored** (`reference/memory.md § An allocation that
// may fail`); `try_heap` asks `box_heap_call` itself and branches on the answer instead.
private allocate_box(e: *Emit, bn: LType, inner: Type, zeroed: bool) -> Val
    val asked = box_heap_call(e, bn, inner, zeroed)
    val p = asked.0
    val got = fresh_reg(e)

    emit(e, InIntCmp(got, INe, LPtr, p, VNull))
    trap_unless(e, got, "alloc")
    clear_unless_zeroed(e, p, asked.1, inner, zeroed)
    p
end allocate_box

// The heap's answer for one box of `inner` -- which may be null -- and the size it was asked for.
private box_heap_call(e: *Emit, bn: LType, inner: Type, zeroed: bool) -> (Val, Val)
    val size = lty_size(e, bn)

    (heap_call(e, size, inner, "a box", zeroed), size)

// The bytes a value of LLVM type `t` occupies, asked of LLVM rather than computed here: a
// `getelementptr` one past null, read back as an integer, is the size of what was stepped over.
lty_size(e: *Emit, t: LType) -> Val
    val end = fresh_reg(e)

    var idx: Buf[IrArg] = buf()

    idx.push(ir_arg(l_i32(), VInt(from_int(1))))
    emit(e, InGep(end, t, VNull, idx))

    val size = fresh_reg(e)

    emit(e, InCast(size, CastPtrToInt, LPtr, end, word_lty(e)))
    size
end lty_size

// `try_heap(v)`: the box `gen_box` makes, as `Some(box)`, where the heap answered -- and `None`, with
// nothing stored and no count taken, where it answered null. The value is produced before the heap is
// asked, so a temporary it made is released at the statement's end on either arm; the box takes its
// own share of what the value holds (`retain_value`) on the arm that has a box, rather than taking a
// temporary's share over, which the other arm would then have to give back.
gen_try_heap(e: *Emit, boxed: TExpr, opt_ty: Type) -> Val
    val (value, ref_ty) = *boxed.kind match
        TBox(v, rt) -> (v, rt)
        _ -> return gap_at(e, "a fallible box over something that is not a box")

    val d = enum_decl(opt_ty)

    if d.is_none() then return gap_at(e, "a fallible box whose answer is not an option")

    val some = d.unwrap().variant("Some")
    val none = d.unwrap().variant("None")

    if some.is_none() || none.is_none() then return gap_at(e, "a fallible box whose option has no variants")

    val inner = ref_inner(ref_ty)
    val v = gen_expr(e, value)
    val olt = lty(e, opt_ty)
    val result = alloca(e, fresh_reg(e), olt)
    val bn = box_lty(e, inner)
    val p = box_heap_call(e, bn, inner, false).0
    val got = fresh_reg(e)
    val given = fresh_label(e, "trybox.given")
    val refused = fresh_label(e, "trybox.refused")
    val joined = fresh_label(e, "trybox.end")

    emit(e, InIntCmp(got, INe, LPtr, p, VNull))
    emit_term(e, InCondBr(got, given, refused))
    emit_label(e, given)
    emit(e, InStore(word_lty(e), VInt(from_int(1)), p, AccPlain, None))

    // As `open_box_zeroed` writes it: a compact box has the strong count alone (`compact_box.sysl`).
    if !is_compact(e, inner)
        store_header_word(e, bn, p, 1, LPtr, drop_fn(e, inner))
        store_header_word(e, bn, p, 2, word_lty(e), VInt(from_int(1)))

    if e.layout.size(inner) > 0
        val slot = fresh_reg(e)

        var idx: Buf[IrArg] = buf()

        idx.push(ir_arg(l_i32(), VInt(from_int(0))))
        idx.push(ir_arg(l_i32(), VInt(from_int(long(box_payload_field(e, inner))))))
        emit(e, InGep(slot, bn, p, idx))
        retain_value(e, inner, v)
        emit(e, InStore(lty(e, inner), v, slot, AccPlain, None))
    end if

    var carried: Buf[Val] = buf()

    carried.push(p)
    emit(e, InStore(olt, enum_value(e, opt_ty, d.unwrap(), some.unwrap(), carried), result, AccPlain, None))
    emit_term(e, InBr(joined))
    emit_label(e, refused)

    var empty: Buf[Val] = buf()

    emit(e, InStore(olt, enum_value(e, opt_ty, d.unwrap(), none.unwrap(), empty), result, AccPlain, None))
    emit_term(e, InBr(joined))
    emit_label(e, joined)

    val r = fresh_reg(e)

    emit(e, InLoad(r, olt, result, AccPlain, None))
    own_temp(e, r, opt_ty)
end gen_try_heap

// The call that takes `size` bytes from the heap for storage of `t`, on the boundary `block_align`
// says (`heap_take`).
//
// `what` is how the refusal names the storage, where libc's pair cannot answer the boundary
// (`unaligned_heap`).
//
// **`zeroed` asks for storage that is all zero bytes**, which is the heap's zeroing call where it has
// one (`calloc_symbol`): a large block comes from pages the system has not yet handed over, and a fill
// of zeros written into them would hand every one of them over. Beside a pair a package named, which
// promises no zeroing half, the block is taken as usual and cleared with one `memset`. Only a target
// with a C library under it asks (`lays_bytes`): a bare machine's `malloc` may be the program's own,
// with neither `calloc` nor `memset` beside it.
private heap_call(e: *Emit, size: Val, t: Type, what: string, zeroed: bool) -> Val
    val p = fresh_reg(e)

    var args: Buf[IrArg] = buf()

    val zeroing = if zeroed then zeroing_call(e, t) else None

    if zeroing.is_some()
        e.uses_calloc = true
        args.push(ir_arg(word_lty(e), VInt(from_int(1))))
        args.push(ir_arg(word_lty(e), size))
        emit(e, ir_call(Some(p), LPtr, VGlobal(zeroing.unwrap()), args))
        return p
    end if

    val a = e.layout.align(t)

    heap_take(e, p, size, block_align(e, t),
              s"$what of '${type_show(t)}' asks for the $a-byte boundary its type is aligned on")
end heap_call

// The boundary a block holding `t` is taken on and given back with: the type's own, and never less
// than the word every header begins with.
block_align(e: *Emit, t: Type) -> usize
    val word = e.layout.pointer_bytes()
    val a = e.layout.align(t)

    if a > word then a else word
end block_align

// **The one call that takes a block from the heap**, into `p`: `size` bytes on `align`.
//
// A pair that is told sizes (`heap_sized`) is called `alloc(size, align)` for every block. libc's is
// called as libc declares it, `malloc(size)`, where `align` is within what `malloc` promises
// (`heap_align`), and a block past that comes from the C library's aligned allocation through
// `sysl.heap.alloc_aligned` (`request_aligned_heap`) -- which `said` describes to the refusal where
// there is none (`unaligned_heap`).
heap_take(e: *Emit, p: Val, size: Val, align: usize, said: string) -> Val
    var args: Buf[IrArg] = buf()

    args.push(ir_arg(word_lty(e), size))

    if heap_sized()
        args.push(ir_arg(word_lty(e), VInt(from_int(long(align)))))
        emit(e, ir_call(Some(p), LPtr, VGlobal(malloc_symbol()), args))
    else if align > e.layout.heap_align()
        args.push(ir_arg(word_lty(e), VInt(from_int(long(align)))))
        emit(e, ir_call(Some(p), LPtr, VGlobal(aligned_alloc_symbol()), args))
        note_aligned_heap(e, said, align)
    else
        emit(e, ir_call(Some(p), LPtr, VGlobal(malloc_symbol()), args))

    p
end heap_take

// **The one call that gives a block back**: the one at `p`, taken with `size` bytes on `align` --
// `free(p, size, align)` to a pair told sizes, and `free(p)` (or `sysl.heap.free_aligned(p)` past
// `malloc`'s boundary) to libc's, which is the one case `size` may be `VNothing`.
heap_give(e: *Emit, p: Val, size: Val, align: usize)
    var args: Buf[IrArg] = buf()

    args.push(ir_arg(LPtr, p))

    if heap_sized()
        args.push(ir_arg(word_lty(e), size))
        args.push(ir_arg(word_lty(e), VInt(from_int(long(align)))))
        emit(e, ir_call(None, LVoid, VGlobal(free_symbol()), args))
    else if align > e.layout.heap_align()
        e.aligned_frees = true
        emit(e, ir_call(None, LVoid, VGlobal(aligned_free_symbol()), args))
    else
        emit(e, ir_call(None, LVoid, VGlobal(free_symbol()), args))
end heap_give

// The same two calls as text, for the runtime blocks written by hand: `%dest = …` taking `size` (a
// register or a constant, written as it stands) bytes on `align`, and the call giving `p` back. A
// block written by hand never asks past `malloc`'s boundary, so libc's pair is called as it is.
heap_take_text(e: *Emit, dest: string, size: string, align: usize) -> string
    val w = s"i${e.word_bits}"

    if heap_sized() then s"  $dest = call ptr @${malloc_symbol()}($w $size, $w $align)\n"
    else s"  $dest = call ptr @${malloc_symbol()}($w $size)\n"
end heap_take_text

heap_give_text(e: *Emit, p: string, size: string, align: usize) -> string
    val w = s"i${e.word_bits}"

    if heap_sized() then s"  call void @${free_symbol()}(ptr $p, $w $size, $w $align)\n"
    else s"  call void @${free_symbol()}(ptr $p)\n"
end heap_give_text

// The bytes a buffer of `n` elements of `elem` occupies: its header, any pad, and the elements --
// what `gen_buffer` took, without the overflow checks, since a buffer that exists already fit.
buffer_bytes(e: *Emit, elem: Type, n: Val) -> Val
    val esz = lty_size(e, stride_lty(e, elem))
    val h1 = fresh_reg(e)

    var hidx: Buf[IrArg] = buf()

    hidx.push(ir_arg(l_i32(), VInt(from_int(0))))
    hidx.push(ir_arg(l_i32(), VInt(from_int(long(buf_elems_field(e, elem))))))
    emit(e, InGep(h1, buf_lty(e, elem), VNull, hidx))

    val hsz = fresh_reg(e)

    emit(e, InCast(hsz, CastPtrToInt, LPtr, h1, word_lty(e)))

    val bytes = fresh_reg(e)
    val total = fresh_reg(e)

    emit(e, InBin(bytes, OpMul, word_lty(e), n, esz))
    emit(e, InBin(total, OpAdd, word_lty(e), bytes, hsz))
    total
end buffer_bytes

// **The word slot storage carries in front of its header** where the pair is told sizes: the
// storage's fourth header word is the live prefix the slot forms move (`slots.sysl`), not the length
// it was made with, so that length is laid one boundary before the header -- far enough that the
// header still begins on the block's boundary -- and the hook gives the block back from there
// (`emit_arc.sysl`'s `slot_buf_free`). Nothing in front where libc's pair needs no size.
slot_lead(e: *Emit, elem: Type) -> usize = if heap_sized() then block_align(e, elem) else 0

// The zeroing call a block for `t` is taken with, where there is one to take it with: not for storage
// the aligned hook makes, and not on a machine with no C library promised under it.
private zeroing_call(e: *Emit, t: Type) -> Option[string] =
    if e.layout.beyond_heap(t) || !os_hosted(e.target.os) then None else calloc_symbol()

// What a block asked for zeroed still needs once the heap answered it and the answer was checked: one
// `memset` where it was not taken with the zeroing call.
private clear_unless_zeroed(e: *Emit, p: Val, size: Val, t: Type, zeroed: bool)
    if zeroed && zeroing_call(e, t).is_none() then emit_memset(e, p, 0, size, int(e.layout.align(t)))

// Records the first storage this module took from the aligned hook: what the refusal says about it,
// the function that made it, and the boundary.
note_aligned_heap(e: *Emit, said: string, boundary: usize)
    if e.aligned_heap.is_empty() then e.aligned_heap.push((said, e.self_name, boundary))

private store_header_word(e: *Emit, bn: LType, p: Val, field: int, ty: LType, v: Val)
    val r = fresh_reg(e)

    var idx: Buf[IrArg] = buf()

    idx.push(ir_arg(l_i32(), VInt(from_int(0))))
    idx.push(ir_arg(l_i32(), VInt(from_int(long(field)))))
    emit(e, InGep(r, bn, p, idx))
    emit(e, InStore(ty, v, r, AccPlain, None))
end store_header_word

// The inner type of a `&T`, or the type itself where it is not one -- which nothing reaching here
// should be, and which answers something rather than stopping the walk if it is.
ref_inner(t: Type) -> Type = underlying(t) match
    Ref(inner, _) -> *inner
    _ -> t

// -- a buffer, and the view of one ---------------------------------------------------------------------

// The box that holds `n` elements sized while running, and the address its elements start at.
//
// The size is computed with the checked forms: a count the program worked out can be anything, and
// a multiplication that wrapped would ask for a block far smaller than the elements written into
// it.
gen_buffer(e: *Emit, elem: Type, n: Val) -> (Val, Val) = gen_buffer_zeroed(e, elem, n, false)

// The same, with every element's bytes zero before anything is written into them where `zeroed`
// asks (`heap_call`): a fill of zeros, which then writes nothing.
gen_buffer_zeroed(e: *Emit, elem: Type, n: Val, zeroed: bool) -> (Val, Val) = gen_buffer_led(e, elem, n, zeroed, 0)

// The buffer `slot_storage` makes, with the length it was made with laid in front of it where the
// pair is told sizes (`slot_lead`).
gen_slot_buffer(e: *Emit, elem: Type, n: Val) -> (Val, Val) = gen_buffer_led(e, elem, n, false, slot_lead(e, elem))

// The buffer, `lead` bytes into its block: the block is taken that much longer, its first word holds
// `n`, and the box begins after the lead.
private gen_buffer_led(e: *Emit, elem: Type, n: Val, zeroed: bool, lead: usize) -> (Val, Val)
    val sized = buffer_size(e, elem, n, lead)

    trap_unless(e, sized.1, "size")

    val block = heap_call(e, sized.0, elem, "a buffer", zeroed)
    val got = fresh_reg(e)

    emit(e, InIntCmp(got, INe, LPtr, block, VNull))
    trap_unless(e, got, "alloc")
    clear_unless_zeroed(e, block, sized.0, elem, zeroed)

    val p = past_lead(e, block, n, lead)

    (p, buffer_header(e, elem, p, n))
end gen_buffer_led

// The box in a block taken `lead` bytes longer than it: the block's first word holds `n`, and the box
// begins after the lead. With no lead the block is the box.
private past_lead(e: *Emit, block: Val, n: Val, lead: usize) -> Val
    if lead == 0 then return block

    emit(e, InStore(word_lty(e), n, block, AccPlain, None))

    val p = fresh_reg(e)

    var lidx: Buf[IrArg] = buf()

    lidx.push(ir_arg(word_lty(e), VInt(from_int(long(lead)))))
    emit(e, InGep(p, LInt(8), block, lidx))
    p
end past_lead

// **`slot_storage`'s box where the heap may refuse it**, for `try_slot_storage`: the box, the address
// its elements start at, and whether there is one. The block carries the same lead `gen_slot_buffer`
// lays in front of the box (`slot_lead`). A size that does not fit in a word asks the heap for nothing
// and answers as a refusal does; so does a null from the heap. The lead and the header are written on
// the arm that has a block to write them into, so the box and the address mean something only where
// the flag is true, and the caller branches on it in the block this leaves it in.
gen_try_buffer(e: *Emit, elem: Type, n: Val) -> (Val, Val, Val)
    val lead = slot_lead(e, elem)
    val sized = buffer_size(e, elem, n, lead)
    val p_slot = alloca(e, fresh_reg(e), LPtr)
    val ask = fresh_label(e, "trybuf.ask")
    val after = fresh_label(e, "trybuf.end")

    emit(e, InStore(LPtr, VNull, p_slot, AccPlain, None))
    emit_term(e, InCondBr(sized.1, ask, after))
    emit_label(e, ask)

    val asked = heap_call(e, sized.0, elem, "a buffer", false)

    emit(e, InStore(LPtr, asked, p_slot, AccPlain, None))
    emit_term(e, InBr(after))
    emit_label(e, after)

    val p = fresh_reg(e)

    emit(e, InLoad(p, LPtr, p_slot, AccPlain, None))

    val got = fresh_reg(e)

    emit(e, InIntCmp(got, INe, LPtr, p, VNull))

    val write = fresh_label(e, "trybuf.write")
    val done = fresh_label(e, "trybuf.done")
    val box_slot = alloca(e, fresh_reg(e), LPtr)
    val data_slot = alloca(e, fresh_reg(e), LPtr)

    emit(e, InStore(LPtr, VNull, box_slot, AccPlain, None))
    emit(e, InStore(LPtr, VNull, data_slot, AccPlain, None))
    emit_term(e, InCondBr(got, write, done))
    emit_label(e, write)

    val boxed = past_lead(e, p, n, lead)

    emit(e, InStore(LPtr, boxed, box_slot, AccPlain, None))
    emit(e, InStore(LPtr, buffer_header(e, elem, boxed, n), data_slot, AccPlain, None))
    emit_term(e, InBr(done))
    emit_label(e, done)

    val box = fresh_reg(e)
    val data = fresh_reg(e)

    emit(e, InLoad(box, LPtr, box_slot, AccPlain, None))
    emit(e, InLoad(data, LPtr, data_slot, AccPlain, None))
    (box, data, got)
end gen_try_buffer

// The bytes a buffer of `n` elements occupies, header and `lead` included, and whether that fits in a
// word: the size is computed with the checked forms, since a count the program worked out can be
// anything, and a multiplication that wrapped would ask for a block far smaller than the elements
// written into it.
private buffer_size(e: *Emit, elem: Type, n: Val, lead: usize) -> (Val, Val)
    val bn = buf_lty(e, elem)

    e.checked = true

    val e1 = fresh_reg(e)

    var eidx: Buf[IrArg] = buf()

    eidx.push(ir_arg(LInt(64), VInt(from_int(1))))
    emit(e, InGep(e1, stride_lty(e, elem), VNull, eidx))

    val esz = fresh_reg(e)

    emit(e, InCast(esz, CastPtrToInt, LPtr, e1, word_lty(e)))

    val h1 = fresh_reg(e)

    var hidx: Buf[IrArg] = buf()

    hidx.push(ir_arg(l_i32(), VInt(from_int(0))))
    hidx.push(ir_arg(l_i32(), VInt(from_int(long(buf_elems_field(e, elem))))))
    emit(e, InGep(h1, bn, VNull, hidx))

    val hsz = fresh_reg(e)

    emit(e, InCast(hsz, CastPtrToInt, LPtr, h1, word_lty(e)))

    val bytes = size_op(e, "mul", n, esz)
    val boxed = size_op(e, "add", bytes.0, hsz)
    val total = if lead == 0 then boxed else size_op(e, "add", boxed.0, VInt(from_int(long(lead))))
    val over = fresh_reg(e)

    emit(e, InBin(over, OpOr, l_i1(), bytes.1, boxed.1))

    var wrapped = over

    if lead > 0
        wrapped = fresh_reg(e)
        emit(e, InBin(wrapped, OpOr, l_i1(), over, total.1))

    val fits = fresh_reg(e)

    emit(e, InBin(fits, OpXor, l_i1(), wrapped, VBool(true)))
    (total.0, fits)
end buffer_size

// A buffer's header written into the box the heap answered -- one strong count, the hook, one weak
// share, the length -- and the address its elements start at.
private buffer_header(e: *Emit, elem: Type, p: Val, n: Val) -> Val
    val bn = buf_lty(e, elem)

    emit(e, InStore(word_lty(e), VInt(from_int(1)), p, AccPlain, None))
    store_header_word(e, bn, p, 1, LPtr, drop_buf_fn(e, elem))
    store_header_word(e, bn, p, 2, word_lty(e), VInt(from_int(1)))
    store_header_word(e, bn, p, header_fields(), word_lty(e), n)

    val data = fresh_reg(e)

    var didx: Buf[IrArg] = buf()

    didx.push(ir_arg(l_i32(), VInt(from_int(0))))
    didx.push(ir_arg(l_i32(), VInt(from_int(long(buf_elems_field(e, elem))))))
    emit(e, InGep(data, bn, p, didx))
    data
end buffer_header

// One step of a size computation, with the overflow flag beside the answer. The intrinsic carries
// its width in the **name** as well as in the signature, so a size computed at the machine's own
// width has to name the matching overload.
//
// **The declaration is `e.checked`'s and not asked for here**, which is what puts it among the ones
// the module writes for itself rather than after the `extern`s a program declared. The two are the
// same line wherever both appear; where they sit is what a whole-file comparison sees.
private size_op(e: *Emit, op: string, a: Val, b: Val) -> (Val, Val)
    val w = word_lty(e)
    val fn = llvm_with_overflow(op, false, w)

    var pair_fields: Buf[LType] = buf()

    pair_fields.push(w)
    pair_fields.push(l_i1())

    val both = LStruct(pair_fields)

    var params: Buf[IrParam] = buf()

    params.push(ir_param(w))
    params.push(ir_param(w))

    var args: Buf[IrArg] = buf()

    args.push(ir_arg(w, a))
    args.push(ir_arg(w, b))

    val pair = fresh_reg(e)

    emit(e, ir_call(Some(pair), both, VGlobal(fn), args))

    val v = fresh_reg(e)

    emit(e, InExtract(v, both, pair, index_list(0)))

    val ovf = fresh_reg(e)

    emit(e, InExtract(ovf, both, pair, index_list(1)))
    (v, ovf)
end size_op

// The view of a whole buffer: the box keeps the elements alive, and the one count it was made with
// is the count this view holds.
buffer_view(e: *Emit, slice_ty: Type, box: Val, data: Val, n: Val) -> Val
    e.maybe_heap = true
    own_temp(e, view_parts(e, slice_ty, box, data, n), slice_ty)
end buffer_view

// **A buffer counted while running that may hold no elements is no allocation when it holds none**
// (`[v; n]`, `slot_storage(n)`): the view of nothing is the all-zero one an empty literal is -- no
// owner, so nothing to retain, release, grow from in place or free, and no element address anyone
// reads. A container made empty and filled later (`vector()` over `slot_storage(0)`) then costs what
// C++'s empty `std::vector` does. A count that is a constant zero is that view outright (the caller
// asks `is_zero_const`); any other is a test around the allocation:
//
//     val skip = skip_if_empty(e, slice_ty, n)
//     ... the allocation, and its view from `view_parts` ...
//     join_unless_empty(e, slice_ty, skip, view)
//
// The view is carried across the join in a slot of the frame, which the optimizer turns into the
// value it is; the one temporary the expression owns is registered after the join.
skip_if_empty(e: *Emit, slice_ty: Type, n: Val) -> (Val, string)
    val lt = lty(e, slice_ty)
    val slot = alloca(e, fresh_reg(e), lt)

    emit(e, InStore(lt, VZero, slot, AccPlain, None))

    val none = fresh_reg(e)
    val make_l = fresh_label(e, "buf.make")
    val done_l = fresh_label(e, "buf.made")

    emit(e, InIntCmp(none, IEq, word_lty(e), n, VInt(from_int(0))))
    emit_term(e, InCondBr(none, done_l, make_l))
    emit_label(e, make_l)
    (slot, done_l)
end skip_if_empty

// The other half of `skip_if_empty`: `view` is the buffer the taken path made.
join_unless_empty(e: *Emit, slice_ty: Type, skip: (Val, string), view: Val) -> Val
    val lt = lty(e, slice_ty)

    emit(e, InStore(lt, view, skip.0, AccPlain, None))
    emit_term(e, InBr(skip.1))
    emit_label(e, skip.1)

    val joined = fresh_reg(e)

    emit(e, InLoad(joined, lt, skip.0, AccPlain, None))
    e.maybe_heap = true
    own_temp(e, joined, slice_ty)
end join_unless_empty

// The three words of a view over a buffer, owned by nobody yet.
view_parts(e: *Emit, slice_ty: Type, box: Val, data: Val, n: Val) -> Val
    val lt = lty(e, slice_ty)
    val with_owner = fresh_reg(e)

    emit(e, InInsert(with_owner, lt, VZero, LPtr, box, index_list(0)))

    val with_ptr = fresh_reg(e)

    emit(e, InInsert(with_ptr, lt, with_owner, LPtr, data, index_list(1)))

    val whole = fresh_reg(e)

    emit(e, InInsert(whole, lt, with_ptr, word_lty(e), n, index_list(2)))
    whole
end view_parts

// -- an array whose storage a view outlives -------------------------------------------------------------

// The element type of an array, where the type is one -- which is the whole of what makes a
// declaration promotable.
promoted_elem(ty: Type) -> Option[Type] = underlying(ty) match
    Array(_, elem) -> Some(*elem)
    _ -> None

// -- the weak edge ----------------------------------------------------------------------------------

// Weakens a reference: the same address, counted in the box's third word instead of its first. The
// strong count is untouched, which is the whole point -- the edge this makes keeps nothing alive.
//
// The value is registered as an owned temporary so the region that produced it gives the weak share
// back, exactly as it would for a reference. What ends up holding it long-term is the slot it is
// stored into, which takes a share of its own when it is written.
gen_downgrade(e: *Emit, value: TExpr, weak_ty: Type) -> Val
    val v = gen_expr(e, value)

    retain_value(e, weak_ty, v)
    own_temp(e, v, weak_ty)
end gen_downgrade

// `r.into_raw()` -- the payload's address, with one count of the object taken for the pointer and
// never given back here. A reference this frame was about to give back hands its own count over, so
// `d.into_raw()` at `d`'s last use takes no count and gives none back.
gen_into_raw(e: *Emit, value: TExpr, ptr_ty: Type) -> Val
    val ref_ty = texpr_type(value)
    val v = gen_expr(e, value)

    retain_moving(e, value, ref_ty, v)
    box_payload_addr(e, v, ref_ty)
end gen_into_raw

// `from_raw(p)` -- the box a payload address `into_raw` answered sits in: the header lies a fixed
// distance before the payload, the same distance `box_payload_addr` steps forward, whichever header
// the payload's box has. **The distance is the box type's own**, read off the payload field's address
// in a box at null, so it is what LLVM laid out -- an over-aligned payload's padding included -- and
// folds to a constant. The count the pointer carried is the reference's now, so it is owned here as a
// fresh box is, and nothing is retained.
gen_from_raw(e: *Emit, ptr: TExpr, ref_ty: Type) -> Val
    val p = gen_expr(e, ptr)
    val word = word_lty(e)
    val field = box_payload_addr(e, VNull, ref_ty)
    val offset = fresh_reg(e)

    emit(e, InCast(offset, CastPtrToInt, LPtr, field, word))

    val back = fresh_reg(e)

    emit(e, InBin(back, OpSub, word, VInt(from_int(0)), offset))

    val at = fresh_reg(e)

    var idx: Buf[IrArg] = buf()

    idx.push(ir_arg(word, back))
    emit(e, InGep(at, LInt(8), p, idx))
    own_temp(e, at, ref_ty)
end gen_from_raw

// `w.get()` -- asks the box whether the object is still there. A live one comes back with a count
// taken for the caller, so what the `Some` carries is an ordinary owned reference; a dead one gives
// a null address, which is the `None`.
//
// A trait object is rebuilt around the answer rather than reused: the method table it was carrying
// is a constant that says nothing about whether the object is alive, so it is put back beside the
// address only on the arm where there is one.
gen_upgrade(e: *Emit, value: TExpr, opt_ty: Type, some: EnumVariant, none: EnumVariant) -> Val
    e.weak_heap = true

    val fat = weak_inner(texpr_type(value)).map(is_trait).unwrap_or(false)
    val v = gen_expr(e, value)
    val addr = if fat then erased_box(e, v) else v
    val d = enum_decl(opt_ty)

    if d.is_none() then return gap_at(e, "an upgrade whose option is not an enum")

    val got = fresh_reg(e)

    var args: Buf[IrArg] = buf()

    args.push(ir_arg(LPtr, addr))
    emit(e, ir_call(Some(got), LPtr, VGlobal("arc.upgrade"), args))

    val live = fresh_reg(e)

    emit(e, InIntCmp(live, INe, LPtr, got, VNull))

    val slot = alloca(e, fresh_reg(e), lty(e, opt_ty))
    val some_l = fresh_label(e, "weak.live")
    val none_l = fresh_label(e, "weak.gone")
    val end_l = fresh_label(e, "weak.end")

    emit_term(e, InCondBr(live, some_l, none_l))
    emit_label(e, some_l)

    var strong = got

    if fat
        val tbl = fresh_reg(e)

        emit(e, InExtract(tbl, l_fat(), v, index_list(0)))

        val f0 = fresh_reg(e)

        emit(e, InInsert(f0, l_fat(), VUndef, LPtr, tbl, index_list(0)))

        val f1 = fresh_reg(e)

        emit(e, InInsert(f1, l_fat(), f0, LPtr, got, index_list(1)))

        strong = f1

    var carried: Buf[Val] = buf()

    carried.push(strong)
    emit(e, InStore(lty(e, opt_ty), enum_value(e, opt_ty, d.unwrap(), some, carried), slot, AccPlain,
                    None))
    emit_term(e, InBr(end_l))
    emit_label(e, none_l)

    var empty: Buf[Val] = buf()

    emit(e, InStore(lty(e, opt_ty), enum_value(e, opt_ty, d.unwrap(), none, empty), slot, AccPlain,
                    None))
    emit_term(e, InBr(end_l))
    emit_label(e, end_l)

    val r = fresh_reg(e)

    emit(e, InLoad(r, lty(e, opt_ty), slot, AccPlain, None))
    own_temp(e, r, opt_ty)
end gen_upgrade

// `o.as[T]()` -- compares the identity the object's table begins with against `T`'s, and on a match
// hands back the object's box as a `&T`. The data word of a `&Trait` is the very box the `&T` it was
// erased from pointed at, so nothing is rebuilt: the answer is that word with a count taken for the
// caller, which makes what the `Some` carries an ordinary owned reference and the `None` arm own
// nothing at all.
gen_downcast(e: *Emit, value: TExpr, id: BigInt, ref_ty: Type, opt_ty: Type, some: EnumVariant,
             none: EnumVariant) -> Val
    val v = gen_expr(e, value)
    val d = enum_decl(opt_ty)

    if d.is_none() then return gap_at(e, "a downcast whose option is not an enum")

    val table = fresh_reg(e)

    emit(e, InExtract(table, l_fat(), v, index_list(0)))

    val held = fresh_reg(e)

    emit(e, InLoad(held, word_lty(e), table, AccPlain, None))

    val hit = fresh_reg(e)

    emit(e, InIntCmp(hit, IEq, word_lty(e), held, VInt(id)))

    val slot = alloca(e, fresh_reg(e), lty(e, opt_ty))
    val some_l = fresh_label(e, "as.hit")
    val none_l = fresh_label(e, "as.miss")
    val end_l = fresh_label(e, "as.end")

    emit_term(e, InCondBr(hit, some_l, none_l))
    emit_label(e, some_l)

    val box = erased_box(e, v)

    // A `*T` answer is the object's address as it stands: no count is kept for it, so none is taken.
    ref_ty match
        Ref(_, _) -> retain_value(e, ref_ty, box)
        _ -> ()

    var carried: Buf[Val] = buf()

    carried.push(box)
    emit(e, InStore(lty(e, opt_ty), enum_value(e, opt_ty, d.unwrap(), some, carried), slot, AccPlain,
                    None))
    emit_term(e, InBr(end_l))
    emit_label(e, none_l)

    var empty: Buf[Val] = buf()

    emit(e, InStore(lty(e, opt_ty), enum_value(e, opt_ty, d.unwrap(), none, empty), slot, AccPlain,
                    None))
    emit_term(e, InBr(end_l))
    emit_label(e, end_l)

    val r = fresh_reg(e)

    emit(e, InLoad(r, lty(e, opt_ty), slot, AccPlain, None))
    own_temp(e, r, opt_ty)
end gen_downcast

private weak_inner(ty: Type) -> Option[Type] = underlying(ty) match
    Weak(inner) -> Some(*inner)
    _ -> None

// An array a view of which gets out of this frame lives in a buffer instead of a slot, and that is
// the whole of the difference: the name still means the address of the storage, so the store and
// every later use are the ones an unpromoted array gets. What the buffer adds is an owner for the
// views to count against, and a release when the name goes out of scope.
gen_promoted_decl(e: *Emit, name: string, ty: Type, elem: Type, init: TExpr)
    val n = array_length(ty)
    val v = gen_expr(e, init)
    val made = gen_buffer(e, elem, VInt(from_int(long(n))))

    // The address is a register an instruction defines where it stands, rather than a slot in the
    // prologue -- so a declaration nothing reaches, whose instruction is dropped, takes no name.
    val own = if e.terminated then local_name(e, name) else declare_local(e, name)

    e.promoted_boxes.push((own, made.0))

    var idx: Buf[IrArg] = buf()

    idx.push(ir_arg(LInt(64), VInt(from_int(0))))
    emit(e, InGep(VReg(s"$own.addr"), lty(e, elem), made.1, idx))
    retain_value(e, ty, v)
    emit(e, InStore(lty(e, ty), v, VReg(s"$own.addr"), AccPlain, None))
    own_box(e, name, made.0, elem)
end gen_promoted_decl

private array_length(ty: Type) -> int = underlying(ty) match
    Array(n, _) -> n
    _ -> 0

// -- past `malloc`'s boundary --------------------------------------------------------------------------

// **A block libc's `malloc` cannot answer comes from the C library's aligned allocation.** Where the
// pair is libc's and a block's boundary is past what `malloc` promises (`heap_align`), it is taken by
// `sysl.heap.alloc_aligned(size, align)` and given back by `sysl.heap.free_aligned(p)`, written over
// `posix_memalign` and `free` on a POSIX system and WASI, `_aligned_malloc` and `_aligned_free` on
// Windows. A pair told sizes (`heap_sized`) needs neither: it is handed every block's boundary itself.
// Under libc's pair on a machine with no C library there is nothing to answer the boundary with, and a
// program putting such a block on its heap there is refused (`emit_checks.sysl`'s
// `check_aligned_heap`). The two are the compiler's, not hooks: a program wanting its own answer names
// a heap of its own.
aligned_alloc_symbol() -> string = "sysl.heap.alloc_aligned"

aligned_free_symbol() -> string = "sysl.heap.free_aligned"

// Whether a C library is under this target for the aligned defaults to be written over -- the ONE
// question the defaults and the refusal (`emit_checks.sysl`'s `check_aligned_heap`) ask about it.
// It is the target's `libc` capability: hosted by default, and a freestanding board whose manifest
// grants it (newlib under a Pico SDK build) gets `posix_memalign` and `free` too.
aligned_heap_has_libc(t: Target) -> bool = t.provides_libc()

// The C library's aligned pair the defaults are written over, where there is a C library.
c_aligned_pair(t: Target) -> Option[(string, string)]
    if !aligned_heap_has_libc(t) then return None
    if t.os == Windows then return Some(("_aligned_malloc", "_aligned_free"))

    Some(("posix_memalign", "free"))
end c_aligned_pair

// The storage the last module lowered made through the aligned hook with nothing to answer it --
// what it was, the function that made it, and the boundary -- or nothing. Settled by each lowering,
// and read by the driver straight after (`check_aligned_heap`).
private var unaligned: Option[(string, string, usize)] = None

unaligned_heap() -> Option[(string, string, usize)] = unaligned

// Whether this module calls either of the two (`heap_take`, `heap_give`).
aligned_heap_used(e: *Emit) -> bool = !heap_sized() && (!e.aligned_heap.is_empty() || e.aligned_frees)

// The two written, where there is a C library to write them over; otherwise what the refusal is
// about. Asked once every body is lowered, since that is when the module knows whether anything
// needed them. `weak`, so every codegen unit may carry them and the link keeps one.
request_aligned_heap(e: *Emit)
    unaligned = None

    if !aligned_heap_used(e) then return

    val c_pair = c_aligned_pair(e.target)

    if c_pair.is_none()
        if !e.aligned_heap.is_empty() then unaligned = Some(e.aligned_heap[0])

        return

    val alloc = aligned_alloc_symbol()
    val free = aligned_free_symbol()
    val names = c_pair.unwrap()
    val w = s"i${e.word_bits}"
    val pre = e.target.preemption()
    val body = if names.0 == "posix_memalign" then posix_aligned_body(w) else direct_aligned_body(names.0, w)

    request_helper(e, alloc, HrText(s"define weak ${pre}ptr @$alloc($w %size, $w %align) {\n" +
                                     "entry:\n" + body))

    // libc's `free` is already the pair's half, and declared as that; `_aligned_free` is not.
    val declared = if names.1 == "free" then "" else s"\ndeclare void @${names.1}(ptr)\n"

    request_helper(e, free, HrText(s"define weak ${pre}void @$free(ptr %p) {\n" +
                                    "entry:\n" +
                                    s"  call void @${names.1}(ptr %p)\n" +
                                    "  ret void\n" +
                                    "}\n" + declared))
end request_aligned_heap

// The aligned default's body over `posix_memalign`, which answers through an out-pointer and a code.
private posix_aligned_body(w: string) -> string =
    "  %slot = alloca ptr\n" +
    s"  %r = call i32 @posix_memalign(ptr %slot, $w %align, $w %size)\n" +
    "  %ok = icmp eq i32 %r, 0\n" +
    "  br i1 %ok, label %got, label %none\n" +
    "got:\n" +
    "  %p = load ptr, ptr %slot\n" +
    "  ret ptr %p\n" +
    "none:\n" +
    "  ret ptr null\n" +
    "}\n\n" +
    s"declare i32 @posix_memalign(ptr, $w, $w)\n"

// The same over a C function that answers the block itself, `_aligned_malloc(size, align)`.
private direct_aligned_body(name: string, w: string) -> string =
    s"  %p = call ptr @$name($w %size, $w %align)\n" +
    "  ret ptr %p\n" +
    "}\n\n" +
    s"declare ptr @$name($w, $w)\n"

// The C functions the defaults call that this module declares in their text, so nothing declares
// them twice (`codegen.sysl`'s `declares`).
aligned_default_symbols(e: *Emit) -> Buf[string]
    var out: Buf[string] = buf()

    if e.requested_set.has(aligned_alloc_symbol())
        c_aligned_pair(e.target) match
            Some(names) -> out.push(names.0)
            None -> ()

    if e.requested_set.has(aligned_free_symbol())
        c_aligned_pair(e.target) match
            Some(names) -> if names.1 != "free" then out.push(names.1)
            None -> ()

    out
end aligned_default_symbols
