// ---- ReservedWordNameTests: statements and arguments left alone

@test("a return of a closure with typed parameters is not a function misnamed")
rsv_alone_return_of_a_closure()
    if !rsv_ready() then return

    assert_eq(rsv_ran("f() -> &Fn(int) -> int\n    return (x: int) -> x * 2\n\nval g = f()\nprint(g(4))\n"),
              "8\n")

@test("a condition in parentheses is not a function misnamed")
rsv_alone_condition_in_parentheses()
    if !rsv_ready() then return

    assert_eq(rsv_ran("val n = 3\nif (n > 1) then print(1) else print(0)\nwhile (false)\n    print(2)\n"),
              "1\n")

@test("a 'true' or 'else' arm in a match is not a pattern misnamed")
rsv_alone_true_or_else_arm()
    if !rsv_ready() then return

    assert_eq(rsv_ran("val b = true\nb match\n    true -> print(1)\n    else print(0)\n"), "1\n")

@test("a reserved-word literal beginning an argument is left alone")
rsv_alone_literal_argument()
    if !rsv_ready() then return

    assert_eq(rsv_ran("f(x: bool) -> int = if x then 1 else 0\n\nmain()\n    print(f(true))\n"), "1\n")

@test("a conditional beginning an argument is left alone")
rsv_alone_conditional_argument()
    if !rsv_ready() then return

    assert_eq(rsv_ran("f(n: int) -> int = n\n\nmain()\n    print(f(if true then 7 else 8))\n"), "7\n")

@test("a call whose whole argument list is a reserved word is left alone")
rsv_alone_whole_argument_list()
    if !rsv_ready() then return

    assert_eq(rsv_ran("f(x: bool) -> int = if x then 1 else 0\n\nmain()\n    print(f(false))\n"), "0\n")

// ---- ReservedWordNameTests: the backticked form is a name

@test("a backticked reserved word as a field, constructed and selected")
rsv_quoted_field()
    if !rsv_ready() then return

    assert_eq(rsv_ran("struct S\n    a: int\n    `val`: int\n\nmain()\n    var s = S(1, 2)\n    print(s.`val`)\n"),
              "2\n")

@test("a backticked reserved word as a parameter, called by position")
rsv_quoted_parameter()
    if !rsv_ready() then return

    assert_eq(rsv_ran("f(`val`: int) -> int = `val` + 1\n\nmain()\n    print(f(1))\n"), "2\n")

@test("a backticked reserved word as a function, a method and a 'val'")
rsv_quoted_function_method_val()
    if !rsv_ready() then return

    val text = "`loop`() -> int = 1\nstruct H\n    n: int\n    `ref`(self) -> int = self.n\n" +
               "val `type` = `loop`() + H(2).`ref`()\nprint(`type`)\n"

    assert_eq(rsv_ran(text), "3\n")
