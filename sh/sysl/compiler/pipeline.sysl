module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.fs.read_bytes
import sysl.text.Search

// What a build asks of LLVM **beyond the level**: link-time optimization, and a profile to be written
// or read. The reference carries the three as one value, `Pipeline`, for the reason that decides
// everything here -- a build is several clang invocations (the module's text or each of its codegen
// units, each C file a tree carries, the standard module's own rebuild, and the link), and every lever
// has to reach **all** of them or it does the wrong thing quietly:
//
//   - `-flto=thin` on the link alone links native objects and optimizes nothing across them; on the
//     module alone it leaves the C a package carries as ordinary objects, so the inlining across the
//     sysl/C seam that is the point of asking never happens, and the build still succeeds.
//   - `-fprofile-generate` on the compile and not the link does not link; on the link and not the
//     compile it links a profile runtime that counts nothing and writes an empty `.profraw`.
//
// So the levers are read once, by the command line and the root manifest, and every clang line asks
// `pipeline_flags()` for the same list -- the same reasoning `search_paths.sysl` gives for keeping
// where things are as module storage rather than threading it through forty signatures.
//
// **`lto` is the one lever that is a property of the PROJECT**: a manifest may state it as it states
// its level, and `--lto` beats the manifest as `-O` does. The profile levers are never manifest keys --
// a profile is one machine's measurement, and a path to it in a file a consumer reads is wrong for
// everybody but its author. **`build-c` takes no manifest `lto`**: the key says how this project's own
// link is done, `build-c` does no link, and a bitcode archive is one GNU ld cannot read.

// The modes `--lto` and the `lto` key take. **Two and no more**: `-flto` on its own is clang's
// spelling of `full`, and a key read by a consumer who did not write it is better for saying which.
val LtoModes: []const string = ["thin", "full"]

// What the command line named, each as written.
private var pl_lto_flag: Option[string] = None
private var pl_generate: Option[string] = None
private var pl_use: Option[string] = None

// The link-time optimization this build settled on: the flag's, and the root manifest's where the
// command line named none (`settle_lto`).
private var pl_lto: Option[string] = None

// Nothing asked for, which is what every command line starts from (`reset_search_paths`).
reset_pipeline()
    pl_lto_flag = None
    pl_generate = None
    pl_use = None
    pl_lto = None

is_lto_mode(mode: string) -> bool = mode == "thin" || mode == "full"

// The refusal of a mode clang does not have, in the reference's words.
lto_mode_refusal(mode: string) -> string =
    s"'--lto $mode' names no kind of link-time optimization clang has — it is thin or full"

// The refusal of both ends of the profile workflow at once. Clang takes both and instruments the build
// it was asked to optimize, saying nothing, so the contradiction is refused where it was typed.
val ProfileBothRefusal: string = "--profile-generate and --profile-use are the two ends of one " +
    "workflow and cannot be asked for at once: generate a profile, merge it with 'llvm-profdata', " +
    "then build against it"

// The three flags, each as `--flag <value>` or `--flag=<value>`.
private val PipelineFlags: []const string = ["--lto", "--profile-generate", "--profile-use"]

// The flag `args[i]` names and its value, where it is one of the three: `(name, value, taken)`, with
// `taken` the arguments it used -- `1` joined, `2` apart, `0` for a flag whose value is missing.
private pipeline_flag_at(args: []string, i: usize) -> Option[(string, string, int)]
    val arg = args[i]

    for f in PipelineFlags
        if arg == f
            if i + 1 >= args.len then return Some((f, "", 0))

            return Some((f, args[i + 1], 2))
        end if

        if arg.starts_with(s"$f=") then return Some((f, arg[(f.len + 1)..<arg.len], 1))

    None
end pipeline_flag_at

// One argument of a command line, where it is `--lto`, `--profile-generate` or `--profile-use`: how
// many arguments it took, `0` for one whose value is missing (the caller's usage error), and `-1` for
// an argument that is none of them. `took_search_flag`'s shape, and called from it, so every command
// that can reach a C compiler takes all three.
took_pipeline_flag(args: []string, i: usize) -> int
    val found = pipeline_flag_at(args, i) match
        None -> return -1
        Some(f) -> f

    if found.2 == 0 then return 0

    if found.0 == "--lto" then pl_lto_flag = Some(found.1)
    else if found.0 == "--profile-generate" then pl_generate = Some(found.1)
    else pl_use = Some(found.1)

    pl_lto = pl_lto_flag
    found.2
end took_pipeline_flag

// What the command line got wrong about the three, said before any command reads its own flags -- a
// mode clang does not have, and both ends of the profile workflow at once. Arguments after a `--` are
// the program's and are not looked at.
pipeline_flag_refusal(args: []string) -> Option[string]
    var generate = false
    var use = false
    var i: usize = 0

    while i < args.len
        if args[i] == "--" then return None

        pipeline_flag_at(args, i) match
            None -> ()
            Some(found) ->
                if found.2 == 0 then return None

                if found.0 == "--lto" && !is_lto_mode(found.1) then return Some(lto_mode_refusal(found.1))

                if found.0 == "--profile-generate" then generate = true
                if found.0 == "--profile-use" then use = true

                i += usize(found.2 - 1)

        i += 1

    if generate && use then Some(ProfileBothRefusal) else None
end pipeline_flag_refusal

// What `--lto` named, and nothing else -- which is the whole of what `build-c` takes.
lto_flag() -> Option[string] = pl_lto_flag

// The build's link-time optimization: the flag's, then `manifest`'s. Called once per command, where
// the root manifest is read (`build_level`), with `None` by `build-c`, which takes the flag alone.
settle_lto(manifest: Option[string])
    pl_lto = pl_lto_flag

    if pl_lto.is_none() then pl_lto = manifest

// The link-time optimization this build settled on.
settled_lto() -> Option[string] = pl_lto

profile_generate() -> Option[string] = pl_generate

profile_use() -> Option[string] = pl_use

// The flags, in the order clang's documentation writes them, for EVERY clang the build drives that
// produces code or links it -- there is no flag here that belongs to the compile and not the link,
// which is the point. A profile directory is made absolute because the instrumented program writes
// into it when it RUNS, from wherever it is run.
pipeline_flags() -> Buf[string]
    var out: Buf[string] = buf()

    pl_lto match
        Some(mode) -> out.push(s"-flto=$mode")
        None -> ()

    pl_generate match
        Some(dir) -> out.push(s"-fprofile-generate=${absolute_path(dir)}")
        None -> ()

    pl_use match
        Some(file) -> out.push(s"-fprofile-use=${absolute_path(file)}")
        None -> ()

    out
end pipeline_flags

// What the levers add to a cache key -- the standard module's directory, the run cache's, a codegen
// unit's and a C object's: nothing where none is pulled, and the reference's shape otherwise
// (`O2-lto-thin-puse-<hash>`).
//
// **A profile is keyed by what it SAYS, not by where it is.** The ordinary way of working is to merge
// a new profile over the old one at the same path, so a key over the path alone would hand the second
// build what the first profile optimized. A file that is not there hashes as its path alone; clang
// then refuses it in its own words. **The reference's run cache keys the path alone**; this keys the
// bytes everywhere, being one rule rather than two.
pipeline_key() -> string
    var out = ""

    pl_lto match
        Some(mode) -> out = out + s"-lto-$mode"
        None -> ()

    pl_generate match
        Some(dir) -> out = out + s"-pgen-${bytes_fingerprint(absolute_path(dir).bytes)}"
        None -> ()

    pl_use match
        Some(file) ->
            val at = absolute_path(file)

            val body = read_bytes(at) match
                Ok(bytes) -> s"${bytes.len}:${bytes_fingerprint(bytes)}"
                Err(_) -> ""

            out = out + s"-puse-${bytes_fingerprint((at + "\n" + body).bytes)}"
        None -> ()

    out
end pipeline_key
