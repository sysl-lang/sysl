// Counting what is in a file, which is `wc`.
//
// It is the shortest program that needs both halves of `sysl.fs`. The *handle* half, because
// counting lines means reading them one at a time rather than holding the file in memory — and the
// line cursor it goes through is `sysl.io`'s, written long before a file existed to point it at,
// which works because a `File` is a `Reader` like any other. And the *path* half, because a file
// that is not there should say which file and why, rather than counting zero of everything.
//
//     ./run-example.sh examples/wc.sysl -- README.md
//     ./run-example.sh examples/wc.sysl -- -l README.md
//     ./run-example.sh examples/wc.sysl -- --help
//
// The flags are `sysl.args`'s described layer: three options in a table, and the `--help` text is
// generated from that same table rather than written out beside it, so the two cannot come to
// disagree. What the program itself decides is the one rule a table cannot express — that naming
// none of the three counts means all three, which is what `wc` has always done.
//
// The close is deferred rather than written at the end, which says it once for the failing paths as
// well as for the one that reaches the bottom. A destructor (`03 § A destructor`) is the other way
// to say it and wants the handle behind a `&T`; this one never leaves the scope that opened it, so
// there is nothing a destructor would reach that the `defer` does not.

import sysl.args.*
import sysl.fs.open
import sysl.io.lines

main(args: []string)
    var want_lines = flag('l', "lines", "print the line count")
    var want_words = flag('w', "words", "print the word count")
    var want_bytes = flag('c', "bytes", "print the byte count")

    var spec = cli("wc", [want_lines, want_words, want_bytes],
                   about = "Count lines, words and bytes in a file.",
                   version = "0.1.0",
                   operands = "<file>")

    var opts = parse_or_exit(spec, args)

    // How many operands there are is the program's to check: the table describes options, and
    // `operands` above is the text the usage line shows rather than a rule anything enforces.
    if opts.positionals.len != 1
        eprints("wc: exactly one file is wanted\n")
        eprints(usage_line(spec) + "\n")
        exit(2)

    var show_lines = opts.given(want_lines)
    var show_words = opts.given(want_words)
    var show_bytes = opts.given(want_bytes)

    if !show_lines && !show_words && !show_bytes
        show_lines = true
        show_words = true
        show_bytes = true

    var path  = opts.positionals[0]
    var asked = open(path)

    if asked.is_err()
        eprints(f"wc: $path%s: ${asked.unwrap_err()}%s\n")
        exit(1)

    var f = asked.unwrap()

    defer f.close()

    var lines_seen = 0
    var words      = 0
    var bytes      = 0

    for line in lines(&f)
        lines_seen += 1
        // The newline the cursor took off is still a byte of the file, so it is counted back on.
        bytes += int(line.len) + 1

        var inside = false

        for b in line.bytes
            if b == 32 || b == 9
                inside = false
            elif !inside
                inside = true
                words += 1

    if f.failed()
        eprints(f"wc: $path%s: reading stopped early\n")
        exit(1)

    var out = ""

    if show_lines then out += f"$lines_seen%8d"
    if show_words then out += f"$words%8d"
    if show_bytes then out += f"$bytes%8d"

    print(f"$out%s $path%s")
