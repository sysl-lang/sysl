// Accepted today, and its meaning CHANGES under by-reference capture: the closure writes a capture
// and reads it back, and it is made once per iteration. By value each one starts from n = 0.
twice(f: &Fn() -> int) -> int = f() + f()

run()
    var n = 0

    for _ in 0..<3 do print(twice(() ->
        n += 1
        n))

run()
