module sh.sysl.compiler
@tests

import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture

// `sysl.fiber.Context.start` takes an entry whose parameter is `@lets_out`
// (`*extern(@lets_out *T) -> unit`): a fiber runs past the call that started it, so its entry may
// let out what it reads through `arg` -- a scheduler unlinking the job it runs -- while it is still
// refused where it keeps the address itself. An unmarked entry stands where the marked type is asked
// for (`reference/types.md § @lets_out`), so every existing `Context.start(s, &f, &x)` is unchanged.
// `start` lends `arg` (nothing it calls keeps it), so the address of a caller's local is still taken
// there, as `library/fiber.md`'s own example takes it.
//
// The matrix crosses how `start` is reached (directly, a generic wrapper taking the marked type, one
// taking the unmarked type) with what the entry does (lets reads out, plain, keeps the parameter),
// how the entry is handed (`&f` directly, a function-pointer value of the marked, the unmarked and
// the `@keeps` type) and what `arg` is (module storage, a local's address).
//
// Every entry here switches home once and is never resumed, so it never reaches its end at run time;
// the analysis still sees a body that comes back, which is what the marks are asked of. An entry
// ending in an endless `loop` never comes back at all, so it holds nothing past its call and no mark
// is asked of it.
//
// Skipped cells, and why: a closure entry (`start` takes a `*extern`, never a callable); a bare
// target (`start` reads the same signature there; the difference is the stack's storage, not the
// check); an entry that returns at run time (it traps, which `sysl.fiber`'s own tests cover).

// -- the harness ----------------------------------------------------------------------------------

private flo_outcome(text: string) -> (string, int)
    val root = make_temp_dir("sysl-flo").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", flo_prelude + text).unwrap()

    val exe = s"$root/built"

    build_native_program(root, None, None, DefaultOptimization, Some(exe)) match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return (failure_text(why), -1)
        Ok(_) -> ()

    val said = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    said match
        Err(_) -> ("the program that was built could not be run", -1)
        Ok(out) -> (out.text + out.err.unwrap_or(""), shell_status(out.status))
end flo_outcome

private flo_prints(text: string, want: string)
    if xvr_no_library() then return

    val out = flo_outcome(text)

    assert_eq(out.0, want)
    assert_eq(out.1, 0)

private flo_refused(text: string, part: string)
    if xvr_no_library() then return

    val out = flo_outcome(text)

    assert_eq(out.1, -1, out.0)
    assert(out.0.index_of(part).is_some(), out.0)

private const flo_prelude: string = raw"""
    import sysl.fiber.{Context, Stack, switch}

    struct Node
        v: int

    struct Job
        home: Context
        me: Context
        node: *Node

    var a = Node(7)
    var g = Job(Context.new(), Context.new(), &a)
    var last: *Node = null
    var held: *Job = null

    stash(j: *Job)
        last = j.node

    body(j: *Job)
        stash(j)
        switch(&j.me, &j.home)

    plain(j: *Job)
        j.node.v += 1
        switch(&j.me, &j.home)

    keeper(j: *Job)
        held = j
        switch(&j.me, &j.home)

    """

// -- accepted ------------------------------------------------------------------------------------

@test("start begins an entry that lets out what it reads through the address of a caller's local")
flo_local_lets_out()
    flo_prints(raw"""
        main()
            val s = Stack.reserve(65536).unwrap()
            var job = Job(Context.new(), Context.new(), &a)
            job.me = Context.start(s, &body, &job)
            switch(&job.home, &job.me)
            print(last.v)
        """, "7\n")

@test("start begins an entry that lets out what it reads through module storage")
flo_module_lets_out()
    flo_prints(raw"""
        main()
            val s = Stack.reserve(65536).unwrap()
            g.me = Context.start(s, &body, &g)
            switch(&g.home, &g.me)
            print(last.v)
        """, "7\n")

@test("a scheduler's entry unlinking its job is accepted, as avin's lwt_entry is")
flo_unlink_entry()
    flo_prints(raw"""
        struct Lwt
            home: Context
            me: Context
            next: *Lwt

        var spare: *Lwt = null

        finish(p: *Lwt)
            spare = p.next

        entry(p: *Lwt)
            finish(p)
            switch(&p.me, &p.home)

        main()
            val s = Stack.reserve(65536).unwrap()
            var tail = Lwt(Context.new(), Context.new(), null)
            var p = Lwt(Context.new(), Context.new(), &tail)
            p.me = Context.start(s, &entry, &p)
            switch(&p.home, &p.me)
            print(spare == &tail)
        """, "true\n")

@test("a function pointer of the marked type is handed to start")
flo_marked_pointer_value()
    flo_prints(raw"""
        main()
            val s = Stack.reserve(65536).unwrap()
            val f: *extern(@lets_out *Job) -> unit = &body
            g.me = Context.start(s, f, &g)
            switch(&g.home, &g.me)
            print(last.v)
        """, "7\n")

@test("an unmarked entry still stands where start asks for the marked type")
flo_plain_entry()
    flo_prints(raw"""
        main()
            val s = Stack.reserve(65536).unwrap()
            var job = Job(Context.new(), Context.new(), &a)
            job.me = Context.start(s, &plain, &job)
            switch(&job.home, &job.me)
            print(a.v)
        """, "8\n")

@test("a function pointer of the unmarked type still stands where start asks for the marked one")
flo_unmarked_pointer_value()
    flo_prints(raw"""
        main()
            val s = Stack.reserve(65536).unwrap()
            val f: *extern(*Job) -> unit = &plain
            g.me = Context.start(s, f, &g)
            switch(&g.home, &g.me)
            print(a.v)
        """, "8\n")

@test("a generic wrapper taking the marked type forwards an entry that lets reads out to start")
flo_generic_wrapper_marked()
    flo_prints(raw"""
        begin[T](s: &Stack, f: *extern(@lets_out *T) -> unit, x: *T) -> Context = Context.start(s, f, x)

        main()
            val s = Stack.reserve(65536).unwrap()
            var job = Job(Context.new(), Context.new(), &a)
            job.me = begin(s, &body, &job)
            switch(&job.home, &job.me)
            print(last.v)
        """, "7\n")

@test("a generic wrapper taking the unmarked type forwards it to start")
flo_generic_wrapper_unmarked()
    flo_prints(raw"""
        begin[T](s: &Stack, f: *extern(*T) -> unit, x: *T) -> Context = Context.start(s, f, x)

        main()
            val s = Stack.reserve(65536).unwrap()
            var job = Job(Context.new(), Context.new(), &a)
            job.me = begin(s, &plain, &job)
            switch(&job.home, &job.me)
            print(a.v)
        """, "8\n")

// -- refused -------------------------------------------------------------------------------------

@test("an entry that keeps its argument itself is still refused at start")
flo_keeper_refused()
    flo_refused(raw"""
        main()
            val s = Stack.reserve(65536).unwrap()
            g.me = Context.start(s, &keeper, &g)
            switch(&g.home, &g.me)
            print(held == &g)
        """, "'keeper' keeps its parameter 'j' (it is stored in 'held')")

@test("a function pointer marked @keeps does not stand where start asks for @lets_out")
flo_keeps_pointer_refused()
    flo_refused(raw"""
        main()
            val s = Stack.reserve(65536).unwrap()
            val f: *extern(@keeps *Job) -> unit = &keeper
            g.me = Context.start(s, f, &g)
            switch(&g.home, &g.me)
            print(held == &g)
        """, "a '*extern(@lets_out *Job) -> unit' lets out only what it reads through it, never the parameter itself")

@test("a generic wrapper taking the unmarked type still refuses an entry that lets reads out")
flo_generic_wrapper_unmarked_refused()
    flo_refused(raw"""
        begin[T](s: &Stack, f: *extern(*T) -> unit, x: *T) -> Context = Context.start(s, f, x)

        main()
            val s = Stack.reserve(65536).unwrap()
            g.me = begin(s, &body, &g)
            switch(&g.home, &g.me)
            print(last.v)
        """, "'body' lets what it reads through its parameter 'j' outlive the call")
