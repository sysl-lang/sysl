// The SHA-2 family — the checks.
//
// The axis this owns is **generic arithmetic, and module-level static data**. SHA-256 alone would
// be the PNG reader a second time: unsigned words, big-endian, a length in the tail. The family is
// a different question, because four functions come out of one body and the differences between
// them are exactly the things a bound turns out not to be able to promise.
//
// Nothing here is checked against a value this program produced. The digests are the published
// ones — the NIST examples for `abc` and the two alphabet strings, a byte pattern at fifteen
// lengths and a million bytes from Python's hashlib, the HMAC tags from RFC 4231 — and the pieces
// the two widths are built from are checked one at a time against values worked out separately.
// The lengths were chosen where an implementation that is wrong is wrong: 55 and 56 straddle the
// point where SHA-256's length field stops fitting in the last block, 119 and 120 do it for the
// second block, and 111, 112, 127 and 128 do it for SHA-512's wider field.
//
// What writing it turned up:
//
//   * **A type parameter is not a name a call can be written through, so nothing about a type can
//     be reached without a value of it.** This is the finding, and every awkwardness below is a
//     face of it. `T.bits()` is "undefined name 'T'"; an associated function on a built-in cannot
//     even be declared, because only a struct or an enum has a name in call position (`08`). So
//     the width, the round count, the constant table and the four mixing functions — all of them
//     facts about `u32` and `u64` rather than about any word — are trait members with a receiver
//     they do not read, and the compression asks `self.h[0].bits` for the width of the type it was
//     instantiated at. What this wants is what `02` calls a trait-level associated function or
//     constant, reachable as `T.bits` through a bound. It is the same shortfall the hash map found
//     as "a bound promises behaviour, never a value" and the FFT found as "a generic function
//     cannot name its own zero", one step further along: those wanted a *value*, and this wants a
//     value **and** a way to ask for it without one.
//   * **A conversion goes out of a type parameter but not into one.** `u8(x)` where `x: T` is
//     ordinary code, because `u8` is a type that exists; `T(b)` is "undefined function 'T'". So
//     `top_byte` is a generic function and `shift_in` — its exact mirror — has to be a trait member
//     written twice. Half of a symmetric pair generic and the other half not is the sharpest small
//     illustration of the finding above.
//   * **A trait could not require another trait — answered.** Everything generic here used to carry
//     the union of what it and its callees needed, `[T: Word + Add + BitAnd + BitOr + BitXor + Not
//     + Shl + Shr + Sub]`, written out at every declaration. `Word` now *requires* those eight, so
//     each of them is `[T: Word]` and the promise is made once where it belongs. That the hash
//     map's "no `where` clause, no bound alias" was decided against changing is not in question: a
//     supertrait is a different mechanism, because it is the **trait** that promises rather than
//     each declaration that repeats. The other half of what it answers is not visible here at all —
//     see `guide/shapes`, where a required trait is the difference between something being writable
//     and not.
//   * **A `val` is a table you can read and not a table you can pass.** Slicing one is refused, on
//     purpose and for a good reason, and the consequence is that a static table cannot be handed
//     to a function: `k256` reaches the generic compression only through `Word.k`, a method whose
//     whole body is one index. That is a small price and the alternative — copying eighty words
//     per block — is not one. The initial values escape it because there are only eight of them,
//     so `start` takes a `[8]T` **by value** and a `val` copies into a parameter perfectly well.
//   * **A literal at a generic callee's parameter had no type.** `rotr(x, 7)` was
//     "'n' of 'rotr' is uint, but int was given", and `f(v, 7)` against `f[T](x: T, n: usize)` the
//     same, though `01` lists the parameter type at a call among the positions that fix a literal
//     and says nothing about the callee. Fixed while writing this, in two halves: a parameter that
//     names no type parameter is known up front and is used up front, and a literal is now
//     consulted **last** by inference and analyzed against whatever the parameter turned out to be.
//   * **A line could not be continued** — answered, and the answer corrected the diagnosis. A
//     trailing operator now carries the line, which is what `guide/bytecode` and `guide/shapes`
//     wanted; it does not shorten `digest_of`'s 107-character signature, because the length there
//     is inside a bracketed bound list, and brackets always joined. What that signature is really
//     reporting is the line below it — nine traits written out where one name should do.
//
// And what went right: **the generic body is the whole algorithm, not a skeleton.** The schedule,
// the round, the padding and the streaming buffer are written once and run at two widths, the
// wrapping arithmetic `01` promises is exactly what a digest needs, and putting a nine-trait bound
// on a struct really does mean its members inherit it. `[v; n]` with a length worked out while
// running gives the message buffers their storage, and copying a started hasher is what lets HMAC
// take "a hash function" as an argument without a trait that could not have promised one.

check(name: string, got: string, want: string)
    if got == want then print(s"ok    $name = $got")
    else print(s"FAIL  $name = $got, wanted $want")
end check

// A message of a chosen length whose bytes are all different from one another for the first 256 —
// so a digest that is right by accident would have to be right about the order too.
pattern(n: usize) -> []u8
    var m: []u8 = [0u8; n]

    for i in 0..<n do m[i] = u8((i * 7 + 3) & 255)

    m
end pattern

repeated(b: u8, n: usize) -> []u8 = [b; n]

counting(n: usize) -> []u8
    var m: []u8 = [0u8; n]

    for i in 0..<n do m[i] = u8(i + 1)

    m
end counting

// RFC 4231's seventh case, whose message is longer than a block for both widths.
longer_message() -> []u8 = "This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm.".bytes

// A digest of the same message handed over in pieces, which must be the digest of the whole.
streamed[T: Word](s: Sha[T], chunk: []u8, times: usize) -> string
    var h = s
    var out: []u8 = [0u8; 64]

    for i in 0..<times do h.update(chunk)

    h.finish(out[0..<h.dlen]).expect("a digest buffer sized from the hasher itself")

    hex(out[0..<h.dlen])
end streamed

one_at_a_time[T: Word](s: Sha[T], data: []u8) -> string
    var h = s
    var out: []u8 = [0u8; 64]

    for i in 0..<data.len do h.update(data[i..<i + 1])

    h.finish(out[0..<h.dlen]).expect("a digest buffer sized from the hasher itself")

    hex(out[0..<h.dlen])
end one_at_a_time

w32(x: u32) -> string = f"$x%08x"
w64(x: u64) -> string = f"$x%016x"

// What a hasher said when it refused.
why(r: Result[unit, Fault]) -> string = r.expect_err("a hasher that was supposed to refuse").describe()

// How many places two strings of the same length differ in.
apart(a: string, b: string) -> usize
    var n = 0usize

    for i in 0..<a.len
        if a[i] != b[i] then n += 1

    n
end apart

print("-- the four digests of one message")

var abc = "abc".bytes

check("sha-224 of abc", sha224(abc), "23097d223405d8228642a477bda255b32aadbce4bda0b3f7e36c9da7")
check("sha-256 of abc", sha256(abc), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
check("sha-384 of abc", sha384(abc), "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7")
check("sha-512 of abc", sha512(abc), "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")

