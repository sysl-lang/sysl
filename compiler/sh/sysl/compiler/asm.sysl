module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.math.bigint.to_string
import sysl.text.str_builder

// Inline assembly: which arm this target is built for, and what each operand names.
//
// **The arms are chosen between here**, so what reaches the emitter is one architecture's
// instructions and no record that there were others.

type_asm(cx: &Analyzer, span: Span, arms: Buf[AsmArm]) -> TStmt
    check_arch_names(cx, arms)
    check_no_overlap(cx, arms)
    check_exhaustive(cx, span, arms)

    val here = cpu_symbol(cx.an.tables.target.cpu)
    val arm = arm_for(arms, here)

    if arm.is_none() then return TAsm(buf(), buf(), buf(), span)

    arm.unwrap().body match
        // The reason travels from the arm into the diagnostic, which is the whole of what the form
        // buys over leaving the arm out: omitting it fails every build with "no arm for aarch64",
        // and writing it lets the builds that *do* have an answer succeed while this one is told
        // why it cannot.
        AsmUnavailable(reason) ->
            cx.fault(arm.unwrap().span, s"this operation has no answer on $here: $reason")
            TAsm(buf(), buf(), buf(), span)

        AsmCode(lines, operands, clobbers) ->
            var bound: Buf[TAsmOperand] = buf()

            for item in operands
                val one = bind_operand(cx, item)

                if one.is_some() then bound.push(one.unwrap())

            check_no_double_binding(cx, operands)
            check_placeholders(cx, arm.unwrap().span, lines, operands)
            TAsm(lines, bound, clobbers, span)
end type_asm

// **Every `asm` block written at the top of a file**, its arm chosen for the target and filed in the
// tables, in the order the files were read.
//
// The arms are checked exactly as a function's are -- named processors, one arm each, every processor
// answered -- so a block missing an architecture is found on the build that has one. What is refused
// in addition is everything that talks to surrounding code, because there is none: an operand and a
// `clobbers` line, in EVERY arm, the mistake being the same whichever machine is being built for. A
// `{NAME}` is not an operand here but a constant, written into the text as its decimal value
// (`with_constants`); it too is checked in every arm.
check_module_asm(a: &Analysis, units: Buf[Program])
    for unit in units
        for j in 0..<unit.body.len()
            val s = unit.body.at(j)

            *s.kind match
                ModuleAsm(arms, section, align) ->
                    val cx = analyzer_for(a, scope_of_unit(a, unit))
                    val made = type_module_asm(cx, s.span, arms, section, align, unit.test_only,
                                               module_of_unit(unit))

                    if made.is_some() then a.tables.module_asm.push(made.unwrap())
                _ -> ()
end check_module_asm

private type_module_asm(cx: &Analyzer, span: Span, arms: Buf[AsmArm], section: Option[string],
                        align: Option[Expr], scaffolding: bool, home: string) -> Option[TModuleAsm]
    check_arch_names(cx, arms)
    check_no_overlap(cx, arms)
    check_exhaustive(cx, span, arms)

    val here = cpu_symbol(cx.an.tables.target.cpu)
    var written_here: Buf[string] = buf()

    for item in arms
        item.body match
            AsmCode(lines, operands, clobbers) ->
                refuse_module_operands(cx, item.span, operands, clobbers)

                val written = with_constants(cx, item.span, lines)

                if takes(item, here) then written_here = written
            AsmUnavailable(_) -> ()

    val boundary_at = boundary(cx, "asm", align)
    val arm = arm_for(arms, here)

    if arm.is_none() then return None

    arm.unwrap().body match
        AsmUnavailable(reason) ->
            cx.fault(arm.unwrap().span, s"this operation has no answer on $here: $reason")
            None
        AsmCode(_, _, _) -> Some(TModuleAsm(written_here, section, boundary_at, scaffolding, home))
end type_module_asm

// What only a block inside a function can mean. Each refusal says what to write instead, since the
// reader's intent -- reaching a value, or keeping a register -- has a spelling at module level too.
private refuse_module_operands(cx: &Analyzer, span: Span, operands: Buf[AsmOperand],
                               clobbers: Buf[string])
    for item in operands
        cx.fault(item.span, s"'${item.name}' cannot be an operand here: an " +
                 "'asm' block at the top of a file is outside every function, so there is no " +
                 "variable for an operand to be and no code around the block to hand one over. " +
                 "Name a symbol in the instructions instead — module storage the program " +
                 "'@export's, or a label the block defines and sysl declares 'extern'")

    if !clobbers.is_empty()
        cx.fault(span, "'clobbers' tells the code around an 'asm' block which registers it " +
                 "destroys, and a block at the top of a file has no code around it — nothing runs " +
                 "it in the middle of a function. Delete the line; whatever calls into these " +
                 "instructions keeps its own registers by the calling convention")
end refuse_module_operands

// **A `{NAME}` in a block at the top of a file is a constant written into the text.** There is no
// code around the block to hand a register over, but a `const` is a number while compiling, so it can
// be laid into the instructions as its decimal value -- which is how a frame size or a field offset
// the assembly shares with a struct is written once, as `sizeof` or `offsetof`, rather than as a
// literal kept in step by hand. A doubled brace stays doubled, the emitter collapsing it, so it still
// means one brace for the assembler. A line whose constant was refused keeps the placeholder as
// written, the build stopping at the refusal anyway.
private with_constants(cx: &Analyzer, span: Span, lines: Buf[string]) -> Buf[string]
    var out: Buf[string] = buf()

    for item in lines
        out.push(line_with_constants(cx, span, item))

    out
end with_constants

// One line with each `{NAME}` replaced. It is copied in runs cut only at a brace, so a cut never lands
// inside a character the line spells in more than one byte.
private line_with_constants(cx: &Analyzer, span: Span, line: string) -> string
    val b = line.bytes
    var s = str_builder()
    var from: usize = 0
    var i: usize = 0

    while i < b.len
        if (b[i] == u8('{') || b[i] == u8('}')) && i + 1 < b.len && b[i + 1] == b[i]
            i = i + 2
        else if b[i] == u8('{')
            var j = i + 1

            while j < b.len && b[j] != u8('}')
                j = j + 1

            if j < b.len
                s.push(line[from..<i])
                s.push(constant_text(cx, span, line[i + 1..<j]))
                i = j + 1
                from = i
            else
                i = i + 1
        else
            i = i + 1

    s.push(line[from..<b.len])
    s.finish()
end line_with_constants

// The decimal text a `{NAME}` stands for, or -- where the name is not an integer constant -- a
// refusal saying what it is instead, and the placeholder unchanged.
private constant_text(cx: &Analyzer, span: Span, name: string) -> string
    val kept = s"{$name}"

    const_of_name(cx, name) match
        Some(c) -> c match
            ConstInt(n) -> return to_string(n)
            _ ->
                cx.fault(span, s"'{$name}' is ${const_kind(c)}, and only an integer constant can be " +
                         "written into the instructions, as its decimal value")
                return kept
        None -> ()

    if lookup_value_key(cx, cx.an.tables.consts, name).is_some()
        cx.fault(span, s"'{$name}' names a constant whose value is not settled while compiling, so " +
                 "there is no number to write into the instructions")
    else if lookup_value_key(cx, cx.an.tables.vals, name).is_some() ||
            lookup_value_key(cx, cx.an.tables.extern_vars, name).is_some()
        cx.fault(span, s"'{$name}' is not a constant: it names storage, whose value exists only " +
                 "while the program runs, and the text of an 'asm' block at the top of a file is " +
                 "settled while compiling. Declare it 'const' to write its value here, or name the " +
                 "storage's symbol in the instructions, '@export'ing it")
    else if cx.an.tables.funcs.has(module_qualify(cx.scope.module_name, name))
        cx.fault(span, s"'{$name}' is not a constant: it names a function. Name the function's " +
                 "symbol in the instructions instead, '@export'ing it")
    else
        cx.fault(span, s"'{$name}' names no constant: an 'asm' block at the top of a file writes " +
                 "a 'const' in scope as '{NAME}', and nothing here is called that. Write '{{' and " +
                 "'}}' for a brace the assembler is to see")

    kept
end constant_text

private arm_for(arms: Buf[AsmArm], here: string) -> Option[AsmArm]
    for arm in arms
        if takes(arm, here) then return Some(arm)

    None
end arm_for

// Whether this arm is the one a build for `here` takes.
private takes(arm: AsmArm, here: string) -> bool
    for j in 0..<arm.archs.len()
        if arm.archs.at(j) == here then return true

    false
end takes

// A processor name outside the closed set is a mistake rather than a machine nobody has heard of.
// That is `#if`'s rule and it is here for `#if`'s reason: a name reading as "some other processor"
// would leave the arm unselectable and the statement silently short an architecture.
private check_arch_names(cx: &Analyzer, arms: Buf[AsmArm])
    val all = all_cpus()

    for item in arms
        for j in 0..<item.archs.len()
            val name = item.archs.at(j)
            var known = false

            for k in 0..<all.len()
                if cpu_symbol(all.at(k)) == name then known = true

            if !known then
                cx.fault(item.span, s"'$name' is not a processor — ${cpu_names(all)} is what " +
                         "there is")

private cpu_names(all: Buf[Cpu]) -> string
    var out = ""

    for i in 0..<all.len()
        if i > 0 then out = out + ", "

        out = out + s"'${cpu_symbol(all.at(i))}'"

    out
end cpu_names

// One processor, one arm. Two arms claiming the same one leave no rule for which wins, and a reader
// would have to know the answer to know what the statement does.
private check_no_overlap(cx: &Analyzer, arms: Buf[AsmArm])
    var seen: Buf[string] = buf()

    for item in arms
        for j in 0..<item.archs.len()
            val name = item.archs.at(j)
            var have = false

            for k in 0..<seen.len()
                if seen.at(k) == name then have = true

            if have then
                cx.fault(item.span, s"'$name' already has an arm above this one, so there " +
                         "is no saying which of them answers for it")
            else
                seen.push(name)

// Every processor a target can be built for needs an answer, whether or not it is the one being
// built for now. An architecture with nothing to say says `unavailable` and why; leaving it out is
// the mistake this reports.
private check_exhaustive(cx: &Analyzer, span: Span, arms: Buf[AsmArm])
    val all = all_cpus()
    var missing: Buf[string] = buf()

    for item in all
        val name = cpu_symbol(item)

        if name != "x86"
            var covered = false

            for j in 0..<arms.len()
                for k in 0..<arms.at(j).archs.len()
                    if arms.at(j).archs.at(k) == name then covered = true

            if !covered then missing.push(s"'$name'")

    if missing.is_empty() then return

    // Commas up to the last, which takes the "or": a bare `asm` block names six processors, and
    // "'a' or 'b' or 'c'" is a list a reader has to parse rather than read.
    var named = ""

    for i in 0..<missing.len()
        if i > 0 then named = named + (if i == missing.len() - 1 then " or " else ", ")

        named = named + missing.at(i)

    cx.fault(span, s"this assembly has no arm for $named. Every processor needs an answer, so " +
             "that one without instructions is found here rather than by whoever first builds for " +
             "it — write the instructions, write an empty arm if none are needed there, or write " +
             "'unavailable' with the reason there is nothing to write")

// Binds an operand to the local it names, refusing what cannot be one.
//
// Nothing is what a bound that could not be made answers, and the statement is emitted without that
// operand rather than with a broken one: the diagnostic has been recorded, and a later pass reading
// a half-bound operand would be a crash on top of a message the reader already has.
private bind_operand(cx: &Analyzer, op: AsmOperand) -> Option[TAsmOperand]
    val local = cx.lookup(op.name)

    if local.is_none()
        cx.fault(op.span, s"undefined name '${op.name}'. An assembly operand names a variable " +
                 "that already exists — an expression needs somewhere to be evaluated to, so bind " +
                 "one first")

        return None
    end if

    val l = local.unwrap()

    // A `ref` names a place rather than a slot, so there is no storage of its own to load from or
    // store to: the operand would be emitted against an address nothing allocated. Refusing it by
    // name keeps that from being a module the assembler rejects for reasons the source does not
    // explain -- and it is asked before the other two questions, a name that cannot be an operand
    // having no direction to be wrong in and no register to fit.
    if l.stands_for.is_some()
        cx.fault(op.span, s"'${op.name}' is bound by 'ref', so it names storage somewhere else " +
                 "rather than a variable of its own, and there is nothing here for an operand to " +
                 "be. Copy it into a 'var' first, and write that back afterwards if the " +
                 "instructions set it")

        return None
    end if

    if l.read_only && is_out(op.dir)
        // A pattern binding is written once as well, and its advice cannot be "declare it 'var'":
        // there is no keyword on an arm's capture to change.
        if l.from_pattern then
            cx.fault(op.span, s"'${op.name}' cannot be written by this assembly, because a " +
                     "pattern binding holds a copy of what it matched and is written once. Copy " +
                     "it into a 'var' and name that instead")
        else
            cx.fault(op.span, s"'${op.name}' cannot be written by this assembly, because it is a " +
                     "'val'. Declare it 'var' if the instructions are meant to set it")
    end if

    if !fits_register(l.ty) then cx.fault(op.span, register_fit_message(op.name, l.ty))

    Some(TAsmOperand(op.dir, op.name, l.unique, l.ty, op.reg))
end bind_operand

private is_out(d: AsmDir) -> bool = d match
    Out -> true
    In -> false

// Whether a value of this type can live in a general-purpose register, which is the only class
// there is. A trait object is two words and so is not one of them.
private fits_register(ty: Type) -> bool = ty match
    Integer(_, _, _) -> true
    Fixed(_, _, _) -> true
    Bool -> true
    Char -> true
    Ptr(inner) -> !is_trait(*inner)
    _ -> false

private register_fit_message(name: string, ty: Type) -> string = ty match
    Floating(_, _) ->
        s"'$name' is a floating-point value, and there is no floating register class yet — only " +
            "'reg', which is the general-purpose one. Move the value through an integer of the " +
            "same width, or through memory"
    Ptr(inner) ->
        if is_trait(*inner) then
            s"'$name' is a trait object, which is two words — a pointer to the value and a " +
                "pointer to its table — so it does not fit a register. Pass whichever half the " +
                "instructions need"
        else
            does_not_fit(name)
    _ -> does_not_fit(name)

private does_not_fit(name: string) -> string =
    s"'$name' does not fit a general-purpose register, so it cannot be an assembly operand. " +
        "Operands are the integers, the pointers and 'bool'; anything larger goes through memory"

// Reading and writing one variable is two operands, and two operands may be two registers -- so the
// spelling that looks like it says "read this and write the answer back" would compile to reading
// one register and writing a different one.
private check_no_double_binding(cx: &Analyzer, operands: Buf[AsmOperand])
    for i in 0..<operands.len()
        for j in 0..<i
            if operands.at(j).name == operands.at(i).name &&
                    is_out(operands.at(j).dir) != is_out(operands.at(i).dir) then
                cx.fault(operands.at(i).span, s"'${operands.at(i).name}' is both read and written " +
                         "here, which is two operands and so possibly two registers — the " +
                         "instructions would read one and write another. A single operand that " +
                         "does both is not something this language has yet")

// Every `{name}` in the instructions has to be an operand. A placeholder nothing declares would
// reach the assembler as a literal brace and fail there, with a message about the text rather than
// about the name. The other direction is not an error: an operand the instructions do not name is
// at worst untidy, and at best is how a value is kept alive across a block.
private check_placeholders(cx: &Analyzer, span: Span, lines: Buf[string],
                           operands: Buf[AsmOperand])
    for item in lines
        var names: Buf[string] = buf()

        placeholders(&names, item)

        for j in 0..<names.len()
            var declared = false

            for k in 0..<operands.len()
                if operands.at(k).name == names.at(j) then declared = true

            if !declared then
                cx.fault(span, s"'{${names.at(j)}}' names an operand this assembly does not " +
                         s"declare. Add 'in ${names.at(j)} : reg' or 'out ${names.at(j)} : reg', " +
                         "or write the brace as part of an instruction some other way")

// The `{name}` placeholders one line of instructions carries.
private placeholders(out: *Buf[string], line: string)
    val b = line.bytes
    var i: usize = 0

    while i < b.len
        // A doubled brace is a literal one -- the emitter collapses it -- so it opens no placeholder.
        if (b[i] == u8('{') || b[i] == u8('}')) && i + 1 < b.len && b[i + 1] == b[i]
            i = i + 2
        else if b[i] == u8('{')
            var j = i + 1

            while j < b.len && b[j] != u8('}')
                j = j + 1

            if j < b.len
                out.push(line[i + 1..<j])
                i = j + 1
            else
                i = i + 1
        else
            i = i + 1
