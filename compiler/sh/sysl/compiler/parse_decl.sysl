module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// What a declaration holds: a parameter list, a function's body, a foreign name, the C a file reads
// its constants and its types out of, and the constrained forms a `type` may take.
//
// **A declaration is told from a call by a probe, not by a keyword.** `f(x)` and `f(x: int) = x`
// begin with the same two tokens and diverge several along, so the signature is read speculatively
// and put back where it turned out to be an ordinary expression. That is what a grammar with
// backtracking gets for free and a recursive-descent one has to say.

// -- the nodes, blank -------------------------------------------------------------------------------

// A function with nothing said about it yet. **The fields are set by name afterwards** rather than
// passed positionally: twenty-three arguments at a construction site is a form nobody can read, and
// most of them are the same empty in every caller.
blank_func(name: string) -> FuncDecl =
    FuncDecl(name, buf(), buf(), None, buf(), buf(), false, Public, buf(), buf(), buf(),
        None, None, None, false, false, false, None, None, None, None, buf(), buf(), no_marks(),
        span_zero(), false)

blank_method(at: Span, name: string) -> MethodDecl =
    MethodDecl(at, name, None, false, buf(), buf(), None, buf(), buf(), buf(), Public, false, false,
        buf(), buf(), buf(), None, None, buf(), false, no_marks(), at, false)

blank_struct(name: string) -> StructDecl =
    StructDecl(name, buf(), buf(), buf(), buf(), buf(), Public, buf(), false, buf(), false, None,
        None, buf())

blank_enum(name: string) -> EnumDecl =
    EnumDecl(name, buf(), None, buf(), buf(), buf(), Public, buf(), buf(), buf())

blank_trait(name: string) -> TraitDecl = TraitDecl(name, buf(), buf(), buf(), buf(), Public, buf(),
    buf(), buf())

blank_impl(name: string, for_type: TypeRef) -> ImplDecl =
    ImplDecl(name, for_type, buf(), buf(), buf(), buf(), buf(), false, buf(), buf(), buf())

// -- parameters ---------------------------------------------------------------------------------

// A name a parameter or a field may carry.
//
// **A reserved word is refused with the backticks that would have let it stand**, rather than with
// the grammar's complaint that a name was missing: a field called `module` is a reasonable thing to
// want, and what the reader needs is the spelling that works.
private parse_param_name(p: *Parser, what: string) -> string
    val w = reserved_here(p)

    if w != "" && p.kw_at(1, ":")
        refuse_reserved_name(p, what)
        return w
    end if

    parse_bound_name(p)
end parse_param_name

// The reserved word at the cursor, or `""` where what stands there is not one.
reserved_here(p: *Parser) -> string = p.peek() match
    Keyword(w) -> if is_reserved(w) then w else ""
    _ -> ""

// Refuses the reserved word at the cursor as `what` -- a function's name, the name a `val` binds --
// and steps past it, so the declaration it began is read on under that name. **Every position a name
// is bound at says the same sentence**, the spelling that works being the one thing the reader needs.
refuse_reserved_name(p: *Parser, what: string)
    val w = reserved_here(p)

    p.fault(p.here(), s"'${w}' is a reserved word, so it cannot stand as ${what} — write it '`${w}`' if that is the name you want, which is what the backticks are for: a quoted word is an ordinary name wherever one may be written")
    p.bump()
end refuse_reserved_name

// A name a `val`, `var`, `const` or `ref` binds, where nothing but a name may follow the keyword --
// so a reserved word there can only have been meant as the name, and is refused as one.
parse_binding_name(p: *Parser, what: string) -> string
    val w = reserved_here(p)

    if w == "" then return parse_bound_name(p)

    refuse_reserved_name(p, what)
    w
end parse_binding_name

// One parameter of a declaration, or a struct's field. **A field is storage and not a call**, so it
// takes neither form a call site gives meaning to -- a `...T` tail or a by-name `-> T` -- and either
// is refused by the type it is read as.
parse_param(p: *Parser, what: string, field: bool = false) -> Param
    val start = p.here()
    val name = parse_param_name(p, what)

    p.expect_kw(":")

    if field
        val typ = parse_type(p)

        return Param(start.to(p.just_taken()), name, typ, Public, None, false, false)
    end if

    // `xs: ...T` collects the rest of the call, which is a read-only slice of whatever was passed.
    if p.accept_kw("...")
        val elem = parse_type(p)
        val at = start.to(p.just_taken())

        return Param(at, name, type_ref(at, ArrayType(None, elem, true)), Public, None, false, true)
    end if

    // `body: -> T` is taken by name: the argument is a thunk the callee runs, written at the call
    // site as an ordinary expression.
    if p.accept_kw("->")
        val ret = parse_type(p)
        val at = start.to(p.just_taken())

        return Param(at, name, type_ref(at, FnType(buf(), ret, true)), Public, None, true, false)
    end if

    val typ = parse_type(p)

    Param(start.to(p.just_taken()), name, typ, Public, None, false, false)
end parse_param

// A function's parameter, which may carry a default.
//
// A parameter that collects the rest of the call declares none: a call that leaves it out gets the
// empty slice, which is what "the rest" means when there is none.
parse_func_param(p: *Parser) -> Param
    var param = parse_param(p, "a parameter's name or a field's")

    if p.accept_kw("=")
        if param.rest
            p.fault(param.span, "a parameter that collects the rest of the call declares no default — a call that leaves it out gets the empty slice, which is what 'the rest' means when there is none, and a default beside that is a second answer to a settled question")
            parse_expr(p)
        else
            param.default = Some(lift_placeholders(parse_expr(p)))
    end if

    param
end parse_func_param

// A struct's field, which declares no default: what an unwritten field gets is decided by the
// constructor that builds the value, not by the field.
parse_field_param(p: *Parser) -> Param
    val param = parse_param(p, "a parameter's name or a field's", true)

    if p.accept_kw("=")
        p.fault(param.span, "a field declares no default — what an unwritten field gets is decided by the constructor that builds the value, not by the field")
        parse_expr(p)
    end if

    param
end parse_field_param

// Everything between a declaration's parentheses: the parameters, and whether the call is variadic.
parse_param_list(p: *Parser, out: *Buf[Param]) -> bool
    if p.at_kw(")") then return false
    if p.accept_kw("...") then return true

    // **A name that is not there reads as a list that has ended**, so what is owed is the bracket
    // rather than the identifier: an empty parameter list is legal, and the caller's `)` is the
    // complaint a reader can act on.
    if !names_a_decl(p.peek()) && !at_reserved_binding(p) then return false

    loop
        out.push(parse_func_param(p))

        if !p.accept_kw(",") then break
        if p.at_kw(")") then break

        if p.accept_kw("...")
            p.accept_kw(",")
            return true
        end if

    false
end parse_param_list

// -- a function -----------------------------------------------------------------------------------

// Whether a function declaration begins here, and the whole of it where one does.
//
// **The probe reads the signature and puts it back**, which is what tells `f(x: int) = x` from
// `f(x)`: both open with a name and a bracket, and what separates them is the shape of the
// parenthesised list and the body after it. Nothing is reported by a probe that fails -- the report
// is wound back with the cursor, since a reading nobody chose said nothing about the file.
//
// `committed` skips the probe: a caller that already knows a function has to stand here -- a name
// and a bracket under an annotation, which marks nothing else -- reads it as one, so what is wrong
// with it is told as the reader of a declaration would tell it (`')' expected`).
try_func_decl(p: *Parser, start: Span, vis: Visibility, attrs: Buf[Attr],
              committed: bool = false) -> Option[Stmt]
    // `const` in front marks a function the compiler may run. The word has been seen with a name and
    // a bracket after it, so the line is a function or nothing: a probe failing past it is told so,
    // since the word cannot be put back for a constant to read.
    val marked_const = at_const_func(p)

    if marked_const
        take_async_before_const(p)
        p.bump()
        take_async_after_const(p)

        if !looks_like_func_decl(p)
            p.fault(start, "'const' in front of a name and its parameter list marks a function the compiler may run, and this has no body — write '= value' or an indented block after the signature")
            skip_line(p)
            return Some(stmt(start.to(p.just_taken()), Bad))
        end if
    end if

    val reserved = at_reserved_func_head(p)

    if !reserved && !committed && !looks_like_func_decl(p) then return None

    val async_at = take_async_word(p)
    var conv: Option[CallConv] = None

    if !reserved && at_call_conv(p) then conv = Some(parse_call_conv(p))

    var name = reserved_here(p)

    if reserved then refuse_reserved_name(p, "a function's name")
    else name = parse_bound_name(p)
    var tp = no_type_params()

    if p.at_kw("[") then tp = parse_type_params(p)

    p.expect_kw("(")

    var params: Buf[Param] = buf()
    val variadic = parse_param_list(p, &params)

    p.expect_kw(")")

    var ret: Option[TypeRef] = None

    if p.accept_kw("->") then ret = Some(parse_result_type(p))
    if p.at_word("where") then tp = parse_where_on(p, tp)

    var decl = blank_func(name)

    decl.tparams = tp.names
    decl.params = params
    decl.ret_type = ret
    decl.body = parse_func_body(p)
    decl.bounds = tp.bounds
    decl.variadic = variadic
    decl.vis = vis
    decl.tdefaults = tp.defaults
    decl.tvalues = tp.values
    decl.tpacks = tp.packs
    decl.conv = conv
    decl.const_fn = marked_const

    accept_end_name(p, name)
    apply_func_attrs(&decl, attrs)

    if async_at.is_some()
        refuse_foreign_async(p, async_at.unwrap(), decl)

        decl.marks.async_at = async_at
        decl.ret_type = async_result(decl.ret_type, async_at.unwrap())
    end if

    decl.at = start.to(p.just_taken())
    Some(stmt(decl.at, FuncDecl(decl)))
end try_func_decl

// Whether `const` here marks a function rather than opening a constant: the word, a name, and then
// the bracket a parameter list or a type-parameter list opens with. A constant has a `:` where the
// bracket would be, so one token past the name settles it. An `async` on either side of the word is
// stepped over, so the pair reaches `try_func_decl` and is refused there as the one mistake it is.
at_const_func(p: *Parser) -> bool
    var k: usize = if p.at_word("async") && p.kw_at(1, "const") then 1 else 0

    if !p.kw_at(k, "const") then return false
    if p.word_at(k + 1, "async") then k += 1

    val named = p.peek_at(k + 1) match
        Ident(_) -> true
        QuotedIdent(_) -> true
        _ -> false

    named && (p.kw_at(k + 2, "(") || p.kw_at(k + 2, "["))
end at_const_func

// **`async` and `const` do not combine, in either order.** A `const` function is run while compiling
// and answers its value there; an `async` one answers a task, which only a running program can step.
// The second word is refused and taken, so the declaration reads on as what the first word made it.
const AsyncConstRefusal: string = "'async' and 'const' do not combine: a 'const' function is run while compiling and answers its value there, and an 'async' function answers a task that only a running program can step — mark it one or the other"

// An `async` written in front of a `const`, refused and taken.
take_async_before_const(p: *Parser)
    if !(p.at_word("async") && p.kw_at(1, "const")) then return

    p.fault(p.here(), AsyncConstRefusal)
    p.bump()
end take_async_before_const

// An `async` written after a `const` that has been taken, refused and taken.
take_async_after_const(p: *Parser)
    take_async_word(p) match
        Some(at) -> p.fault(at, AsyncConstRefusal)
        None -> ()
end take_async_after_const

// Whether a function declaration begins here.
//
// **It is a scan over the tokens rather than a speculative parse.** `f(x: int) = x` and `f(x)`
// begin with the same two tokens, and what separates them is the *body* -- so the parenthesised
// list is stepped over as brackets, and what follows it is asked. A parse that read the list and
// put it back would have to throw away the diagnostics it found inside one, which is exactly the
// declaration whose reader most needs them.
private looks_like_func_decl(p: *Parser) -> bool
    // `async` in front is stepped over: what follows it is asked exactly as an unmarked declaration
    // would be, so `async f(x)` with no body is still not one.
    var i: usize = if at_async_word(p) then 1 else 0

    // **A calling convention can only introduce a declaration**, so the scan is over as soon as one
    // stands at the cursor. `interrupt timer()` with no body is a declaration whose body is missing
    // and is told so; read as an expression it would be two names on one line, and the reader would
    // be told a newline was expected in the middle of the thing they were writing.
    if at_call_conv_from(p, i) then return true

    if !names_a_decl(p.peek_at(i)) then return false

    i += 1

    if p.kw_at(i, "[")
        i = past_bracket(p, i)

        if i == 0 then return false

    if !p.kw_at(i, "(") then return false

    // **A receiver makes it a member rather than a function**, and a member is read by
    // `parse_member.sysl` inside the declaration that holds it. So a parameter list opening on one
    // of the receiver's spellings is not a function declaration at all: what stands here is a call
    // whose argument happens to be `self`, and reading it as a declaration would refuse the receiver
    // instead of saying what is actually wrong with the line.
    if p.kw_at(i + 1, "self") || p.kw_at(i + 1, "*") || p.kw_at(i + 1, "&") then return false

    // **A list opening on `name:` is a parameter list whatever follows it**: no argument is written
    // that way, so read as a call the line is refused at the colon, which says nothing about the type
    // the reader was in the middle of writing. `print(total:` followed by a block is refused where the
    // type should have been, as the reference refuses it.
    p.peek_at(i + 1) match
        Ident(_) -> if p.kw_at(i + 2, ":") then return true
        _ -> ()

    i = past_bracket(p, i)

    if i == 0 then return false

    if p.kw_at(i, "=") then return true
    if p.kw_at(i, "->") then return true

    p.peek_at(i) match
        Ident(n) -> if n == "where" then return true
        Newline -> return p.peek_at(i + 1) == Indent
        _ -> ()

    false
end looks_like_func_decl

// Whether a reserved word stands where a function's name would -- `loop() -> int = 1` -- followed
// by the WHOLE rest of a function's shape: a parameter list of `name: type`s and then a body, after
// a result type or a `where` if there is one. **Nothing shorter will do**, because a function
// stands where a statement does and statements open with a reserved word and a bracket:
// `return (x: int) -> x + 1` reads like a declaration as far as its result type, and only the
// missing body tells the two apart. So this is asked ahead of every declaration a reserved word
// opens, and declines everything a correct program writes.
at_reserved_func_head(p: *Parser) -> bool
    if reserved_here(p) == "" then return false

    var i: usize = 1

    if p.kw_at(i, "[")
        i = past_bracket(p, i)

        if i == 0 then return false
    end if

    if !p.kw_at(i, "(") then return false

    val listed = p.kw_at(i + 1, ")") || (names_a_decl(p.peek_at(i + 1)) && p.kw_at(i + 2, ":"))

    if !listed then return false

    val opened = i

    i = past_bracket(p, i)

    if i == 0 || !list_reads(p, opened, i) then return false

    // A result type is stepped over as far as the body it has to be followed by.
    if p.kw_at(i, "->")
        i += 1

        while !opens_func_body(p, i) && p.peek_at(i) != Newline
            if p.peek_at(i) == Eof then return false

            if p.kw_at(i, "(") || p.kw_at(i, "[") || p.kw_at(i, "{")
                i = past_bracket(p, i)

                if i == 0 then return false
            else
                i += 1
            end if
    end if

    if opens_func_body(p, i) then return true

    p.peek_at(i) == Newline && p.peek_at(i + 1) == Indent
end at_reserved_func_head

// Whether the parameter list between `from` and `to` could be read as one. The reference reads the
// list for real before it refuses the name, so a list holding something no parameter can -- a
// default calling `loop()`, the reserved word itself -- is not a function's shape and the line is
// left to the statement grammar. A reserved word followed by `(` is that tell, the three that take
// a type in brackets excepted.
private list_reads(p: *Parser, from: usize, to: usize) -> bool
    for i in from + 1..<to
        val w = p.peek_at(i) match
            Keyword(k) -> k
            _ -> ""

        val takes_a_type = w == "sizeof" || w == "alignof" || w == "offsetof"

        if is_reserved(w) && !takes_a_type && p.kw_at(i + 1, "(") then return false

    true
end list_reads

// Whether the token at `i` is an `=` or a `where`, either of which only a function's body follows.
private opens_func_body(p: *Parser, i: usize) -> bool
    if p.kw_at(i, "=") then return true

    p.peek_at(i) match
        Ident(n) -> n == "where"
        _ -> false
end opens_func_body

// Where the bracket pair opening at `i` ends, one token past its close -- or `0` where it never
// closes, which is a file that will not parse whatever this decides.
past_bracket(p: *Parser, at: usize) -> usize
    var i = at
    var depth: usize = 0

    loop
        p.peek_at(i) match
            Eof -> return 0
            Keyword(w) ->
                if w == "(" || w == "[" || w == "{"
                    depth += 1
                elif w == ")" || w == "]" || w == "}"
                    depth -= 1

                    if depth == 0 then return i + 1
            _ -> ()

        i += 1
end past_bracket

// `interrupt`, `interrupt(irq)` -- how a function is called.
//
// The word is contextual and needs a lookahead past its optional argument to find the name it
// qualifies, which is what keeps `interrupt` an ordinary identifier.
private at_call_conv(p: *Parser) -> bool = at_call_conv_from(p, 0)

// The same, asked `k` tokens along -- past an `async`.
private at_call_conv_from(p: *Parser, k: usize) -> bool
    val word = p.peek_at(k) match
        Ident(n) -> n == "interrupt"
        _ -> false

    if !word then return false

    if p.kw_at(k + 1, "(")
        p.peek_at(k + 2) match
            Ident(_) -> return p.kw_at(k + 3, ")") && names_a_decl(p.peek_at(k + 4))
            _ -> return false
    end if

    names_a_decl(p.peek_at(k + 1))
end at_call_conv_from

// -- `async` --------------------------------------------------------------------------------------

// Whether an `async` marking a declaration stands here. **The word is contextual**, so a program may
// still name a variable `async`: it marks a declaration only where a name follows it on the same
// line (`async load(…)`, `async interrupt …`), a shape no expression has.
at_async_word(p: *Parser) -> bool = p.at_word("async") && names_a_decl(p.peek_at(1))

// The `async` in front of a declaration taken, and where it was, or nothing where none stands here.
take_async_word(p: *Parser) -> Option[Span]
    if !at_async_word(p) then return None

    val at = p.here()

    p.bump()
    Some(at)
end take_async_word

// What an async function's caller receives: `Task[T]` for a written `T`, `Task[unit]` where none was
// written. The name is the compiler's own (`TaskBase`, which a program cannot spell), so a program
// that declares a `Task` of its own does not capture its async functions' results.
async_result(written: Option[TypeRef], at: Span) -> Option[TypeRef]
    val span = written.map(t -> t.span).unwrap_or(at)
    val inner = written.unwrap_or(TypeRef(at, NamedType("unit", buf())))
    var args: Buf[TypeRef] = buf()

    args.push(inner)
    Some(TypeRef(span, NamedType(TaskBase, args)))
end async_result

// **What C calls directly cannot be async**: calling an async function only makes its task, and C
// has nothing to drive one with. An `@export`, an interrupt handler and any other foreign calling
// convention (only `interrupt` exists) are all called that way. Each is refused at the `async` word.
private refuse_foreign_async(p: *Parser, at: Span, d: FuncDecl)
    if d.exported.is_some()
        p.fault(at, "an '@export'ed function cannot be 'async': C calls it directly, and calling an " +
                "async function only makes its task, which C has no way to drive. Export a plain " +
                "function and keep the 'async' one behind it")
        return
    end if

    if d.conv.is_some()
        p.fault(at, "an interrupt handler cannot be 'async': the hardware calls it directly, and " +
                "calling an async function only makes its task, which nothing there can drive")
    end if
end refuse_foreign_async

// `async extern` -- refused at the word, which is then stepped over so the `extern` is read as
// usual. An `extern` is a C function, and C cannot drive the task an async function's call makes.
refuse_async_extern(p: *Parser)
    if !(p.at_word("async") && p.kw_at(1, "extern")) then return

    p.fault(p.here(), "an 'extern' cannot be 'async': it names a C function, called directly, and " +
            "calling an async function only makes its task, which C has no way to drive")
    p.bump()
end refuse_async_extern

// `async` in front of something that is not a declaration -- a statement. In the entry file that is
// the program's own body, which C's `main` runs directly; anywhere, a statement runs where it stands
// and has no task to be made into.
refuse_async_statement(p: *Parser, start: Span) -> Stmt
    p.fault(p.here(), "'async' marks a function declaration, and what follows it here is a " +
            "statement. The statements of a body run where they stand — the entry file's are the " +
            "program's 'main', which C calls directly and cannot drive a task through — so put the " +
            "work in an 'async' function instead")
    skip_line(p)
    stmt(start.to(p.just_taken()), Bad)
end refuse_async_statement

// Whether a reserved word stands where a parameter's name does, which is the one case a name that
// is not an identifier is still read -- so that it can be refused with the backticks that work.
private at_reserved_binding(p: *Parser) -> bool = p.peek() match
    Keyword(w) -> is_reserved(w) && p.kw_at(1, ":")
    _ -> false

private names_a_decl(t: Tok) -> bool = t match
    Ident(_) -> true
    QuotedIdent(_) -> true
    _ -> false

private parse_call_conv(p: *Parser) -> CallConv
    val start = p.here()

    p.bump()

    var arg: Option[string] = None

    if p.accept_kw("(")
        arg = Some(parse_bound_name(p))
        p.expect_kw(")")
    end if

    CallConv(start.to(p.just_taken()), "interrupt", arg)
end parse_call_conv

// What a function declares after `->`: one type, or the several a result list names.
parse_result_type(p: *Parser) -> TypeRef
    val start = p.here()

    // `some Trait` is the whole result where it is written at all, so it is read here and returned
    // rather than joining the list a comma would open.
    parse_some_result(p) match
        Some(t) -> return t
        None -> ()

    val first = parse_type(p)

    if !p.at_kw(",") then return first

    var parts: Buf[TypeRef] = buf()

    parts.push(first)

    loop
        if !p.accept_kw(",") then break

        parts.push(parse_type(p))

    type_ref(start.to(p.just_taken()), TupleType(parts, true))
end parse_result_type

// `where T: Display` written after a signature, folded into the parameters it bounds.
//
// **A clause naming a parameter the declaration does not have is refused here**, where the list of
// the ones it does have is still in hand.
parse_where_on(p: *Parser, tp: TypeParams) -> TypeParams
    val at = p.here()

    if !p.accept_word("where") then return tp

    var out = tp
    val clause = parse_where_bounds(p)

    for i in 0..<clause.len()
        val w = clause.at(i)

        if holds_value_param(out, w.name)
            p.fault(w.span, s"'${w.name}' stands for a value rather than a type, and a value implements no trait — its 'const' declaration is where the type its argument must have is written")
        elif !holds_type_param(out, w.name)
            p.fault(w.span, s"this declaration has no type parameter '${w.name}', so a 'where' clause has nothing to bound — ${takes_text(out)}")
        else
            add_bounds(&out, w.name, w.bounds)

    out
end parse_where_on

private holds_type_param(tp: TypeParams, name: string) -> bool
    for n in tp.names.view()
        if n == name then return true

    false
end holds_type_param

private holds_value_param(tp: TypeParams, name: string) -> bool
    for i in 0..<tp.values.len()
        if tp.values.at(i).name == name then return true

    false
end holds_value_param

private takes_text(tp: TypeParams) -> string
    if tp.names.is_empty() then return "it takes none"

    var out = "it takes "

    for i in 0..<tp.names.len()
        if i > 0 then out = out + ", "

        out = out + s"'${tp.names.at(i)}'"

    out
end takes_text

private add_bounds(tp: *TypeParams, name: string, bounds: Buf[BoundRef])
    for i in 0..<tp.bounds.len()
        if tp.bounds.at(i).name == name
            var slot = tp.bounds.at(i)

            for j in 0..<bounds.len()
                slot.bounds.push(bounds.at(j))

            tp.bounds.set(i, slot)
            return

    tp.bounds.push(NamedBounds(name, bounds))
end add_bounds

// A function's body: `= value` on the line, `= ` with a block under it, or a block with no `=` at
// all.
parse_func_body(p: *Parser) -> Buf[Stmt]
    if !p.accept_kw("=") then return parse_suite(p)
    if p.block_ahead() then return parse_suite(p)

    var out: Buf[Stmt] = buf()
    val start = p.here()
    var values: Buf[Expr] = buf()

    loop
        values.push(lift_placeholders(parse_expr(p)))

        if !p.accept_kw(",") then break

    if values.len() == 1
        out.push(stmt(values.at(0).span, ExprStmt(values.at(0))))
        return out
    end if

    val list = expr(start.to(p.just_taken()), ResultList(values))

    out.push(stmt(list.span, ExprStmt(list)))
    out
end parse_func_body

// -- extern ------------------------------------------------------------------------------------

// `extern "name" f(a: int) -> int` and `extern var errno: int`.
//
// **An `extern` declares no type parameters**: there is no body to monomorphize, and a foreign
// symbol is one function at one signature.
parse_extern_decl(p: *Parser, start: Span, vis: Visibility, needs: Buf[string]) -> Stmt
    p.bump()

    var link: Option[string] = None

    p.peek() match
        StrLit(v) ->
            p.bump()
            link = Some(v)
        _ -> ()

    if p.at_kw("var") then return parse_extern_var(p, start, vis, link)

    val name = parse_bound_name(p)

    // The refusal anchors at what follows the bracket, where the reference's does.
    if p.accept_kw("[")
        p.fault(p.here(), "an 'extern' declares no type parameters — there is no body to monomorphize, and a foreign symbol is one function at one signature")
        skip_line(p)
        return stmt(start.to(p.just_taken()), Bad)
    end if

    if p.accept_kw(":")
        // The colon committed the declaration to being a variable, so what is missing is the type
        // the other side laid down, not whatever token a type would have begun with.
        if !begins_type(p.peek())
            p.fault(p.here(), s"an 'extern' variable states the type the other side laid down — 'extern ${name}: T'")
            skip_line(p)
            return stmt(start.to(p.just_taken()), Bad)
        end if

        val typ = parse_type(p)

        return stmt(start.to(p.just_taken()), ExternVarDecl(name, typ, link, vis))
    end if

    if !p.at_kw("(")
        p.fault(p.here(), s"an 'extern' declares a function — '${name}(params) -> result' — or a variable — '${name}: type' — so what follows the name is '(' or ':'")
        skip_line(p)
        return stmt(start.to(p.just_taken()), Bad)
    end if

    p.bump()

    var params: Buf[Param] = buf()
    val variadic = parse_param_list(p, &params)

    p.expect_kw(")")

    var ret: Option[TypeRef] = None

    if p.accept_kw("->") then ret = Some(parse_type(p))

    stmt(start.to(p.just_taken()), ExternDecl(ExternDecl(name, params, ret, variadic, link, vis,
        needs)))
end parse_extern_decl

private parse_extern_var(p: *Parser, start: Span, vis: Visibility, link: Option[string]) -> Stmt
    p.bump()

    val name = parse_bound_name(p)

    p.expect_kw(":")

    val typ = parse_type(p)

    stmt(start.to(p.just_taken()), ExternVarDecl(name, typ, link, vis))
end parse_extern_var

// -- type declarations ---------------------------------------------------------------------------

// `type Name = Base`, and the constrained forms that add a range or a predicate.
//
// `new` is what makes the name a type of its own rather than another spelling of its base.
parse_type_decl(p: *Parser, start: Span, vis: Visibility) -> Stmt
    p.bump()

    val name = parse_bound_name(p)
    var tp = no_type_params()

    if p.at_kw("[") then tp = parse_type_params(p)

    p.expect_kw("=")

    val derived = p.accept_word("new")
    val base = parse_type(p)
    var range: Option[RangeBound] = None
    var pred: Option[Expr] = None
    var wrapping: Option[Span] = None

    // `wrapping` comes straight after the base -- `type Acc = new i64q61 wrapping` -- and is a word
    // only here, as `within` and `where` are.
    if p.at_word("wrapping")
        wrapping = Some(p.here())
        p.bump()
    end if

    if p.at_word("within") then range = Some(parse_within(p))
    if p.accept_word("where") then pred = Some(parse_expr(p))

    stmt(start.to(p.just_taken()), TypeDecl(TypeDecl(name, base, derived, range, pred, vis, false, None,
                                                      wrapping, tp)))
end parse_type_decl

private parse_within(p: *Parser) -> RangeBound
    val start = p.here()

    p.bump()

    val lo = parse_expr_bp(p, BitOrPower)
    val exclusive = p.at_kw("..<")

    if !p.accept_kw("..<") then p.expect_kw("..")

    val hi = parse_expr_bp(p, BitOrPower)

    RangeBound(start.to(p.just_taken()), lo, hi, exclusive)
end parse_within

// -- the C a library carries ------------------------------------------------------------------------

// `c const` and its constants, each of whose values is a C expression in quotes.
//
// **`c` is contextual and stays an ordinary identifier**, which the keyword after it is what makes
// safe: nothing else in the language may follow a name with a keyword.
parse_c_const_block(p: *Parser, start: Span, vis: Visibility) -> Stmt
    p.bump()
    p.bump()

    var consts: Buf[CConstDecl] = buf()

    if !p.block_ahead()
        p.fault(p.here(), "'c const' is followed by its constants, indented under it, each a name and a type and a C expression in quotes: 'SIZE: usize = \"sizeof(struct s)\"'")
        skip_line(p)
        return stmt(start.to(p.just_taken()), CConstBlock(consts))
    end if

    p.bump()
    p.bump()
    p.skip_newlines()

    loop
        if p.at(Dedent) || p.at(Eof) then break

        val at = p.here()
        val name = parse_bound_name(p)

        p.expect_kw(":")

        val typ = parse_type(p)

        p.expect_kw("=")

        val c = accept_string(p) match
            Some(v) -> v
            None -> ""

        consts.push(CConstDecl(at.to(p.just_taken()), name, typ, c, vis))
        p.skip_newlines()

    if !p.accept(Dedent) then p.want("dedent")

    stmt(start.to(p.just_taken()), CConstBlock(consts))
end parse_c_const_block

// `c type` -- the sysl types a file's C typedefs turn out to be.
//
// **A line carries no sysl type**, which is the whole difference from a `c const` line: the type is
// the answer rather than the question, and writing one would assert what the measurement is for.
parse_c_type_block(p: *Parser, start: Span, vis: Visibility) -> Stmt
    p.bump()
    p.bump()

    var types: Buf[CTypeDecl] = buf()

    if !p.block_ahead()
        p.fault(p.here(), "'c type' is followed by its types, indented under it, each a name and a C type name in quotes: 'Tick = \"TickType_t\"'")
        skip_line(p)
        return stmt(start.to(p.just_taken()), CTypeBlock(types))
    end if

    p.bump()
    p.bump()
    p.skip_newlines()

    loop
        if p.at(Dedent) || p.at(Eof) then break

        val at = p.here()
        val name = parse_bound_name(p)

        p.expect_kw("=")

        val c = accept_string(p) match
            Some(v) -> v
            None -> ""

        types.push(CTypeDecl(at.to(p.just_taken()), name, c, vis))
        p.skip_newlines()

    if !p.accept(Dedent) then p.want("dedent")

    stmt(start.to(p.just_taken()), CTypeBlock(types))
end parse_c_type_block
