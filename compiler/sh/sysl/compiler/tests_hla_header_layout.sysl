module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture
import sysl.text.{replace_all, Search}

// **A struct's layout attributes reach the header `build-c` writes** (`reference/ffi.md § Naming a
// struct in the header`). Each case is checked from both sides with the same numbers: an `@assert` in
// the sysl module, which the header's own analysis settles, and a `_Static_assert` in a C file that
// includes the header, which clang settles for each machine. Two halves stating one number is the
// statement that sysl and C lay the type out alike -- C is the oracle.

private hla_ready() -> bool = std_root().is_ok() && clang_available()

// The machines each case is checked on: sysl's target and clang's triple for it, the host first.
private hla_target(i: int) -> (string, string) = i match
    0 -> ("", "")
    1 -> ("thumbv7em-freestanding", "thumbv7em-none-eabi")
    2 -> ("aarch64-freestanding", "aarch64-none-elf")
    _ -> ("x86_64-windows", "x86_64-pc-windows-msvc")

// `sysl <args>` as the command line answers it: the status, and everything it said.
private hla_cli(args: []string) -> (int, string)
    var said: Buf[string] = buf()
    val sink = &said
    val code = run_cli(args, piece -> sink.push(piece))
    var text = ""

    for item in said
        text = text + item + "\n"

    reset_search_paths()
    (code, text)
end hla_cli

// A project holding nothing but `mylib`, as an archive project is.
private hla_project(lib: string) -> string
    val root = make_temp_dir("sysl-hla").unwrap()

    write_text(s"$root/package.hocon", "package {\n  name = \"probe\"\n}\n").unwrap()
    make_dir_all(s"$root/mylib").unwrap()
    write_text(s"$root/mylib/mylib.sysl", s"module mylib\n\n$lib").unwrap()
    root
end hla_project

// The header for `root` on a sysl target ("" for the host).
private hla_header(root: string, target: string) -> (int, string)
    var hosted: [3]string = ["sysl", "emit-header", root]
    var bare: [5]string = ["sysl", "emit-header", "--target", target, root]

    if target == "" then hla_cli(hosted[..]) else hla_cli(bare[..])
end hla_header

// clang reading `c` beside `header` for `triple` ("" for the host): whether it compiled, and what it said.
// `msvc` takes `__clang__` away, so the header's MSVC side -- the pragma and `__declspec` -- is the one
// read, by clang's own emulation of that compiler's layout.
private hla_clang(root: string, header: string, c: string, triple: string, msvc: bool = false) -> (bool, string)
    write_text(s"$root/probe.h", header).unwrap()
    write_text(s"$root/probe.c", s"#include <stddef.h>\n#include \"probe.h\"\n\n$c").unwrap()

    val cc = find_clang(host_target(), None).unwrap()
    var args: Buf[string] = buf()

    if triple != "" then
        args.push("-target")
        args.push(triple)
        args.push("-ffreestanding")

    if msvc then
        args.push("-fms-extensions")
        args.push("-U__clang__")
        args.push("-Wno-builtin-macro-redefined")

    args.push("-std=c11")
    args.push("-Wall")
    args.push("-Werror")
    args.push("-fsyntax-only")
    args.push(s"-I$root")
    args.push(s"$root/probe.c")

    val ran = capture(cc, args.view(), "", [], true).unwrap()

    (ran.status.ok(), ran.text + ran.err.unwrap_or(""))
end hla_clang

// The sysl half of every case: each struct, and an `@assert` of its size, alignment and offsets.
private hla_lib() -> string =
    "@packed\n@export(\"wire_hdr\")\nstruct WireHdr\n    tag: u8\n    len: u32\n\n" +
    "@align(16)\n@export(\"al\")\nstruct Al\n    x: u8\n\n" +
    "@packed\n@align(8)\n@export(\"pa\")\nstruct Pa\n    a: u8\n    b: u16\n\n" +
    "@export(\"outer\")\nstruct Outer\n    c: u8\n    h: WireHdr\n    d: u8\n    a: Al\n    hs: [3]WireHdr\n\n" +
    "@export(\"hdr_table\")\nvar table: [3]WireHdr\n\n" +
    "@packed\n@export(\"bits\")\nstruct Bits\n    a: u3\n    b: u5\n\n" +
    "@packed\n@export(\"wide_bits\")\nstruct WideBits\n    a: u3\n    b: u21\n\n" +
    "@byte_order(big)\n@export(\"be\")\nstruct Be\n    a: u16\n    b: u32\n\n" +
    "@assert(sizeof(WireHdr) == 5 && alignof(WireHdr) == 1 && offsetof(WireHdr, len) == 1)\n" +
    "@assert(sizeof(Al) == 16 && alignof(Al) == 16)\n" +
    "@assert(sizeof(Pa) == 8 && alignof(Pa) == 8 && offsetof(Pa, b) == 1)\n" +
    "@assert(sizeof(Outer) == 48 && alignof(Outer) == 16)\n" +
    "@assert(offsetof(Outer, h) == 1 && offsetof(Outer, d) == 6 && offsetof(Outer, a) == 16 && offsetof(Outer, hs) == 32)\n" +
    "@assert(sizeof(Bits) == 1 && alignof(Bits) == 1)\n" +
    "@assert(sizeof(WideBits) == 3 && alignof(WideBits) == 1)\n" +
    "@assert(sizeof(Be) == 8 && alignof(Be) == 4 && offsetof(Be, b) == 4)\n\n" +
    "@export(\"hla_take\")\ntake(a: WireHdr, b: *Al, c: Pa, d: *Outer, f: Bits, g: WideBits, h: Be) -> u32 = 0\n"

// The C half: the same numbers, as the header declares the types.
private hla_c() -> string =
    "_Static_assert(sizeof(wire_hdr) == 5 && _Alignof(wire_hdr) == 1 && offsetof(wire_hdr, len) == 1, \"wire_hdr\");\n" +
    "_Static_assert(sizeof(al) == 16 && _Alignof(al) == 16, \"al\");\n" +
    "_Static_assert(sizeof(pa) == 8 && _Alignof(pa) == 8 && offsetof(pa, b) == 1, \"pa\");\n" +
    "_Static_assert(sizeof(outer) == 48 && _Alignof(outer) == 16, \"outer\");\n" +
    "_Static_assert(offsetof(outer, h) == 1 && offsetof(outer, d) == 6 && offsetof(outer, a) == 16 && offsetof(outer, hs) == 32, \"outer fields\");\n" +
    "_Static_assert(sizeof(hdr_table) == 15 && _Alignof(wire_hdr[3]) == 1, \"hdr_table\");\n" +
    "_Static_assert(sizeof(bits) == 1 && _Alignof(bits) == 1, \"bits\");\n" +
    "_Static_assert(sizeof(wide_bits) == 3 && _Alignof(wide_bits) == 1, \"wide_bits\");\n" +
    "_Static_assert(sizeof(be) == 8 && _Alignof(be) == 4 && offsetof(be, b) == 4, \"be\");\n"

// Both halves on one machine: the header is written, so every `@assert` held, and clang agrees.
private hla_agrees(lib: string, c: string, target: string, triple: string) -> string
    val root = hla_project(lib)
    val got = hla_header(root, target)

    assert_eq(got.0, 0, got.1)

    val compiled = hla_clang(root, got.1, c, triple)

    remove_dir_all(root).unwrap_or(())
    assert(compiled.0, s"on '$triple':\n${compiled.1}\n${got.1}")
    got.1
end hla_agrees

@test("a packed, an aligned, a nested and a bitfield struct are laid out alike by sysl and by C")
hla_layouts_agree()
    if !hla_ready() then return

    for i in 0..<4
        hla_agrees(hla_lib(), hla_c(), hla_target(i).0, hla_target(i).1)
end hla_layouts_agree

@test("MSVC's spelling -- '#pragma pack' and '__declspec(align)' -- lays them out alike too")
hla_msvc_spelling_agrees()
    if !hla_ready() then return

    val root = hla_project(hla_lib())
    val got = hla_header(root, "x86_64-windows")

    assert_eq(got.0, 0, got.1)

    val compiled = hla_clang(root, got.1, hla_c(), "x86_64-pc-windows-msvc", true)

    remove_dir_all(root).unwrap_or(())
    assert(compiled.0, compiled.1)
end hla_msvc_spelling_agrees

@test("the header spells the attributes through macros clang, gcc and MSVC each read")
hla_the_header_text()
    if !hla_ready() then return

    val h = hla_agrees(hla_lib(), hla_c(), "", "")

    assert(h.contains("typedef struct SYSL_PACKED {\n\tuint8_t tag;\n\tuint32_t len;\n} wire_hdr;\n"), h)
    assert(h.contains("typedef struct SYSL_ALIGNED(16) {\n\tuint8_t x;\n} al;\n"), h)
    assert(h.contains("SYSL_PACK_PUSH\ntypedef struct SYSL_ALIGNED(8) SYSL_PACKED {\n"), h)
    assert(h.contains("typedef struct {\n\tuint8_t c;\n\twire_hdr h;\n"), h)
    assert(h.contains("extern wire_hdr hdr_table[3];\n"), h)
    assert(h.contains("#define SYSL_PACKED __attribute__((packed))\n"), h)
    assert(h.contains("#define SYSL_ALIGNED(n) __declspec(align(n))\n"), h)
    assert(h.contains("#define SYSL_PACK_PUSH __pragma(pack(push, 1))\n"), h)
    assert(h.index_of("#ifndef SYSL_PACKED").unwrap() < h.index_of("typedef struct").unwrap(), h)
end hla_the_header_text

@test("a bitfield struct is the one integer it is stored as, with each field's bits named")
hla_bitfields_are_one_integer()
    if !hla_ready() then return

    val h = hla_agrees(hla_lib(), hla_c(), "", "")

    assert(h.contains("typedef struct SYSL_PACKED {\n\t/* a: bits 0..2 */\n\t/* b: bits 3..7 */\n\tuint8_t bits;\n} bits;\n"), h)
    assert(h.contains("\t/* b: bits 3..23 */\n\tuint8_t bits[3];\n} wide_bits;\n"), h)
    assert(!h.contains("uint3_t"), h)
end hla_bitfields_are_one_integer

@test("a struct with no layout attribute brings no macros")
hla_no_macros_without_attributes()
    if !hla_ready() then return

    val lib = "@export(\"plain\")\nstruct Plain\n    a: u8\n    b: u32\n\n" +
              "@assert(sizeof(Plain) == 8 && offsetof(Plain, b) == 4)\n\n" +
              "@export(\"hla_plain\")\nplain(p: Plain) -> u32 = p.b\n"
    val h = hla_agrees(lib, "_Static_assert(sizeof(plain) == 8 && offsetof(plain, b) == 4, \"plain\");\n", "", "")

    assert(!h.contains("SYSL_PACKED"), h)
    assert(h.contains("typedef struct {\n\tuint8_t a;\n\tuint32_t b;\n} plain;\n"), h)
end hla_no_macros_without_attributes

@test("'@byte_order' has no C spelling, so the header says so above the typedef")
hla_byte_order_is_a_comment()
    if !hla_ready() then return

    val h = hla_agrees(hla_lib(), hla_c(), "", "")

    assert(h.contains("/* @byte_order(big): each integer field holds its bytes most significant first on every machine, which C cannot declare -- swap a field where this machine's order differs. */\ntypedef struct {\n\tuint16_t a;\n\tuint32_t b;\n} be;\n"), h)
end hla_byte_order_is_a_comment

// A packed struct holding an aligned one: clang and gcc pack the member to one byte as sysl does,
// MSVC's layout keeps its sixteen.
private hla_pha_lib() -> string =
    "@align(16)\n@export(\"al\")\nstruct Al\n    x: u8\n\n" +
    "@export(\"al_row\")\nstruct AlRow\n    n: u8\n    row: [2]Al\n\n" +
    "@packed\n@export(\"pha\")\nstruct Pha\n    x: u8\n    a: Al\n\n" +
    "@packed\n@export(\"phr\")\nstruct Phr\n    x: u8\n    r: AlRow\n\n" +
    "@assert(sizeof(Pha) == 17 && alignof(Pha) == 1 && offsetof(Pha, a) == 1)\n" +
    "@assert(sizeof(Phr) == 49 && alignof(Phr) == 1 && offsetof(Phr, r) == 1)\n\n" +
    "@export(\"hla_pha\")\npha(a: *Pha, b: *Phr) -> u8 = a.x\n"

private hla_pha_c() -> string =
    "_Static_assert(sizeof(pha) == 17 && _Alignof(pha) == 1 && offsetof(pha, a) == 1, \"pha\");\n" +
    "_Static_assert(sizeof(phr) == 49 && _Alignof(phr) == 1 && offsetof(phr, r) == 1, \"phr\");\n"

@test("a packed struct holding an aligned one agrees where C packs it")
hla_packed_holds_aligned()
    if !hla_ready() then return

    for i in 0..<3
        hla_agrees(hla_pha_lib(), hla_pha_c(), hla_target(i).0, hla_target(i).1)
end hla_packed_holds_aligned

@test("and stops MSVC's layout, which keeps the member's alignment, with an #error naming the struct")
hla_packed_holds_aligned_stops_msvc()
    if !hla_ready() then return

    val root = hla_project(hla_pha_lib())
    val got = hla_header(root, "x86_64-windows")

    assert_eq(got.0, 0, got.1)

    val compiled = hla_clang(root, got.1, hla_pha_c(), "x86_64-pc-windows-msvc")

    remove_dir_all(root).unwrap_or(())
    assert(!compiled.0, got.1)
    assert_eq(compiled.1.contains("'pha' is a @packed struct holding a field of an @align(n) type, and MSVC's layout keeps that field's alignment where sysl packs it"),
              true, compiled.1)
    assert_eq(compiled.1.contains("'phr' is a @packed struct holding a field of an @align(n) type"), true, compiled.1)
end hla_packed_holds_aligned_stops_msvc

@test("a number either half gets wrong stops it: the sysl half at the header, the C half at clang")
hla_both_halves_can_fail()
    if !hla_ready() then return

    val root = hla_project(replace_all(hla_lib(), "sizeof(WireHdr) == 5", "sizeof(WireHdr) == 8"))
    val got = hla_header(root, "")

    remove_dir_all(root).unwrap_or(())
    assert(got.0 != 0, got.1)

    val root2 = hla_project(hla_lib())
    val good = hla_header(root2, "thumbv7em-freestanding")
    val compiled = hla_clang(root2, good.1, replace_all(hla_c(), "sizeof(wire_hdr) == 5", "sizeof(wire_hdr) == 8"),
                             "thumbv7em-none-eabi")

    remove_dir_all(root2).unwrap_or(())
    assert(!compiled.0, compiled.1)
    assert(compiled.1.contains("wire_hdr"), compiled.1)
end hla_both_halves_can_fail
