module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture
import sysl.text.Search

// `<N>U(v)` (`reference/vectors.md § Converting lanes`): every lane converted as `U(x)` converts one
// scalar, as one instruction over the register wherever the scalar's is one. The run tests are the
// values -- a matrix of lane pairs at two, four and eight lanes, since a back end legalizes each width
// differently -- and the IR tests are the shape: one cast, no lane extracted.

private vcv_build_run(text: string) -> string
    val root = make_temp_dir("sysl-vector-convert").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", text).unwrap()

    val exe = s"$root/built"

    build_native_program(s"$root/main.sysl", None, None, DefaultOptimization, Some(exe)) match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return failure_text(why)
        Ok(_) -> ()

    val said = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    said match
        Err(_) -> "the program that was built could not be run"
        Ok(out) -> out.text
end vcv_build_run

// One lane pair: the source lane type and eight values, the target lane type and the eight values
// the scalar conversion gives. A width of N takes the first N of each.
private struct VcvRow
    from: string
    values: [8]string
    to: string
    want: [8]string

private vcv_rows() -> Buf[VcvRow]
    var rows: Buf[VcvRow] = buf()

    // An integer to a float, by the source's signedness.
    rows.push(VcvRow("i32", ["-3", "5", "7", "-9", "11", "-13", "15", "-17"], "f64",
                     ["-3", "5", "7", "-9", "11", "-13", "15", "-17"]))
    rows.push(VcvRow("u16", ["1", "65535", "2", "40000", "4", "5", "6", "7"], "f32",
                     ["1", "65535", "2", "40000", "4", "5", "6", "7"]))
    rows.push(VcvRow("u64", ["18446744073709551615", "0", "2", "3", "4", "5", "6", "7"], "f64",
                     ["18446744073709552000", "0", "2", "3", "4", "5", "6", "7"]))
    // A float to an integer: toward zero, saturating at the width's ends.
    rows.push(VcvRow("f64", ["-2.7", "3.9", "1e20", "-1e20", "0.5", "-0.5", "100.25", "7"], "i32",
                     ["-2", "3", "2147483647", "-2147483648", "0", "0", "100", "7"]))
    rows.push(VcvRow("f32", ["-1.5", "300.5", "70000", "2", "3", "4", "5", "6"], "u16",
                     ["0", "300", "65535", "2", "3", "4", "5", "6"]))
    // Widening, by the source's sign.
    rows.push(VcvRow("i8", ["-5", "127", "-128", "1", "2", "3", "4", "5"], "i64",
                     ["-5", "127", "-128", "1", "2", "3", "4", "5"]))
    rows.push(VcvRow("u8", ["250", "0", "255", "1", "2", "3", "4", "5"], "i32",
                     ["250", "0", "255", "1", "2", "3", "4", "5"]))
    // Narrowing keeps the low bits, and a sign change at one width is the same bits.
    rows.push(VcvRow("i32", ["300", "-1", "256", "1", "2", "3", "4", "5"], "u8",
                     ["44", "255", "0", "1", "2", "3", "4", "5"]))
    rows.push(VcvRow("i32", ["-1", "7", "-2", "1", "2", "3", "4", "5"], "u32",
                     ["4294967295", "7", "4294967294", "1", "2", "3", "4", "5"]))
    // Between floats, and the pair neither of which is wider.
    rows.push(VcvRow("f32", ["1.5", "-2.25", "0.125", "3", "4", "5", "6", "7"], "f64",
                     ["1.5", "-2.25", "0.125", "3", "4", "5", "6", "7"]))
    rows.push(VcvRow("f64", ["1.5", "-2.25", "0.125", "3", "4", "5", "6", "1e300"], "f32",
                     ["1.5", "-2.25", "0.125", "3", "4", "5", "6", "inf"]))
    rows.push(VcvRow("f16", ["1.5", "-2.25", "0.125", "3", "4", "5", "6", "7"], "bf16",
                     ["1.5", "-2.25", "0.125", "3", "4", "5", "6", "7"]))
    // An integer past 128 bits has no instruction to or from a float, and goes lane by lane.
    rows.push(VcvRow("u256", ["1", "1000", "7", "3", "4", "5", "6", "7"], "real",
                     ["1", "1000", "7", "3", "4", "5", "6", "7"]))
    rows.push(VcvRow("f64", ["1.5", "1000.9", "-3", "3", "4", "5", "6", "7"], "u256",
                     ["1", "1000", "0", "3", "4", "5", "6", "7"]))
    // A fixed-point lane rescales and rounds, as its scalar does.
    rows.push(VcvRow("f32", ["0.5", "-0.25", "2", "-2", "0", "0.75", "0.125", "-1"], "q15",
                     ["0.5", "-0.25", "0.99997", "-1", "0", "0.75", "0.125", "-1"]))
    // A `char` lane to an integer is its scalar value.
    rows.push(VcvRow("char", ["'a'", "'z'", "'0'", "'A'", "'b'", "'c'", "'d'", "'e'"], "u32",
                     ["97", "122", "48", "65", "98", "99", "100", "101"]))
    rows
end vcv_rows

private vcv_list(xs: [8]string, n: int, sep: string) -> string
    var out = ""

    for i in 0..<n
        if i > 0 then out = out + sep

        out = out + xs[i]

    out
end vcv_list

// One program for every row at `n` lanes, and what it prints.
private vcv_matrix(n: int) -> (string, string)
    var src = ""
    var want = ""
    val rows = vcv_rows()

    for k in 0..<rows.len()
        val row = rows[k]
        var reads = ""

        for i in 0..<n
            if i > 0 then reads = reads + ", "

            reads = reads + s"c$k[$i]"

        src = src + s"val r$k: <$n>${row.from} = [${vcv_list(row.values, n, ", ")}]\n" +
            s"val c$k = <$n>${row.to}(r$k)\nprint($reads)\n"
        want = want + vcv_list(row.want, n, " ") + "\n"
    end for

    (src, want)
end vcv_matrix

@test("every lane pair converts as its scalar does, at two lanes")
vcv_the_matrix_at_two()
    if !enm_ready() then return

    val (src, want) = vcv_matrix(2)

    assert_eq(vcv_build_run(src), want)

@test("every lane pair converts as its scalar does, at four lanes")
vcv_the_matrix_at_four()
    if !enm_ready() then return

    val (src, want) = vcv_matrix(4)

    assert_eq(vcv_build_run(src), want)

@test("every lane pair converts as its scalar does, at eight lanes")
vcv_the_matrix_at_eight()
    if !enm_ready() then return

    val (src, want) = vcv_matrix(8)

    assert_eq(vcv_build_run(src), want)

@test("a NaN lane becomes zero, as the scalar's does")
vcv_a_nan_lane_is_zero()
    if !enm_ready() then return

    assert_eq(vcv_build_run(raw"""
        val zero = 0.0
        val v: <4>f64 = [zero / zero, 1.5, -1.0 / zero, 1.0 / zero]
        val w = <4>i32(v)
        print(w[0], w[1], w[2], w[3])
        """), "0 1 -2147483648 2147483647\n")

// ---- the neighbours ----

@test("a generic body converts to whatever its parameters are bound to")
vcv_inside_a_generic()
    if !enm_ready() then return

    assert_eq(vcv_build_run(raw"""
        lanes_as[T, const N: usize](v: <N>i32) -> <N>T = <N>T(v)

        val v: <4>i32 = [1, -2, 3, 300]
        val f: <4>f32 = lanes_as(v)
        val b: <4>u8 = lanes_as(v)
        val two: <2>i32 = [7, 8]
        val d: <2>f64 = lanes_as(two)
        print(f[1], b[1], b[3], d[1])
        """), "-2 254 44 8\n")

@test("a literal argument is written at the vector: a list of lanes, or a splat")
vcv_a_literal_argument()
    if !enm_ready() then return

    assert_eq(vcv_build_run(raw"""
        val a = <4>f32([1, 2, 3, 4])
        val b = <4>u8(7)
        val c = <2>f64(-0.5)
        val d = <2>i64([-1, 2])
        print(a[3] / 8, b[2], c[1], d[0])
        """), "0.5 7 -0.5 -1\n")

@test("an array of the lanes converts as the vector would")
vcv_an_array_argument()
    if !enm_ready() then return

    assert_eq(vcv_build_run(raw"""
        val xs: [4]i32 = [1, -2, 3, -4]
        val v = <4>f64(xs)
        val back: [4]i32 = <4>i32(v * 2.5)
        print(v[1], back[0], back[3])
        """), "-2 2 -10\n")

@test("conversions chain, and one into the same lane type is the value")
vcv_chained()
    if !enm_ready() then return

    assert_eq(vcv_build_run(raw"""
        val v: <4>i16 = [-300, 2, 3, 400]
        val w = <4>i16(<4>u8(<4>i64(<4>f32(v))))
        val same = <4>i16(v)
        print(w[0], w[3], same[0], <4>f64(<4>i32(<4>f64(v) * 0.5))[0])
        """), "212 144 -300 -150\n")

@test("a module-level conversion over a constant is worked out while compiling")
vcv_a_module_constant()
    if !enm_ready() then return

    assert_eq(vcv_build_run(raw"""
        val ints: <4>i32 = [1, -2, 300, 4]
        val reals = <4>f64(ints)
        val bytes = <4>u8(ints)
        val fx = <4>q15(<4>f32([0.5, -0.25, 2, 0]))

        f() -> real = reals[1] + real(bytes[2])

        print(f(), bytes[1], fx[2])
        """), "42 254 0.99997\n")

// ---- refusals ----

@test("a different length is refused, naming both")
vcv_a_different_length()
    if !enm_ready() then return

    val said = enm_err("val v: <4>i16 = [1, 2, 3, 4]\nval w = <2>f32(v)\n")

    assert(said.contains("a vector converts lane by lane only at one length: <4>i16 has 4 lanes " +
                         "and <2>f32 has 2 lanes"), said)

@test("an array of a different length is refused, naming its elements")
vcv_an_array_of_a_different_length()
    if !enm_ready() then return

    val said = enm_err("val xs: [3]i16 = [1, 2, 3]\nval w = <4>f32(xs)\n")

    assert(said.contains("a vector converts lane by lane only at one length: [3]i16 has 3 " +
                         "elements and <4>f32 has 4 lanes"), said)

@test("a lane pair the scalar refuses is refused for the vector")
vcv_a_lane_the_scalar_refuses()
    if !enm_ready() then return

    val said = enm_err("val v: <4>f32 = [1, 2, 3, 4]\nval w = <4>char(v)\n")

    assert(said.contains("cannot convert <4>f32 to <4>char — a lane of f32 does not convert to char"),
           said)

@test("a scalar is not converted into a vector")
vcv_a_scalar_is_refused()
    if !enm_ready() then return

    val said = enm_err("val x: i16 = 3\nval w = <4>f32(x)\n")

    assert(said.contains("cannot convert i16 to <4>f32"), said)

@test("nothing converts without being written")
vcv_implicit_stays_refused()
    if !enm_ready() then return

    val said = enm_err("val v: <4>i32 = [1, 2, 3, 4]\nval w: <4>f64 = v\n")

    assert(said != "", "an implicit lane conversion compiled")
    assert(said.contains("<4>i32") && said.contains("<4>f64"), said)

@test("a vector type with no call is told what it is for")
vcv_a_bare_vector_type()
    if !enm_ready() then return

    val said = enm_err("val w = <4>f32\n")

    assert(said.contains("'(' expected — a vector type in an expression converts a value, as " +
                         "'<4>f32(v)'"), said)

@test("a conversion takes exactly one value")
vcv_one_value()
    if !enm_ready() then return

    val said = enm_err("val v: <4>i32 = [1, 2, 3, 4]\nval w = <4>f32(v, v, v)\n")

    assert(said.contains("conversion takes exactly one value"), said)

// ---- the instruction ----

private vcv_one_cast(src: string, cast: string)
    val main = cgz_main(src)

    assert(main.contains(cast), main)
    assert(!main.contains("extractelement"), main)

@test("each conversion is one instruction over the register, with no lane extracted")
vcv_one_instruction()
    if xvr_no_library() then return

    vcv_one_cast("val v: <4>i32 = [1, 2, 3, 4]\nprint(<4>f64(v).sum())\n", "sitofp <4 x i32>")
    vcv_one_cast("val v: <4>u32 = [1, 2, 3, 4]\nprint(<4>f32(v).sum())\n", "uitofp <4 x i32>")
    vcv_one_cast("val v: <8>i8 = [1, 2, 3, 4, 5, 6, 7, 8]\nprint(<8>i32(v).sum())\n", "sext <8 x i8>")
    vcv_one_cast("val v: <8>u8 = [1, 2, 3, 4, 5, 6, 7, 8]\nprint(<8>i32(v).sum())\n", "zext <8 x i8>")
    vcv_one_cast("val v: <2>i64 = [1, 2]\nprint(<2>u16(v).sum())\n", "trunc <2 x i64>")
    vcv_one_cast("val v: <4>f32 = [1, 2, 3, 4]\nprint(<4>f64(v).sum())\n", "fpext <4 x float>")
    vcv_one_cast("val v: <4>f64 = [1, 2, 3, 4]\nprint(<4>f32(v).sum())\n", "fptrunc <4 x double>")
    vcv_one_cast("val v: <4>f32 = [1, 2, 3, 4]\nprint(<4>i32(v).sum())\n", "@llvm.fptosi.sat.v4i32.v4f32")
    vcv_one_cast("val v: <4>f64 = [1, 2, 3, 4]\nprint(<4>u16(v).sum())\n", "@llvm.fptoui.sat.v4i16.v4f64")

@test("a sign change at one width is no instruction at all")
vcv_a_sign_change_is_free()
    if xvr_no_library() then return

    val main = cgz_main("val v: <4>i32 = [1, 2, 3, 4]\nval w = <4>u32(v)\nprint(w.sum())\n")

    assert(!main.contains("trunc <4") && !main.contains("ext <4"), main)
    assert(!main.contains("extractelement"), main)
