module sysl.io.sys

// The calls the byte surface makes of whatever is under it, at the level of a file descriptor:
// `sysl.io`'s `FdReader` reads through `fd_read`, `sysl.io.wait.ready` waits through `fd_wait`, and
// `sysl.flush` pushes standard output out through `fd_flush`.
//
// **Each is an `extern` naming a symbol no module here defines**, so what answers it is decided by
// what the program is linked with (`reference/ffi.md § A module may supply another module's extern`),
// exactly as for `sysl.fs.sys`:
//
// | linked with | what defines the symbols |
// |---|---|
// | a program for a hosted target | `sysl.io.hosted`, over the platform's C library |
// | a program for a target with no C library | the program, with an `@export` per hook it reaches |
//
// A freestanding program that reaches one of these and leaves it unanswered is refused when it is
// compiled, naming the hooks it reached, rather than at the link.
//
// ## The shape of a hook
//
// **A hook answers one integer: what it did, or what went wrong -- the contract of every `*.sys`
// module (`sysl.fs.sys`, `sysl.process.sys`).** Zero or more is success -- the
// number of bytes `fd_read` or `fd_write` moved, one or zero for `fd_wait`, and zero for `fd_flush`
// -- and a negative answer is
// the code of the failure negated: the `IoError` code `sysl.fs` uses, which on a POSIX host is the
// `errno`. So a kernel's system call that already answers a negative error number is the hook as it
// stands. A target that cannot perform a call at all answers `UNSUPPORTED` (`sysl.sys`, -38 on every
// platform, not the host's `ENOSYS`); `-1` is `EPERM`.
//
// **A descriptor is an `int`**: 0 is standard input, 1 standard output and 2 standard error, as a
// program is started with them; anything else is whatever the supplier handed out.

/** Reads at most `room` bytes from `fd` into `into`, answering how many arrived -- zero being the end
 * of the input -- or the failure's code, negated.
 */
@blocks
private[sysl] extern "sysl_io_read" fd_read(fd: int, into: *u8, room: usize) -> isize

/** Writes at most `len` bytes from `from` to `fd`, answering how many were taken or the failure's
 * code, negated.
 */
@blocks
private[sysl] extern "sysl_io_write" fd_write(fd: int, from: *u8, len: usize) -> isize

/** Pushes out whatever is being held back on its way to `fd`, answering zero or the failure's code,
 * negated. A supplier keeping no buffer answers zero and does nothing.
 */
private[sysl] extern "sysl_io_flush" fd_flush(fd: int) -> int

/** Waits at most `micros` microseconds for `fd` to be readable -- or, where `writable` is one, writable
 * -- answering one when it is, zero when the time ran out first, or the failure's code, negated.
 *
 * **Readable means a read would not wait**, which includes the end of the input: a pipe whose every
 * writer has gone is readable, and the read answers nothing. A descriptor that is not open answers the
 * code of `EBADF`, 9. Zero microseconds asks once and does not wait; a signal arriving during the wait
 * does not cut it short, the supplier asking again for the time still owed.
 */
@blocks
@needs(os)
private[sysl] extern "sysl_io_wait" fd_wait(fd: int, writable: int, micros: long) -> int
