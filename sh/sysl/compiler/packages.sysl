module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.text.from_utf8_unchecked

// Which package a file came from, and what the module paths it writes mean.
//
// **Identity is two-layered, and this is the layer that is not identity.** A module's name is its
// directory path below the project root, which makes every module name local and relative -- so a
// fetched `json` and a project's own `json` are one name with nothing in either to tell them apart.
// Go does not have this problem because its import path *is* the module name and is globally
// unique; the rule here is the opposite one.
//
// The answer is to keep the written names local and to give each package a **canonical prefix**
// taken from its coordinate, so a module `json` in `github.com/e/sysl-json` is really
// `github.com.e.sysl-json.json`. That is the name every table is keyed by, and therefore the name
// mangled into every symbol -- which is the property that makes two consumers naming one package
// differently still link one copy of it. What a *file* writes stays short: the prefix is added on
// the way in, and the leading segment of a written path is read back through the table below.
//
// **The mount is never the identity.** If one project mounted a package as `json` and another as
// `ejson`, a mangler keyed off the local name would emit `json$Parser.next` in one build and
// `ejson$Parser.next` in the other -- the same source producing different symbols, which makes two
// consumers of one package unlinkable into one program.
//
// **The empty prefix is the project being built, and the standard module.** Their modules keep the
// names they were written with, so a program with no dependencies goes through all of this
// unchanged -- which is the point, and is why `no_packaging()` is what every other caller gets.

// The canonical prefix of a fetched package: its coordinate, with the separators a module name is
// allowed to hold.
//
// **The version does not figure in it.** A major above the first rides in the coordinate itself --
// `github.com/e/json/v2` is a different package from `github.com/e/json`, and they are allowed to
// be incompatible -- so it reaches the prefix by being part of what somebody wrote, and a minor
// release renames no symbol at all. That is what lets an artifact built against 1.2.0 be linked
// with one built against 1.4.0.
canonical_prefix(coordinate: string) -> string
    val bytes = coordinate.bytes
    var out: Buf[u8] = buf()

    for i in 0..<bytes.len
        out.push(if bytes[i] == u8('/') then u8('.') else bytes[i])

    from_utf8_unchecked(out.view())
end canonical_prefix

// The canonical prefix and a module's own name, joined -- and the module's own name alone where the
// package is the project being built.
package_qualify(prefix: string, module_name: string) -> string =
    if prefix == "" then module_name
    else if module_name == "" then prefix
    else s"$prefix.$module_name"

// What one file's package is called, and what the module paths it writes mean.
//
// Per-package, which is the whole point: a dependency's own source says `json` and means whatever
// *it* calls `json`, while a consumer of that dependency says `json` and may mean something else.
// Both arrive at one canonical name without ever having to agree on a spelling.
struct Packaging
    // The canonical prefix of the package this file came from, or the empty one for the project
    // being built and for the standard module.
    prefix: string

    // What each module path this package's manifest brought in is really called: the path a file
    // writes at the head of an import line, and the canonical name it stands for.
    mounts: Buf[(string, string)]
end Packaging

// A file of the project being built: no prefix, and nothing mounted.
no_packaging() -> Packaging = Packaging("", buf())

// What a written module path means where it names a package this one's manifest brought in.
//
// **The whole path is offered and not its leading segment**, because what a package binds is a
// module *path* -- `sh.sysl.table` for one namespaced by reverse DNS, whose `sh/` holds no source
// and is therefore no module of its own. A single-segment lookup could only ever have found `sh`,
// which every such package would claim and none of them declares.
//
// The match is by longest key, so a name reaches the most specific package that offers it and
// anything under that name comes with it: `sh.sysl.table.sub` is answered by `sh.sysl.table` and
// keeps its tail.
mounted(pkg: Packaging, written: string) -> Option[string]
    var best: Option[string] = None
    var longest: usize = 0

    for i in 0..<pkg.mounts.len()
        val key = pkg.mounts.at(i).0

        if starts_with_module(written, key) && key.bytes.len > longest
            longest = key.bytes.len
            best = Some(pkg.mounts.at(i).1 + written[key.bytes.len..<written.bytes.len])

    best
end mounted

// Whether a name is a module, or the first segment of one -- everything a dotted reference could
// read as the start of a module path.
names_module(a: &Analysis, name: string) -> bool
    for i in 0..<a.tables.modules.len()
        if starts_with_module(a.tables.modules.at(i), name) then return true

    false
end names_module

// Whether a **whole written path** leads anywhere: it is a module, begins one, or names something a
// module declares.
//
// This is the question the readings below are chosen by, and asking it of the path rather than of
// its leading segment is the difference between them working and not. A segment is shared by
// everything a convention namespaces together -- reverse DNS puts every package of an org under
// `sh` -- so `names_module(head)` answers yes for a path that names nothing at all, and answers it
// on the strength of some unrelated tree that happens to sit under the same word.
reaches_module(a: &Analysis, path: string) -> bool
    if names_module(a, path) then return true

    val cut = last_dot_in(path)

    cut.is_some() && cut.unwrap() > 0 && a.tables.has_module(path[0..<cut.unwrap()])
end reaches_module

// A written module path read through the package layer.
//
// **Three readings, in order, and the first that leads anywhere wins.** A path written inside a
// package means that package's own tree before it can mean anything else; failing that it is read
// as written; failing that it is offered to the packages the file's own manifest named. A path
// that leads nowhere under any of them is handed back as written, so the caller's diagnostic
// quotes what was there rather than a rewriting of it.
in_package(a: &Analysis, pkg: Packaging, written: string) -> string
    val own = own_package(a, pkg, written)

    if own.is_some() then return own.unwrap()
    if reaches_module(a, written) then return written

    mounted(pkg, written).unwrap_or(written)
end in_package

// What a written path's leading segment means in the **package the file itself belongs to**.
//
// A package's own modules sit under its canonical prefix, so a file of `github.com/e/json` writing
// `json.Parser` means that package's `json` and nothing else -- which is what makes a package's
// source read the same whoever depends on it. It cannot mean anything else either: unlike an
// import, which a file wrote and can rename, the prefix is added on the way in and the source has
// no spelling for it.
//
// **It answers only where the qualified path leads somewhere**, which is what keeps the claim from
// being about the segment. A package laid out at `sh/sysl/mine` owns the segment `sh` and its own
// *dependencies* are namespaced under it too -- so `sh.sysl.dep.open` qualifies to a path that
// package's tree has nothing at, and must fall through to the manifest that named the dependency
// rather than be swallowed by the ownership claim.
private own_package(a: &Analysis, pkg: Packaging, written: string) -> Option[string]
    if pkg.prefix == "" then return None

    val head = head_segment(written)
    val qualified = package_qualify(pkg.prefix, head)

    if !names_module(a, qualified) then return None

    val whole = qualified + written[head.bytes.len..<written.bytes.len]

    if reaches_module(a, whole) then Some(whole) else None
end own_package

// A path's leading segment, which is the whole path where it has no dot.
private head_segment(path: string) -> string
    val bytes = path.bytes

    for i in 0..<bytes.len
        if bytes[i] == u8('.') then return path[0..<i]

    path
end head_segment

// The module paths a package offers to whoever depends on it.
//
// **The shallowest directory of its tree that holds source, and not every module below it.** A
// package namespaced by reverse DNS puts its source at `sh/sysl/table/`, so `sh` and `sh/sysl` hold
// nothing and the one name it offers is `sh.sysl.table` -- one name, three segments. Reading the
// top-level directory instead would make every such package claim `sh`, which is not a name any of
// them declares and is the same name for all of them. A binding covers a name and everything under
// it, so an entry for a module below one already offered would say the same thing twice.
//
// **Every per-OS directory is taken, whatever machine is asking.** What a package *offers* is a
// property of the package rather than of the build consuming it, so a name that came and went with
// the target would make a dependency resolve on one machine and not on another.
//
// A file sitting directly at the package root belongs to the anonymous root module, which has no
// name to import and so is not offered.
package_modules(root: string) -> Buf[string]
    var out: Buf[string] = buf()

    val found = collect(root, None) match
        Err(_) -> return out
        Ok(f) -> f

    for i in 0..<found.len()
        if found.at(i).dir.is_empty() then continue

        val name = joined(found.at(i).dir, ".")
        var covered = false

        for j in 0..<out.len()
            if starts_with_module(name, out.at(j)) then covered = true

        if covered then continue

        // Anything already listed that sits below this one goes: the shallower name covers it.
        var kept: Buf[string] = buf()

        for j in 0..<out.len()
            if !starts_with_module(out.at(j), name) then kept.push(out.at(j))

        kept.push(name)
        out = kept

    out
end package_modules
