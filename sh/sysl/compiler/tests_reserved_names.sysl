    rsv_refused("@inline\nval(x: int) -> int = x\nprint(1)\n", "val", "a function's name", 2, 1)

@test("a declaration-leading word as a function inside a function's body")
rsv_fn_leading_word_in_a_body()
    if !rsv_ready() then return

    rsv_refused("main()\n    const(x: int) -> int = x\n    print(1)\n", "const", "a function's name",
                2, 5)

@test("the backticked function name the refusal advises is a function like any other")
rsv_fn_backticked_is_a_function()
    if !rsv_ready() then return

    assert_eq(rsv_ran("`type`() -> int = 7\n`struct`(x: int) -> int = x + 1\nprint(`type`() + `struct`(1))\n"),
              "9\n")

@test("every declaration the leading words open still reads as itself")
rsv_fn_declarations_still_read()
    if !rsv_ready() then return

    val text = "type Id = int\ntype Pair = (int, int)\nstruct Box[T]\n    v: T\nenum Shape\n    Dot\n" +
               "    Line(n: int)\ntrait Sized\n    size(self) -> int\nimpl[T] Sized for Box[T]\n" +
               "    size(self) -> int = 1\nconst k: int = 2\nextern \"abs\" c_abs(n: i32) -> i32\n" +
               "val (a, b) = (3, 4)\nvar (c, d) = (5, 6)\nc += 1\nval p: Pair = (a, b)\nval (e, f) = p\n" +
               "val id: Id = int(c_abs(-8))\nref r = c\nr += 1\n" +
               "print(Box(1).size() + k + e + f + c + d + id)\n"

    assert_eq(rsv_ran(text), "31\n")

// ---- ReservedWordNameTests: a member

@test("a method named with a reserved word in a struct's body")
rsv_member_in_a_struct()
    if !rsv_ready() then return

    rsv_refused("struct Handle\n    n: int\n    ref(self) -> int = self.n\n\nprint(1)\n", "ref",
                "a member's name", 3, 5)

@test("a property named with a reserved word")
rsv_member_as_a_property()
    if !rsv_ready() then return

    rsv_refused("struct S\n    n: int\n    loop -> int = self.n\n\nprint(1)\n", "loop",
                "a member's name", 3, 5)

