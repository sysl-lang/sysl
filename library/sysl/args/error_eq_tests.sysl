module sysl.args
@tests

@test("eqe: ArgError is equal variant by variant and payload by payload")
eqe_arg_error()
    assert(ArgError.MissingValue("-o") == ArgError.MissingValue("-o"))
    assert(ArgError.MissingValue("-o") != ArgError.MissingValue("-p"))
    assert(ArgError.MissingValue("-o") != ArgError.UnexpectedValue("-o"))
    assert(ArgError.UnknownOption("-x") == ArgError.UnknownOption("-x"))
    assert(ArgError.UnknownOption("-x") != ArgError.UnknownOption("-y"))
    assert(ArgError.BadValue("-n", "x", "a number") == ArgError.BadValue("-n", "x", "a number"))
    assert(ArgError.BadValue("-n", "x", "a number") != ArgError.BadValue("-m", "x", "a number"))
    assert(ArgError.BadValue("-n", "x", "a number") != ArgError.BadValue("-n", "y", "a number"))
    assert(ArgError.BadValue("-n", "x", "a number") != ArgError.BadValue("-n", "x", "a size"))

@test("eqe: Result and Option[Result] over ArgError compare with ==")
eqe_arg_result()
    val r: Result[int, ArgError] = Err(ArgError.UnknownOption("-x"))
    assert(r == Err(ArgError.UnknownOption("-x")))
    assert(r != Err(ArgError.UnknownOption("-y")))
    assert(r != Ok(0))
    val o: Option[Result[int, ArgError]] = Some(r)
    assert(o == Some(Err(ArgError.UnknownOption("-x"))))
    assert(o != Some(Err(ArgError.MissingValue("-x"))))
