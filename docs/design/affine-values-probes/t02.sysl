// Today: a guard with no Drop and a @consumes release. A ref answered through the guard's raw
// pointer stays writable after release, and `val g2 = g` copies the guard (finding 2).
struct Guard
    data: *int
    held: bool

    value(*self) -> ref int = *self.data

    @consumes
    release(*self)
        self.held = false
        print("unlock")

main()
    var x = 1
    var g = Guard(&x, true)
    ref d = g.value()
    val g2 = g

    g.release()
    d = 5
    print(x, g2.held)
