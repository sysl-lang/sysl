module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.math.bigint.to_string

// **The growable buffer a rendering can end in**: the sink whose bytes `str` and an `f"..."` hole turn
// into a fresh `string`.
//
// It is a `*Writer` trait object, and it is the compiler's rather than the library's -- not because it
// does anything a sysl body could not, but because it has no *type* sysl can give it: a growable byte
// buffer needs a growable byte buffer to write. What a program writes for itself is an ordinary
// `impl Writer for MyThing`, which is the case the trait exists for and is now also the case the
// library's own sink is.
//
// The table is laid out by hand in the order `Writer` **offers** its methods -- which is not the order
// it declares them, because a trait offers what it requires first: `Writer: Fallible` puts `failed` in
// slot 0 and `write` in slot 1.

// The order `Writer` offers its members in. It is written down once because two things depend on it
// and neither can see the other: the table below is laid out by hand in this order, and every call
// through a `*Writer` indexes by whatever the analyzer computed.
writer_members() -> Buf[string]
    var out: Buf[string] = buf()

    out.push("failed")
    out.push("write")
    out
end writer_members

// How many bytes a rendering holds in its own frame before its buffer moves to the heap.
buffer_scratch() -> int = 64

// The buffer's header -- the bytes, how many are used, and how many fit. It is written literally
// rather than declared as a named type because nothing outside this file ever names it.
//
// The two counts are the machine's word: a length that outgrew an address would name storage the
// machine cannot address, and the string this buffer finishes into carries its length as a `usize`
// anyway. A zeroed header is a fresh buffer.
buffer_header_lty(e: *Emit) -> LType
    var fields: Buf[LType] = buf()

    fields.push(LPtr)
    fields.push(word_lty(e))
    fields.push(word_lty(e))
    LStruct(fields)
end buffer_header_lty

// The whole slot: the header, then the frame's own scratch the bytes land in until they outgrow it.
// The header leads, so zeroing the header alone at the slot's address makes the slot a fresh buffer.
buffer_lty(e: *Emit) -> LType
    var fields: Buf[LType] = buf()

    fields.push(LPtr)
    fields.push(word_lty(e))
    fields.push(word_lty(e))
    fields.push(LArr(buffer_scratch(), LInt(8)))
    LStruct(fields)
end buffer_lty

// Writing into a growable buffer, and finishing with one.
//
// **The bytes land in the frame first.** The slot carries `buffer_scratch()` bytes of its own after
// the header, and the first write into a fresh (zeroed) buffer points the header at them, so a
// rendering that never outgrows them takes nothing from the heap for its working storage. Past them
// the bytes move to the heap, and from there capacity doubles, so rendering a value costs a bounded
// number of allocations rather than one per chunk written. `finish` copies what landed into an
// ordinary string and gives heap working storage back -- never the scratch -- so the string that
// comes out owns its own bytes, nothing points into the frame once the rendering is over, and the
// slot is inert again.
//
// Neither of these can fail in a way a caller could act on: an allocator returning null is the
// program's end rather than this writer's business -- it traps (`trap`, the module's stop) before the
// null is stored -- so `failed` is the constant a latch with nothing to latch reports.
//
// **Every method table carries its type's identity in front of the slots**, and this one is a table
// like any other as far as a call site is concerned -- a `*Writer` handed to a `display`
// implementation may be this buffer, and asking its identity has to answer something. There is no
// `Type` here to ask, so the name is hashed directly; it begins with the module separator, which
// nothing a program can declare does.
//
// The working storage is bytes and nothing else, so it is taken on a boundary of one, and given back
// with the capacity it was taken at. A null answer from the heap traps (`trap_symbol`) before the
// old bytes are moved.
writer_buffer(e: *Emit, str: string, slot: string, id: string) -> string
    val word = s"i${e.word_bits}"
    val take = heap_take_text(e, "%new", "%newcap", 1)
    val give_old = heap_give_text(e, "%old", "%cap", 1)
    val give_buf = heap_give_text(e, "%buf", "%cap", 1)
    val trap = trap_symbol(e)
    val room = buffer_scratch()

    e.traps = true

    s"""
    define private void @sysl.w.buf.write(ptr %self, $str %b) {
    entry:
      %src = extractvalue $str %b, 1
      %n = extractvalue $str %b, 2
      %bufp = getelementptr $slot, ptr %self, i32 0, i32 0
      %lenp = getelementptr $slot, ptr %self, i32 0, i32 1
      %capp = getelementptr $slot, ptr %self, i32 0, i32 2
      %scratch = getelementptr $slot, ptr %self, i32 0, i32 3
      %len = load $word, ptr %lenp
      %held = load $word, ptr %capp
      %fresh = icmp eq $word %held, 0
      br i1 %fresh, label %adopt, label %check
    adopt:
      store ptr %scratch, ptr %bufp
      store $word $room, ptr %capp
      br label %check
    check:
      %cap = phi $word [ %held, %entry ], [ $room, %adopt ]
      %need = add $word %len, %n
      %fits = icmp ule $word %need, %cap
      br i1 %fits, label %copy, label %grow
    grow:
      %twice = mul $word %cap, 2
      %bigger = icmp ugt $word %need, %twice
      %newcap = select i1 %bigger, $word %need, $word %twice
    $take  %given = icmp ne ptr %new, null
      br i1 %given, label %grown, label %refused
    refused:
      call void @$trap()
      unreachable
    grown:
      %old = load ptr, ptr %bufp
      br label %move
    move:
      %i = phi $word [ 0, %grown ], [ %inext, %step ]
      %more = icmp ult $word %i, %len
      br i1 %more, label %step, label %swap
    step:
      %sp = getelementptr i8, ptr %old, $word %i
      %sb = load i8, ptr %sp
      %dp = getelementptr i8, ptr %new, $word %i
      store i8 %sb, ptr %dp
      %inext = add $word %i, 1
      br label %move
    swap:
      %inframe = icmp eq ptr %old, %scratch
      br i1 %inframe, label %install, label %drop
    drop:
    $give_old  br label %install
    install:
      store ptr %new, ptr %bufp
      store $word %newcap, ptr %capp
      br label %copy
    copy:
      %buf = load ptr, ptr %bufp
      br label %append
    append:
      %j = phi $word [ 0, %copy ], [ %jnext, %put ]
      %left = icmp ult $word %j, %n
      br i1 %left, label %put, label %done
    put:
      %ap = getelementptr i8, ptr %src, $word %j
      %ab = load i8, ptr %ap
      %at = add $word %len, %j
      %tp = getelementptr i8, ptr %buf, $word %at
      store i8 %ab, ptr %tp
      %jnext = add $word %j, 1
      br label %append
    done:
      store $word %need, ptr %lenp
      ret void
    }

    define private i1 @sysl.w.buf.failed(ptr %self) {
    entry:
      ret i1 false
    }

    define private $str @sysl.w.buf.finish(ptr %self) {
    entry:
      %bufp = getelementptr $slot, ptr %self, i32 0, i32 0
      %lenp = getelementptr $slot, ptr %self, i32 0, i32 1
      %capp = getelementptr $slot, ptr %self, i32 0, i32 2
      %buf = load ptr, ptr %bufp
      %len = load $word, ptr %lenp
      %cap = load $word, ptr %capp
      %s = call $str @sysl.str.from_bytes(ptr %buf, $word %len)
      %onheap = icmp ugt $word %cap, $room
      br i1 %onheap, label %drop, label %done
    drop:
    $give_buf  br label %done
    done:
      ret $str %s
    }

    @sysl.vt.buf = private constant { $word, [2 x ptr] } { $word $id, [2 x ptr] [ptr @sysl.w.buf.failed, ptr @sysl.w.buf.write] }
    """
end writer_buffer

// The table a fresh buffer's data word is reached through, asked for once per module.
buffer_table(e: *Emit) -> string
    val slot = l_render(buffer_lty(e))
    val id = to_string(type_identity(s"${ModuleSep}buf", e.word_bits))

    request_text(e, "sysl.vt.buf", writer_buffer(e, l_render(lty(e, Str)), slot, id))
end buffer_table
