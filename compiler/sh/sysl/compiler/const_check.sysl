module sh.sysl.compiler

import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}
import sysl.container.{Map, map}
import sysl.text.{Search, from_utf8_unchecked}

// What a `const` function may contain.
//
// **A `const` function is one the compiler may run while it compiles**, so its body is held to what
// exists at that moment: values, and code the compiler can see. What is refused is everything that
// only exists once the program runs -- an address, the heap, module storage that is filled at
// startup, code outside the program, and a call whose target is chosen at run time -- plus the C
// variadic arguments and atomics the compiler does not evaluate yet. A call to a
// function that is not marked is held to the same by walking that function's body, so the refusal
// names the chain of calls down to what cannot run. A string is
// a value the compiler holds -- built, joined, sliced, rendered from an integer or a fixed-point value
// -- and a slice is a view of an array or a string the evaluation holds. Each refusal is anchored where the thing was written and says which of these it is.
//
// **A call through a type parameter's bound is not asked about here.** Which body answers it is
// settled by the instantiation, so a generic body is checked at its definition for everything else
// and the call is left to the type that fills the parameter.
//
// Calling a `const` function at run time is an ordinary call, and nothing here changes how one is
// emitted.

// The opening every refusal shares: which function, and why the rule applies to it.
private const_opening(f: string) -> string =
    s"'${qualified_name(f)}' is 'const', so it runs while compiling, and"

// Why each kind of refusal holds, said once.
private const_address() -> string = "an address exists only when the program runs"
private const_outside() -> string = "nothing outside the program exists while compiling"

// Holds every `const` function to what the compiler can run: its signature where it is typed
// (`check_const_signature`), and here its body and its clauses. An instantiation of a generic one is
// passed over, the generic having been read at its definition.
check_const_fns(a: &Analysis, funcs: Buf[TFunc], vals: Buf[TVal])
    var marked = false

    for i in 0..<funcs.len()
        if funcs.at(i).const_fn then marked = true

    for abstract in a.tables.abstracts
        if abstract.const_fn then marked = true

    if !marked then return

    // A `@ghost` function is a specification, not code: a clause naming one is skipped when the
    // clause is evaluated, so the call is no reason to refuse.
    var ghosts: Buf[string] = buf()

    for i in 0..<funcs.len()
        if funcs.at(i).ghost then ghosts.push(funcs.at(i).name)

    var bodies: Map[string, usize] = map()

    for i in 0..<funcs.len()
        bodies.put(funcs.at(i).name, i)

    val cx: &ConstSeen = ConstSeen(ghosts, vals, outside_storage(a), Skipped(buf()), funcs, bodies, map(),
                                   false, buf())

    for i in 0..<funcs.len()
        val f = funcs.at(i)

        if f.const_fn && !a.tables.members.func_origin.has(f.name) then const_body(a, cx, f)

    for f in a.tables.abstracts
        if f.const_fn then const_body(a, cx, f)
end check_const_fns

// What the walk over every `const` body consults, built once.
private struct ConstSeen
    ghosts: Buf[string]
    vals: Buf[TVal]
    outside: Buf[string]
    // One caret per stretch of source: a refusal covers what is inside it, so a string built inside
    // a call that is refused already is not a second mistake.
    said: &Skipped
    // The typed bodies of the program, by name, where the walk runs over the finished program. A
    // function not among them is typed for the question, as the evaluator types a callee.
    funcs: Buf[TFunc]
    bodies: Map[string, usize]
    // What each unmarked function's body was found to hold: the reason it cannot run while
    // compiling, or empty where it can.
    unmarked: Map[string, string]
    // Where the walk is asking about an unmarked body rather than refusing a marked one: the first
    // reason found is kept in `found` instead of being reported.
    collecting: bool
    found: Buf[string]
end ConstSeen

// The variables the `extern` declarations name: storage outside the program.
private outside_storage(a: &Analysis) -> Buf[string]
    var out: Buf[string] = buf()

    for i in 0..<a.tables.extern_vars.len()
        out.push(extern_var_symbol(a.tables.extern_vars.at(i)))

    out
end outside_storage

// Why a function nobody marked `const` cannot run while compiling, or `None` where its body can: the
// question a call from a `const` body, or from a constant, asks of its callee. A function marked
// `const` was held to it at its declaration. A body that calls back into one being asked about is
// answered by the walk already under way.
private unmarked_refusal(a: &Analysis, cx: &ConstSeen, name: string) -> Option[string]
    val known = cx.unmarked.get(name)

    if known.is_some() then return if known.unwrap() == "" then None else known

    cx.unmarked.put(name, "")

    val at = cx.bodies.get(name)
    val body = if at.is_some() then Some(cx.funcs.at(at.unwrap())) else evaluation_body(a, name).map(f -> *f)

    // An `extern` reached where nothing named it -- through a function's address -- is refused for
    // what it is rather than for the body it lacks.
    val outside = a.tables.externs.get(name).and_then(x -> extern_reason(extern_symbol(x)))

    if body.is_none() || outside.is_some()
        val why = outside.map(t -> s"it $t").unwrap_or("it has no body that can be read while compiling")

        cx.unmarked.put(name, why)
        return Some(why)
    end if

    val inner: &ConstSeen = ConstSeen(cx.ghosts, cx.vals, cx.outside, Skipped(buf()), cx.funcs, cx.bodies,
                                      cx.unmarked, true, buf())

    const_body(a, inner, body.unwrap())

    val why = if inner.found.is_empty() then "" else inner.found.at(0)

    cx.unmarked.put(name, why)

    if why == "" then None else Some(why)
end unmarked_refusal

// The same question asked by the evaluator, about a callee it is about to run. What the walk finds is
// kept for the rest of the compilation.
evaluable_refusal(a: &Analysis, name: string) -> Option[string]
    if a.tables.const_fns.has(name) then return None

    val cx: &ConstSeen = ConstSeen(buf(), buf(), outside_storage(a), Skipped(buf()), buf(), map(),
                                   a.evaluation.unmarked, true, buf())

    unmarked_refusal(a, cx, name)
end evaluable_refusal

// A reason as the clause after a callee's name: "it prints, …" becomes "which prints, …", so a chain
// of calls reads as one sentence.
chained_reason(why: string) -> string = if why.starts_with("it ") then s"which ${why[3..]}" else why

// One body, its contract and every loop clause in it -- each of which is evaluated where the body is.
private const_body(a: &Analysis, cx: &ConstSeen, f: TFunc)
    val scope = func_home(a, f.name)
    val walk: &TWalk = TWalk(true, e -> const_expr(a, cx, scope, f.name, e),
                     w -> const_write(a, cx, scope, f.name, w),
                     s -> const_stmt(a, cx, scope, f.name, s))

    for item in f.requires
        walk_texpr(item.cond, walk)

    walk_block_stmts(f.body, walk)

    for item in f.ensures
        walk_texpr(item.cond, walk)

    if f.variant.is_some() then walk_texpr(f.variant.unwrap(), walk)
end const_body

private const_refuse(a: &Analysis, cx: &ConstSeen, scope: Scope, f: string, at: Span,
                     what: string)
    if cx.said.covers(at) then return

    cx.said.cover(at)

    if cx.collecting
        if cx.found.is_empty() then cx.found.push(what)

        return
    end if

    a.fault(scope, at, s"${const_opening(f)} $what")
end const_refuse

private const_stmt(a: &Analysis, cx: &ConstSeen, scope: Scope, f: string, s: TStmt)
    s match
        TAsm(_, _, _, at) ->
            const_refuse(a, cx, scope, f, at, s"it holds an 'asm' block, which is outside the " +
                         s"program — ${const_outside()}")
        // A local is judged by the expression that makes its value, which says more about where the
        // value came from -- except where that expression is another local, or nothing at all.
        TVarDecl(_, ty, init, _) ->
            val bare = *init.kind match
                TLoad(_, _) -> true
                TZero(_) -> true
                _ -> false

            if bare
                const_type_refusal(ty) match
                    Some(why) -> const_refuse(a, cx, scope, f, init.span,
                                              s"it declares a local of type '${type_show(ty)}' — $why")
                    None -> ()
        _ -> ()
end const_stmt

// A compound assignment through an operator a type supplied is a call like any other.
private const_write(a: &Analysis, cx: &ConstSeen, scope: Scope, f: string, w: TWrite)
    if w.dispatch.is_none() then return

    val why = const_call_refusal(a, cx, w.dispatch.unwrap().name)

    if why.is_some() then const_refuse(a, cx, scope, f, w.place.span, why.unwrap())
end const_write

private const_expr(a: &Analysis, cx: &ConstSeen, scope: Scope, f: string, e: TExpr)
    if cx.said.covers(e.span) then return

    // `&bus` reads nothing from `bus`: the address of module storage is a constant the linker fills
    // in, so the storage it names is not reached, whenever it is filled.
    *e.kind match
        TAddrOf(place, _) ->
            val root = addressed_storage(place)

            if root.is_some() then cx.said.cover(root.unwrap().span)
        _ -> ()

    val form = const_form_refusal(a, cx, e)

    if form.is_some()
        const_refuse(a, cx, scope, f, e.span, form.unwrap())
        return
    end if

    // A local's value was judged where the local was declared, and a parameter's at the signature.
    val named = *e.kind match
        TLoad(_, _) -> true
        _ -> false

    if named then return

    val ty = texpr_type(e)

    const_type_refusal(ty) match
        Some(why) -> const_refuse(a, cx, scope, f, e.span, s"it uses a '${type_show(ty)}' — $why")
        None -> ()
end const_expr

// What a node does that the compiler cannot do while compiling, said the way a reader would say it.
private const_form_refusal(a: &Analysis, cx: &ConstSeen, e: TExpr) -> Option[string] = *e.kind match
    // A call that never returns ends the program -- a panic -- and is a trap where it is reached.
    TCall(_, _, Never, _) -> None
    TCall(name, _, _, _) -> const_call_refusal(a, cx, name)
    // A call through a function's address is the call of the function the address was taken of,
    // which the evaluation knows by then; it refuses one whose function cannot run.
    TCallPtr(_, _, _, _) -> None
    // A call through a trait object -- a closure's among them -- is the call of the function its
    // table names, which the evaluation knows by then; it refuses one whose function cannot run.
    TVCall(_, _, _, _, _) -> None
    TErase(_, _, _) -> None

    // A value a type renders through its own method runs that method, which is held to what any
    // other call is; through a trait object, which method that is is not known yet.
    TRender(_, method, _, slot) -> if slot.is_some() then None else const_call_refusal(a, cx, method)

    // A reference or pointer converted to another pointer type is the same address, which the
    // evaluation refuses to read through as another type; converted to a number, it is where storage
    // falls in memory.
    TCast(operand, ty) ->
        if !names_an_address(ty) && !names_an_address(texpr_type(operand)) then None
        else if both_point(texpr_type(operand), ty) then None
        else Some(s"it converts a pointer — ${const_address()}")
    TCStrLit(_) -> Some(s"it takes the address of a C string — ${const_address()}")

    TGlobal(symbol, _, writable) -> const_global_refusal(cx, symbol, writable)

    TSysOp(op, _, _) -> Some(s"it runs '$op' — the processor it asks exists only when the program runs")
    TVaStart(_) -> Some(variadic_walk())
    TVaEnd(_) -> Some(variadic_walk())
    TVaArg(_, _) -> Some(variadic_walk())
    TVaCopy(_, _) -> Some(variadic_walk())
    TVaPass(_) -> Some(variadic_walk())
    TReduce(op, _, _) ->
        if op == "fadd" then Some("it sums a float vector, whose lanes are added in the order the target's " +
                                  "instructions take — so the value is known only where the program runs")
        else None

    // `?` widening the error through a conversion calls that conversion.
    TTry(_, _, _, _, _, _, convert) ->
        if convert.is_some() then const_call_refusal(a, cx, convert.unwrap()) else None

    // A comparison a type supplied is a call to its implementation.
    TCompare(_, cmps) ->
        var out: Option[string] = None

        for item in cmps
            val d = item.dispatch

            if out.is_none() && d.is_some() then out = const_call_refusal(a, cx, d.unwrap().name)

        out
    TUpdate(_, _, _, _, dispatch, _) ->
        if dispatch.is_some() then const_call_refusal(a, cx, dispatch.unwrap().name) else None
    _ -> None

private not_yet(what: string) -> string = s"$what not evaluated while compiling yet"

private variadic_walk() -> string =
    s"it walks C variadic arguments — ${not_yet("C variadic arguments are")}"

// What is wrong with calling this from a `const` function, or nothing.
private const_call_refusal(a: &Analysis, cx: &ConstSeen, name: string) -> Option[string]
    if a.tables.const_fns.has(name) || holds_string(cx.ghosts, name) then return None
    // Through a type parameter's bound: settled by whichever type fills the parameter.
    if names_a_bound_member(a, name) then return None


    val x = a.tables.externs.get(name)

    if x.is_some() then return extern_refusal(name, extern_symbol(x.unwrap()))

    // An instantiation is named as the declaration it was made from, which is what a reader wrote.
    val origin = a.tables.members.func_origin.get(name).unwrap_or(name)
    val shown = qualified_name(origin)

    // `print` reaches the library's printers, and what they do is write to the terminal.
    val printer = shown.starts_with("sysl.print") || shown.starts_with("sysl.eprint")

    if printer || shown == "sysl.stdout" || shown == "sysl.stderr" then
        return Some(s"it prints, which is outside the program — ${const_outside()}")

    // An `f"…"` specifier's renderers are run by the compiler itself (`const_eval.sysl`).
    if const_renderer(shown) || writer_routine(shown) || float_bits_routine(name) || frozen_routine(shown) then
        return None

    // Any other function runs while compiling where its own body can.
    unmarked_refusal(a, cx, name).map(why -> s"it calls '$shown', ${chained_reason(why)}")
end const_call_refusal

// Whether a call names a trait's member through a bound -- `Ord.cmp` in a body generic over `T: Ord`.
private names_a_bound_member(a: &Analysis, name: string) -> bool
    val dot = last_dot_in(name)

    if dot.is_none() then return false

    trait_decl_at(a, from_utf8_unchecked(name.bytes[0..<dot.unwrap()])).is_some()
end names_a_bound_member

// An `extern` a `const` function calls: one of the LLVM operations whose result is exactly
// specified, which the compiler can compute bit for bit; one of the C library's mathematical
// functions, whose last bit is the library's own; or anything else outside the program.
private extern_refusal(name: string, symbol: string) -> Option[string] =
    extern_reason(symbol).map(why -> s"it calls '${qualified_name(name)}', which $why")

// What an `extern` is that keeps it from running while compiling, said after "which", or nothing
// where it is an operation the compiler computes itself.
private extern_reason(symbol: string) -> Option[string]
    val parts = dotted(symbol)

    if parts.len() >= 2 && parts.at(0) == "llvm"
        if exact_intrinsic(parts) then return None
    end if

    val base = if parts.len() >= 2 && parts.at(0) == "llvm" then parts.at(1) else symbol

    if c_math(base)
        return Some(s"is the C library's '$base' — its last bit differs between C libraries, and the " +
                    "board's would not agree with this compiler's")
    end if

    Some(s"is outside the program — ${const_outside()}")
end extern_reason

// The LLVM operations a `const` function may reach: each has one exactly specified result.
private exact_intrinsic(parts: Buf[string]) -> bool
    val op = parts.at(1)

    for word in ["sqrt", "floor", "ceil", "trunc", "round", "roundeven", "fabs", "copysign", "fma",
                 "ctpop", "ctlz", "cttz", "bswap", "bitreverse", "fshl", "fshr"]
        if op == word then return true

    if parts.len() < 3 || parts.at(2) != "sat" then return false

    for word in ["sadd", "uadd", "ssub", "usub", "sshl", "ushl", "fptosi", "fptoui"]
        if op == word then return true

    false
end exact_intrinsic

// The C library's transcendental functions, under either width's name.
private c_math(name: string) -> bool
    for word in ["sin", "cos", "tan", "asin", "acos", "atan", "atan2", "sinh", "cosh", "tanh",
                 "asinh", "acosh", "atanh", "exp", "exp2", "expm1", "log", "log2", "log10",
                 "log1p", "pow", "cbrt", "hypot", "erf", "erfc", "tgamma", "lgamma"]
        if name == word || name == s"${word}f" || name == s"${word}l" then return true

    false
end c_math

// A symbol's dot-separated parts.
private dotted(symbol: string) -> Buf[string]
    var out: Buf[string] = buf()
    val b = symbol.bytes
    var from: usize = 0

    for i in 0..<b.len
        if b[i] == u8('.')
            out.push(from_utf8_unchecked(b[from..<i]))
            from = i + 1
        end if

    out.push(from_utf8_unchecked(b[from..<b.len]))
    out
end dotted

// The module storage a place is in, through its fields and elements, where it is in one.
private addressed_storage(place: TExpr) -> Option[TExpr] = *place.kind match
    TGlobal(_, _, _) -> Some(place)
    TField(receiver, _, _) -> addressed_storage(receiver)
    TIndex(receiver, _, _) -> addressed_storage(receiver)
    _ -> None

// Module storage a `const` function reaches: a `val` laid into the object file is a value like any
// other, and storage filled while the program runs -- a `var`, or a `val` computed at startup -- is
// not there yet. A variable an `extern` names is outside the program altogether.
private const_global_refusal(cx: &ConstSeen, symbol: string, writable: bool) -> Option[string]
    val shown = qualified_name(symbol)

    if holds_string(cx.outside, symbol) then
        return Some(s"it reaches '$shown', which is outside the program — ${const_outside()}")

    for i in 0..<cx.vals.len()
        val v = cx.vals.at(i)

        if v.symbol == symbol
            if writable || v.writable || v.computed then
                return Some(s"it reaches '$shown' — '$shown' is filled when the program runs")

            return None
        end if

    None
end const_global_refusal

// A `*Writer`: what a `display` is handed to write into.
writes_a_rendering(t: Type) -> bool = t match
    Ptr(inner) -> writes_a_rendering(*inner)
    Trait(name, _, _) -> qualified_name(name) == "sysl.Writer"
    _ -> false

// Whether a type is a raw pointer or a C function pointer -- an address, under either spelling.
private names_an_address(t: Type) -> bool = t match
    Ptr(_) -> true
    Ref(_, _) -> true
    CFn(_, _) -> true
    _ -> false

// Whether both address types point at a type, which a function pointer does not.
private both_point(a: Type, b: Type) -> bool = pointee(a).is_some() && pointee(b).is_some()

// Why a value of this type cannot be held while compiling, or nothing where it can. The values a
// `const` function works with are numbers, `bool`, `char` and `unit`, and structs, tuples, arrays and
// enums made of them, all by value; a raw pointer and a function pointer are admitted too, held as
// the addresses the linker fills in and never read or called through. A type parameter stands for
// whatever fills it, and is judged there.
const_type_refusal(t: Type) -> Option[string] = t match
    // An `f128` is held as its encoding and computed exactly (`quad_arith.sysl`), and the two
    // sixteen-bit formats as the `real`s their values are, rounded to the format at every operation.
    Floating(_, _) -> None
    Slice(elem, _) -> const_type_refusal(*elem)
    Vector(_, elem) -> const_type_refusal(*elem)
    VaList -> Some(not_yet("C variadic arguments are"))
    // A reference is to a box the evaluation makes and holds; a weak one answers whether its object
    // is still alive, which counts kept only when the program runs decide.
    Ref(_, _) -> None
    Weak(_) -> Some("a weak reference answers whether its object is still alive, which is decided by " +
                    "counts kept only when the program runs")
    Trait(_, _, _) -> Some(trait_object())
    Volatile(inner) -> const_type_refusal(*inner)
    Array(_, elem) -> const_type_refusal(*elem)
    Constrained(decl) -> const_type_refusal(decl.base)
    Struct(decl) ->
        if decl.opaque then None
        else fields_refusal(decl.fields)
    Results(parts) -> fields_refusal(parts.fields)
    Pack(elems) -> types_refusal(elems)
    Enum(decl) ->
        var out: Option[string] = None

        for item in decl.variants
            if out.is_none() then out = fields_refusal(item.fields)

        out
    _ -> None

private trait_object() -> string =
    "which function a call through a trait object reaches is decided when the program runs"

private fields_refusal(fields: Buf[(string, Type)]) -> Option[string]
    for field in fields
        val why = const_type_refusal(field.1)

        if why.is_some() then return why

    None
end fields_refusal

private types_refusal(ts: Buf[Type]) -> Option[string]
    for item in ts
        val why = const_type_refusal(item)

        if why.is_some() then return why

    None
end types_refusal

// A `const` function's signature, held to the same values its body is: each parameter's type at the
// parameter, the result at the result. **An address may come in and go out**: the only one an
// evaluation holds is the address of module storage or of a function, which the linker fills in
// (`const_eval.sysl`'s `address_of`), so one answered names nothing the evaluation made.
check_const_signature(a: &Analysis, scope: Scope, name: string, d: FuncDecl,
                      params: Buf[(string, Type)], ret: Type)
    val opening = const_opening(name)

    if d.variadic then
        a.fault(scope, decl_anchor(d), s"$opening it takes C variadic arguments — " +
                not_yet("C variadic arguments are"))

    for i in 0..<params.len()
        if i < d.params.len()
            val ty = params.at(i).1

            const_type_refusal(ty) match
                Some(why) ->
                    a.fault(scope, d.params.at(i).typ.span,
                            s"$opening its parameter '${d.params.at(i).name}' is a " +
                            s"'${type_show(ty)}' — $why")
                None -> ()
        end if

    if d.ret_type.is_none() then return

    val at = d.ret_type.unwrap().span

    const_type_refusal(ret) match
        Some(why) ->
            a.fault(scope, at, s"$opening its result is a '${type_show(ret)}' — $why")
            return
        None -> ()

end check_const_signature
