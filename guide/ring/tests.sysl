// What this program refuses, asserted in the program rather than beside it.
//
// The rest of the ring can only assert what it *permits*: a violated `require` traps and takes the
// process with it, so a check that broke one would end the run instead of reporting a failure.
// That is why the refusals used to live in a Scala suite — a trap is an observation only somewhere
// that outlives the process it ends.
//
// `#test(should_trap)` is that somewhere, and it is here. Each test below runs in a process of its
// own and passes by **not** coming back, so the contract that ends it is the thing being measured.
// The claims are the ring's own: what a bound refuses, what a contract refuses, and what an
// invariant refuses in the middle of an update.

// An empty ring and a full one, built by the only route there is -- the operations themselves, so a
// fixture cannot construct a state the type system would not have allowed.
empty_ring() -> Ring = Ring([0; capacity], Slot(0u8), Count(0u8))

filled_ring() -> Ring
    var r = empty_ring()

    while !r.is_full() do r.push(1)

    r
end filled_ring

// -- what the bounds refuse ------------------------------------------------------------------

#test(should_trap)
a_slot_past_the_last_is_not_a_slot() =
    print(int(Slot(8u8)))

#test(should_trap)
a_count_past_capacity_is_not_a_count() =
    print(int(Count(9u8)))

// The asymmetry the two declarations were written for: a full ring has `capacity` elements, so
// `Count` reaches it, and there is no slot with that number, so `Slot` does not. One value, legal
// as one type and not as the other, is the whole of what `new` buys here.
#test
capacity_itself_is_a_count_and_not_a_slot() =
    assert(int(Count(8u8)) == 8, "a full ring's count")
    assert(!Slot::Valid(8u8), "and no such slot")

// -- what the contracts refuse ---------------------------------------------------------------

#test(should_trap)
popping_an_empty_ring_traps() =
    var r = empty_ring()

    print(r.pop())

#test(should_trap)
pushing_a_full_ring_traps() =
    var r = filled_ring()

    r.push(99)

#test(should_trap)
reading_past_the_end_traps() =
    var r = empty_ring()

    r.push(1)
    print(r.at(1))

#test(should_trap)
reading_before_the_beginning_traps() =
    var r = empty_ring()

    r.push(1)
    print(r.at(-1))

// The total operations are the ones the program's own checks use, and they answer where these trap.
// Pinned beside the traps because the pair is the point: a ring offers both, and which one a caller
// wants is which one it can afford to be wrong about.
#test
the_total_forms_answer_where_the_checked_ones_trap() =
    var r = empty_ring()

    assert(!r.try_pop().is_some(), "an empty ring has nothing to give")

    var full = filled_ring()

    assert(!full.try_push(99), "a full ring takes nothing")

// -- what an invariant refuses, mid-update ---------------------------------------------------

// `Tracked` carries one fact twice -- `tail == (head + count) % capacity` -- so a push that writes
// the end and then the length is seen between the two, on a state that was on its way to a good
// one. This is the trap that found the redundant field, and it is the claim the whole comparison
// between `Ring` and `Tracked` rests on.
#test(should_trap)
a_write_that_leaves_a_tracked_ring_inconsistent_traps() =
    var t = Tracked([0; capacity], Slot(0u8), Slot(0u8), Count(0u8))

    t.tail = wrap(t.tail)
