    val misnamed = "this clause names 'aera', and the signature above it is 'area''s — a clause is " +
                   "written with its function's own name"

    cls_refused(raw"""
        area(n: int) -> int
        aera(0) = 2
        aera(_) = 1

        main()
            print(area(0))
        """, misnamed, "2:1")
