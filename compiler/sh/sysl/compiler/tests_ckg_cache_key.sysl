// A project whose `main` takes its arguments and writes what `expr` (over `args`) comes to.
private ckg_with_args(head: string, expr: string) -> string
    val root = ckg_project(ckg_manifest("app", ""), "", "0", [])

    ckg_put(root, "main.sysl", s"import sysl.fs.write_text\n\n$head\n\nmain(args: []string)\n" +
            s"    write_text(\"$root/out.txt\", str($expr)).unwrap_or(())\n")
    root
end ckg_with_args

// A program with a bounds check the optimizer cannot remove: the index arrives as an argument.
private ckg_checked() -> string = ckg_with_args("val xs: [3]int = [1, 2, 3]", "xs[args.len]")

