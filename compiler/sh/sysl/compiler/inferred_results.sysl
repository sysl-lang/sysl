module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.container.{Map, map}

// A function's result read off its body: `twice(x: int) = x * 2` hands back an `int` exactly as
// `val y = x * 2` holds one.
//
// **The result is a signature's, so it has to be known wherever a written one would be** -- by a call
// above the declaration, in another file, through another module. It is read where it is first asked
// for: the body is read once with nothing expected, the way a `val`'s initializer is read for its
// type, everything that reading registered is taken back, and only the type is kept. The reading the
// program gets is the ordinary one, against that type, wherever the body is typed.
//
// **A body that reaches its own function before the type is known has no type to take**, which is
// refused at the declaration, as a module `val` whose value reaches itself is.
//
// Every declaration that leaves its result to its body is filed here before anything asks, under the
// name of the function it lowers to, and its slot (`ast_types.sysl`'s `ResultSlot`) names that entry,
// so every copy of the declaration -- the one a call reads, the one the hoist resolved -- reaches the
// one answer. A generic declaration's answer is in terms of its own parameters, standing for
// themselves, and each reading puts its own types in for them.

// One declaration whose result is read off its body.
struct ResultSite
    key: string
    // The name a refusal shows for it, qualified as a reader would write it.
    label: string
    scope: Scope
    // Where the declaration is written: what a refusal points at.
    span: Span
    decl: FuncDecl
    vis: Visibility
    // A nested function's frame, and what the frame's own type parameters stand for there.
    frame: Option[&NestedFrame]
    outer: Buf[Binding]
    // Waiting, being read, settled.
    state: int
    ty: Type
    // The body reached this declaration while it was being read for its type; `told` once refused.
    looped: bool
    told: bool
    // A loop was closed while this declaration's body was being read, so what it read is built on a
    // type nobody had.
    tainted: bool
    // The declarations a loop through this one ran through, as a refusal names them.
    through: Buf[string]
    // The body hands back a closure, whose type has no name for a signature to state.
    closure: bool
    library: bool
    member: bool
    // A property, which a refusal tells to write `name -> T` rather than a function's `name(…) -> T`.
    property: bool
    // The type whose own body (or inherent `impl`) declares this member, whose reach the member's
    // starts from; empty for a free function and for a member supplying a trait's.
    owner: string
end ResultSite

// Every result read off a body, and the reading under way.
struct ResultSites
    // A body can be read once every declaration is in and every member hoisted; before then a result
    // asked for is not known yet, and an asker gets `Unknown`.
    open: bool
    sites: &Table[&ResultSite]
    // The declarations whose bodies are being read for their results now, outermost first.
    reading: Buf[string]
    // The result an `impl` member takes from the trait it supplies, by member key.
    held: &Table[Type]
    // The nested function whose body `nested_body_in` is reading for that function's own result.
    for_body: string
    // A generic declaration's result read at one instantiation, where its own parameters standing for
    // themselves could not read it (`instance_result`), by site key and arguments; and the readings
    // of that kind under way.
    instances: &Table[Type]
    instance_reading: Buf[string]
end ResultSites

result_sites() -> &ResultSites = ResultSites(false, table(), buf(), table(), "", table(), buf())

// A declaration filed: its slot is pointed at it, and it waits to be asked -- or, where the result is
// settled already (`held`), it is that.
note_result_site(a: &Analysis, key: string, label: string, scope: Scope, span: Span, d: FuncDecl,
                 member: bool, held: Option[Type] = None, frame: Option[&NestedFrame] = None,
                 outer: Buf[Binding] = buf(), property: bool = false, owner: string = "")
    val slot = result_slot_of(d.ret_type)

    if slot.is_none() then return

    slot.unwrap().site = key

    val state = if held.is_some() then 2 else 0
    val site = ResultSite(key, label, scope, span, d, d.vis, frame, outer, state,
                          held.unwrap_or(Unknown), false, false, false, buf(), false,
                          from_library(a, scope), member, property, owner)

    a.results.sites.put(key, site)
end note_result_site

// The result an `impl` member supplying a trait's member takes, filed under the member's key while
// the block is checked against the trait (`conformance.sysl`).
held_trait_result(a: &Analysis, member_key: string) -> Option[Type] = a.results.held.get(member_key)

// A member of an `impl` block, which supplies a trait's member: its result is the one the trait
// declared, which is what the block is held to, so its body is read against that rather than for a
// type of its own -- `write(*self, b: []const u8) = putbytes(b)` supplies the trait's `write`
// whatever `putbytes` hands back.
hold_trait_result(a: &Analysis, member_key: string, ty: Type)
    a.results.held.put(member_key, ty)

// What a result left to the body comes to, in the terms of the reading that asks.
inferred_result(a: &Analysis, slot: &ResultSlot, subst: Buf[Binding]) -> Type
    val found = a.results.sites.get(slot.site)

    if found.is_none() then return Unknown

    val s = found.unwrap()

    if s.state != 2 && !a.results.open then return Unknown

    settle_result(a, s)

    if s.ty == Unknown && !s.looped && !s.tainted && !s.closure then return instance_result(a, s, subst)

    subst_params(a, s.ty, subst)
end inferred_result

// **A generic body that its parameters, standing for themselves, cannot read is read at the
// instantiation that asks** -- `show[T](p: Pair[T]) = print(p.bits)` has no `.bits` until `T` is a
// type, since how wide the integer is depends on it, yet at `Pair[u8]` the body is an ordinary call
// handing back `unit`. Taking the first reading's `Unknown` instead gave every instantiation a result
// nobody had, and a call to it a value that its `void` function never produced.
//
// It is read once per site and arguments, everything the reading registered taken back as the first
// reading's was. Arguments that still name a parameter, or a reading of the same instantiation from
// inside itself, keep `Unknown`; so does a body that does not read cleanly here either, which is then
// told where the instantiation is typed for real.
private instance_result(a: &Analysis, s: &ResultSite, subst: Buf[Binding]) -> Type
    val generic = !s.decl.tparams.is_empty() ||
                  (s.member && !a.tables.members.selves.get(s.key).unwrap_or(buf()).is_empty())

    if subst.is_empty() || !generic || s.frame.is_some() then return Unknown

    var key = s.key

    for item in subst
        if mentions_abstract(item.ty) || mentions_unknown(item.ty) then return Unknown

        key = s"$key|${item.name}=${mangle(item.ty)}"

    val known = a.results.instances.get(key)

    if known.is_some() then return known.unwrap()

    for item in a.results.instance_reading
        if item == key then return Unknown

    a.results.instance_reading.push(key)

    val got = body_result_type(a, s.scope, s.decl, Some(subst))

    a.results.instance_reading.truncate(a.results.instance_reading.len() - 1)

    val ty = if is_closure_literal(got) then Unknown else got

    a.results.instances.put(key, ty)
    ty
end instance_result

// The result of the function filed under `key`, settled if it has not been yet -- for a reader that
// holds the function's name rather than its declaration.
settled_result_of(a: &Analysis, key: string) -> Option[Type]
    val found = a.results.sites.get(key)

    if found.is_none() || !a.results.open then return None

    settle_result(a, found.unwrap())
    Some(found.unwrap().ty)
end settled_result_of

// A member's signature as a call or a property read finds it. **A result left to the body is settled
// first** -- a setter's, its property's -- so the call is a reading of the site like any other: one above the declaration gets the
// type, and one inside the member's own body -- `count = self.count + 1`, `m(self) = self.m()` -- is
// the loop the site is refused for, rather than a call to a result nobody read.
member_sig(a: &Analysis, fname: string) -> Option[FuncSig]
    // A setter's value is its property's result, so a write reads the property's site.
    a.results.sites.get(source_member_name(fname)) match
        Some(s) -> if s.member && a.results.open then settle_result(a, s)
        None -> ()

    a.tables.members.func_insts.get(fname)
end member_sig

// Reads one declaration's body for its type, once.
//
// **A body reaching the declaration while it is being read is the loop the reader has to break**:
// the declaration it reached is refused, and every one the reading passed through on the way takes
// `Unknown` with it, since none of them has a type either until one of the loop states its own.
settle_result(a: &Analysis, s: &ResultSite)
    if s.state == 2 then return

    if s.state == 1
        var on_loop = false

        for item in a.results.reading
            if on_loop then
                a.results.sites.get(item) match
                    Some(other) ->
                        other.tainted = true

                        if !s.looped then s.through.push(other.label)
                    None -> ()

            if item == s.key then on_loop = true

        s.looped = true
        return
    end if

    s.state = 1
    a.results.reading.push(s.key)

    val got = read_result(a, s)

    a.results.reading.truncate(a.results.reading.len() - 1)
    s.state = 2
    s.ty = if s.looped || s.tainted then Unknown else got

    // A concrete member's signature was filed at the hoist, before a body could be read, and a nested
    // function's where its group was, so each is corrected here: a call reads the result from there.
    if s.member || s.frame.is_some()
        val sig = a.tables.members.func_insts.get(s.key)

        // Read back through the declaration, so an `async` one's call hands back the task of it.
        if sig.is_some()
            val terms = if s.member then a.tables.members.selves.get(s.key).unwrap_or(buf()) else s.outer
            val ret = declared_result_type(Some(resolve_result(a, s.scope, s.decl.ret_type.unwrap(), terms)))

            a.tables.members.func_insts.put(s.key, FuncSig(sig.unwrap().params, ret))
            correct_setter(a, s.key, ret)
        end if
    end if
end settle_result

// **A setter's value is its property's type**, so a setter paired with a property whose type is read
// off its body was filed with that value not known yet; it takes the type the property settled on.
private correct_setter(a: &Analysis, property: string, ty: Type)
    val key = property + SetterSuffix
    val found = a.tables.members.func_insts.get(key)

    if found.is_none() || mentions_unknown(ty) then return

    var params: Buf[(string, Type)] = buf()

    for item in found.unwrap().params
        params.push(if mentions_unknown(item.1) then (item.0, ty) else item)

    a.tables.members.func_insts.put(key, FuncSig(params, found.unwrap().ret))
end correct_setter

private read_result(a: &Analysis, s: &ResultSite) -> Type
    val got = if s.frame.is_some() then nested_result_type(a, s.frame.unwrap(), s.key, s.decl, s.outer)
    else body_result_type(a, s.scope, s.decl)

    if is_closure_literal(got)
        s.closure = true
        return Unknown
    end if

    got
end read_result

// What a body produces, read with nothing expected and taken back.
//
// The setup is the one a generic body gets at its definition, so a generic declaration's answer is in
// terms of its own parameters and a member's in terms of its type's: each type parameter stands for
// itself, and a reading that fixes them puts its own types in. **Everything the reading said is
// rewound**: the body is read again, for real, wherever it is typed, and a mistake inside it would
// otherwise be reported twice. A body that did not read cleanly answers `Unknown`, which nothing
// downstream complains about a second time.
//
// `given` reads it at one instantiation instead: its bindings are the ones the instantiation's body
// is typed under, so the answer is in its terms.
private body_result_type(a: &Analysis, scope: Scope, written: FuncDecl,
                         given: Option[Buf[Binding]] = None) -> Type
    val d = with_call_bounds(written)

    if d.body.is_empty() then return Unknown

    val reaching = enter_reaching(a, d)

    defer leave_reaching(a, reaching)

    val mark = a.complaints()
    val trial = a.sandboxed()
    val queued = a.tables.members.pending.len()
    val tables = a.tables.members.vtables.len()
    val structs = a.tables.struct_insts.len()
    val enums = a.tables.enum_insts.len()
    val constrained = a.tables.constrained_insts.len()
    val closures = a.closure_funcs.len()
    val counted = a.closure_count
    val subst = with_derive_param(a, d.name, if given.is_some() then given.unwrap()
                                             else abstract_terms(a, scope, d))

    val cx = analyzer_for(a, scope)

    cx.subst = subst
    cx.owner = owner_of(a, d.name, scope)
    cx.in_variadic = d.variadic
    remember_bounds(cx, d)

    for p in d.params
        val unique = cx.bind(p.name, resolve_type(a, scope, p.typ, subst))

        if p.by_name then cx.by_name.push(unique)

    cx.func_name = d.name
    cx.decl_name = d.name
    cx.views_self = d.marks.views
    cx.ret_ty = Some(Unknown)
    cx.await_site = await_site_of(d)
    cx.ret_is_list = false

    val split = contract_length(d.body)

    analyze_contract(cx, decl_anchor(d), d.body, split, Unknown)

    val body = own_result_block(cx, statements_from(d.body, split))
    val clean = a.complaints() == mark

    a.release(trial)
    a.restore_complaints(mark)
    rewind_instantiations(a, queued, tables, structs, enums, constrained)
    a.closure_funcs.truncate(closures)
    a.closure_count = closure_rewind(a, counted)

    if clean then body.ty else Unknown
end body_result_type

// Each of a declaration's parameters standing for itself, and its type's where it is a member.
private abstract_terms(a: &Analysis, scope: Scope, d: FuncDecl) -> Buf[Binding]
    val outer = a.tables.members.selves.get(d.name).unwrap_or(buf())
    var subst = joined_bindings(outer, abstract_subst(a, scope, d.tparams, d.bounds, d.tvalues,
                                                      d.tpacks, outer))
    val written_self = a.tables.members.generic_self.get(d.name)

    if written_self.is_some() then
        subst.push(Binding("Self", resolve_type(a, scope, written_self.unwrap(), subst)))

    subst
end abstract_terms

// A body read for the type it produces: its trailing expression with nothing expected, as a `val`'s
// initializer is read. A body that gave up comes to `Unknown`. A body that is an assignment written
// `=` declares `unit`, since that is the assignment's type: `set(*self) = self.v = true` stores and
// hands nothing back. One written `:=` declares the type of what it stores.
own_result_block(cx: &Analyzer, rest: Buf[Stmt]) -> TBlock
    val outer = cx.an.open_region()

    val was = cx.unit_tail

    cx.unit_tail = true

    val block = type_value_block(cx, rest, None, false)

    cx.unit_tail = was
    val gave_up = cx.an.poison.is_some()

    cx.an.close_region(outer)

    if gave_up then TBlock(block.stmts, block.result, Unknown) else block
end own_result_block

// Every function that leaves its result to its body filed -- a member was filed as it was hoisted --
// and bodies from here on readable: every declaration is in.
open_inferred_results(a: &Analysis)
    for i in 0..<a.tables.funcs.len()
        val f = a.tables.funcs.at(i)
        val shown = if f.scope.module_name == "" then f.decl.name
        else s"${f.scope.module_name}.${f.decl.name}"

        note_result_site(a, a.tables.funcs.key_at(i), shown, f.scope, decl_anchor(f.decl), f.decl, false)

    a.results.open = true
end open_inferred_results

// Every result a program's own declarations leave to their bodies, read once every declaration is in
// -- so that a loop among them is refused and a type one exposes is told, whether or not anything
// calls them -- and every member's, since a call reads a member's result from the table the hoist
// filled. A library function's is read when something first asks for it.
settle_inferred_results(a: &Analysis)
    settle_callees_first(a)

    for i in 0..<a.results.sites.len()
        val s = a.results.sites.at(i)

        if s.frame.is_some() || (s.library && !s.member) then continue

        settle_result(a, s)

    for i in 0..<a.results.sites.len()
        val s = a.results.sites.at(i)

        if s.frame.is_none() && !s.library then told_of_result(a, s)
end settle_inferred_results

// **The program's results are read callees first**, so that reading one never nests a reading per
// call down a chain as long as the program: a body is read after every body it may call has been,
// and each call it reads then finds the answer settled. Read only on demand from the top, a chain of
// thirty-two thousand `f(p: *int) = g(p)` nested a reading per call and overflowed the compiler's
// stack.
//
// What a body may call is read off its names, before anything is resolved: every name it reads or
// selects, matched by its last part to every declaration of that name, which is more than it calls
// and never less (bar a call through a renamed import, which is then read on demand as before). The
// order is a depth-first walk kept on a stack of its own, which finds the loops as it goes (Tarjan's
// strongly connected components).
//
// **A declaration on a loop is not read early** -- nor one whose body names itself. It is left to the
// reading in declaration order below, which refuses the loop at the declaration it entered it by,
// through the ones it passed, as it always has. One that only leads into a loop is read early, and
// its reading enters the loop exactly as a caller's reading would have, by the call it makes.
private settle_callees_first(a: &Analysis)
    val count = a.results.sites.len()
    var named: Map[string, Buf[usize]] = map()

    for i in 0..<count
        val s = a.results.sites.at(i)

        if !read_early(s) then continue

        val short = last_part(s.label)

        named.get(short) match
            Some(list) -> list.push(i)
            None ->
                var list: Buf[usize] = buf()

                list.push(i)
                named.put(short, list)
    end for

    // Per site: the order the walk met it in (0 for not yet), the earliest one it reaches back to
    // while its component is open, whether it is on the component stack, and whether it names itself.
    var order: Buf[usize] = buf()
    var low: Buf[usize] = buf()
    var open: Buf[bool] = buf()
    var own: Buf[bool] = buf()

    for _ in 0..<count
        order.push(0)
        low.push(0)
        open.push(false)
        own.push(false)

    var met: usize = 0
    var held: Buf[usize] = buf()

    for root in 0..<count
        if order.at(root) != 0 || !read_early(a.results.sites.at(root)) then continue

        var names: Buf[usize] = buf()
        var calls: Buf[Buf[usize]] = buf()
        var next: Buf[usize] = buf()

        met += 1
        order.set(root, met)
        low.set(root, met)
        open.set(root, true)
        held.push(root)
        names.push(root)
        calls.push(callees_by_name(a.results.sites.at(root), named))
        next.push(0)

        while names.len() > 0
            val top = names.len() - 1
            val here = names.at(top)
            val at = next.pop().unwrap_or(0)
            val list = calls.at(top)

            if at < list.len()
                next.push(at + 1)

                val callee = list.at(at)

                if callee == here then own.set(here, true)

                if order.at(callee) != 0
                    if open.at(callee) && order.at(callee) < low.at(here) then low.set(here, order.at(callee))
                    continue

                // Read already, by a reading that reached it: nothing below it is left to read.
                if a.results.sites.at(callee).state == 2 then continue

                met += 1
                order.set(callee, met)
                low.set(callee, met)
                open.set(callee, true)
                held.push(callee)
                names.push(callee)
                calls.push(callees_by_name(a.results.sites.at(callee), named))
                next.push(0)
            else
                names.truncate(top)
                calls.truncate(top)

                if top > 0 && low.at(here) < low.at(names.at(top - 1))
                    low.set(names.at(top - 1), low.at(here))

                if low.at(here) == order.at(here) then close_component(a, held, here, open, own)
            end if
        end while
    end for
end settle_callees_first

// A component of the walk is complete at `head`: every site it reaches outside it is read already.
// A component of one site that does not name itself is on no loop, and is read now.
private close_component(a: &Analysis, held: Buf[usize], head: usize, open: Buf[bool], own: Buf[bool])
    val last = held.len() - 1

    if held.at(last) == head && !own.at(head)
        held.truncate(last)
        open.set(head, false)
        settle_result(a, a.results.sites.at(head))
        return
    end if

    loop
        val item = held.pop().unwrap()

        open.set(item, false)

        if item == head then return
end close_component

// A site the program's own reading in declaration order would read: its own functions and members,
// not a nested function's (read with its frame) nor a library function's (read when asked).
private read_early(s: &ResultSite) -> bool = s.state == 0 && s.frame.is_none() && !s.library

private last_part(name: string) -> string =
    name.last_index_of(".") match
        Some(i) -> name[i + 1..<name.bytes.len]
        None -> name

// Every site whose name the body of `s` reads or selects, a site once for each mention.
private callees_by_name(s: &ResultSite, named: Map[string, Buf[usize]]) -> Buf[usize]
    var out: Buf[usize] = buf()

    for c in body_constructs(s.decl)
        val mentioned = c.node match
            AtExpr(e) ->
                *e.kind match
                    Ident(n) -> Some(last_part(n))
                    Field(_, n, _) -> Some(n)
                    _ -> None
            _ -> None

        if mentioned.is_some()
            named.get(mentioned.unwrap()) match
                Some(list) ->
                    for i in list
                        out.push(i)
                None -> ()
    end for

    out
end callees_by_name

// What a declaration whose result was read is told: that its body reaches it, that its result
// exposes a type it may not, or that C reads it.
told_of_result(a: &Analysis, s: &ResultSite)
    if s.state != 2 || s.told then return

    s.told = true

    if s.looped
        var via = ""

        for i in 0..<s.through.len()
            via = via + (if i == 0 then " through " else ", ") + s"'${s.through.at(i)}'"

        a.fault(s.scope, s.span, s"'${s.label}' takes its result type from its body, and the body " +
                s"reaches '${s.label}' again$via — write its result type, ${written_form(s, "T")}")
        return
    end if

    if s.closure
        a.fault(s.scope, s.span, s"'${s.label}' would hand back a closure, whose type has no name for " +
                s"a signature to state — write its result type, ${written_form(s, "&Fn(…) -> R")}")
        return
    end if

    if mentions_unknown(s.ty) then return

    // **C reads what an exported function hands back**, and what it reads is the declaration as
    // written, so a value it would be handed is one the declaration has to state.
    if s.ty != Unit && (s.decl.exported.is_some() || s.decl.conv.is_some())
        val shown = if s.decl.exported.is_some() then "'@export'" else "'@convention'"

        a.fault(s.scope, s.span, s"'${s.label}' is $shown, so C reads what it hands back, and its " +
                s"body yields ${type_show(s.ty)} — write its result type, ${written_form(s, "T")}")
        return
    end if

    if !s.member then check_exposed_result(a, s.scope, s.label, s.vis, s.ty, s.span)

    // **A member reaches as far as its type unless it says less**, and a result read off its body is
    // held to that reach exactly as a written one is (`analyze.sysl:check_exposed_members`).
    if s.member && s.owner != ""
        a.tables.access.get(s.owner) match
            Some(acc) -> check_exposed_result(a, s.scope, s.label, member_reach(acc.vis, s.vis), s.ty, s.span)
            None -> ()
end told_of_result

// The signature a refusal tells the declaration to write: `count -> T` for a property, which has no
// parameter list, and `count(…) -> T` for a function.
private written_form(s: &ResultSite, result: string) -> string =
    if s.property then s"'${s.decl.name} -> $result'" else s"'${s.decl.name}(…) -> $result'"
