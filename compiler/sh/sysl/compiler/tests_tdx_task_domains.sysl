module sh.sysl.compiler
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.fs.{make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture
import sysl.text.Search

// Whether a task may reach another concurrency domain (`task_domains.sysl`): a task's frame holds
// its parameters, its result and the locals alive across an `await`, and crossing it is asked the
// question a closure crossing into a `&sync Fn` is asked, of each of them.
//
// **The reference compiler has no tasks**, so the messages are the design's own, worded as the
// existing refusals at the same three places are.

private var tdx_library_cache: Buf[Program] = buf()
private var tdx_library_read: bool = false

private tdx_library() -> Buf[Program]
    if tdx_library_read then return tdx_library_cache

    tdx_library_read = true

    std_root() match
        Err(_) -> ()
        Ok(root) -> std_units(root, host_target()) match
            Err(_) -> ()
            Ok(units) -> tdx_library_cache = units

    tdx_library_cache
end tdx_library

private tdx_no_library() -> bool
    if tdx_library().is_empty()
        print("skipped: the standard module's source is not on this machine")
        return true
    end if

    false
end tdx_no_library

// The whole report a one-file program is refused with, or `""` where it analyzes clean.
private tdx_refused(text: string) -> string
    val parsed = parse(source_of("t.sysl", text))

    if !parsed.ok() then return parsed.report.render(parsed.src)

    var units: Buf[Program] = buf()
    val library = tdx_library()

    for i in 0..<library.len()
        units.push(library.at(i))

    units.push(parsed.program)

    val done = analyze_bodies(units, host_target())
    val whole = program_of(done, "")

    post_analysis_checks(done.an, whole, buf())

    analysis_report(errors_of(done.an.diagnostics()))
end tdx_refused

// That a report holds the complaint, worded so and anchored at `line:column` -- the arrow is
// indented to the width of the line numbers in the gutter, so it is matched without its margin.
private tdx_says(report: string, message: string, at: string)
    assert(report.contains(s"error: $message\n"), report)
    assert(report.contains(s"--> t.sysl:$at\n"), report)
end tdx_says

// A facility that hands a task to another domain, and a cell to count through.
private tdx_prelude() -> string = raw"""
    struct Cell
        n: int

    @crossing(t)
    hand(t: Task[int]) = ()

    """

private tdx_arg() -> string =
    "'t' of 'hand' reaches another concurrency domain, so every count inside it has to be atomic — "

private tdx_view() -> string =
    "which owns its bytes through a count that is not atomic. A literal's bytes are immortal and " +
    "would be safe to share, but nothing in the type says whether these are, so a shared object holds " +
    "no view at all ('06')"

private tdx_unmade() -> string =
    " — what a task's frame holds is known only where the call that makes it can be seen, so a task " +
    "crosses there, or through a parameter its function names in '@crossing'"

// -- what a frame holds ---------------------------------------------------------------------------------

@test("a task of plain scalars crosses")
tdx_scalars_cross()
    if tdx_no_library() then return

    assert_eq(tdx_refused(tdx_prelude() + raw"""
        async work(a: int, b: real) -> int
            val k = a * 2
            await yield_now()
            k + int(b)

        hand(work(1, 2.0))
        """), "")

@test("a task holding a '&sync T' parameter crosses")
tdx_sync_parameter_crosses()
    if tdx_no_library() then return

    assert_eq(tdx_refused(tdx_prelude() + raw"""
        async work(c: &sync Cell) -> int
            await yield_now()
            c.n

        val c: &sync Cell = Cell(1)

        hand(work(c))
        """), "")

@test("a task holding a 'string' parameter is refused at the argument, naming the function and the parameter")
tdx_string_parameter_refused()
    if tdx_no_library() then return

    tdx_says(tdx_refused(tdx_prelude() + raw"""
        async work(s: string) -> int
            await yield_now()
            1

        hand(work("hi"))
        """), tdx_arg() + "but it is a task of 'work', whose frame holds its parameter 's', a " +
        "'string', " + tdx_view(), "11:6")

@test("a task holding an ordinary '&T' local across an 'await' is refused, naming the local")
tdx_local_across_await_refused()
    if tdx_no_library() then return

    tdx_says(tdx_refused(tdx_prelude() + raw"""
        async work(n: int) -> int
            val r: &Cell = Cell(n)
            await yield_now()
            r.n

        hand(work(1))
        """), tdx_arg() + "but it is a task of 'work', whose frame holds its local 'r', a '&Cell', " +
        "whose count is not. Hold it as a '&sync Cell' ('06')", "12:6")

@test("a task holding a Buf across an 'await' is refused in words about the Buf, its core being unnameable")
tdx_buf_across_await_names_the_buf()
    if tdx_no_library() then return

    tdx_says(tdx_refused("import sysl.buf.{Buf, buf}\n\n" + tdx_prelude() + raw"""
        async work(n: int) -> int
            val b: Buf[int] = buf()
            b.push(n)
            await yield_now()
            b.at(0)

        hand(work(1))
        """), tdx_arg() + "but it is a task of 'work', whose frame holds its local 'b', a " +
        "'sysl.buf.Buf[int]', which is shared through a count that is not atomic, and no spelling of it " +
        "can cross into a '&sync' ('06')", "15:6")

@test("a Map inside a struct held across an 'await' names the field and the Map")
tdx_map_in_a_struct_across_await_names_the_map()
    if tdx_no_library() then return

    tdx_says(tdx_refused("import sysl.container.{Map, map}\n\nstruct Index\n    names: Map[int, int]\n\n" +
                         tdx_prelude() + raw"""
        async work(n: int) -> int
            val ix = Index(map())
            ix.names.put(n, n)
            await yield_now()
            ix.names.len()

        hand(work(1))
        """), tdx_arg() + "but it is a task of 'work', whose frame holds its local 'ix', whose 'names' " +
        "is a 'sysl.container.Map[int, int]', which is shared through a count that is not atomic, and no " +
        "spelling of it can cross into a '&sync' ('06')", "18:6")

@test("the same local let go of before the first 'await' is not in the frame, so the task crosses")
tdx_local_dropped_before_await_crosses()
    if tdx_no_library() then return

    assert_eq(tdx_refused(tdx_prelude() + raw"""
        async work(n: int) -> int
            var k = 0

            if n > 0
                val r: &Cell = Cell(n)
                k = r.n

            await yield_now()
            k

        hand(work(1))
        """), "")

@test("a counted local is held to the end of its block, so one read only before the 'await' still is")
tdx_local_held_to_its_block_end()
    if tdx_no_library() then return

    tdx_says(tdx_refused(tdx_prelude() + raw"""
        async work(n: int) -> int
            val r: &Cell = Cell(n)
            val k = r.n
            await yield_now()
            k

        hand(work(1))
        """), tdx_arg() + "but it is a task of 'work', whose frame holds its local 'r', a '&Cell', " +
        "whose count is not. Hold it as a '&sync Cell' ('06')", "13:6")

@test("a task ending with a 'string' is refused: its result is written in one domain and read in another")
tdx_string_result_refused()
    if tdx_no_library() then return

    tdx_says(tdx_refused(raw"""
        @crossing(t)
        hand_text(t: Task[string]) = ()

        async work(n: int) -> string
            await yield_now()
            "done"

        hand_text(work(1))
        """), "'t' of 'hand_text' reaches another concurrency domain, so every count inside it has to " +
        "be atomic — but it is a task of 'work', whose frame holds its result, a 'string', " +
        tdx_view(), "8:11")

@test("a task it awaits is in its frame, and the refusal follows the chain")
tdx_awaited_task_followed()
    if tdx_no_library() then return

    tdx_says(tdx_refused(tdx_prelude() + raw"""
        async inner(s: string) -> int
            await yield_now()
            1

        async outer(n: int) -> int
            val v = await inner("x")
            v + n

        hand(outer(1))
        """), tdx_arg() + "but it is a task of 'outer', whose frame holds the task it awaits, a task " +
        "of 'inner', whose frame holds its parameter 's', a 'string', " + tdx_view(), "15:6")

// -- a statement's temporaries ------------------------------------------------------------------------

// A value computed before an `await` in the same statement is the statement's until it ends, so it
// is in the frame at that suspension: the five shapes, each refused where the value holds a count
// that is not atomic and accepted where it is a scalar.
private tdx_temps(body: string) -> string = tdx_prelude() + raw"""
    struct Meter
        n: int

        plus(self, k: int) -> int = self.n + k

    async other() -> int
        await yield_now()
        1

    make_string() -> string = "made"
    make_cell(n: int) -> &Cell = Cell(n)
    make_meter(n: int) -> &Meter = Meter(n)
    take(s: string, n: int) -> int = n
    sum(a: int, b: int) -> int = a + b

    """ + body

private tdx_temp_held(report: string, shown: string) =
    assert(report.contains(tdx_arg() + "but it is a task of 'work', whose frame holds a value computed " +
                           s"before an 'await' in the same statement, a '$shown', "), report)

@test("an argument computed before an awaited one is in the frame")
tdx_temp_earlier_argument_refused()
    if tdx_no_library() then return

    tdx_says(tdx_refused(tdx_temps(raw"""
        async work(n: int) -> int
            take(make_string(), await other())

        hand(work(1))
        """)), tdx_arg() + "but it is a task of 'work', whose frame holds a value computed before an " +
        "'await' in the same statement, a 'string', " + tdx_view(), "25:6")

@test("and a scalar argument computed before an awaited one crosses")
tdx_temp_earlier_argument_scalar_crosses()
    if tdx_no_library() then return

    assert_eq(tdx_refused(tdx_temps(raw"""
        async work(n: int) -> int
            sum(n * 2, await other())

        hand(work(1))
        """)), "")

@test("the left operand of an operator whose right one awaits is in the frame")
tdx_temp_left_operand_refused()
    if tdx_no_library() then return

    tdx_temp_held(tdx_refused(tdx_temps(raw"""
        async work(n: int) -> int
            print(make_string() + str(await other()))
            n

        hand(work(1))
        """)), "string")

@test("and a scalar left operand crosses")
tdx_temp_left_operand_scalar_crosses()
    if tdx_no_library() then return

    assert_eq(tdx_refused(tdx_temps(raw"""
        async work(n: int) -> int
            n * 3 + await other()

        hand(work(1))
        """)), "")

@test("a receiver whose method call awaits in an argument is in the frame")
tdx_temp_receiver_refused()
    if tdx_no_library() then return

    tdx_temp_held(tdx_refused(tdx_temps(raw"""
        async work(n: int) -> int
            make_meter(n).plus(await other())

        hand(work(1))
        """)), "&Meter")

@test("and a receiver of plain scalars crosses")
tdx_temp_receiver_scalar_crosses()
    if tdx_no_library() then return

    assert_eq(tdx_refused(tdx_temps(raw"""
        async work(n: int) -> int
            Meter(n).plus(await other())

        hand(work(1))
        """)), "")

@test("an array element built before an awaited one is in the frame")
tdx_temp_array_element_refused()
    if tdx_no_library() then return

    tdx_temp_held(tdx_refused(tdx_temps(raw"""
        async work(n: int) -> int
            val xs = [make_cell(n), make_cell(await other())]
            xs[1].n

        hand(work(1))
        """)), "&Cell")

@test("and a scalar array element crosses")
tdx_temp_array_element_scalar_crosses()
    if tdx_no_library() then return

    assert_eq(tdx_refused(tdx_temps(raw"""
        async work(n: int) -> int
            val xs = [n + 1, await other()]
            xs[0] + xs[1]

        hand(work(1))
        """)), "")

@test("a tuple element built before an awaited one is in the frame")
tdx_temp_tuple_element_refused()
    if tdx_no_library() then return

    tdx_temp_held(tdx_refused(tdx_temps(raw"""
        async work(n: int) -> int
            val p = (make_cell(n), await other())
            p.1

        hand(work(1))
        """)), "&Cell")

@test("and a scalar tuple element crosses")
tdx_temp_tuple_element_scalar_crosses()
    if tdx_no_library() then return

    assert_eq(tdx_refused(tdx_temps(raw"""
        async work(n: int) -> int
            val p = (n + 1, await other())
            p.0 + p.1

        hand(work(1))
        """)), "")

@test("the text an interpolation has built before an awaited hole is in the frame")
tdx_temp_interpolation_refused()
    if tdx_no_library() then return

    tdx_temp_held(tdx_refused(tdx_temps(raw"""
        async work(n: int) -> int
            print(s"n is ${n}, then ${await other()}")
            n

        hand(work(1))
        """)), "string")

@test("and an interpolation with only literal text before its awaited hole crosses")
tdx_temp_interpolation_literal_crosses()
    if tdx_no_library() then return

    assert_eq(tdx_refused(tdx_temps(raw"""
        async work(n: int) -> int
            print(s"then ${await other()}")
            n

        hand(work(1))
        """)), "")

@test("a temporary used up in an earlier statement is gone before the 'await', so the task crosses")
tdx_temp_consumed_earlier_crosses()
    if tdx_no_library() then return

    assert_eq(tdx_refused(tdx_temps(raw"""
        async work(n: int) -> int
            val k = make_cell(n).n + int(make_string().bytes.len)
            sum(k, await other())

        hand(work(1))
        """)), "")

@test("a task parameter of an async function is answered by the argument its call was handed")
tdx_task_parameter_follows_the_argument()
    if tdx_no_library() then return

    val program = tdx_prelude() + raw"""
        async plain(n: int) -> int
            await yield_now()
            n

        async text(s: string) -> int
            await yield_now()
            1

        async twice(t: Task[int]) -> int = await t * 2

        hand(twice(plain(1)))
        hand(twice(text("x")))
        """

    tdx_says(tdx_refused(program), tdx_arg() + "but it is a task of 'twice', whose frame holds its " +
             "parameter 't', a task of 'text', whose frame holds its parameter 's', a 'string', " +
             tdx_view(), "18:6")

@test("a task that parks stays in its domain, the waker it is handed being domain-local")
tdx_parking_task_refused()
    if tdx_no_library() then return

    tdx_says(tdx_refused(tdx_prelude() + raw"""
        async waits() -> int
            await park(w -> w())
            1

        hand(waits())
        """), tdx_arg() + "but it is a task of 'waits', whose frame holds the 'park' it awaits — a " +
        "task that parks is handed a waker, and a waker is a '&Fn() -> unit' belonging to the domain " +
        "whose executor steps the task, so a task that parks stays in that domain", "11:6")

// -- where it is asked ----------------------------------------------------------------------------------

@test("a task captured by a closure shared into a '&sync Fn' is refused at the closure")
tdx_captured_task_refused()
    if tdx_no_library() then return

    tdx_says(tdx_refused(raw"""
        @crossing(f)
        later(f: &sync Fn() -> unit) = ()

        async work(s: string) -> int
            await yield_now()
            1

        val t = work("hi")

        later(() -> print(block_on(t)))
        """), "a closure shared between two domains may be called from either, so every count it " +
        "captures has to be atomic — but the 't' it captures is a task of 'work', whose frame holds " +
        "its parameter 's', a 'string', " + tdx_view(), "10:7")

@test("and one of plain scalars captured that way is not")
tdx_captured_scalar_task_crosses()
    if tdx_no_library() then return

    assert_eq(tdx_refused(raw"""
        @crossing(f)
        later(f: &sync Fn() -> unit) = ()

        async work(n: int) -> int
            await yield_now()
            n

        val t = work(1)

        later(() -> print(block_on(t)))
        """), "")

@test("a task held by a '&sync' structure is refused where the structure is boxed")
tdx_shared_structure_refused()
    if tdx_no_library() then return

    tdx_says(tdx_refused(raw"""
        struct Holder
            t: Task[int]

        async work(s: string) -> int
            await yield_now()
            1

        val h: &sync Holder = Holder(work("x"))
        """), "'&sync Holder' may be reached from two domains at once, so every count inside it has to " +
        "be atomic — but its 't' is a task of 'work', whose frame holds its parameter 's', a 'string', " +
        tdx_view(), "8:23")

@test("a task whose making cannot be seen from where it crosses is refused")
tdx_unseen_task_refused()
    if tdx_no_library() then return

    tdx_says(tdx_refused(tdx_prelude() + raw"""
        relay(t: Task[int]) = hand(t)
        """), tdx_arg() + "but it is a task, and nothing here says which async function made it" +
        tdx_unmade(), "7:28")

@test("a parameter its function names in '@crossing' crosses on, and its callers are held to the rule")
tdx_vouched_parameter_crosses_on()
    if tdx_no_library() then return

    val program = tdx_prelude() + raw"""
        @crossing(t)
        relay(t: Task[int]) = hand(t)

        async plain(n: int) -> int
            await yield_now()
            n

        async text(s: string) -> int
            await yield_now()
            1

        relay(plain(1))
        relay(text("x"))
        """

    tdx_says(tdx_refused(program), "'t' of 'relay' reaches another concurrency domain, so every count " +
             "inside it has to be atomic — but it is a task of 'text', whose frame holds its " +
             "parameter 's', a 'string', " + tdx_view(), "19:7")

@test("a local written again after it was made is not followed back to its first value")
tdx_rewritten_local_is_unseen()
    if tdx_no_library() then return

    tdx_says(tdx_refused(tdx_prelude() + raw"""
        async work(n: int) -> int
            await yield_now()
            n

        var t = work(1)

        t = work(2)
        hand(t)
        """), tdx_arg() + "but it is a task, and nothing here says which async function made it" +
        tdx_unmade(), "14:6")

@test("everything refused above is accepted where it stays in its own domain")
tdx_domain_local_use_unchanged()
    if tdx_no_library() then return

    assert_eq(tdx_refused(raw"""
        struct Cell
            n: int

        struct Holder
            t: Task[int]

        async work(s: string) -> int
            val r: &Cell = Cell(1)
            await yield_now()
            r.n + int(s.bytes.len)

        async text(n: int) -> string
            await yield_now()
            "done"

        async waits() -> int
            await park(w -> w())
            1

        async outer(n: int) -> int = await work("x") + n

        relay(t: Task[int]) -> int = block_on(t)

        val t = work("hi")
        val f: &Fn() -> unit = () -> print(block_on(t))
        val h: &Holder = Holder(work("y"))

        f()
        print(relay(outer(1)), block_on(text(1)), block_on(waits()), block_on(h.t))
        """), "")

// -- the waker ------------------------------------------------------------------------------------------

// **A waker is a `&Fn() -> unit`, and neither form takes a `&sync Fn`**: `&T` and `&sync T` are
// distinct types with no conversion between them, so accepting one would be a new form. The waker
// `park` makes counts and arms itself with plain stores, so it is domain-local by construction, and
// the existing capture rule is what keeps a registrar from sending it anywhere.

@test("step takes a '&Fn() -> unit' waker, and a '&sync Fn() -> unit' one is refused")
tdx_step_refuses_a_sync_waker()
    if tdx_no_library() then return

    val out = tdx_refused(raw"""
        async work(n: int) -> int
            await yield_now()
            n

        val w: &sync Fn() -> unit = () -> ()

        print(step(work(1), w))
        """)

    assert(out.contains("error: "), out)
    assert(out.contains("&sync Fn() -> unit"), out)

@test("a registrar may not send the waker park hands it into a '&sync Fn'")
tdx_registrar_keeps_the_waker_local()
    if tdx_no_library() then return

    tdx_says(tdx_refused(raw"""
        @crossing(f)
        later(f: &sync Fn() -> unit) = ()

        async waits() -> int
            await park(w -> later(() -> w()))
            1

        print(block_on(waits()))
        """), tdx_waker_refusal("w"), "5:27")

// What a closure sharing a park's waker is told: not to hold it as a '&sync Fn', which neither
// 'park' nor 'step' would take, but where the waker belongs.
private tdx_waker_refusal(name: string) -> string =
    "a closure shared between two domains may be called from either, so every count it captures has " +
    s"to be atomic — but the '$name' it captures is the waker 'park' handed its registrar, a " +
    "'&Fn() -> unit' belonging to the domain whose executor steps the task, and no spelling makes it " +
    "atomic. Keep the waker in that domain: let the other domain — an interrupt, another thread — " +
    "signal the executor, and have the executor call the waker"

@test("a waker captured again inside the registrar is still the executor's")
tdx_registrar_waker_captured_twice()
    if tdx_no_library() then return

    tdx_says(tdx_refused(raw"""
        @crossing(f)
        later(f: &sync Fn() -> unit) = ()

        async waits() -> int
            await park(w ->
                val again = () -> later(() -> w())
                again())
            1

        print(block_on(waits()))
        """), tdx_waker_refusal("w"), "6:33")

@test("an ordinary '&Fn' captured beside a registrar keeps the '&sync' advice")
tdx_registrar_other_capture_keeps_the_advice()
    if tdx_no_library() then return

    tdx_says(tdx_refused(raw"""
        @crossing(f)
        later(f: &sync Fn() -> unit) = ()

        async waits(g: &Fn() -> unit) -> int
            await park(w -> later(() -> g()))
            1

        print(block_on(waits(() -> ())))
        """), "a closure shared between two domains may be called from either, so every count it " +
        "captures has to be atomic — but the 'g' it captures reaches a '&Fn() -> unit', whose count is " +
        "not. Hold it as a '&sync Fn() -> unit' ('06')", "5:27")

// -- a task that really crosses ------------------------------------------------------------------------

// What a program prints at the default level, or why it did not build or run to the end.
private tdx_ran(text: string) -> string
    val root = make_temp_dir("sysl-tdx").unwrap()

    write_text(s"$root/main.sysl", text).unwrap()

    val exe = s"$root/built"

    build_native_program(root, None, None, DefaultOptimization, Some(exe)) match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return s"it did not build: ${failure_text(why)}"
        Ok(_) -> ()

    val said = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    said match
        Err(_) -> "the program that was built could not be run"
        Ok(out) -> if out.status.ok() then out.text else
            s"it did not run to the end: ${out.text}${out.err.unwrap_or("")}"
end tdx_ran

// `spawn` alone is imported: the library's own `yield_now` is the nearer name where the module is
// imported whole, and it is a thread's, not a task's.
private tdx_threaded(params: string) -> string = raw"""
    import sysl.posix.threads.spawn

    struct Job
        t: Task[int]
        out: int

    run(j: *Job)
        j.out = block_on(j.t)

    """ + s"async sum_to($params) -> int\n" + raw"""
        var total = 0

        for i in 0..<n
            await yield_now()
            total += i

        total

    """

@test("a task of scalars is handed to another thread and run there while this one runs its own")
tdx_a_task_runs_on_another_thread()
    if tdx_no_library() then return

    assert_eq(tdx_ran(tdx_threaded("n: int") + raw"""
        var job = Job(sum_to(1000), 0)
        val th = spawn(&run, &job).unwrap()
        val mine = block_on(sum_to(2000))

        th.join()
        print(job.out, mine)
        """), "499500 1999000\n")

@test("and the same hand-over is refused where the task's frame holds a 'string'")
tdx_a_threaded_task_holding_a_string_is_refused()
    if tdx_no_library() then return

    tdx_says(tdx_refused(tdx_threaded("n: int, label: string") + raw"""
        var job = Job(sum_to(10, "ten"), 0)

        spawn(&run, &job).unwrap().join()
        """), "what 'arg' of 'sysl.posix.threads.spawn' points at reaches another concurrency domain, " +
        "so every count inside it has to be atomic — but its 't' is a task of 'sum_to', whose frame " +
        "holds its parameter 'label', a 'string', " + tdx_view(), "21:13")
