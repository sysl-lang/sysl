module sh.sysl.compiler
@tests

import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture
import sysl.text.{Search, replace_all}

// The reference's `MethodRunTests`: what methods, properties and associated functions DO when run.
// Each receiver mode hands the method the instance it should -- a copy for `self`, the place itself
// for `*self`, the shared box for `&self` -- and a member lowered to a function runs like any call.
// The four `&T`-field loops run half a million times, so a leak or a double release over a reference
// a method hands out or overwrites shows up as a wrong total or a crash rather than passing quietly.
//
// **Every output and refusal here was read out of the reference compiler (0.0.162)** by handing the
// installed `sysl` the same program.

// What a program did: what it printed, and whether it exited zero. A failure to build is its
// message, with the temporary directory written `<root>` so two refusals compare, and a non-zero exit.
private mrn_outcome(text: string) -> (string, bool)
    val root = make_temp_dir("sysl-mrn").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", text).unwrap()

    val exe = s"$root/built"

    build_native_program(root, None, None, DefaultOptimization, Some(exe)) match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return (replace_all(failure_text(why), root, "<root>"), false)
        Ok(_) -> ()

    val said = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    said match
        Err(_) -> ("the program that was built could not be run", false)
        Ok(out) -> (out.text + out.err.unwrap_or(""), out.status.ok())
end mrn_outcome

// The program runs to the end and prints exactly this. Returns at once without the library.
private mrn_prints(text: string, want: string)
    if xvr_no_library() then return

    val out = mrn_outcome(text)

    assert(out.1, s"it did not exit zero: ${out.0}")
    assert_eq(out.0, want)
end mrn_prints

// The first complaint about a file, with the `line:column` it points at.
private mrn_said(text: string) -> string
    val said = pf_err(text)

    if said == "" then "" else s"${said} @ t.sysl:${pf_at(text)}"

// -- the three receivers ------------------------------------------------------------------------------

@test("a value-receiver method reads the instance")
mrn_value_receiver_reads() = mrn_prints(raw"""
    struct Point
        x: int
        y: int
        sum(self) -> int = self.x + self.y
    var p = Point(3, 4)
    print(p.sum())
    """, "7\n")

@test("a pointer-receiver method mutates a stack value in place")
mrn_pointer_receiver_mutates() = mrn_prints(raw"""
    struct Point
        x: int
        y: int
        shift(*self, dx: int, dy: int)
            self.x += dx
            self.y += dy
    var p = Point(3, 4)
    p.shift(10, 20)
    print(p.x, p.y)
    """, "13 24\n")

@test("a reference-receiver method mutates the shared heap object")
mrn_reference_receiver_mutates() = mrn_prints(raw"""
    struct Counter
        n: int
        bump(&self)
            self.n += 1
        value(self) -> int = self.n
    var c: &Counter = Counter(0)
    c.bump()
    c.bump()
    c.bump()
    print(c.value())
    """, "3\n")

// -- properties ---------------------------------------------------------------------------------------

@test("a computed property reads with no parentheses, on a value and on a reference")
mrn_computed_property() = mrn_prints(raw"""
    struct Counter
        n: int
        doubled -> int = self.n * 2
    var v = Counter(21)
    var r: &Counter = Counter(5)
    print(v.doubled, r.doubled)
    """, "42 10\n")

// A property is a function with the parameter list left off, so it takes the same body a method
// takes: an `= expr`, an `=` opening a block, or a block with no `=`.
@test("a property body may be a block")
mrn_property_body_block() = mrn_prints(raw"""
    struct P
        x: int
        y: int

        biggest -> int
            var m = self.x
            if self.y > m then m = self.y
            m

        total -> int =
            var t = 0
            for v in [self.x, self.y] do t += v
            t
    end P

    var p = P(3, 8)
    print(p.biggest, p.total)
    """, "8 11\n")

// A block body is what makes an early answer spellable, and `end <name>` closes a property exactly
// as it closes a method.
@test("and may return out of itself, under an end marker of its own")
mrn_property_returns_under_end() = mrn_prints(raw"""
    struct P
        x: int

        kind -> string
            if self.x < 0 then return "negative"
            if self.x == 0 then return "zero"
            "positive"
        end kind
    end P

    print(P(-4).kind, P(0).kind, P(9).kind)
    """, "negative zero positive\n")

// A trait's default property and the implementation's answer both take the block.
@test("a trait's default property and an impl's may each open one")
mrn_trait_and_impl_property_blocks() = mrn_prints(raw"""
    import sysl.text.str_builder

    trait Named
        label -> string
            var b = str_builder()
            b.push("<")
            b.push(self.tag)
            b.push(">")
            b.finish()

        tag -> string
    end Named

    struct P
        x: int
        y: int
    end P

    impl Named for P
        tag -> string
            var s = str(self.x)
            s + "," + str(self.y)

    var p = P(3, 8)
    print(p.label, p.tag)
    """, "<3,8> 3,8\n")

// A property's declared result is one type and never a result list, so a comma in its body is the
// mistake it is -- and the message names the list rather than the grammar.
@test("but its body is one value, not several")
mrn_property_body_one_value()
    if xvr_no_library() then return

    val said = mrn_outcome(raw"""
        struct P
            x: int
            pair -> int = 1, 2
        end P

        print(P(1).pair)
        """).0

    assert(said.contains("error: several values separated by commas are a function's result list, and this " +
                         "function declares one result — write the values it wants, or declare a result list\n"),
           said)
    assert(said.contains("<root>/main.sysl:3:19\n"), said)
end mrn_property_body_one_value

// A generic type's property is instantiated from the receiver's own arguments as a method is, and an
// enum's may take its own value apart.
@test("a block reaches a generic type's property and an enum's")
mrn_generic_and_enum_property_blocks() = mrn_prints(raw"""
    import sysl.text.str_builder

    struct Box[T: Display]
        v: T

        shown -> string
            var b = str_builder()
            b.push("[")
            b.push(str(self.v))
            b.push("]")
            b.finish()
    end Box

    enum Shape
        Circle(r: int)
        Square(s: int)

        area -> int
            var a = 0
            self match
                Circle(r) -> a = r * r * 3
                Square(s) -> a = s * s
            a
    end Shape

    print(Box(7).shown, Box("hi").shown)
    print(Circle(2).area, Square(3).area)
    """, "[7] [hi]\n12 9\n")

// A signature with no body is what a *trait* declares, so in a type's own body one is refused -- and
// refused identically whichever member it is. The reference reports the same two complaints for
// both: `indent expected` at 4:1 and `newline expected` at 4:5.
@test("a property with no body is refused exactly as a method with none is")
mrn_bodyless_property_refused_as_a_method()
    val property = "struct P\n    x: int\n    doubled -> int\nend P\n"
    val method = "struct P\n    x: int\n    doubled(self) -> int\nend P\n"

    assert_eq(mrn_said(property), "indent expected @ t.sysl:4:1")
    assert_eq(mrn_said(method), "indent expected @ t.sysl:4:1")

    if xvr_no_library() then return

    val p = mrn_outcome(property)
    val m = mrn_outcome(method)

    assert(!p.1, p.0)
    assert_eq(p.0, m.0)
end mrn_bodyless_property_refused_as_a_method

// -- associated functions and calls between members ---------------------------------------------------

@test("an associated function is called through the type name")
mrn_associated_function() = mrn_prints(raw"""
    struct Point
        x: int
        y: int
        sum(self) -> int = self.x + self.y
        diagonal(n: int) -> Point = Point(n, n)
    var p = Point.diagonal(6)
    print(p.sum())
    """, "12\n")

@test("a method may call another method on self")
mrn_method_calls_method_on_self() = mrn_prints(raw"""
    struct Rect
        w: int
        h: int
        area(self) -> int = self.w * self.h
        describe(self) -> int = self.area() + 1
    var r = Rect(3, 4)
    print(r.describe())
    """, "13\n")

@test("a method is reached through a pointer to the receiver")
mrn_method_through_a_pointer() = mrn_prints(raw"""
    struct Point
        x: int
        y: int
        sum(self) -> int = self.x + self.y
    bump(p: *Point)
        p.x += 100
    var p = Point(1, 2)
    bump(&p)
    print(p.sum())
    """, "103\n")

// -- a `&T` field through a method, counted ----------------------------------------------------------

// The returned `&Inner` is retained, so it outlives the receiver dropped when `extract` returns.
// total = sum of i%4 over 500000 = 750000.
@test("a &self method returns a &T field that outlives the dropped receiver")
mrn_ref_self_returns_a_field() = mrn_prints(raw"""
    struct Inner
        v: int
    struct Outer
        inner: &Inner
        peek(&self) -> &Inner = self.inner
    extract(seed: int) -> &Inner
        var o: &Outer = Outer(Inner(seed))
        o.peek()
    var i = 0
    var total = 0
    while i < 500000
        var got = extract(i % 4)
        total += got.v
        i++
    print(total)
    """, "750000\n")

// Overwriting releases the old reference and retains the new. total = sum of (i%3 + 1) = 999999.
@test("a &self method that swaps a &T field releases the old and retains the new")
mrn_ref_self_swaps_a_field() = mrn_prints(raw"""
    struct Inner
        v: int
    struct Outer
        inner: &Inner
        replace(&self, x: &Inner)
            self.inner = x
        get(&self) -> int = self.inner.v
    mk(seed: int) -> int
        var o: &Outer = Outer(Inner(seed))
        o.replace(Inner(seed + 1))
        o.get()
    var i = 0
    var total = 0
    while i < 500000
        total += mk(i % 3)
        i++
    print(total)
    """, "999999\n")

// Every link of the chain is the one shared object, so the original and the result both read 3.
@test("a fluent &self method returns the receiver so calls chain on one object")
mrn_fluent_ref_self() = mrn_prints(raw"""
    struct Outer
        n: int
        bump(&self) -> &Outer
            self.n += 1
            self
    var o: &Outer = Outer(0)
    var p = o.bump().bump().bump()
    print(o.n, p.n)
    """, "3 3\n")

// Through a raw pointer, where the release of the old reference is easy to skip.
// total = sum of (i%3 + 10) over 500000 = 5499999.
@test("a *self method overwriting a &T field releases the old reference")
mrn_ptr_self_swaps_a_field() = mrn_prints(raw"""
    struct Inner
        v: int
    struct Outer
        inner: &Inner
        swap(*self, x: &Inner)
            self.inner = x
        get(*self) -> int = self.inner.v
    mk(seed: int) -> int
        var o = Outer(Inner(seed))
        o.swap(Inner(seed + 10))
        o.get()
    var i = 0
    var total = 0
    while i < 500000
        total += mk(i % 3)
        i++
    print(total)
    """, "5499999\n")

// The raw-pointer read of a `&T` field still retains it on return. total = 750000.
@test("a *self method returns a &T field that outlives the dropped receiver")
mrn_ptr_self_returns_a_field() = mrn_prints(raw"""
    struct Inner
        v: int
    struct Outer
        inner: &Inner
        peek(*self) -> &Inner = self.inner
    extract(seed: int) -> &Inner
        var o = Outer(Inner(seed))
        o.peek()
    var i = 0
    var total = 0
    while i < 500000
        var got = extract(i % 4)
        total += got.v
        i++
    print(total)
    """, "750000\n")

// -- built-in members and array elements --------------------------------------------------------------

@test("the built-in len property is unchanged by user members")
mrn_builtin_len() = mrn_prints("var a = [10, 20, 30]\nprint(a.len)\n", "3\n")

// A method called on an element of an array works on a copy of that element, and the array is
// untouched.
@test("a value receiver on an array element is a copy of the element")
mrn_value_receiver_on_an_element() = mrn_prints(raw"""
    struct Cell
        v: int

        bump(self) -> int
            self.v += 1
            self.v
        end bump
    var a: [2]Cell = [Cell(7); 2]
    print(a[0].bump(), a[0].v)
    """, "8 7\n")

@test("while a pointer receiver reaches the element itself")
mrn_pointer_receiver_on_an_element() = mrn_prints(raw"""
    struct Cell
        v: int

        bump(*self) -> int
            self.v += 1
            self.v
        end bump
    var a: [2]Cell = [Cell(7); 2]
    print(a[0].bump(), a[0].v, a[1].v)
    """, "8 8 7\n")
