module sysl.math.decimal
@tests

import sysl.math.bigint.{from_int as big_of, to_string as big_text}

// What `sysl.math.decimal` claims, asserted in sysl.
//
// **The rounding cases are the ones worth reading**, and they are written as a table of the same
// value under all six modes rather than as one case per mode. That is deliberate: what a reader
// needs is not that `Floor` rounds down but that `Floor` and `Down` differ, and they differ only on
// a negative value -- so the negative row is what makes the positive row mean anything.

private d(s: string) -> Decimal = parse(s).unwrap()

// -- the reason the type exists ---------------------------------------------------------------------

@test("a tenth and a fifth make three tenths, exactly")
tenths()
    // The whole argument for the module in one line: this is `0.30000000000000004` in binary
    // floating point, and every total built out of it is wrong by a little.
    assert_eq(to_string(add(d("0.1"), d("0.2"))), "0.3")
    assert_eq(add(d("0.1"), d("0.2")), d("0.3"))

@test("a hundred tenths make ten")
tenths_accumulate()
    var total = zero()

    for _ in 0..<100
        total = add(total, d("0.1"))

    assert_eq(total, from_int(10))
    assert_eq(to_string(total), "10.0")

// -- scales -----------------------------------------------------------------------------------------

@test("a sum takes the larger scale and a product the sum of them")
scales()
    assert_eq(add(d("1.5"), d("2.25")).scale(), 2)
    assert_eq(to_string(add(d("1.5"), d("2.25"))), "3.75")
    assert_eq(mul(d("1.50"), d("1.50")).scale(), 4)
    assert_eq(to_string(mul(d("1.50"), d("1.50"))), "2.2500")
    assert_eq(sub(d("1.5"), d("0.25")).scale(), 2)
    assert_eq(to_string(sub(d("1.5"), d("0.25"))), "1.25")

@test("the scale a value was written to is the scale it renders at")
scale_is_kept()
    // A price quoted to the cent is quoted to the cent whether or not the cent is zero, which is why
    // nothing here normalizes on the way through.
    assert_eq(to_string(d("12.340")), "12.340")
    assert_eq(to_string(d("1.50")), "1.50")
    assert_eq(to_string(d("1.5")), "1.5")
    assert_eq(d("12.340").scale(), 3)

@test("rescaling up is exact and rescaling down rounds")
rescaling()
    assert_eq(to_string(rescale(d("1.5"), 3, Rounding.HalfEven)), "1.500")
    assert_eq(to_string(rescale(d("1.2345"), 2, Rounding.HalfEven)), "1.23")
    assert_eq(to_string(rescale(d("1.2355"), 2, Rounding.HalfEven)), "1.24")
    assert_eq(rescale(d("1.5"), 1, Rounding.Down), d("1.5"))

@test("normalizing drops trailing zeros and leaves whole numbers alone")
normalizing()
    assert_eq(to_string(normalized(d("1.500"))), "1.5")
    assert_eq(to_string(normalized(d("150"))), "150")
    assert_eq(to_string(normalized(d("0.000"))), "0")
    assert_eq(normalized(d("1.500")), d("1.5"))

// -- comparison and hashing ---------------------------------------------------------------------------

@test("comparison ignores the scale, which is what makes the scale safe to keep")
comparison()
    assert_eq(d("1.50"), d("1.5"))
    assert_eq(cmp(d("1.50"), d("1.5")), 0)
    assert(d("1.5") < d("1.51"))
    assert(d("-1.5") < d("0"))
    assert(d("-1.50") < d("-1.4"))
    assert(cmp(d("2"), d("1.999")) > 0)

@test("values that compare equal hash alike, at whatever scale they were written")
hashing()
    // The obligation `Eq` puts on `Hash`, and the reason `Hash` is over the normalized form: without
    // it a map keyed on a price would miss whenever two rows quoted it to different places.
    assert_eq(d("1.50").hash(), d("1.5").hash())
    assert_eq(d("0.000").hash(), zero().hash())
    assert(d("1.5").hash() != d("1.6").hash())

// -- division and rounding ------------------------------------------------------------------------

@test("division to a scale, with the six modes on one value")
rounding_positive()
    // An eighth is `0.125`, so two places puts it exactly on the tie -- which is where the four
    // half-modes and the two directed ones separate.
    val a = from_int(1)
    val b = from_int(8)

    assert_eq(to_string(divide(a, b, 2, Rounding.Down)), "0.12")
    assert_eq(to_string(divide(a, b, 2, Rounding.Up)), "0.13")
    assert_eq(to_string(divide(a, b, 2, Rounding.Floor)), "0.12")
    assert_eq(to_string(divide(a, b, 2, Rounding.Ceiling)), "0.13")
    assert_eq(to_string(divide(a, b, 2, Rounding.HalfUp)), "0.13")

    // The tie goes to the even digit, which is what makes a long run of sums unbiased -- and it is
    // the one answer here that differs from what a schoolbook teaches.
    assert_eq(to_string(divide(a, b, 2, Rounding.HalfEven)), "0.12")

@test("the same six on a negative value, which is where Floor and Down separate")
rounding_negative()
    val a = from_int(-1)
    val b = from_int(8)

    assert_eq(to_string(divide(a, b, 2, Rounding.Down)), "-0.12")
    assert_eq(to_string(divide(a, b, 2, Rounding.Up)), "-0.13")

    // Toward negative infinity is *away* from zero here, and toward positive infinity is toward it
    // -- the reverse of the positive row above, which is the whole point of having both pairs.
    assert_eq(to_string(divide(a, b, 2, Rounding.Floor)), "-0.13")
    assert_eq(to_string(divide(a, b, 2, Rounding.Ceiling)), "-0.12")
    assert_eq(to_string(divide(a, b, 2, Rounding.HalfUp)), "-0.13")
    assert_eq(to_string(divide(a, b, 2, Rounding.HalfEven)), "-0.12")

@test("a tie the other way round goes up under HalfEven, because the digit below it is odd")
half_even_both_ways()
    // Three eighths is `0.375`: the tie is the same and the digit before it is odd, so the even
    // answer is the larger one. A rule that always rounded a tie down would pass the case above and
    // fail this one.
    assert_eq(to_string(divide(from_int(3), from_int(8), 2, Rounding.HalfEven)), "0.38")
    assert_eq(to_string(divide(from_int(1), from_int(8), 2, Rounding.HalfEven)), "0.12")
    assert_eq(to_string(divide(from_int(-3), from_int(8), 2, Rounding.HalfEven)), "-0.38")

@test("a division that does come out exactly is not rounded at all")
exact_division()
    assert_eq(to_string(divide(from_int(1), from_int(4), 2, Rounding.Up)), "0.25")
    assert_eq(to_string(divide(from_int(10), from_int(2), 0, Rounding.Up)), "5")
    assert_eq(to_string(divide(d("1.00"), d("4"), 4, Rounding.HalfEven)), "0.2500")

@test("a recurring quotient is taken to the scale asked for")
recurring()
    assert_eq(to_string(divide(from_int(1), from_int(3), 5, Rounding.HalfEven)), "0.33333")
    assert_eq(to_string(divide(from_int(2), from_int(3), 5, Rounding.HalfEven)), "0.66667")
    assert_eq(to_string(divide(from_int(2), from_int(3), 5, Rounding.Down)), "0.66666")

@test("the scales of the operands do not change the answer, only the arithmetic behind it")
division_scale_independence()
    // `1.00 / 8.000` and `1 / 8` are the same number, and the lift lands on a different side of the
    // fraction in each -- which is the branch in `divide` that a single-scale suite never exercises.
    val x = divide(d("1.00"), d("8.000"), 4, Rounding.HalfEven)
    val y = divide(from_int(1), from_int(8), 4, Rounding.HalfEven)

    assert_eq(x, y)
    assert_eq(to_string(x), "0.1250")

// -- text ------------------------------------------------------------------------------------------

@test("what was written comes back written the same way")
text_round_trip()
    for s in ["0", "1", "-1", "0.5", "-0.5", "12.340", "1.50", "0.005", "-0.005",
              "123456789012345678901234567890.123456789"]
        assert_eq(to_string(d(s)), s)

@test("a coefficient shorter than its scale is padded, with a zero before the point")
text_padding()
    assert_eq(to_string(of(big_of(5), 3)), "0.005")
    assert_eq(to_string(of(big_of(-5), 3)), "-0.005")
    assert_eq(to_string(of(big_of(0), 2)), "0.00")

@test("parsing takes a sign, a leading point and nothing else")
parse_shapes()
    assert_eq(to_string(d("+1.5")), "1.5")
    assert_eq(to_string(d(".5")), "0.5")
    assert_eq(d("-0"), zero())
    assert_eq(to_string(d("-0")), "0")

    assert(parse("").is_none())
    assert(parse("1.").is_none())
    assert(parse("1.2.3").is_none())
    assert(parse("1_000").is_none())
    assert(parse(" 1").is_none())
    assert(parse("1e-3").is_none())
    assert(parse("abc").is_none())

@test("the coefficient and the scale are what a database column stores")
parts()
    val x = d("12.340")

    assert_eq(big_text(x.coefficient()), "12340")
    assert_eq(x.scale(), 3)
    assert_eq(of(x.coefficient(), x.scale()), x)
    assert_eq(x.sign(), 1)
    assert_eq(d("-12.340").sign(), -1)
    assert(d("0.000").is_zero())
