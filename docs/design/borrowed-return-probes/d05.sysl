// A temporary inside the deferred statement's block and a reference moved out early (its last
// use): does the release happen at the last use or at the block's end? Under 0.6.0's inferred
// moves, a value handed off is not released by the block at all.
struct Noisy
    name: string

impl Drop for Noisy
    drop(self) = print("drop " + self.name)

keep(n: &Noisy) -> &Noisy = n

run()
    val a: &Noisy = Noisy("a")
    defer print("defer")
    val b: &Noisy = Noisy("b")
    val kept = keep(b)

    print("body " + a.name + kept.name)

run()
