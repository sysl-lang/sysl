module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.env.get as env_var
import sysl.seq.Sequence
import sysl.container.{Map, map, Set, set}
import sysl.fs.{entries, is_file, make_dir_all, metadata, read_bytes, read_text, remove_file, write_text,
                write_text_atomic}
import sysl.slices.sort_by
import sysl.text.{cstring, from_utf8_unchecked, join, split, str_builder, Search, StrBuilder}

// The executable `sysl run` and `sysl test` built last time, kept so that running the same tree
// twice costs the second one nothing.
//
// **The whole of a `run` or a `test` invocation's wall clock is the compile**, once the tree is any
// size at all: this compiler's own suite takes three quarters of an hour to build and a second and a
// half to run, and a reader who changed nothing between two invocations paid for both builds. The
// binary is what a cache can hold, because it is a function of things that can all be named.
//
// ==What the key is over, and why it is long==
//
// **A wrong key is a stale binary, which is worse than a slow build**, so this errs toward
// rebuilding: everything that can reach the bytes is in the key, and anything that cannot be
// established cheaply is a miss rather than a guess.
//
//   - the **compiler**, by version and by build (`compiler_identity`) -- an executable is compiled
//     code, so a release that changes what a program lowers to while touching none of its source
//     produces different bytes at an identical fingerprint. It is the same reason the standard
//     module's own artifact is keyed by it. The build is there for a development tree, which changes
//     the compiler under one version: keyed on the version alone, a fresh build or a stage two
//     replayed what an earlier build had cached for an identical tree.
//   - the **target**, the **allocating pair** and the **optimization** level, each of which changes
//     what is emitted, and the **`--cc`** a reader named, which is a different compiler.
//   - what the target **provides** -- the capabilities `package.hocon` leaves it -- which decides
//     whether the program is legal at all, and is read out of a file that is not source.
//   - every **source file the program is made of** -- its own tree's and every package's, the C
//     each of those trees carries among them -- by place and text.
//   - the **standard module** it is compiled against, by the fingerprint of the library it was read
//     from.
//   - the **environment that reaches the toolchain**: the extra clang flags and the variables naming
//     a cross toolchain. This is the only part of the key that is neither the command line nor the
//     tree, and leaving it out is the one omission that has actually cost something -- a run under
//     `SYSL_EXTRA_CFLAGS="-fsanitize=address"` over an unchanged tree replays the *uninstrumented*
//     binary the previous ordinary run left in the slot and reports green, which is a sanitizer
//     answering about a binary it never reached.
//
// **What is deliberately not in it: the program's own arguments, and `--filter`.** `sysl run p -- a`
// and `sysl run p -- b` are one binary run twice, which is the point; a filter selects among the
// tests a binary already holds, so it is applied to a cached list exactly as it is to a fresh one.
//
// ==What it does not cover, stated rather than hidden==
//
// An **`#include`d header** outside the trees this reads. `SYSL_NO_CACHE` is the escape hatch. (The
// C object cache beneath it does cover one: `c_object_cache.sysl` keys an object on every file clang
// read, so a `build` after that edit recompiles the file, but a `run` never gets that far.)
//
// **`sysl build` never consults this**, which is the reference's rule and not an omission here: a
// build writes a binary somebody named and is expected to have built it.

// The variable that turns the cache off -- for timing a compilation, or for anything that reaches the
// bytes and is outside what the key covers (an `#include`d header, above).
private const CacheOff: string = "SYSL_NO_CACHE"

// A directory a test keeps its entries in, in place of the machine's cache. Empty is none.
private var run_cache_home: string = ""

// Keep the cache's entries under `dir` rather than the machine's cache directory, or go back to the
// machine's with `None` -- so a test can seed and read a cache of its own without touching anybody
// else's entries.
use_run_cache_dir(dir: Option[string])
    run_cache_home = dir.unwrap_or("")
    run_cache_swept = false

// How many entries a program's cache holds before eviction is considered at all.
//
// The standard module's cache evicts nothing, which is right for it -- one entry per library per
// release. This one takes an entry per *edit*, so a week's work on one tree leaves hundreds. The C
// object cache (`c_object_cache.sysl`) evicts by the same two numbers, so both caches are one policy.
const CacheKeep: usize = 256

// How old an entry has to be before it is a candidate, in microseconds -- a week.
//
// **Age is what makes eviction safe beside a build that is running.** Several compilations share one
// directory, and a hit is a stat and then an exec: an eviction that took a *fresh* entry could take
// one another process was about to run. Nothing this old is in flight anywhere.
const CacheStale: long = 604800000000

// The most a cache directory holds, in bytes. Past it the oldest entries go, whatever `CacheKeep` and
// `CacheStale` say: age alone is no bound on a machine that builds all day, where one week came to
// 77,000 objects (41 GB) in the C object cache and 38 GB of binaries in this one.
const CacheBytes: long = 4294967296

// What the byte bound never takes, in microseconds -- anything written in the last hour, for the reason
// `CacheStale` gives. A directory filled faster than that sits over the bound until it ages.
const CacheFresh: long = 3600000000

// How long after one sweep of a directory another process's sweep of it is skipped, in microseconds --
// ten minutes. A sweep lists and stats the whole directory, so ten builds finishing together pay for
// one of them rather than ten.
const SweepGap: long = 600000000

// The two files a sweep keeps for itself, BESIDE the directory rather than in it, so that nothing
// listing the cache's entries sees them: when the last one ran, and a file written to read the
// filesystem's own clock.
private const SweepStamp: string = ".swept"
private const SweepClock: string = ".clock"

// The installed compiler's stand-in for `sysl.fs.set_modified`, which sets a time to now where it is
// given none: this compiler is built by the installed release, whose library cannot yet set a time.
// It is replaced by `set_modified` once a release that ships it is installed.
private extern "utimes" c_utimes(path: *u8, times: *u8) -> int

// What this process has already marked as used, so each file is touched once however often it is hit.
private var touched: Set[string] = set()

// Mark a cache file as used now -- its modification time is what every sweep reads as its age, so an
// entry that is used stays among the newest however long ago it was made, and a sweep removes the
// least recently used first. Once per file per process, one `utimes`; a file that is not there, or a
// filesystem that will not take a time, costs the entry nothing but its age.
touch_used(file: string)
    if touched.has(file) then return

    touched.add(file)

    val name = cstring(file)

    c_utimes(name.ptr, null)
    ()
end touch_used

// Forget what was touched, as a new process would have.
forget_touched()
    touched = set()

// A bound a test holds a directory to in place of `CacheBytes`. Zero is none.
private var cache_bound_override: long = 0

// Hold every cache directory to `bytes` rather than `CacheBytes`, or go back with `None`.
use_cache_bound(bytes: Option[long])
    cache_bound_override = bytes.unwrap_or(0)

cache_bound() -> long = if cache_bound_override > 0 then cache_bound_override else CacheBytes

// Whether a sweep of `dir` is due, claiming it where it is: none has run there in the last `SweepGap`,
// by the directory's own clock rather than this machine's -- a file written now says what now is.
claim_sweep(dir: string) -> bool
    val clock = s"$dir$SweepClock"

    write_text(clock, "now") match
        Err(_) -> return false
        Ok(_) -> ()

    val now = cache_modified_at(clock)
    val stamp = s"$dir$SweepStamp"
    val last = cache_modified_at(stamp)

    if last != 0 && now >= last && now - last < SweepGap then return false

    write_text(stamp, "swept").is_ok()
end claim_sweep

// One file of a cache directory as a sweep reads it -- one `stat` each.
struct CacheFile
    file: string
    modified: long
    size: long

// Every file in `dir`, or nothing where the directory cannot be listed.
cache_files(dir: string) -> Option[Buf[CacheFile]]
    val names = entries(dir) match
        Ok(n) -> n
        Err(_) -> return None

    var out: Buf[CacheFile] = buf()

    for n in names
        val one = s"$dir/$n"

        metadata(one) match
            Ok(m) -> out.push(CacheFile(one, m.modified.us, m.size))
            Err(_) -> ()

    Some(out)
end cache_files

// The oldest of `files` removed until what is left fits in the bound, sparing what `spared` names and
// anything younger than `CacheFresh`; an entry's `partner` (its `.sum`, its `.tests`) goes with it.
// `gone` already holds what an earlier pass removed, and gains what this one does.
trim_to_bound(files: Buf[CacheFile], gone: *Set[string], spared: string -> bool, partner: string)
    var total: long = 0
    var now: long = 0
    var sizes: Map[string, long] = map()

    for f in files
        sizes.put(f.file, f.size)

        if !gone.has(f.file) then total += f.size
        if f.modified > now then now = f.modified

    val bound = cache_bound()

    if total <= bound then return

    var oldest: Buf[CacheFile] = buf()

    for f in files
        if !gone.has(f.file) then oldest.push(f)

    sort_by(oldest.view(), (a, b) -> a.modified < b.modified)

    for f in oldest
        if total <= bound then return
        if gone.has(f.file) || spared(f.file) || now - f.modified < CacheFresh then continue

        remove_file(f.file).unwrap_or(())
        gone.add(f.file)
        total -= f.size

        val other = s"${f.file}$partner"

        sizes.get(other) match
            Some(n) ->
                if !gone.has(other) && !spared(other)
                    remove_file(other).unwrap_or(())
                    gone.add(other)
                    total -= n
            None -> ()
end trim_to_bound

// The field separator inside the test list, which is the one character a `@test`'s display name
// cannot hold: a name is read out of source, and a NUL does not survive the lexer.
private const Nul: string = "\0"

// How many separators a well-formed line of the test list has: seven fields for the test, three for
// each of the four hooks, two for why it is ignored, and one for its own timeout (empty where it has
// none). A line written before a field existed is short of it, and reads as no cache rather than as a
// suite where nothing was ignored or bounded.
private const Marks: usize = 21

// --- the key --------------------------------------------------------------------------

// Everything above, mixed in a fixed order.
//
// The order is fixed rather than sorted because a key is not compared with anything but itself --
// what it has to be is *the same* for the same inputs, and the sorting that matters is inside
// `library_fingerprint`, which is over a set of files that may arrive in any order.
run_cache_key(parts: Buf[string]) -> string
    var numbered: Buf[(string, string)] = buf()

    for i in 0..<parts.len()
        numbered.push((s"$i", parts.at(i)))

    library_fingerprint(numbered)
end run_cache_key

// The parts themselves, for one command over one tree at one machine.
//
// **It is asked before anything is analyzed**, which is the whole of what the cache buys: everything
// here is settled by the command line and by files on disk, and the compile below it is the
// expensive half. A cache consulted after the analysis would have saved the linker's second and paid
// the analyzer's nine minutes.
run_cache_parts(command: string, path: string, t: Target, level: string,
                cc: Option[string]) -> Result[Buf[string], Refusal]
    var parts: Buf[string] = buf()

    parts.push(command)
    toolchain_parts(&parts, t, level, cc)?

    // **Where the tree stands is part of what reaches the bytes**, so it is in the key beside what
    // the files hold. A tree is walked from an absolute root and that root is what `__FILE__`, every
    // test's record and every diagnostic's anchor carry -- two copies of one tree at two paths
    // compile to two different binaries. Keyed on the contents alone, the second copy is handed the
    // first's binary and reports a directory the reader is not standing in.
    parts.push(absolute_path(path))
    parts.push(program_fingerprint(path, t)?)
    settings_parts(&parts, path)

    Ok(parts)
end run_cache_parts

// The parts of a key that are about the compiler and the machine rather than any tree: which build of
// the compiler, for which target, through which heap, at which level, with which C compiler, what the
// target provides and which standard module. Shared by every cache keyed over a build
// (`root_artifact.sysl` too), so the two cannot disagree about what reaches the bytes.
toolchain_parts(parts: *Buf[string], t: Target, level: string,
                cc: Option[string]) -> Result[unit, Refusal]
    // A build this machine will not name is every build of this version at once, which is the stale
    // key this part exists to remove -- so it is a miss rather than a guess.
    if !compiler_build_known() then return Err(Refusal("this compiler cannot say which build it is"))

    parts.push(compiler_identity())
    parts.push(t.name)
    parts.push(allocator_pair())
    parts.push(level)
    parts.push(cc.unwrap_or(""))
    parts.push(provided_part(t))

    val library = std_root() match
        Err(why) -> return Err(Refusal(why))
        Ok(dir) -> dir

    val std = std_fingerprint(library, t) match
        Err(why) -> return Err(Refusal(why))
        Ok(got) -> got

    parts.push(s"source:$std")

    // A library compiled into the binary rather than linked from an artifact is different bytes.
    if std_from_source() then parts.push("std:from-source")

    Ok(())
end toolchain_parts

// The parts of a key that are the build's settings rather than a file: the environment a build reads,
// the flags naming headers, libraries and macros, the feature request, the link mode, what is asked of
// LLVM beyond the level, and whether a bounds trap names its place. `path` is the project, whose
// manifest says the link mode.
settings_parts(parts: *Buf[string], path: string)
    parts.push(build_environment())

    // **Where a command line said the headers and libraries are reaches the bytes**, and is the one
    // input to a build that is neither a file nor an environment variable. A suite run against one
    // SDK and then against another is two binaries; a key that left the flags out would replay the
    // first, which is the sanitizer-flag defect one flag along.
    val given = supplied_cflags()

    for item in given
        parts.push(item)

    val where = link_search_flags()

    for item in where
        parts.push(item)

    // **Which features are on decides which lines reach the compiler**, so the request is part of the
    // key beside the manifests that declare them (`program_fingerprint`): one tree built under two
    // requests is two programs, from byte-identical source.
    parts.push(feature_request_part())

    // **Which libraries come from their archives is a different binary**, so changing `link` or
    // `--link` over a tree that did not otherwise move relinks rather than replaying the other kind.
    parts.push(s"link:${link_spelling(link_mode_for(path))}")

    // **And what the build asks of LLVM beyond the level** -- `--lto` or the manifest's `lto`, a
    // profile written or read (`pipeline_key`). A binary linked with link-time optimization, one
    // instrumented to count, and one laid out around a profile are three binaries of one tree, and a
    // profile is keyed by its bytes, so a profile merged again over the same path rebuilds.
    parts.push(s"pipeline:${pipeline_key()}")

    // **Whether failed bounds checks name their locations is a different binary** too; the default
    // adds nothing, so every key made before the choice existed still matches.
    if !bounds_locations() then parts.push("bounds_locations:false")

    // **So is whether failures record the error return trace**, on the same terms.
    if !error_traces() then parts.push("error_traces:false")
    // **How long an evaluation while compiling may run decides whether the tree compiles at all**, so
    // a limit given outright is part of the key; the default adds nothing.
    const_steps_flag() match
        Some(n) -> parts.push(s"const_steps:$n")
        None -> ()
    // **What the code may use of the machine** (`codegen_features.sysl`); nothing when nothing is set.
    if codegen_features_key() != "" then parts.push(s"codegen:${codegen_features_key()}")
end settings_parts

// What the machine provides, as the manifest declared it: sorted, so the part is one string for one
// set however the file ordered it or whichever block said it.
//
// **None of it is a source file, and it decides whether the program is legal at all** -- a tree built
// while `posix` stood and replayed after the config took it away would skip the refusal the analysis
// owes, and run a binary the project has just said this machine cannot have.
private provided_part(t: Target) -> string
    var given: Buf[string] = buf()

    for i in 0..<CoreCapabilities.len
        if !t.lacks_capability(CoreCapabilities[i]) then given.push(CoreCapabilities[i])

    s"provides:${join(sort_names(given).view(), ",")}"
end provided_part

// The key for one command over one tree, or nothing where it cannot be established.
//
// **A tree that will not read is a miss rather than a refusal**, and deliberately: whatever is wrong
// with it is about to be reported by the compilation this was asked in front of, in the words that
// compilation has for it. A cache has no business being the thing that names it.
run_cache_key_of(command: string, path: string, t: Target, level: string,
                 cc: Option[string]) -> Option[string] =
    run_cache_parts(command, path, t, level, cc) match
        Ok(parts) -> Some(run_cache_key(parts))
        Err(_) -> None

// Every file the program is made of, reduced to its place in the tree it came from and its text.
//
// The tree's **index** rather than its path is what a place is keyed under, so that a package fetched
// into one machine's cache and another's hash the same. Order is the order the graph resolved them
// in, which is a function of the manifests.
private program_fingerprint(path: string, t: Target) -> Result[string, Refusal]
    var files: Buf[(string, string)] = buf()
    var trees: Buf[string] = buf()

    trees.push(path)

    val root = if is_directory(path) then path else parent_of(path).unwrap_or(".")

    // A manifest that will not read is not a refusal here, for the same reason the C walk does not
    // treat it as one: whatever needed it has already said so.
    //
    // **A source root is one of the trees, and where it is goes in beside what it holds.** A root is
    // walked from an absolute path exactly as the project is, and that path is what `__FILE__` and
    // every test's record carry out of its files -- so the same root at another path is another
    // binary, which is the reason the project's own path is in the key.
    manifest_at(root) match
        Ok(m) ->
            val roots = handed_trees(root, m)

            for i in 0..<roots.len()
                trees.push(roots.at(i).dir)

                // A path dependency and a workspace member are the same case: a directory of the
                // reader's own rather than a fetch's, so where it is reaches the binary.
                if !roots.at(i).fetched
                    files.push((s"${i + 1}/", absolute_path(roots.at(i).dir)))
        Err(_) -> ()

    for i in 0..<trees.len()
        val found = collect(trees.at(i), Some(t.os)) match
            Err(e) -> return Err(Refusal(e.message))
            Ok(f) -> f

        // A tree's `features` block, because it decides which of the files' lines are compiled at all
        // -- an edit to it alone changes the program. **What it declares goes in, not how the file
        // spelled it**: the rest of the manifest reaches the key as what it means (what the target
        // provides, where the trees are), so a reordered block is the same program.
        val tree_root = if i == 0 then root else trees.at(i)

        // Its `name` and `version` too, which `__NAME__` and `__VERSION__` fold into the program as
        // literals -- and the manifest is not one of the files hashed below, so without them a
        // renamed package in an unchanged tree replayed a binary still printing the old name.
        manifest_at(tree_root) match
            Ok(m) ->
                if !m.features.is_empty() then files.push((s"$i/features", features_part(m.features)))
                if !m.name.is_empty() then files.push((s"$i/name", m.name))
                if !m.version.is_empty() then files.push((s"$i/version", m.version))

                // What the tree's C is compiled with (`defines`, `c`), and each vendored library's
                // files with every header under the roots it reads -- an upstream tree's headers sit
                // where nothing else here hashes them, and a configuration is as much the program as
                // a file is.
                val configured = c_block_text(m)

                if !configured.is_empty() then files.push((s"$i/c", configured))

                val vendored = c_library_inputs(tree_root, m)

                for item in vendored
                    files.push((s"$i/c/${item.0}", item.1))
            Err(_) -> ()

        for item in found
            files.push((s"$i/${found_place(item)}",
                        from_utf8_unchecked(item.src.bytes)))

            // Each file an `embed` or a `.incbin` in it reads, by its bytes (`embed.sysl`): they are
            // compiled into the program as surely as the source that names them.
            for input in embedded_inputs(item.src.name, item.src.bytes)
                files.push(input)

        // The C beside the sysl, on the same terms: a binding is a sysl surface over C, so an edit to
        // one of its `.c` files changes what the program links against and must miss.
        val carried = c_sources(trees.at(i), Some(t.os)) match
            Err(e) -> return Err(Refusal(e.message))
            Ok(cs) -> cs

        for item in carried
            // C is bytes, not text: a Latin-1 byte in a comment is still a file to hash.
            val bytes = read_bytes(item) match
                Err(e) -> return Err(Refusal(s"cannot read ${io_refusal(item, e)}"))
                Ok(got) -> got

            files.push((s"$i/${relative_to(trees.at(i), item)}", from_utf8_unchecked(bytes.view())))

    Ok(library_fingerprint(files))
end program_fingerprint

// A `features` block as what it declares: each feature and what it turns on, one to a line.
private features_part(features: Buf[(string, Buf[string])]) -> string
    var out = str_builder()

    for item in features
        out.push(item.0)
        out.push(" = [")
        out.push(join(item.1.view(), ", "))
        out.push("]\n")

    out.finish()
end features_part

// A file's place: the module directories it was found under, then its own name.
private found_place(found: Found) -> string
    var out = ""

    for item in found.dir
        out = out + item + "/"

    out + basename(found.src.name)
end found_place

// Every environment variable that can change the bytes a build produces, as `NAME=value` for the
// ones that are set.
//
// **`SYSL_LIB` is deliberately absent, and leaving it out is the more correct answer rather than an
// omission.** It names where the library source *is*, and the key already carries that library's
// fingerprint -- its contents. Adding the path would make two identical trees at two paths miss each
// other's entry for no gain. `SYSL_NO_CACHE` is absent for a different reason: it turns the cache off
// rather than selecting an entry in it.
build_environment() -> string
    val names: []const string = ["SYSL_EXTRA_CFLAGS", "WASI_SDK_PATH", "ANDROID_NDK_ROOT",
                                 "ANDROID_NDK_HOME", "ANDROID_HOME", "ANDROID_SDK_ROOT",
                                 "SYSL_COUNT_ALLOCS"]

    join(names.filter((n) -> env_var(n).is_some()).map((n) -> s"$n=${env_var(n).unwrap()}"), " ")
end build_environment

// --- the slot -------------------------------------------------------------------------

// Where a built program is kept, or nothing where this machine has no cache directory -- the same
// condition the standard module's own path falls back on, and the same answer: behave as though there
// were no cache.
private run_cache_slot(key: string) -> Option[string]
    if env_var(CacheOff).unwrap_or("") != "" then return None
    if run_cache_home != "" then return Some(s"$run_cache_home/sysl/run/$key")

    cache_directory() match
        Some(dir) -> Some(s"$dir/sysl/run/$key")
        None -> None
end run_cache_slot

// The program built for this key, where one is there and is still executable.
run_cache_hit(key: string) -> Option[string]
    val path = run_cache_slot(key) match
        Some(p) -> p
        None -> return None

    if !is_file(path) || !is_executable(path) then return None

    // A hit is a use: the entry and its test list are as young as this run.
    touch_used(path)
    touch_used(s"$path.tests")
    Some(path)
end run_cache_hit

// Where to link, for a build that is about to happen: a path in the cache with the directory already
// made, or nothing where there is no cache to write into.
//
// **The build links beside the slot and renames onto it** (`link_into_cache`), rather than into the
// slot itself -- another run may be starting the binary already there -- or into a temporary copied
// afterwards, which would have to reproduce the executable bit. A rename keeps the linker's mode.
run_cache_reserve(key: string) -> Option[string]
    val path = run_cache_slot(key) match
        Some(p) -> p
        None -> return None

    val dir = parent_of(path) match
        Some(d) -> d
        None -> return None

    make_dir_all(dir) match
        Err(_) -> return None
        Ok(_) -> ()

    sweep_run_cache(path)
    Some(path)
end run_cache_reserve

// The test list beside a cached test binary, which is the one thing `sysl test` needs that the
// executable does not carry: what to call, what to report it as, whether it should trap and what it
// should have printed on its way out.
//
// A sidecar rather than a second cache, so the two cannot come apart -- the binary is written first,
// and a hit needs both.
run_cache_tests(key: string) -> Option[string] = run_cache_slot(key) match
    Some(path) -> Some(s"$path.tests")
    None -> None

// The list written beside the binary. A write that fails is not a failure of the build: the worst it
// costs is the next run's compile.
//
// **Published, never written in place**: a list read half-written decodes, at a line boundary, to a
// shorter list, and a suite reporting fewer tests than it has is a silent failure.
write_test_list(key: string, tests: Buf[TTest])
    run_cache_tests(key) match
        Some(path) -> write_text_atomic(path, encode_test_list(tests)).unwrap_or(())
        None -> ()

// The list read back, or nothing where there is none or it will not read -- which is a rebuild.
read_test_list(key: string) -> Option[Buf[TTest]] = run_cache_tests(key) match
    Some(path) -> if is_file(path) then decode_from(path) else None
    None -> None

// A cached test build: the binary and what to call in it.
//
// **A hit is both or neither.** The executable does not carry what to report a test as, whether it
// should trap or what it should have printed, so a binary with no list beside it is a rebuild.
cached_test_build(key: Option[string]) -> Option[(string, Buf[TTest])]
    val one = key match
        Some(found) -> found
        None -> return None

    val exe = run_cache_hit(one) match
        Some(built) -> built
        None -> return None

    read_test_list(one) match
        Some(list) -> Some((exe, list))
        None -> None
end cached_test_build

private decode_from(path: string) -> Option[Buf[TTest]] = read_text(path) match
    Ok(text) -> decode_test_list(text)
    Err(_) -> None

// Whether a path names something this machine would run.
private is_executable(path: string) -> bool = metadata(path) match
    Ok(m) -> (m.mode & 0x49) != 0
    Err(_) -> false

// Whether this process has swept the run cache. **One sweep per process**, and none where another
// process swept the directory in the last `SweepGap` -- a sweep stats every entry.
private var run_cache_swept: bool = false

// How many sweeps this process has made of the run cache, for a test to count.
private var run_cache_sweeps: int = 0

run_cache_sweep_count() -> int = run_cache_sweeps

// The sweep, where one is due: `evict_around` once per process, beside the entry being reserved.
private sweep_run_cache(fresh: string)
    if run_cache_swept then return

    run_cache_swept = true

    val dir = parent_of(fresh) match
        Some(d) -> d
        None -> return

    if claim_sweep(dir) then evict_around(dir, fresh)
end sweep_run_cache

// Entries past `CacheKeep` that are also older than `CacheStale`, removed; then the oldest, until the
// directory fits in `CacheBytes`. The entry being reserved and its test list are never taken.
//
// A failure here is not a failure of the build: the worst an unevicted cache costs is disk, and the
// worst a failed eviction costs is nothing at all. `now` is read from the newest entry rather than
// from a clock, so a machine whose clock has moved evicts nothing rather than everything.
private evict_around(dir: string, fresh: string)
    run_cache_sweeps += 1

    val files = cache_files(dir) match
        Some(f) -> f
        None -> return

    val spared = (one: string) -> one == fresh || one == s"$fresh.tests"
    var gone: Set[string] = set()
    var now: long = 0

    for f in files
        if f.modified > now then now = f.modified

    if files.len() >= CacheKeep
        for f in files
            if !spared(f.file) && now - f.modified > CacheStale
                remove_file(f.file).unwrap_or(())
                gone.add(f.file)

    trim_to_bound(files, &gone, spared, ".tests")
end evict_around

// When a path was last written, in microseconds, or zero where it cannot be asked -- which evicts
// nothing, since zero is older than every threshold read against the newest entry.
cache_modified_at(path: string) -> long = metadata(path) match
    Ok(m) -> m.modified.us
    Err(_) -> 0

// --- the test list --------------------------------------------------------------------

// One line per test, with a NUL between the fields. Three flat fields per hook rather than one packed
// one, because the separator is already spoken for and a second one would be a second character a
// name must not hold.
encode_test_list(tests: Buf[TTest]) -> string
    var b = str_builder()

    for i in 0..<tests.len()
        val t = tests.at(i)

        if i > 0 then b.push("\n")

        b.push(t.func)
        b.push(Nul)
        b.push(t.display)
        b.push(Nul)
        b.push(if t.should_trap then "true" else "false")
        b.push(Nul)
        b.push(t.expected.unwrap_or(""))
        b.push(Nul)
        b.push(if t.expected.is_some() then "1" else "0")
        b.push(Nul)
        b.push(t.file)
        b.push(Nul)
        b.push(s"${t.line}")

        push_hook(&b, t.hooks.setup)
        push_hook(&b, t.hooks.teardown)
        push_hook(&b, t.hooks.setup_all)
        push_hook(&b, t.hooks.teardown_all)

        b.push(Nul)
        b.push(t.ignored.unwrap_or(""))
        b.push(Nul)
        b.push(if t.ignored.is_some() then "1" else "0")
        b.push(Nul)

        t.timeout match
            Some(n) -> b.push(s"$n")
            None -> ()

    b.finish()
end encode_test_list

private push_hook(b: *StrBuilder, hook: Option[THook])
    b.push(Nul)

    hook match
        Some(h) ->
            b.push(h.func)
            b.push(Nul)
            b.push(h.file)
            b.push(Nul)
            b.push(s"${h.line}")
        None ->
            b.push("")
            b.push(Nul)
            b.push("")
            b.push(Nul)
            b.push("")
end push_hook

// The list read back, or nothing where a line will not read -- which is treated as no cache at all.
decode_test_list(text: string) -> Option[Buf[TTest]]
    var out: Buf[TTest] = buf()

    for line in split(text, "\n")
        if line == "" then continue

        val f = split(line, Nul)

        if f.len != Marks + 1 then return None

        val expected = if f[4] == "1" then Some(f[3]) else None
        val ignored = if f[20] == "1" then Some(f[19]) else None
        val timeout = if f[21] == "" then None else Some(read_line_number(f[21]))

        out.push(TTest(f[0], f[1], f[2] == "true", expected, f[5], read_line_number(f[6]),
                       THooks(hook_from(Setup, f, 7), hook_from(Teardown, f, 10),
                              hook_from(SetupAll, f, 13), hook_from(TeardownAll, f, 16)),
                       ignored, timeout))

    Some(out)
end decode_test_list

private hook_from(kind: HookKind, f: []string, at: usize) -> Option[THook] =
    if f[at] == "" then None else Some(THook(kind, f[at], f[at + 1], read_line_number(f[at + 2])))

// A line number written by `encode_test_list` and read back. A field that is not digits is a zero
// rather than a refusal: what a caller does with the list is print it, and the sidecar is written by
// this file alone.
private read_line_number(text: string) -> int
    var n = 0

    for i in 0..<text.bytes.len
        val c = text.bytes[i]

        if c >= u8('0') && c <= u8('9') then n = n * 10 + int(c - u8('0'))

    n
end read_line_number
