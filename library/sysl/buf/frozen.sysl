module sysl.buf

import sysl.index_past
import sysl.raw.ptr_cast

/** A buffer that will never change again.
 *
 * `Buf.freeze()` makes one: it takes the buffer's elements and answers a `&Frozen[T]`, one count on
 * the whole buffer, of any element type. **Where the position expects a `&sync Frozen[T]`** -- an
 * annotation, a parameter or a field -- the box is allocated with an atomic count instead, as a
 * construction's is. A `&sync` object may hold that one, and a `&sync Fn` may capture it, so
 * read-only heap data -- decoded pixels, a list of shapes -- is read by every thread at once with no
 * lock and no count per element (`reference/memory.md § A frozen buffer crosses`). The two are
 * distinct types, and neither converts to the other.
 *
 * **Nothing writes it.** There is no `push`, no `set`, no subscript assignment and no writable view;
 * what it has is `len`, `f[i]`, `for x in f` and `view()`, a `[]const T`.
 *
 * **A shared frozen buffer shares exactly what its elements share**, so a `&sync Frozen[T]` is
 * formed only where a `&sync T` could hold a `T`: scalars, `&sync U`, raw pointers, other shared
 * frozen buffers, and the structs and arrays built of them. The compiler asks that of the type
 * argument where the reference is formed, as it asks a struct's fields.
 *
 * **Its fields carry no count**, and that is what makes the shared form safe to read from every
 * thread: the storage is owned through a count that is not atomic, held here as the bare words of the
 * slice that owns it, so copying the struct -- as a `(self)` member does -- takes no share of
 * anything. In the shared form only the destructor touches that count, once, run by whichever thread
 * lets go of the box's last share.
 */
struct Frozen[T]
    private owner: usize
    private data: *T
    private n: usize

    const len(self) -> usize = self.n

    const is_empty(self) -> bool = self.n == 0

    /** The element at `i`, or `None` where there is none -- `i` at or past the length, or negative.
     * The total form of `f[i]`, which traps as an array's index does; `i` may be any integer type.
     */
    const get[I: Integer](self, i: I) -> Option[T]
        if i < 0 || u128(i) >= u128(self.n) then return None

        Some(self.data[usize(i)])

    /** The elements as a read-only slice, which keeps them alive however long it is kept. A view of a
     * `&Frozen[T]` holds a share of the storage itself, and allocates nothing.
     *
     * A view of a `&sync Frozen[T]` is taken in one thread while others read the same storage, so it
     * keeps the frozen buffer alive through a box of its own instead, made then and counted the
     * ordinary way: the box holds one atomic share of the buffer and gives it back when the last copy
     * of the slice goes. That box is the one allocation such a view costs; `f[i]` and `for` cost none.
     */
    const view(&self) -> []const T
        if self.n == 0 then return []

        // Reading the words out as a slice takes a share of the storage they name, which is the
        // count only this domain touches.
        var words: [3]usize = [self.owner, usize(self.data), self.n]
        val shaped: *[]const T = ptr_cast(&words[0])

        *shaped
    end view

    /** `view()` called on a `&sync Frozen[T]`, which is the call the compiler makes there in its
     * place: the storage's own count is not atomic, so the view holds the buffer through a box.
     */
    private[buf] const view_shared(&sync self) -> []const T
        if self.n == 0 then return []

        var pin: &FrozenPin[T] = FrozenPin(self)
        val box: *usize = ptr_cast(&pin)
        var words: [3]usize = [*box, usize(self.data), self.n]
        val shaped: *[]const T = ptr_cast(&words[0])

        *shaped
    end view_shared
end Frozen

/** The storage given back: the slice the words describe is rebuilt in a local, without a share being
 * taken, and the local going out of scope is the one release the storage gets -- which lets go of every
 * element it holds.
 */
impl[T] Drop for Frozen[T]
    drop(self)
        if self.owner == 0 then return

        var items: []T = []
        val raw: *[3]usize = ptr_cast(&items)

        *raw = [self.owner, usize(self.data), self.n]
    end drop

/** What a view of a frozen buffer is owned by: an ordinary box holding one share of the buffer. Its
 * own count is touched only by the thread holding the view, and letting go of it gives the share back
 * atomically.
 */
private[buf] struct FrozenPin[T]
    held: &sync Frozen[T]

impl[T] Index[usize, T] for Frozen[T]
    @track_caller
    const index(self, i: usize) -> T
        if i >= self.n then index_past(i, self.n)

        self.data[i]

/** `for x in f` walks the elements by index through a cursor holding one share of the buffer, so the
 * walk allocates nothing.
 */
impl[T] Walk for Frozen[T]
    type Walker = FrozenWalk[T]
    const walk(self) -> FrozenWalk[T] = FrozenWalk(self.data, self.n, 0)

/** The cursor a `for` over a frozen buffer walks: the storage's address and length, read while the
 * frozen buffer the `for` was handed keeps it alive.
 */
struct FrozenWalk[T]
    private data: *T
    private n: usize
    private i: usize

impl[T] Iterate for FrozenWalk[T]
    type Item = T

    const next(*self) -> Option[T]
        if self.i >= self.n then return None

        val v = self.data[self.i]

        self.i += 1
        Some(v)
    end next

/** A frozen buffer renders as the sequence it holds, as a `Buf` does. */
impl[T: Display] Display for Frozen[T]
    display(self, out: *Writer, fmt: FormatSpec)
        val shown: []const T = if self.n == 0 then [] else frozen_span(self.data, self.n)

        shown.display(out, fmt)

/** A frozen buffer shows as the sequence it holds, as a `Buf` does. */
impl[T: Debug] Debug for Frozen[T]
    debug(self, out: *Writer, fmt: FormatSpec)
        val shown: []const T = if self.n == 0 then [] else frozen_span(self.data, self.n)

        shown.debug(out, fmt)

/** The elements at `data` as a view with no owner, for a reader that finishes before the buffer can
 * go -- rendering one.
 */
private frozen_span[T](data: *T, n: usize) -> []const T
    var words: [3]usize = [0, usize(data), n]
    val shaped: *[]const T = ptr_cast(&words[0])

    *shaped
end frozen_span

/** `Buf.freeze()`, answering the frozen buffer with an ordinary count. */
private[buf] freeze_buf[T](b: Buf[T]) -> &Frozen[T]
    val (owner, data, n) = taken_storage(b)

    Frozen(owner, data, n)

/** `Buf.freeze()` where a `&sync Frozen[T]` is expected, answering it with an atomic count. */
private[buf] freeze_buf_shared[T](b: Buf[T]) -> &sync Frozen[T]
    val (owner, data, n) = taken_storage(b)

    Frozen(owner, data, n)

/** The buffer's elements, taken: copied once into storage of their own, sized to them, and the
 * buffer left empty -- for this name and every other name of the same buffer, which is what makes the
 * result immutable. A view taken of the buffer earlier still reads the old storage, which the frozen
 * one shares nothing with. The answer is the storage's owner word, its first element and the count;
 * the one share of the storage is the owner word's, for the frozen buffer to hold.
 */
private taken_storage[T](b: Buf[T]) -> (usize, *T, usize)
    val n = b.len()

    if n == 0 then return (0, null, 0)

    var items: []T = slot_storage(n)

    for i in 0..<n
        slot_place(items, i, b[i])

    b.clear()

    // The storage's one share moves from the local into the words: they are read out, and the local
    // is left naming nothing by a store that releases nothing.
    val data: *T = &items[0]
    val raw: *[3]usize = ptr_cast(&items)
    val owner = (*raw)[0]

    *raw = [0, 0, 0]
    (owner, data, n)
end taken_storage
