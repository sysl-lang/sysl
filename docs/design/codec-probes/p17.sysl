// P17: a format answering a compile-time question (keyed or positional) that a generic body settles
trait Format
    keyed() -> bool

struct Json
end Json

struct Compact
end Compact

impl Format for Json
    const keyed() -> bool = true

impl Format for Compact
    const keyed() -> bool = false

shape[F: Format]() -> string
    if const F.keyed()
        "keys"
    else
        "positions"

print(shape[Json](), shape[Compact]())
