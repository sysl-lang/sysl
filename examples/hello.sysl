// A first sysl program. Run it with:
//   ./run-example.sh
// or directly:
//   sbt "syslJVM/run run examples/hello.sysl"

print("Hello, sysl!")

var width = 6
var height = 7
print("area =", width * height)

// A function: an expression body after `=`, or an indented block.
add(a: int, b: int) -> int = a + b
print("3 + 4 =", add(3, 4))

// Sum the numbers 1 through 10 with a for loop.
var sum = 0
for i in 1..10 do sum = sum + i
print("sum 1..10 =", sum)

// `if` is an expression — it yields the value of the taken branch.
print(sum, "is", if sum % 2 == 0 then "even" else "odd")

// A value struct: positional construction and field access. An optional `end` marker names
// the declaration it closes.
struct Point
    x: int
    y: int
end Point

var p = Point(width, height)
print("point:", p.x, p.y)

// `match` picks an arm by literal, `|`-alternative, range, or a guarded wildcard.
size(n: int) -> string
    n match
        0 -> "empty"
        1 | 2 | 3 -> "small"
        4..99 -> "medium"
        else "large"

print("55 is", size(sum))

// A data enum: a tagged union. Construct with a variant name, destructure it in a `match`.
enum Shape
    Circle(radius: int)
    Rect(w: int, h: int)
    Empty
end Shape

area(s: Shape) -> int
    s match
        Circle(r) -> r * r * 3
        Rect(w, h) -> w * h
        Empty -> 0
end area

print("areas:", area(Circle(5)), area(Rect(3, 4)), area(Empty))

// Generics are monomorphized: each set of type arguments gets its own copy.
struct Box[T]
    value: T
end Box

first[A, B](a: A, b: B) -> A = a

var boxed = Box("wrapped")
print("box:", boxed.value, first(1, "ignored"))

// `Option` and `Result` come from `sysl`, the standard module a file may name without importing it
// — they are just generic enums. `?` unwraps a success and returns early with the failure otherwise.
half(n: int) -> Result[int, string]
    if n % 2 == 0 then Ok(n / 2) else Err("odd")
end half

quarter(n: int) -> Result[int, string]
    var h = half(n)?
    half(h)
end quarter

describe(r: Result[int, string]) -> string
    r match
        Ok(v) -> "ok"
        Err(e) -> e
end describe

print("quarter:", describe(quarter(20)), describe(quarter(6)), describe(quarter(7)))

// Every scalar width is its own type: arithmetic wraps where the type says it does, and
// nothing widens on its own. An unsuffixed literal takes the type around it.
var small: byte = 200
print("byte:", small + 100, small >> 3)

var total: u64 = 18446744073709551615
print("u64 max:", total)

// Conversions are always written, with call syntax.
print("convert:", int(3.9), f32(7) / f32(2), u32('A'))

// A char is a Unicode scalar value — ordered, printable, and never arithmetic.
var letter = 'é'
print("char:", letter, 'a' <= letter, char(9731))

// A raw pointer `*T` is C's pointer: `&x` takes an address, `*p` reads or writes through one.
// It is the one unsafe mode, so it is spelled with a sigil you can grep for.
bump(n: *int)
    *n += 1

var counter = 41
bump(&counter)
print("counter:", counter)

// A pointer field is what lets a type reach itself, and selecting through one needs no `->`.
struct Node
    value: int
    next: *Node
end Node

var third = Node(3, null)
var second = Node(2, &third)
var first_node = Node(1, &second)

var walk = &first_node
var chain = 0
while walk != null do
    chain += walk.value
    walk = walk.next

print("chain:", chain)

// A reference `&T` is the safe way to reach the heap. There is no allocation keyword: writing
// the ordinary construction where a `&T` is expected is what puts the object there, and the
// compiler counts the references for you, freeing the object when the last one goes away.
struct Account
    owner: string
    balance: int
end Account

deposit(a: &Account, amount: int)
    a.balance += amount

var shared: &Account = Account("ada", 100)
var alias = shared
deposit(alias, 40)
print("balance:", shared.balance, shared == alias)

// A reference is never null, so a link that may be absent is an `Option`. That is what lets a
// list be built out of references and taken apart again with a `match`.
struct Item
    label: string
    rest: Option[&Item]
end Item

count(list: Option[&Item]) -> int
    list match
        Some(item) -> 1 + count(item.rest)
        None -> 0
end count

var last: &Item = Item("c", None)
var middle: &Item = Item("b", Some(last))
var items: &Item = Item("a", Some(middle))
print("items:", count(Some(items)), items.label)

// An array `[N]T` is its elements: it has no header, it copies when you assign it, and its
// length is part of its type. A declaration with a type and no value starts at zero.
var primes = [2, 3, 5, 7]
var counts: [4]int

for i in 0..<primes.len do counts[i] = primes[i] * 2
print("primes:", primes.len, primes[0], counts[3])

// An array prints as itself, at whatever length it is: one library block covers every one of
// them, because a length may be a parameter — `impl[const N: usize, T: Display] Display for [N]T`.
print("arrays:", primes, counts)

// Every subscript is checked against the length, so an index that does not name an element
// stops the program instead of reading past the end.
var prime_sum = 0
for p in primes do prime_sum += p
print("total:", prime_sum)

// A slice `[]T` views elements it does not own, and keeps them alive while it does. Writing
// the buffer as `&[N]T` puts it on the heap, which is what the view then holds a share of.
var buf: &[8]u8 = [1, 2, 3, 4, 5, 6, 7, 8]

sum_bytes(bytes: []u8) -> int
    var t = 0
    for b in bytes do t += int(b)
    t
end sum_bytes

// The range operators keep the meanings they have everywhere else, and either end may be
// left off. A view of a view is relative to the view.
print("slices:", sum_bytes(buf[..]), sum_bytes(buf[0..<3]), sum_bytes(buf[0..3]), sum_bytes(buf[6..]))

// A view writes through to the buffer, which is what makes "fill this for me" work.
fill(bytes: []u8, v: u8)
    for i in 0..<bytes.len do bytes[i] = v

fill(buf[2..<4], 0)
print("filled:", buf[1], buf[2], buf[3], buf[4])

// A scratch buffer needs no heap at all: an array this frame owns can be sliced, and the
// compiler works out on its own that no view of it outlives the frame. Try returning
// `scratch[..]` from here and it will say so.
scratch_sum() -> int
    var scratch: [4]u8
    fill(scratch[..], 3)
    sum_bytes(scratch[1..<3])
end scratch_sum

print("scratch:", scratch_sum())

// A `string` is an immutable view of bytes that are always well-formed UTF-8 — the same three
// words a slice is, so a substring shares its parent's bytes instead of copying them. A length
// is in bytes, and a literal's bytes are never freed, so holding one costs nothing.
var greeting = "héllo, world"

print("string:", greeting.len, greeting[7..], greeting == "héllo, world")

// Cutting between characters is checked the same way an index is: `greeting[0..<2]` would stop
// the program, because it would end in the middle of the é.
print("cut:", greeting[0..<1], greeting[1..<3], greeting < "world")

// Bytes and characters are both there, and which one is meant is written rather than guessed.
var bytes = 0
for b in greeting.bytes do bytes += 1

print("bytes:", bytes, greeting[0])

// A type carries its behaviour alongside its data. A member with a `self` receiver is a method;
// the sigil on `self` says how it takes the instance, exactly as any parameter does. `self` by
// value gets a copy for a read; `*self` gets a raw pointer, so the method may write a value the
// caller holds on the stack; `&self` gets the shared heap object.
struct Vec2
    x: int
    y: int

    // A read that does not touch the original takes `self` by value.
    sum(self) -> int = self.x + self.y

    // `*self` is a raw pointer to the instance, so the shifts land in the caller's value.
    shift(*self, dx: int, dy: int)
        self.x += dx
        self.y += dy

    // A property has no parameter list, so it reads with no parentheses — like a field, but
    // computed. The convention is that a property is cheap; anything that allocates is a method.
    magnitude -> int = self.sum() * self.sum()

    // An associated function has no `self` and is called through the type name — the home for a
    // named constructor that the positional `Vec2(x, y)` does not cover.
    diagonal(n: int) -> Vec2 = Vec2(n, n)
end Vec2

var here = Vec2(3, 4)
here.shift(10, 20)
print("methods:", here.sum(), here.magnitude, Vec2.diagonal(5).sum())
