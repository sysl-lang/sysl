module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// What one line of a body may be: a binding, a jump, a contract clause, a loop, inline assembly,
// or a declaration -- and, where it is none of those, an expression written for its effect.
//
// **A declaration is a statement**, so the dispatch below runs over both: at the top of a file the
// two are one thing, and which a line turned out to be is the analyzer's question. What the
// declaration *contains* is `parse_decl.sysl`'s.
//
// **The loops are expressions**, which is what makes `val x = while ...` an ordinary binding rather
// than a special case. They are read here rather than in `parse_expr.sysl` because a loop's body is
// a statement list and its `else` clause is one too, so the whole form is statement-shaped whatever
// position it stands in.

// The name a `for` over a pattern binds, which no program can write.
const ElemName: string = "$elem"

// -- the loops -----------------------------------------------------------------------------------

// A loop word met where an expression may begin. The word has already been taken.
parse_loop_word(p: *Parser, at: Span, w: string) -> Expr
    if w == "while" then return parse_while_expr(p, at, None)
    if w == "loop" then return parse_loop_expr(p, at, None)
    if w == "do" then return parse_do_while_expr(p, at, None)

    parse_for_expr(p, at, None)
end parse_loop_word

// `'outer for ...` -- the label a loop carries, written immediately before its own word.
//
// **A label belongs to a loop and to nothing else**, so a label followed by anything but one of the
// four words is refused here rather than read as a value: there is no other form it could open.
parse_labelled_loop(p: *Parser, at: Span, name: string) -> Expr
    val label = Some(name)

    if p.accept_kw("while") then return parse_while_expr(p, at, label)
    if p.accept_kw("loop") then return parse_loop_expr(p, at, label)
    if p.accept_kw("do") then return parse_do_while_expr(p, at, label)
    if p.accept_kw("for") then return parse_for_expr(p, at, label)

    p.want("'for'")
    expr(at, Bad)
end parse_labelled_loop

// The `else` a loop runs when it finished on its own rather than through a `break`. It is the same
// clause `if` takes, which is why it may sit on the line after the body.
private parse_loop_else(p: *Parser) -> Option[Buf[Stmt]]
    if !accept_on_next_line_kw(p, "else") then return None

    Some(if p.block_ahead() then parse_suite(p) else parse_inline_body(p))
end parse_loop_else

private parse_while_expr(p: *Parser, at: Span, label: Option[string]) -> Expr
    val cond = parse_expr(p)
    val body = parse_body(p, "do")
    val otherwise = parse_loop_else(p)

    accept_end_marker(p, "while")
    expr(at.to(p.just_taken()), While(label, cond, body, otherwise))
end parse_while_expr

private parse_loop_expr(p: *Parser, at: Span, label: Option[string]) -> Expr
    val body = parse_body(p, "do")

    accept_end_marker(p, "loop")
    expr(at.to(p.just_taken()), Loop(label, body))
end parse_loop_expr

// `do body while cond` -- the post-test loop.
//
// There is no `end do`: the tail already names where the body stopped, and a marker after it would
// close a block that has just been closed.
private parse_do_while_expr(p: *Parser, at: Span, label: Option[string]) -> Expr
    val body = if p.block_ahead() then parse_suite(p) else parse_inline_body(p)

    p.skip_newlines()

    if !p.expect_kw("while") then return expr(at.to(p.just_taken()), Bad)

    val cond = parse_expr(p)
    val otherwise = parse_loop_else(p)

    expr(at.to(p.just_taken()), DoWhile(label, body, cond, otherwise))
end parse_do_while_expr

// Which of the three `for` headers is written here.
private enum ForHeader
    // `for init; cond; step`
    CStyle

    // `for k, v in xs` -- read so that it can be refused with the form that works.
    CommaNames

    // `for x in xs`, and the pattern spelling of it.
    Plain
end ForHeader

// Which one, decided by looking down the header for the token that settles it.
//
// **A `;` at bracket depth zero is the three-clause loop and a `,` there is the comma spelling**,
// and whichever comes first before the `in` decides. The scan cannot run off the line: a newline
// inside brackets is not a token, so the first `Newline` is the end of the header.
private for_header(p: *Parser) -> ForHeader
    var i: usize = 0
    var depth: usize = 0

    loop
        p.peek_at(i) match
            Eof -> break
            Newline -> break
            Indent -> break
            Dedent -> break
            Keyword(w) ->
                if w == "(" || w == "[" || w == "{"
                    depth += 1
                elif w == ")" || w == "]" || w == "}"
                    if depth == 0 then break

                    depth -= 1
                elif depth == 0
                    if w == ";" then return CStyle
                    if w == "," then return CommaNames
                    if w == "in" then break
                    if w == "do" then break
            _ -> ()

        i += 1

    Plain
end for_header

private parse_for_expr(p: *Parser, at: Span, label: Option[string]) -> Expr
    if p.at_kw("const") then return parse_const_for(p, at)
    if at_quantifier(p) then return parse_quantifier(p, at)

    for_header(p) match
        CStyle -> parse_c_for(p, at, label)
        CommaNames -> refuse_comma_names(p, at)
        Plain -> parse_for_in(p, at, label)
end parse_for_expr

// `for all i in 0..<n do P(i)`, `for some k in r do Q(k)`.
//
// **`all` and `some` stay ordinary identifiers.** Telling the form from a counted loop takes one
// token: a quantifier is `for` `all`/`some` `name` `in`, and a loop is `for` `name` `in` -- so
// `for all in 0..<n do ...` is still a loop over a variable called `all`.
private at_quantifier(p: *Parser) -> bool
    if !p.at_word("all") && !p.at_word("some") then return false

    p.peek_at(1) match
        Ident(_) -> p.kw_at(2, "in")
        QuotedIdent(_) -> p.kw_at(2, "in")
        _ -> false
end at_quantifier

private parse_quantifier(p: *Parser, at: Span) -> Expr
    val universal = p.at_word("all")

    p.bump()

    val name = p.name() match
        Some(n) -> n
        None -> ""

    p.expect_kw("in")

    val iter = parse_expr(p)

    p.expect_kw("do")

    val pred = parse_expr(p)

    expr(at.to(p.just_taken()), Quantifier(universal, name, iter, pred))
end parse_quantifier

// `for const i in 0..<A.len` -- the loop the compiler unrolls.
//
// There is no label and no `else`, because there is no loop at run time for a `break` to leave or
// for an `else` to follow.
private parse_const_for(p: *Parser, at: Span) -> Expr
    p.bump()

    val name = p.name() match
        Some(n) -> n
        None -> ""

    p.expect_kw("in")

    val iter = parse_expr(p)
    val body = parse_body(p, "do")

    accept_end_marker(p, "for")
    expr(at.to(p.just_taken()), ConstFor(name, iter, body))
end parse_const_for

private parse_c_for(p: *Parser, at: Span, label: Option[string]) -> Expr
    var init: Option[Stmt] = None
    var cond: Option[Expr] = None
    var step: Option[Stmt] = None

    if !p.at_kw(";") then init = Some(parse_for_clause(p))

    p.expect_kw(";")

    if !p.at_kw(";") then cond = Some(parse_expr(p))

    p.expect_kw(";")

    if !p.at_kw("do") && !p.block_ahead() then step = Some(parse_for_clause(p))

    val body = parse_body(p, "do")
    val otherwise = parse_loop_else(p)

    accept_end_marker(p, "for")
    expr(at.to(p.just_taken()), CFor(label, init, cond, step, body, otherwise))
end parse_c_for

// One clause of a three-clause header: a `var`, an assignment to several places, or the expression
// that advances the loop.
private parse_for_clause(p: *Parser) -> Stmt
    val start = p.here()

    if p.at_kw("var") then return parse_var_decl(p, start, Public)

    parse_expr_or_multi(p, start, true)
end parse_for_clause

private parse_for_in(p: *Parser, at: Span, label: Option[string]) -> Expr
    val binder = p.here()
    var name = ""
    var pat: Option[Pattern] = None

    if at_destructuring(p)
        pat = Some(parse_pattern(p))
    else
        p.name() match
            Some(n) -> name = n
            None -> ()

    p.expect_kw("in")

    val iter = parse_expr(p)
    var body = parse_body(p, "do")
    val otherwise = parse_loop_else(p)

    accept_end_marker(p, "for")

    // **A pattern is desugared into the binding the reader would otherwise have written.** The loop
    // names a temporary no program can write, and the body opens with the pattern bound to it -- so
    // `For` binds a name, which is what every later pass already reads.
    pat match
        Some(destructured) ->
            var whole: Buf[Stmt] = buf()

            whole.push(stmt(binder, PatternDecl(destructured, true,
                expr(binder, Ident(ElemName)))))

            for i in 0..<body.len()
                whole.push(body.at(i))

            body = whole
            name = ElemName
        None -> ()

    expr(at.to(p.just_taken()), For(label, name, iter, body, otherwise))
end parse_for_in

private refuse_comma_names(p: *Parser, at: Span) -> Expr
    var names: Buf[string] = buf()

    loop
        p.name() match
            Some(n) -> names.push(n)
            None -> break

        if !p.accept_kw(",") then break

    var written = ""

    for i in 0..<names.len()
        if i > 0 then written = written + ", "

        written = written + names.at(i)

    p.fault(at, s"a 'for' names one thing, and a pattern is what takes it apart — write 'for (${written}) in …'")
    expr(at.to(p.just_taken()), Bad)
end refuse_comma_names

// Whether a binding here is a pattern rather than a plain name: a tuple, a struct or a variant
// pattern, or any of those named with `n @`. Every one of them needs a `(`, a `{` or an `@` where a
// plain name has its `in` or its `=`, so a name never reaches the pattern path.
at_destructuring(p: *Parser) -> bool
    if p.at_kw("(") then return true

    p.peek() match
        Ident(_) -> p.kw_at(1, "{") || p.kw_at(1, "(") || p.kw_at(1, "@")
        QuotedIdent(_) -> p.kw_at(1, "{") || p.kw_at(1, "(") || p.kw_at(1, "@")
        _ -> false
end at_destructuring

// -- one statement --------------------------------------------------------------------------------

// How tightly a multi-assignment's targets are read: above assignment, so that the `=` after the
// last of them is the one the whole list takes rather than one target's own.
private const TargetPower: u8 = 6

// Whether a token can begin a statement.
//
// **What it is for is the difference between two complaints**, not for deciding what to parse: a
// token that begins nothing is an expression that is missing at the top level of a file, and a
// block that should have closed inside one.
can_begin_stmt(t: Tok) -> bool
    if can_begin_expr(t) then return true

    t match
        Keyword(w) -> begins_stmt_word(w)
        _ -> false
end can_begin_stmt

private begins_stmt_word(w: string) -> bool
    for word in ["var", "val", "ref", "const", "static", "struct", "enum", "trait", "impl",
                 "override", "extern", "import", "private", "type", "return", "break", "continue",
                 "defer", "require", "ensure", "@", "#"]
        if word == w then return true

    false
end begins_stmt_word

// One statement.
parse_stmt(p: *Parser) -> Stmt = parse_stmt_at(p, false)

// The same, saying whether it was written on the line of the word that introduced it.
parse_stmt_at(p: *Parser, inline: bool) -> Stmt
    val start = p.here()

    if p.at_kw("@") then return parse_at_stmt(p, start)
    if p.at_kw("#") then return refuse_hash(p, start)
    if p.at_kw("import") then return parse_import_decl(p, start)
    if p.at_kw("impl") then return parse_impl_decl(p, start, false)
    if p.at_kw("override") then return parse_override_stmt(p, start)

    var vis = Public
    val marked = p.at_kw("private")

    if marked then vis = parse_visibility(p)

    if marked && p.at_kw("impl")
        p.fault(start, "an 'impl' block carries no visibility of its own — it declares no name for it to restrict, and what it supplies is reached at the reach of the trait that asked for it")
        skip_line(p)
        return stmt(start.to(p.just_taken()), Bad)
    end if

    parse_decl_or_stmt(p, start, vis, marked, inline)
end parse_stmt_at

private parse_decl_or_stmt(p: *Parser, start: Span, vis: Visibility, marked: bool,
                           inline: bool) -> Stmt
    if p.at_kw("static") then return parse_static_decl(p, start, vis)
    if p.at_kw("val") then return parse_val_decl(p, start, vis)
    if p.at_kw("var") then return parse_var_decl(p, start, vis)
    if p.at_kw("const") then return parse_const_decl(p, start, vis)
    if p.at_kw("ref") then return parse_ref_decl(p, start)
    if p.at_kw("struct") then return parse_struct_decl(p, start, vis, false)
    if p.at_kw("enum") then return parse_enum_decl(p, start, vis)
    if p.at_kw("trait") then return parse_trait_decl(p, start, vis)
    if p.at_kw("type") then return parse_type_decl(p, start, vis)
    if p.at_kw("extern") then return parse_extern_decl(p, start, vis, buf())
    if p.at_word("opaque") && p.kw_at(1, "struct") then return parse_opaque_struct(p, start, vis)
    if p.at_word("c") && p.kw_at(1, "const") then return parse_c_const_block(p, start, vis)
    if p.at_word("c") && p.kw_at(1, "type") then return parse_c_type_block(p, start, vis)

    // A function is told from a call by its parameter list and its body, which takes a probe: both
    // begin with a name and a bracket, and what separates them is several tokens along.
    try_func_decl(p, start, vis, no_attrs()) match
        Some(d) -> return d
        None -> ()

    if marked
        p.want("declaration")
        skip_line(p)
        return stmt(start.to(p.just_taken()), Bad)
    end if

    if p.at_kw("return") then return parse_return(p, start)
    if p.at_kw("break") then return parse_break(p, start)
    if p.at_kw("continue") then return parse_continue(p, start)
    if p.at_kw("defer") then return parse_defer(p, start)
    if p.at_kw("require") then return parse_contract(p, start, "require")
    if p.at_kw("ensure") then return parse_contract(p, start, "ensure")

    if p.at_word("invariant") && can_begin_expr(p.peek_at(1))
        return parse_contract(p, start, "invariant")

    if p.at_word("variant") && can_begin_expr(p.peek_at(1)) then return parse_variant(p, start)
    if at_become(p) then return parse_become(p, start)
    if !inline && at_asm(p) then return parse_asm(p, start)

    parse_expr_or_multi(p, start, inline)
end parse_decl_or_stmt

// `#` where a declaration stands. It is kept a token so that a reader who wrote one is told which
// sigil an annotation takes rather than that the character is unknown.
private refuse_hash(p: *Parser, start: Span) -> Stmt
    p.bump()

    val name = p.name() match
        Some(n) -> n
        None -> ""

    p.fault(start, s"an annotation is written '@${name}' — '#' opens a directive, which gates lines before the lexer sees them and sits at the margin")
    skip_line(p)
    stmt(start.to(p.just_taken()), Bad)
end refuse_hash

// `override` in front of a declaration of its own, refused where it stands: the word has a place,
// and a reader who writes it elsewhere is better served by being told which.
private parse_override_stmt(p: *Parser, start: Span) -> Stmt
    if p.kw_at(1, "impl")
        p.bump()
        return parse_impl_decl(p, start, true)
    end if

    p.bump()
    p.fault(start, "'override' marks something that replaces an implementation already covering the same type, so it goes in front of an 'impl' block or of a member inside one — a declaration of its own replaces nothing")
    skip_line(p)
    stmt(start.to(p.just_taken()), Bad)
end parse_override_stmt

// `private`, `private[M]`, or nothing at all -- which is public. There is no `pub` keyword; its
// absence *is* public, so the unmarked case is the one that writes nothing.
parse_visibility(p: *Parser) -> Visibility
    if !p.accept_kw("private") then return Public
    if !p.accept_kw("[") then return File

    val name = p.name() match
        Some(n) -> n
        None -> ""

    p.expect_kw("]")
    Scoped(name)
end parse_visibility

// -- the bindings ----------------------------------------------------------------------------------

// What a binding's `=` takes: one expression, or an indented block whose trailing expression is the
// value.
//
// **A block of a single expression is that expression.** The two are the same value written two
// ways, and collapsing here is what keeps a module `val` whose value moved to the next line a
// constant tree rather than a computed initializer.
parse_initializer(p: *Parser) -> Expr
    if !p.block_ahead() then return parse_expr(p)

    val at = p.here()
    val body = parse_suite(p)

    if body.is_empty() then return expr(at, UnitLit)

    if body.len() == 1
        *body.at(0).kind match
            ExprStmt(e) -> return e
            _ -> ()

    expr(body.at(0).span.to(p.just_taken()), Block(body))
end parse_initializer

// Whether what follows a binding's keyword is a comma list of names.
private at_multi_names(p: *Parser) -> bool
    p.peek() match
        Ident(_) -> p.kw_at(1, ",")
        QuotedIdent(_) -> p.kw_at(1, ",")
        _ -> false
end at_multi_names

private parse_val_decl(p: *Parser, start: Span, vis: Visibility) -> Stmt
    p.bump()

    if at_destructuring(p) then return parse_pattern_decl(p, start, false)
    if at_multi_names(p) then return parse_multi_decl(p, start, false)

    val name = parse_bound_name(p)
    var typ: Option[TypeRef] = None

    if p.accept_kw(":") then typ = Some(parse_type(p))

    p.expect_kw("=")

    val value = lift_placeholders(parse_initializer(p))

    stmt(start.to(p.just_taken()), ValDecl(name, typ, value, vis, None, None))
end parse_val_decl

parse_var_decl(p: *Parser, start: Span, vis: Visibility) -> Stmt
    p.bump()

    if at_destructuring(p) then return parse_pattern_decl(p, start, true)
    if at_multi_names(p) then return parse_multi_decl(p, start, true)

    val name = parse_bound_name(p)
    var typ: Option[TypeRef] = None
    var init: Option[Expr] = None

    if p.accept_kw(":") then typ = Some(parse_type(p))
    if p.accept_kw("=") then init = Some(lift_placeholders(parse_initializer(p)))

    stmt(start.to(p.just_taken()), VarDecl(name, typ, init, vis, None, None))
end parse_var_decl

// `const NAME: T = value`. **Both halves are mandatory**, which is what tells it apart from a `var`
// at a glance as well as to the parser: a constant with no value declares nothing, and a type left
// off would be the one declaration whose interface could not be read off its syntax.
private parse_const_decl(p: *Parser, start: Span, vis: Visibility) -> Stmt
    p.bump()

    val name = parse_bound_name(p)

    p.expect_kw(":")

    val typ = parse_type(p)

    p.expect_kw("=")

    val value = lift_placeholders(parse_initializer(p))

    stmt(start.to(p.just_taken()), ConstDecl(name, typ, value, vis))
end parse_const_decl

// `ref name = place` -- another name for storage that already exists. There is no type annotation
// and no multiple form, and each absence is a rule rather than an omission.
private parse_ref_decl(p: *Parser, start: Span) -> Stmt
    p.bump()

    val name = parse_bound_name(p)

    p.expect_kw("=")

    val place = lift_placeholders(parse_expr(p))

    stmt(start.to(p.just_taken()), RefDecl(name, place))
end parse_ref_decl

// `static val`, `static var` -- a binding in the file the program starts in asking to be the
// module's rather than that file's body's.
private parse_static_decl(p: *Parser, start: Span, vis: Visibility) -> Stmt
    p.bump()

    if !p.at_kw("val") && !p.at_kw("var")
        p.fault(start, "'static' marks a 'val' or a 'var' in the file a program starts in, saying it belongs to the module rather than to that file's body. Everything else there is the module's already: a type, a constant, an 'extern' and an 'import' are wherever they are written, and a function is one unless it reads a binding of the body — which is a frame to carry, and the one thing a module member cannot have")
        skip_line(p)
        return stmt(start.to(p.just_taken()), Bad)
    end if

    val at = p.here()
    val binds_once = p.at_kw("val")
    var inner = stmt(at, Bad)

    if binds_once then inner = parse_val_decl(p, at, vis) else inner = parse_var_decl(p, at, vis)

    stmt(start.to(p.just_taken()), StaticDecl(inner))
end parse_static_decl

private parse_multi_decl(p: *Parser, start: Span, mutable: bool) -> Stmt
    var names: Buf[string] = buf()

    loop
        p.name() match
            Some(n) -> names.push(n)
            None -> break

        if !p.accept_kw(",") then break

    p.expect_kw("=")

    var values: Buf[Expr] = buf()

    loop
        values.push(lift_placeholders(parse_expr(p)))

        if !p.accept_kw(",") then break

    stmt(start.to(p.just_taken()), MultiDecl(names, mutable, values))
end parse_multi_decl

private parse_pattern_decl(p: *Parser, start: Span, mutable: bool) -> Stmt
    val pat = parse_pattern(p)

    p.expect_kw("=")

    val value = lift_placeholders(parse_initializer(p))

    stmt(start.to(p.just_taken()), PatternDecl(pat, mutable, value))
end parse_pattern_decl

// A name a binding gives, which may be written in backticks like any other.
parse_bound_name(p: *Parser) -> string = p.name() match
    Some(n) -> n
    None -> ""

// -- the jumps ------------------------------------------------------------------------------------

// What a function hands back: one expression, or the several its result list declares.
private parse_result_value(p: *Parser) -> Expr
    val start = p.here()
    var values: Buf[Expr] = buf()

    loop
        values.push(lift_placeholders(parse_expr(p)))

        if !p.accept_kw(",") then break

    if values.len() == 1 then return values.at(0)

    expr(start.to(p.just_taken()), ResultList(values))
end parse_result_value

private parse_return(p: *Parser, start: Span) -> Stmt
    p.bump()

    var value: Option[Expr] = None

    if begins_expr_here(p) then value = Some(parse_result_value(p))

    stmt(start.to(p.just_taken()), Return(value))
end parse_return

// Whether an expression begins at the cursor, asked where the token after it can be looked at.
//
// **A label begins one only when a loop follows it**, which is the whole difference from
// `can_begin_expr`: without it `break 'a 'b` reads the second label as the value the break carries
// and is answered with a complaint about a `for` nobody was writing.
begins_expr_here(p: *Parser) -> bool = p.peek() match
    Label(_) -> p.kw_at(1, "for") || p.kw_at(1, "while") || p.kw_at(1, "loop") || p.kw_at(1, "do")
    t -> can_begin_expr(t)

// A `'name` label, as written after `break` and `continue`.
private accept_label(p: *Parser) -> Option[string] = p.peek() match
    Label(n) ->
        p.bump()
        Some(n)
    _ -> None

private parse_break(p: *Parser, start: Span) -> Stmt
    p.bump()

    val label = accept_label(p)
    var value: Option[Expr] = None

    if begins_expr_here(p) then value = Some(lift_placeholders(parse_expr(p)))

    stmt(start.to(p.just_taken()), Break(label, value))
end parse_break

private parse_continue(p: *Parser, start: Span) -> Stmt
    p.bump()
    stmt(start.to(p.just_taken()), Continue(accept_label(p)))
end parse_continue

// `defer stmt` -- what to run on the way out of this block, however it leaves.
//
// What follows is an inline statement, so the whole form is one line: the deferred thing is a
// release, and a release that needs a block of its own is a function worth naming.
private parse_defer(p: *Parser, start: Span) -> Stmt
    p.bump()
    stmt(start.to(p.just_taken()), Defer(parse_stmt_at(p, true)))
end parse_defer

// `become f(x)` -- a call that replaces this frame rather than adding to it.
//
// **A soft word rather than a reserved one**, so `become` goes on being a legal identifier
// everywhere else. The lookahead is what makes that true: without it `become = 1`, an assignment to
// an ordinary variable of that name, would be a parse error about a call.
private at_become(p: *Parser) -> bool
    if !p.at_word("become") then return false

    p.peek_at(1) match
        Ident(_) -> true
        QuotedIdent(_) -> true
        Keyword(w) -> w == "("
        _ -> false
end at_become

private parse_become(p: *Parser, start: Span) -> Stmt
    p.bump()

    val call = parse_expr(p)

    *call.kind match
        Call(_, _) -> ()
        _ -> p.fault(call.span, "'become' takes a call — it is the call that replaces this frame, so there has to be one. 'return' is what hands a value back without replacing anything")

    stmt(start.to(p.just_taken()), Become(call))
end parse_become

// -- the contract clauses --------------------------------------------------------------------------

// `require c`, `ensure c`, `invariant c`, each with the message a failure carries.
//
// **`invariant` and `variant` are contextual**, matched as soft words, which costs what `is` and
// `not` already pay: a bare statement calling a function of the same name reads as a clause.
private parse_contract(p: *Parser, start: Span, word: string) -> Stmt
    p.bump()

    val cond = parse_expr(p)
    var message: Option[string] = None

    if p.accept_kw(",") then message = accept_string(p)

    val at = start.to(p.just_taken())

    if word == "require" then return stmt(at, Require(cond, message))
    if word == "ensure" then return stmt(at, Ensure(cond, message))

    stmt(at, Invariant(cond, message))
end parse_contract

private parse_variant(p: *Parser, start: Span) -> Stmt
    p.bump()
    stmt(start.to(p.just_taken()), Variant(parse_expr(p)))
end parse_variant

// A string literal standing where one is required.
accept_string(p: *Parser) -> Option[string]
    p.peek() match
        StrLit(v) ->
            p.bump()
            Some(v)
        _ ->
            p.want("string literal")
            None
end accept_string

// -- inline assembly -------------------------------------------------------------------------------

// **What commits the form is the indented arm list**, which a bare mention of a variable named
// `asm` does not have -- so the fall-through to an expression statement is exact rather than a
// matter of ordering.
private at_asm(p: *Parser) -> bool = p.at_word("asm") && p.peek_at(1) == Newline &&
    p.peek_at(2) == Indent

private parse_asm(p: *Parser, start: Span) -> Stmt
    p.bump()

    var arms: Buf[AsmArm] = buf()

    if !p.accept(Newline) || !p.accept(Indent)
        p.want("indent")
        return stmt(start.to(p.just_taken()), AsmStmt(arms))
    end if

    p.skip_newlines()

    loop
        if p.at(Dedent) || p.at(Eof) then break

        arms.push(parse_asm_arm(p))
        p.skip_newlines()

    if !p.accept(Dedent) then p.want("dedent")

    stmt(start.to(p.just_taken()), AsmStmt(arms))
end parse_asm

// `[x86_64, aarch64]` and what answers for them. The architecture names are not checked here -- the
// grammar has no idea which processors exist, and a name outside the set is a diagnostic about a
// target rather than a parse error about a token.
private parse_asm_arm(p: *Parser) -> AsmArm
    val start = p.here()
    var archs: Buf[string] = buf()

    p.expect_kw("[")

    loop
        p.name() match
            Some(n) -> archs.push(n)
            None -> break

        if !p.accept_kw(",") then break

    p.expect_kw("]")
    AsmArm(start.to(p.just_taken()), archs, parse_asm_body(p))
end parse_asm_arm

// The four things an arm may be: no answer, one instruction inline, an indented block, or nothing
// at all -- the architecture on which the operation costs no instruction.
private parse_asm_body(p: *Parser) -> AsmBody
    if p.at_word("unavailable")
        p.bump()

        return AsmUnavailable(accept_string(p) match
            Some(v) -> v
            None -> "")
    end if

    p.peek() match
        StrLit(v) ->
            p.bump()

            var one: Buf[string] = buf()

            one.push(v)
            return AsmCode(one, buf(), buf())
        _ -> ()

    var lines: Buf[string] = buf()
    var operands: Buf[AsmOperand] = buf()
    var clobbers: Buf[string] = buf()

    if !p.block_ahead() then return AsmCode(lines, operands, clobbers)

    p.bump()
    p.bump()
    p.skip_newlines()

    loop
        if p.at(Dedent) || p.at(Eof) then break

        parse_asm_item(p, &lines, &operands, &clobbers)
        p.skip_newlines()

    if !p.accept(Dedent) then p.want("dedent")

    AsmCode(lines, operands, clobbers)
end parse_asm_body

// A line inside an arm: an instruction, an operand, or what the arm destroys. They are collected by
// kind rather than kept in order, because only the instructions have an order that matters.
private parse_asm_item(p: *Parser, lines: *Buf[string], operands: *Buf[AsmOperand],
                       clobbers: *Buf[string])
    p.peek() match
        StrLit(v) ->
            p.bump()
            lines.push(v)
        _ ->
            if p.at_word("clobbers")
                p.bump()

                loop
                    accept_string(p) match
                        Some(v) -> clobbers.push(v)
                        None -> break

                    if !p.accept_kw(",") then break
            else
                operands.push(parse_asm_operand(p))
end parse_asm_item

// `in name : reg` / `out name : "dx"`.
//
// The class slot is required although `reg` is the only class there is, so that every operand line
// has one shape and a second class arrives as a peer rather than as the exception to a default. Its
// `:` is not a type annotation, so what follows is a class or a machine register and never a type.
private parse_asm_operand(p: *Parser) -> AsmOperand
    val start = p.here()
    var dir = In

    if p.accept_kw("in") then dir = In
    elif p.accept_word("out") then dir = Out
    else p.want("'in'")

    val name = parse_bound_name(p)

    p.expect_kw(":")

    var reg: Option[string] = None

    if !p.accept_word("reg") then reg = accept_string(p)

    AsmOperand(start.to(p.just_taken()), dir, name, reg)
end parse_asm_operand

// -- the expression statements ----------------------------------------------------------------------

// An expression written for its effect, the several places a comma list assigns to, and the result
// list a function's trailing line may be.
//
// A statement-level expression is the outermost of the three places a placeholder closes at.
private parse_expr_or_multi(p: *Parser, start: Span, inline: bool) -> Stmt
    val first = parse_expr(p)

    if !p.at_kw(",")
        return stmt(start.to(p.just_taken()), ExprStmt(lift_placeholders(first)))

    // Every target after the first is read **above** assignment, so that the `=` closing the list
    // is the one the whole list takes rather than the last target's own.
    val tokens_at = p.mark()
    val errors_at = p.errors_at()
    var parts: Buf[Expr] = buf()

    parts.push(first)

    loop
        if !p.accept_kw(",") then break

        parts.push(parse_expr_bp(p, TargetPower))

    val op = assign_word(p)

    if !is_assign_op(op)
        // **An inline statement is never a result list**, and the comma is put back rather than
        // read: a branch written on one line is part of a larger expression, so `f(if c then a else
        // b, x)` gives the comma to the call rather than making `b, x` the branch's two results.
        if inline
            p.rewind(tokens_at, errors_at)
            return stmt(start.to(p.just_taken()), ExprStmt(lift_placeholders(first)))
        end if

        // `a, b` standing alone is a function's result list as its trailing expression, and is a
        // whole line by construction.
        val list = expr(start.to(p.just_taken()), ResultList(parts))

        return stmt(list.span, ExprStmt(lift_placeholders(list)))
    end if

    p.bump()

    var values: Buf[Expr] = buf()

    loop
        values.push(lift_placeholders(parse_expr(p)))

        if !p.accept_kw(",") then break

    stmt(start.to(p.just_taken()), MultiAssign(op, parts, values))
end parse_expr_or_multi

// The assignment operator standing at the cursor, or `""` where there is none.
private assign_word(p: *Parser) -> string = p.peek() match
    Keyword(w) -> if is_assign_op(w) then w else ""
    _ -> ""
