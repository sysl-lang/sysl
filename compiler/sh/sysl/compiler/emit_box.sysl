module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.math.bigint.from_int

// **Putting something on the heap**: the box a `&T` is, the buffer a sized run of elements is, and
// the view of one.
//
// Both are the same header -- a strong count, the hook that destroys the object, and a weak count --
// so the runtime works the same whatever it is holding and an object frees itself into whichever
// heap made it. A buffer adds the element count in front of the elements, because the hook is what
// destroys them and the hook is reached with no static type in sight.

// Puts a value on the heap: one count for the reference this yields, the hook that will destroy it,
// and a copy of the payload -- whose own references the box now holds a share of.
gen_box(e: *Emit, value: TExpr, ref_ty: Type) -> Val
    val inner = ref_inner(ref_ty)

    // A large payload is written into the box rather than produced and then stored into it, for the
    // reason every other destination has: the value would be a first-class aggregate of kilobytes
    // for the length of one instruction. The address is not known until the box exists, so this is
    // the one destination that cannot be handed over before the expression runs.
    val large = e.layout.indirect(inner)
    val v = if large then VNothing else gen_expr(e, value)
    val opened = open_box(e, inner)
    val slot = opened.1

    if large then gen_into(e, slot, value)
    else
        retain_value(e, inner, v)
        emit(e, InStore(lty(e, inner), v, slot, AccPlain, None))

    own_temp(e, opened.0, ref_ty)
end gen_box

// A box for `inner` with its header written and its payload not yet: the box, and the address its
// payload goes at. `gen_box` fills it from an expression; a `match` arm moving a large payload out of
// its scrutinee fills it straight from that storage (`payload_move`). Whoever fills it owns the box
// with `own_temp`.
open_box(e: *Emit, inner: Type) -> (Val, Val)
    val bn = box_lty(e, inner)
    val p = allocate_box(e, bn, inner)

    emit(e, InStore(word_lty(e), VInt(from_int(1)), p, AccPlain, None))
    store_header_word(e, bn, p, 1, LPtr, drop_fn(e, inner))

    // One weak share stands for every strong reference together, so the storage outlives the object
    // exactly as long as some weak reference is still asking about it.
    store_header_word(e, bn, p, 2, word_lty(e), VInt(from_int(1)))

    val slot = fresh_reg(e)

    var idx: Buf[IrArg] = buf()

    idx.push(ir_arg(l_i32(), VInt(from_int(0))))
    idx.push(ir_arg(l_i32(), VInt(from_int(long(box_payload_field(e, inner))))))
    emit(e, InGep(slot, bn, p, idx))
    (p, slot)
end open_box

// The bytes one box occupies, asked of LLVM rather than computed here: a `getelementptr` one past
// null, read back as an integer, is the size of what was stepped over.
private allocate_box(e: *Emit, bn: LType, inner: Type) -> Val
    val end = fresh_reg(e)

    var idx: Buf[IrArg] = buf()

    idx.push(ir_arg(l_i32(), VInt(from_int(1))))
    emit(e, InGep(end, bn, VNull, idx))

    val size = fresh_reg(e)

    emit(e, InCast(size, CastPtrToInt, LPtr, end, word_lty(e)))

    heap_call(e, size, inner, "a box")
end allocate_box

// The call that takes `size` bytes from the heap for storage of `t`: the allocating pair's, or the
// aligned hook's where `t` asks for a boundary beyond what the pair promises (`beyond_heap`). The
// aligned block goes back through the hook's own free, `sysl_free_aligned`, which the type's drop
// hook calls (`emit_arc.sysl`'s `drop_fn`).
//
// `what` is how the refusal names the storage, where there is no aligned hook to call
// (`unaligned_heap`).
private heap_call(e: *Emit, size: Val, t: Type, what: string) -> Val
    val p = fresh_reg(e)

    var args: Buf[IrArg] = buf()

    args.push(ir_arg(word_lty(e), size))

    if e.layout.beyond_heap(t)
        val a = e.layout.align(t)

        args.push(ir_arg(word_lty(e), VInt(from_int(long(a)))))
        emit(e, ir_call(Some(p), LPtr, VGlobal(aligned_alloc_symbol()), args))
        note_aligned_heap(e, s"$what of '${type_show(t)}' asks for the $a-byte boundary its type is " +
            "aligned on", a)
    else
        emit(e, ir_call(Some(p), LPtr, VGlobal(malloc_symbol()), args))

    p
end heap_call

// Records the first storage this module took from the aligned hook: what the refusal says about it,
// the function that made it, and the boundary.
note_aligned_heap(e: *Emit, said: string, boundary: usize)
    if e.aligned_heap.is_empty() then e.aligned_heap.push((said, e.self_name, boundary))

private store_header_word(e: *Emit, bn: LType, p: Val, field: int, ty: LType, v: Val)
    val r = fresh_reg(e)

    var idx: Buf[IrArg] = buf()

    idx.push(ir_arg(l_i32(), VInt(from_int(0))))
    idx.push(ir_arg(l_i32(), VInt(from_int(long(field)))))
    emit(e, InGep(r, bn, p, idx))
    emit(e, InStore(ty, v, r, AccPlain, None))
end store_header_word

// The inner type of a `&T`, or the type itself where it is not one -- which nothing reaching here
// should be, and which answers something rather than stopping the walk if it is.
ref_inner(t: Type) -> Type = underlying(t) match
    Ref(inner, _) -> *inner
    _ -> t

// -- a buffer, and the view of one ---------------------------------------------------------------------

// The box that holds `n` elements sized while running, and the address its elements start at.
//
// The size is computed with the checked forms: a count the program worked out can be anything, and
// a multiplication that wrapped would ask for a block far smaller than the elements written into
// it.
gen_buffer(e: *Emit, elem: Type, n: Val) -> (Val, Val)
    val bn = buf_lty(e, elem)

    e.checked = true

    val e1 = fresh_reg(e)

    var eidx: Buf[IrArg] = buf()

    eidx.push(ir_arg(LInt(64), VInt(from_int(1))))
    emit(e, InGep(e1, lty(e, elem), VNull, eidx))

    val esz = fresh_reg(e)

    emit(e, InCast(esz, CastPtrToInt, LPtr, e1, word_lty(e)))

    val h1 = fresh_reg(e)

    var hidx: Buf[IrArg] = buf()

    hidx.push(ir_arg(l_i32(), VInt(from_int(0))))
    hidx.push(ir_arg(l_i32(), VInt(from_int(long(buf_elems_field(e, elem))))))
    emit(e, InGep(h1, bn, VNull, hidx))

    val hsz = fresh_reg(e)

    emit(e, InCast(hsz, CastPtrToInt, LPtr, h1, word_lty(e)))

    val bytes = size_op(e, "mul", n, esz)
    val total = size_op(e, "add", bytes.0, hsz)
    val over = fresh_reg(e)

    emit(e, InBin(over, OpOr, l_i1(), bytes.1, total.1))

    val fits = fresh_reg(e)

    emit(e, InBin(fits, OpXor, l_i1(), over, VBool(true)))
    trap_unless(e, fits, "size")

    val p = heap_call(e, total.0, elem, "a buffer")
    val got = fresh_reg(e)

    emit(e, InIntCmp(got, INe, LPtr, p, VNull))
    trap_unless(e, got, "alloc")
    emit(e, InStore(word_lty(e), VInt(from_int(1)), p, AccPlain, None))
    store_header_word(e, bn, p, 1, LPtr, drop_buf_fn(e, elem))
    store_header_word(e, bn, p, 2, word_lty(e), VInt(from_int(1)))
    store_header_word(e, bn, p, header_fields(), word_lty(e), n)

    val data = fresh_reg(e)

    var didx: Buf[IrArg] = buf()

    didx.push(ir_arg(l_i32(), VInt(from_int(0))))
    didx.push(ir_arg(l_i32(), VInt(from_int(long(buf_elems_field(e, elem))))))
    emit(e, InGep(data, bn, p, didx))
    (p, data)
end gen_buffer

// One step of a size computation, with the overflow flag beside the answer. The intrinsic carries
// its width in the **name** as well as in the signature, so a size computed at the machine's own
// width has to name the matching overload.
//
// **The declaration is `e.checked`'s and not asked for here**, which is what puts it among the ones
// the module writes for itself rather than after the `extern`s a program declared. The two are the
// same line wherever both appear; where they sit is what a whole-file comparison sees.
private size_op(e: *Emit, op: string, a: Val, b: Val) -> (Val, Val)
    val w = word_lty(e)
    val fn = llvm_with_overflow(op, false, w)

    var pair_fields: Buf[LType] = buf()

    pair_fields.push(w)
    pair_fields.push(l_i1())

    val both = LStruct(pair_fields)

    var params: Buf[IrParam] = buf()

    params.push(ir_param(w))
    params.push(ir_param(w))

    var args: Buf[IrArg] = buf()

    args.push(ir_arg(w, a))
    args.push(ir_arg(w, b))

    val pair = fresh_reg(e)

    emit(e, ir_call(Some(pair), both, VGlobal(fn), args))

    val v = fresh_reg(e)

    emit(e, InExtract(v, both, pair, index_list(0)))

    val ovf = fresh_reg(e)

    emit(e, InExtract(ovf, both, pair, index_list(1)))
    (v, ovf)
end size_op

// The view of a whole buffer: the box keeps the elements alive, and the one count it was made with
// is the count this view holds.
buffer_view(e: *Emit, slice_ty: Type, box: Val, data: Val, n: Val) -> Val
    e.maybe_heap = true

    val lt = lty(e, slice_ty)
    val with_owner = fresh_reg(e)

    emit(e, InInsert(with_owner, lt, VZero, LPtr, box, index_list(0)))

    val with_ptr = fresh_reg(e)

    emit(e, InInsert(with_ptr, lt, with_owner, LPtr, data, index_list(1)))

    val whole = fresh_reg(e)

    emit(e, InInsert(whole, lt, with_ptr, word_lty(e), n, index_list(2)))
    own_temp(e, whole, slice_ty)
end buffer_view

// -- an array whose storage a view outlives -------------------------------------------------------------

// The element type of an array, where the type is one -- which is the whole of what makes a
// declaration promotable.
promoted_elem(ty: Type) -> Option[Type] = underlying(ty) match
    Array(_, elem) -> Some(*elem)
    _ -> None

// -- the weak edge ----------------------------------------------------------------------------------

// Weakens a reference: the same address, counted in the box's third word instead of its first. The
// strong count is untouched, which is the whole point -- the edge this makes keeps nothing alive.
//
// The value is registered as an owned temporary so the region that produced it gives the weak share
// back, exactly as it would for a reference. What ends up holding it long-term is the slot it is
// stored into, which takes a share of its own when it is written.
gen_downgrade(e: *Emit, value: TExpr, weak_ty: Type) -> Val
    val v = gen_expr(e, value)

    retain_value(e, weak_ty, v)
    own_temp(e, v, weak_ty)
end gen_downgrade

// `w.get()` -- asks the box whether the object is still there. A live one comes back with a count
// taken for the caller, so what the `Some` carries is an ordinary owned reference; a dead one gives
// a null address, which is the `None`.
//
// A trait object is rebuilt around the answer rather than reused: the method table it was carrying
// is a constant that says nothing about whether the object is alive, so it is put back beside the
// address only on the arm where there is one.
gen_upgrade(e: *Emit, value: TExpr, opt_ty: Type, some: EnumVariant, none: EnumVariant) -> Val
    e.weak_heap = true

    val fat = weak_inner(texpr_type(value)).map(is_trait).unwrap_or(false)
    val v = gen_expr(e, value)
    val addr = if fat then erased_box(e, v) else v
    val d = enum_decl(opt_ty)

    if d.is_none() then return gap_at(e, "an upgrade whose option is not an enum")

    val got = fresh_reg(e)

    var args: Buf[IrArg] = buf()

    args.push(ir_arg(LPtr, addr))
    emit(e, ir_call(Some(got), LPtr, VGlobal("arc.upgrade"), args))

    val live = fresh_reg(e)

    emit(e, InIntCmp(live, INe, LPtr, got, VNull))

    val slot = alloca(e, fresh_reg(e), lty(e, opt_ty))
    val some_l = fresh_label(e, "weak.live")
    val none_l = fresh_label(e, "weak.gone")
    val end_l = fresh_label(e, "weak.end")

    emit_term(e, InCondBr(live, some_l, none_l))
    emit_label(e, some_l)

    var strong = got

    if fat
        val tbl = fresh_reg(e)

        emit(e, InExtract(tbl, l_fat(), v, index_list(0)))

        val f0 = fresh_reg(e)

        emit(e, InInsert(f0, l_fat(), VUndef, LPtr, tbl, index_list(0)))

        val f1 = fresh_reg(e)

        emit(e, InInsert(f1, l_fat(), f0, LPtr, got, index_list(1)))

        strong = f1

    var carried: Buf[Val] = buf()

    carried.push(strong)
    emit(e, InStore(lty(e, opt_ty), enum_value(e, opt_ty, d.unwrap(), some, carried), slot, AccPlain,
                    None))
    emit_term(e, InBr(end_l))
    emit_label(e, none_l)

    var empty: Buf[Val] = buf()

    emit(e, InStore(lty(e, opt_ty), enum_value(e, opt_ty, d.unwrap(), none, empty), slot, AccPlain,
                    None))
    emit_term(e, InBr(end_l))
    emit_label(e, end_l)

    val r = fresh_reg(e)

    emit(e, InLoad(r, lty(e, opt_ty), slot, AccPlain, None))
    own_temp(e, r, opt_ty)
end gen_upgrade

private weak_inner(ty: Type) -> Option[Type] = underlying(ty) match
    Weak(inner) -> Some(*inner)
    _ -> None

// An array a view of which gets out of this frame lives in a buffer instead of a slot, and that is
// the whole of the difference: the name still means the address of the storage, so the store and
// every later use are the ones an unpromoted array gets. What the buffer adds is an owner for the
// views to count against, and a release when the name goes out of scope.
gen_promoted_decl(e: *Emit, name: string, ty: Type, elem: Type, init: TExpr)
    val n = array_length(ty)
    val v = gen_expr(e, init)
    val made = gen_buffer(e, elem, VInt(from_int(long(n))))

    // The address is a register an instruction defines where it stands, rather than a slot in the
    // prologue -- so a declaration nothing reaches, whose instruction is dropped, takes no name.
    val own = if e.terminated then local_name(e, name) else declare_local(e, name)

    e.promoted_boxes.push((own, made.0))

    var idx: Buf[IrArg] = buf()

    idx.push(ir_arg(LInt(64), VInt(from_int(0))))
    emit(e, InGep(VReg(s"$own.addr"), lty(e, elem), made.1, idx))
    retain_value(e, ty, v)
    emit(e, InStore(lty(e, ty), v, VReg(s"$own.addr"), AccPlain, None))
    own_box(e, name, made.0, elem)
end gen_promoted_decl

private array_length(ty: Type) -> int = underlying(ty) match
    Array(n, _) -> n
    _ -> 0

// -- the aligned hook ----------------------------------------------------------------------------------

// **Storage of a type aligned beyond what the allocating pair promises comes from a second pair**:
// `sysl_alloc_aligned(size, align)`, answering a block on that boundary or null, and
// `sysl_free_aligned(p)`, giving one back. A box, a buffer or a task frame of such a type is made by
// the first, and its drop hook calls the second (`emit_arc.sysl`'s `drop_fn`). Where the allocating
// pair is libc's and the C library has an aligned allocation, `weak` defaults are written over it --
// `posix_memalign` and `free` on a POSIX system and WASI, `_aligned_malloc` and `_aligned_free` on
// Windows -- and a program's own `@export` (or an `extern` naming one) wins. Anywhere else -- a pair a
// manifest named, a machine with no C library -- the program answers both, and one that makes such
// storage without doing so is refused (`emit_checks.sysl`'s `check_aligned_heap`). A program that
// never makes such storage never names either.
aligned_alloc_symbol() -> string =
    if alloc_counting_active() then counted_aligned_symbol() else "sysl_alloc_aligned"

aligned_free_symbol() -> string =
    if alloc_counting_active() then counted_aligned_free_symbol() else "sysl_free_aligned"

// The aligned pair of a counted build, which the counting runtime defines (`alloc_count.sysl`).
counted_aligned_symbol() -> string = "sysl_count_alloc_aligned"

counted_aligned_free_symbol() -> string = "sysl_count_free_aligned"

// Whether a C library is under this target for the aligned defaults to be written over -- the ONE
// question the defaults and the refusal (`emit_checks.sysl`'s `check_aligned_heap`) ask about it.
aligned_heap_has_libc(t: Target) -> bool = os_hosted(t.os)

// The C library's aligned pair the defaults are written over, where there is a C library.
c_aligned_pair(t: Target) -> Option[(string, string)]
    if !aligned_heap_has_libc(t) then return None
    if t.os == Windows then return Some(("_aligned_malloc", "_aligned_free"))

    Some(("posix_memalign", "free"))
end c_aligned_pair

// The storage the last module lowered made through the aligned hook with nothing to answer it --
// what it was, the function that made it, and the boundary -- or nothing. Settled by each lowering,
// and read by the driver straight after (`check_aligned_heap`).
private var unaligned: Option[(string, string, usize)] = None

unaligned_heap() -> Option[(string, string, usize)] = unaligned

// The default, where one can be written; otherwise what the refusal is about. Asked once every body
// is lowered, since that is when the module knows whether anything needed the hook.
request_aligned_heap(e: *Emit, p: TProgram)
    unaligned = None

    if e.aligned_heap.is_empty() || alloc_counting_active() then return

    val alloc = aligned_alloc_symbol()
    val free = aligned_free_symbol()
    val alloc_open = !claimed_symbol(e, p, alloc)
    val free_open = !claimed_symbol(e, p, free)

    if !alloc_open && !free_open then return

    val libc_pair = malloc_symbol() == "malloc" && free_symbol() == "free"
    val c_pair = if libc_pair then c_aligned_pair(e.target) else None

    if c_pair.is_none()
        unaligned = Some(e.aligned_heap.at(0))
        return
    end if

    val names = c_pair.unwrap()
    val w = s"i${e.word_bits}"
    val pre = e.target.preemption()

    if alloc_open
        val body = if names.0 == "posix_memalign" then posix_aligned_body(w) else direct_aligned_body(names.0, w)

        request_helper(e, alloc, HrText(s"define weak ${pre}ptr @$alloc($w %size, $w %align) {\n" +
                                         "entry:\n" + body))
    end if

    // libc's `free` is already the pair's half, and declared as that; `_aligned_free` is not.
    if free_open
        val declared = if names.1 == "free" then "" else s"\ndeclare void @${names.1}(ptr)\n"

        request_helper(e, free, HrText(s"define weak ${pre}void @$free(ptr %p) {\n" +
                                        "entry:\n" +
                                        s"  call void @${names.1}(ptr %p)\n" +
                                        "  ret void\n" +
                                        "}\n" + declared))
    end if
end request_aligned_heap

// The aligned default's body over `posix_memalign`, which answers through an out-pointer and a code.
private posix_aligned_body(w: string) -> string =
    "  %slot = alloca ptr\n" +
    s"  %r = call i32 @posix_memalign(ptr %slot, $w %align, $w %size)\n" +
    "  %ok = icmp eq i32 %r, 0\n" +
    "  br i1 %ok, label %got, label %none\n" +
    "got:\n" +
    "  %p = load ptr, ptr %slot\n" +
    "  ret ptr %p\n" +
    "none:\n" +
    "  ret ptr null\n" +
    "}\n\n" +
    s"declare i32 @posix_memalign(ptr, $w, $w)\n"

// The same over a C function that answers the block itself, `_aligned_malloc(size, align)`.
private direct_aligned_body(name: string, w: string) -> string =
    s"  %p = call ptr @$name($w %size, $w %align)\n" +
    "  ret ptr %p\n" +
    "}\n\n" +
    s"declare ptr @$name($w, $w)\n"

// The C functions the defaults call that this module declares in their text, so nothing declares
// them twice (`codegen.sysl`'s `declares`).
aligned_default_symbols(e: *Emit) -> Buf[string]
    var out: Buf[string] = buf()

    if e.requested_set.has(aligned_alloc_symbol())
        c_aligned_pair(e.target) match
            Some(names) -> out.push(names.0)
            None -> ()

    if e.requested_set.has(aligned_free_symbol())
        c_aligned_pair(e.target) match
            Some(names) -> if names.1 != "free" then out.push(names.1)
            None -> ()

    out
end aligned_default_symbols
