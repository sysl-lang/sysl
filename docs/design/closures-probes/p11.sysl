// A closure handed to a trait object's method: today the method borrows (does not keep) a callback?
trait Visitor
    visit(*self, f: &Fn(int) -> unit)

struct Three
    k: int

impl Visitor for Three
    visit(*self, f: &Fn(int) -> unit)
        f(1)
        f(2)
        f(3)

run(v: *Visitor)
    var n = 0
    val p = &n

    v.visit(x -> *p += x)
    print(n)

var t = Three(0)
run(&t)
