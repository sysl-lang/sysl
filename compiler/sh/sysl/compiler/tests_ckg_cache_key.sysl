// -- the target, through the root cache --------------------------------------------------------------

// The CPU type a Mach-O executable names.
private ckg_cpu(exe: string) -> int
    val b = read_bytes(exe).unwrap()

    int(b[4]) | (int(b[5]) << 8) | (int(b[6]) << 16) | (int(b[7]) << 24)
end ckg_cpu

@test("--target keys a root's kept half: an x86_64 build is a second entry, and the host build replays")
ckg_target_flag()
    if !ckg_ready() || host_target().name != "aarch64-macos" then return

    val lib = ckg_tree([("geo/geo.sysl", "module geo\n\nvalue() -> int = 3\n")])
    val root = ckg_project(ckg_manifest("app", ""), "import geo", "geo.value()", [])
    val cache = ckg_caches()
    val host_exe = s"$cache/host"
    val other_exe = s"$cache/other"
    var how: Buf[string] = buf()

    for step in 0..<3
        val before = root_artifact_counts()
        val args = ckg_args("build", root, s"--lib $lib -o ${if step == 1 then other_exe else host_exe}" +
                            (if step == 1 then " --target x86_64-macos" else ""))

        assert_eq(ckg_cli(args.view()).0, 0)
        how.push(ckg_root_verdict(before, root_artifact_counts()))

    val cpus = s"${ckg_cpu(host_exe)} ${ckg_cpu(other_exe)}"

    ckg_done(cache, [root, lib])
    assert_eq(join(how.view(), " "), "miss miss hit")
    assert_eq(cpus, "16777228 16777223")
end ckg_target_flag

// -- the graph -------------------------------------------------------------------------------------

// `leaf` as a `--lib` root standing in for the coordinate `github.com/e/leaf`, `mid` a path dependency
// whose entry for it carries `mid_extra`, and the project depending on `mid` alone.
private ckg_chain(mid_extra: string) -> (string, string, string)
    val leaf = ckg_leaf(false)
    val mid = ckg_tree([("package.hocon", ckg_mid_manifest(mid_extra)),
                        ("mid/mid.sysl", "module mid\n\nimport leaf\n\nshow() -> int = leaf.value()\n")])
    val root = ckg_project(ckg_manifest("app", s"dependencies { mid { path = \"$mid\" } }\n"), "import mid",
                           "mid.show()", [])

    (root, mid, leaf)
end ckg_chain

private ckg_mid_manifest(extra: string) -> string =
    ckg_manifest("mid", s"dependencies { leaf { git = \"github.com/e/leaf\", version = \"1.0.0\"$extra } }\n")

@test("root → mid → leaf: an option only the intermediate package sets, changed, misses both caches")
ckg_graph_option_set_by_an_intermediate()
    if !ckg_ready() then return

    val g = ckg_chain("")
    val two = ckg_mid_manifest(", options = { n = 2 }")
    val three = ckg_mid_manifest(", options = { n = 3 }")

    val ran = ckg_seam(g.0, s"--lib ${g.2}", s"--lib ${g.2}", () -> ckg_put(g.1, "package.hocon", two),
                       () -> ckg_put(g.1, "package.hocon", three))
    val kept = ckg_root_seam(g.0, g.2, "", "", () -> ckg_put(g.1, "package.hocon", two),
                             () -> ckg_put(g.1, "package.hocon", three))

    lbr_drop([g.0, g.1, g.2])
    assert_eq(ran, "2 | 3 | 2 | miss miss hit | different bytes")
    assert_eq(kept, "2 | 3 | 2 | miss miss hit")
end ckg_graph_option_set_by_an_intermediate

@test("root → mid → leaf: a feature only the intermediate package turns on, turned off, misses both caches")
ckg_graph_feature_set_by_an_intermediate()
    if !ckg_ready() then return

    val g = ckg_chain("")
    val on = ckg_mid_manifest(", features = [\"fancy\"]")
    val off = ckg_mid_manifest("")

    val ran = ckg_seam(g.0, s"--lib ${g.2}", s"--lib ${g.2}", () -> ckg_put(g.1, "package.hocon", on),
                       () -> ckg_put(g.1, "package.hocon", off))
    val kept = ckg_root_seam(g.0, g.2, "", "", () -> ckg_put(g.1, "package.hocon", on),
                             () -> ckg_put(g.1, "package.hocon", off))

    lbr_drop([g.0, g.1, g.2])
    assert_eq(ran, "101 | 1 | 101 | miss miss hit | different bytes")
    assert_eq(kept, "101 | 1 | 101 | miss miss hit")
end ckg_graph_feature_set_by_an_intermediate

@test("two projects sharing a --lib leaf with different option values keep two entries and never cross")
ckg_graph_two_projects_share_a_leaf()
    if !ckg_ready() then return

    val leaf = ckg_leaf(false)
    val entry = (n: int) -> ckg_manifest("app", "dependencies { leaf { git = \"github.com/e/leaf\", " +
                                         s"version = \"1.0.0\", options = { n = $n } } }\n")
    val first = ckg_project(entry(4), "import leaf", "leaf.value()", [])
    val second = ckg_project(entry(5), "import leaf", "leaf.value()", [])
    val cache = ckg_caches()
    var said: Buf[string] = buf()
    var how: Buf[string] = buf()
    val order = [first, second, first, second]

    for i in 0..<order.len
        val before = root_artifact_counts()

        said.push(ckg_built(order[i], s"--lib $leaf", s"$cache/p$i"))
        how.push(ckg_root_verdict(before, root_artifact_counts()))

    ckg_done(cache, [first, second, leaf])
    assert_eq(join(said.view(), " "), "4 5 4 5")
    assert_eq(join(how.view(), " "), "miss miss hit hit")
end ckg_graph_two_projects_share_a_leaf

// `shared` at `version`, vendored into `root`: `value()` is `answer`, and `tag()` its `__VERSION__`.
private ckg_vendor_shared(root: string, version: string, answer: int)
    val dir = s"$root/vendor/github.com/e/shared/@v$version"

    ckg_put(dir, "package.hocon", s"package { name = \"shared\", version = \"$version\" }\n")
    ckg_put(dir, "shared/shared.sysl", s"module shared\n\nconst Answer: int = $answer\n\n" +
            "value() -> int = Answer\ntag() -> string = __VERSION__\n")
    write_text(s"$dir.hash", s"${tree_hash(dir).unwrap()}\n").unwrap()
end ckg_vendor_shared

// A diamond: the project depends on `a` and `b`, each of which depends on `shared`; `b` asks for
// `b_wants`. `a.answer()` reads `shared` through `a`, which never changes.
private ckg_diamond(answer_1_1: int) -> (string, string)
    val root = lbr_temp("sysl-ckg-dia")
    val entry = (v: string) -> s"dependencies { shared { git = \"github.com/e/shared\", version = \"$v\" } }\n"

    ckg_vendor_shared(root, "1.0.0", 10)
    ckg_vendor_shared(root, "1.1.0", answer_1_1)
    ckg_put(root, "a/package.hocon", ckg_manifest("a", entry("1.0.0")))
    ckg_put(root, "a/a/a.sysl", "module a\n\nimport shared\n\nanswer() -> string = str(shared.value()) + " +
            "\" \" + shared.tag()\n")
    ckg_put(root, "b/package.hocon", ckg_manifest("b", entry("1.0.0")))
    ckg_put(root, "b/b/b.sysl", "module b\n\nimport shared\n\nunused() -> int = shared.value()\n")
    ckg_put(root, "package.hocon", ckg_manifest("app", "dependencies { a { path = \"a\" }, b { path = \"b\" } }\n"))
    ckg_put(root, "main.sysl", ckg_main(root, "import a", "a.answer()"))
    (root, entry("1.1.0"))
end ckg_diamond

@test("a diamond: a second consumer bumping the shared package moves a constant the first reads, and it misses")
ckg_graph_diamond_bump_changes_a_constant()
    if !ckg_ready() then return

    val d = ckg_diamond(11)
    val low = ckg_manifest("b", "dependencies { shared { git = \"github.com/e/shared\", version = \"1.0.0\" } }\n")
    val high = ckg_manifest("b", d.1)

    val ran = ckg_seam(d.0, "", "", () -> ckg_put(d.0, "b/package.hocon", low),
                       () -> ckg_put(d.0, "b/package.hocon", high))

    remove_dir_all(d.0).unwrap_or(())
    assert_eq(ran, "10 1.0.0 | 11 1.1.0 | 10 1.0.0 | miss miss hit | different bytes")
end ckg_graph_diamond_bump_changes_a_constant

