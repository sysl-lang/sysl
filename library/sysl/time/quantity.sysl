module sysl.time

/** Points on the timeline and lengths of it, which are the two quantities every other type here is
 * built out of.
 *
 * An **instant** is a point on the timeline, the same point for everybody. A **duration** is a
 * length of timeline with no place on it. The whole discipline of a date-time library is in keeping
 * those apart, because almost every operation is legal for one and nonsense for the other: two
 * instants may be compared and subtracted but never added, while a duration may be added to itself,
 * negated, and scaled.
 *
 * Both are counts of **microseconds**, which is the one representation choice worth arguing about. A
 * `long` of nanoseconds runs out in 1678–2262 — close enough to today to look fine in every test and
 * fail on a birth date. A `long` of microseconds reaches ±292,000 years. Nothing here needs to
 * resolve a nanosecond, and a range that quietly ends is a worse defect than a precision that never
 * begins.
 *
 * **What is not here is the zone**, and that is the module's boundary rather than an omission. A
 * wall clock reading becomes an instant only once somebody says where the wall is, and answering
 * that needs the IANA time zone database: a table that changes several times a year, which a
 * language's standard library either ships and lets go stale or reads from the host and thereby
 * needs a filesystem. Both are decisions with costs, and neither belongs in a module whose whole
 * claim is that it is arithmetic.
 */

const us_per_milli: long = 1000
const us_per_second: long = 1000000
const us_per_minute: long = 60000000
const us_per_hour: long = 3600000000
const us_per_day: long = 86400000000

/** A point on the timeline, counted from 1970-01-01T00:00:00Z. It names no place and no calendar:
 * the same `Instant` is a different wall clock reading in every zone, which is the entire reason it
 * is a separate type from the civil ones.
 */
struct Instant
    us: long

/** A length of timeline. It is **not** a number of days, because a day is not a fixed length of
 * timeline — a day that a zone's clocks move through is 23 or 25 hours long.
 */
struct Duration
    us: long

/** How far a zone's wall clock is set from UTC, in whole minutes. Minutes rather than hours because
 * India is at +05:30 and Nepal at +05:45, and a library that assumes whole hours works everywhere
 * its author has lived.
 */
struct Offset
    minutes: int

/** The constructors, from the shortest length this representation can name to the longest it should.
 *
 * `micros` is the identity, and is here anyway: the representation being microseconds is a fact of
 * this module rather than of the caller, and a program writing `Duration(n)` has reached past the
 * constructors to depend on it. The two short ones are also the only two an embedded program asks
 * for -- a blink loop wants 120 milliseconds, and there is no way to spell that in `seconds`.
 */
micros(n: long) -> Duration = Duration(n)
millis(n: long) -> Duration = Duration(n * us_per_milli)
seconds(n: long) -> Duration = Duration(n * us_per_second)
minutes(n: long) -> Duration = Duration(n * us_per_minute)
hours(n: long) -> Duration = Duration(n * us_per_hour)
days(n: long) -> Duration = Duration(n * us_per_day)

/** An instant moved by a length of time. This is the **absolute** answer: it lands exactly that many
 * microseconds along the timeline whatever any calendar does in between.
 */
impl Add[Duration] for Instant
    add(self, rhs: Duration) -> Instant = Instant(self.us + rhs.us)

impl Sub[Duration] for Instant
    sub(self, rhs: Duration) -> Instant = Instant(self.us - rhs.us)

/** The difference of two instants is a duration, and it is the operator. An implementation carries
 * its result as `Out` (`reference/expressions.md § The operand and the result are both trait
 * arguments`), so one type may subtract two different things and answer with a third: the row above
 * lands further along the timeline, and this one measures the gap between two points on it. What
 * tells them apart is the type of the right operand and nothing else, which is what makes both of
 * them ordinary uses of `-`.
 */
impl Sub[Instant, Duration] for Instant
    sub(self, rhs: Instant) -> Duration = Duration(self.us - rhs.us)

/** The same difference under a name that says which end is which. `later - earlier` is right and
 * `earlier - later` is just as easy to write, so the named form stays for the call that wants to be
 * read rather than worked out.
 */
since(later: Instant, earlier: Instant) -> Duration = later - earlier

impl Add for Duration
    add(self, rhs: Duration) -> Duration = Duration(self.us + rhs.us)

impl Sub for Duration
    sub(self, rhs: Duration) -> Duration = Duration(self.us - rhs.us)

impl Neg for Duration
    neg(self) -> Duration = Duration(-self.us)

/** Scaling, which reads both ways round. `d * 2` is the block below and `2 * d` is the one after it:
 * an operator's implementation used to be findable only from the type on its **left**, so a count on
 * the left had nowhere to be written, and coherence now counts the trait's arguments as well as its
 * subject -- a block naming `Duration` belongs in the module declaring `Duration`, whichever side of
 * the operator the count sits on.
 */
impl Mul[long] for Duration
    mul(self, rhs: long) -> Duration = Duration(self.us * rhs)

/** The count on the left, forwarding to the block above -- and it is **two blocks at two widths**
 * rather than one over `Integer`, which is the shape `sysl.math.complex` writes its own left-hand
 * operators in.
 *
 * **Both widths are needed and neither is redundant, because the two sides type a literal
 * differently.** `d * 3` reads its `3` off the parameter it is passed to, so a count on the right
 * arrives as a `long` whatever the reader wrote. `3 * d` has nothing to read it off -- the literal is
 * an `int` before the operator is looked at -- so `int` is the block a bare number reaches and `long`
 * is the block a named one does.
 *
 * The member each of these gives its width is `mul.2`, since the compiler already provides an
 * integer's own multiplication under the plain name.
 */
impl Mul[Duration, Duration] for int
    mul(self, d: Duration) -> Duration = d * long(self)

impl Mul[Duration, Duration] for long
    mul(self, d: Duration) -> Duration = d * self

impl Eq for Instant
    eq(self, rhs: Instant) -> bool = self.us == rhs.us

impl Ord for Instant
    lt(self, rhs: Instant) -> bool = self.us < rhs.us

impl Eq for Duration
    eq(self, rhs: Duration) -> bool = self.us == rhs.us

impl Ord for Duration
    lt(self, rhs: Duration) -> bool = self.us < rhs.us

impl Eq for Offset
    eq(self, rhs: Offset) -> bool = self.minutes == rhs.minutes

impl Ord for Offset
    lt(self, rhs: Offset) -> bool = self.minutes < rhs.minutes

/** The parts a duration is read back in, each truncated toward zero. They are how a length of time is
 * stated to somebody who has to check it: "167 hours" is a sentence a reader can hold against a
 * calendar, and 601200000000 is not.
 */
whole_days(d: Duration) -> long = d.us / us_per_day
whole_hours(d: Duration) -> long = d.us / us_per_hour
whole_minutes(d: Duration) -> long = d.us / us_per_minute
whole_seconds(d: Duration) -> long = d.us / us_per_second
whole_millis(d: Duration) -> long = d.us / us_per_milli
whole_micros(d: Duration) -> long = d.us

/** …and the remainders, which are what the parts above leave. `odd_minutes` of three and a half hours
 * is thirty, not two hundred and ten.
 */
odd_hours(d: Duration) -> long = d.us % us_per_day / us_per_hour
odd_minutes(d: Duration) -> long = d.us % us_per_hour / us_per_minute
odd_seconds(d: Duration) -> long = d.us % us_per_minute / us_per_second
odd_us(d: Duration) -> long = d.us % us_per_second

/** `+05:30`, the way an offset is written everywhere one is written down — a sign, then a width the
 * reader can rely on, which is what makes a rendered timestamp sortable as text. `Z` is UTC, and it
 * is a spelling rather than a special case: an offset of zero is written that way by ISO 8601 and
 * read back as zero by `offset_of` below.
 */
offset_text(o: Offset) -> string
    if o.minutes == 0 then return "Z"

    var sign = if o.minutes < 0 then "-" else "+"
    var m = if o.minutes < 0 then -o.minutes else o.minutes

    f"$sign%s${m / 60}%02d:${m % 60}%02d"
end offset_text

impl Display for Offset
    display(self, out: *Writer, fmt: FormatSpec) = display_str(offset_text(self), out, fmt)
