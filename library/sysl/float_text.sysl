module sysl

// A float written as decimal text under a printf conversion -- `%f`, `%e` and `%g` with every flag,
// width and precision C gives them -- in sysl, with no C library underneath.
//
// **The answer is the exact one, correctly rounded.** A finite float is `m * 2^e` with integer `m`,
// so its decimal expansion is finite too, and the digits printed are that expansion rounded at the
// position the conversion asks for, half way to the even digit -- what the C libraries this module
// replaces print. Finding them needs the whole value, so the value is held as a fraction of two big
// integers, `r / s`, scaled until it lies in [1, 10): each digit is then the integer part of the
// fraction, and what is left times ten is the fraction for the next one. The digit dropped first and
// everything after it decide the rounding; a tie is a remainder of exactly half.
//
// A double's expansion is at most 767 significant digits and 309 whole ones, so a buffer of 800
// always holds every digit that is not a zero, and a precision past that pads with zeros the
// arithmetic never had to produce. The big integers are at most 1,080 bits. An `f128` is the same
// arithmetic over wider integers: its expansion runs to 11,563 significant digits and 4,933 whole
// ones, and its big integers to about 16,600 bits.

/** A non-negative integer in 32-bit limbs, least significant first: the arithmetic exact decimal
 * conversion needs, in both directions, at a size fixed when it is declared, so it lives on the stack
 * and allocates nothing.
 *
 * `len` counts the limbs in use and the top one is never zero, so zero is `len == 0`. Only those are
 * read; a limb above `len` is written before anything reads it.
 */
private[sysl] struct Big[const N: usize]
    limbs: [N]u32
    len: usize

    set(*self, v: u128)
        self.len = 0
        var x = v

        while x != 0
            self.limbs[self.len] = u32(x & 0xffffffff)
            self.len += 1
            x >>= 32
    end set

    is_zero(self) -> bool = self.len == 0

    /** How many bits the value takes, zero for zero. */
    bit_len(self) -> usize =
        if self.len == 0 then 0 else (self.len - 1) * 32 + bits_of(self.limbs[self.len - 1])

    /** The value times `k`. */
    mul_small(*self, k: u32)
        var carry: u64 = 0

        for i in 0..<self.len
            val p = u64(self.limbs[i]) * u64(k) + carry

            self.limbs[i] = u32(p & 0xffffffff)
            carry = p >> 32

        if carry != 0
            self.limbs[self.len] = u32(carry)
            self.len += 1
    end mul_small

    /** The value plus `other`. */
    add(*self, other: *Big[N])
        var carry: u64 = 0
        var i: usize = 0

        while i < other.len || carry != 0
            val mine = if i < self.len then u64(self.limbs[i]) else 0
            val theirs = if i < other.len then u64(other.limbs[i]) else 0
            val sum = mine + theirs + carry

            self.limbs[i] = u32(sum & 0xffffffff)
            carry = sum >> 32
            i += 1

            if i > self.len then self.len = i
    end add

    /** The value plus `k`. */
    add_small(*self, k: u32)
        var carry = u64(k)
        var i: usize = 0

        while carry != 0
            if i == self.len
                self.limbs[i] = u32(carry)
                self.len += 1
                return

            val s = u64(self.limbs[i]) + carry

            self.limbs[i] = u32(s & 0xffffffff)
            carry = s >> 32
            i += 1
    end add_small

    /** The value times `5^n`, thirteen fives at a time -- the most a limb holds. */
    mul_pow5(*self, n: int)
        var left = n

        while left >= 13
            self.mul_small(1220703125)
            left -= 13

        if left > 0 then self.mul_small(small_pow5(left))
    end mul_pow5

    mul_pow10(*self, n: int)
        self.mul_pow5(n)
        self.shl(n)

    /** The value times `2^bits`. */
    shl(*self, bits: int)
        if self.len == 0 || bits == 0 then return

        val words = usize(bits / 32)
        val rest = bits % 32
        var i = self.len

        if rest == 0
            while i > 0
                i -= 1
                self.limbs[i + words] = self.limbs[i]

            self.len += words
        else
            val top = self.limbs[self.len - 1] >> (32 - rest)

            self.limbs[self.len + words] = top

            while i > 1
                i -= 1
                self.limbs[i + words] = (self.limbs[i] << rest) | (self.limbs[i - 1] >> (32 - rest))

            self.limbs[words] = self.limbs[0] << rest
            self.len += words

            if top != 0 then self.len += 1
        end if

        for j in 0..<words
            self.limbs[j] = 0
    end shl

    /** -1, 0 or 1 as the value is below, equal to or above `other`. */
    cmp(self, other: *Big[N]) -> int
        if self.len != other.len then return if self.len < other.len then -1 else 1

        var i = self.len

        while i > 0
            i -= 1

            if self.limbs[i] != other.limbs[i] then return if self.limbs[i] < other.limbs[i] then -1 else 1

        0
    end cmp

    /** The value less `q * other`, which must not be larger than it. */
    sub_mul(*self, other: *Big[N], q: u32)
        var carry: u64 = 0
        var borrow: u64 = 0

        for i in 0..<self.len
            var take = borrow

            if i < other.len
                val p = u64(other.limbs[i]) * u64(q) + carry

                carry = p >> 32
                take += p & 0xffffffff
            else
                take += carry
                carry = 0
            end if

            val cur = u64(self.limbs[i])

            if cur >= take
                self.limbs[i] = u32(cur - take)
                borrow = 0
            else
                self.limbs[i] = u32(cur + 0x100000000 - take)
                borrow = 1
        end for

        while self.len > 0 && self.limbs[self.len - 1] == 0
            self.len -= 1
    end sub_mul

    /** The 64 bits of the value starting `shift` bits up, which must be all of what is there. */
    window(self, shift: usize) -> u64
        val w = shift / 32
        val b = shift % 32
        var acc: u128 = 0

        for j in w..<w + 3
            if j < self.len then acc |= u128(self.limbs[j]) << (32 * (j - w))

        u64(acc >> b)
    end window

    /** `floor(self / other)`, which must be below ten, leaving the remainder in `self`. The quotient
     * is estimated from the top sixty bits of both, which is never more than one or two short, and
     * the subtraction is finished one `other` at a time.
     */
    digit(*self, other: *Big[N]) -> u32
        val bits = other.bit_len()
        val shift = if bits > 60 then bits - 60 else 0
        val top = other.window(shift)
        val mine = self.window(shift)
        var q = u32(if shift == 0 then mine / top else mine / (top + 1))

        if q > 0 then self.sub_mul(other, q)

        while self.cmp(other) >= 0
            self.sub_mul(other, 1)
            q += 1

        q
    end digit
end Big

/** How many bits `x` takes. */
private[sysl] bits_of(x: u32) -> usize
    var n: usize = 0
    var v = x

    while v != 0
        n += 1
        v >>= 1

    n
end bits_of

private[sysl] bits_of64(x: u64) -> usize =
    if (x >> 32) != 0 then 32 + bits_of(u32(x >> 32)) else bits_of(u32(x))

private[sysl] bits_of128(x: u128) -> usize =
    if (x >> 64) != 0 then 64 + bits_of64(u64(x >> 64)) else bits_of64(u64(x))

private small_pow5(n: int) -> u32
    var p: u32 = 1

    for _ in 0..<n
        p *= 5

    p
end small_pow5

/** A float taken apart: its sign, which kind of value it is, and for a finite non-zero one the
 * integers `m` and `e` with the value `m * 2^e`.
 */
private[sysl] struct FloatValue
    negative: bool
    kind: FloatKind
    m: u128
    e: int

private[sysl] enum FloatKind
    Zero
    Finite
    Infinite
    NotANumber

private[sysl] real_value(x: real) -> FloatValue
    val bits = x.bits()
    val negative = bits >> 63 != 0
    val biased = int((bits >> 52) & 0x7ff)
    val fraction = bits & 0xfffffffffffff

    if biased == 0x7ff
        return FloatValue(negative, if fraction == 0 then Infinite else NotANumber, 0, 0)

    if biased == 0
        if fraction == 0 then return FloatValue(negative, Zero, 0, 0)

        return FloatValue(negative, Finite, u128(fraction), -1074)

    FloatValue(negative, Finite, u128(fraction | (u64(1) << 52)), biased - 1075)
end real_value

private[sysl] f32_value(x: f32) -> FloatValue
    val bits = x.bits()
    val negative = bits >> 31 != 0
    val biased = int((bits >> 23) & 0xff)
    val fraction = u64(bits & 0x7fffff)

    if biased == 0xff
        return FloatValue(negative, if fraction == 0 then Infinite else NotANumber, 0, 0)

    if biased == 0
        if fraction == 0 then return FloatValue(negative, Zero, 0, 0)

        return FloatValue(negative, Finite, u128(fraction), -149)

    FloatValue(negative, Finite, u128(fraction | (u64(1) << 23)), biased - 150)
end f32_value

/** An `f128` taken apart at its own width: 112 bits of fraction under a fifteen-bit exponent, so the
 * significand needs a `u128` and nothing about it passes through a narrower float.
 */
private[sysl] quad_value(x: f128) -> FloatValue
    val bits = x.bits()
    val negative = bits >> 127 != 0
    val biased = int((bits >> 112) & 0x7fff)
    val fraction = bits & ((u128(1) << 112) - 1)

    if biased == 0x7fff
        return FloatValue(negative, if fraction == 0 then Infinite else NotANumber, 0, 0)

    if biased == 0
        if fraction == 0 then return FloatValue(negative, Zero, 0, 0)

        return FloatValue(negative, Finite, fraction, -16494)

    FloatValue(negative, Finite, fraction | (u128(1) << 112), biased - 16495)
end quad_value

/** The decimal digits of `m * 2^e` (`m` not zero), rounded half to even at one position, written into
 * `into` as ASCII with no trailing zeros. It answers how many it wrote and the power of ten the first
 * one stands for: `("125", 2)` is 125, `("125", -1)` is 0.125.
 *
 * The position is `significant` digits below the first, or where that is zero or less, the digit
 * standing for `10^last`. Rounding up can carry into a new first digit -- 9.96 to one decimal is 10.0
 * -- and the power reported is the one after the carry. A value that rounds to nothing answers no
 * digits; one that rounds up to the position's unit answers `"1"` there.
 *
 * `into` holds every digit asked for that is not a zero: 800 for any request at all of a `real` or an
 * `f32`, and 11,600 of an `f128`, whose subnormals run to 11,563 significant digits.
 *
 * **The big integers are sized by the value**: a `real`'s and an `f32`'s fit in 1,280 bits, and an
 * `f128`'s -- whose exponent reaches 2^16383 and 2^-16494 -- take up to 16,800, so only a value
 * outside the narrower range pays for the wider arithmetic.
 */
private[sysl] float_digits(m: u128, e: int, significant: int, last: int, into: []u8) -> (usize, int)
    if (m >> 64) == 0 && e >= -1100 && e <= 1000
        var r: Big[40] = Big([0; 40], 0)
        var s: Big[40] = Big([0; 40], 0)

        return decimal_digits(&r, &s, m, e, significant, last, into)
    end if

    var r: Big[QuadLimbs] = Big([0; QuadLimbs], 0)
    var s: Big[QuadLimbs] = Big([0; QuadLimbs], 0)

    decimal_digits(&r, &s, m, e, significant, last, into)
end float_digits

/** How many 32-bit limbs hold every integer exact conversion of an `f128` builds: its largest value
 * and its smallest subnormal, each scaled by the power of ten that brings it into [1, 10), and ten
 * times that for the comparison against the next power.
 */
private[sysl] const QuadLimbs: usize = 530

private decimal_digits[const N: usize](r: *Big[N], s: *Big[N], m: u128, e: int, significant: int,
                                       last: int, into: []u8) -> (usize, int)
    r.set(m)
    s.set(1)

    if e >= 0 then r.shl(e) else s.shl(-e)

    // The power of ten of the first digit: floor(log10(v)), estimated from floor(log2(v)) and then
    // corrected so that r / s lands in [1, 10).
    var k = ((int(bits_of128(m)) - 1 + e) * 78913) >> 18

    if k >= 0 then s.mul_pow10(k) else r.mul_pow10(-k)

    while r.cmp(s) < 0
        r.mul_small(10)
        k -= 1

    var ten = *s

    ten.mul_small(10)

    while r.cmp(&ten) >= 0
        *s = ten
        ten.mul_small(10)
        k += 1

    val stop = if significant > 0 then k - significant + 1 else last

    if stop > k
        // Every digit is below the position. Only a value of at least half its unit rounds to it,
        // which needs the first digit one place below: then v / 10^stop is r / 10s, in [0.1, 1).
        if stop == k + 1
            var twice = *r

            twice.shl(1)

            if twice.cmp(&ten) > 0
                into[0] = u8('1')
                return (1, stop)
        end if

        return (0, stop)
    end if

    var count: usize = 0
    var at = k

    loop
        into[count] = u8('0') + u8(r.digit(s))
        count += 1

        if at == stop || r.is_zero() || count == into.len then break

        r.mul_small(10)
        at -= 1

    if !r.is_zero()
        var twice = *r

        twice.shl(1)

        val c = twice.cmp(s)
        val odd = (into[count - 1] - u8('0')) % 2 == 1

        if c > 0 || (c == 0 && odd)
            var i = count
            var carried = true

            while i > 0 && carried
                i -= 1

                if into[i] == u8('9')
                    into[i] = u8('0')
                else
                    into[i] += 1
                    carried = false

            if carried
                into[0] = u8('1')
                count = 1
                k += 1
        end if
    end if

    while count > 0 && into[count - 1] == u8('0')
        count -= 1

    (count, k)
end decimal_digits

/** What a float conversion was asked for: `%e`, `%f`, `%g` or `%a` (or the upper-case `%E`, `%F`,
 * `%G`, `%A`), a minimum field width, a precision (-1 where none was written) and C's five flags.
 */
private[sysl] struct FloatField
    conv: u8
    width: int
    prec: int
    left: bool
    plus: bool
    space: bool
    zero: bool
    alt: bool

/** `v` rendered under `f` into `out`, flag for flag as C renders a `double`: `%f` is fixed point, `%e`
 * one digit, a point and an exponent of at least two digits, and `%g` whichever of the two the
 * precision and the exponent choose, with its trailing zeros dropped unless `#` keeps them. An
 * infinity is `inf` and a NaN `nan` (upper case under an upper-case conversion), a NaN carrying no
 * sign, and neither is padded with zeros. `%a` is `write_hex_field`'s. `into` is where the digits are
 * worked out; it has to hold `float_scratch_need(v, f)` bytes, which 800 always is for a `real` or an
 * `f32` and 11,600 for an `f128`.
 */
private[sysl] write_float_field(out: *Writer, v: FloatValue, f: FloatField, into: []u8)
    val conv = f.conv | 0x20
    val upper = f.conv != conv

    var sign: [1]u8 = [0]

    if v.kind != NotANumber
        sign[0] = if v.negative then u8('-') else if f.plus then u8('+') else if f.space then u8(' ') else 0

    val signs = if sign[0] != 0 then 1 else 0

    if v.kind == Infinite || v.kind == NotANumber
        val word = if v.kind == Infinite then (if upper then "INF" else "inf")
        else (if upper then "NAN" else "nan")
        val pad = f.width - 3 - signs

        if !f.left then display_fill(out, 32, pad)
        if signs != 0 then out.write(sign[..])
        out.write(word.bytes)
        if f.left then display_fill(out, 32, pad)
        return
    end if

    if conv == u8('a')
        write_hex_field(out, v, f, sign[0], upper)
        return

    val prec = if f.prec < 0 then 6 else f.prec
    var count: usize = 0
    var k = 0
    var fixed = conv == u8('f')
    var frac = prec

    if conv == u8('g')
        val p = if prec == 0 then 1 else prec

        if v.kind == Finite
            val got = float_digits(v.m, v.e, p, 0, into)

            count = got.0
            k = got.1
        end if

        fixed = p > k && k >= -4
        frac = if fixed then p - 1 - k else p - 1

        if !f.alt
            val needed = if fixed then int(count) - 1 - k else int(count) - 1

            if needed < frac then frac = if needed > 0 then needed else 0
        end if
    elif v.kind == Finite
        val got = if fixed then float_digits(v.m, v.e, 0, -prec, into)
        else float_digits(v.m, v.e, prec + 1, 0, into)

        count = got.0
        k = got.1
    end if

    if count == 0 then k = 0

    val point = frac > 0 || f.alt
    var exp_text: [24]u8
    var exp_at: usize = 24
    var body = 0

    if fixed
        body = (if k >= 0 then k + 1 else 1) + (if point then 1 else 0) + frac
    else
        val magnitude = if k < 0 then -k else k

        exp_at = digits_ulong(ulong(magnitude), exp_text[..])

        if magnitude < 10
            exp_at -= 1
            exp_text[exp_at] = u8('0')

        exp_at -= 1
        exp_text[exp_at] = if k < 0 then u8('-') else u8('+')
        exp_at -= 1
        exp_text[exp_at] = if upper then u8('E') else u8('e')
        body = 1 + (if point then 1 else 0) + frac + int(24 - exp_at)
    end if

    val pad = f.width - body - signs

    if !f.left && !f.zero then display_fill(out, 32, pad)
    if signs != 0 then out.write(sign[..])
    if !f.left && f.zero then display_fill(out, 48, pad)

    if fixed
        if k >= 0 then write_positions(out, into, count, k, k, 0) else out.write("0".bytes)
        if point then out.write(".".bytes)

        write_positions(out, into, count, k, -1, -frac)
    else
        write_positions(out, into, count, k, k, k)
        if point then out.write(".".bytes)

        write_positions(out, into, count, k, k - 1, k - frac)
        out.write(exp_text[exp_at..])
    end if

    if f.left then display_fill(out, 32, pad)
end write_float_field

/** How many bytes of `into` `write_float_field` needs to render `v` under `f` -- an upper bound on the
 * digits it works out: the precision's count for `%e` and `%g`, the places from the first digit down
 * to the precision's for `%f`, and never more than the exact value has, so 800 is enough for any
 * request of a `real` or an `f32` and 11,600 of an `f128`. A zero, an infinity, a NaN and every `%a`
 * need none.
 */
private[sysl] float_scratch_need(v: FloatValue, f: FloatField) -> usize
    val conv = f.conv | 0x20

    if v.kind != Finite || conv == u8('a') then return 0

    val bits = long(bits_of128(v.m))
    val e = long(v.e)
    val prec = if f.prec < 0 then long(6) else long(f.prec)

    // 78914 / 2^18 is log10(2) from above and 183231 / 2^18 log10(5), so `top` is at least the power
    // of ten of the first digit, and `held` at least the count of significant digits m * 2^e has.
    val top = (((bits + e) * 78914) >> 18) + 1
    val held = if e >= 0 then top + 1 else ((bits * 78914) >> 18) + ((-e * 183231) >> 18) + 3

    var asked = prec + 1

    if conv == u8('g') then asked = if prec == 0 then 1 else prec
    if conv == u8('f') then asked = top + prec + 1

    val need = if asked < held then asked else held

    if need < 1 then 1 else usize(need)
end float_scratch_need

// `%a`: `v` as a hexadecimal significand and a binary exponent, C's `[-]0xh.hhhp±d`. The first digit is
// 1 for every value but zero, a subnormal included, and the fraction is every hexadecimal digit the
// value holds -- or, under a precision, that many digits rounded half to even, a carry out of the
// fraction making the first digit 2. `0` pads after the `0x`, as C's does.
private write_hex_field(out: *Writer, v: FloatValue, f: FloatField, sign: u8, upper: bool)
    var lead: u128 = 0
    var frac: u128 = 0
    var held = 0
    var exp = 0

    if v.kind == Finite
        val n = int(bits_of128(v.m)) - 1

        held = (n + 3) / 4
        lead = 1
        frac = (v.m - (u128(1) << n)) << (4 * held - n)
        exp = v.e + n
    end if

    var shown = if f.prec < 0 then held else f.prec

    if f.prec < 0
        while shown > 0 && ((frac >> (4 * (held - shown))) & 0xF) == 0
            shown -= 1
    elif shown < held
        val drop = 4 * (held - shown)
        val rest = frac & ((u128(1) << drop) - 1)
        val half = u128(1) << (drop - 1)

        frac = frac >> drop
        held = shown

        val odd = ((if shown == 0 then lead else frac) & 1) == 1

        if rest > half || (rest == half && odd)
            frac += 1

            if frac == u128(1) << (4 * shown)
                frac = 0
                lead += 1
        end if
    end if

    val point = shown > 0 || f.alt
    val hex = if upper then "0123456789ABCDEF" else "0123456789abcdef"
    var exp_text: [24]u8
    var exp_at = digits_ulong(ulong(if exp < 0 then -exp else exp), exp_text[..])

    exp_at -= 1
    exp_text[exp_at] = if exp < 0 then u8('-') else u8('+')
    exp_at -= 1
    exp_text[exp_at] = if upper then u8('P') else u8('p')

    var head: [3]u8 = [u8('0'), if upper then u8('X') else u8('x'), hex.bytes[usize(lead)]]
    var digits: [32]u8
    val written = if shown < held then shown else held

    for i in 0..<written
        digits[i] = hex.bytes[usize((frac >> (4 * (held - 1 - i))) & 0xF)]

    var sign_text: [1]u8 = [sign]
    val signs = if sign != 0 then 1 else 0
    val pad = f.width - signs - 3 - (if point then 1 else 0) - shown - int(24 - exp_at)

    if !f.left && !f.zero then display_fill(out, 32, pad)
    if signs != 0 then out.write(sign_text[..])
    out.write(head[0..<2])
    if !f.left && f.zero then display_fill(out, 48, pad)
    out.write(head[2..])
    if point then out.write(".".bytes)
    out.write(digits[0..<usize(written)])
    display_fill(out, 48, shown - written)
    out.write(exp_text[exp_at..])
    if f.left then display_fill(out, 32, pad)
end write_hex_field

// The digits standing for 10^hi down to 10^lo, where the first of `count` digits stands for 10^k
// and every other position holds a zero.
private write_positions(out: *Writer, digits: []u8, count: usize, k: int, hi: int, lo: int)
    if hi < lo then return

    var at = hi

    if at > k
        val zeros = if at - k < hi - lo + 1 then at - k else hi - lo + 1

        display_fill(out, 48, zeros)
        at -= zeros
    end if

    if at < lo then return

    val first = k - at
    var final = k - lo

    if final > int(count) - 1 then final = int(count) - 1

    if first <= final
        out.write(digits[usize(first)..<usize(final + 1)])
        at = k - final - 1

    if at >= lo then display_fill(out, 48, at - lo + 1)
end write_positions
