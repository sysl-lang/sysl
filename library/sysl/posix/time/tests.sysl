module sysl.posix.time
@requires(posix)
@tests

import sysl.time.{Resolution, parse_timestamp, since}

// What `sysl.posix.time` claims, asserted in sysl.
//
// **These were the only check on the two clock ids and on the `struct timespec` mirror, and there is
// now neither.** Both moved into a shim beside the module, where the header answers for them, so
// what these assert is no longer a transcription somebody typed but a shim that has to compile,
// link, and mean what it says. That is a weaker thing to get wrong and a stronger thing to test:
// there is no longer any way for the *numbers* to be wrong on a platform nobody ran on.
//
// They stay in sysl rather than moving to Scala, and the reason is unchanged: `StdSelfTests` compiles
// this tree on the development machine and again on CI's Linux runner, where `CLOCK_MONOTONIC` is a
// different number and where this machine cannot read a header. A shim is compiled per target too,
// so the thing being checked still differs between the two runs.
//
// Every assertion below is written to survive a slow machine and a loaded one. Nothing here asserts
// an upper bound on how long anything took.

const us_per_second: long = 1000000

// 2020-01-01T00:00:00Z and 2100-01-01T00:00:00Z, in microseconds from 1970. Wide enough that no
// clock a person would tolerate falls outside, and narrow enough that a reading which is not a wall
// clock at all cannot land inside by accident.
const after_2020: long = 1577836800 * us_per_second
const before_2100: long = 4102444800 * us_per_second

// Something the optimizer cannot fold to a closed form, so that measurable time actually passes. A
// running sum is not enough: `n += i` over a range is Gauss's formula and LLVM knows it, which cost
// a confusing `elapsed 0us` while this module was being written.
private churn(rounds: int) -> long
    var n: long = 1

    for i in 0..<rounds
        n = n * 31 + long(i)

    n
end churn

@test("the wall clock reads a plausible date, which is what says the shim reads the right clock")
wall_clock_is_a_date()
    val us = now().us

    // A shim reading the wrong clock lands here: `CLOCK_MONOTONIC` counts from boot, so it is a few
    // days rather than fifty-odd years and falls below the lower bound. So does one that scales
    // wrongly on the way out -- nanoseconds handed back as microseconds are a thousand times too
    // large, and seconds alone a million times too small.
    assert(us > after_2020, "the wall clock reads before 2020")
    assert(us < before_2100, "the wall clock reads after 2100")
end wall_clock_is_a_date

@test("the monotonic clock is not the wall clock, which is the other half of the same mistake")
monotonic_is_not_the_wall_clock()
    // Uptime, not a date. This fails if the shim's two clocks are swapped and the test above somehow
    // did not,
    // and it is the assertion that would still be here if `now` were ever removed.
    assert(monotonic().us < after_2020, "the monotonic clock reads like a date, not an uptime")
end monotonic_is_not_the_wall_clock

@test("the monotonic clock advances over work, and never backwards over any of it")
monotonic_advances()
    val a = monotonic()

    val work = churn(2000000)

    val b = monotonic()

    // The whole point of the type: `b - a` is a `Duration` and the compiler would refuse it as an
    // `Instant`, which is what stops a measurement being mistaken for a timestamp.
    val elapsed = b - a

    assert(elapsed.us >= 0, "the monotonic clock went backwards")
    assert(elapsed.us > 0, "two million rounds took under a microsecond")

    // So the loop cannot be discarded as dead, which would take the measurement with it.
    assert(work != 0)
end monotonic_advances

@test("reading it twice in a row never goes backwards, however close together the two are")
monotonic_never_retreats()
    var last = monotonic()

    for i in 0..<1000
        val next = monotonic()

        assert((next - last).us >= 0, "the monotonic clock went backwards between two reads")

        last = next
end monotonic_never_retreats

@test("the wall clock advances, which says it is being read rather than remembered")
wall_clock_advances()
    val a = now()

    val work = churn(2000000)

    // `since` rather than `-` for the same reason it exists: it says which end is which.
    val elapsed = since(now(), a)

    assert(elapsed.us > 0, "the wall clock did not move over two million rounds")
    assert(work != 0)
end wall_clock_advances

// -- the host's zone --------------------------------------------------------------------------------
//
// **Nothing here may assume which zone the machine is set to**, since this tree is compiled and run
// on the development machine and again on CI's Linux runner, and `TZ` may be anything or unset. So
// every assertion below is an invariant that holds in every zone -- which is the stronger kind
// anyway: a test asserting `-05:00` would pass in one place and fail in the next without either
// being wrong.

@test("the host's offset from UTC is one a zone could actually have")
local_offset_is_plausible()
    val m = local_offset(now()).minutes

    // -12:00 to +14:00 is the whole range the database uses. A shim answering seconds rather than
    // minutes lands far outside it, and so does one reading an uninitialized `struct tm`.
    assert(m >= -720, "the host is set more than twelve hours behind UTC")
    assert(m <= 840, "the host is set more than fourteen hours ahead of UTC")
end local_offset_is_plausible

@test("the host's own wall clock reading resolves back to the instant it came from")
local_round_trips()
    val t = now()

    // A reading taken *from* an instant is one the clocks did show, so a gap is unreachable here and
    // asserting so is what would catch a `resolve` that had the two candidates backwards.
    from_local(local(t)) match
        Unique(at) -> assert(at == t, "the host's reading resolved to a different instant")
        Ambiguous(earlier, later) ->
            assert(earlier == t || later == t, "neither instant of the repeated hour was the original")
        Gap(before, after) -> assert(false, "an instant produced a reading no clock ever showed")
end local_round_trips

@test("a local timestamp is read back as the instant it was written from")
local_text_round_trips()
    val t = now()

    // Through the renderer and the parser, which is the pair a program actually uses -- and the one
    // place the offset this module computes has to agree with the offset `timestamp_text` writes.
    parse_timestamp(local_text(t)) match
        Ok(back) -> assert(back == t, "a local timestamp did not read back as itself")
        Err(e) -> assert(false, f"a local timestamp would not parse: $e%s")
end local_text_round_trips

@test("the offset is a property of the instant, not of when it was asked")
local_offset_is_stable()
    val t = now()

    val a = local_offset(t)
    val work = churn(100000)
    val b = local_offset(t)

    assert(a == b, "the same instant gave two different offsets")
    assert(work != 0)
end local_offset_is_stable
