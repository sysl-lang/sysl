module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture
import sysl.text.cstring

// A closure the closure analysis laid in the frame and then handed to a call that keeps a share of it
// in what it answers -- a factory's box laid in the same frame, a struct answered by value -- lives
// as long as that answer does (`frame_counts.sysl`'s `FrameRoot.walked`). The compiler counted such a
// closure's shares as if the callee gave its own back before returning, and tore its captures down at
// the end of the statement: syslUI's `derived(() -> first.read())` then read a freed `Signal` and
// answered garbage ("got 4, want 2", " Lovelace" for "Ada Lovelace").
//
// The axes: what the callee answers (a generic factory's frame box, a concrete factory's, a struct by
// value), what the closure answers (a short string, a long one, an int, an interpolation of two
// captures), the syslUI shape (an epoch, a write through `*self`, a recomputation on read), and the
// builds (-O0, -O2, the counted heap, AddressSanitizer). A capture with a destructor prints when its
// last share goes, so an early teardown shows in the output and not only as a crash. The one shape the
// compiler still counts -- a closure handed to a call answering no address -- keeps its teardown.
//
// Skipped cells, and why: a table call is left counted for a closure frame already (`table_arg`
// answers `None` where the walk noted nothing), so it has no cell of its own; codegen units and a
// library build change nothing, the pass running on each body as it is finished.

// -- the harness ----------------------------------------------------------------------------------

private struct FkcRun
    out: string
    err: string
    instrumented: bool
end FkcRun

// The program built at optimization `level` with `flags` handed to clang (on the counted heap where
// there are none), and run.
private fkc_run(text: string, level: string, flags: string) -> FkcRun
    val root = make_temp_dir("sysl-fkc").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", forms_imported(text)).unwrap()

    val exe = s"$root/built"

    if flags != ""
        val n = cstring("SYSL_EXTRA_CFLAGS")
        val v = cstring(flags)

        fkc_c_setenv(n.ptr, v.ptr, 1)
    end if

    force_alloc_counting(flags == "")

    val made = build_native_program(s"$root/main.sysl", None, None, level, Some(exe))

    force_alloc_counting(false)

    if flags != ""
        val n = cstring("SYSL_EXTRA_CFLAGS")

        fkc_c_unsetenv(n.ptr)
    end if

    made match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return FkcRun(failure_text(why), "", false)
        Ok(_) -> ()

    val symbols = capture("/usr/bin/nm", ["-u", exe], "", [], true)
    val instrumented = symbols match
        Ok(o) -> o.text.contains("___asan_report")
        Err(_) -> false

    val ran = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    ran match
        Err(_) -> FkcRun("could not be started", "", false)
        Ok(o) -> FkcRun(o.text, o.err.unwrap_or(""), instrumented)
end fkc_run

private extern "setenv" fkc_c_setenv(name: *u8, value: *u8, overwrite: int) -> int
private extern "unsetenv" fkc_c_unsetenv(name: *u8) -> int

// The lines of `main`'s body in the program's LLVM text.
private fkc_main(text: string) -> Buf[string]
    val root = make_temp_dir("sysl-fkc").unwrap()

    write_text(s"$root/main.sysl", forms_imported(text)).unwrap()

    val ir = emit_llvm_text(s"$root/main.sysl", None) match
        Err(why) -> failure_text(why)
        Ok(made) -> if made.report.is_empty() then made.text else analysis_report(made.report)

    remove_dir_all(root).unwrap_or(())

    var out: Buf[string] = buf()
    var inside = false

    for line in lines_of(ir).view()
        if !inside && line.starts_with("define") && line.contains("@$$main(") then inside = true

        if inside
            out.push(line)

            if line == "}" then break
        end if
    end for

    assert(!out.is_empty(), s"no main in:\n$ir")
    out
end fkc_main

private fkc_count(lines: Buf[string], part: string) -> int
    var n = 0

    for line in lines.view()
        if line.contains(part) then n += 1

    n
end fkc_count

// -- the cells --------------------------------------------------------------------------------------

// The reduction of syslUI's `derived` over a `Signal[string]`: a generic factory laid in the frame
// keeps the closure, which reads a box it captured.
private const fkc_generic_short: string = raw"""
    struct Cell[T]
        value: T
        read(self) -> T = self.value

    struct Kept[T]
        compute: &Fn() -> T
        cached: T
        seen: int

        read(*self) -> T
            if self.seen != 0
                self.cached = (self.compute)()
                self.seen = 0
            self.cached

    kept[T](f: &Fn() -> T) -> &Kept[T] = Kept(f, f(), -1)

    main()
        val c: &Cell[string] = Cell("Ada")
        val k = kept(() -> c.read())

        print(k.read())
        print(c.read())
    """

private const fkc_generic_long: string = raw"""
    struct Cell[T]
        value: T
        read(self) -> T = self.value

    struct Kept[T]
        compute: &Fn() -> T
        cached: T
        seen: int

        read(*self) -> T
            if self.seen != 0
                self.cached = (self.compute)()
                self.seen = 0
            self.cached

    kept[T](f: &Fn() -> T) -> &Kept[T] = Kept(f, f(), -1)

    main()
        val c: &Cell[string] = Cell("Augusta Ada King, Countess of Lovelace")
        val k = kept(() -> c.read())

        print(k.read())
    """

private const fkc_generic_int: string = raw"""
    struct Cell[T]
        value: T
        read(self) -> T = self.value

    struct Kept[T]
        compute: &Fn() -> T
        cached: T
        seen: int

        read(*self) -> T
            if self.seen != 0
                self.cached = (self.compute)()
                self.seen = 0
            self.cached

    kept[T](f: &Fn() -> T) -> &Kept[T] = Kept(f, f(), -1)

    main()
        val c: &Cell[int] = Cell(21)
        val k = kept(() -> c.read() * 2)

        print(k.read())
    """

// A concrete factory, and a capture whose destructor says when its last share went.
private const fkc_concrete: string = raw"""
    struct Res
        name: string

    impl Drop for Res
        drop(self) = print("closed", self.name)

    struct Named
        compute: &Fn() -> string
        cached: string

        read(*self) -> string
            self.cached = (self.compute)()
            self.cached

    named(f: &Fn() -> string) -> &Named = Named(f, f())

    main()
        val r: &Res = Res("Ada")
        val n = named(() -> r.name)

        print("built")
        print(n.read())
        print("end")
    """

// A struct answered by value holds the closure: it is the answer that keeps the share.
private const fkc_by_value: string = raw"""
    struct Res
        name: string

    impl Drop for Res
        drop(self) = print("closed", self.name)

    struct Wrap
        f: &Fn() -> string

    wrap(f: &Fn() -> string) -> Wrap = Wrap(f)

    main()
        val r: &Res = Res("Ada")
        val w = wrap(() -> r.name)

        print("built")
        print((w.f)())
        print("end")
    """

// syslUI's shape: an epoch moved by every write, a derivation recomputed on read when it has moved,
// over an interpolation of two captured signals and over an int.
private const fkc_signals: string = raw"""
    struct Clock
        writes: int

    struct Sig[T]
        clock: &Clock
        value: T

        read(self) -> T = self.value

        set(*self, v: T)
            self.value = v
            self.clock.writes += 1

    struct Der[T]
        clock: &Clock
        compute: &Fn() -> T
        cached: T
        seen: int

        read(*self) -> T
            val now = self.clock.writes

            if self.seen != now
                self.cached = (self.compute)()
                self.seen = now

            self.cached

    sig[T](clock: &Clock, v: T) -> &Sig[T] = Sig(clock, v)

    der[T](clock: &Clock, f: &Fn() -> T) -> &Der[T] = Der(clock, f, f(), -1)

    main()
        val clock: &Clock = Clock(0)
        val first = sig(clock, "Ada")
        val last = sig(clock, "Lovelace")
        val full = der(clock, () -> first.read() + " " + last.read())

        print(full.read())
        first.set("Augusta")
        print(full.read())

        val n = sig(clock, 1)
        val twice = der(clock, () -> n.read() * 2)

        n.set(2)
        print(twice.read())
    """

// A closure handed to a call that answers no address is still counted by the compiler.
private const fkc_lent: string = raw"""
    struct Res
        n: int

    impl Drop for Res
        drop(self) = print("closed", self.n)

    run(f: &Fn() -> int) -> int = f()

    main()
        val r: &Res = Res(10)

        print(run(() -> r.n + 1))
        print("end")
    """

private fkc_cells() -> Buf[(string, string)]
    var out: Buf[(string, string)] = buf()

    out.push((fkc_generic_short, "Ada\nAda\n"))
    out.push((fkc_generic_long, "Augusta Ada King, Countess of Lovelace\n"))
    out.push((fkc_generic_int, "42\n"))
    out.push((fkc_concrete, "built\nAda\nend\nclosed Ada\n"))
    out.push((fkc_by_value, "built\nAda\nend\nclosed Ada\n"))
    out.push((fkc_signals, "Ada Lovelace\nAugusta Lovelace\n4\n"))
    out.push((fkc_lent, "11\nend\nclosed 10\n"))
    out
end fkc_cells

@test("a framed closure kept by what a call answers lives as long as the answer, at -O0 and -O2")
fkc_kept_closure_lives()
    if !enm_ready() then return

    for level in ["0", "2"]
        for cell in fkc_cells()
            val got = fkc_run(cell.0, level, "")

            assert_eq(got.out, cell.1)
            assert_eq(alloc_count_reported(got.err), 0)
        end for
    end for
end fkc_kept_closure_lives

@test("and under AddressSanitizer: instrumented, and nothing read after its teardown")
fkc_kept_closure_under_asan()
    if !enm_ready() then return

    for cell in fkc_cells()
        val got = fkc_run(cell.0, "1", "-fsanitize=address -g")

        assert(got.instrumented, "the binary calls no AddressSanitizer report")
        assert_eq(got.out, cell.1)
        assert_eq(got.err, "")
    end for
end fkc_kept_closure_under_asan

@test("a closure kept by an answer is counted at run time; one lent to a call answering an int is not")
fkc_which_closures_are_counted()
    if xvr_no_library() then return

    for text in [fkc_generic_short, fkc_concrete, fkc_by_value]
        val body = fkc_main(text)

        assert_eq(fkc_count(body, "@arc.framedown.$closure"), 0)
    end for

    assert_eq(fkc_count(fkc_main(fkc_lent), "@arc.framedown.$closure"), 1)
end fkc_which_closures_are_counted
