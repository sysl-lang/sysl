module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.math.bigint.from_int
import sysl.text.{from_utf8_unchecked, str_builder, Search, StrBuilder}

// Reaching a member: what a type declares of its own, what a trait gave it, and what a table
// dispatches to when the value has forgotten which type it holds.
//
// **A member is an ordinary function under a mangled name**, so a call on a value is a call and the
// only question here is which function. The receiver is passed as the first argument, in whatever
// memory mode the member's `self` asked for.

// `value.member` -- a property read, or a member named without the parentheses it needs.
//
// The reader wrote no parentheses, so what answers is a property; everything else is told what it is
// and how to write it, which is the whole of what a message about a member owes.
lookup_trait_member(cx: &Analyzer, span: Span, receiver: TExpr, name: string, args: Buf[Expr],
                    expected: Option[Type], via: Buf[string] = no_bound_traits()) -> TExpr
    val rty = receiver_type(texpr_type(receiver))

    rty match
        // A parameter standing in for itself, during the walk that checks a generic body once at its
        // own definition: what it can promise is exactly what its bounds promise.
        Abstract(_, bounds) -> read_bound_property(cx, span, receiver, rty, name, bounds)
        // A trait object's property is a slot like any other member, dispatched through the table.
        Trait(_, _, _) -> read_erased(cx, span, receiver, rty, name)
        _ ->
            val found = member_key(cx.an, rty, name)
            // A name a type's own body overloads is a set of methods and never a property, so the
            // first of them answers the read with what a method read without a call is told.
            val first = member_at(cx.an, found.0, name)
            val overloaded = first.is_some() && !first.unwrap().is_property &&
                             cx.an.tables.members.from_trait.get(member_key_of(found.0, name)).is_none() &&
                             cx.an.tables.members.alts.has(member_key_of(found.0, name))
            val chosen = if overloaded then Some(name) else
                chosen_member(cx, rty, found.0, name, span, buf(), via)

            if chosen.is_none() then return bad_expr(span)

            val m = member_at(cx.an, found.0, chosen.unwrap())

            if m.is_none() then return no_such_member(cx, span, rty, name)

            val decl = m.unwrap()

            // A **static** property belongs to the type, so it takes no receiver and the function
            // it lowered to has no parameter for one to arrive in. The mirror of the refusal a
            // *type* gets for an instance property, and it says which of the two the reader wanted
            // rather than that the name is unknown -- the name is right and the thing on the left
            // of the dot is not.
            if decl.is_property && decl.is_static then
                return cx.err(span, s"'$name' is a property of the type '${type_show(rty)}' rather " +
                              s"than of a value of it — read it as '${module_bare(found.0)}.$name'")

            if decl.is_property then
                return member_dispatch(cx, span, receiver, rty, found.0, chosen.unwrap(), decl,
                                       buf(), expected, name, via)

            if decl.recv_mode().is_some() then
                return cx.err(span, s"'$name' is a method of '${type_show(rty)}' — call it " +
                              s"with '$name(…)'")

            cx.err(span, s"'$name' is an associated function of '${qualified_name(found.0)}' — call it " +
                   s"with '${qualified_name(found.0)}.$name(…)'")
end lookup_trait_member

// `Box.of(…)`, `u32.bits()`, `Self.width()` -- an associated function, reached through the **type**
// rather than through a value of it.
//
// It is what a bound can say about the type rather than about a value: a parameter is not a name
// anything else can be written through, so without it every fact a generic body needs -- a width, a
// zero, a table of constants -- would have to arrive as a member carrying a receiver nothing reads.
//
// Nothing where the name is not a type, which is what leaves an ordinary member read to answer.
associated_call(cx: &Analyzer, span: Span, receiver: Expr, name: string, args: Buf[Expr],
                expected: Option[Type], targs: Buf[Expr] = no_written_members()) -> Option[TExpr]
    val subject = subject_named(cx, receiver) match
        Some(found) -> Some(found)
        // **A GENERIC type has no instance under its bare name**, so the walk above answers nothing
        // for `Vector.zeros(n)` and the name is reported undefined. What settles which instantiation
        // is meant is the same thing that settles it for a generic function: what receives the
        // result.
        None -> subtype_subject(cx, receiver, name) match
            Some(found) -> Some(found)
            None -> generic_subject(cx, span, receiver, name, args, expected)

    if subject.is_none() then return generic_enum_stranger(cx, span, receiver, name)

    // **A constrained subtype is a type of its own and is not delegated to its base**: what it
    // offers under its own name is the `::` surface, so a member it does not declare is told that
    // rather than reaching the base's `zero` or `width`. An alias answers as what it names. A member
    // it does declare that needs a value -- a method, a property -- is refused in the words the read
    // is ("a method of 'Meters' — call it on a value, as …"), as the reference's `constrainedMember`.
    val declared = member_at(cx.an, member_key(cx.an, subject.unwrap(), name).0, name)

    if declared.is_none() || !declared.unwrap().is_associated() || declared.unwrap().is_property
        val refused = constrained_type_call(cx, span, receiver, name, expected)

        if refused.is_some() then return refused
    end if

    // **The traits the WRITTEN name was bounded by.** `T.zero()` still has the `T` in it, so a body
    // whose signature asked `T` for a `Zero` reaches that trait's `zero` even where the file that
    // instantiated it imported another trait declaring one for the very same type.
    associated_on(cx, span, subject.unwrap(), name, args, expected, written_bound(cx, receiver), targs)
end associated_call

// The call `associated_call` makes once it knows which type the name in front of the dot stands for
// -- and the one a leading dot makes, whose type is the one the position expects rather than one
// anybody wrote (`reference/expressions.md § A leading dot`). The two spellings reach the member
// through this one body, which is what makes them fail in the same words.
associated_on(cx: &Analyzer, span: Span, ty: Type, name: string, args: Buf[Expr],
              expected: Option[Type], via: Buf[string],
              targs: Buf[Expr] = no_written_members()) -> Option[TExpr]
    if ty == Unknown then return Some(bad_expr(span))

    // `u64.wrap(x)` -- the integer conversion that keeps the bit pattern, asked before the type's
    // own members so the spelling means one thing on every integer type.
    if name == "wrap"
        val wrapped = integer_wrap(cx, span, ty, args)

        if wrapped.is_some() then return wrapped
    end if

    // A parameter standing in for itself answers off the bounds it carries, exactly as a value of it
    // does -- and this is the half that has no value to be read off.
    ty match
        Abstract(_, bounds) -> return Some(call_bound_associated(cx, span, ty, name, bounds, args, targs))
        _ -> ()

    // **`Colour.try(n)` is the checked cast that answers rather than traps**, which is what a
    // program reading a number off a wire wants: `Colour(n)` is the same conversion and stops the
    // program where the value is not a discriminant.
    //
    // It is asked **before** the variant and the member, so an enum's `try` is this form whatever
    // else the enum declares -- which is what makes the spelling mean one thing on every enum.
    if name == "try"
        val tried = enum_try(cx, span, ty, args)

        if tried.is_some() then return tried
    end if

    // A **variant** named through its enum is not a member, and `Colour.Red(1)` is how one that
    // carries something is written -- so the enum's own names are left to the form that answers them.
    ty match
        Enum(d) -> if d.variant(name).is_some() then return None
        _ -> ()

    val found = member_key(cx.an, ty, name)

    // `Plain.decode` the compiler supplies answers ahead of a `decode` reached only implicitly
    // (`plain_ahead`).
    if name == "decode" && derived_trait_key(cx, name).is_none() && plain_ahead(cx, ty, found.0, name, via)
        val decoded = plain_decode_call(cx, span, ty, name, args)

        if decoded.is_some() then return decoded
    end if

    var picked = name

    // A bound whose member the compiler supplies for this type is answered by the compiler, whatever
    // other trait gave the type a member of the name.
    if refuse_bound_clash(cx, ty, found.0, name, span, via) then return Some(bad_expr(span))

    val by_bound = bound_supplied_by_compiler(cx, ty, found.0, name, via)

    // **A trait's member may be filed only under a suffix** -- a block whose trait shares some other
    // member's name with a trait the type already implements files ALL of its members suffixed --
    // so the table of alternatives is asked as well as the plain name, exactly as a call through a
    // receiver asks it.
    if !by_bound && (member_at(cx.an, found.0, name).is_some() ||
                     cx.an.tables.members.alts.has(member_key_of(found.0, name)))
        val chosen = chosen_member(cx, ty, found.0, name, span, args, via)

        if chosen.is_none() then return Some(bad_expr(span))

        picked = chosen.unwrap()
    end if

    val m = if by_bound then None else member_at(cx.an, found.0, picked)

    if m.is_none()
        // `Header.decode(bytes)` -- the one receiverless member the compiler provides that takes an
        // argument, given to every plain-data type by `sysl.encoding.Plain`.
        val decoded = plain_decode_call(cx, span, ty, name, args)

        if decoded.is_some() then return decoded

        // A receiverless member the compiler provides is reached through the type, which is exactly
        // the spelling this form is: `uint.zero()` and `u32.width()` are calls with no arguments.
        val provided = builtin_constant_read(cx, span, ty, name)

        if provided.is_some()
            // **The refusal names the TRAIT that declares the member, not the receiver's key.** A
            // width is `Bits`' and an identity is `Zero`'s or `One`'s, and a reader told
            // `'uint.width'` is being sent to a declaration no file wrote.
            if !args.is_empty()
                val given = if args.len() == 1 then "1 argument was"
                else s"${args.len()} arguments were"

                cx.fault(span, s"associated function '${provider_of(name)}.$name' takes no " +
                         s"arguments, but $given given")
            end if

            return provided
        end if

        // An enum's variants are reached through the type by the very spelling an associated
        // function is, so a name that is neither is told about both rather than about half of what
        // it could have been.
        underlying(ty) match
            Enum(_) ->
                return Some(cx.err(span, s"enum '${qualified_name(found.0)}' has no " +
                                   s"variant or associated function '$name'"))
            _ -> ()

        // A declared struct is named as a declaration is, quoted and called a type; a built-in is
        // named the way a type is shown, `u32` as `uint` -- the reference's two spellings.
        underlying(ty) match
            Struct(_) -> return Some(cx.err(span, s"type '${found.0}' has no associated function " +
                                            s"'$name'"))
            _ -> return Some(cx.err(span, s"${type_show(ty)} has no associated function '$name'"))
    end if

    val decl = m.unwrap()

    // **A subject written as a bounded type parameter was refused at the generic's definition**
    // (`call_bound_associated`), where the walk over the body read `T.f(…)` against the bound. Read
    // again at a concrete type, the same call would be told a second time under the concrete name.
    if !via.is_empty() && (decl.recv_mode().is_some() || (decl.is_property && !decl.is_static)) then
        return Some(bad_expr(span))

    val receiving = receiving_member(cx, span, found.0, name, decl)

    if receiving.is_some() then return receiving

    // **A subject whose own arguments miss its bounds was refused where they were written** -- at the
    // annotation, or where the call's arguments settled them -- so the member is not made real at
    // them: its signature would be read at those arguments and refused a second time, at a place
    // nobody wrote.
    if !subject_bounds_met(cx, span, ty) then return Some(bad_expr(span))

    // One declaring type parameters of its own is instantiated from the call, as a method is: the
    // subject settled the type's arguments and the arguments settle the member's.
    val generic = cx.an.tables.members.generic.get(member_key_of(found.0, picked))

    if generic.is_some() && !block_bounds_met(cx, span, generic.unwrap(), found.1) then
        return Some(bad_expr(span))

    // **The condition is asked before the member is made real**: an instantiation the condition
    // refuses would have its body read at arguments the block was written to keep out.
    if !check_impl_condition(cx, span, ty, found.0, picked) then return Some(bad_expr(span))

    if generic.is_some() && generic.unwrap().tparams.len() > found.1.len()
        check_member_visible(cx, span, found.0, picked, decl, via)

        return Some(call_generic_member(cx, span, None, ty, found.0, decl, generic.unwrap(),
                                        found.1, args, expected, name, targs))
    end if

    if !targs.is_empty()
        return Some(cx.err(span, s"'$picked' is not generic, so it has no type arguments to " +
                           s"write — the call is '${qualified_name(found.0)}.$name(…)'"))
    end if

    val fname = member_func_name(cx, span, ty, picked)

    if fname == "" then return Some(bad_expr(span))

    val sig = member_sig(cx.an, fname)

    if sig.is_none() then return Some(bad_expr(span))

    note_member_reference(cx, span, fname, decl)
    check_member_visible(cx, span, found.0, picked, decl, via)

    // The arity names what kind of thing was called, and an argument's refusal names the callee
    // alone -- `'x' of 'Box.of' is int`, as a free function's does.
    val shown = s"associated function '${qualified_name(found.0)}.$picked'"
    val slots = bind_member_args(cx, span, shown, decl, args)

    if slots.is_none() then return Some(bad_expr(span))

    val before = cx.an.complaints()
    var ts: Buf[TExpr] = buf()
    var wants: Buf[Type] = buf()
    var unread: Buf[usize] = buf()

    for i in 0..<slots.unwrap().len()
        val want = walk_wanted(decl.params.at(i), if i < sig.unwrap().params.len()
                                                  then sig.unwrap().params.at(i).1 else Unknown)

        wants.push(want)

        slots.unwrap().at(i) match
            Some(e) -> ts.push(argument_told(cx, e, decl.params.at(i), decl.tparams, want))
            None ->
                val inner = default_reader(cx, span, member_default_scope(cx, fname), fname,
                                           decl.bounds)
                val read = default_at(inner, decl.params.at(i).default.unwrap(), want)

                if read.is_none() then unread.push(i)

                ts.push(read.unwrap_or(bad_expr(span)))

    val refused = refused_argument(cx, span, s"'${qualified_name(found.0)}.$picked'", decl.params,
                                   slots.unwrap(), ts, wants, before, true, unread)

    if refused.is_some() then return refused

    for i in 0..<slots.unwrap().len()
        ts.set(i, handed_walk(decl.params.at(i), slots.unwrap().at(i), ts.at(i)))

    val tail = member_tail(cx, decl, args)

    for item in tail
        ts.push(item)

    check_crossings(cx, decl.crossing, decl.marks.copies, shown, sig.unwrap().params, ts)
    check_shared_result(cx, span, sig.unwrap().ret)
    cx.an.uses(fname)

    if decl.marks.answers_place then return Some(placed_call(cx, span, fname, ts, sig.unwrap().ret))

    Some(TExpr(span, TCall(fname, ts, sig.unwrap().ret, false)))
end associated_on

// `Option.nope()` -- a call through a **generic** enum's bare name of something it declares neither
// as a variant nor as a member. No instantiation is settled for a name nobody declared, so without
// this the reading falls through to the receiver and reports the enum as an undefined name, which
// is about the one part the reader got right.
private generic_enum_stranger(cx: &Analyzer, span: Span, receiver: Expr,
                              name: string) -> Option[TExpr]
    val written = written_type_name(cx, receiver)

    if written.is_none() || name == "try" then return None

    val key = lookup_type_key(cx.an, cx.scope, written.unwrap())

    if key.is_none() then return None

    val decl = cx.an.tables.types.get(key.unwrap())

    if decl.is_none() then return None

    decl.unwrap().kind match
        EnumOf(_) -> ()
        _ -> return None

    if enum_key_has_variant(cx, key.unwrap(), name) then return None
    if member_at(cx.an, key.unwrap(), name).is_some() then return None

    Some(cx.err(span, s"enum '${qualified_name(key.unwrap())}' has no variant or " +
                s"associated function '$name'"))
end generic_enum_stranger

// `Age.oldest()` -- a constrained subtype is a name a call reaches through, as a struct's is, where an
// `impl` gave it the member. **Only where it did**: a name the subtype was not given is left to the
// member read, whose refusal names what a subtype offers under its own name (`Age::First` and the
// rest), and a subtype is made real here only for a call that is going to use it.
private subtype_subject(cx: &Analyzer, receiver: Expr, name: string) -> Option[Type]
    val written = written_type_name(cx, receiver)

    if written.is_none() then return None

    val key = lookup_type_key(cx.an, cx.scope, written.unwrap())

    if key.is_none() then return None

    val decl = cx.an.tables.types.get(key.unwrap())

    if decl.is_none() then return None

    decl.unwrap().kind match
        TypeOf(_) -> ()
        _ -> return None

    if member_at(cx.an, key.unwrap(), name).is_none() then return None

    Some(instantiate(cx.an, cx.scope, anchor_of(receiver), written.unwrap(), key.unwrap(), buf()))
end subtype_subject

// The instantiation a **generic** type's bare name stands for in `Vector.zeros(n)`, read off what
// receives the result.
//
// A type with parameters has no instance under its bare key -- an instance is keyed by the arguments
// mangled on -- so `subject_named` answers nothing and the reader is told the name is undefined,
// which is about the wrong thing entirely. The name is fine; what is missing is which `Vector`.
//
// **Only where the type declares the member**, so a name that happens to be a generic type and a
// member nobody wrote is left to the reading that reports it as an undefined name. And only where
// the expected type is an instantiation of that very type: anything else is somebody else's
// expectation and would silently pick an instantiation the reader did not write.
private generic_subject(cx: &Analyzer, span: Span, receiver: Expr, name: string,
                        args: Buf[Expr], expected: Option[Type]) -> Option[Type]
    val written = written_type_name(cx, receiver)

    if written.is_none() then return None

    val written_key = lookup_type_key(cx.an, cx.scope, written.unwrap())

    if written_key.is_none() then return None

    val key = renamed_generic(cx, written_key.unwrap())

    if concrete_instance(cx.an, key).is_some() then return None

    generic_subject_of(cx, span, key, name, args, expected)
end generic_subject

// **A generic alias that only renames answers for the type it names** -- `type Mutex[T] = m.Mutex[T]`,
// every parameter handed through in the order it was declared -- so `Mutex.new(0)` is `m.Mutex.new(0)`
// (`reference/declarations.md § Type declarations`: the two spellings are interchangeable). The key of
// the named type where `key` is such an alias, followed through a chain of them; `key` itself where it
// is not one. An alias that fixes, drops or reorders a parameter is left as it is: there is no one
// generic type its bare name stands for.
renamed_generic(cx: &Analyzer, key: string) -> string
    var at = key

    for _ in 0..<16
        val declared = cx.an.tables.types.get(at)

        if declared.is_none() then return at

        val d = declared.unwrap().kind match
            TypeOf(t) -> t
            _ -> return at

        if d.derived || d.range.is_some() || d.pred.is_some() || d.tp.names.is_empty() then return at

        val named = *d.base.kind match
            NamedType(n, targs) -> if passes_through(targs, d.tp.names) then Some(n) else None
            _ -> None

        if named.is_none() then return at

        val next = lookup_type_key(cx.an, declared.unwrap().scope, named.unwrap())

        if next.is_none() || next.unwrap() == at then return at

        at = next.unwrap()

    at
end renamed_generic

// Whether written type arguments are exactly `names`, each a bare parameter, in order.
private passes_through(targs: Buf[TypeRef], names: Buf[string]) -> bool
    if targs.len() != names.len() then return false

    for i in 0..<targs.len()
        val same = *targs.at(i).kind match
            NamedType(n, inner) -> n == names.at(i) && inner.is_empty()
            _ -> false

        if !same then return false

    true
end passes_through

// The same, for a generic type already known by its key -- which is where a leading dot arrives,
// its type being the expected one rather than a name somebody wrote.
generic_subject_of(cx: &Analyzer, span: Span, k: string, name: string, args: Buf[Expr],
                   expected: Option[Type]) -> Option[Type]
    val key = Some(k)
    val m = member_at(cx.an, key.unwrap(), name)

    // **A name the type does not declare is the type's mistake, not the name's** -- `Box` is right
    // and `of` is what is missing. An enum's is told by `generic_enum_stranger`, which names its
    // variants too.
    if m.is_none()
        val declared = cx.an.tables.types.get(key.unwrap())

        if declared.is_none() then return None

        declared.unwrap().kind match
            StructOf(_) ->
                cx.fault(span, s"type '${qualified_name(key.unwrap())}' has no associated function '$name'")
                return Some(Unknown)
            _ -> return None
    end if

    // A member with a receiver is told so before anything is inferred: there is no instantiation to
    // settle for a call that cannot be made through the type at all.
    if receiving_member(cx, span, key.unwrap(), name, m.unwrap()).is_some() then return Some(Unknown)

    // **The expected type settles the type's arguments only through the member's result**, as it
    // settles a generic free function's (`reference/generics.md § Members and associated
    // functions`): `empty() -> Box[int]` says nothing about `Box`'s `T`, so a `Box[int]` receiving it
    // is no reason to pick one. A result that mentions every parameter -- `Self`, `Box[T]` -- is read
    // off the expectation directly; anything else goes to the solve, which names what it could not.
    expected match
        Some(want) ->
            if instantiation_of(want, key.unwrap()) && result_settles_type(cx, key.unwrap(), m.unwrap())
                return Some(repr(want))
        None -> ()

    val said = cx.an.complaints()
    val solved = solved_subject(cx, span, key.unwrap(), name, args, expected, None)

    if solved.is_some() then return solved

    // **An argument whose bare reading was refused is the mistake**, where nothing else settled the
    // type argument: `Box.one(Some(5000000000))` is told that the literal does not fit `int`, at the
    // literal, as the reference tells it. It was read in a sandbox to learn what it settles, so it is
    // read once more for real here, and that complaint is the statement's one.
    for arg in args
        if cx.an.complaints() == said && sandboxed_reading(cx, arg).1
            type_expr(cx, arg, None)
            break
        end if

    // The reference's own words, and the advice is what a reader can act on: there is nowhere else
    // for the arguments to come from, a receiverless call carrying no value of the type.
    //
    // **Only where the solve itself said nothing**, which is the ordinary case for a type the walk
    // above never reached. `solve` reports per unsolved parameter and NAMES it, which is the better
    // message and the reference's; composing a second one here beside it would report one mistake
    // twice and, where the solve stayed deliberately quiet over a poisoned argument, would report a
    // consequence somebody has already been told the cause of.
    if cx.an.complaints() == said then
        cx.fault(span, s"cannot infer the type argument of " +
                 s"'${qualified_name(key.unwrap())}.$name' here — annotate the expected type")

    Some(Unknown)
end generic_subject_of

// `Biquad.of(c).unwrap()` where a `Biquad[q15]` is wanted: the associated function of a generic type
// whose result is an `Option` or a `Result` of what it makes, unwrapped where the position says what
// that is. **The expectation reaches the type through the value the wrapper carries**, as it reaches
// `Biquad.of(c)` written alone through its whole result -- so the annotation the refusal asks for is
// one a reader can write whether or not the result is unwrapped on the same line.
//
// Kept to `unwrap()` and `expect(msg)`, the two members that hand back exactly what the wrapper
// carries, and taken only where the call's own arguments settle nothing: a type they settle is read
// as it would be anyway, and a disagreement with the position is reported as one. `None` everywhere
// else, which leaves the receiver to its ordinary reading.
unwrapped_associated(cx: &Analyzer, receiver: Expr, member: string, margs: Buf[Expr],
                     expected: Option[Type]) -> Option[TExpr]
    if expected.is_none() then return None
    if member == "unwrap" && !margs.is_empty() then return None
    if member == "expect" && margs.len() != 1 then return None
    if member != "unwrap" && member != "expect" then return None

    val (callee, cargs) = *receiver.kind match
        Call(c, a) -> (c, a)
        _ -> return None

    val (head, fname) = *callee.kind match
        Field(h, n, _) -> (h, n)
        _ -> return None

    val written = written_type_name(cx, head)

    if written.is_none() then return None

    val written_key = lookup_type_key(cx.an, cx.scope, written.unwrap())

    if written_key.is_none() then return None

    val key = renamed_generic(cx, written_key.unwrap())

    if concrete_instance(cx.an, key).is_some() then return None

    val owner = cx.an.tables.types.get(key)
    val m = member_at(cx.an, key, fname)

    if owner.is_none() || m.is_none() || !m.unwrap().is_associated() || m.unwrap().ret_type.is_none() then
        return None

    val carried = *m.unwrap().ret_type.unwrap().kind match
        NamedType(n, targs) ->
            val wrapper = lookup_type_key(cx.an, owner.unwrap().scope, n)

            if targs.is_empty() || wrapper.is_none() then None
            else if wrapper.unwrap() == library_key("Option") || wrapper.unwrap() == library_key("Result")
                Some(targs.at(0))
            else None
        _ -> None

    if carried.is_none() then return None

    // The arguments alone, read as the ordinary path would read them: where they settle the type,
    // that reading is the one the program gets.
    val first = begin_trial(cx)
    val alone = solved_subject(cx, receiver.span, key, fname, cargs, None, None)

    discard_trial(cx, first)

    if alone.is_some() then return None

    val second = begin_trial(cx)
    val solved = solved_subject(cx, receiver.span, key, fname, cargs, expected, carried)

    discard_trial(cx, second)

    if solved.is_none() then return None

    associated_on(cx, receiver.span, solved.unwrap(), fname, cargs, None, buf())
end unwrapped_associated

// Whether a receiverless member's written result names every parameter of the type that declares
// it -- `Self` counting as all of them -- so that the type an expectation names is the type the call
// answers.
result_settles_type(cx: &Analyzer, key: string, m: MethodDecl) -> bool
    if m.ret_type.is_none() then return false

    val declared = cx.an.tables.types.get(key)

    if declared.is_none() then return false

    val tparams = declared.unwrap().kind match
        StructOf(d) -> d.tparams
        EnumOf(d) -> d.tparams
        _ -> return false

    var self_name: Buf[string] = buf()

    self_name.push("Self")

    if ref_mentions(m.ret_type.unwrap(), self_name) then return true

    for tparam in tparams
        var one: Buf[string] = buf()

        one.push(tparam)

        if !ref_mentions(m.ret_type.unwrap(), one) then return false

    true
end result_settles_type

// The refusal for a member reached through its type that needs a value to be reached through -- a
// property or a method -- and nothing for an associated function or a static property.
receiving_member(cx: &Analyzer, span: Span, key: string, name: string,
                 decl: MethodDecl) -> Option[TExpr]
    if decl.is_property && !decl.is_static then
        return Some(cx.err(span, s"'$name' is a property of '${qualified_name(key)}' — read it on a " +
                           s"value, as 'value.$name'"))

    if decl.recv_mode().is_some() then
        return Some(cx.err(span, s"'$name' is an instance method of '${qualified_name(key)}' — call " +
                           "it on a value, not the type"))

    None
end receiving_member

// Whether a subject's own type arguments meet what its declaration asks of them.
//
// A parameter standing in for itself promises what its own bounds say, so `Scored.of(x)` in a body
// whose `T` was never bounded by `Rank` is refused at the call and the member is not made real at
// that `T`; a type merely built over one is left to the body read at a type.
private subject_bounds_met(cx: &Analyzer, span: Span, ty: Type) -> bool
    val applied = repr(ty) match
        Struct(d) -> Some((d.base, d.targs))
        Enum(d) -> Some((d.base, d.targs))
        _ -> None

    if applied.is_none() || applied.unwrap().1.is_empty() then return true

    val targs = applied.unwrap().1
    var stand_in = false

    for targ in targs
        if targ == Unknown then return true

        targ match
            Abstract(_, _) -> stand_in = true
            other -> if mentions_abstract(other) then return true

    val declared = cx.an.tables.types.get(applied.unwrap().0)

    if declared.is_none() then return true

    val shape = declared.unwrap().kind match
        StructOf(d) -> Some((d.tparams, d.bounds))
        EnumOf(d) -> Some((d.tparams, d.bounds))
        _ -> None

    if shape.is_none() || shape.unwrap().1.is_empty() then return true

    val mark = cx.an.complaints()
    val kept = cx.an.kept.len()
    val met = check_param_bounds(cx.an, declared.unwrap().scope, span, applied.unwrap().0,
                                 shape.unwrap().0, shape.unwrap().1, targs, buf(), "type parameter",
                                 cx.scope)

    // **A concrete argument is asked without a word** -- the refusal was made where it was written
    // or settled, and a written `Scored[int]` resolves to nothing the call could be read at. **A
    // parameter standing in for itself is told at the call as well**, the caller's signature having
    // kept the type it refused: `keep[T](x: T) -> Scored[T] = Scored.of(x)` is refused at both, as
    // the reference refuses it. Said once at one place either way, a refusal already made there
    // being one the analysis does not repeat.
    if !stand_in
        cx.an.restore_complaints(mark)
        cx.an.kept.truncate(kept)
    end if

    met
end subject_bounds_met

// The instantiation the **arguments** settle, where the expected type did not.
//
// `Vector.of([1.0f32, 2.0f32])` says which `Vector` as plainly as an annotation would, and it is the
// same reading a generic function's call gets: the member's written parameter types are unified
// against what the arguments turned out to be, in the type's own parameters rather than the
// member's.
//
// **Each argument is read in a sandbox and the reading thrown away**, which is what keeps a closure
// among them from being lowered twice: the arguments are read again below at the parameters this
// solve arrived at, and the second reading is the one the program gets.
//
// `ret` stands in for the member's written result where the expectation is of something else than
// the result itself -- the value an `Option` or a `Result` carries, for `unwrapped_associated`.
private solved_subject(cx: &Analyzer, span: Span, key: string, name: string, args: Buf[Expr],
                       expected: Option[Type], ret: Option[TypeRef]) -> Option[Type]
    val decl = cx.an.tables.types.get(key)

    if decl.is_none() then return None

    val owner = decl.unwrap()

    val shape = owner.kind match
        StructOf(d) -> Some((d.tparams, d.bounds))
        EnumOf(d) -> Some((d.tparams, d.bounds))
        _ -> None

    if shape.is_none() then return None

    val tparams = shape.unwrap().0

    if tparams.is_empty() then return None

    val m = member_at(cx.an, key, name)

    if m.is_none() then return None

    val member = m.unwrap()

    // A member of its own is a second list of parameters to solve, and nothing here is solving it:
    // what is wanted is the *type's* arguments, and the member's are settled where the call is read.
    //
    // **`Self` is the type applied to its own parameters**, so `joined(x: Self, y: Self)` settles `T`
    // from a `Box[int]` argument exactly as `joined(x: Box[T], …)` would.
    val written_name = module_bare(key)
    var param_refs: Buf[TypeRef] = buf()

    for param in member.params
        param_refs.push(self_spelled(param.typ, written_name, tparams))

    var arg_tys: Buf[Type] = buf()
    var soft: Buf[bool] = buf()

    // **A bare reading that was refused is consulted last**, as a literal is: `Box.arr([1,
    // 5000000000], wide)` is a `Box[u64]` call, where reading the array alone refuses its second
    // element at `int`. Taken first, the `[2]int` that reading produced would settle `T` ahead of the
    // argument that knew. Where nothing else settles it, it still does -- `Box.one([1, 5000000000])`
    // is refused at `int`, as the reference refuses it -- and the argument is read again below at
    // whatever the solve arrived at.
    for arg in args
        val read = sandboxed_reading(cx, arg)

        arg_tys.push(texpr_type(read.0))
        // **A bare literal is consulted last too**, having no type of its own: `Pair.of(1, "two")`
        // is a `Pair[string]` call whose `1` is then the argument that disagrees, as a generic free
        // function's call reads it.
        soft.push(read.1 || adaptable(arg, read.0))

    // **The call is what the refusal names, not the type** -- `M.one`, since a reader told the
    // argument of `M` could not be inferred has nowhere to write one, `M` not being what they wrote.
    val result = if ret.is_some() then Some(self_spelled(ret.unwrap(), written_name, tparams))
    else member.ret_type

    val targs = solve(cx.an, owner.scope, cx.scope, span, s"${module_show(key)}.$name", tparams, param_refs,
                      arg_tys, result, expected, soft, shape.unwrap().1, buf(), payload = cx.payload_here)

    if targs.len() != tparams.len() then return None

    for targ in targs
        if targ == Unknown then return None

    Some(instantiate(cx.an, cx.scope, span, module_show(key), key, targs))
end solved_subject

// A written type with a bare `Self` spelled out as the type applied to its own parameters --
// `Box[T]` -- which is the one reading a receiverless member's signature gives it.
private self_spelled(t: TypeRef, written: string, tparams: Buf[string]) -> TypeRef
    *t.kind match
        NamedType(n, args) ->
            if n == "Self" && args.is_empty()
                var own: Buf[TypeRef] = buf()

                for tparam in tparams
                    own.push(TypeRef(t.span, NamedType(tparam, buf())))

                return TypeRef(t.span, NamedType(written, own))
            end if
        _ -> ()

    t
end self_spelled

// Whether a type is an instantiation of the declaration a key names.
instantiation_of(t: Type, key: string) -> bool = repr(t) match
    Struct(d) -> d.base == key
    Enum(d) -> d.base == key
    _ -> false

// The type a name stands for where it stands for one: `Self`, a declared type at no arguments, or a
// scalar spelled the way a program writes it.
subject_named(cx: &Analyzer, receiver: Expr) -> Option[Type]
    // A dotted path is one name to the type grammar, so `sdl3.PixelFormat.of(n)` reaches the same
    // associated function `PixelFormat.of(n)` does.
    val written = written_type_name(cx, receiver)

    if written.is_none() then return None

    val n = written.unwrap()

    if n == "Self" then return bound_type(cx.subst, "Self")

    val stood = bound_type(cx.subst, n)

    // A value parameter is a value however the substitution holds it, so `N.to_string()` reads `N`
    // rather than asking a type named `N` for an associated function.
    if stood.is_some()
        stood.unwrap() match
            ConstArg(_, _, _) -> return None
            Descriptor(_, _, _) -> return None
            _ -> ()

        return stood
    end if

    val scalar = scalar_named(n, int(cx.an.tables.target.pointer_bits()))

    if scalar.is_some() then return scalar

    val width = width_type(cx.an, cx.scope, anchor_of(receiver), n)

    if width.is_some() then return width

    val key = lookup_type_key(cx.an, cx.scope, n)

    if key.is_none() then return None

    val concrete = concrete_instance(cx.an, key.unwrap())

    if concrete.is_some() then return concrete

    // **An alias and a constrained subtype are filed with the constrained instantiations** -- an
    // alias's entry being what it names -- so `F.zero()` over `type F = real` is `real.zero()`, and
    // `Age.make()` reaches the `impl` written for `Age`.
    cx.an.tables.constrained_insts.get(key.unwrap())
end subject_named

// `value.member(args)` -- a call, which is what the parentheses said.
call_member(cx: &Analyzer, span: Span, receiver: TExpr, name: string, args: Buf[Expr],
            expected: Option[Type], via: Buf[string] = no_bound_traits(),
            targs: Buf[Expr] = no_written_members()) -> TExpr
    val rty = receiver_type(texpr_type(receiver))

    if rty == Unknown then return bad_expr(span)

    // **`Eq` and `Hash` at a reference are its referent's where the referent has them, and its
    // identity where it does not** (`reference/memory.md § References compare through their
    // referent`); at a `*T`, through a bound, they are the address's. So a `[K: Hash + Eq]` body
    // standing at `&Node` keys the table by `Node`'s own value when `Node` defines one, and by the
    // node's identity when it does not -- the two members always agreeing, which is the law a key
    // needs.
    val held = underlying(texpr_type(receiver))

    if (name == "hash" || name == "eq") && cx.at_definition then note_bound_site(cx, span, held)

    if (name == "hash" || name == "eq") && hashes_by_address(held)
        val member = reference_member(cx, span, receiver, held, name, args, expected)

        if member.is_some() then return member.unwrap()
    end if

    // **Every value answers `to_string()` and `debug_string()`**, by the compiler, where its type has
    // no member of that name: the string its `Display` writes (its `Debug`, else `<T>`, where it has
    // none) and the string its `Debug` writes -- the same code `str(x)` and `debug(x)` become.
    if (name == "to_string" || name == "debug_string") && !owns_member(cx, rty, name) then
        return rendered_member(cx, span, receiver, name, args)

    // A value that is `Debug` by the compiler's rule has no block to call, so its `debug` is the
    // rule's (`reference/traits.md § What is shown by rule`).
    if name == "debug" && debug_by_rule(rty) then return rule_debug(cx, span, receiver, args)

    rty match
        // A parameter standing in for itself: the call is checked against the *trait's* signature,
        // which is what lets one walk stand in for every instantiation.
        Abstract(_, bounds) -> call_bound_method(cx, span, receiver, rty, name, bounds, args, targs)
        // A trait object has forgotten which type it holds, and what it wrote down in its place is
        // the table -- so a call on one is an index into that table rather than a name.
        Trait(_, _, _) -> call_erased(cx, span, receiver, rty, name, args, expected)
        // Everything about a weak reference is behind `get()`, including whether there still is one.
        Weak(inner) -> weak_get(cx, span, receiver, *inner, name, args)
        // The operation that stops a substring holding its parent buffer alive: the bytes are copied
        // into a string that owns them, so what the result keeps is its own. Parentheses because it
        // allocates and walks the bytes.
        Str ->
            if name == "copy"
                if !args.is_empty() then
                    cx.fault(span, "'copy' takes no arguments — it copies the string it is read off")

                TExpr(span, TFromBytes(TExpr(span, TBytes(receiver))))
            else if claims_lanes(cx, rty, name) then cx.err(span, no_lanes_in_a_string(name))
            else call_declared(cx, span, receiver, rty, name, args, expected, via, targs)

        // The vector's own methods, which are the compiler's for the reason the intrinsic table is
        // closed: each is one LLVM operation and none of them can be written in sysl.
        Vector(_, _) ->
            if is_vector_method(name) then vector_method(cx, span, rty, receiver, name, args)
            else call_declared(cx, span, receiver, rty, name, args, expected, via, targs)

        // The two that move lanes between a register and memory. They are the slice's rather than
        // the vector's because the receiver is what supplies the address and the length -- a vector
        // has neither, which is the whole reason these had to exist.
        //
        // `get_unchecked` and `set_unchecked` are the subscript with no bounds check, written as a
        // call (`unchecked.sysl`).
        Array(_, _) ->
            if is_unchecked_member(name) then unchecked_member(cx, span, auto_deref(cx, receiver), name, args)
            else if claims_lanes(cx, rty, name) then
                vector_memory(cx, span, rty, auto_deref(cx, receiver), name, args, expected)
            else call_declared(cx, span, receiver, rty, name, args, expected, via, targs)
        Slice(_, _) ->
            if is_unchecked_member(name) then unchecked_member(cx, span, auto_deref(cx, receiver), name, args)
            else if claims_lanes(cx, rty, name) then
                vector_memory(cx, span, rty, auto_deref(cx, receiver), name, args, expected)
            else call_declared(cx, span, receiver, rty, name, args, expected, via, targs)
        _ ->
            // A `*T` is a bare address, and the unchecked tier is where a program that has one
            // already is. What it does not have is a length, so there is nothing for a run to be
            // checked against -- and a load that silently skipped the check would be the one vector
            // operation that could read past the end of an object. Only where the pointee could be a
            // lane, which is what keeps this from answering for every `*T` in the language.
            if is_vector_memory(name) && points_at_a_lane(texpr_type(receiver)) then
                cx.err(span, s"a '${type_show(texpr_type(receiver))}' carries no length, so a run " +
                       "of its elements has nothing to be checked against — take a slice of them " +
                       "first, with 'p[0..<n]'")
            else call_declared(cx, span, receiver, rty, name, args, expected, via, targs)
end call_member

// `eq` or `hash` on a reference or a pointer, where the rule answers it rather than the referent's
// own member; nothing where the call is the referent's, reached as any member call on a reference is.
//
// **Written on a reference whose referent has the member**, it is the referent's (`r.eq(*s)`,
// `r.hash()`). **Reached through a bound or a derivation**, the other operand is the reference
// itself, so `eq` is the `==` between two references -- read through to the referents -- and `hash`
// is the referent's, read through the same levels. **Where the referent has neither**, both are the
// address's, written or not; and a referent with an `Eq` but no `Hash` has no hash at all, since the
// address's would disagree with its `==`.
private reference_member(cx: &Analyzer, span: Span, receiver: TExpr, held: Type, name: string,
                         args: Buf[Expr], expected: Option[Type]) -> Option[TExpr]
    val bound = reached_through_bound(cx, span, held, name)

    // **A member the referent declares wins over the rule's**, as a user's name always beats a
    // compiler-supplied surface: a written `r.hash()` on a `&Opts` whose `Opts` declares an inherent
    // `hash` is that method, whether or not `Opts` implements `Hash` (or has an `Eq` the address's
    // hash would disagree with). Only a bound asks for the trait's member, and an inherent method of
    // the same name does not implement the trait, so there the rule still answers.
    if !bound && has_method_named(cx, receiver_type(held), name) then return None

    if name == "hash" && hash_law_breaks(cx.an, held) then
        return Some(cx.err(span, s"'hash' is not defined for ${type_show(held)}: " +
                           hash_law_refusal(cx.an, held)))

    val levels = through_levels(cx.an, if name == "eq" then "Eq" else "Hash", held)

    // A written call on a pointer reaches its pointee's member wherever the pointee has one.
    val raw_reaches = held match
        Ptr(inner) -> !bound && satisfies(cx.an, plain_bound(library_key(if name == "eq" then "Eq" else "Hash"),
                                                             buf()), *inner)
        _ -> false

    if raw_reaches || (!bound && levels > 0) then return None
    if levels == 0 then return Some(address_member(cx, span, receiver, held, name, args))

    if name == "hash" then return Some(call_member(cx, span, auto_deref(cx, receiver), name, args, expected))

    if args.len() != 1 then
        return Some(cx.err(span, s"method 'Eq.eq' takes 1 argument, but " +
                           supplied_phrase(args.len(), "argument")))

    val rhs = type_expr(cx, args.at(0), Some(held))

    if disagree(texpr_type(rhs), held) then
        return Some(cx.err(args.at(0).span, s"'rhs' of 'Eq.eq' is ${type_show(held)}, but " +
                           s"${type_show(texpr_type(rhs))} was given"))

    var ts: Buf[TExpr] = buf()
    var cmps: Buf[TCmp] = buf()

    ts.push(receiver)
    ts.push(rhs)
    cmps.push(TCmp("==", compare_at(cx, span, "==", peeled(held, levels)), levels))
    Some(TExpr(span, TCompare(ts, cmps)))
end reference_member

// Whether a member call on a reference was written through a bound rather than on a reference the
// program named: inside a derivation, where every part is asked the trait being derived, or where the
// receiver is DECLARED in the generic source as one of the body's type parameters -- or one member of
// a pack -- including where it is built from them (`p.0` of a `(T, U)`, `w.x` of a `Wrap[T]`).
//
// **A written member call on a reference reaches its referent** (`r.eq(*s)`, `r.hash()`), whose
// other operand is a referent. It is the bound that promised the reference's own `Eq`, whose other
// operand is a second reference, so it is the bound that gets the comparison between two references.
//
// **The decision is the source's, not the instantiation's.** A `val r: &Node` in a body instantiated
// at `T = &Node` has the same type as a `T`, and is still a reference the program named: its
// `r.hash()` is `Node`'s at every instantiation. So the walk at the definition, where `T` stands for
// itself, files each `hash`/`eq` call site with whether its receiver was a parameter's
// (`bound_sites`), and an instantiation reads that. A body that walk never read -- the library's,
// read where the library was built, and a nested generic -- falls back to asking whether the
// receiver's type is what a parameter stands for.
private reached_through_bound(cx: &Analyzer, span: Span, held: Type, name: string) -> bool
    if derived_trait_key(cx, name).is_some() then return true

    val filed = cx.an.tables.bound_sites.get(bound_site_key(cx, span))

    if filed.is_some() then return filed.unwrap()

    for item in cx.subst
        if type_eq(underlying(item.ty), held) then return true

        item.ty match
            Pack(elems) ->
                for e in elems
                    if type_eq(underlying(e), held) then return true
            _ -> ()
    end for

    false
end reached_through_bound

// Files a `hash`/`eq` call site read at its generic definition: through a bound exactly when the
// receiver's type there is a type parameter standing for itself.
private note_bound_site(cx: &Analyzer, span: Span, held: Type)
    val through = held match
        Abstract(_, _) -> true
        _ -> false

    cx.an.tables.bound_sites.put(bound_site_key(cx, span), through)

// A call site, by the file it is written in and where in it.
private bound_site_key(cx: &Analyzer, span: Span) -> string = s"${cx.scope.src.name}:${span.start}"

// `eq` and `hash` on a reference or a pointer, as the address's: `eq` is its `==`, and `hash` mixes
// the address through the integers' own finalizer. Neither takes or gives back a share.
private address_member(cx: &Analyzer, span: Span, receiver: TExpr, held: Type, name: string,
                       args: Buf[Expr]) -> TExpr
    if name == "eq" then
        return builtin_operator_method(cx, span, receiver, held, name, args).unwrap_or(bad_expr(span))

    if !args.is_empty() then
        return cx.err(span, s"method 'Hash.hash' takes no arguments, but " +
                      supplied_phrase(args.len(), "argument"))

    val key = library_key(cx, "hash_u64")

    if key.is_none() then
        return cx.err(span, "a reference hashes through the library's 'hash_u64', which the " +
                      "standard module this compilation was given does not declare")

    val word = Integer(64, false, false)
    val address = held match
        Ref(_, _) -> TExpr(span, TCast(receiver, Ptr(byte_type())))
        _ -> receiver
    var call_args: Buf[TExpr] = buf()

    call_args.push(TExpr(span, TCast(address, word)))
    cx.an.uses(key.unwrap())
    TExpr(span, TCall(key.unwrap(), call_args, word, false))
end address_member

// Whether a member of that name is the type's own -- declared for it, supplied by a trait it
// implements, or promised by a bound -- which then wins over the one every value has.
private owns_member(cx: &Analyzer, rty: Type, name: string) -> bool = rty match
    Abstract(_, bounds) -> bound_member(cx.an, rty, bounds, name).is_some()
    Trait(_, _, _) -> unslotted_member(cx, rty, name)
    Weak(_) -> false
    _ -> has_method_named(cx, rty, name)

// `x.to_string()` / `x.debug_string()` where the type has none of its own: the value, read through a
// reference as every rendering form reads it, rendered as `str(x)` / `debug(x)` render it. (A written
// type-argument list never reaches here: brackets after a name the receiver has no method of are a
// subscript, as `method_written` reads them.)
private rendered_member(cx: &Analyzer, span: Span, receiver: TExpr, name: string,
                        args: Buf[Expr]) -> TExpr
    if !args.is_empty() then
        return cx.err(span, s"'$name' takes no arguments — it renders the value it is called on")

    val v = through_ref(cx, receiver)

    warn_placeholder_named(cx, span, "this value", v)

    if name == "to_string" then str_of(cx, span, v) else debug_of(cx, span, v)
end rendered_member

// A member the tables hold, called.
private call_declared(cx: &Analyzer, span: Span, receiver: TExpr, rty: Type, name: string,
                      args: Buf[Expr], expected: Option[Type],
                      via: Buf[string] = no_bound_traits(),
                      targs: Buf[Expr] = no_written_members()) -> TExpr
    val found = member_key(cx.an, rty, name)

    // Inside a derivation, a member the derived trait declares is reached through that trait alone,
    // as a bound would have it: the trait narrows the candidates, and a member of the name that some
    // other trait gave the type -- or the compiler supplies for it -- is not the one the body meant.
    val deriving = derived_trait_key(cx, name)

    if deriving.is_some() && !offered_by(cx, found.0, name, deriving.unwrap()) then
        return not_derived_there(cx, span, found.0, name, deriving.unwrap())

    // A derivation reaches its own trait's `encode` alone, so `Plain`'s is asked only outside one.
    if name == "encode" && deriving.is_none() && plain_ahead(cx, rty, found.0, name, via)
        val encoded = plain_encode_call(cx, span, auto_deref(cx, receiver), rty, name, args)

        if encoded.is_some() then return encoded.unwrap()
    end if

    if !has_member_at(cx.an, found.0, name) &&
       !cx.an.tables.members.alts.has(member_key_of(found.0, name)) then
        return no_such_method(cx, span, receiver, rty, found.0, name, args)

    var through = via

    if deriving.is_some()
        through = buf()

        for item in via
            through.push(item)

        through.push(deriving.unwrap())
    end if

    val declaring = core_declaring(name)
    val provided = declaring.is_some() && core_builtin(declaring.unwrap(), rty) && deriving.is_none()
    if refuse_bound_clash(cx, rty, found.0, name, span, via) then return bad_expr(span)

    val chosen = chosen_member(cx, rty, found.0, name, span, args, through, provided)

    if chosen.is_none() then return bad_expr(span)

    val m = member_at(cx.an, found.0, chosen.unwrap())

    if m.is_none() then return no_such_method(cx, span, receiver, rty, found.0, name, args)

    val decl = m.unwrap()

    // Neither of the two kinds with no receiver is reached through a value, and they are not the
    // same mistake: a property is this call with the parentheses dropped, an associated function is
    // not reached through a value at all.
    if decl.is_property then
        return cx.err(span, s"'$name' is a property of '${found.0}' — read it as " +
                      s"'value.$name', without '()'")

    if decl.recv_mode().is_none() then
        return cx.err(span, s"'$name' is an associated function of '${found.0}' — " +
                      s"call it with '${found.0}.$name(…)'")

    // A member with type parameters of its own is instantiated from the call, exactly as a generic
    // free function is: the type's own arguments arrived with the receiver, and these are what the
    // arguments say.
    val generic = cx.an.tables.members.generic.get(member_key_of(found.0, chosen.unwrap()))

    if generic.is_some() && !block_bounds_met(cx, span, generic.unwrap(), found.1) then
        return bad_expr(span)

    // Asked before either path makes the member real, a member with parameters of its own included.
    if !check_impl_condition(cx, span, rty, found.0, chosen.unwrap()) then return bad_expr(span)

    if generic.is_some() && generic.unwrap().tparams.len() > found.1.len() then
        return call_generic_member(cx, span, Some(receiver), rty, found.0, decl, generic.unwrap(),
                                   found.1, args, expected, name, targs)

    // A list written on a member that has no parameters for it. The receiver's arguments are not
    // among them -- they are the *type*'s, settled by the value in hand -- so this is the member's
    // own emptiness rather than the type's.
    if !targs.is_empty() then
        return cx.err(span, s"'${chosen.unwrap()}' is not generic, so it has no type arguments to " +
                      s"write — the call is '$name(…)'. The arguments of ${type_show(rty)} are the " +
                      "receiver's and are already settled by the value it is read off")

    member_dispatch(cx, span, receiver, rty, found.0, chosen.unwrap(), decl, args, expected, name,
                    via)
end call_declared

// **A member an `impl` naming no trait brought is there only where that block's bounds hold**, and
// they are asked of the receiver's own arguments: nothing asked them where its type was made, since
// the type's declaration does not carry them.
private block_bounds_met(cx: &Analyzer, span: Span, fd: FuncDecl, owner_args: Buf[Type]) -> bool
    val bounds = cx.an.tables.members.block_bounds.get(fd.name)

    if bounds.is_none() then return true

    var owner_params: Buf[string] = buf()

    for i in 0..<owner_args.len()
        if i < fd.tparams.len() then owner_params.push(fd.tparams.at(i))

    val home = cx.an.tables.members.generic_scope.get(fd.name).unwrap_or(cx.scope)

    check_param_bounds(cx.an, home, span, fd.name, owner_params, bounds.unwrap(), owner_args, buf(),
                       "type parameter", cx.scope)
end block_bounds_met

// `o.map(f)` -- a member declaring type parameters of its own, instantiated from the call.
//
// **The two lists of parameters the lowered function carries are fixed from two different places**,
// which is the whole of what makes this its own path. The *type's* are already settled -- the
// receiver is a value of a type, and a type has its arguments -- so they are read off it and held
// to nothing further here. The *member's own* are solved from the arguments and from the type the
// context expects, exactly as a generic free function's are, and held to the bounds the member
// wrote. Appending the second list to the first is what the lowering laid them out in that order
// for, so the substitution needs to know nothing about which parameter came from where.
//
// **An associated function is the same call with no receiver** (`Counter.make(5)`, `Pair.of(…)`):
// the type's arguments come from the subject the type's name settled, and every parameter is an
// argument's, so `receiver` is `None` and the slots begin at the first parameter.
private call_generic_member(cx: &Analyzer, span: Span, receiver: Option[TExpr], rty: Type,
                            base: string, m: MethodDecl, fd: FuncDecl, owner_args: Buf[Type],
                            args: Buf[Expr], expected: Option[Type], written: string,
                            targs: Buf[Expr]) -> TExpr
    // **The member is named by its TYPE, not by the instantiation the receiver is**: its own
    // parameters are not settled yet, and the type's arguments are not what a reader wrote at the
    // member, so a refusal reads `'Box.one'` where a member with none of its own reads the receiver.
    val subject = s"'${qualified_name(base)}.${source_member_name(m.name)}'"
    val shown = generic_member_subject(cx, rty, receiver.is_some(), source_member_name(m.name),
                                       subject)
    val off: usize = if receiver.is_some() then 1 else 0

    // **Only the member's own parameters are written**, and a bare arrow among them is the sugar's
    // rather than the author's -- so `map[U](f: T -> U)` is written `map[int]`, and the callable's
    // own parameter goes on being read off the closure.
    val mine = authored_tparams(m.tparams)

    // A shorter list is a prefix: the solve below settles the trailing parameters it left open.
    if targs.len() > mine.len() then
        return cx.err(span, s"'${source_member_name(m.name)}' takes " +
                      s"${quantity(mine.len(), "type argument")} (${quoted_names(mine)}), and " +
                      s"${targs.len()} ${if targs.len() == 1 then "was" else "were"} written")

    val home = instantiation_scope(cx, fd.name)
    var written_args: Buf[Type] = buf()

    // Each is read against the member's own parameter it fills, as a module function's are: a
    // `const` the declaration wrote takes a value -- a constant, or arithmetic over one.
    for i in 0..<targs.len()
        written_args.push(member_arg_for(cx, m, home, mine.at(i), targs.at(i), false))

    // An argument already refused instantiates nothing, or the body would report every use of its
    // parameter as a name nobody declared.
    for t in written_args
        if t == Unknown then return bad_expr(span)

    val slots = bind_member_args(cx, span, shown, m, args)

    if slots.is_none() then return bad_expr(span)

    // The receiver holds the first slot, so the parameters an argument stands at begin one past it.
    var tail: Buf[Param] = buf()

    for i in off..<fd.params.len()
        tail.push(fd.params.at(i))

    // The receiver's arguments, handed to the inference as already answered: they arrived with the
    // value and were never a question, and without them a parameter naming the *type's* parameter
    // reads as unsolved and a closure standing at one is held back for a type no argument was ever
    // going to supply.
    var seed: Buf[Binding] = buf()

    for i in 0..<owner_args.len()
        if i < fd.tparams.len() then seed.push(Binding(fd.tparams.at(i), owner_args.at(i)))

    // **And what `Self` is at those arguments.** A default body copied out of a trait keeps the
    // trait's spelling, so a bare arrow over a projection leaves the bound it became reading
    // `Fn1[Self::Item, N]` -- which the solve and the bound check resolve, and which names nothing
    // without `Self` beside the receiver's arguments. The receiver is kept as written until the
    // arguments are known (`self_for` reads it the same way), and they are known here.
    //
    // It does not change what a bare bound means: `U: Add` fills its defaulted arguments with the
    // parameter it is written on, which `bound_terms` puts ahead of this `Self`.
    val generic_self = cx.an.tables.members.generic_self.get(fd.name)

    if generic_self.is_some() && bound_type(seed, "Self").is_none()
        val at = cx.an.tables.members.generic_scope.get(fd.name).unwrap_or(home)

        seed.push(Binding("Self", resolve_type(cx.an, at, generic_self.unwrap(), seed)))
    end if

    // What the list wrote settles its parameters outright, the solve below being what it replaces
    // rather than something it is checked against.
    var answered: Buf[Binding] = buf()

    for item in seed
        answered.push(item)

    for i in 0..<written_args.len()
        answered.push(Binding(mine.at(i), written_args.at(i)))

    val prov = provisional_of(cx, span, home, m.tparams, tail, fd.ret_type, m.bounds, slots.unwrap(),
                              answered, expected, fd.needs)
    var param_refs: Buf[TypeRef] = buf()

    for item in tail
        param_refs.push(item.typ)

    val screened = shape_screen(cx.an, tail, slots.unwrap(), prov.tys)
    val own = if written_args.len() == m.tparams.len() && !written_args.is_empty() then written_args
    else solve(cx.an, home, cx.scope, span, fd.name, m.tparams, param_refs, screened.0, fd.ret_type,
               prov.expected, prov.soft, m.bounds, answered, left_to_default(slots.unwrap()),
               cx.payload_here)

    // An argument the solve could not read is said out loud rather than instantiated at, as it is
    // for a free function. **Only where saying it said something**: an unknown that no argument
    // answers for -- a callable's result read at a projection the provisional reading could not
    // settle -- is left to the instantiation below, whose own complaints are what report it. Ending
    // the call there in silence would hand the lowering a body nobody refused.
    var voiced = false

    for item in own
        if !voiced && item == Unknown
            if screened.1.is_some() then
                return voice_shape_clash(cx, subject, tail, slots.unwrap(), prov.tys, screened.1.unwrap())

            val before = cx.an.complaints()

            voice_unknown_args(cx, slots.unwrap(), prov)
            voiced = true

            if cx.an.complaints() > before then return bad_expr(span)
        end if

    // The member's own bounds, checked with the receiver's arguments to hand. Reading the whole
    // lowered signature's bounds here would sweep the type's own in as well and report anything
    // unmet a second time, having already said it where the receiver's type was made.
    if !check_param_bounds(cx.an, home, span, fd.name, m.tparams, m.bounds, own, seed,
                           "type parameter", cx.scope) then return bad_expr(span)

    if !stand_ins_hold(cx.an, home, cx.scope, span, fd.name, fd, m.tparams, own) then
        return bad_expr(span)

    var targs: Buf[Type] = buf()

    for owner_arg in owner_args
        targs.push(owner_arg)

    for item in own
        targs.push(item)

    val name = asked(cx, span, instantiate_func(cx.an, home, fd, targs, viewed_const(rty, base)))
    val sig = cx.an.tables.members.func_insts.get(name)

    if sig.is_none() then return bad_expr(span)

    val params = sig.unwrap().params
    var ts: Buf[TExpr] = buf()

    if receiver.is_some() then
        ts.push(as_read_only(build_receiver(cx, span, m.recv_mode().unwrap(), receiver.unwrap(),
                                            written, m.marks.relocates),
                             if params.is_empty() then Unknown else params.at(0).1))

    if receiver.is_some() && m.marks.relocates then check_ref_call(cx, span, receiver.unwrap(), m.name)
    if receiver.is_some() && m.marks.views then note_view_call(cx, span, receiver.unwrap(), m.name)
    if receiver.is_some() && m.marks.consumes then note_consume_call(cx, span, receiver.unwrap(), m.name)

    val before = cx.an.complaints()
    var given: Buf[TExpr] = buf()
    var wants: Buf[Type] = buf()
    var unread: Buf[usize] = buf()

    for i in 0..<slots.unwrap().len()
        val want = walk_wanted(m.params.at(i), if i + off < params.len() then params.at(i + off).1
                                               else Unknown)

        wants.push(want)

        slots.unwrap().at(i) match
            Some(e) ->
                // A callable was read once already, against the bound the solve had settled by
                // then: reading it again would lower a second closure for the one a program wrote.
                var t = bad_expr(e.span)

                if i < prov.kept.len() && prov.kept.at(i).is_some()
                    // Read against the BOUND, which says nothing about how the parameter holds
                    // what met it: a written `&Fn(…)` is a trait object, and putting the closure
                    // behind the table is what the position does.
                    t = prov.kept.at(i).unwrap()

                    if disagree(texpr_type(t), want) then t = coerce(cx, t, want)
                else t = argument_told(cx, e, m.params.at(i), m.tparams, want)

                given.push(t)
            None ->
                val inner = default_reader(cx, span, member_default_scope(cx, name), name, m.bounds)
                val read = default_at(inner, m.params.at(i).default.unwrap(), want)

                if read.is_none() then unread.push(i)

                given.push(read.unwrap_or(bad_expr(span)))

    val refused = refused_argument(cx, span, subject, m.params, slots.unwrap(), given, wants, before,
                                   true, unread)

    if refused.is_some() then return refused.unwrap()

    for i in 0..<given.len()
        ts.push(handed_walk(m.params.at(i), slots.unwrap().at(i), given.at(i)))

    val tail = member_tail(cx, m, args)

    for item in tail
        ts.push(item)

    check_crossings(cx, m.crossing, m.marks.copies, shown, params, ts)
    check_shared_result(cx, span, sig.unwrap().ret)
    cx.an.uses(name)

    if m.marks.answers_place then return placed_call(cx, span, name, ts, sig.unwrap().ret)

    val call = TExpr(span, TCall(name, ts, sig.unwrap().ret, false))

    if receiver.is_none() then return call

    recheck_after(cx, span, ts.at(0), call)
end call_generic_member

// What a message about a generic member's arguments calls it: `subject` is the member quoted under
// its type's name, with no arguments on either.
private generic_member_subject(cx: &Analyzer, rty: Type, has_receiver: bool, name: string,
                               subject: string) -> string =
    if !has_receiver then s"associated function $subject"
    else if name == "call" && callable_of(cx.an, rty).is_some() then "this callable"
    else s"method $subject"

// What a message about a member's arguments calls it. **A call through the call trait is written as
// a call and reads as one**, so it is `this callable` rather than a member no program wrote, on a
// trait filed under its arity: nothing a reader could have typed is `Fn1`.
private member_subject(cx: &Analyzer, rty: Type, name: string) -> string =
    if name == "call" && callable_of(cx.an, rty).is_some() then "this callable"
    else s"method '${type_show(rty)}.$name'"

// The call itself, once the member is known: the receiver in the mode its `self` asked for, the
// arguments bound and checked against the instantiated signature, and a call to the function the
// member was lowered to.
private member_dispatch(cx: &Analyzer, span: Span, receiver: TExpr, rty: Type, base: string,
                        chosen: string, m: MethodDecl, args: Buf[Expr], expected: Option[Type],
                        written: string, via: Buf[string] = no_bound_traits()) -> TExpr
    check_member_visible(cx, span, base, chosen, m, via)

    if !check_impl_condition(cx, span, rty, base, chosen) then return bad_expr(span)

    val shown = member_subject(cx, rty, chosen)
    val fname = member_func_name(cx, span, rty, chosen)

    if fname == "" then return bad_expr(span)

    // A call of an `index_view` default whose view would own nothing it should is refused, as a view
    // of part of an element taken through it is (`index_view_infer.sysl`).
    if chosen == "index_view" || chosen == "index_view_unchecked"
        val why = ownerless_view_refusal(cx.an, view_member_name(cx, rty, chosen))

        if why.is_some()
            return cx.err(span, s"'${type_show(rty)}.$chosen' is the trait's default, but ${why.unwrap()}")
    end if

    val sig = member_sig(cx.an, fname)

    // **A member whose own signature did not resolve is registered and has no lowered form**, which
    // is the lowering's deliberate order: the declaration is filed before the signature is built, so
    // that a mistake in the signature does not also erase the member it is about. The mistake has
    // been reported where it belongs, so the call is abandoned in silence rather than complained
    // about twice.
    if sig.is_none() then return bad_expr(span)

    note_member_reference(cx, span, fname, m)

    val params = sig.unwrap().params
    val slots = bind_member_args(cx, span, shown, m, args)

    if slots.is_none() then return bad_expr(span)

    var ts: Buf[TExpr] = buf()

    ts.push(as_read_only(build_receiver(cx, span, m.recv_mode().unwrap(), receiver, written,
                                        m.marks.relocates),
                         if params.is_empty() then Unknown else params.at(0).1))

    // A `@relocates` member may move what a live `ref` stands on, whatever mode its receiver is in.
    if m.marks.relocates then check_ref_call(cx, span, receiver, m.name)

    // A `@views(self)` member's answer is borrowed from the receiver (`view_borrow.sysl`).
    if m.marks.views then note_view_call(cx, span, receiver, m.name)

    // A `@consumes` member leaves a local receiver empty (`consumes.sysl`).
    if m.marks.consumes then note_consume_call(cx, span, receiver, m.name)

    val before = cx.an.complaints()
    var given: Buf[TExpr] = buf()
    var wants: Buf[Type] = buf()
    var unread: Buf[usize] = buf()

    for i in 0..<slots.unwrap().len()
        val want = walk_wanted(m.params.at(i), if i + 1 < params.len() then params.at(i + 1).1
                                               else Unknown)

        wants.push(want)

        slots.unwrap().at(i) match
            Some(e) -> given.push(argument_told(cx, e, m.params.at(i), m.tparams, want))
            None ->
                val inner = default_reader(cx, span, member_default_scope(cx, fname), fname, m.bounds)
                val read = default_at(inner, m.params.at(i).default.unwrap(), want)

                if read.is_none() then unread.push(i)

                given.push(read.unwrap_or(bad_expr(span)))

    val refused = refused_argument(cx, span, s"'$fname'", m.params, slots.unwrap(), given, wants,
                                   before, true, unread)

    if refused.is_some() then return refused.unwrap()

    for i in 0..<given.len()
        ts.push(handed_walk(m.params.at(i), slots.unwrap().at(i), given.at(i)))

    val tail = member_tail(cx, m, args)

    for item in tail
        ts.push(item)

    check_crossings(cx, m.crossing, m.marks.copies, shown, params, ts)
    check_shared_result(cx, span, sig.unwrap().ret)
    cx.an.uses(fname)

    // A `-> ref` member's call is the place it answers (`ref_result.sysl`). It writes nothing of its
    // own, so there is nothing to re-check after it; a write through the place is checked where it
    // is written.
    if m.marks.answers_place then return placed_call(cx, span, fname, ts, sig.unwrap().ret)

    recheck_after(cx, span, ts.at(0), TExpr(span, TCall(fname, ts, sig.unwrap().ret, false)))
end member_dispatch

// Re-checks, after a call, every invariant the receiver's place lies below.
//
// **A `*self` method reached through a field -- `o.a.bump()` -- is the one severed place the
// language still has**, since there are no parameter modes and so no other way to hand a callee
// somewhere to write without writing `&`. What makes it recoverable is that the **call site** still
// knows the whole place: the receiver is `o.a`, `o` is right there, and the clause can be re-run the
// moment the call returns. So the alias is allowed and the promise is kept at the boundary instead
// of inside.
//
// Wrapping is by the same fold a write uses, so where a place lies below more than one struct the
// innermost clause is the one that fires first.
private recheck_after(cx: &Analyzer, span: Span, recv_arg: TExpr, call: TExpr) -> TExpr =
    *recv_arg.kind match
        TAddrOf(place, _) -> rechecked(cx, span, place, call)
        _ -> call

// Which written argument fills which of a member's parameters. The receiver is not among them, so
// this is the free function's rule read one slot in.
//
// `kept` is for a call read through a **bound**, at a generic's own definition: what is wrong with it
// is wrong at every instantiation, and the walk that reads it is a trial whose ordinary complaints are
// thrown away, so the refusal is recorded as one the trial keeps.
bind_member_args(cx: &Analyzer, span: Span, shown: string, m: MethodDecl,
                 written_args: Buf[Expr], kept: bool = false) -> Option[Buf[Option[Expr]]]
    val args = pack_rest(cx, shown, m.params, written_args, true)
    var slots: Buf[Option[Expr]] = buf()

    for i in 0..<m.params.len()
        slots.push(None)

    var next: usize = 0
    var extra: usize = 0
    var named_seen = false

    for a in args
        *a.kind match
            NamedArg(name, value) ->
                named_seen = true

                var idx: int = -1

                for j in 0..<m.params.len()
                    if m.params.at(j).name == name then idx = int(j)

                if idx < 0
                    member_args_fault(cx, a.span, kept, shown, s"$shown declares no parameter named " +
                                      s"'$name' — it takes ${name_list(m.params)}")
                    return None

                slots.set(usize(idx), Some(value))
            _ ->
                if next >= m.params.len() then extra += 1
                else
                    slots.set(next, Some(a))
                    next += 1

    var missing: usize = 0

    for i in 0..<m.params.len()
        if slots.at(i).is_none() && m.params.at(i).default.is_none() then missing += 1

    if missing > 0 || (extra > 0 && !m.variadic)
        member_args_fault(cx, span, kept, shown, arity_refusal(shown, m.params, args, slots, named_seen, extra,
                                                        m.variadic))
        return None
    end if

    note_scoped_args(cx, m, slots)
    Some(slots)
end bind_member_args

// Records where each argument at one of `m`'s `@scoped` parameters was written, before any of them
// is read: the closure literal written there is lowered while it is read, and that is when what it
// captures is decided (`closure.sysl`'s `lower_closure`).
private note_scoped_args(cx: &Analyzer, m: MethodDecl, slots: Buf[Option[Expr]])
    if m.marks.scoped.is_empty() then return

    for i in 0..<m.params.len()
        if holds_string(m.marks.scoped, m.params.at(i).name) && slots.at(i).is_some() then
            cx.an.scoped_args.add(scoped_arg_key(cx, slots.at(i).unwrap().span))
end note_scoped_args

//
// **A refusal the definition kept is not said again by an instantiation.** The call is the same
// written call either way, and its mistake is the same one; only the subject differs -- the trait's
// member at the definition, the instantiated type's at each instantiation -- so the one the reader
// gets is the trait's, which is the signature the call was read against.
private member_args_fault(cx: &Analyzer, span: Span, kept: bool, shown: string, message: string)
    if kept then cx.an.bound_fault(cx.scope, span, message)
    else if !cx.an.said_through_bound(cx.scope, span,
                                      from_utf8_unchecked(message.bytes[shown.bytes.len..<
                                                                        message.bytes.len])) then
        cx.fault(span, message)

// **The tail of a variadic member**: every positional argument past the ones its parameters took,
// each read at whatever type it has and passed as C's promotions leave it -- the free function's
// rule (`expr_call.sysl`), read one slot in. The slots `bind_member_args` hands back name only the
// declared parameters, so a caller that lowers the slots alone passes the callee no tail at all.
private member_tail(cx: &Analyzer, m: MethodDecl, args: Buf[Expr]) -> Buf[TExpr]
    var out: Buf[TExpr] = buf()

    if !m.variadic then return out

    var positional: usize = 0

    for a in args
        *a.kind match
            NamedArg(_, _) -> ()
            _ ->
                if positional >= m.params.len() then out.push(variadic_extra(cx, a, false))

                positional += 1

    out
end member_tail

// The receiver as the member's `self` asked for it: a copy, an address, or a counted reference.
// The receiver **in the type the member's `self` was declared at**, which for a slice is the one
// coercion that is not a change of mode: a `[]T` reaching a member of `[]const T` views its elements
// read-only, exactly as an argument in that position does.
//
// It is here rather than left to the caller because the receiver is not among the arguments a call
// writes, so nothing else looks at it -- and the two spellings lower identically, which is what kept
// this invisible until a typed tree was diffed.
private as_read_only(tr: TExpr, want: Type) -> TExpr
    want match
        Slice(welem, want_ro) ->
            if !want_ro then return tr

            texpr_type(tr) match
                Slice(gelem, got_ro) ->
                    if got_ro || !type_eq(*gelem, *welem) then return tr

                    // A view taken right here is taken read-only, as one taken where an argument
                    // wants a `[]const T` is: nothing can write through it, so `xs[..].any(p)` on a
                    // large by-value array leaves the array where its caller put it
                    // (`reads_in_place`) rather than copying it in to lend a licence nobody uses.
                    *tr.kind match
                        TSlice(base, lo, hi, inclusive, _) ->
                            TExpr(tr.span, TSlice(base, lo, hi, inclusive, Slice(gelem, true)))
                        _ -> TExpr(tr.span, TConstView(tr))
                _ -> tr
        _ -> tr
end as_read_only

build_receiver(cx: &Analyzer, span: Span, mode: RecvMode, tr: TExpr,
                       member: string, relocates: bool = false) -> TExpr = mode match
    // A by-value receiver is a **copy**, made by the caller, so calling one needs the layout exactly
    // as building the value does: without the refusal an opaque type's `self` methods would copy the
    // fields as they stood when the caller was compiled. `*self` and `&self` need no shape.
    ByValue ->
        val value = texpr_type(tr) match
            Struct(_) -> tr
            Enum(_) -> tr
            _ -> auto_deref(cx, tr)

        if !value_layout_known(cx, span, texpr_type(value)) then return bad_expr(span)

        value
    ByPtr -> texpr_type(tr) match
        Ptr(_) -> tr
        _ ->
            val place = texpr_type(tr) match
                Ref(_, _) -> auto_deref(cx, tr)
                _ -> tr

            if !is_place(place) then
                cx.fault(span, "'*self' needs a variable, field, or dereference to point at — this " +
                         "receiver has no address")

            refuse_written_once_receiver(cx, span, place, member)

            // A read of a union field whose bytes can be wrong is checked where it is read, and a
            // method reading through `*self` would be no such read -- the same reason `ref` is refused.
            if checked_union_place(place) then
                cx.fault(span, s"the '*self' method '$member' cannot be called on a field of a union that " +
                         s"is ${type_show(texpr_type(place))} — a read of it checks its bytes, a read " +
                         "through '*self' would not, and a write to another field changes them. Read it " +
                         "into a 'var' and call the method on that")

            // A `*self` method is handed somewhere to write, so it is the one call that could move
            // storage a live `ref` is standing on -- asked here, where the receiver becomes a place
            // the caller can be told about. A `@relocates` member is asked by its caller instead,
            // under its own name, so the refusal says which call moves the storage.
            if !relocates then check_ref_call(cx, span, place)
            TExpr(span, TAddrOf(place, Ptr(texpr_type(place))))
    // **What is missing is the COUNT, not an address**: a `&self` method may keep what it is called
    // on, so it needs a box to keep a share of, and a value on the stack -- a local `var` as much as a
    // fresh construction -- has none. Boxing a copy here would hand the method a share of something
    // the caller never sees again. So the refusal names the binding, which is where the box is made,
    // and the call comes to `Unknown` so nothing downstream of it says more.
    ByRef(_) -> texpr_type(tr) match
        Ref(_, _) -> tr
        Unknown -> tr
        _ ->
            val shown = type_show(texpr_type(tr))

            cx.err(span, s"'&self' needs a counted reference, and this receiver is a $shown on the " +
                   "stack — a '&self' method may keep hold of what it is called on, so what it wants " +
                   "is a share of a box rather than an address. Bind the value into one and call it " +
                   s"on that: 'var r: &$shown = …'")

// The name the lowered member goes under. A member of a concrete type was lowered eagerly; a member
// of a generic type is instantiated here, from the receiver's own type arguments, and its body
// queued -- so both answer with a name the instantiation table holds.
//
// A member with type parameters **of its own** is not named by its receiver: the arguments that fix
// those come from the call, so the call is where it is named.
member_func_name(cx: &Analyzer, span: Span, ty: Type, mname: string) -> string
    val found = member_key(cx.an, ty, mname)
    val generic = cx.an.tables.members.generic.get(member_key_of(found.0, mname))

    if generic.is_none()
        val filed = cx.an.tables.members.funcs.get(member_key_of(found.0, mname))

        if filed.is_some() then return filed.unwrap()

        return s"${member_symbol(member_receiver_type(cx.an, ty, mname))}.$mname"

    val fd = generic.unwrap()

    if fd.tparams.len() > found.1.len()
        cx.fault(span, s"'$mname' has type parameters of its own, so ${type_show(ty)} alone does " +
                 "not say which instantiation is meant — call it, and the arguments will")
        return ""

    asked(cx, span, instantiate_func(cx.an, instantiation_scope(cx, fd.name), fd, found.1,
                                     viewed_const(ty, found.0)))
end member_func_name

// The file a generic member's signature and body are read in when it is made real.
//
// **An inherited default is read where the TRAIT wrote it, on a generic type as on any other**: the
// copy's body is the trait's source, so the names in it are the trait's file's and a complaint about
// it lands there. Everything else is read where its block is. `Self` is the one thing in a copy the
// trait did not write, and `self_for` resolves that in the block's terms whichever this answers.
instantiation_scope(cx: &Analyzer, name: string) -> Scope
    if cx.an.tables.members.default_origin.has(name) then
        val written = cx.an.tables.members.decl_scope.get(name)

        if written.is_some() then return written.unwrap()
    end if

    cx.an.tables.members.generic_scope.get(name).unwrap_or(cx.scope)
end instantiation_scope

// Which of a type's members a written name means, where more than one thing gave the type a member
// of that name.
//
// A name that reaches one member comes straight back, so the ordinary call is the lookup it always
// was. Where there are several, **scope decides before the arguments do**, because the two axes
// answer different questions and only the first can answer its own: two implementations of one trait
// differ in their argument lists and are told apart by a call's values, while two *different traits*
// may declare one name with one parameter list -- and nothing in a call could ever tell those apart.
// What tells them apart is that a trait's member is reachable only where the trait can be named.
//
// This is **not** overloading. A trait's argument list is what tells its implementations apart, and a
// call carries that list in the values it passes -- so a call that does not determine one is a call
// whose arguments name no implementation, which is reported rather than resolved by a preference
// rule.
//
// Nothing where the name settles nothing, which is what tells the caller to stop.
//
// **`provided` says the COMPILER supplies a member of this name for this type as well** -- a candidate
// with no row in any table, since `5.0.mul(2.0)` is answered by the instruction rather than by a
// block. It matters only where a block was written for a built-in at *other* arguments: without it
// that block is the one candidate and takes every call, including the ones the machine has an
// instruction for. The plain name coming back is what reaches the instruction, nothing being filed
// under it.
private chosen_member(cx: &Analyzer, rty: Type, base: string, mname: string, span: Span,
                      args: Buf[Expr], via: Buf[string] = no_bound_traits(),
                      provided: bool = false) -> Option[string]
    val alts = cx.an.tables.members.alts.get(member_key_of(base, mname))
    val subject = type_show(rty)

    if alts.is_none()
        if member_reachable(cx, base, mname, via, implicit = true) then return Some(mname)

        var one: Buf[string] = buf()

        one.push(mname)
        out_of_scope(cx, span, base, mname, one, subject)
        return None
    end if

    // **A bound answers ahead of everything else.** Inside a generic body a member means the one the
    // bound promised, and at an instantiation the parameter has become an ordinary type whose table
    // may hold several -- so the traits the parameter was bounded by are what the candidates are
    // narrowed to first. Without it a body is refused for an ambiguity its own signature already
    // settled, and which the caller has no way to speak to.
    var named: Buf[string] = buf()

    if !via.is_empty()
        for i in 0..<alts.unwrap().len()
            val tr = cx.an.tables.members.from_trait.get(member_key_of(base, alts.unwrap().at(i)))

            if tr.is_some() && holds_string(via, tr.unwrap()) then named.push(alts.unwrap().at(i))

    val all = if named.is_empty() then alts.unwrap() else named

    // **Scope decides before the arguments do**, because two implementations of one trait differ in
    // their argument lists while two *different traits* may declare one name at one parameter list,
    // and nothing in a call could tell those apart.
    var cands: Buf[string] = buf()

    for item in all
        if member_reachable(cx, base, item, via) then cands.push(item)

    // **What the file names answers first; the impls the program can see answer only where it named
    // none of them** -- Scala 3's lexical scope ahead of its implicit scope. So an import still
    // settles which of two traits is meant, and a call naming neither reaches whichever one an impl
    // gave the type, or is ambiguous between several.
    val implicit = cands.is_empty()

    if implicit
        for item in all
            if member_reachable(cx, base, item, via, implicit = true) then cands.push(item)

    if cands.is_empty()
        if provided then return Some(mname)

        out_of_scope(cx, span, base, mname, alts.unwrap(), subject)
        return None
    end if

    if cands.len() == 1 && !provided then return Some(cands.at(0))

    var arg_tys: Buf[Option[Type]] = buf()

    for arg in args
        val tried = begin_trial(cx)
        val t = type_expr(cx, arg, None)

        discard_trial(cx, tried)

        if texpr_type(t) == Unknown then arg_tys.push(None) else arg_tys.push(Some(texpr_type(t)))

    // **A type's own overloads are an overload set**, and are refused in the words a function's are;
    // the members of several implementations of one trait are the other case.
    var overloads = true

    for cand in cands
        if cx.an.tables.members.from_trait.get(member_key_of(base, cand)).is_some() then
            overloads = false

    val from = if overloads then s"'$mname' on $subject has ${quantity(cands.len(), "declaration")}" else
        s"'$mname' comes from ${quantity(cands.len(), "implementation")} of one trait on $subject"

    // Which candidate a call means is read off the arguments it wrote, **in the order it wrote
    // them** -- so a name, which is exactly a refusal to say what an argument's position is, has
    // nothing here to choose between them.
    for arg in args
        *arg.kind match
            NamedArg(_, _) ->
                cx.fault(arg.span, s"$from, and which is meant is read off the arguments as " +
                         "written — so an argument given by name leaves nothing to tell them " +
                         "apart. Write them in declared order")
                return None
            _ -> ()

    // **Which candidates apply, and which of several is meant, is the overload rule and no other**
    // (`reference/declarations.md § Overloading`): an argument applies where its reading AT the
    // candidate's parameter comes out at that parameter, which is what lets a bare `3` stand at a
    // `long`; and among several that apply, `narrowed_at` -- the tie-breaks an overload set is
    // decided by -- picks the one written at the arguments' own types, and leaves two reached only
    // by conversion ambiguous.
    var fits: Buf[string] = buf()
    var fitted: Buf[Buf[Type]] = buf()
    var declared: Buf[usize] = buf()
    var generic: Buf[bool] = buf()

    for cand in cands
        val params = member_accepts(cx, rty, base, cand, args, arg_tys)

        if params.is_some()
            fits.push(cand)
            fitted.push(params.unwrap())
            declared.push(member_at(cx.an, base, cand).unwrap().params.len())
            generic.push(cx.an.tables.members.generic.get(member_key_of(base, cand)).is_some())
        end if

    if fits.len() > 1
        val chosen = narrowed_at(declared, generic, fitted, args, arg_tys)

        if chosen.len() == 1 then return Some(fits.at(chosen.at(0)))
    end if

    if fits.len() == 1 then return Some(fits.at(0))

    if overloads && !provided
        if fits.len() > 1
            val chosen = narrowed_at(declared, generic, fitted, args, arg_tys)
            var tied: Buf[string] = buf()

            for i in chosen
                tied.push(fits.at(i))

            if tied.is_empty() then tied = fits

            cx.fault(span, s"'$subject.$mname' is ambiguous here — ${tied.len()} of its " +
                     s"declarations take these arguments:\n${member_signatures(cx, base, subject, mname, tied)}" +
                     "\nAnnotate an argument, or name the type a literal is meant at")
            return None
        end if

        // Nothing fits. Where exactly one declaration could take this many arguments, the call was
        // written meaning that one and got an argument wrong, so its own complaint is the message.
        var plausible: Buf[string] = buf()

        for cand in cands
            val d = member_at(cx.an, base, cand).unwrap()

            if args.len() <= d.params.len() || (d.variadic && args.len() >= d.params.len()) then
                plausible.push(cand)

        if plausible.len() == 1 then return Some(plausible.at(0))

        cx.fault(span, s"no '$subject.$mname' takes these arguments — the declarations of that " +
                 s"name are:\n${member_signatures(cx, base, subject, mname, cands)}")
        return None
    end if

    // No written block takes these arguments and the compiler has a member of this name: that is the
    // ordinary call the instruction answers.
    if fits.is_empty() && provided then return Some(mname)

    // Nothing has settled it. Which complaint that is depends on what is left standing: several
    // **traits** is a use that reached more than one of them, and no argument could have told those
    // apart. Several implementations of one trait is the older situation, where the arguments were
    // the question and did not answer it.
    val left = if fits.is_empty() then cands else fits
    var traits: Buf[string] = buf()

    for item in left
        val tr = cx.an.tables.members.from_trait.get(member_key_of(base, item))

        if tr.is_some()
            var seen = false

            for j in 0..<traits.len()
                if traits.at(j) == module_show(tr.unwrap()) then seen = true

            if !seen then traits.push(module_show(tr.unwrap()))

    if traits.len() > 1 && implicit
        cx.fault(span, s"'$mname' on $subject comes from ${conjoin(traits)}, and this file names " +
                 "none of them — nothing in the call says which was meant; import the one that " +
                 "was meant")
        return None
    end if

    if traits.len() > 1
        cx.fault(span, s"'$mname' on $subject comes from ${conjoin(traits)}, and each is in scope " +
                 "here — nothing in the call says which was meant")
        return None
    end if

    if fits.is_empty()
        cx.fault(span, s"$from, and none of them takes (${shown_args(arg_tys)}) — write the " +
                 "argument at the type of the implementation that was meant")
        return None
    end if

    cx.fault(span, s"$from, and the arguments do not say which was meant")
    None
end chosen_member

// The roster an overload refusal carries, one declaration a line, each as it was written.
private member_signatures(cx: &Analyzer, base: string, subject: string, mname: string,
                          names: Buf[string]) -> string
    var b = str_builder()

    for i in 0..<names.len()
        val d = member_at(cx.an, base, names.at(i)).unwrap()

        if i > 0 then b.push("\n")

        b.push(s"    $subject.$mname(")

        for j in 0..<d.params.len()
            if j > 0 then b.push(", ")

            b.push(s"${d.params.at(j).name}: ${type_text(d.params.at(j).typ)}")

        b.push(")")

    b.finish()
end member_signatures

// The argument types a refusal quotes back, with an argument that could not be read left as a
// question mark rather than as a guess.
private shown_args(arg_tys: Buf[Option[Type]]) -> string
    var b = str_builder()

    for i in 0..<arg_tys.len()
        if i > 0 then b.push(", ")

        b.push(if arg_tys.at(i).is_none() then "?" else type_show(arg_tys.at(i).unwrap()))

    b.finish()
end shown_args

// A member a use site cannot reach at all: the trait that brought it is one this file may not name.
private out_of_scope(cx: &Analyzer, span: Span, base: string, mname: string, cands: Buf[string],
                     subject: string)
    var named: Buf[string] = buf()

    for cand in cands
        val tr = cx.an.tables.members.from_trait.get(member_key_of(base, cand))

        if tr.is_some() && reachable_key(cx.an, tr.unwrap(), cx.scope)
            var seen = false

            for j in 0..<named.len()
                if named.at(j) == module_show(tr.unwrap()) then seen = true

            if !seen then named.push(module_show(tr.unwrap()))

    // A trait this file may not **name** is not one an import would reach, so advising the import
    // would send a reader after a line the compiler refuses.
    if named.is_empty()
        cx.fault(span, s"$subject has '$mname', but the trait declaring it is private to the module " +
                 "that wrote it — the member is an implementation detail rather than something to " +
                 "import")
        return
    end if

    val tail =
        if named.len() == 1 then "that trait is not in scope here — import it to reach the member"
        else "none of those traits is in scope here — import the one that was meant"

    cx.fault(span, s"$subject has '$mname' from ${conjoin(named)}, and $tail")
end out_of_scope

// The parameter types one candidate takes a call's arguments at, or nothing where it does not take
// them: each argument is read at its parameter, as a call of that candidate would read it, and has to
// come out at that parameter's type with nothing said on the way.
//
// A candidate that takes a `...` is answered for by its declared parameters alone: the tail stands at
// none, so what it may be told apart by stops where they do. A default widens the same count
// downwards, and for the same reason -- a call may stop where the defaults begin.
private member_accepts(cx: &Analyzer, rty: Type, base: string, filed: string,
                       args: Buf[Expr], arg_tys: Buf[Option[Type]]) -> Option[Buf[Type]]
    val m = member_at(cx.an, base, filed)

    if m.is_none() then return None

    // **Weighing a generic candidate makes it real, and that is put back**: the candidate may not be
    // the one chosen, and an instantiation left queued is a body analyzed for a call nobody made --
    // a conditional block's body read at a type its condition was written to keep out, refused
    // inside the block. The chosen one is made real again by the call that goes through it.
    val tried = begin_trial(cx)
    val fname = member_func_name_quiet(cx, rty, filed)
    val sig = if fname == "" then None else cx.an.tables.members.func_insts.get(fname)

    discard_trial(cx, tried)

    if sig.is_none() then return None

    var params: Buf[Type] = buf()
    // **The receiver is a parameter of the lowered function and not of the member**, so it is
    // dropped -- but only where the member has one. An associated function's first parameter is its
    // own, and dropping it leaves a candidate that appears to take nothing and fits no call.
    val first: usize = if m.unwrap().recv_mode().is_some() then 1 else 0

    for i in first..<sig.unwrap().params.len()
        params.push(sig.unwrap().params.at(i).1)

    var least: usize = 0

    for i in 0..<m.unwrap().params.len()
        if m.unwrap().params.at(i).default.is_none() then least += 1

    var counted = args.len() <= params.len() && args.len() >= least

    if m.unwrap().variadic then counted = args.len() >= params.len()

    if !counted then return None

    // **A closure or a trailing block tells no candidate apart, and neither does a reading that was
    // refused** -- a closure takes its whole shape from the parameter it is read at, so it would fit
    // every callable candidate it could be read at. It fits none, and a call it alone would have to
    // settle is reported as not settled rather than handed to whichever one it was read at first.
    for i in 0..<params.len()
        if i < args.len()
            if arg_tys.at(i).is_none() || declines(args.at(i)) then return None
            if !reads_at(cx, args.at(i), params.at(i)) then return None
        end if

    Some(params)
end member_accepts

// An argument that is a closure or a trailing block, which no implementation is chosen by.
private declines(e: Expr) -> bool = *e.kind match
    Lambda(_, _, _) -> true
    BlockArg(_) -> true
    _ -> false

// Whether an argument read at a parameter's type comes out at that type with nothing said -- the
// question a call of one candidate answers for each argument. Every trace of the reading is put back,
// the instantiations and closures it made included, since the candidate may not be the one chosen.
private reads_at(cx: &Analyzer, e: Expr, want: Type) -> bool
    val tried = begin_trial(cx)
    val t = analyze_expected(cx, e, Some(want))
    val refused = refused_since(cx, tried)

    discard_trial(cx, tried)
    !refused && type_eq(texpr_type(t), want)
end reads_at

// The lowered name a candidate goes under, with nothing said where it has none: this is asked while
// candidates are being weighed, and a complaint about one that was not chosen is one nobody asked
// for.
private member_func_name_quiet(cx: &Analyzer, rty: Type, filed: string) -> string
    val mark = cx.an.complaints()
    val name = member_func_name(cx, span_zero(), rty, filed)

    cx.an.restore_complaints(mark)
    name
end member_func_name_quiet

// -- what a use site is allowed to reach ------------------------------------------------------------

// Whether a member a trait brought is one this file may name. A trait's member is reachable only
// where the trait can be named, which is what keeps the first library to implement a wide trait for
// a built-in from claiming those names from everybody.
// **`Plain`'s `encode` and `decode` -- members the compiler supplies to every plain-data type --
// answer ahead of a member of the name that the file reaches only implicitly** (`reference/traits.md
// § Two traits may declare a member of one name`): what the file names answers first, and a file
// importing `sysl.encoding.Plain` has named that trait, while `sysl.codec`'s `Encode`, given to every
// integer by a blanket `impl` the program can see, it has not. A trait the file or a bound does name
// that gives the type the member keeps it, and a type that is not plain data is left to the lookup.
private plain_ahead(cx: &Analyzer, ty: Type, base: string, mname: string, via: Buf[string]) -> bool
    if !is_plain(ty) then return false

    if member_at(cx.an, base, mname).is_some() && member_reachable(cx, base, mname, via) then return false

    val alts = cx.an.tables.members.alts.get(member_key_of(base, mname))

    if alts.is_some()
        for item in alts.unwrap()
            if member_reachable(cx, base, item, via) then return false

    // **A receiver that is not a written `x` -- `T.decode(n).encode()` -- still has the bounds of the
    // parameter it was made from**: the instantiation knows `T` is this type, and its signature said
    // which traits it promised.
    for item in cx.subst
        if type_eq(item.ty, ty)
            val promised = bound_traits(cx, item.name)

            if member_at(cx.an, base, mname).is_some() && member_reachable(cx, base, mname, promised) then return false

            if alts.is_some()
                for filed in alts.unwrap()
                    if member_reachable(cx, base, filed, promised) then return false

    true
end plain_ahead

member_reachable(cx: &Analyzer, base: string, filed: string,
                 via: Buf[string] = no_bound_traits(), implicit: bool = false) -> bool
    val from = cx.an.tables.members.from_trait.get(member_key_of(base, filed))

    // A member that arrives with its type is reachable wherever the type is.
    if from.is_none() then return true

    // **A bound has said which trait at least as plainly as an import would.** A signature naming
    // one is what an instantiated body reaches its member through, the file the instantiation is
    // read in having imported nothing on the body's behalf.
    if holds_string(via, from.unwrap()) then return true

    // **A member an `impl` brought is reached where its trait can be NAMED, not merely where the
    // trait is visible.** The two are different questions and only the first is what an import
    // changes: a file naming `sysl.text.Search` reaches its `trim` ahead of any other trait's.
    if names_trait(cx, from.unwrap()) then return true

    // **The second reach is the impl's own visibility** (`reference/traits.md § Reaching a member
    // through its trait`): a member an `impl` the program can see gave a type is reached on a value
    // of that type with no import at all, once nothing the file names has answered. A trait private
    // to the module that wrote it stays out of reach, since nothing outside could name it either.
    implicit && reachable_key(cx.an, from.unwrap(), cx.scope)
end member_reachable

// Whether the file the expression is written in can name a trait: its own module's, one it imported,
// or one a bound in force promised.
names_trait(cx: &Analyzer, key: string) -> bool
    val home = module_of(key)

    if home == cx.scope.module_name then return true

    // A module below the one that declares the trait names it too, which is what makes a module
    // split across a directory one thing to its own files.
    if cx.scope.module_name.starts_with(s"$home.") then return true

    for item in cx.subst
        item.ty match
            Abstract(_, bounds) ->
                for j in 0..<bounds.len()
                    if bounds.at(j).name == key then return true
            _ -> ()

    // **The imports are asked directly rather than through the name's resolution.** A program may
    // declare a `Display` of its own, which takes the bare word without taking the library's trait
    // out of scope: the wildcard that offered it still does, so `str(x).display(…)` and a
    // subscript's `index` reach the library's member beside the program's trait of that name.
    val bare = module_bare(key)
    val im = cx.scope.imports

    for item in im.names
        if item.0 == bare && item.1 == key then return true

    for item in im.wildcards
        if item == home then return true

    false
end names_trait

// The traits a receiver's own **bound** promised, read off the expression as written.
//
// This is the one thing the analyzed receiver cannot be asked for. An `x` of a `[T: Zero]` body has
// become an `int` by the time an instantiation looks at it, so the question is put to the source --
// where the name is still `x`, and `pbounds` still knows `x` was written as a `T`.
receiver_bound(cx: &Analyzer, recv: Expr) -> Buf[string]
    val written = *recv.kind match
        Ident(n) -> n
        _ -> ""

    if written == "" then return no_bound_traits()

    for pbound in cx.pbounds
        if pbound.0 == written then return bound_traits(cx, pbound.1)

    no_bound_traits()
end receiver_bound

// The same for a **type** written in the position `T.zero()` puts one: the name is the parameter's
// own, so the bound is read straight off it rather than off a value that was written as one.
private written_bound(cx: &Analyzer, recv: Expr) -> Buf[string] = *recv.kind match
    Ident(n) -> bound_traits(cx, n)
    _ -> no_bound_traits()

// The traits a type parameter was bounded by, as keys -- what a use inside the body may reach
// through it whether or not the file also imported them, the signature having named them.
bound_traits(cx: &Analyzer, written: string) -> Buf[string]
    var keys: Buf[string] = buf()
    val bounds = named_bounds_of(cx.tbounds, written)

    if bounds.is_none() then return keys

    for i in 0..<bounds.unwrap().len()
        val key = lookup_trait_key(cx.an, cx.scope, bounds.unwrap().at(i).name)

        if key.is_some() then push_with_required(cx, key.unwrap(), &keys)

    keys
end bound_traits

// A bound's trait and every trait it requires, each once. **A bound promises what the trait it names
// requires**: `[T: wire.Codec]` with `trait Codec: Encode` reaches `Encode`'s members through the
// signature alone, so a member the compiler supplies under the same name does not answer ahead of it.
private push_with_required(cx: &Analyzer, key: string, keys: *Buf[string])
    if holds_string(*keys, key) then return

    keys.push(key)

    val d = trait_decl_at(cx.an, key)

    if d.is_none() then return

    val home = cx.an.tables.types.get(key)

    if home.is_none() then return

    for s in d.unwrap().supers
        val sk = lookup_trait_key(cx.an, home.unwrap().scope, s.name)

        if sk.is_some() then push_with_required(cx, sk.unwrap(), keys)
end push_with_required

// Whether the member a bound promised is one the **compiler** supplies for this type, so that nothing
// in the type's tables is what the generic body meant.
//
// At an instantiation the parameter has become an ordinary type, and its tables may hold a member of
// the same name that some other trait gave it -- a private trait in the instantiating module, or one
// beside the generic body itself. Neither is what `[T: Zero]` promised: `int`'s `Zero` has no block,
// its `zero()` being the compiler's. So where a trait in force through the bound declares the member,
// the compiler supplies it for this type, and no filed candidate comes from a bound trait, the table
// is not consulted at all -- the lookup answers through the bound, as it did at the definition.
bound_supplied_by_compiler(cx: &Analyzer, rty: Type, base: string, name: string,
                           via: Buf[string]) -> bool
    if via.is_empty() then return false

    // Only the receiverless ones can meet a block of the same name: a block declaring an operator's
    // method for a type the compiler already answers it for is refused where it is written.
    val spelling = core_constant(name) match
        Some(row) -> Some(row.0)
        None -> core_measure_trait(name)

    if spelling.is_none() || !core_builtin(spelling.unwrap(), rty) then return false

    val key = catalog_key(cx.an, spelling.unwrap())

    if key.is_none() || !holds_string(via, key.unwrap()) then return false

    // A block the bound's own trait filed for the type answers through the table as it always did.
    var filed: Buf[string] = buf()

    if has_member_at(cx.an, base, name) then filed.push(name)

    val alts = cx.an.tables.members.alts.get(member_key_of(base, name))

    if alts.is_some()
        for item in alts.unwrap()
            filed.push(item)

    for item in filed
        val tr = cx.an.tables.members.from_trait.get(member_key_of(base, item))

        if tr.is_none() || holds_string(via, tr.unwrap()) then return false

    true
end bound_supplied_by_compiler

// **Two bounds that both declare a member are ambiguous whichever of them the compiler supplies.**
// `[T: Zero + Nil]` with a user trait `Nil` that also declares `zero()` promises two `zero`s at
// `int`, one of them the compiler's, which has no block and so is no rival among the filed
// candidates. The refusal is the one two written traits get, naming the compiler's trait first.
// True where it was refused.
private refuse_bound_clash(cx: &Analyzer, rty: Type, base: string, name: string, span: Span,
                           via: Buf[string]) -> bool
    if via.is_empty() then return false

    val spelling = core_constant(name) match
        Some(row) -> Some(row.0)
        None -> core_measure_trait(name)

    if spelling.is_none() || !core_builtin(spelling.unwrap(), rty) then return false

    val key = catalog_key(cx.an, spelling.unwrap())

    if key.is_none() || !holds_string(via, key.unwrap()) then return false

    var filed: Buf[string] = buf()

    if has_member_at(cx.an, base, name) then filed.push(name)

    val alts = cx.an.tables.members.alts.get(member_key_of(base, name))

    if alts.is_some()
        for item in alts.unwrap()
            filed.push(item)

    var traits: Buf[string] = buf()

    traits.push(module_show(key.unwrap()))

    for item in filed
        val tr = cx.an.tables.members.from_trait.get(member_key_of(base, item))

        if tr.is_some() && holds_string(via, tr.unwrap()) && !holds_string(traits, module_show(tr.unwrap())) then
            traits.push(module_show(tr.unwrap()))

    if traits.len() < 2 then return false

    cx.fault(span, s"'$name' on ${type_show(rty)} comes from ${conjoin(traits)}, and each is in " +
             "scope here — nothing in the call says which was meant")
    true
end refuse_bound_clash

// No bound at all, named so that a default argument can say which kind of run of names it means.
no_bound_traits() -> Buf[string] = buf()

// No written type-argument list, which is what nearly every member call has.
no_written_members() -> Buf[Expr] = buf()

// Whether `recv.name[…]` names a METHOD, which is what lets its brackets be a type-argument list:
// `x.handlers[i](…)` is a field holding a table of callables, indexed and called, so the receiver is
// read -- a reading thrown away -- and asked whether it declares a method of that name. A field wins,
// being what the subscript would have been reaching into.
method_written(cx: &Analyzer, recv: Expr, name: string) -> bool
    val t = sandboxed_arg(cx, recv, None)
    val rty = receiver_type(texpr_type(t))

    // **A type parameter answers through its bounds**: `o.one[int]()` on an `o: *O` of `[O: Out]`
    // names `Out`'s method exactly as it names `Sink`'s on a `Sink`.
    rty match
        Unknown -> return false
        Abstract(_, bounds) ->
            val found = bound_member(cx.an, rty, bounds, name)

            return found.is_some() && found.unwrap().2.recv_mode().is_some()
        Trait(_, _, _) -> return false
        Weak(_) -> return false
        _ -> ()

    val m = member_at(cx.an, member_key(cx.an, rty, name).0, name)

    m.is_some() && m.unwrap().recv_mode().is_some()
end method_written

// Whether the receiver meets the condition of the `impl` that gave it a member. The member table is
// keyed by the type and not by its arguments, so a conditional block -- `impl[T: Show] Show for
// Box[T]` -- files its members under every `Box`, and the condition is asked here, of the arguments
// this receiver was made with. Without it a `Box` of something that is not `Show` would call `show`.
//
// **The arguments are the ones the member was found at**, which for a shape-matched block are not the
// type's own: `impl[..A: Hash] Hash for (..A)` is filed under the pack shape, and a tuple matches it
// with its parts as one pack. Asked only of the type's own key, a tuple of something that is not
// `Hash` reached the block's body and was refused inside the library rather than at the call.
//
// It answers whether the call may go on. A refused condition is the whole of what is wrong, so the
// caller abandons the call rather than instantiating a body the condition was written to keep out --
// whose own refusal would be a second diagnostic, located in the block and not at the call.
private check_impl_condition(cx: &Analyzer, span: Span, rty: Type, base: string, filed: string) -> bool
    val unmet = impl_condition_unmet(cx.an, rty, base, filed)

    if unmet.is_none() then return true

    val from = cx.an.tables.members.from_trait.get(member_key_of(base, filed)).unwrap_or("")

    cx.fault(span, s"'${source_member_name(unsuffixed_member(filed))}' is a member the 'impl' of " +
             s"'${qualified_name(from)}' gives '${type_show(rty)}' only where its condition holds, " +
             s"and ${unmet.unwrap()}")
    false
end check_impl_condition

// What a receiver lacks for the condition of the `impl` that gave it a member, as the tail of a
// refusal (`it asks 'Show' of T, which does not implement it`), or nothing where the condition holds
// or the block has none. A `?` converting through a conditional `From` asks the same question.
impl_condition_unmet(a: &Analysis, rty: Type, base: string, filed: string) -> Option[string]
    val from = a.tables.members.from_trait.get(member_key_of(base, filed))

    if from.is_none() then return None

    val owner = member_key(a, rty, filed)

    if owner.0 != base then return None

    // **The block is told apart by its suffix**: a second block of one trait files its members as
    // `from.2`, and the name it was written under is what comes before the suffix. Comparing the
    // whole filed name against each block's name-plus-suffix would match `from.2` to the FIRST block
    // (whose suffix is empty) and ask that block's condition of a call the second one answers.
    val name = unsuffixed_member(filed)

    for ti in impls_of(a, from.unwrap(), base)
        if !ti.conditional || name + ti.alt != filed || ti.tparams.len() != owner.1.len() then continue

        var subst: Buf[Binding] = buf()

        for i in 0..<ti.tparams.len()
            subst.push(Binding(ti.tparams.at(i), owner.1.at(i)))

        val unmet = unmet_condition_of(a, ti, subst)

        if unmet.is_none() then return None

        val (packed, tr) = unmet.unwrap()
        val arg = first_unmet_part(a, tr, packed)
        val why = unmet_bound(a, tr, arg)
        val tail = if why.is_some() then s" — ${why.unwrap()}" else ""

        return Some(s"it asks '${tr.show()}' of ${type_show(arg)}, which does not implement it$tail")
    end for

    None
end impl_condition_unmet

// A filed member's name without the suffix a second block of one trait gives it (`from.2` is
// `from`). A member's own name holds no dot, so the first one starts the suffix.
private unsuffixed_member(filed: string) -> string
    val b = filed.bytes

    for i in 0..<b.len
        if b[i] == u8('.') then return filed[0..<i]

    filed
end unsuffixed_member

// Whether a member the reader named is one their file may reach.
check_member_visible(cx: &Analyzer, span: Span, base: string, filed: string, m: MethodDecl,
                     via: Buf[string] = no_bound_traits())
    if !member_reachable(cx, base, filed, via, implicit = true)
        val from = cx.an.tables.members.from_trait.get(member_key_of(base, filed)).unwrap_or("")

        cx.fault(span, s"'${source_member_name(filed)}' is a member '${qualified_name(from)}' gave " +
                 s"'${qualified_name(base)}', and a trait's member is reached where the trait can be " +
                 "named — import it")
        return
    end if

    // **Silence is not "public"**: an unmarked member sits at its type's reach, so the answer comes
    // out of the access table the hoist filed it in rather than off the modifier alone.
    val name = source_member_name(filed)

    if !member_in_reach(cx.an, base, name, cx.scope) then
        cx.fault(span, s"${member_kind(m)} '$name' of '${qualified_name(base)}' is " +
                 member_restriction(cx.an, base, name))
end check_member_visible

// -- the answers when nothing is filed ----------------------------------------------------------------

private no_such_member(cx: &Analyzer, span: Span, rty: Type, name: string) -> TExpr
    val provided = builtin_constant_read(cx, span, rty, name)

    if provided.is_some() then return provided.unwrap()

    // What the reader is told turns on what the thing left of the dot could have had. A struct has
    // fields and properties, an enum only properties, and a type with neither has no field of any
    // name for the read to have missed -- so that one is told what it tried to read and of what,
    // there being no declaration to name.
    underlying(rty) match
        Struct(_) -> cx.err(span, hinted(cx, rty, s"'${type_show(rty)}' has no field or property '$name'"))
        Enum(_) -> cx.err(span, hinted(cx, rty, s"'${type_show(rty)}' has no property '$name'"))
        _ -> cx.err(span, s"cannot read field '$name' of ${type_show(rty)}")
end no_such_member

private no_such_method(cx: &Analyzer, span: Span, receiver: TExpr, rty: Type, base: string,
                       name: string, args: Buf[Expr]) -> TExpr
    val provided = builtin_method(cx, span, receiver, rty, name, args)

    if provided.is_some() then return provided.unwrap()

    // A field holding a callable, reached only where no method of the name exists.
    val through_field = callable_field(cx, span, rty, name, receiver, args, None)

    if through_field.is_some() then return through_field.unwrap()

    // A call reaches through one level of indirection and only one, exactly as selection does. What
    // that level leaves is `rty`, so a `rty` still carrying a mode had more than the shorthand walks
    // -- and where the type under it has the method, the reader is told to write the rest out. Where
    // it has none either, the method is simply missing, and that is said of the type at the bottom,
    // the one the reader meant: no dereference written would find it.
    val bottom = innermost(rty)

    if bottom != rty
        if has_method_named(cx, bottom, name) then
            return indirection_message(cx, span, receiver, rty, name)

        return cx.err(span, s"type '${member_key(cx.an, bottom, name).0}' has no method '$name'")
    end if

    // A member the compiler provides, written with parentheses it does not take.
    if builtin_member(rty, name) then
        return cx.err(span, s"'$name' is a property the compiler provides for " +
                      s"'$base' — read it as 'value.$name', without '()'")

    // `abs` and `signum` asked of an unsigned integer or fixed-point type: the member exists, and
    // the type is the reason it is not this one's.
    if core_numeric(name).unwrap_or("") == "Signed" && is_unsigned_number(op_subject(rty)) then
        return cx.err(span, s"type '$base' has no method '$name' — '$name' is 'sysl.math.Signed''s, " +
                      s"and an unsigned value has no sign to take off: it is its own magnitude")

    // Inside a derivation, a member of the trait being derived asked of a part is the trait asked of
    // that part's type -- which the reader fixes by implementing or deriving it there.
    val deriving = derived_trait_key(cx, name)

    if deriving.is_some() then return not_derived_there(cx, span, base, name, deriving.unwrap())

    cx.err(span, hinted(cx, rty, s"type '$base' has no method '$name'"))
end no_such_method

// A part of the deriving type whose own type does not implement the trait being derived, asked for
// that trait's member: the refusal a bound would have made at the call.
private not_derived_there(cx: &Analyzer, span: Span, base: string, name: string, key: string) -> TExpr =
    cx.err(span, s"'$base' does not implement '${qualified_name(key)}': method '$name' is missing")

// Whether the type filed under `base` holds a member `name` that the trait `key` gave it -- the one
// member, or one of several the name is filed under.
private offered_by(cx: &Analyzer, base: string, name: string, key: string) -> bool
    val from = cx.an.tables.members.from_trait
    val alts = cx.an.tables.members.alts.get(member_key_of(base, name))

    if alts.is_none() then return from.get(member_key_of(base, name)).unwrap_or("") == key

    for item in alts.unwrap()
        if from.get(member_key_of(base, item)).unwrap_or("") == key then return true

    false
end offered_by

// An integer or fixed-point type with no negative values.
private is_unsigned_number(t: Type) -> bool = t match
    Integer(_, signed, _) -> !signed
    Fixed(_, _, signed) -> !signed
    _ -> false

// Whether `t` itself has a method of `name` a call could reach, declared or one the compiler provides.
private has_method_named(cx: &Analyzer, t: Type, name: string) -> bool
    val key = member_key(cx.an, t, name).0

    has_member_at(cx.an, key, name) || cx.an.tables.members.alts.has(member_key_of(key, name))

// The type under every level of indirection.
private innermost(t: Type) -> Type
    val under = receiver_type(t)

    if under == t then t else innermost(under)

private indirection_message(cx: &Analyzer, span: Span, receiver: TExpr, rty: Type,
                            name: string) -> TExpr =
    cx.err(span, s"a method call reaches through one level of indirection and " +
           s"${type_show(texpr_type(receiver))} has more, so the rest is written: " +
           s"'(*x).$name(…)' calls '$name' on the ${type_show(rty)} it leaves")

// -- a value that has forgotten which type it holds ----------------------------------------------------

// A call through a trait object: the slot the member sits in, and the table the value carries.
private call_erased(cx: &Analyzer, span: Span, receiver: TExpr, rty: Type, name: string,
                    args: Buf[Expr], expected: Option[Type]) -> TExpr
    // A callable's table and a writer's carry no `Debug` slot, and `debug` on one is answered here.
    if name == "debug" && slotless_debug(trait_bound_of(rty).name) then
        return callable_debug(cx, span, rty, args)

    val slot = erased_slot(cx, rty, name)

    if slot.is_none()
        // **A member the trait really has, that the table could not hold**, is worth saying so about
        // rather than reporting as a name the trait does not declare: the reader wrote something
        // that exists and reached it the one way that cannot work.
        val unslotted = unslotted_member(cx, rty, name)

        if unslotted then
            return cx.err(span, s"'$name' of '${trait_bound_of(rty).name}' declares type parameters " +
                          "of its own, so it is not a function until a call names them and no slot " +
                          s"of a ${type_show(texpr_type(receiver))}'s table can point at it — " +
                          "reach it through a bound, where the type is known")

        return cx.err(span, s"trait '${trait_bound_of(rty).name}' declares no method '$name' — it " +
                      s"has ${slot_names(cx, rty)}")
    end if

    val m = slot.unwrap().1

    if m.is_property then
        return cx.err(span, s"'$name' is a property of '${trait_bound_of(rty).name}' — read it as " +
                      s"'value.$name', without '()'")

    erased_call(cx, span, receiver, rty, slot.unwrap().0, slot.unwrap().2, m, args)
end call_erased

// A property read through a trait object, which is the same slot with no arguments.
private read_erased(cx: &Analyzer, span: Span, receiver: TExpr, rty: Type, name: string) -> TExpr
    val slot = erased_slot(cx, rty, name)

    if slot.is_none() then
        return cx.err(span, s"a ${type_show(texpr_type(receiver))} has no fields, and trait " +
                      s"'${trait_bound_of(rty).name}' declares no '$name'")

    val m = slot.unwrap().1

    if !m.is_property then
        return cx.err(span, s"'$name' is a method of '${trait_bound_of(rty).name}' — call it with " +
                      s"'$name(…)'")

    erased_call(cx, span, receiver, rty, slot.unwrap().0, slot.unwrap().2, m, buf())
end read_erased

// The slot a name sits in, the member the trait declared, and the bound of the trait that declared
// it. The table is laid out from the same list a bound licenses, which is what makes a slot number
// mean one thing.
// Whether a name the table has no slot for is one the trait really declares.
private unslotted_member(cx: &Analyzer, rty: Type, name: string) -> bool
    val all = trait_members(cx.an, trait_bound_of(rty), self_binding(rty))

    for item in all
        if item.1.name == name then return true

    false
end unslotted_member

// The members a table lays out for its trait, as a message lists them -- without the `debug` every
// table carries, which is not what the reader is looking for.
private slot_names(cx: &Analyzer, rty: Type) -> string
    val members = trait_members(cx.an, trait_bound_of(rty), self_binding(rty))
    var b = str_builder()
    var n = 0

    for item in members
        if item.1.tparams.is_empty()
            if n > 0 then b.push("', '")

            b.push(item.1.name)
            n += 1

    s"'${b.finish()}'"
end slot_names

private erased_slot(cx: &Analyzer, rty: Type, name: string) -> Option[(int, MethodDecl, Bound)]
    val members = slotted_members(cx.an, trait_bound_of(rty), self_binding(rty))

    for i in 0..<members.len()
        if members.at(i).1.name == name then return Some((int(i), members.at(i).1, members.at(i).0))

    None
end erased_slot

// The names a trait member's written types may use for something else: its own type parameters and
// the trait's, which a call through the table reads at the object's arguments.
private trait_names(d: Option[TraitDecl], m: MethodDecl) -> Buf[string]
    var out: Buf[string] = buf()

    for n in m.tparams
        out.push(n)

    if d.is_some()
        for n in d.unwrap().tparams
            out.push(n)

    out
end trait_names

// An argument read at the type its parameter declared, a literal that does not fit it being told that
// type as the declaration wrote it.
private argument_told(cx: &Analyzer, e: Expr, p: Param, tparams: Buf[string], want: Type) -> TExpr
    val saved = told_by(cx, Some(p.typ), Some(want), tparams)
    val t = type_expr(cx, e, Some(want))

    cx.declared = saved
    t
end argument_told

// The call itself, with the member's signature read in the object's own terms: `Self` is the object,
// which is what an object writes its bindings down for.
private erased_call(cx: &Analyzer, span: Span, receiver: TExpr, rty: Type, slot: int,
                    tr: Bound, m: MethodDecl, args: Buf[Expr]) -> TExpr
    val scope = trait_scope_of(cx.an, tr.name)
    val d = trait_decl_at(cx.an, tr.name)
    var subst = self_binding(rty)

    if d.is_some()
        for i in 0..<d.unwrap().tparams.len()
            if i < tr.args.len() then subst.push(Binding(d.unwrap().tparams.at(i), tr.args.at(i)))

    // **A slot is a member like any other**, so a call through the table binds what was written the
    // way a call to a member of a type does: a name says which parameter it fills, and a parameter
    // nothing filled takes the default -- which for a trait is written in the trait's own scope.
    val shown = member_subject(cx, rty, m.name)
    val slots = bind_member_args(cx, span, shown, m, args)

    if slots.is_none() then return bad_expr(span)

    // A trait member marked `@views(self)` answers a view borrowed from the object, whichever body
    // the slot dispatches to (`view_borrow.sysl`).
    if m.marks.views then note_view_call(cx, span, receiver, m.name)

    // **A call trait's parameters are named `a`, `b` and `c`** — names the trait's own declaration
    // chose and no reader wrote — so what a message about one can say is where it stood.
    val by_position = shown == "this callable"
    var ts: Buf[TExpr] = buf()

    for i in 0..<slots.unwrap().len()
        val want =
            if i < m.params.len() then Some(walk_wanted(m.params.at(i),
                                                        resolve_type(cx.an, scope, m.params.at(i).typ,
                                                                     subst)))
            else None

        slots.unwrap().at(i) match
            Some(e) ->
                val saved = if want.is_some() && i < m.params.len()
                            then told_by(cx, Some(m.params.at(i).typ), want, trait_names(d, m)) else cx.declared

                // The call trait's own `A` names nothing the reader wrote: the callable's written
                // type does.
                if by_position && want.is_some()
                    val told = callable_param_spelling(cx, receiver, i)

                    if told.is_some() then cx.declared = Some(Declared(want.unwrap(), told.unwrap()))

                val t = type_expr(cx, e, want)

                cx.declared = saved

                if by_position && want.is_some() && disagree(texpr_type(t), want.unwrap()) then
                    cx.fault(e.span, s"the ${ordinal(i + 1)} argument of this callable is " +
                             s"${type_show(want.unwrap())}, but ${type_show(texpr_type(t))} was " +
                             "given")

                ts.push(if i < m.params.len() then handed_walk(m.params.at(i), Some(e), t) else t)
            None ->
                val inner = analyzer_for(cx.an, scope)

                // The object's trait arguments stand for the trait's parameters here as they do
                // in the signature: `by: T = T.zero()` through a `&Pad[f64]` is `f64.zero()`.
                inner.here = Some(call_site(cx, span))
                inner.subst = subst
                ts.push(type_expr(inner, m.params.at(i).default.unwrap(), want))

    val ret =
        if m.ret_type.is_some() then declared_result_type(Some(resolve_result(cx.an, scope, m.ret_type.unwrap(), subst)))
        else Unit

    TExpr(span, TVCall(receiver, slot, ts, ret, false))
end erased_call

// `u64.wrap(x)` -- an integer read at another width or signedness by its bit pattern: the low bits
// where the target is narrower, sign- or zero-extended as the SOURCE's signedness says where it is
// wider. **It is never checked, in any build**, where the plain conversion `u64(x)` is checked in a
// debug one (`build_mode.sysl`); it is the conversion the compiler makes when nobody wrote one, which
// is why it is the lowering's unchecked `TCast` and is not recorded as written.
//
// Nothing where the receiver is not an integer type, or a parameter bounded by `Integer`, so any
// other type's own `wrap` is left to the member lookup.
private integer_wrap(cx: &Analyzer, span: Span, ty: Type, args: Buf[Expr]) -> Option[TExpr]
    if !wraps_as_integer(ty) then return None

    val shown = type_show(ty)

    if args.len() != 1
        cx.fault(span, s"'$shown.wrap' takes exactly one integer argument")
        return Some(bad_expr(span))
    end if

    val t = type_expr(cx, args.at(0), None)
    val from = repr(texpr_type(t))

    if from == Unknown then return Some(bad_expr(span))

    if !wraps_as_integer(from)
        cx.fault(span, s"'$shown.wrap' takes an integer, but the value has type ${type_show(texpr_type(t))}")
        return Some(bad_expr(span))
    end if

    Some(TExpr(span, TCast(t, ty)))
end integer_wrap

// Whether `ty` is an integer at every instantiation: an integer type, or a parameter bounded by the
// `Integer` family.
private wraps_as_integer(ty: Type) -> bool = ty match
    Integer(_, _, _) -> true
    Abstract(_, bounds) ->
        for b in bounds
            val spelling = library_spelling(b.name)

            if spelling.is_some() && core_closed(spelling.unwrap()) then return true

        false
    _ -> false

// `Colour.try(n)` — an integer read as a simple enum, answering `None` where it is not one of the
// discriminants.
//
// **It is the same conversion `Colour(n)` is**, and the difference is only what happens to a value
// the enum does not declare: the written cast traps, and this hands back an `Option`. A program
// reading a byte off a wire wants the second, which is why the form exists at all.
//
// Nothing where the receiver is not an enum at all, so a struct's own `try` is left to the member
// lookup; an enum that carries data is refused here rather than left, since the spelling is this
// form on every enum.
private enum_try(cx: &Analyzer, span: Span, ty: Type, args: Buf[Expr]) -> Option[TExpr]
    val d = ty match
        Enum(found) -> found
        _ -> return None

    if !d.simple
        cx.fault(span, s"'${qualified_name(d.base)}' carries data, so only a simple enum converts to " +
                 "and from an integer")
        return Some(bad_expr(span))
    end if

    if args.len() != 1
        cx.fault(span, s"'${qualified_name(d.base)}' takes exactly one integer argument")
        return Some(bad_expr(span))
    end if

    val t = type_expr(cx, args.at(0), Some(d.underlying))

    // Besides an integer, an enum field of a bitfield struct is taken as it is: its bits were put
    // there by hardware or a cast, and asking whether they are a variant is the fallible read of it.
    if !unchecked_enum_field(t, ty)
        repr(texpr_type(t)) match
            Integer(_, _, _) -> ()
            _ ->
                cx.fault(span, s"'${qualified_name(d.base)}' converts an integer, but the value has " +
                         s"type ${type_show(texpr_type(t))}" + enum_try_hint(texpr_type(t), ty))
                return Some(bad_expr(span))
    end if

    var targs: Buf[Type] = buf()

    targs.push(ty)

    val opt = reinstantiate(cx.an, library_key("Option"), targs)

    opt match
        Enum(od) ->
            val some = od.variant("Some")
            val none = od.variant("None")

            if some.is_none() || none.is_none() then return Some(bad_expr(span))

            Some(TExpr(span, TEnumTry(t, ty, opt, some.unwrap(), none.unwrap())))
        _ -> Some(bad_expr(span))
end enum_try

// A value of the enum's own type handed to `try` is one already held to its variants -- except a
// bitfield's enum field, which is the one `try` takes -- so the refusal says which that is.
private enum_try_hint(found: Type, en: Type) -> string
    if repr(found) != repr(en) then return ""

    " — a value of the enum is already one of its variants; only an enum field of a '@packed' " +
        "bitfield struct, whose bits nothing has checked, is taken as it is"
end enum_try_hint

// Everything about a weak reference is behind `get()`, including whether there still is one.
private weak_get(cx: &Analyzer, span: Span, receiver: TExpr, inner: Type, name: string,
                 args: Buf[Expr]) -> TExpr
    if name != "get" then
        return cx.err(span, s"a weak ${type_show(inner)} has no method '$name' — a weak reference " +
                      "may be gone, so 'get()' is the only thing to ask one, and what it hands " +
                      "back is what has methods")

    if !args.is_empty() then cx.fault(span, "'get' takes no arguments")

    val key = library_key("Option")
    var targs: Buf[Type] = buf()

    targs.push(Ref(inner, false))

    val opt = reinstantiate(cx.an, key, targs)

    opt match
        Enum(d) ->
            val some = d.variant("Some")
            val none = d.variant("None")

            if some.is_none() || none.is_none() then return bad_expr(span)

            TExpr(span, TUpgrade(receiver, opt, some.unwrap(), none.unwrap()))
        _ -> bad_expr(span)
end weak_get

// -- the members the compiler supplies -----------------------------------------------------------------

// A member the compiler provides for a built-in, called: the bit surface, the magnitude and the
// sign, and a hash.
//
// **The operation is on the VALUE, so a receiver reached through a `*T` or a `&T` is read first** --
// `rty` is already the pointee, and `p.add(2)` over a `*int` handing the pointer itself to the `+`
// is a body no lowering accepts, which surfaces only as the link's missing `_main`.
private builtin_method(cx: &Analyzer, span: Span, written: TExpr, rty: Type,
                       name: string, args: Buf[Expr]) -> Option[TExpr]
    val receiver = auto_deref(cx, written)
    val operator = builtin_operator_method(cx, span, receiver, rty, name, args)

    if operator.is_some() then return operator

    val encoded = plain_encode_call(cx, span, receiver, rty, name, args)

    if encoded.is_some() then return encoded

    val numeric = core_numeric(name)

    if numeric.is_none() then return None
    if !core_builtin(numeric.unwrap(), rty) then return None

    val found = catalog_key(cx.an, numeric.unwrap())

    if found.is_none() then return None

    val tr_name = found.unwrap()

    // **A provided membership is reached as a library `impl`'s member is**: the trait named here, or
    // failing that visible here, since the compiler's membership is an impl every program can see.
    // Answering nothing leaves the call to the ordinary "has no method" refusal.
    if !names_trait(cx, tr_name) && !reachable_key(cx.an, tr_name, cx.scope) then return None

    val d = trait_decl_at(cx.an, tr_name)

    if d.is_none() then return None

    val m = trait_method(d.unwrap(), name)

    if m.is_none() then return None

    // The signature is the **trait's**, read with `Self` standing for the receiver: `count_ones`
    // answers a `u32` at every width and `abs` answers the type it was asked of, and both of those
    // are written in the declaration rather than known here. So the arguments bind as any member's
    // do, a name the trait gave its parameter included.
    val scope = trait_scope_of(cx.an, tr_name)
    val subst = self_binding(rty)
    val decl = m.unwrap()
    val slots = bind_member_args(cx, span, s"method '${module_bare(tr_name)}.$name'", decl, args)

    if slots.is_none() then return Some(bad_expr(span))

    var amount: Option[TExpr] = None

    if !decl.params.is_empty() && slots.unwrap().at(0).is_some()
        val want = resolve_type(cx.an, scope, decl.params.at(0).typ, subst)

        val given = type_expr(cx, slots.unwrap().at(0).unwrap(), Some(want))
        val got = texpr_type(given)

        // **A `Checked` operand is the receiver's own type**, as an operator's is: the lowering is one
        // instruction at one width, with nothing to bring a second width to it. A rotation's count
        // is any integer, which its lowering converts, so it is not held to this.
        if numeric.unwrap() == "Checked" && got != Unknown && disagree(got, want) then
            return Some(cx.err(slots.unwrap().at(0).unwrap().span,
                               s"'${decl.params.at(0).name}' of method '${module_bare(tr_name)}.$name' " +
                               s"is ${type_show(want)}, but ${type_show(got)} was given"))

        amount = Some(given)
    end if

    val ret =
        if decl.ret_type.is_some() then resolve_result(cx.an, scope, decl.ret_type.unwrap(), subst)
        else Unit

    Some(TExpr(span, TIntOp(name, receiver, amount, op_subject(rty), ret)))
end builtin_method

// `5.mul(2)`, `x.eq(y)`, `n.neg()` -- the ONE METHOD an operator's trait requires, written out on a
// built-in whose membership the compiler provides rather than a library `impl`.
//
// **It lowers to the operator and nothing else**, which is the promise a provided membership makes:
// a membership changes what a type *has*, never what a call *costs*. It is also what a monomorphized
// `[T: Add]` body lands on the moment `T` turns out to be a scalar, so the spelling has to reach the
// machine operation or a generic body would pay for a call the operator form does not.
//
// A built-in's membership is homogeneous (`reference/expressions.md § Operator dispatch`), so the
// trait's own parameter is the receiver's own type: `5.add(3)` is the `Add[int]` an `int` has, and it
// has no other.
private builtin_operator_method(cx: &Analyzer, span: Span, receiver: TExpr, rty: Type,
                                name: string, args: Buf[Expr]) -> Option[TExpr]
    val declaring = core_declaring(name)

    if declaring.is_none() then return None
    if !core_builtin(declaring.unwrap(), rty) then return None

    val required = core_required(declaring.unwrap())

    if required.is_none() then return None

    val op = required.unwrap().1
    val kind = required.unwrap().2
    val wanted: usize = kind match
        Prefix -> 0
        _ -> 1

    if args.len() != wanted
        cx.fault(span, s"method '${declaring.unwrap()}.$name' takes " +
                 s"${quantity(wanted, "argument")}, but " +
                 s"${supplied_phrase(args.len(), "argument")}")
        return Some(bad_expr(span))
    end if

    if kind == Prefix then return Some(produced(TExpr(span, TUnary(op, receiver, unary_type(rty)))))

    val rhs = type_expr(cx, args.at(0), Some(rty))

    // The call is checked against the trait's signature, whose argument is `Self` — so on this
    // receiver an argument of any other type is the wrong thing to hand it, named as the trait
    // names its parameter.
    if disagree(texpr_type(rhs), rty)
        cx.fault(args.at(0).span, s"'${operator_param_name(cx, declaring.unwrap(), name)}' of " +
                 s"'${declaring.unwrap()}.$name' is ${type_show(rty)}, but " +
                 s"${type_show(texpr_type(rhs))} was given")
        return Some(bad_expr(span))
    end if

    if kind == Compare
        var ts: Buf[TExpr] = buf()
        var cmps: Buf[TCmp] = buf()

        ts.push(receiver)
        ts.push(rhs)
        cmps.push(TCmp(op, None, 0))
        return Some(TExpr(span, TCompare(ts, cmps)))
    end if

    val ty = arith_type(cx, span, op, rty, texpr_type(rhs), args.at(0).span)

    if ty == Unknown then return Some(bad_expr(span))

    Some(produced(TExpr(span, TBinary(op, receiver, rhs, ty))))
end builtin_operator_method

// What the catalog trait calls its method's one parameter (`rhs` throughout the standard module),
// read off the declaration rather than assumed.
private operator_param_name(cx: &Analyzer, trait_name: string, method: string) -> string
    val found = catalog_key(cx.an, trait_name)

    if found.is_none() then return "rhs"

    val d = trait_decl_at(cx.an, found.unwrap())

    if d.is_none() then return "rhs"

    val m = trait_method(d.unwrap(), method)

    if m.is_none() || m.unwrap().params.is_empty() then return "rhs"

    m.unwrap().params.at(0).name
end operator_param_name

// The trait a compiler-provided receiverless member is declared by, as a diagnostic spells it —
// `Zero` and `One` for the identities, `Bits` for a width.
private provider_of(name: string) -> string
    val constant = core_constant(name)

    if constant.is_some() then return constant.unwrap().0

    core_measure_trait(name).unwrap_or(name)
end provider_of

// A receiverless member the compiler provides, read through a type rather than off a value: the two
// identities, whose value is stated in the catalog, and a width, whose answer is read off the type.
private builtin_constant_read(cx: &Analyzer, span: Span, rty: Type, name: string) -> Option[TExpr]
    val constant = core_constant(name)

    if constant.is_some()
        if !core_builtin(constant.unwrap().0, rty) then return None

        return Some(TExpr(span, TIntLit(from_int(long(constant.unwrap().1)), rty)))
    end if

    val measured = core_measure_trait(name)

    if measured.is_none() then return None
    if !core_builtin(measured.unwrap(), rty) then return None

    val answer = core_measure(name, rty)

    if answer.is_none() then return None

    val found = catalog_key(cx.an, measured.unwrap())

    if found.is_none() then return None

    val tr_name = found.unwrap()
    val d = trait_decl_at(cx.an, tr_name)

    if d.is_none() then return None

    val m = trait_method(d.unwrap(), name)

    if m.is_none() || m.unwrap().ret_type.is_none() then return None

    val ret = resolve_result(cx.an, trait_scope_of(cx.an, tr_name), m.unwrap().ret_type.unwrap(),
                           self_binding(rty))

    Some(TExpr(span, TIntLit(from_int(long(answer.unwrap())), ret)))
end builtin_constant_read

// -- a field holding something callable ------------------------------------------------------------

// `b.on_click(7)` -- a **field** holding a callable, called through the selection that reads it.
//
// A field is only reached this way where no method of that name exists, so a type never loses a
// method to a field: the two share a spelling and the method wins, which is the order every other
// lookup already takes. It is what makes a `struct Button` with an `on_click: &Fn(int) -> unit` a
// usable shape rather than one whose field has to be read into a local before it can be called.
callable_field(cx: &Analyzer, span: Span, rty: Type, name: string, recv: TExpr, args: Buf[Expr],
               expected: Option[Type]) -> Option[TExpr]
    val d = rty match
        Struct(decl) -> Some(decl)
        _ -> None

    if d.is_none() then return None

    val idx = d.unwrap().field_index(name)

    if idx < 0 then return None

    val fty = unqualified(d.unwrap().fields.at(usize(idx)).1)
    val is_cfn = fty match
        CFn(_, _) -> true
        _ -> false

    if !is_cfn && callable_of(cx.an, fty).is_none() then return None

    if !layout_known(cx.an, cx.scope, span, d.unwrap().base, qualified_name(d.unwrap().base)) then
        return Some(bad_expr(span))

    if !field_visible(cx, d.unwrap().base, name) then
        return Some(cx.err(span, field_out_of_reach(cx, d.unwrap().base, name)))

    val field = TExpr(span, TField(auto_deref(cx, recv), idx, fty))

    // A field holding C's function pointer is called through in the same position and by the same
    // spelling; what differs is only that there is no receiver to hand over.
    if is_cfn then
        val params = fty match
            CFn(ps, _) -> ps
            _ -> buf()
        val ret = fty match
            CFn(_, r) -> *r
            _ -> Unit

        var ts: Buf[TExpr] = buf()

        for i in 0..<args.len()
            val want = if i < params.len() then Some(params.at(i)) else None

            ts.push(type_expr(cx, args.at(i), want))

        return Some(TExpr(span, TCallPtr(field, ts, params, ret)))
    end if

    Some(call_member(cx, span, field, "call", args, expected))
end callable_field

// **A parameter's default is read in the DECLARATION's terms and not in the caller's**, which is
// what makes it mean the same thing from every module that calls the member. A free function's
// default already went through its own `f.scope`; a member's went through the caller's, so a default
// naming anything the declaring file imported -- `kind: TextureType = TextureType.Plain` on a
// binding's own canvas -- read as an undefined name in every consumer that left the argument out.
//
// `decl_scope` is where the member was written, which for an inherited default is the trait's source
// rather than the block that took it: that is where its body came from and where the rest of its
// signature was read.
//
// **An instantiation is filed under a name no file wrote**, so a member of `Atomic[u64]` is asked
// about under the declaration it was made from: its default `ord: Ordering = SeqCst` names a variant
// the declaring module has in scope and a caller need not.
private member_default_scope(cx: &Analyzer, name: string) -> Scope
    val written = cx.an.tables.members.decl_scope.get(name)

    if written.is_some() then return written.unwrap()

    cx.an.tables.members.func_origin.get(name) match
        Some(origin) -> cx.an.tables.members.decl_scope.get(origin).unwrap_or(cx.scope)
        None -> cx.scope
end member_default_scope
