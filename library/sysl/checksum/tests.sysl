module sysl.checksum
@tests

// What `sysl.checksum` claims. The check value 0xcbf43926 is the one every CRC catalogue publishes
// for CRC-32/ISO-HDLC over "123456789". A wrong initial value or a missing final xor gives a
// different number, so the vector can fail.

@test("crc32 gives the catalogue check value")
crc32_check_value()
    assert_eq(crc32("123456789".bytes), 0xcbf43926)

@test("crc32 of nothing is zero, of one byte is the known value")
crc32_edges()
    assert_eq(crc32("".bytes), 0)
    assert_eq(crc32("a".bytes), 0xe8b7be43)
    assert_eq(crc32("The quick brown fox jumps over the lazy dog".bytes), 0x414fa339)

@test("an incremental crc32 equals the one-shot at every split")
crc32_incremental()
    val s = "123456789".bytes

    for k in 0..s.len
        var c = new_crc32()

        c.update(s[0..<k])
        c.update(s[k..])
        assert_eq(c.finish(), 0xcbf43926)

    var c = new_crc32()

    for i in 0..<s.len
        c.update(s[i..<i + 1])

    assert_eq(c.finish(), 0xcbf43926)
