module sh.sysl.compiler
@tests

import sh.sysl.parsing.source_of
import sysl.text.Search

// The reference's `DiagnosticTests` § "a node's anchor and its extent are separate": its nodes carry
// two positions, an ANCHOR a diagnostic is rendered against (a call at its callee, a field selection at
// its member) and an extent, and `emit-ast` prints the anchor. This tree computes the anchor
// (`anchor.sysl`) and `emit-ast` prints it, so each of these asserts what the reference's `emit-ast`
// prints for the node.

private azd_an_node(text: string, line_start: string) -> string
    val tree = emit_ast(parse(source_of("t.sysl", text)).program, true)

    val all = lines_of(tree)

    for item in all
        if item.contains(line_start) then return item

    ""
end azd_an_node

@test("a call still points a diagnostic at its callee")
azd_an_call_at_its_callee()
    assert(azd_an_node("var x = 1\nprint(alpha)\n", "expr: Call").ends_with("expr: Call 2:1-2:6"))

@test("a field selection points at the member and covers the receiver too")
azd_an_field_at_its_member()
    assert(azd_an_node("var p = 1\nprint(p.missing)\n", "- Field").ends_with("- Field 2:9-2:16"))

@test("a node with no extent of its own falls back to where it points")
azd_an_no_extent_falls_back()
    assert(azd_an_node("x\n", "expr: Ident").ends_with("expr: Ident 1:1-1:2"))
