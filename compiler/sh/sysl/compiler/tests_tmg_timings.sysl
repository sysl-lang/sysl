module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.env.get
import sysl.fs.{make_temp_dir, remove_dir_all, write_text}
import sysl.process.{capture, Var}
import sysl.text.{parse_int, split, Search}
import sysl.time.monotonic

// `SYSL_TIMINGS=1` as somebody sets it: a built compiler run with it says each phase of a build, in
// order, on standard error -- and run without it says none. The compiler is the stage-2 binary the
// gate names in `SYSL_STAGE2`, since the switch is read once per process and a test cannot set it
// for its own.

private tmg_compiler() -> Option[string] = get("SYSL_STAGE2")

// The phases a `sysl build` of a program says, in the order it said them, with what else it printed.
private tmg_phases(binary: string, timed: bool) -> (Buf[string], string)
    val dir = make_temp_dir("sysl-tmg").unwrap()

    write_text(s"$dir/main.sysl", "main()\n    print(\"hi\")\n").unwrap()

    var env: Buf[Var] = buf()

    // A replayed build compiles nothing, so it would have no phases to say.
    env.push(Var("SYSL_NO_CACHE", "1"))

    if timed then env.push(Var("SYSL_TIMINGS", "1"))

    val said = capture(binary, ["build", s"$dir/main.sysl", "-o", s"$dir/main"], "", env.view(), true)

    remove_dir_all(dir).unwrap_or(())

    val out = said.unwrap()
    val text = out.text + out.err.unwrap_or("")
    var phases: Buf[string] = buf()

    for line in split(text, "\n")
        // The name is everything between the prefix and the last word, the milliseconds: a name may
        // be more than one word ("parse std").
        if line.starts_with("sysl: phase ")
            val words = split(line, " ")
            var name = ""

            for i in 2..<words.len - 1
                name = if name == "" then words[i] else name + " " + words[i]

            phases.push(name)

    (phases, text)
end tmg_phases

@test("SYSL_TIMINGS=1 says every phase of a build, in order, each with its milliseconds")
tmg_a_build_says_its_phases()
    val binary = tmg_compiler() match
        None ->
            print("skipped: SYSL_STAGE2 names no compiler binary")
            return
        Some(b) -> b

    val (phases, text) = tmg_phases(binary, true)
    var named = ""

    for p in phases
        named = named + p + ","

    assert_eq(named, "parse std,parse program,declarations,bodies,checks,prune,std,codegen,link,", text)

    for line in split(text, "\n")
        if line.starts_with("sysl: phase ") then assert(line.ends_with("ms"), line)

    // The checks' own lines are not phases, so they never reach the list above.
    assert(text.contains("sysl:   check keeps "), text)

// The milliseconds a report line ends with.
private tmg_ms(line: string) -> int
    val words = split(line, " ")

    val last = words[words.len - 1]

    parse_int(last[0..<last.len - 2]).unwrap_or(-1)
end tmg_ms

@test("the whole-program checks are said one by one under the checks phase, and the phases add up")
tmg_checks_are_their_own_lines()
    val binary = tmg_compiler() match
        None ->
            print("skipped: SYSL_STAGE2 names no compiler binary")
            return
        Some(b) -> b

    val begun = monotonic().us
    val (_, text) = tmg_phases(binary, true)
    val wall = (monotonic().us - begun) / 1000

    var phase_sum = 0
    var check_sum = 0
    var checks_line = -1
    var checks_at = -1
    var prune_at = -1
    var seen_keeps = false
    var seen_crossing = false
    var seen_escapes = false
    var at = 0

    for line in split(text, "\n")
        if line.starts_with("sysl: phase ")
            val ms = tmg_ms(line)

            assert(ms >= 0, line)
            phase_sum += ms

            if line.starts_with("sysl: phase checks ")
                checks_line = ms
                checks_at = at
            else if line.starts_with("sysl: phase prune ")
                prune_at = at
        else if line.starts_with("sysl:   check ")
            val ms = tmg_ms(line)

            assert(ms >= 0, line)
            check_sum += ms
            seen_keeps = seen_keeps || line.starts_with("sysl:   check keeps ")
            seen_crossing = seen_crossing || line.starts_with("sysl:   check crossing ")
            seen_escapes = seen_escapes || line.starts_with("sysl:   check escapes ")

            // Under the checks phase: after its line and before the next phase's.
            assert(checks_at >= 0 && prune_at < 0, line)

        at += 1

    assert(seen_keeps && seen_crossing && seen_escapes, text)

    // Each check is part of the phase's time, which is never less than the checks it holds (a
    // millisecond of rounding per line).
    assert(check_sum <= checks_line + 30, text)

    // The phases tile the compilation from the start of its clock to the end of the link, so their
    // sum is never more than the whole run and, a build being mostly compilation, close to it.
    assert(phase_sum <= wall + 5, text)
    assert(phase_sum * 2 >= wall, text)

@test("without SYSL_TIMINGS a build says no phase")
tmg_unasked_says_nothing()
    val binary = tmg_compiler() match
        None ->
            print("skipped: SYSL_STAGE2 names no compiler binary")
            return
        Some(b) -> b

    val (phases, text) = tmg_phases(binary, false)

    assert(phases.is_empty(), text)
