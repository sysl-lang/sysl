module sysl.process.hosted
@requires(posix)

import sysl.process.sys.{Text, ended_exited, ended_signalled, ended_timed_out, id_group,
                         id_real_group, id_real_user, id_user}
import sysl.sys.host_status

// `sysl.process.sys`'s hooks answered over a POSIX host -- `posix_spawn`, or `fork` and `exec` where
// the C library is too old for a child's directory to be given to `posix_spawn`. **Call
// `sysl.process` instead** -- nothing here is meant to be called: each function below exists to be
// linked under a hook's symbol. Each is public although an `@export` may be `private`: a private
// export's symbol is hidden, which keeps a Mach-O artifact to one codegen unit, and the standard
// module's artifact is the one every build pays that cost in.
//
// **Nothing imports this module, and nothing has to.** A hook a program reaches is answered by the
// library's own supplier (`reference/ffi.md § A module may supply another module's extern`), and its
// exports are `weak`, so a program answering a hook itself is the one the link keeps. It requires
// `posix`, so a target without POSIX never takes it, and the bodies exist only on a hosted target: a
// freestanding one has no C library to answer with, so there the program answers the hooks it reaches,
// and one it leaves unanswered is refused by name when it is compiled.
//
// **What only C can answer is answered by `spawn.c` beside this file**: decoding a wait status, the
// window between `fork` and `exec`, `posix_spawn`'s file actions, the `PATH` search, and a pipe whose
// ends close when a program is started (`fcntl` is variadic, and its flags are macros). Each of its
// functions answers zero or an `errno`, and the hook here negates it.

#if hosted
// `errno` is a function on every platform this builds for, spelled per C library; see
// `sysl.fs.hosted`, which reads it the same way.
#if bsd
private extern "__error" errno_location() -> *i32
#elif android
private extern "__errno" errno_location() -> *i32
#else
private extern "__errno_location" errno_location() -> *i32
#endif

private extern "sysl_proc_posix_start" c_start(program: *u8, program_len: usize, argv: *Text,
                                               argc: usize, envp: *Text, envc: usize, inherit: int,
                                               dir: *u8, dir_len: usize, in_fd: int, out_fd: int,
                                               err_fd: int, pid: *i32, started_ms: *i64,
                                               pgid: i32, foreground: int) -> int

private extern "sysl_proc_posix_wait" c_wait(pid: i32, started_ms: i64, timeout_ms: i64,
                                             code: *i32, sig: *i32, timed_out: *i32) -> int

private extern "sysl_proc_posix_temp_path" c_temp_path(into: *u8, n: usize) -> int

private extern "kill" c_kill(pid: i32, sig: int) -> int

private extern "strlen" c_strlen(s: *u8) -> usize

@export("sysl_proc_spawn")
proc_spawn(path: *u8, path_len: usize, argv: *Text, argc: usize, envp: *Text, envc: usize,
           inherit_env: int, dir: *u8, dir_len: usize, stdin_fd: int, stdout_fd: int, stderr_fd: int,
           started: *i64, pgid: i64, foreground: int) -> i64
    var pid: i32 = 0
    val e = c_start(path, path_len, argv, argc, envp, envc, inherit_env, dir, dir_len, stdin_fd,
                    stdout_fd, stderr_fd, &pid, started, i32(pgid), foreground)

    if e != 0 then i64(host_status(int(e))) else i64(pid)
end proc_spawn

@export("sysl_proc_wait")
proc_wait(pid: i64, started: i64, timeout_ms: i64, how: *int, value: *int) -> int
    var code: i32 = 0
    var sig: i32 = 0
    var expired: i32 = 0
    val e = c_wait(i32(pid), started, timeout_ms, &code, &sig, &expired)

    if e != 0 then return host_status(int(e))

    // Asked before the other two, because a child stopped for running too long ended by a signal and
    // would otherwise be reported as one.
    if expired != 0
        how[0] = ended_timed_out
        value[0] = 0
    elif sig != 0
        how[0] = ended_signalled
        value[0] = int(sig)
    else
        how[0] = ended_exited
        value[0] = int(code)
    end if

    0
end proc_wait

@export("sysl_proc_kill")
proc_kill(pid: i64, signal: int) -> int
    if c_kill(i32(pid), signal) == 0 then return 0

    val code = errno_location()[0]

    if code > 0 then host_status(code) else -5
end proc_kill

private extern "sysl_proc_posix_pipe" c_pipe(read_end: *int, write_end: *int) -> int

@export("sysl_proc_pipe")
proc_pipe(read_end: *int, write_end: *int) -> int
    val e = c_pipe(read_end, write_end)

    if e != 0 then host_status(e) else 0

@export("sysl_proc_temp_path")
proc_temp_path(into: *u8, room: usize) -> isize
    val e = c_temp_path(into, room)

    if e != 0 then isize(host_status(int(e))) else isize(c_strlen(into))

// `uid_t` and `gid_t` are 32 bits unsigned on every C library this builds for, and the four reading
// calls cannot fail: POSIX gives them no error at all.
private extern "geteuid" c_geteuid() -> u32
private extern "getegid" c_getegid() -> u32
private extern "getuid" c_getuid() -> u32
private extern "getgid" c_getgid() -> u32
private extern "setuid" c_setuid(id: u32) -> int
private extern "setgid" c_setgid(id: u32) -> int

// `EINVAL`, for a `which` that names no id: the same number on every POSIX host.
private const invalid: int = -22

@export("sysl_proc_get_id")
proc_get_id(which: int) -> i64
    if which == id_user then return i64(c_geteuid())
    if which == id_group then return i64(c_getegid())
    if which == id_real_user then return i64(c_getuid())
    if which == id_real_group then return i64(c_getgid())

    i64(invalid)
end proc_get_id

// `setuid` rather than `seteuid`: for user 0 it sets all three of the real, effective and saved ids,
// which is what giving a privilege up for good needs, and for anyone else it moves only the effective
// one between the ids the program already has -- exactly what `set_user` promises.
@export("sysl_proc_set_id")
proc_set_id(which: int, id: u32) -> int
    if which != id_user && which != id_group then return invalid

    val rc = if which == id_user then c_setuid(id) else c_setgid(id)

    if rc == 0 then 0 else host_status(errno_location()[0])
end proc_set_id

// `getpgrp` cannot fail. The two terminal calls are C's because the controlling terminal is opened by
// name and `SIGTTOU` is held back around the change with a signal set, whose type is the C library's.
private extern "getpgrp" c_getpgrp() -> i32
private extern "sysl_proc_posix_tcgetpgrp" c_tcgetpgrp(pgid: *i32) -> int
private extern "sysl_proc_posix_tcsetpgrp" c_tcsetpgrp(pgid: i32) -> int

@export("sysl_proc_getpgrp")
proc_getpgrp() -> i64 = i64(c_getpgrp())

@export("sysl_proc_tcgetpgrp")
proc_tcgetpgrp() -> i64
    var pgid: i32 = 0
    val e = c_tcgetpgrp(&pgid)

    if e != 0 then i64(host_status(e)) else i64(pgid)

@export("sysl_proc_tcsetpgrp")
proc_tcsetpgrp(pgid: i64) -> int
    val e = c_tcsetpgrp(i32(pgid))

    if e != 0 then host_status(e) else 0
#endif
