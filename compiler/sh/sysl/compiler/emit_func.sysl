module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.math.bigint.from_int

// **One whole function**: the frame its parameters are copied into, the body, and the return.
//
// A function owns its parameters and returns its result with a count already taken, so a caller can
// hand over a temporary and a callee can store one without either having to know what the other did
// with it. That bookkeeping is the ownership runtime's, and a function whose signature or body needs
// any of it is left out of the module rather than emitted without it.

// The function, or nothing where its body reached a form this compiler does not lower yet.
gen_function(e: *Emit, f: TFunc) -> Option[IrFunc]
    start_function(e)
    nowrap_begin(e, f)
    push_temps(e)
    push_owned(e)

    // An async function is a coroutine: its caller receives a task, and the body runs when the task
    // is driven (`emit_async.sysl`). The frame is made before the parameters are copied into it.
    val is_async = f.marks.is_async()

    if is_async then begin_coroutine(e, f)

    // A clause naming a `@ghost` function is a proof obligation and not something to lay down: the
    // callee will not be there.
    for item in f.ensures
        if !ghostly(e, item.cond) then e.ensures.push(item)

    e.self_name = f.name
    e.src = f.src

    // What a site of the error return trace names, and which `Err(...)` constructors are this body's
    // results and so the origins it records (`error_trace.sysl`).
    trace_function(e, f)

    for item in f.params
        e.self_params.push(item)

    e.self_variant = f.variant

    // What this body lets the address of out, which is what a call it makes could change under it.
    var none: Buf[TVal] = buf()

    e.caller_exposed = exposed_in(f.body.stmts, f.body.result, none)
    begin_moves(e, f.body.stmts, f.body.result)

    // The local every `return` hands back, where it can be built in the caller's result storage.
    e.return_slot = return_plan(e, f)

    // Which parameters this function keeps a count of its own for, and which it reads through the
    // one its caller is holding for the length of the call (`borrowing.sysl`). The slot is written
    // either way, because the body addresses it like any other local.
    //
    // **A task keeps every parameter**: its body runs after the call has returned, so nothing its
    // caller holds for the length of the call is held for long enough.
    val found = tail_calls_of(f)
    val owns = owning(f, e.address_taken.has(f.name), is_async || !found.is_empty(),
                      e.inert.has(f.name))

    // A zero-sized parameter is not an argument: there is nothing to receive and nothing to keep, so
    // it takes no slot and the emitted signature does not mention it.
    //
    // **A parameter the function owns arrives with its count** (`owned_params.sysl`): its slot gives
    // that count back like any local's, and nothing is taken for it here.
    for j in 0..<f.params.len()
        val p = f.params.at(j)

        if !zero_sized(p.1)
            val ty = p.1
            val handed = e.owned_params.has(owned_key(f.name, j))
            val owned = owns.has(p.0) || handed

            if underlying(ty) == VaList
                receive_walk(e, p.0)
                continue

            // A large one nothing but reading reaches is read where it arrived (`reads_in_place`):
            // the slot *is* the caller's storage, and only a name for it is made here. A task's
            // never is, the caller's storage being gone by the time the body reads it.
            if !is_async && e.in_place.has(f.name + "\n" + p.0)
                var idx: Buf[IrArg] = buf()

                idx.push(ir_arg(l_i32(), VInt(from_int(0))))
                emit(e, InGep(VReg(s"${p.0}.addr"), LInt(8), VReg(s"${p.0}.param"), idx))

                if owned then retain_at(e, ty, VReg(s"${p.0}.addr"))
                if owned then own_slot(e, p.0, ty)

                continue

            alloca(e, VReg(s"${p.0}.addr"), lty(e, ty))

            // A large one arrived as an address, so the copy the callee makes for itself is a copy
            // of bytes and the count it takes is taken at the slot rather than off a value it never
            // had.
            if e.layout.indirect(ty)
                emit_memcpy(e, VReg(s"${p.0}.addr"), VReg(s"${p.0}.param"), int(e.layout.size(ty)),
                            int(e.layout.claim(ty)))

                if owned then retain_at(e, ty, VReg(s"${p.0}.addr"))
            else
                emit(e, InStore(lty(e, ty), VReg(s"${p.0}.param"), VReg(s"${p.0}.addr"), AccPlain,
                                None))

                if owned && !handed then retain_value(e, ty, VReg(s"${p.0}.param"))

            if owned then own_slot(e, p.0, ty)

    // Where the function calls itself as the last thing it does, that call is a jump to here rather
    // than a second frame. The target sits *after* the parameter slots are written and *before*
    // everything below, so a jump arrives where a fresh call would: the arguments are in the slots
    // the body reads, and the preconditions that follow belong to the invocation rather than to the
    // frame, so they are taken again.
    //
    // The slots themselves are the entry block's and are not re-entered, which is what makes the
    // jump free: every one of them is hoisted, so going round again reuses the frame instead of
    // growing it.

    if !found.is_empty()
        val l = fresh_label(e, "tailrec")

        for item in f.params
            e.tail_params.push(item)

        for item in found
            e.tail_calls.push(item)

        e.tail_target = l
        emit_term(e, InBr(l))
        emit_label(e, l)

    for item in f.requires
        if !ghostly(e, item.cond) then
            emit_contract(e, item.cond, "require")

    // A member is handed a receiver that passed its struct's clauses, and says so to the optimizer.
    assume_receiver_invariant(e, f)

    // Each `old(e)` snapshots the entry value into a hidden owned slot, exactly as a `var` would, so
    // a postcondition can compare the returned state against the state on entry. The slot is
    // released with every other local at each return.
    for i in 0..<f.olds.len()
        push_temps(e)

        val old = f.olds.at(i)
        val oty = texpr_type(old)
        val v = gen_expr(e, old)

        alloca(e, VReg(s"old.$i.addr"), lty(e, oty))
        retain_value(e, oty, v)
        emit(e, InStore(lty(e, oty), v, VReg(s"old.$i.addr"), AccPlain, None))
        own_slot(e, s"old.$i", oty)
        pop_temps(e)

    // A task is made suspended: everything above ran at the call, and the body runs when the task is
    // first resumed.
    if is_async then initial_suspend(e)

    val lasts = last_uses_of(e, f.body.stmts, f.body.result)

    gen_stmts_with(e, f.body.stmts, lasts.0, lasts.2)
    e.moves.last_uses = lasts.1
    e.moves.dying = if f.body.result.is_some() then dying_for(f.body.result.unwrap(), lasts.3) else set()

    // A `never` result is `void` like `unit`: the body's trailing expression diverges, so it has
    // already terminated the block and the `ret` emitted here is dropped.
    if is_async
        coro_result(e, f)
    else
        f.body.result match
            Some(r) ->
                // A last expression that handles a failure is completed here, as a statement is
                // (`error_trace.sysl`).
                val mark = trace_enter_tail(e, r, f.ret_ty)

                if e.layout.indirect(f.ret_ty) then gen_indirect_return(e, r, mark)
                else if !no_value(f.ret_ty)
                    val v = gen_expr(e, r)

                    trace_leave(e, mark)
                    retain_moving(e, r, f.ret_ty, v)
                    emit_ensures(e, Some(v))
                    release_all_as(e, exit_returning(e, Some(r), v, f.ret_ty))
                    emit_term(e, InRet(Some(lty(e, f.ret_ty)), Some(v)))
                else
                    gen_expr(e, r)
                    trace_leave(e, mark)
                    emit_ensures(e, None)
                    release_all(e)
                    emit_term(e, InRet(None, None))
            None ->
                if no_value(f.ret_ty)
                    emit_ensures(e, None)
                    release_all(e)
                    emit_term(e, InRet(None, None))
                else if e.layout.indirect(f.ret_ty)
                    emit(e, InStore(lty(e, f.ret_ty), VZero, sret_param(), AccPlain, None))
                    release_all(e)
                    emit_term(e, InRet(None, None))
                else
                    release_all(e)
                    emit_term(e, InRet(Some(lty(e, f.ret_ty)), Some(zero_of(e, f.ret_ty))))

    if has_gap(e) then return None

    // A file-private declaration has every caller in the module that defines it, so its symbol is
    // `internal`: nothing outside may resolve it, and the linker is free to discard it when nothing
    // inside calls it either.
    //
    // A variadic export is published under its exported symbol by the definition itself
    // (`codegen.sysl`'s `record_symbols`), so it takes the linkage and visibility a thunk would have.
    val entry = f.variadic && f.exported.is_some()
    val linkage = if entry then export_linkage(f) else if f.internal then LinkInternal else LinkDefault

    // LLVM's coroutine passes split a function only where it says it is one.
    var bare = bare_attributes(f.marks)

    if is_async then bare.push("presplitcoroutine")

    // What a call of one hands back is its task.
    val sig_result = defined_result(f)

    Some(finish_func(e, IrFuncSig(symbol_of(e, f.name),
                                  sysl_fn_type(e, sig_result, f.params, f.variadic, Some(f)),
                                  linkage, convention_of(e, f), attribute_of(e, f), f.section,
                                  bare, binds_locally(e), entry && f.export_hidden)))
end gen_function

// **A `va_list` parameter is received as C receives one**, so the body walks on from wherever its
// caller -- sysl or C -- had reached. The slot the body reads as `ap` is the walk's storage: where the
// target passes the value in the storage (Darwin arm64, every `char *` target), a fresh slot holding
// it; where it passes an address -- of the caller's own storage on x86-64 System V, of a copy the
// caller made on AAPCS64 -- that address, used where it arrived. The caller's walk is then advanced
// or not depending on the machine, which is C's own rule: after the call it may only be ended.
private receive_walk(e: *Emit, name: string)
    e.target.va_list match
        VaLoaded ->
            alloca(e, VReg(s"$name.addr"), lty(e, VaList))
            emit(e, InStore(LPtr, VReg(s"$name.param"), VReg(s"$name.addr"), AccPlain, None))
        _ ->
            var idx: Buf[IrArg] = buf()

            idx.push(ir_arg(l_i32(), VInt(from_int(0))))
            emit(e, InGep(VReg(s"$name.addr"), LInt(8), VReg(s"$name.param"), idx))
end receive_walk

// An async body's last expression, put in its task, and the blocks every coroutine ends with.
private coro_result(e: *Emit, f: TFunc)
    val result = e.coro.unwrap().result

    f.body.result match
        Some(r) ->
            val mark = trace_enter_tail(e, r, result)

            if e.layout.indirect(result) then gen_indirect_return(e, r, mark)
            else if !no_value(result)
                val v = gen_expr(e, r)

                trace_leave(e, mark)
                retain_value(e, result, v)
                emit_ensures(e, Some(v))

                e.exit = exit_returning(e, Some(r), v, result)
                coro_deliver(e, v)
                e.exit = Leaving
            else
                gen_expr(e, r)
                trace_leave(e, mark)
                emit_ensures(e, None)
                coro_deliver(e, VNothing)
        None ->
            emit_ensures(e, None)
            coro_deliver(e, VNothing)

    finish_coroutine(e)
end coro_result

// The **enum** function attributes a definition carries, which LLVM writes as bare keywords
// (`reference/attributes.md § @noinline, @inline and @cold`). One fixed order -- the inlining mark,
// then `cold` -- so a definition carrying two reads the same whichever order they were written
// above it. `noinline` and `inlinehint` never appear together; the pair is refused where written.
// `@inline(always)` is `alwaysinline` in the hint's place, never beside it.
bare_attributes(m: FuncMarks) -> Buf[string]
    var out: Buf[string] = buf()

    if m.noinline then out.push("noinline")

    if m.inline_always
        out.push("alwaysinline")
    else if m.inline
        out.push("inlinehint")
    if m.cold then out.push("cold")

    out
end bare_attributes

// What a calling convention becomes on the `define` line for **this** machine. LLVM spells the one
// concept two ways: x86-64's interrupt handler is a *calling convention* written before the result
// type, and RISC-V's is a *function attribute* written after the signature.
private convention_of(e: *Emit, f: TFunc) -> Option[string]
    if f.conv.is_none() then return None
    if e.target.cpu == X86_64 then return Some("x86_intrcc")

    None
end convention_of

private attribute_of(e: *Emit, f: TFunc) -> Buf[(string, string)]
    var out: Buf[(string, string)] = buf()

    f.conv match
        Some(c) ->
            if e.target.cpu == Riscv64 || e.target.cpu == Riscv32
                val mode = c.arg match
                    Some(m) -> m
                    None -> "machine"

                out.push(("interrupt", mode))
        None -> ()

    out
end attribute_of

// A result too large for registers, written where the caller said rather than handed back. The
// out-pointer *is* the destination, so what would have been the returned value is built where it is
// going.
//
// A postcondition still gets the value it is written about. Reading it back out of the storage is a
// whole-aggregate load of the kind this lowering exists to avoid -- but only on a function that
// *has* an `ensures`, and only once at each of its returns, which is a price a contract already
// announces it is willing to pay.
gen_indirect_return(e: *Emit, r: TExpr, mark: Option[Val] = None)
    // A local already built inside the result is left where it is, and the rest of the result is
    // written around it (`return_slot.sysl`).
    val around = e.return_slot match
        Some(plan) -> path_of(r, plan.name) match
            Some(_) -> Some(plan.name)
            None -> None
        None -> None

    // An async body builds it in its task's promise instead.
    val dest = if e.coro.is_some() then coro_result_dest(e) else sret_param()

    around match
        Some(name) -> gen_around(e, dest, r, name)
        None -> gen_into(e, dest, r)

    trace_leave(e, mark)

    if !e.ensures.is_empty()
        val v = fresh_reg(e)

        emit(e, InLoad(v, lty_of(e, r), dest, AccPlain, None))
        emit_ensures(e, Some(v))
    else emit_ensures(e, None)

    // An `errdefer` waiting asks the value's tag, and its binder the failure's payload, both read
    // back out of the storage -- a load only a function with one pays for.
    var exit = Leaving

    if errdefer_pending(e)
        val v = fresh_reg(e)

        emit(e, InLoad(v, lty_of(e, r), dest, AccPlain, None))
        exit = exit_returning(e, Some(r), v, texpr_type(r))
    end if

    if e.coro.is_some()
        e.exit = exit
        coro_deliver(e, VNothing)
        e.exit = Leaving
        return
    end if

    release_all_as(e, exit)
    emit_term(e, InRet(None, None))
end gen_indirect_return
