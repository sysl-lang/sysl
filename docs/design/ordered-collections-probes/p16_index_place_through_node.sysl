// What p15 could not say through `-> ref`, said through `IndexPlace`: `t[k] += 1`, the address of a
// value inside a node the search finds, answered as a `*int`. The tree is a handle over a counted
// core (as `Map` is), so `index_place` takes `self`.

struct Leaf
    keys: []string
    vals: []int
    len: usize

struct Tree
    root: &Leaf

    @relocates
    put(self, k: string, v: int)
        val l = self.root

        slot_place(l.keys, l.len, k)
        slot_place(l.vals, l.len, v)
        l.len += 1
end Tree

impl IndexPlace[string, int] for Tree
    index_place(self, k: string) -> *int
        val l = self.root

        for i in 0..<l.len
            if l.keys[i] == k then return &l.vals[i]

        panic("no such key")
    end index_place

val t = Tree(Leaf(slot_storage(4), slot_storage(4), 0))

t.put("a", 1)
t.put("b", 2)
t["b"] += 40
t["a"] *= 7
print(t["a"], t["b"])
