module sh.sysl.compiler

import sysl.env.{get as env_var}

// **Whether a string may hold its bytes in the value itself** (`docs/design/short-strings.md`,
// option A). The form is on unless `SYSL_SHORT_STRINGS=0` turns it off, which is the diagnostic
// switch: a build with it off emits every string byte for byte as before the form existed.
//
// A short string is the three words of every string, laid out as
//
// ```
// [ 0 (null owner) | bytes 0 .. 2W-2 | top byte 0x80|n ]
// ```
//
// so its length `n` (1 to `2W - 1`) and its tag sit in the top byte of the length word, whose top bit
// no long string can set. The owner word is null, so every count of it is the no-op a literal's is.
// The empty string is never short. With the switch off no string is short and every emitted byte is
// what it was before the form existed.

// Set by a test that builds in-process, where setting the environment would reach every other test:
// the form it asked for, on or off, until `unforce_short_strings` hands the choice back.
private var short_strings_forced: Option[bool] = None

force_short_strings(on: bool)
    short_strings_forced = Some(on)

unforce_short_strings()
    short_strings_forced = None

private var short_strings_read: bool = false
private var short_strings_env: bool = true

// Whether this build makes and reads the short form: on, unless a test forced it or
// `SYSL_SHORT_STRINGS=0` turned it off.
short_strings_on() -> bool
    short_strings_forced match
        Some(on) -> return on
        None -> ()

    if !short_strings_read
        short_strings_env = short_strings_asked(env_var("SYSL_SHORT_STRINGS"))
        short_strings_read = true
    end if

    short_strings_env
end short_strings_on

// What a value of `SYSL_SHORT_STRINGS` asks for: the form, unless the value is `0`.
short_strings_asked(value: Option[string]) -> bool = value.unwrap_or("") != "0"

// What the switch adds to an artifact's key: nothing when it is off, so every key made before the
// form existed is unchanged.
short_strings_key() -> string = if short_strings_on() then "-ss" else ""

// **Whether a string is known, where it is written, to hold its bytes somewhere other than in
// itself**: a literal (the interned constant), a cut of such a string (a substring of a long string is
// a view of it), and `str_view` (a string over bytes it was handed). Such a string's `.bytes` is its own
// three words and never a copy (`docs/design/short-strings.md § 5.4`).
string_known_long(x: TExpr) -> bool = *x.kind match
    TStrLit(_) -> true
    TStrView(_) -> true

    // The library's spelling of `str_alias` (`sysl.text.str_view`), whose body is that form.
    TCall(name, _, _, _) -> name == "sysl.text$str_view"
    TStr(arg) -> underlying(texpr_type(arg)) == Str && string_known_long(arg)
    TSlice(base, _, _, _, _) -> underlying(texpr_type(base)) == Str && string_known_long(base)
    _ -> false

// **Whether `.bytes` of `receiver`, in a member marked `@views(self)`, is read at the receiver's own
// place** (`reference/memory.md § A view borrowed from its receiver`): the receiver is the member's
// `*self`, a string the caller holds at an address, so its bytes -- in the value or not -- already
// have one, and the view is made over that storage with no slot and no copy. The mark's rules keep it
// sound: the caller calls through a name, the view never outlives that name, and the name is not
// written while the view is held. `views` is whether the body is such a member.
bytes_at_receiver(views: bool, receiver: TExpr) -> bool
    if !views then return false

    *receiver.kind match
        TDeref(inner, _) -> *inner.kind match
            TLoad(name, ty) -> name == "self" && underlying(texpr_type(receiver)) == Str &&
                               pointee(ty).is_some()
            _ -> false
        _ -> false
end bytes_at_receiver

// The most bytes a short string holds on a machine of `word_bits`: every byte of the two words after
// the owner but the tag's.
short_string_capacity(word_bits: int) -> int = 2 * word_bits / 8 - 1
