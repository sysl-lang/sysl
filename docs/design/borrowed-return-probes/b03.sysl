// `quad(&self)`: the receiver is no longer copied, but the answer is still a `Kids` value, built
// in the callee's result slot — four references copied out, each with its count.
struct Node
    level: int
    kids: Option[Kids]

    quad(&self) -> Kids = self.kids.unwrap()

struct Kids
    nw: &Node
    ne: &Node
    sw: &Node
    se: &Node

leaf() -> &Node = Node(0, None)

walk(n: &Node) -> int
    if n.level == 0 then return 1

    val q = n.quad()

    walk(q.nw) + walk(q.ne) + walk(q.sw) + walk(q.se)

val l = leaf()
val top: &Node = Node(1, Some(Kids(l, l, l, l)))

print(walk(top))
