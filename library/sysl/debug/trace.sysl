module sysl.debug

import sysl.sys.{trace_clear, trace_len, trace_site}

/** The error return trace: where a failure was made, and each `?` that handed it one frame further
 * up on its way to the code that reported it.
 *
 * **Every `?` that takes its failure arm records its own site**, after any `From` conversion, and so
 * does each `Err(...)` a function hands back as its result -- written as the body's value, in a
 * `return`, or as an arm of an `if` or a `match` in either place. A site is `file:line:col in
 * function`, a constant the compiler lays down beside the code, so a trace prints the same at every
 * optimization level and on a board with nothing to symbolize against. A `?` on an `Option` records
 * nothing: `None` is absence rather than failure.
 *
 * **A failure that is handled leaves the trace**: a statement that calls something answering a
 * `Result` and does not hand that answer on with `?` or `return` puts the trace back as it found it
 * when it completes. So a `match` that deals with one error does not leave its frames in front of the
 * next one's.
 *
 * **One trace per thread**, of thirty-two sites and a count, allocated nowhere: the first thirty-two
 * are kept, since the origin end is where the bug is, and the rest are counted. A task records into
 * the trace of the thread running it. On a freestanding target there is one trace for the program
 * until a kernel gives each of its tasks an `ErrorTraceStore` and switches them with
 * `use_error_trace`.
 *
 * `main` returning an `Err` prints the trace under its `error:` line, and so do `unwrap` and `expect`
 * of an `Err` and a `@test` that returns one. A build with `error_traces = false` in its manifest, or
 * `--no-error-traces`, records nothing and reports nothing, and every function here answers as though
 * no failure had happened.
 */

/** How many sites a trace keeps. */
const ErrorTraceSites: usize = 32

/** One site of a trace: where a failure was made or handed on, and the function it was in. A closure
 * is named after the function it was written in.
 */
struct ErrorSite
    file: string
    line: int
    col: int
    function: string

/** A copy of the current thread's trace, origin first. It holds the sites by address -- they are
 * constants -- so taking one allocates nothing, and reading a site makes its strings.
 */
struct ErrorTrace
    count: usize
    sites: [32]*u8

    /** How many sites the trace kept. */
    len(self) -> usize = if self.count < ErrorTraceSites then self.count else ErrorTraceSites

    /** How many it recorded past the ones it kept. */
    dropped(self) -> usize = self.count - self.len()

    /** Whether nothing was recorded. */
    is_empty(self) -> bool = self.count == 0

    /** The `i`th site, the origin being `0`. */
    at(self, i: usize) -> ErrorSite = site_of(self.sites[i])
end ErrorTrace

/** `for site in trace` visits each kept site in turn, origin first. */
impl Walk for ErrorTrace
    type Walker = ErrorTraceWalk

    walk(self) -> ErrorTraceWalk = ErrorTraceWalk(self, 0)

/** The cursor `for site in trace` walks. */
struct ErrorTraceWalk
    trace: ErrorTrace
    at: usize

impl Iterate for ErrorTraceWalk
    type Item = ErrorSite

    next(*self) -> Option[ErrorSite]
        if self.at >= self.trace.len() then return None

        self.at += 1
        Some(self.trace.at(self.at - 1))

/** The current thread's trace, as it stands. */
error_trace() -> ErrorTrace
    val count = usize(trace_len())
    var sites: [32]*u8

    for i in 0..<count
        if i == ErrorTraceSites then break

        sites[i] = trace_site(u32(i))

    ErrorTrace(count, sites)
end error_trace

/** Writes the current thread's trace to `w` in the form `main` reports it in, or nothing where it is
 * empty.
 */
print_error_trace(w: *Writer)
    val t = error_trace()

    if t.is_empty() then return

    w.write("error return trace (origin first):\n".bytes)

    for i in 0..<t.len()
        val p = t.sites[i]

        w.write("  ".bytes)
        w.write(p[0..<text_len(p)])
        w.write("\n".bytes)

    if t.dropped() > 0 then w.write(s"  … and ${t.dropped()} more\n".bytes)
end print_error_trace

/** Empties the current thread's trace -- what a loop that logs each failure it handles does before
 * the next.
 */
clear_error_trace() = trace_clear()

/** Storage for one error return trace, of a size known while compiling, so a kernel can keep one in
 * each task's control block and make it current on a context switch with `use_error_trace`. What is
 * in it is reached only through the trace functions while it is current.
 */
struct ErrorTraceStore
    private count: u32
    private sites: [32]*u8

    /** A store holding no trace. */
    new() -> ErrorTraceStore = ErrorTraceStore(0, [null; 32])

    /** Empties the store. Done to a store before it is made current, never to the current one. */
    init(*self) = trace_init(self)
end ErrorTraceStore

/** Makes `s` the trace that every failure records into and every read of the trace reads -- `null`
 * for the program's own (the thread's own, on a hosted target) -- and answers the one that was
 * current, which is never `null`. On a freestanding target it points `sysl_error_trace_current` at
 * `s`; on a hosted one, where the trace is the thread's own object, it copies the live trace out and
 * `s` in. With traces off it does nothing and answers `null`.
 */
use_error_trace(s: *ErrorTraceStore) -> *ErrorTraceStore = trace_use(s)

private extern "sysl_error_trace_init" trace_init(s: *ErrorTraceStore)
private extern "sysl_error_trace_use" trace_use(s: *ErrorTraceStore) -> *ErrorTraceStore

// The length of a site's text, which is NUL-terminated.
private text_len(p: *u8) -> usize
    var n: usize = 0

    while p[n] != 0
        n += 1

    n
end text_len

// A site's text, `file:line:col in function`, taken apart. The function name is everything after the
// last ` in `, and the line and column are the last two `:`-separated numbers before it.
private site_of(p: *u8) -> ErrorSite
    val n = text_len(p)
    var cut = n

    while cut >= 4 && !(p[cut - 4] == u8(' ') && p[cut - 3] == u8('i') && p[cut - 2] == u8('n') &&
                        p[cut - 1] == u8(' '))
        cut -= 1

    val head = if cut >= 4 then cut - 4 else n
    val function = if cut >= 4 then str_cast(p[cut..<n]) else ""

    var c2 = head

    while c2 > 0 && p[c2 - 1] != u8(':')
        c2 -= 1

    var c1 = if c2 > 0 then c2 - 1 else 0

    while c1 > 0 && p[c1 - 1] != u8(':')
        c1 -= 1

    if c1 == 0 then return ErrorSite(str_cast(p[0..<head]), 0, 0, function)

    ErrorSite(str_cast(p[0..<c1 - 1]), number(p, c1, c2 - 1), number(p, c2, head), function)
end site_of

private number(p: *u8, from: usize, to: usize) -> int
    var n = 0

    for i in from..<to
        n = n * 10 + int(p[i] - u8('0'))

    n
end number
