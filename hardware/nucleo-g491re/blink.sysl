// Blink LD2 on a NUCLEO-G491RE, which is PA5.
//
// Nothing here needs a clock tree: the part comes out of reset on HSI16, and a GPIO only wants its
// bus clock enabled and its mode set. The delay is a counting loop with a volatile read in it, so
// that the optimizer has a side effect it may not remove -- an empty counting loop is fair game.

struct Reg
    v: volatile u32

val RCC_AHB2ENR: usize = 0x4002104C
val GPIOA_MODER: usize = 0x48000000
val GPIOA_ODR: usize = 0x48000014

val ahb2enr: *Reg = ptr_cast(RCC_AHB2ENR)
val moder: *Reg = ptr_cast(GPIOA_MODER)
val odr: *Reg = ptr_cast(GPIOA_ODR)

var sink: u32 = 0

ahb2enr.v = ahb2enr.v | 1

// PA5 resets to analog (0b11), so the two mode bits are cleared before the output bits go in.
moder.v = (moder.v & 0xFFFFF3FF) | 0x400

loop
    odr.v = odr.v ^ 0x20

    var i: u32 = 0

    while i < 300000
        sink = odr.v
        i += 1
