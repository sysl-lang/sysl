module sh.sysl.compiler

import sh.sysl.parsing.{Source, Span}
import sysl.buf.{Buf, buf}
import sysl.container.{Map, map, Set, set}
import sysl.slices.sort
import sysl.text.from_utf8_unchecked

// **A `&T` nothing keeps past its frame is laid in that frame** (`reference/memory.md § A box nothing
// keeps is laid in the frame`).
//
// A construction written where a `&T` is expected puts the object on the heap. Where the box provably
// never leaves the frame that builds it -- it is not stored anywhere but a local of that frame, not
// returned, not captured, not handed to a parameter that may keep it, not weakened, not given up as a
// raw count, not put behind a table or a callable that says nothing of what it keeps -- it is laid in
// a slot of the frame instead (`emit_box.sysl`'s `gen_frame_box`): the header and the payload a heap
// box has, counted exactly as a heap box is, with a hook that lets go of what the payload holds and
// runs its destructor and gives no storage back. Nothing can tell the two apart but the allocator.
//
// **Two kinds of site are followed.** A `TBox` the body writes, keyed by its payload's span, and a
// call of a **factory** -- a function every way out of which may answer one box it built and kept
// nowhere else, like `vector() -> &Vector[E] = Vector(slot_storage(0), 0, 0)` -- keyed by the call's
// span. A factory call laid in the frame reaches the factory's **frame entry** (`<symbol>-frame`),
// the same body taking one more parameter first: the caller's slot, which that one box is laid in. A
// body whose one site is a factory call it may answer, kept nowhere else, is a factory as well
// (`vector_with(x)` answering `vector_of_size(1)`'s box): its frame entry hands the slot on to that
// call's frame entry.
//
// **The question is a may-escape question, so every unknown answers "escapes".** A box is followed
// through the locals that may hold it (a fixed point), each value built around it, each answer that
// may be it. The one place a holder may be is a local of the frame, reached without a dereference;
// anything else -- a field through a pointer or a reference, module storage, a buffer's slot, another
// box -- is an escape. A call keeps what it is handed unless its body, walked the same way with the
// parameter as the thing followed, never lets the parameter out but by answering it (`summary`). A
// call through a table or a callable, in a program that sees every table, is a call of each body that
// slot may hold (`table_callees`), each asked the same way. A call with no body in sight (an `extern`,
// a function pointer, a table in a library or an archive), a task, and every node this walk does not
// know answer "escapes". Recursion is settled at a least fixed point (`SbOpen`): a recursive function
// keeps its parameter only where one of its paths does.
//
// **A loop builds into the same slot every turn**, so a box built in a loop's body may be held only by
// locals declared inside that loop's body, which are gone by the next turn.
//
// **A raw pointer into the payload is not followed**: it holds no count, so whatever reads through it
// after the box is gone reads freed storage on the heap exactly as it reads a dead slot here. What a
// raw pointer to a local HOLDING the box is followed, since it reaches the box.

// What the walk found for a whole program: per body, the payload spans of the boxes it lays in its
// frame and the spans of the factory calls it lays there; per factory, the payload span of the box
// its frame entry lays in the caller's slot; and every payload so laid, whose compact release
// (`emit_arc.sysl`'s `gen_compact_release`) has to know a frame box's count from a heap box's.
struct StackBoxes
    sites: Map[string, Buf[Span]]
    calls: Map[string, Buf[Span]]
    entries: Map[string, Span]
    payloads: Set[string]

    // Every `name|k` whose answer may be its parameter `k`, as the walk worked it out. A frame box
    // handed to a call reaches only parameters the walk asked about (the others answer "escapes"), so
    // a call none of whose parameters is here answers something that is not the box
    // (`frame_counts.sysl`).
    answering: Set[string]

    // The factories every way out of which answers the box laid in the caller's slot. Another's frame
    // entry may answer a box it put on the heap on some other way out, so its caller cannot count the
    // answer's shares itself (`frame_counts.sysl`).
    whole: Set[string]

    // What every body a table call may run does with an argument the walk followed into it, by
    // `node_id|k` (`k` 0 the receiver): whether one may let it out (`.0`) and whether one may answer it
    // (`.1`). Only a call whose bodies the program names all is here (`table_callees`), and only the
    // arguments some walk carried a box in; `frame_counts.sysl` counts a frame box handed to one of
    // these as it counts one lent to a direct call.
    table_args: Map[string, (bool, bool)]
end StackBoxes

no_stack_boxes() -> StackBoxes = StackBoxes(map(), map(), map(), set(), set(), set(), map())

// The largest payload laid in a frame. A frame box in a recursive body costs its payload in every
// frame of the recursion, so a big one stays on the heap.
private stack_box_limit() -> usize = 1024

// Every body's frame boxes, and the factories whose frame entries some caller reaches.
stack_boxes(e: *Emit, p: TProgram) -> StackBoxes
    var out = no_stack_boxes()
    val tables: Option[TraitTables] = if p.entry_point then Some(tables_by_trait(p.vtables)) else None
    val open: &SbOpen = SbOpen(map(), map(), map(), set(), buf(), buf(), set(), 0, false)
    val cx: &BoxCx = BoxCx(map(), p.funcs, map(), open, map(), set(), map(), set(), tables, map(), map(),
                           map())
    val noting = explaining_escapes()

    for i in 0..<p.funcs.len()
        cx.index.put(p.funcs[i].name, i)

    for item in e.destructors
        cx.dtors.add(item.0)

    // A payload whose own destructor may let the payload's address out is never laid in a frame: the
    // destructor runs as the last count goes, and what it kept would outlive the slot.
    for item in e.destructors
        cx.dtor_fns.put(item.0, item.1)

    for f in p.funcs
        if !factory_shaped(p, f) || drops_a_param(e, f) then continue

        for site in box_sites(f)
            if !site_payload_ok(e, cx, site.1) || mangle(site.1) != mangle(ref_inner(f.ret_ty)) then continue

            val w = follow_site(cx, f, site.0, false, true)

            if !w.escaped && w.answers
                cx.factories.put(f.name, site.0)

                if answers_only_site(f, site.0, false) then out.whole.add(f.name)

                break
            end if
        end for
    end for

    // **A factory of a factory is a factory**: a body that builds no box of its own but may answer the
    // box another factory's call answers it, and keeps that box nowhere else, has a frame entry too --
    // one that hands its own caller's slot on to that call's frame entry. Each round may make the
    // callers of the last round's factories factories in turn; a body is asked only once it is not one
    // yet, so recursion among bodies none of which builds a box of its own makes none of them one.
    var grew = true

    while grew
        grew = false

        for f in p.funcs
            if cx.factories.has(f.name) || !factory_shaped(p, f) || drops_a_param(e, f) then continue

            for site in factory_calls(cx, f)
                if mangle(ref_inner(site_ret(cx, site.1))) != mangle(ref_inner(f.ret_ty)) then continue

                val w = follow_site(cx, f, site.0, true, true)

                if !w.escaped && w.answers
                    cx.factories.put(f.name, site.0)
                    cx.chains.put(f.name, site.1)

                    if out.whole.has(site.1) && answers_only_site(f, site.0, true) then out.whole.add(f.name)

                    grew = true
                    break
                end if
            end for
        end for
    end while

    for f in p.funcs
        if !frame_shaped(f)
            if noting && !f.ghost
                for site in box_sites(f)
                    note_box(cx, f, site.0, box_subject(site.1), WhyFrameless(f.marks.is_async()))
            end if

            continue
        end if

        var good: Buf[Span] = buf()
        var bad: Buf[Span] = buf()
        var good_calls: Buf[Span] = buf()

        for site in box_sites(f)
            // The walk is asked only of a payload that may be laid at all: what it works out on the way
            // (summaries, table arguments) is shared, so the order of the questions is kept.
            val unfit = site_payload_why(e, cx, site.1)
            var why = unfit

            if unfit.is_none()
                val w = follow_site(cx, f, site.0, false, false)

                if w.escaped then why = Some(w.why.unwrap_or(WhyUnknown))
            end if

            val laid = why.is_none()

            if laid then good.push(site.0) else bad.push(site.0)
            if laid then out.payloads.add(mangle(site.1))

            // A factory's own box is laid in its caller's slot through the frame entry; each call says
            // where its box went.
            if noting && !laid && !is_factory_site(cx, f, site.0)
                note_box(cx, f, site.0, box_subject(site.1), why.unwrap())
        end for

        // A closure laid in the frame where its capture mode is decided is followed too, for what the
        // tables it is handed to and called through do with it (`table_args`): it is laid there
        // whatever this walk finds.
        for site in framed_closure_sites(e, f)
            follow_site(cx, f, site, false, false)

        for site in factory_calls(cx, f)
            val w = follow_site(cx, f, site.0, true, false)

            if w.escaped
                // A factory of a factory hands its own caller's slot on to this call, as a factory
                // lays its own box: each of its calls says where the box went.
                if noting && !is_factory_site(cx, f, site.0) then
                    note_box(cx, f, site.0, factory_subject(site.1), w.why.unwrap_or(WhyUnknown))

                continue
            end if

            good_calls.push(site.0)
            out.payloads.add(mangle(ref_inner(site_ret(cx, site.1))))

            // A factory of a factory's frame entry reaches the frame entry of the factory it calls.
            var name = Some(site.1)

            while name is Some(n) && !out.entries.has(n)
                out.entries.put(n, cx.factories.get(n).unwrap())
                name = cx.chains.get(n)
            end while
        end for

        // Two boxes written at one span are told apart by nothing the emitter sees: either both are
        // laid in the frame or neither is.
        var kept: Buf[Span] = buf()

        for s in good
            if !holds_span(bad, s) && !holds_span(kept, s) then kept.push(s)

        if !kept.is_empty() then out.sites.put(f.name, kept)
        if !good_calls.is_empty() then out.calls.put(f.name, good_calls)
    end for

    out.answering = cx.answering
    out.table_args = cx.table_args
    out
end stack_boxes

// Takes back every factory call whose factory cannot have a frame entry after all -- one with a
// parameter lent by address or read where it arrived, which the entry's convention does not take
// (`codegen.sysl` settles those after the boxes are laid out).
drop_unentered(e: *Emit, p: TProgram, sb: StackBoxes) -> StackBoxes
    var gone: Set[string] = set()
    var lent: Map[string, string] = map()

    for f in p.funcs
        if !sb.entries.has(f.name) then continue

        for j in 0..<f.params.len()
            if e.lent_params.has(owned_key(f.name, j)) || e.in_place.has(f.name + "\n" + f.params[j].0)
                gone.add(f.name)

                if !lent.has(f.name) then lent.put(f.name, f.params[j].0)
            end if
    end for

    if gone.is_empty() then return sb

    val noting = explaining_escapes()

    // A factory of a factory whose frame entry would reach one taken back is taken back with it.
    var through: Map[string, string] = map()
    var grew = true

    while grew
        grew = false

        for f in p.funcs
            if !sb.entries.has(f.name) || gone.has(f.name) then continue

            if called_at(f, sb.entries.get(f.name).unwrap(), gone)
                gone.add(f.name)
                grew = true

                if noting then through.put(f.name, called_name_at(f, sb.entries.get(f.name).unwrap()))
            end if
        end for
    end while

    var calls: Map[string, Buf[Span]] = map()

    for f in p.funcs
        sb.calls.get(f.name) match
            Some(spans) ->
                var left: Buf[Span] = buf()

                for s in spans
                    if !called_at(f, s, gone)
                        left.push(s)
                    else if noting
                        val name = called_name_at(f, s)

                        note_unentered(f, s, name, lent.get(name), through.get(name))
                    end if

                if !left.is_empty() then calls.put(f.name, left)
            None -> ()
    end for

    var entries: Map[string, Span] = map()

    for f in p.funcs
        if sb.entries.has(f.name) && !gone.has(f.name) then entries.put(f.name, sb.entries.get(f.name).unwrap())

    StackBoxes(sb.sites, calls, entries, sb.payloads, sb.answering, sb.whole, sb.table_args)
end drop_unentered

// Whether the call at `at` in `f` names one of `names`.
private called_at(f: TFunc, at: Span, names: Set[string]) -> bool
    val hit: &SbFlag = SbFlag(false)

    walk_block_stmts(f.body, expr_walk(true, x -> *x.kind match
        TCall(name, _, _, _) -> if x.span == at && names.has(name) then hit.yes = true
        _ -> ()))

    hit.yes
end called_at

// The name the call at `at` in `f` calls.
private called_name_at(f: TFunc, at: Span) -> string
    val hit: &SbName = SbName("")

    walk_block_stmts(f.body, expr_walk(true, x -> *x.kind match
        TCall(name, _, _, _) -> if x.span == at then hit.name = name
        _ -> ()))

    hit.name
end called_name_at

private struct SbFlag
    yes: bool

private struct SbName
    name: string

// Whether every way out of a factory answers its one site: the site is the body's value, and nothing
// in the body returns, becomes another call, or leaves through `?`. A `call_site` is a factory call
// keyed by its own span; any other, a box keyed by its payload's.
private answers_only_site(f: TFunc, site: Span, call_site: bool) -> bool
    val last = f.body.result

    if last.is_none() then return false

    val direct = *last.unwrap().kind match
        TBox(v, _) -> !call_site && v.span == site
        TCall(_, _, _, _) -> call_site && last.unwrap().span == site
        _ -> false

    if !direct then return false

    val left: &SbFlag = SbFlag(false)

    val on_expr: &Fn(TExpr) -> unit = x -> *x.kind match
        TTry(_, _, _, _, _, _, _) -> left.yes = true
        _ -> ()
    val on_stmt: &Fn(TStmt) -> unit = st -> st match
        TReturn(_) -> left.yes = true
        TBecome(_) -> left.yes = true
        _ -> ()

    walk_block_stmts(f.body, TWalk(true, on_expr, w -> (), on_stmt))

    !left.yes
end answers_only_site

// The frame entry of a factory: the symbol it is defined and called at, local to the module. No
// function's own symbol holds a `-` (`zero_entry.sysl`).
frame_symbol(e: *Emit, name: string) -> string = symbol_of(e, name) + "-frame"

// The name of the frame entry's first parameter: the caller's slot.
frame_slot_param() -> string = "frame$slot"

// -- which bodies and which payloads ---------------------------------------------------------------

// A body whose frame may hold a box: one that is its own frame for as long as it runs. A task's frame
// is laid out by the coroutine split, which keeps no slot across an `await`; a body that jumps back to
// its own entry or becomes another reuses the frame its slots are in.
private frame_shaped(f: TFunc) -> bool =
    !f.ghost && !f.marks.is_async() && tail_calls_of(f).is_empty()

// A body that may have a frame entry: one whose callers all reach it by a direct call the compiler
// writes, which the frame entry can then stand in for.
private factory_shaped(p: TProgram, f: TFunc) -> bool
    if !frame_shaped(f) || f.variadic || f.exported.is_some() || f.section.is_some() || f.conv.is_some() then
        return false
    if f.variant.is_some() || f.marks.track_caller || is_closure_body(f) then return false
    if !f.requires.is_empty() || !f.ensures.is_empty() || !f.olds.is_empty() then return false
    if !f.internal && holds_string(p.precompiled, f.name) then return false

    for item in f.params
        if underlying(item.1) == VaList then return false

    underlying(f.ret_ty) match
        Ref(_, sync) -> !sync
        _ -> false
end factory_shaped

// A `@unique` value with a destructor is handed over or read where it lies; the frame entry, owning
// nothing, would do neither (`emit_unique.sysl`).
private drops_a_param(e: *Emit, f: TFunc) -> bool
    for item in f.params
        if value_drops(e, item.1) then return true

    false
end drops_a_param

// A payload that may be laid in a frame: small, and whose destructor, where it has one, keeps nothing
// of what it is handed.
private site_payload_ok(e: *Emit, cx: &BoxCx, inner: Type) -> bool = site_payload_why(e, cx, inner).is_none()

// Why a payload may not be laid in a frame wherever it is built, or `None` where it may.
private site_payload_why(e: *Emit, cx: &BoxCx, inner: Type) -> Option[BoxWhy]
    val size = e.layout.size(inner)

    if size > stack_box_limit() then return Some(WhyTooBig(size))

    cx.dtor_fns.get(mangle(inner)) match
        Some(name) -> if summary(cx, name, 0, 1, None).0 then Some(WhyDestructor(inner, name)) else None
        None -> None
end site_payload_why

// The boxes a body writes, each with its payload's type, keyed by the payload's span. A `&sync` box
// may be held by another domain, and a closure literal's box is decided where its capture mode is
// (`closure_mode.sysl`).
private box_sites(f: TFunc) -> Buf[(Span, Type)]
    val out: &SbSites = SbSites(buf())

    walk_block_stmts(f.body, expr_walk(true, x -> *x.kind match
        TBox(v, ref_ty) -> underlying(ref_ty) match
            Ref(inner, sync) ->
                if !sync && !is_closure_literal(texpr_type(v)) then out.items.push((v.span, *inner))
            _ -> ()
        _ -> ()))

    out.items
end box_sites

private struct SbSites
    items: Buf[(Span, Type)]

// The closure boxes a body writes that `closure_mode.sysl` lays in the frame, keyed by the payload's
// span.
private framed_closure_sites(e: *Emit, f: TFunc) -> Buf[Span]
    val out: &SbSpans = SbSpans(buf())
    val framed = e.framed_closures

    if framed.is_empty() then return out.items

    walk_block_stmts(f.body, expr_walk(true, x -> *x.kind match
        TBox(v, _) -> *v.kind match
            TStructNew(st, _) -> if framed.has(st.base) then out.items.push(v.span)
            _ -> ()
        _ -> ()))

    out.items
end framed_closure_sites

private struct SbSpans
    items: Buf[Span]

// The calls of factories a body makes, each with the factory's name, keyed by the call's span.
private factory_calls(cx: &BoxCx, f: TFunc) -> Buf[(Span, string)]
    val out: &SbCalls = SbCalls(buf())

    walk_block_stmts(f.body, expr_walk(true, x -> *x.kind match
        TCall(name, _, _, _) -> if cx.factories.has(name) then out.items.push((x.span, name))
        _ -> ()))

    out.items
end factory_calls

private struct SbCalls
    items: Buf[(Span, string)]

private site_ret(cx: &BoxCx, name: string) -> Type = cx.funcs[cx.index.get(name).unwrap()].ret_ty

private holds_span(xs: Buf[Span], s: Span) -> bool
    for x in xs
        if x == s then return true

    false
end holds_span

// Whether a value of this type can hold a count or an address, and so a box: a number cannot.
// Whether a cast from `from` to `to` reads a value as another type: to a raw pointer of another
// type, or to something that holds no address (an integer).
private reinterprets(from: Type, to: Type) -> bool = underlying(to) match
    Ptr(_, _, _) -> mangle(underlying(from)) != mangle(underlying(to))
    _ -> !may_carry(to)

private may_carry(t: Type) -> bool = underlying(t) match
    Ref(_, _) -> true
    Weak(_) -> true
    Slice(_, _) -> true
    Str -> true
    Ptr(_, _, _) -> true
    Trait(_, _, _) -> true
    Abstract(_, _) -> true
    Unknown -> true
    Volatile(inner) -> may_carry(*inner)
    Array(_, elem, _) -> may_carry(*elem)
    Vector(_, elem, _) -> may_carry(*elem)
    Struct(d) ->
        if d.base == TaskBase then return true

        for item in d.fields
            if may_carry(item.1) then return true

        false
    Results(parts) ->
        for item in parts.fields
            if may_carry(item.1) then return true

        false
    Enum(d) ->
        for v in d.variants
            for field in v.fields
                if may_carry(field.1) then return true

        false
    _ -> false

private is_ref_type(t: Type) -> bool = underlying(t) match
    Ref(_, _) -> true
    _ -> false

private is_sync_ref(t: Type) -> bool = underlying(t) match
    Ref(_, sync) -> sync
    _ -> false

// -- the walk ----------------------------------------------------------------------------------------

// What the walks of one program share: the bodies by name, each parameter's answer once worked out
// (`summary`), the questions being worked out now (`SbOpen`), and the factories found.
private struct BoxCx
    index: Map[string, usize]
    funcs: Buf[TFunc]
    memo: Map[string, (bool, bool)]
    open: &SbOpen
    factories: Map[string, Span]
    dtors: Set[string]
    dtor_fns: Map[string, string]

    // Every `name|k` of `memo` whose answer may be the parameter.
    answering: Set[string]

    // A program's own tables by trait (`borrowing.sysl`'s `tables_by_trait`), where it sees every one
    // there is; `None` for a library or an archive, which may be handed an object whose table it never
    // saw.
    tables: Option[TraitTables]

    // `StackBoxes.table_args`, joined over every walk that reached the call: a "may" from any wins.
    table_args: Map[string, (bool, bool)]

    // Each factory of a factory, with the factory whose call its one site is.
    chains: Map[string, string]

    // Every `name|k` of `memo` whose parameter may get out, with the first way out its walk met: what
    // `--explain-escapes` says a callee does with what it is handed.
    whys: Map[string, BoxWhy]
end BoxCx

// One walk of one body, following one thing: a site of this body (`site`, a box's payload span or a
// factory call's span) or a parameter (`param`). `holders` is every local that may hold it; `homes`
// the loops each local is declared in, as `,1,4,`; `site_loop` the innermost loop the site is built
// in (-1 for none). `answers` is set where a way out may answer it, which is an escape only for a
// site that is not its factory's.
//
// **A closure's environment is a holder per capture** (`env`, `sb_slot_carries`). Each closure literal
// is one struct type built at one place, so a walk that sees every construction of it knows which of
// its slots may hold what is followed: `env` has the literal's base once one is seen, and `base#slot`
// for each slot an argument that may carry it was built into. A read of any other slot of that
// environment carries nothing. The record is only as good as the walk's sight of every such value:
// `exact` says no value that may carry what is followed came from anywhere the walk cannot see the
// making of (a call's answer, a store into a slot), and a parameter's walk inherits its caller's
// record (`summary`), since that caller built what it hands over. Where it is not exact, or the
// literal was never seen built, every slot may carry, as before.
private struct BoxWalk
    cx: &BoxCx
    site: Span
    call_site: bool
    param: bool
    factory: bool
    holders: Set[string]
    refs: Set[string]
    homes: Map[string, string]
    loops: Buf[int]
    next_loop: int
    site_loop: int
    escaped: bool
    answers: bool
    changed: bool
    exact: bool
    env: Set[string]

    // The first way out the walk met, set with `escaped` (`sb_escape`).
    why: Option[BoxWhy]

    hold(*self, name: string)
        if !self.holders.has(name)
            self.holders.add(name)
            self.changed = true
    end hold

    note_env(*self, entry: string)
        if !self.env.has(entry)
            self.env.add(entry)
            self.changed = true
    end note_env

    // A value that may carry what is followed came from where the walk cannot see it built.
    inexact(*self)
        if self.exact
            self.exact = false
            self.changed = true
    end inexact

    declare(*self, name: string)
        var text = ","

        for l in self.loops
            text = text + s"$l,"

        self.homes.put(name, text)
    end declare

    enter_loop(*self)
        self.loops.push(self.next_loop)
        self.next_loop += 1
    end enter_loop

    leave_loop(*self)
        _ = self.loops.pop()
    end leave_loop
end BoxWalk

// Follows a site of `f`, or (with `param` set to the parameter's name through `follow_param`) a
// parameter, to a fixed point over the locals that may hold it.
private follow_site(cx: &BoxCx, f: TFunc, site: Span, call_site: bool, factory: bool) -> &BoxWalk
    val w: &BoxWalk = BoxWalk(cx, site, call_site, false, factory, set(), set(), map(), buf(), 0, -1, false,
                              false, true, true, set(), None)

    run_walk(w, f)
    w
end follow_site

// `env` is the caller's record of the closure environments it built (`BoxWalk.env`), `None` where the
// caller's is not exact.
private follow_param(cx: &BoxCx, f: TFunc, j: usize, env: Option[Set[string]]) -> &BoxWalk
    var given: Set[string] = set()

    if env.is_some()
        for entry in env.unwrap()
            given.add(entry)
    end if

    val w: &BoxWalk = BoxWalk(cx, span_zero(), false, true, false, set(), set(), map(), buf(), 0, -1, false,
                              false, true, env.is_some(), given, None)

    w.holders.add(f.params[j].0)
    run_walk(w, f)
    w
end follow_param

private run_walk(w: &BoxWalk, f: TFunc)
    for item in f.params
        w.homes.put(item.0, ",")

    while w.changed && !w.escaped
        w.changed = false
        w.next_loop = 0
        w.loops.clear()

        if sb_block(w, f.body) then sb_returned(w, body_value_span(f))
    end while

    // A loop builds into one slot every turn: every holder has to be gone by the next.
    if !w.escaped && w.site_loop >= 0
        val mark = s",${w.site_loop},"

        for name in w.holders
            if !w.homes.get(name).unwrap_or("").contains(mark) then sb_escape(w, WhyOutlivesTurn(name))
    end if
end run_walk

// **Every escape says why** (`BoxWhy`): the first one a walk meets is the one `--explain-escapes`
// reports, so a rule that finds a new way out attaches its own reason here and nowhere else.
private sb_escape(w: &BoxWalk, why: BoxWhy)
    w.escaped = true

    if w.why.is_none() then w.why = Some(why)
end sb_escape

// Where a body's value is written: its last expression, or the declaration where it has none.
private body_value_span(f: TFunc) -> Span = f.body.result match
    Some(v) -> v.span
    None -> f.span

private sb_returned(w: &BoxWalk, at: Span) =
    if w.param || w.factory then w.answers = true else sb_escape(w, WhyReturned(at))

private sb_block(w: &BoxWalk, b: TBlock) -> bool
    for s in b.stmts
        sb_stmt(w, s)

    b.result.is_some() && sb_carry(w, b.result.unwrap())
end sb_block

private sb_opt_block(w: &BoxWalk, b: Option[TBlock]) -> bool = b.is_some() && sb_block(w, b.unwrap())

private sb_stmts(w: &BoxWalk, stmts: Buf[TStmt])
    for s in stmts
        sb_stmt(w, s)
end sb_stmts

private sb_stmt(w: &BoxWalk, s: TStmt) = s match
    TVarDecl(n, _, init, _) ->
        w.declare(n)

        if sb_carry(w, init) then w.hold(n)
    TExprStmt(x) -> sb_see(w, x)
    TInvariant(cond, _) -> sb_see(w, cond)
    TVariantCheck(_, _, x) -> sb_see(w, x)
    TRefDecl(n, _, place) ->
        w.declare(n)
        w.refs.add(n)

        if sb_carry(w, place) then w.hold(n)
    TWriteStmt(wr) -> sb_write(w, wr)
    TMultiAssign(writes) ->
        for wr in writes
            sb_write(w, wr)
    TReturn(v) -> if v.is_some() && sb_carry(w, v.unwrap()) then sb_returned(w, v.unwrap().span)
    TBecome(call) -> if sb_carry(w, call) then sb_returned(w, call.span)
    TBreak(v, _) -> if v.is_some() && sb_carry(w, v.unwrap()) then sb_escape(w, WhyBreak(v.unwrap().span))
    TContinue(_) -> ()
    TDefer(stmts, _) -> sb_stmts(w, stmts)
    TAsm(_, _, _, _) -> sb_escape(w, WhyAsm)

private sb_write(w: &BoxWalk, wr: TWrite)
    sb_see(w, wr.place)

    val c = sb_carry(w, wr.value)

    for item in wr.check
        sb_see(w, item.value)

    if c
        if wr.dispatch.is_some() then sb_escape(w, WhySetter(whole_place(wr.place))) else sb_store(w, wr.place)
end sb_write

// A value that may be what is followed, written into `place`: a local's own storage holds it, and
// anything else keeps it.
private sb_store(w: &BoxWalk, place: TExpr) = sb_root(w, place) match
    Some(n) ->
        // A slot of a closure's environment stored into after it was built holds what its
        // construction did not say.
        if in_closure_slot(place) then w.inexact()

        w.hold(n)
    None -> sb_escape(w, WhyStored(whole_place(place)))

// Whether a place steps through a field of a closure's environment.
private in_closure_slot(place: TExpr) -> bool = *place.kind match
    TField(r, _, _) -> is_closure_literal(underlying(texpr_type(r))) || in_closure_slot(r)
    TIndex(r, _, _) -> in_closure_slot(r)
    _ -> false

// Whether slot `slot` of a value of type `ty` may carry what is followed: any slot of anything but a
// closure's environment whose every construction the walk has seen (`BoxWalk.env`), and of that, a
// slot built from something that may carry it.
private sb_slot_carries(w: &BoxWalk, ty: Type, slot: int) -> bool = underlying(ty) match
    Struct(st) ->
        if !is_closure_literal(Struct(st)) || !w.exact || !w.env.has(st.base) then true
        else w.env.has(s"${st.base}#$slot")
    _ -> true

// The caller's record of closure environments a callee's walk inherits: `None` unless it is exact.
private sb_env(w: &BoxWalk) -> Option[Set[string]] = if w.exact then Some(w.env) else None

// The local a place is inside of by value: a chain of field and element steps, never through a
// pointer, a reference or a `ref`.
private sb_root(w: &BoxWalk, place: TExpr) -> Option[string] = *place.kind match
    TLoad(n, _) -> if w.refs.has(n) then None else Some(n)
    TField(r, _, _) -> underlying(texpr_type(r)) match
        Struct(_) -> sb_root(w, r)
        _ -> None
    TIndex(r, _, _) -> underlying(texpr_type(r)) match
        Array(_, _, _) -> sb_root(w, r)
        _ -> None
    _ -> None

// Every name a pattern binds holds what the subject may be.
private sb_bind(w: &BoxWalk, p: TPattern, holds: bool)
    var names: Buf[string] = buf()

    pattern_names(p, &names)

    for n in names
        w.declare(n)

        if holds then w.hold(n)
    end for
end sb_bind

private sb_terms(w: &BoxWalk, cond: Buf[TCondTerm])
    for term in cond
        term match
            TCondTest(c) -> sb_see(w, c)
            TCondIs(subject, patterns, _) ->
                val c = sb_carry(w, subject)

                for p in patterns
                    sb_bind(w, p, c)
    end for
end sb_terms

// Walks every value in `xs`, and whether any may be what is followed.
private sb_all(w: &BoxWalk, xs: Buf[TExpr]) -> bool
    var any = false

    for x in xs
        if sb_carry(w, x) then any = true

    any
end sb_all

// Whether the value of `x` may be, or hold, what is followed -- noting every escape inside it on the
// way. A value whose type holds no count and no address holds nothing.
private sb_carry(w: &BoxWalk, x: TExpr) -> bool = sb_kind(w, x) && may_carry(texpr_type(x))

private sb_is_site(w: &BoxWalk, x: TExpr, payload: TExpr) -> bool =
    !w.param && !w.call_site && payload.span == w.site

private sb_kind(w: &BoxWalk, x: TExpr) -> bool = *x.kind match
    TLoad(n, _) -> w.holders.has(n)
    TBox(v, _) ->
        val inside = sb_carry(w, v)

        if inside then sb_escape(w, WhyBoxed(v.span, is_closure_literal(texpr_type(v))))

        if sb_is_site(w, x, v)
            if w.site_loop < 0 && !w.loops.is_empty() then w.site_loop = w.loops[w.loops.len() - 1]

            return true
        end if

        false
    TCall(name, args, _, _) ->
        var answered = false

        for k in 0..<args.len()
            if sb_carry(w, args[k])
                val s = summary(w.cx, name, k, args.len(), sb_env(w))

                if s.0 then sb_escape(w, handed_why(w.cx, name, k, sb_env(w), args[k].span))
                if s.1 then answered = true
            end if
        end for

        if w.call_site && !w.param && x.span == w.site
            if w.site_loop < 0 && !w.loops.is_empty() then w.site_loop = w.loops[w.loops.len() - 1]

            return true
        end if

        if answered && may_carry(texpr_type(x)) then w.inexact()

        answered
    TStructNew(st, args) ->
        val closure = is_closure_literal(Struct(st))
        var c = false

        for i in 0..<args.len()
            if sb_carry(w, args[i])
                c = true

                if closure then w.note_env(s"${st.base}#${st.slot(i)}")
            end if
        end for

        if closure then w.note_env(st.base)
        if c && w.cx.dtors.has(mangle(Struct(st))) then sb_escape(w, WhyDropper(x.span, Struct(st)))

        c
    TEnumNew(ty, _, args) ->
        val c = sb_all(w, args)

        if c && w.cx.dtors.has(mangle(ty)) then sb_escape(w, WhyDropper(x.span, ty))

        c
    TArrayLit(elems, _) -> sb_all(w, elems)
    TArrayFill(v, _) -> sb_carry(w, v)
    TErase(v, _, _) -> sb_carry(w, v)
    // **A cast that reads the box as something else lets it out**: `ptr_cast(&pin)` to a `*usize`, then
    // a load, carries the box's address as a number nothing here follows (`sysl.buf`'s `view_shared`
    // hands its pin to the slice it answers that way). A cast to the same type changes nothing.
    TCast(v, ty) ->
        val c = sb_carry(w, v)

        if c && (is_sync_ref(ty) || reinterprets(texpr_type(v), ty)) then sb_escape(w, WhyCast(x.span, ty))

        c
    TConstView(v) -> sb_view(w, v)
    TViewAs(v, _) -> sb_view(w, v)
    TTempAddr(v, _) -> sb_carry(w, v)
    TSlice(base, lo, hi, _, _) ->
        if lo.is_some() then sb_see(w, lo.unwrap())
        if hi.is_some() then sb_see(w, hi.unwrap())

        sb_view(w, base)

    // A step into a reference's payload reads what the payload holds, which the box can be part of only
    // by a store this walk has already called an escape.
    TField(r, slot, _) -> sb_carry(w, r) && !is_ref_type(texpr_type(r)) && sb_slot_carries(w, texpr_type(r), slot)
    TIndex(r, i, _) ->
        sb_see(w, i)
        sb_carry(w, r) && !is_ref_type(texpr_type(r))
    TDeref(r, _) -> sb_carry(w, r) && !is_ref_type(texpr_type(r))
    TAddrOf(place, _) -> sb_carry(w, place)
    TLen(r, _) -> sb_read(w, r)
    TBytes(r) -> sb_read(w, r)
    TTypeId(r, _) -> sb_read(w, r)
    TBinary(_, l, r, _) -> sb_read(w, l) || sb_read(w, r)
    TUnary(_, o, _) -> sb_read(w, o)
    TLogical(_, l, r) -> sb_read(w, l) || sb_read(w, r)

    // A comparison reached through an implementation hands its operands to it, unless it reads them
    // through their references first.
    TCompare(operands, cmps) ->
        var handed = false

        for c in cmps
            if c.dispatch.is_some() && c.through == 0 then handed = true

        if sb_all(w, operands) && handed then sb_escape(w, WhyCompared(x.span))

        false
    TSeq(exprs) ->
        var last = false

        for item in exprs
            last = sb_carry(w, item)

        last
    TBlockExpr(b) -> sb_block(w, b)
    TIf(cond, tb, eb, _) ->
        sb_terms(w, cond)

        val a = sb_block(w, tb)
        val b = sb_opt_block(w, eb)

        a || b
    TMatch(scrutinee, arms, _) ->
        val c = sb_carry(w, scrutinee)
        var any = false

        for arm in arms
            for p in arm.patterns
                sb_bind(w, p, c)

            if arm.guard.is_some() then sb_see(w, arm.guard.unwrap())
            if sb_block(w, arm.body) then any = true
        end for

        any
    TWhile(cond, body, eb, _) ->
        w.enter_loop()
        sb_terms(w, cond)
        sb_stmts(w, body)
        w.leave_loop()
        sb_opt_block(w, eb)
    TDoWhile(body, cond, eb, _) ->
        w.enter_loop()
        sb_stmts(w, body)
        sb_see(w, cond)
        w.leave_loop()
        sb_opt_block(w, eb)
    TLoop(body, _) ->
        w.enter_loop()
        sb_stmts(w, body)
        w.leave_loop()
        false
    TFor(name, _, lo, hi, _, body, eb, _) ->
        sb_see(w, lo)
        sb_see(w, hi)
        w.enter_loop()
        w.declare(name)
        sb_stmts(w, body)
        w.leave_loop()
        sb_opt_block(w, eb)
    TCFor(init, cond, step, body, eb, _) ->
        sb_stmts(w, init)
        w.enter_loop()

        if cond.is_some() then sb_see(w, cond.unwrap())

        sb_stmts(w, step)
        sb_stmts(w, body)
        w.leave_loop()
        sb_opt_block(w, eb)
    TForEach(name, _, seq, body, eb, _) ->
        val c = sb_carry(w, seq)

        w.enter_loop()
        w.declare(name)

        if c then w.hold(name)

        sb_stmts(w, body)
        w.leave_loop()
        sb_opt_block(w, eb)
    TIterate(cursor, _, init, next, bind, body, eb, _) ->
        w.declare(cursor)

        if sb_carry(w, init) then w.hold(cursor)

        w.enter_loop()

        val c = sb_carry(w, next)

        sb_bind(w, bind, c)
        sb_stmts(w, body)
        w.leave_loop()
        sb_opt_block(w, eb)
    TStore(place, v, _, yields) ->
        sb_see(w, place)

        val c = sb_carry(w, v)

        if c then sb_store(w, place)

        c && yields
    TUpdate(place, _, v, _, _, _, _) ->
        sb_see(w, place)

        if sb_carry(w, v) then sb_escape(w, WhyUpdate(whole_place(place)))

        false
    TIncDec(place, _, _, _, _) -> sb_read(w, place)
    TUpgrade(v, _, _, _) -> sb_carry(w, v)
    TDowncast(v, _, _, _, _, _) -> sb_carry(w, v)
    TFromRaw(v, _) -> sb_carry(w, v)

    // **A call through a table, in a program that sees every table, is a call of what that slot holds
    // in each of them** (`table_callees`), the receiver its parameter 0 and the arguments the rest,
    // each judged as a direct call is. Elsewhere, or where the tables cannot be named, it is a call
    // with no body in sight.
    TVCall(r, slot, args, _, _) ->
        val callees = table_callees(w.cx, r, slot)

        if callees.is_none()
            for k in sb_kids(x)
                if sb_carry(w, k) then sb_escape(w, WhyNode(x))

            return false
        end if

        var answered = false
        val given = args.len() + 1

        for k in 0..<given
            val arg = if k == 0 then r else args[k - 1]

            if sb_carry(w, arg)
                val key = s"${node_id(x)}|$k"
                var seen = w.cx.table_args.get(key).unwrap_or((false, false))

                for name in callees.unwrap()
                    val s = summary(w.cx, name, k, given, sb_env(w))

                    if s.0 then sb_escape(w, handed_why(w.cx, name, k, sb_env(w), arg.span))
                    if s.1 then answered = true

                    seen = (seen.0 || s.0, seen.1 || s.1)
                end for

                w.cx.table_args.put(key, seen)
            end if
        end for

        if answered && may_carry(texpr_type(x)) then w.inexact()

        answered
    _ ->
        for k in sb_kids(x)
            if sb_carry(w, k) then sb_escape(w, WhyNode(x))

        false

// What every other node is made of. Each is a place the walk does not follow a value into, so a part
// that may be what is followed is an escape: a weakening, a raw count, a buffer, a slot, a table or a
// callable, a task, a rendering, a `?`.
private sb_kids(x: TExpr) -> Buf[TExpr]
    var out: Buf[TExpr] = buf()

    *x.kind match
        TDowngrade(v, _) -> out.push(v)
        TIntoRaw(v, _) -> out.push(v)
        TVectorLit(lanes, _) -> sb_push_all(&out,lanes)
        TSplat(v, _) -> out.push(v)
        TLanesAs(v, _) -> out.push(v)
        TLane(r, _, _) -> out.push(r)
        TVecCompare(_, l, r, _) ->
            out.push(l)
            out.push(r)
        TSelect(m, a, b, _) ->
            out.push(m)
            out.push(a)
            out.push(b)
        TShuffle(r, second, _, _) ->
            out.push(r)

            if second.is_some() then out.push(second.unwrap())
        TLaneSet(r, _, v, _) ->
            out.push(r)
            out.push(v)
        TReduce(_, r, _) -> out.push(r)
        TVecOp(_, operands, _) -> sb_push_all(&out,operands)
        TVecLoad(r, i, _) ->
            out.push(r)
            out.push(i)
        TVecStore(r, i, v) ->
            out.push(r)
            out.push(i)
            out.push(v)
        TBufLit(elems, _) -> sb_push_all(&out,elems)
        TBufFill(v, n, _) ->
            out.push(v)
            out.push(n)
        TFloorCast(v, _) -> out.push(v)
        TConstrainedCheck(v, _) -> out.push(v)
        TConstrainedValid(v, _) -> out.push(v)
        TConstrainedStep(v, _, _, _) -> out.push(v)
        TIntOp(_, v, amount, _, _) ->
            out.push(v)

            if amount.is_some() then out.push(amount.unwrap())
        TAtomic(_, addr, ops, _, _, _) ->
            out.push(addr)
            sb_push_all(&out,ops)
        TSlots(_, args, _, _) -> sb_push_all(&out,args)
        TSysOp(_, _, args) -> sb_push_all(&out,args)
        TVariantFailHeld(_, held) -> out.push(held)
        TStr(v) -> out.push(v)
        TFromBytes(v) -> out.push(v)
        TStrView(v) -> out.push(v)
        TCrossCopy(v, _, _, _) -> out.push(v)
        TFormat(v, _, counts) ->
            out.push(v)
            sb_push_all(&out,counts)
        TRender(v, _, spec, _) ->
            out.push(v)
            out.push(spec)
        TCallPtr(callee, args, _, _) ->
            out.push(callee)
            sb_push_all(&out,args)
        TVCall(r, _, args, _, _) ->
            out.push(r)
            sb_push_all(&out,args)
        TVaStart(ap) -> out.push(ap)
        TVaEnd(ap) -> out.push(ap)
        TVaArg(ap, _) -> out.push(ap)
        TVaCopy(d, s) ->
            out.push(d)
            out.push(s)
        TVaPass(ap) -> out.push(ap)
        TStructInvCheck(v, _, _) -> out.push(v)
        TRecheck(after, recv, _, _) ->
            out.push(after)
            out.push(recv)
        TEnumFromInt(v, _) -> out.push(v)
        TEnumTry(v, _, _, _, _) -> out.push(v)
        TDecode(b, _, _, _, _) -> out.push(b)
        TEncode(v, o) ->
            out.push(v)
            out.push(o)
        TEnumAttr(_, _, a, _) -> out.push(a)
        TTry(v, _, _, _, _, _, _) -> out.push(v)
        TAwait(v, _) -> out.push(v)
        TBlockOn(v, _) -> out.push(v)
        TStep(t, wake) ->
            out.push(t)
            out.push(wake)
        TPark(r) -> out.push(r)
        TQuantifier(_, _, _, lo, hi, _, pred) ->
            out.push(lo)
            out.push(hi)
            out.push(pred)
        TCheckedLoop(_, _, l) -> out.push(l)
        _ -> ()

    out
end sb_kids

private sb_push_all(out: *Buf[TExpr], xs: Buf[TExpr])
    for x in xs
        out.push(x)
end sb_push_all

// **A view of an array inside a box holds the box**: its owner word is the box, counted, so
// `g.rows[i][0..<2]` carries `g` however many steps through a reference it took to reach the array.
private sb_view(w: &BoxWalk, base: TExpr) -> bool
    val c = sb_carry(w, base)

    c || sb_view_root(w, base)
end sb_view

private sb_view_root(w: &BoxWalk, x: TExpr) -> bool = *x.kind match
    TField(r, _, _) -> sb_view_root(w, r)
    TIndex(r, _, _) -> sb_view_root(w, r)
    TDeref(r, _) -> sb_view_root(w, r)
    TLoad(n, _) -> w.holders.has(n)
    _ -> sb_carry(w, x)

// Walks a value that is only read, and answers `false`: nothing it is read into holds it.
private sb_read(w: &BoxWalk, x: TExpr) -> bool
    sb_see(w, x)
    false
end sb_read

// Walks a value for what it does, whatever it holds.
private sb_see(w: &BoxWalk, x: TExpr)
    _ = sb_carry(w, x)
end sb_see

// -- what a callee does with a parameter --------------------------------------------------------------

// The functions a call through slot `slot` of the object `recv` may run: what that slot holds in each
// table of the receiver's trait at its arguments (`trait_tables`, every table of the trait where none
// is spelled at them). `None` -- a call with no body in sight -- in a library or an archive, for a
// receiver whose trait cannot be named, a slot a table does not have, or a trait with no table at all.
private table_callees(cx: &BoxCx, recv: TExpr, slot: int) -> Option[Buf[string]]
    val tr = erased_trait(underlying(texpr_type(recv)))

    if cx.tables.is_none() || tr.is_none() || slot < 0 then return None

    var out: Buf[string] = buf()

    for vt in trait_tables(cx.tables.unwrap(), tr.unwrap())
        if usize(slot) >= vt.slots.len() then return None

        out.push(vt.slots[usize(slot)].target)
    end for

    if out.is_empty() then None else Some(out)
end table_callees

// The questions `summary` is working out now, settled over recursion as a least fixed point.
//
// A question asked again while it is still open -- a recursive function handing its parameter to
// itself, or to a function that hands it back -- is answered with its value so far (`values`; "keeps
// nothing" at first) and noted as `read`. The open questions are numbered in the order they were
// asked (`order`) and stacked (`stack`, Tarjan's), and each walk under way keeps the lowest number it
// read (`lows`). A walk that read no question older than its own is the first of its component: if
// a value some walk read has grown since (`changed`), every question of the component is walked
// again from the values reached so far; otherwise each value is the answer, and goes in the memo.
// Values only grow, two flags each, so the iteration ends; and the last round read every value as it
// ends, so each answer covers what its body does given the others'.
private struct SbOpen
    values: Map[string, (bool, bool)]
    order: Map[string, usize]

    // Each open question's `name|k`, the key `answering` is read by (`frame_counts.sysl`), whatever
    // environment record it was asked with.
    plain: Map[string, string]

    // The `name|k` of every question asked with an environment record whose body is being walked now.
    // The same parameter asked again under another record is asked with none, which reads every
    // closure as the walk did before records: a recursion that builds a new record at every turn
    // would otherwise ask a new question at every turn.
    walking: Set[string]
    stack: Buf[string]
    lows: Buf[usize]
    read: Set[string]
    next: usize
    changed: bool
end SbOpen

// What the function `name` does with its parameter `k`: whether it may let it out (`.0`), and whether
// its answer may be it or hold it (`.1`). Where no body is in sight, the arguments do not line up, or
// the body is a task's, the answer is "it escapes". A question asked again while it is being worked
// out is answered from `SbOpen`. `env` is the asking walk's record of the closure environments it
// built (`BoxWalk.env`), which the parameter's walk starts from; each record is its own question.
private summary(cx: &BoxCx, name: string, k: usize, given: usize, env: Option[Set[string]]) -> (bool, bool)
    val key = s"$name|$k" + env_key(env)

    cx.memo.get(key) match
        Some(known) -> return known
        None -> ()

    val open = cx.open

    open.order.get(key) match
        Some(n) ->
            val top = open.lows.len() - 1

            if n < open.lows[top] then open.lows[top] = n

            open.read.add(key)

            return open.values.get(key).unwrap_or((false, false))
        None -> ()

    val plain = s"$name|$k"

    if env.is_some() && open.walking.has(plain) then return summary(cx, name, k, given, None)

    val at = cx.index.get(name)

    if at.is_none() then return (true, true)

    val f = cx.funcs[at.unwrap()]

    if f.ghost || f.variadic || f.marks.is_async() || k >= f.params.len() || given != f.params.len() then
        return (true, true)

    val mine = open.next
    val outer_changed = open.changed

    open.next += 1
    open.order.put(key, mine)
    open.plain.put(key, plain)
    open.stack.push(key)
    open.lows.push(mine)

    loop
        open.changed = false
        if env.is_some() then open.walking.add(plain)

        val w = follow_param(cx, f, k, env)

        if env.is_some() then open.walking.remove(plain)
        val was = open.values.get(key).unwrap_or((false, false))
        val now = (was.0 || w.escaped, was.1 || w.answers)

        // The first round that lets the parameter out says why, and no later one replaces it: a value
        // only grows, and each reason names only questions that said theirs before it, so following
        // the reasons down ends.
        if w.escaped && !cx.whys.has(key) then cx.whys.put(key, w.why.unwrap_or(WhyUnknown))

        if now != was
            open.values.put(key, now)

            if open.read.has(key) then open.changed = true

        val low = open.lows.pop().unwrap()

        // A question older than this one was read: this one belongs to that one's component, which
        // settles it.
        if low < mine
            val top = open.lows.len() - 1

            if low < open.lows[top] then open.lows[top] = low

            open.changed = open.changed || outer_changed
            return now
        end if

        if !open.changed then break

        // Another round: every question asked since this one is asked afresh, from its value so far.
        while open.stack.len() > 0 && open.stack[open.stack.len() - 1] != key
            val gone = open.stack.pop().unwrap()

            open.order.remove(gone)
            open.read.remove(gone)

        open.read.remove(key)
        open.lows.push(mine)
    end loop

    // Settled: this question and every one of its component still stacked above it.
    loop
        val done = open.stack.pop().unwrap()
        val out = open.values.get(done).unwrap_or((false, false))

        cx.memo.put(done, out)

        if out.1 then cx.answering.add(open.plain.get(done).unwrap())

        open.plain.remove(done)
        open.order.remove(done)
        open.read.remove(done)
        open.values.remove(done)

        if done == key then break
    end loop

    open.changed = outer_changed
    cx.memo.get(key).unwrap()
end summary

// A record of closure environments as a memo key: its entries in one order, or nothing where there
// is no record.
private env_key(env: Option[Set[string]]) -> string
    if env.is_none() then return ""

    var entries: Buf[string] = buf()

    for entry in env.unwrap()
        entries.push(entry)

    sort(entries.view_mut())

    var text = "|"

    for entry in entries
        text = text + entry + ","

    text
end env_key

// -- why a box is on the heap: what `--explain-escapes` says ----------------------------------------

// **Why a box may get out of the frame that builds it**: the first way out a walk met (`sb_escape`),
// or what keeps a frame from holding it at all. Each says where it happened, and `box_why_said` words
// it as `--explain-escapes` reports it, after "because". A rule that finds a new way out adds a
// variant here and its sentence there.
enum BoxWhy
    // Stored into a place that is not a local's own storage.
    WhyStored(at: Span)
    // Written through a setter, which may keep what it is handed.
    WhySetter(at: Span)
    // Returned, other than as a factory's answer.
    WhyReturned(at: Span)
    // Handed to parameter `k` of a callee whose body may let it out (`BoxCx.whys` at `key`, the
    // summary's own memo key, says how).
    WhyHanded(at: Span, callee: string, k: usize, key: string)
    // Handed to a callee whose body cannot be asked: none in sight, a task's, or one the call does
    // not line up with.
    WhyUnseen(at: Span, callee: string)
    // Built into another box, or captured by a closure.
    WhyBoxed(at: Span, closure: bool)
    // Built into a value whose type has a destructor.
    WhyDropper(at: Span, ty: Type)
    // Read as another type.
    WhyCast(at: Span, ty: Type)
    WhyBreak(at: Span)
    WhyCompared(at: Span)
    WhyUpdate(at: Span)
    WhyAsm
    // Part of a node the walk does not follow a value into (`sb_kids`).
    WhyNode(node: TExpr)
    // Held by a local declared outside the loop that builds it into one slot every turn.
    WhyOutlivesTurn(holder: string)
    // A payload larger than a frame lays.
    WhyTooBig(size: usize)
    // A payload whose destructor may let what it is handed out.
    WhyDestructor(ty: Type, dtor: string)
    // Built in a body whose frame holds no box: an `async` one, or one that becomes another call.
    WhyFrameless(task: bool)
    // A walk that escaped without saying why.
    WhyUnknown
end BoxWhy

// Why a value handed to parameter `k` of `callee` may get out, as the callee's summary asked with the
// record `env` found it -- or asked with none, which is what a question asked again under another
// record while its body is being walked becomes (`summary`). A recursion's question is answered
// from the rounds already walked, each of which said why it let the parameter out.
private handed_why(cx: &BoxCx, callee: string, k: usize, env: Option[Set[string]], at: Span) -> BoxWhy
    val key = s"$callee|$k" + env_key(env)
    val plain = s"$callee|$k" + env_key(None)

    if cx.whys.has(key) then return WhyHanded(at, callee, k, key)
    if cx.whys.has(plain) then return WhyHanded(at, callee, k, plain)

    WhyUnseen(at, callee)
end handed_why

// The lines `--explain-escapes` says about boxes, gathered as the boxes are laid out, for the driver
// to say once the program is lowered (`take_box_notes`). One line per place in the source: a generic
// body built twice says it once.
private var sb_notes: Buf[LocalNote] = buf()
private var sb_noted: Set[string] = set()

// The box lines gathered since the last call, handed over once.
take_box_notes() -> Buf[LocalNote]
    val out = sb_notes

    sb_notes = buf()
    sb_noted = set()
    out
end take_box_notes

private note_box(cx: &BoxCx, f: TFunc, at: Span, what: string, why: BoxWhy) =
    push_box_note(f, at, what, box_why_said(cx, why, f))

// A factory call taken back because its factory has no frame entry: a parameter of its own lent by
// address, or the factory it answers the box of has none.
private note_unentered(f: TFunc, at: Span, factory: string, param: Option[string], via: Option[string])
    val why = if param is Some(n) then s"its parameter '${said_local(n)}' is lent by address"
    else if via is Some(g) then s"'${said_func(g)}', whose box it answers, has none"
    else "its frame entry was taken back"

    push_box_note(f, at, factory_subject(factory), s"'${said_func(factory)}' has no frame entry, since $why")
end note_unentered

// `file:line:col: <what> is boxed on the heap, because <why>`, at the box's payload or the call.
private push_box_note(f: TFunc, at: Span, what: string, because: string)
    if f.src.is_none() then return

    val src = f.src.unwrap()
    val loc = src.locate(at.start)
    val key = s"${src.name}:${loc.line}:${loc.col + literate_shift(src)}"

    if sb_noted.has(key) then return

    sb_noted.add(key)
    sb_notes.push(LocalNote(src.name, at.start, s"$key: $what is boxed on the heap, because $because"))
end push_box_note

// Whether `at` is the one box a factory answers, or the one factory call a factory of a factory
// answers, which its frame entry lays in its caller's slot.
private is_factory_site(cx: &BoxCx, f: TFunc, at: Span) -> bool = cx.factories.get(f.name) match
    Some(s) -> s == at
    None -> false

// A box as a line names it: by what is built in it.
private box_subject(payload: Type) -> string = s"a '${show_bare(payload)}'"

private factory_subject(name: string) -> string = s"what '${said_func(name)}' answers"

// What a line says after "because", for a reason met in the body of `f`.
private box_why_said(cx: &BoxCx, why: BoxWhy, f: TFunc) -> string = why match
    WhyStored(at) -> s"it is stored in '${said_text(f, at)}'${said_line(f, at)}"
    WhySetter(at) -> s"it is handed to the setter of '${said_text(f, at)}'${said_line(f, at)}"
    WhyReturned(at) -> s"it is returned from ${said_callee(f.name)}${said_line(f, at)}"
    WhyHanded(at, callee, k, key) -> handed_said(cx, at, callee, k, key, f)
    WhyUnseen(at, callee) ->
        s"it is handed to ${said_callee(callee)}${said_line(f, at)}, ${unseen_said(cx, callee)}"
    WhyBoxed(at, closure) ->
        if closure then s"it is captured by the closure${said_line(f, at)}"
        else s"it is built into another box${said_line(f, at)}"
    WhyDropper(at, ty) -> s"it is built into a '${show_bare(ty)}'${said_line(f, at)}, which has a destructor"
    WhyCast(at, ty) -> s"it is cast to '${type_show(ty)}'${said_line(f, at)}"
    WhyBreak(at) -> s"it is carried out of a loop by 'break'${said_line(f, at)}"
    WhyCompared(at) -> s"it is handed to a comparison's implementation${said_line(f, at)}"
    WhyUpdate(at) -> s"it is combined into '${said_text(f, at)}'${said_line(f, at)}"
    WhyAsm -> s"'${said_func(f.name)}' holds an 'asm' statement, which may reach it"
    WhyNode(x) -> s"it is ${node_said(x)}${said_line(f, x.span)}"
    WhyOutlivesTurn(holder) ->
        s"it is kept in '${said_local(holder)}', which outlives the turn of the loop that builds it"
    WhyTooBig(size) -> s"its payload is $size bytes, more than the ${stack_box_limit()} a frame holds"
    WhyDestructor(ty, dtor) -> destructor_said(cx, ty, dtor)
    WhyFrameless(task) ->
        if task then s"it is built in the 'async' body of '${said_func(f.name)}', whose frame keeps no box " +
            "across an 'await'"
        else s"it is built in '${said_func(f.name)}', which becomes another call and hands it its frame"
    WhyUnknown -> "the analysis found a way out it does not name"

// A callee that lets out what it is handed, and the way out its own body has.
private handed_said(cx: &BoxCx, at: Span, callee: string, k: usize, key: string, f: TFunc) -> string
    val g = cx.funcs[cx.index.get(callee).unwrap()]
    val param = if k < g.params.len() then said_local(g.params[k].0) else s"#${k + 1}"
    val inner = box_why_said(cx, cx.whys.get(key).unwrap(), g)

    s"it is handed to ${said_callee(callee)}${said_line(f, at)}, which keeps its parameter '$param' ($inner)"
end handed_said

private unseen_said(cx: &BoxCx, callee: string) -> string = cx.index.get(callee) match
    None -> "whose body is not in sight"
    Some(i) ->
        if cx.funcs[i].marks.is_async() then "whose body is a task's" else "which the call does not line up with"

private destructor_said(cx: &BoxCx, ty: Type, dtor: string) -> string
    val lead = s"the destructor of '${show_bare(ty)}' may let its payload out"

    cx.whys.get(s"$dtor|0" + env_key(None)) match
        Some(why) -> s"$lead (${box_why_said(cx, why, cx.funcs[cx.index.get(dtor).unwrap()])})"
        None -> lead
end destructor_said

// A node the walk does not follow a value into, as a line names what it does with the box.
private node_said(x: TExpr) -> string = *x.kind match
    TDowngrade(_, _) -> "weakened"
    TIntoRaw(_, _) -> "given up with 'into_raw'"
    TBufLit(_, _) -> "put in a buffer"
    TBufFill(_, _, _) -> "put in a buffer"
    TStr(_) -> "made into a string"
    TFormat(_, _, _) -> "made into a string"
    TRender(_, _, _, _) -> "made into a string"
    TCallPtr(_, _, _, _) -> "handed to a call through a function pointer"
    TVCall(r, _, _, _, _) ->
        s"handed to a call through '${type_show(texpr_type(r))}', whose bodies are not all in sight"
    TTry(_, _, _, _, _, _, _) -> "carried out by '?'"
    TAwait(_, _) -> "handed to a task"
    TBlockOn(_, _) -> "handed to a task"
    TStep(_, _) -> "handed to a task"
    TPark(_) -> "handed to a task"
    TSlots(_, _, _, _) -> "put in slot storage"
    TCrossCopy(_, _, _, _) -> "copied for another concurrency domain"
    TAtomic(_, _, _, _, _, _) -> "handed to an atomic operation"
    _ -> "read by an operation the analysis does not follow"

// ` on line N` of the file `f` was written in, or nothing for a body nothing wrote.
private said_line(f: TFunc, at: Span) -> string = f.src match
    Some(src) -> s" on line ${src.locate(at.start).line}"
    None -> ""

// What the reader wrote at `at`.
private said_text(f: TFunc, at: Span) -> string = f.src match
    Some(src) ->
        if at.end > src.bytes.len || at.start >= at.end then "a place" else from_utf8_unchecked(src.text(at))
    None -> "a place"

// A function as the reader wrote it: the last part of its qualified name -- an instance of a generic
// by the generic's (`frame_limit.sysl`'s `instance_base`).
private said_func(name: string) -> string
    val q = qualified_name(instance_base(name))

    q.last_index_of(".") match
        Some(at) -> q[at + 1..<q.bytes.len]
        None -> q
end said_func

// A callee as a line names it: a function by its name in quotes, a closure's body (`$closure0.call`,
// reached through a `&Fn`) as such.
private said_callee(name: string) -> string =
    if qualified_name(instance_base(name)).contains("$closure") then "a closure" else s"'${said_func(name)}'"

// A local as the reader wrote it: a shadowing declaration's own name carries a `.N` the reader never
// wrote.
private said_local(name: string) -> string = name.index_of(".") match
    Some(at) -> name[0..<at]
    None -> name
