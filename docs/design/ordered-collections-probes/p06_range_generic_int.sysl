// The same member at integer keys: a `Range[K]` parameter with `K: Ord`, and `K` an `int`.

struct Keys[K: Ord]
    ks: []K

    between(self, r: Range[K]) -> usize
        var n: usize = 0

        for k in self.ks
            if !(k < r.lo) && (k < r.hi || (r.inclusive && !(r.hi < k))) then n += 1

        n
end Keys

val m = Keys([1, 2, 3, 6, 7])

print(m.between(2..<6), m.between(2..6))
