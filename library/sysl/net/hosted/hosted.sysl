module sysl.net.hosted
@requires(posix, libc)

import sysl.net.sys.Endpoint
import sysl.sys.host_status

// `sysl.net.sys`'s hooks answered over a POSIX host's sockets. **Call `sysl.net` instead** -- nothing
// here is meant to be called: each function below exists to be linked under a hook's symbol, and is
// public only because an `@export` may not be `private`.
//
// **Nothing imports this module, and nothing has to.** A hook a program reaches is answered by the
// library's own supplier (`reference/ffi.md § A module may supply another module's extern`), and its
// exports are `weak`, so a program answering a hook itself is the one the link keeps. It requires
// `posix`, so a target without POSIX never takes it, and the bodies exist only on a hosted target: a
// freestanding one has no C library to answer with, so there the program answers the hooks it reaches,
// and one it leaves unanswered is refused by name when it is compiled.
//
// **What only C can answer is answered by `net.c` beside this file** -- the platform's `sockaddr`
// layouts, the socket macros and `getaddrinfo`. Each of its functions answers zero or an `errno`, and
// the hook here turns it into the
// contract's status with `sysl.sys.host_status`: the code negated, or `UNSUPPORTED` for the host's own
// "no such call here".

#if hosted
private extern "sysl_net_posix_socket" c_socket(family: int, kind: int, fd: *i32) -> int
private extern "sysl_net_posix_connect" c_connect(fd: int, to: *Endpoint) -> int
private extern "sysl_net_posix_bind" c_bind(fd: int, at: *Endpoint) -> int
private extern "sysl_net_posix_listen" c_listen(fd: int, backlog: int) -> int
private extern "sysl_net_posix_accept" c_accept(fd: int, peer: *Endpoint, out_fd: *i32) -> int
private extern "sysl_net_posix_local" c_local(fd: int, at: *Endpoint) -> int
private extern "sysl_net_posix_send" c_send(fd: int, from: *u8, n: usize, sent: *usize) -> int
private extern "sysl_net_posix_recv" c_recv(fd: int, into: *u8, n: usize, got: *usize) -> int
private extern "sysl_net_posix_send_to" c_send_to(fd: int, from: *u8, n: usize, to: *Endpoint,
                                                  sent: *usize) -> int
private extern "sysl_net_posix_recv_from" c_recv_from(fd: int, into: *u8, n: usize, from: *Endpoint,
                                                      got: *usize) -> int
private extern "sysl_net_posix_shutdown" c_shutdown(fd: int, how: int) -> int
private extern "sysl_net_posix_close" c_close(fd: int) -> int
private extern "sysl_net_posix_option" c_option(fd: int, which: int, value: i64) -> int
private extern "sysl_net_posix_resolve" c_resolve(host: *u8, host_len: usize, port: int,
                                                  passive: int, out: *Endpoint, room: usize,
                                                  count: *usize) -> int

/** A shim's `errno` or count as a hook's answer: the count, or the failure's status. */
private counted(e: int, n: usize) -> isize = if e != 0 then isize(host_status(e)) else isize(n)

@export("sysl_net_socket")
net_socket(family: int, kind: int) -> int
    var fd: i32 = 0
    val e = c_socket(family, kind, &fd)

    if e != 0 then host_status(e) else int(fd)

@export("sysl_net_connect")
net_connect(fd: int, to: *Endpoint) -> int = host_status(c_connect(fd, to))

@export("sysl_net_bind")
net_bind(fd: int, at: *Endpoint) -> int = host_status(c_bind(fd, at))

@export("sysl_net_listen")
net_listen(fd: int, backlog: int) -> int = host_status(c_listen(fd, backlog))

@export("sysl_net_accept")
net_accept(fd: int, peer: *Endpoint) -> int
    var s: i32 = 0
    val e = c_accept(fd, peer, &s)

    if e != 0 then host_status(e) else int(s)

@export("sysl_net_local")
net_local(fd: int, at: *Endpoint) -> int = host_status(c_local(fd, at))

@export("sysl_net_send")
net_send(fd: int, from: *u8, len: usize) -> isize
    var n: usize = 0

    counted(c_send(fd, from, len, &n), n)

@export("sysl_net_recv")
net_recv(fd: int, into: *u8, room: usize) -> isize
    var n: usize = 0

    counted(c_recv(fd, into, room, &n), n)

@export("sysl_net_send_to")
net_send_to(fd: int, from: *u8, len: usize, to: *Endpoint) -> isize
    var n: usize = 0

    counted(c_send_to(fd, from, len, to, &n), n)

@export("sysl_net_recv_from")
net_recv_from(fd: int, into: *u8, room: usize, from: *Endpoint) -> isize
    var n: usize = 0

    counted(c_recv_from(fd, into, room, from, &n), n)

@export("sysl_net_shutdown")
net_shutdown(fd: int, how: int) -> int = host_status(c_shutdown(fd, how))

@export("sysl_net_close")
net_close(fd: int) -> int = host_status(c_close(fd))

@export("sysl_net_option")
net_option(fd: int, which: int, value: i64) -> int = host_status(c_option(fd, which, value))

@export("sysl_net_resolve")
net_resolve(host: *u8, host_len: usize, port: int, passive: int, out: *Endpoint, room: usize) -> int
    var n: usize = 0
    val e = c_resolve(host, host_len, port, passive, out, room, &n)

    if e != 0 then host_status(e) else int(n)
#endif
