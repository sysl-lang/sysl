module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.fs.{make_dir_all, remove_dir_all, write_text}
import sysl.text.join

// **A trait's method borrows its parameters for the call, by rule, so every command that checks a
// body agrees on it.** The rule is read off nothing a compilation may or may not hold -- no method
// table, no annotation -- so a library whose implementations are its consumers' has none in sight
// and `build-lib` still accepts a view of the stack passed through an object of the trait. Each
// claim here is put to `build-lib` and `build-c` over the same `@no_alloc` module, which declares no
// implementation at all. A call trait's object -- a closure behind a `&Fn` -- is the exception: a
// closure may keep what it is handed, so a view passed through one has nowhere to go but the heap.

private brw_run(args: []string) -> (int, string)
    var lines: Buf[string] = buf()
    val sink = &lines
    val code = run_cli(args, (line) -> sink.push(line))

    (code, join(lines.view(), "\n"))
end brw_run

// `src` written as module `demo` under a fresh root, put to `build-lib` and then to `build-c`.
private brw_both(src: string) -> ((int, string), (int, string))
    val root = lbr_temp("sysl-brw-")

    make_dir_all(s"$root/demo").unwrap()
    write_text(s"$root/demo/demo.sysl", src).unwrap()

    val lib = brw_run(["sysl", "build-lib", root])
    val c = brw_run(["sysl", "build-c", "-o", s"$root/demo.a", "--header", s"$root/demo.h", root])

    remove_dir_all(root).unwrap_or(())
    (lib, c)
end brw_both

// Both commands accept `src`.
private brw_accepted(src: string)
    val (lib, c) = brw_both(src)

    assert_eq(lib.0, Fine, s"build-lib: ${lib.1}")
    assert_eq(c.0, Fine, s"build-c: ${c.1}")
end brw_accepted

// Both commands refuse `src`, each saying `part`.
private brw_refused(src: string, part: string)
    val (lib, c) = brw_both(src)

    assert(lib.0 != Fine, "build-lib accepted it")
    assert(lib.1.contains(part), s"build-lib said: ${lib.1}")
    assert(c.0 != Fine, "build-c accepted it")
    assert(c.1.contains(part), s"build-c said: ${c.1}")
end brw_refused

private val brw_kept: string = "is passed through a trait object, which may hold on to it"

// A sink, and a body passing it a view of its own stack.
private brw_sink() -> string =
    "module demo\n@no_alloc\n\ntrait Sink\n    put(*self, bytes: []const u8)\n\n" +
    "go(s: *Sink)\n    var buf: [8]u8 = [0; 8]\n    s.put(buf[0..<4])\n"

@test("a view passed to a trait's method with no implementation in sight is accepted by build-lib and build-c")
brw_promise_without_a_table()
    if !rng_ready() then return

    brw_accepted(brw_sink())

@test("through a closure behind a '&Fn' both refuse it, the view having nowhere to go under @no_alloc")
brw_call_trait_refused_by_both()
    if !rng_ready() then return

    brw_refused("module demo\n@no_alloc\n\n" +
                "go(f: &Fn([]const u8) -> unit)\n    var buf: [8]u8 = [0; 8]\n    f(buf[0..<4])\n",
                brw_kept)

@test("std's Writer borrows what 'write' is passed, and both commands hear it")
brw_std_writer()
    if !rng_ready() then return

    brw_accepted("module demo\n@no_alloc\n\n" +
                 "go(w: *Writer)\n    var buf: [8]u8 = [0; 8]\n    w.write(buf[0..<4])\n")

@test("a generic trait's method borrows at the instance an object names")
brw_generic_trait()
    if !rng_ready() then return

    brw_accepted("module demo\n@no_alloc\n\ntrait Sink[T]\n    put(*self, xs: []const T)\n\n" +
                 "go(s: *Sink[u8])\n    var buf: [8]u8 = [0; 8]\n    s.put(buf[0..<4])\n")

// The rule is every parameter's, not one named one's.
@test("every parameter is borrowed, not only one")
brw_every_parameter()
    if !rng_ready() then return

    brw_accepted("module demo\n@no_alloc\n\ntrait Sink\n" +
                 "    put(*self, kept: []const u8, bytes: []const u8)\n\n" +
                 "go(s: *Sink, other: []const u8)\n    var buf: [8]u8 = [0; 8]\n" +
                 "    s.put(buf[0..<4], other)\n    s.put(other, buf[0..<4])\n")

// A slot past the trait's own members: a required trait's method borrows as its own trait's does.
@test("a required trait's method borrows through an object of the requiring trait")
brw_required_trait()
    if !rng_ready() then return

    brw_accepted("module demo\n@no_alloc\n\ntrait Sink\n    put(*self, bytes: []const u8)\n\n" +
                 "trait Named: Sink\n    name(self) -> u8\n\n" +
                 "go(s: *Named)\n    var buf: [8]u8 = [0; 8]\n    s.put(buf[0..<4])\n")

// -- an implementation is held to the rule -------------------------------------------------------

@test("an implementation that keeps a view it is handed is refused where it is written")
brw_keeping_implementation_refused()
    if !rng_ready() then return

    azc_refuses("trait Sink\n    put(*self, bytes: []const u8)\n\nstruct Saver\n    last: []const u8\n\n" +
                "impl Sink for Saver\n    put(*self, bytes: []const u8)\n        self.last = bytes\n\n" +
                "var c = Saver([])\nvar s: *Sink = &c\nvar buf: [8]u8\ns.put(buf[0..<4])\n" +
                "print(c.last.len)\n",
                "keeps what it is passed as 'bytes', but a method of 'Sink' borrows its parameters " +
                "for the call")

@test("and one that only reads it runs")
brw_reading_implementation_runs()
    if !rng_ready() then return

    val got = azc_cli(["emit-llvm"], [("main.sysl",
        "trait Sink\n    put(*self, bytes: []const u8)\n\n" +
        "struct Counter\n    n: usize\n\nimpl Sink for Counter\n    put(*self, bytes: []const u8)\n" +
        "        self.n += bytes.len\n\nvar c = Counter(0)\nvar s: *Sink = &c\nvar buf: [8]u8\n" +
        "s.put(buf[0..<4])\nprint(c.n)\n")])

    assert(got.ok, got.said())

// -- '@borrows' is gone ------------------------------------------------------------------------------

@test("'@borrows' above a trait's method is an annotation no member takes")
brw_borrows_is_unknown()
    if !rng_ready() then return

    azc_refuses("trait Sink\n    @borrows(bytes)\n    put(*self, bytes: []const u8)\n\nprint(1)\n",
                "the only annotations a member may carry are the ones about a parameter — " +
                "'@crossing', '@reads' and '@writes'")
    azc_refuses("@borrows(bytes)\nput(bytes: []const u8) = ()\n\nprint(1)\n",
                "'borrows' is not an annotation a declaration takes")
