module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.math.bigint.{BigInt, from_int}

// What a pair of parentheses means, which is six different things told apart by what stands in
// front of them: a conversion, a variant, a struct's constructor, a simple enum read out of an
// integer, a function, and a member.
//
// **A conversion is written with call syntax, so a type name in call position is one.** That is
// what makes `u8(x)` and `T(b)` the same form: every instantiation replaces the parameter with a
// type this same spelling would have accepted written out.

// A call to a nested function whose environment does not exist yet, or to one of a body around this
// one -- each a different mistake, and each with a sentence of its own.
private call_before_the_group(cx: &Analyzer, span: Span, name: string) -> Option[TExpr]
    if pending_named(cx, name)
        // The group is waiting on a binding written below this call. The functions themselves are
        // above it, so "declared below this call" would be flatly false -- what is below is the
        // data. **All of them wait, not only the one that reads it**: a block's nested functions
        // share one environment, which is what lets them call each other in either order, so there
        // is nothing to pass to any of them until it is built.
        if cx.awaiting_needs
            var waiting: Buf[string] = buf()

            for i in 0..<cx.pending_needs.len()
                waiting.push(cx.pending_needs.at(i))

            waiting = sort_names(waiting)

            var which = ""

            for i in 0..<waiting.len()
                if i > 0 then which = which + ", "

                which = which + s"'${waiting.at(i)}'"

            val one = waiting.len() == 1
            val it = if one then "it" else "them"

            return Some(cx.err(span, s"'$name' cannot be called here — the nested functions of " +
                               "this block share one environment, and it is not built until " +
                               s"everything they read is bound. $which " +
                               s"${if one then "is" else "are"} bound below this call: move the " +
                               s"call below $it, or move $it above the functions"))

        return Some(cx.err(span, s"'$name' is declared below this call — the nested functions of a " +
                           "block share an environment formed where the first of them is written, " +
                           "so they may be called from there on"))

    // One belonging to a body this one is written inside. A body reaches its own group and no
    // further, because what it would have to carry to reach further is the frame around it.
    if holds_string(cx.outer_nested, name) then
        return Some(cx.err(span, s"'$name' is a nested function of the body around this one, which " +
                           "reaches its own nested functions and its own captures and no further " +
                           "— a top-level function is what several bodies share"))

    None
end call_before_the_group

private pending_named(cx: &Analyzer, name: string) -> bool
    for i in 0..<cx.pending_nested.len()
        if cx.pending_nested.at(i).name == name then return true

    false
end pending_named

call_expr(cx: &Analyzer, span: Span, callee: Expr, args: Buf[Expr],
          expected: Option[Type]) -> TExpr
    *callee.kind match
        Ident(name) ->
            // A nested function is called on the receiver the body already has, and the name is the
            // block's rather than the module's -- so a local of the same spelling still shadows it.
            if cx.lookup(name).is_none()
                val inner = cx.nested_of(name)

                if inner.is_some() then return call_nested(cx, span, inner.unwrap(), name, args)

                val early = call_before_the_group(cx, span, name)

                if early.is_some() then return early.unwrap()

            named_call(cx, span, callee, name, args, expected)
        // `f[A, B](x)` -- the instantiation the reader named, which is what brackets mean in a
        // **type** and what a call borrows them for.
        TypeArgs(head, targs) -> written_call(cx, span, head, targs, args, expected)
        // `f[A](x)` has no comma to tell its brackets from a subscript, so it arrives as an index
        // and is re-read here where the name is one a generic declares.
        Index(head, one) ->
            val name = written_name_of(head)

            if name.is_some() && names_a_function(cx, name.unwrap())
                var targs: Buf[Expr] = buf()

                targs.push(one)
                return written_call(cx, span, head, targs, args, expected)
            end if

            // **A special form written with a type argument, which `va_arg[int](ap)` is what this
            // is for.** Everywhere else the annotation that stands in is a word on a binding that
            // was going to be written anyway, and a variadic body reading its tail straight into
            // `print` has no binding at all. `ptr_cast[T](p)` is the same shape from the raw tier:
            // both take their type from what receives the value, so writing it in the brackets is
            // writing it where the value is made.
            //
            // The rest take none, for the reason a non-generic function takes none -- there is
            // nothing for an argument to be an argument *of* -- and are told so rather than being
            // reported as uncallable.
            if name.is_some() && cx.lookup(name.unwrap()).is_none() &&
               special_form_name(cx, name.unwrap())
                val written = name.unwrap()
                val targ = Some(written_type_arg(cx, one))

                if written == "va_arg"
                    val va = va_form(cx, span, written, args, targ)

                    if va.is_some() then return va.unwrap()
                end if

                if written == "ptr_cast" && args.len() == 1 then
                    return ptr_cast_call(cx, span, args, targ)

                return cx.err(span, s"'$written' takes no type arguments")
            end if

            cx.err(span, "this is not something that can be called")
        // `.Circle(5)` -- the form below with the enum's own name left off, resolved against what
        // the context expects.
        ImplicitMember(name) -> implicit_call(cx, span, name, args, expected)

        // A member call. A module path folded into a name is a plain call under another spelling,
        // so it is asked about first.
        // `T::Attr(x)` -- a type attribute that carries an operand.
        TypeAttr(subject, attr) ->
            val name = attr_type_name(subject)

            if name.is_none() || cx.lookup(name.unwrap()).is_some() then
                return cx.err(span, s"'::$attr' is a type attribute, so its left side must be a " +
                              "type name")

            type_attr_call(cx, span, name.unwrap(), attr, args)
        Field(receiver, member) ->
            val dotted = module_path_of(receiver, member)

            if dotted.is_some() && names_a_function(cx, dotted.unwrap()) then
                return named_call(cx, span, callee, dotted.unwrap(), args, expected)

            // An **associated function**, reached through the type rather than through a value: a
            // name in front of the dot that stands for a type is not something to read a value off.
            val on_type = associated_call(cx, span, receiver, member, args, expected)

            if on_type.is_some() then return on_type.unwrap()

            // `Status.Exited(0)` -- a variant named through its own enum, which is how one that
            // carries something is written where the bare name would be ambiguous.
            val qualified = qualified_variant(cx, receiver, member)

            if qualified.is_some() then
                return variant_call(cx, span, qualified.unwrap().0, qualified.unwrap().1, args)

            // A **generic** enum has no single instantiation for its name to stand for, so the one
            // meant is worked out from what the variant carries -- exactly as it is for the bare
            // name, and for the same reason: `Slot.Live(h, k, v)` is a `Slot[K, V]` because that is
            // what the values say.
            val qualified_generic = qualified_variant_solved(cx, span, receiver, member, args,
                                                             expected)

            if qualified_generic.is_some() then
                return variant_call(cx, span, qualified_generic.unwrap().0,
                                    qualified_generic.unwrap().1, args)

            // **A TYPE reached through the module it belongs to**, which is the other half of the
            // function case above: `c.InBuffer(p, n, 0)` is the struct's constructor, `c.Mode(n)` an
            // enum's checked cast and `c.Tick(n)` a constrained type's, each exactly what the
            // unqualified spelling would have been. It is asked here rather than beside the function
            // so that a type's own associated function and a variant named through its enum keep the
            // readings they had; nothing that resolved before reaches this line.
            if dotted.is_some() && lookup_type_key(cx.an, cx.scope, dotted.unwrap()).is_some() then
                return named_call(cx, span, callee, dotted.unwrap(), args, expected)

            val tr = type_expr_bare(cx, receiver)

            if texpr_type(tr) == Unknown then return tr

            // **The receiver is handed over as it stands.** A call reaches through one level of
            // indirection and only one, exactly as selection does, and what is left after that is a
            // type the reader never wrote -- so the lookup sees the mode and the message can name it.
            call_member(cx, span, tr, member, args, expected)
        _ -> cx.err(span, "this is not something that can be called")
end call_expr

// The name a written type application was made on, where it is one a call could be written through.
private written_name_of(head: Expr) -> Option[string] = *head.kind match
    Ident(n) -> Some(n)
    Field(inner, name) -> module_path_of(inner, name)
    _ -> None

private written_call(cx: &Analyzer, span: Span, head: Expr, targs: Buf[Expr], args: Buf[Expr],
                     expected: Option[Type]) -> TExpr
    val name = written_name_of(head)

    if name.is_none() then return cx.err(span, "this is not something that can be called")

    written_generic_call(cx, span, name.unwrap(), targs, args, expected)
end written_call

private module_path_of(receiver: Expr, name: string) -> Option[string] = *receiver.kind match
    Ident(head) -> Some(s"$head.$name")
    Field(inner, mid) -> module_path_of(inner, mid).map(head -> s"$head.$name")
    _ -> None

// **An `extern` is one too**, and leaving it out is what sent `c.surface_destroy(h)` down the
// member-call road: the receiver `c` is a module rather than a value, so reading it as one reports
// the module as an undefined name and says nothing about the call.
private names_a_function(cx: &Analyzer, written: string) -> bool =
    !function_keys(cx, written).is_empty() || extern_key(cx, written).is_some()

// A name in call position, in the order the reader's own bindings are consulted.
private named_call(cx: &Analyzer, span: Span, callee: Expr, name: string, args: Buf[Expr],
                   expected: Option[Type]) -> TExpr
    val special = special_form(cx, span, name, args, expected)

    if special.is_some() then return special.unwrap()

    val shadowed = cx.lookup(name).is_some()

    // **A conversion to a TYPE PARAMETER**, which every instantiation replaces with a type this same
    // form would have accepted written out. That is what makes the two directions symmetric: `u8(x)`
    // where `x` is a `T` was always ordinary code, checked once the width is concrete, and `T(b)` is
    // the same check at the same moment.
    //
    // **A parameter is asked about ahead of every declaration table**, because it is the nearer
    // binding: `var y: T` inside a `[T]` body already means the parameter whatever else is called
    // `T`, and a name cannot mean the parameter in type position and a declaration in call position.
    if !shadowed
        val stands_for = bound_type(cx.subst, name)

        if stands_for.is_some() then
            return convert_call(cx, span, name, stands_for.unwrap(), args)
    end if

    // **A variant the position asked for outright claims the name**, before a type of that name is
    // asked about: a variant and a struct may share a spelling, and `ImplDecl(d)` at a parameter
    // whose type is the enum is the variant however many structs are called that. Nothing else
    // could have decided it, and the expected type was there to be read.
    if !shadowed
        val wanted = variant_from_expected(cx, name, expected)

        if wanted.is_some() then
            return variant_call(cx, span, wanted.unwrap().0, wanted.unwrap().1, args)
    end if

    val tkey = if shadowed then None else lookup_type_key(cx.an, cx.scope, name)

    // A conversion, where no declaration claims the name.
    if !shadowed && tkey.is_none() then
        val scalar = scalar_type_named(cx, span, name)

        if scalar.is_some() then return convert_call(cx, span, name, scalar.unwrap(), args)

    if tkey.is_some() then
        val kind = cx.an.tables.types.get(tkey.unwrap()).unwrap().kind

        kind match
            // A bare variant name in call position, with the enum taken from the expected type --
            // but a **type** of the same name is asked about first, since a struct's constructor is
            // named by the struct's own name and has no second spelling at all.
            StructOf(_) -> return struct_call(cx, span, tkey.unwrap(), name, args, expected)
            // A simple enum's name in call position is a checked cast from an integer.
            EnumOf(_) -> return enum_cast(cx, span, tkey.unwrap(), name, args)
            // **A plain alias is another spelling for what it names, so a call through one is the
            // call the base would have taken.** `type AudioSpec = c.AudioSpec` over a struct makes
            // `AudioSpec(fmt, channels, freq)` that struct's constructor -- which the org's bindings
            // write everywhere, since an alias is how a package names its own C layer's ABI types
            // without moving them. A *constrained* subtype is a different thing and keeps the
            // conversion it always had: it has a check to run, which is why it is worth writing.
            TypeOf(d) ->
                if is_plain_alias(d)
                    behind_alias(cx, tkey.unwrap()) match
                        Some(Struct(sd)) ->
                            return struct_call(cx, span, sd.base, name, args, expected)
                        Some(Enum(ed)) -> return enum_cast(cx, span, ed.base, name, args)
                        _ -> ()

                return constrained_call(cx, span, tkey.unwrap(), name, args)
            _ -> ()

    if !shadowed
        val settled = variant_from_expected(cx, name, expected)

        if settled.is_some() then
            return variant_call(cx, span, settled.unwrap().0, settled.unwrap().1, args)

        // **A generic enum's variant is worked out from what it carries**, exactly as a generic
        // struct's constructor is: `Some(s)` on its own is an `Option[string]` because `s` is a
        // string, and picking whichever instantiation happened to be registered first would make it
        // whatever some other file asked for.
        val solved = variant_solved(cx, span, name, args)

        if solved.is_some() then
            return variant_call(cx, span, solved.unwrap().0, solved.unwrap().1, args)

        val v = variant_of(cx, name, expected)

        if v.is_some() then return variant_call(cx, span, v.unwrap().0, v.unwrap().1, args)

    // A local holding a callable is called through it, and it wins over a declaration of the same
    // name for the reason the nearest binding always does.
    if shadowed then return call_through(cx, span, name, args, expected)

    function_call(cx, span, name, args, expected)
end named_call

// -- the forms the compiler answers by name ------------------------------------------------------

// `print`, the two rendering companions, and the primitives no sysl body could implement.
// **These are resolved by NAME, not by looking a function up, and a local of the same spelling does
// not take the name back.** `str(x)` means the rendering however many things called `str` are in
// scope, which is what lets an interpolation hole read a parameter named `str` -- the hole desugars
// to `str(str)`, and a guard that yielded to the local would leave a call to a value nothing can
// call. The forms that *do* yield are the atomics, which say so where they are asked (nine names is
// too much of a program's vocabulary to take outright), and the conversions, which `named_call`
// asks about only where nothing claims the name.
private special_form(cx: &Analyzer, span: Span, name: string, args: Buf[Expr],
                     expected: Option[Type]) -> Option[TExpr]
    // `old(e)` is the value an argument had on entry, and it means something only inside an
    // `ensure` -- so it is a form there and an ordinary name everywhere else.
    if name == "old" && cx.olds.is_some() then return Some(old_call(cx, span, args))

    if name == "print" then return Some(print_call(cx, span, args))

    // The atomics yield to a declaration of the name, which is why they are asked about with the
    // analyzer rather than by name alone.
    if atomic_form(cx, name) then return Some(atomic_call(cx, span, name, args))

    if name == "str_cast" then return Some(str_cast_call(cx, span, args))

    if name == "va_start" || name == "va_end" || name == "va_copy" || name == "va_arg"
        val va = va_form(cx, span, name, args, expected)

        if va.is_some() then return va

    // **`str` splits on whether the value is a scalar.** A number, a bool, a character and a
    // `string` each go out directly; everything else writes itself into a buffer through its
    // `Display`, and the bytes that land there become the string.
    if name == "str" && args.len() == 1 then
        val v = type_expr_bare(cx, args.at(0))

        if scalar_render(texpr_type(v)) then return Some(TExpr(span, TStr(v)))

        return Some(str_render(cx, span, v))

    if name == "format" && args.len() == 2 then
        *args.at(1).kind match
            StrLit(spec) -> return Some(format_call(cx, span, args.at(0), spec))
            _ -> ()

    if name == "ptr_cast" && args.len() == 1 then
        return Some(ptr_cast_call(cx, span, args, expected))

    None
end special_form

// `ptr_cast(p)` and `ptr_cast[T](p)` -- an address read as a pointer to some type, which is either
// the type the position gives it or the one written in the brackets.
private ptr_cast_call(cx: &Analyzer, span: Span, args: Buf[Expr], expected: Option[Type]) -> TExpr
    if expected.is_none() then
        return cx.err(span, "'ptr_cast' reads an address as a pointer to some type, and nothing " +
                      "here says which")

    val t = type_expr_bare(cx, args.at(0))

    TExpr(span, TCast(t, expected.unwrap()))
end ptr_cast_call

// Whether a name is one the compiler answers itself rather than looking up. It is asked only to
// decide what a **type argument** written after one means, so the atomics are in it too: they take
// none either, and saying so is better than reporting the name as uncallable.
private special_form_name(cx: &Analyzer, name: string) -> bool =
    name == "print" || name == "str" || name == "format" || name == "str_cast" ||
    name == "va_start" || name == "va_end" || name == "va_arg" || name == "va_copy" ||
    name == "ptr_cast" || atomic_form(cx, name)

// An explicit scalar conversion. Every pair that has a meaning is listed; nothing widens, narrows,
// or changes representation without being written.
private convert_call(cx: &Analyzer, span: Span, written: string, to: Type,
                     args: Buf[Expr]) -> TExpr
    if args.len() != 1 then
        return cx.err(span, s"a conversion to '$written' takes one value, and " +
                      s"${quantity(args.len(), "argument")} " +
                      s"${if args.len() == 1 then "was" else "were"} given")

    val t = type_expr_bare(cx, args.at(0))

    if texpr_type(t) == Unknown then return t

    convert_to(cx, span, t, to, None)
end convert_call

// The conversion itself, which a subtype's cast also reaches.
//
// **`asked` is what the reader actually wrote**, where that is not the target's own name: a
// conversion into a transparent subtype is this conversion into its base, and a refusal naming the
// base would be answering about a type the line does not mention.
convert_to(cx: &Analyzer, span: Span, t: TExpr, to: Type, asked: Option[string]) -> TExpr
    if to == Str then return encode_string(cx, span, t)

    val from = underlying(texpr_type(t))

    if !converts(cx, span, from, to) then
        return cx.err(span, refusal(asked, texpr_type(t), to))

    TExpr(span, TCast(t, to))
end convert_to

private refusal(asked: Option[string], from: Type, to: Type) -> string = asked match
    Some(name) -> s"cannot make $name from ${type_show(from)}"
    None -> s"cannot convert ${type_show(from)} to ${type_show(to)}"

private converts(cx: &Analyzer, span: Span, from: Type, to: Type) -> bool
    // **A type parameter standing in for itself admits every conversion, and the check is not
    // skipped -- it is DEFERRED.** A generic body is read once at its definition with the parameter
    // opaque, where nothing about `F(n)` can be decided; each instantiation reads the body again
    // with a width in place of `F`, and that reading is this same function answering about two
    // concrete types.
    to match
        Abstract(_, _) -> return true
        _ -> ()

    from match
        Abstract(_, _) -> return true
        Integer(_, _, _) -> to match
            Integer(_, _, _) -> return true
            Floating(_) -> return true
            Char -> return true
            _ -> return false
        Floating(_) -> to match
            Integer(_, _, _) -> return true
            Floating(_) -> return true
            _ -> return false
        Char -> to match
            Integer(_, _, _) -> return true
            Char -> return true
            _ -> return false
        // Enum to integer is total: every enum value is one of its declared discriminants. Only a
        // simple enum has an integer value to give; a data enum is a tagged union, not a number.
        Enum(d) -> to match
            Integer(_, _, _) ->
                if !d.simple then
                    cx.fault(span, s"only a simple enum converts to an integer — " +
                             s"${type_show(from)} carries data")

                return true
            _ -> return false
        // A pointer to an integer is total: an address *is* a number of `usize`'s width. It goes
        // only this way; making a pointer out of an integer is `ptr_cast`.
        Ptr(inner) -> to match
            Integer(_, _, pw) ->
                if is_trait(*inner) then
                    cx.fault(span, "a pointer to a trait is two words — the address and the table " +
                             "of the type it was erased from — so it is not a number")
                else if !pw then
                    cx.fault(span, s"an address is read as 'usize' or 'isize' rather than as " +
                             s"${type_show(to)} — a fixed width is not an address's width on " +
                             "every target")

                return true
            _ -> return false
        CFn(_, _) -> to match
            Integer(_, _, pw) ->
                if !pw then
                    cx.fault(span, s"an address is read as 'usize' or 'isize' rather than as " +
                             s"${type_show(to)} — a fixed width is not an address's width on " +
                             "every target")

                return true
            _ -> return false
        _ -> return false
end converts

// `string(c)` -- one scalar value encoded as the bytes that spell it. It is the one conversion whose
// result is not a scalar, so it produces fresh bytes rather than a reinterpretation.
private encode_string(cx: &Analyzer, span: Span, t: TExpr) -> TExpr
    val from = underlying(texpr_type(t))

    from match
        Char -> TExpr(span, TStr(t))
        Str -> cx.err(span, "a 'string' conversion encodes a char, and this value is already a " +
                      "string")
        Slice(elem, _) ->
            if type_eq(*elem, byte_type()) then
                cx.err(span, "a 'string' conversion encodes a char — bytes are already text or " +
                       "are not, so 'sysl.text.from_utf8(b)' is what says which")
            else
                cx.err(span, s"a 'string' conversion encodes a char, and ${type_show(from)} is " +
                       "not one — 'str(x)' renders a value as text")
        _ -> cx.err(span, s"a 'string' conversion encodes a char, and ${type_show(from)} is not " +
                    "one — 'str(x)' renders a value as text")
end encode_string

// -- what a declared type's name means in call position -------------------------------------------

// A struct's name in call position is its positional constructor.
private struct_call(cx: &Analyzer, span: Span, key: string, written: string, args: Buf[Expr],
                    expected: Option[Type]) -> TExpr
    val decl = cx.an.tables.types.get(key)
    var sd: Option[StructDecl] = None

    if decl.is_some() then
        decl.unwrap().kind match
            StructOf(one) -> sd = Some(one)
            _ -> ()

    var inst = cx.an.tables.struct_insts.get(instance_key(key, buf()))

    // A generic struct has no instantiation under an empty argument list, so the constructor works
    // out what it is being built at -- from the type the position expects where that says, and from
    // the values otherwise.
    if sd.is_some() && !sd.unwrap().tparams.is_empty()
        val targs = struct_targs(cx, span, key, decl.unwrap().scope, sd.unwrap(), args, expected)

        reinstantiate(cx.an, key, targs) match
            Struct(d) -> inst = Some(Struct(d))
            _ -> return bad_expr(span)
    end if

    if inst.is_none() then
        return cx.err(span, s"'$written' takes type arguments, and inferring them is not built yet")

    inst.unwrap() match
        Struct(d) ->
            if args.len() != d.fields.len() then
                return cx.err(span, s"struct '$written' has " +
                              s"${quantity(d.fields.len(), "field")}, but " +
                              s"${quantity(args.len(), "value")} " +
                              s"${if args.len() == 1 then "was" else "were"} given")

            var ts: Buf[TExpr] = buf()

            for i in 0..<args.len()
                val want = d.fields.at(i).1
                val t = type_expr(cx, args.at(i), Some(want))

                if disagree(texpr_type(t), want) then
                    cx.fault(args.at(i).span, s"'${d.fields.at(i).0}' of '$written' is " +
                             s"${type_show(want)}, but ${type_show(texpr_type(t))} was given")

                ts.push(t)

            // **A struct with `invariant` clauses is checked the moment it is built**, and every
            // construction flows through here, so one wrap covers them all. A generic one has no
            // predicate to call -- the clause is refused where it is declared -- so it builds
            // unchecked.
            checked_new(cx, span, TExpr(span, TStructNew(d, ts)), d)
        _ -> bad_expr(span)
end struct_call

// A construction with the invariant check its type owes wrapped around it, where it states one.
private checked_new(cx: &Analyzer, span: Span, made: TExpr, d: &StructType) -> TExpr
    val decl = cx.an.tables.types.get(d.base)

    if decl.is_none() then return made

    decl.unwrap().kind match
        StructOf(sd) ->
            if sd.invariants.is_empty() || !sd.tparams.is_empty() then made
            else TExpr(span, TStructInvCheck(made, d, inv_key(d.base)))
        _ -> made
end checked_new

// The arguments a generic struct is built at: the ones the position already names, where it names a
// struct of this very declaration, and otherwise the ones the field values determine.
//
// **A position that says outright is trusted over the values**, because the values are read against
// the fields and the fields are written in the parameters being worked out -- so a `var b: Buf[T] =
// Buf([], 0)` settles `T` from the annotation rather than from an empty array literal that says
// nothing.
private struct_targs(cx: &Analyzer, span: Span, key: string, home: Scope, sd: StructDecl,
                     args: Buf[Expr], expected: Option[Type]) -> Buf[Type]
    if expected.is_some()
        expected.unwrap() match
            Struct(d) -> if d.base == key then return d.targs
            _ -> ()
    end if

    var field_refs: Buf[TypeRef] = buf()

    for i in 0..<sd.fields.len()
        field_refs.push(sd.fields.at(i).typ)

    var prov: Buf[Type] = buf()
    var soft: Buf[bool] = buf()

    for i in 0..<args.len()
        if i < field_refs.len() && !ref_mentions(field_refs.at(i), sd.tparams)
            val want = resolve_type(cx.an, home, field_refs.at(i), no_bindings())
            val t = sandboxed_read(cx, args.at(i), Some(want))

            prov.push(texpr_type(t))
            soft.push(false)
        else
            val t = sandboxed_read(cx, args.at(i), None)

            prov.push(texpr_type(t))
            soft.push(adaptable(args.at(i), t))

    solve(cx.an, home, span, key, sd.tparams, field_refs, prov, None, expected, soft, sd.bounds,
          buf())
end struct_targs

// A simple enum's name in call position is a checked cast from an integer.
private enum_cast(cx: &Analyzer, span: Span, key: string, written: string,
                  args: Buf[Expr]) -> TExpr
    val inst = cx.an.tables.enum_insts.get(instance_key(key, buf()))

    if inst.is_none() then
        return cx.err(span, s"'$written' takes type arguments, and inferring them is not built yet")

    val en = inst.unwrap()

    en match
        Enum(d) ->
            if !d.simple then
                return cx.err(span, s"only a simple enum is read out of an integer — " +
                              s"'${module_show(key)}' carries data")

            if args.len() != 1 then
                return cx.err(span, s"a conversion to '$written' takes one value, and " +
                              s"${quantity(args.len(), "argument")} " +
                              s"${if args.len() == 1 then "was" else "were"} given")

            TExpr(span, TEnumFromInt(type_expr(cx, args.at(0), Some(d.underlying)), en))
        _ -> bad_expr(span)
end enum_cast

// A constrained subtype's name in call position wraps a base value into the subtype, checking it.
// Unlike an implicit produce site, the cast is written, so it applies even where the base would not
// flow in on its own.
// **`format(x, "%…")`** -- one value rendered through a printf specifier, which is what a hole with
// a specifier after it desugars to.
//
// **`%s` takes a string and nothing else, and the two ways of not being one are told apart.** A type
// with a `Display` of its own writes itself into a buffer first and the bytes that land there are
// what the specifier's width and justification are applied to -- so `${err}%s` over an error type
// prints its sentence, which is the whole point of writing one. A **scalar** has a renderer of its
// own and no `Display` to reach, so `${n}%s` over an integer is a mistake in the specifier rather
// than a value to convert: printing `7` there would be answering a question nobody asked, and the
// reader meant `%d`.
//
// Without the first half a `Display` value reached the lowering as though it were already a string
// and the emitted IR read its bytes out of an enum, which clang refuses -- three of the org's
// bindings died at exactly that line.
private format_call(cx: &Analyzer, span: Span, arg: Expr, spec: string) -> TExpr
    val v = type_expr_bare(cx, arg)
    val ty = texpr_type(v)

    if ty == Unknown then return TExpr(span, TFormat(v, spec))
    if !spec_is_str(spec_conversion(spec)) then return TExpr(span, TFormat(v, spec))
    if ty == Str then return TExpr(span, TFormat(v, spec))

    if scalar_render(ty)
        return cx.err(span, s"format '$spec' expects a string, but the value has type " +
                      type_show(ty))

    TExpr(span, TFormat(str_render(cx, span, v), spec))
end format_call

// What a plain alias stands for, where the resolution has already made it real.
//
// **A plain alias records the base type ITSELF** rather than a `Constrained` record over it, which
// is what makes it transparent: there is no check to carry and nothing to be a second name for.
private behind_alias(cx: &Analyzer, key: string) -> Option[Type] =
    cx.an.tables.constrained_insts.get(key)

private constrained_call(cx: &Analyzer, span: Span, key: string, written: string,
                         args: Buf[Expr]) -> TExpr
    val inst = cx.an.tables.constrained_insts.get(instance_key(key, buf()))

    if inst.is_none() then
        return cx.err(span, s"'$written' is an alias, and an alias is not something that is called")

    val target = inst.unwrap()

    if args.len() != 1 then
        return cx.err(span, s"a conversion to '$written' takes one value, and " +
                      s"${quantity(args.len(), "argument")} " +
                      s"${if args.len() == 1 then "was" else "were"} given")

    target match
        Constrained(d) ->
            val t = type_expr(cx, args.at(0), Some(d.base))

            if disagree(texpr_type(t), d.base) then
                val converted = convert_to(cx, span, t, d.base, Some(written))

                return TExpr(span, TConstrainedCheck(converted, target))

            TExpr(span, TConstrainedCheck(t, target))
        _ -> bad_expr(span)
end constrained_call

// A variant with what it carries.
private variant_call(cx: &Analyzer, span: Span, en: Type, v: EnumVariant,
                     args: Buf[Expr]) -> TExpr
    if args.len() != v.fields.len() then
        return cx.err(span, s"variant '${v.name}' has ${quantity(v.fields.len(), "field")}, but " +
                      s"${quantity(args.len(), "value")} " +
                      s"${if args.len() == 1 then "was" else "were"} given")

    var ts: Buf[TExpr] = buf()

    for i in 0..<args.len()
        val want = v.fields.at(i).1
        val t = type_expr(cx, args.at(i), Some(want))

        if disagree(texpr_type(t), want) then
            cx.fault(args.at(i).span, s"'${v.fields.at(i).0}' of '${v.name}' is " +
                     s"${type_show(want)}, but ${type_show(texpr_type(t))} was given")

        ts.push(t)

    TExpr(span, TEnumNew(en, v, ts))
end variant_call

// A **generic** enum's variant, at the arguments the values it carries determine.
//
// Nothing for an enum that takes no type parameters, which leaves the ordinary lookup to answer:
// there the registered instantiation is the only one there could be.
private variant_solved(cx: &Analyzer, span: Span, name: string,
                       args: Buf[Expr]) -> Option[(Type, EnumVariant)]
    for i in 0..<cx.an.tables.types.len()
        val key = cx.an.tables.types.key_at(i)
        val decl = cx.an.tables.types.at(i)

        decl.kind match
            EnumOf(ed) ->
                if !ed.tparams.is_empty() && reachable_key(cx.an, key, cx.scope) &&
                        visible_here(cx, key)
                    val found = variant_decl_named(ed, name)

                    if found.is_some()
                        val made = variant_instance(cx, span, key, decl.scope, ed, found.unwrap(),
                                                    args)

                        if made.is_some() then return made
            _ -> ()

    None
end variant_solved

private variant_decl_named(ed: EnumDecl, name: string) -> Option[EnumVariantDecl]
    for i in 0..<ed.variants.len()
        if ed.variants.at(i).name == name then return Some(ed.variants.at(i))

    None
end variant_decl_named

private variant_instance(cx: &Analyzer, span: Span, key: string, home: Scope, ed: EnumDecl,
                         vd: EnumVariantDecl, args: Buf[Expr]) -> Option[(Type, EnumVariant)]
    if args.len() != vd.fields.len() then return None

    var field_refs: Buf[TypeRef] = buf()

    for i in 0..<vd.fields.len()
        field_refs.push(vd.fields.at(i).typ)

    var prov: Buf[Type] = buf()
    var soft: Buf[bool] = buf()

    for i in 0..<args.len()
        val t = sandboxed_read(cx, args.at(i), None)

        prov.push(texpr_type(t))
        soft.push(adaptable(args.at(i), t))

    val mark = cx.an.complaints()
    val targs = solve(cx.an, home, span, key, ed.tparams, field_refs, prov, None, None, soft,
                      ed.bounds, buf())

    cx.an.restore_complaints(mark)

    for i in 0..<targs.len()
        if targs.at(i) == Unknown then return None

    reinstantiate(cx.an, key, targs) match
        Enum(d) ->
            val v = d.variant(vd.name)

            if v.is_none() then return None

            Some((Enum(d), v.unwrap()))
        _ -> None
end variant_instance

// The same where the enum is **generic**: the name in front of the dot says which enum, and the
// values say which instantiation of it.
private qualified_variant_solved(cx: &Analyzer, span: Span, receiver: Expr, member: string,
                                 args: Buf[Expr],
                                 expected: Option[Type]) -> Option[(Type, EnumVariant)]
    val written = *receiver.kind match
        Ident(n) -> if cx.lookup(n).is_none() then Some(n) else None
        _ -> None

    if written.is_none() then return None

    val key = lookup_type_key(cx.an, cx.scope, written.unwrap())

    if key.is_none() then return None

    val decl = cx.an.tables.types.get(key.unwrap())

    if decl.is_none() then return None

    decl.unwrap().kind match
        EnumOf(ed) ->
            if ed.tparams.is_empty() then return None

            val found = variant_decl_named(ed, member)

            if found.is_none() then return None

            // The position is trusted first, since it says outright which instantiation is wanted.
            val wanted = variant_from_expected(cx, member, expected)

            if wanted.is_some() then return wanted

            variant_instance(cx, span, key.unwrap(), decl.unwrap().scope, ed, found.unwrap(), args)
        _ -> None
end qualified_variant_solved

// A variant named through its enum, where the name in front of the dot stands for one.
private qualified_variant(cx: &Analyzer, receiver: Expr, member: string) -> Option[(Type, EnumVariant)]
    val subject = subject_named(cx, receiver)

    if subject.is_none() then return None

    subject.unwrap() match
        Enum(d) ->
            val v = d.variant(member)

            if v.is_none() then return None

            Some((subject.unwrap(), v.unwrap()))
        _ -> None
end qualified_variant

// -- a call of a declared function ----------------------------------------------------------------

// The keys the declarations of one written name are filed under, in the reader's own terms.
function_keys(cx: &Analyzer, written: string) -> Buf[string]
    val found = function_keys_of(cx, written)

    if !found.is_empty() then depends_on(cx.an, cx.scope.module_name, found.at(0))

    found
end function_keys

private function_keys_of(cx: &Analyzer, written: string) -> Buf[string]
    // A module bound to a name is written before a dot, so `unicode.is_alpha` is the module's key
    // and the name after it. It is asked first, since the alias is what the file said the word
    // means.
    val through = module_bound_key(cx, written)

    if through.is_some()
        val set = overload_keys(cx.an, through.unwrap())

        if !set.is_empty() then return set
    end if

    val bound = cx.scope.imports.name_key(written)

    if bound.is_some() then
        val set = overload_keys(cx.an, bound.unwrap())

        if !set.is_empty() then return set

    // The reader's own module, and only the declarations of it the reader's file may name.
    //
    // **A file-private declaration of ANOTHER file is not in the set at all**, which is what keeps a
    // helper one file kept to itself from deciding what a name means everywhere else in the module.
    // Where the whole set is out of reach it is still the right answer to end on -- a call of a name
    // that is genuinely private somewhere else should say so rather than say it does not exist -- so
    // it is held back and used only when nothing else answered.
    // This file's own file-private declaration of the spelling comes before the module's plain key,
    // where a sibling file took that one first.
    val here = file_private_key(cx.an, cx.scope.src.name, module_qualify(cx.scope.module_name,
                                                                        written))
    val mine = visible_keys(cx, overload_keys(cx.an, here))

    if !mine.is_empty() then return mine

    for i in 0..<cx.scope.imports.wildcards.len()
        val key = module_qualify(cx.scope.imports.wildcards.at(i), written)
        val set = overload_keys(cx.an, key)

        if !set.is_empty() && reachable_key(cx.an, set.at(0), cx.scope) then return set

    // A written module path is already a key.
    val dotted = overload_keys(cx.an, written)

    if !dotted.is_empty() then return dotted

    // **A module may be written out in full at the call**, `sysl.slices.equal(a, b)`, which is a
    // module path and a name and not a member reached on a value. The cut is at the LAST dot,
    // because everything before it is the module and a module name holds as many dots as it likes.
    // It is asked last, so a name the file already has a meaning for keeps it.
    val cut = last_dot_in(written)

    if cut.is_some()
        val head = written[0..<cut.unwrap()]
        val tail = written[(cut.unwrap() + 1)..<written.bytes.len]
        val aliased = cx.scope.imports.module_as(head)

        if aliased.is_some()
            val set = overload_keys(cx.an, module_qualify(aliased.unwrap(), tail))

            if !set.is_empty() then return set
        end if

        val set = overload_keys(cx.an, module_qualify(in_package(cx.an, cx.scope.pkg, head), tail))

        if !set.is_empty() then return set
    end if

    overload_keys(cx.an, here)
end function_keys_of

// Every key a written **dotted** path could name, in the order a call asks them: the alias an
// import bound, then the path written out in full, read through the package the file sits in.
//
// **It is here rather than beside the value tables because the call path is where these three
// readings were worked out**, and a value read through a module has to ask exactly the same
// questions -- `raw.eof` and `raw.thing()` differ in nothing but the parentheses. Splitting them
// left a call resolving and a constant of the same module reported as an undefined name, which is
// what every `c const` binding in the org tripped over.
//
// A name with no dot in it answers nothing, so an ordinary lookup pays for this in one comparison.
module_qualified_keys(cx: &Analyzer, written: string) -> Buf[string]
    var out: Buf[string] = buf()

    module_bound_key(cx, written) match
        Some(key) -> out.push(key)
        None -> ()

    // **The cut is at the LAST dot**, because everything before it is the module and a module name
    // holds as many dots as it likes.
    val cut = last_dot_in(written)

    if cut.is_some()
        val head = written[0..<cut.unwrap()]
        val tail = written[(cut.unwrap() + 1)..<written.bytes.len]

        cx.scope.imports.module_as(head) match
            Some(owner) -> out.push(module_qualify(owner, tail))
            None -> ()

        out.push(module_qualify(in_package(cx.an, cx.scope.pkg, head), tail))
    end if

    out
end module_qualified_keys

// The declarations of a set the reader's own file may name.
private visible_keys(cx: &Analyzer, keys: Buf[string]) -> Buf[string]
    var out: Buf[string] = buf()

    for i in 0..<keys.len()
        if reachable_key(cx.an, keys.at(i), cx.scope) then out.push(keys.at(i))

    out
end visible_keys

// The key a dotted name spells where its head is a module the file bound a name to.
private module_bound_key(cx: &Analyzer, written: string) -> Option[string]
    val at = first_dot_in(written)

    if at.is_none() then return None

    val head = written[0..<at.unwrap()]
    val rest = written[(at.unwrap() + 1)..<written.bytes.len]
    val owner = cx.scope.imports.module_as(head)

    if owner.is_none() || first_dot_in(rest).is_some() then return None

    Some(module_qualify(owner.unwrap(), rest))
end module_bound_key

// Where the first dot of a name is, if it has one.
private first_dot_in(name: string) -> Option[usize]
    val bytes = name.bytes

    for i in 0..<bytes.len
        if bytes[i] == u8('.') then return Some(i)

    None
end first_dot_in

// A call of a function this compilation knows by key.
//
// **Which declaration a call means is decided by its arguments**, so a name with more than one
// declaration is resolved by trying each with everything it says put back, and taking the one that
// fits. A name with one declaration is read directly, which is what makes its diagnostic name the
// parameter rather than the set.
private function_call(cx: &Analyzer, span: Span, written: string, args: Buf[Expr],
                      expected: Option[Type]) -> TExpr
    val keys = function_keys(cx, written)

    if keys.is_empty() then
        val ext = extern_key(cx, written)

        if ext.is_some() then return extern_call(cx, span, written, ext.unwrap(), args)

        return cx.err(span, s"undefined function '$written'")

    if keys.len() == 1 then return call_key(cx, span, written, keys.at(0), args, expected, true)

    var fitting: Buf[string] = buf()

    for i in 0..<keys.len()
        // **A CANDIDATE THAT WAS NOT CHOSEN BUILT NOTHING.** Reading a call against a declaration
        // asks for whatever that declaration would need -- an instantiation of a generic `copy[T]`
        // at the very call a written-out `copy` on bytes wins -- and the chosen one is read again
        // from scratch. So the whole trial is rewound, not only what it had to say: a name a
        // discarded reading registered is a body the program never calls.
        val mark = cx.an.complaints()
        val sandbox = cx.an.sandboxed()
        val queued = cx.an.tables.members.pending.len()
        val tables = cx.an.tables.members.vtables.len()
        val trial = call_key(cx, span, written, keys.at(i), args, expected, false)
        val said = cx.an.complaints() > mark

        cx.an.release(sandbox)
        rewind_instantiations(cx.an, queued, tables)
        cx.an.restore_complaints(mark)

        if !said then fitting.push(keys.at(i))

    val chosen = narrowed(cx, fitting)

    if chosen.is_none() then
        return cx.err(span, s"no '$written' takes these arguments — the declarations of that name " +
                      s"are:\n${signature_list(cx, keys)}")

    call_key(cx, span, written, chosen.unwrap(), args, expected, true)
end function_call

// Which of the declarations a call fits is the one meant.
//
// **A declaration written out beats one a type parameter covers**, which is the whole of what a
// specialization is for: the library declares `copy[T](dst: []T, src: []const T)` and then
// `copy(dst: []u8, src: []const u8)` beside it, and a call on bytes means the second. Both fit, so
// order alone would answer with whichever was written first.
private narrowed(cx: &Analyzer, fitting: Buf[string]) -> Option[string]
    if fitting.is_empty() then return None
    if fitting.len() == 1 then return Some(fitting.at(0))

    var spelled: Buf[string] = buf()

    for i in 0..<fitting.len()
        val f = cx.an.tables.funcs.get(fitting.at(i))

        if f.is_some() && f.unwrap().decl.tparams.is_empty() then spelled.push(fitting.at(i))

    if spelled.len() == 1 then return Some(spelled.at(0))

    Some(fitting.at(0))
end narrowed

// The declarations of one name, as a reader would write them.
private signature_list(cx: &Analyzer, keys: Buf[string]) -> string
    var out = ""

    for i in 0..<keys.len()
        val f = cx.an.tables.funcs.get(keys.at(i)).unwrap()
        var params = ""

        for j in 0..<f.decl.params.len()
            val p = f.decl.params.at(j)

            if j > 0 then params = params + ", "

            params = params + s"${p.name}: ${type_show(param_type(cx, f, p))}"

        out = out + s"    ${f.decl.name}($params)"

        if i + 1 < keys.len() then out = out + "\n"

    out
end signature_list

// The type a parameter was declared at, in the terms of the file that declared it.
param_type(cx: &Analyzer, f: Func, p: Param) -> Type =
    resolve_type(cx.an, f.scope, p.typ, stand_ins(f.decl.tparams))

// One candidate, with its arguments bound and checked.
private call_key(cx: &Analyzer, span: Span, written: string, key: string, args: Buf[Expr],
                 expected: Option[Type], report: bool) -> TExpr
    val f = cx.an.tables.funcs.get(key).unwrap()

    // A generic call works its type arguments out from what it supplies, makes the instantiation
    // real, and checks the arguments against the signature that instantiation has.
    if !f.decl.tparams.is_empty() then
        return generic_call(cx, span, written, key, f, args, expected, report)

    val bound = bind_arguments(cx, span, written, f, args, report)

    if bound.is_none() then return bad_expr(span)

    // An `extern` is declared in the output only if something reaches it, which is what keeps an
    // unused one -- the library's `exit`, in a program that never panics -- out of the module.
    //
    // **Recorded before the arguments are analyzed**, which is what puts `take` in front of `give`
    // in `take(give())`: this order is the order the `declare` lines come out in.
    if cx.an.tables.externs.has(key) then cx.an.uses_extern(key)

    val slots = bound.unwrap()
    var ts: Buf[TExpr] = buf()

    for i in 0..<slots.len()
        val p = f.decl.params.at(i)
        val want = param_type(cx, f, p)

        slots.at(i) match
            Some(e) ->
                val t = type_expr(cx, e, Some(want))

                if disagree(texpr_type(t), want) then
                    cx.fault(e.span, s"'${p.name}' of '$written' is ${type_show(want)}, but " +
                             s"${type_show(texpr_type(t))} was given")

                ts.push(t)
            // A parameter's default, spliced in where the argument was not written. It is analyzed
            // in the declaration's own terms and with nothing local in scope, which is what makes
            // it mean the same thing from every module that calls the function -- and what makes a
            // default of `__LINE__` name the caller's line.
            None ->
                val inner = analyzer_for(cx.an, f.scope)

                inner.reported = Some(span)
                inner.here_src = caller_source(cx)
                ts.push(type_expr(inner, p.default.unwrap(), Some(want)))

    val ret = declared_result(cx, f.scope, f.decl.ret_type)

    cx.an.uses(key)
    TExpr(span, TCall(key, ts, ret, false))
end call_key

// Which written argument fills which parameter.
//
// **A named argument may be written for any parameter, not only one with a default**, and a
// parameter left unfilled is an error unless it has one.
bind_arguments(cx: &Analyzer, span: Span, written: string, f: Func, args: Buf[Expr],
                       report: bool) -> Option[Buf[Option[Expr]]]
    val params = f.decl.params
    var slots: Buf[Option[Expr]] = buf()

    for i in 0..<params.len()
        slots.push(None)

    var next: usize = 0
    var unknown_name = false
    var extra: usize = 0

    for i in 0..<args.len()
        val a = args.at(i)

        *a.kind match
            NamedArg(name, value) ->
                val idx = param_index(params, name)

                if idx < 0
                    if report then
                        cx.fault(a.span, s"function '$written' declares no parameter named " +
                                 s"'$name' — it takes ${name_list(params)}")
                    else
                        cx.fault(a.span, "no such parameter")

                    unknown_name = true
                else
                    slots.set(usize(idx), Some(value))
            _ ->
                if next >= params.len() then extra += 1
                else
                    slots.set(next, Some(a))
                    next += 1

    if unknown_name then return None

    var missing: usize = 0

    for i in 0..<params.len()
        if slots.at(i).is_none() && params.at(i).default.is_none() then missing += 1

    if missing > 0 || extra > 0
        if report then
            cx.fault(span, s"function '$written' takes ${quantity(params.len(), "argument")}, but " +
                     s"${quantity(args.len(), "argument")} " +
                     s"${if args.len() == 1 then "was" else "were"} given")
        else
            cx.fault(span, "wrong arity")

        return None
    end if

    Some(slots)
end bind_arguments

private param_index(params: Buf[Param], name: string) -> int
    for i in 0..<params.len()
        if params.at(i).name == name then return int(i)

    -1
end param_index

private name_list(params: Buf[Param]) -> string
    var out = ""

    for i in 0..<params.len()
        if i > 0 then
            out = out + (if i + 1 == params.len() then " and " else ", ")

        out = out + s"'${params.at(i).name}'"

    out
end name_list

// -- the calls a later stage resolves --------------------------------------------------------------

private extern_key(cx: &Analyzer, written: string) -> Option[string]
    val bound = cx.scope.imports.name_key(written)

    if bound.is_some() && cx.an.tables.externs.has(bound.unwrap()) then return bound

    // **A module written before the dot**, which a call to a *function* has always asked for and a
    // call to an `extern` did not -- so `c.surface_destroy(h)`, which is what every binding in the
    // org writes next door to its `c` module, reported the module as an undefined name.
    val qualified = module_qualified_keys(cx, written)

    for i in 0..<qualified.len()
        if cx.an.tables.externs.has(qualified.at(i)) then return Some(qualified.at(i))

    val here = module_qualify(cx.scope.module_name, written)

    if cx.an.tables.externs.has(here) then return Some(here)

    var found: Option[string] = None

    for i in 0..<cx.scope.imports.wildcards.len()
        val key = module_qualify(cx.scope.imports.wildcards.at(i), written)

        if found.is_none() && cx.an.tables.externs.has(key) then found = Some(key)

    found
end extern_key

// An `extern` is declared rather than defined, so its parameters are read off the declaration and
// its arguments are checked against them exactly as a function's are.
private extern_call(cx: &Analyzer, span: Span, written: string, key: string,
                    args: Buf[Expr]) -> TExpr
    val d = cx.an.tables.externs.get(key).unwrap()
    val scope = extern_scope(cx, key)
    var ts: Buf[TExpr] = buf()

    if !d.variadic && args.len() != d.params.len() then
        return cx.err(span, s"function '$written' takes ${quantity(d.params.len(), "argument")}, " +
                      s"but ${quantity(args.len(), "argument")} " +
                      s"${if args.len() == 1 then "was" else "were"} given")

    // **Recorded before the arguments are analyzed**, which is what puts `take` in front of `give`
    // in `take(give())`: this order is the order the `declare` lines come out in.
    cx.an.uses_extern(key)

    for i in 0..<args.len()
        if i < d.params.len() then
            val want = resolve_type(cx.an, scope, d.params.at(i).typ, no_bindings())
            val t = type_expr(cx, args.at(i), Some(want))

            if disagree(texpr_type(t), want) then
                cx.fault(args.at(i).span, s"'${d.params.at(i).name}' of '$written' is " +
                         s"${type_show(want)}, but ${type_show(texpr_type(t))} was given")

            ts.push(t)
        else
            ts.push(type_expr_bare(cx, args.at(i)))

    val ret = declared_result(cx, scope, d.ret_type)

    cx.an.uses(key)
    TExpr(span, TCall(key, ts, ret, false))
end extern_call

// The file an `extern` was written in, which is where the types in its signature mean what they
// meant.
//
// **It used to be searched for in `funcs`, where an `extern` never is**, so every call resolved the
// declaration's types in the CALLER's file and fell back to the caller's scope without saying so.
// That was invisible while the only reachable extern was one of the caller's own module -- the two
// scopes agree there -- and became `'x' of 'c.f' is *?` the moment a call could reach one next door,
// since an opaque struct declared in the `c` module is not a name the layer above it can resolve.
private extern_scope(cx: &Analyzer, key: string) -> Scope =
    cx.an.tables.extern_scopes.get(key) match
        Some(home) -> home.scope
        None -> cx.scope

// A local holding something callable, called through it.
private call_through(cx: &Analyzer, span: Span, name: string, args: Buf[Expr],
                     expected: Option[Type]) -> TExpr
    val local = cx.lookup(name).unwrap()

    local.ty match
        CFn(params, ret) ->
            var ts: Buf[TExpr] = buf()

            for i in 0..<args.len()
                val want = if i < params.len() then Some(params.at(i)) else None

                ts.push(type_expr(cx, args.at(i), want))

            TExpr(span, TCallPtr(TExpr(span, TLoad(local.unique, local.ty)), ts, params, *ret))
        // Everything else is called through the call trait its type implements, which makes it the
        // ordinary method call it looks like: a bare-arrow parameter is a direct call and a `&Fn`
        // field an indirect one, with nothing here choosing between them -- the receiver decides,
        // exactly as it does everywhere.
        _ ->
            if callable_of(cx.an, local.ty).is_none() then
                return cx.err(span, s"'$name' holds ${type_show(local.ty)}, which is not " +
                              "something that can be called")

            val read = cx.capture_read(local.unique)
            var recv = TExpr(span, TLoad(local.unique, local.ty))

            if read.is_some() then recv = read.unwrap()

            call_member(cx, span, recv, "call", args, expected)
end call_through

// The type a declaration hands back, which is `unit` where nothing was written.
declared_result(cx: &Analyzer, scope: Scope, written: Option[TypeRef]) -> Type
    if written.is_none() then return Unit

    resolve_type(cx.an, scope, written.unwrap(), no_bindings())
end declared_result

// -- `?` -------------------------------------------------------------------------------------------

// `?` -- the failure of a result handed straight back to this function's caller.
//
// **The enclosing function's return type must be able to carry the failure**, and the two channels
// do not cross: an `Option`'s `?` cannot early-return from a `Result`-returning function.
try_expr(cx: &Analyzer, span: Span, inner: Expr, expected: Option[Type]) -> TExpr
    val t = type_expr_bare(cx, inner)
    val ty = texpr_type(t)

    if ty == Unknown then return t

    val parts = fallible_parts(ty)

    if parts.is_none() then
        return cx.err(span, s"'?' unwraps a ${module_show(option_key())} or a " +
                      s"${module_show(result_key())}, and ${type_show(ty)} is neither")

    if cx.ret_ty.is_none() then
        return cx.err(span, s"'?' may only be used in a function returning " +
                      s"${module_show(base_of(ty))}, not unit")

    val (ok, fail, value) = parts.unwrap()
    val ret = cx.ret_ty.unwrap()

    if base_of(ret) != base_of(ty) then
        return cx.err(span, s"'?' may only be used in a function returning " +
                      s"${module_show(base_of(ty))}, not ${type_show(ret)}")

    val ret_parts = fallible_parts(ret)

    if ret_parts.is_none() then return bad_expr(span)

    val (_, ret_fail, _) = ret_parts.unwrap()

    // Where the two error types differ, `?` converts through `From`.
    //
    // **The conversion is looked up rather than written**, which is the whole of what it buys: every
    // layer of a program otherwise writes `.map_err(...)` at each call that crosses between two
    // error types. What is found here is the concrete function the `impl` lowered to, and the
    // lowering splices a call to it between unwrapping the failure and re-wrapping it.
    var convert: Option[string] = None

    if !type_eq(carried(fail), carried(ret_fail))
        convert = from_conversion(cx.an, carried(fail), carried(ret_fail))

        if convert.is_none()
            return cx.err(span, s"'?' propagates a ${type_show(carried(fail))} error, but this " +
                          s"function returns ${type_show(carried(ret_fail))} — a '?' converts " +
                          s"through '${module_show(from_key())}', so " +
                          s"'impl ${module_bare(from_key())}[${type_show(carried(fail))}] for " +
                          s"${type_show(carried(ret_fail))}' is what joins the two layers")

        cx.an.uses(convert.unwrap())
    end if

    TExpr(span, TTry(t, ok, fail, ret, ret_fail, value, convert))
end try_expr

// The library's `From`, whose one member is what a `?` across two error types goes through.
private from_key() -> string = module_qualify(StdModule, "From")

// The `From[from]` conversion into `to`, as the name of the function that performs it.
//
// **A type may implement `From` several times over**, so the answer is not "the member called
// `from`" -- it is the overload slot whose one parameter is the source type and whose result is the
// destination. That is the same question a written call answers with its argument, asked here with a
// type instead, because a `?` has no argument written anywhere for the ordinary path to read.
//
// The trait is checked as well as the shape: an inherent `from` of the right signature is a function
// that happens to be spelled the same, and reading it would make `?` convert through something
// nobody declared a conversion.
private from_conversion(a: &Analysis, from: Type, to: Type) -> Option[string]
    val owner = member_key(a, to, "from").0
    val slots = a.tables.members.alts.get(member_key_of(owner, "from")).unwrap_or(one_name("from"))

    for i in 0..<slots.len()
        val filed = member_key_of(owner, slots.at(i))

        if a.tables.members.from_trait.get(filed).unwrap_or("") == from_key()
            val decl = a.tables.members.decls.get(filed)

            if decl.is_some() && decl.unwrap().receiver.is_none() && !decl.unwrap().is_property
                val fname = a.tables.members.funcs.get(filed)

                if fname.is_some()
                    val sig = a.tables.members.func_insts.get(fname.unwrap())

                    if sig.is_some() && sig.unwrap().params.len() == 1 &&
                       type_eq(sig.unwrap().params.at(0).1, from) && type_eq(sig.unwrap().ret, to)
                        return fname

    None
end from_conversion

private one_name(name: string) -> Buf[string]
    var out: Buf[string] = buf()

    out.push(name)
    out
end one_name

// The two variants a `Result` or an `Option` is made of, and the type its success carries.
private fallible_parts(t: Type) -> Option[(EnumVariant, EnumVariant, Type)]
    repr(t) match
        Enum(d) ->
            val base = d.base

            if base != option_key() && base != result_key() then return None

            val some = if base == option_key() then d.variant("Some") else d.variant("Ok")
            val none = if base == option_key() then d.variant("None") else d.variant("Err")

            if some.is_none() || none.is_none() then return None

            Some((some.unwrap(), none.unwrap(), carried(some.unwrap())))
        _ -> None
end fallible_parts

private carried(v: EnumVariant) -> Type =
    if v.fields.is_empty() then Unit else v.fields.at(0).1

private base_of(t: Type) -> string = repr(t) match
    Enum(d) -> d.base
    _ -> ""

private option_key() -> string = module_qualify("sysl", "Option")
private result_key() -> string = module_qualify("sysl", "Result")

// `old(e)` -- the value an expression had when the call started. The expressions are collected in
// the order they were written, and the node holds the slot rather than the expression, because what
// the emitter has to do is snapshot each one on entry.
private old_call(cx: &Analyzer, span: Span, args: Buf[Expr]) -> TExpr
    if args.len() != 1 then
        return cx.err(span, s"'old' takes exactly one argument, but got ${args.len()}")

    val te = type_expr_bare(cx, args.at(0))

    if texpr_type(te) == Unit then
        return cx.err(span, "'old' needs a value to remember, but its argument is unit")

    var held = cx.olds.unwrap()
    val idx = held.len()

    held.push(te)
    cx.olds = Some(held)
    TExpr(span, TOld(int(idx), texpr_type(te)))
end old_call

// A leading dot's call form: `.Circle(5)`, the qualified constructor with the enum's name left off.
implicit_call(cx: &Analyzer, span: Span, name: string, args: Buf[Expr],
              expected: Option[Type]) -> TExpr
    if expected.is_none() || expected.unwrap() == Unknown
        return cx.err(span, s"'.$name' is a member of whatever type the context expects, and " +
                      "nothing here expects one — write the type's own name in front of the dot. " +
                      "A trait object expects no single type either, since what may be erased into " +
                      "one is whatever implements the trait")

    val wanted = variant_from_expected(cx, name, expected)

    if wanted.is_some() then return variant_call(cx, span, wanted.unwrap().0, wanted.unwrap().1, args)

    enum_decl_of(cx, expected.unwrap()) match
        Some(base) -> cx.err(span, s"enum '${module_show(base)}' has no variant '$name'")
        None -> cx.err(span, s"'${type_show(expected.unwrap())}' is not an enum, and only a " +
                       "variant is reached with the type's own name left off")
end implicit_call
