// HMAC over any of the four, written once.
//
// The interesting part is not the construction — two hashes and two pads — but what it takes to
// say "a hash function" here. A trait would be the obvious way, and it is the wrong one: an
// implementation would have to hand back a *new* hasher, and a bound cannot promise a value any
// more than it can promise a constant. What works instead is that a hasher is an ordinary struct,
// so a started one is a value, and copying it is starting another. `proto` is that value, and the
// three hashes below are three copies of it.

hmac[T: Word + Add + BitAnd + BitOr + BitXor + Not + Shl + Shr + Sub](proto: Sha[T], key: []u8, msg: []u8) -> string
    var bs = proto.block_len()
    var n = proto.dlen
    var k: [128]u8

    // A key longer than a block is replaced by its own digest; a shorter one is padded with the
    // zeroes `k` already holds.
    if key.len > bs
        var h = proto
        var kd: [64]u8

        h.update(key)
        h.finish(kd[0..<n]).expect("a digest buffer sized from the hasher itself")

        for i in 0..<n do k[i] = kd[i]
    else
        for i in 0..<key.len do k[i] = key[i]

    var ipad: [128]u8
    var opad: [128]u8

    for i in 0..<bs
        ipad[i] = k[i] ^ 0x36
        opad[i] = k[i] ^ 0x5c

    var inner = proto
    var id: [64]u8

    inner.update(ipad[0..<bs])
    inner.update(msg)
    inner.finish(id[0..<n]).expect("a digest buffer sized from the hasher itself")

    var outer = proto
    var tag: []u8 = [0u8; 64]

    outer.update(opad[0..<bs])
    outer.update(id[0..<n])
    outer.finish(tag[0..<n]).expect("a digest buffer sized from the hasher itself")

    hex(tag[0..<n])
end hmac

hmac224(key: []u8, msg: []u8) -> string = hmac(new_sha224(), key, msg)
hmac256(key: []u8, msg: []u8) -> string = hmac(new_sha256(), key, msg)
hmac384(key: []u8, msg: []u8) -> string = hmac(new_sha384(), key, msg)
hmac512(key: []u8, msg: []u8) -> string = hmac(new_sha512(), key, msg)
