import sysl.buf.*
import sysl.slices.sort
// Sort a million pseudo-random elements, repeatedly.
var seed: u64 = 12345
var total: long = 0

for round in 0..<16
    var b: Buf[long] = buf()

    for i in 0..<1000000
        seed = seed * 6364136223846793005 + 1442695040888963407
        b.push(long(seed >> 33))

    sort(b.view_mut())
    total += b[0] + b[b.len() - 1] + b[b.len() / 2]

print(total)
