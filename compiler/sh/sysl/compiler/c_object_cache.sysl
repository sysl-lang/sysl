module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.container.{Set, set}
import sysl.env.get as env_var
import sysl.slices.sort
import sysl.process.capture
import sysl.fs.{current_dir, make_dir_all, read_bytes, read_text, remove_file, write_bytes,
                write_bytes_atomic, write_text_atomic}
import sysl.text.{from_utf8_unchecked, join, split, Search}

// Every C file a build compiles, compiled once and kept.
//
// A package's C, a `--lib` root's, the project's own and the standard module's when it is compiled
// from source are all compiled by `compile_c`, and before this every build compiled every one of them
// again -- a binding carrying a large vendored library paid for it on every edit to a line of sysl.
// **An object depends on nothing sysl-side**, so unlike a cache of compiled sysl this one needs no
// condition about what else the program declares: the object is a function of the C compiler, what
// it was told, and the bytes it read. That is the key.
//
// ==What the key is over==
//
// **A wrong key is a stale object linked into a program, which is worse than a slow build**, so
// everything that can reach the bytes is in it:
//
//   - the **C compiler**: the path it was run as and what its `--version` says, which names the
//     release and the directory it was installed in. `--cc`, and the NDK or wasi-sdk clang the
//     environment chose, are therefore both here without being named.
//   - **every argument it was given**: the target triple, the optimization level, the machine flags,
//     `SYSL_EXTRA_CFLAGS`, the headers and macros the command line supplied, a `pkg-config` probe's
//     answer and the package's own `defines`. They are hashed as the command line clang saw rather
//     than part by part, so a flag added to `compile_c` later is in the key without anybody
//     remembering to put it there.
//   - the **environment that reaches the toolchain** (`build_environment`), and the **working
//     directory** where a flag names a directory relative to it.
//   - the **source file**, by its path (it is what `__FILE__` expands to) and its bytes, and **every
//     file the preprocessor read to compile it**, by path and bytes.
//
// ==How a header edit is caught==
//
// **Which headers a file reads is known only after it has been compiled**, so the key is found in
// two steps, the way `ccache`'s direct mode finds its own. The first key is over everything but the
// files; under it is a list of the files the last compilation read, as clang's own `-MD` output named
// them. A lookup reads each of those files again and hashes them into the second key, under which
// the object is kept -- so an edit to any header the file includes, however deep, changes the second
// key and misses. A header that starts including another is itself an edit, and the recompilation it
// causes writes the new list.
//
// ==What a cached object has to prove==
//
// **An object is written with its length and its digest beside it**, both through a rename, and a hit
// reads the object and checks both before a byte of it is handed on. A build killed between the two
// writes, a disk that filled, a file somebody truncated: each is a miss and a recompilation rather than
// a broken link or, worse, a link that succeeds with the wrong code.
//
// ==What it does not cover, stated rather than hidden==
//
// A header **added** to a directory searched before the one the file was found in last time: nothing
// the previous compilation read has changed, so the lookup hits. `SYSL_NO_CACHE=1` is the escape
// hatch, as it is for the run cache. This is ccache's direct mode's limitation too, and it is left
// rather than closed because closing it exactly means replaying clang's search -- the including
// file's own directory, `-iquote`, `-I`, `-isystem`, the sysroot, frameworks, `#include_next` -- for
// every header a file reads, and an approximation of that is a key that looks complete and is not.
// `coc_a_header_added_earlier_on_the_path_is_not_noticed` shows it.

private const CacheOff: string = "SYSL_NO_CACHE"

// Bumped when what an entry holds changes shape, so an old entry reads as a miss.
private const Format: string = "cobj-1"

// A directory a test keeps its entries in, in place of the machine's cache. Empty is none.
private var c_object_home: string = ""

// How many compilations were answered from the cache, and how many ran clang, since the counts were
// last cleared -- what a test observes rather than a clock.
private var c_object_hits: int = 0
private var c_object_compiled: int = 0

// The last C compiler asked for its version, and what it said -- one question per compiler per
// process, a build compiling many files with one clang.
private var cc_asked: string = ""
private var cc_said: string = ""

// Keep the cache's objects under `dir` rather than the machine's cache directory, or go back to the
// machine's with `None`.
use_c_object_cache_dir(dir: Option[string])
    c_object_home = dir.unwrap_or("")
    c_objects_pending = ""
    c_objects_swept = false
    c_objects_in_use = set()

// `(hits, compilations)` since the last `clear_c_object_counts`.
c_object_counts() -> (int, int) = (c_object_hits, c_object_compiled)

clear_c_object_counts()
    c_object_hits = 0
    c_object_compiled = 0
    c_object_sweeps = 0

// Where objects are kept, or nothing where the cache is off or the machine has no cache directory.
private c_object_dir() -> Option[string]
    if env_var(CacheOff).unwrap_or("") != "" then return None
    if c_object_home != "" then return Some(s"$c_object_home/sysl/cobj")

    cache_directory() match
        Some(dir) -> Some(s"$dir/sysl/cobj")
        None -> None
end c_object_dir

// Compile `src` into `obj` with `args` (everything but the file and the output), from the cache where
// the same compilation has been made before.
//
// **With the cache off, the command line is exactly the one it always was**: `-MD` is added only
// where there is somewhere to keep what it says.
cached_c_compile(cc: string, src: string, obj: string, args: Buf[string]) -> Result[unit, ToolFault]
    val dir = c_object_dir() match
        Some(d) -> d
        None ->
            c_object_compiled += 1
            return told(cc, with_io(args, src, obj, None))

    val first = first_key(cc, src, args)
    val listed = s"$dir/$first.deps"

    // **A hit.** The list is what the last compilation read; every file on it is read again now.
    val known = read_text(listed) match
        Ok(text) -> second_key(first, split_lines(text))
        Err(_) -> None

    known match
        Some(second) ->
            if reuse(s"$dir/$second.o", obj)
                c_object_hits += 1
                in_use(s"$dir/$second.o", listed)

                // The files the kept object was compiled from are this build's inputs as surely as
                // if clang had just read them.
                note_files_read(split_lines(read_text(listed).unwrap_or("")))
                return Ok(())
        None -> ()

    val made = s"$obj.d"
    val before = file_digest(src)

    c_object_compiled += 1
    told(cc, with_io(args, src, obj, Some(made)))?

    val read = read_text(made) match
        Ok(text) -> depended_on(text)
        Err(_) -> buf()

    remove_file(made).unwrap_or(())
    note_files_read(read)

    // **A file edited while clang was reading it is not kept**: the object may be of either text,
    // and the key would claim the second.
    if read.len() == 0 || file_digest(src) != before then return Ok(())

    val second = second_key(first, read) match
        Some(k) -> k
        None -> return Ok(())

    keep(dir, s"$dir/$second.o", obj)

    // A list that cannot be written costs the next build its compilation and nothing else.
    write_text_atomic(listed, join(read.view(), "\n")).unwrap_or(())
    in_use(s"$dir/$second.o", listed)
    c_objects_pending = dir
    Ok(())
end cached_c_compile

// --- what a build's C read ---------------------------------------------------------------
//
// **Every file a C compilation of this build read, wherever it is** -- a header in an
// `--include-path` directory, one a package's `headers` variable named, one a `pkg-config` probe's
// `-I` reached, the SDK's own -- as clang's `-MD` list named them, for an object compiled now or
// taken from here, and for every `c const` probe (`c_probe.sysl`). The run cache and a source root's
// kept half key on these files' bytes the way this cache keys an object on them (`second_key`), so
// a header outside every tree the keys walk is an input like any other.

private var files_read: Buf[string] = buf()
private var files_read_seen: Set[string] = set()

// Files a compilation read, added to this build's list once each.
note_files_read(files: Buf[string])
    for f in files
        if f != "" && !files_read_seen.has(f)
            files_read_seen.add(f)
            files_read.push(f)
end note_files_read

// Where the list stands now, so a compilation inside the build can ask what it alone added.
files_read_mark() -> usize = files_read.len()

// What the build's C has read since `mark`.
files_read_since(mark: usize) -> Buf[string]
    var out: Buf[string] = buf()

    for i in mark..<files_read.len()
        out.push(files_read.at(i))

    out
end files_read_since

// A key over `first` and the bytes of every file a list names, as an object's second key is; nothing
// where one of them is gone, which is a miss.
files_key(first: string, files: Buf[string]) -> Option[string] = second_key(first, files)

// A list of files as it is kept on disk, one to a line, read back.
listed_files(text: string) -> Buf[string] = split_lines(text)

// What a compilation inside the build read, taken back off the list -- one whose product is keyed on
// its own (the standard module's artifact), so that the list is the same whether or not this build
// happened to make it.
drop_files_read_since(mark: usize)
    var kept: Buf[string] = buf()
    var seen: Set[string] = set()

    for i in 0..<mark
        kept.push(files_read.at(i))
        seen.add(files_read.at(i))

    files_read = kept
    files_read_seen = seen
end drop_files_read_since

// The list so far, sorted -- one order for one set of files, whatever order the compilations ran in.
files_read_sorted(mark: usize) -> Buf[string]
    var out = files_read_since(mark)

    sort(out.view())
    out
end files_read_sorted

// A new build starts a new list.
clear_files_read()
    files_read = buf()
    files_read_seen = set()
end clear_files_read

// --- codegen units -----------------------------------------------------------------------
//
// **A codegen unit's object is kept the same way and in the same directory**, under a key of its
// own shape: a unit reads no file but its text, so there is no second step -- the key is the C
// compiler, what it was told, the environment, and the text's bytes. A rebuild after an edit to one
// function recompiles the units whose text changed and takes the rest from here. The counts are kept
// apart from the C files', so each question is answered on its own.

private const UnitFormat: string = "cgu-1"

private var unit_hits: int = 0
private var unit_compilations: int = 0

// `(hits, compilations)` of codegen units since the last `clear_unit_object_counts`.
unit_object_counts() -> (int, int) = (unit_hits, unit_compilations)

clear_unit_object_counts()
    unit_hits = 0
    unit_compilations = 0

// Where the object of a unit with this text and these arguments is kept, or empty with the cache off.
unit_object_key(cc: string, ir: string, args: Buf[string]) -> string
    val dir = c_object_dir() match
        Some(d) -> d
        None -> return ""

    var parts: Buf[string] = buf()

    parts.push(UnitFormat)
    parts.push(cc)
    parts.push(cc_version(cc))
    parts.push(build_environment())
    parts.push(join(args.view(), "\0"))

    // The arguments name a profile by its path; what decides the object is what the profile says.
    parts.push(pipeline_key())
    parts.push(s"${ir.len}:${bytes_fingerprint(ir.bytes)}")

    s"$dir/${run_cache_key(parts)}.o"
end unit_object_key

// The kept object copied to `obj`, where there is a whole one.
unit_object_reused(cached: string, obj: string) -> bool
    if !reuse(cached, obj) then return false

    unit_hits += 1
    in_use(cached, cached)
    true
end unit_object_reused

// A unit was compiled by clang rather than taken from here.
unit_compiled()
    unit_compilations += 1

// The object just compiled for `cached`'s key, kept.
unit_object_kept(cached: string, obj: string)
    val dir = parent_of(cached).unwrap_or(".")

    keep(dir, cached, obj)
    in_use(cached, cached)
    c_objects_pending = dir
end unit_object_kept

// --- eviction ----------------------------------------------------------------------------
//
// **The run cache's policy, with the run cache's numbers** (`CacheKeep`, `CacheStale`, `CacheBytes`), so
// there is one rule to know about what the machine's cache keeps: nothing is removed for age until the
// directory holds `CacheKeep` objects, and then only what is older than `CacheStale`, measured against
// the newest entry rather than a clock; past `CacheBytes`, the oldest go until it fits, sparing the last
// hour's (`CacheFresh`). Age is what makes it safe beside another build using the directory.
//
// It runs once, when a build that missed at least once is done -- a build that hits everything lists
// nothing -- and two things are exempt from it:
//
//   - **what this process has used or made**, whatever its age: a build never evicts an object it
//     already linked from, nor the file list that found it. **A hit refreshes an object's age** (once per
//     file per process, `touch_used`), so the last hour is the last hour it was USED and the oldest
//     go first by least recent use: an object hit all week is never the one a concurrent build's
//     sweep takes, however long ago it was compiled.
//   - nothing else. **A half entry is garbage at any age** -- an object with no `.o.sum` beside it, or
//     a `.o.sum` with no object -- since a lookup reads it as a miss and nothing ever completes it. One
//     removed while another build is between its two renames costs that build's next compilation.

// The objects, and the file lists naming them, this process has used or made.
private var c_objects_in_use: Set[string] = set()

private in_use(object: string, listed: string)
    c_objects_in_use.add(object)
    c_objects_in_use.add(s"$object.sum")
    c_objects_in_use.add(listed)
    touch_used(object)
    touch_used(s"$object.sum")
    touch_used(listed)
end in_use

private used_here(one: string) -> bool = c_objects_in_use.has(one)

// **One sweep per process, after its compilations** -- `sweep_c_objects`, which the driver calls when
// a command line is answered. A miss only notes the directory; a sweep lists and stats every entry,
// and one per miss made a build of M files against a directory of N entries cost M x N.
private var c_objects_pending: string = ""
private var c_objects_swept: bool = false
private var c_object_sweeps: int = 0

// How many sweeps since the last `clear_c_object_counts` -- what a test counts.
c_object_sweep_count() -> int = c_object_sweeps

// The cache swept where this process missed and has not swept it yet, and no other process swept it
// in the last `SweepGap`.
sweep_c_objects()
    if c_objects_pending == "" || c_objects_swept then return

    val dir = c_objects_pending

    c_objects_pending = ""
    c_objects_swept = true

    if claim_sweep(dir) then evict_c_objects(dir)
end sweep_c_objects

// Half entries removed, then -- where `CacheKeep` objects are kept -- every entry older than
// `CacheStale` that this process has not used, then the oldest until the directory fits in
// `CacheBytes`. A failure is not the build's: the worst an unevicted cache costs is disk.
private evict_c_objects(dir: string)
    c_object_sweeps += 1

    val files = cache_files(dir) match
        Some(f) -> f
        None -> return

    var listed: Set[string] = set()
    var gone: Set[string] = set()
    var objects: usize = 0
    var now: long = 0

    for f in files
        listed.add(f.file)

        if f.modified > now then now = f.modified

    for f in files
        val one = f.file

        if one.ends_with(".o")
            if listed.has(s"$one.sum")
                objects += 1
            else if !used_here(one)
                remove_file(one).unwrap_or(())
                gone.add(one)
        else if one.ends_with(".o.sum")
            if !listed.has(one[0..<one.len - 4]) && !used_here(one)
                remove_file(one).unwrap_or(())
                gone.add(one)

    if objects >= CacheKeep
        for f in files
            if !gone.has(f.file) && !used_here(f.file) && now - f.modified > CacheStale
                remove_file(f.file).unwrap_or(())
                gone.add(f.file)

    trim_to_bound(files, &gone, (one) -> used_here(one), ".sum")
end evict_c_objects

private split_lines(text: string) -> Buf[string]
    var out: Buf[string] = buf()

    for line in split(text, "\n")
        out.push(line)

    out
end split_lines

// The command line: the arguments, where the dependency list goes, the file, and the object.
private with_io(args: Buf[string], src: string, obj: string, deps: Option[string]) -> Buf[string]
    var out: Buf[string] = buf()

    for arg in args
        out.push(arg)

    deps match
        Some(d) ->
            out.push("-MD")
            out.push("-MF")
            out.push(d)
        None -> ()

    out.push(src)
    out.push("-o")
    out.push(obj)
    out
end with_io

// The key over everything but the files the preprocessor read.
private first_key(cc: string, src: string, args: Buf[string]) -> string
    var parts: Buf[string] = buf()

    parts.push(Format)
    parts.push(cc)
    parts.push(cc_version(cc))
    parts.push(build_environment())
    parts.push(src)
    parts.push(join(args.view(), "\0"))

    // The arguments name a profile by its path; what decides the object is what the profile says.
    parts.push(pipeline_key())

    // **A relative `-I` is relative to where clang was started**, so the same command line from
    // another directory reads other headers under the same names.
    if names_relative_directory(args) then parts.push(current_dir().unwrap_or("?"))

    run_cache_key(parts)
end first_key

// The object's key: the first key and every file read, by path and by bytes -- or nothing where one of
// them is gone, which is a miss.
private second_key(first: string, files: Buf[string]) -> Option[string]
    var parts: Buf[string] = buf()

    parts.push(first)

    for f in files
        if f == "" then continue

        val digest = file_digest(f)

        if digest == "" then return None

        parts.push(f)
        parts.push(digest)

    Some(run_cache_key(parts))
end second_key

// A file's bytes as a digest and a length, or empty where it cannot be read.
private file_digest(f: string) -> string = read_bytes(f) match
    Ok(bytes) -> s"${bytes.len}:${bytes_fingerprint(bytes)}"
    Err(_) -> ""

// What the C compiler says it is. A compiler that will not say is keyed on its path alone, which is
// still a key: the compilation that follows fails in its own words.
private cc_version(cc: string) -> string
    if cc_asked == cc then return cc_said

    cc_said = capture(cc, ["--version"], "", [], true) match
        Ok(out) -> out.text
        Err(_) -> ""
    cc_asked = cc
    cc_said
end cc_version

// Whether any argument names a directory or file relative to the working directory.
names_relative_directory(args: Buf[string]) -> bool
    val takes: []const string = ["-I", "-iquote", "-isystem", "-idirafter", "-include", "-imacros",
                                 "-F", "-iframework", "--sysroot", "-isysroot"]

    for i in 0..<args.len()
        val a = args.at(i)

        for t in takes
            if a == t
                if i + 1 < args.len() && relative(args.at(i + 1)) then return true
            elif a.starts_with(t)
                val rest = a[t.len..]
                val named = if rest.starts_with("=") then rest[1..] else rest

                if relative(named) then return true

    false
end names_relative_directory

private relative(p: string) -> bool = p != "" && !p.starts_with("/")

// A cached object copied into place, where it is whole: its length and digest have to agree with the
// sidecar written beside it.
private reuse(cached: string, obj: string) -> bool
    val said = read_text(s"$cached.sum") match
        Ok(text) -> text
        Err(_) -> return false

    val bytes = read_bytes(cached) match
        Ok(b) -> b
        Err(_) -> return false

    if said != s"${bytes.len}:${bytes_fingerprint(bytes)}" then return false

    write_bytes(obj, bytes).is_ok()
end reuse

// The object just compiled, kept: the object first and its sidecar second, each through a rename, so
// a reader sees either nothing, an object with no sidecar (a miss), or both.
private keep(dir: string, cached: string, obj: string)
    make_dir_all(dir) match
        Err(_) -> return
        Ok(_) -> ()

    val bytes = read_bytes(obj) match
        Ok(b) -> b
        Err(_) -> return

    write_bytes_atomic(cached, bytes) match
        Err(_) -> return
        Ok(_) -> ()

    write_text_atomic(s"$cached.sum", s"${bytes.len}:${bytes_fingerprint(bytes)}").unwrap_or(())
end keep

// The files a Makefile rule written by `-MD` names as prerequisites: everything after the target's
// colon, with the line continuations joined and a backslash-escaped space kept inside its name.
depended_on(rule: string) -> Buf[string]
    var out: Buf[string] = buf()
    var word: Buf[u8] = buf()
    var past_target = false
    val b = rule.bytes
    var i: usize = 0

    while i < b.len
        val c = b[i]

        if c == u8('\\') && i + 1 < b.len && (b[i + 1] == u8('\n') || b[i + 1] == u8('\r'))
            i += 2
            flush_word(&word, &out, &past_target)
            continue

        if c == u8('\\') && i + 1 < b.len && (b[i + 1] == u8(' ') || b[i + 1] == u8('#'))
            word.push(b[i + 1])
            i += 2
            continue

        if c == u8('$') && i + 1 < b.len && b[i + 1] == u8('$')
            word.push(c)
            i += 2
            continue

        if c == u8(' ') || c == u8('\t') || c == u8('\n') || c == u8('\r')
            flush_word(&word, &out, &past_target)
        else
            word.push(c)

        i += 1

    flush_word(&word, &out, &past_target)
    out
end depended_on

private flush_word(word: *Buf[u8], out: *Buf[string], past_target: *bool)
    if word.len() == 0 then return

    // A fresh buffer rather than a cleared one: the text is read out of this one's storage.
    val text = from_utf8_unchecked(word.view())

    *word = buf()

    if *past_target
        out.push(text)
    elif text.ends_with(":")
        *past_target = true
end flush_word
