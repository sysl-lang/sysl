module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.text.{cstring, join, Search}
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture

// **A `&sync` release under ThreadSanitizer acquires with a load of the count, not a fence.**
//
// The release decrements with `release` ordering and, when it took the last share, acquires before
// freeing. A standalone `fence acquire` is the cheapest correct way to do that, and TSan does not
// model it: every `&sync` object whose last share is given back on another thread than the one that
// last touched it was reported as a race between that touch and the free. An acquire load of the
// count is what TSan does follow, so a thread-sanitized build gets that and every other build keeps
// the fence.

private extern "setenv" tsn_c_setenv(name: *u8, value: *u8, overwrite: int) -> int
private extern "unsetenv" tsn_c_unsetenv(name: *u8) -> int

private tsn_flags(value: string)
    val n = cstring("SYSL_EXTRA_CFLAGS")
    val v = cstring(value)

    tsn_c_setenv(n.ptr, v.ptr, 1)
end tsn_flags

private tsn_no_flags()
    val n = cstring("SYSL_EXTRA_CFLAGS")

    tsn_c_unsetenv(n.ptr)
end tsn_no_flags

private tsn_list(words: []const string) -> Buf[string]
    var out: Buf[string] = buf()

    for i in 0..<words.len
        out.push(words[i])

    out
end tsn_list

private tsn_ready() -> bool
    std_root() match
        Err(_) ->
            print("skipped: the standard module's source is not on this machine")
            return false
        Ok(_) -> ()

    if !clang_available()
        print("skipped: there is no clang on this machine")
        return false
    end if

    true
end tsn_ready

// The last share of `d` is given back by `start` on the main thread, after the spawned thread has
// read `d.value` and given back its own share; the flag between them is relaxed, so the only order
// TSan can see between the read and the free is the one the reference count makes.
private tsn_program() -> string = raw"""
    import sysl.sync.*
    import sysl.threads.*

    struct Data
        value: int

    struct Work
        held: Option[&sync Data]
        seen: int
        done: Atomic[int]

    touch(w: *Work)
        w.held match
            Some(d) -> w.seen = d.value
            None -> ()

        w.held = None
        w.done.store(1, Relaxed)

    start(w: *Work) -> Thread
        val d: &sync Data = Data(41)

        w.held = Some(d)

        val t = spawn(&touch, w).unwrap()

        while w.done.load(Relaxed) == 0
            yield_now()

        t

    var w = Work(None, 0, Atomic(0))
    var t = start(&w)

    t.join()
    print(w.seen + 1)
    """

private tsn_root() -> string
    val root = make_temp_dir("sysl-tsan-fence").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", tsn_program()).unwrap()
    root
end tsn_root

// What `emit-llvm` prints for the program under `flags`, or with none where empty.
private tsn_emitted(root: string, flags: string) -> string
    var lines: Buf[string] = buf()
    val sink = &lines

    if flags == "" then tsn_no_flags() else tsn_flags(flags)

    val code = run_cli(["sysl", "emit-llvm", s"$root/main.sysl"], (line) -> sink.push(line))

    tsn_no_flags()

    if code != 0 then return s"emit-llvm failed with $code: ${join(lines.view(), "\n")}"

    join(lines.view(), "\n")
end tsn_emitted

// --- which flags ask for it ------------------------------------------------------------------------

@test("thread sanitizing is asked for by -fsanitize=thread, alone or in a list")
tsn_thread_is_asked_for()
    assert(thread_sanitized(tsn_list(["-fsanitize=thread"])))
    assert(thread_sanitized(tsn_list(["-g", "-fsanitize=address,thread"])))
    assert(thread_sanitized(tsn_list(["-fsanitize=undefined", "-fsanitize=thread"])))

@test("and by nothing else: another sanitizer, a suppression, or no flags")
tsn_nothing_else_asks()
    assert(!thread_sanitized(tsn_list([])))
    assert(!thread_sanitized(tsn_list(["-fsanitize=address", "-g"])))
    assert(!thread_sanitized(tsn_list(["-fno-sanitize=thread"])))
    assert(!thread_sanitized(tsn_list(["-fsanitize=threads"])))

// --- the runtime text --------------------------------------------------------------------------------

@test("a plain build acquires with a fence before the free")
tsn_plain_build_keeps_the_fence()
    val text = arc_atomic(host_target(), false)

    assert(text.contains("reap:\n  fence acquire\n  call void @arc.reap(ptr %p)"), text)
    assert(!text.contains("load atomic"), text)

@test("a thread-sanitized build acquires with a load of the count it released")
tsn_tsan_build_loads_the_count()
    val text = arc_atomic(host_target(), true)
    val word = host_target().pointer_bits()

    assert(text.contains(s"reap:\n  %a = load atomic i$word, ptr %p acquire, align ${word / 8}\n" +
                         "  call void @arc.reap(ptr %p)"), text)
    assert(text.contains(s"atomicrmw sub ptr %p, i$word 1 release"), text)
    assert(!text.contains("fence"), text)

@test("on a 32-bit machine the load is as wide and as aligned as its count")
tsn_tsan_load_on_a_32_bit_target()
    val text = arc_atomic(target_named("thumbv7em-freestanding").unwrap(), true)

    assert(text.contains("%a = load atomic i32, ptr %p acquire, align 4\n"), text)
    assert(text.contains("atomicrmw sub ptr %p, i32 1 release"), text)
    assert(!text.contains("fence"), text)

// --- through the driver -------------------------------------------------------------------------------

@test("emit-llvm under -fsanitize=thread loads where a plain emit-llvm fences")
tsn_emit_llvm_follows_the_flag()
    if !tsn_ready() then return

    val root = tsn_root()
    val tsan = tsn_emitted(root, "-fsanitize=thread")
    val asan = tsn_emitted(root, "-fsanitize=address")
    val plain = tsn_emitted(root, "")

    remove_dir_all(root).unwrap_or(())

    assert(tsan.contains("load atomic i64, ptr %p acquire, align 8"), tsan)
    assert(!tsan.contains("fence acquire"), tsan)
    assert(asan.contains("fence acquire"), asan)
    assert(!asan.contains("load atomic i64, ptr %p acquire"), asan)
    assert(plain.contains("fence acquire"), plain)
    assert(!plain.contains("load atomic i64, ptr %p acquire"), plain)

// **The measurement.** Built by alpha.12, whose release fenced under TSan too, this program reports
// one race: the free in `start` against the decrement in `touch`. With the load it reports none.
@test("a &sync object freed on another thread than its last reader is a clean TSan run")
tsn_tsan_run_is_clean()
    if !tsn_ready() then return

    val root = tsn_root()
    val exe = s"$root/built"

    tsn_flags("-fsanitize=thread -g")

    val made = build_native_program(s"$root/main.sysl", None, None, DefaultOptimization, Some(exe))

    tsn_no_flags()

    made match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            assert(false, failure_text(why))
        Ok(_) -> ()

    val undefined = capture("nm", ["-u", exe], "", [], true) match
        Ok(out) -> out.text
        Err(_) -> ""
    val ran = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    assert(undefined.contains("__tsan_"), undefined)

    ran match
        Err(_) -> assert(false, "the program that was built could not be run")
        Ok(out) ->
            val said = out.text + out.err.unwrap_or("")

            assert(said.contains("42"), said)
            assert(!said.contains("ThreadSanitizer"), said)
