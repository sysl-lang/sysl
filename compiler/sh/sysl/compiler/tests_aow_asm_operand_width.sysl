module sh.sysl.compiler
@tests

import sh.sysl.parsing.source_of
import sysl.buf.{Buf, buf}
import sysl.text.Search

// An inline-assembly operand is spelled at its own width (`reference/inline-assembly.md`, "An
// operand is spelled at its width"): an AArch64 operand of 32 bits or fewer reaches the template
// through LLVM's `w` modifier, so `crc32cx {out}, {crc}, {word}` over a `u32` names `w` registers
// instead of the `x` ones the assembler refuses. Every other processor's template is unchanged,
// because LLVM already names an x86-64 register by its operand's type and RISC-V and Thumb registers
// have one name each. Each width is read off the LLVM text a named machine lowers it to.

// -- the harness ----------------------------------------------------------------------------------

private var aow_library_names: Buf[string] = buf()
private var aow_library_units: Buf[Buf[Program]] = buf()

private aow_library(t: Target) -> Buf[Program]
    for i in 0..<aow_library_names.len()
        if aow_library_names[i] == t.name then return aow_library_units[i]

    var out: Buf[Program] = buf()

    std_root() match
        Err(_) -> ()
        Ok(root) -> std_units(root, t) match
            Err(_) -> ()
            Ok(units) -> out = units

    aow_library_names.push(t.name)
    aow_library_units.push(out)
    out
end aow_library

private aow_ready() -> bool
    if std_root().is_err()
        print("skipped: the standard module's source is not on this machine")
        return false

    true

private aow_own(said: Buf[Placed]) -> Buf[Placed]
    var out: Buf[Placed] = buf()

    for err in errors_of(said)
        if !err.src.name.starts_with("library/") then out.push(err)

    out

// What a compilation came to on a machine: the first refusal, or nothing and its LLVM text.
private aow_build(text: string, machine: string) -> (string, string)
    val t = target_named(machine).unwrap()
    var units: Buf[Program] = buf()

    for item in aow_library(t)
        units.push(item)

    val parsed = parse(source_of("main.sysl", text), t)

    if !parsed.ok() then return (parsed.report.at(0).message, "")

    units.push(parsed.program)

    val done = analyze_produced(units, t, buf(), true)
    val early = aow_own(done.reported)

    if !early.is_empty() then return (analysis_report(early), "")

    val whole = program_of(done, done.main_module)
    var own: Buf[string] = buf()

    own.push("")

    val pr = post_analysis_checks(done.an, whole, own)
    val late = aow_own(done.an.diagnostics())

    if !late.is_empty() then return (analysis_report(late), "")

    ("", ir_print_module(codegen_with_gaps(prune(strip_tests(whole), own), t, pr).0))
end aow_build

private aow_ir(machine: string, text: string) -> string
    val b = aow_build(text, machine)

    assert(b.0 == "", s"expected the program to compile for $machine, and it was refused:\n${b.0}")
    b.1

private aow_says(text: string, part: string) = assert(text.contains(part), s"expected '$part' in:\n$text")

private aow_never_says(text: string, part: string) =
    assert(!text.contains(part), s"expected no '$part' in:\n$text")

// One copy through a register, for an operand of type `ty`, on every processor that has registers.
private aow_copy(ty: string) -> string =
    s"f(n: $ty) -> $ty\n" +
    s"    var v: $ty = n\n" +
    "    asm\n" +
    "        [x86_64, aarch64, thumb, riscv64, riscv32, craft]\n" +
    "            \"mov {v}, {n}\"\n" +
    "            in n : reg\n" +
    "            out v : reg\n" +
    "        [wasm32] unavailable \"no registers\"\n" +
    "    v\n" +
    "\n" +
    s"print(f(v0()))\n"

// A value of each type to hand `f`, so the call site needs no literal suffix.
private aow_with_value(ty: string, value: string) -> string =
    aow_copy(ty) + s"v0() -> $ty = $value\n"

// The `asm` call `f` lowers to, for an operand whose LLVM type is `lt`, spelled `spelled` for both
// of its two operands.
private aow_call(lt: string, out: string, inp: string) -> string =
    s"call $lt asm sideeffect \"mov $out, $inp\", \"=&r,r,~{memory},~{cc}\"($lt %"

private val aow_arm: string = "aarch64-macos"
private val aow_arm_linux: string = "aarch64-linux"
private val aow_intel: string = "x86_64-linux"
private val aow_thumb: string = "thumb-freestanding"
private val aow_risc: string = "riscv64-freestanding"

// -- AArch64 ----------------------------------------------------------------------------------------

@test("the survey's crc32cx: a u32 operand is a w register and the u64 one stays an x register")
aow_crc32cx_is_spelled_by_width()
    if !aow_ready() then return

    aow_says(aow_ir(aow_arm, raw"""
        step(crc: u32, word: u64) -> u32
            var out: u32 = 0
            asm
                [aarch64]
                    "crc32cx {out}, {crc}, {word}"
                    in crc : reg
                    in word : reg
                    out out : reg
                [x86_64, riscv64, riscv32, thumb, craft, wasm32] unavailable "not this test's business"
            out

        print(step(1, 2))
        """), "call i32 asm sideeffect \"crc32cx ${0:w}, ${1:w}, $2\", \"=&r,r,r,~{memory},~{cc}\"" +
              "(i32 %t1, i64 %t2)")
end aow_crc32cx_is_spelled_by_width

@test("on AArch64 every width up to 32 bits takes the w modifier")
aow_arm_narrow_widths_are_w()
    if !aow_ready() then return

    aow_says(aow_ir(aow_arm, aow_with_value("u8", "7")), aow_call("i8", "${0:w}", "${1:w}"))
    aow_says(aow_ir(aow_arm, aow_with_value("i8", "7")), aow_call("i8", "${0:w}", "${1:w}"))
    aow_says(aow_ir(aow_arm, aow_with_value("u16", "7")), aow_call("i16", "${0:w}", "${1:w}"))
    aow_says(aow_ir(aow_arm, aow_with_value("i16", "7")), aow_call("i16", "${0:w}", "${1:w}"))
    aow_says(aow_ir(aow_arm, aow_with_value("u32", "7")), aow_call("i32", "${0:w}", "${1:w}"))
    aow_says(aow_ir(aow_arm, aow_with_value("i32", "7")), aow_call("i32", "${0:w}", "${1:w}"))
    aow_says(aow_ir(aow_arm, aow_with_value("int", "7")), aow_call("i32", "${0:w}", "${1:w}"))
    aow_says(aow_ir(aow_arm, aow_with_value("u12", "7")), aow_call("i12", "${0:w}", "${1:w}"))
    aow_says(aow_ir(aow_arm, aow_with_value("bool", "true")), aow_call("i1", "${0:w}", "${1:w}"))
end aow_arm_narrow_widths_are_w

@test("on AArch64 a 64-bit operand and a pointer keep the x register LLVM prints by default")
aow_arm_wide_widths_are_x()
    if !aow_ready() then return

    aow_says(aow_ir(aow_arm, aow_with_value("u64", "7")), aow_call("i64", "$0", "$1"))
    aow_says(aow_ir(aow_arm, aow_with_value("i64", "7")), aow_call("i64", "$0", "$1"))
    aow_says(aow_ir(aow_arm, aow_with_value("usize", "7")), aow_call("i64", "$0", "$1"))

    val out = aow_ir(aow_arm, raw"""
        f(p: *u8) -> *u8
            var q = p
            asm
                [aarch64]
                    "mov {q}, {p}"
                    in p : reg
                    out q : reg
                [x86_64, riscv64, riscv32, thumb, craft, wasm32] unavailable "not this test's business"
            q

        static var spare: u8 = 0
        static var held: *u8 = &spare

        print(f(held) == held)
        """)

    aow_says(out, aow_call("ptr", "$0", "$1"))
    aow_never_says(out, ":w}")
end aow_arm_wide_widths_are_x

@test("the spelling follows the processor, not the system: AArch64 Linux spells it the same")
aow_arm_linux_is_the_same()
    if !aow_ready() then return

    aow_says(aow_ir(aow_arm_linux, aow_with_value("u32", "7")), aow_call("i32", "${0:w}", "${1:w}"))
    aow_says(aow_ir(aow_arm_linux, aow_with_value("u64", "7")), aow_call("i64", "$0", "$1"))

@test("one block mixing widths spells each operand at its own")
aow_mixed_widths_in_one_block()
    if !aow_ready() then return

    aow_says(aow_ir(aow_arm, raw"""
        f(a: u64, b: u32, c: u8) -> u64
            var hi: u64 = 0
            var lo: u32 = 0
            asm
                [aarch64]
                    "add {hi}, {a}, {b}, uxtw"
                    "add {lo}, {b}, {c}, uxtb"
                    in a : reg
                    in b : reg
                    in c : reg
                    out hi : reg
                    out lo : reg
                [x86_64, riscv64, riscv32, thumb, craft, wasm32] unavailable "not this test's business"
            hi + u64(lo)

        print(f(1, 2, 3))
        """), "asm sideeffect \"add $0, $2, ${3:w}, uxtw\\0Aadd ${1:w}, ${3:w}, ${4:w}, uxtb\"")
end aow_mixed_widths_in_one_block

@test("a name written twice is spelled with the modifier both times")
aow_a_repeated_name_keeps_its_modifier()
    if !aow_ready() then return

    aow_says(aow_ir(aow_arm, raw"""
        f(n: u32)
            asm
                [aarch64]
                    "add {n}, {n}, {n}"
                    in n : reg
                [x86_64, riscv64, riscv32, thumb, craft, wasm32] unavailable "not this test's business"

        f(1)
        """), "call void asm sideeffect \"add ${0:w}, ${0:w}, ${0:w}\", \"r,~{memory},~{cc}\"(i32 %t1)")

@test("a pinned machine register is spelled at the operand's width too, and its constraint is kept")
aow_a_pinned_register_is_spelled_by_width()
    if !aow_ready() then return

    aow_says(aow_ir(aow_arm, raw"""
        f(n: u32)
            asm
                [aarch64]
                    "mov w9, {n}"
                    in n : "x0"
                [x86_64, riscv64, riscv32, thumb, craft, wasm32] unavailable "not this test's business"

        f(1)
        """), "call void asm sideeffect \"mov w9, ${0:w}\", \"{x0},~{memory},~{cc}\"(i32 %t1)")

// guards: inline asm text keeps a written dollar doubled beside a compiler-written modifier
@test("a dollar the program wrote is still doubled beside a modifier the compiler wrote")
aow_a_written_dollar_beside_a_modifier()
    if !aow_ready() then return

    aow_says(aow_ir(aow_arm, raw"""
        f(n: u32)
            asm
                [aarch64]
                    "mov {n}, #0 // $"
                    in n : reg
                [x86_64, riscv64, riscv32, thumb, craft, wasm32] unavailable "not this test's business"

        f(1)
        """), "call void asm sideeffect \"mov ${0:w}, #0 // $$\"")

// -- every other processor ------------------------------------------------------------------------

@test("on x86-64 no width takes a modifier, because LLVM names the register by the operand's type")
aow_intel_widths_are_unmodified()
    if !aow_ready() then return

    aow_says(aow_ir(aow_intel, aow_with_value("u8", "7")), aow_call("i8", "$0", "$1"))
    aow_says(aow_ir(aow_intel, aow_with_value("u16", "7")), aow_call("i16", "$0", "$1"))
    aow_says(aow_ir(aow_intel, aow_with_value("u32", "7")), aow_call("i32", "$0", "$1"))
    aow_says(aow_ir(aow_intel, aow_with_value("int", "7")), aow_call("i32", "$0", "$1"))
    aow_says(aow_ir(aow_intel, aow_with_value("u64", "7")), aow_call("i64", "$0", "$1"))
    aow_says(aow_ir(aow_intel, aow_with_value("bool", "true")), aow_call("i1", "$0", "$1"))
end aow_intel_widths_are_unmodified

@test("on Thumb and RISC-V a register has one name, so a narrow operand takes no modifier")
aow_one_name_processors_are_unmodified()
    if !aow_ready() then return

    aow_says(aow_ir(aow_thumb, aow_with_value("u32", "7")), aow_call("i32", "$0", "$1"))
    aow_says(aow_ir(aow_thumb, aow_with_value("u8", "7")), aow_call("i8", "$0", "$1"))
    aow_says(aow_ir(aow_risc, aow_with_value("u32", "7")), aow_call("i32", "$0", "$1"))
    aow_says(aow_ir(aow_risc, aow_with_value("u64", "7")), aow_call("i64", "$0", "$1"))

// -- the arm's shape ------------------------------------------------------------------------------

@test("an instruction beside the brackets with a block under it is refused, not read for ever")
aow_an_inline_arm_with_a_block_is_refused()
    if !aow_ready() then return

    val said = aow_build(raw"""
        f(n: u32) -> u32
            var v: u32 = 0
            asm
                [aarch64] "mov {v}, {n}"
                    in n : reg
                    out v : reg
                [x86_64, riscv64, riscv32, thumb, craft, wasm32] unavailable "not this test's business"
            v

        print(f(1))
        """, aow_arm).0

    assert_eq(said, "an arm whose instruction is written beside its brackets has no block under " +
                    "it. Move the instruction into the block, above its operands")
end aow_an_inline_arm_with_a_block_is_refused

@test("an operand written at the arms' own depth is refused, and the parse still ends")
aow_an_operand_among_the_arms_ends()
    if !aow_ready() then return

    val said = aow_build(raw"""
        f(n: u32)
            asm
                [aarch64] "nop"
                in n : reg
                [x86_64, riscv64, riscv32, thumb, craft, wasm32] unavailable "not this test's business"

        f(1)
        """, aow_arm).0

    assert(said != "", "expected the misplaced operand to be refused")

@test("an inline instruction with no block under it is still one arm")
aow_an_inline_arm_alone_still_compiles()
    if !aow_ready() then return

    aow_says(aow_ir(aow_arm, raw"""
        f()
            asm
                [aarch64] "nop"
                [x86_64, riscv64, riscv32, thumb, craft, wasm32] unavailable "not this test's business"

        f()
        """), "call void asm sideeffect \"nop\", \"~{memory},~{cc}\"()")
