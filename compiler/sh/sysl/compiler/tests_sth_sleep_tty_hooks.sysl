module sh.sysl.compiler
@tests

import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture
import sysl.text.Search

// Waiting and terminal modes through hooks a kernel answers.
//
// **`sysl.time.sleep` goes through a third seam, `sysl_sleep_us`**, beside the two clock readings, and
// `sysl.posix.time` answers it over `nanosleep` on a host. **`sysl.tty` changes a terminal's mode
// through the hooks of `sysl.tty.sys`** -- `sysl_tty_get` and `sysl_tty_set` over a `Mode` record --
// which `sysl.tty.hosted` answers over `termios` and a freestanding program answers with `@export`s.
// And **a module requiring `posix` and `libc` together is refused on a machine that is not a POSIX
// operating system**, whatever its manifest grants: its C is compiled for a POSIX system and nowhere
// else, so a freestanding build granted `libc = true` used to pass analysis and fail at a board's link
// on a `sysl_posix_time_*` symbol.
//
// The terminal cases run the program on a real terminal made by the system's `script`, the only way
// to reach the branch that changes one; `twp_ready`, `twp_build` and `twp_output` are in
// `tests_twp_width.sysl`, `lbr_*` in `tests_lib_root.sysl`.

private val sth_target: string = "aarch64-freestanding"

private val sth_package: string = "package { name = \"probe\", version = \"0.1.0\" }\n"

private sth_with(capabilities: string) -> string =
    sth_package + s"targets {\n  $sth_target { capabilities { $capabilities } }\n}\n"

// What `sysl build-c` answers for a program and its manifest on the freestanding target, and what
// the archive it made leaves undefined -- `nm -u`, or empty where nothing was made.
private sth_build(program: string, manifest: string) -> (int, string, string)
    val p = lbr_tree(lbr_two("main.sysl", program, "package.hocon", manifest))
    val archive = s"$p/probe.a"
    val said = lbr_cli(["sysl", "build-c", "--target", sth_target, "-o", archive, p])

    var undefined = ""

    if said.0 == 0
        undefined = capture("nm", ["-u", archive], "", [], true) match
            Ok(o) -> o.text
            Err(_) -> "nm could not be run"

    lbr_drop([p])
    (said.0, said.1, undefined)
end sth_build

// A board answering every hook the program reaches: a sleep that counts what it was asked for, and a
// terminal whose echo setting is a module variable.
private val sth_board: string = raw"""
    import sysl.tty.sys.Mode

    var slept: long = 0
    var echoing: bool = true

    @export("sysl_sleep_us")
    board_sleep(us: long) -> long
        slept += us
        0

    @export("sysl_tty_get")
    board_get(fd: int, into: *Mode) -> int
        *into = Mode(echoing, true, true, true, true, 1, 0)
        0

    @export("sysl_tty_set")
    board_set(fd: int, mode: *Mode) -> int
        echoing = mode.echo
        0
    """

private val sth_waits_and_hides: string = raw"""
    import sysl.time.{sleep, millis}
    import sysl.tty

    @export("probe")
    probe() -> long
        sleep(millis(3))
        if !tty.hidden() then return -1
        val off = !echoing
        tty.cooked()
        if off && echoing then slept else -2
    """

// The C library symbols a hosted answer would have pulled in.
private sth_no_libc(undefined: string)
    for name in ["nanosleep", "tcgetattr", "tcsetattr", "atexit", "isatty", "sysl_posix_time"]
        assert(!undefined.contains(name), s"'$name' is undefined in:\n$undefined")
end sth_no_libc

// -- waiting on a host ------------------------------------------------------------------------------

@test("sysl.time.sleep waits at least as long as it was asked, by the monotonic clock")
sth_hosted_sleep_waits()
    if !twp_ready() then return

    assert_eq(twp_output(raw"""
        import sysl.time.{sleep, millis, micros, monotonic}

        val t0 = monotonic()
        sleep(millis(30))
        val t1 = monotonic()
        sleep(micros(1500))
        val t2 = monotonic()

        print((t1 - t0).us >= 30000, (t2 - t1).us >= 1500)
        """), "true true\n")
end sth_hosted_sleep_waits

@test("sysl.posix.time.sleep is the same wait, and a wait of nothing or less returns at once")
sth_posix_sleep_is_the_same_wait()
    if !twp_ready() then return

    assert_eq(twp_output(raw"""
        import sysl.posix.time.{sleep, monotonic}
        import sysl.time.{millis, seconds}

        val t0 = monotonic()
        sleep(millis(20))
        val t1 = monotonic()
        sleep(millis(0))
        sleep(seconds(-5))
        val t2 = monotonic()

        print((t1 - t0).us >= 20000, (t2 - t1).us < 1000000)
        """), "true true\n")
end sth_posix_sleep_is_the_same_wait

// -- the hooks on a freestanding target -------------------------------------------------------------

@test("a freestanding program answering the sleep and terminal hooks links with no C library symbol")
sth_freestanding_hooks_link()
    if !lbr_ready() then return

    val made = sth_build(sth_board + sth_waits_and_hides, sth_package)

    assert(made.0 == 0, made.1)
    sth_no_libc(made.2)
    assert(!made.2.contains("sysl_sleep_us"), made.2)
    assert(!made.2.contains("sysl_tty_"), made.2)
end sth_freestanding_hooks_link

@test("a freestanding program changing a terminal with its hooks unanswered is refused, naming both")
sth_freestanding_tty_unanswered()
    if !lbr_ready() then return

    val made = sth_build(raw"""
        import sysl.tty

        @export("probe")
        probe() -> bool = tty.hidden()
        """, sth_package)

    assert(made.0 != 0, "built a terminal change nobody answers")
    assert(made.1.contains("this program changes a terminal's mode, and 'aarch64-freestanding' has " +
                           "no operating system under it for the standard library to answer one " +
                           "with, so the program answers it: define 'sysl_tty_get', 'sysl_tty_set' " +
                           "with '@export'"), made.1)
    assert(made.1.contains("in 'sysl.tty.sys' declares"), made.1)
end sth_freestanding_tty_unanswered

// A seam, unlike a hook, may be answered by the C a board's own build links, so a `build-c` archive
// leaves it for that link -- exactly as `sysl_wall_us` is left.
@test("a freestanding archive that sleeps with the seam unanswered leaves sysl_sleep_us to the board")
sth_freestanding_sleep_left_to_the_board()
    if !lbr_ready() then return

    val made = sth_build(raw"""
        import sysl.time.{sleep, millis}

        @export("probe")
        probe() = sleep(millis(1))
        """, sth_package)

    assert(made.0 == 0, made.1)
    assert(made.2.contains("sysl_sleep_us"), made.2)
    sth_no_libc(made.2)
end sth_freestanding_sleep_left_to_the_board

// -- posix and libc together --------------------------------------------------------------------------

@test("granting libc on a freestanding target does not admit sysl.posix.time: it is not a POSIX system")
sth_libc_granted_posix_time_refused()
    if !lbr_ready() then return

    val made = sth_build(raw"""
        import sysl.posix.time.nanosleep

        @export("tick")
        tick() -> long = nanosleep(1000)
        """, sth_with("libc = true"))

    assert(made.0 != 0, "built sysl.posix.time on a freestanding target")
    assert(made.1.contains("error: this reaches 'sysl.posix.time', which requires 'posix' and " +
                           "'libc', and 'aarch64-freestanding' is not a POSIX operating system — " +
                           "the two together are a POSIX system's own C library"), made.1)
    assert(made.1.contains("main.sysl:1:1"), made.1)
    assert(!made.1.contains("sysl_posix_time"), made.1)
end sth_libc_granted_posix_time_refused

@test("and the same for sysl.posix.tty, whose raw is now sysl.tty's")
sth_libc_granted_posix_tty_refused()
    if !lbr_ready() then return

    val made = sth_build(raw"""
        import sysl.posix.tty.raw

        @export("go")
        go() -> bool = raw()
        """, sth_with("libc = true"))

    assert(made.0 != 0, "built sysl.posix.tty on a freestanding target")
    assert(made.1.contains("this reaches 'sysl.posix.tty', which requires 'posix' and 'libc'"), made.1)
end sth_libc_granted_posix_tty_refused

@test("while sysl.time and sysl.tty, answered by the board, build with libc granted and link to none of it")
sth_libc_granted_hooks_still_link()
    if !lbr_ready() then return

    val made = sth_build(sth_board + sth_waits_and_hides, sth_with("libc = true"))

    assert(made.0 == 0, made.1)
    sth_no_libc(made.2)
end sth_libc_granted_hooks_still_link

@test("a module of the program's own requiring posix and libc is held to the same rule")
sth_own_module_posix_and_libc()
    if !lbr_ready() then return

    val p = lbr_tree(lbr_two("main.sysl", "import host.c_pid\n\n@export(\"pid\")\npid() -> int = c_pid()\n",
                             "host/host.sysl", "module host\n@requires(posix, libc)\n\n" +
                             "extern \"getpid\" c_pid() -> int\n"))

    write_text(s"$p/package.hocon", sth_with("libc = true")).unwrap()

    val said = lbr_cli(["sysl", "build-c", "--target", sth_target, "-o", s"$p/probe.a", p])

    lbr_drop([p])
    assert(said.0 != 0, "built a posix-and-libc module on a freestanding target")
    assert(said.1.contains("this reaches 'host', which requires 'posix' and 'libc'"), said.1)
end sth_own_module_posix_and_libc

// -- a terminal's mode, on a real terminal ----------------------------------------------------------

// Runs `text` on a terminal made by `script`, then `after` in that terminal once the program has
// left it; answers what the terminal showed, or `None` where this machine cannot make one.
private sth_on_tty(text: string, after: string) -> Option[string]
    if !twp_ready() then return None

    val has_script = capture("sh", ["-c", "command -v script"]) match
        Ok(o) -> o.text.len > 0
        Err(_) -> false

    if !has_script
        print("skipped: there is no 'script' on this machine to make a terminal with")
        return None

    val root = make_temp_dir("sysl-sth").unwrap()

    make_dir_all(root).unwrap()

    val out = twp_build(root, text) match
        Err(why) -> why
        Ok(exe) ->
            write_text(s"$root/session.sh", s"$exe\n$after\n").unwrap()

            val bsd = capture("uname", []).map((o) -> o.text.starts_with("Darwin")).unwrap_or(false)
            val under = if bsd then s"script -q /dev/null sh $root/session.sh"
            else s"script -qc 'sh $root/session.sh' /dev/null"

            capture("sh", ["-c", s"$under < /dev/null"], "", [], true, 60000) match
                Err(_) -> "script could not be run"
                Ok(o) -> o.text

    remove_dir_all(root).unwrap_or(())
    Some(out)
end sth_on_tty

// The three flags `stty` reports for the terminal it is run on, sorted, one word each.
private val sth_stty_flags: string =
    "stty -a | tr ' ' '\\n' | grep -E '^-?(echo|icanon|isig)$' | sort | tr '\\n' ' '; echo"

@test("hidden turns echo and signals off and keeps whole lines, as stty sees it")
sth_hidden_is_echo_off_lines_on()
    val shown = sth_on_tty(raw"""
        import sysl.tty
        import sysl.process.run

        print("hidden:", tty.hidden())

        val m = tty.mode().unwrap()

        print("mode:", m.echo, m.canonical, m.signals, m.output, m.crlf)

        val _ = run("stty", ["-a"])
        tty.cooked()
        """, "") match
        None -> return
        Some(s) -> s

    assert(shown.contains("hidden: true"), shown)
    assert(shown.contains("mode: false true false true true"), shown)

    // `stty -a` lists each flag as a word, '-' in front where it is off.
    for flag in [" -echo ", " icanon ", " -isig "]
        assert(shown.contains(flag), s"no '$flag' in:\n$shown")
end sth_hidden_is_echo_off_lines_on

@test("a mode set is the mode read back, and the one found is put back the same way")
sth_mode_round_trip()
    val shown = sth_on_tty(raw"""
        import sysl.tty

        val found = tty.mode().unwrap()
        val wanted = found with { echo = false, canonical = false, signals = false, min = 3, time = 7 }

        print("set:", tty.set_mode(wanted))

        val got = tty.mode().unwrap()

        print("read:", got.echo, got.canonical, got.signals, got.min, got.time,
              got.output == found.output, got.crlf == found.crlf)
        print("back:", tty.set_mode(found))

        val again = tty.mode().unwrap()

        print("same:", again.echo == found.echo && again.canonical == found.canonical &&
              again.signals == found.signals && again.min == found.min && again.time == found.time)
        """, "") match
        None -> return
        Some(s) -> s

    assert(shown.contains("set: true"), shown)
    assert(shown.contains("read: false false false 3 7 true true"), shown)
    assert(shown.contains("back: true"), shown)
    assert(shown.contains("same: true"), shown)
end sth_mode_round_trip

@test("a program that leaves raw mode without cooked() still leaves the terminal as it found it")
sth_exit_puts_the_terminal_back()
    val shown = sth_on_tty(raw"""
        import sysl.tty

        print("raw:", tty.raw())
        """, sth_stty_flags) match
        None -> return
        Some(s) -> s

    assert(shown.contains("raw: true"), shown)
    assert(shown.contains("echo icanon isig"), shown)
end sth_exit_puts_the_terminal_back

@test("sysl.posix.tty's raw and hidden are sysl.tty's, the state shared between the two names")
sth_posix_tty_is_sysl_tty()
    val shown = sth_on_tty(raw"""
        import sysl.posix.tty
        import sysl.tty as modes

        print("hidden:", tty.hidden(), modes.mode().unwrap().echo)
        modes.cooked()
        print("cooked:", modes.mode().unwrap().echo)
        """, "") match
        None -> return
        Some(s) -> s

    assert(shown.contains("hidden: true false"), shown)
    assert(shown.contains("cooked: true"), shown)
end sth_posix_tty_is_sysl_tty
