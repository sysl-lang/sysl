module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.fs.{entries, make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.seq.Sequence
import sysl.text.Search

// **Another build of the same version is another compiler** (`compiler_identity`). A development tree
// holds `Version` at `0.0.1` while the compiler changes, and keyed on the version alone a fresh build
// or a stage two replayed the binary an earlier build had cached for an identical tree, and linked the
// standard module an earlier lowering had made.
//
// Every case keeps its run-cache entries in a directory of its own (`use_run_cache_dir`), and a case
// that builds while standing in for another build removes the standard-module entries that build's
// key left, so nothing here reads or leaves anybody else's cache.

private rck_ready() -> bool = std_root().is_ok() && clang_available()

// The build a case stands in for. Named for this suite, so no other suite's stand-in shares its
// standard-module entries.
private rck_other() -> string = s"${Version}+rck-other-build"

// A run cache of the case's own.
private rck_cache() -> string
    val dir = make_temp_dir("sysl-rck-cache").unwrap()

    use_run_cache_dir(Some(dir))
    dir
end rck_cache

// Everything a case changed, put back: the real identity, the machine's run cache, the case's own
// directories, and the standard-module entries built under the stand-in's key.
private rck_restore(dirs: []string)
    pin_compiler_identity(None)
    use_run_cache_dir(None)

    for d in dirs
        remove_dir_all(d).unwrap_or(())

    cache_directory() match
        None -> ()
        Some(home) ->
            val prefix = s"${rck_other()}-"

            entries(s"$home/sysl") match
                Err(_) -> ()
                Ok(names) -> names.filter((n) -> n.starts_with(prefix))
                    .each((n) -> remove_dir_all(s"$home/sysl/$n").unwrap_or(()))
end rck_restore

// The executables in a run cache, without the test lists beside them.
private rck_slots(cache: string) -> Buf[string]
    var out: Buf[string] = buf()

    entries(s"$cache/sysl/run") match
        Err(_) -> ()
        Ok(names) ->
            for i in 0..<names.len()
                if !names.at(i).ends_with(".tests") then out.push(s"$cache/sysl/run/${names.at(i)}")

    out
end rck_slots

private rck_ran(root: string) -> int = run_native_program(root, None, None, DefaultOptimization, buf()) match
    Ok(code) -> code
    Err(why) -> panic(s"the run was refused: ${failure_text(why)}")

// -- the standard module's artifact ----------------------------------------------------------------

@test("and by which build of that version, so a changed development compiler links its own")
rck_the_std_path_names_the_build()
    if cache_directory().is_none() then return

    val mine = std_artifact_path(host_target(), "0123456789abcdef")

    assert(mine.index_of(s"/${compiler_identity()}-").is_some(), mine)
    assert(compiler_identity().starts_with(s"$Version+"), compiler_identity())
    assert(compiler_identity().len > Version.len + 1, "the build half is not empty")

    pin_compiler_identity(Some(rck_other()))

    val other = std_artifact_path(host_target(), "0123456789abcdef")

    pin_compiler_identity(None)

    val current = compiler_identity()

    pin_compiler_identity(Some(current))

    val same = std_artifact_path(host_target(), "0123456789abcdef")

    pin_compiler_identity(None)
    assert(other != mine, "another build of this version is another artifact")
    assert_eq(same, mine)
end rck_the_std_path_names_the_build

// -- the run cache ---------------------------------------------------------------------------------

@test("a different build of this version is a different compiler, and the same build is the same")
rck_another_build_is_another_entry()
    if !rck_ready() then return

    val cache = rck_cache()
    val root = runner_project("main.sysl", "print(21 * 2)\n")
    val current = compiler_identity()

    assert_eq(rck_ran(root), 0)
    assert_eq(rck_slots(cache).len(), 1)

    pin_compiler_identity(Some(rck_other()))
    assert_eq(rck_ran(root), 0)
    assert_eq(rck_slots(cache).len(), 2)

    assert_eq(rck_ran(root), 0)
    pin_compiler_identity(Some(current))
    assert_eq(rck_ran(root), 0)

    val kept = rck_slots(cache).len()

    rck_restore([cache, root])
    assert_eq(kept, 2)
end rck_another_build_is_another_entry

// What an older build left is stood in for by a program that exits 7, so a replay is visible in the
// status and cannot be mistaken for the build.
@test("and what another build cached is not replayed, whatever it holds")
rck_another_builds_entry_is_not_replayed()
    if !rck_ready() then return

    val cache = rck_cache()
    val root = runner_project("main.sysl", "print(21 * 2)\n")

    pin_compiler_identity(Some(rck_other()))
    assert_eq(rck_ran(root), 0)

    val slots = rck_slots(cache)

    assert_eq(slots.len(), 1)
    write_text(slots.at(0), "#!/bin/sh\nexit 7\n").unwrap()

    val replayed = rck_ran(root)

    pin_compiler_identity(None)

    val built = rck_ran(root)

    rck_restore([cache, root])
    assert_eq(replayed, 7, "the seeded entry is what that build's key finds")
    assert_eq(built, 0, "this build compiles rather than replaying it")
end rck_another_builds_entry_is_not_replayed

// -- the whole command, over a project with a dependency -------------------------------------------

private rck_package() -> string
    val root = make_temp_dir("sysl-rck-pkg").unwrap()

    make_dir_all(s"$root/json").unwrap()
    write_text(s"$root/package.hocon", "package { name = \"one\", version = \"1.0.0\" }\n").unwrap()
    write_text(s"$root/json/json.sysl", "module json\n\ntag() -> int = 40\n").unwrap()
    write_text(s"$root/json/tests.sysl",
               "module json\n@tests\n\n@test\nfails_if_run()\n    assert_eq(1, 2)\n").unwrap()
    root
end rck_package

private rck_app(one: string) -> string
    val root = make_temp_dir("sysl-rck-app").unwrap()

    write_text(s"$root/package.hocon",
               s"package { name = \"app\", version = \"0.1.0\" }\ndependencies { a { path = \"$one\" } }\n")
        .unwrap()
    write_text(s"$root/main.sysl", "print(json.tag())\n\n@test\nforty()\n    assert_eq(json.tag(), 40)\n")
        .unwrap()
    root
end rck_app

// `sysl test <root>` as the command line answers it: the status, and everything it said.
private rck_tested(root: string) -> (int, string)
    var said: Buf[string] = buf()
    val sink = &said
    val code = run_cli(["sysl", "test", root], piece -> sink.push(piece))
    var text = ""

    for i in 0..<said.len()
        text = text + said.at(i) + "\n"

    (code, text)
end rck_tested

// The case beside `tdp_runs_only_the_projects_tests` once reported a dependency's test in the
// reference's release gate, from a binary an older build of the same version had cached for an
// identical fixture. So the entry that build left is put back here, holding a test binary that fails
// everything, and this build has to compile rather than replay it.
@test("and is not handed a test build another build of this version cached for the same project")
rck_not_handed_another_builds_test_binary()
    if !rck_ready() then return

    val cache = rck_cache()
    val one = rck_package()
    val root = rck_app(one)

    pin_compiler_identity(Some(rck_other()))

    val first = rck_tested(root)

    val slots = rck_slots(cache)

    for i in 0..<slots.len()
        write_text(slots.at(i), "#!/bin/sh\necho fails_if_run\nexit 1\n").unwrap()

    val replayed = rck_tested(root)

    pin_compiler_identity(None)

    val mine = rck_tested(root)

    rck_restore([cache, one, root])
    assert_eq(first.0, 0, first.1)
    assert(replayed.0 != 0, s"the seeded entry is what that build's key finds:\n${replayed.1}")
    assert_eq(mine.0, 0, mine.1)
    assert(mine.1.index_of("1 passed").is_some(), mine.1)
    assert(mine.1.index_of("fails_if_run").is_none(), mine.1)
end rck_not_handed_another_builds_test_binary
