module sysl.encoding.json
@tests

import sysl.buf.{Buf, buf}

// JSONTestSuite (github.com/nst/JSONTestSuite, test_parsing/): every `y_` case must be accepted and
// survive a round trip, and every `n_` case must be refused. The bytes are the files' own, one array
// per case, so a case holding bytes that are not UTF-8 is carried exactly. The two `n_` cases that
// are a hundred thousand brackets deep are built at run time rather than spelled out.

private accepts(fails: *Buf[string], name: string, b: []const u8)
    parse_bytes(b) match
        Ok(j) ->
            val back = parse(str(j))

            if back.is_err() || back.unwrap() != j then fails.push(name + ": does not round-trip")
        Err(e) -> fails.push(name + ": " + str(e))

private refuses(fails: *Buf[string], name: string, b: []const u8)
    if parse_bytes(b).is_ok() then fails.push(name)

private listed(fails: Buf[string]) -> string
    var all = ""

    for i in 0..<fails.len() do all = all + fails.at(i) + "\n"

    all

@test("every y_ case of JSONTestSuite is accepted and round-trips")
json_suite_accepts()
    var fails: Buf[string] = buf()

    accepts(&fails, "y_array_arraysWithSpaces", [0x5b, 0x5b, 0x5d, 0x20, 0x20, 0x20, 0x5d])
    accepts(&fails, "y_array_empty-string", [0x5b, 0x22, 0x22, 0x5d])
    accepts(&fails, "y_array_empty", [0x5b, 0x5d])
    accepts(&fails, "y_array_ending_with_newline", [0x5b, 0x22, 0x61, 0x22, 0x5d])
    accepts(&fails, "y_array_false", [0x5b, 0x66, 0x61, 0x6c, 0x73, 0x65, 0x5d])
    accepts(&fails, "y_array_heterogeneous", [0x5b, 0x6e, 0x75, 0x6c, 0x6c, 0x2c, 0x20, 0x31, 0x2c, 0x20, 0x22, 0x31, 0x22, 0x2c, 0x20, 0x7b, 0x7d, 0x5d])
    accepts(&fails, "y_array_null", [0x5b, 0x6e, 0x75, 0x6c, 0x6c, 0x5d])
    accepts(&fails, "y_array_with_1_and_newline", [0x5b, 0x31, 0x0a, 0x5d])
    accepts(&fails, "y_array_with_leading_space", [0x20, 0x5b, 0x31, 0x5d])
    accepts(&fails, "y_array_with_several_null", [0x5b, 0x31, 0x2c, 0x6e, 0x75, 0x6c, 0x6c, 0x2c, 0x6e, 0x75, 0x6c, 0x6c, 0x2c, 0x6e, 0x75, 0x6c, 0x6c, 0x2c, 0x32, 0x5d])
