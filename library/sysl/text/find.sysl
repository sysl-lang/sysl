module sysl.text

import sysl.unicode.{is_space as unicode_space}

/** Searching text and trimming it -- the half of the operations that makes no new bytes.
 *
 * **Everything here is allocation-free, and that is what the file boundary is drawn on.** A search
 * answers with an offset or a `bool`, and a trim answers with a *view* of what it was given, so
 * nothing in this file needs an allocator and all of it is reachable under `no alloc`. What makes
 * new text -- joining, replacing, changing case -- is in `edit.sysl` beside it, and needs one.
 *
 * **It is written once, over `[]const u8`, and that is the whole design.** The older sysl wrote this
 * surface twice: `std.strings` over `string` and `std.bytes` over `[]byte`, 1,630 lines of
 * near-identical code, because it had no way to say "either of these". A trait says it: each
 * implementation supplies two members -- the bytes to look at, and how to cut a piece of itself out
 * -- and every operation below is a default written against those two. So `s.starts_with("//")` and
 * `b.starts_with(prefix)` are the same code, and adding an operation adds it to both.
 *
 * **A byte-level search over UTF-8 is not a shortcut, it is correct.** UTF-8 is self-synchronizing:
 * a continuation byte is distinguishable from a lead byte, so a well-formed needle cannot match
 * starting anywhere but at a character boundary. That is why these can ignore encoding entirely,
 * and why an offset one of them returns is always safe to slice at -- which matters, since
 * `s[a..b]` traps on a mid-codepoint bound.
 *
 * The searches are the naive O(n*m) scan. A sub-linear one may replace them without anything
 * observable changing, which is the reason to say so here rather than in each body.
 */
trait Search

    /** The bytes to look at. This is the whole of what a `string` and a `[]const u8` disagree about. */
    view(self) -> []const u8

    /** A piece of the receiver, as the receiver's own type -- what lets a trim answer with a view
     * rather than a copy, and what a default cannot do for itself because it does not know how to
     * build a `Self`.
     */
    slice(self, lo: usize, hi: usize) -> Self

    // --- What the trait answers for itself. ---

    /** There is deliberately no `len` here: both implementations already have one the compiler
     * provides, and a trait member of that name would hide it rather than agree with it.
     */
    is_empty(self) -> bool = self.view().len == 0

    /** The empty prefix is a prefix of everything, which falls out of the comparison rather than
     * being said: two slices of no elements are equal.
     */
    starts_with(self, prefix: Self) -> bool
        var h = self.view()
        var n = prefix.view()

        if n.len > h.len then return false

        h[0..<n.len] == n

    ends_with(self, suffix: Self) -> bool
        var h = self.view()
        var n = suffix.view()

        if n.len > h.len then return false

        h[(h.len - n.len)..] == n

    /** Where the first occurrence starts, or `None`.
     *
     * An `Option` rather than old sysl's `-1`, because a sentinel is a value the type says is
     * ordinary and every caller has to remember to check. The empty needle is found at 0, which is
     * the convention every library shares and the one that makes `split` on an empty separator
     * terminate.
     */
    index_of(self, needle: Self) -> Option[usize]
        var h = self.view()
        var n = needle.view()

        if n.len == 0 then return Some(0)
        if n.len > h.len then return None

        var last = h.len - n.len
        var i: usize = 0

        while i <= last
            var matched = true
            var j: usize = 0

            while j < n.len
                if h[i + j] != n[j]
                    matched = false
                    break
                j += 1

            if matched then return Some(i)
            i += 1

        None
    end index_of

    /** The empty needle is found at the end here rather than at 0, which is the same convention read
     * from the other side: the last place it occurs.
     */
    last_index_of(self, needle: Self) -> Option[usize]
        var h = self.view()
        var n = needle.view()

        if n.len == 0 then return Some(h.len)
        if n.len > h.len then return None

        var i = h.len - n.len

        loop
            var matched = true
            var j: usize = 0

            while j < n.len
                if h[i + j] != n[j]
                    matched = false
                    break
                j += 1

            if matched then return Some(i)
            if i == 0 then break
            i -= 1

        None
    end last_index_of

    index_of_byte(self, b: u8) -> Option[usize]
        var h = self.view()

        for i in 0..<h.len
            if h[i] == b then return Some(i)

        None
    end index_of_byte

    last_index_of_byte(self, b: u8) -> Option[usize]
        var h = self.view()
        var i = h.len

        while i > 0
            i -= 1
            if h[i] == b then return Some(i)

        None
    end last_index_of_byte

    contains(self, needle: Self) -> bool = self.index_of(needle).is_some()

    /** Whether one byte occurs anywhere. It is written as its own loop rather than as
     * `index_of_byte(b).is_some()` because the answer is a `bool` and going through the `Option`
     * asks for a position nobody wants -- which is also what a cutset trim needs, since it asks
     * this once per byte trimmed.
     */
    has_byte(self, b: u8) -> bool
        for x in self.view()
            if x == b then return true

        false

    /** How many non-overlapping occurrences there are, counted the way a `replace_all` would find
     * them -- so `count_of` and the number of replacements `replace_all` makes always agree. In
     * `"aaa"` there is one `"aa"`, not two.
     */
    count_of(self, needle: Self) -> usize
        var h = self.view()
        var n = needle.view()

        if n.len == 0 then return 0
        if n.len > h.len then return 0

        var found: usize = 0
        var i: usize = 0
        var last = h.len - n.len

        while i <= last
            var matched = true
            var j: usize = 0

            while j < n.len
                if h[i + j] != n[j]
                    matched = false
                    break
                j += 1

            if matched
                found += 1
                i += n.len
            else
                i += 1

        found
    end count_of

    // --- Trimming, which answers with a view of the receiver rather than a copy. ---

    /** ASCII whitespace off the front, the back, or both -- which is the answer for a receiver of
     * BYTES, and is not what a `string` gives.
     *
     * **The trait's own answer is byte for byte, and `string` replaces all three.** A byte is not a
     * character, so a run of bytes has no Unicode whitespace in it to find: a non-breaking space is
     * `0xc2 0xa0`, and neither of those is a space on its own. `impl Search for string` overrides
     * these with a walk over characters, testing `sysl.unicode.is_space`; what is left here is what
     * a wire format wants, where the ASCII answer is the specified one.
     *
     * **Trimming cannot land mid-character either way**, which is what makes it safe to answer with
     * a slice: every whitespace byte is ASCII, so every byte removed is a whole character and every
     * bound left behind is one the receiver already had.
     */
    trim_start(self) -> Self
        var h = self.view()
        var i: usize = 0

        while i < h.len && h[i].is_space()
            i += 1

        self.slice(i, h.len)
    end trim_start

    trim_end(self) -> Self
        var h = self.view()
        var n = h.len

        while n > 0 && h[n - 1].is_space()
            n -= 1

        self.slice(0, n)
    end trim_end

    trim(self) -> Self
        var h = self.view()
        var i: usize = 0
        var n = h.len

        while i < n && h[i].is_space()
            i += 1

        while n > i && h[n - 1].is_space()
            n -= 1

        self.slice(i, n)
    end trim

    /** The same three against a set of bytes the caller names, which is what strips quotes, slashes
     * or padding rather than whitespace.
     *
     * **The cutset is a set of BYTES**, so a non-ASCII character in one is its bytes and not itself
     * -- and trimming with such a cutset can cut a character in half, which for a `string` is a
     * trap rather than a wrong answer. That is the honest behaviour for a byte-level operation and
     * the reason the whitespace trims above are the ones without a caveat.
     * Membership in the cutset is `has_byte` asked of the cutset, which is why there is no helper
     * beside these: the question "is this byte one of those" is one the trait already answers, and
     * asking it of the cutset rather than of the receiver is the whole difference.
     */
    trim_start_matches(self, cutset: Self) -> Self
        var h = self.view()
        var i: usize = 0

        while i < h.len && cutset.has_byte(h[i])
            i += 1

        self.slice(i, h.len)
    end trim_start_matches

    trim_end_matches(self, cutset: Self) -> Self
        var h = self.view()
        var n = h.len

        while n > 0 && cutset.has_byte(h[n - 1])
            n -= 1

        self.slice(0, n)
    end trim_end_matches

    trim_matches(self, cutset: Self) -> Self = self.trim_start_matches(cutset).trim_end_matches(cutset)

end Search

/** Text, which is the receiver these are nearly always written on. `slice` goes through the
 * language's own boundary-checked subscript, so a piece cut out of a string is a string with the
 * same guarantee -- and the bounds every operation above hands it are ones the search or the trim
 * already knows are boundaries.
 */
impl Search for string
    view(self) -> []const u8 = self.bytes

    slice(self, lo: usize, hi: usize) -> string = self[lo..<hi]

    /** Whitespace off the front, over **Unicode** rather than ASCII: a non-breaking space, an
     * ideographic space and a next-line control are all removed, and the trait's byte walk removes
     * none of them.
     *
     * **A `string` is text, so the question has a character-level answer and the byte-level one is
     * merely cheaper.** `Ascii.is_space` covers `U+0009` to `U+000D` and `U+0020` and stops there,
     * which was the whole of sysl's `trim` by accident of ordering rather than by decision — the
     * database that answers the rest arrived after these were written. The `[]const u8` receiver
     * keeps the byte walk, because bytes are not characters and a wire format wants the ASCII
     * answer.
     *
     * **What it costs is a decode**, a few nanoseconds per byte, and the table `is_space` reads.
     * A program that never trims a `string` links neither.
     *
     * **No locale enters into it**, here or anywhere else in this module: the library has no notion
     * of one, and the whitespace property is not locale-sensitive in any case. Casing is where that
     * bites, and `to_upper` says so.
     */
    override trim_start(self) -> string
        var w = chars_of(self.bytes)
        var i: usize = 0

        loop
            w.next() match
                Some(c) ->
                    if !unicode_space(c) then break
                    i = w.offset
                None -> break

        self[i..<self.len]
    end trim_start

    /** The other end, walked forwards.
     *
     * **There is no backwards decoder here and it would buy nothing.** UTF-8 is self-synchronizing,
     * so stepping back over a character is possible — but the trim has to look at every character
     * from the end until it finds one that is not a space, and in the common case where nothing is
     * trimmed that is one step either way. What decides it is that a forward walk is the decoder
     * this module already has, and a second one would be a second thing to keep right.
     */
    override trim_end(self) -> string
        var w = chars_of(self.bytes)
        var n: usize = 0

        loop
            w.next() match
                Some(c) -> if !unicode_space(c) then n = w.offset
                None -> break

        self[0..<n]
    end trim_end

    /** Both ends. It is the two walks rather than one because the second runs over what the first
     * left, which is the shorter string and is what a caller would have written by hand.
     */
    override trim(self) -> string = self.trim_start().trim_end()

/** Bytes that are not text, or not yet: what a program reads off a socket or a file before it knows
 * whether it is UTF-8. The same operations answer the same way, which is the point of the trait --
 * and here there is no encoding to be careful of, since there is no guarantee to keep.
 */
impl Search for []const u8
    view(self) -> []const u8 = self

    slice(self, lo: usize, hi: usize) -> []const u8 = self[lo..<hi]
