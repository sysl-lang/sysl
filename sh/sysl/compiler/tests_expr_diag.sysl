module sh.sysl.compiler
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.Search

// What the expression pass refuses, and what it says.
//
// **Every message here was read out of the reference compiler**, by handing the installed `sysl`
// the same source and quoting what came back -- never composed from the rule.

private only(text: string) -> string
    val ds = expr_diagnostics(text)

    if ds.is_empty() then return ""

    ds.at(0)
end only

private count(text: string) -> usize = expr_diagnostics(text).len()

@test("a body whose expression is sound says nothing")
a_sound_body_says_nothing()
    assert_eq(count("f(a: int, b: int) -> int = a + b\n"), 0)
    assert_eq(count("struct P\n    x: int\n\nf(p: P) -> int = p.x\n"), 0)
    assert_eq(count("g(a: int) -> int = a\nf() -> int = g(1)\n"), 0)

@test("a literal too large for the type it landed in is told the number and the type")
a_literal_that_does_not_fit()
    assert_eq(only("f() -> u8 = 300\n"), "the literal 300 does not fit byte")
    assert_eq(only("f() -> i8 = 128\n"), "the literal 128 does not fit i8")

@test("an operator's operands have to agree, and the caret is under the second")
operands_have_to_agree()
    assert_eq(only("f() -> int = 1 + \"x\"\n"), "'+' needs matching types, got int and string")
    assert_eq(only("f(a: u8, b: int) -> byte = a + b\n"),
              "'+' needs matching types, got byte and int")

@test("an operator that a type does not have is named with the type")
an_operator_a_type_does_not_have()
    assert_eq(only("f(a: string, b: string) -> string = a - b\n"),
              "operator '-' is not defined for string")
    assert_eq(only("f(a: bool, b: bool) -> bool = a * b\n"),
              "operator '*' is not defined for bool")

@test("a shift's count is a count, and has to be a number of places")
a_shift_needs_a_count()
    assert_eq(only("f(a: int, b: string) -> int = a << b\n"),
              "'<<' shifts by a count, and string is not an integer")

@test("unary minus has no meaning on an unsigned type, and the message says which")
unary_minus_on_an_unsigned()
    assert_eq(only("f(a: u8) -> byte = -a\n"),
              "unary '-' is not defined for the unsigned type byte")
    assert_eq(only("f(a: string) -> string = -a\n"), "unary '-' is not defined for string")
    assert_eq(only("f(a: f32) -> f32 = ~a\n"), "unary '~' is not defined for f32")

@test("two values that cannot be compared are named, both of them")
values_that_cannot_be_compared()
    assert_eq(only("f() -> bool = 1 < \"a\"\n"), "cannot compare int with string")

@test("'null' takes its type from its context, and refuses to guess one")
null_needs_a_context()
    assert_eq(only("f() -> int = 1 + 2\ng() = null\n"),
              "'null' takes its type from its context, and there is none here")
    assert_eq(only("f() -> int = null\n"), "'null' is a raw pointer, and int was expected here")

@test("a name that stands for nothing is named back")
an_undefined_name()
    assert_eq(only("f() -> int = nope\n"), "undefined name 'nope'")
    assert_eq(only("f() -> int = nope(1)\n"), "undefined function 'nope'")

@test("a call with the wrong number of arguments is told how many the declaration takes")
a_call_of_the_wrong_arity()
    assert_eq(only("g(a: int, b: int) -> int = a\nf() -> int = g(1)\n"),
              "function 'g' takes 2 arguments, but 1 argument was given")
    assert_eq(only("g(a: int) -> int = a\nf() -> int = g(1, 2)\n"),
              "function 'g' takes 1 argument, but 2 arguments were given")

@test("an argument of the wrong type names the parameter it was written for")
an_argument_of_the_wrong_type()
    assert_eq(only("g(a: int) -> int = a\nf() -> int = g(\"x\")\n"),
              "'a' of 'g' is int, but string was given")

@test("a named argument that names no parameter is told which names there are")
a_named_argument_that_names_nothing()
    assert_eq(only("g(a: int, b: int = 2) -> int = a\nf() -> int = g(1, c = 3)\n"),
              "function 'g' declares no parameter named 'c' — it takes 'a' and 'b'")

@test("a struct built with the wrong number of values is told how many fields it has")
a_struct_built_wrong()
    assert_eq(only("struct P\n    x: int\n    y: int\n\nf() -> P = P(1)\n"),
              "struct 'P' has 2 fields, but 1 value was given")

@test("and so is a variant")
a_variant_built_wrong()
    assert_eq(only("enum Shape\n    Circle(r: int)\n    Square\n\nf() -> Shape = Circle(1, 2)\n"),
              "variant 'Circle' has 1 field, but 2 values were given")

@test("a conversion that has no meaning names both types")
a_conversion_with_no_meaning()
    assert_eq(only("f(s: string) -> int = int(s)\n"), "cannot convert string to int")
    assert_eq(only("f(n: int) -> string = string(n)\n"),
              "a 'string' conversion encodes a char, and int is not one — 'str(x)' renders a " +
              "value as text")

@test("an array literal needs one element type")
an_array_literal_needs_one_type()
    assert_eq(only("f() -> [2]int = [1, \"x\"]\n"),
              "an array literal needs one element type, got int and string")

@test("an array's bound is a constant, since it is the array's bound")
an_array_repeat_needs_a_constant()
    assert_eq(only("f(n: int) -> [4]int = [0; n]\n"),
              "an array's repeat count must be a constant, since it is the array's bound — a " +
              "literal, or a 'const' naming one. A count computed while running makes storage " +
              "instead, which is written where a '[]T' is expected")

@test("an index has to be an integer, and a receiver has to have elements")
an_index_and_its_receiver()
    assert_eq(only("f(xs: [3]int, k: string) -> int = xs[k]\n"),
              "an index must be an integer, not string")
    assert_eq(only("f(n: int) -> int = n[0]\n"), "cannot index int")

@test("a dereference needs a pointer")
a_dereference_needs_a_pointer()
    assert_eq(only("f(n: int) -> int = *n\n"), "'*' needs a pointer or a reference, not int")

@test("a condition has to be a bool")
a_condition_has_to_be_bool()
    assert_eq(only("f(n: int) -> bool = !n\n"), "condition must be bool, got int")

@test("a lane index is part of the instruction that reads it")
a_lane_index_is_a_constant()
    assert(only("f(v: <4>f32, k: usize) -> f32 = v[k]\n").starts_with(
        "a lane index is part of the instruction that reads it"))
    assert_eq(only("f(v: <4>f32) -> f32 = v[9]\n"), "<4>f32 has lanes 0 to 3, and this is 9")

@test("a vector's width is part of its type, so a literal has to fill it")
a_vector_literal_fills_its_width()
    assert_eq(only("f() -> <4>f32 = [1.0, 2.0]\n"),
              "<4>f32 has 4 lanes and this literal has 2 — a vector's width is part of its type, " +
              "so the two have to agree")

@test("a read-only view does not become a writable one")
a_read_only_view_does_not_widen()
    assert(only("f(xs: []const int) -> []int = xs\n").starts_with(
        "a '[]const int' views elements it may not write"))

// Two modules of one compilation, and everything the body pass had to say about them -- which is
// what a name reached through the module it belongs to needs, since one file cannot declare a
// module and import it.
private across(first: string, second: string) -> Buf[string]
    var units: Buf[Program] = buf()
    var out: Buf[string] = buf()

    val a = parse(source_of("a.sysl", first))
    val b = parse(source_of("b.sysl", second))

    if !a.ok() then return one_message(a.report.at(0).message)
    if !b.ok() then return one_message(b.report.at(0).message)

    units.push(a.program)
    units.push(b.program)

    val done = analyze_bodies(units, host_target())

    for i in 0..<done.reported.len()
        out.push(done.reported.at(i).diag.message)

    out
end across

private one_message(text: string) -> Buf[string]
    var out: Buf[string] = buf()

    out.push(text)
    out
end one_message

@test("a type reached through the module it belongs to is the constructor the bare name would be")
a_qualified_constructor()
    // The shape every C binding in the org writes: a `c` module holding the ABI structs, and the
    // pleasant layer above it naming one in call position.
    assert_eq(across("module m.c\n\nstruct Buffer\n    p: usize\n    n: usize\n",
                     "module m\n\nimport m.c\n\nf(n: usize) -> usize = c.Buffer(0, n).n\n").len(), 0)

    // A simple enum's checked cast and a constrained type's, which take the same road.
    assert_eq(across("module m.c\n\nenum Mode\n    Off\n    On\n",
                     "module m\n\nimport m.c\n\nf(n: int) -> c.Mode = c.Mode(n)\n").len(), 0)

@test("'%s' takes a string, and a scalar is a mistake in the specifier rather than a value to convert")
a_string_specifier_over_a_scalar()
    assert_eq(only("f(n: int) -> string = format(n, \"%s\")\n"),
              "format '%s' expects a string, but the value has type int")
    assert_eq(only("f(b: bool) -> string = format(b, \"%s\")\n"),
              "format '%s' expects a string, but the value has type bool")

    // A string is what it asks for, and every other conversion is left alone.
    assert_eq(count("f(s: string) -> string = format(s, \"%s\")\n"), 0)
    assert_eq(count("f(n: int) -> string = format(n, \"%d\")\n"), 0)

@test("a member's default is read where the member was written, not where the call is")
a_member_default_reads_its_own_module()
    // The shape every binding with a defaulted enum parameter writes: the default names something
    // the *declaring* file imported, and a consumer that leaves the argument out has never heard of
    // it. Read in the caller's terms it is an undefined name in every module but the one it is in.
    val lib = "module m.lib\n" +
              "\n" +
              "enum Kind\n" +
              "    Plain\n" +
              "    Fancy\n" +
              "\n" +
              "struct Canvas\n" +
              "    n: int\n" +
              "\n" +
              "    paint(self, kind: Kind = Kind.Plain) -> int = self.n\n"

    assert_eq(across(lib, "module m\n\nimport m.lib.Canvas\n\nf(c: Canvas) -> int = c.paint()\n").len(),
              0)

    // And the argument written out is unaffected, which is what says the two roads agree.
    assert_eq(across(lib, "module m\n\nimport m.lib.{Canvas, Kind}\n\n" +
                          "f(c: Canvas) -> int = c.paint(Kind.Fancy)\n").len(), 0)

// -- a special form written with a type argument --------------------------------------------------
//
// **`va_arg[int](ap)` is the one this exists for.** Everywhere else the annotation that stands in is
// a word on a binding that was going to be written anyway, and a variadic body reading its tail
// straight into `print` has no binding at all. `ptr_cast[T](p)` is the same shape from the raw tier:
// both take their type from what receives the value, so writing it in the brackets is writing it
// where the value is made.
//
// `gc` is the repository. `ptr_cast[*Obj](m.vals[1]).tag` was read as a call of something uncallable
// -- and, being an argument of a generic call, the refusal was swallowed and the body left out, so
// what a build reported was an undefined symbol at the C link rather than a diagnostic.
@test("'ptr_cast' takes the type it is given in brackets")
ptr_cast_with_a_written_type()
    assert_eq(count("struct Obj\n    tag: int\n\nf(p: *u8) -> int = ptr_cast[*Obj](p).tag\n"), 0)

@test("and a pointer to a pointer nests, since '*' is one spelling in both grammars")
ptr_cast_to_a_pointer_to_a_pointer()
    assert_eq(count("f(p: *u8) -> *u8 = ptr_cast[**u8](p)[0]\n"), 0)

@test("a form that takes no type argument is told so, rather than reported as uncallable")
a_special_form_with_no_type_arguments()
    assert_eq(only("f(n: int)\n    print[int](n)\n"), "'print' takes no type arguments")

@test("and a local of the name stands in front of the form, as it does without the brackets")
a_local_shadows_a_special_form()
    assert_eq(only("f(ptr_cast: int)\n    ptr_cast[int](1)\n"),
              "this is not something that can be called")

// A slice, a `weak`, a `volatile`, a vector and a callable have no spelling here at all -- their
// syntax is the type grammar's and the brackets read the expression one, so most of them do not even
// parse. What reaches the refusal is something that parses as an expression and is not a type.
@test("a type argument has to be one the expression grammar can spell")
a_type_argument_with_no_spelling()
    assert_eq(only("g(n: int) -> int = n\n\nf(p: *u8)\n    val q = ptr_cast[g(1)](p)\n"),
              "this is not a type — what is written in the brackets is a type argument, and they " +
              "read it out of the expression grammar, so a slice, a 'weak', a 'volatile', a " +
              "vector and a callable have no spelling here. Annotate what receives the result and " +
              "let the call infer it instead")

// -- an associated function reached through a generic type's name ---------------------------------
//
// **A generic type has no instance under its bare key**, an instance being keyed by its arguments
// mangled on, so `Vector.zeros(n)` used to be reported as an undefined name -- which is about the
// wrong thing entirely. The name is fine; what is missing is which `Vector`, and that is settled the
// way a generic function's call settles it: by what the arguments say, and then by what receives the
// result.
//
// `linalg` and `fft` are the repositories, and between them 124 diagnostics came from this one
// reading.
@test("an associated function on a generic type takes the instantiation from the arguments")
an_associated_call_solved_by_its_arguments()
    assert_eq(count("struct Gen[T]\n    v: T\n\n    of(v: T) -> Gen[T] = Gen(v)\n\n" +
                    "f() -> int\n    val g = Gen.of(7)\n\n    g.v\n"), 0)

@test("and from what receives the result, where the arguments say nothing")
an_associated_call_solved_by_its_position()
    assert_eq(count("struct Gen[T]\n    v: T\n\n    zero() -> Gen[int] = Gen(0)\n\n" +
                    "f() -> Gen[int] = Gen.zero()\n"), 0)

@test("and where neither says, the refusal is about the type argument rather than about the name")
an_associated_call_nothing_settles()
    assert_eq(only("struct Gen[T]\n    v: T\n\n    zero() -> Gen[int] = Gen(0)\n\n" +
                   "f() -> int = Gen.zero().v\n"),
              "cannot infer the type argument 'T' of 'Gen' here — annotate the expected type")

// -- a conversion to a type parameter -------------------------------------------------------------
//
// **`T(b)` is `u8(x)` read the other way, and it is checked at the same moment.** A generic body is
// read once at its definition with the parameter opaque, where nothing about the conversion can be
// decided; every instantiation reads the body again with a type in place of the parameter, and that
// reading is the ordinary check between two concrete types. So the parameter admits the conversion
// here and the instantiation is what refuses a bad one.
//
// A parameter is asked about ahead of every declaration table, being the nearer binding: a name
// cannot mean the parameter in type position and a declaration in call position.
@test("a type parameter in call position is a conversion, as a written type name is")
converting_to_a_type_parameter()
    assert_eq(count("f[T](n: usize) -> T = T(n)\n"), 0)
