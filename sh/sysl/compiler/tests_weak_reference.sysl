module sh.sysl.compiler
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.Search
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture

// `weak T` -- the reference that does not keep its referent alive (`reference/memory.md § weak T --
// breaking cycles`). The feature is two conversions and one call: a `&T` becomes a `weak T` wherever
// one is asked for, `get()` asks the box whether the object is still there and hands back
// `Option[&T]`, and `None` is what an empty one is written as. Everything else about it is what the
// box's third header word does at run time, which is what the run tests here are for: an assertion
// about emitted text cannot tell a count that is taken from one that is taken twice.
//
// **Every output, every refusal and every line of LLVM quoted here was read out of the reference
// compiler (0.0.152)**, whose `WeakReferenceTests` these are.

// Every claim here is about a whole program, so all of them want the library and a toolchain.
private wkr_ready() -> bool
    std_root() match
        Err(_) ->
            print("skipped: the standard module's source is not on this machine")
            return false
        Ok(_) -> ()

    if !clang_available()
        print("skipped: there is no clang on this machine")
        return false

    true
end wkr_ready

// **What a program PRINTS and what it EXITS with**, from a fresh build. A program that did not build
// answers `-1` and the refusal, so a build failure cannot read as a program that stopped.
private wkr_ran(text: string) -> (string, int)
    val root = make_temp_dir("sysl-weak-reference").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", text).unwrap()

    val exe = s"$root/built"

    build_native_program(s"$root/main.sysl", None, None, DefaultOptimization, Some(exe)) match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return (failure_text(why), -1)
        Ok(_) -> ()

    val said = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    said match
        Err(_) -> ("the program that was built could not be run", -1)
        Ok(out) -> out.status match
            Exited(code) -> (out.text, code)
            _ -> (out.text, -2)
end wkr_ran

private wkr_prints(text: string, expected: string)
    if !wkr_ready() then return

    val ran = wkr_ran(text)

    assert_eq(ran.0, expected)
    assert_eq(ran.1, 0)

// Everything a source has to say for itself, taken the whole way through the lowering; the LLVM text
// where it had nothing to say.
private wkr_lowered(text: string) -> (string, string)
    val root = make_temp_dir("sysl-weak-reference").unwrap()
    val src = s"$root/main.sysl"

    make_dir_all(root).unwrap()
    write_text(src, text).unwrap()

    val out = emit_llvm_text(src, None) match
        Err(why) -> (failure_text(why), "")
        Ok(made) -> if made.report.is_empty() then ("", made.text) else (analysis_report(made.report), "")

    remove_dir_all(root).unwrap_or(())
    out
end wkr_lowered

// A refusal is its whole first line and its position; the `-->` line carries the temporary
// directory, so the position is read from the end of it. The caret's WIDTH is not asserted: this
// compiler underlines a node's extent where the reference underlines its anchor.
private wkr_refused(text: string, message: string, at: string)
    if !wkr_ready() then return

    val said = wkr_lowered(text).0

    assert(said.starts_with(s"error: $message\n"), said)
    assert(said.contains(s"main.sysl:$at\n"), said)

private wkr_llvm(text: string) -> string
    val out = wkr_lowered(text)

    assert_eq(out.0, "")
    out.1

private wkr_main_of(llvm: string) -> string
    val texts = func_texts(llvm)

    for i in 0..<texts.len()
        if texts.at(i).0 == "main" then return texts.at(i).1

    "no definition of 'main'"
end wkr_main_of

private wkr_held() -> string = raw"""
    struct Node
        value: int
    var r: &Node = Node(1)
    var w: weak Node = r
    print(w.get().is_some())
    """

private wkr_unheld() -> string = raw"""
    struct Node
        value: int
    var r: &Node = Node(1)
    print(r.value)
    """

// -- a reference becomes weak wherever a weak one is asked for ------------------------------------

@test("a field of a struct being constructed")
wkr_a_field_of_a_struct_being_constructed()
    wkr_prints(raw"""
        struct Node
            value: int
            up: weak Node
        var r: &Node = Node(1, None)
        var k: &Node = Node(2, r)
        print(k.up.get().unwrap().value)
        """, "1\n")

@test("an argument")
wkr_an_argument()
    wkr_prints(raw"""
        struct Node
            value: int
        peek(w: weak Node) -> int = w.get().unwrap().value
        var r: &Node = Node(5)
        print(peek(r))
        """, "5\n")

@test("a declared local, and an assignment into one")
wkr_a_declared_local_and_an_assignment()
    wkr_prints(raw"""
        struct Node
            value: int
        var r: &Node = Node(3)
        var s: &Node = Node(4)
        var w: weak Node = r
        print(w.get().unwrap().value)
        w = s
        print(w.get().unwrap().value)
        """, "3\n4\n")

@test("a returned value")
wkr_a_returned_value()
    wkr_prints(raw"""
        struct Node
            value: int
        weaken(r: &Node) -> weak Node = r
        var r: &Node = Node(9)
        print(weaken(r).get().unwrap().value)
        """, "9\n")

@test("and an element of a slice of them")
wkr_an_element_of_a_slice()
    wkr_prints(raw"""
        struct Node
            value: int
        var r: &Node = Node(1)
        var s: &Node = Node(2)
        var ws: []weak Node = [r, s]
        print(ws[0].get().unwrap().value, ws[1].get().unwrap().value)
        """, "1 2\n")

// The chapter says a weak reference is written "in the same places" the other two modes are, which
// makes the positions above a sample and not the list. These are the rest of the places a '&T'
// reaches: an array element, a tuple part, a generic argument, and the parameter of a callable type
// -- the last being a separate mechanism from a bare arrow rather than a spelling of it.
@test("an array element, a tuple part, and a generic argument")
wkr_an_array_element_a_tuple_part_a_generic_argument()
    wkr_prints(raw"""
        struct Node
            value: int
        var r: &Node = Node(1)
        var s: &Node = Node(2)
        var arr: [2]weak Node = [r, s]
        var tu: (weak Node, int) = (r, 3)
        var op: Option[weak Node] = Some(s)
        print(arr[1].get().unwrap().value, tu.0.get().unwrap().value, tu.1)
        print(op.unwrap().get().unwrap().value)
        """, "2 1 3\n2\n")

@test("the parameter of a callable type")
wkr_the_parameter_of_a_callable_type()
    wkr_prints(raw"""
        struct Node
            value: int
        peek(w: weak Node) -> int = w.get().unwrap().value
        var r: &Node = Node(7)
        var f: &Fn(weak Node) -> int = peek
        print(f(r))
        """, "7\n")

// A default is produced afresh at each call that omits it, in a scope holding no locals, so what it
// names has to outlive every frame. A top-level 'var' is a local of the entry point, so a default
// reading one is reading the caller's locals -- which is what the scope emptied for defaults is
// there to prevent.
//
// The reference (0.0.152) says a second thing at the same position after this one -- that
// 'fallback' "is bound after the nested functions of this block begin" -- which this compiler does
// not say; the case asserts the first, as the reference's own does.
@test("though not a top-level 'var', which is a local of the caller however far above it is written")
wkr_a_default_does_not_reach_a_top_level_var()
    wkr_refused(raw"""
        struct Node
            value: int
        var fallback: &Node = Node(4)
        peek(w: weak Node = fallback) -> int = w.get().unwrap().value
        print(peek())
        """, "undefined name 'fallback'", "4:21")

// Module storage holds a count it never gives back, so the referent is alive for the whole run --
// which is exactly what a default naming it needs, and is why this answers `4` rather than the empty
// weak reference `get()` would otherwise hand back.
@test("while a module-level 'val' does, and its referent is alive for the whole run")
wkr_a_default_reaches_a_module_level_val()
    wkr_prints(raw"""
        struct Node
            value: int
        static val fallback: &Node = Node(4)
        peek(w: weak Node = fallback) -> int = w.get().unwrap().value
        print(peek())
        """, "4\n")

// -- and only a reference does --------------------------------------------------------------------

// The value would be boxed and the weak edge would be the only thing holding the box, so the object
// would be gone before the statement finished.
@test("a construction with nowhere else to live is refused, and says where to put it")
wkr_a_construction_with_nowhere_else_to_live()
    wkr_refused(raw"""
        struct Node
            value: int
        var w: weak Node = Node(1)
        """, "a weak reference does not keep Node alive, and nothing else here holds this one — so it " +
        "would be gone before it could be read. Hold it in a '&Node' first, and weaken that", "3:20")

// The advice has to be writable: `weak T` already means a weak edge to a counted `T`, so someone who
// wrote the `&` as well has written the mode twice -- and telling them to hold it in a `&&Node`
// would be sending them to a spelling the parser does not take, `&&` being one token.
@test("a doubled mode is told what it already means, not sent to a spelling that does not parse")
wkr_a_doubled_mode_is_told_what_it_already_means()
    if !wkr_ready() then return

    val doubled = raw"""
        struct Node
            value: int
        var r: &Node = Node(1)
        var w: weak &Node = r
        """

    wkr_refused(doubled, "'weak Node' is already a weak edge to a counted Node, so the '&' says the " +
                "mode a second time — write 'weak Node'", "4:21")
    assert(!wkr_lowered(doubled).0.contains("'&&Node'"))

    wkr_refused(raw"""
        struct Node
            value: int
        var r: &&Node = Node(1)
        """, "identifier expected", "3:8")
end wkr_a_doubled_mode_is_told_what_it_already_means

@test("'null' is not the empty weak reference, and the message says what is")
wkr_null_is_not_the_empty_weak_reference()
    wkr_refused(raw"""
        struct Node
            value: int
        var w: weak Node = null
        """, "'null' is a raw pointer, and an empty weak Node is written 'None' — the same thing " +
        "'get()' hands back for one", "3:20")

// `&sync` is a distinct type from `&`, so weakening one is a distinct question, and the answer is a
// chapter that is not built (`reference/memory.md § Crossing a concurrency domain`).
@test("and an atomic reference has no weak form yet")
wkr_an_atomic_reference_has_no_weak_form_yet()
    wkr_refused(raw"""
        struct Node
            value: int
        var w: weak sync Node = None
        """, "an atomic reference has no weak form yet — 'weak sync T' wants the concurrency model " +
        "of '06', which is not built", "3:8")

// -- a weak reference may be module storage, as any counted value may -----------------------------

// A weak one keeps nothing alive, so the storage outlives the run and the object it names does not
// have to.
@test("directly, and it is empty once its referent has gone")
wkr_module_storage_directly()
    wkr_prints(raw"""
        struct Node
            value: int
        weaken(r: &Node) -> weak Node = r
        hold() -> weak Node
            var r: &Node = Node(1)
            weaken(r)
        static val w: weak Node = hold()
        val state = w.get() match
            Some(_) -> "live"
            None -> "gone"
        print(state)
        """, "gone\n")

@test("and inside a struct, which is the recursive half of the same rule")
wkr_module_storage_inside_a_struct()
    wkr_prints(raw"""
        struct Node
            value: int
        struct Slot
            back: weak Node
        end Slot
        mk(r: &Node) -> Slot = Slot(r)
        keep() -> Slot
            var r: &Node = Node(1)
            mk(r)
        static val s: Slot = keep()
        val state = s.back.get() match
            Some(_) -> "live"
            None -> "gone"
        print(state)
        """, "gone\n")

// -- 'get()' is the only thing a weak reference answers -------------------------------------------

@test("so a field of the referent is not read through one")
wkr_a_field_is_not_read_through_one()
    wkr_refused(raw"""
        struct Node
            value: int
            up: weak Node
        var r: &Node = Node(1, None)
        print(r.up.value)
        """, "a weak Node may be gone, so nothing is read off one directly — 'get()' hands back " +
        "'Option[&Node]', and 'value' is read off what is inside it", "5:12")

@test("nor is a method of it called through one")
wkr_a_method_is_not_called_through_one()
    wkr_refused(raw"""
        struct Node
            value: int
            twice(self) -> int = self.value * 2
        var r: &Node = Node(1)
        var w: weak Node = r
        print(w.twice())
        """, "a weak Node has no method 'twice' — a weak reference may be gone, so 'get()' is the " +
        "only thing to ask one, and what it hands back is what has methods", "6:9")

@test("and 'get' takes nothing")
wkr_get_takes_nothing()
    wkr_refused(raw"""
        struct Node
            value: int
        var r: &Node = Node(1)
        var w: weak Node = r
        print(w.get(1))
        """, "'get' takes no arguments", "5:9")

// What comes back is an ordinary `Option`, so the whole of its surface applies with no rule of its
// own -- which is the reason for handing back one rather than inventing a form.
@test("what it hands back is an ordinary Option")
wkr_what_it_hands_back_is_an_ordinary_option()
    wkr_prints(raw"""
        struct Node
            value: int
        var r: &Node = Node(6)
        var w: weak Node = r
        print(w.get().is_some(), w.get().unwrap_or(r).value)
        """, "true 6\n")

// -- the object goes when its strong references do, and the weak one says so ----------------------

// The whole of the feature in one program: inside the block a strong reference holds the object and
// `get()` finds it, outside there is none and `get()` finds nothing. A weak edge that kept the
// object alive would print `true` twice; one that dangled would not print at all.
@test("a weak reference reads 'None' once the last strong one is gone")
wkr_reads_none_once_the_last_strong_one_is_gone()
    wkr_prints(raw"""
        struct Node
            value: int
        var w: weak Node = None
        if true
            var n: &Node = Node(7)
            w = n
            print("inside", w.get().is_some())
        print("after", w.get().is_some())
        """, "inside true\nafter false\n")

@test("and holding it weakly is not holding it")
wkr_holding_it_weakly_is_not_holding_it()
    wkr_prints(raw"""
        struct Node
            value: int
        var w: weak Node = None
        var v: weak Node = None
        if true
            var n: &Node = Node(7)
            w = n
            v = n
        print(w.get().is_some(), v.get().is_some())
        """, "false false\n")

// The referent's storage outlives the object exactly as long as a weak reference is still asking
// about it, so reading a dead one is a load rather than a fault -- the run is what shows that, since
// a use-after-free would as often as not print the old value.
@test("asking a dead one is safe, however many times it is asked")
wkr_asking_a_dead_one_is_safe()
    wkr_prints(raw"""
        struct Node
            value: int
        var w: weak Node = None
        if true
            var n: &Node = Node(7)
            w = n
        var i = 0
        var seen = 0
        while i < 100000
            if w.get().is_some() then seen += 1
            i += 1
        print(seen)
        """, "0\n")

// The cycle ARC cannot reclaim, made reclaimable. Both objects come back every iteration, so a
// hundred thousand of them fit in whatever memory the test machine has; with the back-edge written
// `&Node` instead, none of them ever would.
@test("a parent-and-child cycle comes apart when the back-edge is weak")
wkr_a_cycle_comes_apart_when_the_back_edge_is_weak()
    wkr_prints(raw"""
        struct Node
            value: int
            up: weak Node
            down: Option[&Node]
        pair(v: int) -> int
            var p: &Node = Node(v, None, None)
            var c: &Node = Node(v + 1, p, None)
            p.down = Some(c)
            return c.up.get().unwrap().value
        end pair
        var i = 0
        while i < 100000
            if pair(i) != i then
                print("wrong")
                exit(1)
            i += 1
        print("ok")
        """, "ok\n")

// The other half of that pair, and the half a program can use: with the back-edge strong the objects
// are unreachable and still alive, and a weak reference is the only thing that can say so. Both
// functions build two objects the same way and drop every reference from outside; only the
// back-edge differs, so a `weak` that answered `true` for both would be reporting on nothing.
@test("and stands, observably, when it is not — which is how a leak is counted at all")
wkr_a_cycle_stands_observably_when_it_is_not()
    wkr_prints(raw"""
        struct Node
            value: int
            next: Option[&Node]
        cycle() -> weak Node
            var a: &Node = Node(1, None)
            var b: &Node = Node(2, None)
            a.next = Some(b)
            b.next = Some(a)
            var w: weak Node = a
            w
        end cycle
        chain() -> weak Node
            var a: &Node = Node(1, None)
            var b: &Node = Node(2, None)
            a.next = Some(b)
            var w: weak Node = a
            w
        end chain
        var leaked: weak Node = cycle()
        var freed: weak Node = chain()
        print(leaked.get().is_some(), freed.get().is_none())
        print(leaked.get().unwrap().value)
        """, "true true\n1\n")

// -- an empty weak reference is written the way an empty answer reads -----------------------------

@test("'None' makes one, and 'get()' gives the same 'None' back")
wkr_none_makes_one()
    wkr_prints(raw"""
        struct Node
            value: int
        var w: weak Node = None
        print(w.get().is_none())
        """, "true\n")

@test("a struct is built with one, and a field of one is emptied by assigning it")
wkr_a_struct_is_built_with_one()
    wkr_prints(raw"""
        struct Node
            value: int
            up: weak Node
        var r: &Node = Node(1, None)
        var k: &Node = Node(2, r)
        print(k.up.get().is_some())
        k.up = None
        print(k.up.get().is_some())
        """, "true\nfalse\n")

// A struct declared with no initializer starts at its zero value, and a weak field's zero has to be
// the empty reference rather than an address nothing wrote -- the run is what shows it, since the
// difference between the two is a fault.
@test("and a weak field of a zero-valued struct is empty rather than wild")
wkr_a_weak_field_of_a_zero_valued_struct_is_empty()
    wkr_prints(raw"""
        struct Node
            value: int
            up: weak Node
        var z: Node
        print(z.value, z.up.get().is_none())
        """, "0 true\n")

// -- a weak reference is a value like any other, and counted like one -----------------------------

// Copying one takes a share of the *weak* count, which is what keeps the storage there for the copy
// to read; a copy that took nothing would leave the second reader looking at freed bytes.
@test("copying one keeps the storage there for the copy")
wkr_copying_one_keeps_the_storage_there()
    wkr_prints(raw"""
        struct Node
            value: int
        var w: weak Node = None
        if true
            var n: &Node = Node(7)
            w = n
        var i = 0
        while i < 100000
            var c = w
            if c.get().is_some() then
                print("alive")
                exit(1)
            i += 1
        print("ok")
        """, "ok\n")

@test("one held inside an enum comes apart with it")
wkr_one_held_inside_an_enum()
    wkr_prints(raw"""
        struct Node
            value: int
        enum Edge
            Up(w: weak Node)
            Root
        var r: &Node = Node(3)
        var e = Up(r)
        var seen = e match
            Up(w) -> w.get().unwrap().value
            Root -> 0
        print(seen)
        """, "3\n")

@test("and a trait object may be held weakly too")
wkr_a_trait_object_may_be_held_weakly()
    wkr_prints(raw"""
        trait Speak
            say(self) -> int
        struct Dog
            n: int
        impl Speak for Dog
            say(self) -> int = self.n
        var d: &Speak = Dog(4)
        var w: weak Speak = d
        print(w.get().unwrap().say())
        """, "4\n")

@test("an array of them is a field like any other")
wkr_an_array_of_them_is_a_field()
    wkr_prints(raw"""
        struct Node
            value: int
            kin: [2]weak Node
        var a: &Node = Node(1, [None, None])
        print(a.kin[0].get().is_none())
        """, "true\n")

@test("an Option may hold one, since nothing about it is special downstream")
wkr_an_option_may_hold_one()
    wkr_prints(raw"""
        struct Node
            value: int
        var a: &Node = Node(1)
        var w: weak Node = a
        var o = Some(w)
        print(o.unwrap().get().unwrap().value)
        """, "1\n")

// The read takes a share before the write gives one back, so the one count in play is not the one
// being dropped -- the same ordering an assignment between two `&T` needs, reached here through the
// weak count instead.
@test("and assigning one to itself keeps it")
wkr_assigning_one_to_itself_keeps_it()
    wkr_prints(raw"""
        struct Node
            value: int
        var a: &Node = Node(1)
        var w: weak Node = a
        w = w
        print(w.get().unwrap().value)
        """, "1\n")

// -- what a weak reference is not -----------------------------------------------------------------

// The three modes are ways of *holding* a type, and only one of them is refused as an `impl` subject
// for a reason of its own: a member call reaches through a `*T` and a `&T`, and through a weak
// reference it reaches nothing.
@test("an 'impl' may not be written for one")
wkr_an_impl_may_not_be_written_for_one()
    wkr_refused(raw"""
        trait Show
            show(self) -> string
        struct Node
            value: int
        impl Show for weak Node
            show(self) -> string = "x"
        """, "'weak Node' is a way of holding a Node rather than a type of its own — and nothing goes " +
        "through one but 'get()', so a member written here could never be called. Write the 'impl' " +
        "for Node, which 'get()' hands back", "5:1")

// Two weak references to one object are equal in a sense the machine can answer, and two to objects
// that are both gone are a question it cannot -- so the catalog leaves weak references out and the
// comparison is written on what `get()` hands back.
@test("'==' is not defined on one")
wkr_equality_is_not_defined_on_one()
    wkr_refused(raw"""
        struct Node
            value: int
        var a: &Node = Node(1)
        var w: weak Node = a
        var v: weak Node = a
        print(w == v)
        """, "'==' is not defined for weak Node", "6:7")

@test("and neither is printing one")
wkr_neither_is_printing_one()
    wkr_refused(raw"""
        struct Node
            value: int
        var a: &Node = Node(1)
        var w: weak Node = a
        print(w)
        """, "cannot print a weak Node value — it does not implement 'sysl.Display'", "5:1")

// `reference/modules.md § Visibility` -- a declaration may not be more visible than the types it
// names, and the mode in front of a name changes nothing about which names it holds.
@test("a public field may not name a private type through one")
wkr_a_public_field_may_not_name_a_private_type()
    wkr_refused(raw"""
        private struct Hidden
            v: int
        struct Open
            up: weak Hidden
        """, "'Open.up' is public, but its type names 'Hidden', which is private to 'main.sysl', the " +
        "file that declares it — a declaration may not be more visible than the types it names", "4:14")

// -- what a weak reference is generic over, and what holds it up ----------------------------------

@test("a type parameter may be weakened, and a '&T' argument settles it")
wkr_a_type_parameter_may_be_weakened()
    wkr_prints(raw"""
        struct Node
            value: int
        alive[T](w: weak T) -> bool = w.get().is_some()
        var a: &Node = Node(1)
        print(alive(a))
        """, "true\n")

@test("a generic type may be held weakly at one instantiation")
wkr_a_generic_type_may_be_held_weakly()
    wkr_prints(raw"""
        struct Box[T]
            v: T
        var b: &Box[int] = Box(3)
        var w: weak Box[int] = b
        print(w.get().unwrap().v)
        """, "3\n")

// Whatever a `&T` may point at, a `weak T` may be taken of -- a scalar and an array included, since
// both are things the language boxes.
@test("and so may anything else a reference points at")
wkr_so_may_anything_else_a_reference_points_at()
    wkr_prints(raw"""
        var a: &[3]int = [1, 2, 3]
        var w: weak [3]int = a
        print(w.get().unwrap()[0])
        """, "1\n")

// Returning one is legal and answers honestly: the object was alive when the reference was weakened
// and gone by the time the caller looked, which is the state the form exists to report rather than a
// mistake to refuse.
@test("a weak reference to something only the callee held reads empty at the caller")
wkr_only_the_callee_held_reads_empty_at_the_caller()
    wkr_prints(raw"""
        struct Node
            value: int
        make() -> weak Node
            var n: &Node = Node(4)
            return n
        end make
        print(make().get().is_some())
        """, "false\n")

// -- what the box carries, and who pays for it ----------------------------------------------------

// The third word is in every box whether or not the program holds a weak reference, because
// releasing one is type-erased and two layouts would need a word to tell them apart
// (`reference/memory.md § What a heap object costs`).
@test("every box carries the weak count, weak reference or not")
wkr_every_box_carries_the_weak_count()
    if !wkr_ready() then return

    assert(wkr_llvm(wkr_unheld()).contains("\n%arc.Node = type { i64, ptr, i64, %struct.Node }\n"))

@test("and so does a buffer, whose elements come after it")
wkr_so_does_a_buffer()
    if !wkr_ready() then return

    val out = wkr_llvm(raw"""
        f(n: usize) -> []int = [0; n]
        print(f(2usize).len)
        """)

    assert(out.contains("\n%arc.buf.int = type { i64, ptr, i64, i64, [0 x i32] }\n"))
end wkr_so_does_a_buffer

// The three functions that *read* that word are another matter: only a program with a weak reference
// in it calls them, so only one gets them.
@test("the three functions that read it are emitted only where one is held")
wkr_the_three_functions_only_where_one_is_held()
    if !wkr_ready() then return

    val without = wkr_llvm(wkr_unheld())

    assert(!without.contains("@arc.upgrade"))
    assert(!without.contains("@arc.weak_retain"))
end wkr_the_three_functions_only_where_one_is_held

@test("and are emitted where one is")
wkr_and_are_emitted_where_one_is()
    if !wkr_ready() then return

    val out = wkr_llvm(wkr_held())

    assert(out.contains("define private ptr @arc.upgrade(ptr %p) {\n"))
    assert(out.contains("  call void @arc.weak_retain(ptr"))
    assert(out.contains("  call void @arc.weak_release(ptr"))
end wkr_and_are_emitted_where_one_is

// Weakening touches the third word and leaves the first alone -- that asymmetry *is* the feature, so
// it is pinned in the text as well as in the runs above. The registers are the reference's own.
@test("weakening takes a weak share and no strong one")
wkr_weakening_takes_a_weak_share_and_no_strong_one()
    if !wkr_ready() then return

    val body = wkr_main_of(wkr_llvm(wkr_held()))

    assert(body.contains("  call void @arc.weak_retain(ptr %t8)\n  store ptr %t8, ptr %w.addr\n"), body)
    assert(!body.contains("call void @arc.retain(ptr %t8)"), body)
end wkr_weakening_takes_a_weak_share_and_no_strong_one
