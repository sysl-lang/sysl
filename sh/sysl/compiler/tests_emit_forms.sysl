@test("'rotate_right' lowers to what the reference emits for it")
a_rotation_by_a_literal_is_the_instruction_behind_it()
    if no_form_library() then return

    assert_eq(form_lowered(
                  "import sysl.math.{Bits, Signed}\n" +
                  "\n" +
                  "pop(x: u32) -> u32 = x.count_ones()\n" +
                  "\n" +
                  "lead(x: u32) -> u32 = x.leading_zeros()\n" +
