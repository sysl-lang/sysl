module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// The pattern grammar.
//
// **A pattern is matched against a type it already knows**, which is what separates it from an
// expression at nearly every turn: there is no leading dot, because there is no expected type to
// read one from; a bare name binds rather than reads; and a name that is *not* a binding is written
// in backticks, which is the whole of what the quoting means here.
//
// **A `|` may stand at any position inside a pattern**, as Rust allows: `Some(1 | 2)`, `(0, 'a' |
// 'b')`, `Point { x: 0 | 1, y }`, and a parenthesised group `n @ (1 | 2)`. Each one is spread out here
// into alternatives of the arm itself -- `Some(1 | 2)` is read as `Some(1) | Some(2)` -- so that the
// rest of the compiler sees only the one form it already knew, an arm's list of alternatives, and
// coverage, binding and emission each say once what an alternative means.
//
// The spreading multiplies: `(1 | 2, 3 | 4)` is four alternatives. Past `spread_limit` of them a
// pattern is refused rather than read, since a table that size is no longer a pattern anybody means.
const spread_limit: usize = 1024

// A pattern where only one may stand -- a `val`, a `for`. A `|` inside it is refused here, since a
// binding takes one shape of a value apart and has no other arm to try.
parse_pattern(p: *Parser) -> Pattern
    val start = p.here()
    val alts = parse_pattern_alts(p)

    if alts.len() > 1 then
        p.fault(start.to(p.just_taken()), "alternatives joined by '|' are written in a 'match' arm or " +
                "an 'is' test \u{2014} a binding takes one shape of a value apart")

    alts[0]
end parse_pattern

// A pattern, as the alternatives every `|` written inside it spreads it into -- one, where there is
// none. The arm's own `|`s, between whole patterns, are the caller's.
parse_pattern_alts(p: *Parser) -> Buf[Pattern]
    val start = p.here()

    // A leading dot is the expression form, and somebody who wrote one is owed the difference
    // rather than a refusal about a token.
    if p.at_kw(".") && names_a_name(p.peek_at(1))
        p.bump()

        val n = p.name() match
            Some(x) -> x
            None -> ""

        p.fault(start.to(p.just_taken()),
            s"a pattern is matched against a type it already knows, so the variant is written '${n}' " +
            "with no leading dot \u{2014} the dot is for an expression, where the type comes from what " +
            "the context expects")

        return one(pattern_of(start.to(p.just_taken()), IdentPattern(n)))
    end if

    if p.at_kw("(") then return parse_tuple_pattern(p, start)

    if p.at_wildcard()
        p.bump()
        return one(pattern_of(p.just_taken(), WildcardPattern))

    if names_a_name(p.peek()) then return parse_named_pattern(p, start)

    one(parse_literal_pattern(p, start))
end parse_pattern_alts

private one(x: Pattern) -> Buf[Pattern]
    var out: Buf[Pattern] = buf()

    out.push(x)
    out

private names_a_name(t: Tok) -> bool = t match
    Ident(_) -> true
    QuotedIdent(_) -> true
    _ -> false

// One position inside a pattern -- a field, a tuple's part, a variant's argument -- which may hold
// `|`-alternatives of its own, each spread as `parse_pattern_alts` spreads. Whether a `|` was written
// is the second half, which is what tells a parenthesised group from a one-part tuple.
private parse_position(p: *Parser) -> (Buf[Pattern], bool)
    var out = parse_pattern_alts(p)
    var barred = false

    while p.accept_kw("|")
        barred = true

        for item in parse_pattern_alts(p)
            out.push(item)

    (out, barred)
end parse_position

// Every way of choosing one alternative from each position, in order: the positions' product. `None`
// past `spread_limit`, which the caller refuses at the pattern it was spreading.
private spread(parts: Buf[Buf[Pattern]]) -> Option[Buf[Buf[Pattern]]]
    var rows: Buf[Buf[Pattern]] = buf()

    rows.push(buf())

    for part in parts
        if rows.len() * part.len() > spread_limit then return None

        var next: Buf[Buf[Pattern]] = buf()

        for row in rows
            for alt in part
                var grown: Buf[Pattern] = buf()

                for item in row
                    grown.push(item)

                grown.push(alt)
                next.push(grown)

        rows = next

    Some(rows)
end spread

// The positions spread, or the refusal at `at` and the first alternative of each, so that reading
// goes on.
private spread_or_refuse(p: *Parser, at: Span, parts: Buf[Buf[Pattern]]) -> Buf[Buf[Pattern]]
    spread(parts) match
        Some(rows) -> rows
        None ->
            p.fault(at, s"this pattern spreads into more than $spread_limit alternatives \u{2014} split " +
                    "it across arms, or match its parts one at a time")

            var row: Buf[Pattern] = buf()

            for part in parts
                row.push(part[0])

            var rows: Buf[Buf[Pattern]] = buf()

            rows.push(row)
            rows
end spread_or_refuse

// `(a, b)` -- two or more parts, since one part is not a tuple -- and `(a | b)`, a group, which is
// what a `|` in one part makes it.
private parse_tuple_pattern(p: *Parser, start: Span) -> Buf[Pattern]
    p.bump()

    var parts: Buf[Buf[Pattern]] = buf()
    var barred = false

    if !p.at_kw(")")
        loop
            val part = parse_position(p)

            parts.push(part.0)
            barred = barred || part.1

            if !p.accept_kw(",") then break
            if p.at_kw(")") then break

    p.expect_kw(")")

    val at = start.to(p.just_taken())

    if parts.len() == 1
        if barred then return parts[0]

        // The reference anchors this at the token after the ')', where the reading learned it had
        // one part.
        p.fault(p.here(), "a tuple pattern matches two or more parts \u{2014} one part is not a tuple")
        return parts[0]
    end if

    if parts.is_empty() then return one(pattern_of(at, TuplePattern(buf())))

    var out: Buf[Pattern] = buf()

    for row in spread_or_refuse(p, at, parts)
        out.push(pattern_of(at, TuplePattern(row)))

    out
end parse_tuple_pattern

// A name, and everything written after one: a binding, a variant's fields, a struct's fields, or
// nothing at all.
private parse_named_pattern(p: *Parser, start: Span) -> Buf[Pattern]
    var name = ""
    var quoted = false
    var dotted = false

    loop
        p.peek() match
            Ident(n) ->
                p.bump()
                name = if name == "" then n else name + "." + n
                quoted = false
            QuotedIdent(n) ->
                p.bump()
                name = if name == "" then n else name + "." + n
                quoted = true
            _ -> break

        if !p.at_kw(".") then break
        if !names_a_name(p.peek_at(1)) then break

        p.bump()
        dotted = true

    // `n @ 1..9` -- a name bound to whatever the inner pattern matched. `n @ (1 | 2)` binds it to
    // whichever alternative did, so each alternative carries the name.
    if p.at_kw("@")
        val sigil = p.here()

        p.bump()

        val inner = parse_pattern_alts(p)
        val at = start.to(p.just_taken())

        // What a binding introduces is a local, and a local has no dot in its name. The refusal sits at
        // the `@`, the reference's anchor: the dotted name is only a mistake because a binding follows.
        if dotted
            p.fault(sigil, s"'${name}' has a dot in it, and what a binding introduces is a local \u{2014} " +
                "write a name a program can declare")

        var out: Buf[Pattern] = buf()

        for item in inner
            out.push(pattern_of(at, BindPattern(name, item)))

        return out
    end if

    if p.at_kw("(")
        p.bump()

        var args: Buf[Buf[Pattern]] = buf()

        if !p.at_kw(")")
            loop
                args.push(parse_position(p).0)

                if !p.accept_kw(",") then break
                if p.at_kw(")") then break

        p.expect_kw(")")

        // `u8('a')..u8('z')` -- a conversion of a literal opening a range. A variant's field is never
        // followed by a range operator, so one here can only be the range.
        val one_lit = if args.len() == 1 && args[0].len() == 1 then literal_of(args[0][0])
        else None

        if one_lit.is_some() && !dotted
            parse_range_op(p) match
                Some(inclusive) ->
                    val hi = parse_pattern_lit(p) match
                        Some(e) -> e
                        None ->
                            p.want("expression")
                            expr(p.here(), Bad)

                    return one(pattern_of(start.to(p.just_taken()),
                                          RangePattern(conversion_of(name, one_lit.unwrap(), start), hi,
                                                       inclusive)))
                None -> ()
        end if

        val at = start.to(p.just_taken())
        var out: Buf[Pattern] = buf()

        for row in spread_or_refuse(p, at, args)
            out.push(pattern_of(at, VariantPattern(name, row)))

        return out
    end if

    if p.at_kw("{")
        p.bump()

        var names: Buf[string] = buf()
        var pats: Buf[Buf[Pattern]] = buf()

        if !p.at_kw("}")
            loop
                val f = parse_field_pattern(p)

                names.push(f.0)
                pats.push(f.1)

                if !p.accept_kw(",") then break
                if p.at_kw("}") then break

        p.expect_kw("}")

        val at = start.to(p.just_taken())
        var out: Buf[Pattern] = buf()

        for row in spread_or_refuse(p, at, pats)
            var fields: Buf[FieldPattern] = buf()

            for i in 0..<row.len()
                fields.push(FieldPattern(names[i], row[i]))

            out.push(pattern_of(at, StructPattern(name, fields)))

        return out
    end if

    val at = start.to(p.just_taken())

    // A quoted name is a *reference* to what that name already holds rather than a binding of it,
    // which is the whole of what the backticks mean in a pattern.
    if quoted then one(pattern_of(at, EqPattern(name))) else one(pattern_of(at, IdentPattern(name)))
end parse_named_pattern

// `Point { x, y: b }` -- a field's name and the alternatives it is matched by, with the short form
// being the long one with the name written once.
private parse_field_pattern(p: *Parser) -> (string, Buf[Pattern])
    val start = p.here()
    var n = reserved_here(p)

    if n != "" && (p.kw_at(1, ",") || p.kw_at(1, "}"))
        refuse_reserved_name(p, "a name a pattern binds")
    else
        n = p.name() match
            Some(x) -> x
            None -> ""
    end if

    if p.accept_kw(":") then (n, parse_position(p).0)
    else (n, one(pattern_of(start.to(p.just_taken()), IdentPattern(n))))
end parse_field_pattern

// Whether a reserved word stands where a pattern would bind a name: followed by what may follow a
// sub-pattern. `null` and `self` are value words nobody meant to bind, and are left to the ordinary
// complaint.
at_reserved_pattern_name(p: *Parser) -> bool
    val w = reserved_here(p)

    if w == "" || w == "null" || w == "self" then return false

    for f in [")", ",", "}", "->", "|", "@", "if", "=", "in"]
        if p.kw_at(1, f) then return true

    false
end at_reserved_pattern_name

// A literal, and the range a second one after `..` makes.
private parse_literal_pattern(p: *Parser, start: Span) -> Pattern
    val lo = parse_pattern_lit(p) match
        Some(e) -> e
        None ->
            // A reserved word where a pattern binds a name -- `Some(loop) -> …` -- is refused as the
            // word it is. Every pattern that may begin with one (`true`, `false`) is read above.
            if at_reserved_pattern_name(p)
                val w = reserved_here(p)

                refuse_reserved_name(p, "a name a pattern binds")
                return pattern_of(start.to(p.just_taken()), IdentPattern(w))
            end if

            p.want("a pattern")
            return pattern_of(start, WildcardPattern)

    parse_range_op(p) match
        None -> pattern_of(start.to(p.just_taken()), LitPattern(lo))
        Some(inclusive) ->
            val hi = parse_pattern_lit(p) match
                Some(e) -> e
                None ->
                    p.want("expression")
                    expr(p.here(), Bad)

            pattern_of(start.to(p.just_taken()), RangePattern(lo, hi, inclusive))
end parse_literal_pattern

// The literal a one-part pattern holds, where it is one.
literal_of(p: Pattern) -> Option[Expr] = *p.kind match
    LitPattern(v) -> Some(v)
    _ -> None

// `u8(';')` as the expression it stands for: a conversion of a literal.
conversion_of(name: string, lit: Expr, at: Span) -> Expr
    var args: Buf[Expr] = buf()

    args.push(lit)
    expr(at, Call(expr(at, Ident(name)), args))
end conversion_of

// The literals a pattern may hold, and the negative form of a number.
private parse_pattern_lit(p: *Parser) -> Option[Expr]
    val start = p.here()

    // `u8('z')` -- a conversion of a literal, as the far end of a range.
    p.peek() match
        Ident(n) ->
            if p.kw_at(1, "(")
                p.bump()
                p.bump()

                val inner = parse_pattern_lit(p)

                if inner.is_none()
                    p.want("a literal")
                    return Some(expr(start.to(p.just_taken()), Bad))
                end if

                p.expect_kw(")")
                return Some(conversion_of(n, inner.unwrap(), start.to(p.just_taken())))
            end if
        _ -> ()

    if p.at_kw("-")
        p.bump()

        val inner = parse_number_lit(p)?

        return Some(expr(start.to(p.just_taken()), Unary("-", inner)))
    end if

    p.peek() match
        IntLit(digits, base, suffix) ->
            p.bump()
            Some(expr(p.just_taken(), IntLit(digits, base, suffix)))
        FloatLit(text, suffix) ->
            p.bump()
            Some(expr(p.just_taken(), FloatLit(text, suffix)))
        CharLit(c) ->
            p.bump()
            Some(expr(p.just_taken(), CharLit(c)))
        StrLit(v) ->
            p.bump()
            Some(expr(p.just_taken(), StrLit(v)))
        Keyword(w) ->
            if w == "true"
                p.bump()
                Some(expr(p.just_taken(), BoolLit(true)))
            else if w == "false"
                p.bump()
                Some(expr(p.just_taken(), BoolLit(false)))
            else
                None
        _ -> None
end parse_pattern_lit

private parse_number_lit(p: *Parser) -> Option[Expr]
    p.peek() match
        IntLit(digits, base, suffix) ->
            p.bump()
            Some(expr(p.just_taken(), IntLit(digits, base, suffix)))
        FloatLit(text, suffix) ->
            p.bump()
            Some(expr(p.just_taken(), FloatLit(text, suffix)))
        _ -> None
end parse_number_lit
