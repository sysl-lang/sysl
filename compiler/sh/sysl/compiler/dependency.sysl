module sh.sysl.compiler

import sh.sysl.hocon.Value
import sysl.buf.{Buf, buf}
import sysl.text.{join, Search}

// Where a dependency's source comes from.
//
// **The two are not variations of one shape**: a git dependency always has a version, because that
// is what a coordinate resolves *at*, and a path dependency never does, because the directory is
// whatever it is on disk right now. One struct with two optional halves would put that rule in a
// validation pass instead of in the type, where every later reader would have to re-derive it.
enum Origin
    // A repository and the version to read it at. The coordinate carries the `/vN` suffix where
    // there is one, because a major version is *part of the identity* rather than a decoration on
    // it -- `github.com/e/json` and `github.com/e/json/v2` are two packages that may both be linked.
    Git(coordinate: string, version: Release)

    // A directory beside the consumer, for a package being developed alongside what uses it.
    Local(dir: string)

    // A member of the workspace the consumer belongs to, written `{ workspace = true }` under the
    // member's `package.name`. The manifest reader leaves both fields empty; `bind_members`
    // (`workspace.sysl`) fills in the member's directory and the prefix its modules carry, which only
    // a reader that knows where the manifest sits can do.
    Member(dir: string, canonical: string)
end Origin

// One entry of the `dependencies` block.
//
// `label` is the key it was written under. It is **not** the module name the code will use: the
// root name goes to the dependency itself, so that a consumer's import lines match the library's
// own documentation, and `mount` is what a consumer writes when two dependencies want one name. The
// label is what diagnostics call this entry, and it has to be unique for that reason alone.
struct Dependency
    label: string
    origin: Origin

    // The one segment a consumer chose to hang the whole package under, where it chose one.
    mount: Option[string]

    // Whether only a feature of this package turns the dependency on. **False where the entry says
    // nothing**, which is what keeps a manifest written before features read exactly as it did.
    optional: bool

    // Which of the dependency's own features this entry asks for, and whether its defaults come
    // too. Accepted as written here and resolved against that package's own manifest elsewhere.
    features: Buf[string]
    default_features: bool

    // Directories of the CONSUMER's, relative to the manifest that wrote this entry, searched ahead of
    // the package's own include roots by every C file of the package (`c_libraries.sysl`) -- which is
    // how a consumer supplies the configuration header a vendored library is written to take.
    c_include: Buf[string]

    // Macros of the CONSUMER's choosing, defined for every C file of the package, as clang spells each
    // after the `-D` and sorted by name (`c_defines = { STM32H743xx = true }`): the part name a vendor's
    // header selects its register map by, which is the application's fact and no feature's.
    c_defines: Buf[string]

    // The machines the dependency is taken on, as the condition its `if` wrote -- `#if`'s language
    // over `dependency_symbols` -- or the empty string where it is taken on every machine.
    condition: string

    // The options of the dependency this entry sets, each by name with the value as written
    // (`options.sysl`). Held to the dependency's own declarations once its manifest is read.
    options: Buf[(string, Value)]
end Dependency

// An entry that says nothing about features, which is what every entry before them said.
plain_dependency(label: string, origin: Origin, mount: Option[string]) -> Dependency =
    Dependency(label, origin, mount, false, buf(), true, buf(), buf(), "", buf())

// **The machine a graph is resolved for**, which decides the dependencies an `if` leaves out. Module
// storage for the reason `features.sysl` gives for the feature request: it is written by the one
// funnel a command that lowers anything comes through (`target_for`) and read by every resolution
// that build makes -- the compilation, the C walk, the run cache's key -- which must all agree.
//
// **None takes every dependency whatever its condition**, which is what a question about the
// manifests rather than about one build wants: `sysl deps`, `sysl tidy` and `sysl vendor` answer for
// every machine a project may be built for, as they do for every feature.
private var resolution_machine: Option[Target] = None

// Said by a command once it knows the machine it builds for, and with `None` before any other.
use_resolution_machine(t: Option[Target]) = resolution_machine = t

// Whether a dependency is part of a graph resolved for the machine `use_resolution_machine` named.
present_here(dep: &Dependency) -> bool = machine_holds(dep.condition)

// Whether a condition, as an `if` writes it, holds for the machine the graph is resolved for. **The
// empty condition holds everywhere, and so does any condition when no machine is named.**
machine_holds(condition: string) -> bool
    if condition.is_empty() then return true

    resolution_machine match
        None -> true
        Some(t) -> dependency_condition(condition, dependency_defined(t)).unwrap_or(true)
end machine_holds

// Whether a build for a particular machine is being resolved, rather than a question about the
// manifests as a whole.
machine_named() -> bool = resolution_machine.is_some()

// The name of the machine the graph is resolved for, or `""` where no machine is named -- which is what
// the target layers of a manifest are matched against.
machine_name() -> string = resolution_machine match
    None -> ""
    Some(t) -> t.name

// The machine as a refusal names it.
machine_called() -> string = resolution_machine match
    None -> "this machine"
    Some(t) -> s"'${t.name}'"

// The dependencies a list keeps on this machine, and the ones it leaves out.
present_and_absent(deps: &Buf[Dependency]) -> (Buf[Dependency], Buf[Dependency])
    var present: Buf[Dependency] = buf()
    var absent: Buf[Dependency] = buf()

    for dep in deps
        if present_here(dep) then present.push(dep) else absent.push(dep)

    (present, absent)
end present_and_absent

// What a `no module is called` refusal adds where the graph left a dependency out on this machine,
// each with who declared it ("this project" or a package's name): the module may be one of those,
// and the build is not for a machine that takes it. **The whole graph's, since imports are
// transitive**: a package reached through another is importable where it is present, so its
// absence is news to every file of the build.
absent_note(absent: &Buf[(string, Dependency)]) -> string
    if absent.is_empty() then return ""

    val machine = resolution_machine match
        None -> "this machine"
        Some(t) -> s"'${t.name}'"

    var out = ""

    for i in 0..<absent.len()
        val (asker, dep) = absent.at(i)

        out = out + (if i == 0 then " — " else "; ") +
            s"'${dep.label}', which $asker takes only where '${dep.condition}' holds"

    val verb = if absent.len() == 1 then "is" else "are"

    out + s", $verb left out: $machine is not such a machine, and nothing of it is in this build"
end absent_note

// The identity everything mangles, caches and resolves by -- the coordinate, with the separators a
// module name is allowed to hold.
//
// A local dependency has no coordinate to be canonical, so it answers with its label. That is
// honest rather than convenient: a package with no coordinate genuinely has no identity beyond this
// project, which is why a local dependency's name cannot be relied on to be the same name anywhere
// else.
dependency_canonical(dep: &Dependency) -> string
    dep.origin match
        Git(coordinate, _) -> canonical_prefix(coordinate)
        Local(_) -> dep.label
        Member(_, canonical) -> if canonical.is_empty() then dep.label else canonical
end dependency_canonical

// The coordinate a dependency names, where it names one.
dependency_coordinate(dep: &Dependency) -> Option[string]
    dep.origin match
        Git(coordinate, _) -> Some(coordinate)
        _ -> None
end dependency_coordinate

// The version a dependency asks for, where it asks for one.
dependency_version(dep: &Dependency) -> Option[Release]
    dep.origin match
        Git(_, version) -> Some(version)
        _ -> None
end dependency_version

// The directory a path dependency or a workspace member names, where it names one.
dependency_dir(dep: &Dependency) -> Option[string]
    dep.origin match
        Git(_, _) -> None
        Local(dir) -> Some(dir)
        Member(dir, _) -> Some(dir)
end dependency_dir

// Whether a dependency is a member of the consumer's workspace.
is_member_dependency(dep: &Dependency) -> bool
    dep.origin match
        Member(_, _) -> true
        _ -> false
end is_member_dependency

// A `path` origin read against the directory of the manifest that declared it, rather than against
// whatever directory the build happened to be started from.
//
// The manifest reader keeps a path as written, being a function of text with no filesystem in the
// way, so a relative one means nothing until it is joined to where that `package.hocon` was found --
// which only the reader of the file knows. The answer is absolute, so resolving one twice is the same
// as resolving it once. A `git` origin carries no directory and is returned unchanged.
resolved_against(dep: &Dependency, declaring_dir: string) -> Dependency
    dep.origin match
        Git(_, _) -> *dep
        Member(_, _) -> *dep
        Local(dir) ->
            val joined = if dir.starts_with("/") then dir else join_path(declaring_dir, dir)

            (*dep) with { origin = Local(absolute_path(joined)) }
end resolved_against

// Every dependency of a list read against the directory holding the manifest that wrote it.
resolved_all_against(deps: &Buf[Dependency], declaring_dir: string) -> Buf[Dependency]
    var out: Buf[Dependency] = buf()

    for item in deps
        out.push(resolved_against(item, declaring_dir))

    out
end resolved_all_against

// Whether a dependency is fetched rather than sitting beside the consumer.
is_git_dependency(dep: &Dependency) -> bool = dependency_coordinate(dep).is_some()

// How a coordinate becomes something `git` can clone.
//
// The `/vN` suffix is identity and not location -- there is no branch or directory called `v2` in
// the repository -- so it comes off before the URL is built. HTTPS rather than SSH, because a public
// package should be fetchable by someone who has no account anywhere.
clone_url(coordinate: string) -> string = s"https://${without_major(coordinate)}.git"

// The coordinate with its `/vN` suffix removed, which is the repository itself.
without_major(coordinate: string) -> string
    major_suffix(coordinate) match
        None -> coordinate
        Some(_) -> coordinate[0..<last_slash(coordinate)]
end without_major

// The repository a coordinate names: its last path segment, with a `/vN` major suffix set aside, so
// `github.com/e/json/v2` is `json`. It is what a checkout of that repository calls itself in its
// manifest's `package.name`.
repository_name(coordinate: string) -> string
    val bare = without_major(coordinate)
    val at = last_slash(bare)

    if at == bare.bytes.len then bare else bare[(at + 1)..<bare.bytes.len]
end repository_name

// The major version a coordinate declares in its path, where it declares one. `v0` and `v1` are not
// suffixes: the first two majors ride in the bare path, so a `github.com/e/json/v1` would be a
// second spelling of a package that already has one.
major_suffix(coordinate: string) -> Option[usize]
    val at = last_slash(coordinate)
    val last = coordinate[(if at == coordinate.bytes.len then 0 else at + 1)..<coordinate.bytes.len]

    if last.bytes.len < 2 || last.bytes[0] != u8('v') then return None

    var n: usize = 0

    for i in 1..<last.bytes.len
        val c = last.bytes[i]

        if c < u8('0') || c > u8('9') then return None

        n = n * 10 + usize(c - u8('0'))

    if n >= 2 then Some(n) else None
end major_suffix

// Where the last `/` of a path is, or its length where it holds none.
private last_slash(text: string) -> usize
    var at = text.bytes.len

    for i in 0..<text.bytes.len
        if text.bytes[i] == u8('/') then at = i

    at
end last_slash

// The `dependencies` or `dev_dependencies` block, read.
read_dependencies(root: Value, block: string) -> Result[Buf[Dependency], string]
    var out: Buf[Dependency] = buf()

    root.get(block) match
        None -> return Ok(out)
        Some(deps) ->
            val labels = sorted_labels(deps.keys())

            for item in labels
                val sub = deps.get(item).unwrap()

                out.push(read_dependency(item, sub, block)?)

    unique_dependencies(out)?
    Ok(out)
end read_dependencies

// Refuses a package named by both blocks.
//
// The two say different things about the same package -- one that a consumer gets it, the other that
// a consumer does not -- and there is no reading under which both are meant. It is the judgement a
// `git` beside a `path` gets: a closed vocabulary, where the writer believes they have said one
// thing and a build that quietly picked one of them would let them go on believing it.
not_in_both(deps: &Buf[Dependency], dev: &Buf[Dependency]) -> Result[unit, string]
    var both: Buf[string] = buf()

    for item in dev
        for j in 0..<deps.len()
            if item.label == deps.at(j).label then both.push(item.label)

    if both.is_empty() then return Ok(())

    val named = sorted_labels(both)
    val is_are = if named.len() == 1 then "is" else "are"

    Err(s"${quoted_list(named)} $is_are named by both 'dependencies' and 'dev_dependencies' — a " +
        "dependency reaches this package's consumers or it does not, and it cannot do both. Name " +
        "it once, in 'dependencies' if anything a consumer compiles imports it")
end not_in_both

// One entry, held to a shape in which every field is decided by the others.
//
// The unknown-key refusal is the same judgement a misspelled capability gets: a file saying
// `versoin = "1.0.0"` was written by somebody who believes they have pinned a version, and ignoring
// the key would resolve whatever the repository's default branch happens to be while they went on
// believing it.
private read_dependency(label: string, sub: Value, block: string) -> Result[Dependency, string]
    val where = s"$block.$label"

    if !sub.is_obj()
        return Err(s"'$where' is not a block — a dependency is a git coordinate and a version, or a " +
            "path")

    val keys = sorted_labels(sub.keys())

    for i in 0..<keys.len()
        if !known_dependency_key(keys.at(i))
            return Err(s"'$where.${keys.at(i)}' is not something a dependency says — the keys are " +
                "'c_defines', 'c_include', 'default_features', 'features', 'git', 'if', 'mount', 'optional', " +
                "'options', 'path', 'rev', 'version', 'workspace'")

    val mount = read_mount(sub, where)?
    val origin = read_origin(sub, where)?
    val optional = read_yes_no(sub, where, "optional", false)?
    val defaults = read_yes_no(sub, where, "default_features", true)?
    val condition = read_condition_key(sub, where)?

    val features = sub.get("features") match
        None -> buf()
        Some(v) -> v.as_text_list() match
            None -> return Err(not_a_feature_list(s"$where.features"))
            Some(names) -> names

    var c_include: Buf[string] = buf()

    sub.get("c_include") match
        None -> ()
        Some(v) -> v.as_text_list() match
            None -> return Err(s"'$where.c_include' must be a list of directories, relative to this " +
                               "manifest")
            Some(dirs) ->
                for dir in dirs
                    c_include.push(inside_package(s"$where.c_include", "", dir)?)

    var c_defines: Buf[string] = buf()

    sub.get("c_defines") match
        None -> ()
        Some(v) ->
            if !v.is_obj()
                return Err(s"'$where.c_defines' is not a block of macros — each line is one macro " +
                           "every C file of the package is compiled with, as 'c_defines = { STM32H743xx = true }'")

            for name in sort_names(v.keys())
                c_defines.push(macro_of(s"$where.c_defines", name, v.get(name).unwrap())?)

    val options = read_option_settings(sub, where)?

    Ok(Dependency(label, origin, mount, optional, features, defaults, c_include, c_defines, condition, options))
end read_dependency

// An entry's `if`: a string holding a condition, checked here -- every symbol, whichever machine
// the build turns out to be for -- so a misspelling is refused when the file is read rather than
// leaving the dependency out of every build with nothing said.
read_condition_key(sub: Value, where: string) -> Result[string, string]
    val text = sub.get("if") match
        None -> return Ok("")
        Some(v) -> text_of(v) match
            Some(s) -> s
            None -> return Err(s"'$where.if' is not a string — it is a condition, as '#if' writes " +
                "one, in quotes: if = \"freestanding\"")

    dependency_condition(text, buf()) match
        Err(why) -> Err(s"'$where.if' $why")
        Ok(_) -> Ok(text)
end read_condition_key

// Every key a dependency entry may write. A table rather than a test, so the cache census
// (`tests_ckg_cache_key.sysl`) can walk it.
val DependencyKeys: []const string = ["git", "version", "rev", "path", "mount", "optional", "features",
                                      "default_features", "workspace", "c_include", "c_defines", "if", "options"]

private known_dependency_key(key: string) -> bool = holds_key(DependencyKeys, key)

// Whether a table of keys holds one.
holds_key(keys: []const string, key: string) -> bool
    for i in 0..<keys.len
        if keys[i] == key then return true

    false
end holds_key

// An entry's `options`: each option of the dependency this consumer sets, by name, with the value as
// written. What the value may be is the dependency's manifest's to say, so it is held to that once the
// manifest is read (`settle_options`); here only the shape is.
private read_option_settings(sub: Value, where: string) -> Result[Buf[(string, Value)], string]
    var out: Buf[(string, Value)] = buf()

    val block = sub.get("options") match
        None -> return Ok(out)
        Some(b) -> b

    if !block.is_obj()
        return Err(s"'$where.options' is not a block — it sets the package's options by name, as " +
            "'options = { slots = 8 }'")

    flat_settings(block, "", &out)
    Ok(out)
end read_option_settings

// A yes-or-no field of an entry, which is a flag and nothing else: `"yes"` is a string, and a
// string here was written by somebody who believes they said something the reader cannot see.
private read_yes_no(sub: Value, where: string, key: string, otherwise: bool) -> Result[bool, string]
    sub.get(key) match
        None -> Ok(otherwise)
        Some(v) -> v.as_bool() match
            Some(on) -> Ok(on)
            None -> Err(s"'$where.$key' is not 'true' or 'false' — it is a yes or no question, " +
                     "written without quotes")
end read_yes_no

// The refusal for a feature list that is not a list, which the `features` block and a dependency's
// own `features` field share.
not_a_feature_list(where: string) -> string =
    s"'$where' is not a list — what a feature turns on is written in brackets, as " +
    "'[llhttp, nghttp2]', even where there is one of it"

// The root name a consumer may put a dependency under, which has to be a name a module could have:
// it becomes the first segment of every import line that reaches the package.
private read_mount(sub: Value, where: string) -> Result[Option[string], string]
    if sub.get("mount").is_none() then return Ok(None)

    val name = scalar_text(sub, "mount")

    if is_module_segment(name) then return Ok(Some(name))

    Err(s"'$where.mount' is '$name', which is not a name a module can have — a mount becomes the " +
        "first segment of an import line")
end read_mount

private is_module_segment(name: string) -> bool
    if name.is_empty() then return false

    val head = name.bytes[0]

    if !(letter_byte(head) || head == u8('_')) then return false

    for i in 1..<name.bytes.len
        val c = name.bytes[i]

        if !(letter_byte(c) || (c >= u8('0') && c <= u8('9')) || c == u8('_')) then return false

    true
end is_module_segment

private letter_byte(c: u8) -> bool =
    (c >= u8('a') && c <= u8('z')) || (c >= u8('A') && c <= u8('Z')) || c >= 128

private read_origin(sub: Value, where: string) -> Result[Origin, string]
    val has_git = sub.get("git").is_some()
    val has_path = sub.get("path").is_some()

    // **A workspace member is named by the workspace, and by nothing else**: it is the directory the
    // root's list names, at whatever is on disk, so a coordinate, a path or a version beside it is a
    // second answer to a question the workspace already settled.
    if sub.get("workspace").is_some()
        if !read_yes_no(sub, where, "workspace", false)?
            return Err(s"'$where.workspace' is only ever 'true' — leave it out and name a 'git' " +
                "coordinate or a 'path' instead")

        if has_git || has_path || sub.get("version").is_some() || sub.get("rev").is_some()
            return Err(s"'$where' names 'workspace = true' and a 'git', 'path' or 'version' as well " +
                "— a workspace member is the directory the workspace lists, at no version, so it " +
                "is named by the workspace alone")

        return Ok(Member("", ""))
    end if

    if has_git && has_path
        return Err(s"'$where' names both a 'git' coordinate and a 'path' — a dependency is fetched " +
            "or it is beside you, and it cannot be both")

    if !has_git && !has_path
        return Err(s"'$where' names neither a 'git' coordinate nor a 'path'")

    if has_path
        // A path dependency is whatever is in that directory right now, so a version beside one is
        // not a weaker promise than it looks -- it is a promise nothing could keep.
        if sub.get("version").is_some()
            return Err(s"'$where' names a 'path' and a 'version' — a path dependency is the " +
                "directory as it is now, and there is nothing to resolve a version against")

        if sub.get("rev").is_some()
            return Err(s"'$where' names a 'path' and a 'rev' — a path dependency is the " +
                "directory as it is now, and there is no repository to pin a commit of")

        val dir = scalar_text(sub, "path")

        if dir.is_empty() then return Err(s"'$where.path' is empty")

        return Ok(Local(dir))

    val coordinate = scalar_text(sub, "git")
    val has_rev = sub.get("rev").is_some()

    if has_rev && sub.get("version").is_some()
        return Err(s"'$where' names a 'version' and a 'rev' — a dependency is read at a release or " +
            "at a pinned commit, and exactly one of the two says which")

    // **A pin is a commit and nothing else**: the sha, whole or shortened, because a branch name
    // moves and a tag already has `version`. It is lowercase hex since that is what git prints and
    // what `sysl.sum` records, so one commit is never two spellings.
    if has_rev
        val sha = scalar_text(sub, "rev")

        if !is_commit_sha(sha)
            return Err(s"'$where.rev' is '$sha', which is not a commit — a pin is a commit's sha, " +
                "in lowercase hex, whole or shortened to at least seven digits")

        check_coordinate(coordinate, where)?
        return Ok(Git(coordinate, release_at_rev(sha)))
    end if

    if sub.get("version").is_none()
        return Err(s"'$where' names a 'git' coordinate and neither a 'version' nor a 'rev' — a " +
            "coordinate says which repository, and a version or a pinned commit says which of it")

    val version = release_of(scalar_text(sub, "version")) match
        Err(why) -> return Err(s"'$where.version': $why")
        Ok(v) -> v

    check_coordinate(coordinate, where)?
    check_major(coordinate, version, where)?
    Ok(Git(coordinate, version))
end read_origin

// Whether text is a commit's sha as a pin writes one: lowercase hex, from git's usual seven-digit
// abbreviation up to the whole forty.
is_commit_sha(text: string) -> bool
    if text.bytes.len < 7 || text.bytes.len > 40 then return false

    for c in text.bytes
        if !((c >= u8('0') && c <= u8('9')) || (c >= u8('a') && c <= u8('f'))) then return false

    true
end is_commit_sha

// What a coordinate is: a host and a path under it, as `git` would be given, and **not a URL**.
//
// The scheme is refused rather than accepted-and-stripped because the coordinate is *identity* --
// two spellings of one package would mangle to two module names and link as two incompatible
// copies, which is a link error a long way from the line that caused it.
private check_coordinate(coordinate: string, where: string) -> Result[unit, string]
    if coordinate.index_of("://").is_some()
        return Err(s"'$where.git' is a URL — a coordinate is written as 'github.com/you/thing', " +
            "since it is the package's identity and not the way it is fetched")

    if coordinate.starts_with("/") || coordinate.ends_with("/") ||
       coordinate.index_of("//").is_some()
        return Err(s"'$where.git' is not a coordinate — 'github.com/you/thing' is the shape")

    if coordinate.index_of("/").is_none()
        return Err(s"'$where.git' names a host and nothing under it")

    Ok(())
end check_coordinate

// The rule that a major version rides in the path, checked both ways.
//
// Both halves matter and they catch opposite mistakes. A suffix that disagrees with the version is a
// manifest asking for one package and naming another. A major of 2 or more with *no* suffix is the
// mistake `/vN` exists to prevent: it would put two incompatible majors under one module name, and a
// module name is mangled into every symbol, so the two would collide at the linker rather than
// anywhere a diagnostic could reach.
private check_major(coordinate: string, version: Release, where: string) -> Result[unit, string]
    val shown = release_shown(version)

    major_suffix(coordinate) match
        Some(n) ->
            if n != version.major
                return Err(s"'$where' asks for $shown from a coordinate ending '/v$n' — a major " +
                    s"version is part of the coordinate, so '/v$n' holds ${n}.x and nothing else")
        None ->
            if version.major >= 2
                return Err(s"'$where' asks for $shown from a coordinate with no " +
                    s"'/v${version.major}' — from the second major version on, the major rides in " +
                    "the coordinate, because two of them are two packages rather than two versions " +
                    "of one")

    Ok(())
end check_major

// The two ways one manifest can name one thing twice.
//
// A repeated **coordinate** is refused because a module gets one version: two entries for one
// package are two answers to a question that has one, and taking either silently would make which
// one depend on the order a file was read in. A repeated **mount** is the collision the package
// layer exists to refuse, caught here in the one case where the file alone is enough to see it.
private unique_dependencies(entries: &Buf[Dependency]) -> Result[unit, string]
    for i in 0..<entries.len()
        dependency_coordinate(entries.at(i)) match
            None -> ()
            Some(coordinate) ->
                var group: Buf[string] = buf()

                for entrie in entries
                    dependency_coordinate(entrie) match
                        None -> ()
                        Some(other) -> if other == coordinate then group.push(entrie.label)

                if group.len() > 1
                    return Err(s"'$coordinate' is named by ${joined_and(group)} — one package is " +
                        "one dependency, and a module gets one version of it")

    for i in 0..<entries.len()
        entries.at(i).mount match
            None -> ()
            Some(mount) ->
                var group: Buf[string] = buf()

                for entrie in entries
                    entrie.mount match
                        None -> ()
                        Some(other) -> if other == mount then group.push(entrie.label)

                if group.len() > 1
                    return Err(s"${joined_and(group)} are both mounted as '$mount' — two packages " +
                        "cannot share a root name")

    Ok(())
end unique_dependencies

// The labels of a group, quoted and joined by the word the reference uses between two of them.
private joined_and(labels: &Buf[string]) -> string
    var out = ""

    for i in 0..<labels.len()
        if i > 0 then out = out + " and "

        out = out + s"'${labels.at(i)}'"

    out
end joined_and

// A list of quoted names, comma separated, as a refusal naming several of them writes it.
private quoted_list(names: &Buf[string]) -> string
    var parts: Buf[string] = buf()

    for item in names
        parts.push(s"'${item}'")

    join(parts.view(), ", ")
end quoted_list

// Names in the order a refusal walks them, which is the file's keys sorted rather than written.
sorted_labels(names: Buf[string]) -> Buf[string]
    var out: Buf[string] = buf()

    for item in names
        var at = out.len()

        for j in 0..<out.len()
            if at == out.len() && item < out.at(j) then at = j

        var next: Buf[string] = buf()

        for j in 0..<out.len()
            if j == at then next.push(item)

            next.push(out.at(j))

        if at == out.len() then next.push(item)

        out = next

    out
end sorted_labels
