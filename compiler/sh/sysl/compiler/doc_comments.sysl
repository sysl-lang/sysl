module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.{from_utf8_unchecked, join, Search, split, str_builder, StrBuilder}

// Documentation comments: `/** ... */` above a declaration, and what a generator reads out of one.
//
// **A doc comment is not part of what a declaration means.** Nothing downstream reads one and a
// program compiles identically with every one of them deleted. What they are for is the reader --
// a generated API reference, an editor's hover text -- and the compiler carries them because it is
// the only thing that knows which prose belongs to which declaration.
//
// **The form is scaladoc's**, and the delimiter is the whole of what distinguishes a doc comment
// from an ordinary one: an implementation note above a declaration stays an implementation note by
// being written `//`, and nothing has to guess at intent. The lexer collects the raw text as
// trivia; what happens here is the reading of it -- the margin taken off, the tags split from the
// prose, and the first sentence taken as the summary an index column wants.

// One tag inside a doc comment: `@param xs the slice to sort`.
//
// `subject` is the first word after the tag for the two tags that take one, and absent for the rest.
// `text` is everything after it, with the tag's own line and any continuation lines joined.
struct DocTag
    name: string
    subject: Option[string]
    text: string
    line: usize
end DocTag

// A doc comment as read, and the lines it was found on.
//
// `summary` is the first sentence of the body, which is what an index column wants; `body` is the
// whole of the prose before the first tag, summary included. Splitting rather than trimming means a
// page can show either without a generator having to re-derive one from the other.
struct Doc
    summary: string
    body: string
    tags: Buf[DocTag]
    start_line: usize
    end_line: usize
end Doc

// The two tags whose first word names something in the signature.
private takes_a_subject(name: string) -> bool = name == "param" || name == "tparam"

// Every doc comment the lexer collected, read.
read_doc_comments(src: Source, scanned: Buf[Spanned[string]]) -> Buf[Doc]
    var out: Buf[Doc] = buf()

    for one in scanned
        val start = one.span.start

        // The end offset is one past the closing delimiter, so the line it lands on is the
        // comment's last line -- except where the comment ends the file with no newline, which is
        // the same line either way.
        val last = if one.span.end > start then one.span.end - 1 else start

        out.push(parse_doc(one.value, src.locate(start).line, src.locate(last).line))

    out
end read_doc_comments

// The comment's lines with the delimiters and the left margin taken off.
private doc_lines(text: string) -> Buf[string]
    var inner = text

    if inner.starts_with("/**") then inner = inner[3..]
    if inner.ends_with("*/") then inner = inner[0..<(inner.len - 2)]

    var out: Buf[string] = buf()

    for raw in split(inner, "\n")
        val line = raw.trim()

        if line.starts_with("*")
            val rest = line[1..]

            out.push(if rest.starts_with(" ") then rest[1..] else rest)
        else
            out.push(line)

    out
end doc_lines

// One doc comment, read into its prose and its tags.
parse_doc(text: string, start_line: usize, end_line: usize) -> Doc
    val lines = doc_lines(text)

    var body: Buf[string] = buf()
    var tags: Buf[DocTag] = buf()
    var open = false
    var name = ""
    var subject: Option[string] = None
    var held: Buf[string] = buf()
    var at: usize = 0

    for i in 0..<lines.len()
        val line = lines.at(i)

        tag_start(line) match
            Some(found) ->
                if open then tags.push(DocTag(name, subject, join(held.view(), "\n").trim(), at))

                val rest = found.rest.trim()

                open = true
                name = found.name
                at = start_line + i
                held = buf()

                if takes_a_subject(found.name)
                    val word = leading_word(rest)

                    subject = if word.len == 0 then None else Some(word)

                    held.push(rest[word.len..].trim())
                else
                    subject = None

                    held.push(rest)
            None ->
                if open then held.push(line) else body.push(line)

    if open then tags.push(DocTag(name, subject, join(held.view(), "\n").trim(), at))

    val prose = join(body.view(), "\n").trim()

    Doc(first_sentence(prose), prose, tags, start_line, end_line)
end parse_doc

// What a line beginning with `@name` says: the name, and everything after the space that follows it.
struct TagHead
    name: string
    rest: string
end TagHead

// A line that opens a tag, or nothing where it is ordinary prose.
//
// **An unrecognized `@name` opens a tag like any other.** sysl's `@` is the annotation sigil, so
// the vocabulary a generator understands is a question for the generator; what is decided here is
// only where one paragraph ends and the next begins.
private tag_start(line: string) -> Option[TagHead]
    if !line.starts_with("@") then return None

    val b = line.bytes
    var i: usize = 1

    if i >= b.len || !(is_alpha(b[i]) || b[i] == u8('_')) then return None

    i += 1

    while i < b.len && (is_alnum(b[i]) || b[i] == u8('_'))
        i += 1

    val name = line[1..<i]
    var j = i

    while j < b.len && is_space(b[j])
        j += 1

    Some(TagHead(name, line[j..]))
end tag_start

// The run of non-whitespace a tag's subject is.
private leading_word(s: string) -> string
    val b = s.bytes
    var i: usize = 0

    while i < b.len && !is_space(b[i])
        i += 1

    s[0..<i]
end leading_word

// The first sentence of a paragraph, with its own line breaks flattened away.
private first_sentence(body: string) -> string
    val flat = collapse_space(body.trim())
    val b = flat.bytes

    if b.len == 0 then return ""

    var i: usize = 0

    while i < b.len
        if b[i] == u8('.') || b[i] == u8('!') || b[i] == u8('?')
            if i + 1 == b.len || is_space(b[i + 1]) then return flat[0..<(i + 1)]

        i += 1

    flat
end first_sentence

// Every run of whitespace as one space, which is what a summary read out of wrapped prose wants.
private collapse_space(s: string) -> string
    var out = str_builder()
    var gap = false

    for c in s.chars
        if is_space_char(c)
            gap = true
        else
            if gap then out.push_char(' ')

            gap = false

            out.push_char(c)

    out.finish()
end collapse_space

private is_space(b: u8) -> bool =
    b == u8(' ') || b == u8('\t') || b == u8('\n') || b == u8('\r') || b == 11u8 || b == 12u8

private is_space_char(c: char) -> bool =
    c == ' ' || c == '\t' || c == '\n' || c == '\r' || u32(c) == 11u32 || u32(c) == 12u32

private is_alpha(b: u8) -> bool =
    (b >= u8('a') && b <= u8('z')) || (b >= u8('A') && b <= u8('Z'))

private is_alnum(b: u8) -> bool = is_alpha(b) || (b >= u8('0') && b <= u8('9'))

// -- the vocabulary -------------------------------------------------------------------------------

// The closed vocabulary of doc tags.
//
// `throws` is deliberately absent: sysl has no exceptions, and what a fallible function answers
// with is the `E` of its `Result[T, E]` -- which `@return` describes, because it is part of the
// return type rather than a second channel out of the function.
private is_doc_tag(name: string) -> bool =
    name == "param" || name == "tparam" || name == "return" || name == "see" || name == "note" ||
    name == "example" || name == "since" || name == "deprecated" || name == "group" ||
    name == "groupname" || name == "inheritdoc"

// sysl's own annotation words, so that prose *about* an annotation is not read as a mistyped tag.
//
// This is why an unknown `@name` cannot simply warn: `@requires` in a doc comment is overwhelmingly
// a sentence about the capability clause, and a warning there would be noise on correct prose.
private is_annotation_word(name: string) -> bool =
    name == "test" || name == "tests" || name == "requires" || name == "export" ||
    name == "no_alloc" || name == "no_block" || name == "blocks" || name == "link" || name == "crossing" || name == "borrows" ||
    name == "packed" || name == "align" || name == "section" || name == "assert" ||
    name == "ghost" || name == "include" || name == "inline"

// The tags of one name, in the order they were written.
doc_tags_named(d: Doc, name: string) -> Buf[DocTag]
    var out: Buf[DocTag] = buf()

    for item in d.tags
        if item.name == name then out.push(item)

    out
end doc_tags_named

// The tags whose name is neither a doc tag nor one of sysl's own annotations -- candidate typos.
//
// Nothing acts on this: an unknown tag is prose and does not warn. It is computed because the
// alternative to computing it is not having the evidence the day somebody asks whether `@parm` is
// worth catching.
unknown_doc_tags(d: Doc) -> Buf[DocTag]
    var out: Buf[DocTag] = buf()

    for item in d.tags
        val name = item.name

        if !is_doc_tag(name) && !is_annotation_word(name) then out.push(item)

    out
end unknown_doc_tags

// -- which declaration a comment belongs to -------------------------------------------------------

// The doc comment immediately above `line`, if there is one.
//
// **Immediately** allows annotations and line comments in between, and nothing else. An annotation
// between the prose and the declaration is the ordinary shape -- `@test` above a function,
// `@export` above another -- so a rule that demanded adjacency would silently drop the
// documentation of every annotated declaration. A **blank line** ends the association, which is
// what lets a file-level comment sit at the top without being adopted by whatever is declared
// first.
doc_above(src: Source, docs: Buf[Doc], line: usize) -> Option[Doc]
    var i = docs.len()

    while i > 0
        i -= 1

        val d = docs.at(i)

        // The nearest comment that ENDS above the line is the only candidate: a comment further up
        // belongs to whatever that nearer one did not.
        if d.end_line < line
            for between in (d.end_line + 1)..<line
                val text = from_utf8_unchecked(src.line_text(between)).trim()

                if !(text.starts_with("@") || text.starts_with("//")) then return None

            return Some(d)

    None
end doc_above

// -- what a tag says about the signature ----------------------------------------------------------

// One tag that is wrong about the declaration it documents, and what to say about it.
struct DocFault
    tag: DocTag
    message: string

// What a doc comment gets wrong about the signature it sits above.
//
// **Only the tags that name the signature are checkable, and only in one direction.** A `@param`
// naming a parameter the declaration does not have is wrong now and will stay wrong -- it is the
// shape a rename leaves behind, describing something that is no longer there. A parameter with *no*
// `@param` is not an error and must never become one: documentation is optional, a partial doc
// comment is better than none, and a rule requiring the full set is what makes people write
// `@param n the n` to silence it.
//
// So: check what is written, never require what is absent. That is also what lets a library be
// converted a file at a time.
check_doc(d: Doc, params: Buf[string], tparams: Buf[string]) -> Buf[DocFault]
    var out: Buf[DocFault] = buf()

    wrong_subjects(&out, d, "param", params, "parameter")
    wrong_subjects(&out, d, "tparam", tparams, "type parameter")

    out
end check_doc

private wrong_subjects(out: *Buf[DocFault], d: Doc, tag_name: string, known: Buf[string],
                       what: string)
    for tag in d.tags
        if tag.name != tag_name then continue

        tag.subject match
            // A bare tag with no name after it is its own mistake, and is named as one.
            None ->
                out.push(DocFault(tag, s"'@${tag.name}' names no $what — write the name it " +
                                       "documents after the tag"))
            Some(name) ->
                if !named_among(known, name) then
                    val names = join(known.view(), ", ")
                    val has = if known.is_empty() then s"it has no ${what}s" else s"it has $names"

                    out.push(DocFault(tag, s"'$name' is not a $what of this declaration — $has"))
end wrong_subjects

private named_among(names: Buf[string], name: string) -> bool
    for item in names
        if item == name then return true

    false
end named_among

// Every doc comment in a file that is wrong about the declaration it sits above.
//
// **A pass over the file's own statements, not over the hoisted tables.** This is a claim about a
// *signature*, which exists whether or not a body is ever analyzed -- a generic function nothing
// instantiates has a doc comment exactly as wrong as one that is called everywhere. And a doc
// comment belongs to a **file**: it was found by the lexer that scanned that file and is placed by
// a line number that means nothing anywhere else, where hoisting is the point at which a
// declaration stops remembering which file wrote it.
//
// Members are walked with their type, because a method inside a `struct` is a declaration a reader
// documents like any other and the enclosing declaration's own doc comment is a different one. An
// `impl` block has no doc comment of its own to check, and its methods are documented exactly like
// methods written in the type.
doc_problems(p: Program) -> Buf[DocFault]
    var out: Buf[DocFault] = buf()

    if p.docs.is_empty() then return out

    for s in p.body
        *s.kind match
            FuncDecl(d) -> check_above(&out, p, s.span, param_names(false, d.params), d.tparams)
            // A struct's fields are not parameters, so only its type parameters are checkable. A
            // `@param` naming a field is therefore refused, which is right: the tag for a field
            // would be a different tag, and inventing one silently is worse than saying the tag
            // does not fit.
            StructDecl(d) ->
                check_above(&out, p, s.span, buf(), d.tparams)
                check_members(&out, p, d.members)
            EnumDecl(d) ->
                check_above(&out, p, s.span, buf(), d.tparams)
                check_members(&out, p, d.members)
            TraitDecl(d) ->
                check_above(&out, p, s.span, buf(), d.tparams)
                check_members(&out, p, d.methods)
            ImplDecl(d) -> check_members(&out, p, d.methods)
            _ -> ()

    out
end doc_problems

private check_above(out: *Buf[DocFault], p: Program, at: Span, params: Buf[string],
                    tparams: Buf[string])
    doc_above(p.src, p.docs, p.src.locate(at.start).line) match
        Some(d) ->
            val found = check_doc(d, params, tparams)

            for item in found
                out.push(item)
        None -> ()
end check_above

// A member's receiver counts as a parameter it may document.
//
// `self` is the receiver rather than an entry in the parameter list, which is a real distinction to
// the analyzer and none at all to somebody writing the prose. It is spelled in the declaration all
// the same, so `@param self` describes a real part of the signature -- admitted rather than
// required, like every other parameter.
private check_members(out: *Buf[DocFault], p: Program, members: Buf[MethodDecl])
    for m in members
        check_above(out, p, m.span, param_names(m.receiver.is_some(), m.params), m.tparams)
end check_members

private param_names(receiver: bool, params: Buf[Param]) -> Buf[string]
    var out: Buf[string] = buf()

    if receiver then out.push("self")

    for item in params
        out.push(item.name)

    out
end param_names
