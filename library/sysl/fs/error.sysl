module sysl.fs
@requires(os)

import sysl.fs.sys as fsys
import sysl.sys.UNSUPPORTED
import sysl.text.from_utf8_lossy

/** What a filesystem call reports when it does not succeed, and the one number it comes from.
 *
 * `reference/errors.md § Which channel — the policy` puts this class of failure — something outside
 * the program, a file or a user or a device — on `Result` rather than on a trap, and this is the
 * error half of every `Result` the module hands back. It is an enum rather than a bare `int` for
 * the reason `Result` carries its error as a type parameter at all: a caller that wants to act on
 * *why* wants to match, and a match over named cases is exhaustive where a comparison against a
 * number is a guess that compiled.
 *
 * The cases are the ones a program branches on. Everything else arrives as `Other`, carrying the
 * number, because a library that mapped every `errno` to a name of its own would be a table nobody
 * could keep current and a program could not extend -- and the number is what a reader looks up
 * anyway.
 *
 * **The module requires `os`.** Nothing here is language, and nothing here can be given a body on a
 * target with no filesystem under it. `reference/modules.md § Capabilities are a module property`
 * reserves `os` for exactly this and the clause is what says so in the one place a reader of the file
 * will see it. What answers for the filesystem is `sysl.fs.sys`: the C library on a hosted target, and
 * on one with system calls and no C library, the program.
 */

// A directory that still has something in it. The one code in this set whose value differs between
// the two libcs -- the rest are V7 Unix's, and have been the same numbers everywhere since.
#if bsd
private[sysl] not_empty() -> int = 66
#else
private[sysl] not_empty() -> int = 39
#endif

// `EILSEQ`, the code a platform reports for bytes that are not the text they were meant to be: 92 on
// a BSD, 84 under glibc. It is what `InvalidUtf8` answers to `code()`, and what APFS reports when it
// is asked to create a name that is not UTF-8.
#if bsd
private[sysl] ilseq() -> int = 92
#else
private[sysl] ilseq() -> int = 84
#endif

/** Why a filesystem operation did not happen. */
enum IoError
    NotFound
    PermissionDenied
    AlreadyExists
    NotADirectory
    IsADirectory
    DirectoryNotEmpty
    TooManyOpenFiles
    NoSpaceLeft
    Interrupted
    NotOpen

    /** The operation is not one this process may perform at all (`EPERM`, code 1) -- a different
     * condition from `PermissionDenied`, which is a file whose mode or owner refuses this process
     * (`EACCES`, code 13). A hook status of `-1` is this case.
     */
    NotPermitted

    /** Bytes that had to be text and are not UTF-8: a file `read_text` was asked for, a name in a
     * listing `entries` was asked for, a path the platform handed back. `offset` is the byte at which
     * the decode stopped, counted from the start of whatever was being decoded -- the file, or the one
     * name -- which is `sysl.text.Utf8Error`'s offset carried across unchanged.
     *
     * **It is the one case no `errno` produces**, and it is here anyway because the alternative was a
     * trap: a program reading a file or a directory it did not write is one byte away from it, and
     * that is a fact about the input rather than about the program, which is the line
     * `reference/errors.md` draws between a `Result` and a panic.
     */
    InvalidUtf8(offset: usize)

    Other(code: int)

    /** The number this came from, so a program can report or compare one the set does not name.
     * `Other` carries its own; the named cases hand back the code they were recognised from, which
     * is what keeps `e.code()` answerable without a second table.
     */
    code(self) -> int = self match
        NotFound         -> 2
        PermissionDenied -> 13
        AlreadyExists    -> 17
        NotADirectory    -> 20
        IsADirectory     -> 21
        DirectoryNotEmpty -> not_empty()
        TooManyOpenFiles -> 24
        NoSpaceLeft      -> 28
        Interrupted      -> 4
        NotOpen          -> 9
        NotPermitted     -> 1
        InvalidUtf8(_)   -> ilseq()
        Other(c)         -> c

    /** A sentence, in the terms the operation was asked in rather than in C's.
     *
     * The named cases say it in this module's words. **`Other` says it in the platform's**: the
     * sentence its C library gives that code (`EILSEQ` is "Illegal byte sequence" on macOS), since a
     * code no case names is one only the platform has words for, and a bare number was a thing the
     * reader then had to go and look up. A code the library does not know comes back in the library's
     * own words for that ("Unknown error: 4242"). On a target with no C library the program's
     * supplier is asked (`sysl_fs_error_text`), then the library's own table of the numbers every
     * platform agrees on (`EBUSY` is "device or resource busy"), and only a code neither knows says
     * `error N`.
     */
    message(self) -> string = self match
        NotFound          -> "no such file or directory"
        PermissionDenied  -> "permission denied"
        AlreadyExists     -> "already exists"
        NotADirectory     -> "not a directory"
        IsADirectory      -> "is a directory"
        DirectoryNotEmpty -> "directory not empty"
        TooManyOpenFiles  -> "too many open files"
        NoSpaceLeft       -> "no space left on the device"
        Interrupted       -> "interrupted"
        NotOpen           -> "the file is not open"
        NotPermitted      -> "operation not permitted"
        InvalidUtf8(at)  -> s"not UTF-8 at byte $at"
        Other(c)          -> system_text(c)
end IoError

/** What the words for `code` are, where no case names it: the supplier's (`sysl.fs.sys`'s
 * `sysl_fs_error_text` -- the C library's `strerror_r` on a POSIX host, or a program's own on a target
 * with none), then this module's table of the numbers every platform agrees on, then `error N`.
 * `unsupported` is the one code no platform reports, and is said here rather than handed to a supplier
 * that would call it an unknown error.
 */
private system_text(code: int) -> string
    if code == unsupported_code then return "not supported on this target"

    var into: [256]u8 = [0; 256]
    var got: usize = 0

    val at: *u8 = &into[0]

    // The length is the supplier's word and is held to the room it was given; the view is then taken
    // through the pointer, so a bare image reaching this carries no bounds failure, which would ask it
    // for a `putchar` and an `exit` merely to say what an error number means.
    if fsys.error_text(code, at, 256, &got) == 0
        if got > 256 then got = 256

        return from_utf8_lossy(at[0..<got])

    agreed_words(code) match
        Some(words) -> words
        None -> s"error $code"
end system_text

// Where the table is consulted: everywhere but a hosted target that is not POSIX, whose C library
// numbers its errors its own way (wasi-libc's `ENOENT` is 44), so the table would put the wrong
// words to its numbers.
#if posix
private agreed_words(code: int) -> Option[string] = errno_words(code)
#elif hosted
private agreed_words(code: int) -> Option[string] = None
#else
private agreed_words(code: int) -> Option[string] = errno_words(code)
#endif

// `EAGAIN`, the code for a call that would have had to wait: 35 on a BSD, 11 under glibc, where a BSD
// spends 11 on `EDEADLK`.
#if bsd
private[sysl] again() -> int = 35
#else
private[sysl] again() -> int = 11
#endif

/** The words for an error number, from the one table the library carries -- needing no C library, so
 * a target with none still says what a code means.
 *
 * **It holds the numbers every platform agrees on and nothing past them**: V7 Unix's 1 to 34, which
 * have meant the same thing on every Unix since (11 aside, which a BSD spends on `EDEADLK`), and the
 * three this module names whose value differs between the two families (`EAGAIN`, `ENOTEMPTY`,
 * `EILSEQ`), each at this target's number. Beyond them the numbers part company, and a table claiming
 * them would put Linux's words to a BSD's codes; a supplier that knows its own answers
 * `sysl_fs_error_text`. A code it does not hold is `None`.
 */
private[sysl] errno_words(code: int) -> Option[string]
    if code == again() then return Some("resource temporarily unavailable")
    if code == not_empty() then return Some("directory not empty")
    if code == ilseq() then return Some("illegal byte sequence")

    code match
        1 -> Some("operation not permitted")
        2 -> Some("no such file or directory")
        3 -> Some("no such process")
        4 -> Some("interrupted system call")
        5 -> Some("input/output error")
        6 -> Some("no such device or address")
        7 -> Some("argument list too long")
        8 -> Some("exec format error")
        9 -> Some("bad file descriptor")
        10 -> Some("no child processes")
        12 -> Some("cannot allocate memory")
        13 -> Some("permission denied")
        14 -> Some("bad address")
        15 -> Some("block device required")
        16 -> Some("device or resource busy")
        17 -> Some("file exists")
        18 -> Some("invalid cross-device link")
        19 -> Some("no such device")
        20 -> Some("not a directory")
        21 -> Some("is a directory")
        22 -> Some("invalid argument")
        23 -> Some("too many open files in system")
        24 -> Some("too many open files")
        25 -> Some("inappropriate ioctl for device")
        26 -> Some("text file busy")
        27 -> Some("file too large")
        28 -> Some("no space left on device")
        29 -> Some("illegal seek")
        30 -> Some("read-only file system")
        31 -> Some("too many links")
        32 -> Some("broken pipe")
        33 -> Some("numerical argument out of domain")
        34 -> Some("numerical result out of range")
        _ -> None
end errno_words

/** So that a caller can say `e == NotFound` rather than `e.code() == 2`.
 *
 * **The enum's own docstring is what asks for this**: it says the cases are named so that a program
 * acting on *why* can match rather than compare against a number, since "a comparison against a
 * number is a guess that compiled" -- and without an `Eq` the only comparison available was exactly
 * that. This module's own test wrote `assert_eq(e.code(), 2)` for want of it.
 *
 * **A payload is why it has to be written out.** An enum no variant of which carries anything gets
 * `==` on its discriminant for free; `Other` carries a code, so this one does not.
 *
 * It compares on `code()`, which makes `Other(2)` equal to `NotFound` -- deliberately, because they
 * are the same condition wearing two spellings, and `from_errno` never produces the first. Comparing
 * on the shape instead would make an error that came from a platform sysl does not have a named case
 * for unequal to itself after a round trip through a number.
 *
 * **`InvalidUtf8` is the exception, because its payload is not a code**: two of them are equal when
 * they stopped at the same byte, and one is never equal to anything else -- `from_errno` cannot
 * produce it, so there is no second spelling for it to agree with, and comparing it on `code()` would
 * make `InvalidUtf8(3) == InvalidUtf8(40)`.
 */
impl Eq for IoError
    eq(self, other: IoError) -> bool = self match
        InvalidUtf8(a) -> other match
            InvalidUtf8(b) -> a == b
            _ -> false
        _ -> other match
            InvalidUtf8(_) -> false
            _ -> self.code() == other.code()

/** So that `print(e)` and `f"$e%s"` say the sentence rather than the shape of the value. */
impl Display for IoError
    display(self, out: *Writer, fmt: FormatSpec) = display_str(self.message(), out, fmt)

/** A number from the platform as the case it stands for.
 *
 * The chain is over `errno` values rather than over a name per platform because these are the codes
 * that have been stable since V7 -- `ENOENT` has been 2 on every Unix anyone has shipped -- and the
 * one that is not is `not_empty` above, which is why it is a call rather than a literal here.
 */
private[sysl] from_errno(code: int) -> IoError
    if code == 2 then
        NotFound
    elif code == 13 then
        PermissionDenied
    elif code == 1 then
        NotPermitted
    elif code == 17 then
        AlreadyExists
    elif code == 20 then
        NotADirectory
    elif code == 21 then
        IsADirectory
    elif code == not_empty() then
        DirectoryNotEmpty
    elif code == 24 then
        TooManyOpenFiles
    elif code == 28 then
        NoSpaceLeft
    elif code == 4 then
        Interrupted
    elif code == 9 then          // EBADF, which is also what a use of a closed `File` reports
        NotOpen
    else
        Other(code)
end from_errno

/** A hook's failure status as the `IoError` it stands for, turned back into its case here and nowhere
 * else (`sysl.fs.sys`). A status is the error's code negated, as a system call answers it, so 13 comes
 * back as `PermissionDenied` and -1 as `EPERM`, which is `NotPermitted`. **Exactly
 * `UNSUPPORTED` (`sysl.sys`) is the target saying it cannot do the call at all** and is
 * `unsupported()`; no other status is.
 */
private[sysl] from_status(status: int) -> IoError =
    if status == UNSUPPORTED then unsupported() else from_errno(-status)

/** A hook's status as the `Result` the rest of the module speaks in: zero is success, and anything
 * else is the error's code negated, turned back into its case by `from_status`.
 */
private[sysl] answered(status: int) -> Result[unit, IoError] = if status != 0 then Err(from_status(status)) else Ok(())

/** What an operation reports where **this target has no way to perform it at all** -- not a failure
 * of the call, but the absence of one.
 *
 * It carries `sysl.sys.UNSUPPORTED`, a negative number that is no `errno` on any platform, so it
 * cannot be confused with a code a host reports. It is deliberately not the host's `ENOSYS`, which
 * is 78 on macOS and 38 on Linux: the contract means one thing everywhere, and the hosted suppliers
 * translate the host's own into it.
 *
 * It is what a hook of any `*.sys` module answers for a call its supplier has no way to make, and
 * what reaches a caller as `from_status(UNSUPPORTED)`: a target whose C library has no `chmod`, or a
 * program on a bare machine answering for a filesystem that has no links.
 */
private[sysl] unsupported() -> IoError = Other(UNSUPPORTED)

private const unsupported_code: int = UNSUPPORTED
