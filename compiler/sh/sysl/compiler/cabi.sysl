module sh.sysl.compiler

import sysl.buf.{Buf, buf}

// **How an aggregate -- and a narrow scalar -- is handed to and from a C function.**
//
// A register-width scalar crosses the boundary as itself: an `i32` is one register on every machine
// sysl lowers for, and nothing has to be decided. An aggregate does not. Each ABI says which
// registers a struct arrives in, and **LLVM applies no such rule of its own** -- given a struct type
// in a signature it assigns one register per element, which is not what a single one of the
// conventions below asks for. So the declaration a call names has to be the *coerced* one the ABI
// specifies, and the value converted into and out of that shape at the call.
//
// The **coercion** is not needed for a call from sysl to sysl. Both sides are this compiler, so a
// struct handed over as a struct is a convention like any other and the two agree by construction.
// It is only at the seam with a foreign function -- where the other side was compiled by somebody
// else against a published document -- that the published answer is the only one that works.
//
// The **extension** does not divide that way, and it is the one answer here that a sysl-to-sysl
// signature carries too: a definition cannot know that C is not on the other end of it, and widening
// a result is what the *callee* owes. `c_extension` in `emit_sig.sysl` says which side owes what.
//
// Every rule below was read off `clang -S -emit-llvm` for the triple, which is the only method that
// finds the parts no document states plainly: that AAPCS64 hands a small struct **back** in an
// integer of its exact width while taking the same struct widened to a whole register; that System V
// splits a sixteen-byte struct into two *separate* parameters where AAPCS64 passes one array of two;
// and that RISC-V flattens a struct of one float and one integer into two registers but does **not**
// flatten one of a pointer and a float.

// What a call names as its result type, and how the value comes back.
enum CResult
    // Nothing to coerce -- the sysl type is already what the ABI asks for.
    CrPlain

    // An aggregate returned in registers, under a different LLVM type.
    CrCoerced(ty: LType)

    // An aggregate too big for registers: the caller supplies the storage and the callee fills it,
    // so the declared result is `void` and an out-parameter goes in front of every argument.
    CrSret(ty: LType, align: int)
end CResult

// What a call passes for one declared parameter. One register's worth of an argument is exactly a
// declared parameter, so a coerced one is a list of `IrParam` -- the type it is named by and
// whatever attribute the convention puts on it.
enum CParam
    // Nothing to coerce.
    CpPlain

    // An aggregate spread across registers, each its own parameter.
    CpCoerced(pieces: Buf[IrParam])

    // An aggregate passed by address. `byval` says the bytes go on the caller's stack and the
    // pointer is how LLVM is told to put them there -- System V's answer, and WebAssembly's. The
    // rest pass a real pointer in a register, and marking one `byval` there would be a different
    // call.
    CpIndirect(ty: LType, align: int, byval: bool)
end CParam

// The registers an aggregate occupies, named twice -- because a result and an argument may spell the
// same registers differently, which is AAPCS64's case throughout and nobody else's.
private enum CShape
    CsMemory

    CsRegisters(returned: LType, passed: Buf[IrParam])

    // AAPCS32's case, and the reason `CsMemory` is not enough on its own: that convention returns
    // anything wider than a register through storage while still passing the very same aggregate
    // **in whole words**, at any size at all. A sixty-four-byte struct is an `sret` result and a
    // `[16 x i32]` argument, so the two answers cannot be read off one verdict.
    CsSplit(passed: Buf[IrParam])
end CShape

// Whether a type is one the ABI has an answer about -- that is, whether its LLVM form is something
// other than a single register's worth of value.
//
// A trait object and a view are here because they *are* aggregates, whatever a C header would have
// called them: a `string` is three words, and a C function declared to take a matching three-word
// struct is the only C function it can correctly reach.
//
// A **zero-sized** aggregate is left alone. C passes nothing for one and LLVM assigns an empty
// aggregate no register either, so the two already agree and there is nothing to coerce.
c_aggregate(l: TargetLayout, t: Type) -> bool = underlying(t) match
    Struct(_) -> l.size(t) > 0
    Array(_, _) -> l.size(t) > 0
    Slice(_, _) -> true
    Str -> true
    VaList -> true
    Enum(d) -> !d.simple
    p -> erased(p) || c_erased_weak(p)

c_result(l: TargetLayout, t: Type, target: Target) -> CResult
    if !c_aggregate(l, t) then return CrPlain

    c_shape(l, t, target) match
        CsMemory -> CrSret(c_lty(l, t), int(l.align(t)))
        CsSplit(_) -> CrSret(c_lty(l, t), int(l.align(t)))
        CsRegisters(returned, _) -> CrCoerced(returned)
end c_result

c_param(l: TargetLayout, t: Type, target: Target) -> CParam
    if !c_aggregate(l, t) then return CpPlain

    c_shape(l, t, target) match
        CsMemory -> c_stack_copy(l, t, target) match
            Some(align) -> CpIndirect(c_lty(l, t), align, true)
            None -> CpIndirect(c_lty(l, t), int(l.align(t)), false)
        CsRegisters(_, passed) -> CpCoerced(passed)
        CsSplit(passed) -> CpCoerced(passed)
end c_param

// Whether an aggregate that goes in memory is a copy the **caller** makes -- LLVM's `byval` -- and
// at what alignment the convention states the slot, or nothing where the callee is handed an address
// it may not write.
//
// **Two conventions ask for the copy and they state its alignment by different rules.** System V
// aligns an argument passed in memory to eight whatever the aggregate is made of; WebAssembly states
// the type's own alignment and nothing more. CRAFT states the type's own for wasm's reason and not
// System V's: there is no convention here declaring a floor, so the only honest number is what the
// type itself needs.
private c_stack_copy(l: TargetLayout, t: Type, target: Target) -> Option[int]
    if target.cpu == X86_64 && target.os != Windows then return Some(max_int(int(l.align(t)), 8))
    if target.cpu == Wasm32 then return Some(int(l.align(t)))
    if target.cpu == Craft then return Some(int(l.align(t)))

    None
end c_stack_copy

private c_shape(l: TargetLayout, t: Type, target: Target) -> CShape
    val size = int(l.size(t))

    target.cpu match
        Aarch64 -> c_aapcs64(l, t, size, target.os == MacOS)
        X86_64 -> if target.os == Windows then c_windows(size) else c_sysv(l, t, size)
        Riscv64 -> c_riscv(l, t, size, target.hard_float(), 8)
        Riscv32 -> c_riscv(l, t, size, target.hard_float(), 4)
        Thumb -> c_aapcs32(l, t, size, target.hard_float())
        Wasm32 -> c_wasm(l, t, size)
        // **CRAFT has no C compiler, so there is no convention to agree with**, and that is the
        // answer rather than a measurement nobody made. What is left is the back end's own lowering,
        // and passing an aggregate through memory is what it does.
        Craft -> c_craft(l, t, size)
        // i386 is refused at the registry for want of exactly this, so nothing reaches here.
        X86 -> CsMemory

// Where a result and an argument name the same registers the same way, which is every convention but
// AAPCS64: a result in two registers is a literal struct of them, and an argument in two is two
// parameters.
private c_alike(pieces: Buf[LType]) -> CShape
    var passed: Buf[IrParam] = buf()

    for piece in pieces
        passed.push(ir_param(piece))

    CsRegisters(if pieces.len() == 1 then pieces.at(0) else LStruct(pieces), passed)
end c_alike

private c_one_param(t: LType) -> Buf[IrParam]
    var out: Buf[IrParam] = buf()

    out.push(ir_param(t))
    out
end c_one_param

// -- AAPCS64 --------------------------------------------------------------------------------------

// AAPCS64, which asks first whether the aggregate is a **homogeneous floating aggregate** -- up to
// four members that are all the same floating type, however deeply nested -- because those go in the
// floating registers whatever their size, and only then falls back to size.
//
// This is the convention whose two directions differ everywhere. A result is named by the
// aggregate's own width, down to the bit; an argument by the whole registers it travels in, whose
// surplus bits the convention leaves unspecified. And an argument every one of whose members is an
// address is named in addresses, so that what a pointer carries beyond its bits survives being
// handed over.
private c_aapcs64(l: TargetLayout, t: Type, size: int, mac_os: bool) -> CShape
    val ls = c_leaf_types(l, t)
    val addresses = !ls.is_empty() && c_all_addresses(ls)

    c_hfa(l, t, ls) match
        // Away from Darwin the convention says how far to align a floating aggregate that runs out
        // of registers and lands on the stack. Darwin's variant does not ask for it. A quad member's
        // slot is sixteen bytes rather than eight, as its own alignment is.
        Some(both) ->
            var attrs: Buf[IrAttr] = buf()

            if !mac_os then attrs.push(AttrAlignStack(if l_render(both.0) == "fp128" then 16 else 8))

            var passed: Buf[IrParam] = buf()

            passed.push(IrParam(LArr(both.1, both.0), attrs, None))
            return CsRegisters(c_lty(l, t), passed)
        None -> ()

    if size <= 8
        return CsRegisters(LInt(size * 8), c_one_param(if addresses then LPtr else LInt(64)))

    // Two registers, and what names them is the *alignment*: sixteen bytes wanting sixteen-byte
    // alignment is one `i128`, which is a register pair, where eight-byte alignment is two of them.
    if size <= 16 && l.align(t) >= 16 then return c_alike(l_one(LInt(128)))

    if size <= 16
        return CsRegisters(LArr(2, LInt(64)),
                           c_one_param(LArr(2, if addresses then LPtr else LInt(64))))

    CsMemory
end c_aapcs64

// The floating type and count of a homogeneous floating aggregate, or nothing. Four is the limit
// because that is how many registers the convention sets aside for one; a fifth member makes the
// whole thing an ordinary aggregate again, however small it is.
//
// **Where a union is anywhere inside, the members are counted by SIZE, not by leaf.** The fields of
// a union overlap, so `union { float a; float b[2]; }` has three float leaves and is two floats wide
// -- clang counts a union as its widest field and then requires the aggregate to be exactly that many
// members of the one type, which is the aggregate's size over the member's.
private c_hfa(l: TargetLayout, t: Type, ls: Buf[Type]) -> Option[(LType, int)]
    if ls.is_empty() then return None

    for i in 0..<ls.len()
        if !c_floating(ls.at(i)) then return None
        if !type_eq(ls.at(i), ls.at(0)) then return None

    var count = int(ls.len())

    if c_has_union(t)
        val each = int(l.size(ls.at(0)))
        val size = int(l.size(t))

        if size % each != 0 then return None

        count = size / each

    // **An HFA has no padding**: the members are the whole of it. A zero-width bitfield of a wider
    // type can push the next float to a wider boundary (`{ float f; long long :0; float g; }` is
    // sixteen bytes on AAPCS), and two floats in sixteen bytes travel as integers.
    if int(l.size(t)) != count * int(l.size(ls.at(0))) then return None
    if count > 4 then return None

    Some((c_lty(l, ls.at(0)), count))
end c_hfa

// Whether a union is anywhere in an aggregate's layout -- itself, a field, or an element.
private c_has_union(t: Type) -> bool = underlying(t) match
    Struct(d) ->
        if d.union_layout then return true

        for field in d.stored()
            if c_has_union(field.1) then return true

        false
    Array(_, elem) -> c_has_union(*elem)
    _ -> false

// -- AAPCS32 --------------------------------------------------------------------------------------

// AAPCS32, the Cortex-M convention, in **both** of its float variants -- and the one that breaks the
// shape every other convention here has, because **its two directions disagree about memory itself**
// rather than merely about how to name the same registers.
//
// A result wider than one register goes through storage, at any size. An argument **never** does:
// whatever its size, it is named as whole words and the back end puts the surplus on the stack
// itself. The word an argument is counted in follows the aggregate's **alignment**, not its size,
// and a result of four bytes or fewer is named by a whole power-of-two width.
//
// **The HFA rule is the hard-float variant's and belongs to it alone.** Under `softfp` there are no
// floating registers for an aggregate to travel in, so a struct of floats is an ordinary aggregate
// of its size and takes the rules below.
private c_aapcs32(l: TargetLayout, t: Type, size: int, hard_float: bool) -> CShape
    val ls = c_leaf_types(l, t)
    val floats = if hard_float then c_hfa(l, t, ls) else None

    floats match
        // An HFA crosses as the struct type itself in both directions: one VFP register per member
        // is what the convention asks for and what LLVM does with a struct unaided, so the two agree
        // and there is nothing to coerce.
        Some(_) -> return CsRegisters(c_lty(l, t), c_one_param(c_lty(l, t)))
        None -> ()

    val unit = if l.align(t) >= 8 then 8 else 4
    val words = c_one_param(LArr(round_up_int(size, unit) / unit, LInt(unit * 8)))

    if size <= 4 then return CsRegisters(if size <= 2 then LInt(size * 8) else LInt(32), words)

    CsSplit(words)
end c_aapcs32

// -- System V x86-64 -------------------------------------------------------------------------------

// System V, which classifies the aggregate **one eightbyte at a time**: a chunk whose every byte
// belongs to a floating member travels in a floating register, anything else in an integer one. Past
// two eightbytes there are no registers left for it and the whole thing goes in memory.
private c_sysv(l: TargetLayout, t: Type, size: int) -> CShape
    if size > 16 || c_misaligned(l, t, 0) then return CsMemory

    val ls = c_leaves(l, t, BvNamed)
    var reach: Buf[(int, int)] = buf()

    c_bit_reach(l, t, 0, &reach)

    // A `__float128` is one SSE register on its own -- the SSE and SSEUP classes of both eightbytes
    // -- so an aggregate that is nothing but one travels as it does, and it fills all sixteen bytes.
    for item in ls
        if is_quad(item.1) then return c_alike(l_one(LFloat(128, false)))

    var pieces: Buf[LType] = buf()

    for i in 0..<((size + 7) / 8)
        val lo = i * 8
        val hi = min_int(size, lo + 8)

        var here: Buf[(usize, Type)] = buf()

        for item in ls
            val off = int(item.0)

            if off < hi && off + int(l.size(item.1)) > lo then here.push(item)

        if !here.is_empty() && c_all_floating_pairs(here) then pieces.push(c_floating_chunk(l, here))
        else pieces.push(c_integer_chunk(l, ls, reach, lo, hi, size))

    // **The second eightbyte has to start at byte eight of the pair**, and a pair of a four-byte
    // first piece and a second piece aligned to four would put it at byte four. clang widens the
    // first piece to a whole register then -- a `float` to a `double`, an integer to an `i64` -- so
    // `{ float f; <padding>; float g; }` is `(double, float)`. Only a padded first eightbyte can be
    // short, which an `@align` or a zero-width bitfield makes.
    if pieces.len() == 2 && round_up_int(c_piece_bytes(pieces.at(0)), c_piece_bytes(pieces.at(1))) != 8
        val first = pieces.at(0)
        var widened: Buf[LType] = buf()

        widened.push(first match
            LFloat(_, _) -> LFloat(64, false)
            _ -> LInt(64))
        widened.push(pieces.at(1))
        return c_alike(widened)
    end if

    c_alike(pieces)
end c_sysv

// The bytes a System V piece takes, which for every piece that names an eightbyte is also its
// alignment: an integer of 1, 2, 4 or 8 bytes, a float, a `double`, a pair of floats, an address.
private c_piece_bytes(t: LType) -> int = t match
    LInt(bits) -> if bits <= 8 then 1 elif bits <= 16 then 2 elif bits <= 32 then 4 else 8
    LFloat(bits, _) -> if bits <= 16 then 2 elif bits <= 32 then 4 else 8
    _ -> 8

// Whether any member of the aggregate sits off its own alignment, which System V classifies as
// **MEMORY whatever the size is** -- the one clause of the classification that is about the layout
// rather than about the members' kinds, and the only thing `@packed` changes about a call.
//
// **A bitfield struct is never one of these**, and that is clang's answer rather than a choice made
// here: its members are ranges of a container rather than objects with addresses, so there is
// nothing for the clause to be about. The same holds of a C bitfield, so a struct with them is asked
// only about its ordinary fields, where its C layout puts them.
private c_misaligned(l: TargetLayout, t: Type, at: int) -> bool = underlying(t) match
    Struct(d) if !d.c_bits.is_empty() -> c_bits_misaligned(l, d, at)
    Struct(d) -> if bitfield_ranges(d).is_some() then false else c_struct_misaligned(l, d, at)
    // Every element of an array is the stride from the one before it, so if the first is on its
    // alignment they all are -- and if it is not, none of them is.
    Array(n, elem) -> n > 0 && c_misaligned(l, *elem, at)
    _ -> false

private c_struct_misaligned(l: TargetLayout, d: &StructType, at: int) -> bool
    var off = at
    var bad = false
    val fields = d.stored()

    for field in fields
        val f = field.1

        if d.union_layout then off = at
        elif !d.packed then off = int(round_up(usize(off), l.align(f)))
        if off % int(l.align(f)) != 0 || c_misaligned(l, f, off) then bad = true

        off += int(l.size(f))

    bad
end c_struct_misaligned

private c_bits_misaligned(l: TargetLayout, d: &StructType, at: int) -> bool
    val c = c_bitfield_layout(l, d)

    for i in 0..<d.fields.len()
        if d.c_bit(i).is_some() then continue

        val f = d.fields.at(i).1
        val off = at + int(c.places.at(i).unit)

        if l.size(f) > 0 && (off % int(l.align(f)) != 0 || c_misaligned(l, f, off)) then return true

    false
end c_bits_misaligned

// Members that all fit in floating registers are named by what fills the chunk: several of one width
// as a vector of that many, one on its own as itself. A chunk two *different* floating widths share
// has no such name, and clang falls back to a whole `double`.
private c_floating_chunk(l: TargetLayout, here: Buf[(usize, Type)]) -> LType
    var kinds: Buf[LType] = buf()

    for item in here
        val k = c_lty(l, underlying(item.1))

        if !c_holds_lty(kinds, k) then kinds.push(k)

    if kinds.len() > 1 then return LFloat(64, false)

    // Counted by the bytes they start at, not by member: a union's fields overlap, so two floats at
    // the same offset are one float's worth of the chunk.
    var starts: Buf[usize] = buf()

    for item in here
        var seen = false

        for s in starts
            if s == item.0 then seen = true

        if !seen then starts.push(item.0)

    if starts.len() == 1 then return kinds.at(0)

    LVec(int(starts.len()), kinds.at(0))
end c_floating_chunk

// An integer chunk is named by **the member that starts it**, when that member is all the chunk
// carries: a `u8` in the second eightbyte of `{i64, u8}` is an `i8`, not the whole register it will
// travel in. When the chunk carries more than the member starting it, there is no one member to name
// it after and it is the bytes that are left.
private c_integer_chunk(l: TargetLayout, ls: Buf[(usize, Type)], reach: Buf[(int, int)], lo: int,
                        hi: int, size: int) -> LType
    var starts: Option[Type] = None

    // Where several start there -- a union's fields all do -- the widest is the one the chunk is
    // named after, as clang names a union by its widest field.
    for item in ls
        if int(item.0) == lo
            starts = starts match
                Some(m) if l.size(m) >= l.size(item.1) -> Some(m)
                _ -> Some(item.1)

    // Clamped to what is left of the aggregate, because a member's *allocation* may be wider than
    // the storage it occupies here: a bitfield struct's three-byte container is an `i24`, whose
    // stride standing alone is four.
    val width = starts match
        Some(m) -> min_int(int(l.size(m)), size - lo)
        None -> 0

    val edge = min_int(lo + 8, size)
    var alone = true

    for item in ls
        val off = int(item.0)

        if off >= lo + width && off < edge then alone = false

    if c_bits_overlap(reach, (lo + width) * 8, edge * 8) then alone = false

    val is_address = starts match
        Some(m) -> c_address(underlying(m))
        None -> false

    // An address fills its chunk and is named as one, which changes nothing about the call but keeps
    // what a pointer carries beyond its bits.
    if width == 8 && is_address then return LPtr
    if alone && (width == 1 || width == 2 || width == 4) then return LInt(width * 8)

    LInt((hi - lo) * 8)
end c_integer_chunk

// -- RISC-V, LP64D and ILP32 -----------------------------------------------------------------------

// RISC-V's convention, which is **one rule with the register width in it** rather than two: every
// threshold below is a count of `XLEN`, so LP64D and ILP32 are the same function with `xlen` at
// eight and at four.
//
// The hardware-float variant **flattens** the narrow cases: an aggregate of one or two floating
// members travels in floating registers, and one floating member beside one integer member travels
// in one of each. Anything else falls back to size -- including a pointer beside a float, which the
// convention does not count as the integer case. A C bitfield, named or not, is an integer member
// of its own (`{ float f; unsigned a:3; }` is `(float, i8)`, and with a second bitfield it is three
// members and one register), and a zero-width one counts as clang counts it (`c_zero_blocks`).
//
// Two registers are named by the aggregate's **alignment**: a two-word span aligned to two words is
// one double-width integer, and otherwise it is an array of two. One register is named by the
// aggregate's own **width**, which is what clang writes and what sysl follows.
private c_riscv(l: TargetLayout, t: Type, size: int, hard_float: bool, xlen: int) -> CShape
    val ls = c_leaf_types(l, t)
    var fps = 0
    var ints = 0

    // A floating member counts only where a floating register holds it: `D` registers are eight bytes,
    // so a `long double` -- binary128 -- travels as integers like any other sixteen bytes.
    for item in ls
        if c_floating(item) && l.size(item) <= 8 then fps += 1
        if c_integral(item) && int(l.size(item)) <= xlen then ints += 1

    // **A union is never flattened, and neither is anything holding one**: clang's flattening walks
    // struct fields and gives up at a union, so a union of one `float` travels as the integer its
    // size is where a struct of one `float` travels as a float.
    var seen = 0

    if hard_float && ls.len() <= 2 && fps >= 1 && fps + ints == int(ls.len()) && !c_has_union(t) &&
       !c_zero_blocks(l, t, &seen)
        var pieces: Buf[LType] = buf()

        for m in ls
            pieces.push(if c_floating(m) then c_lty(l, m) else LInt(int(l.size(m)) * 8))

        return c_alike(pieces)

    if size <= xlen then return c_alike(l_one(LInt(size * 8)))

    if size <= xlen * 2
        val wide = l.align(t) >= usize(xlen * 2)

        return c_alike(l_one(if wide then LInt(xlen * 16) else LArr(2, LInt(xlen * 8))))

    CsMemory
end c_riscv

// -- Windows x64 -----------------------------------------------------------------------------------

// The Microsoft convention, the simplest of them: an aggregate whose size is exactly one register's
// worth travels in one register as an integer of that width, and everything else -- a three-byte
// struct as much as a thirty-byte one -- goes by address.
private c_windows(size: int) -> CShape =
    if size == 1 || size == 2 || size == 4 || size == 8 then c_alike(l_one(LInt(size * 8)))
    else CsMemory

// -- WebAssembly -------------------------------------------------------------------------------------

// WebAssembly's convention, which is the only one that asks nothing about **size**. An aggregate that
// is one scalar with structs and one-element arrays wrapped round it travels as that scalar;
// everything else goes in memory, at any size at all.
private c_wasm(l: TargetLayout, t: Type, size: int) -> CShape = c_only_scalar(l, t, size) match
    Some(scalar) -> c_alike(l_one(c_lty(l, scalar)))
    None -> CsMemory

// -- CRAFT -------------------------------------------------------------------------------------------

// CRAFT, whose rule reads like wasm's and is arrived at from the opposite direction. wasm flattens
// nothing because the machine has no registers for an aggregate to be flattened *into*. CRAFT has
// eight of them and they are **two bytes each**, so a rule that put an aggregate in registers would
// be spending the whole register file on a struct of four fields.
private c_craft(l: TargetLayout, t: Type, size: int) -> CShape = c_only_scalar(l, t, size) match
    Some(scalar) -> c_alike(l_one(c_lty(l, scalar)))
    None -> CsMemory

// The one scalar an aggregate is made of, where it is made of exactly one and no padding was added
// round it -- clang's single-element struct, which sees through nesting in both directions. A C
// bitfield is its declared type here and an unnamed one is not a member at all, so `{ unsigned a:3;
// }` is one `unsigned` where `{ unsigned a:3; unsigned b:29; }` is two members and goes in memory.
//
// **The size check is what stops an over-aligned wrapper from being unwrapped.** A struct of one
// `i32` declared to align to eight is eight bytes with one member, and clang passes it in memory
// rather than as an `i32`.
private c_only_scalar(l: TargetLayout, t: Type, size: int) -> Option[Type]
    val ls = c_leaves(l, t, BvDeclared)

    if ls.len() != 1 then return None
    if int(ls.at(0).0) != 0 then return None
    if int(l.size(ls.at(0).1)) != size then return None

    Some(ls.at(0).1)
end c_only_scalar

// -- the members an aggregate is made of ------------------------------------------------------------

// **How a convention counts a C bitfield** (`name: uN in S`) among an aggregate's members. clang
// asks each convention's question of the *fields* C declared, and the conventions disagree about
// what a bitfield is to them -- so the answer is a parameter of the walk rather than one list.
private enum CBitView
    // Every bitfield with a width, named or not, as one integer member of its own width rounded up
    // to a power-of-two number of bytes (`a: u3 in u32` is an `i8`, `a: u20 in u32` an `i32`), at
    // the byte it begins in. AAPCS asks its homogeneity question of these, so an unnamed bitfield
    // keeps a struct of floats from being an HFA; RISC-V counts them when it flattens.
    BvEvery

    // The same, but only the named ones: System V's classification passes an unnamed bitfield over.
    BvNamed

    // Only the named ones, each as the type C declared it with: wasm's single-element struct, where
    // `{ unsigned a:3; }` is one `unsigned` and travels as an `i32`.
    BvDeclared
end CBitView

// The scalars an aggregate is made of, flattened through every level of nesting, each paired with
// the byte it starts at. This is what the homogeneity question, the flattening question and the
// eightbyte question are all asked of, and it walks the layout the emitted module actually has
// rather than the one a program wrote.
private c_leaves(l: TargetLayout, t: Type, view: CBitView) -> Buf[(usize, Type)]
    var acc: Buf[(usize, Type)] = buf()

    c_walk(l, t, 0, &acc, view)
    acc
end c_leaves

private c_walk(l: TargetLayout, t: Type, at: usize, acc: *Buf[(usize, Type)], view: CBitView)
    underlying(t) match
        // A struct with C bitfields is walked by the target's C layout, and each bitfield is a
        // member as `view` says.
        Struct(d) if !d.c_bits.is_empty() -> c_walk_bits(l, d, at, acc, view)

        // A bitfield struct has one member however many fields were written -- the container its
        // ranges are cut from -- so that is the one leaf. Walking the written fields instead would
        // put each at a byte offset of its own and make a one-byte struct three bytes of members.
        Struct(d) -> bitfield_ranges(d) match
            Some(ranges) -> acc.push((at, Integer(bitfield_bits(ranges), false, false)))
            // A union's fields all start at its first byte, so their leaves overlap -- which is what
            // every convention's question has to be asked of: System V's "is every byte of this
            // eightbyte floating?" counts a float and an integer over the same bytes as INTEGER.
            None if d.union_layout ->
                for field in d.stored()
                    c_walk(l, field.1, at, acc, view)
            None ->
                var off = at
                val fields = d.stored()

                for field in fields
                    val f = field.1

                    off = round_up(off, l.align(f))
                    c_walk(l, f, off, acc, view)
                    off += l.size(f)

        Array(n, elem) ->
            val stride = l.size(*elem)

            for i in 0..<n
                c_walk(l, *elem, at + usize(i) * stride, acc, view)

        // A data enum is the tag and the payload region, and the region is a union -- there is no
        // member to name inside it, so it counts as the integers it is emitted as. That makes an
        // enum never homogeneous and never all-floating, which is right: a union of a float and an
        // integer has to travel somewhere both of them fit.
        Enum(d) ->
            if d.simple then acc.push((at, underlying(t)))
            else
                val unit = max_usize_c(1, l.payload_align(d))
                val start = at + round_up(4, unit)

                acc.push((at, Integer(32, true, false)))

                for i in 0..<int((l.payload_size(d) + unit - 1) / unit)
                    acc.push((start + usize(i) * unit, Integer(int(unit) * 8, false, false)))

        // A view is the owner, the first element, and the count; a trait object is the table and the
        // value. Both are addresses and, for the view, a number -- which is all the ABI needs of
        // them. The strides are words rather than eights.
        Slice(_, _) -> c_walk_view(l, at, acc)
        Str -> c_walk_view(l, at, acc)

        VaList ->
            for i in 0..<4
                acc.push((at + usize(i) * l.pointer_bytes(), Ptr(byte_type())))

        p ->
            if erased(p) || c_erased_weak(p)
                acc.push((at, Ptr(byte_type())))
                acc.push((at + l.pointer_bytes(), Ptr(byte_type())))
            else acc.push((at, p))
end c_walk

// A struct with C bitfields, member by member where its C layout puts them. An ordinary field is
// walked as it would be anywhere; a bitfield is a member only as `view` counts it, and a zero-width
// one (`_: in S`) never is -- it holds nothing, and what it does to a call is RISC-V's alone
// (`c_zero_blocks`).
private c_walk_bits(l: TargetLayout, d: &StructType, at: usize, acc: *Buf[(usize, Type)], view: CBitView)
    val c = c_bitfield_layout(l, d)

    for i in 0..<d.fields.len()
        val p = c.places.at(i)
        val f = d.fields.at(i)

        d.c_bit(i) match
            None -> if l.size(f.1) > 0 then c_walk(l, f.1, at + p.unit, acc, view)
            Some(b) ->
                if b.width == 0 then continue
                if f.0 == "_" && view != BvEvery then continue

                val begins = at + usize(p.bit / 8)

                acc.push((begins, if view == BvDeclared then b.storage else Integer(c_bit_member(b.width), false, false)))
end c_walk_bits

// The width a bitfield counts as when it is a member: its own, rounded up to a whole power-of-two
// number of bytes, which is the integer clang names it by.
private c_bit_member(width: int) -> int
    var bits = 8

    while bits < width
        bits *= 2

    bits
end c_bit_member

// **Where C bitfields hold data in System V's eyes**, as bit ranges from the aggregate's first bit.
// System V names an integer eightbyte by the member starting it only where nothing after that
// member's own bytes holds data -- and to that question a bitfield, named, unnamed or zero-width,
// is its declared type's whole size from the bit it begins at (the size from where it begins, not the
// unit it lies in), so `{ double d; unsigned a:3; }` travels as `(double, i64)`, not `(double, i8)`.
private c_bit_reach(l: TargetLayout, t: Type, at: int, acc: *Buf[(int, int)])
    underlying(t) match
        Struct(d) if !d.c_bits.is_empty() ->
            val c = c_bitfield_layout(l, d)

            for i in 0..<d.fields.len()
                val p = c.places.at(i)

                d.c_bit(i) match
                    Some(b) -> acc.push((at + p.bit, at + p.bit + int(l.size(b.storage)) * 8))
                    None -> c_bit_reach(l, d.fields.at(i).1, at + int(p.unit) * 8, acc)
        Struct(d) ->
            if bitfield_ranges(d).is_some() then return

            var off: usize = 0

            for field in d.stored()
                if !d.union_layout then off = round_up(off, l.align(field.1))

                c_bit_reach(l, field.1, at + int(off) * 8, acc)

                if !d.union_layout then off += l.size(field.1)
        Array(n, elem) ->
            for i in 0..<n
                c_bit_reach(l, *elem, at + int(usize(i) * l.size(*elem)) * 8, acc)
        _ -> ()
end c_bit_reach

// Whether a bit range holds any of the data `c_bit_reach` found.
private c_bits_overlap(reach: Buf[(int, int)], from: int, to: int) -> bool
    for r in reach
        if r.0 < to && r.1 > from then return true

    false
end c_bits_overlap

// **RISC-V's one use of a zero-width bitfield**: clang's flattening walk counts the members it has
// seen, and gives up where, after a field of some struct, two have been seen and that struct has had
// a `:0` -- so `{ float f; int :0; float g; }` travels as one integer register where `{ float f;
// float g; int :0; }` travels as two floats. `seen` is that count, carried across the whole walk.
private c_zero_blocks(l: TargetLayout, t: Type, seen: *int) -> bool
    underlying(t) match
        Struct(d) ->
            if bitfield_ranges(d).is_some()
                *seen += 1
                return false
            end if

            var zeros = 0

            for i in 0..<d.fields.len()
                val f = d.fields.at(i).1

                d.c_bit(i) match
                    Some(b) ->
                        if b.width == 0
                            zeros += 1
                            continue
                        end if

                        *seen += 1
                    None ->
                        if l.size(f) == 0 then continue
                        if c_zero_blocks(l, f, seen) then return true

                if *seen >= 2 && zeros > 0 then return true

            false
        Array(n, elem) ->
            for i in 0..<n
                if c_zero_blocks(l, *elem, seen) then return true

            false
        _ ->
            *seen += int(c_leaves(l, t, BvEvery).len())
            false
end c_zero_blocks

private c_walk_view(l: TargetLayout, at: usize, acc: *Buf[(usize, Type)])
    val w = l.pointer_bytes()

    acc.push((at, Ptr(byte_type())))
    acc.push((at + w, Ptr(byte_type())))
    acc.push((at + w * 2, usize_type(int(l.word_bits))))
end c_walk_view

// -- what a leaf is ----------------------------------------------------------------------------------

private c_erased_weak(t: Type) -> bool = t match
    Weak(inner) -> is_trait(*inner)
    _ -> false

private c_floating(t: Type) -> bool = underlying(t) match
    Floating(_, _) -> true
    _ -> false

private c_address(t: Type) -> bool = underlying(t) match
    Ptr(_) -> true
    Ref(_, _) -> true
    Weak(_) -> true
    CFn(_, _) -> true
    _ -> false

private c_integral(t: Type) -> bool = underlying(t) match
    Integer(_, _, _) -> true
    Fixed(_, _, _) -> true
    Bool -> true
    Char -> true
    _ -> false

private c_all_addresses(ls: Buf[Type]) -> bool
    for item in ls
        if !c_address(item) then return false

    true
end c_all_addresses

private c_all_floating_pairs(here: Buf[(usize, Type)]) -> bool
    for item in here
        if !c_floating(item.1) then return false

    true
end c_all_floating_pairs

private c_leaf_types(l: TargetLayout, t: Type) -> Buf[Type]
    val ls = c_leaves(l, t, BvEvery)
    var out: Buf[Type] = buf()

    for item in ls
        out.push(underlying(item.1))

    out
end c_leaf_types

private c_holds_lty(xs: Buf[LType], x: LType) -> bool
    for item in xs
        if l_render(item) == l_render(x) then return true

    false
end c_holds_lty

// The LLVM form of a type, asked of a layout rather than of an emitter -- the ABI is a question
// about a machine and there need be no function being built to ask it.
c_lty(l: TargetLayout, t: Type) -> LType = type_lty(t, int(l.word_bits)) match
    Some(x) -> x
    None -> LVoid

private max_int(a: int, b: int) -> int = if a > b then a else b

private min_int(a: int, b: int) -> int = if a < b then a else b

private max_usize_c(a: usize, b: usize) -> usize = if a > b then a else b

private round_up_int(n: int, to: int) -> int = (n + to - 1) / to * to
