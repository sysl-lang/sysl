module sh.sysl.compiler
@tests

// The library's `Option` and `Result` and the postfix `?` that unwraps one or returns the enclosing
// function early with the failure re-wrapped -- run, the reference's `TryRunTests`. The building,
// running and the reference's second opinion are `tests_rng_impl_composed_run.sysl`'s.

private rng_try_unwrap() -> string = raw"""
    unwrap(o: Option[int], dflt: int) -> int
        o match
            Some(v) -> v
            None -> dflt
    end unwrap
    """

// ---- Option ----

@test("a Some and a None taken apart by a match")
rng_try_some_and_none_by_match()
    if !rng_ready() then return

    rng_prints(rng_try_unwrap() + raw"""
        var some: Option[int] = Some(5)
        var none: Option[int] = None
        print(unwrap(some, -1), unwrap(none, -1))
        """, "5 -1\n")

@test("the expected type gives a bare None its type argument")
rng_try_a_bare_none_takes_its_type()
    if !rng_ready() then return

    rng_prints(rng_try_unwrap() + raw"""
        pick(yes: bool) -> Option[int]
            if yes then Some(9) else None
        end pick
        print(unwrap(pick(true), 0), unwrap(pick(false), 0))
        """, "9 0\n")

// ---- Result ----

@test("Ok takes its error type from the return type")
rng_try_ok_takes_its_error_type()
    if !rng_ready() then return

    rng_prints(raw"""
        half(n: int) -> Result[int, string]
            if n % 2 == 0 then Ok(n / 2) else Err("odd")
        end half
        report(r: Result[int, string]) -> string
            r match
                Ok(v) -> "ok"
                Err(e) -> e
        end report
        print(report(half(8)), report(half(7)))
        """, "ok odd\n")

// ---- the ? operator ----

@test("propagates an Err and unwraps an Ok")
rng_try_propagates_an_err()
    if !rng_ready() then return

    rng_prints(raw"""
        half(n: int) -> Result[int, string]
            if n % 2 == 0 then Ok(n / 2) else Err("odd")
        end half
        quarter(n: int) -> Result[int, string]
            var h = half(n)?
            half(h)
        end quarter
        report(r: Result[int, string]) -> string
            r match
                Ok(v) -> "ok"
                Err(e) -> e
        end report
        print(report(quarter(20)), report(quarter(6)), report(quarter(7)))
        """, "ok odd odd\n")

@test("propagates a None through an Option-returning function")
rng_try_propagates_a_none()
    if !rng_ready() then return

    rng_prints(rng_try_unwrap() + raw"""
        tenfold(o: Option[int]) -> Option[int]
            var v = o?
            Some(v * 10)
        end tenfold
        print(unwrap(tenfold(Some(3)), -1), unwrap(tenfold(None), -1))
        """, "30 -1\n")

@test("carries the error payload across into the caller's own Result type")
rng_try_carries_the_error_payload()
    if !rng_ready() then return

    rng_prints(raw"""
        parse(s: string) -> Result[int, string]
            Err("bad input")
        end parse
        twice(s: string) -> Result[int, string]
            var n = parse(s)?
            Ok(n * 2)
        end twice
        show(r: Result[int, string]) -> string
            r match
                Ok(v) -> "ok"
                Err(e) -> e
        end show
        print(show(twice("x")))
        """, "bad input\n")

// ---- the ? operator on reference payloads ----

// `?` on a `Result[&Point, string]` unwraps the ok arm to a `&Point` that outlives the wrapper
// enum, while the err arm returns early. Both outcomes are exercised.
@test("unwraps a &T ok-payload and propagates the err arm")
rng_try_unwraps_a_reference_ok()
    if !rng_ready() then return

    rng_prints(raw"""
        struct Point
            x: int
            y: int
        mk(ok: bool) -> Result[&Point, string]
            if ok then Ok(Point(11, 22)) else Err("no")
        use(ok: bool) -> Result[int, string]
            var p = mk(ok)?
            Ok(p.x + p.y)
        show(r: Result[int, string]) -> int
            r match
                Ok(v) -> v
                Err(e) -> -1
        print(show(use(true)), show(use(false)))
        """, "33 -1\n")

// The failure carries a `&Fail`, which `?` moves through the early return into the caller's own
// `Result[int, &Fail]` -- the ok arm reads 7, the err arm carries 404 across.
@test("moves a &T error payload through the early return")
rng_try_moves_a_reference_error()
    if !rng_ready() then return

    rng_prints(raw"""
        struct Fail
            code: int
        mk(ok: bool) -> Result[int, &Fail]
            if ok then Ok(7) else Err(Fail(404))
        use(ok: bool) -> Result[int, &Fail]
            var n = mk(ok)?
            Ok(n * 10)
        show(r: Result[int, &Fail]) -> int
            r match
                Ok(v) -> v
                Err(e) -> e.code
        print(show(use(true)), show(use(false)))
        """, "70 404\n")

// Chained `?` on `Option[&Node]`: either missing link short-circuits to None. Three inputs cover a
// two-hop success, a one-hop-then-None, and an empty head.
@test("chains through an Option[&Node] traversal")
rng_try_chains_through_a_traversal()
    if !rng_ready() then return

    rng_prints(raw"""
        struct Node
            value: int
            next: Option[&Node]
        second(head: Option[&Node]) -> Option[int]
            var h = head?
            var nx = h.next?
            Some(nx.value)
        unwrap(o: Option[int]) -> int
            o match
                Some(v) -> v
                None -> -1
        var a: &Node = Node(3, None)
        var b: &Node = Node(2, Some(a))
        print(unwrap(second(Some(b))), unwrap(second(Some(a))), unwrap(second(None)))
        """, "3 -1 -1\n")

// The `&Point` that `?` yields flows straight into `Ok(...)`, which the enclosing
// `Result[&Point, string]` holds -- the `?` result and the `&T`-ok construction compose.
@test("flows a ? result straight into an Ok in a &T-ok-returning function")
rng_try_flows_into_an_ok()
    if !rng_ready() then return

    rng_prints(raw"""
        struct Point
            x: int
            y: int
        mk(ok: bool) -> Result[&Point, string]
            if ok then Ok(Point(5, 6)) else Err("no")
        relay(ok: bool) -> Result[&Point, string]
            Ok(mk(ok)?)
        show(r: Result[&Point, string]) -> int
            r match
                Ok(p) -> p.x + p.y
                Err(e) -> -1
        print(show(relay(true)), show(relay(false)))
        """, "11 -1\n")

// Extracting a freshly allocated `&Point` through `?` many times must keep it past the wrapper's
// drop and free it once -- a double free crashes. Ok arm only: 5 each, 20000 times.
@test("extracting a &T ok-payload in a long loop neither leaks nor double-frees")
rng_try_extracting_in_a_long_loop()
    if !rng_ready() then return

    rng_prints(raw"""
        struct Point
            x: int
            y: int
        mk() -> Result[&Point, string]
            Ok(Point(2, 3))
        use() -> Result[int, string]
            var p = mk()?
            Ok(p.x + p.y)
        var i = 0
        var total = 0
        while i < 20000
            use() match
                Ok(v) -> total += v
                Err(e) -> total += 0
            i++
        print(total)
        """, "100000\n")

// The err arm allocates a fresh `&Fail` each time and `?` re-wraps it into the caller's return;
// over a long loop every failure must be freed exactly once. Err arm only: 7 each.
@test("re-wrapping a &T error payload in a long loop neither leaks nor double-frees")
rng_try_rewrapping_in_a_long_loop()
    if !rng_ready() then return

    rng_prints(raw"""
        struct Fail
            code: int
        mk() -> Result[int, &Fail]
            Err(Fail(7))
        use() -> Result[int, &Fail]
            var n = mk()?
            Ok(n + 1)
        var i = 0
        var total = 0
        while i < 20000
            use() match
                Ok(v) -> total += 0
                Err(e) -> total += e.code
            i++
        print(total)
        """, "140000\n")
