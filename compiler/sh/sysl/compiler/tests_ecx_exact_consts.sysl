module sh.sysl.compiler
@tests

import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture

// **An untyped integer constant is the literal it stands for in exact arithmetic**
// (`reference/types.md § Arithmetic over literals is exact`): `Half * 2` at `const Half = 200` is the
// 400 that `200 * 2` is, refused at `u8` at compile time where it could once only trap at run time,
// and it chooses an overload as the literal does. Each test pins the constant against its literal.
// A constant declared with a type is a value of that type and is not exact.

private ecx_ready() -> bool
    if std_root().is_err()
        print("skipped: the standard module's source is not on this machine")
        return false

    if !clang_available()
        print("skipped: there is no clang on this machine")
        return false

    true
end ecx_ready

private ecx_write(main: string, consts: string) -> string
    val root = make_temp_dir("sysl-ecx").unwrap()

    make_dir_all(root).unwrap()
    write_text(root + "/sysl.hocon", "package {\n  name = \"probe\"\n}\n").unwrap()
    write_text(root + "/main.sysl", main).unwrap()

    if !consts.is_empty()
        make_dir_all(root + "/consts").unwrap()
        write_text(root + "/consts/consts.sysl", "module consts\n\n" + consts).unwrap()
    end if

    root
end ecx_write

private ecx_ran(main: string, consts: string) -> string
    val root = ecx_write(main, consts)
    val exe = root + "/built"

    build_native_program(root, None, None, DefaultOptimization, Some(exe)) match
        Err(why) ->
            val said = failure_text(why)

            remove_dir_all(root).unwrap_or(())
            return said
        Ok(_) -> ()

    val said = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    said match
        Err(_) -> "the program that was built could not be run"
        Ok(out) -> out.text
end ecx_ran

// The first complaint of the analysis, or "" where there is none.
private ecx_first(main: string, consts: string) -> string
    val root = ecx_write(main, consts)

    val out = emit_llvm_text(root, None) match
        Err(why) -> failure_text(why)
        Ok(made) -> if made.report.is_empty() then "" else analysis_report(made.report)

    remove_dir_all(root).unwrap_or(())

    val nl = out.index_of("\n")

    if nl.is_some() then out[0..<nl.unwrap()] else out
end ecx_first

// The constant's program is refused with the complaint the literal's is, and that complaint says `says`.
private ecx_alike(decls: string, literal: string, constant: string, says: string, consts: string)
    val lit = ecx_first(decls + literal + "\n", consts)
    val con = ecx_first(decls + constant + "\n", consts)

    assert(lit.contains(says), s"$literal: $lit")
    assert(con.contains(says), s"$constant: $con")

@test("an untyped constant in arithmetic is refused where its literal is, instead of trapping at run time")
ecx_basic()
    if !ecx_ready() then return

    ecx_alike("const Half = 200\n", "val x: u8 = 200 * 2", "val x: u8 = Half * 2", "the value 400 does not fit u8", "")
    ecx_alike("const Half = 200\n", "val x: u8 = 200 * 2", "val x: u8 = 2 * Half", "the value 400 does not fit u8", "")
    ecx_alike("const Half = 200\n", "val x: u8 = 200 + 100", "val x: u8 = Half + 100", "the value 300 does not fit u8", "")
    ecx_alike("const Half = 200\nconst Two = 2\n", "val x: u8 = 200 * 2", "val x: u8 = Half * Two", "the value 400 does not fit u8", "")
    ecx_alike("const Big = 65536\n", "val x: u32 = 65536 * 65536", "val x: u32 = Big * Big", "the value 4294967296 does not fit u32", "")

    // What fits is accepted and is the exact value, wherever the steps between went.
    assert_eq(ecx_ran("const Half = 200\nval x: u8 = Half * 2 - 200\nval y: u8 = Half * 2 / 2\nprint(x, y)\n", ""), "200 200\n")
    assert_eq(ecx_ran("const Big = 65536\nval m: u32 = Big * Big - 1\nprint(m)\n", ""), "4294967295\n")

@test("an untyped constant picks the overload its literal spelling does")
ecx_overload()
    if !ecx_ready() then return

    val src = raw"""
        h(v: u8) -> string = "u8"
        h(v: u16) -> string = "u16"

        const Half = 200
        const Small = 100
        """

    assert_eq(ecx_ran(src + "print(h(Half * 2), h(200 * 2))\n", ""), "u16 u16\n")
    // Both candidates hold 200, and arithmetic is in the literal's tier: ambiguous for both spellings.
    val lit = ecx_first(src + "print(h(100 * 2))\n", "")

    assert(lit.contains("'h' is ambiguous here"), lit)
    val con = ecx_first(src + "print(h(Small * 2))\n", "")

    assert(con.contains("'h' is ambiguous here"), con)
    assert_eq(ecx_ran(src + "print(h(Half + Small), h(200 + 100))\n", ""), "u16 u16\n")

@test("a chain of constants and a constant of a constant are exact throughout")
ecx_chains()
    if !ecx_ready() then return

    val decls = "const A = 100\nconst B = A\nconst C = B * 2\nconst D = C + A\n"

    ecx_alike(decls, "val x: u8 = 100 * 3", "val x: u8 = B * 3", "the value 300 does not fit u8", "")
    ecx_alike(decls, "val x: u8 = 100 * 2 * 2", "val x: u8 = C * 2", "the value 400 does not fit u8", "")
    ecx_alike(decls, "val x: u8 = 100 * 2 + 100 + 1", "val x: u8 = D + 1", "does not fit u8", "")
    assert_eq(ecx_ran(decls + "val x: u8 = B + A\nval y: u16 = D * 2\nprint(x, y)\n", ""), "200 600\n")

@test("a typed constant stays typed and is not exact")
ecx_typed_not_exact()
    if !ecx_ready() then return

    // `T * 2` is `u8` arithmetic over a value of the type: nothing is folded or refused at compile time.
    assert_eq(ecx_first("const T: u8 = 200\nval x = T * 2\n", ""), "")
    assert_eq(ecx_first("const T: u8 = 200\nval x: u8 = T * 2\n", ""), "")
    assert_eq(ecx_first("const T: u8 = 200\nconst Half = 2\nval x: u8 = T * Half\n", ""), "")

    // Its wrapping operator still wraps; the untyped one beside it is exact.
    assert_eq(ecx_ran("const T: u8 = 200\nprint(T *% 2)\n", ""), "144\n")

    // A typed constant among untyped ones makes the whole expression ordinary arithmetic.
    assert_eq(ecx_first("const T: u8 = 200\nconst K = 2\nval x: u8 = K * T\n", ""), "")

@test("an untyped constant in an array size still sizes the array")
ecx_array_size()
    if !ecx_ready() then return

    assert_eq(ecx_ran("const N = 200\nval a: [N * 2]u8 = [7; N * 2]\nprint(a.len, a[N * 2 - 1])\n", ""), "400 7\n")
    assert_eq(ecx_ran("const N = 200\nconst M = N * 2\nval a: [M]i64 = [0; M]\nprint(a.len)\n", ""), "400\n")

@test("a constant from another module is exact too")
ecx_other_module()
    if !ecx_ready() then return

    val consts = "const Half = 200\nconst Quad = Half * 2\n"

    ecx_alike("import consts\n", "val x: u8 = 200 * 2", "val x: u8 = consts.Half * 2", "the value 400 does not fit u8", consts)
    ecx_alike("import consts\n", "val x: u8 = 200 * 2", "val x: u8 = consts.Quad", "does not fit u8", consts)
    assert_eq(ecx_ran("import consts\nval x: u8 = consts.Half * 2 - 200\nprint(x)\n", consts), "200\n")

@test("negative values, shifts and the other operators are exact over constants")
ecx_negative_and_shift()
    if !ecx_ready() then return

    val decls = "const Neg = -100\nconst One = 1\nconst Eight = 8\n"

    // A negative result is refused at an unsigned type, and held to a signed one's range.
    ecx_alike(decls, "val x: u8 = 50 - 100", "val x: u8 = 50 + Neg", "does not fit u8", "")
    ecx_alike(decls, "val x: i8 = -100 * 2", "val x: i8 = Neg * 2", "the value -200 does not fit i8", "")
    assert_eq(ecx_ran(decls + "val x: i8 = Neg * 2 + 100\nprint(x)\n", ""), "-100\n")

    // A right shift and a quotient are the exact ones, whatever a step reached.
    assert_eq(ecx_ran(decls + "val x: u32 = (One << 10) >> Eight\nprint(x)\n", ""), "4\n")
    assert_eq(ecx_ran(decls + "val x: i16 = Neg * Neg / 100\nprint(x)\n", ""), "100\n")
    assert_eq(ecx_ran(decls + "val x: u8 = ~0xF0 & (Eight - 1)\nprint(x)\n", ""), "7\n")

    // A left shift past the width, a shift by a negative count and a divide by zero are refused.
    ecx_alike(decls, "val x = 1 << 40", "val x = One << 40", "a constant shifted by 40 places", "")
    ecx_alike(decls, "val x = 1 << -1", "val x = One << Neg", "a constant shifted by", "")
    ecx_alike("const Zero = 0\n", "val x = 10 / 0", "val x = 10 / Zero", "a constant divided by zero", "")
    ecx_alike("const Zero = 0\n", "val x = 10 % 0", "val x = 10 % Zero", "a constant divided by zero", "")

@test("a constant mixed with a literal and with a typed value")
ecx_mixed()
    if !ecx_ready() then return

    val decls = "const Half = 200\nconst T: u8 = 3\nval v: u8 = 100\n"

    // Beside a literal: exact. Beside a typed value, or a variable: the ordinary arithmetic of its type.
    ecx_alike(decls, "val x: u8 = 200 * 2 + 1", "val x: u8 = Half * 2 + 1", "the value 401 does not fit u8", "")
    assert_eq(ecx_first(decls + "val x: u8 = Half + v\n", ""), "")
    assert_eq(ecx_first(decls + "val x: u8 = Half * T\n", ""), "")
    assert_eq(ecx_first(decls + "val x: u16 = Half * 2 + u16(v)\n", ""), "")
    assert_eq(ecx_ran(decls + "val w: u16 = 1\nprint(Half * 2 + w)\n", ""), "401\n")

@test("a float constant is not an integer constant: IEEE division, no zero-divisor refusal")
ecx_float_constant()
    if !ecx_ready() then return

    assert_eq(ecx_first("const F = 1.5\nval x: f64 = F / 0\n", ""), "")
    assert_eq(ecx_first("const F = 1.5\nval x: f64 = F * 2\n", ""), "")
