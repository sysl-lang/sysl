module sysl

/** An answer that may have failed, carrying why. The error is a type parameter rather than a fixed
 * one so that a module can answer with an enum of its own failure cases and have them matched
 * exhaustively -- which is what the library's own conversions do (`from_utf8` answers with a
 * `Utf8Error`).
 *
 * Like `Option` this is an ordinary generic enum; `?` reaches it through `Library.tryVariants`.
 */
enum Result[T, E]
    Ok(value: T)
    Err(error: E)

    is_ok(self) -> bool = self match
        Ok(_) -> true
        Err(_) -> false

    is_err(self) -> bool = !self.is_ok()

    unwrap_or(self, default: T) -> T = self match
        Ok(v) -> v
        Err(_) -> default

    unwrap(self) -> T = self match
        Ok(v) -> v
        Err(_) ->
            print("panic: unwrap of an Err value")
            exit(1)

    expect(self, msg: string) -> T = self match
        Ok(v) -> v
        Err(_) ->
            print("panic:", msg)
            exit(1)

    unwrap_err(self) -> E = self match
        Err(e) -> e
        Ok(_) ->
            print("panic: unwrap_err of an Ok value")
            exit(1)

    expect_err(self, msg: string) -> E = self match
        Err(e) -> e
        Ok(_) ->
            print("panic:", msg)
            exit(1)
end Result

/** Two results are equal when they took the same road and agree at the end of it -- which is the only
 * reading that keeps `==` agreeing with `match`. An `Ok` is never equal to an `Err` however the two
 * payloads compare, and they need not even be comparable to each other: the bounds are on the two
 * parameters separately, so a `Result[int, IoError]` compares exactly when both halves do.
 */
impl[T: Eq, E: Eq] Eq for Result[T, E]
    eq(self, rhs: Self) -> bool
        self match
            Ok(a) ->
                rhs match
                    Ok(b) -> a == b
                    Err(_) -> false
            Err(a) ->
                rhs match
                    Ok(_) -> false
                    Err(b) -> a == b
    end eq
end Result[T, E]

/** The variant and its payload, written straight through to wherever they are going. The payload
 * gets a plain specifier, because the field a specifier describes is the whole result and not
 * what it is carrying (`library/core.md § A specifier is the whole value's field`).
 */
private render_result[T: Display, E: Display](x: Result[T, E], out: *Writer)
    x match
        Ok(v) ->
            out.write("Ok(".bytes)
            v.display(out, FormatSpec(0, -1, false))
            out.write(")".bytes)
        Err(e) ->
            out.write("Err(".bytes)
            e.display(out, FormatSpec(0, -1, false))
            out.write(")".bytes)
end render_result

/** A result renders as it is written -- `Ok(3)` or `Err(NotFound)` -- which is what makes a failed
 * `assert_eq` on one readable. `assert_eq` is bounded over `Eq + Display`, so this is not a
 * convenience beside `Eq for Result[T, E]`: without it a comparable result is still refused, and the
 * refusal talks about `Display` rather than about the comparison.
 *
 * The width is honoured by rendering twice into a counter first, exactly as a slice does: a field is
 * the whole value, so the padding cannot be decided until the length of the whole is known, and
 * measuring this way costs no allocation.
 */
impl[T: Display, E: Display] Display for Result[T, E]
    display(self, out: *Writer, fmt: FormatSpec)
        var pad = 0

        if fmt.width > 0
            var count = Counting(0)
            var sink: *Writer = &count

            render_result(self, sink)
            pad = fmt.width - int(count.n)

            if pad < 0 then pad = 0

        if !fmt.left then display_fill(out, 32, pad)

        render_result(self, out)

        if fmt.left then display_fill(out, 32, pad)
    end display
end Result[T, E]

/** What a `main` that answers with a `Result` does with the one it answered.
 *
 * **`main` may result in a `Result[unit, E]`, and this is what makes that mean something.** A program
 * whose every fallible step ends in `.unwrap()` reports its failures as panics, which name the line
 * that gave up rather than the thing that went wrong; letting `?` reach the top instead means the
 * failure travels as a value and is reported once, here, by the only code that knows the program is
 * over.
 *
 * The compiler calls this, and nothing else does -- an entry point that results in a `Result` is
 * compiled as a call to `main` followed by a call to this at the error type `main` named. The bound
 * is what makes the report possible: an error nobody can render could still be returned, and the
 * program would exit non-zero with nothing said.
 *
 * **The exit status is 1 rather than something read off the error.** A status is one byte and an
 * error is a value; mapping one onto the other is the program's business, and a program that wants
 * to choose its own status has `exit` and always did.
 */
private[sysl] main_result[E: Display](r: Result[unit, E])
    r match
        Ok(_) -> ()
        Err(e) ->
            eprints("error: ")
            e.display(stderr(), FormatSpec(0, -1, false))
            eprints("\n")
            exit(1)
