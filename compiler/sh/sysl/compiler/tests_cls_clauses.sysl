    cls_refused(raw"""
        g(a: bool, b: bool) -> int
        g(true, _) = 1
        g(_, true) = 2
        g(true, true) = 3
        g(_, _) = 4

        main()
            print(g(true, true))
        """, "unreachable clause 'g(true, true)': every argument list it matches is already " +
