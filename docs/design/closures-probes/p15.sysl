// A closure holding a local's address handed to an async function: the Task holds the closure until
// it is run, so the argument is kept past the call that made the task.
async work(f: &Fn() -> unit) -> int
    f()
    1

run() -> int
    var n = 0
    val p = &n

    block_on(work(() -> *p += 1)) + n

print(run())
