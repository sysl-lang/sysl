module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.env.{get as env_var}
import sysl.fs.{is_file, make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture
import sysl.text.{join, split, Search}

// What a manifest's `allocator` block and `optimization` key do to the program that is built
// (`reference/packages.md § One heap, and the package that names it` and `§ The optimization level a
// project is built at`).
//
// `tests_package_config.sysl` asks what the text means. What is asserted here is that the build
// **uses** the answer: the pair every allocation is emitted against, and the level the linker is
// handed. Each project is a real directory read through the driver, and every sentence quoted was read
// out of the reference compiler on the same project.

private mcg_library_here() -> bool = std_root().is_ok()

private val mcg_rtos: (string, string) = ("pvPortMalloc", "vPortFree")

private val mcg_libc: (string, string) = ("malloc", "free")

// A concatenation puts a string on the heap, which is the shortest thing that reaches the allocator
// through the runtime helpers rather than through a program's own code.
private val mcg_allocates: string = "var s = \"a\" + \"b\"\nprint(s)\n"

private val mcg_rtos_block: string = "allocator { alloc = \"pvPortMalloc\", free = \"vPortFree\" }\n"

// A project directory holding a program and, where one is given, a manifest beside it.
private mcg_project(program: string, config: string) -> string
    val root = make_temp_dir("sysl-mcg-").unwrap()

    write_text(s"$root/main.sysl", program).unwrap()

    if config != "" then write_text(s"$root/package.hocon", config).unwrap()

    root
end mcg_project

// A package the project depends on by path, stating whatever the case is about in its own manifest.
private mcg_dependency(says: string) -> string
    val root = make_temp_dir("sysl-mcg-geom-").unwrap()

    write_text(s"$root/package.hocon", s"package { name = \"geom\", version = \"0.1.0\" }\n$says").unwrap()
    make_dir_all(s"$root/geom").unwrap()
    write_text(s"$root/geom/geom.sysl", "module geom\n\ndouble(n: int) -> int = n * 2\n").unwrap()
    root
end mcg_dependency

// A project depending on `geom` at a path, with nothing else in its manifest.
private mcg_app(geom: string, program: string) -> string =
    mcg_project(program, s"package { name = \"app\", version = \"0.1.0\" }\n" +
        s"dependencies { g { path = \"$geom\" } }\n")

// The LLVM text `emit-llvm` would print for a project, or the refusal as the text.
private mcg_llvm(root: string) -> string = emit_llvm_text(root, None) match
    Ok(done) -> done.text
    Err(why) -> s"refused: ${why.message}"

private mcg_has(text: string, part: string) -> bool = text.index_of(part).is_some()

// What one command line came to: the status the shell hears, and every line the driver said.
private mcg_run(args: []string) -> (int, string)
    var lines: Buf[string] = buf()
    val sink = &lines
    val code = run_cli(args, (line) -> sink.push(line))

    (code, join(lines.view(), "\n"))
end mcg_run

// The command line the build of one command handed the linker. **The last link is forgotten first**,
// so a command that linked nothing -- a replayed binary, a refusal -- answers the empty string rather
// than some earlier test's line.
private mcg_linked(args: []string) -> string
    forget_last_link()

    val got = mcg_run(args)

    assert_eq(got.0, 0, got.1)
    last_link_command()
end mcg_linked

private mcg_building(root: string) -> string =
    mcg_linked(["sysl", "build", root, "-o", s"$root/out"])

// The program a test suite is built from and a program run from alike: one tree serves every command.
private val mcg_program: string = "main()\n    print(1)\n\n@test(\"one is one\")\none()\n    assert(1 == 1)\n"

private mcg_key(level: string) -> string = s"optimization = \"$level\"\n"

private mcg_without_trailing_newlines(text: string) -> string
    var n = text.len

    while n > 0 && text.bytes[n - 1] == u8('\n')
        n -= 1

    text[0..<n]
end mcg_without_trailing_newlines

// -- the emitted module ---------------------------------------------------------------------------

@test("the emitted module declares and calls libc's pair when nothing named another")
mcg_libc_pair_when_nothing_named_another()
    if !mcg_library_here() then return

    val root = mcg_project(mcg_allocates, "")
    val out = mcg_llvm(root)

    assert(mcg_has(out, "declare ptr @malloc("), out)
    assert(mcg_has(out, "declare void @free(ptr)"), out)
    assert(mcg_has(out, "call ptr @malloc("), out)
    remove_dir_all(root).unwrap_or(())
end mcg_libc_pair_when_nothing_named_another

@test("the emitted module declares and calls the pair a package named")
mcg_the_pair_a_package_named()
    if !mcg_library_here() then return

    val root = mcg_project(mcg_allocates, mcg_rtos_block)
    val out = mcg_llvm(root)

    use_allocator(mcg_libc)
    assert(mcg_has(out, "declare ptr @pvPortMalloc("), out)
    assert(mcg_has(out, "declare void @vPortFree(ptr)"), out)
    assert(mcg_has(out, "call ptr @pvPortMalloc("), out)
    assert(mcg_has(out, "call void @vPortFree("), out)
    remove_dir_all(root).unwrap_or(())
end mcg_the_pair_a_package_named

// A single missed emission site is a mixed heap, and a mixed heap is not something a link or a run
// reports -- it is corruption at whatever later moment the wrong `free` is reached.
@test("the emitted module reaches libc's pair nowhere at all once another is named")
mcg_libc_nowhere_once_another_is_named()
    if !mcg_library_here() then return

    val root = mcg_project(mcg_allocates, mcg_rtos_block)
    val out = mcg_llvm(root)

    use_allocator(mcg_libc)
    assert(!mcg_has(out, "@malloc"), out)
    assert(!mcg_has(out, "@free"), out)
    remove_dir_all(root).unwrap_or(())
end mcg_libc_nowhere_once_another_is_named

// The plain drop hook is installed by reading the runtime helpers' text for a call to the allocator,
// so the sniff has to be for the symbol in force rather than for a literal `@malloc`.
@test("the emitted module still installs the plain drop hook, which is found by reading for the allocator")
mcg_the_plain_drop_hook_either_way()
    if !mcg_library_here() then return

    val libc = mcg_project(mcg_allocates, "")
    val rtos = mcg_project(mcg_allocates, mcg_rtos_block)
    val theirs = mcg_llvm(rtos)
    val ours = mcg_llvm(libc)

    assert(mcg_has(ours, "define private void @arc.drop.plain("), ours)
    assert(mcg_has(theirs, "define private void @arc.drop.plain("), theirs)
    remove_dir_all(libc).unwrap_or(())
    remove_dir_all(rtos).unwrap_or(())
end mcg_the_plain_drop_hook_either_way

// A binding that names `pvPortMalloc` as the allocator *and* declares it -- which is exactly what a
// FreeRTOS package does -- must not produce two declarations. Both externs are **called**, since one
// nothing reaches is pruned and never declared.
@test("the emitted module declares the allocator once when an extern names the same symbol")
mcg_the_allocator_declared_once()
    if !mcg_library_here() then return

    val src = "extern pvPortMalloc(n: usize) -> *u8\nextern xPortGetFreeHeapSize() -> usize\n\n" +
        "print(xPortGetFreeHeapSize())\nval p = pvPortMalloc(8)\nif p == null then print(1)\n" +
        mcg_allocates
    val root = mcg_project(src, mcg_rtos_block)
    val out = mcg_llvm(root)

    use_allocator(mcg_libc)

    // The control: an extern the allocator has no claim on is declared, so the count below is a fact
    // about the collision rather than about whether an extern reaches the module at all.
    assert(mcg_has(out, "@xPortGetFreeHeapSize("), out)

    val lines = split(out, "\n")
    var declared = 0

    for i in 0..<lines.len
        if lines[i].starts_with("declare ptr @pvPortMalloc(") then declared += 1

    assert_eq(declared, 1, out)
    remove_dir_all(root).unwrap_or(())
end mcg_the_allocator_declared_once

// **The whole text, against the reference's on the same project** -- a single allocation site the
// rewrite missed, or a declaration in another place, is a line of difference.
@test("a project naming an allocator emits exactly the reference's text")
mcg_allocator_text_is_the_references()
    if !mcg_library_here() then return

    val oracle = env_var("SYSL_ORACLE") match
        None ->
            print("skipped: SYSL_ORACLE names no reference compiler")
            return
        Some(binary) -> binary

    val root = mcg_project("struct P\n    x: int\n\nval p: &P = P(3)\nprint(p.x)\n" + mcg_allocates,
                           mcg_rtos_block)
    val ours = mcg_without_trailing_newlines(mcg_llvm(root))

    use_allocator(mcg_libc)

    val theirs = capture(oracle, ["emit-llvm", root], "", [], true) match
        Err(_) -> "the oracle could not be run"
        Ok(answer) -> mcg_without_trailing_newlines(answer.text)

    assert(mcg_has(theirs, "declare ptr @pvPortMalloc("), theirs)
    assert_eq(ours, theirs)
    remove_dir_all(root).unwrap_or(())
end mcg_allocator_text_is_the_references

// **A program has one heap and any package may be the one that names it** -- the ordinary case once
// a driver is built on the binding that brings a kernel.
@test("a dependency's allocator is the program's")
mcg_a_dependencys_allocator_claim()
    if !mcg_library_here() then return

    val geom = mcg_dependency("allocator { alloc = \"geo_alloc\", free = \"geo_free\" }\n")
    val root = mcg_app(geom, "struct P\n    x: int\n\nval p: &P = P(geom.double(21))\nprint(p.x)\n")
    val out = mcg_llvm(root)

    use_allocator(mcg_libc)
    assert(mcg_has(out, "declare ptr @geo_alloc("), out)
    assert(mcg_has(out, "call void @geo_free("), out)
    assert(!mcg_has(out, "@malloc"), out)
    remove_dir_all(root).unwrap_or(())
    remove_dir_all(geom).unwrap_or(())
end mcg_a_dependencys_allocator_claim

// And two naming different pairs is refused on a hosted target too, where a libc would otherwise have
// stood in for neither of them.
@test("a project and a dependency naming two heaps are refused, naming both")
mcg_two_heaps_are_refused()
    if !mcg_library_here() then return

    val geom = mcg_dependency("allocator { alloc = \"geo_alloc\", free = \"geo_free\" }\n")
    val root = mcg_project("print(geom.double(21))\n",
        s"package { name = \"app\", version = \"0.1.0\" }\ndependencies { g { path = \"$geom\" } }\n" +
        "allocator { alloc = \"a2\", free = \"f2\" }\n")
    val out = mcg_llvm(root)

    use_allocator(mcg_libc)
    assert(mcg_has(out, "refused: two packages name different allocators, and a program has one heap — " +
        "'this project' names a2 / f2; 'g' names geo_alloc / geo_free. Drop one of the declarations, " +
        "or depend on only one of them"), out)
    remove_dir_all(root).unwrap_or(())
    remove_dir_all(geom).unwrap_or(())
end mcg_two_heaps_are_refused

// -- a library artifact ---------------------------------------------------------------------------

private mcg_meta(pair: (string, string)) -> string
    var names: Buf[string] = buf()

    names.push("m$double")
    use_allocator(pair)

    val meta = syslib_metadata(host_target(), "feedfacecafebeef", names)

    use_allocator(mcg_libc)
    meta
end mcg_meta

@test("a library artifact is read back by a program that allocates the same way")
mcg_an_artifact_read_back_the_same_way()
    val rtos = mcg_meta(mcg_rtos)
    val libc = mcg_meta(mcg_libc)

    use_allocator(mcg_rtos)

    val theirs = syslib_read("lib.syslib", rtos, host_target()).is_ok()

    use_allocator(mcg_libc)
    assert(theirs, "an artifact built for FreeRTOS's heap is read by a program on it")
    assert(syslib_read("lib.syslib", libc, host_target()).is_ok(), "and libc's by libc's")
end mcg_an_artifact_read_back_the_same_way

// Refused here because nothing downstream would refuse it: a mismatched allocator resolves cleanly,
// links, and runs.
@test("a library artifact is refused by a program that allocates another way, naming both pairs")
mcg_an_artifact_for_another_heap_names_both()
    val libc = mcg_meta(mcg_libc)

    use_allocator(mcg_rtos)

    val got = syslib_read("lib.syslib", libc, host_target())

    use_allocator(mcg_libc)

    got match
        Ok(_) -> assert(false, "a libc artifact was accepted by a program allocating through FreeRTOS")
        Err(why) ->
            assert(mcg_has(why, "lib.syslib allocates through malloc / free"), why)
            assert(mcg_has(why, "this program allocates through pvPortMalloc / vPortFree"), why)
            assert(mcg_has(why, "Rebuild the library"), why)
end mcg_an_artifact_for_another_heap_names_both

// Both wrong is reported as the target, the one a reader fixes first.
@test("a library artifact for another target and another heap reports the target")
mcg_an_artifact_wrong_twice_reports_the_target()
    val libc = mcg_meta(mcg_libc)
    val other = target_named(if host_target().name == "x86_64-linux" then "aarch64-macos"
        else "x86_64-linux").unwrap()

    use_allocator(mcg_rtos)

    val got = syslib_read("lib.syslib", libc, other)

    use_allocator(mcg_libc)

    got match
        Ok(_) -> assert(false, "an artifact for another target was accepted")
        Err(why) -> assert(mcg_has(why, "was built for"), why)
end mcg_an_artifact_wrong_twice_reports_the_target

// -- the standard module's cache path -------------------------------------------------------------

// Without this the refusal above is a loop rather than a diagnostic: each build refuses the other's
// entry and rebuilds over it.
@test("the standard module's cache path separates two allocators, so both stay warm")
mcg_the_std_path_separates_two_heaps()
    val libc = std_artifact_path(host_target(), "0123456789abcdef")

    use_allocator(mcg_rtos)

    val rtos = std_artifact_path(host_target(), "0123456789abcdef")
    val again = std_artifact_path(host_target(), "0123456789abcdef")

    use_allocator(mcg_libc)
    assert(libc != rtos, s"'$libc' against '$rtos'")
    assert_eq(rtos, again)
end mcg_the_std_path_separates_two_heaps

// -- what an argument list says -------------------------------------------------------------------

@test("a level is read joined, apart, or long, whichever of clang's spellings it is")
mcg_a_level_in_every_spelling()
    val levels = ["0", "2", "3", "s", "z", "fast"]

    for i in 0..<levels.len
        val joined = took_level(["sysl", "build", "prog.sysl", s"-O${levels[i]}"], 3)
        val apart = took_level(["sysl", "build", "prog.sysl", "-O", levels[i]], 3)
        val long = took_level(["sysl", "build", "prog.sysl", "--optimize", levels[i]], 3)

        assert_eq(joined.0, 1)
        assert_eq(joined.1, levels[i])
        assert_eq(apart.0, 2)
        assert_eq(apart.1, levels[i])
        assert_eq(long.0, 2)
        assert_eq(long.1, levels[i])
end mcg_a_level_in_every_spelling

// Case is the whole difference between this and the output path: `-o` names a file and `-O` a level,
// and nothing else starting with a dash is taken.
@test("lower-case '-o' and every other argument are left alone")
mcg_other_arguments_are_left_alone()
    var args = ["sysl", "build", "prog.sysl", "-o", "prog", "-O2", "--target", "aarch64-linux", "-O"]

    for i in 2..<args.len
        val took = took_level(args, i)

        if i == 5 then assert_eq(took.1, "2")
        else if i == 8 then assert_eq(took.0, -1)
        else assert_eq(took.0, 0, args[i])
end mcg_other_arguments_are_left_alone

// The flag belongs to every command that produces code: a parse that refused it would answer with
// the usage line before anything was looked for.
@test("every command that emits code accepts it")
mcg_every_command_accepts_a_level()
    val commands = ["run", "build", "build-lib", "build-c", "test"]

    for i in 0..<commands.len
        val got = mcg_run(["sysl", commands[i], "--optimize", "2", "/nonexistent/mcg-prog.sysl"])

        assert(got.0 != Misused, s"${commands[i]}: ${got.1}")
end mcg_every_command_accepts_a_level

// What is after `--` is the program's, so a program with an option of the same name still gets its
// own.
@test("the program's arguments after '--' are not the build's level")
mcg_forwarded_arguments_are_the_programs()
    if !mcg_library_here() then return

    val root = mcg_project(mcg_program, "")
    val line = mcg_linked(["sysl", "run", root, "-O2", "--", "-O9", "--optimize", "9"])

    assert(mcg_has(line, " -O2 "), line)
    assert(!mcg_has(line, "-O9"), line)
    remove_dir_all(root).unwrap_or(())
end mcg_forwarded_arguments_are_the_programs

// -- what a level does to a program ---------------------------------------------------------------

// The answer is the program's and not the optimizer's, so every level has to agree on it.
@test("every level it can be built at answers the same thing")
mcg_every_level_answers_the_same()
    if !mcg_library_here() then return

    val root = mcg_project("import sysl.math.Bits\n\nspin[T: Bits](x: T, n: u32) -> T = x.rotate_left(n)\n\n" +
        "main()\n    var a: u8 = 0b10110000\n" +
        "    print(spin(a, 1), a.count_ones(), (0x0123456789abcdefu64).rotate_right(8))\n", "")
    val levels = ["0", "1", "2", "s"]

    for i in 0..<levels.len
        val exe = s"$root/out-${levels[i]}"
        val got = mcg_run(["sysl", "build", root, s"-O${levels[i]}", "-o", exe])

        assert_eq(got.0, 0, got.1)

        capture(exe, [], "", [], true) match
            Err(_) -> assert(false, s"-O${levels[i]} did not run")
            Ok(answer) -> assert_eq(answer.text, "97 3 17222085231038278605\n", s"-O${levels[i]}")

    remove_dir_all(root).unwrap_or(())
end mcg_every_level_answers_the_same

// A level clang has no answer for stops the build rather than being quietly dropped -- refused by the
// driver in clang's terms before clang is reached (`tests_level_refusal.sysl` has the exact words).
@test("a level clang does not have stops the build")
mcg_a_level_clang_lacks_stops_the_build()
    if !mcg_library_here() then return

    val root = mcg_project(mcg_program, "")
    val got = mcg_run(["sysl", "build", root, "-Ononsense", "-o", s"$root/out"])

    assert(got.0 != 0, got.1)
    assert(mcg_has(got.1, "clang"), got.1)
    remove_dir_all(root).unwrap_or(())
end mcg_a_level_clang_lacks_stops_the_build

// -- what a project's manifest says ---------------------------------------------------------------

@test("the level a manifest names is what the build hands clang")
mcg_the_key_is_what_clang_is_handed()
    if !mcg_library_here() then return

    val root = mcg_project(mcg_program, mcg_key("2"))
    val line = mcg_building(root)

    assert(mcg_has(line, " -O2 "), line)
    remove_dir_all(root).unwrap_or(())
end mcg_the_key_is_what_clang_is_handed

@test("a project that names none is built at the default")
mcg_no_key_is_the_default()
    if !mcg_library_here() then return

    val root = mcg_project(mcg_program, "")
    val line = mcg_building(root)

    assert(mcg_has(line, s" -O$DefaultOptimization "), line)
    assert(DefaultOptimization != "0", "the default is not the unoptimized mode")
    remove_dir_all(root).unwrap_or(())
end mcg_no_key_is_the_default

// A project built at `2` is still profiled at `0` by typing it, and typing the default is typing
// something.
@test("and a level on the command line beats the manifest's")
mcg_the_flag_beats_the_key()
    if !mcg_library_here() then return

    val root = mcg_project(mcg_program, mcg_key("2"))
    val line = mcg_linked(["sysl", "build", root, "-O0", "-o", s"$root/out"])

    assert(mcg_has(line, " -O0 "), line)
    assert(!mcg_has(line, " -O2 "), line)
    remove_dir_all(root).unwrap_or(())
end mcg_the_flag_beats_the_key

// A package that could set the level would be deciding how its consumer's whole program is compiled.
// It is the root's key or nobody's, and a package stating one has said nothing wrong.
@test("a dependency's optimization key is not applied, and is not an error either")
mcg_a_dependencys_key_is_ignored()
    if !mcg_library_here() then return

    val geom = mcg_dependency(mcg_key("3"))
    val root = mcg_app(geom, "main()\n    print(geom.double(21))\n")
    val line = mcg_building(root)

    assert(mcg_has(line, s" -O$DefaultOptimization "), line)
    assert(!mcg_has(line, " -O3 "), line)
    remove_dir_all(root).unwrap_or(())
    remove_dir_all(geom).unwrap_or(())
end mcg_a_dependencys_key_is_ignored

// A level that applied to `build` and not to `test` would be a project measured at one level and
// shipped at another.
@test("every command that builds the project honours the key")
mcg_every_command_honours_the_key()
    if !mcg_library_here() then return

    val commands = ["build", "run", "test"]

    for i in 0..<commands.len
        val root = mcg_project(mcg_program, mcg_key("2"))
        val line = if commands[i] == "build" then mcg_building(root)
        else mcg_linked(["sysl", commands[i], root])

        assert(mcg_has(line, " -O2 "), s"${commands[i]}: $line")
        remove_dir_all(root).unwrap_or(())
end mcg_every_command_honours_the_key

// `sysl run` keeps what it built, keyed on the level the build resolved -- so raising the key has to
// rebuild rather than replay a binary compiled at the old level from a tree that did not move.
@test("and raising it is a different program to the run cache")
mcg_raising_the_key_rebuilds()
    if !mcg_library_here() then return

    val root = mcg_project(mcg_program, mcg_key("1"))
    val before = run_cache_key_for("run", root, None, build_level(root, None).unwrap(), None)

    mcg_linked(["sysl", "run", root])
    write_text(s"$root/package.hocon", mcg_key("2")).unwrap()

    val after = run_cache_key_for("run", root, None, build_level(root, None).unwrap(), None)
    val line = mcg_linked(["sysl", "run", root])

    assert(before.is_some() && after.is_some() && before.unwrap() != after.unwrap(), "the keys differ")
    assert(mcg_has(line, " -O2 "), s"a rebuild at the new level: '$line'")
    remove_dir_all(root).unwrap_or(())
end mcg_raising_the_key_rebuilds

// The same for the heap: a tree whose manifest starts naming an allocator is a different binary.
@test("naming an allocator is a different program to the run cache")
mcg_naming_a_heap_changes_the_key()
    if !mcg_library_here() then return

    val root = mcg_project(mcg_program, "")
    val before = run_cache_key_for("run", root, None, DefaultOptimization, None)

    write_text(s"$root/package.hocon", mcg_rtos_block).unwrap()

    val after = run_cache_key_for("run", root, None, DefaultOptimization, None)

    use_allocator(mcg_libc)
    assert(before.is_some() && after.is_some() && before.unwrap() != after.unwrap(), "the keys differ")
    remove_dir_all(root).unwrap_or(())
end mcg_naming_a_heap_changes_the_key

// Refused where the key is, naming the file, the key, what was written and what may be -- rather than
// by clang, which would answer for a manifest it cannot name. Nothing was compiled, so nothing was
// written either.
@test("a level clang does not have stops the build before clang is reached")
mcg_an_unknown_key_stops_before_clang()
    val root = mcg_project(mcg_program, mcg_key("9"))
    val got = mcg_run(["sysl", "build", root, "-o", s"$root/out"])

    assert(got.0 != 0, got.1)
    assert(mcg_has(got.1, "package.hocon: 'optimization = \"9\"' names no level clang has — it is one of " +
        "0, 1, 2, 3, s, z"), got.1)
    assert(!is_file(s"$root/out"), "no executable was written")
    remove_dir_all(root).unwrap_or(())
end mcg_an_unknown_key_stops_before_clang
