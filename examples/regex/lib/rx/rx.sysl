module rx

import sysl.text.{cstring, from_cstring}

// POSIX regular expressions, bound through the C sitting beside this file.
//
// A library may carry `.c` files (`15 §7`): they are compiled for the same target and archived into
// the same `.syslib`, and the sysl side reaches them with the `extern` that was already the way to
// name a symbol the linker has. Nothing declares them -- `regex.c` is here, so it is built.
//
// What crosses the boundary is a pointer and four integers. Every number the header owns -- the size
// of a `regex_t`, the value of `REG_EXTENDED`, the layout of a `regmatch_t` -- stays in `regex.c`,
// where the C compiler reads it from the platform being built for. That is the point of the shim:
// the alternative is transcribing those numbers here, which compiles everywhere and is correct on
// whichever machine the author happened to use.

extern "sysl_rx_new" c_new() -> *u8
extern "sysl_rx_free" c_free(re: *u8)
extern "sysl_rx_compile" c_compile(re: *u8, pattern: *u8) -> int
extern "sysl_rx_exec" c_exec(re: *u8, s: *u8, so: *i64, eo: *i64) -> int
extern "sysl_rx_error" c_error(re: *u8, code: int, buf: *u8, n: u64)

// Where a match landed, as byte offsets into the subject.
struct Match
    start: usize
    end: usize

// A compiled pattern. The handle is storage `regex.c` allocated, so `free` is not optional -- this
// is a C resource, and a binding to a library that allocates has to say who releases it.
struct Regex
    handle: *u8

    // Whether the subject matches anywhere, which is the common question.
    matches(self, s: string) -> bool = self.find(s).is_some()

    // Where the whole match landed, or nothing.
    find(self, s: string) -> Option[Match]
        val subject = cstring(s)

        var so: i64 = 0i64
        var eo: i64 = 0i64

        if c_exec(self.handle, subject.ptr, &so, &eo) == 1 then
            Some(Match(usize(so), usize(eo)))
        else
            None
    end find

    free(self) = c_free(self.handle)
end Regex

// A compiled pattern, or the message the C library gave for why it is not one.
//
// The message shows both directions of the string boundary in one place: `cstring` copies the
// pattern into the NUL-terminated bytes `regcomp` reads, and `from_cstring` copies `regerror`'s
// answer back out. Neither side ever holds a pointer into the other's storage.
compile(pattern: string) -> Result[Regex, string]
    val re   = c_new()
    val p    = cstring(pattern)
    val code = c_compile(re, p.ptr)

    if code == 0 then
        Ok(Regex(re))
    else
        var buf: [256]u8

        c_error(re, code, &buf[0], 256u64)
        c_free(re)
        Err(from_cstring(&buf[0]).unwrap_or("the pattern did not compile"))
end compile
