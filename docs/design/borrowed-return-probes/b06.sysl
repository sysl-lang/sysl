// What a program writes today to name the children without copying them: a `ref` local to the
// field, in the caller. It works only where the caller can name the field — the method that
// would hide the `Option` and the `unwrap` cannot hand the place back.
struct Node
    level: int
    kids: Option[Kids]

struct Kids
    nw: &Node
    ne: &Node
    sw: &Node
    se: &Node

leaf() -> &Node = Node(0, None)

walk(n: &Node) -> int
    if n.level == 0 then return 1

    ref k = n.kids

    k match
        Some(q) -> walk(q.nw) + walk(q.ne) + walk(q.sw) + walk(q.se)
        None -> 1

val l = leaf()
val top: &Node = Node(1, Some(Kids(l, l, l, l)))

print(walk(top))
