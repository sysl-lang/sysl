// P11: one node type for both counts. rpds writes `Vector<T, P: SharedPointerKind>` so that one
// body serves `Rc` and `Arc`. The nearest sysl spelling: the child's reference type as a parameter,
// tied off by an alias that names itself.

struct Node[T, P]
    item: T
    kids: [2]Option[P]

type Plain = Node[int, &Plain]
type Shared = Node[int, &sync Shared]

main()
    val leaf: &Plain = Node(1, [None, None])
    val root: &Plain = Node(2, [Some(leaf), None])

    print(root.item + leaf.item)
