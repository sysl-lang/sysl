module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.fs.{exists, make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.start
import sysl.signal.send
import sysl.testing.compiler
import sysl.time.{sleep, millis}

// What `sysl test` writes while it runs and says when it is stopped: the buffer that holds a report
// back to two writes a second, the account of what was in flight, and a real run killed with TERM
// and with INT while its second test hangs.

// -- the buffer -------------------------------------------------------------------------------------

@test("the first piece is written at once")
tpg_first_piece_is_written_at_once()
    var b = ReportBuffer("", -1, 0)

    assert_eq(b.offer("header\n", 10), "header\n")
    assert_eq(b.writes, 1)

@test("pieces inside half a second of the last write are held, and come out together")
tpg_pieces_are_held_then_written_together()
    var b = ReportBuffer("", -1, 0)

    b.offer("a\n", 0)
    assert_eq(b.offer("b\n", 100), "")
    assert_eq(b.offer("c\n", 499), "")
    assert_eq(b.offer("d\n", 500), "b\nc\nd\n")
    assert_eq(b.writes, 2)

@test("many fast tests make few writes: at most one per half second")
tpg_many_rows_few_writes()
    var b = ReportBuffer("", -1, 0)
    var written = ""

    // 3000 rows over 2.999 s of the run's clock: one row per millisecond.
    for ms in 0..<3000
        written += b.offer(s"row $ms\n", long(ms))

    written += b.drain(3000)

    assert(b.writes <= 7, s"${b.writes} writes")
    assert(b.writes >= 6, s"${b.writes} writes")
    assert(written.contains("row 0\n"))
    assert(written.contains("row 2999\n"))

@test("a held piece is written by the next due check, and nothing is written twice")
tpg_due_writes_what_is_held()
    var b = ReportBuffer("", -1, 0)

    b.offer("a\n", 0)
    b.offer("b\n", 10)
    assert_eq(b.due(499), "")
    assert_eq(b.due(500), "b\n")
    assert_eq(b.due(1500), "")
    assert_eq(b.drain(1600), "")
    assert_eq(b.writes, 2)

@test("draining writes at once, whatever the time, and an empty drain is not a write")
tpg_drain_ignores_the_clock()
    var b = ReportBuffer("", -1, 0)

    b.offer("a\n", 0)
    b.offer("b\n", 1)
    assert_eq(b.drain(2), "b\n")
    assert_eq(b.drain(3), "")
    assert_eq(b.writes, 2)

// -- the account ------------------------------------------------------------------------------------

@test("a stop in the compile names the project and the phase")
tpg_stop_while_compiling()
    val text = interruption_report("SIGTERM", 12345, "/p/proj", 12100, buf(), 20000)

    assert_eq(text, "\ninterrupted by SIGTERM after 12.3s\nin flight:\n  /p/proj  compiling  12.1s\n")

@test("a stop among running tests names each one with its file and elapsed time")
tpg_stop_while_running()
    var live: Buf[InFlight] = buf()

    live.push(InFlight(3, "tests_a.sysl", "first one", 1000, 77))
    live.push(InFlight(4, "tests_b.sysl", "second", 3500, 78))

    val text = interruption_report("SIGINT", 5000, "", 0, live, 6000)

    assert_eq(text, "\ninterrupted by SIGINT after 5.0s\nin flight:\n" +
        "  tests_a.sysl  first one  running  5.0s\n  tests_b.sysl  second  running  2.5s\n")

@test("a stop with nothing in flight says so")
tpg_stop_with_nothing_out()
    assert_eq(interruption_report("SIGTERM", 99, "", 0, buf(), 99),
        "\ninterrupted by SIGTERM after 0.0s\nnothing was in flight\n")

// -- a real run, stopped ----------------------------------------------------------------------------

private tpg_program(marker: string) -> string
    val root = absolute_path(make_temp_dir("sysl-tpg-test").unwrap())

    make_dir_all(root).unwrap()
    write_text(s"$root/prog.sysl",
        "import sysl.fs.write_text\nimport sysl.time.{sleep, millis}\n\n" +
        "@test\na_first()\n    assert(true, \"up\")\n\n" +
        "@test\nb_hangs()\n    write_text(\"" + marker + "\", \"x\").unwrap()\n\n    loop\n        sleep(millis(10))\n").unwrap()
    s"$root/prog.sysl"
end tpg_program

// Starts a run whose second test hangs, waits until it is hanging, stops it with `sig`, and answers
// the exit was-ok flag and what it wrote.
private tpg_stopped_with(sig: int) -> (bool, string)
    val root = absolute_path(make_temp_dir("sysl-tpg-marker").unwrap())
    val marker = s"$root/hanging"
    val file = tpg_program(marker)
    val runner = start(compiler(), ["test", file, "--timeout", "0", "--jobs", "1"], stderr = true).unwrap()
    var waited = 0

    while !exists(marker) && waited < 1800
        sleep(millis(100))
        waited += 1

    assert(exists(marker), "the hanging test never started")
    send(i64(runner.pid()), sig).unwrap()

    val out = runner.wait().unwrap()

    _ = remove_dir_all(root)
    (out.status.ok(), out.text)
end tpg_stopped_with

@test("a run killed with TERM while a test hangs shows the first result and names the hung test")
tpg_term_names_the_hung_test()
    if !clx_ready() then return

    val (ok, text) = tpg_stopped_with(15)

    assert(!ok, text)
    assert(text.contains("ok    a_first"), text)
    assert(text.contains("interrupted by SIGTERM"), text)
    assert(text.contains("in flight:"), text)
    assert(text.contains("prog.sysl  b_hangs  running"), text)
    assert(!text.contains("a_first  running"), text)
    assert(!text.contains("passed,"), text)

@test("a run interrupted with INT says the same, under its own name")
tpg_int_names_the_hung_test()
    if !clx_ready() then return

    val (ok, text) = tpg_stopped_with(2)

    assert(!ok, text)
    assert(text.contains("ok    a_first"), text)
    assert(text.contains("interrupted by SIGINT"), text)
    assert(text.contains("prog.sysl  b_hangs  running"), text)

@test("a run that finishes keeps its summary unchanged and mentions no interruption")
tpg_finished_run_has_its_summary()
    if !clx_ready() then return

    val root = absolute_path(make_temp_dir("sysl-tpg-fine").unwrap())

    write_text(s"$root/prog.sysl", "@test\nt() =\n    assert(true, \"up\")\n").unwrap()

    val out = start(compiler(), ["test", s"$root/prog.sysl"], stderr = true).unwrap().wait().unwrap()

    _ = remove_dir_all(root)
    assert(out.status.ok(), out.text)
    assert(out.text.contains("1 passed, 0 failed"), out.text)
    assert(!out.text.contains("interrupted"), out.text)
