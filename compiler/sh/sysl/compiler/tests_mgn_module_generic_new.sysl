module sh.sysl.compiler
@tests

import sysl.text.Search
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture

// **A dotted path is one name to the type grammar** (`reference/modules.md`), so a generic type's
// associated function reached through its module -- `m.Q.new()`, `lib.m.Q.new()`, through an aliased
// import -- infers the type's arguments from what receives the result exactly as `Q.new()` does after
// `import lib.m.Q`. The same holds for a generic enum's variant and member (`m.Opt.Yes(3)`). What is
// still refused names what is wrong: the module stays a module, and the undefined name is the one
// written after it.

private mgn_ready() -> bool
    if std_root().is_err()
        print("skipped: the standard module's source is not on this machine")
        return false

    if !clang_available()
        print("skipped: there is no clang on this machine")
        return false

    true
end mgn_ready

private mgn_tree(main: string) -> string
    val root = make_temp_dir("sysl-mgn").unwrap()
    val files = [("lib/m/m.sysl", mgn_lib()), ("lib/deep/inner/inner.sysl", mgn_deep()),
                 ("main.sysl", main)]

    for i in 0..<files.len
        val at = s"$root/${files[i].0}"

        make_dir_all(parent_of(at).unwrap()).unwrap()
        write_text(at, files[i].1).unwrap()

    root
end mgn_tree

// What a program of several files prints, or why it was not built.
private mgn_ran(main: string) -> string
    val root = mgn_tree(main)
    val exe = s"$root/built"

    build_native_program(root, None, None, DefaultOptimization, Some(exe)) match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return failure_text(why)
        Ok(_) -> ()

    val said = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    said match
        Err(_) -> "the program that was built could not be run"
        Ok(out) -> out.text
end mgn_ran

// Everything the analysis refuses, as its report.
private mgn_err(main: string) -> string
    val root = mgn_tree(main)

    val out = emit_llvm_text(root, None) match
        Err(why) -> why.message
        Ok(made) -> if made.report.is_empty() then "" else analysis_report(made.report)

    remove_dir_all(root).unwrap_or(())
    out
end mgn_err

private mgn_lib() -> string = raw"""
    module lib.m

    struct Q[T, const N: usize]
        slots: [N]T

    impl[T, const N: usize] Q[T, N]
        const new() -> Q[T, N]
            var s: [N]T
            Q(s)

        make() -> Q[T, N]
            var s: [N]T
            Q(s)

    struct Box[T]
        has: Option[T]

    impl[T] Box[T]
        empty() -> Box[T] = Box(None)

    struct Ring[const N: usize]
        bytes: [N]u8

    impl[const N: usize] Ring[N]
        new() -> Ring[N]
            var b: [N]u8
            Ring(b)

    enum Opt[T]
        Yes(v: T)
        No

    impl[T] Opt[T]
        none() -> Opt[T] = No
    """

private mgn_deep() -> string = raw"""
    module lib.deep.inner

    struct Q[T, const N: usize]
        slots: [N]T

    impl[T, const N: usize] Q[T, N]
        new() -> Q[T, N]
            var s: [N]T
            Q(s)
    """

@test("m.Q.new() infers its arguments at a module var and val, as Q.new() does")
mgn_at_module_level()
    if !mgn_ready() then return

    assert_eq(mgn_ran(raw"""
        import lib.m

        private var b: m.Q[u32, 2] = m.Q.new()
        val c: m.Q[u8, 5] = m.Q.make()

        main()
            print(b.slots.len, c.slots.len)
        """), "2 5\n")

@test("and in a body, as an argument and as a returned value")
mgn_in_every_position()
    if !mgn_ready() then return

    assert_eq(mgn_ran(raw"""
        import lib.m

        take(q: m.Q[i64, 3]) -> usize = q.slots.len

        made() -> m.Q[u16, 4] = m.Q.new()

        main()
            val local: m.Q[u32, 6] = m.Q.make()
            print(local.slots.len, take(m.Q.new()), take(m.Q.make()), made().slots.len)
        """), "6 3 3 4\n")

@test("a type with only type parameters, and one with only const parameters")
mgn_one_kind_of_parameter()
    if !mgn_ready() then return

    assert_eq(mgn_ran(raw"""
        import lib.m

        main()
            val bx: m.Box[string] = m.Box.empty()
            val r: m.Ring[7] = m.Ring.new()
            print(bx.has.is_none(), r.bytes.len)
        """), "true 7\n")

@test("a nested module path and an aliased import reach it alike")
mgn_nested_and_aliased()
    if !mgn_ready() then return

    assert_eq(mgn_ran(raw"""
        import lib.m as k

        main()
            val d: lib.deep.inner.Q[u8, 8] = lib.deep.inner.Q.new()
            val e: k.Q[u8, 9] = k.Q.new()
            val f: lib.m.Q[u8, 1] = lib.m.Q.make()
            print(d.slots.len, e.slots.len, f.slots.len)
        """), "8 9 1\n")

@test("a generic enum's member and variant are reached through the module too")
mgn_generic_enum()
    if !mgn_ready() then return

    assert_eq(mgn_ran(raw"""
        import lib.m

        held(x: m.Opt[int]) -> int = x match
            Yes(v) -> v
            No -> 0

        main()
            val o: m.Opt[int] = m.Opt.none()
            val y: m.Opt[int] = m.Opt.Yes(3)
            print(held(o), held(y))
        """), "0 3\n")

@test("a truly undefined module is still the undefined name")
mgn_undefined_module()
    if !mgn_ready() then return

    val said = mgn_err(raw"""
        import lib.m

        main()
            val a: m.Q[u32, 2] = zz.Q.new()
            print(a.slots.len)
        """)

    assert(said.contains("undefined name 'zz'"), said)

@test("a type the module does not declare is named, not the module")
mgn_undefined_type_in_module()
    if !mgn_ready() then return

    val said = mgn_err(raw"""
        import lib.m

        main()
            val a: m.Q[u32, 2] = m.Nope.new()
            val b: m.Q[u32, 2] = lib.m.Gone.new()
            print(m.zzz, a.slots.len, b.slots.len)
        """)

    assert(said.contains("undefined name 'lib.m.Nope'"), said)
    assert(said.contains("undefined name 'lib.m.Gone'"), said)
    assert(said.contains("undefined name 'lib.m.zzz'"), said)
    assert(!said.contains("undefined name 'm'"), said)
    assert(!said.contains("undefined name 'lib'"), said)

@test("an undefined member of the generic type or enum names that member")
mgn_undefined_member()
    if !mgn_ready() then return

    val said = mgn_err(raw"""
        import lib.m

        main()
            val b: m.Q[u32, 2] = m.Q.nope()
            val e: m.Opt[int] = m.Opt.gone()
            print(b.slots.len)
        """)

    assert(said.contains("type 'lib.m.Q' has no associated function 'nope'"), said)
    assert(said.contains("enum 'lib.m.Opt' has no variant or associated function 'gone'"), said)
    assert(!said.contains("undefined name"), said)

@test("arguments nothing settles are named as that, not as the module")
mgn_uninferable()
    if !mgn_ready() then return

    val said = mgn_err(raw"""
        import lib.m

        main()
            val c = m.Q.new()
            print(c.slots.len)
        """)

    assert(said.contains("cannot infer the type argument 'T' of 'lib.m.Q.new' here — annotate the expected type"),
           said)
    assert(!said.contains("undefined name"), said)
