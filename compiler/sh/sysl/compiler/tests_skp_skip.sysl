module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.fs.remove_dir_all
import sysl.text.Search

// `skip(why)` — a test that finds at run time it cannot run here, and says so, rather than printing a
// note and returning into an `ok` that tested nothing. The protocol is `test_runner.sysl`'s
// `skip_mark`: the byte, the reason up to the end of its line, then a clean exit. The function itself
// is the library's (`library/sysl/check.sysl`).

// -- the pieces -------------------------------------------------------------------------------------

private skp_test(display: string, line: int) -> TTest =
    TTest(module_qualify("m", display), display, false, None, "m.sysl", line, no_hooks(), None)

@test("the reason is what follows the mark, up to the end of its line")
skp_the_reason_follows_the_mark()
    assert_eq(skip_reason("noise\n\u{3}there is no why3 here\nafter\n").unwrap(), "there is no why3 here")
    assert_eq(skip_reason("\u{3}last").unwrap(), "last")
    assert_eq(skip_reason("\u{3}").unwrap(), "")
    assert(skip_reason("an ordinary run\n").is_none(), "no mark, no skip")

@test("the mark is taken out of what a reader is shown")
skp_the_mark_is_unmarked()
    assert_eq(unmarked_output("before\n\u{3}why\n"), "before\nwhy\n")

@test("a skipped row says 'skip' and names its reason in place of a time")
skp_a_skipped_row_names_its_reason()
    assert_eq(test_row(Outcome(skp_test("waits", 11), None, "", 4, Some("no why3")), 8),
              "  skip  waits     skipped: no why3\n")

@test("a skip is counted with the ignored tests, not the passed ones")
skp_the_summary_counts_a_skip_as_ignored()
    var ran: Buf[Outcome] = buf()

    ran.push(Outcome(skp_test("a", 1), None, "", 1, None))
    ran.push(Outcome(skp_test("b", 2), None, "", 2, Some("no why3")))
    ran.push(Outcome(TTest(module_qualify("m", "c"), "c", false, None, "m.sysl", 3, no_hooks(),
                           Some("not yet")), None, "", 0, None))

    val text = tests_rendered(ran, 3, 0)

    assert(text.contains("  skip  b  skipped: no why3\n"), text)
    assert(text.contains("  skip  c  ignored: not yet\n"), text)
    assert(text.contains("\n1 passed, 0 failed, 2 ignored — 3ms\n"), text)

// A skip whose teardown then failed is that failure: the row is the failure's, and it is counted once.
@test("a skip that something after it failed is reported as the failure")
skp_a_failure_after_a_skip_is_the_failure()
    var ran: Buf[Outcome] = buf()

    ran.push(Outcome(skp_test("b", 2), Some("the teardown did not return"), "", 2, Some("no why3")))

    val text = tests_rendered(ran, 1, 0)

    assert(text.contains("  FAIL  b  2ms\n        the teardown did not return\n"), text)
    assert(text.contains("\n0 passed, 1 failed — 2ms\n"), text)

// -- a tree built and run ---------------------------------------------------------------------------

// A one-file tree holding `text`, built as a test binary and run; the report it streamed and the
// outcomes, or nothing where the library or a toolchain is not here. The fixtures call the library's
// own `skip`.
private skp_run(text: string) -> Option[(string, Buf[Outcome])]
    if std_root().is_err() || !clang_available() then return None

    val root = runner_project("main.sysl", text)
    val file = s"$root/main.sysl"

    val build = test_build_of(file, None) match
        Err(refusal) ->
            remove_dir_all(root).unwrap_or(())
            assert(false, refusal.message)
            return None
        Ok(made) -> made

    if !build.emitted.report.is_empty()
        remove_dir_all(root).unwrap_or(())
        assert(false, analysis_report(build.emitted.report))
        return None
    end if

    val exe = build_test_binary(file, build, None, DefaultOptimization) match
        Err(refusal) ->
            remove_dir_all(root).unwrap_or(())
            assert(false, refusal.message)
            return None
        Ok(built) -> built

    var said: Buf[string] = buf()
    val sink = &said
    val outcomes = run_selected(exe, build.tests, TestOptions(None, false), 0, piece -> sink.push(piece))

    discard_test_binary(exe)
    remove_dir_all(root).unwrap_or(())

    var streamed = ""

    for i in 0..<said.len()
        streamed = streamed + said.at(i)

    Some((streamed, outcomes))
end skp_run

@test("a test that calls skip is reported as 'skip', with its reason")
skp_a_skip_is_reported_with_its_reason()
    val (text, ran) = skp_run("@test\nneeds_why3() =\n    skip(\"there is no why3 here\")\n") match
        None -> return
        Some(r) -> r

    assert_eq(ran.len(), 1)
    assert_eq(ran.at(0).skipped.unwrap(), "there is no why3 here")
    assert(ran.at(0).detail.is_none(), "a skip is not a failure")
    assert(runner_timeless(text).ends_with("\n  skip  needs_why3  skipped: there is no why3 here\n" +
                                           "\n0 passed, 0 failed, 1 ignored — Nms\n"), text)

@test("a skip is counted as skipped, not passed, beside a test that passed")
skp_a_skip_is_not_a_pass()
    val (text, ran) = skp_run("@test\nholds() =\n    assert(1 + 1 == 2, \"two\")\n\n" +
                              "@test\nneeds_why3() =\n    skip(\"no why3\")\n") match
        None -> return
        Some(r) -> r

    assert_eq(ran.len(), 2)
    assert(ran.at(0).skipped.is_none(), "the first ran to a verdict")
    assert(!ran.at(0).not_run(), "and is a pass")
    assert(ran.at(1).not_run(), "the second is not")
    assert(runner_timeless(text).ends_with("\n1 passed, 0 failed, 1 ignored — Nms\n"), text)

// The line after the call would fail the test if it ran, and print where a failure would show it.
@test("nothing after skip runs")
skp_nothing_after_skip_runs()
    val (_, ran) = skp_run("@test\nstops() =\n    skip(\"stopped here\")\n    print(\"after the skip\")\n" +
                           "    assert(false, \"after the skip\")\n") match
        None -> return
        Some(r) -> r

    assert_eq(ran.at(0).skipped.unwrap(), "stopped here")
    assert(ran.at(0).detail.is_none(), "the assertion after it never ran")
    assert(!ran.at(0).output.contains("after the skip"), ran.at(0).output)

@test("a helper the test calls may skip on its behalf")
skp_a_helper_may_skip()
    val (_, ran) = skp_run("needs(tool: string)\n    if tool == \"why3\" then skip(s\"there is no $tool here\")\n\n" +
                           "@test\nproves() =\n    needs(\"why3\")\n    assert(false, \"never\")\n") match
        None -> return
        Some(r) -> r

    assert_eq(ran.at(0).skipped.unwrap(), "there is no why3 here")
    assert(ran.at(0).detail.is_none(), "the helper ended the test")

@test("an assertion that failed before skip is still the failure")
skp_a_failure_before_skip_still_fails()
    val (text, ran) = skp_run("@test\nbroken() =\n    assert(false, \"first\")\n    skip(\"unreached\")\n") match
        None -> return
        Some(r) -> r

    assert(ran.at(0).skipped.is_none(), "the skip was never reached")
    assert_eq(ran.at(0).detail.unwrap(), "did not return — exit status 1")
    assert(runner_timeless(text).ends_with("\n0 passed, 1 failed — Nms\n"), text)

// The mark alone is not a skip: a run that wrote it and then died did not end where `skip` ends.
@test("a run that wrote the mark and then failed is a failure, not a skip")
skp_a_mark_then_a_failure_fails()
    val (_, ran) = skp_run("@test\nhalf() =\n    prints(\"\\u{3}looked like a skip\\n\")\n" +
                           "    assert(false, \"then failed\")\n") match
        None -> return
        Some(r) -> r

    assert(ran.at(0).skipped.is_none(), "not a skip")
    assert(ran.at(0).detail.is_some(), "a failure")

// A trap test that skipped never reached its subject, so it is not the "returned" failure either.
@test("a 'should_trap' test that skips is reported as skipped")
skp_a_trap_test_may_skip()
    val (_, ran) = skp_run("@test(should_trap: \"past the end\")\ntraps() =\n    skip(\"no device\")\n") match
        None -> return
        Some(r) -> r

    assert_eq(ran.at(0).skipped.unwrap(), "no device")
    assert(ran.at(0).detail.is_none(), "not 'returned, and was expected to trap'")

// The skip ended the process before the dispatcher reached the in-process teardown, so the runner runs
// it in one of its own, as after a trap — a failing one is reported against the test.
@test("a skipped test's teardown still runs")
skp_the_teardown_still_runs()
    val (_, ran) = skp_run("@teardown\ndown() =\n    assert(false, \"teardown ran\")\n\n" +
                           "@test\nt() =\n    skip(\"no why3\")\n") match
        None -> return
        Some(r) -> r

    assert(ran.at(0).detail.unwrap().contains("'@teardown'"), ran.at(0).detail.unwrap())
    assert(ran.at(0).output.contains("teardown ran"), ran.at(0).output)
    assert(!ran.at(0).not_run(), "the failure is the row")

@test("a '@setup' that skips skips the test it brackets")
skp_a_setup_may_skip()
    val (_, ran) = skp_run("@setup\nup() =\n    skip(\"no why3\")\n\n" +
                           "@test\nt() =\n    assert(false, \"never\")\n") match
        None -> return
        Some(r) -> r

    assert_eq(ran.at(0).skipped.unwrap(), "no why3")
    assert(ran.at(0).detail.is_none(), "neither the setup nor the test failed")

// End to end through the command: a skip fails nothing, so the exit status is clean. The report itself
// is streamed to standard output rather than through `say`, so its text is asserted by the in-process
// runs above.
@test("'sysl test' over a skipped test exits clean")
skp_the_command_exits_clean()
    if std_root().is_err() || !clang_available() then return

    val root = runner_project("main.sysl", "@test\nholds() =\n    assert(true, \"yes\")\n\n" +
                                           "@test\nneeds_why3() =\n    skip(\"no why3\")\n")
    var lines: Buf[string] = buf()
    val sink = &lines
    val code = run_cli(["sysl", "test", s"$root/main.sysl"], (line) -> sink.push(line))

    remove_dir_all(root).unwrap_or(())
    assert_eq(code, 0)
