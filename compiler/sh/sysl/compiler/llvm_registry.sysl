module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.text.Search

// **Every name in LLVM's namespace this compiler writes down is declared here, and nowhere else.**
//
// An intrinsic or a reserved global is a name a back end that is not LLVM has to supply something
// for, so the question a port asks first is "which of them are there?" -- and a name written as a
// literal inside an emitter is one only a search would find. Here each entry is a base name; the
// emitters complete a base with its operand types (`at`), and `llvm_accounts` says whether a name a
// module reaches is one of these.
//
// A family the language decides the members of -- the overflow checks, the bit operations, the
// reductions -- is reached through a function that refuses a member the family does not have, so a
// misspelt operation is an error where it was asked for rather than a call to a function LLVM has
// never heard of.

// The namespace LLVM reserves, which is the whole of how an intrinsic is told from a linked symbol.
const LlvmPrefix: string = "llvm."

// One intrinsic, by its base name.
struct LlvmIntrinsic
    base: string

    // The name with each overloaded operand's suffix after it, in LLVM's order --
    // `llvm.fptosi.sat.i32.f64`. A suffix is LLVM's spelling of a type (`f32`, `v4f32`, `p0`), which
    // is not the type's own text.
    at(self, types: []const LType) -> string
        var out = self.base

        for i in 0..<types.len
            out = out + "." + overload_suffix_of(types[i])

        out
    end at
end LlvmIntrinsic

private overload_suffix_of(t: LType) -> string = l_overload_suffix(t) match
    Some(s) -> s
    None -> l_render(t)

// -- the entries ------------------------------------------------------------------------------------

// Stops the program: what every failed run-time check ends in.
llvm_trap_entry() -> LlvmIntrinsic = LlvmIntrinsic("llvm.trap")

// A copy of bytes, which is what a large aggregate's assignment is.
llvm_memcpy_entry() -> LlvmIntrinsic = LlvmIntrinsic("llvm.memcpy")

// A copy of bytes that may overlap: what a run placed into a buffer's slots is (`slots.sysl`).
llvm_memmove_entry() -> LlvmIntrinsic = LlvmIntrinsic("llvm.memmove")

// One byte laid over a block: what a fill of zeros, or of any value whose bytes are all alike, is.
llvm_memset_entry() -> LlvmIntrinsic = LlvmIntrinsic("llvm.memset")

// The varargs walk: the three operations a `...` parameter list is made of.
llvm_va_start_entry() -> LlvmIntrinsic = LlvmIntrinsic("llvm.va_start")

llvm_va_copy_entry() -> LlvmIntrinsic = LlvmIntrinsic("llvm.va_copy")

llvm_va_end_entry() -> LlvmIntrinsic = LlvmIntrinsic("llvm.va_end")

// What a caller is told a postcondition established.
llvm_assume_entry() -> LlvmIntrinsic = LlvmIntrinsic("llvm.assume")

// Where a stack slot's life begins and ends, which is what lets two slots share the frame
// (`emit_lifetime.sysl`).
llvm_lifetime_start_entry() -> LlvmIntrinsic = LlvmIntrinsic("llvm.lifetime.start")

llvm_lifetime_end_entry() -> LlvmIntrinsic = LlvmIntrinsic("llvm.lifetime.end")

// The address of this thread's copy of a thread-local global: the error trace's live store and the
// reference counter's reaper slot are reached through it.
llvm_threadlocal_address_entry() -> LlvmIntrinsic = LlvmIntrinsic("llvm.threadlocal.address")

// The float-to-integer conversions that saturate rather than being poison out of range.
llvm_fptosi_sat_entry() -> LlvmIntrinsic = LlvmIntrinsic("llvm.fptosi.sat")

llvm_fptoui_sat_entry() -> LlvmIntrinsic = LlvmIntrinsic("llvm.fptoui.sat")

// A multiply and an add rounded once on every machine: what a contracted `a * b + c` is
// (`fp_contract.sysl`), emitted only at a width the target fuses. Not `llvm.fmuladd`, which leaves
// the choice to the back end site by site, so that one program could round differently at two `-O`
// levels.
llvm_fma_entry() -> LlvmIntrinsic = LlvmIntrinsic("llvm.fma")

// The same multiply-add where the back end may round once or twice, which it may split per site: only
// inside a `@reassociate` body or block, whose sums have already given up the written order and
// rounding (`reassociate.sysl`), and the one form the loop vectorizer folds a reduction through.
llvm_fmuladd_entry() -> LlvmIntrinsic = LlvmIntrinsic("llvm.fmuladd")

// A hint to bring the line at an address into the cache (`prefetch.sysl`): the address, then read or
// write, the locality and the cache -- the last three immediates. A back end with no such instruction
// drops it.
llvm_prefetch_entry() -> LlvmIntrinsic = LlvmIntrinsic("llvm.prefetch")

// The magnitude of a register of floats, which clears the sign bit and so is exact at every width.
llvm_fabs_entry() -> LlvmIntrinsic = LlvmIntrinsic("llvm.fabs")

// The magnitude of a register of signed integers. Its second operand says whether the most negative
// lane is poison; it is never asked to be, so that lane answers itself, as the scalar `abs` does.
llvm_abs_entry() -> LlvmIntrinsic = LlvmIntrinsic("llvm.abs")

// IEEE 754-2019's lane-wise maximum and minimum of two registers of floats: a NaN in either lane
// wins, and `-0` orders below `+0`. Not `maxnum`/`minnum`, where the NaN loses.
llvm_maximum_entry() -> LlvmIntrinsic = LlvmIntrinsic("llvm.maximum")

llvm_minimum_entry() -> LlvmIntrinsic = LlvmIntrinsic("llvm.minimum")

// A register of floats' square root and its four roundings, lane by lane: what a vector's `sqrt`,
// `floor`, `ceil`, `round` and `trunc` are. `llvm.round` goes away from zero at a half, as the scalar
// `round` does.
llvm_lane_float_entry(op: string) -> Result[LlvmIntrinsic, string] =
    if contains_name(lane_float_ops(), op) then Ok(LlvmIntrinsic(s"llvm.$op"))
    else Err(s"no lane-wise float operation '$op' is declared")

private lane_float_ops() -> []const string = ["sqrt", "floor", "ceil", "round", "trunc"]

// The floating-point operations of a `@strict_fp` body (`emit_strict_fp.sysl`): each one LLVM may
// not merge, move or fold past what reads or writes the floating-point environment.
llvm_constrained_entry(op: string) -> Result[LlvmIntrinsic, string] =
    if contains_name(constrained_ops(), op) then Ok(LlvmIntrinsic(s"llvm.experimental.constrained.$op"))
    else Err(s"no constrained floating-point '$op' is declared")

private constrained_ops() -> []const string =
    ["fadd", "fsub", "fmul", "fdiv", "fcmp", "fcmps", "fptrunc", "fpext", "fptosi", "fptoui", "sitofp",
     "uitofp", "sqrt", "fma", "rint", "nearbyint", "floor", "ceil", "round", "roundeven", "trunc", "minnum", "maxnum",
     "minimum", "maximum"]

// The arithmetic that reports whether it overflowed: `add`, `sub` or `mul`, either signedness.
llvm_with_overflow_entry(op: string, signed: bool) -> Result[LlvmIntrinsic, string]
    if op != "add" && op != "sub" && op != "mul"
        return Err(s"no overflow-checked '$op' is declared; there are 'add', 'sub' and 'mul'")

    Ok(LlvmIntrinsic(s"llvm.${if signed then "s" else "u"}$op.with.overflow"))
end llvm_with_overflow_entry

// The bit operations `sysl.math.Bits` lowers to.
llvm_bits_entry(op: string) -> Result[LlvmIntrinsic, string] =
    if contains_name(bit_ops(), op) then Ok(LlvmIntrinsic(s"llvm.$op"))
    else Err(s"no bit operation '$op' is declared")

private bit_ops() -> []const string = ["ctpop", "ctlz", "cttz", "bitreverse", "bswap", "fshl", "fshr"]

// One vector folded to one lane.
llvm_reduce_entry(op: string) -> Result[LlvmIntrinsic, string] =
    if contains_name(reduce_ops(), op) then Ok(LlvmIntrinsic(s"llvm.vector.reduce.$op"))
    else Err(s"no vector reduction '$op' is declared")

private reduce_ops() -> []const string =
    ["fadd", "fmin", "fmax", "fminimum", "fmaximum", "add", "smin", "smax", "umin", "umax", "and", "or"]

// The saturating integer arithmetic fixed point is made of.
llvm_sat_entry(op: string) -> Result[LlvmIntrinsic, string] =
    if contains_name(sat_ops(), op) then Ok(LlvmIntrinsic(s"llvm.$op.sat"))
    else Err(s"no saturating '$op' is declared")

private sat_ops() -> []const string = ["sadd", "uadd", "ssub", "usub", "sshl", "ushl"]

// Arm's DSP-extension instructions over the lanes packed into one 32-bit register -- two 16-bit
// halves or four bytes -- each taking and answering an `i32`; `smuad`/`smlad` are the dual 16×16
// multiply-add, the second with an accumulator word. LLVM does not select `llvm.sadd.sat.v2i16`
// as one of these, since no vector of two halves is a legal type on an M-profile core, so a register of
// lanes that fills one word is handed to them directly.
llvm_arm_dsp_entry(op: string) -> Result[LlvmIntrinsic, string] =
    if contains_name(arm_dsp_ops(), op) then Ok(LlvmIntrinsic(s"llvm.arm.$op"))
    else Err(s"no Arm DSP operation '$op' is declared")

private arm_dsp_ops() -> []const string =
    ["qadd16", "qsub16", "qadd8", "qsub8", "uqadd16", "uqsub16", "uqadd8", "uqsub8", "sadd16", "ssub16",
     "sadd8", "ssub8", "smuad", "smlad"]

// The coroutine operations an `async` function is lowered through.
llvm_coro_entry(op: string) -> Result[LlvmIntrinsic, string] =
    if contains_name(coro_ops(), op) then Ok(LlvmIntrinsic(s"llvm.coro.$op"))
    else Err(s"no coroutine operation '$op' is declared")

private coro_ops() -> []const string =
    ["id", "alloc", "begin", "suspend", "end", "free", "done", "resume", "destroy", "size"]

// The float operations an `extern` may name, in the order a refusal lists them.
llvm_library_floats() -> []const string =
    ["llvm.ceil", "llvm.copysign", "llvm.fabs", "llvm.floor", "llvm.fma", "llvm.maximum", "llvm.maxnum",
     "llvm.minimum", "llvm.minnum", "llvm.nearbyint", "llvm.rint", "llvm.round", "llvm.roundeven",
     "llvm.sqrt", "llvm.trunc"]

// An AArch64 system register read or written, by the name its metadata operand carries
// (`sysreg.sysl`). The read is the volatile one, which LLVM may not fold or move.
llvm_read_volatile_register_entry() -> LlvmIntrinsic = LlvmIntrinsic("llvm.read_volatile_register")

llvm_write_register_entry() -> LlvmIntrinsic = LlvmIntrinsic("llvm.write_register")

// AArch64's three barriers, each taking its option's encoding.
llvm_aarch64_barrier_entry(op: string) -> Result[LlvmIntrinsic, string] =
    if contains_name(barrier_ops(), op) then Ok(LlvmIntrinsic(s"llvm.aarch64.$op"))
    else Err(s"no AArch64 barrier '$op' is declared; there are 'dsb', 'dmb' and 'isb'")

private barrier_ops() -> []const string = ["dsb", "dmb", "isb"]

// The same three on an M-profile Thumb core, each taking `sy`'s encoding, 15 -- the only option the
// architecture defines there.
llvm_arm_barrier_entry(op: string) -> Result[LlvmIntrinsic, string] =
    if contains_name(barrier_ops(), op) then Ok(LlvmIntrinsic(s"llvm.arm.$op"))
    else Err(s"no Arm barrier '$op' is declared; there are 'dsb', 'dmb' and 'isb'")

// A hint instruction (`sysreg.sysl`), by its number in the architecture's hint space: 0 `nop`,
// 1 `yield`, 2 `wfe`, 3 `wfi`, 4 `sev`, 5 `sevl`. AArch64's and Thumb's are two intrinsics.
llvm_aarch64_hint_entry() -> LlvmIntrinsic = LlvmIntrinsic("llvm.aarch64.hint")

llvm_arm_hint_entry() -> LlvmIntrinsic = LlvmIntrinsic("llvm.arm.hint")

// AArch64's table lookup over one 16-byte register (`tbl`), which a vector `lookup` of sixteen byte
// lanes is: each index byte picks a table byte, and one past the table answers zero.
llvm_aarch64_tbl1_entry() -> LlvmIntrinsic = LlvmIntrinsic("llvm.aarch64.neon.tbl1")

// The CRC-32C instructions an `extern` may name (`sysl.checksum`'s `crc32c`): AArch64's four widths
// and SSE 4.2's. Each folds one value of its width into a running remainder over the Castagnoli
// polynomial. They are the machine's only where `#if crc32c` holds (`crc32c_instruction`), since the
// back end refuses the call outright on a processor without them.
llvm_crc32c_intrinsics() -> []const string =
    ["llvm.aarch64.crc32cb", "llvm.aarch64.crc32ch", "llvm.aarch64.crc32cw", "llvm.aarch64.crc32cx",
     "llvm.x86.sse42.crc32.32.8", "llvm.x86.sse42.crc32.32.16", "llvm.x86.sse42.crc32.32.32",
     "llvm.x86.sse42.crc32.64.64"]

// The cryptographic and dot-product instructions an `extern` may name, over vectors: AArch64's AES
// rounds (`aes`), its three-way XOR, bit-clear and rotate of the SHA-3 extension (`sha3`) and its
// `sdot`/`udot` (`dotprod`), and x86's AES-NI rounds (`aes`) and the VNNI dot products (`avxvnni`,
// which LLVM selects in its VEX encoding and `avx512vnni` + `avx512vl` select in EVEX). Each takes
// and answers whole registers, so the declaration's signature is vectors (`program.sysl`'s
// `resolve_vector_intrinsic`), and each is compiled for its extension as a CRC-32C instruction is: a
// call is held to `@extensions`, the build's promise or `@unchecked` (`extensions.sysl`).
llvm_vector_intrinsics() -> []const string =
    ["llvm.aarch64.crypto.aese", "llvm.aarch64.crypto.aesd", "llvm.aarch64.crypto.aesmc",
     "llvm.aarch64.crypto.aesimc", "llvm.aarch64.crypto.eor3u", "llvm.aarch64.crypto.eor3s",
     "llvm.aarch64.crypto.bcaxu", "llvm.aarch64.crypto.bcaxs", "llvm.aarch64.crypto.rax1",
     "llvm.aarch64.neon.sdot", "llvm.aarch64.neon.udot",
     "llvm.x86.aesni.aesenc", "llvm.x86.aesni.aesenclast", "llvm.x86.aesni.aesdec",
     "llvm.x86.aesni.aesdeclast", "llvm.x86.aesni.aesimc",
     "llvm.x86.avx512.vpdpbusd.128", "llvm.x86.avx512.vpdpbusd.256", "llvm.x86.avx512.vpdpbusds.128",
     "llvm.x86.avx512.vpdpbusds.256", "llvm.x86.avx512.vpdpwssd.128", "llvm.x86.avx512.vpdpwssd.256",
     "llvm.x86.avx512.vpdpwssds.128", "llvm.x86.avx512.vpdpwssds.256"]

// The extension a vector intrinsic is compiled for, or `""` where `symbol` is not one. `symbol` is a
// base or the name an overloaded one is emitted under, its suffix (`.v4i32.v16i8`) after the base.
llvm_vector_intrinsic_extension(symbol: string) -> string
    var known = false

    for name in llvm_vector_intrinsics()
        if symbol == name || symbol.starts_with(name + ".") then known = true

    if !known then return ""

    if symbol.starts_with("llvm.aarch64.crypto.aes") || symbol.starts_with("llvm.x86.aesni.") then return "aes"
    if symbol.starts_with("llvm.aarch64.crypto.") then return "sha3"
    if symbol.starts_with("llvm.aarch64.neon.") then return "dotprod"

    "avxvnni"
end llvm_vector_intrinsic_extension

// -- the reserved globals ---------------------------------------------------------------------------

// The list the platform's loader runs before `main`.
llvm_global_ctors() -> string = "llvm.global_ctors"

// What keeps a symbol nothing references from being deleted, by the optimizer and the linker both.
llvm_used() -> string = "llvm.used"

// What keeps it from the optimizer alone.
llvm_compiler_used() -> string = "llvm.compiler.used"

// The section the two lists above live in.
llvm_metadata_section() -> string = "llvm.metadata"

// -- the census -------------------------------------------------------------------------------------

// Every callable entry, by base name.
llvm_callable() -> Buf[string]
    var out: Buf[string] = buf()

    out.push(llvm_trap_entry().base)
    out.push(llvm_memcpy_entry().base)
    out.push(llvm_memmove_entry().base)
    out.push(llvm_memset_entry().base)
    out.push(llvm_va_start_entry().base)
    out.push(llvm_va_copy_entry().base)
    out.push(llvm_va_end_entry().base)
    out.push(llvm_assume_entry().base)
    out.push(llvm_lifetime_start_entry().base)
    out.push(llvm_lifetime_end_entry().base)
    out.push(llvm_threadlocal_address_entry().base)
    out.push(llvm_fptosi_sat_entry().base)
    out.push(llvm_fptoui_sat_entry().base)

    val ops = ["add", "sub", "mul"]

    for i in 0..<ops.len
        out.push(llvm_with_overflow_entry(ops[i], true).unwrap().base)
        out.push(llvm_with_overflow_entry(ops[i], false).unwrap().base)

    push_family(&out, bit_ops(), "llvm.")
    push_family(&out, reduce_ops(), "llvm.vector.reduce.")
    push_family(&out, lane_float_ops(), "llvm.")
    push_family(&out, coro_ops(), "llvm.coro.")
    push_family(&out, barrier_ops(), "llvm.aarch64.")
    push_family(&out, barrier_ops(), "llvm.arm.")
    push_family(&out, arm_dsp_ops(), "llvm.arm.")
    out.push(llvm_aarch64_hint_entry().base)
    out.push(llvm_arm_hint_entry().base)
    out.push(llvm_aarch64_tbl1_entry().base)
    push_family(&out, constrained_ops(), "llvm.experimental.constrained.")
    out.push(llvm_read_volatile_register_entry().base)
    out.push(llvm_write_register_entry().base)
    out.push(llvm_prefetch_entry().base)

    for i in 0..<sat_ops().len
        out.push(s"llvm.${sat_ops()[i]}.sat")

    val floats = llvm_library_floats()

    for i in 0..<floats.len
        out.push(floats[i])

    val crcs = llvm_crc32c_intrinsics()

    for i in 0..<crcs.len
        out.push(crcs[i])

    val vectors = llvm_vector_intrinsics()

    for i in 0..<vectors.len
        out.push(vectors[i])

    out
end llvm_callable

private push_family(out: *Buf[string], ops: []const string, prefix: string)
    for i in 0..<ops.len
        out.push(prefix + ops[i])
end push_family

// Every reserved global, and the section they are placed in.
llvm_globals() -> Buf[string]
    var out: Buf[string] = buf()

    out.push(llvm_global_ctors())
    out.push(llvm_used())
    out.push(llvm_compiler_used())
    out.push(llvm_metadata_section())
    out
end llvm_globals

// Whether `name` is an entry, or an entry's base with an overload suffix after it. A name that only
// begins with the same letters -- `llvm.sqrtx.f64` -- is not, which is what keeps this from being a
// substring test.
llvm_accounts(name: string) -> bool
    val all = llvm_callable()

    for b in all
        if name == b || name.starts_with(b + ".") then return true

    contains_name(llvm_globals().view(), name)
end llvm_accounts

private contains_name(xs: []const string, name: string) -> bool
    for i in 0..<xs.len
        if xs[i] == name then return true

    false
end contains_name
