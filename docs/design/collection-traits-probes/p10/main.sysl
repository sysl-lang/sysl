// p10: one function over every container -- a body generic over `Walk` that walks what it is given.
import sysl.buf.{Buf, buf}
import sysl.container.{List, list_of}

total[C: Walk](c: C) -> int
    var t = 0
    for x in c
        t += x
    t

main()
    var b: Buf[int] = buf()
    b.push(1)
    b.push(2)
    print(total(b), total(list_of([3, 4])))
