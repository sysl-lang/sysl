import sysl.buf.*
// Indexed read and write through a struct field: the shape of an interpreter's value stack.
struct Heap
    b: Buf[long]
    sp: usize

var h = Heap(buf(), 0)

for i in 0..<1024
    h.b.push(0)

var acc: long = 0

for round in 0..<360000
    for i in 1..<1024
        h.b[i] = h.b[i - 1] + long(i)
        acc += h.b[i] & 255

print(acc)
