module sysl.math.bigint

import sysl.buf.{Buf, buf}
import sysl.text.{Ascii, from_utf8_unchecked}

// Reading a big integer and writing one, in any base from 2 to 36.
//
// **Both directions work a CHUNK at a time rather than a digit at a time**, and the chunk is the
// largest power of the base that fits in a limb -- `10^19` for base ten on a 64-bit target, `10^9`
// on a 32-bit one. So rendering divides the magnitude by `10^19` and gets nineteen digits out of the
// remainder with ordinary machine arithmetic, and reading multiplies by `10^19` and adds nineteen
// digits at a time.
//
// **Chunking alone is still quadratic**: each division by the chunk is a pass over what is left. So a
// large value goes through a DIVIDE-AND-CONQUER conversion first (Knuth, *The Art of Computer
// Programming* volume 2, §4.4, answer to exercise 14; GMP's `mpn_get_str` and `mpn_set_str` are this
// shape). Rendering divides by `chunk^(2^k)`, the largest such power under the value, and renders the
// quotient and the remainder each by the same rule a level down -- the remainder padded with zeros to
// exactly `per 2^k` digits, since its leading zeros are digits of the whole. Reading splits the
// digits so that the low part has `per 2^k` of them, reads both halves, and puts them together as
// `high * chunk^(2^k) + low`. The powers are built once per conversion by squaring. With the
// recursive division and Karatsuba underneath, both directions cost a constant times a
// multiplication's `log n`, and below a threshold the chunk-at-a-time loops do the rest.

/** The digits, in the order their values run. Lower case, which is what every language emits and
 * what `parse` accepts either of.
 */
private const DIGITS: string = "0123456789abcdefghijklmnopqrstuvwxyz"

/** The size in limbs below which a conversion is the chunk-at-a-time loop. */
private[bigint] val text_threshold: usize = 40

/** `x` in base ten -- the older spelling of `x.to_string()`, kept while the compiler's own source,
 * built by the previous release, still calls it.
 */
to_string(x: BigInt) -> string = to_string_radix(x, 10)

// Base ten, which is what `x.to_string()` and `s"${x}"` write; `to_string_radix` writes any other.
impl Display for BigInt
    display(self, out: *Writer, fmt: FormatSpec) = display_str(to_string_radix(self, 10), out, fmt)

/** `x` written in `base`, with a leading `-` where it is negative and no `+` where it is not.
 *
 * **A base outside 2 to 36 traps**, since there is no digit to write past `z` and a caller asking
 * for base 37 has a mistake rather than an unusual requirement. Zero is `"0"` in every base.
 *
 * Allocates the answer, and working storage a small multiple of the value's size.
 */
to_string_radix(x: BigInt, base: int) -> string
    if base < 2 || base > 36 then panic("sysl.math.bigint: a base runs from 2 to 36")
    if x.is_zero() then return "0"

    val conv = Conversion.of(base)
    var out: Buf[u8] = buf()

    out.reserve(x.mag.len * usize(conv.per) + usize(conv.per) + 1)

    if x.minus then out.push(u8('-'))

    if x.mag.len < text_threshold
        conv.render_small(&out, x.mag, 0)
    else
        val powers = conv.powers_upto(x.mag.len)
        var k = powers.len()

        // The largest power not above the value: the value is below that power squared, so the
        // quotient and the remainder are both below the power itself.
        while k > 1 && cmp_mag(x.mag, powers[k - 1]) < 0
            k -= 1

        conv.render(&out, x.mag, powers, k - 1, 0)

    // Every byte written is an ASCII digit, a letter or a hyphen, so the result is valid UTF-8 by
    // construction and there is nothing for a validating pass to find.
    from_utf8_unchecked(out.view())
end to_string_radix

/** The value `s` names in base ten, or `None`. */
parse(s: string) -> Option[BigInt] = parse_radix(s, 10)

/** The value `s` names in `base`, or `None` where it names none.
 *
 * An optional `+` or `-` and then at least one digit, in either case. Nothing else: no underscores,
 * no `0x` prefix, no leading or trailing space. A caller reading a number out of a document trims
 * and strips before it gets here, because what a document allows is the document's business.
 *
 * **`"-0"` parses to zero and renders as `"0"`**, which is the one input that does not round trip
 * and could not: there is no negative zero in this representation, which is what makes equality and
 * hashing straightforward everywhere else.
 */
parse_radix(s: string, base: int) -> Option[BigInt]
    if base < 2 || base > 36 then return None

    val b = s.bytes
    var i: usize = 0
    var minus = false

    if i < b.len && (b[i] == u8('-') || b[i] == u8('+'))
        minus = b[i] == u8('-')
        i += 1

    if i >= b.len then return None

    // Every digit is checked once, here, so the conversion below reads digits it knows are valid.
    for j in i..<b.len
        if b[j].digit_value(base).is_none() then return None

    val conv = Conversion.of(base)
    val digits = b[i..]
    val chunks = digits.len / usize(conv.per)
    var mag = empty()

    if chunks < text_threshold
        mag = conv.read_small(digits)
    else
        mag = conv.read(digits, conv.powers_upto(chunks + 1))

    if mag.len == 0 then Some(zero()) else Some(BigInt(minus, mag))
end parse_radix

/** A base, with the largest power of it that fits a limb and how many digits that power is. */
private struct Conversion
    base: int
    chunk: Limb
    per: int

    /** The chunk is computed rather than tabled because a table of thirty-five entries is a table
     * to get wrong, and this runs once per conversion against loops that run once per chunk.
     */
    of(base: int) -> Conversion
        val radix = Wide(1) << limb_bits
        var chunk = Wide(base)
        var per = 1

        while chunk * Wide(base) < radix
            chunk = chunk * Wide(base)
            per += 1

        Conversion(base, Limb(chunk), per)
    end of

    /** `chunk^(2^k)` for `k` from 0 up to the first one with more than `limbs / 2` limbs, so that
     * the last one squared is past any value of `limbs` limbs. Each is the one before squared.
     */
    powers_upto(self, limbs: usize) -> Buf[[]const Limb]
        var out: Buf[[]const Limb] = buf()

        out.push(mag_of_u64(u64(self.chunk)))

        while out[out.len() - 1].len * 2 <= limbs + 1
            val p = out[out.len() - 1]

            out.push(sqr_mag(p))

        out
    end powers_upto

    /** The digits of `mag` appended to `out`, most significant first, padded with zeros to `width`
     * digits where `width` is not zero.
     *
     * **`mag` is below `powers[k]` squared** -- the caller picks `k` so -- which is what makes the
     * quotient and the remainder each below `powers[k]`, and so each below `powers[k - 1]` squared
     * for the level down. At `k` of zero that bound is two limbs, under any threshold.
     */
    render(self, out: *Buf[u8], mag: []const Limb, powers: Buf[[]const Limb], k: usize, width: usize)
        if mag.len < text_threshold
            self.render_small(out, mag, width)
            return

        val (q, r) = divmod_mag(mag, powers[k])
        val low = usize(self.per) << k

        // The quotient's own width is what is left of this call's, or none at the top.
        if width == 0 && q.len == 0
            self.render(out, r, powers, if k > 0 then k - 1 else 0, 0)
        else
            self.render(out, q, powers, if k > 0 then k - 1 else 0, if width > low then width - low else 0)
            self.render(out, r, powers, if k > 0 then k - 1 else 0, low)
    end render

    /** The chunk-at-a-time rendering: `mag` divided in place by the chunk, `per` digits out of each
     * remainder, least significant first, then turned around onto `out`.
     */
    render_small(self, out: *Buf[u8], mag: []const Limb, width: usize)
        val alphabet = DIGITS.bytes
        var digits: Buf[u8] = buf()
        var work: []Limb = [0; mag.len + 1]
        var len = mag.len

        copy_n(work, mag, len)

        // Every chunk emits `per` digits whether it needed them or not, which pads the most
        // significant one with zeros; stripping them afterwards is one loop and is simpler than
        // deciding, inside the loop, whether this is the last chunk.
        while len > 0
            var value = divrem_1(work, work, len, self.chunk)

            len = top_of(work, len)

            for _ in 0..<self.per
                digits.push(alphabet[value % Limb(self.base)])
                value = value / Limb(self.base)

        var n = digits.len()

        while n > 0 && digits[n - 1] == u8('0')
            n -= 1

        // A value with no digits of its own is a zero, written as one digit where nothing pads it.
        val wanted = if width > n then width elif n == 0 then 1 else n

        for _ in n..<wanted do out.push(u8('0'))

        var i = n

        while i > 0
            i -= 1
            out.push(digits[i])
    end render_small

    /** The value of `digits`, all of them valid, by splitting where the low part has `per 2^k`
     * digits for the largest `k` that leaves the high part non-empty.
     */
    read(self, digits: []const u8, powers: Buf[[]const Limb]) -> []const Limb
        val chunks = digits.len / usize(self.per)

        if chunks < text_threshold then return self.read_small(digits)

        var k = powers.len() - 1

        while k > 0 && usize(self.per) << k >= digits.len
            k -= 1

        val split = digits.len - (usize(self.per) << k)
        val high = self.read(digits[..<split], powers)
        val low = self.read(digits[split..], powers)

        add_mag(mul_mag(high, powers[k]), low)
    end read

    /** The chunk-at-a-time reading, built in place in storage sized for every digit at once: each
     * chunk multiplies what is there by the chunk's power and adds the chunk in one pass.
     */
    read_small(self, digits: []const u8) -> []const Limb
        var mag: []Limb = [0; digits.len / usize(self.per) + 2]
        var len: usize = 0
        var i: usize = 0

        while i < digits.len
            var acc: Limb = 0
            var mult: Limb = 1
            var k = 0

            while k < self.per && i < digits.len
                acc = acc * Limb(self.base) + Limb(digits[i].digit_value(self.base).unwrap())
                mult = mult * Limb(self.base)
                i += 1
                k += 1

            val top = mul_1(mag, mag, len, mult, acc)

            if top != 0
                mag[len] = top
                len += 1

        mag[0..<len]
    end read_small
end Conversion
