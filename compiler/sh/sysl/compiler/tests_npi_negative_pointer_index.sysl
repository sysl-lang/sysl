module sh.sysl.compiler
@tests

import sysl.text.{Search, replace_all}
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture

// **A raw pointer's index is signed** (`reference/memory.md § Bounds safety follows length, not
// pointers`): a `*T` carries no length, so `p[-1]` names the element before `p` as C's does, and a
// literal index takes `isize` rather than the `usize` an array's or a slice's takes. Everything with
// a length still refuses a negative literal, with the words it always said.

private npi_skipped() -> bool
    if std_root().is_err()
        print("skipped: the standard module's source is not on this machine")
        return true

    if !clang_available()
        print("skipped: there is no clang on this machine")
        return true

    false
end npi_skipped

private npi_write(text: string) -> string
    val root = make_temp_dir("sysl-npi").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", text).unwrap()
    root
end npi_write

// What a program prints; one that does not build answers what the build said.
private npi_prints(text: string) -> string
    val root = npi_write(text)
    val exe = s"$root/built"

    build_native_program(root, None, None, DefaultOptimization, Some(exe)) match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return s"did not build: ${failure_text(why)}"
        Ok(_) -> ()

    val said = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    said match
        Err(_) -> "the program that was built could not be run"
        Ok(out) -> if out.status.ok() then out.text else s"exited badly: ${out.text}"
end npi_prints

// Everything the analysis says of a program, with the temporary root taken off each path.
private npi_err(text: string) -> string
    val root = npi_write(text)

    val out = emit_llvm_text(root, None) match
        Err(why) -> why.message
        Ok(made) -> if made.report.is_empty() then "" else analysis_report(made.report)

    remove_dir_all(root).unwrap_or(())
    replace_all(out, replace_all(root, "//", "/") + "/", "")
end npi_err

private val npi_array ="var a: [4]isize = [10, 20, 30, 40]\nval p = &a[2]\n"

@test("a negative literal indexes a raw pointer backwards, read and written")
npi_reads_and_writes_backwards()
    if npi_skipped() then return

    assert_eq(npi_prints(npi_array + "print(p[-1], p[-2], p[0], p[1])\n"), "20 10 30 40\n")
    assert_eq(npi_prints(npi_array + "p[-1] = 99\np[-2] += 5\nprint(a[0], a[1])\n"), "15 99\n")
    assert_eq(npi_prints(npi_array + "print(*(&p[-2]))\n"), "10\n")

@test("a negated constant and a typed negative index reach the same element")
npi_constant_and_typed_index()
    if npi_skipped() then return

    assert_eq(npi_prints(npi_array + "const k = 1\nprint(p[-k], p[isize(-1)], p[-1 - k])\n"),
              "20 20 10\n")

@test("a pointer to bytes takes a negative literal too")
npi_byte_pointer()
    if npi_skipped() then return

    assert_eq(npi_prints("var b: [3]u8 = [7, 8, 9]\nval q = &b[2]\nprint(q[-2], q[-1])\n"), "7 8\n")

@test("an array and a slice still refuse a negative literal index, saying so")
npi_length_carriers_refuse()
    val a = npi_err("var a: [4]isize = [10, 20, 30, 40]\nprint(a[-1])\n")

    assert(a.contains("the literal -1 does not fit usize"), a)

    val s = npi_err("var a: [4]isize = [10, 20, 30, 40]\nval s = a[0..<4]\nprint(s[-1])\n")

    assert(s.contains("the literal -1 does not fit usize"), s)
