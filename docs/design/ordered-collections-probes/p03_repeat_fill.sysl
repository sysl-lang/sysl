// The workaround for p01/p02: fill the inline array from the first key, `[k; B]`. Shows what the
// fill costs a Drop key: the spare copies keep a removed key alive until the node goes.

struct Tag
    n: int

impl Drop for Tag
    drop(self) = print("drop", self.n)

struct Node[K, const B: usize]
    len: usize
    keys: [B]K

leaf[K, const B: usize](k: K) -> &Node[K, B] = Node(1, [k; B])

remove_first[K, const B: usize](n: &Node[K, B])
    for i in 1..<n.len
        n.keys[i - 1] = n.keys[i]

    n.len -= 1

run()
    val n = leaf[&Tag, 4](Tag(1))

    n.keys[1] = Tag(2)
    n.len = 2
    remove_first(n)
    print("removed 1; live", n.len, n.keys[0].n)

run()
print("node gone")
