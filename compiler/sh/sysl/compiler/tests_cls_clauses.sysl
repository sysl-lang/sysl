    cls_refused(raw"""
        h(a: bool, b: bool) -> int
        h(true, _) = 1
        h(false, _) = 2
        h(_, true) = 3

        main()
            print(h(true, true))
        """, "unreachable clause 'h(_, true)': every argument list it matches is already " +
