module sysl.text

import sysl.unicode.{is_space as unicode_space}

/** Searching text and trimming it -- the half of the operations that makes no new bytes.
 *
 * **Everything here is allocation-free, and that is what the file boundary is drawn on.** A search
 * answers with an offset or a `bool`, and a trim answers with a *view* of what it was given, so
 * nothing in this file needs an allocator and all of it is reachable under `no alloc`. What makes
 * new text -- joining, replacing, changing case -- is in `edit.sysl` beside it, and needs one.
 *
 * **It is written once, over `[]const u8`, and that is the whole design.** The older sysl wrote this
 * surface twice: `std.strings` over `string` and `std.bytes` over `[]byte`, 1,630 lines of
 * near-identical code, because it had no way to say "either of these". A trait says it: each
 * implementation supplies two members -- the bytes to look at, and how to cut a piece of itself out
 * -- and every operation below is a default written against those two. So `s.starts_with("//")` and
 * `b.starts_with(prefix)` are the same code, and adding an operation adds it to both.
 *
 * **A byte-level search over UTF-8 is not a shortcut, it is correct.** UTF-8 is self-synchronizing:
 * a continuation byte is distinguishable from a lead byte, so a well-formed needle cannot match
 * starting anywhere but at a character boundary. That is why these can ignore encoding entirely,
 * and why an offset one of them returns is always safe to slice at -- which matters, since
 * `s[a..b]` traps on a mid-codepoint bound.
 *
 * **The subsequence searches are Boyer-Moore-Horspool, and the sentence this replaces said one day
 * they might be.** A needle of two bytes or more is looked for by aligning its *last* byte and, on a
 * mismatch, shifting the window by however far that byte's own last occurrence in the needle is from
 * the end -- so the common case reads a fraction of the haystack rather than all of it. Over a
 * megabyte in which the needle's first byte occurs four thousand times, `index_of` went from 478 to
 * 35 microseconds. Nothing observable changed: the offsets, the empty-needle conventions and the
 * non-overlapping count are what they were, which is what the differential test in `tests.sysl`
 * asserts against a scan written out longhand, over a few thousand random inputs.
 *
 * **The table is 256 bytes on the STACK, which is what keeps the file's allocation claim true.** A
 * shift is capped at 255 rather than widened to a `usize`, because a shift smaller than the ideal
 * one is still correct -- it only costs a needle longer than 255 bytes a few more windows -- and
 * 2 KB of frame is a real thing to ask of a target that reaches this module with no allocator at all.
 *
 * **Below a couple of words of haystack the naive scan is still the faster one and is still what
 * runs**, because building the table costs something before the first byte is read. Where the two
 * cross is `sublinear_floor`'s own comment, and it is a good deal lower than the arithmetic suggests.
 * A one-byte needle never builds a table at all -- it is a single byte scan, which is what
 * `index_of_byte` already was.
 */
trait Search

    /** The bytes to look at. This is the whole of what a `string` and a `[]const u8` disagree about. */
    view(self) -> []const u8

    /** A piece of the receiver, as the receiver's own type -- what lets a trim answer with a view
     * rather than a copy, and what a default cannot do for itself because it does not know how to
     * build a `Self`.
     */
    slice(self, lo: usize, hi: usize) -> Self

    // --- What the trait answers for itself. ---

    /** There is deliberately no `len` here: both implementations already have one the compiler
     * provides, and a trait member of that name would hide it rather than agree with it.
     */
    is_empty(self) -> bool = self.view().len == 0

    /** The empty prefix is a prefix of everything, which falls out of the comparison rather than
     * being said: two slices of no elements are equal.
     */
    starts_with(self, prefix: Self) -> bool
        var h = self.view()
        var n = prefix.view()

        if n.len > h.len then return false

        h[0..<n.len] == n

    ends_with(self, suffix: Self) -> bool
        var h = self.view()
        var n = suffix.view()

        if n.len > h.len then return false

        h[(h.len - n.len)..] == n

    /** Where the first occurrence starts, or `None`.
     *
     * An `Option` rather than old sysl's `-1`, because a sentinel is a value the type says is
     * ordinary and every caller has to remember to check. The empty needle is found at 0, which is
     * the convention every library shares and the one that makes `split` on an empty separator
     * terminate.
     */
    index_of(self, needle: Self) -> Option[usize] = find_from(self.view(), needle.view(), 0)

    /** The same search begun part-way along, which is what walks every occurrence without cutting
     * the haystack up: `index_of_from(n, k + 1)` is the next one after `k`.
     *
     * **`from` names a place to START, and the answer is an offset in the WHOLE receiver** -- so it
     * is `self[from..].index_of(n)` with `from` added back on, and every `_from` in this file reads
     * the same way, the backward ones included. That is the one rule to know here: a backward search
     * given a `from` looks in the same suffix and answers with the *last* occurrence in it, rather
     * than searching downwards from `from`, which is the other convention libraries pick and is not
     * this one.
     *
     * **A `from` past the end answers `None` rather than trapping**, which is what makes the
     * `k + 1` above safe to write at the last occurrence without a bound test of its own. The empty
     * needle is found at `from` while `from` is a position at all, and `h.len` is a position.
     */
    index_of_from(self, needle: Self, from: usize) -> Option[usize] =
        find_from(self.view(), needle.view(), from)

    /** The empty needle is found at the end here rather than at 0, which is the same convention read
     * from the other side: the last place it occurs.
     */
    last_index_of(self, needle: Self) -> Option[usize] = rfind_from(self.view(), needle.view(), 0)

    /** The last occurrence at or after `from` -- the backward search over the same suffix the
     * forward one takes, per the rule on `index_of_from`.
     */
    last_index_of_from(self, needle: Self, from: usize) -> Option[usize] =
        rfind_from(self.view(), needle.view(), from)

    index_of_byte(self, b: u8) -> Option[usize] = find_byte_from(self.view(), b, 0)

    index_of_byte_from(self, b: u8, from: usize) -> Option[usize] = find_byte_from(self.view(), b, from)

    last_index_of_byte(self, b: u8) -> Option[usize] = rfind_byte_from(self.view(), b, 0)

    last_index_of_byte_from(self, b: u8, from: usize) -> Option[usize] =
        rfind_byte_from(self.view(), b, from)

    contains(self, needle: Self) -> bool = self.index_of(needle).is_some()

    /** Whether one byte occurs anywhere. It is written as its own loop rather than as
     * `index_of_byte(b).is_some()` because the answer is a `bool` and going through the `Option`
     * asks for a position nobody wants -- which is also what a cutset trim needs, since it asks
     * this once per byte trimmed.
     */
    has_byte(self, b: u8) -> bool
        for x in self.view()
            if x == b then return true

        false

    /** How many non-overlapping occurrences there are, counted the way a `replace_all` would find
     * them -- so `count_of` and the number of replacements `replace_all` makes always agree. In
     * `"aaa"` there is one `"aa"`, not two.
     */
    count_of(self, needle: Self) -> usize = count_bytes(self.view(), needle.view())

    // --- Trimming, which answers with a view of the receiver rather than a copy. ---

    /** ASCII whitespace off the front, the back, or both -- which is the answer for a receiver of
     * BYTES, and is not what a `string` gives.
     *
     * **The trait's own answer is byte for byte, and `string` replaces all three.** A byte is not a
     * character, so a run of bytes has no Unicode whitespace in it to find: a non-breaking space is
     * `0xc2 0xa0`, and neither of those is a space on its own. `impl Search for string` overrides
     * these with a walk over characters, testing `sysl.unicode.is_space`; what is left here is what
     * a wire format wants, where the ASCII answer is the specified one.
     *
     * **Trimming cannot land mid-character either way**, which is what makes it safe to answer with
     * a slice: every whitespace byte is ASCII, so every byte removed is a whole character and every
     * bound left behind is one the receiver already had.
     */
    trim_start(self) -> Self
        var h = self.view()
        var i: usize = 0

        while i < h.len && h[i].is_space()
            i += 1

        self.slice(i, h.len)
    end trim_start

    trim_end(self) -> Self
        var h = self.view()
        var n = h.len

        while n > 0 && h[n - 1].is_space()
            n -= 1

        self.slice(0, n)
    end trim_end

    trim(self) -> Self
        var h = self.view()
        var i: usize = 0
        var n = h.len

        while i < n && h[i].is_space()
            i += 1

        while n > i && h[n - 1].is_space()
            n -= 1

        self.slice(i, n)
    end trim

    /** The same three against a set of bytes the caller names, which is what strips quotes, slashes
     * or padding rather than whitespace.
     *
     * **The cutset is a set of BYTES**, so a non-ASCII character in one is its bytes and not itself
     * -- and trimming with such a cutset can cut a character in half, which for a `string` is a
     * trap rather than a wrong answer. That is the honest behaviour for a byte-level operation and
     * the reason the whitespace trims above are the ones without a caveat.
     * Membership in the cutset is `has_byte` asked of the cutset, which is why there is no helper
     * beside these: the question "is this byte one of those" is one the trait already answers, and
     * asking it of the cutset rather than of the receiver is the whole difference.
     */
    trim_start_matches(self, cutset: Self) -> Self
        var h = self.view()
        var i: usize = 0

        while i < h.len && cutset.has_byte(h[i])
            i += 1

        self.slice(i, h.len)
    end trim_start_matches

    trim_end_matches(self, cutset: Self) -> Self
        var h = self.view()
        var n = h.len

        while n > 0 && cutset.has_byte(h[n - 1])
            n -= 1

        self.slice(0, n)
    end trim_end_matches

    trim_matches(self, cutset: Self) -> Self = self.trim_start_matches(cutset).trim_end_matches(cutset)

end Search

/** Text, which is the receiver these are nearly always written on. `slice` goes through the
 * language's own boundary-checked subscript, so a piece cut out of a string is a string with the
 * same guarantee -- and the bounds every operation above hands it are ones the search or the trim
 * already knows are boundaries.
 */
impl Search for string
    view(self) -> []const u8 = self.bytes

    slice(self, lo: usize, hi: usize) -> string = self[lo..<hi]

    /** Whitespace off the front, over **Unicode** rather than ASCII: a non-breaking space, an
     * ideographic space and a next-line control are all removed, and the trait's byte walk removes
     * none of them.
     *
     * **A `string` is text, so the question has a character-level answer and the byte-level one is
     * merely cheaper.** `Ascii.is_space` covers `U+0009` to `U+000D` and `U+0020` and stops there,
     * which was the whole of sysl's `trim` by accident of ordering rather than by decision — the
     * database that answers the rest arrived after these were written. The `[]const u8` receiver
     * keeps the byte walk, because bytes are not characters and a wire format wants the ASCII
     * answer.
     *
     * **What it costs is a decode**, a few nanoseconds per byte, and the table `is_space` reads.
     * A program that never trims a `string` links neither.
     *
     * **No locale enters into it**, here or anywhere else in this module: the library has no notion
     * of one, and the whitespace property is not locale-sensitive in any case. Casing is where that
     * bites, and `to_upper` says so.
     */
    override trim_start(self) -> string
        var w = chars_of(self.bytes)
        var i: usize = 0

        loop
            w.next() match
                Some(c) ->
                    if !unicode_space(c) then break
                    i = w.offset
                None -> break

        self[i..<self.len]
    end trim_start

    /** The other end, walked forwards.
     *
     * **There is no backwards decoder here and it would buy nothing.** UTF-8 is self-synchronizing,
     * so stepping back over a character is possible — but the trim has to look at every character
     * from the end until it finds one that is not a space, and in the common case where nothing is
     * trimmed that is one step either way. What decides it is that a forward walk is the decoder
     * this module already has, and a second one would be a second thing to keep right.
     */
    override trim_end(self) -> string
        var w = chars_of(self.bytes)
        var n: usize = 0

        loop
            w.next() match
                Some(c) -> if !unicode_space(c) then n = w.offset
                None -> break

        self[0..<n]
    end trim_end

    /** Both ends. It is the two walks rather than one because the second runs over what the first
     * left, which is the shorter string and is what a caller would have written by hand.
     */
    override trim(self) -> string = self.trim_start().trim_end()

/** Bytes that are not text, or not yet: what a program reads off a socket or a file before it knows
 * whether it is UTF-8. The same operations answer the same way, which is the point of the trait --
 * and here there is no encoding to be careful of, since there is no guarantee to keep.
 */
impl Search for []const u8
    view(self) -> []const u8 = self

    slice(self, lo: usize, hi: usize) -> []const u8 = self[lo..<hi]

// --- The search itself, written once over bytes and shared by every member above. ---

/** Where the naive scan stops being the cheaper answer, in bytes of haystack left to look at.
 *
 * **Measured, and the answer is far lower than it reads like it should be.** Horspool pays 256 table
 * stores plus the needle before it reads a byte of the haystack, so the arithmetic says a haystack
 * has to be a few hundred bytes long before that is worth it. It says wrong on both halves: 256
 * adjacent byte writes are a handful of vector stores rather than 256 of anything, and a window the
 * shift skips costs nothing at all where the scan's costs a bounds-checked load and a branch. A
 * four-byte needle steps four at a time through text that does not hold it, so three windows in four
 * are never looked at.
 *
 * Timed on a quiet machine at 400,000 searches per length, over random text of sixteen letters and a
 * four-byte needle that is not in it -- the case where both walk the whole haystack, and so the one
 * where a fixed cost shows most clearly. Milliseconds for the whole run, median of three:
 *
 * | haystack | 8 | 16 | 24 | 32 | 48 | 64 | 96 |
 * |---|---|---|---|---|---|---|---|
 * | the scan | 4.1 | 6.6 | 9.1 | 11.5 | 18.3 | 22.5 | 34.3 |
 * | shifting | 7.0 | 8.0 | 9.7 | 10.2 | 11.9 | 13.2 | 16.9 |
 *
 * **They cross between 24 and 32**, so this is the crossing rounded up. What is left below it is a
 * haystack of a couple of words, which is common enough for a `string` to be worth the branch that
 * keeps the scan.
 *
 * It is visible to the module rather than to this file alone because `tests.sysl` asserts that both
 * paths were **reached** -- a differential test that only ever ran one of them would be agreeing
 * with itself, and it cannot count which path a case took without knowing where they divide.
 */
private[text] val sublinear_floor: usize = 32

/** How far Horspool may shift, which is what makes the table a byte per character rather than a word.
 *
 * A shift SHORTER than the ideal one is always correct -- it only tries a window the ideal shift
 * would have skipped -- so capping costs a needle longer than this a few extra windows and costs
 * every other needle nothing. Every entry is at least 1, which is what makes the loop terminate.
 */
private val max_shift: usize = 255

private clamp_shift(d: usize) -> u8 = u8(if d < max_shift then d else max_shift)

/** The bad-character table for a forward search: for each byte, how far the window moves when that
 * byte is what sat under the needle's last position and the match failed.
 *
 * The needle's **last** character is deliberately not entered, which is the whole of Horspool: the
 * shift is read from the haystack byte aligned with it, so entering it would answer 0 and the search
 * would not move. Every other position writes, later ones overwriting earlier, so what is left is
 * the distance from each byte's *last* occurrence to the end.
 */
private horspool_table(t: []u8, n: []const u8)
    val m = n.len
    val miss = clamp_shift(m)

    for i in 0..<t.len
        t[i] = miss

    var i: usize = 0

    while i + 1 < m
        t[usize(n[i])] = clamp_shift(m - 1 - i)
        i += 1
end horspool_table

/** The same table for a backward search, read from the byte aligned with the needle's **first**
 * position: the shift down is the distance to that byte's *first* occurrence after the start, so
 * position 0 is the one left out and the smallest index wins rather than the largest.
 */
private horspool_table_rev(t: []u8, n: []const u8)
    val m = n.len
    val miss = clamp_shift(m)

    for i in 0..<t.len
        t[i] = miss

    var i = m - 1

    while i >= 1
        t[usize(n[i])] = clamp_shift(i)
        i -= 1
end horspool_table_rev

/** Whether the needle sits at `i`, compared from its END so that the byte Horspool has already
 * decided on is the first one re-read and the ordinary mismatch costs one comparison.
 */
private matches_at(h: []const u8, n: []const u8, i: usize) -> bool
    var j = n.len

    while j > 0
        j -= 1

        if h[i + j] != n[j] then return false

    true
end matches_at

/** The naive scan, kept because it is the faster answer on a short haystack and because it is what
 * the differential test compares the fast one against.
 *
 * **Its inner loop is written out rather than calling `matches_at`, and that is a measurement rather
 * than a preference.** Routing it through the shared helper cost a 64-byte haystack with an absent
 * needle **three times** what the trait's old inlined loop did -- one call per window, where the
 * loop below stops at the first byte that differs and never leaves the frame. That regression is
 * invisible on a long haystack, which is the one the fast path handles, so it was found only by
 * timing the case this function exists to serve.
 */
private naive_from(h: []const u8, n: []const u8, from: usize) -> Option[usize]
    val last = h.len - n.len
    var i = from

    while i <= last
        var j: usize = 0

        while j < n.len && h[i + j] == n[j]
            j += 1

        if j == n.len then return Some(i)

        i += 1

    None
end naive_from

/** Horspool's own loop, over a table somebody else built -- which is what lets `count_bytes` build
 * one table for a walk of every occurrence rather than one per occurrence.
 */
private scan_from(h: []const u8, n: []const u8, from: usize, t: []const u8) -> Option[usize]
    val m = n.len
    val tail = n[m - 1]
    val last = h.len - m
    var i = from

    while i <= last
        // The byte under the needle's last position decides both questions, so it is read once: it
        // is the comparison that fails in the overwhelming majority of windows, and it is the index
        // into the shift table. Testing it here rather than leaving it to `matches_at` is what keeps
        // an ordinary window down to a load, a compare and a table read.
        val c = h[i + m - 1]

        if c == tail && matches_at(h, n, i) then return Some(i)

        i += usize(t[usize(c)])

    None
end scan_from

private find_byte_from(h: []const u8, b: u8, from: usize) -> Option[usize]
    var i = from

    while i < h.len
        if h[i] == b then return Some(i)

        i += 1

    None
end find_byte_from

private rfind_byte_from(h: []const u8, b: u8, from: usize) -> Option[usize]
    var i = h.len

    while i > from
        i -= 1

        if h[i] == b then return Some(i)

    None
end rfind_byte_from

/** The first occurrence at or after `from`, which every forward member above is.
 *
 * The three answers before any searching happens are the conventions rather than optimizations: an
 * empty needle occurs at `from` wherever `from` is a position, a `from` past the end is not a
 * position and answers `None`, and a needle longer than what is left cannot be there.
 */
private find_from(h: []const u8, n: []const u8, from: usize) -> Option[usize]
    if from > h.len then return None
    if n.len == 0 then return Some(from)
    if n.len > h.len - from then return None
    if n.len == 1 then return find_byte_from(h, n[0], from)
    if h.len - from < sublinear_floor then return naive_from(h, n, from)

    var t: [256]u8

    horspool_table(t, n)
    scan_from(h, n, from, t)
end find_from

/** The last occurrence at or after `from`. The empty needle is at the end, which is `last_index_of`'s
 * own convention read through the suffix rule: the last place it occurs in `h[from..]` is `h.len`.
 */
private rfind_from(h: []const u8, n: []const u8, from: usize) -> Option[usize]
    if from > h.len then return None
    if n.len == 0 then return Some(h.len)
    if n.len > h.len - from then return None
    if n.len == 1 then return rfind_byte_from(h, n[0], from)

    var i = h.len - n.len

    // The naive walk downwards, with its own inlined comparison for the reason `naive_from` gives.
    if h.len - from < sublinear_floor
        val first = n[0]

        loop
            if h[i] == first && matches_at(h, n, i) then return Some(i)
            if i == from then break

            i -= 1

        return None

    var t: [256]u8

    horspool_table_rev(t, n)

    val head = n[0]

    loop
        // The mirror of the forward loop: the byte under the needle's first position is both the
        // cheap rejection and the table index, and is read once for the two of them.
        val c = h[i]

        if c == head && matches_at(h, n, i) then return Some(i)

        val step = usize(t[usize(c)])

        if i < from + step then break

        i -= step

    None
end rfind_from

/** How many non-overlapping occurrences, over one table.
 *
 * The walk is `i = k + n.len` after a hit rather than `k + 1`, which is what "non-overlapping"
 * means and what makes this agree with `replace_all` -- the claim `count_of`'s own comment makes.
 */
private count_bytes(h: []const u8, n: []const u8) -> usize
    val m = n.len

    if m == 0 then return 0
    if m > h.len then return 0

    val fast = m > 1 && h.len >= sublinear_floor
    var t: [256]u8

    if fast then horspool_table(t, n)

    var found: usize = 0
    var i: usize = 0

    while i + m <= h.len
        val hit = if fast then scan_from(h, n, i, t) else naive_from(h, n, i)

        hit match
            Some(k) ->
                found += 1
                i = k + m
            None -> break

    found
end count_bytes
