module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// Statements and declarations.
//
// **A declaration is a statement**, which is what lets a function be declared inside a function and
// a `struct` stand at the top level of a file beside a `print`. The tree makes no distinction the
// grammar does not.

// A statement, with where it was written.
struct Stmt
    span: Span
    kind: &StmtKind
end Stmt

// What a statement is.
//
// **The five biggest declarations carry a struct rather than a long variant.** `FuncDecl` alone has
// twenty-two fields, and a variant with twenty-two positional arguments is a form nobody can read at
// a construction site; the struct is named for the node and the variant holds one of it.
// How many copies of a module binding the program has, and who reaches them: one, one per thread
// (`@thread_local`), one per processor core (`@per_cpu`) -- or one that only the program's main
// thread reaches (`@main_thread`), which is a promise about who reads it rather than a second copy.
enum Copies
    OneCopy
    CopyPerThread
    CopyPerCpu
    MainThreadOnly

// Which ways out of its block a deferred statement runs on: every one (`defer`), or only the
// function failing (`errdefer`), with the name the failure is bound to where one was written.
enum DeferWhen
    EveryExit
    FailureExit(binder: Option[string])

enum StmtKind
    // `import a.b.{c, d as e}`, `import a.b.*`, `import a.b as c`.
    ImportDecl(decl: ImportDecl)

    // `var name: T = init`. `copies` is `@thread_local` or `@per_cpu` -- one copy of this storage per
    // thread or per processor core rather than one for the program, the third fact about where the
    // storage lives beside the boundary and the section. `export` is `@export` -- the C symbol the
    // storage is published under, which only module storage can carry.
    VarDecl(name: string, typ: Option[TypeRef], init: Option[Expr], vis: Visibility,
            align: Option[Expr], section: Option[string], copies: Copies,
            export: Option[ExportAttr])

    // `const NAME: T = value` -- settled while compiling. The type may be left to the value, as a
    // `val`'s may.
    ConstDecl(name: string, typ: Option[TypeRef], value: Expr, vis: Visibility)

    // `cconst` with an indented block: constants whose values are read out of C.
    CConstBlock(consts: Buf[CConstDecl])

    // `ctype` with an indented block: types whose layout is read out of C.
    CTypeBlock(types: Buf[CTypeDecl])

    // `@assert(cond)` standing on its own -- a condition settled while compiling. The message is any
    // `string` expression the compiler can compute while compiling, worked out only when the
    // condition comes out false.
    AssertDecl(cond: Expr, message: Option[Expr])

    // `static` in front of a binding: one copy for the program rather than one per call.
    StaticDecl(inner: Stmt)

    // `@thread_local` or `@per_cpu` above a `var` naming several things (a `MultiDecl` or a
    // `PatternDecl`): every name it binds is storage with those copies, as one `var` under it is.
    CopiedDecl(copies: Copies, inner: Stmt)

    // `val name: T = value`. `copies` is `OneCopy`, or `MainThreadOnly` under `@main_thread` -- the
    // two answers a binding that never changes can give.
    ValDecl(name: string, typ: Option[TypeRef], value: Expr, vis: Visibility,
            align: Option[Expr], section: Option[string], copies: Copies,
            export: Option[ExportAttr])

    // `ref name = place` -- another name for storage that already exists.
    RefDecl(name: string, place: Expr)

    // `a, b = f()` -- assignment to several places at once.
    MultiAssign(op: string, targets: Buf[Expr], values: Buf[Expr])

    // `val a, b = f()` -- several names bound at once. `vis` is what a module-level one says of every
    // name it binds; a local's is never read.
    MultiDecl(names: Buf[string], mutable: bool, values: Buf[Expr], vis: Visibility)

    // `val Point(x, y) = p` -- a binding whose left side is a pattern, and `val (a, b): (u64, u64) = t`
    // one that also states the type of the whole value it takes apart. `vis` is as `MultiDecl`'s.
    PatternDecl(pat: Pattern, mutable: bool, value: Expr, typ: Option[TypeRef], vis: Visibility)

    // An expression written for its effect, or as a block's trailing value.
    ExprStmt(inner: Expr)

    Return(value: Option[Expr])

    // `become f(x)` -- a tail call that must be one.
    Become(call: Expr)

    Break(label: Option[string], value: Option[Expr])
    Continue(label: Option[string])

    // `defer stmt` -- run when the scope leaves, however it leaves -- and `errdefer stmt` /
    // `errdefer e -> stmt`, run only when it leaves because the function is failing.
    Defer(inner: Stmt, when: DeferWhen)

    // The three contract clauses, each a condition and the message a failure carries.
    Require(cond: Expr, msg: Option[string])
    Ensure(cond: Expr, msg: Option[string])
    Invariant(cond: Expr, msg: Option[string])

    // `variant e` -- a loop's decreasing measure, which is what says it terminates.
    Variant(measure: Expr)

    // `asm` with a block per architecture.
    AsmStmt(arms: Buf[AsmArm])

    // `asm` at the top of a file -- instructions the assembler lays down on their own, outside every
    // function, optionally placed by `@section("...")` and started on an `@align(n)` boundary.
    // Written inside a function, only the annotated form arrives here, and it is refused there.
    ModuleAsm(arms: Buf[AsmArm], section: Option[string], align: Option[Expr])

    FuncDecl(decl: FuncDecl)
    ExternDecl(decl: ExternDecl)

    // `extern var errno: int`, with the capabilities a `@needs(...)` above it says reaching it
    // requires -- held to them at every read, write and address taken, as a call of an `extern`
    // function is.
    ExternVarDecl(name: string, typ: TypeRef, link: Option[string], vis: Visibility,
                  needs: Buf[string])

    StructDecl(decl: StructDecl)
    EnumDecl(decl: EnumDecl)
    TraitDecl(decl: TraitDecl)
    ImplDecl(decl: ImplDecl)

    // `type Name = Base`, and the constrained forms that add a range or a predicate.
    TypeDecl(decl: TypeDecl)

    // A statement that would not parse.
    //
    // **Recovery keeps the shape and drops the line**, so a file with one bad statement still hands
    // an editor the ones around it. Nothing that compiles holds one.
    Bad
end StmtKind

// One name taken out of an import: `c`, or `c as d`.
struct ImportSelector
    span: Span
    name: string
    alias: Option[string]
end ImportSelector

// The whole of an import.
struct ImportDecl
    // The dotted module path, split.
    path: Buf[string]

    // The names taken out of it in braces, empty where none were.
    selectors: Buf[ImportSelector]

    // Whether it ended in `.*`.
    wildcard: bool

    // The name the module itself is bound under, where `as` renamed it.
    alias: Option[string]
end ImportDecl

// One constant whose value comes from C.
struct CConstDecl
    span: Span
    name: string
    typ: TypeRef
    c: string
    vis: Visibility
end CConstDecl

// One type whose layout comes from C.
struct CTypeDecl
    span: Span
    name: string
    c: string
    vis: Visibility
end CTypeDecl

// One architecture's arm of an `asm` statement.
struct AsmArm
    span: Span
    archs: Buf[string]
    body: AsmBody
end AsmArm

// What an `asm` arm holds: instructions, or a reason there are none for this architecture.
enum AsmBody
    AsmCode(lines: Buf[string], operands: Buf[AsmOperand], clobbers: Buf[string])
    AsmUnavailable(reason: string)
end AsmBody

// Which way an operand travels.
enum AsmDir
    In
    Out
end AsmDir

// One `in`/`out` operand of an inline-assembly block.
struct AsmOperand
    span: Span
    dir: AsmDir
    name: string
    reg: Option[string]
end AsmOperand

// One line of an `asm` block as it was read, before the three kinds are separated.
enum AsmItem
    Line(text: string)
    Operand(operand: AsmOperand)
    Clobber(regs: Buf[string])
end AsmItem

// How a method takes its receiver.
enum RecvMode
    // `self`
    ByValue

    // `*self`
    ByPtr

    // `&self`, `&sync self`
    ByRef(sync: bool)
end RecvMode

// `@noinline`, `@inline` and `@cold` -- what the optimizer is told about a definition
// (`reference/attributes.md § @noinline, @inline and @cold`). Each lowers to one of LLVM's bare
// function attributes on the `define` line and reaches nothing else.
//
// **Two of the three are one axis and the third is another.** `noinline` forbids inlining and
// `inline` asks for it (LLVM's `inlinehint`, a raised budget rather than an instruction), so the
// pair is refused where it is written; `cold` states a frequency and composes with either. They
// belong to the **declaration**, so every instantiation of a generic carries them.
//
// `inline_always` is `@inline(always)`: the request made an instruction (LLVM's `alwaysinline`,
// which the always-inliner honours at every optimization level, `-O0` included). It sets `inline`
// too, so everything that copies a hinted body to where its callers are -- a precompiled package's
// `available_externally` copy, a codegen unit's -- copies this one; only the word on the `define`
// line differs.
//
// `async_at` rides here too, being said of the declaration and carried to every lowered copy of it
// the same way: where the `async` word was written, or nothing. It is not one of the optimizer's
// three, so `any` does not count it. An async function's written result has already been made
// `Task[T]` by the parser (`async_result`), so every caller reads the task; only its own body reads
// the `T` (`body_result`).
//
// `forgoes` rides here for the same reason: `@no_alloc` above a function or a method is said of the
// declaration, and every lowered copy of it -- a member's free function, a generic's body -- has to
// carry the promise to where the whole-program check reads it. It holds the word after `no_`
// (`"alloc"`), one entry per capability the definition gives up, and is not one of the optimizer's
// three either.
//
// `blocks` is `@blocks`, the other side of `@no_block`: this definition may wait -- sleep, take a
// lock, read a device -- so every promise not to block is refused a way here (`no_block.sysl`).
//
// `domain` is `@domain(...)`: the concurrency domain the function is entered in, where that is not
// the program's own -- `interrupt` for a handler a vector table written in assembly calls. It changes
// nothing about how the function is called; it makes the function a root of that domain for every
// check that asks what crosses one (`sharing.sysl`'s `domain_roots`).
struct FuncMarks
    noinline: bool
    cold: bool
    inline: bool
    async_at: Option[Span]
    forgoes: Buf[string]
    blocks: bool
    domain: Option[string]

    // `@pinned` and `@pins` (`reference/attributes.md § @per_cpu`): the body runs where the core
    // cannot change under it -- because every caller already holds it there, or because the body
    // itself masks what could move it before it reaches `@per_cpu` storage. Neither reaches the
    // `define` line; `pinning.sysl` reads them.
    pinned: bool
    pins: bool

    // `@lends(body)`: the callable parameters each pointer this function hands is valid only during
    // that call, so a body passed there is held to letting every one of them go
    // (`lends.sysl`). Carried to every instantiation, where the check reads it.
    lends: Buf[string]

    // `@abandons`: a call to this function never comes back, and the program goes on without the
    // frames below it (`reference/declarations.md § @abandons — a call that leaves its caller`). It rides here
    // rather than on the declaration alone because the emitter asks it of every lowered copy.
    abandons: bool

    // `@relocates` above a member: a call may move the storage its receiver's elements live in --
    // `Buf.push` growing -- so a live `ref` standing on an element of that receiver is refused the
    // call (`place.sysl`'s `check_ref_call`), whatever mode the receiver is taken in.
    relocates: bool

    // `@views(self)` above a member: the view it answers is borrowed from its receiver, so the view
    // may not be used once the receiver can have been freed (`view_borrow.sysl`).
    views: bool

    // `@consumes` above a member: a call takes what its receiver holds, so a local it was called on
    // may not be read again until it is assigned a new value (`consumes.sysl`).
    consumes: bool

    // `@export(..., weak)`: the exported entry is a weak definition, the default a strong definition
    // of the same symbol anywhere in the link replaces (`emit_export.sysl`'s `export_linkage`).
    weak_export: bool

    // `@inline(always)`; `inline` is set beside it.
    inline_always: bool

    // `@disjoint(a, b)`: the parameters whose memory nothing else reaches while a call runs, so the
    // back end may say `noalias` of them (`disjoint.sysl`, `emit_disjoint.sysl`). Carried to every
    // lowered copy -- a member's free function, each instantiation of a generic -- where both the
    // check at the call and the emission read it.
    disjoint: Buf[string]

    // A method an `impl` of one of the arithmetic operator traits supplied -- `Add`, `Sub`, `Mul`,
    // `Div`, `Neg` -- which nothing in the source writes: the block's trait says so. A call of one
    // whose body is one expression is read as that expression, for contraction
    // (`fp_operators.sysl`). Carried to every instantiation, where the lowering and the evaluator
    // read it.
    operator: bool

    // `@scoped(f)` above a member: the callable parameters the member runs in another concurrency
    // domain and finishes before the `@lends` call that lent its `*self` receiver returns
    // (`docs/design/scope.md`). Each is also crossing (`@crossing(f)`, which the parser adds beside
    // it); the lent rule reads the rest (`lends.sysl`): a call of the member keeps neither its receiver
    // nor what it is handed there. Carried to every instantiation.
    scoped: Buf[string]

    // Whether any of the three was written.
    any(self) -> bool = self.noinline || self.cold || self.inline

    is_async(self) -> bool = self.async_at.is_some()

    // Whether this definition gave up the capability written `@no_<cap>` above it.
    gives_up(self, cap: string) -> bool
        for item in self.forgoes
            if item == cap then return true

        false
    end gives_up
end FuncMarks

// A definition nothing was said about.
no_marks() -> FuncMarks = FuncMarks(false, false, false, None, buf(), false, None, false, false, buf(),
                                    false, false, false, false, false, false, buf(), false, buf())

// A method of a struct, an enum, a trait or an `impl` block.
struct MethodDecl
    span: Span
    name: string
    receiver: Option[RecvMode]
    is_property: bool
    tparams: Buf[string]
    params: Buf[Param]
    ret_type: Option[TypeRef]
    body: Buf[Stmt]
    bounds: Buf[NamedBounds]
    tdefaults: Buf[TypeBinding]
    vis: Visibility
    variadic: bool
    overrides: bool
    tvalues: Buf[TypeBinding]
    tpacks: Buf[string]
    crossing: Buf[string]
    reads: Option[Buf[string]]
    writes: Option[Buf[string]]
    borrows: Buf[string]
    is_static: bool
    // `@noinline`, `@cold`, `@inline` -- about the function the member lowers to, so they travel
    // to the lowered declaration unchanged.
    marks: FuncMarks
    // Where the member's own words start -- its name, past any `private` or `override` in front,
    // which `span` includes. A diagnostic about the member as a whole is anchored here.
    named_at: Span
    // `const` in front of the member: it may run while the program is being compiled, so its body
    // is held to what the compiler can run (`const_check.sysl`).
    const_fn: bool

    // A property with no written receiver takes one by value, which is what makes `x.area` reach a
    // method the way a field reads.
    recv_mode(self) -> Option[RecvMode] = self.receiver match
        Some(m) -> Some(m)
        None -> if self.is_property && !self.is_static then Some(ByValue) else None

    is_associated(self) -> bool = self.recv_mode().is_none()
end MethodDecl

// `@convention(c)` -- how a function is called.
struct CallConv
    span: Span
    name: string
    arg: Option[string]
end CallConv

// A function declaration.
struct FuncDecl
    name: string
    tparams: Buf[string]
    params: Buf[Param]
    ret_type: Option[TypeRef]
    body: Buf[Stmt]
    bounds: Buf[NamedBounds]
    variadic: bool
    vis: Visibility
    tdefaults: Buf[TypeBinding]
    tvalues: Buf[TypeBinding]
    tpacks: Buf[string]
    test: Option[TestAttr]
    hook: Option[HookAttr]
    conv: Option[CallConv]
    tailrec: bool
    pure: bool
    ghost: bool
    reads: Option[Buf[string]]
    writes: Option[Buf[string]]
    exported: Option[ExportAttr]
    section: Option[string]
    crossing: Buf[string]
    needs: Buf[string]
    marks: FuncMarks
    // Where the declaration was written -- the function's own line, or a member's. A diagnostic
    // about the declaration as a whole (a contract clause that is not a `bool`) is anchored here
    // wherever the body is read, including an instantiation and the walk over a generic body.
    // A function the compiler made up carries an empty span.
    at: Span
    // `const f(...)`: the function may run while the program is being compiled, so its body is held
    // to what the compiler can run (`const_check.sysl`). It is still an ordinary function wherever
    // it is called at run time.
    const_fn: bool
end FuncDecl

// `@export` -- the symbol a function is visible under from C, and whether it is published `weak`: a
// default any strong definition of the same symbol in the link replaces (`@export("write", weak)`).
struct ExportAttr
    span: Span
    symbol: Option[string]
    weakly: bool
end ExportAttr

// `@test`, with the name a report shows and what the run is expected to do.
struct TestAttr
    span: Span
    display: Option[string]
    should_trap: bool
    expected: Option[string]
    // Why the test is compiled and not run — `@test(ignore: "…")`. Required to say something, since
    // an ignored test nobody can say why is how one comes to be forgotten.
    ignored: Option[string]
    // How many seconds the test's run may take — `@test(timeout: 30)` — in place of the run's own
    // limit; zero is no limit at all. Absent where the annotation did not say.
    timeout: Option[int]
end TestAttr

// Which of the four test hooks an attribute names.
enum HookKind
    Setup
    Teardown
    SetupAll
    TeardownAll
end HookKind

// The word each hook is written as.
hook_word(k: HookKind) -> string = k match
    Setup -> "setup"
    Teardown -> "teardown"
    SetupAll -> "setup_all"
    TeardownAll -> "teardown_all"

struct HookAttr
    span: Span
    kind: HookKind
end HookAttr

// An attribute as written, before it is folded into the declaration under it.
enum Attr
    Test(attr: TestAttr)
    Hook(attr: HookAttr)
    TailRec
    Pure
    Ghost
    Reads(names: Buf[string])
    Writes(names: Buf[string])
    Packed
    Align(bound: Expr)
    ByteOrder(big: bool)
    Export(attr: ExportAttr)
    Section(name: string)
    Crossing(names: Buf[string])
    Domain(name: string)
    Borrows(names: Buf[string])
    Lends(names: Buf[string])
    // `@scoped(f)` above a member: `f` runs in another domain and finishes before the `@lends` call
    // that lent the receiver returns.
    Scoped(names: Buf[string])
    // `@guards(field)` above a struct: the field is reached only through the struct's own members,
    // so what it holds is not shared by sharing the struct.
    Guards(names: Buf[string])
    Needs(caps: Buf[string])
    NoInline
    // `@inline`, or `@inline(always)` where `always` is set.
    Inline(always: bool)
    Cold
    ThreadLocal
    Abandons
    PerCpu
    // `@main_thread` above module storage: only the program's main thread reaches it.
    MainThread
    Pinned
    Pins
    // `@no_alloc` above a function or a method: the capability it gives up, as the word after `no_`.
    Forgoes(cap: string)
    // `@blocks` above a function, a method or an `extern`: reaching it may wait.
    Blocks
    // `@relocates` above a member: a call may move the storage its receiver's elements live in.
    Relocates
    // `@views(self)` above a member: the view it answers is borrowed from its receiver.
    Views(names: Buf[string])
    // `@consumes` above a member: a call takes what its receiver holds.
    Consumes
    // `@disjoint(a, b)` above a function or a member: no memory reached through one named parameter
    // is reached any other way while the call runs.
    Disjoint(names: Buf[string])
    // `@annotation` above a struct: the struct is an annotation a program writes as `@Name(...)`.
    AnnotationMark
    // `@rename("id")` above a type: an annotation the program declared, not one of the language's.
    User(use: AnnotUse)
end Attr

// One use of an annotation a program declared -- `@rename("id")` or `@marker` -- on a field, a variant
// or a type. `call` is the construction it stands for, `rename("id")`, and a bare `@marker` is the
// construction with no arguments; `parens` says whether parentheses were written. `target` is the
// field's or the variant's name, or empty for the type declaration itself.
struct AnnotUse
    span: Span
    target: string
    call: Expr
    parens: bool
end AnnotUse

// The name an annotation's use was written with, dotted where it was qualified.
annot_written(u: AnnotUse) -> string = *u.call.kind match
    Call(callee, _) -> annot_path(callee)
    _ -> ""

private annot_path(e: Expr) -> string = *e.kind match
    Ident(n) -> n
    Field(receiver, n, _) ->
        val head = annot_path(receiver)

        if head == "" then "" else s"$head.$n"
    _ -> ""

// The word an attribute is written as, which is what a complaint about it names.
attr_word(a: Attr) -> string = a match
    Test(_) -> "test"
    Hook(h) -> hook_word(h.kind)
    TailRec -> "tailrec"
    Pure -> "pure"
    Ghost -> "ghost"
    Reads(_) -> "reads"
    Writes(_) -> "writes"
    Packed -> "packed"
    Align(_) -> "align"
    ByteOrder(_) -> "byte_order"
    Export(_) -> "export"
    Section(_) -> "section"
    Crossing(_) -> "crossing"
    Domain(_) -> "domain"
    Borrows(_) -> "borrows"
    Lends(_) -> "lends"
    Scoped(_) -> "scoped"
    Guards(_) -> "guards"
    Needs(_) -> "needs"
    NoInline -> "noinline"
    Inline(always) -> if always then "inline(always)" else "inline"
    Cold -> "cold"
    ThreadLocal -> "thread_local"
    Abandons -> "abandons"
    PerCpu -> "per_cpu"
    MainThread -> "main_thread"
    Pinned -> "pinned"
    Pins -> "pins"
    Forgoes(cap) -> s"no_$cap"
    Blocks -> "blocks"
    Relocates -> "relocates"
    Views(_) -> "views"
    Consumes -> "consumes"
    Disjoint(_) -> "disjoint"
    AnnotationMark -> "annotation"
    User(u) -> annot_written(u)

// A foreign function's declaration.
struct ExternDecl
    name: string
    params: Buf[Param]
    ret_type: Option[TypeRef]
    variadic: bool
    link: Option[string]
    vis: Visibility
    needs: Buf[string]
    // `@blocks` above it: the C function may wait, so a promise not to block may not reach it.
    blocks: bool
    // `@abandons` above it: a call never comes back, and the caller's frame is given back first.
    abandons: bool
end ExternDecl

// A struct declaration: its fields, the methods written under it, and what the attributes said.
struct StructDecl
    name: string
    tparams: Buf[string]
    fields: Buf[Param]
    members: Buf[MethodDecl]
    bounds: Buf[NamedBounds]
    invariants: Buf[Expr]
    vis: Visibility
    tdefaults: Buf[TypeBinding]
    opaque: bool
    tvalues: Buf[TypeBinding]
    packed: bool
    alignment: Option[Expr]
    cname: Option[ExportAttr]
    deriving: Buf[BoundRef]
    byte_order: Option[bool]
    guards: Buf[string]

    // `@pinned`: C holds pointers into a value of it, so a value is never copied or moved once it is
    // built (`pinned.sysl`).
    pinned: bool

    // Declared `union` rather than `struct`: the fields share their storage (`union_fields.sysl`).
    union_layout: bool

    // The anonymous `union`/`struct` members written in the body (C11). Each is a declaration of its
    // own, named `<Outer>#<n>` -- a name no program can write -- and held by a field named `#<n>`
    // whose fields are reached as the outer type's (`anonymous.sysl`).
    anon: Buf[StructDecl]

    // The fields written `name: T in S`: C bitfields, each allocated in a unit of its declared type
    // `S` by the target's C rule (`c_bitfields.sysl`).
    bits: Buf[BitInDecl]

    // `@annotation` above it: the struct is an annotation, written `@Name(...)` on a field, a
    // variant or a type (`annotations.sysl`).
    annotation: bool

    // The annotations the program declared that are written on it and on its fields.
    annots: Buf[AnnotUse]
end StructDecl

// What `in S` adds to the field at `field` (its position in `fields`): the type C declares it with,
// which is the unit it is allocated in. `zero` is `_: in S`, C's `S : 0`, which holds nothing and
// only moves the next field.
struct BitInDecl
    span: Span
    field: usize
    storage: TypeRef
    zero: bool
end BitInDecl

// One variant of an enum: its name, the value it pins where the enum has an underlying integer, and
// the fields it carries where it is a sum.
struct EnumVariantDecl
    span: Span
    name: string
    value: Option[Expr]
    fields: Buf[Param]
end EnumVariantDecl

struct EnumDecl
    name: string
    tparams: Buf[string]
    underlying: Option[TypeRef]
    variants: Buf[EnumVariantDecl]
    members: Buf[MethodDecl]
    bounds: Buf[NamedBounds]
    vis: Visibility
    tdefaults: Buf[TypeBinding]
    tvalues: Buf[TypeBinding]
    deriving: Buf[BoundRef]

    // The annotations the program declared that are written on it and on its variants.
    annots: Buf[AnnotUse]
end EnumDecl

// `new 1..100` on a constrained type -- the range its values must lie in.
struct RangeBound
    span: Span
    lo: Expr
    hi: Expr
    exclusive_hi: bool
end RangeBound

// `type Name = Base`, and the constrained forms. `derived` is the `new` that makes the name a type
// of its own rather than another spelling of its base. `cname` is `@export` written above it: the
// name a generated C header gives the type in a `typedef`. `wrapping` is where the word was written
// in `type Acc = new i64q61 wrapping`: a fixed-point type whose arithmetic wraps rather than
// saturates. `tp` is the bracketed parameter list a generic alias takes -- `type Pair[A, B] = (A, B)`
// -- and is empty for every other declaration. `members` is the body indented under a `new` type,
// which declares its methods as a struct's body does; every other declaration has none. `annots` are
// the program's annotations written above a declaration that makes a type of its own (`new`, a range,
// a `where`, `wrapping`); a plain alias is refused one, being no type of its own to carry it.
struct TypeDecl
    name: string
    base: TypeRef
    derived: bool
    range: Option[RangeBound]
    pred: Option[Expr]
    vis: Visibility
    from_c: bool
    cname: Option[ExportAttr]
    wrapping: Option[Span]
    tp: TypeParams
    members: Buf[MethodDecl]
    annots: Buf[AnnotUse]
end TypeDecl

// One associated type a trait requires: `type Item: Display`.
struct AssocDecl
    span: Span
    name: string
    bounds: Buf[BoundRef]
end AssocDecl

// One associated type an `impl` block supplies: `type Item = int`.
struct AssocBind
    span: Span
    name: string
    typ: TypeRef
end AssocBind

// `derive[T] encode(self: T, w: *Writer)` -- the body a trait supplies for one of its members to a
// type that names the trait in its `derives` clause. It is a template, not a default: a block written
// by hand never inherits it. `member` is the member as an `impl` would have written it, its receiver
// taken from `self: T`; `param` is the name the body calls the deriving type by.
struct DeriveDecl
    param: string
    member: MethodDecl
end DeriveDecl

struct TraitDecl
    name: string
    tparams: Buf[string]
    methods: Buf[MethodDecl]
    bounds: Buf[NamedBounds]
    supers: Buf[BoundRef]
    vis: Visibility
    tdefaults: Buf[TypeBinding]
    assocs: Buf[AssocDecl]
    tvalues: Buf[TypeBinding]
    derives: Buf[DeriveDecl]
end TraitDecl

struct ImplDecl
    trait_name: string
    for_type: TypeRef
    methods: Buf[MethodDecl]
    tparams: Buf[string]
    bounds: Buf[NamedBounds]
    trait_args: Buf[TypeRef]
    tdefaults: Buf[TypeBinding]
    overrides: bool
    tvalues: Buf[TypeBinding]
    tpacks: Buf[string]
    assocs: Buf[AssocBind]
    // Written by a `derives` clause, or as the `Debug` every type is given, rather than by hand: its
    // members are the trait's `derive` bodies (`derive_members.sysl`, `hoist_impl.sysl`).
    derived: bool
end ImplDecl

stmt(span: Span, kind: StmtKind) -> Stmt = Stmt(span, kind)
