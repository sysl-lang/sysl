module sysl.softint

// 64-bit division on a 32-bit machine: the routines LLVM calls where a `long` is divided on a
// processor whose registers are 32 bits -- every Cortex-M, which has a 32-bit divider at best, and
// 32-bit RISC-V. Rendering a `long` divides by ten, so a program that prints one, or reaches a
// `panic` that does, needs them.
//
// **They are compiler-rt's names and compiler-rt's contracts**: `__aeabi_uldivmod` and
// `__aeabi_ldivmod` on Arm, `__udivdi3`, `__divdi3`, `__umoddi3` and `__moddi3` on RISC-V, and
// `__udivmoddi4` and `__divmoddi4`, which the others are written on, on both. A freestanding image has
// no runtime library to find them in, so the standard module carries them, as `sysl.softfloat` does
// the floating-point routines. Every one is exported WEAK: a libgcc or a program that defines the
// symbol too wins, and two correct answers never collide.
//
// **Nothing here divides, and nothing shifts a 64-bit value by a variable amount**: an Armv6-M core
// has neither instruction, and either one would be a call back into a runtime -- the first into this
// one. A shift by a constant and a 64-bit compare and subtract are instructions everywhere.
//
// The arithmetic has no `#if`, so the host checks it against its own divider; only the exports are
// per machine.

private const ALL_ONES: u64 = 0xFFFF_FFFF_FFFF_FFFF

/** The quotient and the remainder of `n / d`, the remainder below `d`. A zero divisor answers every
 * bit of the quotient set and `n` as the remainder -- which is what the long division falls into; a
 * sysl division checks its divisor before it gets here. */
private[softint] unsigned_divide(n_in: u64, d: u64) -> (u64, u64)
    if d == 0 then return (ALL_ONES, n_in)

    // Shift-and-subtract, one quotient bit a step, most significant first. `carry` is the bit the
    // partial remainder shifted out of its top: where it is set the remainder is at least 2^64,
    // which is above any divisor, and the subtraction's wraparound is the right answer.
    var n = n_in
    var q: u64 = 0
    var r: u64 = 0

    for step in 0..<64
        val carry = r >> 63

        r = (r << 1) | (n >> 63)
        n = n << 1
        q = q << 1

        if carry != 0 || r >= d
            r -= d
            q = q | 1

    (q, r)
end unsigned_divide

/** The quotient and the remainder of `n / d` rounded toward zero, as both machines round: the
 * remainder takes the sign of `n`. The magnitudes are taken unsigned, which is what makes the most
 * negative value work. */
private[softint] signed_divide(n: i64, d: i64) -> (i64, i64)
    val (q, r) = unsigned_divide(magnitude(n), magnitude(d))

    (with_sign(q, (n < 0) != (d < 0)), with_sign(r, n < 0))

// The magnitude of a signed value, the most negative one included.
private magnitude(x: i64) -> u64 = if x >= 0 then u64(x) else u64(-(x + 1)) + 1

// A magnitude given a sign. 2^63 is the one magnitude with no positive value; it is the most negative
// one either way, which is what the most negative value divided by -1 wraps to on every divider.
private with_sign(m: u64, negative: bool) -> i64
    if m > 0x7FFF_FFFF_FFFF_FFFF then return -0x7FFF_FFFF_FFFF_FFFF - 1

    if negative then -i64(m) else i64(m)

#if thumb || riscv32

/** The quotient of `n / d`, its remainder written through `rem`. */
@export("__udivmoddi4")
udivmoddi4(n: ulong, d: ulong, rem: *ulong) -> ulong
    val (q, r) = unsigned_divide(n, d)

    *rem = r
    q

/** The quotient of `n / d` toward zero, its remainder written through `rem`. */
@export("__divmoddi4")
divmoddi4(n: long, d: long, rem: *long) -> long
    val (q, r) = signed_divide(n, d)

    *rem = r
    q

#endif

#if riscv32

/** `n / d`. */
@export("__udivdi3")
udivdi3(n: ulong, d: ulong) -> ulong = unsigned_divide(n, d).0

/** `n % d`. */
@export("__umoddi3")
umoddi3(n: ulong, d: ulong) -> ulong = unsigned_divide(n, d).1

/** `n / d`, toward zero. */
@export("__divdi3")
divdi3(n: long, d: long) -> long = signed_divide(n, d).0

/** `n % d`, the sign of `n`. */
@export("__moddi3")
moddi3(n: long, d: long) -> long = signed_divide(n, d).1

#endif

#if thumb

// **Arm's two answer in four registers** -- the quotient in r0:r1 and the remainder in r2:r3 --
// which no sysl signature can say, so each is a few instructions around the routine above: room for
// the remainder on the stack, its address as the fifth argument, the call, and the remainder loaded
// into r2:r3 behind the quotient the call left in r0:r1. Every instruction is Armv6-M's too. The
// block is laid down where this module's routines are kept and nowhere else.
@section(".text.__aeabi_uldivmod")
asm
    [thumb]
        ".weak __aeabi_uldivmod"
        ".type __aeabi_uldivmod, %function"
        ".p2align 2"
        ".thumb_func"
        "__aeabi_uldivmod:"
        "push {{r6, lr}}"
        "sub sp, #16"
        "add r6, sp, #8"
        "str r6, [sp]"
        "bl __udivmoddi4"
        "ldr r2, [sp, #8]"
        "ldr r3, [sp, #12]"
        "add sp, #16"
        "pop {{r6, pc}}"
        ".size __aeabi_uldivmod, . - __aeabi_uldivmod"
    [x86_64, aarch64, riscv64, riscv32, craft, wasm32] unavailable "the Arm run-time ABI's division"

@section(".text.__aeabi_ldivmod")
asm
    [thumb]
        ".weak __aeabi_ldivmod"
        ".type __aeabi_ldivmod, %function"
        ".p2align 2"
        ".thumb_func"
        "__aeabi_ldivmod:"
        "push {{r6, lr}}"
        "sub sp, #16"
        "add r6, sp, #8"
        "str r6, [sp]"
        "bl __divmoddi4"
        "ldr r2, [sp, #8]"
        "ldr r3, [sp, #12]"
        "add sp, #16"
        "pop {{r6, pc}}"
        ".size __aeabi_ldivmod, . - __aeabi_ldivmod"
    [x86_64, aarch64, riscv64, riscv32, craft, wasm32] unavailable "the Arm run-time ABI's division"

#endif
