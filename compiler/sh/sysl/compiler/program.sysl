module sh.sysl.compiler

import sh.sysl.parsing.{Source, Span}
import sysl.buf.{Buf, buf}
import sysl.container.{Set, set}
import sysl.text.Search

// What a whole program is made of, assembled once every body has been typed.
//
// **The typed tree is one function at a time and a program is not**: what a back end is handed is
// the layouts, the tables, the storage, the entry point and the scaffolding a test run needs, and
// every one of those is a question about the compilation rather than about any one body. This is
// where they are answered.

// The entry point a program declared, where it declared one.
//
// **Read after the bodies are typed and before the held ones are**, because the conversion an entry
// wants is a library function: marking one as reached has to happen while there is still a pass that
// will go and analyze it.
declared_entry(a: &Analysis) -> Option[TEntry]
    var found: Option[string] = None

    for i in 0..<a.tables.funcs.len()
        val key = a.tables.funcs.key_at(i)

        if module_bare(key) == "main" && !a.tables.externs.has(key)
            // **A program starts in one place, so it declares one `main`.** The first is the
            // program's and every one after it is told which declaration already holds the name.
            if found.is_none() then found = Some(key)
            else
                val other = a.tables.funcs.get(key).unwrap()

                a.fault(other.scope, other.span, "'main' is where a program starts, so there is " +
                        s"one — ${module_show(found.unwrap())} already declares it")

    if found.is_none() then return None

    val key = found.unwrap()
    val f = a.tables.funcs.get(key).unwrap()
    val ret = if f.decl.ret_type.is_none() then Unit
    else resolve_result(a, f.scope, f.decl.ret_type.unwrap(), no_bindings())

    // **The first of these ends the reading**, because everything after it is a question about a
    // signature the platform has already been told it cannot call.
    if !f.decl.tparams.is_empty()
        a.fault(f.scope, f.span, "'main' is called by the platform, which has no type arguments " +
                "to give it")
        return None
    end if

    // **A `main` either yields nothing or answers with a `Result[unit, E]`**, and the second is what
    // lets `?` reach the top of a program. Nothing else is admitted: an exit status is one byte and
    // a result is a value, so mapping one onto the other is the program's own business -- and the
    // refusal names the answer, since `exit` is how a program chooses its own status.
    // A result read off a body that was itself refused has no type, and the refusal has been told.
    if mentions_unknown(ret) then return None

    val fallible = result_entry(a, ret)

    if fallible.is_none() && !no_value(ret)
        a.fault(f.scope, f.span, "'main' yields nothing or a 'Result[unit, E]', so it may not " +
                s"result in ${type_show(ret)} — a program's exit status is not something a " +
                "signature can say. 'exit(code)' is how a program chooses its own, and prints " +
                "nothing")
        return None
    end if

    if f.decl.variadic
        a.fault(f.scope, f.span, "'main' is called with the arguments the platform has, not a " +
                "list it reads")
        return None
    end if

    val reporter = entry_reporter(a, fallible, f)

    if f.decl.params.is_empty() then return Some(TEntry(key, None, reporter, fallible))

    // The one parameter a platform can fill: the program's arguments, which the library reads.
    // Written either way: the arguments are the platform's and a program that only reads them may
    // say so, since the two views are one layout.
    val first = resolve_type(a, f.scope, f.decl.params.at(0).typ, no_bindings())
    val args_fn = a_library_key(a, "args_of")

    if f.decl.params.len() == 1 && takes_args(first)
        if args_fn.is_none() then return Some(TEntry(key, None, reporter, fallible))

        a.uses(args_fn.unwrap())

        return Some(TEntry(key, args_fn, reporter, fallible))
    end if

    a.fault(f.scope, f.span, "'main' takes either nothing or one '[]string' of the program's " +
            s"arguments, not (${entry_params(a, f)})")

    None
end declared_entry

// What a `main` declares that the platform cannot fill, as the refusal names them.
private entry_params(a: &Analysis, f: Func) -> string
    var out = ""

    for i in 0..<f.decl.params.len()
        val t = resolve_type(a, f.scope, f.decl.params.at(i).typ, no_bindings())

        out = out + (if i > 0 then ", " else "") + type_show(t)

    out
end entry_params

// Whether a parameter is the `[]string` a platform fills with the program's arguments.
private takes_args(t: Type) -> bool = t match
    Slice(elem, _) -> *elem match
        Str -> true
        _ -> false
    _ -> false

// The `Result[unit, E]` a fallible entry answers with, where that is what it answers with.
private result_entry(a: &Analysis, ret: Type) -> Option[Type] = ret match
    Enum(d) ->
        if d.base == library_key("Result") && !d.targs.is_empty() && no_value(d.targs.at(0)) then
            Some(ret)
        else None
    _ -> None

// The library function an entry's failure is reported through, instantiated at what the entry
// carries. It is a function the program never wrote, so reaching it is recorded here.
//
// **Its bound is asked here, at `main`, before anything is instantiated**: the bound is what holds
// the error type to being renderable, and left to the instantiation an error nobody can print is
// refused inside the library's body, in a file the program never wrote.
private entry_reporter(a: &Analysis, fallible: Option[Type], entry: Func) -> Option[string]
    if fallible.is_none() then return None

    val key = a_library_key(a, "main_result")

    if key.is_none() then return None

    fallible.unwrap() match
        Enum(d) ->
            if d.targs.len() < 2 then return None

            val f = a.tables.funcs.get(key.unwrap())

            if f.is_none() then return None

            var targs: Buf[Type] = buf()

            targs.push(d.targs.at(1))

            val decl = f.unwrap().decl

            if !check_param_bounds(a, f.unwrap().scope, entry.span, key.unwrap(), decl.tparams,
                                   decl.bounds, targs, buf(), "type parameter", entry.scope)
                return None

            val sym = instantiate_func(a, f.unwrap().scope, f.unwrap().decl, targs, false)

            a.uses(sym)
            Some(sym)
        _ -> None
end entry_reporter

// **A `@test` may answer with a `Result[unit, E]`**, and an `Err` fails it: the dispatcher hands the
// answer to `sysl.test_result`, which prints the error and its error return trace and exits 1. Read
// where the entry point is, for the same reason -- the reporter is a library function, and reaching
// it has to happen while a pass will still analyze it. Any other result is refused at the attribute
// (`runner_result`). Each is filed in the tables by the test's key, with the result's type, for the
// test dispatcher (`emit_entry.sysl`).
declared_test_reporters(a: &Analysis)
    val reporter = a_library_key(a, "test_result")

    if reporter.is_none() then return

    val r = a.tables.funcs.get(reporter.unwrap())

    if r.is_none() then return

    for i in 0..<a.tables.funcs.len()
        val f = a.tables.funcs.at(i)

        if f.decl.test.is_none() || !f.decl.tparams.is_empty() || f.decl.ret_type.is_none() then continue

        val ret = resolve_result(a, f.scope, f.decl.ret_type.unwrap(), no_bindings())

        result_entry(a, ret) match
            Some(Enum(d)) ->
                if d.targs.len() < 2 then continue

                var targs: Buf[Type] = buf()

                targs.push(d.targs.at(1))

                val sym = instantiate_func(a, r.unwrap().scope, r.unwrap().decl, targs, false)

                a.uses(sym)
                a.tables.test_reporters.put(a.tables.funcs.key_at(i), (sym, ret))
            _ -> ()
end declared_test_reporters

// Whether a test's result is one it may answer with: a `Result[unit, E]`.
test_may_answer(a: &Analysis, ret: Type) -> bool = result_entry(a, ret).is_some()

// The key the library files one of its own names under, looked up rather than composed.
private a_library_key(a: &Analysis, name: string) -> Option[string]
    val direct = module_qualify(StdModule, name)

    if a.tables.funcs.has(direct) then return Some(direct)

    for i in 0..<a.tables.funcs.len()
        val key = a.tables.funcs.key_at(i)
        val bare = library_spelling(key)

        if bare.is_some() && bare.unwrap() == name then return Some(key)

    None
end a_library_key

// Everything one compilation amounts to, once every body it reaches has been typed.
program_of(done: TypedBodies, main_module: string) -> TProgram
    val a = done.an
    val analyzed = analyzed_bodies(done.funcs)
    val hooks = declared_hooks(done, analyzed)

    TProgram(reached_structs(a), reached_enums(a), reached_vtables(a), reached_externs(a),
             done.vals, emitted_funcs(done.funcs), done.main, done.entry, buf(), true, false,
             no_alloc_modules(done.units, false), no_alloc_modules(done.units, true), main_module,
             declared_tests(done, analyzed, hooks), hooks, reached_extern_vars(a),
             a.tables.test_only, destructors_of(a), a.warnings(), a.tables.module_deps,
             entry_source(done), a.tables.module_asm, false, a.tables.target.double_unit(),
             a.tables.target.single_unit(), a.tables.target.divider(), a.tables.test_reporters)
end program_of

// The file the program starts in, which `entry_body` typed the statements of.
private entry_source(done: TypedBodies) -> Option[Source]
    val named = done.an.tables.entry_src

    if named == "" then return None

    for item in done.units
        if item.src.name == named then return Some(item.src)

    None
end entry_source

// Every type this compilation made real that has a destructor, paired with the symbol of it.
//
// **Asked of the INSTANTIATED types rather than of the `impl` blocks**, because a block for a
// generic type is one block covering a family and the hook is a function per concrete payload. A
// type the program never made needs no entry: nothing can release a box of it.
// The types themselves, for a question asked before any lowering: whether a body makes a value whose
// destructor could run before it returns (`borrowing.sysl`'s `untouched_summary`).
dropping_reached(a: &Analysis) -> Buf[Type]
    val keys = destructors_of(a)
    var out: Buf[Type] = buf()

    if keys.is_empty() then return out

    for item in reached_structs(a)
        if has_destructor_key(keys, mangle(item)) then out.push(item)

    for item in reached_enums(a)
        if has_destructor_key(keys, mangle(item)) then out.push(item)

    out
end dropping_reached

private has_destructor_key(keys: Buf[(string, string)], key: string) -> bool
    for item in keys
        if item.0 == key then return true

    false
end has_destructor_key

private destructors_of(a: &Analysis) -> Buf[(string, string)]
    val drops = drops_declared(a)
    var out: Buf[(string, string)] = buf()

    if drops.is_empty() then return out

    val made = reached_structs(a)
    val enums = reached_enums(a)

    for item in made
        push_destructor(a, drops, &out, item)

    for item in enums
        push_destructor(a, drops, &out, item)

    out
end destructors_of

private push_destructor(a: &Analysis, drops: Buf[string], out: *Buf[(string, string)], t: Type)
    val owner = owner_key(t)

    if !holds_string(drops, owner) then return

    // A generic family's destructor is filed per instantiated type (`queue_generic_drops`).
    val made = a.tables.members.generic_drops.get(mangle(t))
    val filed = if made.is_some() then made else a.tables.members.funcs.get(member_key_of(owner, "drop"))

    out.push((mangle(t), filed.unwrap_or(s"${member_symbol(t)}.drop")))
end push_destructor

// The bodies a program **emits**, which is the question a printed tree answers.
//
// An instantiation at a **type parameter** is a diagnostic shape rather than a laid-out one: the
// walk that reads a generic body once at its own definition builds one, and no value at run time has
// that type. It has no layout to emit, so it is left out here rather than reaching a back end that
// would have to invent one.
private emitted_funcs(funcs: Buf[TFunc]) -> Buf[TFunc]
    var out: Buf[TFunc] = buf()

    for i in 0..<funcs.len()
        if emitted_shape(funcs.at(i)) then out.push(funcs.at(i))

    out
end emitted_funcs

private emitted_shape(f: TFunc) -> bool
    for param in f.params
        if mentions_abstract(param.1) then return false

    !mentions_abstract(f.ret_ty)
end emitted_shape

// The struct types a program laid out, in the order they were made real. One made at a type
// parameter names the family a generic covers rather than a type, so nothing has that layout.
reached_structs(a: &Analysis) -> Buf[Type]
    var out: Buf[Type] = buf()

    for i in 0..<a.tables.struct_insts.len()
        val t = a.tables.struct_insts.at(i)

        if !instantiated_abstract(t) then out.push(t)

    out
end reached_structs

// The enums, on the same terms, less the **simple** ones: an enum with nothing in any variant is its
// underlying integer and has no layout of its own to record.
reached_enums(a: &Analysis) -> Buf[Type]
    var out: Buf[Type] = buf()

    for i in 0..<a.tables.enum_insts.len()
        val t = a.tables.enum_insts.at(i)
        val simple = t match
            Enum(d) -> d.simple
            _ -> false

        if !simple && !instantiated_abstract(t) then out.push(t)

    out
end reached_enums

// Whether a named type was made real at something that is not a type -- a parameter standing in for
// itself while a generic body was read at its own definition, or a type nothing settled.
//
// **The second is as much "not a type" as the first**, and leaving it out put a hundred layouts in
// a program's list that no value has: reading a generic container's body at its own definition can
// leave a parameter as `Unknown` rather than as itself, and the `Buf[?]`, `Map[?, bool]` and
// `Option[?]` that came of it were recorded as instantiations. The reference compiler's list holds
// neither kind.
private instantiated_abstract(t: Type) -> bool = t match
    Struct(d) -> any_stands_in(d.targs)
    Enum(d) -> any_stands_in(d.targs)
    _ -> false

private any_stands_in(ts: Buf[Type]) -> bool
    for item in ts
        if mentions_abstract(item) || mentions_unknown(item) then return true

    false
end any_stands_in

reached_vtables(a: &Analysis) -> Buf[TVtable]
    var out: Buf[TVtable] = buf()

    for i in 0..<a.tables.members.vtables.len()
        out.push(a.tables.members.vtables.at(i))

    out
end reached_vtables

// The `extern` **variables** a program reads or writes: storage the linker supplies, which the module
// declares rather than lays down. The same accounting the functions below get -- one nothing reaches
// is a declaration and not a link -- and the symbol is the one the read itself names.
reached_extern_vars(a: &Analysis) -> Buf[TExternVar]
    var out: Buf[TExternVar] = buf()
    val used = a.extern_vars_used()

    for key in used
        val d = a.tables.extern_vars.get(key)

        // Declared under the symbol it links against, and once however many sysl names reach it:
        // `extern "optind" idx` and `extern optind` are one `@optind`.
        if d.is_some() && d.unwrap().typ.is_some()
            val symbol = extern_var_symbol(d.unwrap())

            if !extern_var_declared(out, symbol)
                out.push(TExternVar(symbol, resolve_type(a, d.unwrap().scope, d.unwrap().typ.unwrap(),
                                                         no_bindings())))

    out
end reached_extern_vars

private extern_var_declared(out: Buf[TExternVar], symbol: string) -> bool
    for item in out
        if item.symbol == symbol then return true

    false

// The `extern` functions a program calls, with their signatures as the tables resolved them. An
// `extern` nothing reaches is a declaration and not a link.
reached_externs(a: &Analysis) -> Buf[TExtern]
    var out: Buf[TExtern] = buf()

    // In the order the **calls** reached them, which is not the order they were written: a call
    // records the extern it is about to make before it analyzes its arguments, so `take(give())`
    // declares `take` first.
    val used = a.externs_used()

    for i in 0..<used.len()
        val key = used.at(i)
        val d = a.tables.externs.get(key)

        if d.is_some()
            val scope = extern_home(a, key)
            var params: Buf[Type] = buf()

            // A C `va_list` parameter is a slot the address of the walk goes into, so the signature
            // carries `*va_list` whichever of C's two spellings the header used -- what actually
            // crosses for the by-value one is the target's answer, and `TVaPass` at the call is what
            // forms it.
            for j in 0..<d.unwrap().params.len()
                val written = d.unwrap().params.at(j).typ

                params.push(if written_va_list(written) then Ptr(VaList)
                            else resolve_type(a, scope, written, no_bindings()))

            var ret = Unit

            if d.unwrap().ret_type.is_some() then
                ret = resolve_result(a, scope, d.unwrap().ret_type.unwrap(), no_bindings())

            val symbol = linked_symbol(a, extern_written(a, key), d.unwrap(), params, ret)

            out.push(TExtern(key, symbol, params, ret, d.unwrap().variadic, d.unwrap().abandons,
                             d.unwrap().returns_twice || returns_twice_symbol(symbol)))

    out
end reached_externs

// The symbol an `extern` links against, which for the back end's own operations is not the name the
// declaration wrote.
//
// **An LLVM intrinsic is overloaded on its operand type, and the width is part of the NAME** --
// `llvm.fabs.f64`, never `llvm.fabs`. Emitting the base alone calls a function LLVM does not define,
// so a program reaching `sysl.math`'s `abs` would not link; the library declares seven of these and
// `json` and `toml` are the two repositories in the org that reach one.
//
// It is settled here, where the signature has just been resolved, rather than recomputed wherever
// the symbol is wanted -- so everything downstream reads one field and needs to know nothing about
// which kind of `extern` this was.
private linked_symbol(a: &Analysis, home: ExternHome, d: ExternDecl, params: Buf[Type],
                      ret: Type) -> string
    val written = extern_symbol(d)

    if !is_intrinsic_name(written) then return written

    if d.variadic
        a.fault(home.scope, home.span, "an intrinsic takes a fixed argument list, so it may not " +
                "be declared with '...'")

    resolve_intrinsic(written, params, ret) match
        Ok(mangled) -> mangled
        Err(why) ->
            a.fault(home.scope, home.span, why)
            written
end linked_symbol


// The file an `extern` was written in, which is where the types in its signature mean what they
// meant.
private extern_home(a: &Analysis, key: string) -> Scope = extern_written(a, key).scope

private extern_written(a: &Analysis, key: string) -> ExternHome =
    a.tables.extern_scopes.get(key).unwrap_or(ExternHome(empty_scope(), span_zero()))

// The `@test` functions the sources declared, in the order they were written, each carrying the
// hooks its own module declared.
//
// **Only the ones whose bodies survived analysis.** A test that was reported is not one a runner
// could run, and listing it would put a name in the report that no dispatcher arm matches -- which
// reads as a test that vanished rather than as the error already printed.
private declared_tests(done: TypedBodies, analyzed: Set[string], hooks: Buf[THook]) -> Buf[TTest]
    var out: Buf[TTest] = buf()

    for unit in done.units
        val scope = scope_of_unit(done.an, unit)

        for j in 0..<unit.body.len()
            val s = unit.body.at(j)

            *s.kind match
                FuncDecl(written) ->
                    val d = with_call_bounds(written)

                    if d.test.is_some() && d.tparams.is_empty()
                        val key = func_key(done.an, scope, s.span, d)
                        val attr = d.test.unwrap()

                        if analyzed.has(key)
                            out.push(TTest(key, attr.display.unwrap_or(module_bare(key)),
                                           attr.should_trap, attr.expected, unit.src.name,
                                           int(unit.src.locate(attr.span.start).line),
                                           module_hooks(hooks, module_of(key)), attr.ignored,
                                           attr.timeout))
                _ -> ()

    out
end declared_tests

// The hooks every module declared, on the same terms.
private declared_hooks(done: TypedBodies, analyzed: Set[string]) -> Buf[THook]
    var out: Buf[THook] = buf()

    for unit in done.units
        val scope = scope_of_unit(done.an, unit)

        for j in 0..<unit.body.len()
            val s = unit.body.at(j)

            *s.kind match
                FuncDecl(written) ->
                    val d = with_call_bounds(written)

                    if d.hook.is_some() && d.tparams.is_empty()
                        val key = func_key(done.an, scope, s.span, d)
                        val attr = d.hook.unwrap()

                        if analyzed.has(key)
                            out.push(THook(attr.kind, key, unit.src.name,
                                           int(unit.src.locate(attr.span.start).line)))
                _ -> ()

    out
end declared_hooks

// Every test is handed its own module's hooks, which is what lets a runner work from a list of tests
// alone -- a cached suite arrives with no program behind it at all.
private module_hooks(hooks: Buf[THook], module_name: string) -> THooks
    var mine: Buf[THook] = buf()

    for item in hooks
        if module_of(item.func) == module_name then mine.push(item)

    hooks_of(mine)
end module_hooks

// The names of every body that survived analysis, asked once per test and hook -- a set, so that
// asking costs the same however many functions the program has.
private analyzed_bodies(funcs: Buf[TFunc]) -> Set[string]
    var out: Set[string] = set()

    for i in 0..<funcs.len()
        out.add(funcs.at(i).name)

    out
end analyzed_bodies

// The modules that gave the allocator up, and the same asked of what each module's TESTS may do --
// two lists, because a `@tests` file may take the allocator back for the scaffolding alone.
//
// **A module's clauses are read off the first file that ships it**, since the header is one
// statement about the module however many files repeat it, and a test file's clause is an override
// rather than a second opinion.
private no_alloc_modules(units: Buf[Program], for_tests: bool) -> Buf[string]
    var named: Buf[string] = buf()
    var out: Buf[string] = buf()

    for i in 0..<units.len()
        val unit = units.at(i)
        val module_name = module_of_unit(unit)

        // An entry file that declares no module is the root module, named "" -- and its '@no_alloc'
        // binds it exactly as a named module's does.
        if !holds_string(named, module_name)
            val clauses = module_clauses(units, module_name, for_tests)

            named.push(module_name)

            if gives_up_heap(clauses) then out.push(module_name)

    out
end no_alloc_modules

// The clauses a module is held to: its own, or -- on the test side, where its `@tests` file says
// anything at all about a capability -- that file's instead.
private module_clauses(units: Buf[Program], module_name: string,
                       for_tests: bool) -> Buf[CapabilityClause]
    var mine: Buf[CapabilityClause] = buf()
    var theirs: Buf[CapabilityClause] = buf()
    var found_mine = false
    var found_theirs = false

    for unit in units
        if module_of_unit(unit) == module_name && !unit.capabilities.is_empty()
            if unit.test_only
                if !found_theirs
                    theirs = unit.capabilities
                    found_theirs = true
            else if !found_mine
                mine = unit.capabilities
                found_mine = true

    // **The tests' list is the `@tests` file's own clauses and never the module's**: `@no_alloc`
    // binds the files that ship, and tests are hosted code that may allocate.
    if for_tests then (if found_theirs then theirs else buf()) else mine
end module_clauses

// Whether a module's clauses give up the allocator. `no alloc` is the word a module writes for it.
private gives_up_heap(clauses: Buf[CapabilityClause]) -> bool
    for c in clauses
        val narrows = c.direction match
            Narrows -> true
            Requires -> false

        if narrows && c.name == "alloc" then return true

    false
end gives_up_heap

// -- the back end's own operations ------------------------------------------------------------------

// The namespace LLVM reserves, which is the whole of how an intrinsic is told from a linked symbol --
// the registry's own (`llvm_registry.sysl`), so the two cannot disagree.
const IntrinsicPrefix: string = LlvmPrefix

is_intrinsic_name(symbol: string) -> bool = symbol.starts_with(IntrinsicPrefix)

// The float operations an `extern` may name, with what each takes.
//
// **What is validated here is a signature somebody WROTE** -- an `extern` in library source, which
// can disagree with LLVM's and has to be held to it before the verifier is reached, where the
// message names generated text rather than the line. The integer operations are not here and that is
// not an omission: `sysl.math`'s `Bits` covers an open family of widths, so there was never a finite
// set of `extern`s, and the compiler builds those calls from the receiver's own type.
private intrinsic_arity(base: string) -> Option[usize] = base match
    "llvm.sqrt" -> Some(1)
    "llvm.fabs" -> Some(1)
    "llvm.floor" -> Some(1)
    "llvm.ceil" -> Some(1)
    "llvm.trunc" -> Some(1)
    "llvm.round" -> Some(1)
    "llvm.roundeven" -> Some(1)
    "llvm.copysign" -> Some(2)
    "llvm.fma" -> Some(3)
    "llvm.rint" -> Some(1)
    "llvm.nearbyint" -> Some(1)
    "llvm.minnum" -> Some(2)
    "llvm.maxnum" -> Some(2)
    "llvm.minimum" -> Some(2)
    "llvm.maximum" -> Some(2)
    _ -> None

// The ones there are, in the order a refusal lists them: the registry's library floats.
supported_intrinsics() -> []const string = llvm_library_floats()

// The same list as a refusal writes it.
private intrinsics_supported() -> string
    val names = supported_intrinsics()
    var out = ""

    for i in 0..<names.len
        if i > 0 then out = out + ", "
        out = out + names[i]

    out
end intrinsics_supported

// The name to emit, or why the declaration cannot be honoured. The checks are the ones the LLVM
// verifier would otherwise find.
private resolve_intrinsic(base: string, params: Buf[Type], ret: Type) -> Result[string, string]
    // The one that is not a float operation: it takes nothing, answers nothing and has no overload
    // suffix, so it is checked on its own.
    if base == llvm_trap_entry().base then return resolve_trap(params, ret)

    val arity = intrinsic_arity(base) match
        Some(n) -> n
        None -> return Err(s"'$base' is not an intrinsic sysl supports — it has " +
                           s"${intrinsics_supported()}")

    if params.len() != arity
        return Err(s"'$base' takes ${quantity(arity, "argument")}, but ${params.len()} were declared")

    // **The suffix is the width every one of them is at**, so a declaration mixing two, or naming
    // anything that is not floating, has no name to be given.
    // `bf16` shares `f16`'s width and not its name, so the format is compared as well as the width.
    var bits = 0
    var brain = false

    for param in params
        param match
            Floating(w, b) ->
                if bits == 0
                    bits = w
                    brain = b
                else if bits != w || brain != b then bits = -1
            _ -> bits = -1

    ret match
        Floating(w, b) ->
            if bits == 0
                bits = w
                brain = b
            else if bits != w || brain != b then bits = -1
        _ -> bits = -1

    if bits <= 0
        return Err(s"'$base' takes and returns one floating-point type, and this declaration " +
                   s"states ${intrinsic_states(params, ret)}")

    // **A fused multiply-add rounds once, and only a binary32 or binary64 one is sure to.** Where the
    // machine has no instruction, LLVM computes a half-width one in a wider format and rounds twice,
    // and a binary128 one calls a routine no freestanding machine has; the two widths `sysl.softfloat`
    // answers in software are the ones offered.
    if base == "llvm.fma" && (brain || (bits != 32 && bits != 64))
        return Err(s"'llvm.fma' is offered at f32 and f64, and this declaration states " +
                   s"${intrinsic_states(params, ret)}")

    Ok(if brain then s"$base.bf16" else s"$base.f$bits")
end resolve_intrinsic

// `llvm.trap` stops the program at once and never returns, so a declaration of it states no
// arguments and answers `never`.
private resolve_trap(params: Buf[Type], ret: Type) -> Result[string, string]
    if params.len() != 0
        return Err(s"'llvm.trap' takes 0 arguments, but ${params.len()} were declared")

    ret match
        Never -> Ok("llvm.trap")
        _ -> Err(s"'llvm.trap' never returns, so a declaration of it answers 'never' — this one " +
                 s"answers '${type_show(ret)}'")
end resolve_trap

// The distinct types a declaration named, as the refusal lists them.
private intrinsic_states(params: Buf[Type], ret: Type) -> string
    var seen: Buf[string] = buf()

    for param in params
        val one = type_show(param)

        if !holds_string(seen, one) then seen.push(one)

    val last = type_show(ret)

    if !holds_string(seen, last) then seen.push(last)

    var out = ""

    for i in 0..<seen.len()
        out = out + (if i == 0 then "" else " and ") + seen.at(i)

    out
end intrinsic_states
