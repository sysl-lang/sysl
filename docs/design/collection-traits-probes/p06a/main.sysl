// p06a: a trait default that needs a bound on the trait's own associated type (Rust's
// `fn max(self) where Self::Item: Ord`).
trait It
    type Item
    next(*self) -> Option[Self::Item]

    max(self) -> Option[Self::Item] where Self::Item: Ord
        var cur = self
        var best: Option[Self::Item] = None
        loop
            cur.next() match
                Some(x) -> best = best match
                    Some(b) -> if b < x then Some(x) else Some(b)
                    None -> Some(x)
                None -> break
        best
    end max

struct Count
    n: int
    stop: int

impl It for Count
    type Item = int
    next(*self) -> Option[int]
        if self.n >= self.stop then return None
        val v = self.n
        self.n += 1
        Some(v)

main()
    print(Count(0, 4).max().unwrap())
