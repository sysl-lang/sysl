// p24: the Fn1-bounded adapter alone, built by a free function and drained by hand.
trait It
    type Item
    next(*self) -> Option[Self::Item]

struct Count
    n: int
    stop: int

impl It for Count
    type Item = int
    next(*self) -> Option[int]
        if self.n >= self.stop then return None
        val v = self.n
        self.n += 1
        Some(v)

struct MapIt[I, F, U]
    src: I
    f: F

impl[I: It, F: Fn1[I::Item, U], U] It for MapIt[I, F, U]
    type Item = U
    next(*self) -> Option[U]
        self.src.next() match
            Some(x) -> Some(self.f(x))
            None -> None

map[I: It, R, G: Fn1[I::Item, R]](it: I, g: G) -> MapIt[I, G, R] = MapIt(it, g)

main()
    var m = map(Count(0, 4), x -> x * 10)
    var t = 0
    loop
        m.next() match
            Some(v) -> t += v
            None -> break
    print(t)
