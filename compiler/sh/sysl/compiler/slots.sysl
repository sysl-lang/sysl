module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.math.bigint.from_int

// The slot forms: what a growable container needs so that its spare capacity holds NOTHING.
//
// **A buffer box already says how many of its elements are real.** Its fourth header word is the
// count the destruction hook walks, and every buffer the language makes today sets it to the whole
// length, which is why a container written over `[fill; n]` holds a count of `fill` in every spare
// slot. These three forms let the raw tier move that word, which turns it into the buffer's *live
// prefix*: the slots `[0, live)` hold values and the hook releases exactly those, while the slots
// past it hold bytes nothing reads and nothing releases.
//
// - `slot_storage(n) -> []T` (or `slot_storage[T](n)`) is a buffer of `n` slots with **none** live.
// - `slot_place(xs, i, v)` puts `v` in slot `i`. The first slot past the live prefix is filled
//   without letting go of anything, and the prefix grows by one; a live slot is an ordinary
//   assignment; a slot further on would leave a gap the hook cannot see past, so it traps.
// - `slot_place_run(xs, at, src)` is `slot_place(xs, at + k, src[k])` for every `k` of the run `src`,
//   which is what a container's append of a whole slice and its growth's copy are. An element that
//   holds no count has nothing to place one at a time -- a place of one is a store -- so the run is
//   one `memmove`; one that holds a count is placed slot by slot, exactly as the loop would be.
// - `slot_vacate(xs, n)` lets go of every live slot from `n` on and shortens the prefix to `n` --
//   **but only where the storage has no other holder**. A view handed out earlier, or a second copy
//   of the container, still reads those slots, and releasing them under it would be a read of freed
//   storage; where the strong count is above one the form does nothing, and the next vacate made
//   once the sharing is over catches up, the prefix still covering what was left.
//
// **The storage is recognised by its hook, not trusted to be one.** A view's owner may be a struct
// box (a view of an array field), a buffer some other form made, or nothing at all (static, a
// frame, a `*T`). So `slot_storage` installs a hook of its own, `arc.slotbuf.<T>` -- the buffer walk
// under a `weak_odr` symbol, one address in every codegen unit and in the standard module's
// artifact, where a private helper is copied into each -- and both writing forms ask whether the
// owner's hook is that one. Where it is not, they are an ordinary assignment and a no-op.
//
// **A parameter is a borrow and holds no count**, so "no other holder" means no other *counted*
// one: a view handed down to a callee that then vacates the caller's storage through another path is
// the one sharing the strong count cannot see.
// An element that holds no count needs none of it: its hook walks nothing, so a place is a store and
// a vacate is nothing.
//
// They are the raw tier's bargain, like `ptr_cast` and the atomics: greppable, and the caller owes
// the one thing the compiler cannot check -- that nothing reads a slot of `[]T` past the live prefix.
// `sysl.buf.Buf` is what writes them, so that no program has to.
//
// Two more move a value through a `*T` one slot at a time, for storage that is not a prefix -- a
// ring's live run wraps, so a vacated slot can sit between two live ones:
//
// - `slot_take(p) -> T` moves the value out. The share the slot held becomes the result's, so no
//   count is taken or given back, and the slot is left **empty**: zeroed when the element holds a
//   count, which is the state zeroed storage starts in, so whatever owns the storage gives back
//   nothing for it when it lets the slot go. A slot of an element that holds no count is only read.
// - `slot_put(p, v)` moves `v` into an empty slot: the value's share becomes the slot's, and nothing
//   that was there is given back.
//
// Both are unchecked: the caller promises that a taken slot is live and a put one is empty. Rust's
// `ptr::read` and `ptr::write` are the same pair.
//
// **Two answer a refusal instead of trapping on it**, for the fallible members of the containers
// (`sysl.alloc`, `reference/memory.md § An allocation that may fail`):
//
// - `try_slot_storage(n) -> []T` is `slot_storage(n)`, except that where the heap answers null -- or
//   the size of `n` slots does not fit in a word -- it answers an **empty** view, owner null, rather
//   than trapping. A caller asking for `n > 0` slots tells the two apart by the length.
// - `try_heap(v) -> Option[&T]` is the box `v` would be put in where a `&T` is expected, answered as
//   `Some`, or `None` where the heap answered null. The typed tree holds the box itself (`TBox`) as
//   the form's one argument, so every analysis that reads a box reads this one; only the lowering
//   knows the box may not be made. Nothing is stored and no count is taken on the refused arm.

// The eight names, whatever claims them.
slot_form_word(name: string) -> bool =
    name == "slot_storage" || name == "slot_place" || name == "slot_place_run" ||
        name == "slot_vacate" || name == "slot_take" || name == "slot_put" ||
        name == "try_slot_storage" || name == "try_heap"

// The two forms that make new storage of slots: the trapping one and the one that answers an empty
// view where the heap refused. Every analysis asks this rather than naming either.
storage_form(op: string) -> bool = op == "slot_storage" || op == "try_slot_storage"

// Whether a name in call position is one of these forms. Like the atomics, a function or a local of
// the name is what a call reaches, and the form applies only where nothing else claims it.
slot_form(cx: &Analyzer, name: string) -> bool =
    slot_form_word(name) && form_unclaimed(cx, name)

// One of the forms, analyzed.
slot_call(cx: &Analyzer, span: Span, name: string, args: Buf[Expr], expected: Option[Type]) -> TExpr
    if storage_form(name) then return slot_storage_call(cx, span, name, args, expected)
    if name == "try_heap" then return try_heap_call(cx, span, args)
    if name == "slot_take" || name == "slot_put" then return slot_move_call(cx, span, name, args)

    slot_write_call(cx, span, name, args)
end slot_call

// `slot_take(p)` and `slot_put(p, v)` -- the element type is the pointer's.
private slot_move_call(cx: &Analyzer, span: Span, name: string, args: Buf[Expr]) -> TExpr
    val take = name == "slot_take"
    val want: usize = if take then 1 else 2

    if args.len() != want then
        return cx.err(span, s"'$name' takes ${quantity(want, "argument")} — " +
                      s"${if take then "the pointer to the slot" else "the pointer to the slot and the value"}" +
                      s" — but ${supplied(args.len(), "argument")}")

    val p = type_expr_bare(cx, args[0])
    val pt = texpr_type(p)

    if pt == Unknown then return bad_expr(span)

    val elem = underlying(pt) match
        Ptr(inner, _) ->
            if is_trait(*inner) then
                return cx.err(args[0].span, s"'$name' moves a whole value through a '*T', and a " +
                              "pointer to a trait is two words — the address and the table of the " +
                              "type it was erased from")

            *inner
        _ ->
            return cx.err(args[0].span, s"'$name' moves a value through a raw pointer, which is " +
                          s"a '*T' — this is ${type_show(pt)}")

    var all: Buf[TExpr] = buf()

    all.push(p)

    if !take then
        val v = coerce(cx, type_expr(cx, args[1], Some(elem)), elem)
        val vt = texpr_type(v)

        if vt != Unknown && !type_eq(vt, elem) && !type_eq(underlying(vt), underlying(elem)) then
            cx.fault(args[1].span, s"'slot_put' puts a ${type_show(elem)} into the slot " +
                     s"${type_show(pt)} points at, and this is a ${type_show(vt)}")

        all.push(v)
    end if

    TExpr(span, TSlots(name, all, elem, if take then elem else Unit))
end slot_move_call

// `slot_storage(n)` and `try_slot_storage(n)` -- the element type comes from the position, the way
// `ptr_cast`'s does.
private slot_storage_call(cx: &Analyzer, span: Span, name: string, args: Buf[Expr],
                          expected: Option[Type]) -> TExpr
    if args.len() != 1 then
        return cx.err(span, s"'$name' takes 1 argument — how many slots — but " +
                      supplied(args.len(), "argument"))

    if expected.is_none() then
        return cx.err(span, s"'$name' makes storage for elements of some type, and nothing " +
                      s"here says which — write '$name[T](n)', or put it where a '[]T' is " +
                      "expected")

    val want = expected.unwrap()

    val elem = underlying(want) match
        Slice(el, read_only) ->
            if read_only then
                return cx.err(span, s"'$name' makes slots that are placed into, and " +
                              s"${type_show(want)} is a read-only view — ask for a " +
                              s"'[]${type_show(*el)}'")

            *el
        _ ->
            return cx.err(span, s"'$name' makes a buffer, which is a '[]T', and the " +
                          s"position here wants ${type_show(want)}")

    val n = slot_count(cx, args[0])

    TExpr(span, TSlots(name, one_texpr(n), elem, Slice(elem, false)))
end slot_storage_call

// `try_heap(v)` -- the box a `&T` of the value would be, as an `Option[&T]` that is `None` where the
// heap refused it. The box is analyzed as the one a position expecting `&T` makes (`coerce`), so a
// value that may not be boxed is refused here in the same words.
private try_heap_call(cx: &Analyzer, span: Span, args: Buf[Expr]) -> TExpr
    if args.len() != 1 then
        return cx.err(span, "'try_heap' takes 1 argument — the value to put on the heap — but " +
                      supplied(args.len(), "argument"))

    val v = type_expr_bare(cx, args[0])
    val vt = texpr_type(v)

    if vt == Unknown then return bad_expr(span)

    val ref_ty = Ref(vt, false)
    val boxed = coerce(cx, v, ref_ty)

    *boxed.kind match
        TBox(_, _) -> ()
        _ -> return boxed

    var targs: Buf[Type] = buf()

    targs.push(ref_ty)

    val opt = reinstantiate(cx.an, library_key("Option"), targs)

    opt match
        Enum(_) -> TExpr(span, TSlots("try_heap", one_texpr(boxed), vt, opt))
        _ -> bad_expr(span)
end try_heap_call

// `slot_place(xs, i, v)`, `slot_place_run(xs, at, src)` and `slot_vacate(xs, n)`.
private slot_write_call(cx: &Analyzer, span: Span, name: string, args: Buf[Expr]) -> TExpr
    val place = name == "slot_place"
    val run = name == "slot_place_run"
    val want: usize = if place || run then 3 else 2
    val what = if place then "a buffer, a slot and a value"
               else if run then "a buffer, a slot and a run of values"
               else "a buffer and a slot"

    if args.len() != want then
        return cx.err(span, s"'$name' takes ${quantity(want, "argument")} — $what" +
                      s" — but ${supplied(args.len(), "argument")}")

    val xs = type_expr_bare(cx, args[0])
    val xt = texpr_type(xs)

    if xt == Unknown then return bad_expr(span)

    val elem = underlying(xt) match
        Slice(el, read_only) ->
            if read_only then
                return cx.err(args[0].span, s"'$name' writes into the slots of a buffer, and " +
                              s"${type_show(xt)} is a read-only view of one")

            *el
        _ ->
            return cx.err(args[0].span, s"'$name' works on the slots of a buffer, which is a " +
                          s"'[]T' — this is ${type_show(xt)}")

    var all: Buf[TExpr] = buf()

    all.push(xs)
    all.push(slot_count(cx, args[1]))

    if place then
        val v = coerce(cx, type_expr(cx, args[2], Some(elem)), elem)
        val vt = texpr_type(v)

        if vt != Unknown && !type_eq(vt, elem) && !type_eq(underlying(vt), underlying(elem)) then
            cx.fault(args[2].span, s"'slot_place' puts a ${type_show(elem)} into a slot of " +
                     s"${type_show(xt)}, and this is a ${type_show(vt)}")

        all.push(v)
    end if

    if run then all.push(slot_run(cx, args[2], elem, xt))

    TExpr(span, TSlots(name, all, elem, Unit))
end slot_write_call

// The run `slot_place_run` fills from: a view of the element type, read-only or not, or anything
// that becomes one where a `[]const T` is expected.
private slot_run(cx: &Analyzer, e: Expr, elem: Type, xt: Type) -> TExpr
    val want = Slice(elem, true)
    val src = coerce(cx, type_expr(cx, e, Some(want)), want)
    val st = texpr_type(src)

    if st == Unknown then return src

    val fits = underlying(st) match
        Slice(el, _) -> type_eq(*el, elem) || type_eq(underlying(*el), underlying(elem))
        _ -> false

    if !fits then
        cx.fault(e.span, s"'slot_place_run' fills slots of ${type_show(xt)} from a run of " +
                 s"${type_show(elem)}, a '${type_show(want)}', and this is a ${type_show(st)}")

    src
end slot_run

// **What a slot form puts in a slot, for the analyses that follow a value into storage**: the value
// of a `slot_place`, and for a `slot_place_run` one element of its run, read as `src[0]` -- every slot
// the run fills is filled with such a read, so the run keeps exactly what the loop of `slot_place`s
// it stands for keeps, and the analyses need say nothing of their own about it.
slot_value(op: string, args: Buf[TExpr], elem: Type) -> Option[TExpr]
    if op == "slot_place" && args.len() == 3 then return Some(args[2])

    if op == "slot_place_run" && args.len() == 3
        val src = args[2]
        val first = TExpr(src.span, TIntLit(from_int(0), texpr_type(args[1])))

        return Some(TExpr(src.span, TIndex(src, first, elem)))

    None
end slot_value

// A slot index or a count, read as an index is.
private slot_count(cx: &Analyzer, e: Expr) -> TExpr
    not_fixing_at(cx, e)

    val t = type_expr(cx, e, Some(usize_type(word_bits(cx))))

    repr(texpr_type(t)) match
        Integer(_, _, _) -> ()
        other -> if other != Unknown then
                     cx.fault(e.span, s"a slot is counted by an integer, not ${type_show(other)}")

    t
end slot_count

private one_texpr(t: TExpr) -> Buf[TExpr]
    var out: Buf[TExpr] = buf()

    out.push(t)
    out
end one_texpr

// -- lowering --------------------------------------------------------------------------------------

// One of the forms, lowered.
gen_slots(e: *Emit, op: string, args: Buf[TExpr], elem: Type, ty: Type) -> Val
    if op == "slot_storage" then return gen_slot_storage(e, args[0], elem, ty)
    if op == "try_slot_storage" then return gen_try_slot_storage(e, args[0], elem, ty)
    if op == "try_heap" then return gen_try_heap(e, args[0], ty)
    if op == "slot_take" then return gen_slot_take(e, args[0], elem)

    if op == "slot_put" then gen_slot_put(e, args[0], args[1], elem)
    else if op == "slot_place" then gen_slot_place(e, args[0], args[1], args[2], elem)
    else if op == "slot_place_run" then gen_slot_place_run(e, args[0], args[1], args[2], elem)
    else gen_slot_vacate(e, args[0], args[1], elem)

    VNothing
end gen_slots

// A buffer like `[v; n]`'s, with the live count stored as zero and no element written -- and, like
// it, **no buffer at all where `n` is zero** (`emit_box.sysl`'s `skip_if_empty`): the empty view has
// no owner, so the hook tests of the other forms send it down their "not this storage" path, and a
// container grows from it by making storage of its own, as it does from `[]`.
private gen_slot_storage(e: *Emit, count: TExpr, elem: Type, slice_ty: Type) -> Val
    val n = widen_index(e, count, count.span, BoundsCountTooWide)

    if is_zero_const(n) then return VZero

    val skip = skip_if_empty(e, slice_ty, n)
    val made = gen_slot_buffer(e, elem, n)

    emit(e, InStore(word_lty(e), VInt(from_int(0)), slot_header(e, elem, made.0, header_fields()),
                    AccPlain, None))

    // Where the pair is told sizes the storage is given back from in front of its header whatever its
    // element (`emit_box.sysl`'s `slot_lead`), which only this storage's own hook knows to do.
    if contains_counted(elem) || heap_sized() then
        emit(e, InStore(LPtr, slot_buf_fn(e, elem), slot_header(e, elem, made.0, 1), AccPlain, None))

    join_unless_empty(e, slice_ty, skip, view_parts(e, slice_ty, made.0, made.1, n))
end gen_slot_storage

// `slot_storage`'s buffer where the heap gave one, and an empty view where it did not
// (`gen_try_buffer`): the hook and the live count are written on the arm that has a box to write
// them into, and the view is owned once, where the arms meet. A count of zero takes the empty arm
// without asking the heap, as `slot_storage(0)` does: the answer is the same empty view either way.
private gen_try_slot_storage(e: *Emit, count: TExpr, elem: Type, slice_ty: Type) -> Val
    val n = widen_index(e, count, count.span, BoundsCountTooWide)

    if is_zero_const(n) then return VZero

    val lt = lty(e, slice_ty)
    val result = alloca(e, fresh_reg(e), lt)
    val asked = fresh_label(e, "trystore.ask")
    val given = fresh_label(e, "trystore.given")
    val refused = fresh_label(e, "trystore.refused")
    val joined = fresh_label(e, "trystore.end")
    val none = fresh_reg(e)

    emit(e, InIntCmp(none, IEq, word_lty(e), n, VInt(from_int(0))))
    emit_term(e, InCondBr(none, refused, asked))
    emit_label(e, asked)

    val made = gen_try_buffer(e, elem, n)

    emit_term(e, InCondBr(made.2, given, refused))
    emit_label(e, given)
    emit(e, InStore(word_lty(e), VInt(from_int(0)), slot_header(e, elem, made.0, header_fields()),
                    AccPlain, None))

    if contains_counted(elem) || heap_sized() then
        emit(e, InStore(LPtr, slot_buf_fn(e, elem), slot_header(e, elem, made.0, 1), AccPlain, None))

    emit(e, InStore(lt, view_parts(e, slice_ty, made.0, made.1, n), result, AccPlain, None))
    emit_term(e, InBr(joined))
    emit_label(e, refused)
    emit(e, InStore(lt, VZero, result, AccPlain, None))
    emit_term(e, InBr(joined))
    emit_label(e, joined)
    e.maybe_heap = true

    val r = fresh_reg(e)

    emit(e, InLoad(r, lt, result, AccPlain, None))
    own_temp(e, r, slice_ty)
end gen_try_slot_storage

// The value at `p`, which arrives owning the share the slot held -- registered as a temporary, as a
// call's result is -- and the slot zeroed behind it where the element holds a count, so nothing that
// lets the storage go later gives that share back a second time.
private gen_slot_take(e: *Emit, at: TExpr, elem: Type) -> Val
    val p = gen_expr(e, at)

    if zero_sized(elem) then return zero_of(e, elem)

    val v = fresh_reg(e)

    emit(e, InLoad(v, lty(e, elem), p, AccPlain, None))

    if !contains_counted(elem) then return v

    emit(e, InStore(lty(e, elem), zero_of(e, elem), p, AccPlain, None))
    own_temp(e, v, elem)
end gen_slot_take

// `v` stored at `p` with a share of its own and nothing at `p` given back: the slot was empty.
private gen_slot_put(e: *Emit, at: TExpr, value: TExpr, elem: Type)
    val p = gen_expr(e, at)
    val v = gen_expr(e, value)

    if zero_sized(elem) then return

    if contains_counted(elem) then retain_value(e, elem, v)

    emit(e, InStore(lty(e, elem), v, p, AccPlain, None))
end gen_slot_put

// **Placed into a `BufCore`'s own storage, every access is on the elements' side** of the buffer
// (`emit_place.sysl`'s `buf_side`, `reference/arrays.md § Its elements are never its header`): the
// slot, and the live prefix and hook words of the storage's own box, which is the allocation the
// slots are in. None of them is the `BufCore` or the box a handle sits in, so the scope lets an
// append in a loop keep the storage pointer, the count and the capacity in registers across the
// element it writes -- which is what `push` is. Any other view says nothing, as its subscript does.
private gen_slot_place(e: *Emit, xs: TExpr, index: TExpr, value: TExpr, elem: Type)
    val side = if is_core_elems(xs) then AccBufElement else AccPlain
    val view = slot_view(e, xs)
    val i = widen_index(e, index, index.span)

    bounds_check(e, i, view.2, signed_index(index), index.span)

    val p = slot_at(e, elem, view.1, i)
    val drained = drain_of(e, value)
    val v = if drained.is_some() then drain_read(e, drained.unwrap(), value, elem) else gen_expr(e, value)

    if zero_sized(elem) then return

    if !contains_counted(elem)
        emit(e, InStore(lty(e, elem), v, p, side, None))
        return

    if drained.is_some()
        place_counted(e, elem, view.0, p, v, side)
        return

    // **Only the first free slot is placed in line.** It is the case a container appending to its own
    // storage reaches every time, and it gives nothing back. A live slot (an ordinary assignment,
    // letting go of what was there), a slot past the first free one (a trap) and storage that is not
    // a buffer of these slots are all one out-of-line call, `arc.slotplace.<T>`, kept so by `noinline`
    // and `cold`: written here they made every append carry a trap the optimizer cannot settle -- it
    // cannot see that a container's count never passes the live prefix -- and a body too large for
    // `@inline` to bring into its caller.
    //
    // **The count the slot keeps is in hand before the test**: the value's own where it is a
    // temporary or a local at its last use -- an owned parameter handed to `push` among them
    // (`emit_moves.sysl`) -- and one taken otherwise. The first free slot keeps it as it is, and the
    // rest hands it to `arc.slotplace.<T>`, which keeps it too.
    retain_moving(e, value, elem, v)
    place_counted(e, elem, view.0, p, v, side)
end gen_slot_place

// `v`, which already holds the count the slot keeps, placed at `p` in storage owned by `owner`: the
// first free slot in line, and every other case through `arc.slotplace.<T>`.
private place_counted(e: *Emit, elem: Type, owner: Val, p: Val, v: Val, side: IrAccess)
    val buffer_l = fresh_label(e, "slot.buffer")
    val fresh_l = fresh_label(e, "slot.fresh")
    val rest_l = fresh_label(e, "slot.rest")
    val done_l = fresh_label(e, "slot.done")

    buffer_test(e, elem, owner, buffer_l, rest_l, side)
    emit_label(e, buffer_l)

    val lp = slot_header(e, elem, owner, header_fields())
    val live = fresh_reg(e)

    emit(e, InLoad(live, word_lty(e), lp, side, None))

    val edge = slot_at(e, elem, slot_header(e, elem, owner, buf_elems_field(e, elem)), live)
    val at_edge = fresh_reg(e)

    emit(e, InIntCmp(at_edge, IEq, LPtr, p, edge))
    emit_term(e, InCondBr(at_edge, fresh_l, rest_l))

    // The first free slot: nothing is there to give back, and the prefix now covers it.
    emit_label(e, fresh_l)
    emit(e, InStore(lty(e, elem), v, p, side, None))

    val grown = fresh_reg(e)

    emit(e, InBin(grown, OpAdd, word_lty(e), live, VInt(from_int(1))))
    emit(e, InStore(word_lty(e), grown, lp, side, None))
    emit_term(e, InBr(done_l))

    emit_label(e, rest_l)

    var args: Buf[IrArg] = buf()

    args.push(ir_arg(LPtr, owner))
    args.push(ir_arg(LPtr, p))
    args.push(ir_arg(lty(e, elem), v))
    emit(e, ir_call(None, LVoid, slot_place_fn(e, elem), args))
    emit_term(e, InBr(done_l))
    emit_label(e, done_l)
end place_counted

// **`slot_place_run(xs, at, src)` is the loop `slot_place(xs, at + k, src[k])` over the run**, with
// one bounds test for all of it: the slots `at ..< at + src.len` must exist, so `at` may be the
// storage's length only where the run is empty, as a cut's bounds may.
//
// **An element that holds no count is one `memmove`** of the run's bytes. A place of one is a store
// that lets go of nothing and moves no live prefix, so the run is the bytes and nothing else, and one
// call is what moves them a word or a vector at a time where the loop moved one element -- a run of
// bytes shorter than the vectorizer's stride was a byte loop. `memmove` rather than `memcpy`, so a run
// read from the storage it is written into still arrives whole. A freestanding machine has no C
// library to call, so the move is the loop there, except on Thumb, where the standard module carries
// `__aeabi_memmove` (`sysl.softint.aeabi`) and the back end calls that.
//
// **An element that holds a count is placed slot by slot**, each taking a count of its own and each
// placed exactly as `slot_place` places it -- the first free slot in line, everything else out of line
// -- so the counts a program makes and the order it lets go of them are what the loop's were.
private gen_slot_place_run(e: *Emit, xs: TExpr, at: TExpr, src: TExpr, elem: Type)
    val side = if is_core_elems(xs) then AccBufElement else AccPlain
    val view = slot_view(e, xs)
    val i = widen_index(e, at, at.span)
    val from = slot_view(e, src)
    val n = from.2
    val fits = fresh_reg(e)

    emit(e, InIntCmp(fits, IUle, word_lty(e), n, view.2))
    trap_unless(e, fits, "bounds")

    val room = fresh_reg(e)

    emit(e, InBin(room, OpSub, word_lty(e), view.2, n))

    val inside = fresh_reg(e)

    emit(e, InIntCmp(inside, IUle, word_lty(e), i, room))
    trap_unless(e, inside, "bounds")

    if zero_sized(elem) then return

    val drained = drain_of(e, src)

    if drained.is_some() then drain_run_prefix(e, drained.unwrap(), elem, from.0, from.1, n)

    val first = slot_at(e, elem, view.1, i)

    if !contains_counted(elem) && moves_bytes(e)
        val bytes = fresh_reg(e)

        emit(e, InBin(bytes, OpMul, word_lty(e), n, element_size(e, elem)))
        emit_memmove(e, first, from.1, bytes, int(e.layout.align(elem)))
        return
    end if

    // A drained run that took the rest of the old prefix is relocated as a whole where it can be.
    val relocated = if drained.is_some() && contains_counted(elem) && moves_bytes(e)
        then Some(relocate(e, drained.unwrap().zero, elem, view.0, i, first, from.1, n, side))
        else None

    // **The loop runs back to front only where the run overlaps the slots it fills from below**, so
    // each element is read before it is written over, as `memmove` reads them. Every other run goes
    // front to back, so a counted run fills the first free slot each time, as the loop of places does.
    val src_end = slot_at(e, elem, from.1, n)
    val below = fresh_reg(e)

    emit(e, InIntCmp(below, IUlt, LPtr, from.1, first))

    val within = fresh_reg(e)

    emit(e, InIntCmp(within, IUlt, LPtr, first, src_end))

    val back = fresh_reg(e)

    emit(e, InBin(back, OpAnd, l_i1(), below, within))

    val last = fresh_reg(e)

    emit(e, InBin(last, OpSub, word_lty(e), n, VInt(from_int(1))))

    val k_slot = alloca(e, fresh_reg(e), word_lty(e))
    val test_l = fresh_label(e, "slot.run")
    val body_l = fresh_label(e, "slot.each")
    val done_l = fresh_label(e, "slot.ran")

    emit(e, InStore(word_lty(e), VInt(from_int(0)), k_slot, AccPlain, None))
    emit_term(e, InBr(test_l))
    emit_label(e, test_l)

    val k = fresh_reg(e)

    emit(e, InLoad(k, word_lty(e), k_slot, AccPlain, None))

    val more = fresh_reg(e)

    emit(e, InIntCmp(more, IUlt, word_lty(e), k, n))
    emit_term(e, InCondBr(more, body_l, done_l))
    emit_label(e, body_l)

    val down = fresh_reg(e)

    emit(e, InBin(down, OpSub, word_lty(e), last, k))

    val j = fresh_reg(e)

    emit(e, InSelect(j, back, word_lty(e), down, k, l_i1()))

    val v = fresh_reg(e)
    val read_at = slot_at(e, elem, from.1, j)

    emit(e, InLoad(v, lty(e, elem), read_at, AccPlain, None))

    val p = slot_at(e, elem, first, j)

    if contains_counted(elem)
        if drained.is_some() then drain_count(e, drained.unwrap(), elem, v, read_at) else retain_value(e, elem, v)

        place_counted(e, elem, view.0, p, v, side)
    else
        emit(e, InStore(lty(e, elem), v, p, side, None))

    val next = fresh_reg(e)

    emit(e, InBin(next, OpAdd, word_lty(e), k, VInt(from_int(1))))
    emit(e, InStore(word_lty(e), next, k_slot, AccPlain, None))
    emit_term(e, InBr(test_l))
    emit_label(e, done_l)

    relocated match
        Some(l) -> relocate_join(e, l)
        None -> ()
end gen_slot_place_run

// Whether a run of bytes may be handed to `llvm.memmove`: where a C library is under the program,
// and on Thumb, whose every image carries the run-time ABI's move.
private moves_bytes(e: *Emit) -> bool = lays_bytes(e) || e.target.cpu == Thumb

// `bytes` bytes moved from `src` to `dst`, which may overlap, both aligned to `align`.
private emit_memmove(e: *Emit, dst: Val, src: Val, bytes: Val, align: int)
    val fn = llvm_memmove_entry().at([LPtr, LPtr, word_lty(e)])

    var params: Buf[IrParam] = buf()

    params.push(ir_param(LPtr))
    params.push(ir_param(LPtr))
    params.push(ir_param(word_lty(e)))
    params.push(ir_param(l_i1()))
    request_intrinsic(e, ir_sig(fn, ir_fn_type(LVoid, params)))

    var args: Buf[IrArg] = buf()
    var dst_attrs: Buf[IrAttr] = buf()
    var src_attrs: Buf[IrAttr] = buf()

    dst_attrs.push(AttrAlign(align))
    src_attrs.push(AttrAlign(align))
    args.push(IrArg(LPtr, dst, dst_attrs))
    args.push(IrArg(LPtr, src, src_attrs))
    args.push(ir_arg(word_lty(e), bytes))
    args.push(ir_arg(LInt(1), VBool(false)))
    emit(e, InCall(None, LVoid, VGlobal(fn), args, no_ir_attrs(), None, no_fast_math(), false))
end emit_memmove

// The out-of-line rest of a `slot_place` of an element that holds a count.
private slot_place_fn(e: *Emit, elem: Type) -> Val =
    VGlobal(request_helper(e, s"arc.slotplace.${mangle(elem)}", HrSlotPlace(elem)))

/** The body of `arc.slotplace.<T>(o, p, v)`: `v` put at `p`, a slot of storage owned by `o`, where
 * the caller has already found `p` is not the first free slot of a buffer of these slots. In such a
 * buffer a slot before the edge is live and is an ordinary assignment, and one past it would leave a
 * gap the hook cannot see past, so it traps; storage of any other kind is an ordinary assignment.
 */
gen_slot_place_rest(e: *Emit, elem: Type)
    val owner = VReg("o")
    val p = VReg("p")
    val buffer_l = fresh_label(e, "slot.buffer")
    val held_l = fresh_label(e, "slot.held")

    buffer_test(e, elem, owner, buffer_l, held_l, AccPlain)
    emit_label(e, buffer_l)

    val live = fresh_reg(e)

    emit(e, InLoad(live, word_lty(e), slot_header(e, elem, owner, header_fields()), AccPlain, None))

    val edge = slot_at(e, elem, slot_header(e, elem, owner, buf_elems_field(e, elem)), live)
    val inside = fresh_reg(e)

    emit(e, InIntCmp(inside, IUlt, LPtr, p, edge))
    trap_unless(e, inside, "slot")
    emit_term(e, InBr(held_l))

    // The value arrives with the count the slot keeps (`gen_slot_place` has it in hand before its
    // test), so the slot's old value is given back and nothing is retained.
    emit_label(e, held_l)

    if e.layout.indirect(elem)
        release_at(e, elem, p)
        emit(e, InStore(lty(e, elem), VReg("v"), p, AccPlain, None))
    else
        val old = fresh_reg(e)

        emit(e, InLoad(old, lty(e, elem), p, AccPlain, None))
        emit(e, InStore(lty(e, elem), VReg("v"), p, AccPlain, None))
        release_value(e, elem, old)
    end if

    emit_term(e, InRet(None, None))
end gen_slot_place_rest

// -- draining storage the next statement lets go of --------------------------------------------------

// **A copy out of storage whose last holder lets go of it next is a move** (`slot_drain.sysl` finds
// it). Two flags decided once, before the copy: `take`, that the storage is a buffer of these slots
// with a strong count of one, so each element read out of it takes over its slot's share instead of
// retaining one; and `zero`, that a taken slot must be left zeroed for the storage's hook to give back
// nothing for it. `zero` is cleared where the copy covers the rest of the live prefix from where it
// starts: the prefix is cut back to that start before the copy, so the hook never walks the taken
// slots, and the copy is a plain copy of the bytes, as C++'s is.
struct Drain
    read: TExpr
    take: Val
    zero: Val
end Drain

// The drain the statement being emitted reads through `x`, where `x` is the node it was found at.
drain_of(e: *Emit, x: TExpr) -> Option[Drain] = e.moves.drain match
    Some(d) -> if d.read.kind === x.kind then Some(d) else None
    None -> None

// The two flags, asked of the storage `p.source` names as it stands before the copy.
drain_begin(e: *Emit, p: DrainPlan) -> Drain
    val elem = p.elem
    val take = alloca(e, fresh_reg(e), l_i1())
    val zero = alloca(e, fresh_reg(e), l_i1())

    emit(e, InStore(l_i1(), VBool(false), take, AccPlain, None))
    emit(e, InStore(l_i1(), VBool(true), zero, AccPlain, None))

    val owner = slot_view(e, p.source).0
    val buffer_l = fresh_label(e, "drain.buffer")
    val sole_l = fresh_label(e, "drain.sole")
    val done_l = fresh_label(e, "drain.decided")

    buffer_test(e, elem, owner, buffer_l, done_l, AccPlain)
    emit_label(e, buffer_l)

    // The strong count is the box's first word, as `slot_vacate` reads it: above one is a second
    // container or a view still reading these slots, which keep their counts.
    val strong = fresh_reg(e)

    emit(e, InLoad(strong, word_lty(e), owner, AccPlain, None))

    val sole = fresh_reg(e)

    emit(e, InIntCmp(sole, IEq, word_lty(e), strong, VInt(from_int(1))))
    emit_term(e, InCondBr(sole, sole_l, done_l))
    emit_label(e, sole_l)
    emit(e, InStore(l_i1(), VBool(true), take, AccPlain, None))

    p.bounds match
        Some(b) -> drain_loop_prefix(e, elem, owner, b.0, b.1, b.2, zero, done_l)
        None -> ()

    emit_term(e, InBr(done_l))
    emit_label(e, done_l)
    Drain(p.read, take, zero)
end drain_begin

// **A loop `lo ..< hi` that reaches the end of the live prefix takes every slot from `lo` on**, so the
// prefix is cut back to `lo` and nothing is zeroed. Only where the range is a real one: `lo` not past
// `hi`, and not negative, since a range that runs no turn takes nothing. A variable wider than an
// address is left to the zeroing, its bounds being able to say something the slots cannot.
private drain_loop_prefix(e: *Emit, elem: Type, owner: Val, lo: TExpr, hi: TExpr, ty: Type, zero: Val,
                          done_l: string)
    val shape = underlying(ty) match
        Integer(bits, signed, _) -> (bits, signed)
        _ -> return

    if shape.0 > e.word_bits then return

    val w = lty(e, ty)
    val lo_v = gen_expr(e, lo)
    val hi_v = gen_expr(e, hi)
    val ordered = fresh_reg(e)

    emit(e, InIntCmp(ordered, int_pred(e, "<=", underlying(ty)), w, lo_v, hi_v))

    var ok = ordered

    if shape.1
        val from_zero = fresh_reg(e)

        emit(e, InIntCmp(from_zero, ISge, w, lo_v, VZero))

        val both = fresh_reg(e)

        emit(e, InBin(both, OpAnd, l_i1(), ordered, from_zero))
        ok = both
    end if

    val range_l = fresh_label(e, "drain.range")
    val tail_l = fresh_label(e, "drain.tail")

    emit_term(e, InCondBr(ok, range_l, done_l))
    emit_label(e, range_l)

    val lo_w = convert_int(e, shape.0, shape.1, e.word_bits, lo_v)
    val hi_w = convert_int(e, shape.0, shape.1, e.word_bits, hi_v)
    val lp = slot_header(e, elem, owner, header_fields())
    val live = fresh_reg(e)

    emit(e, InLoad(live, word_lty(e), lp, AccPlain, None))

    val covers = fresh_reg(e)

    emit(e, InIntCmp(covers, IUge, word_lty(e), hi_w, live))
    emit_term(e, InCondBr(covers, tail_l, done_l))
    emit_label(e, tail_l)
    cut_prefix(e, lo_w, live, lp, zero)
end drain_loop_prefix

// **A run that reaches the end of the live prefix** is the loop's case, measured by address: the run's
// first slot is where the prefix is cut back to.
private drain_run_prefix(e: *Emit, d: Drain, elem: Type, owner: Val, start: Val, n: Val)
    val check_l = fresh_label(e, "drain.check")
    val tail_l = fresh_label(e, "drain.tail")
    val go_l = fresh_label(e, "drain.go")
    val take = fresh_reg(e)

    emit(e, InLoad(take, l_i1(), d.take, AccPlain, None))
    emit_term(e, InCondBr(take, check_l, go_l))
    emit_label(e, check_l)

    val lp = slot_header(e, elem, owner, header_fields())
    val live = fresh_reg(e)

    emit(e, InLoad(live, word_lty(e), lp, AccPlain, None))

    val data = slot_header(e, elem, owner, buf_elems_field(e, elem))
    val edge = slot_at(e, elem, data, live)
    val past = slot_at(e, elem, start, n)
    val covers = fresh_reg(e)

    emit(e, InIntCmp(covers, IUge, LPtr, past, edge))
    emit_term(e, InCondBr(covers, tail_l, go_l))
    emit_label(e, tail_l)
    cut_prefix(e, slot_distance(e, data, start, element_size(e, elem)), live, lp, d.zero)
    emit_term(e, InBr(go_l))
    emit_label(e, go_l)
end drain_run_prefix

// The live prefix at `lp` cut back to `at` where that is shorter, and the taken slots left as they are.
private cut_prefix(e: *Emit, at: Val, live: Val, lp: Val, zero: Val)
    val below = fresh_reg(e)

    emit(e, InIntCmp(below, IUlt, word_lty(e), at, live))

    val kept = fresh_reg(e)

    emit(e, InSelect(kept, below, word_lty(e), at, live, l_i1()))
    emit(e, InStore(word_lty(e), kept, lp, AccPlain, None))
    emit(e, InStore(l_i1(), VBool(false), zero, AccPlain, None))
end cut_prefix

// The element `x` (`s[i]`) reads, taken where the drain takes and counted where it does not.
private drain_read(e: *Emit, d: Drain, x: TExpr, elem: Type) -> Val
    val parts = *x.kind match
        TIndex(r, i, _) -> (r, i)
        _ -> return gap_at(e, "a drained read that is not a subscript")

    val p = element_addr(e, parts.0, parts.1, x.span)
    val v = fresh_reg(e)

    emit(e, InLoad(v, lty(e, elem), p, AccPlain, None))
    drain_count(e, d, elem, v, p)
    v
end drain_read

// The count `v`, read from the slot at `at`, owes: its slot's share where the drain takes -- the slot
// zeroed behind it where the hook would still walk it -- and a retain where it does not.
private drain_count(e: *Emit, d: Drain, elem: Type, v: Val, at: Val)
    val taken_l = fresh_label(e, "drain.taken")
    val shared_l = fresh_label(e, "drain.shared")
    val clear_l = fresh_label(e, "drain.clear")
    val join_l = fresh_label(e, "drain.read")
    val take = fresh_reg(e)

    emit(e, InLoad(take, l_i1(), d.take, AccPlain, None))
    emit_term(e, InCondBr(take, taken_l, shared_l))
    emit_label(e, shared_l)
    retain_value(e, elem, v)
    emit_term(e, InBr(join_l))
    emit_label(e, taken_l)

    val zero = fresh_reg(e)

    emit(e, InLoad(zero, l_i1(), d.zero, AccPlain, None))
    emit_term(e, InCondBr(zero, clear_l, join_l))
    emit_label(e, clear_l)
    emit(e, InStore(lty(e, elem), zero_of(e, elem), at, AccPlain, None))
    emit_term(e, InBr(join_l))
    emit_label(e, join_l)
end drain_count

// -- relocating: a drain that takes the rest of the prefix moves the bytes ---------------------------------

// **A drain whose `zero` was cleared has taken every slot from the copy's start to the end of the old
// live prefix, and that prefix was cut back to the start** (`cut_prefix`), so the old storage lets go
// of none of them: each element's count is the slot's share, handed over whole. Placed slot by slot,
// each lands in the first free slot of the fresh storage and raises its prefix by one, so where the
// destination's first free slot is exactly where the copy starts, the whole copy is the elements' bytes
// moved at once and the prefix raised by the run's length -- a relocation, as C++'s growth is. The
// caller has found that every destination slot the copy reaches exists; anything else here (`zero`
// still set, storage that is not a buffer of these slots, a first free slot elsewhere) goes to `slow_l`,
// the copy as written. Branches to `moved_l` once moved.
private relocate_to(e: *Emit, zero: Val, elem: Type, owner: Val, at: Val, first: Val, src: Val, n: Val,
                    side: IrAccess, moved_l: string, slow_l: string)
    val whole_l = fresh_label(e, "drain.whole")
    val buffer_l = fresh_label(e, "drain.into")
    val go_l = fresh_label(e, "drain.relocate")
    val z = fresh_reg(e)

    emit(e, InLoad(z, l_i1(), zero, AccPlain, None))
    emit_term(e, InCondBr(z, slow_l, whole_l))
    emit_label(e, whole_l)
    buffer_test(e, elem, owner, buffer_l, slow_l, side)
    emit_label(e, buffer_l)

    val lp = slot_header(e, elem, owner, header_fields())
    val live = fresh_reg(e)

    emit(e, InLoad(live, word_lty(e), lp, side, None))

    val at_edge = fresh_reg(e)

    emit(e, InIntCmp(at_edge, IEq, word_lty(e), live, at))
    emit_term(e, InCondBr(at_edge, go_l, slow_l))
    emit_label(e, go_l)

    val bytes = fresh_reg(e)

    emit(e, InBin(bytes, OpMul, word_lty(e), n, element_size(e, elem)))
    emit_memmove(e, first, src, bytes, int(e.layout.align(elem)))

    val grown = fresh_reg(e)

    emit(e, InBin(grown, OpAdd, word_lty(e), at, n))
    emit(e, InStore(word_lty(e), grown, lp, side, None))
    emit_term(e, InBr(moved_l))
end relocate_to

// `relocate_to` for a drained `slot_place_run`, whose bounds are already tested: the emitter is left
// on the slot-by-slot copy, and the label answered is where the relocation rejoins it.
private relocate(e: *Emit, zero: Val, elem: Type, owner: Val, at: Val, first: Val, src: Val, n: Val,
                 side: IrAccess) -> string
    val moved_l = fresh_label(e, "drain.relocated")
    val slow_l = fresh_label(e, "drain.each")

    relocate_to(e, zero, elem, owner, at, first, src, n, side, moved_l, slow_l)
    emit_label(e, slow_l)
    moved_l
end relocate

// The end of the copy as written, joined by the relocation that went around it.
relocate_join(e: *Emit, moved_l: string)
    emit_term(e, InBr(moved_l))
    emit_label(e, moved_l)
end relocate_join

// `x`, an integer of `shape`, at the width of an address.
private word_of(e: *Emit, x: TExpr, shape: (int, bool)) -> Val =
    convert_int(e, shape.0, shape.1, e.word_bits, gen_expr(e, x))

// A branch to `slow_l` unless `ok`.
private or_slow(e: *Emit, ok: Val, slow_l: string)
    val next_l = fresh_label(e, "drain.fits")

    emit_term(e, InCondBr(ok, next_l, slow_l))
    emit_label(e, next_l)
end or_slow

/** **A drained counted loop, relocated where it can be**: emitted just before the loop, which follows
 * it as the slow path. The turns `lo ..< hi` place at `j(lo) ..< j(lo) + (hi - lo)`, so the relocation
 * asks what the loop's own bounds tests would: that `hi` is within the old storage and every slot from
 * `j(lo)` on exists in the destination. A shift that wraps or is negative is left to the loop. Answers
 * the label the loop must branch to once it ends, or None where nothing was emitted -- a loop that
 * steps no shape this reads, a variable wider than an address, or a machine with nothing to move bytes.
 */
drain_relocate_loop(e: *Emit, p: DrainPlan, d: Drain) -> Option[string]
    if !moves_bytes(e) || p.bounds.is_none() || p.into.is_none() then return None

    val b = p.bounds.unwrap()
    val into = p.into.unwrap()
    val shape = underlying(b.2) match
        Integer(bits, signed, _) -> (bits, signed)
        _ -> return None

    if shape.0 > e.word_bits then return None

    val same = into.2 match
        Some(c) -> underlying(texpr_type(c)) match
            Integer(bits, signed, _) -> bits == shape.0 && signed == shape.1
            _ -> false
        None -> true

    if !same then return None

    val elem = p.elem
    val moved_l = fresh_label(e, "drain.relocated")
    val slow_l = fresh_label(e, "drain.each")
    val decided_l = fresh_label(e, "drain.bounds")
    val z = fresh_reg(e)

    // The bounds are read only where the drain covered the prefix, which is where `lo <= hi` holds.
    emit(e, InLoad(z, l_i1(), d.zero, AccPlain, None))
    emit_term(e, InCondBr(z, slow_l, decided_l))
    emit_label(e, decided_l)

    val lo = word_of(e, b.0, shape)
    val hi = word_of(e, b.1, shape)
    val n = fresh_reg(e)

    emit(e, InBin(n, OpSub, word_lty(e), hi, lo))

    val start = into.2 match
        None -> lo
        Some(c) ->
            val cw = word_of(e, c, shape)
            val at = fresh_reg(e)

            if shape.1
                val nonneg = fresh_reg(e)

                emit(e, InIntCmp(nonneg, ISge, word_lty(e), cw, VZero))
                or_slow(e, nonneg, slow_l)
            end if

            val kept = fresh_reg(e)

            if into.1 == "+"
                emit(e, InBin(at, OpAdd, word_lty(e), lo, cw))
                emit(e, InIntCmp(kept, IUge, word_lty(e), at, lo))
            else
                emit(e, InIntCmp(kept, IUle, word_lty(e), cw, lo))
                emit(e, InBin(at, OpSub, word_lty(e), lo, cw))
            end if

            or_slow(e, kept, slow_l)
            at

    val from = slot_view(e, p.source)
    val read_fits = fresh_reg(e)

    emit(e, InIntCmp(read_fits, IUle, word_lty(e), hi, from.2))
    or_slow(e, read_fits, slow_l)

    val to = slot_view(e, into.0)
    val start_fits = fresh_reg(e)

    emit(e, InIntCmp(start_fits, IUle, word_lty(e), start, to.2))
    or_slow(e, start_fits, slow_l)

    val room = fresh_reg(e)

    emit(e, InBin(room, OpSub, word_lty(e), to.2, start))

    val run_fits = fresh_reg(e)

    emit(e, InIntCmp(run_fits, IUle, word_lty(e), n, room))
    or_slow(e, run_fits, slow_l)
    relocate_to(e, d.zero, elem, to.0, start, slot_at(e, elem, to.1, start), slot_at(e, elem, from.1, lo),
                n, AccPlain, moved_l, slow_l)
    emit_label(e, slow_l)
    Some(moved_l)
end drain_relocate_loop

private gen_slot_vacate(e: *Emit, xs: TExpr, from: TExpr, elem: Type)
    val view = slot_view(e, xs)
    val n = widen_index(e, from, from.span, BoundsCountTooWide)
    val within = fresh_reg(e)

    emit(e, InIntCmp(within, IUle, word_lty(e), n, view.2))
    trap_unless(e, within, "bounds")

    if !contains_counted(elem) then return

    val buffer_l = fresh_label(e, "slot.buffer")
    val sole_l = fresh_label(e, "slot.sole")
    val drop_l = fresh_label(e, "slot.drop")
    val kept_l = fresh_label(e, "slot.kept")

    buffer_test(e, elem, view.0, buffer_l, kept_l, AccPlain)
    emit_label(e, buffer_l)

    // The strong count is the box's first word. Anything above one is a view or a second container
    // still reading these slots.
    val strong = fresh_reg(e)

    emit(e, InLoad(strong, word_lty(e), view.0, AccPlain, None))

    val sole = fresh_reg(e)

    emit(e, InIntCmp(sole, IEq, word_lty(e), strong, VInt(from_int(1))))
    emit_term(e, InCondBr(sole, sole_l, kept_l))
    emit_label(e, sole_l)

    val lp = slot_header(e, elem, view.0, header_fields())
    val live = fresh_reg(e)

    emit(e, InLoad(live, word_lty(e), lp, AccPlain, None))

    val data = slot_header(e, elem, view.0, buf_elems_field(e, elem))
    val cut = slot_at(e, elem, view.1, n)
    val edge = slot_at(e, elem, data, live)
    val more = fresh_reg(e)

    emit(e, InIntCmp(more, IUlt, LPtr, cut, edge))
    emit_term(e, InCondBr(more, drop_l, kept_l))
    emit_label(e, drop_l)

    val size = element_size(e, elem)
    val gone = slot_distance(e, cut, edge, size)
    val kept = slot_distance(e, data, cut, size)

    // **The prefix is shortened BEFORE anything is let go of**, so a destructor that reaches this
    // storage again finds the slots it is being run for already outside it.
    emit(e, InStore(word_lty(e), kept, lp, AccPlain, None))
    each_element_release(e, elem, cut, gone)
    emit_term(e, InBr(kept_l))
    emit_label(e, kept_l)
end gen_slot_vacate

// The owner, the first element and the length of a view.
private slot_view(e: *Emit, xs: TExpr) -> (Val, Val, Val)
    val lt = lty(e, texpr_type(xs))
    val v = gen_expr(e, xs)
    val owner = fresh_reg(e)

    emit(e, InExtract(owner, lt, v, index_list(0)))

    val (data, len) = view_data(e, v, texpr_type(xs))
    (owner, data, len)
end slot_view

// Branches to `yes` where `owner` is a buffer of `elem` -- non-null, and released through this element
// type's buffer hook -- and to `no` otherwise. The hook word is read as `side` says the storage is.
private buffer_test(e: *Emit, elem: Type, owner: Val, yes: string, no: string, side: IrAccess)
    val owned_l = fresh_label(e, "slot.owned")
    val present = fresh_reg(e)

    emit(e, InIntCmp(present, INe, LPtr, owner, VNull))
    emit_term(e, InCondBr(present, owned_l, no))
    emit_label(e, owned_l)

    val hook = fresh_reg(e)

    emit(e, InLoad(hook, LPtr, slot_header(e, elem, owner, 1), side, None))

    val mine = fresh_reg(e)

    emit(e, InIntCmp(mine, IEq, LPtr, hook, slot_buf_fn(e, elem)))
    emit_term(e, InCondBr(mine, yes, no))
end buffer_test

// The address of one word of a buffer box's header, or of its elements at `buf_elems_field`.
private slot_header(e: *Emit, elem: Type, owner: Val, field: int) -> Val
    val r = fresh_reg(e)

    var idx: Buf[IrArg] = buf()

    idx.push(ir_arg(l_i32(), VInt(from_int(0))))
    idx.push(ir_arg(l_i32(), VInt(from_int(long(field)))))
    emit(e, InGep(r, buf_lty(e, elem), owner, idx))
    r
end slot_header

private slot_at(e: *Emit, elem: Type, base: Val, i: Val) -> Val
    val r = fresh_reg(e)

    var idx: Buf[IrArg] = buf()

    idx.push(ir_arg(word_lty(e), i))
    emit(e, InGep(r, stride_lty(e, elem), base, idx))
    r
end slot_at

// How many bytes one element takes, as the address of element one past a null base.
private element_size(e: *Emit, elem: Type) -> Val
    val one = slot_at(e, elem, VNull, VInt(from_int(1)))
    val r = fresh_reg(e)

    emit(e, InCast(r, CastPtrToInt, LPtr, one, word_lty(e)))
    r
end element_size

// How many elements lie between two addresses into one buffer, `lo` first.
private slot_distance(e: *Emit, lo: Val, hi: Val, size: Val) -> Val
    val a = fresh_reg(e)

    emit(e, InCast(a, CastPtrToInt, LPtr, lo, word_lty(e)))

    val b = fresh_reg(e)

    emit(e, InCast(b, CastPtrToInt, LPtr, hi, word_lty(e)))

    val bytes = fresh_reg(e)

    emit(e, InBin(bytes, OpSub, word_lty(e), b, a))

    val r = fresh_reg(e)

    emit(e, InBin(r, OpUDiv, word_lty(e), bytes, size))
    r
end slot_distance
