module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.math.bigint.from_int

// **A data enum is a tag and one payload region**, wide enough for whichever variant needs the most.
// The region is a union, so a payload cannot be dropped in with `insertvalue` -- an aggregate value
// has no operation that reinterprets part of itself. It goes through a stack slot instead: written
// at the variant's own type, read back at the enum's.

// The address of the payload region inside an enum sitting at `base`.
payload_ptr(e: *Emit, d: &EnumType, base: Val) -> Val
    val r = fresh_reg(e)

    var idx: Buf[IrArg] = buf()

    idx.push(ir_arg(l_i32(), VInt(from_int(0))))
    idx.push(ir_arg(l_i32(), VInt(from_int(long(enum_payload_index(e.layout, d))))))
    emit(e, InGep(r, enum_lty(d), base, idx))
    r
end payload_ptr

// Reads a variant's payload out of an enum value, at that variant's type.
//
// Reading a variant the value is not holding yields whatever the one it *is* holding left there --
// which is what a pattern test does before it knows the tag, and the tag test beside it is what
// makes the answer count.
enum_payload(e: *Emit, d: &EnumType, v: EnumVariant, value: Val) -> Val
    val slot = scratch_slot(e, enum_lty(d))

    emit(e, InStore(enum_lty(d), value, slot, AccPlain, None))

    val p = payload_ptr(e, d, slot)
    val r = fresh_reg(e)

    emit(e, InLoad(r, variant_lty(d, v), p, AccPlain, None))
    r
end enum_payload

// Builds an enum value from already-lowered payload values: the tag, then the variant's payload
// aggregate written into the region every variant shares.
// Whether an integer is one of an enum's discriminants: one comparison per variant, or-ed together,
// **at 64 bits** so that a value wider than the enum's own representation cannot wrap into a tag it
// is not.
enum_membership(e: *Emit, en: Type, vt: Type, v: Val) -> Val
    val d = enum_decl(en)

    if d.is_none() then return VBool(false)

    val (vbits, signed) = vt match
        Integer(b, s, _) -> (b, s)
        _ -> (64, true)

    // A discriminant is a signed 64-bit number, so the comparison is made where the VALUE fits as a
    // signed number too: at 64 bits for every source that does, and wider for a `u64` -- whose top
    // half would otherwise read as negative and match `-1` -- or a 128-bit integer, whose high bits a
    // narrowing to 64 would throw away.
    val room = if signed then vbits else vbits + 1
    val w = if room <= 64 then 64 else if room <= 128 then 128 else room

    val vs = d.unwrap().variants
    val wide = convert(e, vt, Integer(w, signed, false), v)

    // **EVERY COMPARISON IS MADE BEFORE ANY OF THEM IS FOLDED**, which is the same rule an array
    // literal and a bitfield struct are written to: the operands come first and the chain that
    // collects them second. Interleaving them numbers the registers differently -- the reference's
    // third `icmp` is `%t5` and the first `or` is `%t6`, where a fold as you go makes them `%t6` and
    // `%t5` -- so the body is a mismatch in the differential sweep and identical as a program.
    var eqs: Buf[Val] = buf()

    for item in vs
        val eq = fresh_reg(e)

        emit(e, InIntCmp(eq, IEq, LInt(w), wide, VInt(from_int(long(item.tag)))))
        eqs.push(eq)

    var any = VBool(false)

    for i in 0..<eqs.len()
        any = if i == 0 then eqs.at(i) else or_i1(e, any, eqs.at(i))

    any
end enum_membership

// `Colour(n)` — the checked cast. The same membership test as `try`, but a miss stops the program,
// and the integer is then narrowed or widened into the enum's own representation: a value of
// another width is not a discriminant until it has been converted into one.
gen_enum_from_int(e: *Emit, value: TExpr, en: Type) -> Val
    val ed = enum_decl(en)

    if ed.is_none() then return gap_at(e, "a checked cast whose subject is not an enum")

    val vt = repr(texpr_type(value))
    val v = gen_expr(e, value)

    trap_unless(e, enum_membership(e, en, vt, v), "enum")
    convert(e, vt, ed.unwrap().underlying, v)
end gen_enum_from_int

// The receiver, field index and bit ranges of an enum field read out of a bitfield struct -- `s.ec`
// where `ec: Ec` -- which is the one place a value of an enum's type can hold a pattern no variant
// has. `E.try` takes such a field as it is (`member_call.sysl`'s `enum_try`) and reads its bits here.
unchecked_field_parts(t: TExpr) -> Option[(TExpr, int, Buf[BitRange])] = *t.kind match
    TField(receiver, index, ty) -> repr(ty) match
        Enum(_) -> bitfield_ranges_of(texpr_type(receiver)) match
            Some(ranges) -> Some((receiver, index, ranges))
            None -> None
        _ -> None
    _ -> None

// Whether `t` is such a field, of the enum `en` itself.
unchecked_enum_field(t: TExpr, en: Type) -> bool =
    unchecked_field_parts(t).is_some() && repr(texpr_type(t)) == repr(en)

// `Colour.try(n)` — the fallible conversion. The membership test picks the branch: a match builds
// `Some(n as Colour)` and a miss builds `None`, so the result is an ordinary `Option[Colour]` whose
// element carries no count and whose merge slot needs no ownership bookkeeping.
gen_enum_try(e: *Emit, value: TExpr, en: Type, opt_ty: Type, some: EnumVariant,
             none: EnumVariant) -> Val
    val d = enum_decl(opt_ty)
    val ed = enum_decl(en)

    if d.is_none() || ed.is_none() then return gap_at(e, "a try whose option is not an enum")

    // An enum field of a bitfield struct is read as its bits, unchecked: answering whether they are a
    // variant is what was asked, so the read's own check would stop the program before the answer.
    val (vt, v) = unchecked_field_parts(value) match
        Some((receiver, index, ranges)) ->
            (repr(ed.unwrap().underlying), bitfield_field_bits(e, receiver, index, ranges))
        None -> (repr(texpr_type(value)), gen_expr(e, value))

    var carried: Buf[Val] = buf()

    // Where the value is already at the enum's own representation and the variants cover every
    // pattern it can hold, there is nothing to ask: the answer is `Some`, with no test and no branch.
    if vt == repr(ed.unwrap().underlying)
        val bits = lty(e, vt) match
            LInt(b) -> b
            _ -> 64

        if bits <= 64 && every_value_a_variant(ed.unwrap(), bits)
            carried.push(v)
            return enum_value(e, opt_ty, d.unwrap(), some, carried)
        end if
    end if

    val ok = enum_membership(e, en, vt, v)
    val slot = alloca(e, fresh_reg(e), lty(e, opt_ty))
    val some_l = fresh_label(e, "try.some")
    val none_l = fresh_label(e, "try.none")
    val end_l = fresh_label(e, "try.end")

    emit_term(e, InCondBr(ok, some_l, none_l))
    emit_label(e, some_l)
    carried.push(convert(e, vt, ed.unwrap().underlying, v))
    emit(e, InStore(lty(e, opt_ty), enum_value(e, opt_ty, d.unwrap(), some, carried), slot, AccPlain,
                    None))
    emit_term(e, InBr(end_l))
    emit_label(e, none_l)

    var empty: Buf[Val] = buf()

    emit(e, InStore(lty(e, opt_ty), enum_value(e, opt_ty, d.unwrap(), none, empty), slot, AccPlain,
                    None))
    emit_term(e, InBr(end_l))
    emit_label(e, end_l)

    val r = fresh_reg(e)

    emit(e, InLoad(r, lty(e, opt_ty), slot, AccPlain, None))
    r
end gen_enum_try

enum_value(e: *Emit, en: Type, d: &EnumType, v: EnumVariant, vals: Buf[Val]) -> Val
    if d.simple then return VInt(from_int(long(v.tag)))

    if !v.carries
        val tagged = fresh_reg(e)

        emit(e, InInsert(tagged, enum_lty(d), VUndef, l_i32(), VInt(from_int(long(v.tag))),
                         index_list(0)))
        return tagged

    var payload: Val = VUndef

    for i in 0..<vals.len()
        if !zero_sized(v.fields.at(i).1)
            val r = fresh_reg(e)

            emit(e, InInsert(r, variant_lty(d, v), payload, lty(e, v.fields.at(i).1), vals.at(i),
                             index_list(variant_field_index(e.layout, v, v.slot(i)))))
            payload = r

    val slot = scratch_slot(e, enum_lty(d))

    emit(e, InStore(l_i32(), VInt(from_int(long(v.tag))), slot, AccPlain, None))

    val p = payload_ptr(e, d, slot)

    emit(e, InStore(variant_lty(d, v), payload, p, AccPlain, None))

    val r = fresh_reg(e)

    emit(e, InLoad(r, enum_lty(d), slot, AccPlain, None))
    r
end enum_value

// The declaration behind an enum type, where the type is one.
enum_decl(t: Type) -> Option[&EnumType] = underlying(t) match
    Enum(d) -> Some(d)
    _ -> None

// The values one variant's payload holds, read out of an enum value -- or nothing at all where the
// variant carries none. A zero-sized field is skipped, which is the same skipping the layout does
// seen from the reading side.
payload_values(e: *Emit, d: &EnumType, v: EnumVariant, value: Val) -> Buf[Val]
    var out: Buf[Val] = buf()

    if !v.carries then return out

    val p = enum_payload(e, d, v, value)

    for i in 0..<v.fields.len()
        if zero_sized(v.fields.at(i).1) then out.push(VNothing)
        else
            val f = fresh_reg(e)

            emit(e, InExtract(f, variant_lty(d, v), p, index_list(variant_field_index(e.layout, v, v.slot(i)))))
            out.push(f)

    out
end payload_values
