module sh.sysl.compiler
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// What the parser suites assert through.
//
// **A tree is pinned as the shape it prints, not as a struct compared field by field.** `(+ 1 (* 2
// 3))` says at a glance what precedence and associativity the parser chose, which a nested
// constructor call in an expected value does not -- and a shape that is wrong reads as a wrong
// shape rather than as a diff. `show.sysl` is the renderer, and it exists for this.

// One expression, as a shape. A refusal comes back marked, so a test that expected a tree and got a
// complaint says which complaint.
pe(text: string) -> string
    val r = parse_expr_text("t.sysl", text)

    if r.ok() then show_expr(r.value) else s"!${r.first().message}"

// The first thing wrong with an expression, or `""` where nothing was.
pe_err(text: string) -> string
    val r = parse_expr_text("t.sysl", text)

    if r.ok() then "" else r.first().message

// Where the first complaint about an expression points, as the reader's own `line:column`.
pe_at(text: string) -> string
    val r = parse_expr_text("t.sysl", text)

    if r.ok() then "" else str(r.at())

// One type, as a shape.
pt(text: string) -> string
    val r = parse_type_text("t.sysl", text)

    if r.ok() then show_type(r.value) else s"!${r.first().message}"

// One type, as a program would have written it -- the form a diagnostic quotes back.
pt_text(text: string) -> string
    val r = parse_type_text("t.sysl", text)

    if r.ok() then type_text(r.value) else s"!${r.first().message}"

pt_err(text: string) -> string
    val r = parse_type_text("t.sysl", text)

    if r.ok() then "" else r.first().message

// One pattern, as a shape.
pp(text: string) -> string
    val r = parse_pattern_text("t.sysl", text)

    if r.ok() then show_pattern(r.value) else s"!${r.first().message}"

pp_err(text: string) -> string
    val r = parse_pattern_text("t.sysl", text)

    if r.ok() then "" else r.first().message

// A whole file's statements, as one shape.
pf(text: string) -> string
    val r = parse(source_of("t.sysl", text))

    if r.ok() then show_stmts(r.program.body) else s"!${r.first().message}"

// The tree a file left behind, complaints and all -- which is what recovery is judged by.
pf_tree(text: string) -> string = show_stmts(parse(source_of("t.sysl", text)).program.body)

pf_err(text: string) -> string
    val r = parse(source_of("t.sysl", text))

    if r.ok() then "" else r.first().message

// Where the first complaint about a file points, as the reader's own `line:column`.
pf_at(text: string) -> string
    val r = parse(source_of("t.sysl", text))

    if r.ok() then "" else str(r.at())

// Every complaint a file yields, as the lines they sit on, in the order a reader meets them.
pf_lines(text: string) -> Buf[usize]
    val r = parse(source_of("t.sysl", text))
    var out: Buf[usize] = buf()

    for i in 0..<r.report.len()
        out.push(r.src.locate(r.report.at(i).span.start).line)

    out
end pf_lines

// The same, as text, so that a failing assertion prints what was reported.
pf_line_text(text: string) -> string
    val lines = pf_lines(text)
    var out = ""

    for i in 0..<lines.len()
        if i > 0 then out = out + " "

        out = out + str(lines.at(i))

    out
end pf_line_text

// How many statements a file kept, which is what recovery is judged by.
pf_kept(text: string) -> usize = parse(source_of("t.sysl", text)).program.body.len()

// A bracketed type-parameter list, as a shape.
ptp(text: string) -> string
    val src = source_of("t.sysl", text)

    parser_over(src) match
        Err(d) -> s"!${d.message}"
        Ok(started) ->
            var p = started

            p.skip_layout()

            val ps = parse_type_params(&p)

            if p.report.is_empty() then show_type_params(ps) else s"!${p.report.at(0).message}"
end ptp

// A `where` clause, as a shape. The word itself is written by the caller, so the text here starts
// after it.
pwb(text: string) -> string
    val src = source_of("t.sysl", text)

    parser_over(src) match
        Err(d) -> s"!${d.message}"
        Ok(started) ->
            var p = started

            p.skip_layout()

            val ws = parse_where_bounds(&p)

            if p.report.is_empty() then show_where_bounds(ws) else s"!${p.report.at(0).message}"
end pwb

// The module a file declared, or `""` where it declared none.
pf_module(text: string) -> string = parse(source_of("t.sysl", text)).program.module_name match
    Some(m) -> m.show()
    None -> ""

// Everything a file's header said, as one shape: the capabilities in the order they were written,
// the libraries, the headers, and whether the file is compiled only for a test run.
pf_header(text: string) -> string
    val program = parse(source_of("t.sysl", text)).program
    var out = ""

    if program.test_only then out = out + "@tests"

    for i in 0..<program.capabilities.len()
        val c = program.capabilities.at(i)

        if out != "" then out = out + " "

        out = out + (c.direction match
            Narrows -> s"@no_${c.name}"
            Requires -> s"@requires(${c.name})")

    for i in 0..<program.links.len()
        if out != "" then out = out + " "

        out = out + s"@link(\"${program.links.at(i).name}\")"

    for i in 0..<program.includes.len()
        if out != "" then out = out + " "

        out = out + s"@include(\"${program.includes.at(i).header}\")"

    out
end pf_header

// The documentation comments a file carried, in source order.
pf_docs(text: string) -> string
    val program = parse(source_of("t.sysl", text)).program
    var out = ""

    for i in 0..<program.docs.len()
        if i > 0 then out = out + " | "

        out = out + program.docs.at(i).body

    out
end pf_docs

// A literate file, read the way its own name says it should be.
pl(text: string) -> string
    val r = parse(source_of("t.lsysl", text))

    if r.ok() then show_stmts(r.program.body) else s"!${r.first().message}"

pl_err(text: string) -> string
    val r = parse(source_of("t.lsysl", text))

    if r.ok() then "" else r.first().message

pl_at(text: string) -> string
    val r = parse(source_of("t.lsysl", text))

    if r.ok() then "" else str(r.at())
