module demo

struct Pair
    a: int
    b: int

    sum(self) -> int = self.a + self.b
    scaled(self, by: int) -> Pair = Pair(self.a * by, self.b * by)
    origin() -> Pair = Pair(0, 0)

trait Widen
    widen(self) -> int

impl Widen for Pair
    widen(self) -> int = self.sum() * 10

enum Shade
    Light
    Dark

    flip(self) -> Shade =
        self match
            Light -> Shade.Dark
            Dark -> Shade.Light
