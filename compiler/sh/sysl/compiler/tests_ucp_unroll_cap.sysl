module sh.sysl.compiler
@tests

import sysl.text.Search

// A `for const` over a type's own parts -- `T::Fields`, `T::Members`, `T::Variants` -- unrolls to as
// many copies as the type has, with no cap: the declaration is the bound, so the std derivations
// (`Eq`, `Ord`, `Hash`, `Display`, the automatic `Debug`) and a library's own reach a type of any
// size. The 64-copy cap stays on a range. And a derivation's size is linear in the type's: one
// `x.(c)` is one test, whatever the enum's size (`reference/generics.md § A for const over a type's
// own make-up`).

// `enum Big` with `n` variants, every tenth carrying an `int`, deriving `derives` (none if empty).
private ucp_enum(n: int, derives: string) -> string
    var out = if derives == "" then "enum Big\n" else s"enum Big derives $derives\n"

    for i in 1..n
        out = out + (if i % 10 == 0 then s"    V$i(n: int)\n" else s"    V$i\n")

    out + "\n"
end ucp_enum

// A struct with `n` `int` fields `f1`..`fn`, deriving all four.
private ucp_struct(n: int) -> string
    var out = "struct Wide derives Eq, Ord, Hash, Display\n"

    for i in 1..n
        out = out + s"    f$i: int\n"

    out + "\n"
end ucp_struct

// `Wide(1, 2, …, n)` with the last value raised by `bump`.
private ucp_wide(n: int, bump: int) -> string
    var out = "Wide("

    for i in 1..n
        out = out + (if i > 1 then ", " else "") + str(if i == n then i + bump else i)

    out + ")"
end ucp_wide

private ucp_eq_main(n: int) -> string =
    s"val last = Big.V${n - 1}\n" +
    s"print(str(Big.V2 == last), str(last == Big.V${n - 1}), str(Big.V10(1) == Big.V10(1)), " +
    "str(Big.V10(1) == Big.V10(2)))\n"

private ucp_ord_main(n: int) -> string =
    s"val last = Big.V${n - 1}\n" +
    "print(str(Big.V2 < last), str(last < Big.V2), str(Big.V10(1) < Big.V10(2)), " +
    "str(Big.V20(0) < Big.V10(9)))\n"

private ucp_hash_main(n: int) -> string =
    s"val last = Big.V${n - 1}\n" +
    s"print(str(last.hash() == Big.V${n - 1}.hash()), str(Big.V1.hash() == Big.V2.hash()), " +
    "str(Big.V10(1).hash() == Big.V10(2).hash()))\n"

private ucp_display_main(n: int) -> string =
    s"print(str(Big.V1))\nprint(str(Big.V${n - 1}))\nprint(str(Big.V10(7)))\n"

private ucp_debug_main(n: int) -> string =
    s"print(debug(Big.V1))\nprint(debug(Big.V${n - 1}))\n" + "print(f\"" + "$" + "{Big.V10(7)}%?\")\n"

private ucp_runs(n: int, derives: string, main: string, want: string)
    if !enm_ready() then return

    assert_eq(enm_ran(ucp_enum(n, derives) + main), want)

// ---- each std derivation, past the range cap and well past it ----

@test("a 65-variant enum derives Eq")
ucp_eq_65() = ucp_runs(65, "Eq", ucp_eq_main(65), "false true true false\n")

@test("a 300-variant enum derives Eq")
ucp_eq_300() = ucp_runs(300, "Eq", ucp_eq_main(300), "false true true false\n")

@test("a 65-variant enum derives Ord")
ucp_ord_65() = ucp_runs(65, "Eq, Ord", ucp_ord_main(65), "true false true false\n")

@test("a 300-variant enum derives Ord")
ucp_ord_300() = ucp_runs(300, "Eq, Ord", ucp_ord_main(300), "true false true false\n")

@test("a 65-variant enum derives Hash")
ucp_hash_65() = ucp_runs(65, "Eq, Hash", ucp_hash_main(65), "true false false\n")

@test("a 300-variant enum derives Hash")
ucp_hash_300() = ucp_runs(300, "Eq, Hash", ucp_hash_main(300), "true false false\n")

@test("a 65-variant enum derives Display")
ucp_display_65() = ucp_runs(65, "Display", ucp_display_main(65), "V1\nV64\nV10(7)\n")

@test("a 300-variant enum derives Display")
ucp_display_300() = ucp_runs(300, "Display", ucp_display_main(300), "V1\nV299\nV10(7)\n")

// Every type has a `Debug`, so this one is reached with no `derives` at all.
@test("a 65-variant enum with no derives clause still has its automatic Debug")
ucp_debug_65() =
    ucp_runs(65, "", ucp_debug_main(65), "Big.V1\nBig.V64\nBig.V10(n: 7)\n")

@test("a 300-variant enum with no derives clause still has its automatic Debug")
ucp_debug_300() =
    ucp_runs(300, "", ucp_debug_main(300), "Big.V1\nBig.V299\nBig.V10(n: 7)\n")

@test("a 65-field struct derives all four, and its Debug walks every field")
ucp_struct_65()
    if !enm_ready() then return

    val a = ucp_wide(65, 0)
    val b = ucp_wide(65, 1)
    var shown = "Wide("

    for i in 1..65
        shown = shown + (if i > 1 then ", " else "") + s"f$i: ${if i == 65 then 66 else i}"

    assert_eq(enm_ran(ucp_struct(65) + s"val a = $a\nval b = $b\nprint(str(a))\n" +
                      "print(str(a == a), str(a == b), str(a < b), str(b < a), " +
                      "str(a.hash() == a.hash()), str(a.hash() == b.hash()))\n" +
                      "print(debug(b))\n"),
              s"$a\ntrue false true false true false\n$shown)\n")
end ucp_struct_65

// ---- a library's own derivation ----

private ucp_library_traits() -> string = raw"""
    trait Count
        count(self) -> int

        derive[T] count(self: T) -> int
            var n = 0

            for const c in T::Variants
                n += 1

            n

    trait Position
        position(self) -> usize

        derive[T] position(self: T) -> usize
            for const c in T::Variants
                if self is c then return c.index

            0

    trait Total
        total(self) -> int

        derive[T] total(self: T) -> int
            var s = 0

            for const f in T::Fields
                s += self.(f)

            s

    """

@test("a library's derivation walks a 100-variant enum and a 100-field struct")
ucp_library_derive_100()
    if !enm_ready() then return

    var wide = "struct Wide derives Total\n"

    for i in 1..100
        wide = wide + s"    f$i: int\n"

    val src = ucp_library_traits() + ucp_enum(100, "Count, Position") + wide + "\n" +
              s"print(str(Big.V1.count()), str(Big.V73.position()), str(Big.V100(4).position()))\n" +
              s"print(str(${ucp_wide(100, 0)}.total()))\n"

    assert_eq(enm_ran(src), "100 72 99\n5050\n")
end ucp_library_derive_100

// ---- what the size costs ----

// `x.(c)` on a variant the value does not hold names the one it does, and that is one table read
// while the program runs -- not an arm per other variant in each of a walk's copies, which made
// the lowered derivation grow with the square of the enum.
@test("'x.(c)' on another variant of a 100-variant enum names the held variant")
ucp_payload_trap_names_held_variant()
    if !enm_ready() then return

    val out = enm_outcome(ucp_enum(100, "") + raw"""
        ten(x: Big) -> int
            var out = 0

            for const c in Big::Variants
                if const c.name == "V10" then out = x.(c)

            out

        print(ten(Big.V10(7)))
        print(ten(Big.V20(3)))
        """)

    assert(!out.1, out.0)
    assert(out.0.starts_with("7\nvariant 'Big.V10' was asked for, and the value is 'Big.V20' ("), out.0)
end ucp_payload_trap_names_held_variant

@test("a derivation's lowered size grows with the enum, not with its square")
ucp_lowered_size_is_linear()
    if !enm_ready() then return

    val main = "print(debug(Big.V1) + str(Big.V1 == Big.V2) + str(Big.V1 < Big.V2))\n"
    val small = enm_ir(ucp_enum(100, "Eq, Ord") + main).bytes.len
    val large = enm_ir(ucp_enum(400, "Eq, Ord") + main).bytes.len

    // Four times the variants: about four times the text where it is linear, sixteen where it is not.
    assert(large < small * 6, s"100 variants lowered to $small bytes, 400 to $large")
end ucp_lowered_size_is_linear

// ---- the cap that stays ----

@test("a 'for const' over a range is still refused past 65 copies, in the same words")
ucp_range_cap_still_refuses()
    if !enm_ready() then return

    assert_eq(enm_err("f()\n    for const i in 0..<65\n        print(i)\nf()\n"), "")

    val out = enm_err("f()\n    for const i in 0..<66\n        print(i)\nf()\n")

    assert(enm_says(out, "a 'for const' over 66 values would emit that many copies of its body, and " +
                         "64 is the most one is unrolled to — a loop this long is a run-time 'for', " +
                         "which costs one copy whatever it counts to"), out)
end ucp_range_cap_still_refuses
