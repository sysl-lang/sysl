module sysl.container
@tests

/** What the deque promises. The interesting failures are all in the wrapping -- an index that is
 * correct while the ring happens to start at zero and wrong once it does not -- so most of these
 * arrange for the ring to be wrapped before they assert anything.
 */

@test("a fresh deque is empty and has nothing at either end")
deque_fresh_is_empty()
    var d: Deque[int] = deque()

    assert_eq(d.len(), 0)
    assert(d.is_empty())
    assert_eq(d.first(), None)
    assert_eq(d.last(), None)
    assert_eq(d.pop_front(), None)
    assert_eq(d.pop_back(), None)
end deque_fresh_is_empty

@test("pushing on the back reads back in order")
push_back_is_a_queue()
    var d: Deque[int] = deque()

    d.push_back(1)
    d.push_back(2)
    d.push_back(3)

    assert_eq(d.len(), 3)
    assert_eq(d.first(), Some(1))
    assert_eq(d.last(), Some(3))
    assert_eq(d[0], 1)
    assert_eq(d[2], 3)
end push_back_is_a_queue

/** The end a `Buf` has no answer for at all, and the one that steps `head` backwards past zero. */
@test("pushing on the front reverses the order")
push_front_prepends()
    var d: Deque[int] = deque()

    d.push_front(1)
    d.push_front(2)
    d.push_front(3)

    assert_eq(d.len(), 3)
    assert_eq(d[0], 3)
    assert_eq(d[1], 2)
    assert_eq(d[2], 1)
    assert_eq(d.first(), Some(3))
    assert_eq(d.last(), Some(1))
end push_front_prepends

@test("both ends can be taken from")
pops_from_both_ends()
    var d: Deque[int] = deque()

    for i in 0..<5
        d.push_back(i)

    assert_eq(d.pop_front(), Some(0))
    assert_eq(d.pop_back(), Some(4))
    assert_eq(d.len(), 3)
    assert_eq(d[0], 1)
    assert_eq(d[2], 3)
end pops_from_both_ends

/** A ring whose head is not at zero is the state every index calculation has to be right for, so this
 * forces one and then checks every accessor against it.
 */
@test("indexing counts from the front once the ring has wrapped")
indexing_when_wrapped()
    var d: Deque[int] = deque()

    for i in 0..<8
        d.push_back(i)

    for i in 0..<5
        assert(d.pop_front().is_some())

    for i in 100..<104
        d.push_back(i)

    assert_eq(d.len(), 7)
    assert_eq(d[0], 5)
    assert_eq(d[1], 6)
    assert_eq(d[2], 7)
    assert_eq(d[3], 100)
    assert_eq(d[6], 103)
    assert_eq(d.first(), Some(5))
    assert_eq(d.last(), Some(103))
end indexing_when_wrapped

@test("set writes through to the element the index names")
set_writes_at_the_front_relative_index()
    var d: Deque[int] = deque()

    for i in 0..<6
        d.push_back(i)

    assert(d.pop_front().is_some())
    assert(d.pop_front().is_some())

    d[0] = 99
    d.set(2, 77)

    assert_eq(d[0], 99)
    assert_eq(d[1], 3)
    assert_eq(d[2], 77)
end set_writes_at_the_front_relative_index

// -- growth ---------------------------------------------------------------------------------------

/** Growing a ring that is wrapped is the case that gets written wrong: the elements have to be laid
 * down in *logical* order, not copied slot for slot, or the sequence comes back rotated.
 */
@test("growing a wrapped ring keeps the order")
growth_unwraps_correctly()
    var d: Deque[int] = deque()

    for i in 0..<8
        d.push_back(i)

    for i in 0..<6
        assert(d.pop_front().is_some())

    // head is now at 6 of 8; these wrap around the end
    for i in 100..<110
        d.push_back(i)

    assert_eq(d.len(), 12)
    assert_eq(d[0], 6)
    assert_eq(d[1], 7)

    var seat: usize = 2

    for i in 0..<10
        assert_eq(d[seat], 100 + i)
        seat += 1
end growth_unwraps_correctly

@test("the storage doubles from eight and stays a power of two")
deque_growth_is_geometric()
    var d: Deque[int] = deque()

    assert_eq(d.cap(), 0)

    d.push_back(1)
    assert_eq(d.cap(), 8)

    for i in 0..<8
        d.push_back(i)

    assert_eq(d.len(), 9)
    assert_eq(d.cap(), 16)
end deque_growth_is_geometric

@test("a reserved deque rounds its storage up to a power of two")
reserved_rounds_up()
    val d = deque_with_capacity(100, 0)

    assert_eq(d.cap(), 128)
    assert_eq(d.len(), 0)

/** **The reason this module exists.** A FIFO run far past its own size must stay correct while the
 * ring wraps many times and the storage grows underneath it.
 */
@test("a queue driven far past its size stays in order")
long_fifo_stays_in_order()
    var d: Deque[int] = deque()
    var next_out = 0

    for i in 0..<5000
        d.push_back(i)

        if i % 3 == 0
            assert_eq(d.pop_front(), Some(next_out))
            next_out += 1

    assert_eq(d.len(), usize(5000 - next_out))
    assert_eq(d.first(), Some(next_out))
    assert_eq(d.last(), Some(4999))
end long_fifo_stays_in_order

@test("a deque used as a stack at the front is also in order")
front_stack_stays_in_order()
    var d: Deque[int] = deque()

    for i in 0..<1000
        d.push_front(i)

    assert_eq(d.len(), 1000)

    for i in 0..<1000
        assert_eq(d.pop_front(), Some(999 - i))

    assert(d.is_empty())
end front_stack_stays_in_order

// -- clearing and walking -------------------------------------------------------------------------

@test("clear empties the deque but keeps its storage")
clear_keeps_storage()
    var d: Deque[int] = deque()

    for i in 0..<20
        d.push_back(i)

    val before = d.cap()

    d.clear()

    assert_eq(d.len(), 0)
    assert(d.is_empty())
    assert_eq(d.cap(), before)
    assert_eq(d.first(), None)

    d.push_back(7)
    assert_eq(d[0], 7)
end clear_keeps_storage

@test("a walk yields the elements front to back, wrapped or not")
walk_matches_indexing()
    var d: Deque[int] = deque()

    for i in 0..<10
        d.push_back(i)

    for i in 0..<7
        assert(d.pop_front().is_some())

    for i in 200..<206
        d.push_back(i)

    var at: usize = 0

    for v in d.walk()
        assert_eq(v, d[at])
        at += 1

    assert_eq(at, d.len())
end walk_matches_indexing

@test("a walk of an empty deque yields nothing")
deque_walk_of_empty()
    var d: Deque[int] = deque()
    var seen = 0

    for v in d.walk()
        seen += 1

    assert_eq(seen, 0)
end deque_walk_of_empty

// -- a slot the ring gives up holds nothing ---------------------------------------------------------

struct DequeProbe
    n: int

@test("pop_front and pop_back let go of the element they take out")
deque_pops_let_go()
    var d: Deque[&DequeProbe] = deque()
    var a: &DequeProbe = DequeProbe(1)
    var b: &DequeProbe = DequeProbe(2)
    val wa: weak DequeProbe = a
    val wb: weak DequeProbe = b

    d.push_back(a)
    d.push_front(b)
    a = DequeProbe(3)
    b = DequeProbe(4)
    d.pop_back()

    assert(wa.get().is_none())
    assert(wb.get().is_some())

    d.pop_front()

    assert(wb.get().is_none())
end deque_pops_let_go

@test("clear lets go of every element, and the storage keeps no fill")
deque_clear_lets_go()
    var p: &DequeProbe = DequeProbe(1)
    val w: weak DequeProbe = p
    var d = deque_with_capacity(4, p)

    d.push_back(p)
    p = DequeProbe(2)
    d.clear()

    assert(w.get().is_none())
    assert_eq(d.len(), 0)
end deque_clear_lets_go

// -------------------------------------------------------------------------- a deque is a reference

/** A `Deque` is a name for a ring rather than the ring, so every way of making a second name -- an
 * assignment, a parameter, a capture, a read out of another container, a copied struct -- reaches the
 * same elements. Each test pushes through the second name and reads through the first.
 */
@test("a deque assigned is the same deque: push_front through the copy is seen by the original")
deque_assignment_shares()
    var a: Deque[int] = deque()

    a.push_back(1)

    var b = a

    b.push_front(0)
    b.push_back(2)

    assert_eq(a.len(), 3)
    assert_eq(b.len(), 3)
    assert_eq(a.first(), Some(0))
    assert_eq(a.at(2), 2)

    a.pop_front()

    assert_eq(b.first(), Some(1))
end deque_assignment_shares

private deque_push_nine(d: Deque[int]) = d.push_front(9)

@test("a deque passed by value is the caller's deque")
deque_parameter_shares()
    var d: Deque[int] = deque()

    d.push_back(1)
    deque_push_nine(d)

    assert_eq(d.len(), 2)
    assert_eq(d.first(), Some(9))

@test("a deque captured by a closure is the deque outside it")
deque_capture_shares()
    var d: Deque[int] = deque()
    val add = (x: int) -> d.push_back(x)

    add(3)
    add(4)

    assert_eq(d.len(), 2)
    assert_eq(d.last(), Some(4))

@test("a deque read out of another deque is the one inside it")
deque_nested_push_sticks()
    var outer: Deque[Deque[int]] = deque()

    outer.push_back(deque())

    var inner = outer.at(0)

    inner.push_back(5)

    assert_eq(outer.at(0).len(), 1)
    assert_eq(outer.at(0).first(), Some(5))

struct DequeHolder
    items: Deque[int]

@test("a struct holding a deque, copied, holds the same deque")
deque_in_a_copied_struct_shares()
    var s1 = DequeHolder(deque())
    var s2 = s1

    s2.items.push_front(7)

    assert_eq(s1.items.len(), 1)
    assert_eq(s1.items.first(), Some(7))

@test("growth through one name is seen through the other")
deque_growth_is_shared()
    var a: Deque[int] = deque()
    var b = a

    for i in 0..<20
        b.push_front(i)

    assert_eq(a.cap(), 32)
    assert_eq(a.len(), 20)
    assert_eq(a.first(), Some(19))
    assert_eq(a.last(), Some(0))
    assert_eq(a[10], 9)

    var total = 0

    for x in a.walk()
        total += x

    assert_eq(total, 190)
end deque_growth_is_shared

@test("an element's destructor waits for the last name for the deque")
deque_last_name_lets_go()
    var p: &DequeProbe = DequeProbe(1)
    val w: weak DequeProbe = p
    var a: Deque[&DequeProbe] = deque()

    a.push_back(p)
    p = DequeProbe(2)

    var b = a

    a = deque()

    assert(w.get().is_some())
    assert_eq(b.len(), 1)

    b = deque()

    assert(w.get().is_none())
end deque_last_name_lets_go

@test("a deque bound with val is pushed into, every mutator taking the handle by value")
val_bound_deque_mutates()
    val d: Deque[int] = deque()

    d.push_back(2)
    d.push_front(1)
    d.push_back(3)
    d.set(1, 20)

    assert_eq(d.pop_front(), Some(1))
    assert_eq(d.pop_back(), Some(3))
    assert_eq(d.at(0), 20)

    d.clear()

    assert(d.is_empty())
end val_bound_deque_mutates

private push_back_through(p: *Deque[int]) = p.push_back(4)

@test("a deque's mutator is still reached through a pointer to it")
deque_pointer_receiver_mutates()
    var d: Deque[int] = deque()

    push_back_through(&d)

    assert_eq(d.first(), Some(4))
end deque_pointer_receiver_mutates

@test("copy is a second deque, in the same order, and a push into either is not seen by the other")
deque_copy_is_a_second_deque()
    val a: Deque[int] = deque()

    for i in 0..<6
        a.push_back(i)

    a.pop_front()
    a.pop_front()
    a.push_front(1)
    a.push_back(6)

    val b = a.copy()

    b.push_front(0)
    a.set(0, 100)

    assert_eq(a.len(), 6)
    assert_eq(b.len(), 7)
    assert_eq(b.at(0), 0)

    for i in 1..<b.len()
        assert_eq(b.at(i), int(i))

    assert_eq(a.at(0), 100)
end deque_copy_is_a_second_deque

@test("a copy of an empty deque is empty, and grows")
deque_copy_of_empty()
    val a: Deque[int] = deque()
    val b = a.copy()

    b.push_back(1)

    assert(a.is_empty())
    assert_eq(b.first(), Some(1))
end deque_copy_of_empty

@test("for walks a deque front to back, an empty one not at all")
deque_for_walks_it()
    val d: Deque[int] = deque()
    var n = 0

    for x in d do n += 1

    d.push_back(2)
    d.push_back(3)
    d.push_front(1)

    var t = 0

    for x in d do t = t * 10 + x

    assert_eq(n, 0)
    assert_eq(t, 123)
end deque_for_walks_it

@test("a deque grown during the walk is walked as it was when the loop began")
deque_for_walks_it_as_it_was()
    val d: Deque[int] = deque()
    var seen = 0

    d.push_back(1)
    d.push_back(2)

    for x in d
        d.push_back(x * 10)
        seen += 1

    assert_eq(seen, 2)
    assert_eq(d.len(), 4)
end deque_for_walks_it_as_it_was
