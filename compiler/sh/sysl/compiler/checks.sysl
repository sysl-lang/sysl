module sh.sysl.compiler

import sh.sysl.parsing.{point, Span}
import sysl.buf.{Buf, buf}
import sysl.container.{Map, map, Set, set}
import sysl.text.{Search, from_utf8_unchecked}

// The checks a whole program is held to once every body it reaches has been typed.
//
// **What separates these from everything in `analyze_body.sysl` is the question they ask.** Typing a
// body asks whether each expression means anything; these ask whether the program a compilation
// came to is one the reader is allowed to have written -- which cannot be answered until the last
// body a call reached has been read, because the answer is about what a body *reaches* rather than
// about what it says.

// Everything a program has to answer for, run in the order the reference runs them.
whole_program_checks(a: &Analysis, units: Buf[Program], funcs: Buf[TFunc], vals: Buf[TVal],
                     typed: TypedBodies)
    // Each check is timed on its own under `SYSL_TIMINGS=1`, as part of the `checks` phase, and an
    // editor's check that has been told to stop stops between two of them (`check_over`).
    check_begin()
    check_conventions(a)
    if check_over(a, "conventions") then return
    check_exports(a)
    if check_over(a, "exports") then return
    check_doc_comments(a, units)
    if check_over(a, "doc_comments") then return
    check_drop_values(a, funcs)
    if check_over(a, "drop_values") then return
    check_ghost(a, funcs)
    if check_over(a, "ghost") then return
    check_module_graph(a)
    if check_over(a, "module_graph") then return
    check_target_refusals(a, funcs, vals, reached_vtables(a))
    if check_over(a, "target_refusals") then return
    check_gated_modules(a, funcs, vals, reached_vtables(a))
    if check_over(a, "gated_modules") then return
    check_no_block(a, funcs, vals, reached_vtables(a))
    if check_over(a, "no_block") then return
    check_decl_capabilities(a, funcs, vals, reached_vtables(a))
    if check_over(a, "capabilities") then return
    check_atomic_reach(a, funcs, reached_vtables(a))
    if check_over(a, "atomic_reach") then return
    check_purity(a, funcs, reached_externs(a))
    if check_over(a, "purity") then return
    check_const_fns(a, funcs, vals)
    if check_over(a, "const_fns") then return
    check_frames(a, funcs, reached_externs(a))
    if check_over(a, "frames") then return
    check_self_aliasing(a, funcs)
    if check_over(a, "self_aliasing") then return
    // The field-path analysis (`fpa.sysl`) runs beside the keeps analysis: the escape analysis reads
    // it, and the comparison `SYSL_FPA_COMPARE=1` holds it to the keeps analysis.
    val fx = fpa_analyze(a, funcs)

    a.field_paths = Some(fx)
    if check_over(a, "field_paths") then return
    check_keeps(a, funcs, reached_vtables(a), vals, fx)
    if check_over(a, "keeps") then return

    // **After the keeps answers**, which say whether a closure's `&Fn` box is laid in the frame
    // (`closure_mode.sysl`'s `framed_box`) -- and such a box allocates nothing.
    check_no_alloc(a, funcs, vals, reached_vtables(a), typed)
    if check_over(a, "no_alloc") then return
    check_relocating_calls(a, funcs)
    if check_over(a, "relocating_calls") then return
    check_disjoint(a, funcs)
    if check_over(a, "disjoint") then return
    check_guarded_results(a, funcs)
    if check_over(a, "guarded_results") then return
    check_test_scope(a, funcs)
    if check_over(a, "test_scope") then return
    check_inferred_crossings(a, funcs, reached_vtables(a))
    if check_over(a, "crossing") then return
    check_task_crossings(a, funcs)
    if check_over(a, "task_crossings") then return
    check_abandons(a, funcs, reached_externs(a), reached_vtables(a))
    if check_over(a, "abandons") then return
    check_ref_calls(a, funcs, vals)
    if check_over(a, "ref_calls") then return
    check_pinned(a, funcs, vals)
    if check_over(a, "pinned") then return
    check_strict_fp(a, funcs)
    if check_over(a, "strict_fp") then return
    check_fenv_reach(a, funcs, reached_vtables(a))
    check_done("fenv_reach")
end whole_program_checks

// The check called `name` is done: it is timed, and the answer is whether an editor's check has been
// told to stop (`editor_gave_up`) -- never for a build.
private check_over(a: &Analysis, name: string) -> bool
    check_done(name)
    editor_gave_up(a)

// -- a call that may release what a live `ref` stands on ---------------------------------------

// Refuses a call made while a `ref` is live (`place.sysl`'s `RefWatch`) whose callee may write a
// value of a type the ref's storage is held in -- through another name for it, which the ref's own
// checks cannot see.
//
// **The callee's body answers, read as `untouched_by` reads it**: a body that writes no object
// that could share storage with such a value, gives back no count, and calls only bodies that do
// the same. A call through a pointer or a trait's table names no body, so it is refused.
//
// **A callee that cannot get hold of such a value is cleared whatever its body does** -- the
// printing helpers, which end in a foreign call, and a library's already compiled functions, which
// have no body here at all. It can get hold of one only through what it is handed, through module
// storage, or by making a pointer to one out of something else: so it is cleared where no argument
// reaches a slot of the type behind a reference, pointer or view (an argument of the type itself is
// the callee's own copy), no module storage it can name reaches one, and no code it can run casts a
// pointer to the type.
//
// **What a callee can run is what it reaches** (`Reacher`): its own body and every body it calls, on
// any path, with each destructor in the program, since letting go of a value may run one. A body
// that may run code no call names -- a call through a pointer or a trait's table, a suspension --
// could run anything, so there every cast and all module storage count, as they do for a program
// read whole. **A foreign function can call back into the program** through whatever C can enter
// (`c_entered`: the exported functions, those whose address is taken, those in a `@section` or with
// a foreign convention), so reaching one reaches all of those, and all module storage, which C may
// hold the address of. **The standard library's own foreign functions are the exception**: the ones
// declared under `sysl.*` are the C library's and the runtime's, and none calls back into the
// program, so reaching one reaches nothing more. A foreign function a program or a package declares
// is not trusted, and nor is a function with no body here outside `sysl.*`.
private check_ref_calls(a: &Analysis, funcs: Buf[TFunc], vals: Buf[TVal])
    if a.ref_watches.is_empty() then return

    var globals: Buf[(string, Type)] = buf()

    for item in vals
        globals.push((item.symbol, item.ty))

    // **The program's foreign functions are part of what the bodies are read against**: a path that
    // ends the program -- `unwrap`'s panic, a failed bounds check -- reports why through them, and
    // `quiet_callees` trusts them only once it has seen every one of them. Left out, every such path
    // is a call to something unknown, and every `unwrap` would be taken to write what a view reads.
    //
    // **A whole program's tables are read too** (`Analysis.closed`): a call through a trait object is
    // then a call to what that slot holds in each table the program has for the trait, judged as a
    // direct call is. A library's build keeps such a call opaque.
    val p = TProgram(buf(), buf(), reached_vtables(a), reached_externs(a), buf(), funcs, buf(), None, buf(),
                     true, false, buf(), buf(), "", buf(), buf(), buf(), buf(), buf(), buf(), buf(), None,
                     buf(), false, false, false, true, map())
    var u = untouched_summary(p, dropping_reached(a), set(), a.closed)
    val reach = reacher(a, p, &u)
    var known: Set[string] = set()
    val sink: &ErasedSink = ErasedSink(buf())

    var consts: Set[string] = set()

    for f in funcs
        known.add(f.name)

        if f.const_fn then consts.add(f.name)
        walk_block_stmts(f.body, expr_walk(false, e -> note_erased(sink, e)))

    val erased = sink.items

    for f in funcs
        var mine: Buf[RefWatch] = buf()

        for w in a.ref_watches
            if w.func == f.name then mine.push(w)

        if mine.is_empty() then continue

        val scope = func_home(a, f.name)
        val at: *Untouched = &u
        val holders = closure_holders(f)
        var confined: Set[string] = set()

        for w in mine
            if w.root == "" || confined.has(w.root) then continue

            val ask: &FreshAsk = FreshAsk(a, at, reach, consts, known, globals, erased, w.types)

            if confined_local(ask, f, w.root) then confined.add(w.root)

        walk_block_stmts(f.body, expr_walk(false, e -> ref_call(a, at, reach, known, globals, erased,
                                                                scope, mine, holders, confined, e)))
end check_ref_calls

// What one callee can run, as `check_ref_calls` counts it: the types the casts in it make pointers to,
// the module storage it names, and whether all module storage counts (`all_reads`) or every cast and
// all of it does (`all`).
private struct Reach
    casts: Buf[Type]
    reads: Set[string]
    all_reads: bool
    all: bool
    releases: bool

// Each callee's `Reach`, worked out from the bodies' summary the first time a call to it is judged.
// `answering` holds the same question asked only of the paths that come back (`answer_of`).
private struct Reacher
    index: Map[string, usize]
    foreign: Set[string]
    trusted: Set[string]
    entered: Buf[string]
    drops: Buf[string]
    known: Map[string, Reach]
    answering: Map[string, Reach]

    of(*self, a: &Analysis, u: *Untouched, name: string) -> Reach
        self.known.get(name) match
            Some(r) -> return r
            None -> ()

        val out = self.walk(a, u, name, true)

        self.known.put(name, out)
        out
    end of

    // What a callee can run on the paths that return to its caller: a path that ends the program
    // (`unwrap`'s panic, a failed bounds check) never hands back an answer, so what it runs cannot
    // be what the call answers.
    answer_of(*self, a: &Analysis, u: *Untouched, name: string) -> Reach
        self.answering.get(name) match
            Some(r) -> return r
            None -> ()

        val out = self.walk(a, u, name, false)

        self.answering.put(name, out)
        out
    end answer_of

    // **A destructor is reached only through a body that can let go of a value that may run one**
    // (`Untouched.releases`): a callee holding no such value, and calling only bodies that hold none,
    // runs no destructor, so what the program's destructors reach is no part of what it can run.
    // Where one does, every destructor is reached, as is everything C can enter.
    walk(*self, a: &Analysis, u: *Untouched, name: string, ending: bool) -> Reach
        var out = Reach(buf(), set(), false, false, false)
        var seen: Set[string] = set()
        var todo: Buf[string] = buf()

        todo.push(name)

        var called_c = self.gather(a, u, &todo, &seen, &out, ending)

        if (out.releases || called_c) && !out.all
            for item in self.drops
                todo.push(item)

            if self.gather(a, u, &todo, &seen, &out, ending) then called_c = true

        // C may call back into whatever it can enter, and each of those may reach another foreign
        // function: the second walk's answer adds nothing, since every entry is already on it.
        if called_c && !out.all
            out.all_reads = true

            for item in self.entered
                todo.push(item)

            val _ = self.gather(a, u, &todo, &seen, &out, ending)

        out
    end walk

    // Walks every body reached from `todo` into `out`, and answers whether one of them calls a
    // foreign function that is not the standard library's. Where `ending` is unset, the calls on
    // paths that end the program are left out.
    gather(*self, a: &Analysis, u: *Untouched, todo: *Buf[string], seen: *Set[string], out: *Reach,
           ending: bool) -> bool
        var called_c = false

        while !todo.is_empty() && !out.all
            val name = todo.pop().unwrap()

            if seen.has(name) then continue

            seen.add(name)

            self.index.get(name) match
                Some(i) ->
                    if u.opaque[i]
                        out.all = true
                        break

                    if u.releases[i] then out.releases = true

                    for item in u.casts[i]
                        out.casts.push(item)

                    for item in u.reads[i]
                        out.reads.add(item)

                    for item in u.calls[i]
                        todo.push(item)

                    if ending
                        for item in u.exits[i]
                            todo.push(item)
                None ->
                    val std = self.trusted.has(name) ||
                              (!self.foreign.has(name) && std_module(func_home(a, name).module_name))

                    if !std then called_c = true

        called_c
    end gather
end Reacher

private reacher(a: &Analysis, p: TProgram, u: *Untouched) -> &Reacher
    var index: Map[string, usize] = map()

    for i in 0..<u.names.len()
        index.put(u.names[i], i)

    var foreign: Set[string] = set()
    var trusted: Set[string] = set()

    for item in p.externs
        val home = a.tables.extern_scopes.get(item.name)

        if home.is_some() && std_module(home.unwrap().scope.module_name) then trusted.add(item.name)
        else foreign.add(item.name)

    var drops: Buf[string] = buf()

    for f in p.funcs
        if module_bare(f.name) == "drop" || f.name.ends_with(".drop") then drops.push(f.name)

    Reacher(index, foreign, trusted, c_entered(p), drops, map(), map())
end reacher

// -- a local no callee can reach --------------------------------------------------------------------

// Whether the object a local of `f` holds is reachable by no name but the local's own, so that a
// call can write it only where the local is written into the call.
//
// **The object is one only this local can name** where three things hold. The local is declared
// once, from a fresh value (`fresh_in`): a buffer literal, or the answer of a call that can get hold
// of no value of a type in `types` it was not handed fresh, taken out of a `match`, an `if`, a `?` or
// a block that moves it along. Nothing assigns the local again. And every
// other use of it hands it to a call that lets nothing of it out: one that is `const` or writes no
// value of the type anywhere (`untouched_by`), whose other arguments and whose answer cannot hold a
// value of the type -- or reads it in place, by subscript or length, for an element that cannot.
//
// A closure capturing it, a copy into another name, an assignment, a `ref` or a pointer taken
// anywhere else is a use of none of those shapes, so the local is not confined and the call is
// asked about by type, as every other one is.
private confined_local(ask: &FreshAsk, f: TFunc, root: string) -> bool
    val tally: &LocalUses = LocalUses(0, 0, 0, true)

    walk_block_stmts(f.body, TWalk(false, e -> tally_use(ask.u, ask.consts, ask.erased, root, ask.types,
                                                         tally, e),
                                   w -> (),
                                   s -> tally_decl(ask, root, tally, s)))

    tally.decls == 1 && tally.fresh && tally.uses == tally.lent
end confined_local

// What `confined_local` counts: the declarations of the local, every load of it, the loads it
// accepted as lending nothing out, and whether every declaration was fresh.
private struct LocalUses
    decls: int
    uses: int
    lent: int
    fresh: bool
end LocalUses

private tally_decl(ask: &FreshAsk, root: string, tally: &LocalUses, s: TStmt) = s match
    TVarDecl(name, _, init, _) ->
        if name == root
            tally.decls += 1

            if !fresh_in(ask, buf(), init) then tally.fresh = false
        end if
    _ -> ()

// What `fresh_in` asks a callee with: the program's bodies, what each can reach, and the types whose
// values the question is about.
private struct FreshAsk
    a: &Analysis
    u: *Untouched
    reach: &Reacher
    consts: Set[string]
    known: Set[string]
    globals: Buf[(string, Type)]
    erased: Buf[(string, Type)]
    types: Buf[Type]
end FreshAsk

// Whether `e` makes a value of the types `ask` names that only the expression holds: one no name
// outside it can reach. `names` are the locals and pattern bindings, inside `e`'s own blocks and arms,
// that hold such a value and are used nowhere but where they hand it on.
//
// **A call's answer is fresh where the callee cannot get hold of a value of the types any other way**:
// it is `const`, or a body that, on the paths that return, reads no module storage able to hold one
// and makes no cast that could point at one (`unreachable_to`), and every argument that can hold one
// is itself fresh. Whatever it
// answers it built, or was handed fresh.
//
// **What a `match` arm or an `if let` binds out of a fresh subject is fresh**, and so is the arm's
// value when it is that binding, or fresh in its own right; an arm that leaves -- `return`, `break`,
// `continue` -- answers nothing. A `?` hands on what its operand made; a block hands on a binding it
// declared fresh and uses nowhere else.
private fresh_in(ask: &FreshAsk, names: Buf[string], e: TExpr) -> bool = *e.kind match
    TLoad(n, _) -> holds_string(names, n)
    TCall(name, args, _, _) ->
        if !fresh_args(ask, names, args) then return false
        if ask.consts.has(name) then return true
        if !ask.known.has(name) then return false

        val r = ask.reach.answer_of(ask.a, ask.u, name)

        for t in ask.types
            if !unreachable_to(ask.u, r, ask.globals, ask.erased, buf(), t, true) then return false

        true
    TBufLit(elems, _) -> fresh_args(ask, names, elems)
    TEnumNew(_, _, args) -> fresh_args(ask, names, args)
    TTry(operand, _, _, _, _, _, _) -> fresh_in(ask, names, operand)
    TBlockExpr(b) -> fresh_block(ask, names, b)
    TMatch(subject, arms, _) ->
        val whole = fresh_in(ask, names, subject)

        for arm in arms
            var inner = names.copy()

            if whole && arm.guard.is_none()
                for p in arm.patterns do pattern_names(p, &inner)

            if !fresh_block(ask, inner, arm.body) then return false

        true
    TIf(cond, then_block, else_block, _) ->
        if else_block.is_none() then return false

        var inner = names.copy()

        for term in cond
            term match
                TCondIs(subject, patterns, negated) ->
                    if !negated && fresh_in(ask, names, subject)
                        for p in patterns do pattern_names(p, &inner)
                TCondTest(c) ->
                    for n in inner
                        if loads(c, n) > 0 then return false

        fresh_block(ask, inner, then_block) && fresh_block(ask, names, else_block.unwrap())
    _ -> false
end fresh_in

// Whether every one of `args` that can hold a value of the types in question is fresh.
private fresh_args(ask: &FreshAsk, names: Buf[string], args: Buf[TExpr]) -> bool
    for item in args
        if reaches_any(texpr_type(item), ask.types, ask.erased) && !fresh_in(ask, names, item)
            return false

    true
end fresh_args

// Whether a block either leaves or comes to a fresh value. Of `names`, only one its statements do
// not use may be handed on; a local it declares from a fresh value, or straight from such a name, is
// handed on where nothing else in the block uses it.
private fresh_block(ask: &FreshAsk, names: Buf[string], b: TBlock) -> bool
    if leaves(b) then return true
    if b.result.is_none() then return false

    var allowed: Buf[string] = buf()

    for n in names
        if stmt_loads(b.stmts, n) == 0 then allowed.push(n)

    for s in b.stmts
        s match
            TVarDecl(name, _, init, _) ->
                val moved = *init.kind match
                    TLoad(m, _) -> holds_string(names, m) && stmt_loads(b.stmts, m) == 1
                    _ -> false

                if (moved || fresh_in(ask, allowed, init)) && stmt_loads(b.stmts, name) == 0
                    allowed.push(name)
                end if
            _ -> ()

    fresh_in(ask, allowed, b.result.unwrap())
end fresh_block

// Whether a block never comes to a value: its type is `Never`, or its last statement leaves.
private leaves(b: TBlock) -> bool
    if b.ty == Never then return true
    if b.result.is_some() then return texpr_type(b.result.unwrap()) == Never
    if b.stmts.is_empty() then return false

    b.stmts[b.stmts.len() - 1] match
        TReturn(_) -> true
        TBecome(_) -> true
        TBreak(_, _) -> true
        TContinue(_) -> true
        _ -> false
end leaves

private loads(e: TExpr, n: string) -> int
    val hit: &LocalUses = LocalUses(0, 0, 0, false)

    walk_texpr(e, expr_walk(false, x -> *x.kind match
        TLoad(name, _) -> if name == n then hit.uses += 1
        _ -> ()))

    hit.uses
end loads

private stmt_loads(stmts: Buf[TStmt], n: string) -> int
    val hit: &LocalUses = LocalUses(0, 0, 0, false)

    walk_stmts(stmts, expr_walk(false, x -> *x.kind match
        TLoad(name, _) -> if name == n then hit.uses += 1
        _ -> ()))

    hit.uses
end stmt_loads

// Whether no value of these expressions' types can hold a value of a type in `types`, by value or
// behind anything.
private none_reach(es: Buf[TExpr], types: Buf[Type], erased: Buf[(string, Type)]) -> bool
    for item in es
        if reaches_any(texpr_type(item), types, erased) then return false

    true
end none_reach

private reaches_any(from: Type, types: Buf[Type], erased: Buf[(string, Type)]) -> bool
    for t in types
        var seen: Set[string] = set()

        if type_reaches(from, underlying(t), true, erased, &seen) then return true

    false
end reaches_any

private is_load_of(e: TExpr, root: string) -> bool = *e.kind match
    TLoad(name, _) -> name == root
    TAddrOf(place, _) -> is_load_of(place, root)
    _ -> false

private tally_use(u: *Untouched, consts: Set[string], erased: Buf[(string, Type)], root: string,
                  types: Buf[Type], tally: &LocalUses, e: TExpr) = *e.kind match
    TLoad(name, _) -> if name == root then tally.uses += 1
    TCall(name, args, ty, _) ->
        var mine = 0
        var others: Buf[TExpr] = buf()

        for item in args
            if is_load_of(item, root) then mine += 1 else others.push(item)

        if mine > 0 && !reaches_any(ty, types, erased) && none_reach(others, types, erased) &&
           (consts.has(name) || untouched_all(u, name, types))
            tally.lent += mine
        end if
    TIndex(receiver, _, ty) ->
        if is_load_of(receiver, root) && !reaches_any(ty, types, erased) then tally.lent += 1
    TLen(receiver, _) -> if is_load_of(receiver, root) then tally.lent += 1
    _ -> ()

private untouched_all(u: *Untouched, name: string, types: Buf[Type]) -> bool
    for t in types
        if !untouched_by(u, t).has(name) then return false

    true
end untouched_all

// Whether a call names a local anywhere in what it is handed.
private call_names(e: TExpr, root: string) -> bool
    val hit: &LocalUses = LocalUses(0, 0, 0, false)

    walk_texpr(e, expr_walk(false, x -> *x.kind match
        TLoad(name, _) -> if name == root then hit.uses += 1
        _ -> ()))

    hit.uses > 0
end call_names

// -- a closure held by reference, writing what a live `ref` stands on ----------------------------
//
// **A closure that holds its captures by reference writes the caller's variables when it is called**
// (`docs/design/closures.md` §7), so calling one -- or handing one to a call, which may call it --
// while a `ref` stands on storage such a write releases is the assignment `check_ref_guards` refuses,
// made one call away. Asked here, where every closure's mode is known: one held by value writes its
// own copy and releases nothing of the caller's.
//
// The closure is found by its type wherever the call reaches it -- an argument, the receiver of its
// own `call`, a `&Fn` box, a struct or enum built around it -- and by name where a local holds it
// erased: every local whose initializer or assignment builds or reads one (`closure_holders`). A
// closure that captures another calls it, so it writes what that one writes too.

// For each local of a body, the closures what was put in it builds or reads: a `&Fn` local, a struct
// or an `Option` holding one, a second name for another.
private closure_holders(f: TFunc) -> Map[string, Buf[string]]
    var out: Map[string, Buf[string]] = map()
    val into = &out

    walk_block_stmts(f.body, TWalk(true, e -> (), w -> held_into(into, w.place, w.value), s -> s match
        TVarDecl(name, _, init, _) -> hold_closures(into, name, init)
        _ -> ()))

    out
end closure_holders

private held_into(into: *Map[string, Buf[string]], place: TExpr, value: TExpr) = *place.kind match
    TLoad(name, _) -> hold_closures(into, name, value)
    _ -> ()

private hold_closures(into: *Map[string, Buf[string]], name: string, value: TExpr)
    var found: Buf[string] = buf()

    walk_texpr(value, expr_walk(true, x -> closure_named(*into, &found, x)))

    if found.is_empty() then return

    var held = into.get(name).unwrap_or(buf())

    for base in found
        if !holds_string(held, base) then held.push(base)

    into.put(name, held)
end hold_closures

// A closure a node builds or reads: by its type, or by the local holding it erased.
private closure_named(holders: Map[string, Buf[string]], out: *Buf[string], x: TExpr)
    texpr_type(x) match
        Struct(st) -> if is_closure_literal(Struct(st)) && !holds_string(*out, st.base) then out.push(st.base)
        _ -> ()

    *x.kind match
        TLoad(name, _) ->
            for base in holders.get(name).unwrap_or(buf())
                if !holds_string(*out, base) then out.push(base)
        _ -> ()
end closure_named

// Every closure a call hands on or runs, and every closure those capture, each once.
private closures_called(a: &Analysis, holders: Map[string, Buf[string]], e: TExpr) -> Buf[string]
    var direct: Buf[string] = buf()
    val parts: Buf[TExpr] = *e.kind match
        TCall(_, args, _, _) -> args
        TCallPtr(callee, args, _, _) ->
            var all = args.copy()

            all.push(callee)
            all
        TVCall(receiver, _, args, _, _) ->
            var all = args.copy()

            all.push(receiver)
            all
        _ -> buf()

    for part in parts
        handed(holders, &direct, part)

    var out: Buf[string] = buf()

    for base in direct
        follow_closure(a, holders, &out, base)

    out
end closures_called

// The closures an argument is, or carries: through an address, a box, an erasure, a dereference, or
// a struct or enum built around one -- not through a call, whose result is the callee's.
private handed(holders: Map[string, Buf[string]], out: *Buf[string], x: TExpr)
    closure_named(holders, out, x)

    *x.kind match
        TAddrOf(inner, _) -> handed(holders, out, inner)
        TBox(inner, _) -> handed(holders, out, inner)
        TErase(inner, _, _) -> handed(holders, out, inner)
        TDeref(inner, _) -> handed(holders, out, inner)
        TStructNew(st, args) ->
            if !is_closure_literal(Struct(st))
                for item in args
                    handed(holders, out, item)
        TEnumNew(_, _, args) ->
            for item in args
                handed(holders, out, item)
        _ -> ()
end handed

// A closure and the closures it captures, by their types or by the locals holding them erased.
private follow_closure(a: &Analysis, holders: Map[string, Buf[string]], out: *Buf[string], base: string)
    if holds_string(*out, base) then return

    out.push(base)

    val st = a.tables.struct_insts.get(base)
    val writes = a.closure_write_keys.get(base)

    if st.is_none() || writes.is_none() then return

    st.unwrap() match
        Struct(d) ->
            for i in 0..<d.fields.len()
                d.fields[i].1 match
                    Struct(inner) -> if is_closure_literal(Struct(inner)) then follow_closure(a, holders, out, inner.base)
                    _ -> ()

                if i < writes.unwrap().captures.len()
                    for held in holders.get(writes.unwrap().captures[i]).unwrap_or(buf())
                        follow_closure(a, holders, out, held)
            end for
        _ -> ()
end follow_closure

// The first place a closure held by reference writes that a `ref` stands through, or on a value
// holding it: the variable's name as written.
private closure_writes_under(a: &Analysis, bases: Buf[string], keys: Buf[string]) -> Option[string]
    for base in bases
        if !a.by_ref_closures.has(base) then continue

        val writes = a.closure_write_keys.get(base)

        if writes.is_none() then continue

        val w = writes.unwrap()

        for i in 0..<w.keys.len()
            val at = w.keys[i]

            for k in keys
                if k == at || k.starts_with(s"$at/") then return Some(w.names[i])
        end for
    end for

    None
end closure_writes_under

// Every value the program puts behind a trait, by the trait's name.
private struct ErasedSink
    items: Buf[(string, Type)]
end ErasedSink

private note_erased(out: &ErasedSink, e: TExpr) = *e.kind match
    TErase(operand, _, ty) ->
        val tr = repr(pointee(ty).unwrap_or(ty))

        tr match
            Trait(name, _, _) -> out.items.push((name, texpr_type(operand)))
            _ -> ()
    _ -> ()

private ref_call(a: &Analysis, u: *Untouched, reach: &Reacher, known: Set[string], globals: Buf[(string, Type)],
                 erased: Buf[(string, Type)], scope: Scope,
                 mine: Buf[RefWatch], holders: Map[string, Buf[string]], confined: Set[string], e: TExpr)
    // Each body the call may run, and what it is handed; `""` is a body no name says.
    val callee = *e.kind match
        TCall(name, args, ty, _) -> if ty == Never then None else Some((only_body(name), args))
        TCallPtr(_, args, _, _) -> Some((only_body(""), args))
        TVCall(recv, slot, args, _, _) -> Some(slot_bodies(a, recv, slot, args))
        _ -> None

    if callee.is_none() then return

    for item in a.ref_refusals
        if item >= e.span.start && item < e.span.end then return

    val closures = closures_called(a, holders, e)

    for w in mine
        val live = e.span.start >= w.start && (w.end.is_none() || e.span.start < w.end.unwrap())

        if !live then continue

        // A local's object no other name can reach is written only by a call it is handed to.
        if w.root != "" && confined.has(w.root) && !call_names(e, w.root) then continue

        val written = if closures.is_empty() then None else closure_writes_under(a, closures, w.keys)

        if written.is_some()
            a.fault(scope, e.span, s"'${w.name}' is a 'ref' standing on storage this call could " +
                    s"release, since a closure it runs writes '${written.unwrap()}' — so the name could " +
                    "be left pointing at freed memory. Make the call before the 'ref', or put the 'ref' " +
                    "in a block that closes first")
            a.ref_refusals.push(e.span.start)
            return
        end if

        val names = callee.unwrap().0
        val args = callee.unwrap().1

        for t in w.types
            // **A copy of a handle is the same buffer**: where a `@relocates` member moves the
            // storage behind a `t`, an argument holding a `t` by value hands the callee the storage
            // a `ref` stands in, not a copy of it.
            val moving = w.view_of == "" && relocated(u, t)
            var name = ""
            var cleared = true

            for item in names
                name = item

                // **The question is what comes back**: a path through the callee that ends the
                // program never resumes this frame, so nothing reads through the name afterwards.
                cleared = item != "" &&
                    (unreachable_to(u, reach.answer_of(a, u, item), globals, erased, args, t, moving) ||
                     (known.has(item) && untouched_by(u, t, w.lent, moving, true).has(item)))

                if !cleared then break
            end for

            if !cleared
                var what = "a call through a pointer or a trait names no body to ask"

                // An instantiation is named by the generic it was made from: `Result.map_err`, not
                // the instance's key with its type arguments spelled into it.
                if name != ""
                    val origin = a.tables.members.func_origin.get(name).unwrap_or(name)

                    what = s"'${qualified_name(origin)}' may write a '${type_show(t)}'"
                end if

                if w.view_of != ""
                    a.fault(scope, e.span, s"'${w.name}' is a view borrowed from '${w.view_of}', " +
                            s"held in a '${type_show(t)}', and $what — which could free what " +
                            "the view reads. Make the call before the view is taken, or put the " +
                            "view in a block that closes first")
                    return
                end if

                a.fault(scope, e.span, s"'${w.name}' is a 'ref' standing on storage held in a " +
                        s"'${type_show(t)}', and $what — another name for the same object would " +
                        "leave the 'ref' pointing at freed memory. Make the call before the 'ref', " +
                        "or put the 'ref' in a block that closes first")
                return
            end if
end ref_call

private only_body(name: string) -> Buf[string]
    var out: Buf[string] = buf()

    out.push(name)
    out

// The bodies a call through slot `slot` of a trait object may run, and what each is handed: the
// receiver's object as well as the arguments. **A whole program names every one** -- the method in
// that slot of each table it has for the trait, and none where it has no table at all, since then no
// such object exists. Anything else, or a receiver whose trait cannot be named, is a body no name says.
private slot_bodies(a: &Analysis, recv: TExpr, slot: int, args: Buf[TExpr]) -> (Buf[string], Buf[TExpr])
    var handed: Buf[TExpr] = buf()

    handed.push(recv)

    for item in args
        handed.push(item)

    val trait_name = erased_trait(texpr_type(recv)) match
        Some(Trait(n, _, _)) -> n
        _ -> ""

    if !a.closed || trait_name == "" || slot < 0 then return (only_body(""), handed)

    var out: Buf[string] = buf()
    val tables = a.tables.members.vtables

    for i in 0..<tables.len()
        val vt = tables.at(i)

        if vt.trait_name != trait_name then continue
        if usize(slot) >= vt.slots.len() then return (only_body(""), handed)
        if !holds_string(out, vt.slots[usize(slot)].target) then out.push(vt.slots[usize(slot)].target)

    (out, handed)
end slot_bodies

// Whether a callee handed `args`, which can run what `r` says, has no way to get hold of a value of
// type `t` held anywhere else. Where `shared` is set, an argument holding a `t` by value is one: a
// handle whose storage a `@relocates` member moves.
private unreachable_to(u: *Untouched, r: Reach, globals: Buf[(string, Type)], erased: Buf[(string, Type)],
                       args: Buf[TExpr], t: Type, shared: bool = false) -> bool
    val want = underlying(t)

    var cast: Buf[Type] = buf()

    if r.all
        for item in u.laundered.anywhere
            cast.push(item)

        for item in u.laundered.into
            cast.push(item)
    else
        for item in r.casts
            cast.push(item)
    end if

    for item in cast
        var parts: Buf[Type] = buf()

        by_value_parts(item, &parts)

        for part in parts
            if part == want then return false

    for item in globals
        if !r.all && !r.all_reads && !r.reads.has(item.0) then continue

        var seen: Set[string] = set()

        if type_reaches(item.1, want, true, erased, &seen) then return false

    for item in args
        var seen: Set[string] = set()

        if type_reaches(texpr_type(item), want, shared, erased, &seen) then return false

    true
end unreachable_to

// Whether a value of type `from` reaches a slot of type `t` that is somebody else's: one behind a
// reference, a pointer or a view, or held by value under one (`behind`). A generic's arguments count
// as behind, since its storage may be a raw pointer. A trait object reaches what every value the
// program erased to that trait reaches; a C function pointer and anything unresolved are taken to
// reach everything.
private type_reaches(from: Type, t: Type, behind: bool, erased: Buf[(string, Type)],
                     seen: *Set[string]) -> bool
    val u = underlying(from)

    if behind && u == t then return true

    val key = if behind then s"${mangle(u)}!" else mangle(u)

    if seen.has(key) then return false

    seen.add(key)

    u match
        Ptr(inner) -> type_reaches(*inner, t, true, erased, seen)
        Ref(inner, _) -> type_reaches(*inner, t, true, erased, seen)
        Weak(inner) -> type_reaches(*inner, t, true, erased, seen)
        Slice(elem, _) -> type_reaches(*elem, t, true, erased, seen)
        Volatile(inner) -> type_reaches(*inner, t, behind, erased, seen)
        Array(_, elem) -> type_reaches(*elem, t, behind, erased, seen)
        Vector(_, elem) -> type_reaches(*elem, t, behind, erased, seen)
        Constrained(d) -> type_reaches(d.base, t, behind, erased, seen)
        Struct(d) -> any_type_reaches(d.fields, d.targs, t, behind, erased, seen)
        Results(d) -> any_type_reaches(d.fields, d.targs, t, behind, erased, seen)
        Enum(d) ->
            for item in d.variants
                if any_type_reaches(item.fields, d.targs, t, behind, erased, seen) then return true

            false
        // A trait object reaches what the values the program put behind that trait reach.
        Trait(name, _, _) ->
            for item in erased
                if item.0 == name && type_reaches(item.1, t, true, erased, seen) then return true

            false
        Abstract(_, _) -> true
        CFn(_, _, _) -> true
        Pack(_) -> true
        Unknown -> true
        _ -> false
end type_reaches

private any_type_reaches(fields: Buf[(string, Type)], targs: Buf[Type], t: Type, behind: bool,
                         erased: Buf[(string, Type)], seen: *Set[string]) -> bool
    for item in fields
        if type_reaches(item.1, t, behind, erased, seen) then return true

    for item in targs
        if type_reaches(item, t, true, erased, seen) then return true

    false
end any_type_reaches

// The file a typed body was written in, or an empty one where the body has no source of its own.
func_home(a: &Analysis, name: string) -> Scope = a.tables.homes.get(name).unwrap_or(empty_scope())

// The module a body was written in, which is the module whose clauses (`@no_os`, `@no_alloc`,
// `@no_block`) it answers to. It is not always the one its symbol names: a member of an `impl`
// written for another module's type is lowered under the receiver's, and a member of a BUILT-IN
// type (`impl E for i32`) under no module at all -- which is the key of the program's root module, so
// asked of the symbol, a dependency's `impl E for i32` read as the root's own code and was held to
// the root's `@no_os`. A trait default's copy was written beside the trait, so it is the trait's.
home_module(a: &Analysis, name: string) -> string
    val home = a.tables.homes.get(name)

    if home.is_some() && home.unwrap().src.name != "" then return home.unwrap().module_name

    module_of(name)
end home_module

// -- the modules a program reaches ------------------------------------------------------------

// The modules the program's own reach, or nothing where every module counts -- a compilation with no
// program of its own, such as a build of a library.
//
// **A dependency is a set of modules, and a program uses the ones it names**
// (`reference/modules.md § The target's half needs no clause at all`). So the target's half of a promise --
// a machine with no heap, no thread-local storage -- is asked of a fetched package's or a `--lib`
// root's module only where the program reaches it: one that never names `sh.sysl.pool` builds for a
// board although `sh.sysl.pool.deque`, which it does name, sits beside a module that boxes and keeps
// per-thread storage. The referring is asked of the graph name resolution built, which records an
// `import` as readily as a call, so a module is reached through whatever a reached module wrote.
//
// **Two modules are reached that nothing names**: one whose top-of-file `asm` is laid down, and one
// holding an `@export` that answers an `extern` the program calls -- the image carries both whether
// or not an import leads there, as `reachability.sysl`'s roots do.
program_reach(a: &Analysis, funcs: Buf[TFunc]) -> Option[Set[string]]
    var order: Buf[string] = buf()
    var reached: Set[string] = set()

    // The program's own modules are every one nobody handed over (`Tables.supplied_modules`).
    for item in a.tables.modules
        if !holds_string(a.tables.supplied_modules, item) && reached.add(item) then order.push(item)

    if order.is_empty() then return None

    if reached.add(ModuleRoot) then order.push(ModuleRoot)

    for item in a.tables.module_asm
        if reached.add(item.home) then order.push(item.home)

    val externs = reached_externs(a)

    for i in 0..<funcs.len()
        val f = funcs[i]

        if f.exported.is_none() then continue

        for x in externs
            if f.exported == Some(x.symbol) && reached.add(module_of(f.name)) then
                order.push(module_of(f.name))

    var i: usize = 0

    while i < order.len()
        val from = order[i]

        i += 1

        for module_dep in a.tables.module_deps
            if module_dep.0 == from
                for to in module_dep.1
                    if reached.add(to) then order.push(to)

    Some(reached)
end program_reach

// The functions the program's roots arrive at -- its entry, its `@export`s, its tests and hooks in a
// build that runs them, and the tables of closures written where it reaches (`funcs_reached`) -- or
// nothing where every function counts: a build of a library, which is compiled for whichever program
// reaches it, or a compilation with no program of its own.
//
// **The image is what the machine's half is asked of**, and a body nothing arrives at is not in it:
// `sh.sysl.parsing`'s `render`, in a module the program reaches for its `Span`, or a trait's default
// that an implementing type never has called. The entry file's statements are a body of their own
// (`entry_check_name`) and are always reached.
program_func_reach(done: TypedBodies) -> Option[Set[string]]
    val a = done.an

    if !a.producing.is_empty() then return None

    var own: Buf[string] = buf()

    for item in a.tables.modules
        if !holds_string(a.tables.supplied_modules, item) then own.push(item)

    if own.is_empty() then return None

    var reached = funcs_reached(program_of(done, done.main_module), own)

    reached.add(entry_check_name(done.main_module))

    Some(reached)
end program_func_reach

// Whether a module is one the program reaches, where `reach` came from `program_reach`.
reached_module(reach: Option[Set[string]], module_name: string) -> bool = reach match
    Some(names) -> names.has(module_name)
    None -> true

// The refusals a declaration earned from the machine alone, kept until the program's reach is known
// (`Analysis.target_refusals`) and made now for the modules it reaches.
private check_target_refusals(a: &Analysis, funcs: Buf[TFunc], vals: Buf[TVal],
                               vtables: Buf[TVtable])
    if a.target_refusals.is_empty() then return

    val reach = program_reach(a, funcs)
    val chosen = chosen_instances(a, reach, funcs, vals, vtables)

    // An instance is refused once, at its first form: one sentence per instance, as a program's own
    // form is told.
    var told: Set[string] = set()

    for item in a.target_refusals
        val asked = if item.3 == "" then reached_module(reach, item.0.module_name)
                    else chosen.has(item.3) && told.add(item.3)

        if asked then a.fault(item.0, item.1, item.2)
end check_target_refusals

// The instances a refusal is waiting on that a module the program reaches arrives at, through any
// chain of the standard module's bodies and other instances.
//
// **An instance belongs to whoever asked for it**, and the standard module's bodies to whoever calls
// into them, so neither is a starting point: a body is one where it was written in a module of the
// program's reach. Every waiting instance counts where every module does -- a build of a library.
private chosen_instances(a: &Analysis, reach: Option[Set[string]], funcs: Buf[TFunc],
                         vals: Buf[TVal], vtables: Buf[TVtable]) -> Set[string]
    var seeds: Buf[string] = buf()
    var chosen: Set[string] = set()

    for item in a.target_refusals
        if item.3 != "" && !holds_string(seeds, item.3) then seeds.push(item.3)

    if seeds.is_empty() then return chosen

    if reach.is_none()
        for s in seeds
            chosen.add(s)

        return chosen
    end if

    val walk = reaches_over(with_abstract_callees(a, funcs), vtables, seeds)

    for i in 0..<funcs.len()
        val f = funcs[i]
        val home = func_home(a, f.name).module_name

        if a.tables.members.func_origin.has(f.name) || standard_body_module(home) then continue
        if !reached_module(reach, home) then continue

        for s in reached_seeds(walk, refs_of_block(f.body))
            chosen.add(s)

    // A module's storage runs its initializer in the module that wrote it.
    for v in vals
        if v.init.is_none() || !reached_module(reach, module_of(v.symbol)) then continue

        for s in reached_seeds(walk, refs_of_expr(v.init.unwrap()))
            chosen.add(s)

    chosen
end chosen_instances

// -- doc comments ----------------------------------------------------------------------------

// Holds every doc comment's `@param` and `@tparam` tags to the signature it sits above.
//
// **It walks the files rather than the tables**, a doc comment belonging to the file the lexer
// found it in and being placed by a line number. Only what a tag NAMES is checked: a parameter with
// no `@param` is not an error and must not become one. The complaint points at the tag's own line,
// which is where the stale name is, not at the declaration.
private check_doc_comments(a: &Analysis, units: Buf[Program])
    for unit in units
        val found = doc_problems(unit)

        if found.is_empty() then continue

        val scope = scope_of_unit(a, unit)

        for j in 0..<found.len()
            val at = point(unit.src.line_span(found[j].tag.line).start)

            a.fault(scope, at, found[j].message)
end check_doc_comments

// -- `@ghost` --------------------------------------------------------------------------------

// Reports every call to a `@ghost` function from somewhere that runs.
//
// **The rule that makes erasing a ghost declaration sound is a rule about who may mention it.**
// Nothing executable may call one, since erasing it would then change what the program computes; a
// clause that calls one is a clause that does not run, and is the one place a call is allowed.
//
// So the clauses are not walked: a function's `require`, `ensure` and `variant` are held beside the
// body, and a loop's `invariant` and `variant` are statements the walk stops at. Everything else is
// executable. A ghost function's own body is where real state is read, so it may call whatever it
// likes.
private check_ghost(a: &Analysis, funcs: Buf[TFunc])
    var ghost: Buf[string] = buf()

    for i in 0..<funcs.len()
        if funcs[i].ghost then ghost.push(funcs[i].name)

    if ghost.is_empty() then return

    for i in 0..<funcs.len()
        val f = funcs[i]

        if !f.ghost
            val scope = func_home(a, f.name)
            val an = a
            val named = ghost

            walk_block_stmts(f.body, expr_walk(false, e -> ghost_call(an, scope, named, e)))
end check_ghost

private ghost_call(a: &Analysis, scope: Scope, ghost: Buf[string], e: TExpr)
    *e.kind match
        TCall(name, _, _, _) ->
            if holds_string(ghost, name) then
                a.fault(scope, e.span, s"'${qualified_name(name)}' is '@ghost', so it exists for the " +
                        "specification and is not there when the program runs — it may be called " +
                        "from a 'require', an 'ensure', a loop's 'invariant' or 'variant', or from " +
                        "another '@ghost' function, and from nowhere else")
        _ -> ()
end ghost_call

// A block's statements and the value it comes to, walked as one body.
walk_block_stmts(b: TBlock, v: &TWalk)
    walk_stmts(b.stmts, v)

    if b.result.is_some() then walk_texpr(b.result.unwrap(), v)
end walk_block_stmts

// -- the types with a destructor -----------------------------------------------------------------

// The types this compilation declared a destructor for, by the key their members are filed under.
//
// **It is read off the `impl` blocks rather than off the instantiated types**, because a block for a
// generic type is one block covering a family: what has a destructor is the family.
drops_declared(a: &Analysis) -> Buf[string]
    var out: Buf[string] = buf()
    val drop_trait = catalog_key(a, "Drop")

    if drop_trait.is_none() then return out

    val from = a.tables.members.from_trait

    for i in 0..<from.len()
        val key = from.key_at(i)

        if from.at(i) == drop_trait.unwrap() && member_filed_as(key) == "drop"
            out.push(member_owner_of(key))

    out
end drops_declared

// The two halves of a member key, which is an owner and the name the member is filed under.
private member_split(key: string) -> (string, string)
    val bytes = key.bytes

    for i in 0..<bytes.len
        if bytes[i] == u8('\t') then
            return (from_utf8_unchecked(bytes[0..<i]), from_utf8_unchecked(bytes[i + 1..<bytes.len]))

    (key, "")
end member_split

private member_owner_of(key: string) -> string = member_split(key).0
private member_filed_as(key: string) -> string = member_split(key).1

// -- a calling convention, and what a processor makes of it ---------------------------------------

// The one convention there is. Named rather than assumed, so that the refusal for an unknown one can
// list what there is.
const InterruptConv: string = "interrupt"

// The privilege modes RISC-V distinguishes, in the spelling its attribute takes. `machine` is the
// default because a handler with no mode written is the one a bare-metal program means.
private riscv_modes() -> Buf[string]
    var out: Buf[string] = buf()

    out.push("machine")
    out.push("supervisor")
    out.push("user")
    out
end riscv_modes

const DefaultRiscvMode: string = "machine"

// How a processor spells an interrupt handler.
//
// **`interrupt` is one concept with several answers, and a processor without one is without it for
// its own reason.** On x86-64 it is a calling convention and the ABI insists the handler take a
// pointer to the frame the hardware pushed; on RISC-V it is a function attribute and the handler
// must take nothing at all. The rest carry their reason here, because a shared sentence could only
// be true of one of them.
enum InterruptForm
    // An LLVM calling convention, written on the definition -- x86-64's.
    FormConvention

    // An LLVM function attribute, written after the signature -- RISC-V's.
    FormAttribute

    // This processor has none, and this is why.
    FormAbsent(why: string)
end InterruptForm

interrupt_form(cpu: Cpu) -> InterruptForm = cpu match
    X86_64 -> FormConvention

    // Both RISC-V widths spell it the same way, because it is the same attribute: the privilege
    // modes are the architecture's rather than the register width's.
    Riscv64 -> FormAttribute
    Riscv32 -> FormAttribute

    Aarch64 -> FormAbsent("its exception entry goes through a vector table of fixed-size " +
                          "instruction slots, so a handler is assembly and there is nothing here " +
                          "for a convention to describe")

    // A Cortex-M handler is an ordinary function, and that is the whole answer rather than a gap:
    // the processor stacks the caller-saved registers itself and puts `EXC_RETURN` in the link
    // register, so a plain function returning normally is already correct.
    Thumb -> FormAbsent("a Cortex-M exception is entered with the caller-saved registers already " +
                        "stacked by the processor and 'EXC_RETURN' in the link register, so an " +
                        "ordinary function is already a correct handler and there is no prologue " +
                        "for a convention to arrange — write one, and give it the name the vector " +
                        "table holds with '@export(\"SysTick_Handler\")'")

    // WebAssembly has no interrupts to have a form for, which is a different kind of absence: the
    // others are machines whose entry a convention cannot usefully describe, and this is a machine
    // with no asynchronous entry at all.
    Wasm32 -> FormAbsent("a wasm module is only ever entered by its embedder calling an exported " +
                         "function, so nothing arrives asynchronously and there is no handler for " +
                         "a convention to describe")

    // CRAFT has traps and still has nothing for a convention to describe: it enters every one at a
    // single vector, so what the hardware reaches is the kernel's decoder rather than a handler.
    Craft -> FormAbsent("CRAFT enters every trap at one vector with the reason in 'cause', so what " +
                        "the hardware reaches is the kernel's own decoder rather than a handler — " +
                        "write that entry in assembly, and let it call an ordinary function for " +
                        "each cause it decodes")

    X86 -> FormAbsent("sysl cannot lower for i386 at all, for want of a measured C ABI, so its " +
                      "interrupt convention is not something this compiler implements")

// Whether this processor's interrupt form takes a mode. Only RISC-V's does -- x86-64's convention
// describes the frame the hardware pushed and has no privilege level to name.
private takes_mode(cpu: Cpu) -> bool = cpu match
    Riscv64 -> true
    _ -> false

// Holds every declaration carrying a convention to what this processor allows.
//
// **A declaration pass, not part of the body walk.** Every rule is about the signature, and the
// signature exists whether or not the body is ever analyzed -- a generic handler nothing
// instantiates has no body walked at all, and it is exactly as wrong as one that does.
private check_conventions(a: &Analysis)
    val funcs = a.tables.funcs

    for i in 0..<funcs.len()
        val f = funcs.at(i)

        if f.decl.conv.is_some() then check_convention(a, funcs.key_at(i), f, f.decl.conv.unwrap())
end check_conventions

private check_convention(a: &Analysis, key: string, f: Func, c: CallConv)
    if c.name != InterruptConv then
        a.fault(f.scope, c.span, s"'${c.name}' is not a calling convention — '$InterruptConv' is " +
                "what there is")

    val cpu = a.tables.target.cpu

    interrupt_form(cpu) match
        // The reason comes from the table rather than from here, because the processors without an
        // interrupt form are without one for unrelated reasons.
        FormAbsent(why) ->
            a.fault(f.scope, c.span, s"'${c.name}' is not something ${cpu_symbol(cpu)} has: $why")
        form ->
            check_convention_mode(a, f, c, cpu)

            // Generic is refused before anything is resolved, because a type parameter has nothing
            // to resolve *to* out here.
            if !f.decl.tparams.is_empty() then
                a.fault(f.scope, c.span, "an interrupt handler is a single entry point the " +
                        s"processor jumps to, so '${qualified_name(key)}' cannot be generic — there would " +
                        "be no way to say which instantiation the vector holds")

            check_convention_shape(a, f, c, form)
end check_convention

// The parenthesised word, which only RISC-V has anything to put in.
//
// A mode on a processor with none is refused rather than dropped, because a reader who wrote
// `interrupt(supervisor)` believed it was saying something.
private check_convention_mode(a: &Analysis, f: Func, c: CallConv, cpu: Cpu)
    if c.arg.is_none() then return

    val mode = c.arg.unwrap()

    if takes_mode(cpu)
        if !holds_string(riscv_modes(), mode) then
            a.fault(f.scope, c.span, s"'$mode' is not a privilege mode — RISC-V has 'machine', " +
                    s"'supervisor', 'user', and an unwritten one is '$DefaultRiscvMode'")
    else
        a.fault(f.scope, c.span, s"'${c.name}($mode)' names a privilege mode, and " +
                s"${cpu_symbol(cpu)} has none to name — its interrupt convention describes the " +
                "frame the processor pushed, not the level it was pushed at. Write 'interrupt' alone")
end check_convention_mode

// The signature the ABI demands, which the two processors that have interrupts disagree about.
//
// Neither rule is sysl's invention and neither is negotiable: clang refuses an x86-64 handler
// without the frame pointer in as many words, and a RISC-V handler is entered with nothing in the
// argument registers that a parameter could have come from.
private check_convention_shape(a: &Analysis, f: Func, c: CallConv, form: InterruptForm)
    val ret = declared_result_type(f.decl.ret_type.map(t -> signature_result(a, f.decl.needs,
                                                                             f.scope, t, no_bindings())))

    // Nothing returns to. A handler is left through the processor's own return-from-interrupt,
    // which restores the interrupted context and has nowhere to put a value.
    if !no_value(ret) then
        a.fault(f.scope, c.span, "an interrupt handler returns to whatever it interrupted, so it " +
                s"yields nothing — '${f.decl.name}' declares ${type_show(ret)}")

    if f.decl.variadic then
        a.fault(f.scope, c.span, "an interrupt handler is entered by the processor with a fixed " +
                s"frame, so '${f.decl.name}' cannot be variadic")

    var params: Buf[Type] = buf()

    for item in f.decl.params
        params.push(signature_type(a, f.decl.needs, f.scope, item.typ,
                                   no_bindings()))

    form match
        // RISC-V enters the handler with the interrupted program's registers still live; there is
        // no argument to read, and a parameter would be whatever the interrupted code left behind.
        FormAttribute ->
            if !params.is_empty() then
                a.fault(f.scope, c.span, "a RISC-V interrupt handler is entered with no arguments, " +
                        s"so '${f.decl.name}' takes none — what the handler needs is read from the " +
                        "machine's own registers")

        // x86-64 pushes a frame and the ABI hands the handler its address; some vectors push an
        // error code after it. Clang refuses any other shape.
        FormConvention ->
            if params.is_empty() then
                a.fault(f.scope, c.span, "an x86-64 interrupt handler is handed the frame the " +
                        s"processor pushed, so '${f.decl.name}' takes a pointer to it — " +
                        s"'interrupt ${f.decl.name}(frame: *Frame)'")
            else if !frame_shaped(params) then
                a.fault(f.scope, c.span, "an x86-64 interrupt handler takes a pointer to the frame " +
                        "the processor pushed, optionally followed by the error code some vectors " +
                        "push after it — so at most '*T' and one integer, which is not what " +
                        s"'${f.decl.name}' declares")
        _ -> ()
end check_convention_shape

// A pointer to the frame, optionally followed by one integer, and nothing else.
private frame_shaped(params: Buf[Type]) -> bool
    val head = params[0] match
        Ptr(_) -> true
        _ -> false

    if !head || params.len() > 2 then return false

    if params.len() == 1 then return true

    params[1] match
        Integer(_, _, _) -> true
        _ -> false
end frame_shaped

// -- `@export`, and what C could name -------------------------------------------------------------

// Whether a declaration is one anything importing the module may name.
private is_public(v: Visibility) -> bool = v match
    Public -> true
    _ -> false

// Holds every declaration carrying `@export` -- a free function, and a struct naming itself for a
// generated header.
//
// **A free function and a struct are the whole of it, and that is the grammar's doing rather than a
// choice made here.** An attribute is read at statement position only, so none reaches a struct
// member, an enum member or an `impl` member -- a rule refusing `@export` on a method would be a
// rule nothing could reach, and the refusal a reader meets comes from the parser.
private check_exports(a: &Analysis)
    val funcs = a.tables.funcs

    for i in 0..<funcs.len()
        val f = funcs.at(i)

        if f.decl.exported.is_some() then
            check_export(a, funcs.key_at(i), f, f.decl.exported.unwrap())

    val types = a.tables.types

    for i in 0..<types.len()
        types.at(i).kind match
            StructOf(d) ->
                if d.cname.is_some() then
                    check_struct_export(a, types.key_at(i), types.at(i), d, d.cname.unwrap())
            TypeOf(d) ->
                if d.cname.is_some() then
                    check_type_export(a, types.key_at(i), types.at(i), d, d.cname.unwrap())
            _ -> ()
end check_exports

// Refuses a `type` a header could not declare as a `typedef` -- the struct's rules for its name.
// What it stands for is refused where the type is built, which every named subtype is whether or not
// anything writes it: a published name is a claim either way.
private check_type_export(a: &Analysis, key: string, at: Decl, d: TypeDecl, e: ExportAttr)
    if e.symbol.is_some() && !c_identifier(e.symbol.unwrap()) then
        a.fault(at.scope, e.span, s"'${e.symbol.unwrap()}' is not a name C can declare — a type's " +
                "name in a header is a C identifier, so it is a letter or '_' followed by letters, " +
                "digits and '_'")

    if e.symbol.is_none() && !c_identifier(module_bare(spelled_key(key))) then
        a.fault(at.scope, e.span, s"'${qualified_name(key)}' is not a name C can declare, so " +
                "naming it after itself would put a spelling in the header no C declaration could " +
                "use — name it instead, '@export(\"...\")'")

    if !is_public(d.vis) then
        a.fault(at.scope, e.span, s"'${qualified_name(key)}' is private, and a header declares " +
                "only public exports, none of which may name it — a declaration may not be more " +
                "visible than the types it names. No header can carry this type at all, so " +
                "there is no name in one for it to take")
end check_type_export

// Refuses a C name a header could not declare, or a struct that has no one name to give.
//
// **The rules are the function's, arrived at from a different direction.** A symbol and a type name
// are both spellings a C reader writes, so what C can name is the same question -- but a `typedef`
// has no linkage, so `private` would be a statement about nothing but the header. It is refused,
// and for a reason worth reading: the header declares only public exports, and the visibility rule
// already stops a public declaration naming a type less visible than itself.
private check_struct_export(a: &Analysis, key: string, at: Decl, d: StructDecl, e: ExportAttr)
    if e.symbol.is_some() && !c_identifier(e.symbol.unwrap()) then
        a.fault(at.scope, e.span, s"'${e.symbol.unwrap()}' is not a name C can declare — a type's " +
                "name in a header is a C identifier, so it is a letter or '_' followed by letters, " +
                "digits and '_'")

    // Checked against the declared name, since that is what an unwritten one becomes. A
    // backtick-quoted declaration is the case: it may hold anything the reader wanted.
    if e.symbol.is_none() && !c_identifier(module_bare(spelled_key(key))) then
        a.fault(at.scope, e.span, s"'${qualified_name(key)}' is not a name C can declare, so " +
                "naming it after itself would put a spelling in the header no C declaration could " +
                "use — name it instead, '@export(\"...\")'")

    if !is_public(d.vis) then
        a.fault(at.scope, e.span, s"'${qualified_name(key)}' is private, and a header declares " +
                "only public exports, none of which may name it — a declaration may not be more " +
                "visible than the types it names. No header can carry this type at all, so " +
                "there is no name in one for it to take")

    // Generic is refused for the reason an exported generic function is, and the argument is even
    // shorter here: every instantiation is a struct of its own, so one written name would be
    // claimed by all of them at once.
    if !d.tparams.is_empty() then
        a.fault(at.scope, e.span, s"a header names one type at one shape, so " +
                s"'${qualified_name(key)}' cannot be generic — each instantiation is a struct of " +
                "its own and they would all claim this one name. Wrap the instantiation the header " +
                "carries in a struct of its own and name that")
end check_struct_export

// Refuses an export whose symbol C could not name, or whose function C could not call.
private check_export(a: &Analysis, key: string, f: Func, e: ExportAttr)
    if e.symbol.is_some() && !c_identifier(e.symbol.unwrap()) then
        a.fault(f.scope, e.span, s"'${e.symbol.unwrap()}' is not a name C can call — an exported " +
                "symbol is a C identifier, so it is a letter or '_' followed by letters, digits " +
                "and '_'")

    // **An overload exported under its own name is refused here**, and it is worth catching by name
    // rather than leaving to the rule below: an overload's key carries a numbered segment, which is
    // not a C identifier, so the rule below would refuse it quoting a spelling the source does not
    // contain. C has no overloading at all -- two exports of one name are two definitions of one
    // symbol, which is a link error rather than anything a reader of either line could act on.
    if e.symbol.is_none() && overload_keys(a, overload_plain(key)).len() > 1 then
        a.fault(f.scope, e.span, s"'${qualified_name(key)}' is declared more than once, and C has " +
                "no overloading — two exports of one name would be two definitions of one symbol. " +
                "Give each export a symbol of its own, '@export(\"...\")'")

    // Checked against the **declared** name, since that is what an unwritten symbol becomes.
    if e.symbol.is_none() && !c_identifier(module_bare(spelled_key(overload_plain(key)))) then
        a.fault(f.scope, e.span, s"'${qualified_name(key)}' is not a name C can call, so exporting " +
                "it under its own name would publish a symbol no C declaration could spell — name " +
                "the symbol instead, '@export(\"...\")'")

    // Generic is refused before anything is resolved, for the reason a convention's is: a type
    // parameter has nothing to resolve *to* out here.
    if !f.decl.tparams.is_empty() then
        a.fault(f.scope, e.span, "an exported symbol is one function at one signature, so " +
                s"'${qualified_name(key)}' cannot be generic — there would be no way to say which " +
                "instantiation the linker holds. Export a wrapper per instantiation, each naming " +
                "its own symbol")

    // **The entry is never a default.** A weak `main` is the image's start a link may silently swap
    // for any other `main` it meets -- a C runtime's, a test harness's -- so the program would begin
    // somewhere nobody wrote.
    if e.weakly &&e.symbol.unwrap_or(module_bare(spelled_key(overload_plain(key)))) == "main" then
        a.fault(f.scope, e.span, "the entry point cannot be exported 'weak' — 'main' is where the " +
                "image starts, and a weak one is a default any other 'main' in the link replaces, so " +
                "the program would begin somewhere nobody wrote. Export it without 'weak'")

    // **`private` is not refused**: it is a promise about the sysl NAME, and an export is a promise
    // about a symbol. A private export keeps the name file-private and publishes the symbol hidden,
    // for the linker of the image it lands in -- module `asm` or a package's own C calling back in
    // (`emit_export.sysl`).

    if f.decl.ghost then
        a.fault(f.scope, e.span, s"'${qualified_name(key)}' is '@ghost', so it is erased before " +
                "codegen and there is no symbol for C to link against")

    if f.decl.test.is_some() then
        a.fault(f.scope, e.span, s"'${qualified_name(key)}' is a '@test', which only 'sysl test' " +
                "builds — an exported symbol has to be in the artifact a C project links, and a " +
                "test is not")

    // **A variadic export is not refused.** What a C caller puts in the tail is decided by C's
    // default argument promotions, which are the same under every prototype -- an integer narrower
    // than `int` arrives as `int`, a `float` as `double` -- and `va_arg` already refuses to read a
    // narrow type back out. Its named parameters are held to more than an ordinary export's
    // (`emit_checks.sysl`'s `export_signature`), there being no thunk in front of it.
end check_export
