module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.text.Search
import sysl.fs.{make_dir_all, make_temp_dir, read_text, remove_dir_all, write_text}

// What a project says about itself before a line of it is read.

private read(text: string) -> Manifest = read_manifest(text).unwrap()

private refused(text: string) -> string = read_manifest(text) match
    Err(why) -> why
    Ok(_) -> ""

@test("a name and a version")
a_name_and_a_version()
    val m = read("package {\n  name    = \"geom\"\n  version = \"1.4.2\"\n}\n")

    assert_eq(m.name, "geom")
    assert_eq(m.version, "1.4.2")

@test("and neither is required")
neither_is_required()
    assert_eq(read("targets { default = \"x86_64-linux\" }").name, "")

@test("a name that is a path rather than a name is refused, and so are the two directory names")
a_name_that_is_a_path_is_refused()
    assert(refused("package { name = \"build/tool\" }").index_of("names a path rather than a name")
           .is_some(), "a separator")
    assert(refused("package { name = \".\" }").index_of("names a path rather than a name")
           .is_some(), "this directory")
    assert(refused("package { name = \"..\" }").index_of("names a path rather than a name")
           .is_some(), "the one above")

@test("an empty name is refused as its own mistake")
an_empty_name_is_its_own_mistake()
    assert(refused("package { name = \"\" }").index_of("is empty").is_some(), "said so")

@test("an empty file is a project that said nothing")
an_empty_file_says_nothing()
    val m = read("")

    assert_eq(m.name, "")
    assert(m.dependencies.is_empty(), "no dependencies")
    assert(m.requires.is_empty(), "and nothing required")

@test("a package may state a compiler floor")
a_package_may_state_a_floor()
    assert_eq(read("package { name = \"sdl3\"\n version = \"0.2.6\"\n sysl = \"0.0.62\" }").floor,
              "0.0.62")
    assert_eq(read("package { name = \"sdl3\" }").floor, "")

@test("something that is not a version is refused, and the field is named")
a_floor_that_is_not_a_version_is_refused()
    val said = refused("package { sysl = \">= 0.0.62\" }")

    assert(said.index_of("'package.sysl'").is_some(), said)
    assert(said.index_of("is not a version").is_some(), said)

@test("an interim spelling is refused too -- a package states a release")
an_interim_floor_is_refused()
    assert(refused("package { sysl = \"0.0.66-fcf4e33a\" }").index_of("is not a version").is_some(),
           "said so")

@test("an older compiler is refused, naming the package, the floor and what is in hand")
an_older_compiler_is_refused()
    assert_eq(check_floor("github.com/sysl-lang/sdl3 v0.2.6", "0.0.62", "0.0.61").unwrap(),
              "github.com/sysl-lang/sdl3 v0.2.6 cannot be built because it requires sysl 0.0.62 " +
              "or newer, while the compiler in hand is 0.0.61")

@test("the floor itself is old enough, and so is anything above it")
the_floor_itself_is_enough()
    assert(check_floor("this project", "0.0.62", "0.0.62").is_none(), "the floor itself")
    assert(check_floor("this project", "0.0.62", "0.1.0").is_none(), "a minor above it")
    assert(check_floor("this project", "0.0.62", "1.0.0").is_none(), "a major above it")
    assert(check_floor("this project", "", "0.0.1").is_none(), "and no floor asks nothing")

@test("an interim compiler satisfies the floor its numbers reach")
an_interim_compiler_reaches_its_own_numbers()
    assert(check_floor("this project", "0.0.65", "0.0.66-fcf4e33a").is_none(), "dev at 0.0.66")

@test("a coordinate and a version")
a_dependency_is_a_coordinate_and_a_version()
    val deps = read("dependencies {\n  json { git = \"github.com/e/sysl-json\", version = \"1.4.0\" }\n}")
        .dependencies

    assert_eq(deps.len(), 1)
    assert_eq(deps.at(0).label, "json")
    assert_eq(dependency_coordinate(deps.at(0)).unwrap(), "github.com/e/sysl-json")
    assert_eq(release_shown(dependency_version(deps.at(0)).unwrap()), "1.4.0")
    assert(deps.at(0).mount.is_none(), "and it is not mounted anywhere")

@test("a dependency naming no coordinate, and one naming no version, are each refused")
a_dependency_needs_both_halves()
    assert_eq(refused("dependencies { json { version = \"1.0.0\" } }"),
              "'dependencies.json' names neither a 'git' coordinate nor a 'path'")
    assert_eq(refused("dependencies { json { git = \"github.com/e/j\" } }"),
              "'dependencies.json' names a 'git' coordinate and no 'version' — a coordinate says " +
              "which repository and a version says which of it")

@test("an unknown key at the top level is reported and ignored")
an_unknown_top_key_is_a_warning()
    val m = read("profiles { release { } }")

    assert_eq(m.warnings.len(), 1)
    assert(m.warnings.at(0).index_of("'profiles'").is_some(), m.warnings.at(0))
    assert(m.warnings.at(0).index_of(ManifestName).is_some(), m.warnings.at(0))
    assert(m.warnings.at(0).index_of("ignored").is_some(), m.warnings.at(0))

@test("and it does not stop the keys beside it from being read")
an_unknown_key_costs_nothing_else()
    val m = read("package { name = \"thing\", version = \"1.0.0\" }\nprofiles { release { } }\n")

    assert_eq(m.name, "thing")
    assert_eq(m.version, "1.0.0")
    assert_eq(m.warnings.len(), 1)

@test("one inside 'package' is reported the same way, under its own path")
an_unknown_package_key_is_reported_under_its_path()
    val m = read("package { name = \"thing\", licence = \"MIT\" }")

    assert_eq(m.warnings.len(), 1)
    assert(m.warnings.at(0).index_of("'package.licence'").is_some(), m.warnings.at(0))

// **What a machine provides is what the project says rather than what the registry knows.** A
// capability the manifest does not mention is provided, whatever the triple -- the prior is that a
// machine can do everything, so a manifest records what a machine *cannot* do. Whether a heap exists
// is a project engineering decision, which is why it is read out of the file and not derived.
@test("a capability the manifest does not mention is provided, whichever machine is asking")
a_requirement_unmentioned_is_provided()
    val m = read("requires { os = true, posix = true }")
    val board = target_named("aarch64-freestanding").unwrap()
    val mac = target_named("aarch64-macos").unwrap()

    assert(unmet_requirement(m, board).is_none(), "a bare-metal target the file said nothing about")
    assert(unmet_requirement(m, mac).is_none(), "and a hosted one")

@test("and a capabilities block is what takes one away, with a target's word over the project's")
a_capabilities_block_takes_one_away()
    val m = read("capabilities { os = false }\nrequires { os = true }")
    val mac = target_named("aarch64-macos").unwrap()

    assert_eq(unmet_requirement(m, mac).unwrap(),
              "this package requires 'os', and 'aarch64-macos' does not provide it")

    val layered = read("capabilities { os = false }\n" +
                       "targets { aarch64-macos { capabilities { os = true } } }\n" +
                       "requires { os = true }")

    assert(unmet_requirement(layered, mac).is_none(), "the machine's own word wins")
    assert_eq(unmet_requirement(layered, target_named("aarch64-linux").unwrap()).unwrap(),
              "this package requires 'os', and 'aarch64-linux' does not provide it")

@test("and a word that is not a capability at all is provided by nothing")
a_requirement_that_names_nothing()
    assert_eq(unmet_requirement(read("requires { threads = true }"),
                                target_named("aarch64-macos").unwrap()).unwrap(),
              "this package requires 'threads', and 'aarch64-macos' does not provide it")

@test("a package at a version is the same bytes for every project, so it lives under the cache")
a_package_lives_under_the_cache()
    assert_eq(fetch_directory("/c/sysl/pkg", "github.com/sysl-lang/parsing", Release(0, 9, 0)),
              "/c/sysl/pkg/github.com/sysl-lang/parsing/@v0.9.0")

@test("this repository's own manifest reads, and says what it says")
our_own_manifest_reads()
    val m = read_manifest(read_text("package.hocon").unwrap()).unwrap()

    assert_eq(m.name, "sysl")
    assert_eq(m.version, Version)
    // **No floor, which is what lets this tree be built by the compiler it is the source of.** A
    // floor states the oldest compiler that may read these files, and the compiler they make
    // reports 0.0.1 -- so any floor at all turns the product away from its own sources.
    assert_eq(m.floor, "")
    assert_eq(m.dependencies.len(), 1)
    assert_eq(dependency_coordinate(m.dependencies.at(0)).unwrap(),
              "github.com/sysl-lang/parsing")
    assert_eq(m.requires.len(), 1)
    assert_eq(m.requires.at(0), "heap")
    assert(m.warnings.is_empty(), "and nothing in it is a key this compiler does not know")

// **A package carries its own `.c` on the same terms the program does**, since a binding is a sysl
// surface over C and the C is part of what was fetched. The graph hands back parsed units, which say
// nothing about the files beside them, so what compiles a package's C is a walk over its
// **directory** -- and that is what this answers.
//
// The vendor directory beside the project is where the resolution looks first, so a package put
// there by hand is a package already fetched and nothing reaches the network.
@test("a fetched package's directory is what a build walks for the C it carries")
a_packages_directory_is_where_its_c_is_found()
    val root = make_temp_dir("sysl-pkg").unwrap()
    val here = s"$root/vendor/github.com/e/thing/@v1.2.3"

    make_dir_all(s"$here/thing").unwrap()
    write_text(s"$here/thing/thing.sysl", "module thing\n").unwrap()
    write_text(s"$here/side.c", "int side(void) { return 7; }\n").unwrap()

    val m = read("dependencies { thing { git = \"github.com/e/thing\", version = \"1.2.3\" } }")
    val roots = package_roots(root, m)

    assert_eq(roots.len(), 1)
    assert_eq(roots.at(0), here)

    val found = c_sources(roots.at(0), Some(MacOS)).unwrap()

    assert_eq(found.len(), 1)
    assert(found.at(0).ends_with("side.c"), found.at(0))
    remove_dir_all(root).unwrap_or(())
end a_packages_directory_is_where_its_c_is_found

// -- what a package's own carried C is compiled with -----------------------------------------------

@test("a 'defines' block says what each carried C file is compiled with")
a_defines_block()
    val m = read("defines {\n  \"c/one.c\" {\n    LESS_MEMORY = 1\n    NO_STDIO    = true\n  }\n}\n")

    assert_eq(m.defines.len(), 1)
    assert_eq(m.defines.at(0).0, "c/one.c")
    assert_eq(m.defines.at(0).1.len(), 2)

    // **`true` is a bare `-DNAME`** — what a `#ifdef` wants — and anything else scalar is
    // `-DNAME=value`, which is what a `#if` wants.
    assert_eq(m.defines.at(0).1.at(0), "LESS_MEMORY=1")
    assert_eq(m.defines.at(0).1.at(1), "NO_STDIO")

@test("a key's braces are alternatives, so one list configures every file that shares it")
a_braced_key_expands()
    val m = read("defines {\n  \"c/{one,two}.c\" {\n    OPT = true\n  }\n}\n")

    assert_eq(m.defines.len(), 2)
    assert_eq(m.defines.at(0).0, "c/one.c")
    assert_eq(m.defines.at(1).0, "c/two.c")
    assert_eq(m.defines.at(1).1.at(0), "OPT")

    val two = read("defines {\n  \"{a,b}/{x,y}.c\" {\n    OPT = true\n  }\n}\n")

    assert_eq(two.defines.len(), 4)
    assert_eq(two.defines.at(0).0, "a/x.c")
    assert_eq(two.defines.at(3).0, "b/y.c")

@test("'false' does not say which of two things is meant, and neither does a brace with no pair")
a_defines_block_refused()
    assert_eq(refused("defines {\n  \"c/one.c\" {\n    OPT = false\n  }\n}\n"),
              "'defines.\"c/one.c\".OPT' is false, which does not say which of two things is " +
              "meant — leave the line out to not define it, or write '0' to define it as zero, " +
              "which '#ifdef' still sees")
    assert_eq(refused("defines {\n  \"c/{one.c\" {\n    OPT = true\n  }\n}\n"),
              "'defines.\"c/{one.c\"' has an unbalanced brace — alternatives are written " +
              "'{one,two}', as a shell writes them")
    assert_eq(refused("defines {\n  \"c/{one,}.c\" {\n    OPT = true\n  }\n}\n"),
              "'defines.\"c/{one,}.c\"' has an empty alternative — whichever was meant can be " +
              "written out, and a group naming nothing configures nothing")

@test("a key names a '.c' file this package carries, and nothing above it")
a_defines_key_names_carried_c()
    assert_eq(refused("defines {\n  \"c/one.h\" {\n    OPT = true\n  }\n}\n"),
              "'defines.\"c/one.h\"' does not name a '.c' file — a macro is given to a " +
              "translation unit, and only the C this package carries is one it compiles")
    assert(refused("defines {\n  \"/tmp/one.c\" {\n    OPT = true\n  }\n}\n")
               .ends_with("which is written relative to the package's own root"),
           refused("defines {\n  \"/tmp/one.c\" {\n    OPT = true\n  }\n}\n"))
    assert(refused("defines {\n  \"../one.c\" {\n    OPT = true\n  }\n}\n")
               .ends_with("and nothing above it is this package's to configure"),
           refused("defines {\n  \"../one.c\" {\n    OPT = true\n  }\n}\n"))

@test("a file configured from two blocks is refused, a file being compiled once")
a_file_configured_twice()
    assert_eq(refused("defines {\n  \"c/{one,two}.c\" {\n    A = true\n  }\n" +
                      "  \"c/two.c\" {\n    B = true\n  }\n}\n"),
              "'defines' configures 'c/two.c' from more than one block — a file is compiled once, " +
              "so it is said in one place")

@test("the declared path is matched against the path the walk found the file at")
defines_reach_the_file_the_walk_found()
    // A walk answers an absolute, canonical path whatever the reader typed, so joining the root to
    // the declared path gives the same file under a different string — which reaches nothing, and
    // reaches it quietly.
    val m = read("defines {\n  \"sh/sysl/miniz/c/miniz.c\" {\n    TDEFL_LESS_MEMORY = 1\n  }\n}\n")

    assert_eq(defines_for(m, "/tmp/pkg/sh/sysl/miniz/c/miniz.c").len(), 1)
    assert_eq(defines_for(m, "/tmp/pkg/sh/sysl/miniz/c/miniz.c").at(0), "TDEFL_LESS_MEMORY=1")
    assert_eq(defines_for(m, "sh/sysl/miniz/c/miniz.c").len(), 1)
    assert_eq(defines_for(m, "/tmp/pkg/sh/sysl/miniz/c/shim.c").len(), 0)

    // A name that is not one the preprocessor could carry is refused where it is written.
    assert(refused("defines {\n  \"c/one.c\" {\n    \"1BAD\" = true\n  }\n}\n")
               .starts_with("'defines.\"c/one.c\".1BAD' is not a name a C macro can have"),
           refused("defines {\n  \"c/one.c\" {\n    \"1BAD\" = true\n  }\n}\n"))
end defines_reach_the_file_the_walk_found
