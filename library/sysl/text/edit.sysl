module sysl.text

import sysl.buf.{Buf, buf}
import sysl.unicode.{to_upper as unicode_upper, to_lower as unicode_lower}

// The operations that make new text -- the half `find.sysl` does not hold.
//
// **The file boundary is the allocator.** Everything in `find.sysl` answers with an offset, a
// `bool`, or a view of what it was given, so all of it is reachable under `no alloc`. Everything
// here builds bytes that were not there before and needs one. Keeping the two apart means a program
// that only searches never links an allocator on account of a `join` it does not call.
//
// **These take a `string` rather than being members of `Search`.** A default cannot write them: it
// would have to build a `Self` out of new bytes, and there is no way for a trait to say how -- a
// `[]const u8` has no constructor a default could reach. That is the honest boundary of the
// write-it-once trick, and it falls exactly where the allocator does.
//
// **What splitting hands back are views.** A piece of a split shares the bytes of the string it
// came from and costs a retain, so `split` allocates the *vector* and not the text. The older sysl
// copied every piece, because it had no O(1) substring to hand out -- this is the single place
// where the representation `04` chose pays off most visibly.

/** The pieces between each occurrence of a separator.
 *
 * Adjacent separators yield an empty piece between them, and a separator at either end yields an
 * empty piece outside it, so the count is always one more than the number of separators found and
 * nothing about the input is silently dropped. A caller wanting the other behaviour wants `fields`.
 *
 * **An empty separator yields the whole string as one piece.** Splitting on nothing has no
 * meaningful answer here: the byte-level reading would cut multi-byte characters in half and hand
 * back pieces that are not text, and the character-level reading is what `s.chars` already is.
 */
split(s: string, sep: string) -> []string
    var out: Buf[string] = buf()

    if sep.len == 0
        out.push(s)
        return out.view()

    var start: usize = 0

    loop
        var rest = s[start..]

        rest.index_of(sep) match
            Some(at) ->
                out.push(s[start..<start + at])
                start += at + sep.len
            None ->
                out.push(rest)
                break

    out.view()
end split

/** The runs of non-whitespace, with the whitespace between them discarded.
 *
 * This is not `split` on a space: a run of several spaces separates two fields rather than
 * producing empty ones between them, and leading or trailing whitespace produces nothing at all.
 * It is what reading a line of columns wants, and writing it as a `split` and a filter would be
 * slower and no clearer.
 */
fields(s: string) -> []string
    var out: Buf[string] = buf()
    var b = s.bytes
    var i: usize = 0

    while i < b.len
        while i < b.len && b[i].is_space()
            i += 1

        if i >= b.len then break

        var start = i

        while i < b.len && !b[i].is_space()
            i += 1

        out.push(s[start..<i])

    out.view()
end fields

/** Every piece laid end to end with a separator between, which is `split`'s inverse whenever the
 * separator is one `split` would have found.
 *
 * It sizes the buffer before it starts, since it can: the answer's length is the sum of the pieces
 * plus the separators, and knowing it turns a series of doublings into one allocation.
 */
join(parts: []const string, sep: string) -> string
    if parts.len == 0 then return ""

    var total = sep.len * (parts.len - 1)

    for p in parts
        total += p.len

    var b = str_builder_with_capacity(total)
    var first = true

    for p in parts
        if !first then b.push(sep)
        b.push(p)
        first = false

    b.finish()
end join

/** The text repeated `n` times, and nothing when `n` is zero. */
repeat(s: string, n: usize) -> string
    if n == 0 || s.len == 0 then return ""

    var b = str_builder_with_capacity(s.len * n)
    var k: usize = 0

    while k < n
        b.push(s)
        k += 1

    b.finish()
end repeat

/** Every non-overlapping occurrence of `old` replaced by `new`, left to right.
 *
 * Non-overlapping and left-to-right is the same rule `count_of` counts by, so the number of
 * replacements made is exactly the number it reports -- and the scan continues *after* what was
 * substituted, so a replacement containing the pattern does not feed on itself.
 *
 * An empty `old` matches nowhere rather than everywhere: the alternative inserts a copy of `new`
 * between every pair of bytes, which for a `string` would cut multi-byte characters apart.
 */
replace_all(s: string, old: string, new: string) -> string
    if old.len == 0 || old.len > s.len then return s

    var b = str_builder_with_capacity(s.len)
    var start: usize = 0

    loop
        var rest = s[start..]

        rest.index_of(old) match
            Some(at) ->
                b.push(s[start..<start + at])
                b.push(new)
                start += at + old.len
            None ->
                b.push(rest)
                break

    b.finish()
end replace_all

/** Unicode case conversion.
 *
 * **It walks characters rather than bytes, and that is what keeps it safe.** A byte map would be
 * the faster loop and would need a way to put a raw byte into a builder -- which is the one thing
 * the builder deliberately does not offer, since a public `write` taking bytes is
 * `from_utf8_unchecked` with a longer name (`reference/strings.md § Making new bytes`). Going
 * through `push_char` instead means every way in still carries the UTF-8 guarantee and no unchecked
 * primitive is named here at all. The decode and re-encode that costs is the right price for that.
 *
 * It works because `sysl.unicode.to_upper` is **total**: a character the database gives no mapping
 * for comes back as itself, so text that has no case is re-encoded to exactly the bytes it arrived
 * as.
 *
 * **~~IT IS ASCII AND ITS NAME DOES NOT SAY SO~~ -- IT IS UNICODE NOW, AND THE PARAGRAPH THAT USED
 * TO BE HERE IS THE REASON THIS ONE IS.** `to_upper("héllo")` was `HéLLO`, the `é` untouched,
 * because the mapping was `Ascii for char`; it is `HÉLLO`. What changed is not this function but
 * what is underneath it: the Unicode Character Database is in the standard library now, as
 * `sysl.unicode`, and this is a walk over its per-character mapping.
 *
 * **~~A Unicode case table belongs in a package rather than here~~ -- IT IS HERE, AND THE
 * MEASUREMENT THAT SAID OTHERWISE WAS ANSWERING A QUESTION ABOUT THE MODULE.** Card `0320` costed
 * the simple mapping at about 1,357 range entries and roughly 16KB, and refused it on the grounds
 * that `sysl.text` is not optional -- it is what places a diagnostic's caret -- so every
 * freestanding program would link the table. That inference is the false step. The library is one
 * archive with an object per C file, an archive member is pulled in only to resolve a symbol
 * something already referenced, and the link runs `-dead_strip` over `-ffunction-sections`; so what
 * a program links is decided by the functions it calls and not by the modules it drags in. A
 * program that never calls `to_upper` links no table, and `StdArtifactTests` pins exactly that.
 *
 * What is still true, and is what `sysl.unicode` says rather than this: the mapping is the *simple*
 * one, character for character. *Special* casing, where a character uppercases to more than one and
 * the result is longer than its input, is `sysl.unicode.fold`'s -- and that is the operation a
 * caller comparing two strings wanted anyway. The case that surprises people is `ß`, which most
 * languages uppercase to `SS`: the simple mapping gives `ẞ`, and `sysl.unicode.to_upper` says why.
 * *Locale-sensitive* casing needs a notion of locale this library does not have.
 */
to_upper(s: string) -> string
    // A hint rather than a bound: a simple mapping may change a character's width in either
    // direction -- `ſ` uppercases to the one-byte `S` and `ɐ` to the three-byte `Ɐ` -- so the
    // builder grows if it has to, exactly as it would from any other guess.
    var b = str_builder_with_capacity(s.len)

    for c in s.chars do b.push_char(unicode_upper(c))

    b.finish()
end to_upper

/** The other direction, and everything `to_upper` says applies to it unchanged: `to_lower("HÉLLO")`
 * is `héllo`.
 */
to_lower(s: string) -> string
    var b = str_builder_with_capacity(s.len)

    for c in s.chars do b.push_char(unicode_lower(c))

    b.finish()
end to_lower
