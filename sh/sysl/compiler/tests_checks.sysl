module sh.sysl.compiler
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.Search

// What a whole program is refused for, and what it says.
//
// **Every message here was read out of the reference compiler**, by handing the installed `sysl` the
// same source and quoting what came back -- never composed from the rule. Each check gets both
// halves: the source that is refused, and the neighbouring one that is not.

private said(text: string) -> string
    val ds = stmt_diagnostics(text)

    if ds.is_empty() then return ""

    ds.at(0)
end said

private how_many(text: string) -> usize = stmt_diagnostics(text).len()

// The same, beside the standard module -- which a check about a library trait needs, since `Drop` is
// an ordinary declaration of it.
private var checks_library_cache: Buf[Program] = buf()
private var checks_library_read: bool = false

private checks_library() -> Buf[Program]
    if checks_library_read then return checks_library_cache

    checks_library_read = true

    std_root() match
        Err(_) -> ()
        Ok(root) -> std_units(root, host_target()) match
            Err(_) -> ()
            Ok(units) -> checks_library_cache = units

    checks_library_cache
end checks_library

private checks_no_library() -> bool
    if checks_library().is_empty()
        print("skipped: the standard module's source is not on this machine")
        return true

    false
end checks_no_library

private checks_program(text: string) -> TProgram
    val parsed = parse(source_of("test.sysl", text))
    var units: Buf[Program] = buf()
    val library = checks_library()

    for i in 0..<library.len()
        units.push(library.at(i))

    units.push(parsed.program)

    program_of(analyze_bodies(units, host_target()), "")
end checks_program

// What the program warned about, as messages.
private warned(text: string) -> Buf[string]
    val p = checks_program(text)
    var out: Buf[string] = buf()

    for i in 0..<p.warnings.len()
        out.push(p.warnings.at(i).diag.message)

    out
end warned

// The symbol each type with a destructor is released through.
private destructors(text: string) -> Buf[string]
    val p = checks_program(text)
    var out: Buf[string] = buf()

    for i in 0..<p.destructors.len()
        out.push(s"${p.destructors.at(i).0} -> ${p.destructors.at(i).1}")

    out
end destructors

// -- `@ghost` --------------------------------------------------------------------------------

private ghost_erased() -> string =
    "'m.spec' is '@ghost', so it exists for the specification and is not there when the program " +
    "runs — it may be called from a 'require', an 'ensure', a loop's 'invariant' or 'variant', or " +
    "from another '@ghost' function, and from nowhere else"

private a_ghost() -> string = "module m\n\n@ghost\nspec(n: int) -> bool = n > 0\n\n"

@test("a '@ghost' function called from something that runs is refused")
a_ghost_called_from_code()
    assert_eq(said(a_ghost() + "use(n: int) -> bool = spec(n)\n"), ghost_erased())

@test("and so is one called from a body reached through a statement")
a_ghost_called_from_a_statement()
    assert_eq(said(a_ghost() + "use(n: int) -> int\n    if spec(n) then return 1\n\n    0\n"),
              ghost_erased())

@test("a contract clause is where a '@ghost' function may be called")
a_ghost_called_from_a_contract()
    assert_eq(how_many(a_ghost() + "ok(n: int) -> int\n    require spec(n)\n" +
                       "    ensure spec(result)\n\n    n\n"), 0)

@test("and so is a loop's 'invariant'")
a_ghost_called_from_an_invariant()
    assert_eq(how_many(a_ghost() + "run(n: int) -> int\n    var i = 0\n\n    while i < n\n" +
                       "        invariant spec(n)\n\n        i += 1\n\n    i\n"), 0)

@test("a '@ghost' function may call another, its own body being where real state is read")
a_ghost_calling_a_ghost()
    assert_eq(how_many(a_ghost() + "@ghost\nother(n: int) -> bool = spec(n)\n"), 0)

// -- a value with a destructor, handed back by value ---------------------------------------------

// Everything the program has to say about a source read beside the library, less what the library
// itself says.
private complaints_of(text: string) -> Buf[string]
    val parsed = parse(source_of("test.sysl", text))
    var out: Buf[string] = buf()

    if !parsed.ok()
        out.push(parsed.report.at(0).message)
        return out
    end if

    var units: Buf[Program] = buf()
    val library = checks_library()

    for i in 0..<library.len()
        units.push(library.at(i))

    units.push(parsed.program)

    val done = analyze_bodies(units, host_target())

    for i in 0..<done.reported.len()
        if !done.reported.at(i).src.name.starts_with("library/") then
            out.push(done.reported.at(i).diag.message)

    out
end complaints_of

private says(xs: Buf[string], message: string) -> bool
    for i in 0..<xs.len()
        if xs.at(i) == message then return true

    false
end says

private listed_of(xs: Buf[string]) -> string
    var out = ""

    for i in 0..<xs.len()
        out = out + (if i > 0 then " | " else "") + xs.at(i)

    out
end listed_of

private a_handle() -> string =
    "struct Handle\n    fd: int\n\nimpl Drop for Handle\n    drop(self) = ()\n\n"

@test("handing back a value whose type has a 'Drop' is warned about")
a_drop_type_returned_by_value()
    if checks_no_library() then return

    val w = warned(a_handle() + "open(n: int) -> Handle = Handle(n)\n")

    assert_eq(w.len(), usize(1), s"warned ${w.len()}")
    assert_eq(w.at(0), "'open' hands back 'Handle' by value, and 'Handle' has a 'Drop' — a " +
              "destructor runs when a box's count reaches zero, so nothing here will ever call " +
              "it. Return '&Handle' instead, or take the resource apart before returning it")

@test("handing back the boxed form is what the warning asks for, so it says nothing")
a_drop_type_returned_boxed()
    if checks_no_library() then return

    assert_eq(warned(a_handle() + "lend(n: int) -> &Handle = Handle(n)\n").len(), usize(0))

@test("a raw pointer owns nothing, so handing one back makes no claim about who frees it")
a_drop_type_behind_a_pointer()
    if checks_no_library() then return

    assert_eq(warned(a_handle() + "at(p: *Handle) -> *Handle = p\n").len(), usize(0))

@test("the 'drop' the block itself declares never trips the rule")
the_drop_member_itself()
    if checks_no_library() then return

    assert_eq(warned(a_handle()).len(), usize(0))

@test("a type this compilation made real and gave a destructor is released through its 'drop'")
a_destructor_is_recorded()
    if checks_no_library() then return

    val ds = destructors(a_handle() + "open(n: int) -> &Handle = Handle(n)\n")

    assert_eq(ds.len(), usize(1), s"recorded ${ds.len()}")
    assert_eq(ds.at(0), "Handle -> Handle.drop")

@test("a program with no destructor records none")
no_destructor_at_all()
    if checks_no_library() then return

    assert_eq(destructors("struct P\n    x: int\n\nmk(n: int) -> P = P(n)\n").len(), usize(0))

// -- `@assert` -----------------------------------------------------------------------------------

@test("an assertion that does not hold names the values it compared")
an_assertion_that_fails()
    assert_eq(said("const N: int = 4\n\n@assert(N == 5, \"four is not five\")\n"),
              "assertion failed: four is not five — the left side is 4")

@test("and says only that where nothing was written to explain it")
an_assertion_that_fails_with_no_message()
    assert_eq(said("const N: int = 4\n\n@assert(N > 9)\n"),
              "assertion failed — the left side is 4")

@test("an assertion that holds says nothing")
an_assertion_that_holds()
    assert_eq(how_many("const N: int = 4\n\n@assert(N == 4)\n"), 0)

@test("a condition that is not one is refused for what it is instead")
an_assertion_that_is_not_a_condition()
    assert_eq(said("@assert(1 + 1)\n"),
              "'@assert' takes a condition, and this is an integer — an assertion is something " +
              "that can be true or false")

@test("and one that cannot be settled while compiling is refused for that")
an_assertion_that_does_not_fold()
    assert_eq(said("size() -> int = 3\n\n@assert(size() > 0)\n"),
              "'@assert' is settled while compiling, so its condition has to be a constant " +
              "expression — a literal, a 'const', 'sizeof', 'alignof', 'offsetof', or the " +
              "arithmetic and comparisons over them, and never a call")

@test("an assertion inside a generic body is settled at each instantiation, and names the bindings")
an_assertion_inside_a_generic()
    assert_eq(said("pack[T](x: T) -> usize\n    @assert(sizeof(T) <= 2, \"too wide\")\n\n" +
                   "    sizeof(T)\n\nuse() -> usize = pack[int](1)\n"),
              "assertion failed: too wide — the left side is 4 — where T = int")

@test("and one waiting on a measurement of a type parameter is not a mistake at the declaration")
an_assertion_awaiting_an_instantiation()
    assert_eq(how_many("pack[T](x: T) -> usize\n    @assert(sizeof(T) <= 8)\n\n    sizeof(T)\n"), 0)

// -- what a measurement is, and what a lifted clause is called ------------------------------------

@test("a measurement is a 'usize' whatever position it stands in")
sizeof_is_always_a_usize()
    assert_eq(said("f() -> int = sizeof(int)\n"),
              "function 'f' should return int, but its body yields usize")

@test("and an instantiation's body is named as the declaration a reader wrote")
an_instantiation_names_its_declaration()
    assert_eq(said("pack[T](x: T) -> int = sizeof(T)\n\nuse() -> int = pack[int](1)\n"),
              "function 'pack' should return int, but its body yields usize")

// -- a calling convention, and what a processor makes of it ---------------------------------------

private for_machine(text: string, name: string) -> string
    val t = target_named(name)

    if t.is_none() then return s"no target called '$name'"

    val ds = stmt_diagnostics_for(text, t.unwrap())

    if ds.is_empty() then return ""

    ds.at(0)
end for_machine

private many_for(text: string, name: string) -> usize
    val t = target_named(name)

    if t.is_none() then return usize(99)

    stmt_diagnostics_for(text, t.unwrap()).len()
end many_for

private a_frame() -> string = "struct Frame\n    ip: usize\n\n"

@test("a processor with no interrupt form says so in its own terms")
an_interrupt_on_a_machine_without_one()
    assert_eq(for_machine(a_frame() + "interrupt handler(frame: *Frame) = ()\n", "aarch64-macos"),
              "'interrupt' is not something aarch64 has: its exception entry goes through a " +
              "vector table of fixed-size instruction slots, so a handler is assembly and there " +
              "is nothing here for a convention to describe")

@test("and each of them says something true of its own machine")
each_machine_without_one_says_its_own_reason()
    val text = a_frame() + "interrupt handler(frame: *Frame) = ()\n"

    assert(for_machine(text, "thumb-freestanding").contains("Cortex-M exception"),
           for_machine(text, "thumb-freestanding"))
    assert(for_machine(text, "wasm32-freestanding").contains("nothing arrives asynchronously"),
           for_machine(text, "wasm32-freestanding"))
    assert(for_machine(text, "craft-freestanding").contains("the reason in 'cause'"),
           for_machine(text, "craft-freestanding"))

@test("an x86-64 handler taking the frame the processor pushed is what the ABI wants")
an_x86_handler_that_is_shaped_right()
    assert_eq(many_for(a_frame() + "interrupt handler(frame: *Frame) = ()\n", "x86_64-linux"), 0)
    assert_eq(many_for(a_frame() + "interrupt handler(frame: *Frame, code: int) = ()\n",
                       "x86_64-linux"), 0)

@test("one taking nothing is told what to write instead")
an_x86_handler_with_no_frame()
    assert_eq(for_machine("interrupt handler() = ()\n", "x86_64-linux"),
              "an x86-64 interrupt handler is handed the frame the processor pushed, so 'handler' " +
              "takes a pointer to it — 'interrupt handler(frame: *Frame)'")

@test("and one taking something else is told what the shape is for")
an_x86_handler_of_the_wrong_shape()
    assert_eq(for_machine("interrupt handler(a: int, b: int) = ()\n", "x86_64-linux"),
              "an x86-64 interrupt handler takes a pointer to the frame the processor pushed, " +
              "optionally followed by the error code some vectors push after it — so at most '*T' " +
              "and one integer, which is not what 'handler' declares")

@test("a RISC-V handler is entered with no arguments at all")
a_riscv_handler_takes_none()
    assert_eq(many_for("interrupt handler() = ()\n", "riscv64-freestanding"), 0)
    assert_eq(for_machine(a_frame() + "interrupt handler(frame: *Frame) = ()\n",
                          "riscv64-freestanding"),
              "a RISC-V interrupt handler is entered with no arguments, so 'handler' takes none — " +
              "what the handler needs is read from the machine's own registers")

@test("a handler yields nothing, since there is nowhere for a value to go")
a_handler_that_returns_something()
    assert_eq(for_machine("interrupt handler() -> int = 1\n", "riscv64-freestanding"),
              "an interrupt handler returns to whatever it interrupted, so it yields nothing — " +
              "'handler' declares int")

@test("and it cannot be generic, there being no way to say which instantiation the vector holds")
a_generic_handler()
    assert_eq(for_machine("interrupt handler[T]() = ()\n", "riscv64-freestanding"),
              "an interrupt handler is a single entry point the processor jumps to, so 'handler' " +
              "cannot be generic — there would be no way to say which instantiation the vector holds")

@test("a privilege mode is RISC-V's alone, and only three of them are modes")
a_privilege_mode()
    assert_eq(many_for("interrupt(supervisor) handler() = ()\n", "riscv64-freestanding"), 0)
    assert_eq(for_machine("interrupt(hypervisor) handler() = ()\n", "riscv64-freestanding"),
              "'hypervisor' is not a privilege mode — RISC-V has 'machine', 'supervisor', 'user', " +
              "and an unwritten one is 'machine'")

@test("and a machine with none to name is told to write the convention alone")
a_privilege_mode_where_there_are_none()
    assert_eq(for_machine("interrupt(machine) handler(frame: *int) = ()\n", "x86_64-linux"),
              "'interrupt(machine)' names a privilege mode, and x86_64 has none to name — its " +
              "interrupt convention describes the frame the processor pushed, not the level it " +
              "was pushed at. Write 'interrupt' alone")

// -- `@export`, and what C could name -------------------------------------------------------------

@test("a symbol C could not spell is refused as one")
an_export_symbol_c_cannot_spell()
    assert_eq(said("@export(\"0bad\")\none() = ()\n"),
              "'0bad' is not a name C can call — an exported symbol is a C identifier, so it is a " +
              "letter or '_' followed by letters, digits and '_'")

@test("and a declaration whose own name C could not spell is told to name the symbol")
an_export_of_a_name_c_cannot_spell()
    assert_eq(said("@export\n`0odd`() = ()\n"),
              "'0odd' is not a name C can call, so exporting it under its own name would publish " +
              "a symbol no C declaration could spell — name the symbol instead, '@export(\"...\")'")

@test("'private' and an export are opposite promises about who may call")
a_private_export()
    assert_eq(said("@export\nprivate two() = ()\n"),
              "'two' is private, which promises every caller is inside its own module — and an " +
              "export promises the opposite. A definition cannot make both claims")

@test("an exported symbol is one function at one signature, so it cannot be generic")
a_generic_export()
    assert_eq(said("@export\nthree[T](x: T) = ()\n"),
              "an exported symbol is one function at one signature, so 'three' cannot be generic " +
              "— there would be no way to say which instantiation the linker holds. Export a " +
              "wrapper per instantiation, each naming its own symbol")

@test("a '@ghost' declaration is erased, so there is nothing to link against")
a_ghost_export()
    assert_eq(said("@export\n@ghost\nfour() -> bool = true\n"),
              "'four' is '@ghost', so it is erased before codegen and there is no symbol for C to " +
              "link against")

@test("and a '@test' is not in the artifact a C project links")
a_test_export()
    assert_eq(said("@export\n@test(\"t\")\nfive() = ()\n"),
              "'five' is a '@test', which only 'sysl test' builds — an exported symbol has to be " +
              "in the artifact a C project links, and a test is not")

@test("a variadic definition's tail is promoted by a prototype this declaration never saw")
a_variadic_export()
    assert_eq(said("@export\nsix(a: int, ...) = ()\n"),
              "'six' is variadic, and what a C caller promotes into the tail is decided by the " +
              "prototype it compiled against rather than by this declaration — take a 'va_list' " +
              "parameter instead, which states the same thing and is what C's own 'v' variants do")

@test("C has no overloading, so two exports of one name would be one symbol twice")
an_overloaded_export()
    assert_eq(said("@export\ndup(a: int) = ()\n\ndup(a: real) = ()\n"),
              "'dup' is declared more than once, and C has no overloading — two exports of one " +
              "name would be two definitions of one symbol. Give each export a symbol of its own, " +
              "'@export(\"...\")'")

@test("an export C can call and name says nothing")
an_export_that_is_fine()
    assert_eq(how_many("@export\ngood(a: int, b: *int) = ()\n"), 0)

@test("a type's name in a header is a C identifier too")
a_struct_export_c_cannot_declare()
    assert_eq(said("@export(\"0Bad\")\nstruct Named\n    x: int\n"),
              "'0Bad' is not a name C can declare — a type's name in a header is a C identifier, " +
              "so it is a letter or '_' followed by letters, digits and '_'")

@test("a private struct appears in no signature a header carries")
a_private_struct_export()
    assert_eq(said("@export\nprivate struct Hidden\n    x: int\n"),
              "'Hidden' is private, so no exported function may name it — an export is public, " +
              "and a declaration may not be more visible than the types it names. No header can " +
              "carry this type at all, so there is no name in one for it to take")

@test("and a header names one type at one shape, so a generic struct has no one name to give")
a_generic_struct_export()
    assert_eq(said("@export\nstruct Gen[T]\n    x: T\n"),
              "a header names one type at one shape, so 'Gen' cannot be generic — each " +
              "instantiation is a struct of its own and they would all claim this one name. Wrap " +
              "the instantiation the header carries in a struct of its own and name that")

@test("a struct named for a header under a name C can declare says nothing")
a_struct_export_that_is_fine()
    assert_eq(how_many("@export(\"Ok\")\nstruct Good\n    x: int\n"), 0)

// -- where a program starts ------------------------------------------------------------------------

@test("'main' is called by the platform, which has no type arguments to give it")
a_generic_main()
    assert_eq(said("main[T]() = ()\n"),
              "'main' is called by the platform, which has no type arguments to give it")

@test("a 'main' yields nothing or a 'Result[unit, E]', and an exit status is not a signature's to say")
a_main_that_results_in_something_else()
    assert_eq(said("main() -> int = 1\n"),
              "'main' yields nothing or a 'Result[unit, E]', so it may not result in int — a " +
              "program's exit status is not something a signature can say. 'exit(code)' is how a " +
              "program chooses its own, and prints nothing")

@test("a 'main' is called with the arguments the platform has, not a list it reads")
a_variadic_main()
    assert_eq(said("main(a: int, ...) = ()\n"),
              "'main' is called with the arguments the platform has, not a list it reads")

@test("and it takes either nothing or the one '[]string' the platform can fill")
a_main_taking_something_else()
    assert_eq(said("main(a: int, b: int) = ()\n"),
              "'main' takes either nothing or one '[]string' of the program's arguments, not " +
              "(int, int)")

@test("a 'main' taking nothing says nothing")
a_main_that_is_fine()
    assert_eq(how_many("main() = ()\n"), 0)

// -- what a module says it needs, and what it gives up ---------------------------------------------

@test("a clause naming nothing is refused with the set there is")
a_capability_that_is_not_one()
    assert_eq(said("module mm\n@requires(nonesuch)\n"),
              "no capability is called 'nonesuch' — the set is 'heap', 'os', 'posix'")
    assert_eq(said("module mm\n@no_nonesuch\n"),
              "no capability is called 'nonesuch' — the set is 'heap', 'os', 'posix'")

@test("a 'requires' names a facility, so the conduct's word is refused with the facility's")
a_requires_naming_the_conduct()
    assert_eq(said("module mm\n@requires(alloc)\n"),
              "'alloc' is what a module does, not something a machine has — a 'requires' names " +
              "the facility, so this is '@requires(heap)'")

@test("and a narrowing names the conduct, so the facility's word is refused with the conduct's")
a_narrowing_naming_the_facility()
    assert_eq(said("module mm\n@no_heap\n"),
              "'@no_heap' says a machine has no heap, which is the project's to say and not this " +
              "module's — what a module promises is what it does, so this is '@no_alloc'")

@test("one capability said twice means the author believed two clauses were doing different work")
a_capability_declared_twice()
    assert_eq(said("module mm\n@no_alloc\n@no_alloc\n"),
              "'alloc' is declared twice, and the second says nothing the first did not")

@test("and a module cannot do without something it cannot be built without")
a_capability_both_given_up_and_required()
    assert_eq(said("module mm\n@no_alloc\n@requires(heap)\n"),
              "'heap' is both given up and required here, and a module cannot do without " +
              "something it cannot be built without — '@no_alloc' and 'requires heap' are the two " +
              "directions of one capability")

@test("a clause that names a capability once says nothing")
a_capability_stated_once()
    assert_eq(how_many("module mm\n@requires(posix)\n"), 0)
    assert_eq(how_many("module mm\n@no_alloc\n"), 0)

// -- a module that gave the allocator up -----------------------------------------------------------

private allocator_free() -> string = "module mm\n@no_alloc\n\n"

private needs_one(what: string) -> string =
    s"$what needs an allocator, and this module declared '@no_alloc' — it may hold and release " +
    "storage made elsewhere, and may make none of its own"

@test("a reference is made on the heap, so an allocator-free module may not make one")
a_reference_in_an_allocator_free_module()
    if checks_no_library() then return

    assert(says(complaints_of(allocator_free() + "mk() -> &int = 1\n"), needs_one("a reference")),
           listed_of(complaints_of(allocator_free() + "mk() -> &int = 1\n")))

@test("and neither a slice with storage of its own, nor the string a value renders as")
the_other_allocations()
    if checks_no_library() then return

    assert(says(complaints_of(allocator_free() + "mk() -> []int = [1, 2]\n"),
                needs_one("a slice with storage of its own")),
           listed_of(complaints_of(allocator_free() + "mk() -> []int = [1, 2]\n")))
    assert(says(complaints_of(allocator_free() + "mk(n: int) -> string = str(n)\n"),
                needs_one("the string a value renders as")),
           listed_of(complaints_of(allocator_free() + "mk(n: int) -> string = str(n)\n")))

@test("an empty slice is the zero value of its own representation, so it reaches no allocator")
an_empty_slice_allocates_nothing()
    if checks_no_library() then return

    assert_eq(complaints_of(allocator_free() + "mk() -> []int\n    val e: []int = []\n\n    e\n").len(),
              usize(0))

@test("a call that arrives somewhere that allocates is reported at the call")
a_call_that_reaches_an_allocation()
    if checks_no_library() then return

    val out = complaints_of(allocator_free() + "private mk() -> &int = 1\n\n" +
                            "go()\n    val x = mk()\n")

    assert(says(out, "this reaches 'mm.mk', which makes heap storage, and this module declared " +
                "'@no_alloc' — an allocator-free module may only call what is allocator-free itself"),
           listed_of(out))

@test("a module that gave nothing up may allocate as it likes")
a_module_with_no_clause()
    if checks_no_library() then return

    assert_eq(complaints_of("module mm\n\nmk() -> &int = 1\n").len(), usize(0))

// -- a field holding something callable ------------------------------------------------------------

@test("a field holding a callable is called through the selection that reads it")
a_callable_field()
    if checks_no_library() then return

    assert_eq(complaints_of("struct Holder\n    f: &Fn(int) -> unit\n\n" +
                            "run(h: Holder)\n    h.f(1)\n").len(), usize(0))

@test("and one reached through a reference is the same call, the shorthand walking one level")
a_callable_field_through_a_reference()
    if checks_no_library() then return

    assert_eq(complaints_of("struct Holder\n    f: &Fn(int) -> unit\n\n" +
                            "run(h: &Holder)\n    h.f(1)\n").len(), usize(0))

@test("a field that is not callable is still not a method")
a_field_that_is_not_callable()
    if checks_no_library() then return

    assert(says(complaints_of("struct Holder\n    n: int\n\nrun(h: Holder)\n    h.n(1)\n"),
                "type 'Holder' has no method 'n'"),
           listed_of(complaints_of("struct Holder\n    n: int\n\nrun(h: Holder)\n    h.n(1)\n")))

// -- which modules a module reached ----------------------------------------------------------------

@test("the root module depends like any other, and nothing depends on it")
the_root_module_only_ever_depends()
    if checks_no_library() then return

    val p = checks_program("struct Holder\n    f: &Fn(int) -> unit\n\n" +
                           "run(h: Holder)\n    h.f(1)\n")
    var from_root = false

    for i in 0..<p.module_deps.len()
        if p.module_deps.at(i).0 == "" then from_root = true

        assert(!holds_string(p.module_deps.at(i).1, ""), "something depends on the root module")

    assert(from_root, "the root module reached nothing")
