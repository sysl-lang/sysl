module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.math.bigint.{BigInt, from_int}

// **Module storage**, and the constant expressions that fill it.
//
// A `val`'s initializer is text laid straight into the object file, with no instruction emitted for
// any of it. What cannot be written that way is `computed`, and the entry point fills it -- so the
// global is emitted zeroed and this file has nothing to say about it.

// What a `val`'s storage starts at. A `computed` one is filled by the entry point, so the object
// file carries zeros for it and nothing here has anything to say.
private val_init(e: *Emit, v: TVal) -> Val
    if v.computed then return VZero

    v.init match
        Some(x) -> constant_value(e, x)
        None -> VZero
end val_init

// A `val`'s storage as LLVM declares it: its type's own, or -- where the value laid down holds a union
// -- the literal type of the image (`constant_image`).
private val_image(e: *Emit, v: TVal) -> IrArg
    if v.computed || !holds_union(v.ty) then return ir_arg(lty(e, v.ty), val_init(e, v))

    v.init match
        Some(x) -> constant_image(e, v.ty, x)
        None -> ir_arg(lty(e, v.ty), VZero)
end val_image

// **A constant holding a union is written in a literal type of its own.** LLVM's constant for an
// aggregate names a value for each element of its type, and a union's type has one element -- the
// field `union_type_def` chose -- which is not the one a constant was built with whenever another
// field was. So the image of a union is `{ [0 x %struct.U], <field>, [pad x i8] }`: the empty array
// gives it the union's own alignment, then the one field it was built with and zeros to the union's
// size. Everything holding one is written in literal types too, element for element as its own type
// would lay it out (a struct's gaps included), so every offset is the one the declared type has; an
// array of them is a literal struct, since its elements' images need not be one type.
constant_image(e: *Emit, ty: Type, t: TExpr) -> IrArg
    if !holds_union(ty) then return ir_arg(lty(e, ty), constant_value(e, t))

    *t.kind match
        TStructNew(decl, args) ->
            if decl.union_layout then return union_image(e, decl, args)

            var fields: Buf[IrArg] = buf()

            for i in 0..<args.len()
                val ft = decl.fields.at(i).1

                if !zero_sized(ft)
                    val part = constant_image(e, ft, args.at(i))
                    val bits = reversed_width(decl, ft, e.target.little_endian())

                    fields.push(ir_arg(part.ty, reversed_constant(part.value, bits, ft)))

            literal_image(gapped_values(fields, struct_gaps(e.layout, decl)), decl.packed)
        TArrayLit(items, array_ty) ->
            val ety = element(array_ty).unwrap_or(int_type())
            var parts: Buf[IrArg] = buf()

            for item in items
                parts.push(constant_image(e, ety, item))

            literal_image(parts, false)
        TArrayFill(value, array_ty) ->
            val ety = element(array_ty).unwrap_or(int_type())
            val part = constant_image(e, ety, value)
            val n = underlying(array_ty) match
                Array(len, _) -> len
                _ -> 0
            var parts: Buf[IrArg] = buf()

            for i in 0..<n
                parts.push(part)

            literal_image(parts, false)
        _ -> ir_arg(lty(e, ty), constant_value(e, t))
end constant_image

// The parts as one literal aggregate. A `@packed` type's is packed too: a literal struct rounds each
// part up to its own alignment, which would move every field after the first one that is not
// byte-aligned away from where the declared type has it.
private literal_image(parts: Buf[IrArg], packed: bool) -> IrArg
    var types: Buf[LType] = buf()

    for p in parts
        types.push(p.ty)

    if packed then ir_arg(LPackedStruct(types), VPackedAgg(parts)) else ir_arg(LStruct(types), VAgg(parts))
end literal_image

// A union built from constants: the one field it was built with, at its first byte, in the stated byte
// order where it has one, and zeros to its size.
private union_image(e: *Emit, decl: &StructType, args: Buf[TExpr]) -> IrArg
    var parts: Buf[IrArg] = buf()

    parts.push(ir_arg(LArr(0, struct_lty(decl)), VZero))

    var used: usize = 0

    for i in 0..<args.len()
        val ft = decl.fields.at(i).1

        *args.at(i).kind match
            TUnitLit -> ()
            _ ->
                if !zero_sized(ft)
                    val part = constant_image(e, ft, args.at(i))
                    val bits = reversed_width(decl, ft, e.target.little_endian())

                    parts.push(ir_arg(part.ty, reversed_constant(part.value, bits, ft)))
                    used = e.layout.size(ft)
                end if

    val total = e.layout.size(Struct(decl))

    if total > used then parts.push(ir_arg(LArr(int(total - used), LInt(8)), VZero))

    literal_image(parts, decl.packed)
end union_image

// The storage a program's `val`s come to.
//
// **Storage another object defines is declared, as a precompiled function is** (`precompiled`): a
// library's constant storage, laid down once in its own half (`library.sysl`'s `shared_storage`).
// That half defines it with external linkage (`TVal.shared`), so the program and every other half
// linked with it name one object -- one address, one value written.
gen_vals(e: *Emit, vals: Buf[TVal], precompiled: Buf[string]) -> Buf[IrGlobal]
    var out: Buf[IrGlobal] = buf()

    for i in 0..<vals.len()
        val v = vals.at(i)

        if holds_string(precompiled, v.symbol)
            val decl = ir_extern_global(v.symbol, lty(e, v.ty), binds_locally(e))

            out.push(decl with { constant = !v.writable })
            continue

        val image = val_image(e, v)

        // The binding's own `@align(n)`, or the boundary its type raises -- the greater of the two.
        val own: Option[int] = v.align match
            Some(n) -> Some(int(n))
            None -> None

        val align = wider_align(own, e.layout.storage_align(v.ty))

        // **Exported storage is a C data object**: laid down under its symbol with the linkage a
        // definition has by default, a `val` read-only and so in `.rodata`, a `var` with no value in
        // `.bss`, and a private one hidden as a private function's entry is. Everything else is the
        // module's own and stays private.
        val exported = v.exported.is_some()
        val name = v.exported.unwrap_or(symbol_of(e, v.symbol))
        val linkage = if exported || v.shared then LinkDefault else LinkPrivate

        // **A `@per_cpu` binding is the image every core's copy is made from**, so it goes in
        // `.percpu` -- data even where it is all zeros, a named section keeping it out of `.bss` --
        // and a linker script bounds that section for the program to copy.
        val section = if v.per_cpu then Some(per_cpu_section()) else v.section

        out.push(IrGlobal(name, !(v.computed || v.writable), image.ty, Some(image.value),
                          linkage, section, align, v.thread_local,
                          (exported || v.shared) && binds_locally(e),
                          v.export_hidden))

    out
end gen_vals

// The address of a place in module storage, as a constant: the global itself, then one
// `getelementptr` per step inside it -- a field by its LLVM index, an element by its number. The
// analysis handed every index over as a literal the array has.
private constant_address(e: *Emit, place: TExpr) -> Val = *place.kind match
    TGlobal(symbol, _, _) -> VGlobal(symbol_of(e, symbol))
    TField(receiver, index, ty) ->
        if zero_sized(ty) then return constant_address(e, receiver)

        val rty = texpr_type(receiver)

        var idx: Buf[IrArg] = buf()

        idx.push(ir_arg(l_i32(), VInt(from_int(0))))
        idx.push(ir_arg(l_i32(), VInt(from_int(long(field_index_of(e, rty, index))))))
        VGep(lty(e, rty), constant_address(e, receiver), idx)
    TIndex(receiver, index, _) ->
        val elem = nameless(texpr_type(receiver)) match
            Array(_, el) -> *el
            _ -> return gap_at(e, "a constant address inside something that is not an array")

        val at = *index.kind match
            TIntLit(n, _) -> n
            _ -> return gap_at(e, "a constant address at an index that is not a literal")

        var idx: Buf[IrArg] = buf()

        idx.push(ir_arg(word_lty(e), VInt(at)))
        VGep(lty(e, elem), constant_address(e, receiver), idx)
    // An array a run while compiling made and froze: laid down as read-only storage of its own, which
    // the frozen buffer's pointer to its first element names.
    TArrayLit(_, array_ty) ->
        e.table_id += 1

        val name = s".frozen${e.table_id}"
        val elem = nameless(array_ty) match
            Array(_, el) -> *el
            _ -> int_type()

        e.globals.push(IrGlobal(name, true, lty(e, array_ty), Some(constant_value(e, place)), LinkPrivate,
                                None, e.layout.storage_align(elem), false, false, false))
        VGlobal(name)
    _ -> gap_at(e, "a constant address of something that is not module storage")

// The section every `@per_cpu` binding's image is laid down in.
per_cpu_section() -> string = ".percpu"

// The greater of two boundaries either of which may be unstated.
wider_align(a: Option[int], b: Option[int]) -> Option[int] = b match
    Some(y) ->
        a match
            Some(x) -> if x >= y then Some(x) else Some(y)
            None -> Some(y)
    None -> a

// `@llvm.used` -- the symbols this module places by hand and nothing in it reads. It is what keeps
// the feature from compiling, linking and placing nothing: a table gathered by a linker script has
// no reader inside the program.
gen_used(names: Buf[string]) -> Option[IrGlobal]
    if names.is_empty() then return None

    var elems: Buf[IrArg] = buf()

    for item in names
        elems.push(ir_arg(LPtr, VGlobal(item)))

    Some(IrGlobal(llvm_used(), false, LArr(int(names.len()), LPtr), Some(VArray(elems)),
                  LinkAppending, Some(llvm_metadata_section()), None, false, false, false))
end gen_used

// A constant integer with its bytes reversed at `bits`, for a field of a `@byte_order` struct laid
// down as data -- the image holds the bytes the format does, exactly as a store at run time would
// have left them. A zero reversed is zero.
private reversed_constant(v: Val, bits: int, ty: Type) -> Val
    if bits == 0 then return v

    val signed = underlying(ty) match
        Integer(_, s, _) -> s
        Fixed(_, _, s) -> s
        Enum(d) -> underlying(d.underlying) match
            Integer(_, s, _) -> s
            _ -> false
        _ -> false

    v match
        VInt(n) -> VInt(swapped_bytes(n, bits, signed))
        _ -> v
end reversed_constant

// A bitfield struct built from constants, as data: its container is one integer, so the image is
// that integer -- each field's value cut to its width and shifted to its range -- in the struct's
// one-member aggregate, and reversed where the struct states a byte order the machine does not have.
// A field's constant is an integer, a simple enum's tag, or a bitfield struct's own image.
private bitfield_constant(e: *Emit, decl: &StructType, ranges: Buf[BitRange], args: Buf[TExpr]) -> Val
    val bits = bitfield_bits(ranges)
    var acc = from_int(0)
    var k: usize = 0

    for i in 0..<args.len()
        if !zero_sized(decl.fields.at(i).1)
            val r = ranges.at(k)
            val n = constant_bits(constant_value(e, args.at(i))) match
                Some(found) -> found
                None -> return gap_at(e, "a constant bitfield struct whose field is not an integer")

            acc = acc | (wrap(n, r.width, false) << usize(r.offset))
            k += 1
        end if

    val reversal = container_reversal(decl, e.target.little_endian())
    val stored = if reversal > 0 then swapped_bytes(acc, reversal, false) else acc
    var parts: Buf[IrArg] = buf()

    parts.push(ir_arg(LInt(bits), VInt(stored)))
    VPackedAgg(parts)
end bitfield_constant

// The integer a field's constant stands for inside a bitfield struct's container.
private constant_bits(v: Val) -> Option[BigInt] = v match
    VInt(n) -> Some(n)
    VZero -> Some(from_int(0))
    VPackedAgg(parts) -> if parts.len() == 1 then constant_bits(parts.at(0).value) else None
    _ -> None

// Whether a constant's type is an address: a pointer or a function pointer.
private is_word_address(t: Type) -> bool = underlying(t) match
    Ptr(_) -> true
    CFn(_, _) -> true
    _ -> false

// A `val`'s initializer as a **constant expression**.
constant_value(e: *Emit, t: TExpr) -> Val = *t.kind match
    TIntLit(v, _) -> VInt(v)

    // A module-level `bool` is written as its bit rather than as `true`, which is what LLVM's own
    // constant grammar takes -- the word is the *instruction* operand's spelling.
    TBoolLit(b) -> VInt(from_int(if b then 1 else 0))
    TFloatLit(bits, ty) -> if ty == real_type() then VFloat(bits) else v_float32(real_of_bits(bits))
    TQuadLit(hi, lo, _) -> VQuad(hi, lo)

    // Three words naming bytes that are never freed. The owner is null, which is what makes the whole
    // value a constant expression rather than something a prologue has to build.
    TStrLit(s) -> string_const(e, s)

    // The address of the literal's bytes in read-only data: a relocation, so constant data.
    TCStrLit(s) -> string_global(e, s)

    // The same three words over the file's bytes.
    TEmbed(file, bytes, align) -> embed_const(e, file, bytes, align)

    // **`[0; N]` is one word, not N of them.** `zeroinitializer` is what LLVM takes for an aggregate
    // whose every bit is zero, and writing the elements out instead costs the whole array in the
    // module's text for an output that never grows.
    TArrayFill(value, array_ty) ->
        val elem = constant_value(e, value)

        if is_zero_const(elem) then VZero
        else
            val n = underlying(array_ty) match
                Array(len, _) -> len
                _ -> 0

            val ety = underlying(array_ty) match
                Array(_, el) -> *el
                _ -> int_type()

            var elems: Buf[IrArg] = buf()

            for i in 0..<n
                elems.push(ir_arg(lty(e, ety), elem))

            VArray(elems)

    TArrayLit(items, array_ty) ->
        val ety = underlying(array_ty) match
            Array(_, el) -> *el
            _ -> int_type()

        var elems: Buf[IrArg] = buf()

        for item in items
            elems.push(ir_arg(lty(e, ety), constant_value(e, item)))

        VArray(elems)

    // A vector computed while compiling, laid down as its lanes.
    TVectorLit(lanes, vec_ty) ->
        val lane_ty = underlying(vec_ty) match
            Vector(_, el) -> *el
            _ -> int_type()

        var out: Buf[IrArg] = buf()

        for lane in lanes
            out.push(ir_arg(lty(e, lane_ty), constant_value(e, lane)))

        VVector(out)

    // A slice over literals: its elements laid down as an array of their own, and the view over them
    // with no owner -- the three words a string literal is, so nothing ever counts it.
    TBufLit(items, slice_ty) -> view_const(e, items, slice_ty)

    // A box a run while compiling made: header and payload laid down whole, in **writable** data,
    // since a reference names the header and taking a share writes the count there. The count starts
    // at one -- the storage's own share, which is never given back -- so nothing frees the box, and
    // the hook is null, so nothing destroys it either.
    TBox(value, _) -> box_const(e, value)

    // A struct constant lists its fields in the order the type declares them, and skips the ones that
    // occupy nothing -- the initializer has to match the type this module emitted.
    TStructNew(decl, args) ->
        // A struct with C bitfields is its runs of bitfields as the bytes their values make, and its
        // other fields as themselves (`emit_c_bits.sysl`).
        if !decl.c_bits.is_empty() then return c_bits_constant(e, decl, args)

        // A bitfield struct is the one integer its fields are ranges of.
        val ranges = bitfield_ranges(decl)

        if ranges.is_some() then return bitfield_constant(e, decl, ranges.unwrap(), args)

        var fields: Buf[IrArg] = buf()

        for i in 0..<args.len()
            val ft = decl.fields.at(i).1

            if !zero_sized(ft)
                val bits = reversed_width(decl, ft, e.target.little_endian())

                fields.push(ir_arg(lty(e, ft), reversed_constant(constant_value(e, args.at(i)), bits, ft)))

        // A raised boundary's gaps are fields of the definition, so they are zeros here. A `@packed`
        // struct's type is LLVM's `<{ }>`, and a constant of it has to be written in the same brackets.
        val laid = gapped_values(fields, struct_gaps(e.layout, decl))

        if decl.packed then VPackedAgg(laid) else VAgg(laid)

    // A device address written as a number: `inttoptr` is a constant expression, so the pointer is in
    // the object file rather than stored into it by a prologue.
    //
    // **An address read as an integer** is the other way round, `ptrtoint`, and a relocation as the
    // address is. The integer is the machine's word (`analyze_body.sysl`'s `word_image`), so a
    // conversion of one integer word to another is the same bits and writes nothing of its own.
    TCast(v, to) -> underlying(to) match
        Integer(_, _, _) ->
            if is_word_address(texpr_type(v)) then VPtrToInt(lty(e, to), constant_value(e, v))
            else constant_value(e, v)
        _ -> VIntToPtr(lty_of(e, v), constant_value(e, v))

    // An address moved by a constant: a relocation with an addend, LLVM's constant `add` or `sub`
    // (`analyze_body.sysl`'s `offset_image`).
    TBinary(op, l, r, ty) ->
        val word = if op == "+" || op == "+%" then "add" else "sub"

        VConstArith(word, lty(e, ty), constant_value(e, l), constant_value(e, r))

    // The address of module storage, or of a place inside it: a relocation the linker fills in,
    // written as a constant `getelementptr` over the global (`analyze_body.sysl`'s `place_image`).
    TAddrOf(place, _) -> constant_address(e, place)

    // A function's address: its C-callable entry, as `&f` anywhere else names it (`emit_expr.sysl`).
    TFuncAddr(_, entry, _) -> VGlobal(caller_entry(e, entry))

    // A trait object over such an address: the table's address and the object's, the two words
    // `gen_erase` builds -- both relocations, so nothing runs to pair them.
    TErase(operand, vtable, _) ->
        var words: Buf[IrArg] = buf()

        words.push(ir_arg(LPtr, VGlobal(vtable)))
        words.push(ir_arg(LPtr, constant_value(e, operand)))
        VAgg(words)

    // A trait pointer is two words, so its empty value is not the one-word `null`.
    TNullLit(ty) -> if erased(underlying(ty)) then VZero else VNull

    // A variant that carries nothing is a tag and a payload region nothing will read -- except in a
    // simple enum, which is its underlying integer and nothing else, so its constant is the bare tag
    // at that width: the value the program wrote, not a `{ tag, region }` pair.
    // A variant that carries fields has its payload written as the region's units, its fields' bytes
    // where a construction stores them (`payload_image.sysl`).
    TEnumNew(en, variant, args) ->
        if !variant.carries && variant.tag.is_zero() then VZero
        else
            val d = underlying(en) match
                Enum(decl) -> decl
                _ -> return gap_at(e, "a constant enum of something that is not an enum")

            if d.simple then return VInt(variant.tag)

            val area = payload_area(d, e.layout)

            var payload = VZero

            if variant.carries
                val units = payload_units(e.layout, d, variant, args) match
                    Some(found) -> found
                    None -> return gap_at(e, "a constant enum variant whose payload has no byte image")

                var cells: Buf[IrArg] = buf()

                for u in units
                    val cell = u match
                        UnitBits(n) -> VInt(n)
                        UnitAddr(place) -> VPtrToInt(area.0, constant_address(e, place))
                        UnitTable(symbol) -> VPtrToInt(area.0, VGlobal(symbol))
                        UnitFn(entry) -> VPtrToInt(area.0, VGlobal(entry_of(e, entry)))
                        UnitBox(value) -> VPtrToInt(area.0, box_const(e, value))

                    cells.push(ir_arg(area.0, cell))

                payload = VArray(cells)
            end if

            var fields: Buf[IrArg] = buf()

            fields.push(ir_arg(l_i32(), VInt(variant.tag)))
            fields.push(ir_arg(LArr(area.1, area.0), payload))
            VAgg(gapped_values(fields, enum_gaps(e.layout, d)))

    _ -> gap_at(e, s"a constant ${texpr_kind_name(t)}")

// **A large array literal of constants is DATA, copied into place with one `memcpy`.** Built element
// by element it is two stores per string and a store per scalar, all in one function, and LLVM's
// passes over a body that size are worse than linear: a 4,000-row table of string pairs took ten
// seconds of `-O1` for a program whose own code is a dozen lines. Laid down as a private constant,
// the same table is one initializer the object file carries and one call -- which is what clang does
// for a `const` aggregate initializer in C. A short literal keeps the stores, which the optimizer
// folds into whatever reads them.
const table_elements: usize = 64

// Whether an array literal is built by copying a constant table: long enough for the stores to
// cost, and every element something `constant_value` lays down exactly as the stores would write it.
is_constant_table(elems: Buf[TExpr]) -> bool = elems.len() >= table_elements && all_constant(elems)

// The constant table an array literal is copied out of, laid down at the alignment its type wants
// so the copy may claim it at both ends.
constant_table(e: *Emit, t: TExpr, ty: Type) -> Val
    e.table_id += 1

    val name = s".table${e.table_id}"
    val image = constant_value(e, t)

    e.globals.push(IrGlobal(name, true, lty(e, ty), Some(image), LinkPrivate, None,
                            Some(int(e.layout.align(ty))), false, false, false))
    VGlobal(name)
end constant_table

// Whether `constant_value` writes this value as the bytes the element-by-element lowering would
// store. Deliberately narrow: an integer, a `bool`, a `real` or `f32`, a string, a null, and arrays
// and plain structs of those. A bitfield struct packs its fields into one container and an enum
// has a representation of its own, so neither is claimed.
private is_constant_image(t: TExpr) -> bool = *t.kind match
    TIntLit(_, ty) ->
        underlying(ty) match
            Integer(_, _, _) -> true
            _ -> false
    TBoolLit(_) -> true
    TFloatLit(_, ty) -> ty == real_type() || ty == Floating(32, false)
    TQuadLit(_, _, _) -> true
    TStrLit(_) -> true
    TCStrLit(s) -> !is_caller_text(s)
    TEmbed(_, _, _) -> true
    TNullLit(_) -> true
    TArrayLit(items, _) -> all_constant(items)
    TStructNew(decl, args) -> !decl.union_layout && bitfield_ranges_of(Struct(decl)).is_none() &&
        decl.c_bits.is_empty() && all_constant(args)
    _ -> false

private all_constant(items: Buf[TExpr]) -> bool
    for item in items
        if !is_constant_image(item) then return false

    true
end all_constant

// A box laid down whole, as `TBox`'s arm says.
private box_const(e: *Emit, value: TExpr) -> Val
    val payload = texpr_type(value)
    val bn = box_lty(e, payload)
    var fields: Buf[IrArg] = buf()

    fields.push(ir_arg(word_lty(e), VInt(from_int(1))))
    fields.push(ir_arg(LPtr, VNull))
    fields.push(ir_arg(word_lty(e), VInt(from_int(1))))

    val pad = box_pad(e, payload)

    if pad > 0 then fields.push(ir_arg(LArr(int(pad), LInt(8)), VZero))

    fields.push(ir_arg(lty(e, payload), constant_value(e, value)))

    e.table_id += 1

    val name = s".box${e.table_id}"

    e.globals.push(IrGlobal(name, false, bn, Some(VAgg(fields)), LinkPrivate, None, None, false, false, false))
    VGlobal(name)
end box_const

// A string as a value: the owner nothing frees, the bytes, and how many there are.
string_const(e: *Emit, s: string) -> Val
    var fields: Buf[IrArg] = buf()

    fields.push(ir_arg(LPtr, VNull))
    fields.push(ir_arg(LPtr, string_global(e, s)))
    fields.push(ir_arg(word_lty(e), VInt(from_int(long(s.bytes.len)))))
    VAgg(fields)
end string_const

// **A `[]const T` literal whose every element is constant data is that data**, wherever it is
// written: nothing can write through the view, so one read-only array serves every evaluation, and
// the view over it owns nothing, as a string literal's does. `T::Fields` is one.
read_only_literal(elems: Buf[TExpr], slice_ty: Type) -> bool
    if elems.is_empty() then return false

    val read_only = underlying(slice_ty) match
        Slice(_, ro) -> ro
        _ -> false

    read_only && all_laid_down(elems)
end read_only_literal

// The same literal as the value a body reads: the view over its laid-down array.
static_view(e: *Emit, items: Buf[TExpr], slice_ty: Type) -> Val = view_const(e, items, slice_ty)

// A slice literal as a value: the owner nothing frees, its elements, and how many there are. **The
// elements are read-only data only where the view is**: a `[]T` is written through wherever it is
// held, a `val` included, so its array goes in writable data -- still never counted and never freed.
private view_const(e: *Emit, items: Buf[TExpr], slice_ty: Type) -> Val
    if items.is_empty() then return VZero

    val ety = element(slice_ty).unwrap_or(int_type())
    val read_only = underlying(slice_ty) match
        Slice(_, ro) -> ro
        _ -> false

    var elems: Buf[IrArg] = buf()

    for item in items
        elems.push(ir_arg(lty(e, ety), constant_value(e, item)))

    e.table_id += 1

    val name = s".view${e.table_id}"

    e.globals.push(IrGlobal(name, read_only, LArr(int(items.len()), lty(e, ety)), Some(VArray(elems)),
                            LinkPrivate, None, e.layout.storage_align(ety), false, false, false))

    var fields: Buf[IrArg] = buf()

    fields.push(ir_arg(LPtr, VNull))
    fields.push(ir_arg(LPtr, VGlobal(name)))
    fields.push(ir_arg(word_lty(e), VInt(from_int(long(items.len())))))
    VAgg(fields)
end view_const

// An embedded file as a value: the owner nothing frees, its bytes, and how many there are.
//
// **The bytes are laid down once per file and boundary**, however many places name them -- a generic
// instantiated three times, or two functions embedding one image, would otherwise carry the image
// three times. The global's name is made from the path, so a second use finds the first.
embed_const(e: *Emit, file: string, bytes: []u8, align: int) -> Val
    val name = s".embed.${bytes_fingerprint(file.bytes)}.$align"

    if !has_global(e, name)
        var data: Buf[u8] = buf()

        for b in bytes do data.push(b)

        // An empty file is an array of nothing, which LLVM takes as zeros rather than as `c""`.
        val image = if data.is_empty() then VZero else VBytes(data)

        e.globals.push(IrGlobal(name, true, LArr(int(data.len()), LInt(8)), Some(image), LinkPrivate,
                                None, Some(align), false, false, false))

    var fields: Buf[IrArg] = buf()

    fields.push(ir_arg(LPtr, VNull))
    fields.push(ir_arg(LPtr, VGlobal(name)))
    fields.push(ir_arg(word_lty(e), VInt(from_int(long(bytes.len)))))
    VAgg(fields)
end embed_const

private has_global(e: *Emit, name: string) -> bool
    for g in e.globals
        if g.name == name then return true

    false
end has_global

// Whether a constant is every bit zero, which is the one thing `zeroinitializer` may stand for. A
// float is zero at bit pattern zero alone, so `-0.0` -- whose sign bit is set -- is correctly not
// one.
is_zero_const(v: Val) -> bool = v match
    VInt(n) -> n == from_int(0)
    VBool(b) -> !b
    VFloat(bits) -> bits == 0
    VQuad(hi, lo) -> hi == 0 && lo == 0
    VNull -> true
    VZero -> true
    VAgg(fields) -> all_zero(fields)
    VPackedAgg(fields) -> all_zero(fields)
    VArray(elems) -> all_zero(elems)
    VVector(lanes) -> all_zero(lanes)
    _ -> false

private all_zero(items: Buf[IrArg]) -> bool
    for item in items
        if !is_zero_const(item.value) then return false

    true
end all_zero
