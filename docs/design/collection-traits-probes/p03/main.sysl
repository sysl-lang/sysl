// p03: collect generic over its target -- the result type alone picks the implementation.
import sysl.buf.{Buf, buf}
import sysl.container.{List, list}

trait It
    type Item
    next(*self) -> Option[Self::Item]

    collect[C: FromIt[Self::Item]](self) -> C = C.from_it(self)

trait FromIt[E]
    from_it[I: It[Item = E]](it: I) -> Self

impl[E] FromIt[E] for Buf[E]
    from_it[I: It[Item = E]](it: I) -> Buf[E]
        var out: Buf[E] = buf()
        var cur = it
        loop
            cur.next() match
                Some(x) -> out.push(x)
                None -> break
        out
    end from_it

impl[E] FromIt[E] for List[E]
    from_it[I: It[Item = E]](it: I) -> List[E]
        var out: List[E] = list()
        var cur = it
        loop
            cur.next() match
                Some(x) -> out = out.prepend(x)
                None -> break
        out.reverse()
    end from_it

struct Count
    n: int
    stop: int

impl It for Count
    type Item = int
    next(*self) -> Option[int]
        if self.n >= self.stop then return None
        val v = self.n
        self.n += 1
        Some(v)

main()
    val b: Buf[int] = Count(0, 4).collect()
    val l: List[int] = Count(5, 8).collect()
    print(b.len(), b[3], l.len(), l.first().unwrap())
    print(Count(0, 3).collect[Buf[int]]().len())
