module sysl

/** What a value mixes down to when something needs to key on it (`library/core.md § Hashing`).
 *
 * A `u64` rather than a `usize`, so a hash means the same thing on every target and a table moved
 * between two of them does not resize because the word did.
 */
trait Hash
    hash(self) -> u64

    /** What `derives Hash` writes: the fields mixed in order with FNV's prime, seeded from the offset
     * basis -- the tuple's fold, so a struct and the tuple of its fields hash alike. An enum mixes
     * its variant's position first, so two variants carrying equal payloads are different keys, and
     * then the payload's fields. A struct holding an anonymous `struct` or `union` block is refused
     * at its `derives`: the block has no `Hash`.
     */
    derive[T] hash(self: T) -> u64
        var h = 0xcbf29ce484222325u64

        if const T::Kind == Kind.SimpleEnum
            for const c in T::Variants
                if self is c then h = h *% 0x100000001b3u64 ^ hash_u64(u64(c.index))
        elif const T::Kind == Kind.DataEnum
            for const c in T::Variants
                if self is c
                    h = h *% 0x100000001b3u64 ^ hash_u64(u64(c.index))

                    val p = self.(c)

                    for const f in c::Fields
                        h = h *% 0x100000001b3u64 ^ p.(f).hash()
                end if
        else
            // An anonymous `struct` or `union` block is no field, so `T::Fields` would pass over it
            // and two values differing only inside it would hash alike.
            for const m in T::Members
                @assert(!m.anonymous || m::Type::Kind == Kind.Struct,
                        s"'${T::Name}' cannot derive Hash: it holds an anonymous union block, which has " +
                        s"no Hash — hashing its bytes is wrong for a float and for the bytes past a short " +
                        s"field. Write 'impl Hash for ${T::Name}' hashing the field you know is there")
                @assert(!m.anonymous || m::Type::Kind == Kind.Union,
                        s"'${T::Name}' cannot derive Hash: it holds an anonymous struct block, which has " +
                        s"no Hash — write 'impl Hash for ${T::Name}'")

            for const f in T::Fields
                h = h *% 0x100000001b3u64 ^ self.(f).hash()

        hash_u64(h)
    end hash

/** The mixers a built-in's `Hash` membership renders through. A built-in has no `impl` block, so
 * there is no lowered `int.hash` to call; what it has is one of these, chosen by type, and naming
 * them is what lets a `Hash` written for a struct mix its own fields.
 *
 * This is splitmix64's finalizer: it is the one that turns a counter into something a table can
 * bucket on, since consecutive integers are the input a hash table actually meets and the identity
 * hash is what makes them collide in a row.
 */
hash_u64(v: u64) -> u64
    var h = v +% 0x9e3779b97f4a7c15u64
    h = (h ^ (h >> 30u64)) *% 0xbf58476d1ce4e5b9u64
    h = (h ^ (h >> 27u64)) *% 0x94d049bb133111ebu64
    h ^ (h >> 31)

/** Past 64 bits the two halves are mixed separately and combined, because the finalizer above is
 * defined on a word and a wider integer has no single one.
 */
hash_u128(v: u128) -> u64 = hash_u64(u64(v & 0xffffffffffffffff)) *% 0x100000001b3u64 ^ hash_u64(u64(v >> 64))

/** A `bool` is one bit, and one bit does not widen to a number in this language -- the same reason
 * `display_bool` exists rather than a widening into the integer renderer.
 */
hash_bool(b: bool) -> u64 = hash_u64(if b then 1 else 0)

/** FNV-1a over the bytes, which is what a string is: a validated `[]u8`, so there is nothing to
 * decode and every byte counts once.
 */
hash_str(s: string) -> u64
    var h = 0xcbf29ce484222325u64
    for b in s.bytes
        h = (h ^ u64(b)) *% 0x100000001b3u64
    h

// The built-ins that hash, written as blocks rather than provided by rule.
//
// **What a written `impl` buys is a function**, and a method table has to point at one. A
// membership the compiler hands out has no body to point at -- what it has is an instruction or a
// call it splices in -- so a value holding one could satisfy a bound and still not be erasable to a
// `&Hash`. These blocks are what make `[3]&Hash` a thing a program can write, and they are the same
// move `Display` made for the same reason (`reference/expressions.md § Operator dispatch`).
//
// The **floats are absent and that is the law talking**: `NaN != NaN` breaks the reflexivity a
// lookup assumes, and `-0.0 == 0.0` holds across two bit patterns, so a hash over the bits would
// contradict the equality. A program keying on a float writes the normalization it means.

impl Hash for bool
    hash(self) -> u64 = hash_bool(self)

impl Hash for char
    hash(self) -> u64 = hash_u64(u64(u32(self)))

impl Hash for string
    hash(self) -> u64 = hash_str(self)

/** The integers, which are the family that is **open** -- `i5` and `u24` are types a program may
 * name, so no finite list of blocks could cover them. One block over the whole family says it
 * instead, exactly as `Display`'s does.
 *
 * **The widening is the law, not an implementation detail.** Two integer types compare equal across
 * widths, so they have to hash equal too: `1` and `1` are the same number and reach the same
 * mixer having become the same `u64`. Past 64 bits the value is mixed in two halves rather than
 * truncated, because a 128-bit identifier is the reason to have the width at all and dropping its
 * top half would bucket every one of them together.
 */
impl[T: Integer] Hash for T
    hash(self) -> u64 = if sizeof(T) > 8 then hash_u128(u128.wrap(self)) else hash_u64(u64.wrap(self))

/** A reference keyed by the object it names rather than by its value. A `&T` compares and
 * hashes as its referent does wherever `T` defines `Eq` and `Hash` (`reference/memory.md §
 * References compare through their referent`), which is what a table of values wants and not what a
 * table of *objects* does -- a visited set over a graph, a cache per node. Wrapping the reference
 * keys by its identity instead: two of these are equal exactly when they hold one object, whatever
 * `T` says, and they hash by the address, so the two always agree.
 *
 * ```
 * var seen: Set[ByAddress[Node]] = set()
 * seen.add(ByAddress(node))
 * ```
 */
struct ByAddress[T]
    /** The reference keyed by its identity. */
    target: &T

impl[T] Eq for ByAddress[T]
    eq(self, rhs: ByAddress[T]) -> bool = self.target === rhs.target

impl[T] Hash for ByAddress[T]
    hash(self) -> u64 = hash_u64(u64(usize(&*self.target)))
