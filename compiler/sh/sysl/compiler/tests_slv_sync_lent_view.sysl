module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.text.{cstring, str_builder}
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture

// **A view of storage inside a `&sync` box is lent** (`escape.sysl`'s `sync_view`): it counts nothing of
// the box -- its owner word is null (`emit_place.sysl`'s `address_owned`) -- because a count taken
// through a view is the ordinary one, while another domain changes the box's count atomically. So it
// may be handed to a call that borrows it or held in a local of the body, and is refused wherever it
// would get out: returned, stored somewhere the frame does not own (a module var, a field of a struct
// the body returns or was handed), captured by a closure that is kept, or handed to a callee that
// holds on to it. What keeps the box alive meanwhile is the binding it was reached through, so that
// must be one the body does not rebind: a parameter or local it never stores into nor hands out the
// address of, or a module `val` -- not a module `var`, nor a field of another box.
//
// The axes: the storage (a field, a field of a field, a `&sync [N]T` itself, through a `ref`, a module
// `val` box); the form (a range, the whole, an array converted where a view is wanted, a view of the
// view); lent to a call, held in a local, both in a loop; generic and non-generic, a generic body
// instantiated at two element types; each route out; each binding that does not keep the box. Every
// runnable cell runs at -O0 and -O2 on the counted heap and once under AddressSanitizer.
//
// Cells not written: an `async` callee -- a task holding an argument is the route `is passed to …,
// which holds on to it` already refuses for every view; separate compilation -- the rule is the caller
// body's; bare metal -- no runtime call is added, only a count of nothing removed.

private extern "setenv" slv_c_setenv(name: *u8, value: *u8, overwrite: int) -> int
private extern "unsetenv" slv_c_unsetenv(name: *u8) -> int

private struct SlvRun
    ok: bool
    out: string
    err: string
    hooks: usize

private slv_ready() -> bool
    if std_root().is_err() || !clang_available()
        print("skipped: the library or the toolchain is not on this machine")
        return false
    end if

    true
end slv_ready

private slv_ir(text: string) -> string
    val root = make_temp_dir("sysl-slv").unwrap()
    val src = s"$root/main.sysl"

    make_dir_all(root).unwrap()
    write_text(src, text).unwrap()

    val out = emit_llvm_text(src, None) match
        Err(why) -> failure_text(why)
        Ok(made) -> if made.report.is_empty() then made.text else analysis_report(made.report)

    remove_dir_all(root).unwrap_or(())
    out
end slv_ir

// One function's emitted text, from its `define` to the brace that closes it.
private slv_body(out: string, name: string) -> string
    var b = str_builder()
    var inside = false

    for line in lines_of(out)
        if !inside && line.starts_with("define ") && line.contains("@" + name + "$") then inside = true

        if inside
            if line == "}" then return b.finish()

            b.push(line)
            b.push_char('\n')

    if inside then b.finish() else s"no definition of '$name' in:\n$out"
end slv_body

private slv_refused(text: string, said: string, at: string)
    if !slv_ready() then return

    val out = slv_ir(text)

    assert(out.contains(said), out)
    assert(out.contains(at), out)
end slv_refused

private slv_run(text: string, level: string, counted: bool, flags: string) -> SlvRun
    val root = make_temp_dir("sysl-slv").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", text).unwrap()

    val exe = s"$root/built"

    if counted then force_alloc_counting(true)

    if flags != ""
        val n = cstring("SYSL_EXTRA_CFLAGS")
        val v = cstring(flags)

        slv_c_setenv(n.ptr, v.ptr, 1)
    end if

    val built = build_native_program(s"$root/main.sysl", None, None, level, Some(exe))

    if flags != ""
        val n = cstring("SYSL_EXTRA_CFLAGS")

        slv_c_unsetenv(n.ptr)

    if counted then force_alloc_counting(false)

    built match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return SlvRun(false, failure_text(why), "", 0)
        Ok(_) -> ()

    val hooks = capture("nm", ["-u", exe], "", [], true) match
        Ok(o) -> o.text.count_of("__asan_report")
        Err(_) -> 0

    val said = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    said match
        Err(_) -> SlvRun(false, "could not be started", "", hooks)
        Ok(o) -> SlvRun(o.status.ok(), o.text, o.err.unwrap_or(""), hooks)
end slv_run

// Printed exactly `expected` at both ends of the optimizer on the counted heap, giving everything
// back, and again under AddressSanitizer with the instrumentation in the binary.
private slv_prints(text: string, expected: string)
    if !slv_ready() then return

    for level in ["0", "2"]
        val run = slv_run(text, level, true, "")

        assert(run.ok, s"-O$level: ${run.out}${run.err}")
        assert_eq(run.out, expected)
        assert(alloc_count_reported(run.err) == 0, s"-O$level: ${run.err}")

    val asan = slv_run(text, "0", false, "-fsanitize=address -g")

    assert(asan.hooks > 0, "the AddressSanitizer build carries no instrumentation")
    assert(asan.ok, s"asan: ${asan.out}${asan.err}")
    assert_eq(asan.out, expected)
end slv_prints

// -- lent: accepted --------------------------------------------------------------------------------

private slv_lent() -> string = raw"""
    struct Inner
        a: [4]i32

    struct Flash
        data: [8]i32
        inner: Inner

    sum(xs: []const i32) -> i32
        var t = 0
        for x in xs
            t += x
        t

    first[T](xs: []const T) -> T = xs[0]

    peek[T](b: &sync [4]T) -> T = first(b[1..])

    lent(f: &sync Flash) -> i32 = sum(f.data[1..<3]) + sum(f.data) + sum(f.inner.a[..])

    held(f: &sync Flash) -> i32
        val s = f.data[2..]
        var t = 0
        for k in 0..<3
            t += sum(s[k..<k + 1]) + sum(f.data[k..<k + 2])
        t

    through_ref(f: &sync Flash) -> i32
        ref q = f.data
        sum(q[4..])

    val g: &sync Flash = Flash([1, 2, 3, 4, 5, 6, 7, 8], Inner([1, 2, 3, 4]))

    module_val() -> i32 = sum(g.data[..<4])

    main()
        val f: &sync Flash = Flash([1, 2, 3, 4, 5, 6, 7, 8], Inner([10, 20, 30, 40]))
        val b: &sync [4]i32 = [1, 2, 3, 4]
        val w: &sync [4]i64 = [5, 6, 7, 8]
        print(lent(f), held(f), through_ref(f), module_val(), peek(b), peek(w), sum(b))
    """

@test("a lent view of &sync storage is accepted: a field, a nested field, a whole &sync array, a ref")
slv_lent_views_run()
    slv_prints(slv_lent(), "141 27 26 10 2 6 10\n")

@test("a lent view of &sync storage counts nothing of the box")
slv_lent_view_counts_nothing()
    if !slv_ready() then return

    val out = slv_ir(slv_lent())

    for name in ["lent", "held", "through_ref", "module_val"]
        val f = slv_body(out, name)

        assert(f.starts_with("define"), f)
        assert(!f.contains("@arc.retain_maybe(ptr %") && !f.contains("@arc.retain_sync("), f)

// -- getting out: refused --------------------------------------------------------------------------

private slv_flash() -> string = raw"""
    import sysl.buf.{Buf, buf}

    struct Flash
        data: [8]i32

    """

private slv_out(how: string) -> string =
    s"a view of storage inside a '&sync Flash' $how, but such a view takes no count of the box — a " +
    "count update through it would not be atomic — so it may only be lent: handed to a call that " +
    "borrows it, or held in a local of this body. Copy the elements into an array of their own to keep them"

@test("a view of &sync storage that is returned is refused")
slv_refused_returned()
    slv_refused(slv_flash() + raw"""
        ret(f: &sync Flash) -> []const i32 = f.data[1..<3]

        main()
            val f: &sync Flash = Flash([1, 2, 3, 4, 5, 6, 7, 8])
            print(ret(f).len)
        """, slv_out("is returned"), "main.sysl:6:")

@test("a view of &sync storage stored in a module var or a handed struct's field is refused")
slv_refused_stored()
    slv_refused(slv_flash() + raw"""
        var kept: []const i32 = []

        keep(f: &sync Flash)
            kept = f.data[..]

        main()
            val f: &sync Flash = Flash([1, 2, 3, 4, 5, 6, 7, 8])
            keep(f)
            print(kept.len)
        """, slv_out("is stored somewhere the frame does not own"), "main.sysl:9:")
    slv_refused(slv_flash() + raw"""
        struct Holder
            v: []const i32

        put(f: &sync Flash, h: &Holder)
            h.v = f.data[..]

        main()
            val f: &sync Flash = Flash([1, 2, 3, 4, 5, 6, 7, 8])
            val h = Holder([])
            put(f, h)
            print(h.v.len)
        """, slv_out("is stored somewhere the frame does not own"), "main.sysl:10:")

@test("a view of &sync storage in a field of a struct the body returns is refused")
slv_refused_in_a_returned_field()
    slv_refused(slv_flash() + raw"""
        struct Holder
            v: []const i32

        wrap(f: &sync Flash) -> Holder = Holder(f.data[..])

        main()
            val f: &sync Flash = Flash([1, 2, 3, 4, 5, 6, 7, 8])
            print(wrap(f).v.len)
        """, slv_out("is returned"), "main.sysl:9:")

@test("a view of &sync storage captured by a closure that is kept is refused")
slv_refused_captured()
    slv_refused(slv_flash() + raw"""
        make(f: &sync Flash) -> &Fn() -> i32
            val v = f.data[1..]
            () -> v[0]

        main()
            val f: &sync Flash = Flash([1, 2, 3, 4, 5, 6, 7, 8])
            print(make(f)())
        """, slv_out("is put on the heap"), "main.sysl:8:")

@test("a view of &sync storage handed to a callee that holds on to it is refused")
slv_refused_held_by_the_callee()
    slv_refused(slv_flash() + raw"""
        fill(f: &sync Flash, into: Buf[[]const i32])
            into.push(f.data[2..<4])

        main()
            val f: &sync Flash = Flash([1, 2, 3, 4, 5, 6, 7, 8])
            var views: Buf[[]const i32] = buf()
            fill(f, views)
            print(views.len())
        """, "which holds on to it, but such a view takes no count of the box", "main.sysl:7:")

@test("a generic body returning a view of a &sync array is refused at each instantiation's site")
slv_refused_generic()
    slv_refused(raw"""
        whole[T](b: &sync [4]T) -> []const T = b[..]

        main()
            val b: &sync [4]i32 = [1, 2, 3, 4]
            print(whole(b).len)
        """, "is returned, but such a view takes no count of the box", "main.sysl:1:")

// -- the binding the box is reached through ----------------------------------------------------------

private slv_root() -> string =
    "takes no count of the box — a count update through it would not be atomic — so the box must be " +
    "held for as long as the view lives by what it was reached through"

@test("a view through a module var, a field of another box, a rebound local or one whose address is taken")
slv_refused_unstable_roots()
    slv_refused(slv_flash() + raw"""
        sum(xs: []const i32) -> i32 = xs.len

        var g: &sync Flash = Flash([1, 2, 3, 4, 5, 6, 7, 8])

        main()
            print(sum(g.data[..]))
        """, slv_root(),"main.sysl:11:")
    slv_refused(raw"""
        struct Inner
            a: [4]i32

        struct Ring
            boxed: &sync Inner

        sum(xs: []const i32) -> i32 = xs.len

        nested(r: &sync Ring) -> i32 = sum(r.boxed.a[..])

        main()
            val r: &sync Ring = Ring(Inner([1, 2, 3, 4]))
            print(nested(r))
        """, slv_root(),"main.sysl:9:")
    slv_refused(slv_flash() + raw"""
        sum(xs: []const i32) -> i32 = xs.len

        rebound(f: &sync Flash) -> i32
            var r = f
            val n = sum(r.data[..])
            r = Flash([0, 0, 0, 0, 0, 0, 0, 0])
            n

        main()
            print(rebound(Flash([1, 2, 3, 4, 5, 6, 7, 8])))
        """, slv_root(),"main.sysl:10:")
    slv_refused(slv_flash() + raw"""
        sum(xs: []const i32) -> i32 = xs.len

        poke(r: *&sync Flash)
            *r = Flash([0, 0, 0, 0, 0, 0, 0, 0])

        addressed(f: &sync Flash) -> i32
            var r = f
            poke(&r)
            sum(r.data[..])

        main()
            print(addressed(Flash([1, 2, 3, 4, 5, 6, 7, 8])))
        """, slv_root(),"main.sysl:14:")

@test("the same view through a val copy of the box is lent and runs")
slv_val_copy_of_the_box()
    slv_prints(raw"""
        struct Inner
            a: [4]i32

        struct Ring
            boxed: &sync Inner

        sum(xs: []const i32) -> i32
            var t = 0
            for x in xs
                t += x
            t

        nested(r: &sync Ring) -> i32
            val inner = r.boxed
            sum(inner.a[1..])

        main()
            val r: &sync Ring = Ring(Inner([1, 2, 3, 4]))
            print(nested(r))
        """, "9\n")

// -- the block of the local holding the box ----------------------------------------------------------
//
// The local a view is reached through ends with its block (L1), and with it what keeps the box alive,
// so a local holding the view may not be declared in a block outside it. The axes: the block the box's
// local is declared in (an `if`, a `for` and a `while` body, a `match` arm and its pattern binding, a
// nested block's value); how the view reaches the outer local (stored in place, through a second
// local, through a `ref`); a `&sync` struct's field and a `&sync [N]T` itself; generic and
// non-generic. The accepted cells are the same shapes with the holder in the box's block or inside it.
//
// The analysis is flow-insensitive, so an outer local that is given the view, used and cleared again
// inside the block is refused all the same: it is a local that outlives the block, which is what L9
// says a lent view may not be held in.

private slv_box() -> string = raw"""
    struct Flash
        data: [8]i32

    sum(xs: []const i32) -> i32
        var t = 0
        for x in xs
            t += x
        t

    make(k: i32) -> &sync Flash = Flash([k, k, k, k, k, k, k, k])

    """

private slv_block(boxed: string, root: string, block: string, holder: string) -> string =
    s"a view of storage inside the '$boxed' in '$root', a local of $block, is kept in '$holder', a local " +
    "of the body, which outlives that block — such a view takes no count of the box"

@test("a view of &sync storage kept past the 'if', 'for', 'while' or 'match' arm of its box's local is refused")
slv_block_refused_per_form()
    slv_refused(slv_box() + raw"""
        main()
            var v: []const i32 = []
            if sum(v) == 0
                val b = make(7)
                v = b.data[0..<2]
            print(sum(v))
        """, slv_block("&sync Flash", "b", "the 'if' block", "v"), "main.sysl:16:")
    slv_refused(slv_box() + raw"""
        main()
            var v: []const i32 = []
            for k in 0..<2
                val b = make(k)
                if k == 0 then v = b.data[..]
            print(sum(v))
        """, slv_block("&sync Flash", "b", "the 'for' body", "v"), "main.sysl:16:")
    slv_refused(slv_box() + raw"""
        main()
            var v: []const i32 = []
            var k = 0
            while k < 1
                val b: &sync [4]i32 = [1, 2, 3, 4]
                v = b[..]
                k += 1
            print(sum(v))
        """, slv_block("&sync [4]int", "b", "the 'while' body", "v"), "main.sysl:17:")
    slv_refused(slv_box() + raw"""
        main()
            var v: []const i32 = []
            val n = 1
            n match
                1 ->
                    val b = make(1)
                    v = b.data[2..]
                _ -> ()
            print(sum(v))
        """, slv_block("&sync Flash", "b", "a 'match' arm", "v"), "main.sysl:18:")
end slv_block_refused_per_form

@test("a view of &sync storage kept past a pattern binding's arm or out of a nested block's value is refused")
slv_block_refused_binding_and_value()
    slv_refused(slv_box() + raw"""
        pick(k: i32) -> Option[&sync Flash] = Some(make(k))

        main()
            var v: []const i32 = []
            pick(2) match
                Some(b) -> v = b.data[..]
                None -> ()
            print(sum(v))
        """, slv_block("&sync Flash", "b", "a 'match' arm", "v"), "main.sysl:17:")
    slv_refused(slv_box() + raw"""
        main()
            val v =
                val b = make(3)
                b.data[1..<3]
            print(sum(v))
        """, slv_block("&sync Flash", "b", "a nested block", "v"), "main.sysl:15:")
end slv_block_refused_binding_and_value

@test("a view of &sync storage reaching an outer local through a second local, a ref, or cleared again is refused")
slv_block_refused_routes()
    slv_refused(slv_box() + raw"""
        main()
            var v: []const i32 = []
            if sum(v) == 0
                val b = make(7)
                val s = b.data[..]
                v = s[1..]
            print(sum(v))
        """, slv_block("&sync Flash", "b", "the 'if' block", "v"), "main.sysl:17:")
    slv_refused(slv_box() + raw"""
        main()
            var v: []const i32 = []
            if sum(v) == 0
                val b = make(7)
                ref q = b.data
                v = q[2..]
            print(sum(v))
        """, slv_block("&sync Flash", "b", "the 'if' block", "v"), "main.sysl:17:")
    slv_refused(slv_box() + raw"""
        main()
            var v: []const i32 = []
            if sum(v) == 0
                val b = make(7)
                v = b.data[0..<2]
                print(sum(v))
                v = []
            print(sum(v))
        """, slv_block("&sync Flash", "b", "the 'if' block", "v"), "main.sysl:16:")
end slv_block_refused_routes

@test("a generic body keeping a view of a &sync array past its box's block is refused")
slv_block_refused_generic()
    slv_refused(raw"""
        pick[T](x: T) -> usize
            var v: []const T = []
            for i in 0..<1
                val b: &sync [4]T = [x, x, x, x]
                v = b[1..]
            v.len

        main()
            print(pick(1))
        """, "in 'b', a local of the 'for' body, is kept in 'v', a local of the body, which outlives that block",
        "main.sysl:5:")

@test("a view of &sync storage held in the box's own block or one inside it is lent and runs")
slv_block_accepted()
    slv_prints(slv_box() + raw"""
        pick(k: i32) -> Option[&sync Flash] = Some(make(k))

        first[T](b: &sync [4]T, x: T, go: bool) -> T
            var t = x
            if go
                val v = b[1..]
                t = v[0]
            t

        fresh[T](x: T) -> T
            var t = x
            for i in 0..<2
                val b: &sync [4]T = [x, x, x, x]
                var v: []const T = []
                v = b[i..]
                t = v[0]
            t

        main()
            var total = 0
            val outer = make(2)
            if total == 0
                val v = outer.data[0..<3]
                total += sum(v)
            for k in 0..<2
                val b = make(k + 1)
                var v: []const i32 = []
                v = b.data[k..<k + 2]
                total += sum(v)
            var w: []const i32 = []
            w = outer.data[..]
            total += sum(w)
            pick(5) match
                Some(b) ->
                    val v = b.data[..<2]
                    total += sum(v)
                None -> ()
            val n =
                val b = make(3)
                val v = b.data[..]
                sum(v)
            val bb: &sync [4]i32 = [1, 2, 3, 4]
            val ww: &sync [4]i64 = [5, 6, 7, 8]
            print(total + n, first(bb, 0, true), first(ww, 0, true), fresh(9), fresh(i64(4)))
        """, "62 2 6 9 4\n")

// -- a module initializer ----------------------------------------------------------------------------
//
// A module initializer takes its view through the same kinds of root a body does, and answers to the
// same rule: a module `var` holding the box may be rebound by any body while the view taken at start-up
// is still held, and a field of another box may be written, so only a module `val` is a root. The axes:
// the box (a module `var` array, a field of a module `var` struct, a box nested in another one), what
// holds the view (a module `var`, a module `val`, a struct's field, a generic call it is lent to), and
// the accepted counterparts through a module `val`, and an initializer in another module, whose
// refusal is placed in that module's file.

@test("a module initializer's view of &sync storage held by a module var, or a field of another box, is refused")
slv_module_init_refused()
    slv_refused(raw"""
        var b: &sync [4]i32 = [1, 2, 3, 4]
        var s = b[..]

        main()
            b = [9, 9, 9, 9]
            print(s.len, s[2])
        """, slv_root(), "main.sysl:2:")
    slv_refused(slv_flash() + raw"""
        var g: &sync Flash = Flash([1, 2, 3, 4, 5, 6, 7, 8])
        val s = g.data[1..]

        main()
            print(s.len)
        """, slv_root(), "main.sysl:7:")
    slv_refused(raw"""
        struct Inner
            a: [4]i32

        struct Ring
            boxed: &sync Inner

        val r: &sync Ring = Ring(Inner([1, 2, 3, 4]))
        var s = r.boxed.a[..]

        main()
            print(s.len)
        """, slv_root(), "main.sysl:8:")
    slv_refused(raw"""
        struct Holder
            v: []const i32

        var b: &sync [4]i32 = [1, 2, 3, 4]
        var h = Holder(b[1..])

        main()
            print(h.v.len)
        """, slv_root(), "main.sysl:5:")
    slv_refused(raw"""
        first[T](xs: []const T) -> T = xs[0]

        var b: &sync [4]i64 = [1, 2, 3, 4]
        var n = first(b[2..])

        main()
            print(n)
        """, slv_root(), "main.sysl:4:")
    // A file with no `main` is a script, whose top-level `var`s are the entry's locals: one the
    // script stores into is a rebound local.
    slv_refused(raw"""
        var b: &sync [4]i32 = [1, 2, 3, 4]
        var s = b[..]
        b = [9, 9, 9, 9]
        print(s.len, s[2])
        """, slv_root(), "main.sysl:2:")

@test("a module initializer's view of &sync storage in an imported module is refused in that module's file")
slv_module_init_refused_in_its_file()
    if !slv_ready() then return

    val root = make_temp_dir("sysl-slv").unwrap()

    write_text(s"$root/sysl.hocon", "package { name = \"probe\", version = \"0.1.0\" }\n").unwrap()
    write_text(s"$root/main.sysl", "import store\n\nstore.b = [9, 9, 9, 9]\nprint(store.s.len)\n").unwrap()
    make_dir_all(s"$root/store").unwrap()
    write_text(s"$root/store/store.sysl",
               "module store\n\nvar b: &sync [4]int = [1, 2, 3, 4]\nvar s = b[..]\n").unwrap()

    var said: Buf[string] = buf()
    val sink = &said
    val code = run_cli(["sysl", "emit-llvm", root], piece -> sink.push(piece))
    var text = ""

    for item in said
        text = text + item + "\n"

    remove_dir_all(root).unwrap_or(())
    assert(code != 0, text)
    assert(text.contains(slv_root()), text)
    assert(text.contains("store/store.sysl:4:10"), text)
end slv_module_init_refused_in_its_file

@test("a module initializer's view of &sync storage held by a module val is accepted and runs")
slv_module_init_accepted()
    slv_prints(slv_flash() + raw"""
        struct Holder
            v: []const i32

        first[T](xs: []const T) -> T = xs[0]

        val b: &sync [4]i32 = [1, 2, 3, 4]
        val g: &sync Flash = Flash([1, 2, 3, 4, 5, 6, 7, 8])
        val w: &sync [4]i64 = [5, 6, 7, 8]
        var s = b[1..]
        val t = g.data[2..<5]
        var h = Holder(b[..])
        var n = first(w[3..])

        main()
            print(s.len, s[1], t[0], h.v.len, n)
        """, "3 3 3 4 8\n")
    // A script's top-level `var` it never stores into is a local that goes on holding the box.
    slv_prints(raw"""
        var b: &sync [4]i32 = [1, 2, 3, 4]
        var s = b[1..]
        print(s.len, s[1])
        """, "3 3\n")
