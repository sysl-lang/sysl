module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.container.{Map, map, Set, set}

// Who is holding a count for a by-value argument while the call it was passed to runs.
//
// **A caller guarantees that every by-value argument it hands over stays alive for the whole of the
// call, and a callee reads its parameters through that guarantee without taking a count of its
// own.** That is Swift's `guaranteed` convention and Rust's `&self` borrow, and it is the cheap half
// of a call: `push(*self, v: T)` with a local `v` costs no reference traffic at either end, however
// much memory the body writes.
//
// **The guarantee is one-sided, which is what makes it work across a compilation boundary.** The
// caller's obligation is the same whatever the callee turns out to do, so it can be discharged
// against a name, a table slot or a function the compiler has never seen. A callee that takes a
// count anyway is still correct -- an extra count held by a frame that gives it back is invisible --
// so `owning` is free to be conservative without the caller having to know.
//
// The caller discharges its side by looking at the argument alone (`held`): a temporary is a count
// this frame took and gives back after the call returns; a local or parameter whose address was
// never let out holds its count in a slot no callee can name; anything else -- a field, an element,
// a dereference, a global, a `ref`, a local whose address escaped -- keeps its count in memory the
// callee may write, so the caller takes one of its own for the value it hands over.
//
// What the callee still owns, each for a reason that is not an exception: a parameter whose own
// slot the body rebinds (the assignment gives back a count, and under a borrow that count is the
// caller's); every parameter of a function with a tail self-call (the jump carries each value across
// the release of the whole frame with a count the slot then has to give back); and every parameter
// of a function something outside the program may call -- `@export`, a `@section`, a foreign
// convention, or an address taken, since a `*fn` is called under C's convention and nothing on that
// side discharges a caller's obligation.
//
// **And a body that can release nothing at all keeps the borrow in every one of those cases**
// (`inert_callees`): calling nothing that might and writing only its own locals, it cannot reach a
// release however it was entered. That is also what lets a caller skip its own count on a place argument at a call
// to such a function.

// The name that stands for "something was reached that could have written anything", which no local
// can be called -- a module key always has a separator in it.
const OPAQUE: string = "*"

// A set of names a walk adds to through the box it captured.
struct NameSink
    names: Set[string]

    add(*self, name: string)
        self.names.add(name)
end NameSink

private name_sink() -> &NameSink = NameSink(set())

// A flag a walk lowers through the box it captured.
struct Verdict
    ok: bool

    refuse(*self)
        self.ok = false
end Verdict

// -- the callee: a body that can release nothing it did not take --------------------------------------

// The functions whose by-value parameters may be read through the caller's count: every body that
// can neither write memory it does not own nor call anything that might.
//
// **The test is deliberately crude, because what it has to be is obviously right.** A retain is
// dropped only where the body cannot, by any path that comes back, release anything it did not
// take: no call that returns into something that might, and no write to memory but its own locals'.
// What that leaves is the reader -- an accessor, a length, a predicate over fields, and whatever
// calls only those -- which is exactly where the pair costs most. It is also what lets a caller hand
// such a function a place with no snapshot at all (`indirect_arg`): a body that can write nothing
// cannot change what it was given. A contract clause is code too, emitted around the body rather
// than inside it, so a function carrying one is left alone.
//
// **A call is allowed where its callee is itself one of these**, so the question is answered over
// the whole program at once. A function that calls only functions that can release nothing cannot
// release anything either, and a cycle of them -- recursion -- is no different, since a release
// needs a finite path to it and none of the members has one. That is the GREATEST set closed under
// the rule, which is why the computation starts from every candidate and only ever removes one. A
// comparison or a compound assignment dispatched to a trait method is a call like any other.
//
// **A write to the function's own local is allowed too**, for the reason a declaration already is:
// the count the slot gives back is the one the slot took when it was written. Only a `var` the body
// itself declared qualifies -- a parameter's slot holds the caller's count under this very borrow,
// and a `ref` names storage somebody else owns -- and only its own bytes: an element of a SLICE it
// holds belongs to whoever owns the elements.
//
// **A function owning a parameter gives back the count it was handed** wherever it does not keep it
// (`owned_params.sysl`), so it is never one of these, and nor is anything that calls it. `owning` is
// those functions.
//
// **A call on a path that ends the program is judged too, by a rule of its own** (`quiet_callees`).
// A caller's count may be missing for as long as the callee runs, and a path that never comes back
// still runs: `die(t)` that overwrites the global holding `t` and then reads `t` frees it under its
// own feet. What that path may call is anything that releases nothing on the way out -- which, unlike
// here, takes in a foreign function, so `unwrap`'s report and `Buf.at`'s bounds failure stay inert.
inert_callees(p: TProgram, owning: Set[string] = set()) -> Set[string]
    val s = call_summary(p, owning)
    val quiet = quiet_callees(p, s)
    var seed: Buf[bool] = buf()

    for i in 0..<p.funcs.len()
        var ok = s.ok.at(i)

        for site in s.exit_sites.at(i)
            if !quiet_admits(quiet, p, site) then ok = false

        seed.push(ok)

    greatest(p, s.calls, seed, set())
end inert_callees

// What every body of a program does that `inert_callees` and `quiet_callees` judge it by, each list
// indexed as `p.funcs`:
//
// - `ok`: free of writes to memory it does not own and of every node off the `inert_leaf` list;
// - `calls` and `exits`: the functions it calls on a path that may come back, and on one that ends
//   the program (`exit_kinds`);
// - `quiet_ok`, `through` and `sites`, for `quiet_callees`: the same verdict with one kind of write
//   set aside rather than refused -- a value with no count in it written through a view or pointer
//   PARAMETER, recorded as that parameter's index in `through` -- and every call with what each
//   argument is (`Site`), so the fixpoint can tell whether such a write lands in its caller's own
//   frame. `printi` hands `digits_long` a view of its own array, and `printc` hands `encode_utf8` one:
//   both write nothing their caller did not own.
private struct CallSummary
    ok: Buf[bool]
    calls: Buf[Buf[string]]
    exits: Buf[Buf[string]]
    quiet_ok: Buf[bool]
    through: Buf[Buf[int]]
    sites: Buf[Buf[Site]]
    exit_sites: Buf[Buf[Site]]
end CallSummary

// One call, for `quiet_callees`: the callee, and for each argument whether it is a view or address of
// the caller's own local (`own`), or else which of the caller's view or pointer parameters it passes
// on (`pass`, -1 for none).
private struct Site
    name: string
    own: Buf[bool]
    pass: Buf[int]
end Site

// What `call_summary`'s walk of one body gathers for `quiet_callees`.
private struct QuietSink
    ok: bool
    through: Buf[int]
    sites: Buf[Site]
    exit_sites: Buf[Site]

    refuse(*self)
        self.ok = false

    note(*self, j: int)
        self.through.push(j)

    site(*self, s: Site)
        self.sites.push(s)

    exit_site(*self, s: Site)
        self.exit_sites.push(s)
end QuietSink

private call_summary(p: TProgram, owning: Set[string]) -> CallSummary
    var out = CallSummary(buf(), buf(), buf(), buf(), buf(), buf(), buf())

    for i in 0..<p.funcs.len()
        val f = p.funcs.at(i)
        val sink: &CallSink = CallSink(buf())
        val exits: &CallSink = CallSink(buf())
        val v: &Verdict = Verdict(f.requires.is_empty() && f.ensures.is_empty() && f.olds.is_empty() &&
                                  f.variant.is_none() && !owning.has(f.name))
        val q: &QuietSink = QuietSink(v.ok, buf(), buf(), buf())

        if v.ok
            val b = Body(f.params, own_locals(f), declared_names(f), exit_kinds(f.body))

            walk_block_stmts(f.body, TWalk(true, x -> inert_node(v, sink, exits, q, b, x),
                                           w -> both_refuse(v, q),
                                           s -> if !inert_stmt(s) then both_refuse(v, q)))

        out.ok.push(v.ok)
        out.calls.push(sink.names)
        out.exits.push(exits.names)
        out.quiet_ok.push(q.ok)
        out.through.push(q.through)
        out.sites.push(q.sites)
        out.exit_sites.push(q.exit_sites)

    out
end call_summary

private both_refuse(v: &Verdict, q: &QuietSink)
    v.refuse()
    q.refuse()

// What `inert_node` needs to know about the body it is in.
private struct Body
    params: Buf[(string, Type)]
    locals: Set[string]
    declared: Set[string]
    ending: &KindSink
end Body

// Every name a body declares, `var`, `val` or `ref`: a parameter one of them shadows is not reliably
// the parameter wherever it is named.
private declared_names(f: TFunc) -> Set[string]
    val declared: &CallSink = CallSink(buf())
    val refs = name_sink()

    walk_block_stmts(f.body, stmt_walk(true, s -> own_decl(declared, refs, s)))

    var out: Set[string] = set()

    for item in refs.names
        out.add(item)

    for item in declared.names
        out.add(item)

    out
end declared_names

// The index of the view or pointer parameter `r` reads, or -1.
private param_view(r: TExpr, b: Body) -> int = *r.kind match
    TLoad(name, ty) ->
        if b.declared.has(name) || (!is_view(ty) && pointee(ty).is_none()) then return -1

        for j in 0..<b.params.len()
            if b.params.at(j).0 == name then return if j < 1024 then int(j) else -1

        -1
    _ -> -1

// The parameter a write lands behind: a place reached from a view or pointer parameter by exactly one
// step through it -- an element of the view, what the pointer points at, a field of either -- and by
// fields and elements of arrays held by value from there. Anything else, -1.
private through_param(place: TExpr, b: Body) -> int = *place.kind match
    TIndex(r, _, _) -> repr(texpr_type(r)) match
        Array(_, _) -> through_param(r, b)
        _ -> param_view(r, b)
    TField(r, _, _) -> if pointee(texpr_type(r)).is_some() then param_view(r, b) else through_param(r, b)
    TDeref(r, _) -> param_view(r, b)
    _ -> -1

// A write `call_summary` meets: nothing where it lands in one of the body's own locals; otherwise a
// refusal for `inert_callees`, and for `quiet_callees` either a note of the parameter it lands behind
// or, where it holds a count or lands anywhere else, a refusal too.
private write_at(v: &Verdict, q: &QuietSink, b: Body, place: TExpr)
    if own_place(place, b.locals) then return

    v.refuse()

    val j = through_param(place, b)

    if j < 0 || contains_counted(place_type(place)) then q.refuse() else q.note(j)
end write_at

// One argument of a call, as `Site` records it.
private own_arg(a: TExpr, b: Body) -> bool = *a.kind match
    TAddrOf(place, _) -> own_place(place, b.locals)
    TSlice(base, _, _, _, _) -> repr(texpr_type(base)) match
        Array(_, _) -> own_place(base, b.locals)
        _ -> false
    _ -> false

private passed_arg(a: TExpr, b: Body) -> int = *a.kind match
    TSlice(base, _, _, _, _) -> param_view(base, b)
    _ -> param_view(a, b)

private site_of(name: string, args: Buf[TExpr], b: Body) -> Site
    var own: Buf[bool] = buf()
    var pass: Buf[int] = buf()

    for item in args
        own.push(own_arg(item, b))
        pass.push(passed_arg(item, b))

    Site(name, own, pass)
end site_of

// The functions that release nothing at all, whether or not they come back, together with the
// foreign functions a path ending the program may call: the names a call on such a path may reach.
//
// **The test is `inert_callees`' own, with two differences.** A call that does not come back is held
// to it rather than passed over -- `die` above is refused for the store, and so is everything that
// calls it -- and a FOREIGN call is trusted, since what a program is doing as it ends is reporting
// why: `print`'s `putbytes`, `exit`, `sysl_bounds_fail`, the trap.
//
// **A foreign function is trusted only where no sysl function C can reach releases anything.** C
// reaches sysl through an `@export` (a program's own `sysl_bounds_fail` among them), a `@section`, a
// foreign convention and an address taken; where every one of those is itself in the set, nothing a
// foreign call could call back into releases, and the answer is consistent. Otherwise the set is
// computed again with no foreign function in it. The program's entry is left out: C calls it once,
// before anything this asks about runs. An `@abandons` function is never in it, either side of the
// boundary: its caller's frame is given back before the call, and the program goes on afterwards.
// What needs no trust at all is a call that never returns and is handed only numbers
// (`sealed_callees`), which is in the set either way.
//
// **Trust is a fact about a whole program, so only a program has it.** A library artifact (a
// `.syslib`, a C archive) cannot know what the program it is linked into exports, so it trusts no
// foreign function. In a program the standard library's own exports are left out of the check: they
// are the suppliers of its hooks (`sysl_env_get`, `__addtf3`, ...), they reach no storage of the
// program's, and a precompiled standard module is not in the program's view at all -- leaving them in
// would make a build whose standard module is read from source answer differently from one whose
// module was precompiled.
//
// **A write through a view or pointer parameter is the caller's business** (`CallSummary`): a
// function that makes one is in the set only as far as each call to it hands that parameter a view or
// address of the caller's own local -- or the caller's own parameter, which passes the question on to
// ITS callers. What the set answers is the functions with no such question left.
private quiet_callees(p: TProgram, s: CallSummary) -> Quiet
    var foreign: Set[string] = set()

    for item in p.externs
        if !item.abandons then foreign.add(item.name)

    val sealed = sealed_callees(p)

    for item in sealed
        foreign.add(item)

    val trusting = quiet_fix(p, s, foreign)

    if !p.entry_point || !c_reaches_quiet(p, trusting.names) then return quiet_fix(p, s, sealed)

    trusting
end quiet_callees

// The functions a path ending the program may call whatever they do, foreign or not: those that never
// return and are handed nothing but numbers.
//
// **What the rest of this guards against is a release under a reader.** A call on a dying path may
// reach code that gives back the count a borrowed argument rests on -- a foreign function by calling
// back into the program, a sysl one directly -- and that matters to whatever reads the argument
// afterwards: the callee itself, through what it was handed, or the body it returns to. One answering
// `never` returns to nothing, so no frame below it runs again, and one whose parameters are all
// numbers, booleans and characters was handed nothing a release could pull out from under it. Its own
// reads are its own body's business, judged where that body is. So nothing that can observe a release
// it causes ever runs again.
//
// **This is what keeps a `Buf` read free of a snapshot in a program that hands C a callback**: the
// standard library's `index_past` -- the report behind every `at`, `set` and `b[i]` -- takes two
// counts and answers `never`; the location `@track_caller` adds is a pointer to constant text that the
// typed signature does not carry. Without it, a program whose callbacks release anything distrusts
// `sysl_bounds_fail` under `index_past`, and every element read through a pointer takes and gives
// back a count on the buffer and another on its storage. An `@abandons` function returns into an
// earlier frame, so it is never one of these.
sealed_callees(p: TProgram) -> Set[string]
    var out: Set[string] = set()

    for item in p.externs
        if !item.abandons && !item.variadic && is_never(item.ret_ty) && all_numbers(item.params) then
            out.add(item.name)

    for f in p.funcs
        if !f.marks.abandons && is_never(f.ret_ty) && all_numbers(param_types(f.params)) then
            out.add(f.name)

    out
end sealed_callees

private param_types(ps: Buf[(string, Type)]) -> Buf[Type]
    var out: Buf[Type] = buf()

    for item in ps
        out.push(item.1)

    out
end param_types

private is_never(t: Type) -> bool = underlying(t) match
    Never -> true
    _ -> false

private all_numbers(ts: Buf[Type]) -> bool
    for t in ts
        val plain = underlying(t) match
            Integer(_, _, _) -> true
            Floating(_, _) -> true
            Fixed(_, _, _) -> true
            Bool -> true
            Char -> true
            _ -> false

        if !plain then return false

    true
end all_numbers

// What `quiet_callees` answers: the functions alive, the parameters each writes through (`through_key`),
// the index of each name in `p.funcs`, the foreign functions trusted (`also`), and `names` -- the
// trusted foreign functions and the functions alive writing through no parameter, which is what a
// call that hands over nothing of its own may reach.
private struct Quiet
    alive: Buf[bool]
    through: Set[usize]
    index: Map[string, usize]
    also: Set[string]
    names: Set[string]
end Quiet

// Whether a call on a path that ends the program releases nothing and writes nothing but what the
// calling frame owns: a trusted foreign function, or one alive whose every written-through parameter
// is handed a view or address of the caller's own local.
private quiet_admits(q: Quiet, p: TProgram, site: Site) -> bool
    if q.also.has(site.name) then return true

    val k = q.index.get(site.name)

    if k.is_none() || !q.alive.at(k.unwrap()) then return false

    for j in 0..<p.funcs.at(k.unwrap()).params.len()
        if q.through.has(through_key(k.unwrap(), j)) && !(j < site.own.len() && site.own.at(j)) then
            return false

    true
end quiet_admits

// The greatest assignment of "alive, writing through these parameters" closed under every call site,
// and the functions it leaves alive writing through none. `also` names the foreign functions trusted.
private quiet_fix(p: TProgram, s: CallSummary, also: Set[string]) -> Quiet
    var index: Map[string, usize] = map()
    var alive: Buf[bool] = buf()
    var through: Set[usize] = set()

    for i in 0..<p.funcs.len()
        val f = p.funcs.at(i)

        if !index.has(f.name) then index.put(f.name, i)

        alive.push(s.quiet_ok.at(i) && !f.marks.abandons)

        for j in s.through.at(i)
            through.add(through_key(i, usize(j)))

    var moved = true

    while moved
        moved = false

        for i in 0..<p.funcs.len()
            for site in s.sites.at(i)
                if alive.at(i) && !also.has(site.name)
                    val k = index.get(site.name)

                    if k.is_none() || !alive.at(k.unwrap())
                        alive.set(i, false)
                        moved = true
                    else
                        for j in 0..<p.funcs.at(k.unwrap()).params.len()
                            if alive.at(i) && through.has(through_key(k.unwrap(), j)) &&
                               !(j < site.own.len() && site.own.at(j))
                                val from = if j < site.pass.len() then site.pass.at(j) else -1

                                if from < 0
                                    alive.set(i, false)
                                    moved = true
                                else if !through.has(through_key(i, usize(from)))
                                    through.add(through_key(i, usize(from)))
                                    moved = true

    var out: Set[string] = set()

    for i in 0..<p.funcs.len()
        var clear = alive.at(i)

        for j in 0..<p.funcs.at(i).params.len()
            if through.has(through_key(i, j)) then clear = false

        if clear then out.add(p.funcs.at(i).name)

    for item in also
        out.add(item)

    Quiet(alive, through, index, also, out)
end quiet_fix

private through_key(i: usize, j: usize) -> usize = i * 1024 + j

// Whether every sysl function C can call, but the program's entry and the standard library's own
// exports, is one of `quiet`. A standard function whose address is taken is still checked: it may be
// handed to C to call back into the program's own code.
private c_reaches_quiet(p: TProgram, quiet: Set[string]) -> bool
    val addressed = addressed_funcs(p)
    val entry = if p.entry.is_some() then p.entry.unwrap().func else ""

    for f in p.funcs
        val supplier = f.exported.is_some() && (f.declared_in == "sysl" || f.declared_in.starts_with("sysl."))
        val reached = (f.exported.is_some() && !supplier) || f.section.is_some() || f.conv.is_some() ||
                      addressed.has(f.name)

        if reached && f.name != entry && !quiet.has(f.name) then return false

    true
end c_reaches_quiet

// The greatest set of `p.funcs` closed under the rule that a function stays only while every name in
// its `calls` is still in it or is one of `also`, starting from those `seed` admits. A cycle stays,
// since a release needs a finite path to it and none of the members has one.
private greatest(p: TProgram, calls: Buf[Buf[string]], seed: Buf[bool], also: Set[string]) -> Set[string]
    var alive: Buf[bool] = buf()
    var out: Set[string] = set()

    for i in 0..<p.funcs.len()
        alive.push(seed.at(i))

        if seed.at(i) then out.add(p.funcs.at(i).name)

    var moved = true

    while moved
        moved = false

        for i in 0..<p.funcs.len()
            for item in calls.at(i)
                if alive.at(i) && !out.has(item) && !also.has(item)
                    alive.set(i, false)
                    out.remove(p.funcs.at(i).name)
                    moved = true

    out
end greatest

// -- the calls on a path that ends the program -------------------------------------------------------

// The call nodes of a body that sit on a path ending the program, by the identity of their node: every
// call to a function that does not come back, and every call in the run of statements that leads
// straight to one in the same block -- `unwrap`'s report before its `exit`. The run stops, going
// back, at the first statement that could leave the block another way (a `return`, a `break`, a
// `continue`, a `?`, a suspension), since what precedes that may be followed by a return after all.
private struct KindSink
    kinds: Buf[&TExprKind]

    add(*self, k: &TExprKind)
        self.kinds.push(k)

    has(self, k: &TExprKind) -> bool
        for item in self.kinds
            if item === k then return true

        false
end KindSink

private exit_kinds(b: TBlock) -> &KindSink
    val sink: &KindSink = KindSink(buf())

    exit_run(sink, b.stmts, b.result)
    walk_block_stmts(b, expr_walk(true, x -> exit_node(sink, x)))
    sink
end exit_kinds

// One node: a call that does not come back, or a form holding blocks whose runs are read.
private exit_node(sink: &KindSink, x: TExpr) = *x.kind match
    TCall(_, _, ty, _) -> if ty == Never then sink.add(x.kind)
    TIf(_, then_block, else_block, _) ->
        exit_run(sink, then_block.stmts, then_block.result)
        exit_opt(sink, else_block)
    TMatch(_, arms, _) ->
        for arm in arms
            exit_run(sink, arm.body.stmts, arm.body.result)
    TBlockExpr(block) -> exit_run(sink, block.stmts, block.result)
    TWhile(_, body, else_block, _) -> exit_loop(sink, body, else_block)
    TDoWhile(body, _, else_block, _) -> exit_loop(sink, body, else_block)
    TLoop(body, _) -> exit_run(sink, body, None)
    TFor(_, _, _, _, _, body, else_block, _) -> exit_loop(sink, body, else_block)
    TCFor(_, _, _, body, else_block, _) -> exit_loop(sink, body, else_block)
    TForEach(_, _, _, body, else_block, _) -> exit_loop(sink, body, else_block)
    TIterate(_, _, _, _, _, body, else_block, _) -> exit_loop(sink, body, else_block)
    _ -> ()

private exit_loop(sink: &KindSink, body: Buf[TStmt], else_block: Option[TBlock])
    exit_run(sink, body, None)
    exit_opt(sink, else_block)

private exit_opt(sink: &KindSink, b: Option[TBlock]) =
    if b.is_some() then exit_run(sink, b.unwrap().stmts, b.unwrap().result)

// One block's statements and result: the first statement that ends the program, or a result that
// does, and the run of statements before it that cannot leave the block another way.
private exit_run(sink: &KindSink, stmts: Buf[TStmt], result: Option[TExpr])
    var stop = stmts.len()

    for i in 0..<stmts.len()
        if stop == stmts.len() && ends_program(stmts.at(i)) then stop = i

    if stop == stmts.len() && (result.is_none() || !exit_call(result.unwrap())) then return

    val last = if stop < stmts.len() then stmts.at(stop) else TExprStmt(result.unwrap())

    if leaves(last) then return

    mark_calls(sink, last)

    var j = stop

    while j > 0 && !leaves(stmts.at(j - 1))
        j -= 1
        mark_calls(sink, stmts.at(j))
end exit_run

private ends_program(s: TStmt) -> bool = s match
    TExprStmt(e) -> exit_call(e)
    _ -> false

private exit_call(e: TExpr) -> bool = *e.kind match
    TCall(_, _, ty, _) -> ty == Never
    _ -> false

private mark_calls(sink: &KindSink, s: TStmt) = walk_stmt(s, expr_walk(true, x -> mark_call(sink, x)))

private mark_call(sink: &KindSink, x: TExpr) = *x.kind match
    TCall(_, _, _, _) -> sink.add(x.kind)
    _ -> ()

// Whether a statement could hand control anywhere but to the statement after it or to the end of
// the program: a `return`, `become`, `break` or `continue` anywhere in it, a `?`, or a suspension.
private leaves(s: TStmt) -> bool
    val v: &Verdict = Verdict(true)

    walk_stmt(s, TWalk(true, x -> leaves_node(v, x), w -> (), st -> leaves_stmt(v, st)))
    !v.ok
end leaves

private leaves_stmt(v: &Verdict, s: TStmt) = s match
    TReturn(_) -> v.refuse()
    TBecome(_) -> v.refuse()
    TBreak(_, _) -> v.refuse()
    TContinue(_) -> v.refuse()
    _ -> ()

private leaves_node(v: &Verdict, x: TExpr) = *x.kind match
    TTry(_, _, _, _, _, _, _) -> v.refuse()
    TAwait(_, _) -> v.refuse()
    TYieldNow -> v.refuse()
    TStep(_, _) -> v.refuse()
    TPark(_) -> v.refuse()
    _ -> ()

// The callees a body names, in a box a walk's closures push through.
private struct CallSink
    names: Buf[string]

    add(*self, name: string)
        self.names.push(name)
end CallSink

// The names whose slots are this body's own: every `var`/`val` it declares, less any spelling a
// parameter or a `ref` shares, since a name declared twice is one a write cannot be told apart by.
private own_locals(f: TFunc) -> Set[string]
    val declared: &CallSink = CallSink(buf())
    val refs = name_sink()

    walk_block_stmts(f.body, stmt_walk(true, s -> own_decl(declared, refs, s)))

    for param in f.params
        refs.add(param.0)

    var out: Set[string] = set()

    for item in declared.names
        if !refs.names.has(item) then out.add(item)

    out
end own_locals

private own_decl(declared: &CallSink, refs: &NameSink, s: TStmt) = s match
    TVarDecl(name, _, _, _) -> declared.add(name)
    TRefDecl(name, _, _) -> refs.add(name)
    _ -> ()

// A statement a body that releases nothing may hold. A local's own storage is the function's, and
// the count it holds is one the function took, so giving it back at the end of the block gives back
// nothing the caller was relying on.
private inert_stmt(s: TStmt) -> bool = s match
    TVarDecl(_, _, _, _) -> true
    TRefDecl(_, _, _) -> true
    TExprStmt(_) -> true
    TReturn(_) -> true
    TBreak(_, _) -> true
    TContinue(_) -> true
    _ -> false

// One node of a body being asked whether it is inert. A call is noted rather than judged, since
// whether its callee qualifies is the fixpoint's question -- in `exits` where it sits on a path that
// ends the program (`ending`), in `calls` otherwise.
private inert_node(v: &Verdict, calls: &CallSink, exits: &CallSink, q: &QuietSink, b: Body, x: TExpr) =
    *x.kind match
        TCall(name, args, _, _) ->
            val site = site_of(name, args, b)

            if b.ending.has(x.kind)
                exits.add(name)
                q.exit_site(site)
            else calls.add(name)

            q.site(site)

        TStore(place, _, _, _) -> write_at(v, q, b, place)
        TIncDec(place, _, _, _, _) -> write_at(v, q, b, place)
        TUpdate(place, _, _, _, dispatch, _, _) ->
            write_at(v, q, b, place)

            if dispatch.is_some()
                calls.add(dispatch.unwrap().name)
                q.site(Site(dispatch.unwrap().name, buf(), buf()))

        // A comparison may be a trait method rather than an instruction, and then it is a call.
        TCompare(_, cmps) ->
            for cmp in cmps
                if cmp.dispatch.is_some()
                    calls.add(cmp.dispatch.unwrap().name)
                    q.site(Site(cmp.dispatch.unwrap().name, buf(), buf()))

        _ -> if !inert_leaf(x) then both_refuse(v, q)

// The place a write lands in, where that is one of `locals` reached without a dereference.
private own_place(place: TExpr, locals: Set[string]) -> bool = *place.kind match
    TLoad(name, _) -> locals.has(name)
    TField(r, _, _) -> own_place(r, locals)
    TIndex(r, _, _) -> repr(texpr_type(r)) match
        Array(_, _) -> own_place(r, locals)
        _ -> false
    _ -> false

// Whether this node, on its own, can neither hand control to code that returns nor write to memory.
//
// **The default is `false`, which is the whole reason this is a list of what is allowed.** A node
// added later is unknown to it, and unknown has to mean "keep the retain" -- the other way round, a
// new way of reaching arbitrary code would silently start dropping counts that were holding
// something up.
inert_leaf(x: TExpr) -> bool = *x.kind match
    TIntLit(_, _) -> true
    TFloatLit(_, _) -> true
    TQuadLit(_, _, _) -> true
    TStrLit(_) -> true
    TEmbed(_, _, _) -> true
    TBoolLit(_) -> true
    TUnitLit -> true
    TNullLit(_) -> true
    TZero(_) -> true
    TCStrLit(_) -> true
    TLoad(_, _) -> true
    TGlobal(_, _, _) -> true
    TFuncAddr(_, _, _) -> true

    TCast(_, _) -> true
    TFloorCast(_, _) -> true
    TDeref(_, _) -> true
    TAddrOf(_, _) -> true
    TTypeId(_, _) -> true
    TTempAddr(_, _) -> true

    TBinary(_, _, _, _) -> true
    TUnary(_, _, _) -> true
    TIntOp(_, _, _, _, _) -> true
    TLogical(_, _, _) -> true
    TSeq(_) -> true

    TField(_, _, _) -> true
    TIndex(_, _, _) -> true
    TLen(_, _) -> true
    TBytes(_) -> true
    TConstView(_) -> true
    TViewAs(_, _) -> true
    TSlice(_, _, _, _, _) -> true
    TStrView(_) -> true

    TIf(_, _, _, _) -> true
    TMatch(_, _, _) -> true
    TBlockExpr(_) -> true

    TWhile(_, _, _, _) -> true
    TDoWhile(_, _, _, _) -> true
    TLoop(_, _) -> true
    TFor(_, _, _, _, _, _, _, _) -> true

    // A loop over a sequence takes a count of what it walks and of each element it binds, and gives
    // back exactly those; the sequence and a cursor's `next` are calls of their own, judged as calls.
    TForEach(_, _, _, _, _, _) -> true
    TIterate(_, _, _, _, _, _, _, _) -> true

    TVectorLit(_, _) -> true
    TSplat(_, _) -> true
    TLanesAs(_, _) -> true
    TVecCompare(_, _, _, _) -> true
    TSelect(_, _, _, _) -> true
    TShuffle(_, _, _, _) -> true
    TLaneSet(_, _, _, _) -> true
    TReduce(_, _, _) -> true
    TVecOp(_, _, _) -> true
    TLane(_, _, _) -> true
    TVecLoad(_, _, _) -> true

    // Building a value takes shares of what goes into it and gives none back, so none of these can
    // be the release the rule is looking for.
    TStructNew(_, _) -> true
    TArrayLit(_, _) -> true
    TBufLit(_, _) -> true
    TArrayFill(_, _) -> true
    TEnumNew(_, _, _) -> true
    TEnumFromInt(_, _) -> true
    TEnumTry(_, _, _, _, _) -> true
    TDecode(_, _, _, _, _) -> true
    TErase(_, _, _) -> true
    TDowngrade(_, _) -> true

    _ -> false

// -- the callee: a body that cannot reach a value of one type ---------------------------------------

// What each body of the program can do to memory that is not its own, read once, and the functions
// found unable to change a value of each type a caller has asked about (`untouched_by`).
//
// **A caller hands a place over with no snapshot where nothing the callee does before it returns can
// write that place or give back a count it holds**: the by-value promise is about what the callee
// can observe, and a place nobody writes cannot be told from a copy of it. `inert_callees` answers
// that for every place at once, by refusing every write to memory the body does not own. This answers
// it for the places of ONE type, which is what lets a method that only reads its receiver be handed a
// large one in place even though it writes an output buffer, takes a lock word or fills a local `Buf`.
//
// **A write is judged by the object it lands in, by type.** Its place is traced back to what holds
// it: one of the body's own locals (always allowed, as in `inert_callees`), a global, or whatever a
// pointer, a reference or a view reaches. That object, of type R, can share storage with a value of
// type T only where one holds the other by value -- R is T or a part of T (a `*u32` may point at a
// field of a T, a `[]u32` at an array inside one), or T is a part of R. A pointer made by a cast and
// either side of a reinterpreting view or `bytes` can point anywhere, so a write through one of those
// types is never cleared (`laundered`).
//
// What keeps a body from qualifying for any type, exactly as in `inert_callees`: a call to anything
// not itself cleared (a foreign function, a closure, a trait object), a node not on the `inert_leaf`
// list, a contract, and a write that gives back a count -- plus making a value that holds a type with
// a destructor, whose `drop` could run any code at all when the value is let go.
struct Untouched
    names: Buf[string]
    calls: Buf[Buf[string]]
    roots: Buf[Buf[Type]]
    open: Buf[bool]
    laundered: Buf[Type]
    answers: Map[string, Set[string]]
end Untouched

// An empty summary, for an emitter that has not read a program yet.
untouched_none() -> Untouched = Untouched(buf(), buf(), buf(), buf(), buf(), map())

// Every body of `p` summarised for `untouched_by`. `dropping` is the program's types with a destructor,
// and `owning` the functions that give back a count they were handed (`inert_callees`).
untouched_summary(p: TProgram, dropping: Buf[Type], owning: Set[string] = set()) -> Untouched
    var u = untouched_none()
    val laundered = type_sink()
    val quiet = quiet_callees(p, call_summary(p, owning))

    for i in 0..<p.funcs.len()
        val f = p.funcs.at(i)
        val calls: &CallSink = CallSink(buf())
        val exits: &CallSink = CallSink(buf())
        val roots = type_sink()
        val v: &Verdict = Verdict(f.requires.is_empty() && f.ensures.is_empty() && f.olds.is_empty() &&
                                  f.variant.is_none())
        val locals = own_locals(f)
        val ending = exit_kinds(f.body)

        walk_block_stmts(f.body, TWalk(true, x -> touch_node(v, calls, exits, ending, roots, laundered,
                                                             dropping, locals, x),
                                       w -> touch_write(v, calls, roots, locals, w),
                                       s -> if !touch_stmt(s) then v.refuse()))

        // A call on a path that ends the program is held to `quiet_callees`, as in `inert_callees`.
        for item in exits.names
            if !quiet.names.has(item) then v.refuse()

        u.names.push(f.name)
        u.calls.push(calls.names)
        u.roots.push(roots.types)
        u.open.push(!v.ok || owning.has(f.name))

    u.laundered = laundered.types
    u
end untouched_summary

// The functions that cannot write a value of type `t` held anywhere, nor give back a count one holds,
// before they return: the greatest set closed under the rule, as `inert_callees` computes it.
untouched_by(u: *Untouched, t: Type) -> Set[string]
    val key = mangle(t)
    val known = u.answers.get(key)

    if known.is_some() then return known.unwrap()

    var parts: Buf[Type] = buf()

    by_value_parts(t, &parts)

    var alive: Buf[bool] = buf()
    var out: Set[string] = set()

    for i in 0..<u.names.len()
        var ok = !u.open.at(i)

        for root in u.roots.at(i)
            if ok && overlaps(root, t, parts, u.laundered) then ok = false

        alive.push(ok)

        if ok then out.add(u.names.at(i))

    var moved = true

    while moved
        moved = false

        for i in 0..<u.names.len()
            for item in u.calls.at(i)
                if alive.at(i) && !out.has(item)
                    alive.set(i, false)
                    out.remove(u.names.at(i))
                    moved = true

    u.answers.put(key, out)
    out
end untouched_by

// Whether an object of type `root` can share storage with a value of type `t`, whose by-value parts
// are `parts`: one holds the other, or `root` is a type a pointer was made to by a cast.
private overlaps(root: Type, t: Type, parts: Buf[Type], laundered: Buf[Type]) -> bool
    val r = underlying(root)

    if has_type(parts, r) || has_type(laundered, r) then return true

    var inside: Buf[Type] = buf()

    by_value_parts(r, &inside)
    has_type(inside, underlying(t))
end overlaps

// Every type a value of `t` holds by value, itself included: its fields, elements and payloads, all the
// way down, but not what a pointer, a reference or a view inside it reaches.
by_value_parts(t: Type, out: *Buf[Type])
    val u = underlying(t)

    if has_type(*out, u) then return

    out.push(u)

    u match
        Array(_, elem) -> by_value_parts(*elem, out)
        Vector(_, elem) -> by_value_parts(*elem, out)
        Struct(d) ->
            for item in d.fields
                by_value_parts(item.1, out)
        Results(d) ->
            for item in d.fields
                by_value_parts(item.1, out)
        Enum(d) ->
            for item in d.variants
                for field in item.fields
                    by_value_parts(field.1, out)
        _ -> ()
end by_value_parts

private has_type(ts: Buf[Type], t: Type) -> bool
    for item in ts
        if item == t then return true

    false
end has_type

// A list of types a walk adds to through the box it captured.
private struct TypeSink
    types: Buf[Type]

    add(*self, t: Type)
        if !has_type(self.types, t) then self.types.push(t)
end TypeSink

private type_sink() -> &TypeSink = TypeSink(buf())

// The statements `untouched_summary` reads into: those `inert_stmt` admits, and writes, which are
// judged by `touch_write`, and a deferred block, whose statements the walk reaches.
private touch_stmt(s: TStmt) -> bool = s match
    TWriteStmt(_) -> true
    TMultiAssign(_) -> true
    TDefer(_, _) -> true
    _ -> inert_stmt(s)

private touch_node(v: &Verdict, calls: &CallSink, exits: &CallSink, ending: &KindSink,
                   roots: &TypeSink, laundered: &TypeSink, dropping: Buf[Type], locals: Set[string],
                   x: TExpr)
    note_laundered(laundered, x)

    if makes_dropping(x, dropping) then v.refuse()

    *x.kind match
        TCall(name, _, _, _) -> if ending.has(x.kind) then exits.add(name) else calls.add(name)

        TStore(place, _, _, _) -> touch_place(v, roots, locals, place)
        TIncDec(place, _, _, _, _) -> touch_place(v, roots, locals, place)
        TUpdate(place, _, _, _, dispatch, _, _) ->
            touch_place(v, roots, locals, place)

            if dispatch.is_some() then calls.add(dispatch.unwrap().name)

        TCompare(_, cmps) ->
            for cmp in cmps
                if cmp.dispatch.is_some() then calls.add(cmp.dispatch.unwrap().name)

        _ -> if !inert_leaf(x) then v.refuse()
end touch_node

private touch_write(v: &Verdict, calls: &CallSink, roots: &TypeSink, locals: Set[string], w: TWrite)
    touch_place(v, roots, locals, w.place)

    if w.dispatch.is_some() then calls.add(w.dispatch.unwrap().name)
end touch_write

// One write: nothing to note where it lands in a local of the body's own; otherwise the object it
// lands in, and a refusal where the place holds a count the write would give back or where the object
// cannot be named.
private touch_place(v: &Verdict, roots: &TypeSink, locals: Set[string], place: TExpr)
    if own_place(place, locals) then return

    if contains_counted(place_type(place)) then v.refuse()

    write_root(place) match
        Some(t) -> roots.add(t)
        None -> v.refuse()
end touch_place

// The type of the object a place is part of: a local or a global, or what the pointer, reference or
// view it goes through reaches. An array's element is part of the array; anything else indexed is
// an element of storage somebody else owns.
private write_root(place: TExpr) -> Option[Type] = *place.kind match
    TLoad(_, ty) -> Some(ty)
    TGlobal(_, declared, _) -> Some(declared)
    TDeref(operand, ty) -> Some(pointee(texpr_type(operand)).unwrap_or(ty))
    TField(r, _, _) -> write_root(r)
    TIndex(r, _, ty) -> repr(texpr_type(r)) match
        Array(_, _) -> write_root(r)
        _ -> Some(element(texpr_type(r)).unwrap_or(ty))
    _ -> None

// The types a pointer was made to by something other than taking an address: a cast from another
// pointer or from an integer, a view read at another element type, and the bytes of any value.
private note_laundered(out: &TypeSink, x: TExpr) = *x.kind match
    TCast(operand, ty) -> repr(ty) match
        Ptr(inner) ->
            val from = pointee(texpr_type(operand))

            if from.is_none() || underlying(from.unwrap()) != underlying(*inner) then
                out.add(underlying(*inner))
        _ -> ()
    TViewAs(arg, ty) ->
        val a = view_elem(texpr_type(arg))
        val b = view_elem(ty)

        if a.is_some() then out.add(underlying(a.unwrap()))
        if b.is_some() then out.add(underlying(b.unwrap()))
    TBytes(_) -> out.add(byte_type())
    _ -> ()

// Whether this node makes a value that holds a type with a destructor -- one the body will let go,
// so the destructor may run before it returns. Reading a value that is already somewhere makes
// nothing.
private makes_dropping(x: TExpr, dropping: Buf[Type]) -> bool
    if dropping.is_empty() then return false

    val reads = *x.kind match
        TLoad(_, _) -> true
        TGlobal(_, _, _) -> true
        TField(_, _, _) -> true
        TIndex(_, _, _) -> true
        TDeref(_, _) -> true
        _ -> false

    if reads then return false

    var seen: Set[string] = set()

    holds_dropping(texpr_type(x), dropping, &seen)
end makes_dropping

// Whether a value of `t` holds, by value or through anything that keeps its object alive, a type
// with a destructor. A generic's arguments count as held, since its storage may be a raw pointer.
private holds_dropping(t: Type, dropping: Buf[Type], seen: *Set[string]) -> bool
    if has_type(dropping, t) then return true

    t match
        Array(_, elem) -> holds_dropping(*elem, dropping, seen)
        Ref(inner, _) -> holds_dropping(*inner, dropping, seen)
        Slice(elem, _) -> holds_dropping(*elem, dropping, seen)
        Constrained(d) -> holds_dropping(d.base, dropping, seen)
        Volatile(inner) -> holds_dropping(*inner, dropping, seen)
        Struct(d) ->
            val k = mangle(t)

            if seen.has(k) then return false

            seen.add(k)

            for item in d.fields
                if holds_dropping(item.1, dropping, seen) then return true

            for item in d.targs
                if holds_dropping(item, dropping, seen) then return true

            false
        Enum(d) ->
            val k = mangle(t)

            if seen.has(k) then return false

            seen.add(k)

            for item in d.variants
                for field in item.fields
                    if holds_dropping(field.1, dropping, seen) then return true

            for item in d.targs
                if holds_dropping(item, dropping, seen) then return true

            false
        _ -> false
end holds_dropping

// -- the callee: which large parameters it reads where the caller put them ---------------------------

// The large by-value parameters of `f` it reads **where its caller put them**, with no copy of its
// own at entry.
//
// A parameter past the indirect boundary arrives as an address, and every sysl caller hands over
// storage nothing can change for the length of the call (`indirect_arg`): a temporary, a local no
// callee can name, or a snapshot the caller staged. So a copy at entry would be a second snapshot of
// a snapshot, and for a multi-kilobyte receiver it is the frame. It is still made wherever something
// other than reading could tell:
//
//   - **the body changes its own copy** -- assigns to it or a part of it, takes its address, binds a
//     `ref` to it, or calls a `*self` method on it (`rebound`) -- or takes a writable view of an
//     array inside it, since a write through the view would be a write to the caller's value;
//   - **the function jumps back to its own entry**, which stores into the slots, or **carries a
//     `decreases` measure**, which a recursive call checks by laying its arguments in the slots for a
//     moment (`gen_variant_at_call`);
//   - **something outside the program may call it** -- `@export`, a `@section`, a foreign
//     convention, an address taken for a `*fn` -- since nothing on that side promises a snapshot;
//   - **the parameter is promoted**, its storage moving to the heap anyway.
reads_in_place(e: *Emit, f: TFunc, promoted: Buf[string]) -> Buf[string]
    var out: Buf[string] = buf()

    if e.address_taken.has(f.name) || f.exported.is_some() || f.section.is_some() ||
       f.conv.is_some() || !tail_calls_of(f).is_empty() || f.variant.is_some() then
        return out

    val bound = rebound(f)

    if bound.has(OPAQUE) then return out

    val viewed = name_sink()
    var moved: Set[string] = set()

    for item in promoted
        moved.add(item)

    walk_block_stmts(f.body, expr_walk(true, x -> viewed_root(viewed, x)))

    for param in f.params
        val n = param.0

        if e.layout.indirect(param.1) && !bound.has(n) && !viewed.names.has(n) &&
           !moved.has(n) then
            out.push(n)

    out
end reads_in_place

// The parameters of `f` below the indirect boundary that a direct call hands over **by address**:
// each one a by-value aggregate wider than two machine words (`Layout.lent_by_address`) that the body
// only reads, so the caller lends its own storage instead of loading the value into registers.
//
// It is `reads_in_place` brought below the boundary, with one difference that is the whole design:
// **a large parameter crosses by address because of its type, and one of these because of the body.**
// Two callers of the same function must agree on which, so the answer reads nothing but the body --
// never which addresses the program takes, which only the whole program knows. A function with one
// is emitted as two symbols, exactly as an owning one is (`owned_params.sysl`): the body, which takes
// the address, under `<symbol>.owned`, and under its own symbol an entry with the ordinary convention
// that puts the value in a slot of its own and lends the body that. A table, a function value, a hook
// and C reach the entry; only a direct call written in the program reaches the body.
//
// Where the body changes its copy, takes a writable view inside it, or is a kind of body nothing but
// the ordinary convention may enter (`may_own`'s list, which is the same list), the parameter crosses
// in registers as before. A parameter the body owns (`owned_params`) arrives with a count in registers
// and stays that way. **Promotion is not asked**: it is the body's own business, and one promoted
// copies what it was lent into its box at entry (`gen_function`), so the convention never turns on an
// answer the escape analysis gives.
read_by_address(e: *Emit, f: TFunc, owned: Set[string]) -> Buf[string]
    var out: Buf[string] = buf()

    if f.ghost || f.variadic || f.exported.is_some() || f.section.is_some() || f.conv.is_some() ||
       f.marks.is_async() || f.variant.is_some() || is_closure_body(f) || !tail_calls_of(f).is_empty() then
        return out

    var any = false

    for param in f.params
        if e.layout.lent_by_address(param.1) then any = true

    if !any then return out

    val bound = rebound(f)

    if bound.has(OPAQUE) then return out

    val viewed = name_sink()

    walk_block_stmts(f.body, expr_walk(true, x -> viewed_root(viewed, x)))

    for j in 0..<f.params.len()
        val n = f.params.at(j).0

        if e.layout.lent_by_address(f.params.at(j).1) && !bound.has(n) && !viewed.names.has(n) &&
           !owned.has(owned_key(f.name, j)) then
            out.push(n)

    out
end read_by_address

// The local a writable view is taken inside of. A view of a slice or a string reaches storage the
// local does not hold, so only an array's counts; and a `[]const T` writes nothing, so it lets nothing
// out.
private viewed_root(out: &NameSink, x: TExpr) = *x.kind match
    TSlice(base, _, _, _, slice_ty) -> repr(slice_ty) match
        Slice(_, false) -> repr(texpr_type(base)) match
            Array(_, _) -> add_root(out, base)
            _ -> ()
        _ -> ()
    _ -> ()

// -- the callee: which parameters it keeps a count of its own for ------------------------------------

// The parameters of `f` that it takes a count for at entry and gives back at each return.
//
// A self-jump is checked before anything else, because the count it takes to carry an argument
// across the release of the whole frame has to be one the slot gives back afterwards -- true even of
// a body a borrow would otherwise be sound for. A body that can release nothing keeps the borrow
// whoever entered it, which is what makes it stronger than every condition after it. `inert` is
// whether `f` is one of `inert_callees`', a question about the whole program asked once by the caller.
owning(f: TFunc, addressed: bool, jumps: bool, inert: bool) -> Set[string]
    var every: Set[string] = set()

    for param in f.params
        every.add(param.0)

    if jumps then return every

    if inert then return set()

    if addressed || f.exported.is_some() || f.section.is_some() || f.conv.is_some() then
        return every

    val bound = rebound(f)

    if bound.has(OPAQUE) then return every

    var out: Set[string] = set()

    for param in f.params
        if bound.has(param.0) then out.add(param.0)

    out
end owning

// Every parameter whose own storage a body may have changed, plus `OPAQUE` where something was
// reached that cannot be reasoned about at all: an assignment, a compound one or an increment rooted
// at it, an address taken of it, a `ref` bound to it. **Writing THROUGH a parameter does not
// disqualify it** -- `*p = 1` writes what `p` points at, not the slot -- which is why the walk out of
// a place stops at a dereference.
rebound(f: TFunc) -> Set[string]
    val out = name_sink()
    val v = rebound_walk(out)

    walk_block_stmts(f.body, v)

    for item in f.requires
        walk_texpr(item.cond, v)

    for item in f.ensures
        walk_texpr(item.cond, v)

    for item in f.olds
        walk_texpr(item, v)

    if f.variant.is_some() then walk_texpr(f.variant.unwrap(), v)

    out.names
end rebound

// The same over the body alone, which is what a postcondition repeated at a call site asks
// (`contract_assume.sysl`): the clauses are what is being repeated, and they read the parameters
// rather than rebinding them.
rebound_body(b: TBlock) -> Set[string]
    val out = name_sink()

    walk_block_stmts(b, rebound_walk(out))
    out.names
end rebound_body

private rebound_walk(out: &NameSink) -> &TWalk =
    TWalk(true, x -> rebound_node(out, x), w -> add_root(out, w.place), s -> rebound_stmt(out, s))

private rebound_node(out: &NameSink, x: TExpr) = *x.kind match
    TStore(place, _, _, _) -> add_root(out, place)
    TUpdate(place, _, _, _, _, _, _) -> add_root(out, place)
    TIncDec(place, _, _, _, _) -> add_root(out, place)
    TAddrOf(place, _) -> add_root(out, place)
    _ -> ()

private rebound_stmt(out: &NameSink, s: TStmt) = s match
    TRefDecl(_, _, place) -> add_root(out, place)
    // A block of assembly names its operands' storage directly and says what it does to them in a
    // constraint string, which is not something to parse for this.
    TAsm(_, _, _, _) -> out.add(OPAQUE)
    _ -> ()

// The local whose storage a place reaches, where it reaches one. **It stops at a dereference on
// purpose**: `*p = 1` writes the pointee, and only `p = q` writes the slot. **An element of anything
// but an array is behind a dereference too**: `v[i] = 0` through a view writes the storage the view
// reaches, which the caller's count keeps alive, and leaves the parameter's own slot as it was.
private add_root(out: &NameSink, place: TExpr) -> unit = *place.kind match
    TLoad(name, _) -> out.add(name)
    TField(r, _, _) -> add_root(out, r)
    TIndex(r, _, _) -> underlying(texpr_type(r)) match
        Array(_, _) -> add_root(out, r)
        _ -> ()
    TLane(r, _, _) -> add_root(out, r)
    _ -> ()

// Every function whose address the program takes, which is a caller this side cannot reason about: a
// `*fn` is called under C's convention, so nothing at that call site takes a count for what it hands
// over. Both the definition's name and the entry an address names are in it.
addressed_funcs(p: TProgram) -> Set[string]
    val out = name_sink()
    val v = TWalk(true, x -> addressed_node(out, x), w -> (), s -> ())

    for i in 0..<p.funcs.len()
        val f = p.funcs.at(i)

        walk_block_stmts(f.body, v)

        for item in f.requires
            walk_texpr(item.cond, v)

        for item in f.ensures
            walk_texpr(item.cond, v)

        for item in f.olds
            walk_texpr(item, v)

        if f.variant.is_some() then walk_texpr(f.variant.unwrap(), v)

    for i in 0..<p.vals.len()
        if p.vals.at(i).init.is_some() then walk_texpr(p.vals.at(i).init.unwrap(), v)

    walk_stmts(p.main, v)
    out.names
end addressed_funcs

private addressed_node(out: &NameSink, x: TExpr) = *x.kind match
    TFuncAddr(name, entry, _) ->
        out.add(name)
        out.add(entry)
    _ -> ()

// -- the caller: which locals a call it makes could change under it ----------------------------------

// Every local of a caller whose value a call it makes could change under it, plus `OPAQUE` where
// something was reached that cannot be reasoned about at all. A callee reaches a caller's local only
// through an address the caller let out, so taking one is what puts a name in here -- and a `ref` is
// in for the same reason under a different spelling, the name standing for storage the caller does
// not own.
exposed_in(stmts: Buf[TStmt], result: Option[TExpr], vals: Buf[TVal]) -> Set[string]
    val out = name_sink()
    val v = TWalk(true, x -> exposed_node(out, x), w -> (), s -> exposed_stmt(out, s))

    for i in 0..<vals.len()
        if vals.at(i).init.is_some() then walk_texpr(vals.at(i).init.unwrap(), v)

    walk_stmts(stmts, v)

    if result.is_some() then walk_texpr(result.unwrap(), v)

    out.names
end exposed_in

private exposed_node(out: &NameSink, x: TExpr) = *x.kind match
    TAddrOf(place, _) -> add_root(out, place)
    // A writable view of an array is the array's address under another spelling: handed to a call,
    // it lets the callee write the local though no address of it was taken.
    TSlice(_, _, _, _, _) -> viewed_root(out, x)
    _ -> ()

private exposed_stmt(out: &NameSink, s: TStmt) = s match
    TRefDecl(name, _, place) ->
        out.add(name)
        add_root(out, place)
    TAsm(_, _, _, _) -> out.add(OPAQUE)
    _ -> ()

// What a body that has not said which of its locals a call can reach exposes: everything.
exposed_unknown() -> Set[string]
    var out: Set[string] = set()

    out.add(OPAQUE)
    out
end exposed_unknown

// Whether the caller already holds a count for this argument that outlives the call.
//
// **The default is `false`, which is why this is a list of what is allowed.** Every node here is one
// whose value is either a temporary the enclosing region releases *after* the call, or a slot the
// callee has no way to name; anything else keeps its count somewhere a callee can reach, and guessing
// wrong about a new node is a use-after-free rather than a slow program.
held(e: *Emit, a: TExpr) -> bool = held_unless(e, a, set())

// The same, where the locals in `written` are assigned by something that runs after `a` is worked out
// and before the call is made -- a later argument of the same call (`written_by`). Such a local is
// not still for the length of the call, however private its slot: the write would reach the callee
// through the address a large argument crosses at, or give back the count a small one is read under.
held_unless(e: *Emit, a: TExpr, written: Set[string]) -> bool = *a.kind match
    // A local or parameter the caller never let the address of out.
    TLoad(name, _) ->
        !e.caller_exposed.has(OPAQUE) && !e.caller_exposed.has(name) && !is_promoted(e, name) &&
            !written.has(name)

    // A field of a struct held by value lies in its receiver's own storage, so it is held exactly
    // when the receiver is -- `self.noise` of a `self` read in place is the caller's snapshot. A field
    // reached through a pointer is a `TDeref` below and is not.
    TField(receiver, _, _) -> underlying(texpr_type(receiver)) match
        Struct(_) -> held_unless(e, receiver, written)
        _ -> false

    // A result, a box and a branch's value all arrive with a count already taken, registered in the
    // region the enclosing statement closes -- which is after the call this is an argument to.
    TCall(_, _, _, _) -> true
    TVCall(_, _, _, _, _) -> true
    TCallPtr(_, _, _, _) -> true
    TBox(_, _) -> true
    TIf(_, _, _, _) -> true
    TMatch(_, _, _) -> true
    TBlockExpr(_) -> true

    // A string `+` and a formatted hole each make a new string, registered the same way.
    TBinary(_, _, _, ty) -> underlying(ty) == Str
    TFormat(_, _, _) -> true

    // Building a value takes no count of its own, so what it stands on is what has to be held.
    TStructNew(_, args) -> all_held(e, args, written)
    TEnumNew(_, _, args) -> all_held(e, args, written)

    // Neither changes what is counted or where the count is.
    TCast(o, _) -> held_unless(e, o, written)
    TFloorCast(o, _) -> held_unless(e, o, written)
    TErase(o, _, _) -> held_unless(e, o, written)
    TViewAs(o, _) -> held_unless(e, o, written)

    // A literal owns nothing and outlives everything. A string's is a view whose owner word is null,
    // so there is no count to lose, and taking one would pull the whole runtime into a program whose
    // only reference is the text inside a `print`.
    TIntLit(_, _) -> true
    TFloatLit(_, _) -> true
    TQuadLit(_, _, _) -> true
    TBoolLit(_) -> true
    TUnitLit -> true
    TNullLit(_) -> true
    TZero(_) -> true
    TStrLit(_) -> true
    TEmbed(_, _, _) -> true
    TCStrLit(_) -> true

    _ -> false

// A literal's fields are worked out in order before it is built, so a later field can write a local
// an earlier one names: the written set is the whole literal's, added to what the call's other
// arguments write.
private all_held(e: *Emit, args: Buf[TExpr], written: Set[string]) -> bool
    var all = written_by(args)

    for item in written
        all.add(item)

    for arg in args
        if !held_unless(e, arg, all) then return false

    true
end all_held

// The locals a list of expressions assigns, by name, anywhere inside them: what may change between
// the moment one of them is worked out and the moment the call they are the arguments of is made.
// It over-counts on purpose -- a write in an earlier argument is in it too -- since a name in it only
// costs a snapshot.
written_by(xs: Buf[TExpr]) -> Set[string]
    val out = name_sink()
    val v = rebound_walk(out)

    for x in xs
        if !changes_nothing(x) then walk_texpr(x, v)

    out.names
end written_by
