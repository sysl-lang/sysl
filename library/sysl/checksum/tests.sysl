module sysl.checksum
@tests

import sysl.testing.skip

// What `sysl.checksum` claims. The check value 0xcbf43926 is the one every CRC catalogue publishes
// for CRC-32/ISO-HDLC over "123456789". A wrong initial value or a missing final xor gives a
// different number, so the vector can fail.

@test("crc32 gives the catalogue check value")
crc32_check_value()
    assert_eq(crc32("123456789".bytes), 0xcbf43926)

@test("crc32 of nothing is zero, of one byte is the known value")
crc32_edges()
    assert_eq(crc32("".bytes), 0)
    assert_eq(crc32("a".bytes), 0xe8b7be43)
    assert_eq(crc32("The quick brown fox jumps over the lazy dog".bytes), 0x414fa339)

@test("an incremental crc32 equals the one-shot at every split")
crc32_incremental()
    val s = "123456789".bytes

    for k in 0..s.len
        var c = new_crc32()

        c.update(s[0..<k])
        c.update(s[k..])
        assert_eq(c.finish(), 0xcbf43926)

    var c = new_crc32()

    for i in 0..<s.len
        c.update(s[i..<i + 1])

    assert_eq(c.finish(), 0xcbf43926)

// -- CRC-32C ----------------------------------------------------------------------------------------

// The check value is CRC-32C/ISCSI's in every CRC catalogue; the four 32-byte vectors are RFC 3720
// appendix B.4's. A CRC-32 table, a missing inversion or an unreflected polynomial misses all five.

// 1100 bytes no two neighbours of which agree, so a misplaced read changes the answer.
private chk_pattern() -> [1100]u8
    var d: [1100]u8 = [0; 1100]

    for i in 0..<1100
        d[i] = u8.wrap(i * 31 + 7)

    d

// The definition, one bit at a time: what the slicing tables and the instructions are both held to.
private chk_crc32c_bitwise(data: []const u8) -> u32
    var c = 0xffffffffu32

    for b in data
        c ^= u32(b)

        for _ in 0..<8
            c = if c & 1 == 1 then 0x82f63b78 ^ c >> 1 else c >> 1

    ~c

@test("crc32c gives the catalogue check value and the RFC 3720 vectors")
crc32c_check_values()
    assert_eq(crc32c("123456789".bytes), 0xe3069283)
    assert_eq(crc32c("".bytes), 0)

    var zeros: [32]u8 = [0; 32]
    var ones: [32]u8 = [0xff; 32]
    var up: [32]u8 = [0; 32]
    var down: [32]u8 = [0; 32]

    for i in 0..<32
        up[i] = u8(i)
        down[i] = u8(31 - i)

    assert_eq(crc32c(zeros[..]), 0x8a9136aa)
    assert_eq(crc32c(ones[..]), 0x62a8ab43)
    assert_eq(crc32c(up[..]), 0x46dd794e)
    assert_eq(crc32c(down[..]), 0x113fdb5c)

    // A thousand bytes reaches the eight-at-a-time loop many times over; the value is the bitwise
    // reference's in C.
    val d = chk_pattern()

    assert_eq(crc32c(d[0..<1000]), 0xff52ee97)

@test("crc32c is not crc32: the two polynomials disagree on the same bytes")
crc32c_is_not_crc32()
    assert(crc32c("123456789".bytes) != crc32("123456789".bytes))
    assert_eq(crc32c("a".bytes), chk_crc32c_bitwise("a".bytes))

@test("the slicing tables equal the bit-at-a-time definition at every length and alignment")
crc32c_table_matches_the_definition()
    val d = chk_pattern()

    for off in 0..<16
        for n in 0..301
            val s = d[off..<off + n]

            assert_eq(~crc32c_by_table(0xffffffff, s), chk_crc32c_bitwise(s), s"length $n at offset $off")

@test("the instruction equals the table at every length and alignment")
crc32c_instruction_matches_the_table()
#if crc32c
    val d = chk_pattern()

    for off in 0..<16
        for n in 0..301
            val s = d[off..<off + n]

            assert_eq(crc32c_by_instruction(0xffffffff, s), crc32c_by_table(0xffffffff, s),
                      s"length $n at offset $off")

    // A running remainder that is not the initial one, which a byte-order slip in the word form
    // would get wrong where the all-ones start hides it.
    assert_eq(crc32c_by_instruction(0x12345678, d[3..<203]), crc32c_by_table(0x12345678, d[3..<203]))
#else
    skip("this build promises no CRC-32C instruction ('#if crc32c' is false), so crc32c is the table")
#endif

@test("an incremental crc32c equals the one-shot at every split point, and one byte at a time")
crc32c_incremental()
    val d = chk_pattern()
    val s = d[1..<300]
    val whole = crc32c(s)

    for k in 0..s.len
        var c = new_crc32c()

        c.update(s[0..<k])
        c.update(s[k..])
        assert_eq(c.finish(), whole, s"split at $k")

    var c = new_crc32c()

    for i in 0..<s.len
        c.update(s[i..<i + 1])

    assert_eq(c.finish(), whole)

    // Three pieces, the middle one empty and the boundaries off the eight-byte grid.
    var t = new_crc32c()

    t.update(s[0..<13])
    t.update(s[13..<13])
    t.update(s[13..])
    assert_eq(t.finish(), whole)

@test("a Crc32c copies by value, and finish does not end it")
crc32c_copy_and_finish()
    var a = new_crc32c()

    a.update("1234".bytes)

    var b = a

    assert_eq(a.finish(), crc32c("1234".bytes))
    a.update("56789".bytes)
    b.update("5678".bytes)
    assert_eq(a.finish(), 0xe3069283)
    assert_eq(b.finish(), crc32c("12345678".bytes))
    assert_eq(new_crc32c().finish(), 0)

// -- hash64 -----------------------------------------------------------------------------------------

// Every value below was printed by the reference rapidhash.h (V3, the default compact build) over
// `chk_pattern`'s first n bytes: lengths at and either side of every branch -- 3, 4, 8, 16, the
// 16-byte steps to 112, one and two trips round the 112-byte loop, and a long input.
private chk_lengths() -> [31]usize =
    [0, 1, 2, 3, 4, 7, 8, 9, 15, 16, 17, 31, 32, 33, 48, 49, 64, 65, 80, 81, 96, 97, 112, 113, 128,
     224, 225, 226, 336, 337, 1000]

private chk_seed0() -> [31]u64 =
    [0x0338dc4be2cecdae, 0x5c2caf7d68f06d3e, 0xae51663c7995f8f8, 0x3bd769fd1eeff68b,
     0x94c4e44cba1be502, 0x3402f3bff7d5ef0f, 0xefd148285045d1f3, 0x2f8407ca55d0192d,
     0x94192c8d95e7a5a5, 0x0811971e7cf397ba, 0x6d84939d31572677, 0x8371afa501b0cd07,
     0xba48299a836e97da, 0xaf3a3a115f66dba3, 0xb647c688e65ab5d9, 0xeb24b4c29d6da81e,
     0xecac72effb517b5d, 0x45f05f1baab30c17, 0x533c9fc90f0516dc, 0x0f7545b5c1c5b9c6,
     0xe2fc8588a9bfb097, 0xc343800740e6176b, 0x7fe548224c71702a, 0xdd9a928d4d5f38be,
     0xf0339dece659fbb5, 0xb58fdb872bdb4e42, 0x5e32d5a5f2c4ba73, 0x2fe7931d86795dd2,
     0x2eea149f5778a279, 0x0bba5f54de8f59d2, 0xa43ecd1f34504ec6]

private chk_seeded() -> [31]u64 =
    [0xdf58d06d5407a8a5, 0xecbc5b4c98452244, 0x7d7a63058d6f2d56, 0x4741bffe16b94ee0,
     0x634a821c5ff8148f, 0x760739d3b486b881, 0x46636ca852c1702a, 0xb81dcedb430e5f14,
     0x23af825844dfab90, 0xb9bcabb38fbc1a78, 0xf562b895d1fb38f8, 0x1b64183e02ab4c93,
     0x71278ee12545d8ed, 0xb5f1152c559aec00, 0xb1ad1ad646de3755, 0x9b6e484e21b3d23e,
     0x0e598d84811967ea, 0xb9c8b6166c22a55e, 0xeffa6b7f92cbaa07, 0xd2b4c2b140bd2cc4,
     0x8745dcb4f8ad4ca6, 0xf9866cbe57979850, 0x46dd51f9e4cfb491, 0x26679f92aee2f5d7,
     0xa11fc2c4fe67fbff, 0xfcd16f7080f95bb5, 0xfb93726a6709fead, 0xfa899bf9149c04f3,
     0xb9666ebbfc08bc95, 0x074947773feb7d7d, 0x260cf76ea396ca09]

@test("hash64 is rapidhash V3 bit for bit, at every branch's lengths and two seeds")
hash64_known_answers()
    val d = chk_pattern()
    val lengths = chk_lengths()
    val plain = chk_seed0()
    val seeded = chk_seeded()

    for i in 0..<lengths.len
        val s = d[0..<lengths[i]]

        assert_eq(hash64(s, 0), plain[i], s"length ${lengths[i]}, seed 0")
        assert_eq(hash64(s, 0xdeadbeefcafef00d), seeded[i], s"length ${lengths[i]}, seeded")

    assert_eq(hash64("hello world".bytes), 0x2f27cb27d5240940)

@test("hash64's seed defaults to zero, and every seed is a different function")
hash64_seeds()
    val d = chk_pattern()
    val seeds: [6]u64 = [0, 1, 2, 0x8000000000000000, 0xffffffffffffffff, 0xdeadbeefcafef00d]

    for n in [0usize, 3, 8, 17, 113, 500]
        val s = d[0..<n]

        assert_eq(hash64(s), hash64(s, 0))

        for i in 0..<seeds.len
            for j in i + 1..<seeds.len
                assert(hash64(s, seeds[i]) != hash64(s, seeds[j]), s"length $n, seeds $i and $j")

@test("hash64 reads only its slice: the same bytes hash alike at every alignment")
hash64_alignment()
    var a: [400]u8 = [0; 400]
    var b: [400]u8 = [0xff; 400]
    val d = chk_pattern()

    for n in 0..<300
        val want = hash64(d[0..<n], 7)

        for off in 0..<16
            // Two copies of the same bytes inside different surroundings.
            for i in 0..<n
                a[off + i] = d[i]
                b[off + i] = d[i]

            assert_eq(hash64(a[off..<off + n], 7), want, s"length $n at offset $off")
            assert_eq(hash64(b[off..<off + n], 7), want, s"length $n at offset $off, other neighbours")

@test("hash64 changes when any one bit of the input or the length does")
hash64_every_bit_counts()
    var x: [130]u8 = [0; 130]

    for n in [1usize, 5, 12, 16, 40, 130]
        val base = hash64(x[0..<n], 3)

        for bit in 0..<n * 8
            x[bit / 8] ^= u8(1) << u8(bit % 8)
            assert(hash64(x[0..<n], 3) != base, s"length $n, bit $bit")
            x[bit / 8] ^= u8(1) << u8(bit % 8)

        // A trailing zero byte is not nothing.
        assert(hash64(x[0..<n], 3) != hash64(x[0..<n - 1], 3), s"length $n against one shorter")
