module sysl

// The only declarations in the library that are not sysl.
//
// All but one take a link name, so `putchar`, `snprintf`, `read` and `memchr` stay free for a
// program to declare itself: a symbol's spelling belongs to whoever exported it, and spending those
// four words out of every program's namespace would buy nothing. `exit` is deliberately not one of
// those. It is the library's offer of the hosted exit -- what `unwrap` and `expect` stop the program
// with, a diagnostic printed and a non-zero status, which is what `11-error-handling.md` says a trap
// does under the `os` capability -- and it is the reason those two need no compiler support.
//
// An extern's *symbol* is not qualified and cannot be, since it names something the linker already
// has and the linker knows nothing about sysl's modules. So these are keyed under `sysl` like every
// other name here while going on resolving to `exit`, `putchar` and the rest.
extern exit(code: int) -> never
extern "putchar" sysl_putchar(c: int) -> int
extern "snprintf" sysl_snprintf(buf: *u8, n: usize, fmt: *u8, ...) -> int
extern "read" sysl_read(fd: int, p: *u8, n: usize) -> isize
extern "memchr" sysl_memchr(p: *u8, c: int, n: usize) -> *u8
