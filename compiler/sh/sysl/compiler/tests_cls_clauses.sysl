@test("clauses recurse, and call each other")
cls_recursion()
    if !cls_runnable() then return

    cls_prints(raw"""
        fact(n: int) -> int
        fact(0) = 1
        fact(n) = n * fact(n - 1)

        is_even(n: int) -> bool
        is_even(0) = true
        is_even(n) = is_odd(n - 1)

        is_odd(n: int) -> bool
        is_odd(0) = false
        is_odd(n) = is_even(n - 1)

        main()
            print(fact(5), is_even(10), is_odd(7), is_even(3))
        """, "120 true true false\n")

// The self call in the last clause is in tail position, so it is the jump back to the top of the
// function: no call of the function is left in its own body, and three million turns take no stack.
@test("a self call in tail position in a clause stays a jump")
cls_tail_call()
    if !cls_runnable() then return

    val program = raw"""
        count(n: int, acc: int) -> int
        count(0, acc) = acc
        count(n, acc) = count(n - 1, acc + 1)

        main()
            print(count(3000000, 0))
        """
    val ir = cls_report(program)
    val at = ir.index_of("define i32 @count$$sysl(")

    assert(at.is_some(), s"expected count's definition, got: $ir")

    val body = ir[at.unwrap()..<ir.len]
    val end_at = body.index_of("\n}\n").unwrap_or(body.len)
    val own = body[0..<end_at]

    assert(own.index_of("tailrec").is_some(), s"expected the jump back, got: $own")
    assert(own.index_of("call i32 @count$$sysl").is_none(), s"expected no self call, got: $own")
    cls_prints(program, "3000000\n")

// `match` takes a `&T` apart only as what it holds (`*t match`), so a clause's patterns on a `&T`
// parameter are read against what it holds -- in place, with no copy of the referent. A name that
// only binds the parameter binds the reference.
@test("a '&T' parameter is taken apart as what it holds")
cls_reference_parameter()
    if !cls_runnable() then return

    cls_prints(raw"""
        enum Tree
            Leaf
            Node(left: &Tree, v: int, right: &Tree)

        sum(t: &Tree) -> int
        sum(Leaf) = 0
        sum(Node(l, v, r)) = sum(l) + v + sum(r)

        main()
            print(sum(Node(Node(Leaf, 1, Leaf), 2, Node(Leaf, 3, Leaf))))
        """, "6\n")

@test("a 'Drop' value held by a '&T' argument is dropped once, and nothing leaks")
cls_drop_argument()
    if !cls_runnable() then return

    cls_prints(raw"""
        struct Res
            id: int

        impl Drop for Res
            drop(self) = print("drop", self.id)

        enum Msg
            Quit
            Hold(r: &Res)

        look(m: &Msg, n: int) -> int
        look(Quit, _) = 0
        look(Hold(r), 0) = r.id
        look(Hold(r), n) | n > 5 = r.id * 100
        look(Hold(_), n) = n

        own(r: &Res, k: int) -> int
        own(r, 0) = r.id
        own(other, k) = other.id + k

        main()
            val m = Hold(Res(7))
            print(look(m, 0), look(m, 9), look(m, 2), look(Quit, 1))
            val r = Res(3)
            print(own(r, 0), own(r, 4))
        """, "7 700 2 0\n3 7\ndrop 3\ndrop 7\n")

