module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.container.{Map, map}
import sysl.math.bigint.from_int

// **The method tables trait objects dispatch through.**
//
// A table is a constant array of function pointers, one per method the trait declares, and every
// entry has the same shape: the object's data word first, then the method's own parameters. That
// uniformity is what lets a call site load a slot and call it knowing only the trait.
//
// Keeping it uniform is what the adapters here are for. An implementation may want its receiver by
// value, behind a pointer, or behind a reference, and the data word addresses the value itself in a
// raw object but the reference-counted box in a counted one -- so between the word a call site has
// and the receiver an implementation declared there may be a header to step over and a value to
// load. Where the two already agree, the implementation goes into the slot directly.

// One table's constant, with whatever adapters its slots need queued for emission.
//
// **The type's identity is the first word, and the slots follow it.** That is what an erased value
// carries `o::Id` in: the object's first word is this table's address, so one load answers a question
// the value itself has forgotten. It costs a word per table -- one per trait, implementing type and
// memory mode -- and nothing per value.
//
// The layout is a struct rather than a longer array of pointers with an `inttoptr` in front, because
// that is what is actually there: a word and then function pointers.
gen_vtable(e: *Emit, vt: TVtable) -> IrGlobal
    var entries: Buf[IrArg] = buf()

    for item in vt.slots
        entries.push(ir_arg(LPtr, VGlobal(slot_fn(e, vt, item))))

    val slots = LArr(int(vt.slots.len()), LPtr)

    var fields: Buf[IrArg] = buf()

    fields.push(ir_arg(word_lty(e), VInt(vt.type_id)))
    fields.push(ir_arg(slots, VArray(entries)))

    var shape: Buf[LType] = buf()

    shape.push(word_lty(e))
    shape.push(slots)
    ir_global(vt.name, true, LStruct(shape), VAgg(fields))
end gen_vtable

// The function a slot holds: the implementation itself where its receiver already *is* the data word
// -- a `*self` method reached through a raw object, a `&self` method reached through a counted one, a
// `self` method whose body this module emitted to take its receiver at the word (`split_self`) -- and
// an adapter for everything else.
//
// **A `@track_caller` member always goes through the adapter**, which hands it the location of its
// own declaration: a call through a table names no function, so it has no line to hand on
// (`track_caller.sysl`).
private slot_fn(e: *Emit, vt: TVtable, slot: TVSlot) -> string
    if e.tracked.has(slot.target)
        val name = s"vt.adapt.${if vt.boxed then "ref." else ""}${slot.target}"

        return request_helper(e, name, HrAdapter(vt, slot))
    end if

    slot.recv match
        ByPtr -> if !vt.boxed then return symbol_of(e, slot.target)
        ByRef(_) -> if vt.boxed then return symbol_of(e, slot.target)
        ByValue ->
            e.self_entries.get(slot.target) match
                Some(boxed) -> if boxed == vt.boxed then return self_symbol(symbol_of(e, slot.target))
                None -> ()

    val name = s"vt.adapt.${if vt.boxed then "ref." else ""}${slot.target}"

    request_helper(e, name, HrAdapter(vt, slot))
end slot_fn

// -- a `self` method whose body takes its receiver at the table's word ------------------------------

// **A `self` method a table reaches is emitted with its body taking the receiver as the table's data
// word**, so the slot holds the body itself rather than an adapter that loads the receiver out of the
// object and calls the method a second time. That second call is not a tail call wherever the result
// is a register aggregate the back end returns through memory, so it costs a frame, the call, and a
// copy of the result into the caller's storage on every dispatch.
//
// The method keeps its own symbol and signature, so every direct call, function value and separately
// compiled caller reaches it exactly as before; under that symbol it is now a few instructions that
// put the receiver in storage shaped like the object and call the body. The body loads the receiver
// out of the object **once, at entry** -- the snapshot the adapter took -- and reads its copy from then
// on, so nothing a call inside it does to the object can change what it sees.
//
// One body serves one kind of table: a counted object's, whose word addresses the box and whose body
// steps over the header, wherever the module builds one (`self_forms`); a raw object's, whose word is
// the value's own address, otherwise. A table of the other kind keeps its adapter.

// The symbol a split method's body is emitted under.
self_symbol(symbol: string) -> string = s"$symbol.self"

// Each method some table of the program reaches with a `self` receiver that is passed in registers,
// and whether the body is to step over a counted object's header: a counted table wins over a raw one.
//
// A zero-sized receiver is no parameter at all, and a large one already arrives as an address the
// adapter forwards untouched, so neither is split. The object's type rides along, so the body is only
// split where its receiver is that type.
self_forms(e: *Emit, p: TProgram) -> Map[string, (bool, string)]
    var out: Map[string, (bool, string)] = map()

    for i in 0..<p.vtables.len()
        val vt = p.vtables.at(i)

        if zero_sized(vt.for_type) || e.layout.indirect(vt.for_type) then continue

        for slot in vt.slots
            val by_value = slot.recv match
                ByValue -> true
                _ -> false

            if by_value && (vt.boxed || out.get(slot.target).is_none()) then
                out.put(slot.target, (vt.boxed, mangle(vt.for_type)))

    out
end self_forms

// The functions a defined body is emitted as: itself, or -- for a method `self_forms` names -- the
// method under its own symbol and the body under `self_symbol`, recorded in `e.self_entries`.
//
// What is never split: a body something outside sysl's convention enters (`@export`, a `@section`, a
// foreign convention, a C-variadic one), a task, a function emitted as halves already (a split
// one's entry and body -- owning a parameter or lent one -- and a `@disjoint` one's), a definition the link may displace, and a receiver the
// signature does not carry as one register aggregate.
split_self(e: *Emit, f: TFunc, built: IrFunc, forms: Map[string, (bool, string)]) -> Buf[IrFunc]
    var out: Buf[IrFunc] = buf()
    val form = forms.get(f.name)

    if form.is_some() && !f.params.is_empty() && e.lent_params.has(owned_key(f.name, 0)) &&
       !e.owning_funcs.has(f.name) && f.marks.disjoint.is_empty() && !displaceable(built.sig.linkage) &&
       mangle(f.params.at(0).1) == form.unwrap().1 && built.sig.name == owned_symbol(symbol_of(e, f.name)) then
        out.push(built)
        out.push(lent_self(e, f, built.sig, form.unwrap().0))
        return out
    end if

    if form.is_none() || f.params.is_empty() || f.marks.is_async() || f.variadic ||
       f.exported.is_some() || f.section.is_some() || f.conv.is_some() || built.sig.cconv.is_some() ||
       !f.marks.disjoint.is_empty() || e.split_funcs.has(f.name) || displaceable(built.sig.linkage) ||
       mangle(f.params.at(0).1) != form.unwrap().1
        out.push(built)
        return out
    end if

    val boxed = form.unwrap().0
    val recv = f.params.at(0)
    val ty = recv.1
    val param = s"${recv.0}.param"
    val object = VReg(s"${recv.0}.object")
    val payload = if boxed then VReg(s"${recv.0}.payload") else object
    val sig = built.sig
    val body_name = self_symbol(sig.name)

    var found = false
    var body_params: Buf[IrParam] = buf()
    var args: Buf[IrArg] = buf()

    for p in sig.ty.params
        if !found && names_reg(p.name, param)
            found = true
            body_params.push(IrParam(LPtr, no_ir_attrs(), Some(object)))
            args.push(ir_arg(LPtr, object))
        else
            body_params.push(p)
            args.push(IrArg(p.ty, p.name.unwrap_or(VUndef), p.attrs))

    if zero_sized(ty) || e.layout.indirect(ty) || !found
        out.push(built)
        return out
    end if

    val shape = if boxed then box_lty(e, ty) else lty(e, ty)
    var step: Buf[IrArg] = buf()

    step.push(ir_arg(l_i32(), VInt(from_int(0))))
    step.push(ir_arg(l_i32(), VInt(from_int(long(box_payload_field(e, ty))))))

    // The body: the method as it was emitted, its receiver loaded out of the object ahead of
    // everything its entry block does.
    var blocks: Buf[IrBlock] = buf()

    for i in 0..<built.blocks.len()
        val b = built.blocks.at(i)

        if i == 0
            var instrs: Buf[Inst] = buf()

            if boxed then instrs.push(InGep(payload, shape, object, step))

            instrs.push(InLoad(VReg(param), lty(e, ty), payload, AccPlain, None))

            for item in b.instrs
                instrs.push(item)

            blocks.push(IrBlock(b.label, instrs, b.terminator))
        else
            blocks.push(b)

    val body_sig = sig with { name = body_name, ty = IrFnType(sig.ty.ret, body_params, false, sig.ty.ret_attrs),
                              linkage = LinkInternal, section = None, dso_local = false, hidden = false }

    // The method: the receiver stored where the body expects the object, and the body called.
    var entry: Buf[Inst] = buf()

    entry.push(InAlloca(object, shape, None))

    if boxed then entry.push(InGep(payload, shape, object, step))

    entry.push(InStore(lty(e, ty), VReg(param), payload, AccPlain, None))

    val nothing = sig.ty.ret match
        LVoid -> true
        _ -> false

    val result = if nothing then None else Some(VReg("self.result"))
    var fast: Buf[FastMath] = buf()

    entry.push(InCall(result, sig.ty.ret, VGlobal(body_name), args, sig.ty.ret_attrs, None, fast, false))

    val ret = if nothing then InRet(None, None) else InRet(Some(sig.ty.ret), result)
    var bare: Buf[string] = buf()
    var entry_blocks: Buf[IrBlock] = buf()

    entry_blocks.push(IrBlock("entry", entry, Some(ret)))
    e.self_entries.put(f.name, boxed)
    out.push(IrFunc(sig with { bare = bare }, entry_blocks))
    out.push(IrFunc(body_sig, blocks))
    out
end split_self

// The body a table reaches for a method whose receiver is lent by address (`read_by_address`): the
// receiver's bytes copied out of the object into a slot of its own -- the snapshot a by-value `self`
// promises, since the object is anybody's to change while the method runs -- and the method's own
// body, which reads in place, lent that slot. It takes the table's word, as a split method's body
// does, so the table calls it with no adapter loading the value first.
private lent_self(e: *Emit, f: TFunc, body: IrFuncSig, boxed: bool) -> IrFunc
    val recv = f.params.at(0)
    val ty = recv.1
    val param = s"${recv.0}.param"
    val object = VReg(s"${recv.0}.object")
    val payload = if boxed then VReg(s"${recv.0}.payload") else object
    val slot = VReg(s"${recv.0}.lent")
    val shape = if boxed then box_lty(e, ty) else lty(e, ty)
    val value = VReg(s"${recv.0}.value")

    // **Every other parameter the body is lent arrives from the table as the value it crosses as**, the
    // way the method's own entry takes it, and is lent a slot of this function's own.
    var others: Map[string, (Type, string)] = map()

    for j in 1..<f.params.len()
        val q = f.params.at(j)

        if e.lent_params.has(owned_key(f.name, j)) then others.put(s"${q.0}.param", (q.1, s"${q.0}.lent"))

    var params: Buf[IrParam] = buf()
    var args: Buf[IrArg] = buf()
    var lends: Buf[Inst] = buf()

    for p in body.ty.params
        val other = p.name match
            Some(VReg(n)) -> others.get(n)
            _ -> None

        if names_reg(p.name, param)
            params.push(IrParam(LPtr, no_ir_attrs(), Some(object)))
            args.push(ir_arg(LPtr, slot))
        else if other.is_some()
            val shape_of = lty(e, other.unwrap().0)
            val at = VReg(other.unwrap().1)

            params.push(IrParam(shape_of, no_ir_attrs(), p.name))
            lends.push(InAlloca(at, shape_of, None))
            lends.push(InStore(shape_of, p.name.unwrap_or(VUndef), at, AccPlain, None))
            args.push(ir_arg(LPtr, at))
        else
            params.push(p)
            args.push(IrArg(p.ty, p.name.unwrap_or(VUndef), p.attrs))
        end if
    end for

    var instrs: Buf[Inst] = buf()

    for item in lends
        instrs.push(item)
    var step: Buf[IrArg] = buf()

    step.push(ir_arg(l_i32(), VInt(from_int(0))))
    step.push(ir_arg(l_i32(), VInt(from_int(long(box_payload_field(e, ty))))))

    if boxed then instrs.push(InGep(payload, shape, object, step))

    instrs.push(InAlloca(slot, lty(e, ty), None))
    instrs.push(InLoad(value, lty(e, ty), payload, AccPlain, None))
    instrs.push(InStore(lty(e, ty), value, slot, AccPlain, None))

    val nothing = body.ty.ret match
        LVoid -> true
        _ -> false

    val result = if nothing then None else Some(VReg("self.result"))
    var fast: Buf[FastMath] = buf()

    instrs.push(InCall(result, body.ty.ret, VGlobal(body.name), args, body.ty.ret_attrs, None, fast, false))

    val ret = if nothing then InRet(None, None) else InRet(Some(body.ty.ret), result)
    var blocks: Buf[IrBlock] = buf()

    blocks.push(IrBlock("entry", instrs, Some(ret)))
    e.self_entries.put(f.name, boxed)

    val sig = body with { name = self_symbol(symbol_of(e, f.name)), ty = IrFnType(body.ty.ret, params, false, body.ty.ret_attrs),
                          linkage = LinkInternal, section = None, dso_local = false, hidden = false, bare = buf() }

    IrFunc(sig, blocks)
end lent_self

// Whether the definition may not be the one the link keeps -- a `weak` seam another definition
// displaces, a copy of a body defined elsewhere -- so a table has to reach it through its symbol.
private displaceable(l: IrLinkage) -> bool = l match
    LinkWeak -> true
    LinkAvailableExternally -> true
    LinkExternal -> true
    _ -> false

// Whether a parameter arrives in the register named.
private names_reg(name: Option[Val], reg: string) -> bool = name match
    Some(VReg(r)) -> r == reg
    _ -> false

// The adapter's signature. It carries the extension a narrow result owes whoever called through the
// table; a large result is written into the caller's storage, so the adapter neither receives it in a
// register nor returns one -- it forwards the out-pointer it was handed and returns nothing.
//
// **A zero-sized parameter is not in the implementation's signature, so it is not in the adapter's
// either** -- the two have to agree, and the argument was never a word to forward.
adapter_sig(e: *Emit, name: string, slot: TVSlot) -> IrFuncSig
    var ps: Buf[IrParam] = buf()

    sysl_sret(e, slot.ret_ty, Some(sret_param())) match
        // The adapter's own out-pointer is the table's caller's storage, so it is declared exactly
        // as that caller made it, `noalias` and all; only where it is FORWARDED is the `noalias`
        // dropped (`sret_forward_attrs`).
        Some(p) -> ps.push(IrParam(LPtr, p.attrs, Some(sret_param())))
        None -> ()

    ps.push(IrParam(LPtr, no_ir_attrs(), Some(VReg("d"))))

    for i in 0..<slot.params.len()
        if !zero_sized(slot.params.at(i))
            ps.push(IrParam(sysl_param_lty(e, slot.params.at(i)), no_ir_attrs(),
                            Some(VReg(s"a$i"))))

    var attrs: Buf[(string, string)] = buf()

    IrFuncSig(name, IrFnType(sysl_result_lty(e, slot.ret_ty), ps, false,
                             adapter_ret_attrs(e, slot.ret_ty)),
              LinkPrivate, None, attrs, None, buf(), false, false)
end adapter_sig

// The out-pointer's attributes, less the `noalias` only a caller that made the storage may claim: the
// adapter did not create it and cannot promise nothing else addresses it.
private sret_forward_attrs(attrs: Buf[IrAttr]) -> Buf[IrAttr]
    var out: Buf[IrAttr] = buf()

    for attr in attrs
        attr match
            AttrNoAlias -> ()
            other -> out.push(other)

    out
end sret_forward_attrs

private adapter_ret_attrs(e: *Emit, ret_ty: Type) -> Buf[IrAttr] =
    if e.layout.indirect(ret_ty) || no_value(ret_ty) then no_ir_attrs()
    else c_extension(ret_ty, e.target)

// The adapter's body: step over the header where the object is counted, bring the receiver to the
// shape the implementation declared, and forward everything else untouched.
gen_adapter(e: *Emit, vt: TVtable, slot: TVSlot)
    val payload = if !vt.boxed then VReg("d") else
        val p = fresh_reg(e)

        var idx: Buf[IrArg] = buf()

        idx.push(ir_arg(l_i32(), VInt(from_int(0))))
        idx.push(ir_arg(l_i32(), VInt(from_int(long(box_payload_field(e, vt.for_type))))))
        emit(e, InGep(p, box_lty(e, vt.for_type), VReg("d"), idx))
        p

    // The receiver is *borrowed* here, not owned: the implementation retains its parameters on entry
    // and releases them on return, so handing it a value loaded out of the object leaves the object's
    // own count exactly where it was.
    val staged = adapter_snapshot(e, vt, slot, payload)

    // A zero-sized receiver taken by value -- `unit`'s -- has no parameter in the implementation's
    // signature, so there is nothing to load and nothing to pass.
    val recv: Option[IrArg] = slot.recv match
        // A large receiver is passed at its address like any other large argument.
        ByValue ->
            if zero_sized(vt.for_type) then None
            else if e.layout.indirect(vt.for_type) then Some(ir_arg(LPtr, staged.unwrap_or(payload)))
            else
                val v = fresh_reg(e)

                emit(e, InLoad(v, lty(e, vt.for_type), payload, AccPlain, None))
                Some(ir_arg(lty(e, vt.for_type), v))
        ByPtr -> Some(ir_arg(LPtr, payload))

        // A `&self` method on a raw object is refused where the object's type is formed, and on a
        // counted one the implementation is named directly, so no adapter is ever built for it --
        // unless it is `@track_caller`, whose adapter hands on the counted object's own word.
        ByRef(_) ->
            if vt.boxed && e.tracked.has(slot.target) then Some(ir_arg(LPtr, VReg("d")))
            else
                gap_here(e, "an adapter for a '&self' method")
                Some(ir_arg(LPtr, payload))

    var call: Buf[IrArg] = buf()

    sysl_sret(e, slot.ret_ty, None) match
        Some(p) -> call.push(IrArg(LPtr, sret_param(), sret_forward_attrs(p.attrs)))
        None -> ()

    if recv.is_some() then call.push(recv.unwrap())

    for i in 0..<slot.params.len()
        if !zero_sized(slot.params.at(i))
            call.push(ir_arg(sysl_param_lty(e, slot.params.at(i)), VReg(s"a$i")))

    // A tracked member is handed the location of its own declaration (`track_caller.sysl`).
    if e.tracked.has(slot.target)
        val t = e.tracked.get(slot.target).unwrap()

        call.push(ir_arg(LPtr, if bounds_locations() && t.at != "" then c_text_of(e, t.at) else VNull))
    end if

    val target = VGlobal(symbol_of(e, slot.target))

    if no_value(slot.ret_ty) || e.layout.indirect(slot.ret_ty)
        emit(e, ir_call(None, LVoid, target, call))

        if staged.is_some() then release_at(e, vt.for_type, staged.unwrap())

        emit_term(e, InRet(None, None))
        return
    end if

    val r = fresh_reg(e)

    emit(e, InCall(Some(r), lty(e, slot.ret_ty), target, call, c_extension(slot.ret_ty, e.target),
                   None, no_fast_math(), false))

    if staged.is_some() then release_at(e, vt.for_type, staged.unwrap())

    emit_term(e, InRet(Some(sysl_result_lty(e, slot.ret_ty)), Some(r)))
end gen_adapter

// A large receiver the implementation reads in place (`reads_in_place`) is the object itself unless
// a copy is made here, and the object is storage the call may change -- so the adapter stages the
// snapshot a caller would have, holding what it refers to for the length of the call.
private adapter_snapshot(e: *Emit, vt: TVtable, slot: TVSlot, payload: Val) -> Option[Val]
    val by_value = slot.recv match
        ByValue -> true
        _ -> false

    if !by_value || !e.layout.indirect(vt.for_type) || !e.in_place_receivers.has(slot.target) then
        return None

    val copy = alloca(e, fresh_reg(e), lty(e, vt.for_type))

    emit_memcpy(e, copy, payload, int(e.layout.size(vt.for_type)), int(e.layout.claim(vt.for_type)))
    retain_at(e, vt.for_type, copy)
    Some(copy)
end adapter_snapshot

// -- what a body does with a table ------------------------------------------------------------------

// **Erasing costs one word**: the value goes on pointing where it pointed, and the table for the type
// it is losing is a constant beside it. Nothing is retained -- a counted object holds the count its
// operand already had, which is what makes `f(&T)` and `f(&Trait)` the same handover.
gen_erase(e: *Emit, operand: TExpr, vtable: string) -> Val
    val d = gen_expr(e, operand)
    val a = fresh_reg(e)

    emit(e, InInsert(a, l_fat(), VUndef, LPtr, VGlobal(vtable), index_list(0)))

    val b = fresh_reg(e)

    emit(e, InInsert(b, l_fat(), a, LPtr, d, index_list(1)))
    b
end gen_erase

// A call whose callee is a word in the object's table rather than a name. The data word goes in front
// of the declared arguments, which is the shape every slot was built to.
//
// The receiver is borrowed from wherever it is held, which is sound while nothing lets go of it
// before the call is made. An argument that assigns the receiver's local does exactly that, so there
// the object is held by a count of the call's own (`held_unless`).
gen_vcall(e: *Emit, receiver: TExpr, slot: int, args: Buf[TExpr], ty: Type) -> Val
    val written = written_by(args)
    val obj = gen_expr(e, receiver)
    val rty = texpr_type(receiver)

    if contains_counted(rty) && held(e, receiver) && !held_unless(e, receiver, written)
        retain_value(e, rty, obj)
        own_temp(e, obj, rty)
    end if

    val table = fresh_reg(e)

    emit(e, InExtract(table, l_fat(), obj, index_list(0)))

    val data = fresh_reg(e)

    emit(e, InExtract(data, l_fat(), obj, index_list(1)))

    var arg_vals: Buf[IrArg] = buf()

    for arg in args
        arg_value(e, arg, &arg_vals, written)

    val fn = vtable_entry(e, table, slot)

    var all: Buf[IrArg] = buf()

    all.push(ir_arg(LPtr, data))

    for arg_val in arg_vals
        all.push(arg_val)

    gen_sysl_call(e, fn, all, ty)
end gen_vcall

// The function one slot of a table holds, loaded. The indexing type has **no** entries in it: a table
// is as long as its trait and a call site knows only which slot it wants.
vtable_entry(e: *Emit, table: Val, slot: int) -> Val
    val entry = fresh_reg(e)

    var idx: Buf[IrArg] = buf()

    idx.push(ir_arg(l_i32(), VInt(from_int(0))))
    idx.push(ir_arg(l_i32(), VInt(from_int(1))))
    idx.push(ir_arg(word_lty(e), VInt(from_int(long(slot)))))
    emit(e, InGep(entry, vtable_lty(e), table, idx))

    val fn = fresh_reg(e)

    emit(e, InLoad(fn, LPtr, entry, AccPlain, None))
    fn
end vtable_entry

// The shape a call site reaches a slot through: the identity word and the slots after it.
vtable_lty(e: *Emit) -> LType
    var fields: Buf[LType] = buf()

    fields.push(word_lty(e))
    fields.push(LArr(0, LPtr))
    LStruct(fields)
end vtable_lty
