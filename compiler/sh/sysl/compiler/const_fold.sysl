module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.math.bigint.{BigInt, add, cmp, div_rem, from_int, mul, negate, pow, sub, to_string,
                         and as big_and, or as big_or, xor as big_xor, not as big_not,
                         from_real as big_of_real, to_real as big_to_real, zero as big_zero,
                         bit_length as big_bits, shl as big_shl, shr as big_shr,
                         is_odd as big_odd, from_u64, to_u64}
import sysl.math.Float

// What an expression comes to while compiling, where it comes to anything.
//
// **Two positions in the language need this and neither of them is an optimization**: an array's
// bound is part of its type, and a vector's lane index is part of the instruction that reads it. So
// a count that does not fold is a mistake to report rather than a value to compute later, which is
// why the answer is an `Option` and not a best effort.

// A value settled while compiling.
enum Const
    ConstInt(value: BigInt)
    ConstBool(value: bool)
    ConstChar(value: char)
    ConstStr(value: string)
    ConstFloat(value: real)
    // An `f128`, as its encoding's two words: a `real` holds 53 of its 113 bits.
    ConstQuad(hi: u64, lo: u64)
    // A fixed array's elements, in order. Only a `const` function's evaluation makes one, and it is
    // laid down as the array literal it comes to; nothing folds an expression to one.
    ConstArray(elems: Buf[Const])
    // A struct's fields in declaration order (`variant` -1), or an enum value: the position of its
    // variant among the declaration's, and the fields that variant carries. Made, like an array, only
    // by a `const` function's evaluation.
    ConstRecord(variant: int, fields: Buf[Const])
    // A slice: `n` elements from `lo` of a buffer an array's value holds, shared with it, so a write
    // through either is seen through the other. `owner` is the depth of the call whose local the
    // elements are, or -1 where they outlive every call -- a module `val`'s, or a string's bytes.
    // Made only by a `const` function's evaluation, and never laid down.
    ConstView(elems: Buf[Const], lo: usize, n: usize, owner: int)
    // The `*Writer` a value renders itself into: the `sink`th buffer of the evaluation running the
    // `Display` that was handed it. Made only by that evaluation, and never laid down.
    ConstWriter(sink: int)
    // An address the linker fills in: of module storage or a place inside it at an index that came
    // to a number (`TAddrOf` over the folded place), or of a function (`TFuncAddr`). It is handed
    // on, stored and laid down as the relocation it is; nothing reads through it, compares it,
    // converts it to a number or calls it while compiling, since what it points at exists only when
    // the program runs. Made only by a `const` function's evaluation.
    ConstLink(image: TExpr)
    // An address of storage the evaluation owns: slot `at` of a buffer of values -- a box's one
    // value, an array's or a slice's elements, a struct's fields, or a local's cell -- shared with
    // whatever else holds that buffer, so a write through it is seen there. It stands for a `&T`, a
    // `*T` and a `&sync T` alike, the evaluator keeping no counts. `owner` is the depth of the call
    // whose local the slot is, or -1 for the heap, as a slice's is. Made only by an evaluation.
    ConstPtr(cells: Buf[Const], at: usize, owner: int)
    // A slot of storage `slot_storage` made that nothing has placed a value in yet: the bytes the
    // program would find there are whatever the allocator left, so reading one is refused.
    ConstUnset
    // An address the run owns, converted to a pointer to another type: it may be compared and
    // converted back to the type it was taken at, `as_was`, but what it points at is a value of that
    // type, so reading or writing through it is refused.
    ConstPun(addr: &Const, as_was: &Type)
    // A trait object -- a closure's `&Fn` among them: the value behind it, `data` (a pointer to its
    // box, or the pointer a `*Trait` was made of), and the table its calls go through, by name.
    ConstErased(vtable: string, data: &Const)
end Const

// The integer an expression comes to, where it comes to one.
const_int(cx: &Analyzer, e: Expr) -> Option[BigInt] = const_fold(cx, e) match
    Some(v) -> v match
        ConstInt(n) -> Some(n)
        _ -> None
    None -> None

// What an expression comes to while compiling.
const_fold(cx: &Analyzer, e: Expr) -> Option[Const] = *e.kind match
    IntLit(digits, base, _) -> Some(ConstInt(literal_value(digits, base)))
    BoolLit(v) -> Some(ConstBool(v))
    CharLit(c) -> Some(ConstChar(c))
    StrLit(s) -> Some(ConstStr(s))
    FloatLit(text, _) -> Some(ConstFloat(real_of_bits(double_bits(text))))

    // A **value parameter** is asked before a declared constant, and shadows one of the same name
    // for the same reason a type parameter shadows a type: the nearer binding is the one written
    // where the name is. During the walk that checks a generic body there is no argument bound yet,
    // so the name simply is not in the substitution and falls through -- which a caller reads as
    // awaiting instantiation, exactly as it already does for `sizeof(T)`.
    //
    // A declared constant folds to what it was written equal to, read in its own file's terms.
    //
    // `__NAME__` and `__VERSION__` are facts about the package the constant was written in, settled
    // before a line is read, so they fold -- refused here in the words a use outside a constant is
    // refused in. In a default argument each is the calling package's, as `builtin` answers it.
    Ident(name) ->
        if name == "__NAME__" || name == "__VERSION__"
            return manifest_builtin(call_site(cx, e.span).pkg, name) match
                Err(why) -> refuse(cx, e.span, why)
                Ok(value) -> Some(ConstStr(value))

        // A local `const` is nearer than anything else of the name, and folds to what it came to.
        val local = cx.lookup(name)

        if local.is_some() && cx.const_local(local.unwrap().unique).is_some() then
            return cx.const_local(local.unwrap().unique).unwrap().1

        val bound = const_arg_bound(cx.subst, name)

        if bound.is_some() then return bound

        val named = const_of_name(cx, name)

        // `infinity` and `nan` written bare are the built-in constants wherever nothing nearer
        // has the name -- which is the same question `name_expr` answers, asked of the same tables.
        if named.is_none() && builtin_float_reached(cx, name) then
            return Some(ConstFloat(builtin_float(name).unwrap()))

        named

    // `A.len` -- how many types a **pack** stands for, which is a compile-time integer and folds as
    // one. It is here as well as in the analyzer because the range of a `for const` is read *before*
    // anything is analyzed: the loop has to know how many copies to make before it can make one.
    //
    // A module-qualified constant -- `c.limit` -- is the other thing this shape is. A `const` is
    // registered under its dotted path, so the same declaration is a constant whether it was
    // imported unqualified or reached through its module.
    Field(receiver, name, _) ->
        val packed = pack_length(cx.subst, receiver, name)

        if packed.is_some() then return packed

        // `P::Fields.len`, `P::Fields[1].name`.
        if reflects(receiver) then return reflected(cx, e)

        // `f.name`, `c.index` -- read off the descriptor a `for const` copy stands at.
        if names_descriptor(cx.subst, receiver) then return const_call(cx, e)

        val dotted = dotted_name(cx, receiver, name).and_then(n -> const_of_name(cx, n))

        if dotted.is_some() then return dotted

        // A field of what a call answers is run with the call (`const_eval.sysl`).
        if mentions_const_call(cx.an, receiver) then return const_call(cx, e)

        // `real.infinity`, `f32.nan` -- read off the float type they are of, exactly as the
        // analyzer reads them (`bare_type_member`).
        if builtin_float(name).is_none() then return None

        subject_named(cx, receiver) match
            Some(Floating(_, _)) -> Some(ConstFloat(builtin_float(name).unwrap()))
            _ -> None

    Unary(op, operand) -> const_unary(cx, op, operand)
    Binary(op, l, r) -> const_binary(cx, e.span, op, l, r)
    // A comparison that asks about a type's make-up -- `T::Kind == Kind.Struct`, where the enum value
    // on the right is no constant the fold holds -- is typed and run whole.
    Compare(operands, ops) ->
        if operands.len() == 2 && ops.len() == 1 then
            if reflects(operands.at(0)) || reflects(operands.at(1)) then reflected(cx, e)
            else const_binary(cx, e.span, ops.at(0), operands.at(0), operands.at(1))
        else
            None

    // `T::Fields[1]` and `primes_below(10)[0]` -- an element of what a call or a type's make-up
    // answers, run with it.
    Index(receiver, _, _) ->
        if reflects(receiver) then reflected(cx, e)
        else if mentions_const_call(cx.an, receiver) then const_call(cx, e)
        else None

    // A conversion is written, so what it does while compiling is what it does while running: a
    // narrowing wraps and a float-to-integer truncates toward zero.
    //
    // A call to a `const` function is run, which is what such a function is for (`const_eval.sysl`).
    Call(callee, args) ->
        // `T::Annotation[A].is_some()` on a parameter standing for itself waits for the instance.
        if reflects(callee) && awaits_instantiation(cx, callee) then return None

        val converted = const_conversion(cx, e.span, callee, args)

        if converted.is_some() then return converted

        val reordered = const_byte_order(cx, e)

        if reordered.is_some() then return reordered

        val reinterpreted = const_float_bits(cx, e)

        if reinterpreted.is_some() then reinterpreted else const_call(cx, e)

    // `sizeof(T)` and `alignof(T)` are compile-time constants, so they fold exactly as a literal
    // does -- which is what makes them usable in an array bound and in a `const`.
    LayoutOf(what, t) -> layout_bytes(cx, what, measured(cx, t))
    TraitTest(subject, bounds) -> trait_test(cx, e.span, subject, bounds)
    OffsetOf(t, field) -> offset_bytes(cx, e.span, measured(cx, t), field)

    // `T::Min` and `T::Max` on a built-in integer are constants for the reason `sizeof` is: the
    // answer is a property of the type and is known once the type is.
    //
    // `T::Kind`, `T::Name`, `T::Fields` and `T::Variants` are literals once typed, so they are typed
    // and run as a call's answer is.
    TypeAttr(receiver, attr, _, _) ->
        if reflection_attr(attr) then reflected(cx, e) else const_type_attr(cx, receiver, attr)

    _ -> None

// Whether an expression asks one of the four questions about a type's make-up anywhere in it.
reflects(e: Expr) -> bool = *e.kind match
    TypeAttr(_, attr, _, _) -> reflection_attr(attr)
    Field(receiver, _, _) -> reflects(receiver)
    Index(receiver, index, _) -> reflects(receiver) || reflects(index)
    Unary(_, operand) -> reflects(operand)
    Binary(_, l, r) -> reflects(l) || reflects(r)
    Compare(operands, _) ->
        for item in operands
            if reflects(item) then return true

        false
    _ -> false

// An expression asking about a type's make-up, typed and run -- once the type is known: a type
// parameter standing for itself has no make-up yet, and every instantiation answers for its own.
private reflected(cx: &Analyzer, e: Expr) -> Option[Const] =
    if awaits_instantiation(cx, e) then None else const_call(cx, e)

// How many types the pack `A` stands for, where `A.len` is what was written.
private pack_length(subst: Buf[Binding], receiver: Expr, name: string) -> Option[Const]
    if name != "len" then return None

    *receiver.kind match
        Ident(n) -> bound_type(subst, n) match
            Some(Pack(elems)) -> Some(ConstInt(from_int(long(elems.len()))))
            _ -> None
        _ -> None
end pack_length

// What a value parameter stands for, where the name is bound to one.
//
// The argument travels as a `BigInt` because that is what a type's identity needs -- something that
// compares and mangles -- and the declared type is what says how to read it back. A `bool` whose
// parameter folded to an integer would be a `0` where the body wrote `B`, so the type is not
// decoration here: it is the half of the pair that makes the number mean something.
private const_arg_bound(subst: Buf[Binding], name: string) -> Option[Const]
    bound_type(subst, name) match
        Some(ConstArg(v, ty, _)) -> underlying(*ty) match
            Bool -> Some(ConstBool(v != from_int(0)))
            Char -> Some(ConstChar(char(u32(v.to_long().unwrap_or(0)))))
            _ -> Some(ConstInt(v))
        _ -> None
end const_arg_bound

// The value a declared constant comes to, where `name` reaches one (`asm.sysl` writes it into the text
// of a block at the top of a file).
const_of_name(cx: &Analyzer, name: string) -> Option[Const]
    if cx.lookup(name).is_some() then return None

    val key = lookup_value_key(cx, cx.an.tables.consts, name)

    if key.is_none() then return None

    val d = cx.an.tables.consts.get(key.unwrap()).unwrap()

    if d.init.is_none() then return None
    // A constant written in terms of itself is a loop the fold would follow for ever, so it is cut
    // here as well as where a use of one is typed.
    if const_cycle_at(cx, key.unwrap()) then return None

    val inner = analyzer_for(cx.an, d.scope)

    cx.an.consts_in_progress.push(key.unwrap())

    val out = const_fold(inner, d.init.unwrap())

    cx.an.consts_in_progress.truncate(cx.an.consts_in_progress.len() - 1)
    out
end const_of_name

// The dotted spelling a `Field` over a chain of plain names comes to, where it is one and nothing
// binds its head as a value -- a local of the module's spelling is what the field is read off.
private dotted_name(cx: &Analyzer, receiver: Expr, name: string) -> Option[string] =
    dotted_name_written(cx, receiver).map(head -> s"$head.$name")

private const_unary(cx: &Analyzer, op: string, operand: Expr) -> Option[Const]
    val v = const_fold(cx, operand)

    if v.is_none() then return None

    v.unwrap() match
        ConstInt(n) ->
            if op == "-" then Some(ConstInt(negate(n)))
            else if op == "~" then Some(ConstInt(big_not(n)))
            else None
        ConstFloat(f) -> if op == "-" then Some(ConstFloat(0.0 - f)) else None
        ConstBool(b) -> if op == "!" then Some(ConstBool(!b)) else None
        _ -> None
end const_unary

private const_binary(cx: &Analyzer, span: Span, op: string, l: Expr, r: Expr) -> Option[Const]
    val a = const_fold(cx, l)
    val b = const_fold(cx, r)

    if a.is_none() || b.is_none() then return None

    a.unwrap() match
        ConstInt(x) -> b.unwrap() match
            ConstInt(y) -> int_binary(cx, span, op, x, y)
            _ -> None
        ConstFloat(x) -> b.unwrap() match
            ConstFloat(y) -> float_binary(op, x, y)
            _ -> None
        ConstBool(x) -> b.unwrap() match
            ConstBool(y) -> bool_binary(op, x, y)
            _ -> None
        ConstChar(x) -> b.unwrap() match
            ConstChar(y) -> compared(op, cmp(from_int(long(u32(x))), from_int(long(u32(y)))))
            _ -> None
        ConstStr(x) -> b.unwrap() match
            ConstStr(y) -> str_binary(op, x, y)
            _ -> None
        ConstQuad(hi, lo) -> b.unwrap() match
            ConstQuad(yh, yl) -> run_quad_binary(op, (hi, lo), (yh, yl)).ok()
            _ -> None
        ConstArray(_) -> None
        ConstRecord(_, _) -> None
        ConstView(_, _, _, _) -> None
        ConstWriter(_) -> None
        ConstLink(_) -> None
        ConstPtr(_, _, _) -> None
        ConstUnset -> None
        ConstPun(_, _) -> None
        ConstErased(_, _) -> None
end const_binary

// A comparison's verdict from the sign of the difference, where the operator is a comparison.
private compared(op: string, sign: int) -> Option[Const]
    if op == "==" then return Some(ConstBool(sign == 0))
    if op == "!=" then return Some(ConstBool(sign != 0))
    if op == "<" then return Some(ConstBool(sign < 0))
    if op == "<=" then return Some(ConstBool(sign <= 0))
    if op == ">" then return Some(ConstBool(sign > 0))
    if op == ">=" then return Some(ConstBool(sign >= 0))

    None
end compared

// Two string literals joined are a third, which is the one operator on strings that produces a
// value rather than a verdict -- and at compile time it is text beside text, with none of the
// allocating `sysl.str.concat` a run-time `+` lowers to. It is what lets a long constant be written
// in pieces, one line per source line; without it such a value could not be a `const` at all.
private str_binary(op: string, x: string, y: string) -> Option[Const]
    if op == "+" then return Some(ConstStr(x + y))
    if op == "==" then return Some(ConstBool(x == y))
    if op == "!=" then return Some(ConstBool(x != y))

    None
end str_binary

// Floating-point arithmetic is the machine's, done once while compiling.
private float_binary(op: string, x: real, y: real) -> Option[Const]
    if op == "+" then return Some(ConstFloat(x + y))
    if op == "-" then return Some(ConstFloat(x - y))
    if op == "*" then return Some(ConstFloat(x * y))
    if op == "/" then return Some(ConstFloat(x / y))

    compared(op, if x < y then -1 else if x > y then 1 else 0)
end float_binary

// A fold that cannot go on, said at the sub-expression that stopped it -- the division, the shift,
// the conversion -- and counted in `Analysis.const_refusals` whether or not the report already
// holds it. Every read of a refused constant arrives here again with the same sentence at the same
// place, so the report keeps one and the count is what tells the reader the fold refused.
private refuse(cx: &Analyzer, span: Span, message: string) -> Option[Const]
    cx.fault(span, message)
    cx.an.const_refusals += 1
    None
end refuse

// Whether a fold begun when the count stood at `mark` refused, rather than meeting something that is
// simply not a constant -- which is what a reader asks before saying so itself.
const_refused_since(a: &Analysis, mark: usize) -> bool = a.const_refusals != mark

private int_binary(cx: &Analyzer, span: Span, op: string, x: BigInt, y: BigInt) -> Option[Const]
    if op == "+" then return Some(ConstInt(add(x, y)))
    if op == "-" then return Some(ConstInt(sub(x, y)))
    if op == "*" then return Some(ConstInt(mul(x, y)))
    if op == "&" then return Some(ConstInt(big_and(x, y)))
    if op == "|" then return Some(ConstInt(big_or(x, y)))
    if op == "^" then return Some(ConstInt(big_xor(x, y)))

    // A division by zero is a mistake in what was written rather than something to answer, and the
    // compiler is the one dividing, so it is the one to say so.
    if op == "/" || op == "%"
        if cmp(y, from_int(0)) == 0 then return refuse(cx, span, "a constant divided by zero")

        val q = div_rem(x, y)

        return Some(ConstInt(if op == "/" then q.0 else q.1))
    end if

    if op == "<<" || op == ">>" then return shifted(cx, span, op, x, y)

    compared(op, cmp(x, y))
end int_binary

// A constant shift, done as a multiplication or a division by a power of two, since these are
// numbers with no width to shift bits inside of.
//
// **The ceiling on the distance is the widest integer a type may be and not 64**, because a shift
// past 64 places is meaningful the moment a type is wider than that: `1 << 200` is an ordinary
// constant at `u256`. A distance beyond every possible width is refused -- it cannot be a shift of
// anything, and the number it would produce is unbounded.
private shifted(cx: &Analyzer, span: Span, op: string, x: BigInt, places: BigInt) -> Option[Const]
    if cmp(places, from_int(0)) < 0 || cmp(places, from_int(long(MaxIntegerBits))) > 0 then
        return refuse(cx, span, s"a constant shifted by ${to_string(places)} places")

    val n = places.to_long()

    if n.is_none() then return None

    val scale = pow(from_int(2), usize(n.unwrap()))

    if op == "<<" then return Some(ConstInt(mul(x, scale)))

    // **A right shift rounds DOWN and a division rounds toward zero**, and the two disagree on
    // every negative value that does not divide exactly: `-3 >> 1` is `-2` and `-3 / 2` is `-1`.
    // The shift is the arithmetic one, so a negative left over takes the quotient one further down.
    val q = div_rem(x, scale)

    if cmp(x, from_int(0)) < 0 && cmp(q.1, from_int(0)) != 0 then
        return Some(ConstInt(sub(q.0, from_int(1))))

    Some(ConstInt(q.0))
end shifted

private bool_binary(op: string, x: bool, y: bool) -> Option[Const]
    if op == "&&" then return Some(ConstBool(x && y))
    if op == "||" then return Some(ConstBool(x || y))
    if op == "==" then return Some(ConstBool(x == y))
    if op == "!=" then return Some(ConstBool(x != y))

    None
end bool_binary

// The type a `sizeof`, `alignof` or `offsetof` measures. One that resolves to `Unknown` was told
// where it is written -- a name nothing declares, or a type that contains itself, so has no size --
// and the measurement has no value because of that mistake rather than because it is not a constant.
// So it counts as a refused fold: a reader asking "did this fold refuse?" stays silent, where it would
// otherwise add "an array length must be a constant" to a `[sizeof(Loop)]u8` inside `Loop` itself.
private measured(cx: &Analyzer, t: TypeRef) -> Type
    val out = resolve_type(cx.an, cx.scope, t, cx.subst)

    if out == Unknown then cx.an.const_refusals += 1

    out
end measured

// How many bytes `sizeof` or `alignof` answers with, where the type is one this compilation has a
// layout for. A type parameter is not measured: its width is fixed at each instantiation.
layout_bytes(cx: &Analyzer, what: string, t: Type) -> Option[Const]
    if t == Unknown || mentions_abstract(t) then return None

    if what == "sizeof" then return Some(ConstInt(from_int(long(cx.an.tables.layout.size(t)))))
    if what == "alignof" then return Some(ConstInt(from_int(long(cx.an.tables.layout.align(t)))))

    None
end layout_bytes

// Where a field sits in a struct, in bytes.
//
// The two silent `None`s are a parameter awaiting its instantiation and a type already complained
// about; **every other way to have no answer is refused here, in its own words**, and counted, so the
// `const` or the `@assert` around it says nothing more. A misspelled field is the one that matters
// most -- the form exists to be told when a mirror and its original disagree -- so the refusal lists
// what the struct does have. **A bitfield has no byte offset**, being a range of bits inside the one
// integer its struct is, and rounding down to the byte it begins in would be a number that is not
// where it is; and a zero-sized field lands nowhere.
offset_bytes(cx: &Analyzer, span: Span, t: Type, field: string) -> Option[Const]
    if t == Unknown || mentions_abstract(t) then return None

    underlying(t) match
        Struct(d) ->
            val shown = type_show(t)
            val ranges = bitfield_ranges(d)

            if ranges.is_some()
                val rs = ranges.unwrap()

                for r in rs
                    if r.name == field
                        return refuse(cx, span, s"'$shown.$field' is a bitfield — it starts at bit ${r.offset} " +
                            s"of the struct and is ${r.width} bits wide, so it has no byte offset. 'offsetof' " +
                            "answers in bytes, and the byte it begins in is not where it is")
            end if

            if !d.c_bits.is_empty()
                val i = d.field_index(field)

                if i >= 0 && d.c_bit(usize(i)).is_some()
                    val p = c_bitfield_layout(cx.an.tables.layout, d).places.at(usize(i))

                    return refuse(cx, span, s"'$shown.$field' is a bitfield — it starts at bit ${p.bit} " +
                        s"of the struct and is ${p.width} bits wide, so it has no byte offset. 'offsetof' " +
                        "answers in bytes, and the byte it begins in is not where it is")
                end if
            end if

            val at = cx.an.tables.layout.field_offset(d, field)

            if at.is_some() then return Some(ConstInt(from_int(long(at.unwrap()))))

            // A field an anonymous member holds begins where the member does, plus where it sits
            // inside the member, at every level down.
            val through = anonymous_path(d, field)

            if !through.is_empty()
                var sum: usize = 0
                var level = d

                for k in 0..<through.len()
                    val f = level.fields.at(usize(through.at(k)))
                    val here = cx.an.tables.layout.field_offset(level, f.0)

                    if here.is_none() then return refuse(cx, span, s"'$shown.$field' occupies no storage, so it has no offset")

                    sum = sum + here.unwrap()

                    f.1 match
                        Struct(next) -> level = next
                        _ -> ()

                return Some(ConstInt(from_int(long(sum))))
            end if

            if d.field_index(field) >= 0
                return refuse(cx, span, s"'$shown.$field' occupies no storage, so it has no offset — a " +
                    "zero-sized field lands nowhere, and a C struct that is being mirrored has no member " +
                    "matching it either")

            refuse(cx, span, s"'$shown' has no field '$field'" + stored_names(d))
        _ -> refuse(cx, span, s"'offsetof' measures a field of a struct, and ${type_show(t)} is not one")
end offset_bytes

// The fields a struct declares, quoted, as the tail of a refusal naming one it does not.
private stored_names(d: &StructType) -> string
    val fields = visible_field_names(d)

    if fields.len() == 0 then return ""

    var out = " — it stores "

    for i in 0..<fields.len()
        if i > 0 then out = out + ", "
        out = out + s"'${fields.at(i)}'"

    out
end stored_names

// A width family name, measured with nothing to say about a spelling that is not one.
private width_of(cx: &Analyzer, name: string) -> Option[Type] =
    width_type(cx.an, cx.scope, Span(0, 0), name)

// `T::Min` and `T::Max` on a built-in integer -- written by name, or reached through a type parameter
// the instantiation bound to one, which is the nearer binding and so is asked first.
private const_type_attr(cx: &Analyzer, receiver: Expr, attr: string) -> Option[Const]
    val name = *receiver.kind match
        Ident(n) -> Some(n)
        _ -> None

    if name.is_none() then return None

    val written = scalar_named(name.unwrap(), word_bits(cx)).or_else(() -> width_of(cx, name.unwrap()))
    val t = bound_type(cx.subst, name.unwrap()).or_else(() -> written)

    if t.is_none() then return None

    t.unwrap() match
        Integer(bits, signed, _) ->
            if attr == "Min" then Some(ConstInt(min_of(bits, signed)))
            else if attr == "Max" then Some(ConstInt(max_of(bits, signed)))
            else None
        _ -> None
end const_type_attr

// A written conversion to a scalar -- `u8(300)`, `real(3)`, `char(65)` -- over a value that folds.
private const_conversion(cx: &Analyzer, span: Span, callee: Expr, args: Buf[Expr]) -> Option[Const]
    if args.len() != 1 then return None

    val written = *callee.kind match
        Ident(n) -> Some(n)
        _ -> None

    if written.is_none() || cx.lookup(written.unwrap()).is_some() then return None

    val name = written.unwrap()
    val target = scalar_named(name, word_bits(cx)).or_else(() -> width_of(cx, name))

    if target.is_none() then return made_new_const(cx, callee, args.at(0))

    val value = const_fold(cx, args.at(0))

    if value.is_none() then return None

    converted(cx, span, value.unwrap(), target.unwrap())
end const_conversion

// `Ip(0x0a00_020f)` -- a `new` type made from its base. **The value is the base's, unchanged**: the
// wrap is a change of name and not of number, so nothing narrows here, and the constant's declared
// type is what then holds the number to the base's width and to a `within` range. A type with a
// `where` predicate has a check only a run can make, and folds nothing.
//
// **A value of another kind is converted as the base's own name would convert it**, since `Phase(3)`
// over `real` is `Phase(real(3))`: an integer at a float base becomes that float, a float at an
// integer base is truncated, and an integer and a `char` cross as their conversions do.
private made_new_const(cx: &Analyzer, callee: Expr, arg: Expr) -> Option[Const]
    val subject = subject_named(cx, callee)

    val base = subject match
        Some(Constrained(d)) ->
            if !d.derived || d.pred_fn.is_some() then return None
            underlying(d.base)
        _ -> return None

    val value = const_fold(cx, arg)

    if value.is_none() then return None

    val crosses = (value.unwrap(), base) match
        (ConstInt(_), Floating(_, _)) -> true
        (ConstInt(_), Char) -> true
        (ConstFloat(_), Integer(_, _, _)) -> true
        (ConstChar(_), Integer(_, _, _)) -> true
        _ -> false

    if !crosses then return value

    // A value that is converted may be converted by the type's own `from`, which is a call, not a
    // fold.
    val owner = member_key(cx.an, subject.unwrap(), "from").0

    if cx.an.tables.members.from_trait.get(member_key_of(owner, "from")).is_some() then return None

    converted(cx, arg.span, value.unwrap(), base)
end made_new_const

private converted(cx: &Analyzer, span: Span, v: Const, target: Type) -> Option[Const] = v match
    ConstInt(n) -> target match
        Integer(bits, signed, _) -> Some(ConstInt(wrap(n, bits, signed)))
        Floating(_, _) -> Some(ConstFloat(big_to_real(n)))
        Char ->
            val max = from_int(0x10FFFF)

            if cmp(n, from_int(0)) < 0 || cmp(n, max) > 0 ||
               (cmp(n, from_int(0xD800)) >= 0 && cmp(n, from_int(0xDFFF)) <= 0)
                return refuse(cx, span, s"${to_string(n)} is not a Unicode scalar value")

            Some(ConstChar(char(u32(n.to_long().unwrap_or(0)))))
        _ -> None
    ConstFloat(f) -> target match
        Integer(bits, signed, _) -> Some(ConstInt(saturated(f, bits, signed)))
        Floating(_, _) -> Some(ConstFloat(f))
        _ -> None
    ConstChar(c) -> target match
        Integer(bits, signed, _) -> Some(ConstInt(wrap(from_int(long(u32(c))), bits, signed)))
        _ -> None
    _ -> None

// A float read as an integer while compiling, by the rule the running program follows: truncated
// toward zero, clamped to the ends of the width, and zero for a NaN. A constant is the same
// expression evaluated earlier, so it may not come to a different number than the conversion would
// at run time.
saturated(f: real, bits: int, signed: bool) -> BigInt
    if f.is_nan() then return big_zero()

    big_of_real(f) match
        Some(n) ->
            if cmp(n, min_of(bits, signed)) < 0 then min_of(bits, signed)
            else if cmp(n, max_of(bits, signed)) > 0 then max_of(bits, signed)
            else n
        None -> if f > 0.0 then max_of(bits, signed) else min_of(bits, signed)
end saturated

// -- `@assert` -----------------------------------------------------------------------------------

// What an `@assert` says when its condition does not hold, is not a condition, or does not settle.
//
// **It is settled while compiling and emits nothing either way**: a true assertion is not code, and
// a false one has already stopped the compilation. So the whole of the form is what is said about
// it here.
//
// Inside a generic body the folding is done against the substitution the instantiation supplied,
// which is the only moment `sizeof(T)` is a number -- and a condition that is still waiting for one
// is not a mistake, since a later instantiation settles it.
//
// The message is worked out only once the condition has come out false (`assert_message`), so one
// that could not be computed is never looked at while the condition holds.
check_assert(cx: &Analyzer, span: Span, cond: Expr, message: Option[Expr])
    val refusals = cx.an.const_refusals

    const_fold(cx, cond) match
        Some(ConstBool(true)) -> ()
        Some(ConstBool(false)) ->
            if message.is_some()
                val said = assert_message(cx, span, message.unwrap())

                if said.is_none() then return

                cx.fault(span, s"assertion failed: ${said.unwrap()}" + compared_note(cx, cond) +
                         instantiation_note(cx))
                return
            end if

            cx.fault(span, "assertion failed" + compared_note(cx, cond) + instantiation_note(cx))
        Some(other) ->
            cx.fault(span, s"'@assert' takes a condition, and this is ${const_kind(other)} — an " +
                     "assertion is something that can be true or false")
        // A fold that refused has already said why, at the part that stopped it.
        None ->
            if !awaits_instantiation(cx, cond) && !const_refused_since(cx.an, refusals) then
                cx.fault(span, "'@assert' is settled while compiling, so its condition has to be " +
                         "a constant expression — a literal, a 'const', 'sizeof', 'alignof', " +
                         "'offsetof', a call whose body runs while compiling, or the arithmetic and " +
                         "comparisons over them — and nothing read out of storage filled at run time")
end check_assert

// What a failed **comparison** adds: the value each side folded to, for a side the reader did not
// write out as a literal. The compiler folded both to decide the comparison, so it is holding the
// two numbers that explain the answer.
private compared_note(cx: &Analyzer, cond: Expr) -> string
    var left: Option[string] = None
    var right: Option[string] = None

    *cond.kind match
        Compare(operands, ops) ->
            if operands.len() == 2 && ops.len() == 1
                left = folded_side(cx, operands.at(0))
                right = folded_side(cx, operands.at(1))
        _ -> ()

    if left.is_some() && right.is_some() then
        return s" — the left side is ${left.unwrap()} and the right side is ${right.unwrap()}"

    if left.is_some() then return s" — the left side is ${left.unwrap()}"
    if right.is_some() then return s" — the right side is ${right.unwrap()}"

    ""
end compared_note

// One side of the comparison, as text, unless the reader wrote it out as a literal -- in which case
// reporting it back says nothing they cannot already see.
private folded_side(cx: &Analyzer, e: Expr) -> Option[string]
    if written_literal(e) then return None

    const_fold(cx, e).map(v -> const_text(v))
end folded_side

// Whether an operand is a literal the reader **wrote**. A negative number is written `-1` and parses
// as a unary minus over a literal, so it counts too -- otherwise the shape a bound is most often
// compared against would be the one reported back.
private written_literal(e: Expr) -> bool = *e.kind match
    IntLit(_, _, _) -> true
    FloatLit(_, _) -> true
    BoolLit(_) -> true
    CharLit(_) -> true
    StrLit(_) -> true
    Unary(op, operand) -> op == "-" && written_literal(operand)
    _ -> false

// A folded value as it should appear inside a sentence, spelled the way it would be written.
private const_text(v: Const) -> string = v match
    ConstInt(n) -> to_string(n)
    ConstBool(b) -> if b then "true" else "false"
    ConstChar(c) -> s"'$c'"
    ConstStr(s) -> s"\"$s\""
    ConstFloat(f) -> real_text(f)
    ConstQuad(hi, lo) -> quad_text((hi, lo))
    ConstArray(xs) -> s"an array of ${xs.len()} elements"
    ConstRecord(v, _) -> if v < 0 then "a struct" else "an enum value"
    ConstView(_, _, n, _) -> s"a slice of $n elements"
    ConstWriter(_) -> "a writer"
    ConstLink(_) -> "an address"
    ConstPtr(_, _, _) -> "an address"
    ConstUnset -> "a slot nothing was placed in"
    ConstPun(_, _) -> "an address"
    ConstErased(_, _) -> "a trait object"

// A float as a sentence spells it -- the non-finite ones by the names a program writes for them,
// rather than as the `inf` and `nan` the C formatting underneath would print.
real_text(f: real) -> string
    if f != f then return "nan"
    if f > MaxReal then return "infinity"
    if f < -MaxReal then return "-infinity"

    str(f)
end real_text

// -- the two float values no literal spells ---------------------------------------------------------

// `infinity` and `nan`: read without parentheses off a float type (`real.infinity`, `f32.nan`), and
// written bare for the `real` ones wherever nothing the program declared or imported has the name.
// They are constants -- a `within` bound, a `const` initializer -- where the library's
// `real.infinity()` is an associated function, which is why that spelling stays the library's.
builtin_float(name: string) -> Option[real] =
    if name == "infinity" then Some(1.0 / 0.0) else if name == "nan" then Some(0.0 / 0.0) else None

// The literal one of those reads as, at the float type it was read off. The bit patterns are written
// down rather than computed, so the emitted text is the same whatever host compiled it: a NaN has
// many, and this is the quiet one every arithmetic unit here produces.
builtin_float_lit(span: Span, name: string, ty: Type) -> TExpr
    if is_quad(ty)
        val (hi, lo) = if name == "infinity" then quad_infinity(false) else quad_nan()

        return TExpr(span, TQuadLit(hi, lo, ty))

    TExpr(span, TFloatLit(if name == "infinity" then InfinityBits else NanBits, ty))
end builtin_float_lit

const InfinityBits: long = 0x7FF0000000000000
const NegInfinityBits: long = -0x0010000000000000
private const NanBits: long = 0x7FF8000000000000
private const MaxReal: real = 1.7976931348623157e308

// What a value that is not a condition is, said the way the refusal names it.
const_kind(v: Const) -> string = v match
    ConstInt(_) -> "an integer"
    ConstBool(_) -> "a boolean"
    ConstChar(_) -> "a character"
    ConstStr(_) -> "a string"
    ConstFloat(_) -> "a float"
    ConstQuad(_, _) -> "a float"
    ConstArray(_) -> "an array"
    ConstRecord(v, _) -> if v < 0 then "a struct" else "an enum value"
    ConstView(_, _, _, _) -> "a slice"
    ConstWriter(_) -> "a writer"
    ConstLink(_) -> "an address"
    ConstPtr(_, _, _) -> "an address"
    ConstUnset -> "a slot nothing was placed in"
    ConstPun(_, _) -> "an address"
    ConstErased(_, _) -> "a trait object"

// Whether the condition is one a later instantiation settles rather than one that cannot settle at
// all: a measurement of a type parameter, or a value parameter standing in for itself.
private awaits_instantiation(cx: &Analyzer, e: Expr) -> bool = *e.kind match
    LayoutOf(_, t) -> is_abstract_underlying(resolve_type(cx.an, cx.scope, t, cx.subst))
    OffsetOf(t, _) -> is_abstract_underlying(resolve_type(cx.an, cx.scope, t, cx.subst))
    TypeArg(t) -> is_abstract_underlying(resolve_type(cx.an, cx.scope, t, cx.subst))
    Ident(n) -> binding_is_abstract(cx.subst, n)
    TypeAttr(receiver, _, _, _) -> awaits_instantiation(cx, receiver)
    Field(receiver, _, _) -> awaits_instantiation(cx, receiver)
    Index(receiver, index, _) -> awaits_instantiation(cx, receiver) || awaits_instantiation(cx, index)
    Unary(_, operand) -> awaits_instantiation(cx, operand)
    Binary(_, l, r) -> awaits_instantiation(cx, l) || awaits_instantiation(cx, r)
    Compare(operands, _) ->
        operands.len() == 2 && (awaits_instantiation(cx, operands.at(0)) ||
                                awaits_instantiation(cx, operands.at(1)))
    Call(callee, args) -> args.len() == 1 && is_bare_name(callee) && awaits_instantiation(cx, args.at(0))
    _ -> false

private is_bare_name(e: Expr) -> bool = *e.kind match
    Ident(_) -> true
    _ -> false

private is_abstract_underlying(t: Type) -> bool = underlying(t) match
    Abstract(_, _) -> true
    _ -> false

private binding_is_abstract(subst: Buf[Binding], name: string) -> bool
    for item in subst
        if item.name == name
            return item.ty match
                Abstract(_, _) -> true
                _ -> false

    false
end binding_is_abstract

// -- the typed tree, for module storage --------------------------------------------------------------

// What a TYPED scalar expression comes to while compiling -- the question a module `val`'s
// initializer asks before it can be laid into the object file rather than computed by a prologue
// (`laid_down`). It is the arithmetic `const_fold` does over the written tree, done over the tree
// the analyzer built from it, so a `const` read inside it is already its literal.
//
// **It holds itself to one promise `const_fold` does not need**: the answer is the value the
// expression produces at run time. A `const` that overflows is a mistake to report; an initializer
// that overflows is code that traps, and the trap belongs to the program. So wherever run time could
// say something else -- an integer result its type does not hold, a division by zero, a shift by the
// width or more, a float conversion out of the integer's range, a character outside Unicode -- the
// answer is `None`, the initializer stays code, and nothing is said. A `f32` is rounded at every step,
// as the machine rounds it.
const_fold_typed(t: TExpr, little: bool) -> Option[Const]
    val ty = folded_scalar(texpr_type(t))

    if ty.is_none() then return None

    val v = *t.kind match
        TIntLit(n, _) -> Some(ConstInt(n))
        TBoolLit(b) -> Some(ConstBool(b))
        TStrLit(s) -> Some(ConstStr(s))
        TFloatLit(bits, _) -> Some(ConstFloat(real_of_bits(bits)))
        TUnary(op, operand, _) -> typed_unary(op, operand, ty.unwrap(), little)
        TBinary(op, l, r, _) -> typed_binary(op, l, r, little)
        TLogical(op, l, r) -> typed_binary(op, l, r, little)
        TCompare(operands, cmps) ->
            if operands.len() == 2 && cmps.len() == 1 && cmps.at(0).dispatch.is_none() then
                typed_binary(cmps.at(0).op, operands.at(0), operands.at(1), little)
            else
                None
        TCast(inner, _) -> typed_conversion(inner, ty.unwrap(), little)
        TIntOp(op, operand, None, width, _) -> typed_byte_order(op, operand, width, little)
        TCall(name, args, _, false) ->
            if float_bits_routine(name) && args.len() == 1 then
                const_fold_typed(args.at(0), little).and_then(c -> float_bits_folded(name, c))
            else
                None
        _ -> None

    if v.is_none() then return None

    held_at(v.unwrap(), ty.unwrap())
end const_fold_typed

// `FloatBits`' two members on a float the compiler folds -- `real.from_bits(0x3fe62e42fefa39ef)`,
// `x.bits()` -- named as the standard module keys them. They reinterpret and round nothing, so the
// answer is the one the program would get: a `libm`'s table of constants written as bit patterns is
// data, as the same table written as hex floats is.
float_bits_routine(name: string) -> bool = name match
    "real.from_bits" | "real.bits" | "f32.from_bits" | "f32.bits" -> true
    "f16.from_bits" | "f16.bits" | "bf16.from_bits" | "bf16.bits" -> true
    "f128.from_bits" | "f128.bits" -> true
    _ -> false

// The value one of them gives for the value it was handed, as the evaluator holds both: a float of
// any width narrower than `f128` as the `real` it widens to exactly, an `f128` as its two halves.
float_bits_folded(name: string, arg: Const) -> Option[Const]
    if name == "f128.bits"
        return arg match
            ConstQuad(hi, lo) -> Some(ConstInt(add(big_shl(from_u64(hi), 64), from_u64(lo))))
            _ -> None

    if name == "real.bits" || name == "f32.bits" || name == "f16.bits" || name == "bf16.bits"
        val f = arg match
            ConstFloat(x) -> x
            _ -> return None

        return name match
            "real.bits" -> Some(ConstInt(from_u64(f.bits())))
            "f32.bits" -> Some(ConstInt(from_u64(u64(f32(f).bits()))))
            "f16.bits" -> Some(ConstInt(from_u64(u64(f16(f).bits()))))
            "bf16.bits" -> Some(ConstInt(from_u64(u64(bf16(f).bits()))))
            _ -> None
    end if

    val n = arg match
        ConstInt(x) -> x
        _ -> return None

    if name == "f128.from_bits"
        val w = wrap(n, 128, false)
        val hi = to_u64(big_shr(w, 64))
        val lo = to_u64(wrap(w, 64, false))

        return if hi.is_none() || lo.is_none() then None else Some(ConstQuad(hi.unwrap(), lo.unwrap()))
    end if

    val u = to_u64(wrap(n, 64, false)).unwrap_or(0)

    name match
        "real.from_bits" -> Some(ConstFloat(real.from_bits(u)))
        "f32.from_bits" -> Some(ConstFloat(real(f32.from_bits(u32(u & 0xFFFFFFFF)))))
        "f16.from_bits" -> Some(ConstFloat(real(f16.from_bits(u16(u & 0xFFFF)))))
        "bf16.from_bits" -> Some(ConstFloat(real(bf16.from_bits(u16(u & 0xFFFF)))))
        _ -> None
end float_bits_folded

// `x.swap_bytes()` and the four directions of `sysl.math.ByteOrder`, over a value that folds: the
// same reversal the machine makes, so storage initialized with `ADDR.to_be()` is laid down as data
// rather than computed before the program runs -- which a target with no loader could not do at all.
// `little` is the target's byte order, which decides whether a direction reverses anything.
private typed_byte_order(op: string, operand: TExpr, width: Type, little: bool) -> Option[Const]
    val swaps = op match
        "swap_bytes" -> true
        "to_be" -> little
        "from_be" -> little
        "to_le" -> !little
        "from_le" -> !little
        _ -> return None

    val v = const_fold_typed(operand, little)

    v match
        Some(ConstInt(n)) -> width match
            Integer(bits, signed, _) -> if swaps then Some(ConstInt(swapped_bytes(n, bits, signed))) else v
            _ -> None
        _ -> None
end typed_byte_order

// The bytes of `n`, held at a width of `bits`, in the opposite order -- read back at the width's
// signedness, so a negative `i16` reversed is the value the machine's register would hold.
swapped_bytes(n: BigInt, bits: int, signed: bool) -> BigInt
    var raw = wrap(n, bits, false)
    var out = from_int(0)
    val unit = from_int(256)

    for i in 0..<(bits / 8)
        val q = div_rem(raw, unit)

        out = add(mul(out, unit), q.1)
        raw = q.0

    wrap(out, bits, signed)
end swapped_bytes

// An operation of the `Bits` and `Signed` traits on `n`, held at a width of `bits`: the answer the
// machine's own instructions give. A count of zeros or ones from either end of zero is the width, as
// the trait documents; a rotation is by its amount modulo the width, as a funnel shift of the value
// with itself is; `abs` of the most negative value wraps to itself. `None` for an operation it does
// not name.
int_op_value(op: string, n: BigInt, bits: int, signed: bool, amount: Option[BigInt]) -> Option[BigInt]
    val zero = from_int(0)

    if op == "abs" then return Some(if cmp(n, zero) < 0 then wrap(negate(n), bits, signed) else n)
    if op == "signum" then return Some(from_int(if cmp(n, zero) < 0 then -1 else if cmp(n, zero) > 0 then 1 else 0))

    // The bits, lowest first.
    var low_first: Buf[bool] = buf()
    var raw = wrap(n, bits, false)

    for _ in 0..<bits
        val q = div_rem(raw, from_int(2))

        low_first.push(cmp(q.1, zero) != 0)
        raw = q.0

    op match
        "count_ones" -> Some(from_int(long(count_of(low_first, true))))
        "count_zeros" -> Some(from_int(long(count_of(low_first, false))))
        "leading_zeros" -> Some(from_int(long(run_of(low_first, false, true))))
        "trailing_zeros" -> Some(from_int(long(run_of(low_first, false, false))))
        "leading_ones" -> Some(from_int(long(run_of(low_first, true, true))))
        "trailing_ones" -> Some(from_int(long(run_of(low_first, true, false))))
        "reverse_bits" ->
            var reversed: Buf[bool] = buf()

            for i in 0..<low_first.len()
                reversed.push(low_first.at(low_first.len() - 1 - i))

            Some(bits_value(reversed, signed))
        "rotate_left" -> Some(bits_value(rotated(low_first, amount.unwrap_or(zero), true), signed))
        "rotate_right" -> Some(bits_value(rotated(low_first, amount.unwrap_or(zero), false), signed))
        _ -> None
end int_op_value

private count_of(low_first: Buf[bool], want: bool) -> usize
    var n: usize = 0

    for b in low_first
        if b == want then n += 1

    n
end count_of

// How many bits equal to `want` run from one end before the first that is not -- the high end where
// `from_top`, the low end otherwise.
private run_of(low_first: Buf[bool], want: bool, from_top: bool) -> usize
    val w = low_first.len()
    var n: usize = 0

    while n < w
        val b = if from_top then low_first.at(w - 1 - n) else low_first.at(n)

        if b != want then break

        n += 1

    n
end run_of

// The bits moved `by` places toward the high end (`left`) or the low end, those leaving one end
// arriving at the other.
private rotated(low_first: Buf[bool], by: BigInt, left: bool) -> Buf[bool]
    val w = low_first.len()
    var out: Buf[bool] = buf()

    if w == 0 then return out

    val k = usize(to_u64(div_rem(by, from_int(long(w))).1).unwrap_or(0))

    for i in 0..<w
        // The bit landing at `i` came from `k` places below it when moving left, above it otherwise.
        val from = if left then (i + w - k) % w else (i + k) % w

        out.push(low_first.at(from))

    out
end rotated

// The value bits stand for, lowest first, read at the width's signedness.
private bits_value(low_first: Buf[bool], signed: bool) -> BigInt
    var out = from_int(0)
    val w = low_first.len()

    for i in 0..<w
        out = add(mul(out, from_int(2)), from_int(if low_first.at(w - 1 - i) then 1 else 0))

    wrap(out, int(w), signed)
end bits_value

// The scalar a typed node is, where it is one this fold answers for: an integer, a `f32` or `f64`,
// a `bool`, a `char` or a `string`, or a name for one that checks nothing. A subtype with a range or
// a predicate runs its check at run time, so it is not one.
private folded_scalar(t: Type) -> Option[Type] = t match
    Constrained(d) -> if name_only(d) then folded_scalar(underlying(t)) else None
    Integer(_, _, _) -> Some(t)
    Floating(bits, brain) -> if !brain && (bits == 32 || bits == 64) then Some(t) else None
    Bool -> Some(t)
    Char -> Some(t)
    Str -> Some(t)
    _ -> None

// A settled value as its type holds it, or `None` where the type cannot hold it as it stands.
private held_at(v: Const, ty: Type) -> Option[Const] = v match
    ConstInt(n) -> ty match
        Integer(bits, signed, _) -> if fits(n, bits, signed) then Some(v) else None
        Char -> if scalar_value(n) then Some(v) else None
        _ -> None
    // A NaN's bits are the machine's choice -- x86 and Arm make different ones -- so one is not
    // written down for it.
    ConstFloat(f) -> ty match
        Floating(bits, _) -> if f != f then None else Some(ConstFloat(if bits == 32 then real(f32(f)) else f))
        _ -> None
    ConstBool(_) -> if ty == Bool then Some(v) else None
    ConstStr(_) -> if ty == Str then Some(v) else None
    ConstChar(_) -> None
    ConstQuad(hi, lo) -> if is_quad(ty) && !quad_is_nan((hi, lo)) then Some(v) else None
    ConstArray(_) -> None
    ConstRecord(_, _) -> None
    ConstView(_, _, _, _) -> None
    ConstWriter(_) -> None
    ConstLink(_) -> None
    ConstPtr(_, _, _) -> None
    ConstUnset -> None
    ConstPun(_, _) -> None
    ConstErased(_, _) -> None

// Whether a number is a Unicode scalar value -- what `char(u)` checks at run time.
private scalar_value(n: BigInt) -> bool =
    cmp(n, from_int(0)) >= 0 && cmp(n, from_int(0x10FFFF)) <= 0 &&
    !(cmp(n, from_int(0xD800)) >= 0 && cmp(n, from_int(0xDFFF)) <= 0)

private typed_unary(op: string, operand: TExpr, ty: Type, little: bool) -> Option[Const]
    val v = const_fold_typed(operand, little)

    if v.is_none() then return None

    v.unwrap() match
        ConstInt(n) -> ty match
            Integer(bits, signed, _) ->
                if op == "-" then Some(ConstInt(negate(n)))
                // `~` is the complement within the width, which is the only reading a width has.
                else if op == "~" then Some(ConstInt(wrap(big_not(n), bits, signed)))
                else None
            _ -> None
        // `0.0 - f` is the fold's negation, and it is not the machine's at zero, whose sign it flips.
        ConstFloat(f) -> if op == "-" && f != 0.0 then Some(ConstFloat(0.0 - f)) else None
        ConstBool(b) -> if op == "!" then Some(ConstBool(!b)) else None
        _ -> None
end typed_unary

private typed_binary(op: string, l: TExpr, r: TExpr, little: bool) -> Option[Const]
    val a = const_fold_typed(l, little)
    val b = const_fold_typed(r, little)

    if a.is_none() || b.is_none() then return None

    a.unwrap() match
        ConstInt(x) -> b.unwrap() match
            ConstInt(y) -> typed_int_binary(op, x, y, folded_scalar(texpr_type(l)).unwrap())
            _ -> None
        // A NaN compares unequal to everything, itself included, which `float_binary`'s sign of the
        // difference cannot say.
        ConstFloat(x) -> b.unwrap() match
            ConstFloat(y) -> if x != x || y != y then None else float_binary(op, x, y)
            _ -> None
        ConstBool(x) -> b.unwrap() match
            ConstBool(y) -> bool_binary(op, x, y)
            _ -> None
        ConstStr(x) -> b.unwrap() match
            ConstStr(y) -> str_binary(op, x, y)
            _ -> None
        ConstChar(_) -> None
        ConstQuad(_, _) -> None
        ConstArray(_) -> None
        ConstRecord(_, _) -> None
        ConstView(_, _, _, _) -> None
        ConstWriter(_) -> None
        ConstLink(_) -> None
        ConstPtr(_, _, _) -> None
        ConstUnset -> None
        ConstPun(_, _) -> None
        ConstErased(_, _) -> None
end typed_binary

// The integer operators, answered only where run time answers the same: never a division by zero,
// never `%` by `-1` (whose quotient is the one a signed width cannot hold), never a shift by a
// negative count or by the operand's whole width.
private typed_int_binary(op: string, x: BigInt, y: BigInt, lt: Type) -> Option[Const]
    if op == "/" || op == "%"
        if cmp(y, from_int(0)) == 0 || (op == "%" && cmp(y, from_int(-1)) == 0) then return None

        val q = div_rem(x, y)

        return Some(ConstInt(if op == "/" then q.0 else q.1))
    end if

    if op == "<<" || op == ">>"
        val bits = lt match
            Integer(w, _, _) -> w
            _ -> 0

        if cmp(y, from_int(0)) < 0 || cmp(y, from_int(long(bits))) >= 0 then return None

        val scale = pow(from_int(2), usize(y.to_long().unwrap_or(0)))

        if op == "<<" then return Some(ConstInt(mul(x, scale)))

        val q = div_rem(x, scale)

        if cmp(x, from_int(0)) < 0 && cmp(q.1, from_int(0)) != 0 then
            return Some(ConstInt(sub(q.0, from_int(1))))

        return Some(ConstInt(q.0))
    end if

    if op == "+" then return Some(ConstInt(add(x, y)))
    if op == "-" then return Some(ConstInt(sub(x, y)))
    if op == "*" then return Some(ConstInt(mul(x, y)))
    if op == "&" then return Some(ConstInt(big_and(x, y)))
    if op == "|" then return Some(ConstInt(big_or(x, y)))
    if op == "^" then return Some(ConstInt(big_xor(x, y)))

    compared(op, cmp(x, y))
end typed_int_binary

// A written conversion between scalars, where run time converts to the same value. An integer
// narrowed wraps, as `converted` says; a float becomes an integer only where the integer holds it,
// so the answer never depends on what an out-of-range conversion does.
private typed_conversion(inner: TExpr, to: Type, little: bool) -> Option[Const]
    val from = folded_scalar(texpr_type(inner))
    val v = const_fold_typed(inner, little)

    if from.is_none() || v.is_none() then return None

    v.unwrap() match
        ConstInt(n) -> to match
            Integer(bits, signed, _) -> from.unwrap() match
                Integer(_, _, _) -> Some(ConstInt(wrap(n, bits, signed)))
                // A `char` read as an integer is its code point, and only where the width holds it.
                Char -> if fits(n, bits, signed) then Some(ConstInt(n)) else None
                _ -> None
            Char -> if scalar_value(n) then Some(ConstInt(n)) else None
            // Rounded once, straight to the width, as the machine's conversion rounds it -- an `f128`
            // too, which holds an integer a `real` would round.
            Floating(128, _) ->
                val (hi, lo) = quad_of_int(n)

                Some(ConstQuad(hi, lo))
            Floating(bits, _) -> Some(ConstFloat(int_to_float(n, bits)))
            _ -> None
        ConstFloat(f) -> to match
            Integer(bits, signed, _) -> big_of_real(f) match
                Some(n) -> if fits(n, bits, signed) then Some(ConstInt(n)) else None
                None -> None
            Floating(_, _) -> Some(ConstFloat(f))
            _ -> None
        ConstBool(b) -> if to == Bool then Some(ConstBool(b)) else None
        ConstStr(s) -> if to == Str then Some(ConstStr(s)) else None
        ConstChar(_) -> None
        ConstQuad(_, _) -> None
        ConstArray(_) -> None
        ConstRecord(_, _) -> None
        ConstView(_, _, _, _) -> None
        ConstWriter(_) -> None
        ConstLink(_) -> None
        ConstPtr(_, _, _) -> None
        ConstUnset -> None
        ConstPun(_, _) -> None
        ConstErased(_, _) -> None
end typed_conversion

private big_abs(n: BigInt) -> BigInt = if cmp(n, from_int(0)) < 0 then negate(n) else n

// -- what an operation does when the program runs it ----------------------------------------------

// **One definition of each scalar operation, read by everything that computes one while compiling**:
// the typed fold above and the evaluator a `const` function runs on (`const_eval.sysl`). Each says
// what the machine does -- the width it wraps at, where it traps, how it rounds -- because a value
// worked out here stands in for the one the program would have computed, bit for bit. A trap is
// answered as `Err` with what stopped it, in the words a reader of the program would use.
//
// Every change to what an operator lowers to in `emit_scalar.sysl` or `emit_expr.sysl` owes the same
// change here.

// An integer operator at the left operand's width. `checked` is what a `within` operand makes of
// `+`, `-`, `*` and `<<`: the overflow-detecting form, which traps where the plain one wraps
// (`emit_scalar.sysl`'s `checked_arith`, `checked_shl`). A comparison answers a `bool`.
run_int_binary(op: string, x: BigInt, y: BigInt, bits: int, signed: bool,
               checked: bool) -> Result[Const, string]
    val ty = type_show(Integer(bits, signed, false))

    // A zero divisor traps, and so does the one quotient a signed width cannot hold; the remainder
    // of that same division is the zero it would have been, which is what the lowering divides by
    // one to get.
    if op == "/" || op == "%"
        if cmp(y, from_int(0)) == 0 then return Err("integer division by zero")

        if signed && cmp(y, from_int(-1)) == 0
            if op == "%" then return Ok(ConstInt(from_int(0)))

            if cmp(x, min_of(bits, signed)) == 0 then
                return Err(s"${to_string(x)} / -1 overflows $ty")
        end if

        val q = div_rem(x, y)

        return Ok(ConstInt(wrap(if op == "/" then q.0 else q.1, bits, signed)))
    end if

    if op == "<<" || op == ">>"
        if checked && op == "<<"
            if cmp(y, from_int(0)) < 0 || cmp(y, from_int(long(bits))) >= 0 then
                return Err(s"${to_string(x)} << ${to_string(y)} overflows $ty")

            val exact = mul(x, pow(from_int(2), usize(y.to_long().unwrap_or(0))))

            if !fits(exact, bits, signed) then return Err(s"${to_string(x)} << ${to_string(y)} overflows $ty")

            return Ok(ConstInt(exact))
        end if

        return Ok(ConstInt(shift_at_width(op, x, y, bits, signed)))
    end if

    if op == "+" || op == "-" || op == "*"
        val exact = if op == "+" then add(x, y) else if op == "-" then sub(x, y) else mul(x, y)

        if checked && !fits(exact, bits, signed) then
            return Err(s"${to_string(x)} $op ${to_string(y)} overflows $ty")

        return Ok(ConstInt(wrap(exact, bits, signed)))
    end if

    if op == "&" then return Ok(ConstInt(wrap(big_and(x, y), bits, signed)))
    if op == "|" then return Ok(ConstInt(wrap(big_or(x, y), bits, signed)))
    if op == "^" then return Ok(ConstInt(wrap(big_xor(x, y), bits, signed)))

    compared(op, cmp(x, y)) match
        Some(v) -> Ok(v)
        None -> Err(s"'$op' on $ty")
end run_int_binary

// A shift by any count, as `expressions.md § Shifting by the width or more` defines it: a count at or
// past the width -- or below zero, which the lowering reads as a count past it -- shifts all the way,
// giving zero, or the sign for a signed `>>`. Below the width it is the instruction.
shift_at_width(op: string, x: BigInt, count: BigInt, bits: int, signed: bool) -> BigInt
    if cmp(count, from_int(0)) < 0 || cmp(count, from_int(long(bits))) >= 0
        if op == ">>" && signed && cmp(x, from_int(0)) < 0 then return from_int(-1)

        return from_int(0)
    end if

    val n = usize(count.to_long().unwrap_or(0))

    if op == "<<" then wrap(big_shl(x, n), bits, signed) else big_shr(x, n)
end shift_at_width

// A float operator at a width. A `f32` is computed as a `f32`, rounded at every operation as the
// machine rounds it -- never in `f64` and rounded once at the end, which gives another answer on a
// tie. A comparison with a NaN is false, except `!=`, which is true.
run_float_binary(op: string, x: real, y: real, bits: int) -> Result[Const, string]
    if op == "+" || op == "-" || op == "*" || op == "/"
        if bits == 32
            val a = f32(x)
            val b = f32(y)
            val r = if op == "+" then a + b else if op == "-" then a - b
            else if op == "*" then a * b else a / b

            return Ok(ConstFloat(real(r)))
        end if

        val r = if op == "+" then x + y else if op == "-" then x - y
        else if op == "*" then x * y else x / y

        return Ok(ConstFloat(r))
    end if

    if x != x || y != y
        if op == "!=" then return Ok(ConstBool(true))

        return if compared(op, 0).is_some() then Ok(ConstBool(false)) else Err(s"'$op' on a float")
    end if

    compared(op, if x < y then -1 else if x > y then 1 else 0) match
        Some(v) -> Ok(v)
        None -> Err(s"'$op' on a float")
end run_float_binary

// A sixteen-bit float operator -- `bf16` where `brain`, `f16` otherwise -- computed as a `f32` and
// rounded once more to the format, which is what the lowering does on a machine without the format's
// own arithmetic. A machine with it gets the same answer: a `f32` holds more than twice either
// format's significand, so rounding to it first never decides the second rounding.
run_half_binary(op: string, x: real, y: real, brain: bool) -> Result[Const, string] =
    run_float_binary(op, x, y, 32) match
        Ok(ConstFloat(f)) -> Ok(ConstFloat(half_of_double(f, brain)))
        other -> other

// A float negated, which flips the sign of a zero as the machine's `fneg` does.
run_float_negate(x: real) -> real = -x

// An `f128` operator, exact and rounded once (`quad_arith.sysl`) -- never through a `real`. A
// comparison with a NaN is false, except `!=`, which is true.
run_quad_binary(op: string, x: (u64, u64), y: (u64, u64)) -> Result[Const, string]
    if op == "+" || op == "-" || op == "*" || op == "/"
        val (hi, lo) = quad_arith(op, x, y)

        return Ok(ConstQuad(hi, lo))
    end if

    val sign = quad_compare(x, y) match
        Some(s) -> s
        None ->
            if op == "!=" then return Ok(ConstBool(true))

            return if compared(op, 0).is_some() then Ok(ConstBool(false)) else Err(s"'$op' on a float")

    compared(op, sign) match
        Some(v) -> Ok(v)
        None -> Err(s"'$op' on a float")
end run_quad_binary

// A written conversion between scalars, as the lowering converts (`emit_expr.sysl`'s `convert`): an
// integer narrowed wraps, an integer becomes a float rounded once to the width, a float becomes an
// integer saturating at the width's ends with a NaN as zero, and an integer becomes a `char` only
// where it is a Unicode scalar value -- read at 64 bits, as the check reads it -- and traps otherwise.
// `from` and `to` are the types the two are laid out as.
run_convert(v: Const, from: Type, to: Type) -> Result[Const, string] = v match
    ConstInt(n) -> (from, to) match
        (_, Integer(bits, signed, _)) -> Ok(ConstInt(wrap(n, bits, signed)))
        (_, Floating(128, _)) ->
            val (hi, lo) = quad_of_int(n)

            Ok(ConstQuad(hi, lo))
        (_, Floating(16, brain)) ->
            if n.is_zero() then return Ok(ConstFloat(0.0))

            Ok(ConstFloat(half_of_ratio(cmp(n, from_int(0)) < 0, big_abs(n), from_int(1), brain)))
        (_, Floating(bits, _)) -> Ok(ConstFloat(int_to_float(n, bits)))
        (Char, Char) -> Ok(v)
        (_, Char) ->
            val u = wrap(n, 64, false)

            if scalar_value(u) then Ok(ConstInt(u))
            else Err(s"${to_string(n)} is not a Unicode scalar value")
        _ -> Err(s"a conversion from ${type_show(from)} to ${type_show(to)}")
    ConstFloat(f) -> to match
        Integer(bits, signed, _) -> Ok(ConstInt(saturated(f, bits, signed)))
        Floating(128, _) ->
            val (hi, lo) = quad_of_double(f.bits())

            Ok(ConstQuad(hi, lo))
        Floating(16, brain) -> Ok(ConstFloat(half_of_double(f, brain)))
        Floating(bits, _) -> Ok(ConstFloat(if bits == 32 then real(f32(f)) else f))
        _ -> Err(s"a conversion from ${type_show(from)} to ${type_show(to)}")
    ConstQuad(hi, lo) -> to match
        Integer(bits, signed, _) -> Ok(ConstInt(quad_to_int((hi, lo), bits, signed)))
        Floating(128, _) -> Ok(v)
        Floating(16, brain) -> Ok(ConstFloat(narrowed_half((hi, lo), brain)))
        Floating(bits, _) -> Ok(ConstFloat(narrowed_real((hi, lo), bits)))
        _ -> Err(s"a conversion from ${type_show(from)} to ${type_show(to)}")
    ConstBool(_) -> if to == Bool then Ok(v) else Err(s"a conversion from bool to ${type_show(to)}")
    _ -> Err(s"a conversion from ${type_show(from)} to ${type_show(to)}")

// An integer as the nearest float of a width, ties to even, rounded ONCE: a `f32` straight from the
// integer, since going through a `f64` rounds twice above 2^53 and lands on the other neighbour at a
// tie. A value past the width's largest finite one is an infinity.
int_to_float(n: BigInt, bits: int) -> real
    if bits != 32 then return big_to_real(n)

    val negative = cmp(n, from_int(0)) < 0
    val m = big_abs(n)
    val length = big_bits(m)

    if length <= 24 then return big_to_real(n)

    val drop = length - 24
    var q = big_shr(m, drop)
    val lost = sub(m, big_shl(q, drop))
    val c = cmp(lost, big_shl(from_int(1), drop - 1))

    if c > 0 || (c == 0 && big_odd(q)) then q = add(q, from_int(1))

    // `q` holds at most 25 bits, so the `real` below is exact, and narrowing it rounds nothing --
    // unless it is past the `f32` range, where it becomes the infinity it should.
    val v = real(f32(big_to_real(big_shl(q, drop))))

    if negative then -v else v
end int_to_float

// Which type parameters the body was compiled against, where it was compiled against any.
//
// The mistake is at the call that asked while the sentence explaining why is at the declaration, so
// a report carrying only one of the two sends the reader to the wrong file. `Self` is named
// alongside the parameters rather than filtered out as the compiler's own word: in an inherited
// default body -- one text shared by every implementing type -- it is the whole of the answer.
private instantiation_note(cx: &Analyzer) -> string
    if cx.subst.is_empty() then return ""

    var names: Buf[string] = buf()

    for item in cx.subst
        names.push(item.name)

    val sorted = sort_names(names)
    var out = " — where "

    for i in 0..<sorted.len()
        for item in cx.subst
            if item.name == sorted.at(i)
                out = out + (if i > 0 then ", " else "") +
                      s"${sorted.at(i)} = ${type_show(item.ty)}"

    out
end instantiation_note
