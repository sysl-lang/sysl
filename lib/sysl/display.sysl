module sysl

// What a format string's flags are carried in (`14 §2`, `§8`): the field the whole value occupies,
// the precision each renderer reads in its own terms, and which side the padding goes on.
//
// What honours it is the `display_*` family, whose prose is where the three fields are explained.
struct FormatSpec
    width: int
    prec: int
    left: bool

// How a value renders itself.
//
// A `Display` writes its value's text into a sink rather than returning a fresh `string`, so
// rendering costs no allocation and a `no alloc` module can still log. The sink is a `*Writer`,
// which is the trait object of `02` -- and which this file does not declare: a module's members are
// one set however many files they came from, so `Writer` is reached here with nothing to import.
trait Display
    display(self, out: *Writer, fmt: FormatSpec)

// The built-in types whose family is **closed**, each with an ordinary `impl` rather than a
// membership the compiler hands out.
//
// The distinction is the one `sysl.math` already draws between `Float` and `Bits`: where there is a
// finite list of types to write blocks for, the blocks are written, and where the family is open
// (`iN`/`uN`, which admit `i5` and `u24`) the membership has to be a rule instead. There are two
// floats, one `bool`, one `char` and one `string`, so these five are the written half.
//
// **What it buys is that these are ordinary trait members**, and a slot in a method table has to be
// a function that exists. A membership the compiler provides has none -- what it has is a rendering
// it splices in -- so a value holding one cannot be erased to a `*Display`. These five can.
//
// Each is one line because the work is in the `display_*` family, which is the same rendering the
// `print*` path reaches for the same type.

impl Display for bool
    display(self, out: *Writer, fmt: FormatSpec) = display_bool(self, out, fmt)

impl Display for char
    display(self, out: *Writer, fmt: FormatSpec) = display_char(self, out, fmt)

impl Display for string
    display(self, out: *Writer, fmt: FormatSpec) = display_str(self, out, fmt)

impl Display for real
    display(self, out: *Writer, fmt: FormatSpec) = display_real(self, out, fmt)

// The narrower float widens on the way in, which is what the lowering did for it before: one
// renderer per kind rather than one per type, and `%g` is written against a `double`.
impl Display for f32
    display(self, out: *Writer, fmt: FormatSpec) = display_real(real(self), out, fmt)
