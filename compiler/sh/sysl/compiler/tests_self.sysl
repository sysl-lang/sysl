module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.env.{get as env_var}
import sysl.fs.{make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture
import sysl.text.Search

// **The self-build's oracle: stage 1 and stage 2 must emit the same text for the same input.**
//
// Stage 1 is this compiler built by the installed release; stage 2 is this compiler built by stage 1. They
// are the same source, so a difference between their answers is not a difference of opinion -- it is
// stage 1 having miscompiled itself, or something in here that is not deterministic. Either way it
// is the one thing a self-build has to rule out before stage 3 is worth cutting.
//
// **The input is this compiler's own tree, in place**, which is both the largest sysl program there
// is and the program stage 2 was made out of, so a body that lowers differently is a body stage 3
// would inherit the difference through. The manifest states no `sysl` floor, so the working
// directory is what both stages are asked about rather than a copy edited on the way past.
//
// `SYSL_STAGE2` names the binary; with the variable unset the test returns at once and says so.
// `SYSL_LIB` is needed too, as it is for every whole-program sweep.

// Where the stage-2 binary is, or nothing where this machine has not built one.
private stage_two() -> Option[string] = env_var("SYSL_STAGE2")

// **What `sysl emit-llvm <path>` prints, made in process** -- the lowered text with every definition
// marked by `for_clang`, as the command marks it. `emit_llvm_text` alone is the text before that
// marking, so held against a stage's printed answer it differs at every `define` line and says
// nothing about whether the two stages agree.
private printed_llvm(path: string) -> Result[string, string]
    val at = build_level(path, None) match
        Err(why) -> return Err(failure_text(why))
        Ok(level) -> level

    val emitted = emit_llvm_text(path, None, at) match
        Err(why) -> return Err(why.message)
        Ok(made) -> made

    if !emitted.report.is_empty() then return Err(analysis_report(emitted.report))

    target_for(path, None) match
        Err(why) -> Err(why.message)
        Ok(t) -> Ok(for_clang(emitted.text, t))
end printed_llvm

// The stand-in has to be the command's own answer, or the stage comparison compares two printers.
@test("the in-process text the stages are held to is what emit-llvm prints, attribute group and all")
self_in_process_text_is_the_printed_text()
    if std_root().is_err() then return

    val root = make_temp_dir("sysl-self").unwrap()

    write_text(s"$root/package.hocon", "package {\n  name = \"probe\"\n}\n").unwrap()
    write_text(s"$root/main.sysl", "twice(n: int) -> int = n * 2\n\nprint(twice(21))\n").unwrap()

    var said: Buf[string] = buf()
    val sink = &said
    val code = run_cli(["sysl", "emit-llvm", root], piece -> sink.push(piece))
    var printed = ""

    for item in said
        printed = printed + item + "\n"

    reset_search_paths()
    assert_eq(code, 0)

    val mine = printed_llvm(root).unwrap()
    val one = func_texts(mine)
    val two = func_texts(printed)

    assert(mine.contains(") #99 {"), mine)
    assert(one.len() > 0 && one.len() == two.len(), s"${one.len()} in process, ${two.len()} printed")

    for item in one
        assert_eq(text_for(two, item.0).unwrap_or(""), item.1)

    remove_dir_all(root).unwrap_or(())
end self_in_process_text_is_the_printed_text

@test("stage 2 emits the text stage 1 does, over the whole of this compiler's own tree")
stage_one_and_stage_two_emit_the_same_text()
    stage_two() match
        None ->
            print("skipped: SYSL_STAGE2 names no stage-2 binary on this machine")
            return
        Some(binary) ->
            if library_units().is_empty()
                print("skipped: the standard module's source is not on this machine")
                return
            end if

            val theirs = capture(binary, ["emit-llvm", "."], "", [], true) match
                Err(_) ->
                    assert(false, "the stage-2 binary could not be run")
                    return
                Ok(answer) -> answer

            val mine = printed_llvm(".") match
                Err(why) ->
                    assert(false, s"stage 1 refused this tree: $why")
                    return
                Ok(text) -> text

            assert(theirs.status.ok(), s"stage 2 refused this tree: ${theirs.err.unwrap_or("")}")

            val two = func_texts(theirs.text)
            val one = func_texts(mine)
            var differing: usize = 0
            var first_bad = ""

            for item in one
                val name = item.0

                text_for(two, name) match
                    None ->
                        differing += 1

                        if differing <= 4
                            first_bad = s"$first_bad\nstage 2 defines no '@$name'"
                    Some(body) ->
                        if body != item.1
                            differing += 1

                            if differing <= 4
                                first_bad = s"$first_bad\n'@$name' differs" +
                                    s"${first_body_difference(body, item.1)}"

            val summary = s"the two stages: ${one.len()} definitions from stage 1, " +
                s"${two.len()} from stage 2, $differing differing"

            print(summary)
            assert(one.len() > 0, "stage 1 lowered something")
            assert(two.len() == one.len(), s"$summary$first_bad")
            assert(differing == 0, s"$summary$first_bad")
end stage_one_and_stage_two_emit_the_same_text

// **Stage 2 running a suite, which is the thing text identity was standing in for.**
//
// A stage that emits the same text is a stage that agrees about every body; a stage that *runs* a
// suite is a stage whose own dispatcher, process-per-test protocol and report are the ones being
// compared. This builds the same three tests both stages read, asks stage 2 for the report, and holds
// it to what stage 1 says in process -- so the ordering of the rows, the padding of the names and the
// two counts in the summary are all one answer or the comparison fails.
@test("stage 2 runs a suite and reports it exactly as stage 1 does")
stage_one_and_stage_two_report_a_suite_the_same_way()
    stage_two() match
        None ->
            print("skipped: SYSL_STAGE2 names no stage-2 binary on this machine")
            return
        Some(binary) ->
            if library_units().is_empty() || !clang_available()
                print("skipped: the standard module or a C toolchain is not on this machine")
                return
            end if

            val root = runner_project("main.sysl",
                                      "main()\n    print(\"hello\")\n\n" +
                                      "@test\nadds()\n    assert(1 + 1 == 2, \"arithmetic\")\n\n" +
                                      "@test(\"two plus two\")\ntwo_and_two()\n" +
                                      "    print(\"noise from a passing test\")\n" +
                                      "    assert(2 + 2 == 4, \"arithmetic\")\n\n" +
                                      "@test\nfails()\n    assert(false, \"meant to fail\")\n")
            val file = s"$root/main.sysl"

            val theirs = capture(binary, ["test", file], "", [], true) match
                Err(_) ->
                    remove_dir_all(root).unwrap_or(())
                    assert(false, "the stage-2 binary could not be run")
                    return
                Ok(answer) -> answer

            val mine = one_suite_report(file) match
                Err(why) ->
                    remove_dir_all(root).unwrap_or(())
                    assert(false, why)
                    return
                Ok(text) -> text

            remove_dir_all(root).unwrap_or(())

            // A suite with a failing test in it exits non-zero, which is the runner working rather
            // than the runner failing -- so what is read is the text and not the status.
            assert_eq(runner_timeless(theirs.text + theirs.err.unwrap_or("")),
                      runner_timeless(mine))
end stage_one_and_stage_two_report_a_suite_the_same_way

// One tree's suite, built and run in this process, as the whole report it comes to.
private one_suite_report(file: string) -> Result[string, string]
    val build = test_build_of(file, None) match
        Err(refusal) -> return Err(refusal.message)
        Ok(made) -> made

    if !build.emitted.report.is_empty() then return Err(analysis_report(build.emitted.report))

    val exe = build_test_binary(file, build, None, DefaultOptimization) match
        Err(refusal) -> return Err(refusal.message)
        Ok(built) -> built

    var said: Buf[string] = buf()
    val sink = &said

    run_selected(exe, build.tests, TestOptions(None, false), 0, piece -> sink.push(piece))
    discard_test_binary(exe)

    var out = ""

    for item in said
        out = out + item

    Ok(out)
end one_suite_report

// The library's trees, parsed once for the whole run; empty where the standard module's source is
// not on this machine.
private var library_cache: Buf[Program] = buf()
private var library_read: bool = false

library_units() -> Buf[Program]
    if library_read then return library_cache

    library_read = true

    std_root() match
        Err(_) -> ()
        Ok(root) -> std_units(root, host_target()) match
            Err(_) -> ()
            Ok(units) -> library_cache = units

    library_cache
end library_units

text_for(items: Buf[(string, string)], name: string) -> Option[string]
    for item in items
        if item.0 == name then return Some(item.1)

    None

// The first line of two bodies that disagrees, which is what a report of a mismatch is worth.
first_body_difference(theirs: string, ours: string) -> string
    val a = lines_of(theirs)
    val b = lines_of(ours)
    val n = if a.len() < b.len() then a.len() else b.len()

    for i in 0..<n
        if a.at(i) != b.at(i)
            return s" at line ${i + 1}: theirs '${a.at(i)}', ours '${b.at(i)}'"

    s" after ${n} lines: ${a.len()} lines theirs, ${b.len()} ours"
end first_body_difference
