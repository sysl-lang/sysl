module sh.sysl.compiler
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.Search
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture

// A bitfield struct held as a field of another bitfield struct (`reference/attributes.md §
// Bitfields`): it occupies its own fields' widths -- the bits it uses, not the whole bytes its own
// container rounds up to -- and a read or a write of one of its fields reaches through both
// containers. A page descriptor's lower attributes, ten bits at bit 2, are the case it exists for.

private bfn_ready() -> bool
    std_root() match
        Err(_) ->
            print("skipped: the standard module's source is not on this machine")
            return false
        Ok(_) -> ()

    if !clang_available()
        print("skipped: there is no clang on this machine")
        return false

    true
end bfn_ready

private bfn_says(text: string, part: string) -> bool = text.index_of(part).is_some()

// The descriptor of an aarch64 page table: a ten-bit attribute group two bits in, shared with the
// block and the stage 2 descriptors.
private bfn_desc() -> string =
    "@packed\nstruct Lower\n    attr: u3\n    ns: u1\n    ap: u2\n    sh: u2\n    af: u1\n    ng: u1\n" +
    "@packed\nstruct Desc\n    valid: u1\n    page: u1\n    lower: Lower\n    oa: u36\n    rest: u16\n" +
    "var d = Desc(1, 1, Lower(5, 0, 1, 3, 1, 0), 0x12345, 0xbeef)\n"

private bfn_ran(text: string) -> string
    val root = make_temp_dir("sysl-bfn").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", text).unwrap()

    val exe = s"$root/built"

    build_native_program(s"$root/main.sysl", None, None, DefaultOptimization, Some(exe)) match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return failure_text(why)
        Ok(_) -> ()

    val said = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    said match
        Err(_) -> "the program that was built could not be run"
        Ok(out) -> out.text
end bfn_ran

// The LLVM text of a program that must compile, or everything it had to say for itself.
private bfn_emit(text: string) -> string
    val root = make_temp_dir("sysl-bfn").unwrap()
    val src = s"$root/main.sysl"

    make_dir_all(root).unwrap()
    write_text(src, text).unwrap()

    val out = emit_llvm_text(src, None) match
        Err(why) -> why.message
        Ok(made) -> if made.report.is_empty() then made.text else analysis_report(made.report)

    remove_dir_all(root).unwrap_or(())
    out
end bfn_emit

// -- what a program prints --------------------------------------------------------------------------

// Ten bits rather than sixteen: with the group at its container's size the descriptor would be 70
// bits, nine bytes.
@test("a bitfield struct in a bitfield struct occupies its own fields' width")
bfn_occupies_its_own_width()
    if !bfn_ready() then return

    val out = bfn_ran(bfn_desc() +
                      "print(sizeof(Desc), d.lower.attr, d.lower.ap, d.lower.sh, d.lower.af, d.oa, d.rest)\n" +
                      "print(d.bits)")

    assert_eq(out, "8 5 1 3 1 74565 48879\n13758215386945574743\n")

@test("a write to a field of the inner struct leaves every other bit of both containers")
bfn_a_nested_write_composes()
    if !bfn_ready() then return

    val out = bfn_ran(bfn_desc() + "d.lower.ap = 2\nd.lower.attr += 1\n" +
                      "print(d.lower.attr, d.lower.ap, d.lower.sh, d.lower.af, d.lower.ng, d.valid, " +
                      "d.page, d.oa, d.rest)")

    assert_eq(out, "6 2 3 1 0 1 1 74565 48879\n")

@test("the inner struct is read, replaced and round-tripped through '.bits' and '::Bits' whole")
bfn_the_inner_struct_whole()
    if !bfn_ready() then return

    val out = bfn_ran(bfn_desc() + "print(d.lower.bits)\nd.lower = Lower(0, 1, 0, 0, 0, 1)\n" +
                      "val l = d.lower\nprint(l.bits, l.ns, l.ng, d.oa, d.rest, d.valid)\n" +
                      "val e = Desc::Bits(d.bits)\nprint(e.lower.ng, e.lower.attr, e.oa)")

    assert_eq(out, "469\n520 1 1 74565 48879 1\n1 0 74565\n")

@test("three levels deep, every container is written back")
bfn_three_levels()
    if !bfn_ready() then return

    val out = bfn_ran("@packed\nstruct A\n    x: u1\n    y: u2\n@packed\nstruct B\n    a: A\n    z: u3\n" +
                      "@packed\nstruct C\n    b: B\n    w: u2\n    v: u5\n" +
                      "var c = C(B(A(1, 2), 5), 3, 17)\nprint(sizeof(C), c.b.a.y, c.b.z, c.w, c.v, c.bits)\n" +
                      "c.b.a.y = 1\nprint(c.b.a.x, c.b.a.y, c.b.z, c.w, c.v, c.bits)")

    assert_eq(out, "2 2 5 3 17 4589\n1 1 5 3 17 4587\n")

@test("through a pointer, the write lands in the storage it points at")
bfn_through_a_pointer()
    if !bfn_ready() then return

    val out = bfn_ran(bfn_desc() + "var block: [8]u8 = [0; 8]\nvar p: *Desc = ptr_cast(&block[0])\n" +
                      "p.valid = 1\np.lower.sh = 2\nprint(block[0], block[1], p.lower.sh, p.lower.attr)")

    assert_eq(out, "1 2 2 0\n")

@test("a pattern takes the inner struct apart")
bfn_a_pattern_destructures()
    if !bfn_ready() then return

    val out = bfn_ran(bfn_desc() + "d match\n    Desc(_, _, Lower(at, _, ap, _, _, _), oa, _) -> print(at, ap, oa)")

    assert_eq(out, "5 1 74565\n")

// Only an odd-width integer or enum field makes the outer struct one integer, so a whole-byte
// `@packed` struct keeps the layout it always had: the bitfield struct as a field of its size.
@test("in a whole-byte packed struct it is still a field of its container's size")
bfn_a_whole_byte_outer_is_unchanged()
    if !bfn_ready() then return

    val out = bfn_ran("@packed\nstruct Lower\n    attr: u3\n    ns: u1\n    ap: u2\n    sh: u2\n    af: u1\n" +
                      "    ng: u1\n@packed\nstruct Pair\n    a: u8\n    lower: Lower\n    b: u8\n" +
                      "var q = Pair(7, Lower(5, 0, 1, 3, 1, 0), 9)\nq.lower.ng = 1\n" +
                      "print(sizeof(Pair), q.a, q.lower.bits, q.b)")

    assert_eq(out, "4 7 981 9\n")

// The range is cut to the inner struct's width on the way in and widened back to its container on
// the way out -- the ten bits two places up, at the container's own width.
@test("a nested read widens the range back to the inner container")
bfn_the_ir_shape()
    if !bfn_ready() then return

    val out = bfn_emit(bfn_desc() + "print(d.lower.bits)")

    assert(bfn_says(out, "trunc i64"), out)
    assert(bfn_says(out, "to i10"), out)
    assert(bfn_says(out, "zext i10"), out)
    assert(bfn_says(out, "insertvalue %struct.Lower undef, i16"), out)

// -- what is still refused ----------------------------------------------------------------------------

@test("an ordinary struct is not one integer, and the refusal says which struct nests")
bfn_an_ordinary_struct_is_refused()
    if !bfn_ready() then return

    val e = bfn_emit("struct Pt\n    a: u8\n    b: u8\n@packed\nstruct D\n    v: u1\n    p: Pt\n" +
                     "val d = D(1, Pt(1, 2))\nprint(d.v)")

    assert(bfn_says(e, "'D.p' is Pt, and 'D' is '@packed' with a field narrower than a byte"), e)
    assert(bfn_says(e, "Pt is laid out as fields rather than as one integer — only a '@packed' " +
                       "struct with a field narrower than a byte nests in another, in its own fields' width"), e)

@test("and so is a packed struct of whole bytes")
bfn_a_whole_byte_packed_struct_is_refused()
    if !bfn_ready() then return

    val e = bfn_emit("@packed\nstruct Pt\n    a: u8\n    b: u8\n@packed\nstruct D\n    v: u1\n    p: Pt\n" +
                     "val d = D(1, Pt(1, 2))\nprint(d.v)")

    assert(bfn_says(e, "'D.p' is Pt"), e)
    assert(bfn_says(e, "only a '@packed' struct with a field narrower than a byte nests in another"), e)
