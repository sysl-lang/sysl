module sysl.testing
@tests

import sysl.env.get
import sysl.fs.is_file

@test("compiler() answers the SYSL that sysl test gave the test, an executable file")
tcm_compiler_is_the_running_compiler()
    val given = get("SYSL")

    assert(given.is_some(), "SYSL is not in the environment of a test")
    assert(is_file(given.unwrap()), given.unwrap())
    assert(compiler() == given.unwrap(), compiler())
