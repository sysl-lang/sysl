module sh.sysl.compiler
@tests

import sh.sysl.parsing.source_of
import sysl.buf.{Buf, buf}
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.{capture, Var}
import sysl.text.{cstring, Search}

// A trait object or a closure that is itself a frame box, held in a local and called -- the call's
// receiver -- is counted by the compiler (`frame_counts.sysl`): its two words are stored in the local's
// slot, and the walk follows the box through that slot, through every load of it and into the word an
// `extractvalue` takes back out (`HeldAggSlot`, `Holders.boxed`). A closure laid in the frame by its
// capture mode is followed by the escape walk for what its tables do with it (`stack_box.sysl`'s
// `framed_closure_sites`), so a call of it lends it as a call of a trait object does.
//
// The cells: a trait object's method called on it, a closure called, the trait object handed to a
// direct call, one laid in a loop's body and called each turn, a payload with a destructor (its last
// release is `arc.framedown.<T>`, the destructor running once, where it ran), and a closure capturing
// a box (its payload holds a share, given back by the framedown). Left counted: a local reassigned, a
// receiver captured by a closure, stored in module storage, returned, handed to a callee that keeps
// it, or held inside another value (an `Option[&Reader]`), and the same program built as a library.
// Each runs on the counted heap at -O1, again at -O0 and -O2, and under AddressSanitizer.
//
// Skipped cells, and why: a rendering through a table (`TRender`) is no table call the walk names;
// codegen units change nothing, the pass running on each body as it is finished.

// -- the harness ----------------------------------------------------------------------------------

private struct FrcRun
    out: string
    err: string
    instrumented: bool
end FrcRun

// The program built at `level` on the counted heap, or with `flags` handed to clang, and run.
private frc_run(text: string, level: string, flags: string) -> FrcRun
    val root = make_temp_dir("sysl-frc").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", forms_imported(text)).unwrap()

    val exe = s"$root/built"

    if flags != ""
        val n = cstring("SYSL_EXTRA_CFLAGS")
        val v = cstring(flags)

        frc_c_setenv(n.ptr, v.ptr, 1)
    end if

    force_alloc_counting(flags == "")

    val made = build_native_program(s"$root/main.sysl", None, None, level, Some(exe))

    force_alloc_counting(false)

    if flags != ""
        val n = cstring("SYSL_EXTRA_CFLAGS")

        frc_c_unsetenv(n.ptr)
    end if

    made match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return FrcRun(failure_text(why), "", false)
        Ok(_) -> ()

    val symbols = capture("/usr/bin/nm", ["-u", exe], "", [], true)
    val instrumented = symbols match
        Ok(o) -> o.text.contains("___asan_report")
        Err(_) -> false

    val ran = capture(exe, [], "", [Var(alloc_bytes_variable(), "1")], true)

    remove_dir_all(root).unwrap_or(())

    ran match
        Err(_) -> FrcRun("could not be started", "", false)
        Ok(o) -> FrcRun(o.text, o.err.unwrap_or(""), instrumented)
end frc_run

private extern "setenv" frc_c_setenv(name: *u8, value: *u8, overwrite: int) -> int
private extern "unsetenv" frc_c_unsetenv(name: *u8) -> int

// The LLVM text of a program, or its report.
private frc_ir(text: string) -> string
    val root = make_temp_dir("sysl-frc").unwrap()

    write_text(s"$root/main.sysl", forms_imported(text)).unwrap()

    val out = emit_llvm_text(s"$root/main.sysl", None) match
        Err(why) -> failure_text(why)
        Ok(made) -> if made.report.is_empty() then made.text else analysis_report(made.report)

    remove_dir_all(root).unwrap_or(())
    out
end frc_ir

// The lines of the function defined at `@<symbol>(`.
private frc_body(ir: string, symbol: string) -> Buf[string]
    var out: Buf[string] = buf()
    var inside = false

    for line in lines_of(ir).view()
        if !inside && line.starts_with("define") && line.contains(s"@$symbol(") then inside = true

        if inside
            out.push(line)

            if line == "}" then break
        end if
    end for

    out
end frc_body

private frc_count(lines: Buf[string], part: string) -> int
    var n = 0

    for line in lines.view()
        if line.contains(part) then n += 1

    n
end frc_count

private frc_text(lines: Buf[string]) -> string
    var all = ""

    for line in lines.view()
        all = all + line + "\n"

    all
end frc_text

// The retains and releases of a reference a body makes.
private frc_shares(lines: Buf[string]) -> int =
    frc_count(lines, "@arc.retain(") + frc_count(lines, "@arc.release(") + frc_count(lines, "@arc.release.")

// The body at `symbol` lays a box in its frame and takes and gives back no share of it, and stands
// `framedown` calls of `arc.framedown.<T>` where its last share was given back.
private frc_uncounted(name: string, ir: string, symbol: string, framedown: int)
    val body = frc_body(ir, symbol)

    assert(frc_count(body, "= alloca %arc.") >= 1, s"$name lays no box in the frame of @$symbol")
    assert(frc_shares(body) == 0, s"$name takes or gives back a share:\n${frc_text(body)}")
    assert(frc_count(body, "@arc.framedown.") == framedown, s"$name:\n${frc_text(body)}")
end frc_uncounted

// The body at `symbol` still takes or gives back a share at run time.
private frc_counted(name: string, ir: string, symbol: string)
    val body = frc_body(ir, symbol)

    assert(!body.is_empty(), s"$name: no body at @$symbol")
    assert(frc_shares(body) > 0, s"$name gives back no share:\n${frc_text(body)}")
end frc_counted

// -- the cells counted by the compiler --------------------------------------------------------------

private const frc_trait: string = raw"""
    trait Reader
        read(self, p: &Point) -> int

    struct Point
        x: int
        y: int

    struct Sum
        k: int

    impl Reader for Sum
        read(self, p: &Point) -> int = p.x + p.y + self.k

    look(r: &Reader) -> int
        val p: &Point = Point(1, 1)

        r.read(p)

    run() -> int
        val r: &Reader = Sum(1)
        val p: &Point = Point(3, 4)

        r.read(p)

    direct() -> int
        val r: &Reader = Sum(2)

        look(r)

    turns() -> int
        var total = 0

        for i in 0..<3
            val r: &Reader = Sum(i)
            val p: &Point = Point(i, 1)

            total += r.read(p)
        end for

        total

    main()
        print(run(), direct(), turns())
    """

private const frc_closure: string = raw"""
    struct Point
        x: int
        y: int

    run(k: int) -> int
        val f: &Fn(&Point) -> int = q -> q.x + q.y + k
        val p: &Point = Point(3, 4)

        f(p) + f(p)

    main()
        print(run(1))
    """

private const frc_drop: string = raw"""
    trait Look
        look(self) -> int

    struct Res
        n: int

    impl Drop for Res
        drop(self) = print("closed", self.n)

    impl Look for Res
        look(self) -> int = self.n

    run()
        val r: &Look = Res(1)

        print(r.look())
        print("end")

    main()
        run()
        print("after")
    """

// The closure's payload holds a share of a box; the framedown gives it back.
private const frc_holding: string = raw"""
    struct Res
        n: int

    impl Drop for Res
        drop(self) = print("closed", self.n)

    run()
        val r: &Res = Res(7)
        val f: &Fn() -> int = () -> r.n + 1

        print(f())
        print("end")

    main()
        run()
        print("after")
    """

private frc_cells() -> Buf[(string, string)]
    var out: Buf[(string, string)] = buf()

    out.push((frc_trait, "8 4 9\n"))
    out.push((frc_closure, "16\n"))
    out.push((frc_drop, "1\nend\nclosed 1\nafter\n"))
    out.push((frc_holding, "8\nend\nclosed 7\nafter\n"))
    out
end frc_cells

// guards: frame trait object or closure called through its local takes no share
@test("a trait object or closure laid in the frame and called through its local takes and gives back no share")
frc_receivers_take_no_share()
    if xvr_no_library() then return

    val trait_ir = frc_ir(frc_trait)

    frc_uncounted("frc_trait", trait_ir, "run$$sysl", 0)
    frc_uncounted("frc_trait direct", trait_ir, "direct$$sysl", 0)
    frc_uncounted("frc_trait loop", trait_ir, "turns$$sysl", 0)
    frc_uncounted("frc_closure", frc_ir(frc_closure), "run$$sysl", 0)
    frc_uncounted("frc_drop", frc_ir(frc_drop), "run$$sysl", 1)

    val holding = frc_body(frc_ir(frc_holding), "run$$sysl")

    assert(frc_count(holding, "@arc.framedown.") == 1, s"frc_holding:\n${frc_text(holding)}")
    assert(frc_count(holding, "@arc.release.$closure") == 0, s"frc_holding:\n${frc_text(holding)}")
end frc_receivers_take_no_share

@test("each prints what it printed counted and gives back all it took, at -O0, -O1 and -O2")
frc_cells_run_at_every_level()
    if !enm_ready() then return

    for level in ["0", "1", "2"]
        for cell in frc_cells()
            val got = frc_run(cell.0, level, "")

            assert_eq(got.out, cell.1)
            assert_eq(alloc_count_reported(got.err), 0)
        end for
    end for
end frc_cells_run_at_every_level

@test("and under AddressSanitizer: instrumented, the destructor once, nothing read outside a live frame")
frc_cells_run_clean_under_asan()
    if !enm_ready() then return

    for cell in frc_cells()
        val got = frc_run(cell.0, "1", "-fsanitize=address -g")

        assert(got.instrumented, "the binary calls no AddressSanitizer report")
        assert_eq(got.out, cell.1)
        assert_eq(got.err, "")
    end for
end frc_cells_run_clean_under_asan

// -- the cells left counted ---------------------------------------------------------------------------

// The local is given a second trait object: the slot holds two boxes in turn.
private const frc_reassigned: string = raw"""
    trait Reader
        read(self) -> int

    struct Sum
        k: int

    impl Reader for Sum
        read(self) -> int = self.k

    run(again: bool) -> int
        var r: &Reader = Sum(1)
        var total = r.read()

        if again then r = Sum(2)

        total += r.read()
        total

    main()
        print(run(true), run(false))
    """

// The receiver is captured by a closure that is called.
private const frc_captured: string = raw"""
    trait Reader
        read(self) -> int

    struct Sum
        k: int

    impl Reader for Sum
        read(self) -> int = self.k

    run() -> int
        val r: &Reader = Sum(3)
        val g = () -> r.read() + 1

        r.read() + g()

    main()
        print(run())
    """

// The receiver is stored in module storage, returned, or handed to a callee that keeps it.
private const frc_kept: string = raw"""
    trait Reader
        read(self) -> int

    struct Sum
        k: int

    impl Reader for Sum
        read(self) -> int = self.k

    var kept: Option[&Reader] = None

    keep(r: &Reader) = kept = Some(r)

    stored() -> int
        val r: &Reader = Sum(1)

        kept = Some(r)
        r.read()

    returned() -> Option[&Reader]
        val r: &Reader = Sum(2)

        print(r.read())
        Some(r)

    handed() -> int
        val r: &Reader = Sum(3)

        keep(r)
        r.read()

    main()
        print(stored())
        print(returned().unwrap().read())
        print(handed(), kept.unwrap().read())
        kept = None
    """

// The trait object is held inside another value.
private const frc_wrapped: string = raw"""
    trait Reader
        read(self) -> int

    struct Sum
        k: int

    impl Reader for Sum
        read(self) -> int = self.k

    run() -> int
        val o: Option[&Reader] = Some(Sum(4))

        o match
            Some(r) -> r.read()
            None -> 0

    main()
        print(run())
    """

@test("a receiver reassigned, captured, stored, returned, handed to a keeping callee or wrapped stays counted")
frc_ways_left_counted()
    if xvr_no_library() then return

    frc_counted("frc_reassigned", frc_ir(frc_reassigned), "run$$sysl")
    frc_counted("frc_captured", frc_ir(frc_captured), "run$$sysl")
    frc_counted("frc_wrapped", frc_ir(frc_wrapped), "run$$sysl")

    val kept = frc_ir(frc_kept)

    frc_counted("frc_kept stored", kept, "stored$$sysl")
    frc_counted("frc_kept returned", kept, "returned$$sysl")
    frc_counted("frc_kept handed", kept, "handed$$sysl")

    if !enm_ready() then return

    for cell in [(frc_reassigned, "3 2\n"), (frc_captured, "7\n"), (frc_kept, "1\n2\n2\n3 3\n"), (frc_wrapped, "4\n")]
        for level in ["0", "2"]
            val got = frc_run(cell.0, level, "")

            assert_eq(got.out, cell.1)
            assert_eq(alloc_count_reported(got.err), 0)
        end for

        val asan = frc_run(cell.0, "1", "-fsanitize=address -g")

        assert(asan.instrumented, "the binary calls no AddressSanitizer report")
        assert_eq(asan.out, cell.1)
        assert_eq(asan.err, "")
    end for
end frc_ways_left_counted

// -- the build: a library sees only some of the tables ----------------------------------------------

private var frc_std_cache: Buf[Program] = buf()
private var frc_std_read: bool = false

private frc_std() -> Buf[Program]
    if frc_std_read then return frc_std_cache

    frc_std_read = true

    std_root() match
        Err(_) -> ()
        Ok(root) -> std_units(root, host_target()) match
            Err(_) -> ()
            Ok(units) -> frc_std_cache = units

    frc_std_cache
end frc_std

private frc_program(text: string) -> TProgram
    var units: Buf[Program] = buf()

    for item in frc_std()
        units.push(item)

    units.push(parse(source_of("test.sysl", text)).program)
    program_of(analyze_bodies(units, host_target()), "")
end frc_program

// The calls that share or give back a reference.
private frc_sum_shares(lines: Buf[string]) -> int
    var n = 0

    for line in lines.view()
        if line.contains("call void @arc.retain(") || line.contains("call void @arc.release") then n += 1

    n
end frc_sum_shares

@test("the same program built as a library gives the receiver its shares back at run time")
frc_library_build_stays_counted()
    if frc_std().is_empty() || !clang_available() then return

    val text = "module m\n\n" + forms_imported(frc_drop)
    var p = frc_program(text)
    val closed = frc_run_body(lines_of(codegen_text(p, host_target())))

    assert(!closed.is_empty(), "no body of 'run' in the program build")
    assert_eq(frc_sum_shares(closed), 0)

    p.entry_point = false

    val open = frc_run_body(lines_of(codegen_text(p, host_target())))

    assert(frc_sum_shares(open) > 0, s"the library build gives back no share of the receiver:\n${frc_text(open)}")
end frc_library_build_stays_counted

// The lines of `run`, under whatever module its name is mangled in.
private frc_run_body(lines: Buf[string]) -> Buf[string]
    var out: Buf[string] = buf()
    var inside = false

    for line in lines.view()
        if !inside && line.starts_with("define") && line.contains("run") && !line.contains("main") then inside = true

        if inside
            out.push(line)

            if line == "}" then break
        end if
    end for

    out
end frc_run_body
