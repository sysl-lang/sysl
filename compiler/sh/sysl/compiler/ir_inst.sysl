module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.math.bigint.{BigInt, to_string}
import sysl.text.{str_builder, StrBuilder}

// **An instruction, as data.** Every mnemonic the back end writes, with its operands as values
// rather than as text.
//
// There is no `phi`, and that is a fact about the lowering rather than an omission: codegen keeps
// every local in a stack slot and reaches it with `load` and `store`, so what a consumer receives is
// memory form and it may promote or not as it likes.

// The arithmetic and bitwise operations LLVM names one word each.
enum BinOp
    OpAdd
    // An add the lowering proved cannot wrap as unsigned (`nowrap.sysl`).
    OpAddNuw
    OpSub
    OpMul
    OpSDiv
    OpUDiv
    OpSRem
    OpURem
    OpShl
    OpAShr
    OpLShr
    OpAnd
    OpOr
    OpXor
    OpFAdd
    OpFSub
    OpFMul
    OpFDiv
    // A float sum, difference or product the program let the back end regroup (`reassociate.sysl`),
    // written with LLVM's `reassoc` flag.
    OpFAddReassoc
    OpFSubReassoc
    OpFMulReassoc
end BinOp

bin_render(op: BinOp) -> string = op match
    OpAdd -> "add"
    OpAddNuw -> "add nuw"
    OpSub -> "sub"
    OpMul -> "mul"
    OpSDiv -> "sdiv"
    OpUDiv -> "udiv"
    OpSRem -> "srem"
    OpURem -> "urem"
    OpShl -> "shl"
    OpAShr -> "ashr"
    OpLShr -> "lshr"
    OpAnd -> "and"
    OpOr -> "or"
    OpXor -> "xor"
    OpFAdd -> "fadd"
    OpFSub -> "fsub"
    OpFMul -> "fmul"
    OpFDiv -> "fdiv"
    OpFAddReassoc -> "fadd reassoc"
    OpFSubReassoc -> "fsub reassoc"
    OpFMulReassoc -> "fmul reassoc"

// The conversions, which are the same instruction shape whatever the pair of types.
enum CastOp
    CastTrunc
    CastZExt
    CastSExt
    CastFPTrunc
    CastFPExt
    CastFPToUI
    CastFPToSI
    CastUIToFP
    CastSIToFP
    CastPtrToInt
    CastIntToPtr
    CastBitCast
end CastOp

cast_render(op: CastOp) -> string = op match
    CastTrunc -> "trunc"
    CastZExt -> "zext"
    CastSExt -> "sext"
    CastFPTrunc -> "fptrunc"
    CastFPExt -> "fpext"
    CastFPToUI -> "fptoui"
    CastFPToSI -> "fptosi"
    CastUIToFP -> "uitofp"
    CastSIToFP -> "sitofp"
    CastPtrToInt -> "ptrtoint"
    CastIntToPtr -> "inttoptr"
    CastBitCast -> "bitcast"

// An integer comparison, which says whether the operands are read as signed.
enum ICmp
    IEq
    INe
    IUgt
    IUge
    IUlt
    IUle
    ISgt
    ISge
    ISlt
    ISle
end ICmp

icmp_render(p: ICmp) -> string = p match
    IEq -> "eq"
    INe -> "ne"
    IUgt -> "ugt"
    IUge -> "uge"
    IUlt -> "ult"
    IUle -> "ule"
    ISgt -> "sgt"
    ISge -> "sge"
    ISlt -> "slt"
    ISle -> "sle"

// A float comparison, which says what it answers when an operand is a NaN: `o` for ordered, `u`
// for unordered.
enum FCmp
    FOeq
    FOne
    FOgt
    FOge
    FOlt
    FOle
    FOrd
    FUeq
    FUne
    FUgt
    FUge
    FUlt
    FUle
    FUno
end FCmp

fcmp_render(p: FCmp) -> string = p match
    FOeq -> "oeq"
    FOne -> "one"
    FOgt -> "ogt"
    FOge -> "oge"
    FOlt -> "olt"
    FOle -> "ole"
    FOrd -> "ord"
    FUeq -> "ueq"
    FUne -> "une"
    FUgt -> "ugt"
    FUge -> "uge"
    FUlt -> "ult"
    FUle -> "ule"
    FUno -> "uno"

// How strongly an atomic access is ordered against everything around it.
enum IrOrdering
    OrdRelaxed
    OrdAcquire
    OrdRelease
    OrdAcqRel
    OrdSeqCst
end IrOrdering

// LLVM's spelling, which is its own for three of the five.
ord_render(o: IrOrdering) -> string = o match
    OrdRelaxed -> "monotonic"
    OrdAcquire -> "acquire"
    OrdRelease -> "release"
    OrdAcqRel -> "acq_rel"
    OrdSeqCst -> "seq_cst"

// The ordering a compare-and-exchange is held to on the attempt that did not take: it may not be
// stronger than the success ordering, and it may not be a release, because nothing was published.
ord_on_failure(o: IrOrdering) -> IrOrdering = o match
    OrdRelease -> OrdRelaxed
    OrdAcqRel -> OrdAcquire
    _ -> o

// What kind of access a load or a store is.
//
// **The two `AccBuf` kinds are plain accesses that say which side of a `Buf` they touch**: its header
// (the `Buf` handle in its box, and the `BufCore` holding the storage view and the count) or one of
// its elements. A buffer's elements live in an allocation of their own, never inside a header, so
// each kind is told the other is not what it touches (`reference/arrays.md § Its elements are never
// its header`), and the optimizer can keep the header in registers across a loop that writes elements.
//
// **`AccBufBox` is the handle in a box of its own** (`&Buf[T]`), the box being an allocation neither
// the `BufCore` nor the elements are in. `AccBufHeader` is the `BufCore`.
//
// **`AccBufHandle` is a `Buf` handle held anywhere else** -- a field of a struct, say -- and all it
// and the `BufCore` are told is that they are not each other: a `BufCore` holds a view and a count and
// no handle, and a handle is never inside a `BufCore`. So a write to the count does not make the
// optimizer read the handle again. It says nothing about elements, which may hold handles themselves
// (`Buf[Buf[T]]`) or, in storage a program lays out itself, any bytes at all; nor about a box, which a
// `*Buf` taken from the box reads as this kind.
//
// **`AccVolatileA64` is a volatile access on AArch64, written as the one plain instruction it is**:
// an `ldr`/`str` (or its `b`/`h` form) of the declared width into a general register, the address a
// bare register (`a64_volatile_bytes`). LLVM's own `load volatile` may be selected as a post-indexed
// `ldr x9, [x0], #-8`, or into a floating-point register, and a hypervisor cannot emulate either at a
// device -- the trap carries no syndrome (ISV=0). An `asm` is the one form no LLVM rewrites. `emit`
// chooses it; every pass reads it as it reads `AccVolatile`.
//
// **`AccVolatileArm` is the same on 32-bit ARM (Thumb)**: one `ldr`/`str` (`b`/`h`) of a general
// register from a bare register address, where LLVM's own may be a post-indexed `ldr r3, [r2], #4`, an
// `ldm r2!, {r3}`, or a `vldr s2, [r0]` -- an `ldm`/`stm` an exception may abandon and restart, so a
// read-to-clear register is read twice. A volatile wider than a word there is one such access per word,
// lowest address first (`arm_volatile_words`, `emit.sysl`'s `emit_arm_words`).
enum IrAccess
    AccPlain
    AccVolatile
    AccVolatileA64
    AccVolatileArm
    AccAtomic(ordering: IrOrdering)
    AccBufHeader
    AccBufBox
    AccBufElement
    AccBufHandle
end IrAccess

// Whether an access says nothing beyond "read it" or "write it": a plain one, or a plain one with a
// `Buf` scope beside it. A pass that reasons about plain loads and stores asks this, never for
// `AccPlain` alone -- the scope is a licence the back end may take, and it does not make the access
// any less plain, so a `b[i]` read is the same field read to every pass that it was before it
// carried one.
is_plain_access(acc: IrAccess) -> bool = acc match
    AccPlain | AccBufHeader | AccBufBox | AccBufElement | AccBufHandle -> true
    AccVolatile | AccVolatileA64 | AccVolatileArm | AccAtomic(_) -> false

// The bytes a volatile access of `ty` moves as one plain AArch64 instruction into a general register,
// or `None` where no one such instruction moves it: storage of 1, 2, 4 or 8 bytes (an `i1`, an `i12`
// and a `half` included, an `i24` or an `i128` not), at no less than its natural alignment.
a64_volatile_bytes(ty: LType, align: Option[int]) -> Option[int] = plain_volatile_bytes(ty, align, 8)

// The same on 32-bit ARM, whose general registers and pointers are 4 bytes: storage of 1, 2 or 4.
arm_volatile_bytes(ty: LType, align: Option[int]) -> Option[int] = plain_volatile_bytes(ty, align, 4)

// The 32-bit words a volatile of `ty` is made as on 32-bit ARM, where it is wider than one: an integer or
// float of a whole number of words (a `u64`, an `f64`, a `u128`), at no less than a word's alignment.
// `None` for anything one access moves, or that no run of word accesses moves exactly (a `u48`, which
// the analyzer refuses there).
arm_volatile_words(ty: LType, align: Option[int]) -> Option[int]
    val bits = ty match
        LInt(n) -> n
        LFloat(n, _) -> n
        _ -> return None

    if bits <= 32 || bits % 32 != 0 then return None

    align match
        Some(a) if a < 4 -> None
        _ -> Some(bits / 32)
end arm_volatile_words

// The bytes of `ty`'s storage where one `ldr`/`str` of a `word`-byte general register moves it.
private plain_volatile_bytes(ty: LType, align: Option[int], word: int) -> Option[int]
    val bits = ty match
        LInt(n) -> n
        LFloat(n, _) -> n
        LPtr -> word * 8
        _ -> return None

    val bytes = (bits + 7) / 8

    if bytes != 1 && bytes != 2 && bytes != 4 && bytes != 8 || bytes > word then return None

    align match
        Some(a) if a < bytes -> None
        _ -> Some(bytes)
end plain_volatile_bytes

// `ldr`/`str` with the width's suffix and the register operand `n` at the width's view of it.
private a64_mnemonic(op: string, bytes: int) -> string = bytes match
    1 -> op + "b"
    2 -> op + "h"
    _ -> op

private a64_reg(n: int, bytes: int) -> string = "${" + n.to_string() + (if bytes == 8 then ":x}" else ":w}")

// A volatile load as one `ldr` from a register address. The `asm` declares no memory effects, so the
// optimizer treats it as reading and writing anything: it is neither moved nor dropped. On 32-bit ARM
// (`arm`) a register has one view, `$0`.
private plain_volatile_load(d: Val, ty: LType, p: Val, bytes: int, arm: bool) -> string =
    s"${v_render(d)} = call ${l_render(ty)} asm sideeffect \"" + a64_mnemonic("ldr", bytes) + " " +
        (if arm then "$0" else a64_reg(0, bytes)) + ", [$1]\", \"=r,r,~{memory}\"(ptr " + v_render(p) + ")"

// A volatile store as one `str` to a register address.
private plain_volatile_store(ty: LType, v: Val, p: Val, bytes: int, arm: bool) -> string =
    "call void asm sideeffect \"" + a64_mnemonic("str", bytes) + " " + (if arm then "$0" else a64_reg(0, bytes)) +
        ", [$1]\", \"r,r,~{memory}\"(" + l_render(ty) + " " + v_render(v) + ", ptr " + v_render(p) + ")"

// Whether `ty` is an integer narrower than the storage it is moved at -- a `bool`'s `i1`, a `u12`'s
// `i12`. Such a value is never an `asm` operand: `emit` moves the storage's width and converts beside
// it, LLVM 21 being one that crashes on an `i12` operand.
a64_narrow(ty: LType, bytes: int) -> bool = ty match
    LInt(n) -> n != bytes * 8
    _ -> false

// The bytes an `AccVolatileA64` (`AccVolatileArm` where `arm`) access is written as one instruction
// for: one `a64_volatile_bytes` (`arm_volatile_bytes`) admits, at a type that is its storage's own width.
private plain_written(ty: LType, align: Option[int], arm: bool) -> Option[int] =
    plain_volatile_bytes(ty, align, if arm then 4 else 8) match
        Some(n) if !a64_narrow(ty, n) -> Some(n)
        _ -> None

// What a call says about floating point: a relaxation the back end is allowed (`reassoc`, written
// after `call`), or `strictfp`, which every call inside a `@strict_fp` body carries
// (`emit_strict_fp.sysl`). LLVM takes the second as a call-site function attribute, so it is
// written after the arguments.
enum FastMath
    FmReassoc
    FmStrict
    // `returns_twice`, the call-site attribute of a call to `setjmp` and its kin: it keeps LLVM from
    // making the call a tail call and from optimising across its second return. Written after the
    // arguments like `strictfp`.
    FmReturnsTwice
end FastMath

fast_render(f: FastMath) -> string = f match
    FmReassoc -> "reassoc"
    FmStrict -> ""
    FmReturnsTwice -> ""

// The read-modify-write operations an atomic may name.
enum RmwOp
    RmwXchg
    RmwAdd
    RmwSub
    RmwAnd
    RmwOr
    RmwXor
end RmwOp

rmw_render(op: RmwOp) -> string = op match
    RmwXchg -> "xchg"
    RmwAdd -> "add"
    RmwSub -> "sub"
    RmwAnd -> "and"
    RmwOr -> "or"
    RmwXor -> "xor"

// One instruction.
enum Inst
    InBin(dest: Val, op: BinOp, ty: LType, a: Val, b: Val)
    InNeg(dest: Val, ty: LType, v: Val)
    InIntCmp(dest: Val, pred: ICmp, ty: LType, a: Val, b: Val)
    InFloatCmp(dest: Val, pred: FCmp, ty: LType, a: Val, b: Val)
    InCast(dest: Val, op: CastOp, from: LType, v: Val, to: LType)
    InAlloca(dest: Val, ty: LType, align: Option[int])
    InLoad(dest: Val, ty: LType, ptr: Val, access: IrAccess, align: Option[int])
    InStore(ty: LType, value: Val, ptr: Val, access: IrAccess, align: Option[int])
    InGep(dest: Val, ty: LType, ptr: Val, indices: Buf[IrArg])
    // A step the program has already proved stays inside its object -- an element whose index was
    // checked against the length, of storage that holds that many -- written `inbounds`. What LLVM
    // learns is that the index arithmetic does not wrap, which is what lets it tell `xs[i].a` from
    // `xs[j].b` by their offsets modulo the stride (`emit_place.sysl`'s `element_gep`).
    InGepInBounds(dest: Val, ty: LType, ptr: Val, indices: Buf[IrArg])
    InExtract(dest: Val, ty: LType, agg: Val, indices: Buf[int])
    InInsert(dest: Val, ty: LType, agg: Val, value_ty: LType, value: Val, indices: Buf[int])
    InSelect(dest: Val, cond: Val, ty: LType, a: Val, b: Val, cond_ty: LType)
    InInsertElement(dest: Val, ty: LType, vec: Val, elem_ty: LType, value: Val, index: IrArg)
    InExtractElement(dest: Val, ty: LType, vec: Val, index: IrArg)
    InShuffle(dest: Val, ty: LType, a: Val, b: Val, mask: IrArg)
    InAsm(dest: Option[Val], ret: LType, text: string, constraints: string, args: Buf[IrArg])
    InCall(dest: Option[Val], ret: LType, callee: Val, args: Buf[IrArg], ret_attrs: Buf[IrAttr],
           callee_type: Option[IrFnType], fast: Buf[FastMath], must_tail: bool)
    InVaArg(dest: Val, list: Val, ty: LType)
    InAtomicRmw(dest: Val, op: RmwOp, ptr: Val, ty: LType, value: Val, ordering: IrOrdering)
    InCmpXchg(dest: Val, ptr: Val, ty: LType, expected: Val, desired: Val, ordering: IrOrdering)
    InFence(ordering: IrOrdering)
    InBr(label: string)
    InCondBr(cond: Val, if_true: string, if_false: string)
    InRet(ty: Option[LType], value: Option[Val])
    InSwitch(ty: LType, value: Val, default: string, cases: Buf[(BigInt, string)])
    InUnreachable
end Inst

// Whether an instruction ends its block, which is what makes it a terminator.
inst_terminates(i: Inst) -> bool = i match
    InBr(_) -> true
    InCondBr(_, _, _) -> true
    InRet(_, _) -> true
    InSwitch(_, _, _, _) -> true
    InUnreachable -> true
    _ -> false

// A plain call with nothing said about it.
ir_call(dest: Option[Val], ret: LType, callee: Val, args: Buf[IrArg]) -> Inst
    var fast: Buf[FastMath] = buf()

    InCall(dest, ret, callee, args, no_ir_attrs(), None, fast, false)
end ir_call

// The empty argument list.
no_ir_args() -> Buf[IrArg]
    var out: Buf[IrArg] = buf()

    out
end no_ir_args

// The LLVM text for one instruction, and the only place any of it is written down.
inst_render(i: Inst) -> string = i match
    InBin(d, op, ty, a, b) ->
        s"${v_render(d)} = ${bin_render(op)} ${l_render(ty)} ${v_render(a)}, ${v_render(b)}"
    InNeg(d, ty, v) -> s"${v_render(d)} = fneg ${l_render(ty)} ${v_render(v)}"
    InIntCmp(d, p, ty, a, b) ->
        s"${v_render(d)} = icmp ${icmp_render(p)} ${l_render(ty)} ${v_render(a)}, ${v_render(b)}"
    InFloatCmp(d, p, ty, a, b) ->
        s"${v_render(d)} = fcmp ${fcmp_render(p)} ${l_render(ty)} ${v_render(a)}, ${v_render(b)}"
    InCast(d, op, f, v, t) ->
        s"${v_render(d)} = ${cast_render(op)} ${l_render(f)} ${v_render(v)} to ${l_render(t)}"
    InAlloca(d, ty, align) -> s"${v_render(d)} = alloca ${l_render(ty)}${align_text(align)}"
    InLoad(d, ty, p, AccVolatileA64, align) if plain_written(ty, align, false).is_some() ->
        plain_volatile_load(d, ty, p, plain_written(ty, align, false).unwrap(), false)
    InStore(ty, v, p, AccVolatileA64, align) if plain_written(ty, align, false).is_some() ->
        plain_volatile_store(ty, v, p, plain_written(ty, align, false).unwrap(), false)
    InLoad(d, ty, p, AccVolatileArm, align) if plain_written(ty, align, true).is_some() ->
        plain_volatile_load(d, ty, p, plain_written(ty, align, true).unwrap(), true)
    InStore(ty, v, p, AccVolatileArm, align) if plain_written(ty, align, true).is_some() ->
        plain_volatile_store(ty, v, p, plain_written(ty, align, true).unwrap(), true)
    InLoad(d, ty, p, acc, align) ->
        s"${v_render(d)} = load${access_text(acc)} ${l_render(ty)}, ptr ${v_render(p)}" +
            s"${order_text(acc)}${align_text(align)}${scope_text(acc)}"
    InStore(ty, v, p, acc, align) ->
        s"store${access_text(acc)} ${l_render(ty)} ${v_render(v)}, ptr ${v_render(p)}" +
            s"${order_text(acc)}${align_text(align)}${scope_text(acc)}"
    // An element that holds nothing -- a `never`, reached as `Buf[never]`'s -- is stepped over as the
    // empty struct, every offset being zero; LLVM takes no `void` here.
    InGep(d, ty, p, idx) ->
        val stepped = ty match
            LVoid -> "{}"
            _ -> l_render(ty)

        s"${v_render(d)} = getelementptr $stepped, ptr ${v_render(p)}, ${arg_list(idx)}"
    InGepInBounds(d, ty, p, idx) ->
        val stepped = ty match
            LVoid -> "{}"
            _ -> l_render(ty)

        s"${v_render(d)} = getelementptr inbounds $stepped, ptr ${v_render(p)}, ${arg_list(idx)}"
    InExtract(d, ty, agg, idx) ->
        s"${v_render(d)} = extractvalue ${l_render(ty)} ${v_render(agg)}, ${int_list(idx)}"
    InInsert(d, ty, agg, vty, v, idx) ->
        s"${v_render(d)} = insertvalue ${l_render(ty)} ${v_render(agg)}, ${l_render(vty)} " +
            s"${v_render(v)}, ${int_list(idx)}"
    InSelect(d, c, ty, a, b, ct) ->
        s"${v_render(d)} = select ${l_render(ct)} ${v_render(c)}, ${l_render(ty)} ${v_render(a)}, " +
            s"${l_render(ty)} ${v_render(b)}"
    InInsertElement(d, ty, vec, ety, v, ix) ->
        s"${v_render(d)} = insertelement ${l_render(ty)} ${v_render(vec)}, ${l_render(ety)} " +
            s"${v_render(v)}, ${arg_render(ix)}"
    InExtractElement(d, ty, vec, ix) ->
        s"${v_render(d)} = extractelement ${l_render(ty)} ${v_render(vec)}, ${arg_render(ix)}"
    InShuffle(d, ty, a, b, mask) ->
        s"${v_render(d)} = shufflevector ${l_render(ty)} ${v_render(a)}, ${l_render(ty)} " +
            s"${v_render(b)}, ${arg_render(mask)}"
    InAsm(d, ret, text, cons, args) ->
        s"${dest_text(d)}call ${l_render(ret)} asm sideeffect \"$text\", \"$cons\"(${arg_list(args)})"
    InCall(d, ret, callee, args, ret_attrs, fn, fast, must) ->
        s"${dest_text(d)}${if must then "musttail " else ""}call ${fast_text(fast)}" +
            s"${call_kind(ret, ret_attrs, fn)} ${v_render(callee)}(${arg_list(args)})${strict_text(fast)}"
    InVaArg(d, list, ty) -> s"${v_render(d)} = va_arg ptr ${v_render(list)}, ${l_render(ty)}"
    InAtomicRmw(d, op, p, ty, v, ord) ->
        s"${v_render(d)} = atomicrmw ${rmw_render(op)} ptr ${v_render(p)}, ${l_render(ty)} " +
            s"${v_render(v)} ${ord_render(ord)}"
    InCmpXchg(d, p, ty, e, n, ord) ->
        s"${v_render(d)} = cmpxchg ptr ${v_render(p)}, ${l_render(ty)} ${v_render(e)}, " +
            s"${l_render(ty)} ${v_render(n)} ${ord_render(ord)} ${ord_render(ord_on_failure(ord))}"
    InFence(ord) -> s"fence ${ord_render(ord)}"
    InBr(l) -> s"br label %$l"
    InCondBr(c, t, f) -> s"br i1 ${v_render(c)}, label %$t, label %$f"
    InRet(ty, value) -> ty match
        None -> "ret void"
        Some(t) -> value match
            Some(v) -> s"ret ${l_render(t)} ${v_render(v)}"
            None -> s"ret ${l_render(t)}"
    InUnreachable -> "unreachable"
    InSwitch(ty, v, default, cases) ->
        s"switch ${l_render(ty)} ${v_render(v)}, label %$default [ ${switch_arms(ty, cases)} ]"

// The `%d = ` a result is bound by, or nothing where the instruction produces none.
private dest_text(d: Option[Val]) -> string = d match
    Some(r) -> s"${v_render(r)} = "
    None -> ""

// What a call names between `call` and the callee: the whole function type where the call needs one
// -- a variadic callee does -- and the result alone where it does not.
private call_kind(ret: LType, ret_attrs: Buf[IrAttr], fn: Option[IrFnType]) -> string = fn match
    Some(t) -> fn_render(t)
    None ->
        var b = str_builder()

        for ret_attr in ret_attrs
            b.push(attr_render(ret_attr))
            b.push_char(' ')

        b.push(l_render(ret))
        b.finish()

private fast_text(fast: Buf[FastMath]) -> string
    var b = str_builder()

    for item in fast
        if item == FmStrict || item == FmReturnsTwice then continue

        b.push(fast_render(item))
        b.push_char(' ')

    b.finish()
end fast_text

// ` returns_twice` and ` strictfp` where the call carries them, after the arguments.
private strict_text(fast: Buf[FastMath]) -> string
    var out = ""

    for item in fast
        if item == FmReturnsTwice then out = out + " returns_twice"

    for item in fast
        if item == FmStrict then out = out + " strictfp"

    out
end strict_text

private arg_list(args: Buf[IrArg]) -> string
    var b = str_builder()

    for i in 0..<args.len()
        if i > 0 then b.push(", ")

        b.push(arg_render(args[i]))

    b.finish()
end arg_list

private int_list(idx: Buf[int]) -> string
    var b = str_builder()

    for i in 0..<idx.len()
        if i > 0 then b.push(", ")

        b.push(idx[i].to_string())

    b.finish()
end int_list

private switch_arms(ty: LType, cases: Buf[(BigInt, string)]) -> string
    var b = str_builder()

    for i in 0..<cases.len()
        if i > 0 then b.push_char(' ')

        val arm = cases[i]

        b.push(s"${l_render(ty)} ${to_string(arm.0)}, label %${arm.1}")

    b.finish()
end switch_arms

private access_text(a: IrAccess) -> string = a match
    AccVolatile | AccVolatileA64 | AccVolatileArm -> " volatile"
    AccAtomic(_) -> " atomic"
    _ -> ""

// The scope a `Buf` access is in and the one it is said not to touch. The scopes are named by strings
// rather than by numbered nodes, so they are one scope in every module that names them -- a std
// artifact's copy of a member and the program that inlines it agree on what they mean -- and the text
// needs no metadata table at the end of the module.
private scope_text(a: IrAccess) -> string = a match
    AccBufHeader -> s", !alias.scope ${buf_scope("header")}, !noalias ${buf_scope_list("elements", "handle")}"
    AccBufBox -> s", !alias.scope ${buf_scope("box")}, !noalias ${buf_scope_list("elements", "header")}"
    AccBufElement -> s", !alias.scope ${buf_scope("elements")}, !noalias ${buf_scope_list("header", "box")}"
    AccBufHandle -> s", !alias.scope ${buf_scope("handle")}, !noalias ${buf_scope("header")}"
    _ -> ""

private buf_scope(side: string) -> string = s"!{${buf_scope_node(side)}}"

private buf_scope_list(a: string, b: string) -> string = s"!{${buf_scope_node(a)}, ${buf_scope_node(b)}}"

private buf_scope_node(side: string) -> string = s"!{!\"sysl.buf.$side\", !{!\"sysl.buf\"}}"

private order_text(a: IrAccess) -> string = a match
    AccAtomic(o) -> s" ${ord_render(o)}"
    _ -> ""

private align_text(align: Option[int]) -> string = align match
    Some(n) -> s", align $n"
    None -> ""
