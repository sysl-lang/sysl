module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.{str_builder, StrBuilder}

// The tree, as parenthesised prefix notation, and a type as it was written.
//
// **The first of these exists for the tests, and that is the whole of its brief.** A parser is
// checked by pinning the shape it produced, and a shape is only worth pinning if a person can read
// it: `(+ 1 (* 2 3))` says what a field-by-field dump of a nested struct does not. Precedence,
// associativity and the index-versus-type-argument decision are all visible at a glance.
//
// **The second exists for the diagnostics**, and is a different function for a reason rather than by
// oversight: half a dozen refusals quote the type back at the reader in the spelling they wrote --
// `'(int)' is a type in parentheses` -- and what that wants is the source form, not a tree.

// -- the written form of a type ------------------------------------------------------------------

// A type as a program would write it. The bootstrap compiler's `TypeRef.show`, mirrored because the
// messages that embed it are mirrored.
type_text(t: TypeRef) -> string
    var out = str_builder()

    write_type_text(&out, t)
    out.finish()

private write_type_list(out: *StrBuilder, ts: Buf[TypeRef])
    for i in 0..<ts.len()
        if i > 0 then out.push(", ")

        write_type_text(out, ts.at(i))

private write_type_text(out: *StrBuilder, t: TypeRef)
    *t.kind match
        NamedType(n, args) ->
            out.push(n)

            if !args.is_empty()
                out.push_char('[')
                write_type_list(out, args)
                out.push_char(']')
        PtrType(inner) ->
            out.push_char('*')
            write_type_text(out, inner)
        RefType(inner, sync) ->
            out.push_char('&')

            if sync then out.push("sync ")

            write_type_text(out, inner)
        WeakType(inner) ->
            out.push("weak ")
            write_type_text(out, inner)
        ArrayType(length, elem, ro) ->
            length match
                None ->
                    out.push("[]")

                    if ro then out.push("const ")
                Some(n) ->
                    out.push_char('[')

                    *n.kind match
                        IntLit(digits, _, _) -> out.push(digits)
                        _ -> out.push("\u{2026}")

                    out.push_char(']')

            write_type_text(out, elem)
        VectorType(lanes, elem) ->
            out.push_char('<')

            *lanes.kind match
                IntLit(digits, _, _) -> out.push(digits)
                Ident(n) -> out.push(n)
                _ -> out.push("\u{2026}")

            out.push_char('>')
            write_type_text(out, elem)
        VolatileType(inner) ->
            out.push("volatile ")
            write_type_text(out, inner)
        TupleType(parts, results) ->
            if results
                write_type_list(out, parts)
            else
                out.push_char('(')
                write_type_list(out, parts)
                out.push_char(')')
        PackType(n) -> out.push(s"..${n}")
        FnType(params, ret, bare) ->
            if bare && params.len() == 1
                write_type_text(out, params.at(0))
            else
                if !bare then out.push("Fn")

                out.push_char('(')
                write_type_list(out, params)
                out.push_char(')')

            out.push(" -> ")
            write_type_text(out, ret)
        CFnType(params, ret) ->
            out.push("*extern(")
            write_type_list(out, params)
            out.push(") -> ")
            write_type_text(out, ret)
        ValueArgType(v) ->
            *v.kind match
                IntLit(digits, _, _) -> out.push(digits)
                Ident(n) -> out.push(n)
                _ -> out.push("\u{2026}")
        AssocType(base, member) ->
            write_type_text(out, base)
            out.push(s"::${member}")
        AssocArgType(n, typ) ->
            out.push(s"${n} = ")
            write_type_text(out, typ)
        SomeType(bounds) ->
            out.push("some ")

            for i in 0..<bounds.len()
                if i > 0 then out.push(" + ")

                out.push(bound_text(bounds.at(i)))
end write_type_text

// A trait named as a bound, as it was written.
bound_text(b: BoundRef) -> string
    if b.args.is_empty() then return b.name

    var out = str_builder()

    out.push(b.name)
    out.push_char('[')
    write_type_list(&out, b.args)
    out.push_char(']')
    out.finish()
end bound_text

// -- the tree, as a shape a test can read ---------------------------------------------------------

show_expr(e: Expr) -> string
    var out = str_builder()

    write_expr(&out, e)
    out.finish()

show_type(t: TypeRef) -> string
    var out = str_builder()

    write_type(&out, t)
    out.finish()

show_pattern(p: Pattern) -> string
    var out = str_builder()

    write_pattern(&out, p)
    out.finish()

show_stmt(s: Stmt) -> string
    var out = str_builder()

    write_stmt(&out, s)
    out.finish()

// A whole statement list, space separated.
show_stmts(ss: Buf[Stmt]) -> string
    var out = str_builder()

    write_stmts(&out, ss)
    out.finish()

private write_stmts(out: *StrBuilder, ss: Buf[Stmt])
    for i in 0..<ss.len()
        if i > 0 then out.push_char(' ')

        write_stmt(out, ss.at(i))

private write_stmt(out: *StrBuilder, s: Stmt)
    *s.kind match
        ExprStmt(e) -> write_expr(out, e)
        Bad -> out.push("(bad)")

        ValDecl(n, t, v, vis, align, section) ->
            write_binding(out, "val", n, t, Some(v), vis, align, section)
        VarDecl(n, t, v, vis, align, section) ->
            write_binding(out, "var", n, t, v, vis, align, section)

        ConstDecl(n, t, v, vis) ->
            out.push("(const ")
            write_vis(out, vis)
            out.push(n)
            out.push(" : ")
            write_type(out, t)
            out.push_char(' ')
            write_expr(out, v)
            out.push_char(')')

        RefDecl(n, place) ->
            out.push("(ref ")
            out.push(n)
            out.push_char(' ')
            write_expr(out, place)
            out.push_char(')')

        StaticDecl(inner) ->
            out.push("(static ")
            write_stmt(out, inner)
            out.push_char(')')

        MultiDecl(names, mutable, values) ->
            out.push(if mutable then "(var (" else "(val (")

            for i in 0..<names.len()
                if i > 0 then out.push_char(' ')

                out.push(names.at(i))

            out.push(")")
            write_exprs(out, values)
            out.push_char(')')

        MultiAssign(op, targets, values) ->
            out.push_char('(')
            out.push(op)
            out.push(" (")

            for i in 0..<targets.len()
                if i > 0 then out.push_char(' ')

                write_expr(out, targets.at(i))

            out.push(") (")

            for i in 0..<values.len()
                if i > 0 then out.push_char(' ')

                write_expr(out, values.at(i))

            out.push("))")

        PatternDecl(pat, mutable, value) ->
            out.push(if mutable then "(var " else "(val ")
            write_pattern(out, pat)
            out.push_char(' ')
            write_expr(out, value)
            out.push_char(')')

        Return(v) ->
            out.push("(return")
            write_opt_expr(out, v)
            out.push_char(')')

        Become(call) ->
            out.push("(become ")
            write_expr(out, call)
            out.push_char(')')

        Break(label, value) ->
            out.push("(break")
            write_label(out, label)
            write_opt_expr(out, value)
            out.push_char(')')

        Continue(label) ->
            out.push("(continue")
            write_label(out, label)
            out.push_char(')')

        Defer(inner) ->
            out.push("(defer ")
            write_stmt(out, inner)
            out.push_char(')')

        Require(c, m) -> write_clause(out, "require", c, m)
        Ensure(c, m) -> write_clause(out, "ensure", c, m)
        Invariant(c, m) -> write_clause(out, "invariant", c, m)

        Variant(measure) ->
            out.push("(variant ")
            write_expr(out, measure)
            out.push_char(')')

        AssertDecl(cond, message) -> write_clause(out, "assert", cond, message)

        ImportDecl(d) -> write_import(out, d)

        CConstBlock(consts) ->
            out.push("(cconst")

            for i in 0..<consts.len()
                val c = consts.at(i)

                out.push(" (")
                write_vis(out, c.vis)
                out.push(c.name)
                out.push(" : ")
                write_type(out, c.typ)
                out.push(" \"")
                out.push(c.c)
                out.push("\")")

            out.push_char(')')

        CTypeBlock(types) ->
            out.push("(ctype")

            for i in 0..<types.len()
                val t = types.at(i)

                out.push(" (")
                write_vis(out, t.vis)
                out.push(t.name)
                out.push(" \"")
                out.push(t.c)
                out.push("\")")

            out.push_char(')')

        AsmStmt(arms) -> write_asm(out, arms)

        FuncDecl(d) -> write_func(out, d)
        ExternDecl(d) -> write_extern(out, d)

        ExternVarDecl(n, t, link, vis) ->
            out.push("(extern-var ")
            write_vis(out, vis)
            write_link(out, link)
            out.push(n)
            out.push(" : ")
            write_type(out, t)
            out.push_char(')')

        StructDecl(d) -> write_struct(out, d)
        EnumDecl(d) -> write_enum(out, d)
        TraitDecl(d) -> write_trait(out, d)
        ImplDecl(d) -> write_impl(out, d)
        TypeDecl(d) -> write_type_decl(out, d)

// A visibility, where one restricts what it is written on. Nothing is written for `Public`, its
// absence being what public means.
private write_vis(out: *StrBuilder, vis: Visibility)
    vis match
        Public -> ()
        File -> out.push("private ")
        Scoped(name) ->
            out.push("private[")
            out.push(name)
            out.push("] ")

private write_link(out: *StrBuilder, link: Option[string])
    link match
        Some(v) ->
            out.push_char('"')
            out.push(v)
            out.push("\" ")
        None -> ()

private write_opt_expr(out: *StrBuilder, e: Option[Expr])
    e match
        Some(v) ->
            out.push_char(' ')
            write_expr(out, v)
        None -> ()

private write_label(out: *StrBuilder, label: Option[string])
    label match
        Some(n) ->
            out.push(" '")
            out.push(n)
        None -> ()

private write_clause(out: *StrBuilder, head: string, cond: Expr, message: Option[string])
    out.push_char('(')
    out.push(head)
    out.push_char(' ')
    write_expr(out, cond)

    message match
        Some(m) ->
            out.push(" \"")
            out.push(m)
            out.push_char('"')
        None -> ()

    out.push_char(')')

private write_binding(out: *StrBuilder, head: string, name: string, typ: Option[TypeRef],
                      value: Option[Expr], vis: Visibility, align: Option[Expr],
                      section: Option[string])
    out.push_char('(')
    out.push(head)
    out.push_char(' ')
    write_vis(out, vis)

    align match
        Some(n) ->
            out.push("@align(")
            write_expr(out, n)
            out.push(") ")
        None -> ()

    section match
        Some(n) ->
            out.push("@section(\"")
            out.push(n)
            out.push("\") ")
        None -> ()

    out.push(name)

    typ match
        Some(t) ->
            out.push(" : ")
            write_type(out, t)
        None -> ()

    write_opt_expr(out, value)
    out.push_char(')')

private write_import(out: *StrBuilder, d: ImportDecl)
    out.push("(import ")

    for i in 0..<d.path.len()
        if i > 0 then out.push_char('.')

        out.push(d.path.at(i))

    if d.wildcard then out.push(" .*")

    if !d.selectors.is_empty()
        out.push(" {")

        for i in 0..<d.selectors.len()
            val sel = d.selectors.at(i)

            if i > 0 then out.push_char(' ')

            out.push(sel.name)

            sel.alias match
                Some(a) ->
                    out.push_char(':')
                    out.push(a)
                None -> ()

        out.push_char('}')

    d.alias match
        Some(a) ->
            out.push(" as ")
            out.push(a)
        None -> ()

    out.push_char(')')

private write_asm(out: *StrBuilder, arms: Buf[AsmArm])
    out.push("(asm")

    for i in 0..<arms.len()
        val arm = arms.at(i)

        out.push(" ([")

        for j in 0..<arm.archs.len()
            if j > 0 then out.push_char(' ')

            out.push(arm.archs.at(j))

        out.push_char(']')

        arm.body match
            AsmUnavailable(reason) ->
                out.push(" unavailable \"")
                out.push(reason)
                out.push_char('"')
            AsmCode(lines, operands, clobbers) ->
                for j in 0..<lines.len()
                    out.push(" \"")
                    out.push(lines.at(j))
                    out.push_char('"')

                for j in 0..<operands.len()
                    val op = operands.at(j)

                    out.push(op.dir match
                        In -> " (in "
                        Out -> " (out ")
                    out.push(op.name)
                    out.push_char(' ')

                    op.reg match
                        Some(r) ->
                            out.push_char('"')
                            out.push(r)
                            out.push_char('"')
                        None -> out.push("reg")

                    out.push_char(')')

                for j in 0..<clobbers.len()
                    out.push(" (clobbers \"")
                    out.push(clobbers.at(j))
                    out.push("\")")

        out.push_char(')')

    out.push_char(')')

// A type, as a shape rather than as a spelling: a value argument is told from a name, which the
// written form cannot do.
private write_type(out: *StrBuilder, t: TypeRef)
    *t.kind match
        NamedType(n, args) ->
            if args.is_empty()
                out.push(n)
            else
                out.push_char('(')
                out.push(n)

                for i in 0..<args.len()
                    out.push_char(' ')
                    write_type(out, args.at(i))

                out.push_char(')')
        ValueArgType(v) ->
            out.push("(value ")
            write_expr(out, v)
            out.push_char(')')
        PtrType(inner) -> form1(out, "ptr", inner)
        RefType(inner, sync) -> form1(out, if sync then "ref-sync" else "ref", inner)
        WeakType(inner) -> form1(out, "weak", inner)
        ArrayType(length, elem, ro) ->
            out.push_char('(')
            out.push(if ro then "slice-const" else "array")

            length match
                Some(n) ->
                    out.push_char(' ')
                    write_expr(out, n)
                None -> out.push(" _")

            out.push_char(' ')
            write_type(out, elem)
            out.push_char(')')
        VectorType(lanes, elem) ->
            out.push("(vector ")
            write_expr(out, lanes)
            out.push_char(' ')
            write_type(out, elem)
            out.push_char(')')
        VolatileType(inner) -> form1(out, "volatile", inner)
        TupleType(parts, results) ->
            out.push_char('(')
            out.push(if results then "results" else "tuple")

            for i in 0..<parts.len()
                out.push_char(' ')
                write_type(out, parts.at(i))

            out.push_char(')')
        PackType(n) -> out.push(s"(pack ${n})")
        FnType(params, ret, bare) ->
            out.push_char('(')
            out.push(if bare then "fn" else "Fn")

            for i in 0..<params.len()
                out.push_char(' ')
                write_type(out, params.at(i))

            out.push(" -> ")
            write_type(out, ret)
            out.push_char(')')
        CFnType(params, ret) ->
            out.push("(extern-fn")

            for i in 0..<params.len()
                out.push_char(' ')
                write_type(out, params.at(i))

            out.push(" -> ")
            write_type(out, ret)
            out.push_char(')')
        AssocType(base, member) ->
            out.push("(:: ")
            write_type(out, base)
            out.push(s" ${member})")
        AssocArgType(n, typ) ->
            out.push(s"(= ${n} ")
            write_type(out, typ)
            out.push_char(')')
        SomeType(bounds) ->
            out.push("(some")

            for i in 0..<bounds.len()
                out.push_char(' ')
                out.push(bound_text(bounds.at(i)))

            out.push_char(')')
end write_type

private form1(out: *StrBuilder, head: string, inner: TypeRef)
    out.push_char('(')
    out.push(head)
    out.push_char(' ')
    write_type(out, inner)
    out.push_char(')')

private write_pattern(out: *StrBuilder, p: Pattern)
    *p.kind match
        LitPattern(v) -> write_expr(out, v)
        RangePattern(lo, hi, inclusive) ->
            out.push(if inclusive then "(.. " else "(..< ")
            write_expr(out, lo)
            out.push_char(' ')
            write_expr(out, hi)
            out.push_char(')')
        WildcardPattern -> out.push_char('_')
        IdentPattern(n) -> out.push(n)
        EqPattern(n) -> out.push(s"`${n}`")
        VariantPattern(n, args) ->
            out.push_char('(')
            out.push(n)

            for i in 0..<args.len()
                out.push_char(' ')
                write_pattern(out, args.at(i))

            out.push_char(')')
        StructPattern(n, fields) ->
            out.push(s"(struct ${n}")

            for i in 0..<fields.len()
                val f = fields.at(i)

                out.push(s" (${f.name} ")
                write_pattern(out, f.pat)
                out.push_char(')')

            out.push_char(')')
        TuplePattern(args) ->
            out.push("(tuple")

            for i in 0..<args.len()
                out.push_char(' ')
                write_pattern(out, args.at(i))

            out.push_char(')')
        BindPattern(n, inner) ->
            out.push(s"(@ ${n} ")
            write_pattern(out, inner)
            out.push_char(')')
end write_pattern

private write_exprs(out: *StrBuilder, es: Buf[Expr])
    for i in 0..<es.len()
        out.push_char(' ')
        write_expr(out, es.at(i))

private write_body(out: *StrBuilder, head: string, ss: Buf[Stmt])
    out.push_char('(')
    out.push(head)

    for i in 0..<ss.len()
        out.push_char(' ')
        write_stmt(out, ss.at(i))

    out.push_char(')')

private write_expr(out: *StrBuilder, e: Expr)
    *e.kind match
        IntLit(digits, base, suffix) ->
            out.push(base match
                2 -> s"0b${digits}"
                8 -> s"0o${digits}"
                16 -> s"0x${digits}"
                _ -> digits)
            out.push(suffix)
        FloatLit(text, suffix) ->
            out.push(text)
            out.push(suffix)
        CharLit(c) ->
            out.push_char('\'')
            out.push_char(c)
            out.push_char('\'')
        StrLit(v) -> out.push(s"\"${v}\"")
        CStrLit(v) -> out.push(s"c\"${v}\"")
        BoolLit(v) -> out.push(if v then "true" else "false")
        UnitLit -> out.push("()")
        NullLit -> out.push("null")
        Ident(n) -> out.push(n)
        Unary(op, operand) ->
            out.push(s"(${op} ")
            write_expr(out, operand)
            out.push_char(')')
        PreIncDec(op, operand) ->
            out.push(s"(pre${op} ")
            write_expr(out, operand)
            out.push_char(')')
        PostIncDec(op, operand) ->
            out.push(s"(post${op} ")
            write_expr(out, operand)
            out.push_char(')')
        Binary(op, left, right) ->
            out.push(s"(${op} ")
            write_expr(out, left)
            out.push_char(' ')
            write_expr(out, right)
            out.push_char(')')
        Compare(operands, ops) ->
            out.push("(cmp")

            for i in 0..<operands.len()
                if i > 0 then out.push(s" ${ops.at(i - 1)}")

                out.push_char(' ')
                write_expr(out, operands.at(i))

            out.push_char(')')
        RangeExpr(lo, hi, inclusive) ->
            out.push(if inclusive then "(.." else "(..<")

            lo match
                Some(v) ->
                    out.push_char(' ')
                    write_expr(out, v)
                None -> out.push(" _")

            hi match
                Some(v) ->
                    out.push_char(' ')
                    write_expr(out, v)
                None -> out.push(" _")

            out.push_char(')')
        Assign(op, target, value) ->
            out.push(s"(${op} ")
            write_expr(out, target)
            out.push_char(' ')
            write_expr(out, value)
            out.push_char(')')
        Call(callee, args) ->
            out.push("(call ")
            write_expr(out, callee)
            write_exprs(out, args)
            out.push_char(')')
        NamedArg(n, value) ->
            out.push(s"(named ${n} ")
            write_expr(out, value)
            out.push_char(')')
        Spread(v) ->
            out.push("(spread ")
            write_expr(out, v)
            out.push_char(')')
        DefaultArg(_, v) ->
            out.push("(default ")
            write_expr(out, v)
            out.push_char(')')
        Index(receiver, index) ->
            out.push("(index ")
            write_expr(out, receiver)
            out.push_char(' ')
            write_expr(out, index)
            out.push_char(')')
        Field(receiver, n) ->
            out.push("(field ")
            write_expr(out, receiver)
            out.push(s" ${n})")
        TypeArgs(receiver, args) ->
            out.push("(typeargs ")
            write_expr(out, receiver)
            write_exprs(out, args)
            out.push_char(')')
        TypeAttr(receiver, attr) ->
            out.push("(:: ")
            write_expr(out, receiver)
            out.push(s" ${attr})")
        WithExpr(base, fields) ->
            out.push("(with ")
            write_expr(out, base)

            for i in 0..<fields.len()
                val f = fields.at(i)

                out.push(s" (${f.name} ")
                write_expr(out, f.value)
                out.push_char(')')

            out.push_char(')')
        ImplicitMember(n) -> out.push(s"(dot ${n})")
        LayoutOf(op, typ) ->
            out.push(s"(${op} ")
            write_type(out, typ)
            out.push_char(')')
        OffsetOf(typ, field) ->
            out.push("(offsetof ")
            write_type(out, typ)
            out.push(s" ${field})")
        TryExpr(inner) ->
            out.push("(try ")
            write_expr(out, inner)
            out.push_char(')')
        Tuple(elements) ->
            out.push("(tuple")
            write_exprs(out, elements)
            out.push_char(')')
        Lambda(params, body, implicit_params) ->
            out.push(if implicit_params then "(lambda-it (" else "(lambda (")

            for i in 0..<params.len()
                if i > 0 then out.push_char(' ')

                val lp = params.at(i)

                lp.typ match
                    Some(t) ->
                        out.push(s"${lp.name}:")
                        write_type(out, t)
                    None -> out.push(lp.name)

            out.push(") ")
            write_stmts(out, body)
            out.push_char(')')
        BlockArg(body) -> write_body(out, "blockarg", body)
        ArrayLit(elements) ->
            out.push("(array")
            write_exprs(out, elements)
            out.push_char(')')
        ArrayFill(value, count) ->
            out.push("(fill ")
            write_expr(out, value)
            out.push_char(' ')
            write_expr(out, count)
            out.push_char(')')
        Block(stmts) -> write_body(out, "block", stmts)
        IfExpr(cond, then_body, else_body) ->
            out.push("(if ")
            write_expr(out, cond)
            out.push_char(' ')
            write_body(out, "then", then_body)

            else_body match
                Some(b) ->
                    out.push_char(' ')
                    write_body(out, "else", b)
                None -> ()

            out.push_char(')')
        MatchExpr(scrutinee, arms) ->
            out.push("(match ")
            write_expr(out, scrutinee)

            for i in 0..<arms.len()
                val a = arms.at(i)

                out.push(" (arm")

                for j in 0..<a.patterns.len()
                    out.push_char(' ')
                    write_pattern(out, a.patterns.at(j))

                a.guard match
                    Some(g) ->
                        out.push(" (if ")
                        write_expr(out, g)
                        out.push_char(')')
                    None -> ()

                out.push(" -> ")
                write_stmts(out, a.body)
                out.push_char(')')

            out.push_char(')')
        IsPattern(subject, patterns, negated) ->
            out.push(if negated then "(is-not " else "(is ")
            write_expr(out, subject)

            for i in 0..<patterns.len()
                out.push_char(' ')
                write_pattern(out, patterns.at(i))

            out.push_char(')')
        ResultList(values) ->
            out.push("(results")
            write_exprs(out, values)
            out.push_char(')')
        While(label, cond, body, else_body) ->
            out.push("(while")
            write_label(out, label)
            out.push_char(' ')
            write_expr(out, cond)
            write_block(out, body)
            write_else(out, else_body)
            out.push_char(')')
        DoWhile(label, body, cond, else_body) ->
            out.push("(do-while")
            write_label(out, label)
            write_block(out, body)
            out.push_char(' ')
            write_expr(out, cond)
            write_else(out, else_body)
            out.push_char(')')
        Loop(label, body) ->
            out.push("(loop")
            write_label(out, label)
            write_block(out, body)
            out.push_char(')')
        For(label, name, iter, body, else_body) ->
            out.push("(for")
            write_label(out, label)
            out.push_char(' ')
            out.push(name)
            out.push_char(' ')
            write_expr(out, iter)
            write_block(out, body)
            write_else(out, else_body)
            out.push_char(')')
        ConstFor(name, iter, body) ->
            out.push("(const-for ")
            out.push(name)
            out.push_char(' ')
            write_expr(out, iter)
            write_block(out, body)
            out.push_char(')')
        CFor(label, init, cond, step, body, else_body) ->
            out.push("(cfor")
            write_label(out, label)

            init match
                Some(s) ->
                    out.push_char(' ')
                    write_stmt(out, s)
                None -> ()

            write_opt_expr(out, cond)

            step match
                Some(s) ->
                    out.push_char(' ')
                    write_stmt(out, s)
                None -> ()

            write_block(out, body)
            write_else(out, else_body)
            out.push_char(')')
        Quantifier(universal, name, iter, pred) ->
            out.push(if universal then "(for-all " else "(for-some ")
            out.push(name)
            out.push_char(' ')
            write_expr(out, iter)
            out.push_char(' ')
            write_expr(out, pred)
            out.push_char(')')
        Bad -> out.push("(bad)")
        _ -> out.push("(expr)")
end write_expr

// The 'else' a loop runs when it finished on its own rather than through a 'break'.
private write_else(out: *StrBuilder, body: Option[Buf[Stmt]])
    body match
        Some(b) ->
            out.push_char(' ')
            write_body(out, "else", b)
        None -> ()

// A bracketed type-parameter list, as a shape: every parameter in the order it was written, each
// with whatever it carried.
show_type_params(ps: TypeParams) -> string
    var out = str_builder()

    out.push_char('(')

    for i in 0..<ps.names.len()
        if i > 0 then out.push_char(' ')

        val n = ps.names.at(i)

        if holds_name(ps.packs, n) then out.push("..")

        out.push(n)

        for j in 0..<ps.values.len()
            if ps.values.at(j).name == n
                out.push(":const ")
                write_type(&out, ps.values.at(j).typ)

        for j in 0..<ps.bounds.len()
            if ps.bounds.at(j).name == n
                val bs = ps.bounds.at(j).bounds

                for k in 0..<bs.len()
                    out.push(if k == 0 then ":" else "+")
                    out.push(bound_text(bs.at(k)))

        for j in 0..<ps.defaults.len()
            if ps.defaults.at(j).name == n
                out.push_char('=')
                write_type(&out, ps.defaults.at(j).typ)

        for j in 0..<ps.value_defaults.len()
            if ps.value_defaults.at(j).name == n
                out.push_char('=')
                write_expr(&out, ps.value_defaults.at(j).value)

    out.push_char(')')
    out.finish()
end show_type_params

private holds_name(names: Buf[string], n: string) -> bool
    for i in 0..<names.len()
        if names.at(i) == n then return true

    false
end holds_name

// A `where` clause, as a shape.
show_where_bounds(ws: Buf[WhereBound]) -> string
    var out = str_builder()

    out.push_char('(')

    for i in 0..<ws.len()
        if i > 0 then out.push_char(' ')

        val w = ws.at(i)

        out.push(w.name)

        for k in 0..<w.bounds.len()
            out.push(if k == 0 then ":" else "+")
            out.push(bound_text(w.bounds.at(k)))

    out.push_char(')')
    out.finish()
end show_where_bounds

// -- the declarations ------------------------------------------------------------------------------

// The annotations a function carries, each in the spelling it was written in, so that a test reads
// what was attached rather than which field it landed in.
private write_func_attrs(out: *StrBuilder, d: FuncDecl)
    d.test match
        Some(t) ->
            out.push("@test")

            t.display match
                Some(v) ->
                    out.push("(\"")
                    out.push(v)
                    out.push("\")")
                None -> ()

            if t.should_trap then out.push("@should_trap")

            t.expected match
                Some(v) ->
                    out.push("(\"")
                    out.push(v)
                    out.push("\")")
                None -> ()

            out.push_char(' ')
        None -> ()

    d.hook match
        Some(h) ->
            out.push_char('@')
            out.push(hook_word(h.kind))
            out.push_char(' ')
        None -> ()

    if d.tailrec then out.push("@tailrec ")
    if d.pure then out.push("@pure ")
    if d.ghost then out.push("@ghost ")

    write_frame(out, "reads", d.reads)
    write_frame(out, "writes", d.writes)

    d.exported match
        Some(e) ->
            out.push("@export")

            e.symbol match
                Some(v) ->
                    out.push("(\"")
                    out.push(v)
                    out.push("\")")
                None -> ()

            out.push_char(' ')
        None -> ()

    d.section match
        Some(v) ->
            out.push("@section(\"")
            out.push(v)
            out.push("\") ")
        None -> ()

    write_names(out, "crossing", d.crossing)
    write_names(out, "needs", d.needs)

    d.conv match
        Some(c) ->
            out.push_char('@')
            out.push(c.name)

            c.arg match
                Some(a) ->
                    out.push_char('(')
                    out.push(a)
                    out.push_char(')')
                None -> ()

            out.push_char(' ')
        None -> ()

private write_frame(out: *StrBuilder, word: string, names: Option[Buf[string]])
    names match
        Some(ns) ->
            out.push_char('@')
            out.push(word)
            out.push_char('(')

            for i in 0..<ns.len()
                if i > 0 then out.push_char(',')

                out.push(ns.at(i))

            out.push(") ")
        None -> ()

private write_names(out: *StrBuilder, word: string, names: Buf[string])
    if names.is_empty() then return

    out.push_char('@')
    out.push(word)
    out.push_char('(')

    for i in 0..<names.len()
        if i > 0 then out.push_char(',')

        out.push(names.at(i))

    out.push(") ")

// The bracketed parameter list a declaration was written with: the names, the bounds, the defaults
// and the packs, in the spelling `show_type_params` already gives them.
private write_generics(out: *StrBuilder, names: Buf[string], bounds: Buf[NamedBounds],
                       defaults: Buf[TypeBinding], values: Buf[TypeBinding], packs: Buf[string])
    if names.is_empty() && values.is_empty() then return

    out.push(show_type_params(TypeParams(names, bounds, defaults, values, buf(), packs)))

private write_params(out: *StrBuilder, params: Buf[Param], variadic: bool)
    out.push_char('(')

    for i in 0..<params.len()
        val p = params.at(i)

        if i > 0 then out.push_char(' ')

        write_vis(out, p.vis)
        out.push(p.name)
        out.push_char(':')

        if p.rest then out.push("...")

        if p.by_name then out.push("->")

        out.push(param_type_text(p))

        p.default match
            Some(v) ->
                out.push_char('=')
                write_expr(out, v)
            None -> ()

    if variadic
        if !params.is_empty() then out.push_char(' ')

        out.push("...")

    out.push_char(')')

// What a parameter's type is written as. A rest parameter and a by-name one each carry a type the
// grammar built around what was written, so what is shown is the part the reader typed.
private param_type_text(p: Param) -> string
    if p.rest
        *p.typ.kind match
            ArrayType(_, elem, _) -> return type_text(elem)
            _ -> return type_text(p.typ)

    if p.by_name
        *p.typ.kind match
            FnType(_, ret, _) -> return type_text(ret)
            _ -> return type_text(p.typ)

    type_text(p.typ)
end param_type_text

private write_result(out: *StrBuilder, ret: Option[TypeRef])
    ret match
        Some(t) ->
            out.push(" -> ")
            write_type(out, t)
        None -> ()

private write_func(out: *StrBuilder, d: FuncDecl)
    out.push("(fn ")
    write_vis(out, d.vis)
    write_func_attrs(out, d)
    out.push(d.name)
    write_generics(out, d.tparams, d.bounds, d.tdefaults, d.tvalues, d.tpacks)
    out.push_char(' ')
    write_params(out, d.params, d.variadic)
    write_result(out, d.ret_type)
    write_block(out, d.body)
    out.push_char(')')

private write_block(out: *StrBuilder, body: Buf[Stmt])
    for i in 0..<body.len()
        out.push_char(' ')
        write_stmt(out, body.at(i))

private write_extern(out: *StrBuilder, d: ExternDecl)
    out.push("(extern ")
    write_vis(out, d.vis)
    write_names(out, "needs", d.needs)
    write_link(out, d.link)
    out.push(d.name)
    out.push_char(' ')
    write_params(out, d.params, d.variadic)
    write_result(out, d.ret_type)
    out.push_char(')')

private write_method(out: *StrBuilder, m: MethodDecl)
    out.push_char('(')
    out.push(if m.is_property then "prop " else "method ")
    write_vis(out, m.vis)

    if m.overrides then out.push("override ")
    if m.is_static then out.push("static ")

    write_names(out, "crossing", m.crossing)
    write_names(out, "borrows", m.borrows)
    write_frame(out, "reads", m.reads)
    write_frame(out, "writes", m.writes)

    m.receiver match
        Some(mode) ->
            out.push(mode match
                ByValue -> "self "
                ByPtr -> "*self "
                ByRef(sync) -> if sync then "&sync self " else "&self ")
        None -> ()

    out.push(m.name)
    write_generics(out, m.tparams, m.bounds, m.tdefaults, m.tvalues, m.tpacks)

    if !m.is_property
        out.push_char(' ')
        write_params(out, m.params, m.variadic)

    write_result(out, m.ret_type)
    write_block(out, m.body)
    out.push_char(')')

private write_members(out: *StrBuilder, members: Buf[MethodDecl])
    for i in 0..<members.len()
        out.push_char(' ')
        write_method(out, members.at(i))

private write_derives(out: *StrBuilder, derives: Buf[BoundRef])
    if derives.is_empty() then return

    out.push(" derives")

    for i in 0..<derives.len()
        out.push_char(' ')
        out.push(bound_text(derives.at(i)))

private write_struct(out: *StrBuilder, d: StructDecl)
    out.push("(struct ")
    write_vis(out, d.vis)

    if d.opaque then out.push("opaque ")
    if d.packed then out.push("@packed ")

    d.alignment match
        Some(n) ->
            out.push("@align(")
            write_expr(out, n)
            out.push(") ")
        None -> ()

    d.cname match
        Some(e) ->
            out.push("@export")

            e.symbol match
                Some(v) ->
                    out.push("(\"")
                    out.push(v)
                    out.push("\")")
                None -> ()

            out.push_char(' ')
        None -> ()

    out.push(d.name)
    write_generics(out, d.tparams, d.bounds, d.tdefaults, d.tvalues, buf())
    write_derives(out, d.deriving)
    out.push_char(' ')
    write_params(out, d.fields, false)

    for i in 0..<d.invariants.len()
        out.push(" (invariant ")
        write_expr(out, d.invariants.at(i))
        out.push_char(')')

    write_members(out, d.members)
    out.push_char(')')

private write_enum(out: *StrBuilder, d: EnumDecl)
    out.push("(enum ")
    write_vis(out, d.vis)
    out.push(d.name)
    write_generics(out, d.tparams, d.bounds, d.tdefaults, d.tvalues, buf())

    d.underlying match
        Some(t) ->
            out.push(" : ")
            write_type(out, t)
        None -> ()

    write_derives(out, d.deriving)

    for i in 0..<d.variants.len()
        val v = d.variants.at(i)

        out.push(" (")
        out.push(v.name)

        v.value match
            Some(e) ->
                out.push(" = ")
                write_expr(out, e)
            None -> ()

        if !v.fields.is_empty()
            out.push_char(' ')
            write_params(out, v.fields, false)

        out.push_char(')')

    write_members(out, d.members)
    out.push_char(')')

private write_trait(out: *StrBuilder, d: TraitDecl)
    out.push("(trait ")
    write_vis(out, d.vis)
    out.push(d.name)
    write_generics(out, d.tparams, d.bounds, d.tdefaults, buf(), buf())

    if !d.supers.is_empty()
        out.push(" :")

        for i in 0..<d.supers.len()
            out.push_char(' ')
            out.push(bound_text(d.supers.at(i)))

    for i in 0..<d.assocs.len()
        val a = d.assocs.at(i)

        out.push(" (type ")
        out.push(a.name)

        for j in 0..<a.bounds.len()
            out.push_char(' ')
            out.push(bound_text(a.bounds.at(j)))

        out.push_char(')')

    write_members(out, d.methods)
    out.push_char(')')

private write_impl(out: *StrBuilder, d: ImplDecl)
    out.push("(impl ")

    if d.overrides then out.push("override ")

    write_generics(out, d.tparams, d.bounds, d.tdefaults, d.tvalues, d.tpacks)
    out.push(d.trait_name)

    if !d.trait_args.is_empty()
        out.push_char('[')

        for i in 0..<d.trait_args.len()
            if i > 0 then out.push_char(' ')

            write_type(out, d.trait_args.at(i))

        out.push_char(']')

    out.push(" for ")
    write_type(out, d.for_type)

    for i in 0..<d.assocs.len()
        val a = d.assocs.at(i)

        out.push(" (type ")
        out.push(a.name)
        out.push(" = ")
        write_type(out, a.typ)
        out.push_char(')')

    write_members(out, d.methods)
    out.push_char(')')

private write_type_decl(out: *StrBuilder, d: TypeDecl)
    out.push("(type ")
    write_vis(out, d.vis)
    out.push(d.name)
    out.push(" = ")

    if d.derived then out.push("new ")

    write_type(out, d.base)

    d.range match
        Some(r) ->
            out.push(" within ")
            write_expr(out, r.lo)
            out.push(if r.exclusive_hi then " ..< " else " .. ")
            write_expr(out, r.hi)
        None -> ()

    d.pred match
        Some(e) ->
            out.push(" where ")
            write_expr(out, e)
        None -> ()

    out.push_char(')')
