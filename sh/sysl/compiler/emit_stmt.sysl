module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.math.bigint.from_int

// **One statement, lowered for its effects.**

// A statement is its own ownership region: whatever it took a count of on the way through is given
// back where the statement ends, which is what makes `f(g())` let go of `g`'s result and not
// before.
gen_stmt(e: *Emit, s: TStmt)
    push_temps(e)
    gen_stmt_body(e, s)
    pop_temps(e)
end gen_stmt

private gen_stmt_body(e: *Emit, s: TStmt) = s match
    // A zero-sized binding is not a slot: the initializer still runs, for its effect, and there is
    // nothing to keep afterwards.
    TVarDecl(name, ty, init, align) ->
        if zero_sized(ty)
            gen_expr(e, init)
        else if is_promoted(e, name) && promoted_elem(ty).is_some()
            gen_promoted_decl(e, name, ty, promoted_elem(ty).unwrap(), init)
        else
            // The slot is laid down **before** the initializer runs, because a large one is written
            // into it rather than handed to it.
            emit_alloca(e, VReg(s"$name.addr"), lty(e, ty), int_align(align))
            gen_into(e, VReg(s"$name.addr"), init)
            own_slot(e, name, ty)

    // `ref name = place`. The walk to the place is made **once**, here, and its result becomes the
    // name's address -- so every later read and write is the one instruction it would have been.
    //
    // The zero-offset `getelementptr` is there to give the address a name of its own: `address` may
    // hand back an existing slot or a global, and a register cannot simply be renamed.
    TRefDecl(name, _, place) ->
        val base = address(e, place)

        if volatile_in(place_ty(place)) then gap_here(e, "a ref to volatile storage")

        // What keeps the storage alive belongs to the place, and the name that replaces the path has
        // no declaration to read it off -- so it is recorded here and asked for at every view taken
        // through the name.
        e.ref_places.push((name, place))

        var idx: Buf[IrArg] = buf()

        idx.push(ir_arg(LInt(64), VInt(from_int(0))))
        emit(e, InGep(VReg(s"$name.addr"), LInt(8), base, idx))

    TExprStmt(expr) -> gen_expr(e, expr)

    TWriteStmt(w) -> gen_write(e, w)

    TMultiAssign(writes) -> gen_multi_assign(e, writes)

    TReturn(opt) -> gen_return(e, opt)
    TBecome(call) -> gen_become(e, call)

    // A `break`/`continue` leaves the body from the middle, so it unwinds the body's ownership
    // regions before jumping -- the same discipline as `return`, bounded to the loop. `break v`
    // hands its value over with a count taken, so that it survives the unwind.
    TBreak(opt, depth) ->
        // **A jump out of no loop is a refusal that has already been made**, and the analysis goes
        // on after one so that a reader is told everything at once -- so what arrives here is a
        // statement no body will run, and reading past the end of the stack is the only way it can
        // go wrong.
        if e.loops.is_empty()
            gap_here(e, "TBreak")
            return
        end if

        val enclosing = loop_at(e, depth)

        opt match
            Some(t) ->
                val v = gen_expr(e, t)

                retain_value(e, texpr_type(t), v)
                emit(e, InStore(lty_of(e, t), v, enclosing.slot, AccPlain, None))
            None -> ()

        release_to_depth(e, enclosing.owned_depth, enclosing.temp_depth)
        emit_term(e, InBr(enclosing.break_label))

    TContinue(depth) ->
        if e.loops.is_empty()
            gap_here(e, "TContinue")
            return
        end if

        val enclosing = loop_at(e, depth)

        release_to_depth(e, enclosing.owned_depth, enclosing.temp_depth)
        emit_term(e, InBr(enclosing.continue_label))

    // Reaching a `defer` emits nothing: it hands its statements to the scope, which lays them down
    // at each edge that leaves the block. Registering here rather than at the top of the block is
    // what makes a `defer` control never reached schedule nothing.
    TDefer(stmts) -> defer_stmts(e, stmts)

    // A loop's `invariant` is a condition that traps on false, which is every other clause the
    // verification chapter states -- unless it names a `@ghost` function, in which case it states a
    // proof obligation and there is nothing to lay down.
    TInvariant(cond, _) -> if !ghostly(e, cond) then emit_contract(e, cond, "invariant")

    TVariantCheck(slot, var_ty, expr) ->
        if !ghostly(e, expr) then gen_variant_check(e, slot, var_ty, expr)

    // One architecture's instructions arrived here; the arms that answered for the others were
    // chosen between in the analyzer and are not represented.
    TAsm(lines, operands, clobbers) -> if !lines.is_empty() then gen_asm(e, lines, operands, clobbers)

    _ -> gap_here(e, tstmt_kind_name(s))

// The boundary a declaration asked for, which wins over the one the type carries.
private int_align(align: Option[usize]) -> Option[int] = align match
    Some(n) -> Some(int(n))
    None -> None

// The loop a `break` or a `continue` at this depth belongs to. The list is innermost **last**, so a
// depth of zero is the one on the end.
private loop_at(e: *Emit, depth: int) -> GenLoop
    val i = e.loops.len() - 1 - usize(depth)

    e.loops.at(i)
end loop_at

// Writes `x`'s value into `dest`. A large one is written where it is going rather than produced and
// then stored, since that is what the callee of `val k = kernel()` needs.
gen_into(e: *Emit, dest: Val, x: TExpr)
    val ty = texpr_type(x)

    if !e.layout.indirect(ty)
        val v = gen_expr(e, x)

        // The storage owns what is written into it, so it takes a count of its own -- and the slot
        // is fresh, so there is nothing there to give back.
        retain_value(e, ty, v)
        emit(e, InStore(lty(e, ty), v, dest, AccPlain, None))
        return
    end if

    // A tail self-call needs no destination: the jump keeps the frame, so the out-pointer the caller
    // handed in is still the one the return that eventually happens will write through. `dest` here
    // *is* that pointer, and passing it on would be writing the result of a call that is not made.
    *x.kind match
        TCall(name, args, _, _) ->
            if e.tail_target != "" && is_tail_call(e.tail_calls, x.span)
                gen_tail_self_call(e, args)
                return
            end if

            // A result already arrives with its count taken, and the out-pointer is what says where.
            // This is the case the whole mechanism is for: `val k = kernel()` writes the callee's
            // work straight into `k`'s slot, and no aggregate is ever an LLVM value.
            if !is_foreign(e, name)
                var arg_vals: Buf[IrArg] = buf()
                val staged = staged_args(e, args, &arg_vals)

                if checks_variant(e, name) then gen_variant_at_call(e, staged)

                gen_sysl_call_into(e, VGlobal(symbol_of(e, name)), arg_vals, ty, Some(dest),
                                   variadic_type_of(e, name))
                return
            end if
        _ -> ()

    gen_borrowed_into(e, dest, x)
    retain_at(e, ty, dest)
end gen_into

// Writes `x`'s value into `dest` without taking a count for anything in it -- what lands there is
// borrowed, exactly as the register `gen_expr` hands back is.
//
// A **call** is deliberately not a case of its own here. Its result arrives owned, and giving it
// this destination would leave a count in a place with nothing registered to release it; sending it
// through `gen_expr` instead costs the whole-value load this path exists to avoid, but only where a
// large result is nested inside a literal that is itself being built in place.
gen_borrowed_into(e: *Emit, dest: Val, x: TExpr)
    val ty = texpr_type(x)

    *x.kind match
        // A bitfield struct has one slot however many fields were written, so there is nothing to
        // build field by field: the container is assembled as a value and stored once.
        TStructNew(decl, args) ->
            bitfield_ranges_of(Struct(decl)) match
                Some(ranges) ->
                    var vals: Buf[Val] = buf()

                    for i in 0..<args.len()
                        val v = gen_expr(e, args.at(i))

                        if !zero_sized(decl.fields.at(i).1) then vals.push(v)

                    emit(e, InStore(container_lty(ranges), build_bits(e, ranges, vals), dest,
                                    AccPlain, None))
                None ->
                    for i in 0..<args.len()
                        if !zero_sized(decl.fields.at(i).1)
                            val p = fresh_reg(e)

                            var idx: Buf[IrArg] = buf()

                            idx.push(ir_arg(l_i32(), VInt(from_int(0))))
                            idx.push(ir_arg(l_i32(), VInt(from_int(long(decl.slot(i))))))
                            emit(e, InGep(p, struct_lty(decl), dest, idx))
                            gen_borrowed_into(e, p, args.at(i))

        TArrayLit(elems, array_ty) ->
            val elem = element(array_ty).unwrap_or(int_type())

            for i in 0..<elems.len()
                val p = fresh_reg(e)

                var idx: Buf[IrArg] = buf()

                idx.push(ir_arg(word_lty(e), VInt(from_int(long(i)))))
                emit(e, InGep(p, lty(e, elem), dest, idx))
                gen_borrowed_into(e, p, elems.at(i))

        // The tag, and then the variant's own fields written into the region every variant shares.
        // Reaching the region by address is what the value form has to use a stack slot for anyway --
        // a union has no `insertvalue` -- so this is the shorter of the two lowerings as well.
        TEnumNew(enum_ty, variant, args) ->
            enum_decl(enum_ty) match
                Some(d) ->
                    if d.simple then store_through_value(e, dest, x, ty)
                    else
                        emit(e, InStore(l_i32(), VInt(from_int(long(variant.tag))), dest, AccPlain,
                                        None))

                        if variant.carries
                            val base = payload_ptr(e, d, dest)

                            for i in 0..<args.len()
                                if !zero_sized(variant.fields.at(i).1)
                                    val p = fresh_reg(e)

                                    var idx: Buf[IrArg] = buf()

                                    idx.push(ir_arg(l_i32(), VInt(from_int(0))))
                                    idx.push(ir_arg(l_i32(),
                                                    VInt(from_int(long(variant.slot(i))))))
                                    emit(e, InGep(p, variant_lty(d, variant), base, idx))
                                    gen_borrowed_into(e, p, args.at(i))
                None -> store_through_value(e, dest, x, ty)

        // The value is generated once, above the loop, exactly as the value form does -- every
        // element is a copy of that one evaluation. It is generated even where there are no
        // elements, because one evaluation is what the form promises.
        TArrayFill(value, array_ty) ->
            val v = gen_expr(e, value)

            fill_at(e, dest, array_ty, v)

        // A copy from one place to another is a copy of bytes. Reading the value out first would
        // make a first-class aggregate of it for the length of one instruction, which is the cost.
        _ ->
            if has_address(x)
                emit_memcpy(e, dest, address(e, x), int(e.layout.size(ty)),
                            int(e.layout.align(ty)))
            else store_through_value(e, dest, x, ty)
end gen_borrowed_into

private store_through_value(e: *Emit, dest: Val, x: TExpr, ty: Type)
    val v = gen_expr(e, x)

    emit(e, InStore(lty(e, ty), v, dest, AccPlain, None))

// `x` built where a value of it is wanted, for a caller that asked for a register rather than
// offering somewhere to put one. The load is the very thing the destination forms avoid, so this is
// the fallback and not the path anything hot takes.
through_slot(e: *Emit, x: TExpr) -> Val
    val ty = texpr_type(x)
    val slot = alloca(e, fresh_reg(e), lty(e, ty))

    gen_borrowed_into(e, slot, x)

    val r = fresh_reg(e)

    emit(e, InLoad(r, lty(e, ty), slot, AccPlain, None))
    r
end through_slot

// **`a, b = b, a`** -- several places written from several values, in phases rather than one write at
// a time.
//
// Every place's own subexpressions are located first, and once, so an index that calls something
// calls it a single time. Then everything the statement *reads* is read -- what a compound arm finds
// in its place, and then the whole right side -- which is what makes a swap a swap instead of two
// statements that leave both names holding the same thing. Only then does anything land.
//
// **Every read takes a count for the statement**, which is what a form that reads everything before
// it writes anything needs and a single assignment does not: writing into the first place lets go of
// what was there, and in a swap what was there is exactly the value the second arm is holding.
//
// **Every `invariant` re-check waits until all of them have landed**, and once per struct however
// many of its fields were written -- a clause relating two fields would otherwise trap on the
// half-written state on the way to a perfectly good one.
private gen_multi_assign(e: *Emit, writes: Buf[TWrite])
    var addrs: Buf[Val] = buf()

    for i in 0..<writes.len()
        val w = writes.at(i)

        addrs.push(if zero_sized(texpr_type(w.place)) then VNothing else place_addr(e, w.place))

    var curs: Buf[Val] = buf()

    for i in 0..<writes.len()
        val w = writes.at(i)

        if w.op == "=" || nowhere(addrs.at(i)) then curs.push(VNothing)
        else curs.push(held_for_statement(e, load_place(e, w.place, addrs.at(i)),
                                          texpr_type(w.place)))

    var vals: Buf[Val] = buf()

    for i in 0..<writes.len()
        val w = writes.at(i)

        vals.push(held_for_statement(e, gen_expr(e, w.value), texpr_type(w.value)))

    for i in 0..<writes.len()
        val w = writes.at(i)
        val p = addrs.at(i)

        if !nowhere(p)
            if w.op == "="
                store_place(e, w.place, p, vals.at(i))
            else
                val updated = combine(e, w.op, texpr_type(w.place), texpr_type(w.value), w.dispatch,
                                      curs.at(i), vals.at(i))

                w.constraint match
                    Some(c) -> emit_constraint_checks(e, updated, c)
                    None -> ()

                store_over(e, w.place, p, updated, Some(curs.at(i)))

    // One check per struct however many of its fields were written: two arms writing two fields of
    // one value each owe the same re-read of the same clause, and running it twice would say nothing
    // the first did not.
    var done: Buf[TInvCheck] = buf()

    for i in 0..<writes.len()
        val checks = writes.at(i).check

        for k in 0..<checks.len()
            val c = checks.at(k)

            if not_seen(&done, c) then emit_inv_check(e, gen_expr(e, c.value), c.decl, c.inv_fn)
end gen_multi_assign

// Whether this is the first time the check has been asked for, recording it either way.
private not_seen(seen: *Buf[TInvCheck], c: TInvCheck) -> bool
    for i in 0..<seen.len()
        if seen.at(i).inv_fn == c.inv_fn && same_place(seen.at(i).value, c.value) then return false

    seen.push(c)
    true
end not_seen

// Whether two checks name the **same storage**, which is what decides that one of them is worth
// running.
//
// **It is asked of the place and not of the node**, and that is the whole of why it exists: `w.lo`
// and `w.hi` each owe a re-read of `w`, and the two `w`s are different occurrences of one name. A
// comparison by position would call them different and run the clause twice.
//
// An index is compared by occurrence rather than by value, since two indices that happen to compute
// the same number are not the same expression -- the cost of being wrong there is one extra check
// and never a missing one.
private same_place(a: TExpr, b: TExpr) -> bool = *a.kind match
    TLoad(n, _) -> *b.kind match
        TLoad(m, _) -> n == m
        _ -> false
    TGlobal(s, _, _) -> *b.kind match
        TGlobal(t, _, _) -> s == t
        _ -> false
    TField(r, i, _) -> *b.kind match
        TField(q, j, _) -> i == j && same_place(r, q)
        _ -> false
    TIndex(r, x, _) -> *b.kind match
        TIndex(q, y, _) -> same_place(r, q) && x.span == y.span
        _ -> false
    TDeref(o, _) -> *b.kind match
        TDeref(p, _) -> same_place(o, p)
        _ -> false
    _ -> a.span == b.span && texpr_kind_name(a) == texpr_kind_name(b)

// Whether a place turned out to have no address at all, which is what a zero-sized one has.
private nowhere(v: Val) -> bool = v match
    VNothing -> true
    _ -> false

// A value read before anything is written, held for the length of the statement so that a write
// into one place cannot free what another arm is still carrying.
private held_for_statement(e: *Emit, v: Val, ty: Type) -> Val
    retain_value(e, ty, v)
    own_temp(e, v, ty)
end held_for_statement

// One place written from one value, with everything the write owes.
private gen_write(e: *Emit, w: TWrite)
    if !w.check.is_empty() then gap_here(e, "an invariant re-check after a write")

    if zero_sized(texpr_type(w.place))
        gen_expr(e, w.value)
        return

    val p = place_addr(e, w.place)

    if w.op == "="
        val v = gen_expr(e, w.value)

        store_place(e, w.place, p, v)
        return

    val cur = load_place(e, w.place, p)
    val v = gen_expr(e, w.value)
    val updated = combine(e, w.op, texpr_type(w.place), texpr_type(w.value), w.dispatch, cur, v)

    w.constraint match
        Some(c) -> emit_constraint_checks(e, updated, c)
        None -> ()

    store_over(e, w.place, p, updated, Some(cur))
end gen_write

// A `return`, which is where a frame's promises are discharged.
private gen_return(e: *Emit, opt: Option[TExpr])
    opt match
        Some(t) ->
            val ty = texpr_type(t)

            if e.layout.indirect(ty)
                gen_indirect_return(e, t)
                return

            val v = gen_expr(e, t)

            retain_value(e, ty, v)
            emit_ensures(e, Some(v))
            release_all(e)
            emit_term(e, InRet(Some(lty(e, ty)), Some(v)))
        None ->
            emit_ensures(e, None)
            release_all(e)
            emit_term(e, InRet(None, None))
end gen_return

// `become f(…)` -- the call is emitted with `musttail`, and the `ret` it requires goes with it.
//
// **The order is the tail self-call's, for the same reason and one step further.** Each argument is
// computed while the frame is still whole; only then does the frame give up everything it holds; only
// then does the call happen. What the self-jump does after that is store into its own parameter slots
// and branch, because the frame is being reused; what this does is hand the arguments to a
// **different** function, whose frame replaces this one.
//
// **Nothing is retained here and that is a rule rather than an omission.** A callee takes its own
// count on every parameter at entry, so a retain on this side would be a second count nobody
// releases. What makes the release below safe without one is the restriction the analyzer holds a
// `become` to: no parameter carries a count at all, so there is nothing in the frame the release
// could free that an argument still names.
//
// **`musttail` and the `ret` are one instruction as far as a reader is concerned** -- LLVM refuses a
// `musttail` that is not immediately followed by a return of its own result -- so both are emitted
// here rather than left to whatever comes next.
private gen_become(e: *Emit, call: TExpr)
    val ty = texpr_type(call)

    var arg_vals: Buf[IrArg] = buf()
    var what = plain_form(LVoid)
    var callee: Val = VNothing
    var found = false

    *call.kind match
        TCall(name, args, cty, _) ->
            val form = call_form_of(e, name, cty)

            for i in 0..<args.len()
                arg_value(e, args.at(i), &arg_vals)

            what = form
            callee = VGlobal(symbol_of(e, name))
            found = true
        TCallPtr(fn, args, _, cty) ->
            val v = gen_expr(e, fn)

            for i in 0..<args.len()
                arg_value(e, args.at(i), &arg_vals)

            what = sysl_result_form(e, cty)
            callee = v
            found = true
        _ -> ()

    if !found
        gap_here(e, "a 'become' of something that is not a call")
        return
    end if

    release_all(e)

    if no_value(ty)
        emit(e, InCall(None, what.ret, callee, arg_vals, what.ret_attrs, what.whole, no_fast_math(),
                       true))
        emit_term(e, InRet(None, None))
    else
        val r = fresh_reg(e)

        emit(e, InCall(Some(r), what.ret, callee, arg_vals, what.ret_attrs, what.whole,
                       no_fast_math(), true))
        emit_term(e, InRet(Some(lty(e, ty)), Some(r)))
end gen_become

// What a call to a named callee states as its result, and the whole function type where the callee's
// parameter list is open at the end. A foreign result may be named by a type the sysl signature never
// mentions; a sysl one may be `void` where the value comes back through an out-parameter.
private call_form_of(e: *Emit, name: string, ty: Type) -> CallForm
    val form = if is_foreign(e, name) then foreign_result(e, ty) else sysl_result_form(e, ty)

    CallForm(form.ret, form.ret_attrs, variadic_type_of(e, name))
end call_form_of

// -- contracts ---------------------------------------------------------------------------------------

// Whether a clause is a proof obligation rather than something to lay down: it names a `@ghost`
// function, which will not be there.
//
// The question is asked of the **whole** clause rather than of the part that mentions the ghost,
// because a clause is one condition -- half of a conjunction is not a condition anybody wrote.
ghostly(e: *Emit, x: TExpr) -> bool
    if e.ghost_funcs.is_empty() then return false

    var hits: Buf[bool] = buf()
    val sink = &hits
    val named = e.ghost_funcs

    walk_texpr(x, expr_walk(true, k -> note_ghost_call(sink, named, k)))
    !hits.is_empty()
end ghostly

private note_ghost_call(sink: *Buf[bool], ghost: Buf[string], x: TExpr)
    *x.kind match
        TCall(name, _, _, _) -> if holds_string(ghost, name) then sink.push(true)
        _ -> ()

// Whether a call to `name` is the self-call a `variant` is checked at.
checks_variant(e: *Emit, name: string) -> bool =
    e.self_variant.is_some() && name == e.self_name

// The measure check at a direct recursive call.
//
// **It reads no state and threads nothing through the call**, which is what the restriction of a
// function's `variant` to its parameters buys. The arguments about to be passed are the values the
// parameters are about to hold, so the "next" measure is this same expression evaluated with those
// values in the parameters' own slots: take the measure as it stands, put the arguments in, take it
// again, put the parameters back, and compare. Nothing is retained or released across the swap --
// the slots end holding exactly what they held -- so the ownership bookkeeping is untouched.
//
// `staged` is in step with the parameters and carries what each argument came out as, which is the
// shape both call paths already produce: an address for a large value, a register for the rest, and
// nothing at all for a zero-sized parameter.
gen_variant_at_call(e: *Emit, staged: Buf[(int, Val)])
    val variant = e.self_variant.unwrap()

    push_temps(e)

    val cur = gen_expr(e, variant)

    pop_temps(e)

    // Every save is laid down before any argument lands, since a measure over two parameters must
    // see both of the call's values and neither of the frame's.
    var saved: Buf[(string, Type, Val)] = buf()

    for i in 0..<e.self_params.len()
        val p = e.self_params.at(i)
        val s = staged.at(i)

        if s.0 != StagedNothing
            val w = lty(e, p.1)
            val keep = alloca(e, fresh_reg(e), w)
            val addr = VReg(s"${p.0}.addr")

            if s.0 == StagedSlot
                emit_memcpy(e, keep, addr, int(e.layout.size(p.1)), int(e.layout.align(p.1)))
                emit_memcpy(e, addr, s.1, int(e.layout.size(p.1)), int(e.layout.align(p.1)))
            else
                val old = fresh_reg(e)

                emit(e, InLoad(old, w, addr, AccPlain, None))
                emit(e, InStore(w, old, keep, AccPlain, None))
                emit(e, InStore(w, s.1, addr, AccPlain, None))

            saved.push((p.0, p.1, keep))

    push_temps(e)

    val nxt = gen_expr(e, variant)

    pop_temps(e)

    for i in 0..<saved.len()
        val sv = saved.at(i)
        val addr = VReg(s"${sv.0}.addr")

        if e.layout.indirect(sv.1)
            emit_memcpy(e, addr, sv.2, int(e.layout.size(sv.1)), int(e.layout.align(sv.1)))
        else
            val back = fresh_reg(e)

            emit(e, InLoad(back, lty(e, sv.1), sv.2, AccPlain, None))
            emit(e, InStore(lty(e, sv.1), back, addr, AccPlain, None))

    val vty = texpr_type(variant)
    val ok = fresh_reg(e)

    emit(e, InIntCmp(ok, int_pred(e, "<", underlying(vty)), lty(e, vty), nxt, cur))
    trap_unless(e, ok, "variant")
end gen_variant_at_call

// A clause that traps on false, which is what every contract clause is at run time. The condition's
// own temporaries are given back before the trap, so the checked path stays leak-free.
emit_contract(e: *Emit, cond: TExpr, kind: string)
    push_temps(e)

    val ok = gen_expr(e, cond)

    pop_temps(e)
    trap_unless(e, ok, kind)
end emit_contract

// Runs every postcondition with `result` bound to the value about to be returned.
emit_ensures(e: *Emit, result: Option[Val])
    if e.ensures.is_empty() then return

    e.result_ssa = result

    for i in 0..<e.ensures.len()
        emit_contract(e, e.ensures.at(i).cond, "ensure")

    e.result_ssa = None
end emit_ensures

// One iteration's `variant` check: measure, compare against the last one where there was a last one,
// and store. The comparison is **strict** and is signed or unsigned according to the measure's own
// type.
private gen_variant_check(e: *Emit, slot: string, var_ty: Type, expr: TExpr)
    val w = lty(e, var_ty)

    push_temps(e)

    val cur = gen_expr(e, expr)

    pop_temps(e)

    val armed_v = fresh_reg(e)

    emit(e, InLoad(armed_v, l_i1(), VReg(s"$slot.armed"), AccPlain, None))

    val cmp_l = fresh_label(e, "variant.cmp")
    val set_l = fresh_label(e, "variant.set")

    emit_term(e, InCondBr(armed_v, cmp_l, set_l))
    emit_label(e, cmp_l)

    val prev = fresh_reg(e)

    emit(e, InLoad(prev, w, VReg(s"$slot.prev"), AccPlain, None))

    val ok = fresh_reg(e)

    emit(e, InIntCmp(ok, int_pred(e, "<", underlying(var_ty)), w, cur, prev))
    trap_unless(e, ok, "variant")
    emit_term(e, InBr(set_l))
    emit_label(e, set_l)
    emit(e, InStore(w, cur, VReg(s"$slot.prev"), AccPlain, None))
    emit(e, InStore(l_i1(), VInt(from_int(1)), VReg(s"$slot.armed"), AccPlain, None))
end gen_variant_check

// Checks a struct value against its `invariant` function: read each stored field out of the
// aggregate, call the function, and trap on a false result. The fields are handed over exactly as an
// ordinary call's arguments are -- the callee borrows, so no count is taken here.
//
// **A bitfield struct's fields are ranges of one container rather than slots of an aggregate**, so
// they are read out of it once it has been lifted out, which is the same one read whether the
// invariant relates one field or all of them.
emit_inv_check(e: *Emit, v: Val, d: &StructType, inv_fn: string)
    val ranges = bitfield_ranges(d)
    val container = if ranges.is_none() then
            VNothing
        else
            val c = fresh_reg(e)

            emit(e, InExtract(c, struct_lty(d), v, index_list(0)))
            c

    var args: Buf[IrArg] = buf()

    for i in 0..<d.fields.len()
        val ft = d.fields.at(i).1

        if !zero_sized(ft)
            val r = ranges match
                Some(rs) -> read_bits(e, rs, rs.at(d.slot(i)), container)
                None ->
                    val t = fresh_reg(e)

                    emit(e, InExtract(t, struct_lty(d), v, index_list(int(d.slot(i)))))
                    t

            args.push(ir_arg(lty(e, ft), r))

    val ok = fresh_reg(e)

    emit(e, ir_call(Some(ok), l_i1(), VGlobal(symbol_of(e, inv_fn)), args))
    trap_unless(e, ok, "invariant")
end emit_inv_check
