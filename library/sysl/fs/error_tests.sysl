module sysl.fs
@requires(os)
@tests

import sysl.path.join

// What `IoError.message()` says for a code no case names. It used to be `error 92`, a number the reader
// then had to look up; these hold it to the C library's own sentence, written out per platform so the
// expected text comes from the libc's documentation rather than from the call under test.

#if bsd
private ilseq_text() -> string = "Illegal byte sequence"
private unknown_text() -> string = "Unknown error: 4242"
#else
private ilseq_text() -> string = "Invalid or incomplete multibyte or wide character"
private unknown_text() -> string = "Unknown error 4242"
#endif

@test("an Other carrying EILSEQ says the platform's sentence, not the number")
other_says_the_platform_sentence()
    assert_eq(Other(ilseq()).message(), ilseq_text())

@test("print of an Other says the same sentence message() does")
other_displays_the_sentence()
    val e = Other(ilseq())

    assert_eq(f"$e%s", ilseq_text())

@test("a code the C library does not know comes back in its own words")
other_unknown_code_is_libc_words()
    assert_eq(Other(4242).message(), unknown_text())

@test("the unsupported marker is not handed to the C library as an unknown error")
unsupported_says_so()
    assert_eq(unsupported().message(), "not supported on this target")

@test("an Other from a real failing call reads as the platform's sentence")
other_from_a_real_call()
    val dir = "/tmp/sysl-fs-errtext"

    remove_dir_all(dir) match
        _ -> ()

    make_dir(dir).unwrap()

    val f = join(dir, "plain")

    write_bytes(f, [u8('x')]).unwrap()

    val e = read_link(f).unwrap_err()

    assert_eq(e, Other(22))
    assert_eq(e.message(), "Invalid argument")

    remove_dir_all(dir).unwrap()
end other_from_a_real_call

@test("the named cases keep this module's words")
named_cases_unchanged()
    assert_eq(NotFound.message(), "no such file or directory")
    assert_eq(InvalidUtf8(3).message(), "not UTF-8 at byte 3")

// The library's own table, which is what a target with no C library says for a code its supplier has
// no words for. The expected words are written out here rather than read back from the table.

@test("the table holds the V7 numbers every platform agrees on, in this module's lower case")
table_holds_the_agreed_numbers()
    assert_eq(errno_words(1).unwrap(), "operation not permitted")
    assert_eq(errno_words(16).unwrap(), "device or resource busy")
    assert_eq(errno_words(22).unwrap(), "invalid argument")
    assert_eq(errno_words(34).unwrap(), "numerical result out of range")

@test("the codes whose number differs between the two families are held at this target's number")
table_holds_family_codes_at_their_number()
    assert_eq(errno_words(not_empty()).unwrap(), "directory not empty")
    assert_eq(errno_words(ilseq()).unwrap(), "illegal byte sequence")
    assert_eq(errno_words(again()).unwrap(), "resource temporarily unavailable")

#if bsd
@test("on a BSD, 11 is EDEADLK and the table makes no claim about it")
table_leaves_bsd_eleven_alone()
    assert(errno_words(11).is_none(), "11 has words")
#endif

@test("a code past the agreed numbers, zero, a negative and the unsupported marker have no words")
table_answers_none_past_its_numbers()
    for code in [0, -1, -38, 40, 89, 4242]
        if code == not_empty() || code == ilseq() || code == again() then continue

        assert(errno_words(code).is_none(), s"$code")
