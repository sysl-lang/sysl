// P2: a trait member generic over the format, implemented by hand and by a generic helper
// written with reflection (what a derive member would expand to).
trait Encoder
    begin_struct(*self, name: string)
    field(*self, key: string)
    end_struct(*self)
    int(*self, v: long)
    str(*self, v: string)

trait Encode
    encode[E: Encoder](self, e: *E)

encode_struct[T, E: Encoder](v: T, e: *E)
    e.begin_struct(T::BaseName)

    for const f in T::Fields
        e.field(f.name)
        v.(f).encode(e)

    e.end_struct()

impl Encode for int
    encode[E: Encoder](self, e: *E) = e.int(self)

impl Encode for string
    encode[E: Encoder](self, e: *E) = e.str(self)

struct Json
    out: string

impl Encoder for Json
    begin_struct(*self, name: string) = self.out = self.out + "{"
    field(*self, key: string)
        if !self.out.ends_with("{") then self.out = self.out + ","
        self.out = self.out + s"\"$key\":"
    end_struct(*self) = self.out = self.out + "}"
    int(*self, v: long) = self.out = self.out + s"$v"
    str(*self, v: string) = self.out = self.out + s"\"$v\""

struct Inner
    z: int

impl Encode for Inner
    encode[E: Encoder](self, e: *E) = encode_struct(self, e)

struct User
    id: int
    name: string
    inner: Inner

impl Encode for User
    encode[E: Encoder](self, e: *E) = encode_struct(self, e)

var j = Json("")
User(7, "ann", Inner(3)).encode(&j)
print(j.out)
