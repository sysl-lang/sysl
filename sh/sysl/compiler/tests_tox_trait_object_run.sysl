module sh.sysl.compiler
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.Search
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture

// Trait objects at run time -- the dynamic half of `reference/traits.md`'s objects. A static
// resolution could produce the right answer for one type by coincidence, so each case drives two
// types whose implementations return values that could not be confused, through one variable, one
// parameter or one array element. The ownership cases loop long enough that a leak or a double free
// shows up as something other than a passing test.
//
// **Every output and every refusal quoted here was read out of the reference compiler (0.0.157)**,
// whose `TraitObjectRunTests` these are.

private tox_ready() -> bool
    std_root() match
        Err(_) ->
            print("skipped: the standard module's source is not on this machine")
            return false
        Ok(_) -> ()

    if !clang_available()
        print("skipped: there is no clang on this machine")
        return false

    true
end tox_ready

// What a program PRINTS and what it EXITS with, from a fresh build. A program that did not build
// answers `-1` and the refusal, so a build failure cannot read as a program that stopped.
private tox_ran(text: string) -> (string, int)
    val root = make_temp_dir("sysl-trait-object-run").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", text).unwrap()

    val exe = s"$root/built"

    build_native_program(s"$root/main.sysl", None, None, DefaultOptimization, Some(exe)) match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return (failure_text(why), -1)
        Ok(_) -> ()

    val said = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    said match
        Err(_) -> ("the program that was built could not be run", -1)
        Ok(out) -> out.status match
            Exited(code) -> (out.text, code)
            _ -> (out.text, -2)
end tox_ran

private tox_prints(text: string, expected: string)
    if !tox_ready() then return

    val ran = tox_ran(text)

    assert_eq(ran.0, expected)
    assert_eq(ran.1, 0)

// Two shapes whose areas are far apart, so a call that reached the wrong one is obvious.
private tox_shape() -> string = raw"""
    trait Shape
        area(self) -> int
    struct Rect
        w: int
        h: int
    struct Sq
        s: int
    impl Shape for Rect
        area(self) -> int = self.w * self.h
    impl Shape for Sq
        area(self) -> int = self.s * self.s
    """

private tox_shape_prints(text: string, expected: string) = tox_prints(tox_shape() + text, expected)

// Two multiplications far enough apart that a call reaching the wrong one is obvious.
private tox_muls() -> string = raw"""
    struct Scale
        k: real
    struct Shift
        d: real
    impl Mul[real, real] for Scale
        mul(self, x: real) -> real = self.k * x
    impl Mul[real, real] for Shift
        mul(self, x: real) -> real = x + self.d
    """

private tox_muls_prints(text: string, expected: string) = tox_prints(tox_muls() + text, expected)

// A refusal is its whole first line and its position; the `-->` line carries the temporary
// directory, so the position is read from the end of it.
private tox_refused(text: string, message: string, at: string)
    if !tox_ready() then return

    val root = make_temp_dir("sysl-trait-object-run").unwrap()
    val src = s"$root/main.sysl"

    make_dir_all(root).unwrap()
    write_text(src, text).unwrap()

    val said = emit_llvm_text(src, None) match
        Err(why) -> failure_text(why)
        Ok(made) -> analysis_report(made.report)

    remove_dir_all(root).unwrap_or(())

    assert(said.starts_with(s"error: $message\n"), said)
    assert(said.contains(s"main.sysl:$at\n"), said)
end tox_refused

// -- a raw trait object ----------------------------------------------------------------------------

@test("dispatches to the implementation of whatever it points at")
tox_dispatches_to_whatever_it_points_at()
    tox_shape_prints(raw"""
        report(s: *Shape) -> int = s.area()
        var r = Rect(3, 4)
        var q = Sq(5)
        print(report(&r), report(&q))
        """, "12 25\n")

// One variable, two types, two answers -- read through the same call site both times, so the call
// cannot have been resolved when it was compiled.
@test("changes which implementation it reaches when it is reassigned")
tox_changes_implementation_when_reassigned()
    tox_shape_prints(raw"""
        var r = Rect(3, 4)
        var q = Sq(5)
        var s: *Shape = &r
        print(s.area())
        s = &q
        print(s.area())
        """, "12\n25\n")

@test("holds types of different sizes in one array")
tox_holds_types_of_different_sizes_in_one_array()
    tox_shape_prints(raw"""
        var r = Rect(3, 4)
        var q = Sq(5)
        var all: [2]*Shape = [&r, &q]
        var total = 0
        for s in all
            total += s.area()
        print(total)
        """, "37\n")

@test("reaches a '*self' method, which mutates the value it points at")
tox_reaches_a_pointer_self_method()
    tox_prints(raw"""
        trait Bump
            bump(*self, by: int)
        struct C
            n: int
        impl Bump for C
            bump(*self, by: int)
                self.n += by
        var c = C(1)
        var b: *Bump = &c
        b.bump(41)
        print(c.n)
        """, "42\n")

// A built-in has an owner key its members are filed under exactly as a struct does, so an `impl` for
// one is erasable exactly as a struct's is.
@test("erases a built-in type")
tox_erases_a_built_in_type()
    tox_prints(raw"""
        trait Show
            show(self) -> string
        impl Show for int
            show(self) -> string = "an int"
        impl Show for bool
            show(self) -> string = "a bool"
        var n = 5
        var b = true
        var x: *Show = &n
        var y: *Show = &b
        print(x.show(), y.show())
        """, "an int a bool\n")

@test("erases an enum")
tox_erases_an_enum()
    tox_prints(raw"""
        trait Shape
            area(self) -> int
        enum E
            One
            Two
        impl Shape for E
            area(self) -> int = self match
                One -> 1
                Two -> 2
        var e = Two
        var s: *Shape = &e
        print(s.area())
        """, "2\n")

// Two traits over one type make two tables, and each object reaches only its own -- the two methods
// return different values, so a shared table would show up as one of them answering for both.
@test("one value erased to two traits reaches the right table each time")
tox_one_value_erased_to_two_traits()
    tox_prints(raw"""
        trait A
            a(self) -> int
        trait B
            b(self) -> int
        struct S
            n: int
        impl A for S
            a(self) -> int = self.n
        impl B for S
            b(self) -> int = self.n * 2
        var s = S(21)
        var x: *A = &s
        var y: *B = &s
        print(x.a(), y.b())
        """, "21 42\n")

@test("a method takes arguments and returns a value of any type")
tox_a_method_takes_arguments_and_returns_a_value()
    tox_prints(raw"""
        trait Talk
            say(self, to: string, times: int) -> string
        struct P
            who: string
        impl Talk for P
            say(self, to: string, times: int) -> string =
                if times > 1 then self.who + " to " + to + "!" else self.who + " to " + to
        var p = P("ada")
        var t: *Talk = &p
        print(t.say("bob", 1))
        print(t.say("bob", 2))
        """, "ada to bob\nada to bob!\n")

@test("a method returning nothing runs for its effect")
tox_a_method_returning_nothing_runs_for_its_effect()
    tox_prints(raw"""
        trait Sink
            put(self, n: int)
        struct S
            tag: int
        impl Sink for S
            put(self, n: int)
                print(self.tag + n)
        var s = S(40)
        var k: *Sink = &s
        k.put(2)
        """, "42\n")

// -- a counted trait object ------------------------------------------------------------------------

// The allocation is the construction, exactly as it is for a plain `&T`: writing the value where a
// `&Trait` is expected boxes it and erases the box in one step.
@test("is made by writing the value a context expects one at")
tox_counted_is_made_where_the_context_expects_one()
    tox_shape_prints(raw"""
        var a: &Shape = Rect(3, 4)
        var b: &Shape = Sq(5)
        print(a.area(), b.area())
        """, "12 25\n")

@test("is also made from a reference already in hand")
tox_counted_is_made_from_a_reference_in_hand()
    tox_shape_prints(raw"""
        var r: &Rect = Rect(6, 7)
        var s: &Shape = r
        print(s.area())
        """, "42\n")

// `&self` needs its receiver inside the box, which is exactly what a counted object carries -- so the
// mutation is to the shared object and survives the call.
@test("reaches a '&self' method, which mutates the shared object")
tox_counted_reaches_a_ref_self_method()
    tox_prints(raw"""
        trait Ticker
            tick(&self)
            value(self) -> int
        struct Clock
            t: int
        impl Ticker for Clock
            tick(&self)
                self.t += 1
            value(self) -> int = self.t
        var c: &Ticker = Clock(0)
        c.tick()
        c.tick()
        c.tick()
        print(c.value())
        """, "3\n")

@test("meets two branches of different concrete types at one type")
tox_counted_meets_two_branches_at_one_type()
    tox_shape_prints(raw"""
        make(big: bool) -> &Shape = if big then Sq(5) else Rect(3, 4)
        var pick = 1
        var m: &Shape = pick match
            1 -> Sq(6)
            _ -> Rect(1, 1)
        print(make(true).area(), make(false).area(), m.area())
        """, "25 12 36\n")

@test("is carried through a struct field and an enum payload")
tox_counted_through_a_field_and_a_payload()
    tox_shape_prints(raw"""
        struct Holder
            it: &Shape
        var h = Holder(Rect(6, 7))
        var o: Option[&Shape] = Some(Sq(5))
        var second = o match
            Some(s) -> s.area()
            None -> 0
        print(h.it.area(), second)
        """, "42 25\n")

// -- ownership: every counted object holds one count of the box it erased --------------------------

@test("a counted object made and dropped in a loop neither leaks nor frees twice")
tox_made_and_dropped_in_a_loop()
    tox_shape_prints(raw"""
        var i = 0
        var total = 0
        while i < 300000
            var s: &Shape = Sq(5)
            total += s.area()
            i++
        print(total)
        """, "7500000\n")

// The object's payload holds a reference of its own, so releasing the object has to release what the
// payload held -- the box's destructor doing its ordinary work through a pointer whose static type
// has been forgotten.
@test("a counted object over a reference-carrying payload is torn down completely")
tox_reference_carrying_payload_is_torn_down()
    tox_prints(raw"""
        trait Held
            v(self) -> int
        struct Inner
            n: int
        struct Tag
            label: string
            inner: &Inner
        impl Held for Tag
            v(self) -> int = self.inner.n
        var i = 0
        var total = 0
        while i < 200000
            var h: &Held = Tag("tag", Inner(3))
            total += h.v()
            i++
        print(total)
        """, "600000\n")

@test("a method returning a counted object hands over a count of its own")
tox_a_method_returning_a_counted_object()
    tox_shape_prints(raw"""
        trait Maker
            make(self) -> &Shape
        struct M
            n: int
        impl Maker for M
            make(self) -> &Shape = Sq(self.n)
        var m = M(5)
        var k: *Maker = &m
        var i = 0
        var total = 0
        while i < 200000
            total += k.make().area()
            i++
        print(total)
        """, "5000000\n")

// A by-value receiver is loaded out of the object and handed to the implementation, which retains it
// on entry and releases it on return: the string field would otherwise be freed out from under the
// object, or never freed at all.
@test("a by-value receiver carrying a string leaves the object's own count alone")
tox_a_by_value_receiver_carrying_a_string()
    tox_prints(raw"""
        trait Label
            label(self) -> string
        struct Tag
            text: string
        impl Label for Tag
            label(self) -> string = self.text
        var i = 0
        var total: usize = 0
        while i < 200000
            var t: &Label = Tag("abcd")
            total += t.label().len
            total += t.label().len
            i++
        print(total)
        """, "1600000\n")

// -- a type that implements a trait and holds one --------------------------------------------------

// `Group.area` calls `area` through the table, and one of the parts is another `Group`. Nothing in the
// implementation knows that, which is the point: the recursion is in the values.
@test("reaches itself through the table when it holds itself")
tox_reaches_itself_through_the_table()
    tox_prints("import sysl.buf.*\n\n" + tox_shape() + raw"""
        struct Group
            parts: &Buf[&Shape]
        impl Shape for Group
            area(self) -> int
                var t = 0
                for i in 0..<self.parts.len() do t += self.parts.at(i).area()
                t
        var inner: &Buf[&Shape] = buf()
        inner.push(Rect(3, 4))
        inner.push(Sq(5))
        var outer: &Buf[&Shape] = buf()
        outer.push(Group(inner))
        outer.push(Sq(10))
        var g: &Shape = Group(outer)
        print(g.area())
        """, "137\n")

// A wrapper holding exactly one object -- the answer is the inner one's adjusted, and the wrapper is
// itself erasable so wrappers stack.
@test("wraps one object, and wrappers stack")
tox_wraps_one_object_and_wrappers_stack()
    tox_shape_prints(raw"""
        struct Scaled
            inner: &Shape
            k: int
        impl Shape for Scaled
            area(self) -> int = self.inner.area() * self.k * self.k
        var once: &Shape = Scaled(Rect(3, 4), 2)
        var twice: &Shape = Scaled(Scaled(Rect(3, 4), 2), 3)
        print(once.area(), twice.area())
        """, "48 432\n")

// Every link holds one count of the next, so a leak or a double free anywhere down the chain shows up
// here rather than in a passing test.
@test("releases the whole chain when the outermost is let go")
tox_releases_the_whole_chain()
    tox_shape_prints(raw"""
        struct Scaled
            inner: &Shape
            k: int
        impl Shape for Scaled
            area(self) -> int = self.inner.area() * self.k * self.k
        var total = 0
        var i = 0
        while i < 100000
            var s: &Shape = Scaled(Scaled(Scaled(Sq(2), 2), 2), 2)
            total += s.area()
            i++
        print(total)
        """, "25600000\n")

// -- an operator trait at written arguments --------------------------------------------------------

// Writing both arguments out leaves `mul(self, rhs: real) -> real` with no `Self` in it, so two types
// with quite different multiplications dispatch dynamically through one slot. The operator TOKEN does
// not reach through an object: the catalog's dispatch is on a pair of types and an object has
// forgotten the one on the left, so the method is what an object offers.
@test("is erasable, and the table picks the implementation")
tox_an_operator_trait_is_erasable()
    tox_muls_prints(raw"""
        apply(f: &Mul[real, real], x: real) -> real = f.mul(x)
        var a: &Mul[real, real] = Scale(3.0)
        var b: &Mul[real, real] = Shift(10.0)
        print(apply(a, 2.0))
        print(apply(b, 2.0))
        """, "6\n12\n")

@test("and a row of them dispatches one slot per element")
tox_a_row_of_operator_objects()
    tox_muls_prints(raw"""
        var fs: [2]&Mul[real, real] = [Scale(2.0), Shift(1.0)]
        var total = 0.0
        for f in fs
            total += f.mul(4.0)
        print(total)
        """, "13\n")

@test("the operator token still needs both types, so it is refused on an object")
tox_the_operator_token_is_refused_on_an_object()
    tox_refused(tox_muls() + raw"""
        apply(f: &Mul[real, real], x: real) -> real = f * x
        """, "'*' needs matching types, got &sysl.Mul[real, real] and real", "9:51")

// `reference/traits.md`'s six positions the coercion applies at -- an argument, a declared variable,
// an assignment, a returned value, an array element, a struct field -- taken together so the list is
// pinned as a list.
@test("erasure applies at every position the chapter names")
tox_erasure_applies_at_every_position()
    tox_prints(raw"""
        trait Shape
            area(self) -> int

        struct Rect
            w: int
            h: int

        impl Shape for Rect
            area(self) -> int = self.w * self.h

        struct Holder
            s: &Shape

        take(s: &Shape) -> int = s.area()
        give() -> &Shape = Rect(2, 3)

        var decl: &Shape = Rect(1, 2)
        var assigned: &Shape = Rect(1, 1)
        assigned = Rect(4, 5)
        var arr: [2]&Shape = [Rect(1, 3), Rect(2, 2)]
        var h = Holder(Rect(6, 6))

        print(take(Rect(7, 1)), give().area(), decl.area(), assigned.area(), arr[0].area(), h.s.area())
        """, "7 6 2 20 3 36\n")

// -- an integer's Display is written out too, so it erases like anything else ----------------------

// The `iN`/`uN` families are covered by the library's one blanket block over `Integer`, so an
// integer's `display` is an ordinary lowered function and a slot can point at it.
@test("as a counted object and as a raw one")
tox_an_integer_display_counted_and_raw()
    tox_prints(raw"""
        var n = 5
        var d: &Display = 5
        var p: *Display = &n
        print(d)
        print(p)
        """, "5\n5\n")

@test("in an array of them")
tox_an_integer_display_in_an_array()
    tox_prints(raw"""
        var xs: [3]&Display = [1, 2, 3]
        for x in xs do print(x)
        """, "1\n2\n3\n")

// One array, five types, three of them integers of different widths -- which no list of written
// blocks could have covered.
@test("and in a heterogeneous one, which is what an open family made impossible")
tox_an_integer_display_in_a_heterogeneous_array()
    tox_prints(raw"""
        var n = 42
        var w = 7u8
        var big = 340282366920938463463374607431768211455u128
        var s = "hi"
        var f = 2.5
        var five: [5]*Display = [&n, &w, &big, &s, &f]
        for d in five do print(d)
        """, "42\n7\n340282366920938463463374607431768211455\nhi\n2.5\n")

// A width no C conversion reaches, erased and dispatched.
@test("at a width the machine has no instruction for")
tox_an_integer_display_at_a_width_with_no_instruction()
    tox_prints(raw"""
        var v = u256(1) << u256(200)
        var d: *Display = &v
        print(d)
        """, "1606938044258990275541962092341162602522202993782792835301376\n")

@test("though a bound over that same trait is met, and print finds the same rendering")
tox_a_bound_over_display_is_met()
    tox_prints(raw"""
        show[T: Display](x: T)
            print(x)

        show(5)
        show("hi")
        """, "5\nhi\n")

// A closed family's membership is written out, so a slot in the table is a function that exists and
// the value erases.
@test("while a closed family's, being written out, erases and dispatches")
tox_a_closed_familys_display_erases()
    tox_prints(raw"""
        var spec = FormatSpec(0, -1, false)
        var text = "hi"
        var flag = true
        var ch = 'x'
        var num = 3.5
        var s: *Display = &text
        var b: *Display = &flag
        var c: *Display = &ch
        var r: *Display = &num
        for d in [s, b, c, r] do d.display(stdout(), spec)
        print("")
        """, "hitruex3.5\n")

// A tuple is a built-in shape too, and it erases, because the library writes it an `impl`.
@test("while a tuple, whose membership the library writes out, erases and dispatches")
tox_a_tuple_display_erases()
    tox_prints(raw"""
        var d: &Display = (1, 2)
        print(d)
        """, "(1, 2)\n")
