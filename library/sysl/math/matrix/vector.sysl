module sysl.math.matrix

import sysl.buf.{Buf, buf}

// Vectors over any `Scalar`, and the half of a vector space whose product yields a *scalar*.
//
// **`v * w` is a `T` and `v * k` is a `Vector[T]`, and both are `Mul` on `Vector[T]`.** An operator
// trait's result is an argument, so the two are told apart by the type of the right operand and by
// nothing else, and each says what it hands back. Written with the result fixed to `Self` the first
// of them is unspellable, and a dot product becomes a method while scaling stays an operator -- which
// is a split a reader of one line of linear algebra should never have to see.
//
// **Every operator here is written once, for every element type at once.** A block whose trait
// arguments are built out of its own parameter says the same thing at every instantiation, so
// `impl[T: Scalar] Mul[Vector[T], T] for Vector[T]` is one dot product for the reals, the complexes,
// the integers and whatever else implements `Scalar`.
//
// **A `Vector[T]` is a handle.** It is a length and a `&Buf[T]`, so assigning one shares the numbers
// and costs a retain. Every operator below therefore builds a fresh vector rather than writing into
// either operand, the one member that does write in place says so in its name (`set`), and `copy` is
// how a caller stops sharing. That is the bargain a string strikes: the operation that copies is
// named, and the sharing is documented rather than encoded. A value-semantics vector would need a
// fixed `[N]T`, which a type whose length is a runtime value cannot have.
struct Vector[T: Scalar]
    n: int
    cells: &Buf[T]

    // --- The vectors that need no receiver, reached through the type. ---

    // The zero vector, which needs the element type's own zero and has no other way to get one. This
    // is what `Zero` is for: `T.zero()` is a value of a type this body has never met, and no literal
    // spells it.
    zeros(n: int) -> Vector[T]
        var cells: Buf[T] = buf()

        for i in 0..<n do cells.push(T.zero())

        Vector(n, cells)
    end zeros

    // A vector from the numbers a program wrote. The element type comes off the slice, so
    // `Vector.of([1.0, 2.0])` is a `Vector[real]` and nothing is written twice.
    of(xs: []const T) -> Vector[T]
        var out: Vector[T] = Vector.zeros(int(xs.len))

        for i in 0..<int(xs.len) do out.set(i, xs[i])

        out
    end of

    // The `i`th standard basis vector, which is a column of the identity and the second place an
    // identity is asked for rather than written.
    basis(n: int, i: int) -> Vector[T]
        var out: Vector[T] = Vector.zeros(n)

        out.set(i, T.one())
        out

    // --- What a vector is, read off it. ---

    at(self, i: int) -> T = self.cells.at(usize(i))

    set(*self, i: int, v: T) = self.cells.set(usize(i), v)

    // The dot product of a vector with itself, which is `self * self`.
    //
    // **Over the reals this is the squared length, and over the complexes it is not.** `z * z` is a
    // complex number, and a sum of them can be zero for a vector nowhere near the origin. That
    // identity is a fact about the reals rather than about vector spaces, which is why `len` below is
    // computed from magnitudes and not from this.
    quadratic_form(self) -> T = self * self

    // The Euclidean length: the root of the sum of the squared *magnitudes*, which is the definition
    // that holds at every element type.
    //
    // Taken through `norm` rather than through `magnitude` because a length is arithmetic on sizes
    // and not a comparison between them -- `Magnitude` promises `Size: Ord` and nothing else.
    len(self) -> real
        var total = 0.0

        for i in 0..<self.n
            var m = self.at(i).norm()

            total += m * m

        total.sqrt()
    end len

    // A vector that shares nothing with this one. The elimination is the customer: it writes into
    // rows, so it must be given a copy or it would consume the matrix it was asked about.
    copy(self) -> Vector[T]
        var out: Vector[T] = Vector.zeros(self.n)

        for i in 0..<self.n do out.set(i, self.at(i))

        out
    end copy

    // Agreement to within a tolerance, which is the question floating point makes the right one
    // almost everywhere. `==` is exact and is what `Eq` below gives; this is what a caller holding
    // reals actually wants.
    //
    // The tolerance is a `real` whatever the elements are, since a literal has to be written at some
    // width, so the difference is measured with `norm` rather than compared as a size against a size.
    near(self, rhs: Vector[T], eps: real) -> bool
        if self.n != rhs.n then return false

        for i in 0..<self.n
            if (self.at(i) - rhs.at(i)).norm() > eps then return false

        true
    end near
end Vector

// Exact, componentwise equality. Right for the integers and for a residual that is meant to be zero;
// **`near` is what a program holding floats should reach for**, and the two are separate so that the
// choice is made rather than inherited.
impl[T: Scalar] Eq for Vector[T]
    eq(self, rhs: Vector[T]) -> bool
        if self.n != rhs.n then return false

        for i in 0..<self.n
            if self.at(i) != rhs.at(i) then return false

        true
    end eq

// `(a, b, c)`, with each element rendered as its own type renders it -- which is what `Scalar`
// requiring `Display` buys. The field applies to the whole value rather than to each part
// (`library/core.md § A specifier is the whole value's field`), so the text is gathered first and
// padded once.
impl[T: Scalar] Display for Vector[T]
    display(self, out: *Writer, fmt: FormatSpec)
        var text = "("

        for i in 0..<self.n
            if i > 0 then text += ", "
            text += str(self.at(i))

        display_str(text + ")", out, fmt)
    end display

impl[T: Scalar] Add for Vector[T]
    add(self, rhs: Vector[T]) -> Vector[T]
        require self.n == rhs.n, "vectors added must have the same length"

        var out: Vector[T] = Vector.zeros(self.n)

        for i in 0..<self.n do out.set(i, self.at(i) + rhs.at(i))

        out
    end add

impl[T: Scalar] Sub for Vector[T]
    sub(self, rhs: Vector[T]) -> Vector[T]
        require self.n == rhs.n, "vectors subtracted must have the same length"

        var out: Vector[T] = Vector.zeros(self.n)

        for i in 0..<self.n do out.set(i, self.at(i) - rhs.at(i))

        out
    end sub

impl[T: Scalar] Neg for Vector[T]
    neg(self) -> Vector[T]
        var out: Vector[T] = Vector.zeros(self.n)

        for i in 0..<self.n do out.set(i, -self.at(i))

        out
    end neg

// The dot product: two vectors in, one **element** out. `Mul[Vector[T], T]` -- the operands select
// the implementation and the implementation says the result, so this and the scaling below are one
// operator on one type.
//
// The accumulator starts at `T.zero()`, which is also what makes a zero-length vector's dot product
// the value every other one has rather than a case to special-case.
impl[T: Scalar] Mul[Vector[T], T] for Vector[T]
    mul(self, rhs: Vector[T]) -> T
        require self.n == rhs.n, "vectors multiplied must have the same length"

        var total = T.zero()

        for i in 0..<self.n do total += self.at(i) * rhs.at(i)

        total
    end mul

// Scaling, whose result *is* a vector. Nothing but the right operand's type tells this from the dot
// product above, and nothing needs to.
impl[T: Scalar] Mul[T] for Vector[T]
    mul(self, k: T) -> Vector[T]
        var out: Vector[T] = Vector.zeros(self.n)

        for i in 0..<self.n do out.set(i, self.at(i) * k)

        out
    end mul

impl[T: Scalar] Index[int, T] for Vector[T]
    index(self, i: int) -> T = self.at(i)

impl[T: Scalar] IndexSet[int, T] for Vector[T]
    index_set(*self, i: int, v: T) = self.set(i, v)
