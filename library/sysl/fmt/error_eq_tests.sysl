module sysl.fmt
@tests

@test("eqe: FormatError is equal variant by variant and payload by payload")
eqe_format_error()
    assert(FormatError.BadSpec == FormatError.BadSpec)
    assert(FormatError.Short(8) == FormatError.Short(8))
    assert(FormatError.Short(8) != FormatError.Short(9))
    assert(FormatError.Short(8) != FormatError.BadSpec)

@test("eqe: Result and Option[Result] over FormatError compare with ==")
eqe_format_result()
    val r: Result[int, FormatError] = Err(FormatError.Short(8))
    assert(r == Err(FormatError.Short(8)))
    assert(r != Err(FormatError.BadSpec))
    assert(r != Ok(8))
    val o: Option[Result[int, FormatError]] = Some(r)
    assert(o == Some(Err(FormatError.Short(8))))
    assert(o != Some(Err(FormatError.Short(9))))
