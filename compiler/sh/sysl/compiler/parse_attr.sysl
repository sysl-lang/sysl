module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.Search

// `@` and what follows it: the annotations a declaration carries, the `@assert` that is a
// declaration of its own, and the refusals for the ones written where they say nothing.
//
// **An annotation describes the declaration under it, and `@assert` describes nothing but itself.**
// That is the whole of what tells the two apart, and it is why the parentheses are not optional
// there: they are what make the line a declaration rather than a prefix.

// No annotations at all, which is what most declarations carry.
no_attrs() -> Buf[Attr] = buf()

// The words that belong in a file's header rather than above a declaration.
header_attr_word(w: string) -> bool
    if w.starts_with("no_") && w.len > 3 then return true

    for word in ["requires", "link", "include", "tests"]
        if word == w then return true

    false
end header_attr_word

// The header words that may also stand above one function or method, holding that definition (and
// what it calls) to the promise rather than the whole module.
//
// **In the header the word is still the module's clause**: the header is read first, so a file whose
// first declaration is the function writes an `import` or another declaration above it, or the
// module's clause is what it wrote.
fn_forgo_word(w: string) -> bool = w == "no_alloc" || w == "no_block"

// The word a `@` is followed by, or `""` where it is followed by no name at all.
attr_name(p: *Parser) -> string = p.peek_at(1) match
    Ident(n) -> n
    _ -> ""

// A statement opening with `@`.
parse_at_stmt(p: *Parser, start: Span) -> Stmt
    val word = attr_name(p)

    if header_attr_word(word) && !fn_forgo_word(word)
        p.fault(start, "this attribute belongs in the file's header, on the lines directly after 'module' and before everything else — it is a property of the whole module, not of the statements below it")
        skip_line(p)
        return stmt(start.to(p.just_taken()), Bad)
    end if

    if word == "assert" then return parse_assert_decl(p, start)

    parse_attributed_decl(p, start)
end parse_at_stmt

// `@assert(cond)`, `@assert(cond, "why")`, `@assert(cond, s"why ${T::Name}")` -- a condition settled
// while compiling, and what to say when it does not hold.
private parse_assert_decl(p: *Parser, start: Span) -> Stmt
    p.bump()
    p.bump()

    if !p.at_kw("(")
        p.fault(start, "'@assert' takes its condition in parentheses — '@assert(sizeof(T) == 16)', with an optional message after a comma. It is the parentheses that make it this declaration rather than an annotation about the one under it")
        skip_line(p)
        return stmt(start.to(p.just_taken()), Bad)
    end if

    p.bump()

    val cond = parse_expr(p)
    var message: Option[Expr] = None

    if p.accept_kw(",") then message = Some(parse_expr(p))

    p.expect_kw(")")
    stmt(start.to(p.just_taken()), AssertDecl(cond, message))
end parse_assert_decl

// -- the annotations themselves -------------------------------------------------------------------

// Every annotation above one declaration, and the newlines between them: each is its own line and
// the declaration follows the last of them.
parse_attr_list(p: *Parser) -> Buf[Attr]
    var out: Buf[Attr] = buf()

    loop
        if !p.at_kw("@") && !p.at_kw("#") then break

        parse_attribute(p) match
            Some(a) -> out.push(a)
            None -> break

        p.skip_newlines()

    refuse_duplicates(p, out, "declaration")
    refuse_blocks_beside_no_block(p, out)
    out
end parse_attr_list

// The annotations a member may carry: the ones about a parameter, and the three about the function
// the member lowers to. `in_trait` is whether the member is a trait's own declaration.
parse_member_attrs(p: *Parser, in_trait: bool) -> Buf[Attr]
    var out: Buf[Attr] = buf()

    loop
        if !p.at_kw("@") && !p.at_kw("#") then break

        val at = p.here()
        val word = attr_name(p)

        // **`@keeps` above a member is the free function's case**: the body is right here, or the
        // member is a trait's, whose parameters are borrowed for the call by rule.
        if word == "keeps" && !p.at_kw("#")
            p.fault(at, keeps_off_extern())
            skip_line(p)
            break
        end if

        if word == "answers" && !p.at_kw("#")
            p.fault(at, answers_off_extern())
            skip_line(p)
            break
        end if

        // An indented '#' never reaches the directive pass, so whatever word follows it, the member
        // rule answers -- and names the sigil, since '@' is what the reader writes in any case.
        if p.at_kw("#")
            p.fault(at, member_attr_refusal() + ". An annotation is written '@' in any case — '#' opens a directive, which gates lines before the lexer sees them and sits at the margin")
            skip_line(p)
            break
        end if

        if !member_attr_word(word)
            if word == "assert"
                p.fault(at, "'@assert' stands where a declaration stands, and a type's body holds its members — write it beside the type rather than inside it, where 'sizeof' and 'offsetof' still name what it is about")
            else if word == "align" || word == "packed" || word == "byte_order"
                p.fault(at, layout_attr_on_member(word))
            else
                p.fault(at, member_attr_refusal())

            skip_line(p)
            break
        end if

        parse_attribute(p) match
            Some(a) -> out.push(a)
            None -> break

        p.skip_newlines()

    refuse_duplicates(p, out, "member")
    refuse_blocks_beside_no_block(p, out)
    out
end parse_member_attrs

// `@scoped(f)` naming a call above a function with no receiver: what the promise is about is the
// receiver a call lent, and a free function has none. A pointer parameter it may name anywhere.
scoped_on_free_function() -> string =
    "'@scoped' naming a callable parameter says a method runs it in another concurrency domain and finishes it before the call that lent the method's '*self' returns, so it stands above a method — a free function has no receiver for a call to have lent. Above a free function '@scoped' names '*T' parameters only, the pointers it lets go of before its caller's scope ends"

// `@scoped` above anything that is not called: the promise is about a parameter.
scoped_on_field() -> string =
    "'@scoped' names the parameters a function lets go of before its caller's scope ends — a callable it runs and finishes, or a '*T' it holds only while its caller waits — so it stands above a function or a method; a field and a variant are never called, and have no parameter to run"

// `@keeps(...)` anywhere but above an `extern`: a body the compiler can read says what it keeps.
keeps_off_extern() -> string =
    "'@keeps(...)' names the parameters a C function holds on to past the call, so it marks an 'extern' — a function's or a method's body is right here, and the compiler reads what it keeps out of it"

// `@answers(...)` anywhere but above an `extern`: a body the compiler can read says what its answer
// is made of.
answers_off_extern() -> string =
    "'@answers(...)' names the parameters the pointer a C function answers may point into, so it marks an 'extern' — a function's or a method's body is right here, and the compiler reads what its answer is made of out of it"

private member_attr_refusal() -> string =
    "the only annotations a member may carry are the ones about a parameter — '@crossing', '@reads' and '@writes' — and the six about the function it lowers to, '@noinline', '@inline', '@cold', '@no_alloc', '@no_block' and '@blocks', and '@relocates', '@views(self)' and '@consumes' about its receiver's storage. What the rest say is about a free function or about a type: what 'sysl test' calls, what recurses, what a symbol names, how fields are laid out. A member is neither, so it goes above a free function instead ('06')"

// A layout annotation above a field (or any member) is about the wrong thing rather than about a
// function: `@packed` and `@align(n)` lay out a whole struct, and `@align(n)` marks one binding's
// storage. A field begins on its own type's boundary, so one that needs a wider boundary takes a type
// declared with it -- the boundary travels with every value of that type, fields included.
private layout_attr_on_member(word: string) -> string
    if word == "byte_order"
        return "'@byte_order(...)' is the order every integer field of a struct keeps its bytes in, so it stands above the struct — a format whose fields disagree is two structs, one of them held as a field of the other"

    if word == "packed"
        return "'@packed' says how a struct's fields are laid out, so it stands above the struct — a field or another member has no fields of its own to pack"

    "'@align(n)' is the boundary a whole struct begins on, or one 'var' or 'val''s storage, so it stands above the struct or the binding — a field begins on its own type's boundary, so a field that needs a wider one takes a type declared '@align(n)', which carries the boundary to every value of it, a field included"
end layout_attr_on_member

private member_attr_word(w: string) -> bool
    if fn_forgo_word(w) then return true

    for word in ["crossing", "reads", "writes", "noinline", "inline", "cold", "blocks",
                 "relocates", "views", "consumes", "disjoint", "scoped", "joined", "strict_fp"]
        if word == w then return true

    false
end member_attr_word

// An annotation written twice above one declaration says nothing the once does not.
private refuse_duplicates(p: *Parser, attrs: Buf[Attr], what: string)
    for i in 0..<attrs.len()
        // Which struct a program's annotation names is the analysis's to say, and so is a repeat.
        if is_user(attrs.at(i)) then continue

        for j in 0..<i
            if attr_word(attrs.at(i)) == attr_word(attrs.at(j))
                p.fault(p.here(), s"'@${attr_word(attrs.at(i))}' is written twice above one ${what}, and it says nothing the once does not")
                return
end refuse_duplicates

// `@blocks` says the definition may wait and `@no_block` that it never does, so the two above one
// definition are a contradiction rather than a stricter promise.
private refuse_blocks_beside_no_block(p: *Parser, attrs: Buf[Attr])
    if any_is(attrs, "blocks") && any_is(attrs, "no_block") then
        p.fault(p.here(), "'@blocks' says this definition may wait and '@no_block' that it never does, so the two cannot both be true — a definition that waits is marked '@blocks', and one that promises not to keeps to the promise")

private refuse_hash_attr(p: *Parser, at: Span)
    p.bump()

    val name = parse_bound_name(p)

    p.fault(at, s"an annotation is written '@${name}' — '#' opens a directive, which gates lines before the lexer sees them and sits at the margin")
    skip_line(p)
end refuse_hash_attr

// -- the annotations a program declares -------------------------------------------------------------
//
// **A word the language does not own is an annotation the program declared** (`@annotation struct
// rename`) where what the annotations stand above can carry one: a type declaration, a field or a
// variant. Which struct the word names is the analysis's question (`annotations.sysl`); the parser
// reads the use as the construction it stands for. Above anything else the word is refused as the
// language's own closed list refuses it.

// Whether a word after `@` is one the language owns -- an annotation, a header clause or `@assert`.
// A struct declared `@annotation` may not take one of these names.
builtin_attr_word(w: string) -> bool
    if header_attr_word(w) || fn_forgo_word(w) then return true

    for word in ["assert", "annotation", "ignore", "test", "setup", "teardown", "setup_all", "teardown_all",
                 "tailrec", "pure", "ghost", "packed", "reads", "writes", "align", "byte_order", "export",
                 "section", "crossing", "domain", "keeps", "answers", "disjoint", "guards", "needs",
                 "noinline", "inline", "cold", "thread_local", "abandons", "per_cpu", "main_thread",
                 "pinned", "pins", "relocates", "views", "consumes", "blocks", "scoped", "joined",
                 "strict_fp"]
        if word == w then return true

    false
end builtin_attr_word

// Whether the `@` here opens an annotation the program declared: a word the language does not own.
at_user_annotation(p: *Parser) -> bool
    if !p.at_kw("@") then return false

    val word = attr_name(p)

    word != "" && !builtin_attr_word(word)
end at_user_annotation

// Every annotation from here on read past, in a reading taken back, and whether what follows them
// is what `below` asks for -- the declaration they stand above decides whether a word the language
// does not own is an annotation the program declared.
annotations_then(p: *Parser, below: *Parser -> bool) -> bool
    val tokens_at = p.mark()
    val errors_at = p.errors_at()

    while p.at_kw("@")
        p.bump()
        parse_expr_bp(p, PrefixPower)
        p.skip_newlines()

    val found = below(p)

    p.rewind(tokens_at, errors_at)
    found
end annotations_then

// Whether a type declaration a program's annotation may stand above follows: a struct, a union, an
// enum or a `type`, after its visibility.
private at_annotated_type(p: *Parser) -> bool
    parse_visibility(p)

    p.at_kw("struct") || p.at_kw("enum") || at_union_head(p, 0) || p.at_word("opaque") ||
        p.at_kw("type")
end at_annotated_type

// `@rename("id")` or `@marker` -- one use of an annotation the program declared, about `target`.
parse_user_annotation(p: *Parser, target: string) -> Option[AnnotUse]
    val at = p.here()

    p.bump()

    val written = parse_expr_bp(p, PrefixPower)
    val span = at.to(p.just_taken())

    if annot_name_shaped(written) then
        return Some(AnnotUse(span, target, expr(written.span, Call(written, buf())), false))

    *written.kind match
        Call(callee, _) -> if annot_name_shaped(callee) then return Some(AnnotUse(span, target, written, true))
        _ -> ()

    p.fault(at, "an annotation is written '@name' or '@name(arguments)' — the name of a struct declared '@annotation', and the values of its fields in the parentheses as a construction of it takes them")
    skip_line(p)
    None
end parse_user_annotation

// A name or a dotted path to one: what an annotation's use names its struct with.
private annot_name_shaped(e: Expr) -> bool = *e.kind match
    Ident(_) -> true
    Field(receiver, _, _) -> annot_name_shaped(receiver)
    _ -> false

// The annotations above a field or a variant, every one of them a program's own.
parse_part_annotations(p: *Parser, what: string) -> Buf[AnnotUse]
    var out: Buf[AnnotUse] = buf()

    while p.at_kw("@")
        if !at_user_annotation(p)
            p.fault(p.here(), s"'@${attr_name(p)}' is not about ${what} — what ${what} carries is an annotation the program declares, a struct marked '@annotation'")
            skip_line(p)
            return out
        end if

        parse_user_annotation(p, "") match
            Some(u) -> out.push(u)
            None -> return out

        p.skip_newlines()

    out
end parse_part_annotations

// The annotations read above one field or variant, made about it now that its name is known.
about(annots: Buf[AnnotUse], target: string, into: *Buf[AnnotUse])
    for u in annots
        into.push(AnnotUse(u.span, target, u.call, u.parens))

// One annotation.
parse_attribute(p: *Parser) -> Option[Attr]
    val at = p.here()

    if p.at_kw("#")
        refuse_hash_attr(p, at)
        return None
    end if

    if at_user_annotation(p) && annotations_then(p, at_annotated_type) then
        return parse_user_annotation(p, "").map(u -> User(u))

    p.bump()

    val word = p.peek() match
        Ident(n) -> n
        _ -> ""

    if word == ""
        p.want("an attribute")
        return None
    end if

    p.bump()

    if word == "test" then return Some(Test(parse_test_attr(p, at)))
    if word == "setup" then return Some(hook_attr(p, at, Setup))
    if word == "teardown" then return Some(hook_attr(p, at, Teardown))
    if word == "setup_all" then return Some(hook_attr(p, at, SetupAll))
    if word == "teardown_all" then return Some(hook_attr(p, at, TeardownAll))
    if word == "tailrec" then return Some(TailRec)
    if word == "pure" then return Some(Pure)
    if word == "ghost" then return Some(Ghost)
    if word == "packed" then return Some(Packed)
    if word == "reads" then return Some(Reads(parse_frame_names(p, "reads")))
    if word == "writes" then return Some(Writes(parse_frame_names(p, "writes")))
    if word == "align" then return Some(parse_align_attr(p))
    if word == "byte_order" then return parse_byte_order_attr(p)
    if word == "export" then return Some(parse_export_attr(p, at))
    if word == "section" then return Some(parse_section_attr(p))
    if word == "crossing" then return Some(parse_crossing_attr(p))
    if word == "domain" then return parse_domain_attr(p)
    if word == "keeps" then return Some(Keeps(parse_named_list(p, "keeps")))
    if word == "answers" then return Some(Answers(parse_named_list(p, "answers")))
    if word == "scoped" then return Some(Scoped(parse_named_list(p, "scoped")))
    if word == "joined" then return Some(Joined(parse_named_list(p, "joined")))
    if word == "disjoint" then return Some(Disjoint(parse_named_list(p, "disjoint")))
    if word == "guards" then return Some(Guards(parse_named_list(p, "guards")))
    if word == "needs" then return Some(Needs(parse_named_list(p, "needs")))
    if word == "noinline" then return no_inlining_args(p, NoInline, "whether a call stays a call is the whole of what it says")
    if word == "inline" then return parse_inline_attr(p)
    if word == "cold" then return no_inlining_args(p, Cold, "how rare a rare path is is not a number a program has")

    // `@thread_local` takes no parentheses for `@packed`'s reason: which thread-local model the
    // object gets is the back end's answer for the target, not something a program picks.
    if word == "thread_local" then return Some(ThreadLocal)
    if word == "abandons" then return no_inlining_args(p, Abandons, "a call to the function either comes back or it does not, and this says it does not")

    // `@per_cpu` takes none either: which register finds the core's copy is the manifest's
    // `codegen.per_cpu_offset`, a fact about the image rather than about one binding. `@pinned` and
    // `@pins` are claims about a body with nothing to qualify them.
    if word == "per_cpu" then return Some(PerCpu)

    // `@main_thread` takes none: which thread is the main one is the program's, not the binding's.
    if word == "main_thread" then return Some(MainThread)
    if word == "pinned" then return Some(Pinned)
    if word == "pins" then return Some(Pins)
    if fn_forgo_word(word) then return Some(Forgoes(word[3..<word.len]))

    // `@blocks` takes no parentheses: what it says is that a call may wait, and how long is not a
    // number the declaration has.
    if word == "relocates" then return no_inlining_args(p, Relocates, "a call either may move its receiver's storage or it may not")
    if word == "views" then return Some(parse_views_attr(p))
    if word == "consumes" then return no_inlining_args(p, Consumes, "what a call takes is everything its receiver holds")
    if word == "blocks" then return no_inlining_args(p, Blocks, "how long a call may wait is not a number a declaration has")

    // `@strict_fp` takes none: which rounding mode and which exceptions are the ones in force when
    // the code runs, and naming one here would be the static environment this exists to give up.
    if word == "strict_fp" then return no_inlining_args(p, StrictFp, "the rounding mode and the exceptions are whatever the floating-point environment holds when the body runs, which is what the annotation says to follow")
    if word == "annotation" then return no_inlining_args(p, AnnotationMark, "what a use of the annotation says is written where it is used, as the values of the struct's fields")

    // `@ignore` is the spelling other test frameworks use, answered with this one's: ignoring is
    // something a test is, so it is an argument to `@test` rather than an annotation of its own.
    if word == "ignore"
        p.fault(p.here(), "an ignored test is written '@test(ignore: \"why it is not run\")' — ignoring is something a test is, so it goes inside '@test' beside the description and 'should_trap', and a function that is not a test has no run to withhold")
        skip_line(p)
        return None
    end if

    // Anchored after the word, as `@ignore`'s is: the reference's point for both.
    p.fault(p.here(), s"'${word}' is not an annotation a declaration takes — '@test', '@setup', '@teardown', '@setup_all', '@teardown_all', '@tailrec', '@pure', '@ghost', '@export', '@noinline', '@inline', '@cold', '@reads(...)', '@writes(...)', '@crossing(...)' and '@domain(...)' mark a function, '@packed', '@align(n)' and '@byte_order(...)' mark a struct's layout, '@export(\"...\")' names a struct in a generated C header, '@section(\"...\")' marks either a binding or a function, '@needs(...)' and '@abandons' mark a function or an 'extern', and '@keeps(...)' an 'extern'. '@no_<capability>', '@requires(...)', '@link(\"...\")' and '@tests' belong in the file's header. An annotation a program declares, a struct marked '@annotation', stands above a type declaration, a field or a variant")
    skip_line(p)
    None
end parse_attribute

// `@noinline`, `@inline` or `@cold`, none of which takes an argument (`reference/attributes.md §
// @noinline, @inline and @cold`). A `(` after one is a sentence rather than a parse failure for the
// reason a hook's is: the word has been read, so there is nothing else the line could have been.
private no_inlining_args(p: *Parser, a: Attr, because: string) -> Option[Attr]
    if p.at_kw("(")
        p.fault(p.here(), s"'@${attr_word(a)}' takes no arguments — ${because}")
        skip_line(p)
    end if

    Some(a)
end no_inlining_args

// `@inline` or `@inline(always)` (`reference/attributes.md § @noinline, @inline and @cold`). Bare,
// it raises what the inliner will spend on the definition; `always` makes it an instruction. There
// is no other argument: a budget is not a number a program has, and the opposite request is a word
// of its own, `@noinline`, which `never` is pointed at.
private parse_inline_attr(p: *Parser) -> Option[Attr]
    if !p.accept_kw("(") then return Some(Inline(false))

    val at = p.here()
    val word = p.peek() match
        Ident(n) -> n
        _ -> ""

    if word == "always"
        p.bump()

        if p.accept_kw(")") then return Some(Inline(true))
    end if

    if word == "never"
        p.fault(at, "'@inline(never)' is written '@noinline' — keeping every call a call is a request of its own, not a degree of '@inline'")
    else
        p.fault(at, "'@inline' takes no argument but 'always' — '@inline' alone raises what the inliner will spend on this definition rather than naming a number, '@inline(always)' puts the body in place of every call at every optimization level, and '@noinline' keeps every call a call")

    skip_line(p)
    None
end parse_inline_attr

private hook_attr(p: *Parser, at: Span, kind: HookKind) -> Attr
    if p.at_kw("(")
        p.fault(p.here(), "a hook takes no arguments — when it runs is what the word says, and what it does is its body. There is nothing left for a parenthesis to carry")
        skip_line(p)
    end if

    Hook(HookAttr(at.to(p.just_taken()), kind))
end hook_attr

// `@reads(count)`, `@writes()` -- the module variables a frame covers. **The parentheses are what
// tell a frame that covers nothing from a function that never said**, so there is no bare form.
private parse_frame_names(p: *Parser, word: string) -> Buf[string]
    var out: Buf[string] = buf()

    if !p.accept_kw("(")
        p.fault(p.here(), s"'@${word}' names the module variables it covers, in parentheses — '@${word}(count)', or '@${word}()' for none. The parentheses are what tell a frame that covers nothing from a function that never said")
        return out
    end if

    if p.accept_kw(")") then return out

    loop
        p.name() match
            Some(n) -> out.push(n)
            None -> break

        if !p.accept_kw(",") then break

    p.expect_kw(")")
    out
end parse_frame_names

// `@crossing(state)`, `@keeps(context)`, `@needs(heap)` -- each names at least one thing, and there
// is no empty form: a declaration that names none says so by not writing the annotation.
private parse_named_list(p: *Parser, word: string) -> Buf[string]
    var out: Buf[string] = buf()

    if !p.accept_kw("(") || p.at_kw(")")
        p.fault(p.here(), named_list_refusal(word))
        skip_line(p)
        return out
    end if

    // **What stands in the parentheses is a name, never an expression** -- `@crossing(1)` is told
    // what the annotation names rather than that an identifier was expected, as the empty form is.
    loop
        // The receiver is not a parameter these name: it is the one name a list could hold that is
        // not a name, and it gets its own answer rather than the empty form's.
        if p.at_kw("self")
            p.fault(p.here(), receiver_refusal(word))
            skip_line(p)
            return out
        end if

        p.peek() match
            // `@disjoint` may also name a part of the function's result, by position as a tuple's
            // part is selected and by the name an `ensure` gives the result: `result.0`.
            Ident(n) if word == "disjoint" && n == "result" && p.kw_at(1, ".") ->
                p.bump()
                p.bump()

                p.peek() match
                    IntLit(digits, 10, "") ->
                        p.bump()
                        out.push(s"result.$digits")
                    _ ->
                        p.fault(p.here(), "'@disjoint' names a part of the result by its position, " +
                                "as a tuple's part is selected — 'result.0', 'result.1'")
                        skip_line(p)
                        return out
            Ident(n) ->
                p.bump()
                out.push(n)
            QuotedIdent(n) ->
                p.bump()
                out.push(n)
            _ ->
                p.fault(p.here(), named_list_refusal(word))
                skip_line(p)
                return out

        if !p.accept_kw(",") then break

    p.expect_kw(")")
    out
end parse_named_list

// `@crossing(state)`: every name is a parameter that reaches another domain.
private parse_crossing_attr(p: *Parser) -> Attr = Crossing(parse_named_list(p, "crossing"))

// `@views(self)`: what a member's returned view is borrowed from. **Only the receiver may be named**
// -- a view borrowed from another parameter would need the caller to know which argument it was,
// which is a lifetime in the signature, and the language has none.
private parse_views_attr(p: *Parser) -> Attr
    if p.accept_kw("(") && p.accept_kw("self") && p.accept_kw(")") then return Views(one_name("self"))

    p.fault(p.here(), "'@views' says what a member's returned view is borrowed from, and that can " +
            "only be the member's own receiver — '@views(self)'. A view of anything else is the " +
            "caller's to keep alive")
    skip_line(p)
    Views(one_name("self"))
end parse_views_attr

private one_name(n: string) -> Buf[string]
    var out: Buf[string] = buf()

    out.push(n)
    out
end one_name

// The domains a function may say it is entered in. One today; the annotation is a name rather than a
// bare word so that a second (a signal handler, a second core's own loop) is a row here and not a
// new spelling.
private const InterruptDomain: string = "interrupt"

private known_domains() -> Buf[string]
    var out: Buf[string] = buf()

    out.push(InterruptDomain)
    out
end known_domains

// `@domain(interrupt)` -- the concurrency domain a function is entered in. **It names exactly one**:
// a function entered in two domains at once is entered in whichever is the stricter, and there is
// only one to name. What is refused is told what the domains are, as an unknown annotation is told
// what the annotations are.
private parse_domain_attr(p: *Parser) -> Option[Attr]
    if !p.accept_kw("(") || p.at_kw(")")
        p.fault(p.here(), named_list_refusal("domain"))
        skip_line(p)
        return None
    end if

    val at = p.here()
    val name = p.peek() match
        Ident(n) -> n
        QuotedIdent(n) -> n
        _ -> ""

    if name == ""
        p.fault(at, named_list_refusal("domain"))
        skip_line(p)
        return None
    end if

    p.bump()

    if p.at_kw(",")
        p.fault(p.here(), "'@domain' names the one domain a function is entered in — a function " +
                "the processor may enter in either of two is entered in the stricter, so name that one")
        skip_line(p)
        return None
    end if

    p.expect_kw(")")

    val known = known_domains()

    if !holds_string(known, name)
        val which = if known.len() == 1 then s"${quoted_list(known)} is the one there is"
        else s"a function may name ${quoted_list(known)}"

        p.fault(at, s"'$name' is not a domain a function is entered in — $which, for a function a " +
                "vector table or a trap stub calls on top of whatever was running. A function the program " +
                "calls itself is in the program's own domain, and says so by not writing the annotation")
        return None
    end if

    Some(Domain(name))
end parse_domain_attr

// `'a'`, `'a' and 'b'`, `'a', 'b' and 'c'`.
private quoted_list(names: Buf[string]) -> string
    var out = ""

    for i in 0..<names.len()
        if i > 0 then out = out + (if i == names.len() - 1 then " and " else ", ")

        out = out + s"'${names.at(i)}'"

    out
end quoted_list

// `self` written in one of those lists. For `@disjoint` the answer is that naming the other
// parameters already covers the receiver: what a named parameter reaches, nothing else the call can
// reach does, `self` included.
private receiver_refusal(word: string) -> string
    if word == "disjoint"
        return "'@disjoint' names parameters, and 'self' is the receiver — leave it out: a parameter " +
               "'@disjoint' names is kept apart from every other pointer the body reaches, 'self' " +
               "included, so '@disjoint(data)' already says it"
    end if

    s"'@$word' names parameters, and 'self' is the receiver, which it does not name"
end receiver_refusal

private named_list_refusal(word: string) -> string
    if word == "crossing" then return "'@crossing' names the parameters a value reaches another concurrency domain through, in parentheses — '@crossing(state)'. There is no empty form: a function that hands nothing across a boundary says so by not writing the annotation"

    if word == "domain" then return "'@domain' names the domain a function is entered in, in parentheses — '@domain(interrupt)' for a handler a vector table calls, on top of whatever was running. There is no empty form: a function in the program's own domain says so by not writing the annotation"

    if word == "keeps" then return "'@keeps' names the parameters a C function holds on to past the call, in parentheses — '@keeps(context)'. There is no empty form: an 'extern' that keeps nothing it is handed says so by not writing the annotation"

    if word == "answers" then return "'@answers' names the parameters the pointer a C function answers may point into, in parentheses — '@answers(s)' for 'strchr'. There is no empty form: an 'extern' whose answer is fresh storage says so by not writing the annotation"

    if word == "scoped" then return "'@scoped' names the parameters a function lets go of before its caller's scope ends — a callable a member runs in another concurrency domain, or a '*T' it holds while its caller waits — in parentheses: '@scoped(f)'. There is no empty form: a function that holds nothing past its call says so by not writing the annotation"

    if word == "joined" then return "'@joined' names the '*T' parameters a call hands to the thread it starts, which holds each until the handle the call answers is joined, in parentheses — '@joined(arg)'. There is no empty form: a function whose thread holds nothing it was handed says so by not writing the annotation"

    if word == "guards" then return "'@guards' names the fields a struct's own members are the only way into, in parentheses — '@guards(value)'. There is no empty form: a struct that guards nothing says so by not writing the annotation"

    if word == "disjoint" then return "'@disjoint' names the pointer and slice parameters whose memory nothing else reaches while a call runs, in parentheses — '@disjoint(y, x)'. There is no empty form: a function whose parameters may overlap says so by not writing the annotation"

    "'@needs' names the capabilities reaching this declaration requires, in parentheses — '@needs(heap)', '@needs(os, posix)'. There is no empty form: a declaration that needs nothing beyond what its module has says so by not writing the annotation"
end named_list_refusal

private parse_align_attr(p: *Parser) -> Attr
    if !p.accept_kw("(")
        p.fault(p.here(), "'@align' names the boundary in parentheses — '@align(64)', or '@align(CACHE_LINE)' for a constant that says what the number is for. There is no bare form: an alignment with no number is not a weaker claim, it is no claim")
        return Align(expr(p.here(), Bad))
    end if

    val bound = parse_expr(p)

    p.expect_kw(")")
    Align(bound)
end parse_align_attr

// `@byte_order(big)` or `@byte_order(little)` -- the order a struct's integer fields keep their bytes
// in. The word is read as a word rather than as an expression: it names one of two orders, and
// neither is a value a program has.
private parse_byte_order_attr(p: *Parser) -> Option[Attr]
    val bad = "'@byte_order' names the order in parentheses — '@byte_order(big)' for a network header, which keeps the most significant byte first, or '@byte_order(little)' for a format that keeps the least significant first"

    if !p.accept_kw("(")
        p.fault(p.here(), bad)
        skip_line(p)
        return None
    end if

    val word = p.peek() match
        Ident(n) -> n
        _ -> ""

    if word != "big" && word != "little"
        p.fault(p.here(), bad)
        skip_line(p)
        return None
    end if

    p.bump()
    p.expect_kw(")")
    Some(ByteOrder(word == "big"))
end parse_byte_order_attr

// `@export`, `@export("mylib_parse")` -- the symbol a function is visible under from C, or the name
// a struct's `typedef` carries in a generated header. `weak` after the symbol, or alone
// (`@export("write", weak)`, `@export(weak)`), publishes the function as a default any strong
// definition of the symbol in the link replaces.
private parse_export_attr(p: *Parser, at: Span) -> Attr
    if !p.accept_kw("(") then return Export(ExportAttr(at.to(p.just_taken()), None, false))

    var symbol: Option[string] = None
    var weakly = p.accept_kw("weak")

    if !weakly
        p.peek() match
            StrLit(v) ->
                p.bump()
                symbol = Some(v)
            _ ->
                p.fault(p.here(), "'@export' names the C symbol as a string — '@export(\"mylib_parse\")' — or takes no parentheses at all, which exports the function under its own name")
                skip_line(p)
                return Export(ExportAttr(at.to(p.just_taken()), None, false))

        if p.accept_kw(",")
            if !p.accept_kw("weak")
                p.fault(p.here(), "'weak' expected — the one word '@export' takes after its symbol is 'weak', '@export(\"write\", weak)', which publishes a default a strong definition of the symbol replaces")
                skip_line(p)
                return Export(ExportAttr(at.to(p.just_taken()), symbol, false))
            end if

            weakly = true
        end if
    end if

    p.expect_kw(")")
    Export(ExportAttr(at.to(p.just_taken()), symbol, weakly))
end parse_export_attr

// `weak` is about a function's definition, the one thing a strong definition elsewhere can replace;
// above anything else it is refused with the reason that declaration has none.
private refuse_weak_export(p: *Parser, attrs: Buf[Attr], why: string)
    for attr in attrs
        attr match
            Export(e) -> if e.weakly then p.fault(e.span, s"only a function's '@export' may be 'weak' — $why")
            _ -> ()

private parse_section_attr(p: *Parser) -> Attr
    val bad = "'@section' names the linker section as a string — '@section(\".vectors\")' on the storage or the definition that goes there. The spelling is the target's: '.noinit' and '.ramfunc' are ELF's, '__DATA,__mysection' is Mach-O's"

    if !p.accept_kw("(")
        p.fault(p.here(), bad)
        return Section("")
    end if

    val at = p.here()

    p.peek() match
        StrLit(v) ->
            p.bump()

            if v == ""
                p.fault(at, "'@section' names a section, and \"\" is not the name of one — a section's spelling is the target's, so there is nothing an empty one could resolve to")

            p.expect_kw(")")
            Section(v)
        _ ->
            p.fault(at, bad)
            skip_line(p)
            Section("")
end parse_section_attr

// `@test`, `@test("what it shows")`, `@test("...", should_trap)`, `@test(should_trap: "text")`,
// `@test(timeout: 30)`, `@test(ignore: "why")` — a description, then `should_trap`, then `timeout`,
// then `ignore`, each optional and in that order.
private parse_test_attr(p: *Parser, at: Span) -> TestAttr
    if !p.at_kw("(") then return TestAttr(at.to(p.just_taken()), None, false, None, None, None)

    if p.kw_at(1, ")")
        p.fault(p.here(), "'@test' takes a description or nothing at all, and '()' is neither — drop the parentheses, and the function's own name becomes its description")
        p.bump()
        p.bump()
        return TestAttr(at.to(p.just_taken()), None, false, None, None, None)
    end if

    p.bump()

    var display: Option[string] = None
    var should_trap = false
    var expected: Option[string] = None
    var ignored: Option[string] = None
    var timeout: Option[int] = None

    p.peek() match
        StrLit(v) ->
            p.bump()
            display = Some(v)
        _ -> ()

    if display.is_none() && !p.at_word("should_trap") && !p.at_word("timeout") && !p.at_word("ignore")
        p.fault(p.here(), "'@test' takes the description a report shows it under, written as a string — '@test(\"an index past the end is refused\")' — 'should_trap' for a run that is meant not to come back, optionally with the text such a run must have printed, 'timeout: 30' for the seconds a run may take, and 'ignore: \"why\"' for a test that is compiled and not run. They compose, in that order")
        skip_line(p)
        return TestAttr(at.to(p.just_taken()), None, false, None, None, None)
    end if

    if display.is_some() && p.kw_at(0, ",") && test_word_at(p, 1) then p.bump()

    if p.accept_word("should_trap")
        should_trap = true

        if p.accept_kw(":") then expected = accept_string(p)

        if p.kw_at(0, ",") && (p.word_at(1, "timeout") || p.word_at(1, "ignore")) then p.bump()
    end if

    if p.accept_word("timeout")
        timeout = parse_test_timeout(p)

        if timeout.is_none()
            skip_line(p)
            return TestAttr(at.to(p.just_taken()), display, should_trap, expected, None, None)
        end if

        if p.kw_at(0, ",") && p.word_at(1, "ignore") then p.bump()
    end if

    if p.accept_word("ignore")
        ignored = parse_ignore_reason(p)

        if ignored.is_none()
            skip_line(p)
            return TestAttr(at.to(p.just_taken()), display, should_trap, expected, None, timeout)
        end if
    end if

    if !p.accept_kw(")")
        p.fault(p.here(), "'@test' closes what it opened — the description, 'should_trap', 'timeout' and 'ignore' go between parentheses, in that order, and there is no ')' here to end them")

    TestAttr(at.to(p.just_taken()), display, should_trap, expected, ignored, timeout)
end parse_test_attr

// Whether the token `n` ahead is one of the words `@test` takes after its description.
private test_word_at(p: *Parser, n: usize) -> bool =
    p.word_at(n, "should_trap") || p.word_at(n, "timeout") || p.word_at(n, "ignore")

// What follows `timeout` inside `@test(...)`: a `:` and a whole number of seconds, zero meaning no
// limit. The bound is the most a run's clock is asked to count in milliseconds, which is about
// twenty-four days — a limit past it is not a limit anybody meant.
private parse_test_timeout(p: *Parser) -> Option[int]
    val refusal = s"'timeout' needs the seconds the test may run, written as a whole number from 0 " +
        s"to ${MostTestSeconds} — '@test(timeout: 30)'; 0 is no limit at all"

    if !p.accept_kw(":")
        p.fault(p.here(), refusal)
        return None
    end if

    val at = p.here()

    p.peek() match
        IntLit(digits, base, suffix) ->
            p.bump()

            val seconds = literal_value(digits, base).to_long()

            if suffix != "" || seconds.is_none() || seconds.unwrap() > long(MostTestSeconds)
                p.fault(at, refusal)
                return None
            end if

            Some(int(seconds.unwrap()))
        _ ->
            p.fault(at, refusal)
            None
end parse_test_timeout

// The longest limit a test may be given, in seconds: the most milliseconds an `int` holds, rounded
// down to a whole second.
const MostTestSeconds: int = 2147483

// What follows `ignore` inside `@test(...)`: a `:` and the reason, which is not optional and may not
// be blank — an ignored test that does not say what it is waiting for is the one nobody comes back
// to. Having read the word there is nothing else the reader could have been writing, so every road
// that does not end in a reason ends in the one refusal, at the token where the reason went wrong.
private parse_ignore_reason(p: *Parser) -> Option[string]
    val refusal = "'ignore' needs the reason the test is not run, written as a string — '@test(ignore: \"the parser drops the second arm\")'. An ignored test that does not say why is one nobody comes back to"

    if !p.accept_kw(":")
        p.fault(p.here(), refusal)
        return None
    end if

    p.peek() match
        StrLit(v) ->
            p.bump()

            if v.trim().bytes.len == 0
                p.fault(p.here(), refusal)
                return None
            end if

            Some(v)
        _ ->
            p.fault(p.here(), refusal)
            None
end parse_ignore_reason

// -- folding an annotation onto what it marks -----------------------------------------------------

apply_func_attrs(f: *FuncDecl, attrs: Buf[Attr])
    for attr in attrs
        attr match
            Test(t) -> f.test = Some(t)
            Hook(h) -> f.hook = Some(h)
            TailRec -> f.tailrec = true
            Pure -> f.pure = true
            Ghost -> f.ghost = true
            Reads(ns) -> f.reads = Some(ns)
            Writes(ns) -> f.writes = Some(ns)
            Export(e) ->
                f.exported = Some(e)
                f.marks.weak_export = e.weakly
            Section(s) -> f.section = Some(s)
            Crossing(ns) ->
                f.crossing = ns
                f.marks.copies = ns
            Domain(d) -> f.marks.domain = Some(d)
            Needs(cs) -> f.needs = cs
            Disjoint(ns) -> f.marks.disjoint = ns
            NoInline -> f.marks.noinline = true
            Inline(always) ->
                f.marks.inline = true
                f.marks.inline_always = always
            Cold -> f.marks.cold = true
            Abandons -> f.marks.abandons = true
            Pinned -> f.marks.pinned = true
            Pins -> f.marks.pins = true
            Forgoes(cap) -> f.marks.forgoes.push(cap)
            Blocks -> f.marks.blocks = true
            StrictFp -> f.marks.strict_fp = true
            Scoped(ns) -> f.marks.scoped = ns
            Joined(ns) -> f.marks.joined = ns
            _ -> ()
end apply_func_attrs

apply_member_attrs(m: *MethodDecl, attrs: Buf[Attr])
    for attr in attrs
        attr match
            Crossing(ns) ->
                m.crossing = ns
                m.marks.copies = ns
            Scoped(ns) -> m.marks.scoped = ns
            Joined(ns) -> m.marks.joined = ns
            Disjoint(ns) -> m.marks.disjoint = ns
            Reads(ns) -> m.reads = Some(ns)
            Writes(ns) -> m.writes = Some(ns)
            NoInline -> m.marks.noinline = true
            Inline(always) ->
                m.marks.inline = true
                m.marks.inline_always = always
            Cold -> m.marks.cold = true
            Pinned -> m.marks.pinned = true
            Pins -> m.marks.pins = true
            Forgoes(cap) -> m.marks.forgoes.push(cap)
            Blocks -> m.marks.blocks = true
            StrictFp -> m.marks.strict_fp = true
            Relocates -> m.marks.relocates = true
            Views(_) -> m.marks.views = true
            Consumes -> m.marks.consumes = true
            _ -> ()

    // **`@scoped(f)` implies `@crossing(f)`**: what a scoped member runs runs in another domain, so
    // the crossing rule asks of it what it asks of any parameter marked crossing. A name both list
    // is crossing once. A `*T` it names is held while its caller waits, in no other domain.
    if !m.marks.scoped.is_empty()
        var crossing: Buf[string] = buf()

        for name in m.crossing
            crossing.push(name)

        for name in m.marks.scoped
            if !holds_string(crossing, name) && !names_pointer_param(m.params, name) then crossing.push(name)

        m.crossing = crossing
    end if
end apply_member_attrs

// Whether the parameter of this name is written as a raw pointer, `*T`.
names_pointer_param(ps: Buf[Param], name: string) -> bool
    for item in ps
        if item.name == name
            return *item.typ.kind match
                PtrType(_) -> true
                _ -> false

    false
end names_pointer_param

// -- routing a declaration to the thing its annotations describe -----------------------------------

// A declaration with a line or more of annotation in front of it.
//
// **Reading an annotation commits the line to being an attributed declaration**, so a declaration
// that cannot carry one is answered with a sentence about what the annotation marks rather than
// with the grammar's complaint about the form it went on to try.
private parse_attributed_decl(p: *Parser, start: Span) -> Stmt
    val attrs = parse_attr_list(p)

    refuse_impossible_pairs(p, attrs)

    val vis = parse_visibility(p)
    val at = p.here()

    // A function named with a reserved word is still a function, and is told about the word rather
    // than about the declaration the word would otherwise have opened -- `@inline` above `val(x: int)`.
    if at_reserved_func_head(p)
        refuse_unless(p, at, attrs, "function")
        return try_func_decl(p, at, vis, attrs).unwrap()
    end if

    val storage = p.at_kw("val") || p.at_kw("var") || p.at_kw("static")

    // `@thread_local` is settled before anything asks which kind of declaration is coming: it marks
    // storage, so a declaration that lays none down has nothing for it to be about.
    if per_thread(attrs) && !storage
        p.fault(start, "'@thread_local' gives one 'var' a copy per thread, and this declares no storage at all — a 'const' is folded into every use, an 'extern' names storage this program does not lay down, and a function is code every thread runs the one copy of")
        skip_line(p)
        return stmt(start.to(p.just_taken()), Bad)
    end if

    if per_core(attrs) && !storage
        p.fault(start, "'@per_cpu' gives one 'var' a copy per processor core, and this declares no storage at all — a 'const' is folded into every use, an 'extern' names storage this program does not lay down, and a function is code every core runs the one copy of")
        skip_line(p)
        return stmt(start.to(p.just_taken()), Bad)
    end if

    if main_only(attrs) && !storage
        p.fault(start, "'@main_thread' promises that only the program's main thread reaches one 'var' or 'val', and this declares no storage at all — a 'const' is folded into every use and holds nothing to race on, an 'extern' names storage this program does not lay down, and a function is code any thread may run")
        skip_line(p)
        return stmt(start.to(p.just_taken()), Bad)
    end if

    val a_union = at_union_head(p, 0) || at_opaque_union(p)

    if p.at_kw("struct") || (p.at_word("opaque") && p.kw_at(1, "struct")) || a_union
        // **`@packed`, `@align(n)` and `@export("...")` are the three that mark a struct**, and
        // anything else above one is about a function that is not here. A union takes the same.
        refuse_unless(p, at, attrs, "struct")
        refuse_weak_export(p, attrs, "a struct's '@export' names a type in a generated header, which is no definition the link could replace")

        val hidden = p.at_word("opaque")

        if hidden then return from_first(start, laid_out(p, at, parse_opaque_struct(p, at, vis), attrs))

        return from_first(start, laid_out(p, at, parse_struct_decl(p, at, vis, false, a_union), attrs))
    end if

    // An enum takes the annotations a program declares and nothing else: its layout is the
    // compiler's, and it names no symbol.
    if p.at_kw("enum") && any_user(attrs)
        refuse_unless(p, at, attrs, "enum")
        return from_first(start, annotated_enum(parse_enum_decl(p, at, vis), attrs))
    end if

    // A layout beside `@export` marks a struct and only a struct: a `type` takes `@export` alone,
    // and a function lays nothing out. A binding takes `@align(n)` beside it, and the rest of the
    // pair is refused below with the binding's own rule.
    if has_export(attrs) && has_layout(attrs) && all_layout_or_export(attrs) && !storage
        p.fault(start, "'@packed' and '@align(n)' lay out a struct and '@export(\"...\")' names one in a generated header, so together they mark a struct — and this declares none")
        skip_line(p)
        return stmt(start.to(p.just_taken()), Bad)
    end if

    // `@align(n)` is the boundary one object's storage begins on and `@section("...")` places it,
    // and between them they are what a binding may carry.
    if storage
        refuse_unless(p, at, attrs, "binding")
        refuse_weak_export(p, attrs, "exported storage is one object every reader and writer names, and 'weak' is a default only a function may be")
        return from_first(start, placed(p, parse_stmt_at(p, false), attrs, vis))
    end if

    // `@section("...")` and `@align(n)` above an `asm` block place instructions written at the top of
    // a file: the section the assembler lays them down in and the boundary they begin on. Inside a
    // function the same block is that function's code, which the analysis refuses to place.
    if at_asm(p)
        for attr in attrs
            val word = attr_word(attr)

            if word != "section" && word != "align"
                p.fault(at, "an 'asm' block takes '@section(\"...\")' and '@align(n)' and nothing else — they say where its instructions are laid down and the boundary they begin on, and every other annotation is about a function or a struct, which an 'asm' block is not")
                break
            end if

        return placed_asm(parse_asm(p, at), attrs)
    end if

    // `@needs(...)`, `@blocks` and `@abandons` are the annotations an `extern` takes -- it is the
    // declaration each exists for as much as a function is, a symbol C defines being able to reach a
    // capability, to wait, or to leave its caller for good as readily as a body can. `@keeps(...)`
    // is an `extern`'s alone: a body the compiler can read says what it keeps.
    refuse_async_extern(p)

    if p.at_kw("extern")
        refuse_unless(p, at, attrs, "extern")
        return from_first(start, parse_extern_decl(p, at, vis, capabilities_of(attrs),
                                                   any_is(attrs, "blocks"),
                                                   any_is(attrs, "abandons"), kept_names(attrs),
                                                   answered_names(attrs)))
    end if

    // A `type` names a scalar or a pointer for a generated header, which is the struct's request made
    // of a declaration with no fields -- so it takes `@export` and nothing that lays out. A type of its
    // own takes the annotations a program declares too.
    if p.at_kw("type") && (all_are(attrs, "export") || any_user(attrs))
        refuse_unless(p, at, attrs, "type")
        refuse_weak_export(p, attrs, "a type's '@export' names it in a generated header, which is no definition the link could replace")
        return from_first(start, exported_type(p, parse_type_decl(p, at, vis), attrs))

    // At the end of the file there is no declaration below for the annotations to be about, so
    // nothing an annotation's own sentence says is true of it: the grammar refuses it, at the word
    // after the `@`, as the reference does.
    if p.at(Eof) && forgo_of(attrs).is_some()
        p.fault(start, forgo_refusal(forgo_of(attrs).unwrap()))
        return stmt(start.to(p.just_taken()), Bad)
    end if

    if p.at(Eof)
        p.fault(Span(start.start + 1, start.start + 1), "an attribute expected")
        return stmt(start.to(p.just_taken()), Bad)
    end if

    refuse_unless(p, at, attrs, "function")

    // The declaration's extent begins at its first annotation, as the reference's does, so a refusal
    // about the function as a whole (`@tailrec` that does not hold) points at what was written above
    // it. `at` stays the function's own line, which is where a contract clause is anchored.
    // **A name and a bracket under an annotation can only be a function**, so where the probe turned
    // it down the declaration is read anyway, and what is wrong inside it (`@test` over `bad( = )`
    // is `')' expected` at the `=`) is told rather than that the annotation marks the wrong kind.
    val named_head = p.peek() match
        Ident(_) -> p.kw_at(1, "(") || p.kw_at(1, "[")
        _ -> false

    try_func_decl(p, at, vis, attrs, named_head) match
        Some(d) -> return Stmt(start.to(d.span), d.kind)
        None -> ()

    // The refusal sits at the declaration the annotations stand above, as `refuse_unless`'s do. **An
    // empty list is one whose first annotation was already refused** (`@` with no word, `@scoped`
    // above a free function, a word that is no annotation), and that refusal is the whole story: the cursor may have left
    // the line by now, so a second sentence would land on the next one, about a declaration nobody
    // wrote there.
    if attrs.len() > 0 then p.fault(at, attributed_refusal(attrs))

    skip_line(p)
    stmt(start.to(p.just_taken()), Bad)
end parse_attributed_decl

// **A declaration's extent begins at its first annotation**, whatever kind of declaration the
// annotations turned out to be about -- a struct, an `extern`, a `type` or a binding as much as a
// function -- as the reference's does.
private from_first(start: Span, s: Stmt) -> Stmt = Stmt(start.to(s.span), s.kind)

// That every annotation above this declaration is one the declaration may carry.
private refuse_unless(p: *Parser, at: Span, attrs: Buf[Attr], form: string)
    for i in 0..<attrs.len()
        if !may_carry(form, attrs.at(i))
            p.fault(at, attributed_refusal(attrs))
            return

private may_carry(form: string, a: Attr) -> bool
    if form == "struct"
        return is_layout(a) || attr_word(a) == "export" || attr_word(a) == "guards" ||
            attr_word(a) == "pinned" || is_user(a) || is_annotation_mark(a)
    end if

    if form == "enum" then return is_user(a)
    if form == "type" then return is_user(a) || attr_word(a) == "export"

    if form == "binding" then return is_storage(a) || attr_word(a) == "export"
    if form == "extern" then return attr_word(a) == "needs" || attr_word(a) == "blocks" ||
        attr_word(a) == "abandons" || attr_word(a) == "keeps" || attr_word(a) == "answers"

    !is_layout(a) && attr_word(a) != "keeps" && attr_word(a) != "answers" && attr_word(a) != "guards" &&
        attr_word(a) != "relocates" && attr_word(a) != "views" && attr_word(a) != "consumes" &&
        !is_user(a) && !is_annotation_mark(a)
end may_carry

private is_user(a: Attr) -> bool = a match
    User(_) -> true
    _ -> false

private is_annotation_mark(a: Attr) -> bool = a match
    AnnotationMark -> true
    _ -> false

// The sentence a declaration that carries none of these gets, chosen by what was written above it.
private attributed_refusal(attrs: Buf[Attr]) -> string
    if forgo_of(attrs).is_some() then return forgo_refusal(forgo_of(attrs).unwrap())

    if any_is(attrs, "annotation")
        return "'@annotation' makes a struct an annotation, whose fields are what a use of it writes in its parentheses — so it marks a struct, and this declares none"

    if all_are(attrs, "blocks")
        return "'@blocks' says a call may wait, so it marks a function, a method or an 'extern' — and this declares none of them"

    if all_are(attrs, "byte_order")
        return "'@byte_order(...)' is the order a struct's integer fields keep their bytes in, so it can only mark a struct — and this declares none. A lone value is put in an order with 'to_be' and 'from_be', the members 'sysl.math.ByteOrder' gives every whole-byte integer"

    // An `extern` is where this is most often tried, and it has no body here to put in place of a
    // call: the definition is the linked object's, and only its own compiler can inline it.
    if any_is(attrs, "strict_fp")
        return "'@strict_fp' says how a body's floating-point operations are compiled, so it marks a function or a method, whose body is sysl — and this declares neither. An 'extern''s operations are compiled by whoever compiled it"

    if any_is(attrs, "inline(always)")
        return "'@inline(always)' puts a function's body in place of every call to it, so it marks a function or a method — and this declares neither. An 'extern' has no body in this program to put anywhere: its definition is in the object it is linked from"

    // An `extern`'s body is C, compiled where the sysl declaration is never read, so the promise
    // could not reach the code it is about; the C declaration's `restrict` is where it is made.
    if any_is(attrs, "disjoint")
        return "'@disjoint(...)' promises that a body reaches no memory through one named parameter that it also reaches another way, so it marks a function or a method, whose body is sysl — an 'extern''s body is C, which never reads the sysl declaration, so the promise belongs on the C declaration as 'restrict'"

    if any_is(attrs, "keeps") then return keeps_off_extern()
    if any_is(attrs, "answers") then return answers_off_extern()

    // An `extern`'s body is C: nothing it promises reaches a body the compiler reads, and what it
    // holds past the call is what `@keeps(...)` says.
    if any_is(attrs, "scoped")
        return "'@scoped' promises that a body lets go of a parameter before its caller's scope ends, so it marks a function or a method, whose body is sysl — an 'extern' borrows what it is handed for the call, and one that holds a pointer past it says '@keeps(...)'"

    if any_is(attrs, "joined")
        return "'@joined' says how long the thread a sysl function starts holds a pointer, so it marks a function or a method, whose body is sysl — an 'extern' that holds a pointer past the call says '@keeps(...)', and a sysl wrapper around it says '@joined'"

    if any_is(attrs, "guards")
        return "'@guards(...)' names the fields a struct's own members are the only way into, so it can only mark a struct — and this declares none"

    if any_is(attrs, "relocates")
        return "'@relocates' says a call may move the storage its receiver's elements live in, so it marks a method — and this declares none"

    if any_is(attrs, "views")
        return "'@views(self)' says the view a call answers is borrowed from what it is called on, so it marks a method — and this declares none"

    if any_is(attrs, "consumes")
        return "'@consumes' says a call takes everything its receiver holds, so it marks a method — and this declares none"

    if all_are(attrs, "needs")
        return "'@needs(...)' names what reaching a declaration requires, so it marks a function or an 'extern' — and this declares neither"

    if all_are(attrs, "abandons")
        return "'@abandons' says a call never comes back and the program goes on without the caller's frame, so it marks a function or an 'extern' — and this declares neither"

    // `@align` beside `@section` is a binding and only a binding: a struct takes the first and not
    // the second, and a function the second and not the first. It is the pair a statically placed
    // stack is written with, so it is the case rather than a corner.
    if has_layout(attrs) && has_section(attrs) && all_layout_or_storage(attrs)
        return "'@align(n)' beside '@section(\"...\")' marks one binding's storage — the boundary it begins on and the section it sits in are both about one object, and this declares none"

    if all_layout(attrs)
        return "'@packed' describes how a struct's fields are laid out, so it can only mark a struct — a 'var' or a 'val' has no fields to pack, and '@align(n)' is the one of the two that may stand above one"

    if all_are(attrs, "section")
        return "'@section(\"...\")' places one object in a linker section, so it marks a 'var', a 'val' or a function — a 'const' is folded into every use and has no storage to place, and an 'extern' names something this program does not define"

    if all_are(attrs, "export")
        return "'@export' names what C sees — a function's symbol, a module 'var' or 'val''s symbol, or the name a struct's or a type's 'typedef' carries in a generated header — and this declares none of them. A 'const' is folded into every use and has no storage to name, a simple enum is spelled as the integer it is, so it has no name in the header to choose, and an 'extern' names something this program does not define"

    // The layout pair beside the name settles which kind was meant: `@packed` cannot mark a function,
    // so the group together can only be about a struct and the refusal need not offer the function
    // reading at all.
    if all_layout_or_export(attrs)
        return "'@packed' and '@align(n)' lay out a struct and '@export(\"...\")' names one in a generated header, so together they mark a struct — and this declares none"

    "an annotation marks a function, and only a function — neither what 'sysl test' calls nor what recurses is anything a declaration of another kind supplies. '@packed', '@align(n)' and '@export(\"...\")' are the three that mark a struct instead"
end attributed_refusal

// The word of the first `@no_<cap>` above a declaration, where one was written.
private forgo_of(attrs: Buf[Attr]) -> Option[string]
    for attr in attrs
        attr match
            Forgoes(_) -> return Some(attr_word(attr))
            _ -> ()

    None
end forgo_of

// **A `@no_<cap>` below the header that marks no function is still the module's word written in the
// wrong place**, so the header's sentence comes first -- it is what a reader who meant the module needs
// -- and the other reading is named after it.
private forgo_refusal(word: string) -> string =
    "this attribute belongs in the file's header, on the lines directly after 'module' and before " +
    "everything else — it is a property of the whole module, not of the statements below it. Above a " +
    s"function or a method, '@$word' holds that one definition instead, and this declares neither"

// The pairs that cannot describe one declaration, whichever kind it turns out to be.
private refuse_impossible_pairs(p: *Parser, attrs: Buf[Attr])
    var runners = 0
    var pure = false
    var frame = false
    var packed = false
    var section = false
    var ghost = false
    var noinline = false
    var inline = false
    var hinted = false
    var always = false
    var marks = ""

    for attr in attrs
        attr match
            Test(_) -> runners += 1
            Hook(_) -> runners += 1
            Pure -> pure = true
            Reads(_) -> frame = true
            Writes(_) -> frame = true
            Packed -> packed = true
            Section(_) -> section = true
            Ghost -> ghost = true
            NoInline -> noinline = true
            Inline(a) ->
                always = always || a
                hinted = hinted || !a
                inline = true
            _ -> ()

        if is_inlining(attr) then marks = joined(marks, attr_word(attr))

    // `@test` and the four hooks each say *when* `sysl test` calls the function, and they name four
    // different moments. Two of them above one declaration is two requests, not a stricter one.
    if runners > 1
        var named = ""

        for attr in attrs
            attr match
                Test(_) -> named = joined(named, attr_word(attr))
                Hook(_) -> named = joined(named, attr_word(attr))
                _ -> ()

        p.fault(p.here(), s"${named} each say when 'sysl test' calls this function, and they name different moments — a function is a test or one of the hooks around one, and it is called once")
        return
    end if

    // `@pure` *is* `@reads() @writes()` plus its further bans, so the two together say one thing
    // twice -- and could be made to disagree, leaving nothing to say which claim was held to.
    if pure && frame
        p.fault(p.here(), "'@pure' already says '@reads()' and '@writes()', so a frame beside it says one thing twice — write the frame alone if the function touches module storage, and '@pure' alone if it touches none")
        return
    end if

    // `@noinline` forbids inlining and `@inline` asks for it, so the two above one declaration are
    // contradictory requests rather than a stronger one. Answered before `@ghost` is looked at,
    // because the pair is wrong whatever else stands beside it.
    if noinline && always
        p.fault(p.here(), "'@noinline' forbids inlining and '@inline(always)' demands it, so they contradict above one declaration — write the one the definition is for, and '@cold' beside it if it is also reached rarely, which is a different thing to say")
        return
    end if

    if noinline && inline
        p.fault(p.here(), "'@noinline' forbids inlining and '@inline' asks for it, so they contradict above one declaration — write the one the definition is for, and '@cold' beside it if it is also reached rarely, which is a different thing to say")
        return
    end if

    // `@inline(always)` already says everything `@inline` does, and more, so the two together say
    // one thing twice -- and the weaker word would leave a reader wondering which was meant.
    if hinted && always
        p.fault(p.here(), "'@inline(always)' already asks for everything '@inline' does, so the two together say one thing twice — write '@inline(always)' alone where every call is to be replaced by the body, and '@inline' alone where it is a hint")
        return
    end if

    // A strict body is never put inside a caller that is not strict -- its operations would have to
    // stay strict among ones that are not, which LLVM does not do -- so `always` is a promise the
    // back end would break at every such call.
    if always && any_is(attrs, "strict_fp")
        p.fault(p.here(), "'@inline(always)' puts the body in place of every call, and a '@strict_fp' body is only ever put inside a caller that is '@strict_fp' too — anywhere else the call stays a call, so the promise could not be kept. Write '@inline' for the hint, which a strict caller takes")
        return
    end if

    // `@ghost` erases the function before codegen, so there is no definition for the optimizer to be
    // told anything about.
    if ghost && marks != ""
        p.fault(p.here(), s"${marks} tell the optimizer about a definition, and '@ghost' means there is none — a ghost function is erased before anything is emitted, so nothing is left to keep out of line, to absorb into a caller, or to place away from the hot path")
        return
    end if

    // `@thread_local` marks a binding and only a binding, so the only annotations it may stand beside
    // are the other ones about storage -- the two that place it and the one that names it for C.
    if per_thread(attrs) && per_core(attrs)
        p.fault(p.here(), "'@thread_local' and '@per_cpu' are two answers to how many copies one 'var' has — one per thread, or one per processor core — so they cannot stand above the same binding. Pick the one the program means: a thread moves between cores, and a core runs many threads")
        return
    end if

    // `@main_thread` is about the one copy a binding already has, so beside an annotation that makes
    // several copies it would be a promise about none of them in particular.
    if main_only(attrs) && (per_thread(attrs) || per_core(attrs))
        val other = if per_thread(attrs) then "@thread_local" else "@per_cpu"
        val each = if per_thread(attrs) then "thread" else "processor core"

        p.fault(p.here(), s"'@main_thread' and '$other' are two answers to who reaches one binding — the main thread alone, or each $each its own copy — so they cannot stand above the same one. '$other' already keeps every copy to one $each; '@main_thread' is for the one object the whole program shares")
        return
    end if

    if main_only(attrs) && !all_storage(attrs)
        p.fault(p.here(), "'@main_thread' is a promise about one 'var' or 'val', so the only annotations it stands beside are the others about storage — '@align(n)', '@section(\"...\")' and '@export'. The rest mark a function or a type, and neither is storage a thread could reach")
        return
    end if

    if per_thread(attrs) && !all_storage(attrs)
        p.fault(p.here(), "'@thread_local' gives one 'var' a copy per thread, so the only annotations it stands beside are the others about storage — '@align(n)', '@section(\"...\")' and '@export'. The rest mark a function or a type, and neither is storage a thread could have its own of")
        return
    end if

    // `@per_cpu` owns its section -- every core's copy is made from the one `.percpu` image, which a
    // linker script bounds -- so `@align(n)` is the only other storage annotation it may stand beside.
    if per_core(attrs) && has_section(attrs)
        p.fault(p.here(), "'@per_cpu' places the binding in '.percpu', the image every core's copy is made from, so '@section(\"...\")' would move it out of the block the copies are taken from. Leave the section off; '@align(n)' is the one other annotation it stands beside")
        return
    end if

    // A C symbol names one object, and per-core storage is no one object: the symbol would name the
    // image the copies are made from, which no core reads or writes.
    if per_core(attrs) && has_word(attrs, "export")
        p.fault(p.here(), "'@export' publishes one object under a C symbol, and '@per_cpu' storage is one copy per processor core — the symbol could only name the '.percpu' image the copies are made from, which no core reads or writes. Export a function that reads this core's copy instead")
        return
    end if

    if per_core(attrs) && !all_storage(attrs)
        p.fault(p.here(), "'@per_cpu' gives one 'var' a copy per processor core, so the only other annotation it stands beside is '@align(n)'. The rest mark a function or a type, and neither is storage a core could have its own of")
        return
    end if

    // `@pinned` says the callers hold the core still; `@pins` says the body does. One body cannot be
    // both, and a function that is either is code rather than storage.
    if has_word(attrs, "pinned") && has_word(attrs, "pins")
        p.fault(p.here(), "'@pinned' says every caller already keeps this function on one core, and '@pins' says the function does that itself before it reaches per-core storage — one body is one or the other. '@pins' is the one that asks nothing of its callers")
        return
    end if

    // `@packed` describes the arrangement of fields within a type and `@section` places one object,
    // so the two cannot be about the same declaration whichever kind it turns out to be.
    if packed && section
        p.fault(p.here(), "'@packed' lays out a struct's fields and '@section(\"...\")' places one object, so they cannot stand above one declaration — a type occupies no address of its own, and the storage that holds a packed value is what a section would be about")
        return
    end if

    // A layout annotation and a function annotation describe different kinds of thing, so one
    // declaration cannot carry both -- and saying which pair collided is more use than the refusal
    // whichever kind the declaration turns out to be would give. `@section` is in neither camp, and
    // a set of nothing but layout and `@export("...")` is a struct's C name beside its layout. A set
    // holding `@thread_local` is a binding's, settled by the rule above.
    if has_layout(attrs) && !per_thread(attrs) && !per_core(attrs) && !main_only(attrs) &&
            !all_layout_or_export(attrs) && marks_a_function(attrs)
        p.fault(p.here(), "'@packed' and '@align' describe a layout and the rest mark a function, so they cannot stand above one declaration — a struct has no body to be tail-recursive or pure in, and a function has no fields to lay out")
end refuse_impossible_pairs

// Whether any annotation in the set is neither about a layout nor `@section`'s placing of an object.
// `@pinned` marks a struct as readily as a function, so it settles neither reading.
private marks_a_function(attrs: Buf[Attr]) -> bool
    for attr in attrs
        if !is_layout(attr) && attr_word(attr) != "section" && attr_word(attr) != "pinned" &&
                !is_user(attr) && !is_annotation_mark(attr) then
            return true

    false
end marks_a_function

private joined(so_far: string, word: string) -> string
    if so_far == "" then return s"'@${word}'"

    s"${so_far} and '@${word}'"
end joined

// Whether an attribute tells the optimizer how a definition is reached -- `@noinline`, `@inline` and
// `@cold`. One category because the one thing any of them needs is a definition to be about, which
// is what `@ghost` takes away.
private is_inlining(a: Attr) -> bool = a match
    NoInline -> true
    Inline(_) -> true
    Cold -> true
    _ -> false

// Whether an attribute is one of the three about a binding's storage -- the boundary it begins on,
// the section it sits in, and whether each thread has its own copy -- which is the set
// `@thread_local` may be written beside.
private is_storage(a: Attr) -> bool = a match
    Align(_) -> true
    Section(_) -> true
    ThreadLocal -> true
    PerCpu -> true
    MainThread -> true
    _ -> false

private has_export(attrs: Buf[Attr]) -> bool
    for attr in attrs
        if attr_word(attr) == "export" then return true

    false
end has_export

private has_layout(attrs: Buf[Attr]) -> bool
    for attr in attrs
        if is_layout(attr) then return true

    false
end has_layout

private has_section(attrs: Buf[Attr]) -> bool
    for attr in attrs
        if attr_word(attr) == "section" then return true

    false
end has_section

private all_layout_or_storage(attrs: Buf[Attr]) -> bool
    for attr in attrs
        if !is_layout(attr) && !is_storage(attr) then return false

    true
end all_layout_or_storage

private all_layout_or_export(attrs: Buf[Attr]) -> bool
    for attr in attrs
        if !is_layout(attr) && attr_word(attr) != "export" then return false

    true
end all_layout_or_export

// Whether a set of annotations asks for one copy per thread.
private per_thread(attrs: Buf[Attr]) -> bool = has_word(attrs, "thread_local")

// Whether a set of annotations asks for one copy per processor core.
private per_core(attrs: Buf[Attr]) -> bool = has_word(attrs, "per_cpu")

// Whether a set of annotations promises that only the main thread reaches the binding.
private main_only(attrs: Buf[Attr]) -> bool = has_word(attrs, "main_thread")

private has_word(attrs: Buf[Attr], word: string) -> bool
    for attr in attrs
        if attr_word(attr) == word then return true

    false
end has_word

private all_storage(attrs: Buf[Attr]) -> bool
    for attr in attrs
        if !is_storage(attr) && attr_word(attr) != "export" then return false

    true
end all_storage

private is_layout(a: Attr) -> bool = a match
    Packed -> true
    Align(_) -> true
    ByteOrder(_) -> true
    _ -> false

private all_layout(attrs: Buf[Attr]) -> bool
    if attrs.is_empty() then return false

    for attr in attrs
        if !is_layout(attr) then return false

    true
end all_layout

private all_are(attrs: Buf[Attr], word: string) -> bool
    if attrs.is_empty() then return false

    for attr in attrs
        if attr_word(attr) != word then return false

    true
end all_are

// Whether any annotation in the set is written with this word.
private any_is(attrs: Buf[Attr], word: string) -> bool
    for attr in attrs
        if attr_word(attr) == word then return true

    false
end any_is

// The capabilities a set of annotations names, flattened.
private capabilities_of(attrs: Buf[Attr]) -> Buf[string]
    var out: Buf[string] = buf()

    for attr in attrs
        attr match
            Needs(cs) ->
                for j in 0..<cs.len()
                    out.push(cs.at(j))
            _ -> ()

    out
end capabilities_of

// The parameters a `@keeps(...)` named, in the order written.
private kept_names(attrs: Buf[Attr]) -> Buf[string]
    for attr in attrs
        attr match
            Keeps(ns) -> return ns
            _ -> ()

    buf()
end kept_names

// The parameters an `@answers(...)` named, in the order written.
private answered_names(attrs: Buf[Attr]) -> Buf[string]
    for attr in attrs
        attr match
            Answers(ns) -> return ns
            _ -> ()

    buf()
end answered_names

// The layout pair, the C name and the guarded fields, folded onto the struct they were written above.
private laid_out(p: *Parser, at: Span, s: Stmt, attrs: Buf[Attr]) -> Stmt
    *s.kind match
        StructDecl(d) ->
            var decl = d

            for attr in attrs
                attr match
                    Packed -> decl.packed = true
                    Align(n) -> decl.alignment = Some(n)
                    ByteOrder(big) -> decl.byte_order = Some(big)
                    Export(e) -> decl.cname = Some(e)
                    Guards(ns) -> decl.guards = guarded_fields(p, at, decl, ns)
                    Pinned -> decl.pinned = true
                    AnnotationMark -> decl.annotation = true
                    User(u) -> decl.annots.push(u)
                    _ -> ()

            if decl.annotation then refuse_annotation_shape(p, at, decl)

            stmt(s.span, StructDecl(decl))
        _ -> s
end laid_out

// An annotation's struct is named by every use of it, and its fields are what a use writes, so a
// name the language's own annotations take is refused. It may take ONE type parameter, which each
// use binds to the type of the field it is written on (`annotations.sysl`); a second, or a value
// parameter, is one no use could supply.
private refuse_annotation_shape(p: *Parser, at: Span, d: StructDecl)
    if builtin_attr_word(d.name)
        p.fault(at, s"'@${d.name}' is one of the language's own annotations, so an annotation a program declares may not take the name — a use of it would read as the built-in one")
        return
    end if

    if d.tparams.len() > 1
        p.fault(at, s"an annotation takes at most one type parameter — a use of '@${d.name}' gives it the type of the field it is written on, which is one type, and nothing gives the others")
        return
    end if

    if !d.tvalues.is_empty() then
        p.fault(at, s"an annotation's parameter is a type — a use of '@${d.name}' gives it the type of the field it is written on — so it cannot be a value parameter")
end refuse_annotation_shape

private any_user(attrs: Buf[Attr]) -> bool
    for a in attrs
        if is_user(a) then return true

    false
end any_user

// The program's annotations written above an enum, kept on its declaration.
private annotated_enum(s: Stmt, attrs: Buf[Attr]) -> Stmt
    *s.kind match
        EnumDecl(d) ->
            var decl = d

            for attr in attrs
                attr match
                    User(u) -> decl.annots.push(u)
                    _ -> ()

            stmt(s.span, EnumDecl(decl))
        _ -> s
end annotated_enum

// The fields `@guards(...)` names, each held to being one the struct declares and keeps `private`.
//
// **A guarded field is a promise that the struct's own members are the only way to its value**, which
// is what lets sharing the struct leave the value out (`reference/memory.md § A guarded value crosses with its lock`). A
// field anyone may read is a way in that goes round the members, so it cannot be guarded.
private guarded_fields(p: *Parser, at: Span, d: StructDecl, names: Buf[string]) -> Buf[string]
    var out: Buf[string] = buf()

    for name in names
        var found: Option[Param] = None

        for f in d.fields
            if f.name == name then found = Some(f)

        if found.is_none()
            p.fault(at, s"'@guards($name)' names a field of '${d.name}', and '${d.name}' declares no field '$name'")
        else if !file_private(found.unwrap().vis)
            p.fault(at, s"'@guards($name)' promises that '${d.name}''s own members are the only way to '$name', and a field visible beyond this file is a way round them — declare it 'private'")
        else
            out.push(name)
    end for

    out
end guarded_fields

private file_private(v: Visibility) -> bool = v match
    File -> true
    _ -> false

// The C name `@export` gives a `type` in a generated header, and the program's annotations a type of
// its own carries.
//
// **A plain alias carries none**: `type Id = int` is a second name for `int`, the one type, so an
// annotation on it would be one `int` had under one of its names and not under the other.
private exported_type(p: *Parser, s: Stmt, attrs: Buf[Attr]) -> Stmt
    *s.kind match
        TypeDecl(d) ->
            var decl = d
            val alias = !d.derived && d.range.is_none() && d.pred.is_none() && d.wrapping.is_none()

            for attr in attrs
                attr match
                    Export(e) -> decl.cname = Some(e)
                    User(u) ->
                        if alias
                            p.fault(u.span, s"'@${annot_written(u)}' is about a type of its own, and 'type ${d.name} = ${type_text(d.base)}' declares none — it is a second name for '${type_text(d.base)}', the same type, so an annotation is written above a 'new' type, a range, a 'where' or the declaration of '${type_text(d.base)}'")
                        else decl.annots.push(u)
                    _ -> ()

            stmt(s.span, TypeDecl(decl))
        _ -> s
end exported_type

// `@align(n)`, `@section("...")` and `@thread_local` folded onto whichever binding they were written
// above, reaching through the `static` wrapper to the declaration inside it.
//
// **The visibility was read before the keyword was**, above the binding's own reading, so it is
// handed in and put back on the binding: `@export private var x` is a private `x`.
private placed(p: *Parser, s: Stmt, attrs: Buf[Attr], written: Visibility) -> Stmt
    var align: Option[Expr] = None
    var section: Option[string] = None
    val copies = if per_thread(attrs) then CopyPerThread
    else if per_core(attrs) then CopyPerCpu
    else if main_only(attrs) then MainThreadOnly
    else OneCopy

    // `@thread_local` is the one of the three that chooses between the two keywords, so it is
    // answered before the shared "names several" rule: a reader who wrote it above a `val` has a
    // mistake about what the attribute is for, whatever the count of names.
    if copies == CopyPerThread && !holds_a_var(s)
        p.fault(Span(s.span.end, s.span.end), "'@thread_local' gives one 'var' a copy per thread, and a 'val' never changes — so the one copy every 'val' already has is every thread's, and a per-thread constant is a constant. Write it above a 'var' if the threads need to disagree")
        return s
    end if

    if copies == CopyPerCpu && !holds_a_var(s)
        p.fault(Span(s.span.end, s.span.end), "'@per_cpu' gives one 'var' a copy per processor core, and a 'val' never changes — so the one copy every 'val' already has is every core's, and a per-core constant is a constant. Write it above a 'var' if the cores need to disagree")
        return s
    end if

    var export: Option[ExportAttr] = None

    for attr in attrs
        attr match
            Align(n) -> align = Some(n)
            Section(name) -> section = Some(name)
            Export(e) -> export = Some(e)
            _ -> ()

    *s.kind match
        ValDecl(n, t, v, vis, _, _, _, _) ->
            stmt(s.span, ValDecl(n, t, v, either_vis(written, vis), align, section, copies, export))
        VarDecl(n, t, v, vis, _, _, _, _) ->
            stmt(s.span, VarDecl(n, t, v, either_vis(written, vis), align, section, copies, export))
        StaticDecl(inner) -> stmt(s.span, StaticDecl(placed(p, inner, attrs, written)))

        // **Both annotations are about one object**, so a binding that names several has nothing for
        // them to be about. The refusal names the annotation rather than the binding, since the
        // annotation is the half that has to go.
        //
        // **A copy per thread or per core is not about one object**: it says how many copies each
        // name's storage has, which a `var` naming several things says of each name.
        MultiDecl(names, mutable, values, vis) ->
            several_placed(p, s, attrs, copies, MultiDecl(names, mutable, values, either_vis(written, vis)))
        PatternDecl(pat, mutable, value, typ, vis) ->
            several_placed(p, s, attrs, copies, PatternDecl(pat, mutable, value, typ, either_vis(written, vis)))
        _ -> s
end placed

// A binding naming several things under annotations: refused for the ones about one object, and
// otherwise given the copies the annotations ask each name for.
private several_placed(p: *Parser, s: Stmt, attrs: Buf[Attr], copies: Copies, kind: StmtKind) -> Stmt
    var about_one: Buf[Attr] = buf()

    for attr in attrs
        if attr_word(attr) != "thread_local" && attr_word(attr) != "per_cpu" then about_one.push(attr)

    if !about_one.is_empty() then return refuse_several(p, s, about_one)
    if copies == OneCopy then return s

    stmt(s.span, CopiedDecl(copies, stmt(s.span, kind)))
end several_placed

// The visibility written in front of the annotations' declaration, where one was, and the binding's
// own reading otherwise.
private either_vis(written: Visibility, own: Visibility) -> Visibility = written match
    Public -> own
    _ -> written

// `@section("...")` and `@align(n)` folded onto the `asm` block they were written above, which is
// module-level wherever it stands: an annotated block inside a function is refused by the analysis
// rather than read as that function's code with the annotations dropped.
private placed_asm(s: Stmt, attrs: Buf[Attr]) -> Stmt
    var align: Option[Expr] = None
    var section: Option[string] = None

    for attr in attrs
        attr match
            Align(n) -> align = Some(n)
            Section(name) -> section = Some(name)
            _ -> ()

    *s.kind match
        AsmStmt(arms) -> stmt(s.span, ModuleAsm(arms, section, align))
        _ -> s
end placed_asm

// Two sentences rather than one about "an annotation", each naming the thing it is about: `@align`'s
// when that is all there is, `@section`'s otherwise.
private refuse_several(p: *Parser, s: Stmt, attrs: Buf[Attr]) -> Stmt
    if attrs.is_empty() then return s

    var about = "'@align(n)' is the boundary one object's storage begins on"

    if !all_are(attrs, "align") then about = "'@section(\"...\")' places one object"
    if has_export(attrs) then about = "'@export' publishes one object under one C symbol"
    if main_only(attrs) then about = "'@main_thread' is a promise about one object"

    p.fault(Span(s.span.end, s.span.end), s"${about}, and a binding that names several has " +
        "no one object for it to be about \u{2014} declare them on lines of their own")
    s
end refuse_several

// Whether a binding is a `var` -- the one keyword `@thread_local` marks -- reaching through the
// `static` wrapper. A comma list and a pattern are `var`s too.
private holds_a_var(s: Stmt) -> bool = *s.kind match
    VarDecl(_, _, _, _, _, _, _, _) -> true
    MultiDecl(_, mutable, _, _) -> mutable
    PatternDecl(_, mutable, _, _, _) -> mutable
    StaticDecl(inner) -> holds_a_var(inner)
    _ -> false
