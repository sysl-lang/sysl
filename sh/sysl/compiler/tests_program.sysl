    val src = "use() -> sysl.Option[int] = sysl.Option.None\n"
    val out = shown(src, "use")

    assert(out.contains("sysl.Option[int]"), out)

@test("what one callable yields settles what the next one takes")
a_callable_settles_the_next_one()
    if no_library() then return

    val src = "walk[A, B](x: A, first: A -> B, again: B -> B) -> B = again(first(x))\n\n" +
              "wrap(n: int) -> string = str(n)\n" +
              "twice(s: string) -> string = s + s\n\n" +
              "use() -> string = walk(1, wrap, twice)\n"
    val out = shown(src, "use")

    assert(out.contains("retTy: string"), out)

@test("a value that is not a scalar renders itself through its 'Display'")
a_value_renders_through_its_display()
    if no_library() then return

    val text = point() + "impl Display for P\n" +
        "    display(self, out: *Writer, fmt: FormatSpec) = display_str(\"p\", out, fmt)\n\n" +
        "probe(p: P) -> string = str(p)\n"
    val shown_text = shown(text, "probe")

    assert(shown_text.index_of("TRender").is_some(), shown_text)
    assert(shown_text.index_of("method: \"P.display\"").is_some(), shown_text)
    assert(shown_text.index_of("struct: sysl.FormatSpec").is_some(), shown_text)

@test("and a scalar goes out directly, since the two render alike and one builds no sink")
a_scalar_renders_directly()
    if no_library() then return

    val shown_text = shown("probe(n: int) -> string = str(n)\n", "probe")

    assert(shown_text.index_of("TStr").is_some(), shown_text)
    assert(shown_text.index_of("TRender").is_none(), shown_text)

@test("a module may be written out in full at a call")
a_module_may_be_written_out_at_a_call()
    if no_library() then return

    val text = "probe(a: []const byte, b: []const byte) -> bool = sysl.slices.equal(a, b)\n"
    val shown_text = shown(text, "probe")

    assert(shown_text.index_of("sysl.slices$equal").is_some(), shown_text)

@test("an operator's dispatch is a body the program reaches")
an_operators_dispatch_is_reached()
    if no_library() then return

    val text = "probe(a: sysl.math.bigint.BigInt, b: sysl.math.bigint.BigInt) -> bool = a == b\n"

    assert(emits(text, "sysl.math.bigint$BigInt.eq"), "the 'eq' the '==' dispatches to is emitted")

@test("and so is every slot of a table a value was erased into")
a_tables_slots_are_reached()
    if no_library() then return

    val text = "probe() -> unit\n    var out: *sysl.Writer = &sysl.stdout()\n\n    out.write(\"x\".bytes)\n"

    assert(emits(text, "sysl$Stdout.write") || complaints(text).len() > 0,
           "the 'write' the table points at is emitted")

@test("what a 'within' declaration narrowed is part of the type its attributes read")
a_constrained_subtypes_ends_are_its_own()
    if no_library() then return

    val text = "type Age = int within 0..150\n\nuse() -> Age = Age::Max\n"
    val out = shown(text, "use")

    assert(out.index_of("value: 150").is_some(), out)

    val low = shown("type Age = int within 7..150\n\nuse() -> Age = Age::Min\n", "use")

    assert(low.index_of("value: 7").is_some(), low)

    val last = shown("type Age = int within 0..<150\n\nuse() -> Age = Age::Last\n", "use")

    assert(last.index_of("value: 149").is_some(), last)

@test("and a type parameter bound to one reads that type's ends and not its base's")
a_parameter_at_a_constrained_subtype()
    if no_library() then return

    val text = "type Age = int within 0..150\n\nwidest[T]() -> T = T::Max\n\n" +
        "use() -> Age = widest[Age]()\n"
    val out = shown(text, "widest.int")

    assert(out.index_of("value: 150").is_some(), out)

@test("an unranged subtype has no ends to name, and its bounds are its base's")
an_unranged_subtype_has_no_ends()
    if no_library() then return

    val said = complaints("type Tag = new int\n\nuse() -> Tag = Tag::First\n")

    assert(says(said, "'Tag::First' needs a 'within' range"), listed(said))

    val out = shown("type Tag = new int\n\nuse() -> Tag = Tag::Max\n", "use")

    assert(out.index_of("value: 2147483647").is_some(), out)

// Where each type stands in the record of what a compilation made real, by the type's own spelling.
private made_real_at(p: TProgram, shown: string) -> Option[usize]
    for i in 0..<p.enums.len()
        if type_show(p.enums.at(i)) == shown then return Some(i)

    None
end made_real_at

private program_of_text(text: string) -> TProgram
    val parsed = parse(source_of("test.sysl", text))
    var units: Buf[Program] = buf()
    val library = library_trees()

    for i in 0..<library.len()
        units.push(library.at(i))

    units.push(parsed.program)

    program_of(analyze_bodies(units, host_target()), "")
end program_of_text

@test("a module's storage names its types after its members do, which is the order they are laid out in")
storage_types_come_after_the_members()
    if no_library() then return

    val text = "module m\n\n" +
        "struct Sink\n    n: int\nend Sink\n\n" +
        "struct Held\n    n: int\nend Held\n\n" +
        "struct Holder\n    n: int\n\n" +
        "    pick(self) -> Option[Held] = Some(Held(self.n))\nend Holder\n\n" +
        "var current: Option[*Sink] = None\n\n" +
        "read() -> bool = current.is_some()\n"
    val p = program_of_text(text)
    val member = made_real_at(p, "sysl.Option[m.Held]")
    val storage = made_real_at(p, "sysl.Option[*m.Sink]")

    assert(member.is_some(), "the member's result was never made real")
    assert(storage.is_some(), "the storage's type was never made real")
    assert(storage.unwrap() > member.unwrap(),
           s"storage at ${storage.unwrap()}, member at ${member.unwrap()}")

@test("and the type is still read where nothing names the storage, so a mistake in one is reported")
storage_of_a_type_that_is_not_there()
    if no_library() then return

    val said = complaints("module m\n\nvar current: Option[*Missing] = None\n")

    assert(says(said, "unknown type 'Missing'"), listed(said))

// -- what a declaration's condition lowers to -----------------------------------------------------

// The names of the functions a program ends up with, in the order it declared them.
private declared_names(text: string) -> Buf[string]
    val p = program_of_text(text)
    var out: Buf[string] = buf()

    for i in 0..<p.funcs.len()
        out.push(p.funcs.at(i).name)

    out
end declared_names

private names_hold_one(xs: Buf[string], name: string) -> bool
    for i in 0..<xs.len()
        if xs.at(i) == name then return true

    false
end names_hold_one

@test("a 'where' predicate becomes a function of the value, named after the type it narrows")
a_where_predicate_is_lifted()
    if no_library() then return

    val names = declared_names("module m\n\ntype Even = int where value % 2 == 0\n")

    assert(names_hold_one(names, "m$Even$pred"), "no 'm$Even$pred' among the functions")

@test("and a struct's invariant clauses become one function of its fields")
invariant_clauses_are_lifted()
    if no_library() then return

    val text = "module m\n\nstruct Held\n    a: int\n    b: int\n\n    invariant a <= b\nend Held\n"
    val names = declared_names(text)

    assert(names_hold_one(names, "m$Held$inv"), "no 'm$Held$inv' among the functions")

@test("a predicate is code, so one that is not a 'bool' is reported as the condition a reader wrote")
a_where_predicate_that_is_not_a_bool()
    if no_library() then return

    val said = complaints("module m\n\ntype Even = int where value + 1\n")

    assert(says(said, "a 'where' predicate must be a 'bool', but this one is int"), listed(said))

@test("and so is an invariant clause")
an_invariant_clause_that_is_not_a_bool()
    if no_library() then return

    val text = "module m\n\nstruct Held\n    a: int\n    b: int\n\n    invariant a + b\nend Held\n"
    val said = complaints(text)

    assert(says(said, "an 'invariant' must be a 'bool', but this one is int"), listed(said))

@test("a struct that states an invariant is checked the moment one is built")
a_construction_checks_the_invariant()
    if no_library() then return

    val text = "module m\n\nstruct Held\n    a: int\n    b: int\n\n    invariant a <= b\nend Held\n\n" +
        "hold(x: int, y: int) -> Held = Held(x, y)\n"
    val out = shown(text, "m$hold")

    assert(out.contains("TStructInvCheck"), out)
    assert(out.contains("invFn: \"m$Held$inv\""), out)

@test("and one that states none is built with nothing wrapped around it")
a_construction_with_no_invariant()
    if no_library() then return

    val text = "module m\n\nstruct Plain\n    a: int\nend Plain\n\n" +
        "hold(x: int) -> Plain = Plain(x)\n"
    val out = shown(text, "m$hold")

    assert(!out.contains("TStructInvCheck"), out)
