module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.math.bigint.from_int

// **One whole function**: the frame its parameters are copied into, the body, and the return.
//
// A function owns its parameters and returns its result with a count already taken, so a caller can
// hand over a temporary and a callee can store one without either having to know what the other did
// with it. That bookkeeping is the ownership runtime's, and a function whose signature or body needs
// any of it is left out of the module rather than emitted without it.

// The function, or nothing where its body reached a form this compiler does not lower yet.
gen_function(e: *Emit, f: TFunc) -> Option[IrFunc]
    start_function(e)
    push_temps(e)
    push_owned(e)

    for i in 0..<f.ensures.len()
        e.ensures.push(f.ensures.at(i))

    if f.tailrec then gap_here(e, "a tail-recursive frame")

    // A zero-sized parameter is not an argument: there is nothing to receive and nothing to keep, so
    // it takes no slot and the emitted signature does not mention it.
    for i in 0..<f.params.len()
        val p = f.params.at(i)

        if !zero_sized(p.1)
            val ty = p.1

            alloca(e, VReg(s"${p.0}.addr"), lty(e, ty))

            // A large one arrived as an address, so the copy the callee makes for itself is a copy
            // of bytes and the count it takes is taken at the slot rather than off a value it never
            // had.
            if e.layout.indirect(ty)
                emit_memcpy(e, VReg(s"${p.0}.addr"), VReg(s"${p.0}.param"), int(e.layout.size(ty)),
                            int(e.layout.align(ty)))
                retain_at(e, ty, VReg(s"${p.0}.addr"))
            else
                emit(e, InStore(lty(e, ty), VReg(s"${p.0}.param"), VReg(s"${p.0}.addr"), AccPlain,
                                None))
                retain_value(e, ty, VReg(s"${p.0}.param"))

            own_slot(e, p.0, ty)

    // Where the function calls itself as the last thing it does, that call is a jump to here rather
    // than a second frame. The target sits *after* the parameter slots are written and *before*
    // everything below, so a jump arrives where a fresh call would: the arguments are in the slots
    // the body reads, and the preconditions that follow belong to the invocation rather than to the
    // frame, so they are taken again.
    //
    // The slots themselves are the entry block's and are not re-entered, which is what makes the
    // jump free: every one of them is hoisted, so going round again reuses the frame instead of
    // growing it.
    val found = tail_calls_of(f)

    if !found.is_empty()
        val l = fresh_label(e, "tailrec")

        for i in 0..<f.params.len()
            e.tail_params.push(f.params.at(i))

        for i in 0..<found.len()
            e.tail_calls.push(found.at(i))

        e.tail_target = l
        emit_term(e, InBr(l))
        emit_label(e, l)

    for i in 0..<f.requires.len()
        emit_contract(e, f.requires.at(i).cond, "require")

    // Each `old(e)` snapshots the entry value into a hidden owned slot, exactly as a `var` would, so
    // a postcondition can compare the returned state against the state on entry. The slot is
    // released with every other local at each return.
    for i in 0..<f.olds.len()
        push_temps(e)

        val old = f.olds.at(i)
        val oty = texpr_type(old)
        val v = gen_expr(e, old)

        alloca(e, VReg(s"old.$i.addr"), lty(e, oty))
        retain_value(e, oty, v)
        emit(e, InStore(lty(e, oty), v, VReg(s"old.$i.addr"), AccPlain, None))
        own_slot(e, s"old.$i", oty)
        pop_temps(e)

    gen_stmts(e, f.body.stmts)

    // A `never` result is `void` like `unit`: the body's trailing expression diverges, so it has
    // already terminated the block and the `ret` emitted here is dropped.
    f.body.result match
        Some(r) ->
            if e.layout.indirect(f.ret_ty) then gen_indirect_return(e, r)
            else if !no_value(f.ret_ty)
                val v = gen_expr(e, r)

                retain_value(e, f.ret_ty, v)
                emit_ensures(e, Some(v))
                release_all(e)
                emit_term(e, InRet(Some(lty(e, f.ret_ty)), Some(v)))
            else
                gen_expr(e, r)
                emit_ensures(e, None)
                release_all(e)
                emit_term(e, InRet(None, None))
        None ->
            if no_value(f.ret_ty)
                emit_ensures(e, None)
                release_all(e)
                emit_term(e, InRet(None, None))
            else if e.layout.indirect(f.ret_ty)
                emit(e, InStore(lty(e, f.ret_ty), VZero, sret_param(), AccPlain, None))
                release_all(e)
                emit_term(e, InRet(None, None))
            else
                release_all(e)
                emit_term(e, InRet(Some(lty(e, f.ret_ty)), Some(zero_of(e, f.ret_ty))))

    if has_gap(e) then return None

    // A file-private declaration has every caller in the module that defines it, so its symbol is
    // `internal`: nothing outside may resolve it, and the linker is free to discard it when nothing
    // inside calls it either.
    val linkage = if f.internal then LinkInternal else LinkDefault

    Some(finish_func(e, IrFuncSig(symbol_of(e, f.name),
                                  sysl_fn_type(e, f.ret_ty, f.params, f.variadic, Some(f)),
                                  linkage, convention_of(e, f), attribute_of(e, f), f.section)))
end gen_function

// What a calling convention becomes on the `define` line for **this** machine. LLVM spells the one
// concept two ways: x86-64's interrupt handler is a *calling convention* written before the result
// type, and RISC-V's is a *function attribute* written after the signature.
private convention_of(e: *Emit, f: TFunc) -> Option[string]
    if f.conv.is_none() then return None
    if e.target.cpu == X86_64 then return Some("x86_intrcc")

    None
end convention_of

private attribute_of(e: *Emit, f: TFunc) -> Buf[(string, string)]
    var out: Buf[(string, string)] = buf()

    f.conv match
        Some(c) ->
            if e.target.cpu == Riscv64 || e.target.cpu == Riscv32
                val mode = c.arg match
                    Some(m) -> m
                    None -> "machine"

                out.push(("interrupt", mode))
        None -> ()

    out
end attribute_of

// A result too large for registers, written where the caller said rather than handed back. The
// out-pointer *is* the destination, so what would have been the returned value is built where it is
// going.
//
// A postcondition still gets the value it is written about. Reading it back out of the storage is a
// whole-aggregate load of the kind this lowering exists to avoid -- but only on a function that
// *has* an `ensures`, and only once at each of its returns, which is a price a contract already
// announces it is willing to pay.
gen_indirect_return(e: *Emit, r: TExpr)
    gen_into(e, sret_param(), r)

    if !e.ensures.is_empty()
        val v = fresh_reg(e)

        emit(e, InLoad(v, lty_of(e, r), sret_param(), AccPlain, None))
        emit_ensures(e, Some(v))
    else emit_ensures(e, None)

    release_all(e)
    emit_term(e, InRet(None, None))
end gen_indirect_return
