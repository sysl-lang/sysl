module sh.sysl.compiler
@tests

// What a program can ask a character cursor beyond "give me the next one" (`reference/strings.md §
// Granularity: bytes and scalar values`): where it is, what is next without moving to it, how many
// are left, and the paired walk that reports an offset alongside each character.
//
// `aé→𝄞` is one character at each of the four UTF-8 widths, so byte offsets and character counts
// disagree at every step. A reported offset is a character's FIRST byte, and `s[a..b]` traps on a
// mid-codepoint bound, so a test slicing at a reported offset checks the claim rather than
// describing it.
//
// **Every output quoted here was read out of the reference compiler** (0.0.162), whose
// `CharCursorTests` these are. The building and running is `tests_enm_enum_run.sysl`'s.

// ---- a byte says whether it begins a character ----

@test("an ASCII byte and a lead byte both do")
ccr_an_ascii_byte_and_a_lead_byte_both_do()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        import sysl.text.*

        print(is_char_boundary(u8('a')), is_char_boundary(0xC3u8), is_char_boundary(0xF0u8))
        """), "true true true\n")

// The only byte pattern that is not a boundary: `10xxxxxx` is the continuation byte and nothing
// else is.
@test("a continuation byte does not")
ccr_a_continuation_byte_does_not()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        import sysl.text.*

        print(is_char_boundary(0x80u8), is_char_boundary(0xA9u8), is_char_boundary(0xBFu8))
        """), "false false false\n")

@test("so counting boundaries over a string counts its characters")
ccr_counting_boundaries_counts_characters()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        import sysl.text.*

        var n = 0
        for b in "aé→𝄞".bytes do if is_char_boundary(b) then n += 1
        print(n, "aé→𝄞".len)
        """), "4 10\n")

// ---- the cursor says where it is ----

// The four widths in order: an offset that advanced by a fixed step, or by the character count,
// disagrees at the first multi-byte character.
@test("and the offset advances by each character's own width")
ccr_the_offset_advances_by_each_width()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        import sysl.text.*

        var c = "aé→𝄞".chars
        print(c.offset)
        c.next()
        print(c.offset)
        c.next()
        print(c.offset)
        c.next()
        print(c.offset)
        c.next()
        print(c.offset)
        """), "0\n1\n3\n6\n10\n")

@test("a fresh cursor over an empty string is already at the end")
ccr_an_empty_cursor_is_at_the_end()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        import sysl.text.*

        var c = "".chars
        print(c.offset, c.next().is_none())
        """), "0 true\n")

// ---- peeking does not move the cursor ----

@test("the peeked character is the one the next step yields")
ccr_the_peeked_character_is_the_next()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        import sysl.text.*

        var c = "aé→𝄞".chars
        print(c.peek().unwrap() == c.next().unwrap())
        """), "true\n")

// A peek that advanced would show `é` the second time.
@test("peeking twice sees the same character and leaves the offset alone")
ccr_peeking_twice_sees_the_same_character()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        import sysl.text.*

        var c = "aé→𝄞".chars
        var first = c.peek().unwrap()
        var second = c.peek().unwrap()
        print(first, second, c.offset)
        """), "a a 0\n")

@test("peeking at the end says there is nothing there")
ccr_peeking_at_the_end_is_none()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        import sysl.text.*

        var c = "x".chars
        c.next()
        print(c.peek().is_none())
        """), "true\n")

// ---- counting what is left ----

@test("counts characters rather than bytes")
ccr_counts_characters_rather_than_bytes()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        import sysl.text.*

        var c = "aé→𝄞".chars
        print(c.count(), "aé→𝄞".len)
        """), "4 10\n")

// By value, so asking does not consume: a count that took `*self` would leave the cursor at the end.
@test("and does not consume the cursor")
ccr_counting_does_not_consume()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        import sysl.text.*

        var c = "aé→𝄞".chars
        print(c.count())
        print(c.next().unwrap(), c.count())
        """), "4\na 3\n")

@test("counting an exhausted cursor gives zero")
ccr_counting_an_exhausted_cursor_gives_zero()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        import sysl.text.*

        var c = "ab".chars
        c.next()
        c.next()
        print(c.count())
        """), "0\n")

// ---- the paired walk reports an offset with each character ----

// 0, 1, 3, 6: each advances by the PREVIOUS character's width rather than by one.
@test("each offset is the character's first byte")
ccr_each_offset_is_the_first_byte()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        import sysl.text.*

        for p in char_indices("aé→𝄞".bytes)
            print(p.0, p.1)
        """), "0 a\n1 é\n3 →\n6 𝄞\n")

@test("and it yields exactly as many pairs as there are characters")
ccr_as_many_pairs_as_characters()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        import sysl.text.*

        var n = 0
        for _ in char_indices("aé→𝄞".bytes) do n += 1
        print(n)
        """), "4\n")

// `s[a..b]` traps on a mid-codepoint bound, so this printing IS the guarantee: an offset scheme
// reporting the byte after a character would trap here.
@test("so a slice taken at a reported offset lands on a boundary")
ccr_a_slice_at_a_reported_offset_lands_on_a_boundary()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        import sysl.text.*

        var s = "aé→𝄞"
        var at = 0usize
        for p in char_indices(s.bytes)
            if p.1 == '→' then at = p.0
        print(s[at..], s[..<at])
        """), "→𝄞 aé\n")

@test("an empty run yields nothing")
ccr_an_empty_run_yields_nothing()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        import sysl.text.*

        var n = 0
        for _ in char_indices("".bytes) do n += 1
        print(n)
        """), "0\n")
