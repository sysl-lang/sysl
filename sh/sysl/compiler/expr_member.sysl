module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.math.bigint.{BigInt, from_int}

// Reading a member off a value: a struct's field, a tuple's part, and the members the compiler
// supplies for the types it knows the shape of.
//
// **What a type declares of its own -- a property, a method, a trait's member -- is looked up
// through `lookup_trait_member`**, which the stage that builds the member tables fills in. Reading
// a field is here because a field is layout: the declaration already says where it is, and nothing
// has to be resolved to find it.

// A member read off a value, where the value is one the compiler knows the shape of.
field_expr(cx: &Analyzer, span: Span, receiver: Expr, name: string,
           expected: Option[Type]) -> TExpr
    // A module path folded into a name -- `m.limit` is one name and not a member read.
    val through = through_module(cx, receiver, name)

    if through.is_some() then return name_expr(cx, span, through.unwrap(), expected)

    // A **type** in the position a value would be read from. What a type offers under its own name
    // is an associated function and nothing else, so the parentheses are what is missing.
    val on_type = type_member(cx, span, receiver, name, expected)

    if on_type.is_some() then return on_type.unwrap()

    // A bare variant reached through the **module** that declares it rather than through its enum --
    // `inflate.BadBlock`, which is the one spelling available to a file that imported the module and
    // not the name.
    val in_module = module_variant(cx, span, receiver, name)

    if in_module.is_some() then return in_module.unwrap()

    val outer = type_expr_bare(cx, receiver)

    if texpr_type(outer) == Unknown then return outer

    val tr = auto_deref(cx, outer)
    val rt = texpr_type(tr)

    // A trait object has no fields: the layout is exactly what it forgot.
    if erased(rt) then
        return lookup_trait_member(cx, span, tr, name, buf(), expected)

    rt match
        Struct(d) -> struct_field(cx, span, tr, d, name, expected)
        Str ->
            // **A string's length is layout and not a trait member**, which is why `Search`
            // deliberately declares none: what a `[]const u8` and a `string` each answer is the
            // number of bytes they hold, and neither needs an implementation to say so.
            if name == "len" then TExpr(span, TLen(tr, usize_type(word_bits(cx))))
            else if name == "bytes" then TExpr(span, TBytes(tr))
            // **A string's characters are the library's cursor over its bytes**, reached without
            // being named: the compiler knows `chars_of` and the library declares it, which is the
            // same division `print` is built on.
            else if name == "chars" then
                library_result_call(cx, span, "chars_of", TExpr(span, TBytes(tr)))
            else if name == "copy" then
                cx.err(span, "'copy' is a method of 'string' — call it with 'copy()', since it " +
                       "allocates and copies the bytes rather than naming what is already there")
            else lookup_trait_member(cx, span, tr, name, buf(), expected)
        Array(_, _) ->
            if name == "len" then TExpr(span, TLen(tr, usize_type(word_bits(cx))))
            else lookup_trait_member(cx, span, tr, name, buf(), expected)
        Slice(_, _) ->
            if name == "len" then TExpr(span, TLen(tr, usize_type(word_bits(cx))))
            else lookup_trait_member(cx, span, tr, name, buf(), expected)
        // A vector's `len` is its lane count, which is part of its type -- so this is a constant
        // folded here rather than anything read.
        Vector(lanes, _) ->
            if name == "len" then
                TExpr(span, TIntLit(from_int(long(lanes)), usize_type(word_bits(cx))))
            else lookup_trait_member(cx, span, tr, name, buf(), expected)
        // Everything about the object is behind `get()`, including whether there still is one.
        Weak(inner) ->
            cx.err(span, s"a ${type_show(rt)} may be gone, so nothing is read off one directly — " +
                   s"'get()' hands back 'Option[&${type_show(*inner)}]', and '$name' is read off " +
                   "what is inside it")
        _ -> lookup_trait_member(cx, span, tr, name, buf(), expected)
end field_expr

// A struct's field, by the index the declaration gave it. A tuple's parts are named for their
// positions, so `t.0` arrives here as an ordinary field selection.
private struct_field(cx: &Analyzer, span: Span, tr: TExpr, d: &StructType, name: string,
                     expected: Option[Type]) -> TExpr
    val idx = d.field_index(name)

    if idx >= 0 then
        if !field_visible(cx, d.base, name) then
            return cx.err(span, s"'$name' is private to the file that declares " +
                          s"'${module_show(d.base)}'")

        // Whatever qualifier the field was declared with stays in the struct's field list and comes
        // off here: reading a register yields an ordinary value.
        return TExpr(span, TField(tr, idx, unqualified(d.fields.at(usize(idx)).1)))

    // A **compile-time constant** selects a part by its value, which is what makes one written line
    // cover parts of different types inside a `for const`. It is the same selection `t.0` already
    // is, with the position arriving as a constant rather than as a literal -- so an index past the
    // end is the same complaint, said about the name that carried it.
    val selected = const_selector(cx.subst, name)

    if is_tuple(d) then
        if selected.is_some()
            val v = selected.unwrap()

            if v >= 0 && usize(v) < d.fields.len()
                return TExpr(span, TField(tr, v, d.fields.at(usize(v)).1))

            return cx.err(span, s"'$name' is $v here, and ${type_show(Struct(d))} has " +
                          s"${quantity(d.fields.len(), "part")} — the parts are numbered from 0")
        end if

        if all_digits(name) then
            return cx.err(span, s"${type_show(Struct(d))} has " +
                          s"${quantity(d.fields.len(), "part")}, so there is no '.$name' — the " +
                          "parts are numbered from 0")

        return lookup_trait_member(cx, span, tr, name, buf(), expected)

    // A struct's fields have names, and a number does not address one -- so a compile-time index is
    // refused here rather than falling through to a complaint about a missing property, which would
    // send a reader looking for a field they never meant to name.
    if all_digits(name) || selected.is_some() then
        return cx.err(span, s"'$name' is a compile-time index, and ${type_show(Struct(d))} is a " +
                      "struct — its fields are reached by name, and a position addresses the parts " +
                      "of a tuple")

    lookup_trait_member(cx, span, tr, name, buf(), expected)
end struct_field

// The value a selector stands for where it names a **compile-time constant** rather than a field --
// the loop variable of a `for const`, or a value parameter.
//
// A local of the same name is not consulted and does not shadow this, because a selector is not a
// name being read: `t.i` asks for a part of `t`, and what a variable called `i` happens to hold at
// run time could not be the answer. That is the one place this differs from an `Ident`, which asks
// the scope first for exactly the opposite reason.
const_selector(subst: Buf[Binding], name: string) -> Option[int]
    bound_type(subst, name) match
        Some(ConstArg(v, ty)) -> underlying(*ty) match
            Integer(_, _, _) -> v.to_long().and_then(n -> if n >= -2147483648 && n <= 2147483647 then
                    Some(int(n))
                else
                    None)
            _ -> None
        _ -> None
end const_selector

private all_digits(name: string) -> bool
    val b = name.bytes

    if b.len == 0 then return false

    for i in 0..<b.len
        if b[i] < u8('0') || b[i] > u8('9') then return false

    true
end all_digits

// Whether a field the reader named is one their file may read.
//
// **`private` is file-private**, so a field declared private is read only inside the file that
// declares the struct -- the same rule every other declaration follows.
field_visible(cx: &Analyzer, base: string, field: string) -> bool
    val decl = cx.an.tables.types.get(base)

    if decl.is_none() then return true

    decl.unwrap().kind match
        StructOf(d) ->
            for i in 0..<d.fields.len()
                val f = d.fields.at(i)

                if f.name == field then
                    return f.vis match
                        File -> decl.unwrap().scope.src.name == cx.scope.src.name
                        _ -> true

            true
        _ -> true
end field_visible

// A member read off a **type** rather than off a value: an enum's variant, a static property, and
// the refusals that say which of the readings a name standing for a type could have meant.
//
// A name in front of the dot that is not a value is not a receiver, so reading it as one reports the
// **type** as an undefined name and says nothing about the member -- which is the complaint a reader
// can do least with. Each arm below names the member instead and says where it is reached from.
private type_member(cx: &Analyzer, span: Span, receiver: Expr, name: string,
                    expected: Option[Type]) -> Option[TExpr]
    val written = dotted_name_written(cx, receiver)

    if written.is_none() then return None

    val w = written.unwrap()
    val key = lookup_type_key(cx.an, cx.scope, w)

    // **A static property is an associated function the reader writes no `()` after**, so it is
    // analyzed as the call it is and nothing below this line has to know it exists. That is the
    // whole of the lowering: `recv_mode()` already answers `None` for one, so every pass that
    // dispatches on a receiver has been treating it as associated since it was parsed.
    if key.is_some() && static_property_at(cx.an, key.unwrap(), name) then
        return associated_call(cx, span, receiver, name, buf(), expected)

    if key.is_some()
        val decl = cx.an.tables.types.get(key.unwrap())

        if decl.is_none() then return None

        decl.unwrap().kind match
            EnumOf(_) -> return Some(enum_member(cx, span, key.unwrap(), w, name, expected))
            StructOf(_) -> return Some(struct_type_member(cx, span, key.unwrap(), w, name))
            TraitOf(d) -> return Some(trait_type_member(cx, span, key.unwrap(), d, name))
            TypeOf(d) ->
                return Some(constrained_member(cx, span, key.unwrap(), d, receiver, w, name,
                                               expected))
            // A C type carries nothing to read under its own name, so the ordinary reading of the
            // receiver is left to answer.
            _ -> return None
    end if

    // **`A.len` -- how many types a pack stands for**, which is a compile-time integer and folds
    // into its use as one. `len` and no other name, because a pack is not a value and has no other
    // member to read.
    val stood = bound_type(cx.subst, w)

    if stood.is_some()
        stood.unwrap() match
            Pack(elems) ->
                if name == "len" then
                    return Some(TExpr(span, TIntLit(from_int(long(elems.len())),
                                                    usize_type(word_bits(cx)))))

                return Some(cx.err(span, s"'..$w' is a type pack, and 'len' — how many types it " +
                                   "stands for — is the whole of what one offers; there is no " +
                                   s"'$w.$name'"))
            _ -> ()
    end if

    // A type that is not one of the declaration tables: a type parameter, the `Self` a member's body
    // is analyzed under, or a built-in an `impl` was written for.
    val subject = subject_named(cx, receiver)

    if subject.is_none() then return None

    Some(bare_type_member(cx, span, receiver, subject.unwrap(), w, name, expected))
end type_member

// Whether the type filed under this key declares a **static property** of that name -- the one
// associated member a read resolves rather than being told to put parentheses after.
private static_property_at(a: &Analysis, key: string, name: string) -> bool
    val m = member_at(a, key, name)

    m.is_some() && m.unwrap().is_static
end static_property_at

// A struct's name with a member selected from it. What a type offers under its own name is an
// associated function, so each of the other three readings is told where it is reached from.
private struct_type_member(cx: &Analyzer, span: Span, key: string, written: string,
                           name: string) -> TExpr
    val m = member_at(cx.an, key, name)

    if m.is_none() then
        return cx.err(span, s"type '${module_show(key)}' has no member '$name' — and " +
                      s"'${module_show(key)}' is a type, not a value")

    val decl = m.unwrap()

    if decl.is_property then
        return cx.err(span, s"'$name' is a property of '${module_show(key)}' — read it on a " +
                      s"value, as 'value.$name'")

    if decl.receiver.is_some() then
        return cx.err(span, s"'$name' is a method of '${module_show(key)}' — call it on a value, " +
                      s"as 'value.$name(…)'")

    cx.err(span, s"'$name' is an associated function of '${module_show(key)}' — call it with " +
           s"'$written.$name(…)'")
end struct_type_member

// A trait's name with a member selected from it, which is the same shape of mistake one type over.
// A trait is not a value and is not a type on its own: what its members are reached through is a
// value of an implementing type, or a trait object.
private trait_type_member(cx: &Analyzer, span: Span, key: string, d: TraitDecl,
                          name: string) -> TExpr
    val m = trait_method(d, name)

    if m.is_none() then
        return cx.err(span, s"'${module_show(key)}' is a trait, not a value, and declares no " +
                      s"member '$name'")

    if m.unwrap().is_property then
        return cx.err(span, s"'$name' is a property of the trait '${module_show(key)}' — read it " +
                      s"on a value of a type that implements '${module_show(key)}', or on a " +
                      s"'&${module_show(key)}'")

    cx.err(span, s"'$name' is a member of the trait '${module_show(key)}' — call it on a value of " +
           s"a type that implements '${module_show(key)}', or on a '&${module_show(key)}'")
end trait_type_member

// A constrained subtype's name with a member selected from it. What one offers under its own name is
// spelled with `::`, so a range that has one is told about the attributes rather than only that the
// member is missing.
private constrained_member(cx: &Analyzer, span: Span, key: string, d: TypeDecl, receiver: Expr,
                           written: string, name: string, expected: Option[Type]) -> TExpr
    val stood = concrete_instance(cx.an, key)

    // An alias reaches this case because it is declared in the same table, and none of what follows
    // is about it: it has no range to be asked about and no cast to be told to use. What it has is
    // whatever the base has, so the complaint is the base's, said about the name that was written.
    if is_plain_alias(d) && stood.is_some() then
        return bare_type_member(cx, span, receiver, stood.unwrap(), written, name, expected)

    var ranged = false

    if stood.is_some()
        stood.unwrap() match
            Constrained(c) ->
                underlying(c.base) match
                    Integer(_, _, _) -> ranged = c.lo.is_some()
                    _ -> ()
            _ -> ()
    end if

    val m = member_at(cx.an, key, name)

    if m.is_some()
        val decl = m.unwrap()

        if decl.is_property then
            return cx.err(span, s"'$name' is a property of '${module_show(key)}' — read it on a " +
                          s"value, as 'value.$name'")

        if decl.receiver.is_some() then
            return cx.err(span, s"'$name' is a method of '${module_show(key)}' — call it on a " +
                          s"value, as 'value.$name(…)'")

        return cx.err(span, s"'$name' is an associated function of '${module_show(key)}' — call " +
                      s"it with '$written.$name(…)'")
    end if

    if name == "try"
        val without = if ranged then
                          s", and '$written::Valid(x)' asks the question without trapping"
                      else ""

        return cx.err(span, s"'${module_show(key)}' is a constrained type and has no 'try': a " +
                      "value outside its range is a mistake in the code that produced it rather " +
                      s"than a condition to handle, so '$written(x)' checks it and traps$without")
    end if

    val offered = if ranged then
                      s" — what a constrained type offers under its own name is written with " +
                      s"'::': '$written::First', '$written::Last', '$written::Valid(x)', " +
                      s"'$written::Succ(x)', '$written::Pred(x)'"
                  else ""

    cx.err(span, s"'${module_show(key)}' is a type, not a value, and has no member " +
           s"'$name'$offered")
end constrained_member

// A type in the position a value would be read from, where the type is not one of the declaration
// tables: a type parameter, the `Self` a member's body is analyzed under, or a built-in an `impl`
// was written for.
private bare_type_member(cx: &Analyzer, span: Span, receiver: Expr, subject: Type, written: string,
                         name: string, expected: Option[Type]) -> TExpr
    subject match
        Abstract(_, bounds) -> bound_type_member(cx, span, subject, bounds, written, name)
        _ ->
            val found = member_key(cx.an, subject, name)
            val m = member_at(cx.an, found.0, name)

            if m.is_none() then
                return cx.err(span, s"'$written' is a type, not a value, and has no associated " +
                              s"function '$name'")

            val decl = m.unwrap()

            if decl.is_static
                val read = associated_call(cx, span, receiver, name, buf(), expected)

                return if read.is_some() then read.unwrap() else bad_expr(span)
            end if

            if decl.recv_mode().is_none() then
                return cx.err(span, s"'$name' is an associated function of " +
                              s"'${type_show(subject)}' — call it with '$written.$name()'")

            cx.err(span, s"'$name' is reached on a value of ${type_show(subject)}, and '$written' " +
                   "is the type itself")
end bare_type_member

// A variant named through its enum -- `Colour.Red`.
private enum_member(cx: &Analyzer, span: Span, key: string, written: string, name: string,
                    expected: Option[Type]) -> TExpr
    // **A generic enum has no single instantiation for its name to stand for**, so the position is
    // what says which one is meant -- exactly as it does for the bare name. A nullary variant
    // carries nothing to solve from, so where the position says nothing there is nothing to say.
    val settled = variant_from_expected(cx, name, expected)

    if settled.is_some() then
        return TExpr(span, TEnumNew(settled.unwrap().0, settled.unwrap().1, buf()))

    val inst = cx.an.tables.enum_insts.get(instance_key(key, buf()))

    if inst.is_none() then
        return cx.err(span, s"'$written' takes type arguments, so a variant of it is named " +
                      "through the type at those arguments")

    val en = inst.unwrap()

    en match
        Enum(d) ->
            val v = d.variant(name)

            if v.is_none() then
                return cx.err(span, s"'${module_show(key)}' has no variant '$name'")

            if v.unwrap().carries then
                return cx.err(span, s"'$name' carries " +
                              s"${quantity(v.unwrap().fields.len(), "field")}, so it is " +
                              "constructed with them")

            TExpr(span, TEnumNew(en, v.unwrap(), buf()))
        _ -> bad_expr(span)
end enum_member

// A `Field` chain that spells a module path rather than a member read.
private through_module(cx: &Analyzer, receiver: Expr, name: string) -> Option[string]
    val dotted = module_path(receiver, name)

    if dotted.is_none() then return None

    val written = dotted.unwrap()

    if cx.an.tables.consts.has(module_key_of(cx, written)) then return dotted
    if lookup_value_key(cx, cx.an.tables.consts, written).is_some() then return dotted
    if lookup_value_key(cx, cx.an.tables.vals, written).is_some() then return dotted
    if lookup_value_key(cx, cx.an.tables.extern_vars, written).is_some() then return dotted

    None
end through_module

private module_key_of(cx: &Analyzer, written: string) -> string =
    module_qualify(cx.scope.module_name, written)

private module_path(receiver: Expr, name: string) -> Option[string] = *receiver.kind match
    Ident(head) -> Some(s"$head.$name")
    Field(inner, mid) -> module_path(inner, mid).map(head -> s"$head.$name")
    _ -> None

// A bare variant reached through the module that declares it. A file that wrote `import <module>`
// bound the module's own name and none of the names in it, so `inflate.BadBlock` is the whole of
// what it can write -- the enum need not be named, and often is not exported under a name worth
// writing.
//
// The module says which enum is meant, so the variant is read against that instantiation rather
// than against whatever the position expected.
private module_variant(cx: &Analyzer, span: Span, receiver: Expr, name: string) -> Option[TExpr]
    val head = dotted_name_written(cx, receiver)

    if head.is_none() then return None

    val owner = module_owner(cx, head.unwrap())

    if owner.is_none() then return None

    for i in 0..<cx.an.tables.enum_insts.len()
        val t = cx.an.tables.enum_insts.at(i)

        t match
            Enum(d) ->
                if module_of(d.base) == owner.unwrap() && reachable_key(cx.an, d.base, cx.scope) &&
                        d.variant(name).is_some() then
                    return Some(variant_expr(cx, span, name, Some(t)))
            _ -> ()

    None
end module_variant

// The module a written head names: the one an import bound the name to, or the path itself read
// through the package the file sits in. Nothing where no module answers to it.
private module_owner(cx: &Analyzer, head: string) -> Option[string]
    val bound = cx.scope.imports.module_as(head)

    if bound.is_some() && cx.an.tables.has_module(bound.unwrap()) then return bound

    val here = in_package(cx.an, cx.scope.pkg, head)

    if cx.an.tables.has_module(here) then Some(here) else None
end module_owner

// A `Field` chain that spells a dotted path, where nothing binds its head as a value -- a value of
// that name is a member read and never a path.
//
// **A dotted path is one name to the type grammar**, so `sdl3.PixelFormat` names a type the way
// `PixelFormat` does; a file that wrote `import <module>` bound the module's name and none of the
// names in it, so this is the only spelling it has for them.
dotted_name_written(cx: &Analyzer, e: Expr) -> Option[string] = *e.kind match
    Ident(head) -> if cx.lookup(head).is_none() then Some(head) else None
    Field(inner, name) -> dotted_name_written(cx, inner).map(head -> s"$head.$name")
    _ -> None

// **What a type declares of its own is looked up through `lookup_trait_member`**, which reads the
// member tables the `impl` blocks and the type declarations were hoisted into. It lives in
// `member_call.sysl`, beside the call form that shares its lookup.

// `base with { bg = 9 }` -- `base` again, with the fields named in the braces changed.
//
// **The whole of the form is one desugaring**, and nothing else about it is defined anywhere:
//
// ```
// var tmp = base
// tmp.bg = 9
// tmp
// ```
//
// so a struct's `invariant` is re-checked because a field assignment re-checks it, a field another
// module keeps `private` is refused because an assignment refuses it, a literal needs no width
// suffix because it is read against the field's type, and a settable property runs its setter
// because `p.count = v` is a call. The base is evaluated once, however many fields change.
//
// **The one thing the desugaring gets wrong on its own is a base that is not a struct**, and it gets
// it wrong silently: `var tmp = p` where `p` is a `&Style` binds a second reference to one object,
// so the writes reach every other holder rather than a copy. That is the reading this form exists to
// avoid, so it is refused before the desugaring is built -- with the parenthesised spelling that
// does copy, since `*p with { … }` is `*(p with { … })` and would be refused again.
with_expr(cx: &Analyzer, span: Span, base: Expr, fields: Buf[WithField],
          expected: Option[Type]) -> TExpr
    // Asked speculatively: a base that does not analyze at all has a complaint of its own, and the
    // desugaring below reaches it in its own position rather than having it reported here.
    val mark = cx.an.sandboxed()
    val probed = texpr_type(type_expr(cx, base, None))

    cx.an.release(mark)

    if probed != Unknown
        repr(probed) match
            Struct(d) ->
                if is_tuple(d) then
                    return cx.err(span, "a tuple's parts are named for their positions rather " +
                                  "than by a name 'with' could write, so a changed one is " +
                                  "spelled by rebuilding it — '(t.0, 9)'")
            Ref(inner, _) -> return not_a_struct(cx, span, *inner, "a counted reference to")
            Ptr(inner) -> return not_a_struct(cx, span, *inner, "a pointer to")
            other ->
                return cx.err(span, "'with' copies a struct and changes some of its fields, and " +
                              s"'${type_show(other)}' is not a struct")
    end if

    // Written twice, the second write is what the value would carry and the first is dead -- which
    // no reader means, and which the desugaring would carry out in silence.
    for i in 0..<fields.len()
        for j in 0..<i
            if fields.at(j).name == fields.at(i).name then
                return cx.err(fields.at(i).span, s"'${fields.at(i).name}' is changed twice in one " +
                              "'with', so the first change is thrown away — write the value it " +
                              "should end with, once")

    val tmp = s"${ModuleSep}with"
    var stmts: Buf[Stmt] = buf()

    stmts.push(stmt(span, VarDecl(tmp, None, Some(base), File, None, None)))

    for i in 0..<fields.len()
        val f = fields.at(i)
        val place = expr(f.span, Field(expr(f.span, Ident(tmp)), f.name))

        stmts.push(stmt(f.span, ExprStmt(expr(f.span, Assign("=", place, f.value)))))

    stmts.push(stmt(span, ExprStmt(expr(span, Ident(tmp)))))
    type_expr(cx, expr(span, Block(stmts)), expected)
end with_expr

// The refusal for a base that reaches a struct without being one. It names the copy, because the
// copy is the whole difference between what was written and what it would have meant.
private not_a_struct(cx: &Analyzer, span: Span, inner: Type, what: string) -> TExpr =
    cx.err(span, s"'with' copies a struct, and this is $what one — writing through it would " +
           s"change the '${type_show(inner)}' every other holder can see. Copy what it points at " +
           "first, as '(*base) with { … }'")
