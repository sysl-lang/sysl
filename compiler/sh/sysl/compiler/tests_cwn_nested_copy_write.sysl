module sh.sysl.compiler
@tests

// **A write made by a closure nested inside another reaches a copy of a copy.** The inner closure's
// capture is the outer closure's own copy of the variable, so a read of the variable after the outer
// closure is a program expecting the write to have reached it -- refused, at the write, as it is for
// a closure written directly in the body. A counter the inner closure reads back, with the variable
// outside left alone, is accepted, and so is the outer closure's own local.
//
// An inner closure that holds the variable by reference (a local closure called where it is
// written) writes the OUTER closure's copy instead, which is lost in its turn where the outer
// closure is kept: refused naming both closures, and accepted where every closure on the way holds
// the variable by reference, where nothing reads it afterwards, or where what is captured is a `&T`.
//
// The helpers are `tests_enm_enum_run.sysl`'s, and `crm_counted` from `tests_crm_closure_ref_mode.sysl`.

private const cwn_calls: string = "var kept: Option[&Fn() -> unit] = None\n\nshare(f: &Fn() -> unit)\n    kept = Some(f)\n    f()\n\ncall(f: &Fn() -> unit)\n    kept = Some(f)\n    f()\n\n"

private cwn_used_after(name: string) -> string =
    s", so it holds a copy of '$name' — so '+=' would reach that copy " +
    "rather than the variable it came from, and the variable is used afterwards as though it had"

private cwn_refused_once(text: string, want: string)
    val said = enm_err(text)

    assert(enm_says(said, want), said)

    val first = said.index_of(want).unwrap()

    assert(said[first + want.bytes.len..<said.bytes.len].index_of(want).is_none(), said)
end cwn_refused_once

@test("a nested closure's counter, the variable read after the outer closure: refused")
cwn_read_after_outer()
    if !enm_ready() then return

    cwn_refused_once(cwn_calls + raw"""
        main()
            var n = 0
            share(() -> call(() ->
                n += 1
                print(n)))
            print(n)
        """, cwn_used_after("n"))
end cwn_read_after_outer

@test("three closures deep, the variable read after the outermost: refused")
cwn_three_deep()
    if !enm_ready() then return

    cwn_refused_once(cwn_calls + raw"""
        main()
            var n = 0
            share(() -> share(() -> call(() ->
                n += 1
                print(n))))
            print(n)
        """, cwn_used_after("n"))
end cwn_three_deep

@test("the inner closure held in the outer one's 'val', the variable read after: refused")
cwn_inner_in_a_val()
    if !enm_ready() then return

    cwn_refused_once(cwn_calls + raw"""
        main()
            var n = 0
            share(() ->
                var g = () ->
                    n += 1
                    print(n)
                g())
            print(n)
        """, cwn_used_after("n"))
end cwn_inner_in_a_val

@test("the variable read inside the outer closure after the inner one: refused, as before")
cwn_read_inside_outer()
    if !enm_ready() then return

    cwn_refused_once(cwn_calls + raw"""
        main()
            var n = 0
            share(() ->
                call(() ->
                    n += 1
                    print(n))
                print(n))
        """, cwn_used_after("n"))
end cwn_read_inside_outer

@test("a nested write nothing reads back: refused, as before")
cwn_unread()
    if !enm_ready() then return

    cwn_refused_once(cwn_calls + raw"""
        main()
            var n = 0
            share(() -> call(() -> n += 1))
            print(n)
        """, ", so it holds a copy of 'n' — so '+=' would reach that copy " +
             "rather than the variable it came from, and nothing in the closure reads it back")
end cwn_unread

@test("a nested counter with the variable outside left alone, and the outer closure's own local")
cwn_accepted()
    if !enm_ready() then return

    assert_eq(enm_ran(cwn_calls + raw"""
        main()
            var n = 0
            print(n)
            share(() -> call(() ->
                n += 1
                print(n)))
            share(() ->
                var k = 10
                call(() ->
                    k += 1
                    print(k)))
            val p: &int = 0
            share(() -> call(() -> *p += 5))
            print(*p)
        """), "0\n1\n11\n5\n")
end cwn_accepted

// -- an inner closure that holds the variable by reference ------------------------------------------

private const cwn_once: string = "once(f: &Fn() -> unit) = f()\n\n"

private const cwn_around: string =
    "this closure writes through to a closure it is written in, and that one captures by value, since "

// The program runs on the counted heap, printing `want` and leaving no count behind.
private cwn_prints(text: string, want: string)
    if !enm_ready() then return

    val out = crm_counted(text)

    assert_eq(out.0, want)
    assert_eq(out.1, "")
end cwn_prints

@test("an inner closure's write to the kept outer closure's copy names both closures, and is said once")
cwn_names_both()
    if !enm_ready() then return

    cwn_refused_once(cwn_calls + raw"""
        main()
            var n = 0
            share(() ->
                var g = () ->
                    n += 1
                    print(n)
                g())
            print(n)
        """, cwn_around)
end cwn_names_both

@test("the outer closure borrowed too: the write reaches the variable, which reads 1 after")
cwn_outer_by_ref()
    cwn_prints(cwn_once + raw"""
        main()
            var n = 0
            once(() ->
                var g = () ->
                    n += 1
                    print(n)
                g())
            print(n)
        """, "1\n1\n")
end cwn_outer_by_ref

@test("three deep, only the outermost kept: refused once, naming the closures around the write")
cwn_three_deep_outermost_kept()
    if !enm_ready() then return

    val text = cwn_calls + cwn_once + raw"""
        main()
            var n = 0
            share(() -> once(() ->
                var g = () ->
                    n += 1
                    print(n)
                g()))
            print(n)
        """

    cwn_refused_once(text, cwn_used_after("n"))
    cwn_refused_once(text, cwn_around)
end cwn_three_deep_outermost_kept

@test("three deep, only the middle one kept: refused once")
cwn_three_deep_middle_kept()
    if !enm_ready() then return

    val text = cwn_calls + cwn_once + raw"""
        main()
            var n = 0
            once(() -> share(() ->
                var g = () ->
                    n += 1
                    print(n)
                g()))
            print(n)
        """

    cwn_refused_once(text, cwn_used_after("n"))
    cwn_refused_once(text, cwn_around)
end cwn_three_deep_middle_kept

@test("three deep, every closure borrowed: the write reaches the variable")
cwn_three_deep_all_by_ref()
    cwn_prints(cwn_once + raw"""
        main()
            var n = 0
            once(() -> once(() ->
                var g = () ->
                    n += 1
                    print(n)
                g()))
            print(n)
        """, "1\n1\n")
end cwn_three_deep_all_by_ref

@test("the inner closure writes in a loop, the outer closure kept, the variable read after: refused")
cwn_write_in_a_loop()
    if !enm_ready() then return

    cwn_refused_once(cwn_calls + raw"""
        main()
            var n = 0
            share(() ->
                var g = () ->
                    for i in 0..<3
                        n += i
                    print(n)
                g())
            print(n)
        """, cwn_used_after("n"))
end cwn_write_in_a_loop

@test("the outer closure kept, but nothing reads the variable after it: accepted, a counter")
cwn_not_read_after()
    cwn_prints(cwn_calls + raw"""
        main()
            var n = 0
            print(n)
            share(() ->
                var g = () ->
                    n += 1
                    print(n)
                g())
            kept = None
        """, "0\n1\n")
end cwn_not_read_after

@test("a '&int' captured, written through by the inner closure, the outer one kept: accepted")
cwn_through_a_reference()
    cwn_prints(cwn_calls + raw"""
        main()
            val n: &int = 0
            share(() ->
                var g = () ->
                    *n += 1
                    print(*n)
                g())
            print(*n)
            kept = None
        """, "1\n1\n")
end cwn_through_a_reference
