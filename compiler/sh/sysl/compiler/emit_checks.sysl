module sh.sysl.compiler

import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}
import sysl.text.Search

// **The seam between the analyzer and the lowering**: what a program has to be true of before any of
// it is emitted, over and above what typing it asked.
//
// Everything here reads the *typed tree* and none of it reads a body's meaning: each is a question
// about the program a compilation came to rather than about a line somebody wrote, which is why none
// of them can be answered where the declarations are. They run on the way to `emit-llvm` and nowhere
// else — `emit-typed` stops at the typed tree, so a program it prints is one none of these has been
// asked about.

// Everything a program is held to on the way to being lowered.
//
// **`check_exports` reads the tree this build is going to emit, which is the stripped one.** Reading
// the unstripped one made an `@export` in a `@tests` file a definition in every build. The two above
// it are deliberately not moved with it: both are about whether a body is *correct*, and a `@test`
// that does not compile is an error in a build that would never have run it.
post_analysis_checks(a: &Analysis, p: TProgram, own: Buf[string]) -> Promotions =
    checks_before_lowering(a, p, own, strip_tests(p))

// The same checks for the one build that keeps its tests. **`tests_only` rather than `strip_tests` is
// the whole of the difference**: what `check_exports_emitted` asks is about the emitted program's
// symbol table, so what it has to read is whatever *this* compilation emits -- and a test build is
// the one build where a `@tests` file's `@export` is a definition rather than something dropped.
post_analysis_checks_of_tests(a: &Analysis, p: TProgram, own: Buf[string]) -> Promotions =
    checks_before_lowering(a, p, own, tests_only(p, own))

private checks_before_lowering(a: &Analysis, p: TProgram, own: Buf[string],
                               emitted: TProgram) -> Promotions
    // **The escapes go first**, because what they answer with is not a verdict but a decision the
    // lowering needs: which of a body's arrays live in a buffer rather than in its frame.
    val promotions = check_escapes(a, p)

    check_tail_calls(a, p.funcs)
    check_tail_jumps(a, p)
    check_shared_storage(a, p)
    check_exports_emitted(a, emitted, own)
    check_general_regs(a, emitted)
    promotions
end checks_before_lowering

// -- `become` -----------------------------------------------------------------------------------------

// Every refusal a program's `become` statements earn.
//
// `tail_calls.sysl` recognizes a function's calls to *itself* and lowers them as a jump back to its
// own entry. That is a real optimization and this is not: what a chain of calls to **different**
// functions needs is a tail call that is *guaranteed*, because the whole program is one chain of them
// and an un-eliminated call is an immediate stack overflow rather than a slowdown. So the rules below
// are refusals rather than conditions on an optimization.
check_tail_jumps(a: &Analysis, p: TProgram)
    for i in 0..<p.funcs.len()
        check_becomes(a, p, p.funcs.at(i))
end check_tail_jumps

private check_becomes(a: &Analysis, p: TProgram, f: TFunc)
    val scope = func_home(a, f.name)

    // A `defer` anywhere in the body puts every `become` under it out of reach, exactly as it puts a
    // tail position out of reach: the deferred statement runs on the way out of the scope, and the
    // jump *is* the way out. Bounded to the body rather than to the block, which is coarser than the
    // tail-call rule and deliberately so — a refusal that is easy to state is worth more here,
    // because what a reader does about it is the same either way.
    val deferred = has_defer(f)
    val an = a
    val prog = p
    val fn = f

    walk_block_stmts(f.body, stmt_walk(false, s -> one_become(an, prog, fn, scope, deferred, s)))
end check_becomes

private has_defer(f: TFunc) -> bool
    val found: &Counted = Counted(0)

    walk_block_stmts(f.body, stmt_walk(false, s -> mark_defer(found, s)))
    found.n > 0
end has_defer

private mark_defer(found: &Counted, s: TStmt) = s match
    TDefer(_) -> found.n = 1
    _ -> ()

private one_become(a: &Analysis, p: TProgram, f: TFunc, scope: Scope, deferred: bool, s: TStmt)
    s match
        TBecome(call) -> become_refusal(a, p, f, scope, deferred, call)
        _ -> ()
end one_become

private become_refusal(a: &Analysis, p: TProgram, f: TFunc, scope: Scope, deferred: bool,
                       call: TExpr)
    val at = call.span

    if f.variadic
        refuse_become(a, scope, at, "this function is variadic — the tail a first call was passed " +
                      "lives in the frame being replaced, and nothing can rebind it")
        return

    if !f.ensures.is_empty()
        refuse_become(a, scope, at, "this function has an 'ensures', which is checked when a call " +
                      "returns — a 'become' never returns, so the postcondition would go unchecked")
        return

    if f.variant.is_some()
        refuse_become(a, scope, at, "this function has a 'decreases' measure, which is checked " +
                      "against the frame it was taken in — and that frame is the one being replaced")
        return

    if deferred
        refuse_become(a, scope, at, become_past_a_defer())
        return

    if counted_params(f)
        refuse_become(a, scope, at, s"'${qualified_name(f.name)}' takes a counted value — the frame's " +
                      "own references are let go before the jump, so an argument read out of one of " +
                      "them would outlive nothing. Pass what the callee needs through a raw pointer " +
                      "or a value that carries no count")
        return

    *call.kind match
        TCall(name, _, _, _) ->
            if is_extern_name(p, name)
                refuse_become(a, scope, at, s"'${qualified_name(name)}' is an 'extern' — its frame is " +
                              "C's, and nothing here knows what C does with one")
                return

            func_named(p, name) match
                None ->
                    refuse_become(a, scope, at, s"'${qualified_name(name)}' has no body here, so there " +
                                  "is no frame to replace this one with")
                Some(g) ->
                    become_mismatch(a, f, g) match
                        Some(why) -> refuse_become(a, scope, at, why)
                        None -> become_shape(a, scope, at, f)

        // A call through a function address is the case threaded dispatch is *for* — the next
        // handler comes out of a table. Nothing names the callee, so the prototype it is held to is
        // the pointer's own type, which the analyzer already checked the arguments against.
        TCallPtr(_, _, _, _) -> become_shape(a, scope, at, f)
        _ ->
            refuse_become(a, scope, at, "what follows it is not a call — 'return' is what hands a " +
                          "value back without replacing anything")
end become_refusal

private refuse_become(a: &Analysis, scope: Scope, at: Span, why: string) =
    a.fault(scope, at, become_refused(why))

// What a refused `become` is told, around the reason.
become_refused(why: string) -> string = s"'become' replaces this frame with the call's, and $why"

// Why a `become` cannot stand in a function that defers anything -- which a `become` written inside
// a deferred statement is told where it is read, that statement never being scheduled.
become_past_a_defer() -> string =
    "this function has a 'defer', which runs on the way out of its scope — and the jump is the " +
        "way out, so there would be nowhere left to run it"

private counted_params(f: TFunc) -> bool
    for param in f.params
        if contains_counted(param.1) then return true

    false
end counted_params

private is_extern_name(p: TProgram, name: string) -> bool
    for i in 0..<p.externs.len()
        if p.externs.at(i).name == name then return true

    false
end is_extern_name

private func_named(p: TProgram, name: string) -> Option[TFunc]
    for i in 0..<p.funcs.len()
        if p.funcs.at(i).name == name then return Some(p.funcs.at(i))

    None
end func_named

// Why one function's frame cannot be replaced with another's, or nothing where it can. The prototype
// is the whole of it: same parameter types in order, same result.
private become_mismatch(a: &Analysis, f: TFunc, g: TFunc) -> Option[string]
    if g.variadic
        return Some(s"'${qualified_name(g.name)}' is variadic and this function is not, so the two do " +
                    "not have the same shape")

    if f.params.len() != g.params.len()
        return Some(s"'${qualified_name(g.name)}' takes ${g.params.len()} " +
                    s"argument${plural_s(g.params.len())} and this function takes " +
                    s"${f.params.len()} — a frame can only be replaced by one of the same shape")

    if !param_types_agree(f.params, g.params)
        return Some(s"'${qualified_name(g.name)}' takes ${param_type_list(f.params)} where this " +
                    s"function takes ${param_type_list(g.params)} — a frame can only be replaced " +
                    "by one of the same shape")

    if !type_eq(f.ret_ty, g.ret_ty)
        return Some(s"'${qualified_name(g.name)}' answers ${type_show(g.ret_ty)} and this function " +
                    s"answers ${type_show(f.ret_ty)} — the result comes back the way this frame's " +
                    "caller is waiting for it")

    None
end become_mismatch

// What is true of the enclosing function alone, whichever callee it names.
//
// A **large result** travels through a pointer the caller supplied, and a frame being replaced is a
// frame whose caller is somebody else.
private become_shape(a: &Analysis, scope: Scope, at: Span, f: TFunc)
    if !layout_for(a.tables.target).indirect(f.ret_ty) then return

    refuse_become(a, scope, at, s"this function answers ${type_show(f.ret_ty)}, which comes back " +
                  "through a pointer its caller supplied — a result that large is not something a " +
                  "replaced frame can hand on. Answer something that fits in a register, or a '&T'")
end become_shape

private param_types_agree(a: Buf[(string, Type)], b: Buf[(string, Type)]) -> bool
    for i in 0..<a.len()
        if !type_eq(a.at(i).1, b.at(i).1) then return false

    true
end param_types_agree

private param_type_list(ps: Buf[(string, Type)]) -> string
    var out = ""

    for i in 0..<ps.len()
        if i > 0 then out = out + ", "

        out = out + type_show(ps.at(i).1)

    out
end param_type_list

private plural_s(n: usize) -> string = if n == 1 then "" else "s"

// -- `@export`, over the whole program -----------------------------------------------------------------

// The two things about `@export` that only the whole program can answer: whether the parameters and
// result are types C can spell, and whether two exports claim one symbol.
//
// Both are about the **emitted** symbol table, which is why the exports are the ones this build
// contributes rather than every one the tree declares: an export in a dependency module the program
// never reaches is not emitted, so holding it to a shape C can spell would be refusing a build over
// a definition that build does not contain.
check_exports_emitted(a: &Analysis, p: TProgram, own: Buf[string])
    val exported = exported_funcs(p, own)

    for item in exported
        export_signature(a, item)

    export_duplicates(a, exported)
    export_names(a, exported)
    export_storage(a, p, exported)
end check_exports_emitted

// An exported function reaching **computed** module storage on a build with nowhere to fill it.
//
// There are three builds with three answers: one with an entry point lays the `val`s down at the top
// of it, a `.syslib` defers every function reaching one to the program that links it, and a C archive
// registers a constructor on the platform's pre-`main` list. **What is left, and all this refuses, is
// a C archive for a freestanding target**: there is no loader on bare metal, so a constructor would be
// a function nobody calls and the storage would read whatever the image left -- a silent wrong answer
// rather than a link error.
//
// A `val` whose initializer is constant data is not looked at, being laid straight into the object
// file -- the rule C already has for a static-storage initializer. The walk is the reachability one,
// so the storage may be several calls down and the function that is named is the one exported.
private export_storage(a: &Analysis, p: TProgram, exported: Buf[TFunc])
    val t = a.tables.target

    if !p.c_artifact || t.runs_initializers() || exported.is_empty() then return

    var computed: Buf[string] = buf()

    for i in 0..<p.vals.len()
        if p.vals.at(i).computed then computed.push(p.vals.at(i).symbol)

    if computed.is_empty() then return

    for i in 0..<exported.len()
        val f = exported.at(i)
        val reached = vals_reached_from(p, f)

        var named: Buf[string] = buf()

        for item in reached
            if holds_string(computed, item) then named.push(s"'${qualified_name(item)}'")

        if !named.is_empty()
            a.fault(func_home(a, f.name), f.span,
                    s"'${qualified_name(f.name)}' is exported and reaches " +
                    s"${joined_list(sorted_names(named))}, which is module storage an initializer " +
                    "fills before the program's own statements run. This artifact has no entry point " +
                    s"to fill it in, and '${t.name}' is freestanding — there is no loader to run a " +
                    "constructor either, so the function would read whatever the image left. Build " +
                    "for a hosted target, where the storage is filled before any export can run, or " +
                    "make the initializer constant data, which is laid straight into the object file")
end export_storage

// **A bare image that starts at a symbol of its own and never runs `main`** -- the same refusal as
// `export_storage`, for a linked image rather than an archive. Computed storage is filled by `main`;
// `image_storage_unfilled` says when nothing will call it, and then every way into the image's sysl
// code that reaches such storage is refused, naming the entry. A way in is what code outside the
// program's own calls can start: the entry itself where sysl defines it, an `@export`, and a function
// a `@section` or a calling convention places for something else to jump to. The walk is the
// reachability one, so the storage may be several calls down.
check_image_storage(a: &Analysis, p: TProgram, own: Buf[string], entry: string)
    if p.c_artifact || !image_storage_unfilled(entry, p) then return

    var computed: Buf[string] = buf()

    for i in 0..<p.vals.len()
        if p.vals.at(i).computed then computed.push(p.vals.at(i).symbol)

    if computed.is_empty() then return

    val t = a.tables.target
    val ways = image_ways_in(p, own, entry)

    for f in ways
        val reached = vals_reached_from(p, f)

        var named: Buf[string] = buf()

        for k in 0..<reached.len()
            if holds_string(computed, reached.at(k)) then named.push(s"'${qualified_name(reached.at(k))}'")

        if named.is_empty() then continue

        var how = "is placed for code outside the program to enter"

        if f.exported.is_some() then how = "is exported"
        if f.name == entry || f.exported == Some(entry) then how = "starts the image"

        a.fault(func_home(a, f.name), f.span,
                s"'${qualified_name(f.name)}' $how and reaches ${joined_list(sorted_names(named))}, " +
                "which is module storage an initializer fills before the program's own statements " +
                s"run. 'main' is what fills it, and this image starts at '$entry' " +
                s"('targets.${t.name}.entry'), which never calls 'main' — so the function would read " +
                "whatever the image left. Build the value where it is used instead: a local, a " +
                "struct built once and handed to what reads it, or, for a table of functions, a " +
                "'match' that dispatches on the index; or make the initializer constant data, which " +
                "is laid straight into the image")
end check_image_storage

// The module whose `extern`s are the calls `sysl.fs` makes of a filesystem, and which a program on a
// target with no C library answers itself.
private const filesystem_hooks: string = "sysl.fs.sys"

// **A hook of `sysl.fs.sys` the program reaches, on a target the library answers none of them for.**
//
// On a hosted target `sysl.fs.hosted` supplies every hook over the C library. A freestanding target
// has no C library, so that module is never taken there and the program answers the hooks with an
// `@export` per symbol -- and one it reached and left unanswered would otherwise surface at the link
// as an undefined symbol named nowhere in the program's source. So the hooks still unanswered after
// pruning are refused here, all of them in one sentence. The walk is the reachability one: a program
// that never reaches `sysl.fs` reaches none of its hooks and is not asked about any.
check_filesystem_hooks(a: &Analysis, p: TProgram)
    val t = a.tables.target

    if os_hosted(t.os) then return

    var missing: Buf[string] = buf()

    for x in p.externs
        if module_of(x.name) != filesystem_hooks || exported_here(p, x.symbol) then continue
        if !holds_string(missing, s"'${x.symbol}'") then missing.push(s"'${x.symbol}'")

    if missing.is_empty() || p.funcs.is_empty() then return

    // The report has no position, the complaint being about the program as a whole; a function of
    // `sysl.fs` the program reached only orders it among the others.
    var at = p.funcs.at(0)

    for f in p.funcs
        if module_of(f.name).starts_with("sysl.fs")
            at = f
            break
        end if

    a.fault_unplaced(func_home(a, at.name), at.span,
            s"this program reaches 'sysl.fs', and '${t.name}' has no C library under it for the " +
            "standard library to answer a filesystem with, so the program answers it: define " +
            s"${joined_list(sorted_names(missing))} with '@export', each taking what its 'extern' " +
            "in 'sysl.fs.sys' declares and answering zero or the code of an 'IoError'")
end check_filesystem_hooks

// **A specifier the program reaches that only C's `snprintf` can apply, on a target with no C library
// to supply one.**
//
// An integer specifier is rendered by the library's `sysl.fmt.format_int` on every target, so what
// still goes to C is a float conversion -- a specifier or a plain hole of a float, which
// `sysl.str.float` renders -- and a `%s` over a string, and on a freestanding target either
// would otherwise surface at the link as an undefined `snprintf` named nowhere in the program's
// source. So each one reached is refused here, at the specifier, naming it and the target. The walk
// is the reachability one, so a specifier in a function nothing reaches is not asked about.
check_c_formatting(a: &Analysis, p: TProgram)
    val t = a.tables.target

    if os_hosted(t.os) then return

    for f in p.funcs
        var found: Buf[TExpr] = buf()
        val sink = &found

        walk_stmts(f.body.stmts, expr_walk(false, (e) -> note_c_format(e, sink)))

        if f.body.result.is_some() then
            walk_texpr(f.body.result.unwrap(), expr_walk(false, (e) -> note_c_format(e, sink)))

        for e in found.view()
            *e.kind match
                TFormat(_, spec, _) ->
                    a.fault(func_home(a, f.name), e.span,
                            s"'$spec' is applied by C's 'snprintf', and '${t.name}' has no C library " +
                            "under it to supply one — only an integer specifier is rendered without " +
                            "C. Render the value another way: a plain hole of a string needs no C")
                TStr(arg) ->
                    a.fault(func_home(a, f.name), e.span,
                            s"a plain hole of ${type_show(texpr_type(arg))} is rendered by C's " +
                            s"'snprintf', and '${t.name}' has no C library under it to supply one — " +
                            "only an integer is rendered without C. Render the value another way: " +
                            "a plain hole of an integer or a string needs no C")
                _ -> ()
    end for
end check_c_formatting

private note_c_format(e: TExpr, sink: *Buf[TExpr])
    *e.kind match
        TFormat(_, _, _) -> sink.push(e)
        TStr(arg) -> if is_float_type(texpr_type(arg)) then sink.push(e)
        _ -> ()

// Whether a value of `t` is rendered through C's `snprintf` when it is a plain hole.
private is_float_type(t: Type) -> bool = underlying(t) match
    Floating(_, _) -> true
    _ -> false

// Whether a function of the program defines `symbol` with an `@export`.
private exported_here(p: TProgram, symbol: string) -> bool
    for f in p.funcs
        if f.exported == Some(symbol) then return true

    false
end exported_here

// The functions code outside the program's own calls can start, on an image entered at `entry`.
private image_ways_in(p: TProgram, own: Buf[string], entry: string) -> Buf[TFunc]
    val points = entry_points(p, own)

    var out: Buf[TFunc] = buf()

    for f in points
        if f.conv.is_some() || f.exported.is_some() || f.section.is_some() then out.push(f)

    // The entry, where sysl defines it under its own name: a root-module function's symbol is its name.
    var listed = false

    for item in out
        if item.name == entry then listed = true

    if !listed
        for i in 0..<p.funcs.len()
            if p.funcs.at(i).name == entry then out.push(p.funcs.at(i))

    out
end image_ways_in

// Names joined the way a sentence lists them after a colon: with commas and nothing else.
private joined_list(xs: Buf[string]) -> string
    var out = ""

    for i in 0..<xs.len()
        if i > 0 then out = out + ", "

        out = out + xs.at(i)

    out
end joined_list

// Two things in one header answering to one name.
//
// **This is the property `@export("...")` on a struct takes away, so it is the property this hands
// back.** A derived name is the mangled instantiation, which is unique because a module path is in
// it; a chosen one is a claim the author makes, and two of them may agree -- or one may land on
// another struct's derived name. Both are the same mistake, and it is `export_duplicates` read at
// the other kind of declaration.
//
// **A function is in the list too, because C has one namespace and not two.** At file scope a
// `typedef` name and a function name are both ordinary identifiers, so a header carrying `typedef
// struct { ... } add;` beside `add add(...)` is not two declarations that happen to rhyme -- it is
// one name declared twice, and the consumer's compiler says so. Nothing on the sysl side suggests
// it: the two are a type and a function, which collide nowhere here.
//
// The types are the ones that actually **reach the header** rather than every struct in the program,
// because a name is only claimed where the type is in an exported signature: two modules may each
// declare a `Point` and name it, and while only one of them is reachable there is nothing to
// collide.
//
// A symbol claimed by two *functions* is left to `export_duplicates`, whose sentence is about the
// linker and is the better one for that case -- hence a group having to hold a type to be reported
// here.
private export_names(a: &Analysis, exported: Buf[TFunc])
    val types = header_aggregates(exported)

    var names: Buf[string] = buf()
    var what: Buf[Buf[string]] = buf()

    for i in 0..<types.len()
        claim(&names, &what, c_name(types.at(i)), s"the type '${type_show(types.at(i))}'")

    var typed: Buf[string] = buf()

    for item in names
        typed.push(item)

    for f in exported
        claim(&names, &what, f.exported.unwrap(), s"the function '${qualified_name(f.name)}'")

    val order = sorted_names(names)

    for name in order
        if holds_string(typed, name)
            val group = claimants_of(names, what, name)

            // The collision is in the header rather than at either declaration, so it is told with
            // no position, as the reference tells it; the first export only orders it in the report.
            if group.len() > 1
                val at = exported.at(0)

                a.fault_unplaced(func_home(a, at.name), at.span,
                        s"'$name' is the C name of ${joined_and(sorted_names(group))} — a header " +
                        "declares both in one namespace, so a C project including it would see " +
                        "the name twice. Give each the name it should carry, '@export(\"...\")'")
end export_names

private claim(names: *Buf[string], what: *Buf[Buf[string]], name: string, said: string)
    for i in 0..<names.len()
        if names.at(i) == name
            var group = what.at(i)

            group.push(said)
            what.set(i, group)
            return

    var group: Buf[string] = buf()

    group.push(said)
    names.push(name)
    what.push(group)
end claim

private claimants_of(names: Buf[string], what: Buf[Buf[string]], name: string) -> Buf[string]
    for i in 0..<names.len()
        if names.at(i) == name then return what.at(i)

    buf()
end claimants_of

// A parameter or a result C has no way to spell.
//
// A scalar and a pointer are one register on every machine sysl lowers for. An aggregate is the
// opposite: each ABI says which registers a struct arrives in, LLVM applies no rule of its own, and
// passing one by value would be a corrupt call rather than a link error — which is why it is
// refused here instead of lowered hopefully.
private export_signature(a: &Analysis, f: TFunc)
    val scope = func_home(a, f.name)

    for p in f.params
        if !export_crosses(p.1)
            a.fault(scope, f.span, s"'${p.0}' of the exported '${qualified_name(f.name)}' is " +
                    s"${type_show(p.1)}, which C has no way to spell — an exported function takes " +
                    s"${export_spellable()}. ${export_advice(p.1)}")

    if !no_value(f.ret_ty) && !export_crosses(f.ret_ty)
        a.fault(scope, f.span, s"the exported '${qualified_name(f.name)}' returns " +
                s"${type_show(f.ret_ty)}, which C has no way to spell — an exported function " +
                s"returns that or nothing at all. ${export_advice(f.ret_ty)}")
end export_signature

// Two definitions exporting one symbol.
//
// The linker would report this itself, as a duplicate definition, naming a symbol that appears in no
// sysl file. Saying it here costs one grouping and names both declarations, which is the difference
// between a diagnostic and an archaeology exercise.
//
// **An overload exported under its own name is not a claimant**: it was refused where its `@export`
// is written (`check_export`, "C has no overloading"), and reporting the same pair again as two
// definitions of one symbol would be one mistake told twice, the second time at the wrong line.
private export_duplicates(a: &Analysis, exported: Buf[TFunc])
    var seen: Buf[string] = buf()

    for i in 0..<exported.len()
        val symbol = exported.at(i).exported.unwrap()

        if refused_overload_export(a, exported.at(i).name) then continue

        if !holds_string(seen, symbol)
            seen.push(symbol)

            var claimants: Buf[string] = buf()
            var first = exported.at(i)

            for item in exported
                if item.exported.unwrap() == symbol &&
                   !refused_overload_export(a, item.name)
                    claimants.push(s"'${qualified_name(item.name)}'")

            if claimants.len() > 1
                a.fault(func_home(a, first.name), first.span,
                        s"'$symbol' is exported by ${joined_and(sorted_names(claimants))} — one " +
                        "symbol is one definition, and the linker has no way to tell which was meant")
end export_duplicates

// Whether a function is an overload exported under its own name, which `check_export` refuses.
private refused_overload_export(a: &Analysis, name: string) -> bool
    val f = a.tables.funcs.get(name)

    if f.is_none() || f.unwrap().decl.exported.is_none() then return false

    f.unwrap().decl.exported.unwrap().symbol.is_none() && overload_keys(a, overload_plain(name)).len() > 1
end refused_overload_export

private sorted_names(xs: Buf[string]) -> Buf[string]
    var out: Buf[string] = buf()

    for item in xs
        out.push(item)

    for i in 0..<out.len()
        for j in (i + 1)..<out.len()
            if out.at(j) < out.at(i)
                val t = out.at(i)

                out.set(i, out.at(j))
                out.set(j, t)

    out
end sorted_names

private joined_and(xs: Buf[string]) -> string
    var out = ""

    for i in 0..<xs.len()
        if i > 0 then out = out + " and "

        out = out + xs.at(i)

    out
end joined_and

// The shapes an exported signature may take, in the sentence a refusal quotes.
export_spellable() -> string =
    "an integer, a float, a 'bool', a 'char', a pointer, a function pointer, a simple enum, or a " +
    "struct built out of those"

// Whether a type crosses to C **as itself**, which is a narrower question than whether it has a
// meaning over there.
//
// **An array is not a parameter or a result in C at all**, though it is a perfectly good field: C
// decays an array parameter to a pointer, so there is no prototype that passes one by value.
export_crosses(t: Type) -> bool = repr(t) match
    Array(_, _) -> false
    other -> export_carried(other)

// The same question at a **field**, which admits the one thing a signature does not.
export_carried(t: Type) -> bool = repr(t) match
    Integer(_, _, _) -> true
    Fixed(_, _, _) -> true
    Floating(_, _) -> true
    Bool -> true
    Char -> true
    CFn(_, _) -> true
    Ptr(_) -> !erased(repr(t))
    Constrained(d) -> export_carried(d.base)
    Struct(d) -> all_carried(d.stored())
    Array(_, elem) -> export_carried(*elem)

    // A simple enum **is** its underlying integer, so it crosses as one. A data enum is a tag beside
    // a union of payloads sysl laid out, which is not what a C union is.
    Enum(d) -> d.simple
    _ -> false

private all_carried(fields: Buf[(string, Type)]) -> bool
    for item in fields
        if !export_carried(item.1) then return false

    true
end all_carried

// The one line of help the refusal can honestly give, which differs by what was written. Anything
// with no specific advice gets none rather than a guess.
export_advice(t: Type) -> string = repr(t) match
    Slice(_, _) -> slice_advice()
    Str -> slice_advice()
    Ref(_, _) -> counted_advice()
    Weak(_) -> counted_advice()
    Trait(_, _, _) -> "A trait object is a value and a method table together. Export one function " +
                      "per implementation, or take a function pointer"
    Ptr(_) ->
        if erased(repr(t))
            "A pointer to a trait is the value and its method table together, so it is two words " +
            "rather than the one every other pointer is. Point at the concrete type instead"
        else ""
    Struct(d) -> struct_advice(t, d)
    Array(_, elem) ->
        if !export_carried(*elem)
            s"its element is ${type_show(*elem)}, which is what C has no declaration for — the " +
            s"array around it is fine. ${export_advice(*elem)}"
        else
            "C decays an array parameter to a pointer, so there is no prototype that passes one by " +
            "value. Wrap it in a struct, which is how C hands an array over as a value and lays out " +
            "identically, or take a pointer to its first element and a length"
    Enum(d) ->
        if !d.simple
            "A data enum is a tag beside a union of the payloads sysl laid out, which is not the " +
            "shape a C union has. Export the tag and the payload as separate parameters, or a " +
            "pointer to the whole"
        else ""
    _ -> ""

private slice_advice() -> string =
    "A slice is an address and a length, so C takes them as two parameters — a pointer and a " +
    "'usize' — which is the shape its own string and buffer functions already have"

private counted_advice() -> string =
    "A counted reference has a header C would have to know the layout of. Hand out a raw pointer " +
    "and keep the counted one on this side"

// An aggregate itself crosses, so arriving here means one of its **fields** does not — and naming
// the field is the whole of what the reader needs, since the declaration they are looking at does
// not mention it.
private struct_advice(t: Type, d: &StructType) -> string
    val fields = d.stored()

    for item in fields
        if !export_carried(item.1)
            return s"'${item.0}' of ${type_show(t)} is ${type_show(item.1)}, which " +
                   s"is what C has no declaration for — the aggregate around it is fine. " +
                   s"${export_advice(item.1)}"

    ""
end struct_advice

// Whether an exported `type` may be declared as a C `typedef` of `t`.
//
// **A scalar or a pointer, and nothing with a layout.** An aggregate has a name of its own in the
// header already -- `@export` on the struct chooses it -- so a second name for it would be a
// `typedef` the header had no reason to write; a slice, a counted reference and a data enum are the
// shapes no C declaration spells at all. A function pointer is a pointer, and an alias of an alias
// is asked about what it stands for.
typedefable(t: Type) -> bool = t match
    Constrained(d) -> typedefable(d.base)
    _ -> repr(t) match
        Integer(_, _, _) -> true
        Fixed(_, _, _) -> true
        Floating(_, _) -> true
        Bool -> true
        Char -> true
        Constrained(d) -> typedefable(d.base)
        Ptr(_) -> !erased(repr(t))
        CFn(_, _) -> true
        _ -> false

// What to write instead of a `typedef` C could not spell -- there is always something.
typedef_advice(t: Type) -> string = repr(t) match
    Struct(_) -> "Put '@export(\"...\")' above the struct itself, which names it in the header, or " +
                 "export a pointer to it"
    Enum(d) ->
        if d.simple then "A simple enum is spelled as the integer it is, so export an alias of that integer"
        else typedef_fallback(t)
    Array(_, _) -> "Wrap the array in a struct and name that, which is how C hands one over as a value"
    _ -> typedef_fallback(t)

private typedef_fallback(t: Type) -> string
    val said = export_advice(t)

    if said != "" then said else "Export an alias of a scalar or a pointer"
end typedef_fallback
