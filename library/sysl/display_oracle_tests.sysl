module sysl
@tests

// GENERATED by scripts/float_display_oracle.rs -- do not edit by hand. Every expected string is
// what Rust's `format!("{}", x)` writes for the same bits at the same width: the shortest digits
// that read back at that width, written out positionally, with no exponent and no trailing `.0`.

private rust64(bits: u64, want: string) = assert_eq(str(real.from_bits(bits)), want)

private rust32(bits: u32, want: string) = assert_eq(str(f32.from_bits(bits)), want)

@test("a real renders as Rust's Display renders it, part 1")
fdr_real_1()
