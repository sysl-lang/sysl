module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.process.capture
import sysl.fs.is_file
import sysl.text.{join, Search}

// The one machine-side question a package is allowed to ask: **where does this library live here?**
//
// `reference/packages.md § No build scripts, ever` refuses build scripts, and nothing here is one.
// The package contributes a **name** -- `sdl3` -- and the compiler asks a well-known tool what that
// name means on this machine, in exactly the way it already asks clang what a `c const` measures to.
// What a package may say is unchanged: *which* library it needs, never where it is.
//
// **Absent is not failed.** A machine with no `pkg-config`, or one whose `pkg-config` has never
// heard of the module, is a machine exactly where it was before this existed: the declared
// requirement goes unanswered and the build stops with a sentence naming it. The probe can
// make a build succeed that would have failed; it can never make one fail that would have succeeded.

// What `pkg-config` answered for one module: the flags its headers are compiled with, and the flags
// its library is linked with.
//
// **Kept as the tokens the tool printed rather than parsed into directories**, which is deliberate.
// `--cflags` is not only `-I`: SDL prints `-D_THREAD_SAFE` on some platforms and cairo's expands to
// twelve include directories across five projects, and `--libs` carries `-L`, `-l` and the
// `-Wl,-rpath` that decides whether a dynamically-linked program finds its library at *run* time.
struct PkgAnswer
    cflags: Buf[string]
    ldflags: Buf[string]

    // Each `-l` name the link takes from its static archive, paired with the archive's path
    // (`static_link.sysl`). Empty for a dynamic build.
    archives: Buf[(string, string)]
end PkgAnswer

// What a compilation that asked nothing was told, which is what a build with no `pkg_config` block
// anywhere hands the toolchain.
no_probe() -> PkgAnswer = PkgAnswer(buf(), buf(), buf())

// The tool, by name only. `pkg-config` on this machine is commonly `pkgconf` wearing the traditional
// name, and the two are compatible in the two queries asked here -- so looking for a second spelling
// would be looking for a program nobody has under a name nobody types.
private const PkgTool: string = "pkg-config"

// Whether the tool is on the PATH at all.
//
// **Separate from a module query because it is the difference between two diagnostics**: *this
// machine has no pkg-config* is something the reader can act on with a `brew install`, where
// *pkg-config does not know 'sdl3'* is about a library that is not installed. Answering both with
// the second sentence would send somebody looking for a library they already have.
pkg_config_available() -> bool
    var none: Buf[string] = buf()

    none.push("--version")
    ran(none).is_some()
end pkg_config_available

// What this machine says about a `.pc` module, or why it could not say.
pkg_config_query(pc: string) -> Result[PkgAnswer, string]
    if !pkg_config_available() then return Err(s"there is no '$PkgTool' on this machine to ask")

    var exists: Buf[string] = buf()

    exists.push("--exists")
    exists.push(pc)

    if ran(exists).is_none() then return Err(s"'$PkgTool' knows no '$pc'")

    val c = flags_of(pc, "--cflags")?
    val l = flags_of(pc, "--libs")?

    Ok(PkgAnswer(c, l, buf()))
end pkg_config_query

// What a library that is to come from its archive needs besides `pkg_config_query`'s answer:
// `--static --libs`, which adds the libraries it links **privately** -- a shared library carries
// those inside itself and an archive does not -- and `libdir`, since `pkg-config` prints no `-L` for a
// directory the linker searches anyway, and that is exactly where the archive then is.
pkg_config_query_static(pc: string) -> Result[StaticAnswer, string]
    val plain = pkg_config_query(pc)?
    val whole = flags_of_all(pc, ["--static", "--libs"])?
    val dir = flags_of_all(pc, ["--variable=libdir"])?

    Ok(StaticAnswer(plain.ldflags, whole, if dir.is_empty() then None else Some(dir.at(0))))
end pkg_config_query_static

// One query's output, split the way a shell would split it.
//
// **A path holding a space is not handled and is refused rather than mangled.** pkg-config quotes
// such a path in its output, and a splitter that ignored the quoting would hand clang two arguments
// that are each half a directory -- which fails as a missing header, naming neither the space nor
// this line. The reader is told to say the path themselves, which is a flag that takes it whole.
private flags_of(pc: string, what: string) -> Result[Buf[string], string] = flags_of_all(pc, [what])

private flags_of_all(pc: string, whats: []string) -> Result[Buf[string], string]
    var args: Buf[string] = buf()

    for i in 0..<whats.len
        args.push(whats[i])

    args.push(pc)

    val what = join(whats, " ")

    val said = ran(args) match
        None -> return Err(s"'$PkgTool $what $pc' failed")
        Some(text) -> text

    if said.index_of("\"").is_some() || said.index_of("'").is_some()
        return Err(s"'$PkgTool' answered for '$pc' with a quoted path, which is one holding a " +
            "space — say where it is on the command line instead, which takes a path whole")

    Ok(words_of(said))
end flags_of_all

// What the tool printed, where it succeeded.
private ran(args: Buf[string]) -> Option[string]
    capture(PkgTool, args.view(), "", [], true) match
        Err(_) -> None
        Ok(out) -> if out.status.ok() then Some(out.text) else None

// A run of text broken at whitespace, which is all the splitting a flag list needs once a quoted
// path has been refused above.
private words_of(text: string) -> Buf[string]
    var out: Buf[string] = buf()
    var start: usize = 0
    var i: usize = 0

    while i < text.bytes.len
        if is_flag_space(text.bytes[i])
            if i > start then out.push(text[start..<i])

            start = i + 1

        i += 1

    if text.bytes.len > start then out.push(text[start..<text.bytes.len])

    out
end words_of

private is_flag_space(b: u8) -> bool =
    b == u8(' ') || b == u8('\t') || b == u8('\r') || b == u8('\n')

// One package's declared need of an installed library: who declared it, the `.pc` name, and the
// prose the refusal quotes back at whoever has to install it.
struct LibNeed
    who: string
    pc: string
    why: string
end LibNeed

// What this machine says about the libraries the packages named, or the one line the build stops on.
//
// **Asked only for the host.** `pkg-config` answers for the machine it runs on. A cross build's
// headers and archives are the *target's*, and there is no sense in which this machine's
// `/opt/homebrew` belongs in a compilation for a Cortex-M -- so a target that is not this machine
// probes nothing and says so, since a freestanding program that compiled against the host's headers
// would link and be wrong somewhere nobody can see.
//
// **One at a time, and the two failures are told apart**, because they send the reader to different
// places: a machine with no `pkg-config` is one `brew install pkgconf` away and has nothing to do
// with the library, where a `pkg-config` that does not know the module means the library itself is
// not installed.
// **A supplied name is an answer, and stops the probe.** `--include-path <name>=<dir>` satisfies
// this exactly as it satisfies a header requirement and takes precedence over anything a probe would
// have found, which is what keeps a hermetic build, a hand-built prefix and a machine with a broken
// `.pc` from being hostage to whatever happens to be installed.
//
// **A library `mode` marks is linked from its archive with everything `--static` names**, since an
// archive carries none of the libraries it links privately. Only a library a list NAMED must have
// one; `"static"` over the whole build takes one where there is one, and where no library the program
// links directly has one the link is the dynamic one, `--libs` and all.
probe_libs(needs: Buf[LibNeed], t: Target, mode: LinkMode = LinkDynamic) -> Result[PkgAnswer, string]
    var out = PkgAnswer(buf(), buf(), buf())
    var wanted: Buf[LibNeed] = buf()

    for item in needs
        if !supplied_include(item.pc) then wanted.push(item)

    if wanted.is_empty() then return Ok(out)

    if t.name != host_target().name
        val first = wanted.at(0)

        return Err(s"${first.who} needs the '${first.pc}' library and this is a build for " +
            s"'${t.name}' rather than for this machine, so there is nothing to ask where it is — " +
            s"${first.why}. Say where it is with '--include-path ${first.pc}=<dir>' and " +
            "'--link-path <dir>'")
    end if

    for need in wanted
        val answer = pkg_config_query(need.pc) match
            Ok(found) -> found
            Err(why) ->
                return Err(s"${need.who} needs the '${need.pc}' library and $why — " +
                    s"${need.why}. " +
                    (if pkg_config_available() then "Install it, or say where it is with " +
                         s"'--include-path ${need.pc}=<dir>' and '--link-path <dir>'"
                     else "Install pkg-config and sysl will ask it where the library is — 'brew " +
                          "install pkgconf', or your system's package of that name — or say " +
                          s"where it is with '--include-path ${need.pc}=<dir>' and '--link-path <dir>'"))

        for j in 0..<answer.cflags.len()
            out.cflags.push(answer.cflags.at(j))

        var ldflags = answer.ldflags

        if link_marks(mode, need.pc)
            val required = mode match
                LinkOnly(_) -> true
                _ -> false

            val whole = pkg_config_query_static(need.pc)?
            val found = static_archives(need.pc, whole, link_paths(), (f) -> is_file(f), required)?

            if !found.is_empty()
                ldflags = whole.whole

                val names = sort_names(archive_names(found))

                for j in 0..<names.len()
                    for k in 0..<found.len()
                        if found.at(k).0 == names.at(j)
                            link_note(s"static: -l${names.at(j)} is ${found.at(k).1}")
                            out.archives.push(found.at(k))
                        end if
            end if

            val kept = static_kept(whole, found)

            for j in 0..<kept.len()
                link_note(static_kept_note(need.pc, kept.at(j), static_searched(whole, link_paths())))
        end if

        for j in 0..<ldflags.len()
            out.ldflags.push(ldflags.at(j))

    Ok(out)
end probe_libs

// The `-L` a probe answered with, which go **before** everything they could affect.
//
// A search path is not an input being scanned in turn -- it is where the scan looks -- and `-L` is
// order-sensitive on GNU ld, which does not apply one to a `-l` that appeared before it.
probed_search_flags(a: PkgAnswer) -> Buf[string]
    var out: Buf[string] = buf()

    for ldflag in a.ldflags
        if ldflag.starts_with("-L") then out.push(ldflag)

    out
end probed_search_flags

// The rest of what a probe answered -- the `-l` for the library itself, and the `-Wl,-rpath` that
// decides whether a dynamically-linked program finds it at run time. This half goes at the **end**
// of the link line: a `-l` placed above the objects that need it is discarded by any linker
// resolving an archive in one pass.
probed_link_flags(a: PkgAnswer) -> Buf[string]
    var out: Buf[string] = buf()

    for ldflag in a.ldflags
        if !ldflag.starts_with("-L") then out.push(ldflag)

    out
end probed_link_flags
