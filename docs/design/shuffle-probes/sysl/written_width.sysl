// reference/vectors.md § "A kernel over an array" says a written type argument at a call is refused,
// so a kernel whose parameters are all slices cannot be given its width. On 0.3.13 it can:
// this prints `3 12 0`. The paragraph is stale, and the shuffle work should correct it.

scale[const W: usize](xs: []const f32, out: []f32, by: f32)
    val v: <W>f32 = xs.load(0)

    out.store(0, v * by)

val src: [8]f32 = [1, 2, 3, 4, 5, 6, 7, 8]
var out: [8]f32

scale[4](src[..], out[..], 3)

print(out[0], out[3], out[4])
