module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.text.Search
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture

// A member that declares type parameters of its own, ported from the reference's
// `GenericMethodRunTests.scala` case for case (`reference/generics.md § Members and associated
// functions`).
//
// The type's parameters and the member's are fixed from two different places: the receiver already
// says what the type's arguments are, while the member's own are solved at the call, from what it is
// passed and from the type the context expects -- exactly as a generic free function's are. A type
// with no parameters at all may still have a member with some.
//
// **Every output, message and location here was read out of the reference compiler** (0.0.152) on
// the same single-file program. Where the reference marks only the member's name with carets and
// this compiler marks the whole call, the line and column still agree, and that is what is asserted.

// -- the harness ----------------------------------------------------------------------------------

private gmr_ready() -> bool
    if std_root().is_err()
        print("skipped: the standard module's source is not on this machine")
        return false
    end if

    if !clang_available()
        print("skipped: there is no clang on this machine")
        return false
    end if

    true
end gmr_ready

// What a one-file program PRINTS, built fresh and run, so no run cache stands between the two.
private gmr_ran(text: string) -> string
    val root = make_temp_dir("sysl-gmr").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", text).unwrap()

    val exe = s"$root/built"

    build_native_program(s"$root/main.sysl", None, None, DefaultOptimization, Some(exe)) match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return failure_text(why)
        Ok(_) -> ()

    val said = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    said match
        Err(_) -> "the program that was built could not be run"
        Ok(out) -> out.text
end gmr_ran

// The LLVM text of a one-file program, or what refused it.
private gmr_ir(text: string) -> string
    val root = make_temp_dir("sysl-gmr-ir").unwrap()
    val src = s"$root/main.sysl"

    make_dir_all(root).unwrap()
    write_text(src, text).unwrap()

    val out = emit_llvm_text(src, None) match
        Err(why) -> why.message
        Ok(made) -> if made.report.is_empty() then made.text else analysis_report(made.report)

    remove_dir_all(root).unwrap_or(())
    out
end gmr_ir

// How many functions the module defines for `Box.one`, which is how many instantiations of it the
// program reached.
private gmr_defined(text: string) -> usize
    val ir = gmr_ir(text)
    var n: usize = 0
    var at: usize = 0

    loop
        val next = ir.index_of_from("\n", at)
        val stop = if next.is_some() then next.unwrap() else ir.bytes.len
        val line = ir[at..<stop]

        if line.starts_with("define") && line.contains("@Box.one.") then n += 1
        if next.is_none() then break

        at = stop + 1

    n
end gmr_defined

// What analysing a one-file program had to say, rendered as the command line renders it.
private gmr_said(text: string) -> string
    val root = make_temp_dir("sysl-gmr-err").unwrap()
    val src = s"$root/main.sysl"

    make_dir_all(root).unwrap()
    write_text(src, text).unwrap()

    val out = emit_llvm_text(src, None) match
        Err(why) -> why.message
        Ok(made) -> if made.report.is_empty() then "" else analysis_report(made.report)

    remove_dir_all(root).unwrap_or(())
    out
end gmr_said

// The program is refused with exactly this message, and nothing else, at this line and column.
private gmr_refused(text: string, message: string, at: string)
    val out = gmr_said(text)

    assert(out.starts_with(s"error: $message\n --> ") || out.starts_with(s"error: $message\n  --> "),
           s"expected 'error: $message' first, got: $out")
    assert(out.index_of(s"/main.sysl:$at\n").is_some(), s"expected it at main.sysl:$at, got: $out")
    assert_eq(out.count_of("error: "), 1)
end gmr_refused

// -- the member's own parameters come from the call -----------------------------------------------

@test("one parameter from one argument, at two different types")
gmr_one_parameter_at_two_types()
    if !gmr_ready() then return

    assert_eq(gmr_ran(raw"""
        struct Box[T]
            v: T
            keep[U](self, x: U) -> U = x
        var b = Box(1)
        print(b.keep(7))
        print(b.keep("s"))
        """), "7\ns\n")

@test("a type that declares none of its own may still have a member that does")
gmr_a_plain_type_with_a_generic_member()
    if !gmr_ready() then return

    assert_eq(gmr_ran(raw"""
        struct Counter
            n: int
            with[U](self, x: U) -> U = x
        var c = Counter(3)
        print(c.with(9))
        print(c.with("t"))
        """), "9\nt\n")

@test("two parameters, one from each argument")
gmr_two_parameters_one_from_each()
    if !gmr_ready() then return

    assert_eq(gmr_ran(raw"""
        struct Pair[A, B]
            a: A
            b: B
        struct Box[T]
            v: T
            of[U, V](self, x: U, y: V) -> Pair[U, V] = Pair(x, y)
        var b = Box(0)
        var p = b.of(4, "e")
        print(p.a)
        print(p.b)
        """), "4\ne\n")

@test("the type's parameter and the member's meet in one result")
gmr_both_lists_meet_in_one_result()
    if !gmr_ready() then return

    assert_eq(gmr_ran(raw"""
        struct Pair[A, B]
            a: A
            b: B
        struct Box[T]
            v: T
            with[U](self, x: U) -> Pair[T, U] = Pair(self.v, x)
        var b = Box(41)
        var p = b.with("hi")
        print(p.a)
        print(p.b)
        """), "41\nhi\n")

@test("a parameter under a composed type is solved from the element")
gmr_solved_from_the_element()
    if !gmr_ready() then return

    assert_eq(gmr_ran(raw"""
        struct Box[T]
            v: T
            first[U](self, xs: []U) -> U = xs[0]
        var a = [7, 8]
        var b = Box("k")
        print(b.first(a[0..<2]))
        """), "7\n")

// -- the type the context expects settles what the arguments do not -------------------------------

@test("an annotated variable fixes a parameter only the result mentions")
gmr_an_annotated_variable_fixes_it()
    if !gmr_ready() then return

    assert_eq(gmr_ran(raw"""
        struct Box[T]
            v: T
            zero[U](self) -> U = 0
        var b = Box(1)
        var x: i8 = b.zero()
        print(x)
        """), "0\n")

@test("and so does a result the parameter appears under")
gmr_a_result_the_parameter_is_under()
    if !gmr_ready() then return

    assert_eq(gmr_ran(raw"""
        struct Box[T]
            v: T
            make[U](self) -> Box[U] = Box(0)
        var b = Box(1)
        var c: Box[i16] = b.make()
        print(c.v)
        """), "0\n")

@test("a declared result of the calling function does it too")
gmr_a_declared_result_does_it()
    if !gmr_ready() then return

    assert_eq(gmr_ran(raw"""
        struct Box[T]
            v: T
            zero[U](self) -> U = 0
        small(b: Box[int]) -> i8 = b.zero()
        print(small(Box(1)))
        """), "0\n")

// -- the receiver still fixes the type's own parameters -------------------------------------------

@test("a result written 'Self' is the receiver's own type")
gmr_a_self_result()
    if !gmr_ready() then return

    assert_eq(gmr_ran(raw"""
        struct Box[T]
            v: T
            again[U](self, x: U) -> Self = self
        var b = Box(4)
        print(b.again("z").v)
        """), "4\n")

@test("a '*self' receiver reaches the type's own parameter")
gmr_a_pointer_receiver()
    if !gmr_ready() then return

    assert_eq(gmr_ran(raw"""
        struct Box[T]
            v: T
            swap[U](*self, x: U, y: T) -> U =
                self.v = y
                x
        var b = Box(1)
        print(b.swap(5, 2))
        print(b.v)
        """), "5\n2\n")

@test("a '&self' receiver does as well")
gmr_a_counted_receiver()
    if !gmr_ready() then return

    assert_eq(gmr_ran(raw"""
        struct Box[T]
            v: T
            both[U](&self, x: U) -> T = self.v
        var b: &Box[int] = Box(6)
        print(b.both("q"))
        """), "6\n")

// -- bounds hold, the type's and the member's alike -----------------------------------------------

@test("a member may bound its own parameter")
gmr_a_member_bounds_its_own()
    if !gmr_ready() then return

    assert_eq(gmr_ran(raw"""
        trait Rank
            rank(self) -> int
        struct P
            n: int
        impl Rank for P
            rank(self) -> int = self.n
        struct Box[T]
            v: T
            scored[U: Rank](self, x: U) -> int = x.rank()
        var b = Box("w")
        print(b.scored(P(12)))
        """), "12\n")

@test("the type's bound and the member's both hold inside one body")
gmr_both_bounds_hold()
    if !gmr_ready() then return

    assert_eq(gmr_ran(raw"""
        struct Box[T: Display]
            v: T
            both[U: Display](self, x: U) -> string = f"${self.v}-${x}"
        var b = Box(3)
        print(b.both("z"))
        """), "3-z\n")

@test("a bounded parameter may be handed on to something that asks the same")
gmr_a_bounded_parameter_handed_on()
    if !gmr_ready() then return

    assert_eq(gmr_ran(raw"""
        trait Rank
            rank(self) -> int
        struct P
            n: int
        impl Rank for P
            rank(self) -> int = self.n
        scored[T: Rank](x: T) -> int = x.rank()
        struct Box[T]
            v: T
            hand[U: Rank](self, x: U) -> int = scored(x)
        var b = Box(0)
        print(b.hand(P(5)))
        """), "5\n")

// -- it is an ordinary member in every other respect ----------------------------------------------

@test("an enum declares one the same way")
gmr_an_enum_declares_one()
    if !gmr_ready() then return

    assert_eq(gmr_ran(raw"""
        enum Opt[T]
            Empty
            Full(v: T)
            tagged[U](self, x: U) -> U = x
        var o: Opt[int] = Full(2)
        print(o.tagged(9))
        """), "9\n")

@test("one generic member calls another")
gmr_one_calls_another()
    if !gmr_ready() then return

    assert_eq(gmr_ran(raw"""
        struct Box[T]
            v: T
            one[U](self, x: U) -> U = x
            two[U](self, x: U) -> U = self.one(x)
        var b = Box(1)
        print(b.two(8))
        """), "8\n")

@test("a member calls a generic free function with its own parameter")
gmr_calls_a_generic_free_function()
    if !gmr_ready() then return

    assert_eq(gmr_ran(raw"""
        id[T](x: T) -> T = x
        struct Box[T]
            v: T
            thru[U](self, x: U) -> U = id(x)
        var b = Box(1)
        print(b.thru(6))
        """), "6\n")

@test("one recurses at a single instantiation")
gmr_recurses_at_one_instantiation()
    if !gmr_ready() then return

    assert_eq(gmr_ran(raw"""
        struct Box[T]
            v: T
            down[U](self, x: U, k: int) -> int =
                if k <= 0 then 0
                else self.down(x, k - 1) + 1
        var b = Box(1)
        print(b.down("a", 3))
        """), "3\n")

// An associated function is reached through the type's name, which settles the type's arguments
// (for a generic type, from the arguments the call passes) and leaves the member's own to the call.
@test("an associated function may declare parameters of its own")
gmr_an_associated_function_of_its_own()
    if !gmr_ready() then return

    assert_eq(gmr_ran(raw"""
        struct Counter
            n: int
            make[T](x: T) -> T = x
        print(Counter.make(5))
        print(Counter.make("m"))
        """), "5\nm\n")

@test("and on a generic type both lists are inferred from the call")
gmr_both_lists_from_the_call()
    if !gmr_ready() then return

    assert_eq(gmr_ran(raw"""
        struct Pair[A, B]
            a: A
            b: B
            of[U](x: A, y: B, z: U) -> U = z
        print(Pair.of(1, "s", true))
        """), "true\n")

@test("an enum's associated function does the same")
gmr_an_enums_associated_function()
    if !gmr_ready() then return

    assert_eq(gmr_ran(raw"""
        enum Opt[T]
            Empty
            Full(v: T)
            wrap[U](x: T, y: U) -> U = y
        print(Opt.wrap(1, "w"))
        """), "w\n")

@test("a non-generic member of the same type calls one")
gmr_a_plain_member_calls_one()
    if !gmr_ready() then return

    assert_eq(gmr_ran(raw"""
        struct Box[T]
            v: T
            one[U](self, x: U) -> U = x
            two(self) -> int = self.one(5)
        var b = Box("q")
        print(b.two())
        """), "5\n")

@test("a generic function calls one on a receiver whose type is still a parameter")
gmr_through_a_receiver_still_a_parameter()
    if !gmr_ready() then return

    assert_eq(gmr_ran(raw"""
        struct Box[T]
            v: T
            one[U](self, x: U) -> U = x
        thru[T](b: Box[T]) -> int = b.one(3)
        print(thru(Box("z")))
        """), "3\n")

@test("the member's own parameter may be held in a memory mode")
gmr_held_in_a_memory_mode()
