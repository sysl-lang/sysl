module sh.sysl.compiler
@tests

import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture
import sysl.text.{cstring, Search}

// A closure handed to a function whose answer is bound to a local, where that function puts it in a
// literal handed over as a view -- `wrap(t) = row([t])`, `row` keeping what it reads through its
// slice -- reaches `row` one step through a pointer. The answer summary of `wrap` has to see that
// `row`'s answer is made of what it reads through the view, or the closure is decided not to outlive
// the caller's frame: its `&Fn` box laid in the frame and its `var`s held by reference, both read
// after the frame is gone. A literal, a repeat, a view of an array local and a chain of such wrappers
// all hand over the same pointer.
//
// Skipped cells, and why: the tail-position form (`wrap(...)` as the body's result) asks what the
// function's own answer is made of, which already followed the literal; a closure literal handed to
// `row` directly is `through_of`'s question, tested in `tests_fbp_frame_box_read_through.sysl`.

// -- the harness ----------------------------------------------------------------------------------

private extern "setenv" fbl_c_setenv(name: *u8, value: *u8, overwrite: int) -> int
private extern "unsetenv" fbl_c_unsetenv(name: *u8) -> int

private struct FblRun
    out: string
    err: string
    hooks: usize
end FblRun

// The program built and run: on the counted heap, or with `flags` handed to clang.
private fbl_run(text: string, counted: bool, flags: string) -> FblRun
    val root = make_temp_dir("sysl-fbl").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", forms_imported(text)).unwrap()

    val exe = s"$root/built"

    if flags != ""
        val n = cstring("SYSL_EXTRA_CFLAGS")
        val v = cstring(flags)

        fbl_c_setenv(n.ptr, v.ptr, 1)
    end if

    force_alloc_counting(counted)

    val made = build_native_program(s"$root/main.sysl", None, None, DefaultOptimization, Some(exe))

    force_alloc_counting(false)

    if flags != ""
        val n = cstring("SYSL_EXTRA_CFLAGS")

        fbl_c_unsetenv(n.ptr)
    end if

    made match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return FblRun(failure_text(why), "", 0)
        Ok(_) -> ()

    val hooks = capture("nm", ["-u", exe], "", [], true) match
        Ok(o) -> o.text.count_of("__asan_report")
        Err(_) -> 0

    val ran = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    ran match
        Err(_) -> FblRun("could not be started", "", hooks)
        Ok(o) -> FblRun(o.text, o.err.unwrap_or(""), hooks)
end fbl_run

// The program printed `want` on the counted heap, and gave back everything it took.
private fbl_prints(text: string, want: string)
    if !enm_ready() then return

    val got = fbl_run(text, true, "")

    assert_eq(got.out, want)
    assert_eq(got.err, "")
end fbl_prints

// The program printed `want` under AddressSanitizer, instrumented, and nothing was reported.
private fbl_asan(text: string, want: string)
    if !enm_ready() then return

    val got = fbl_run(text, false, "-fsanitize=address -g")

    assert(got.hooks > 0, s"not instrumented: ${got.out}")
    assert_eq(got.out, want)
    assert_eq(got.err, "")
end fbl_asan

// How many closure boxes the IR of a program lays in a frame.
private fbl_frame_boxes(text: string) -> int
    val root = make_temp_dir("sysl-fbl").unwrap()

    write_text(s"$root/main.sysl", forms_imported(text)).unwrap()

    val ir = emit_llvm_text(s"$root/main.sysl", None) match
        Err(why) -> failure_text(why)
        Ok(made) -> if made.report.is_empty() then made.text else analysis_report(made.report)

    remove_dir_all(root).unwrap_or(())

    var n = 0

    for line in lines_of(ir).view()
        if line.contains("= alloca %arc.$closure") then n += 1

    n
end fbl_frame_boxes

// What every program below shares: a row that copies the taps it is handed out of its view.
private const fbl_row: string = raw"""
    import sysl.buf.{Buf, buf}

    struct Tap
        action: &Fn() -> unit

    struct Row
        kids: Buf[&Tap]

    row(children: []&Tap) -> &Row
        var b: Buf[&Tap] = buf()

        b.extend(children)
        Row(b)
    end row

    run(r: &Row)
        for k in r.kids
            (k.action)()

    main()
        val a = screen(10)
        val b = screen(70)
        run(a)
        run(b)
    """

private fbl_program(rest: string) -> string = fbl_row + rest

// -- the regression -------------------------------------------------------------------------------

// The shape syslUI's `centred(button(...))` has, bound to a `val` before it is returned. Before, the
// closure's box was laid in `screen`'s frame, and both taps printed garbage.
private const fbl_reduction: string = raw"""
    wrap(t: &Tap) -> &Row = row([t])

    screen(tag: int) -> &Row
        val body = wrap(Tap(() -> print(tag + 5)))

        body
    end screen
    """

@test("a closure put in a slice literal by a function whose answer is bound to a local is boxed on the heap")
fbl_literal_answer_bound()
    fbl_prints(fbl_program(fbl_reduction), "15\n75\n")

@test("and under AddressSanitizer: instrumented, and nothing read outside a live frame")
fbl_literal_answer_bound_under_asan()
    fbl_asan(fbl_program(fbl_reduction), "15\n75\n")

@test("its IR has no frame box for the closure")
fbl_literal_answer_bound_has_no_frame_box()
    if xvr_no_library() then return

    assert_eq(fbl_frame_boxes(fbl_program(fbl_reduction)), 0)

// -- the same pointer, other spellings ------------------------------------------------------------

@test("a captured var is held by value when the closure leaves through a slice literal")
fbl_var_capture_by_value()
    fbl_prints(fbl_program(raw"""
        wrap(t: &Tap) -> &Row = row([t])

        screen(tag: int) -> &Row
            var n = tag
            n += 5
            val body = wrap(Tap(() -> print(n)))

            body
        end screen
        """), "15\n75\n")

@test("a repeat literal hands its element over as a slice literal does")
fbl_repeat_literal()
    fbl_prints(fbl_program(raw"""
        wrap(t: &Tap) -> &Row = row([t; 1])

        screen(tag: int) -> &Row
            val body = wrap(Tap(() -> print(tag + 5)))

            body
        end screen
        """), "15\n75\n")

@test("a view of an array local holding the closure hands it over as the literal does")
fbl_array_local_viewed()
    fbl_prints(fbl_program(raw"""
        wrap(t: &Tap) -> &Row
            var a = [t]

            row(a)
        end wrap

        screen(tag: int) -> &Row
            val body = wrap(Tap(() -> print(tag + 5)))

            body
        end screen
        """), "15\n75\n")

@test("a chain of wrappers, the literal two calls down, still answers the closure")
fbl_chain_of_wrappers()
    fbl_prints(fbl_program(raw"""
        pair(t: &Tap) -> &Row = row([t, t])
        wrap(t: &Tap) -> &Row = pair(t)

        screen(tag: int) -> &Row
            val body = wrap(Tap(() -> print(tag + 5)))

            body
        end screen
        """), "15\n15\n75\n75\n")

@test("a wrapper over trait objects, as syslUI's views are, answers the closure too")
fbl_trait_object_wrapper()
    fbl_prints(raw"""
        import sysl.buf.{Buf, buf}

        trait View
            paint(&self)

        struct Tappable
            action: &Fn() -> unit

        impl View for Tappable
            paint(&self) = (self.action)()

        struct Column
            kids: Buf[&View]

        impl View for Column
            paint(&self)
                for k in self.kids
                    k.paint()

        column(children: []&View) -> &View
            var b: Buf[&View] = buf()

            b.extend(children)
            Column(b)
        end column

        button(on_tap: &Fn() -> unit) -> &View = Tappable(on_tap)

        centred(v: &View) -> &View = column([v])

        screen(tag: int) -> &View
            val body = centred(button(() -> print(tag + 5)))

            body
        end screen

        main()
            val a = screen(10)
            val b = screen(70)
            a.paint()
            b.paint()
        """, "15\n75\n")

// -- what stays in the frame ----------------------------------------------------------------------

// A callee that reads the literal and answers a number lets nothing out, so the closure bound through
// it keeps its frame box.
private const fbl_read_only: string = raw"""
    count(fs: []&Fn(int) -> unit) -> int
        for f in fs
            f(1)

        int(fs.len)
    end count

    tally(tag: int)
        val n = count([(e) -> print(tag + e)])

        print(n)
    end tally

    main()
        tally(10)
        tally(70)
    """

@test("a closure in a literal whose callee answers a number prints its own capture")
fbl_read_only_runs()
    fbl_prints(fbl_read_only, "11\n1\n71\n1\n")

@test("and stays boxed in its frame")
fbl_read_only_stays_in_the_frame()
    if xvr_no_library() then return

    assert_eq(fbl_frame_boxes(fbl_read_only), 1)
