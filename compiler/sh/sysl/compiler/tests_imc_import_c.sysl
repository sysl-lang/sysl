module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.env.get as imc_env
import sysl.fs.{is_file, make_temp_dir, read_text, remove_dir_all, write_text}
import sysl.process.capture
import sysl.text.{Search, join, split}

// `sysl import-c` (`import_c.sysl`, `import_c_render.sysl`, `import_c_type.sysl`): a header in, the
// raw layer of a binding out.
//
// **The fixture's expected text is compared whole**, and is then compiled and run against a C file
// implementing two of its functions -- so what is asserted is not only what was written but that it
// means what the header means: every `@assert` the module carries holds on this machine, a struct
// crosses by value both ways, and an enum and a macro read back the numbers C gives them. One case
// widens a field on purpose and watches the build refuse, which is what makes the other checks
// evidence.

private val imc_header: string = raw"""
    #include <sys/types.h>
    #include <stddef.h>
    #include <stdint.h>
    #include <stdbool.h>
    #include <stdio.h>
    #include "fx_other.h"

    #define FX_VERSION 3
    #define FX_MASK (1u << 4)
    #define FX_BIG 0x100000000ULL
    #define FX_NEG (-2)
    #define FX_NAME "fx"
    #define FX_HALF 0.5
    #define FX_EMPTY
    #define FX_TWICE(x) ((x) * 2)

    typedef struct fx_ctx fx_ctx;

    typedef struct fx_point {
        int32_t x;
        int32_t y;
    } fx_point;

    struct fx_rec {
        uint8_t tag;
        uint64_t when;
        const char *name;
        fx_point at[2];
        void *user;
    };

    typedef enum fx_mode {
        FX_MODE_OFF,
        FX_MODE_ON = 4,
    } fx_mode;

    enum fx_signed { FX_LOW = -1, FX_HIGH = 1 };

    typedef void (*fx_cb)(fx_ctx *ctx, int status, void *user);

    typedef union fx_word { uint32_t u; float f; } fx_word;

    struct fx_bits { unsigned a : 3; unsigned : 2; unsigned b : 5; unsigned : 0; int c : 4; };

    struct fx_holder { int kind; union { int i; double d; } v; };

    struct fx_pair { int tag; union { int n; float x; }; };

    union fx_alt { uint32_t u; long double ld; };

    struct __attribute__((aligned(16))) fx_al { int x; };

    struct __attribute__((aligned)) fx_al_max { int x; };

    struct fx_lbits { long l : 3; };

    #pragma pack(push, 2)
    struct fx_pk { char a; int b; };
    #pragma pack(pop)

    struct __attribute__((packed)) fx_packed { uint8_t a; uint32_t b; };

    fx_ctx *fx_open(const char *path, size_t len);
    void fx_close(fx_ctx *ctx);
    int fx_point_sum(fx_point p);
    fx_point fx_origin(void);
    bool fx_set(fx_ctx *ctx, fx_mode mode, fx_cb cb, void *user);
    long fx_count(const struct fx_rec *recs, unsigned long n);
    double fx_scale(float f, double d);
    int fx_log(fx_ctx *ctx, const char *fmt, ...);
    static inline int fx_twice(int x) { return x * 2; }
    static inline unsigned fx_bits_a(struct fx_bits b) { return b.a; }
    static inline int fx_none(const char *fmt, ...) { return 0; }
    uint16_t fx_bytes(uint8_t *out, int16_t *in, ssize_t n);
    char fx_sign(char c);
    #define FX_BAD fx_nothing_declared
    #define FX_SUM_OF(p) fx_point_sum(p)
    #define FX_LOGV(c, ...) fx_log(c, __VA_ARGS__)

    typedef struct { int16_t lo; int16_t hi; } fx_span;
    typedef enum { FX_RED, FX_BLUE } fx_colour;
    typedef uint16_t fx_sym;
    typedef int fx_fn(int);
    struct fx_blob { uint32_t len; uint8_t data[]; };
    struct fx_tagged { char code[4]; const char *label; };
    extern int fx_level;

    fx_span fx_widen(fx_span s, fx_colour c, fx_sym y);
    int fx_apply(fx_fn *f, int x);
    void fx_dump(FILE *out, struct fx_blob *b);
    int fx_wait(struct fx_far t);
    """

// The other header the fixture includes: a record it takes by value, laid out only under `--follow`.
private val imc_other: string = raw"""
    #include <stdint.h>
    struct fx_far { int32_t a; double b; };
    """

private val imc_expected: string = raw"""
    // Generated by `sysl import-c` from fx.h: the raw layer of a binding, one declaration per
    // C declaration. Regenerate it rather than editing it -- what a program calls belongs in a
    // module above this one.

    @include("fx.h")

    // Declared by another header, and only ever pointed at here.
    opaque struct FILE

    opaque struct Ctx

    struct Point
        x: i32
        y: i32

    struct Rec
        tag: u8
        when: u64
        name: *u8
        at: [2]Point
        user: *u8

    union Word
        u: u32
        f: f32

    struct Bits
        a: u3 in u32
        _: u2 in u32
        b: u5 in u32
        _: in u32
        c: i4 in i32

    struct Holder
        kind: i32
        v: HolderV

    union HolderV
        i: i32
        d: f64

    struct Pair
        tag: i32
        union
            n: i32
            x: f32

    // `union fx_alt.ld` is 'long double', whose format is the machine's -- see `c type`: here it is its bytes, as '_ld'.
    @align(ALIGNOF_ALT)
    union Alt
        u: u32
        _ld: [SIZEOF_ALT_LD]u8

    @align(16)
    struct Al
        x: i32

    // `struct fx_al_max` carries an alignment attribute whose value is not a literal.
    // Opaque here: its storage is SIZEOF_AL_MAX bytes, aligned to ALIGNOF_AL_MAX.
    opaque struct AlMax

    // `struct fx_lbits` has a bitfield ('l') declared 'long', and a bitfield's unit is an integer of 8, 16, 32 or 64 bits.
    // Opaque here: its storage is SIZEOF_LBITS bytes, aligned to ALIGNOF_LBITS.
    opaque struct Lbits

    // `struct fx_pk` is laid out under '#pragma pack'.
    // Opaque here: its storage is SIZEOF_PK bytes, aligned to ALIGNOF_PK.
    opaque struct Pk

    @packed
    struct Packed
        a: u8
        b: u32

    struct Span
        lo: i16
        hi: i16

    // `struct fx_blob` has a field ('data') that is a flexible array member, whose length is the allocation's.
    // Opaque here: its storage is SIZEOF_BLOB bytes, aligned to ALIGNOF_BLOB.
    opaque struct Blob

    struct Tagged
        code: [4]i8
        label: *u8

    type Cb = *extern(*Ctx, i32, *u8) -> unit
    type Sym = u16

    c type
        Mode = "fx_mode"
        Signed = "enum fx_signed"
        Colour = "fx_colour"
        CLong = "long"
        CULong = "unsigned long"

    c const
        MODE_OFF: Mode = "FX_MODE_OFF"
        MODE_ON: Mode = "FX_MODE_ON"
        LOW: Signed = "FX_LOW"
        HIGH: Signed = "FX_HIGH"
        RED: Colour = "FX_RED"
        BLUE: Colour = "FX_BLUE"

        VERSION: i32 = "FX_VERSION"
        MASK: u32 = "FX_MASK"
        BIG: u64 = "FX_BIG"
        NEG: i32 = "FX_NEG"
        HALF: f64 = "FX_HALF"

        SIZEOF_POINT: usize = "sizeof(fx_point)"
        OFFSETOF_POINT_X: usize = "__builtin_offsetof(fx_point, x)"
        OFFSETOF_POINT_Y: usize = "__builtin_offsetof(fx_point, y)"
        SIZEOF_REC: usize = "sizeof(struct fx_rec)"
        OFFSETOF_REC_TAG: usize = "__builtin_offsetof(struct fx_rec, tag)"
        OFFSETOF_REC_WHEN: usize = "__builtin_offsetof(struct fx_rec, when)"
        OFFSETOF_REC_NAME: usize = "__builtin_offsetof(struct fx_rec, name)"
        OFFSETOF_REC_AT: usize = "__builtin_offsetof(struct fx_rec, at)"
        OFFSETOF_REC_USER: usize = "__builtin_offsetof(struct fx_rec, user)"
        SIZEOF_WORD: usize = "sizeof(fx_word)"
        ALIGNOF_WORD: usize = "_Alignof(fx_word)"
        OFFSETOF_WORD_U: usize = "__builtin_offsetof(fx_word, u)"
        OFFSETOF_WORD_F: usize = "__builtin_offsetof(fx_word, f)"
        SIZEOF_BITS: usize = "sizeof(struct fx_bits)"
        ALIGNOF_BITS: usize = "_Alignof(struct fx_bits)"
        SIZEOF_HOLDER: usize = "sizeof(struct fx_holder)"
        OFFSETOF_HOLDER_KIND: usize = "__builtin_offsetof(struct fx_holder, kind)"
        OFFSETOF_HOLDER_V: usize = "__builtin_offsetof(struct fx_holder, v)"
        SIZEOF_HOLDER_V: usize = "sizeof(((struct fx_holder *)0)->v)"
        ALIGNOF_HOLDER_V: usize = "__alignof__(((struct fx_holder *)0)->v)"
        OFFSETOF_HOLDER_V_I: usize = "__builtin_offsetof(struct fx_holder, v.i) - __builtin_offsetof(struct fx_holder, v)"
        OFFSETOF_HOLDER_V_D: usize = "__builtin_offsetof(struct fx_holder, v.d) - __builtin_offsetof(struct fx_holder, v)"
        SIZEOF_PAIR: usize = "sizeof(struct fx_pair)"
        OFFSETOF_PAIR_TAG: usize = "__builtin_offsetof(struct fx_pair, tag)"
        OFFSETOF_PAIR_N: usize = "__builtin_offsetof(struct fx_pair, n)"
        OFFSETOF_PAIR_X: usize = "__builtin_offsetof(struct fx_pair, x)"
        SIZEOF_ALT: usize = "sizeof(union fx_alt)"
        ALIGNOF_ALT: usize = "_Alignof(union fx_alt)"
        OFFSETOF_ALT_U: usize = "__builtin_offsetof(union fx_alt, u)"
        SIZEOF_ALT_LD: usize = "sizeof(((union fx_alt *)0)->ld)"
        OFFSETOF_ALT_LD: usize = "__builtin_offsetof(union fx_alt, ld)"
        SIZEOF_AL: usize = "sizeof(struct fx_al)"
        ALIGNOF_AL: usize = "_Alignof(struct fx_al)"
        OFFSETOF_AL_X: usize = "__builtin_offsetof(struct fx_al, x)"
        SIZEOF_AL_MAX: usize = "sizeof(struct fx_al_max)"
        ALIGNOF_AL_MAX: usize = "_Alignof(struct fx_al_max)"
        SIZEOF_LBITS: usize = "sizeof(struct fx_lbits)"
        ALIGNOF_LBITS: usize = "_Alignof(struct fx_lbits)"
        SIZEOF_PK: usize = "sizeof(struct fx_pk)"
        ALIGNOF_PK: usize = "_Alignof(struct fx_pk)"
        SIZEOF_PACKED: usize = "sizeof(struct fx_packed)"
        OFFSETOF_PACKED_A: usize = "__builtin_offsetof(struct fx_packed, a)"
        OFFSETOF_PACKED_B: usize = "__builtin_offsetof(struct fx_packed, b)"
        SIZEOF_SPAN: usize = "sizeof(fx_span)"
        OFFSETOF_SPAN_LO: usize = "__builtin_offsetof(fx_span, lo)"
        OFFSETOF_SPAN_HI: usize = "__builtin_offsetof(fx_span, hi)"
        SIZEOF_BLOB: usize = "sizeof(struct fx_blob)"
        ALIGNOF_BLOB: usize = "_Alignof(struct fx_blob)"
        SIZEOF_TAGGED: usize = "sizeof(struct fx_tagged)"
        OFFSETOF_TAGGED_CODE: usize = "__builtin_offsetof(struct fx_tagged, code)"
        OFFSETOF_TAGGED_LABEL: usize = "__builtin_offsetof(struct fx_tagged, label)"

    @assert(sizeof(Point) == SIZEOF_POINT, "Point must match fx_point")
    @assert(offsetof(Point, x) == OFFSETOF_POINT_X, "fx_point.x moved")
    @assert(offsetof(Point, y) == OFFSETOF_POINT_Y, "fx_point.y moved")
    @assert(sizeof(Rec) == SIZEOF_REC, "Rec must match struct fx_rec")
    @assert(offsetof(Rec, tag) == OFFSETOF_REC_TAG, "struct fx_rec.tag moved")
    @assert(offsetof(Rec, when) == OFFSETOF_REC_WHEN, "struct fx_rec.when moved")
    @assert(offsetof(Rec, name) == OFFSETOF_REC_NAME, "struct fx_rec.name moved")
    @assert(offsetof(Rec, at) == OFFSETOF_REC_AT, "struct fx_rec.at moved")
    @assert(offsetof(Rec, user) == OFFSETOF_REC_USER, "struct fx_rec.user moved")
    @assert(sizeof(Word) == SIZEOF_WORD, "Word must match fx_word")
    @assert(alignof(Word) == ALIGNOF_WORD, "Word must be aligned as fx_word is")
    @assert(offsetof(Word, u) == OFFSETOF_WORD_U, "fx_word.u moved")
    @assert(offsetof(Word, f) == OFFSETOF_WORD_F, "fx_word.f moved")
    @assert(sizeof(Bits) == SIZEOF_BITS, "Bits must match struct fx_bits")
    @assert(alignof(Bits) == ALIGNOF_BITS, "Bits must be aligned as struct fx_bits is")
    @assert(sizeof(Holder) == SIZEOF_HOLDER, "Holder must match struct fx_holder")
    @assert(offsetof(Holder, kind) == OFFSETOF_HOLDER_KIND, "struct fx_holder.kind moved")
    @assert(offsetof(Holder, v) == OFFSETOF_HOLDER_V, "struct fx_holder.v moved")
    @assert(sizeof(HolderV) == SIZEOF_HOLDER_V, "HolderV must match struct fx_holder.v")
    @assert(alignof(HolderV) == ALIGNOF_HOLDER_V, "HolderV must be aligned as struct fx_holder.v is")
    @assert(offsetof(HolderV, i) == OFFSETOF_HOLDER_V_I, "struct fx_holder.v.i moved")
    @assert(offsetof(HolderV, d) == OFFSETOF_HOLDER_V_D, "struct fx_holder.v.d moved")
    @assert(sizeof(Pair) == SIZEOF_PAIR, "Pair must match struct fx_pair")
    @assert(offsetof(Pair, tag) == OFFSETOF_PAIR_TAG, "struct fx_pair.tag moved")
    @assert(offsetof(Pair, n) == OFFSETOF_PAIR_N, "struct fx_pair.n moved")
    @assert(offsetof(Pair, x) == OFFSETOF_PAIR_X, "struct fx_pair.x moved")
    @assert(sizeof(Alt) == SIZEOF_ALT, "Alt must match union fx_alt")
    @assert(alignof(Alt) == ALIGNOF_ALT, "Alt must be aligned as union fx_alt is")
    @assert(offsetof(Alt, u) == OFFSETOF_ALT_U, "union fx_alt.u moved")
    @assert(offsetof(Alt, _ld) == OFFSETOF_ALT_LD, "union fx_alt.ld moved")
    @assert(sizeof(Al) == SIZEOF_AL, "Al must match struct fx_al")
    @assert(alignof(Al) == ALIGNOF_AL, "Al must be aligned as struct fx_al is")
    @assert(offsetof(Al, x) == OFFSETOF_AL_X, "struct fx_al.x moved")
    @assert(sizeof(Packed) == SIZEOF_PACKED, "Packed must match struct fx_packed")
    @assert(offsetof(Packed, a) == OFFSETOF_PACKED_A, "struct fx_packed.a moved")
    @assert(offsetof(Packed, b) == OFFSETOF_PACKED_B, "struct fx_packed.b moved")
    @assert(sizeof(Span) == SIZEOF_SPAN, "Span must match fx_span")
    @assert(offsetof(Span, lo) == OFFSETOF_SPAN_LO, "fx_span.lo moved")
    @assert(offsetof(Span, hi) == OFFSETOF_SPAN_HI, "fx_span.hi moved")
    @assert(sizeof(Tagged) == SIZEOF_TAGGED, "Tagged must match struct fx_tagged")
    @assert(offsetof(Tagged, code) == OFFSETOF_TAGGED_CODE, "struct fx_tagged.code moved")
    @assert(offsetof(Tagged, label) == OFFSETOF_TAGGED_LABEL, "struct fx_tagged.label moved")

    extern "fx_open" open(path: *u8, len: usize) -> *Ctx
    extern "fx_close" close(ctx: *Ctx)
    extern "fx_point_sum" point_sum(p: Point) -> i32
    extern "fx_origin" origin() -> Point
    extern "fx_set" set(ctx: *Ctx, mode: Mode, cb: Cb, user: *u8) -> bool
    extern "fx_count" count(recs: *Rec, n: CULong) -> CLong
    extern "fx_scale" scale(f: f32, d: f64) -> f64
    extern "fx_log" log(ctx: *Ctx, fmt: *u8, ...) -> i32
    extern "fx_bytes" bytes(out: *u8, `in`: *i16, n: isize) -> u16
    extern "fx_sign" sign(c: i8) -> i8
    extern "fx_widen" widen(s: Span, c: Colour, y: Sym) -> Span
    extern "fx_apply" apply(f: *extern(i32) -> i32, x: i32) -> i32
    extern "fx_dump" dump(out: *FILE, b: *Blob)
    extern "fx_level" level: i32

    // Not generated:
    //
    // - union fx_alt.ld is 'long double', whose format is the machine's -- see `c type` -- its bytes here, as '_ld'
    // - struct fx_al_max carries an alignment attribute whose value is not a literal -- an opaque struct here, sized by SIZEOF_AL_MAX and aligned by ALIGNOF_AL_MAX
    // - struct fx_lbits has a bitfield ('l') declared 'long', and a bitfield's unit is an integer of 8, 16, 32 or 64 bits -- an opaque struct here, sized by SIZEOF_LBITS and aligned by ALIGNOF_LBITS
    // - struct fx_pk is laid out under '#pragma pack' -- an opaque struct here, sized by SIZEOF_PK and aligned by ALIGNOF_PK
    // - struct fx_blob has a field ('data') that is a flexible array member, whose length is the allocation's -- an opaque struct here, sized by SIZEOF_BLOB and aligned by ALIGNOF_BLOB
    // - fx_twice: a 'static inline' function has no symbol to link against -- '--shim <file.c>' writes the wrapper that reaches it
    // - fx_bits_a: a 'static inline' function has no symbol to link against -- '--shim <file.c>' writes the wrapper that reaches it
    // - fx_none: a 'static inline' function that takes '...', whose arguments a wrapper cannot pass on
    // - fx_wait: 'struct fx_far' by value, and it is declared by another header -- '--follow fx_other.h' lays it out
    // - FX_NAME: a string, and a 'c const' measures numbers only
    // - FX_BAD: not a constant expression C can evaluate
    // - FX_TWICE: a function-like macro whose parameters ('x') no function it calls gives a type
    // - FX_SUM_OF: a function-like macro has no symbol to link against -- '--shim <file.c>' writes the wrapper that reaches it
    // - FX_LOGV: a function-like macro that takes '...'
    """

// What `--shim` adds: the two wrappers, and their `extern`s where the module declares its functions.
private val imc_shim: string = raw"""
    /* Generated by `sysl import-c` from fx.h: a C wrapper for each 'static' function and
     * function-like macro the module reaches, which have no symbol of their own. It is compiled
     * where it sits, in the module's directory. Regenerate it rather than editing it. */
    #include "fx.h"

    int sysl_fx_twice(int x) {
        return fx_twice(x);
    }

    unsigned int sysl_fx_bits_a(struct fx_bits b) {
        return fx_bits_a(b);
    }

    int sysl_FX_SUM_OF(fx_point p) {
        return FX_SUM_OF(p);
    }
    """

// The C half of the fixture: a struct handed back by value and one taken, and a `char` both ways.
private val imc_c: string = raw"""
    #include "fx.h"
    fx_point fx_origin(void) { fx_point p = {3, 4}; return p; }
    int fx_point_sum(fx_point p) { return p.x + p.y; }
    char fx_sign(char c) { return (char)-c; }
    """

// What the fixture's program prints: sizes the layout checks have already held to C's, numbers
// read back, a union and a bitfield written and read, and calls across both ways.
private val imc_print: string =
    "print(sizeof(Point), sizeof(Rec), sizeof(Packed), MODE_ON, LOW, BIG, HALF, SIZEOF_WORD, " +
    "point_sum(origin()), sign(5))\n" +
    "var b = Bits(5, 17, -3)\n" +
    "b.c += 1\n" +
    "print(Word(f = 1.0).u, sizeof(Holder), sizeof(Pair), sizeof(Bits), alignof(Al), b.a, b.b, b.c, " +
    "Pair(tag = 1, n = 9).n)\n"

private imc_ready() -> bool
    if std_root().is_err()
        print("skipped: the standard module's source is not on this machine")
        return false
    end if

    if !clang_available()
        print("skipped: there is no clang on this machine")
        return false
    end if

    true
end imc_ready

// A directory holding the fixture header and nothing else.
private imc_fixture() -> string
    val dir = make_temp_dir("sysl-imc").unwrap()

    write_text(s"$dir/fx.h", imc_header).unwrap()
    write_text(s"$dir/fx_other.h", imc_other).unwrap()
    dir

private imc_options(follow: Buf[string], shim: string) -> IcOptions = IcOptions("fx_", "", "", "", None, follow, shim)

private imc_generated(dir: string) -> IcOutput = import_c_generate(s"$dir/fx.h", imc_options(buf(), "")).unwrap()

// A project beside the fixture: the generated module as its root, lines using it, and the C.
private imc_project(dir: string, module_text: string, uses: string) -> string
    write_text(s"$dir/fx.c", imc_c).unwrap()
    write_text(s"$dir/package.hocon", "package {\n  name = \"fx\"\n  version = \"0.0.1\"\n}\n").unwrap()
    write_text(s"$dir/main.sysl", module_text + "\n" + uses).unwrap()
    dir

// The project built and run: what it printed, or the build's complaint.
private imc_built(root: string) -> Result[string, string]
    val (code, _, err) = clx_ran(["sysl", "build", root, "-o", s"$root/fx"])

    if code != Fine then return Err(err)

    Ok(capture(s"$root/fx", [], "", [], true).unwrap().text)

// The text with its first `old` replaced, for a case that breaks one line on purpose.
private imc_once(text: string, old: string, new: string) -> string = text.index_of(old) match
    Some(at) -> text[0..<at] + new + text[at + old.len..<text.len]
    None -> text

// ## The fixture, whole

@test("a header becomes exactly the declarations a binding writes by hand")
imc_fixture_text()
    if !imc_ready() then return

    val dir = imc_fixture()
    val out = imc_generated(dir)

    remove_dir_all(dir).unwrap_or(())
    assert_eq(out.text, imc_expected)
end imc_fixture_text

@test("and what was not generated is said one line each, in the order it was found")
imc_fixture_refusals()
    if !imc_ready() then return

    val dir = imc_fixture()
    val out = imc_generated(dir)

    remove_dir_all(dir).unwrap_or(())

    val foot = imc_expected[imc_expected.index_of("// - ").unwrap()..<imc_expected.len]
    var wanted: Buf[string] = buf()

    for line in split(foot, "\n")
        if line.starts_with("// - ") then wanted.push(line[5..<line.len])

    assert_eq(join(out.refused.view(), "\n"), join(wanted.view(), "\n"))
end imc_fixture_refusals

@test("what it generates compiles, its layout checks hold here, and it calls into the C")
imc_fixture_runs()
    if !imc_ready() then return

    val dir = imc_fixture()
    val ran = imc_built(imc_project(dir, imc_generated(dir).text, imc_print))

    remove_dir_all(dir).unwrap_or(())
    assert_eq(ran, Ok("8 48 5 4 -1 4294967296 0.5 4 7 -5\n1065353216 16 8 8 16 5 17 -2 9\n"))
end imc_fixture_runs

// The check the others lean on: a record laid out differently from C must not build.
@test("a field that disagrees with C fails the build at the record's own check")
imc_layout_check_can_fail()
    if !imc_ready() then return

    val dir = imc_fixture()
    val broken = imc_once(imc_generated(dir).text, "    y: i32\n", "    y: i64\n")
    val (code, _, err) = clx_ran(["sysl", "run", imc_project(dir, broken, imc_print)])

    remove_dir_all(dir).unwrap_or(())
    assert(code != Fine, "a widened field built")
    assert(err.contains("assertion failed: Point must match fx_point — the left side is 16 and the right side is 8"), err)
end imc_layout_check_can_fail

// The same checks hold a union, a C bitfield and an aligned record to C: each one broken on purpose
// fails at its own record's check.
@test("a union member, a bitfield or an alignment that disagrees with C fails the build at its check")
imc_union_bits_checks_can_fail()
    if !imc_ready() then return

    val cases = [("    f: f32\n", "    f: f64\n", "Word must match fx_word — the left side is 8 and the right side is 4"),
                 ("    b: u5 in u32\n", "    b: u30 in u32\n", "Bits must match struct fx_bits — the left side is 12"),
                 ("@align(16)\nstruct Al", "@align(8)\nstruct Al", "Al must match struct fx_al — the left side is 8")]

    for c in cases
        val dir = imc_fixture()
        val broken = imc_once(imc_generated(dir).text, c.0, c.1)

        assert(broken != imc_generated(dir).text, c.0)

        val (code, _, err) = clx_ran(["sysl", "run", imc_project(dir, broken, imc_print)])

        remove_dir_all(dir).unwrap_or(())
        assert(code != Fine, s"'${c.1.trim()}' built")
        assert(err.contains(c.2), err)
end imc_union_bits_checks_can_fail

// `--follow` lays out a record another header declares where the header's own declarations use it
// by value, under the same checks; without it the same declaration is refused (the fixture's text).
@test("'--follow' lays out another header's record that is used by value, and the result runs")
imc_follow_lays_out()
    if !imc_ready() then return

    val dir = imc_fixture()
    var follow: Buf[string] = buf()

    follow.push("fx_other.h")

    val out = import_c_generate(s"$dir/fx.h", imc_options(follow, "")).unwrap()

    assert(out.text.contains("// Declared by a header '--follow' named.\nstruct Far\n    a: i32\n    b: f64\n\n"), out.text)
    assert(out.text.contains("    OFFSETOF_FAR_B: usize = \"__builtin_offsetof(struct fx_far, b)\"\n"), out.text)
    assert(out.text.contains("@assert(sizeof(Far) == SIZEOF_FAR, \"Far must match struct fx_far\")\n"), out.text)
    assert(out.text.contains("extern \"fx_wait\" wait(t: Far) -> i32\n"), out.text)
    assert(!join(out.refused.view(), "\n").contains("fx_wait"), join(out.refused.view(), "\n"))

    val ran = imc_built(imc_project(dir, out.text, "print(sizeof(Far), Far(1, 0.5).b)\n"))

    remove_dir_all(dir).unwrap_or(())
    assert_eq(ran, Ok("16 0.5\n"))
end imc_follow_lays_out

// `--shim`: a wrapper per `static inline` function and per function-like macro a function types,
// their `extern`s in the module, and the pair compiles, links and calls through.
@test("'--shim' writes a C wrapper for each typed static inline function and macro, and they link and run")
imc_shim_runs()
    if !imc_ready() then return

    val dir = imc_fixture()
    val out = import_c_generate(s"$dir/fx.h", imc_options(buf(), "shim.c")).unwrap()
    val refused = join(out.refused.view(), "\n")

    assert_eq(out.shim, imc_shim)
    assert(out.text.contains("extern \"fx_log\" log(ctx: *Ctx, fmt: *u8, ...) -> i32\n" +
                             "extern \"sysl_fx_twice\" twice(x: i32) -> i32\n" +
                             "extern \"sysl_fx_bits_a\" bits_a(b: Bits) -> u32\n"), out.text)
    assert(out.text.contains("extern \"fx_level\" level: i32\nextern \"sysl_FX_SUM_OF\" sum_of(p: Point) -> i32\n"),
           out.text)
    assert(!refused.contains("fx_twice") && !refused.contains("FX_SUM_OF"), refused)
    assert(refused.contains("FX_TWICE: a function-like macro whose parameters ('x') no function it calls gives a type"),
           refused)
    assert(refused.contains("fx_none: a 'static inline' function that takes '...'"), refused)

    write_text(s"$dir/shim.c", out.shim).unwrap()

    // `bits_a` takes a struct with C bitfields by value, through the wrapper.
    val ran = imc_built(imc_project(dir, out.text, "print(twice(21), sum_of(origin()), bits_a(Bits(5, 17, -3)))\n"))

    remove_dir_all(dir).unwrap_or(())
    assert_eq(ran, Ok("42 7 5\n"))
end imc_shim_runs

// ## The command

@test("the command prints the module and notes each refusal on standard error")
imc_command_prints()
    if !imc_ready() then return

    val dir = imc_fixture()
    val (code, out, err) = clx_ran(["sysl", "import-c", s"$dir/fx.h", "--prefix", "fx_"])

    remove_dir_all(dir).unwrap_or(())
    assert_eq(code, Fine, err)
    assert_eq(out, imc_expected[0..<imc_expected.len - 1])
    assert(err.contains("sysl: note: not generated: FX_NAME: a string, and a 'c const' measures numbers only"), err)
    assert(err.contains("sysl: note: not generated: fx_wait: 'struct fx_far' by value, and it is declared " +
                        "by another header -- '--follow fx_other.h' lays it out"), err)
end imc_command_prints

@test("'--module' and '--link-lib' head the module, '-o' writes it, and '--shim' writes the wrappers")
imc_command_writes()
    if !imc_ready() then return

    val dir = imc_fixture()
    val (code, _, err) = clx_ran(["sysl", "import-c", s"$dir/fx.h", "--prefix", "fx_", "--module", "fx.c",
                                  "--link-lib", "fx", "--follow", "fx_other.h", "--shim", s"$dir/fx_shim.c",
                                  "-o", s"$dir/out.sysl"])
    val text = read_text(s"$dir/out.sysl").unwrap_or("")
    val shim = read_text(s"$dir/fx_shim.c").unwrap_or("")

    remove_dir_all(dir).unwrap_or(())
    assert_eq(code, Fine, err)
    assert(err.contains(s"wrote $dir/out.sysl"), err)
    assert(err.contains(s"wrote $dir/fx_shim.c"), err)
    assert(text.contains("module above this one.\n\nmodule fx.c\n\n@link(\"fx\")\n\n@include(\"fx.h\")\n"), text)
    assert(text.contains("extern \"fx_wait\" wait(t: Far) -> i32\n"), text)
    assert_eq(shim, imc_shim)
end imc_command_writes

@test("'--shim' and '--follow' without a value are misuses, said with the usage")
imc_command_flag_needs_value()
    val (code, _, err) = clx_ran(["sysl", "import-c", "fx.h", "--shim"])

    assert_eq(code, Misused)
    assert(err.contains("--shim") && err.contains(import_c_usage()), err)

    val (code2, _, err2) = clx_ran(["sysl", "import-c", "fx.h", "--follow"])

    assert_eq(code2, Misused)
    assert(err2.contains("--follow") && err2.contains(import_c_usage()), err2)

@test("with no prefix, nothing is taken off a name")
imc_no_prefix()
    if !imc_ready() then return

    val dir = imc_fixture()
    val out = import_c_generate(s"$dir/fx.h", IcOptions("", "", "", "", None, buf(), "")).unwrap()

    remove_dir_all(dir).unwrap_or(())
    assert(out.text.contains("struct FxPoint\n"), out.text)
    assert(out.text.contains("extern fx_open(path: *u8, len: usize) -> *FxCtx\n"), out.text)
    assert(out.text.contains("    FX_MODE_ON: FxMode = \"FX_MODE_ON\"\n"), out.text)
end imc_no_prefix

// A record holding a record with C bitfields by value -- in a field, through a typedef, as an array's
// element, as a union's member, or as a named member of an unnamed type -- crosses by value as C's
// own does, so a function taking or returning one is generated like any other; an anonymous member's
// bitfields are its record's own.
private val imc_holders: string = raw"""
    struct fh_bits { unsigned a : 3; unsigned b : 5; };
    struct fh_wrap { struct fh_bits b; int n; };
    typedef struct fh_wrap fh_wrap_t;
    struct fh_deep { fh_wrap_t w; };
    struct fh_row { struct fh_bits cells[2]; };
    union fh_either { struct fh_bits b; unsigned u; };
    struct fh_anon { int x; struct { unsigned a : 3; }; };
    struct fh_named { struct { unsigned a : 3; } inner; };
    struct fh_plain { int x; };
    int fh_wrap_n(struct fh_wrap w);
    struct fh_deep fh_deep_make(void);
    int fh_row_sum(struct fh_row r);
    unsigned fh_either_u(union fh_either e);
    int fh_anon_x(struct fh_anon a);
    int fh_named_a(struct fh_named n);
    int fh_plain_x(struct fh_plain p);
    int fh_wrap_at(struct fh_wrap *w);
    """

@test("a record holding C bitfields by value at any depth crosses by value, as the language has it")
imc_bitfield_holders()
    if !imc_ready() then return

    val dir = make_temp_dir("sysl-imc").unwrap()

    write_text(s"$dir/fh.h", imc_holders).unwrap()

    val out = import_c_generate(s"$dir/fh.h", IcOptions("fh_", "", "", "", None, buf(), "")).unwrap()

    remove_dir_all(dir).unwrap_or(())
    assert_eq(join(out.refused.view(), "\n"), "")

    for line in ["extern \"fh_wrap_n\" wrap_n(w: Wrap) -> i32\n", "extern \"fh_deep_make\" deep_make() -> Deep\n",
                 "extern \"fh_row_sum\" row_sum(r: Row) -> i32\n", "extern \"fh_either_u\" either_u(e: Either) -> u32\n",
                 "extern \"fh_anon_x\" anon_x(a: Anon) -> i32\n", "extern \"fh_named_a\" named_a(n: Named) -> i32\n",
                 "extern \"fh_plain_x\" plain_x(p: Plain) -> i32\n", "extern \"fh_wrap_at\" wrap_at(w: *Wrap) -> i32\n"]
        assert(out.text.contains(line), s"$line\nin\n${out.text}")
end imc_bitfield_holders

@test("no header is the usage, and a header that is not there is said so")
imc_command_misused()
    val (code, out, err) = clx_ran(["sysl", "import-c"])

    assert_eq(code, Misused)
    assert_eq(out, "")
    assert_eq(err, import_c_usage())

    val (code2, _, err2) = clx_ran(["sysl", "import-c", "/nonexistent/fx.h"])

    assert_eq(code2, Failed)
    assert_eq(err2, "sysl: error: cannot read /nonexistent/fx.h")

@test("a header C cannot compile is refused in clang's own words")
imc_header_refused()
    if !imc_ready() then return

    val dir = make_temp_dir("sysl-imc").unwrap()

    write_text(s"$dir/bad.h", "#include \"absent_header.h\"\nint f(void);\n").unwrap()

    val (code, _, err) = clx_ran(["sysl", "import-c", s"$dir/bad.h"])

    remove_dir_all(dir).unwrap_or(())
    assert_eq(code, Failed)
    assert(err.starts_with(s"sysl: error: the C compiler could not read $dir/bad.h:\n"), err)
    assert(err.contains("'absent_header.h' file not found"), err)
end imc_header_refused

// ## The declarator reader

@test("a C type as clang spells it reads back inside out")
imc_declarators()
    assert_eq(ic_show(ic_parse("void (*)(fx_ctx *, int, void *)")), "void (fx_ctx *, int, void *) *")
    assert_eq(ic_show(ic_parse("const char *(*)(void *, uint32_t)")), "char * (void *, uint32_t) *")
    assert_eq(ic_show(ic_parse("int (*[4])(void)")), "int () *[4]")
    assert_eq(ic_show(ic_parse("const char *const *")), "char * *")
    assert_eq(ic_show(ic_parse("fx_point[2][3]")), "fx_point[3][2]")
    assert_eq(ic_show(ic_parse("unsigned long long")), "unsigned long long")
    assert_eq(ic_show(ic_parse("int (const char *, ...)")), "int (char *, ...)")

    val p = ic_parse("void (*)(int)")

    assert(p.kind == IcPtr && p.parts.at(0).kind == IcFunc, ic_show(p))

    val a = ic_parse("int (*[4])(void)")

    assert(a.kind == IcArr && a.count == 4 && a.parts.at(0).kind == IcPtr, ic_show(a))
end imc_declarators

@test("what the reader does not follow is said rather than guessed")
imc_declarators_refused()
    assert_eq(ic_bad_part(ic_parse("void (^)(int)")), Some("a block pointer ('^'), which is Apple's closure extension to C"))
    assert_eq(ic_bad_part(ic_parse("int[N]")), Some("an array bound clang left as 'N'"))
    assert(ic_parse("struct (unnamed struct at fx.h:3:9)").name.contains("(unnamed"))
    assert_eq(ic_bad_part(ic_parse("int *")), None)

// ## Names

@test("a type is named for its typedef, with the prefix and '_t' taken off")
imc_type_names()
    assert_eq(ic_type_name("fx_point", "fx_"), "Point")
    assert_eq(ic_type_name("uv_tcp_t", "uv_"), "Tcp")
    assert_eq(ic_type_name("TSNode", "ts_"), "Node")
    assert_eq(ic_type_name("TSQueryCursor", "ts_"), "QueryCursor")
    assert_eq(ic_type_name("tsunami", "ts_"), "Tsunami")
    assert_eq(ic_type_name("fx_point", ""), "FxPoint")
    assert_eq(ic_type_name("fx_2d", "fx_"), "Fx2d")

@test("a constant is SCREAMING_SNAKE, and a reserved word is written between backticks")
imc_const_names()
    assert_eq(ic_const_name("TSQuantifierZero", "ts_"), "QUANTIFIER_ZERO")
    assert_eq(ic_const_name("FX_MODE_ON", "fx_"), "MODE_ON")
    assert_eq(ic_screaming("InputEncodingUTF8"), "INPUT_ENCODING_UTF8")
    assert_eq(ic_screaming("HTTPServer"), "HTTP_SERVER")
    assert_eq(ic_ident("in"), "`in`")
    assert_eq(ic_ident("count"), "count")

// ## A real header

// The hand-written tree-sitter binding (`sysl-lang/tree-sitter`) against what `api.h` generates:
// every entry point it declares is generated, and with the same signature once each generated name
// is read as what it stands for -- a `type` alias as its target, an enum's `c type` as the `u32`
// the binding wrote, and the one record the binding named differently.
@test("tree-sitter's api.h generates every extern the hand-written binding has, signature for signature")
imc_tree_sitter_agrees()
    val header = "/opt/homebrew/include/tree_sitter/api.h"
    val home = imc_env("HOME").unwrap_or("")
    val hand_file = s"$home/dev/sysl-lang/tree-sitter/sh/sysl/treesitter/c/c.sysl"

    if !imc_ready() || !is_file(header) || !is_file(hand_file)
        print("skipped: tree-sitter's header or the hand-written binding is not on this machine")
        return
    end if

    val out = import_c_generate(header, IcOptions("ts_", "", "", "tree_sitter/api.h", None, buf(), "")).unwrap()

    assert(out.refused.is_empty(), join(out.refused.view(), "\n"))

    var same: Buf[(string, string)] = buf()
    var in_ctype = false

    same.push(("QueryPredicateStep", "PredicateStep"))

    for line in split(out.text, "\n")
        if line.starts_with("type ")
            val eq = line.index_of(" = ").unwrap()

            same.push((line[5..<eq], line[eq + 3..<line.len]))
        end if

        if line == "c type" then in_ctype = true
        else if line == "" then in_ctype = false
        else if in_ctype then same.push((line.trim()[0..<line.trim().index_of(" ").unwrap()], "u32"))

    val generated = imc_signatures(out.text)
    val hand = imc_signatures(read_text(hand_file).unwrap())
    var compared = 0

    for h in hand
        // `free` is the binding's own, for what tree-sitter hands back; the header does not declare it.
        if !h.0.starts_with("ts_") then continue

        var found = false

        for g in generated
            if g.0 == h.0
                found = true
                compared += 1
                assert_eq(imc_read_as(g.1, same), h.1, h.0)
            end if

        assert(found, s"${h.0} is not generated")

    assert_eq(compared, 90)

    // And it builds against the installed library -- every layout check holding -- and calls in.
    val dir = make_temp_dir("sysl-imc").unwrap()

    write_text(s"$dir/package.hocon", "package {\n  name = \"tsg\"\n  version = \"0.0.1\"\n}\n" +
               "requires {\n  heap = true\n  os = true\n  pkg_config {\n    tree-sitter = \"tree-sitter\"\n  }\n}\n").unwrap()
    write_text(s"$dir/main.sysl", out.text + "\nval p = parser_new()\n" +
               "print(sizeof(Node), sizeof(TreeCursor), parser_language(p) == null)\nparser_delete(p)\n").unwrap()

    val (code, _, err) = clx_ran(["sysl", "build", dir, "-o", s"$dir/tsg"])

    assert_eq(code, Fine, err)

    val ran = capture(s"$dir/tsg", [], "", [], true)

    remove_dir_all(dir).unwrap_or(())
    assert_eq(ran.unwrap().text, "32 32 true\n")
end imc_tree_sitter_agrees

// Each `extern "c" name(params) -> R` line as its C symbol and its types alone.
private imc_signatures(text: string) -> Buf[(string, string)]
    var out: Buf[(string, string)] = buf()

    for line in split(text, "\n")
        if !line.starts_with("extern \"") then continue

        val close = line[8..<line.len].index_of("\"").unwrap() + 8
        val open = line.index_of("(").unwrap()
        var types: Buf[string] = buf()

        for piece in split(line[open + 1..<line.len], ", ")
            val colon = piece.index_of(": ")

            types.push(colon match
                Some(at) -> if imc_name_like(piece[0..<at]) then piece[at + 2..<piece.len] else piece
                None -> piece)

        out.push((line[8..<close], join(types.view(), ", ")))

    out
end imc_signatures

private imc_name_like(s: string) -> bool
    for k in 0..<s.len
        val c = s.bytes[k]

        if !((c >= u8('a') && c <= u8('z')) || c == u8('_') || (c >= u8('0') && c <= u8('9')) || c == u8('`'))
            return false

    s.len > 0

// A signature with every name in `same` read as what it stands for, whole words only.
private imc_read_as(sig: string, same: Buf[(string, string)]) -> string
    var out = sig

    for pair in same
        for sep_before in ["(", " ", "*", ", "]
            for sep_after in [",", ")", ""]
                val from = sep_before + pair.0 + sep_after

                if sep_after == "" && out.ends_with(from)
                    out = out[0..<out.len - from.len] + sep_before + pair.1
                else if sep_after != ""
                    while out.contains(from)
                        out = imc_once(out, from, sep_before + pair.1 + sep_after)

    out
end imc_read_as
