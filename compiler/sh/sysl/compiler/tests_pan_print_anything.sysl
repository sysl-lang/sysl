module sh.sysl.compiler
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.Search

// Every value prints (`reference/traits.md § Every type has a Debug`). A value with a `Display` prints
// through it; every other value prints through its `Debug`, which the compiler supplies for every
// struct and enum that does not write its own -- `Point(x: 1, y: 2)`, `Shape.Circle(r: 3)`,
// `Color.Red` -- with each field shown through the field's own `Debug`, so a string inside one is
// quoted. `f"${x}%?"` and `debug(x)` always reach `Debug`. A raw pointer shows its address, a callable
// `<fn>`, an object its concrete value's `Debug` through the slot every table carries, and a
// rendering that nests deeper than the library's limit writes `…` rather than running for ever.
//
// The harness is `tests_xvr_extern_var.sysl`'s: `xvr_ran` builds, links and runs a program, and
// `xvr_ir` answers a program's report.

private pan_types() -> string = raw"""
    struct Point
        x: int
        y: int

    enum Shape
        Circle(r: int)
        Rect(w: int, h: int)
        Dot

    enum Color
        Red
        Green

    struct Empty
    end Empty

    struct Name
        s: string

    struct P
        x: int

    impl Display for P
        display(self, out: *Writer, fmt: FormatSpec) =
            display_pad(("P" + self.x.to_string()).bytes, out, fmt)

    """

private pan_ran(body: string) -> string = xvr_ran([("main.sysl", pan_types() + body)])

private pan_refused(text: string, said: string)
    val e = xvr_ir([("main.sysl", text)])

    assert(e.contains(said), s"expected '$said', got: $e")

@test("a struct with no Display prints its name and its fields")
pan_struct()
    if xvr_no_library() then return

    assert_eq(pan_ran("print(Point(1, 2))\nprint(Empty())\n"), "Point(x: 1, y: 2)\nEmpty\n")

@test("an enum prints its variant under the enum's name, with the variant's fields")
pan_enum()
    if xvr_no_library() then return

    assert_eq(pan_ran("print(Circle(3), Rect(1, 2), Dot)\nprint(Red, Green)\n"),
              "Shape.Circle(r: 3) Shape.Rect(w: 1, h: 2) Shape.Dot\nColor.Red Color.Green\n")

@test("str, an interpolation hole and a %s hole reach the supplied Debug too")
pan_str_and_holes()
    if xvr_no_library() then return

    assert_eq(pan_ran("val p = Point(3, 4)\nprint(p.to_string())\nprint(s\"<$p>\")\nprint(f\"[${p}%20s]\")\n"),
              "Point(x: 3, y: 4)\n<Point(x: 3, y: 4)>\n[   Point(x: 3, y: 4)]\n")

@test("a string inside a structure is quoted and escaped, and a top-level one prints raw")
pan_nested_string()
    if xvr_no_library() then return

    assert_eq(pan_ran("val n = Name(\"a\\\"b\\n\\\\\")\nprint(n)\nprint(n.s)\n"),
              "Name(s: \"a\\\"b\\n\\\\\")\na\"b\n\\\n")

@test("%? and debug(x) always show Debug, even over a type with a Display")
pan_debug_over_display()
    if xvr_no_library() then return

    assert_eq(pan_ran("val p = P(7)\nprint(p)\nprint(f\"${p}%?\")\nprint(debug(p))\n" +
                      "print(debug(\"hi\"), debug('c'), debug(1.5), debug(true))\n"),
              "P7\nP(x: 7)\nP(x: 7)\n\"hi\" 'c' 1.5 true\n")

@test("a %? hole takes a width and pads the whole rendering")
pan_debug_width()
    if xvr_no_library() then return

    assert_eq(pan_ran("print(f\"[${Point(1, 2)}%20?][${Point(1, 2)}%-19?][${Dot}%10?]\")\n"),
              "[   Point(x: 1, y: 2)][Point(x: 1, y: 2)  ][ Shape.Dot]\n")

@test("tuples, arrays, Bufs, options and results show their parts through Debug")
pan_library_shapes()
    if xvr_no_library() then return

    assert_eq(pan_ran("import sysl.buf.{Buf, buf}\n" +
                      "var b: Buf[Point] = buf()\nb.push(Point(1, 2))\n" +
                      "val o: Option[Point] = Some(Point(5, 6))\nval r: Result[int, string] = Err(\"x\")\n" +
                      "print([Point(1, 2), Point(3, 4)])\nprint(b)\nprint(o)\nprint(r)\n" +
                      "print(f\"${r}%?\")\nprint(f\"${(1, \"a\")}%?\")\nprint((1, \"a\"))\n"),
              "[Point(x: 1, y: 2), Point(x: 3, y: 4)]\n[Point(x: 1, y: 2)]\nSome(Point(x: 5, y: 6))\n" +
              "Err(x)\nErr(\"x\")\n(1, \"a\")\n(1, a)\n")

@test("a field that has a Display is still shown through its Debug")
pan_nested_field_debug()
    if xvr_no_library() then return

    assert_eq(pan_ran("struct W\n    p: P\n    c: Color\n\nprint(W(P(1), Red))\n"),
              "W(p: P(x: 1), c: Color.Red)\n")

@test("an impl Debug of the program's own replaces the supplied one, at the top and nested")
pan_override()
    if xvr_no_library() then return

    val text = "struct Secret\n    key: string\n\n" +
               "impl Debug for Secret\n" +
               "    debug(self, out: *Writer, fmt: FormatSpec) = display_pad(\"Secret(***)\".bytes, out, fmt)\n\n" +
               "struct Login\n    user: string\n    secret: Secret\n\n" +
               "print(Secret(\"k\"))\nprint(Login(\"ed\", Secret(\"k\")))\n"

    assert_eq(pan_ran(text), "Secret(***)\nLogin(user: \"ed\", secret: Secret(***))\n")

@test("a generic parameter bounded by Debug alone prints and shows through it")
pan_generic_debug()
    if xvr_no_library() then return

    val text = "show[T: Debug](x: T)\n    print(x)\n    print(f\"${x}%?\")\n\n" +
               "struct Box[T]\n    v: T\n\n" +
               "show(Point(1, 2))\nshow(\"s\")\nprint(Box(Point(0, 0)))\nprint(Box(\"in\"))\n"

    assert_eq(pan_ran(text), "Point(x: 1, y: 2)\nPoint(x: 1, y: 2)\ns\n\"s\"\n" +
                             "Box(v: Point(x: 0, y: 0))\nBox(v: \"in\")\n")

@test("a trait object prints its concrete value's Debug through the slot every table carries")
pan_trait_object()
    if xvr_no_library() then return

    val text = "trait Area\n    area(self) -> int\n\n" +
               "impl Area for Point\n    area(self) -> int = self.x * self.y\n\n" +
               "impl Area for P\n    area(self) -> int = self.x\n\n" +
               "val a: *Area = &Point(2, 3)\nval b: *Area = &P(4)\n" +
               "print(a, a.area())\nprint(b)\nprint(f\"${b}%?\")\n"

    assert_eq(pan_ran(text), "Point(x: 2, y: 3) 6\nP(x: 4)\nP(x: 4)\n")

@test("a raw pointer shows its address in lower-case hex, the null one as 0x0")
pan_pointer()
    if xvr_no_library() then return

    val text = "struct Holder\n    at: *int\n\n" +
               "val z: *int = ptr_cast(usize(0))\nval p: *int = ptr_cast(usize(0xbeef0))\n" +
               "print(z, p)\nprint(Holder(p))\nprint(f\"[${p}%9?]\")\n"

    assert_eq(pan_ran(text), "0x0 0xbeef0\nHolder(at: 0xbeef0)\n[  0xbeef0]\n")

@test("a callable shows as <fn>")
pan_callable()
    if xvr_no_library() then return

    val text = "struct Task\n    run: &Fn(int) -> int\n\n" +
               "val f: &Fn(int) -> int = (x: int) -> x + 1\n" +
               "print(f)\nprint(Task(f))\nprint(debug(f))\n"

    assert_eq(pan_ran(text), "<fn>\nTask(run: <fn>)\n<fn>\n")

@test("a reference field is followed, and a chain deeper than the limit stops with an ellipsis")
pan_depth_limit()
    if xvr_no_library() then return

    val text = "struct Node\n    v: int\n    next: Option[&Node]\n\n" +
               "var head: Option[&Node] = None\n" +
               "for i in 0..<40\n    head = Some(Node(i, head))\n\n" +
               "val two: &Node = Node(1, Some(Node(2, None)))\n" +
               "print(two)\nprint(head)\n"
    val out = pan_ran(text)
    val lines = lines_of(out)

    assert_eq(lines.at(0), "Node(v: 1, next: Some(Node(v: 2, next: None)))")
    assert(lines.at(1).starts_with("Some(Node(v: 39, next: Some(Node(v: 38, "), out)
    assert(lines.at(1).contains("…"), out)
    assert_eq(xvr_count(lines.at(1), "Node("), 32)

@test("a cycle through a weak reference shows the reference without following it")
pan_weak()
    if xvr_no_library() then return

    val text = "struct Node\n    label: string\n    parent: weak Node\n\n" +
               "var root: &Node = Node(\"root\", None)\nvar kid: &Node = Node(\"kid\", root)\n" +
               "print(kid)\n"

    assert_eq(pan_ran(text), "Node(label: \"kid\", parent: weak(…))\n")

@test("a type parameter with neither bound is still refused, naming the bound to write")
pan_unbounded_parameter()
    if xvr_no_library() then return

    pan_refused("f[T](x: T)\n    print(x)\n\nf(1)\n", "'print' needs 'T: ")
    pan_refused("g[T](x: T)\n    print(f\"${x}%?\")\n\ng(1)\n", "'debug' needs 'T: ")

@test("debug takes exactly one value, and yields to a function of the name")
pan_debug_form()
    if xvr_no_library() then return

    pan_refused("print(debug(1, 2))\n", "debug takes exactly one value")
    assert_eq(xvr_ran([("main.sysl", "debug(x: int) -> int = x * 2\n\nprint(debug(21))\n")]), "42\n")

@test("printing a struct through its supplied Debug allocates nothing")
pan_no_alloc()
    if xvr_no_library() then return

    val text = "@no_alloc\nshow_point()\n    print(Point(1, 2), Red, Name(\"n\"))\n\nshow_point()\n"

    assert_eq(pan_ran(text), "Point(x: 1, y: 2) Color.Red Name(s: \"n\")\n")

// A writer's table carries no `Debug` slot, so a bare `&Writer` prints `<writer>`; a trait that
// requires `Debug` beside `Writer` is the escape hatch, and its objects print the concrete sink.
private pan_sink() -> string =
    "struct Tally\n    n: usize\n\nimpl Fallible for Tally\n\nimpl Writer for Tally\n" +
    "    write(*self, bytes: []const u8)\n        self.n = self.n + bytes.len\n\n" +
    "struct Quiet\n    n: usize\n\nimpl Fallible for Quiet\n\nimpl Writer for Quiet\n" +
    "    write(*self, bytes: []const u8)\n        self.n = self.n + bytes.len\n\n" +
    "impl Debug for Quiet\n    debug(self, out: *Writer, fmt: FormatSpec) = display_pad(\"Quiet\".bytes, out, fmt)\n\n" +
    "trait LoggedWriter: Writer + Debug\n\n" +
    "impl LoggedWriter for Tally\n\nimpl LoggedWriter for Quiet\n\n"

@test("a bare writer object prints <writer>, and one whose trait requires Debug prints the sink")
pan_logged_writer()
    if xvr_no_library() then return

    val text = pan_sink() +
               "val w: &Writer = Tally(3)\nval l: &LoggedWriter = Tally(4)\nval q: &LoggedWriter = Quiet(5)\n" +
               "print(w)\nprint(l)\nprint(q)\nprint(f\"${l}%?\")\n"

    assert_eq(pan_ran(text), "<writer>\nTally(n: 4)\nQuiet\nTally(n: 4)\n")

@test("a concrete writer prints through its supplied or its own Debug")
pan_concrete_writer()
    if xvr_no_library() then return

    assert_eq(pan_ran(pan_sink() + "print(Tally(1))\nprint(Quiet(2))\nprint(debug(Tally(3)))\n"),
              "Tally(n: 1)\nQuiet\nTally(n: 3)\n")

// -- printing a placeholder directly is warned about -----------------------------------------------

private var pan_library_cache: Buf[Program] = buf()
private var pan_library_read: bool = false

private pan_library() -> Buf[Program]
    if pan_library_read then return pan_library_cache

    pan_library_read = true

    std_root() match
        Err(_) -> ()
        Ok(root) -> std_units(root, host_target()) match
            Err(_) -> ()
            Ok(units) -> pan_library_cache = units

    pan_library_cache
end pan_library

// The warnings a program is given, as their messages, in source order.
private pan_warnings(text: string) -> Buf[string]
    var units: Buf[Program] = buf()

    for item in pan_library()
        units.push(item)

    units.push(parse(source_of("main.sysl", forms_imported(pan_types() + pan_sink() + text))).program)

    val done = analyze_bodies(units, host_target())
    var out: Buf[string] = buf()

    for item in done.an.warnings()
        out.push(item.diag.message)

    out
end pan_warnings

private pan_warned(text: string, said: string)
    val got = pan_warnings(text)

    assert_eq(got.len(), 1)
    assert(got.at(0).contains(said), got.at(0))

@test("printing a bare writer object warns once, and still prints <writer>")
pan_warns_on_a_writer()
    if xvr_no_library() then return

    pan_warned("val w: &Writer = Tally(1)\nprint(w)\n",
               "printing 'w' shows only '<writer>': a Writer object carries no Debug; print the " +
               "concrete sink, or ask for 'Writer + Debug'")
    pan_warned("val w: &Writer = Tally(1)\nval s = w.to_string()\n", "shows only '<writer>'")
    pan_warned("val w: &Writer = Tally(1)\nval s = s\"${w}\"\n", "shows only '<writer>'")
    pan_warned("val w: &Writer = Tally(1)\nval s = f\"${w}%?\"\n", "shows only '<writer>'")
    pan_warned("val w: &Writer = Tally(1)\nval s = debug(w)\n", "shows only '<writer>'")
    assert_eq(pan_ran(pan_sink() + "val w: &Writer = Tally(1)\nprint(w)\n"), "<writer>\n")

@test("printing a callable, or a type with no Debug, warns once")
pan_warns_on_a_callable()
    if xvr_no_library() then return

    pan_warned("val f: &Fn(int) -> int = (x: int) -> x + 1\nprint(f)\n", "printing 'f' shows only '<fn>'")
    pan_warned("opaque struct H\n    x: int\n\nval h = H(1)\nprint(h)\n", "printing 'h' shows only '<H>'")
    assert_eq(pan_ran("opaque struct H\n    x: int\n\nval h = H(1)\nprint(h)\n"), "<H>\n")

@test("an assert_eq whose sides are shown only as placeholders warns at the call")
pan_warns_on_assert_eq()
    if xvr_no_library() then return

    pan_warned("show[T: Debug](x: T) = ()\nval f: &Fn(int) -> int = (x: int) -> x + 1\nshow(f)\n",
               "'show' shows its 'T' only as '<fn>'")

@test("a placeholder inside a structure, and a writer whose trait asks Debug, warn about nothing")
pan_nested_placeholders_do_not_warn()
    if xvr_no_library() then return

    val text = "struct Job\n    run: &Fn(int) -> int\n\n" +
               "val f: &Fn(int) -> int = (x: int) -> x + 1\nval l: &LoggedWriter = Tally(2)\n" +
               "val o: Option[&Fn(int) -> int] = Some(f)\n" +
               "print(Job(f))\nprint(o)\nprint(l)\nprint(f\"${l}%?\")\n"

    val said = pan_warnings(text)

    assert(said.is_empty(), if said.is_empty() then "" else said.at(0))
