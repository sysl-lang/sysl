module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.fs.{make_temp_dir, remove_dir_all, write_text}
import sysl.text.{join, split, Search}

// A refusal about the command is introduced by the binary's own name, `sysl: error: `, as the
// reference introduces one, and a source diagnostic anchored at a file is not. `main` sends a line
// beginning with that lead to standard error, so the lead is also what decides the stream.

private clp_run(args: []string) -> (int, string)
    var lines: Buf[string] = buf()
    val sink = &lines
    val code = run_cli(args, (line) -> sink.push(line))

    (code, join(lines.view(), "\n"))
end clp_run

@test("a path that is not there is refused under the command's name, in the reference's words")
clp_a_missing_path_is_refused_with_the_lead()
    val dir = make_temp_dir("sysl-clp-").unwrap()
    val gone = s"$dir/nowhere"
    val got = clp_run(["sysl", "build", gone])

    assert_eq(got.0, Failed, got.1)
    assert_eq(got.1, s"sysl: error: cannot read $gone: '$gone' does not exist")
    remove_dir_all(dir).unwrap_or(())

@test("build-lib -o is refused under the command's name")
clp_an_output_for_build_lib_is_refused_with_the_lead()
    val got = clp_run(["sysl", "build-lib", "/does/not/matter", "-o", "x.syslib"])

    assert_eq(got.0, Misused, got.1)
    assert_eq(got.1, "sysl: error: build-lib writes nothing anybody names — it checks a library, and " +
                     "what it compiles is this compiler's cache, found by the compiler alone — so it " +
                     "takes no -o")

@test("--all-features beside --no-default-features is refused under the command's name")
clp_a_feature_conflict_is_refused_with_the_lead()
    val got = clp_run(["sysl", "build", "/does/not/matter", "--all-features", "--no-default-features"])

    assert_eq(got.1, "sysl: error: --all-features says every feature the manifest declares is wanted, " +
                     "and --features/--no-default-features each say something narrower about the same " +
                     "set — a compilation cannot ask for both")

@test("a source diagnostic is anchored at its file and carries no lead, so it is not a refusal")
clp_a_source_diagnostic_carries_no_lead()
    val dir = make_temp_dir("sysl-clp-").unwrap()
    val file = s"$dir/bad.sysl"

    write_text(file, "f() -> int = (1 +\n").unwrap()

    val got = clp_run(["sysl", "emit-ast", file])

    assert_eq(got.0, Failed, got.1)
    assert_eq(got.1, s"error: expression expected\n --> $file:2:1\n  |\n2 | \n  | ^")
    assert(!got.1.starts_with(RefusalLead), got.1)
    remove_dir_all(dir).unwrap_or(())

// -- options no command takes ----------------------------------------------------------------------
//
// A command line the option reader cannot make sense of is told in the reference's own words --
// `Error: Unknown option <flag>` or `Error: Missing value after <flag>`, one line per mistake -- with
// the command's usage under them, and exits 2. Before, an unknown flag was taken for the path and a
// typo such as `--relase` did nothing and said nothing.

private val clp_commands: [3]string = ["build", "test", "run"]

@test("an unknown long option is refused by build, test and run, in the reference's words")
clp_an_unknown_long_option_is_refused()
    for command in clp_commands
        val got = clp_run(["sysl", command, "/does/not/matter", "--frobnicate"])

        assert_eq(got.0, Misused, got.1)
        assert(got.1.starts_with(s"Error: Unknown option --frobnicate\nusage: sysl $command "), got.1)

@test("an unknown short option is refused by build, test and run")
clp_an_unknown_short_option_is_refused()
    for command in clp_commands
        val got = clp_run(["sysl", command, "/does/not/matter", "-x"])

        assert_eq(got.0, Misused, got.1)
        assert(got.1.starts_with(s"Error: Unknown option -x\nusage: sysl $command "), got.1)

@test("an unknown option ahead of the path is not taken for the path")
clp_an_unknown_option_ahead_of_the_path()
    val got = clp_run(["sysl", "build", "--relase", "/does/not/matter"])

    assert_eq(got.0, Misused, got.1)
    assert(got.1.starts_with("Error: Unknown option --relase\nusage: sysl build "), got.1)

@test("every unknown option is named, one to a line, with the usage once under them")
clp_every_unknown_option_is_named()
    val got = clp_run(["sysl", "test", "/does/not/matter", "--frob", "-x"])

    assert_eq(got.0, Misused, got.1)
    assert(got.1.starts_with("Error: Unknown option --frob\nError: Unknown option -x\nusage: sysl test "),
           got.1)
    assert_eq(split(got.1, "usage:").len, 2)

@test("an option another command takes is unknown to one that does not: -o on test")
clp_another_commands_option_is_unknown()
    val got = clp_run(["sysl", "test", "/does/not/matter", "-o", "foo"])

    assert_eq(got.0, Misused, got.1)
    assert(got.1.starts_with("Error: Unknown option -o\nusage: sysl test "), got.1)

@test("an option with nothing after it is a missing value, in the reference's words")
clp_a_missing_value_is_named()
    for command in clp_commands
        val got = clp_run(["sysl", command, "/does/not/matter", "--target"])

        assert_eq(got.0, Misused, got.1)
        assert(got.1.starts_with(s"Error: Missing value after --target\nusage: sysl $command "), got.1)

    val filter = clp_run(["sysl", "test", "/does/not/matter", "--filter"])

    assert(filter.1.starts_with("Error: Missing value after --filter\n"), filter.1)

    val features = clp_run(["sysl", "build", "/does/not/matter", "--features"])

    assert(features.1.starts_with("Error: Missing value after --features\n"), features.1)

@test("a valid option is still taken, and the command goes on to the path")
clp_a_valid_option_is_still_taken()
    for command in clp_commands
        val got = clp_run(["sysl", command, "/does/not/exist/clp", "-O2", "--target", "aarch64-macos"])

        assert_eq(got.0, Failed, got.1)
        assert(got.1.starts_with(RefusalLead), got.1)

@test("a lone '-' is a path, not an option")
clp_a_lone_dash_is_a_path()
    val got = clp_run(["sysl", "build", "-"])

    assert_eq(got.0, Failed, got.1)
    assert(got.1.index_of("Unknown option").is_none(), got.1)

@test("an option every command takes is taken by one that does nothing with it, as the reference's is")
clp_an_any_command_option_is_taken_everywhere()
    val got = clp_run(["sysl", "tidy", "/does/not/exist/clp", "--cc", "/x", "-O2", "--target", "wasm32"])

    assert_eq(got.0, Failed, got.1)
    assert(got.1.index_of("Unknown option").is_none(), got.1)

@test("--help after a command answers with the usage, and --version with the version")
clp_help_after_a_command()
    val help = clp_run(["sysl", "build", "/does/not/matter", "--help"])
    val version = clp_run(["sysl", "test", "--version"])

    assert_eq(help.0, Fine, help.1)
    assert(help.1.starts_with("Usage: sysl [run|build|"), help.1)
    assert_eq(version.0, Fine, version.1)
    assert_eq(version.1, s"sysl ${Version}")

@test("emit-header and build-lib name an unknown option in the same words")
clp_emit_header_and_build_lib_agree()
    for command in ["emit-header", "build-lib", "emit-ast", "emit-typed", "emit-llvm", "build-c", "deps",
                    "tidy"]
        val got = clp_run(["sysl", command, "/does/not/matter", "--frob"])

        assert_eq(got.0, Misused, s"$command: ${got.1}")
        assert(got.1.starts_with(s"Error: Unknown option --frob\nusage: sysl $command"), got.1)

    val added = clp_run(["sysl", "add", "github.com/sysl-lang/clp", "--frob"])

    assert_eq(added.0, Misused, added.1)
    assert(added.1.starts_with("Error: Unknown option --frob\nusage: sysl add "), added.1)

// What comes after `--` is the program's, options and `--help` among them, and reaches it untouched.
// The program exits 0 only where it was handed exactly those four.
@test("a run's arguments after '--' reach the program, those spelled as options included")
clp_program_arguments_after_the_separator()
    if !(std_root().is_ok() && clang_available()) then return

    val dir = make_temp_dir("sysl-clp-run-").unwrap()
    val file = s"$dir/main.sysl"

    write_text(file, "main(args: []string)\n" +
        "    val want = [\"--frob\", \"-x\", \"-\", \"--help\"]\n" +
        "    if args.len != 5 then exit(3)\n" +
        "    for i in 0..<4\n" +
        "        if args[i + 1] != want[i] then exit(4)\n").unwrap()

    val got = clp_run(["sysl", "run", file, "--", "--frob", "-x", "-", "--help"])

    assert_eq(got.0, 0, got.1)

    val ahead = clp_run(["sysl", "run", file, "--frob", "--", "-x"])

    assert_eq(ahead.0, Misused, ahead.1)
    assert(ahead.1.starts_with("Error: Unknown option --frob\nusage: sysl run "), ahead.1)
    remove_dir_all(dir).unwrap_or(())
