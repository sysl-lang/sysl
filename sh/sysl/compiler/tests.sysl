module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.fs.{make_temp_dir, read_text, remove_file, write_text}
import sysl.text.Search

// What the driver says and answers, asserted through `run_cli` rather than the terminal.

// **A closure captures by value, so the buffer is reached through a pointer**: `lines` itself
// captured would be a copy filled and thrown away, and the test would read an empty one.
said(args: []string) -> (Buf[string], int)
    var lines: Buf[string] = buf()
    val sink = &lines
    val code = run_cli(args, (line: string) -> sink.push(line))

    (lines, code)

@test("--version answers the version and exits fine")
version_is_answered()
    val (lines, code) = said(["sysl", "--version"])

    assert_eq(code, Fine)
    assert_eq(lines.len(), 1)
    assert_eq(lines.at(0), s"sysl ${Version}")

@test("no arguments is a misuse, and the usage is said")
nothing_is_a_misuse()
    val (lines, code) = said(["sysl"])

    assert_eq(code, Misused)
    assert_eq(lines.at(0), usage())

@test("a command the compiler cannot carry out yet is named back, and is a misuse")
an_unknown_command_is_named()
    val (lines, code) = said(["sysl", "build"])

    assert_eq(code, Misused)
    assert(lines.at(0).contains("`build`"), "the command is named in the refusal")

// **The version in `main.sysl` is the one in `package.hocon`.** A bump made in one place and not
// the other fails here rather than shipping a binary that misreports itself.
@test("the version here is the manifest's")
version_matches_the_manifest()
    val manifest = read_text("package.hocon").unwrap()

    assert(manifest.contains(s"version = \"${Version}\""), "package.hocon names the same version")

// -- emit-ast ----------------------------------------------------------------------------------

// **`emit-ast` is the one command the driver carries out today**, and it exists so that two
// compilers can be diffed rather than compared by hand. What is asserted here is the command line
// -- the flag, the refusals, the shape of what comes back -- rather than the rendering itself,
// which `tests_oracle.sysl` holds against the reference compiler node for node.

// One file written where the tests may write, and read back through `run_cli`.
private emitted(source: string, flags: []string) -> (Buf[string], int)
    val dir = make_temp_dir("sysl-emit").unwrap()
    val at = dir + "/one.sysl"

    write_text(at, source).unwrap()

    var args: Buf[string] = buf()

    args.push("sysl")
    args.push("emit-ast")

    for flag in flags do args.push(flag)

    args.push(at)

    val answer = said(args.view())

    remove_file(at)
    answer
end emitted

@test("emit-ast prints the tree, with every node's span")
emit_ast_prints_the_tree()
    val (lines, code) = emitted("f() = 1\n", [])

    assert_eq(code, Fine)
    assert(lines.at(0).starts_with("Program\n"), "the file is the root of what is printed")
    assert(lines.at(0).contains("- FuncDecl 1:1-1:8"), "a node carries the span it was read at")
    assert(lines.at(0).contains("value: 1\n"), "and the literal's value is written out")

@test("and --no-spans prints the same tree with no positions in it")
emit_ast_drops_the_spans()
    val (lines, code) = emitted("f() = 1\n", ["--no-spans"])

    assert_eq(code, Fine)
    assert(lines.at(0).contains("- FuncDecl\n"), "the node is there without its span")
    assert(!lines.at(0).contains("1:1-1:8"), "and no position is written anywhere")

@test("a file emit-ast cannot read is a failure, and the file is named")
emit_ast_names_a_file_it_cannot_read()
    val (lines, code) = said(["sysl", "emit-ast", "no/such/file.sysl"])

    assert_eq(code, Failed)
    assert(lines.at(0).contains("no/such/file.sysl"), "the refusal names the file")

@test("a file the parser refuses is a failure, and the complaint is quoted at its line")
emit_ast_quotes_a_refusal()
    val (lines, code) = emitted("f(] = 1\n", [])

    assert_eq(code, Failed)
    assert(lines.at(0).contains("1:3"), "the complaint carries the line and column")

@test("emit-ast with no file at all is a misuse")
emit_ast_needs_a_file()
    val (lines, code) = said(["sysl", "emit-ast", "--no-spans"])

    assert_eq(code, Misused)
    assert(lines.at(0).contains("emit-ast"), "the usage names the command")
