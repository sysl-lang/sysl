module sysl.fs.sys
@requires(os)

// -- extended attributes -----------------------------------------------------------------------------
//
// Named byte values kept beside a file's contents, which `sysl.fs`'s `get_xattr` family is written
// over. **Every hook takes `follow`**: non-zero asks about what a symbolic link at `path` points at,
// zero about the link itself, the split `stat` makes. A name is a pointer and a length like a path,
// and a supplier that needs a terminator after either makes its own copy.
//
// **The two hooks that answer bytes are asked twice.** With `room` zero they write the size the answer
// would take to `got` and copy nothing, and `into` may be null; with room they copy at most `room`
// bytes and write how many to `got`, answering `ERANGE` (-34) where the answer has grown past `room`
// since the size was asked. That is the C library's own protocol, so a hosted supplier passes it
// through.
//
// A missing attribute is the platform's own code for one -- `ENOATTR` (93) on a BSD, `ENODATA` (61)
// on Linux -- which `sysl.fs` names `NoAttribute`. A filesystem keeping no attributes answers its
// `ENOTSUP`; a target with no way to ask answers `UNSUPPORTED`.

/** The value of the attribute `name` of `path`, copied into `into`, with its length written to `got`;
 * with `room` zero, only the length.
 */
@needs(os)
private[fs] extern "sysl_fs_getxattr" getxattr(path: *u8, len: usize, name: *u8, name_len: usize,
                                               follow: int, into: *u8, room: usize, got: *usize) -> int

/** The attribute `name` of `path` set to the `value_len` bytes at `value`, made where it is missing
 * and replaced where it is not.
 */
@needs(os)
private[fs] extern "sysl_fs_setxattr" setxattr(path: *u8, len: usize, name: *u8, name_len: usize,
                                               value: *u8, value_len: usize, follow: int) -> int

/** The attribute `name` of `path` removed. */
@needs(os)
private[fs] extern "sysl_fs_removexattr" removexattr(path: *u8, len: usize, name: *u8, name_len: usize,
                                                     follow: int) -> int

/** The names of every attribute of `path`, each followed by a zero byte, copied into `into`, with
 * their length written to `got`; with `room` zero, only the length.
 */
@needs(os)
private[fs] extern "sysl_fs_listxattr" listxattr(path: *u8, len: usize, follow: int, into: *u8,
                                                 room: usize, got: *usize) -> int
