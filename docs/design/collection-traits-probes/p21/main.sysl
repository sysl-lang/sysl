// p21: the adapter default stores an UNBOUNDED callable type; the bound lives on the adapter's impl.
trait It
    type Item
    next(*self) -> Option[Self::Item]

    map[R, G](self, g: G) -> MapIt[Self, G, R] = MapIt(self, g)

struct Count
    n: int
    stop: int

impl It for Count
    type Item = int
    next(*self) -> Option[int]
        if self.n >= self.stop then return None
        val v = self.n
        self.n += 1
        Some(v)

struct MapIt[I, F, U]
    src: I
    f: F

impl[I: It, F: Fn1[I::Item, U], U] It for MapIt[I, F, U]
    type Item = U
    next(*self) -> Option[U]
        self.src.next() match
            Some(x) -> Some(self.f(x))
            None -> None

main()
    var m = Count(0, 4).map((x: int) -> x * 10)
    var t = 0
    loop
        m.next() match
            Some(v) -> t += v
            None -> break
    print(t)
