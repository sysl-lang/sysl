module sh.sysl.compiler
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.Search
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture

// `Zero` and `One` at the integers -- the compiler-provided membership whose member has no receiver
// (`reference/expressions.md § Operator dispatch`). An identity has no value in hand, so the member
// is reached through the type: the constant arrives at the receiver's own width, a bound naming
// either trait takes an integer, and the two types deliberately left out -- a constrained subtype
// and a vector -- are refused.
//
// **Every string quoted here was read out of the reference compiler**, whose `ZeroOneTests` these
// are.

private var zro_library_cache: Buf[Program] = buf()
private var zro_library_read: bool = false

private zro_library() -> Buf[Program]
    if zro_library_read then return zro_library_cache

    zro_library_read = true

    std_root() match
        Err(_) -> ()
        Ok(root) -> std_units(root, host_target()) match
            Err(_) -> ()
            Ok(units) -> zro_library_cache = units

    zro_library_cache
end zro_library

// Every claim here is about a whole program, so all of them want the library and a toolchain.
private zro_ready() -> bool
    if zro_library().is_empty()
        print("skipped: the standard module's source is not on this machine")
        return false
    end if

    if !clang_available()
        print("skipped: there is no clang on this machine")
        return false
    end if

    true
end zro_ready

private zro_says(text: string, part: string) -> bool = text.index_of(part).is_some()

// What a program prints.
private zro_ran(text: string) -> string
    val root = make_temp_dir("sysl-zero-one").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", text).unwrap()

    val exe = s"$root/built"

    build_native_program(s"$root/main.sysl", None, None, DefaultOptimization, Some(exe)) match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return failure_text(why)
        Ok(_) -> ()

    val said = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    said match
        Err(_) -> "the program that was built could not be run"
        Ok(out) -> out.text
end zro_ran

// Everything a source has to say for itself, taken through the lowering.
private zro_err(text: string) -> string
    val root = make_temp_dir("sysl-zero-one").unwrap()
    val src = s"$root/main.sysl"

    make_dir_all(root).unwrap()
    write_text(src, text).unwrap()

    val out = emit_llvm_text(src, None) match
        Err(why) -> why.message
        Ok(made) -> if made.report.is_empty() then "" else analysis_report(made.report)

    remove_dir_all(root).unwrap_or(())
    out
end zro_err

// The LLVM text of a program that must compile.
private zro_ir(text: string) -> string
    val root = make_temp_dir("sysl-zero-one").unwrap()
    val src = s"$root/main.sysl"

    make_dir_all(root).unwrap()
    write_text(src, text).unwrap()

    val out = emit_llvm_text(src, None) match
        Err(why) -> s"did not compile: ${why.message}"
        Ok(made) ->
            if !made.report.is_empty() then s"did not compile: ${analysis_report(made.report)}"
            else made.text

    remove_dir_all(root).unwrap_or(())
    out
end zro_ir

private zro_sum() -> string = raw"""
    sum[T: Add + Zero](xs: []T) -> T
        var total = T.zero()
        for i in 0..<xs.len
            total = total + xs[i]
        total
    end sum
    """

// -- reached through the type

@test("an integer answers both identities")
zro_integer_answers_both()
    if !zro_ready() then return

    assert_eq(zro_ran("print(int.zero(), int.one())\n"), "0 1\n")

// The constant is the receiver type's, not `int`'s, and the wrap is what says so: at `u8` the sum is
// 0, and at any wider type it would be 256.
@test("the constant takes the width it was named at")
zro_takes_the_width_named()
    if !zro_ready() then return

    assert_eq(zro_ran("var top: u8 = 255\nprint(u8.one() + top)\n"), "0\n")

// `u12` and `i5` are types a program may name, so no list of `impl` blocks could have covered them.
@test("reaches widths no impl block could have been written for")
zro_reaches_odd_widths()
    if !zro_ready() then return

    assert_eq(zro_ran("var a: u12 = u12.zero()\nvar b: i5 = i5.one()\nprint(a == 0, b == 1)\n"),
              "true true\n")

@test("a float still reaches the written impl beside it")
zro_float_reaches_written_impl()
    if !zro_ready() then return

    assert_eq(zro_ran("print(real.zero() == 0.0, real.one() == 1.0, f32.one() == 1.0f32)\n"),
              "true true true\n")

// -- a bound naming either trait

@test("takes an integer")
zro_bound_takes_an_integer()
    if !zro_ready() then return

    assert_eq(zro_ran("bump[T: Add + One](x: T) -> T = x + T.one()\n\nprint(bump(3))\n"), "4\n")

@test("accumulates from the identity over integers and over floats alike")
zro_accumulates_ints_and_floats()
    if !zro_ready() then return

    assert_eq(zro_ran(zro_sum() + "\nprint(sum([1, 2, 3]), sum([1.5, 2.5]) == 4.0)\n"), "6 true\n")

@test("the empty sequence answers the identity itself")
zro_empty_answers_identity()
    if !zro_ready() then return

    assert_eq(zro_ran(zro_sum() + "\nvar none: []int = []\nprint(sum(none))\n"), "0\n")

@test("a product starts from one")
zro_product_starts_from_one()
    if !zro_ready() then return

    val text = raw"""
        product[T: Mul + One](xs: []T) -> T
            var acc = T.one()
            for i in 0..<xs.len
                acc = acc * xs[i]
            acc
        end product

        print(product([1, 2, 3, 4]))
        """

    assert_eq(zro_ran(text), "24\n")

// An identity is a literal at the instantiation, so the accumulator costs no call and nothing is
// emitted for the trait.
@test("lowers to the literal, not to a call")
zro_lowers_to_the_literal()
    if !zro_ready() then return

    val ir = zro_ir(zro_sum() + "\nprint(sum([1, 2, 3]))\n")

    assert(!zro_says(ir, "did not compile"), ir)
    assert(!zro_says(ir, "Zero.zero"), "the identity was lowered to a call")

// -- what is deliberately not a member

// These promise a value, and a range written to exclude zero has not got one.
@test("a constrained subtype, whose range need not hold the value")
zro_constrained_subtype_refused()
    if !zro_ready() then return

    val text = raw"""
        type Small = int within 1..10

        first[T: Zero](x: T) -> T = T.zero()

        var s: Small = 5
        print(first(s))
        """

    val said = zro_err(text)

    assert(zro_says(said, "'first' requires its type parameter 'T' to implement 'sysl.Zero', but Small does not"),
           said)

@test("a vector, which has lanes the member names none of")
zro_vector_refused()
    if !zro_ready() then return

    val text = raw"""
        first[T: Zero](x: T) -> T = T.zero()

        val v: <4>i32 = [1, 2, 3, 4]
        print(first(v)[0])
        """

    val said = zro_err(text)

    assert(zro_says(said, "'first' requires its type parameter 'T' to implement 'sysl.Zero', but <4>int does not"),
           said)

// -- the other spellings of the type

@test("`Self` inside a member's body")
zro_self_inside_a_member()
    if !zro_ready() then return

    val text = raw"""
        trait Counter
            start() -> Self

        impl Counter for u16
            start() -> u16 = Self.zero()

        print(u16.start())
        """

    assert_eq(zro_ran(text), "0\n")

@test("a transparent alias, which is its base type")
zro_transparent_alias()
    if !zro_ready() then return

    assert_eq(zro_ran("type Word = u32\n\nvar w: Word = Word.one()\nprint(w)\n"), "1\n")

// The literal is a constant, so it reaches the static emitter rather than a function body.
@test("module storage, which is initialized before anything runs")
zro_module_storage()
    if !zro_ready() then return

    assert_eq(zro_ran("val base: usize = usize.zero()\n\nprint(base, base + 1)\n"), "0 1\n")

@test("a width past what the mixer and the machine word hold")
zro_width_past_the_word()
    if !zro_ready() then return

    assert_eq(zro_ran("var big: u128 = u128.one()\nprint(big == 1, u128.zero() == 0)\n"), "true true\n")

// -- the refusals

@test("an argument is refused, the member taking none")
zro_argument_refused()
    if !zro_ready() then return

    val said = zro_err("print(int.zero(1))\n")

    assert(zro_says(said, "associated function 'Zero.zero' takes no arguments, but 1 argument was given"),
           said)

// The membership is the compiler's, so a block for one competes with what is already there -- the
// same complaint `impl Add for int` gets.
@test("an impl block for an integer is refused as already provided")
zro_impl_block_refused()
    if !zro_ready() then return

    val said = zro_err("impl Zero for int\n    zero() -> int = 0\n\nprint(1)\n")

    assert(zro_says(said, "'int' already implements 'sysl.Zero' — the compiler provides it"), said)

@test("reading it without the parentheses says what a float's read says")
zro_bare_read_refused()
    if !zro_ready() then return

    val provided = zro_err("print(int.zero)\n")
    val written = zro_err("print(real.zero)\n")

    assert(zro_says(provided, "'int' is a type, not a value, and has no associated function 'zero'"),
           provided)
    assert(zro_says(written, "'zero' is an associated function of 'real' — call it with 'real.zero()'"),
           written)

@test("a name the trait does not declare is still missing")
zro_undeclared_name_missing()
    if !zro_ready() then return

    val said = zro_err("print(int.two())\n")

    assert(zro_says(said, "int has no associated function 'two'"), said)
