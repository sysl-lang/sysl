module sh.sysl.compiler
@tests

@test("PROBE")
mv_probe()
    print(pf("struct P\n    private x: int\nend P"))
    print(pf("struct P\n    private[geom] x: int\nend P"))
    print(pf("struct P\n    private step(self) -> int = 1\nend P"))
    print(pf("struct P\n    private twice -> int = 2\nend P"))
    print(pf("enum E\n    A\n    private step(self) -> int = 1\nend E"))
    print(pf("struct P\n    x: int\nend P"))
    print(pf("struct P\n    private invariant: int\nend P"))
    assert_eq(1, 2)
