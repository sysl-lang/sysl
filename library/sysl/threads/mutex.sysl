module sysl.threads
@requires(os)

import sysl.sync.*
import sysl.threads.sys as tsys

/** A lock that sleeps, and guards nothing of its own: the classic three-state futex lock.
 *
 * **The word is zero when free, one when held, and two when held with a thread asleep on it**, so an
 * uncontended `lock` and `unlock` are one atomic operation each and never reach the system, and only
 * an `unlock` that may have a sleeper to wake calls `sysl_futex_wake`. A waiter sleeps in
 * `sysl_futex_wait` rather than spinning or yielding, so a contended lock costs nothing while it waits.
 *
 * It is what `Mutex[T]` and `Channel[T]` are built on, and it is public for the hold neither of them
 * expresses: a lock beside data the program names itself, as `SpinLock` is, for code that may sleep.
 */
struct Lock

    // 0 free, 1 held, 2 held and contended. The futex word: its address is what a waiter sleeps on.
    private state: Atomic[u32]

    /** A free lock. */
    new() -> Lock = Lock(Atomic(0))

    /** Takes the lock, sleeping until it is free. */
    @blocks
    lock(*self)
        var seen = self.state.cas(0, 1, Acquire)

        if seen == 0 then return

        // Contended: mark the word as having a sleeper before sleeping, so the holder's `unlock`
        // knows to wake somebody -- and take the lock in the same exchange where it came free.
        if seen != 2 then seen = self.state.swap(2, Acquire)

        while seen != 0
            tsys.futex_wait(&self.state.v, 2, -1)
            seen = self.state.swap(2, Acquire)
    end lock

    /** Takes the lock if it is free, and answers whether it did. Never waits. */
    try_lock(*self) -> bool = self.state.cas(0, 1, Acquire) == 0

    /** Releases the lock, waking one sleeper where there may be one.
     *
     * The `Release` publishes everything the holder wrote to whichever thread's `Acquire` takes the
     * lock next.
     */
    unlock(*self)
        if self.state.swap(0, Release) == 2 then tsys.futex_wake(&self.state.v, 1)

end Lock

/** Mutual exclusion that **owns what it protects**, which is the difference `library/threads.md §
 * Mutex[T]` draws against `SpinLock`.
 *
 * A spinlock is a flag beside the data and what the data is stays the programmer's to remember. This
 * holds the `T`, and both of its fields are private -- so there is no way to reach the value that
 * does not go through the lock, and no way to build one that skips the free state.
 *
 * **`with` is the way in**: it takes the lock, hands a closure the address of the value, and releases
 * the lock when the closure returns. The address is lent (`@lends`), so the compiler holds the closure
 * to letting it go -- returning it, storing it, or passing it to something that keeps it is refused,
 * which is the one mistake a returned address could not prevent: using it after the release.
 *
 * ```
 * m.with((n) -> *n += 1)
 * ```
 *
 * `lock_raw` and `unlock_raw` are the hold a block cannot express -- taken in one function and
 * released in another, or held across a `Condvar.wait`. Nothing ties their address to the hold,
 * which is what the name says.
 *
 * **`@guards(value)` is what lets one cross into a `&sync`** whatever it holds (`reference/memory.md §
 * A guarded value crosses with its lock`): sharing the lock does not share the value, and what leaves
 * through `with` or `try_with` is held to the `&sync` rule instead -- an `int` or a `.copy()` of a
 * string, not the `Map` or a string still sharing the guarded one's count.
 *
 * **The lock is a `Lock`, written in sysl over an `Atomic[u32]` and the futex hooks**, not a
 * `pthread_mutex_t`: a caller-allocated C struct's size is in a header and differs between libcs on
 * one platform, and the futex is what every system that has threads has underneath its own mutex. A
 * waiter sleeps; it neither spins nor yields.
 */
@guards(value)
struct Mutex[T]

    // The lock. Private for the reason the value is: everything the type promises is that the two
    // are only ever reached together.
    private lock: Lock

    // What the lock protects. Private is the whole of what "owns" means here -- with it public,
    // `m.value` would be an unsynchronized read of the thing the type exists to synchronize.
    private value: T

    /** Builds a free lock around a value.
     *
     * The positional constructor names every field in order (`reference/declarations.md §
     * Structs`), so a private field is what makes this the only way in from outside -- which is
     * what keeps the lock starting free.
     */
    new(value: T) -> Mutex[T] = Mutex(Lock.new(), value)

    /** Takes the lock, waiting until it is free, runs `body` with the address of what it protects,
     * releases the lock, and answers what `body` answered.
     *
     * The address is valid only while `body` runs, and the compiler holds `body` to that: it may read
     * and write through the address, and pass it to a callee that only uses it, but not return it,
     * store it, or hand it to something that keeps it (`reference/memory.md § A pointer lent for one
     * call`). A closure is not an allocation here -- the parameter is a type parameter, so each call is
     * a direct call of the closure's own body, and this is usable under `@no_alloc`.
     */
    @lends(body)
    @blocks
    with[R](*self, body: *T -> R) -> R
        self.lock_raw()

        defer self.unlock_raw()
        body(&self.value)

    /** The same, if the lock is free: `Some` of what `body` answered, or `None` without waiting. */
    @lends(body)
    try_with[R](*self, body: *T -> R) -> Option[R]
        if !self.lock.try_lock() then return None

        defer self.unlock_raw()
        Some(body(&self.value))

    /** Takes the lock, waiting until it is free, and answers the address of what it protects.
     *
     * The address is live until `unlock_raw`, and nothing ties it to the hold -- holding on to it past
     * the release compiles. This is the hold a block cannot express, taken in one function and released
     * in another; where the hold fits a block, `with` is the one to write.
     */
    @blocks
    lock_raw(*self) -> *T
        self.lock.lock()
        &self.value

    /** Takes the lock if it is free, and answers what it protects where it did. Never waits. */
    try_lock_raw(*self) -> Option[*T] = if self.lock.try_lock() then Some(&self.value) else None

    /** Releases the lock a `lock_raw` or `try_lock_raw` took.
     *
     * The `Release` is what publishes everything the holder wrote through the address it was given,
     * to whichever thread's `Acquire` takes the lock next. That pairing is the whole of what makes
     * the data safe to touch, and it is why neither of these takes an `Ordering`: a lock's orderings
     * are fixed by what a lock means.
     */
    unlock_raw(*self) = self.lock.unlock()

end Mutex
