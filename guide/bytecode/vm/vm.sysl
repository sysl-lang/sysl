// The machine the compiler is aimed at: a stack of integers, a frame of variable slots, and a loop
// that reads one byte and does what it says.
//
// **Nothing here allocates.** The stack, the frame, and the decoder's working values are locals of
// `run`, and the one thing that would otherwise have to grow — the list of values the program
// printed — is a buffer the caller supplies. That shape is not decoration: a dispatch loop is the
// place where an allocator is least welcome, and writing the machine to need none is what the
// module is chosen to demonstrate.
//
// And it **says so**: the `no alloc` clause under the header is the module's own declaration that it
// makes no heap storage, and the compiler holds it to that — against every construction written here
// and against everything its calls arrive at. What had been a property of the code that a reader had
// to verify by reading is now one the build fails without.
//
// It cost one function. `describe`, which turned a `Trap` into a sentence, built a string per
// variant and so could not stay: the machine says *which* trap and where, and turning that into
// English is the caller's job, because a caller is something that has an allocator. That is not a
// concession to the clause — it is the shape freestanding code has anyway, and the clause is what
// made the seam visible instead of leaving it to taste.
//
// The machine does not trust the bytes it is given. Every opcode is decoded through the fallible
// constructor, every operand is checked to lie inside the chunk, every push is checked against the
// stack's height and every pop against its depth, and the whole run is bounded by a step budget so
// that a program that loops forever ends as an error rather than as a hang. That is what makes a
// hand-written chunk a thing this program can test rather than a way to crash it.

module vm
@no_alloc

import isa

enum Trap
    BadOpcode(at: usize)
    Truncated(at: usize)
    BadJump(at: usize)
    BadSlot(at: usize)
    Overflow(at: usize)
    Underflow(at: usize)
    DivideByZero(at: usize)
    Overrun(at: usize)
    NoRoom(at: usize)
    Runaway
end Trap

// How tall the stack is and how many steps a program may take. The stack's bound has to be written
// as a literal where the array is declared, so these two say the same number twice — a module has
// no constants for them to say it once.
depth() -> usize = 64usize

budget() -> int = 2000000

// Runs a program, writing what it prints into `out` and answering with how many values that was.
//
// The output buffer is the caller's, which is what keeps the machine free of an allocator: a
// program that prints more than the buffer holds is an error the caller can see and size for,
// rather than a growable list the machine would have to own.
run(c: &isa.Chunk, out: []int) -> Result[usize, Trap]
    var stack: [64]int
    var slots: [32]int
    var sp = 0usize
    var pc = 0usize
    var n = 0usize
    var fuel = budget()

    loop
        if fuel <= 0 then return Err(Runaway)
        fuel -= 1
        if pc >= c.len then return Err(Overrun(pc))

        c.op_at(pc) match
            None -> return Err(BadOpcode(pc))
            Some(o) ->
                if pc + isa.width(o) > c.len then return Err(Truncated(pc))

                o match
                    Halt -> return Ok(n)
                    Push ->
                        if sp >= depth() then return Err(Overflow(pc))
                        stack[sp] = c.imm_at(pc + 1)
                        sp += 1usize
                        pc += 5usize
                    Load ->
                        if sp >= depth() then return Err(Overflow(pc))

                        var i = c.slot_at(pc + 1)

                        if i >= c.slots then return Err(BadSlot(pc))
                        stack[sp] = slots[i]
                        sp += 1usize
                        pc += 2usize
                    Store ->
                        if sp < 1 then return Err(Underflow(pc))

                        var i = c.slot_at(pc + 1)

                        if i >= c.slots then return Err(BadSlot(pc))
                        sp -= 1usize
                        slots[i] = stack[sp]
                        pc += 2usize
                    Print ->
                        if sp < 1 then return Err(Underflow(pc))
                        if n >= out.len then return Err(NoRoom(pc))
                        sp -= 1usize
                        out[n] = stack[sp]
                        n += 1usize
                        pc += 1usize
                    Neg ->
                        if sp < 1 then return Err(Underflow(pc))
                        stack[sp - 1] = -stack[sp - 1]
                        pc += 1usize
                    Jmp ->
                        var t = c.target_at(pc + 1)

                        if t >= c.len then return Err(BadJump(pc))
                        pc = t
                    Jz ->
                        if sp < 1 then return Err(Underflow(pc))

                        var t = c.target_at(pc + 1)

                        if t >= c.len then return Err(BadJump(pc))
                        sp -= 1usize
                        if stack[sp] == 0 then pc = t
                        else pc += 3usize

                    // Everything left takes two values and leaves one, so the stack discipline is
                    // written once here and the opcode only says what to compute.
                    else
                        if sp < 2 then return Err(Underflow(pc))

                        var v = apply(o, stack[sp - 2], stack[sp - 1], pc)?

                        sp -= 1usize
                        stack[sp - 1] = v
                        pc += 1usize
end run

// A comparison answers 1 or 0, because the machine has one kind of value and `jz` is what reads
// the answer.
private apply(o: isa.Op, a: int, b: int, at: usize) -> Result[int, Trap]
    o match
        Add -> Ok(a + b)
        Sub -> Ok(a - b)
        Mul -> Ok(a * b)
        Div -> if b == 0 then Err(DivideByZero(at)) else Ok(a / b)
        Mod -> if b == 0 then Err(DivideByZero(at)) else Ok(a % b)
        Lt -> Ok(if a < b then 1 else 0)
        Le -> Ok(if a <= b then 1 else 0)
        Gt -> Ok(if a > b then 1 else 0)
        Ge -> Ok(if a >= b then 1 else 0)
        Eq -> Ok(if a == b then 1 else 0)
        Ne -> Ok(if a != b then 1 else 0)
        else Err(BadOpcode(at))
end apply
