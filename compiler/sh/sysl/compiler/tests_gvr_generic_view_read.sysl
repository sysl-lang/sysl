module sh.sysl.compiler
@tests

import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture

// A generic body's element read through a borrowed view, and who answers for it.
//
// **A generic body is read once at its definition, with its type parameters standing for whatever an
// instantiation picks, and everything that reading says is taken back** (`analyze_body.sysl`'s
// `check_abstract_body`): each instantiation reads the body again with the type it chose and says
// what is true of that type. A refusal waiting on a call's answer (`view_borrow.sysl`'s
// `ViewRefusal`, told by `settle_view_refusals` once every body is typed) is one of those things, so
// it is taken back with the rest. Kept, it said of `T` what only an instantiation knows: a `T` read
// out of a borrowed view through `at(self, i) -> T = self.data[i]` holds a view only where `T` is
// one, so `check(1.5)` was refused for storing an `f64` and for holding one across a push.
//
// The neighbours: the same body instantiated at a view element type is still refused, by that
// instantiation's own reading, for the store and for the hold; the same code written for a concrete
// view element type is refused as before; and a generic body's view of a type that is not a
// parameter, handed through a call and stored in module storage, is still refused through its
// instantiation.

private gvr_ready() -> bool
    if std_root().is_err()
        print("skipped: the standard module's source is not on this machine")
        return false

    if !clang_available()
        print("skipped: there is no clang on this machine")
        return false

    true
end gvr_ready

private gvr_head() -> string =
    "import sysl.buf.{Buf, buf, buf_filled}\n\n" +
    "struct M[T]\n    data: []T\n\n" +
    "impl[T] M[T]\n    at(self, i: usize) -> T = self.data[i]\n\n" +
    "id(v: []long) -> []long = v\n\n" +
    "check[T](x: T) -> T\n    var store: Buf[T] = buf_filled(4, x)\n    val m = M(store.view_mut())\n" +
    "    val want: Buf[T] = buf_filled(4, x)\n\n    want[0] = m.at(0)\n    want[0]\nend check\n\n" +
    "held[T](x: T, y: T) -> T\n    var store: Buf[T] = buf_filled(2, x)\n    var e = y\n\n" +
    "    if store.len() > 0\n        val m = M(store.view_mut())\n\n        e = m.at(0)\n\n" +
    "    store.push(y)\n    e\nend held\n\n"

private gvr_program(body: string) -> string = gvr_head() + body + "\nmain() = run()\n"

private gvr_root(text: string) -> string
    val root = make_temp_dir("sysl-generic-view").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", text).unwrap()
    root

// What analysing a program said, all of it.
private gvr_said(body: string) -> string
    val root = gvr_root(gvr_program(body))

    val out = emit_llvm_text(s"$root/main.sysl", None) match
        Err(why) -> failure_text(why)
        Ok(made) -> analysis_report(made.report)

    remove_dir_all(root).unwrap_or(())
    out
end gvr_said

// What a program printed, or what the compiler said instead.
private gvr_ran(body: string) -> string
    val root = gvr_root(gvr_program(body))
    val exe = s"$root/built"

    build_native_program(s"$root/main.sysl", None, None, DefaultOptimization, Some(exe)) match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return failure_text(why)
        Ok(_) -> ()

    val said = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    said match
        Err(_) -> "the program that was built could not be run"
        Ok(out) -> out.text + out.err.unwrap_or("")
end gvr_ran

private gvr_accepted(body: string, printed: string)
    val out = gvr_said(body)

    assert(!out.contains("error"), s"expected no complaint, got: $out")
    assert_eq(gvr_ran(body), printed)

private gvr_refused(body: string, part: string)
    val out = gvr_said(body)

    assert(out.contains(part), s"expected '$part' in: $out")

// -- a parameter's element, instantiated at a value -------------------------------------------------

@test("a T read through a generic member of a borrowed view and stored in a local Buf is accepted")
gvr_stored_value()
    if !gvr_ready() then return

    gvr_accepted("run() = print(check(1.5), check(7))\n", "1.5 7\n")

@test("a T read through a generic member of a borrowed view and held across a push is accepted")
gvr_held_value()
    if !gvr_ready() then return

    gvr_accepted("run() = print(held(2, 3), held(2.5, 4.0))\n", "2 2.5\n")

@test("the generic bodies alone, never instantiated, say nothing")
gvr_uninstantiated()
    if !gvr_ready() then return

    gvr_accepted("run() = print(\"none\")\n", "none\n")

// -- the same bodies instantiated at a view ---------------------------------------------------------

@test("the generic store instantiated at a view element type is refused by the instantiation")
gvr_stored_view()
    if !gvr_ready() then return

    gvr_refused("run()\n    val a = [5, 6]\n\n    print(check(a[..]).len)\n",
                "this stores a view borrowed from 'store' somewhere reached through a reference")

@test("the generic hold instantiated at a view element type is refused by the instantiation")
gvr_held_view()
    if !gvr_ready() then return

    gvr_refused("run()\n    val a = [5, 6]\n\n    print(held(a[..], a[..]).len)\n",
                "'e' is a view borrowed from 'store', and this call may write")

// -- the concrete neighbours ------------------------------------------------------------------------

@test("the same store written for a concrete view element type is refused")
gvr_concrete_store()
    if !gvr_ready() then return

    gvr_refused("plain(x: []const int) -> usize\n    var store: Buf[[]const int] = buf_filled(4, x)\n" +
                "    val m = M(store.view_mut())\n    val want: Buf[[]const int] = buf_filled(4, x)\n\n" +
                "    want[0] = m.at(0)\n    want[0].len\nend plain\n\n" +
                "run()\n    val a = [5, 6]\n\n    print(plain(a[..]))\n",
                "this stores a view borrowed from 'store' somewhere reached through a reference")

@test("the same store written for a concrete value element type is accepted")
gvr_concrete_value()
    if !gvr_ready() then return

    gvr_accepted("plain(x: long) -> long\n    var store: Buf[long] = buf_filled(4, x)\n" +
                 "    val m = M(store.view_mut())\n    val want: Buf[long] = buf_filled(4, x)\n\n" +
                 "    want[0] = m.at(0)\n    want[0]\nend plain\n\nrun() = print(plain(9))\n", "9\n")

@test("a generic body's own view of a non-parameter type, through a call into module storage, is refused")
gvr_own_view()
    if !gvr_ready() then return

    gvr_refused("var kept: Option[[]long] = None\n\n" +
                "leak[T](x: T) -> T\n    var store: Buf[long] = buf_filled(2, 1)\n\n" +
                "    kept = Some(id(store.view_mut()))\n    x\nend leak\n\n" +
                "run() = print(leak(3))\n",
                "this stores a view borrowed from 'store' somewhere reached through a reference, a pointer or module storage")
