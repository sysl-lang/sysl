// P14: one impl for every integer width (the open iN/uN family), and the structural kinds a free
// generic function handles by reflection with no impl at all (tuple parts, array elements).
trait Encode
    encode(self) -> string

impl[T: Integer + Display] Encode for T
    encode(self) -> string = s"$self"

enc[T](v: T) -> string
    if const T: Encode
        v.encode()
    elif const T::Kind == Kind.Tuple
        var out = "["
        for const f in T::Fields
            if f.index > 0 then out = out + ","
            out = out + enc(v.(f))
        out + "]"
    elif const T::Kind == Kind.Array
        var out = "["
        for i in 0..<v.len
            if i > 0 then out = out + ","
            out = out + enc(v[i])
        out + "]"
    else
        @assert(false, s"no encoding for ${T::Name}")
        ""

val x: u24 = 70000
val pair: (i7, u64) = (-3, 9)
val arr: [3]u8 = [1, 2, 3]
print(enc(x), enc(pair), enc(arr))
