module sysl

// The shortest decimal that reads back as a given `real` -- the digits `display_real_shortest`
// writes, found exactly rather than by asking `printf` for one precision after another.
//
// The algorithm is Ryu (Ulf Adams, "Ryu: fast float-to-string conversion", PLDI 2018). A double is
// `m * 2^e`, and every decimal that reads back as it lies strictly inside the interval halfway to
// each neighbour -- or on its edge, where the tie in the reader goes to this value's even
// significand. Ryu scales the value and both edges by a power of ten, so that each becomes an
// integer, with one 64x128-bit multiplication apiece against a table of powers of five. It then
// strips decimal digits from all three at once for as long as the two edges still differ: what is
// left is the fewest digits any decimal in the interval can have, and the digit dropped last says
// which way to round the one that stays. Two flags follow whether the dropped digits were all
// zeros, because only then is the value exactly half way or the lower edge exactly representable,
// and those are the two cases in which the answer changes.
//
// What comes out is the rule JavaScript and Python both print by: the fewest significant digits;
// among those, the decimal closest to the value; and a tie between two equally close ones to the
// even digit. `printf` cannot be asked that question -- it rounds to a precision it is told, so a
// search over precisions finds a reading that works but not always the shortest one. `2^-24` is
// the smallest case: rounded to sixteen digits it gives `...062e-08`, which is outside the interval
// because the spacing below a power of two is half the spacing above, so the search went on to
// seventeen, while `5.960464477539063e-08` is inside it and a digit shorter.
//
// The tables are the 125-bit-precision powers of five and their reciprocals Ryu is defined over,
// in `shortest_powers.sysl`. A `u128` holds each one whole; the multiplication splits it into two
// 64-bit halves so that no product is wider than 128 bits.

/** The shortest reading of `x`, written into `into` the way `%g` spells a number, answering how many
 * bytes it wrote. Thirty-two bytes is always enough.
 *
 * **The spelling is `%g`'s and only the digits are new**: the exponent form is chosen where `%g`
 * chooses it -- a decimal exponent below -4, or at least the precision, which is fifteen or the digit
 * count where that is larger -- with a sign and at least two exponent digits, and there are never
 * trailing zeros or a trailing point. `-0` keeps its sign, and the non-finite values are `inf`,
 * `-inf` and `nan`.
 */
private[sysl] shortest_real(x: real, into: []u8) -> usize
    val bits = x.bits()
    val biased = int((bits >> 52) & 0x7ff)
    val fraction = bits & 0xfffffffffffff

    // The significand and the exponent, less two more: the value and both edges of its interval
    // are then `4m`, `4m + 2` and `4m - 1` or `4m - 2` times the same power of two, all integers.
    val m2 = if biased == 0 then fraction else (u64(1) << 52) | fraction
    val e2 = (if biased == 0 then 1 else biased) - 1023 - 52 - 2

    spell_shortest(bits >> 63 != 0, biased == 0x7ff, fraction != 0, m2, e2,
                   fraction != 0 || biased <= 1, into)
end shortest_real

/** The shortest reading of an `f32`, spelled as `shortest_real` spells a `real`: the fewest digits
 * that read back as the same `f32`, which is usually fewer than its widened `real` needs -- `0.1f32`
 * is `0.1` here and `0.10000000149011612` as a `real`.
 */
private[sysl] shortest_f32(x: f32, into: []u8) -> usize
    val bits = x.bits()
    val biased = int((bits >> 23) & 0xff)
    val fraction = u64(bits & 0x7fffff)
    val m2 = if biased == 0 then fraction else (u64(1) << 23) | fraction
    val e2 = (if biased == 0 then 1 else biased) - 127 - 23 - 2

    spell_shortest(bits >> 31 != 0, biased == 0xff, fraction != 0, m2, e2,
                   fraction != 0 || biased <= 1, into)
end shortest_f32

/** A `real` the way `print`, `str` and a plain hole write it, which is what Rust's `{}` writes: the
 * fewest digits that read back as the same `real` -- the closest of those, and of two equally close
 * the larger -- set out positionally, never an exponent, a whole number with no `.0`, and `-0`,
 * `inf`, `-inf` and `NaN` for the values that are not ordinary numbers. The digits go straight to `out`, so `1e300` costs no buffer three hundred bytes wide.
 */
private[sysl] plain_real(x: real, out: *Writer, fmt: FormatSpec)
    val bits = x.bits()
    val biased = int((bits >> 52) & 0x7ff)
    val fraction = bits & 0xfffffffffffff
    val m2 = if biased == 0 then fraction else (u64(1) << 52) | fraction
    val e2 = (if biased == 0 then 1 else biased) - 1023 - 52 - 2

    plain_binary(bits >> 63 != 0, biased == 0x7ff, fraction != 0, m2, e2,
                 fraction != 0 || biased <= 1, out, fmt)
end plain_real

/** An `f32` written as `plain_real` writes a `real`, with the digits an `f32` needs: `0.1` for
 * `f32(0.1)`, where the same value widened needs seventeen.
 */
private[sysl] plain_f32(x: f32, out: *Writer, fmt: FormatSpec)
    val bits = x.bits()
    val biased = int((bits >> 23) & 0xff)
    val fraction = u64(bits & 0x7fffff)
    val m2 = if biased == 0 then fraction else (u64(1) << 23) | fraction
    val e2 = (if biased == 0 then 1 else biased) - 127 - 23 - 2

    plain_binary(bits >> 31 != 0, biased == 0xff, fraction != 0, m2, e2,
                 fraction != 0 || biased <= 1, out, fmt)
end plain_f32

/** An `f16` written as `plain_real` writes a `real`, in the digits an `f16` needs. */
private[sysl] plain_f16(x: f16, out: *Writer, fmt: FormatSpec)
    val bits = x.bits()
    val biased = int((bits >> 10) & 0x1f)
    val fraction = u64(bits & 0x3ff)
    val m2 = if biased == 0 then fraction else (u64(1) << 10) | fraction
    val e2 = (if biased == 0 then 1 else biased) - 15 - 10 - 2

    plain_binary(bits >> 15 != 0, biased == 0x1f, fraction != 0, m2, e2,
                 fraction != 0 || biased <= 1, out, fmt)
end plain_f16

/** A `bf16` written as `plain_real` writes a `real`, in the digits a `bf16` needs. */
private[sysl] plain_bf16(x: bf16, out: *Writer, fmt: FormatSpec)
    val bits = x.bits()
    val biased = int((bits >> 7) & 0xff)
    val fraction = u64(bits & 0x7f)
    val m2 = if biased == 0 then fraction else (u64(1) << 7) | fraction
    val e2 = (if biased == 0 then 1 else biased) - 127 - 7 - 2

    plain_binary(bits >> 15 != 0, biased == 0xff, fraction != 0, m2, e2,
                 fraction != 0 || biased <= 1, out, fmt)
end plain_bf16

// The arguments are `spell_shortest`'s, the text going to a writer rather than into a buffer.
private plain_binary(negative: bool, special: bool, nan: bool, m2: u64, e2: int, lower_half: bool,
                     out: *Writer, fmt: FormatSpec)
    if special && nan
        display_pad("NaN".bytes, out, fmt)
        return

    if special
        display_pad((if negative then "-inf" else "inf").bytes, out, fmt)
        return

    if m2 == 0
        display_pad((if negative then "-0" else "0").bytes, out, fmt)
        return

    val found = shortest_decimal(m2, e2, lower_half, true)
    var digits: [20]u8
    val first = digits_ulong(found.0, digits[..])
    val count = digits.len - first

    write_plain(out, negative, digits[first..], found.1 + int(count) - 1, fmt)
end plain_binary

/** `shown`, the digits of a decimal whose first stands for `10^point`, written to `out` positionally
 * and padded to the width `fmt` asks for: `0.` and zeros in front of a number below one, zeros behind
 * a whole number that has fewer digits than places, and a point only where a digit follows it.
 * Trailing zeros in `shown` are dropped first, since a digit string read as a value may carry them.
 *
 * A short result is gathered and written once; a long one -- a binary128 near either end of its range
 * runs to thousands of characters -- goes out in pieces, so no buffer has to be as wide as the
 * longest number a float can name.
 */
private[sysl] write_plain(out: *Writer, negative: bool, shown: []const u8, point: int, fmt: FormatSpec)
    var count = shown.len

    while count > 1 && shown[count - 1] == u8('0')
        count -= 1

    val digits = shown[0..<count]
    val whole = point + 1
    val sign = if negative then 1 else 0
    var length = sign + int(count) + 1

    if point < 0 then length = sign + 1 - point + int(count)
    if point >= 0 && int(count) <= whole then length = sign + whole

    if length <= 64
        var buf: [64]u8
        var at: usize = 0

        if negative
            buf[0] = u8('-')
            at = 1

        if point < 0
            at = put_text(buf[..], at, "0.")
            for _ in 0..<-point - 1
                buf[at] = u8('0')
                at += 1
            at = put_bytes(buf[..], at, digits)
        elif int(count) <= whole
            at = put_bytes(buf[..], at, digits)
            for _ in int(count)..<whole
                buf[at] = u8('0')
                at += 1
        else
            at = put_bytes(buf[..], at, digits[0..<usize(whole)])
            buf[at] = u8('.')
            at = put_bytes(buf[..], at + 1, digits[usize(whole)..])

        display_pad(buf[0..<at], out, fmt)
        return

    var pad = fmt.width - length

    if pad < 0 then pad = 0
    if !fmt.left then display_fill(out, 32, pad)
    if negative then out.write("-".bytes)

    if point < 0
        out.write("0.".bytes)
        display_fill(out, 48, -point - 1)
        out.write(digits)
    elif int(count) <= whole
        out.write(digits)
        display_fill(out, 48, whole - int(count))
    else
        out.write(digits[0..<usize(whole)])
        out.write(".".bytes)
        out.write(digits[usize(whole)..])

    if fmt.left then display_fill(out, 32, pad)
end write_plain

// `special` is a biased exponent of all ones: an infinity, or a NaN where `nan` says so. `m2` zero
// otherwise is a zero. `lower_half` says the neighbour below is as far away as the one above, which
// it is except at a power of two.
private spell_shortest(negative: bool, special: bool, nan: bool, m2: u64, e2: int, lower_half: bool,
                       into: []u8) -> usize
    var at: usize = 0

    if special && nan then return put_text(into, 0, "nan")

    if negative
        into[0] = u8('-')
        at = 1

    if special then return put_text(into, at, "inf")

    if m2 == 0
        into[at] = u8('0')
        return at + 1

    val found = shortest_decimal(m2, e2, lower_half, false)
    var digits: [20]u8
    val first = digits_ulong(found.0, digits[..])
    val count = digits.len - first

    spell_digits(into, at, digits[first..], found.1 + int(count) - 1)
end spell_shortest

/** `shown`, the digits of a decimal whose first stands for `10^point`, spelled from `start` as `%g`
 * spells a number: an exponent below -4, or at least the precision -- fifteen, or the digit count
 * where that is larger -- takes the exponent form, and there is never a trailing zero or point. It
 * answers where the text ends.
 */
private[sysl] spell_digits(into: []u8, start: usize, shown: []const u8, point: int) -> usize
    var at = start
    val count = shown.len
    val precision = if count > 15 then int(count) else 15

    if point < -4 || point >= precision
        into[at] = shown[0]
        at += 1

        if count > 1
            into[at] = u8('.')
            at = put_bytes(into, at + 1, shown[1..])

        into[at] = u8('e')
        into[at + 1] = if point < 0 then u8('-') else u8('+')
        at += 2

        val magnitude = if point < 0 then -point else point

        if magnitude < 10
            into[at] = u8('0')
            at += 1

        var exp_digits: [20]u8
        val exp_first = digits_ulong(ulong(magnitude), exp_digits[..])
        return put_bytes(into, at, exp_digits[exp_first..])

    if point < 0
        at = put_text(into, at, "0.")
        for _ in 0..<-point - 1
            into[at] = u8('0')
            at += 1
        return put_bytes(into, at, shown)

    val whole = usize(point) + 1

    if count <= whole
        at = put_bytes(into, at, shown)
        for _ in count..<whole
            into[at] = u8('0')
            at += 1
        return at

    at = put_bytes(into, at, shown[0..<whole])
    into[at] = u8('.')
    put_bytes(into, at + 1, shown[whole..])
end spell_digits

private put_bytes(into: []u8, at: usize, bytes: []const u8) -> usize
    for i in 0..<bytes.len
        into[at + i] = bytes[i]
    at + bytes.len

private put_text(into: []u8, at: usize, text: string) -> usize = put_bytes(into, at, text.bytes)

/** The fewest digits naming the float `m2 * 2^(e2 + 2)`, as those digits and the power of ten they
 * are scaled by: `(d, k)` reads as `d * 10^k`. The float must be finite and not zero; it may be a
 * `real`, an `f32` or one of the half-width floats, since the interval is worked out from `m2` and
 * `e2` alone and the tables are wide enough for all of them.
 *
 * Two decimals of the fewest digits can be equally close to the value -- `1805974.25` as an `f32`
 * is as near `1805974.2` as `1805974.3`. `ties_up` takes the larger, which is Rust's rule and what
 * `print` follows; without it the even digit wins, which is JavaScript's and Python's.
 */
private shortest_decimal(m2: u64, e2: int, lower_half: bool, ties_up: bool) -> (u64, int)
    // A tie in the reader goes to the even significand, so an even value owns both edges.
    val accept_edges = (m2 & 1) == 0
    val mv = 4 * m2

    // Below a power of two the neighbour is half as far away, so the lower edge is a quarter step
    // rather than half of one -- except at the bottom of the exponent range, where the spacing does
    // not change.
    val mm_shift: u64 = if lower_half then 1 else 0

    var vr: u64 = 0
    var vp: u64 = 0
    var vm: u64 = 0
    var e10 = 0
    var vm_zeros = false
    var vr_zeros = false

    if e2 >= 0
        val q = log10_pow2(e2) - (if e2 > 3 then 1 else 0)
        val shift = -e2 + q + 125 + pow5_bits(q) - 1
        val power = pow5_inv_split[q]

        e10 = q
        vr = mul_shift(mv, power, shift)
        vp = mul_shift(mv + 2, power, shift)
        vm = mul_shift(mv - 1 - mm_shift, power, shift)

        // Dividing by 10^q drops q digits, and they can all be zeros only where 5^q divides the
        // scaled value; above 10^21 no 55-bit significand is a multiple of 5^q.
        if q <= 21
            if mv % 5 == 0
                vr_zeros = multiple_of_pow5(mv, q)
            elif accept_edges
                vm_zeros = multiple_of_pow5(mv - 1 - mm_shift, q)
            elif multiple_of_pow5(mv + 2, q)
                vp -= 1
    else
        val q = log10_pow5(-e2) - (if -e2 > 1 then 1 else 0)
        val i = -e2 - q
        val shift = q - (pow5_bits(i) - 125)
        val power = pow5_split[i]

        e10 = q + e2
        vr = mul_shift(mv, power, shift)
        vp = mul_shift(mv + 2, power, shift)
        vm = mul_shift(mv - 1 - mm_shift, power, shift)

        if q <= 1
            // The dropped digits are all zeros: `mv` has at least two trailing zero bits.
            vr_zeros = true

            if accept_edges
                vm_zeros = mm_shift == 1
            else
                vp -= 1
        elif q < 63
            vr_zeros = multiple_of_pow2(mv, q)

    var removed = 0
    var last_removed: u64 = 0
    var output: u64 = 0

    if vm_zeros || vr_zeros
        // The general case, which has to know whether everything dropped was a zero.
        while vp / 10 > vm / 10
            vm_zeros = vm_zeros && vm % 10 == 0
            vr_zeros = vr_zeros && last_removed == 0
            last_removed = vr % 10
            vr /= 10
            vp /= 10
            vm /= 10
            removed += 1

        if vm_zeros
            while vm % 10 == 0
                vr_zeros = vr_zeros && last_removed == 0
                last_removed = vr % 10
                vr /= 10
                vp /= 10
                vm /= 10
                removed += 1

        // Exactly half way: to the even digit, or up where the caller asked for Rust's rule.
        if !ties_up && vr_zeros && last_removed == 5 && vr % 2 == 0 then last_removed = 4

        val round_up = (vr == vm && (!accept_edges || !vm_zeros)) || last_removed >= 5
        output = vr + (if round_up then 1 else 0)
    else
        // Nearly every value: nothing is ever a tie, so only the last digit dropped matters.
        var round_up = false

        if vp / 100 > vm / 100
            round_up = vr % 100 >= 50
            vr /= 100
            vp /= 100
            vm /= 100
            removed += 2

        while vp / 10 > vm / 10
            round_up = vr % 10 >= 5
            vr /= 10
            vp /= 10
            vm /= 10
            removed += 1

        output = vr + (if vr == vm || round_up then 1 else 0)

    (output, e10 + removed)
end shortest_decimal

// The high bits of `m` times a 125-bit power, shifted right by `shift`: the power is split into
// halves so that each partial product fits in 128 bits.
private mul_shift(m: u64, power: u128, shift: int) -> u64
    val low = u128(m) * u128(u64(power))
    val high = u128(m) * (power >> 64)
    u64(((low >> 64) + high) >> (shift - 64))

// floor(log2(5^e)) + 1, exact for 0 <= e <= 3528.
private pow5_bits(e: int) -> int = ((e * 1217359) >> 19) + 1

// floor(log10(2^e)), exact for 0 <= e <= 1650.
private log10_pow2(e: int) -> int = (e * 78913) >> 18

// floor(log10(5^e)), exact for 0 <= e <= 2620.
private log10_pow5(e: int) -> int = (e * 732923) >> 20

private multiple_of_pow5(value: u64, p: int) -> bool
    var v = value
    var count = 0

    while v % 5 == 0
        v /= 5
        count += 1

    count >= p

private multiple_of_pow2(value: u64, p: int) -> bool = (value & ((u64(1) << p) - 1)) == 0
