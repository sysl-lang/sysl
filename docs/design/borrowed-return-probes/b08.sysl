// An `Option[&T]` answer: a lookup that hands back a reference the receiver holds. Today it takes
// a count on the way out and the caller releases it; a borrowed answer would take none.
import sysl.buf.{Buf, buf}

struct Table
    items: Buf[&Item]

    find(self, key: int) -> Option[&Item]
        for it in self.items
            if it.key == key then return Some(it)

        None

struct Item
    key: int
    value: int

val t = Table(buf())

t.items.push(Item(1, 10))
t.items.push(Item(2, 20))

t.find(2) match
    Some(it) -> print(it.value)
    None -> print("none")
