// `m.range(lo..<hi)` over keys that are not integers: is `"b"..<"f"` a `Range[string]`?

struct Keys[K: Ord]
    ks: []K

    between(self, r: Range[K]) -> usize
        var n: usize = 0

        for k in self.ks
            if !(k < r.lo) && (k < r.hi || (r.inclusive && !(r.hi < k))) then n += 1

        n
end Keys

val m = Keys(["a", "b", "c", "f", "g"])

print(m.between("b"..<"f"))
