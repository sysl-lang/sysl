@test("the cross-toolchain variables key the run cache, though no host build reads them")
ckg_cross_toolchain_variables()
    if !ckg_ready() then return

    val root = ckg_featured("fancy = []")
    val names = ["WASI_SDK_PATH", "ANDROID_NDK_ROOT", "ANDROID_NDK_HOME", "ANDROID_HOME", "ANDROID_SDK_ROOT"]

    for i in 0..<names.len
        val plain = run_cache_key_for("run", root, None, DefaultOptimization, None)

        ckg_setenv(names[i], "/ckg/elsewhere")

        val set_one = run_cache_key_for("run", root, None, DefaultOptimization, None)

        ckg_unsetenv(names[i])
        assert(plain.is_some() && set_one.is_some())
        assert(plain.unwrap() != set_one.unwrap(), names[i])

    remove_dir_all(root).unwrap_or(())
end ckg_cross_toolchain_variables

