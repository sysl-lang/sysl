module sh.sysl.compiler

import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}
import sysl.math.bigint.from_int
import sysl.text.{replace_all, Search, split}

// **What a failed bounds check says before it stops the program.**
//
// The check itself is the comparison and the branch it always was; only the block the branch takes
// when the check fails is longer. That block hands what it knows -- which form failed, the values it
// compared, and where the subscript was written -- to ONE function, `sysl_bounds_fail`, and then
// traps exactly as before, so the exit status is still SIGTRAP's and `@test(should_trap)` reads it
// the same way.
//
// **The function is a WEAK default**, emitted into every module that has a check, so a program may
// define its own under the same symbol (`@export("sysl_bounds_fail")`) and every check in the program
// -- the standard module's included -- reports through it instead. That is how a board prints over a
// UART. Its C signature is
//
//     void sysl_bounds_fail(uint32_t kind, size_t a, size_t b, size_t length, const char *at);
//
// `kind` is one of the `Bounds*` forms below, with `BoundsASigned`/`BoundsBSigned` or-ed in where `a`
// or `b` came from a signed integer and is to be read as one; `at` is `file:line:column`,
// NUL-terminated, or null where the build dropped the locations or the body has none to give.
//
// **The call is followed by the trap rather than relying on the callee never to return**, so an
// override that returns -- one that only counts, say -- still stops the program where it was.
//
// **On a hosted target the default renders the message itself and writes it to standard error** with
// one `write`, then stops through `@sysl.trap`, which flushes standard output and traps
// (`trap_stop.sysl`). It renders its own digits rather than calling `snprintf`, so a program
// that formats nothing still links no C formatter -- and `write` is the one thing it asks of libc.
// **On a freestanding target it returns at once and the trap at the call site stops the program**,
// exactly as before this existed: there is no standard error to write to. The call is kept rather
// than dropped, since an override supplied in C or by another archive is something no compilation
// can see, and the cost of keeping it is a call on a path that never returns.
//
// **The locations can be dropped** -- the manifest's `bounds_locations = false`, or the flag
// `--no-bounds-locations` -- which leaves `at` null and lays down no `file:line:column` strings at
// all; the message keeps its values.

// The symbol a failed check reports through, and the one an override defines.
bounds_fail_symbol() -> string = "sysl_bounds_fail"

// The forms a failure takes. The number is what an override is handed, so it is part of the C
// surface and does not move. **The standard library reports through the same function**: an index
// past a `Buf`'s, `Frozen`'s, `Deque`'s or `Ring`'s count is `BoundsIndex`, and an insertion past
// the count `BoundsInsertPastLength`, raised by `sysl.index_past`/`insert_past` (`check.sysl`) with
// a null location -- a member cannot see its caller's line. A body that calls the hook through an
// `extern` holds the default exactly as a body with a check does (`gen_call`).
const BoundsIndex: int = 0
const BoundsRange: int = 1
const BoundsRangeInclusive: int = 2
const BoundsStartPastEnd: int = 3
const BoundsStartPastInclusiveEnd: int = 4
const BoundsStartPastLength: int = 5
const BoundsStartSplitsChar: int = 6
const BoundsEndSplitsChar: int = 7
const BoundsTooWide: int = 8
const BoundsRun: int = 9
const BoundsCountTooWide: int = 10
const BoundsNoVariant: int = 11
const BoundsWrongVariant: int = 12
const BoundsNegative: int = 13
const BoundsInsertPastLength: int = 14
const BoundsFieldUnset: int = 15

// Or-ed into the form where the value in `a` -- or `b` -- is a signed integer's, widened with its
// sign, so the message prints `-1` rather than eighteen quintillion.
const BoundsASigned: int = 256
const BoundsBSigned: int = 512

// What each form says, in order: the text with a `%s` for each value, and which values fill them --
// `a`, `b` or `n` (the length), or `A` or `B` where that value is the address of a NUL-terminated
// text rather than a number. The location, where there is one, follows as ` (file:line:col)`.
private val BoundsForms: []const (string, string) = [
    ("index %s out of bounds for length %s", "an"),
    ("range %s..<%s out of bounds for length %s", "abn"),
    ("range %s..%s out of bounds for length %s", "abn"),
    ("range start %s is past its end %s", "ab"),
    ("range start %s is more than one past its end %s", "ab"),
    ("range start %s is past length %s", "an"),
    ("range start %s is not on a character boundary", "a"),
    ("range end %s is not on a character boundary", "b"),
    ("index does not fit in usize", ""),
    ("%s elements from index %s out of bounds for length %s", "ban"),
    ("count does not fit in usize", ""),
    ("value %s is not one of the enum's variants", "a"),
    ("variant '%s' was asked for, and the value is '%s'", "AB"),
    ("index %s is negative", "a"),
    ("insertion index %s is past length %s", "an"),
    ("'%s' was made from a partial value whose field '%s' is None", "AB")]

// -- whether locations are laid down --------------------------------------------------------------

// Settled once per command by the driver, beside the allocator and for the same reason: every check
// in the build, the standard module's artifact included, has to agree.
private var locations_on: bool = true

bounds_locations() -> bool = locations_on

use_bounds_locations(on: bool)
    locations_on = on
end use_bounds_locations

// What the choice adds to an artifact's key: nothing for the default, so an ordinary build's path is
// unchanged.
bounds_locations_key() -> string = if locations_on then "" else "-nl"

// -- how a location names its file -----------------------------------------------------------------

// **A location names a file by where it sits in what was built, never by where that was on the
// building machine**, so no home directory or build path is laid into an image. A file's name is
// the absolute path the tree was walked from (which is what `__FILE__` and a diagnostic quote, and
// they keep it); a location strips the longest of these roots off the front and puts what each is
// paired with in its place. A library file is already named by its place (`library/sysl/…`) and
// matches none of them.
private var location_roots: Buf[(string, string)] = buf()

// The roots one compilation's files are named under, set by the driver as the compilation is
// gathered: the project's own directory (shown as nothing, so `src/main.sysl`), the directory
// fetched packages live under (so `github.com/o/p/@v1.2.0/…`), and each other root it read.
use_location_roots(roots: Buf[(string, string)])
    location_roots = roots
end use_location_roots

// A file's name as a location shows it.
location_file(written: string) -> string
    // The roots are absolute and normalized (`absolute_path`), so the file's name is too: a path
    // with a doubled `/` in it -- what joining onto a temporary directory ending in one gives -- would
    // otherwise match no root and lay the building machine's whole path into the image.
    val name = if written.starts_with("/") then absolute_path(written) else written
    var best: usize = 0
    var shown = name

    for location_root in location_roots
        val (dir, instead) = location_root

        if dir.bytes.len > best && name.bytes.len > dir.bytes.len && bytes_at(name, 0, dir)
            best = dir.bytes.len
            shown = instead + name[dir.bytes.len..<name.bytes.len]

    shown
end location_file

// -- the check -------------------------------------------------------------------------------------

// Traps unless `ok` holds, having first reported the failure through `sysl_bounds_fail`. The labels
// are the ones `trap_unless` takes, and the values are ones the check already computed, so nothing
// before the failure block is any different.
bounds_unless(e: *Emit, ok: Val, what: string, kind: int, a: Val, b: Val, n: Val, site: Span)
    e.traps = true
    e.bounds_fails = true

    val ok_l = fresh_label(e, s"$what.ok")
    val bad_l = fresh_label(e, s"$what.bad")

    emit_term(e, InCondBr(ok, ok_l, bad_l))
    emit_label(e, bad_l)

    val w = word_lty(e)

    var args: Buf[IrArg] = buf()

    args.push(ir_arg(l_i32(), VInt(from_int(long(kind)))))
    args.push(ir_arg(w, a))
    args.push(ir_arg(w, b))
    args.push(ir_arg(w, n))
    args.push(ir_arg(LPtr, location_of(e, site)))
    emit(e, ir_call(None, LVoid, VGlobal(bounds_fail_symbol()), args))
    emit(e, ir_call(None, LVoid, VGlobal(trap_symbol(e)), no_ir_args()))
    emit_term(e, InUnreachable)
    emit_label(e, ok_l)
end bounds_unless

// **`x.(c)` reached with a value holding another variant** reports through the same function, the
// two variants' names handed over as the addresses of NUL-terminated texts laid down with the
// locations, and stops the program.
variant_fail(e: *Emit, asked: string, holds: string, site: Span) -> Val =
    variant_fail_at(e, asked, c_text_of(e, holds), site)

// The same, the held variant's name read while the program runs: the value's tag indexes a table of
// the enum's variant names (the analyzer chooses this form only where the tags are the positions).
variant_fail_held(e: *Emit, asked: string, held: TExpr, site: Span) -> Val
    val ty = texpr_type(held)
    val d = enum_decl(ty).unwrap()
    val v = gen_expr(e, held)
    val w = word_lty(e)
    val tag = fresh_reg(e)

    emit(e, InExtract(tag, enum_lty(d), v, index_list(0)))

    var at = tag

    if e.word_bits > 32
        at = fresh_reg(e)
        emit(e, InCast(at, CastZExt, LInt(32), tag, w))
    end if

    val n = int(d.variants.len())
    var idx: Buf[IrArg] = buf()

    idx.push(ir_arg(w, VInt(from_int(0))))
    idx.push(ir_arg(w, at))

    val slot = fresh_reg(e)
    val name = fresh_reg(e)

    emit(e, InGep(slot, LArr(n, LPtr), VGlobal(variant_name_table(e, ty, d)), idx))
    emit(e, InLoad(name, LPtr, slot, AccPlain, None))
    variant_fail_at(e, asked, name, site)
end variant_fail_held

// An enum's variant names in tag order, laid down once per module.
private variant_name_table(e: *Emit, ty: Type, d: &EnumType) -> string
    val key = l_render(enum_lty(d))
    val known = e.variant_names.get(key)

    if known.is_some() then return known.unwrap()

    var names: Buf[IrArg] = buf()

    for i in 0..<d.variants.len()
        names.push(ir_arg(LPtr, c_text_of(e, descriptor_text(ty, int(i), -1))))

    val name = s".variants${e.variant_names.len()}"

    e.globals.push(ir_global(name, true, LArr(int(names.len()), LPtr), VArray(names)))
    e.variant_names.put(key, name)
    name
end variant_name_table

private variant_fail_at(e: *Emit, asked: string, holds: Val, site: Span) -> Val =
    two_texts_fail(e, BoundsWrongVariant, c_text_of(e, asked), holds, site)

// **`T::Make(p)` reached with a field of `p` still `None`** reports through the same function, the
// type (or variant) being made and the field's name handed over as two texts, and stops the program.
field_unset(e: *Emit, made: string, field: string, site: Span) -> Val =
    two_texts_fail(e, BoundsFieldUnset, c_text_of(e, made), c_text_of(e, field), site)

// What the default prints for it, which is also what an evaluation while compiling says.
field_unset_text(made: string, field: string) -> string =
    s"'$made' was made from a partial value whose field '$field' is None"

// A failure whose two values are the addresses of NUL-terminated texts.
private two_texts_fail(e: *Emit, kind: int, first: Val, second: Val, site: Span) -> Val
    e.traps = true
    e.bounds_fails = true

    val w = word_lty(e)
    val a = fresh_reg(e)
    val b = fresh_reg(e)

    emit(e, InCast(a, CastPtrToInt, LPtr, first, w))
    emit(e, InCast(b, CastPtrToInt, LPtr, second, w))

    var args: Buf[IrArg] = buf()

    args.push(ir_arg(l_i32(), VInt(from_int(long(kind)))))
    args.push(ir_arg(w, a))
    args.push(ir_arg(w, b))
    args.push(ir_arg(w, bounds_none()))
    args.push(ir_arg(LPtr, location_of(e, site)))
    emit(e, ir_call(None, LVoid, VGlobal(bounds_fail_symbol()), args))
    emit(e, ir_call(None, LVoid, VGlobal(trap_symbol(e)), no_ir_args()))
    emit_term(e, InUnreachable)
    VNothing
end two_texts_fail

// What the default prints for it, which is also what an evaluation while compiling says.
variant_fail_text(asked: string, holds: string) -> string =
    s"variant '$asked' was asked for, and the value is '$holds'"

// A value a form does not use.
bounds_none() -> Val = VInt(from_int(0))

// The form with the sign of each value it carries marked.
bounds_kind(kind: int, a_signed: bool, b_signed: bool) -> int =
    kind + (if a_signed then BoundsASigned else 0) + (if b_signed then BoundsBSigned else 0)

// Whether an index expression is a signed integer's, which is whether its widened value is to be
// read with its sign.
signed_index(x: TExpr) -> bool = underlying(texpr_type(x)) match
    Integer(_, signed, _) -> signed
    _ -> false

// -- a value no variant of its enum has ------------------------------------------------------------

// **A simple enum read out of storage nothing checked is held to its variants before anything uses
// it**: a bitfield struct's enum field is a run of bits the hardware or a cast filled, and a width
// that has values no variant covers can hold one of them. Unchecked, `Image` names the wrong variant
// and a `match` falls off its arms. This is `E(n)`'s check, made where the value is read, and it
// reports as a failed bounds check does -- the value and where it was read -- before it traps.
//
// The check is one call of a `private` helper per enum, `sysl.enum.check.<enum>`, taking the value
// at the enum's own representation and the location: one line at the site, so a body reads the same
// around it, and nothing at all where the variants cover every value the width can hold.
check_variant(e: *Emit, en: Type, v: Val, site: Span)
    val d = enum_decl(en)

    if d.is_none() || !d.unwrap().simple || d.unwrap().variants.is_empty() then return

    val bits = lty(e, d.unwrap().underlying) match
        LInt(b) -> b
        _ -> return

    if bits > 64 || every_value_a_variant(d.unwrap(), bits) then return

    val signed = underlying(d.unwrap().underlying) match
        Integer(_, s, _) -> s
        _ -> false

    e.traps = true
    e.bounds_fails = true

    val name = llvm_safe(s"sysl.enum.check.${mangle(underlying(en))}")

    request_text(e, name, variant_check_text(name, d.unwrap(), bits, signed, e.word_bits, trap_symbol(e)))

    var args: Buf[IrArg] = buf()

    args.push(ir_arg(LInt(bits), v))
    args.push(ir_arg(LPtr, location_of(e, site)))
    emit(e, ir_call(None, LVoid, VGlobal(name), args))
end check_variant

// Whether every value `bits` can hold is some variant's, which leaves nothing to check. Discriminants
// are distinct, so counting them is enough.
every_value_a_variant(d: &EnumType, bits: int) -> bool
    if bits >= 16 then return false

    d.variants.len() >= usize(1) << usize(bits)
end every_value_a_variant

// The helper: the membership test at 64 bits, as `E(n)`'s is, so a signed representation compares
// with its sign; the report through `sysl_bounds_fail` with the value widened to the word; the trap.
private variant_check_text(name: string, d: &EnumType, bits: int, signed: bool, word_bits: int,
                           stop: string) -> string
    val ext = if signed then "sext" else "zext"
    val word = s"i$word_bits"

    var text = s"define private void @$name(i$bits %v, ptr %at) {\nentry:\n"
    var wide = "%v"

    if bits < 64
        text = text + s"  %w = $ext i$bits %v to i64\n"
        wide = "%w"
    end if

    val vs = d.variants

    for i in 0..<vs.len()
        text = text + s"  %c$i = icmp eq i64 $wide, ${vs.at(i).tag}\n"

    var any = "%c0"

    for i in 1..<vs.len()
        text = text + s"  %o$i = or i1 $any, %c$i\n"
        any = s"%o$i"

    var a = wide

    text = text + s"  br i1 $any, label %ok, label %bad\nbad:\n"

    if word_bits < 64
        text = text + s"  %a = trunc i64 $wide to $word\n"
        a = "%a"
    end if

    val kind = bounds_kind(BoundsNoVariant, signed, false)

    text + s"  call void @${bounds_fail_symbol()}(i32 $kind, $word $a, $word 0, $word 0, ptr %at)\n" +
        s"  call void @$stop()\n" +
        "  unreachable\n" +
        "ok:\n" +
        "  ret void\n" +
        "}\n"
end variant_check_text

// Where the subscript was written, as the constant the module lays down for it -- one per distinct
// location -- or null where the build dropped locations or the body came from no file. **A
// `@track_caller` body names the location it was handed instead** (`track_caller.sysl`), which is
// what makes a check in a container's member name the line that called the member.
location_of(e: *Emit, site: Span) -> Val
    if e.in_tracked then return caller_param()
    if !locations_on then return VNull

    val src = e.src match
        Some(s) -> s
        None -> return VNull

    val loc = src.locate(site.start)
    c_text_of(e, s"${location_file(src.name)}:${loc.line}:${loc.col}")
end location_of

// A NUL-terminated constant holding `text`, laid down with the locations and numbered among them, so
// one text asked for twice is one constant.
c_text_of(e: *Emit, text: string) -> Val
    val known = e.locs_at.get(text)

    if known.is_some() then return VGlobal(bounds_location_name(known.unwrap()))

    e.locs_at.put(text, e.locs.len())
    e.locs.push(text)
    VGlobal(bounds_location_name(e.locs.len() - 1))
end c_text_of

private bounds_location_name(i: usize) -> string = s".loc$i"

// The constants the locations are, in the order the bodies asked for them.
bounds_location_globals(e: *Emit) -> Buf[IrGlobal]
    var out: Buf[IrGlobal] = buf()

    for i in 0..<e.locs.len()
        val text = e.locs.at(i)

        var bytes: Buf[u8] = buf()

        for j in 0..<text.bytes.len
            bytes.push(text.bytes[j])

        bytes.push(u8(0))
        out.push(ir_global(bounds_location_name(i), true, LArr(int(bytes.len()), LInt(8)),
                           VBytes(bytes)))

    out
end bounds_location_globals

// -- the default -----------------------------------------------------------------------------------

// Whether the default writes a message, which is whether the target has somewhere to write it.
bounds_default_prints(t: Target) -> bool = t.os != Freestanding

// The weak default, as the text the module carries.
bounds_runtime(t: Target) -> string
    val word = s"i${t.pointer_bits()}"
    val params = s"(i32 %kind, $word %a, $word %b, $word %n, ptr %at)"

    if !bounds_default_prints(t)
        return s"define weak ${t.preemption()}void @${bounds_fail_symbol()}$params {\nentry:\n  ret void\n}\n\n"

    var text = cstring_global("sysl.bounds.open", " (") + cstring_global("sysl.bounds.close", ")")

    // Each form's text, cut at its holes: piece `j` is written, then the `j`th value it names.
    for k in 0..<BoundsForms.len
        val pieces = split(BoundsForms[k].0, "%s")

        for j in 0..<pieces.len
            if !pieces[j].is_empty() then text = text + cstring_global(s"sysl.bounds.f${k}.${j}", pieces[j])

    text = text + "\n" + bounds_put(word) + bounds_digits(word) +
        s"define weak ${t.preemption()}void @${bounds_fail_symbol()}$params {\n" +
        "entry:\n" +
        "  %msg = alloca [512 x i8]\n" +
        s"  %lim = getelementptr i8, ptr %msg, $word 510\n" +
        "  %sa = and i32 %kind, 256\n" +
        "  %asg = icmp ne i32 %sa, 0\n" +
        "  %sb = and i32 %kind, 512\n" +
        "  %bsg = icmp ne i32 %sb, 0\n" +
        "  %form = and i32 %kind, 255\n" +
        "  switch i32 %form, label %k0 ["

    for k in 1..<BoundsForms.len
        text = text + s" i32 $k, label %k$k"

    text = text + " ]\n"

    var arrivals = ""

    for k in 0..<BoundsForms.len
        val pieces = split(BoundsForms[k].0, "%s")
        val fills = BoundsForms[k].1
        var at = "%msg"

        text = text + s"k$k:\n"

        for j in 0..<pieces.len
            if !pieces[j].is_empty()
                text = text + s"  %k${k}.s${j} = call ptr @sysl.bounds.put(ptr $at, " +
                    s"ptr @sysl.bounds.f${k}.${j}, ptr %lim)\n"
                at = s"%k${k}.s${j}"

            if j < fills.bytes.len
                val which = fills[j..<j + 1]

                if which == "A" || which == "B"
                    text = text + s"  %k${k}.t${j} = inttoptr $word %${if which == "A" then "a" else "b"} to ptr\n" +
                        s"  %k${k}.v${j} = call ptr @sysl.bounds.put(ptr $at, ptr %k${k}.t${j}, ptr %lim)\n"
                else
                    val sign = if which == "a" then "%asg" else if which == "b" then "%bsg" else "false"

                    text = text + s"  %k${k}.v${j} = call ptr @sysl.bounds.num(ptr $at, $word %${which}, " +
                        s"i1 $sign, ptr %lim)\n"
                end if

                at = s"%k${k}.v${j}"

        text = text + "  br label %tail\n"
        arrivals = arrivals + (if k == 0 then "" else ", ") + s"[ $at, %k$k ]"

    text + "tail:\n" +
        s"  %e = phi ptr $arrivals\n" +
        "  %has = icmp ne ptr %at, null\n" +
        "  br i1 %has, label %loc, label %nl\n" +
        "loc:\n" +
        "  %l1 = call ptr @sysl.bounds.put(ptr %e, ptr @sysl.bounds.open, ptr %lim)\n" +
        "  %l2 = call ptr @sysl.bounds.put(ptr %l1, ptr %at, ptr %lim)\n" +
        "  %l3 = call ptr @sysl.bounds.put(ptr %l2, ptr @sysl.bounds.close, ptr %lim)\n" +
        "  br label %nl\n" +
        "nl:\n" +
        "  %f = phi ptr [ %e, %tail ], [ %l3, %loc ]\n" +
        "  store i8 10, ptr %f\n" +
        s"  %f1 = getelementptr i8, ptr %f, $word 1\n" +
        s"  %fi = ptrtoint ptr %f1 to $word\n" +
        s"  %mi = ptrtoint ptr %msg to $word\n" +
        s"  %len = sub $word %fi, %mi\n" +
        s"  %w = call $word @write(i32 2, ptr %msg, $word %len)\n" +
        "  call void @sysl.trap()\n" +
        "  unreachable\n" +
        "}\n\n"
end bounds_runtime

// Copies a NUL-terminated text to `d`, stopping at `lim`, and answers where it stopped.
private bounds_put(word: string) -> string =
    "define private ptr @sysl.bounds.put(ptr %d, ptr %s, ptr %lim) {\n" +
    "entry:\n" +
    "  br label %loop\n" +
    "loop:\n" +
    "  %o = phi ptr [ %d, %entry ], [ %o1, %body ]\n" +
    "  %p = phi ptr [ %s, %entry ], [ %p1, %body ]\n" +
    "  %c = load i8, ptr %p\n" +
    "  %z = icmp eq i8 %c, 0\n" +
    "  %full = icmp uge ptr %o, %lim\n" +
    "  %stop = or i1 %z, %full\n" +
    "  br i1 %stop, label %done, label %body\n" +
    "body:\n" +
    "  store i8 %c, ptr %o\n" +
    s"  %o1 = getelementptr i8, ptr %o, $word 1\n" +
    s"  %p1 = getelementptr i8, ptr %p, $word 1\n" +
    "  br label %loop\n" +
    "done:\n" +
    "  ret ptr %o\n" +
    "}\n\n"

// Writes a word's decimal digits to `d` -- with a minus sign where `signed` holds and the value is
// negative -- stopping at `lim`. The digits are laid down backwards in a scratch buffer, a word
// being at most twenty of them.
private bounds_digits(word: string) -> string =
    s"define private ptr @sysl.bounds.num(ptr %d, $word %v, i1 %signed, ptr %lim) {\n" +
    "entry:\n" +
    "  %tmp = alloca [24 x i8]\n" +
    s"  %end = getelementptr i8, ptr %tmp, $word 23\n" +
    "  store i8 0, ptr %end\n" +
    s"  %below = icmp slt $word %v, 0\n" +
    "  %neg = and i1 %signed, %below\n" +
    s"  %flip = sub $word 0, %v\n" +
    s"  %mag = select i1 %neg, $word %flip, $word %v\n" +
    "  br label %loop\n" +
    "loop:\n" +
    "  %at = phi ptr [ %end, %entry ], [ %at1, %loop ]\n" +
    s"  %m = phi $word [ %mag, %entry ], [ %q, %loop ]\n" +
    s"  %q = udiv $word %m, 10\n" +
    s"  %r = urem $word %m, 10\n" +
    s"  %r8 = trunc $word %r to i8\n" +
    "  %ch = add i8 %r8, 48\n" +
    s"  %at1 = getelementptr i8, ptr %at, $word -1\n" +
    "  store i8 %ch, ptr %at1\n" +
    s"  %more = icmp ne $word %q, 0\n" +
    "  br i1 %more, label %loop, label %sign\n" +
    "sign:\n" +
    "  br i1 %neg, label %minus, label %copy\n" +
    "minus:\n" +
    s"  %at2 = getelementptr i8, ptr %at1, $word -1\n" +
    "  store i8 45, ptr %at2\n" +
    "  br label %copy\n" +
    "copy:\n" +
    "  %from = phi ptr [ %at1, %sign ], [ %at2, %minus ]\n" +
    "  %out = call ptr @sysl.bounds.put(ptr %d, ptr %from, ptr %lim)\n" +
    "  ret ptr %out\n" +
    "}\n\n"

// A private NUL-terminated constant, as a line of module text. Only a newline needs escaping in the
// texts above.
private cstring_global(name: string, text: string) -> string
    val body = replace_all(text, "\n", "\\0A")
    val n = text.bytes.len + 1

    s"@$name = private unnamed_addr constant [$n x i8] c\"$body\\00\"\n"
end cstring_global
