module sh.sysl.compiler
@tests

// The address of a generic function whose value parameter is written as a named constant,
// `&add[TWO]`. An address reads its brackets the way a call does: an argument for a `const`
// parameter is a value -- a `const`, arithmetic over one, one from another module -- and an argument
// for a type parameter is a type. The harness is `tests_xvr_extern_var.sysl`'s.

private vga_ran(text: string) -> string = xvr_ran([("main.sysl", text)])

private vga_ir(text: string) -> string = xvr_ir([("main.sysl", text)])

// A refusal carries this message, anchored at this `file:line:column` -- whose arrow is indented as
// far as the gutter is wide, one more space from line 10 on.
private vga_refused(said: string, message: string, at: string) =
    assert(said.contains(s"error: $message\n --> $at\n") ||
           said.contains(s"error: $message\n  --> $at\n"), said)

@test("a named constant as a value argument")
vga_a_named_constant()
    if xvr_no_library() then return

    assert_eq(vga_ran(raw"""
        const TWO: u32 = 2
        add[const K: u32](x: u32) -> u32 = x + K

        val f: *extern(u32) -> u32 = &add[TWO]
        print(f(1))
        """), "3\n")
end vga_a_named_constant

@test("arithmetic over a named constant")
vga_arithmetic_over_a_constant()
    if xvr_no_library() then return

    assert_eq(vga_ran(raw"""
        const TWO: u32 = 2
        add[const K: u32](x: u32) -> u32 = x + K

        val f: *extern(u32) -> u32 = &add[TWO + 1]
        val g: *extern(u32) -> u32 = &add[TWO * TWO]
        print(f(1), g(1))
        """), "4 5\n")
end vga_arithmetic_over_a_constant

@test("a constant from another module")
vga_a_constant_from_another_module()
    if xvr_no_library() then return

    assert_eq(xvr_ran([("main.sysl", raw"""
        add[const K: u32](x: u32) -> u32 = x + K

        val f: *extern(u32) -> u32 = &add[m.TWO]
        print(f(10))
        """), ("m/a.sysl", "module m\nconst TWO: u32 = 2\n")]), "12\n")
end vga_a_constant_from_another_module

@test("a constant from another file of the same module")
vga_a_constant_from_another_file()
    if xvr_no_library() then return

    assert_eq(xvr_ran([("main.sysl", raw"""
        val f: *extern(u32) -> u32 = &add[TWO]
        print(f(10))
        """), ("more.sysl", "const TWO: u32 = 2\nadd[const K: u32](x: u32) -> u32 = x + K\n")]),
              "12\n")
end vga_a_constant_from_another_file

// The type parameter's argument is still read as a type, beside the value one read as a value.
@test("a type parameter and a value parameter")
vga_a_type_and_a_value()
    if xvr_no_library() then return

    assert_eq(vga_ran(raw"""
        const TWO: u32 = 2
        scaled[T: Integer, const K: u32](x: T) -> T = x * T(K)

        val f: *extern(u32) -> u32 = &scaled[u32, TWO]
        val g: *extern(i64) -> i64 = &scaled[i64, TWO + 1]
        print(f(5), g(5))
        """), "10 15\n")
end vga_a_type_and_a_value

// A name that IS a type, in a type parameter's slot, beside a constant: a struct, not a value.
@test("a struct named in the type slot stays a type")
vga_a_struct_in_the_type_slot()
    if xvr_no_library() then return

    assert_eq(vga_ran(raw"""
        struct Pt
            x: u32

        const TWO: u32 = 2
        bump[T, const K: u32](p: *T, x: u32) -> u32 = x + K

        val f: *extern(*Pt, u32) -> u32 = &bump[Pt, TWO]
        var p = Pt(1)
        print(f(&p, 3))
        """), "5\n")
end vga_a_struct_in_the_type_slot

// The shape that found it: two value parameters, one a named constant and one a literal.
@test("two value parameters, a constant and a literal")
vga_two_value_parameters()
    if xvr_no_library() then return

    assert_eq(vga_ran(raw"""
        const A: u32 = 7
        pick[const R: u32, const S: u32](x: u32) -> u32 = x * 100 + R * 10 + S

        val f: *extern(u32) -> u32 = &pick[A, 0]
        val g: *extern(u32) -> u32 = &pick[0, A]
        print(f(1), g(1))
        """), "170 107\n")
end vga_two_value_parameters

// Three copies of one function, each its own address, chosen in a `match` arm and laid in a table.
@test("in a match arm and a table of three addresses")
vga_in_a_match_and_a_table()
    if xvr_no_library() then return

    assert_eq(vga_ran(raw"""
        const ONE: u32 = 1
        const TWO: u32 = 2
        add[const K: u32](x: u32) -> u32 = x + K

        chosen(i: u32) -> *extern(u32) -> u32 = i match
            0 -> &add[ONE]
            1 -> &add[TWO]
            _ -> &add[TWO + ONE]

        val table: [3]*extern(u32) -> u32 = [&add[ONE], &add[TWO], &add[TWO + ONE]]

        for i in 0..<3
            print(chosen(u32(i))(10), table[i](20))
        """), "11 21\n12 22\n13 23\n")
end vga_in_a_match_and_a_table

// A value parameter of an enum takes a variant, bare or qualified, as a call's does.
@test("an enum variant as a value argument")
vga_an_enum_variant()
    if xvr_no_library() then return

    assert_eq(vga_ran(raw"""
        enum Level
            Low
            High

        loud[const L: Level](x: u32) -> u32 = if L == High then x * 2 else x

        val f: *extern(u32) -> u32 = &loud[High]
        val g: *extern(u32) -> u32 = &loud[Level.Low]
        print(f(5), g(5))
        """), "10 5\n")
end vga_an_enum_variant

// -- what is refused -------------------------------------------------------------------------------

@test("a constant of the wrong type")
vga_a_constant_of_the_wrong_type()
    if xvr_no_library() then return

    val said = vga_ir(raw"""
        const NAME: string = "two"
        add[const K: u32](x: u32) -> u32 = x + K

        val f: *extern(u32) -> u32 = &add[NAME]
        print(f(1))
        """)

    vga_refused(said, "'K' of 'add' is uint, but string was given", "main.sysl:4:35")
    assert(!said.contains("undefined name 'K'"), said)
end vga_a_constant_of_the_wrong_type

@test("a variable, which is not a constant")
vga_a_variable()
    if xvr_no_library() then return

    val said = vga_ir(raw"""
        var two: u32 = 2
        add[const K: u32](x: u32) -> u32 = x + K

        val f: *extern(u32) -> u32 = &add[two]
        print(f(1))
        """)

    vga_refused(said, "a value argument must be a constant — a literal, or a 'const' naming one",
                "main.sysl:4:35")
    assert(!said.contains("undefined name 'K'"), said)
end vga_a_variable

// A type where a value is wanted is a value parameter's refusal, not a type read.
@test("a type written for a value parameter")
vga_a_type_for_a_value_parameter()
    if xvr_no_library() then return

    val said = vga_ir(raw"""
        add[const K: u32](x: u32) -> u32 = x + K

        val f: *extern(u32) -> u32 = &add[u32]
        print(f(1))
        """)

    vga_refused(said, "a value argument must be a constant — a literal, or a 'const' naming one",
                "main.sysl:3:35")
    assert(!said.contains("undefined name 'K'"), said)
end vga_a_type_for_a_value_parameter

// And a constant where a type is wanted is not a type.
@test("a constant written for a type parameter")
vga_a_constant_for_a_type_parameter()
    if xvr_no_library() then return

    val said = vga_ir(raw"""
        const TWO: u32 = 2
        ident[T](x: T) -> T = x

        val f: *extern(u32) -> u32 = &ident[TWO]
        print(f(1))
        """)

    vga_refused(said, "unknown type 'TWO'", "main.sysl:4:37")
end vga_a_constant_for_a_type_parameter

// -- a member's own value parameter, at a call ------------------------------------------------------

// A method's brackets are read the same way: `s.pick[TWO](…)` read `TWO` as a type too.
@test("a method's own value parameter takes a named constant and arithmetic over one")
vga_method_takes_a_constant()
    if xvr_no_library() then return

    assert_eq(xvr_ran([("main.sysl", raw"""
        const TWO: u32 = 2

        struct Sq
            n: u32

        impl Sq
            pick[const K: u32](self, x: u32) -> u32 = self.n + x + K

        val s = Sq(100)
        print(s.pick[TWO](1), s.pick[TWO + 1](1), s.pick[m.TEN](1), s.pick[2](1))
        """), ("m/a.sysl", "module m\nconst TEN: u32 = 10\n")]), "103 104 111 103\n")
end vga_method_takes_a_constant

// A generic type's method: the type's argument is the receiver's, the member's own a value.
@test("a generic type's method with a type and a value parameter of its own")
vga_generic_type_method()
    if xvr_no_library() then return

    assert_eq(vga_ran(raw"""
        const TWO: u32 = 2

        struct Box[T]
            v: T

        impl[T] Box[T]
            scaled[U: Integer, const K: u32](self, x: U) -> U = x * U(K)

        val b = Box(1.5)
        print(b.scaled[u64, TWO](7), b.scaled[i16, TWO * TWO](7))
        """), "14 28\n")
end vga_generic_type_method

@test("a method's value parameter refuses a variable, with no second error from its body")
vga_method_refuses_a_variable()
    if xvr_no_library() then return

    val said = vga_ir(raw"""
        var two: u32 = 2

        struct Sq
            n: u32

        impl Sq
            pick[const K: u32](self, x: u32) -> u32 = self.n + x + K

        val s = Sq(100)
        print(s.pick[two](1))
        """)

    vga_refused(said, "a value argument must be a constant — a literal, or a 'const' naming one",
                "main.sysl:10:14")
    assert(!said.contains("undefined name 'K'"), said)
end vga_method_refuses_a_variable

@test("a method's value parameter refuses a constant of the wrong type")
vga_method_refuses_the_wrong_type()
    if xvr_no_library() then return

    val said = vga_ir(raw"""
        const NAME: string = "two"

        struct Sq
            n: u32

        impl Sq
            pick[const K: u32](self, x: u32) -> u32 = self.n + x + K

        val s = Sq(100)
        print(s.pick[NAME](1))
        """)

    vga_refused(said, "'K' of 'pick' is uint, but string was given", "main.sysl:10:14")
    assert(!said.contains("undefined name 'K'"), said)
end vga_method_refuses_the_wrong_type

// -- a member's own value parameter, at an address --------------------------------------------------

@test("'&T.f[K]' takes a named constant, arithmetic over one, and another module's")
vga_member_address_takes_a_constant()
    if xvr_no_library() then return

    assert_eq(xvr_ran([("main.sysl", raw"""
        const TWO: u32 = 2

        struct Sq
            n: u32

        impl Sq
            pick[const K: u32](x: u32) -> u32 = x + K
            scaled[const K: u32](*self, x: u32) -> u32 = self.n + x * K

        var q = Sq(100)
        val a: *extern(u32) -> u32 = &Sq.pick[TWO]
        val b: *extern(u32) -> u32 = &Sq.pick[TWO + 1]
        val c: *extern(u32) -> u32 = &Sq.pick[m.TEN]
        val d: *extern(*Sq, u32) -> u32 = &Sq.scaled[TWO]

        print(a(1), b(1), c(1), d(&q, 5))
        """), ("m/a.sysl", "module m\nconst TEN: u32 = 10\n")]), "3 4 11 110\n")
end vga_member_address_takes_a_constant

// A generic type's generic member: the type's argument written as a type, the member's a value.
@test("'&Box[T].f[U, K]' reads the type's and the member's type arguments as types, its value as a value")
vga_generic_type_member_address()
    if xvr_no_library() then return

    assert_eq(vga_ran(raw"""
        const TWO: u32 = 2

        struct Box[T]
            v: T

        impl[T] Box[T]
            scaled[U: Integer, const K: u32](x: U) -> U = x * U(K)

        val f: *extern(u64) -> u64 = &Box[bool].scaled[u64, TWO]
        val g: *extern(i16) -> i16 = &Box[int].scaled[i16, TWO * TWO]
        print(f(7), g(7))
        """), "14 28\n")
end vga_generic_type_member_address

@test("'&T.f[K]' refuses a variable, with no second error from the member's body")
vga_member_address_refuses_a_variable()
    if xvr_no_library() then return

    val said = vga_ir(raw"""
        var two: u32 = 2

        struct Sq
            n: u32

        impl Sq
            pick[const K: u32](x: u32) -> u32 = x + K

        val f: *extern(u32) -> u32 = &Sq.pick[two]
        print(f(1))
        """)

    vga_refused(said, "a value argument must be a constant — a literal, or a 'const' naming one",
                "main.sysl:9:39")
    assert(!said.contains("undefined name 'K'"), said)
end vga_member_address_refuses_a_variable
