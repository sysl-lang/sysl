module sysl

// An answer that may have failed, carrying why. The error is a type parameter rather than a fixed
// one so that a module can answer with an enum of its own failure cases and have them matched
// exhaustively -- which is what the library's own conversions do (`from_utf8` answers with a
// `Utf8Error`).
//
// Like `Option` this is an ordinary generic enum; `?` reaches it through `Library.tryVariants`.
enum Result[T, E]
    Ok(value: T)
    Err(error: E)

    is_ok(self) -> bool = self match
        Ok(_) -> true
        Err(_) -> false

    is_err(self) -> bool = !self.is_ok()

    unwrap_or(self, default: T) -> T = self match
        Ok(v) -> v
        Err(_) -> default

    unwrap(self) -> T = self match
        Ok(v) -> v
        Err(_) ->
            print("panic: unwrap of an Err value")
            exit(1)

    expect(self, msg: string) -> T = self match
        Ok(v) -> v
        Err(_) ->
            print("panic:", msg)
            exit(1)

    unwrap_err(self) -> E = self match
        Err(e) -> e
        Ok(_) ->
            print("panic: unwrap_err of an Ok value")
            exit(1)

    expect_err(self, msg: string) -> E = self match
        Err(e) -> e
        Ok(_) ->
            print("panic:", msg)
            exit(1)
end Result

// What a `main` that answers with a `Result` does with the one it answered.
//
// **`main` may result in a `Result[unit, E]`, and this is what makes that mean something.** A program
// whose every fallible step ends in `.unwrap()` reports its failures as panics, which name the line
// that gave up rather than the thing that went wrong; letting `?` reach the top instead means the
// failure travels as a value and is reported once, here, by the only code that knows the program is
// over.
//
// The compiler calls this, and nothing else does -- an entry point that results in a `Result` is
// compiled as a call to `main` followed by a call to this at the error type `main` named. The bound
// is what makes the report possible: an error nobody can render could still be returned, and the
// program would exit non-zero with nothing said.
//
// **The exit status is 1 rather than something read off the error.** A status is one byte and an
// error is a value; mapping one onto the other is the program's business, and a program that wants
// to choose its own status has `exit` and always did.
private[sysl] main_result[E: Display](r: Result[unit, E])
    r match
        Ok(_) -> ()
        Err(e) ->
            eprints("error: ")
            e.display(stderr(), FormatSpec(0, -1, false))
            eprints("\n")
            exit(1)
