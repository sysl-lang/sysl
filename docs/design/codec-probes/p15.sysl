// P15: a decoder narrowing a wide integer to any field width, checked against T::Min/T::Max
narrow[T: Integer](x: i128) -> Option[T]
    if x < i128(T::Min) || x > i128(T::Max) then None else Some(T(x))

print(narrow[u24](70000).is_some(), narrow[i7](-65).is_none(), narrow[u64](-1).is_none(), narrow[u8](255).unwrap())
