module sysl.text
@tests

@test("eqe: Utf8Error is equal when offset and truncation agree")
eqe_utf8_error()
    assert(Utf8Error(3, false) == Utf8Error(3, false))
    assert(Utf8Error(3, false) != Utf8Error(4, false))
    assert(Utf8Error(3, false) != Utf8Error(3, true))
    assert(Utf8Error(3, true) == Utf8Error(3, true))

@test("eqe: a decoder's Result and Option[Result] compare with ==")
eqe_utf8_result()
    val bad: [1]u8 = [0xff]
    val good: [2]u8 = [104, 105]
    assert(from_utf8(bad[..]) == Err(Utf8Error(0, false)))
    assert(from_utf8(bad[..]) != Err(Utf8Error(1, false)))
    assert(from_utf8(good[..]) == Ok("hi"))
    assert(from_utf8(good[..]) != Ok("ho"))
    assert(from_utf8(good[..]) != Err(Utf8Error(0, false)))

    val some: Option[Result[string, Utf8Error]] = Some(from_utf8(good[..]))
    assert(some == Some(Ok("hi")))
    assert(some != Some(Ok("ho")))
    assert(some != Some(Err(Utf8Error(0, true))))
    assert(some != None)

@test("eqe: ParseError is equal variant by variant and payload by payload")
eqe_parse_error()
    assert(ParseError.Empty == ParseError.Empty)
    assert(ParseError.Overflow == ParseError.Overflow)
    assert(ParseError.Empty != ParseError.Overflow)
    assert(ParseError.BadDigit(2) == ParseError.BadDigit(2))
    assert(ParseError.BadDigit(2) != ParseError.BadDigit(3))
    assert(ParseError.BadDigit(2) != ParseError.Empty)
    assert(ParseError.BadBase(1) == ParseError.BadBase(1))
    assert(ParseError.BadBase(1) != ParseError.BadBase(37))
    assert(ParseError.BadBase(1) != ParseError.BadDigit(1))

@test("eqe: Result[T, ParseError] and Option of it compare with ==")
eqe_parse_result()
    val r: Result[int, ParseError] = Err(ParseError.BadDigit(1))
    assert(r == Err(ParseError.BadDigit(1)))
    assert(r != Err(ParseError.BadDigit(2)))
    assert(r != Ok(1))
    val o: Option[Result[int, ParseError]] = Some(r)
    assert(o == Some(Err(ParseError.BadDigit(1))))
    assert(o != Some(Err(ParseError.Empty)))
