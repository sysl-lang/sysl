module sh.sysl.compiler
@tests

import sysl.env.{get as env_var}
import sysl.process.capture

// The finish line for section 7, as something a run can answer rather than a judgement.
//
// **Every unit test of the reference compiler is ported here and passes** is the definition of
// done, and a definition nothing checks is a sentence. `scripts/reference_test_census.sh` reads
// the reference's suites, reads this repository's `@test` functions, reads
// `scripts/reference_tests.map` — which says, per reference case, the test here that answers it —
// and exits non-zero while any case has no line.
//
// **It is behind `SYSL_TEST_CENSUS=1` because it reads the bootstrap checkout**, which a machine
// running this suite need not have; an ordinary `sysl test .` returns at once and says so.

@test("every test of the reference compiler is answered by one here")
the_reference_suite_is_ported()
    if env_var("SYSL_TEST_CENSUS").is_none()
        print("skipped: SYSL_TEST_CENSUS is unset, and the census reads the bootstrap checkout")
        return
    end if

    capture("sh", ["scripts/reference_test_census.sh"], "", [], true) match
        Err(_) -> assert(false, "the reference-test census script could not be run")
        Ok(answer) ->
            val said = answer.text + answer.err.unwrap_or("")

            print(said)
            assert(answer.status.ok(), said)
end the_reference_suite_is_ported
