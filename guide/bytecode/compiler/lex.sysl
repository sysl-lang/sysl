// The front of the front end: source text in, one token at a time out.
//
// This file and `compile.sysl` are one module, which is what a directory means. They share a scope
// with no ordering and no forward declaration between them — the lexer names `Fault` and the
// parser names `Lexer`, and neither file is "first". That is the module rule doing its job: a
// module grew to two files and nothing about either one had to say so.

module compiler

// A token. `Junk` is what makes the lexer total: a character the language has no use for is
// reported as a token rather than as a failure, so `next` needs no error channel and the parser
// has one place — the point where it did not get what it expected — that turns a surprise into a
// diagnostic.
enum Tok
    End
    Num(v: int)
    Word(s: string)
    Sym(s: string)
    Junk(why: string)
end Tok

// A position in the source. `start` is where the token last returned began, which is what a
// diagnostic points at: by the time the parser sees a token, the lexer has already moved past it.
private[compiler] struct Lexer
    src: string
    bytes: []u8
    at: usize
    start: usize

    of(text: string) -> Lexer = Lexer(text, text.bytes, 0usize, 0usize)

    done(self) -> bool = self.at >= self.bytes.len

    peek(self) -> u8 = self.bytes[self.at]

    // Whitespace, and a `#` comment through to the end of its line.
    skip(*self)
        while !self.done()
            var c = self.peek()

            if c == 32u8 || c == 9u8 || c == 10u8 || c == 13u8 then self.at += 1usize
            else if c == u8('#')
                while !self.done() && self.peek() != 10u8
                    self.at += 1usize
            else break
    end skip

    next(*self) -> Tok
        self.skip()
        self.start = self.at
        if self.done() then return End

        var c = self.peek()

        if digit(c) then return self.number()
        if letter(c) then return self.word()

        // A byte outside ASCII is refused before anything tries to cut the source at it: a slice
        // of a string has to land between characters, so a lexer that reached for the text of a
        // stray continuation byte would trap rather than report.
        if c >= 128u8
            self.at += 1usize
            return Junk("a byte that is no part of the language")

        self.symbol()
    end next

    number(*self) -> Tok
        var n = 0
        var digits = 0

        while !self.done() && digit(self.peek())
            n = n * 10 + int(self.peek()) - 48
            digits += 1
            if digits > 9 then return Junk("a number too large for the machine")
            self.at += 1usize

        Num(n)
    end number

    word(*self) -> Tok
        var from = self.at

        while !self.done() && (letter(self.peek()) || digit(self.peek()))
            self.at += 1usize

        Word(self.src[from..<self.at])
    end word

    // The two-character operators are looked for first, so `<=` is never read as `<` followed by
    // something the parser has no use for.
    symbol(*self) -> Tok
        var from = self.at

        self.at += 1usize
        if !self.done()
            var two = self.src[from..<self.at + 1usize]

            if two == "==" || two == "!=" || two == "<=" || two == ">="
                self.at += 1usize
                return Sym(two)

        var one = self.src[from..<self.at]

        if single(one) then Sym(one)
        else Junk(s"an unexpected character '$one'")
    end symbol
end Lexer

// Written as three tests rather than one, because a condition cannot be broken across lines: there
// is no trailing-operator continuation, so an expression that outgrows its line has to become
// statements.
private single(s: string) -> bool
    if s == "+" || s == "-" || s == "*" || s == "/" || s == "%" then return true
    if s == "(" || s == ")" || s == "{" || s == "}" then return true
    s == ";" || s == "=" || s == "<" || s == ">"
end single

private digit(b: u8) -> bool = b >= u8('0') && b <= u8('9')

private letter(b: u8) -> bool =
    (b >= u8('a') && b <= u8('z')) || (b >= u8('A') && b <= u8('Z')) || b == u8('_')
