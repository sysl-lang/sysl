describe_fault(f: Fault) -> string = f match
    NotHeld(lock) -> s"released ${str(char(lock))} without holding it"
    AlreadyHeld(lock) -> s"took ${str(char(lock))} while already holding it"

describe_outcome(o: Outcome) -> string = o match
    Running -> "running"
    Finished(at) -> s"finished at $at"
    Stalled(at) -> s"stalled at $at"
    Timeout(at) -> s"timed out at $at"
