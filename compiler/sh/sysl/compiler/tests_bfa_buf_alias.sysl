module sh.sysl.compiler
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.Search
import sysl.fs.{make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture

// A `Buf`'s header and its elements are two allocations, and the accesses the buffer's own members
// make to each carry a scope saying the other is not what they touch
// (`reference/arrays.md § Its elements are never its header`). The text shows the marks; clang's
// `-O2` shows what they buy; and programs that write elements, grow the buffer and reinterpret its
// storage at `-O2` show the marks never claim more than is true.

private var bfa_library_cache: Buf[Program] = buf()
private var bfa_library_read: bool = false

private bfa_library() -> Buf[Program]
    if bfa_library_read then return bfa_library_cache

    bfa_library_read = true

    std_root() match
        Err(_) -> ()
        Ok(root) -> std_units(root, host_target()) match
            Err(_) -> ()
            Ok(units) -> bfa_library_cache = units

    bfa_library_cache
end bfa_library

private bfa_no_library() -> bool
    if bfa_library().is_empty()
        print("skipped: the standard module's source is not on this machine")
        return true

    false
end bfa_no_library

// The LLVM text of the whole module a source lowers to. A source that is refused stops the test with
// what it was refused with, rather than handing the message on as though it were IR.
private bfa_ir(text: string) -> string = bfa_lowered(text) match
    Ok(ir) -> ir
    Err(said) -> panic(s"the fixture was refused: $said")

private bfa_lowered(text: string) -> Result[string, string]
    val parsed = parse(source_of("t.sysl", forms_imported(text)))

    if !parsed.ok() then return Err(parsed.first().message)

    var units: Buf[Program] = buf()

    for item in bfa_library()
        units.push(item)

    units.push(parsed.program)

    val done = analyze_bodies(units, host_target())

    if !done.reported.is_empty() then return Err(done.reported[0].diag.message)

    val whole = program_of(done, "")
    val promotions = post_analysis_checks(done.an, whole, buf())
    val said = errors_of(done.an.diagnostics())

    if !said.is_empty() then return Err(analysis_report(said))

    val kept = prune(strip_tests(whole), program_own(units))
    val lowered = codegen_with_gaps(kept, host_target(), promotions)

    Ok(ir_print_module(lowered.0))
end bfa_lowered

// What clang's `-O2` leaves of a program, or `None` where there is no clang to ask.
private bfa_optimized(text: string) -> Option[string]
    if !clang_available()
        print("skipped: clang is not installed, so there is no optimizer to ask")
        return None
    end if

    val dir = make_temp_dir("sysl-bfa").unwrap()
    val file = s"$dir/t.ll"

    write_text(file, bfa_ir(text)).unwrap()

    val got = capture("clang", ["-O2", "-S", "-emit-llvm", "-o", "-", file], "", [], true).unwrap()

    remove_dir_all(dir).unwrap_or(())
    assert(got.status.ok(), s"clang refused the emitted IR:\n${got.err.unwrap_or("")}")
    Some(got.text)
end bfa_optimized

// The body of the function whose `define` line holds `name`.
private bfa_body(out: string, name: string) -> string
    var body = ""
    var inside = false

    for l in lines_of(out)
        if !inside && l.starts_with("define") && l.contains(name) then inside = true

        if inside
            if l == "}" then return body

            body = body + l + "\n"
        end if

    body
end bfa_body

// The lines of a body that hold every one of `parts`.
private bfa_lines(body: string, parts: []string) -> Buf[string]
    var found: Buf[string] = buf()

    for l in lines_of(body)
        var all = true

        for p in parts
            if !l.contains(p) then all = false

        if all then found.push(l)

    found
end bfa_lines

private val HeaderNode: string = "!{!\"sysl.buf.header\", !{!\"sysl.buf\"}}"
private val BoxNode: string = "!{!\"sysl.buf.box\", !{!\"sysl.buf\"}}"
private val ElementNode: string = "!{!\"sysl.buf.elements\", !{!\"sysl.buf\"}}"
private val HandleNode: string = "!{!\"sysl.buf.handle\", !{!\"sysl.buf\"}}"
private header_mark() -> string = s"!alias.scope !{$HeaderNode}, !noalias !{$ElementNode, $HandleNode}"
private box_mark() -> string = s"!alias.scope !{$BoxNode}, !noalias !{$ElementNode, $HeaderNode}"
private element_mark() -> string = s"!alias.scope !{$ElementNode}, !noalias !{$HeaderNode, $BoxNode}"
private handle_mark() -> string = s"!alias.scope !{$HandleNode}, !noalias !{$HeaderNode}"

private bfa_matrix() -> string = raw"""
    module demo

    import sysl.buf.{Buf, buf}

    struct M
        n: int
        cells: &Buf[real]

        at(self, i: int, j: int) -> real = self.cells[usize(i * self.n + j)]

        set(*self, i: int, j: int, v: real) = self.cells[usize(i * self.n + j)] = v
    end M

    @noinline
    axpy(m: M, i: int, r: int, f: real)
        var a = m

        for j in 0..<a.n do a.set(i, j, a.at(i, j) - f * a.at(r, j))

    @noinline
    first(v: []real) -> real = v[0]

    @noinline
    held(p: *Buf[real]) -> usize = (*p).len()

    main()
        var c: Buf[real] = buf()

        for k in 0..<64 do c.push(real(k))

        axpy(M(8, c), 1, 2, 0.5)
        print(first(c.view_mut()), held(&c))
    """

// `b[i]` is `*b.index_place(i)`: the member reads the header to check the index and hands back the
// element's address, and the read or write through that address -- in the program's own body -- is
// the element side.
@test("a Buf's subscript marks its element access, and the member it calls marks the header")
bfa_subscript_marks_both_sides()
    if bfa_no_library() then return

    val out = bfa_ir(bfa_matrix())
    val set = bfa_body(out, "$M.set(")

    assert(!bfa_lines(set, ["store double", element_mark()]).is_empty(), set)
    assert(bfa_lines(set, ["store double", header_mark()]).is_empty(), set)

    val at = bfa_body(out, "$M.at(")

    assert(!bfa_lines(at, ["load double", element_mark()]).is_empty(), at)

    // `place` only reads its receiver, so the body is the one that reads it where its caller lent it,
    // and the fields it reads there are the header all the same.
    val place = bfa_body(out, "@sysl.buf$BufCore.place.real.owned(")

    assert(!bfa_lines(place, ["load i64", header_mark()]).is_empty(), place)
    assert(bfa_lines(place, ["load i64", element_mark()]).is_empty(), place)

    val outer = bfa_body(out, "@sysl.buf$Buf.index_place.real(")

    // The handle's `index_place` hands the core's address to the core's own `place`, which reads the
    // header (above), so it reads none itself.
    assert(outer.contains("call ptr @sysl.buf$BufCore.place.real.owned(ptr "), outer)
    assert(!outer.contains("load %struct.sysl.buf$BufCore.real"), outer)

private bfa_subscripts() -> string = raw"""
    module demo

    import sysl.buf.{Buf, buf}

    struct P
        x: int
        y: real

    struct Grid
        cells: []real

    impl IndexPlace[usize, real] for Grid
        index_place(*self, i: usize) -> *real = &self.cells[i]

    @noinline
    field(ps: Buf[P], i: usize) -> real = ps[i].y

    @noinline
    unchecked(ps: Buf[P], i: usize) -> int
        @unchecked
            ps[i].x

    @noinline
    nested(bs: Buf[Buf[int]], i: usize) -> usize = bs[i].len()

    @noinline
    grid(g: *Grid) -> real = g[0usize]

    main()
        var ps: Buf[P] = buf()

        ps.push(P(1, 2.0))

        var bs: Buf[Buf[int]] = buf()

        bs.push(buf())

        var g = Grid([1.5, 2.5])

        print(field(ps, 0usize), unchecked(ps, 0usize), nested(bs, 0usize), grid(&g))
    """

// The element side reaches into the element: a field of it, the `@unchecked` subscript's address, and
// a handle that is itself an element -- which is told it is no header, and nothing about handles.
// A subscript of a type the program wrote is nobody's header, and stays unmarked.
@test("a Buf's subscript marks a field of its element, the unchecked form and an element that is a handle; another container's does not")
bfa_subscript_marks_reach_into_the_element()
    if bfa_no_library() then return

    val out = bfa_ir(bfa_subscripts())
    val field = bfa_body(out, "@demo$field(")
    val unchecked = bfa_body(out, "@demo$unchecked(")
    val nested = bfa_body(out, "@demo$nested(")
    val grid = bfa_body(out, "@demo$grid(")

    // A field of an element is read alone, where it lies, and carries the element's mark.
    assert(!bfa_lines(field, ["load double, ptr", element_mark()]).is_empty(), field)
    assert(!field.contains("load %struct.demo$P"), field)
    assert(unchecked.contains("index_place_unchecked"), unchecked)
    assert(!bfa_lines(unchecked, ["load i32, ptr", element_mark()]).is_empty(), unchecked)
    assert(!bfa_lines(nested, ["load %struct.sysl.buf$Buf.int, ptr", element_mark()]).is_empty(), nested)
    assert(bfa_lines(nested, [handle_mark()]).is_empty(), nested)
    assert(grid.contains("load double"), grid)
    assert(!grid.contains("sysl.buf"), grid)

@test("a program's read of a Buf through a counted reference is a read of its box")
bfa_counted_reference_is_box()
    if bfa_no_library() then return

    val body = bfa_body(bfa_ir(bfa_matrix()), "$M.at(")

    assert(!bfa_lines(body, ["load %struct.sysl.buf$Buf.real, ptr", box_mark()]).is_empty(), body)

private bfa_stack_machine() -> string = raw"""
    module demo

    import sysl.buf.{Buf, buf}

    struct Machine
        stack: Buf[int]
        depth: int

    @noinline
    popped_twice(vm: *Machine) -> int
        val a = vm.stack[vm.stack.len() - 1]

        vm.stack.truncate(vm.stack.len() - 1)

        val b = vm.stack[vm.stack.len() - 1]

        vm.stack.truncate(vm.stack.len() - 1)
        a + b

    @export("main")
    entry() -> int
        var m = Machine(buf(), 0)

        m.stack.push(1)
        m.stack.push(2)
        popped_twice(&m)
    """

// A write to a count is the commonest thing between two reads of an interpreter's stack, and a
// `BufCore` holds no handle: the handle in a struct's field is read alone, under its own mark, so the
// optimizer can keep it across that write. A field beside it stays unmarked.
@test("a Buf in a struct's field is read alone and marked as a handle")
bfa_field_is_a_marked_handle()
    if bfa_no_library() then return

    val body = bfa_body(bfa_ir(bfa_stack_machine()), "@demo$popped_twice(")

    assert(!bfa_lines(body, ["load %struct.sysl.buf$Buf.int, ptr", handle_mark()]).is_empty(), body)
    assert(!body.contains("load %struct.demo$Machine"), body)

@test("at -O2 a Buf's handle in a struct's field survives a write to the count")
bfa_handle_kept_across_count_write()
    if bfa_no_library() then return

    bfa_optimized(bfa_stack_machine()) match
        None -> ()
        Some(out) ->
            val body = bfa_body(out, "demo$popped_twice")

            assert(bfa_lines(body, [" = load ptr, ptr %vm"]).len() == 1, body)

// A view the program indexes may be anybody's storage, and a `*Buf` may point among another
// buffer's elements, so neither says which side it is on.
@test("a view the program indexes and a Buf behind a raw pointer carry no mark")
bfa_views_and_raw_pointers_are_unmarked()
    if bfa_no_library() then return

    val out = bfa_ir(bfa_matrix())
    val first = bfa_body(out, "@demo$first(")
    val held = bfa_body(out, "@demo$held(")

    assert(first.contains("load double"), first)
    assert(!first.contains("sysl.buf"), first)
    assert(held.contains("load %struct.sysl.buf$Buf.real"), held)
    assert(!held.contains("sysl.buf.header"), held)

// The point of the marks: the row loop of an elimination keeps the buffer's handle, its storage
// pointer and its count in registers, so its loops read nothing but cells -- which is also what lets
// clang vectorize it.
@test("at -O2 a row loop over a Buf reads only its elements")
bfa_row_loop_reads_only_elements()
    if bfa_no_library() then return

    bfa_optimized(bfa_matrix()) match
        None -> ()
        Some(out) ->
            // clang quotes a name holding a `$`, so the name is asked for without its sigil.
            val body = bfa_body(out, "demo$axpy")
            val loops = bfa_loops(body)

            assert(!loops.is_empty(), body)

            for l in loops
                assert(bfa_lines(l, [" = load double"]).len() + bfa_lines(l, [" = load <"]).len() >= 2, l)
                assert(bfa_lines(l, [" = load ptr"]).is_empty(), l)
                assert(bfa_lines(l, [" = load i64"]).is_empty(), l)
                assert(bfa_lines(l, [" = load i32"]).is_empty(), l)
                assert(bfa_lines(l, [" = load %"]).is_empty(), l)

// Every loop of a body as clang leaves it: the text from a block's label to the branch that goes back
// to it.
private bfa_loops(body: string) -> Buf[string]
    var found: Buf[string] = buf()
    var labels: Buf[(string, usize)] = buf()
    val lines = lines_of(body)

    for n in 0..<lines.len()
        val l = lines[n]

        if l.len > 0 && !l.starts_with(" ") && l.contains(":")
            labels.push((l[0..<l.index_of(":").unwrap()], n))

        if l.contains("br ")
            for item in labels
                if l.contains(s"label %${item.0},") || l.ends_with(s"label %${item.0}") ||
                   l.contains(s"label %${item.0} ")
                    var text = ""

                    for k in item.1..n
                        text = text + lines[k] + "\n"

                    found.push(text)

    found
end bfa_loops

// -- an append is an element write -----------------------------------------------------------------

private bfa_appends() -> string = raw"""
    module demo

    import sysl.buf.{Buf, buf}

    @noinline
    bytes(out: Buf[u8], n: usize)
        for j in 0..<n do out.push(u8(j))

    @noinline
    words(out: Buf[int], n: int)
        for j in 0..<n do out.push(j)

    @noinline
    nested(out: Buf[Buf[int]]) = out.push(buf())

    @noinline
    own(n: usize) -> int
        val s = slot_storage[int](n)

        slot_place(s, 0, 7)
        s[0]

    @noinline
    copy_into(seq: []const u8, out: Buf[u8])
        for j in 0..<seq.len do out.push(seq[j])

    @noinline
    reversed_into(seq: []const u8, out: Buf[u8])
        for j in 0..<seq.len do out.push(seq[seq.len - 1 - j])

    main()
        val b: Buf[u8] = buf()
        val w: Buf[int] = buf()
        val n: Buf[Buf[int]] = buf()

        bytes(b, 3)
        words(w, 3)
        nested(n)
        copy_into(b.view(), b)
        reversed_into(b.view(), b)
        print(b.len(), w.len(), n.len(), own(2))
    """

// `push` places its element with `slot_place` into the core's own storage, and that write is on the
// elements' side whatever the element is: a byte, a word, and a handle that holds a count -- whose
// placing also reads and raises the live prefix in the storage's own box, which is no header either.
// A program's own `slot_place` into storage it made is nobody's buffer, and stays unmarked.
@test("an append marks its element write, and the live prefix it moves, on the elements' side")
bfa_append_marks_the_element()
    if bfa_no_library() then return

    val out = bfa_ir(bfa_appends())
    val b = bfa_body(out, "@sysl.buf$BufCore.push.byte(")
    val w = bfa_body(out, "@sysl.buf$BufCore.push.int(")
    val n = bfa_body(out, "@sysl.buf$BufCore.push.sysl.buf$Buf.int.owned(")
    val own = bfa_body(out, "@demo$own(")

    assert(bfa_lines(b, ["store i8", element_mark()]).len() == 1, b)
    assert(bfa_lines(b, ["store i8", header_mark()]).is_empty(), b)
    assert(bfa_lines(w, ["store i32", element_mark()]).len() == 1, w)
    assert(bfa_lines(n, ["store %struct.sysl.buf$Buf.int", element_mark()]).len() == 1, n)
    assert(bfa_lines(n, ["load i64", element_mark()]).len() == 1, n)
    assert(bfa_lines(n, ["store i64", element_mark()]).len() == 1, n)
    assert(bfa_lines(n, ["load ptr", element_mark()]).len() == 1, n)

    // The count `push` raises is still the header's.
    assert(!bfa_lines(b, ["store i64", header_mark()]).is_empty(), b)
    assert(own.contains("store i32 7"), own)
    assert(!own.contains("sysl.buf"), own)

// The point of the mark: a loop appending one buffer's elements to another keeps the count and the
// capacity in registers. Off the growth path the loop reads neither, and the capacity is not read
// again after the element is written to re-check the clause. The growth path is a call that rewrites
// the header, so the loop reads both again there -- and the storage pointer, which that path does not
// read, is read once per element, a load no store in the loop waits on.
@test("at -O2 an append loop keeps the count and the capacity in registers off the growth path")
bfa_append_loop_keeps_the_header()
    if bfa_no_library() then return

    bfa_optimized(bfa_appends()) match
        None -> ()
        Some(out) -> bfa_header_kept(bfa_body(out, "demo$copy_into"))

// The same loop reading its source back to front -- revcomp's inner loop. The subscript's bounds check
// is provably true here, but it is folded only after the pass that would carry the header around the
// loop, and until then it is a branch out of the loop that stops that pass; so the count and the
// capacity are still read for every element.
@test("at -O2 an append loop reading its source back to front keeps the header in registers", ignore: "the bounds check of seq[seq.len - 1 - j] is folded after GVN, and blocks its load PRE")
bfa_reversed_append_loop_keeps_the_header()
    if bfa_no_library() then return

    bfa_optimized(bfa_appends()) match
        None -> ()
        Some(out) -> bfa_header_kept(bfa_body(out, "demo$reversed_into"))

// Every loop of an append body reads no count or capacity off the growth path.
private bfa_header_kept(body: string)
    val loops = bfa_loops(body)

    assert(!loops.is_empty(), body)

    for l in loops
        val hot = bfa_off_growth(l)

        assert(bfa_lines(hot, ["store i8"]).len() == 1, l)
        assert(bfa_lines(hot, [" = load i64"]).is_empty(), l)
        assert(bfa_lines(hot, [" = load ptr"]).len() <= 1, l)
        assert(bfa_lines(l, ["call", "grow_store"]).len() == 1, l)
        assert(bfa_lines(l, [" = load i64"]).len() == 2, l)
end bfa_header_kept

// The blocks of a loop's text other than the one that calls the growth.
private bfa_off_growth(text: string) -> string
    var kept = ""
    var block = ""
    var grows = false

    for l in lines_of(text)
        if l.len > 0 && !l.starts_with(" ") && l.contains(":")
            if !grows then kept = kept + block

            block = ""
            grows = false

        if l.contains("grow_store") then grows = true

        block = block + l + "\n"

    if !grows then kept = kept + block

    kept
end bfa_off_growth

// -- the marks claim nothing that is not so ---------------------------------------------------------

private bfa_runs(text: string) -> int
    val root = runner_project("main.sysl", forms_imported(text))
    val cache = make_temp_dir("sysl-bfa-cache").unwrap()

    use_run_cache_dir(Some(cache))

    var said: Buf[string] = buf()
    val sink = &said
    val code = run_cli(["sysl", "run", s"$root/main.sysl", "-O2"], piece -> sink.push(piece))

    use_run_cache_dir(None)
    remove_dir_all(root).unwrap_or(())
    remove_dir_all(cache).unwrap_or(())
    code
end bfa_runs

private bfa_ready() -> bool = std_root().is_ok() && clang_available()

// Every push may move the storage and rewrites the header, and the element read after it has to go
// through the new storage: the marks say elements and header are apart, never that a header read
// may be carried across a header write.
@test("at -O2 a loop that grows a Buf while reading it computes right")
bfa_growing_while_reading()
    if !bfa_ready() then return

    assert_eq(bfa_runs(raw"""
        import sysl.buf.{Buf, buf}

        main()
            var b: &Buf[int] = buf()
            var a: [101]int = [0; 101]

            b.push(1)
            a[0] = 1

            for i in 0..<100
                b.push((b[usize(i)] + b[usize(i / 2)]) % 1000003)
                a[i + 1] = (a[i] + a[i / 2]) % 1000003

            var same = b.len() == 101 && b.cap() == 128

            for i in 0..<101
                if b[usize(i)] != a[i] then same = false

            exit(if same && b[1] == 2 && b[2] == 3 then 42 else 1)
        """), 42)

// A buffer of buffers keeps the inner handles among the outer one's elements -- the one place a
// `Buf` is not header storage, which is why only a counted reference's box is marked as one.
@test("at -O2 a Buf of Bufs, pushed into through the outer one, computes right")
bfa_buffer_of_buffers()
    if !bfa_ready() then return

    assert_eq(bfa_runs(raw"""
        import sysl.buf.{Buf, buf}

        main()
            var outer: Buf[Buf[int]] = buf()

            for i in 0..<4 do outer.push(buf())

            for k in 0..<40
                val inner = outer[usize(k % 4)]

                inner.push(k + int(inner.len()))

            var sum = 0

            for i in 0..<outer.len()
                for x in outer[i].view() do sum += x

            exit(if sum == 780 + 4 * 45 && outer[3][9] == 48 then 42 else 1)
        """), 42)

// The bytes appended spell little-endian words -- a count, a capacity -- which the marks must not
// care about: they say where a write lands, never what it holds. The second append reads a view of
// the very buffer it grows, so every growth moves the storage under the loop, and the count and the
// storage it carries in registers have to be the ones the growth left.
@test("at -O2 a Buf[u8] of header-like words, appended reversed and into itself from its own view, computes right")
bfa_bytes_appended_reversed()
    if !bfa_ready() then return

    assert_eq(bfa_runs(raw"""
        import sysl.buf.{Buf, buf}

        @noinline
        reversed_into(seq: []const u8, out: Buf[u8])
            for j in 0..<seq.len do out.push(seq[seq.len - 1 - j])

        main()
            val seq: Buf[u8] = buf()
            val out: Buf[u8] = buf()

            for k in 0..<1000
                seq.push(u8(k % 256))
                seq.push(u8(k / 256))

                for z in 0..<6 do seq.push(0)

            reversed_into(seq.view(), out)
            reversed_into(out.view(), out)

            var same = out.len() == 16000

            for j in 0..<8000
                if out[j] != seq[7999 - j] || out[8000 + j] != seq[j] then same = false

            exit(if same && out[7999] == 0 && out[8001] == 0 && out[8008] == 1 then 42 else 1)
        """), 42)

// Two buffers of handles appended in one loop, the second taking handles out of the first: each
// append places a counted element, so it moves the live prefix in the storage's box as well as the
// element, and a push into an inner buffer through one outer buffer is seen through the other.
@test("at -O2 two Bufs of Bufs appended in one loop, sharing their handles, compute right")
bfa_two_buffers_of_buffers()
    if !bfa_ready() then return

    assert_eq(bfa_runs(raw"""
        import sysl.buf.{Buf, buf}

        main()
            val a: Buf[Buf[int]] = buf()
            val b: Buf[Buf[int]] = buf()

            for k in 0..<300
                val inner: Buf[int] = buf()

                inner.push(k)
                a.push(inner)
                b.push(a[usize(k / 2)])

            b[0].push(7)

            var sum = 0

            for i in 0..<b.len() do sum += b[i][0]

            exit(if a.len() == 300 && sum == 22350 && a[0].len() == 2 && a[0][1] == 7 then 42 else 1)
        """), 42)

// A handle reached through a pointer among another buffer's elements is replaced by an element write,
// and the next push has to go through the new handle and its core, not the one read before the write.
@test("at -O2 a handle among another buffer's elements, replaced by an element write, is read again")
bfa_handle_among_elements_replaced()
    if !bfa_ready() then return

    assert_eq(bfa_runs(raw"""
        import sysl.buf.{Buf, buf}

        main()
            var outer: Buf[Buf[int]] = buf()

            outer.push(buf())

            val p: *Buf[int] = outer.index_place(0)
            var seen = 0usize

            for k in 0..<10
                p.push(k)
                p.push(k)
                outer[0] = buf()
                p.push(k)
                seen += p.len()

            exit(if seen == 10 && outer[0].len() == 1 && outer[0][0] == 9 then 42 else 1)
        """), 42)

// A handle among the elements of a buffer of structs, read through a `*Machine` while the element is
// replaced whole: the element write is told nothing about handles.
@test("at -O2 a handle in a struct among another buffer's elements, replaced whole, is read again")
bfa_struct_handle_among_elements_replaced()
    if !bfa_ready() then return

    assert_eq(bfa_runs(raw"""
        import sysl.buf.{Buf, buf}

        struct Machine
            stack: Buf[int]
            depth: int

        main()
            var parked: Buf[Machine] = buf()

            parked.push(Machine(buf(), 0))

            val vm: *Machine = parked.index_place(0)
            var seen = 0usize

            for k in 0..<10
                vm.stack.push(k)
                vm.stack.push(k)
                vm.stack.truncate(vm.stack.len() - 1)
                parked[0] = Machine(buf(), k)
                vm.stack.push(k)
                seen += vm.stack.len()

            exit(if seen == 10 && parked[0].stack[0] == 9 then 42 else 1)
        """), 42)

// Storage a program lays out itself: a handle written as bytes into a `Buf[usize]` and cleared by an
// element write, so the handle reads as naming nothing. The two kinds are told nothing about each other.
@test("at -O2 a handle in a Buf of words, cleared by an element write, reads as naming nothing")
bfa_handle_in_words_cleared()
    if !bfa_ready() then return

    assert_eq(bfa_runs(raw"""
        import sysl.buf.{Buf, buf}
        import sysl.raw.ptr_cast

        struct Holder
            items: Buf[int]

        main()
            var words: Buf[usize] = buf()

            words.push(0)

            val h: *Holder = ptr_cast(words.index_place(0))
            var seen = 0usize

            seen += h.items.len()
            words[0] = 0
            seen += h.items.len()
            exit(if seen == 0 then 42 else 1)
        """), 42)

// A handle in a box read through a pointer taken from the box, while the box is assigned: the box and
// a handle are told nothing about each other.
@test("at -O2 a Buf's box assigned while a pointer into it reads the handle computes right")
bfa_box_assigned_through_pointer()
    if !bfa_ready() then return

    assert_eq(bfa_runs(raw"""
        import sysl.buf.{Buf, buf}

        @noinline
        length_of(p: *Buf[int]) -> usize = p.len()

        @noinline
        swapped(c: &Buf[int], p: *Buf[int], next: Buf[int]) -> usize
            val before = p.len()

            *c = next
            before + p.len()

        main()
            val c: &Buf[int] = buf()

            c.push(1)

            val other: Buf[int] = buf()

            other.push(2)
            other.push(3)
            exit(if swapped(c, &*c, other) == 3 && length_of(&*c) == 2 then 42 else 1)
        """), 42)

// A pop writes the count and a further pop reads the handle it kept: a growth in between replaces the
// storage behind the core, which the handle's being kept must not hide, and a field read off a returned
// struct has no storage to read alone.
@test("at -O2 pops, a growth and a field off a returned struct, through a kept handle, compute right")
bfa_kept_handle_sees_growth()
    if !bfa_ready() then return

    assert_eq(bfa_runs(raw"""
        import sysl.buf.{Buf, buf}

        struct Machine
            stack: Buf[int]
            depth: int

        @noinline
        made() -> Machine
            val m = Machine(buf(), 1)

            m.stack.push(5)
            m

        @noinline
        churn(vm: *Machine) -> int
            var total = 0

            for k in 0..<100
                vm.stack.push(k)
                vm.stack.push(k + 1)

                val top = vm.stack.pop().unwrap()

                for j in 0..<20 do vm.stack.push(j)

                vm.stack.truncate(vm.stack.len() - 20)
                total += top + vm.stack.pop().unwrap()

            total

        main()
            var m = Machine(buf(), 0)
            val got = churn(&m)

            exit(if got == 10000 && m.stack.len() == 0 && made().stack[0] == 5 then 42 else 1)
        """), 42)

// A handle in a struct, assigned a new buffer between pushes and pops and released to naming nothing:
// every member reads the core the handle names now, the shared empty one included.
@test("at -O2 a struct's Buf field reassigned and released between pushes and pops computes right")
bfa_handle_reassigned_between_ops()
    if !bfa_ready() then return

    assert_eq(bfa_runs(raw"""
        import sysl.buf.{Buf, buf}

        struct Vm
            stack: Buf[int]

        main()
            val vm: &Vm = Vm(buf())
            var total = 0

            for k in 0..<20
                vm.stack.push(k)
                vm.stack.push(k + 1)
                total += vm.stack.pop().unwrap_or(-100)

                if k % 3 == 0 then vm.stack = buf()

                if k % 5 == 0
                    vm.stack.release()
                    total += int(vm.stack.len()) + vm.stack.pop().unwrap_or(1000)
                    vm.stack = buf()

                total += int(vm.stack.len()) + vm.stack.pop().unwrap_or(1000)

            exit(if total == 13333 then 42 else 1)
        """), 42)

// A view handed out, and a pointer cast from an element's address, read and write the same storage
// with no mark at all, so the optimizer has to assume they touch everything.
@test("at -O2 storage written through a view and a reinterpreted pointer reads back through the Buf")
bfa_reinterpreted_storage()
    if !bfa_ready() then return

    assert_eq(bfa_runs(raw"""
        import sysl.buf.{Buf, buf}

        main()
            var b: &Buf[u32] = buf()

            for i in 0..<8 do b.push(u32(i))

            var total = 0u32

            for i in 0..<8
                val v = b.view_mut()
                val p: *u16 = ptr_cast(b.index_place(usize(i)))

                v[i] = v[i] + 100
                p[0] = p[0] + 1
                total += b[usize(i)]

            exit(if total == 28 + 800 + 8 && b[7] == 108 then 42 else 1)
        """), 42)
