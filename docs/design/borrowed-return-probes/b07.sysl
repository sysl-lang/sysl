// The pre-0.7.5 HashLife shape (automata dev): `node(self, n) -> Node = self.nodes[usize(n)]`.
// The receiver is a large struct taken by value and the answer is an element copied out of a Buf.
import sysl.buf.{Buf, buf}

struct Node
    level: int
    nw: int
    ne: int
    sw: int
    se: int
    bits: u64
    pop: i64
    result: int

struct Universe
    nodes: Buf[Node]
    root: int
    a: int
    b: int
    c: int
    d: int

    node(self, n: int) -> Node = self.nodes[usize(n)]

    population(self) -> i64 = self.node(self.root).pop

var u = Universe(buf(), 0, 0, 0, 0, 0)

u.nodes.push(Node(0, -1, -1, -1, -1, 0, 7, -1))
print(u.population())
