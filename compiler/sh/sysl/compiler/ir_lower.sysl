module sh.sysl.compiler

import sysl.buf.{Buf, buf}

// Lowering a type to LLVM's, and the module-level definitions the named ones need.
//
// **This is the erasure**, and it is the whole reason the intermediate representation has a type
// system of its own: a `Constrained` subtype is its base, a `volatile` qualifier is nothing at all,
// a trait object is two words, and a type parameter has no answer because a type parameter never
// reaches here. What comes out is what LLVM's own type system says and nothing the language knew.
//
// **Four shapes have no lowering, and they answer `None` rather than something plausible.** A type
// parameter, a trait standing as a type of its own, a value written where a type was expected, and
// a pack of types are each a *diagnostic* shape: the walk that reads a generic body once at its own
// definition builds them, and no value at run time has one. A back end that was handed a guess for
// one of them would lay out a type nothing has.
type_lty(t: Type, word_bits: int) -> Option[LType] = t match
    Integer(bits, _, _) -> Some(LInt(bits))
    Floating(bits, brain) -> Some(LFloat(bits, brain))
    Fixed(bits, _, _) -> Some(LInt(bits))
    Char -> Some(LInt(32))
    Bool -> Some(LInt(1))
    Unit -> Some(LVoid)

    // Four pointers' worth covers every variadic cursor the compiler targets, and only the prefix
    // the ABI defines is ever touched.
    VaList -> Some(LArr(4, LPtr))

    // An expression that does not come back leaves no value, so there is nothing to carry.
    Never -> Some(LVoid)
    Unknown -> Some(LVoid)

    Abstract(_, _) -> None
    Trait(_, _, _) -> None
    ConstArg(_, _, _) -> None
    Pack(_) -> None

    // A pointer to a trait carries the table beside the address; every other pointer is one word.
    Ptr(inner) -> Some(if points_at_trait(*inner) then l_fat() else LPtr)
    Ref(inner, _) -> Some(if points_at_trait(*inner) then l_fat() else LPtr)
    Weak(inner) -> Some(if points_at_trait(*inner) then l_fat() else LPtr)

    // A function under the C convention is an address and nothing else.
    CFn(_, _) -> Some(LPtr)

    // A qualifier on the storage rather than a type of its own.
    Volatile(inner) -> type_lty(*inner, word_bits)

    Array(length, elem) -> type_lty(*elem, word_bits) match
        Some(e) -> Some(LArr(length, e))
        None -> None
    Vector(length, elem) -> type_lty(*elem, word_bits) match
        Some(e) -> Some(LVec(length, e))
        None -> None

    // Every view has the same three words, so the element type shows up only in the instructions
    // that reach through it -- which is what lets a slice and a string share one implementation.
    Slice(_, _) -> Some(l_view(word_bits))
    Str -> Some(l_view(word_bits))

    // A task is the address of its coroutine's promise, which is a box header followed by what the
    // task ends with (`emit_async.sysl`).
    Struct(d) -> Some(if d.base == TaskBase then LPtr else struct_lty(d))
    Results(parts) -> Some(struct_lty(parts))

    // A simple enum is its underlying integer and has no layout of its own.
    Enum(d) -> if d.simple then type_lty(d.underlying, word_bits) else Some(enum_lty(d))

    // A named subtype is stored as what it narrows.
    Constrained(d) -> type_lty(d.base, word_bits)

// Whether what a pointer points at is a trait, which is the one thing that makes it two words.
private points_at_trait(inner: Type) -> bool = inner match
    Trait(_, _, _) -> true
    _ -> false

// The name LLVM knows a struct by. A tuple and a result list are structs too, so this is the one
// spelling for all three.
struct_lty(d: &StructType) -> LType = LNamed(s"%struct.${mangled(d.base, d.targs)}")

// The name LLVM knows a data enum by.
enum_lty(d: &EnumType) -> LType = LNamed(s"%enum.${mangled(d.base, d.targs)}")

// The payload aggregate a data variant stores -- `%Shape.Circle`.
variant_lty(d: &EnumType, v: EnumVariant) -> LType = LNamed(s"%${mangled(d.base, d.targs)}.${v.name}")

// The type a data enum's tag is read at. A simple enum's tag is the whole of it and takes the
// underlying width; every other is an `i32`.
enum_tag_lty(d: &EnumType, word_bits: int) -> LType =
    if d.simple then type_lty(d.underlying, word_bits).unwrap_or(LInt(32)) else LInt(32)

// The same, written down. Every LLVM type text comes from here and none of it is built by
// concatenation: `type_lty` decides the shape and `l_render` spells it, so the two questions have
// one answer each rather than one answer between them.
type_llvm(t: Type, word_bits: int) -> Option[string] = type_lty(t, word_bits) match
    Some(l) -> Some(l_render(l))
    None -> None

// -- the definitions a named type needs at module level -------------------------------------------

// A struct's definition: its stored fields in declaration order, or the one integer a bitfield
// struct really is.
//
// **A bitfield struct has no members here at all**: it is one integer, and its fields are bit ranges
// of that integer rather than anything LLVM is told about. Writing the container inside `<{ }>`
// rather than as a bare `iM` is what keeps every site that reaches into a struct -- an alloca, a
// by-value parameter, a load of the whole of one -- on the one shape.
//
// A type carries no alignment in LLVM's textual form, so `@align(n)` cannot be written onto it: the
// boundary is stated where storage is created, which is what an alloca and a global carry. **Where
// the boundary is raised, the GAPS are written here instead** (`gapped_fields`), so LLVM's offsets
// and size are the layout's wherever the type is held.
struct_type_def(d: &StructType, l: TargetLayout) -> Option[IrTypeDef]
    val word_bits = int(l.word_bits)
    var fields: Buf[LType] = buf()

    bitfield_ranges(d) match
        Some(ranges) -> fields.push(LInt(bitfield_bits(ranges)))
        None ->
            val stored = d.stored()

            for item in stored
                type_lty(item.1, word_bits) match
                    Some(t) -> fields.push(t)
                    None -> return None

    val name = s"%struct.${mangled(d.base, d.targs)}"

    struct_gaps(l, d) match
        Some(g) -> Some(IrTypeDef(name, gapped_fields(fields, g), d.packed))
        None -> Some(IrTypeDef(name, fields, d.packed))
end struct_type_def

// -- the gaps a raised boundary writes out -------------------------------------------------------
//
// A struct whose `@align(n)` asks for more than its fields give it is laid out by `TargetLayout` with
// gaps LLVM knows nothing of: in front of a field that holds one, and at the end. For every type
// holding such a struct (`holds_raised`) each gap is written as `[k x i8]`. Each field then begins
// exactly where LLVM would put it anyway -- the layout's offset is a multiple of the field's
// boundary, which is at least the one LLVM gives its type, and both are powers of two -- so the
// definition stays an ordinary one, and a `@packed` struct stays packed.
//
// What the gaps cost is that a field's LLVM index is no longer its stored position, so **every index
// into a struct, a variant's payload or a data enum is asked of `llvm_index`**, and a constant of
// one carries a zero for each gap (`gapped_values`).

// Where each stored field of a run begins, how many bytes it takes, and the size of the whole.
struct Gaps
    offsets: Buf[usize]
    sizes: Buf[usize]
    size: usize
end Gaps

// A struct's gaps, where it holds a raised boundary. A bitfield struct's one integer sits at zero
// and takes what LLVM allocates for it.
struct_gaps(l: TargetLayout, d: &StructType) -> Option[Gaps]
    if !l.struct_holds_raised(d) then return None

    var offsets: Buf[usize] = buf()
    var sizes: Buf[usize] = buf()

    bitfield_ranges(d) match
        Some(ranges) ->
            offsets.push(0)
            sizes.push(int_alloc(bitfield_bits(ranges)))
        None ->
            val fields = d.stored()
            var at: usize = 0

            for item in fields
                val ty = item.1

                if !d.packed then at = round_up(at, l.align(ty))

                offsets.push(at)
                sizes.push(l.size(ty))
                at += l.size(ty)

    Some(Gaps(offsets, sizes, l.size(Struct(d))))
end struct_gaps

// A carrying variant's payload aggregate: its fields end to end, as `TargetLayout` lays one.
variant_gaps(l: TargetLayout, v: EnumVariant) -> Option[Gaps]
    if !l.variant_holds_raised(v) then return None

    val fields = v.stored()
    var offsets: Buf[usize] = buf()
    var sizes: Buf[usize] = buf()
    var at: usize = 0
    var widest: usize = 1

    for item in fields
        val ty = item.1
        val a = l.align(ty)

        if a > widest then widest = a

        at = round_up(at, a)
        offsets.push(at)
        sizes.push(l.size(ty))
        at += l.size(ty)

    Some(Gaps(offsets, sizes, round_up(at, widest)))
end variant_gaps

// A data enum: the tag, and the payload region where the layout puts it.
enum_gaps(l: TargetLayout, d: &EnumType) -> Option[Gaps]
    if d.simple || !l.enum_holds_raised(d) then return None

    val unit = l.payload_align(d)
    var offsets: Buf[usize] = buf()
    var sizes: Buf[usize] = buf()

    offsets.push(0)
    sizes.push(4)
    offsets.push(round_up(4, unit))
    sizes.push(round_up(l.payload_size(d), unit))
    Some(Gaps(offsets, sizes, l.size(Enum(d))))
end enum_gaps

// Whether a gap goes in front of the `k`th field (and, at `k` == the field count, at the end).
private gap_before(g: Gaps, k: usize) -> usize
    val end_of_previous = if k == 0 then 0 else g.offsets.at(k - 1) + g.sizes.at(k - 1)
    val start = if k < g.offsets.len() then g.offsets.at(k) else g.size

    if start > end_of_previous then start - end_of_previous else 0
end gap_before

private gap_lty(bytes: usize) -> LType = LArr(int(bytes), LInt(8))

// **The one answer to "where is stored field `k` in LLVM's numbering"**: its position, plus one for
// each gap in front of it and in front of any field before it.
llvm_index(g: Option[Gaps], k: usize) -> int = g match
    Some(gaps) ->
        var at = int(k)

        for j in 0..<k + 1
            if j < gaps.offsets.len() && gap_before(gaps, j) > 0 then at += 1

        at
    None -> int(k)

// A definition's fields with each gap written in.
gapped_fields(fields: Buf[LType], g: Gaps) -> Buf[LType]
    var out: Buf[LType] = buf()

    for k in 0..<fields.len() + 1
        val gap = gap_before(g, k)

        if gap > 0 then out.push(gap_lty(gap))
        if k < fields.len() then out.push(fields.at(k))

    out
end gapped_fields

// A constant's fields with a zero for each gap.
gapped_values(values: Buf[IrArg], g: Option[Gaps]) -> Buf[IrArg]
    val gaps = g match
        Some(x) -> x
        None -> return values

    var out: Buf[IrArg] = buf()

    for k in 0..<values.len() + 1
        val gap = gap_before(gaps, k)

        if gap > 0 then out.push(ir_arg(gap_lty(gap), VZero))
        if k < values.len() then out.push(values.at(k))

    out
end gapped_values

// The index of a struct's `k`th stored field.
struct_field_index(l: TargetLayout, d: &StructType, k: usize) -> int = llvm_index(struct_gaps(l, d), k)

// The index of a variant payload's `k`th stored field.
variant_field_index(l: TargetLayout, v: EnumVariant, k: usize) -> int = llvm_index(variant_gaps(l, v), k)

// The index of a data enum's payload region, behind its tag.
enum_payload_index(l: TargetLayout, d: &EnumType) -> int = llvm_index(enum_gaps(l, d), 1)

// A data enum's definitions: one aggregate per variant that carries something, and then the enum
// itself.
//
// A data enum is the tag and **one** payload region, wide enough and aligned for whichever variant
// needs the most. Each variant's own payload keeps its named aggregate type, which is what a
// construction stores into that region and what a match reads back out of it.
enum_type_defs(d: &EnumType, l: TargetLayout) -> Buf[IrTypeDef]
    val word_bits = int(l.word_bits)
    var out: Buf[IrTypeDef] = buf()

    for v in d.variants
        if v.carries
            var fields: Buf[LType] = buf()
            val stored = v.stored()
            var whole = true

            for j in 0..<stored.len()
                type_lty(stored.at(j).1, word_bits) match
                    Some(t) -> fields.push(t)
                    None -> whole = false

            if whole
                val laid = variant_gaps(l, v) match
                    Some(g) -> gapped_fields(fields, g)
                    None -> fields

                out.push(ir_type_def(l_render(variant_lty(d, v)), laid))

    val area = payload_area(d, l)
    var body: Buf[LType] = buf()

    body.push(LInt(32))
    body.push(LArr(area.1, area.0))

    val laid = enum_gaps(l, d) match
        Some(g) -> gapped_fields(body, g)
        None -> body

    out.push(ir_type_def(l_render(enum_lty(d)), laid))
    out
end enum_type_defs

// The payload region: a unit as wide as the strictest alignment any variant needs, and as many of
// them as the widest payload takes.
payload_area(d: &EnumType, l: TargetLayout) -> (LType, int)
    val align = l.payload_align(d)
    val unit = if align > 1 then align else 1

    (LInt(int(unit) * 8), int(round_up(l.payload_size(d), unit) / unit))
end payload_area
