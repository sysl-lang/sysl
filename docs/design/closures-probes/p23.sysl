// A closure holding a local's address handed to a generic (bare-arrow) parameter that stores it in a
// buffer the caller passes in: kept through another parameter, which the caller owns, so it is the
// caller's to say.
import sysl.buf.{Buf, buf}

hold(into: *Buf[&Fn() -> unit], f: () -> unit) = into.push(f)

run()
    var n = 0
    val p = &n
    var b: Buf[&Fn() -> unit] = buf()

    hold(&b, () -> *p += 1)
    b[0]()
    print(n)

run()
