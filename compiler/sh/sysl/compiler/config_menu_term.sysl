module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.fs.{is_file, read_text, write_text}
import sysl.io.stdin
import sysl.posix.tty.{flush, is_tty}
import sysl.signal.{HUP, TERM, WINCH, watch}
import sysl.term.{clear_below, clear_to_line_end, hide_cursor, home, show_cursor}
import sysl.text.join
import sysl.tty

// The terminal half of `sysl config`'s menu (`config_menu.sysl` is the rest): the keyboard read a
// key at a time, the screen drawn whole on each change, and the manifest written after each change
// that resolves.
//
// **It reads the keys and the window's size itself**, through `menu_keys` below and
// `config_menu_size.sysl`, because the compiler is built by the release before it: `sysl.term.keys`
// and `sysl.posix.tty.window_size` are the library's own answers to both, and this file takes them up
// in the release after the one that ships them.

// The full-screen sequences `sysl.term` names as `alt_screen`, `main_screen`, `sync_begin` and
// `sync_end`.
private const menu_alt_screen: string = "\u{1b}[?1049h"
private const menu_main_screen: string = "\u{1b}[?1049l"
private const menu_sync_begin: string = "\u{1b}[?2026h"
private const menu_sync_end: string = "\u{1b}[?2026l"

// Whether bare `sysl config` opens the menu: both standard input and standard output are a terminal.
config_menu_wanted() -> bool = is_tty(0) && is_tty(1)

// `sysl config [--target <t>]` on a terminal.
config_menu_command(c: ConfigCommand, say: string -> unit, note: string -> unit) -> int
    var named: Option[string] = None

    for f in c.flags
        if f.0 == "--target"
            named = Some(f.1)
        else
            var mistakes: Buf[string] = buf()

            mistakes.push(OptionLead + s"'${f.0}' is not an option of the menu — it takes '--target <t>'")
            note(misused(mistakes, config_usage()))
            return Misused

    two_manifests(c.dir) match
        Some(why) ->
            note(refused(why))
            return Failed
        None -> ()

    val file = manifest_path(c.dir)

    if !is_file(file)
        note(refused(s"there is no $ManifestName in '${c.dir}' — 'sysl config' edits a project's manifest, " +
            "and 'sysl init' writes one"))
        return Failed

    val text = read_text(file) match
        Err(_) ->
            note(refused(s"cannot read $file"))
            return Failed
        Ok(got) -> got

    val t = target_for(c.dir, named) match
        Err(r) ->
            note(refused(r.message))
            return Failed
        Ok(got) -> got

    val view = menu_view_of(c.dir, text, t) match
        Err(why) ->
            note(refused(why))
            return Failed
        Ok(got) -> got

    val found = tty.mode() match
        None ->
            note(refused("the menu needs a terminal to draw on — the subcommands make the same changes"))
            return Failed
        Some(m) -> m

    // Raw, and a read that gives up after a tenth of a second: the pause that tells a lone Escape from
    // the start of a sequence, and the moment a resize is noticed.
    if !tty.set_mode(tty.raw_of(found) with { min = 0, time = 1 })
        note(refused("the terminal would not leave its line mode, so the menu cannot read a key at a time"))
        return Failed

    var done: Buf[string] = buf()
    val code = menu_session(c.dir, file, t, menu_of(view, text), &done)

    tty.cooked()

    for line in done
        say(line)

    code
end config_menu_command

// The loop: draw, read, act, until a key or a signal ends it.
private menu_session(dir: string, file: string, t: Target, start: Menu, done: *Buf[string]) -> int
    var menu = start
    val resized = watch(WINCH).unwrap()
    val ended = watch(TERM).unwrap()
    val hung = watch(HUP).unwrap()
    var input = stdin()
    var into = [0u8; 64]
    var keys = menu_keys()
    var dirty = true

    menu_put(menu_alt_screen + hide_cursor)

    while !menu.quit
        if resized.take() then dirty = true
        if ended.take() || hung.take() then break

        val (rows, cols) = menu_window()

        if dirty
            menu_draw(&menu, rows, cols)
            dirty = false

        val got = input.read(into[..])

        if got.len == 0
            if keys.partial()
                keys.pause()
            else
                if input.failed() then break
                continue

        for b in got
            keys.push(b)
            menu_take_keys(&menu, &keys, dir, file, t, rows, done)

        // A pause finishes a lone Escape, which is a key like any other.
        menu_take_keys(&menu, &keys, dir, file, t, rows, done)
        dirty = true

    menu_put(show_cursor + menu_main_screen)
    Fine
end menu_session

// Every key the decoder has finished, each acted on in turn.
private menu_take_keys(menu: *Menu, keys: *MenuKeys, dir: string, file: string, t: Target, rows: int,
                       done: *Buf[string])
    loop
        if menu.quit then return

        val k = keys.next() match
            None -> return
            Some(found) -> found

        val before = menu.text
        val step = menu_key(menu, k, if rows > 3 then usize(rows - 3) else 1)

        if step.edits.is_empty() then continue

        // **Written only once it resolves**: the subcommand's own check is the reader's, and the menu
        // holds a change to the build's as well, so a change the build would refuse is said and the
        // file left as it was.
        menu_view_of(dir, step.text, t) match
            Err(why) ->
                menu.text = before
                menu.message = why
            Ok(view) ->
                write_text(file, step.text) match
                    Err(e) ->
                        menu.text = before
                        menu.message = io_refusal(file, e)
                    Ok(_) ->
                        for words in step.edits
                            done.push("sysl config " + join(words.view(), " "))

                        *menu = menu_refreshed(*menu, view, step.text)
end menu_take_keys

// One frame, written in one write: home, each line over the last frame's, and what is left cleared.
private menu_draw(menu: *Menu, rows: int, cols: int)
    val lines = menu_lines(menu, usize(cols), usize(rows), true)
    var parts: Buf[string] = buf()

    for line in lines
        parts.push(line + clear_to_line_end)

    menu_put(menu_sync_begin + home + join(parts.view(), "\r\n") + clear_below + menu_sync_end)
end menu_draw

private menu_put(text: string)
    prints(text)
    flush()

// The window's rows and columns, or a VT100's where it gives none.
private menu_window() -> (int, int) = menu_window_size(1) match
    Some(size) -> size
    None -> (24, 80)

// -- keys -------------------------------------------------------------------------------------------------

// The bytes a terminal sends, as the menu's keys: `sysl.term.keys.KeyDecoder`'s rules, in the menu's
// vocabulary -- both spellings of every arrow, a sequence read to its final byte, a lone Escape
// answered at a pause, a CRLF one Enter.
struct MenuKeys
    private state: int
    private param: int
    private params: int
    private cp: uint
    private more: int
    private owed_lf: bool
    private first: Option[MenuKey]
    private second: Option[MenuKey]

    push(*self, b: u8)
        if self.state == 1 then self.after_escape(b)
        elif self.state == 2 then self.csi(b)
        elif self.state == 3
            self.state = 0
            self.final_key(b, 0)
        elif self.state == 4 then self.continuation(b)
        else self.ground(b)
    end push

    pause(*self)
        val was = self.state

        self.state = 0

        if was == 1 then self.emit(MkEscape)
        elif was == 4 then self.emit(MkChar('\u{fffd}'))
    end pause

    next(*self) -> Option[MenuKey]
        val out = self.first

        self.first = self.second
        self.second = None
        out
    end next

    partial(self) -> bool = self.state != 0

    private emit(*self, k: MenuKey)
        if self.first.is_none() then self.first = Some(k) else self.second = Some(k)

    private ground(*self, b: u8)
        val lf_owed = self.owed_lf

        self.owed_lf = false

        if b == 27 then self.state = 1
        elif b == 13
            self.owed_lf = true
            self.emit(MkEnter)
        elif b == 10
            if !lf_owed then self.emit(MkEnter)
        elif b == 9 then self.emit(MkTab)
        elif b == 8 || b == 127 then self.emit(MkBackspace)
        elif b >= 1 && b <= 26 then self.emit(MkCtrl(char(uint(b) + 96)))
        elif b < 32 then ()
        elif b < 128 then self.emit(MkChar(char(uint(b))))
        elif b & 224 == 192 then self.lead(uint(b & 31), 1)
        elif b & 240 == 224 then self.lead(uint(b & 15), 2)
        elif b & 248 == 240 then self.lead(uint(b & 7), 3)
        else self.emit(MkChar('\u{fffd}'))
    end ground

    private lead(*self, cp: uint, more: int)
        self.cp = cp
        self.more = more
        self.state = 4

    private continuation(*self, b: u8)
        if b & 192 != 128
            self.state = 0
            self.emit(MkChar('\u{fffd}'))
            self.ground(b)
            return

        self.cp = (self.cp << 6) | uint(b & 63)
        self.more -= 1

        if self.more == 0
            self.state = 0
            self.emit(MkChar(char(self.cp)))
    end continuation

    private after_escape(*self, b: u8)
        if b == u8('[')
            self.state = 2
            self.param = 0
            self.params = 0
        elif b == u8('O')
            self.state = 3
        elif b == 27
            self.emit(MkEscape)
        else
            // Alt and a character is nothing the menu reads: Escape, then the key itself.
            self.state = 0
            self.emit(MkEscape)
            self.ground(b)
    end after_escape

    private csi(*self, b: u8)
        if b >= u8('0') && b <= u8('9')
            if self.params == 0 then self.param = self.param * 10 + int(b - u8('0'))
            return
        end if

        if b == u8(';')
            self.params += 1
            return
        end if

        if b < 64 || b > 126 then return

        self.state = 0
        self.final_key(b, self.param)
    end csi

    private final_key(*self, b: u8, n: int)
        if b == u8('A') then self.emit(MkUp)
        elif b == u8('B') then self.emit(MkDown)
        elif b == u8('C') then self.emit(MkRight)
        elif b == u8('D') then self.emit(MkLeft)
        elif b == u8('H') then self.emit(MkHome)
        elif b == u8('F') then self.emit(MkEnd)
        elif b == u8('~')
            if n == 1 || n == 7 then self.emit(MkHome)
            elif n == 4 || n == 8 then self.emit(MkEnd)
            elif n == 5 then self.emit(MkPageUp)
            elif n == 6 then self.emit(MkPageDown)
    end final_key
end MenuKeys

menu_keys() -> MenuKeys = MenuKeys(0, 0, 0, 0, 0, false, None, None)
