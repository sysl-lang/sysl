// p29: shortest form -- a call whose argument is a generic call taking a Fn1-bounded closure, the
// outer call taking a two-argument bare arrow.
struct W[F]
    f: F

wrap[G: Fn1[int, int]](g: G) -> W[G] = W(g)

use2[T](w: T, h: (int, int) -> int) -> int = h(1, 2)

main()
    print(use2(wrap(x -> x * 10), (a, b) -> a + b))
