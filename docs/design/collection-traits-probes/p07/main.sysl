// p07: an erased iterator, where the concrete chain is chosen at run time -- formed, returned, walked
// by `for`, and handed to a generic consumer bounded by the trait.
trait It
    type Item
    next(*self) -> Option[Self::Item]

    map[U, F: Fn1[Self::Item, U]](self, f: F) -> MapIt[Self, F, U] = MapIt(self, f)

struct Count
    n: int
    stop: int

impl It for Count
    type Item = int
    next(*self) -> Option[int]
        if self.n >= self.stop then return None
        val v = self.n
        self.n += 1
        Some(v)

struct MapIt[I, F, U]
    src: I
    f: F

impl[I: It, F: Fn1[I::Item, U], U] It for MapIt[I, F, U]
    type Item = U
    next(*self) -> Option[U]
        self.src.next() match
            Some(x) -> Some(self.f(x))
            None -> None

pick(doubled: bool) -> &It[int]
    if doubled then return Count(0, 3).map(x -> x * 2)
    Count(0, 3)

walk_obj(it: &It[int]) -> int
    var t = 0
    var cur = it
    loop
        cur.next() match
            Some(v) -> t += v
            None -> break
    t
end walk_obj

main()
    print(walk_obj(pick(false)), walk_obj(pick(true)))
