// A JSON reader and writer.
//
// The axis this owns is **recursive ownership** — a value that contains itself through `&T`. A
// JSON document is the smallest honest example of one: an array holds values, and a value may be
// an array, so the type cannot be written at all without an indirection, and every walk over it
// has to take the reference apart.
//
// Numbers are integers. That is a deliberate narrowing rather than a shortcut: a round-trip is
// the assertion this program is checked by, and a float would make the check about the renderer's
// digits instead of about the tree. Floats are another problem's axis.
//
// What writing it turned up, in the order it bit:
//
//   * **A pattern does not reach through a reference.** Selection does (`p.x` on a `&T`), so the
//     asymmetry is a thing to learn rather than to guess; every walk here starts `*j match`.
//   * **There was no way to build a `string` out of bytes a program computed.** The only sources of
//     one were a literal, a slice of an existing string, concatenation, and `str`, so unescaping was
//     written as "copy the source between the escapes, and append a literal for each" and `\uXXXX`
//     reached text only through `str(char(n))` — a *rendering* function standing in for a
//     constructor. Answered: `from_utf8` validates a `[]u8` into a `string`, so `parse_string`
//     gathers into one sink and converts once at the end, and an escape writes the bytes it encodes
//     to instead of being rendered into a string that is immediately concatenated away. The
//     structure that had been forced is now the structure that is wanted.
//   * **And then there was no way to ask what those bytes *were*.** The gap above was only half
//     closed: bytes could become text, and a `char` could not become bytes, so `\uXXXX` went out
//     through `display_char` — the *renderer*, called with a format specification for output nobody
//     was formatting, because it was the only encoder within reach. Answered: `encode_utf8` writes a
//     character into a caller's buffer, and `display_char` itself now calls it.
//   * **There were no constants** when this was written, so a value shared by several functions had
//     to be a nullary function. `const` was added afterwards, for a reason this program did not
//     turn up on its own: a nullary function reads perfectly well *in an expression*, and what it
//     cannot do is be an array bound. See `max_depth` below, which is now what it always meant.
//   * **There was no growable collection**, so an array and an object were each a linked list built
//     by appending through the tail reference — honest for a tree of references, and not what the
//     data is. Answered: `sysl.buf` has `Buf[T]`, so an array is a `&Buf[&Json]` and an object a
//     `&Buf[Field]`, appended with `push` and rendered by index. That deleted two list-cell structs,
//     both tail-threading loops, and the two recursive renderers.

import sysl.buf.{Buf, buf, byte_sink}
import sysl.text.from_utf8

enum Json
    Null
    Bool(b: bool)
    Num(n: long)
    Str(s: string)
    Arr(items: &Buf[&Json])
    Obj(fields: &Buf[Field])
end Json

// One member of an object. `Json` reaches itself from here through the `&` on the value, which is
// the edge that makes the cycle finite.
struct Field
    key: string
    value: &Json

// ---------------------------------------------------------------------------- what can go wrong

enum Fault
    Expected(at: usize, what: string)
    BadEscape(at: usize)
    BadNumber(at: usize)
    TooDeep(at: usize)
    Trailing(at: usize)
    Unterminated(at: usize)
end Fault

describe(f: Fault) -> string
    f match
        Expected(at, what) -> s"$what expected at $at"
        BadEscape(at) -> s"bad escape at $at"
        BadNumber(at) -> s"bad number at $at"
        TooDeep(at) -> s"nested too deeply at $at"
        Trailing(at) -> s"trailing input at $at"
        Unterminated(at) -> s"unterminated string at $at"
end describe

// ------------------------------------------------------------------------------------- reading

parse(text: string) -> Result[&Json, Fault]
    var r = Scanner(text, text.bytes, 0)
    var v = r.parse_value(0)?

    r.skip_ws()
    if !r.done() then return Err(Trailing(r.at))
    Ok(v)
end parse

// How deep a document may nest before the scanner gives up.
private const max_depth: int = 64

// A character written to a sink as the bytes it encodes to, which is the whole of what a `\uXXXX`
// escape means. Four bytes is the most any character needs, so the buffer is a local array and the
// encoding costs no allocation.
private put_char(out: *Writer, c: char)
    var b: [4]u8

    out.write(b[0..<encode_utf8(c, b[0..<4])])

// The scanner is a position in a source text, and both spellings of the text are kept: the bytes to
// decide by, and the `string` to cut pieces out of. Nothing here can turn the one back into the
// other, which is why both are carried. It scans a text that is already in hand, which is what makes
// it a different thing from `sysl.io`'s `Reader` — bytes arriving from somewhere else.
private struct Scanner
    text: string
    src: []const u8
    at: usize

    done(*self) -> bool = self.at >= self.src.len

    bump(*self)
        self.at += 1

    at_byte(*self, b: u8) -> bool = !self.done() && self.src[self.at] == b

    skip_ws(*self)
        while !self.done()
            var c = self.src[self.at]

            if c == 32 || c == 9 || c == 10 || c == 13 then self.bump()
            else break
    end skip_ws

    parse_value(*self, depth: int) -> Result[&Json, Fault]
        if depth > max_depth then return Err(TooDeep(self.at))
        self.skip_ws()
        if self.done() then return Err(Expected(self.at, "a value"))

        var c = self.src[self.at]

        char(c) match
            '{' -> self.parse_object(depth)
            '[' -> self.parse_array(depth)
            '"' ->
                var s = self.parse_string()?
                Ok(Str(s))
            't' -> self.parse_word("true", Bool(true))
            'f' -> self.parse_word("false", Bool(false))
            'n' -> self.parse_word("null", Null)
            else
                if c == u8('-') || digit(c) then self.parse_number()
                else Err(Expected(self.at, "a value"))
    end parse_value

    parse_word(*self, word: string, v: Json) -> Result[&Json, Fault]
        var stop = self.at + word.len

        if stop > self.src.len || self.text[self.at..<stop] != word then
            return Err(Expected(self.at, s"'$word'"))
        self.at = stop
        Ok(v)
    end parse_word

    parse_number(*self) -> Result[&Json, Fault]
        var start = self.at

        if self.at_byte(u8('-')) then self.bump()
        if self.done() || !digit(self.src[self.at]) then return Err(BadNumber(start))

        // A leading zero is a number of its own in JSON, so `01` is two of them where one was
        // expected rather than the eleventh integer.
        var leading = self.src[self.at] == u8('0')
        var n: long = 0
        var digits = 0

        while !self.done() && digit(self.src[self.at])
            n = n * 10 + long(int(self.src[self.at]) - 48)
            digits += 1
            if digits > 18 then return Err(BadNumber(start))
            self.bump()

        if leading && digits > 1 then return Err(BadNumber(start))

        // A fraction or an exponent is well-formed JSON that this scanner does not keep, so it is
        // refused outright rather than silently truncated.
        if !self.done()
            var c = char(self.src[self.at])

            if c == '.' || c == 'e' || c == 'E' then return Err(BadNumber(start))

        Ok(Num(if self.src[start] == u8('-') then -n else n))
    end parse_number

    // Bytes are gathered into one sink and validated once at the end. The runs between escapes are
    // copied out of the source as slices and the escapes write their own bytes into the same place,
    // so a string with fifty escapes in it allocates for its buffer's growth and not once per piece.
    parse_string(*self) -> Result[string, Fault]
        var opened = self.at

        self.bump()
        var out = byte_sink()
        var start = self.at

        loop
            if self.done() then return Err(Unterminated(opened))
            var c = self.src[self.at]

            if c == u8('"')
                out.write(self.src[start..<self.at])
                self.bump()
                break
            else if c == u8('\\')
                out.write(self.src[start..<self.at])
                self.bump()
                self.unescape(&out)?
                start = self.at
            else if c < 32
                return Err(Expected(self.at, "a character"))
            else
                self.bump()

        // The bytes are well-formed by construction — every run came out of a `string`, and every
        // escape wrote one encoded scalar value — so this walk can only agree. It is here anyway:
        // the alternative is `from_utf8_unchecked`, and a parser is the last place to spend a
        // guarantee on an argument about where its input came from.
        Ok(from_utf8(out.text()).unwrap())
    end parse_string

    unescape(*self, out: *Writer) -> Result[unit, Fault]
        if self.done() then return Err(BadEscape(self.at))
        var c = char(self.src[self.at])

        self.bump()
        c match
            '"' -> Ok(out.write("\"".bytes))
            '\\' -> Ok(out.write("\\".bytes))
            '/' -> Ok(out.write("/".bytes))
            'b' -> Ok(out.write("\b".bytes))
            'f' -> Ok(out.write("\f".bytes))
            'n' -> Ok(out.write("\n".bytes))
            'r' -> Ok(out.write("\r".bytes))
            't' -> Ok(out.write("\t".bytes))
            'u' -> self.unescape_hex(out)
            else Err(BadEscape(self.at - 1))
    end unescape

    // A code point reaches the output as the bytes it encodes to, which is what an escape always
    // meant, and `encode_utf8` is now the one function that says what those bytes are.
    //
    // It has been written three ways as the library caught up. First `str(char(n))` — a *rendering*
    // function standing in for a constructor, because no way to make bytes into text existed at all.
    // Then `display_char(c, out, plain())`, which was the only encoder within reach, and still a
    // renderer being asked a question about encoding: the `plain()` in that call is a format
    // specification for output nobody is formatting.
    unescape_hex(*self, out: *Writer) -> Result[unit, Fault]
        var hi = self.hex4()?

        if hi < 0xD800 || hi > 0xDFFF then return Ok(put_char(out, char(hi)))
        if hi > 0xDBFF then return Err(BadEscape(self.at))
        if !self.at_byte(u8('\\')) then return Err(BadEscape(self.at))
        self.bump()
        if !self.at_byte(u8('u')) then return Err(BadEscape(self.at))
        self.bump()

        var lo = self.hex4()?

        if lo < 0xDC00 || lo > 0xDFFF then return Err(BadEscape(self.at))
        Ok(put_char(out, char(0x10000 + (hi - 0xD800) * 0x400 + (lo - 0xDC00))))
    end unescape_hex

    hex4(*self) -> Result[int, Fault]
        var n = 0

        for k in 0..<4
            if self.done() then return Err(BadEscape(self.at))
            var d = hex_digit(self.src[self.at])

            if d < 0 then return Err(BadEscape(self.at))
            n = n * 16 + d
            self.bump()

        Ok(n)
    end hex4

    parse_array(*self, depth: int) -> Result[&Json, Fault]
        self.bump()
        self.skip_ws()

        var items: &Buf[&Json] = buf()

        if self.at_byte(u8(']'))
            self.bump()
            return Ok(Arr(items))

        loop
            items.push(self.parse_value(depth + 1)?)
            self.skip_ws()

            if self.at_byte(u8(',')) then self.bump()
            else if self.at_byte(u8(']'))
                self.bump()
                break
            else return Err(Expected(self.at, "',' or ']'"))

        Ok(Arr(items))
    end parse_array

    parse_object(*self, depth: int) -> Result[&Json, Fault]
        self.bump()
        self.skip_ws()
        var fields: &Buf[Field] = buf()

        if self.at_byte(u8('}'))
            self.bump()
            return Ok(Obj(fields))

        loop
            self.skip_ws()
            if !self.at_byte(u8('"')) then return Err(Expected(self.at, "a key"))
            var key = self.parse_string()?

            self.skip_ws()
            if !self.at_byte(u8(':')) then return Err(Expected(self.at, "':'"))
            self.bump()

            fields.push(Field(key, self.parse_value(depth + 1)?))
            self.skip_ws()
            if self.at_byte(u8(',')) then self.bump()
            else if self.at_byte(u8('}'))
                self.bump()
                break
            else return Err(Expected(self.at, "',' or '}'"))

        Ok(Obj(fields))
    end parse_object
end Scanner

private digit(b: u8) -> bool = b >= u8('0') && b <= u8('9')

private hex_digit(b: u8) -> int
    if digit(b) then int(b) - 48
    else if b >= u8('a') && b <= u8('f') then int(b) - 87
    else if b >= u8('A') && b <= u8('F') then int(b) - 55
    else -1

// ------------------------------------------------------------------------------------- writing

render(j: &Json) -> string
    *j match
        Null -> "null"
        Bool(b) -> if b then "true" else "false"
        Num(n) -> str(n)
        Str(s) -> quote(s)
        Arr(items) -> "[" + render_items(items) + "]"
        Obj(fields) -> "{" + render_fields(fields) + "}"
end render

private render_items(items: &Buf[&Json]) -> string
    var s = ""

    for i in 0..<items.len()
        if i > 0 then s += ","

        s += render(items[i])

    s
end render_items

private render_fields(fields: &Buf[Field]) -> string
    var s = ""

    for i in 0..<fields.len()
        if i > 0 then s += ","

        var f = fields[i]

        s += quote(f.key) + ":" + render(f.value)

    s
end render_fields

// The mirror of `parse_string`: the source is copied between the bytes that need replacing, since
// the bytes that do not need replacing cannot be appended one at a time.
private quote(s: string) -> string
    var out = "\""
    var bs = s.bytes
    var start: usize = 0

    for i in 0..<bs.len
        var rep = escape_of(bs[i])

        if rep != ""
            out += s[start..<i]
            out += rep
            start = i + 1

    out += s[start..]
    out + "\""
end quote

private escape_of(b: u8) -> string
    if b == u8('"') then "\\\""
    else if b == u8('\\') then "\\\\"
    else if b == u8('\b') then "\\b"
    else if b == u8('\f') then "\\f"
    else if b == u8('\n') then "\\n"
    else if b == u8('\r') then "\\r"
    else if b == u8('\t') then "\\t"
    else if b < 32 then "\\u00" + hex_of(b >> 4) + hex_of(b & 15)
    else ""
end escape_of

// Indexing a string yields a **byte**, so the character has to be asked for: `str` of the byte
// renders the number it is, which is a wrong answer that looks like a right one.
private hex_of(n: u8) -> string = str(char("0123456789abcdef"[usize(n)]))
