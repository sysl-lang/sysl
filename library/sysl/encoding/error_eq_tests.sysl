module sysl.encoding
@tests

@test("eqe: DecodeError is equal variant by variant and payload by payload")
eqe_decode_error()
    assert(DecodeError.BadLength == DecodeError.BadLength)
    assert(DecodeError.BadLength != DecodeError.BadByte(0))
    assert(DecodeError.BadByte(1) == DecodeError.BadByte(1))
    assert(DecodeError.BadByte(1) != DecodeError.BadByte(2))
    assert(DecodeError.BadPadding(1) == DecodeError.BadPadding(1))
    assert(DecodeError.BadPadding(1) != DecodeError.BadPadding(2))
    assert(DecodeError.BadPadding(1) != DecodeError.BadByte(1))
    assert(DecodeError.Short(4) == DecodeError.Short(4))
    assert(DecodeError.Short(4) != DecodeError.Short(5))
    assert(DecodeError.Utf8(4) == DecodeError.Utf8(4))
    assert(DecodeError.Utf8(4) != DecodeError.Utf8(5))
    assert(DecodeError.Utf8(4) != DecodeError.Short(4))

@test("eqe: Result and Option[Result] over DecodeError compare with ==")
eqe_decode_result()
    val r: Result[int, DecodeError] = Err(DecodeError.Short(3))
    assert(r == Err(DecodeError.Short(3)))
    assert(r != Err(DecodeError.Short(4)))
    assert(r != Ok(3))
    val o: Option[Result[int, DecodeError]] = Some(r)
    assert(o == Some(Err(DecodeError.Short(3))))
    assert(o != Some(Err(DecodeError.BadLength)))
    assert(o != None)
