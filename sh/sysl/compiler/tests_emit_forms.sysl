                  "\n" +
                  "rotl(x: u32, n: u32) -> u32 = x.rotate_left(n)\n" +
                  "\n" +
                  "rotr(x: u32) -> u32 = x.rotate_right(3)\n" +
                  "\n" +
                  "main() = print(pop(5) + lead(5) + trail1(5) + rev(5) + rotl(5, 2) + rotr(5) + u32(mag(-1) + sgn(-1)))\n",
              "rotr"),
              "define i32 @rotr(i32 %x.param) {\n" +
              "entry:\n" +
              "  %x.addr = alloca i32\n" +
              "  store i32 %x.param, ptr %x.addr\n" +
              "  %t1 = load i32, ptr %x.addr\n" +
              "  %t2 = call i32 @llvm.fshr.i32(i32 %t1, i32 %t1, i32 3)\n" +
              "  ret i32 %t2\n" +
              "}\n")
end a_rotation_by_a_literal_is_the_instruction_behind_it

// A body with the number off each interned string it names, and everything else left alone.
private without_form_str_ids(text: string) -> string
    var out: Buf[u8] = buf()
    val bytes = text.bytes
    var i: usize = 0

    while i < bytes.len
        if form_starts_at(bytes, i, "@.str")
            out.extend("@.str".bytes)

            i += 5

            while i < bytes.len && bytes[i] >= u8('0') && bytes[i] <= u8('9')
                i += 1
        else
            out.push(bytes[i])

            i += 1

    from_utf8_unchecked(out.view())
end without_form_str_ids

private form_starts_at(bytes: []const u8, at: usize, what: string) -> bool
    if at + what.bytes.len > bytes.len then return false

    for k in 0..<what.bytes.len
        if bytes[at + k] != what.bytes[k] then return false

    true
end form_starts_at
