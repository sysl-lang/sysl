module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.math.bigint.{BigInt, add, cmp, from_int, mul, negate, pow, sub}

// Arithmetic, comparison, and the conversions between scalar widths.
//
// Two things run through all of it. The first is that a **constrained** type is laid out as its base
// and computes as its base -- the subtype names a set of values, not a second way to add -- so
// `a += e` and `a = a + e` reach the same instruction by different routes and must agree about it.
//
// The second is that overflow checking is **opt-in and narrow**. Arithmetic on raw integers is
// defined to wrap, so the checked form is in play only when an operand came through a ranged
// (`within`) type, and only then when the exact interval the operands allow can fall outside the
// base width.

// The names LLVM reserves that a scalar lowering writes down.
llvm_trap() -> string = "llvm.trap"

// The overflow-detecting form of one operator, at one width. The width is in the **name** as well as
// the signature, so naming the wrong overload is a call to a function that does not exist.
llvm_with_overflow(op: string, signed: bool, ty: LType) -> string =
    s"llvm.${if signed then "s" else "u"}$op.with.overflow.${overload_of(ty)}"

private overload_of(t: LType) -> string = l_overload_suffix(t) match
    Some(s) -> s
    None -> l_render(t)

// -- stopping the program ------------------------------------------------------------------------

// Traps unless `ok` holds. The stop has no message: what the check was is in the source line, which
// is more than anything emitted here could say.
trap_unless(e: *Emit, ok: Val, what: string)
    e.traps = true

    val ok_l = fresh_label(e, s"$what.ok")
    val bad_l = fresh_label(e, s"$what.bad")

    emit_term(e, InCondBr(ok, ok_l, bad_l))
    emit_label(e, bad_l)
    emit(e, ir_call(None, LVoid, VGlobal(llvm_trap()), no_ir_args()))
    emit_term(e, InUnreachable)
    emit_label(e, ok_l)
end trap_unless

// -- what an operator becomes ---------------------------------------------------------------------

// One binary operation over two values the caller is holding.
//
// A **vector** picks its instruction from the lane and emits at the whole register: LLVM spells both
// widths of the word with one mnemonic, so lane-wise arithmetic needs no operation of its own, only
// the type it is written at.
arith(e: *Emit, op: string, ty: Type, lv: Val, rv: Val) -> Val
    val lane = underlying(ty) match
        Vector(_, elem) -> underlying(*elem)
        other -> other

    val ety = lty(e, ty)

    val instr = lane match
        Integer(_, signed, _) -> int_instr(e, op, signed)
        Char -> int_instr(e, op, false)
        Bool -> op match
            "&" -> OpAnd
            "|" -> OpOr
            "^" -> OpXor
            _ ->
                gap_here(e, s"mask arith '$op'")
                OpAnd
        Floating(_) -> op match
            "+" -> OpFAdd
            "-" -> OpFSub
            "*" -> OpFMul
            "/" -> OpFDiv
            _ ->
                gap_here(e, s"float arith '$op'")
                OpFAdd
        other ->
            gap_here(e, s"arith on ${type_show(other)}")
            OpAdd

    // Integer division and remainder have two inputs LLVM leaves undefined and would miscompile: a
    // zero divisor always, and -- for signed operands -- the minimum by -1, whose true quotient
    // overflows the width. A zero divisor traps; signed `/` traps on that overflow; signed `%`
    // returns its defined zero by dividing by 1 in the one case -1 would leave undefined.
    var divisor = rv

    underlying(ty) match
        Integer(bits, signed, _) ->
            if op == "/" || op == "%"
                val nz = fresh_reg(e)

                emit(e, InIntCmp(nz, INe, ety, rv, VInt(from_int(0))))
                trap_unless(e, nz, "div")

                if signed
                    val neg1 = fresh_reg(e)

                    emit(e, InIntCmp(neg1, IEq, ety, rv, VInt(from_int(-1))))

                    if op == "/"
                        val min = negate(pow(from_int(2), usize(bits - 1)))
                        val is_min = fresh_reg(e)

                        emit(e, InIntCmp(is_min, IEq, ety, lv, VInt(min)))

                        val ovf = fresh_reg(e)

                        emit(e, InBin(ovf, OpAnd, l_i1(), is_min, neg1))

                        val ok = fresh_reg(e)

                        emit(e, InBin(ok, OpXor, l_i1(), ovf, VBool(true)))
                        trap_unless(e, ok, "overflow")
                    else
                        val safe = fresh_reg(e)

                        emit(e, InSelect(safe, neg1, ety, VInt(from_int(1)), rv, l_i1()))
                        divisor = safe
        _ -> ()

    // A shift amount at or past the operand's width is undefined on every machine instruction this
    // lowers to, and LLVM propagates that as poison rather than as a number.
    lane match
        Integer(bits, _, _) ->
            if op == "<<" || op == ">>" then return bounded_shift(e, ty, bits, instr, lv, divisor)
        _ -> ()

    val r = fresh_reg(e)

    emit(e, InBin(r, instr, ety, lv, divisor))
    r
end arith

private int_instr(e: *Emit, op: string, signed: bool) -> BinOp = op match
    "+" -> OpAdd
    "-" -> OpSub
    "*" -> OpMul
    "/" -> if signed then OpSDiv else OpUDiv
    "%" -> if signed then OpSRem else OpURem
    "<<" -> OpShl
    ">>" -> if signed then OpAShr else OpLShr
    "&" -> OpAnd
    "|" -> OpOr
    "^" -> OpXor
    _ ->
        gap_here(e, s"arith '$op'")
        OpAdd

// A shift whose amount may be anything, lowered so that every amount means something.
//
// **Shifting a value by its own width or more answers what shifting it all the way answers**: zero
// for `<<` and for an unsigned `>>`, and the sign for a signed one. The amount is clamped rather
// than the shift being emitted and thrown away, so no poison is built at all.
bounded_shift(e: *Emit, ty: Type, bits: int, instr: BinOp, lv: Val, amt: Val) -> Val
    val ety = lty(e, ty)

    val cond_ty = underlying(ty) match
        Vector(n, _) -> LVec(n, l_i1())
        _ -> l_i1()

    val width = constant_at(e, ty, from_int(long(bits)))
    val highest = constant_at(e, ty, from_int(long(bits - 1)))

    val too_big = fresh_reg(e)

    emit(e, InIntCmp(too_big, IUge, ety, amt, width))

    val safe = fresh_reg(e)

    emit(e, InSelect(safe, too_big, ety, highest, amt, cond_ty))

    val r = fresh_reg(e)

    emit(e, InBin(r, instr, ety, lv, safe))

    // An arithmetic right shift by `width - 1` is already every bit of the sign, so the clamp alone
    // is the whole of the signed case. The other two have to say zero.
    if instr == OpAShr then return r

    val out = fresh_reg(e)

    emit(e, InSelect(out, too_big, ety, VZero, r, cond_ty))
    out
end bounded_shift

// An integer constant at a type, splat across the lanes where that type is a vector.
constant_at(e: *Emit, ty: Type, value: BigInt) -> Val = underlying(ty) match
    Vector(n, elem) ->
        val vty = lty(e, ty)
        val one = fresh_reg(e)

        emit(e, InInsertElement(one, vty, VPoison, lty(e, underlying(*elem)), VInt(value),
                                ir_arg(l_i32(), VInt(from_int(0)))))

        val r = fresh_reg(e)

        emit(e, InShuffle(r, vty, one, VPoison, ir_arg(LVec(n, l_i32()), VZero)))
        r
    _ -> VInt(value)

// A shift's count, brought to the shifted value's own width. A **narrower** count is extended; a
// **wider** one is clamped at the shifted width *before* it is truncated, since truncating first
// would turn a count of 256 into a count of 0.
shift_amount(e: *Emit, ty: Type, amt_ty: Type, amt: Val) -> Val = (underlying(ty), underlying(amt_ty)) match
    (Integer(to_bits, to_signed, _), Integer(from_bits, from_signed, _)) ->
        if to_bits == from_bits then amt
        else if from_bits < to_bits then
            convert_int(e, from_bits, from_signed, to_bits, amt)
        else
            val fty = LInt(from_bits)
            val width = VInt(from_int(long(to_bits)))
            val too_big = fresh_reg(e)

            emit(e, InIntCmp(too_big, IUge, fty, amt, width))

            val safe = fresh_reg(e)

            emit(e, InSelect(safe, too_big, fty, width, amt, l_i1()))
            convert_int(e, from_bits, from_signed, to_bits, safe)
    _ -> amt

// Which cast one integer width to another is: a narrowing truncates, and a widening extends by
// whatever the source's own signedness says.
private width_cast(from_bits: int, from_signed: bool, to_bits: int) -> CastOp
    if to_bits < from_bits then return CastTrunc
    if from_signed then return CastSExt

    CastZExt
end width_cast

// One integer width brought to another, sign-extending where the source says so.
convert_int(e: *Emit, from_bits: int, from_signed: bool, to_bits: int, v: Val) -> Val
    if from_bits == to_bits then return v

    val r = fresh_reg(e)
    val op = width_cast(from_bits, from_signed, to_bits)

    emit(e, InCast(r, op, LInt(from_bits), v, LInt(to_bits)))
    r
end convert_int

// -- comparison ------------------------------------------------------------------------------------

// The `icmp` predicate for an operator at a type. `char` compares by scalar value, so it uses the
// unsigned predicates over its `i32` representation.
int_pred(e: *Emit, op: string, ty: Type) -> ICmp = ty match
    Bool -> eq_pred(e, op)
    Ptr(_) -> eq_pred(e, op)
    Ref(_, _) -> eq_pred(e, op)
    CFn(_, _) -> eq_pred(e, op)
    Char -> unsigned_pred(e, op)
    Integer(_, false, _) -> unsigned_pred(e, op)
    Integer(_, true, _) -> signed_pred(e, op)
    other ->
        gap_here(e, s"compare on ${type_show(other)}")
        IEq

private eq_pred(e: *Emit, op: string) -> ICmp = op match
    "==" -> IEq
    "!=" -> INe
    _ ->
        gap_here(e, s"compare '$op'")
        IEq

private unsigned_pred(e: *Emit, op: string) -> ICmp = op match
    "==" -> IEq
    "!=" -> INe
    "<" -> IUlt
    ">" -> IUgt
    "<=" -> IUle
    ">=" -> IUge
    _ ->
        gap_here(e, s"compare '$op'")
        IEq

private signed_pred(e: *Emit, op: string) -> ICmp = op match
    "==" -> IEq
    "!=" -> INe
    "<" -> ISlt
    ">" -> ISgt
    "<=" -> ISle
    ">=" -> ISge
    _ ->
        gap_here(e, s"compare '$op'")
        IEq

// The `fcmp` predicate. IEEE 754 makes `!=` the negation of `==`, and a `NaN` is equal to nothing
// including itself -- so `!=` is **unordered** or not equal, not ordered and not equal.
float_pred(e: *Emit, op: string) -> FCmp = op match
    "==" -> FOeq
    "!=" -> FUne
    "<" -> FOlt
    ">" -> FOgt
    "<=" -> FOle
    ">=" -> FOge
    _ ->
        gap_here(e, s"compare '$op'")
        FOeq

// One comparison over two values the caller is holding.
//
// A constrained subtype is laid out as the type it narrows, so it is compared as that one; a
// **simple** enum is its discriminant, and equality on it is that integer's compare.
compare_value(e: *Emit, op: string, base: Type, av: Val, bv: Val) -> Val
    val ty = underlying(base) match
        Enum(d) -> if d.simple then d.underlying else Enum(d)
        other -> other

    // Two strings are ordered by their bytes, which is a call rather than an instruction; every
    // operator then reads the same -1 / 0 / 1 the way it would read a subtraction.
    if ty == Str
        val c = str_cmp(e, av, bv)
        val ordered = fresh_reg(e)

        emit(e, InIntCmp(ordered, int_pred(e, op, int_type()), l_i32(), c, VInt(from_int(0))))
        return ordered
    end if

    val r = fresh_reg(e)

    ty match
        Floating(_) -> emit(e, InFloatCmp(r, float_pred(e, op), lty(e, ty), av, bv))
        Vector(_, _) -> gap_here(e, "vector comparison")
        _ -> emit(e, InIntCmp(r, int_pred(e, op, ty), lty(e, ty), av, bv))

    r
end compare_value

// -- the checked forms -------------------------------------------------------------------------------

// A ranged constrained integer -- a `within` type -- is the opt-in that makes arithmetic checked; a
// predicate-only subtype or a bare `new` derivation bounds no magnitude and does not qualify.
is_ranged(t: Type) -> bool = t match
    Constrained(d) ->
        if d.lo.is_none() && d.hi.is_none() then false
        else underlying(t) match
            Integer(_, _, _) -> true
            _ -> false
    _ -> false

// Whether an integer `+`/`-`/`*` needs the overflow-detecting form.
overflow_checked(op: string, l: TExpr, r: TExpr, bits: int, signed: bool) -> bool
    if op != "+" && op != "-" && op != "*" then return false
    if !is_ranged(texpr_type(l)) && !is_ranged(texpr_type(r)) then return false

    val a = interval(l, bits, signed)
    val b = interval(r, bits, signed)

    val bounds = op match
        "+" -> (add(a.0, b.0), add(a.1, b.1))
        "-" -> (sub(a.0, b.1), sub(a.1, b.0))
        _ ->
            val c1 = mul(a.0, b.0)
            val c2 = mul(a.0, b.1)
            val c3 = mul(a.1, b.0)
            val c4 = mul(a.1, b.1)

            (least(least(c1, c2), least(c3, c4)), most(most(c1, c2), most(c3, c4)))

    cmp(bounds.0, base_min(bits, signed)) < 0 || cmp(bounds.1, base_max(bits, signed)) > 0
end overflow_checked

private least(a: BigInt, b: BigInt) -> BigInt = if cmp(a, b) <= 0 then a else b
private most(a: BigInt, b: BigInt) -> BigInt = if cmp(a, b) >= 0 then a else b

// The exact value interval an operand can hold: a literal is its own value; a ranged type is its
// declared bounds (`..<` excludes the top); anything else spans the whole base width.
private interval(x: TExpr, bits: int, signed: bool) -> (BigInt, BigInt) = *x.kind match
    TIntLit(v, _) -> (v, v)
    _ -> texpr_type(x) match
        Constrained(d) ->
            if !is_ranged(texpr_type(x)) then (base_min(bits, signed), base_max(bits, signed))
            else
                val lo = d.lo match
                    Some(v) -> decimal_int(v)
                    None -> base_min(bits, signed)

                val hi = d.hi match
                    Some(v) ->
                        val n = decimal_int(v)

                        if d.exclusive_hi then sub(n, from_int(1)) else n
                    None -> base_max(bits, signed)

                (lo, hi)
        _ -> (base_min(bits, signed), base_max(bits, signed))

base_min(bits: int, signed: bool) -> BigInt =
    if signed then negate(pow(from_int(2), usize(bits - 1))) else from_int(0)

base_max(bits: int, signed: bool) -> BigInt =
    if signed then sub(pow(from_int(2), usize(bits - 1)), from_int(1))
    else sub(pow(from_int(2), usize(bits)), from_int(1))

// Integer `+`, `-`, `*` where the operands' declared ranges allow a result the base width cannot
// hold, so a plain instruction would wrap before the range check at the produce site could see it.
checked_arith(e: *Emit, op: string, bits: int, signed: bool, lv: Val, rv: Val) -> Val
    val name = op match
        "+" -> "add"
        "-" -> "sub"
        _ -> "mul"

    val ity = LInt(bits)
    val fn = llvm_with_overflow(name, signed, ity)

    var pair_fields: Buf[LType] = buf()

    pair_fields.push(ity)
    pair_fields.push(l_i1())

    val both = LStruct(pair_fields)

    var params: Buf[IrParam] = buf()

    params.push(ir_param(ity))
    params.push(ir_param(ity))
    request_intrinsic(e, ir_sig(fn, ir_fn_type(both, params)))

    var args: Buf[IrArg] = buf()

    args.push(ir_arg(ity, lv))
    args.push(ir_arg(ity, rv))

    val pair = fresh_reg(e)

    emit(e, ir_call(Some(pair), both, VGlobal(fn), args))

    val v = fresh_reg(e)

    emit(e, InExtract(v, both, pair, one_index(0)))

    val ovf = fresh_reg(e)

    emit(e, InExtract(ovf, both, pair, one_index(1)))

    val ok = fresh_reg(e)

    emit(e, InBin(ok, OpXor, l_i1(), ovf, VBool(true)))
    trap_unless(e, ok, "overflow")
    v
end checked_arith

private one_index(n: int) -> Buf[int]
    var out: Buf[int] = buf()

    out.push(n)
    out
end one_index

// A left shift of a value produced through a ranged type. There is no overflow intrinsic for a
// shift, so the check is direct: the amount must be below the width, and shifting the result back
// must recover the value, since a bit pushed out of the top is exactly the overflow.
checked_shl(e: *Emit, bits: int, signed: bool, lv: Val, sh: Val) -> Val
    val ity = LInt(bits)
    val amt_ok = fresh_reg(e)

    emit(e, InIntCmp(amt_ok, IUlt, ity, sh, VInt(from_int(long(bits)))))
    trap_unless(e, amt_ok, "overflow")

    val r = fresh_reg(e)

    emit(e, InBin(r, OpShl, ity, lv, sh))

    val back = fresh_reg(e)

    emit(e, InBin(back, if signed then OpAShr else OpLShr, ity, r, sh))

    val ok = fresh_reg(e)

    emit(e, InIntCmp(ok, IEq, ity, back, lv))
    trap_unless(e, ok, "overflow")
    r
end checked_shl

// Declares an intrinsic once, under the overload-mangled name that carries its width.
request_intrinsic(e: *Emit, sig: IrFuncSig)
    for i in 0..<e.sat_decls.len()
        if e.sat_decls.at(i).name == sig.name then return

    e.sat_decls.push(sig)
end request_intrinsic

// -- the bit operations ------------------------------------------------------------------------------

// One of `sysl.math`'s `Bits` members, lowered to the instruction behind it.
//
// **These are the compiler's own reach for an instruction rather than the library's.** `Bits`'
// membership covers an open family of widths, so there was never a finite set of `extern`s that
// could have declared them -- LLVM overloads on the operand type and spells the choice in the name,
// which is why the name carries the width here.
gen_int_op(e: *Emit, op: string, operand: TExpr, amount: Option[TExpr], width: Type,
           ty: Type) -> Val
    val v = gen_expr(e, operand)
    val n = amount match
        Some(a) -> Some(gen_expr(e, a))
        None -> None

    val bits = int_bits_of(width)
    val ll = lty(e, width)

    op match
        // `x < 0 ? -x : x`, and the negation is the wrapping one the language's own `-` is -- so at
        // the most negative value both answer that value, rather than the member disagreeing with
        // the operator beside it.
        "abs" ->
            val neg = fresh_reg(e)

            emit(e, InBin(neg, OpSub, ll, VInt(from_int(0)), v))

            val lt = fresh_reg(e)

            emit(e, InIntCmp(lt, ISlt, ll, v, VInt(from_int(0))))

            val r = fresh_reg(e)

            emit(e, InSelect(r, lt, ll, neg, v, l_i1()))
            r

        // Two comparisons rather than a subtraction of them, because `(x > 0) - (x < 0)` would have
        // to widen both booleans to the operand's width first and says less about what it computes.
        "signum" ->
            val pos = fresh_reg(e)

            emit(e, InIntCmp(pos, ISgt, ll, v, VInt(from_int(0))))

            val neg = fresh_reg(e)

            emit(e, InIntCmp(neg, ISlt, ll, v, VInt(from_int(0))))

            val hi = fresh_reg(e)

            emit(e, InSelect(hi, pos, ll, VInt(from_int(1)), VInt(from_int(0)), l_i1()))

            val r = fresh_reg(e)

            emit(e, InSelect(r, neg, ll, VInt(from_int(-1)), hi, l_i1()))
            r

        "count_ones" -> counted_bits(e, "ctpop", ll, v, false, width, ty)
        "count_zeros" -> counted_bits(e, "ctpop", ll, complement_of(e, ll, v), false, width, ty)

        // The `i1` the two counting intrinsics take says whether a zero operand is **poison**.
        // `false` is what makes zero answer the width instead, which is the answer the trait
        // documents and the only one that is the same number on every target.
        "leading_zeros" -> counted_bits(e, "ctlz", ll, v, true, width, ty)
        "trailing_zeros" -> counted_bits(e, "cttz", ll, v, true, width, ty)
        "leading_ones" -> counted_bits(e, "ctlz", ll, complement_of(e, ll, v), true, width, ty)
        "trailing_ones" -> counted_bits(e, "cttz", ll, complement_of(e, ll, v), true, width, ty)

        "reverse_bits" -> bit_intrinsic(e, "bitreverse", ll, one_value(v), false)

        // A rotation is a funnel shift of the value with itself, which is how LLVM spells one: the
        // two halves are the same register, so the bits leaving the top arrive at the bottom.
        "rotate_left" ->
            bit_intrinsic(e, "fshl", ll,
                          rotation_args(v, rotate_by(e, n.unwrap_or(VZero), amount_type(amount),
                                                     bits)), false)
        "rotate_right" ->
            bit_intrinsic(e, "fshr", ll,
                          rotation_args(v, rotate_by(e, n.unwrap_or(VZero), amount_type(amount),
                                                     bits)), false)

        _ -> gap_at(e, s"the integer operation '$op'")
end gen_int_op

// The bits counted at the operand's own width, then resized to the `u32` the count is answered in. A
// count is at most the width, so narrowing one from a type wider than 32 bits cannot lose anything.
private counted_bits(e: *Emit, base: string, ll: LType, of: Val, zero_flag: bool, width: Type,
                     ty: Type) -> Val =
    resize_int(e, bit_intrinsic(e, base, ll, one_value(of), zero_flag), width, ty)

// `~x`, which is what turns a count of zeroes into a count of ones. The trait has both pairs because
// the complement is the caller's to get wrong, not because the machine has four instructions.
private complement_of(e: *Emit, ll: LType, v: Val) -> Val
    val r = fresh_reg(e)

    emit(e, InBin(r, OpXor, ll, v, VInt(from_int(-1))))
    r
end complement_of

private one_value(v: Val) -> Buf[Val]
    var out: Buf[Val] = buf()

    out.push(v)
    out
end one_value

private rotation_args(v: Val, by: Val) -> Buf[Val]
    var out: Buf[Val] = buf()

    out.push(v)
    out.push(v)
    out.push(by)
    out
end rotation_args

private amount_type(amount: Option[TExpr]) -> Type = amount match
    Some(a) -> texpr_type(a)
    None -> Integer(32, false, false)

// One bit intrinsic, declared under the overload-mangled name that carries its width, and called.
//
// `zero_flag` is the extra `i1` that `ctlz` and `cttz` take and no other intrinsic here does. It is
// always `false`, meaning a zero operand is defined rather than poison.
private bit_intrinsic(e: *Emit, base: string, ll: LType, args: Buf[Val], zero_flag: bool) -> Val
    val name = s"llvm.$base.${overload_of(ll)}"

    var params: Buf[IrParam] = buf()

    for i in 0..<args.len()
        params.push(ir_param(ll))

    if zero_flag then params.push(ir_param(l_i1()))

    request_intrinsic(e, ir_sig(name, ir_fn_type(ll, params)))

    var ops: Buf[IrArg] = buf()

    for i in 0..<args.len()
        ops.push(ir_arg(ll, args.at(i)))

    if zero_flag then ops.push(ir_arg(l_i1(), VBool(false)))

    val r = fresh_reg(e)

    emit(e, ir_call(Some(r), ll, VGlobal(name), ops))
    r
end bit_intrinsic

// An integer value moved between two widths, unsigned. Nothing is emitted where they agree, which is
// the usual case and keeps the IR of a 32-bit count readable.
//
// **A non-negative immediate is its own value at every width it fits in**, so widening one is a
// `zext` of a constant that says nothing. What that is for is `emit-llvm`, where a rotation by a
// literal should read as the constant funnel shift it is rather than as a register one whose
// register is a constant. Narrowing still goes through the instruction, since an immediate too wide
// for the type it is written at is not IR at all.
private resize_int(e: *Emit, v: Val, from: Type, to: Type) -> Val
    val a = int_bits_of(from)
    val b = int_bits_of(to)

    if a == b then return v

    if a < b && is_non_negative_immediate(v) then return v

    val r = fresh_reg(e)

    emit(e, InCast(r, if a < b then CastZExt else CastTrunc, lty(e, from), v, lty(e, to)))
    r
end resize_int

private is_non_negative_immediate(v: Val) -> bool = v match
    VInt(n) -> n.sign() >= 0
    _ -> false

// A rotation amount, brought from the `u32` it is written as to the width being rotated.
//
// The funnel-shift intrinsics already take their amount modulo the width, so most of the time this
// is the resize alone. **The exception is a width that is not a power of two**, where narrowing to
// it first would take the amount modulo `2^w` and the two reductions do not compose: an `i5` asked
// to rotate by 33 would answer as though asked for 1, because 33 survives the narrowing to 1 and 5
// does not divide 32. So a width like that reduces first, at the amount's own width, where the
// answer is still the one the program asked for.
private rotate_by(e: *Emit, v: Val, from: Type, bits: int) -> Val
    val reduced = if (bits & (bits - 1)) == 0 || int_bits_of(from) <= bits then v
    else
        val r = fresh_reg(e)

        emit(e, InBin(r, OpURem, lty(e, from), v, VInt(from_int(long(bits)))))
        r

    resize_int(e, reduced, from, Integer(bits, false, false))
end rotate_by

private int_bits_of(t: Type) -> int = underlying(t) match
    Integer(bits, _, _) -> bits
    _ -> 32
