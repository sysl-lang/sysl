// Today: a ref into a by-value local's field survives an assignment to the whole local -- a field
// step owns nothing, so 'g = ...' is not a hazard. For a @unique value the assignment runs a
// destructor, and the design makes the local an owning step.
struct Guard
    n: int

main()
    var g = Guard(1)
    ref r = g.n

    g = Guard(2)
    r = 7
    print(g.n)
