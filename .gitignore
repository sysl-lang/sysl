# The built executable, named for the package. The compiler project is `compiler/`, so that is
# where `sysl build .` writes it.
/compiler/sysl

# What the bootstrap compiler writes while building.
target/
.sysl/

# IntelliJ.
.idea/

# What scripts/release.sh writes when no --out is given.
/release-out/

# What a gate run writes, in the compiler project it runs from.
/compiler/gate.log
/compiler/sysl1
/compiler/sysl2
