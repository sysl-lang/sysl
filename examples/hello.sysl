// A first sysl program. Run it with:
//   sbt "syslJVM/run run examples/hello.sysl"

print("Hello, sysl!")

var width = 6
var height = 7
print("area =", width * height)

// A function: an expression body after `=`, or an indented block.
add(a: int, b: int) -> int = a + b
print("3 + 4 =", add(3, 4))

// Sum the numbers 1 through 10 with a for loop.
var sum = 0
for i in 1..10
    sum = sum + i
print("sum 1..10 =", sum)

// `if` is an expression — it yields the value of the taken branch.
print(sum, "is", if sum % 2 == 0 then "even" else "odd")

// A value struct: positional construction and field access. An optional `end` marker names
// the declaration it closes.
struct Point
    x: int
    y: int
end Point

var p = Point(width, height)
print("point:", p.x, p.y)

// `match` picks an arm by literal, `|`-alternative, range, or a guarded wildcard.
size(n: int) -> string
    match n
        0 -> "empty"
        1 | 2 | 3 -> "small"
        4..99 -> "medium"
        else -> "large"

print("55 is", size(sum))

// A data enum: a tagged union. Construct with a variant name, destructure it in a `match`.
enum Shape
    Circle(radius: int)
    Rect(w: int, h: int)
    Empty
end Shape

area(s: Shape) -> int
    match s
        Circle(r) -> r * r * 3
        Rect(w, h) -> w * h
        Empty -> 0
end area

print("areas:", area(Circle(5)), area(Rect(3, 4)), area(Empty))
