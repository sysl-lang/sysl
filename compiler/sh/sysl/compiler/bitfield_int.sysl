module sh.sysl.compiler

import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}
import sysl.math.bigint.BigInt

// A bitfield struct and the integer it is: `T::Bits(n)` makes one from that integer and `x.bits`
// reads it back.
//
// **A `@packed` struct whose fields are bit ranges IS one unsigned integer** (`layout.sysl`'s
// `bitfield_ranges`), so neither direction converts anything: the value is the container, and the
// two forms only change which type the same bits are read at. They are fixed point's two spellings
// for the same reinterpretation (`fixed.sysl`'s `fixed_attr` and `fixed_bits_of`), and they are not
// a conversion call `Esr(raw)` because that spelling is already the field constructor -- a bitfield
// struct of one field would make it mean two things.
//
// **The integer is the container's type**, `u<width>` with the width a whole number of bytes: a
// literal takes that type from the position, a narrower unsigned value widens to it as any argument
// does, and a value that would have to be narrowed or change its sign is refused.
//
// **Nothing is checked on the way in.** An enum-typed field may hold a value no variant has once the
// bits came from outside; the field read is what holds it to its variants, as it is for a struct
// reached through a pointer the hardware filled.

// **A `@packed` struct of whole-byte fields converts too** (`layout.sysl`'s `integer_ranges`), though
// it is stored as its fields end to end: its integer is its fields read least significant first, so
// the two directions put each field in or take it out of its range. On a little-endian machine that
// is its bytes read as one integer; a `@byte_order` struct's fields are reversed on the way, as a
// field read reverses them, so the integer holds the fields' values and not the wire's bytes.

// The unsigned integer a `@packed` struct converts to, where it converts to one.
bitfield_storage(d: &StructType) -> Option[Type] = integer_ranges(d) match
    Some(ranges) -> Some(Integer(bitfield_bits(ranges), false, false))
    None -> None

// Why a struct has no `::Bits`, naming the field that keeps it from one where that is the reason.
private no_bits_reason(written: string, d: &StructType) -> string
    val head = s"'$written::Bits' has no integer to make it from"
    val rule = "only a '@packed' struct whose every field is an integer, a simple enum, a bitfield " +
               "struct or a '@packed' struct that converts itself converts to one"

    if d.union_layout then return s"'$written' is a union, so $head — $rule"
    if !d.c_bits.is_empty() then return s"'$written' holds C bitfields, so $head — $rule"
    if !d.packed then return s"'$written' is not '@packed', so $head — $rule"

    unconvertible_field(d) match
        Some(field) -> s"$head: its field '${field.0}' is ${type_show(field.1)}${why_not_chain(field.1)} — $rule"
        None -> s"'$written' has no fields, so $head — $rule"
end no_bits_reason

// Where a field is itself a `@packed` struct that does not convert, the field inside it that keeps
// it from converting, and so on down: ", whose field 'f' is f32".
private why_not_chain(t: Type) -> string = underlying(t) match
    Struct(inner) ->
        if !inner.packed || inner.union_layout || !inner.c_bits.is_empty() then ""
        else unconvertible_field(inner) match
            Some(f) -> s", whose field '${f.0}' is ${type_show(f.1)}${why_not_chain(f.1)}"
            None -> ""
    _ -> ""

// `T::Attr(...)` on a struct: `Bits` for a `@packed` struct of integers, and a refusal saying why
// otherwise.
struct_attr(cx: &Analyzer, span: Span, written: string, d: &StructType, attr: string,
            args: Buf[Expr]) -> TExpr
    val storage = bitfield_storage(d)

    if storage.is_none()
        if attr == "Bits" then return cx.err(span, no_bits_reason(written, d))

        return cx.err(span, s"'${type_show(Struct(d))}' has no type attributes")
    end if

    if attr != "Bits" then
        return cx.err(span, s"'$written' has no attribute '$attr' — its one attribute is " +
                      s"'$written::Bits'")

    if args.len() != 1 then return cx.err(span, s"'$written::Bits' takes exactly one argument")

    // Making one writes every field at once, so it is held to what the constructor is.
    if !layout_known(cx.an, cx.scope, span, d.base, qualified_name(d.base)) then
        return bad_expr(span)

    every_field_visible(cx, span, d, s"'$written::Bits'",
                        "build it through an associated function of its own")

    val raw_ty = storage.unwrap()
    val x = type_expr(cx, args.at(0), Some(raw_ty))
    val xt = texpr_type(x)

    if xt == Unknown then return x

    if disagree(xt, raw_ty) then
        return cx.err(args.at(0).span, s"'$written::Bits' takes the ${type_show(raw_ty)} " +
                      s"'$written' is stored as, not ${type_show(xt)} — a value of another width is " +
                      s"converted first, as '${type_show(raw_ty)}(x)'")

    TExpr(span, TIntOp("bitfield_from_bits", x, None, raw_ty, Struct(d)))
end struct_attr

// The struct `T::Bits(n)` makes from a constant `n`, as the construction that writes the same fields
// -- which is what lays it down as data (`analyze_body.sysl`'s `static_image`). `None` where an enum
// field's bits are no variant's, which no construction can write, or a field takes no room.
bits_literal(span: Span, d: &StructType, n: BigInt) -> Option[TExpr]
    val ranges = integer_ranges(d)

    if ranges.is_none() || ranges.unwrap().len() != d.fields.len() then return None

    var args: Buf[TExpr] = buf()

    for r in ranges.unwrap()
        val slice = wrap(n >> usize(r.offset), r.width, false)
        val field = underlying(r.ty) match
            Integer(bits, signed, _) -> Some(TExpr(span, TIntLit(wrap(slice, bits, signed), r.ty)))
            Enum(en) -> variant_with_bits(en, slice, r.width).map(v -> TExpr(span, TEnumNew(r.ty, v, buf())))
            Struct(inner) -> bits_literal(span, inner, slice)
            _ -> None

        if field.is_none() then return None

        args.push(field.unwrap())

    Some(TExpr(span, TStructNew(d, args)))
end bits_literal

// The variant of a simple enum whose discriminant has these bits.
private variant_with_bits(en: &EnumType, bits: BigInt, width: int) -> Option[EnumVariant]
    for v in en.variants
        if !v.carries && wrap(v.tag, width, false) == bits then return Some(v)

    None
end variant_with_bits

// `x.bits` on a bitfield struct: the whole container, read as the integer it is. `None` where the
// struct is not one, or declares a member of that name itself, which is then what `.bits` reaches.
bitfield_bits_read(cx: &Analyzer, span: Span, value: TExpr, d: &StructType) -> Option[TExpr]
    val storage = bitfield_storage(d)

    if storage.is_none() || has_member(cx.an, Struct(d), "bits") then return None

    // Reading every bit is reading every field.
    every_field_visible(cx, span, d, "'.bits'", "read the fields it may reach instead")

    val raw_ty = storage.unwrap()

    Some(TExpr(span, TIntOp("bitfield_bits", value, None, raw_ty, raw_ty)))
end bitfield_bits_read
