module sh.sysl.compiler

import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}
import sysl.container.{Map, map, Set, set}
import sysl.text.Search

// A view a member hands back of its own receiver, and the receiver it may not outlive.
//
// **A slice keeps its owner alive, except where it has none to keep**: a view of memory a C library
// owns carries a null owner word, so nothing about the view stops the object that frees that memory
// from being freed first (`reference/arrays.md § What a view keeps alive`). `@views(self)` on a
// member says the view it answers is borrowed from what it is called on, and this file holds the
// view to that: it may be used only while the receiver is certainly alive.
//
// **The receiver is alive while the name it was called through is in scope and unchanged**, because
// that name holds a count of its own (or, for a parameter, its caller does). So the whole check is
// lexical, the way a `ref`'s is (`place.sysl`'s `RefWatch`), and it reuses that machinery rather
// than inventing a second:
//
// - the receiver has to BE a name: a temporary (`open().view()`) is freed at the end of its
//   statement, so its view is refused at the call;
// - a view, and everything made from it that can still hold it, goes only where it dies first: into
//   a local bound after the receiver, never into a field reached through a reference, module
//   storage, or a result -- except a `@views(self)` member's own result borrowed from `self`;
// - while a local holding the view is in scope, the receiver's name is held still: assigning it, a
//   `*self` call on it, and a call that may write the receiver's type are refused.
//
// **Nothing about this is in a type.** The view is an ordinary `[]T` at no run-time cost, and the
// borrow is a fact the analyzer keeps about local names for as long as it reads one body.

// One receiver a view is borrowed from: the place it was called on, the local at the bottom of that
// place by its unique name (empty for module storage, which no scope closes on), and that local's
// name as written, which is what a refusal says.
//
// **A view handed to a call reaches the call's answer only if the callee answers with it**, which is
// a fact about the callee's body (`view_answer`), known only once every body is typed. So a root reached through a call's answer carries `via`: each call it went through, by
// callee and argument position. A root with no `via` is borrowed outright and refused where it is
// met; one with a `via` is refused the same way, but told only once every call on it is known to
// answer with what it was handed (`settle_view_refusals`).
struct ViewRoot
    place: TExpr
    unique: string
    name: string
    via: Buf[(string, usize)]
end ViewRoot

// A refusal that holds only if every call in `via` answers with the argument it names, kept until
// the answers are settled. `for_ref` is a refusal on a live borrow's account, which the
// whole-program call check is told about as `refuse_for_ref` tells it.
struct ViewRefusal
    scope: Scope
    span: Span
    message: string
    via: Buf[(string, usize)]
    for_ref: bool
end ViewRefusal

// The local name at the bottom of a receiver place, or nothing where the receiver is a temporary.
// A place reached through a raw pointer that a call answers is the root itself: what a `*T` points
// at is storage the pointer does not own, so it is no temporary, though the pointer is.
private receiver_root(cx: &Analyzer, t: TExpr) -> Option[TExpr] = *t.kind match
    TLoad(_, _) -> Some(t)
    TGlobal(_, _, _) -> Some(t)
    TField(recv, _, _) -> root_through(cx, recv)
    TIndex(recv, _, _) -> root_through(cx, recv)
    TDeref(operand, _) -> root_through(cx, operand)
    TConstView(arg) -> receiver_root(cx, arg)
    TAddrOf(inner, _) -> receiver_root(cx, inner)
    TCall(_, _, _, _) -> placed_by(cx, t) match
        Some(recv) -> receiver_root(cx, recv)
        None -> None
    _ -> None

// The root below a place read through `recv`: `recv`'s own, or `recv` itself where it is a raw
// pointer that is not a place -- a call's answer, a cast -- whose pointee outlives the statement.
private root_through(cx: &Analyzer, recv: TExpr) -> Option[TExpr] = receiver_root(cx, recv) match
    Some(r) -> Some(r)
    None -> underlying(texpr_type(recv)) match
        Ptr(_) -> Some(recv)
        _ -> None

// The local a unique name is bound to, with its position in the scope stack, while it is in scope.
private local_at(cx: &Analyzer, unique: string) -> Option[(usize, Local)]
    var i = cx.locals.len()

    while i > 0
        i -= 1

        if cx.locals[i].unique == unique then return Some((i, cx.locals[i]))

    None
end local_at

// A call to a `@views(self)` member, noted against its receiver. A receiver that is not a name is
// a temporary, freed when the statement ends, so a view of it is refused here, naming it.
note_view_call(cx: &Analyzer, span: Span, receiver: TExpr, member: string)
    if texpr_type(receiver) == Unknown then return

    val root = receiver_root(cx, receiver)

    if root.is_none()
        val what = *receiver.kind match
            TCall(name, _, _, _) -> s"the value '${qualified_name(name)}' answers"
            TCallPtr(_, _, _, _) -> "the value a call answers"
            TVCall(_, _, _, _, _) -> "the value a call answers"
            _ -> "the value it is called on"

        cx.fault(span, s"'$member' answers a view borrowed from what it is called on, and that is " +
                 s"$what — a temporary, freed at the end of this statement, so the view would be " +
                 "left reading freed memory. Bind it with 'val' first, so it lives as long as the " +
                 "view does")
        return
    end if

    val unique = *root.unwrap().kind match
        TLoad(name, _) -> name
        _ -> ""

    var name = unique

    if unique != ""
        val l = local_at(cx, unique)

        if l.is_some() then name = l.unwrap().1.name
    else
        name = *root.unwrap().kind match
            TGlobal(_, _, _) -> "module storage"
            TCall(callee, _, _, _) -> s"*${qualified_name(callee)}(…)"
            _ -> "*(…)"
    end if

    cx.view_calls.push((span, ViewRoot(receiver, unique, name, buf())))
end note_view_call

// -- which receivers a value is borrowed from ------------------------------------------------------

// Whether a value of this type can hold a view: a view or a string, or anything a view can be kept
// in -- a struct, an enum, a fixed array, a closure (a closure is a struct of what it captured), a
// reference to one of those, a trait object or a value whose type is not settled yet. A raw pointer
// cannot: what it points at is the programmer's problem, like every `*T`. **Nor can a `&sync T`**:
// a shared object holds no view at all (`sharing.sysl`), so one read out of a view is its own.
private holds_borrow(t: Type, depth: int) -> bool
    if depth > 6 then return true

    underlying(t) match
        Slice(_, _) -> true
        Str -> true
        Ref(inner, sync) -> !sync && holds_borrow(*inner, depth + 1)
        Weak(inner) -> holds_borrow(*inner, depth + 1)
        Array(_, elem) -> holds_borrow(*elem, depth + 1)
        Struct(d) -> parts_hold_borrow(d.fields, d.targs, depth)
        Results(d) -> parts_hold_borrow(d.fields, d.targs, depth)
        Enum(d) ->
            for item in d.variants
                if parts_hold_borrow(item.fields, d.targs, depth) then return true

            false
        Trait(_, _, _) -> true
        Abstract(_, _) -> true
        _ -> false
end holds_borrow

private parts_hold_borrow(fields: Buf[(string, Type)], targs: Buf[Type], depth: int) -> bool
    for item in fields
        if holds_borrow(item.1, depth + 1) then return true

    for item in targs
        if holds_borrow(item, depth + 1) then return true

    false
end parts_hold_borrow

// A string made fresh rather than shared: rendered, formatted, joined, or answered by a call. A
// string is a counted object of its own unless it was made over bytes in place, so one of these
// views nothing the operands viewed.
private fresh_string(e: TExpr) -> bool
    if texpr_type(e) != Str then return false

    *e.kind match
        TStr(_) -> true
        TFormat(_, _, _) -> true
        TRender(_, _, _, _) -> true
        TBinary(_, _, _, _) -> true
        TCall(_, _, _, _) -> true
        TCallPtr(_, _, _, _) -> true
        TVCall(_, _, _, _, _) -> true
        _ -> false
end fresh_string

private struct RootSink
    roots: Buf[ViewRoot]
    pruned: Set[string]
end RootSink

// The receivers a value may hold a view borrowed from: every `@views(self)` call in it and every
// local it reads that holds one, reached through nothing that cannot hold a view. **A node that
// cannot hold one ends the walk below it** -- `v.len` is an integer, so a value made from it is not
// borrowed from anything `v` was, and `count(v)` answering an integer hands back nothing of `v`.
//
// The walk visits the outermost node first, so a node is skipped when it is one of the nodes under
// one already found to be one of those. **They are told by their own spans, not by lying inside the
// outer node's**: a call's span is its callee's name, so its arguments lie outside it.
view_roots(cx: &Analyzer, e: TExpr) -> Buf[ViewRoot]
    var out: Buf[ViewRoot] = buf()

    if cx.view_calls.is_empty() && cx.view_borrows.is_empty() then return out
    if !holds_borrow(texpr_type(e), 0) then return out

    val sink: &RootSink = RootSink(buf(), set())

    walk_texpr(e, expr_walk(false, x -> visit_root(cx, sink, x)))
    sink.roots
end view_roots

private span_key(s: Span) -> string = s"${s.start}:${s.end}"

private visit_root(cx: &Analyzer, sink: &RootSink, x: TExpr)
    if sink.pruned.has(span_key(x.span)) then return

    for item in cx.view_calls
        if item.0.start == x.span.start && item.0.end == x.span.end
            add_root(sink, item.1)
            return
        end if

    if !holds_borrow(texpr_type(x), 0) || fresh_string(x)
        walk_texpr(x, expr_walk(false, y -> sink.pruned.add(span_key(y.span))))
        return
    end if

    *x.kind match
        TLoad(name, _) ->
            for item in cx.view_borrows
                if item.0 == name then
                    for r in item.1
                        add_root(sink, r)
        TCall(callee, args, _, _) ->
            // **A call's answer holds what an argument is borrowed from only if the callee answers
            // with that argument**: each argument's roots are taken on the call's account, and the
            // walk goes no further below it.
            for i in 0..<args.len()
                for r in view_roots(cx, args[i])
                    var via = r.via.copy()

                    via.push((callee, i))
                    add_root(sink, ViewRoot(r.place, r.unique, r.name, via))

            walk_texpr(x, expr_walk(false, y -> sink.pruned.add(span_key(y.span))))
        _ -> ()
end visit_root

private add_root(sink: &RootSink, r: ViewRoot)
    for item in sink.roots
        if item.unique == r.unique && item.place.span.start == r.place.span.start && same_via(item.via, r.via)
            return

    sink.roots.push(r)
end add_root

private same_via(a: Buf[(string, usize)], b: Buf[(string, usize)]) -> bool
    if a.len() != b.len() then return false

    for i in 0..<a.len()
        if a[i].0 != b[i].0 || a[i].1 != b[i].1 then return false

    true
end same_via

// The roots with those borrowed outright first, so that a refusal that holds whatever the callees
// answer is the one told.
private outright_first(roots: Buf[ViewRoot]) -> Buf[ViewRoot]
    var out: Buf[ViewRoot] = buf()

    for r in roots
        if r.via.is_empty() then out.push(r)

    for r in roots
        if !r.via.is_empty() then out.push(r)

    out
end outright_first

// Refuses what `r` is borrowed from, now where it is borrowed outright, and once the answers are
// settled where it reached here through calls' answers.
private refuse_view(cx: &Analyzer, span: Span, message: string, r: ViewRoot, for_ref: bool)
    if r.via.is_empty()
        if for_ref then refuse_for_ref(cx, span, message) else cx.fault(span, message)
        return
    end if

    cx.an.view_refusals.push(ViewRefusal(cx.scope, span, message, r.via, for_ref))
end refuse_view

// -- whether a callee answers with what it was handed ---------------------------------------------

// **What a body's answer may hold of a parameter, asked as this file asks it of a value**: a part of
// the answer that cannot hold a view, or a string made fresh, holds nothing; a read of the parameter,
// or of a local something holding it was put in, holds it; and a call holds it where an argument
// does and the callee's own answer is made of that argument. A local bound by a form this does not
// follow -- an `if` that binds, an `or` pattern -- is taken to hold it. A callee with no body in sight
// is taken to answer with everything it was handed, and a recursion with nothing beyond what its
// other ways out answer.
//
// The view-address questions of `keeps.sysl` are about addresses (`may_hold_pointer`), and a view
// is not one to them: its owner word keeps its storage, except where a `@views(self)` member lent it
// with none, which is the case asked about here.
private struct AnswerProbe
    cx: &KeepsCx
    memo: Map[string, bool]
    busy: Buf[string]
    leaned: bool
end AnswerProbe

// Whether what `name` answers may hold what its argument at `i` is borrowed from.
private view_answer(p: &AnswerProbe, name: string, i: usize) -> bool
    val key = s"$name|$i"

    p.memo.get(key) match
        Some(v) -> return v
        None -> ()

    for item in p.busy
        if item == key
            p.leaned = true
            return false
        end if

    val found = p.cx.find(name)

    if found.is_none() then return true

    val f = found.unwrap()

    if i >= f.params.len() then return false

    val outer = p.leaned

    p.leaned = false
    p.busy.push(key)

    val out = body_answers(p, f, i)

    p.busy.truncate(p.busy.len() - 1)

    // An answer worked out over a recursion still open read a guess, so it is not kept.
    if !p.leaned then p.memo.put(key, out)

    p.leaned = outer || p.leaned
    out
end view_answer

// The locals of one body that may hold what its parameter `param` is borrowed from.
private struct BodyTaint
    probe: &AnswerProbe
    param: string
    tainted: Set[string]
    declared: Set[string]
    changed: bool
end BodyTaint

private struct CarrySink
    found: bool
    pruned: Set[string]
end CarrySink

private body_answers(p: &AnswerProbe, f: TFunc, i: usize) -> bool
    val bt: &BodyTaint = BodyTaint(p, f.params[i].0, set(), set(), true)

    for item in f.params
        bt.declared.add(item.0)

    walk_block_stmts(f.body, TWalk(false, e -> declare_bound(bt, e), w -> (), s -> s match
        TVarDecl(n, _, _, _) -> bt.declared.add(n)
        _ -> ()))

    while bt.changed
        bt.changed = false
        walk_block_stmts(f.body, TWalk(false, e -> spread_expr(bt, e), w -> spread_write(bt, w.place, w.value),
                                       s -> s match
                                           TVarDecl(n, _, init, _) -> if carries(bt, init) then taint(bt, n)
                                           _ -> ()))

    val out: &CarrySink = CarrySink(false, set())

    walk_block_stmts(f.body, stmt_walk(false, s -> s match
        TReturn(v) -> if v.is_some() && carries(bt, v.unwrap()) then out.found = true
        TBecome(call) -> if carries(bt, call) then out.found = true
        _ -> ()))

    out.found || (f.body.result.is_some() && carries(bt, f.body.result.unwrap()))
end body_answers

// The names a match arm or a loop binds, which take what their subject holds.
private declare_bound(bt: &BodyTaint, e: TExpr)
    *e.kind match
        TMatch(_, arms, _) ->
            for arm in arms
                for pat in arm.patterns
                    var names: Buf[string] = buf()

                    pattern_names(pat, &names)

                    for n in names
                        bt.declared.add(n)
        TForEach(name, _, _, _, _, _) -> bt.declared.add(name)
        TFor(name, _, _, _, _, _, _, _) -> bt.declared.add(name)
        _ -> ()
end declare_bound

private spread_expr(bt: &BodyTaint, e: TExpr)
    *e.kind match
        TStore(place, v, _, _) -> spread_write(bt, place, v)
        TMatch(subject, arms, _) ->
            if carries(bt, subject)
                for arm in arms
                    for pat in arm.patterns
                        var names: Buf[string] = buf()

                        pattern_names(pat, &names)

                        for n in names
                            taint(bt, n)
            end if
        TForEach(name, _, seq, _, _, _) -> if carries(bt, seq) then taint(bt, name)
        _ -> ()
end spread_expr

private spread_write(bt: &BodyTaint, place: TExpr, value: TExpr)
    if !carries(bt, value) then return

    by_value_local(place) match
        Some(n) -> taint(bt, n)
        None -> ()
end spread_write

private taint(bt: &BodyTaint, n: string)
    if bt.tainted.has(n) then return

    bt.tainted.add(n)
    bt.changed = true
end taint

// Whether a value may hold what the parameter is borrowed from, walked as `view_roots` walks one.
private carries(bt: &BodyTaint, e: TExpr) -> bool
    if !holds_borrow(texpr_type(e), 0) then return false

    val sink: &CarrySink = CarrySink(false, set())

    walk_texpr(e, expr_walk(false, x -> carry_visit(bt, sink, x)))
    sink.found
end carries

private carry_visit(bt: &BodyTaint, sink: &CarrySink, x: TExpr)
    if sink.found || sink.pruned.has(span_key(x.span)) then return

    if !holds_borrow(texpr_type(x), 0) || fresh_string(x)
        walk_texpr(x, expr_walk(false, y -> sink.pruned.add(span_key(y.span))))
        return
    end if

    *x.kind match
        TLoad(n, _) ->
            if n == bt.param || bt.tainted.has(n) || !bt.declared.has(n) then sink.found = true
        TCall(callee, args, _, _) ->
            for j in 0..<args.len()
                if carries(bt, args[j]) && view_answer(bt.probe, callee, j)
                    sink.found = true
                    return
                end if

            walk_texpr(x, expr_walk(false, y -> sink.pruned.add(span_key(y.span))))
        _ -> ()
end carry_visit

// Whether every call a borrow went through answers with the argument it was handed there.
private via_holds(p: &AnswerProbe, via: Buf[(string, usize)]) -> bool
    for step in via
        if !view_answer(p, step.0, step.1) then return false

    true
end via_holds

// **The refusals that waited on calls' answers, told now that every body is typed**, and the live
// borrows that were filed through calls kept only where those calls answer with the view.
settle_view_refusals(a: &Analysis, cx: &KeepsCx)
    if a.view_refusals.is_empty() && a.ref_watches.is_empty() then return

    val p: &AnswerProbe = AnswerProbe(cx, map(), buf(), false)

    for item in a.view_refusals
        if !via_holds(p, item.via) then continue

        a.fault(item.scope, item.span, item.message)

        if item.for_ref then a.ref_refusals.push(item.span.start)

    var kept = false

    for w in a.ref_watches
        if !w.via.is_empty() then kept = true

    if !kept then return

    var watches: Buf[RefWatch] = buf()

    for w in a.ref_watches
        if w.via.is_empty() || via_holds(p, w.via) then watches.push(w)

    a.ref_watches = watches
end settle_view_refusals

// -- where a borrowed view may go ------------------------------------------------------------------

// Whether every receiver is still in scope here. One that is not was bound in a block that has
// closed, so what it held has been let go of and the view is reading freed memory -- `val v = if c
// then (val o = open(); o.view()) else …` is this.
private roots_in_scope(cx: &Analyzer, span: Span, what: string, roots: Buf[ViewRoot]) -> bool
    for r in outright_first(roots)
        if r.unique != "" && local_at(cx, r.unique).is_none()
            refuse_view(cx, span, s"$what a view borrowed from '${r.name}', which is let go of at the " +
                        "end of the block that bound it — so the view would be left reading freed " +
                        "memory. Use the view inside that block", r, false)

            if r.via.is_empty() then return false
        end if

    true
end roots_in_scope

// A local just bound to `value`: it holds the view `value` is borrowed from, so it is filed, and
// the receiver is held still for as long as the local is in scope.
note_view_binding(cx: &Analyzer, span: Span, name: string, unique: string, value: TExpr)
    val roots = view_roots(cx, value)

    if roots.is_empty() then return
    if !roots_in_scope(cx, span, s"'$name' would hold", roots) then return

    file_borrow(cx, span, unique, name, roots)
end note_view_binding

// A loop variable just bound to each element of `seq`. **An element that can hold a view is
// borrowed from whatever `seq` is**: walking a borrowed view of views hands out views that read the
// same receiver's memory, so the variable is filed exactly as a `val` bound to `seq[i]` would be. An
// element that cannot hold one -- a byte, an integer -- is a copy and borrows nothing.
note_loop_borrow(cx: &Analyzer, span: Span, name: string, unique: string, seq: TExpr, elem: Type)
    if !holds_borrow(elem, 0) then return

    val roots = view_roots(cx, seq)

    if roots.is_empty() then return
    if !roots_in_scope(cx, span, s"'$name' would hold", roots) then return

    file_borrow(cx, span, unique, name, roots)
end note_loop_borrow

// The places a pattern takes its parts from, set while a pattern of a borrowed value is bound.
pattern_view_roots(cx: &Analyzer, subject: TExpr) -> Buf[ViewRoot] = view_roots(cx, subject)

// A name a pattern bound out of a borrowed value, with the type it was bound at.
note_pattern_borrow(cx: &Analyzer, unique: string, name: string, ty: Type)
    if cx.pattern_roots.is_empty() || !holds_borrow(ty, 0) then return

    file_borrow(cx, cx.bind_site.unwrap_or(Span(0, 0)), unique, name, cx.pattern_roots)
end note_pattern_borrow

private file_borrow(cx: &Analyzer, span: Span, unique: string, name: string, roots: Buf[ViewRoot])
    var found = false

    for i in 0..<cx.view_borrows.len()
        val item = cx.view_borrows[i]

        if item.0 == unique
            var joined: Buf[ViewRoot] = buf()

            for r in item.1
                joined.push(r)

            for r in roots
                joined.push(r)

            cx.view_borrows[i] = (unique, joined)
            found = true
        end if

    if !found then cx.view_borrows.push((unique, roots))

    // The call half of the hold is the whole-program check a `ref` gets (`checks.sysl`'s
    // `check_ref_calls`): a call that may write the receiver's object is refused while the local is
    // in scope, since a member that frees what the view reads writes the object it frees it from.
    val at = local_at(cx, unique)

    if at.is_none() then return

    val lent = held_view_elem(at.unwrap().1.ty)

    for r in roots
        var types: Buf[Type] = buf()

        types.push(object_type(texpr_type(r.place)))

        val root = *r.place.kind match
            TLoad(_, _) -> r.unique
            _ -> ""

        cx.an.ref_watches.push(RefWatch(cx.watch_key(), name, types, span.end, None, at.unwrap().0,
                                        r.name, buf(), root, lent, r.via))
end file_borrow

// The element type of every view a local of type `t` holds: the local itself a view, or an array or
// struct holding views by value beside plain numbers -- `[Region(base, sram.view_mut())]` lends
// `byte`s as surely as `sram.view_mut()` does. Anything else held, or views of two element types,
// answers `Unknown`, which asks the call about every write.
private held_view_elem(t: Type) -> Type
    var elems: Buf[Type] = buf()

    if !held_views(t, &elems) || elems.is_empty() then return Unknown

    for item in elems
        if item != elems[0] then return Unknown

    elems[0]
end held_view_elem

private held_views(t: Type, out: *Buf[Type]) -> bool = underlying(t) match
    Slice(elem, _) ->
        out.push(underlying(*elem))
        true
    Array(_, elem) -> held_views(*elem, out)
    Constrained(d) -> held_views(d.base, out)
    Struct(d) ->
        if !d.targs.is_empty() then return false

        for item in d.fields
            if !held_views(item.1, out) then return false

        true
    Integer(_, _, _) -> true
    Floating(_, _) -> true
    Fixed(_, _, _) -> true
    Char -> true
    Bool -> true
    Unit -> true
    _ -> false

// An assignment of `value` into `target`. **The target has to die before the receiver does**: a
// local bound after it, or storage held by value inside one, and nothing reached through a
// reference, a pointer or a view -- that storage may be held by something that outlives the frame.
note_view_store(cx: &Analyzer, span: Span, target: TExpr, value: TExpr)
    val roots = view_roots(cx, value)

    if roots.is_empty() then return
    if !roots_in_scope(cx, span, "this stores", roots) then return

    val owner = by_value_local(target)

    if owner.is_none()
        for r in outright_first(roots)
            refuse_view(cx, span, s"this stores a view borrowed from '${r.name}' somewhere reached " +
                        "through a reference, a pointer or module storage, which may outlive it — so " +
                        "the view could be read after what it views is freed. Keep the view in a local " +
                        s"bound after '${r.name}'", r, false)

            if r.via.is_empty() then return

        return
    end if

    val l = local_at(cx, owner.unwrap())

    if l.is_none() then return

    for r in outright_first(roots)
        if r.unique == "" then continue

        val at = local_at(cx, r.unique)

        if at.is_some() && at.unwrap().0 >= l.unwrap().0
            refuse_view(cx, span, s"'${l.unwrap().1.name}' is bound before '${r.name}', so it outlives " +
                        s"it, and this stores in it a view borrowed from '${r.name}' — the view would " +
                        "be read after what it views is freed. Bind the view's holder after " +
                        s"'${r.name}'", r, false)

            if r.via.is_empty() then return
        end if

    file_borrow(cx, span, owner.unwrap(), l.unwrap().1.name, roots)
end note_view_store

// The local whose own storage a place is, reached through fields of struct values and elements of
// fixed arrays only.
private by_value_local(t: TExpr) -> Option[string] = *t.kind match
    TLoad(name, _) -> Some(name)
    TField(recv, _, _) -> if indirect(texpr_type(recv)) then None else by_value_local(recv)
    TIndex(recv, _, _) -> if indirect(texpr_type(recv)) then None else by_value_local(recv)
    _ -> None

private indirect(t: Type) -> bool = underlying(t) match
    Ref(_, _) -> true
    Ptr(_) -> true
    Weak(_) -> true
    Slice(_, _) -> true
    Str -> true
    _ -> false

// A value leaving the function -- a `return`, or what its body comes to. Only a `@views(self)`
// member may hand back a view, and only one borrowed from `self`: anything else it is borrowed from
// is a local the return lets go of, or a parameter whose caller does not know the result is tied to
// it.
note_view_return(cx: &Analyzer, span: Span, value: TExpr)
    val roots = view_roots(cx, value)

    for r in outright_first(roots)
        if cx.views_self && r.unique == "self" then continue

        var message = s"this returns a view borrowed from '${r.name}', and nothing keeps " +
                      s"'${r.name}' alive once this function returns — so the caller could read " +
                      "freed memory. Return a copy, or return it from a member of its type marked " +
                      "'@views(self)'"

        if r.unique == "" && r.name == "module storage"
            message = "this returns a view borrowed from module storage, which may be reassigned " +
                      "while the caller still reads it. Return a copy"
        else if r.unique == ""
            message = s"this returns a view borrowed from '${r.name}', and nothing keeps what that " +
                      "pointer points at alive once this function returns — so the caller could " +
                      "read freed memory. Return a copy, or return it from a member of its type " +
                      "marked '@views(self)'"
        else if r.unique == "self"
            message = "this returns a view borrowed from 'self', and only a member marked " +
                      "'@views(self)' may — the mark is what tells the caller the view lives no " +
                      "longer than what it was called on"
        end if

        refuse_view(cx, span, message, r, false)

        if r.via.is_empty() then return
end note_view_return

// -- what a live borrowed view holds still ---------------------------------------------------------

// Refuses a write that could free what a view a live local holds is borrowed from: the receiver
// itself, anything enclosing it, or anything inside it that holds storage. **Asked of spellings**,
// as a `ref`'s own path is: two names for one object are the call check's business.
check_view_guards(cx: &Analyzer, at: Span, target: TExpr) -> bool
    if cx.view_borrows.is_empty() then return false

    val key = place_key(cx, target)

    if key.is_none() then return false

    val k = key.unwrap()

    for item in cx.view_borrows
        val holder = local_at(cx, item.0)

        if holder.is_none() then continue

        for r in item.1
            val rk = place_key(cx, r.place)

            if rk.is_none() then continue

            val p = rk.unwrap()
            val related = k == p || p.starts_with(s"$k/") ||
                          (k.starts_with(s"$p/") && holds_storage(texpr_type(target)))

            if related
                refuse_view(cx, at, s"'${holder.unwrap().1.name}' is a view borrowed from " +
                            s"'${r.name}', and this assignment could free what it views — so " +
                            "the view would be left reading freed memory. Write the " +
                            "assignment before the view is taken, or put the view in a block " +
                            "that closes first", r, true)

                if r.via.is_empty() then return true
            end if

    false
end check_view_guards

// The same for a `*self` call, or a `@relocates` one, on the receiver or on something holding it.
check_view_call(cx: &Analyzer, at: Span, place: TExpr) -> bool
    if cx.view_borrows.is_empty() then return false

    val key = place_key(cx, place)

    if key.is_none() then return false

    val k = key.unwrap()

    for item in cx.view_borrows
        val holder = local_at(cx, item.0)

        if holder.is_none() then continue

        for r in item.1
            val rk = place_key(cx, r.place)

            if rk.is_none() then continue

            val p = rk.unwrap()

            if k == p || p.starts_with(s"$k/") || k.starts_with(s"$p/")
                refuse_view(cx, at, s"'${holder.unwrap().1.name}' is a view borrowed from " +
                            s"'${r.name}', and this call may write what it is called on — so " +
                            "it could free what the view reads. Make the call before the view " +
                            "is taken, or put the view in a block that closes first", r, true)

                if r.via.is_empty() then return true
            end if

    false
end check_view_call
