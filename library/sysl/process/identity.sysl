module sysl.process
@requires(posix)

import sysl.buf.{Buf, buf}
import sysl.fs.{IoError, from_status}
import sysl.sys.UNSUPPORTED
import sysl.process.sys as psys
import sysl.slices.as_mut_ptr
import sysl.text.from_utf8

// Which user and group the program runs as, and changing them.
//
// **An id is a `u32`, the type `sysl.fs.Meta.owner` and `Meta.group` already have**, so "is this file
// mine" is one comparison, `metadata(p)?.owner == user()`, with nothing converted on either side.
// POSIX's `uid_t` and `gid_t` are 32 bits unsigned on every C library this builds for.
//
// **`user()` and `group()` are the EFFECTIVE ids**: the ones a filesystem checks a permission against
// and makes a new file's owner, which is what a program asking "who am I" is almost always asking. The
// real ids -- who started the program -- are `real_user()` and `real_group()`, and differ only in a
// program that changed who it acts as (set-user-ID, or `set_user`). A target that keeps one user per
// process answers the same number for both.
//
// **A target with no users at all answers as user 0 and group 0.** Its filesystem leaves `Meta.owner`
// zero for the same reason (`sysl.fs.sys.Stat` is zero where a supplier has nothing to say), so
// `Meta.owner == user()` still answers the question the program asked: everything is its own.

/** A `get_id` answer as the id it carries: a negative one is either `UNSUPPORTED`, a target with no
 * users, which is user 0's, or a supplier that broke the contract -- POSIX gives these calls no error
 * at all, so there is no `IoError` to hand back.
 */
private id_answer(answer: i64, which: string) -> u32
    if answer >= 0 then return u32(answer)
    if answer == i64(UNSUPPORTED) then return 0

    panic(s"sysl.process: the 'sysl_proc_get_id' hook failed with $answer asked for the $which")
end id_answer

/** The user the program acts as: the effective user id, the one a filesystem checks a permission
 * against and makes a new file's owner. Compare it with `sysl.fs.Meta.owner` to ask whether a file is
 * the program's own.
 */
user() -> u32 = id_answer(psys.get_id(psys.id_user), "user")

/** The group the program acts as: the effective group id, compared with `sysl.fs.Meta.group`. */
group() -> u32 = id_answer(psys.get_id(psys.id_group), "group")

/** The user who started the program: the real user id. It is `user()` unless the program changed
 * who it acts as -- it is set-user-ID, or it called `set_user`.
 */
real_user() -> u32 = id_answer(psys.get_id(psys.id_real_user), "real user")

/** The group of the user who started the program: the real group id. */
real_group() -> u32 = id_answer(psys.get_id(psys.id_real_group), "real group")

/** This program's process id: the number no other program running beside it has, which is what
 * names a file, a directory or a cache entry this run alone owns. It is POSIX's `getpid`, and what a
 * `Child`'s `pid` is to the program that started it.
 *
 * **A target that keeps no processes answers 0**, as it answers 0 for a user: there is one program, and
 * nothing beside it to be told apart from. So does a supplier that does not know the question.
 */
pid() -> u32
    val answer = psys.get_id(psys.id_process)

    if answer < 0 then 0 else u32(answer)
end pid

/** The program made to act as user `id`, as POSIX's `setuid`. **It is privileged**: a program acting
 * as user 0 becomes `id` for good -- real, effective and saved ids together, so the privilege is
 * given up rather than set aside -- and any other program may only move between the ids it already
 * has. Anything else is `NotPermitted`.
 *
 * A program giving up user 0 for another user calls `set_group` FIRST: once it is no longer user 0
 * it may not change its group either.
 */
set_user(id: u32) -> Result[unit, IoError] = changed(psys.set_id(psys.id_user, id))

/** The program made to act as group `id`, as POSIX's `setgid`, with `set_user`'s rule: a program
 * acting as user 0 may take any group, and any other only one it already has.
 */
set_group(id: u32) -> Result[unit, IoError] = changed(psys.set_id(psys.id_group, id))

private changed(code: int) -> Result[unit, IoError] = if code >= 0 then Ok(()) else Err(from_status(code))

/** The name this machine calls itself, as POSIX's `gethostname`: `"build-7"`, or a fully qualified
 * `"build-7.example.org"`, whichever the host was configured with. It is whatever the host says and
 * is not looked up in any directory, so it need not resolve to an address.
 *
 * **Fails with `InvalidUtf8`** where the host's name is not valid UTF-8, and with the system's own
 * error where the call fails. **A target with no notion of a host name** (`UNSUPPORTED` from its
 * supplier) fails with that error too, rather than inventing one.
 */
hostname() -> Result[string, IoError]
    var raw: []u8 = [0; 256]

    val n = psys.hostname(as_mut_ptr(raw), raw.len)

    if n < 0 then return Err(from_status(int(n)))

    from_utf8(raw[0..<usize(n)]) match
        Ok(s) -> Ok(s)
        Err(e) -> Err(IoError.InvalidUtf8(e.offset))
end hostname

/** The physical memory the machine has, in bytes: macOS's `hw.memsize`, Linux's `sysinfo` total
 * (`totalram` times `mem_unit`). It is what is installed, not what is free.
 *
 * **A target with no way to ask** (`UNSUPPORTED` from its supplier) fails with that error.
 */
total_memory() -> Result[u64, IoError]
    var bytes: u64 = 0

    val code = psys.total_memory(&bytes)

    if code < 0 then Err(from_status(code)) else Ok(bytes)
end total_memory

/** The resident memory of the process `pid`, in bytes: the pages it has in RAM now. macOS reads
 * `pti_resident_size` through `proc_pidinfo`; Linux reads field 2 of `/proc/<pid>/statm` times the
 * page size. `resident_bytes(child.pid())` is a child's, and `resident_bytes(int(pid()))` this program's own.
 *
 * **Fails** for a process that is not there (a reaped child, a number nothing has; `NotFound`), for one
 * the program may not look at (`NotPermitted`), and for a `pid` of zero or less, which names no process.
 * A target with no processes fails with `UNSUPPORTED`'s error.
 */
resident_bytes(pid: int) -> Result[u64, IoError]
    var bytes: u64 = 0

    val code = psys.resident(i64(pid), &bytes)

    // `ESRCH` (3) is how both hosts say "no such process", which is what `NotFound` means here.
    if code == -3 then return Err(IoError.NotFound)

    if code < 0 then Err(from_status(code)) else Ok(bytes)
end resident_bytes

private listed(which: int, id: int) -> Result[Buf[int], IoError]
    if id <= 0 then return Err(IoError.Other(22))

    var found: Buf[int] = buf()
    var room: usize = 64

    loop
        found.reserve(room)

        val n = psys.list(which, i64(id), as_mut_ptr(found.spare()), room)

        if n < 0 then return Err(from_status(int(n)))

        if usize(n) <= room
            found.set_len(usize(n))
            return Ok(found)

        room = usize(n) + 16
    end loop
end listed

/** The live processes whose process group is `pgid`, as pids: macOS's `proc_listpids` with
 * `PROC_PGRP_ONLY`, Linux's `/proc/<n>/stat` scanned for the group field. A child that has exited but
 * has not been waited for yet is still listed, as `ps` lists it; once `wait_pid` has reaped it, it is not.
 *
 * **A group nothing is in, or one that has ended, answers `Ok` with an empty buffer**, and so does a
 * group the program may not see. **A `pgid` of zero or less fails** with `Other(22)` (`EINVAL`). The
 * answer is a snapshot: a process may have exited or started by the time it is read. A target with no
 * processes fails with `UNSUPPORTED`'s error.
 */
group_members(pgid: int) -> Result[Buf[int], IoError] = listed(psys.list_group, pgid)

/** The live processes whose parent is `pid`, as pids, found as `group_members` finds a group's. This
 * program's own children are `children(int(pid()))`, one per `start`, `spawn` or `run` not yet waited
 * for, and not the children's own children.
 *
 * **A parent with no children, or one that is gone, answers `Ok` with an empty buffer.** **A `pid` of zero
 * or less fails** with `Other(22)`. The answer is a snapshot, and a target with no processes fails with
 * `UNSUPPORTED`'s error.
 */
children(pid: int) -> Result[Buf[int], IoError] = listed(psys.list_children, pid)
