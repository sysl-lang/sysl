module sh.sysl.compiler
@tests

import sysl.buf.buf
import sysl.fs.{is_file, make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture
import sysl.testing.skip
import sysl.text.{Search, split}

// The reference's `UnitErrorTests`: `unit` is the language's zero-sized type
// (`reference/types.md § unit and never`), so a field, a parameter, a type argument or a binding of
// it is legal and costs nothing -- the field is skipped, the parameter is dropped from the emitted
// signature, the binding is not a slot -- and so is a `*unit`, a `&unit` or a `weak unit`, whose
// address is non-null and whose loads and stores touch nothing; an array, a slice or a buffer of it
// has a length and no storage; the operations that would have to invent a value (`str`, `==`, a variadic tail) stay refused. `never`
// is untouched throughout: it has no values at all, so it stands only as a result.
//
// **Every output, every diagnostic and every `line:col` here was read out of the reference compiler
// (0.0.156)** by handing the installed `sysl` the same program.

// What a program does: what it printed, and whether it exited zero. A failure to build is its
// message and a non-zero exit.
private uer_outcome(text: string) -> (string, bool)
    val root = make_temp_dir("sysl-uer").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", text).unwrap()

    val exe = s"$root/built"

    build_native_program(root, None, None, DefaultOptimization, Some(exe)) match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return (failure_text(why), false)
        Ok(_) -> ()

    val said = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    said match
        Err(_) -> ("the program that was built could not be run", false)
        Ok(out) -> (out.text + out.err.unwrap_or(""), out.status.ok())
end uer_outcome

// The program runs to the end and prints exactly this. Returns at once without the library.
private uer_prints(text: string, want: string)
    if xvr_no_library() then return

    val out = uer_outcome(text)

    assert(out.1, s"it did not exit zero: ${out.0}")
    assert_eq(out.0, want)
end uer_prints

// What the compiler says about a program, or the text it lowers to where it says nothing.
private uer_emit(text: string) -> (string, bool)
    val root = make_temp_dir("sysl-uer").unwrap()
    val src = s"$root/main.sysl"

    make_dir_all(root).unwrap()
    write_text(src, text).unwrap()

    val out = emit_llvm_text(src, None) match
        Err(why) -> (why.message, false)
        Ok(made) ->
            if !made.report.is_empty() then (analysis_report(made.report), false)
            else (made.text, true)

    remove_dir_all(root).unwrap_or(())
    out
end uer_emit

// The text a program lowers to holds each of these lines.
private uer_ir_has(text: string, wants: []string)
    if xvr_no_library() then return

    val out = uer_emit(text)

    assert(out.1, s"did not compile: ${out.0}")

    for w in wants
        assert(out.0.contains(w), s"no '$w' in:\n${out.0}")
end uer_ir_has

// The program is refused with exactly one complaint: this message, anchored at this `line:col`.
private uer_refused(text: string, message: string, at: string)
    if xvr_no_library() then return

    val out = uer_emit(text)

    assert(!out.1, s"it compiled: ${out.0}")
    assert(out.0.contains(s"error: $message\n"), out.0)
    assert(out.0.contains(s"main.sysl:$at\n"), out.0)
    assert_eq(uer_count(out.0, "error: "), 1, out.0)
end uer_refused

// How many times a piece of text occurs.
private uer_count(said: string, part: string) -> int
    var rest = said
    var n = 0

    loop
        rest.index_of(part) match
            None -> break
            Some(at) ->
                n += 1
                rest = rest[at + part.bytes.len..<rest.bytes.len]

    n
end uer_count

private uer_never() -> string = NeverOnlyResult

private uer_variadic(shown: string) -> string =
    s"a $shown cannot be passed to '...' — a variadic argument must be an integer, a float, a char, " +
    "a raw pointer, or the address of a function"

// -- unit is zero-sized, so it may be held ----------------------------------------------------------

@test("as a variable's type, which takes no slot")
uer_as_a_variable() = uer_prints("var x: unit = ()\nprint((1).to_string())", "1\n")

// The parameter is in the signature the analyzer checks and absent from the one LLVM sees.
@test("as a parameter's type, which the emitted signature then does not mention")
uer_as_a_parameter() =
    uer_ir_has("f(x: unit, n: int) -> int = n\nprint(f((), 2))", ["define i32 @f$$sysl(i32 %n.param)"])

@test("as an extern parameter's type, for the same reason")
uer_as_an_extern_parameter() =
    uer_ir_has("extern e(x: unit, n: int) -> int\nprint(e((), 1))", ["declare i32 @e(i32)"])

// The field is skipped and the ones behind it shift up, which is the whole of the layout rule.
@test("as a struct field's type, skipped in the layout")
uer_as_a_field()
    if xvr_no_library() then return

    val out = uer_emit("struct S\n    a: unit\n    b: int\nvar s = S((), 7)\nprint(s.b)")

    assert(out.1, out.0)
    assert(out.0.contains("%struct.S = type { i32 }"), out.0)
    assert(out.0.contains("extractvalue %struct.S"), out.0)
    assert(!out.0.contains("%struct.S = type { i32, i32 }"), out.0)
end uer_as_a_field

@test("as a variant payload's type")
uer_as_a_payload() =
    uer_prints("enum E\n    V(a: unit, b: int)\nend E\nvar e = V((), 3)\ne match\n    V(a, b) -> print(b.to_string())",
               "3\n")

@test("as a type argument — which is the point of the whole rule")
uer_as_a_type_argument() = uer_prints(raw"""
    f(n: int) -> Result[unit, int]
        if n < 0 then return Err(n)
        Ok(())
    end f
    f(1) match
        Ok(u) -> print("ok")
        Err(e) -> print(e.to_string())
    """, "ok\n")

@test("and '?' chains through one, carrying the failure and yielding nothing on success")
uer_question_mark_chains() = uer_prints(raw"""
    step(n: int) -> Result[unit, int]
        if n < 0 then return Err(n)
        print(n.to_string())
        Ok(())
    end step
    both() -> Result[unit, int]
        step(1)?
        step(-2)?
        step(3)?
        Ok(())
    end both
    both() match
        Ok(u) -> print("ok")
        Err(e) -> print(e.to_string())
    """, "1\n-2\n")

private uer_sink() -> string = raw"""
    trait Sink[T]
        put(self, x: T) -> int
    struct A
        n: int
    impl Sink[unit] for A
        put(self, x: unit) -> int = self.n
    """

@test("as a generic trait's argument")
uer_as_a_trait_argument() = uer_prints(uer_sink() + "var a = A(4)\nprint(a.put(()))\n", "4\n")

// Through a trait object the adapter and the implementation have to agree about which parameters
// exist, and the dropped one is dropped on both sides.
@test("as a trait object's method parameter")
uer_through_an_object() = uer_prints(uer_sink() + "var s: &Sink[unit] = A(9)\nprint(s.put(()))\n", "9\n")

// -- a zero-sized field is skipped wherever a layout is built ---------------------------------------

@test("leaving the fields behind it at the indices they actually occupy")
uer_fields_behind_it() = uer_prints(raw"""
    struct S
        a: int
        b: unit
        c: int
    var s = S(1, (), 2)
    print(s.a.to_string())
    print(s.c.to_string())
    """, "1\n2\n")

@test("including where a reference sits behind it, which the ownership walk has to find")
uer_a_reference_behind_it() = uer_prints(raw"""
    struct Inner
        v: int
    struct S
        a: unit
        b: &Inner
    mk(n: int) -> int
        var s = S((), Inner(n))
        s.b.v
    end mk
    var total = 0
    for i in 0..<1000 do total += mk(i % 3)
    print(total.to_string())
    """, "999\n")

@test("and a written one is assignable, which does nothing at all")
uer_assigned() = uer_prints("struct S\n    a: unit\n    b: int\nvar s = S((), 1)\ns.a = ()\nprint(s.b.to_string())", "1\n")

// Nothing is written, but the walk *to* the place is still owed: it is why the expression was
// written where it was.
@test("while the receiver chain of such an assignment still runs")
uer_receiver_chain_runs() = uer_prints(raw"""
    struct S
        a: unit
        b: int
    side() -> usize
        print("side")
        0
    end side
    var xs = [S((), 1), S((), 2)]
    xs[side()].a = ()
    print(xs[0].b.to_string())
    """, "side\n1\n")

@test("and a struct carrying one still passes by value, both ways")
uer_by_value() = uer_prints(raw"""
    struct S
        a: unit
        b: int
    bump(s: S) -> S = S((), s.b + 1)
    print(bump(S((), 4)).b.to_string())
    """, "5\n")

// -- it is its own zero value ------------------------------------------------------------------------

@test("so a declaration with no initializer is legal")
uer_no_initializer() = uer_prints("var x: unit\nprint((1).to_string())", "1\n")

@test("and a struct does not lose its zero by gaining a field that costs nothing")
uer_struct_keeps_its_zero() = uer_prints("struct S\n    a: unit\n    b: int\nvar s: S\nprint(s.b.to_string())", "0\n")

// -- a struct of nothing but zero-sized fields is still a type ---------------------------------------

@test("with an empty layout")
uer_empty_layout() = uer_ir_has("struct S\n    a: unit\nvar s = S(())\nprint(1)", ["%struct.S = type {  }"])

@test("and an address a reference may point at")
uer_still_addressable() =
    uer_prints("struct S\n    a: unit\nholds(e: &S) -> int = 1\nvar e: &S = S(())\nprint(holds(e).to_string())", "1\n")

// -- a unit value arrives, and occupies nothing ------------------------------------------------------

@test("so binding one is legal and emits no slot")
uer_binding_one() = uer_prints("var x = print(1)\nprint(2)", "1\n2\n")

@test("and so is passing one to a generic parameter")
uer_to_a_generic_parameter() = uer_prints("f[T](x: T) -> int = 1\nprint(f(print(2)))", "2\n1\n")

@test("into a generic struct's field")
uer_into_a_generic_field() = uer_prints("struct Box[T]\n    v: T\nvar b = Box(print(1))\nprint(2)", "1\n2\n")

@test("into a generic variant's payload")
uer_into_a_generic_payload() =
    uer_prints("enum Box[T]\n    Full(v: T)\nend Box\nvar b = Full(print(1))\nprint(2)", "1\n2\n")

// Order is still owed even where nothing is passed: the argument's effect is the reason it was
// written at all.
@test("and an argument's effect happens in the order it was written")
uer_effects_in_order() =
    uer_prints("f(a: unit, n: int, b: unit) -> int = n\nprint(f(print(1), 2, print(3)))", "1\n3\n2\n")

// -- an address of nothing: what Rust gives a zero-sized type ----------------------------------------
//
// A generic that compiles for every `T` compiles at `unit` too, so a `*T` taken of a `T` binding has
// to exist there. Its address is non-null and aligned (a `unit` binding has no slot, so it is the
// address 1; a `unit` field's is its place in the struct), a load through it is `()` and a store
// writes nothing -- each still evaluating the pointer, and the stored value, for their effects.

private val ZsaThrough: string = "through[T](x: T) -> T\n    var v = x\n    val p: *T = &v\n    *p = x\n    *p\n"

@test("a generic body's address of a T, instantiated at unit")
zsa_generic_at_unit() = uer_prints(ZsaThrough + "print(through(()), through(3))", "() 3\n")

@test("and at the other zero-sized types, an empty struct and an empty array")
zsa_generic_at_other_zero_sizes() =
    uer_prints("struct Empty\nend Empty\n" + ZsaThrough +
               "val e: Empty = through(Empty())\nval z: [0]int = []\nprint(through(z).len)", "0\n")

@test("written directly, with a store, a load, and a non-null address")
zsa_direct_pointer() =
    uer_prints("var u = ()\nval p: *unit = &u\n*p = ()\nprint(*p, usize(p) != 0)", "() true\n")

@test("as a parameter, stored through and read back")
zsa_pointer_parameter() =
    uer_prints("touch(p: *unit) -> unit\n    *p = ()\n    *p\n\nvar u = ()\ntouch(&u)\nprint(touch(&u))", "()\n")

// The order is an `int` store's: the value, then the place it goes to.
@test("where the stored value and the pointer each still run, once, in an int store's order")
zsa_effects_still_run() =
    uer_prints("var u = ()\nwhere(p: *unit) -> *unit\n    print(\"p\")\n    p\n\n" +
               "*where(&u) = print(\"v\")\nprint(*where(&u))", "v\np\np\n()\n")

@test("of a unit field, and through a pointer to its struct")
zsa_unit_field() =
    uer_prints("struct S\n    a: unit\n    b: int\nvar s = S((), 7)\nval ps = &s\nval q = &ps.a\n*q = ()\n" +
               "print(*q, ps.a, ps.b, usize(q) != 0)", "() () 7 true\n")

@test("as a generic struct's method handing out its field's address")
zsa_generic_method() =
    uer_prints("struct Cell[T]\n    v: T\n    n: int\nimpl[T] Cell[T]\n    at(*self) -> *T = &self.v\n" +
               "var c = Cell((), 2)\nvar d = Cell(5, 3)\nprint(*c.at(), c.n, *d.at())", "() 2 5\n")

@test("under @no_alloc")
zsa_no_alloc() =
    uer_prints("@no_alloc\nquiet[T](x: T) -> T\n    var v = x\n    val p: *T = &v\n    *p\n\n" +
               "print(quiet(()), quiet(5))", "() 5\n")

// C sees a `*unit` as a `void *`, which may be any non-null pointer it does not read through.
@test("handed to C, which reads zero bytes through it")
zsa_to_c() =
    uer_prints("extern \"memcmp\" memcmp(a: *unit, b: *unit, n: usize) -> i32\n" +
               "struct S\n    a: unit\n    b: int\nvar u = ()\nvar s = S((), 1)\nprint(memcmp(&u, &s.a, 0))", "0\n")

@test("and exported to C as a pointer parameter and result")
zsa_exported() =
    uer_ir_has("@export(\"hand_unit\")\nhand(p: *unit) -> *unit = p\nprint(1)", ["@hand_unit(ptr"])

@test("a counted reference to one, and a weak one, hold a box with an empty payload")
zsa_reference() =
    uer_prints("boxed[T](x: T) -> &T\n    val r: &T = x\n    r\n\nholds(r: &unit) -> int = 1\n" +
               "val r = boxed(())\nval w: weak unit = r\nprint(holds(r), *r, w.get().is_some(), *boxed(5))",
               "1 () true 5\n")

@test("whose box is laid out with an empty payload, never a void one")
zsa_reference_layout() =
    uer_ir_has("val r: &unit = ()\nprint(*r)", ["%arc.unit = type { i64, ptr, i64, {} }"])

@test("but never, which has no values, still has nothing to point at")
zsa_never_refused() =
    uer_refused("f(x: *never) -> int = 1\nprint(1)",
                "'never' is the type of an expression that does not finish, so it can only be a result " +
                "type or a type argument (as in 'Result[T, never]')", "1:7")

private val ZsaNm: string = "/opt/homebrew/opt/llvm/bin/llvm-nm"

// On a 32-bit core with no OS, the address is still a constant and nothing is loaded or stored.
@test("on bare metal, where the address is a constant and nothing else is needed")
zsa_bare_metal()
    if xvr_no_library() then return
    if !is_file(ZsaNm) then skip(s"there is no llvm-nm at $ZsaNm to read the object")

    val t = target_named("thumb-freestanding-softfp").unwrap()
    val cc = find_backend_clang(t) match
        Err(why) ->
            skip(why)
            return
        Ok(found) -> found

    val dir = make_temp_dir("sysl-zsa").unwrap()

    write_text(s"$dir/main.sysl", ZsaThrough + "extern \"sink\" sink(p: *unit) -> i32\n\n@export(\"main\")\n" +
               "entry() -> i32\n    var u = through(())\n    val p = &u\n    *p = ()\n    sink(p) + through(3)\n").unwrap()

    val text = emit_llvm_text(dir, Some("thumb-freestanding-softfp"), DefaultOptimization, buf(), Some(buf())) match
        Err(why) -> s"did not compile: ${failure_text(why)}"
        Ok(e) -> if e.report.is_empty() then e.text else s"did not compile: ${analysis_report(e.report)}"

    assert(!text.starts_with("did not compile"), text)
    assert(!text.contains("load void") && !text.contains("store void"), text)

    val obj = s"$dir/probe.o"

    compile_object(cc, text, obj, t, "2") match
        Err(why) ->
            remove_dir_all(dir).unwrap_or(())
            assert(false, why)
            return
        Ok(_) -> ()

    val listing = capture(ZsaNm, ["-u", obj]).map((o) -> o.text).unwrap_or("llvm-nm could not be run")

    remove_dir_all(dir).unwrap_or(())

    for line in split(listing, "\n")
        val name = line.trim()

        assert(name == "" || name == "U sink" || name == "U memcpy" || name == "U memset", s"left undefined: $listing")
end zsa_bare_metal

// -- what is still refused, and not because of a layout ----------------------------------------------

// An array, a slice or a buffer of `unit` is admitted (`tests_uar_unit_arrays.sysl`); `never`, which
// has no values at all, still cannot be an element.
@test("an array of never")
uer_no_array_of_never() =
    uer_refused("f(a: [4]never) -> int = 1\nprint(1)",
                "'never' is the type of an expression that does not finish, so it can only be a result type " +
                "or a type argument (as in 'Result[T, never]')", "1:9")

@test("assigning one where a value belongs")
uer_no_assigning_one() = uer_refused("var x = 1\nx = print(2)", "cannot assign unit to 'x' of type int", "2:1")

// `unit` implements `Display` and `Eq` (`reference/types.md § unit and never`), so both operands
// still run, in order, and the value itself prints and compares.
@test("making a string of one")
uer_string_of_one() = uer_prints("print(print(1).to_string())", "1\n()\n")

@test("comparing two")
uer_comparing_two() = uer_prints("print(print(1) == print(2))", "1\n2\ntrue\n")

// A C variadic counts what it was handed at run time, so an argument that is not passed would
// silently shift everything after it.
@test("riding a variadic tail")
uer_no_variadic_unit() =
    uer_refused("extern printf(fmt: *u8, ...) -> int\nvar p: *u8 = null\nprint(printf(p, ()))",
                uer_variadic("unit"), "3:17")

// The rule the unit case is one instance of: a tail carries what C reads back from a register, an
// aggregate crosses to a foreign callee only, and everything else is refused by its own name.
@test("a variadic tail takes a register's worth, and an aggregate only to a foreign callee")
uer_variadic_tail_rule()
    val head = "struct P\n    a: int\ntype Small = int within 0..10\nenum C\n    R\n    G\n" +
               "extern printf(fmt: *u8, ...) -> int\nsv(n: int, ...) -> int = n\nvar p: *u8 = null\n" +
               "val s: Small = 3\nval q: &P = P(1)\n"

    uer_refused(head + "print(printf(p, true))", uer_variadic("bool"), "12:17")
    uer_refused(head + "print(printf(p, s))", uer_variadic("Small"), "12:17")
    uer_refused(head + "print(printf(p, G))", uer_variadic("C"), "12:17")
    uer_refused(head + "print(printf(p, q))", uer_variadic("&P"), "12:17")
    uer_refused(head + "print(sv(1, exit(1)))", uer_variadic("never"), "12:13")
    uer_refused(head + "print(sv(1, \"x\"))",
                "a string cannot be passed to a sysl function's '...' — a walk over the tail reads back " +
                "one register at a time and an aggregate is not one, where a foreign callee takes it " +
                "because C says which registers it arrives in", "12:13")
    uer_ir_has(head + "print(printf(p, P(1), \"x\", 'c', u8(1), 1.5f32))", ["call i32 (ptr, ...) @printf"])
end uer_variadic_tail_rule

// -- never is untouched ------------------------------------------------------------------------------

@test("a diverging argument still cannot fix a generic parameter")
uer_never_fixes_no_parameter()
    uer_refused("f[T](x: T) -> int = 1\nprint(f(exit(1)))",
                "cannot pass an expression that never returns as 'x' of 'f'", "2:9")
    uer_refused("struct Box[T]\n    v: T\nvar b = Box(exit(1))",
                "cannot pass an expression that never returns as 'v' of 'Box[never]'", "3:13")
    uer_refused("enum Box[T]\n    Full(v: T)\nend Box\nvar b = Full(exit(1))",
                "cannot pass an expression that never returns as 'v' of 'Full'", "4:14")
end uer_never_fixes_no_parameter

@test("and it still cannot be bound")
uer_never_bound()
    uer_refused("var x = exit(1)", "cannot bind 'x' to an expression that never returns", "1:1")
    uer_refused("f()\n    val y = exit(1)\nf()", "cannot bind 'y' to an expression that never returns", "2:5")
end uer_never_bound

@test("nor be a field, a parameter, or a part of a type argument")
uer_never_only_a_result()
    uer_refused("struct S\n    x: never\nprint(1)", uer_never(), "2:8")
    uer_refused("f(x: never) -> int = 1\nprint(1)", uer_never(), "1:6")
    uer_refused("var o: Option[&never] = None", uer_never(), "1:16")
    uer_refused("g(p: *never) -> int = 1\nprint(1)", uer_never(), "1:7")
    uer_refused("h(x: int, y: never) -> int = 1\nprint(1)", uer_never(), "1:14")
    uer_refused("k(f: &Fn() -> never) -> int = 1\nprint(1)", uer_never(), "1:15")
    uer_refused("f()\n    val y: never = exit(1)\nf()", uer_never(), "2:12")
end uer_never_only_a_result

// Only where the parameter BECAME valueless. A written one still has a layout, and the call is
// simply dead code -- which is what makes a guard clause in argument position legal.
@test("but a written parameter still takes a diverging argument")
uer_written_parameter_takes_never() =
    uer_ir_has("f(x: int) -> int = 1\nprint(f(exit(1)))", ["define i32 @f$$sysl(i32 %x.param)"])

// -- what a result may still be ----------------------------------------------------------------------

@test("a function's")
uer_a_functions_result() = uer_ir_has("f() -> unit = print(1)\nf()", ["define void @f$$sysl()"])

@test("a method's")
uer_a_methods_result() =
    uer_ir_has("struct A\n    n: int\n    bump(self) -> unit = print(self.n)\nvar a = A(1)\na.bump()",
               ["define void @A.bump(%struct.A %self.param)"])

@test("a trait method's, dispatched through an object")
uer_a_trait_methods_result() = uer_ir_has(raw"""
    trait Show
        show(self) -> unit
    struct A
        n: int
    impl Show for A
        show(self) -> unit = print(self.n)
    var s: &Show = A(7)
    s.show()
    """, ["@vt.ref.Show.A"])

@test("an extern's")
uer_an_externs_result() = uer_ir_has("extern e() -> unit\ne()", ["declare void @e()"])

@test("and writing it changes nothing about leaving it off")
uer_written_unit_result_is_the_default()
    if xvr_no_library() then return

    val written = uer_emit("f() -> unit = print(1)\nf()")
    val left_off = uer_emit("f()\n    print(1)\nf()")

    assert(written.1, written.0)
    assert_eq(written.0, left_off.0)
end uer_written_unit_result_is_the_default

// `never` is still every result's to write, including a C function pointer's.
@test("never stands as a result, a C function pointer's included")
uer_never_as_a_result() =
    uer_ir_has("stop() -> never = exit(1)\nvar c: *extern() -> never = null\nif c == null then print(1) else stop()",
               ["define void @stop$$sysl()"])
