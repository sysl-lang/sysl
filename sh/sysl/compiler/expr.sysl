module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.math.bigint.{BigInt, from_int, negate}

// Typing an expression: the dispatcher every form goes through, and the leaves that are answered
// here rather than in a file of their own.
//
// **`expected` is the type the context wants**, used where the expression cannot work out its own
// type arguments -- a bare `null`, a literal's width, a branch whose sibling is the one that knows
// -- and where it decides that a value belongs on the heap. Everything a position *does* to what
// comes back is `expr_coerce.sysl`'s; what a form *is* is here.

// Analyzes an expression at the type its position wants.
//
// **Whether a result list may stand here is taken before anything below runs**, which is what
// confines the permission to one expression: every subexpression is analyzed through this same
// funnel and finds the flag already spent.
type_expr(cx: &Analyzer, e: Expr, expected: Option[Type]) -> TExpr
    val allowed = cx.multi_ok
    val outer = cx.result_chain

    cx.multi_ok = false
    cx.result_chain = cx.result_next
    cx.result_next = false

    val raw = analyze_expected(cx, e, expected)

    cx.result_chain = outer
    unwrap_results(cx, e, raw, allowed)
end type_expr

// The same, with nothing expected.
type_expr_bare(cx: &Analyzer, e: Expr) -> TExpr = type_expr(cx, e, None)

// Analyzes one expression in a place a **result list** may stand. The permission covers this
// expression and nothing inside it.
type_expr_multi(cx: &Analyzer, e: Expr, expected: Option[Type]) -> TExpr
    cx.multi_ok = true

    val t = type_expr(cx, e, expected)

    cx.multi_ok = false
    t
end type_expr_multi

// A function's own result list read where one may stand: the value of a function that declares one,
// or what its `return` hands back. **A parenthesized tuple there is refused**, since it would build
// the carrier a result list says never exists -- the values are written bare. A branch or block the
// value is made of is the value too, so the expression is read with `result_chain` on.
type_results(cx: &Analyzer, e: Expr, expected: Option[Type]) -> TExpr
    *e.kind match
        Tuple(elements) ->
            return cx.err(e.span, s"this function yields ${quantity(elements.len(), "result")} rather " +
                          "than a tuple — write the values without the parentheses")
        _ -> ()

    cx.result_next = true
    type_expr_multi(cx, e, expected)
end type_results

// Whether the position being read is the one place a function's own result list may stand: the
// value of a function that declares one.
wants_results(cx: &Analyzer, expected: Option[Type]) -> bool
    if !cx.ret_is_list || expected.is_none() || cx.ret_ty.is_none() then return false

    type_eq(expected.unwrap(), cx.ret_ty.unwrap())
end wants_results

// A result list unwrapped into the tuple its parts lay out as, so that nothing downstream -- no
// other analysis, no pass, no emitter -- ever holds one.
//
// Where a list is *not* allowed this is the one place that knows it, and it is also the place with
// the whole expression to name.
private unwrap_results(cx: &Analyzer, e: Expr, raw: TExpr, allowed: bool) -> TExpr
    texpr_type(raw) match
        Results(parts) ->
            if !allowed then
                return cx.err(e.span, s"this yields ${quantity(parts.targs.len(), "result")}, and " +
                              "one value is wanted here — a result list is taken apart by a " +
                              "binding or an assignment that names every one of them")

            *raw.kind match
                TCall(name, args, _, _) -> TExpr(raw.span, TCall(name, args, Struct(parts), true))
                _ -> TExpr(raw.span, *raw.kind)
        _ -> raw
end unwrap_results

// A condition, which must be a `bool`. A refusal is anchored at `at`, the form that asks for the
// boolean -- the `if`, the loop, the `&&`, the `!`, the clause or the function a contract belongs
// to -- rather than at the operand, which is where the reference puts it.
analyze_bool(cx: &Analyzer, e: Expr, at: Span) -> TExpr
    val t = type_expr(cx, e, Some(Bool))

    if texpr_type(t) != Bool && texpr_type(t) != Unknown then
        return cx.err(at, s"condition must be bool, got ${type_show(texpr_type(t))}")

    t
end analyze_bool

// What a form *is*, before its position has done anything to it.
analyze_value(cx: &Analyzer, e: Expr, expected: Option[Type]) -> TExpr = *e.kind match
    IntLit(digits, base, suffix) ->
        int_literal(cx, e.span, literal_value(digits, base), suffix, expected)
    FloatLit(text, suffix) -> float_literal(cx, e.span, text, suffix, expected)
    CharLit(cp) -> TExpr(e.span, TIntLit(from_int(long(uint(cp))), Char))
    StrLit(v) -> TExpr(e.span, TStrLit(v))

    // A C callee finds the end by the terminator, so an interior NUL would hide everything written
    // after it. Refused outright rather than silently truncated.
    CStrLit(v) ->
        if has_nul(v) then
            cx.err(e.span, "a C string ends at its first NUL, so it cannot contain one — the " +
                   "bytes after it could never be read")
        else
            TExpr(e.span, TCStrLit(v))

    BoolLit(v) -> TExpr(e.span, TBoolLit(v))
    UnitLit -> TExpr(e.span, TUnitLit)
    NullLit -> null_literal(cx, e.span, expected)

    Ident(name) -> name_expr(cx, e.span, name, expected)

    // A minus and the literal it precedes are one unit for the range check, so a signed type's
    // minimum is writable even though its magnitude overflows the positive range.
    Unary(op, operand) -> unary_expr(cx, e, op, operand, expected)
    PreIncDec(op, operand) -> inc_dec(cx, e.span, op, operand, true)
    PostIncDec(op, operand) -> inc_dec(cx, e.span, op, operand, false)

    Binary(op, l, r) -> binary_expr(cx, e.span, op, l, r, expected)
    Compare(operands, ops) -> compare_expr(cx, e.span, operands, ops)

    Tuple(elements) -> tuple_expr(cx, e.span, elements, expected)

    ArrayLit(elements) -> array_literal(cx, e.span, elements, expected)
    ArrayFill(value, count) -> array_fill(cx, e.span, value, count, expected)
    Index(receiver, index) -> index_expr(cx, e.span, receiver, index, expected)

    Field(receiver, name) -> field_expr(cx, e.span, receiver, name, expected)

    Call(callee, args) -> call_expr(cx, e.span, callee, args, expected)

    TryExpr(inner) -> try_expr(cx, e.span, inner, expected)

    LayoutOf(op, t) -> layout_of(cx, e.span, op, t, expected)
    OffsetOf(t, field) -> offset_of(cx, e.span, t, field, expected)

    Assign(op, target, value) -> assign_expr(cx, e.span, op, target, value)

    // An indented block under a binding's `=`. It is a value block like a branch's, asked the same
    // question by the same context, and its scope closes with it.
    Block(stmts) -> TExpr(e.span, TBlockExpr(type_value_block(cx, stmts, expected, false)))

    IfExpr(cond, then_body, else_body) ->
        if_expr(cx, e.span, cond, then_body, else_body, expected, false)
    MatchExpr(scrut, arms) -> match_expr(cx, e.span, scrut, arms, expected, false)

    While(label, cond, body, else_body) ->
        while_expr(cx, e.span, label, cond, body, else_body, expected, false)
    DoWhile(label, body, cond, else_body) ->
        do_while_expr(cx, e.span, label, body, cond, else_body, expected, false)
    Loop(label, body) -> loop_expr(cx, e.span, label, body, expected)
    For(label, name, iter, body, else_body) ->
        for_expr(cx, e.span, label, name, iter, body, else_body, expected, false)
    CFor(label, init, cond, step, body, else_body) ->
        c_for_expr(cx, e.span, label, init, cond, step, body, else_body, expected, false)
    ConstFor(name, iter, body) -> const_for_expr(cx, e.span, name, iter, body)

    Quantifier(universal, name, iter, pred) ->
        quantifier_expr(cx, e.span, universal, name, iter, pred)

    // `a, b` where a function's result list is what is being produced.
    ResultList(values) -> result_list(cx, e.span, values, expected)

    // An `is` outside a condition. The message names every position rather than the one this
    // happens to be, which is why it lives here and not at the reading of a condition's terms.
    //
    // **The refusal still registers what the pattern binds**, for the rest of the statement: a
    // `print(n)` in the branch the misplaced `is` guards is written against a name that is right
    // there, and reporting it as undefined would be a second cause for one mistake.
    IsPattern(_, patterns, _) ->
        for i in 0..<patterns.len()
            pattern_binds_into(patterns.at(i), &cx.refused_is)

        cx.err(e.span, "'is' tests a pattern in the condition of an 'if' or a 'while', and nowhere " +
               "else — its binding is live from here to the end of the condition and through the " +
               "branch that condition guards, and there is no such branch here. Chain it with " +
               "'&&', or write 'match'")

    // Argument binding replaces every one of these before a call's arguments are looked at, so one
    // arriving here was written where nothing is being called by name -- in an array literal, on the
    // right of an operator, or at a call through something that carries no parameter names.
    NamedArg(name, _) -> cx.err(e.span, named_nowhere(name))
    Spread(_) ->
        cx.err(e.span, "'...' spreads a sequence into a call's arguments, and there is nothing " +
               "being called here")

    // A closure literal, and the closure a trailing block became: a struct of what it captures,
    // whose one member is the body.
    Lambda(params, body, implicit) ->
        closure_expr(cx, e.span, params, body, implicit, expected)
    // **A block is neutral about what it is**: an array of its lines at a collection parameter and a
    // closure over them at a callable one. What decides is the parameter it stands at, which is what
    // the position expects here -- so `column(spacing = 8):` with three views under it is the array
    // literal the older form spelled out, and `each(xs):` with a body under it is the closure.
    BlockArg(body) ->
        if collection_expected(expected) then block_as_array(cx, e.span, body, expected)
        else closure_expr(cx, e.span, buf(), body, true, expected)

    // `base with { bg = 9 }` -- the copy and the writes the reader would otherwise have spelled out.
    WithExpr(base, fields) -> with_expr(cx, e.span, base, fields, expected)

    // `.Error`, `.Circle(5)` -- the forms below with the type's own name left off, resolved against
    // what the context expects (`reference/expressions.md § A leading dot`).
    ImplicitMember(name) -> implicit_member(cx, e.span, name, expected)

    // `T::Attr` -- what a type's own name offers, and `::Id` on an erased value.
    TypeAttr(subject, attr) -> type_attr_expr(cx, e.span, subject, attr)

    // `lo..hi` and `lo..<hi` standing where a value is wanted, which is `sysl.Range[T]`.
    RangeExpr(lo, hi, inclusive) -> range_value(cx, e.span, lo, hi, inclusive)

    Bad -> bad_expr(e.span)

    _ -> cx.err(e.span, deferred_form(e))

// A range **with both ends written** is a value: `sysl.Range[T]`, three fields, built here.
//
// The four positions that read a range as a *form* -- a `for` header, a slice index, a `match`
// pattern and a quantifier -- never reach this arm, because each matches the `RangeExpr` node itself
// and reads the bounds directly. That is what keeps the counted `for` a counter and a comparison
// with no struct, no `Option` a step and no call in it; the value is for every other position.
//
// **An open end stays a form.** `..`, `lo..` and `..hi` mean something in an index and nothing on
// their own -- what an absent bound *is* depends on what is being indexed -- so they keep the
// refusal, which names the one place they are legal rather than all four.
private range_value(cx: &Analyzer, span: Span, lo: Option[Expr], hi: Option[Expr],
                    inclusive: bool) -> TExpr
    if lo.is_none() || hi.is_none() then
        return cx.err(span, "a range with an open end is only allowed in a slice index — as a " +
                      "value it would have to say what the missing bound is, and only the thing " +
                      "being indexed knows that. Write both ends")

    var ends: Buf[Expr] = buf()

    ends.push(lo.unwrap())
    ends.push(hi.unwrap())

    // The same two questions the `for` header asks of its bounds, in the same order and the same
    // words: a range value and a counted loop must not come to disagree about what a range is.
    val ts = analyze_operands(cx, ends, None)
    val tlo = ts.at(0)
    val thi = ts.at(1)

    if disagree(texpr_type(tlo), texpr_type(thi)) then
        cx.fault(span, s"a range needs matching bounds, got ${type_show(texpr_type(tlo))} and " +
                 s"${type_show(texpr_type(thi))}")

    val vty = texpr_type(tlo) match
        Integer(_, _, _) -> texpr_type(tlo)
        Unknown -> Unknown
        other ->
            cx.fault(span, s"a range runs between integer bounds, not ${type_show(other)}")
            Unknown

    if vty == Unknown then return bad_expr(span)

    var targs: Buf[Type] = buf()

    targs.push(vty)

    reinstantiate(cx.an, library_key("Range"), targs) match
        Struct(d) ->
            var fields: Buf[TExpr] = buf()

            fields.push(tlo)
            fields.push(thi)
            fields.push(TExpr(span, TBoolLit(inclusive)))
            TExpr(span, TStructNew(d, fields))
        _ -> bad_expr(span)
end range_value

// `a, b` where a function's result list is what is being produced. It builds the aggregate the
// caller takes apart -- the same one a tuple builds, since a result list is a tuple's layout
// without a tuple's type.
private result_list(cx: &Analyzer, span: Span, values: Buf[Expr],
                    expected: Option[Type]) -> TExpr
    if !cx.ret_is_list then
        return cx.err(span, "several values separated by commas are a function's result list, and " +
                      "this function declares one result — write the values it wants, or declare " +
                      "a result list")

    val want = cx.ret_ty.unwrap_or(Unit)

    underlying(want) match
        Struct(d) ->
            if values.len() != d.targs.len() then
                cx.fault(span, s"this function yields ${quantity(d.targs.len(), "result")}, but " +
                         s"${supplied(values.len(), "value")}")

            var ts: Buf[TExpr] = buf()

            for i in 0..<values.len()
                val w = if i < d.fields.len() then Some(d.fields.at(i).1) else None
                val t = type_expr(cx, values.at(i), w)

                if w.is_some() && disagree(texpr_type(t), w.unwrap()) then
                    cx.fault(values.at(i).span, s"this result is declared " +
                             s"${type_show(w.unwrap())}, but the value is " +
                             s"${type_show(texpr_type(t))}")

                ts.push(t)

            TExpr(span, TStructNew(d, ts))
        _ -> bad_expr(span)
end result_list

// The forms a later stage of the analyzer answers, named so that a partial compiler says which
// stage is missing rather than complaining about the reader's program.
private deferred_form(e: Expr) -> string = *e.kind match
    Lambda(_, _, _) -> "a closure is not typed yet"
    BlockArg(_) -> "a trailing block is not typed yet"
    _ -> "this expression is not typed yet"

private has_nul(s: string) -> bool
    val b = s.bytes

    for i in 0..<b.len
        if b[i] == 0u8 then return true

    false
end has_nul

// `null` takes the `*T` its context expects. The null callback is the same word: several C
// interfaces read one as "there is none, use the default".
private null_literal(cx: &Analyzer, span: Span, expected: Option[Type]) -> TExpr
    if expected.is_none() then
        return cx.err(span, "'null' takes its type from its context, and there is none here")

    val want = expected.unwrap()

    want match
        Ptr(_) -> TExpr(span, TNullLit(want))
        CFn(_, _) -> TExpr(span, TNullLit(want))
        _ -> cx.err(span, s"'null' is a raw pointer, and ${type_show(want)} was expected here")
end null_literal

// -- names ---------------------------------------------------------------------------------------

// Whether `name` is, here, a by-name parameter (`x: -> T`) -- one the body reads by calling it.
reads_by_name(cx: &Analyzer, name: string) -> bool
    val local = cx.lookup(name)

    local.is_some() && holds_string(cx.by_name, local.unwrap().unique)

// What a capture of `name` is built from, read where its closure or nested group is formed. A
// by-name parameter is captured as the callable the call made of its argument, not as one
// evaluation of it: the body that captured it reads it by calling it, once per use, as the body
// around it does.
capture_source(cx: &Analyzer, span: Span, name: string) -> TExpr
    if !reads_by_name(cx, name) then return name_expr(cx, span, name, None)

    val local = cx.lookup(name).unwrap()

    cx.capture_read(local.unique).unwrap_or(TExpr(span, TLoad(local.unique, local.ty)))

// What a bare name reads.
//
// **The order is the reader's**: a name the compiler answers for itself, then `result`, then what
// the scope binds, then a variant, a constant, storage, and an `extern` variable.
name_expr(cx: &Analyzer, span: Span, name: string, expected: Option[Type]) -> TExpr
    // A reserved identifier is the compiler's to answer and no scope is consulted: the shape may
    // not be declared at all, so there is nothing a lookup could find and nothing to shadow one.
    if reserved_shape(name) then return builtin(cx, span, name, expected)

    val local = cx.lookup(name)

    // A nested function is **called** where it is written and is not a value. Its environment is a
    // row of addresses into the frame it was declared in, which is sound exactly because nothing
    // can carry it out of that frame -- and a callable value is a way of carrying it.
    if local.is_none() && cx.nested_of(name).is_some() then
        return cx.err(span, s"'$name' is a nested function, so it is called where it is written " +
                      "rather than passed — its environment is the frame it was declared in, and " +
                      "a callable value is a way of carrying it out. Something that has to be " +
                      s"passed is a closure of its own: 'var $name = x -> …'")

    // A nested function of the frame around this body is a name this body may not reach, and is
    // told so rather than told the name stands for nothing.
    if local.is_none() && holds_string(cx.outer_nested, name) then
        return cx.err(span, s"'$name' is a nested function of the body around this one, which " +
                      "reaches its own nested functions and its own captures and no further — a " +
                      "top-level function is what several bodies share")

    // `result` is a *contextual* keyword: a real binding of that name still shadows it.
    if name == "result" && local.is_none() then
        if cx.ensure_result.is_some() then return TExpr(span, TResult(cx.ensure_result.unwrap()))

        return cx.err(span, "'result' is only meaningful inside an 'ensure' of a value-returning " +
                      "function")

    // A weak reference whose object is gone and one that never had an object are the same state, so
    // the empty weak reference is spelled the way that state reads everywhere else: `None`, the very
    // thing `get()` will hand back for it. Without this the position offers an `Option` no argument
    // settles and the refusal is about a type argument nobody wrote.
    if name == "None" && local.is_none() && expected.is_some()
        expected.unwrap() match
            Weak(_) -> return TExpr(span, TZero(expected.unwrap()))
            _ -> ()

    if local.is_some()
        note_local_reference(cx, span, local.unwrap())

        // A capture is a binding like any other, and what it reaches is the field of the
        // environment its closure was handed rather than a slot of this frame.
        val read = cx.capture_read(local.unwrap().unique)
        val load = read.unwrap_or(TExpr(span, TLoad(local.unwrap().unique, local.unwrap().ty)))

        // A by-name parameter is read by calling it: the argument was made a closure at the call,
        // and each use is one evaluation of it.
        if holds_string(cx.by_name, local.unwrap().unique) then
            return call_member(cx, span, load, "call", buf(), expected)

        return load
    end if

    // A **value parameter**, folded into its use exactly as a declared constant is -- which is what
    // it is, a `const` whose value the instantiation supplied. The substitution holds one for it
    // wherever the body is walked: the real argument at an instantiation, and a zero placeholder
    // during the walk that checks the generic body, where there is no argument yet and the tree
    // built is discarded.
    //
    // **A local of the same name still wins**, which is why the scope was asked first: a parameter
    // is the outermost binding of its name, not the only one.
    val stands_for = const_parameter(cx, span, name, expected)

    if stands_for.is_some() then return stands_for.unwrap()

    // A constant is folded into its use and analyzed as the expression it stands for, at the type
    // it was declared with rather than the one the context asked for. That is what makes it behave
    // like the value it names: `const n: usize = 5` used where an `int` belongs is the same
    // mismatch a `usize` variable would be, not a silent adaptation.
    val ck = lookup_value_key(cx, a_consts(cx), name)

    // A constant another file made file-private is still found by its spelling, so the reader is
    // told it is private rather than handed its value.
    if ck.is_some()
        if !reachable_key(cx.an, ck.unwrap(), cx.scope) then
            return cx.err(span, out_of_reach(cx.an, ck.unwrap()))

        return const_expr(cx, span, ck.unwrap())
    end if

    val c_rivals = ambiguous_value(cx, span, a_consts(cx), name)

    if c_rivals.is_some() then return c_rivals.unwrap()

    // A `val` is the other half of that: nothing is folded, because it is storage. It is refused
    // across a file boundary on the same terms, and so is a module `var`, whether read or written.
    val vk = lookup_value_key(cx, a_vals(cx), name)

    if vk.is_some()
        if !reachable_key(cx.an, vk.unwrap(), cx.scope) then
            return cx.err(span, out_of_reach(cx.an, vk.unwrap()))

        return global_expr(cx, span, vk.unwrap(), a_vals(cx), writable_key(cx, vk.unwrap()))
    end if

    val v_rivals = ambiguous_value(cx, span, a_vals(cx), name)

    if v_rivals.is_some() then return v_rivals.unwrap()

    // An `extern` variable is storage too, and writable: what it names is what the linker supplies,
    // so the storage is not this program's to promise anything about.
    val ek = lookup_value_key(cx, a_extern_vars(cx), name)

    val e_rivals = if ek.is_some() then None else ambiguous_value(cx, span, a_extern_vars(cx), name)

    if e_rivals.is_some() then return e_rivals.unwrap()

    if ek.is_some()
        if !reachable_key(cx.an, ek.unwrap(), cx.scope) then
            return cx.err(span, out_of_reach(cx.an, ek.unwrap()))

        // Storage the linker supplies is **declared** rather than laid down, and only what a body
        // reaches is declared, so the read is what puts the `external global` line in the module.
        // The read names the **C symbol**, not the key: a module's `extern "optind" idx` is the
        // linker's `optind`, which a key like `m.idx` would never find.
        cx.an.uses_extern_var(ek.unwrap())

        val d = a_extern_vars(cx).get(ek.unwrap()).unwrap()

        note_storage_reference(cx, span, d)

        return TExpr(span, TGlobal(extern_var_symbol(d), value_type(cx, d), true))
    end if

    // **A variant this module declares is asked before the function table is.** The tables are read
    // one at a time, and the function table answers for the library as well as for the module -- so
    // asked first it hands `stderr`, a variant the program declared on the screen in front of the
    // reader, to the library's function of that name.
    if own_variant_name(cx, name) then return variant_expr(cx, span, name, expected)

    // A declared function standing where a callable is wanted is one, with nothing captured. It is
    // asked for only where the context says a callable, so a bare function name anywhere else is
    // still the mistake it was. **An `extern` is a declared function too**, and the closure made of
    // one calls it exactly as a program would.
    if names_a_function(cx, name)
        val want = if expected.is_none() then None else callable_signature(cx.an, expected.unwrap())

        if want.is_some() then
            return function_as_callable(cx, span, name, want.unwrap().0, want.unwrap().1)

        // **The name is not undefined**, the declaration being in front of the reader, so what the
        // message owes is the context that is missing rather than a typo to go looking for. Where
        // the position asks for C's function pointer outright, the missing `&` is the whole of the
        // mistake and the two callable forms are dropped from the advice.
        var wants_address = false

        if expected.is_some()
            expected.unwrap() match
                CFn(_, _) -> wants_address = true
                _ -> ()
        end if

        if wants_address
            return cx.err(span, s"'$name' is a function, and what is wanted here is the address " +
                                s"of one — write '&$name'. A bare name is the capture-free " +
                                "closure, which has no address a C interface could call")
        end if

        return cx.err(span, s"'$name' is a function, and a function becomes a value only where a " +
                            "callable is wanted — a bare-arrow parameter, or a '&Fn' where a " +
                            "concrete type is required. Nothing here asks for one; where the " +
                            s"address of code is what is wanted, that is written '&$name'")
    end if

    variant_expr(cx, span, name, expected)
end name_expr

// What a name bound to a value parameter stands for, where it is bound to one.
//
// **A simple enum's argument travels as its tag**, and what the body wants back is the variant -- so
// the name is handed to the ordinary variant path rather than rebuilt here, and everything a written
// `Fast` gets follows from that.
private const_parameter(cx: &Analyzer, span: Span, name: string,
                        expected: Option[Type]) -> Option[TExpr]
    bound_type(cx.subst, name) match
        Some(ConstArg(v, ty)) -> underlying(*ty) match
            Enum(d) ->
                val n = v.to_long().unwrap_or(-1)

                for i in 0..<d.variants.len()
                    if long(d.variants.at(i).tag) == n then
                        return named_variant_expr(cx, span, d.variants.at(i).name, Some(*ty))

                Some(cx.err(span, s"'$name' stands for no variant of ${type_show(*ty)}"))
            Bool -> Some(TExpr(span, TBoolLit(v != from_int(0))))
            Char -> Some(TExpr(span, TIntLit(v, Char)))
            _ -> Some(int_literal(cx, span, v, "", Some(*ty)))
        _ -> None
end const_parameter

private a_consts(cx: &Analyzer) -> &Table[ValueDecl] = cx.an.tables.consts
private a_vals(cx: &Analyzer) -> &Table[ValueDecl] = cx.an.tables.vals
private a_extern_vars(cx: &Analyzer) -> &Table[ValueDecl] = cx.an.tables.extern_vars

// Which declaration a written name reaches in a table of storage, in the terms of the file that
// wrote it -- the same order `lookup_type_key` reads, over a different table.
lookup_value_key(cx: &Analyzer, from: &Table[ValueDecl], name: string) -> Option[string]
    val found = value_key_of(cx, from, name)

    if found.is_some() then depends_on(cx.an, cx.scope, found.unwrap(), span_zero())

    found
end lookup_value_key

private value_key_of(cx: &Analyzer, from: &Table[ValueDecl], name: string) -> Option[string]
    // **A module written before the dot**, which is the value side of what a call already asked.
    // `raw.thing()` resolved and `raw.eof` did not, so a constant declared in a submodule -- which is
    // what every `c const` block in a binding is -- was an undefined name naming the module.
    val qualified = module_qualified_keys(cx, name)

    for i in 0..<qualified.len()
        if from.has(qualified.at(i)) && reachable_key(cx.an, qualified.at(i), cx.scope) then
            return Some(qualified.at(i))

    // This file's own file-private declaration of the spelling comes before the module's plain key,
    // where a sibling file took that one first.
    val here = file_private_key(cx.an, cx.scope.src.name,
                                module_qualify(cx.scope.module_name, name))

    if from.has(here) && reachable_key(cx.an, here, cx.scope) then return Some(here)

    // **The reader's own module beats an import of the same name**, and a name imported by name beats
    // one a wildcard merely offers -- of which two offering the spelling is an ambiguity, not a pick.
    // Each is asked of the innermost level of imports that answers, a block's before the file's.
    val im = answering_imports(cx.an, cx.scope, name, k -> from.has(k))
    val bound = im.name_key(name)

    if bound.is_some() && from.has(bound.unwrap()) then return bound

    if offered_by(cx.an, cx.scope, name, k -> from.has(k)).len() > 1 then return None

    var found: Option[string] = None

    for i in 0..<im.wildcards.len()
        val key = module_qualify(im.wildcards.at(i), name)

        if found.is_none() && from.has(key) && reachable_key(cx.an, key, cx.scope) then
            found = Some(key)

    if found.is_none() && from.has(here) then return Some(here)

    // **A path to a declaration its file made private still names it**, so the reader is told it is
    // private rather than that the module in front of the dot is undefined.
    if found.is_none()
        for i in 0..<qualified.len()
            if from.has(qualified.at(i)) then return Some(qualified.at(i))

    found
end value_key_of

// **Two wildcards offering one spelling in a table of storage refuse the use and name both**, as a
// call's and a type's do, where falling through would report the name as undefined -- which the
// reader has plainly defined twice.
private ambiguous_value(cx: &Analyzer, span: Span, from: &Table[ValueDecl],
                        name: string) -> Option[TExpr]
    val rivals = offered_by(cx.an, cx.scope, name, k -> from.has(k))

    if rivals.len() > 1 then Some(cx.err(span, ambiguous_offer(name, rivals))) else None
end ambiguous_value

// The type a declaration of storage was written at.
value_type(cx: &Analyzer, d: ValueDecl) -> Type =
    if d.typ.is_none() then Unknown
    else resolve_type(cx.an, d.scope, d.typ.unwrap(), no_bindings())

// A use of a constant, with the loop a constant written in terms of itself would make cut.
//
// **The cycle is reported at the DECLARATION and named in the order the walk followed it**, which is
// the same account a cycle between modules gets.
private const_expr(cx: &Analyzer, span: Span, key: string) -> TExpr
    if const_cycle_at(cx, key) then return bad_expr(span)

    cx.an.consts_in_progress.push(key)

    val out = const_value_expr(cx, span, key)

    cx.an.consts_in_progress.truncate(cx.an.consts_in_progress.len() - 1)
    out
end const_expr

// Whether a constant is already being folded, or is one of a loop already found.
//
// **A loop is ONE mistake, told once** -- at the constant the walk closed it on, naming the loop in
// the order it was followed -- and every member of it is remembered with that complaint. A later
// read of any of them, the declaration's own walk included, raises the very same complaint at the
// very same place, which the report keeps once; raising it rather than passing over it is what keeps
// the loop reported when the walk that first found it was one a trial took back. Either way it
// counts as a refusal, so the reader says nothing of its own about a value that is not constant.
const_cycle_at(cx: &Analyzer, key: string) -> bool
    for i in 0..<cx.an.const_cycles.len()
        val known = cx.an.const_cycles.at(i)

        if known.0 == key
            tell_const_cycle(cx.an, known.1, known.2)
            return true
        end if

    if !holds_string(cx.an.consts_in_progress, key) then return false

    val round = const_loop(cx.an, key)
    val message = s"constant '${qualified_name(key)}' is defined in terms of itself: ${loop_from(round, 0)}"

    for i in 0..<round.len()
        cx.an.const_cycles.push((round.at(i), key, message))

    tell_const_cycle(cx.an, key, message)
    true
end const_cycle_at

// The complaint a loop of constants is told with, at the declaration it was closed on.
private tell_const_cycle(a: &Analysis, key: string, message: string)
    val d = a.tables.consts.get(key)

    if d.is_some() then a.fault(d.unwrap().scope, d.unwrap().span, message)

    a.const_refusals += 1
end tell_const_cycle

// The constants the loop is made of, in the order the walk followed them.
private const_loop(a: &Analysis, key: string) -> Buf[string]
    var out: Buf[string] = buf()
    var seen = false

    for i in 0..<a.consts_in_progress.len()
        val at = a.consts_in_progress.at(i)

        if at == key then seen = true

        if seen then out.push(at)

    out
end const_loop

// The same loop read from one of its own names, round to itself.
private loop_from(round: Buf[string], start: usize) -> string
    var out = ""

    for i in 0..<round.len()
        val at = round.at((start + i) % round.len())

        if out != "" then out = out + " \u{2192} "

        out = out + module_show(at)

    s"$out \u{2192} ${module_show(round.at(start))}"
end loop_from

private const_value_expr(cx: &Analyzer, span: Span, key: string) -> TExpr
    val d = a_consts(cx).get(key).unwrap()
    val ty = value_type(cx, d)

    if d.init.is_none() then return TExpr(span, TZero(ty))

    // Read in the declaration's own terms, since that is where its names mean what they meant.
    val inner = analyzer_for(cx.an, d.scope)

    // **A `const` IS ITS VALUE, so a use of one is the value and not the arithmetic that wrote it.**
    // `(1 << 23) - 1` is a way of saying 8388607 that a reader can check, and every use of the name
    // is the number. Where the initializer is something no fold answers -- a struct, an array, a
    // call -- the expression itself is what a use gets, exactly as it was.
    val settled = const_fold(inner, d.init.unwrap())

    if settled.is_some()
        val lit = const_literal(span, settled.unwrap(), ty)

        if lit.is_some() then return lit.unwrap()
    end if

    val folded = type_expr(inner, d.init.unwrap(), Some(ty))

    TExpr(span, *folded.kind)
end const_value_expr

// A settled value as the literal a use of the name reads, where there is a literal form for it.
private const_literal(span: Span, v: Const, ty: Type) -> Option[TExpr] = v match
    ConstInt(n) -> Some(TExpr(span, TIntLit(n, ty)))
    ConstBool(b) -> Some(TExpr(span, TBoolLit(b)))
    ConstStr(s) -> Some(TExpr(span, TStrLit(s)))
    _ -> None

// Whether a name that stands for module storage is one a program may write to.
private writable_key(cx: &Analyzer, key: string) -> bool
    for i in 0..<cx.an.tables.writable.len()
        if cx.an.tables.writable.at(i) == key then return true

    false
end writable_key

private global_expr(cx: &Analyzer, span: Span, key: string, from: &Table[ValueDecl],
                    writable: bool) -> TExpr
    val d = from.get(key).unwrap()

    note_storage_reference(cx, span, d)
    TExpr(span, TGlobal(key, value_type(cx, d), writable))
end global_expr

// A bare name that stands for a variant of an enum, which is the one name form the *expected* type
// helps to find: a bare `None` still means `Option`'s in a module that declares a `None` of its own.
variant_expr(cx: &Analyzer, span: Span, name: string, expected: Option[Type]) -> TExpr
    // **A nullary variant of a generic enum has nothing in it to say which instantiation is meant**,
    // so where the position does not say either, this reports rather than picking one. Reporting is
    // what lets a branch be held over for its sibling: `if c then Some(s) else None` reads the
    // `else` a second time once the `then` has said what the `Option` carries.
    val open = unsettled_variant(cx, name, expected)

    if open.is_some() then
        return cx.err(span, s"cannot infer the type argument '${open.unwrap()}' of '$name' here — " +
                      "annotate the expected type")

    val found = variant_of(cx, name, expected)

    if found.is_none() && refused_is_name(cx, name) then return bad_expr(span)

    if found.is_none() then
        // A generic enum nothing has instantiated yet still declares the name, and a variant of it
        // that carries something is refused for that rather than called undefined.
        if generic_variant_in_reach(cx, name, true) then return carries_data(cx, span, name)

        // A name a block binds is a different mistake from one that stands for nothing, and the
        // difference is what the reader has to fix.
        val early = not_yet_bound(cx, span, name)

        if early.is_some() then return cx.err_whatever_the_types(span, early.unwrap())

        return cx.err_whatever_the_types(span, s"undefined name '${qualified_name(module_qualify(cx.scope.module_name, name))}'")

    val clash = ambiguous_variant(cx, span, name, expected)

    if clash.is_some() then return clash.unwrap()

    val (en, v) = found.unwrap()

    if v.carries then return carries_data(cx, span, name)

    TExpr(span, TEnumNew(en, v, buf()))
end variant_expr

// Whether a name was bound by an `is` refused earlier in the statement being read.
private refused_is_name(cx: &Analyzer, name: string) -> bool
    for i in 0..<cx.refused_is.len()
        if cx.refused_is.at(i) == name then return true

    false
end refused_is_name

// The enum the **position** asked for, where it asked for one that has this variant **and the bare
// name is in scope here as that enum's variant**.
//
// **The expected type RE-POINTS a name and never conjures one**: it says which owner a variant name
// in scope means, and nothing more. Asked instead of whether the name resolves at all, it made a
// variant reachable with no import, and let it beat a name that already meant something else --
// `describe(Segment(1))` constructing a distant enum's variant rather than calling the module's own
// `Segment` function. Reachability is the import system's; ownership is the expected type's.
variant_from_expected(cx: &Analyzer, name: string,
                      expected: Option[Type]) -> Option[(Type, EnumVariant)]
    val found = expected_variant(name, expected)

    if found.is_none() then return None

    found.unwrap().0 match
        Enum(d) -> if variant_in_scope(cx, d.base, name) then found else None
        _ -> None
end variant_from_expected

// Whether a bare variant name reaches the enum `base` from here: the enum is one this file may name,
// and its module is the file's own or one it imports wholesale, or the variant was imported by name.
private variant_in_scope(cx: &Analyzer, base: string, name: string) -> bool
    if !reachable_key(cx.an, base, cx.scope) then return false

    if visible_here(cx, base) then return true

    // A block's own wildcard import offers it as much as the file's does.
    val owner = module_of(base)
    val key = module_qualify(owner, name)
    val im = answering_imports(cx.an, cx.scope, name, k -> k == key)

    for i in 0..<im.wildcards.len()
        if im.wildcards.at(i) == owner then return true

    imported_variant_enum(cx, name) match
        Some(owner) -> owner == base
        None -> false
end variant_in_scope

// A nullary variant of an enum something other than the bare name already chose -- a module or a
// type in front of a dot, or a value parameter's declared enum -- so no import of the name is asked
// for. `None` where that enum has no variant of the name.
named_variant_expr(cx: &Analyzer, span: Span, name: string, en: Option[Type]) -> Option[TExpr]
    val wanted = expected_variant(name, en)

    if wanted.is_none() then return None

    if wanted.unwrap().1.carries then return Some(carries_data(cx, span, name))

    Some(TExpr(span, TEnumNew(wanted.unwrap().0, wanted.unwrap().1, buf())))
end named_variant_expr

// The variant of the expected enum, whether or not a bare name reaches it -- what a DOTTED spelling
// asks (`Shape.Circle`, `.Circle`), where the text in front of the dot is what put the enum in scope.
expected_variant(name: string, expected: Option[Type]) -> Option[(Type, EnumVariant)]
    if expected.is_none() then return None

    val want = repr(expected.unwrap())

    want match
        Enum(d) ->
            val v = d.variant(name)

            if v.is_none() then return None

            Some((want, v.unwrap()))
        _ -> None
end expected_variant

// Whether any enum this compilation has registered carries a variant of this name. A `false` means
// every walk below would come back empty, so a call or a bare name that is no variant at all -- which
// is nearly every one -- pays one lookup rather than a pass over every declared type.
may_name_variant(cx: &Analyzer, name: string) -> bool = cx.an.tables.variant_names.has(name)

// The enum a bare variant name belongs to, preferring the one the position asked for.
variant_of(cx: &Analyzer, name: string, expected: Option[Type]) -> Option[(Type, EnumVariant)]
    val settled = variant_from_expected(cx, name, expected)

    if settled.is_some() then return settled

    if !may_name_variant(cx, name) then return None

    // **A variant imported by name is that enum's**, whatever a wildcard beside it also offers.
    val chosen = imported_variant_enum(cx, name)

    // The first instantiation in registration order whose enum is one the name could mean here --
    // the nearest level's, where the module declares one itself.
    val homes = variant_homes(cx, name)

    if homes.is_empty() then return None

    for i in 0..<cx.an.tables.enum_insts.len()
        val t = cx.an.tables.enum_insts.at(i)

        t match
            Enum(d) ->
                val v = d.variant(name)

                if v.is_some() && (chosen.is_none() || chosen.unwrap() == d.base) &&
                        holds_string(homes, d.base) then
                    return Some((t, v.unwrap()))
            _ -> ()

    None
end variant_of

// The enum whose variant this name was imported as, by name rather than through a wildcard, at the
// innermost level of imports that answers for it.
imported_variant_enum(cx: &Analyzer, name: string) -> Option[string]
    val im = answering_imports(cx.an, cx.scope, name, k -> enum_of_variant(cx.an, k).is_some())
    val bound = im.name_key(name)

    if bound.is_none() then None else enum_of_variant(cx.an, bound.unwrap())
end imported_variant_enum

// The enums a bare variant name could mean, by DECLARATION rather than by instantiation --
// `Option[int]` and `Option[string]` are one answer, since the question is which enum was meant and
// not which of its instantiations, and a generic enum nothing has instantiated yet is an answer too.
// In the order they were declared, which is the order the refusal names them in.
//
// **The name is resolved as any name is: the module's own declarations are nearer than anything it
// reaches**, so an `enum R` declaring `Ok` makes a bare `Ok` its own however many modules it can see
// also declare one. Only a tie at the nearest level is left for the refusal.
variant_homes(cx: &Analyzer, name: string) -> Buf[string]
    var homes: Buf[string] = buf()

    if !may_name_variant(cx, name) then return homes

    var own = false

    for i in 0..<cx.an.tables.types.len()
        val key = cx.an.tables.types.key_at(i)

        cx.an.tables.types.at(i).kind match
            EnumOf(ed) ->
                if declares_variant(ed, name) && reachable_key(cx.an, key, cx.scope) &&
                        visible_here(cx, key) then
                    homes.push(key)

                    if module_of(key) == cx.scope.module_name then own = true
            _ -> ()

    if !own then return homes

    var nearest: Buf[string] = buf()

    for i in 0..<homes.len()
        if module_of(homes.at(i)) == cx.scope.module_name then nearest.push(homes.at(i))

    nearest
end variant_homes

// Whether the module being read declares the name as an enum variant, and declares no function of
// that name itself. A module that declares both is left as it was, so the duplicate is still reported
// as one rather than settled here.
private own_variant_name(cx: &Analyzer, name: string) -> bool
    if !may_name_variant(cx, name) then return false

    val plain = module_qualify(cx.scope.module_name, name)
    val here = file_private_key(cx.an, cx.scope.src.name, plain)

    if !overload_keys(cx.an, here).is_empty() || !overload_keys(cx.an, plain).is_empty() then
        return false

    for i in 0..<cx.an.tables.types.len()
        val key = cx.an.tables.types.key_at(i)

        cx.an.tables.types.at(i).kind match
            EnumOf(ed) ->
                if module_of(key) == cx.scope.module_name && declares_variant(ed, name) &&
                        reachable_key(cx.an, key, cx.scope) then
                    return true
            _ -> ()

    false
end own_variant_name

private declares_variant(ed: EnumDecl, name: string) -> bool
    for i in 0..<ed.variants.len()
        if ed.variants.at(i).name == name then return true

    false
end declares_variant

// `'A'`, then `'A' and 'B'`, then `'A', 'B' and 'C'` -- a series a sentence can carry, with no comma
// before the `and`.
named_series(names: Buf[string]) -> string
    var out = ""

    for i in 0..<names.len()
        if i > 0 then out += if i == names.len() - 1 then " and " else ", "

        out += s"'${qualified_name(names.at(i))}'"

    out
end named_series

// The refusal a bare variant name earns where more than one enum in scope declares it and nothing
// here chose between them. Picking the first registered would make what the line means depend on
// which file happened to name an enum first, which is not something a reader can see.
//
// **Where the rival enums arrived through two wildcards, the refusal names the imports** rather than
// the enums -- the imports are what the reader wrote, and importing one side selectively is the fix.
ambiguous_variant(cx: &Analyzer, span: Span, name: string,
                  expected: Option[Type]) -> Option[TExpr]
    if variant_from_expected(cx, name, expected).is_some() then return None

    if imported_variant_enum(cx, name).is_some() then return None

    val homes = variant_homes(cx, name)

    if homes.len() < 2 then return None

    val offers = offered_by(cx.an, cx.scope, name, k -> enum_of_variant(cx.an, k).is_some())

    if offers.len() > 1 then return Some(cx.err(span, ambiguous_offer(name, offers)))

    Some(cx.err(span, s"'$name' is a variant of ${named_series(homes)}, and nothing here says " +
                s"which — qualify it, as '${qualified_name(homes.at(0))}.$name'"))
end ambiguous_variant

// The type parameter a bare variant name leaves open, where the enum declaring it is generic and
// nothing here settles it.
//
// A nullary variant carries nothing, so unlike `Some(s)` there is no value in it to solve from --
// and reaching for whichever instantiation some other file happened to register first would make
// the answer depend on what the rest of the program does.
private unsettled_variant(cx: &Analyzer, name: string, expected: Option[Type]) -> Option[string]
    if !may_name_variant(cx, name) then return None

    if variant_from_expected(cx, name, expected).is_some() then return None

    for i in 0..<cx.an.tables.types.len()
        val key = cx.an.tables.types.key_at(i)

        cx.an.tables.types.at(i).kind match
            EnumOf(e) ->
                if !e.tparams.is_empty() && reachable_key(cx.an, key, cx.scope) &&
                        visible_here(cx, key)
                    for j in 0..<e.variants.len()
                        if e.variants.at(j).name == name &&
                                e.variants.at(j).fields.is_empty() then
                            return Some(e.tparams.at(0))
            _ -> ()

    None
end unsettled_variant

// Whether a declaration's module is one this file reads names out of without qualifying them.
visible_here(cx: &Analyzer, key: string) -> bool
    val owner = module_of(key)

    if owner == cx.scope.module_name then return true

    for i in 0..<cx.scope.imports.wildcards.len()
        if cx.scope.imports.wildcards.at(i) == owner then return true

    false
end visible_here

// -- what the compiler answers for itself --------------------------------------------------------

// What a reserved identifier stands for, folded into the use as the literal it names.
//
// The file that wrote a call and the package that file belongs to: what a spliced default's
// `__FILE__`, `__LINE__` and `__VERSION__` answer about.
struct CallSite
    src: Source
    pkg: Packaging

// Where a spliced default reports its `__FILE__`, `__LINE__` and `__VERSION__` from: the call site,
// carried down so that a default written in a library names the caller's line and package and not
// its own. A default inside a default keeps the outermost caller.
call_site(cx: &Analyzer) -> Option[CallSite] =
    if cx.here.is_none() then Some(CallSite(cx.scope.src, cx.scope.pkg)) else cx.here

// `__LINE__` and `__COLUMN__` go through `int_literal`, so each takes the integer type its context
// asks for and is range-checked like any other literal.
private builtin(cx: &Analyzer, span: Span, name: string, expected: Option[Type]) -> TExpr
    val at = cx.reported.unwrap_or(span)
    val site = cx.here.unwrap_or(CallSite(cx.scope.src, cx.scope.pkg))
    val src = site.src
    val loc = src.locate(at.start)

    if name == "__FILE__" then return TExpr(span, TStrLit(src.name))

    // **The package of the file that wrote it -- and in a default, of the file that wrote the
    // call**: as `__FILE__` does, a default of `__VERSION__` declared in a library reports the
    // calling package's version, so a library can ask which version of its consumer is running.
    if name == "__VERSION__"
        version_refusal(site.pkg) match
            Some(why) -> return cx.err(span, why)
            None -> return TExpr(span, TStrLit(site.pkg.version))

    if name == "__LINE__" then
        return int_literal(cx, span, from_int(long(loc.line)), "", expected)
    if name == "__COLUMN__" then
        return int_literal(cx, span, from_int(long(loc.col)), "", expected)

    // **Empty outside any body, rather than an error.** A module's storage is filled before any
    // function runs, so there is genuinely no function to name there.
    if name == "__FUNCTION__" then return TExpr(span, TStrLit(cx.func_name))

    // A name of the shape that a binding took anyway was refused where it was bound, and a use of it
    // is that one mistake's consequence rather than a second one.
    if cx.lookup(name).is_some() then return bad_expr(span)

    // The build's own moment, one per compilation, in C's two formats.
    if name == "__DATE__" then return TExpr(span, TStrLit(stamp_date(build_stamp())))
    if name == "__TIME__" then return TExpr(span, TStrLit(stamp_time(build_stamp())))

    cx.err(span, unknown_builtin(name))
end builtin

// The expectation an arithmetic operand inherits: a position wanting a number says which number,
// and one wanting anything else says nothing at all.
//
// **It is a function rather than a written `if`** because an `if ... then ... else` split across
// two lines is `dedent expected` in the compiler this is built by, and the one-line form does not
// fit. The gap is reported; the shape here is the workaround, and it is named so the reader sees a
// rule rather than a contortion.
private numeric_expectation(expected: Option[Type]) -> Option[Type]
    if expected.is_none() then return None

    if computes_numerically(expected.unwrap()) then expected else None
end numeric_expectation

// -- operators -----------------------------------------------------------------------------------

private unary_expr(cx: &Analyzer, e: Expr, op: string, operand: Expr,
                   expected: Option[Type]) -> TExpr
    // A minus and the literal it precedes are one unit for the range check.
    if op == "-" then
        *operand.kind match
            IntLit(digits, base, suffix) ->
                return int_literal(cx, e.span, negate(literal_value(digits, base)), suffix, expected)
            FloatLit(text, suffix) ->
                return float_literal(cx, e.span, s"-$text", suffix, expected)
            _ -> ()

    if op == "!" then return TExpr(e.span, TUnary("!", analyze_bool(cx, operand, e.span), Bool))
    if op == "&"
        // `&f` on a declared function is C's address of it rather than the address of a place.
        val named = names_a_declared_function(cx, operand)

        if named.is_some() then
            return function_address(cx, e.span, named.unwrap(), addressed_type_args(operand),
                                    expected)

        // The sigil in a type is a counted box and the operator is an address; neither is a way of
        // writing the other, and a value read into a box needs no operator at all.
        expected match
            Some(Ref(_, _)) ->
                val box = type_show(expected.unwrap())

                return cx.err(e.span, s"'&' in front of a value takes its address, and the '&' in " +
                              s"$box is a counted box — the two are different things, and an address " +
                              s"is not a way of making a box. Drop the operator: a value read into a " +
                              s"$box is put in one where it stands")
            _ -> ()

        return address_expr(cx, e.span, operand)
    end if
    if op == "*" then return deref_expr(cx, e.span, operand)

    val numeric = numeric_expectation(expected)
    val t = type_expr(cx, operand, numeric)
    val ty = texpr_type(t)

    if ty == Unknown then return t

    if op == "-" || op == "~" then
        val dispatched = prefix_call(cx, e.span, op, t)

        if dispatched.is_some() then return dispatched.unwrap()

    if op == "-" then
        op_subject(ty) match
            Integer(_, signed, _) ->
                if !signed then
                    return cx.err(e.span, s"unary '-' is not defined for the unsigned type " +
                                  s"${type_show(ty)}")

                return produced(TExpr(e.span, TUnary("-", t, unary_type(ty))))
            Floating(_, _) -> return produced(TExpr(e.span, TUnary("-", t, unary_type(ty))))
            _ -> return cx.err(e.span, s"unary '-' is not defined for ${type_show(ty)}")

    if op == "~" then
        op_subject(ty) match
            Integer(_, _, _) -> return produced(TExpr(e.span, TUnary("~", t, unary_type(ty))))
            _ -> return cx.err(e.span, s"unary '~' is not defined for ${type_show(ty)}")

    cx.err(e.span, s"unary '$op' is not supported yet")
end unary_expr

// Address-of yields a *raw* pointer: a place lives in a frame or inside another object, so there is
// no refcount to take a share of.
//
// **A name is asking for THAT thing's address, so it is answered rather than given a copy.**
// Something computed has no address of its own, so one is made for it: the value is written into a
// hidden local of this scope and what comes back is that slot's address.
private address_expr(cx: &Analyzer, span: Span, operand: Expr) -> TExpr
    // A nested function's environment is the frame it was declared in, and an address is a way of
    // carrying it out of that frame -- the same reason the name is not a value either.
    val named = nested_ident(operand)

    if named.is_some() && cx.lookup(named.unwrap()).is_none() &&
            names_a_nested(cx, named.unwrap()) then
        return cx.err(span, s"'${named.unwrap()}' is a nested function, so it has no address to " +
                      "take — what would have to travel beside the address is the frame it reads, " +
                      "and a '*extern' is one word. A top-level function is what has an address")

    val t = type_expr_bare(cx, operand)
    val ty = texpr_type(t)

    if ty == Unknown then return t

    if is_place(t) || named_place(operand) then
        if !is_place(t) then
            return cx.err(span, "'&' needs a variable, a field, an element, or a dereference — " +
                          "something with an address")

        // A `&` is not itself a write, but it hands out an address a write can go through — so the
        // storage still has to be storage this program may write. `require_place` is where both
        // demands are worded, and it is the same demand an assignment target is held to: a `val` is
        // written once, and a string's bytes have no address to write through at all.
        val place = require_place(cx, t, operand, "'&'", false, Some(span))

        // An alias is refused where its type would carry less than the storage does: a pointer into
        // a struct whose invariant reads the field names no such struct, and a pointer into a
        // `@packed` one promises an alignment the offset need not have.
        check_addressable(cx, span, place)

        return TExpr(span, TAddrOf(place, Ptr(place_type(place))))

    // A value nothing occupies has no storage to point at, and a pointer to it could only ever be
    // read through to produce nothing.
    if no_value(ty) then
        return cx.err(span, s"${type_show(ty)} is not a value, so there is nothing to make an " +
                      "address of")

    TExpr(span, TTempAddr(t, Ptr(ty)))
end address_expr

private deref_expr(cx: &Analyzer, span: Span, operand: Expr) -> TExpr
    val t = type_expr_bare(cx, operand)
    val ty = texpr_type(t)

    if ty == Unknown then return t

    val inner = pointee(ty)

    if inner.is_some() then return TExpr(span, TDeref(t, unqualified(inner.unwrap())))

    // A trait object points somewhere, but it has forgotten what is there, so there is no type to
    // read out -- its methods are the whole of what it still offers.
    if erased(ty) then
        return cx.err(span, s"a ${type_show(ty)} has forgotten what it points at, so there is no " +
                      "value to read through it — call one of the trait's methods instead")

    cx.err(span, s"'*' needs a pointer or a reference, not ${type_show(ty)}")
end deref_expr

// `++`/`--` -- a step of one, which the base decides the existence of and a constrained place then
// has to accept: the new value is checked between the addition and the store.
private inc_dec(cx: &Analyzer, span: Span, op: string, target: Expr, pre: bool) -> TExpr
    val place = type_expr_bare(cx, target)
    val ty = texpr_type(place)

    if ty == Unknown then return place

    if !is_place(place) then
        return cx.err(span, s"'$op' needs somewhere to write, and this is a value")

    // A step is a write, so it is held to everything an assignment is: a `val`, a string's bytes and
    // an element of a read-only view each refuse it.
    val before = cx.an.complaints()

    require_place(cx, place, target, s"'$op'", true)

    if cx.an.complaints() > before then return bad_expr(span)

    underlying(ty) match
        // A step is a write of the place, so it owes every invariant the place reaches the re-check a
        // compound assignment owes.
        Integer(_, _, _) ->
            rechecked(cx, span, place, TExpr(span, TIncDec(place, op, pre, ty, constraint_of(ty))))
        _ -> cx.err(span, s"'$op' is not defined for ${type_show(ty)}")
end inc_dec

private binary_expr(cx: &Analyzer, span: Span, op: string, l: Expr, r: Expr,
                    expected: Option[Type]) -> TExpr
    if op == "&&" || op == "||" then
        return TExpr(span, TLogical(op, analyze_bool(cx, l, span), analyze_bool(cx, r, span)))

    var operands: Buf[Expr] = buf()

    operands.push(l)
    operands.push(r)

    val numeric = numeric_expectation(expected)
    val ts = analyze_operands(cx, operands, numeric)
    val tl = ts.at(0)
    val tr = operand_rhs(cx, op, tl, r, ts.at(1))

    if texpr_type(tl) == Unknown || texpr_type(tr) == Unknown then return bad_expr(span)

    val dispatched = operator_call(cx, span, op, tl, tr)

    if dispatched.is_some() then return dispatched.unwrap()

    val ty = arith_type(cx, span, op, texpr_type(tl), texpr_type(tr), r.span)

    if ty == Unknown then return bad_expr(span)

    produced(TExpr(span, TBinary(op, tl, tr, ty)))
end binary_expr

// Each link of the chain is resolved on its own, so a chain reads and behaves exactly as a chain of
// scalars does, sharing each middle operand between the two comparisons that use it.
private compare_expr(cx: &Analyzer, span: Span, operands: Buf[Expr], ops: Buf[string]) -> TExpr
    val ts = analyze_operands(cx, operands, None)

    // A comparison either side of which is a vector is one link and a mask rather than a `bool`, so
    // it is a different node and a different set of rules.
    for i in 0..<ts.len()
        if is_vector(repr(texpr_type(ts.at(i)))) then return vec_compare(cx, span, ts, ops)

    var cmps: Buf[TCmp] = buf()

    for i in 0..<ops.len()
        val op = ops.at(i)
        val a = texpr_type(ts.at(i))
        val b = texpr_type(ts.at(i + 1))

        var dispatch: Option[TDispatch] = None

        if a != Unknown && b != Unknown then dispatch = compare_link(cx, span, op, ts.at(i),
                                                                    ts.at(i + 1))

        // A link a trait supplies had both its operands checked against the trait's own signature
        // where it was resolved; a link the machine performs directly needs them to agree here, and
        // needs the type to have the comparison being asked of it.
        if a != Unknown && b != Unknown && dispatch.is_none() then
            if !type_eq(repr(a), repr(b)) then
                cx.fault(span, s"cannot compare ${type_show(a)} with ${type_show(b)}")
            else
                val equality = op == "==" || op == "!="
                val ok = if equality then is_equatable(a) else is_ordered(a)

                if !ok then cx.fault(span, s"'$op' is not defined for ${type_show(a)}")

        cmps.push(TCmp(op, dispatch))

    TExpr(span, TCompare(ts, cmps))
end compare_expr

// -- the tiering a pair of operands is read in ---------------------------------------------------

// Analyzes operands that must share one type.
//
// **A bare literal has no type of its own, so it takes the type of a non-literal neighbour** --
// which is what lets `n + 1` work for an `n` of any width without the literal needing a suffix, and
// `p == null` work for any `*T`. The operands that have a type are analyzed first precisely so it
// is available to the ones that do not.
analyze_operands(cx: &Analyzer, operands: Buf[Expr], expected: Option[Type]) -> Buf[TExpr]
    var own: Buf[Option[TExpr]] = buf()
    var refused_before = false

    for i in 0..<operands.len()
        val e = operands.at(i)

        if is_literal(e) || typed_by_position(cx, e) then own.push(None)
        else
            val t = attempt_operand(cx, e, expected)

            own.push(t)

            // An operand whose type could not be worked out gives up on the statement where it is
            // read, so an operand after it is not told about -- unless one before it was already
            // refused, whose complaint is made for real below and is the statement's one mistake.
            if t.is_none() then refused_before = true
            else if !refused_before && texpr_type(t.unwrap()) == Unknown then
                cx.an.poison_quietly()

    val settled = firmest(operands, own).or_else(() -> expected)
    var told: Buf[Option[TExpr]] = buf()

    for i in 0..<operands.len()
        val e = operands.at(i)

        if own.at(i).is_some() then told.push(own.at(i))
        else if is_literal(e) then told.push(None)
        else told.push(Some(type_expr(cx, e, settled)))

    val ty = firmest(operands, told).or_else(() -> expected)
    var out: Buf[TExpr] = buf()

    for i in 0..<operands.len()
        told.at(i) match
            Some(t) -> out.push(if ty.is_some() then reread(cx, t, operands.at(i), ty.unwrap()) else t)
            None -> out.push(type_expr(cx, operands.at(i), ty))

    out
end analyze_operands

// One reading of an operand for the TOP TIER, answering nothing where the reading failed.
//
// **Coming back is not the same as succeeding**, and the difference is the whole of why this is not
// `sandboxed_read`. An operand that could not be worked out alone hands back a fallback of `Unknown`
// *and* records why, so a tier keeping the answer and dropping the complaint keeps a reading built
// out of a mistake nobody will ever be told about. `Unknown` agrees with everything, so the reading
// then survives the re-reading below and the operator refuses the pair with `bad_expr` and no
// diagnostic at all.
//
// Answering `None` puts the operand back where it belongs: read again at what its sibling settled,
// which is where a `M.one()` beside an `M[int]` gets the argument its own call could not supply --
// and read again at nothing where the pair settled nothing, so the complaint is made for real.
private attempt_operand(cx: &Analyzer, e: Expr, expected: Option[Type]) -> Option[TExpr]
    val said = cx.an.complaints()
    val mark = cx.an.sandboxed()

    // An operand is never a place a result list may stand, so one is refused here as `type_expr`
    // refuses it -- and the refusal sends the operand back to be read for real.
    val t = unwrap_results(cx, e, analyze_expected(cx, e, expected), false)

    if cx.an.complaints() > said
        cx.an.release(mark)
        cx.an.restore_complaints(said)

        return None
    end if

    cx.an.keep()
    Some(t)
end attempt_operand

// One reading of an operand with everything it said put back, which is what lets the top tier come
// back empty rather than complaining on behalf of a tier that had nothing to offer it.
sandboxed_read(cx: &Analyzer, e: Expr, expected: Option[Type]) -> TExpr
    val mark = cx.an.complaints()
    val t = analyze_expected(cx, e, expected)

    cx.an.restore_complaints(mark)
    t
end sandboxed_read

// A last reading of an expression at the type its position turned out to have, taken only where the
// reading it already has is about to be reported as a mismatch.
//
// **Conditional on the disagreement, unlike the tiers above, and deliberately so.** A re-reading
// that succeeds can only turn a refusal into what the same expression at a *written* type would
// already have been; one that fails changes nothing and leaves the original complaint to whoever
// was going to report it.
reread(cx: &Analyzer, t: TExpr, src: Expr, want: Type) -> TExpr
    if !disagree(texpr_type(t), want) then return t

    val mark = cx.an.complaints()
    val again = analyze_expected(cx, src, Some(want))

    cx.an.restore_complaints(mark)

    if disagree(texpr_type(again), want) then t else again
end reread

// Which of the operands the pair takes its type from: the first that stands on its own, and only
// failing that the first that was read at all.
//
// **An adaptable operand is passed over rather than dropped**, which is the whole of the difference
// between this and taking the head.
private firmest(operands: Buf[Expr], read: Buf[Option[TExpr]]) -> Option[Type]
    var taken: Option[Type] = None
    var any: Option[Type] = None

    for i in 0..<operands.len()
        read.at(i) match
            Some(t) ->
                if any.is_none() then any = Some(repr(texpr_type(t)))

                if taken.is_none() && !adaptable(operands.at(i), t) then
                    taken = Some(repr(texpr_type(t)))
            None -> ()

    val chosen = if taken.is_some() then taken else any

    if chosen.is_none() then return None

    Some(meet_views(chosen.unwrap(), read))
end firmest

// The two views of one slice, met at the read-only one -- the only place a pair of operands has a
// type to settle on that neither of them wrote.
//
// Everywhere else an operand's type is taken as it stands, and it can, because sysl has no
// subtyping among concrete types to widen towards. A `[]T` and a `[]const T` are the exception the
// language already made, so the pair has a meeting point and it is the read-only view: it is the
// one either side converts to, and the one a comparison needs, since comparing reads.
private meet_views(taken: Type, read: Buf[Option[TExpr]]) -> Type
    taken match
        Slice(elem, read_only) ->
            if read_only then return taken

            for i in 0..<read.len()
                read.at(i) match
                    Some(t) -> if type_eq(texpr_type(t), Slice(*elem, true)) then
                                   return Slice(*elem, true)
                    None -> ()

            taken
        _ -> taken
end meet_views

// Whether an expression is one whose type the position it sits in supplies, rather than one it
// carries itself -- the middle tier.
//
// The test is on the spelling, and it is allowed to be, because the middle tier is not a licence to
// skip anything: it moves an operand one place later in the order and hands it the neighbour's type
// as the position's, which is what an expected type is for.
typed_by_position(cx: &Analyzer, e: Expr) -> bool = *e.kind match
    ImplicitMember(_) -> true

    // A **payload-free variant of a generic enum** -- `None` above all. It is not a literal and it
    // is not a load, and falling through both tiers means asking what an `Option` of nothing in
    // particular holds. It belongs here for precisely the reason `.red` does: the form has no type
    // at all until something says which type is wanted, and a sibling is something.
    //
    // **A variant that CARRIES something is deliberately not here.** `Some(3)` knows what it is
    // before anything asks, so it is what the pair takes its type *from*.
    Ident(name) -> payload_free_generic_variant(cx, name)
    Call(callee, args) -> *callee.kind match
        ImplicitMember(_) -> true
        Field(_, name) -> name == "load" && args.len() == 1
        _ -> false
    _ -> false

// Whether a bare name is a variant that carries nothing, of an enum that takes type arguments.
//
// Both halves are needed and each rules out a case that must not be in the tier above. A variant of
// a **non-generic** enum has a type the moment it is named -- `Colour.Red` is a `Colour` -- so it is
// an answer rather than a question. One that **carries** something derives its arguments from what
// it was given, which is what makes `Some(3)` a type its sibling can be read against.
private payload_free_generic_variant(cx: &Analyzer, name: string) -> bool =
    generic_variant_in_reach(cx, name, false)

// Whether a generic enum in reach declares a variant of this name that carries something, or --
// with `carrying` false -- one that carries nothing.
private generic_variant_in_reach(cx: &Analyzer, name: string, carrying: bool) -> bool
    if !may_name_variant(cx, name) then return false

    for i in 0..<cx.an.tables.types.len()
        val key = cx.an.tables.types.key_at(i)

        cx.an.tables.types.at(i).kind match
            EnumOf(d) ->
                if !d.tparams.is_empty() && reachable_key(cx.an, key, cx.scope) &&
                        visible_here(cx, key)
                    for j in 0..<d.variants.len()
                        if d.variants.at(j).name == name &&
                           d.variants.at(j).fields.is_empty() != carrying
                            return true
            _ -> ()

    false
end generic_variant_in_reach

// Whether the position a trailing block stands at is a collection, which is what makes the block an
// array of its lines rather than a closure over them.
//
// **A mode says nothing about which reading is meant**, so `&[]T` and `[]T` answer alike.
private collection_expected(expected: Option[Type]) -> bool
    val want = expected match
        None -> return false
        Some(t) -> t

    inner_of(want) match
        Slice(_, _) -> true
        Array(_, _) -> true
        _ -> false
end collection_expected

private inner_of(t: Type) -> Type = t match
    Ref(inner, _) -> inner_of(*inner)
    Ptr(inner) -> inner_of(*inner)
    Weak(inner) -> inner_of(*inner)
    Volatile(inner) -> inner_of(*inner)
    other -> other

// A trailing block read as the array literal its lines make.
//
// **Every line has to be a value**, which is where the form stops short of Swift's result builders
// and stops short of them deliberately: a binding declares a name rather than producing an element,
// so it has nothing to contribute to a list. A **loop** is refused by name and it is the one refusal
// here that is a choice rather than a consequence -- a loop in sysl *is* an expression, so one
// written here would contribute the single `unit` it evaluates to, which is never what somebody
// writing `for` inside a list of views meant.
private block_as_array(cx: &Analyzer, span: Span, body: Buf[Stmt], expected: Option[Type]) -> TExpr
    var elements: Buf[Expr] = buf()

    for i in 0..<body.len()
        val s = body.at(i)

        *s.kind match
            ExprStmt(inner) ->
                if block_line_is_a_loop(inner)
                    return cx.err(s.span, "a loop inside a trailing block filling a collection " +
                                  "would contribute one element and not one per iteration, so it " +
                                  "is refused rather than read that way — build the elements into " +
                                  "a 'Buf' before the call and pass a view of it")

                elements.push(inner)
            _ ->
                return cx.err(s.span, "every line of a trailing block filling a collection is one " +
                              "of its elements, so it has to be a value — this one declares a name " +
                              "instead. A binding goes outside the block, which is then given what " +
                              "it built")

    type_expr(cx, expr(span, ArrayLit(elements)), expected)
end block_as_array

private block_line_is_a_loop(e: Expr) -> bool = *e.kind match
    For(_, _, _, _, _) -> true
    ConstFor(_, _, _) -> true
    While(_, _, _, _) -> true
    DoWhile(_, _, _, _) -> true
    Loop(_, _) -> true
    CFor(_, _, _, _, _, _) -> true
    _ -> false

// `.Error` -- a member of whatever type the context expects, with the type's own name left off.
//
// **What the position expects is the whole of what resolves it**, which is why the refusal for a
// position that expects nothing is a sentence of its own: a discarded statement, an unannotated
// `var` and an argument of a generic parameter nothing has solved are the ordinary ways to reach it,
// and none of them has a type to look the name up in.
//
// Written with no parentheses it is a variant or a static property; a member that needs a value, or
// an associated function missing its parentheses, is told which it is -- in the words the qualified
// spelling gets, since what the dot leaves off is the type's name and nothing else.
private implicit_member(cx: &Analyzer, span: Span, name: string, expected: Option[Type]) -> TExpr
    if expected.is_none() || expected.unwrap() == Unknown then return nothing_expected(cx, span, name)

    // The dot is what names the enum, so the variant needs no import of its own.
    val wanted = named_variant_expr(cx, span, name, expected)

    if wanted.is_some() then return wanted.unwrap()

    if variant_of(cx, name, expected).is_some() then return variant_expr(cx, span, name, expected)

    val subject = implicit_subject(expected.unwrap())

    subject match
        Trait(_, _, _) -> return nothing_expected(cx, span, name)
        _ -> ()

    val found = member_key(cx.an, subject, name)
    val m = member_at(cx.an, found.0, name)

    if m.is_some()
        val decl = m.unwrap()

        if decl.is_property && decl.is_static
            val read = associated_on(cx, span, subject, name, buf(), expected, no_bound_traits())

            return if read.is_some() then read.unwrap() else bad_expr(span)
        end if

        val receiving = receiving_member(cx, span, found.0, name, decl)

        if receiving.is_some() then return receiving.unwrap()

        val shown = qualified_name(found.0)

        return cx.err(span, s"'$name' is an associated function of '$shown' — call it with " +
                      s"'$shown.$name(…)'")
    end if

    enum_decl_of(cx, subject) match
        Some(base) -> cx.err(span, s"enum '${qualified_name(base)}' has no variant '$name'")
        None -> cx.err(span, s"type '${type_show(subject)}' has no member '$name' — and " +
                       s"'${type_show(subject)}' is a type, not a value")
end implicit_member


enum_decl_of(cx: &Analyzer, t: Type) -> Option[string] = underlying(t) match
    Enum(d) -> Some(d.base)
    _ -> None
