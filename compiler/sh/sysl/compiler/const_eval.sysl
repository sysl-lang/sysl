module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf, ByteSink, byte_sink}
import sysl.container.{Map, map}
import sysl.math.bigint.{BigInt, add, cmp, from_int, negate, sub, to_string,
                         not as big_not, shl as big_shl, shr as big_shr, mul as big_mul,
                         div_rem as big_div_rem}
import sysl.text.{Search, from_utf8_unchecked}
import sysl.fmt.{format_int, format_str, format_fixed, format_real, format_f32, format_f128, format_real_plain,
                 format_f32_plain, format_f128_plain}

// The evaluator: a `const` function run while compiling.
//
// **A call to a `const` function, standing where a constant is wanted, is answered by running the
// function's body here** -- a tree-walking interpreter over the TYPED tree, the same tree the
// lowering reads, so what a body means is settled once, by the analyzer, for both. What each
// operation does is not defined here either: `const_fold.sysl`'s run-time arithmetic is the one
// definition (`run_int_binary`, `run_float_binary`, `run_convert`), read by the typed fold too.
//
// **What it holds is values**: every integer width, every float width -- the two sixteen-bit ones
// rounded to their format at every operation, `f128` computed exactly -- fixed point, `bool`, `char`
// and `unit`, constrained subtypes of them with their checks run; strings; and arrays, vectors,
// structs, enums and slices of all of these. Locals, assignment, every loop, `break`, `continue`, an
// early `return`, recursion, the contract clauses and calls through a function's address are
// evaluated. A form outside that -- a reference, the heap, a call outside the program -- stops the
// run and says so; it never falls back to a guess.
//
// **A trap is a compile error.** Whatever would stop the program at run time -- a division by zero,
// a quotient a width cannot hold, a value a `within` type does not admit, a failed `require` -- stops
// the evaluation, and the constant is refused with what stopped it and the calls it was inside.
//
// **Every run is bounded**: 16,000,000 steps unless `--const-steps` says otherwise, one per expression
// and statement visited, and calls 512 deep. Running out of either is an error naming the constant,
// not a warning.
//
// **The standard module's own constants and storage run under the default whatever the program
// asked for.** Whether a library `val` is laid down as data is the library's answer, made once when
// its artifact is built and kept for every program after -- so a program re-reading the same
// initializer under its own `--const-steps` could only disagree with it, and a disagreement is a
// global the artifact defines as constant that the program then writes at startup. What decides is
// the file the constant was written in, not the files its calls reach: a program's constant calling a
// library function runs under the program's limit.
//
// **A callee's body is typed for the evaluation in a trial that is taken back** -- the reading
// `opaque_body_type` makes of a `some` member's body -- so the main pass types it as it always would,
// once, and nothing the trial registered survives into the program. The typed tree is kept here for
// the rest of the compilation, since a body reads the same way every time it is asked.

private const EvStepDefault: long = 16000000

// How many steps one run of a constant written in `base` may take: the default for the standard
// module's own, and otherwise what `--const-steps` gave, or the default.
private step_limit(base: Scope) -> long =
    if base.src.name.starts_with(s"$StdPrefix/") then EvStepDefault
    else const_steps_flag().unwrap_or(EvStepDefault)

// The limit as a reader writes a large count, its digits grouped in threes.
private step_limit_text(limit: long) -> string
    val digits = limit.to_string()
    var out = ""

    for i in 0..<digits.bytes.len
        if i > 0 && (digits.bytes.len - i) % 3 == 0 then out = out + ","

        out = out + digits[i..<i + 1]

    out
end step_limit_text

// What a run stopped at its limit is told last: how to give it more.
private step_advice() -> string = "; '--const-steps <n>' allows a longer run"

private const EvDepthLimit: usize = 512

// What the evaluator keeps for the whole compilation.
struct ConstEvaluation
    // Whether every declaration has been read. A call folded before then -- one a type is read in
    // terms of -- is run where it can be, or waits for another reading (`const_decl.sysl`).
    ready: bool

    // The bodies typed for evaluation, by the key a call names.
    bodies: Map[string, &TFunc]

    // What a call standing in a constant came to, by where it was written: the value, or the refusal
    // it earned. A constant is folded at every use, and running it again would say nothing new.
    done: Map[string, Option[Const]]
    failed: Map[string, string]

    // The successful runs of each callee, by the call and its arguments.
    memo: Map[string, Option[Const]]

    // Module storage being read, so a value read in terms of itself stops rather than recursing.
    vals_reading: Buf[string]

    // The bodies being typed for an evaluation: one whose typing needs a value that runs it again
    // is a loop, told rather than followed.
    typing: Buf[string]

    // Why the last module `val` initializer run here stopped, where it stopped at something the
    // evaluator does not hold or ran out of steps; empty where it did not.
    last_stop: string

    // That reason for each piece of module storage whose initializer stayed code because of it, by
    // symbol: what a freestanding artifact's refusal of the storage tells its reader.
    val_stops: Map[string, string]

    // What each function nobody marked `const` was found to hold, by name: the reason it cannot run
    // while compiling, or empty where it can (`const_check.sysl`'s `evaluable_refusal`).
    unmarked: Map[string, string]

    // How many folds are under way that only ask whether a value can be had -- a module `val` read
    // from inside a run -- so a call that cannot run says nothing: the run asking is what reports.
    asking: usize

    // The tables a trial made a trait object through -- a closure's `&Fn` among them -- by name, and
    // kept here as the closures' bodies are in `bodies`: the trial that made them is taken back, and
    // a value made then is still called through them.
    vtables: Map[string, TVtable]

    // How far the closure counter has gone in a trial whose closures were kept. A reading thrown away
    // rewinds the counter no lower (`closure_rewind`), so no later closure takes a kept one's name.
    closure_floor: usize

    // What the readings of the declarations settled about the calls they needed a value of, shared
    // by every reading of one compilation (`const_decl.sysl`).
    answers: &DeclAnswers

    // Whether this reading may be followed by another: only a compilation that goes on to type its
    // bodies reads its declarations again for a call it could not run the first time.
    declaring: bool

    // The calls this reading could not run yet, each waiting for the next reading.
    pending: Buf[DeclSite]

    // The files this reading was handed, where the declaration a waiting call is written in is found.
    units: Buf[Program]

    // Whether a run is being watched for the declarations it reads, and the ones it has read.
    watching: bool
    touched: Buf[string]
end ConstEvaluation

// An evaluator that has evaluated nothing.
const_evaluation() -> &ConstEvaluation =
    ConstEvaluation(false, map(), map(), map(), map(), buf(), buf(), "", map(), map(), 0, map(), 0,
                    decl_answers(), false, buf(), buf(), false, buf())

// -- the seams ---------------------------------------------------------------------------------------

// A call in a constant expression, answered by running it where it names a `const` function: what
// `const_fold` asks of a `Call` that is not a conversion. `None` where the call is not one this
// answers for, or where it stopped -- having said why, and counted the refusal, where it was a
// mistake.
//
// **A field read off what a call answers is run the same way**, `primes_below(10).len`: the whole
// expression typed and evaluated, as a method called on the answer already is.
const_call(cx: &Analyzer, e: Expr) -> Option[Const]
    val off_a_call = *e.kind match
        // A call that builds a value -- a struct, a variant, `T::Make(c, p)` -- is run as the value.
        Call(c, _) ->
            val builds = constructs(cx, c)

            if callee_word(c).is_none() && !builds then return None

            builds
        Field(receiver, _, _) ->
            if !mentions_const_call(cx.an, receiver) && !names_descriptor(cx.subst, receiver) then
                return None

            true
        Index(receiver, _, _) ->
            if !mentions_const_call(cx.an, receiver) then return None

            true
        // What a type's make-up answers is a literal once typed (`type_reflect.sysl`), and so is a
        // comparison over it.
        TypeAttr(_, _, _, _) | Compare(_, _) ->
            if !reflects(e) then return None

            true
        // An `if` or a `match` comes to the branch its settled condition chooses, and an `is` is a
        // `match`.
        IfExpr(_, _, _, _) | MatchExpr(_, _) | IsPattern(_, _, _) -> true
        _ -> return None

    const_run(cx, e, off_a_call)
end const_call

// A constant expression the fold does not settle piece by piece, typed and run whole: an enum's
// variant (`Op.Add`, `Op::Make(c, ())`), a comparison of two of them, what `const_call` hands on. It
// is exactly what a `const` function's body may compute, so every place a constant is read -- a value
// argument, an `if const`, a `const`, an array's length -- accepts the same expressions. A typed tree
// that is not a call is run only where `whole` says the expression was admitted as one.
const_run(cx: &Analyzer, e: Expr, whole: bool) -> Option[Const]
    val ev = cx.an.evaluation

    // Before every declaration is read, the call is one a declaration needs the value of.
    if !ev.ready then return declared_value(cx, e)

    val key = call_site_key(cx, e.span)

    // What the reading of the declarations settled is the answer from then on: a type read again
    // while the bodies are must come to the type it came to there.
    val settled = settled_value(cx, key, e.span)

    if settled.is_some() then return settled.unwrap()

    val known = ev.done.get(key)

    if known.is_some() then return known.unwrap()

    val refused = ev.failed.get(key)

    if refused.is_some() && ev.asking > 0 then return None

    if refused.is_some()
        cx.fault(e.span, refused.unwrap())
        cx.an.const_refusals += 1
        return None
    end if

    val typed = typed_call(cx, e, None)

    if typed.is_none() then return None

    *typed.unwrap().kind match
        TCall(name, _, _, _) -> if !runs_while_compiling(cx.an, name) then return None
        _ -> if !whole then return None

    evaluate(cx.an, cx.scope, subject_of(cx.an), typed.unwrap()) match
        // An array is storage, not a constant's value: it is laid down only as a `val`'s data.
        EvValue(Some(ConstArray(_))) -> None
        EvValue(Some(ConstView(_, _, _, _))) -> None
        EvValue(v) ->
            val out = v.map(c -> folded_form(c, texpr_type(typed.unwrap())))

            ev.done.put(key, out)
            out
        EvFail(message, _) ->
            ev.failed.put(key, message)

            if ev.asking > 0 then return None

            cx.fault(e.span, message)
            cx.an.const_refusals += 1
            None
        EvBroken ->
            cx.an.const_refusals += 1
            None
        EvQuiet -> None
end const_run

// The message of an `@assert` whose condition came out false, worked out now -- and only now, so a
// message that could not be computed costs nothing while the condition holds. It is any `string`
// expression the compiler can compute: a literal, an interpolation over constants and what a type
// answers (`T::Name`, `f.name`), a call whose body runs while compiling. It is typed and run whole in
// the assertion's own terms, which inside a generic are the instance's.
//
// `None` where it could not be, having said why at the assertion, in words that say it failed:
// the reader is told both that the condition is false and why its message could not be said.
assert_message(cx: &Analyzer, span: Span, e: Expr) -> Option[string]
    *e.kind match
        StrLit(v) -> return Some(v)
        _ -> ()

    val head = "the message of this failed '@assert'"
    val typed = typed_call(cx, e, None)

    if typed.is_none()
        // The trial took its complaint back; reading it again for real is what tells it.
        val mark = cx.an.complaints()

        type_expr(cx, e, None)

        if cx.an.complaints() == mark then
            cx.fault(span, unworkable_message(head))

        return None
    end if

    val t = typed.unwrap()
    val ty = texpr_type(t)

    if ty != Str
        cx.fault(span, s"$head is of type '${type_show(ty)}', and a message is a 'string' — " +
                 "interpolate the value into one")
        return None
    end if

    evaluate(cx.an, cx.scope, head, t) match
        EvValue(Some(ConstStr(v))) -> Some(v)
        EvFail(message, _) ->
            cx.fault(span, message)
            None
        EvBroken -> None
        _ ->
            cx.fault(span, unworkable_message(head))
            None
end assert_message

// What a call written as a shuffle's list comes to -- `zip_lo_mask[W]()`, typed in a trial and run in
// the shuffle's own terms, so inside a generic it is the instance's list -- with the type it was read
// at. `None` where nothing in it runs while compiling, where the reading complained (taken back, for
// the caller to read again for real), or where it did not come to an array; where running it failed,
// why has been said.
const_lanes_of_call(cx: &Analyzer, e: Expr) -> Option[(Buf[Const], Type)]
    if !mentions_const_call(cx.an, e) then return None

    val typed = typed_call(cx, e, None)

    if typed.is_none() then return None

    evaluate(cx.an, cx.scope, "this shuffle's list", typed.unwrap()) match
        EvValue(Some(ConstArray(xs))) -> Some((xs, texpr_type(typed.unwrap())))
        EvFail(message, _) ->
            cx.fault(e.span, message)
            None
        _ -> None
end const_lanes_of_call

private unworkable_message(head: string) -> string =
    s"$head cannot be computed while compiling — it has to be a 'string' made of constants, what a " +
        "type answers and calls whose bodies run while compiling, and nothing read out of storage " +
        "filled at run time"

// `ADDR.to_be()` written straight into a `const`: one of `sysl.math.ByteOrder`'s members over a value
// that folds. The call is typed in a trial -- the receiver's width is what the reversal is at, and
// only the typed tree knows it -- and folded at the target's order.
const_byte_order(cx: &Analyzer, e: Expr) -> Option[Const]
    val callee = *e.kind match
        Call(c, args) -> if args.is_empty() then c else return None
        _ -> return None

    val op = *callee.kind match
        Field(_, name, _) -> name
        _ -> return None

    if op != "swap_bytes" && op != "to_be" && op != "from_be" && op != "to_le" && op != "from_le"
        return None

    val typed = typed_call(cx, e, None)

    if typed.is_none() then return None

    *typed.unwrap().kind match
        TIntOp(_, _, _, _, _) -> const_fold_typed(typed.unwrap(), fold_machine(cx.an.tables))
        _ -> None
end const_byte_order

// `real.from_bits(0x3fe62e42fefa39ef)` and `x.bits()` written straight into a `const`: typed in a trial,
// for the width only the typed tree knows, and folded where they reach `FloatBits` over a value that
// folds (`float_bits_routine`).
const_float_bits(cx: &Analyzer, e: Expr) -> Option[Const]
    val callee = *e.kind match
        Call(c, _) -> c
        _ -> return None

    val op = *callee.kind match
        Field(_, name, _) -> name
        _ -> return None

    if op != "from_bits" && op != "bits" then return None

    val typed = typed_call(cx, e, None)

    if typed.is_none() then return None

    // The argument is folded rather than the call, so a width the typed fold does not hold a value of
    // -- `f16`, `bf16`, `f128` -- is still reached: its encoding is an integer.
    *typed.unwrap().kind match
        TCall(name, args, _, _) ->
            if !float_bits_routine(name) || args.len() != 1 then return None

            const_fold_typed(args.at(0), fold_machine(cx.an.tables))
                .and_then(c -> float_bits_folded(name, c))
        _ -> None
end const_float_bits

// A float operator written into a constant, typed in a trial and folded at the widths it is written
// at: a `f32` rounded at every step, and a contracted `a * b + c` rounded once exactly where the
// target fuses it (`fp_contract.sysl`). The untyped fold holds every float as a `real` and knows
// neither, so it asks this first and keeps its own answer only where this has none.
const_float_operator(cx: &Analyzer, e: Expr) -> Option[Const] =
    typed_call(cx, e, None).and_then(t -> const_fold_typed(t, fold_machine(cx.an.tables)))

// A float constant whose initializer calls a `const` function, evaluated over the tree typed at the
// constant's own type -- so a `f32` is rounded at every operation, as it would be at run time, rather
// than worked out in `f64` the way the untyped fold works. Says nothing where it stops: the untyped
// fold that `check_const_admits` runs over the same initializer is what reports.
const_float_value(cx: &Analyzer, e: Expr, ty: Type) -> Option[real]
    if !cx.an.evaluation.ready || !mentions_const_call(cx.an, e) then return None

    val typed = typed_call(cx, e, Some(ty))

    if typed.is_none() then return None

    evaluate(cx.an, cx.scope, subject_of(cx.an), typed.unwrap()) match
        EvValue(Some(ConstFloat(f))) -> Some(f)
        _ -> None
end const_float_value

// An expression written with a wrapping or saturating operator (`wrap_sat.sysl`), typed in a trial at
// `ty` and folded at the widths it is written at. The untyped fold's numbers have no width to wrap or
// saturate at, so `const K: u8 = 250 +| 10` is read here, at `u8`, and is 255. `None` where the
// reading complained or the value is not one the typed fold holds.
const_wrap_sat(cx: &Analyzer, e: Expr, ty: Option[Type]) -> Option[Const] =
    typed_call(cx, e, ty).and_then(t -> const_fold_typed(t, fold_machine(cx.an.tables)))

// The same for an `f128` constant, whose value is its encoding: computed at binary128 at every step,
// as the program would compute it, and never through a `real`.
const_quad_value(cx: &Analyzer, e: Expr, ty: Type) -> Option[(u64, u64)]
    if !cx.an.evaluation.ready || !mentions_const_call(cx.an, e) then return None

    val typed = typed_call(cx, e, Some(ty))

    if typed.is_none() then return None

    evaluate(cx.an, cx.scope, subject_of(cx.an), typed.unwrap()) match
        EvValue(Some(ConstQuad(hi, lo))) -> Some((hi, lo))
        _ -> None
end const_quad_value

// A module `val`'s initializer as the literal it comes to, where it calls a `const` function: such a
// value is laid down on every target, the compiler having run the call -- a scalar, or a whole table
// the function fills in a loop. A trap in a `const` function is refused at the initializer. Where the evaluation meets
// something it does not hold, or runs out of steps, the initializer stays code, computed before the
// program's statements, and why is kept in `last_stop` for a target that cannot run that code.
const_val_image(cx: &Analyzer, name: string, init: TExpr) -> Option[TExpr] = const_val_run(cx, name, init) match
    Ok(image) -> image
    Err(_) -> None

// The same, telling a trap -- already refused at the initializer -- from an evaluation that stopped
// at something it does not hold, so a caller trying the parts next does not run, and refuse, the
// same call twice.
//
// **A projection of a constant is run too** -- `Pair(1, 2).a`, `(3, 4).1`, `[10, 20, 30][2]`,
// `"hello"[1..<3]`, a payload a `match` binds -- since a field, an element or a slice of constant data
// is constant data. Where such a run stops at something it does not hold, the initializer is left to
// the parts below exactly as before, with nothing added to say why.
const_val_run(cx: &Analyzer, name: string, init: TExpr) -> Result[Option[TExpr], unit]
    val runs = calls_const_fn(cx.an, init)

    if !runs && !projects(init) then return Ok(None)

    evaluate(cx.an, cx.scope, s"'$name'", init) match
        EvValue(Some(v)) ->
            // What the run made on its heap is frozen into the object file only through a type that
            // says nothing writes it, or as a box the storage holds; anything else stays code,
            // computed when the program starts.
            val refused = boxed_answer_refusal(v, texpr_type(init))

            if refused.is_some()
                if runs then cx.an.evaluation.last_stop = s"'$name' ${refused.unwrap()}"
                return Ok(None)
            end if

            val image = value_literal(init.span, v, texpr_type(init))

            if image.is_some() && payloads_laid(cx.an.tables.layout, image.unwrap()) then return Ok(image)

            if runs
                cx.an.evaluation.last_stop = s"'$name' came to a value holding an enum variant whose " +
                                             "fields have no fixed bit pattern, which is not laid down " +
                                             "as constant data"
            end if

            Ok(None)
        // A trap is refused where the initializer calls a `const` function, which promised to run
        // while compiling, and where it calls nothing at all: an index past the end of a constant
        // array is then as certain as a constant divided by zero. A call to a function nobody marked
        // keeps its meaning: it traps when the program starts, as written.
        EvFail(message, trapped) ->
            if trapped && (calls_marked(cx.an, init) || !calls_anything(init))
                cx.fault(init.span, message)
                return Err(())
            end if

            if runs then cx.an.evaluation.last_stop = message
            Ok(None)
        _ -> Ok(None)
end const_val_run

// A local `const`'s value, run while compiling and made the literal it came to -- or what stopped
// it, empty where that was already reported.
const_local_image(cx: &Analyzer, name: string, init: TExpr) -> Result[TExpr, string]
    val subject = s"'$name'"

    evaluate(cx.an, cx.scope, subject, init) match
        EvValue(Some(v)) ->
            val refused = answer_refusal(v, texpr_type(init))

            if refused.is_some() then return Err(s"$subject ${refused.unwrap()}")

            value_literal(init.span, v, texpr_type(init)) match
                Some(image) -> Ok(image)
                None -> Err(s"$subject came to a value with no form as a literal, so there is nothing " +
                            "for a use of the name to be")
        EvValue(None) -> Ok(TExpr(init.span, TZero(texpr_type(init))))
        EvFail(message, _) -> Err(message)
        EvBroken -> Err("")
        EvQuiet -> Err(s"$subject is a constant, so its value is known while compiling — this one reads " +
                       "something that holds a value only once the program runs. A name bound to such a " +
                       "value is a 'val'")
end const_local_image

// What one use of a program's annotation comes to -- `@rename("id")` read as the construction
// `rename("id")` in the terms of the file that wrote it, run while compiling, and made the literal it
// came to. `None` where it was refused, which has been said at the use.
//
// **The construction is typed in a trial taken back**, as a constant's call is: nothing a use of
// an annotation reaches is reached by the program. Where the trial complained, the construction is
// typed again for real so that the complaint is told -- the arguments a struct's construction would
// refuse are the ones an annotation refuses, in the same words. Where `about` is not empty it is said
// first: a generic annotation's use names the field whose type it was checked against.
annotation_image(cx: &Analyzer, written: string, call: Expr, ty: Type, about: string) -> Option[TExpr]
    val typed = typed_call(cx, call, Some(ty))

    if typed.is_none()
        if about != "" then cx.fault(call.span, about)

        type_expr(cx, call, Some(ty))
        return None
    end if

    val init = typed.unwrap()

    // A generic annotation on a field of a generic declaration is checked at the declaration's own
    // parameters, which hold no value: the use is typed there and run at each instantiation read.
    if mentions_abstract(ty) then return Some(init)

    val stopped = s"what an annotation says is settled while compiling, so '@$written' takes constants — " +
                  "this reads something that holds a value only once the program runs"

    evaluate(cx.an, cx.scope, s"'@$written'", init) match
        EvValue(Some(v)) ->
            val image = if answer_refusal(v, texpr_type(init)).is_some() then None
                        else value_literal(call.span, v, texpr_type(init))

            if image.is_none() then cx.fault(call.span, stopped)

            image
        EvValue(None) -> Some(TExpr(call.span, TZero(ty)))
        EvFail(message, _) ->
            cx.fault(call.span, message)
            None
        EvBroken -> None
        EvQuiet ->
            cx.fault(call.span, stopped)
            None
end annotation_image

// Whether a typed tree calls a function marked `const`.
private calls_marked(a: &Analysis, t: TExpr) -> bool
    var found: Buf[bool] = buf()
    val sink = &found

    walk_texpr(t, expr_walk(true, x -> *x.kind match
        TCall(name, _, _, _) -> if a.tables.const_fns.has(name) then sink.push(true)
        _ -> ()))

    !found.is_empty()
end calls_marked

// Whether a typed tree calls anything, by name, through an address or through a trait object.
private calls_anything(t: TExpr) -> bool
    var found: Buf[bool] = buf()
    val sink = &found

    walk_texpr(t, expr_walk(true, x -> *x.kind match
        TCall(_, _, _, _) | TCallPtr(_, _, _, _) | TVCall(_, _, _, _, _) -> sink.push(true)
        _ -> ()))

    !found.is_empty()
end calls_anything

// Whether a typed tree takes a part of a value -- a field, a tuple's part, an element, a slice, a
// length, or the payload a `match` binds -- which the fold of scalars does not reach, and the
// evaluator does.
private projects(t: TExpr) -> bool
    var found: Buf[bool] = buf()
    val sink = &found

    walk_texpr(t, expr_walk(true, x -> *x.kind match
        TField(_, _, _) | TIndex(_, _, _) | TSlice(_, _, _, _, _) | TLen(_, _) | TMatch(_, _, _) -> sink.push(true)
        _ -> ()))

    !found.is_empty()
end projects

// What a `const` initializer that calls a function owes its reader, where that function cannot run
// while compiling: what in its body stops it. Empty where the initializer is anything else.
const_call_advice(cx: &Analyzer, e: Expr) -> string
    val callee = *e.kind match
        Call(c, _) -> c
        _ -> return ""

    val written = callee_word(callee)

    if written.is_none() then return ""

    val typed = typed_call(cx, e, None)

    if typed.is_none() then return ""

    *typed.unwrap().kind match
        TCall(name, _, _, _) ->
            if !cx.an.tables.funcs.has(name) then return ""

            evaluable_refusal(cx.an, name) match
                Some(why) -> s" — '${written.unwrap()}' ${if why.starts_with("it ") then why[3..] else why}"
                None -> ""
        _ -> ""
end const_call_advice

// -- reading the call --------------------------------------------------------------------------------

// The word a call's callee was written as: `f` or the `f` of `m.f`, with any type arguments written
// after it (`f[int]`, `m.f[A, B]`) set aside -- the same function, its instance named outright. One
// type argument arrives as a subscript, which the typing re-reads (`expr_call.sysl`); a subscript of
// anything but a name is not a callee this reads.
callee_word(callee: Expr) -> Option[string] = *callee.kind match
    Ident(n) -> Some(n)
    Field(_, n, _) -> Some(n)
    TypeArgs(receiver, _, _) -> bare_callee_word(receiver)
    Index(receiver, _, _) -> bare_callee_word(receiver)
    _ -> None

private bare_callee_word(callee: Expr) -> Option[string] = *callee.kind match
    Ident(n) -> Some(n)
    Field(_, n, _) -> Some(n)
    _ -> None

// The name a key was written as: the module and any owning type in front of it dropped, and an
// overload's number after it.
private spelled_word(key: string) -> string
    var end_at = key.bytes.len
    var start: usize = 0

    // An overload's slot is a dot and digits on the end.
    var i = key.bytes.len

    while i > 0 && key.bytes[i - 1] >= u8('0') && key.bytes[i - 1] <= u8('9')
        i -= 1

    if i > 0 && i < key.bytes.len && key.bytes[i - 1] == u8('.') then end_at = i - 1

    for j in 0..<end_at
        val b = key.bytes[j]

        if b == u8('$') || b == u8('.') then start = j + 1

    key[start..<end_at]
end spelled_word

// Whether a call names a function the evaluator may try to run: one with a body, marked or not. An
// `extern` has none here, and a constant that calls one is the fold's to refuse.
//
// **A member of a concrete type is one too** -- `S.new(3)` as much as `G.new(3)` or a free `mk(3)`:
// every member written with a body is filed with where it was declared (`decl_spans`), whether its
// type is generic or not.
private runs_while_compiling(a: &Analysis, name: string) -> bool =
    a.tables.funcs.has(name) || a.tables.members.func_origin.has(name) ||
        a.tables.members.eval_insts.has(name) || a.tables.members.decl_spans.has(name)

// Whether a written expression calls anything anywhere in it -- the cheap question asked before
// anything is typed, so a constant that calls nothing pays nothing.
mentions_const_call(a: &Analysis, e: Expr) -> bool = *e.kind match
    Call(c, args) ->
        if callee_word(c).is_some() then return true

        for arg in args
            if mentions_const_call(a, arg) then return true

        false
    Field(receiver, _, _) -> mentions_const_call(a, receiver)
    Index(receiver, index, _) -> mentions_const_call(a, receiver) || mentions_const_call(a, index)
    TypeAttr(_, attr, _, _) -> reflection_attr(attr)
    Unary(_, operand) -> mentions_const_call(a, operand)
    Binary(_, l, r) -> mentions_const_call(a, l) || mentions_const_call(a, r)
    Compare(operands, _) ->
        for item in operands
            if mentions_const_call(a, item) then return true

        false
    // An `if` or a `match` is run as a call is, whatever its branches hold, and an `is` is a `match`.
    IfExpr(_, _, _, _) | MatchExpr(_, _) | IsPattern(_, _, _) -> true
    _ -> false

// Whether a typed tree has anything in it the evaluator runs rather than the fold settles: a call to
// a `const` function, or a read of a module `val`, whose value is what its own initializer comes to
// where that is constant data. A read of a `val` whose initializer is code -- or one that comes back
// to the storage being worked out -- stops the run, and the initializer stays code.
private calls_const_fn(a: &Analysis, t: TExpr) -> bool
    var found: Buf[bool] = buf()
    val sink = &found

    walk_texpr(t, expr_walk(true, x -> *x.kind match
        TCall(name, _, _, _) -> if runs_while_compiling(a, name) then sink.push(true)
        TGlobal(symbol, _, writable) -> if !writable && a.tables.vals.has(symbol) then sink.push(true)
        _ -> ()))

    !found.is_empty()
end calls_const_fn

// Where a call in a constant was written, with the type arguments it was read under -- the key its
// answer is kept by.
call_site_key(cx: &Analyzer, at: Span) -> string
    // Both ends: a comparison run whole begins where its left operand does, and each has its own
    // answer.
    var out = s"${cx.scope.src.name}:${at.start}-${at.end}"

    for item in cx.subst
        out = out + s";${item.name}=${type_show(item.ty)}"

    out
end call_site_key

// What a message names the evaluation after: the constant being folded, where one is.
private subject_of(a: &Analysis) -> string =
    if a.consts_in_progress.is_empty() then "this value"
    else s"'${qualified_name(a.consts_in_progress.at(a.consts_in_progress.len() - 1))}'"

// A written call typed in the constant's own terms, in a trial taken back: the call is not one the
// program makes, so nothing it reaches is reached. `None` where the reading complained.
private typed_call(cx: &Analyzer, e: Expr, expected: Option[Type]) -> Option[TExpr]
    val a = cx.an
    val inner = analyzer_for(a, cx.scope)

    inner.subst = cx.subst

    val mark = a.complaints()
    val trial = a.sandboxed()
    val queued = a.tables.members.pending.len()
    val tables = a.tables.members.vtables.len()
    val structs = a.tables.struct_insts.len()
    val enums = a.tables.enum_insts.len()
    val constrained = a.tables.constrained_insts.len()
    val closures = a.closure_funcs.len()

    val t = type_expr(inner, e, expected)
    val clean = a.complaints() == mark

    a.release(trial)
    a.restore_complaints(mark)
    keep_made(a, tables, closures)
    rewind_instantiations(a, queued, tables, structs, enums, constrained)
    a.closure_funcs.truncate(closures)

    if !clean then return None

    // A mistake already said where the same text was typed before is not said again, so a reading can
    // come back quiet holding the node a mistake leaves. There is nothing in it to run, and the fold
    // stopped at something that has been said, so it is counted as a refusal.
    if holds_mistake(t)
        a.const_refusals += 1
        return None
    end if

    Some(t)
end typed_call

// Whether a typed tree holds the node a reading leaves where it complained (`bad_expr`).
private holds_mistake(t: TExpr) -> bool
    var found: Buf[bool] = buf()
    val sink = &found

    walk_texpr(t, expr_walk(true, x -> *x.kind match
        TZero(Unknown) -> sink.push(true)
        _ -> ()))

    !found.is_empty()
end holds_mistake

// The closures' bodies and the tables a trial made, kept for the values made from them, which the
// run may still call once the trial is taken back.
private keep_made(a: &Analysis, tables: usize, closures: usize)
    val ev = a.evaluation
    val vts = a.tables.members.vtables

    for i in tables..<vts.len()
        ev.vtables.put(vts.key_at(i), vts.at(i))

    for i in closures..<a.closure_funcs.len()
        val f: &TFunc = a.closure_funcs.at(i)

        ev.bodies.put(f.name, f)

    if a.closure_count > ev.closure_floor then ev.closure_floor = a.closure_count
end keep_made

// Where a reading thrown away puts the closure counter back to: where it stood when the reading
// began, but never below a name an evaluation kept.
closure_rewind(a: &Analysis, to: usize) -> usize =
    if to < a.evaluation.closure_floor then a.evaluation.closure_floor else to

// A module `val`'s own initializer, typed at the storage's type as the program types it, for another
// initializer that names the `val` (`analyze_body.sysl`'s `static_image`). `None` for storage with no
// initializer, and for per-thread and per-core storage, whose value is a different one on every
// thread or core.
val_init_typed(cx: &Analyzer, symbol: string, ty: Type) -> Option[TExpr]
    val d = cx.an.tables.vals.get(symbol)

    if d.is_none() || d.unwrap().init.is_none() then return None

    val decl = d.unwrap()

    if decl.thread_local || decl.per_cpu then return None

    typed_call(analyzer_for(cx.an, decl.scope), decl.init.unwrap(), Some(ty))
end val_init_typed

// A callee's body, typed in a trial that is taken back (see the file's header). `None` where it has
// no body here or the reading complained -- the main pass reads it again and says so there.
private trial_body(a: &Analysis, name: string) -> Option[TFunc]
    if a.evaluation.watching then a.evaluation.touched.push(callee_origin(a, name))

    val mark = a.complaints()
    val trial = a.sandboxed()
    val queued = a.tables.members.pending.len()
    val tables = a.tables.members.vtables.len()
    val structs = a.tables.struct_insts.len()
    val enums = a.tables.enum_insts.len()
    val constrained = a.tables.constrained_insts.len()
    val closures = a.closure_funcs.len()
    val covers = a.tables.body_covers.len()
    var typed: Option[TFunc] = None
    val f = a.tables.funcs.get(name)
    val inst = a.tables.members.eval_insts.get(name)

    if f.is_some()
        val d = f.unwrap()

        typed = Some(analyze_body(a, d.scope, d.span, with_call_bounds(d.decl), name))
    else if inst.is_some()
        // An instantiation of a generic function, read at the terms it was made at. Its
        // signature is filed again for the reading, since the trial that asked for it took it back.
        val (job, sig) = inst.unwrap()
        val filed = a.tables.members.func_insts.has(name)
        val cx = analyzer_for(a, job.scope)

        if !filed then a.tables.members.func_insts.put(name, sig)

        cx.subst = job.subst
        typed = Some(analyze_instance_in(a, cx, name, job.decl))

        if !filed then a.tables.members.func_insts.remove(name)
    else
        val lowered = a.tables.members.lowered

        for item in lowered
            if typed.is_none() && item.name == name then
                typed = Some(analyze_instance(a, name, item))

        // A closure the program's own reading lowered: its body is already typed.
        for item in a.closure_funcs
            if typed.is_none() && item.name == name then typed = Some(item)
    end if

    val clean = a.complaints() == mark

    a.release(trial)
    a.restore_complaints(mark)
    keep_made(a, tables, closures)
    rewind_instantiations(a, queued, tables, structs, enums, constrained)
    a.closure_funcs.truncate(closures)
    a.tables.body_covers.truncate(covers)

    if clean then typed else None
end trial_body

// -- the run -----------------------------------------------------------------------------------------

// How an evaluation ended.
enum EvOutcome
    // It came to a value, or to nothing for a `unit`.
    EvValue(value: Option[Const])

    // It stopped, and this is the whole of what to say: a trap where `trapped` is set, and otherwise
    // a form the evaluator does not hold.
    EvFail(message: string, trapped: bool)

    // A body it needed did not read cleanly, which the reading of that body reports.
    EvBroken

    // It met a value that is not constant -- module storage filled at run time, an argument read
    // out of a variable -- which is the reader's to report in its own words.
    EvQuiet
end EvOutcome

// What one step of the walk comes to: a value, nothing, or control leaving the step.
private enum Flow
    EvGave(value: Const)
    EvNone
    EvBreak(depth: int, value: Option[Const])
    EvContinue(depth: int)
    EvReturn(value: Option[Const])
    EvStop
end Flow

// How a run stopped.
private enum EvStopKind
    EvRunning
    EvTrap
    EvForm
    EvLimit
    EvBodyBroken
    EvNotConstant
end EvStopKind

// One call being run.
private struct EvFrame
    func: string
    shown: string
    call: Span
    caller: Scope
    home: Scope
    // Each local's cell: a buffer of one value, so a pointer to the local is a pointer into it.
    locals: Map[string, Buf[Const]]
    olds: Buf[Const]
    result: Option[Const]
    slots: Map[string, Const]
end EvFrame

// One evaluation.
private struct EvRun
    a: &Analysis
    subject: string
    base: Scope
    steps: long
    // How many steps this run may take (`step_limit`).
    limit: long
    frames: Buf[&EvFrame]
    loops: Buf[(Scope, Span)]
    kind: EvStopKind
    message: string
    // The buffers the renderings in progress are gathered into, innermost last (`ConstWriter`).
    writers: Buf[ByteSink]
end EvRun

// Runs one typed expression standing in a constant: `subject` is what a refusal names, `base` the
// file it was written in.
private evaluate(a: &Analysis, base: Scope, subject: string, t: TExpr) -> EvOutcome
    val r: &EvRun = EvRun(a, subject, base, 0, step_limit(base), buf(), buf(), EvRunning, "", buf())

    // The expression itself is read in a frame of its own, which names no call: what it binds -- a
    // pattern in a `match` -- lands there.
    r.frames.push(EvFrame("", "", t.span, base, base, map(), buf(), None, map()))

    val f = eval(r, t)

    f match
        EvGave(v) -> return EvValue(Some(v))
        EvNone -> return EvValue(None)
        _ -> ()

    r.kind match
        EvTrap -> EvFail(s"$subject traps while it is being compiled: ${r.message}", true)
        EvForm -> EvFail(s"$subject cannot be computed while compiling: ${r.message}", false)
        EvLimit -> EvFail(r.message, false)
        EvBodyBroken -> EvBroken
        _ -> EvQuiet
end evaluate

// The file a node of the current body was written in.
private here(r: &EvRun) -> Scope = r.frames.at(r.frames.len() - 1).home

// The call being run, where one is: the outermost frame is the expression's own.
private running(r: &EvRun) -> &EvFrame = r.frames.at(r.frames.len() - 1)

// A place in a file, as a reader finds it: the file's own name, the line and the column.
@noinline
private place_text(s: Scope, at: Span) -> string
    val name = s.src.name
    var start: usize = 0

    for i in 0..<name.bytes.len
        if name.bytes[i] == u8('/') then start = i + 1

    s"${name[start..<name.bytes.len]}:${s.src.locate(at.start)}"
end place_text

// The calls the run was inside, innermost first. A deep stack is told by its three innermost calls
// and its outermost one, with how many were left out between.
@noinline
private stack_text(r: &EvRun) -> string
    var out = ""
    val calls = r.frames.len() - 1
    var i = r.frames.len()

    while i > 1
        i -= 1

        val depth = r.frames.len() - 1 - i

        if calls > 5 && depth == 3 then out = out + s"; … ${calls - 4} more calls"

        if calls <= 5 || depth < 3 || i == 1
            val f = r.frames.at(i)

            out = out + (if out == "" then " — inside" else "; inside") +
                  s" '${f.shown}', called at ${place_text(f.caller, f.call)}"
        end if

    out
end stack_text

// Stops the run at a trap: what stopped it and where, then the calls it was inside.
@noinline
private trap(r: &EvRun, at: Span, why: string) -> Flow
    if r.kind == EvRunning
        r.kind = EvTrap
        r.message = s"$why (${place_text(here(r), at)})${stack_text(r)}"
    end if

    EvStop
end trap

// Stops the run at something it does not hold.
@noinline
private refuse_form(r: &EvRun, at: Span, why: string) -> Flow
    if r.kind == EvRunning
        r.kind = EvForm
        r.message = s"$why (${place_text(here(r), at)})${stack_text(r)}"
    end if

    EvStop
end refuse_form

// Stops the run at a value that is not constant.
private not_constant(r: &EvRun) -> Flow
    if r.kind == EvRunning then r.kind = EvNotConstant

    EvStop
end not_constant

// Counts one step, and stops the run where it has used them all.
private tick(r: &EvRun) -> bool
    r.steps += 1

    if r.steps <= r.limit then return true

    out_of_steps(r)

    false
end tick

// Stops the run that has used every step, naming what was still running.
@noinline
private out_of_steps(r: &EvRun)
    if r.kind == EvRunning
        r.kind = EvLimit

        var still = "it was still running"

        if r.frames.len() > 1 then still = s"'${running(r).shown}' was still running"

        if !r.loops.is_empty()
            val l = r.loops.at(r.loops.len() - 1)

            still = s"the loop at ${place_text(l.0, l.1)} was still running"

        r.message = s"${r.subject} did not finish within ${step_limit_text(r.limit)} steps while compiling — $still" +
                    step_advice()
    end if
end out_of_steps

// -- values -----------------------------------------------------------------------------------------

// Why a value of this type is not one the evaluator holds, or nothing where it is.
private unheld(t: Type) -> Option[string] = t match
    Constrained(d) -> unheld(d.base)
    Integer(_, _, _) -> None
    Floating(_, _) -> None
    Fixed(_, _, _) -> None
    Array(_, elem) -> unheld(*elem)
    Struct(d) ->
        if d.opaque then Some(s"an opaque '${d.name()}' is not evaluated while compiling") else unheld_fields(d.fields)
    Enum(d) ->
        for v in d.variants
            val why = unheld_fields(v.fields)

            if why.is_some() then return why

        None
    Bool -> None
    Char -> None
    Unit -> None
    Never -> None
    Unknown -> None
    Str -> None
    Slice(elem, _) -> unheld(*elem)
    Vector(_, elem) -> unheld(*elem)
    // The writer a rendering hands its `display` (`ConstWriter`), and an address the linker fills
    // in (`ConstLink`): held and handed on, never read through.
    Ptr(_) -> None
    CFn(_, _) -> None
    // A reference to storage the evaluation owns (`ConstPtr`), or a trait object (`ConstErased`).
    Ref(_, _) -> None
    _ -> unheld_other(t)

private unheld_other(t: Type) -> Option[string] =
    Some(s"a '${type_show(t)}' is not evaluated while compiling yet — integers, floats, " +
              "fixed-point, 'bool', 'char', strings, and fixed arrays, vectors, structs, enums and slices " +
              "of them are")

// The first field whose type the evaluation does not hold, as `unheld` says it.
private unheld_fields(fields: Buf[(string, Type)]) -> Option[string]
    for f in fields
        val why = unheld(f.1)

        if why.is_some() then return why

    None

// A value as a reader writes it, in a call shown in a message. An array shows its first few elements.
private value_text(v: Const, t: Type) -> string = v match
    ConstInt(n) -> underlying(t) match
        Char -> s"'${char(u32(n.to_long().unwrap_or(0)))}'"
        Fixed(_, frac, _) -> fixed_text(n, frac)
        _ -> to_string(n)
    ConstFloat(f) -> real_text(f)
    ConstQuad(hi, lo) -> quad_text((hi, lo))
    ConstBool(b) -> if b then "true" else "false"
    ConstChar(c) -> s"'$c'"
    ConstStr(s) -> s"\"$s\""
    ConstArray(xs) -> array_text(xs, element_type(t))
    ConstRecord(variant, fields) -> record_text(variant, fields, t)
    ConstView(xs, lo, n, _) -> array_text(viewed(xs, lo, n), element_type(t))
    ConstWriter(_) -> "a writer"
    ConstLink(image) -> *image.kind match
        TNullLit(_) -> "null"
        _ -> s"&${link_key(image)}"
    ConstPtr(xs, at, _) -> s"&${value_text(xs.at(at), pointee(t).unwrap_or(Unknown))}"
    ConstUnset -> "nothing"
    ConstPun(addr, as_was) -> value_text(*addr, *as_was)
    ConstErased(_, _) -> s"a '${type_show(t)}'"

// The elements a slice sees, as a buffer of their own.
private viewed(xs: Buf[Const], lo: usize, n: usize) -> Buf[Const]
    var out: Buf[Const] = buf()

    for i in 0..<n
        out.push(xs.at(lo + i))

    out
end viewed

// A struct as `Name(a, b)`, an enum value as its variant's name and what it carries.
@noinline
private record_text(variant: int, fields: Buf[Const], t: Type) -> string
    if variant <= -2
        val (named, declared) = record_shape(-1, t)
        val i = usize(union_written(variant))

        return s"$named(${declared.at(i).0} = ${value_text(fields.at(i), declared.at(i).1)})"
    end if

    val (head, types) = record_shape(variant, t)
    var out = head

    if fields.is_empty() then return out

    for i in 0..<fields.len()
        out = out + (if i > 0 then ", " else "(") + value_text(fields.at(i), types.at(i).1)

    out + ")"
end record_text

// The name a record is written with and its fields' declarations: a struct's, or one variant's.
private record_shape(variant: int, t: Type) -> (string, Buf[(string, Type)]) = underlying(t) match
    Struct(d) -> (d.name(), d.fields)
    Enum(d) ->
        val v = d.variants.at(usize(variant))

        (v.name, v.fields)
    _ -> ("?", buf())

@noinline
private array_text(xs: Buf[Const], elem: Type) -> string
    var out = "["

    for i in 0..<xs.len()
        if i == 4 then return out + s", … ${xs.len()} elements]"

        out = out + (if i > 0 then ", " else "") + value_text(xs.at(i), elem)

    out + "]"
end array_text

// The element type of a fixed array or a slice type, or `Unknown`.
private element_type(t: Type) -> Type = underlying(t) match
    Array(_, elem) -> *elem
    Slice(elem, _) -> *elem
    Vector(_, elem) -> *elem
    _ -> Unknown

// A value a place takes, as a copy of its own: an array's elements are a buffer, and two places
// sharing one would see each other's writes. **Every write into a place copies**, so a place's buffer
// is never anyone else's, and a value only read -- an element, an argument on its way to a copy --
// need not be.
private copied(v: Const) -> Const = v match
    ConstArray(xs) ->
        var out: Buf[Const] = buf()

        for x in xs
            out.push(copied(x))

        ConstArray(out)
    ConstRecord(variant, fields) -> ConstRecord(variant, copied_all(fields))
    _ -> v

private copied_all(xs: Buf[Const]) -> Buf[Const]
    var out: Buf[Const] = buf()

    for x in xs
        out.push(copied(x))

    out

// Whether a value is or holds a slice anywhere in it -- or a writer, which a call handed one writes
// through, so that it is never remembered either.
private holds_view(v: Const) -> bool = v match
    ConstView(_, _, _, _) -> true
    ConstPtr(_, _, _) -> true
    ConstPun(_, _) -> true
    ConstErased(_, _) -> true
    ConstWriter(_) -> true
    ConstArray(xs) -> any_view(xs)
    ConstRecord(_, fields) -> any_view(fields)
    _ -> false

private any_view(xs: Buf[Const]) -> bool
    for x in xs
        if holds_view(x) then return true

    false

// Whether a value holds a slice of the storage of a call at `depth` or deeper -- one that would
// outlive the storage it views, once that call returns.
private dangles(v: Const, depth: int) -> bool = v match
    ConstView(_, _, _, owner) -> owner >= depth
    ConstPtr(_, _, owner) -> owner >= depth
    ConstPun(addr, _) -> dangles(*addr, depth)
    ConstErased(_, data) -> dangles(*data, depth)
    ConstArray(xs) -> any_dangles(xs, depth)
    ConstRecord(_, fields) -> any_dangles(fields, depth)
    _ -> false

private any_dangles(xs: Buf[Const], depth: int) -> bool
    for x in xs
        if dangles(x, depth) then return true

    false

// A value written over the one a local holds, **in the same storage** where the two have the same
// shape: a slice taken of the local views that storage, and sees the new elements as the program's
// would. Where the shapes differ, nothing is written and the caller replaces the value.
private overwrite(old: Const, new: Const) -> bool = (old, new) match
    (ConstArray(xs), ConstArray(ys)) -> overwrite_all(xs, ys)
    (ConstRecord(a, xs), ConstRecord(b, ys)) -> a == b && overwrite_all(xs, ys)
    _ -> false

private overwrite_all(xs: Buf[Const], ys: Buf[Const]) -> bool
    if xs.len() != ys.len() then return false

    var held = xs

    for i in 0..<ys.len()
        if !overwrite(xs.at(i), ys.at(i)) then held.set(i, copied(ys.at(i)))

    true
end overwrite_all

// A settled value as `const_fold`'s callers read one: a `char` is a character there.
private folded_form(v: Const, t: Type) -> Const = v match
    ConstInt(n) -> if underlying(t) == Char then ConstChar(char(u32(n.to_long().unwrap_or(0)))) else v
    _ -> v

// A value as the literal it is laid down as.
private value_literal(span: Span, v: Const, t: Type) -> Option[TExpr] = v match
    ConstInt(n) -> Some(TExpr(span, TIntLit(n, t)))
    ConstBool(b) -> Some(TExpr(span, TBoolLit(b)))
    // A string is laid down as the literal it came to: its bytes are constant data, owned by nothing.
    ConstStr(s) -> Some(TExpr(span, TStrLit(s)))
    ConstFloat(f) -> Some(TExpr(span, TFloatLit(float_pattern(f), underlying(t))))
    ConstQuad(hi, lo) -> Some(TExpr(span, TQuadLit(hi, lo, underlying(t))))
    ConstArray(xs) -> underlying(t) match
        Vector(_, _) -> vector_literal(span, xs, t)
        _ -> array_literal(span, xs, t)
    ConstRecord(variant, fields) -> record_literal(span, variant, fields, t)
    // An address is laid down as the relocation it is: the folded place's address, or the function's.
    ConstLink(image) -> Some(image)
    // Storage the run made, frozen (`answer_refusal` says which may be): a slice's elements as an
    // array of their own, a box as the box, and a pointer into fresh elements -- a frozen buffer's --
    // as the address of the first of an array laid down for them.
    ConstView(xs, lo, n, _) -> frozen_view(span, viewed(xs, lo, n), t)
    ConstPtr(cells, at, _) -> underlying(t) match
        Ref(inner, _) -> value_literal(span, cells.at(at), *inner).map(lit -> TExpr(span, TBox(lit, t)))
        Ptr(inner) ->
            var rest: Buf[Const] = buf()

            for i in at..<cells.len()
                rest.push(cells.at(i))

            array_literal(span, rest, Array(int(rest.len()), inner)).map(arr ->
                TExpr(span, TAddrOf(TExpr(span, TIndex(arr, TExpr(span, TIntLit(from_int(0), int_type())), *inner)), t)))
        _ -> None
    _ -> None

// A slice's elements, laid down as the literal of a slice over constant data.
private frozen_view(span: Span, xs: Buf[Const], t: Type) -> Option[TExpr]
    val elem = element_type(t)
    var items: Buf[TExpr] = buf()

    for x in xs
        val lit = value_literal(span, x, elem)

        if lit.is_none() then return None

        items.push(lit.unwrap())

    Some(TExpr(span, TBufLit(items, t)))
end frozen_view

// **Why a value a run came to is not laid into the object file**, or nothing where it is. What the
// run made on its heap is frozen there, and the object file's copy is read by every use, so it may be
// answered only through a type that says nothing writes it: a `[]const T`, a string, or a frozen
// buffer. Said after the subject's name.
//
// **A module `val` or `var` may answer a `&T` too** (`boxed_answer_refusal`): the box is laid down in
// writable data, as a frozen buffer's is, and the storage is the one object every use reads and writes.
answer_refusal(v: Const, t: Type) -> Option[string]
    var laying = Laying(false, buf())

    answer_refusal_in(v, t, false, &laying)
end answer_refusal

boxed_answer_refusal(v: Const, t: Type) -> Option[string]
    var laying = Laying(true, buf())

    answer_refusal_in(v, t, false, &laying)
end boxed_answer_refusal

// What an answer may hold while it is checked: whether a box the run made may be laid down as a box of
// its own, and the boxes reached so far -- each is laid down once for each place that reaches it, so
// one reached twice would become two objects where the run had one.
private struct Laying
    boxes: bool
    seen: Buf[usize]

private answer_refusal_in(v: Const, t: Type, in_frozen: bool, laying: *Laying) -> Option[string] = v match
    ConstView(xs, lo, n, _) -> underlying(t) match
        Slice(elem, read_only) ->
            if !read_only then Some(s"is a writable slice '${type_show(t)}', ${laid_text()} — answer it as a " +
                                    s"'[]const ${type_show(*elem)}'")
            else elements_refusal(viewed(xs, lo, n), *elem, in_frozen, laying)
        _ -> None
    ConstPtr(cells, at, _) -> underlying(t) match
        Ref(inner, _) ->
            if container_named(*inner) == "sysl.buf.Frozen" then answer_refusal_in(cells.at(at), *inner, true, laying)
            else if !laying.boxes then Some(s"holds a reference, ${laid_text()} — answer the value itself, or a " +
                                            "buffer's 'freeze()'")
            else
                val address = usize(&cells.elems[at])

                for seen in laying.seen
                    if seen == address
                        return Some("reaches one object the run made from two places, and each place laid " +
                                    "down would hold an object of its own — keep one reference to it")
                    end if

                laying.seen.push(address)
                answer_refusal_in(cells.at(at), *inner, in_frozen, laying)
        Ptr(inner) ->
            if !in_frozen then Some(s"holds a pointer to storage the run made, ${laid_text()} — answer the value " +
                                    "itself")
            else
                var rest: Buf[Const] = buf()

                for i in at..<cells.len()
                    rest.push(cells.at(i))

                elements_refusal(rest, *inner, true, laying)
        _ -> Some(s"holds an address of storage the run made, ${laid_text()}")
    ConstArray(xs) -> elements_refusal(xs, element_type(t), in_frozen, laying)
    ConstRecord(variant, fields) ->
        val named = container_named(t)

        if named == "sysl.buf.Buf"
            return Some(s"holds a 'Buf', ${laid_text()} — answer its 'view()' as a '[]const T', or its 'freeze()'")
        if named == "sysl.container.Map" || named == "sysl.container.Set"
            return Some(s"holds a '${short_name(named)}', ${laid_text()} — " +
                        "answer what is read out of it")

        val (_, types) = record_shape(if variant <= -2 then -1 else variant, t)

        for i in 0..<fields.len()
            if i < types.len()
                val why = answer_refusal_in(fields.at(i), types.at(i).1, in_frozen, laying)

                if why.is_some() then return why
        None
    ConstErased(_, _) -> Some("holds a trait object, a closure's '&Fn' among them, whose table and value the " +
                              "program builds — answer the value itself")
    ConstPun(_, _) -> Some(s"holds an address read as another type, ${laid_text()}")
    ConstWriter(_) -> Some("holds a writer, which exists only while a value renders")
    _ -> None

private elements_refusal(xs: Buf[Const], elem: Type, in_frozen: bool, laying: *Laying) -> Option[string]
    for x in xs
        val why = answer_refusal_in(x, elem, in_frozen, laying)

        if why.is_some() then return why

    None
end elements_refusal

private laid_text() -> string =
    "and what a run while compiling makes is laid into the object file, where nothing may write it"

// Whether a reference type is a frozen buffer's, `&sync Frozen[T]`.
frozen_box_type(t: Type) -> bool = underlying(t) match
    Ref(inner, _) -> container_named(*inner) == "sysl.buf.Frozen"
    _ -> false

// The library container a type is, by its generic's qualified name, or empty for anything else.
private container_named(t: Type) -> string = underlying(t) match
    Struct(d) -> qualified_name(d.base)
    _ -> ""

private short_name(qualified: string) -> string
    val b = qualified.bytes
    var from: usize = 0

    for i in 0..<b.len
        if b[i] == u8('.') then from = i + 1

    from_utf8_unchecked(b[from..<b.len])
end short_name

// A struct as the constructor over literals it is laid down as, and an enum value as its variant.
// A variant's payload is laid down as bytes (`payload_image.sysl`); where one has no byte image the
// value stays code, and `const_val_run` says why.
@noinline
private record_literal(span: Span, variant: int, fields: Buf[Const], t: Type) -> Option[TExpr]
    val (_, types) = record_shape(if variant <= -2 then -1 else variant, t)
    var args: Buf[TExpr] = buf()

    for i in 0..<fields.len()
        // A union lays down the one field it was built with; the rest of its bytes are zero.
        if variant <= -2 && int(i) != union_written(variant)
            args.push(TExpr(span, TUnitLit))
            continue
        end if

        val lit = value_literal(span, fields.at(i), types.at(i).1)

        if lit.is_none() then return None

        args.push(lit.unwrap())

    underlying(t) match
        Struct(d) -> Some(TExpr(span, TStructNew(d, args)))
        Enum(d) ->
            val v = d.variants.at(usize(variant))

            Some(TExpr(span, TEnumNew(t, v, args)))
        _ -> None
end record_literal

// A vector as the literal of its lanes it is laid down as.
@noinline
private vector_literal(span: Span, xs: Buf[Const], t: Type) -> Option[TExpr]
    val lane = element_type(t)
    var lits: Buf[TExpr] = buf()

    for x in xs
        val lit = value_literal(span, x, lane)

        if lit.is_none() then return None

        lits.push(lit.unwrap())

    Some(TExpr(span, TVectorLit(lits, t)))
end vector_literal

// A table as the array literal it is laid down as, every element a literal at the element type.
@noinline
private array_literal(span: Span, xs: Buf[Const], t: Type) -> Option[TExpr]
    val elem = element_type(t)
    var lits: Buf[TExpr] = buf()

    for x in xs
        val lit = value_literal(span, x, elem)

        if lit.is_none() then return None

        lits.push(lit.unwrap())

    Some(TExpr(span, TArrayLit(lits, t)))
end array_literal

// The `double` pattern a float literal carries. A NaN is the canonical quiet one: which NaN a
// computation produces is the machine's choice, and the language promises only that it is a NaN.
float_pattern(f: real) -> long
    if f != f then return 0x7FF8000000000000

    v_float(f) match
        VFloat(bits) -> bits
        _ -> 0
end float_pattern

// The value a float literal of a width stands for.
private float_at(f: real, t: Type) -> real = underlying(t) match
    Floating(32, _) -> real(f32(f))
    Floating(16, brain) -> half_of_double(f, brain)
    _ -> f

// What a step that has to produce a value produced, or the control it handed back.
private ev_value_of(f: Flow) -> Option[Const] = f match
    EvGave(v) -> Some(v)
    _ -> None

// The flow a step that wanted a value passes on, where it did not get one.
private passed(r: &EvRun, at: Span, f: Flow) -> Flow = f match
    EvNone -> refuse_form(r, at, "a value was wanted and nothing was produced")
    _ -> f

// -- expressions -------------------------------------------------------------------------------------

// **The walk is a recursion as deep as the calls it runs, so what sits on the machine's stack for
// each level is kept small.** A form is told apart here by its tag alone, binding nothing, and handed
// to a function of its own (`<form>_node`) that reads the node's parts and is never folded back in --
// so the stack holds one form's parts at each step rather than every form's. One frame holding the
// bindings of every form, with the helpers inlined into it, came to about 32 KB a call level, and the
// 512 levels the design promises did not fit the 8 MB a process's main thread is given.
private eval(r: &EvRun, e: TExpr) -> Flow
    if !tick(r) then return EvStop

    *e.kind match
        TIntLit(_, _) -> int_node(e)
        TBoolLit(_) -> bool_node(e)
        TLoad(_, _) -> load_node(r, e)
        TUnary(_, _, _) -> unary_node(r, e)
        TBinary(_, _, _, _) -> binary_node(r, e)
        TLogical(_, _, _) -> logical_node(r, e)
        TCompare(_, _) -> compare_node(r, e)
        TCall(_, _, _, _) -> call_node(r, e)
        TBlockExpr(_) -> block_node(r, e)
        TIf(_, _, _, _) -> if_node(r, e)
        TMatch(_, _, _) -> match_node(r, e)
        TLoop(_, _) -> loop_node(r, e)
        TWhile(_, _, _, _) -> while_node(r, e)
        TDoWhile(_, _, _, _) -> do_while_node(r, e)
        TIterate(_, _, _, _, _, _, _, _) -> do_while_node(r, e)
        TFor(_, _, _, _, _, _, _, _) -> for_node(r, e)
        TCFor(_, _, _, _, _, _) -> c_for_node(r, e)
        TStore(_, _, _, _) -> store_node(r, e)
        TUpdate(_, _, _, _, _, _, _) -> update_node(r, e)
        TIncDec(_, _, _, _, _) -> inc_dec_node(r, e)
        _ -> eval_rest(r, e)
end eval

@noinline
private int_node(e: TExpr) -> Flow = *e.kind match
    TIntLit(n, _) -> EvGave(ConstInt(n))
    _ -> EvStop

@noinline
private bool_node(e: TExpr) -> Flow = *e.kind match
    TBoolLit(b) -> EvGave(ConstBool(b))
    _ -> EvStop

@noinline
private load_node(r: &EvRun, e: TExpr) -> Flow = *e.kind match
    TLoad(name, ty) -> load(r, e.span, name, ty)
    _ -> EvStop

@noinline
private unary_node(r: &EvRun, e: TExpr) -> Flow = *e.kind match
    TUnary(op, operand, ty) -> unary(r, e.span, op, operand, ty)
    _ -> EvStop

@noinline
private binary_node(r: &EvRun, e: TExpr) -> Flow
    val ex = ev_expansion(r, e)

    if ex.is_some() then return eval(r, ex.unwrap())

    *e.kind match
        TBinary(op, l, r2, ty) -> binary(r, e.span, op, l, r2, ty)
        _ -> EvStop
end binary_node

// `e` with the operator calls in its reach read as their bodies, exactly where the lowering reads
// them so (`fp_operators.sysl`), so a value comes out with the roundings the machine gives it.
@noinline
private ev_expansion(r: &EvRun, e: TExpr) -> Option[TExpr]
    val body_of: &Fn(string) -> Option[TFunc] = n -> ev_operator(r, e.span, n)

    if !reaches_operator(body_of, e) then return None

    val drops = drops_declared(r.a)

    val found = operator_expansion(fusing_of(r.a.tables.target), body_of, t -> holds_string(drops, owner_key(t)), 0, e)

    found.map(p -> p.0)
end ev_expansion

// The body of an arithmetic operator method, typed where it was not yet -- nothing for any other
// function, and nothing for one this evaluation cannot run, which the call then says so about.
private ev_operator(r: &EvRun, at: Span, name: string) -> Option[TFunc]
    val f = r.a.tables.funcs.get(name)
    val inst = r.a.tables.members.eval_insts.get(name)
    val marked = if f.is_some() then f.unwrap().decl.marks.operator
    else if inst.is_some() then inst.unwrap().0.decl.marks.operator
    else lowered_operator(r.a, name)

    if !marked || holds_string(r.a.evaluation.typing, name) then return None

    if r.a.evaluation.bodies.get(name).is_none() && evaluable_refusal(r.a, name).is_some() then return None

    callee(r, at, name).map(b -> *b)
end ev_operator

// Whether `name` is a method an `impl` lowered to a function of its own -- where every method of a
// non-generic `impl` is, `V.add` among them -- and an arithmetic operator's.
private lowered_operator(a: &Analysis, name: string) -> bool
    for item in a.tables.members.lowered
        if item.name == name then return item.marks.operator

    false
end lowered_operator

@noinline
private logical_node(r: &EvRun, e: TExpr) -> Flow = *e.kind match
    TLogical(op, l, r2) -> logical(r, e.span, op, l, r2)
    _ -> EvStop

@noinline
private compare_node(r: &EvRun, e: TExpr) -> Flow = *e.kind match
    TCompare(operands, cmps) -> compare_chain(r, e.span, operands, cmps)
    _ -> EvStop

@noinline
private call_node(r: &EvRun, e: TExpr) -> Flow
    val ex = ev_expansion(r, e)

    if ex.is_some() then return eval(r, ex.unwrap())

    *e.kind match
        // **A call that never returns ends the program** -- a library's panic, which says why and
        // exits -- so reaching one while compiling is a trap, as reaching it is where the program runs.
        TCall(name, _, Never, _) -> ends_the_program(r, e.span, name)
        TCall(name, args, _, results) -> call(r, e.span, name, args, results)
        _ -> EvStop
end call_node

@noinline
private ends_the_program(r: &EvRun, at: Span, name: string) -> Flow =
    trap(r, at, s"it reaches '${qualified_name(callee_origin(r.a, name))}', which ends the program")

@noinline
private block_node(r: &EvRun, e: TExpr) -> Flow = *e.kind match
    TBlockExpr(b) -> block(r, b)
    _ -> EvStop

@noinline
private if_node(r: &EvRun, e: TExpr) -> Flow = *e.kind match
    TIf(cond, then_block, else_block, _) -> ev_if(r, e.span, cond, then_block, else_block)
    _ -> EvStop

@noinline
private match_node(r: &EvRun, e: TExpr) -> Flow = *e.kind match
    TMatch(scrutinee, arms, _) -> ev_match(r, e.span, scrutinee, arms)
    _ -> EvStop

@noinline
private loop_node(r: &EvRun, e: TExpr) -> Flow = *e.kind match
    TLoop(body, _) -> ev_loop(r, e.span, body)
    _ -> EvStop

@noinline
private while_node(r: &EvRun, e: TExpr) -> Flow = *e.kind match
    TWhile(cond, body, else_block, _) -> ev_while(r, e.span, cond, body, else_block)
    _ -> EvStop

@noinline
private do_while_node(r: &EvRun, e: TExpr) -> Flow = *e.kind match
    TDoWhile(body, cond, else_block, _) -> ev_do_while(r, e.span, body, cond, else_block)
    TIterate(cursor, _, init, next, bind, body, else_block, _) ->
        ev_iterate(r, e.span, cursor, init, next, bind, body, else_block)
    _ -> EvStop

@noinline
private for_node(r: &EvRun, e: TExpr) -> Flow = *e.kind match
    TFor(name, var_ty, lo, hi, inclusive, body, else_block, _) ->
        ev_for(r, e.span, name, var_ty, lo, hi, inclusive, body, else_block)
    _ -> EvStop

@noinline
private c_for_node(r: &EvRun, e: TExpr) -> Flow = *e.kind match
    TCFor(init, cond, step, body, else_block, _) -> ev_c_for(r, e.span, init, cond, step, body, else_block)
    _ -> EvStop

@noinline
private store_node(r: &EvRun, e: TExpr) -> Flow = *e.kind match
    TStore(place, value, _, _) -> store(r, e.span, place, value)
    _ -> EvStop

@noinline
private update_node(r: &EvRun, e: TExpr) -> Flow = *e.kind match
    TUpdate(place, op, value, ty, dispatch, check, _) -> update(r, e.span, place, op, value, ty, dispatch, check)
    _ -> EvStop

@noinline
private inc_dec_node(r: &EvRun, e: TExpr) -> Flow = *e.kind match
    TIncDec(place, op, pre, ty, check) -> ev_inc_dec(r, e.span, place, op, pre, ty, check)
    _ -> EvStop

// Every form `eval` does not dispatch itself: the rarer ones, and those it refuses.
@noinline
private eval_rest(r: &EvRun, e: TExpr) -> Flow
    *e.kind match
        TFloatLit(bits, ty) -> EvGave(ConstFloat(float_at(real_of_bits(bits), ty)))
        TQuadLit(hi, lo, _) -> EvGave(ConstQuad(hi, lo))
        TUnitLit -> EvNone
        TZero(ty) -> zero_value(r, e.span, ty)
        TGlobal(symbol, ty, writable) -> global_value(r, e.span, symbol, ty, writable)
        TResult(_) ->
            val res = running(r).result

            if res.is_some() then EvGave(res.unwrap()) else EvNone
        TOld(index, _) -> EvGave(running(r).olds.at(usize(index)))
        TCast(operand, ty) -> cast(r, e.span, operand, ty)
        TFloorCast(_, _) ->
            refuse_form(r, e.span, "a conversion rounding toward negative infinity is not evaluated " +
                        "while compiling yet")
        TConstrainedCheck(value, target) -> constrained_check(r, e.span, value, target)
        TConstrainedValid(value, c) -> constrained_valid(r, e.span, value, c)
        TConstrainedStep(value, c, up, _) -> constrained_step(r, e.span, value, c, up)
        TCheckedLoop(slot, _, inner) ->
            running(r).slots.remove(slot)
            eval(r, inner)
        TQuantifier(universal, name, _, lo, hi, inclusive, pred) ->
            quantifier(r, e.span, universal, name, lo, hi, inclusive, pred)
        TSeq(exprs) -> seq(r, exprs)
        TStrLit(s) -> EvGave(ConstStr(s))
        TStr(arg) -> rendered(r, e.span, arg)
        TRender(value, method, spec, slot) -> render(r, e.span, value, method, spec, slot)
        TVCall(receiver, slot, args, _, results) -> dispatched(r, e.span, receiver, slot, args, results)
        TErase(operand, vtable, _) -> erased(r, operand, vtable)
        TTypeId(receiver, _) -> erased_identity(r, receiver)
        TAtomic(op, addr, ops, _, at_ty, _) -> atomic(r, e.span, op, addr, ops, at_ty)
        // An evaluation is one thread, so there is nothing for a fence to order.
        TFence(_) -> EvNone
        TVariantFail(asked, holds) -> trap(r, e.span, variant_fail_text(asked, holds))
        TFieldUnset(made, field) -> trap(r, e.span, field_unset_text(made, field))
        TVariantFailHeld(asked, held) -> held_variant_fail(r, e.span, asked, held)
        TLen(receiver, _) -> length(r, receiver)
        TBytes(receiver) -> bytes_of(r, receiver)
        TSlice(base, lo, hi, inclusive, _) -> sliced(r, e.span, base, lo, hi, inclusive)
        TFromBytes(arg) -> text_of(r, arg)
        TStrView(arg) -> text_of(r, arg)
        TConstView(arg) -> eval(r, arg)
        TStructNew(decl, args) ->
            if decl.union_layout then union_new(r, e.span, decl, args)
            else record_new(r, e.span, -1, args, Struct(decl))
        TEnumNew(enum_ty, variant, args) -> record_new(r, e.span, variant_position(enum_ty, variant), args, enum_ty)
        TArrayLit(elems, ty) -> array_lit(r, e.span, elems, ty)
        TArrayFill(value, ty) -> array_fill(r, e.span, value, ty)
        TField(receiver, index, _) -> field_read(r, receiver, index)
        TStructInvCheck(value, decl, inv_fn) -> invariant_check(r, e.span, value, decl, inv_fn)
        TRecheck(after, recv, decl, inv_fn) -> recheck(r, e.span, after, recv, decl, inv_fn)
        TIndex(receiver, index, _) -> element_read(r, receiver, index)
        TVectorLit(lanes, _) -> vector_new(r, lanes)
        TSplat(value, vec_ty) -> splat(r, value, vec_ty)
        TLane(receiver, lane, _) -> lane_read(r, receiver, lane)
        TVecCompare(op, l, r2, ty) -> vector_compare(r, e.span, op, l, r2, ty)
        TSelect(mask, when_true, when_false, _) -> select_lanes(r, mask, when_true, when_false)
        TShuffle(receiver, second, lanes, _) -> shuffle_lanes(r, receiver, second, lanes)
        TLaneSet(receiver, lanes, value, _) -> lane_set(r, receiver, lanes, value)
        TReduce(op, receiver, ty) -> reduce(r, e.span, op, receiver, ty)
        TVecOp(op, _, _) -> refuse_form(r, e.span, s"a vector's lane-wise " +
                                        s"'${if op == "fma" then "mul_add" else "abs"}' is known only " +
                                        "where the program runs")
        TVecLoad(receiver, index, vec_ty) -> vector_load(r, receiver, index, vec_ty)
        TVecStore(receiver, index, value) -> vector_store(r, receiver, index, value)
        TForEach(name, _, items, body, else_block, _) -> ev_for_each(r, e.span, name, items, body, else_block)
        TAddrOf(place, ty) -> address_of(r, e.span, place, ty)
        TBox(value, _) -> boxed(r, e.span, value)
        TBufLit(elems, ty) -> buffer_lit(r, e.span, elems, ty)
        TBufFill(value, count, ty) -> buffer_fill(r, e.span, value, count, ty)
        TSlots(op, args, _, _) -> slots(r, e.span, op, args)
        TTempAddr(value, _) -> temp_address(r, value)
        TFuncAddr(_, _, _) -> EvGave(ConstLink(e))
        TCallPtr(callee, args, _, _) -> call_through(r, e.span, callee, args)
        // `null` is the one address known before the linker runs, and is held the same way.
        TNullLit(_) -> EvGave(ConstLink(e))
        TDeref(operand, _) -> read_through(r, operand)
        TIntOp(op, operand, amount, width, ty) ->
            if op == "fixed_bits" || op == "fixed_from_bits" then fixed_bits(r, operand, ty)
            else if op == SubscriptIndexOp then subscript_index(r, operand, ty)
            // **`@unchecked` is checked here all the same**: the index is the one it holds, and the
            // element read keeps its own test, so a constant never evaluates past the end.
            else if op == UncheckedSubscriptIndexOp then subscript_index(r, operand, ty)
            else if op == UncheckedIndexOp then eval_value(r, operand) match
                Ok(v) -> EvGave(v)
                Err(f) -> f
            else if is_checked_member(op) then checked_member(r, e.span, op, operand, amount, width, ty)
            else bit_operation(r, e.span, op, operand, amount, width)
        _ -> refuse_form(r, e.span, s"'${texpr_kind_name(e)}' is not evaluated while compiling yet")
end eval_rest

// A call through a function's address: the address is the function it was taken of, so the call is
// that function's, run as a call by name is. Null is a trap, as it is where the program runs.
@noinline
private call_through(r: &EvRun, at: Span, callee: TExpr, args: Buf[TExpr]) -> Flow
    val image = eval_value(r, callee) match
        Ok(ConstLink(found)) -> found
        Ok(_) -> return refuse_form(r, callee.span, "a call through something that is not a function's address")
        Err(f) -> return f

    *image.kind match
        TFuncAddr(name, _, _) -> call(r, at, name, args, false)
        TNullLit(_) -> trap(r, callee.span, "a call through a null function pointer")
        _ -> refuse_form(r, callee.span, "a call through an address that is not a function's")
end call_through

// **The address of module storage is a value while compiling**, as it is in constant data: the
// linker fills it in (`ConstLink`). So is the address of a field of it, or of an element at an index
// that comes to a number the array has. The address of storage the evaluation owns -- a local, an
// element or field of one, what a pointer or a slice reaches -- is the slot it names (`ConstPtr`).
// Thread-local and per-core storage's exists only when the program runs.
@noinline
private address_of(r: &EvRun, at: Span, place: TExpr, ty: Type) -> Flow
    if rooted_in_module(place)
        return linked_place(r, place) match
            Ok(Some(p)) -> EvGave(ConstLink(TExpr(at, TAddrOf(p, ty))))
            Ok(None) -> refuse_form(r, at, "the address of a thread's or a core's own storage is not evaluated " +
                                    "while compiling — it exists only when the program runs")
            Err(f) -> f
    end if

    slot_of(r, place) match
        Ok(SlotElem(xs, i, owner)) -> EvGave(ConstPtr(xs, i, owner))
        Ok(SlotLocal(name)) -> refuse_form(r, at, s"'$name' is read before anything was written to it")
        Ok(SlotUnion(_, _, _, _, _)) ->
            refuse_form(r, at, "the address of a union's field is not evaluated while compiling yet")
        Err(f) -> f
end address_of

// Whether a place is module storage or inside it, reached without a pointer.
private rooted_in_module(place: TExpr) -> bool = *place.kind match
    TGlobal(_, _, _) -> true
    TField(receiver, _, _) -> rooted_in_module(receiver)
    TIndex(receiver, _, _) -> rooted_in_module(receiver)
    _ -> false

// A place inside module storage, its indices run to the numbers they come to, or `None` where the
// place is not one; an index the array does not have traps, as taking its address would.
private linked_place(r: &EvRun, place: TExpr) -> Result[Option[TExpr], Flow] = *place.kind match
    TGlobal(symbol, _, _) ->
        val d = r.a.tables.vals.get(symbol)

        if d.is_some() && (d.unwrap().thread_local || d.unwrap().per_cpu) then Ok(None) else Ok(Some(place))
    TField(receiver, index, ty) ->
        if bitfield_ranges_of(texpr_type(receiver)).is_some() || c_bit_field(texpr_type(receiver), index) then
            return Ok(None)

        // A field reached through a pointer is a load before it is an address.
        nameless(texpr_type(receiver)) match
            Ptr(_) -> return Ok(None)
            _ -> ()

        linked_place(r, receiver) match
            Ok(Some(p)) -> Ok(Some(TExpr(place.span, TField(p, index, ty))))
            other -> other
    TIndex(receiver, index, ty) ->
        val length = nameless(texpr_type(receiver)) match
            Array(n, _) -> usize(n)
            _ -> return Ok(None)

        val inside = linked_place(r, receiver) match
            Ok(Some(p)) -> p
            other -> return other

        val i = element_index(r, index, length) match
            Ok(found) -> found
            Err(f) -> return Err(f)

        val folded = TExpr(index.span, TIntLit(from_int(long(i)), texpr_type(index)))

        Ok(Some(TExpr(place.span, TIndex(inside, folded, ty))))
    _ -> Ok(None)

// `*p`: the value in the slot the pointer names, where the evaluation owns it. Through an address the
// linker fills in, what is there exists only when the program runs.
@noinline
private read_through(r: &EvRun, operand: TExpr) -> Flow = eval_value(r, operand) match
    Ok(ConstPtr(xs, at, _)) -> EvGave(xs.at(at))
    Ok(v) -> through_unowned(r, operand.span, v)
    Err(f) -> f

// A value put on the heap: a box of its own, which nothing frees while the evaluation runs.
@noinline
private boxed(r: &EvRun, at: Span, value: TExpr) -> Flow
    val why = dropped_box(r.a, texpr_type(value))

    if why.is_some() then return refuse_form(r, at, why.unwrap())

    eval_value(r, value) match
        Ok(v) -> EvGave(ConstPtr(cell_of(copied(v)), 0, -1))
        Err(f) -> f
end boxed

// `&value` over a value with no place of its own: a slot made for it in the running call, as the
// program makes one in its frame.
@noinline
private temp_address(r: &EvRun, value: TExpr) -> Flow = eval_value(r, value) match
    Ok(v) -> EvGave(ConstPtr(cell_of(copied(v)), 0, int(r.frames.len()) - 1))
    Err(f) -> f

// Why a box of this type is not made while compiling: **a type with a `Drop` runs it when its box's
// last share goes**, and when that is, is decided by counts the evaluator does not keep.
private dropped_box(a: &Analysis, t: Type) -> Option[string] = underlying(t) match
    Struct(_) -> if holds_string(drops_declared(a), owner_key(underlying(t))) then Some(dropped_text(t)) else None
    Enum(_) -> if holds_string(drops_declared(a), owner_key(underlying(t))) then Some(dropped_text(t)) else None
    _ -> None

private dropped_text(t: Type) -> string =
    s"a box of a '${type_show(t)}', which has a 'Drop', is not made while compiling — its 'drop' runs when " +
    "the last share of the box goes, and when that is, is decided by counts kept only when the program runs"

private link_reason() -> string =
    "reading through an address is not evaluated while compiling — the linker fills an address in, " +
    "and what it points at exists only when the program runs"

// An address as a reader would write it: the storage, field and element it names, or the function.
private link_key(image: TExpr) -> string = *image.kind match
    TAddrOf(place, _) -> link_key(place)
    TFuncAddr(name, _, _) -> qualified_name(name)
    TNullLit(_) -> "null"
    TGlobal(symbol, _, _) -> qualified_name(symbol)
    TField(receiver, index, _) -> s"${link_key(receiver)}.$index"
    TIndex(receiver, index, _) -> *index.kind match
        TIntLit(n, _) -> s"${link_key(receiver)}[${to_string(n)}]"
        _ -> s"${link_key(receiver)}[?]"
    _ -> "?"

// Expressions run in turn for their effects.
@noinline
private seq(r: &EvRun, exprs: Buf[TExpr]) -> Flow
    for expr in exprs
        val f = eval(r, expr)

        f match
            EvGave(_) -> ()
            EvNone -> ()
            _ -> return f

    EvNone
end seq

// A step that has to come to a value.
private eval_value(r: &EvRun, e: TExpr) -> Result[Const, Flow]
    val f = eval(r, e)

    f match
        EvGave(v) -> Ok(v)
        _ -> Err(passed(r, e.span, f))
end eval_value

// A step that has to come to a `bool`.
private eval_bool(r: &EvRun, e: TExpr) -> Result[bool, Flow]
    eval_value(r, e) match
        Ok(ConstBool(b)) -> Ok(b)
        Ok(_) -> Err(refuse_form(r, e.span, "a condition that is not a 'bool'"))
        Err(f) -> Err(f)
end eval_bool

@noinline
private zero_value(r: &EvRun, at: Span, ty: Type) -> Flow = underlying(ty) match
    Integer(_, _, _) -> EvGave(ConstInt(from_int(0)))
    Char -> EvGave(ConstInt(from_int(0)))
    Floating(128, _) -> EvGave(ConstQuad(0, 0))
    Floating(_, _) -> EvGave(ConstFloat(0.0))
    Fixed(_, _, _) -> EvGave(ConstInt(from_int(0)))
    Bool -> EvGave(ConstBool(false))
    Unit -> EvNone
    Str -> EvGave(ConstStr(""))
    Slice(_, _) -> EvGave(ConstView(buf(), 0, 0, -1))
    // A pointer's zero is null.
    Ptr(_) -> EvGave(ConstLink(TExpr(at, TNullLit(ty))))
    Array(n, elem) ->
        if !sized(r, at, long(n)) then return EvStop

        val z = zero_value(r, at, *elem) match
            EvGave(v) -> v
            other -> return other

        EvGave(ConstArray(filled(z, n)))
    Struct(d) -> zero_record(r, at, d)
    // An enum's zero is its variant written `= 0`, which carries nothing.
    Enum(d) if d.zero_variant().is_some() -> EvGave(ConstRecord(int(d.zero_variant().unwrap()), buf()))
    _ -> refuse_form(r, at, unheld(ty).unwrap_or(s"the zero of '${type_show(ty)}' is not evaluated while compiling yet"))

// A struct whose every field is its own zero.
@noinline
private zero_record(r: &EvRun, at: Span, d: &StructType) -> Flow
    if d.opaque then return refuse_form(r, at, s"an opaque '${d.name()}' is not evaluated while compiling")

    var out: Buf[Const] = buf()

    for f in d.fields
        // A union's zero is all-zero bytes, which is its first field's zero; the rest stand in.
        if d.union_layout && !out.is_empty()
            out.push(ConstBool(false))
            continue
        end if

        zero_value(r, at, f.1) match
            EvGave(v) -> out.push(v)
            EvNone -> return refuse_form(r, at, "a 'unit' field is not evaluated while compiling yet")
            other -> return other

    EvGave(ConstRecord(if d.union_layout then union_variant(0) else -1, out))
end zero_record

// -- arrays ------------------------------------------------------------------------------------------
//
// **A fixed array is held by value, as its elements**, so a table a `const` function fills in a loop
// comes back as the elements it holds and is laid down as the literal they make. Making one costs a
// step per element, so the step bound is also the bound on how large a table may be.

// `n` copies of one value, each a place of its own.
private filled(v: Const, n: int) -> Buf[Const]
    var out: Buf[Const] = buf()

    for _ in 0..<n
        out.push(copied(v))

    out
end filled

// Charges the steps an array of `n` elements costs, and stops the run where they are more than are
// left -- naming the size, which is what to change.
private sized(r: &EvRun, at: Span, n: long) -> bool = charged(r, at, n, s"an array of $n elements")

// The same for any value made a step per element or byte: `what` names it.
@noinline
private charged(r: &EvRun, at: Span, n: long, what: string) -> bool
    if r.steps + n <= r.limit
        r.steps += n
        return true
    end if

    if r.kind == EvRunning
        r.kind = EvLimit
        r.message = s"${r.subject} did not finish within ${step_limit_text(r.limit)} steps while compiling — $what at " +
                    s"${place_text(here(r), at)} is past the steps that were left" + step_advice()
    end if

    false
end charged

@noinline
private array_lit(r: &EvRun, at: Span, elems: Buf[TExpr], ty: Type) -> Flow
    val why = unheld(ty)

    if why.is_some() then return refuse_form(r, at, why.unwrap())

    var out: Buf[Const] = buf()

    for elem in elems
        eval_value(r, elem) match
            Ok(v) -> out.push(copied(v))
            Err(f) -> return f

    EvGave(ConstArray(out))
end array_lit

@noinline
private array_fill(r: &EvRun, at: Span, value: TExpr, ty: Type) -> Flow
    val why = unheld(ty)

    if why.is_some() then return refuse_form(r, at, why.unwrap())

    val n = underlying(ty) match
        Array(count, _) -> count
        _ -> return refuse_form(r, at, s"a '${type_show(ty)}' is not evaluated while compiling yet")

    val v = eval_value(r, value) match
        Ok(x) -> x
        Err(f) -> return f

    if !sized(r, at, long(n)) then return EvStop

    EvGave(ConstArray(filled(v, n)))
end array_fill

// The position an index names in an array of `n` elements; an index outside it traps, as it would
// where the program ran.
@noinline
private element_index(r: &EvRun, index: TExpr, n: usize) -> Result[usize, Flow]
    val at = eval_value(r, index) match
        Ok(ConstInt(i)) -> i
        Ok(_) -> return Err(refuse_form(r, index.span, "an index that is not an integer"))
        Err(f) -> return Err(f)

    if cmp(at, from_int(0)) < 0 || cmp(at, from_int(long(n))) >= 0 then
        return Err(trap(r, index.span, s"index ${to_string(at)} is out of bounds for an array of $n elements"))

    Ok(usize(at.to_long().unwrap_or(0)))
end element_index

// `a[i]`, read: the array is read where it is held, without a copy.
@noinline
private element_read(r: &EvRun, receiver: TExpr, index: TExpr) -> Flow
    val (xs, lo, n) = eval_value(r, receiver) match
        Ok(ConstArray(found)) -> (found, usize(0), found.len())
        Ok(ConstView(found, from, count, _)) -> (found, from, count)
        // A string's subscript is a byte.
        Ok(ConstStr(s)) -> return element_index(r, index, s.bytes.len) match
            Ok(i) -> EvGave(ConstInt(from_int(long(s.bytes[i]))))
            Err(f) -> f
        // A pointer's subscript counts from the slot it points at.
        Ok(ConstPtr(found, at, _)) -> (found, at, found.len() - at)
        Ok(ConstLink(image)) -> return through_unowned(r, receiver.span, ConstLink(image))
        Ok(_) -> return refuse_form(r, receiver.span, s"an element of a '${type_show(texpr_type(receiver))}' " +
                                    "is not evaluated while compiling yet — a fixed array's, a slice's and a " +
                                    "string's are")
        Err(f) -> return f

    element_index(r, index, n) match
        Ok(i) -> placed(r, index.span, xs.at(lo + i))
        Err(f) -> f
end element_read

// -- the heap ----------------------------------------------------------------------------------------
//
// **What the program puts on the heap, the run puts in buffers of its own**, which nothing frees
// while it runs: a slice of fresh elements is a view whose owner is the heap (-1), so it may be
// answered by the call that made it, and a box is a buffer of one (`boxed`).

// `[a, b, c]` where a slice is wanted: its own elements, on the heap.
@noinline
private buffer_lit(r: &EvRun, at: Span, elems: Buf[TExpr], ty: Type) -> Flow
    val why = unheld(ty)

    if why.is_some() then return refuse_form(r, at, why.unwrap())

    var out: Buf[Const] = buf()

    for elem in elems
        eval_value(r, elem) match
            Ok(v) -> out.push(copied(v))
            Err(f) -> return f

    EvGave(ConstView(out, 0, out.len(), -1))
end buffer_lit

// `[value; count]` where a slice is wanted, the count known only as the program runs.
@noinline
private buffer_fill(r: &EvRun, at: Span, value: TExpr, count: TExpr, ty: Type) -> Flow
    val why = unheld(ty)

    if why.is_some() then return refuse_form(r, at, why.unwrap())

    val v = eval_value(r, value) match
        Ok(x) -> x
        Err(f) -> return f

    val n = eval_value(r, count) match
        Ok(ConstInt(k)) -> k.to_long().unwrap_or(-1)
        Ok(_) -> return refuse_form(r, count.span, "a count that is not an integer")
        Err(f) -> return f

    if n < 0 then return trap(r, count.span, s"a buffer of ${n} elements")
    if !sized(r, at, n) then return EvStop

    EvGave(ConstView(filled(v, int(n)), 0, usize(n), -1))
end buffer_fill

// The three slot forms over a buffer's storage (`slots.sysl`). Fresh storage holds nothing in any
// slot until one is placed there, and the run keeps no count for a vacate to let go of.
@noinline
private slots(r: &EvRun, at: Span, op: string, args: Buf[TExpr]) -> Flow
    var vals: Buf[Const] = buf()

    for arg in args
        eval_value(r, arg) match
            Ok(v) -> vals.push(v)
            Err(f) -> return f

    op match
        "slot_storage" ->
            val n = vals.at(0) match
                ConstInt(k) -> k.to_long().unwrap_or(-1)
                _ -> -1

            if n < 0 then return refuse_form(r, at, "a count that is not a size")
            if !sized(r, at, n) then return EvStop

            EvGave(ConstView(filled(ConstUnset, int(n)), 0, usize(n), -1))
        "slot_place" -> (vals.at(0), vals.at(1)) match
            (ConstView(xs, lo, n, _), ConstInt(k)) ->
                val i = k.to_long().unwrap_or(-1)

                if i < 0 || i >= long(n) then
                    return trap(r, args.at(1).span, s"index $i is out of bounds for a slice of $n elements")

                written_over(xs, lo + usize(i), vals.at(2))
                EvNone
            _ -> refuse_form(r, at, "'slot_place' over something that is not a slice")
        "slot_take" -> raw_move(r, at, op)
        "slot_put" -> raw_move(r, at, op)
        _ -> EvNone
end slots

private raw_move(r: &EvRun, at: Span, op: string) -> Flow =
    refuse_form(r, at, s"'$op' moves a value through a raw pointer, which is not evaluated while compiling")

// A slot read: a value, or the refusal of one fresh storage has nothing placed in yet.
private placed(r: &EvRun, at: Span, v: Const) -> Flow = v match
    ConstUnset -> refuse_form(r, at, "a slot of storage 'slot_storage' made is read before anything was " +
                              "placed in it — its bytes are whatever the allocator left")
    _ -> EvGave(v)

// -- vectors -------------------------------------------------------------------------------------------

// **A vector is held as its lanes**, an array of them, and what an operator does to one is what the
// lane's operator does to each lane, by the same definitions a scalar is run with (`operate`,
// `fixed_operate`) at the lane type. No lane operation is checked, as the lowering checks none: an
// integer lane wraps, and the two operators that would trap on one lane, integer `/` and `%`, are
// refused on a vector before anything runs.

// A vector's lanes; nothing for a value that is not one.
private lanes_of(v: Const) -> Buf[Const] = v match
    ConstArray(xs) -> xs
    _ -> buf()

// How many lanes a vector type has.
private lane_count(t: Type) -> int = underlying(t) match
    Vector(n, _) -> n
    _ -> 0

// `[a, b, c, d]` at a vector type: each lane computed in order.
@noinline
private vector_new(r: &EvRun, lanes: Buf[TExpr]) -> Flow
    var out: Buf[Const] = buf()

    for lane in lanes
        eval_value(r, lane) match
            Ok(v) -> out.push(v)
            Err(f) -> return f

    EvGave(ConstArray(out))
end vector_new

// One value in every lane.
@noinline
private splat(r: &EvRun, value: TExpr, vec_ty: Type) -> Flow = eval_value(r, value) match
    Ok(v) -> EvGave(ConstArray(filled(v, lane_count(vec_ty))))
    Err(f) -> f

// `v[2]`: the analyzer has already checked the lane is one the vector has.
@noinline
private lane_read(r: &EvRun, receiver: TExpr, lane: int) -> Flow = eval_value(r, receiver) match
    Ok(ConstArray(xs)) -> EvGave(xs.at(usize(lane)))
    Ok(_) -> refuse_form(r, receiver.span, "a lane of something that is not a vector")
    Err(f) -> f

// An operator between two vectors, lane by lane. A shift's count may be one scalar for every lane.
@noinline
private lanewise(r: &EvRun, at: Span, op: string, lt: Type, rt: Type, ty: Type, x: Const, y: Const) -> Flow
    val xs = lanes_of(x)
    val ys = y match
        ConstArray(found) -> found
        _ -> filled(y, int(xs.len()))
    val (ll, rl, tl) = (vector_lane_of(lt), vector_lane_of(rt), vector_lane_of(ty))
    var out: Buf[Const] = buf()

    for i in 0..<xs.len()
        val lane = if fixed_arith_op(op, ll, rl, tl) then fixed_operate(r, at, op, ll, rl, tl, xs.at(i), ys.at(i))
        else operate(r, at, op, ll, xs.at(i), ys.at(i), false)

        lane match
            EvGave(v) -> out.push(v)
            other -> return other

    EvGave(ConstArray(out))
end lanewise

// `a < b` between vectors: a mask, each lane the comparison of the two lanes.
@noinline
private vector_compare(r: &EvRun, at: Span, op: string, l: TExpr, rt: TExpr, ty: Type) -> Flow
    val x = eval_value(r, l) match
        Ok(v) -> v
        Err(f) -> return f

    val y = eval_value(r, rt) match
        Ok(v) -> v
        Err(f) -> return f

    lanewise(r, at, op, texpr_type(l), texpr_type(rt), ty, x, y)
end vector_compare

// `m.select(a, b)`: every operand computed, as the lowering computes them, and each lane taken from
// `a` where the mask's lane is true and from `b` where it is not.
@noinline
private select_lanes(r: &EvRun, mask: TExpr, when_true: TExpr, when_false: TExpr) -> Flow
    val m = eval_value(r, mask) match
        Ok(v) -> lanes_of(v)
        Err(f) -> return f

    val a = eval_value(r, when_true) match
        Ok(v) -> lanes_of(v)
        Err(f) -> return f

    val b = eval_value(r, when_false) match
        Ok(v) -> lanes_of(v)
        Err(f) -> return f

    var out: Buf[Const] = buf()

    for i in 0..<m.len()
        val chosen = m.at(i) match
            ConstBool(true) -> a.at(i)
            _ -> b.at(i)

        out.push(chosen)

    EvGave(ConstArray(out))
end select_lanes

// `a.shuffle(b, [0, 4, 1, 5])`: both inputs computed, then each listed lane taken from the receiver
// below its width and from the second vector at and above it. The analyzer has checked every lane.
@noinline
private shuffle_lanes(r: &EvRun, receiver: TExpr, second: Option[TExpr], lanes: Buf[int]) -> Flow
    val a = eval_value(r, receiver) match
        Ok(v) -> lanes_of(v)
        Err(f) -> return f

    var b: Buf[Const] = buf()

    if second.is_some()
        eval_value(r, second.unwrap()) match
            Ok(v) -> b = lanes_of(v)
            Err(f) -> return f

    var out: Buf[Const] = buf()

    for lane in lanes
        out.push(if usize(lane) < a.len() then a.at(usize(lane)) else b.at(usize(lane) - a.len()))

    EvGave(ConstArray(out))
end shuffle_lanes

// A vector with some lanes written: the receiver's lanes, each listed one replaced by the matching
// lane of the value -- the value itself where one lane is named.
@noinline
private lane_set(r: &EvRun, receiver: TExpr, lanes: Buf[int], value: TExpr) -> Flow
    val a = eval_value(r, receiver) match
        Ok(v) -> lanes_of(v)
        Err(f) -> return f

    val given = eval_value(r, value) match
        Ok(v) -> v
        Err(f) -> return f

    var out: Buf[Const] = buf()

    for item in a
        out.push(copied(item))

    for j in 0..<lanes.len()
        val lane = usize(lanes.at(j))

        out.set(lane, if lanes.len() == 1 then copied(given) else copied(lanes_of(given).at(j)))

    EvGave(ConstArray(out))
end lane_set

// A vector's lanes folded into one value, by the reduction the analyzer chose (`vectors.sysl`).
//
// **A float sum is refused**: it is lowered as a sum the machine may reassociate, and which lanes it
// adds first is the target's instructions' to choose -- an AArch64 core adds neighbouring pairs, the
// generic expansion halves -- so no one value is the one the program computes. The minimum and
// maximum of floats answer the other lane where one is a NaN, as `fmin` does; the integer and
// fixed-point ones compare the values held, signed or not as the lane is. An integer sum wraps, and
// wrapping addition gives one answer in any order.
@noinline
private reduce(r: &EvRun, at: Span, op: string, receiver: TExpr, ty: Type) -> Flow
    if op == "fadd" then
        return refuse_form(r, at, "a float vector's 'sum' adds its lanes in the order the target's " +
                           "instructions take, so its value is known only where the program runs — add " +
                           "the lanes in the order meant, 'v[0] + v[1] + …'")

    val xs = eval_value(r, receiver) match
        Ok(v) -> lanes_of(v)
        Err(f) -> return f

    if xs.is_empty() then return refuse_form(r, at, "a vector with no lanes")

    var acc = xs.at(0)

    for i in 1..<xs.len()
        val x = xs.at(i)

        acc = (op, acc, x) match
            ("add", _, _) -> operate(r, at, "+", ty, acc, x, false) match
                EvGave(v) -> v
                other -> return other
            ("or", ConstBool(a), ConstBool(b)) -> ConstBool(a || b)
            ("and", ConstBool(a), ConstBool(b)) -> ConstBool(a && b)
            (_, ConstInt(a), ConstInt(b)) ->
                val smaller = cmp(b, a) < 0

                if (op.ends_with("min") && smaller) || (op.ends_with("max") && cmp(b, a) > 0) then x else acc
            (_, ConstFloat(a), ConstFloat(b)) ->
                if a != a then x
                else if b != b then acc
                else if (op == "fmin" && b < a) || (op == "fmax" && b > a) then x
                else acc
            _ -> return refuse_form(r, at, s"the reduction '$op' of ${type_show(texpr_type(receiver))}")
    end for

    EvGave(acc)
end reduce

// The run of elements a vector is loaded from or stored to, `n` of them from `index`: where they are
// held, and the position of the first. A run that does not fit traps, as it does where the program
// runs -- checked as a whole, so a run starting at an element that exists still traps if the last
// does not.
private lane_run(r: &EvRun, held: Const, receiver: TExpr, index: TExpr, n: int) -> Result[(Buf[Const], usize), Flow]
    val (xs, lo, len) = held match
        ConstArray(found) -> (found, usize(0), found.len())
        ConstView(found, from, count, _) -> (found, from, count)
        _ -> return Err(refuse_form(r, receiver.span, s"a vector of the elements of a " +
                                    s"'${type_show(texpr_type(receiver))}' is not evaluated while compiling yet"))

    val i = eval_value(r, index) match
        Ok(ConstInt(v)) -> v
        Ok(_) -> return Err(refuse_form(r, index.span, "an index that is not an integer"))
        Err(f) -> return Err(f)

    val count = from_int(long(n))

    if cmp(from_int(long(len)), count) < 0 || cmp(i, from_int(0)) < 0 || cmp(add(i, count), from_int(long(len))) > 0 then
        return Err(trap(r, index.span, s"$n elements from index ${to_string(i)} are out of bounds for a length of $len"))

    Ok((xs, lo + usize(i.to_long().unwrap_or(0))))
end lane_run

// `xs.load(i)`: the lanes are copies of the elements, read where they are held.
@noinline
private vector_load(r: &EvRun, receiver: TExpr, index: TExpr, vec_ty: Type) -> Flow
    val held = eval_value(r, receiver) match
        Ok(v) -> v
        Err(f) -> return f

    val n = lane_count(vec_ty)

    lane_run(r, held, receiver, index, n) match
        Ok((xs, first)) ->
            var out: Buf[Const] = buf()

            for k in 0..<usize(n)
                out.push(copied(xs.at(first + k)))

            EvGave(ConstArray(out))
        Err(f) -> f
end vector_load

// `xs.store(i, v)`: the value first and the run second, the order an assignment takes, and each lane
// written into the element where it is held -- an array a local holds, or the one a slice views.
@noinline
private vector_store(r: &EvRun, receiver: TExpr, index: TExpr, value: TExpr) -> Flow
    val lanes = eval_value(r, value) match
        Ok(v) -> lanes_of(v)
        Err(f) -> return f

    // A place is read where it is held, so the writes land in it; a slice made on the spot views its
    // array's own storage, and lands there.
    val found = if is_place(receiver) then slot_of(r, receiver).and_then(s -> slot_value(r, receiver.span, s))
    else eval_value(r, receiver)

    val held = found match
        Ok(v) -> v
        Err(f) -> return f

    // An array that is not a place is a value of its own, and a write into it would land nowhere.
    held match
        ConstArray(_) -> if !is_place(receiver) then return no_place(r, receiver)
        _ -> ()

    lane_run(r, held, receiver, index, int(lanes.len())) match
        Ok((xs, first)) ->
            var target = xs

            for k in 0..<lanes.len()
                target.set(first + k, copied(lanes.at(k)))

            EvNone
        Err(f) -> f
end vector_store

// `for x in a` over a fixed array: the elements as they were when the loop began.
@noinline
private ev_for_each(r: &EvRun, at: Span, name: string, items: TExpr, body: Buf[TStmt],
                    else_block: Option[TBlock]) -> Flow
    // An array's elements as they were when the loop began; a slice's are read where they are held,
    // as each turn comes to them.
    val (elems, lo, n) = eval_value(r, items) match
        Ok(ConstArray(found)) -> (copied_all(found), usize(0), found.len())
        Ok(ConstView(found, from, count, _)) -> (found, from, count)
        Ok(_) -> return refuse_form(r, at, s"a 'for' over a '${type_show(texpr_type(items))}' is not " +
                                    "evaluated while compiling yet — one over a fixed array, a slice or a range is")
        Err(f) -> return f

    enter_loop(r, at)

    for i in 0..<n
        if !tick(r) then return left(r, EvStop)

        assign(r, name, elems.at(lo + i))

        turn(stmts(r, body)) match
            TurnOn -> ()
            TurnDone(v) -> return left(r, gave(v))
            TurnOut(f) -> return left(r, f)

    ran_out(r, else_block)
end ev_for_each

// -- strings and slices ------------------------------------------------------------------------------
//
// **A string is held as its text**, built by `+`, by an interpolation and by `str`, and laid down as
// the literal it comes to -- its bytes constant data, owned by nothing, as a written literal's are.
// Building one costs a step per byte, so the step bound is the bound on how long a string may grow.
//
// **A slice is held as a view**: a run of the elements of the buffer an array's value holds, shared
// with it, so a write through a `[]T` lands in the array the caller passed and a write into the array
// is seen through the slice, as when the program runs. A string's bytes are a view nothing owns.

// A string made by the run, its bytes charged.
private built(r: &EvRun, at: Span, text: string) -> Flow =
    if charged(r, at, long(text.bytes.len), s"a string of ${text.bytes.len} bytes") then EvGave(ConstStr(text))
    else EvStop

// `+` joins two strings; the comparisons are by bytes, as the program's are.
@noinline
private str_operate(r: &EvRun, at: Span, op: string, a: string, b: string) -> Flow
    if op == "+" then return built(r, at, a + b)

    val sign = if a < b then -1 else if a == b then 0 else 1

    if op == "==" then EvGave(ConstBool(sign == 0))
    else if op == "!=" then EvGave(ConstBool(sign != 0))
    else if op == "<" then EvGave(ConstBool(sign < 0))
    else if op == "<=" then EvGave(ConstBool(sign <= 0))
    else if op == ">" then EvGave(ConstBool(sign > 0))
    else if op == ">=" then EvGave(ConstBool(sign >= 0))
    else refuse_form(r, at, s"'$op' on string is not evaluated while compiling")
end str_operate

// `str(x)`, and an interpolation's hole, over a value that renders itself: the text the program's
// renderer writes -- an integer in decimal, a fixed-point value as the shortest decimal that reads back
// as it (`fixed_text`, which the run-time renderer agrees with to the byte), a `char` as its UTF-8.
@noinline
private rendered(r: &EvRun, at: Span, arg: TExpr) -> Flow
    val v = eval_value(r, arg) match
        Ok(x) -> x
        Err(f) -> return f

    val ty = texpr_type(arg)

    val text = (v, underlying(ty)) match
        (ConstStr(s), _) -> s
        (ConstBool(b), _) -> if b then "true" else "false"
        (ConstChar(c), _) -> s"$c"
        (ConstInt(n), Char) -> s"${char(u32(n.to_long().unwrap_or(0)))}"
        (ConstInt(n), Fixed(_, frac, _)) -> fixed_text(n, frac)
        (ConstInt(n), Integer(_, _, _)) -> to_string(n)
        _ -> return refuse_form(r, at, s"a '${type_show(ty)}' rendered as text is not evaluated while compiling")

    built(r, at, text)
end rendered

// `.len`: a string's bytes, a slice's elements, an array's.
@noinline
private length(r: &EvRun, receiver: TExpr) -> Flow = eval_value(r, receiver) match
    Ok(ConstStr(s)) -> EvGave(ConstInt(from_int(long(s.bytes.len))))
    Ok(ConstView(_, _, n, _)) -> EvGave(ConstInt(from_int(long(n))))
    Ok(ConstArray(xs)) -> EvGave(ConstInt(from_int(long(xs.len()))))
    Ok(_) -> refuse_form(r, receiver.span, s"the length of a '${type_show(texpr_type(receiver))}' is not " +
                         "evaluated while compiling")
    Err(f) -> f

// `x.(c)` on a value holding another variant, named from the value itself.
@noinline
private held_variant_fail(r: &EvRun, at: Span, asked: string, held: TExpr) -> Flow =
    eval_value(r, held) match
        Ok(ConstRecord(v, _)) ->
            trap(r, at, variant_fail_text(asked, descriptor_text(texpr_type(held), v, -1)))
        Ok(_) -> refuse_form(r, held.span, s"a '${type_show(texpr_type(held))}' is not evaluated " +
                             "while compiling")
        Err(f) -> f

// `s.bytes`: a read-only view of a string's bytes, which outlive every call.
@noinline
private bytes_of(r: &EvRun, receiver: TExpr) -> Flow
    val s = eval_value(r, receiver) match
        Ok(ConstStr(found)) -> found
        Ok(_) -> return refuse_form(r, receiver.span, s"the bytes of a '${type_show(texpr_type(receiver))}' " +
                                    "are not evaluated while compiling")
        Err(f) -> return f

    val b = s.bytes

    if !charged(r, receiver.span, long(b.len), s"a string of ${b.len} bytes") then return EvStop

    var out: Buf[Const] = buf()

    for x in b
        out.push(ConstInt(from_int(long(x))))

    EvGave(ConstView(out, 0, b.len, -1))
end bytes_of

// `a[lo..<hi]` and its other spellings: a view of an array or of a slice, or the string between two
// byte positions. A range outside what it slices traps, and so does a string's that does not fall
// where a character starts, as both do when the program runs.
@noinline
private sliced(r: &EvRun, at: Span, base: TExpr, lo: Option[TExpr], hi: Option[TExpr], inclusive: bool) -> Flow
    val v = eval_value(r, base) match
        Ok(x) -> x
        Err(f) -> return f

    val n: usize = v match
        ConstStr(s) -> s.bytes.len
        ConstView(_, _, count, _) -> count
        ConstArray(xs) -> xs.len()
        _ -> return refuse_form(r, at, s"a slice of a '${type_show(texpr_type(base))}' is not evaluated while compiling")

    val from = slice_end(r, lo, from_int(0), false) match
        Ok(i) -> i
        Err(f) -> return f

    val to = slice_end(r, hi, from_int(long(n)), inclusive) match
        Ok(i) -> i
        Err(f) -> return f

    if cmp(from, from_int(0)) < 0 || cmp(from, to) > 0 || cmp(to, from_int(long(n))) > 0 then
        return trap(r, at, s"the range ${to_string(from)}..<${to_string(to)} is out of bounds for $n elements")

    val a = usize(from.to_long().unwrap_or(0))
    val b = usize(to.to_long().unwrap_or(0))

    v match
        ConstStr(s) ->
            if !starts_char(s, a) || !starts_char(s, b) then
                return trap(r, at, s"the range $a..<$b of a string of $n bytes does not fall where characters start")

            EvGave(ConstStr(s[a..<b]))
        ConstView(xs, first, _, owner) -> EvGave(ConstView(xs, first + a, b - a, owner))
        ConstArray(xs) ->
            // An array that is no local's -- a value a call answered -- is a temporary of this call.
            val held = if is_place(base) then xs else copied_all(xs)

            EvGave(ConstView(held, a, b - a, owner_of(r, base)))
        _ -> EvStop
end sliced

// One end of a range a slice is taken over, or `missing` where it was not written.
private slice_end(r: &EvRun, e: Option[TExpr], missing: BigInt, inclusive: bool) -> Result[BigInt, Flow]
    if e.is_none() then return Ok(missing)

    eval_value(r, e.unwrap()) match
        Ok(ConstInt(i)) -> Ok(if inclusive then add(i, from_int(1)) else i)
        Ok(_) -> Err(refuse_form(r, e.unwrap().span, "a slice's bound that is not an integer"))
        Err(f) -> Err(f)
end slice_end

// Whether byte `at` of a string is where a character starts, or its end.
private starts_char(s: string, at: usize) -> bool = at == s.bytes.len || (s.bytes[at] & 0xC0) != 0x80

// Whether an expression names storage -- a local, module storage, an element or a field of one.
private is_place(e: TExpr) -> bool = *e.kind match
    TLoad(_, _) -> true
    TGlobal(_, _, _) -> true
    TIndex(receiver, _, _) -> is_place(receiver)
    TField(receiver, _, _) -> is_place(receiver)
    _ -> false

// Which call's storage a slice of this array views: module storage outlives every call (-1), and
// anything else is the running call's -- a local, an element or field of one, or a temporary.
private owner_of(r: &EvRun, e: TExpr) -> int = *e.kind match
    TGlobal(_, _, _) -> -1
    TIndex(receiver, _, _) -> owner_of(r, receiver)
    TField(receiver, _, _) -> owner_of(r, receiver)
    _ -> int(r.frames.len()) - 1

// A string from bytes the analyzer knows are UTF-8: `string(bytes)`, and a view of a `[]u8` as one.
@noinline
private text_of(r: &EvRun, arg: TExpr) -> Flow
    val (xs, lo, n) = eval_value(r, arg) match
        Ok(ConstStr(s)) -> return EvGave(ConstStr(s))
        Ok(ConstView(found, from, count, _)) -> (found, from, count)
        Ok(ConstArray(found)) -> (found, usize(0), found.len())
        Ok(_) -> return refuse_form(r, arg.span, s"a string from a '${type_show(texpr_type(arg))}' is not " +
                                    "evaluated while compiling")
        Err(f) -> return f

    var b: Buf[u8] = buf()

    for i in 0..<n
        xs.at(lo + i) match
            ConstInt(x) -> b.push(u8(x.to_long().unwrap_or(0)))
            _ -> return refuse_form(r, arg.span, "a string from something other than bytes")

    built(r, arg.span, from_utf8_unchecked(b.view()))
end text_of

// The renderers an `f"…"` hole with a specifier lowers to. **The compiler runs the library's own
// functions** -- the ones it was built with -- so the text is the program's, flag for flag: an integer
// under `%d`, `%x` and the rest, a string under `%s`, and a fixed-point value under a float
// conversion, which is a dyadic rational printed exactly. A float renders the same way, at its own
// width: `str` and a plain hole through the shortest round-trip renderer, a specifier through the exact
// one, so a subnormal, `-0`, an infinity and a NaN are spelled as the program spells them.
const_renderer(shown: string) -> bool = shown match
    "sysl.fmt.format_int" | "sysl.fmt.format_str" | "sysl.fmt.format_fixed" -> true
    "sysl.fmt.format_real" | "sysl.fmt.format_f32" | "sysl.fmt.format_f128" -> true
    "sysl.fmt.format_real_plain" | "sysl.fmt.format_f32_plain" | "sysl.fmt.format_f128_plain" -> true
    _ -> false

@noinline
private library_render(r: &EvRun, at: Span, shown: string, vals: Buf[Const]) -> Flow
    val text = shown match
        "sysl.fmt.format_int" ->
            format_int(wide_arg(vals, 0), small_arg(vals, 1), text_arg(vals, 2), small_arg(vals, 3),
                       small_arg(vals, 4))
        "sysl.fmt.format_str" -> format_str(text_arg(vals, 0), text_arg(vals, 1), small_arg(vals, 2), small_arg(vals, 3))
        "sysl.fmt.format_real" -> format_real(real_arg(vals, 0), text_arg(vals, 1), small_arg(vals, 2), small_arg(vals, 3))
        "sysl.fmt.format_f32" -> format_f32(f32(real_arg(vals, 0)), text_arg(vals, 1), small_arg(vals, 2), small_arg(vals, 3))
        "sysl.fmt.format_f128" -> format_f128(quad_arg(vals, 0), text_arg(vals, 1), small_arg(vals, 2), small_arg(vals, 3))
        "sysl.fmt.format_real_plain" -> format_real_plain(real_arg(vals, 0))
        "sysl.fmt.format_f32_plain" -> format_f32_plain(f32(real_arg(vals, 0)))
        "sysl.fmt.format_f128_plain" -> format_f128_plain(quad_arg(vals, 0))
        _ ->
            format_fixed(wide_arg(vals, 0), small_arg(vals, 1), flag_arg(vals, 2), small_arg(vals, 3),
                         text_arg(vals, 4), small_arg(vals, 5), small_arg(vals, 6))

    built(r, at, text)
end library_render

private real_arg(vals: Buf[Const], i: usize) -> real = vals.at(i) match
    ConstFloat(f) -> f
    _ -> 0.0

// A binary128 argument from the two halves of its bits, which is how the evaluator holds one.
private quad_arg(vals: Buf[Const], i: usize) -> f128 = vals.at(i) match
    ConstQuad(hi, lo) -> f128.from_bits((u128(hi) << 64) | u128(lo))
    _ -> f128.from_bits(0)

// -- a value rendered through its `Display` --------------------------------------------------------

// `str(v)`, and a hole, over a value whose type supplies its own rendering: the `display` it names
// runs here with a writer of the evaluation's own, a growable buffer as the program's is, and what
// lands in it becomes the string. Through a trait object the `display` is chosen at run time.
@noinline
private render(r: &EvRun, at: Span, value: TExpr, method: string, spec: TExpr, slot: Option[int]) -> Flow
    val held = eval_value(r, value) match
        Ok(v) -> v
        Err(f) -> return f

    // Through a trait object, the method is the one its table holds in the slot, handed the value
    // the way that method takes it.
    val (shown, routine) = if slot.is_none() then (held, method) else
        held match
            ConstErased(name, data) -> vtable_named(r, name) match
                Some(vt) ->
                    val target = vt.slots.at(usize(slot.unwrap()))

                    target.recv match
                        ByValue -> *data match
                            ConstPtr(cells, i, _) -> (cells.at(i), target.target)
                            other -> return through_unowned(r, value.span, other)
                        _ -> (*data, target.target)
                None -> return refuse_form(r, at, s"the table '$name', which this compilation does not have")
            other -> return through_unowned(r, value.span, other)

    val fmt = eval_value(r, spec) match
        Ok(v) -> v
        Err(f) -> return f

    val k = r.writers.len()

    r.writers.push(byte_sink())

    var vals: Buf[Const] = buf()

    vals.push(shown)
    vals.push(ConstWriter(int(k)))
    vals.push(fmt)

    val flow = run_call(r, at, routine, vals)
    val sink = r.writers.at(k)

    r.writers.truncate(k)

    flow match
        EvStop -> EvStop
        _ -> built(r, at, from_utf8_unchecked(sink.text()))
end render

// A call through the writer a rendering was handed: `write` appends the bytes, and `failed` is false,
// since a buffer that grows has nothing to fail at. Any other trait object is not made while
// compiling, so there is nothing else for a call through one to reach.
@noinline
private writer_call(r: &EvRun, at: Span, receiver: TExpr, args: Buf[TExpr]) -> Flow
    val k = eval_value(r, receiver) match
        Ok(ConstWriter(n)) -> usize(n)
        Ok(_) -> return refuse_form(r, at, "a call through a trait object is not evaluated while compiling")
        Err(f) -> return f

    if args.len() == 0 then return EvGave(ConstBool(false))

    val bytes = eval_value(r, args.at(0)) match
        Ok(v) -> byte_list(v)
        Err(f) -> return f

    if bytes.is_none() then return refuse_form(r, at, "a write of something other than bytes")

    var out = r.writers.at(k)

    out.write(bytes.unwrap().view())
    EvNone
end writer_call

// The library's routines a `display` writes through, and the `display` of each type the library
// renders itself -- run by the compiler as the program runs them, into the evaluation's writer.
writer_routine(shown: string) -> bool = shown match
    "sysl.display_fill" | "sysl.display_pad" | "sysl.display_digits" | "sysl.display_str" -> true
    "sysl.display_int" | "sysl.display_uint" | "sysl.display_bool" | "sysl.display_char" -> true
    "sysl.display_real" | "sysl.display_f32" | "sysl.display_f128" -> true
    "sysl.display_real_shortest" | "sysl.display_f32_shortest" | "sysl.display_f128_shortest" -> true
    "bool.display" | "char.display" | "string.display" | "real.display" | "f32.display" | "f128.display" -> true
    "bound.sysl.Integer.display" -> true
    _ -> false

@noinline
private writer_render(r: &EvRun, at: Span, shown: string, vals: Buf[Const]) -> Flow
    val at_writer: usize = if shown == "sysl.display_fill" then 0 else 1

    val k = vals.at(at_writer) match
        ConstWriter(n) -> usize(n)
        _ -> return refuse_form(r, at, "a rendering into a writer other than the one it was handed")

    var out = r.writers.at(k)
    val fmt = spec_of(vals)

    shown match
        "sysl.display_fill" -> display_fill(&out, u8(small_arg(vals, 1)), small_arg(vals, 2))
        "sysl.display_pad" -> display_pad(byte_list(vals.at(0)).unwrap_or(buf()).view(), &out, fmt)
        "sysl.display_digits" -> display_digits(byte_list(vals.at(0)).unwrap_or(buf()).view(), &out, fmt)
        "sysl.display_str" | "string.display" -> display_str(text_arg(vals, 0), &out, fmt)
        "sysl.display_int" -> display_int(long(wide_arg(vals, 0)), &out, fmt)
        "sysl.display_uint" -> display_uint(ulong(wide_arg(vals, 0)), &out, fmt)
        "sysl.display_bool" | "bool.display" -> display_bool(flag_arg(vals, 0), &out, fmt)
        "sysl.display_char" | "char.display" -> display_char(char_arg(vals, 0), &out, fmt)
        "sysl.display_real" | "real.display" -> display_real(real_arg(vals, 0), &out, fmt)
        "sysl.display_f32" | "f32.display" -> display_f32(f32(real_arg(vals, 0)), &out, fmt)
        "sysl.display_f128" | "f128.display" -> display_f128(quad_arg(vals, 0), &out, fmt)
        "sysl.display_real_shortest" -> display_real_shortest(real_arg(vals, 0), &out, fmt)
        "sysl.display_f32_shortest" -> display_f32_shortest(f32(real_arg(vals, 0)), &out, fmt)
        "sysl.display_f128_shortest" -> display_f128_shortest(quad_arg(vals, 0), &out, fmt)
        // Every integer renders as its decimal digits under `display_digits`, whatever its width.
        _ ->
            val digits = vals.at(0) match
                ConstInt(n) -> to_string(n)
                _ -> return refuse_form(r, at, s"'$shown' over this value is not evaluated while compiling")

            display_digits(digits.bytes, &out, fmt)

    EvNone
end writer_render

// The `FormatSpec` a rendering routine was handed, which is its last argument.
private spec_of(vals: Buf[Const]) -> FormatSpec = vals.at(vals.len() - 1) match
    ConstRecord(_, fields) -> FormatSpec(small_arg(fields, 0), small_arg(fields, 1), flag_arg(fields, 2))
    _ -> FormatSpec(0, -1, false)

private char_arg(vals: Buf[Const], i: usize) -> char = vals.at(i) match
    ConstChar(c) -> c
    ConstInt(n) -> char(u32(n.to_long().unwrap_or(0)))
    _ -> char(0)

// The bytes a string, a slice of bytes or an array of them holds.
private byte_list(v: Const) -> Option[Buf[u8]]
    var out: Buf[u8] = buf()

    val (xs, lo, n) = v match
        ConstStr(s) ->
            for b in s.bytes do out.push(b)
            return Some(out)
        ConstView(found, from, count, _) -> (found, from, count)
        ConstArray(found) -> (found, usize(0), found.len())
        _ -> return None

    for i in 0..<n
        xs.at(lo + i) match
            ConstInt(x) -> out.push(u8(x.to_long().unwrap_or(0)))
            _ -> return None

    Some(out)
end byte_list

private small_arg(vals: Buf[Const], i: usize) -> int = vals.at(i) match
    ConstInt(n) -> int(n.to_long().unwrap_or(0))
    _ -> 0

private text_arg(vals: Buf[Const], i: usize) -> string = vals.at(i) match
    ConstStr(s) -> s
    _ -> ""

private flag_arg(vals: Buf[Const], i: usize) -> bool = vals.at(i) match
    ConstBool(b) -> b
    _ -> false

// An integer argument at `i128`, which is the width the renderers take every integer at.
private wide_arg(vals: Buf[Const], i: usize) -> i128
    val n = vals.at(i) match
        ConstInt(x) -> x
        _ -> return 0

    val narrow = n.to_long()

    if narrow.is_some() then return i128(narrow.unwrap())

    // Past a `long`: the high 64 bits (rounded toward negative infinity), then the low 64 in halves.
    val high = big_shr(n, 64)
    val rest = sub(n, big_shl(high, 64))
    val mid = big_shr(rest, 32)
    val low = sub(rest, big_shl(mid, 32))

    (i128(high.to_long().unwrap_or(0)) << 64) | (i128(mid.to_long().unwrap_or(0)) << 32) |
        i128(low.to_long().unwrap_or(0))
end wide_arg

// -- structs and enums -------------------------------------------------------------------------------
//
// **A struct and an enum value are held by value too, as their fields** -- a struct's in declaration
// order, an enum value's beside the position of its variant -- so they nest in arrays, and arrays in
// them, at any depth, and come back laid down as the constructor over literals they make.

// Where a variant sits among its enum's, which is what a held value names it by.
private variant_position(enum_ty: Type, variant: EnumVariant) -> int = underlying(enum_ty) match
    Enum(d) ->
        for i in 0..<d.variants.len()
            if d.variants.at(i).name == variant.name then return int(i)

        -1
    _ -> -1

// A struct or enum value built from its fields' values.
@noinline
private record_new(r: &EvRun, at: Span, variant: int, args: Buf[TExpr], ty: Type) -> Flow
    val why = unheld(ty)

    if why.is_some() then return refuse_form(r, at, why.unwrap())

    if variant < -1 then return refuse_form(r, at, s"a '${type_show(ty)}' is not evaluated while compiling yet")

    var out: Buf[Const] = buf()

    for arg in args
        eval_value(r, arg) match
            Ok(v) -> out.push(copied(v))
            Err(f) -> return f

    EvGave(ConstRecord(variant, out))
end record_new

// **A union is held as the field it was built with**: a record whose variant is `-2 - i` for the `i`th
// field, with that field's value at its position and a stand-in at every other. Evaluation has a value
// model, not a byte model, so it has no answer for what another field's bytes would read as.
private union_variant(i: int) -> int = -2 - i

private union_written(variant: int) -> int = -2 - variant

// `U(f = v)`: the one value, at its field's position.
@noinline
private union_new(r: &EvRun, at: Span, decl: &StructType, args: Buf[TExpr]) -> Flow
    val why = unheld(Struct(decl))

    if why.is_some() then return refuse_form(r, at, why.unwrap())

    var written = 0
    var out: Buf[Const] = buf()

    for i in 0..<args.len()
        *args.at(i).kind match
            TUnitLit -> out.push(ConstBool(false))
            _ ->
                written = int(i)

                eval_value(r, args.at(i)) match
                    Ok(v) -> out.push(copied(v))
                    Err(f) -> return f

    EvGave(ConstRecord(union_variant(written), out))
end union_new

// What a read through a field other than the one a union was built with is told.
private union_cross_read(t: Type, written: int, index: int) -> string = underlying(t) match
    Struct(d) ->
        s"evaluation while compiling reads a union only through the field it was built with — this " +
            s"'${type_show(t)}' was built with '${d.fields.at(usize(written)).0}', and " +
            s"'${d.fields.at(usize(index)).0}' would read its bytes as another type"
    _ -> "evaluation while compiling reads a union only through the field it was built with"

// `s.f`, read: the struct is read where it is held, without a copy.
@noinline
private field_read(r: &EvRun, receiver: TExpr, index: int) -> Flow
    eval_value(r, receiver) match
        Ok(ConstRecord(-1, fields)) -> EvGave(fields.at(usize(index)))
        Ok(ConstRecord(v, fields)) if v <= -2 ->
            if union_written(v) == index then EvGave(fields.at(usize(index)))
            else refuse_form(r, receiver.span, union_cross_read(texpr_type(receiver), union_written(v), index))
        Ok(ConstLink(_)) -> refuse_form(r, receiver.span, link_reason())
        Ok(_) -> refuse_form(r, receiver.span, s"a field of a '${type_show(texpr_type(receiver))}' is not " +
                             "evaluated while compiling yet — a struct's is")
        Err(f) -> f
end field_read

// A struct with an `invariant`, made: the clauses are run over its fields, and a value they do not
// hold for traps, as the construction would where the program ran.
@noinline
private invariant_check(r: &EvRun, at: Span, value: TExpr, decl: &StructType, inv_fn: string) -> Flow
    val v = eval_value(r, value) match
        Ok(x) -> x
        Err(f) -> return f

    holds_invariant(r, at, v, decl, inv_fn).unwrap_or(EvGave(v))
end invariant_check

// A write into a struct with an `invariant`, or a call through it: the write first, then the clauses
// over the struct it could have changed.
@noinline
private recheck(r: &EvRun, at: Span, after: TExpr, recv: TExpr, decl: &StructType, inv_fn: string) -> Flow
    val f = eval(r, after)

    f match
        EvGave(_) -> ()
        EvNone -> ()
        _ -> return f

    val v = eval_value(r, recv) match
        Ok(x) -> x
        Err(stop) -> return stop

    holds_invariant(r, at, v, decl, inv_fn).unwrap_or(f)
end recheck

// Nothing where a struct's clauses hold for it; the trap, or what stopped the clauses, where not.
@noinline
private holds_invariant(r: &EvRun, at: Span, v: Const, decl: &StructType, inv_fn: string) -> Option[Flow]
    val fields = v match
        ConstRecord(-1, found) -> found
        _ -> return Some(refuse_form(r, at, "an 'invariant' over something that is not a struct"))

    run_call(r, at, inv_fn, fields) match
        EvGave(ConstBool(true)) -> None
        EvGave(ConstBool(false)) ->
            Some(trap(r, at, s"the 'invariant' of '${decl.name()}' does not hold for ${value_text(v, Struct(decl))}"))
        other -> Some(other)
end holds_invariant

// Whether an enum value is the variant a pattern names, binding what the pattern's fields bind.
@noinline
private variant_matches(r: &EvRun, enum_ty: Type, variant: EnumVariant, args: Buf[TPattern],
                        v: Const) -> Result[bool, Flow]
    val fields = v match
        ConstRecord(at, found) ->
            if at != variant_position(enum_ty, variant) then return Ok(false)

            found
        _ -> return Err(refuse_form(r, span_zero(), "a variant pattern over something that is not an enum value"))

    fields_match(r, args, fields)
end variant_matches

// Whether each field matches its pattern, in order, binding as they go.
private fields_match(r: &EvRun, args: Buf[TPattern], fields: Buf[Const]) -> Result[bool, Flow]
    for i in 0..<args.len()
        matches(r, args.at(i), fields.at(i)) match
            Ok(true) -> ()
            other -> return other

    Ok(true)
end fields_match

// A container subscript's index read as the `usize` its method takes: a negative one, or one past
// what a `usize` holds, traps, as it would where the program ran.
@noinline
private subscript_index(r: &EvRun, operand: TExpr, ty: Type) -> Flow
    val n = eval_value(r, operand) match
        Ok(ConstInt(k)) -> k
        Ok(_) -> return refuse_form(r, operand.span, "an index that is not an integer")
        Err(f) -> return f

    if cmp(n, from_int(0)) < 0 then return trap(r, operand.span, s"index ${to_string(n)} is negative")

    val bits = underlying(ty) match
        Integer(b, _, _) -> b
        _ -> 64

    if cmp(n, big_shl(from_int(1), usize(bits))) >= 0 then
        return trap(r, operand.span, s"index ${to_string(n)} does not fit in usize")

    EvGave(ConstInt(n))
end subscript_index

// `a.checked_add(b)` and its siblings (`library/sysl/checked.sysl`), evaluated exactly: the true
// answer is computed at no width at all and the option says whether it fits the receiver's.
@noinline
private checked_member(r: &EvRun, at: Span, op: string, operand: TExpr, amount: Option[TExpr],
                       width: Type, ty: Type) -> Flow
    val (bits, signed) = width match
        Integer(b, s, _) -> (b, s)
        _ -> return refuse_form(r, at, s"'$op' is not evaluated while compiling yet")

    val a = eval_value(r, operand) match
        Ok(ConstInt(n)) -> n
        Ok(_) -> return refuse_form(r, at, s"'$op' is not evaluated while compiling yet")
        Err(f) -> return f

    var b = from_int(0)

    if amount.is_some()
        eval_value(r, amount.unwrap()) match
            Ok(ConstInt(n)) -> b = n
            Ok(_) -> return refuse_form(r, at, s"'$op' is not evaluated while compiling yet")
            Err(f) -> return f
    end if

    val zero = from_int(0)
    val divides = cmp(b, zero) != 0
    val exact: Option[BigInt] = op match
        "checked_add" -> Some(add(a, b))
        "checked_sub" -> Some(sub(a, b))
        "checked_mul" -> Some(big_mul(a, b))
        "checked_div" -> if divides then Some(big_div_rem(a, b).0) else None
        "checked_rem" -> if divides then Some(big_div_rem(a, b).1) else None
        _ -> Some(negate(a))

    // The remainder's one refusal is the divide's: `min % -1` is zero, but no machine computes it.
    val min = base_min(bits, signed)
    val traps = op == "checked_rem" && signed && cmp(a, min) == 0 && cmp(b, from_int(-1)) == 0
    val fits = exact.is_some() && !traps && cmp(exact.unwrap(), min) >= 0 &&
        cmp(exact.unwrap(), base_max(bits, signed)) <= 0

    var parts: Buf[Const] = buf()

    if fits then parts.push(ConstInt(exact.unwrap()))

    val variant = underlying(ty) match
        Enum(d) -> d.variant(if fits then "Some" else "None")
        _ -> None

    if variant.is_none() then return refuse_form(r, at, s"'$op' is not evaluated while compiling yet")

    EvGave(ConstRecord(variant_position(ty, variant.unwrap()), parts))
end checked_member

// `x.bits` and `T::Bits(n)`: the same integer, read at the other type.
@noinline
private fixed_bits(r: &EvRun, operand: TExpr, ty: Type) -> Flow
    val (bits, _, signed) = fixed_format(ty).unwrap_or((64, 0, true))

    eval_value(r, operand) match
        Ok(ConstInt(n)) -> EvGave(ConstInt(wrap(n, bits, signed)))
        Ok(_) -> refuse_form(r, operand.span, "the bits of a value that is not fixed-point")
        Err(f) -> f
end fixed_bits

@noinline
private load(r: &EvRun, at: Span, name: string, ty: Type) -> Flow
    val cell = running(r).locals.get(name)

    if cell.is_some() then return EvGave(cell.unwrap().at(0))

    if underlying(ty) == Unit then return EvNone

    refuse_form(r, at, s"'$name' is read before anything was written to it")
end load

// Module storage read by a body: a `val` whose value is constant data is that value; storage filled
// while the program runs is not there yet.
@noinline
private global_value(r: &EvRun, at: Span, symbol: string, ty: Type, writable: bool) -> Flow
    val shown = qualified_name(symbol)
    val d = r.a.tables.vals.get(symbol)
    // The value a module binding takes apart is no name the reader wrote (`hoist.sysl`'s `held_once`).
    val said = if d.is_some() && is_held_whole(d.unwrap().name) then "the value the binding takes apart"
    else s"'$shown'"

    if writable then return refuse_form(r, at, s"$said is filled when the program runs")

    if d.is_none() || d.unwrap().init.is_none() then
        return refuse_form(r, at, s"$said is filled when the program runs")

    val ev = r.a.evaluation

    for item in ev.vals_reading
        if item == symbol then
            return refuse_form(r, at, s"'$shown' is read while its own value is being worked out")

    val base = underlying(ty)

    ev.vals_reading.push(symbol)

    // A string, an array, a struct or an enum value is what its initializer comes to when it is run
    // here, which is the value laid down for it: a literal, or a `const` call.
    if held_whole(base)
        val whole = whole_value(r.a, d.unwrap(), shown, ty)

        ev.vals_reading.truncate(ev.vals_reading.len() - 1)

        return whole match
            Some(v) -> EvGave(v)
            None -> refuse_form(r, at, s"$said is filled when the program runs")
    end if

    ev.asking += 1

    val folded = const_fold(analyzer_for(r.a, d.unwrap().scope), d.unwrap().init.unwrap())

    ev.asking -= 1

    // **An initializer the untyped fold cannot settle is run**, as a whole value's is: `B + 1` over
    // another `val B` reads `B` through here in turn, where the fold knows only a `const`'s name.
    val ran = if folded.is_none() && !is_quad(base) then whole_value(r.a, d.unwrap(), shown, ty) else None

    ev.vals_reading.truncate(ev.vals_reading.len() - 1)

    if ran.is_some() then return EvGave(ran.unwrap())

    // **An `f128` is read from the literal it was written as**, since the untyped fold above reads a
    // float through a `double`.
    if is_quad(base)
        return quad_of_init(d.unwrap().init.unwrap()) match
            Some((hi, lo)) -> EvGave(ConstQuad(hi, lo))
            None -> refuse_form(r, at, s"$said is filled when the program runs")
    end if

    folded match
        Some(ConstInt(n)) -> base match
            Integer(bits, signed, _) ->
                if fits(n, bits, signed) then EvGave(ConstInt(n))
                else refuse_form(r, at, s"$said is filled when the program runs")
            Floating(_, _) -> EvGave(ConstFloat(float_at(int_to_float(n, 64), ty)))
            _ -> refuse_form(r, at, s"$said is filled when the program runs")
        Some(ConstFloat(f)) -> EvGave(ConstFloat(float_at(f, ty)))
        Some(ConstBool(b)) -> EvGave(ConstBool(b))
        Some(ConstChar(c)) -> EvGave(ConstInt(from_int(long(u32(c)))))
        _ -> refuse_form(r, at, s"$said is filled when the program runs")
end global_value

// Whether module storage of this type is read by running its initializer rather than by folding it.
private held_whole(t: Type) -> bool = t match
    Str -> true
    Array(_, _) -> true
    Struct(_) -> true
    Enum(_) -> true
    _ -> false

// A module `val`'s value, by running its initializer in a run of its own -- typed at the storage's
// type, as the program types it -- or nothing where that run does not come to a value it holds.
@noinline
private whole_value(a: &Analysis, d: ValueDecl, shown: string, ty: Type) -> Option[Const]
    val typed = typed_call(analyzer_for(a, d.scope), d.init.unwrap(), Some(ty))

    if typed.is_none() then return None

    evaluate(a, d.scope, s"'$shown'", typed.unwrap()) match
        EvValue(Some(v)) -> if answer_refusal(v, ty).is_some() then None else Some(v)
        _ -> None
end whole_value

// The binary128 value an initializer written as a number literal, or a negated one, stands for.
private quad_of_init(e: Expr) -> Option[(u64, u64)] = *e.kind match
    FloatLit(text, _) -> quad_of_text(text)
    IntLit(digits, base, _) -> Some(quad_of_int(literal_value(digits, base)))
    Unary(op, operand) ->
        if op != "-" then return None

        quad_of_init(operand).map((q) -> quad_negated(q.0, q.1))
    _ -> None

@noinline
private unary(r: &EvRun, at: Span, op: string, operand: TExpr, ty: Type) -> Flow
    val v = eval_value(r, operand) match
        Ok(x) -> x
        Err(f) -> return f

    underlying(ty) match
        Vector(_, _) ->
            var out: Buf[Const] = buf()

            for x in lanes_of(v)
                unary_value(r, at, op, x, vector_lane_of(ty)) match
                    EvGave(y) -> out.push(y)
                    other -> return other

            EvGave(ConstArray(out))
        _ -> unary_value(r, at, op, v, ty)
end unary

// A unary operator applied to a value of a scalar type.
private unary_value(r: &EvRun, at: Span, op: string, v: Const, ty: Type) -> Flow
    v match
        ConstInt(n) -> underlying(ty) match
            Fixed(_, _, _) ->
                if op == "-" then EvGave(ConstInt(fixed_eval_negate(ty, n)))
                else refuse_form(r, at, s"'$op' on ${type_show(ty)}")
            Integer(bits, signed, _) ->
                if op == "-" then EvGave(ConstInt(wrap(negate(n), bits, signed)))
                else if op == "~" then EvGave(ConstInt(wrap(big_not(n), bits, signed)))
                else refuse_form(r, at, s"'$op' on ${type_show(ty)}")
            _ -> refuse_form(r, at, s"'$op' on ${type_show(ty)}")
        ConstFloat(f) ->
            if op == "-" then EvGave(ConstFloat(run_float_negate(f)))
            else refuse_form(r, at, s"'$op' on ${type_show(ty)}")
        ConstQuad(hi, lo) ->
            if op == "-"
                val (nh, nl) = quad_negated(hi, lo)

                EvGave(ConstQuad(nh, nl))
            else refuse_form(r, at, s"'$op' on ${type_show(ty)}")
        ConstBool(b) -> if op == "!" then EvGave(ConstBool(!b)) else refuse_form(r, at, s"'$op' on bool")
        _ -> refuse_form(r, at, s"'$op' on ${type_show(ty)}")
end unary_value

@noinline
private binary(r: &EvRun, at: Span, op: string, l: TExpr, rt: TExpr, ty: Type) -> Flow
    contracted_binary(fusing_of(r.a.tables.target), op, l, rt, ty) match
        Some((k, addend)) -> return ev_contracted(r, at, k, Some(addend), ConstUnset, ty)
        None -> ()

    val x = eval_value(r, l) match
        Ok(v) -> v
        Err(f) -> return f

    val y = eval_value(r, rt) match
        Ok(v) -> v
        Err(f) -> return f

    underlying(texpr_type(l)) match
        Vector(_, _) -> return lanewise(r, at, op, texpr_type(l), texpr_type(rt), ty, x, y)
        _ -> ()

    if fixed_arith_op(op, texpr_type(l), texpr_type(rt), ty) then
        return fixed_operate(r, at, op, texpr_type(l), texpr_type(rt), ty, x, y)

    operate(r, at, op, texpr_type(l), x, y, checked_op(op, l, rt))
end binary

// A contracted `±(a * b) ± c` (`fp_contract.sysl`), rounded once as the machine's fused instruction
// rounds it, lane by lane over a vector. The operands are read in the order they are written; an
// update's addend is the place's value, `held`, read before either factor.
@noinline
private ev_contracted(r: &EvRun, at: Span, k: Contraction, addend: Option[TExpr], held: Const, ty: Type) -> Flow
    var c = held

    if addend.is_some() && !k.product_first
        c = eval_value(r, addend.unwrap()) match
            Ok(v) -> v
            Err(f) -> return f

    val x = eval_value(r, k.a) match
        Ok(v) -> v
        Err(f) -> return f

    val y = eval_value(r, k.b) match
        Ok(v) -> v
        Err(f) -> return f

    if addend.is_some() && k.product_first
        c = eval_value(r, addend.unwrap()) match
            Ok(v) -> v
            Err(f) -> return f

    val bits = vector_lane_of(ty) match
        Floating(n, _) -> n
        _ -> 0

    underlying(ty) match
        Vector(_, _) ->
            val xs = lanes_of(x)
            val ys = lanes_of(y)
            val cs = lanes_of(c)
            var out: Buf[Const] = buf()

            for i in 0..<xs.len()
                fused_const(k, bits, xs.at(i), ys.at(i), cs.at(i)) match
                    Some(v) -> out.push(v)
                    None -> return refuse_form(r, at, s"a fused multiply-add on ${type_show(ty)}")

            EvGave(ConstArray(out))
        _ -> fused_const(k, bits, x, y, c) match
            Some(v) -> EvGave(v)
            None -> refuse_form(r, at, s"a fused multiply-add on ${type_show(ty)}")
end ev_contracted

private fused_const(k: Contraction, bits: int, x: Const, y: Const, z: Const) -> Option[Const] = (x, y, z) match
    (ConstFloat(a), ConstFloat(b), ConstFloat(c)) -> Some(ConstFloat(fused_parts(k, bits, a, b, c)))
    _ -> None

// Whether an operator is fixed-point arithmetic: one of its operands or its result is fixed-point,
// and it is not a comparison, which is on the raw values of one format.
private fixed_arith_op(op: string, lt: Type, rt: Type, ty: Type) -> bool =
    (op == "+" || op == "-" || op == "*" || op == "/" || op == "<<" || op == ">>" || is_wrap_sat_op(op)) &&
    (is_fixed(lt) || is_fixed(rt) || is_fixed(ty))

// Fixed-point arithmetic over the raw values (`const_fixed.sysl`).
@noinline
private fixed_operate(r: &EvRun, at: Span, op: string, lt: Type, rt: Type, ty: Type, x: Const,
                      y: Const) -> Flow
    val (a, b) = (x, y) match
        (ConstInt(p), ConstInt(q)) -> (p, q)
        _ -> return refuse_form(r, at, s"'$op' on ${type_show(lt)} and ${type_show(rt)}")

    fixed_eval_binary(op, lt, rt, ty, a, b) match
        Ok(v) -> EvGave(ConstInt(v))
        Err(why) ->
            if is_trap_text(why) then trap(r, at, why)
            else refuse_form(r, at, s"$why is not evaluated while compiling yet")
end fixed_operate

// Whether an operator is the overflow-checking form: a `within` operand makes it one.
@noinline
private checked_op(op: string, l: TExpr, rt: TExpr) -> bool =
    if op == "<<" then is_ranged(texpr_type(l))
    else (op == "+" || op == "-" || op == "*") && (is_ranged(texpr_type(l)) || is_ranged(texpr_type(rt)))

// One binary operator over two values, the left operand being of type `lt`.
@noinline
private operate(r: &EvRun, at: Span, op: string, lt: Type, x: Const, y: Const,
                checked: bool) -> Flow
    val out = (x, y) match
        (ConstInt(a), ConstInt(b)) -> underlying(lt) match
            Integer(bits, signed, _) -> run_int_binary(op, a, b, bits, signed, checked)
            Char -> run_int_binary(op, a, b, 32, false, false)
            // Only a comparison reaches here: arithmetic is `fixed_operate`'s. One format's raw
            // values order as its values do.
            Fixed(bits, _, signed) -> run_int_binary(op, a, b, bits, signed, false)
            _ -> Err(s"'$op' on ${type_show(lt)}")
        (ConstFloat(a), ConstFloat(b)) -> underlying(lt) match
            Floating(16, brain) -> run_half_binary(op, a, b, brain)
            Floating(bits, _) -> run_float_binary(op, a, b, bits)
            _ -> Err(s"'$op' on ${type_show(lt)}")
        (ConstQuad(ah, al), ConstQuad(bh, bl)) -> run_quad_binary(op, (ah, al), (bh, bl))
        (ConstBool(a), ConstBool(b)) ->
            if op == "&" || op == "&&" then Ok(ConstBool(a && b))
            else if op == "|" || op == "||" then Ok(ConstBool(a || b))
            else if op == "^" || op == "!=" then Ok(ConstBool(a != b))
            else if op == "==" then Ok(ConstBool(a == b))
            else Err(s"'$op' on bool")
        // A bare enum's own `==`: the same variant.
        (ConstRecord(a, _), ConstRecord(b, _)) -> underlying(lt) match
            Enum(d) ->
                if !d.simple then Err(s"'$op' on ${type_show(lt)}")
                else if op == "==" then Ok(ConstBool(a == b))
                else if op == "!=" then Ok(ConstBool(a != b))
                else Err(s"'$op' on ${type_show(lt)}")
            _ -> Err(s"'$op' on ${type_show(lt)}")
        (ConstStr(a), ConstStr(b)) -> return str_operate(r, at, op, a, b)
        (ConstPtr(_, _, _), _) -> same_address(op, x, y, lt)
        (ConstLink(_), _) -> same_address(op, x, y, lt)
        (ConstPun(_, _), _) -> same_address(op, x, y, lt)
        _ -> Err(s"'$op' on ${type_show(lt)}")

    out match
        Ok(v) -> EvGave(v)
        Err(why) ->
            // Two kinds of `Err` come back: a trap, and an operator that is not one of these types'.
            // Only the run-time arithmetic traps, and every trap it answers names the operation.
            if is_trap_text(why) then trap(r, at, why)
            else refuse_form(r, at, s"$why is not evaluated while compiling yet")
end operate

// Two addresses compared, which only `==` and `!=` do while compiling: the same slot of the same
// storage, or the same storage the linker fills in. A slot the evaluation owns is never at an address
// the linker fills in, nor at null; where two such addresses fall in memory is the linker's to say.
private same_address(op: string, x: Const, y: Const, lt: Type) -> Result[Const, string]
    if op != "==" && op != "!=" then return Err(s"'$op' on ${type_show(lt)}")

    val same = (unpunned(x), unpunned(y)) match
        (ConstPtr(xs, i, _), ConstPtr(ys, j, _)) -> usize(&xs.elems[i]) == usize(&ys.elems[j])
        (ConstLink(a), ConstLink(b)) -> link_key(a) == link_key(b)
        _ -> false

    Ok(ConstBool(if op == "==" then same else !same))
end same_address

// The address under any conversions to other pointer types.
private unpunned(v: Const) -> Const = v match
    ConstPun(addr, _) -> *addr
    _ -> v

// Whether what the arithmetic answered is a trap rather than an operator it does not have.
private is_trap_text(why: string) -> bool =
    why.contains("overflows") || why.contains("by zero") || why.contains("Unicode")

@noinline
private logical(r: &EvRun, at: Span, op: string, l: TExpr, rt: TExpr) -> Flow
    val a = eval_bool(r, l) match
        Ok(b) -> b
        Err(f) -> return f

    if op == "&&" && !a then return EvGave(ConstBool(false))
    if op == "||" && a then return EvGave(ConstBool(true))

    eval_bool(r, rt) match
        Ok(b) -> EvGave(ConstBool(b))
        Err(f) -> f
end logical

// `a < b <= c`: each link compared in turn, and the chain false at the first link that is.
@noinline
private compare_chain(r: &EvRun, at: Span, operands: Buf[TExpr], cmps: Buf[TCmp]) -> Flow
    var left = eval_value(r, operands.at(0)) match
        Ok(v) -> v
        Err(f) -> return f

    for i in 0..<cmps.len()
        if cmps.at(i).dispatch.is_some() then
            return refuse_form(r, at, s"'${cmps.at(i).op}' through an implementation is not evaluated " +
                               "while compiling yet")

        val right = eval_value(r, operands.at(i + 1)) match
            Ok(v) -> v
            Err(f) -> return f

        val verdict = operate(r, at, cmps.at(i).op, texpr_type(operands.at(i)), left, right, false)

        verdict match
            EvGave(ConstBool(false)) -> return verdict
            EvGave(ConstBool(true)) -> ()
            _ -> return verdict

        left = right

    EvGave(ConstBool(true))
end compare_chain

@noinline
private cast(r: &EvRun, at: Span, operand: TExpr, ty: Type) -> Flow
    val v = eval_value(r, operand) match
        Ok(x) -> x
        Err(f) -> return f

    val why = unheld(ty)

    if why.is_some() then return refuse_form(r, at, why.unwrap())

    // An address stays the address it is under another pointer type; as a number it is something
    // only the linker knows.
    v match
        ConstLink(_) ->
            return underlying(ty) match
                Ptr(_) -> EvGave(v)
                CFn(_, _) -> EvGave(v)
                _ -> refuse_form(r, at, "an address converted to a number is not evaluated while compiling — " +
                                 "the linker fills an address in, so its value exists only when the " +
                                 "program runs")
        // A slot stays the slot it is under a reference or pointer to the same type, and is the same
        // address under one to another type -- which may be compared, and converted back, but not read
        // through. As a number it is where storage falls in memory, decided when the program runs.
        ConstPtr(_, _, _) -> return punned(r, at, v, texpr_type(operand), ty)
        ConstPun(addr, as_was) -> return punned(r, at, *addr, *as_was, ty)
        _ -> ()

    // A bare enum converts as the integer its variant's tag is, at the enum's underlying type.
    val (held, from) = (v, underlying(texpr_type(operand))) match
        (ConstRecord(i, _), Enum(d)) -> (ConstInt(d.variants.at(usize(i)).tag), underlying(d.underlying))
        pair -> pair

    val converted = fixed_eval_convert(held, texpr_type(operand), ty).unwrap_or(run_convert(held, from, underlying(ty)))

    converted match
        Ok(out) -> EvGave(out)
        Err(message) ->
            if is_trap_text(message) then trap(r, at, message)
            else refuse_form(r, at, s"$message is not evaluated while compiling yet")
end cast

// An address the run owns, taken at `from` and converted to `ty`.
private punned(r: &EvRun, at: Span, addr: Const, from: Type, ty: Type) -> Flow =
    (pointee(from), pointee(ty)) match
        (Some(was), Some(to)) ->
            if underlying(was) == underlying(to) then EvGave(addr) else EvGave(ConstPun(addr, from))
        _ -> refuse_form(r, at, "an address converted to a number is not evaluated while compiling — " +
                         "where storage falls in memory is decided when the program runs")

// `sysl.math.ByteOrder`'s members, which reorder the bytes of a value already in hand -- the one
// family of compiler-provided members a constant is computed with. The direction is the target's,
// read off the layout every constant is folded against.
@noinline
// An operation of the `Bits` or `Signed` trait on an integer -- a count, a reversal, a rotation, `abs`
// or `signum` -- answered as the program's instructions answer it (`int_op_value`).
private bit_operation(r: &EvRun, at: Span, op: string, operand: TExpr, amount: Option[TExpr],
                      width: Type) -> Flow
    if amount.is_none() && byte_order_op(op) then return byte_order(r, at, op, operand, width)

    val v = eval_value(r, operand) match
        Ok(x) -> x
        Err(f) -> return f

    var by: Option[BigInt] = None

    if amount.is_some()
        eval_value(r, amount.unwrap()) match
            Ok(ConstInt(k)) -> by = Some(k)
            Ok(_) -> return refuse_form(r, at, s"'$op' is not evaluated while compiling yet")
            Err(f) -> return f
    end if

    v match
        ConstInt(n) -> width match
            Integer(bits, signed, _) -> int_op_value(op, n, bits, signed, by) match
                Some(out) -> EvGave(ConstInt(out))
                None -> refuse_form(r, at, s"'$op' is not evaluated while compiling yet")
            _ -> refuse_form(r, at, s"'$op' is not evaluated while compiling yet")
        _ -> refuse_form(r, at, s"'$op' is not evaluated while compiling yet")
end bit_operation

private byte_order_op(op: string) -> bool =
    op == "swap_bytes" || op == "to_be" || op == "from_be" || op == "to_le" || op == "from_le"

private byte_order(r: &EvRun, at: Span, op: string, operand: TExpr, width: Type) -> Flow
    val little = r.a.tables.layout.little_endian
    val swaps = op match
        "swap_bytes" -> true
        "to_be" -> little
        "from_be" -> little
        "to_le" -> !little
        "from_le" -> !little
        _ -> return refuse_form(r, at, s"'$op' is not evaluated while compiling yet")

    val v = eval_value(r, operand) match
        Ok(x) -> x
        Err(f) -> return f

    v match
        ConstInt(n) -> width match
            Integer(bits, signed, _) -> EvGave(if swaps then ConstInt(swapped_bytes(n, bits, signed)) else v)
            _ -> refuse_form(r, at, s"'$op' is not evaluated while compiling yet")
        _ -> refuse_form(r, at, s"'$op' is not evaluated while compiling yet")
end byte_order

// The ends of a `within` range, as the numbers the checks compare against.
private int_end(e: RangeEnd) -> BigInt = decimal_int(finite_end(e))

private ev_float_end(e: RangeEnd) -> real = e match
    EndAt(d) -> real_of_bits(double_bits(s"$d"))
    EndInfinite(negative) ->
        val inf = builtin_float("infinity").unwrap()

        if negative then -inf else inf

// An end of an `f128` range, read from its text at binary128 rather than through a `double`.
private ev_quad_end(e: RangeEnd) -> (u64, u64) = e match
    EndAt(d) -> quad_of_text(s"$d").unwrap_or(quad_nan())
    EndInfinite(negative) -> quad_infinity(negative)

// Whether a value is one a constrained type's range admits -- the checks a produce site runs.
private admitted(d: &ConstrainedType, v: Const) -> bool = v match
    ConstInt(n) ->
        val lo_ok = d.lo match
            Some(lo) -> cmp(n, int_end(lo)) >= 0
            None -> true
        val hi_ok = d.hi match
            Some(hi) -> if d.exclusive_hi then cmp(n, int_end(hi)) < 0 else cmp(n, int_end(hi)) <= 0
            None -> true

        lo_ok && hi_ok
    ConstFloat(f) ->
        val lo_ok = d.lo match
            Some(lo) -> f >= ev_float_end(lo)
            None -> true
        val hi_ok = d.hi match
            Some(hi) -> if d.exclusive_hi then f < ev_float_end(hi) else f <= ev_float_end(hi)
            None -> true

        lo_ok && hi_ok
    ConstQuad(qh, ql) ->
        val q = (qh, ql)
        val lo_ok = d.lo match
            Some(lo) -> quad_compare(q, ev_quad_end(lo)).map((c) -> c >= 0).unwrap_or(false)
            None -> true
        val hi_ok = d.hi match
            Some(hi) -> quad_compare(q, ev_quad_end(hi)).map((c) -> if d.exclusive_hi then c < 0 else c <= 0)
                .unwrap_or(false)
            None -> true

        lo_ok && hi_ok
    _ -> true

// The same two answers for module storage the analysis lays down as data (`analyze_body.sysl`'s
// `static_image`): whether a folded value is one a range admits, and the value as a reader writes it.
range_admits(d: &ConstrainedType, v: Const) -> bool = admitted(d, v)

shown_value(v: Const, t: Type) -> string = value_text(v, t)

@noinline
private constrained_check(r: &EvRun, at: Span, value: TExpr, target: Type) -> Flow
    val v = eval_value(r, value) match
        Ok(x) -> x
        Err(f) -> return f

    target match
        Constrained(d) ->
            if d.pred_fn.is_some() then
                return refuse_form(r, at, s"the 'where' predicate of '${type_show(target)}' is not " +
                                   "evaluated while compiling yet")

            if !admitted(d, v) then
                return trap(r, at, s"${value_text(v, target)} is not a value '${type_show(target)}' admits")

            EvGave(v)
        _ -> EvGave(v)
end constrained_check

@noinline
private constrained_valid(r: &EvRun, at: Span, value: TExpr, c: Type) -> Flow
    val v = eval_value(r, value) match
        Ok(x) -> x
        Err(f) -> return f

    c match
        Constrained(d) -> EvGave(ConstBool(admitted(d, v)))
        _ -> EvGave(ConstBool(true))
end constrained_valid

// `Succ` and `Pred`: one step along a range, which traps at its end.
@noinline
private constrained_step(r: &EvRun, at: Span, value: TExpr, c: Type, up: bool) -> Flow
    val v = eval_value(r, value) match
        Ok(x) -> x
        Err(f) -> return f

    val n = v match
        ConstInt(x) -> x
        _ -> return refuse_form(r, at, "a step along a range that is not of integers")

    c match
        Constrained(d) ->
            if up
                val last = d.hi match
                    Some(h) -> if d.exclusive_hi then sub(int_end(h), from_int(1)) else int_end(h)
                    None -> from_int(0)

                if cmp(n, last) >= 0 then
                    return trap(r, at, s"there is no value after ${to_string(n)} in '${type_show(c)}'")

                EvGave(ConstInt(add(n, from_int(1))))
            else
                val first = d.lo match
                    Some(l) -> int_end(l)
                    None -> from_int(0)

                if cmp(n, first) <= 0 then
                    return trap(r, at, s"there is no value before ${to_string(n)} in '${type_show(c)}'")

                EvGave(ConstInt(sub(n, from_int(1))))
        _ -> EvGave(v)
end constrained_step

// -- calls ------------------------------------------------------------------------------------------

@noinline
private call(r: &EvRun, at: Span, name: string, args: Buf[TExpr], results: bool) -> Flow
    if results then return refuse_form(r, at, "a call answering a list of results is not evaluated " +
                                       "while compiling yet")

    var vals: Buf[Const] = buf()

    for arg in args
        eval_value(r, arg) match
            Ok(v) -> vals.push(v)
            Err(f) -> return f

    call_with(r, at, name, vals)
end call

// A call whose arguments are worked out: the library's routines the compiler runs itself, or the
// body.
private call_with(r: &EvRun, at: Span, name: string, vals: Buf[Const]) -> Flow
    val shown = qualified_name(name)

    if const_renderer(shown) then return library_render(r, at, shown, vals)

    // A float's encoding and back, which the library writes as a read through a pointer.
    if float_bits_routine(name) && vals.len() == 1
        val folded = float_bits_folded(name, vals.at(0))

        if folded.is_some() then return EvGave(folded.unwrap())
    end if

    val routine = qualified_name(r.a.tables.members.func_origin.get(name).unwrap_or(name))

    if writer_routine(routine) then return writer_render(r, at, routine, vals)

    if frozen_routine(routine) then return frozen_call(r, at, routine, name, vals)

    run_call(r, at, name, vals)
end call_with

// -- trait objects ------------------------------------------------------------------------------------
//
// **A trait object is its value and its table** (`ConstErased`), and a call through it is the call of
// the slot's function -- a closure's `&Fn` the same way, its one slot being the closure's body.

// The table a trait object was made with: one the program has, or one a trial made and the
// evaluation kept.
private vtable_named(r: &EvRun, name: string) -> Option[TVtable]
    val kept = r.a.evaluation.vtables.get(name)

    if kept.is_some() then return kept

    r.a.tables.members.vtables.get(name)
end vtable_named

// A call through a trait object: the receiver handed over the way the slot's function takes it -- a
// copy of the value for `self`, the pointer for `*self` and `&self`.
@noinline
private dispatched(r: &EvRun, at: Span, receiver: TExpr, slot: int, args: Buf[TExpr], results: bool) -> Flow
    if results then
        return refuse_form(r, at, "a call answering a list of results is not evaluated while compiling yet")

    val (vt_name, data) = eval_value(r, receiver) match
        Ok(ConstErased(name, held)) -> (name, *held)
        Ok(ConstWriter(_)) -> return writer_call(r, at, receiver, args)
        Ok(v) -> return through_unowned(r, receiver.span, v)
        Err(f) -> return f

    val vt = vtable_named(r, vt_name) match
        Some(found) -> found
        None -> return refuse_form(r, at, s"a call through the table '$vt_name', which this compilation does not have")

    val target = vt.slots.at(usize(slot))
    var vals: Buf[Const] = buf()

    target.recv match
        ByValue -> data match
            ConstPtr(cells, i, _) -> vals.push(cells.at(i))
            other -> return through_unowned(r, receiver.span, other)
        _ -> vals.push(data)

    for arg in args
        eval_value(r, arg) match
            Ok(v) -> vals.push(v)
            Err(f) -> return f

    call_with(r, at, target.target, vals)
end dispatched

// -- atomics -------------------------------------------------------------------------------------------
//
// **An evaluation is one thread**, so an atomic operation on storage it owns is the plain operation:
// a load, a store, or a read-modify-write that answers the value it found. The arithmetic wraps, as
// the instruction's does; a compare-and-swap stores only where it found the value it was told to
// expect, and answers what it found either way.

@noinline
private atomic(r: &EvRun, at: Span, op: string, addr: TExpr, ops: Buf[TExpr], at_ty: Type) -> Flow
    val (xs, i) = eval_value(r, addr) match
        Ok(ConstPtr(cells, k, _)) -> (cells, k)
        Ok(v) -> return through_unowned(r, addr.span, v)
        Err(f) -> return f

    var vals: Buf[Const] = buf()

    for o in ops
        eval_value(r, o) match
            Ok(v) -> vals.push(v)
            Err(f) -> return f

    if op == "atomic_store"
        written_over(xs, i, vals.at(0))
        return EvNone
    end if

    val found = placed(r, addr.span, xs.at(i)) match
        EvGave(v) -> v
        f -> return f

    if op == "atomic_load" then return EvGave(found)

    if op == "atomic_swap"
        written_over(xs, i, vals.at(0))
        return EvGave(found)
    end if

    if op == "atomic_cas"
        operate(r, at, "==", at_ty, found, vals.at(0), false) match
            EvGave(ConstBool(true)) -> written_over(xs, i, vals.at(1))
            EvGave(_) -> ()
            f -> return f

        return EvGave(found)
    end if

    val symbol = op match
        "atomic_add" -> "+"
        "atomic_sub" -> "-"
        "atomic_and" -> "&"
        "atomic_or" -> "|"
        _ -> "^"

    operate(r, at, symbol, at_ty, found, vals.at(0), false) match
        EvGave(v) -> written_over(xs, i, v)
        f -> return f

    EvGave(found)
end atomic

// A value put behind a trait's table.
@noinline
private erased(r: &EvRun, operand: TExpr, vtable: string) -> Flow = eval_value(r, operand) match
    Ok(v) -> EvGave(ConstErased(vtable, v))
    Err(f) -> f

// What a downcast tests: the identity of the type behind the table.
@noinline
private erased_identity(r: &EvRun, receiver: TExpr) -> Flow = eval_value(r, receiver) match
    Ok(ConstErased(name, _)) -> vtable_named(r, name) match
        Some(vt) -> EvGave(ConstInt(vt.type_id))
        None -> refuse_form(r, receiver.span, s"the table '$name', which this compilation does not have")
    Ok(v) -> through_unowned(r, receiver.span, v)
    Err(f) -> f

// **A frozen buffer is made, and viewed, by reading words as other types** (`sysl.buf.Frozen`), which
// the evaluator does not hold values as -- so both are run here, to the values those words come to.
frozen_routine(shown: string) -> bool = shown == "sysl.buf.freeze_buf" || shown == "sysl.buf.Frozen.view"

// A `Frozen` is the elements' storage, a pointer to the first, and the count; the storage's owner word
// is 0, which is what a frozen buffer nothing frees has. Freezing copies the elements into storage
// sized to them and leaves the buffer empty, through every name it has, as the program's does.
@noinline
private frozen_call(r: &EvRun, at: Span, routine: string, name: string, vals: Buf[Const]) -> Flow
    if routine == "sysl.buf.Frozen.view"
        return vals.at(0) match
            ConstPtr(cells, i, _) -> cells.at(i) match
                ConstRecord(_, fields) -> (fields.at(1), fields.at(2)) match
                    (ConstPtr(xs, lo, _), ConstInt(n)) -> EvGave(ConstView(xs, lo, usize(n.to_long().unwrap_or(0)), -1))
                    (_, _) -> EvGave(ConstView(buf(), 0, 0, -1))
                _ -> refuse_form(r, at, "a frozen buffer the run did not make")
            _ -> refuse_form(r, at, "a frozen buffer the run did not make")
    end if

    // The buffer's core, which every name for the buffer shares.
    val core = vals.at(0) match
        ConstRecord(_, fields) -> fields.at(0)
        _ -> return refuse_form(r, at, "a buffer the run did not make")

    val (core_cells, core_at) = core match
        ConstPtr(xs, i, _) -> (xs, i)
        _ -> return refuse_form(r, at, "a buffer that names no storage")

    val (elems, lo, count) = core_cells.at(core_at) match
        ConstRecord(_, fields) -> (fields.at(0), fields.at(1)) match
            (ConstView(xs, from, _, _), ConstInt(n)) -> (xs, from, usize(n.to_long().unwrap_or(0)))
            _ -> return refuse_form(r, at, "a buffer the run did not make")
        _ -> return refuse_form(r, at, "a buffer the run did not make")

    val data_ty = r.a.tables.members.func_insts.get(name).map(sig -> frozen_data_type(sig.ret)).unwrap_or(Unknown)
    var items: Buf[Const] = buf()

    for i in 0..<count
        items.push(copied(elems.at(lo + i)))

    var fields: Buf[Const] = buf()

    fields.push(ConstInt(from_int(0)))

    if count == 0 then fields.push(ConstLink(TExpr(at, TNullLit(data_ty))))
    else fields.push(ConstPtr(items, 0, -1))

    fields.push(ConstInt(from_int(long(count))))

    // The buffer is left empty, through every name it has.
    var core_fields = core_cells.at(core_at) match
        ConstRecord(_, xs) -> xs
        _ -> buf()

    core_fields.set(1, ConstInt(from_int(0)))

    EvGave(ConstPtr(cell_of(ConstRecord(-1, fields)), 0, -1))
end frozen_call

// The type of a `Frozen`'s pointer to its first element, from the `&sync Frozen[T]` freezing answers.
private frozen_data_type(ret: Type) -> Type = pointee(ret) match
    Some(Struct(d)) -> d.fields.at(1).1
    _ -> Unknown

// The declaration an instantiation was made from, which is what a reader wrote.
private callee_origin(a: &Analysis, name: string) -> string =
    a.tables.members.func_origin.get(name).unwrap_or(name)

// A function's body typed for the evaluation, once, and kept -- or `None` where it has none here, or
// where typing it needs the value being worked out.
evaluation_body(a: &Analysis, name: string) -> Option[&TFunc]
    val ev = a.evaluation
    val kept = ev.bodies.get(name)

    if kept.is_some() then return kept

    for item in ev.typing
        if item == name then return None

    ev.typing.push(name)

    val typed = trial_body(a, name)

    ev.typing.truncate(ev.typing.len() - 1)

    if typed.is_none() then return None

    val kept_now: &TFunc = typed.unwrap()

    ev.bodies.put(name, kept_now)
    Some(kept_now)
end evaluation_body

// The body a call names, typed for the evaluation once and kept.
@noinline
private callee(r: &EvRun, at: Span, name: string) -> Option[&TFunc]
    val ev = r.a.evaluation
    val kept = ev.bodies.get(name)

    if kept.is_some() then return kept

    val caller = if r.frames.len() > 1 then s"'${qualified_name(running(r).func)}'" else "it"

    // A function nobody marked runs where its body can. A struct's `invariant` clauses are a
    // function the compiler made from them, and run wherever a value of the struct is made -- so they
    // run here too.
    if !name.ends_with(s"${ModuleSep}inv")
        val why = evaluable_refusal(r.a, name)

        if why.is_some()
            refuse_form(r, at, s"$caller calls '${qualified_name(callee_origin(r.a, name))}', " +
                        chained_reason(why.unwrap()))
            return None
        end if
    end if

    // The loop is found inside the reading of the body, which is a trial whose complaints are taken
    // back -- so it is told as one a thrown-away trial keeps.
    for item in ev.typing
        if item == name
            r.a.bound_fault(here(r), at, s"${r.subject} cannot be computed while compiling: the body of " +
                            s"'${qualified_name(name)}' is being read, and reading it needs ${r.subject}, " +
                            "which is worked out by running that body")

            if r.kind == EvRunning then r.kind = EvBodyBroken

            return None

    ev.typing.push(name)

    val typed = trial_body(r.a, name)

    ev.typing.truncate(ev.typing.len() - 1)

    if typed.is_none()
        if r.kind == EvRunning then r.kind = EvBodyBroken

        return None
    end if

    val kept_now: &TFunc = typed.unwrap()

    ev.bodies.put(name, kept_now)
    Some(kept_now)
end callee

@noinline
private run_call(r: &EvRun, at: Span, name: string, vals: Buf[Const]) -> Flow
    val found = callee(r, at, name)

    if found.is_none() then return EvStop

    val f = found.unwrap()
    val key = memo_key(name, vals)

    val frame = entered(r, at, name, vals, f, key) match
        Ok(fr) -> fr
        Err(fl) -> return fl

    val depth = int(r.frames.len())

    // A direct self-call is where a function's `variant` is checked: the measure over the arguments
    // about to be passed has to be below the measure over the parameters as they stand.
    val measured = f.variant.is_some() && running(r).func == name

    var before: Option[Const] = None

    if measured
        eval_value(r, f.variant.unwrap()) match
            Ok(v) -> before = Some(v)
            Err(fl) -> return fl
    end if

    r.frames.push(frame)

    val out = run_frame(r, at, f, measured, before)

    r.frames.truncate(r.frames.len() - 1)

    // A slice of the call's own storage would outlive it: the program's run moves that storage to
    // the heap where the slice escapes, which the evaluation does not follow. A pointer to it would
    // name storage that is gone, as it does when the program runs.
    val dangling = out match
        EvGave(v) -> dangles(v, depth)
        _ -> false

    if dangling then
        return refuse_form(r, at, s"'${qualified_name(name)}' answers a slice of, or a pointer to, storage " +
                           "local to its call, which ends when the call returns — what is answered while " +
                           "compiling may reach only what its caller handed in, the heap, or module storage")

    // A call handed a slice is not remembered: what it reads is wherever the slice points, which a
    // later call with an equal-looking slice need not find the same.
    if key == "" then return out

    // Nor is one that answered storage -- a box, or a slice of fresh elements: each call makes its
    // own, and two callers handed one would see each other's writes.
    out match
        EvGave(v) -> if !holds_view(v) then r.a.evaluation.memo.put(key, Some(v))
        EvNone -> r.a.evaluation.memo.put(key, None)
        _ -> ()

    out
end run_call

// The frame a call runs in, with its arguments bound -- or, where the call need not or may not run,
// what it comes to instead: the value an earlier run with the same arguments gave, or the refusal of
// a parameter or result the evaluator does not hold, or of a call nested too deep. Kept out of
// `run_call`, which sits on the stack once per call level, so its strings do not.
@noinline
private entered(r: &EvRun, at: Span, name: string, vals: Buf[Const], f: &TFunc,
                key: string) -> Result[&EvFrame, Flow]
    for param in f.params
        val why = unheld(param.1)

        if why.is_some() then return Err(refuse_form(r, at, why.unwrap()))

    val result_why = unheld(f.ret_ty)

    if result_why.is_some() then return Err(refuse_form(r, at, result_why.unwrap()))

    val known = if key == "" then None else r.a.evaluation.memo.get(key)

    if known.is_some() then return Err(gave(known.unwrap()))

    var shown = s"${qualified_name(name)}("

    for i in 0..<vals.len()
        shown = shown + (if i > 0 then ", " else "") + value_text(vals.at(i), f.params.at(i).1)

    shown = shown + ")"

    if r.frames.len() > EvDepthLimit then
        return Err(refuse_form(r, at, s"the calls nest more than 512 deep, at '$shown'"))

    val frame: &EvFrame = EvFrame(name, shown, at, here(r), func_home(r.a, name), map(), buf(), None, map())

    for i in 0..<f.params.len()
        frame.locals.put(f.params.at(i).0, cell_of(copied(vals.at(i))))

    Ok(frame)
end entered

// The body of a call whose frame is on top: the measure, the preconditions, the snapshots `old`
// reads, the body, and the postconditions.
@noinline
private run_frame(r: &EvRun, at: Span, f: &TFunc, measured: bool, before: Option[Const]) -> Flow
    val entry = preconditions(r, at, f, measured, before)

    if entry.is_some() then return entry.unwrap()

    val ran = block(r, f.body)

    val result = ran match
        EvGave(v) -> Some(v)
        EvNone -> None
        EvReturn(v) -> v
        _ -> return ran

    val exit = postconditions(r, f, result)

    if exit.is_some() then return exit.unwrap()

    gave(result)
end run_frame

// What a call checks before its body runs -- the measure, the preconditions -- and the snapshots
// `old` reads. Nothing where the body may run, and otherwise what stopped it.
@noinline
private preconditions(r: &EvRun, at: Span, f: &TFunc, measured: bool, before: Option[Const]) -> Option[Flow]
    val frame = r.frames.at(r.frames.len() - 1)

    if measured
        val after = eval_value(r, f.variant.unwrap()) match
            Ok(v) -> v
            Err(fl) -> return Some(fl)

        if !below(after, before.unwrap()) then
            return Some(trap(r, at, s"the 'variant' of '${qualified_name(f.name)}' did not decrease: " +
                             s"${value_text(after, texpr_type(f.variant.unwrap()))} is not below " +
                             s"${value_text(before.unwrap(), texpr_type(f.variant.unwrap()))}"))
    end if

    for item in f.requires
        val clause = item.cond

        if !names_ghost(r.a, clause)
            eval_bool(r, clause) match
                Ok(true) -> ()
                Ok(false) ->
                    return Some(trap(r, clause.span, s"a 'require' of '${qualified_name(f.name)}' failed"))
                Err(fl) -> return Some(fl)

    for item in f.olds
        eval_value(r, item) match
            Ok(v) -> frame.olds.push(v)
            Err(fl) -> return Some(fl)

    None
end preconditions

// What a call checks once its body has come to `result`: the postconditions, which read it.
@noinline
private postconditions(r: &EvRun, f: &TFunc, result: Option[Const]) -> Option[Flow]
    r.frames.at(r.frames.len() - 1).result = result

    for item in f.ensures
        val clause = item.cond

        if !names_ghost(r.a, clause)
            eval_bool(r, clause) match
                Ok(true) -> ()
                Ok(false) ->
                    return Some(trap(r, clause.span, s"an 'ensure' of '${qualified_name(f.name)}' failed"))
                Err(fl) -> return Some(fl)

    None
end postconditions

// Whether one measure is below another.
private below(a: Const, b: Const) -> bool = (a, b) match
    (ConstInt(x), ConstInt(y)) -> cmp(x, y) < 0
    (ConstFloat(x), ConstFloat(y)) -> x < y
    (ConstQuad(xh, xl), ConstQuad(yh, yl)) -> quad_compare((xh, xl), (yh, yl)) == Some(-1)
    _ -> false

// The key a run of a callee is kept by: the callee, and each argument's exact value.
@noinline
private memo_key(name: string, vals: Buf[Const]) -> string
    if any_view(vals) then return ""

    var out = name

    for i in 0..<vals.len()
        out = out + "|" + key_part(vals.at(i))

    out
end memo_key

private key_part(v: Const) -> string = v match
    ConstInt(n) -> to_string(n)
    ConstFloat(f) -> s"f${float_pattern_exact(f)}"
    ConstQuad(hi, lo) -> s"q${hi}_$lo"
    ConstBool(b) -> if b then "t" else "f"
    ConstChar(c) -> s"c${u32(c)}"
    ConstStr(s) -> s"s${s.bytes.len}:$s"
    // Never part of a key: a call handed a slice is not remembered (`run_call`).
    ConstView(_, _, _, _) -> "v"
    ConstArray(xs) ->
        var out = "["

        for x in xs
            out = out + key_part(x) + ","

        out + "]"
    ConstRecord(variant, fields) -> key_part(ConstInt(from_int(long(variant)))) + key_part(ConstArray(fields))
    // Never part of a key either: a call handed a writer writes through it.
    ConstWriter(_) -> "w"
    // An address is the storage or function it names: two calls handed the same one answer alike.
    ConstLink(image) -> s"&${link_key(image)};"
    // Never part of a key: a call handed a pointer reads, and may write, wherever it points.
    ConstPtr(_, _, _) -> "p"
    ConstUnset -> "u"
    ConstPun(_, _) -> "p"
    ConstErased(_, _) -> "e"

// A float's own pattern, a NaN's included, so that two arguments differing in a bit are two runs.
private float_pattern_exact(f: real) -> u64 = f.bits()

// Whether a clause names a `@ghost` function, which makes it specification rather than code.
@noinline
private names_ghost(a: &Analysis, e: TExpr) -> bool
    var found: Buf[bool] = buf()
    val sink = &found

    walk_texpr(e, expr_walk(true, x -> *x.kind match
        TCall(name, _, _, _) ->
            val f = a.tables.funcs.get(name)

            if f.is_some() && f.unwrap().decl.ghost then sink.push(true)
        _ -> ()))

    !found.is_empty()
end names_ghost

// -- statements and blocks ---------------------------------------------------------------------------

private block(r: &EvRun, b: TBlock) -> Flow
    val f = stmts(r, b.stmts)

    f match
        EvNone -> ()
        _ -> return f

    if b.result.is_some() then eval(r, b.result.unwrap()) else EvNone
end block

private stmts(r: &EvRun, list: Buf[TStmt]) -> Flow
    for item in list
        val f = ev_stmt(r, item)

        f match
            EvNone -> ()
            _ -> return f

    EvNone
end stmts

@noinline
private ev_stmt(r: &EvRun, s: TStmt) -> Flow
    if !tick(r) then return EvStop

    // Told apart by the tag alone, as `eval` tells expressions apart, for the same reason.
    s match
        TVarDecl(_, _, _, _) -> var_decl_stmt(r, s)
        TExprStmt(_) -> expr_stmt(r, s)
        TReturn(_) -> return_stmt(r, s)
        TBreak(_, _) -> break_stmt(r, s)
        TContinue(depth) -> EvContinue(depth)
        _ -> stmt_rest(r, s)
end ev_stmt

@noinline
private var_decl_stmt(r: &EvRun, s: TStmt) -> Flow
    s match
        TVarDecl(name, ty, init, _) ->
            val why = unheld(ty)

            if why.is_some() then return refuse_form(r, init.span, why.unwrap())

            val f = eval(r, init)

            f match
                EvGave(v) ->
                    assign(r, name, v)
                    EvNone
                EvNone -> EvNone
                _ -> f
        _ -> EvStop
end var_decl_stmt

@noinline
private expr_stmt(r: &EvRun, s: TStmt) -> Flow
    s match
        TExprStmt(e) ->
            val f = eval(r, e)

            f match
                EvGave(_) -> EvNone
                _ -> f
        _ -> EvStop
end expr_stmt

@noinline
private return_stmt(r: &EvRun, s: TStmt) -> Flow
    s match
        TReturn(value) ->
            if value.is_none() then return EvReturn(None)

            val f = eval(r, value.unwrap())

            f match
                EvGave(v) -> EvReturn(Some(v))
                EvNone -> EvReturn(None)
                _ -> f
        _ -> EvStop
end return_stmt

@noinline
private break_stmt(r: &EvRun, s: TStmt) -> Flow
    s match
        TBreak(value, depth) ->
            if value.is_none() then return EvBreak(depth, None)

            val f = eval(r, value.unwrap())

            f match
                EvGave(v) -> EvBreak(depth, Some(v))
                EvNone -> EvBreak(depth, None)
                _ -> f
        _ -> EvStop
end break_stmt

// Every statement `ev_stmt` does not dispatch itself.
@noinline
private stmt_rest(r: &EvRun, s: TStmt) -> Flow
    s match
        TInvariant(cond, _) ->
            if names_ghost(r.a, cond) then return EvNone

            eval_bool(r, cond) match
                Ok(true) -> EvNone
                Ok(false) -> trap(r, cond.span, "a loop 'invariant' failed")
                Err(f) -> f
        TVariantCheck(slot, _, e) ->
            if names_ghost(r.a, e) then return EvNone

            variant_check(r, slot, e)
        TWriteStmt(w) -> write(r, w)
        TMultiAssign(writes) -> ev_multi_assign(r, writes)
        TBecome(c) ->
            val f = eval(r, c)

            f match
                EvGave(v) -> EvReturn(Some(v))
                EvNone -> EvReturn(None)
                _ -> f
        TRefDecl(name, _, place) ->
            refuse_form(r, place.span, s"'ref $name' is not evaluated while compiling yet")
        TDefer(_, _) -> refuse_form(r, span_zero(), "a 'defer' is not evaluated while compiling yet")
        TAsm(_, _, _, span) -> refuse_form(r, span, "an 'asm' block is outside the program")
        _ -> EvStop
end stmt_rest

// A loop's measure, compared against the one the turn before took.
@noinline
private variant_check(r: &EvRun, slot: string, e: TExpr) -> Flow
    val cur = eval_value(r, e) match
        Ok(v) -> v
        Err(f) -> return f

    val frame = r.frames.at(r.frames.len() - 1)
    val prev = frame.slots.get(slot)

    if prev.is_some() && !below(cur, prev.unwrap()) then
        return trap(r, e.span, s"the loop's 'variant' did not decrease: ${value_text(cur, texpr_type(e))} " +
                    s"is not below ${value_text(prev.unwrap(), texpr_type(e))}")

    frame.slots.put(slot, cur)
    EvNone
end variant_check

// Where a write lands: a position in a buffer of values -- a local's cell, an element of an array or
// a slice, a field of a struct, a box's value -- at any depth, with the depth of the call whose
// storage it is (-1 for the heap); or a local not written yet. A union's field is a slot of its own:
// a write into it changes which field the union was last written through, which is part of the
// union's value and so lands in the slot that holds the union.
private enum EvSlot
    SlotLocal(name: string)
    SlotElem(elems: Buf[Const], at: usize, owner: int)
    SlotUnion(holder: &EvSlot, fields: Buf[Const], written: int, at: usize, ty: Type)
end EvSlot

// The slot a place names, its indices worked out: a local, an element, a field, at any depth.
@noinline
private slot_of(r: &EvRun, place: TExpr) -> Result[EvSlot, Flow]
    if r.frames.is_empty() then return Err(no_place(r, place))

    *place.kind match
        TLoad(name, _) ->
            val cell = running(r).locals.get(name)

            if cell.is_some() then Ok(SlotElem(cell.unwrap(), 0, int(r.frames.len()) - 1))
            else Ok(SlotLocal(name))
        TIndex(receiver, index, _) ->
            // An index through a pointer counts from the slot it points at, in the buffer that slot
            // is in: `p[i]` is the element `i` past `*p`.
            nameless(texpr_type(receiver)) match
                Ptr(_) ->
                    return eval_value(r, receiver) match
                        Ok(ConstPtr(xs, at, owner)) ->
                            element_index(r, index, xs.len() - at).map(i -> SlotElem(xs, at + i, owner))
                        Ok(v) -> Err(through_unowned(r, receiver.span, v))
                        Err(f) -> Err(f)
                _ -> ()

            val outer = slot_of(r, receiver) match
                Ok(s) -> s
                Err(f) -> return Err(f)

            // A slice's element is a place in the array it views, and the slice's owner is the
            // element's.
            val (xs, lo, n, owner) = slot_value(r, receiver.span, outer) match
                Ok(ConstArray(found)) -> (found, usize(0), found.len(), slot_owner(outer))
                Ok(ConstView(found, from, count, whose)) -> (found, from, count, whose)
                Ok(_) -> return Err(no_place(r, place))
                Err(f) -> return Err(f)

            element_index(r, index, n).map(i -> SlotElem(xs, lo + i, owner))
        // A field is a slot in the struct's own fields, so a write into it lands where it is held.
        TField(receiver, index, _) ->
            val outer = slot_of(r, receiver) match
                Ok(s) -> s
                Err(f) -> return Err(f)

            slot_value(r, receiver.span, outer) match
                Ok(ConstRecord(-1, fields)) -> Ok(SlotElem(fields, usize(index), slot_owner(outer)))
                Ok(ConstRecord(v, fields)) if v <= -2 ->
                    Ok(SlotUnion(outer, fields, union_written(v), usize(index), texpr_type(receiver)))
                Ok(_) -> Err(no_place(r, place))
                Err(f) -> Err(f)
        // What a pointer points at is the slot it names.
        TDeref(operand, _) -> eval_value(r, operand) match
            Ok(ConstPtr(xs, at, owner)) -> Ok(SlotElem(xs, at, owner))
            Ok(v) -> Err(through_unowned(r, operand.span, v))
            Err(f) -> Err(f)
        _ -> Err(no_place(r, place))
end slot_of

// Whose storage a slot is: the depth of the call that holds it, or -1 for the heap.
private slot_owner(s: EvSlot) -> int = s match
    SlotElem(_, _, owner) -> owner
    SlotUnion(holder, _, _, _, _) -> slot_owner(*holder)
    SlotLocal(_) -> -1

// A read or write through a pointer the evaluation does not own: null is a trap, as it is where the
// program runs; an address the linker fills in names storage that exists only then.
private through_unowned(r: &EvRun, at: Span, v: Const) -> Flow = v match
    ConstPun(_, as_was) ->
        refuse_form(r, at, s"memory a '${type_show(*as_was)}' points at, read as another type, is not evaluated " +
                    "while compiling — the evaluator holds values, not the bytes they are laid out in")
    ConstLink(image) -> *image.kind match
        TNullLit(_) -> trap(r, at, "a read or write through a null pointer")
        _ -> refuse_form(r, at, link_reason())
    _ -> refuse_form(r, at, link_reason())

// What a slot holds now.
private slot_value(r: &EvRun, at: Span, s: EvSlot) -> Result[Const, Flow] = s match
    SlotLocal(name) -> Err(refuse_form(r, at, s"'$name' is read before anything was written to it"))
    SlotElem(xs, i, _) -> placed(r, at, xs.at(i)) match
        EvGave(v) -> Ok(v)
        f -> Err(f)
    SlotUnion(_, xs, written, i, ty) ->
        if written == int(i) then Ok(xs.at(i))
        else Err(refuse_form(r, at, union_cross_read(ty, written, int(i))))

// A value written into a slot, as a copy of its own. A union written through a field is the union
// built with that field.
private slot_write(r: &EvRun, s: EvSlot, v: Const) -> unit = s match
    SlotLocal(name) -> assign(r, name, v)
    SlotElem(xs, i, _) -> written_over(xs, i, v)
    SlotUnion(holder, xs, _, i, _) ->
        var held = xs

        held.set(i, copied(v))
        slot_write(r, *holder, ConstRecord(union_variant(int(i)), xs))

private assign(r: &EvRun, name: string, v: Const)
    val frame = r.frames.at(r.frames.len() - 1)
    val cell = frame.locals.get(name)

    if cell.is_some() then written_over(cell.unwrap(), 0, v) else frame.locals.put(name, cell_of(copied(v)))
end assign

// A value written into slot `i` of a buffer of values: in the storage already there where the two
// have the same shape, so a slice or a pointer taken into the old value sees the new one, as the
// program's would; as a copy of its own where they do not.
private written_over(xs: Buf[Const], i: usize, v: Const)
    if overwrite(xs.at(i), v) then return

    var held = xs

    held.set(i, copied(v))
end written_over

// A local's cell, holding its first value.
private cell_of(v: Const) -> Buf[Const]
    var out: Buf[Const] = buf()

    out.push(v)
    out
end cell_of

private no_place(r: &EvRun, place: TExpr) -> Flow =
    refuse_form(r, place.span, "a write into anything but a local, an element or a field is not evaluated " +
                "while compiling yet")

@noinline
private store(r: &EvRun, at: Span, place: TExpr, value: TExpr) -> Flow
    val slot = slot_of(r, place) match
        Ok(s) -> s
        Err(f) -> return f

    val v = eval_value(r, value) match
        Ok(x) -> x
        Err(f) -> return f

    slot_write(r, slot, v)
    EvGave(v)
end store

// What a compound assignment's operator makes of the place's value and the value on the right, and
// the check a constrained place owes the result.
@noinline
private combined(r: &EvRun, at: Span, op: string, place_ty: Type, value_ty: Type, cur: Const, v: Const,
                 check: Option[Type]) -> Flow
    val bin = op[0..<(op.bytes.len - 1)]
    val checked = is_ranged(place_ty) && (bin == "+" || bin == "-" || bin == "*" || bin == "<<")
    val fixed = fixed_arith_op(bin, place_ty, value_ty, place_ty)
    val out = if fixed then fixed_operate(r, at, bin, place_ty, value_ty, place_ty, cur, v) else operate(r, at, bin, place_ty, cur, v, checked)

    held_to(r, at, out, check)
end combined

// The check a constrained place owes a compound assignment's result.
@noinline
private held_to(r: &EvRun, at: Span, out: Flow, check: Option[Type]) -> Flow
    if check.is_none() then return out

    val nv = ev_value_of(out)

    if nv.is_none() then return out

    check.unwrap() match
        Constrained(d) ->
            if d.pred_fn.is_some() then
                return refuse_form(r, at, s"the 'where' predicate of '${type_show(check.unwrap())}' is " +
                                   "not evaluated while compiling yet")

            if !admitted(d, nv.unwrap()) then
                return trap(r, at, s"${value_text(nv.unwrap(), check.unwrap())} is not a value " +
                            s"'${type_show(check.unwrap())}' admits")

            out
        _ -> out
end held_to

@noinline
private update(r: &EvRun, at: Span, place: TExpr, op: string, value: TExpr, ty: Type,
               dispatch: Option[TDispatch], check: Option[Type]) -> Flow
    if dispatch.is_some() then
        return refuse_form(r, at, s"'$op' through an implementation is not evaluated while compiling yet")

    val slot = slot_of(r, place) match
        Ok(s) -> s
        Err(f) -> return f

    val cur = slot_value(r, place.span, slot) match
        Ok(x) -> x
        Err(f) -> return f

    val out = updated_value(r, at, op, ty, value, cur, check)

    ev_value_of(out) match
        Some(nv) -> slot_write(r, slot, nv)
        None -> ()

    out
end update

// What a compound assignment makes of the place's value `cur` and the value on the right: one
// rounding for a contracted `+= a * b` or `-= a * b`, the operator's own arithmetic otherwise.
@noinline
private updated_value(r: &EvRun, at: Span, op: string, ty: Type, value: TExpr, cur: Const,
                      check: Option[Type]) -> Flow
    contracted_update(fusing_of(r.a.tables.target), op, ty, value) match
        Some(k) -> return held_to(r, at, ev_contracted(r, at, k, None, cur, ty), check)
        None -> ()

    val v = eval_value(r, value) match
        Ok(x) -> x
        Err(f) -> return f

    combined(r, at, op, ty, texpr_type(value), cur, v, check)
end updated_value

@noinline
private ev_inc_dec(r: &EvRun, at: Span, place: TExpr, op: string, pre: bool, ty: Type,
                check: Option[Type]) -> Flow
    val slot = slot_of(r, place) match
        Ok(s) -> s
        Err(f) -> return f

    val cur = slot_value(r, place.span, slot) match
        Ok(ConstInt(n)) -> n
        Ok(_) -> return refuse_form(r, at, s"'$op' on ${type_show(ty)} is not evaluated while compiling yet")
        Err(f) -> return f

    val stepped = if op == "++" then add(cur, from_int(1)) else sub(cur, from_int(1))
    val nv = underlying(ty) match
        Integer(bits, signed, _) -> wrap(stepped, bits, signed)
        _ -> stepped

    check match
        Some(Constrained(d)) ->
            if d.pred_fn.is_some() then
                return refuse_form(r, at, s"the 'where' predicate of '${type_show(check.unwrap())}' is " +
                                   "not evaluated while compiling yet")

            if !admitted(d, ConstInt(nv)) then
                return trap(r, at, s"${to_string(nv)} is not a value '${type_show(check.unwrap())}' admits")
        _ -> ()

    slot_write(r, slot, ConstInt(nv))
    EvGave(ConstInt(if pre then nv else cur))
end ev_inc_dec

@noinline
private write(r: &EvRun, w: TWrite) -> Flow
    if !w.check.is_empty() then return no_place(r, w.place)

    if w.op == "=" then
        return store(r, w.value.span, w.place, w.value) match
            EvGave(_) -> EvNone
            other -> other

    update(r, w.value.span, w.place, w.op, w.value, texpr_type(w.place), w.dispatch, w.constraint) match
        EvGave(_) -> EvNone
        other -> other
end write

// `a, b = b, a`: every value worked out before anything lands.
@noinline
private ev_multi_assign(r: &EvRun, writes: Buf[TWrite]) -> Flow
    var landing: Buf[(EvSlot, Const)] = buf()

    for w in writes
        if !w.check.is_empty() then return no_place(r, w.place)

        val slot = slot_of(r, w.place) match
            Ok(s) -> s
            Err(f) -> return f

        // A contracted arm reads its place, then the product's factors, as the lowering does.
        val k = if w.op == "=" || w.dispatch.is_some() then None
        else contracted_update(fusing_of(r.a.tables.target), w.op, texpr_type(w.place), w.value)

        if k.is_some()
            val cur = slot_value(r, w.place.span, slot) match
                Ok(x) -> x
                Err(f) -> return f

            val out = held_to(r, w.value.span, ev_contracted(r, w.value.span, k.unwrap(), None, cur,
                                                             texpr_type(w.place)), w.constraint)

            ev_value_of(out) match
                Some(nv) -> landing.push((slot, nv))
                None -> return out

            continue
        end if

        // Copied now, so a value read from a place another write in the list changes is the value
        // it had before any of them landed.
        val v = eval_value(r, w.value) match
            Ok(x) -> copied(x)
            Err(f) -> return f

        if w.op == "="
            landing.push((slot, v))
        else
            if w.dispatch.is_some() then
                return refuse_form(r, w.value.span, s"'${w.op}' through an implementation is not " +
                                   "evaluated while compiling yet")

            val cur = slot_value(r, w.place.span, slot) match
                Ok(x) -> x
                Err(f) -> return f

            val out = combined(r, w.value.span, w.op, texpr_type(w.place), texpr_type(w.value), cur, v,
                               w.constraint)

            ev_value_of(out) match
                Some(nv) -> landing.push((slot, nv))
                None -> return out
        end if

    for item in landing
        slot_write(r, item.0, item.1)

    EvNone
end ev_multi_assign

// -- branching ---------------------------------------------------------------------------------------

// Whether every term of a condition holds, binding what its patterns bind.
@noinline
private ev_holds(r: &EvRun, terms: Buf[TCondTerm]) -> Result[bool, Flow]
    for item in terms
        item match
            TCondTest(c) ->
                eval_bool(r, c) match
                    Ok(true) -> ()
                    Ok(false) -> return Ok(false)
                    Err(f) -> return Err(f)
            TCondIs(subject, patterns, negated) ->
                val v = eval_value(r, subject) match
                    Ok(x) -> x
                    Err(f) -> return Err(f)

                var any = false

                for j in 0..<patterns.len()
                    if !any
                        matches(r, patterns.at(j), v) match
                            Ok(m) -> any = m
                            Err(f) -> return Err(f)

                if any == negated then return Ok(false)

    Ok(true)
end ev_holds

// Whether a scalar matches a pattern, binding the names it binds.
@noinline
private matches(r: &EvRun, p: TPattern, v: Const) -> Result[bool, Flow] = p match
    TWildPattern(_) -> Ok(true)
    TBindPattern(name, _) ->
        assign(r, name, v)
        Ok(true)
    TAtPattern(name, inner) ->
        val m = matches(r, *inner, v)

        m match
            Ok(true) -> assign(r, name, v)
            _ -> ()

        m
    TLitPattern(value) ->
        eval_value(r, value) match
            Ok(lit) -> ev_value_of(operate(r, value.span, "==", texpr_type(value), v, lit, false)) match
                Some(ConstBool(b)) -> Ok(b)
                _ -> Err(EvStop)
            Err(f) -> Err(f)
    TRangePattern(lo, hi, inclusive) ->
        val l = eval_value(r, lo) match
            Ok(x) -> x
            Err(f) -> return Err(f)

        val h = eval_value(r, hi) match
            Ok(x) -> x
            Err(f) -> return Err(f)

        val ty = texpr_type(lo)
        val above = ev_value_of(operate(r, lo.span, ">=", ty, v, l, false))
        val under = ev_value_of(operate(r, hi.span, if inclusive then "<=" else "<", ty, v, h, false))

        (above, under) match
            (Some(ConstBool(a)), Some(ConstBool(b))) -> Ok(a && b)
            _ -> Err(EvStop)
    TVariantPattern(enum_ty, variant, args) -> variant_matches(r, enum_ty, variant, args, v)
    TStructPattern(_, args) -> v match
        ConstRecord(_, fields) -> fields_match(r, args, fields)
        _ -> Err(refuse_form(r, span_zero(), "a struct pattern over something that is not a struct"))

@noinline
private ev_if(r: &EvRun, at: Span, cond: Buf[TCondTerm], then_block: TBlock,
                else_block: Option[TBlock]) -> Flow
    ev_holds(r, cond) match
        Ok(true) -> block(r, then_block)
        Ok(false) -> if else_block.is_some() then block(r, else_block.unwrap()) else EvNone
        Err(f) -> f
end ev_if

@noinline
private ev_match(r: &EvRun, at: Span, scrutinee: TExpr, arms: Buf[TArm]) -> Flow
    val v = eval_value(r, scrutinee) match
        Ok(x) -> x
        Err(f) -> return f

    chosen_arm(r, arms, v) match
        Ok(Some(body)) -> block(r, body)
        Ok(None) -> trap(r, at, "no arm of the 'match' took the value")
        Err(f) -> f
end ev_match

// The body of the first arm whose pattern takes the value and whose guard holds, its bindings made.
@noinline
private chosen_arm(r: &EvRun, arms: Buf[TArm], v: Const) -> Result[Option[TBlock], Flow]
    for arm in arms
        var hit = false

        for j in 0..<arm.patterns.len()
            if !hit
                matches(r, arm.patterns.at(j), v) match
                    Ok(m) -> hit = m
                    Err(f) -> return Err(f)

        if hit && arm.guard.is_some()
            eval_bool(r, arm.guard.unwrap()) match
                Ok(g) -> hit = g
                Err(f) -> return Err(f)

        if hit then return Ok(Some(arm.body))

    Ok(None)
end chosen_arm

// -- loops -------------------------------------------------------------------------------------------

// What one pass through a loop's body comes to for the loop.
private enum Turn
    TurnOn
    TurnDone(value: Option[Const])
    TurnOut(flow: Flow)
end Turn

private turn(f: Flow) -> Turn = f match
    EvNone -> TurnOn
    EvGave(_) -> TurnOn
    EvContinue(d) -> if d == 0 then TurnOn else TurnOut(EvContinue(d - 1))
    EvBreak(d, v) -> if d == 0 then TurnDone(v) else TurnOut(EvBreak(d - 1, v))
    _ -> TurnOut(f)

private enter_loop(r: &EvRun, at: Span) = r.loops.push((here(r), at))

// Leaves a loop with what it came to.
private left(r: &EvRun, f: Flow) -> Flow
    r.loops.truncate(r.loops.len() - 1)
    f
end left

private gave(v: Option[Const]) -> Flow = if v.is_some() then EvGave(v.unwrap()) else EvNone

// What a loop that ran out comes to: its `else`, or nothing.
private ran_out(r: &EvRun, else_block: Option[TBlock]) -> Flow =
    left(r, if else_block.is_some() then block(r, else_block.unwrap()) else EvNone)

@noinline
private ev_loop(r: &EvRun, at: Span, body: Buf[TStmt]) -> Flow
    enter_loop(r, at)

    loop
        if !tick(r) then return left(r, EvStop)

        turn(stmts(r, body)) match
            TurnOn -> ()
            TurnDone(v) -> return left(r, gave(v))
            TurnOut(f) -> return left(r, f)
end ev_loop

@noinline
private ev_while(r: &EvRun, at: Span, cond: Buf[TCondTerm], body: Buf[TStmt],
                   else_block: Option[TBlock]) -> Flow
    enter_loop(r, at)

    loop
        if !tick(r) then return left(r, EvStop)

        ev_holds(r, cond) match
            Ok(true) -> ()
            Ok(false) -> return ran_out(r, else_block)
            Err(f) -> return left(r, f)

        turn(stmts(r, body)) match
            TurnOn -> ()
            TurnDone(v) -> return left(r, gave(v))
            TurnOut(f) -> return left(r, f)
end ev_while

// `for x in c` over a type that walks itself: the cursor `walk` answered kept in a local of its own,
// and each turn the element its `next` gives, bound by the pattern -- the loop ending where `next`
// answers what the pattern does not take.
@noinline
private ev_iterate(r: &EvRun, at: Span, cursor: string, init: TExpr, next: TExpr, bind: TPattern,
                   body: Buf[TStmt], else_block: Option[TBlock]) -> Flow
    val start = eval_value(r, init) match
        Ok(x) -> x
        Err(f) -> return f

    r.frames.at(r.frames.len() - 1).locals.put(cursor, cell_of(copied(start)))
    enter_loop(r, at)

    loop
        if !tick(r) then return left(r, EvStop)

        val item = eval_value(r, next) match
            Ok(x) -> x
            Err(f) -> return left(r, f)

        matches(r, bind, item) match
            Ok(true) -> ()
            Ok(false) -> return ran_out(r, else_block)
            Err(f) -> return left(r, f)

        turn(stmts(r, body)) match
            TurnOn -> ()
            TurnDone(v) -> return left(r, gave(v))
            TurnOut(f) -> return left(r, f)
end ev_iterate

@noinline
private ev_do_while(r: &EvRun, at: Span, body: Buf[TStmt], cond: TExpr,
                      else_block: Option[TBlock]) -> Flow
    enter_loop(r, at)

    loop
        if !tick(r) then return left(r, EvStop)

        turn(stmts(r, body)) match
            TurnOn -> ()
            TurnDone(v) -> return left(r, gave(v))
            TurnOut(f) -> return left(r, f)

        eval_bool(r, cond) match
            Ok(true) -> ()
            Ok(false) -> return ran_out(r, else_block)
            Err(f) -> return left(r, f)
end ev_do_while

@noinline
private ev_for(r: &EvRun, at: Span, name: string, var_ty: Type, lo: TExpr, hi: TExpr,
                 inclusive: bool, body: Buf[TStmt], else_block: Option[TBlock]) -> Flow
    val first = eval_value(r, lo) match
        Ok(ConstInt(n)) -> n
        Ok(_) -> return refuse_form(r, at, "a range that is not of integers is not evaluated while compiling yet")
        Err(f) -> return f

    val last = eval_value(r, hi) match
        Ok(ConstInt(n)) -> n
        Ok(_) -> return refuse_form(r, at, "a range that is not of integers is not evaluated while compiling yet")
        Err(f) -> return f

    enter_loop(r, at)

    var i = first

    loop
        if !tick(r) then return left(r, EvStop)

        val more = if inclusive then cmp(i, last) <= 0 else cmp(i, last) < 0

        if !more then return ran_out(r, else_block)

        assign(r, name, ConstInt(i))

        turn(stmts(r, body)) match
            TurnOn -> ()
            TurnDone(v) -> return left(r, gave(v))
            TurnOut(f) -> return left(r, f)

        i = add(i, from_int(1))
end ev_for

@noinline
private ev_c_for(r: &EvRun, at: Span, init: Buf[TStmt], cond: Option[TExpr], step: Buf[TStmt],
                   body: Buf[TStmt], else_block: Option[TBlock]) -> Flow
    val started = stmts(r, init)

    started match
        EvNone -> ()
        _ -> return started

    enter_loop(r, at)

    loop
        if !tick(r) then return left(r, EvStop)

        if cond.is_some()
            eval_bool(r, cond.unwrap()) match
                Ok(true) -> ()
                Ok(false) -> return ran_out(r, else_block)
                Err(f) -> return left(r, f)
        end if

        turn(stmts(r, body)) match
            TurnOn -> ()
            TurnDone(v) -> return left(r, gave(v))
            TurnOut(f) -> return left(r, f)

        val stepped = stmts(r, step)

        stepped match
            EvNone -> ()
            _ -> return left(r, stepped)
end ev_c_for

// `forall`/`exists` over a range, answered by trying every value in it.
@noinline
private quantifier(r: &EvRun, at: Span, universal: bool, name: string, lo: TExpr, hi: TExpr,
                   inclusive: bool, pred: TExpr) -> Flow
    val first = eval_value(r, lo) match
        Ok(ConstInt(n)) -> n
        Ok(_) -> return refuse_form(r, at, "a quantifier over a range that is not of integers")
        Err(f) -> return f

    val last = eval_value(r, hi) match
        Ok(ConstInt(n)) -> n
        Ok(_) -> return refuse_form(r, at, "a quantifier over a range that is not of integers")
        Err(f) -> return f

    var i = first

    loop
        if !tick(r) then return EvStop

        val more = if inclusive then cmp(i, last) <= 0 else cmp(i, last) < 0

        if !more then return EvGave(ConstBool(universal))

        assign(r, name, ConstInt(i))

        eval_bool(r, pred) match
            Ok(b) -> if b != universal then return EvGave(ConstBool(b))
            Err(f) -> return f

        i = add(i, from_int(1))
end quantifier
