module sh.sysl.compiler
@tests

// A "has no method" refusal names the receiver's type the way its declaration wrote it: a
// `val a: f64` is an `f64`, a `val a: real` is a `real`, and a value with no written type (a
// literal) is shown canonically. The helpers are `tests_enm_enum_run.sysl`'s.

@test("a method missing from an f64 binding says f64")
mfl_f64_binding()
    if !enm_ready() then return

    val out = enm_err("main()\n    val a: f64 = 1.0\n    print(a.nope(2.0))\n")

    assert(enm_says(out, "type 'f64' has no method 'nope'"), out)

@test("a method missing from a real binding says real")
mfl_real_binding()
    if !enm_ready() then return

    val out = enm_err("main()\n    val a: real = 1.0\n    print(a.nope(2.0))\n")

    assert(enm_says(out, "type 'real' has no method 'nope'"), out)

@test("a method missing from an f32 parameter says f32")
mfl_f32_parameter()
    if !enm_ready() then return

    val out = enm_err("f(x: f32) -> f32 = x.nope()\n\nmain()\n    print(f(1.0))\n")

    assert(enm_says(out, "type 'f32' has no method 'nope'"), out)

@test("a method missing from a width-named integer binding says what was written")
mfl_integer_binding()
    if !enm_ready() then return

    val out = enm_err("main()\n    val a: u16 = 1\n    print(a.nope())\n")

    assert(enm_says(out, "type 'u16' has no method 'nope'"), out)

@test("a literal receiver is still shown canonically")
mfl_literal_receiver()
    if !enm_ready() then return

    val out = enm_err("main()\n    print(1.5.nope())\n")

    assert(enm_says(out, "type 'real' has no method 'nope'"), out)

@test("an alias is shown with its aka")
mfl_alias_binding()
    if !enm_ready() then return

    val out = enm_err("type Meters = f64\n\nmain()\n    val a: Meters = 1.0\n    print(a.nope())\n")

    assert(enm_says(out, "type 'Meters (aka real)' has no method 'nope'"), out)

@test("a user struct is unchanged")
mfl_struct_unchanged()
    if !enm_ready() then return

    val out = enm_err("struct P\n    x: int\n\nmain()\n    val p = P(1)\n    print(p.nope())\n")

    assert(enm_says(out, "type 'P' has no method 'nope'"), out)

@test("max, min and clamp now exist on a float binding")
mfl_max_exists()
    if !enm_ready() then return

    val out = enm_ran("main()\n    val a: f64 = 1.0\n    print(a.max(2.0), a.min(2.0), a.clamp(2.0, 3.0))\n")

    assert(enm_says(out, "2 1 2"), out)
