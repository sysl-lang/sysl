module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.container.{Map, map, Set, set}

// **An executable keeps its own functions to itself.** A program function that is not `private` is
// written with ordinary external linkage, which is right for every module that is linked INTO
// something -- a library half, a C archive -- and wrong for the one that becomes the image: a symbol
// the linker could resolve from another object is one the optimizer must assume another object calls,
// so it never inlines a function called from a single site and keeps its out-of-line copy besides.
// rustc gives a binary crate's functions internal linkage, and a C program gets the same from
// `static`; `sysl build`, `sysl run` and the binary `sysl test` builds do it here.
//
// **What is sealed is what no other object can name**:
//
// - only a function of the program's OWN modules. A library or package body compiled into the
//   program -- a function its half deferred because it reads module storage, a generic instance --
//   is one a linked half may call by name, so it keeps its linkage;
// - never an `@export` (its definition is what C or a weak seam names), a function placed in a
//   section (a linker script gathers it), or one with a calling convention of its own (an interrupt
//   handler a vector names);
// - never one module-level `asm` names, which the optimizer cannot see calling it.
//
// A C file cannot spell any other sysl symbol (`codegen.sysl`'s `record_symbols`), and a function
// whose address is handed to C is named only inside this module, where taking it is. The entry point
// and the test runner's tables are in this module too. Codegen units promote what one partition
// shares with another to hidden (`codegen_units.sysl`), as they do for a `private` function.

// Whether `f` is a function of one of the `sealing` modules that nothing outside the module names.
sealable(f: TFunc, sealing: Buf[string]) -> bool =
    !sealing.is_empty() && holds_string(sealing, f.declared_in) && f.exported.is_none() &&
        f.section.is_none() && f.conv.is_none() && !f.ghost

// Notes the definitions `funcs` holds from `from` on -- one sealable function's body and the parts it
// was split into -- unless a line of module `asm` names one.
note_sealed(funcs: Buf[IrFunc], from: usize, asm_lines: Buf[string], sealed: *Set[string])
    for i in from..<funcs.len()
        val name = funcs[i].sig.name
        var named = false

        for line in asm_lines
            if holds_text(line, name) then named = true

        if !named then sealed.add(name)
end note_sealed

// **What runs once is not sealed.** A sealed function with one call is one LLVM inlines whatever its
// size (the single caller pays nothing for a body it no longer keeps), which is the point where the
// call sits in a loop: nbody's `advance` runs fifty million times from `main`. Where the call runs
// ONCE the inlining saves one call and costs a merge: the callee's loops are register-allocated
// together with everything else the caller does, and a caller that goes on to format and print its
// results has been seen to spill a hot loop's invariants into memory the separate function kept in
// registers (fannkuchredux's fifteen shuffle masks, reloaded on every flip, 8% slower). So a
// function that runs at most once per run of the program keeps the external linkage it was written
// with, and the optimizer treats it exactly as it did before sealing.
//
// The functions that run at most once are the entry and, from it, every sealed function whose every
// call is made from a block of one of them that no loop reaches again. A function whose address is
// taken as well may be called again through it; leaving such a one external costs only what sealing
// would have gained. The entry itself stays sealed: only the platform's `main` calls it.
//
// Returns the names among `sealed` that run once. A function whose blocks were printed and let go of
// (`printed_func`) is read through the shape kept for it in `shapes`, which says what its blocks did.
run_once(funcs: Buf[IrFunc], sealed: Set[string], shapes: Map[string, CallShape] = map()) -> Buf[string]
    var once: Buf[string] = buf()
    var index: Map[string, usize] = map()

    for i in 0..<funcs.len()
        if funcs[i].sig.linkage == LinkDefault then index.put(funcs[i].sig.name, i)

    val entry = index.get(entry_symbol()) match
        Some(i) -> i
        None -> return once

    // How many calls name each sealed function, and how many of them run once.
    var calls: Map[string, int] = map()
    var once_calls: Map[string, int] = map()

    for f in funcs
        if is_printed(f)
            shapes.get(f.sig.name) match
                Some(shape) ->
                    for site in shape.calls
                        if sealed.has(site.0) then calls.put(site.0, calls.get(site.0).unwrap_or(0) + 1)
                None -> ()
        else
            for b in f.blocks
                for inst in b.instrs
                    sealed_callee(inst, sealed) match
                        Some(c) -> calls.put(c, calls.get(c).unwrap_or(0) + 1)
                        None -> ()
    end for

    var todo: Buf[usize] = buf()
    var done: Set[string] = set()

    todo.push(entry)
    done.add(entry_symbol())

    while todo.pop() is Some(at)
        val f = funcs[at]
        val shape = if is_printed(f) then shapes.get(f.sig.name).unwrap_or(call_shape(f)) else call_shape(f)
        var looped: Buf[Option[bool]] = buf()

        for _ in 0..<shape.succ.len() do looped.push(None)

        // The calls in the order the blocks hold them, each asked about once its block is.
        for site in shape.calls
            val (c, j) = site

            if !sealed.has(c) then continue

            if looped[j].is_none() then looped[j] = Some(on_a_loop(shape.succ, j))

            if looped[j] == Some(true) then continue

            val n = once_calls.get(c).unwrap_or(0) + 1

            once_calls.put(c, n)

            if n == calls.get(c).unwrap_or(0) && !done.has(c)
                done.add(c)
                once.push(c)

                index.get(c) match
                    Some(i) -> todo.push(i)
                    None -> ()
        end for

    once
end run_once

// **What `run_once` asks of a body, kept where its blocks are not**: each block's successors by index,
// and every direct call to a named function with the block it is in, in the order the blocks hold them.
struct CallShape
    succ: Buf[Buf[usize]]
    calls: Buf[(string, usize)]
end CallShape

// A body's shape, read off its blocks.
call_shape(f: IrFunc) -> CallShape
    var labels: Map[string, usize] = map()

    for j in 0..<f.blocks.len()
        labels.put(f.blocks[j].label, j)

    var succ: Buf[Buf[usize]] = buf()
    var calls: Buf[(string, usize)] = buf()

    for j in 0..<f.blocks.len()
        var next: Buf[usize] = buf()

        for l in successors(f.blocks[j].terminator)
            labels.get(l) match
                Some(k) -> next.push(k)
                None -> ()

        succ.push(next)

        for inst in f.blocks[j].instrs
            inst match
                InCall(_, _, VGlobal(name), _, _, _, _, _) -> calls.push((name, j))
                _ -> ()

    CallShape(succ, calls)
end call_shape

// The sealed function a direct call names, if it names one.
private sealed_callee(inst: Inst, sealed: Set[string]) -> Option[string] = inst match
    InCall(_, _, VGlobal(name), _, _, _, _, _) -> if sealed.has(name) then Some(name) else None
    _ -> None

// Whether control can come back to block `at` once it has left it: whether `at` is on a loop.
private on_a_loop(succ: Buf[Buf[usize]], at: usize) -> bool
    var seen: Buf[bool] = buf()
    var todo: Buf[usize] = buf()

    for _ in 0..<succ.len() do seen.push(false)

    todo.push(at)

    while todo.pop() is Some(j)
        for k in succ[j]
            if k == at then return true

            if !seen[k]
                seen[k] = true
                todo.push(k)

    false
end on_a_loop

// `funcs` with every external definition `sealed` names made `internal`. One already `internal`, or a
// copy of a body defined elsewhere, is left as it is.
//
// **A sealed definition carries `SealedAttr`**, which LLVM ignores and the codegen units read
// (`codegen_units.sysl`): it is placed by a hash of its name, as it was while it was external, rather
// than following its first user as a `private` function does. Followed, every sealed function the
// entry reaches would land in the entry's partition, and a large program would compile in one clang.
sealed_funcs(funcs: Buf[IrFunc], sealed: Set[string]) -> Buf[IrFunc]
    var out: Buf[IrFunc] = buf()

    for f in funcs
        if f.sig.linkage == LinkDefault && sealed.has(f.sig.name)
            var attrs: Buf[(string, string)] = buf()

            for kv in f.sig.attrs
                attrs.push(kv)

            attrs.push((SealedAttr, ""))
            out.push(f with { sig = f.sig with { linkage = LinkInternal, hidden = false, attrs = attrs } })
        else
            out.push(f)

    out
end sealed_funcs

// The string attribute a sealed definition is written with.
const SealedAttr: string = "sysl-sealed"

// **The `source_filename` an executable's module names.** A profile (`--profile-generate`) records
// an `internal` function as `<source file>;<symbol>`, and LLVM's default source file is the path of
// the text clang reads -- `<output>.ll`, or a unit's object beside it. Built to one output and
// optimized to another, the two builds would name every sealed function differently, and
// `--profile-use` would find none of them. One fixed name keeps the profile's names what they were
// while the functions were external: the symbol alone fixes which function each is.
const SealedSource: string = "sysl"
