module sysl

import sysl.sys.sysl_snprintf

// What the built-in types render as -- the sink counterpart of the `print*` family.
//
// These are the same renderings written into a `*Writer` instead of into standard output, and in
// the argument order `Display` declares. They are the built-ins' `display`: what `x.display(out,
// fmt)` lowers to when `x` is a scalar (`14 §5`), so a `Display` written for a struct can render the
// struct's own fields without leaving the allocation-free path.
//
// The two families are separate because a scalar renders the same either way and the `print*` path
// builds no sink to do it, which is the cheaper of two identical answers. That is the whole of the
// reason now: the writer standing for standard output *can* be written here, and is -- `Stdout` in
// the file beside this one -- so what used to be an impossibility is a choice about which path a
// built-in takes.
//
// **Each of them honours its `FormatSpec`**, and `display_pad` is where they all end up: it puts a
// finished run of bytes in the field the specifier asked for, padding with spaces on whichever side
// justification says. Doing it once is the point -- six renderers each growing their own padding is
// six chances for `%8s` to mean something slightly different.
//
// A specifier describes **the field the whole value occupies**, so an implementation rendering
// *parts* hands each part the neutral specifier and applies `fmt` to the whole -- which
// `display_pad` is public for. Forwarding `fmt` straight down is right only when the part being
// rendered *is* the whole rendering, as it is for a wrapper around one field.
//
// What a precision means is left to each renderer, because the conversion letter does not cross the
// boundary -- only a width, a precision, and a justification do. Text truncates to it, a number
// fills out to it in digits, and a real reads it as significant digits, which is printf's meaning
// under each of `%s`, `%d`, and `%g` respectively. Width and precision count **bytes**, as C's do,
// so a `string` renders the same width whether it went through `snprintf` or through here -- with
// the one refinement that truncation backs off to a character boundary rather than handing a sink
// half of a codepoint.

display_fill(out: *Writer, b: u8, n: int)
    var buf: [16]u8
    for i in 0..<16 do buf[i] = b
    var left = n
    while left > 0
        var k = if left < 16 then left else 16
        out.write(buf[0..<usize(k)])
        left -= k
end display_fill

display_pad(text: []const u8, out: *Writer, fmt: FormatSpec)
    var pad = fmt.width - int(text.len)
    if pad < 0 then pad = 0
    if !fmt.left then display_fill(out, 32u8, pad)
    out.write(text)
    if fmt.left then display_fill(out, 32u8, pad)
end display_pad

display_digits(text: []const u8, out: *Writer, fmt: FormatSpec)
    var sign = if text.len > 0usize && text[0] == 45u8 then 1usize else 0usize
    var zeros = 0
    if fmt.prec > int(text.len - sign) then zeros = fmt.prec - int(text.len - sign)
    var pad = fmt.width - int(text.len) - zeros
    if pad < 0 then pad = 0
    if !fmt.left then display_fill(out, 32u8, pad)
    if sign > 0usize then out.write(text[0..<1usize])
    display_fill(out, 48u8, zeros)
    out.write(text[sign..<text.len])
    if fmt.left then display_fill(out, 32u8, pad)
end display_digits

display_str(s: string, out: *Writer, fmt: FormatSpec)
    var b = s.bytes
    var n = b.len
    if fmt.prec >= 0 && usize(fmt.prec) < n then
        n = usize(fmt.prec)
        while n > 0usize && (b[n] & 192u8) == 128u8
            n -= 1usize
    display_pad(b[0..<n], out, fmt)
end display_str

display_int(n: long, out: *Writer, fmt: FormatSpec)
    var buf: [24]u8
    var k = sysl_snprintf(&buf[0], 24usize, c"%lld", n)
    display_digits(buf[0..<usize(k)], out, fmt)
end display_int

display_uint(n: ulong, out: *Writer, fmt: FormatSpec)
    var buf: [24]u8
    var k = sysl_snprintf(&buf[0], 24usize, c"%llu", n)
    display_digits(buf[0..<usize(k)], out, fmt)
end display_uint

// The two renderers above stop at 64 bits, because they reach `snprintf` and C has no conversion
// wider than `%lld`. These carry the same job past it with the digits worked out here instead: a
// frame-local buffer filled from the least significant end, handed to `display_digits` as a slice.
//
// **Doing it this way is what keeps rendering allocation-free**, which is the promise `Display`
// makes and the reason a `no alloc` module can log at all. Going through a `string` would put the
// digits on the heap, and a module that declared it makes no storage could then not print a number.
// The slice is safe to hand over because a `Writer` borrows the bytes it is given rather than
// keeping them (`02`), which is what lets escape analysis pass a stack-backed slice out of here.
//
// 39 digits is the widest an unsigned 128-bit value reaches, and the signed buffer carries one more
// byte for the sign, which `display_digits` reads back off the front.
//
// **Above 128 bits the string path below still runs**, and a value that wide therefore cannot be
// rendered from a module that declares `@no_alloc`. Covering every width needs a renderer generic
// in its receiver, which the lowering cannot yet name.
display_u128(n: u128, out: *Writer, fmt: FormatSpec)
    var buf: [40]u8
    var i = 40usize
    var v = n
    if v == u128(0) then
        i -= 1usize
        buf[i] = 48u8
    else
        while v > u128(0)
            i -= 1usize
            buf[i] = 48u8 + u8(v % u128(10))
            v = v / u128(10)
    display_digits(buf[i..<40usize], out, fmt)
end display_u128

display_i128(n: i128, out: *Writer, fmt: FormatSpec)
    var buf: [41]u8
    var i = 41usize
    var neg = n < i128(0)
    // The magnitude is taken in the unsigned domain so that the most negative value survives it:
    // negating that one in its own type is the one case two's complement has no room for.
    var v = if neg then u128(0) - u128(n) else u128(n)
    if v == u128(0) then
        i -= 1usize
        buf[i] = 48u8
    else
        while v > u128(0)
            i -= 1usize
            buf[i] = 48u8 + u8(v % u128(10))
            v = v / u128(10)
    if neg then
        i -= 1usize
        buf[i] = 45u8
    display_digits(buf[i..<41usize], out, fmt)
end display_i128

display_wide(s: string, out: *Writer, fmt: FormatSpec) = display_digits(s.bytes, out, fmt)

display_real(x: real, out: *Writer, fmt: FormatSpec)
    var buf: [64]u8
    var p = fmt.prec
    if p < 0 then p = 6
    if p > 40 then p = 40
    var k = sysl_snprintf(&buf[0], 64usize, c"%.*g", p, x)
    display_pad(buf[0..<usize(k)], out, fmt)
end display_real

display_bool(b: bool, out: *Writer, fmt: FormatSpec) = display_str(if b then "true" else "false", out, fmt)

display_char(ch: char, out: *Writer, fmt: FormatSpec)
    var buf: [4]u8
    var cp = uint(ch)
    var n = 0usize
    if cp < 128u32 then
        buf[0] = u8(cp)
        n = 1usize
    elif cp < 2048u32 then
        buf[0] = u8(192u32 | (cp >> 6u32))
        buf[1] = u8(128u32 | (cp & 63u32))
        n = 2usize
    elif cp < 65536u32 then
        buf[0] = u8(224u32 | (cp >> 12u32))
        buf[1] = u8(128u32 | ((cp >> 6u32) & 63u32))
        buf[2] = u8(128u32 | (cp & 63u32))
        n = 3usize
    else
        buf[0] = u8(240u32 | (cp >> 18u32))
        buf[1] = u8(128u32 | ((cp >> 12u32) & 63u32))
        buf[2] = u8(128u32 | ((cp >> 6u32) & 63u32))
        buf[3] = u8(128u32 | (cp & 63u32))
        n = 4usize
    display_pad(buf[0..<n], out, fmt)
end display_char
