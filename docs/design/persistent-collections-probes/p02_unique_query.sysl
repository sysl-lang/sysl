// P02: can a program ask whether a `&T` is the only reference to its object (Swift's
// `isKnownUniquelyReferenced`, Rust's `Rc::get_mut`)? A persistent vector updates a node in place
// when it is the node's only holder, and copies it otherwise.

struct Node
    n: int

main()
    val r: &Node = Node(1)

    print(r.is_unique())
