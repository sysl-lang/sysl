// P09: teardown of a deep generic structure in constant stack -- a million-link chain of `&Node[T]`
// and of `&sync SNode[T]`, each element a `&Res` / `int`, the `&Res` with a destructor that counts.
// No recursion in the program; the runtime's worklist must carry it.

static var dropped = 0

struct Res
    n: int

impl Drop for Res
    drop(self)
        dropped += 1

struct Node[T]
    item: T
    next: Option[&Node[T]]

struct SNode[T]
    item: T
    next: Option[&sync SNode[T]]

plain(n: int)
    var head: Option[&Node[&Res]] = None

    for i in 0..<n do head = Some(Node(Res(i), head))

shared(n: int)
    var head: Option[&sync SNode[int]] = None

    for i in 0..<n do head = Some(SNode(i, head))

plain(1000000)
print("plain chain dropped:", dropped)
shared(1000000)
print("shared chain dropped")
