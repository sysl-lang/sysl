module sh.sysl.compiler

import sh.sysl.hocon.{add_entry, path_text, quoted as hocon_quoted, remove_entry, replace_value, set_value, Edit}
import sh.sysl.hocon.{parse as parse_hocon, Value}
import sh.sysl.parsing.{source_of, Diagnostic}
import sysl.buf.{Buf, buf}
import sysl.text.join

// Editing a manifest **by rewriting the smallest run of bytes that has to change** -- the one editor
// behind `sysl add` and every writing `sysl config` command.
//
// A manifest is data, so the obvious rewrite -- read it, change a member, print it back -- is
// available and is wrong. Printing back a parsed value emits the value and nothing else, and the
// manifests in this org are about three fifths comment. All of that goes the first time a tool
// touches the file, and a tool that eats the reasoning out of a file is a tool people stop running.
//
// **The splicing is the hocon package's** (`replace_value`, `add_entry`, `remove_entry`,
// `set_value`): it reads the file into a tree that keeps every byte, which is the same reading the
// manifest reader builds its values from, so an edit and a build cannot disagree about where a key
// is. A new entry takes its siblings' indent and alignment, and nothing already in the file moves.
// What the package cannot decide -- a key written in two places, a key under a value that is not an
// object -- it refuses, and the refusal is passed on as it was said.
//
// Nothing here writes a file or asks a network anything: it is text in and text out, so what it
// decides can be asserted without either. The caller reads the result back through the manifest
// reader before it goes to disk (`config.sysl`).

// A key path as segments, written the way a manifest writes one: `dependencies.usb.options`, with a
// segment that cannot be written bare quoted.
manifest_path_text(segments: []string) -> string
    var parts: Buf[string] = buf()

    for s in segments
        parts.push(s)

    path_text(parts)
end manifest_path_text

// A string as a manifest writes one, quoted and escaped.
manifest_quoted(text: string) -> string = hocon_quoted(text)

// A list of strings as a manifest writes one on one line, each quoted: `["a.c", "b.c"]`.
manifest_quoted_list(items: &Buf[string]) -> string
    var parts: Buf[string] = buf()

    for item in items
        parts.push(hocon_quoted(item))

    "[" + join(parts.view(), ", ") + "]"
end manifest_quoted_list

// A list of names as a manifest writes one, bare: `[cdc, msc]`.
manifest_word_list(items: &Buf[string]) -> string
    var parts: Buf[string] = buf()

    for item in items
        parts.push(path_text(one_segment(item)))

    "[" + join(parts.view(), ", ") + "]"
end manifest_word_list

private one_segment(name: string) -> Buf[string]
    var out: Buf[string] = buf()

    out.push(name)
    out
end one_segment

private edited(answer: Result[Edit, Diagnostic]) -> Result[string, string] = answer match
    Ok(e) -> Ok(e.text)
    Err(d) -> Err(d.message)

// The text with the value at `path` replaced, or added where it is not set.
manifest_set(text: string, path: string, value: string) -> Result[string, string] =
    edited(set_value(source_of(ManifestName, text), path, value))

// The text with the value at `path` replaced; refused where it is not set.
manifest_replace(text: string, path: string, value: string) -> Result[string, string] =
    edited(replace_value(source_of(ManifestName, text), path, value))

// The text with an entry added at `path`; refused where it is already set.
manifest_add(text: string, path: string, value: string) -> Result[string, string] =
    edited(add_entry(source_of(ManifestName, text), path, value))

// The text with the entry at `path` taken out, with the comment lines directly above it.
manifest_remove(text: string, path: string) -> Result[string, string] =
    edited(remove_entry(source_of(ManifestName, text), path))

// The value a manifest's text holds at a path given as segments, or `None` where it holds none. The
// text is read as HOCON alone, so this answers for a file the manifest reader would refuse too.
manifest_value_at(text: string, segments: &Buf[string]) -> Option[Value]
    val root = parse_hocon(source_of(ManifestName, text)) match
        Err(_) -> return None
        Ok(doc) -> doc.root

    var at = root

    for s in segments
        if !at.is_obj() then return None

        at = at.get(s) match
            None -> return None
            Some(v) -> v

    Some(at)
end manifest_value_at

// A manifest with one dependency added, or a sentence saying why it could not be.
//
// The result is not written anywhere by this -- the command re-reads it through the manifest reader
// before it goes to disk, so a rewrite that produced something the compiler cannot read fails with
// the manifest untouched.
add_dependency(text: string, label: string, coordinate: string,
               version: string) -> Result[string, string] =
    add_dependency_entry(text, label, s"{ git = ${hocon_quoted(coordinate)}, version = ${hocon_quoted(version)} }")

// The same, with the entry's value already written: `{ git = "…", version = "…", optional = true }`.
add_dependency_entry(text: string, label: string, entry: string) -> Result[string, string]
    if manifest_value_at(text, segments_of(["dependencies", label])).is_some()
        return Err(s"'$label' is already a dependency of this project — change its version in " +
            s"$ManifestName, or remove the entry and add it again")

    manifest_add(text, manifest_path_text(["dependencies", label]), entry)
end add_dependency_entry

// Segments as a buffer.
segments_of(parts: []string) -> Buf[string]
    var out: Buf[string] = buf()

    for p in parts
        out.push(p)

    out
end segments_of
