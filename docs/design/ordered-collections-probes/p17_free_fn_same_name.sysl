// `sysl.container` has free `union(a: Set[K], b: Set[K])`. May the same module declare a second
// `union` over a sorted set, told apart by its parameter types?

struct HSet[K]
    n: usize

struct SSet[K: Ord]
    n: usize

union[K](a: HSet[K], b: HSet[K]) -> HSet[K] = HSet(a.n + b.n)

union[K: Ord](a: SSet[K], b: SSet[K]) -> SSet[K] = SSet(a.n + b.n)

val h: HSet[int] = HSet(1)
val s: SSet[int] = SSet(2)

print(union(h, h).n, union(s, s).n)
