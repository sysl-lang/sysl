module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.math.bigint.from_int
import sysl.text.Search

// The declaration pass, from parsed files to the tables the later stages read.
//
// **It runs in the order the questions can be answered in, and no other.** Every name is registered
// before any type is resolved, because a declaration may name one written below it; every type is
// resolved before visibility is checked, because that question is about two declarations at a time
// and either may be written below the other.

// The declarations of a compilation, read.
//
// A compilation is a **list** of files rather than one, because a module is written across as many
// as it likes and a name in one of them means what a sibling declared. Answers with the tables where
// nothing was refused, and with everything there was to say where something was.
analyze_decls(units: Buf[Program], t: Target) -> Result[&Tables, Buf[Placed]]
    val a = analysis_for(t)

    read_decls(a, units)

    if a.found.is_empty() then Ok(a.tables) else Err(a.diagnostics())
end analyze_decls

// The same, over one file.
analyze_decls_of(unit: Program, t: Target) -> Result[&Tables, Buf[Placed]]
    var units: Buf[Program] = buf()

    units.push(unit)
    analyze_decls(units, t)
end analyze_decls_of

// A program's file may not declare a module the library carries.
//
// **A module's declarations are one set however many files they came from**, so a program with a
// `sysl` directory of its own would not be writing a module beside the standard one -- it would be
// adding to it, sharing its keys and shadowing whatever name it happened to reuse. Nothing in the
// file tells that from a mistake, and the mistake is the likelier reading.
//
// A compilation that **produces** the library is the one reading under which such a file is the
// library rather than an addition to it, and that is said by the build, never inferred.
private refuse_library_modules(a: &Analysis, units: Buf[Program])
    var carried: Buf[string] = buf()

    for i in 0..<units.len()
        val u = units.at(i)

        if library_file(a, u) then carried.push(module_of_unit(u))

    if carried.is_empty() then return

    for i in 0..<units.len()
        val u = units.at(i)
        val name = module_of_unit(u)

        if u.src.name.starts_with(s"$StdPrefix/") || !holds_string(carried, name) then continue

        // No import is read here: the refusal is about the header, and the modules a path could
        // lead to are not registered yet.
        val scope = Scope(name, no_imports(), u.src, u.pkg)

        val at = u.module_name match
            Some(m) -> m.span
            None -> if u.body.is_empty() then span_zero() else u.body.at(0).span

        a.fault(scope, at, s"'$name' is the module every program is compiled against, so " +
                s"${u.src.name} cannot declare it — its declarations would join the library's " +
                "rather than sit beside them")
end refuse_library_modules

// Whether a file is one the standard module supplied, asked before any scope exists.
private library_file(a: &Analysis, u: Program) -> bool =
    u.src.name.starts_with(s"$StdPrefix/") && !holds_string(a.producing, u.src.name)

// The pass itself, on an analysis a caller may go on reading afterwards.
read_decls(a: &Analysis, written: Buf[Program], has_entry_point: bool = true) -> Buf[Program]
    // **A `c const` and a `c type` are measured before anything is registered**, so that everything
    // downstream finds ordinary declarations: a constant holding a number and a transparent subtype
    // of an integer. It is first because a `c const` is what the declarations around it are written
    // in terms of -- an array's bound, a field's width -- and a compilation with no block anywhere
    // never looks for a clang.
    refuse_library_modules(a, written)

    val measured = c_probe_lower(a, written, a.tables.target)

    // **A `derives` clause becomes the `impl` block a reader could have written**, before anything
    // is registered: everything downstream then finds an ordinary block and needs to know nothing
    // about deriving.
    val units = derived_units(a, measured)

    // **Which file the program starts in is settled before anything is hoisted**, because it decides
    // what the hoisting passes are given: that file is a body, so its `val`s and the functions that
    // read what it binds are local to it and are not the module's to register. Every other file
    // hands over everything it has.
    val entry = entry_file(a, units, has_entry_point)

    refuse_two_beginnings(a, units, entry)
    refuse_stray_static(a, units, entry)

    if entry.is_some()
        a.tables.entry_src = units.at(entry.unwrap()).src.name
        a.tables.entry_captures = capturing(units.at(entry.unwrap()).body)

    hoist_units(a, units)

    var scopes: Buf[Scope] = buf()

    for i in 0..<units.len()
        scopes.push(scope_of_unit(a, units.at(i)))

    // Every declaration exists now, so what an `import` claimed a module declares can be looked up.
    for i in 0..<units.len()
        check_imports(a, scopes.at(i), units.at(i).body)

    // A generic enum's pinned underlying type is refused before any of that, because it is the one
    // mistake in an enum declaration no instantiation would find: a generic enum nothing names is
    // never made real.
    refuse_pinned_generic_enums(a)

    // **A type parameter's default is held to being one where it is written**, before anything
    // applies the declaration: a default on a parameter that is solved is refused, and a written
    // one is read in the order a use would fill it.
    for i in 0..<units.len()
        check_solved_defaults(a, scopes.at(i), units.at(i).body)

    check_type_defaults(a)

    // **The asserts a module file declared beside its declarations are settled BEFORE the eager
    // instantiation**, and the order is observable: `@assert(sizeof(Cell) <= 32)` makes `Cell` real,
    // and every type its variants name with it, ahead of every other type the compilation has. The
    // record of what was laid out is in the order things were made real, so settling them later
    // moves those types behind the whole standard library's. The entry file's wait for the bodies.
    check_top_level_asserts(a, units, false)

    // A type that takes no arguments is instantiated whether or not anything uses it, so a field of
    // a type that does not exist is a mistake reported at the declaration rather than at whatever
    // first mentions it.
    eagerly_instantiate(a)

    // Every named subtype is resolved for the same reason, and by a road of its own: an alias builds
    // no constrained type to be checked, and what it owes at its declaration is that the name it
    // stands for exists and that following it terminates.
    resolve_named_subtypes(a)

    // **How far each declaration reaches is settled BEFORE the members are hoisted**, and so is
    // every signature: what a signature mentions is made real while it is read, and the record a
    // compilation keeps of what it laid out is in the order things were made real. Reading the
    // signatures after the members would put every type a member's own signature mentions ahead of
    // the ones the declarations wrote, which is not the order anything else in the compilation
    // agrees with.
    // **A setter is paired with its property before any signature is read**, because the parameter
    // the source deliberately leaves out carries a placeholder until it is: resolving one first
    // reports a type nobody wrote at a position nobody chose.
    pair_all_setters(a)

    // Then every signature, which is what makes a mistake in one a mistake at the declaration.
    resolve_signatures(a)

    // How far each declaration reaches is settled after them, since the question is about two
    // declarations at a time -- and because a signature naming something the file may not reach is
    // told that outright rather than told it is more visible than what it names.
    check_const_scalars(a)
    check_exposed_types(a)

    // And what each `&sync T` promises about its pointee, which waits for the same reason a bound
    // does: a type that reaches itself through a `&sync` field is resolved while its own field list
    // is still being filled, so the question is held until every field is in.
    settle_shared_checks(a)

    // Then the members: every type's own, and the ones an `impl` block gives it. It runs after the
    // eager instantiation because a member's `Self` is that instantiation.
    hoist_all_members(a, units)
    units
end read_decls

// What an `import` claimed a module declares.
//
// **The file's imports are read in order**, so a later one sees the names an earlier one bound and can
// be told it collides with them.
private check_imports(a: &Analysis, scope: Scope, body: Buf[Stmt])
    var taken: Buf[string] = buf()

    for i in 0..<body.len()
        *body.at(i).kind match
            ImportDecl(d) ->
                val said = import_refusals(a, scope, body.at(i).span, d, &taken)

                for k in 0..<said.len()
                    a.fault(scope, said.at(k).0, said.at(k).1)
            _ -> ()

// Everything one `import` is refused for, each with the place to point at, and the names it bound
// added to `taken`.
//
// **An import never grants access**: everything it names is reachable by its full path already, so
// what is decided here is which shorter spellings mean what -- and which would mean two things.
//
// What was written is what a diagnostic quotes; what it *names* is that read through the package
// layer, so a file of a fetched package writes its own short names and a consumer writes the name
// its manifest gave the package.
import_refusals(a: &Analysis, scope: Scope, span: Span, d: ImportDecl,
                taken: *Buf[string]) -> Buf[(Span, string)]
    var out: Buf[(Span, string)] = buf()
    val written = joined(d.path, ".")
    val path = in_package(a, scope.pkg, written)

    // **A wildcard is over a module's members**, so there has to be a module to have them. An import
    // IS a dependency, whether or not anything below it names what was brought in.
    if d.wildcard
        if a.tables.has_module(path) then depends_on_module(a, scope, path, span)
        else out.push((span, s"no module is called '$written'"))

        return out

    // **A selector list may reach a sub-module of a directory that holds no source of its own**,
    // which is a module's parent without being one -- so it asks only that the path lead somewhere,
    // and each selector is a module beneath it or a member of it.
    if !d.selectors.is_empty()
        if !names_module(a, path)
            out.push((span, s"no module is called '$written'"))
            return out

        for i in 0..<d.selectors.len()
            val s = d.selectors.at(i)
            val sub = s"$path.${s.name}"

            // A selector list points at the selector, which is the word that has to go.
            if a.tables.has_module(sub) then import_module(a, scope, s.span, selector_bound(s), sub,
                                                           taken, &out)
            else import_name(a, scope, s.span, selector_bound(s), path, s.name, taken, &out)

        return out

    // **The longest prefix that names a module wins**, exactly as a qualified reference is read: the
    // module where there is one, and a member of the module in front of it otherwise.
    if a.tables.has_module(path)
        import_module(a, scope, span, import_bound(d), path, taken, &out)
        return out

    val cut = last_dot_in(written)
    val home = if cut.is_some() then in_package(a, scope.pkg, written[0..<cut.unwrap()]) else ""

    if cut.is_none() || !a.tables.has_module(home)
        out.push((span, s"no module is called '$written', and nothing declares it"))
        return out

    import_name(a, scope, span, import_bound(d), home, written[cut.unwrap() + 1..<written.bytes.len],
                taken, &out)
    out
end import_refusals

// A module bound to a shorter name. **Binding it to the name it already answers to asks for what is
// already true**, so it is left alone rather than reported as the collision with itself it is.
private import_module(a: &Analysis, scope: Scope, at: Span, bound: string, home: string,
                      taken: *Buf[string], out: *Buf[(Span, string)])
    depends_on_module(a, scope, home, at)

    if bound != home then import_name_free(a, scope, at, bound, taken, out)

// One name brought in from a module, which is already a dependency on that module.
//
// **A declaration another file keeps to itself is refused where the import is written**, rather than
// at whatever later names it: the clause is the mistake, and it is the line a reader has to change.
private import_name(a: &Analysis, scope: Scope, at: Span, bound: string, home: string, name: string,
                    taken: *Buf[string], out: *Buf[(Span, string)])
    depends_on_module(a, scope, home, at)

    if !import_name_free(a, scope, at, bound, taken, out) then return

    val key = module_qualify(home, name)

    if !declares(a, key) then out.push((at, s"'$home' declares no '$name' — there is no '$home.$name'"))
    elif !reachable_key(a, key, scope) then out.push((at, out_of_reach(a, key)))
end import_name

// What an import may not be called here, and whether it may be called this.
//
// **A name that already begins a module path is refused outright** rather than resolved by a rule: a
// binding that was both would make `fs.read` mean one thing in a file that imported `fs` and another
// in the file beside it, and the import can be given any other name with `as`. Binding one name twice
// is the plainer mistake, reported at the second import rather than at whichever use found two
// answers. What may not be hidden is a path the importing file could have WRITTEN (`writes_module`),
// never a canonical prefix: a `path` dependency's is its label, which looks like a module's head.
private import_name_free(a: &Analysis, scope: Scope, at: Span, bound: string, taken: *Buf[string],
                         out: *Buf[(Span, string)]) -> bool
    if writes_module(a, scope.pkg, bound)
        out.push((at, s"'$bound' is a module, so importing something else under that name would hide " +
                      "it — import it as another name with 'as'"))
        return false

    if holds_string(*taken, bound)
        out.push((at, s"'$bound' is already imported"))
        return false

    taken.push(bound)
    true
end import_name_free

// The entries a table took on since a mark, taken back out.
rewind_registered(into: &Table[Type], mark: usize)
    var made: Buf[string] = buf()

    for i in mark..<into.len()
        made.push(into.key_at(i))

    for i in 0..<made.len()
        into.remove(made.at(i))

// Records that a module reached into another, which is what resolving a name to a key *makes*.
//
// **A module does not depend on itself, and nothing depends on the ROOT module**: the library lives
// there and is the language rather than a module, and a program's own root-module declarations are
// its files' alone. So the root only ever depends, and is never depended on -- which is two rules
// and not one, and the edges OUT of the root are ordinary edges. A path that names no
// module this compilation has files for is not an edge either -- an import may be written for one
// that does not exist, and the diagnostic for that says so far better than a graph could.
depends_on(a: &Analysis, scope: Scope, key: string, span: Span) =
    depends_on_module(a, scope, module_of(key), span)

// The same, where the module is already known rather than read off a key.
//
// **Where the reference was written is recorded beside the edge**, because a diagnostic about an
// edge lands at the line that made it rather than anywhere either module states anything. A bare
// name resolving to another module carries no span of its own, so such a reference records the file
// and nothing more, and a later reference that does have one fills the position in.
depends_on_module(a: &Analysis, scope: Scope, to: string, written: Span)
    val from = scope.module_name

    if to == from || to == ModuleRoot || !a.tables.has_module(to) then return

    // A lookup asked by spelling alone has no position to give, and the form that wrote the name
    // may have said where it is (`Tables.reference_at`).
    val span = if written.is_empty() then a.tables.reference_at else written

    for i in 0..<a.tables.module_deps.len()
        if a.tables.module_deps.at(i).0 == from
            val reached = a.tables.module_deps.at(i).1

            if holds_string(reached, to)
                if !span.is_empty() then position_edge(a, from, to, scope, span)
                return

            var grown = reached

            grown.push(to)
            a.tables.module_deps.set(i, (from, grown))
            a.tables.module_edges.push(ModuleEdge(from, to, scope, span))
            return

    var first: Buf[string] = buf()

    first.push(to)
    a.tables.module_deps.push((from, first))
    a.tables.module_edges.push(ModuleEdge(from, to, scope, span))

// Fills in the position of an edge already recorded, where the first reference to make it had none.
private position_edge(a: &Analysis, from: string, to: string, scope: Scope, span: Span)
    for i in 0..<a.tables.module_edges.len()
        val e = a.tables.module_edges.at(i)

        if e.from == from && e.to == to
            if e.span.is_empty() then a.tables.module_edges.set(i, ModuleEdge(from, to, scope, span))
            return

// Whether this compilation has any declaration under a key, of any kind.
declares(a: &Analysis, key: string) -> bool =
    a.tables.types.has(key) || a.tables.funcs.has(key) || a.tables.consts.has(key) ||
        a.tables.vals.has(key) || a.tables.externs.has(key) || a.tables.extern_vars.has(key) ||
        a.tables.overloads.has(key) || is_variant_name(a, key)

// The keys the scope's wildcards offer for one written name, each once -- where there are two or more,
// an unqualified use of the name is **ambiguous** rather than the first wildcard's.
//
// **A wildcard offers only what is visible here**, which is what keeps a module's private helper from
// making a name from elsewhere ambiguous; `has` is the table the use site is asking, since one
// spelling may be a type in one module and a function in another. The standard module is a wildcard
// like any other in this, the auto-import being exactly a wildcard every file starts with.
//
// **Only the level that answers is asked** -- see `answering_imports` -- so a block's wildcard is not
// made ambiguous by a file's, and a name the level imported by name offers nothing to be ambiguous.
offered_by(a: &Analysis, scope: Scope, name: string, has: &Fn(string) -> bool) -> Buf[string]
    val im = answering_imports(a, scope, name, has)
    val bound = im.name_key(name)
    var out: Buf[string] = buf()

    if bound.is_some() && has(bound.unwrap()) then return out

    for i in 0..<im.wildcards.len()
        val key = module_qualify(im.wildcards.at(i), name)

        if !holds_string(out, key) && has(key) && reachable_key(a, key, scope) then out.push(key)

    out
end offered_by

// **The imports a written name is answered from: the innermost level that binds it or offers it.**
// A block's imports are asked before an outer block's and those before the file's, and within one
// level a name imported by name beats a wildcard -- so a block's wildcard beats the file's selector,
// the reference's order. Where no level answers, every import is handed back, which is what a use
// that finds nothing has always been read against.
answering_imports(a: &Analysis, scope: Scope, name: string, has: &Fn(string) -> bool) -> Imports
    if scope.imports.levels.is_empty() then return scope.imports

    for i in 0..<scope.imports.depth()
        val im = scope.imports.level(i)
        val bound = im.name_key(name)

        if bound.is_some() && has(bound.unwrap()) then return im

        for j in 0..<im.wildcards.len()
            val key = module_qualify(im.wildcards.at(j), name)

            if has(key) && reachable_key(a, key, scope) then return im

    scope.imports
end answering_imports

// What an ambiguous wildcard offer is refused with, naming each wildcard it came through.
ambiguous_offer(name: string, keys: Buf[string]) -> string
    var from = ""

    for i in 0..<keys.len()
        if i > 0 then from = from + " and "

        from = from + s"'${module_of(keys.at(i))}.*'"

    s"'$name' is offered by $from — import it selectively, or write the module it comes from"
end ambiguous_offer

// Whether a key names a variant of an enum, which an import may name as well as the enum itself.
private is_variant_name(a: &Analysis, key: string) -> bool = enum_of_variant(a, key).is_some()

// The enum a key names a variant of, where it names one.
//
// **A variant is not a declaration of its own**, so it has no reach written on it and no row in the
// access table: what it is worth is the enum's, which is what makes `private enum Shape` keep `Dot`
// as well.
enum_of_variant(a: &Analysis, key: string) -> Option[string]
    val here = module_of(key)
    val name = module_bare(key)

    for i in 0..<a.tables.types.len()
        val decl = a.tables.types.at(i)

        if module_of(a.tables.types.key_at(i)) == here then
            decl.kind match
                EnumOf(e) ->
                    for j in 0..<e.variants.len()
                        if e.variants.at(j).name == name then
                            return Some(a.tables.types.key_at(i))
                _ -> ()

    None
end enum_of_variant

// A pinned underlying type says which one integer the discriminants are laid in. A generic enum has
// an instantiation for every argument list rather than one, so there is no single storage for the
// annotation to be about -- and the two cannot both be written.
private refuse_pinned_generic_enums(a: &Analysis)
    for i in 0..<a.tables.types.len()
        val decl = a.tables.types.at(i)

        decl.kind match
            EnumOf(d) ->
                if !d.tparams.is_empty() && d.underlying.is_some() then
                    a.fault(decl.scope, decl.span,
                            s"a generic enum cannot pin an underlying type — '${d.name}' takes " +
                            "type parameters")
            _ -> ()

// Every non-generic enum, then every non-generic struct.
//
// **The two are separate passes and the order is part of the answer**: what a compilation records is
// the order its types were made real in, and that order is what a back end lays them out in.
private eagerly_instantiate(a: &Analysis)
    for i in 0..<a.tables.types.len()
        val key = a.tables.types.key_at(i)
        val decl = a.tables.types.at(i)

        decl.kind match
            EnumOf(d) ->
                if d.tparams.is_empty() then
                    instantiate_enum(a, decl.scope, decl.span, d.name, key, d, decl.scope, buf())
            _ -> ()

    for i in 0..<a.tables.types.len()
        val key = a.tables.types.key_at(i)
        val decl = a.tables.types.at(i)

        decl.kind match
            StructOf(d) ->
                if d.tparams.is_empty() then
                    instantiate_struct(a, decl.scope, decl.span, d.name, key, d, decl.scope, buf())
            _ -> ()

// Every named subtype, resolved.
private resolve_named_subtypes(a: &Analysis)
    for i in 0..<a.tables.types.len()
        val key = a.tables.types.key_at(i)
        val decl = a.tables.types.at(i)

        decl.kind match
            TypeOf(d) ->
                if alias_cycle(a, decl.scope, key, d) then
                    a.fault(decl.scope, decl.span,
                            s"'${d.name}' is an alias for itself, through a chain of aliases")
                else
                    instantiate_named_subtype(a, decl.scope, decl.span, d.name, key, d, decl.scope,
                                              buf())
            _ -> ()

// Whether following a named subtype's base leads back to the name itself.
//
// The walk is what catches it rather than the resolve, which would otherwise recurse until the stack
// ran out.
private alias_cycle(a: &Analysis, scope: Scope, key: string, d: TypeDecl) -> bool
    var seen: Buf[string] = buf()
    var here = key
    var base = d.base

    for _step in 0..<64
        val name = plain_alias_target(base)

        if name.is_none() then return false

        val next = lookup_type_key(a, scope, name.unwrap())

        if next.is_none() then return false
        if next.unwrap() == key then return true

        val decl = a.tables.types.get(next.unwrap()).unwrap()

        decl.kind match
            TypeOf(inner) ->
                if !is_plain_alias(inner) then return false

                base = inner.base
            _ -> return false

    false
end alias_cycle

// The bare name a written type is, where it is one -- an alias chain is followed through names and
// through nothing else.
private plain_alias_target(t: TypeRef) -> Option[string] = *t.kind match
    NamedType(name, args) -> if args.is_empty() then Some(name) else None
    _ -> None

// Every signature, resolved: the functions, the externs, the storage, and the members of every type.
private resolve_signatures(a: &Analysis)
    for i in 0..<a.tables.funcs.len()
        val f = a.tables.funcs.at(i)

        check_bound_names(a, f.scope, f.decl.name, f.decl.bounds)

        // **A GENERIC SIGNATURE IS READ AT STAND-INS, AND WHAT THAT READING BUILDS IS NOT A TYPE THE
        // PROGRAM HAS.** `spawn[T](…) -> Option[Thread]` names an `Option[Thread]` at every
        // instantiation and at none of them: the declaration is a shape, and the types a program
        // actually lays out are the ones its calls ask for. So the complaints are kept and the
        // registrations are taken back.
        val generic = !f.decl.tparams.is_empty()
        val trial = if generic then a.sandboxed() else 0
        val structs = a.tables.struct_insts.len()
        val enums = a.tables.enum_insts.len()
        val constrained = a.tables.constrained_insts.len()

        resolve_func_signature(a, f.scope, f.decl.tparams, f.decl.bounds, f.decl.tvalues,
                               f.decl.tpacks, f.decl.params, f.decl.ret_type)

        if generic
            a.release(trial)
            rewind_registered(a.tables.struct_insts, structs)
            rewind_registered(a.tables.enum_insts, enums)
            rewind_registered(a.tables.constrained_insts, constrained)

    for i in 0..<a.tables.externs.len()
        val key = a.tables.externs.key_at(i)
        val d = a.tables.externs.get(key).unwrap()
        val scope = scope_of_key(a, key)
        var vector_said = false

        for j in 0..<d.params.len()
            val p = d.params.at(j)
            val t = resolve_type(a, scope, p.typ, no_bindings())

            if !vector_said && is_vector(t)
                extern_vector_fault(a, key, s"'${p.name}' of the 'extern' '${d.name}' is ${type_show(t)}, " +
                                    "and how a vector reaches a C function differs by target and by " +
                                    "what the other side was compiled for — so sysl will not guess at " +
                                    s"one. Pass the lanes through memory, as a '*${lane_shown(t)}'")
                vector_said = true
            end if

        if d.ret_type.is_some()
            val t = resolve_type(a, scope, d.ret_type.unwrap(), no_bindings())

            if !vector_said && is_vector(t) then
                extern_vector_fault(a, key, s"the 'extern' '${d.name}' returns ${type_show(t)}, and how " +
                                    "a vector comes back from a C function differs by target and by " +
                                    "what the other side was compiled for — so sysl will not guess at " +
                                    s"one. Have it write the lanes through a '*${lane_shown(t)}' the " +
                                    "caller supplies")
        end if

    // **Module storage is deliberately absent from this, and its written type is resolved where the
    // storage itself is read.** Resolving it here would make every type a module's storage names
    // real ahead of every type its members name, and the record a compilation keeps of what it laid
    // out is in the order things were made real: the storage is laid down after the members are
    // hoisted, so that is where its types come from.
    resolve_value_types(a, a.tables.consts)
    resolve_extern_var_types(a)

    for i in 0..<a.tables.types.len()
        val decl = a.tables.types.at(i)
        val key = a.tables.types.key_at(i)

        decl.kind match
            StructOf(d) ->
                check_bound_names(a, decl.scope, d.name, d.bounds)
                resolve_members(a, decl.scope, key, d.tparams, d.bounds, d.tvalues, d.members)

                // What an `invariant` may read is settled here, where the field types have just
                // been made real and the whole aliasing rule that rests on them is still ahead.
                check_invariants_of(a, decl.scope, decl.span, key, d)
            EnumOf(d) ->
                check_bound_names(a, decl.scope, d.name, d.bounds)
                resolve_members(a, decl.scope, key, d.tparams, d.bounds, d.tvalues, d.members)
            TraitOf(d) ->
                check_bound_names(a, decl.scope, d.name, d.bounds)
                check_trait_supers(a, key, d)
                resolve_members(a, decl.scope, key, d.tparams, d.bounds, d.tvalues, d.methods, true)
            _ -> ()

    // **An `impl` block's signatures are resolved where its members are lowered**, which is the
    // member hoist: a concrete block's are made real there and a generic one's are read by the walk
    // that checks its bodies. Resolving them again here would report one mistake twice, in the terms
    // of a substitution that knows less.
end resolve_signatures

// The terms a declaration's own file set up, which is where its signature is read.
// How a vector crosses to C differs by target and by what the other side was compiled for, so an
// `extern` taking or answering one is refused at its declaration rather than declared at a guess.
private extern_vector_fault(a: &Analysis, key: string, message: string)
    val home = a.tables.extern_scopes.get(key).unwrap()

    a.fault(home.scope, home.span, message)

// The type a vector's lanes are, as a diagnostic shows it.
private lane_shown(t: Type) -> string = t match
    Vector(_, elem) -> type_show(*elem)
    _ -> type_show(t)

private scope_of_key(a: &Analysis, key: string) -> Scope
    val decl = a.tables.types.get(key)

    if decl.is_some() then return decl.unwrap().scope

    val f = a.tables.funcs.get(key)

    if f.is_some() then return f.unwrap().scope

    // **An `extern` is a declaration like any other and its signature is read in its own file's
    // terms**, which is the whole of what an import line is for. It is in neither table above --
    // `externs` is a table of its own -- so leaving it out here handed a binding's foreign
    // declarations a scope carrying the right module and *no imports*, and every type its own file
    // had imported from a module beside it read as `unknown type`. It is the ordinary shape of a C
    // binding whose ABI structs live one module down, so it took out nine of the org's packages at
    // once while looking like a defect in each of them.
    val e = a.tables.extern_scopes.get(key)

    if e.is_some() then return e.unwrap().scope

    Scope(module_of(key), no_imports(), source_of("", ""), no_packaging())
end scope_of_key

private resolve_value_types(a: &Analysis, from: &Table[ValueDecl])
    for i in 0..<from.len()
        val v = from.at(i)

        if v.typ.is_some() then resolve_type(a, v.scope, v.typ.unwrap(), no_bindings())

// An `extern` variable's type, and the one type it may not be: a symbol is an address, and a value
// with no representation has nothing to put one at. Asked of the declaration, so it is said whether
// or not anything reads it.
private resolve_extern_var_types(a: &Analysis)
    for i in 0..<a.tables.extern_vars.len()
        val v = a.tables.extern_vars.at(i)

        if v.typ.is_none() then continue

        if resolve_type(a, v.scope, v.typ.unwrap(), no_bindings()) == Unit then
            a.fault(v.scope, v.span, s"'${v.name}' cannot be an 'extern' variable: a unit value " +
                    "occupies nothing, so there is no storage for the linker to resolve the name to")
end resolve_extern_var_types

// A declaration's own parameters, each standing for itself: what a signature is read against before
// anything instantiates it. A type parameter stands as its own name and a **value** parameter as a
// zero of the type the declaration wrote for it -- it is not a type, and standing at a number is
// what lets `[N]T` read as an array.
stand_ins(a: &Analysis, scope: Scope, tparams: Buf[string],
          tvalues: Buf[TypeBinding]) -> Buf[Binding]
    var out: Buf[Binding] = buf()

    for i in 0..<tparams.len()
        out.push(Binding(tparams.at(i), stand_in(a, scope, tparams.at(i), tvalues)))

    out
end stand_ins

private stand_in(a: &Analysis, scope: Scope, tp: string, tvalues: Buf[TypeBinding]) -> Type
    val written = binding_named(tvalues, tp)

    if written.is_none() then return Abstract(tp, buf())

    ConstArg(from_int(0), resolve_type(a, scope, written.unwrap(), no_bindings()))
end stand_in

private resolve_func_signature(a: &Analysis, scope: Scope, tparams: Buf[string],
                               bounds: Buf[NamedBounds], tvalues: Buf[TypeBinding],
                               tpacks: Buf[string], params: Buf[Param], ret: Option[TypeRef])
    // The parameters stand in for themselves **carrying what the declaration asked of them**, which
    // is what lets a signature name a projection off one: `S::Token` is answerable exactly where `S`
    // is bounded by a trait declaring a `Token`.
    val subst = abstract_subst(a, scope, tparams, bounds, tvalues, tpacks, buf())

    for i in 0..<params.len()
        resolve_type(a, scope, params.at(i).typ, subst)

    if ret.is_some() then resolve_type(a, scope, ret.unwrap(), subst)

// **Only a concrete member of a concrete type keeps what its signature makes real**, the rule the
// free functions above follow and for the same reason: a member of a trait, a member of a generic
// type and a member generic in its own right -- a bare-arrow parameter makes it one -- are shapes,
// made real per call, and the types a program lays out are the ones those calls ask for. Keeping
// the reading here would move `Option[Span]` from where the first body asking for it is typed to
// the declaration of `read(*self, start: u8 -> bool) -> Option[Span]`, ahead of every type the
// library's bodies make real.
private resolve_members(a: &Analysis, scope: Scope, owner: string, tparams: Buf[string],
                        bounds: Buf[NamedBounds], tvalues: Buf[TypeBinding],
                        members: Buf[MethodDecl], is_trait: bool = false)
    val shape = is_trait || !tparams.is_empty()
    val whole = if shape then Some(registration_mark(a)) else None
    var subst = abstract_subst(a, scope, tparams, bounds, tvalues, buf(), buf())

    subst.push(Binding("Self", self_type(a, scope, owner, tparams, bounds)))

    for i in 0..<members.len()
        val m = members.at(i)
        val generic = !shape && !with_member_call_bounds(m).tparams.is_empty()
        val own = if generic then Some(registration_mark(a)) else None

        // A type's own member is told about a length at its DECLARATION, which the member hoist
        // asks -- after this. Asked here first, the reading below finds the sentence already said
        // about the member and adds nothing at the type inside it. A trait's member is never
        // lowered, so the reading is the only thing that says it.
        if !is_trait then
            check_pack_spellings(a, scope, m.span, joined_names(tparams, m.tparams), m.tpacks,
                                 joined_values(tvalues, m.tvalues), m.params, m.ret_type)

        resolve_method(a, scope, m, subst)

        if own.is_some() then rewind_to(a, own.unwrap())

    if whole.is_some() then rewind_to(a, whole.unwrap())
end resolve_members

private joined_names(outer: Buf[string], own: Buf[string]) -> Buf[string]
    var out: Buf[string] = buf()

    for i in 0..<outer.len()
        out.push(outer.at(i))

    for i in 0..<own.len()
        out.push(own.at(i))

    out
end joined_names

joined_values(outer: Buf[TypeBinding], own: Buf[TypeBinding]) -> Buf[TypeBinding]
    var out: Buf[TypeBinding] = buf()

    for i in 0..<outer.len()
        out.push(outer.at(i))

    for i in 0..<own.len()
        out.push(own.at(i))

    out
end joined_values

// How far each instantiation table had been filled when a reading at stand-ins began, and the trial
// that reading runs in: what it rewinds to.
private struct RegistrationMark
    trial: usize
    structs: usize
    enums: usize
    constrained: usize

private registration_mark(a: &Analysis) -> RegistrationMark
    val trial = a.sandboxed()

    RegistrationMark(trial, a.tables.struct_insts.len(), a.tables.enum_insts.len(),
                     a.tables.constrained_insts.len())

private rewind_to(a: &Analysis, m: RegistrationMark)
    a.release(m.trial)
    rewind_registered(a.tables.struct_insts, m.structs)
    rewind_registered(a.tables.enum_insts, m.enums)
    rewind_registered(a.tables.constrained_insts, m.constrained)

private resolve_method(a: &Analysis, scope: Scope, m: MethodDecl, outer: Buf[Binding])
    var subst: Buf[Binding] = buf()

    for i in 0..<outer.len()
        subst.push(outer.at(i))

    for i in 0..<m.tparams.len()
        subst.push(Binding(m.tparams.at(i), stand_in(a, scope, m.tparams.at(i), m.tvalues)))

    for i in 0..<m.params.len()
        resolve_type(a, scope, m.params.at(i).typ, subst)

    if m.ret_type.is_some() then resolve_type(a, scope, m.ret_type.unwrap(), subst)

// What `Self` stands for inside a type's own members: the type at its own parameters.
private self_type(a: &Analysis, scope: Scope, owner: string, tparams: Buf[string],
                  bounds: Buf[NamedBounds]) -> Type
    val decl = a.tables.types.get(owner)

    if decl.is_none() then return Unknown

    // The arguments are the declaration's own parameters standing in for themselves, **carrying what
    // it asked of them** -- a field written `[8]C::W` is answerable exactly where `C` is bounded by
    // the trait declaring a `W`.
    //
    // **A value parameter stands here as a NAME, not as the number it stands as in a signature.**
    // This builds the type at its own parameters, which reads its fields -- and a field's length is
    // judged where something instantiates the type, not here. Standing at a number, `[N + 1]int`
    // and `[N - 1]int` would be judged as the lengths of a type nobody asked for.
    val stood = abstract_subst(a, scope, tparams, bounds, buf(), buf(), buf())
    var targs: Buf[Type] = buf()

    for i in 0..<tparams.len()
        targs.push(bound_type(stood, tparams.at(i)).unwrap_or(Abstract(tparams.at(i), buf())))

    decl.unwrap().kind match
        StructOf(d) -> instantiate_struct(a, decl.unwrap().scope, decl.unwrap().span, d.name, owner,
                                          d, decl.unwrap().scope, targs)
        EnumOf(d) -> instantiate_enum(a, decl.unwrap().scope, decl.unwrap().span, d.name, owner, d,
                                      decl.unwrap().scope, targs)
        // **Inside a trait's own declaration `Self` is a stand-in bounded by the trait**, not the
        // object over it: a member writing `-> Self::Item` is naming the associated type of whatever
        // implements the trait, and only a bound can say what that is. The object is what a *use*
        // makes, and it has to write the binding out.
        TraitOf(_) ->
            var self_bounds: Buf[Bound] = buf()

            self_bounds.push(Bound(owner, targs))
            Abstract("Self", self_bounds)
        _ -> Unknown
end self_type

// -- what a constant may be --------------------------------------------------------------------

// **A constant is a scalar**, so the three declaration forms that are not one are refused here,
// which is a step before anything asks how far the type reaches. A transparent subtype is a scalar
// and is the one form that goes on to be asked that.
private check_const_scalars(a: &Analysis)
    for i in 0..<a.tables.consts.len()
        val v = a.tables.consts.at(i)

        if v.typ.is_some() then
            val t = v.typ.unwrap()

            *t.kind match
                NamedType(name, _) -> check_const_named(a, v, t.span, name)
                _ -> ()

private check_const_named(a: &Analysis, v: ValueDecl, span: Span, written: string)
    val key = lookup_type_key(a, v.scope, written)

    if key.is_none() then return

    val decl = a.tables.types.get(key.unwrap())

    if decl.is_none() then return

    // The two halves of the rule read differently: a struct is **storage**, and is told which
    // keyword holds it, where an enum is simply not a scalar.
    decl.unwrap().kind match
        StructOf(_) ->
            a.fault(v.scope, span,
                    s"a constant is a scalar, and $written is storage — write '${v.name}' as a " +
                    "'val', which is laid into the object file as constant data")
        EnumOf(_) -> a.fault(v.scope, span, s"a constant is a scalar, and $written is not — " +
                             s"'${v.name}'")
        TypeOf(d) ->
            if d.derived then
                a.fault(v.scope, span,
                        s"'${v.name}' is declared $written, which is a 'new' type — reaching one " +
                        "from its base is a written conversion, and a constant is the value it is " +
                        "written as, so there is nowhere here to write it")
            // **A predicate is a function checked where a value is MADE**, and a constant is
            // folded into its uses rather than made anywhere -- so admitting one would be a check
            // the declaration claims and the program never gets. A `within` range is a comparison
            // against a number already in hand, and is settled once the value is folded.
            elif d.pred.is_some() then
                a.fault(v.scope, span,
                        s"'${v.name}' is declared $written, whose 'where' predicate is checked where " +
                        "a value is made — and a constant is folded into its uses rather than made " +
                        "anywhere, so the check has no site. A 'within' range is settled here; a " +
                        "predicate cannot be")
        _ -> ()
end check_const_named

// -- how far a signature may reach ---------------------------------------------------------------

// A declaration may not be more visible than the types it names.
//
// **A file-private declaration owes nothing here**: it reaches one file, and every type it names is
// visible there or the signature would not have resolved. What this finds is a public declaration
// naming something private.
private check_exposed_types(a: &Analysis)
    check_exposed_defaults(a)

    for i in 0..<a.tables.funcs.len()
        val f = a.tables.funcs.at(i)

        check_exposed_signature(a, f.scope, f.decl.name, f.decl.vis, f.decl.params, f.decl.ret_type,
                                f.decl.bounds, f.decl.tparams)

    // **An `extern` is held to the rule all the same**: what the linker resolves is beside the
    // point, since the hole is a module holding a value whose type it cannot write.
    for i in 0..<a.tables.externs.len()
        val key = a.tables.externs.key_at(i)
        val d = a.tables.externs.get(key).unwrap()

        check_exposed_signature(a, scope_of_key(a, key), d.name, d.vis, d.params, d.ret_type, buf(),
                                buf())

    // The declarations that are a **name and one type**. They carry no signature, so the hole is
    // reached by a shorter route than a function's, and it is the same hole. A `const` cannot
    // ordinarily get this far -- a constant is a scalar and every scalar is a builtin nobody may
    // restrict -- but a transparent subtype is one, so it is asked like the other two rather than
    // left to a widening of what a constant may hold to quietly reopen this.
    check_exposed_storage(a, a.tables.consts)
    check_exposed_storage(a, a.tables.vals)
    check_exposed_storage(a, a.tables.extern_vars)

    for i in 0..<a.tables.types.len()
        val decl = a.tables.types.at(i)

        decl.kind match
            StructOf(d) ->
                for j in 0..<d.fields.len()
                    val f = d.fields.at(j)

                    // **A field carries its own reach**, so it is named as one and asked at its
                    // own -- a private field reaches exactly as far as the type it names, and there
                    // is nothing there to find.
                    check_exposed(a, decl.scope, s"${d.name}.${f.name}", member_reach(d.vis, f.vis),
                                  "its type", f.typ, d.tparams)

                check_exposed_members(a, decl.scope, d.name, d.vis, d.members, d.tparams)
            EnumOf(d) ->
                for j in 0..<d.variants.len()
                    val v = d.variants.at(j)

                    for k in 0..<v.fields.len()
                        val f = v.fields.at(k)

                        check_exposed(a, decl.scope, d.name, d.vis,
                                      s"the '${f.name}' of variant '${v.name}'", f.typ, d.tparams)

                check_exposed_members(a, decl.scope, d.name, d.vis, d.members, d.tparams)
            TraitOf(d) ->
                check_exposed_members(a, decl.scope, d.name, d.vis, d.methods, d.tparams)

                // **A required trait is the sharpest case of the rule**: implementing the trait means
                // implementing that one as well, so a requirement the implementer cannot name leaves
                // the trait unimplementable from outside.
                for j in 0..<d.supers.len()
                    val s = d.supers.at(j)

                    check_exposed_name(a, decl.scope, d.name, d.vis, "the trait it requires", s.name,
                                       s.span, d.tparams)
            _ -> ()
end check_exposed_types

// **A type parameter's default is one of the types a declaration names**: it is not written at the
// use, so a caller that leaves the argument out ends up holding a type the default named -- and if
// that type does not reach them, they are holding something they could not have written.
private check_exposed_defaults(a: &Analysis)
    for i in 0..<a.tables.types.len()
        val decl = a.tables.types.at(i)

        decl.kind match
            StructOf(d) -> exposed_defaults(a, decl.scope, d.name, d.vis, d.tparams, d.tdefaults)
            EnumOf(d) -> exposed_defaults(a, decl.scope, d.name, d.vis, d.tparams, d.tdefaults)
            TraitOf(d) -> exposed_defaults(a, decl.scope, d.name, d.vis, d.tparams, d.tdefaults)
            _ -> ()
end check_exposed_defaults

private exposed_defaults(a: &Analysis, scope: Scope, label: string, vis: Visibility,
                         tparams: Buf[string], tdefaults: Buf[TypeBinding])
    for i in 0..<tdefaults.len()
        val b = tdefaults.at(i)

        check_exposed(a, scope, label, vis, s"the default for '${b.name}'", b.typ, tparams)
end exposed_defaults

private is_private_reach(v: Visibility) -> bool = v match
    File -> true
    _ -> false

// **A member carries no modifier of its own**, so it is as visible as the type it belongs to; one
// that says something of its own is held to that instead.
private member_reach(owner: Visibility, own: Visibility) -> Visibility = own match
    Public -> owner
    _ -> own

private check_exposed_storage(a: &Analysis, from: &Table[ValueDecl])
    for i in 0..<from.len()
        val v = from.at(i)

        if !is_private_reach(v.vis) && v.typ.is_some() then
            check_exposed(a, v.scope, v.name, v.vis, "its type", v.typ.unwrap(), buf())

private check_exposed_members(a: &Analysis, scope: Scope, owner: string, owner_vis: Visibility,
                              ms: Buf[MethodDecl], tparams: Buf[string])
    for i in 0..<ms.len()
        val m = ms.at(i)
        var skip: Buf[string] = buf()

        for j in 0..<tparams.len()
            skip.push(tparams.at(j))

        for j in 0..<m.tparams.len()
            skip.push(m.tparams.at(j))

        check_exposed_signature(a, scope, s"$owner.${m.name}", member_reach(owner_vis, m.vis),
                                m.params, m.ret_type, m.bounds, skip)
end check_exposed_members

// **A bound is part of what a caller has to satisfy**, so a trait it cannot name leaves it unable to
// say what the declaration is asking of it -- which makes a bound a name the signature carries.
private check_exposed_signature(a: &Analysis, scope: Scope, label: string, vis: Visibility,
                                params: Buf[Param], ret: Option[TypeRef], bounds: Buf[NamedBounds],
                                skip: Buf[string])
    if is_private_reach(vis) then return

    for i in 0..<params.len()
        val p = params.at(i)

        check_exposed(a, scope, label, vis, s"parameter '${p.name}'", p.typ, skip)

    if ret.is_some() then check_exposed(a, scope, label, vis, "its result", ret.unwrap(), skip)

    for i in 0..<bounds.len()
        val nb = bounds.at(i)
        val what = s"the bound on '${nb.name}'"

        for j in 0..<nb.bounds.len()
            val b = nb.bounds.at(j)

            check_exposed_name(a, scope, label, vis, what, b.name, b.span, skip)

            for k in 0..<b.args.len()
                check_exposed(a, scope, label, vis, what, b.args.at(k), skip)
end check_exposed_signature

private check_exposed(a: &Analysis, scope: Scope, label: string, vis: Visibility, what: string,
                      t: TypeRef, skip: Buf[string])
    var names: Buf[(string, Span)] = buf()

    names_in(&names, t, skip)

    for i in 0..<names.len()
        check_exposed_name(a, scope, label, vis, what, names.at(i).0, names.at(i).1, skip)

private check_exposed_name(a: &Analysis, scope: Scope, label: string, vis: Visibility, what: string,
                           name: string, span: Span, skip: Buf[string])
    // **A file-private declaration owes nothing here**: it reaches one file, and every type it names
    // is visible there or the signature would not have resolved. It is asked at this end rather than
    // at each caller's, since a field and a piece of module storage arrive with no signature.
    if is_private_reach(vis) || holds(skip, name) then return

    val key = lookup_type_key(a, scope, name)

    if key.is_none() then return

    // **A name the declaration cannot reach at all is one mistake, not two** -- it is refused where
    // it is written, and saying a second time that the signature is too visible for it would be a
    // second complaint about the same word.
    if !reachable_key(a, key.unwrap(), scope) then return

    val acc = a.tables.access.get(key.unwrap())

    if acc.is_none() || reaches_as_far(vis, scope.module_name, acc.unwrap()) then return

    a.fault(scope, span,
            s"'$label' is ${reach_phrase(vis)}, but $what names '${qualified_name(key.unwrap())}', " +
            s"which is ${no_further_than(acc.unwrap())} — a declaration may not be more visible " +
            "than the types it names")
end check_exposed_name

// Whether every reader of a declaration at this reach is also a reader of a type at that one. The
// file level is not asked: a file-private declaration is read in one file, and every type it names
// is visible there or the signature would not have resolved.
reaches_as_far(vis: Visibility, in_module: string, acc: Access) -> bool = acc.vis match
    Public -> true
    File -> false
    Scoped(name) ->
        val top = widened_to(acc.module_name, name)

        // A scope naming nothing is refused where it is written, and the declaration it was written
        // on still stands: one mistake is one diagnostic.
        if top.is_none() then return true

        vis match
            Scoped(mine) ->
                val from = widened_to(in_module, mine)

                from.is_none() || beneath(from.unwrap(), top.unwrap())
            _ -> false

private reach_phrase(v: Visibility) -> string = v match
    Public -> "public"
    Scoped(m) -> s"visible throughout module '$m'"
    File -> "private"

// The two levels read differently: the file form names the file, the wider one the module it
// widened to.
private no_further_than(acc: Access) -> string = acc.vis match
    Scoped(name) -> widened_to(acc.module_name, name) match
        None -> private_to_phrase(acc.file)
        Some(m) -> s"private to module '$m'"
    _ -> private_to_phrase(acc.file)

private private_to_phrase(file: string) -> string = s"private to '$file', the file that declares it"

// Every name a written type mentions, skipping the declaration's own parameters.
//
// A value argument names no declaration, and neither does a pack -- so a signature can expose
// nothing through either.
names_in(out: *Buf[(string, Span)], t: TypeRef, skip: Buf[string])
    *t.kind match
        NamedType(name, args) ->
            if !holds(skip, name) then out.push((name, t.span))

            for i in 0..<args.len()
                names_in(out, args.at(i), skip)
        PtrType(inner) -> names_in(out, inner, skip)
        RefType(inner, _) -> names_in(out, inner, skip)
        WeakType(inner) -> names_in(out, inner, skip)
        VolatileType(inner) -> names_in(out, inner, skip)
        ArrayType(_, elem, _) -> names_in(out, elem, skip)
        VectorType(_, elem) -> names_in(out, elem, skip)
        TupleType(parts, _) ->
            for i in 0..<parts.len()
                names_in(out, parts.at(i), skip)
        FnType(params, ret, _) ->
            for i in 0..<params.len()
                names_in(out, params.at(i), skip)

            names_in(out, ret, skip)
        CFnType(params, ret) ->
            for i in 0..<params.len()
                names_in(out, params.at(i), skip)

            names_in(out, ret, skip)
        AssocArgType(_, inner) -> names_in(out, inner, skip)
        _ -> ()

private holds(xs: Buf[string], name: string) -> bool
    for i in 0..<xs.len()
        if xs.at(i) == name then return true

    false
end holds

// -- what a test asks --------------------------------------------------------------------------

// The declaration diagnostics of one source, as text, which is what an error-path test asserts on.
decl_diagnostics(text: string) -> Buf[string]
    val parsed = parse(source_of("test.sysl", text))
    var out: Buf[string] = buf()

    if !parsed.ok() then
        for i in 0..<parsed.report.len()
            out.push(parsed.report.at(i).message)

        return out

    analyze_decls_of(parsed.program, host_target()) match
        Ok(_) -> ()
        Err(ds) ->
            for i in 0..<ds.len()
                out.push(ds.at(i).diag.message)

    out
end decl_diagnostics

// The type a written one means, in the terms of a source that declares whatever it names.
//
// **It is here rather than in the test file because it is the pass's own seam**: hoist, resolve,
// then ask what one more written type comes to. A caller wanting the diagnostics as well as the
// answer gets both, since a resolution that failed still answers with something.
resolve_written(text: string, written: string) -> (Type, Buf[string])
    val parsed = parse(source_of("test.sysl", text))
    val a = analysis_for(host_target())
    var units: Buf[Program] = buf()

    units.push(parsed.program)
    read_decls(a, units)

    val t = parse_type_text("type.sysl", written)
    var messages: Buf[string] = buf()

    if !t.ok() then
        messages.push(t.first().message)

        return (Unknown, messages)

    val answer = resolve_type(a, scope_of_unit(a, parsed.program), t.value, no_bindings())
    val ds = a.diagnostics()

    for i in 0..<ds.len()
        messages.push(ds.at(i).diag.message)

    (answer, messages)
end resolve_written
