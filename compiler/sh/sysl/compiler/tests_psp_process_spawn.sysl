module sh.sysl.compiler
@tests

import sysl.fs.{make_temp_dir, remove_dir_all, write_bytes}
import sysl.process.capture
import sysl.text.{fields, parse_long, Search}

// `sysl.process` starts a child with `posix_spawnp`, not `fork`. A `fork` copies the parent's
// address space, and what that costs grows with how many pages the parent's heap spans: the test
// runner, which has just compiled a large program when it starts one child per test, paid about
// twenty milliseconds a test against the reference's four (slate's 2474 tests, 2026-10-06). These
// build a program against this tree's library and ask it.

private psp_built(src: string) -> Option[(string, string)]
    if std_root().is_err()
        print("skipped: the standard module's source is not on this machine")
        return None

    val root = make_temp_dir("sysl-psp-").unwrap()

    write_bytes(s"$root/main.sysl", src.bytes).unwrap()

    val exe = s"$root/built"

    build_native_program(s"$root/main.sysl", None, None, DefaultOptimization, Some(exe)) match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            assert(false, failure_text(why))
            None
        Ok(_) -> Some((root, exe))
end psp_built

// A program that captures a child forty times from an empty heap and forty times holding six million
// small strings, and prints the cheapest capture of each, in microseconds of its own processor, and
// how many strings it held.
//
// **Processor time, and the cheapest, because what a `fork` costs is the parent's own processor**:
// copying the parent's page tables is work the kernel does in the parent, and it is the whole of what
// a large heap adds. The wall clock adds everything else as well -- the child being scheduled,
// running and being reaped -- which a loaded machine stretches by any amount and which is the same
// whichever way the child was started.
private psp_capturing() -> string = """
import sysl.process.capture
import sysl.posix.time.cpu_time
import sysl.time.whole_micros
import sysl.buf.{Buf, buf}

// The cheapest of `n` captures of a child, in microseconds of this process's processor.
cheapest_capture(n: long) -> long
    var best: long = -1

    for i in 0..<n
        val t0 = cpu_time()
        val o = capture("/usr/bin/true", [], "", [], true)
        val took = whole_micros(cpu_time() - t0)

        if best < 0 || took < best then best = took

    best
end cheapest_capture

val bare = cheapest_capture(40)
var hold: Buf[string] = buf()

for i in 0..<6000000
    hold.push(s"object number $i, padded out a little further")

val held = cheapest_capture(40)

print(s"$bare $held ${hold.len()}")
"""

// The same two measures of a child started by `fork` itself, from the same two heaps: what the
// measure above would see if `sysl.process` went back to it.
private psp_forking() -> string = """
import sysl.posix.time.cpu_time
import sysl.time.whole_micros
import sysl.buf.{Buf, buf}

extern fork() -> i32
extern waitpid(pid: i32, code: *i32, options: i32) -> i32
extern _exit(code: i32)

// The cheapest of `n` children forked, each leaving at once and reaped, in microseconds of this
// process's processor.
cheapest_fork(n: long) -> long
    var best: long = -1

    for i in 0..<n
        val t0 = cpu_time()
        val pid = fork()

        if pid == 0 then _exit(0)

        var code: i32 = 0
        val reaped = waitpid(pid, &code, 0)
        val took = whole_micros(cpu_time() - t0)

        if best < 0 || took < best then best = took

    best
end cheapest_fork

val bare = cheapest_fork(40)
var hold: Buf[string] = buf()

for i in 0..<6000000
    hold.push(s"object number $i, padded out a little further")

val held = cheapest_fork(40)

print(s"$bare $held ${hold.len()}")
"""

// The two cheapest children the program `src` reports, from an empty heap and from a large one.
private psp_costs(src: string) -> Option[(long, long)]
    val built = psp_built(src) match
        None -> return None
        Some(b) -> b

    val said = capture(built.1, [], "", [], true)

    remove_dir_all(built.0).unwrap_or(())

    val out = said match
        Err(_) ->
            assert(false, "the program that was built could not be run")
            return None
        Ok(o) -> o

    assert(out.status.ok(), out.text + out.err.unwrap_or(""))

    val parts = fields(out.text)

    assert(parts.len == 3 && parts[2] == "6000000", out.text)
    Some((parse_long(parts[0].bytes).unwrap_or(0), parse_long(parts[1].bytes).unwrap_or(0)))
end psp_costs

@test("a child is started by posix_spawnp, which copies nothing of the parent")
psp_a_child_is_spawned()
    val built = psp_built(psp_capturing()) match
        None -> return
        Some(b) -> b

    val undefined = capture("nm", ["-u", built.1], "", [], true)

    remove_dir_all(built.0).unwrap_or(())

    undefined match
        Err(_) -> assert(false, "nm could not be run")
        Ok(out) -> assert(out.text.contains("posix_spawnp"), s"no posix_spawnp in:\n${out.text}")
end psp_a_child_is_spawned

// Six million small strings is about a gigabyte of heap in many pages: a `fork` from under it took
// four and a half times as long as one from an empty heap (6.4 ms against 1.4 on the wall), and a
// spawn takes the same either way (about 1 ms).
@test("a parent holding a large heap of small objects starts a child as fast as an empty one")
psp_a_large_heap_costs_a_child_nothing()
    val (bare, held) = psp_costs(psp_capturing()) match
        None -> return
        Some(c) -> c

    assert(bare > 0 && held < 2 * bare, s"bare ${bare}us of processor, holding the heap ${held}us")
end psp_a_large_heap_costs_a_child_nothing

// The measure above can fail: a `fork` from under the same heap costs the parent well over twice what
// it does from an empty one.
@test("a fork from under the same heap costs more than twice as much, so the measure can tell")
psp_a_fork_fails_the_measure()
    val (bare, held) = psp_costs(psp_forking()) match
        None -> return
        Some(c) -> c

    assert(bare > 0 && held >= 2 * bare, s"bare ${bare}us of processor, holding the heap ${held}us")
end psp_a_fork_fails_the_measure
