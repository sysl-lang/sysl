module sh.sysl.compiler
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.container.{Set, set}
import sysl.text.Search
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.{Status, capture}

// A share of something a covering slot already holds, dropped wherever it is given back
// (`arc_cover.sysl`).
//
// The pass on blocks built by hand -- the loop it was written for, before and after, and each thing
// that keeps the pair -- then the emitted text of the shapes it is for, then programs whose
// destructors print, so that a count that went wrong shows up as a drop that ran early or never.

// -- the pass, on blocks built by hand ------------------------------------------------------------------

private scv_call(name: string, v: string) -> Inst
    var args: Buf[IrArg] = buf()

    args.push(ir_arg(LPtr, VReg(v)))
    ir_call(None, LVoid, VGlobal(name), args)
end scv_call

private scv_idx(k: int) -> Buf[int]
    var idx: Buf[int] = buf()

    idx.push(k)
    idx
end scv_idx

private scv_extract(d: string, agg: string, k: int) -> Inst = InExtract(VReg(d), LPtr, VReg(agg), scv_idx(k))

private scv_insert(d: string, agg: Val, v: string, k: int) -> Inst =
    InInsert(VReg(d), LPtr, agg, LPtr, VReg(v), scv_idx(k))

private scv_load(d: string, slot: string) -> Inst = InLoad(VReg(d), LPtr, VReg(slot), AccPlain, None)

private scv_store(v: string, slot: string) -> Inst = InStore(LPtr, VReg(v), VReg(slot), AccPlain, None)

// The pass, with `quiet` the one function counted as releasing nothing.
private scv_pass(blocks: Buf[IrBlock]) -> Buf[IrBlock]
    var inert: Set[string] = set()

    inert.add("quiet")
    elide_arc_pairs(blocks, inert)
end scv_pass

private scv_count(text: string, needle: string) -> int = int(text.count_of(needle))

private scv_block(label: string, instrs: Buf[Inst], term: Inst) -> IrBlock = IrBlock(label, instrs, Some(term))

private scv_text(blocks: Buf[IrBlock]) -> string
    var out = ""

    for b in blocks
        out = s"$out${b.label}:\n"

        for i in b.instrs
            out = s"$out  ${inst_render(i)}\n"

        b.terminator match
            Some(t) -> out = s"$out  ${inst_render(t)}\n"
            None -> ()

    out
end scv_text

// The loop `val here = src[i..<j]; for x in here ...` lowers to, cut down to what the pass reads: the
// parameter's slot, the share taken in the body, the view stored to its own slot, and the release at
// the end of the round, two blocks later. `between` goes in the block the release is in, before it;
// `src_stores` is how many times the parameter's slot is written.
private scv_loop(between: Buf[Inst], src_stores: int) -> Buf[IrBlock]
    var entry: Buf[Inst] = buf()

    entry.push(InAlloca(VReg("src.addr"), LPtr, None))
    entry.push(InAlloca(VReg("here.addr"), LPtr, None))

    for _ in 0..<src_stores
        entry.push(scv_store("src.param", "src.addr"))

    var body: Buf[Inst] = buf()

    body.push(scv_load("t7", "src.addr"))
    body.push(scv_extract("t8", "t7", 0))
    body.push(scv_call("arc.retain_maybe", "t8"))
    body.push(scv_insert("t19", VZero, "t8", 0))
    body.push(scv_store("t19", "here.addr"))

    var walk: Buf[Inst] = buf()

    walk.push(scv_load("t24", "here.addr"))

    var done: Buf[Inst] = buf()

    for inst in between
        done.push(inst)

    done.push(scv_load("t40", "here.addr"))
    done.push(scv_extract("t41", "t40", 0))
    done.push(scv_call("arc.release_maybe", "t41"))

    var blocks: Buf[IrBlock] = buf()

    blocks.push(scv_block("entry", entry, InBr("cond")))
    blocks.push(scv_block("cond", buf(), InCondBr(VReg("go"), "body", "end")))
    blocks.push(scv_block("body", body, InBr("each")))
    blocks.push(scv_block("each", walk, InCondBr(VReg("more"), "each", "done")))
    blocks.push(scv_block("done", done, InBr("cond")))
    blocks.push(scv_block("end", buf(), InRet(None, None)))
    blocks
end scv_loop

@test("a sub-slice of a parameter taken in a loop gives up its count, before and after")
scv_loop_before_and_after()
    val before = scv_loop(buf(), 1)

    assert_eq(scv_text(before), raw"""
        entry:
          %src.addr = alloca ptr
          %here.addr = alloca ptr
          store ptr %src.param, ptr %src.addr
          br label %cond
        cond:
          br i1 %go, label %body, label %end
        body:
          %t7 = load ptr, ptr %src.addr
          %t8 = extractvalue ptr %t7, 0
          call void @arc.retain_maybe(ptr %t8)
          %t19 = insertvalue ptr zeroinitializer, ptr %t8, 0
          store ptr %t19, ptr %here.addr
          br label %each
        each:
          %t24 = load ptr, ptr %here.addr
          br i1 %more, label %each, label %done
        done:
          %t40 = load ptr, ptr %here.addr
          %t41 = extractvalue ptr %t40, 0
          call void @arc.release_maybe(ptr %t41)
          br label %cond
        end:
          ret void
        """)

    val after = scv_text(scv_pass(before))

    assert_eq(after.contains("@arc.retain_maybe"), false, after)
    assert_eq(after.contains("@arc.release_maybe"), false, after)
    assert(after.contains("store ptr %t19, ptr %here.addr"), after)

@test("a release of the parent itself inside the window keeps the pair")
scv_parent_released_inside()
    var between: Buf[Inst] = buf()

    between.push(scv_load("p1", "src.addr"))
    between.push(scv_extract("p2", "p1", 0))
    between.push(scv_call("arc.release_maybe", "p2"))

    val after = scv_text(scv_pass(scv_loop(between, 1)))

    assert_eq(scv_count(after, "@arc.retain_maybe"), 1, after)
    assert_eq(scv_count(after, "@arc.release_maybe"), 2, after)

@test("a parent slot written more than once covers nothing")
scv_parent_written_twice()
    val after = scv_text(scv_pass(scv_loop(buf(), 2)))

    assert_eq(scv_count(after, "@arc.retain_maybe"), 1, after)
    assert_eq(scv_count(after, "@arc.release_maybe"), 1, after)

@test("a store to the parent inside the window keeps the pair")
scv_parent_stored_inside()
    var between: Buf[Inst] = buf()

    // The parent's one store, with a count taken for it, made before the view is given back.
    between.push(scv_call("arc.retain_maybe", "fresh"))
    between.push(scv_store("fresh", "src.addr"))

    val after = scv_text(scv_pass(scv_loop(between, 0)))

    assert_eq(scv_count(after, "@arc.retain_maybe"), 2, after)
    assert_eq(scv_count(after, "@arc.release_maybe"), 1, after)

private scv_with(inst: Inst) -> string
    var between: Buf[Inst] = buf()

    between.push(inst)
    scv_text(scv_pass(scv_loop(between, 1)))
end scv_with

@test("a call to a function that releases nothing, a field read or another retain may sit inside")
scv_blind_inside()
    var none: Buf[IrArg] = buf()
    var at: Buf[IrArg] = buf()
    var read: Buf[Inst] = buf()

    at.push(ir_arg(l_i32(), VReg("k")))
    read.push(InGep(VReg("f"), LInt(8), VReg("t8"), at))
    read.push(InLoad(VReg("g"), LInt(8), VReg("f"), AccPlain, None))

    val field = scv_text(scv_pass(scv_loop(read, 1)))

    for after in [scv_with(ir_call(None, LVoid, VGlobal("quiet"), none)), scv_with(scv_call("arc.retain", "other")), field]
        assert_eq(after.contains("@arc.retain_maybe"), false, after)
        assert_eq(after.contains("@arc.release_maybe"), false, after)

@test("any other call, any other release, or a load straight through a pointer keeps the pair")
scv_count_could_be_read()
    var none: Buf[IrArg] = buf()

    // `slot_vacate` reads the strong count with a load through the owner itself.
    for after in [scv_with(ir_call(None, LVoid, VGlobal("anything"), none)),
                  scv_with(scv_call("arc.release", "elsewhere")),
                  scv_with(InLoad(VReg("n"), LInt(64), VReg("t8"), AccPlain, None)),
                  scv_with(InFence(OrdSeqCst))]
        assert_eq(scv_count(after, "@arc.retain_maybe"), 1, after)
        assert_eq(scv_count(after, "@arc.release_maybe"), 1, after)

@test("a path that returns before the release keeps the pair")
scv_path_returns_first()
    val blocks = scv_loop(buf(), 1)

    blocks[3] = IrBlock("each", blocks[3].instrs, Some(InCondBr(VReg("more"), "end", "done")))

    val after = scv_text(scv_pass(blocks))

    assert_eq(scv_count(after, "@arc.retain_maybe"), 1, after)

@test("a path that takes the share again before giving it back keeps the pair")
scv_path_loops_to_the_retain()
    val blocks = scv_loop(buf(), 1)

    blocks[3] = IrBlock("each", blocks[3].instrs, Some(InCondBr(VReg("more"), "body", "done")))

    val after = scv_text(scv_pass(blocks))

    assert_eq(scv_count(after, "@arc.retain_maybe"), 1, after)

@test("a share of a slot that holds no count of its own is kept")
scv_uncounted_parent()
    val blocks = scv_loop(buf(), 0)
    var entry: Buf[Inst] = buf()

    for inst in blocks[0].instrs
        entry.push(inst)

    // Written once, but with a value nothing took a count for.
    entry.push(scv_store("borrowed", "src.addr"))
    blocks[0] = IrBlock("entry", entry, blocks[0].terminator)

    val after = scv_text(scv_pass(blocks))

    assert_eq(scv_count(after, "@arc.retain_maybe"), 1, after)

@test("a view stored outside the frame keeps its count")
scv_view_escapes()
    val blocks = scv_loop(buf(), 1)
    var body: Buf[Inst] = buf()

    for inst in blocks[2].instrs
        body.push(inst)

    body.push(scv_store("t19", "heap"))
    blocks[2] = IrBlock("body", body, blocks[2].terminator)

    val after = scv_text(scv_pass(blocks))

    assert_eq(scv_count(after, "@arc.retain_maybe"), 1, after)

// -- the emitted text -------------------------------------------------------------------------------------

private scv_source() -> string = raw"""
    sums(src: []const u8, most: usize) -> u32
        var t: u32 = 0
        var i: usize = 0

        while i + most <= src.len
            val here = src[i..<i + most]

            for x in here
                t += u32(x)

            i += most

        t

    adler(data: []const u8) -> u32
        var a: u32 = 1
        var at: usize = 0

        while at < data.len
            val end = if data.len - at > 5 then at + 5 else data.len

            for x in data[at..<end]
                a += u32(x)

            at = end

        a

    count(s: []const u8) -> usize = s.len

    struct Holder
        src: []const u8

    impl Holder
        total(self) -> usize
            val src = self.src
            var n: usize = 0
            var i: usize = 0

            while i < src.len
                n += count(src[i..<i + 1])
                i += 1

            n

    struct Tag
        id: int

    struct Shelf
        tag: &Tag

    sum_ids(s: Shelf, rounds: int) -> int
        var n = 0

        for k in 0..<rounds
            val t = s.tag
            n += t.id

        n

    moving(src: []const u8, other: []const u8) -> usize
        var from = src
        var n: usize = 0

        while n < 3
            val here = from[0..<1]

            for x in here
                n += usize(x)

            from = other
            n += 1

        n
    """

@test("a view of a parameter taken every round, walked or passed to a call, takes no count")
scv_emitted_loops()
    for name in ["sums", "adler", "Holder.total", "sum_ids"]
        val ir = emit_func_text(scv_source(), name)

        assert(ir.starts_with("define"), ir)
        assert_eq(ir.contains("@arc.retain"), false, ir)
        assert_eq(ir.contains("@arc.release"), false, ir)

@test("a view of a var assigned in the loop keeps its count")
scv_emitted_var_parent()
    val ir = emit_func_text(scv_source(), "moving")

    assert(ir.starts_with("define"), ir)
    assert(ir.contains("@arc.retain_maybe"), ir)

// A root function is laid down as `name$$sysl`, so the call the elision reads names that symbol while
// the functions known to release nothing are found by key: the two have to be matched up, for a
// method's window and a root function's alike, and a callee that calls out to C still keeps the count.
private scv_root_callees() -> string = raw"""
    extern note(n: usize)

    count(s: []const u8) -> usize = s.len

    noted(s: []const u8) -> usize
        note(s.len)
        s.len

    struct Holder
        src: []const u8

    impl Holder
        total(self) -> usize
            val src = self.src
            var n: usize = 0
            var i: usize = 0

            while i < src.len
                n += count(src[i..<i + 1])
                i += 1

            n

    total_of(h: Holder) -> usize
        val src = h.src
        var n: usize = 0
        var i: usize = 0

        while i < src.len
            n += count(src[i..<i + 1])
            i += 1

        n

    noted_of(h: Holder) -> usize
        val src = h.src
        var n: usize = 0
        var i: usize = 0

        while i < src.len
            n += noted(src[i..<i + 1])
            i += 1

        n
    """

@test("a call to a root function that releases nothing sits in a covered window under its laid-down symbol")
scv_root_callee_symbol()
    for name in ["Holder.total", "total_of"]
        val ir = emit_func_text(scv_root_callees(), name)

        assert(ir.starts_with("define"), ir)
        assert(mentions_as_written(ir, "count"), ir)
        assert_eq(ir.contains("@arc.retain"), false, ir)

    val kept = emit_func_text(scv_root_callees(), "noted_of")

    assert(kept.starts_with("define"), kept)
    assert(kept.contains("@arc.retain_maybe"), kept)

// -- programs whose destructors say when they ran --------------------------------------------------------

private scv_ran(text: string) -> string
    if !clang_available() then return "skipped"

    val root = make_temp_dir("sysl-scv").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", text).unwrap()

    val exe = s"$root/built"

    build_native_program(s"$root/main.sysl", None, None, DefaultOptimization, Some(exe)) match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return failure_text(why)
        Ok(_) -> ()

    val said = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    said match
        Err(_) -> "the program that was built could not be run"
        Ok(o) -> o.status match
            Status.Exited(code) -> if code == 0 then o.text else s"exited $code: ${o.text}"
            _ -> s"did not exit: ${o.text}"
end scv_ran

@test("a destructor runs where it did when every count was taken, parent held or replaced")
scv_drops_where_they_did()
    val got = scv_ran(raw"""
        struct Tag
            id: int

        impl Drop for Tag
            drop(self) = print("drop", self.id)

        struct Shelf
            tag: &Tag

        label(s: Shelf, rounds: int)
            for k in 0..<rounds
                val t = s.tag
                print("round", k, t.id)

        swap(rounds: int)
            var cur: &Tag = Tag(1)

            for k in 0..<rounds
                val t = cur
                cur = Tag(10 + k)
                print("held", t.id)

            print("last", cur.id)

        sum_ids(s: Shelf, rounds: int) -> int
            var n = 0

            for k in 0..<rounds
                val t = s.tag
                n += t.id

            n

        label(Shelf(Tag(7)), 2)
        print(sum_ids(Shelf(Tag(5)), 3))
        print("next")
        swap(2)
        print("done")
        """)

    if got == "skipped" then return

    assert_eq(got, "round 0 7\nround 1 7\ndrop 7\n15\ndrop 5\nnext\nheld 1\ndrop 1\nheld 10\ndrop 10\nlast 11\ndrop 11\ndone\n")
