module sh.sysl.compiler
@tests

// A fan-out -- one thread per element of a collection -- is started on a scope (`reference/memory.md
// § A thread borrows a frame only inside a scope`): every thread started on it is joined before
// `scope` returns, so the threads may share a pointer to the caller's frame however the handles are
// kept and whether or not a loop joins them. Each cell below was once a shape the fan-out matching
// accepted or refused; on a scope each one runs and prints what the threads did, and the plain
// `spawn` it used to be is refused at the argument.
//
// Skipped cells, and why: a two-dimensional `grid[r][c]` of handles is any collection to a scope, so
// it adds nothing to the cells below; a closure or a trait object that starts threads on a scope it
// is handed is `tests_jnd_*`'s wrapper cell.

// The threads of one fan-out run at once and all count into the same `S`, so the count is an atomic
// add: a plain `s.n = s.n + 1` loses an update whenever two threads read before either writes, and
// the cell then prints one short (`fnr_buf_counts_every_turn`).
private fno_prelude() -> string =
    "import sysl.threads.*\nimport sysl.buf.*\nimport sysl.sync.*\n\nstruct S\n    n: int\n\n" +
    "work(s: *S)\n    atomic_add(&s.n, 1, SeqCst)\n\n"

private fno_prints(body: string, want: string)
    if !azd_ready() then return

    twp_prints(fno_prelude() + body, want)

// Refused at the argument `at` (`line:col` of `main.sysl`): a plain `spawn` of the local's address.
private fno_refused(body: string, owner: string, at: string)
    if !azd_ready() then return

    val said = azd_err(fno_prelude() + body)

    assert(said.contains(jnd_spawn_refusal("spawn", "arg", "s", owner)), said)
    assert(said.contains(s"main.sysl:$at"), said)
end fno_refused

// Four threads started into `pool` on a scope, then `joins` -- a loop written as the old refused cells
// wrote it, indented for the scope's body -- and the count printed once the scope has joined them all.
private fno_scoped(ret: string, joins: string, last: string) -> string =
    s"go()$ret\n    var s = S(0)\n    val p = &s\n\n    val r = scope((sc) ->\n" +
    "        var pool: [4]Option[ScopedThread[unit]] = [None; 4]\n\n        for i in 0..<4\n" +
    "            pool[i] = Some(sc.spawn(() -> work(p)))\n\n" + joins + s"        $last)\n\n    print(s.n)\n    r\n\ngo()\n"

// The plain `spawn` the cells below were written with: its `&s` is at 16:32.
private fno_filled(owner: string, ret: string) -> string =
    s"$owner()$ret\n    var s = S(0)\n    var pool: [4]Option[Thread] = [None; 4]\n\n    for i in 0..<4\n" +
    "        pool[i] = spawn(&work, &s)\n\n"

// -- joined by a loop over every element ----------------------------------------------------------

@test("raytrace's pool: a slice of handles filled by a counting loop and joined by a walk with a 'None' arm", ignore: "a ScopedThread stored into a heap slice is taken to hold its closure past the scope")
fno_raytrace_shape()
    fno_prints(raw"""
        render(threads: int) -> int
            var s = S(0)
            val p = &s

            if threads <= 1
                work(p)
                return s.n

            scope((sc) ->
                var pool: []Option[ScopedThread[unit]] = [None; threads]

                for i in 0..<threads
                    pool[i] = Some(sc.spawn(() -> work(p)))

                for t in pool
                    t match
                        Some(th) -> th.join()
                        None -> ())

            work(p)
            s.n

        print(render(4))
        print(render(1))
        """, "5\n1\n")
    fno_refused(fno_filled("go", "") + "    for t in pool\n        if t is Some(h) then h.join()\n\ngo()\n", "go", "16:32")

@test("an array filled and joined by counting loops over its length")
fno_counted_by_length()
    fno_prints(raw"""
        go()
            var s = S(0)
            val p = &s

            scope((sc) ->
                var pool: [3]Option[ScopedThread[unit]] = [None; 3]

                for i in 0..<pool.len
                    pool[i] = Some(sc.spawn(() -> work(p)))

                for i in 0..<pool.len
                    pool[i].unwrap().join())

            print(s.n)

        go()
        """, "3\n")

@test("a joining loop over the same range as the storing loop, the bound a parameter", ignore: "a ScopedThread stored into a heap slice is taken to hold its closure past the scope")
fno_same_bound()
    fno_prints(raw"""
        go(n: int)
            var s = S(0)
            val p = &s

            scope((sc) ->
                var pool: []Option[ScopedThread[unit]] = [None; n]

                for i in 0..<n
                    pool[i] = Some(sc.spawn(() -> work(p)))

                for i in 0..<n
                    pool[i] match
                        Some(h) -> h.join()
                        None -> ())

            print(s.n)

        go(3)
        go(0)
        """, "3\n0\n")

@test("handles pushed into a Buf, in a loop and once more, joined by index, by a walk, or by the scope alone")
fno_buf_pushed()
    fno_prints(raw"""
        by_index()
            var s = S(0)
            val p = &s

            scope((sc) ->
                var b: Buf[ScopedThread[unit]] = buf()

                for _ in 0..<3
                    b.push(sc.spawn(() -> work(p)))

                b.push(sc.spawn(() -> work(p)))

                for i in 0..<b.len()
                    b[i].join())

            print(s.n)

        walked()
            var s = S(0)
            val p = &s

            scope((sc) ->
                var b: Buf[ScopedThread[unit]] = buf()

                for _ in 0..<2
                    b.push(sc.spawn(() -> work(p)))

                for h in b
                    h.join())

            print(s.n)

        unjoined()
            var s = S(0)
            val p = &s

            scope((sc) ->
                var b: Buf[ScopedThread[unit]] = buf()

                for _ in 0..<3
                    b.push(sc.spawn(() -> work(p)))

                b.len())

            print(s.n)

        by_index()
        walked()
        unjoined()
        """, "4\n2\n3\n")

@test("only some elements given a thread, the rest 'None', joined through an 'is' test")
fno_some_elements()
    fno_prints(raw"""
        evens()
            var s = S(0)
            val p = &s

            scope((sc) ->
                var pool: [4]Option[ScopedThread[unit]] = [None; 4]

                for i in 0..<4
                    if i % 2 == 0 then pool[i] = Some(sc.spawn(() -> work(p)))

                for t in pool
                    if t is Some(h) then h.join())

            print(s.n)

        chosen()
            var s = S(0)
            val p = &s

            scope((sc) ->
                var pool: [4]Option[ScopedThread[unit]] = [None; 4]

                for i in 0..<4
                    pool[i] = if i == 1 then None else Some(sc.spawn(() -> work(p)))

                for t in pool
                    if t is Some(h) then h.join())

            print(s.n)

        evens()
        chosen()
        """, "2\n3\n")

@test("a fan-out in an element's field, beside a field that is no handle")
fno_handle_in_a_field()
    fno_prints(raw"""
        struct W
            t: Option[ScopedThread[unit]]
            k: int

        go()
            var s = S(0)
            val p = &s

            val k = scope((sc) ->
                var ws: [3]W = [W(None, 0); 3]

                for i in 0..<3
                    ws[i].t = Some(sc.spawn(() -> work(p)))
                    ws[i].k = i

                for w in ws
                    w.t match
                        Some(h) -> h.join()
                        None -> ()

                ws[2].k)

            print(s.n + k)

        go()
        """, "5\n")

@test("nested fan-outs: one scope per turn of an outer loop, a scope inside a scoped thread, and two in one loop")
fno_nested()
    fno_prints(raw"""
        rounds()
            var s = S(0)
            val p = &s

            for _ in 0..<3
                scope((sc) ->
                    for _ in 0..<2
                        sc.spawn(() -> work(p)))

            print(s.n)

        groups()
            var s = S(0)
            val p = &s

            scope((outer) ->
                for _ in 0..<2
                    outer.spawn(() -> scope((inner) ->
                        for _ in 0..<2
                            inner.spawn(() -> work(p)))))

            print(s.n)

        pairs()
            var s = S(0)
            val p = &s

            scope((sc) ->
                var a: [2]Option[ScopedThread[unit]] = [None; 2]
                var b: [2]Option[ScopedThread[unit]] = [None; 2]

                for i in 0..<2
                    a[i] = Some(sc.spawn(() -> work(p)))
                    b[i] = Some(sc.spawn(() -> work(p)))

                for i in 0..<2
                    a[i].unwrap().join()
                    b[i].unwrap().join())

            print(s.n)

        rounds()
        groups()
        pairs()
        """, "6\n4\n4\n")

@test("a function handed the scope starts its fan-out on it, and its caller's scope joins every element")
fno_answered()
    fno_prints(raw"""
        start_all(sc: *Scope, p: *S) -> [2]Option[ScopedThread[unit]]
            var pool: [2]Option[ScopedThread[unit]] = [None; 2]

            for i in 0..<2
                pool[i] = Some(sc.spawn(() -> work(p)))

            pool

        go()
            var s = S(0)
            val p = &s

            scope((sc) ->
                val pool = start_all(sc, p)

                for t in pool
                    if t is Some(h) then h.join())

            print(s.n)

        go()
        """, "2\n")

@test("a wrapper that answers one handle, stored into each element")
fno_through_a_wrapper()
    fno_prints(raw"""
        start(sc: *Scope, p: *S) -> Option[ScopedThread[unit]] = Some(sc.spawn(() -> work(p)))

        go()
            var s = S(0)
            val p = &s

            scope((sc) ->
                var pool: [3]Option[ScopedThread[unit]] = [None; 3]

                for i in 0..<3
                    pool[i] = start(sc, p)

                for t in pool
                    if t is Some(h) then h.join())

            print(s.n)

        go()
        """, "3\n")

// -- a loop that may skip an element: the scope joins what it skipped ------------------------------
//
// Each of these was refused while the analysis matched a fan-out to the loop that joined it. On a
// scope the loop is the program's own business: whatever it leaves unjoined the scope joins, so every
// cell prints all four.

@test("a 'break' in the joining loop")
fno_break()
    fno_prints(fno_scoped("", "        for t in pool\n            if t.is_some() then break\n\n            t.unwrap().join()\n\n", "()"),
               "4\n")
    fno_refused(fno_filled("go", "") + "    for t in pool\n        if t.is_none() then break\n\n" +
                "        t.unwrap().join()\n\ngo()\n", "go", "16:32")

@test("a 'continue' before the join")
fno_continue()
    fno_prints(fno_scoped("", "        for i in 0..<4\n            if i == 0 then continue\n\n            pool[i].unwrap().join()\n\n", "()"),
               "4\n")

@test("a '?' in the joining loop", ignore: "a closure whose answer is inferred cannot use '?'")
fno_question()
    fno_prints(fno_scoped(" -> Option[int]", "        for t in pool\n            t?.join()\n\n", "Some(1)"), "4\n")

@test("a 'return' or a panic inside the joining loop")
fno_return_or_panic()
    fno_prints(fno_scoped("", "        for t in pool\n            if t.is_some() then return\n\n            t.unwrap().join()\n\n", "()"),
               "4\n")
    fno_prints(fno_scoped("", "        for t in pool\n            if t.is_none() then panic(\"none\")\n\n            t.unwrap().join()\n\n", "()"),
               "4\n")

@test("a join under a condition, a guarded arm, and a 'Some' arm that does not join")
fno_conditional_join()
    fno_prints(fno_scoped("", "        for i in 0..<4\n            if i > 0 then pool[i].unwrap().join()\n\n", "()"), "4\n")
    fno_prints(fno_scoped("", "        for t in pool\n            t match\n                Some(h) if p.n > 9 -> h.join()\n" +
                          "                _ -> ()\n\n", "()"), "4\n")
    fno_prints(fno_scoped("", "        for t in pool\n            t match\n                Some(_) -> ()\n" +
                          "                None -> ()\n\n", "()"), "4\n")

@test("a joining loop over a narrower range")
fno_narrower_range()
    fno_prints(fno_scoped("", "        for i in 0..<3\n            pool[i].unwrap().join()\n\n", "()"), "4\n")
    fno_prints(fno_scoped("", "        for i in 1..<4\n            pool[i].unwrap().join()\n\n", "()"), "4\n")

@test("no loop joins the elements, or one joins a different collection")
fno_no_joining_loop()
    fno_prints(fno_scoped("", "", "()"), "4\n")
    fno_prints(fno_scoped("", "        var spare: [4]Option[ScopedThread[unit]] = [None; 4]\n\n        for t in spare\n" +
                          "            if t is Some(h) then h.join()\n\n", "()"), "4\n")
    fno_refused(fno_filled("go", "") + "    print(s.n)\n\ngo()\n", "go", "16:32")

@test("a handle stored at an index other than its loop's counter")
fno_computed_index()
    fno_prints(raw"""
        go()
            var s = S(0)
            val p = &s

            scope((sc) ->
                var pool: [5]Option[ScopedThread[unit]] = [None; 5]

                for i in 0..<4
                    pool[i + 1] = Some(sc.spawn(() -> work(p)))

                for t in pool
                    if t is Some(h) then h.join())

            print(s.n)

        go()
        """, "4\n")
    fno_prints(raw"""
        go()
            var s = S(0)
            val p = &s

            scope((sc) ->
                var pool: [2]Option[ScopedThread[unit]] = [None; 2]

                for i in 0..<2
                    for _ in 0..<2
                        pool[i] = Some(sc.spawn(() -> work(p)))

                for t in pool
                    if t is Some(h) then h.join())

            print(s.n)

        go()
        """, "4\n")

@test("the collection stored into again, by a second round or as a whole, before its handles are joined")
fno_stored_again()
    fno_prints(fno_scoped("", "        for i in 0..<4\n            pool[i] = Some(sc.spawn(() -> work(p)))\n\n" +
                          "        for t in pool\n            if t is Some(h) then h.join()\n\n", "()"), "8\n")
    fno_prints(fno_scoped("", "        pool = [None; 4]\n\n        for t in pool\n            if t is Some(h) then h.join()\n\n", "()"),
               "4\n")

@test("handles thrown away in a loop, and a pushed handle set over by index", ignore: "a ScopedThread set into a Buf by index_set is taken to hold its closure past the scope")
fno_discarded_and_set_over()
    fno_prints(raw"""
        go()
            var s = S(0)
            val p = &s

            scope((sc) ->
                for _ in 0..<2
                    sc.spawn(() -> work(p)))

            print(s.n)

        go()
        """, "2\n")
    fno_prints(raw"""
        go()
            var s = S(0)
            val p = &s

            scope((sc) ->
                var b: Buf[ScopedThread[unit]] = buf()

                b.push(sc.spawn(() -> work(p)))
                b.index_set(0, sc.spawn(() -> work(p)))

                for h in b
                    h.join())

            print(s.n)

        go()
        """, "2\n")
    fno_refused("go()\n    var s = S(0)\n\n    for _ in 0..<2\n        spawn(&work, &s)\n\ngo()\n", "go", "15:22")

@test("a function answering a fan-out of its own local is refused; one opening its own scope is not")
fno_answered_refused()
    fno_refused(raw"""
        start_all() -> [2]Option[Thread]
            var s = S(0)
            var pool: [2]Option[Thread] = [None; 2]

            for i in 0..<2
                pool[i] = spawn(&work, &s)

            pool

        start_all()
        """, "start_all", "16:32")
    fno_prints(raw"""
        count_all() -> int
            var s = S(0)
            val p = &s

            scope((sc) ->
                for _ in 0..<2
                    sc.spawn(() -> work(p)))

            s.n

        print(count_all())
        """, "2\n")

    if !azd_ready() then return

    val said = azd_err(fno_prelude() + raw"""
        start_all(p: *S) -> [2]Option[Thread]
            var pool: [2]Option[Thread] = [None; 2]

            for i in 0..<2
                pool[i] = spawn(&work, p)

            pool

        go()
            var s = S(0)
            val pool = start_all(&s)

            for t in pool
                t.unwrap().join()

        go()
        """)

    assert(said.contains("error: 'start_all' keeps its parameter 'p' (it is passed to 'spawn', which keeps it), and " +
                         "'&s' is the address of a local of 'go'"), said)
end fno_answered_refused

// -- the threads of a fan-out count into one S at once ---------------------------------------------
//
// Every accepted cell above runs its threads together into one `S`. These run enough turns, with a
// yield between them, that a count which is not indivisible loses updates on every run rather than
// once in a few hundred, so the prelude's `work` is pinned as atomic.

@test("four threads pushed into a Buf and joined by a walk count every turn of every thread")
fnr_buf_counts_every_turn()
    fno_prints(raw"""
        many(s: *S)
            for _ in 0..<20000
                work(s)
                yield_now()

        go()
            var s = S(0)
            val p = &s

            scope((sc) ->
                var b: Buf[ScopedThread[unit]] = buf()

                for _ in 0..<4
                    b.push(sc.spawn(() -> many(p)))

                for h in b
                    h.join())

            print(s.n)

        go()
        """, "80000\n")

@test("four threads kept at a counting loop's counter and joined by the scope count every turn")
fnr_array_counts_every_turn()
    fno_prints(raw"""
        many(s: *S)
            for _ in 0..<20000
                work(s)
                yield_now()

        go()
            var s = S(0)
            val p = &s

            scope((sc) ->
                var pool: [4]Option[ScopedThread[unit]] = [None; 4]

                for i in 0..<pool.len
                    pool[i] = Some(sc.spawn(() -> many(p)))

                pool.len)

            print(s.n)

        go()
        """, "80000\n")
