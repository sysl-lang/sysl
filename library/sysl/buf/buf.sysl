module sysl.buf

import sysl.{index_past, insert_past}
import sysl.raw.ptr_cast

/** The growable sequence and the sink built on it.
 *
 * A module of its own because nothing in the language reaches either: an array literal makes a `[]T`
 * and a `for` walks whatever implements `Iterate`, so a program that wants a sequence that grows is
 * asking for one, and asks with an `import`. What renders into a buffer without a program naming a
 * sink is `x.to_string()`, and that goes through storage the compiler lays out rather than through
 * `ByteSink` -- which is why the sink can sit here beside the buffer it wraps.
 */

/** A sequence that grows, held as a value.
 *
 * **A `Buffer` is a value, the way an array is.** Assigning one, passing it, capturing it in a closure,
 * keeping it in a struct and reading it back out of another container all hand over a copy: a push
 * through one name is never seen through another. `Buffer[Buffer[int]]` included -- `outer[0].push(x)`
 * grows the inner buffer where it lives in `outer`, and a copy of `outer` taken before is unchanged.
 * A member that changes the buffer takes `*self`, so it is called on a `var`, a field reached through
 * one, or a `*Buffer` a function was handed; a function that pushes into a buffer its caller sees
 * takes a `*Buffer`.
 *
 * **What a buffer is, is its storage and its count, side by side in the value.** The storage is a
 * `[]T` of slot storage, allocated apart from the value and doubled when it is full; its length is the
 * capacity. The count is how many of its slots are this buffer's elements. Four words, with nothing
 * between the value and the elements: a loop of pushes into a local keeps both in registers.
 *
 * **A copy costs nothing until one side writes** (copy-on-write). Copying a buffer copies the view,
 * which takes a share of the storage, so the copies share it. A member that writes asks first whether
 * this buffer's share is the only one (`is_unique`, a load and a compare of the storage's own count):
 * where it is, the write is made in place; where it is not, the elements are copied into storage of
 * this buffer's own -- once, the first write after the copy -- and the write is made there. A view
 * taken with `view()` holds a share too, so a buffer written while a view of it is held writes a copy
 * and leaves the view reading what it read.
 *
 * **Giving elements up never copies.** `pop`, `truncate` and `clear` of a buffer whose storage is
 * shared move only this buffer's count: the other holders still read those slots, so nothing is let
 * go of under them. Once this buffer is the storage's only holder again, the next write past its
 * count takes the slot over, letting go of what was left there.
 *
 * **The empty buffer is the all-zero one, and owns nothing.** `var b: Buffer[int]` with nothing
 * after it is empty (`@zero_is_empty`), as is `buffer()`, as is a buffer in storage the program zeroed
 * itself (a `calloc`ed block, a collector's arena): its storage is the empty view, and the first write
 * gives it some. Nothing is allocated until then.
 *
 * **The spare capacity holds nothing.** The storage comes from `slot_storage`, whose slots start out
 * empty: the storage releases only its *live prefix*, and `slot_place` is what fills the first slot
 * past it. So a push of a counted value takes exactly one count for the buffer, and a slot this
 * buffer has given up -- by `pop`, `truncate`, `clear` or `remove` -- is let go of by `slot_vacate`
 * there and then where nothing else holds the storage, which is when a destructor behind it runs.
 *
 * **The count never passes the storage, and the type says so.** The clause is checked wherever
 * either field is written, which in this module is at a handful of places the storage has just made
 * room at -- and in return every member is told it on entry. That is what makes `b[i]` one compare:
 * the index is tested against the count for the trap, and the slice's own test against its length
 * is then implied by it and folds.
 *
 * The bounds-checked members trap rather than returning an `Option`, as an array's subscript does --
 * an index past the end is a mistake in the program, not a value it meant to handle -- while `pop`
 * returns one, because taking from an empty sequence is a question a caller asks on purpose. The
 * report is an array's (`index 5 out of bounds for length 3`, through `sysl_bounds_fail`), without
 * the caller's line.
 */
@zero_is_empty
struct Buf[T]
    private[buf] slots: []T
    private[buf] used: usize
    invariant used <= slots.len

    /** The storage, spare capacity included -- for a reader that wants the address of an element,
     * as `&b.elems[i]` is. It is read-only: the storage is replaced only by the buffer's own growth,
     * which is what keeps the count from passing it.
     */
    elems -> []T = self.slots

    /** How many elements there are -- `len()` under the name the field had. Read-only: the count is
     * the buffer's to move.
     */
    count -> usize = self.used

    const len(self) -> usize = self.used

    const cap(self) -> usize = self.slots.len

    const is_empty(self) -> bool = self.used == 0

    /** The element at `i`, or `None` where there is none -- `i` at or past the length, or negative.
     * The total form of `b[i]`, which traps; `i` may be any integer type.
     */
    const get[I: Integer](self, i: I) -> Option[T]
        if i < 0 || u128(i) >= u128(self.used) then return None

        Some(self.get_unchecked(usize(i)))

    /** `b[i]` and `b[i] = v` with no bounds check: the element at `i`, read or written where it lives, with
     * nothing comparing `i` to the count. **The caller owes the proof that `i < len()`**, and an index
     * past it reads or writes whatever the storage holds there, or memory that is not the buffer's at
     * all. This is the unchecked tier, and the name is how a reader finds it -- the same access an
     * `@unchecked` block gives `b[i]` (`reference/arrays.md § Unchecked access`).
     */
    const get_unchecked(self, i: usize) -> T
        @unchecked
            self.slots[i]

    const set_unchecked(*self, i: usize, v: T)
        self.unique()

        @unchecked
            self.slots[i] = v
    end set_unchecked

    /** The storage made this buffer's own before a write: where its share is the only one it is left
     * as it stands, and otherwise -- a copy or a view shares it, or there is none yet -- `own` gives
     * this buffer storage of its own. The test is a load and two compares, and the copy behind it is
     * out of line, so a push into a buffer nobody else holds is still a store.
     */
    @inline
    private[buf] unique(*self) = if !is_unique(self.slots) then self.own()

    /** Storage of this buffer's own: the elements copied into storage with the capacity the shared
     * storage had, and this buffer's share of that storage let go of. A buffer with no storage keeps
     * none -- the write that asked makes it room.
     */
    @noinline
    @cold
    private own(*self)
        if self.slots.len == 0
            self.slots = []
            return
        end if

        self.slots = self.copied(self.used)
    end own

    /** Storage of the shared storage's capacity holding its first `n` slots -- the copy behind `own`,
     * under a name of its own so that a profile tells a copy from a growth.
     */
    @noinline
    private copied(self, n: usize) -> []T
        var storage: []T = slot_storage(self.slots.len)

        for i in 0..<n
            slot_place(storage, i, self.slots[i])

        storage
    end copied

    /** One element appended, after making the storage this buffer's own and growing it where there is
     * no room left.
     *
     * **The shape below is what lets a caller absorb the whole member**, which is the difference
     * between an append that is a store and an append that is a call and a frame:
     *
     *  - the fast arm is reached only where there is room *and* the storage is this buffer's alone, one
     *    branch for both questions, so its store needs no bounds check of its own and the uniqueness
     *    test is a compare beside the capacity's;
     *  - the copy, the growth *and the store that follows them* sit behind one out-of-line function,
     *    so nothing the store needs has to survive a call and no callee-saved register is spilled to
     *    hold it;
     *  - **that function is handed the storage and handed back new storage**, rather than handed the
     *    buffer's address. A buffer whose address no call takes is one the optimizer may hold in
     *    registers whole, so a loop of pushes into a local keeps its storage, its capacity and its
     *    count out of memory, and asks nothing of memory but the storage's own count;
     *  - the count is raised in **each arm**, from the value compared at the top and beside the fact
     *    that makes the raise legal: the clause `used <= slots.len` it re-checks is settled by the test
     *    on the fast arm and by `placed_past`'s `ensure` on the other, where a raise after the arms
     *    met would be checked again on every turn.
     *
     * **`@inline` raises the element type at which an append stops being a store.** Shaped as above
     * the member still costs a little more for every word of the element and a good deal more for
     * every counted field it carries, so the mark raises what the inliner will spend here.
     */
    // Every member that can move the storage or give an element up is `@relocates`, so a live `ref`
    // to an element is refused the call.
    @inline
    @relocates
    const push(*self, v: T)
        val n = self.used

        if n < self.slots.len && is_unique(self.slots)
            slot_place(self.slots, n, v)
            self.used = n + 1
        else
            self.slots = placed_past(self.slots, n, v)
            self.used = n + 1
        end if
    end push

    /** Storage replaced by storage that holds at least `need` elements, with everything already
     * there copied across. The growth is geometric -- the capacity doubles until it fits, rather
     * than sizing exactly to what was asked for -- so a caller adding elements one at a time still
     * pays amortized constant time per element. Sizing to fit would make a loop of `extend` calls
     * quadratic in the same way `+=` on a string is.
     *
     * **It is out of line, and marked so, because that is what lets `push` disappear into its
     * caller.** Behind a name that is kept out of line and declared rare, what is left where the
     * growth was is a compare and a branch that is almost never taken.
     *
     * **The new storage's slots start out empty** (`slot_storage`), and the elements already here
     * are placed into it one by one, each taking a count of its own. The old storage is not emptied,
     * since a view handed out earlier may still be reading it; it lets go of its elements when its
     * last holder does.
     *
     * **The contract is what carries the growth back out to the caller**: a postcondition is
     * repeated at every call site as a fact the optimizer may use, so the store made on the line after
     * the call needs no bounds test of its own.
     */
    @noinline
    @cold
    private grow(*self, need: usize)
        require need > self.used
        ensure self.used < self.slots.len
        ensure need <= self.slots.len

        var bigger_len = if self.slots.len == 0 then 8usize else self.slots.len

        while bigger_len < need
            bigger_len *= 2

        var bigger: []T = slot_storage(bigger_len)

        for i in 0..<self.used
            slot_place(bigger, i, self.slots[i])

        self.slots = bigger
    end grow

    /** Every element of a slice appended at once, which is what `push` in a loop was costing more
     * than it looked like. A run of n elements pushed one at a time asks the capacity question n
     * times and may reallocate several times along the way; this asks once, grows once to a size
     * that fits the whole run, and copies.
     *
     * The empty case leaves early because `grow` promises more room than the count, and a run of
     * no elements asks for none -- which costs nothing, since it has nothing to append either.
     */
    @relocates
    const extend(*self, xs: []const T)
        if xs.len == 0 then return

        self.unique()

        val need = self.used + xs.len

        if need > self.slots.len then self.grow(need)

        // The run is cut once, so each place is tested against its length -- which is `xs.len`, the
        // loop's own bound -- and the cut's own test is what settles the count's re-check below.
        val run = self.slots[self.used..<need]

        for i in 0..<xs.len
            slot_place(run, i, xs[i])

        self.used = need
    end extend

    /** The last element, taken out. Where nothing else holds the storage the buffer gives up its own
     * count of it here, so what the caller is handed is the only one left unless something else holds
     * the value too; where the storage is shared, only the count moves.
     */
    @relocates
    const pop(*self) -> Option[T]
        if self.used == 0 then return None

        val n = self.used - 1
        val v = self.slots[n]

        self.used = n
        slot_vacate(self.slots, n)
        Some(v)
    end pop

    /** The elements from `n` on, given up -- each let go of now rather than when the storage goes,
     * which is when a destructor behind one runs, unless the storage is shared, when only the count
     * moves. The storage is kept.
     */
    @relocates
    const truncate(*self, n: usize)
        if n >= self.used then return

        self.used = n
        slot_vacate(self.slots, n)
    end truncate

    /** Every element given up. A buffer whose storage is shared lets go of its share rather than
     * copying elements only to give them up, and is left empty, with no storage.
     */
    @relocates
    const clear(*self)
        if self.used == 0 then return

        if is_unique(self.slots) then self.truncate(0)
        else
            self.used = 0
            self.slots = []
        end if
    end clear

    /** An element put at `i`, with everything from there on moved up one. `remove`'s other half, and
     * the reason it is worth having is that hand-rolling it is a shift written backwards -- a loop
     * walking up overwrites the element it is about to read, so the copy has to start at the end and
     * that is where the off-by-one lives.
     *
     * Inserting at `len` is a `push`, and is allowed for that reason: a loop inserting at a cursor
     * reaches the end of the sequence on its last step, and refusing there would make the caller
     * write the case that this one already handles. Anything past `len` is a gap, which a sequence
     * has no way to represent, and traps the way every other index past the end does.
     */
    @relocates
    @track_caller
    const insert(*self, i: usize, v: T)
        if i > self.used then insert_past(i, self.used)

        self.push(v)

        var j = self.used - 1

        while j > i
            self.slots[j] = self.slots[j - 1]
            j -= 1

        self.slots[i] = v
    end insert

    /** Room for at least `more` elements past `len()`, so that many pushes -- or that many slots
     * written through `spare()` -- need no growth. `cap()` afterwards is at least `len() + more`;
     * the storage grows the way a push grows it, so asking for one more at a time still costs
     * amortized constant time. The elements already here keep their values, and their addresses only
     * where nothing had to grow.
     */
    @relocates
    const reserve(*self, more: usize)
        self.unique()

        if more > self.slots.len - self.used then self.grow(self.used + more)

    @relocates
    @track_caller
    const remove(*self, i: usize) -> T
        if i >= self.used then index_past(i, self.used)

        self.unique()

        val gone = self.slots[i]

        for j in i..<self.used - 1
            self.slots[j] = self.slots[j + 1]

        self.truncate(self.used - 1)
        gone
    end remove

    /** A second buffer holding the same elements in storage of its own, sized to them. Assigning
     * already gives a buffer that is not this one; `copy()` is for a caller that wants the storage
     * apart now, and sized to the elements, rather than shared until the first write.
     */
    const copy(self) -> Buf[T]
        var out: Buf[T] = Buf(slot_storage(self.used), 0)

        out.extend(self.view())
        out
    end copy

    /** The elements, frozen: a `&sync Frozen[T]` every thread may read at once. The elements are
     * copied once into storage sized to them. A local this is called on may not be read again until
     * it is assigned a new value (`@consumes`).
     */
    @relocates
    @consumes
    const freeze(self) -> &sync Frozen[T] = freeze_buf(self)

    /** The elements as a read-only slice, which is what everything reading a `Buf` in bulk goes
     * through. It is a view of the storage rather than a copy, holding a share of it, so a write to
     * the buffer while it is held is made to a copy and the view reads what it read. Writing through
     * it is refused: a writer takes `view_mut()`, and a function handing a local buffer's elements
     * out takes `into_view()`.
     */
    const view(self) -> []const T = self.slots[..<self.used]

    /** The elements as a slice that may be written: the storage made this buffer's own first, as any
     * write makes it, so a write through the view is seen through this buffer and through no copy of
     * it. The view is tied to the buffer it was taken from and may not outlive it, and growing the
     * buffer leaves the view on the storage it had.
     */
    @views(self)
    view_mut(*self) -> []T
        self.unique()

        self.slots[..<self.used]

    /** The buffer given up and its elements handed over as an owned slice: for a function that
     * builds a local buffer and returns what it holds. The slice keeps the storage alive after the
     * buffer's name is gone, so returning it is valid wherever returning `view()` of a local is. A
     * local this is called on may not be read again until it is assigned a new value (`@consumes`).
     *
     * **The storage is made this buffer's own first, as any write makes it**, so the slice -- which
     * may be written -- never writes through to a copy. A buffer that is not a local (a field, an
     * element, a buffer reached through a pointer) is left empty, holding nothing.
     */
    @relocates
    @consumes
    const into_view(*self) -> []T
        self.unique()

        val mine = self.slots[..<self.used]

        self.used = 0
        self.slots = []
        mine
    end into_view

    // The checked accesses the subscript traits reach: the index tested against the count, after
    // which the slice's own test against its length is implied and folds.
    @track_caller
    private[buf] at(self, i: usize) -> T
        if i >= self.used then index_past(i, self.used)

        self.slots[i]

    @track_caller
    private[buf] place(self, i: usize) -> *T
        if i >= self.used then index_past(i, self.used)

        &self.slots[i]
end Buf

/** The rare half of `Buf.push`: storage of a buffer's own holding its first `n` elements and `v`
 * after them -- the shared storage's capacity where the buffer was only sharing it and there is room,
 * and twice it (eight slots, for none) where it is full. Whatever `slots` named is the caller's to let
 * go of, which its assignment of the result does: storage nobody else held is freed there, and a
 * share of shared storage given back.
 */
@noinline
@cold
private placed_past[T](slots: []T, n: usize, v: T) -> []T
    require n <= slots.len
    ensure n < result.len

    var room = slots.len

    if n >= room then room = if room == 0 then 8usize else room * 2

    var fresh: []T = slot_storage(room)

    for i in 0..<n
        slot_place(fresh, i, slots[i])

    slot_place(fresh, n, v)
    fresh
end placed_past

/** The handle at `p` given back and left naming nothing, as zeroed storage does. The assignment is
 * what gives the share back -- releasing a handle that names nothing being nothing, which is what lets
 * the all-zero value be assigned at all.
 */
private[sysl] forget[H](p: *H)
    var nothing: [1]usize = [0]
    val zero: *H = ptr_cast(&nothing[0])
    *p = *zero

/** The report a container makes when it is asked to grow in storage nobody gave it. Out of line and
 * cold, and handed nothing, so the test a growing member carries for it is a compare and a branch the
 * member's inlining budget hardly notices.
 *
 * **It makes no storage of its own**: the report goes out in pieces rather than as one interpolated
 * string, so a `@no_alloc` module using a container is told about the container's growth, which is
 * what it has to change, and never about this.
 *
 * **On a freestanding target it traps, saying nothing**, as `trap` does. `Buf`'s growth path reaches
 * this from every push, where no optimizer can see the handle names something, so a report that
 * printed and exited would make every bare image that pushes supply `putchar` and `exit` for a
 * message about a mistake it may never make.
 */
@noinline
@cold
private[sysl] unassigned(kind: Unassigned) -> never
#if hosted
    val (name, maker) = kind match
        BufUnassigned -> ("Buf", "`buf()`")
        DequeUnassigned -> ("Deque", "`deque()`")
        MapUnassigned -> ("Map", "`map()`")

    print("panic: this", name, "was never given storage -- assign", maker,
          "to it first (a container in zeroed memory is empty until it is assigned)")
    exit(1)
#else
    trap()
#endif
end unassigned

/** Which container `unassigned` is speaking for. */
private[sysl] enum Unassigned
    BufUnassigned
    DequeUnassigned
    MapUnassigned


// The report a length past the storage makes, out of line because of what a checked member costs
// when it is not: written inline, the report is a dozen calls in the middle of a small member, which
// is then too big for a caller to absorb. Behind a name that does not return, what is left where the
// check was is a compare and a branch. An index past the count is `sysl.index_past`, for the same
// reason.
private past_room(n: usize, room: usize) -> never
    print("panic: length", n, "past the", room, "slots a Buf has room for")
    exit(1)
end past_room

/** The storage past a buffer's elements, filled by something other than `push` -- a C function
 * handed its address, or a writer handed it as a `[]T` -- and then taken into the count without a
 * second copy:
 *
 * ```
 * b.reserve(n)
 * val got = fill(b.spare())       // writes into the first `got` slots
 * b.set_len(b.len() + got)
 * ```
 *
 * **Only a buffer whose element type is `AnyBits` has these.** A slot `set_len` takes in holds
 * whatever was in its storage: the bytes written there, or, for a slot nobody wrote, whatever the
 * allocator left -- an unspecified value, which for an `AnyBits` type is still a value of it. A
 * `bool`, an enum, a `string` or a `&T` read out of bytes nobody wrote would not be one, so those
 * buffers are refused the call at compile time.
 */
impl[T: AnyBits] Buf[T]

    /** The slots past `len()`, as a slice of `cap() - len()` -- the room a writer may fill. It is a
     * view of the storage, made this buffer's own first, so it is valid only until the buffer next
     * grows.
     */
    spare(*self) -> []T
        self.unique()

        self.slots[self.used..]

    /** The length set to `n`, taking the slots between the old length and `n` as the elements they
     * already hold. **Nothing is written** -- not a fill, not a zero: a slot holds what was last
     * stored in it, which for a slot never written is whatever the allocator left, and for one
     * `truncate` gave up is the value it had. Below `len()` it is `truncate(n)`. Past `cap()` it
     * panics: a count claiming storage nobody gave the buffer.
     *
     * **A buffer whose storage is shared takes the slots it is claiming with it** when it makes the
     * storage its own: a view `spare()` handed out may still be held, and what was written through it
     * is what the new length is claiming.
     */
    @relocates
    set_len(*self, n: usize)
        if n == self.used then return

        if n > self.slots.len then past_room(n, self.slots.len)

        if n < self.used
            self.truncate(n)
            return
        end if

        if !is_unique(self.slots) then self.slots = self.copied(n)

        self.used = n
    end set_len

/** A buffer compares as the sequence it holds, which is `view()` -- the elements it actually has,
 * rather than the backing slice, whose slots past `count` were never written.
 *
 * **The delegation is on purpose.** A `Buf[T]` is the growable form of a `[]T` and the two would be
 * hard to explain if either answered differently, so the loop is written once, over the slice, and
 * this is the growable sequence saying it is the same sequence.
 */
impl[T: Eq] Eq for Buf[T]
    const eq(self, rhs: Self) -> bool = self.view() == rhs.view()

/** A buffer renders as the sequence it holds, which is `view()` -- the same delegation its equality
 * goes through, and for the same reason.
 *
 * What the delegation buys here beyond agreement is the padding: a specifier describes the field the
 * whole value occupies, and `[]T`'s own block already measures a rendering before it pads one, so a
 * width on a `Buf` pads the whole sequence rather than being worked out a second time.
 */
impl[T: Display] Display for Buf[T]
    display(self, out: *Writer, fmt: FormatSpec) = self.view().display(out, fmt)

/** A `Buf` shows as the sequence it holds, `[1, 2, 3]`, rather than as the storage it is built from. */
impl[T: Debug] Debug for Buf[T]
    debug(self, out: *Writer, fmt: FormatSpec) = self.view().debug(out, fmt)

/** Subscripting reaches the bounds-checked members rather than the storage, so `b[i]` on a `Buf`
 * checks `i` against the count, and cannot read a slot past it that the backing slice still has.
 */
impl[T] Index[usize, T] for Buf[T]
    @track_caller
    const index(self, i: usize) -> T = self.at(i)

impl[T] IndexSet[usize, T] for Buf[T]
    @track_caller
    const index_set(*self, i: usize, v: T)
        if i >= self.used then index_past(i, self.used)

        self.unique()
        self.slots[i] = v
    end index_set

/** `b[i]` is the element where it lives: the address, checked against the count, so `b[i].f` reads
 * one field without copying the element and `ref e = b[i]` names it. Good until a `@relocates`
 * member moves the storage.
 */
impl[T] IndexPlace[usize, T] for Buf[T]
    @track_caller
    index_place(self, i: usize) -> *T = self.place(i)

    // An `@unchecked` block's `b[i]` read: the same address, with no test against the count.
    override index_place_unchecked(self, i: usize) -> *T
        @unchecked
            &self.slots[i]

    // `b[i]` written through -- assigned, `&`-taken, named by a `ref`, the receiver of a `*self`
    // call: the storage made this buffer's own first, so a write never reaches a copy. Inside an
    // `@unchecked` block a write comes here too, and keeps its test.
    @track_caller
    override index_place_mut(*self, i: usize) -> *T
        if i >= self.used then index_past(i, self.used)

        self.unique()
        &self.slots[i]
    end index_place_mut

    // `b[i][..]`: the element as a view of one, whose owner is the storage's.
    @track_caller
    override index_view(self, i: usize) -> []T
        if i >= self.used then index_past(i, self.used)

        self.slots[i..<i + 1]

    override index_view_unchecked(self, i: usize) -> []T
        @unchecked
            self.slots[i..<i + 1]

/** `for x in b` walks `view()`: the elements the buffer held when the loop began, read by index as a
 * slice's are, rather than through a cursor that would cost a call apiece. An element pushed during
 * the walk is not visited, the view having been taken before the first turn.
 */
impl[T] Walk for Buf[T]
    type Walker = []const T
    const walk(self) -> []const T = self.view()

/** The empty buffer: no storage, nothing allocated until the first write. */
const buf[T]() -> Buf[T]
    var b: Buf[T]

    b
end buf

/** `Buffer[T]` is `Buf[T]` under its longer name: the same type, so the two are written
 * interchangeably in parameters, fields, impls and generic arguments.
 */
type Buffer[T] = Buf[T]

/** `buffer()` is `buf()` under its longer name. */
const buffer[T]() -> Buf[T] = buf()

/** A buffer that has already been given room for `n` elements, for a caller that knows roughly how
 * many are coming. What it saves is the reallocation-and-copy at each doubling on the way up, which
 * is the one cost a growable sequence has that an exactly-sized array does not.
 *
 * **`fill` is not stored anywhere.** The slots start out empty (`slot_storage`), so a counted `fill`
 * is not kept alive by the room it would once have been repeated into. The parameter stays because
 * callers write it, and because it is what lets a call say the element type without brackets.
 */
const buf_with_capacity[T](n: usize, fill: T) -> Buf[T] = Buf(slot_storage(n), 0)

/** A buffer of `n` elements, every one of them `value` -- what a RAM disk, a frame buffer or a table
 * of counters starts as. The storage is sized to `n` once and each slot is filled in place, so it
 * costs one allocation and `n` stores rather than the doublings of a `push` loop.
 *
 * **Every element is a copy of `value`**, the way any assignment copies: a plain value is repeated,
 * and a counted one is shared -- `n` elements naming one object, holding `n` counts of it.
 */
const buf_filled[T](n: usize, value: T) -> Buf[T]
    var out: Buf[T] = Buf(slot_storage(n), 0)

    for _ in 0..<n
        out.push(value)

    out
end buf_filled

/** A writer that gathers, and the reason it is supplied rather than left to each program is the rule
 * that a specifier describes the field the *whole* value occupies (`library/core.md § A specifier
 * is the whole value's field`): an implementation rendering more than one part has to gather them
 * before it can pad what they came to, and gathering needs somewhere to put them.
 *
 * It is one of the library's two writers; the other is `Stdout`, in the standard module, which
 * stands for standard output and holds no state at all.
 */
struct ByteSink
    bytes: &Buf[u8]

    /** What has been written, as a slice of the sink's own storage: a write through it is seen by
     * the next `text()`, which is how a caller sizes the sink with zeros and then fills it in place.
     */
    text(self) -> []u8
        self.bytes.unique()
        self.bytes.slots[..<self.bytes.used]
    end text

byte_sink() -> ByteSink = ByteSink(buf())

/** A buffer that grows has nothing to fail at, so the whole of implementing the latch is opting into
 * it: every member of `Fallible` has a default, and a trait like that needs no block
 * (`reference/traits.md § Conformance is explicit, always`).
 */
impl Fallible for ByteSink

impl Writer for ByteSink
    write(*self, bytes: []const u8) = self.bytes.extend(bytes)
