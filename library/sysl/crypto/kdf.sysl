module sysl.crypto
@no_alloc

import sysl.slices.copy

// Turning a secret into key material: PBKDF2 for a password, HKDF for a key that is already random.
//
// **They answer different questions and are not alternatives.** PBKDF2 is *stretching* — a password
// has little entropy, so the cost of guessing one is raised by making each guess expensive, which is
// what the iteration count buys and the only thing it buys. HKDF is *extraction and expansion* — a
// Diffie-Hellman shared secret is already unguessable but is not uniform, so it is condensed once
// and then spread into as many keys as a protocol names. Running HKDF over a password protects
// nothing, and running PBKDF2 over a shared secret wastes time for no gain.
//
// **Neither is a design decision this module makes.** RFC 8018 §5.2 and RFC 5869 fix the whole of
// both; a caller chooses the digest, the iteration count and the length, and every one of those is
// named by whatever protocol is asking. What goes wrong is silent — PBKDF2's block counter is four
// bytes, big-endian, counting from one, and HKDF's is one byte counting from one — and a key derived
// with either of those wrong is a fine-looking key that agrees with nobody, which arrives as an
// authentication failure with nothing to look at.
//
// **The output is written into storage the caller owns**, which is the shape `finish` and `hmac`
// have and the same reason: the length is named by the protocol, so the caller already knows it, and
// a function that allocated the answer would put this module behind an allocator for no gain.

// PBKDF2, over any of the six (RFC 8018 §5.2).
//
// The key is built a digest at a time: block `i` is `c` chained HMACs XORed together, the first over
// the salt and `i` written big-endian. Keying is done **once** and copied per HMAC, which is what
// makes tens of thousands of iterations cost tens of thousands of hashes rather than twice that.
private[crypto] pbkdf2[C: Compression](proto: Sha[C], password: []const u8, salt: []const u8,
        iterations: u32, out: []u8) -> Result[unit, Fault]
    var n = proto.dlen

    if n == 0 then return Err(NotStarted)
    if iterations == 0 then return Err(NoIterations)

    val key = keyed(proto, password)?

    var u: [64]u8
    var next: [64]u8
    var acc: [64]u8
    var counter: [4]u8
    var at: usize = 0
    var block: u32 = 1

    while at < out.len
        for i in 0..<4usize do counter[i] = u8(block >> ((3 - i) * 8))

        var first = key

        first.update(salt)
        first.update(counter[..])
        first.finish(u[0..<n])?

        copy(acc[0..<n], u[0..<n])

        var round: u32 = 1

        while round < iterations
            var h = key

            h.update(u[0..<n])
            h.finish(next[0..<n])?

            copy(u[0..<n], next[0..<n])

            for j in 0..<n do acc[j] = acc[j] ^ u[j]

            round += 1

        var room = out.len - at
        var take = if room < n then room else n

        copy(out[at..<at + take], acc[0..<take])

        at += take
        block += 1

    Ok(())
end pbkdf2

// HKDF's second half (RFC 5869 §2.3), which is the one a protocol reaches for on its own: TLS 1.3's
// `Derive-Secret` is an expansion under a label, run once for every traffic and exporter secret in
// its schedule.
//
// `info` is what keeps two keys derived from one secret apart, and it is a label rather than a
// secret — the standard's whole point is that a different `info` gives an unrelated key.
private[crypto] hkdf_expand[C: Compression](proto: Sha[C], prk: []const u8, info: []const u8,
        out: []u8) -> Result[unit, Fault]
    var n = proto.dlen

    if n == 0 then return Err(NotStarted)

    // The counter is one byte, so 255 blocks is all there is. Asking for more is the caller's
    // arithmetic being wrong rather than something to answer with a shorter key.
    if out.len > 255 * n then return Err(TooMuchOutput)

    val key = keyed(proto, prk)?

    var t: [64]u8
    var counter: [1]u8
    var at: usize = 0
    var block: u8 = 1

    while at < out.len
        var h = key

        counter[0] = block

        // The previous block goes in first and there is none before the first, which is what makes
        // the chain a chain rather than 255 independent hashes of the same thing. Reading `t` and
        // then finishing into it is safe in the order it is written: the hasher has absorbed those
        // bytes by the time anything is published.
        if at > 0 then h.update(t[0..<n])

        h.update(info)
        h.update(counter[..])
        h.finish(t[0..<n])?

        var room = out.len - at
        var take = if room < n then room else n

        copy(out[at..<at + take], t[0..<take])

        at += take
        block += 1

    Ok(())
end hkdf_expand

/** PBKDF2 over HMAC-SHA-1, writing as much key as `out` has room for.
 *
 * **It is the one an existing protocol names**: WPA2 derives its pairwise master key this way, and
 * so does SCRAM-SHA-1 and a great deal of deployed password storage. A scheme being written now
 * wants `pbkdf2_hmac256`, and something built for the purpose -- Argon2, scrypt -- before either.
 *
 * The iteration count is the caller's because the protocol says it: SCRAM carries the server's count
 * on the wire, and a client that used its own would derive a different key and be told its password
 * was wrong. It must be at least one.
 */
pbkdf2_hmac1(password: []const u8, salt: []const u8, iterations: u32,
        out: []u8) -> Result[unit, Fault] = pbkdf2(new_sha1().inner, password, salt, iterations, out)

/** PBKDF2 over HMAC-SHA-2, writing as much key as `out` has room for.
 *
 * **`pbkdf2_hmac256` is the one to reach for**, being what SCRAM-SHA-256 names -- so PostgreSQL,
 * MongoDB, Kafka and XMPP -- and what WebCrypto's `deriveBits` is usually asked for.
 *
 * The iteration count is the caller's, is named by the protocol, and must be at least one. What it
 * buys is the cost of *guessing*, and nothing else: a password that could be guessed in a thousand
 * tries still can be, a hundred thousand times more slowly.
 */
pbkdf2_hmac224(password: []const u8, salt: []const u8, iterations: u32,
        out: []u8) -> Result[unit, Fault] = pbkdf2(new_sha224().inner, password, salt, iterations, out)

pbkdf2_hmac256(password: []const u8, salt: []const u8, iterations: u32,
        out: []u8) -> Result[unit, Fault] = pbkdf2(new_sha256().inner, password, salt, iterations, out)

pbkdf2_hmac384(password: []const u8, salt: []const u8, iterations: u32,
        out: []u8) -> Result[unit, Fault] = pbkdf2(new_sha384().inner, password, salt, iterations, out)

pbkdf2_hmac512(password: []const u8, salt: []const u8, iterations: u32,
        out: []u8) -> Result[unit, Fault] = pbkdf2(new_sha512().inner, password, salt, iterations, out)

/** HKDF (RFC 5869) in one call: a secret is condensed with the salt and then spread into `out`.
 *
 * **The secret must already be unguessable** -- a Diffie-Hellman result, a key from a hardware
 * source -- because nothing here raises the cost of guessing it. A password goes to `pbkdf2_hmac256`
 * instead.
 *
 * **`info` is what keeps two keys derived from one secret apart**, and it is a label rather than a
 * secret: a protocol writes its own name and the key's purpose there, and a different `info` yields
 * an unrelated key. The salt may be empty, which is the standard's own default -- HMAC pads a short
 * key with zeroes, so an empty salt *is* the zero key the standard names.
 *
 * At most 255 digests' worth of key can be asked for, which the standard's one-byte counter fixes.
 *
 * **Extract on its own is `hmac256(salt, ikm)`** and needs nothing from this module: HKDF-Extract is
 * HMAC with the salt as the key, which is why only expansion has a name of its own below.
 */
hkdf1(salt: []const u8, ikm: []const u8, info: []const u8, out: []u8) -> Result[unit, Fault] =
    hkdf_expand(new_sha1().inner, hmac1(salt, ikm)[..], info, out)

hkdf224(salt: []const u8, ikm: []const u8, info: []const u8, out: []u8) -> Result[unit, Fault] =
    hkdf_expand(new_sha224().inner, hmac224(salt, ikm)[..], info, out)

hkdf256(salt: []const u8, ikm: []const u8, info: []const u8, out: []u8) -> Result[unit, Fault] =
    hkdf_expand(new_sha256().inner, hmac256(salt, ikm)[..], info, out)

hkdf384(salt: []const u8, ikm: []const u8, info: []const u8, out: []u8) -> Result[unit, Fault] =
    hkdf_expand(new_sha384().inner, hmac384(salt, ikm)[..], info, out)

hkdf512(salt: []const u8, ikm: []const u8, info: []const u8, out: []u8) -> Result[unit, Fault] =
    hkdf_expand(new_sha512().inner, hmac512(salt, ikm)[..], info, out)

/** HKDF's expansion alone (RFC 5869 §2.3), over a pseudorandom key the caller already has.
 *
 * **This is the half TLS 1.3 leans on**: `HKDF-Expand-Label` is this function with the label written
 * into `info` in the shape §7.1 gives, and `Derive-Secret` is one of those per traffic and exporter
 * secret in the schedule. Signal's chains are the same shape.
 *
 * The key should be a digest's worth of unguessable bytes -- what `hmac256(salt, ikm)`, which is
 * HKDF-Extract, answers with. At most 255 digests' worth of key can be asked for.
 */
hkdf1_expand(prk: []const u8, info: []const u8, out: []u8) -> Result[unit, Fault] =
    hkdf_expand(new_sha1().inner, prk, info, out)

hkdf224_expand(prk: []const u8, info: []const u8, out: []u8) -> Result[unit, Fault] =
    hkdf_expand(new_sha224().inner, prk, info, out)

hkdf256_expand(prk: []const u8, info: []const u8, out: []u8) -> Result[unit, Fault] =
    hkdf_expand(new_sha256().inner, prk, info, out)

hkdf384_expand(prk: []const u8, info: []const u8, out: []u8) -> Result[unit, Fault] =
    hkdf_expand(new_sha384().inner, prk, info, out)

hkdf512_expand(prk: []const u8, info: []const u8, out: []u8) -> Result[unit, Fault] =
    hkdf_expand(new_sha512().inner, prk, info, out)
