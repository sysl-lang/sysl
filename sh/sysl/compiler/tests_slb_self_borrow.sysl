module sh.sysl.compiler
@tests

import sysl.text.{Search, str_builder}
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture

// A large `self` taken by value, read where the caller's storage lies (`borrowing.sysl`'s
// `quiet_callees` and `lends_self`).
//
// `self` is documented as a copy, and a copy of a 4 KB receiver is a 4 KB frame -- twice over where a
// `*self` method calls a `self` one, the caller snapshotting the receiver and the callee copying the
// snapshot. On a board with a 4 KB stack that is the whole stack. **Where nothing could tell the copy
// from the original it is not made**: the callee writes nothing outside its own frames (so nothing
// can change the caller's storage while it runs), and it never writes, addresses or views `self`.
//
// **The tests come in two halves**: the copies that are gone, and the copies that are still there
// because a program could see them -- a method that writes its `self`, one that views it, and one
// that writes the caller's storage through an alias, directly or through something it calls.

private slb_ready() -> bool
    if std_root().is_err()
        print("skipped: the standard module's source is not on this machine")
        return false

    if !clang_available()
        print("skipped: there is no clang on this machine")
        return false

    true
end slb_ready

private slb_ir(text: string) -> string
    val root = make_temp_dir("sysl-self-borrow").unwrap()
    val src = s"$root/main.sysl"

    make_dir_all(root).unwrap()
    write_text(src, text).unwrap()

    val out = emit_llvm_text(src, None) match
        Err(why) -> failure_text(why)
        Ok(made) -> if made.report.is_empty() then made.text else analysis_report(made.report)

    remove_dir_all(root).unwrap_or(())
    out
end slb_ir

// One function's emitted text, from its `define` to the brace that closes it.
private slb_body(out: string, name: string) -> string
    val lines = lines_of(out)
    var b = str_builder()
    var inside = false

    for i in 0..<lines.len()
        val line = lines.at(i)

        if !inside && line.starts_with("define ") && line.contains("@" + name + "(") then inside = true

        if inside
            if line == "}" then return b.finish()

            b.push(line)
            b.push_char('\n')

    if inside then b.finish() else s"no definition of '$name' in:\n$out"
end slb_body

// What a program prints, and whether it came back cleanly.
private slb_prints(text: string, expected: string)
    if !slb_ready() then return

    val root = make_temp_dir("sysl-self-borrow").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", text).unwrap()

    val exe = s"$root/built"

    build_native_program(s"$root/main.sysl", None, None, DefaultOptimization, Some(exe)) match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            assert(false, failure_text(why))
            return
        Ok(_) -> ()

    val said = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    said match
        Err(_) -> assert(false, "the program that was built could not be run")
        Ok(out) ->
            assert_eq(out.text, expected)
            assert(out.status.ok(), "the program printed what was expected and did not exit cleanly")
end slb_prints

// The shape that cost musicbox its stack: a `*self` method calling a `self` one calling another.
private slb_repro() -> string = raw"""
    struct Big
        notes: []const u32
        n: usize
        table: [1024]u32

        busy(self) -> usize
            var c: usize = 0
            for k in 0..<1024
                if self.table[k] != 0 then c += 1
            c

        more(self) -> bool = self.n < self.notes.len || self.busy() > 0

        step(*self) -> bool
            self.n += 1
            self.more()

    var b = Big([1, 2, 3], 0, [0; 1024])
    print(b.step())
    """

// -- the copies that are gone ----------------------------------------------------------------------

@test("a large self is read where it lies: the callee copies nothing in at entry")
slb_the_callee_copies_nothing()
    if !slb_ready() then return

    val out = slb_ir(slb_repro())

    for name in ["Big.busy", "Big.more"]
        val body = slb_body(out, name)

        assert(body.contains("%self.addr = getelementptr i8, ptr %self.param, i32 0"), body)
        assert(!body.contains("alloca %struct.Big"), body)
        assert(!body.contains("@llvm.memcpy"), body)
end slb_the_callee_copies_nothing

@test("a large self is read where it lies: a *self method lends its receiver with no snapshot and no count")
slb_the_caller_lends_its_receiver()
    if !slb_ready() then return

    val body = slb_body(slb_ir(slb_repro()), "Big.step")

    assert(body.contains("call zeroext i1 @Big.more(ptr %t"), body)
    assert(!body.contains("alloca %struct.Big"), body)
    assert(!body.contains("@llvm.memcpy"), body)
    assert(!body.contains("@arc.copy_at.Big"), body)
    assert(!body.contains("@arc.dispose"), body)
end slb_the_caller_lends_its_receiver

@test("a large self is read where it lies: and a large slot is let go of at its address")
slb_a_large_slot_is_released_at_its_address()
    if !slb_ready() then return

    val out = slb_ir(slb_repro())

    assert(out.contains("define private void @arc.dispose_at.Big(ptr %p)"), out)
    assert(out.contains("call void @arc.dispose_at.Big(ptr %b.addr)"), out)
    assert(!out.contains("load %struct.Big"), out)
    assert(!out.contains("@arc.dispose.Big("), out)
end slb_a_large_slot_is_released_at_its_address

@test("a large self is read where it lies: and the program still says what it said")
slb_the_repro_runs()
    slb_prints(slb_repro(), "true\n")

// -- the copies a program could see, which stay ----------------------------------------------------

private slb_guards() -> string = raw"""
    struct Big
        n: int
        table: [256]u32

        bump(self) -> int
            self.n += 1
            self.n

        scribble(self) -> u32
            var v = self.table[..]
            v[0] = 9
            self.table[0]

        watch(self, p: *Big) -> u32
            val before = self.table[0]
            p.table[0] = 7
            before + self.table[0]

        later(self, p: *Big) -> u32
            poke(p)
            self.table[0]

    poke(p: *Big)
        p.table[0] = 5

    var b = Big(1, [0; 256])
    print(b.bump(), b.n)
    print(b.scribble(), b.table[0])
    print(b.watch(&b), b.table[0])
    b.table[0] = 0
    print(b.later(&b), b.table[0])
    """

@test("a self a program could tell from the original is still a copy: what each method sees")
slb_the_observable_copies_still_copy()
    slb_prints(slb_guards(), "2 1\n9 0\n0 7\n0 5\n")

@test("a self a program could tell from the original is still a copy: written, viewed, or reached through an alias")
slb_each_observable_copy_is_made()
    if !slb_ready() then return

    val out = slb_ir(slb_guards())

    for name in ["Big.bump", "Big.scribble", "Big.watch", "Big.later"]
        val body = slb_body(out, name)

        assert(body.contains("%self.addr = alloca %struct.Big"), body)
        assert(body.contains("@llvm.memcpy.p0.p0.i64(ptr align 4 %self.addr, ptr align 4 %self.param"),
               body)
end slb_each_observable_copy_is_made

// -- the counts ------------------------------------------------------------------------------------

// A receiver holding a string, a box with a destructor and a slice, lent a thousand times through a
// `*self` method, read in place, and copied by a method that rebinds a field. A count lost is a
// destructor run early or twice; one too many is a destructor that never runs.
@test("a large self is read where it lies: and every count it holds comes back exactly once")
slb_the_counts_balance()
    slb_prints(raw"""
        struct Probe
            n: usize

        impl Drop for Probe
            drop(self)
                print("dropped")

        struct Holder
            name: string
            node: &Probe
            notes: []const u32
            table: [256]u32

            size(self) -> usize = self.name.len + self.notes.len + self.node.n + usize(self.table[3])

            renamed(self) -> usize
                self.name = "renamed"
                self.size()

            tick(*self) -> usize = self.size() + self.renamed()

        run() -> usize
            var h = Holder("abc", Probe(2), [1, 2, 3], [1; 256])
            var total: usize = 0

            for _ in 0..<1000
                total += h.tick() + h.size()

            total

        print(run())
        """, "dropped\n31000\n")
