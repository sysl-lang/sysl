module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.Search

// What a place is, and what a `?` anywhere inside a statement means for a `defer`.
//
// **A place is something with an address**: a local, a field, an element, a dereference. Anything
// computed -- a call's result, an arithmetic result, a freshly built struct -- is not one, and the
// refusals below say what a place is rather than that this is not one, because the mistake is
// nearly always a call and "it has no address" is the fact that explains every case at once.

// Analyzes something that must be a place: an assignment target, or the operand of `&`.
//
// `whole` is the statement doing the writing, and **a refused write is reported at it**: what is
// wrong is the assignment, and the target on its own is a perfectly good expression to read.
// What a refusal to write through a read-only view adds when the body being read is a slice shape
// block made real at the read-only view -- empty everywhere else, so it is appended without asking.
// The refusal lands on a line whose author wrote `[]T` and never typed a `const`, and the one thing
// that line cannot show is the receiver at the call, which is the whole explanation.
const_self_note(cx: &Analyzer) -> string =
    if !cx.an.tables.members.const_self.has(cx.func_name) then ""
    else " — and this body is the block written for '[]T', made real at the read-only view " +
         "because that is what the receiver was. A member writing through 'self' is one only a " +
         "'[]T' can be given, so what has to change is the call on the '[]const T'"

analyze_place(cx: &Analyzer, target: Expr, what: string, whole: Span) -> TExpr =
    require_place(cx, type_expr_bare(cx, target), target, what, true, Some(whole))

// The same demand made of an expression **already analyzed**, for a form that had to see the type
// before it knew whether a place was what it wanted at all.
//
// `writes` separates the two questions. Both need an address, and only one of them *is* a write:
// `&` hands back a `*T`, and what a program does with a raw pointer is the unsafe tier's business.
//
// `anchor` is where a refusal is reported, where that is not the target itself: a `&` is refused at
// the whole `&x`, which is the form that asked for the address.
require_place(cx: &Analyzer, t: TExpr, target: Expr, what: string, writes: bool,
              anchor: Option[Span] = None) -> TExpr
    if texpr_type(t) == Unknown then return t

    val at = anchor.unwrap_or(target.span)

    // A **captured** name reaches storage the walk below cannot see the binding of, so being
    // written once is asked of the name it was declared under rather than of what it turned into.
    val named = written_name(target)

    if named.is_some()
        val local = cx.lookup(named.unwrap())

        if local.is_some() && local.unwrap().read_only
            cx.fault(at, written_once(local.unwrap(), what))

            return t
        end if
    end if

    // A string is immutable, and it is worth saying so rather than reporting the absence of an
    // address: writing one byte of UTF-8 is how a string stops being UTF-8.
    *t.kind match
        TIndex(recv, _, _) ->
            if texpr_type(recv) == Str
                cx.fault(at, "a string is immutable, so its bytes have no address to write through")
                return t
            end if

            // `s.bytes` reinterprets the string's own storage rather than a copy of it, so writing
            // through one is writing the string.
            if writes && is_bytes(recv)
                cx.fault(at, "a string is immutable, and 'bytes' views the string's own " +
                         "storage rather than a copy of it — so writing through one is writing " +
                         "the string. Bytes you may write are bytes of your own: copy them into a " +
                         "'[]u8' first")
                return t
            end if

            if writes && read_only_view(texpr_type(recv)) && texpr_type(recv) != Str
                cx.fault(at, s"this element belongs to a " +
                         s"'${type_show(texpr_type(recv))}', which views elements it may not " +
                         "write, so there is nothing to assign through. Elements you may write " +
                         "are elements of your own: copy them into a " +
                         s"'[]${type_show(element(texpr_type(recv)).unwrap_or(Unknown))}' first" +
                         const_self_note(cx))
                return t
            end if
        _ -> ()

    if !writable_place(t)
        cx.fault(at, s"$what needs a variable, a field, an element, or a dereference — " +
                 "something with an address")

        return t
    end if

    val root = root_local(cx, t)

    if root.is_some() && root.unwrap().read_only then
        cx.fault(at, written_once(root.unwrap(), what))

    // Module storage bound by a `val` is written once for the same reason a local one is: the
    // promise is about the name, and the name is the module's.
    if root.is_none() && global_written_once(t) then
        cx.fault(at, s"a 'val' is written once, so $what has nothing to write through")

    // Only a write is asked about: `&` produces a pointer and takes nothing away, so the storage a
    // `ref` found is exactly where it was.
    if writes then check_ref_guards(cx, at, t)

    t
end require_place

private is_bytes(t: TExpr) -> bool = *t.kind match
    TBytes(_) -> true
    _ -> false

private written_name(target: Expr) -> Option[string] = *target.kind match
    Ident(n) -> Some(n)
    _ -> None

// Why a write to a read-only place is refused, in the words of the form the program actually wrote.
//
// A pattern binding gets its own sentence rather than the `val` one, because the reader of an arm
// wrote no `val` and the reason is a different reason: the name holds a **copy** of the part that
// matched, so the write would land where nothing can observe it.
private written_once(local: Local, what: string) -> string
    if local.from_pattern then
        return "a pattern binding is written once, because it holds a copy of what it matched — " +
            s"so $what would reach that copy rather than the value it came from. Where you mean " +
            "to change something, take a 'var' from the binding first"

    s"a 'val' is written once, so $what has nothing to write through"
end written_once

// Whether a typed expression denotes a place -- something with an address, which can be assigned
// through and pointed at.
//
// The element is the case with a condition on it. A slice's elements live wherever its owner keeps
// them, so they have an address even when the slice itself is a temporary; an array's elements are
// the array, so they do not; and what a pointer names is somewhere else, which is the same reason
// `*p` is a place.
writable_place(t: TExpr) -> bool = *t.kind match
    TLoad(_, _) -> true
    TGlobal(_, _, _) -> true
    TDeref(_, _) -> true
    TField(recv, _, _) -> writable_place(recv)
    TIndex(recv, _, _) -> texpr_type(recv) match
        Slice(_, _) -> true
        Str -> false
        Ptr(_) -> true
        _ -> writable_place(recv)
    _ -> false

// Whether a place bottoms out in a binding that is written once. The refusal it feeds is composed by
// the caller, since what a write to one would have been differs by the form that asked.
written_once_place(cx: &Analyzer, t: TExpr) -> bool = root_local(cx, t) match
    Some(l) -> l.read_only
    None -> false

// **A `*self` receiver is an `&` the caller did not write, and it is asked the same question** an
// assignment and an explicit `&` are: a method that takes the address of a `val` to write through it
// is refused, or `val` says read-only and means nothing -- and a module-level `val`, laid down as
// `constant`, would have a store aimed into read-only storage.
//
// The message names the MEMBER, the write being a line inside somebody else's body. **A closure that
// only reads its captures is called on a `val`**, the address `call` takes being used for nothing but
// reading (`Analysis.read_only_closures`); asked of the concrete receiver, since a call through
// `&Fn(...)` is dispatched on the trait, where the box supplies the place.
refuse_written_once_receiver(cx: &Analyzer, span: Span, place: TExpr, member: string)
    if member == "call"
        texpr_type(place) match
            Struct(st) -> if cx.an.read_only_closures.has(st.base) then return
            _ -> ()
    end if

    val root = root_local(cx, place)

    if root.is_some() && root.unwrap().read_only
        if root.unwrap().from_pattern
            cx.fault(span, s"'$member' takes '*self', so it writes through what it is called on — " +
                     "and a pattern binding holds a copy of what it matched, so the write would " +
                     "reach that copy rather than the value it came from. Copy it into a 'var' and " +
                     "call this on that")
            return
        end if

        cx.fault(span, s"'$member' takes '*self', so it writes through what it is called on, and a " +
                 s"'val' is written once${var_fix(place)}")
        return
    end if

    if global_written_once(place)
        cx.fault(span, s"'$member' takes '*self', so it writes through what it is called on, and a " +
                 s"'val' is written once${var_fix(place)}")
end refuse_written_once_receiver

// The advice, naming the binding where the receiver IS one -- one `val` produces one of these per
// mutating call, and naming it is what makes the fix findable from any of them.
private var_fix(place: TExpr) -> string = *place.kind match
    TLoad(name, _) ->
        val dot = name.index_of(".")

        s" — write 'var ${if dot.is_some() then name[0..<dot.unwrap()] else name}' if it is meant " +
            "to change"
    _ -> " — write 'var' if it is meant to change"

// Whether a place is storage the program may not write -- a `val`, a pattern binding, module storage
// bound by a `val`, or a part of one. A view taken of such storage is read-only whatever the position
// asked for, or `x[..]` would be the way around the `val`.
read_only_storage(cx: &Analyzer, t: TExpr) -> bool = written_once_place(cx, t) || global_written_once(t)

// Whether a place bottoms out in module storage bound by a `val`. An `extern` variable is the one
// global that is not, its storage belonging to whoever laid it down.
private global_written_once(t: TExpr) -> bool = *t.kind match
    TGlobal(_, _, writable) -> !writable
    TField(recv, _, _) -> !holds_an_address(texpr_type(recv)) && global_written_once(recv)
    TIndex(recv, _, _) -> owns_its_elements(texpr_type(recv)) && global_written_once(recv)
    _ -> false

// The local a place bottoms out in, where it bottoms out in one at all -- the same descent
// `writable_place` makes, kept apart from it because the refusal wants the *binding*.
// The binding a place is a part of, where the walk out of it stays inside that binding's own
// storage.
//
// **A step that lands in storage the name does not own ends the walk**, and that is what makes
// "written once" a promise about the *name* rather than about everything it can reach. An index into
// an array is the local's own bytes and an index into a slice is a view of elements somebody else
// keeps -- so `val a: [4]u8` refuses `a[0] = 1` and a `val` holding a `[]u8` does not, the write
// there landing where the owner can see it. A field of a struct value is the local; a field reached
// through a `&T` is a field of the box.
//
// Getting it wrong the other way is what a `val` is *for*: `val s = S(1)` refuses `s.f = 3`, since
// nothing else holds that struct and the write would be a second writing of the binding.
private root_local(cx: &Analyzer, t: TExpr) -> Option[Local] = *t.kind match
    TLoad(name, _) -> local_named(cx, name)
    TField(recv, _, _) -> if holds_an_address(texpr_type(recv)) then None else root_local(cx, recv)
    TIndex(recv, _, _) -> if owns_its_elements(texpr_type(recv)) then root_local(cx, recv) else None
    _ -> None

// Whether a value of this type is an address of storage kept elsewhere -- a counted box, a weak
// reference, a raw pointer. A step through one leaves the binding behind.
private holds_an_address(t: Type) -> bool = repr(t) match
    Ref(_, _) -> true
    Weak(_) -> true
    Ptr(_) -> true
    _ -> false

// The `&sync` box an array lives inside, where a view of it would be a view into that box: the walk
// out of the array goes through fields and an array's own elements and stops at the first box it
// meets, which answers only when it is a `&sync` one. A view takes and gives back its share of the
// box the ordinary way while another domain changes the same count atomically, so such an array may
// be read by index or walked, never sliced (`reference/arrays.md § What is still refused`).
sync_box_around(base: TExpr) -> Option[Type]
    if !owns_its_elements(texpr_type(base)) then return None

    *base.kind match
        TField(recv, _, _) -> box_or_further(recv)
        TIndex(recv, _, _) -> if owns_its_elements(texpr_type(recv)) then box_or_further(recv) else None
        TDeref(operand, _) -> sync_box(texpr_type(operand))
        _ -> None
end sync_box_around

private box_or_further(recv: TExpr) -> Option[Type]
    val ty = texpr_type(recv)

    if holds_an_address(ty) then return sync_box(ty)

    *recv.kind match
        TField(inner, _, _) -> box_or_further(inner)
        TIndex(inner, _, _) -> if owns_its_elements(texpr_type(inner)) then box_or_further(inner) else None
        TDeref(operand, _) -> sync_box(texpr_type(operand))
        _ -> None
end box_or_further

private sync_box(t: Type) -> Option[Type] = repr(t) match
    Ref(_, sync) -> if sync then Some(t) else None
    _ -> None

// Whether this type's elements are its own storage, which an array's and a vector's are and a
// slice's are not.
private owns_its_elements(t: Type) -> bool = repr(t) match
    Array(_, _) -> true
    Vector(_, _) -> true
    _ -> false

private local_named(cx: &Analyzer, unique: string) -> Option[Local]
    for i in 0..<cx.locals.len()
        if cx.locals.at(i).unique == unique then return Some(cx.locals.at(i))

    None
end local_named

// -- what a live `ref` holds still ---------------------------------------------------------------
//
// A `ref` binds a name to a place, and this is a language with no collector: overwriting a `&T` or
// a view **releases** what it held, and that release may be the last. So while a `ref` is in scope
// the steps of its place that own what they point at are held still. **The discriminator is
// ownership rather than indirection**, which is what keeps the rule from being ruinous -- a `*T`
// step owns nothing, so a program reaching its tables through a `*Self` receiver has no hazard at
// all and is asked for nothing.

// The place a `ref` name stands for, asked by the unique name the typed tree loads it through.
ref_place(cx: &Analyzer, unique: string) -> Option[TExpr] = local_named(cx, unique) match
    Some(l) -> l.stands_for
    None -> None

// A place spelled as text, so two places can be compared for being the same storage.
//
// **An index is wildcarded**: `xs[i]` and `xs[j]` are one key, whether the two agree being a run-time
// question, and the answer that costs nothing being the conservative one -- an index that differs
// means the assignment lands elsewhere and would have been allowed, so this refuses a little more
// and never a little less. A `ref` name resolves to the place it stands for, so a guard built from
// one `ref` sees a second that reached the same storage by name. **A step is written after a `/`,
// which no name holds**, so one key being a prefix of another is a statement about whole steps.
private place_key(cx: &Analyzer, t: TExpr) -> Option[string] = *t.kind match
    TLoad(name, _) ->
        val through = ref_place(cx, name)
        val stood = if through.is_some() then place_key(cx, through.unwrap()) else None

        if stood.is_some() then stood else Some(name)
    TGlobal(symbol, _, _) -> Some(s"@$symbol")
    TDeref(operand, _) -> key_step(place_key(cx, operand), "*")
    TField(recv, index, _) -> key_step(place_key(cx, recv), s"$index")
    TIndex(recv, _, _) -> key_step(place_key(cx, recv), "[]")
    _ -> None

private key_step(base: Option[string], step: string) -> Option[string] = base match
    Some(k) -> Some(s"$k/$step")
    None -> None

// Whether overwriting a step of this type could free what it named. A `&T` releases the object it
// held; a view releases the buffer it owned, and nothing in the type says whether it owns one, so
// every view counts. A `*T` owns nothing and is deliberately absent.
private owning_step(t: Type) -> bool = t match
    Ref(_, _) -> true
    Slice(_, _) -> true
    Str -> true
    _ -> false

// The step a place was reached from, where it was reached from one.
private step_before(place: TExpr) -> Option[TExpr] = *place.kind match
    TField(recv, _, _) -> Some(recv)
    TIndex(recv, _, _) -> Some(recv)
    TDeref(operand, _) -> Some(operand)
    _ -> None

// The places a `ref` over `place` holds still: the **owning steps the path goes through**.
//
// *Owning*, because an assignment can only strand a `ref` by freeing the storage it stands in, and a
// value struct assigned in place keeps its address. *Through*, because what an assignment frees is
// what that step pointed **at**, so it holds the `ref` only when the path carried on past it. The
// place itself is therefore never in the set: `ref r = h.node` names the slot, so `r = other` and
// `h.node = other` are one statement written two ways and neither is refused.
private ref_hazards(cx: &Analyzer, place: TExpr) -> Buf[string]
    var out: Buf[string] = buf()
    var at = step_before(place)

    while at.is_some()
        val step = at.unwrap()

        if owning_step(texpr_type(step))
            val key = place_key(cx, step)

            if key.is_some() then out.push(key.unwrap())
        end if

        at = step_before(step)

    out
end ref_hazards

// Refuses an assignment that would move storage a live `ref` is standing on. **The message names
// the `ref`**, because the line being refused is ordinary code and what makes it a mistake is a
// binding somewhere above it. The nearest binding answers, and only one does.
private check_ref_guards(cx: &Analyzer, at: Span, target: TExpr)
    val key = place_key(cx, target)

    if key.is_none() then return

    var i = cx.locals.len()

    while i > 0
        i -= 1

        val l = cx.locals.at(i)

        if l.stands_for.is_some() && holds_string(ref_hazards(cx, l.stands_for.unwrap()), key.unwrap())
            cx.fault(at, s"'${l.name}' is a 'ref' standing on storage this assignment would " +
                     "release, so the name would be left pointing at freed memory. Write the " +
                     "assignment before the 'ref', or put the 'ref' in a block that closes first")
            return
        end if
end check_ref_guards

// The same refusal for the other way the storage can move: a method that may write the place from
// the inside.
//
// A `*self` receiver is the one place a callee is handed somewhere to write without an `&` in the
// caller's own source, so it is the one call that has to be asked about. **It is refused whether or
// not that method reassigns anything**: deciding otherwise means reading the body, and a module
// compiles against its imports' signatures and never their bodies. The receiver reaches a hazard
// when the hazard is the receiver or lies inside it -- `t.grow()` reaches `t.cell`.
check_ref_call(cx: &Analyzer, at: Span, place: TExpr)
    val key = place_key(cx, place)

    if key.is_none() then return

    val inside = s"${key.unwrap()}/"
    var i = cx.locals.len()

    while i > 0
        i -= 1

        val l = cx.locals.at(i)

        if l.stands_for.is_none() then continue

        val hazards = ref_hazards(cx, l.stands_for.unwrap())

        for j in 0..<hazards.len()
            if hazards.at(j) == key.unwrap() || hazards.at(j).starts_with(inside)
                cx.fault(at, s"'${l.name}' is a 'ref' standing on storage this call could " +
                         "release, since a '*self' method may write its receiver — so the name " +
                         "could be left pointing at freed memory. Make the call before the 'ref', " +
                         "or put the 'ref' in a block that closes first")
                return
            end if
end check_ref_call

// How a diagnostic names an assignment target.
describe_target(target: Expr) -> string = *target.kind match
    Ident(n) -> s"'$n'"
    Field(_, f) -> s"field '$f'"
    Unary(op, _) -> if op == "*" then "the place it points at" else "this place"
    Index(_, _) -> "this element"
    _ -> "this place"

// -- where a `?` stands ---------------------------------------------------------------------------

// Whether a `?` stands anywhere in a run of statements, which is what a `defer` refuses.
stmts_try(stmts: Buf[TStmt]) -> bool
    for i in 0..<stmts.len()
        if stmt_try(stmts.at(i)) then return true

    false
end stmts_try

private stmt_try(s: TStmt) -> bool = s match
    TVarDecl(_, _, init, _) -> expr_try(init)
    TExprStmt(e) -> expr_try(e)
    TInvariant(c, _) -> expr_try(c)
    TVariantCheck(_, _, e) -> expr_try(e)
    TRefDecl(_, _, place) -> expr_try(place)
    TWriteStmt(w) -> expr_try(w.place) || expr_try(w.value)
    TMultiAssign(ws) -> writes_try(ws)
    TReturn(v) -> if v.is_none() then false else expr_try(v.unwrap())
    TBecome(c) -> expr_try(c)
    TBreak(v, _) -> if v.is_none() then false else expr_try(v.unwrap())
    TContinue(_) -> false
    TDefer(inner) -> stmts_try(inner)
    TAsm(_, _, _) -> false

private writes_try(ws: Buf[TWrite]) -> bool
    for i in 0..<ws.len()
        if expr_try(ws.at(i).place) || expr_try(ws.at(i).value) then return true

    false
end writes_try

// Whether a `?` stands anywhere in a typed expression, which is what a `defer` refuses.
//
// The descent is over the forms that can hold one, which is every composite node: the operator can
// be at any depth of any expression.
expr_try(e: TExpr) -> bool = *e.kind match
    TTry(_, _, _, _, _, _, _) -> true
    TBox(v, _) -> expr_try(v)
    TDowngrade(v, _) -> expr_try(v)
    TUpgrade(v, _, _, _) -> expr_try(v)
    TArrayLit(xs, _) -> any_expr_try(xs)
    TArrayFill(v, _) -> expr_try(v)
    TVectorLit(xs, _) -> any_expr_try(xs)
    TSplat(v, _) -> expr_try(v)
    TLane(r, _, _) -> expr_try(r)
    TVecCompare(_, l, r, _) -> expr_try(l) || expr_try(r)
    TSelect(m, a, b, _) -> expr_try(m) || expr_try(a) || expr_try(b)
    TReduce(_, r, _) -> expr_try(r)
    TVecLoad(r, i, _) -> expr_try(r) || expr_try(i)
    TVecStore(r, i, v) -> expr_try(r) || expr_try(i) || expr_try(v)
    TBufLit(xs, _) -> any_expr_try(xs)
    TBufFill(v, n, _) -> expr_try(v) || expr_try(n)
    TIndex(r, i, _) -> expr_try(r) || expr_try(i)
    TLen(r, _) -> expr_try(r)
    TBytes(r) -> expr_try(r)
    TSlice(b, lo, hi, _, _) -> expr_try(b) || opt_expr_try(lo) || opt_expr_try(hi)
    TCast(v, _) -> expr_try(v)
    TConstrainedCheck(v, _) -> expr_try(v)
    TConstrainedValid(v, _) -> expr_try(v)
    TConstrainedStep(v, _, _, _) -> expr_try(v)
    TDeref(v, _) -> expr_try(v)
    TTypeId(r, _) -> expr_try(r)
    TAddrOf(p, _) -> expr_try(p)
    TTempAddr(v, _) -> expr_try(v)
    TStore(p, v, _) -> expr_try(p) || expr_try(v)
    TUpdate(p, _, v, _, _, _) -> expr_try(p) || expr_try(v)
    TIncDec(p, _, _, _, _) -> expr_try(p)
    TBinary(_, l, r, _) -> expr_try(l) || expr_try(r)
    TUnary(_, v, _) -> expr_try(v)
    TIntOp(_, v, a, _, _) -> expr_try(v) || opt_expr_try(a)
    TAtomic(_, a, xs, _, _, _) -> expr_try(a) || any_expr_try(xs)
    TLogical(_, l, r) -> expr_try(l) || expr_try(r)
    TCompare(xs, _) -> any_expr_try(xs)
    TSeq(xs) -> any_expr_try(xs)
    TStr(a) -> expr_try(a)
    TFromBytes(a) -> expr_try(a)
    TStrView(a) -> expr_try(a)
    TConstView(a) -> expr_try(a)
    TFormat(a, _) -> expr_try(a)
    TRender(v, _, s, _) -> expr_try(v) || expr_try(s)
    TCall(_, xs, _, _) -> any_expr_try(xs)
    TCallPtr(c, xs, _, _) -> expr_try(c) || any_expr_try(xs)
    TErase(v, _, _) -> expr_try(v)
    TVCall(r, _, xs, _, _) -> expr_try(r) || any_expr_try(xs)
    TVaStart(a) -> expr_try(a)
    TVaEnd(a) -> expr_try(a)
    TVaArg(a, _) -> expr_try(a)
    TVaCopy(d, s) -> expr_try(d) || expr_try(s)
    TVaPass(a) -> expr_try(a)
    TStructNew(_, xs) -> any_expr_try(xs)
    TStructInvCheck(v, _, _) -> expr_try(v)
    TRecheck(a, r, _, _) -> expr_try(a) || expr_try(r)
    TEnumNew(_, _, xs) -> any_expr_try(xs)
    TEnumFromInt(v, _) -> expr_try(v)
    TEnumTry(v, _, _, _, _) -> expr_try(v)
    TEnumAttr(_, _, a, _) -> expr_try(a)
    TField(r, _, _) -> expr_try(r)
    TIf(c, t, e, _) -> any_cond_try(c) || block_try(t) || opt_block_try(e)
    TMatch(s, arms, _) -> expr_try(s) || any_arm_try(arms)
    TBlockExpr(b) -> block_try(b)
    TWhile(c, body, e, _) -> any_cond_try(c) || stmts_try(body) || opt_block_try(e)
    TDoWhile(body, c, e, _) -> stmts_try(body) || expr_try(c) || opt_block_try(e)
    TLoop(body, _) -> stmts_try(body)
    TFor(_, _, lo, hi, _, body, e, _) ->
        expr_try(lo) || expr_try(hi) || stmts_try(body) || opt_block_try(e)
    TCFor(init, c, step, body, e, _) ->
        stmts_try(init) || opt_expr_try(c) || stmts_try(step) || stmts_try(body) || opt_block_try(e)
    TForEach(_, _, seq, body, e, _) -> expr_try(seq) || stmts_try(body) || opt_block_try(e)
    TIterate(_, _, init, next, _, body, e, _) ->
        expr_try(init) || expr_try(next) || stmts_try(body) || opt_block_try(e)
    TQuantifier(_, _, _, lo, hi, _, p) -> expr_try(lo) || expr_try(hi) || expr_try(p)
    TCheckedLoop(_, _, l) -> expr_try(l)
    _ -> false

private any_expr_try(xs: Buf[TExpr]) -> bool
    for i in 0..<xs.len()
        if expr_try(xs.at(i)) then return true

    false
end any_expr_try

private opt_expr_try(x: Option[TExpr]) -> bool = x.is_some() && expr_try(x.unwrap())

private block_try(b: TBlock) -> bool = stmts_try(b.stmts) || opt_expr_try(b.result)

private opt_block_try(b: Option[TBlock]) -> bool = b.is_some() && block_try(b.unwrap())

private any_cond_try(cs: Buf[TCondTerm]) -> bool
    for i in 0..<cs.len()
        cs.at(i) match
            TCondTest(c) -> if expr_try(c) then return true
            TCondIs(s, _, _) -> if expr_try(s) then return true

    false
end any_cond_try

private any_arm_try(arms: Buf[TArm]) -> bool
    for i in 0..<arms.len()
        if opt_expr_try(arms.at(i).guard) || block_try(arms.at(i).body) then return true

    false
end any_arm_try
