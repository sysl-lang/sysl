module sh.sysl.compiler
@tests

import sh.sysl.parsing.*
import sysl.text.{Search, from_utf8}

// A file with more than one mistake in it (the reference's ParseRecoveryTests), and string literals
// and text blocks end to end (StringLiteralTests, TextBlockTests): the bytes a constant is interned
// as, and what reaches stdout. Every message, column and printed output was read out of the reference
// compiler (0.0.162) over the same input.

// -- recovery --------------------------------------------------------------------------------------

@test("the leading diagnostic is the one the parser always gave, and recovery's sit below it")
prb_the_leading_diagnostic_is_the_grammars()
    val text = "print(1 2)\nprint(3 4)\n"

    assert_eq(pf_err(text), "')' expected")
    assert_eq(pf_at(text), "1:9")
    assert_eq(pf_line_text(text), "1 2")

@test("the same complaint reached by two roads is reported once")
prb_one_complaint_is_reported_once()
    assert_eq(pf_line_text("main()\n    print(1 2)\n"), "2")

@test("a block written as one of several alternatives parses as it always did")
prb_alternatives_parse_as_they_always_did()
    val text = "main()\n    if true then print(1) else print(2)\n"

    assert_eq(pf_line_text(text), "")
    assert_eq(pf(text), "(fn main () (if true (then (call print 1)) (else (call print 2))))")

@test("a lexical error is reported once, and recovery is not attempted through it")
prb_a_lexical_error_is_reported_once()
    assert_eq(pf_line_text("print(\"oops\nprint(1)\n"), "1")

@test("a recovered file is still refused by the entry point a build uses")
prb_a_recovered_file_is_still_refused()
    assert(!parse(source_of("t.sysl", "print(1 2)\nprint(3)\n")).ok(), "a build is refused")

@test("the diagnostics a build is given are the recovered ones, all of them")
prb_a_build_is_given_every_diagnostic()
    val said = parse_report(parse(source_of("t.sysl", "print(1 2)\nprint(3)\nprint(4 5)\n")))

    assert(said.contains("--> t.sysl:1:9"), said)
    assert(said.contains("--> t.sysl:3:"), said)
    assert(!said.contains("--> t.sysl:2:"), said)

// A statement that steps over the rest of its own line when it refuses it leaves the next line to be
// read, not skipped as well: the reference reports line 2 of each of these, and line 3's function
// beside a broken visibility bracket is not mistaken for a stray indented line.
@test("a line after one that skipped itself is read, not skipped a second time")
prb_a_line_after_a_self_skipped_one_is_read()
    assert_eq(pf_line_text("private impl Foo\nprint(1 2)\n"), "1 2")

    val two = parse_report(parse(source_of("t.sysl", "private[sysl.math] f() -> int = 1\nprint(1 2)\n")))

    assert(two.contains("--> t.sysl:1:13") && two.contains("--> t.sysl:2:9"), two)

    val one = parse_report(parse(source_of("t.sysl",
        "private[sysl.math] f() -> int = 1\n\nmain() -> unit\n    print(f())\n")))

    assert(one.contains("--> t.sysl:1:13") && !one.contains("\n\nerror: "), one)

@test("a mistake that leaves two complaints at one point is reported to a build once")
prb_one_point_is_reported_once()
    val said = parse_report(parse(source_of("t.sysl", "f() -> int = (1 +\n")))

    assert_eq(said, "error: expression expected\n --> t.sysl:2:1\n  |\n2 | \n  | ^")

// An annotation that is no annotation is refused where it is written, and that is the whole report:
// the declaration below it is not refused a second time on the next line, which nobody wrote one on.
@test("a refused annotation is told once, not again about the line under it")
prb_a_refused_annotation_is_told_once()
    val said = parse_report(parse(source_of("t.sysl",
        "o match\n    x -> @ Some(_) -> print(1)\n    None -> print(0)\n")))

    assert(said.contains("'Some' is not an annotation a declaration takes"), said)
    assert(!said.contains("--> t.sysl:3:"), said)

// -- string literals -------------------------------------------------------------------------------

// A source file is UTF-8, where a surrogate with no partner is ill-formed, so the bytes the
// reference's UTF-16 source holds as one never become source text here: they are refused before a
// lexer could read a character out of them.
@test("a surrogate with no partner is not a character")
prb_an_unpaired_surrogate_is_not_a_character()
    var lead: [6]u8 = [39, 0xED, 0xA0, 0x80, 97, 39]
    var trail: [5]u8 = [34, 0xED, 0xB0, 0x80, 34]

    assert(from_utf8(lead[0..<6]).is_err(), "a lone lead surrogate is not text")
    assert(from_utf8(trail[0..<5]).is_err(), "a lone trail surrogate is not text")

@test("the interned constant escapes the bytes a textual module cannot hold literally")
prb_the_interned_constant_escapes_bytes()
    if xvr_no_library() then return

    val out = xvr_ir([("main.sysl", "print(\"a\\\"b\\\\c\\n\")\n")])

    assert(out.contains("c\"a\\22b\\5Cc\\0A\\00\""), out)

@test("the interned constant counts UTF-8 bytes, not characters, plus the terminator")
prb_the_interned_constant_counts_bytes()
    if xvr_no_library() then return

    assert(xvr_ir([("main.sysl", "print(\"é\")\n")]).contains("[3 x i8] c\"\\C3\\A9\\00\""), "é")
    assert(xvr_ir([("main.sysl", "print(\"😀\")\n")]).contains("[5 x i8]"), "a supplementary character")

@test("escapes survive to the output")
prb_escapes_survive_to_the_output()
    if !enm_ready() then return

    assert_eq(enm_ran("print(\"a\\tb\")\n"), "a\tb\n")
    assert_eq(enm_ran("print(\"quote:\\\"\", \"back:\\\\\")\n"), "quote:\" back:\\\n")
    assert_eq(enm_ran("print(\"a\\bb\\fc\")\n"), "a\u{8}b\u{c}c\n")

@test("non-ASCII text round-trips as UTF-8")
prb_non_ascii_round_trips()
    if !enm_ready() then return

    assert_eq(enm_ran("print(\"héllo ☃ 😀\")\n"), "héllo ☃ 😀\n")

@test("an empty string prints as nothing between its neighbours")
prb_an_empty_string_prints_as_nothing()
    if !enm_ready() then return

    assert_eq(enm_ran("print(\"a\", \"\", \"b\")\n"), "a  b\n")

@test("a string built from a char is the same bytes either way")
prb_a_char_and_a_string_print_alike()
    if !enm_ready() then return

    assert_eq(enm_ran("print('☃', \"☃\")\n"), "☃ ☃\n")

@test("a NUL inside a string is an ordinary byte")
prb_a_nul_is_an_ordinary_byte()
    if !enm_ready() then return

    assert_eq(enm_ran("print(\"a\\0b\", \"end\")\n"), "a\0b end\n")

// -- text blocks -----------------------------------------------------------------------------------

@test("a joined block is one constant, not a concatenation")
prb_a_joined_block_is_one_constant()
    if xvr_no_library() then return

    val out = xvr_ir([("main.sysl", s"var s = ${Q}\n    ab\\\n    cd\n    ${Q}\nprint(s)\n")])

    assert(out.contains("abcd"), out)
    assert(!out.contains("concat"), out)

@test("the code around a block indents normally")
prb_the_code_around_a_block_indents_normally()
    if !enm_ready() then return

    assert_eq(enm_ran(s"var n = 0usize\nfor i in 0..<2\n    var s = ${Q}\n        ab\n        ${Q}\n" +
        "    n += s.len\nprint(n)\n"), "6\n")

@test("a block may initialize a const")
prb_a_block_may_initialize_a_const()
    if !enm_ready() then return

    assert_eq(enm_ran(s"const S: string = ${Q}\n    ab\n    ${Q}\nprint(S.len)\n"), "3\n")

@test("a val takes a block exactly as it takes a one-line string")
prb_a_val_takes_a_block()
    if !enm_ready() then return

    assert_eq(enm_ran("val S: string = \"ab\"\nprint(S.len)\n"), "2\n")
    assert_eq(enm_ran(s"val S: string = ${Q}\n    ab\n    ${Q}\nprint(S.len)\n"), "3\n")

@test("a block is a match pattern")
prb_a_block_is_a_match_pattern()
    if !enm_ready() then return

    assert_eq(enm_ran(s"kind(s: string) -> int = s match\n    ${Q}\n        ab\n        ${Q} -> 1\n" +
        "    else 2\nprint(kind(\"ab\\n\"), kind(\"zz\"))\n"), "1 2\n")

@test("a block sits mid-expression")
prb_a_block_sits_mid_expression()
    if !enm_ready() then return

    assert_eq(enm_ran(s"print(\"x\" + ${Q}\n    y\n    ${Q} + \"z\")\n"), "xy\nz\n")
