// A deferred statement that reads a local declared AFTER it. Under today's order the local is alive
// when the defer runs; under an interleaved order the local is declared after the defer, so it is
// released first — the defer could not name it. The probe asks whether naming it is legal today.
struct Noisy
    name: string

impl Drop for Noisy
    drop(self) = print("drop " + self.name)

run()
    var late: Option[&Noisy] = None
    defer print("defer sees " + (late match
        Some(n) -> n.name
        None -> "nothing"))
    val b: &Noisy = Noisy("b")

    late = Some(Noisy("late"))
    print("body " + b.name)

run()
