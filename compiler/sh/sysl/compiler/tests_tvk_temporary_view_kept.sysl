module sh.sysl.compiler
@tests

import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture
import sysl.text.Search

// A view of a TEMPORARY array kept past the statement that made it (`reference/memory.md § A view of
// a temporary is used where it is made`). The temporary is freed at the end of its statement -- what
// it holds is let go of, and its slot is reused by the next round of a loop -- so a view of it kept
// in a local would read dead storage. That is refused at the view, naming the local. A view used
// within its own statement, a view of a named array, and a view that leaves the frame (promoted,
// `tests_ptp_promoted_temporary.sysl`) are all untouched.

// What a program does: what it printed and the status it exited with. A failure to build is its
// message and `-1`, which no program exits with.
private tvk_outcome(text: string) -> (string, int)
    val root = make_temp_dir("sysl-tvk").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", text).unwrap()

    val exe = s"$root/built"

    build_native_program(root, None, None, DefaultOptimization, Some(exe)) match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return (failure_text(why), -1)
        Ok(_) -> ()

    val said = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    said match
        Err(_) -> ("the program that was built could not be run", -1)
        Ok(out) -> (out.text + out.err.unwrap_or(""), shell_status(out.status))
end tvk_outcome

private tvk_prints(text: string, want: string)
    if xvr_no_library() then return

    val out = tvk_outcome(text)

    assert_eq(out.0, want)
    assert_eq(out.1, 0)
end tvk_prints

private tvk_refused(text: string, part: string)
    if xvr_no_library() then return

    val out = tvk_outcome(text)

    assert_eq(out.1, -1)
    assert(out.0.contains(part), out.0)
end tvk_refused

private tvk_tail() -> string =
    "but the array is a temporary, freed at the end of this statement, so the view would outlive " +
    "it. Bind the array to a name of its own and view that"

// -- kept past its statement: refused ------------------------------------------------------------------

// The element is a counted string the statement let go of, so the view read an empty string.
@test("a view of a literal kept through a call's answer is refused, naming the local")
tvk_kept_through_a_call_is_refused() =
    tvk_refused(raw"""
        id(xs: []string) -> []string = xs

        val s = id([str(7) + "y"][..])

        print(s[0])
        """, s"a view of an array literal is kept in 's', ${tvk_tail()}")

@test("and the caret is on the view's own bracket")
tvk_the_caret_is_on_the_bracket() =
    tvk_refused(raw"""
        id(xs: []string) -> []string = xs

        val s = id([str(7) + "y"][..])

        print(s[0])
        """, "main.sysl:3:26")

// Every round is the same statement again, so the slot the first round's view names held the last
// round's value: the program printed 20.
@test("a view kept from one round of a loop to after it is refused")
tvk_kept_across_a_loop_is_refused() =
    tvk_refused(raw"""
        first() -> int
            var keep: []int = []

            for i in 0..<3
                if i == 0 then keep = [i * 10][..]

            keep[0]

        print(first())
        """, s"a view of an array literal is kept in 'keep', ${tvk_tail()}")

@test("a view bound in a loop's body is refused the same")
tvk_bound_in_a_loop_is_refused() =
    tvk_refused(raw"""
        first() -> int
            var keep: []int = []

            for i in 0..<3
                val v = [i * 10][..]

                if i == 0 then keep = v

            keep[0]

        print(first())
        """, s"a view of an array literal is kept in 'v', ${tvk_tail()}")

@test("a view kept out of a nested block is refused")
tvk_kept_out_of_a_nested_block_is_refused() =
    tvk_refused(raw"""
        pick(c: bool) -> int
            var keep: []int = []

            if c
                keep = [5, 6][..]

            keep.len

        print(pick(true))
        """, s"a view of an array literal is kept in 'keep', ${tvk_tail()}")

@test("a view that is the value of an 'if' is kept by the local it is bound to")
tvk_an_if_value_is_refused() =
    tvk_refused(raw"""
        pick(c: bool) -> int
            val v = if c then [1][..] else [2, 3][..]

            v.len

        print(pick(true))
        """, s"a view of an array literal is kept in 'v', ${tvk_tail()}")

@test("a call's answer is the same temporary, and is named for the call")
tvk_a_call_result_kept_is_refused() =
    tvk_refused(raw"""
        triple(n: int) -> [3]int = [n, n + 1, n + 2]

        val t = triple(7)[..]

        print(t[0])
        """, s"a view of the array 'triple' answered with is kept in 't', ${tvk_tail()}")

@test("a view kept in a local that is then returned is refused rather than promoted")
tvk_kept_then_returned_is_refused() =
    tvk_refused(raw"""
        make() -> []int
            val v = [1, 2, 3][..]

            v

        print(make()[2])
        """, s"a view of an array literal is kept in 'v', ${tvk_tail()}")

// -- used where it is made: untouched ------------------------------------------------------------------

@test("a view used within its own statement still compiles and reads what was written")
tvk_used_in_its_statement_works() =
    tvk_prints(raw"""
        id(xs: []string) -> []string = xs

        count(xs: []const int) -> usize = xs.len

        print(id([str(7) + "y"][..])[0], count([1, 2, 3][..]))

        for i in 0..<3
            print(id([str(i * 10)][..])[0])
        """, "7y 3\n0\n10\n20\n")

@test("a view of a named array is untouched")
tvk_a_named_array_is_untouched() =
    tvk_prints(raw"""
        val a = [1, 2, 3]
        val v = a[..]

        var b = [str(4) + "x"]
        val w = b[..]

        print(v[2], w[0])
        """, "3 4x\n")

@test("a view of a literal that leaves the frame is still promoted")
tvk_an_escaping_view_is_still_promoted() =
    tvk_prints(raw"""
        make() -> []string = [str(8) + "z", "b"][..]

        static var kept: []string = []

        fill()
            kept = [str(7) + "y"][..]

        fill()

        val m = make()

        print(kept[0], m[0], m[1])
        """, "7y 8z b\n")

@test("a local holding a view of a temporary that was given storage of its own is untouched")
tvk_a_local_given_an_escaped_view_is_untouched() =
    tvk_prints(raw"""
        make() -> []int = [1, 2, 3][..]

        val v = make()

        print(v[2])
        """, "3\n")
