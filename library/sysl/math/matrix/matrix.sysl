module sysl.math.matrix

import sysl.buf.{Buf, buf}

/** Matrices over any `Scalar`, and the two products whose results are different types.
 *
 * `A * v` gives a vector and `A * B` gives a matrix, so one type carries three implementations of one
 * trait: `Mul[Vector[T], Vector[T]]`, `Mul` and `Mul[T]`. Each is selected by the type of the right
 * operand, and each declares what it hands back. Nothing here is a method that wanted to be an
 * operator.
 *
 * **The matrix product is the defaulted one**, written `impl[T: Scalar] Mul for Matrix[T]`: its
 * operand and its result are both `Self`, which is what the trait's own defaults already say. Writing
 * `Mul[Matrix[T], Matrix[T]]` would say the same thing twice, and a reader would be entitled to look
 * for a difference that is not there.
 *
 * The cells are stored row-major in one `&Buf[T]`, so a matrix is a handle exactly as a vector is:
 * the operators build fresh matrices and `copy` is how a caller stops sharing.
 */
struct Matrix[T: Scalar]
    rows: int
    cols: int
    cells: &Buf[T]

    // --- The matrices that need no receiver, reached through the type. ---

    zeros(rows: int, cols: int) -> Matrix[T]
        var cells: Buf[T] = buf()

        for i in 0..<rows * cols do cells.push(T.zero())

        Matrix(rows, cols, cells)
    end zeros

    /** A matrix from the numbers a program wrote, read row by row. */
    of(rows: int, cols: int, xs: []const T) -> Matrix[T]
        require int(xs.len) == rows * cols, "a matrix needs exactly rows * cols cells"

        var out: Matrix[T] = Matrix.zeros(rows, cols)

        for i in 0..<rows
            for j in 0..<cols do out.set(i, j, xs[i * cols + j])

        out
    end of

    /** The identity, which needs both of the element type's identities -- a zero everywhere and a one
     * down the diagonal -- and is where the pair of core traits earns its second member.
     */
    identity(n: int) -> Matrix[T]
        var out: Matrix[T] = Matrix.zeros(n, n)

        for i in 0..<n do out.set(i, i, T.one())

        out
    end identity

    // --- What a matrix is, read off it. ---

    at(self, i: int, j: int) -> T = self.cells.at(usize(i * self.cols + j))

    set(*self, i: int, j: int, v: T) = self.cells.set(usize(i * self.cols + j), v)

    is_square(self) -> bool = self.rows == self.cols

    row(self, i: int) -> Vector[T]
        var out: Vector[T] = Vector.zeros(self.cols)

        for j in 0..<self.cols do out.set(j, self.at(i, j))

        out

    col(self, j: int) -> Vector[T]
        var out: Vector[T] = Vector.zeros(self.rows)

        for i in 0..<self.rows do out.set(i, self.at(i, j))

        out

    /** The sum of the diagonal, which needs no elimination and no invertibility. It is the other
     * similarity invariant beside the determinant: `trace(AB)` and `trace(BA)` agree even where the
     * products themselves do not.
     */
    trace(self) -> T
        require self.is_square(), "a trace needs a square matrix"

        var total = T.zero()

        for i in 0..<self.rows do total += self.at(i, i)

        total
    end trace

    copy(self) -> Matrix[T]
        var out: Matrix[T] = Matrix.zeros(self.rows, self.cols)

        for i in 0..<self.rows
            for j in 0..<self.cols do out.set(i, j, self.at(i, j))

        out
    end copy

    transpose(self) -> Matrix[T]
        var out: Matrix[T] = Matrix.zeros(self.cols, self.rows)

        for i in 0..<self.rows
            for j in 0..<self.cols do out.set(j, i, self.at(i, j))

        out
    end transpose

    /** Exchanging two rows in place -- what a pivot search does, and the one operation on a matrix
     * that is not a fresh value.
     */
    swap_rows(*self, a: int, b: int)
        if a == b then return

        for j in 0..<self.cols
            var t = self.at(a, j)

            self.set(a, j, self.at(b, j))
            self.set(b, j, t)
    end swap_rows

    /** Agreement to within a tolerance, for the same reason `Vector.near` exists: `==` is exact and
     * floating point almost never wants it.
     */
    near(self, rhs: Matrix[T], tol: real) -> bool
        if self.rows != rhs.rows || self.cols != rhs.cols then return false

        for i in 0..<self.rows
            for j in 0..<self.cols
                if (self.at(i, j) - rhs.at(i, j)).norm() > tol then return false

        true
    end near
end Matrix

impl[T: Scalar] Eq for Matrix[T]
    eq(self, rhs: Matrix[T]) -> bool
        if self.rows != rhs.rows || self.cols != rhs.cols then return false

        for i in 0..<self.rows
            for j in 0..<self.cols
                if self.at(i, j) != rhs.at(i, j) then return false

        true
    end eq

/** Rows separated by `; `, each written in the form a vector is written in -- so a matrix prints as
 * `(1, 2); (3, 4)` and the two types read alike.
 *
 * **It walks the cells rather than calling `row`, and that is the point rather than an
 * optimization.** `row(i)` builds a fresh `Vector[T]` over a fresh `Buf`, so rendering through it
 * would allocate one vector per row for no reason but to print it -- which is the cost this shape
 * exists to remove. What it buys instead is a duplicated six lines, and `MatrixTests` pins a matrix
 * against its own rows so the two spellings cannot drift apart.
 */
private render_matrix[T: Scalar](m: Matrix[T], out: *Writer, parts: FormatSpec)
    for i in 0..<m.rows
        if i > 0 then out.write("; ".bytes)

        out.write("(".bytes)

        for j in 0..<m.cols
            if j > 0 then out.write(", ".bytes)

            m.at(i, j).display(out, parts)

        out.write(")".bytes)
end render_matrix

/** `(1, 2); (3, 4)` -- the rows, each in the form `Vector[T]` renders in.
 *
 * The width belongs to the whole matrix and the precision reaches the cells, exactly as it does for a
 * vector and for `Complex[F]`; and it is measured into a `Counting` sink rather than gathered, so an
 * ordinary print allocates nothing.
 */
impl[T: Scalar] Display for Matrix[T]
    display(self, out: *Writer, fmt: FormatSpec)
        val parts = FormatSpec(0, fmt.prec, false)
        var pad = 0

        if fmt.width > 0
            var count = Counting(0)
            var sink: *Writer = &count

            render_matrix(self, sink, parts)
            pad = fmt.width - int(count.n)

            if pad < 0 then pad = 0

        if !fmt.left then display_fill(out, 32, pad)

        render_matrix(self, out, parts)

        if fmt.left then display_fill(out, 32, pad)
    end display

impl[T: Scalar] Add for Matrix[T]
    add(self, rhs: Matrix[T]) -> Matrix[T]
        require self.rows == rhs.rows && self.cols == rhs.cols, "matrices added must have the same shape"

        var out: Matrix[T] = Matrix.zeros(self.rows, self.cols)

        for i in 0..<self.rows
            for j in 0..<self.cols do out.set(i, j, self.at(i, j) + rhs.at(i, j))

        out
    end add

impl[T: Scalar] Sub for Matrix[T]
    sub(self, rhs: Matrix[T]) -> Matrix[T]
        require self.rows == rhs.rows && self.cols == rhs.cols, "matrices subtracted must have the same shape"

        var out: Matrix[T] = Matrix.zeros(self.rows, self.cols)

        for i in 0..<self.rows
            for j in 0..<self.cols do out.set(i, j, self.at(i, j) - rhs.at(i, j))

        out
    end sub

impl[T: Scalar] Neg for Matrix[T]
    neg(self) -> Matrix[T]
        var out: Matrix[T] = Matrix.zeros(self.rows, self.cols)

        for i in 0..<self.rows
            for j in 0..<self.cols do out.set(i, j, -self.at(i, j))

        out
    end neg

/** A matrix applied to a vector: the result is a **vector**, which is neither operand's type. Written
 * as `self.row(i) * rhs`, so the dot product in `vector.sysl` is what computes each component -- one
 * operator whose result is a scalar, inside one whose result is a vector.
 */
impl[T: Scalar] Mul[Vector[T], Vector[T]] for Matrix[T]
    mul(self, rhs: Vector[T]) -> Vector[T]
        require self.cols == rhs.n, "a matrix applied to a vector needs as many columns as it has entries"

        var out: Vector[T] = Vector.zeros(self.rows)

        for i in 0..<self.rows do out.set(i, self.row(i) * rhs)

        out
    end mul

/** The one implementation here that writes no trait arguments at all, because the trait's defaults
 * already say what it does: a matrix times a matrix is a matrix.
 */
impl[T: Scalar] Mul for Matrix[T]
    mul(self, rhs: Matrix[T]) -> Matrix[T]
        require self.cols == rhs.rows, "a product needs the left columns to match the right rows"

        var out: Matrix[T] = Matrix.zeros(self.rows, rhs.cols)

        for i in 0..<self.rows
            var r = self.row(i)

            for j in 0..<rhs.cols do out.set(i, j, r * rhs.col(j))

        out
    end mul

impl[T: Scalar] Mul[T] for Matrix[T]
    mul(self, k: T) -> Matrix[T]
        var out: Matrix[T] = Matrix.zeros(self.rows, self.cols)

        for i in 0..<self.rows
            for j in 0..<self.cols do out.set(i, j, self.at(i, j) * k)

        out
    end mul

/** A pair as the index: a subscript takes one argument and a matrix wants two, so the one argument is
 * a pair.
 */
impl[T: Scalar] Index[(int, int), T] for Matrix[T]
    index(self, ij: (int, int)) -> T = self.at(ij.0, ij.1)

impl[T: Scalar] IndexSet[(int, int), T] for Matrix[T]
    index_set(*self, ij: (int, int), v: T) = self.set(ij.0, ij.1, v)
