module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.process.{capture, run, Status}
import sysl.fs.{remove_file, write_text, is_file, is_dir, entries}
import sysl.text.{split, repeat}
import sysl.env.{get as env_var}

// **The C toolchain a build drives**: which clang, what it is handed, and what comes back.
//
// Emission ends at LLVM text. Turning that text into something the machine will run is somebody
// else's program, and the whole of what is decided here is *which* program and *what is on its
// command line* -- the two things a cross build gets wrong silently.

// The optimization level a build passes when nothing said otherwise.
val DefaultOptimization: string = "1"

// What a processor's back end is registered under, which is the name `-print-targets` prints and
// **not** the name a source file writes: LLVM spells the 64-bit x86 back end `x86-64` where a
// source file says `x86_64`.
cpu_backend(cpu: Cpu) -> string = cpu match
    Aarch64 -> "aarch64"
    X86_64 -> "x86-64"
    Riscv64 -> "riscv64"
    Riscv32 -> "riscv32"
    Thumb -> "thumb"
    Wasm32 -> "wasm32"
    X86 -> "x86"
    // Registered by an **out-of-tree** back end rather than by any clang somebody installs, so this
    // is the one name the search never goes looking for.
    Craft -> "craft"

// Where a clang is looked for, in order.
//
// The PATH first, since a toolchain installed to be used is on it. Then the places a package manager
// puts an LLVM that it deliberately keeps *off* the PATH -- Homebrew does this so that its clang does
// not shadow the system's.
private clang_candidates() -> Buf[string]
    var out: Buf[string] = buf()

    out.push("clang")
    out.push("/opt/homebrew/opt/llvm/bin/clang")
    out.push("/usr/local/opt/llvm/bin/clang")
    out
end clang_candidates

// Whether a `clang` capable of consuming textual LLVM IR is on the PATH. Tests that link and run
// gate on this so they skip cleanly on a machine without a toolchain.
clang_available() -> bool = clang_runs("clang")

private clang_runs(path: string) -> bool
    capture(path, ["--version"], "", [], true) match
        Err(_) -> false
        Ok(out) -> out.status.ok()
end clang_runs

// The back ends a clang has, as `-print-targets` lists them -- or nothing at all where it cannot be
// run, which the caller tells apart by there being no candidate that answers.
//
// Each line is `    name  - Description`, and the name is the first word.
clang_backends(path: string) -> Buf[string]
    var out: Buf[string] = buf()

    capture(path, ["-print-targets"], "", [], true) match
        Err(_) -> return out
        Ok(got) ->
            if !got.status.ok() then return out

            val lines = lines_of(got.text)

            for i in 0..<lines.len()
                val word = first_word(lines.at(i))

                if word != "" then out.push(word)

    out
end clang_backends

private first_word(line: string) -> string
    var start: usize = 0

    while start < line.bytes.len && is_space_byte(line.bytes[start])
        start += 1

    var at = start

    while at < line.bytes.len && !is_space_byte(line.bytes[at])
        at += 1

    line[start..<at]
end first_word

private is_space_byte(b: u8) -> bool = b == u8(' ') || b == u8('\t') || b == u8('\r')

// The clang to **build** for a machine with, or the sentence saying why there is none.
//
// **The PATH's clang is preferred and is nearly always the answer** -- a host build must not quietly
// change compiler because some other LLVM happens to be installed. What sends the search further is
// a target the PATH clang has no back end for, which on a Mac is every RISC-V one: a vendor's clang
// is trimmed to that vendor's processors, so it can parse `-target riscv32-unknown-elf` and then
// fail to produce an object for it. That failure is not a compiler bug and reads exactly like one.
//
// A **named** one is not searched past and not fallen back from: a person who wrote down which
// compiler to use is owed an error rather than a different one.
find_clang(target: Target, named: Option[string]) -> Result[string, string]
    val want = cpu_backend(target.cpu)

    named match
        Some(path) ->
            if !clang_runs(path)
                return Err(s"cannot run '$path' — --cc names the clang to build with")

            if !holds_string(clang_backends(path), want)
                return Err(s"'$path' has no '$want' back end, so it cannot build for " +
                           s"'${target.name}' — it registers ${shown_backends(path)}")

            return Ok(path)
        None -> ()

    // **Two machines are not served by a clang picked for its back end**, and both fail at the first
    // `#include` rather than at the search: an NDK carries Bionic's headers and a wasi-sdk carries
    // wasi-libc's, and no clang outside those downloads has either. So the environment is asked, and
    // where it says nothing this refuses with the variable to set rather than handing back a compiler
    // that will get further and fail worse.
    target.os match
        Android -> return android_clang()
        Wasi -> return wasi_clang()
        _ -> ()

    val candidates = clang_candidates()

    for i in 0..<candidates.len()
        val p = candidates.at(i)

        if clang_runs(p) && holds_string(clang_backends(p), want) then return Ok(p)

    for i in 0..<candidates.len()
        val p = candidates.at(i)

        if clang_runs(p)
            return Err(s"no clang here has the '$want' back end that '${target.name}' needs. " +
                       s"'$p' registers ${shown_backends(p)} — a vendor's clang is often trimmed " +
                       "to that vendor's processors. Install LLVM ('brew install llvm'), or name " +
                       "one with --cc")

    Err("cannot find clang, which building needs — install LLVM, or name one with --cc")
end find_clang

// wasi-sdk's clang, found from the environment, or the sentence saying what to set.
//
// **Its clang self-resolves the sysroot for a `wasm32-wasip1` triple** -- a `clang.cfg` beside the
// binary points at `share/wasi-sysroot` -- so naming the binary is the whole of it and there is no
// `--sysroot` for a build to pass.
private wasi_clang() -> Result[string, string]
    val found = wasi_clang_in(env_var("WASI_SDK_PATH"))?

    if !clang_runs(found)
        return Err(s"cannot run '$found', which is wasi-sdk's clang")

    Ok(found)
end wasi_clang

// The path resolution behind `wasi_clang`, **taking its directory rather than reading it**, so that
// what it decides can be asserted on a machine with no wasi-sdk on it.
wasi_clang_in(sdk_root: Option[string]) -> Result[string, string]
    val sdk = sdk_root match
        None -> return Err("building for WASI needs wasi-sdk's own clang, and nothing here says " +
                           "where it is — a clang picked for having the wasm32 back end carries no " +
                           "sysroot, so it fails at the first '#include'. Set WASI_SDK_PATH to the " +
                           "directory holding 'bin/clang' (github.com/WebAssembly/wasi-sdk/releases)")
        Some(dir) -> dir

    val cc = s"$sdk/bin/clang"

    // **The path rather than the variable**: what somebody set is in the message, so a WASI_SDK_PATH
    // pointing one directory too high or too low is visible rather than described.
    if !is_file(cc)
        return Err(s"'$sdk' holds no 'bin/clang' — WASI_SDK_PATH names the wasi-sdk directory " +
                   "itself, the one with 'bin' and 'share' in it")

    Ok(cc)
end wasi_clang_in

// The NDK's clang, found from the environment, or the sentence saying what to set.
//
// `ANDROID_NDK_ROOT`/`ANDROID_NDK_HOME` name an NDK outright and win, which is what a standalone
// install has. Otherwise the SDK is named and the newest `ndk/<version>` under it is taken.
private android_clang() -> Result[string, string]
    val ndk = env_var("ANDROID_NDK_ROOT") match
        Some(d) -> Some(d)
        None -> env_var("ANDROID_NDK_HOME")

    val sdk = env_var("ANDROID_HOME") match
        Some(d) -> Some(d)
        None -> env_var("ANDROID_SDK_ROOT")

    val found = android_clang_in(ndk, sdk)?

    if !clang_runs(found)
        return Err(s"cannot run '$found', which is the NDK's clang")

    Ok(found)
end android_clang

// The path resolution behind `android_clang`, taking its two directories rather than reading them,
// so that what it decides can be asserted on a machine with no NDK on it.
//
// **`ANDROID_HOME` is the SDK's current name and `ANDROID_SDK_ROOT` is DEPRECATED, so the first is
// what the refusal tells anybody to set.** Both are read -- see `android_clang` -- so a machine
// already set up either way goes on working, and only the advice is opinionated.
android_clang_in(ndk_root: Option[string], sdk_root: Option[string]) -> Result[string, string]
    ndk_root match
        Some(ndk) -> return clang_under_ndk(ndk)
        None -> ()

    val sdk = sdk_root match
        None -> return Err("building for Android needs the NDK's own clang, and nothing here says " +
                           "where it is — no clang outside the NDK carries Bionic's headers, so one " +
                           "picked for having the back end fails at the first '#include'. Set " +
                           "ANDROID_HOME to the Android SDK (the directory holding 'ndk/'), or " +
                           "ANDROID_NDK_ROOT to one NDK directly")
        Some(dir) -> dir

    val installed = s"$sdk/ndk"

    // **The path and not the variable, because two spellings reach here** and this cannot tell which
    // one was set. Naming `ANDROID_SDK_ROOT` at somebody who set `ANDROID_HOME` sends them to look at
    // a variable that is empty and correct.
    if !is_dir(installed)
        return Err(s"the Android SDK at '$sdk' holds no 'ndk' directory — the NDK is a separate " +
                   "download, installed from Android Studio's SDK Manager under SDK Tools as " +
                   "'NDK (Side by side)'")

    val names = entries(installed) match
        Ok(ns) -> ns
        Err(_) -> buf()

    // Several may be installed side by side, which is what the directory is named for, and the newest
    // is the one to take. Compared on the version read as **numbers** -- `9.x` sorts above `30.x` as
    // text, which is the whole reason this is not a plain sort of the names.
    var newest = ""
    var best = ""

    for i in 0..<names.len()
        val name = names.at(i)
        val key = version_key(name)

        if is_dir(s"$installed/$name") && (newest == "" || key > best)
            newest = name
            best = key

    if newest == ""
        return Err(s"'$installed' holds no NDK — the directory is there and empty, so an install " +
                   "was started and did not finish")

    clang_under_ndk(s"$installed/$newest")
end android_clang_in

// The clang inside one NDK, or why that directory is not one.
//
// **The host directory is LISTED rather than composed, and that is not laziness.** It is named for the
// platform the toolchain was *built* for, which on an Apple Silicon Mac is still `darwin-x86_64` --
// the clang inside is a universal binary with a real arm64 slice and runs natively, and the path has
// simply never been renamed. Anything spelling that directory from the host's own architecture finds
// nothing on the machine it most needs to work on.
private clang_under_ndk(ndk: string) -> Result[string, string]
    val prebuilt = s"$ndk/toolchains/llvm/prebuilt"

    if !is_dir(prebuilt)
        return Err(s"'$ndk' is not an Android NDK — it has no 'toolchains/llvm/prebuilt' in it")

    val hosts = entries(prebuilt) match
        Ok(ns) -> sort_names(ns)
        Err(_) -> buf()

    if hosts.len() == 0
        return Err(s"'$prebuilt' holds no toolchain for any host")

    val cc = s"$prebuilt/${hosts.at(0)}/bin/clang"

    if !is_file(cc)
        return Err(s"'$ndk' has no clang at '$cc'")

    Ok(cc)
end clang_under_ndk

// A dotted version as something sortable, each numeric part widened so that the comparison is by
// value rather than by first digit. A part that is not a number is left as it is, which puts it after
// every number rather than failing.
private version_key(name: string) -> string
    val parts = split(name, ".")
    var out = ""

    for i in 0..<parts.len
        val part = parts[i]
        val n = part.bytes.len

        if i > 0 then out += "."

        if n > 0 && n < 12 && all_digits(part)
            out += repeat("0", 12 - n)

        out += part

    out
end version_key

private all_digits(part: string) -> bool
    for i in 0..<part.bytes.len
        val b = part.bytes[i]

        if b < u8('0') || b > u8('9') then return false

    true
end all_digits

private shown_backends(path: string) -> string
    val bs = sort_names(clang_backends(path))

    if bs.is_empty() then return "none"

    var out = ""

    for i in 0..<bs.len()
        out = if i == 0 then bs.at(i) else s"$out, ${bs.at(i)}"

    out
end shown_backends

// Extra flags spliced into every clang the build drives, read from `SYSL_EXTRA_CFLAGS`.
//
// **A build sysl drives is several clang invocations** -- the module's IR, each C file a package
// carries, and the link -- so a flag that has to be on all of them cannot be passed to one of them
// by hand. `-fsanitize=address` is the case this exists for: given to the link alone it brings in a
// runtime that instruments nothing, and given to a C file alone it instruments the binding and not
// the program.
//
// It is an environment variable rather than an option because it is a *developer's* seam -- a way to
// reach the toolchain sysl is already driving -- and not a thing a project should be able to write
// down. Nothing here validates it: whatever it says goes to clang, and clang answers for it.
extra_cflags() -> Buf[string]
    var out: Buf[string] = buf()

    env_var("SYSL_EXTRA_CFLAGS") match
        None -> return out
        Some(text) ->
            val words = split_on_space(text)

            for i in 0..<words.len()
                if words.at(i) != "" then out.push(words.at(i))

    out
end extra_cflags

private split_on_space(text: string) -> Buf[string]
    var out: Buf[string] = buf()
    var start: usize = 0

    for i in 0..<text.bytes.len
        if text.bytes[i] == u8(' ')
            out.push(text[start..<i])
            start = i + 1

    out.push(text[start..<text.bytes.len])
    out
end split_on_space

// The flag a level is passed as. A level is whatever was written -- `0`, `2`, `s`, `z`, `fast` are
// all clang's -- and one clang does not have is clang's to complain about, since it is the authority
// on its own levels and would say so better than a list here could.
private level_flag(level: string) -> string = s"-O$level"

// What the linker is told to drop, which is per operating system rather than per processor.
private dead_strip(target: Target) -> string =
    if target.os == MacOS then "-Wl,-dead_strip" else "-Wl,--gc-sections"

// The whole of what is handed to the driver to link one program, as a list, so that what a target
// decides about it can be asserted without a machine of that kind to link on.
//
// The order is the linker's and not a style: an object is scanned left to right, so the C a tree
// carried goes **after** the module that calls into it. `-Wno-override-module` is the one warning
// suppressed, and only because sysl states a target *family* -- `arm64-apple-macosx` -- where the
// driver refines it to the installed SDK's version.
// **`links` and `probed` are where a binding's libraries arrive**, and their two positions are the
// linker's rather than a style. A probe's `-L` goes before everything it could affect, since a search
// path is where the scan looks rather than an input being scanned; a `-l`, whether it came from a
// `@link` directive or from `pkg-config`, goes **after** the objects and archives that need it,
// because a library named above them is discarded by any linker resolving an archive in one pass.
link_command(cc: string, ll: string, objects: Buf[string], exe: string, target: Target,
             level: string, links: Buf[string], probed: PkgAnswer) -> Buf[string]
    var out: Buf[string] = buf()

    out.push(cc)
    out.push(s"--target=${target.triple}")
    out.push("-Wno-override-module")
    out.push(level_flag(level))

    val extra = extra_cflags()

    for i in 0..<extra.len()
        out.push(extra.at(i))

    out.push(dead_strip(target))

    val machine = machine_flags(target)

    for i in 0..<machine.len()
        out.push(machine.at(i))

    val linker = linker_flags(target)

    for i in 0..<linker.len()
        out.push(linker.at(i))

    val given = link_search_flags()

    for i in 0..<given.len()
        out.push(given.at(i))

    val search = probed_search_flags(probed)

    for i in 0..<search.len()
        out.push(search.at(i))

    out.push(ll)

    for i in 0..<objects.len()
        out.push(objects.at(i))

    val named = library_flags(links, target)

    for i in 0..<named.len()
        out.push(named.at(i))

    val libs = probed_link_flags(probed)

    for i in 0..<libs.len()
        out.push(libs.at(i))

    val rpaths = rpath_flags(target)

    for i in 0..<rpaths.len()
        out.push(rpaths.at(i))

    out.push("-o")
    out.push(exe)
    out
end link_command

// What the machine needs said to clang **beyond its triple**, on every command line that produces
// code for it or reads a header as it.
//
// There is one such thing today and it is the floating-point unit. A triple names an architecture
// and a calling convention, and on Arm those two leave the *presence* of the unit unstated: the
// `eabi` suffix was only ever a statement about where arguments travel, so what is left is clang's
// default for the architecture. **Both answers are given, because leaving one of them to the default
// left it to the toolchain** -- `thumbv8m.main-none-eabi` defines `__ARM_FP` under one clang and
// nothing at all under another, so one machine compiled a multiply to `vmul.f32` and another to
// `__aeabi_fmul`.
//
// **`-mfloat-abi` goes with `-mfpu`, because `soft` overrides it.** A Thumb row states the pair --
// `soft`+`none`, `softfp`+its unit, or `hard`+its unit -- and none of the three is left for a
// default to decide. It is Arm's flag because Arm is where the triple is silent: RISC-V says it in
// the triple, so `riscv32-unknown-elf` has no F extension to turn off and nothing is passed.
machine_flags(t: Target) -> Buf[string]
    var out: Buf[string] = buf()

    if t.cpu != Thumb then return out

    if t.no_fpu
        out.push("-mfloat-abi=soft")
        out.push("-mfpu=none")
        return out
    end if

    if t.fpu == "" then return out

    out.push(if t.soft_float then "-mfloat-abi=softfp" else "-mfloat-abi=hard")
    out.push(s"-mfpu=${t.fpu}")
    out
end machine_flags

// What a target needs said to the **linker** beyond its triple, which today is WebAssembly's and
// nobody else's.
//
// `wasm-ld` is not a variation on `ld` and the driver's defaults for it are a hosted program's:
// without `-nostdlib` the link opens with `crt1.o`, `-lc` and a wasm builtins archive, none of which
// exists for `wasm32-unknown-unknown`. **`--entry=main` is the load-bearing half, and the reason is a
// link that SUCCEEDS**: the obvious `--no-entry` paired with `--gc-sections` leaves nothing reachable
// from anywhere, so the linker drops the whole program and reports success.
//
// **None of it applies to `wasm32-wasi`**, which is the same processor with a libc under it: wasi-libc
// supplies the `_start` a runtime calls. The condition is therefore the operating system and not the
// processor.
linker_flags(t: Target) -> Buf[string]
    var out: Buf[string] = buf()

    if t.cpu == Wasm32 && t.os == Freestanding
        out.push("-nostdlib")
        out.push("-Wl,--entry=main")

    out
end linker_flags

// One C file assembled into a relocatable object.
//
// `-ffunction-sections`/`-fdata-sections` give every definition a section of its own, which is what
// lets the linker drop the ones a program never reaches. It is the *library* side of the pair
// `dead_strip` is the linker side of, and on Mach-O it is redundant rather than wrong.
compile_c(cc: string, src: string, obj: string, target: Target,
          level: string, probed: PkgAnswer) -> Result[unit, string]
    var args: Buf[string] = buf()

    args.push(s"--target=${target.triple}")
    args.push("-c")
    args.push(level_flag(level))
    args.push("-ffunction-sections")
    args.push("-fdata-sections")

    val machine = machine_flags(target)

    for i in 0..<machine.len()
        args.push(machine.at(i))

    if target.short_enums then args.push("-fshort-enums")

    val extra = extra_cflags()

    for i in 0..<extra.len()
        args.push(extra.at(i))

    // **Where a command line said the headers are, which is the only answer a cross build has.**
    // `pkg-config` speaks for this machine, so a compilation for a board is told by the flags or is
    // told by nothing.
    val given = supplied_cflags()

    for i in 0..<given.len()
        args.push(given.at(i))

    // **What a probe answered is what makes a shim compile at all.** A binding's own C includes the
    // installed library's headers, and the directory they are in is the thing `pkg-config` was asked
    // for -- so a `--cflags` that reached the link line and not this one would leave the package
    // failing on a missing header rather than on a missing symbol.
    for i in 0..<probed.cflags.len()
        args.push(probed.cflags.at(i))

    args.push(src)
    args.push("-o")
    args.push(obj)
    told(cc, args, s"$cc failed on $src")
end compile_c

// One module's LLVM text assembled into a relocatable object, which is what a library artifact's
// halves are made of.
//
// `-x ir` is what makes clang read the text as LLVM rather than guess from an extension, so the
// caller may name the temporary whatever suits it. The sectioning flags are `compile_c`'s and are
// here for the same reason: a library is linked by programs that reach a fraction of it.
compile_object(cc: string, ir: string, obj: string, target: Target,
               level: string) -> Result[unit, string]
    val ll = s"$obj.ll"

    write_text(ll, ir) match
        Err(_) -> return Err(s"cannot write $ll")
        Ok(_) -> ()

    var args: Buf[string] = buf()

    args.push(s"--target=${target.triple}")
    args.push("-Wno-override-module")
    args.push("-c")
    args.push("-x")
    args.push("ir")
    args.push(level_flag(level))
    args.push("-ffunction-sections")
    args.push("-fdata-sections")

    val machine = machine_flags(target)

    for i in 0..<machine.len()
        args.push(machine.at(i))

    args.push(ll)
    args.push("-o")
    args.push(obj)

    val said = told(cc, args, s"$cc failed on $obj")

    // **The text is left behind where clang refused it**, and only there. A back end that rejects
    // generated IR is reporting a defect in the generator, and the one thing that diagnosis needs is
    // the module the line numbers are counted in -- which a compiler that tidied it away has just
    // thrown out.
    if said.is_ok() then remove_file(ll)

    said
end compile_object

// Where an archiver is looked for, in the order tried. The same list `clang_candidates` is and for
// the same reason: Homebrew keeps its LLVM off the PATH so as not to shadow the system clang, so on
// a Mac the capable archiver is commonly installed, working, and invisible to `which`.
private ar_candidates() -> Buf[string]
    var out: Buf[string] = buf()

    out.push("llvm-ar")
    out.push("/opt/homebrew/opt/llvm/bin/llvm-ar")
    out.push("/usr/local/opt/llvm/bin/llvm-ar")
    out
end ar_candidates

// The archiver to use, or why there is none.
//
// A named one is **not** searched past and not fallen back from: someone who wrote down which
// archiver to use is owed an error when it is not there, rather than a library quietly built with a
// different one.
//
// **The platform's own `ar` is not a substitute**, which is why it is not in the list: it indexes
// only its own object format, and drops the members of a library built for another machine without
// failing -- so a cross-built artifact would archive, link, and be missing whatever the index never
// named.
find_ar(named: Option[string]) -> Result[string, string]
    named match
        Some(path) ->
            if clang_runs(path) then return Ok(path)

            return Err(s"cannot run '$path' -- --ar names the llvm-ar to build libraries with")
        None -> ()

    val tried = ar_candidates()

    for i in 0..<tried.len()
        if clang_runs(tried.at(i)) then return Ok(tried.at(i))

    Err("cannot find llvm-ar, which building a library needs -- install LLVM, or name one with " +
        "--ar. The platform's own 'ar' is not a substitute: it indexes only its own object format, " +
        "and drops the members of a library built for another machine without failing")
end find_ar

// The members gathered into one archive, with the index a linker reads written beside them.
//
// The archive is **created** rather than added to: `ar r` replaces by name and leaves whatever was
// already in the file, so building over a stale artifact would ship the members of two libraries.
archive(archiver: string, members: Buf[string], out: string) -> Result[unit, string]
    var args: Buf[string] = buf()

    args.push("rcs")
    args.push(out)

    for i in 0..<members.len()
        args.push(members.at(i))

    told(archiver, args, s"$archiver failed on $out")
end archive

// Links a module's LLVM text, and whatever objects a tree carried, into a native executable.
//
// The triple goes on the command line as well as in the module because the two answer different
// questions: the module's says what the code *is*, and the driver's decides which linker and which
// system libraries it is linked against. Passing it is what makes naming a cross target fail
// honestly at the link rather than silently produce a host binary.
build_native(cc: string, ir: string, objects: Buf[string], exe: string, target: Target,
             level: string, links: Buf[string], probed: PkgAnswer) -> Result[unit, string]
    val ll = s"$exe.ll"

    write_text(ll, ir) match
        Err(_) -> return Err(s"cannot write $ll")
        Ok(_) -> ()

    val command = link_command(cc, ll, objects, exe, target, level, links, probed)

    var args: Buf[string] = buf()

    for i in 1..<command.len()
        args.push(command.at(i))

    val said = told(command.at(0), args, s"${command.at(0)} failed")

    // **The text is left behind where clang refused it**, and only there -- `compile_object` does the
    // same and for the same reason. A back end that rejects generated IR is reporting a defect in the
    // generator, and the one thing that diagnosis needs is the module the line numbers are counted
    // in. A compiler that tidied it away has just thrown out the evidence, and a *test* build is
    // exactly where that bites: its text is never written by any other command, so there is nothing
    // else to go and look at.
    if said.is_ok() then remove_file(ll)

    said
end build_native

// Runs one command, and answers with what it said where it failed. The child's own error stream is
// collected rather than let through, so a tool reporting the failure has the reason to report.
private told(program: string, args: Buf[string], what: string) -> Result[unit, string]
    capture(program, args.view(), "", [], true) match
        Err(_) -> Err(s"cannot run '$program'")
        Ok(out) ->
            if out.status.ok() then return Ok(())

            val said = out.err match
                Some(text) -> text
                None -> ""

            Err(s"$what:\n$said")
end told
