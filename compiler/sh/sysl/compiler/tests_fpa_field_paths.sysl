module sh.sysl.compiler
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// The field-path analysis (`fpa.sysl`), asked directly: what each function keeps of each parameter,
// path by path, what its answer is made of and where in it, and what a local may point to; and where
// it parts from the keeps analysis (`keeps.sysl`), which it is built to replace.
//
// The cells cross where the address sits (a field held in place, a nested field, a field through a
// pointer, a list or tree reached through itself, an array element, a heap object answered) with
// what the body does with it (stores it in module storage, stores it through another parameter,
// hands it back, hands it to a callee by name, through a trait object, through a `&Fn`). A `&Fn`
// cell reads its program with the library (`fpa_with_library`); the rest are read without it
// (`typed_of`), so an enum declared here stands for `Option`. Skipped cells, and why: a function
// pointer is answered by the same signature rule as a `&Fn` and a task by the escape tests that read
// this analysis (`FpaSum.lent`), so neither has a cell of its own here.

private val fpa_decls: string = "var spare = 0\nvar held: *int = &spare\n\n" +
    "struct S\n    a: *int\n    b: *int\n\n" +
    "struct O\n    inner: S\n    c: *int\n\n" +
    "struct Cpu\n    bus: *int\n    peer: *int\n\n" +
    "struct Node\n    next: *Node\n    v: *int\n\n" +
    "struct Tree\n    left: *Tree\n    right: *Tree\n    v: *int\n\n"

private fpa_of(text: string) -> &Fpa
    val done = typed_of(fpa_decls + text)

    assert(done.reported.is_empty(), if done.reported.is_empty() then "" else done.reported[0].diag.message)
    fpa_analyze(done.an, done.funcs)
end fpa_of

private fpa_diffs(text: string) -> string
    val done = typed_of(fpa_decls + text)
    var out = ""

    for line in fpa_disagreements(done.an, done.funcs)
        out = out + line + "\n"

    out
end fpa_diffs

// -- field-sensitive keeps ------------------------------------------------------------------------

@test("a struct held in place keeps the one field it stores, and nothing of the other")
fpa_one_field()
    val fx = fpa_of("keep_a(s: S)\n    held = s.a\n\nmain()\n    keep_a(S(&spare, &spare))\n")

    assert_eq(fpa_kept_text(fx, "keep_a", 0), ".0")
    assert(fpa_keeps(fx, "keep_a", 0))
    assert(!fpa_answers(fx, "keep_a", 0))

@test("a nested field is kept along its whole path: the inner struct's second field, not the outer's own")
fpa_nested_field()
    val fx = fpa_of("keep_ib(o: O)\n    held = o.inner.b\n\nmain()\n    keep_ib(O(S(&spare, &spare), &spare))\n")

    assert_eq(fpa_kept_text(fx, "keep_ib", 0), ".0.1")

@test("a field read through a pointer is let out one step in, and the pointer itself is not kept")
fpa_through_pointer()
    val fx = fpa_of("keep_bus(c: *Cpu)\n    held = c.bus\n\nmain()\n    var c = Cpu(&spare, &spare)\n    keep_bus(&c)\n")

    assert_eq(fpa_kept_text(fx, "keep_bus", 0), "*.0")
    assert(!fpa_keeps(fx, "keep_bus", 0))
    assert(fpa_lets_out(fx, "keep_bus", 0))

@test("a field kept by a callee is kept by the caller handing the field on, and the other field is not")
fpa_field_through_callee()
    val fx = fpa_of("keep_a(s: S)\n    held = s.a\n\nwrapper(t: S)\n    keep_a(t)\n\n" +
                    "main()\n    wrapper(S(&spare, &spare))\n")

    assert_eq(fpa_kept_text(fx, "wrapper", 0), ".0")

@test("a callee keeping the second field: the caller's struct built from two pointers keeps only the second")
fpa_field_built_in_caller()
    val fx = fpa_of("keep_b(s: S)\n    held = s.b\n\nboth(p: *int, q: *int)\n    keep_b(S(p, q))\n\n" +
                    "main()\n    both(&spare, &spare)\n")

    assert_eq(fpa_kept_text(fx, "both", 0), "")
    assert_eq(fpa_kept_text(fx, "both", 1), "ε")

// -- recursive types: a path is cut at the first type that repeats ---------------------------------

@test("walking a list to its end keeps a value one step in: the path is cut where Node repeats")
fpa_list_collapse()
    val fx = fpa_of("last_v(n: *Node)\n    var m = n\n    while m.next != null\n        m = m.next\n" +
                    "    held = m.v\n\nmain()\n    var a = Node(null, &spare)\n    last_v(&a)\n")

    assert_eq(fpa_kept_text(fx, "last_v", 0), "*.1")
    assert_eq(fpa_local_text(fx, "last_v", "m"), "p0 p0*.0")

@test("a tree walked by recursion down both sides settles, every depth answered by one cut path")
fpa_tree_collapse()
    val fx = fpa_of("stash(t: *Tree)\n    if t == null then return\n    held = t.v\n    stash(t.left)\n    stash(t.right)\n\n" +
                    "main()\n    var a = Tree(null, null, &spare)\n    stash(&a)\n")

    assert_eq(fpa_kept_text(fx, "stash", 0), "*.2")

@test("a list's next pointer handed back after any number of steps is answered along the cut path")
fpa_list_answer()
    val fx = fpa_of("far(n: *Node) -> *Node\n    var m = n\n    while m.next != null\n        m = m.next\n    m\n\n" +
                    "main()\n    var a = Node(null, &spare)\n    held = far(&a).v\n")

    assert_eq(fpa_answers_text(fx, "far", 0), "*.0@ε ε@ε")

// -- through a callable: answered by its signature -------------------------------------------------

@test("a call through a trait object whose method declares no '@keeps' keeps nothing it is handed, and may answer with it")
fpa_object_unmarked()
    val fx = fpa_of("trait Pass\n    pass(*self, p: *int) -> *int\n\n" +
                    "via(o: *Pass, p: *int) -> *int = o.pass(p)\n\nmain()\n    spare = 1\n")

    assert_eq(fpa_kept_text(fx, "via", 1), "")
    assert(fpa_answers(fx, "via", 1))

@test("a call through a trait object whose method declares '@keeps(p)' keeps what it hands the object")
fpa_object_marked()
    val fx = fpa_of("trait Sink\n    @keeps(p)\n    put(*self, p: *int)\n\n" +
                    "via(o: *Sink, p: *int)\n    o.put(p)\n\nmain()\n    spare = 1\n")

    assert_eq(fpa_kept_text(fx, "via", 1), "ε")
    assert_eq(fpa_kept_text(fx, "via", 0), "")

// -- a view in a heap object handed back (M24) -----------------------------------------------------

@test("a view put into a heap object the function answers is lent back, not kept, and sits one '*' in")
fpa_view_boxed_answer()
    val fx = fpa_of("struct H\n    v: []u8\n\nwrap(v: []u8) -> &H = H(v)\n\n" +
                    "main()\n    var a: [4]u8 = [1, 2, 3, 4]\n    val h = wrap(a[..])\n    spare = int(h.v[0])\n")

    assert_eq(fpa_kept_text(fx, "wrap", 0), "")
    assert_eq(fpa_answers_text(fx, "wrap", 0), "ε@*")
    assert(fpa_answers_boxed(fx, "wrap", 0))

    // The escape analysis does not follow a view into a box, so to it the view has left the call.
    assert(fpa_lets_out_whole(fx, "wrap", 0))

@test("a view answered in place is not let out, where one answered inside a box is")
fpa_view_answered_in_place()
    val fx = fpa_of("struct H\n    v: []u8\n\npass(v: []u8) -> H = H(v)\n\n" +
                    "main()\n    var a: [4]u8 = [1, 2, 3, 4]\n    val h = pass(a[..])\n    spare = int(h.v[0])\n")

    assert_eq(fpa_answers_text(fx, "pass", 0), "ε@.0")
    assert(!fpa_lets_out_whole(fx, "pass", 0))

@test("the same heap object stored in module storage keeps the view it holds")
fpa_view_boxed_kept()
    val fx = fpa_of("struct H\n    v: *int\n\nenum MaybeH\n    NoH\n    HasH(h: &H)\n\nvar hold: MaybeH = NoH\n\n" +
                    "wrap(v: *int)\n    hold = HasH(H(v))\n\nmain()\n    wrap(&spare)\n")

    assert_eq(fpa_kept_text(fx, "wrap", 0), "ε")

@test("a pointer put in an answered box is lent back by both analyses, and this one says where the box holds it")
fpa_view_boxed_agrees()
    val text = "struct H\n    v: *int\n\nwrap(v: *int) -> &H = H(v)\n\nmain()\n    held = wrap(&spare).v\n"
    val fx = fpa_of(text)

    assert_eq(fpa_diffs(text), "")
    assert_eq(fpa_kept_text(fx, "wrap", 0), "")
    assert_eq(fpa_answers_text(fx, "wrap", 0), "ε@*")
    assert(fpa_answers_boxed(fx, "wrap", 0))

// -- stores through another parameter --------------------------------------------------------------

@test("a pointer stored through another parameter is the caller's to place: written, not kept outright")
fpa_store_through_param()
    val fx = fpa_of("set(out: **int, p: *int)\n    *out = p\n\nmain()\n    var q: *int = &spare\n    set(&q, &spare)\n")

    assert_eq(fpa_kept_text(fx, "set", 1), "ε>p0")
    assert(fpa_writes(fx, "set", 1))

@test("a caller's local written through by a callee holds what was written, and is followed from there")
fpa_store_through_param_followed()
    val fx = fpa_of("set(out: **int, p: *int)\n    *out = p\n\nrelay(p: *int)\n    var q: *int = &spare\n" +
                    "    set(&q, p)\n    held = q\n\nmain()\n    relay(&spare)\n")

    assert_eq(fpa_kept_text(fx, "relay", 0), "ε")

@test("a node pointed back into itself is not kept by that store")
fpa_store_in_place()
    val fx = fpa_of("loop_back(n: *Node)\n    n.next = n\n\nmain()\n    var a = Node(null, &spare)\n    loop_back(&a)\n")

    assert_eq(fpa_kept_text(fx, "loop_back", 0), "")

// -- where a store through another parameter lands -------------------------------------------------
//
// A write through a parameter says the path through it the store went along (`ε>p0.0`: stored where
// the parameter's `.0` points). The cells cross the shape of that path -- a field of a handle passed
// by value, a nested field, a variant's payload, a view held in a field, a pointer read out of a box,
// a heap object stored there -- with the caller's argument: a local, built in place, and the caller's
// own parameter. A store at a box's interior is the box's one cell (M28), so the box cell pins the
// whole-box answer rather than a field of it.

private val fpa_handles: string = "struct H\n    p: **int\n\nstruct HH\n    tag: int\n    h: H\n\n" +
    "enum Dst\n    Nowhere\n    At(p: **int)\n\nstruct V\n    items: []*int\n\nstruct Bp\n    q: **int\n\n" +
    "struct Hb\n    b: &Bp\n\n"

@test("a store through a field of a handle passed by value lands where that field points")
fpa_dest_handle_field()
    val fx = fpa_of(fpa_handles + "put(h: H, x: *int)\n    *h.p = x\n\n" +
                    "fill(x: *int)\n    var slot: *int = &spare\n    put(H(&slot), x)\n\n" +
                    "relay(q: **int, x: *int)\n    put(H(q), x)\n\n" +
                    "main()\n    var s: *int = &spare\n    fill(&spare)\n    relay(&s, &spare)\n")

    assert_eq(fpa_kept_text(fx, "put", 1), "ε>p0.0")
    assert_eq(fpa_kept_text(fx, "fill", 0), "")
    assert(!fpa_keeps(fx, "fill", 0))
    assert_eq(fpa_kept_text(fx, "relay", 1), "ε>p0")

@test("a store through a nested field of a handle names the whole path")
fpa_dest_nested_field()
    val fx = fpa_of(fpa_handles + "put2(hh: HH, x: *int)\n    *hh.h.p = x\n\n" +
                    "fill2(x: *int)\n    var slot: *int = &spare\n    put2(HH(0, H(&slot)), x)\n\n" +
                    "main()\n    fill2(&spare)\n")

    assert_eq(fpa_kept_text(fx, "put2", 1), "ε>p0.1.0")
    assert_eq(fpa_kept_text(fx, "fill2", 0), "")

@test("a store through a variant's payload names the variant's field")
fpa_dest_variant_payload()
    val fx = fpa_of(fpa_handles + "put_v(d: Dst, x: *int)\n    d match\n        At(p) -> *p = x\n        Nowhere -> ()\n\n" +
                    "fill_v(x: *int)\n    var slot: *int = &spare\n    put_v(At(&slot), x)\n\n" +
                    "relay_v(q: **int, x: *int)\n    put_v(At(q), x)\n\n" +
                    "main()\n    var s: *int = &spare\n    fill_v(&spare)\n    relay_v(&s, &spare)\n")

    assert_eq(fpa_kept_text(fx, "put_v", 1), "ε>p0.At:0")
    assert_eq(fpa_kept_text(fx, "fill_v", 0), "")
    assert_eq(fpa_kept_text(fx, "relay_v", 1), "ε>p0")

@test("a store into an element of a view held in a field lands in what the view covers")
fpa_dest_view_element()
    val fx = fpa_of(fpa_handles + "put_e(w: V, x: *int)\n    w.items[0] = x\n\n" +
                    "fill_e(x: *int)\n    var arr: [2]*int = [&spare, &spare]\n    put_e(V(arr[..]), x)\n\n" +
                    "relay_e(xs: []*int, x: *int)\n    put_e(V(xs), x)\n\n" +
                    "main()\n    var a: [2]*int = [&spare, &spare]\n    fill_e(&spare)\n    relay_e(a[..], &spare)\n")

    assert_eq(fpa_kept_text(fx, "put_e", 1), "ε>p0.0")
    assert_eq(fpa_kept_text(fx, "fill_e", 0), "")
    assert_eq(fpa_kept_text(fx, "relay_e", 1), "ε>p0")

@test("a pointer read out of a box is stored through as the box's whole interior, and lands where it points")
fpa_dest_through_box()
    val fx = fpa_of(fpa_handles + "put_b(h: Hb, x: *int)\n    *h.b.q = x\n\n" +
                    "relay_b(q: **int, x: *int)\n    put_b(Hb(Bp(q)), x)\n\n" +
                    "fill_b(x: *int)\n    var slot: *int = &spare\n    put_b(Hb(Bp(&slot)), x)\n\n" +
                    "main()\n    var s: *int = &spare\n    relay_b(&s, &spare)\n    fill_b(&spare)\n")

    assert_eq(fpa_kept_text(fx, "put_b", 1), "ε>p0.0*")
    assert_eq(fpa_kept_text(fx, "relay_b", 1), "ε>p0~")
    assert_eq(fpa_kept_text(fx, "fill_b", 0), "")

@test("a heap object stored through a parameter is the caller's: what it holds is written there, not kept")
fpa_dest_heap_object()
    val fx = fpa_of(fpa_handles + "struct Rec\n    who: *int\n\nstruct Shelf\n    top: &Rec\n    own: *int\n\n" +
                    "shelve(s: *Shelf, x: *int)\n    s.top = Rec(x)\n\n" +
                    "self_shelve(s: *Shelf)\n    s.top = Rec(s.own)\n\n" +
                    "main()\n    var sh = Shelf(Rec(&spare), &spare)\n    shelve(&sh, &spare)\n    self_shelve(&sh)\n")

    assert_eq(fpa_kept_text(fx, "shelve", 1), "ε>p0~")
    assert(!fpa_keeps(fx, "self_shelve", 0))

@test("a store at an address held at an offset in a value lands in that address's storage, not kept")
fpa_dest_offset_address()
    val fx = fpa_of(fpa_handles + "local_slot(x: *int)\n    var arr: [2]*int = [&spare, &spare]\n    val v = arr[..]\n    v[0] = x\n\n" +
                    "main()\n    local_slot(&spare)\n")

    assert_eq(fpa_kept_text(fx, "local_slot", 0), "")

@test("a pointer pushed into a local buffer that is then stored in module storage is kept")
fpa_dest_buffer_kept()
    val got = fpa_with_library_after("import sysl.buf.{Buf, buf}\n\n", "var shelf: Buf[*int] = buf()\n\n" +
                                     "stash(x: *int)\n    var b: Buf[*int] = buf()\n    b.push(x)\n    shelf = b\n\n" +
                                     "scratch(x: *int)\n    var b: Buf[*int] = buf()\n    b.push(x)\n\n" +
                                     "main()\n    stash(&spare)\n    scratch(&spare)\n")

    if got.is_none() then return

    val fx = got.unwrap()

    assert(fpa_keeps(fx, "stash", 0))
    assert(!fpa_keeps(fx, "scratch", 0))

// -- what a value may point to ---------------------------------------------------------------------

@test("a local assigned on two arms may point to either, and a local's address is told by name")
fpa_local_points_to()
    val fx = fpa_of("pick(c: bool, p: *int) -> int\n    var x = 1\n    var r = p\n    if c then r = &x\n    *r\n\n" +
                    "either(c: bool, p: *int, q: *int) -> *int\n    var r = p\n    if c then r = q\n    r\n\n" +
                    "main()\n    spare = pick(true, &spare)\n    spare = *either(true, &spare, &spare)\n")

    assert_eq(fpa_local_text(fx, "pick", "r"), "&x p1")
    assert_eq(fpa_result_text(fx, "pick"), "")
    assert_eq(fpa_result_text(fx, "either"), "p1 p2")

@test("an element read out of an array of pointers held in place is the array parameter's element")
fpa_array_element()
    val fx = fpa_of("first(xs: [2]*int)\n    held = xs[0]\n\nmain()\n    first([&spare, &spare])\n")

    assert_eq(fpa_kept_text(fx, "first", 0), "[]")

// -- a path stops at a &T box (M28) ----------------------------------------------------------------

private val fpa_boxes: string = "struct Bx\n    v: *int\n    w: *int\n\n" +
    "struct Outer\n    inner: &Bx\n\n" +
    "struct Pl\n    tag: *int\n    bx: &Bx\n\n"

@test("a field read out of a &T box is kept as the box's whole interior, not as the one field")
fpa_box_interior()
    val fx = fpa_of(fpa_boxes + "keep_v(b: &Bx)\n    held = b.v\n\nmain()\n    keep_v(Bx(&spare, &spare))\n")

    assert_eq(fpa_kept_text(fx, "keep_v", 0), "*")
    assert(!fpa_keeps(fx, "keep_v", 0))
    assert(fpa_lets_out(fx, "keep_v", 0))

@test("a box inside a box is the outer box's interior: the path stops at the first box")
fpa_box_in_box()
    val fx = fpa_of(fpa_boxes + "keep_w(o: &Outer)\n    held = o.inner.w\n\n" +
                    "main()\n    keep_w(Outer(Bx(&spare, &spare)))\n")

    assert_eq(fpa_kept_text(fx, "keep_w", 0), "*")

@test("a box held in place is reached by its field, and stops there: the tag beside it is not kept")
fpa_box_held_in_place()
    val fx = fpa_of(fpa_boxes + "keep_bw(s: Pl)\n    held = s.bx.w\n\n" +
                    "main()\n    keep_bw(Pl(&spare, Bx(&spare, &spare)))\n")

    assert_eq(fpa_kept_text(fx, "keep_bw", 0), ".1*")

@test("a raw pointer is followed past, where a box would stop the path")
fpa_box_versus_pointer()
    val fx = fpa_of(fpa_boxes + "struct Rp\n    to: *Bx\n\nkeep_rw(r: Rp)\n    held = r.to.w\n\n" +
                    "main()\n    var b = Bx(&spare, &spare)\n    keep_rw(Rp(&b))\n")

    assert_eq(fpa_kept_text(fx, "keep_rw", 0), ".0*.1")

@test("a list of boxes walked to its end is the first box's interior, at every depth")
fpa_box_list()
    val fx = fpa_of("enum Link\n    End\n    More(c: &Cell)\n\nstruct Cell\n    next: Link\n    v: *int\n\n" +
                    "last(c: &Cell)\n    var m = c\n    loop\n        m.next match\n            More(n) -> m = n\n" +
                    "            End -> break\n    held = m.v\n\nmain()\n    last(Cell(End, &spare))\n")

    assert_eq(fpa_kept_text(fx, "last", 0), "*")
    assert_eq(fpa_local_text(fx, "last", "m"), "p0 p0*")

@test("a box answered back from inside a box is answered as the interior, one '*' in")
fpa_box_answer()
    val fx = fpa_of(fpa_boxes + "inner_of(o: &Outer) -> &Bx = o.inner\n\n" +
                    "main()\n    held = inner_of(Outer(Bx(&spare, &spare))).v\n")

    assert_eq(fpa_answers_text(fx, "inner_of", 0), "*@ε")

// -- variants are told apart by name ---------------------------------------------------------------

private val fpa_variants: string = "enum Two\n    A(x: *int, y: *int)\n    B(x: *int, y: *int)\n\n" +
    "keep_ay(e: Two)\n    e match\n        A(_, y) -> held = y\n        B(_, _) -> spare = 0\n\n"

@test("a variant's field is kept by variant and position: A's second field, nothing of B's")
fpa_variant_named()
    val fx = fpa_of(fpa_variants + "main()\n    keep_ay(A(&spare, &spare))\n")

    assert_eq(fpa_kept_text(fx, "keep_ay", 0), ".A:1")

@test("a value built as the other variant keeps nothing at the same position")
fpa_variant_other()
    val fx = fpa_of(fpa_variants + "build_b(p: *int, q: *int)\n    keep_ay(B(p, q))\n\n" +
                    "build_a(p: *int, q: *int)\n    keep_ay(A(p, q))\n\n" +
                    "main()\n    build_b(&spare, &spare)\n    build_a(&spare, &spare)\n")

    assert_eq(fpa_kept_text(fx, "build_b", 1), "")
    assert_eq(fpa_kept_text(fx, "build_a", 0), "")
    assert_eq(fpa_kept_text(fx, "build_a", 1), "ε")

@test("a variant answered back says where its field sits by variant name")
fpa_variant_answer()
    val fx = fpa_of(fpa_variants + "mk(p: *int, q: *int) -> Two = B(q, p)\n\n" +
                    "main()\n    keep_ay(mk(&spare, &spare))\n")

    assert_eq(fpa_answers_text(fx, "mk", 0), "ε@.B:1")

// -- a destructuring pattern looks through a pointer at every depth --------------------------------

@test("a box bound by a variant pattern and matched by what it holds is the variant field's interior")
fpa_pattern_through_box()
    val fx = fpa_of(fpa_boxes + "enum MaybeBx\n    NoBx\n    HasBx(b: &Bx)\n\n" +
                    "take(o: MaybeBx)\n    o match\n        HasBx(b) -> *b match\n            Bx(v, _) -> held = v\n" +
                    "        NoBx -> ()\n\n" +
                    "main()\n    take(HasBx(Bx(&spare, &spare)))\n")

    assert_eq(fpa_kept_text(fx, "take", 0), ".HasBx:0*")

@test("a struct pattern matched against what a box holds at the top looks through it too")
fpa_pattern_top_box()
    val fx = fpa_of(fpa_boxes + "take(b: &Bx)\n    *b match\n        Bx(_, w) -> held = w\n\n" +
                    "main()\n    take(Bx(&spare, &spare))\n")

    assert_eq(fpa_kept_text(fx, "take", 0), "*")

// -- a local read in a loop before it is first written --------------------------------------------
//
// A cell is made the first time a walk asks for it, and asking for it counts as reading it, so what is
// written into it later in the same walk sends the body round again. The cells cross the loop (`for`,
// `while`, `loop`) with what is read (the local itself, a field of a struct local), and the same
// order with no loop, which keeps it too: a local holds everything it is ever given, wherever in the
// body it is read (the analysis does not follow the order of statements).

@test("a local a 'for' body stores before it is first written keeps what the next round finds there")
fpa_read_first_for()
    val fx = fpa_of("late(p: *int)\n    var x: *int = null\n\n    for _ in 0..<2\n        held = x\n        x = p\n\n" +
                    "main()\n    late(&spare)\n")

    assert_eq(fpa_kept_text(fx, "late", 0), "ε")

@test("a 'while' body storing a local before writing it keeps what the next round finds there")
fpa_read_first_while()
    val fx = fpa_of("late(p: *int)\n    var x: *int = null\n    var n = 0\n\n    while n < 2\n" +
                    "        held = x\n        x = p\n        n += 1\n\nmain()\n    late(&spare)\n")

    assert_eq(fpa_kept_text(fx, "late", 0), "ε")

@test("a field of a struct local stored before the struct is rebuilt in a 'loop' keeps that field of the next")
fpa_read_first_field()
    val fx = fpa_of("late(s: S)\n    var t = S(null, null)\n    var n = 0\n\n    loop\n        held = t.b\n" +
                    "        t = s\n        n += 1\n\n        if n > 2 then break\n\nmain()\n    late(S(&spare, &spare))\n")

    assert_eq(fpa_kept_text(fx, "late", 0), ".1")

@test("a local stored before it is written, with no loop to come round again, still keeps what it is given")
fpa_read_first_straight()
    val fx = fpa_of("early(p: *int)\n    var x: *int = null\n\n    held = x\n    x = p\n\nmain()\n    early(&spare)\n")

    assert_eq(fpa_kept_text(fx, "early", 0), "ε")

// -- agreement with the keeps analysis, and the error paths -----------------------------------------

@test("where there is nothing to tell apart, the two analyses agree on keeping and answering")
fpa_agrees()
    val said = fpa_diffs("store(p: *int)\n    held = p\n\nread(p: *int)\n    spare = *p\n\n" +
                         "ident(p: *int) -> *int = p\n\nhand_on(p: *int)\n    store(p)\n\n" +
                         "main()\n    store(&spare)\n    read(&spare)\n    held = ident(&spare)\n    hand_on(&spare)\n")

    assert_eq(said, "")

@test("a name the program does not have is answered '?', not taken for one that keeps nothing")
fpa_unknown_name()
    val fx = fpa_of("main()\n    spare = 1\n")

    assert_eq(fpa_kept_text(fx, "nosuch", 0), "?")
    assert(!fpa_keeps(fx, "nosuch", 0))

@test("a body refused where it was read has an empty summary and is left out of the comparison")
fpa_refused_body()
    val done = typed_of(fpa_decls + "bad(p: *int)\n    held = nosuch(p)\n\nmain()\n    bad(&spare)\n")

    assert(!done.reported.is_empty())

    val fx = fpa_analyze(done.an, done.funcs)

    assert_eq(fpa_kept_text(fx, "bad", 0), "")
    assert_eq(fpa_disagreements(done.an, done.funcs).len(), 0)

// -- what a call answers is filtered by type reachability (M35) ------------------------------------
//
// A call with no body in sight may answer with an argument only where the answer's type can reach the
// argument's: through a field, a box, a generic argument, or as a raw pointer a cast may have made of
// anything. The cells cross the answer's type (cannot hold it, holds it through a box, through a
// generic struct's argument, a raw pointer) with how the call is made (a trait object, a `&Fn`, a
// body calling either, whose summary carries the answer on) and what is done with the answer (handed
// back, stored at an offset).

private val fpa_picks: string = "struct Q\n    q: *u8\n\nstruct Bx\n    v: *int\n\n" +
    "struct G[T]\n    x: T\n\nvar held_q = Q(null)\n\n"

@test("an answer whose type cannot hold the argument is not made of it, and storing it keeps nothing")
fpa_m35_cannot_hold()
    val fx = fpa_of(fpa_picks + "trait Pick\n    pick(*self, p: *int) -> Q\n\n" +
                    "via(o: *Pick, p: *int) -> Q = o.pick(p)\n\n" +
                    "outer(o: *Pick, p: *int) -> Q = via(o, p)\n\n" +
                    "hold(o: *Pick, p: *int)\n    held_q = o.pick(p)\n\nmain()\n    spare = 1\n")

    assert_eq(fpa_answers_text(fx, "via", 1), "")
    assert_eq(fpa_answers_text(fx, "outer", 1), "")
    assert_eq(fpa_kept_text(fx, "hold", 1), "")
    assert(!fpa_lets_out(fx, "hold", 1))

@test("an answer that holds the argument through a box is made of it, and storing it keeps it")
fpa_m35_through_box()
    val fx = fpa_of(fpa_picks + "var held_b: &Bx = Bx(&spare)\n\n" +
                    "trait Pick\n    pick(*self, p: *int) -> &Bx\n\n" +
                    "via(o: *Pick, p: *int) -> &Bx = o.pick(p)\n\n" +
                    "hold(o: *Pick, p: *int)\n    held_b = o.pick(p)\n\nmain()\n    spare = 1\n")

    assert(fpa_answers(fx, "via", 1))
    assert(fpa_keeps(fx, "hold", 1))

@test("a generic struct holds the argument where it is instantiated at the argument's type, and not elsewhere")
fpa_m35_generic()
    val fx = fpa_of(fpa_picks + "trait Pick\n    at_int(*self, p: *int) -> G[*int]\n    at_u8(*self, p: *int) -> G[*u8]\n\n" +
                    "via_int(o: *Pick, p: *int) -> G[*int] = o.at_int(p)\n\n" +
                    "via_u8(o: *Pick, p: *int) -> G[*u8] = o.at_u8(p)\n\nmain()\n    spare = 1\n")

    assert(fpa_answers(fx, "via_int", 1))
    assert(!fpa_answers(fx, "via_u8", 1))

@test("an answer that is a raw pointer may be made of any address, whatever it points at")
fpa_m35_raw_pointer()
    val fx = fpa_of(fpa_picks + "trait Pick\n    pick(*self, p: *int) -> *u8\n\n" +
                    "via(o: *Pick, p: *int) -> *u8 = o.pick(p)\n\nmain()\n    spare = 1\n")

    assert(fpa_answers(fx, "via", 1))

@test("an argument holding the address in place is answered by a struct that can hold a field of it")
fpa_m35_field_of_argument()
    val fx = fpa_of(fpa_picks + "trait Pick\n    pick(*self, s: *S) -> Bx\n\n" +
                    "via(o: *Pick, s: *S) -> Bx = o.pick(s)\n\nmain()\n    spare = 1\n")

    // `Bx` holds a `*int`, the type of `S`'s fields, held in place where `s` points.
    assert(fpa_answers(fx, "via", 1))

// The same, through a `&Fn`, whose type the program reads from the library.
private var fpa_library_cache: Buf[Program] = buf()
private var fpa_library_read: bool = false

private fpa_with_library(text: string) -> Option[&Fpa] = fpa_with_library_after("", text)

// The same, with `head` -- its imports -- ahead of the declarations every cell shares.
private fpa_with_library_after(head: string, text: string) -> Option[&Fpa]
    if !fpa_library_read
        fpa_library_read = true

        std_root() match
            Err(_) -> ()
            Ok(root) -> std_units(root, host_target()) match
                Err(_) -> ()
                Ok(units) -> fpa_library_cache = units

    if fpa_library_cache.is_empty()
        print("skipped: the standard module's source is not on this machine")
        return None

    var units: Buf[Program] = buf()

    for item in fpa_library_cache
        units.push(item)

    units.push(parse(source_of("test.sysl", head + fpa_decls + fpa_picks + text)).program)

    val done = analyze_bodies(units, host_target())

    assert(done.reported.is_empty(), if done.reported.is_empty() then "" else done.reported[0].diag.message)
    Some(fpa_analyze(done.an, program_of(done, "").funcs))
end fpa_with_library_after

@test("bytes made into a string in place are kept: a string outlives every frame")
fpa_str_alias_keeps()
    val got = fpa_with_library_after("import sysl.raw.str_alias\n\n",
                                     "view(b: []u8) -> string = str_alias(b)\n\nhand_on(b: []u8) -> string = view(b)\n\n" +
                                     "main()\n    var a: [2]u8 = [111, 107]\n    spare = int(view(a[..]).len)\n")

    if got.is_none() then return

    val fx = got.unwrap()

    assert_eq(fpa_kept_text(fx, "view", 0), "ε")
    assert_eq(fpa_kept_text(fx, "hand_on", 0), "ε")
    assert(fpa_lets_out_whole(fx, "view", 0))

@test("a call through a '&Fn' answers with an argument only where its answer's type can hold it")
fpa_m35_callable()
    val got = fpa_with_library("via_q(f: &Fn(*int) -> Q, p: *int) -> Q = f(p)\n\n" +
                               "via_b(f: &Fn(*int) -> &Bx, p: *int) -> &Bx = f(p)\n\n" +
                               "hold(f: &Fn(*int) -> Q, p: *int)\n    held_q = f(p)\n\n" +
                               "main()\n    spare = 1\n")

    if got.is_none() then return

    val fx = got.unwrap()

    assert(!fpa_answers(fx, "via_q", 1))
    assert(fpa_answers(fx, "via_b", 1))
    assert_eq(fpa_kept_text(fx, "hold", 1), "")
