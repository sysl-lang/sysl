module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.text.{repeat}

// **A complaint about a call is shown at its callee**: the name in front of the parentheses for a
// plain call, the member's name for a call through `.`, the `[` for a written instantiation -- never
// the whole call, arguments and all. Every message, location and caret here is the reference's own
// output (sysl 0.0.162) for the same file, with the scratch directory put back in for its path,
// except where a test says the reference diverges.

private mcs_ready() -> bool = std_root().is_ok()

// What `sysl build <dir>` says about a project holding `main.sysl` and, where `geom` is not empty, a
// module `geom` beside it.
private mcs_run(text: string, geom: string = "") -> (string, string, int)
    val root = make_temp_dir("sysl-mcs").unwrap()

    write_text(s"$root/main.sysl", text).unwrap()

    if geom != ""
        make_dir_all(s"$root/geom").unwrap()
        write_text(s"$root/geom/geom.sysl", geom).unwrap()
    end if

    var lines: Buf[string] = buf()
    val sink = &lines
    val code = run_cli(["sysl", "build", root], (line) -> sink.push(line))
    val out = if lines.is_empty() then "" else lines.at(0)

    remove_dir_all(root).unwrap_or(())
    (out, absolute_path(root), code)

// The whole rendered diagnostic: `quoted` is the line it quotes, and the caret stands under column
// `col`, `width` wide. The gutter is as wide as the line number.
private mcs_expect(text: string, message: string, line: int, col: int, quoted: string, width: int,
                   geom: string = "")
    val (out, root, code) = mcs_run(text, geom)
    val gutter = repeat(" ", str(line).bytes.len)
    val pad = repeat(" ", usize(col - 1))
    val carets = repeat("^", usize(width))

    assert_eq(code, 1)
    assert_eq(out, s"error: $message\n$gutter--> $root/main.sysl:$line:$col\n$gutter |\n" +
                   s"$line | $quoted\n$gutter | $pad$carets")

// Declarations every case below calls into, on lines 1 to 9 so that the call is on line 10.
private mcs_decls() -> string =
    "struct P\n    x: int\n    mk(a: int) -> P = P(a)\ntrait T\n    f(self) -> int\n" +
    "impl T for P\n    f(self) -> int = self.x\ntype Age = int within 0..150\n" +
    "g(a: int) -> int = a\n"

// -- a constrained type's name ---------------------------------------------------------------------

@test("'try' called off a constrained type's name underlines 'try'")
mcs_try_off_a_constrained_type()
    if !mcs_ready() then return

    mcs_expect(mcs_decls() + "print(Age.try(200).is_some())\n",
               "'Age' is a constrained type and has no 'try': a value outside its range is a mistake " +
               "in the code that produced it rather than a condition to handle, so 'Age(x)' checks it " +
               "and traps, and 'Age::Valid(x)' asks the question without trapping",
               10, 11, "print(Age.try(200).is_some())", 3)

// The reference 0.0.162 underlines the same three columns but quotes the cast as 'Age(x)' and
// 'Age::Valid(x)', which name nothing in a file that imported only the module; the name as it was
// written is what the reader can paste.
@test("and through the module that declares it, at the same three columns")
mcs_try_off_a_constrained_type_through_its_module()
    if !mcs_ready() then return

    mcs_expect("import geom\n\nprint(geom.Age.try(200).is_some())\n",
               "'geom.Age' is a constrained type and has no 'try': a value outside its range is a " +
               "mistake in the code that produced it rather than a condition to handle, so " +
               "'geom.Age(x)' checks it and traps, and 'geom.Age::Valid(x)' asks the question " +
               "without trapping",
               3, 16, "print(geom.Age.try(200).is_some())", 3,
               "module geom\n\ntype Age = int within 0..150\n")

@test("a member a constrained type does not have underlines the member")
mcs_unknown_member_off_a_constrained_type()
    if !mcs_ready() then return

    mcs_expect(mcs_decls() + "print(Age.foo(1))\n",
               "'Age' is a type, not a value, and has no member 'foo' — what a constrained type " +
               "offers under its own name is written with '::': 'Age::First', 'Age::Last', " +
               "'Age::Valid(x)', 'Age::Succ(x)', 'Age::Pred(x)'",
               10, 11, "print(Age.foo(1))", 3)

// -- a struct, a trait object ----------------------------------------------------------------------

@test("a method a struct does not have underlines the method's name")
mcs_unknown_method_on_a_struct_value()
    if !mcs_ready() then return

    mcs_expect(mcs_decls() + "val p = P(1)\nprint(p.nope(1))\n", "type 'P' has no method 'nope'",
               11, 9, "print(p.nope(1))", 4)

@test("an associated function a struct does not have underlines its name")
mcs_unknown_associated_function()
    if !mcs_ready() then return

    mcs_expect(mcs_decls() + "print(P.nope(1))\n", "type 'P' has no associated function 'nope'",
               10, 9, "print(P.nope(1))", 4)

@test("a method a trait does not declare underlines the method's name")
mcs_unknown_method_on_a_trait_object()
    if !mcs_ready() then return

    mcs_expect(mcs_decls() + "val t: &T = P(2)\nprint(t.nope(1))\n",
               "trait 'T' declares no method 'nope' — it has 'f'", 11, 9, "print(t.nope(1))", 4)

@test("an instance method called off the type underlines the method's name")
mcs_instance_method_off_the_type()
    if !mcs_ready() then return

    mcs_expect(mcs_decls() + "print(P.f(1))\n",
               "'f' is an instance method of 'P' — call it on a value, not the type",
               10, 9, "print(P.f(1))", 1)

// -- the wrong number of arguments -----------------------------------------------------------------

@test("a method given too many arguments underlines its name")
mcs_method_arity()
    if !mcs_ready() then return

    mcs_expect(mcs_decls() + "val p = P(1)\nprint(p.f(1))\n",
               "method 'P.f' takes 0 arguments, but 1 argument was given", 11, 9, "print(p.f(1))", 1)

@test("an associated function given too many arguments underlines its name")
mcs_associated_arity()
    if !mcs_ready() then return

    mcs_expect(mcs_decls() + "print(P.mk(1, 2).x)\n",
               "associated function 'P.mk' takes 1 argument, but 2 arguments were given",
               10, 9, "print(P.mk(1, 2).x)", 2)

@test("a function given too many arguments underlines its name")
mcs_function_arity()
    if !mcs_ready() then return

    mcs_expect(mcs_decls() + "print(g(1, 2))\n",
               "function 'g' takes 1 argument, but 2 arguments were given", 10, 7, "print(g(1, 2))", 1)

@test("a written instantiation given too many arguments underlines its '['")
mcs_instantiation_arity()
    if !mcs_ready() then return

    mcs_expect("h[A](a: A) -> A = a\nprint(h[int](1, 2))\n",
               "function 'h' takes 1 argument, but 2 arguments were given", 2, 8,
               "print(h[int](1, 2))", 1)

// -- the shapes that already agreed, kept so that they go on agreeing -------------------------------

@test("a variant an enum does not have underlines the name, as before")
mcs_unknown_variant()
    if !mcs_ready() then return

    mcs_expect("enum E\n    A\n    B\nprint(E.nope(1))\n",
               "enum 'E' has no variant or associated function 'nope'", 4, 9, "print(E.nope(1))", 4)

@test("a function a module does not declare underlines the name, as before")
mcs_unknown_module_function()
    if !mcs_ready() then return

    mcs_expect("import geom\n\nprint(geom.nope(1))\n", "undefined function 'geom.nope'", 3, 12,
               "print(geom.nope(1))", 4, "module geom\n\ntype Age = int within 0..150\n")

@test("an argument's own complaint keeps the argument's span")
mcs_argument_keeps_its_span()
    if !mcs_ready() then return

    mcs_expect(mcs_decls() + "print(P.mk(\"s\").x)\n", "'a' of 'P.mk' is int, but string was given",
               10, 12, "print(P.mk(\"s\").x)", 3)
