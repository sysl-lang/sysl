module sysl.fmt
@tests

import sysl.buf.byte_sink
import sysl.text.{Search, from_utf8_unchecked}

// A float written to a sink under a printf conversion, with scratch the caller lends. Two oracles: the
// host's own `snprintf` for what C prints (`float_tests.sysl`'s `c_format`), and `format_real` -- the
// allocating rendering -- which the writing one must agree with byte for byte wherever both answer.

// What `write_real` wrote, or the refusal it answered, spelled so a test can compare either.
private written(x: real, spec: string, width: int = 0, precision: int = -1, room: usize = 800) -> string
    var sink = byte_sink()
    var scratch: [800]u8

    write_real(x, &sink, spec, width, precision, scratch[0..<room]) match
        Ok(_) -> from_utf8_unchecked(sink.text())
        Err(why) -> s"refused: $why, wrote '${from_utf8_unchecked(sink.text())}'"
end written

// A deterministic stream of 64-bit patterns (xorshift64*).
private struct Bits
    state: u64

    next(*self) -> u64
        self.state ^= self.state >> 12
        self.state ^= self.state << 25
        self.state ^= self.state >> 27
        self.state * 0x2545f4914f6cdd1d
end Bits

@test("write_real writes what format_real answers, under every decimal conversion")
fwf_writes_what_format_real_answers()
    val specs = ["%g", "%e", "%f", "%.0f", "%.3f", "%.17g", "%.0e", "%#.0e", "%+08.3f", "%-12e",
                 "%G", "%E", "%F", "% .2f", "%#g", "%.25f", "%+.10e", "%010.4f", "%.1g", "%#.3G"]
    var g = Bits(0x9e3779b97f4a7c15)
    var bad = 0
    var said = ""

    for i in 0..<3000
        val x = real.from_bits(g.next())

        for spec in specs
            val want = format_real(x, spec, 0, -1)
            val got = written(x, spec)

            if got != want
                bad += 1

                if bad <= 5 then said = said + s"[$spec: format_real '$want', write_real '$got'] "
    end for

    assert(bad == 0, s"$bad disagreements: $said")
end fwf_writes_what_format_real_answers

// A hexadecimal digit's value.
private nibble(b: u8) -> u8 = if b <= u8('9') then b - u8('0') else b - u8('a') + 10

// C's full `%a` of `x`, rounded to `p` fraction digits half to even in the text itself. **Apple's C
// library rounds `%.Na` wrongly** -- `%.5a` of `0x1.9ce5b8adb52c4p-710` is `0x1.9ce5bp-710` there,
// where glibc and musl write `0x1.9ce5cp-710` -- so a precision is checked against this second
// rounding of C's exact digits rather than against C's own.
private hex_rounded(x: real, p: usize) -> string
    val full = c_format(x, "%a")
    val b = full.bytes

    val at = full.index_of("x") match
        Some(i) -> i + 1
        None -> return full

    val exp_at = full.index_of("p").unwrap()
    var digits: [80]u8 = [u8('0'); 80]
    var n: usize = 0
    var i = at + 2

    while i < exp_at
        digits[n] = b[i]
        n += 1
        i += 1

    var lead: [1]u8 = [b[at]]

    if n > p
        var more = false

        for j in p + 1..<n
            if digits[j] != u8('0') then more = true

        val odd = nibble(if p == 0 then lead[0] else digits[p - 1]) % 2 == 1
        val first = nibble(digits[p])

        if first > 8 || (first == 8 && (more || odd))
            var j = p
            var carried = true

            while j > 0 && carried
                j -= 1

                if digits[j] == u8('f') then digits[j] = u8('0')
                else
                    digits[j] = if digits[j] == u8('9') then u8('a') else digits[j] + 1
                    carried = false

            if carried then lead[0] += 1
        end if
    end if

    val point = if p > 0 then "." + from_utf8_unchecked(digits[0..<p]) else ""

    from_utf8_unchecked(b[0..<at]) + from_utf8_unchecked(lead[..]) + point + from_utf8_unchecked(b[exp_at..])
end hex_rounded

@test("%a and %A write what C writes, flag for flag, over random bit patterns")
fwf_hex_matches_c()
    val specs = ["%a", "%A", "%#a", "%+020a", "%-30a", "%.20a", "% a", "%015A", "%.13a", "%+.15A"]
    val precisions: [5]usize = [0, 1, 3, 5, 12]
    var g = Bits(12345)
    var bad = 0
    var said = ""

    for i in 0..<5000
        // Every fourth value a subnormal, which `%a` writes normalized.
        val bits = g.next()
        val x = real.from_bits(if i % 4 == 0 then bits & 0x800fffffffffffff else bits)

        for spec in specs
            val want = c_format(x, spec)
            val got = written(x, spec)

            if got != want
                bad += 1

                if bad <= 5 then said = said + s"[$spec of ${x.bits()}: C '$want', sysl '$got'] "

        for p in precisions
            val want = hex_rounded(x, p)
            val got = written(x, s"%.${p}a")

            if got != want
                bad += 1

                if bad <= 5 then said = said + s"[%.${p}a of ${x.bits()}: want '$want', sysl '$got'] "
    end for

    assert(bad == 0, s"$bad disagreements: $said")
end fwf_hex_matches_c

@test("each conversion writes what printf prints for it")
fwf_known_printf_outputs()
    assert_eq(written(0.1, "%.17g"), "0.10000000000000001")
    assert_eq(written(1e300, "%.17g"), "1.0000000000000001e+300")
    assert_eq(written(0.1, "%a"), "0x1.999999999999ap-4")
    assert_eq(written(0.1, "%A"), "0X1.999999999999AP-4")
    assert_eq(written(1.0, "%#.0e"), "1.e+00")
    assert_eq(written(3.14159, "%+08.3f"), "+003.142")
    assert_eq(written(1.5, "%-14e"), "1.500000e+00  ")
    assert_eq(written(-2.5e-10, "%-12e"), "-2.500000e-10")
    assert_eq(written(1.5, "%G"), "1.5")
    assert_eq(written(1e23, "%.0f"), "99999999999999991611392")
    assert_eq(written(1.7976931348623157e308, "%e"), "1.797693e+308")
    assert_eq(written(2.2250738585072014e-308, "%g"), "2.22507e-308")
    assert_eq(written(5e-324, "%.3e"), "4.941e-324")
    assert_eq(written(5e-324, "%.30e"), "4.940656458412465441765687928682e-324")
    assert_eq(written(5e-324, "%a"), "0x1p-1074")
    assert_eq(written(1.7976931348623157e308, "%a"), "0x1.fffffffffffffp+1023")
    assert_eq(written(1e-300, "%.3f"), "0.000")
end fwf_known_printf_outputs

@test("precision zero, and a precision longer than the value has digits")
fwf_precision_zero_and_large()
    assert_eq(written(0.5, "%.0f"), "0")
    assert_eq(written(2.5, "%.0e"), "2e+00")
    assert_eq(written(0.0001, "%.0g"), "0.0001")
    assert_eq(written(0.1, "%.0a"), "0x2p-4")
    assert_eq(written(0.1, "%.40f"), "0.1000000000000000055511151231257827021182")
    assert_eq(written(1.5, "%.20a"), "0x1.80000000000000000000p+0")
    assert_eq(written(1.0, "%#a"), "0x1.p+0")
    assert_eq(written(1.0, "%.3a"), "0x1.000p+0")
end fwf_precision_zero_and_large

// Apple's C library writes `0x1p+0` for `%.0a` of 1.5 (see `hex_rounded`), where glibc and musl round
// a tie to the even digit, as every other conversion here does.
@test("%a rounds a tie to the even digit, a carry out of the fraction making the first digit 2")
fwf_hex_ties_go_to_even()
    assert_eq(written(1.5, "%.0a"), "0x2p+0")
    assert_eq(written(3.0, "%.0a"), "0x2p+1")
    assert_eq(written(2.5, "%.0a"), "0x1p+1")
    assert_eq(written(real.from_bits(0x3ff1800000000000), "%.1a"), "0x1.2p+0")
    assert_eq(written(real.from_bits(0x3ff0800000000000), "%.1a"), "0x1.0p+0")
    assert_eq(written(real.from_bits(0x3fffffffffffffff), "%.1a"), "0x2.0p+0")
end fwf_hex_ties_go_to_even

@test("negative zero keeps its sign under every conversion, and a zero writes no digits but zeros")
fwf_negative_zero()
    assert_eq(written(-0.0, "%f"), "-0.000000")
    assert_eq(written(-0.0, "%g"), "-0")
    assert_eq(written(-0.0, "%e"), "-0.000000e+00")
    assert_eq(written(-0.0, "%a"), "-0x0p+0")
    assert_eq(written(0.0, "%+e"), "+0.000000e+00")
    assert_eq(written(0.0, "%#.0a"), "0x0.p+0")
    assert_eq(written(0.0, "%015a"), "0x0000000000p+0")
end fwf_negative_zero

@test("an infinity and a NaN take the sign flags and the width, and never zeros")
fwf_inf_and_nan_with_flags()
    assert_eq(written(real.infinity, "%+08f"), "    +inf")
    assert_eq(written(-real.infinity, "%-6F"), "-INF  ")
    assert_eq(written(real.nan, "%08.3e"), "     nan")
    assert_eq(written(real.nan, "%+A"), "NAN")
    assert_eq(written(real.infinity, "% a"), " inf")
end fwf_inf_and_nan_with_flags

@test("a '*' reads the width and precision handed over, and 'l' or 'L' is read and ignored")
fwf_star_and_length_modifier()
    assert_eq(written(1.5, "%*.*f", -8, 2), "1.50    ")
    assert_eq(written(1.5, "%*.*f", 8, -1), "1.500000")
    assert_eq(written(1.5, "%lf"), "1.500000")
    assert_eq(written(1.5, "%10.2Le"), "  1.50e+00")
end fwf_star_and_length_modifier

@test("a scratch too short for the request is refused before anything is written, naming a length that does")
fwf_scratch_too_short()
    assert_eq(written(0.1, "%.17g", 0, -1,16), "refused: the scratch needs 17 bytes, wrote ''")
    assert_eq(written(0.1, "%.17g", 0, -1,17), "0.10000000000000001")
    assert_eq(written(1.0, "%e", 0, -1,0), "refused: the scratch needs 7 bytes, wrote ''")

    var sink = byte_sink()
    var scratch: [8]u8

    val needed = write_real(0.1, &sink, "%.40f", 0, -1, scratch[..]) match
        Err(Short(n)) -> n
        _ -> 0

    assert(needed >= 40 && needed <= 60, s"needed $needed")
    assert_eq(written(0.1, "%.40f", 0, -1,needed), format_real(0.1, "%.40f", 0, -1))
end fwf_scratch_too_short

@test("a request that works out no digits needs no scratch at all")
fwf_no_digits_need_no_scratch()
    assert_eq(written(0.1, "%a", 0, -1,0), "0x1.999999999999ap-4")
    assert_eq(written(0.0, "%.20f", 0, -1,0), "0.00000000000000000000")
    assert_eq(written(real.infinity, "%e", 0, -1,0), "inf")
    assert_eq(written(real.nan, "%g", 0, -1,0), "nan")
    assert_eq(written(1e-300, "%.3f", 0, -1,1), "0.000")
end fwf_no_digits_need_no_scratch

@test("float_scratch_len is enough for the longest exact value there is")
fwf_scratch_len_is_enough()
    var sink = byte_sink()
    var scratch: [float_scratch_len]u8

    val subnormal = real.from_bits(0x000fffffffffffff)

    assert(write_real(subnormal, &sink, "%.1100e", 0, -1, scratch[..]).is_ok())
    assert_eq(from_utf8_unchecked(sink.text()), format_real(subnormal, "%.1100e", 0, -1))
end fwf_scratch_len_is_enough

@test("a specifier that is not one float conversion is refused and nothing is written")
fwf_bad_spec()
    for spec in ["", "%", "f", "%d", "%5.2", "%s", "%5.2.1f", "%llf", "%-+q", "%.2Lx", "% 5 f", "%**f",
                 "5f", "%f "]
        assert_eq(written(1.5, spec), "refused: not a float conversion, wrote ''")
end fwf_bad_spec

@test("write_f32 writes a float as C prints it promoted, and as format_f32 renders it")
fwf_f32()
    var sink = byte_sink()
    var scratch: [float_scratch_len]u8

    assert(write_f32(f32(0.1), &sink, "%a", 0, -1, scratch[..]).is_ok())
    assert_eq(from_utf8_unchecked(sink.text()), "0x1.99999ap-4")

    for spec in ["%g", "%.9e", "%.30f", "%+12.4E"]
        var s = byte_sink()

        assert(write_f32(f32(3.3), &s, spec, 0, -1, scratch[..]).is_ok())
        assert_eq(from_utf8_unchecked(s.text()), format_f32(f32(3.3), spec, 0, -1))
end fwf_f32

@test("write_f128 writes every digit binary128 holds, and its %a every hexadecimal one")
fwf_f128()
    var scratch: [f128_scratch_len]u8

    for spec in ["%.30Le", "%Lg", "%.40Lf", "%La", "%.3LA"]
        var s = byte_sink()

        assert(write_f128(f128(0.1), &s, spec, 0, -1, scratch[..]).is_ok())
        assert_eq(from_utf8_unchecked(s.text()), format_f128(f128(0.1), spec, 0, -1))

    var sink = byte_sink()

    assert(write_f128(f128(1.0) / f128(10.0), &sink, "%La", 0, -1, scratch[..]).is_ok())
    assert_eq(from_utf8_unchecked(sink.text()), "0x1.999999999999999999999999999ap-4")
end fwf_f128
