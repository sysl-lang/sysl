// P13: a receiverless member on a tuple and an array instance (a decoder's shape)
trait Decode
    decode(n: int) -> Self

impl Decode for int
    decode(n: int) -> int = n

impl[A: Decode, B: Decode] Decode for (A, B)
    decode(n: int) -> (A, B) = (A.decode(n), B.decode(n + 1))

val t: (int, int) = (int, int).decode(1)
print(t.0, t.1)
