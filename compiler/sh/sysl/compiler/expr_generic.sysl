module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.{str_builder, StrBuilder}

// A call to a generic declaration: its type arguments worked out from what the call supplies, the
// instantiation made real, and the arguments checked against the signature that instantiation has.
//
// **Inference is bidirectional and the order is the whole of the precedence.** What already carries a
// type of its own settles a parameter first, the type the position expects settles what is left, and
// a bare literal's default only reaches a parameter nothing else did.

// `'A', 'B'` -- the type parameters a declaration wrote, for a message that has to say which.
quoted_names(names: Buf[string]) -> string
    var out = ""

    for i in 0..<names.len()
        if i > 0 then out = out + ", "

        out = out + s"'${names.at(i)}'"

    out
end quoted_names

// `f[int](x)` -- the instantiation the reader named.
//
// **Written out, the type arguments are what settle the instantiation and nothing else is
// consulted**: not the arguments, and not the type the position expects. Their whole reason for
// existing is the call inference cannot reach, so a solve running first would report a failure about
// a question the reader has already answered.
written_generic_call(cx: &Analyzer, span: Span, written: string, targ_exprs: Buf[Expr],
                     args: Buf[Expr], expected: Option[Type]) -> TExpr
    val keys = function_keys(cx, written)

    if keys.is_empty()
        val captured = body_only_call(cx, span, written)

        if captured.is_some() then return captured.unwrap()

        return cx.err(span, s"undefined function '$written'")
    end if

    var key = keys.at(0)

    for item in keys
        val f = cx.an.tables.funcs.get(item)

        if f.is_some() && authored_tparams(f.unwrap().decl.tparams).len() == targ_exprs.len() then
            key = item

    val f = cx.an.tables.funcs.get(key).unwrap()
    val decl = f.decl
    val authored = authored_tparams(decl.tparams)

    if decl.tparams.is_empty() then
        return cx.err(span, s"'$written' is not generic, so it has no type arguments to write — " +
                      s"the call is '$written(…)'")

    // **The parameters are named**, since a declaration carrying the sugar's own has more of them
    // than the reader wrote and a bare count would be a number they could not check.
    if authored.len() != targ_exprs.len() then
        return cx.err(span, s"'$written' takes ${quantity(authored.len(), "type argument")} " +
                      s"(${quoted_names(authored)}), and ${targ_exprs.len()} " +
                      s"${if targ_exprs.len() == 1 then "was" else "were"} written")

    // **A bare arrow is sugar for a bounded type parameter the compiler added and no program wrote**,
    // so a declaration carries more parameters than were written on it. The list fills the ones that
    // were, and the sugar's own stay where they have always come from, which is the arguments.
    if authored.len() != decl.tparams.len()
        var known: Buf[Binding] = buf()

        for i in 0..<authored.len()
            known.push(Binding(authored.at(i), written_arg_for(cx, f, authored.at(i), targ_exprs.at(i))))

        for b in known
            if b.ty == Unknown then return bad_expr(span)

        return generic_call_with(cx, span, written, key, f, args, expected, true, known)
    end if

    var targs: Buf[Type] = buf()

    for i in 0..<targ_exprs.len()
        targs.push(written_arg_for(cx, f, authored.at(i), targ_exprs.at(i)))

    // **An argument already refused instantiates nothing**: the body read with that parameter bound
    // to nothing would report every use of it as a name nobody declared.
    for t in targs
        if t == Unknown then return bad_expr(span)

    // **A BOUND IS RESOLVED WHERE IT WAS WRITTEN, WHICH IS THE DECLARATION'S SCOPE AND NOT THE
    // CALLER'S.** `sysl.math.is_power_of_two[T: Bits + Ord]` writes `Bits` bare, and a caller that
    // imported `sysl.math` has the module and not that name -- so resolving the bound here would
    // leave it naming nothing, and every integer would be refused for not implementing the trait
    // the compiler supplies to all of them. `Ord` hid it, being auto-imported and so resolvable
    // from either place.
    if !check_param_bounds(cx.an, f.scope, span, key, decl.tparams, decl.bounds, targs, buf(),
                           "type parameter", cx.scope) then return bad_expr(span)

    if !stand_ins_hold(cx.an, f.scope, cx.scope, span, key, decl, decl.tparams, targs) then
        return bad_expr(span)

    val name = asked(cx, span, instantiate_func(cx.an, f.scope, decl, targs, false))
    val sig = cx.an.tables.members.func_insts.get(name)

    if sig.is_none() then return bad_expr(span)

    val bound = bind_arguments(cx, span, written, f, args, true)

    if bound.is_none() then return bad_expr(span)

    val before = cx.an.complaints()
    var ts: Buf[TExpr] = buf()
    var wants: Buf[Type] = buf()
    var unread: Buf[usize] = buf()
    val slots = bound.unwrap()

    for i in 0..<slots.len()
        val want = walk_wanted(decl.params.at(i), if i < sig.unwrap().params.len()
                                                  then sig.unwrap().params.at(i).1 else Unknown)

        wants.push(want)

        slots.at(i) match
            Some(e) -> ts.push(argument_at(cx, decl, i, e, want, buf()))
            None ->
                val inner = default_reader(cx, span, f.scope, name, decl.bounds)
                val read = default_at(inner, decl.params.at(i).default.unwrap(), want)

                if read.is_none() then unread.push(i)

                ts.push(read.unwrap_or(bad_expr(span)))

    val refused = refused_argument(cx, span, s"'$written'", decl.params, slots, ts, wants, before,
                                   true, unread)

    if refused.is_some() then return refused.unwrap()

    for i in 0..<slots.len()
        ts.set(i, handed_walk(decl.params.at(i), slots.at(i), ts.at(i)))

    cx.an.uses(name)
    TExpr(span, TCall(name, ts, sig.unwrap().ret, false))
end written_generic_call

// One type argument as a **call** writes it, which is an expression: brackets in an expression are
// indexing, so what a reader writes between them here is read back as the type it names.
written_type_arg(cx: &Analyzer, e: Expr) -> Type = type_arg_read(cx, e, false)

// One written argument of a generic function, read against the parameter it fills: where the
// declaration wrote `const` of a simple enum, the argument is one of its variants -- bare, the
// parameter's type saying which enum, or qualified -- and otherwise it reads as any type argument.
private written_arg_for(cx: &Analyzer, f: Func, name: string, e: Expr) -> Type =
    arg_for(cx, f.decl.tvalues, f.scope, f.decl.name, name, e, false)

// The same at an address, `&f[K]`, which reads its brackets exactly as a call does: a `const`, or
// arithmetic over one, where the declaration wrote `const`, and a type everywhere else -- whose
// refusal advises writing the type on the binding instead, there being no call to infer it from.
address_arg_for(cx: &Analyzer, f: Func, name: string, e: Expr) -> Type =
    arg_for(cx, f.decl.tvalues, f.scope, f.decl.name, name, e, true)

// One written argument of a generic MEMBER's own parameter, `b.pick[TWO](…)` or `&Sq.pick[TWO]`,
// read the same way against the member's own declaration, whose types resolve where it was written.
member_arg_for(cx: &Analyzer, m: MethodDecl, home: Scope, name: string, e: Expr,
               at_address: bool) -> Type =
    arg_for(cx, m.tvalues, home, source_member_name(m.name), name, e, at_address)

private arg_for(cx: &Analyzer, tvalues: Buf[TypeBinding], scope: Scope, owner: string, name: string,
                e: Expr, at_address: bool) -> Type
    val declared = binding_named(tvalues, name)

    if declared.is_some()
        val ty = nameless(resolve_type(cx.an, scope, declared.unwrap(), no_bindings()))

        // **Anything else written for a value parameter is a value**: a `const` it names, or an
        // expression run while compiling, `f[sq(3)]()` -- never a type, whatever its spelling.
        return value_written(cx, e, ty, s"'$name' of '$owner'")
    end if

    stand_in_arg(cx, e) match
        Some(t) -> t
        None -> type_arg_read(cx, e, at_address)
end arg_for

// A trait written as a generic **function's** type argument, `send[Port](p, v)`, which is the
// binding a `*Port` handed to its `*P` parameter makes (`stand_in.sysl`): the trait itself. A
// parameter already standing for one is handed on the same way, `inner[P](p)`. Nothing for any other
// argument, which reads as a type does. A generic type's argument is never read here -- a type's
// fields are laid out, and a trait has no layout.
stand_in_arg(cx: &Analyzer, e: Expr) -> Option[Type]
    val name = *e.kind match
        Ident(n) -> Some(n)
        Field(_, _, _) -> dotted_path_of(e)
        _ -> None

    if name.is_none() then return None

    val stood = bound_type(cx.subst, name.unwrap())

    if stood.is_some() then return if is_trait(stood.unwrap()) then stood else None

    val key = lookup_type_key(cx.an, cx.scope, name.unwrap())

    if key.is_none() || trait_decl_at(cx.an, key.unwrap()).is_none() then return None

    // Read as the object it will be, so a trait no table can be made for is refused as one.
    resolve_type(cx.an, cx.scope, type_ref(e.span, PtrType(named_type(e.span, name.unwrap()))),
                 cx.subst) match
        Ptr(t) -> Some(*t)
        _ -> Some(Unknown)
end stand_in_arg

// One argument written for a value parameter of type `ty`: a value whatever its spelling. A number
// travels at the width a length does, as one written as a literal does. `subject` names the
// parameter and its owner for a refusal of the argument's type.
private value_written(cx: &Analyzer, e: Expr, ty: Type, subject: string) -> Type
    val got = enum_value_arg(cx.an, cx.scope, anchor_of(e), e, ty, cx.subst, subject)

    ty match
        Integer(_, _, _) -> got match
            ConstArg(v, _, stood) -> ConstArg(v, usize_type(word_bits(cx)), stood)
            other -> other
        _ -> got
end value_written

// The arguments written for a generic **type**, `Ring[int, cap(8)](…)`, each read against the
// parameter it fills: a value where the declaration wrote `const`, a type everywhere else.
written_type_args_for(cx: &Analyzer, key: string, targ_exprs: Buf[Expr]) -> Buf[Type]
    val decl = cx.an.tables.types.get(key)
    var params: Buf[string] = buf()
    var values: Buf[TypeBinding] = buf()

    if decl.is_some()
        decl.unwrap().kind match
            StructOf(d) ->
                params = d.tparams
                values = d.tvalues
            EnumOf(d) ->
                params = d.tparams
                values = d.tvalues
            _ -> ()
    end if

    var out: Buf[Type] = buf()

    for i in 0..<targ_exprs.len()
        val declared = if i < params.len() then binding_named(values, params.at(i)) else None

        if declared.is_some()
            val ty = nameless(resolve_type(cx.an, decl.unwrap().scope, declared.unwrap(), no_bindings()))

            out.push(value_written(cx, targ_exprs.at(i), ty, s"'${params.at(i)}' of '${generic_type_name(cx.an, key)}'"))
        else
            // A bare name is read as the type grammar reads one, where a parameter a trait object
            // stands in for may be an argument the type holds behind a mode (`resolve_type.sysl`).
            val e = targ_exprs.at(i)

            out.push(*e.kind match
                Ident(n) -> type_arg_of(cx.an, cx.scope, key, i, named_type(e.span, n), cx.subst)
                _ -> written_type_arg(cx, e))
        end if

    out
end written_type_args_for

private type_arg_read(cx: &Analyzer, e: Expr, at_address: bool) -> Type = *e.kind match
    Ident(n) -> resolve_type(cx.an, cx.scope, named_type(e.span, n), cx.subst)
    // A **value** argument is written as the number it is, which is the one place the two grammars
    // agree without a conversion. It travels at the width a length does, so a copy the reader named
    // and one a call read off an argument are the same instantiation and not two.
    IntLit(_, _, _) -> const_arg_at(cx, e)
    Index(head, one, _) -> applied_type_arg(cx, anchor_of(e), head, one_arg(one), at_address)
    TypeArgs(head, inner, _) -> applied_type_arg(cx, anchor_of(e), head, inner, at_address)
    // A type only the type grammar could read is already written as one.
    TypeArg(written) -> resolve_type(cx.an, cx.scope, written, cx.subst)
    // The three the two grammars share a spelling for. `*T` and `&T` are a unary operator in an
    // expression and a qualifier in a type; a tuple is parentheses either way. Everything else has
    // no spelling here at all, which the refusal below is what says.
    Unary(op, inner) ->
        if op == "*" then resolve_type(cx.an, cx.scope, type_ref(e.span,
            PtrType(written_type_ref(cx, inner, at_address))), cx.subst)
        else if op == "&" then resolve_type(cx.an, cx.scope, type_ref(e.span,
            RefType(written_type_ref(cx, inner, at_address), false)), cx.subst)
        else not_a_type_arg(cx, e, at_address)
    Tuple(parts) ->
        var written: Buf[TypeRef] = buf()

        for item in parts
            written.push(written_type_ref(cx, item, at_address))

        resolve_type(cx.an, cx.scope, type_ref(e.span, TupleType(written, false)), cx.subst)
    // A dotted path is one name to the type grammar, so `mod.Box` is read as the word it is.
    Field(_, _, _) -> dotted_type_arg(cx, e, at_address)
    // `T::Item` and `f::Type` -- a projection off a name, which the type grammar spells the same way.
    TypeAttr(head, member, _, _) -> *head.kind match
        Ident(n) -> resolve_type(cx.an, cx.scope, type_ref(e.span,
            AssocType(named_type(head.span, n), member)), cx.subst)
        _ -> not_a_type_arg(cx, e, at_address)
    _ -> not_a_type_arg(cx, e, at_address)

private not_a_type_arg(cx: &Analyzer, e: Expr, at_address: bool) -> Type
    var advice = "Annotate what receives the result and let the call infer it instead"

    if at_address then advice = "Write the type on the binding instead: 'var f: *extern(…) -> … = &…'"

    cx.fault(anchor_of(e), "this is not a type — what is written in the brackets is a type argument, " +
             "and they read it out of the expression grammar, so a slice, a 'weak', a 'volatile', " +
             s"a vector and a callable have no spelling here. $advice")

    Unknown
end not_a_type_arg

// The same, stopped one step earlier: a written type rather than a resolved one, so that a pointer
// to a pointer nests without each level being resolved on its own.
private written_type_ref(cx: &Analyzer, e: Expr, at_address: bool) -> TypeRef = *e.kind match
    Ident(n) -> named_type(e.span, n)
    Unary(op, inner) ->
        if op == "*" then type_ref(e.span, PtrType(written_type_ref(cx, inner, at_address)))
        else if op == "&" then type_ref(e.span, RefType(written_type_ref(cx, inner, at_address), false))
        else
            not_a_type_arg(cx, e, at_address)
            named_type(e.span, "")
    Field(_, _, _) ->
        val path = dotted_path_of(e)

        if path.is_none()
            not_a_type_arg(cx, e, at_address)
            named_type(anchor_of(e), "")
        else named_type(anchor_of(e), path.unwrap())
    // An applied generic behind a pointer or a reference -- `&Box[i32]` -- nests the same way.
    Index(head, one, _) -> applied_type_ref(cx, anchor_of(e), head, one_arg(one), at_address)
    TypeArgs(head, inner, _) -> applied_type_ref(cx, anchor_of(e), head, inner, at_address)
    TypeArg(written) -> written
    _ ->
        not_a_type_arg(cx, e, at_address)
        named_type(e.span, "")

private dotted_type_arg(cx: &Analyzer, e: Expr, at_address: bool) -> Type
    val path = dotted_path_of(e)

    if path.is_none() then return not_a_type_arg(cx, e, at_address)

    resolve_type(cx.an, cx.scope, named_type(anchor_of(e), path.unwrap()), cx.subst)
end dotted_type_arg

// The name a written type argument applies its own arguments to -- `Box` in `Box[int]`, and the
// whole dotted path in `mod.Box[int]`, which is one name to the type grammar.
private dotted_path_of(e: Expr) -> Option[string] = *e.kind match
    Ident(n) -> Some(n)
    Field(inner, n, _) -> dotted_path_of(inner).map(head -> s"$head.$n")
    _ -> None

// A written number as a value argument, at the width every other value argument travels at.
private const_arg_at(cx: &Analyzer, e: Expr) -> Type
    val whole = resolve_type(cx.an, cx.scope, type_ref(e.span, ValueArgType(e)), cx.subst)

    whole match
        ConstArg(v, _, stood) -> ConstArg(v, usize_type(word_bits(cx)), stood)
        other -> other
end const_arg_at

private one_arg(e: Expr) -> Buf[Expr]
    var out: Buf[Expr] = buf()

    out.push(e)
    out
end one_arg

// A generic type applied to arguments, written the way an expression spells it.
private applied_type_arg(cx: &Analyzer, span: Span, head: Expr, inner: Buf[Expr],
                         at_address: bool) -> Type
    val name = *head.kind match
        Ident(n) -> Some(n)
        _ -> None

    if name.is_none()
        cx.fault(span, "a type argument is a type, and this is not one")
        return Unknown
    end if

    resolve_type(cx.an, cx.scope, applied_type_ref(cx, span, head, inner, at_address), cx.subst)
end applied_type_arg

// The written form of an applied generic: each argument a type where it is spelled as one -- a
// name, a pointer, a reference, another application -- and a value argument otherwise.
private applied_type_ref(cx: &Analyzer, span: Span, head: Expr, inner: Buf[Expr],
                         at_address: bool) -> TypeRef
    val name = *head.kind match
        Ident(n) -> n
        _ -> ""

    var refs: Buf[TypeRef] = buf()

    for arg in inner
        *arg.kind match
            Ident(n) -> refs.push(named_type(arg.span, n))
            Unary(op, _) if op == "*" || op == "&" -> refs.push(written_type_ref(cx, arg, at_address))
            Index(_, _, _) -> refs.push(written_type_ref(cx, arg, at_address))
            TypeArgs(_, _, _) -> refs.push(written_type_ref(cx, arg, at_address))
            TypeArg(_) -> refs.push(written_type_ref(cx, arg, at_address))
            _ -> refs.push(type_ref(arg.span, ValueArgType(arg)))


    type_ref(span, NamedType(name, refs))
end applied_type_ref

// One call to a generic function.
generic_call(cx: &Analyzer, span: Span, written: string, key: string, f: Func, args: Buf[Expr],
             expected: Option[Type], report: bool) -> TExpr =
    generic_call_with(cx, span, written, key, f, args, expected, report, no_bindings())

// The same, where a written type-argument list has already answered some of the parameters. That is
// the bare-arrow case and only that one: the list fills what the declaration wrote and the sugar's
// own parameters are solved from the arguments, so `known` is never the whole set.
//
// `nested` is the nested function the call is made to, where it is one: its instantiation is a member
// of the environment the call is made on, which goes in front of what the reader wrote.
// Whether a declaration asks `Debug` of one of its type parameters.
private asks_debug(bounds: Buf[NamedBounds], tparam: string) -> bool
    for nb in bounds
        if nb.name == tparam
            for b in nb.bounds
                if b.name == "Debug" || b.name == "sysl.Debug" then return true

    false
end asks_debug

generic_call_with(cx: &Analyzer, span: Span, written: string, key: string, f: Func, args: Buf[Expr],
                  expected: Option[Type], report: bool, known: Buf[Binding],
                  nested: Option[&Nested] = None) -> TExpr
    val shown = if nested.is_some() then s"'$written'" else s"function '$written'"
    val bound = bind_params(cx, span, shown, f.decl.params, f.decl.variadic, args, report)

    if bound.is_none() then return bad_expr(span)

    val slots = bound.unwrap()
    val decl = f.decl

    // **Asked before the solve rather than left to it**, because the solve can only report what it
    // failed to find and the answer here is that it was never going to find it: a parameter named in
    // neither the parameters nor the result is one nothing in a call could settle. A parameter the
    // reader has just written out is not stuck, whatever the declaration says about where it appears.
    val stuck = not_bound(unsettleable(decl), known)

    if !stuck.is_empty()
        if report
            val names = quoted_and(stuck)
            val is_are = if stuck.len() == 1 then "is" else "are"
            val it_them = if stuck.len() == 1 then "it" else "them"

            cx.fault(span, s"$names $is_are in neither the parameters of '$written' nor its " +
                     s"result, so nothing in this call says what $it_them should be — write " +
                     s"$it_them out, as '$written[…](…)'")
        else cx.fault(span, "unsettleable")

        return bad_expr(span)
    end if

    val prov = provisional_of(cx, span, f.scope, decl.tparams, decl.params, decl.ret_type,
                              decl.bounds, slots, known, expected, decl.needs)
    var param_refs: Buf[TypeRef] = buf()

    for param in decl.params
        param_refs.push(param.typ)

    val covered = enter_signature(cx.an, decl.needs)
    val targs = solve(cx.an, f.scope, cx.scope, span, key, decl.tparams, param_refs, prov.tys, decl.ret_type,
                      expected, prov.soft, decl.bounds, known, left_to_default(slots))

    leave_reaching(cx.an, covered)

    if !report
        for targ in targs
            if targ == Unknown
                cx.fault(span, "not inferable")
                return bad_expr(span)

    // **An argument that could not be worked out ends the call rather than instantiating at it.**
    // The mistake that left it unknown has been reported where it was made -- or deliberately
    // suppressed as a consequence of one -- and a body made real at `?` would complain again from
    // inside the declaration, about a line the reader did not write.
    for targ in targs
        if targ == Unknown
            voice_unknown_args(cx, slots, prov)
            return bad_expr(span)
        end if

    // A type argument that does not meet what the declaration asked of it ends the call: the body
    // would be read at a type the bound was supposed to have ruled out, and every complaint that
    // came back would be a consequence of this one.
    if !check_param_bounds(cx.an, f.scope, span, key, decl.tparams, decl.bounds, targs, buf(),
                           "type parameter", cx.scope) then return bad_expr(span)

    if !stand_ins_hold(cx.an, f.scope, cx.scope, span, key, decl, decl.tparams, targs) then
        return bad_expr(span)

    // An argument meeting a `T: Debug` bound only as a placeholder -- `assert_eq` over two writer
    // objects -- is shown as that placeholder, and the call is told so as `print` would be. A call the
    // library makes is a part of some larger rendering, never something a program wrote.
    val written_here = !from_library(cx.an, cx.scope)

    for i in 0..<decl.tparams.len()
        if written_here && i < targs.len() && asks_debug(decl.bounds, decl.tparams.at(i))
            val found = placeholder_of(cx, targs.at(i))

            if found.is_some() then
                cx.an.caution(cx.scope, span, s"'$written' shows its '${decl.tparams.at(i)}' only as " +
                              s"'${found.unwrap().0}': ${found.unwrap().1}")
        end if

    val name = asked(cx, span, instantiated(cx, f, targs, nested))
    val sig = cx.an.tables.members.func_insts.get(name)

    if sig.is_none() then return bad_expr(span)

    // A nested instantiation's signature has the environment in front of what a call writes.
    val skip: usize = if nested.is_some() then 1 else 0

    // **A type with a `Drop` is a reference type, and an instantiation whose signature holds one by
    // value is refused here, at the call that asked for it** -- never inside the generic body, whose
    // bindings would name a declaration the caller did not write (`drop_values.sysl`). `T` bound to
    // the type is fine where the signature only reaches it through a `&T`. A call inside a body that
    // is a generic's instance is asked at its types and says which instance it is in
    // (`calls_are_asked`).
    if calls_are_asked(cx) && signature_holds_drop(cx.an, sig.unwrap(), skip)
        for i in 0..<targs.len()
            if i >= decl.tparams.len() then break

            val held = drop_held(cx.an, targs.at(i))

            if held.is_some() then
                return cx.err(span, refused_in(cx.an, cx.scope, cx.subst, cx.func_name,
                                               drop_value_refusal(s"'$written' binds its " +
                                                                  s"'${decl.tparams.at(i)}' to",
                                                                  targs.at(i), held.unwrap())))
        end for
    end if

    var written_params: Buf[(string, Type)] = buf()

    for i in skip..<sig.unwrap().params.len()
        written_params.push(sig.unwrap().params.at(i))

    val before = cx.an.complaints()
    var ts: Buf[TExpr] = buf()
    var wants: Buf[Type] = buf()
    var unread: Buf[usize] = buf()

    for i in 0..<slots.len()
        val want = walk_wanted(decl.params.at(i), if i < written_params.len()
                                                  then written_params.at(i).1 else Unknown)

        wants.push(want)

        slots.at(i) match
            Some(e) ->
                // A callable was read once, against the bound the solve had settled by then, and
                // the node is the one that reading made: reading it again would lower a second
                // closure for the one a program wrote.
                var t = bad_expr(e.span)

                if i < prov.kept.len() && prov.kept.at(i).is_some()
                    // **A callable is read against the BOUND its parameter states, which says
                    // nothing about how the parameter holds it.** A written `&Fn(…) -> T` is a
                    // trait object, so what came back is the closure's own struct and the position
                    // is what puts it behind the table -- exactly as it would for a parameter
                    // naming no type of the declaration's.
                    t = prov.kept.at(i).unwrap()

                    if disagree(texpr_type(t), want) then t = coerce(cx, t, want)
                else t = argument_at(cx, decl, i, e, want, not_bound(decl.tparams, known))

                ts.push(t)
            // A default that was read while the solve was settling is the node the program gets:
            // reading it again would lower a second closure for the one the declaration wrote.
            None ->
                if i < prov.kept.len() && prov.kept.at(i).is_some()
                    val kept = prov.kept.at(i).unwrap()

                    if disagree(texpr_type(kept), want) then ts.push(coerce(cx, kept, want))
                    else ts.push(kept)
                else
                    val inner = default_reader(cx, span, f.scope, name, decl.bounds)
                    val read = default_at(inner, decl.params.at(i).default.unwrap(), want)

                    if read.is_none() then unread.push(i)

                    ts.push(read.unwrap_or(bad_expr(span)))

    val refused = refused_argument(cx, span, s"'$written'", decl.params, slots, ts, wants, before,
                                   report, unread)

    if refused.is_some() then return refused.unwrap()

    for i in 0..<slots.len()
        ts.set(i, handed_walk(decl.params.at(i), slots.at(i), ts.at(i)))

    // The tail of a variadic definition, which no parameter names and so no solution reaches: it
    // is read exactly as a non-generic callee's is, so a `null` there has no context either.
    if decl.variadic
        for i in slots.len()..<args.len()
            ts.push(variadic_extra(cx, args.at(i), false))

    check_crossings(cx, decl.crossing, decl.marks.copies, written, written_params, ts)
    check_shared_result(cx, span, sig.unwrap().ret)
    cx.an.uses(name)

    if nested.is_none() then return TExpr(span, TCall(name, ts, sig.unwrap().ret, false))

    var supplied: Buf[TExpr] = buf()

    supplied.push(nested.unwrap().env)

    for t in ts
        supplied.push(t)

    TExpr(span, TCall(name, supplied, sig.unwrap().ret, false))
end generic_call_with

// The instantiation a solved call goes to: a top-level generic's, or a nested one's filed beside the
// environment it is a member of.
private instantiated(cx: &Analyzer, f: Func, targs: Buf[Type], nested: Option[&Nested]) -> string
    if nested.is_none() then return instantiate_func(cx.an, f.scope, f.decl, targs, false)

    val fname = nested.unwrap().fname

    instantiate_nested(cx.an, fname, cx.an.tables.nested_generics.get(fname).unwrap(), targs)
end instantiated

// The type parameters somebody **wrote**, which are the ones an explicit list fills. A bare arrow is
// sugar for a bounded parameter, and those are named with a character no identifier may hold,
// precisely so that no program can write one -- there being nothing to write anyway, the argument
// being the closure's own anonymous type.
authored_tparams(tparams: Buf[string]) -> Buf[string]
    var out: Buf[string] = buf()

    for tparam in tparams
        if !is_call_bound(tparam) then out.push(tparam)

    out
end authored_tparams

// The names of `these` that a written list has not already answered.
private not_bound(names: Buf[string], known: Buf[Binding]) -> Buf[string]
    var out: Buf[string] = buf()

    for item in names
        if bound_type(known, item).is_none() then out.push(item)

    out
end not_bound

// One argument of a generic call, read at the parameter the solve arrived at.
//
// **An argument standing at a parameter that was still being solved was read with nothing expected
// of it**, so what a position would have done to it -- boxing a value into a `&T`, giving up the
// ability to write a view, erasing into an object -- is done *here*, once the parameter is known,
// rather than inside the reading. That is what makes `copy(bigger, self.elems[0..])` a writable view
// with the const view around it, which is what the position performs and what the reference records.
//
// A **literal** is the one case that cannot be repaired afterwards, because a literal does not
// convert -- it *is* the type its position gives it. So it is read against the parameter it turned
// out to have, and so is an `if` or a `match` every arm of which is one (`literal_valued`). A
// written-out array standing where a slice was asked for is the other: by the time there is an array
// to coerce, the storage has been made as one.
//
// **A conversion never decides a type parameter**: an argument at a parameter that names one the
// solve worked out (`solved`) is held to the type it was solved at exactly, so `max(n, l)` over an
// `int` and a `long` is refused in either order. One whose parameters were all written out, or that
// names none, widens as any argument does.
private argument_at(cx: &Analyzer, decl: FuncDecl, i: usize, e: Expr, want: Type,
                    solved: Buf[string]) -> TExpr
    val widen = i >= decl.params.len() || !ref_mentions(decl.params.at(i).typ, solved)

    if i >= decl.params.len() || !ref_mentions(decl.params.at(i).typ, decl.tparams) ||
            literal_valued(cx, e) then
        return typed_widening(cx, e, want, widen)

    // **The bare reading is a probe, so what it could not answer is not a complaint.** A form with
    // no type of its own -- a nullary variant of a generic enum, `None` standing at a `T` the solve
    // has since settled -- has nothing to say with nothing expected of it, and the parameter is what
    // it should have been read against all along. The probe is rewound and that reading is the one
    // the program gets.
    val tried = begin_trial(cx)
    val bare = type_expr(cx, e, None)

    if refused_since(cx, tried)
        discard_trial(cx, tried)
        return typed_widening(cx, e, want, widen)

    keep_trial(cx)

    if becomes_slice(texpr_type(bare), want) then return type_expr(cx, e, Some(want))

    val fitted = coerce(cx, bare, want)

    if !disagree(texpr_type(fitted), want) then return fitted

    // What the position could not repair is read again against the parameter, and kept only where
    // that answers -- otherwise the first reading is what the complaint should name.
    val again = typed_widening(cx, e, want, widen)

    if disagree(texpr_type(again), want) then fitted else again
end argument_at

private typed_widening(cx: &Analyzer, e: Expr, want: Type, widen: bool) -> TExpr =
    if widen then type_expr(cx, e, Some(want)) else type_expr_unwidened(cx, e, Some(want))

// **An argument the solve could not read is read once more, for real, so that what it could not
// answer is said.** The provisional reading is sandboxed, so a `null` or a `None` at a parameter
// nothing else settled came back unknown with its complaint rewound -- and the solve, seeing an
// unknown argument, rightly stays quiet about the parameter it could not solve, taking the argument
// to have spoken already. This is where it does: `one(null)` is told that `null` takes its type from
// its context, and `one(None)` that nothing says what the `Option` holds. A callable was read
// outside the sandbox and has already said what it had to. Only the leftmost speaks, as in the
// reference: `two(null, null)` is one mistake written twice.
voice_unknown_args(cx: &Analyzer, slots: Buf[Option[Expr]], prov: Provisional)
    for i in 0..<slots.len()
        val kept = i < prov.kept.len() && prov.kept.at(i).is_some()

        if !kept && slots.at(i).is_some() && i < prov.tys.len() && mentions_unknown(prov.tys.at(i))
            type_expr(cx, slots.at(i).unwrap(), None)
            return
        end if
end voice_unknown_args

// A written-out array where a view of it was asked for, which is the one conversion the analysis
// performs rather than one the position repairs afterwards.
private becomes_slice(actual: Type, want: Type) -> bool
    unqualified(actual) match
        Array(_, _) -> unqualified(want) match
            Slice(_, _) -> true
            _ -> false
        _ -> false
end becomes_slice

// The type parameters a call can settle nothing about: the ones named in neither the parameters nor
// the result.
//
// A bare arrow is sugar for a bounded parameter, so a declaration written `f(g: A -> B)` carries the
// types in a *bound* rather than in a parameter -- and a walk over the written parameter types no
// longer sees them.
private unsettleable(d: FuncDecl) -> Buf[string]
    var out: Buf[string] = buf()

    for tp in d.tparams
        var one: Buf[string] = buf()

        one.push(tp)

        var named = false

        for j in 0..<d.params.len()
            if ref_mentions(d.params.at(j).typ, one) then named = true

        if d.ret_type.is_some() && ref_mentions(d.ret_type.unwrap(), one) then named = true

        for j in 0..<d.bounds.len()
            val nb = d.bounds.at(j)

            for k in 0..<nb.bounds.len()
                if any_ref_mentions(nb.bounds.at(k).args, one) then named = true

        if !named then out.push(tp)

    out
end unsettleable

private quoted_and(names: Buf[string]) -> string
    var b = str_builder()

    for i in 0..<names.len()
        if i > 0 then b.push(" and ")

        b.push(s"'${names.at(i)}'")

    b.finish()
end quoted_and

// What each argument reads as before the type arguments are known, and whether reading it took a
// **literal's default** for want of anything better -- which is what the tiering turns on.
//
// An argument standing at a parameter whose type names none of the declaration's own parameters is
// read against that type, exactly as a call to something non-generic reads it. Everything else is
// read on its own, with what it said put back: the reading is a guess made to solve with, and a
// complaint about a guess is one nobody asked for.
// **What the call's own position asks for is part of the reading**, and not only of the solve after
// it: a parameter named by the result alone is settled by nothing else, and a callable standing at a
// bound over it is then read with a result nothing fixed — so its body decides one, and the closure
// implements a call trait the declaration did not ask for.
//
// What a first reading of a call's arguments settled: the type each one came to, whether it was a
// literal's default, and the node itself where the argument is one that was **kept**.
//
// A callable is the one shape with no type of its own -- a closure's parameters come from its
// context and a bare function name is a callable only where one is asked for -- so it is held back
// from the first pass and read once the others have said what the parameter it stands at takes.
// The node is kept because reading it again would lower a second closure for the one a program
// wrote.
struct Provisional
    tys: Buf[Type]
    soft: Buf[bool]
    kept: Buf[Option[TExpr]]
end Provisional

// Which positions a call left to a parameter's default -- the literals among them are the last thing
// `solve` consults, after every literal the call wrote.
left_to_default(slots: Buf[Option[Expr]]) -> Buf[bool]
    var out: Buf[bool] = buf()

    for slot in slots
        out.push(slot.is_none())

    out

// The reading itself, for a free function and for a member alike. `known` is what the caller
// already settled -- a member's receiver answers the type's own parameters before an argument is
// read -- and `expected` is what the call's own position asks for.
provisional_of(cx: &Analyzer, span: Span, scope: Scope, tparams: Buf[string], params: Buf[Param],
               result: Option[TypeRef], bounds: Buf[NamedBounds], slots: Buf[Option[Expr]],
               known: Buf[Binding], expected: Option[Type], needs: Buf[string]) -> Provisional
    var tys: Buf[Type] = buf()
    var soft: Buf[bool] = buf()
    var kept: Buf[Option[TExpr]] = buf()
    var held: Buf[usize] = buf()

    // **A default stands exactly where the argument would have been**, so it says as much about a
    // type parameter as a written argument does -- and a call that left one out would otherwise have
    // nothing to settle that parameter from. It is read in the DECLARATION's own terms, which is
    // where its names mean what they meant.
    var written: Buf[Option[Expr]] = buf()

    for i in 0..<slots.len()
        if slots.at(i).is_some() then written.push(slots.at(i))
        else written.push(params.at(i).default)

    for i in 0..<slots.len()
        val p = params.at(i)

        kept.push(None)

        val e = written.at(i)
        val inner = arg_reader(cx, span, scope, slots.at(i).is_none())

        if e.is_none()
            tys.push(Unknown)
            soft.push(true)
        else if callable_arg(inner, e.unwrap())
            // Held back: an argument with no type of its own has nothing to unify, so the parameter
            // it stands at is settled by the others or by nothing at all -- and waiting cannot lose
            // the solution.
            held.push(i)
            tys.push(Unknown)
            soft.push(true)
        else if !ref_mentions(p.typ, unsolved_names(tparams, known))
            val want = signature_type(cx.an, needs, scope, p.typ, known)
            val t = sandboxed_arg(inner, e.unwrap(), Some(want))

            tys.push(texpr_type(t))
            soft.push(false)
        else
            // **A bare reading that was refused unifies nothing**: it is waited on like a callable,
            // so the parameter it stands at is settled by the others -- `first(Some(5000000000),
            // wide)` is an `Option[u64]` call, where reading the literal alone refuses it at `int`
            // -- and the second pass reads it against that. Taken as a hard `?` it would have
            // settled the parameter at nothing, ahead of an argument that knew.
            sandboxed_attempt(inner, e.unwrap()) match
                Some(t) ->
                    tys.push(texpr_type(t))
                    soft.push(adaptable(e.unwrap(), t) || literal_valued(cx, e.unwrap()))
                None ->
                    tys.push(Unknown)
                    soft.push(true)

    if held.is_empty() then return Provisional(tys, soft, kept)

    // What the first pass settles, in the three tiers `solve` reads: what carries a type of its own
    // first, the expected type next, and a literal's default only where neither reached it. A held
    // argument is then read against that, which is what makes `collect([1, 2, 3], n -> s"<${n}>")`
    // a call whose closure knows what it takes.
    var param_refs: Buf[TypeRef] = buf()

    for param in params
        param_refs.push(param.typ)

    var sub: Buf[Binding] = buf()

    for item in known
        sub.push(item)

    for i in 0..<param_refs.len()
        if i < tys.len() && !soft.at(i) then
            unify(cx.an, scope, param_refs.at(i), tys.at(i), tparams, &sub)

    // **What is still open is asked by NAME, never by counting `sub`**: `known` may carry a `Self`
    // beside the receiver's arguments, which is no parameter of the solve, and counted it makes a
    // member's own `A` look settled -- so the literal that would have settled it is never read and
    // `W(4).fold(1, (a, n) -> a + n)` hands its closure nothing to take.
    if !unsolved_names(tparams, sub).is_empty() && result.is_some() && expected.is_some() then
        unify(cx.an, scope, result.unwrap(), expected.unwrap(), tparams, &sub)

    // **A literal the call WROTE outranks one it left to a default**, wherever the two stand: in
    // `k[T](a: T = 1.5, b: T = 2)` called as `k(b = 3)`, the `3` settles `T = int` and it is the
    // default that is then refused, never the argument the reader wrote.
    if !unsolved_names(tparams, sub).is_empty()
        for i in 0..<param_refs.len()
            if i < tys.len() && soft.at(i) && tys.at(i) != Unknown && slots.at(i).is_some() then
                unify(cx.an, scope, param_refs.at(i), tys.at(i), tparams, &sub)

    if !unsolved_names(tparams, sub).is_empty()
        for i in 0..<param_refs.len()
            if i < tys.len() && soft.at(i) && tys.at(i) != Unknown && slots.at(i).is_none() then
                unify(cx.an, scope, param_refs.at(i), tys.at(i), tparams, &sub)

    // **By readiness rather than left to right**, so that a callable whose result settles what the
    // next one takes is read first whichever order the two were written in. A round that reads
    // nothing ends it.
    var pending = held
    var again = true

    while again && !pending.is_empty()
        again = false

        var later: Buf[usize] = buf()
        var ready: Buf[usize] = buf()
        var wants: Buf[Type] = buf()

        // **A ROUND SETTLES WHO IS IN IT BEFORE IT READS ANY OF THEM.** Reading one callable
        // settles type parameters, and letting that carry a later argument into the same round
        // would make the order the closures are lowered in depend on where in the list the settling
        // argument happened to sit. The number inside a closure's name is that order, so it is not
        // a detail: it is part of the symbol. An argument ready at the start of a round has nothing
        // unsolved in what it takes, so reading it against what the round started with loses
        // nothing.
        for at in pending
            val want = held_want(cx, scope, params.at(at).typ, tparams, bounds, sub)

            if want.is_none() then later.push(at)
            else
                ready.push(at)
                wants.push(want.unwrap())

        for i in 0..<ready.len()
            val at = ready.at(i)
            val reader = arg_reader(cx, span, scope, slots.at(at).is_none())
            val want = settled_yield(reader, scope, written.at(at).unwrap(), wants.at(i),
                                     param_refs.at(at), tparams, bounds, sub)
            val t = type_expr(reader, written.at(at).unwrap(), Some(want))

            kept.set(at, Some(t))
            tys.set(at, texpr_type(t))
            unify(cx.an, scope, param_refs.at(at), texpr_type(t), tparams, &sub)

            // **What a callable yields is read back off it**, which is the other half of a call
            // handing one an open result: the parameter is now the closure's own struct, and that
            // struct implements the call trait its body determined -- so the bound's arguments,
            // written in the declaration's terms, are matched against the ones the closure turned
            // out to have. Without it a parameter named only by an arrow's result stays unknown,
            // and the next arrow is told nothing says what it takes by a call whose previous
            // argument had just said so.
            solve_from_callables(cx.an, scope, tparams, bounds, &sub)

            again = true

        pending = later

    // **What never became readable is read anyway, with nothing expected, in source order** -- so a
    // closure that states its own parameter types says what they settle, and one that states none is
    // told so at the closure, the leftmost first. Leaving it unread left the call with nothing to
    // lower and nothing said about why.
    for at in pending
        val reader = arg_reader(cx, span, scope, slots.at(at).is_none())
        val t = type_expr(reader, written.at(at).unwrap(), None)

        kept.set(at, Some(t))
        tys.set(at, texpr_type(t))
        unify(cx.an, scope, param_refs.at(at), texpr_type(t), tparams, &sub)
        solve_from_callables(cx.an, scope, tparams, bounds, &sub)

    Provisional(tys, soft, kept)
end provisional_of

// Who reads an argument: the caller for one a program wrote, and an analyzer in the declaration's
// own terms for a default -- which is what makes a default mean the same thing from every module
// that calls the function, and what makes a default of `__LINE__` name the caller's line.
private arg_reader(cx: &Analyzer, span: Span, scope: Scope, from_default: bool) -> &Analyzer
    if !from_default then return cx

    val inner = analyzer_for(cx.an, scope)

    inner.here = Some(call_site(cx, span))
    inner
end arg_reader

// One reading of an argument with everything it said put back.
sandboxed_arg(cx: &Analyzer, e: Expr, expected: Option[Type]) -> TExpr
    // **A reading that is thrown away lowers no closure**, because the argument is read again at the
    // parameter the solve arrived at and the second reading is the one the program gets. The counter
    // is what makes a closure's name its own, so leaving it forward here would number every closure
    // after a generic call one higher than the compilation actually lowered.
    val tried = begin_trial(cx)
    val t = type_expr(cx, e, expected)

    discard_trial(cx, tried)
    t
end sandboxed_arg

// A bare reading of an argument, with everything it said put back -- and nothing where it said
// anything, the reference's `attempt`: a reading that was refused is no evidence about the type.
private sandboxed_attempt(cx: &Analyzer, e: Expr) -> Option[TExpr]
    val read = sandboxed_reading(cx, e)

    if read.1 then None else Some(read.0)
end sandboxed_attempt

// The same bare reading, answering what it produced and whether it was refused on the way.
sandboxed_reading(cx: &Analyzer, e: Expr) -> (TExpr, bool)
    val tried = begin_trial(cx)
    val t = type_expr(cx, e, None)
    val refused = refused_since(cx, tried)

    discard_trial(cx, tried)
    (t, refused)
end sandboxed_reading

// Whether a written type names one of a list of type parameters, anywhere inside it.
ref_mentions(t: TypeRef, names: Buf[string]) -> bool
    if names.is_empty() then return false

    *t.kind match
        NamedType(n, args) -> holds_string(names, n) || any_ref_mentions(args, names)
        PtrType(inner) -> ref_mentions(inner, names)
        RefType(inner, _) -> ref_mentions(inner, names)
        WeakType(inner) -> ref_mentions(inner, names)
        VolatileType(inner) -> ref_mentions(inner, names)
        // A **length** names a value parameter the way an element names a type one, so a walk that
        // read only the element reported `N` as a parameter nothing in the call could settle.
        ArrayType(length, elem, _) ->
            (length.is_some() && expr_mentions(length.unwrap(), names)) || ref_mentions(elem, names)
        VectorType(lanes, elem) -> expr_mentions(lanes, names) || ref_mentions(elem, names)
        ValueArgType(e) -> expr_mentions(e, names)
        TupleType(parts, _) -> any_ref_mentions(parts, names)
        PackType(n) -> holds_string(names, n)
        FnType(params, ret, _) -> any_ref_mentions(params, names) || ref_mentions(ret, names)
        CFnType(params, ret) -> any_ref_mentions(params, names) || ref_mentions(ret, names)
        AssocType(base, _) -> ref_mentions(base, names)
        AssocArgType(_, inner) -> ref_mentions(inner, names)
        _ -> false
end ref_mentions

// Whether a written extent names one of them. An extent written as arithmetic over a parameter
// still NAMES it -- `[N + 1]int` is refused at its declaration rather than solved, and a call to it is
// told the parameter cannot be inferred, not that nothing mentions it.
private expr_mentions(e: Expr, names: Buf[string]) -> bool = *e.kind match
    Ident(n) -> holds_string(names, n)
    LayoutOf(_, tr) -> ref_mentions(tr, names)
    OffsetOf(tr, _) -> ref_mentions(tr, names)
    TypeArg(tr) -> ref_mentions(tr, names)
    Unary(_, operand) -> expr_mentions(operand, names)
    Binary(_, l, r) -> expr_mentions(l, names) || expr_mentions(r, names)
    Compare(operands, _) ->
        operands.len() == 2 && (expr_mentions(operands.at(0), names) ||
                                expr_mentions(operands.at(1), names))
    Call(_, args) ->
        for item in args
            if expr_mentions(item, names) then return true

        false
    _ -> false

any_ref_mentions(ts: Buf[TypeRef], names: Buf[string]) -> bool
    for item in ts
        if ref_mentions(item, names) then return true

    false
end any_ref_mentions

// -- the arguments a first pass holds back -------------------------------------------------------

// Whether an argument is a **callable**: the one shape with no type of its own, since a closure's
// parameters come from its context and a bare function name is a callable only where one is wanted.
//
// It is asked in the **caller's** scope, before anything enters the declaration's: asking it later
// would be asking whether the callee's module declares a function of that name.
callable_arg(cx: &Analyzer, e: Expr) -> bool = *written_arg(e).kind match
    Lambda(_, _, _) -> true
    BlockArg(_) -> true
    Ident(n) ->
        cx.lookup(n).is_none() && !function_keys(cx, n).is_empty()
    _ -> false

// What was actually written at an argument position, which for a filled default is inside the
// wrapper the binding put around it: a default stands exactly where the argument would have been,
// so what is asked about it is what would have been asked about the expression written there.
private written_arg(e: Expr) -> Expr = *e.kind match
    DefaultArg(_, inner) -> written_arg(inner)
    _ -> e

// The names a solve has still to answer.
private unsolved_names(tparams: Buf[string], known: Buf[Binding]) -> Buf[string]
    var out: Buf[string] = buf()

    for tparam in tparams
        if bound_type(known, tparam).is_none() then out.push(tparam)

    out
end unsolved_names

// What a held-back argument is read against, once the others have settled what they can.
//
// A **callable** wants its parameter's *bound*; everything else held back wants the parameter
// itself. Nothing at all where the parameter still names something undetermined, which leaves the
// closure to report that its parameters have no types -- the honest answer there, since they have
// none.
private held_want(cx: &Analyzer, scope: Scope, ptype: TypeRef, tparams: Buf[string],
                  bounds: Buf[NamedBounds], sub: Buf[Binding]) -> Option[Type]
    val shape = call_shape(cx, scope, ptype, tparams, bounds)

    if shape.is_some()
        val unsolved = unsolved_names(tparams, sub)

        // **Only what the closure TAKES has to be settled; what it yields may still be open.** A
        // closure takes its parameter types from its context and its result from its body, so a
        // result nothing here knows is the ordinary case rather than a difficulty.
        if !any_ref_mentions(shape.unwrap().1, unsolved)
            var args: Buf[Type] = buf()

            for i in 0..<shape.unwrap().1.len()
                args.push(resolve_type(cx.an, scope, shape.unwrap().1.at(i), sub))

            var yields = Unknown

            if shape.unwrap().2.is_some() && !ref_mentions(shape.unwrap().2.unwrap(), unsolved) then
                yields = resolve_type(cx.an, scope, shape.unwrap().2.unwrap(), sub)

            args.push(yields)
            return Some(Trait(shape.unwrap().0, args, buf()))
        end if

    if ref_mentions(ptype, unsolved_names(tparams, sub)) then return None

    Some(resolve_type(cx.an, scope, ptype, sub))
end held_want

// What a held-back callable is read against when the declaration SHAPES its result and the shape is
// still open -- `flat_map[U](f: T -> []U)` before anything has said what `U` is.
//
// **The body is read once on trial to settle the shape, then for real against it.** Read with an open
// result, `n -> [n, n]` yields its own `[2]int`, which settles `U = int` and then implements
// `Fn1[int, [2]int]` where the declaration asked for `Fn1[int, []int]`. Read against the settled
// `[]int`, the array is taken where a slice is expected exactly as it is for an ordinary argument or a
// call with `U` written out.
//
// **Only a slice-shaped result is asked**, since the array-to-slice step is the one way a body's own
// type and the shape it settles can differ: a bare `U` (`map`) is whatever the body yields, and an
// `Option[U]` (`and_then`) is matched part for part. Nor is the want changed where the trial's own
// result already is the settled one, so the reading the program gets is the one it always got.
private settled_yield(cx: &Analyzer, scope: Scope, e: Expr, want: Type, ptype: TypeRef,
                      tparams: Buf[string], bounds: Buf[NamedBounds], sub: Buf[Binding]) -> Type
    if !yield_open(want) then return want

    val shape = call_shape(cx, scope, ptype, tparams, bounds)

    if shape.is_none() || shape.unwrap().2.is_none() then return want
    if open_slice_type(shape.unwrap().2.unwrap()) == Unknown then return want

    val first = refusing_trial(cx, e, Some(want))
    var tried = first.0
    var refused = first.1
    var yielded = callable_signature(cx.an, texpr_type(tried))
    var shaped = false

    // **A body that settles nothing on its own may settle it at the shape**: the branches of
    // `if c then [n] else [n, n, n]` meet at no array, but they meet at a slice, which is what the
    // declaration asked for -- so the second trial says "a slice of something" and lets the body say
    // of what. A first reading that complained settled nothing, whatever type it came to.
    if refused || yielded.is_none() || yielded.unwrap().1.is_none()
        val open = open_slice(want, shape.unwrap().2.unwrap())

        if open.is_none() then return want

        val again = refusing_trial(cx, e, open)

        tried = again.0
        refused = again.1
        yielded = callable_signature(cx.an, texpr_type(tried))
        shaped = true

        if refused || yielded.is_none() || yielded.unwrap().1.is_none() then return want
        if yielded.unwrap().1.unwrap() == open_slice_type(shape.unwrap().2.unwrap()) then return want
    end if

    var trial_sub: Buf[Binding] = buf()

    for item in sub
        trial_sub.push(item)

    unify(cx.an, scope, ptype, texpr_type(tried), tparams, &trial_sub)
    solve_from_callables(cx.an, scope, tparams, bounds, &trial_sub)

    val settled = held_want(cx, scope, ptype, tparams, bounds, trial_sub)

    if settled.is_none() || yield_open(settled.unwrap()) then return want

    val args = trait_args(settled.unwrap())

    if !shaped && args.at(args.len() - 1) == yielded.unwrap().1.unwrap() then return want

    settled.unwrap()
end settled_yield

// A reading of an argument with everything it said put back, and whether it complained.
private refusing_trial(cx: &Analyzer, e: Expr, expected: Option[Type]) -> (TExpr, bool)
    val opened = begin_trial(cx)
    val t = type_expr(cx, e, expected)
    val refused = refused_since(cx, opened)

    discard_trial(cx, opened)
    (t, refused)
end refusing_trial

// A callable's want with its open result read as "a slice of something", where the declaration's
// result is a slice.
private open_slice(want: Type, ret: TypeRef) -> Option[Type]
    val shape = open_slice_type(ret)

    if shape == Unknown then return None

    want match
        Trait(name, args, assocs) ->
            var out: Buf[Type] = buf()

            for i in 0..<args.len() - 1
                out.push(args.at(i))

            out.push(shape)
            Some(Trait(name, out, assocs))
        _ -> None
end open_slice

private open_slice_type(ret: TypeRef) -> Type = *ret.kind match
    ArrayType(length, _, read_only) -> if length.is_none() then Slice(Unknown, read_only) else Unknown
    _ -> Unknown

// Whether a callable's want leaves what it yields open.
private yield_open(want: Type) -> bool
    val args = trait_args(want)

    !args.is_empty() && args.at(args.len() - 1) == Unknown

private trait_args(t: Type) -> Buf[Type] = t match
    Trait(_, args, _) -> args
    _ -> buf()

// The two ways a parameter can ask for a callable, read down to one shape: the trait's key, what it
// takes, and what it yields.
//
// **A bare arrow and a boxed `&Fn` are the same question.** They differ in what they cost -- the
// arrow becomes a bounded type parameter and is called directly, the boxed one is a trait object
// and dispatches -- and in nothing else that matters here, since both state a signature the closure
// standing at them can be read against.
private call_shape(cx: &Analyzer, scope: Scope, ptype: TypeRef, tparams: Buf[string],
                   bounds: Buf[NamedBounds]) -> Option[(string, Buf[TypeRef], Option[TypeRef])]
    *ptype.kind match
        NamedType(name, args) ->
            if !args.is_empty() then return applied_call_shape(cx, scope, name, args)
            if !holds_string(tparams, name) then return applied_call_shape(cx, scope, name, args)

            for item in bounds
                if item.name == name
                    val bs = item.bounds

                    for j in 0..<bs.len()
                        val found = applied_call_shape(cx, scope, bs.at(j).name, bs.at(j).args)

                        if found.is_some() then return found

            None
        FnType(params, ret, _) ->
            val key = lookup_trait_key(cx.an, scope, fn_base(params.len()))

            if key.is_none() then return None

            Some((key.unwrap(), params, Some(ret)))
        RefType(inner, _) -> call_shape(cx, scope, inner, tparams, bounds)
        PtrType(inner) -> call_shape(cx, scope, inner, tparams, bounds)
        _ -> None
end call_shape

// A trait written out with its arguments, where the trait is one of the call traits: the last
// argument is what it yields and the rest are what it takes.
private applied_call_shape(cx: &Analyzer, scope: Scope,
                           name: string, args: Buf[TypeRef]) -> Option[(string, Buf[TypeRef],
                                                                        Option[TypeRef])]
    if !fn_is_call(name) then return None

    val key = lookup_trait_key(cx.an, scope, name)

    if key.is_none() || args.is_empty() then return None

    var taken: Buf[TypeRef] = buf()

    for i in 0..<(args.len() - 1)
        taken.push(args.at(i))

    Some((key.unwrap(), taken, Some(args.at(args.len() - 1))))
end applied_call_shape
