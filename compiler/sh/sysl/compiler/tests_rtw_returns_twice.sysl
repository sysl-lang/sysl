module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.text.{join, Search}
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture

// A C function that can return twice (`setjmp`, `vfork`, `getcontext`) must reach LLVM as one:
// `returns_twice` on its declaration and on every call, so LLVM never makes the call a tail call and
// never optimises a value across the second return. clang marks a fixed list of names by name, and
// `@returns_twice` marks any other `extern`. `reference/ffi.md § @returns_twice` is the specification.
//
// Cells: each of the eight names clang knows, spelled as the symbol (`extern "n" f`) -- the
// declaration and the call both marked; a name clang does not know left alone; `@returns_twice` on
// any other symbol, and beside `@abandons`/`@needs`; the call in a loop, in a closure and in a
// generic function; many calls to one declaration; the same program through clang at -O2 (no tail
// call to it); a freestanding thumb target; every misuse of the annotation; and a program that
// really does round-trip through `setjmp` and `longjmp` more than once, with the state kept in memory.
//
// Skipped: `--lto full` and `build-c` get their own run in the release notes' check, since they
// need the library archive built; the IR here is what both of them read.

private rtw_cli(args: []string) -> (int, string)
    var lines: Buf[string] = buf()
    val sink = &lines
    val code = run_cli(args, (line) -> sink.push(line))

    (code, join(lines.view(), "\n"))
end rtw_cli

private rtw_ready() -> bool
    if std_root().is_err()
        print("skipped: the standard module's source is not on this machine")
        return false

    true
end rtw_ready

// The LLVM `emit-llvm` writes for a program whose `main.sysl` is `text`, after `flags`.
private rtw_ir_with(flags: []string, text: string) -> (int, string)
    val root = make_temp_dir("sysl-rtw-").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/sysl.hocon", "package {\n  name    = \"rtw\"\n  version = \"0.0.1\"\n}\n").unwrap()
    write_text(s"$root/main.sysl", text).unwrap()

    var args: Buf[string] = buf()

    args.push("sysl")
    args.push("emit-llvm")

    for f in flags
        args.push(f)

    args.push(s"$root/main.sysl")

    val got = rtw_cli(args.view())

    remove_dir_all(root).unwrap_or(())
    got
end rtw_ir_with

private rtw_ir(text: string) -> string
    val got = rtw_ir_with([], text)

    assert_eq(got.0, 0, got.1)
    got.1
end rtw_ir

// The lines of `ir` that start with `head` and mention `@sym(`.
private rtw_lines(ir: string, head: string, sym: string) -> Buf[string]
    var out: Buf[string] = buf()
    var start: usize = 0

    for i in 0..<ir.bytes.len
        if ir.bytes[i] == u8('\n')
            val line = ir[start..<i].trim()

            if line.contains(s"@$sym(") && line.contains(head) then out.push(line)

            start = i + 1

    out
end rtw_lines

private rtw_declares(ir: string, sym: string) -> Buf[string] = rtw_lines(ir, "declare ", sym)

private rtw_calls(ir: string, sym: string) -> Buf[string] = rtw_lines(ir, "call ", sym)

private rtw_program(link: string) -> string =
    s"private extern \"$link\" c_save(env: *u64) -> int\n\n" +
    "main()\n" +
    "    var env: [64]u64 = [0; 64]\n" +
    "    print(c_save(&env[0]))\n"

// -- the names clang marks ------------------------------------------------------------------------

private rtw_name_is_marked(sym: string)
    if !rtw_ready() then return

    val ir = rtw_ir(rtw_program(sym))
    val declared = rtw_declares(ir, sym)
    val called = rtw_calls(ir, sym)

    assert_eq(declared.len(), 1, ir)
    assert(declared.at(0).ends_with(" returns_twice"), declared.at(0))
    assert_eq(called.len(), 1, ir)
    assert(called.at(0).ends_with(" returns_twice"), called.at(0))
end rtw_name_is_marked

@test("setjmp is declared and called returns_twice")
rtw_setjmp() = rtw_name_is_marked("setjmp")

@test("_setjmp is declared and called returns_twice")
rtw_underscore_setjmp() = rtw_name_is_marked("_setjmp")

@test("_setjmpex is declared and called returns_twice")
rtw_setjmpex() = rtw_name_is_marked("_setjmpex")

@test("sigsetjmp is declared and called returns_twice")
rtw_sigsetjmp() = rtw_name_is_marked("sigsetjmp")

@test("__sigsetjmp is declared and called returns_twice")
rtw_dunder_sigsetjmp() = rtw_name_is_marked("__sigsetjmp")

@test("savectx is declared and called returns_twice")
rtw_savectx() = rtw_name_is_marked("savectx")

@test("vfork is declared and called returns_twice")
rtw_vfork() = rtw_name_is_marked("vfork")

@test("getcontext is declared and called returns_twice")
rtw_getcontext() = rtw_name_is_marked("getcontext")

@test("the extern's own name is the symbol when no link name is written")
rtw_by_own_name()
    if !rtw_ready() then return

    val ir = rtw_ir(
        "extern setjmp(env: *u64) -> int\n\n" +
        "main()\n" +
        "    var env: [64]u64 = [0; 64]\n" +
        "    print(setjmp(&env[0]))\n")

    assert(rtw_declares(ir, "setjmp").at(0).ends_with(" returns_twice"), ir)
    assert(rtw_calls(ir, "setjmp").at(0).ends_with(" returns_twice"), ir)
end rtw_by_own_name

@test("a name clang does not know is left alone")
rtw_unknown_name_unmarked()
    if !rtw_ready() then return

    val ir = rtw_ir(rtw_program("getpid_like"))

    assert(!rtw_declares(ir, "getpid_like").at(0).contains("returns_twice"), ir)
    assert(!rtw_calls(ir, "getpid_like").at(0).contains("returns_twice"), ir)
end rtw_unknown_name_unmarked

@test("a name that only resembles one clang knows is left alone")
rtw_near_name_unmarked()
    if !rtw_ready() then return

    for sym in ["setjmp2", "my_setjmp", "Setjmp", "longjmp", "fork"]
        val ir = rtw_ir(rtw_program(sym))

        assert(!ir.contains("returns_twice"), ir)

// -- the attribute --------------------------------------------------------------------------------

@test("@returns_twice marks an extern of any name, declaration and call")
rtw_attribute_marks_any_name()
    if !rtw_ready() then return

    val ir = rtw_ir(
        "@returns_twice\n" +
        "extern \"save_context\" c_save(env: *u64) -> int\n\n" +
        "main()\n" +
        "    var env: [64]u64 = [0; 64]\n" +
        "    print(c_save(&env[0]))\n")

    assert(rtw_declares(ir, "save_context").at(0).ends_with(" returns_twice"), ir)
    assert(rtw_calls(ir, "save_context").at(0).ends_with(" returns_twice"), ir)
end rtw_attribute_marks_any_name

@test("@returns_twice beside @needs and @abandons keeps all three")
rtw_attribute_beside_others()
    if !rtw_ready() then return

    val ir = rtw_ir(
        "@returns_twice\n" +
        "@needs(os)\n" +
        "extern \"save_context\" c_save(env: *u64) -> int\n\n" +
        "main()\n" +
        "    var env: [64]u64 = [0; 64]\n" +
        "    print(c_save(&env[0]))\n")

    assert(rtw_declares(ir, "save_context").at(0).ends_with(" returns_twice"), ir)
end rtw_attribute_beside_others

@test("the attribute and the name together mark once")
rtw_attribute_and_name()
    if !rtw_ready() then return

    val ir = rtw_ir(
        "@returns_twice\n" +
        "extern setjmp(env: *u64) -> int\n\n" +
        "main()\n" +
        "    var env: [64]u64 = [0; 64]\n" +
        "    print(setjmp(&env[0]))\n")

    assert_eq(rtw_declares(ir, "setjmp").at(0).count_of("returns_twice"), 1, ir)
    assert_eq(rtw_calls(ir, "setjmp").at(0).count_of("returns_twice"), 1, ir)
end rtw_attribute_and_name

// -- where the call is ----------------------------------------------------------------------------

@test("every call in a loop, a closure and a generic function is marked")
rtw_every_call_site()
    if !rtw_ready() then return

    val ir = rtw_ir(
        "extern setjmp(env: *u64) -> int\n\n" +
        "again[T](env: *u64, x: T) -> int = setjmp(env)\n\n" +
        "main()\n" +
        "    var env: [64]u64 = [0; 64]\n" +
        "    var total = 0\n" +
        "    for i in 0..<3\n" +
        "        total += setjmp(&env[0])\n" +
        "    val f = () -> setjmp(&env[0])\n" +
        "    total += f()\n" +
        "    total += again(&env[0], 1)\n" +
        "    total += again(&env[0], 2.5)\n" +
        "    print(total)\n")

    val calls = rtw_calls(ir, "setjmp")

    assert(calls.len() >= 4, ir)

    for c in calls
        assert(c.ends_with(" returns_twice"), c)

    assert_eq(rtw_declares(ir, "setjmp").len(), 1, ir)
end rtw_every_call_site

@test("the calling function is not itself marked or blocked from inlining")
rtw_caller_unmarked()
    if !rtw_ready() then return

    val ir = rtw_ir(rtw_program("setjmp"))
    val group = ir[ir.index_of("attributes #99").unwrap_or(0)..<ir.bytes.len]

    assert(!group.contains("returns_twice"), group)
    assert(!group.contains("noinline"), group)
end rtw_caller_unmarked

@test("clang at -O2 makes no tail call of the marked call")
rtw_no_tail_call()
    if !rtw_ready() then return

    val root = make_temp_dir("sysl-rtw-").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/sysl.hocon", "package {\n  name    = \"rtw\"\n  version = \"0.0.1\"\n}\n").unwrap()
    write_text(s"$root/main.sysl",
               "extern setjmp(env: *u64) -> int\n\n" +
               "@export(\"save\")\n" +
               "save(env: *u64) -> int = setjmp(env)\n").unwrap()

    val got = rtw_cli(["sysl", "emit-llvm", s"$root/main.sysl"])

    assert_eq(got.0, 0, got.1)
    write_text(s"$root/m.ll", got.1).unwrap()

    val opt = capture("clang", ["-O2", "-S", "-emit-llvm", s"$root/m.ll", "-o", "-"], "", [], true)

    remove_dir_all(root).unwrap_or(())

    opt match
        Err(_) -> print("skipped: there is no clang on this machine")
        Ok(o) ->
            val calls = rtw_calls(o.text, "setjmp")

            val said = o.text + o.err.unwrap_or("")

            assert(calls.len() >= 1, said)

            for c in calls
                assert(!c.contains("tail call"), c)

            assert(o.text.contains("= { returns_twice }"), said)
            assert(o.text.contains("= { nounwind returns_twice }"), said)

// -- another build mode ---------------------------------------------------------------------------

@test("a freestanding thumb program marks the declaration and the call too")
rtw_thumb()
    if !rtw_ready() then return

    val got = rtw_ir_with(["--no-std-lib", "--target", "thumb-freestanding"],
        "extern setjmp(env: *u64) -> int\n\n" +
        "@export(\"main\")\n" +
        "boot() -> int\n" +
        "    var env: [64]u64 = [0; 64]\n" +
        "    setjmp(&env[0])\n")

    assert_eq(got.0, 0, got.1)
    assert(rtw_declares(got.1, "setjmp").at(0).ends_with(" returns_twice"), got.1)
    assert(rtw_calls(got.1, "setjmp").at(0).ends_with(" returns_twice"), got.1)
end rtw_thumb

// -- misuse ---------------------------------------------------------------------------------------

private rtw_refused(text: string, part: string)
    if !rtw_ready() then return

    val got = rtw_ir_with([], text)

    assert(got.0 != 0, got.1)
    assert(got.1.contains(part), got.1)
end rtw_refused

@test("@returns_twice on a function is refused")
rtw_on_a_function()
    rtw_refused("@returns_twice\nf() -> int = 1\n\nmain() = print(f())\n",
                "'@returns_twice' says a call may return a second time")

@test("@returns_twice on an extern variable is refused")
rtw_on_an_extern_variable()
    rtw_refused("@returns_twice\nextern environ: *u8\n\nmain() = print(1)\n",
                "'@returns_twice' says a call may return a second time, and an 'extern' variable is storage")

@test("@returns_twice takes no arguments")
rtw_with_arguments()
    rtw_refused("@returns_twice(1)\nextern setjmp(env: *u64) -> int\n\nmain() = print(1)\n",
                "a call either returns a second time or it does not")

// -- it works -------------------------------------------------------------------------------------

private rtw_outcome(text: string) -> (string, int)
    val root = make_temp_dir("sysl-rtw-").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", text).unwrap()

    val exe = s"$root/built"

    build_native_program(root, None, None, DefaultOptimization, Some(exe)) match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return (failure_text(why), -1)
        Ok(_) -> ()

    val said = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    said match
        Err(_) -> ("the program that was built could not be run", -1)
        Ok(out) -> (out.text + out.err.unwrap_or(""), shell_status(out.status))
end rtw_outcome

// What sysl guarantees across the second return is what C does: a value kept in memory the program
// owns (module storage, or behind a pointer) is exactly what the last write left, and a plain local
// modified between `setjmp` and `longjmp` is indeterminate unless it was not modified. This program
// keeps its count in module storage, takes the second return three times and prints each.
private rtw_round_trip() -> string = raw"""
    @needs(os)
    extern setjmp(env: *u64) -> int

    @abandons
    @needs(os)
    extern longjmp(env: *u64, v: int) -> never

    private var env: [64]u64 = [0; 64]
    private var count = 0

    private jump(n: int) -> never
        count += 1
        longjmp(&env[0], n)

    main()
        val stable = 41
        val got = setjmp(&env[0])

        print(s"returned $got count $count stable $stable")

        if got < 3 then jump(got + 1)

        print("done")
    """

@test("setjmp returns again with the longjmp value, and memory keeps what was written between")
rtw_round_trips()
    if !rtw_ready() then return

    val out = rtw_outcome(rtw_round_trip())

    assert_eq(out.1, 0, out.0)
    assert_eq(out.0,
              "returned 0 count 0 stable 41\nreturned 1 count 1 stable 41\n" +
              "returned 2 count 2 stable 41\nreturned 3 count 3 stable 41\ndone\n")
