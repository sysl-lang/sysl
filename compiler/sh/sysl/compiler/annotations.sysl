module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// The annotations a program declares: a struct marked `@annotation` is written `@Name(...)` above a
// type declaration, a field or a variant, and reflection reads it back as `x::Annotation[Name]`.
//
// **A use is the construction it stands for.** `@rename("id")` is `rename("id")`, typed in the terms
// of the file that wrote it -- so the struct is found as any type name is, through imports and
// qualification -- and run while compiling, so what a reader gets is a literal of the struct. Its
// arguments are therefore whatever a constant may be: a literal, a `const`, a call whose body runs.
//
// Every use is checked where it is written, whether or not anything reads it, and each reading types
// the use again; a complaint is said once however often it is raised.

// **A generic annotation**, `struct default[F]`, takes the one type parameter it may declare from
// what a use is written on: the type of the field. `@default(8080) port: u16` is the construction
// `default[u16](8080)`, so the value is checked as a `u16` and reflection answers a `default[u16]`.
// A use on a type declaration or a variant has no field type to give it and is refused.

// The annotation struct a written name reaches from `scope`: its key, its declaration and its type.
// `None` where it is no annotation, which is said at `span` unless `quiet` -- `how` finishes the
// sentence that tells a reader to mark it. A generic annotation's type is `Unknown` here, since only
// a use says what its parameter is (`annotation_type_at`).
annotation_struct(a: &Analysis, scope: Scope, span: Span, written: string, how: string,
                  quiet: bool) -> Option[(string, StructDecl, Type)]
    val key = lookup_type_key(a, scope, written)

    if key.is_none()
        if !quiet then
            a.fault(scope, span, s"'@$written' names no annotation — nothing called '$written' is in " +
                    "reach here, and an annotation is a struct declared with '@annotation' above it")

        return None
    end if

    val decl = a.tables.types.get(key.unwrap()).unwrap()

    val kind = decl.kind match
        StructOf(sd) ->
            if sd.annotation then
                val ty = if !sd.tparams.is_empty() then Unknown
                         else resolve_type(a, scope, named_type(span, written), no_bindings())

                return Some((key.unwrap(), sd, ty))
            end if

            "a struct"
        EnumOf(_) -> "an enum"
        TraitOf(_) -> "a trait"
        _ -> "a type"

    if !quiet then
        a.fault(scope, span, s"'$written' is $kind, not an annotation — an annotation is a struct " +
                s"marked '@annotation', which is what $how")

    None
end annotation_struct

// The type one use of the annotation `key` stands for: `plain` where the annotation takes no
// parameter, and otherwise the annotation at `field`, the type of the field the use is written on.
// `None` where there is no field, which is said at the use; `owner` names what it was written on.
annotation_type_at(a: &Analysis, scope: Scope, u: AnnotUse, key: string, sd: StructDecl, plain: Type,
                   field: Option[Type], owner: string) -> Option[Type]
    if sd.tparams.is_empty() then return Some(plain)

    if field.is_none()
        val what = if u.target == "" then s"the declaration '$owner'" else s"the variant '${u.target}'"

        a.fault(scope, u.span, s"'@${annot_written(u)}' is generic — its '${sd.tparams.at(0)}' is the " +
                s"type of the field it is written on — and $what is not a field, so there is no type " +
                "to give it")
        return None
    end if

    var targs: Buf[Type] = buf()

    targs.push(field.unwrap())
    Some(reinstantiate_at(a, scope, u.span, key, targs))
end annotation_type_at

// What one use comes to: the literal of its struct, or `None` where it was refused. `field` is the
// type a generic annotation's parameter was given, which a refusal names with the field.
annotation_value(a: &Analysis, scope: Scope, u: AnnotUse, sd: StructDecl, ty: Type,
                 field: Option[Type]) -> Option[TExpr]
    val written = annot_written(u)

    if u.parens && sd.fields.is_empty()
        a.fault(scope, u.span, s"'$written' has no fields, so '@$written' takes no arguments — it is " +
                "written with no parentheses")
        return None
    end if

    val about = if field.is_none() || sd.tparams.is_empty() then ""
                else s"'@$written' is written on '${u.target}', a '${type_show(field.unwrap())}', so " +
                     s"its '${sd.tparams.at(0)}' is '${type_show(field.unwrap())}' and what its " +
                     "parentheses say must be one"

    annotation_image(analyzer_for(a, scope), written, u.call, ty, about)
end annotation_value

// The type of the field a use is about -- `port`, or `Variant.field` on an enum -- read in the terms
// of the declaration `key` that holds it, where a generic declaration's own parameters stand for
// themselves. `None` where the use is about the declaration itself or a variant.
annotated_field(a: &Analysis, key: string, target: string) -> Option[Type]
    val decl = a.tables.types.get(key)

    if decl.is_none() || target == "" then return None

    val d = decl.unwrap()

    d.kind match
        StructOf(sd) -> field_named(a, d.scope, sd.tparams, sd.bounds, sd.tvalues, sd.fields, "", target)
        EnumOf(ed) ->
            for v in ed.variants
                val found = field_named(a, d.scope, ed.tparams, ed.bounds, ed.tvalues, v.fields,
                                        v.name + ".", target)

                if found.is_some() then return found

            None
        _ -> None
end annotated_field

private field_named(a: &Analysis, scope: Scope, tparams: Buf[string], bounds: Buf[NamedBounds],
                    tvalues: Buf[TypeBinding], fields: Buf[Param], prefix: string,
                    target: string) -> Option[Type]
    for p in fields
        if prefix + p.name != target then continue

        val subst = if tparams.is_empty() then no_bindings()
                    else abstract_subst(a, scope, tparams, bounds, tvalues, buf(), buf())

        return Some(unqualified(resolve_type(a, scope, p.typ, subst)))

    None
end field_named

// The use among `annots` about `target` that names the annotation `key`, read in `scope`.
annotation_on(a: &Analysis, scope: Scope, annots: Buf[AnnotUse], target: string,
              key: string) -> Option[(AnnotUse, StructDecl, Type)]
    for u in annots
        if u.target != target then continue

        val found = annotation_struct(a, scope, u.span, annot_written(u), "", true)

        if found.is_some() && found.unwrap().0 == key then
            return Some((u, found.unwrap().1, found.unwrap().2))

    None
end annotation_on

// The annotations a type declaration and its parts carry, as the tables hold it: the uses, and the
// terms they were written in. Empty for every type no declaration of a struct, an enum or a type of
// its own makes. A payload field's uses are about `Variant.field`.
annotations_of(a: &Analysis, key: string) -> Option[(Buf[AnnotUse], Scope)]
    val decl = a.tables.types.get(key)

    if decl.is_none() then return None

    decl.unwrap().kind match
        StructOf(sd) -> Some((sd.annots, decl.unwrap().scope))
        EnumOf(ed) -> Some((ed.annots, decl.unwrap().scope))
        TypeOf(td) -> Some((td.annots, decl.unwrap().scope))
        _ -> None
end annotations_of

// Every use of a program's annotation in every file, checked where it is written: that it names an
// annotation, that its arguments are constants the struct takes, and that no field, variant or type
// carries one annotation twice.
check_annotations(a: &Analysis, units: Buf[Program])
    for unit in units
        var scope: Option[Scope] = None

        for j in 0..<unit.body.len()
            var annots: Buf[AnnotUse] = buf()
            var owner = ""

            *unit.body.at(j).kind match
                StructDecl(d) ->
                    annots = d.annots
                    owner = d.name
                EnumDecl(d) ->
                    annots = d.annots
                    owner = d.name
                TypeDecl(d) ->
                    annots = d.annots
                    owner = d.name
                _ -> ()

            if annots.is_empty() then continue
            if scope.is_none() then scope = Some(scope_of_unit(a, unit))

            check_uses(a, scope.unwrap(), annots, owner)
end check_annotations

private check_uses(a: &Analysis, scope: Scope, annots: Buf[AnnotUse], owner: string)
    var seen: Buf[(string, string)] = buf()

    for u in annots
        val written = annot_written(u)
        val found = annotation_struct(a, scope, u.span, written, s"lets it be written '@$written'", false)

        if found.is_none() then continue

        var twice = false

        for item in seen
            if item.0 == u.target && item.1 == found.unwrap().0 then twice = true

        if twice
            val what = if u.target == "" then "one declaration" else s"'${u.target}'"

            a.fault(scope, u.span, s"'@$written' is written twice above $what, and it says nothing the " +
                    "once does not")
            continue
        end if

        seen.push((u.target, found.unwrap().0))

        val sd = found.unwrap().1
        var field: Option[Type] = None

        if !sd.tparams.is_empty()
            val key = lookup_type_key(a, scope, owner)

            if key.is_some() then field = annotated_field(a, key.unwrap(), u.target)
        end if

        val ty = annotation_type_at(a, scope, u, found.unwrap().0, sd, found.unwrap().2, field, owner)

        if ty.is_some() then annotation_value(a, scope, u, sd, ty.unwrap(), field)
end check_uses
