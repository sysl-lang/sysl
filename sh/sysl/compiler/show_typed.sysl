module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.math.bigint.to_string
import sysl.text.{str_builder, StrBuilder}

// The typed tree printed the *reference compiler's* way, which is the one thing the two analyzers
// can be diffed on.
//
// **The format is `emit-ast`'s, one stage later**: one node per line, its type name, then every
// field two spaces deeper as `fieldName: value`. A list of scalars prints inline, a list of nodes
// as `- ` items. The one difference from the untyped printer is `Type`, which is rendered as the
// compiler's own diagnostic text rather than structurally -- an oracle wants to know a call
// resolved to a `byte`, not the layout underneath it.
//
// **The field names here are the reference's own spellings**, not this tree's: `retTy`, `arrayTy`,
// `sliceTy`, `struct`. That is the whole point -- the two trees have to print the same text, and
// this is the file that knows they are two trees.

// One function, as the `funcs:` section of `sysl emit-typed --no-spans` writes it: a `- ` item at
// four spaces, with everything under it.
show_typed_func(f: TFunc) -> string
    var out = str_builder()

    out.push("    - TFunc\n")
    scalar_field(&out, "        ", "name", quoted_text(f.name))
    pair_list(&out, "        ", "params", f.params)
    scalar_field(&out, "        ", "retTy", type_show(f.ret_ty))
    out.push("        body: ")
    block_node(&out, "        ", f.body)
    scalar_field(&out, "        ", "variadic", flag(f.variadic))
    clause_list(&out, "        ", "requires", f.requires)
    clause_list(&out, "        ", "ensures", f.ensures)
    expr_list(&out, "        ", "olds", f.olds)
    scalar_field(&out, "        ", "internal", flag(f.internal))
    scalar_field(&out, "        ", "conv", conv_text(f.conv))
    scalar_field(&out, "        ", "tailrec", flag(f.tailrec))
    opt_expr_field(&out, "        ", "variant", f.variant)
    scalar_field(&out, "        ", "pure", flag(f.pure))
    scalar_field(&out, "        ", "ghost", flag(f.ghost))
    scalar_field(&out, "        ", "reads", name_set(f.reads))
    scalar_field(&out, "        ", "writes", name_set(f.writes))
    scalar_field(&out, "        ", "exported", option_text(f.exported))
    scalar_field(&out, "        ", "section", option_text(f.section))
    out.finish()
end show_typed_func

// The seams the program printer reads this file through, since a helper kept to one file is not one
// another file may name.
program_quoted(text: string) -> string = quoted_text(text)

string_option_text(v: Option[string]) -> string = option_text(v)

type_option_text(t: Option[Type]) -> string = opt_type(t)

usize_option_text(v: Option[usize]) -> string = v match
    Some(n) -> str(n)
    None -> "None"

show_typed_opt_expr(out: *StrBuilder, indent: string, name: string, e: Option[TExpr]) =
    opt_expr_field(out, indent, name, e)

show_typed_stmt_list(out: *StrBuilder, indent: string, name: string, xs: Buf[TStmt]) =
    stmt_list(out, indent, name, xs)

private flag(b: bool) -> string = if b then "true" else "false"

private option_text(v: Option[string]) -> string = v match
    Some(s) -> quoted_text(s)
    None -> "None"

private conv_text(v: Option[CallConv]) -> string = v match
    Some(c) -> c match
        C -> "C"
        Sysl -> "Sysl"
        Naked -> "Naked"
        Interrupt -> "Interrupt"
    None -> "None"

// A set of names prints inline and sorted, which is what makes two analyzers that built one in
// different orders still agree on the text.
private name_set(v: Option[Buf[string]]) -> string
    if v.is_none() then return "None"

    var names = v.unwrap()
    var sorted: Buf[string] = buf()

    for i in 0..<names.len()
        sorted.push(names.at(i))

    sort_names(&sorted)

    var out = "["

    for i in 0..<sorted.len()
        if i > 0 then out = out + ", "

        out = out + quoted_text(sorted.at(i))

    out + "]"
end name_set

private sort_names(xs: *Buf[string])
    for i in 1..<xs.len()
        var j = i

        while j > 0 && xs.at(j - 1) > xs.at(j)
            val a = xs.at(j - 1)

            xs.set(j - 1, xs.at(j))
            xs.set(j, a)
            j -= 1

// -- the pieces a line is made of ------------------------------------------------------------------

private scalar_field(out: *StrBuilder, indent: string, name: string, text: string)
    out.push(indent)
    out.push(name)
    out.push(": ")
    out.push(text)
    out.push_char('\n')

// A list of `(name, type)` pairs, which is what a function's parameters and a variant's fields are.
private pair_list(out: *StrBuilder, indent: string, name: string, xs: Buf[(string, Type)])
    if xs.is_empty() then
        scalar_field(out, indent, name, "[]")
        return

    out.push(indent)
    out.push(name)
    out.push(": \n")

    val item = indent + "  "

    for i in 0..<xs.len()
        out.push(item)
        out.push("- Tuple2\n")
        scalar_field(out, item + "    ", "_1", quoted_text(xs.at(i).0))
        scalar_field(out, item + "    ", "_2", type_show(xs.at(i).1))

private expr_list(out: *StrBuilder, indent: string, name: string, xs: Buf[TExpr])
    if xs.is_empty() then
        scalar_field(out, indent, name, "[]")
        return

    out.push(indent)
    out.push(name)
    out.push(": \n")

    val item = indent + "  "

    for i in 0..<xs.len()
        out.push(item)
        out.push("- ")
        expr_node(out, item + "  ", xs.at(i))

private expr_field(out: *StrBuilder, indent: string, name: string, e: TExpr)
    out.push(indent)
    out.push(name)
    out.push(": ")
    expr_node(out, indent, e)

private opt_expr_field(out: *StrBuilder, indent: string, name: string, e: Option[TExpr])
    e match
        Some(x) -> expr_field(out, indent, name, x)
        None -> scalar_field(out, indent, name, "None")

// A block: the statements, the trailing value where there is one, and what the block comes to.
private block_node(out: *StrBuilder, indent: string, b: TBlock)
    out.push("TBlock\n")

    val inner = indent + "  "

    stmt_list(out, inner, "stmts", b.stmts)
    opt_expr_field(out, inner, "result", b.result)
    scalar_field(out, inner, "ty", type_show(b.ty))

private block_field(out: *StrBuilder, indent: string, name: string, b: TBlock)
    out.push(indent)
    out.push(name)
    out.push(": ")
    block_node(out, indent, b)

private opt_block_field(out: *StrBuilder, indent: string, name: string, b: Option[TBlock])
    b match
        Some(x) -> block_field(out, indent, name, x)
        None -> scalar_field(out, indent, name, "None")

// A contract clause, which the reference tree holds as a plain pair rather than as a record of its
// own -- so it prints as one.
private clause_list(out: *StrBuilder, indent: string, name: string, xs: Buf[TClause])
    if xs.is_empty()
        scalar_field(out, indent, name, "[]")
        return
    end if

    out.push(indent)
    out.push(name)
    out.push(": \n")

    val item = indent + "  "

    for i in 0..<xs.len()
        out.push(item)
        out.push("- Tuple2\n")
        expr_field(out, item + "    ", "_1", xs.at(i).cond)
        scalar_field(out, item + "    ", "_2", option_text(xs.at(i).msg))

// -- the statements ----------------------------------------------------------------------------

private stmt_list(out: *StrBuilder, indent: string, name: string, xs: Buf[TStmt])
    if xs.is_empty()
        scalar_field(out, indent, name, "[]")
        return
    end if

    out.push(indent)
    out.push(name)
    out.push(": \n")

    val item = indent + "  "

    for i in 0..<xs.len()
        out.push(item)
        out.push("- ")
        stmt_node(out, item + "  ", xs.at(i))

private stmt_node(out: *StrBuilder, indent: string, s: TStmt)
    val inner = indent + "  "

    s match
        TVarDecl(name, ty, init, align) ->
            out.push("TVarDecl\n")
            scalar_field(out, inner, "name", quoted_text(name))
            scalar_field(out, inner, "ty", type_show(ty))
            expr_field(out, inner, "init", init)
            scalar_field(out, inner, "align", count_text(align))
        TExprStmt(e) ->
            out.push("TExprStmt\n")
            expr_field(out, inner, "expr", e)
        TInvariant(cond, msg) ->
            out.push("TInvariant\n")
            expr_field(out, inner, "cond", cond)
            scalar_field(out, inner, "msg", option_text(msg))
        TVariantCheck(slot, var_ty, e) ->
            out.push("TVariantCheck\n")
            scalar_field(out, inner, "slot", quoted_text(slot))
            scalar_field(out, inner, "varTy", type_show(var_ty))
            expr_field(out, inner, "expr", e)
        TRefDecl(name, ty, place) ->
            out.push("TRefDecl\n")
            scalar_field(out, inner, "name", quoted_text(name))
            scalar_field(out, inner, "ty", type_show(ty))
            expr_field(out, inner, "place", place)
        TWriteStmt(w) ->
            out.push("TWrite\n")
            write_fields(out, inner, w)
        TMultiAssign(writes) ->
            out.push("TMultiAssign\n")
            write_list(out, inner, "writes", writes)
        TReturn(value) ->
            out.push("TReturn\n")
            opt_expr_field(out, inner, "value", value)
        TBecome(call) ->
            out.push("TBecome\n")
            expr_field(out, inner, "call", call)
        TBreak(value, depth) ->
            out.push("TBreak\n")
            opt_expr_field(out, inner, "value", value)
            scalar_field(out, inner, "depth", s"$depth")
        TContinue(depth) ->
            out.push("TContinue\n")
            scalar_field(out, inner, "depth", s"$depth")
        TDefer(stmts) ->
            out.push("TDefer\n")
            stmt_list(out, inner, "stmts", stmts)
        TAsm(lines, operands, clobbers) ->
            out.push("TAsm\n")
            scalar_field(out, inner, "lines", quoted_list(lines))
            operand_list(out, inner, "operands", operands)
            scalar_field(out, inner, "clobbers", quoted_list(clobbers))

private write_list(out: *StrBuilder, indent: string, name: string, xs: Buf[TWrite])
    if xs.is_empty()
        scalar_field(out, indent, name, "[]")
        return
    end if

    out.push(indent)
    out.push(name)
    out.push(": \n")

    val item = indent + "  "

    for i in 0..<xs.len()
        out.push(item)
        out.push("- TWrite\n")
        write_fields(out, item + "    ", xs.at(i))

private write_fields(out: *StrBuilder, indent: string, w: TWrite)
    expr_field(out, indent, "place", w.place)
    scalar_field(out, indent, "op", quoted_text(w.op))
    expr_field(out, indent, "value", w.value)
    dispatch_field(out, indent, "dispatch", w.dispatch)
    scalar_field(out, indent, "check", "[]")
    scalar_field(out, indent, "constraint", opt_type(w.constraint))

private operand_list(out: *StrBuilder, indent: string, name: string, xs: Buf[TAsmOperand])
    if xs.is_empty()
        scalar_field(out, indent, name, "[]")
        return
    end if

    out.push(indent)
    out.push(name)
    out.push(": \n")

    val item = indent + "  "

    for i in 0..<xs.len()
        val o = xs.at(i)

        out.push(item)
        out.push("- TAsmOperand\n")
        scalar_field(out, item + "    ", "dir", dir_text(o.dir))
        scalar_field(out, item + "    ", "name", quoted_text(o.name))
        scalar_field(out, item + "    ", "slot", quoted_text(o.slot))
        scalar_field(out, item + "    ", "ty", type_show(o.ty))
        scalar_field(out, item + "    ", "reg", option_text(o.reg))

private dir_text(d: AsmDir) -> string = d match
    In -> "In"
    Out -> "Out"

private quoted_list(xs: Buf[string]) -> string
    if xs.is_empty() then return "[]"

    var out = "["

    for i in 0..<xs.len()
        if i > 0 then out = out + ", "

        out = out + quoted_text(xs.at(i))

    out + "]"
end quoted_list

private count_text(n: Option[usize]) -> string = n match
    Some(v) -> s"$v"
    None -> "None"

// -- the patterns ------------------------------------------------------------------------------

private pattern_list(out: *StrBuilder, indent: string, name: string, xs: Buf[TPattern])
    if xs.is_empty()
        scalar_field(out, indent, name, "[]")
        return
    end if

    out.push(indent)
    out.push(name)
    out.push(": \n")

    val item = indent + "  "

    for i in 0..<xs.len()
        out.push(item)
        out.push("- ")
        pattern_node(out, item + "  ", xs.at(i))

private pattern_field(out: *StrBuilder, indent: string, name: string, p: TPattern)
    out.push(indent)
    out.push(name)
    out.push(": ")
    pattern_node(out, indent, p)

private pattern_node(out: *StrBuilder, indent: string, p: TPattern)
    val inner = indent + "  "

    p match
        TWildPattern(ty) ->
            out.push("TWildPattern\n")
            scalar_field(out, inner, "ty", type_show(ty))
        TBindPattern(name, ty) ->
            out.push("TBindPattern\n")
            scalar_field(out, inner, "name", quoted_text(name))
            scalar_field(out, inner, "ty", type_show(ty))
        TAtPattern(name, sub) ->
            out.push("TAtPattern\n")
            scalar_field(out, inner, "name", quoted_text(name))
            pattern_field(out, inner, "inner", *sub)
        TLitPattern(value) ->
            out.push("TLitPattern\n")
            expr_field(out, inner, "value", value)
        TRangePattern(lo, hi, inclusive) ->
            out.push("TRangePattern\n")
            expr_field(out, inner, "lo", lo)
            expr_field(out, inner, "hi", hi)
            scalar_field(out, inner, "inclusive", flag(inclusive))
        TVariantPattern(enum_ty, v, args) ->
            out.push("TVariantPattern\n")
            scalar_field(out, inner, "enumTy", type_show(enum_ty))
            variant_field(out, inner, "variant", v)
            pattern_list(out, inner, "args", args)
        TStructPattern(d, args) ->
            out.push("TStructPattern\n")
            scalar_field(out, inner, "struct", type_show(Struct(d)))
            pattern_list(out, inner, "args", args)

// -- a condition's terms, and a match's arms -----------------------------------------------------

private cond_term_list(out: *StrBuilder, indent: string, name: string, xs: Buf[TCondTerm])
    if xs.is_empty()
        scalar_field(out, indent, name, "[]")
        return
    end if

    out.push(indent)
    out.push(name)
    out.push(": \n")

    val item = indent + "  "

    for i in 0..<xs.len()
        out.push(item)
        out.push("- ")
        cond_term_node(out, item + "  ", xs.at(i))

private cond_term_node(out: *StrBuilder, indent: string, c: TCondTerm)
    val inner = indent + "  "

    c match
        TCondTest(cond) ->
            out.push("TCondTest\n")
            expr_field(out, inner, "cond", cond)
        TCondIs(subject, patterns, negated) ->
            out.push("TCondIs\n")
            expr_field(out, inner, "subject", subject)
            pattern_list(out, inner, "patterns", patterns)
            scalar_field(out, inner, "negated", flag(negated))

private arm_list(out: *StrBuilder, indent: string, name: string, xs: Buf[TArm])
    if xs.is_empty()
        scalar_field(out, indent, name, "[]")
        return
    end if

    out.push(indent)
    out.push(name)
    out.push(": \n")

    val item = indent + "  "

    for i in 0..<xs.len()
        out.push(item)
        out.push("- TArm\n")
        pattern_list(out, item + "    ", "patterns", xs.at(i).patterns)
        opt_expr_field(out, item + "    ", "guard", xs.at(i).guard)
        block_field(out, item + "    ", "body", xs.at(i).body)

// An enum variant, read generically the way the reference's printer reads any record with no
// hierarchy of its own.
private variant_field(out: *StrBuilder, indent: string, name: string, v: EnumVariant)
    out.push(indent)
    out.push(name)
    out.push(": EnumVariant\n")

    val inner = indent + "  "

    scalar_field(out, inner, "name", quoted_text(v.name))
    scalar_field(out, inner, "tag", s"${v.tag}")
    pair_list(out, inner, "fields", v.fields)
    scalar_field(out, inner, "carries", flag(v.carries))

private cmp_list(out: *StrBuilder, indent: string, name: string, xs: Buf[TCmp])
    if xs.is_empty() then
        scalar_field(out, indent, name, "[]")
        return

    out.push(indent)
    out.push(name)
    out.push(": \n")

    val item = indent + "  "

    for i in 0..<xs.len()
        out.push(item)
        out.push("- TCmp\n")
        scalar_field(out, item + "    ", "op", quoted_text(xs.at(i).op))
        dispatch_field(out, item + "    ", "dispatch", xs.at(i).dispatch)

// How a comparison or a compound assignment reached an implementation. A dispatch is a node like
// any other, so its three fields print two spaces deeper than the line that named it.
private dispatch_field(out: *StrBuilder, indent: string, name: string, d: Option[TDispatch])
    d match
        None -> scalar_field(out, indent, name, "None")
        Some(one) ->
            scalar_field(out, indent, name, "TDispatch")
            scalar_field(out, indent + "  ", "name", quoted_text(one.name))
            scalar_field(out, indent + "  ", "swap", flag(one.swap))
            scalar_field(out, indent + "  ", "negate", flag(one.negate))

private type_list(ts: Buf[Type]) -> string
    if ts.is_empty() then return "[]"

    var out = "["

    for i in 0..<ts.len()
        if i > 0 then out = out + ", "

        out = out + type_show(ts.at(i))

    out + "]"
end type_list

// -- one node ---------------------------------------------------------------------------------------

// A typed expression, written out. The header line's tag has already been positioned by the caller;
// what this writes is that tag, a newline, and every field two spaces deeper.
private expr_node(out: *StrBuilder, indent: string, e: TExpr)
    val inner = indent + "  "

    *e.kind match
        TIntLit(value, ty) ->
            out.push("TIntLit\n")
            scalar_field(out, inner, "value", to_string(value))
            scalar_field(out, inner, "ty", type_show(ty))
        TFloatLit(bits, ty) ->
            out.push("TFloatLit\n")
            scalar_field(out, inner, "bits", s"$bits")
            scalar_field(out, inner, "ty", type_show(ty))
        TStrLit(value) ->
            out.push("TStrLit\n")
            scalar_field(out, inner, "value", quoted_text(value))
        TBoolLit(value) ->
            out.push("TBoolLit\n")
            scalar_field(out, inner, "value", flag(value))
        TUnitLit -> out.push("TUnitLit\n")
        TNullLit(ty) ->
            out.push("TNullLit\n")
            scalar_field(out, inner, "ty", type_show(ty))
        TBox(value, ref_ty) ->
            out.push("TBox\n")
            expr_field(out, inner, "value", value)
            scalar_field(out, inner, "refTy", type_show(ref_ty))
        TDowngrade(value, weak_ty) ->
            out.push("TDowngrade\n")
            expr_field(out, inner, "value", value)
            scalar_field(out, inner, "weakTy", type_show(weak_ty))
        TZero(ty) ->
            out.push("TZero\n")
            scalar_field(out, inner, "ty", type_show(ty))
        TArrayLit(elems, array_ty) ->
            out.push("TArrayLit\n")
            expr_list(out, inner, "elems", elems)
            scalar_field(out, inner, "arrayTy", type_show(array_ty))
        TArrayFill(value, array_ty) ->
            out.push("TArrayFill\n")
            expr_field(out, inner, "value", value)
            scalar_field(out, inner, "arrayTy", type_show(array_ty))
        TVectorLit(lanes, vec_ty) ->
            out.push("TVectorLit\n")
            expr_list(out, inner, "lanes", lanes)
            scalar_field(out, inner, "vecTy", type_show(vec_ty))
        TSplat(value, vec_ty) ->
            out.push("TSplat\n")
            expr_field(out, inner, "value", value)
            scalar_field(out, inner, "vecTy", type_show(vec_ty))
        TLane(receiver, lane, ty) ->
            out.push("TLane\n")
            expr_field(out, inner, "receiver", receiver)
            scalar_field(out, inner, "lane", s"$lane")
            scalar_field(out, inner, "ty", type_show(ty))
        TBufLit(elems, slice_ty) ->
            out.push("TBufLit\n")
            expr_list(out, inner, "elems", elems)
            scalar_field(out, inner, "sliceTy", type_show(slice_ty))
        TBufFill(value, count, slice_ty) ->
            out.push("TBufFill\n")
            expr_field(out, inner, "value", value)
            expr_field(out, inner, "count", count)
            scalar_field(out, inner, "sliceTy", type_show(slice_ty))
        TIndex(receiver, index, ty) ->
            out.push("TIndex\n")
            expr_field(out, inner, "receiver", receiver)
            expr_field(out, inner, "index", index)
            scalar_field(out, inner, "ty", type_show(ty))
        TLen(receiver, ty) ->
            out.push("TLen\n")
            expr_field(out, inner, "receiver", receiver)
            scalar_field(out, inner, "ty", type_show(ty))
        TBytes(receiver) ->
            out.push("TBytes\n")
            expr_field(out, inner, "receiver", receiver)
        TSlice(base, lo, hi, inclusive, slice_ty) ->
            out.push("TSlice\n")
            expr_field(out, inner, "base", base)
            opt_expr_field(out, inner, "lo", lo)
            opt_expr_field(out, inner, "hi", hi)
            scalar_field(out, inner, "inclusive", flag(inclusive))
            scalar_field(out, inner, "sliceTy", type_show(slice_ty))
        TCast(operand, ty) ->
            out.push("TCast\n")
            expr_field(out, inner, "operand", operand)
            scalar_field(out, inner, "ty", type_show(ty))
        // A call through a table, by the slot the trait gave the member.
        TVCall(receiver, slot, args, ty, results) ->
            out.push("TVCall\n")
            expr_field(out, inner, "receiver", receiver)
            scalar_field(out, inner, "slot", str(slot))
            expr_list(out, inner, "args", args)
            scalar_field(out, inner, "ty", type_show(ty))
            scalar_field(out, inner, "results", flag(results))
        // A value put behind a trait's table, which is what makes a fat pointer.
        TErase(operand, vtable, ty) ->
            out.push("TErase\n")
            expr_field(out, inner, "operand", operand)
            scalar_field(out, inner, "vtable", quoted_text(vtable))
            scalar_field(out, inner, "ty", type_show(ty))
        // A write with the re-check of the invariant it owes wrapped around it.
        TRecheck(after, recv, decl, inv_fn) ->
            out.push("TRecheck\n")
            expr_field(out, inner, "after", after)
            expr_field(out, inner, "recv", recv)
            scalar_field(out, inner, "struct", type_show(Struct(decl)))
            scalar_field(out, inner, "invFn", quoted_text(inv_fn))
        TConstrainedCheck(value, target) ->
            out.push("TConstrainedCheck\n")
            expr_field(out, inner, "value", value)
            scalar_field(out, inner, "target", type_show(target))
        TLoad(name, ty) ->
            out.push("TLoad\n")
            scalar_field(out, inner, "name", quoted_text(name))
            scalar_field(out, inner, "ty", type_show(ty))
        TResult(ty) ->
            out.push("TResult\n")
            scalar_field(out, inner, "ty", type_show(ty))
        TGlobal(symbol, ty, writable) ->
            out.push("TGlobal\n")
            scalar_field(out, inner, "symbol", quoted_text(symbol))
            scalar_field(out, inner, "ty", type_show(ty))
            scalar_field(out, inner, "writable", flag(writable))
        TDeref(operand, ty) ->
            out.push("TDeref\n")
            expr_field(out, inner, "operand", operand)
            scalar_field(out, inner, "ty", type_show(ty))
        TAddrOf(place, ty) ->
            out.push("TAddrOf\n")
            expr_field(out, inner, "place", place)
            scalar_field(out, inner, "ty", type_show(ty))
        TTempAddr(value, ty) ->
            out.push("TTempAddr\n")
            expr_field(out, inner, "value", value)
            scalar_field(out, inner, "ty", type_show(ty))
        TIncDec(place, op, pre, ty, check) ->
            out.push("TIncDec\n")
            expr_field(out, inner, "place", place)
            scalar_field(out, inner, "op", quoted_text(op))
            scalar_field(out, inner, "pre", flag(pre))
            scalar_field(out, inner, "ty", type_show(ty))
            scalar_field(out, inner, "check", opt_type(check))
        TBinary(op, left, right, ty) ->
            out.push("TBinary\n")
            scalar_field(out, inner, "op", quoted_text(op))
            expr_field(out, inner, "left", left)
            expr_field(out, inner, "right", right)
            scalar_field(out, inner, "ty", type_show(ty))
        TUnary(op, operand, ty) ->
            out.push("TUnary\n")
            scalar_field(out, inner, "op", quoted_text(op))
            expr_field(out, inner, "operand", operand)
            scalar_field(out, inner, "ty", type_show(ty))
        TLogical(op, left, right) ->
            out.push("TLogical\n")
            scalar_field(out, inner, "op", quoted_text(op))
            expr_field(out, inner, "left", left)
            expr_field(out, inner, "right", right)
        TCompare(operands, cmps) ->
            out.push("TCompare\n")
            expr_list(out, inner, "operands", operands)
            cmp_list(out, inner, "cmps", cmps)
        TStr(arg) ->
            out.push("TStr\n")
            expr_field(out, inner, "arg", arg)
        TRender(value, method, spec, slot) ->
            out.push("TRender\n")
            expr_field(out, inner, "value", value)
            scalar_field(out, inner, "method", quoted_text(method))
            expr_field(out, inner, "spec", spec)
            scalar_field(out, inner, "slot", int_option_text(slot))
        TFromBytes(arg) ->
            out.push("TFromBytes\n")
            expr_field(out, inner, "arg", arg)
        TUpgrade(value, opt_ty, some, none) ->
            out.push("TUpgrade\n")
            expr_field(out, inner, "value", value)
            scalar_field(out, inner, "optTy", type_show(opt_ty))
            variant_field(out, inner, "some", some)
            variant_field(out, inner, "none", none)
        TVaStart(ap) ->
            out.push("TVaStart\n")
            expr_field(out, inner, "ap", ap)
        TVaEnd(ap) ->
            out.push("TVaEnd\n")
            expr_field(out, inner, "ap", ap)
        TVaArg(ap, ty) ->
            out.push("TVaArg\n")
            expr_field(out, inner, "ap", ap)
            scalar_field(out, inner, "ty", type_show(ty))
        TVaCopy(dst, src) ->
            out.push("TVaCopy\n")
            expr_field(out, inner, "dst", dst)
            expr_field(out, inner, "src", src)
        TVaPass(ap) ->
            out.push("TVaPass\n")
            expr_field(out, inner, "ap", ap)
        TConstView(arg) ->
            out.push("TConstView\n")
            expr_field(out, inner, "arg", arg)
        TFormat(arg, spec) ->
            out.push("TFormat\n")
            expr_field(out, inner, "arg", arg)
            scalar_field(out, inner, "spec", quoted_text(spec))
        TCStrLit(value) ->
            out.push("TCStrLit\n")
            scalar_field(out, inner, "value", quoted_text(value))
        TCall(name, args, ty, results) ->
            out.push("TCall\n")
            scalar_field(out, inner, "name", quoted_text(name))
            expr_list(out, inner, "args", args)
            scalar_field(out, inner, "ty", type_show(ty))
            scalar_field(out, inner, "results", flag(results))
        TCallPtr(callee, args, params, ty) ->
            out.push("TCallPtr\n")
            expr_field(out, inner, "callee", callee)
            expr_list(out, inner, "args", args)
            scalar_field(out, inner, "params", type_list(params))
            scalar_field(out, inner, "ty", type_show(ty))
        TStructNew(decl, args) ->
            out.push("TStructNew\n")
            scalar_field(out, inner, "struct", type_show(Struct(decl)))
            expr_list(out, inner, "args", args)
        TEnumNew(enum_ty, variant, args) ->
            out.push("TEnumNew\n")
            scalar_field(out, inner, "enumTy", type_show(enum_ty))
            variant_field(out, inner, "variant", variant)
            expr_list(out, inner, "args", args)
        TEnumFromInt(value, en) ->
            out.push("TEnumFromInt\n")
            expr_field(out, inner, "value", value)
            scalar_field(out, inner, "en", type_show(en))
        TTry(operand, ok_variant, fail_variant, ret_enum, ret_fail, ty, convert) ->
            out.push("TTry\n")
            expr_field(out, inner, "operand", operand)
            variant_field(out, inner, "okVariant", ok_variant)
            variant_field(out, inner, "failVariant", fail_variant)
            scalar_field(out, inner, "retEnum", type_show(ret_enum))
            variant_field(out, inner, "retFail", ret_fail)
            scalar_field(out, inner, "ty", type_show(ty))
            scalar_field(out, inner, "convert", option_text(convert))
        TField(receiver, index, ty) ->
            out.push("TField\n")
            expr_field(out, inner, "receiver", receiver)
            scalar_field(out, inner, "index", s"$index")
            scalar_field(out, inner, "ty", type_show(ty))
        TStore(place, value, ty) ->
            out.push("TStore\n")
            expr_field(out, inner, "place", place)
            expr_field(out, inner, "value", value)
            scalar_field(out, inner, "ty", type_show(ty))
        TUpdate(place, op, value, ty, dispatch, check) ->
            out.push("TUpdate\n")
            expr_field(out, inner, "place", place)
            scalar_field(out, inner, "op", quoted_text(op))
            expr_field(out, inner, "value", value)
            scalar_field(out, inner, "ty", type_show(ty))
            dispatch_field(out, inner, "dispatch", dispatch)
            scalar_field(out, inner, "check", opt_type(check))
        TSeq(exprs) ->
            out.push("TSeq\n")
            expr_list(out, inner, "exprs", exprs)
        TOld(index, ty) ->
            out.push("TOld\n")
            scalar_field(out, inner, "index", s"$index")
            scalar_field(out, inner, "ty", type_show(ty))
        TIf(cond, then_block, else_block, ty) ->
            out.push("TIf\n")
            cond_term_list(out, inner, "cond", cond)
            block_field(out, inner, "thenBlock", then_block)
            opt_block_field(out, inner, "elseBlock", else_block)
            scalar_field(out, inner, "ty", type_show(ty))
        TMatch(scrutinee, arms, ty) ->
            out.push("TMatch\n")
            expr_field(out, inner, "scrutinee", scrutinee)
            arm_list(out, inner, "arms", arms)
            scalar_field(out, inner, "ty", type_show(ty))
        TBlockExpr(block) ->
            out.push("TBlockExpr\n")
            block_field(out, inner, "block", block)
        TWhile(cond, body, else_block, ty) ->
            out.push("TWhile\n")
            cond_term_list(out, inner, "cond", cond)
            stmt_list(out, inner, "body", body)
            opt_block_field(out, inner, "elseBlock", else_block)
            scalar_field(out, inner, "ty", type_show(ty))
        TDoWhile(body, cond, else_block, ty) ->
            out.push("TDoWhile\n")
            stmt_list(out, inner, "body", body)
            expr_field(out, inner, "cond", cond)
            opt_block_field(out, inner, "elseBlock", else_block)
            scalar_field(out, inner, "ty", type_show(ty))
        TLoop(body, ty) ->
            out.push("TLoop\n")
            stmt_list(out, inner, "body", body)
            scalar_field(out, inner, "ty", type_show(ty))
        TFor(name, var_ty, lo, hi, inclusive, body, else_block, ty) ->
            out.push("TFor\n")
            scalar_field(out, inner, "name", quoted_text(name))
            scalar_field(out, inner, "varTy", type_show(var_ty))
            expr_field(out, inner, "lo", lo)
            expr_field(out, inner, "hi", hi)
            scalar_field(out, inner, "inclusive", flag(inclusive))
            stmt_list(out, inner, "body", body)
            opt_block_field(out, inner, "elseBlock", else_block)
            scalar_field(out, inner, "ty", type_show(ty))
        TCFor(init, cond, step, body, else_block, ty) ->
            out.push("TCFor\n")
            stmt_list(out, inner, "init", init)
            opt_expr_field(out, inner, "cond", cond)
            stmt_list(out, inner, "step", step)
            stmt_list(out, inner, "body", body)
            opt_block_field(out, inner, "elseBlock", else_block)
            scalar_field(out, inner, "ty", type_show(ty))
        TForEach(name, elem_ty, seq, body, else_block, ty) ->
            out.push("TForEach\n")
            scalar_field(out, inner, "name", quoted_text(name))
            scalar_field(out, inner, "elemTy", type_show(elem_ty))
            expr_field(out, inner, "seq", seq)
            stmt_list(out, inner, "body", body)
            opt_block_field(out, inner, "elseBlock", else_block)
            scalar_field(out, inner, "ty", type_show(ty))
        TIterate(cursor, cursor_ty, init, next, bind, body, else_block, ty) ->
            out.push("TIterate\n")
            scalar_field(out, inner, "cursor", quoted_text(cursor))
            scalar_field(out, inner, "cursorTy", type_show(cursor_ty))
            expr_field(out, inner, "init", init)
            expr_field(out, inner, "next", next)
            pattern_field(out, inner, "bind", bind)
            stmt_list(out, inner, "body", body)
            opt_block_field(out, inner, "elseBlock", else_block)
            scalar_field(out, inner, "ty", type_show(ty))
        TQuantifier(universal, name, var_ty, lo, hi, inclusive, pred) ->
            out.push("TQuantifier\n")
            scalar_field(out, inner, "universal", flag(universal))
            scalar_field(out, inner, "name", quoted_text(name))
            scalar_field(out, inner, "varTy", type_show(var_ty))
            expr_field(out, inner, "lo", lo)
            expr_field(out, inner, "hi", hi)
            scalar_field(out, inner, "inclusive", flag(inclusive))
            expr_field(out, inner, "pred", pred)
        TCheckedLoop(slot, var_ty, walked) ->
            out.push("TCheckedLoop\n")
            scalar_field(out, inner, "slot", quoted_text(slot))
            scalar_field(out, inner, "varTy", type_show(var_ty))
            expr_field(out, inner, "loop", walked)
        TIntOp(op, operand, amount, width, ty) ->
            out.push("TIntOp\n")
            scalar_field(out, inner, "op", quoted_text(op))
            expr_field(out, inner, "operand", operand)
            opt_expr_field(out, inner, "amount", amount)
            scalar_field(out, inner, "width", type_show(width))
            scalar_field(out, inner, "ty", type_show(ty))
        TAtomic(op, addr, ops, ordering, at, ty) ->
            out.push("TAtomic\n")
            scalar_field(out, inner, "op", quoted_text(op))
            expr_field(out, inner, "addr", addr)
            expr_list(out, inner, "ops", ops)
            scalar_field(out, inner, "ordering", quoted_text(ordering))
            scalar_field(out, inner, "at", type_show(at))
            scalar_field(out, inner, "ty", type_show(ty))
        TFence(ordering) ->
            out.push("TFence\n")
            scalar_field(out, inner, "ordering", quoted_text(ordering))
        TFuncAddr(name, entry, ty) ->
            out.push("TFuncAddr\n")
            scalar_field(out, inner, "name", quoted_text(name))
            scalar_field(out, inner, "entry", quoted_text(entry))
            scalar_field(out, inner, "ty", type_show(ty))
        TTypeId(receiver, ty) ->
            out.push("TTypeId\n")
            expr_field(out, inner, "receiver", receiver)
            scalar_field(out, inner, "ty", type_show(ty))
        TEnumAttr(kind, en, arg, ty) ->
            out.push("TEnumAttr\n")
            scalar_field(out, inner, "kind", quoted_text(kind))
            scalar_field(out, inner, "en", type_show(en))
            expr_field(out, inner, "arg", arg)
            scalar_field(out, inner, "ty", type_show(ty))
        TConstrainedValid(value, target) ->
            out.push("TConstrainedValid\n")
            expr_field(out, inner, "value", value)
            scalar_field(out, inner, "target", type_show(target))
        TConstrainedStep(value, target, up, ty) ->
            out.push("TConstrainedStep\n")
            expr_field(out, inner, "value", value)
            scalar_field(out, inner, "target", type_show(target))
            scalar_field(out, inner, "up", flag(up))
            scalar_field(out, inner, "ty", type_show(ty))
        // A node this stage does not build. It is named rather than dropped, so a diff that meets
        // one says which node is missing instead of quietly agreeing.
        _ ->
            out.push("TUnprinted\n")

private int_option_text(v: Option[int]) -> string = v match
    Some(n) -> str(n)
    None -> "None"

private opt_type(t: Option[Type]) -> string = t match
    Some(x) -> type_show(x)
    None -> "None"

// A double-quoted string, escaped the way both printers escape one.
private quoted_text(s: string) -> string
    var out = str_builder()

    quoted(&out, s)
    out.finish()
end quoted_text

// The `funcs:` section of `sysl emit-typed --tables`, for the declarations a file makes of its own.
//
// **It is the one section of that report a compiler which has not done reachability can be held
// to.** The rest -- `structs:`, `enums:`, `externs:`, `consts:` -- carry only what the analysis
// *reached*: a simple enum nobody names, an `extern` nobody calls and a `val` nobody reads are all
// absent from the reference's tables, and deciding what a program reaches is the driver's stage.
// `funcs:` is every function the file declares, called or not, so the two tables are the same set
// by construction and a difference is a real one.
show_funcs_table(a: &Analysis) -> string
    var own: Buf[string] = buf()

    own.push("")
    show_funcs_table_of(a, own)
end show_funcs_table

// The same, for a compilation whose own modules are named -- which is every program that is more
// than one file. **The library's rows are not this program's**: a compilation reads the standard
// module's declarations to resolve its own names, and a table of what the program declares would
// otherwise be a table of the library.
show_funcs_table_of(a: &Analysis, own: Buf[string]) -> string
    var keys: Buf[string] = buf()

    for i in 0..<a.tables.funcs.len()
        val key = a.tables.funcs.key_at(i)

        if names_own_module(own, module_of(key)) then keys.push(key)

    // **A member is a function**, so it is a row of this table like any other -- filed under the name
    // it was lowered to rather than under the key it is looked up by, which is what the reference
    // prints and what an object file will carry.
    val lowered = a.tables.members.func_insts

    for i in 0..<lowered.len()
        if names_own_module(own, module_of(lowered.key_at(i))) then keys.push(lowered.key_at(i))

    sort_names(&keys)

    var out = str_builder()

    out.push("funcs:\n")

    for i in 0..<keys.len()
        val f = a.tables.funcs.get(keys.at(i))

        if f.is_none()
            write_lowered_row(&out, keys.at(i), lowered.get(keys.at(i)).unwrap())
            continue
        end if

        out.push("  ")
        out.push(keys.at(i))
        out.push("(")

        for j in 0..<f.unwrap().decl.params.len()
            val p = f.unwrap().decl.params.at(j)

            if j > 0 then out.push(", ")

            out.push(p.name)
            out.push(": ")
            out.push(type_show(resolve_type(a, f.unwrap().scope, p.typ, no_bindings())))

        out.push(") -> ")
        out.push(type_show(declared_result_in(a, f.unwrap().scope, f.unwrap().decl.ret_type)))
        out.push_char('\n')

    out.finish()
end show_funcs_table_of

private names_own_module(own: Buf[string], name: string) -> bool
    for i in 0..<own.len()
        if own.at(i) == name then return true

    false
end names_own_module

// One row for a function the tables already hold the signature of, which is every member and every
// instantiation: the names and the types are the ones that were made real, so nothing is resolved
// again here.
private write_lowered_row(out: *StrBuilder, name: string, sig: FuncSig)
    out.push("  ")
    out.push(name)
    out.push("(")

    for i in 0..<sig.params.len()
        if i > 0 then out.push(", ")

        out.push(sig.params.at(i).0)
        out.push(": ")
        out.push(type_show(sig.params.at(i).1))

    out.push(") -> ")
    out.push(type_show(sig.ret))
    out.push_char('\n')
end write_lowered_row

private declared_result_in(a: &Analysis, scope: Scope, written: Option[TypeRef]) -> Type
    if written.is_none() then return Unit

    result_type(resolve_type(a, scope, written.unwrap(), no_bindings()))
end declared_result_in
