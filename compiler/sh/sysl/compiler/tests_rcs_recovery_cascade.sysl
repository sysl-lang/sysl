module sh.sysl.compiler
@tests

// A refused line that opens an indented block: recovery steps over the block with the line, so its
// dedent is not complained about a second time. Every line list was read out of the reference
// compiler (0.0.162) over the same input.

@test("a refused declaration head takes its body with it")
rcs_a_refused_head_takes_its_body()
    assert_eq(pf_line_text("struct S oops\n    x: int\nprint(1)\n"), "1")

@test("a stray 'else' takes its block with it")
rcs_a_stray_else_takes_its_block()
    assert_eq(pf_line_text("loop\n    print(1)\nelse\n    print(2)\nprint(3)\n"), "3")

@test("a refused 'for' header inside a body takes the loop's block, and the next mistake is still found")
rcs_a_refused_for_inside_a_body()
    assert_eq(pf_line_text("f() =\n    for a, b in [(1, 2)]\n        print(a)\n    print(1 2)\nf()\n"),
        "2 4")

@test("a refused 'impl' visibility takes the block's members with it")
rcs_a_refused_impl_visibility()
    assert_eq(pf_line_text("private impl Show for P\n    show(self) -> int = 1\nprint(1)\n"), "1")

@test("a refused member annotation has stepped over its line, so the next field is read as one")
rcs_a_refused_member_annotation()
    assert_eq(pf_line_text("struct P\n    @assert(1 == 1)\n    x: int\n    y: int\n"), "2")
