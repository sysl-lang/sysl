import sysl.buf.*
// A struct holding a buffer, passed by value to a read-only function in a loop.
struct Bag
    b: Buf[long]
    n: long

sum_some(s: Bag) -> long = s.b[0] + s.b[1] + s.b[2] + s.b[3] + s.n

var bag = Bag(buf(), 7)

for i in 0..<16
    bag.b.push(long(i))

var acc: long = 0

for i in 0..<600000000
    acc += sum_some(bag)

print(acc)
