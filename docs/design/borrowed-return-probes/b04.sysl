// `@views(self)` is the one borrowed return there is today, and it is narrow by its own words
// (memory.md § A view borrowed from its receiver): only a view result. On a struct result it is
// refused.
struct Node
    level: int
    kids: Option[Kids]

    @views(self)
    quad(&self) -> Kids = self.kids.unwrap()

struct Kids
    nw: &Node
    ne: &Node
    sw: &Node
    se: &Node

val n: &Node = Node(0, None)

print(n.level)
