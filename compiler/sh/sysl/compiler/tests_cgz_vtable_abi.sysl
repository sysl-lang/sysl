module sh.sysl.compiler
@tests

import sysl.text.Search
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture

// An aggregate crossing at a function pointer HELD IN A STRUCT MEMBER, in both directions -- the shape
// a callback-table C API has (CEF, llhttp's settings, COM): nothing is called by name, a caller loads
// a function pointer out of a struct the other language filled in and calls through it. The shapes are
// CEF's: eight bytes, sixteen, twenty-four of mixed pointer and integer, and thirty-two of plain `int`,
// which is both sides of every convention's register threshold. `999` is the C saying it read
// something other than what it wrote; the sysl-driven cases return a bitmask naming which member
// disagreed. Every case printed `0` under the reference compiler (0.0.162).

private cgz_types() -> string = raw"""
    struct Point
        x: i32
        y: i32

    struct Size
        width: i32
        height: i32

    struct Rect
        x: i32
        y: i32
        width: i32
        height: i32

    struct Str
        text: *u16
        length: usize
        dtor: *extern(*u16) -> unit

    struct Stamp
        year: i32
        month: i32
        day: i32
        hour: i32
        minute: i32
        second: i32
        milli: i32
        micro: i32
    end Stamp

    struct Base
        size: usize
        add_ref: *extern(*Base) -> unit
        release: *extern(*Base) -> i32

    struct Delegate
        base: Base
        preferred_size: *extern(*Delegate) -> Size
        bounds: *extern(*Delegate) -> Rect
        label: *extern(*Delegate) -> Str
        stamp: *extern(*Delegate) -> Stamp
        on_point: *extern(*Delegate, Point) -> i32
        on_stamp: *extern(*Delegate, Stamp) -> i32
    end Delegate

    struct Table
        base: Base
        bounds: *extern(*Table) -> Rect
        extent: *extern(*Table) -> Size
        label: *extern(*Table) -> Str
        on_point: *extern(*Table, Point) -> i32
        on_stamp: *extern(*Table, Stamp) -> i32
    end Table

    """

// The callbacks C reaches through the struct, each `@export` -- the plain form is refused, and the
// last case here is that refusal. `self` is reserved, so the parameter is written in backticks.
private cgz_handlers() -> string = raw"""
    @export("d_add_ref")
    d_add_ref(`self`: *Base) -> unit = ()

    @export("d_release")
    d_release(`self`: *Base) -> i32 = 4242

    @export("d_preferred_size")
    d_preferred_size(`self`: *Delegate) -> Size = Size(1280, 720)

    @export("d_bounds")
    d_bounds(`self`: *Delegate) -> Rect = Rect(11, 22, 33, 44)

    @export("d_label")
    d_label(`self`: *Delegate) -> Str = Str(null, 7, null)

    @export("d_stamp")
    d_stamp(`self`: *Delegate) -> Stamp = Stamp(2026, 8, 29, 13, 5, 7, 250, 61)

    @export("d_on_point")
    d_on_point(`self`: *Delegate, p: Point) -> i32 = p.x * 1000 + p.y

    @export("d_on_stamp")
    d_on_stamp(`self`: *Delegate, s: Stamp) -> i32 = s.year * 1000 + s.micro

    var delegate: Delegate = Delegate(
        Base(sizeof(Delegate), &d_add_ref, &d_release),
        &d_preferred_size,
        &d_bounds,
        &d_label,
        &d_stamp,
        &d_on_point,
        &d_on_stamp)

    extern "probe_ask" ask(d: *Delegate) -> int

    check() -> int = ask(&delegate)

    """

private cgz_c_types() -> string = raw"""
    #include <stdint.h>
    #include <stddef.h>

    typedef struct { int32_t x, y; } Point;
    typedef struct { int32_t width, height; } Size;
    typedef struct { int32_t x, y, width, height; } Rect;
    typedef struct { uint16_t* text; size_t length; void ( *dtor )( uint16_t* ); } Str;
    typedef struct { int32_t year, month, day, hour, minute, second, milli, micro; } Stamp;

    typedef struct _Base {
        size_t size;
        void ( *add_ref )( struct _Base* self );
        int32_t ( *release )( struct _Base* self );
    } Base;

    typedef struct _Delegate {
        Base base;
        Size ( *preferred_size )( struct _Delegate* self );
        Rect ( *bounds )( struct _Delegate* self );
        Str ( *label )( struct _Delegate* self );
        Stamp ( *stamp )( struct _Delegate* self );
        int32_t ( *on_point )( struct _Delegate* self, Point p );
        int32_t ( *on_stamp )( struct _Delegate* self, Stamp s );
    } Delegate;

    typedef struct _Table {
        Base base;
        Rect ( *bounds )( struct _Table* self );
        Size ( *extent )( struct _Table* self );
        Str ( *label )( struct _Table* self );
        int32_t ( *on_point )( struct _Table* self, Point p );
        int32_t ( *on_stamp )( struct _Table* self, Stamp s );
    } Table;

    """

// The library-implemented side: a table C built, for the cases sysl drives.
private cgz_c_table() -> string = raw"""
    static void t_add_ref( Base* self ) { (void)self; }
    static int32_t t_release( Base* self ) { (void)self; return 7; }

    static Rect t_bounds( Table* self ) { (void)self; return (Rect){ 101, 102, 103, 104 }; }
    static Size t_extent( Table* self ) { (void)self; return (Size){ 201, 202 }; }
    static Str t_label( Table* self ) { (void)self; return (Str){ NULL, 31, NULL }; }
    static int32_t t_on_point( Table* self, Point p ) { (void)self; return p.x * 1000 + p.y; }
    static int32_t t_on_stamp( Table* self, Stamp s ) { (void)self; return s.year * 1000 + s.micro; }

    static Table the_table = {
        { sizeof(Table), t_add_ref, t_release },
        t_bounds,
        t_extent,
        t_label,
        t_on_point,
        t_on_stamp
    };

    Table* probe_table( void ) { return &the_table; }

    void probe_sizes( size_t* out )
    {
        out[0] = sizeof(Base);
        out[1] = sizeof(Delegate);
        out[2] = sizeof(Str);
        out[3] = sizeof(Stamp);
    }

    """

// A project whose module `p` carries the C, and a `main.sysl` printing `p.check()` -- what it printed.
private cgz_project(sysl: string, c: string) -> string
    val root = make_temp_dir("sysl-cgz-vtable").unwrap()

    make_dir_all(s"$root/p").unwrap()
    write_text(s"$root/main.sysl", "print(p.check())\n").unwrap()
    write_text(s"$root/p/p.sysl", s"module p\n\n$sysl").unwrap()
    write_text(s"$root/p/probe.c", c).unwrap()

    val exe = s"$root/built"

    val said = build_native_program(root, None, None, DefaultOptimization, Some(exe)) match
        Err(why) -> s"refused: ${failure_text(why)}"
        Ok(made) -> capture(made, [], "", [], true) match
            Err(_) -> "the program that was built could not be run"
            Ok(out) -> if out.status.ok() then out.text else s"exited badly: ${out.text}"

    remove_dir_all(root).unwrap_or(())
    said
end cgz_project

private cgz_c_drives(body: string) -> string = cgz_project(cgz_types() + cgz_handlers(), cgz_c_types() + body)

private cgz_sysl_drives(body: string) -> string =
    cgz_project(cgz_types() + "extern \"probe_table\" probe_table() -> *Table\n\n" + body,
                cgz_c_types() + cgz_c_table())

// -- an aggregate a sysl callback returns through a struct member arrives whole --------------------

// Eight bytes: the callee never sees the caller's storage.
@test("a small one")
cgz_returns_a_small_one()
    if !enm_ready() then return

    assert_eq(cgz_c_drives("int probe_ask( Delegate* d )\n{\n    Size s = d->preferred_size( d );\n\n" +
                           "    return s.width == 1280 && s.height == 720 ? 0 : 999;\n}\n"), "0\n")

// Sixteen bytes, the last size that still travels in registers.
@test("one at the register threshold")
cgz_returns_one_at_the_threshold()
    if !enm_ready() then return

    assert_eq(cgz_c_drives("int probe_ask( Delegate* d )\n{\n    Rect r = d->bounds( d );\n\n" +
                           "    return r.x == 11 && r.y == 22 && r.width == 33 && r.height == 44 ? 0 : 999;\n}\n"),
              "0\n")

// Twenty-four bytes of mixed pointer and integer: back through storage the caller supplied.
@test("one past it, of mixed pointer and integer")
cgz_returns_one_past_it_mixed()
    if !enm_ready() then return

    assert_eq(cgz_c_drives("int probe_ask( Delegate* d )\n{\n    Str l = d->label( d );\n\n" +
                           "    return l.length == 7 && l.text == NULL && l.dtor == NULL ? 0 : 999;\n}\n"), "0\n")

// Thirty-two bytes of plain `int`: every field is checked, to see a partial copy.
@test("one past it, of nothing but integers")
cgz_returns_one_past_it_integers()
    if !enm_ready() then return

    assert_eq(cgz_c_drives("int probe_ask( Delegate* d )\n{\n    Stamp s = d->stamp( d );\n\n" +
                           "    return s.year == 2026 && s.month == 8 && s.day == 29 && s.hour == 13 &&\n" +
                           "           s.minute == 5 && s.second == 7 && s.milli == 250 && s.micro == 61 ? 0 : 999;\n}\n"),
              "0\n")

// -- an aggregate C passes by value into a sysl callback through a struct member arrives whole ----

@test("a small one, beside the receiver")
cgz_takes_a_small_one()
    if !enm_ready() then return

    assert_eq(cgz_c_drives("int probe_ask( Delegate* d )\n{\n" +
                           "    return d->on_point( d, (Point){ 6, 7 } ) == 6007 ? 0 : 999;\n}\n"), "0\n")

// Large enough to cross in memory: `byval` where the caller owes the callee a copy.
@test("one too large for registers")
cgz_takes_one_too_large()
    if !enm_ready() then return

    assert_eq(cgz_c_drives("int probe_ask( Delegate* d )\n{\n    Stamp s = { 1, 2, 3, 4, 5, 6, 7, 8 };\n\n" +
                           "    return d->on_stamp( d, s ) == 1008 ? 0 : 999;\n}\n"), "0\n")

// -- the struct a callback table is reached through agrees between the two compilers ---------------

// The member belongs to the `Base` embedded first, and takes that `Base` -- every release call a
// refcounted C API makes has this shape.
@test("a call through a member of an embedded struct reaches the right function")
cgz_a_call_through_an_embedded_member()
    if !enm_ready() then return

    assert_eq(cgz_c_drives("int probe_ask( Delegate* d )\n{\n" +
                           "    return d->base.release( &d->base ) == 4242 ? 0 : 999;\n}\n"), "0\n")

// The size is what a C API checks to decide the struct is the one it expects.
@test("the size sysl wrote into the base is the size C measures")
cgz_the_size_sysl_wrote_is_cs()
    if !enm_ready() then return

    assert_eq(cgz_c_drives("int probe_ask( Delegate* d )\n{\n" +
                           "    return d->base.size == sizeof(Delegate) ? 0 : 999;\n}\n"), "0\n")

@test("and every shape in the table measures the same in both")
cgz_every_shape_measures_the_same()
    if !enm_ready() then return

    assert_eq(cgz_sysl_drives(raw"""
        extern "probe_sizes" probe_sizes(out: *usize) -> unit

        check() -> int
            var cs: [4]usize = [0, 0, 0, 0]

            probe_sizes(&cs[0])

            var bad = 0

            if cs[0] != sizeof(Base) then bad = bad + 1
            if cs[1] != sizeof(Delegate) then bad = bad + 2
            if cs[2] != sizeof(Str) then bad = bad + 4
            if cs[3] != sizeof(Stamp) then bad = bad + 8

            bad
        end check
        """), "0\n")
end cgz_every_shape_measures_the_same

// -- an aggregate crossing the other way, at a function pointer C filled in ------------------------

@test("one a C function pointer returns, called from sysl")
cgz_one_a_c_pointer_returns()
    if !enm_ready() then return

    assert_eq(cgz_sysl_drives(raw"""
        check() -> int
            var t = probe_table()
            var r = (t.bounds)(t)
            var e = (t.extent)(t)
            var l = (t.label)(t)

            var bad = 0

            if r.x != 101 || r.y != 102 || r.width != 103 || r.height != 104 then bad = bad + 1
            if e.width != 201 || e.height != 202 then bad = bad + 2
            if l.length != 31 then bad = bad + 4

            bad
        end check
        """), "0\n")
end cgz_one_a_c_pointer_returns

@test("one sysl passes by value through a C function pointer")
cgz_one_sysl_passes_by_value()
    if !enm_ready() then return

    assert_eq(cgz_sysl_drives(raw"""
        check() -> int
            var t = probe_table()

            var bad = 0

            if (t.on_point)(t, Point(6, 7)) != 6007 then bad = bad + 1
            if (t.on_stamp)(t, Stamp(1, 2, 3, 4, 5, 6, 7, 8)) != 1008 then bad = bad + 2

            bad
        end check
        """), "0\n")
end cgz_one_sysl_passes_by_value

// The mirror of the release above, pinning the offset from the side that did not choose it.
@test("one through a member of the base C embedded")
cgz_one_through_the_base_c_embedded()
    if !enm_ready() then return

    assert_eq(cgz_sysl_drives(raw"""
        check() -> int
            var t = probe_table()
            var b = &t.base

            if (b.release)(b) == 7 && b.size == sizeof(Table) then 0 else 999
        """), "0\n")

// Without `@export` the address would be of the definition sysl emitted its own way. The refusal is
// quoted from the reference's own output.
@test("a callback returning an aggregate has no address without '@export'")
cgz_an_aggregate_callback_needs_export()
    if xvr_no_library() then return

    val said = cgz_ir("struct Size\n    width: i32\n    height: i32\n\nstruct Delegate\n" +
                      "    preferred_size: *extern(*Delegate) -> Size\n\n" +
                      "plain(d: *Delegate) -> Size = Size(1280, 720)\n\nvar v: Delegate = Delegate(&plain)\n\n" +
                      "print(((v.preferred_size)(&v)).width)\n")

    assert(said.contains("the result of 'plain' is Size, an aggregate, and an aggregate crosses to C in " +
                         "whichever registers that machine's convention names rather than the ones a sysl " +
                         "call uses"), said)
