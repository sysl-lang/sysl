module sysl.checksum
@no_alloc

/** Checksums that detect accidental corruption, and a fast hash for tables -- nothing an attacker
 * cannot forge.
 *
 * **A CRC is not a hash in the sense `sysl.crypto` means.** Anyone can build a second input with
 * the same CRC-32 on purpose, so it must never stand in for a digest where an attacker gains from a
 * collision. It is what zip, gzip, PNG and Ethernet put on the wire, and for those it is exactly
 * right. CRC-32C is the same construction over a better polynomial, and is what iSCSI, ext4, Btrfs
 * and RocksDB put on a page or a log record.
 */

// The reflected form of the IEEE 802.3 polynomial 0x04C11DB7, which is the one zip, PNG, gzip and
// Ethernet all use.
const crc32_poly: u32 = 0xedb88320

// Entry n is the remainder of the byte n divided by the polynomial, one bit at a time.
const make_crc32_table() -> [256]u32
    var t: [256]u32

    for n in 0..<256
        var c = u32(n)

        for _ in 0..<8
            c = if c & 1 == 1 then crc32_poly ^ c >> 1 else c >> 1

        t[n] = c

    t

val crc32_table: [256]u32 = make_crc32_table()

/** A CRC-32 in progress, for input that arrives in pieces.
 *
 * It is an ordinary struct, so copying one starts another from the same point. `update` may be
 * called as often as you like and `finish` answers the checksum so far without ending anything.
 */
struct Crc32
    private state: u32

    update(*self, data: []const u8)
        var c = self.state

        for b in data
            c = crc32_table[u8(c & 0xff) ^ b] ^ c >> 8

        self.state = c

    finish(self) -> u32 = ~self.state

/** A checksum ready for its first `update`. */
new_crc32() -> Crc32 = Crc32(0xffffffff)

/** The CRC-32 of one slice of bytes: initial value and final xor `0xffffffff`, polynomial
 * `0xedb88320` reflected. `crc32("123456789".bytes)` is `0xcbf43926`, the standard check value, and
 * the empty input is `0`.
 */
crc32(data: []const u8) -> u32
    var c = new_crc32()

    c.update(data)
    c.finish()

// -- CRC-32C ----------------------------------------------------------------------------------------

// The reflected form of Castagnoli's polynomial 0x1EDC6F41: iSCSI's (RFC 3720), and ext4's, Btrfs's
// and RocksDB's.
const crc32c_poly: u32 = 0x82f63b78

// Slicing by eight: row 0 is the byte-at-a-time table, and row k is what a byte contributes after k
// more zero bytes have gone through, so one step folds eight bytes with eight independent lookups.
const make_crc32c_tables() -> [8][256]u32
    var t: [8][256]u32

    for n in 0..<256
        var c = u32(n)

        for _ in 0..<8
            c = if c & 1 == 1 then crc32c_poly ^ c >> 1 else c >> 1

        t[0][n] = c

    for n in 0..<256
        for k in 1..<8
            t[k][n] = t[0][u8(t[k - 1][n] & 0xff)] ^ t[k - 1][n] >> 8

    t

val crc32c_tables: [8][256]u32 = make_crc32c_tables()

// Four and eight bytes from `d` at `i`, least significant first. **One bounds test for the word, not
// one per byte**: the bytes are read unchecked under it, which is what lets the optimizer make the
// whole read one load and the function small enough to vanish into its caller -- checked byte by
// byte, each read kept its own trap path and the loop below ran at half speed.
@inline
private le32(d: []const u8, i: usize) -> u32
    if i + 4 > d.len then panic("sysl.checksum: a word read past the end of its slice")

    var v: u32 = 0

    @unchecked
        v = u32(d[i]) | u32(d[i + 1]) << 8 | u32(d[i + 2]) << 16 | u32(d[i + 3]) << 24

    v
end le32

@inline
private le64(d: []const u8, i: usize) -> u64
    if i + 8 > d.len then panic("sysl.checksum: a word read past the end of its slice")

    var v: u64 = 0

    @unchecked
        v = u64(d[i]) | u64(d[i + 1]) << 8 | u64(d[i + 2]) << 16 | u64(d[i + 3]) << 24 |
            u64(d[i + 4]) << 32 | u64(d[i + 5]) << 40 | u64(d[i + 6]) << 48 | u64(d[i + 7]) << 56

    v
end le64

/** The table form of `Crc32c.update`, on every machine: the remainder `state` with `data` folded in,
 * no inversion either side. It is what `crc32c` is where `#if crc32c` is false, and what the tests
 * hold the instructions to where it is true.
 */
private[checksum] crc32c_by_table(state: u32, data: []const u8) -> u32
    var c = state
    var i = 0

    while i + 8 <= data.len
        val lo = c ^ le32(data, i)
        val hi = le32(data, i + 4)

        c = crc32c_tables[7][u8(lo & 0xff)] ^ crc32c_tables[6][u8(lo >> 8 & 0xff)] ^
            crc32c_tables[5][u8(lo >> 16 & 0xff)] ^ crc32c_tables[4][u8(lo >> 24)] ^
            crc32c_tables[3][u8(hi & 0xff)] ^ crc32c_tables[2][u8(hi >> 8 & 0xff)] ^
            crc32c_tables[1][u8(hi >> 16 & 0xff)] ^ crc32c_tables[0][u8(hi >> 24)]
        i += 8

    while i < data.len
        c = crc32c_tables[0][u8(c & 0xff) ^ data[i]] ^ c >> 8
        i += 1

    c
end crc32c_by_table

#if crc32c && aarch64

private extern "llvm.aarch64.crc32cb" crc32cb(crc: u32, b: u32) -> u32
private extern "llvm.aarch64.crc32cx" crc32cx(crc: u32, w: u64) -> u32

/** The instruction form of `Crc32c.update`: eight bytes per `crc32cx`, the tail a byte at a time. */
private[checksum] crc32c_by_instruction(state: u32, data: []const u8) -> u32
    var c = state
    var i = 0

    while i + 8 <= data.len
        c = crc32cx(c, le64(data, i))
        i += 8

    while i < data.len
        c = crc32cb(c, u32(data[i]))
        i += 1

    c
end crc32c_by_instruction

#elif crc32c && x86_64

private extern "llvm.x86.sse42.crc32.32.8" crc32c_u8(crc: u32, b: u8) -> u32
private extern "llvm.x86.sse42.crc32.64.64" crc32c_u64(crc: u64, w: u64) -> u64

/** The instruction form of `Crc32c.update`: eight bytes per `crc32`, the tail a byte at a time. */
private[checksum] crc32c_by_instruction(state: u32, data: []const u8) -> u32
    var c = u64(state)
    var i = 0

    while i + 8 <= data.len
        c = crc32c_u64(c, le64(data, i))
        i += 8

    var d = u32(c)

    while i < data.len
        d = crc32c_u8(d, data[i])
        i += 1

    d
end crc32c_by_instruction

#endif

/** A CRC-32C in progress, for input that arrives in pieces -- a page written in parts, a log record
 * and its header. Like `Crc32` it is an ordinary struct: copying one starts another from the same
 * point, and `finish` answers the checksum so far without ending anything.
 */
struct Crc32c
    private state: u32

    update(*self, data: []const u8)
#if crc32c
        self.state = crc32c_by_instruction(self.state, data)
#else
        self.state = crc32c_by_table(self.state, data)
#endif

    finish(self) -> u32 = ~self.state

/** A CRC-32C ready for its first `update`. */
new_crc32c() -> Crc32c = Crc32c(0xffffffff)

/** The CRC-32C of one slice of bytes: Castagnoli's polynomial `0x1edc6f41` (`0x82f63b78` reflected),
 * initial value and final xor `0xffffffff` -- iSCSI's, ext4's and RocksDB's. `crc32c("123456789".bytes)`
 * is `0xe3069283`, the standard check value, and the empty input is `0`.
 *
 * **It is the machine's instruction where `#if crc32c` holds** -- every Arm Mac, and an AArch64 or
 * x86-64 build whose `codegen.extensions` names `crc` or `sse4.2` -- and a slice-by-8 table
 * everywhere else, a board included. The two give the same answer, so a checksum written on one
 * machine is checked on any other.
 */
crc32c(data: []const u8) -> u32
    var c = new_crc32c()

    c.update(data)
    c.finish()

// -- a seeded hash ----------------------------------------------------------------------------------

// rapidhash V3's default secrets.
private val rapid_secret: [8]u64 = [0x2d358dccaa6c78a5, 0x8bb84b93962eacc9, 0x4b33a62ed433d4a3, 0x4d5a2da51de1aa47,
                            0xa0761d6478bd642f, 0xe7037ed1a0b428db, 0x90ed1765281c388c, 0xaaaaaaaaaaaaaaaa]

// The full 128-bit product, as its low and high halves.
@inline
private rapid_mum(a: u64, b: u64) -> (u64, u64)
    val r = u128(a) * u128(b)
    (u64.wrap(r), u64(r >> 64))

// The two halves of the product folded together.
@inline
private rapid_mix(a: u64, b: u64) -> u64
    val (lo, hi) = rapid_mum(a, b)
    lo ^ hi

/** A 64-bit hash of `data` for a hash table, a Bloom filter or a sketch: **rapidhash** (V3, the
 * default "compact" build), the successor to wyhash. `seed` selects one of 2^64 unrelated hash
 * functions over the same bytes -- a Bloom filter's k probes, or a table that must not be the one an
 * adversary precomputed collisions against.
 *
 * **The output is stable**: it is the reference implementation's `rapidhash_withSeed` exactly, bit
 * for bit, on every target and in every future release -- the input is read as bytes, least
 * significant first, never as the machine's words -- so a hash written into a file today names the
 * same bucket tomorrow and on another machine. Changing it would be a breaking change.
 *
 * **It is not a MAC and not a checksum.** A seed an attacker does not know keeps them from building
 * collisions blind, but it is no secret key in the cryptographic sense; and a CRC catches a burst
 * of flipped bits that a hash only catches with high probability.
 */
hash64(data: []const u8, seed: u64 = 0) -> u64
    val len = data.len
    var s = seed ^ rapid_mix(seed ^ rapid_secret[2], rapid_secret[1])
    var a: u64 = 0
    var b: u64 = 0
    var i = len

    if len <= 16
        if len >= 8
            s ^= u64(len)
            a = le64(data, 0)
            b = le64(data, len - 8)
        elif len >= 4
            s ^= u64(len)
            a = u64(le32(data, 0))
            b = u64(le32(data, len - 4))
        elif len > 0
            a = u64(data[0]) << 45 | u64(data[len - 1])
            b = u64(data[len >> 1])
    else
        var p = 0

        if len > 112
            var see1 = s
            var see2 = s
            var see3 = s
            var see4 = s
            var see5 = s
            var see6 = s

            loop
                s = rapid_mix(le64(data, p) ^ rapid_secret[0], le64(data, p + 8) ^ s)
                see1 = rapid_mix(le64(data, p + 16) ^ rapid_secret[1], le64(data, p + 24) ^ see1)
                see2 = rapid_mix(le64(data, p + 32) ^ rapid_secret[2], le64(data, p + 40) ^ see2)
                see3 = rapid_mix(le64(data, p + 48) ^ rapid_secret[3], le64(data, p + 56) ^ see3)
                see4 = rapid_mix(le64(data, p + 64) ^ rapid_secret[4], le64(data, p + 72) ^ see4)
                see5 = rapid_mix(le64(data, p + 80) ^ rapid_secret[5], le64(data, p + 88) ^ see5)
                see6 = rapid_mix(le64(data, p + 96) ^ rapid_secret[6], le64(data, p + 104) ^ see6)
                p += 112
                i -= 112

                if i <= 112 then break

            s ^= see1 ^ see6 ^ see2 ^ see3 ^ see4 ^ see5
        end if

        if i > 16
            s = rapid_mix(le64(data, p) ^ rapid_secret[2], le64(data, p + 8) ^ s)
        if i > 32
            s = rapid_mix(le64(data, p + 16) ^ rapid_secret[2], le64(data, p + 24) ^ s)
        if i > 48
            s = rapid_mix(le64(data, p + 32) ^ rapid_secret[1], le64(data, p + 40) ^ s)
        if i > 64
            s = rapid_mix(le64(data, p + 48) ^ rapid_secret[1], le64(data, p + 56) ^ s)
        if i > 80
            s = rapid_mix(le64(data, p + 64) ^ rapid_secret[2], le64(data, p + 72) ^ s)
        if i > 96
            s = rapid_mix(le64(data, p + 80) ^ rapid_secret[1], le64(data, p + 88) ^ s)

        a = le64(data, len - 16) ^ u64(i)
        b = le64(data, len - 8)
    end if

    val (lo, hi) = rapid_mum(a ^ rapid_secret[1], b ^ s)

    rapid_mix(lo ^ rapid_secret[7], hi ^ rapid_secret[1] ^ u64(i))
end hash64
