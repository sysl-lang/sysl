module sh.sysl.compiler
@tests

// A thread borrows a frame only inside a scope (`reference/memory.md § A thread borrows a frame only
// inside a scope`). `spawn`'s `arg` is `@crossing`, so a plain `spawn` keeps what it is handed for
// good, and the address of a function's own local is refused there whatever the function does with
// the handle afterwards. `sysl.threads.scope` joins every thread started on it before it returns, and
// its `spawn` is `@scoped(f)`, so a closure started there may hold a pointer to the caller's frame.
//
// Each cell below was once a shape the "joined on every way out" analysis followed; it is now written
// on a scope, which needs no such analysis, or pins the refusal of the plain `spawn` it used to accept.
// Each accepted cell runs and prints what the threads did.
//
// Skipped cells, and why: a scope's own guarantees -- joined on an early return, nested scopes, an
// answer through a handle -- are `tests_sbt_*`'s; a closure's capture rules at `@scoped` are
// `tests_tsp_*`'s and `tests_scn_*`'s.

// The count is an atomic add because some cells run two threads at once into one `S`, and a plain
// `s.n = s.n + 1` would lose an update between them.
private jnd_prelude() -> string =
    "import sysl.threads.*\nimport sysl.sync.*\n\nstruct S\n    n: int\n\n" +
    "work(s: *S)\n    atomic_add(&s.n, 1, SeqCst)\n\n"

private jnd_prints(body: string, want: string)
    if !azd_ready() then return

    twp_prints(jnd_prelude() + body, want)

// What a plain `spawn` of a local's address is told, at `at` (`line:col` of `main.sysl`).
private jnd_refused(body: string, owner: string, at: string)
    if !azd_ready() then return

    val said = azd_err(jnd_prelude() + body)

    assert(said.contains(jnd_spawn_refusal("spawn", "arg", "s", owner)), said)
    assert(said.contains(s"main.sysl:$at"), said)
end jnd_refused

// The refusal of a frame address handed to a parameter a written `@crossing` names.
jnd_spawn_refusal(callee: string, param: string, local: string, owner: string) -> string =
    s"error: '$callee' keeps its parameter '$param' (it reaches another concurrency domain), and '&$local' " +
        s"is the address of a local of '$owner' — a thread that borrows the frame of '$owner' is started on " +
        "'sysl.threads.scope', which joins it before the scope returns; anything else is handed storage " +
        "that lasts"

// The same refusal where the address goes through a wrapper that hands it to `inner`: the wrapper keeps
// it the way the crossing callee does, and the cure still names the scope.
jnd_wrapper_refusal(wrapper: string, param: string, inner: string, local: string, owner: string) -> string =
    s"error: '$wrapper' keeps its parameter '$param' (it is passed to '$inner', where it reaches another " +
        s"concurrency domain), and '&$local' is the address of a local of '$owner' — a thread that borrows " +
        s"the frame of '$owner' is started on 'sysl.threads.scope', which joins it before the scope returns; " +
        "anything else is handed storage that lasts"

// -- on a scope: accepted --------------------------------------------------------------------------

@test("a thread started on a scope may have the address of a local, read once the scope returns")
jnd_joined_after_binding()
    jnd_prints(raw"""
        go()
            var s = S(0)
            val p = &s

            scope((sc) -> sc.spawn(() -> work(p)))
            print(s.n)

        go()
        """, "1\n")

@test("a scope body that returns before it starts a thread starts none")
jnd_none_arm_returns()
    jnd_prints(raw"""
        go(stop: bool)
            var s = S(0)
            val p = &s

            scope((sc) ->
                if stop then return

                sc.spawn(() -> work(p))
                ())
            print(s.n)

        go(true)
        go(false)
        """, "0\n1\n")

@test("a handle joined in the body is not joined a second time by the scope")
jnd_option_matched()
    jnd_prints(raw"""
        go()
            var s = S(0)
            val p = &s

            scope((sc) ->
                val h = sc.spawn(() -> work(p))

                h.join()
                print(h.is_finished()))
            print(s.n)

        go()
        """, "true\n1\n")

@test("a handle never joined in the body is joined by the scope")
jnd_is_test()
    jnd_prints(raw"""
        go()
            var s = S(0)
            val p = &s

            scope((sc) ->
                val h = sc.spawn(() -> work(p))

                h.is_finished())
            print(s.n)

        go()
        """, "1\n")

@test("a join written on the spawn itself ends the thread in the same statement")
jnd_chained()
    jnd_prints(raw"""
        go()
            var s = S(0)
            val p = &s

            scope((sc) ->
                sc.spawn(() -> work(p)).join()
                print(p.n))

        go()
        """, "1\n")

@test("the value a scoped thread answers comes back through its handle and out of the scope")
jnd_call_matched()
    jnd_prints(raw"""
        go() -> int
            var s = S(5)
            val p = &s

            scope((sc) -> sc.spawn(() -> p.n * 2).join())

        print(go())
        """, "10\n")

@test("a scope answers what its body answers, after every thread is joined")
jnd_call_is_test()
    jnd_prints(raw"""
        go() -> int
            var s = S(0)
            val p = &s

            val got = scope((sc) ->
                sc.spawn(() -> work(p))
                sc.spawn(() -> work(p))
                7)

            got + s.n

        print(go())
        """, "9\n")

@test("a '?' inside the scope's body leaves it, and the thread already started is joined")
jnd_question_on_the_call()
    jnd_prints(raw"""
        maybe(n: int) -> Option[int] = if n > 0 then Some(n) else None

        go(n: int) -> Option[int]
            var s = S(0)
            val p = &s

            val got = scope((sc) -> run(sc, p, n))

            print(s.n)
            got

        run(sc: *Scope, p: *S, n: int) -> Option[int]
            sc.spawn(() -> work(p))

            val k = maybe(n)?

            Some(k + 1)

        print(go(1).unwrap())
        print(go(0).is_none())
        """, "1\n2\n1\ntrue\n")

@test("an early return out of the scope's body still joins every thread")
jnd_deferred_join()
    jnd_prints(raw"""
        go(stop: bool)
            var s = S(0)
            val p = &s

            scope((sc) ->
                sc.spawn(() -> work(p))

                if stop then return

                sc.spawn(() -> work(p))
                ())
            print(s.n)

        go(true)
        go(false)
        """, "1\n2\n")

@test("a handle copied into another local is joined through the copy")
jnd_joined_through_a_copy()
    jnd_prints(raw"""
        go()
            var s = S(0)
            val p = &s

            scope((sc) ->
                val t = sc.spawn(() -> work(p))
                val u = t

                u.join()
                t.join())
            print(s.n)

        go()
        """, "1\n")

@test("one scope runs a thread, then a second after the first is joined")
jnd_restarted_after_the_join()
    jnd_prints(raw"""
        go()
            var s = S(0)
            val p = &s

            scope((sc) ->
                var t = sc.spawn(() -> work(p))

                t.join()
                t = sc.spawn(() -> work(p))
                t.join())
            print(s.n)

        go()
        """, "2\n")

@test("a thread started on a scope inside each turn of a loop")
jnd_loop_turns()
    jnd_prints(raw"""
        go()
            var s = S(0)
            val p = &s

            for _ in 0..<3
                scope((sc) -> sc.spawn(() -> work(p)))

            print(s.n)

        go()
        """, "3\n")

@test("a function that opens its own scope keeps nothing, so its caller may hand it a local")
jnd_wrapper_joins_inside()
    jnd_prints(raw"""
        run(p: *S)
            scope((sc) -> sc.spawn(() -> work(p)))

        go()
            var s = S(0)

            run(&s)
            print(s.n)

        go()
        """, "1\n")

@test("a function handed the scope starts a thread on it with its caller's local, one level and two")
jnd_wrapper_answers_the_handle()
    jnd_prints(raw"""
        start(sc: *Scope, p: *S) -> ScopedThread[unit] = sc.spawn(() -> work(p))

        again(sc: *Scope, p: *S) -> ScopedThread[unit]
            return start(sc, p)

        go()
            var s = S(0)
            val p = &s

            scope((sc) ->
                start(sc, p).join()
                again(sc, p))
            print(s.n)

        go()
        """, "2\n")

@test("storage that lasts may still be handed to a plain spawn and never joined")
jnd_lasting_storage()
    jnd_prints(raw"""
        var kept = S(0)

        go()
            val b: &S = S(0)

            spawn(&work, &kept)
            spawn(&work, &*b).unwrap().join()
            print(b.n)

        go()
        """, "1\n")

@test("the program's own statements are the program's frame, which outlives every thread")
jnd_entry_file_exempt()
    jnd_prints("var s = S(0)\nval t = spawn(&work, &s)\n\nt.unwrap().join()\nprint(s.n)\n", "1\n")

@test("a function that never returns starts its frame's threads on a scope too")
jnd_never_returns()
    if !azd_ready() then return

    val body = "run() -> never\n    var s = S(0)\n    val p = &s\n\n    scope((sc) -> sc.spawn(() -> work(p)))\n\n" +
        "    loop\n        ()\n\nrun()\n"

    assert_eq(azd_err(jnd_prelude() + body), "")

    val plain = azd_err(jnd_prelude() + "run() -> never\n    var s = S(0)\n\n    spawn(&work, &s)\n\n    loop\n" +
                        "        ()\n\nrun()\n")

    assert(plain.contains(jnd_spawn_refusal("spawn", "arg", "s", "run")), plain)

@test("'spawn_on' keeps what it is handed like 'spawn', and lasting storage may still be handed to it")
jnd_spawn_on()
    jnd_prints(raw"""
        var kept = S(0)

        go()
            var room: [262144]u8 = [0; 262144]

            spawn_on(room[..], &work, &kept).unwrap().join()
            print(kept.n)

        go()
        """, "1\n")

    if !azd_ready() then return

    val said = azd_err(jnd_prelude() + "go()\n    var room: [262144]u8 = [0; 262144]\n    var s = S(0)\n\n" +
                       "    spawn_on(room[..], &work, &s).unwrap().join()\n\ngo()\n")

    assert(said.contains(jnd_spawn_refusal("spawn_on", "arg", "s", "go")), said)

// -- a plain spawn of a frame address: refused, joined or not ------------------------------------------

@test("a handle joined on every way out no longer lets a plain spawn have a local")
jnd_plain_spawn_joined()
    jnd_refused("go()\n    var s = S(0)\n    val t = spawn(&work, &s).unwrap()\n\n    t.join()\n    print(s.n)\n\ngo()\n",
                "go", "12:26")

@test("a handle never joined holds the local past the call")
jnd_never_joined()
    jnd_refused("go()\n    var s = S(0)\n    val t = spawn(&work, &s)\n\n    print(t.is_some())\n\ngo()\n", "go", "12:26")

@test("an early return before the join")
jnd_early_return()
    jnd_refused("go(stop: bool)\n    var s = S(0)\n    val t = spawn(&work, &s).unwrap()\n\n    if stop then return\n\n" +
                "    t.join()\n\ngo(false)\n", "go", "12:26")

@test("a '?' after the thread started and before the join")
jnd_question_after_start()
    jnd_refused("maybe() -> Option[int] = None\n\ngo() -> Option[int]\n    var s = S(0)\n" +
                "    val t = spawn(&work, &s).unwrap()\n    val n = maybe()?\n\n    t.join()\n    Some(n)\n\n" +
                "print(go().is_none())\n", "go", "14:26")

@test("a 'Some' arm that does not join")
jnd_arm_without_join()
    jnd_refused("go()\n    var s = S(0)\n    val t = spawn(&work, &s)\n\n    t match\n        Some(h) -> print(\"on\")\n" +
                "        None -> ()\n\ngo()\n", "go", "12:26")

@test("a panic before the join is a way out that skips it")
jnd_panic_before_join()
    jnd_refused("go(bad: bool)\n    var s = S(0)\n    val t = spawn(&work, &s).unwrap()\n\n    if bad then panic(\"no\")\n\n" +
                "    t.join()\n\ngo(false)\n", "go", "12:26")

@test("a 'break' past the join")
jnd_break_past_join()
    jnd_refused("go()\n    var s = S(0)\n\n    loop\n        val t = spawn(&work, &s).unwrap()\n\n" +
                "        if s.n > 0 then break\n\n        t.join()\n\ngo()\n", "go", "14:30")

@test("a 'continue' past the join")
jnd_continue_past_join()
    jnd_refused("go()\n    var s = S(0)\n\n    for i in 0..<2\n        val t = spawn(&work, &s).unwrap()\n\n" +
                "        if i == 0 then continue\n\n        t.join()\n\ngo()\n", "go", "14:30")

@test("a thread whose handle is thrown away")
jnd_discarded()
    jnd_refused("go()\n    var s = S(0)\n\n    spawn(&work, &s)\n\ngo()\n", "go", "13:18")

@test("a second thread started into a handle whose first was never joined")
jnd_reassigned()
    jnd_refused("go()\n    var s = S(0)\n    var t = spawn(&work, &s).unwrap()\n\n    for _ in 0..<2\n" +
                "        t = spawn(&work, &s).unwrap()\n\n    t.join()\n\ngo()\n", "go", "12:26")

@test("handles kept in an array of a scope are joined by the scope (tests_fno_*)")
jnd_handles_in_an_array()
    jnd_prints(raw"""
        go()
            var s = S(0)
            val p = &s

            scope((sc) ->
                var ts: [2]Option[ScopedThread[unit]] = [None; 2]

                for i in 0..<2
                    ts[i] = Some(sc.spawn(() -> work(p)))

                ts[0].is_some())
            print(s.n)

        go()
        """, "2\n")

// Enough turns, with a yield between them, that a count which is not indivisible loses an update on
// every run, so the prelude's `work` is pinned as atomic for the cells above.
@test("two threads at once into one S count every turn of both")
fnr_two_at_once_count_every_turn()
    jnd_prints(raw"""
        many(s: *S)
            for _ in 0..<20000
                work(s)
                yield_now()

        go()
            var s = S(0)
            val p = &s

            scope((sc) ->
                for _ in 0..<2
                    sc.spawn(() -> many(p)))
            print(s.n)

        go()
        """, "40000\n")

@test("a handle built into a struct literal")
jnd_handle_in_a_struct_literal()
    jnd_refused("struct W\n    t: Thread\n    k: int\n\ngo()\n    var s = S(0)\n    var w = W(spawn(&work, &s).unwrap(), 0)\n\n" +
                "    w.t.join()\n\ngo()\n", "go", "16:28")

@test("a handle answered to the caller leaves the local behind")
jnd_answered_from_the_frame()
    jnd_refused("go() -> Option[Thread]\n    var s = S(0)\n\n    spawn(&work, &s)\n\ngo().unwrap().join()\n", "go", "13:18")

@test("a function that answers the handle keeps its parameter, joined by its caller or not")
jnd_wrapper_not_joined()
    if !azd_ready() then return

    val said = azd_err(jnd_prelude() + "start(p: *S) -> Option[Thread] = spawn(&work, p)\n\n" +
                       "go()\n    var s = S(0)\n\n    start(&s).unwrap().join()\n\ngo()\n")

    assert(said.contains(jnd_wrapper_refusal("start", "p", "spawn", "s", "go")), said)

@test("a function that starts a thread and does not join it keeps its parameter for good")
jnd_wrapper_never_joins()
    if !azd_ready() then return

    val said = azd_err(jnd_prelude() + "fire(p: *S)\n    val t = spawn(&work, p)\n\n" +
                       "go()\n    var s = S(0)\n\n    fire(&s)\n\ngo()\n")

    assert(said.contains(jnd_wrapper_refusal("fire", "p", "spawn", "s", "go") + "\n"), said)

// -- the annotation is gone ------------------------------------------------------------------------

private val JndGone = "'@joined' is not an annotation — a thread that borrows its caller's frame is started on " +
    "'sysl.threads.scope'"

@test("'@joined' above a function is refused, and names the scope")
jnd_names_checked()
    if !azd_ready() then return

    val said = azd_err("@crossing(p)\n@joined(p)\nf(p: *int) = ()\n\nvar n = 1\n\nf(&n)\n")

    assert(said.contains(JndGone), said)

@test("'@joined' with no names, or above an 'extern', is refused the same way")
jnd_empty_and_extern()
    if !azd_ready() then return

    val empty = azd_err("@crossing(p)\n@joined\nf(p: *int) = ()\n")

    assert(empty.contains(JndGone), empty)

    val on_extern = azd_err("@joined(p)\nextern \"abs\" c_abs(p: *int) -> int\n")

    assert(on_extern.contains(JndGone), on_extern)

@test("'@joined' above a method is refused the same way")
jnd_user_written()
    if !azd_ready() then return

    val said = azd_err("struct H\n    k: int\n\n    @crossing(p)\n    @joined(p)\n    begin(self, p: *int) -> int = *p\n\n" +
                       "print(H(1).k)\n")

    assert(said.contains(JndGone), said)

@test("a written '@crossing' on a pointer keeps it for good, and the refusal names the scope")
jnd_crossing_pointer_keeps()
    if !azd_ready() then return

    val said = azd_err("@crossing(p)\nhand(p: *int) = ()\n\ngo()\n    var n = 1\n\n    hand(&n)\n\ngo()\n")

    assert(said.contains(jnd_spawn_refusal("hand", "p", "n", "go")), said)
