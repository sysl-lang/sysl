module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// A pattern, with where it was written.
struct Pattern
    span: Span
    kind: &PatKind
end Pattern

// What a pattern matches.
enum PatKind
    // `1`, `'x'`, `"s"`, `true`, `-3` -- a literal, held as the expression that spells it.
    LitPattern(value: Expr)

    // `1..9` and `1..<9`.
    RangePattern(lo: Expr, hi: Expr, inclusive: bool)

    // `_`.
    WildcardPattern

    // A bare name: it binds whatever stood there, or names a variant that takes no fields.
    IdentPattern(name: string)

    // `` `n` `` -- a quoted name, which is a *reference* to what that name already holds rather
    // than a binding of it. The quoting is the whole of the difference.
    EqPattern(name: string)

    // `Circle(r)`.
    VariantPattern(name: string, args: Buf[Pattern])

    // `Point { x, y: b }`.
    StructPattern(name: string, fields: Buf[FieldPattern])

    // `(a, b)` -- two or more parts.
    TuplePattern(args: Buf[Pattern])

    // `n @ 1..9` -- a name bound to whatever the inner pattern matched.
    BindPattern(name: string, inner: Pattern)

    // `Ok(x) | Err(x)` where only one pattern may stand -- a `val`, a `var`, a `for` -- as the
    // alternatives every `|` inside it spread into. It stands only at the top of a binding's pattern:
    // the spreading has already lifted every `|` there, and a `match` arm holds its alternatives in
    // the arm instead.
    OrPattern(alts: Buf[Pattern])
end PatKind

// One field of a struct pattern. `Point { x }` is the field `x` against `IdentPattern("x")`, which
// is what makes the short form the long one with the name written once.
struct FieldPattern
    name: string
    pat: Pattern
end FieldPattern

// One arm of a `match`: the patterns it answers for, the guard that further narrows them, and the
// body it runs.
//
// `patterns` holds the `|`-alternatives, which share one answer and so bind one set of names between
// them. A `|` written inside a pattern -- `Some(1 | 2)` -- is already spread into alternatives here.
struct MatchArm
    span: Span
    patterns: Buf[Pattern]
    guard: Option[Expr]
    body: Buf[Stmt]
end MatchArm

pattern_of(span: Span, kind: PatKind) -> Pattern = Pattern(span, kind)

// A function given by clauses: the signature's name and parameters, and the clauses written under
// it, tried in order.
//
// `params` are the names of the parameters the clauses take apart -- every parameter but `self` --
// and `sig` is the signature's name, where a complaint about the clauses as a whole is anchored.
struct ClauseGroup
    name: string
    sig: Span
    params: Buf[string]
    clauses: Buf[Clause]
end ClauseGroup

// One clause: a pattern per parameter, each held as the `|`-alternatives it spreads into, and the
// bodies it offers once those match, tried in order. A clause written `f(p) = body` has one body and
// no guard.
struct Clause
    span: Span
    head: Span
    patterns: Buf[Buf[Pattern]]
    bodies: Buf[ClauseBody]
end Clause

// One body of a clause, under its guard: `None` where it has none or where the guard is `| _`, which
// always holds.
struct ClauseBody
    span: Span
    guard: Option[Expr]
    body: Buf[Stmt]
end ClauseBody
