module sh.sysl.compiler

import sh.sysl.parsing.source_of
import sysl.buf.{Buf, buf}
import sysl.fs.read_text
import sysl.prints
import sysl.text.{join, Search}

// The driver: what the shell asked for, and what it hears back.
//
// **`main` is a few lines that bind the real arguments and the real terminal to `run_cli`**, which
// is where every decision lives, so that each one is reachable from a test that touches neither.

// What the shell hears. Three outcomes and not two: a program the compiler refused is the program's
// news, and a command line the compiler could not read is the caller's own bug.
val Fine: int = 0
val Failed: int = 1
val Misused: int = 2

// What `sysl --version` answers. Written here as well as in `package.hocon`, because a program is
// handed nothing about its own manifest; the test beside this file keeps the two in step.
const Version: string = "0.1.0-alpha.2"

// The answer to a command line: the lines to say, and the status to exit with. What
// `--explain-escapes` reports is said on the same channel, in the order it was found.
run_cli(args: []string, say: string -> unit) -> int = run_cli_noted(args, say, say)

// The same, with the `--explain-escapes` report handed to a channel of its own. `main` hands it the
// program's standard error, as the reference writes it, so what a build, an `emit-llvm` or a run
// writes to standard output is the same with the flag as without it.
run_cli_noted(args: []string, say: string -> unit, note: string -> unit) -> int
    if args.len < 2
        say(usage())
        return Misused

    // **Where things are on this machine is read afresh for every command line.** One process
    // answering two of them -- which is what a test does -- must not have the first's paths in the
    // second, and nothing else in the compiler writes this.
    reset_search_paths()
    set_explain_sink(note)
    reset_feature_request()

    // A flag that named a `.syslib` is refused by every command in one sentence, before any of them
    // reads its own flags -- none of them takes it, whatever it was handed.
    if names_std_lib(args[1..<args.len])
        say(refused(std_lib_refusal()))
        return Misused
    end if

    // A `--link` naming an empty library is refused where it was typed, by every command alike.
    link_flag_refusal(args[1..<args.len]) match
        Some(why) ->
            say(refused(why))
            return Misused
        None -> ()

    // So is an `--lto` mode clang does not have, and both ends of the profile workflow at once -- the
    // command line's mistakes, said as the reference's option parser says them, the usage under them.
    pipeline_flag_refusal(args[1..<args.len]) match
        Some(why) ->
            say(OptionLead + why + "\n" + usage())
            return Misused
        None -> ()

    // `--help` and `--version` are options of every command, as the reference's parser has them,
    // answered wherever they are written up to a `--`, past which a program's own arguments start.
    // `doc` keeps its own `--help`, which prints its own usage.
    val outright = if args[1] == "doc" then args[1] else asked_outright(args)

    if outright == "--version"
        say(s"sysl ${Version}")
        return Fine
    end if

    if outright == "--help"
        say(usage())
        return Fine
    end if

    args[1] match
        "emit-ast" -> emit_ast_command(args, say)
        "emit-typed" -> emit_typed_command(args, say)
        "emit-llvm" -> emit_llvm_command(args, say)
        "build" -> build_command(args, say)
        "build-lib" -> build_lib_command(args, say)
        "build-c" -> build_c_command(args, say)
        "emit-header" -> emit_header_command(args, say)
        "run" -> run_command(args, say)
        "test" -> test_command(args, say)
        "add" -> add_command(args, say)
        "deps" -> deps_command(args, say)
        "tidy" -> tidy_command(args, say)
        "vendor" -> vendor_command(args, say)
        "doc" -> doc_command(args, say)
        "prove" -> prove_command(args, say, note)
        other ->
            say(s"sysl: `${other}` is not a command this compiler can carry out yet")
            say(usage())
            Misused

// `sysl emit-ast [--no-spans] <file>` -- one file's untyped parse tree, written out as deterministic
// text.
//
// **It exists so that two compilers can be diffed rather than compared by hand.** The reference
// compiler answers the same command line with the same tree in the same notation, so agreement
// between them is one `diff` over whatever corpus is to hand, and a disagreement names the node.
// Nothing is analyzed: this stops where the parser does.
private emit_ast_command(args: []string, say: string -> unit) -> int
    var spans = true
    var file = ""
    var mistakes: Buf[string] = buf()
    var i: usize = 2

    while i < args.len
        if args[i] == "--no-spans"
            spans = false
        else
            val taken = took_any_command_flag(args, i, &mistakes)

            if taken == 0 then file = args[i] else i += taken - 1

        i += 1

    if mistakes.len() > 0
        say(misused(mistakes, emit_ast_usage()))
        return Misused
    end if

    if file == ""
        say(emit_ast_usage())
        return Misused

    read_text(file) match
        Err(_) ->
            say(s"sysl: '${file}' cannot be read")
            Failed
        Ok(text) ->
            val parsed = parse(source_of(file, text))

            if !parsed.ok()
                say(parse_report(parsed))
                return Failed

            // Every node's line ends in a newline of its own, and `say` ends the line it is given,
            // so the last one is dropped rather than written twice.
            val text = emit_ast(parsed.program, spans)

            say(if text.ends_with("\n") then text[0..<(text.len - 1)] else text)
            Fine
end emit_ast_command

private emit_ast_usage() -> string = "usage: sysl emit-ast [--no-spans] <file>"

// `sysl emit-typed [--no-spans] [--tables] [--target <name>] [--lib <dir>] <path>` -- one whole program's typed
// tree, or its declaration tables.
//
// **The path is a program and not a file.** A directory is the project root and everything below it
// is compiled; a single file is compiled alone, as the root module. Either way the standard module
// is read from source and analyzed with the program, so a free `print` and an `Option` mean what the
// library says they mean.
private emit_typed_command(args: []string, say: string -> unit) -> int
    var tables = false
    var named: Option[string] = None
    var file = ""
    var mistakes: Buf[string] = buf()
    var i: usize = 2

    while i < args.len
        // The typed tree of a program is the tree of everything it was handed, so a source root and
        // the paths a `c const` is measured under are read here as every compiling command reads
        // them.
        val took = took_search_flag(args, i)

        if took == 0
            mistakes.push(missing_value(args[i]))
            break
        end if

        if took > 0
            if took == 2 then i += 1
        else if args[i] == "--tables"
            tables = true
        else if args[i] == "--no-spans"
            // The typed tree carries no spans yet, so the flag is taken and changes nothing. It is
            // accepted rather than refused because the whole point of this command is that two
            // compilers answer one command line.
            tables = tables
        else if args[i] == "--target"
            if i + 1 >= args.len
                mistakes.push(missing_value(args[i]))
                break
            end if

            i += 1
            named = Some(args[i])
        else
            val taken = took_any_command_flag(args, i, &mistakes)

            if taken == 0 then file = args[i] else i += taken - 1

        i += 1

    if mistakes.len() > 0
        say(misused(mistakes, emit_typed_usage()))
        return Misused
    end if

    if file == ""
        say(emit_typed_usage())
        return Misused
    end if

    emit_typed_text(file, named, tables) match
        Err(why) ->
            say_failure(why, say)
            Failed
        Ok(emitted) ->
            // An analysis error is reported exactly as any other compiling command reports one,
            // with nothing on standard output.
            if !emitted.report.is_empty()
                say(analysis_report(emitted.report))
                return Failed
            end if

            say(if emitted.text.ends_with("\n") then emitted.text[0..<(emitted.text.len - 1)]
                else emitted.text)
            Fine
end emit_typed_command

// `sysl emit-llvm [--gaps] [--target <name>] [-O<level>] <path>` -- one whole program's LLVM text.
//
// **The level changes which standard-module archive is resolved, not the text**: the reference
// prints the same bytes at every level and builds or reuses the archive at the one named, so a
// level clang has no answer for is refused here exactly as a build refuses it.
//
// **The reference compiler answers this command line with the text it hands to the back end**, so
// the two are diffed rather than compared by hand. The path is a program on the same terms
// `emit-typed`'s is.
//
// **`--gaps` prints the bodies this lowering left out instead of the text**, one to a line as the
// symbol and the form it reached. A partial lowering owes a census of what it did not say, and the
// difference between the two texts is only readable next to it: a symbol the reference defines and
// this compiler does not is an absence, and this is what names the reason.
private emit_llvm_command(args: []string, say: string -> unit) -> int
    var named: Option[string] = None
    var level: Option[string] = None
    var gaps = false
    var file = ""
    var mistakes: Buf[string] = buf()
    var i: usize = 2

    while i < args.len
        val took = took_search_flag(args, i)

        if took == 0
            mistakes.push(missing_value(args[i]))
            break
        end if

        if took > 0
            if took == 2 then i += 1
        else if args[i] == "--target"
            if i + 1 >= args.len
                mistakes.push(missing_value(args[i]))
                break
            end if

            i += 1
            named = Some(args[i])
        else if args[i] == "--gaps"
            gaps = true
        else if took_level(args, i).0 != 0
            val given = took_level(args, i)

            if given.0 < 0
                mistakes.push(missing_value(args[i]))
                break
            end if

            level = Some(given.1)

            if given.0 == 2 then i += 1
        else
            val taken = took_any_command_flag(args, i, &mistakes)

            if taken == 0 then file = args[i] else i += taken - 1

        i += 1

    if mistakes.len() > 0
        say(misused(mistakes, emit_llvm_usage()))
        return Misused
    end if

    if file == ""
        say(emit_llvm_usage())
        return Misused
    end if

    val at = build_level(file, level) match
        Err(why) ->
            say_failure(why, say)
            return Failed
        Ok(resolved) -> resolved

    emit_llvm_text(file, named, at) match
        Err(why) ->
            say_failure(why, say)
            Failed
        Ok(emitted) ->
            if !emitted.report.is_empty()
                say(analysis_report(emitted.report))
                return Failed
            end if

            if gaps
                for i in 0..<emitted.gaps.len()
                    say(s"${emitted.gaps.at(i).0}\t${emitted.gaps.at(i).1}")

                return Fine
            end if

            // What clang is handed, function attributes and sanitizer marking included, so a reader
            // checking whether a build is instrumented reads it here rather than inferring it from a
            // binary.
            val t = target_for(file, named) match
                Err(why) ->
                    say_failure(Said(why), say)
                    return Failed
                Ok(resolved) -> resolved

            val text = for_clang(emitted.text, t)

            say(if text.ends_with("\n") then text[0..<(text.len - 1)] else text)
            Fine
end emit_llvm_command

private emit_llvm_usage() -> string =
    "usage: sysl emit-llvm [--gaps] [--target <name>] [-O<level>] " + where_flags() + " <path>"

// `sysl build [--target <name>] [--cc <path>] [-O<level>] [-o <exe>] <path>` -- one program, made
// into something the machine will run.
//
// **The text is exactly what `emit-llvm` prints**, so a build and a diff are the same lowering seen
// twice; what this adds is the toolchain the text is handed to. `--cc` names the clang instead of
// searching for one, and a person who wrote one down is owed an error rather than a different
// compiler.
private build_command(args: []string, say: string -> unit) -> int
    var named: Option[string] = None
    var cc: Option[string] = None
    var out: Option[string] = None
    var level: Option[string] = None
    var picked: Option[string] = None
    var file = ""
    var mistakes: Buf[string] = buf()
    var i: usize = 2

    while i < args.len
        val took = took_search_flag(args, i)

        if took == 0
            mistakes.push(missing_value(args[i]))
            break
        end if

        val featured = took_feature_flag(args, i)

        if featured == 0
            mistakes.push(missing_value(args[i]))
            break
        end if

        if took > 0
            if took == 2 then i += 1
        else if featured > 0
            if featured == 2 then i += 1
        else if args[i] == "--target" || args[i] == "--cc" || args[i] == "-o" || args[i] == "--output"
            if i + 1 >= args.len
                mistakes.push(missing_value(args[i]))
                break
            end if

            val flag = args[i]

            i += 1

            if flag == "--target" then named = Some(args[i])
            else if flag == "--cc" then cc = Some(args[i])
            else out = Some(args[i])
        else if took_level(args, i).0 != 0
            val given = took_level(args, i)

            if given.0 < 0
                mistakes.push(missing_value(args[i]))
                break
            end if

            level = Some(given.1)

            if given.0 == 2 then i += 1
        else if took_package_flag(args, i).0 != 0
            val given = took_package_flag(args, i)

            if given.0 < 0
                mistakes.push(missing_value(args[i]))
                break
            end if

            picked = Some(given.1)
            i += 1
        else
            val taken = took_any_command_flag(args, i, &mistakes)

            if taken == 0 then file = args[i] else i += taken - 1

        i += 1

    if mistakes.len() > 0
        say(misused(mistakes, build_usage()))
        return Misused
    end if

    // `-p` alone builds that member of the workspace the working directory is in.
    if file == "" && picked.is_some() then file = "."

    if file == ""
        say(build_usage())
        return Misused
    end if

    if refused_features(say) then return Failed

    // **At a workspace root, every member is built**, the root first where it is a package; `-p`
    // narrows that to one. Each is an ordinary build of its own directory, the first refusal ending
    // the run as a build's refusal always does.
    val projects = workspace_projects(file, picked) match
        Err(why) ->
            say(refused(why))
            return Failed
        Ok(found) -> found

    projects match
        None -> build_project(file, named, cc, level, out, say)
        Some(members) ->
            if out.is_some() && members.len() > 1
                say(refused(s"'-o' names one file, and this workspace builds ${members.len()} " +
                    "members — pick one with '-p <member>'"))
                return Failed
            end if

            for k in 0..<members.len()
                val code = build_project(members.at(k).dir, named, cc, level, out, say)

                if code != Fine then return code

            Fine
end build_command

// One project's build, once the command line has been read.
private build_project(file: string, named: Option[string], cc: Option[string], level: Option[string],
                      out: Option[string], say: string -> unit) -> int
    val at = build_level(file, level) match
        Err(why) ->
            say_failure(why, say)
            return Failed
        Ok(resolved) -> resolved

    build_native_program(file, named, cc, at, out) match
        Err(why) ->
            say_failure(why, say)
            Failed
        Ok(exe) ->
            say(s"wrote $exe")
            Fine
end build_project

// How a refusal about the COMMAND begins -- a flag, a path, a manifest, a library the compilation was
// pointed at. The reference introduces one with its own name, as a Unix tool does; a source
// diagnostic is anchored at a file and line instead and carries no name in front. `main` sends a
// line that begins this way to standard error, which is where the reference writes it.
const RefusalLead: string = "sysl: error: "

// A refusal about the command, introduced as the reference introduces one.
refused(why: string) -> string = RefusalLead + why

// How a mistake in the command line ITSELF is introduced -- an option no command takes, a flag with
// nothing after it -- in the reference's option parser's words, which are not a Unix tool's: one
// line per mistake, then how the command is written, and the status `Misused`. `main` sends the
// whole of it to standard error, as the reference does.
const OptionLead: string = "Error: "

unknown_option(arg: string) -> string = OptionLead + s"Unknown option $arg"

missing_value(flag: string) -> string = OptionLead + s"Missing value after $flag"

// The mistakes a command line held, one to a line, with the usage under them -- said as one piece,
// so that all of it goes to the stream its first line chooses.
misused(mistakes: Buf[string], usage: string) -> string
    var text = ""

    for i in 0..<mistakes.len()
        text = text + mistakes.at(i) + "\n"

    text + usage
end misused

// An argument none of a command's own flags took, read as the reference's parser reads it: how many
// arguments it took, with `0` for a positional one, which is the caller's to keep.
//
// **A flag the reference takes on EVERY command is taken here whether or not the command does
// anything with it** -- the search flags, `--target`, `--cc` and a level, which the reference
// accepts after `emit-ast` as readily as after `build`. Anything else spelled as an option is a
// mistake, pushed onto `mistakes`, and so is one of those flags with nothing after it. A lone `-`
// is not an option: it is a path.
//
// It is asked only AFTER a command's own readers have passed an argument by, so a flag a command
// learns to read is read by that command and never arrives here.
took_any_command_flag(args: []string, i: usize, mistakes: *Buf[string]) -> usize
    val arg = args[i]
    val searched = took_search_flag(args, i)

    if searched > 0 then return usize(searched)

    val level = took_level(args, i)

    if level.0 > 0 then return usize(level.0)

    val valued = arg == "--target" || arg == "--cc"

    if valued && i + 1 < args.len then return 2

    if searched == 0 || level.0 < 0 || valued
        mistakes.push(missing_value(arg))
        return 1
    end if

    if arg.len > 1 && arg.starts_with("-")
        mistakes.push(unknown_option(arg))
        return 1
    end if

    0
end took_any_command_flag

// Which of `--help` and `--version` a command line asks for outright, wherever it is written up to a
// `--`, and the empty string where it asks for neither.
private asked_outright(args: []string) -> string
    for i in 1..<args.len
        if args[i] == "--" then return ""

        if args[i] == "--help" || args[i] == "--version" then return args[i]

    ""
end asked_outright

// The one place a command's failure becomes output, and the two kinds are printed differently
// **because only one of them is a sentence**: a refusal about the project has no `error: ` on it and
// takes the command's lead here, where an analysis report is already rendered and every diagnostic
// in it carries its own. Prefixing both is what printed `error: error:`.
private say_failure(why: Failure, say: string -> unit)
    why match
        Said(refusal) -> say(refused(refusal.message))
        Reported(report) -> say(report)

// An optimization level at `args[i]`, spelled the way clang spells it -- `-O2` joined, `-O 2` apart
// -- or as `--optimize 2`: how many arguments it took and the level they named. `0` is "not a level
// flag", and `-1` a separate spelling with nothing after it. **Only a capital `O`**, since `-o` is
// the output path and neither may quietly answer for the other.
took_level(args: []string, i: usize) -> (int, string)
    if args[i] == "-O" || args[i] == "--optimize"
        return if i + 1 < args.len then (2, args[i + 1]) else (-1, "")
    end if

    if args[i].len > 2 && args[i].starts_with("-O") then return (1, args[i][2..<args[i].len])

    (0, "")
end took_level

private build_usage() -> string =
    "usage: sysl build [--target <name>] [--cc <path>] [-O<level>] [-o <exe>] [-p <member>] " +
    where_flags() + " " + feature_flags() + " " + pipeline_usage() + " <path>"

// What a build may ask of LLVM beyond the level (`pipeline.sysl`), which `build`, `run` and `test` say.
private pipeline_usage() -> string =
    "[--lto thin|full] [--profile-generate <dir>] [--profile-use <file>]"

// The one refusal a feature request is given before any manifest is read: `--all-features` beside
// either of the flags that say something narrower. Whether it fired.
refused_features(say: string -> unit) -> bool = feature_conflict() match
    Some(why) ->
        say(refused(why))
        true
    None -> false

// `sysl build-c [--target <name>] [--cc <path>] [-O<level>] [-o <archive>] [--header <path>] <path>`
// -- a module compiled to a static archive and a C header, for a C project to link against.
//
// **It is what CMake and Gradle call**, which is why the two paths it writes are both reported: a
// build script names one of them and has to be able to find the other.
private build_c_command(args: []string, say: string -> unit) -> int
    var named: Option[string] = None
    var cc: Option[string] = None
    var out: Option[string] = None
    var header: Option[string] = None
    var level: Option[string] = None
    var file = ""
    var mistakes: Buf[string] = buf()
    var i: usize = 2

    while i < args.len
        val took = took_search_flag(args, i)

        val featured = took_feature_flag(args, i)

        if took == 0 || featured == 0
            mistakes.push(missing_value(args[i]))
            break
        end if

        // `--lto` is among the flags every command takes (`pipeline.sysl`), a mode clang does not have
        // having been refused before this command ran.
        if took > 0
            if took == 2 then i += 1
        else if featured > 0
            if featured == 2 then i += 1
        else if args[i] == "--target" || args[i] == "--cc" || args[i] == "-o" || args[i] == "--output" ||
                args[i] == "--header"
            if i + 1 >= args.len
                mistakes.push(missing_value(args[i]))
                break
            end if

            val flag = args[i]

            i += 1

            if flag == "--target" then named = Some(args[i])
            else if flag == "--cc" then cc = Some(args[i])
            else if flag == "--header" then header = Some(args[i])
            else out = Some(args[i])
        else if took_level(args, i).0 != 0
            val given = took_level(args, i)

            if given.0 < 0
                mistakes.push(missing_value(args[i]))
                break
            end if

            level = Some(given.1)

            if given.0 == 2 then i += 1
        else
            val taken = took_any_command_flag(args, i, &mistakes)

            if taken == 0 then file = args[i] else i += taken - 1

        i += 1

    if mistakes.len() > 0
        say(misused(mistakes, build_c_usage()))
        return Misused
    end if

    if file == ""
        say(build_c_usage())
        return Misused
    end if

    if refused_features(say) then return Failed

    // **The manifest's `lto` is not this command's**: the key is how the project's own link is done,
    // and an archive's members are native objects unless `--lto` asks.
    val at = build_level(file, level, false) match
        Err(why) ->
            say_failure(why, say)
            return Failed
        Ok(resolved) -> resolved

    // The two paths written are said by the build, ahead of the advice about what to link them with.
    build_c_archive(file, named, cc, at, out, header, say, lto_flag()) match
        Err(why) ->
            say_failure(why, say)
            Failed
        Ok(_) -> Fine
end build_c_command

private build_c_usage() -> string =
    "usage: sysl build-c [--target <name>] [--cc <path>] [-O<level>] [-o <archive>] " +
    "[--header <path>] [--lto thin|full] " + where_flags() + " " + feature_flags() + " <path>\n" +
    "  --lto <mode>  make the archive's members LLVM bitcode for this mode of link-time " +
    "optimization, 'thin' or 'full', so a host linking with clang and lld can optimize across the " +
    "boundary. Without it the members are native objects any C toolchain links, and the project's " +
    "'lto' key does not change that"

// `sysl emit-header <path>` -- the header `build-c` would write, printed, with nothing built.
private emit_header_command(args: []string, say: string -> unit) -> int
    var named: Option[string] = None
    var file = ""
    var mistakes: Buf[string] = buf()
    var i: usize = 2

    while i < args.len
        val took = took_search_flag(args, i)

        if took == 0
            mistakes.push(missing_value(args[i]))
            break
        end if

        if took > 0
            if took == 2 then i += 1
        else if args[i] == "--target"
            if i + 1 >= args.len
                mistakes.push(missing_value(args[i]))
                break
            end if

            i += 1
            named = Some(args[i])
        else
            // An option this command does not take -- the feature flags among them, since it prints
            // a header and resolves no request -- is a mistake told there.
            val taken = took_any_command_flag(args, i, &mistakes)

            if taken == 0 then file = args[i] else i += taken - 1

        i += 1

    if mistakes.len() > 0
        say(misused(mistakes, emit_header_usage()))
        return Misused
    end if

    if file == ""
        say(emit_header_usage())
        return Misused
    end if

    c_header_of(file, named) match
        Err(why) ->
            say_failure(why, say)
            Failed
        Ok(text) ->
            say(text.trim_end())
            Fine
end emit_header_command

private emit_header_usage() -> string =
    "usage: sysl emit-header [--target <name>] " + where_flags() + " <path>"

// `sysl run [--target <name>] [--cc <path>] [-O<level>] <path> [-- <args>]` -- one program, built and
// then run, with whatever it exits with passed straight back to the shell.
//
// **Everything after `--` is the program's**, which is what keeps a program free to take an option
// this compiler also takes. The program is handed its own path as its first argument, as a program
// started any other way is.
private run_command(args: []string, say: string -> unit) -> int
    var named: Option[string] = None
    var cc: Option[string] = None
    var level: Option[string] = None
    var picked: Option[string] = None
    var file = ""
    var forwarding = false
    var program_args: Buf[string] = buf()
    var mistakes: Buf[string] = buf()
    var i: usize = 2

    while i < args.len
        if forwarding
            program_args.push(args[i])
        else if args[i] == "--"
            forwarding = true
        else
            val took = took_search_flag(args, i)

            val featured = took_feature_flag(args, i)

            if took == 0 || featured == 0
                mistakes.push(missing_value(args[i]))
                break
            end if

            if took > 0
                if took == 2 then i += 1
            else if featured > 0
                if featured == 2 then i += 1
            else if args[i] == "--target" || args[i] == "--cc"
                if i + 1 >= args.len
                    mistakes.push(missing_value(args[i]))
                    break
                end if

                val flag = args[i]

                i += 1

                if flag == "--target" then named = Some(args[i]) else cc = Some(args[i])
            else if took_level(args, i).0 != 0
                val given = took_level(args, i)

                if given.0 < 0
                    mistakes.push(missing_value(args[i]))
                    break
                end if

                level = Some(given.1)

                if given.0 == 2 then i += 1
            else if took_package_flag(args, i).0 != 0
                val given = took_package_flag(args, i)

                if given.0 < 0
                    mistakes.push(missing_value(args[i]))
                    break
                end if

                picked = Some(given.1)
                i += 1
            else
                // Only ahead of the `--`: what comes after it is the program's, options and all.
                val taken = took_any_command_flag(args, i, &mistakes)

                if taken == 0 then file = args[i] else i += taken - 1

        i += 1

    if mistakes.len() > 0
        say(misused(mistakes, run_usage()))
        return Misused
    end if

    // `-p` alone runs that member of the workspace the working directory is in.
    if file == "" && picked.is_some() then file = "."

    if file == ""
        say(run_usage())
        return Misused
    end if

    // **One program runs**, so a workspace narrows to the member `-p` picked; without one, the path
    // is the project, the root package where the root is one.
    if picked.is_some()
        file = workspace_projects(file, picked) match
            Err(why) ->
                say(refused(why))
                return Failed
            Ok(found) -> found.unwrap().at(0).dir

    if refused_features(say) then return Failed

    val at = build_level(file, level) match
        Err(why) ->
            say_failure(why, say)
            return Failed
        Ok(resolved) -> resolved

    run_native_program(file, named, cc, at, program_args) match
        Err(why) ->
            say_failure(why, say)
            Failed
        Ok(code) -> code
end run_command

private run_usage() -> string =
    "usage: sysl run [--target <name>] [--cc <path>] [-O<level>] [-p <member>] " + where_flags() +
    " " + feature_flags() + " " + pipeline_usage() + " <path> [-- <args>]"

// The flags every command that compiles a program takes, written once so that seven usage lines
// cannot come to disagree about them. `--lib` names a source **directory** and may be given more
// than once.
where_flags() -> string =
    "[--lib <dir>] [--include-path <dir>|<name>=<dir>] [--link-path <dir>] [-D <macro>] [--explain-escapes]"

private emit_typed_usage() -> string =
    "usage: sysl emit-typed [--no-spans] [--tables] [--target <name>] " + where_flags() + " <path>"

// `sysl test [--filter <text>] [--fail-fast] [--target <name>] [--cc <path>] [-O<level>] <path>` --
// the `@test` functions of a tree, built into one binary and run one process each.
//
// **The report is written as the run goes rather than at the end**, which is why it does not go
// through `say`: a suite that takes half an hour is watched from a log file while it runs, and a run
// that is killed partway still has a report of everything up to the kill. Every decision the command
// makes is still somewhere a test can reach -- `run_selected` takes the sink it writes through, and
// the four pieces it writes are each a function of their own.
private test_command(args: []string, say: string -> unit) -> int
    var named: Option[string] = None
    var cc: Option[string] = None
    var filter: Option[string] = None
    var fail_fast = false
    var std = false
    var named_level: Option[string] = None
    var picked: Option[string] = None
    var file = ""
    var mistakes: Buf[string] = buf()
    var i: usize = 2

    while i < args.len
        val took = took_search_flag(args, i)
        val featured = took_feature_flag(args, i)

        if took == 0 || featured == 0
            mistakes.push(missing_value(args[i]))
            break
        end if

        if took > 0
            if took == 2 then i += 1
        else if featured > 0
            if featured == 2 then i += 1
        else if args[i] == "--target" || args[i] == "--cc" || args[i] == "--filter"
            if i + 1 >= args.len
                mistakes.push(missing_value(args[i]))
                break
            end if

            val flag = args[i]

            i += 1

            if flag == "--target" then named = Some(args[i])
            else if flag == "--cc" then cc = Some(args[i])
            else filter = Some(args[i])
        else if args[i] == "--fail-fast"
            fail_fast = true
        else if args[i] == "--std"
            std = true
        else if took_level(args, i).0 != 0
            val given = took_level(args, i)

            if given.0 < 0
                mistakes.push(missing_value(args[i]))
                break
            end if

            named_level = Some(given.1)

            if given.0 == 2 then i += 1
        else if took_package_flag(args, i).0 != 0
            val given = took_package_flag(args, i)

            if given.0 < 0
                mistakes.push(missing_value(args[i]))
                break
            end if

            picked = Some(given.1)
            i += 1
        else
            val taken = took_any_command_flag(args, i, &mistakes)

            if taken == 0 then file = args[i] else i += taken - 1

        i += 1

    if mistakes.len() > 0
        say(misused(mistakes, test_usage()))
        return Misused
    end if

    // `-p` alone tests that member of the workspace the working directory is in.
    if file == "" && picked.is_some() then file = "."

    if file == ""
        say(test_usage())
        return Misused
    end if

    if refused_features(say) then return Failed

    // A silent request under test turns on every feature the root declares: gated code the ordinary
    // build never compiles is code the suite would otherwise never see.
    set_feature_testing()

    val projects = workspace_projects(file, picked) match
        Err(why) ->
            say(refused(why))
            return Failed
        Ok(found) -> found

    projects match
        None -> test_project(file, named, cc, filter, fail_fast, std, named_level, say)
        Some(members) -> test_members(members, named, cc, filter, fail_fast, std, named_level, say)
end test_command

// **Every member's suite, each reported under its own name**, and a line at the end saying how the
// workspace came out. A failing member does not stop the others unless `--fail-fast` asked for that:
// the point of testing a workspace at once is to hear about all of it.
private test_members(members: Buf[WorkspaceMember], named: Option[string], cc: Option[string],
                     filter: Option[string], fail_fast: bool, std: bool, named_level: Option[string],
                     say: string -> unit) -> int
    var failed: Buf[string] = buf()
    var tested: usize = 0

    for k in 0..<members.len()
        val mb = members.at(k)

        say(s"testing ${mb.name} (${mb.dir})")
        tested += 1

        if test_project(mb.dir, named, cc, filter, fail_fast, std, named_level, say) != Fine
            failed.push(mb.name)

            if fail_fast then break
        end if

    if members.len() > 1
        if failed.is_empty() then say(s"workspace: $tested members tested, every one passed")
        else say(s"workspace: $tested members tested, ${failed.len()} failed: " +
                 join(failed.view(), ", "))
    end if

    if failed.is_empty() then Fine else Failed
end test_members

// One project's suite, once the command line has been read.
private test_project(file: string, named: Option[string], cc: Option[string], filter: Option[string],
                     fail_fast: bool, std: bool, named_level: Option[string], say: string -> unit) -> int
    val level = build_level(file, named_level) match
        Err(why) ->
            say_failure(why, say)
            return Failed
        Ok(resolved) -> resolved

    // **What was built last time, where nothing that can reach the bytes has changed**
    // (`run_cache.sysl`). It is asked before anything is analyzed, because the compile is the whole
    // of what a second `sysl test` over an unchanged tree costs.
    // A `--std` build keeps its own entries: the tree is compiled as the library rather than against
    // one, so the same sources at the same machine come to different bytes.
    val key = run_cache_key_for(if std then "test --std" else "test", file, named, level, cc)

    cached_test_build(key) match
        Some(hit) -> return tests_run(file, hit.0, hit.1, filter, fail_fast, false, say)
        None -> ()

    val made_build = if std then std_test_build_of(file, named)
    else test_build_of(file, named, level)

    val build = made_build match
        Err(why) ->
            say_failure(why, say)
            return Failed
        Ok(made) -> made

    if !build.emitted.report.is_empty()
        say(analysis_report(build.emitted.report))
        return Failed
    end if

    // Asked before anything is linked, so a tree with nothing to run pays for no toolchain.
    nothing_to_run(file, build.tests, filter, say) match
        Some(code) -> return code
        None -> ()

    val made = build_test_binary_cached(file, build, cc, level, key) match
        Err(refusal) ->
            say(refused(refusal.message))
            return Failed
        Ok(built) -> built

    // The list is written **after** the binary and read back before either is used, so a run that
    // died between the two leaves a slot the next one rebuilds rather than one it half believes.
    if made.1 then write_test_list(key.unwrap(), build.tests)

    tests_run(file, made.0, build.tests, filter, fail_fast, !made.1, say)
end test_project

// Nothing to run is not nothing to say. A tree with no tests at all and a filter that matched none of
// the tests there are lead to the same empty report and are different mistakes, so each is named.
// Neither is a failure: a program is allowed to have no tests.
private nothing_to_run(file: string, all: Buf[TTest], filter: Option[string],
                       say: string -> unit) -> Option[int]
    if all.is_empty()
        say(s"no '@test' functions in $file")
        return Some(Fine)
    end if

    if selected_tests(all, filter).is_empty()
        say(s"no test matches '${filter.unwrap_or("")}' — ${all.len()} to choose from")
        return Some(Fine)
    end if

    None
end nothing_to_run

// The chosen tests, run and reported. `discard` is false for a binary in the cache, which is the
// whole point of it being there.
private tests_run(file: string, exe: string, all: Buf[TTest], filter: Option[string],
                  fail_fast: bool, discard: bool, say: string -> unit) -> int
    nothing_to_run(file, all, filter, say) match
        Some(code) -> return code
        None -> ()

    val chosen = selected_tests(all, filter)
    val outcomes = run_selected(exe, chosen, TestOptions(filter, fail_fast),
                                all.len() - chosen.len(), piece -> stream_out(piece))

    if discard then discard_test_binary(exe)

    var failed: usize = 0

    for j in 0..<outcomes.len()
        if !outcomes.at(j).passed() then failed += 1

    if failed == 0 then Fine else Failed
end tests_run

private test_usage() -> string = "usage: sysl test [--filter <text>] [--fail-fast] [--std] " +
    "[-p <member>] [--target <name>] [--cc <path>] [-O<level>] " + where_flags() + " " + feature_flags() + " " +
    pipeline_usage() + " <path>"

// `sysl build-lib [--std] [--target <name>] <path>` -- a library held to being a library for one
// machine.
//
// **`--std` says the tree is sysl's own standard module**, which is the one thing an ordinary
// compilation may not declare and is therefore written down rather than inferred: nothing is
// prepended, no artifact is linked, and the artifact lands in the cache where a compilation looks.
//
// **Without it the tree is an ordinary library**, compiled against the standard module, and nothing
// is written: `checked <root>` is the whole answer. What the command is run for is the analysis --
// it type-checks a package for a machine this one is not, which is the only check a board package
// gets.
private build_lib_command(args: []string, say: string -> unit) -> int
    var named: Option[string] = None
    var level: Option[string] = None
    var std = false
    var file = ""
    var mistakes: Buf[string] = buf()
    var i: usize = 2

    while i < args.len
        val took = took_search_flag(args, i)

        if took == 0
            mistakes.push(missing_value(args[i]))
            break
        end if

        if took > 0
            if took == 2 then i += 1
        else if args[i] == "-o" || args[i] == "--output"
            say(refused(build_lib_output_refusal()))
            return Misused
        else if args[i] == "--target"
            if i + 1 >= args.len
                mistakes.push(missing_value(args[i]))
                break
            end if

            i += 1
            named = Some(args[i])
        else if args[i] == "--std"
            std = true
        else if took_level(args, i).0 != 0
            val given = took_level(args, i)

            if given.0 < 0
                mistakes.push(missing_value(args[i]))
                break
            end if

            level = Some(given.1)

            if given.0 == 2 then i += 1
        else
            // An option this command does not take -- the feature flags among them, `build-lib`
            // resolving no graph -- is the command line's mistake, as the reference's parser says.
            val taken = took_any_command_flag(args, i, &mistakes)

            if taken == 0 then file = args[i] else i += taken - 1

        i += 1

    if mistakes.len() > 0
        say(misused(mistakes, build_lib_usage()))
        return Misused
    end if

    if file == ""
        say(build_lib_usage())
        return Misused
    end if

    val at = build_level(file, level) match
        Err(why) ->
            say_failure(why, say)
            return Failed
        Ok(resolved) -> resolved

    if !std
        return build_library_of(file, named, at) match
            Err(why) ->
                say_failure(why, say)
                Failed
            Ok(root) ->
                say(s"checked $root")
                Fine
    end if

    build_std_artifact_of(file, named, None, at) match
        Err(refusal) ->
            say(refused(refusal.message))
            Failed
        Ok(where) ->
            say(s"wrote $where")
            Fine
end build_lib_command

private build_lib_usage() -> string =
    "usage: sysl build-lib [--std] [--target <name>] [-O<level>] " + where_flags() + " <path>"

// What is said of `-o` given to `build-lib`, which is refused before anything is read.
//
// **The command writes nothing anybody names**: it checks a library, and what it compiled on the way
// is this compiler's cache -- a `--std` build fills the standard module's entry there, found by every
// compilation after it without being named. A path to write to is a promise of a file somebody will
// hand to something, and nothing takes one any more.
build_lib_output_refusal() -> string =
    "build-lib writes nothing anybody names — it checks a library, and what it compiles is this " +
    "compiler's cache, found by the compiler alone — so it takes no -o"

// One piece of a report, written and **flushed**, so that a run followed through a log file shows each
// verdict as it lands rather than only once the process exits. The pieces carry their own newlines,
// which is what makes the concatenation of them the whole report.
private stream_out(piece: string)
    prints(piece)
    c_flush_all(null)

// Standard output is buffered when it is not a terminal, which is exactly the case a streaming report
// is for. There is no flush in the library's printing surface, so the C one is named here.
private extern "fflush" c_flush_all(stream: *u8) -> int

// `sysl add <coordinate>[@<version>] [<path>]` -- one dependency written into a project's manifest.
//
// The version is what the repository's newest release tag says where the command line pins none, and
// the manifest is rewritten by changing the smallest run of bytes that has to change. Nothing is
// fetched: the next build is what goes and gets it.
private add_command(args: []string, say: string -> unit) -> int
    var spec = ""
    var root = "."
    var extra: usize = 0
    var mistakes: Buf[string] = buf()
    var i: usize = 2

    while i < args.len
        val taken = took_any_command_flag(args, i, &mistakes)

        if taken > 0 then i += taken - 1
        else if spec.is_empty() then spec = args[i]
        else if extra == 0
            root = args[i]
            extra += 1
        else
            say(add_usage())
            return Misused

        i += 1

    if mistakes.len() > 0
        say(misused(mistakes, add_usage()))
        return Misused
    end if

    if spec.is_empty()
        say(add_usage())
        return Misused

    // A workspace root with no `package` block refuses a `dependencies` block, so writing one there
    // would leave a manifest the next build refuses.
    manifest_at(root) match
        Ok(m) ->
            if m.workspace.is_some() && !m.has_package
                say(refused(s"'${absolute_path(root)}' is a workspace with no 'package' block, so " +
                    "it takes no dependencies — add it to the member that imports it, " +
                    "'sysl add <coordinate> <member directory>'"))
                return Failed
        Err(_) -> ()

    add_to_project(root, spec) match
        Err(why) ->
            say(refused(why))
            Failed
        Ok(said) ->
            say(said)
            Fine
end add_command

private add_usage() -> string = "usage: sysl add <coordinate>[@<version>] [<path>]"

// `sysl deps <path>` -- the graph the project resolves to, and who asked for each version.
//
// **It is a question about a particular project, so the path is required**, and it stops above the
// target: nothing in it asks anything of a machine, so a project pinned to one this machine cannot
// build for is still inspectable.
private deps_command(args: []string, say: string -> unit) -> int
    var root = ""
    var paths: usize = 0
    var mistakes: Buf[string] = buf()
    var i: usize = 2

    // The graph listed is the one a build resolves, so the feature flags choose it here as there.
    while i < args.len
        val featured = took_feature_flag(args, i)

        if featured == 0
            mistakes.push(missing_value(args[i]))
            break
        end if

        if featured > 0
            if featured == 2 then i += 1
        else
            val taken = took_any_command_flag(args, i, &mistakes)

            if taken > 0
                i += taken - 1
            else
                root = args[i]
                paths += 1

        i += 1

    if mistakes.len() > 0
        say(misused(mistakes, deps_usage()))
        return Misused
    end if

    if paths != 1
        say(deps_usage())
        return Misused
    end if

    if refused_features(say) then return Failed

    // **At a workspace root, every member's graph in turn**, each resolved as its build would be --
    // with the workspace's versions -- and separated by a blank line.
    workspace_projects(root, None) match
        Err(why) ->
            say(refused(why))
            return Failed
        Ok(None) -> deps_of(root, say)
        Ok(Some(members)) ->
            for k in 0..<members.len()
                if k > 0 then say("")

                val code = deps_of(members.at(k).dir, say)

                if code != Fine then return code

            Fine
end deps_command

// One project's listing.
private deps_of(root: string, say: string -> unit) -> int
    val m = manifest_of_package(root) match
        Err(why) ->
            say(refused(why))
            return Failed
        Ok(got) -> got

    resolved_graph(root, m) match
        Err(refusal) ->
            say(refused(refusal.message))
            Failed
        Ok(g) ->
            val text = deps_listing(m, g)

            say(text[0..<text.len - 1])
            Fine
end deps_of

private deps_usage() -> string = "usage: sysl deps " + feature_flags() + " <path>"

usage() -> string = "usage: sysl --version | --help | emit-ast [--no-spans] <file> | " +
    "emit-typed [--no-spans] [--tables] [--target <name>] <path> | " +
    "emit-llvm [--target <name>] [-O<level>] <path> | " +
    "build [--target <name>] [--cc <path>] [-O<level>] [-o <exe>] <path> | " +
    "build-c [--target <name>] [--cc <path>] [-O<level>] [-o <archive>] [--header <path>] " +
    "[--lto thin|full] <path> | emit-header [--target <name>] <path> | " +
    "run [--target <name>] [--cc <path>] [-O<level>] <path> [-- <args>] | " +
    "test [--filter <text>] [--fail-fast] [--target <name>] [--cc <path>] [-O<level>] <path> | " +
    "add <coordinate>[@<version>] [<path>] | deps <path> | vendor <path> | tidy [--check] [<path>] | " +
    "prove [--emit-whyml] [--overflow check|ignore] [--target <name>] <path> | " +
    "doc [-o <dir>] [-t <title>] [-n <note>] [-w <n>] [-V <version>] [--private] [--check] [<dir>]\n" +
    "build, build-c, run and test, which resolve a package graph, also take " + feature_flags() +
    ": a feature of the root project to turn on beside 'default', comma-separated and repeatable; " +
    "leave the root's 'default' feature off; turn on every feature the root's manifest declares"

// Where `main` writes one line: a refusal about the command, and a mistake in the command line with
// the usage under it, go to standard error, as the reference writes them, and everything else to
// standard output.
private said_to_terminal(line: string)
    if line.starts_with(RefusalLead) || line.starts_with(OptionLead) then eprints(line + "\n")
    else print(line)

main(args: []string)
    val code = run_cli_noted(args, said_to_terminal, line -> eprints(line + "\n"))

    if code != Fine then exit(code)
