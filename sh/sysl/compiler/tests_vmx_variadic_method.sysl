module sh.sysl.compiler
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.Search
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture

// A **member** that takes a `...` (`reference/ffi.md § Variadic functions`). A member is a function
// with a receiver in front, and that is the whole of the rule: the ellipsis reaches a method, an
// associated function, a member of a generic type, a nested function and a trait's declaration under
// exactly the rules a free function's tail follows. What the receiver buys is that it counts as the
// named parameter a `...` has to anchor on, so `only(self, ...)` is complete where a receiverless
// `make(...)` is not. The one thing a variadic member cannot do is be reached through a trait object:
// a call to a variadic names the callee's whole function type, and a slot in a method table is a word.
//
// **Every string quoted here was read out of the reference compiler (0.0.159)**, whose
// `VariadicMethodTests` these are; the IR lines are its `emit-llvm`.

private var vmx_library_cache: Buf[Program] = buf()
private var vmx_library_read: bool = false

private vmx_library() -> Buf[Program]
    if vmx_library_read then return vmx_library_cache

    vmx_library_read = true

    std_root() match
        Err(_) -> ()
        Ok(root) -> std_units(root, host_target()) match
            Err(_) -> ()
            Ok(units) -> vmx_library_cache = units

    vmx_library_cache
end vmx_library

private vmx_ready() -> bool
    if vmx_library().is_empty()
        print("skipped: the standard module's source is not on this machine")
        return false
    end if

    if !clang_available()
        print("skipped: there is no clang on this machine")
        return false
    end if

    true
end vmx_ready

private vmx_says(text: string, part: string) -> bool = text.index_of(part).is_some()

// What a program prints.
private vmx_ran(text: string) -> string
    val root = make_temp_dir("sysl-vmx").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", text).unwrap()

    val exe = s"$root/built"

    build_native_program(s"$root/main.sysl", None, None, DefaultOptimization, Some(exe)) match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return failure_text(why)
        Ok(_) -> ()

    val said = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    said match
        Err(_) -> "the program that was built could not be run"
        Ok(out) -> out.text + out.err.unwrap_or("")
end vmx_ran

// Everything a source has to say for itself, taken through the lowering.
private vmx_err(text: string) -> string
    val root = make_temp_dir("sysl-vmx").unwrap()
    val src = s"$root/main.sysl"

    make_dir_all(root).unwrap()
    write_text(src, text).unwrap()

    val out = emit_llvm_text(src, None) match
        Err(why) -> why.message
        Ok(made) -> if made.report.is_empty() then "" else analysis_report(made.report)

    remove_dir_all(root).unwrap_or(())
    out
end vmx_err

// The LLVM text of a program that must compile.
private vmx_ir(text: string) -> string
    val root = make_temp_dir("sysl-vmx").unwrap()
    val src = s"$root/main.sysl"

    make_dir_all(root).unwrap()
    write_text(src, text).unwrap()

    val out = emit_llvm_text(src, None) match
        Err(why) -> s"did not compile: ${why.message}"
        Ok(made) ->
            if !made.report.is_empty() then s"did not compile: ${analysis_report(made.report)}"
            else made.text

    remove_dir_all(root).unwrap_or(())
    out
end vmx_ir

// Sums `n` `int`s out of a walk it was lent, so each test is about the member rather than the walk.
private vmx_sum() -> string = "sum_tail(n: int, ap: *va_list) -> int\n" +
                              "    var t = 0\n" +
                              "    for i in 0..<n\n" +
                              "        var v: int = va_arg(ap)\n" +
                              "        t += v\n" +
                              "    t\n" +
                              "end sum_tail\n"

// A struct whose method reads a tail and adds its own field to the total.
private vmx_acc() -> string = vmx_sum() +
                              "struct Acc\n" +
                              "    base: int\n" +
                              "\n" +
                              "    total(self, n: int, ...) -> int\n" +
                              "        var ap: va_list\n" +
                              "        va_start(ap)\n" +
                              "        var t = sum_tail(n, &ap)\n" +
                              "        va_end(ap)\n" +
                              "        self.base + t\n" +
                              "    end total\n" +
                              "end Acc\n"

// The same walk, in a body of the caller's naming.
private vmx_walk(indent: string) -> string = s"${indent}var ap: va_list\n" +
                                             s"${indent}va_start(ap)\n" +
                                             s"${indent}var t = sum_tail(n, &ap)\n" +
                                             s"${indent}va_end(ap)\n"

// An associated function that builds its value out of a tail.
private vmx_of() -> string = vmx_sum() +
                             "struct Acc\n" +
                             "    base: int\n" +
                             "\n" +
                             "    of(n: int, ...) -> Acc\n" +
                             vmx_walk("        ") +
                             "        Acc(t)\n" +
                             "    end of\n" +
                             "end Acc\n"

// A trait with a variadic member and a struct that implements it.
private vmx_log() -> string = vmx_sum() +
                              "trait Log\n" +
                              "    note(self, n: int, ...) -> int\n" +
                              "\n" +
                              "struct W\n" +
                              "    base: int\n" +
                              "\n" +
                              "impl Log for W\n" +
                              "    note(self, n: int, ...) -> int\n" +
                              vmx_walk("        ") +
                              "        self.base + t\n" +
                              "    end note\n" +
                              "end W\n"

// ---- a method ------------------------------------------------------------------------------------

@test("a method reads its tail exactly as a free function does")
vmx_a_method_reads_its_tail()
    if !vmx_ready() then return

    assert_eq(vmx_ran(vmx_acc() + "var a = Acc(100)\nprint(a.total(3, 1, 2, 3))\n"), "106\n")

@test("a method carries the ellipsis into the definition, and the call names the whole type")
vmx_a_method_carries_the_ellipsis()
    if !vmx_ready() then return

    val out = vmx_ir(vmx_acc() + "var a = Acc(100)\nprint(a.total(2, 1, 2))\n")

    assert(vmx_says(out, "define i32 @Acc.total(%struct.Acc %self.param, i32 %n.param, ...)"))
    assert(vmx_says(out, "call i32 (%struct.Acc, i32, ...) @Acc.total("))
end vmx_a_method_carries_the_ellipsis

@test("a method may be called with an empty tail")
vmx_a_method_with_an_empty_tail()
    if !vmx_ready() then return

    assert_eq(vmx_ran(vmx_acc() + "var a = Acc(100)\nprint(a.total(0))\n"), "100\n")

// The receiver is a parameter once the member is lowered, so it is what a tail with no other fixed
// parameter anchors on -- which is why this declaration is complete.
@test("a method may take the receiver as its only fixed parameter")
vmx_the_receiver_alone_anchors_the_tail()
    if !vmx_ready() then return

    val src = "struct Tag\n" +
              "    v: int\n" +
              "\n" +
              "    only(self, ...) -> int\n" +
              "        var ap: va_list\n" +
              "        va_start(ap)\n" +
              "        var a: int = va_arg(ap)\n" +
              "        va_end(ap)\n" +
              "        self.v + a\n" +
              "    end only\n" +
              "end Tag\n" +
              "print(Tag(100).only(5))\n"

    assert_eq(vmx_ran(src), "105\n")
end vmx_the_receiver_alone_anchors_the_tail

@test("a method may take its receiver in any mode")
vmx_any_receiver_mode()
    if !vmx_ready() then return

    val src = vmx_sum() +
              "struct P\n" +
              "    v: int\n" +
              "\n" +
              "    thru(*self, n: int, ...) -> int\n" +
              vmx_walk("        ") +
              "        self.v + t\n" +
              "    end thru\n" +
              "end P\n" +
              "\n" +
              "struct R\n" +
              "    v: int\n" +
              "\n" +
              "    thru(&self, n: int, ...) -> int\n" +
              vmx_walk("        ") +
              "        self.v + t\n" +
              "    end thru\n" +
              "end R\n" +
              "\n" +
              "var p = P(100)\n" +
              "var r: &R = R(200)\n" +
              "print(p.thru(2, 1, 2), r.thru(2, 1, 2))\n"

    assert_eq(vmx_ran(src), "103 203\n")
end vmx_any_receiver_mode

@test("an enum's members take one too")
vmx_an_enum_member()
    if !vmx_ready() then return

    val src = vmx_sum() +
              "enum Sign\n" +
              "    Up\n" +
              "    Down\n" +
              "\n" +
              "    lift(self, n: int, ...) -> int\n" +
              vmx_walk("        ") +
              "        t\n" +
              "    end lift\n" +
              "end Sign\n" +
              "print(Sign.Up.lift(2, 5, 6))\n"

    assert_eq(vmx_ran(src), "11\n")
end vmx_an_enum_member

// ---- an associated function ----------------------------------------------------------------------

@test("an associated function takes a tail as long as something else is named before it")
vmx_an_associated_function()
    if !vmx_ready() then return

    assert_eq(vmx_ran(vmx_of() + "print(Acc.of(2, 20, 22).base)\n"), "42\n")

// It has no receiver to anchor on, so the rule a free function meets is the rule it meets -- and the
// message is the same one, named for the lowered member.
@test("an associated function with nothing named before it is refused")
vmx_an_associated_function_needs_a_named_parameter()
    if !vmx_ready() then return

    assert(vmx_says(vmx_err("struct S\n    v: int\n    make(...) -> S = S(1)\nprint(S.make(1).v)\n"),
                    "'S.make' needs at least one named parameter before '...'"))

// ---- a nested function ---------------------------------------------------------------------------

// Its environment holds the first parameter slot the way a receiver does, so the tail anchors after
// what the program wrote.
@test("a nested function walks its own tail, and reaches the frame it was declared in")
vmx_a_nested_function()
    if !vmx_ready() then return

    val src = "outer(base: int)\n" +
              "    total(n: int, ...) -> int\n" +
              "        var ap: va_list\n" +
              "        va_start(ap)\n" +
              "        var t = base\n" +
              "        for i in 0..<n\n" +
              "            var v: int = va_arg(ap)\n" +
              "            t += v\n" +
              "        va_end(ap)\n" +
              "        t\n" +
              "    end total\n" +
              "\n" +
              "    print(total(3, 10, 20, 30))\n" +
              "\n" +
              "outer(1)\n"

    assert_eq(vmx_ran(src), "61\n")
end vmx_a_nested_function

// The environment is not a *named* parameter, so it does not stand in for one.
@test("a nested function with nothing named before it is refused, as anywhere else")
vmx_a_nested_function_needs_a_named_parameter()
    if !vmx_ready() then return

    assert(vmx_says(vmx_err("outer()\n    make(...) -> int = 1\n    print(make(1))\nouter()\n"),
                    "'make' needs at least one named parameter before '...'"))

// ---- a member of a generic type ------------------------------------------------------------------

@test("a member of a generic type may be variadic, and the tail stays out of the inference")
vmx_a_generic_member()
    if !vmx_ready() then return

    val src = vmx_sum() +
              "struct Box[T]\n" +
              "    item: T\n" +
              "\n" +
              "    plus(self, n: int, ...) -> int\n" +
              vmx_walk("        ") +
              "        t\n" +
              "    end plus\n" +
              "end Box\n" +
              "var b = Box(7)\n" +
              "print(b.plus(2, 3, 4))\n"

    assert_eq(vmx_ran(src), "7\n")
end vmx_a_generic_member

// A member's own type parameters are solved from the arguments that stand at a parameter, and the
// tail stands at none -- so what solves `T` here is the label alone.
@test("a member's own type parameters are solved from the declared arguments only")
vmx_member_type_parameters_ignore_the_tail()
    if !vmx_ready() then return

    val src = vmx_sum() +
              "struct S\n" +
              "    v: int\n" +
              "\n" +
              "    tag[T](self, label: T, n: int, ...) -> int\n" +
              vmx_walk("        ") +
              "        t\n" +
              "    end tag\n" +
              "end S\n" +
              "var s = S(1)\n" +
              "print(s.tag(\"x\", 2, 3, 4), s.tag(2.5, 1, 9))\n"

    assert_eq(vmx_ran(src), "7 9\n")
end vmx_member_type_parameters_ignore_the_tail

// ---- a trait -------------------------------------------------------------------------------------

@test("a trait may declare one, and an implementation supplies it")
vmx_a_trait_declares_one()
    if !vmx_ready() then return

    assert_eq(vmx_ran(vmx_log() + "print(W(100).note(3, 1, 2, 3))\n"), "106\n")

// A bound is where a variadic trait method is usable: the call is monomorphized, so it knows which
// function it is reaching and can name its whole type.
@test("a trait's variadic member is reached through a bound")
vmx_reached_through_a_bound()
    if !vmx_ready() then return

    assert_eq(vmx_ran(vmx_log() + "through[T: Log](x: T) -> int = x.note(2, 1, 2)\nprint(through(W(100)))\n"),
              "103\n")

@test("a trait's default body may walk the tail it was declared with")
vmx_a_default_body_walks_the_tail()
    if !vmx_ready() then return

    val src = vmx_sum() +
              "trait Loud\n" +
              "    shout(self, n: int, ...) -> int\n" +
              vmx_walk("        ") +
              "        t * 10\n" +
              "    end shout\n" +
              "\n" +
              "struct W\n" +
              "    base: int\n" +
              "\n" +
              "impl Loud for W\n" +
              "end W\n" +
              "print(W(1).shout(2, 2, 3))\n"

    assert_eq(vmx_ran(src), "50\n")
end vmx_a_default_body_walks_the_tail

// A `...` is part of what a caller may write, so an implementation with one where the trait has none
// is a different promise rather than a wider one. Both directions.
@test("an implementation must agree with its trait about the ellipsis")
vmx_an_implementation_agrees_about_the_ellipsis()
    if !vmx_ready() then return

    val varied = "trait Log\n    note(self, n: int, ...) -> int\n\nstruct W\n    base: int\n\n"

    assert(vmx_says(vmx_err(varied + "impl Log for W\n    note(self, n: int) -> int = self.base + n\nend W\nprint(1)\n"),
                    "method 'note' of 'impl Log for W' does not take a '...', but trait 'Log' declares one"))

    val plain = "trait Log\n    note(self, n: int) -> int\n\nstruct W\n    base: int\n\n"

    assert(vmx_says(vmx_err(plain + "impl Log for W\n    note(self, n: int, ...) -> int = self.base + n\nend W\nprint(1)\n"),
                    "method 'note' of 'impl Log for W' takes a '...', but trait 'Log' declares none"))
end vmx_an_implementation_agrees_about_the_ellipsis

@test("a trait's variadic member is not reached through a trait object, and it says why")
vmx_not_through_a_trait_object()
    if !vmx_ready() then return

    val src = "trait Log\n" +
              "    note(self, n: int, ...) -> int\n" +
              "\n" +
              "struct W\n" +
              "    base: int\n" +
              "\n" +
              "impl Log for W\n" +
              "    note(self, n: int, ...) -> int = self.base + n\n" +
              "end W\n" +
              "show(x: &Log) -> int = x.note(1, 2)\n" +
              "print(show(W(1)))\n"

    assert(vmx_says(vmx_err(src),
                    "'note' of 'Log' takes a '...', and a call to one names the whole function type it is " +
                    "reaching — a slot in a method table is a word and names none, so there is no '&Log' to form"))
end vmx_not_through_a_trait_object

// A trait's members lower to nothing, so a promise nothing keeps is where a signature rule has to be
// asked at the declaration or nowhere.
@test("a trait promise nothing implements is held to the same rules")
vmx_an_unimplemented_promise_is_checked()
    if !vmx_ready() then return

    assert(vmx_says(vmx_err("trait T\n    hold(self, ap: va_list) -> int\nprint(1)\n"),
                    "a va_list is a parameter as '*va_list', not as 'va_list' — a parameter is a by-value " +
                    "binding, and a copy of a walk advances nothing 'T.hold''s caller can see, so the walk is " +
                    "handed over by address and the call writes '&ap'"))

// Not a reference case: what the fix above reaches beyond the trait. The reference asks the rule of a
// type's own member, of an implementation's, and again of an inherited default's copy under the
// implementing type's name.
@test("every member is held to the va_list parameter rule, an inherited default's copy included")
vmx_every_member_is_held_to_the_va_list_rule()
    if !vmx_ready() then return

    val rule = "a va_list is a parameter as '*va_list', not as 'va_list' — a parameter is a by-value " +
               "binding, and a copy of a walk advances nothing "
    val written = vmx_err("trait T\n    hold(self, ap: va_list) -> int\nstruct W\n    v: int\n" +
                          "impl T for W\n    hold(self, ap: va_list) -> int = 1\nend W\n" +
                          "struct S\n    v: int\n    take(self, ap: va_list) -> int = 1\nprint(1)\n")

    assert(vmx_says(written, rule + "'T.hold''s caller can see"))
    assert(vmx_says(written, rule + "'W.hold''s caller can see"))
    assert(vmx_says(written, rule + "'S.take''s caller can see"))

    val inherited = vmx_err("trait T\n    hold(self, ap: va_list) -> int\n        1\n    end hold\n" +
                            "struct W\n    v: int\nimpl T for W\nend W\nprint(1)\n")

    assert(vmx_says(inherited, rule + "'T.hold''s caller can see"))
    assert(vmx_says(inherited, rule + "'W.hold''s caller can see"))
end vmx_every_member_is_held_to_the_va_list_rule

// A variadic member's tail reaches the callee through every way a member is called.
@test("a variadic member's tail arrives through an associated, a generic and a dispatched call")
vmx_the_tail_arrives_through_every_member_call()
    if !vmx_ready() then return

    val src = vmx_sum() +
              "struct K\n" +
              "    v: int\n" +
              "\n" +
              "    of(n: int, ...) -> int\n" +
              vmx_walk("        ") +
              "        t\n" +
              "    end of\n" +
              "\n" +
              "    on(self, n: int, ...) -> int\n" +
              vmx_walk("        ") +
              "        self.v + t\n" +
              "    end on\n" +
              "\n" +
              "    at[T](self, x: T, n: int, ...) -> int\n" +
              vmx_walk("        ") +
              "        self.v + t\n" +
              "    end at\n" +
              "end K\n" +
              "print(K.of(n = 0),K.of(2, 40, 2), K(1).on(1, 9), K(1).at(true, 3, 1, 2, 3))\n"

    assert_eq(vmx_ran(src), "0 42 10 7\n")
end vmx_the_tail_arrives_through_every_member_call

// Two implementations of one trait are told apart by the arguments, and a tail stands at no
// parameter -- so what tells them apart stops where the declared parameters do.
@test("two implementations of one variadic member are told apart by the declared arguments")
vmx_two_implementations_told_apart()
    if !vmx_ready() then return

    val src = "trait Sink[T]\n" +
              "    put(self, x: T, n: int, ...) -> int\n" +
              "\n" +
              "struct B\n" +
              "    v: int\n" +
              "\n" +
              "impl Sink[int] for B\n" +
              "    put(self, x: int, n: int, ...) -> int = self.v + x\n" +
              "end B\n" +
              "\n" +
              "impl Sink[string] for B\n" +
              "    put(self, x: string, n: int, ...) -> int = self.v\n" +
              "end B\n" +
              "print(B(1).put(5, 2, 7, 8), B(1).put(\"a\", 1, 9))\n"

    assert_eq(vmx_ran(src), "6 1\n")
end vmx_two_implementations_told_apart

// ---- the call is checked the way a free function's is --------------------------------------------

@test("a variadic method's declared parameters are still required, by name")
vmx_declared_parameters_are_required()
    if !vmx_ready() then return

    assert(vmx_says(vmx_err(vmx_acc() + "var a = Acc(1)\nprint(a.total())\n"),
                    "method 'Acc.total' takes at least 1 argument, but 0 arguments were given"))

@test("a variadic method's declared parameters are still checked")
vmx_declared_parameters_are_checked()
    if !vmx_ready() then return

    assert(vmx_says(vmx_err(vmx_acc() + "var a = Acc(1)\nprint(a.total(\"three\", 1))\n"),
                    "'n' of 'Acc.total' is int, but string was given"))

@test("a variadic method's tail carries only what varargs can carry")
vmx_the_tail_carries_only_registers()
    if !vmx_ready() then return

    assert(vmx_says(vmx_err(vmx_acc() + "var a = Acc(1)\nprint(a.total(1, \"one\"))\n"),
                    "a string cannot be passed to a sysl function's '...' — a walk over the tail reads " +
                    "back one register at a time and an aggregate is not one, where a foreign callee " +
                    "takes it because C says which registers it arrives in"))

@test("a narrow argument to a variadic method arrives promoted")
vmx_a_narrow_argument_arrives_promoted()
    if !vmx_ready() then return

    assert_eq(vmx_ran(vmx_acc() + "var a = Acc(0)\nvar b: u8 = 200\nvar c: i8 = -5\nprint(a.total(2, b, c))\n"),
              "195\n")

@test("an associated function's tail is checked the same way")
vmx_an_associated_functions_tail_is_checked()
    if !vmx_ready() then return

    assert(vmx_says(vmx_err(vmx_of() + "print(Acc.of().base)\n"),
                    "associated function 'Acc.of' takes at least 1 argument, but 0 arguments were given"))
    assert(vmx_says(vmx_err(vmx_of() + "print(Acc.of(1, \"x\").base)\n"),
                    "a string cannot be passed to a sysl function's '...'"))
end vmx_an_associated_functions_tail_is_checked

// ---- what the grammar refuses --------------------------------------------------------------------

// The ellipsis is the end of a parameter list wherever one is written, so a parameter after it is a
// parse error rather than a silently ignored one.
@test("an ellipsis before a parameter is a parse error")
vmx_an_ellipsis_before_a_parameter()
    if !vmx_ready() then return

    assert(vmx_says(vmx_err("struct S\n    v: int\n    add(self, ..., n: int) -> int = self.v\n"), "')' expected"))

@test("a member with no parameter list at all is still a property")
vmx_no_parameter_list_is_a_property()
    if !vmx_ready() then return

    assert_eq(vmx_ran("struct S\n    v: int\n    twice -> int = self.v * 2\nprint(S(21).twice)\n"), "42\n")
