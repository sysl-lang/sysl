module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.Search

// Reading a program's declarations into the tables.
//
// **Nothing here resolves a type.** Hoisting registers *names*: what a file declares, in what module,
// how far it reaches, and whether something already stood under that key. That has to happen for
// every file before any type is resolved, because a declaration may name one written below it -- in
// the same file, in a sibling, or in a module imported the other way round.
//
// **Each declaration is a recovery region.** A refusal is recorded and the declaration abandoned,
// and the walk resumes at the next one. That is what turns one error per compilation into one error
// per mistake.

// The module the auto-import brings into scope with no `import` written.
const AutoImportedModule: string = "sysl"

// The module a file contributes to: what its header said, or the anonymous root module where it
// said nothing -- under the canonical prefix of the package it came from.
//
// The prefix is what keeps a dependency's `json` and this project's `json` apart, and it is added
// *here* rather than being written in the file so that a package's source is the same source
// whoever depends on it. A compilation with no dependencies has no prefixes, so this is the
// header's own name and nothing has changed.
module_of_unit(p: Program) -> string
    val written = p.module_name match
        Some(m) -> m.show()
        None -> ModuleRoot

    package_qualify(p.pkg.prefix, written)
end module_of_unit

// The terms one file's declarations are read in.
//
// **Every module of the compilation has to be registered before this is asked**, because the
// package layer decides what a written path means by asking which paths lead anywhere -- and a
// table that is still filling would answer a path that is there with a no.
scope_of_unit(a: &Analysis, p: Program) -> Scope =
    Scope(module_of_unit(p), gather_imports(a, p), p.src, p.pkg)

// What a file's `import` clauses bring into scope, together with the auto-import every file gets.
//
// **A wildcard is a module rather than a set of names**, because what a module declares is not
// settled until every file has been read: the list is resolved at the point a name is looked up.
//
// **Every path is read through the package layer on the way in**, so that a file of a fetched
// package writes its own short names and a consumer writes whatever its manifest called the
// package. For a project with no dependencies the two are the same string.
gather_imports(a: &Analysis, p: Program) -> Imports
    val here = module_of_unit(p)
    val body = p.body
    var names: Buf[(string, string)] = buf()
    var modules: Buf[(string, string)] = buf()
    var wildcards: Buf[string] = buf()

    // The auto-import is a wildcard over the standard module, for every file but the standard
    // module's own -- a module does not import itself, and a module *below* it still does.
    if here != AutoImportedModule then wildcards.push(AutoImportedModule)

    for item in body
        *item.kind match
            ImportDecl(d) -> read_import(a, &names, &modules, &wildcards,
                                         in_package(a, p.pkg, joined(d.path, ".")), d)
            _ -> ()

    // **A module auto-imported beside the standard one is offered once**, however the file also
    // names it: `import demo.*` over an auto-imported `demo` is the same wildcard, not a second offer
    // of every name in it. It is conditional on the module being in the compilation at all.
    for m in a.also_auto_imported
        if m != here && holds_string(a.tables.modules, m) && !holds_string(wildcards, m) then
            wildcards.push(m)

    Imports(names, modules, wildcards, buf())
end gather_imports

// The same for an `import` written **inside a body**, which binds for the statements after it and
// is taken back off at the dedent. It is the file's own reading with a narrower life, so it goes
// through the same function rather than a second one that could drift from it.
bind_block_import(a: &Analysis, into: *Imports, path: string, d: ImportDecl) =
    read_import(a, &into.names, &into.modules, &into.wildcards, path, d)

read_import(a: &Analysis, names: *Buf[(string, string)], modules: *Buf[(string, string)],
            wildcards: *Buf[string], path: string, d: ImportDecl)
    if d.wildcard then
        wildcards.push(path)
        return

    if d.selectors.is_empty() then
        // **A path with no braces after it may name a module or one declaration.** Which of the two
        // it is is not decided here -- what a module declares is not settled until every file has
        // been read -- so both readings are recorded and the lookup takes whichever exists.
        modules.push((import_bound(d), path))

        val cut = last_dot_in(path)

        if cut.is_some() then
            names.push((import_bound(d), module_qualify(path[0..<cut.unwrap()],
                                                        path[cut.unwrap() + 1..<path.bytes.len])))

        return

    // **A selector may name a module beneath the path rather than a member of it**, which is the same
    // import `import a.b.c` would have made -- so it binds the module, and a directory holding no
    // source of its own can still have its sub-modules listed.
    for s in d.selectors
        val sub = s"$path.${s.name}"

        if a.tables.has_module(sub) then modules.push((selector_bound(s), sub))
        else names.push((selector_bound(s), module_qualify(path, s.name)))

// Where the last dot of a path is, which is what separates a module from a name in it.
last_dot_in(name: string) -> Option[usize]
    val b = name.bytes
    var found: Option[usize] = None

    for i in 0..<b.len
        if b[i] == u8('.') then found = Some(i)

    found
end last_dot_in

// Whether one module name is the other or is below it. Compared as bytes: a string's subscript is
// boundary-checked, so cutting `geometría` at the length of a shorter module's prefix traps.
starts_with_module(name: string, outer: string) -> bool
    val prefix = s"$outer."

    name == outer || (name.bytes.len > prefix.bytes.len && name.starts_with(prefix))
end starts_with_module

// Whether `part`'s bytes stand in `text` at byte `at`. Compared byte by byte rather than by cutting
// the string, for the same reason: a segment that is not ASCII (`Cuentaañ`) cut at another string's
// length can end inside a character, and the subscript traps there.
bytes_at(text: string, at: usize, part: string) -> bool
    if at + part.bytes.len > text.bytes.len then return false

    for i in 0..<part.bytes.len
        if text.bytes[at + i] != part.bytes[i] then return false

    true
end bytes_at

// The parts of a path joined by a separator.
joined(parts: Buf[string], sep: string) -> string
    var out = ""

    for i in 0..<parts.len()
        if i > 0 then out = s"$out$sep"

        out = s"$out${parts.at(i)}"

    out
end joined

// -- reading a whole compilation's declarations --------------------------------------------------

// Registers every declaration of every file, in the terms its own file set up.
hoist_units(a: &Analysis, units: Buf[Program])
    var scopes: Buf[Scope] = buf()

    // Which files said `@tests`, recorded before anything is registered: what a `@tests` file
    // declares is scaffolding, and that is asked of every declaration below.
    for item in units
        if item.test_only
            a.tables.test_only_files.push(item.src.name)
            note_test_file_types(a, item)

    // **Every module name is registered before a single scope is built**, because a scope reads its
    // file's import paths through the package layer and that layer asks which paths lead anywhere.
    // Registering as the scopes were made answered that question against a half-filled table, so a
    // file's import of a module declared further down the list was read as naming nothing.
    for item in units
        val name = module_of_unit(item)

        if !a.tables.has_module(name) then a.tables.modules.push(name)

        val prefix = item.pkg.prefix

        if prefix != "" &&!holds_string(a.tables.package_prefixes, prefix)
            a.tables.package_prefixes.push(prefix)

        // The project's own modules and every source root's, which a dependency's file may not
        // reach by writing their names (`in_package`).
        val projects = prefix == "" && !item.src.name.starts_with(s"$StdPrefix/")

        if projects && !holds_string(a.tables.project_modules, name) then a.tables.project_modules.push(name)

    for item in units
        scopes.push(scope_of_unit(a, item))

    // The reserved shape is refused before anything is registered, so a declaration that tried to
    // take one is answered by that rather than by the consequences of a name the rest of the
    // compiler then could not resolve.
    // **The entry file's bindings are left to the body they belong to**, whose statements bind them
    // and say `binding` -- a `val` there is a local like any other, and saying so twice would answer
    // one mistake from two places.
    for i in 0..<units.len()
        val body = units.at(i).body
        val is_entry = a.tables.entry_src != "" && units.at(i).src.name == a.tables.entry_src

        for item in body
            if is_entry && entry_binding(item) &&
                    !belongs_to_module(item, a.tables.entry_captures) then continue

            val taken = reserved_in(item)

            for k in 0..<taken.len()
                a.fault(scopes.at(i), taken.at(k).2, refuse_reserved(taken.at(k).0, taken.at(k).1))

    // **What each file makes nameable beyond itself is read before anything is registered**, so a
    // file-private declaration hoisted ahead of a public one of its spelling knows to leave the plain
    // key to it (`decl_key`). Asking the tables instead would make where each declaration lands
    // depend on the order the files arrived in.
    for i in 0..<units.len()
        val body = units.at(i).body
        val is_entry = a.tables.entry_src != "" && units.at(i).src.name == a.tables.entry_src

        for item in body
            if is_entry && !belongs_to_module(item, a.tables.entry_captures) then continue

            note_wider(a, scopes.at(i), item)

    for i in 0..<units.len()
        val body = units.at(i).body
        val is_entry = a.tables.entry_src != "" && units.at(i).src.name == a.tables.entry_src

        for j in 0..<body.len()
            // The entry file is a body, so what it declares is that body's unless it has no
            // run-time identity. Everything else it carries is registered here as any other file's
            // would be.
            if is_entry && !belongs_to_module(body.at(j), a.tables.entry_captures) then continue

            hoist_stmt(a, scopes.at(i), body.at(j))

            // A `where` predicate and a struct's `invariant` clauses are ordinary functions of the
            // values they read, registered beside the declaration that wrote them so that the pass
            // which types every body types these too.
            register_predicate(a, scopes.at(i), body.at(j))
end hoist_units

// Whether a statement of the entry file is a binding its body makes rather than a declaration.
private entry_binding(s: Stmt) -> bool = *s.kind match
    ValDecl(_, _, _, _, _, _) -> true
    VarDecl(_, _, _, _, _, _, _) -> true
    _ -> false

// What a trait's members may not carry a body for.
//
// **An ASSOCIATED FUNCTION may carry a default, exactly as a method may** -- a body with no receiver
// still has something to work on, a constant or a `Self.other()`, and every implementation
// inheriting one value is the reason a default *works* rather than an objection to one.
//
// What is refused is a **static property**, and its reason is its own: a property has no parameter
// list and no receiver, so a default there is a value with nothing available to vary it. An
// implementation could only take it or replace it whole, and a trait is the wrong place to write a
// constant every type shares.
private check_trait_defaults(a: &Analysis, scope: Scope, d: TraitDecl)
    for m in d.methods
        if m.recv_mode().is_none() && m.is_static && !m.body.is_empty()
            a.fault(scope, m.span,
                    s"'${d.name}.${m.name}' is a property of the type, so a default body would " +
                    "give every implementation the same value — drop the body and let each one " +
                    "supply it")

        check_member_signature(a, scope, m.span, s"${d.name}.${m.name}", m)
end check_trait_defaults

// Registers one top-level declaration.
hoist_stmt(a: &Analysis, scope: Scope, s: Stmt)
    *s.kind match
        StructDecl(d) ->
            hoist_type_name(a, scope, s.span, d.name, d.vis,
                            StructOf(with_struct_call_bounds(d)))
        EnumDecl(d) ->
            hoist_type_name(a, scope, s.span, d.name, d.vis,
                            EnumOf(with_enum_call_bounds(d)))
        TraitDecl(d) ->
            hoist_type_name(a, scope, s.span, d.name, d.vis,
                            TraitOf(with_trait_call_bounds(d)))
            check_trait_defaults(a, scope, d)
        TypeDecl(d) -> hoist_type_name(a, scope, s.span, d.name, d.vis, TypeOf(d))
        CTypeBlock(ts) ->
            for t in ts
                hoist_type_name(a, scope, t.span, t.name, t.vis, CTypeOf(t))
        CConstBlock(cs) ->
            for c in cs
                hoist_value(a, scope, c.span, c.name, Some(c.typ), c.vis, a.tables.consts,
                            "constant", None)
        ConstDecl(name, typ, value, vis) ->
            hoist_value(a, scope, s.span, name, Some(typ), vis, a.tables.consts, "constant",
                        Some(value))
        ValDecl(name, typ, value, vis, align, section) ->
            // What is visible outside its file states its types, and a module member always could
            // be (`reference/modules.md § Visibility`). Reported, and registered all the same, so the
            // one line that is wrong is the one line reported.
            if typ.is_none() then
                a.fault(scope, s.span, s"a module-level 'val' states its type, so '$name' needs one " +
                        s"— 'val $name: T = …'")

            hoist_value(a, scope, s.span, name, typ, vis, a.tables.vals, "'val'", Some(value), align,
                        section)
        // **A top-level `var` is the module's storage**, wherever it was written. The one file
        // where it is a local instead is the one the program starts in, and that file's bindings
        // never reach this walk.
        VarDecl(name, typ, init, vis, align, section, thread_local) ->
            hoist_storage(a, scope, s.span, name, typ, vis, init, align, section, thread_local)
        // **The back end's namespace holds code, never storage**: left alone this emits
        // `@llvm.x = external global`, which the verifier refuses for a reason nobody would trace
        // back to the line that caused it.
        ExternVarDecl(name, typ, link, vis) ->
            if is_intrinsic_name(link.unwrap_or(name))
                a.fault(scope, s.span, s"'${link.unwrap_or(name)}' is in the namespace the back end's " +
                        "own operations live in, and those are code rather than storage — an " +
                        "'extern' variable names a symbol the linker resolves")
            else
                check_foreign_symbol(a, scope, s.span, link.unwrap_or(name), link.is_some())

            hoist_value(a, scope, s.span, name, Some(typ), vis, a.tables.extern_vars,
                        "'extern' variable", None, None, None, false, link)
        ExternDecl(d) -> hoist_extern(a, scope, s.span, d)
        // A bare-arrow parameter is sugar for a bounded type parameter, and the rewrite happens
        // at the declaration so that everything after it is the generic machinery that exists.
        FuncDecl(d) -> hoist_func(a, scope, s.span, with_call_bounds(d))
        // **A `@tests` file may hold an `impl` only for a type it declares itself**: a test build
        // keeps the file and every other build drops it, so an `impl` there for any other type would
        // make a trait answer differently in the tests than in the program that ships. A type the
        // same file declares exists in no other build, so there is nothing for its `impl` to
        // disagree with. Refused rather than registered, so nothing is analyzed against an answer
        // that will not be there.
        ImplDecl(d) ->
            if test_only_file(a, scope.src.name) && !impl_subject_local(a, scope.src.name, d)
                a.fault(scope, s.span, "an 'impl' block in a file that said '@tests' has to be for " +
                        s"a type that file declares, and ${impl_subject(d)} — a test build would keep " +
                        "this block and every other build would drop it, so a trait would answer one " +
                        "way while the tests ran and another way in the program that ships. Write the " +
                        "block beside the type's own declaration, or declare a type for the tests " +
                        "in this file")
            else
                a.tables.impls.push(Impl(with_impl_call_bounds(d), s.span, scope))
        // **`static` says outright what a header would have said**, so what is under one is
        // registered exactly as another file's declaration of it would be -- which is the whole of
        // what the modifier does, in the one file where an ordinary `var` is a local instead.
        StaticDecl(inner) -> hoist_stmt(a, scope, inner)
        // The rule a module `val` meets, and a form that cannot satisfy it: a binding naming several
        // things, or written as a pattern, has nowhere to write a type for any of its parts, so it
        // can only ever be a local. Saying so here is what stops one asking for the module from
        // quietly becoming a local of the entry point.
        MultiDecl(names, mutable, _) ->
            if !mutable
                var named = ""

                for i in 0..<names.len()
                    if i > 0 then named = named + " and "

                    named = named + s"'${names.at(i)}'"

                a.fault(scope, s.span, "a module-level 'val' states its type, and a binding that " +
                        s"names several things has nowhere to write one — declare $named separately")
            end if
        PatternDecl(_, mutable, _) ->
            if !mutable then
                a.fault(scope, s.span, "a module-level 'val' states its type, and a binding written " +
                        "as a pattern has nowhere to write one — take the value apart inside a " +
                        "function, or declare the parts separately")
        _ -> ()

// Module storage: a `val` that may be written to, which is what a top-level `var` declares.
private hoist_storage(a: &Analysis, scope: Scope, span: Span, name: string, typ: Option[TypeRef],
                      vis: Visibility, init: Option[Expr], align: Option[Expr],
                      section: Option[string], thread_local: bool)
    // The rule a module `val` meets, biting harder: module storage written with `var` may have no
    // initializer at all for a type to be read off.
    if typ.is_none() then
        a.fault(scope, span, s"'$name' is module storage, and module storage states its type — " +
                s"write '$name: T'")

    hoist_value(a, scope, span, name, typ, vis, a.tables.vals, "'var'", init, align, section,
                thread_local)
    a.tables.writable.push(file_private_key(a, scope.src.name,
                                            module_qualify(scope.module_name, name)))

// Files what a declaration may be named from, and refuses a `private[M]` naming a module the
// declaration is not inside.
//
// **The scope is checked HERE rather than where the name is used**, because the mistake is the
// modifier: one wrong word is one diagnostic, and the declaration it was written on still stands so
// that every call of it goes on being read.
private record_access(a: &Analysis, scope: Scope, span: Span, key: string, vis: Visibility)
    vis match
        Scoped(name) ->
            if widened_to(scope.module_name, name).is_none()
                a.fault(scope, span, scope_names_nothing(name, scope.module_name))
        _ -> ()

    a.tables.access.put(key, Access(vis, scope.src.name, scope.module_name))
end record_access

// Files how far each field and member of a type may be named from.
//
// **Silence is not "public" here**: an unmarked member is as visible as the type it belongs to, so
// the owner's own answer is copied onto it and a member of a restricted type is restricted without
// having said anything. A trait's members carry no modifier of their own and are filed the same way,
// which is what puts a private trait's methods out of reach with it.
private record_members_access(a: &Analysis, scope: Scope, key: string, written: string,
                              vis: Visibility, kind: DeclKind)
    kind match
        StructOf(d) ->
            for f in d.fields
                record_member_access(a, scope, key, written, vis, f.name, f.vis, f.span)

            for m in d.members
                record_member_access(a, scope, key, written, vis, m.name, m.vis, m.span)
        EnumOf(d) ->
            for m in d.members
                record_member_access(a, scope, key, written, vis, m.name, m.vis, m.span)
        TraitOf(d) ->
            for m in d.methods
                record_member_access(a, scope, key, written, vis, m.name, Public, m.span)
        _ -> ()
end record_members_access

// One field's or member's reach. A written modifier may only NARROW: a member reachable where its
// type is not is a member nothing can name anyway, so the claim would be false rather than merely
// useless, and it is reported at the modifier rather than clamped in silence.
private record_member_access(a: &Analysis, scope: Scope, owner: string, written: string,
                             owner_vis: Visibility, name: string, vis: Visibility, span: Span)
    val at = member_access_key(owner, name)
    val label = s"$written.$name"

    vis match
        Public ->
            a.tables.access.get(owner) match
                Some(acc) -> a.tables.access.put(at, acc)
                None -> ()
        File -> a.tables.access.put(at, Access(File, scope.src.name, scope.module_name))
        Scoped(m) ->
            val sub = widened_to(scope.module_name, m)

            if sub.is_none()
                a.fault(scope, span, scope_names_nothing(m, scope.module_name))
                return
            end if

            if wider_than_owner(scope, owner_vis, sub.unwrap())
                a.fault(scope, span,
                        s"'$label' is visible throughout module '${sub.unwrap()}', but " +
                        s"'${qualified_name(owner)}' is ${out_of_reach_tail(scope, owner_vis)} — a " +
                        "member cannot be more visible than the type it belongs to")

                a.tables.access.get(owner) match
                    Some(acc) -> a.tables.access.put(at, acc)
                    None -> ()

                return
            end if

            a.tables.access.put(at, Access(vis, scope.src.name, scope.module_name))
end record_member_access

// Whether a member widened to `sub` would reach past the type it belongs to.
private wider_than_owner(scope: Scope, owner_vis: Visibility, sub: string) -> bool = owner_vis match
    Public -> false
    File -> true
    Scoped(m) -> widened_to(scope.module_name, m) match
        None -> false
        Some(top) -> !beneath(sub, top)

// How far the owning type reaches, in the words the refusal above quotes.
private out_of_reach_tail(scope: Scope, vis: Visibility) -> string = vis match
    Scoped(m) -> widened_to(scope.module_name, m) match
        None -> s"private to '${scope.src.name}', the file that declares it"
        Some(top) -> s"private to module '$top'"
    _ -> s"private to '${scope.src.name}', the file that declares it"

// Registers a name that stands for a type.
private hoist_type_name(a: &Analysis, scope: Scope, span: Span, name: string, vis: Visibility,
                        kind: DeclKind)
    val plain = module_qualify(scope.module_name, name)
    val key = decl_key(a, scope, plain, vis)

    if type_name_taken(a, key, name) && type_contested(a, scope, vis, key) then
        a.fault(scope, span, type_taken_message(kind, name))
        return

    kind match
        StructOf(_) -> check_no_module_of_that_name(a, scope, span, key, name, "member")
        EnumOf(_) -> check_no_module_of_that_name(a, scope, span, key, name, "variant")
        TypeOf(_) -> check_no_module_of_that_name(a, scope, span, key, name, "member")
        _ -> ()

    a.tables.types.put(key, Decl(kind, span, scope))

    kind match
        EnumOf(d) ->
            for item in d.variants
                a.tables.variant_names.put(item.name, true)

            check_variants_free(a, scope, span, d)
        _ -> ()

    record_access(a, scope, span, key, vis)
    record_members_access(a, scope, key, name, vis, kind)

    if test_only_file(a, scope.src.name) then a.tables.test_only.push(key)

// Refuses a type whose module and name together spell a module the program also has.
//
// `geom.Point.dist` would then name both `geom`'s `Point.dist` and `geom.Point`'s `dist`, and a dotted
// reference takes the **longest** prefix that names a module -- so the module would win and the
// type's member would have no spelling left at all. The keys stay distinct either way; what collides
// is the path a program writes, which a diagnostic can fix and a silent choice cannot.
//
// **Only what a dotted chain reaches INTO is asked**: a struct, an enum, a named subtype. A trait is
// named in a bound or behind a sigil and never has a member selected off its name, so a module
// sharing its name takes nothing away from it.
private check_no_module_of_that_name(a: &Analysis, scope: Scope, span: Span, key: string,
                                     written: string, reachable: string)
    if !a.tables.has_module(module_show(key)) then return

    val shown = qualified_name(key)

    a.fault(scope, span, s"'$shown' is also a module, so '$shown.<$reachable>' would name two things — " +
            s"rename the module or '$written'")
end check_no_module_of_that_name

// The other order of a variant meeting a value of its spelling: the value was registered first, so
// the enum is the declaration that gives the name its second meaning, and the refusal is its own.
// The first variant that clashes is the one reported.
private check_variants_free(a: &Analysis, scope: Scope, span: Span, d: EnumDecl)
    for item in d.variants
        val v = item.name
        val holder = variant_value_holder(a, module_qualify(scope.module_name, v))

        if holder.is_some()
            a.fault(scope, span, s"variant name '$v' is already used by ${holder.unwrap()}")
            return
        end if
end check_variants_free

// What holds a spelling a variant wants, told apart the way the reference tells them: a module `var`
// is storage the program may write, and says so.
private variant_value_holder(a: &Analysis, key: string) -> Option[string]
    if a.tables.vals.has(key) && holds_string(a.tables.writable, key) then return Some("a module 'var'")

    value_name_holder(a, key)

// What a second declaration of a type name is told, in the reference's words: a trait says "the
// name", a trait being a set of requirements rather than a type, and everything else -- a struct, an
// enum, a named subtype, a plain alias and a measured `c type` alike -- says "type".
private type_taken_message(kind: DeclKind, name: string) -> string = kind match
    TraitOf(_) -> s"the name '$name' is already declared"
    _ -> s"type '$name' is already declared"

// The same rule for a type: two file-private declarations in two files are not a clash.
private type_contested(a: &Analysis, scope: Scope, vis: Visibility, key: string) -> bool
    val other = a.tables.types.get(key)

    if other.is_none() then return true
    if other.unwrap().scope.src.name == scope.src.name then return true

    !(is_file_private(vis) && is_file_private(a.tables.access.get(key).unwrap().vis))
end type_contested

// Whether something already stands for this name as a type: another declaration, a scalar, or one
// of the two words the language answers for itself.
type_name_taken(a: &Analysis, key: string, written: string) -> bool =
    a.tables.types.has(key) || written == "never" || written == "Self" ||
        scalar_named(written, int(a.tables.target.pointer_bits())).is_some()

// Registers a name that stands for storage.
private hoist_value(a: &Analysis, scope: Scope, span: Span, name: string, typ: Option[TypeRef],
                    vis: Visibility, into: &Table[ValueDecl], what: string, init: Option[Expr],
                    align: Option[Expr] = None, section: Option[string] = None,
                    thread_local: bool = false, link: Option[string] = None)
    val plain = module_qualify(scope.module_name, name)
    val key = decl_key(a, scope, plain, vis)
    val holder = if contested(a, scope, vis, key) then value_name_holder(a, key) else None

    // A second constant of one name is the duplicate it is, and said the way a second type is; a
    // constant meeting a name something else holds is told what holds it.
    if holder.is_some() then
        a.fault(scope, span, value_taken_message(a, key, name, what))
        return
    end if

    // **A bare variant is a value in its module's scope**, so any value spelled like one registered
    // before it would give the name two meanings. The other order is the enum's to report.
    val owner = enum_of_variant(a, plain)

    if owner.is_some()
        a.fault(scope, span, s"'$name' is already used by enum '${qualified_name(owner.unwrap())}'")
        return
    end if

    into.put(key, ValueDecl(name, typ, vis, span, scope, init, align, section, thread_local,
                            link))
    record_access(a, scope, span, key, vis)

    if test_only_file(a, scope.src.name) then a.tables.test_only.push(key)

// What a second declaration of a value name is told. **The same kind twice is one declaration
// written twice**, and says only that; **two kinds are two different things** contending for one
// name, so the message says which kind already has it -- and a module `var` is a kind of its own
// there, though it is filed in the table a `val` is.
private value_taken_message(a: &Analysis, key: string, name: string, what: string) -> string
    var held = "'val'"

    if a.tables.consts.has(key) then held = "constant"
    else if a.tables.extern_vars.has(key) then held = "'extern' variable"
    else if holds_string(a.tables.writable, key) then held = "'var'"

    if held == what
        if what == "constant" then return s"constant '$name' is already declared"

        return s"'$name' is already declared"

    val described = held match
        "constant" -> "a constant"
        "'extern' variable" -> "an 'extern' variable"
        "'var'" -> "a module 'var'"
        _ -> "a 'val'"

    s"'$name' is already used by $described"
end value_taken_message

// Whether a name another file already registered is one this declaration could be confused with.
//
// **Two file-private declarations in two files are not a clash at all**: neither file sees the
// other's, so there is no reference with two answers. `private const path_bytes` twice over in the
// library's `sysl.fs` is exactly this, and it is not a mistake.
private contested(a: &Analysis, scope: Scope, vis: Visibility, key: string) -> bool
    val holder_scope = value_scope_of(a, key)

    if holder_scope.is_none() then return true
    if holder_scope.unwrap().src.name == scope.src.name then return true

    !(is_file_private(vis) && is_file_private(value_vis_of(a, key)))
end contested

private value_scope_of(a: &Analysis, key: string) -> Option[Scope]
    if a.tables.consts.has(key) then return Some(a.tables.consts.get(key).unwrap().scope)
    if a.tables.vals.has(key) then return Some(a.tables.vals.get(key).unwrap().scope)
    if a.tables.extern_vars.has(key) then return Some(a.tables.extern_vars.get(key).unwrap().scope)

    None
end value_scope_of

private value_vis_of(a: &Analysis, key: string) -> Visibility
    if a.tables.consts.has(key) then return a.tables.consts.get(key).unwrap().vis
    if a.tables.vals.has(key) then return a.tables.vals.get(key).unwrap().vis
    if a.tables.extern_vars.has(key) then return a.tables.extern_vars.get(key).unwrap().vis

    Public
end value_vis_of

// What already holds a name that stands for storage, where anything does.
//
// A variant and a constant of one name have nothing to be told apart by, so the clash is real and is
// reported where it is written; two *variants* of one name are told apart by their enums, which is
// why an enum is not in this list.
value_name_holder(a: &Analysis, key: string) -> Option[string]
    if a.tables.consts.has(key) then return Some("a constant")
    if a.tables.vals.has(key) then return Some("a 'val'")
    if a.tables.extern_vars.has(key) then return Some("an 'extern' variable")

    None
end value_name_holder

private hoist_extern(a: &Analysis, scope: Scope, span: Span, d: ExternDecl)
    val base = module_qualify(scope.module_name, d.name)

    // The NAME is refused as well as the symbol, in any module: a `main` the program does not start
    // at would read as though it were the one it does.
    if d.name == "main" then
        a.fault(scope, span, "'main' is where a program starts, so it is not a name an 'extern' may take")
        return

    if a.tables.funcs.has(base) then
        a.fault(scope, span, s"'${d.name}' is already declared as a function, so this 'extern' " +
                "would overload it — what tells overloads of an 'extern' apart is the symbol each " +
                "names, and a sysl function declares no symbol")

        // **And it is still the ordinary duplicate** where the two lists cannot be told apart, the
        // one namespace being shared -- said after the extern's own account of why, as the
        // reference says both.
        val funcs = overload_keys(a, base)

        for i in 0..<funcs.len()
            val other = a.tables.funcs.get(funcs.at(i))

            if other.is_some() && same_params(d.params, other.unwrap().decl.params) then
                a.fault(scope, span, s"function '${d.name}' is already declared" +
                        differing_results(d.ret_type, other.unwrap().decl.ret_type))
                return

        return

    if a.tables.extern_vars.has(base) then
        a.fault(scope, span, s"'${d.name}' is already declared as an 'extern' variable")
        return

    // **Two `extern`s of one name are two functions exactly when they name two symbols**, and then
    // they are an overload set held to what any other is: a call has to be able to tell them apart
    // by its arguments. The symbol is asked first because it is the mistake only an `extern` can
    // make -- one C function claimed at two signatures, where both calls would reach the same code.
    val siblings = extern_overloads(a, base)
    var clash = false

    for item in siblings
        val other = a.tables.externs.get(item).unwrap()

        if !clash && extern_symbol(other) == extern_symbol(d) then
            a.fault(scope, span, s"'${d.name}' is already declared as an 'extern' for the symbol " +
                    s"'${extern_symbol(other)}' — two declarations of one name are two functions, " +
                    "and one C function cannot be two. Overloads of an 'extern' are told apart by " +
                    "the symbol each names, so give this one a symbol of its own or take its " +
                    "address and 'ptr_cast' it where the other signature is wanted")
            clash = true

    for item in siblings
        val other = a.tables.externs.get(item).unwrap()

        if same_params(d.params, other.params) then
            a.fault(scope, span, s"function '${d.name}' is already declared" +
                    differing_results(d.ret_type, other.ret_type))
            clash = true
        else if overlapping_lists(d.params, d.variadic, other.params, other.variadic) then
            a.fault(scope, span, indistinguishable_lists(base, d.params, other.params))
            clash = true

    if clash then return

    // The slot is a function's: the second declaration of a name is `f.2`, and the symbol a call
    // reaches is read off the declaration, never off this key.
    val key = if siblings.is_empty() then base else s"$base.${siblings.len() + 1}"

    a.tables.externs.put(key, d)
    a.tables.extern_scopes.put(key, ExternHome(scope, span))
    record_access(a, scope, span, key, d.vis)

    if d.link.is_some() then check_foreign_symbol(a, scope, span, d.link.unwrap(), true)

    check_signature_rules(a, scope, span, d.name, d.params, d.ret_type, d.variadic, true)
end hoist_extern

// The symbol an `extern` resolves to has to be one a linker can: letters, digits, `_`, `.` and `$`,
// which is what an object file's names are made of -- asked only of a link name, since a sysl name
// is one already. **And never `main`**: this program defines that symbol, so an `extern` naming it
// would be a declaration of the program's own entry point.
private check_foreign_symbol(a: &Analysis, scope: Scope, span: Span, symbol: string, written: bool)
    if written && !is_link_symbol(symbol)
        a.fault(scope, span, s"'$symbol' is not a symbol a linker can resolve")
        return
    end if

    if symbol == "main" then
        a.fault(scope, span, "'main' is where the platform starts this program, so an 'extern' may " +
                "not name that symbol")
end check_foreign_symbol

private is_link_symbol(symbol: string) -> bool
    if symbol == "" then return false

    for i in 0..<symbol.bytes.len
        val b = symbol.bytes[i]
        val letter = (b >= u8('a') && b <= u8('z')) || (b >= u8('A') && b <= u8('Z'))
        val digit = b >= u8('0') && b <= u8('9')

        if !letter && !digit && b != u8('_') && b != u8('.') && b != u8('$') then return false

    true
end is_link_symbol

// The rules a declared signature must satisfy whichever declaration form it came from, checked after
// the name is registered so a failure reports the mistake without also erasing the declaration it is
// about.
//
// C reads a variadic call's arguments relative to the last named parameter, so there has to be one;
// `f(...)` is not a callable declaration in any C either.
private check_signature_rules(a: &Analysis, scope: Scope, span: Span, name: string,
                              params: Buf[Param], ret: Option[TypeRef], variadic: bool,
                              foreign: bool)
    if variadic && params.is_empty() then
        a.fault(scope, span, s"'$name' needs at least one named parameter before '...'")

    check_rest_position(a, scope, name, params, variadic, foreign)
    check_va_list_positions(a, scope, name, params, ret, foreign)
end check_signature_rules

// Where a `...T` parameter may stand, which is last and only last (`reference/declarations.md § A
// parameter may collect the rest of the call`). It collects everything the call has left, so a
// parameter after it could never be given anything; it may not stand beside C's ellipsis, which is
// a different tail walked with `va_arg`; and an `extern` may not carry one, since what the packing
// hands over is a sysl slice -- three words with an owner in them -- and not what a C function was
// compiled to read. Asked of the first such parameter only, at that parameter.
private check_rest_position(a: &Analysis, scope: Scope, name: string, params: Buf[Param],
                            variadic: bool, foreign: bool)
    for i in 0..<params.len()
        val p = params.at(i)

        if !p.rest then continue

        if foreign
            a.fault(scope, p.span, s"'$name' is an 'extern', and '${p.name}: ...T' hands over a sysl " +
                    "slice — which is three words with an owner in them, and not what a C function " +
                    "was compiled to read. C's own tail is the bare '...' with no name and no type")
        else if variadic
            a.fault(scope, p.span, s"'$name' has two tails: '${p.name}: ...T' collects the rest of the " +
                    "call into a slice, and '...' is C's ellipsis, walked with 'va_arg'. A call has " +
                    "one tail, so a declaration may write one of them")
        else if i + 1 < params.len()
            a.fault(scope, p.span, s"'${p.name}' collects the rest of the call, so nothing can follow " +
                    s"it — the arguments that would be '${params.at(params.len() - 1).name}' are " +
                    "already inside it")

        return
end check_rest_position

// **A member is held to the same rules, its receiver counting as the named parameter a `...` anchors
// on** -- so `only(self, ...)` is complete and a receiverless `make(...)` is not. `name` is the
// member as the lowered function is called (`S.make`). A trait's members lower to nothing, so a
// promise nothing implements is asked here, at its declaration, or nowhere.
check_member_signature(a: &Analysis, scope: Scope, span: Span, name: string, m: MethodDecl)
    if m.variadic && m.params.is_empty() && m.recv_mode().is_none() then
        a.fault(scope, span, s"'$name' needs at least one named parameter before '...'")

    check_va_list_positions(a, scope, name, m.params, m.ret_type, false)
end check_member_signature

// A name spread as a pack has to have been DECLARED as one, and a pack may only be written as the
// whole of a tuple (`reference/generics.md § A parameter may stand for a list of types`) -- asked
// of the signature as written, with no substitution. Left to resolution it is never said at all:
// inference binds whatever `(..T)` matched, so a `T` declared as one type quietly starts standing
// for a list, and a signature nothing ever calls is never resolved.
//
// **The lengths are asked here too, and for the same reason** (`reference/generics.md § A parameter
// may stand for a value`): a length doing arithmetic on a value parameter, `[N + 1]int`, is never
// resolved where it is a parameter -- nothing unifies with it, so the call fails first and says the
// argument cannot be inferred, which is about the wrong line -- and a type parameter written as a
// length, `f[T](xs: [T]int)`, is solved before it is resolved: `unify` binds `T` to the length it
// read off the argument, after which it is indistinguishable from one declared `const`.
check_pack_spellings(a: &Analysis, scope: Scope, span: Span, tparams: Buf[string],
                     packs: Buf[string], values: Buf[TypeBinding], params: Buf[Param],
                     ret: Option[TypeRef])
    var names: Buf[string] = buf()
    var types: Buf[string] = buf()

    for i in 0..<values.len()
        names.push(values.at(i).name)

    for tparam in tparams
        if !has_binding(values, tparam) then types.push(tparam)

    val lengths = LengthNames(names, types)

    for param in params
        walk_pack_spellings(a, scope, span, tparams, packs, lengths, param.typ)

    if ret.is_some() then walk_pack_spellings(a, scope, span, tparams, packs, lengths, ret.unwrap())
end check_pack_spellings

// The names a written length is judged against: the value parameters, which a length may name but
// not compute with, and the type parameters, which a length may not name at all.
private struct LengthNames
    values: Buf[string]
    types: Buf[string]

private walk_pack_spellings(a: &Analysis, scope: Scope, span: Span, tparams: Buf[string],
                            packs: Buf[string], lengths: LengthNames, t: TypeRef)
    *t.kind match
        NamedType(_, args) ->
            for arg in args
                walk_pack_spellings(a, scope, span, tparams, packs, lengths, arg)
        PtrType(inner) -> walk_pack_spellings(a, scope, span, tparams, packs, lengths, inner)
        RefType(inner, _) -> walk_pack_spellings(a, scope, span, tparams, packs, lengths, inner)
        WeakType(inner) -> walk_pack_spellings(a, scope, span, tparams, packs, lengths, inner)
        VolatileType(inner) -> walk_pack_spellings(a, scope, span, tparams, packs, lengths, inner)
        ArrayType(length, elem, _) ->
            if length.is_some()
                length_arithmetic(a, scope, span, length.unwrap(), lengths.values)
                length_not_a_type(a, scope, span, length.unwrap(), lengths.types)
            end if

            walk_pack_spellings(a, scope, span, tparams, packs, lengths, elem)
        VectorType(lanes, elem) ->
            length_arithmetic(a, scope, span, lanes, lengths.values)
            length_not_a_type(a, scope, span, lanes, lengths.types)
            walk_pack_spellings(a, scope, span, tparams, packs, lengths, elem)
        // A written value argument is held to the rule a length is, for the same reason: `Buf[N + 1]`
        // puts a computation where an identity belongs.
        ValueArgType(e) ->
            length_arithmetic(a, scope, span, e, lengths.values)
            length_not_a_type(a, scope, span, e, lengths.types)
        TupleType(parts, _) ->
            if parts.len() == 1
                *parts.at(0).kind match
                    PackType(n) ->
                        declared_pack(a, scope, span, tparams, packs, n)
                        return
                    _ -> ()
            end if

            for item in parts
                walk_pack_spellings(a, scope, span, tparams, packs, lengths, item)
        // A pack reached anywhere else is one written outside the tuple that is the only place for it.
        PackType(n) ->
            declared_pack(a, scope, span, tparams, packs, n)
            a.fault(scope, span, s"'..$n' is a type pack and not a type — the only place one may be " +
                    s"written is inside a tuple, as '(..$n)'")
        FnType(ps, r, _) ->
            for item in ps
                walk_pack_spellings(a, scope, span, tparams, packs, lengths, item)

            walk_pack_spellings(a, scope, span, tparams, packs, lengths, r)
        CFnType(ps, r) ->
            for item in ps
                walk_pack_spellings(a, scope, span, tparams, packs, lengths, item)

            walk_pack_spellings(a, scope, span, tparams, packs, lengths, r)
        AssocType(base, _) -> walk_pack_spellings(a, scope, span, tparams, packs, lengths, base)
        AssocArgType(_, inner) -> walk_pack_spellings(a, scope, span, tparams, packs, lengths, inner)
        _ -> ()
end walk_pack_spellings

// A length that names a value parameter and computes with it (`[N + 1]int`). The length that IS
// the parameter is the whole of what a type may say about one; anything else built over it would
// need the compiler to decide when two expressions denote one length, which is type-level
// arithmetic and a separate feature. Left alone, the length resolves to whatever the placeholder
// made it and the array is silently the wrong size. A length measuring a TYPE parameter,
// `[sizeof(T) * 2]u8`, is a number the type argument fixes outright and is not asked about.
length_arithmetic(a: &Analysis, scope: Scope, span: Span, len: Expr, names: Buf[string])
    *len.kind match
        Ident(_) -> return
        _ -> ()

    var found: Buf[string] = buf()

    value_params_in(len, names, &found)

    if found.is_empty() then return

    val n = found.at(0)
    val message = s"this length does arithmetic on '$n', and a type may name a value parameter but " +
                  "not compute with one — deciding that two such lengths are one type is type-level " +
                  s"arithmetic, which is a separate feature. A body may compute with '$n' freely"

    // A signature is walked here at its declaration and resolved again later; the declaration is
    // where the reader is told.
    if !a.said_around(scope, span, message) then a.fault(scope, span, message)
end length_arithmetic

// The value parameters an expression names, walking only the forms arithmetic is written in.
private value_params_in(e: Expr, names: Buf[string], out: *Buf[string])
    *e.kind match
        Ident(n) -> if holds_string(names, n) then out.push(n)
        Unary(_, operand) -> value_params_in(operand, names, out)
        Binary(_, l, r) ->
            value_params_in(l, names, out)
            value_params_in(r, names, out)
        Compare(operands, _) ->
            if operands.len() == 2
                value_params_in(operands.at(0), names, out)
                value_params_in(operands.at(1), names, out)
            end if
        Call(_, args) ->
            for arg in args
                value_params_in(arg, names, out)
        _ -> ()
end value_params_in

// A TYPE parameter written where a length belongs (`f[T](xs: [T]int)`). A length is a value, and a
// parameter standing for one is declared `const`.
length_not_a_type(a: &Analysis, scope: Scope, span: Span, len: Expr, types: Buf[string])
    *len.kind match
        Ident(n) ->
            if holds_string(types, n) then
                a.fault(scope, span, s"'$n' is a type parameter, and an array's length is a value " +
                        s"rather than a type — a parameter that stands for a length is declared " +
                        s"'const $n: usize'")
        _ -> ()
end length_not_a_type

private declared_pack(a: &Analysis, scope: Scope, span: Span, tparams: Buf[string],
                      packs: Buf[string], n: string)
    if holds_string(packs, n) then return

    if holds_string(tparams, n)
        a.fault(scope, span, s"'$n' stands for one type, and '(..$n)' spreads a list of them — a " +
                s"parameter that stands for a list is declared '..$n'")
    else
        a.fault(scope, span, s"'..$n' names no type pack — a pack is declared in the parameter " +
                s"list, as '[..$n]'")
end declared_pack

// Where a `va_list` may stand in a signature (`reference/ffi.md § Handing a walk on`).
//
// In a **sysl** signature a walk is handed on **by address**: `*va_list` is the parameter type, and
// `&ap` is what the caller writes. A bare `va_list` parameter is refused because a parameter is a
// by-value binding and a copy of a walk is not a walk -- advancing it would advance nothing the
// caller could see, which is the one thing the form exists to do.
//
// An **`extern`** transcribes a C header, so it is written in C's spellings and both are allowed:
// `va_list` is C's by-value parameter, the one `vprintf` takes, and `*va_list` is C's `va_list *`.
// What a call hands the first of those is a different thing on every target and is `TVaPass`'s
// business; the call writes `&ap` for either, because the address is the only thing sysl has and it
// is what both are formed from.
//
// **Returning a bare `va_list` is refused everywhere**, foreign or not: sysl has no by-value
// `va_list` at all -- the type names the storage a walk lives in -- so there would be nothing to put
// the result in. A `*va_list` return is an ordinary pointer and is allowed.
private check_va_list_positions(a: &Analysis, scope: Scope, name: string, params: Buf[Param],
                                ret: Option[TypeRef], foreign: bool)
    if !foreign
        for p in params.view()
            if written_va_list(p.typ) then
                a.fault(scope, p.span, "a va_list is a parameter as '*va_list', not as 'va_list' " +
                        "— a parameter is a by-value binding, and a copy of a walk advances " +
                        s"nothing '$name''s caller can see, so the walk is handed over by address " +
                        "and the call writes '&ap'")

    ret match
        None -> ()
        Some(r) ->
            if written_va_list(r) then
                a.fault(scope, r.span, s"a va_list cannot be returned from '$name' — the type " +
                        "names the storage a walk lives in, and there is no value of it to hand " +
                        "back")
end check_va_list_positions

// A type written as the bare word `va_list`, which is the one spelling either rule is about: a
// `*va_list` is an ordinary raw pointer and is refused nowhere.
written_va_list(t: TypeRef) -> bool = *t.kind match
    NamedType(n, args) -> n == "va_list" && args.is_empty()
    _ -> false

// The symbol an `extern` names, which is its link name where it gave one and its own name otherwise.
extern_symbol(d: ExternDecl) -> string = d.link match
    Some(sym) -> sym
    None -> d.name

// Registers a function, which may be one of a set: two of a name are legal where a call can tell
// them apart by its arguments, and are the same declaration written twice where it cannot.
private hoist_func(a: &Analysis, scope: Scope, span: Span, d: FuncDecl)
    val plain = module_qualify(scope.module_name, d.name)

    // **Overloads are counted off whichever key this FILE's declarations of the name share**, which
    // is why the private slot is worked out first. Counting them off the plain key alone would file
    // a file that declares one spelling twice, privately, beside a sibling contending it under one
    // slot -- and the second would overwrite the first. Every question below is asked of that key:
    // a declaration in a slot of its own shadows what the plain key holds rather than contending
    // with it.
    val base = decl_key(a, scope, plain, d.vis)
    val holder = value_name_holder(a, base)

    if holder.is_some() then
        a.fault(scope, span, s"'${d.name}' is already declared as ${holder.unwrap()}")
        return

    if a.tables.externs.has(base) then
        a.fault(scope, span, s"'${d.name}' is already declared as an 'extern', which this would " +
                "overload — what tells overloads of an 'extern' apart is the symbol each names, " +
                "and a sysl function declares no symbol")
        return

    // **Every declaration already in the set is one some call site sees beside this one**: a
    // file-private declaration that another file's declaration of the spelling contends with is
    // filed under a slot of its own (`decl_key`), so the only private declarations left in a set
    // are its own file's.
    val siblings = overload_keys(a, base)

    // **`main` does not overload**: nothing calls it, so there is no call site to choose between two,
    // and a second would be filed under a key of its own and silently never run. Asked before the
    // pair is compared, since whichever way the two differ the answer is the same.
    if d.name == "main" && !siblings.is_empty()
        a.fault(scope, span, "'main' is where a program starts, so there is one — a second " +
                "declaration of it would overload the name, and a program has one beginning rather " +
                "than a set of them")
        return

    var clash = false

    for item in siblings
        val other = a.tables.funcs.get(item)

        if other.is_some() then
            if same_params(d.params, other.unwrap().decl.params) then
                a.fault(scope, span, s"function '${d.name}' is already declared" +
                        differing_result(d, other.unwrap().decl))
                clash = true
            else if overlapping(d, other.unwrap().decl) then
                a.fault(scope, span, indistinguishable(plain, d, other.unwrap().decl))
                clash = true

    if clash then return

    // **The slot is one-based**, so the second declaration of a name is `f.2` and never `f.1`.
    // It is the key an object file and a diff both read, so the two compilers have to spell it the
    // same way; the typed differential proof is what found this.
    val key = if siblings.is_empty() then base else s"$base.${siblings.len() + 1}"
    var set: Buf[string] = buf()

    for item in siblings
        set.push(item)

    set.push(key)
    a.tables.overloads.put(base, set)
    a.tables.funcs.put(key, Func(d, span, scope))

    if d.const_fn then a.tables.const_fns.put(key, true)

    record_access(a, scope, span, key, d.vis)
    check_signature_rules(a, scope, span, d.name, d.params, d.ret_type, d.variadic, false)
    check_pack_spellings(a, scope, span, d.tparams, d.tpacks, d.tvalues, d.params, d.ret_type)

    if test_only_file(a, scope.src.name) then a.tables.test_only.push(key)

    if d.test.is_some() then runner_signature(a, scope, d.test.unwrap().span, d, "test")

    if d.hook.is_some()
        val h = d.hook.unwrap()

        runner_signature(a, scope, h.span, d, hook_word(h.kind))
        second_hook(a, scope, h, key)
end hoist_func

// **A module writes at most one hook of each kind**: two would both have to run at the same moment,
// and nothing decides in which order -- not a detail a program could work around, since what a setup
// leaves behind is what the test finds. The second is refused, and the message names the first,
// because "where is the other one" is the reader's question. A question about the MODULE rather than
// the declaration, so it is asked of every function already hoisted, which is declaration order.
private second_hook(a: &Analysis, scope: Scope, h: HookAttr, key: string)
    for i in 0..<a.tables.funcs.len()
        val other_key = a.tables.funcs.key_at(i)
        val other = a.tables.funcs.at(i)

        if other_key != key && module_of(other_key) == scope.module_name && other.decl.hook.is_some()
            val first = other.decl.hook.unwrap()

            if first.kind == h.kind
                val line = other.scope.src.locate(first.span.start).line
                val named = s"'${module_show(scope.module_name)}'"
                val owner = if scope.module_name == ModuleRoot then "this one" else named

                a.fault(scope, h.span, s"a module writes at most one '@${hook_word(h.kind)}', and " +
                        s"$owner already has one — '${module_bare(other_key)}' at " +
                        s"${other.scope.src.name}:$line, and now '${module_bare(key)}'. Both would " +
                        "run at the same moment, and nothing says in which order; write one hook " +
                        "and have it call what it needs")
                return
            end if
end second_hook

// What a `@test` -- and each of the four hooks, held to the same rules for the same reason -- has to
// look like, checked at the declaration.
//
// **The runner calls it with nothing and reads the answer off whether it came back**, which is what
// both of these say from different sides: a parameter is something the runner has no value for, and
// a type parameter leaves nothing to call at all, a generic having no compiled form until a caller
// fixes its arguments.
//
// A variadic tail needs no case of its own -- a function that could take one has taken a named
// parameter in front of it and is refused by the first.
//
// **Reported at the ATTRIBUTE rather than at the signature**, because the attribute is the part that
// is wrong: the function is a perfectly good function, and `@test` is what made a promise about it
// that it cannot keep.
private runner_signature(a: &Analysis, scope: Scope, at: Span, d: FuncDecl, what: string)
    if !d.params.is_empty()
        a.fault(scope, at, s"a '@$what' function takes no parameters, and '${d.name}' takes " +
                (if d.params.len() == 1 then "one" else str(d.params.len())) +
                " — 'sysl test' calls it with nothing, so there is nowhere for an argument to " +
                "come from")
        return
    end if

    if !d.tparams.is_empty()
        a.fault(scope, at, s"a '@$what' function has no type parameters, and '${d.name}' declares " +
                s"'${joined(d.tparams, ", ")}' — a generic is compiled for the arguments a caller " +
                "fixes, and the runner supplies none")

// The key a declaration is filed under: the module's plain one, unless this declaration is
// **file-private** and another file of the module also declares the spelling -- in which case it
// takes a numbered private slot of its own (`reference/modules.md § A file-private name is scoped to
// its file`).
//
// **A file-private declaration steps aside from the plain key whenever another file has a claim on
// it**:
//
// - **a wider declaration of the spelling in another file** -- public, or a `private[M]` -- asked
//   FIRST, and asked of `wider` rather than of the tables, because the wider one may not have been
//   hoisted yet. The plain key is what every other file and every importer resolves, so it belongs to
//   the declaration they can see, and the private one *shadows* it only inside its own file: C's
//   `static` beside an `extern` of the same name in another translation unit;
// - **another file's file-private declaration already holding the key**, where the first file keeps
//   it and this one takes a slot, since neither can see the other.
//
// Nothing holds the key and nothing wider is coming: this declaration takes it, and the claim is
// recorded so that its own file resolves to it. Something holds it from **this** file: the plain key
// comes back and the caller's duplicate check reports it -- one file declaring a spelling twice,
// whatever the two visibilities, is the ordinary duplicate.
//
// "Holding the key" is asked of the access table, which every namespace shares: a sibling's
// file-private struct and this file's file-private const of one spelling live in different tables,
// but a key has one `Access`, so sharing the plain key would let the later file's overwrite the
// earlier's and refuse each file its own declaration.
private decl_key(a: &Analysis, scope: Scope, plain: string, vis: Visibility) -> string
    if !is_file_private(vis) then return plain

    val mine = file_slot_key(scope.src.name, plain)
    val claimed = a.tables.file_private.get(mine)

    // A second declaration of the spelling in THIS file is an ordinary duplicate, and has to arrive
    // at the same key for the check above to see it as one.
    if claimed.is_some() then return claimed.unwrap()

    val shadows = a.tables.wider.has(plain) && !a.tables.wider.has(mine)
    val held = a.tables.access.get(plain)
    var key = plain

    if shadows || held.is_some() && is_file_private(held.unwrap().vis) &&
            held.unwrap().file != scope.src.name
        var n: usize = 1

        while a.tables.access.has(s"$plain.private$n")
            n = n + 1

        key = s"$plain.private$n"
    end if

    a.tables.file_private.put(mine, key)
    key
end decl_key

// Records what one top-level declaration makes nameable beyond its own file -- public, or
// `private[M]` -- for `decl_key` (`wider`): the plain key, and the plain key held with the file
// that wrote it.
//
// **An enum's variants are not recorded**, only the enum: a struct and a variant of one name never
// contended -- they coexist, and the expected type chooses at each use -- so a variant is not a
// declaration the shadowing rule is about, and a file-private struct beside a sibling file's public
// variant of its name keeps the plain key it always had.
private note_wider(a: &Analysis, scope: Scope, s: Stmt)
    *s.kind match
        StructDecl(d) -> note_wider_name(a, scope, d.name, d.vis)
        EnumDecl(d) -> note_wider_name(a, scope, d.name, d.vis)
        TraitDecl(d) -> note_wider_name(a, scope, d.name, d.vis)
        TypeDecl(d) -> note_wider_name(a, scope, d.name, d.vis)
        CTypeBlock(ts) ->
            for item in ts
                note_wider_name(a, scope, item.name, item.vis)
        CConstBlock(cs) ->
            for item in cs
                note_wider_name(a, scope, item.name, item.vis)
        ConstDecl(name, _, _, vis) -> note_wider_name(a, scope, name, vis)
        ValDecl(name, _, _, vis, _, _) -> note_wider_name(a, scope, name, vis)
        VarDecl(name, _, _, vis, _, _, _) -> note_wider_name(a, scope, name, vis)
        ExternVarDecl(name, _, _, vis) -> note_wider_name(a, scope, name, vis)
        ExternDecl(d) -> note_wider_name(a, scope, d.name, d.vis)
        FuncDecl(d) -> note_wider_name(a, scope, d.name, d.vis)
        StaticDecl(inner) -> note_wider(a, scope, inner)
        _ -> ()
end note_wider

private note_wider_name(a: &Analysis, scope: Scope, name: string, vis: Visibility)
    if is_file_private(vis) then return

    val plain = module_qualify(scope.module_name, name)

    a.tables.wider.put(plain, true)
    a.tables.wider.put(file_slot_key(scope.src.name, plain), true)

// How a file and a spelling are held as one key, so that the claims of one name by several files are
// one table rather than a table of tables. A file's name cannot hold a newline and a key cannot
// either, so nothing else can be spelled this way.
file_slot_key(file: string, plain: string) -> string = s"$file\n$plain"

// The key a name written in this file resolves to before the module's plain one is tried -- this
// file's own file-private declaration of it, where it has one.
file_private_key(a: &Analysis, file: string, plain: string) -> string =
    a.tables.file_private.get(file_slot_key(file, plain)).unwrap_or(plain)

// The keys the declarations of one name are filed under.
overload_keys(a: &Analysis, plain: string) -> Buf[string] = a.tables.overloads.get(plain) match
    Some(set) -> set
    None -> buf()

// The keys the `extern` declarations of one name are filed under, in the order they were written.
//
// **Read off the table rather than kept beside it**: the first takes the plain key and each one
// after it the next numbered slot, and a declaration that was refused took none, so the slots of a
// name are always a run with no gap in it.
extern_overloads(a: &Analysis, plain: string) -> Buf[string]
    var out: Buf[string] = buf()

    if !a.tables.externs.has(plain) then return out

    out.push(plain)

    var n: usize = 2

    while a.tables.externs.has(s"$plain.$n")
        out.push(s"$plain.$n")
        n += 1

    out
end extern_overloads

private is_file_private(v: Visibility) -> bool = v match
    File -> true
    _ -> false

// Whether two parameter lists are written the same way, which is what makes a pair a duplicate
// rather than an overload set that needs distinguishing.
private same_params(a: Buf[Param], b: Buf[Param]) -> bool
    if a.len() != b.len() then return false

    for i in 0..<a.len()
        if type_text(a.at(i).typ) != type_text(b.at(i).typ) then return false

    true
end same_params

// Whether a call could fit both declarations: the arities they accept overlap, and the parameters up
// to the shorter of the two are written the same way. **Compared as written rather than as
// resolved**: hoisting has not resolved a generic parameter's type, and the written form is what a
// reader is looking at.
overlapping(d: FuncDecl, other: FuncDecl) -> bool =
    overlapping_lists(d.params, d.variadic, other.params, other.variadic)

// The same question asked of two parameter lists, which is all an `extern` has to be asked about.
private overlapping_lists(ps: Buf[Param], variadic: bool, others: Buf[Param],
                          other_variadic: bool) -> bool
    val lo = max_usize2(required(ps), required(others))
    val hi = min_usize2(accepted(ps, variadic), accepted(others, other_variadic))

    if lo > hi then return false

    val n = min_usize2(lo, min_usize2(ps.len(), others.len()))

    for i in 0..<n
        if type_text(ps.at(i).typ) != type_text(others.at(i).typ) then return false

    true
end overlapping_lists

private required(ps: Buf[Param]) -> usize
    var n: usize = 0

    for item in ps
        if item.default.is_none() then n += 1

    n
end required

private accepted(ps: Buf[Param], variadic: bool) -> usize =
    if variadic then 4294967295 else ps.len()

private max_usize2(a: usize, b: usize) -> usize = if a > b then a else b
private min_usize2(a: usize, b: usize) -> usize = if a < b then a else b

// The half of the duplicate message that is worth finishing where the two results differ, because
// that is the pair a reader wrote on purpose and expected to work.
private differing_result(d: FuncDecl, other: FuncDecl) -> string =
    differing_results(d.ret_type, other.ret_type)

private differing_results(ret: Option[TypeRef], other: Option[TypeRef]) -> string =
    if written_result(ret) == written_result(other) then ""
    else " — which declaration a call means is decided by its arguments and never by what it " +
        "returns, so two that differ only in the result have no call that tells them apart"

private written_result(ret: Option[TypeRef]) -> string = ret match
    Some(t) -> type_text(t)
    None -> ""

private indistinguishable(plain: string, d: FuncDecl, other: FuncDecl) -> string =
    indistinguishable_lists(plain, d.params, other.params)

private indistinguishable_lists(plain: string, ps: Buf[Param], others: Buf[Param]) -> string
    val n = min_usize2(max_usize2(required(ps), required(others)),
                       min_usize2(ps.len(), others.len()))

    s"'${qualified_name(plain)}' is already declared with parameters this one could not be told from — " +
    s"a call passing $n argument${if n == 1 then "" else "s"} would fit both, and which " +
    "declaration a call means is decided by its arguments and never by what it returns. Two " +
    "declarations of one name have to differ in a way a call site can show"
end indistinguishable_lists

// Files every type a `@tests` file declares under that file's name: a struct, an enum, a trait and
// a `new` type. A transparent alias is left out, since it is another spelling of a type declared
// somewhere else.
private note_test_file_types(a: &Analysis, unit: Program)
    for item in unit.body
        val name = *item.kind match
            StructDecl(d) -> d.name
            EnumDecl(d) -> d.name
            TraitDecl(d) -> d.name
            TypeDecl(d) -> if d.derived then d.name else ""
            _ -> ""

        if name != "" then a.tables.test_file_types.push(s"${unit.src.name}\0$name")
end note_test_file_types

// What an `impl` is for, said as the reason it is not a type its `@tests` file declares.
private impl_subject(d: ImplDecl) -> string = *d.for_type.kind match
    NamedType(name, _) ->
        if holds_string(d.tparams, name)
            s"'$name' is a parameter of the block, which stands for every type at once"
        else
            s"'$name' is not declared in it"
    _ -> "the type this one is for is not declared in it"

// Whether an `impl` written in the file `src` is for a type that same file declares. Only a plain
// name can be one: a type parameter of the block stands for every type, a pointer or a slice is a
// type no file declares, and a dotted name reaches another module.
private impl_subject_local(a: &Analysis, src: string, d: ImplDecl) -> bool = *d.for_type.kind match
    NamedType(name, _) ->
        !holds_string(d.tparams, name) && holds_string(a.tables.test_file_types, s"$src\0$name")
    _ -> false

// Whether the file a scope belongs to said `@tests`, so that what it declares is the module's tests'
// and no build but a test build keeps it.
// Whether a file is one that said `@tests`, which is what makes everything it declares scaffolding.
test_only_file(a: &Analysis, name: string) -> bool
    for item in a.tables.test_only_files
        if item == name then return true

    false
end test_only_file
