module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.Search

// The context an expression is typed in: the declaration tables the whole compilation shares, the
// file's own terms, and the names in scope where the expression stands.
//
// **The declaration tables are read here and never written.** What this adds is everything that is
// true of one *place* rather than of the program: which locals a reader can name, what `Self` and a
// type parameter stand for, and which function's `result` and `__FUNCTION__` are being asked about.
//
// **There are no exceptions in sysl**, so the reference compiler's `err` -- which throws and is
// caught by a `recover` -- is written out the way the declaration pass writes it: `fault` records
// the diagnostic and the caller answers with a node of type `Unknown`, which every rule downstream
// agrees with so that one mistake is reported once.

// One name a scope binds: what the reader wrote, the unique name the frame holds it under, and
// what it is.
//
// **The two names are separate because a block may rebind one.** A scope gives every binding a name
// nothing else has, and the typed tree loads through that; the written name is only what a lookup
// matches.
struct Local
    name: string
    unique: string
    ty: Type

    // Whether a write to the name is refused, and whether the refusal is a **pattern's** rather
    // than a `val`'s. A pattern binding holds a copy of the part it matched, so a write to it would
    // land where nothing could observe it -- which is a different sentence from "a 'val' is
    // written once", and the reader of an arm wrote no `val`.
    read_only: bool
    from_pattern: bool
end Local

// One loop, while its body is being read.
//
// **It is reached through `&` because a `break` writes into it from wherever it stands.** A loop's
// result type is met from what its breaks carried and what its `else` yields, so the body has to be
// able to reach the loop it is inside.
struct LoopCtx
    // What a `break` in this loop is read at -- the loop's own position's expectation.
    expected: Option[Type]
    label: Option[string]
    break_tys: Buf[Type]

    // The measure the body declared at its head, taken once the body is read.
    variant: Option[(string, Type)]
end LoopCtx

// A loop with nothing broken out of it yet.
loop_ctx(expected: Option[Type], label: Option[string]) -> &LoopCtx =
    LoopCtx(expected, label, buf(), None)

// Everything typing one expression needs.
struct Analyzer
    an: &Analysis
    scope: Scope

    // The names in scope, innermost last, with `marks` holding where each open scope began.
    locals: Buf[Local]
    marks: Buf[usize]

    // What a type parameter stands for while a generic body is read.
    subst: Buf[Binding]

    // The function the expression is written in: what `__FUNCTION__` answers, and what `result`
    // and a bare `return` mean. Empty and `None` outside any body, which is the honest answer for
    // a module's own storage.
    func_name: string
    ret_ty: Option[Type]

    // Where a built-in that reports its own place says it stands. It is the node's own span
    // everywhere except while a parameter's default is filled in, where it is the call's.
    reported: Option[Span]

    // Whether a mistake has already been reported about the expression being read, which is what
    // keeps a consequence from being reported as a second cause.
    poisoned: bool

    // Every unique name this **function** has handed out, whichever scope it was in.
    //
    // **It is per-function rather than per-scope, which is what the typed tree records.** Two
    // sibling blocks each binding an `x` are two slots of one frame, so the second is `x.1` even
    // though neither is in scope while the other is -- and a diff against the reference compiler is
    // a diff on those names.
    used: Buf[string]

    // The loops open around the expression being read, innermost first.
    loops: Buf[&LoopCtx]

    // Whether the function declares a **result list** rather than one result, which is what lets a
    // `return a, b` and a block's trailing `a, b` stand.
    ret_is_list: bool

    // Whether the body being read is a `for const`'s, which has no loop at run time for a `break`
    // or a `continue` to act on.
    in_const_for: bool

    // The measure a loop body declared, waiting for the loop that will carry it, and the counter
    // that gives each one a slot nothing else holds.
    pending_variant: Option[(string, Type)]
    variant_seq: int

    // What an `ensure`'s `result` stands for, and the `old(e)` expressions one collected. Both are
    // live only while a postcondition is read.
    ensure_result: Option[Type]
    olds: Option[Buf[TExpr]]

    // The names **this** pattern has bound so far, and whether one is already being walked.
    //
    // A pattern is one binding form however deeply it nests, so a name written twice inside it is a
    // name written twice rather than a shadow -- which is what the ordinary scope machinery cannot
    // see, every binding of a pattern declaring into the arm's one scope.
    bound_in_pattern: Buf[string]
    walking_pattern: bool

    // Whether **this** expression is one of the three places a result list may stand: the right
    // side of a binding, the right side of a multiple assignment, and the value of a function whose
    // own declared result is a list. It is taken and spent at the top of `type_expr`, which is what
    // confines it to one expression -- every subexpression goes through the same funnel and finds
    // it already gone.
    multi_ok: bool

    // Whether the function being read was declared with `...`, which is the one thing that makes a
    // `va_start` mean anything: there is no tail to walk in a function that takes no variadic one.
    in_variadic: bool

    // Opens a scope.
    enter(*self)
        self.marks.push(self.locals.len())

    // Closes the innermost scope, taking its bindings with it.
    leave(*self)
        if self.marks.is_empty() then return

        val mark = self.marks.at(self.marks.len() - 1)

        self.marks.truncate(self.marks.len() - 1)
        self.locals.truncate(mark)

    // Binds a name in the innermost scope, under a unique name of its own.
    bind(*self, name: string, ty: Type) -> string
        val unique = self.fresh_name(name)

        self.locals.push(Local(name, unique, ty, false, false))
        unique
    end bind

    // Binds a name that may not be assigned to again -- what a local `val` declares.
    bind_read_only(*self, name: string, ty: Type) -> string
        val unique = self.fresh_name(name)

        self.locals.push(Local(name, unique, ty, true, false))
        unique
    end bind_read_only

    // Binds a name a **pattern** captured, which is written once for the reason a `val` is and
    // says so in its own words.
    bind_pattern(*self, name: string, ty: Type) -> string
        val unique = self.fresh_name(name)

        self.locals.push(Local(name, unique, ty, true, true))
        unique
    end bind_pattern

    // Binds a name under a unique name the caller chose, which is what a parameter needs: a
    // parameter is loaded by the name its declaration gave it.
    bind_as(*self, name: string, unique: string, ty: Type)
        self.locals.push(Local(name, unique, ty, false, false))

    // A name nothing else in this **function** holds, which is what a slot of the frame is.
    //
    // A name the compiler made for itself starts with the module separator and is left alone;
    // everything else has any `$` in it marked, so that two names a reader wrote between backticks
    // cannot collide under the encoding the emitter applies.
    fresh_name(*self, base: string) -> string
        val safe = if base.starts_with("$") then base else guarded(base)

        if !self.holds(safe)
            self.used.push(safe)

            return safe
        end if

        var k = 1

        while self.holds(s"$safe.$k")
            k = k + 1

        val n = s"$safe.$k"

        self.used.push(n)
        n
    end fresh_name

    private holds(self, name: string) -> bool
        for i in 0..<self.used.len()
            if self.used.at(i) == name then return true

        false
    end holds

    // The innermost binding of a name, or none.
    lookup(self, name: string) -> Option[Local]
        var i = self.locals.len()

        while i > 0
            i = i - 1

            if self.locals.at(i).name == name then return Some(self.locals.at(i))

        None
    end lookup

    // Records a mistake about a place.
    fault(*self, span: Span, message: string)
        self.an.fault(self.scope, span, message)

    // Records a mistake and answers with the node every rule downstream agrees with.
    err(*self, span: Span, message: string) -> TExpr
        self.fault(span, message)
        self.poisoned = true
        bad_expr(span)
    end err

    // Everything said so far, in the order a reader reads it.
    messages(self) -> Buf[string]
        var out: Buf[string] = buf()
        val ds = self.an.diagnostics()

        for i in 0..<ds.len()
            out.push(ds.at(i).diag.message)

        out
    end messages
end Analyzer

// The node a failed reading answers with. Its type is `Unknown`, which `disagree` treats as
// agreeing with everything so that the consequences of one mistake say nothing more.
bad_expr(span: Span) -> TExpr = TExpr(span, TZero(Unknown))

// An analyzer over a compilation's tables, reading a file in its own terms.
analyzer_for(an: &Analysis, scope: Scope) -> &Analyzer =
    Analyzer(an, scope, buf(), buf(), buf(), "", None, None, false, buf(), buf(), false, false,
             None, 0, None, None, buf(), false, false, false)

// A `$` written by a reader is marked, so that `` `a b` `` and `` `a$20b` `` cannot become one
// register once the emitter encodes the space.
private guarded(name: string) -> string
    if !name.contains("$") then return name

    var out = ""

    for c in name.chars
        out = out + (if c == '$' then "$24" else s"$c")

    out
end guarded

// Whether a value of one type genuinely cannot stand where another was asked for.
//
// **A type that could not be worked out agrees with everything**, in either direction: the mistake
// that produced it has been reported, and a second complaint about what it fails to match is noise
// about a consequence. A `never` agrees in one direction only -- it may stand anywhere, because
// control does not reach the place the value would have been used, and nothing may stand for it.
disagree(got: Type, want: Type) -> bool =
    !type_eq(repr(got), repr(want)) && got != Unknown && want != Unknown && got != Never

// The one type two alternatives meet at -- the branches of an `if`, the arms of a `match` -- or
// none where they have none.
//
// The only interesting case is `never`: an alternative that does not finish constrains nothing, so
// it takes the other side's type. Everything else must already agree, since sysl has no subtyping
// among concrete types to widen towards -- except the two views of one slice, which are one type
// with a bit and meet at the read-only one.
join_types(a: Type, b: Type) -> Option[Type]
    if type_eq(a, b) then return Some(a)
    if a == Never then return Some(b)
    if b == Never then return Some(a)
    if type_eq(repr(a), repr(b)) then return Some(repr(a))
    if type_eq(const_view(a), const_view(b)) then return Some(const_view(a))

    None
end join_types

// The scalar a name spells, over both families: the words a program writes plainly (`int`, `byte`,
// `real`) and the widths written as a letter and digits (`u8`, `i16`, `f32`).
//
// **A width whose number is wrong is a diagnostic rather than a fall-through**, which is
// `width_type`'s rule and the reason the two are asked together here rather than at each site.
scalar_type_named(cx: &Analyzer, span: Span, name: string) -> Option[Type]
    val plain = scalar_named(name, word_bits(cx))

    if plain.is_some() then return plain

    width_type(cx.an, cx.scope, span, name)
end scalar_type_named

// What a function declaring several results actually hands back: the tuple they lay out as.
//
// **A result list is a *written* shape rather than a type**, so nothing downstream ever holds one --
// the analyzer unwraps it at the signature, exactly as the reference compiler does, and the caller
// that takes the results apart sees the tuple.
result_type(t: Type) -> Type = t match
    Results(parts) -> Struct(parts)
    _ -> t

// How wide a pointer is on the target this compilation is for, which is what a `usize` and an
// address-shaped conversion are measured in.
word_bits(cx: &Analyzer) -> int = int(cx.an.tables.layout.word_bits)
