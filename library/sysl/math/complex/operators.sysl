module sysl.math.complex

import sysl.math.Float
import sysl.math.Magnitude

// The operators a `Complex` answers to, how it renders, and how big it is.
//
// They are here rather than in `complex.sysl` because they are `impl` blocks rather than members of
// the type's own body -- the same split every type in the library makes, and the reason the file is
// short while the one beside it is not.
//
// **Each of the four arithmetic operators is written twice: once for another complex number and
// once for a real.** The complex numbers are a vector space over the reals, and scaling is the
// operation a transform performs most often -- every sample of an inverse, every window function,
// every spectrum read in decibels. `z * k` where `k` is a real is the same answer as `z *
// Complex(k, 0)` and costs a quarter as much, so it is `Mul` at a second argument list rather than
// a second trait (`reference/traits.md § One implementation per argument list`). Which of the two a
// `*` means is settled by the type of its right operand.
//
// **There is no `Ord`.** The complex numbers are not ordered -- no order on them is compatible with
// the arithmetic -- and `library/core.md § What is in it` keeps `Eq` and `Ord` independent traits
// precisely so that a type can have the one without the other. There is nothing to opt out of.
//
// **There is no scalar on the left.** `2.0 * z` would need an `impl Mul[Complex[F]] for F`, which is
// an implementation of a library trait for a built-in written by the module that owns neither -- and
// it would be one implementation per width rather than one generic block, since `F` is a parameter
// and not a type an `impl` may be written for. `z * 2.0` is the same product.

/** The two identities, which `Float` itself requires and which a generic body reaches through a bound
 * rather than through the type's own members. `zero` is where an accumulator starts and `one` is
 * where a product does, and neither can be written as a literal in a body that does not know the
 * width it is holding.
 */
impl[F: Float] Zero for Complex[F]
    zero() -> Complex[F] = Complex(F.zero(), F.zero())

impl[F: Float] One for Complex[F]
    one() -> Complex[F] = Complex(F.one(), F.zero())

impl[F: Float] Add for Complex[F]
    add(self, rhs: Complex[F]) -> Complex[F] = Complex(self.re + rhs.re, self.im + rhs.im)

impl[F: Float] Add[F] for Complex[F]
    add(self, k: F) -> Complex[F] = Complex(self.re + k, self.im)

impl[F: Float] Sub for Complex[F]
    sub(self, rhs: Complex[F]) -> Complex[F] = Complex(self.re - rhs.re, self.im - rhs.im)

impl[F: Float] Sub[F] for Complex[F]
    sub(self, k: F) -> Complex[F] = Complex(self.re - k, self.im)

impl[F: Float] Mul for Complex[F]
    mul(self, rhs: Complex[F]) -> Complex[F] =
        Complex(self.re * rhs.re - self.im * rhs.im, self.re * rhs.im + self.im * rhs.re)

impl[F: Float] Mul[F] for Complex[F]
    mul(self, k: F) -> Complex[F] = Complex(self.re * k, self.im * k)

/** **Smith's algorithm, and not `(ac + bd) / (c*c + d*d)`.**
 *
 * The textbook quotient computes the divisor's squared magnitude, which overflows to infinity for a
 * divisor whose parts are above the square root of the largest float and underflows to zero for one
 * below the square root of the smallest -- in both cases at operands whose quotient is perfectly
 * representable, and in both cases silently. Dividing the smaller part by the larger first keeps
 * every intermediate within a factor of two of the answer's own scale, which is the whole of the
 * trick and costs one comparison.
 *
 * **A zero divisor is a NaN and not an infinity**, which is the one place the complex quotient does
 * not follow the real one. Among the reals `1/0` runs off in the only direction there is; a complex
 * quotient has an argument as well as a magnitude, and a zero divisor fixes neither -- so there is
 * no complex number to answer with, and the value meaning exactly that is what comes back. A caller
 * that has a direction in mind knows it, and `is_zero` is the test.
 */
impl[F: Float] Div for Complex[F]
    div(self, rhs: Complex[F]) -> Complex[F] =
        if rhs.re.abs() >= rhs.im.abs() then scaled_by_re(self, rhs) else scaled_by_im(self, rhs)

impl[F: Float] Div[F] for Complex[F]
    div(self, k: F) -> Complex[F] = Complex(self.re / k, self.im / k)

impl[F: Float] Neg for Complex[F]
    neg(self) -> Complex[F] = Complex(-self.re, -self.im)

impl[F: Float] Eq for Complex[F]
    eq(self, rhs: Complex[F]) -> bool = self.re == rhs.re && self.im == rhs.im

/** The four pieces of `a+bi`, written straight through to wherever they are going. The sign of the
 * imaginary part is always written out, so a negative one reads `3-4i` and never `3+-4i`, and the
 * magnitude is what follows it.
 *
 * The parts take the caller's precision and none of its width: a precision is what each renderer
 * reads in its own terms, and what `%.3s` on a complex number means is three significant digits in
 * each half of it. The width belongs to the whole value and is applied by the block below.
 */
private render_complex[F: Float + Display](z: Complex[F], out: *Writer, parts: FormatSpec)
    val negative = z.im < F.zero()
    val magnitude = if negative then -z.im else z.im

    z.re.display(out, parts)
    out.write(if negative then "-".bytes else "+".bytes)
    magnitude.display(out, parts)
    out.write("i".bytes)
end render_complex

/** `a+bi`, with the sign of the imaginary part written out and never a `+-`.
 *
 * **The field applies to the whole value and not to each part** (`library/core.md § A specifier is
 * the whole value's field`), so the four pieces are padded once between them rather than each in
 * turn. Padding each piece would put spaces inside the number.
 *
 * **It is measured rather than gathered, and that is the whole of why it allocates nothing.** The
 * obvious way to pad a compound rendering once is to build the text and hand the finished bytes to
 * `display_pad`, and that is three intermediate strings a `Complex` printed in a loop pays for every
 * value. Running the same writes into a `Counting` sink answers the same question -- how wide did it
 * come out -- and stores nothing. A rendering with no width asked for never builds the sink at all,
 * so the ordinary print costs one pass.
 *
 * **It does not follow that this module can declare `@no_alloc`, and it cannot.** A call through
 * `*Writer` is judged against every `impl Writer` linked into the compilation, and `sysl.buf`'s
 * `ByteSink` allocates -- so writing into a sink at all is refused under the clause wherever a
 * growable buffer is in the program. That is a question about the clause rather than about
 * rendering, and it is open.
 *
 * The bound is `Float + Display` rather than `Float`, because rendering a part means asking `F` for
 * its own rendering and `Float` does not require one. Both widths have it, so nothing a program can
 * reach is excluded -- the compound bound is what says why.
 */
impl[F: Float + Display] Display for Complex[F]
    display(self, out: *Writer, fmt: FormatSpec)
        val parts = FormatSpec(0, fmt.prec, false)
        var pad = 0

        // Measured only when a width was asked for, so the ordinary print costs one pass.
        if fmt.width > 0
            var count = Counting(0)
            var sink: *Writer = &count

            render_complex(self, sink, parts)
            pad = fmt.width - int(count.n)

            if pad < 0 then pad = 0

        if !fmt.left then display_fill(out, 32, pad)

        render_complex(self, out, parts)

        if fmt.left then display_fill(out, 32, pad)
    end display

/** The modulus, as the trait that asks every type for its size. `Complex[F]` measures in `F` — the
 * modulus of a complex number is a *real* number however the parts are stored — which is the case
 * `Magnitude` carries an associated type for: no implementation could have answered here if the
 * trait had fixed its result to the subject's own type, and fixing it to `real` would have made a
 * `Complex[f32]` widen every comparison.
 *
 * It is the type's own `abs` and nothing more. What the trait adds is that a generic body can *ask*:
 * a routine bounded by `[T: Magnitude]` compares sizes without naming what they come out at, which
 * is what lets one elimination run over the reals and over the plane.
 */
impl[F: Float] Magnitude for Complex[F]
    type Size = F
    magnitude(self) -> F = self.abs()

/** The two halves of Smith's algorithm, told apart by which part of the divisor is the larger. Each
 * divides by that part first, so the ratio it forms is at most one and nothing along the way leaves
 * the scale of the answer.
 */
private scaled_by_re[F: Float](z: Complex[F], w: Complex[F]) -> Complex[F] =
    val r = w.im / w.re
    val d = w.re + w.im * r

    Complex((z.re + z.im * r) / d, (z.im - z.re * r) / d)

private scaled_by_im[F: Float](z: Complex[F], w: Complex[F]) -> Complex[F] =
    val r = w.re / w.im
    val d = w.re * r + w.im

    Complex((z.re * r + z.im) / d, (z.im * r - z.re) / d)
