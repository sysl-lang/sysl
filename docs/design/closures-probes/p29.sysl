// The shape webview-demo/main.sysl has: a stored callback writes and reads back a capture, and the
// enclosing body reads the variable afterwards only inside an interpolated string. The read-after
// refusal does not see a read inside interpolation, so this compiles and prints 0.
import sysl.buf.{Buf, buf}

var handlers: Buf[&Fn() -> string] = buf()
var clicks = 0

handlers.push(() ->
    clicks += 1
    f"${clicks}%d")

print(handlers[0](), handlers[0]())
print(f"clicked ${clicks}%d times")
