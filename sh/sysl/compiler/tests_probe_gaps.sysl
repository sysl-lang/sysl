module sh.sysl.compiler
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// A throwaway probe: which bodies a lowering leaves out for the reference pages that do not run.

private var probe_library_cache: Buf[Program] = buf()
private var probe_library_read: bool = false

private probe_library() -> Buf[Program]
    if probe_library_read then return probe_library_cache

    probe_library_read = true

    std_root() match
        Err(_) -> ()
        Ok(root) -> std_units(root, host_target()) match
            Err(_) -> ()
            Ok(units) -> probe_library_cache = units

    probe_library_cache
end probe_library

private all_gaps(text: string) -> string
    val parsed = parse(source_of("main.sysl", text))

    if !parsed.ok() then return parsed.report.render(parsed.src)

    var units: Buf[Program] = buf()
    val library = probe_library()

    for i in 0..<library.len()
        units.push(library.at(i))

    units.push(parsed.program)

    val done = analyze_bodies(units, host_target())
    val whole = program_of(done, "")
    val promotions = post_analysis_checks(done.an, whole, buf())

    if !errors_of(done.an.diagnostics()).is_empty()
        return analysis_report(errors_of(done.an.diagnostics()))

    val p = strip_tests(whole)
    val gaps = codegen_with_gaps(p, host_target(), promotions).1
    var out = if p.entry_point then "ENTRY" else "NOENTRY"

    for i in 0..<gaps.len()
        out = s"$out | ${gaps.at(i).0} :: ${gaps.at(i).1}"

    out
end all_gaps

@test("probe v1")
probe_gaps_v1()
    assert_eq(all_gaps("var a = [2, 4, 6]\n\nprint(for all i in 0..<3 do a[i] % 2 == 0)\n"), "?")

@test("probe v5")
probe_gaps_v5()
    assert_eq(all_gaps("sum_to(n: int) -> int\n    var i = 0\n    var s = 0\n\n    while i < n\n" +
                       "        invariant i >= 0 && i <= n\n        variant n - i\n        s += i\n" +
                       "        i += 1\n\n    s\n\nprint(sum_to(5))\n"), "?")

@test("probe v20")
probe_gaps_v20()
    assert_eq(all_gaps("@ghost\npositive(n: int) -> bool = n > 0\n\nf(n: int) -> int\n" +
                       "    require n >= 0\n    require positive(n)\n    n\n\nprint(f(3))\n"), "?")

@test("probe a37")
probe_gaps_a37()
    assert_eq(all_gaps("@tailrec\ncount(n: int, acc: int) -> int =\n" +
                       "    if n == 0 then acc else count(n - 1, acc + 1)\n\nprint(count(10, 0))\n"),
              "?")

@test("probe d15")
probe_gaps_d15()
    assert_eq(all_gaps("even(n: int) -> bool\n    if n == 0 then return true\n\n" +
                       "    become odd(n - 1)\n\nodd(n: int) -> bool\n" +
                       "    if n == 0 then return false\n\n    become even(n - 1)\n\n" +
                       "print(even(10), odd(10))\n"), "?")
