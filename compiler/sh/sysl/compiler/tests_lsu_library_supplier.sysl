module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture
import sysl.text.{join, split, Search}

// The standard library supplying a seam it declares, where the library is compiled from source into
// the program (`reference/ffi.md § A module may supply another module's extern`) -- the reference's
// `LibrarySupplierCliTests`, driven through the same `run_cli` a shell reaches.
//
// `sysl.time` declares `sysl_wall_us` and `sysl.posix.time` defines it, and nothing a program writes
// imports the second. The analysis holds the library's functions back until something calls one, and
// nothing calls a supplier, so a `build-c` archive went out with `sysl_wall_us` undefined and every
// `sysl.log` call failed at the consumer's link (`seam_supply.sysl`). Every case compiles the library
// from source -- `build-c` does, and the rest say `--no-std-lib` -- except the one about the artifact.

// -- the harness ----------------------------------------------------------------------------------

private lsu_ready() -> bool
    if std_root().is_err()
        print("skipped: the standard module's source is not on this machine")
        return false
    end if

    if !clang_available()
        print("skipped: there is no clang on this machine")
        return false
    end if

    true
end lsu_ready

// What one command line came to: the status the shell hears, and every line the driver said.
private lsu_run(args: []string) -> (int, string)
    var lines: Buf[string] = buf()
    val sink = &lines
    val code = run_cli(args, (line) -> sink.push(line))

    (code, join(lines.view(), "\n"))
end lsu_run

// An archive project: a directory holding a manifest and one entry file, as `build-c` is handed one.
private lsu_project(main: string) -> string
    val root = make_temp_dir("sysl-lsu-").unwrap()

    write_text(s"$root/package.hocon", "").unwrap()
    write_text(s"$root/main.sysl", main).unwrap()
    root
end lsu_project

// A `--lib` root holding `chip/lib.sysl`, a package that supplies the clock itself.
private lsu_chip() -> string
    val root = make_temp_dir("sysl-lsu-chip-").unwrap()

    make_dir_all(s"$root/chip").unwrap()
    write_text(s"$root/chip/lib.sysl", "module chip\n\n@export(\"sysl_wall_us\")\nwall_us() -> long = 7\n").unwrap()
    root
end lsu_chip

private lsu_asks_the_time() -> string = "import sysl.time.now\n\n@export(\"entry\")\nentry() -> long = now().us\n"

// A logger stamps every record with the wall clock, so every `sysl.log` call reaches the seam without
// the program ever naming `sysl.time`.
private lsu_logs() -> string = raw"""
    import sysl.log.info

    @export("entry")
    entry() -> i32
        info("hi", [])
        0
    """

// The LLVM text of `emit-llvm` over a project, the library compiled from source, with any further
// arguments after it -- having succeeded.
private lsu_emitted(root: string, more: []string) -> string
    var args: Buf[string] = buf()

    args.push("sysl")
    args.push("emit-llvm")
    args.push(root)
    args.push("--no-std-lib")

    for i in 0..<more.len
        args.push(more[i])

    val got = lsu_run(args.view())

    assert_eq(got.0, 0, got.1)
    got.1
end lsu_emitted

// Every symbol a line starting with `keyword` names, quotes taken off -- the reference's
// `symbols(ir, "define")` and `symbols(ir, "declare")`.
private lsu_symbols(ir: string, keyword: string) -> Buf[string]
    var names: Buf[string] = buf()
    val lines = split(ir, "\n")

    for i in 0..<lines.len
        val line = lines[i]

        if line.starts_with(s"$keyword ")
            line.index_of("@") match
                None -> ()
                Some(at) ->
                    var name = line[at + 1..<line.len]

                    name.index_of("(") match
                        Some(open) -> name = name[0..<open]
                        None -> ()

                    if name.starts_with("\"") && name.len >= 2 then name = name[1..<name.len - 1]

                    names.push(name)
    end for

    names
end lsu_symbols

private lsu_holds(xs: Buf[string], x: string) -> bool
    for item in xs
        if item == x then return true

    false
end lsu_holds

private lsu_defines(ir: string, name: string) -> bool = lsu_holds(lsu_symbols(ir, "define"), name)

private lsu_declares(ir: string, name: string) -> bool = lsu_holds(lsu_symbols(ir, "declare"), name)

// What `nm` says of one symbol in an archive: `T` where a member defines it, `U` where a member only
// refers to it. Darwin prefixes C symbols with an underscore and ELF does not, so both are read.
private lsu_kinds(archive: string, symbol: string) -> Buf[string]
    val listed = capture("nm", [archive], "", [], true).unwrap()
    val lines = split(listed.text, "\n")

    var out: Buf[string] = buf()

    for i in 0..<lines.len
        val words = split(lines[i].trim(), " ")

        var parts: Buf[string] = buf()

        for j in 0..<words.len
            if words[j] != "" then parts.push(words[j])

        if parts.len() < 2 then continue

        val name = parts.at(parts.len() - 1)

        if name == symbol || name == s"_$symbol" then out.push(parts.at(parts.len() - 2))
    end for

    out
end lsu_kinds

// `build-c` of a program, and the archive it wrote.
private lsu_archived(main: string) -> string
    val root = lsu_project(main)
    val out = s"$root/libentry.a"
    val got = lsu_run(["sysl", "build-c", root, "-o", out])

    assert_eq(got.0, 0, got.1)
    out
end lsu_archived

// A program built and run: what it printed.
private lsu_ran(src: string, more: []string) -> string
    val root = make_temp_dir("sysl-lsu-run-").unwrap()

    write_text(s"$root/main.sysl", src).unwrap()

    var args: Buf[string] = buf()

    args.push("sysl")
    args.push("build")
    args.push(root)
    args.push("-o")
    args.push(s"$root/out")

    for i in 0..<more.len
        args.push(more[i])

    val got = lsu_run(args.view())

    assert_eq(got.0, 0, got.1)

    val printed = capture(s"$root/out").unwrap().text

    remove_dir_all(root).unwrap_or(())
    printed
end lsu_ran

private lsu_now_program() -> string = "import sysl.time.now\n\nprint(now().us > 0)\n"

// -- a build-c archive carries the standard library's supplier of a seam the program calls --------

@test("a build-c archive carries the standard library's supplier, for sysl.time.now")
lsu_build_c_carries_the_supplier_for_now()
    if !lsu_ready() then return

    val found = lsu_kinds(lsu_archived(lsu_asks_the_time()), "sysl_wall_us")

    assert(lsu_holds(found, "T"), join(found.view(), ","))
    assert(!lsu_holds(found, "U"), join(found.view(), ","))
end lsu_build_c_carries_the_supplier_for_now

// The case it was found by.
@test("a build-c archive carries it for a sysl.log call, which reads the clock without the program naming it")
lsu_build_c_carries_the_supplier_for_a_log_call()
    if !lsu_ready() then return

    val found = lsu_kinds(lsu_archived(lsu_logs()), "sysl_wall_us")

    assert(lsu_holds(found, "T"), join(found.view(), ","))
    assert(!lsu_holds(found, "U"), join(found.view(), ","))
end lsu_build_c_carries_the_supplier_for_a_log_call

// Asked through `emit-llvm`, because a `build-c` for Android needs an NDK and the question is about
// what sysl emits rather than what the NDK's clang does with it.
@test("the supplier is defined for a cross target with a POSIX clock, aarch64-android")
lsu_a_cross_posix_target_gets_the_supplier()
    if !lsu_ready() then return

    val ir = lsu_emitted(lsu_project(lsu_asks_the_time()), ["--target", "aarch64-android"])

    assert(lsu_defines(ir, "sysl_wall_us"), "sysl_wall_us is defined")
    assert(!lsu_declares(ir, "sysl_wall_us"), "and not also declared")
end lsu_a_cross_posix_target_gets_the_supplier

@test("and only the supplier the program asks for")
lsu_only_the_supplier_asked_for()
    if !lsu_ready() then return

    val ir = lsu_emitted(lsu_project(lsu_asks_the_time()), [])

    assert(lsu_defines(ir, "sysl_wall_us"), "sysl_wall_us is defined")
    assert(!lsu_defines(ir, "sysl_monotonic_us"), "sysl_monotonic_us is not")
end lsu_only_the_supplier_asked_for

// The library's other seam, answered by the same rule: these two are its only suppliers.
@test("the supplier for sysl.time.monotonic, the library's other seam")
lsu_the_monotonic_supplier_alone()
    if !lsu_ready() then return

    val ir = lsu_emitted(lsu_project(
        "import sysl.time.monotonic\n\n@export(\"entry\")\nentry() -> long = monotonic().us\n"), [])

    assert(lsu_defines(ir, "sysl_monotonic_us"), "sysl_monotonic_us is defined")
    assert(!lsu_defines(ir, "sysl_wall_us"), "sysl_wall_us is not")
end lsu_the_monotonic_supplier_alone

@test("and no supplier where the program never asks the time")
lsu_no_supplier_when_unused()
    if !lsu_ready() then return

    val ir = lsu_emitted(lsu_project("@export(\"entry\")\nentry() -> long = 7\n"), [])

    assert(ir.index_of("sysl_wall_us").is_none(), "nothing names sysl_wall_us")
end lsu_no_supplier_when_unused

// -- the ordinary build, both ways ----------------------------------------------------------------

@test("an ordinary build against a standard module compiled from source links the supplier too")
lsu_a_from_source_build_links()
    if !lsu_ready() then return

    assert_eq(lsu_ran(lsu_now_program(), ["--no-std-lib"]), "true\n")
end lsu_a_from_source_build_links

// The prebuilt path, where the supplier is the artifact's and this compilation only declares it: the
// `extern` the program calls must still be declared, since the definition is in another object.
@test("a build against a prebuilt standard module still resolves the seam from the artifact")
lsu_a_prebuilt_build_resolves_the_seam()
    if !lsu_ready() then return

    assert_eq(lsu_ran(lsu_now_program(), []), "true\n")
end lsu_a_prebuilt_build_resolves_the_seam

// -- where something else supplies the seam ------------------------------------------------------

// The board's case on a POSIX target: a package binding its own clock is the one that answers, and
// the library's is a fallback rather than a second claimant to be refused.
@test("a package's supplier answers instead of the library's, with no conflict")
lsu_a_package_supplier_wins()
    if !lsu_ready() then return

    val ir = lsu_emitted(lsu_project(lsu_asks_the_time()), ["--lib", lsu_chip()])

    assert(lsu_defines(ir, "sysl_wall_us"), "sysl_wall_us is defined")
    assert(ir.index_of("sysl_posix_time_realtime_us").is_none(), "the POSIX clock is not reached")
end lsu_a_package_supplier_wins

// A freestanding target has no `posix`, so nothing in the library can answer: the seam is left
// declared for the board to supply, and the link names it -- never a POSIX clock smuggled onto a
// machine that has none.
@test("a freestanding target leaves the seam to the board")
lsu_freestanding_leaves_it_to_the_board()
    if !lsu_ready() then return

    val ir = lsu_emitted(lsu_project(lsu_asks_the_time()), ["--target", "thumb-freestanding-softfp"])

    assert(lsu_declares(ir, "sysl_wall_us"), "sysl_wall_us is declared")
    assert(!lsu_defines(ir, "sysl_wall_us"), "and not defined")
    assert(ir.index_of("sysl_posix_time_realtime_us").is_none(), "the POSIX clock is not reached")
end lsu_freestanding_leaves_it_to_the_board

@test("and a freestanding program handed a package's supplier is given that one")
lsu_freestanding_with_a_package_supplier()
    if !lsu_ready() then return

    val ir = lsu_emitted(lsu_project(lsu_asks_the_time()),
                         ["--target", "thumb-freestanding-softfp", "--lib", lsu_chip()])

    assert(lsu_defines(ir, "sysl_wall_us"), "sysl_wall_us is defined")
end lsu_freestanding_with_a_package_supplier
