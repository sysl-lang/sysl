// P4: which field types give a struct a zero (needed by `var out: T` in a decoder)
import sysl.buf.Buf
import sysl.container.Map

struct A
    s: string
struct B
    o: Option[int]
struct C
    b: Buf[int]
struct D
    r: &A
struct E
    p: *int
struct F
    m: Map[string, int]
enum G
    X
    Y(n: int)

var a: A
var b: B
var c: C
var d: D
var e: E
var f: F
var g: G
