// What a member name on a vector means today, which is what a swizzle syntax would take over.
// Expected (0.3.13): the `impl` and `v.xy()` are ACCEPTED -- a trait may give a vector members --
// and the two field reads are refused:
//   error: cannot read field 'x' of <4>f32
//   error: cannot read field 'wzyx' of <4>f32
// (An inherent `impl <4>f32` is a parse error, "identifier expected".)

trait Lanes
    xy(self) -> int

// Can a program give a vector a member at all? If it can, `.xy` is already a name a program may own.
impl Lanes for <4>f32
    xy(self) -> int = 7

val v: <4>f32 = [1, 2, 3, 4]

print(v.xy())
print(v.x)
print(v.wzyx)
