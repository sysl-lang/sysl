module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// Assignment, which is an expression in the tree and a statement everywhere a reader writes one.
//
// **An assignment written `=` -- or `+=` and the rest -- yields nothing**: its type is `unit`, and it
// stands only where a value is nobody's, which is a statement or the last line of a block that owes
// no other type. **`:=` and its compound forms (`+:=` …) assign and yield**, and what they yield is
// what reading the place right after the store gives. Splitting the two is what keeps `if a = b`
// from compiling for two `bool`s: the one spelling a reader would mistake for a comparison is the
// one that has no value.
//
// **What has to hold is that the result can be stored back.** A constrained place is the one case
// where the arithmetic's type and the place's legitimately differ -- a transparent subtype computes
// at its base -- so the test is on the representation the two share, and what the difference costs
// is the check the constraint asks for.

assign_expr(cx: &Analyzer, span: Span, written: string, target: Expr, value: Expr,
            expected: Option[Type]) -> TExpr
    // Taken before anything inside the assignment is read, since every subexpression goes through
    // the funnel that sets it.
    val bare = cx.assign_here

    cx.assign_here = false

    val yields = is_yielding_assign(written)

    if !yields && (!bare || wants_a_value(expected))
        return cx.err(span, s"'$written' assigns and yields nothing, so it cannot stand where a value " +
                      s"is wanted — write '${yielding_form(written)}' to assign and use the value")

    // The write itself is the one `=` would make; `yields` is all `:=` adds.
    val op = if yields then plain_form(written) else written

    // `b[i] = v` on a type with no elements of its own is `IndexSet`, and it is a **call** rather
    // than a store because a trait's method gives back a value and never an address -- so there is
    // no place for the ordinary path to write through, and the trait says as much by taking the
    // value. The compound forms would have to read the element and write it back, which means
    // evaluating the receiver and the index twice, and a container's subscript is a call. Reading
    // it back after the store is the same second evaluation, so `:=` is refused there too.
    *target.kind match
        Index(receiver, index, _) ->
            if indexes_written(cx, "IndexSet", receiver)
                if op != "=" || yields then
                    return cx.err(span, s"'$written' on an element read through " +
                                  s"'${qualified_name(library_key("Index"))}' would evaluate " +
                                  "the receiver and the index twice — write it out as " +
                                  index_set_longhand(written))

                var args: Buf[Expr] = buf()

                args.push(subscript_index_arg(index))
                args.push(value)

                // At the subscript's anchor -- its bracket -- as a read's call is, so a
                // `@track_caller` member names the column an array's failed store would.
                return call_member(cx, anchor_of(target), type_expr_bare(cx, receiver), "index_set", args,
                                   None)
            end if

        // `p.count = v` where `count` is a settable property is a **call** for the reason an element
        // set through `IndexSet` is: a property computes rather than naming storage, so there is no
        // place for a store to write through, and the setter takes the value instead.
        Field(receiver, name, _) ->
            if settable(cx, receiver, name)
                return setter_assign(cx, span, written, receiver, name, value, expected)

            // A property with **no** setter. The ordinary path would report an expression with no
            // address, which is true and is not what the reader needs to know: what is missing is
            // the member, and the sentence that says so also says what to write.
            val read_only = read_only_property(cx, receiver, name)

            if read_only.is_some()
                val p = read_only.unwrap()

                // Read through a bound, the trait is what lacks the setter at every instantiation,
                // so the generic's definition keeps the complaint rather than leaving it to a type.
                if p.2 then return cx.err_whatever_the_types(span, read_only_message(op, name, p.0, p.1))

                return cx.err(span, read_only_message(op, name, p.0, p.1))
        _ -> ()

    if names_a_lane(cx, target) then
        cx.assign_here = bare
        return lane_assign(cx, span, written, target, value, expected)

    if op == "="
        // An open binding assigned a value of a type of its own takes that type.
        if !cx.open_vars.is_empty() then assigned_fix(cx, target, value)

        val place = analyze_place(cx, target, "assignment", span)

        if texpr_type(place) == Unknown then return bad_expr(span)

        // A literal that does not fit the place is told its type as the place's declaration wrote it.
        val told = cx.declared

        cx.declared = declared_by(cx, Some(place), texpr_type(place))

        val tv = type_expr(cx, value, Some(texpr_type(place)))

        cx.declared = told

        // A diverging value is no value to store, so it is refused here rather than agreeing the
        // way a `never` does where one really may stand -- as the value a `return` yields.
        if texpr_type(tv) == Never || disagree(texpr_type(tv), texpr_type(place)) then
            cx.fault(span, s"cannot assign ${expr_type_show(cx, tv)} to " +
                     s"${describe_target(target)} of type ${expr_type_show(cx, place)}" +
                     mismatch_hint(cx, texpr_type(tv), texpr_type(place)))

        note_view_store(cx, span, place, tv)

        return rechecked(cx, span, place, TExpr(span, TStore(place, tv, texpr_type(place), yields)))
    end if

    val place = analyze_place(cx, target, s"'$written'", span)

    if texpr_type(place) == Unknown then return bad_expr(span)

    val bin = op[0..<op.bytes.len - 1]

    // A compound assignment is arithmetic: its value's position fixes nothing, but the place and the
    // value fix each other where one of them is undecided and the other has a type of its own.
    not_fixing_at(cx, value)

    if !cx.open_vars.is_empty() then compound_fixes(cx, bin, target, place, value)

    val want = scale_expectation(bin, texpr_type(place), value, update_expected(cx.an, bin, texpr_type(place)))
    // A literal is held to the place's type, and told it by the place's declared spelling where it does
    // not fit; a wrapping or saturating update also names its operator.
    val saved = cx.declared

    cx.declared = declared_by(cx, Some(place), texpr_type(place))

    val read = if !is_wrap_sat_op(bin) && is_literal(value) then held_literal(cx, value, want, "", Some(place))
    else if !is_wrap_sat_op(bin) then type_expr(cx, value, want)
    else if literal_valued(cx, value) || is_char_literal(value) then held_literal(cx, value, want, bin, Some(place))
    else type_expr_unwidened(cx, value, want)

    cx.declared = saved
    // ... and so does a typed value of another type, which does not widen to it.
    if is_wrap_sat_op(bin) && texpr_type(read) != Unknown && !adaptable(value, read) &&
       !literal_valued(cx, value) && !type_eq(repr(texpr_type(read)), repr(texpr_type(place)))
        cx.err(value.span, s"'$bin' takes two values of one type, got ${type_show(texpr_type(place))} and " +
               s"${type_show(texpr_type(read))}")

        return bad_expr(span)
    end if

    val tv = widened_operand(cx, span, bin, texpr_type(place), read, Some(value))

    if operand_refused(read, tv) then return bad_expr(span)

    val dispatch = update_dispatch(cx, span, bin, place, tv)

    // An operator that reaches an implementation had both its operands checked against the trait's
    // own signature where it was resolved, and its result checked against the place there too. A
    // fixed-point product or quotient is given the place's format, as `x = x * g` would be.
    if dispatch.is_none()
        val fixed = fixed_operator_type(cx, span, bin, texpr_type(place), texpr_type(tv),
                                        Some(texpr_type(place)))
        val got = if fixed.is_some() then fixed.unwrap()
        else arith_type(cx, span, bin, texpr_type(place), texpr_type(tv), value.span)

        if disagree(got, texpr_type(place)) then
            cx.fault(span, s"'$written' would change the type of ${describe_target(target)}")
    end if

    rechecked(cx, span, place,
              TExpr(span, TUpdate(place, op, tv, texpr_type(place), dispatch,
                                  constraint_of(texpr_type(place)), yields)))
end assign_expr

// The vector a lane write names: `v[2] = x` and `v.xy = e`, where the receiver is a vector. A
// selection whose name is swizzle letters might as well be a field of a struct, so the receiver's
// type decides.
private lane_receiver(target: Expr) -> Option[Expr] = *target.kind match
    Index(receiver, _, _) -> Some(receiver)
    Field(receiver, name, _) -> if swizzle_lanes(name).is_some() then Some(receiver) else None
    _ -> None

private names_a_lane(cx: &Analyzer, target: Expr) -> bool
    val receiver = lane_receiver(target)

    if receiver.is_none() then return false

    val tried = begin_trial(cx)
    val t = type_expr_bare(cx, receiver.unwrap())

    discard_trial(cx, tried)

    if texpr_type(t) == Unknown then return false

    repr(texpr_type(auto_deref(cx, t))) match
        Vector(_, _) -> true
        _ -> false
end names_a_lane

// What a lane write's target is called in a refusal.
private lane_name(target: Expr) -> string = *target.kind match
    Field(_, name, _) -> if name.bytes.len == 1 then s"lane '$name'" else s"swizzle '$name'"
    _ -> "a lane"

// Whether writing through an expression twice is the same as writing through it once: a name, a
// constant, and the fields, elements and arithmetic made of them.
private repeatable(e: Expr) -> bool = *e.kind match
    Ident(_) -> true
    IntLit(_, _, _) -> true
    Field(r, _, _) -> repeatable(r)
    Index(r, i, _) -> repeatable(r) && repeatable(i)
    Unary(_, x) -> repeatable(x)
    Binary(_, l, r) -> repeatable(l) && repeatable(r)
    _ -> false

// `v[2] = x`, `v.y = x` and `v.xy = e`: the vector read, the named lanes replaced, the vector stored
// back. A lane has no address of its own, so this is the only way one is written, and it is the
// vector that has to be a place.
//
// **A compound form is the longhand**: `v.xy += d` is `v.xy = v.xy + d`, the place written twice, which
// is why a place computed by a call or an unusual index is refused -- it would be evaluated twice.
private lane_assign(cx: &Analyzer, span: Span, written: string, target: Expr, value: Expr,
                    expected: Option[Type]) -> TExpr
    if is_yielding_assign(written) then
        return cx.err(span, s"'$written' assigns and yields, and a lane is stored by writing the whole " +
                      s"vector back — write '${plain_form(written)}' and read the lane after it")

    val receiver = lane_receiver(target).unwrap()

    if !repeatable(receiver) then
        return cx.err(span, "a lane is written by reading the vector and storing it back, which names " +
                      "its place twice — and this place is computed. Name the vector with a 'var' first, " +
                      "or write the whole vector")

    if written != "="
        val bin = written[0..<written.bytes.len - 1]

        cx.assign_here = true

        return assign_expr(cx, span, "=", target, Expr(span, Binary(bin, target, value)), expected)
    end if

    val read = type_expr_bare(cx, target)

    if texpr_type(read) == Unknown then return bad_expr(span)

    var held = read
    var lanes: Buf[int] = buf()

    *read.kind match
        TLane(r, lane, _) ->
            held = r
            lanes.push(lane)
        TShuffle(r, second, picks, _) ->
            held = r
            lanes = picks
        _ -> return cx.err(span, s"${lane_name(target)} is not a lane of a vector")

    for i in 0..<lanes.len()
        for j in 0..<i
            if lanes.at(i) == lanes.at(j) then
                return cx.err(span, s"a swizzle written to cannot repeat a letter — " +
                              s"'${swizzle_letter(lanes.at(i))}' names lane ${lanes.at(i)} twice, and one " +
                              "value cannot go to both")

    val place = require_place(cx, held, receiver, "assignment", true, Some(span))

    if texpr_type(place) == Unknown then return bad_expr(span)

    val tv = type_expr(cx, value, Some(texpr_type(read)))

    if texpr_type(tv) == Never || disagree(texpr_type(tv), texpr_type(read)) then
        cx.fault(span, s"cannot assign ${type_show(texpr_type(tv))} to " +
                 s"${lane_name(target)} of type ${type_show(texpr_type(read))}")

    val merged = TExpr(span, TLaneSet(place, lanes, tv, texpr_type(place)))

    rechecked(cx, span, place, TExpr(span, TStore(place, merged, texpr_type(place), false)))
end lane_assign

// Whether a form hands a block's "owes nothing" on to the blocks it is made of: the branches of an
// `if` or a `match`, and a block written as a value.
carries_tail(e: Expr) -> bool = *e.kind match
    IfExpr(_, _, _, _) -> true
    MatchExpr(_, _) -> true
    Block(_) -> true
    // An `@unchecked` block is a block (`unchecked.sysl`).
    Call(head, _) -> is_unchecked_block(head)
    _ -> false

// Whether an expression is an assignment, written whichever way.
is_assignment(e: Expr) -> bool = *e.kind match
    Assign(_, _, _) -> true
    _ -> false

// A position that has a type of its own to ask for, which an assignment that yields nothing cannot
// give it. `unit` asks for nothing, and an expectation already gone wrong says nothing more.
private wants_a_value(expected: Option[Type]) -> bool = expected match
    Some(t) -> t != Unit && t != Unknown
    None -> false

// `=` for `:=`, `+=` for `+:=`.
plain_form(op: string) -> string = op[0..<op.bytes.len - 2] + "="

// `:=` for `=`, `+:=` for `+=`.
private yielding_form(op: string) -> string = op[0..<op.bytes.len - 1] + ":="

// The two statements an element written through `IndexSet` takes for what `op` would have done.
private index_set_longhand(op: string) -> string
    if is_yielding_assign(op)
        val plain = plain_form(op)

        if plain == "=" then return "'b[i] = v' and read 'b[i]' after it"

        return s"'b[i] = b[i] ${plain[0..<plain.bytes.len - 1]} …' and read 'b[i]' after it"
    end if

    s"'b[i] = b[i] ${op[0..<op.bytes.len - 1]} …'"
end index_set_longhand

// A write with the invariant re-checks it owes wrapped around it, innermost first.
//
// **A struct's invariant is a claim about the whole value**, so a write to one of its fields is what
// can break it -- and the check belongs at the write rather than at the field, because the field on
// its own says nothing about what the clause reads. The walk goes outward through the **whole**
// place, since an invariant may read through a field: `invariant a.n <= b` is a claim `o.a.n = 9`
// can break just as `o.b = 0` can, and only the enclosing struct knows it.
rechecked(cx: &Analyzer, span: Span, place: TExpr, written: TExpr) -> TExpr
    var out = written
    val owed = inv_checks_for(cx, place)

    for item in owed
        out = TExpr(span, TRecheck(out, item.0, item.1, inv_fn_for(cx.an, item.1)))

    out
end rechecked

// Every struct a write through a place obliges a re-check of: what to re-read, and its declaration.
// Nothing is owed by the parts of a place that merely locate it, so an index contributes no check of
// its own and is walked through.
inv_checks_for(cx: &Analyzer, place: TExpr) -> Buf[(TExpr, &StructType)]
    var out: Buf[(TExpr, &StructType)] = buf()

    *place.kind match
        TField(recv, _, _) ->
            val d = invariant_bearing(cx, texpr_type(recv))

            if d.is_some() then out.push((recv, d.unwrap()))

            val outer = inv_checks_for(cx, recv)

            for item in outer
                out.push(item)
        // A view's element is on its far side, which no clause may read, so writing one can break
        // nothing the struct holding the view promised and is owed no re-check. `self.elems[i] = v`
        // in a buffer whose clause reads `elems.len` changes an element and leaves the length alone.
        TIndex(recv, _, _) -> if !far_side(texpr_type(recv)) then out = inv_checks_for(cx, recv)

        // A `ref` name is a place written shorter, so the walk carries on through what it stands
        // for. This is the whole of why a `ref` keeps the checking a `*T` would have severed: there
        // is still a place here to walk outward through, and it is the one the program wrote.
        TLoad(name, _) ->
            val stood = ref_place(cx, name)

            if stood.is_some() then out = inv_checks_for(cx, stood.unwrap())
        _ -> ()

    out
end inv_checks_for

// The struct a type is, where its declaration carries invariants a write owes a re-check of.
private invariant_bearing(cx: &Analyzer, t: Type) -> Option[&StructType] = t match
    Struct(d) -> if bears_invariants(cx.an, d.base) then Some(d) else None
    _ -> None

// The function a struct's invariants are checked by.
inv_key(base: string) -> string = s"$base${ModuleSep}inv"

// What a compound arm's value is read at.
//
// A **transparent** subtype is homogeneous at its base, which is what `repr` gives: what `t += 120`
// adds is an ordinary integer, and reading the addend as the subtype would check it against a range
// that belongs to the total.
