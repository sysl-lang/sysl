// Can a shuffle mask be computed at compile time today, for any width?
// This decides what option (a) needs beyond "the mask argument folds to a constant".
//
// Findings it pins (sysl 0.3.13):
//   - `const` is scalar-only: `const ZIP: [4]int = …` is refused ("a constant is a scalar, and
//     [4]int is storage"), so a named mask is a `val` or a `const` function.
//   - a `const` function CAN build and return an array, generic in the width;
//   - an element of its result folds wherever a constant is required -- here, a lane index.

// A mask computed for any width: interleave the low halves of two <W>.
const zip_lo_mask[const W: usize]() -> [W]usize
    var m: [W]usize

    for i in 0..<W / 2
        m[2 * i] = i
        m[2 * i + 1] = W + i

    m

// A lane index that is an element of a const function's array result.
second_source[const W: usize](v: <W>f32) -> f32 = v[zip_lo_mask[W]()[2]]

// A lane index computed from a value parameter.
last_lane[const W: usize](v: <W>f32) -> f32 = v[W - 1]

val four: <4>f32 = [1, 2, 3, 4]
val eight: <8>f32 = [1, 2, 3, 4, 5, 6, 7, 8]
val m8 = zip_lo_mask[8]()

print(m8[0], m8[1], m8[6], m8[7])
print(second_source(four), second_source(eight))
print(last_lane(four), last_lane(eight))
