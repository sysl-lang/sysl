module sysl

/** What a format string's flags are carried in (`library/core.md § A specifier is the whole value's
 * field`): the field the whole value occupies, the precision each renderer reads in its own terms,
 * and which side the padding goes on.
 *
 * What honours it is the `display_*` family, whose prose is where the three fields are explained.
 */
struct FormatSpec
    width: int
    prec: int
    left: bool

/** How a value renders itself.
 *
 * A `Display` writes its value's text into a sink rather than returning a fresh `string`, so
 * rendering costs no allocation and a `no alloc` module can still log. The sink is a `*Writer`,
 * which is the trait object of `02` -- and which this file does not declare: a module's members are
 * one set however many files they came from, so `Writer` is reached here with nothing to import.
 */
trait Display
    display(self, out: *Writer, fmt: FormatSpec)

    /** What `derives Display` writes: `Size(3, 4)` -- the type's own name and its fields in order,
     * which is the tuple's rendering with the name in front; a variant renders under its own name,
     * `Circle(2)`, and a part-less shape as its name alone.
     *
     * Each part is handed the **neutral** specifier: the one that arrived describes the field the
     * whole value occupies, so a width pads the whole rendering once (`display_padded`) rather than
     * inside it.
     */
    derive[T] display(self: T, out: *Writer, fmt: FormatSpec)
        if fmt.width > 0
            display_padded(self, out, fmt)
            return
        end if

        val parts = FormatSpec(0, -1, false)

        if const T::Kind == Kind.SimpleEnum
            for const c in T::Variants
                if self is c then out.write(c.name.bytes)
        elif const T::Kind == Kind.DataEnum
            for const c in T::Variants
                if self is c
                    val p = self.(c)
                    var n = 0

                    out.write(c.name.bytes)

                    for const f in c::Fields
                        out.write((if n == 0 then "(" else ", ").bytes)
                        p.(f).display(out, parts)
                        n += 1

                    if n > 0 then out.write(")".bytes)
                end if
        else
            var n = 0

            out.write(T::BaseName.bytes)

            for const f in T::Fields
                out.write((if n == 0 then "(" else ", ").bytes)
                self.(f).display(out, parts)
                n += 1

            if n > 0 then out.write(")".bytes)
    end display

// `x`'s rendering in the field `fmt` describes, which is how a derived `Display` honours a width: the
// value is rendered once into a counting sink with no width to learn how long it comes out, then
// padded once around a second rendering. Nothing is gathered.
private display_padded[T: Display](x: T, out: *Writer, fmt: FormatSpec)
    val plain = FormatSpec(0, -1, false)
    var count = Counting(0)
    var sink: *Writer = &count

    x.display(sink, plain)

    var pad = fmt.width - int(count.n)

    if pad < 0 then pad = 0
    if !fmt.left then display_fill(out, 32, pad)

    x.display(out, plain)

    if fmt.left then display_fill(out, 32, pad)
end display_padded

// The built-in types whose family is **closed**, each with an ordinary `impl` rather than a
// membership the compiler hands out.
//
// The distinction is the one `sysl.math` already draws between `Float` and `Bits`: where there is a
// finite list of types to write blocks for, the blocks are written, and where the family is open
// (`iN`/`uN`, which admit `i5` and `u24`) the membership has to be a rule instead. There are two
// floats, one `bool`, one `char` and one `string`, so these five are the written half.
//
// **What it buys is that these are ordinary trait members**, and a slot in a method table has to be
// a function that exists. A membership the compiler provides has none -- what it has is a rendering
// it splices in -- so a value holding one cannot be erased to a `*Display`. These five can.
//
// Each is one line because the work is in the `display_*` family, which is the same rendering the
// `print*` path reaches for the same type.

impl Display for bool
    display(self, out: *Writer, fmt: FormatSpec) = display_bool(self, out, fmt)

impl Display for char
    display(self, out: *Writer, fmt: FormatSpec) = display_char(self, out, fmt)

impl Display for string
    display(self, out: *Writer, fmt: FormatSpec) = display_str(self, out, fmt)

impl Display for real
    display(self, out: *Writer, fmt: FormatSpec) = display_real(self, out, fmt)

/** Every float renders at its own width, in the fewest digits that read back as the same value of
 * that type -- what Rust's `{}` writes -- so `f32(0.1)` and `f16(0.1)` both print `0.1`, the digits
 * their own width needs, rather than the longer reading of the value widened to a `real`.
 */
impl Display for f32
    display(self, out: *Writer, fmt: FormatSpec) = display_f32(self, out, fmt)

impl Display for f16
    display(self, out: *Writer, fmt: FormatSpec) = display_f16(self, out, fmt)

impl Display for bf16
    display(self, out: *Writer, fmt: FormatSpec) = display_bf16(self, out, fmt)

/** An `f128` renders at its own width too: narrowing to a `real` would print a number the program
 * does not hold.
 */
impl Display for f128
    display(self, out: *Writer, fmt: FormatSpec) = display_f128(self, out, fmt)

/** The integers, which are the family that is **open**: `i5` and `u24` are types a program may
 * name, so there is no finite list of widths to write the blocks above for.
 *
 * What stands in for the list is one block written over the whole family at once, and `Integer` is
 * what names the family. It declares no member of its own -- a type is one of the integers or it is
 * not, which is the compiler's answer and not something a program can join -- so what it carries is
 * the operators the block below needs, exactly as `sysl.math`'s `Float` carries the ones its two
 * widths share.
 * **`Mul` joined this list for rendering**, which is the one member here that is not about taking a
 * number apart. Chunked decimal conversion multiplies in two places -- computing the chunk divisor,
 * and recovering a remainder as `rest - q * chunk` -- and every integer type has `Mul` at every
 * width, so nothing is excluded by asking for it and the compiler supplies the membership either
 * way.
 */
trait Integer: Div + Rem + Ord + Eq + Sub + Mul

// How every integer renders, at every width, from one body.
//
// **The buffer is measured from the type**, which is what makes one block possible: three decimal
// digits per byte is the bound at every width, and the two extra bytes are the sign and the room
// that rounding the bound up costs. A fixed length would be wrong at `u256` or wasteful at `u8`,
// and there is no third choice -- which is why this could not be written until an array's length
// could be worked out from a type parameter.
//
// **The number is never negated**, and that is what lets one body serve both signednesses. Taking a
// magnitude gets the most negative value of a width wrong, since its magnitude is one larger than
// the width holds -- `-128` negated is `-128` again. So a negative value walks toward zero
// exactly as a positive one does, with the sign still on it.
//
// Rendering therefore costs no allocation at any width, which is the promise the trait's own prose
// makes and the reason a `no alloc` module can log.
//
// **The digits come out in chunks rather than one at a time, and the reason is what a division
// costs.** A division's cost is set by the type's *static* width, not by how small the value has
// become, so peeling one digit per full-width division makes rendering O(digits x width): 39 wide
// divisions to print a `u128`, about 6000 for a `u10000`. Dividing instead by the largest power of
// ten the width holds, and splitting that chunk with ordinary `u64` arithmetic, pays the wide
// division once per nineteen digits.
//
// Measured before and after, same value and same process: `u128` and `u256` **22x** faster, a
// 3011-digit `u10000` **19x**. **`int` and `u64` are unchanged**, which is the number that made this
// worth doing rather than a trade -- at those widths the chunk is the whole value, the divisor-
// computing loop folds away, and what is left is the loop that was always there. It was found by a
// factorial program in which rendering the answer was 98% of the run and the arithmetic 0.075s of it.

/** Ten as a `T`, reached through a conversion because the literal `10` is refused at a width that
 * cannot hold it. At such a width the conversion wraps and the result is not ten, which is what
 * `holds_ten` tests; a caller that has not asked it must not use the value.
 */
private ten_of[T: Integer]() -> T
    val wide: i64 = 10
    T(wide)

/** Whether `T` can hold ten, which is false for `u1` to `u3` and `i1` to `i4`. A pure function of
 * `T` alone, so it folds and an ordinary render pays nothing for it.
 */
private holds_ten[T: Integer]() -> bool = u64(ten_of[T]()) == 10

/** The largest power of ten that fits in both `T` and a `u64`, and how many digits that is.
 *
 * **Only called at a width that holds ten** (`holds_ten`); a narrower one renders through `i64`.
 *
 * **It is computed rather than written down, and it has to be.** The block below is generic over the
 * whole open integer family, so a literal `10000000000000000000` is refused at every narrow member of
 * it — *"the literal 10000000000000000000 does not fit byte"*. Multiplying up and testing by dividing
 * back is the one form that is total at every width. It lands at 100 for a `u8` and at 10^19 for a
 * `u64` and everything above it.
 *
 * **The loop is a pure function of `T` alone**, so it folds away and an ordinary `int` render pays
 * nothing for it — which is what makes the change below safe rather than a trade.
 *
 * **The cap is a `u64`'s worth of digits and deliberately not a `usize`'s**, and the two differ on a
 * 32-bit target. What the cap has to fit is the type the *low half of each chunk is rendered with*,
 * and that is a `u64` below whatever `usize` happens to be on the machine. Tying it to `usize` would
 * cap at 10^9 there while the arithmetic doing the work stayed 64-bit: slower, for a reason
 * unconnected to the value being printed.
 */
private chunk_of[T: Integer]() -> (T, usize)
    val ten = ten_of[T]()
    val one: T = ten / ten
    var c: T = one
    var per: usize = 0

    while per < 19
        val next = c * ten

        // The overflow test that is available at every width: multiplication wraps (`01`), so what
        // says the product was representable is that dividing it back gives what went in.
        if next / ten != c then break

        c = next
        per += 1

    (c, per)
end chunk_of

impl[T: Integer] Display for T
    display(self, out: *Writer, fmt: FormatSpec)
        // Every width that cannot hold ten fits an `i64`, sign included.
        if !holds_ten[T]()
            i64(self).display(out, fmt)
            return

        var buf: [sizeof(T) * 3 + 2]u8
        val zero: T = 0
        var i = buf.len

        if self == zero
            i -= 1
            buf[i] = u8('0')
        else
            val pair: (T, usize) = chunk_of()
            val chunk = pair.0
            val per = pair.1
            val neg = self < zero
            var rest = self

            while rest != zero
                val q = rest / chunk
                val r = rest - q * chunk

                // **The sign stays on until the last moment**, exactly as the digit-at-a-time loop
                // did and for the same reason: a magnitude taken here would be wrong at the most
                // negative value of the width, whose magnitude the width does not hold. `%` and `/`
                // truncate toward zero (`01`), so `r` carries the sign and one subtraction from zero
                // makes it a positive chunk that always fits.
                var low = if neg then u64(zero - r) else u64(r)
                val last = q == zero
                var d: usize = 0

                // **An interior chunk is padded to its full width**, and forgetting that is the one
                // real subtlety here: a zero inside the number would otherwise vanish, since the
                // chunk holding it renders short. `10^25` against `10^25 + 1` is the pair that
                // catches it, and both are in the tests.
                while low > 0 || (!last && d < per)
                    i -= 1
                    buf[i] = u8('0') + u8(low % 10)
                    low /= 10
                    d += 1

                rest = q

            if neg
                i -= 1
                buf[i] = u8('-')

        display_digits(buf[i..<buf.len], out, fmt)
