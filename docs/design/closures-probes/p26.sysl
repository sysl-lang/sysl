// A closure holding the address of a loop body's local, stored in a variable of the enclosing block and
// called after the loop: the slot is reused per iteration, so "does not leave the frame" is not enough.
run()
    var g: &Fn() -> int = () -> 0

    for i in 0..<3
        var n = i * 10
        val p = &n

        g = () -> *p

    print(g())

run()
