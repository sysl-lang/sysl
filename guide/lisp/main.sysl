// The checks. Every line of output begins `ok`, so the whole of stdout is the assertion.

check(what: string, got: string, want: string)
    if got == want then print(s"ok    $what = $got")
    else print(s"FAIL  $what = $got, wanted $want")
end check

// A program is evaluated by the naive interpreter unless a check is about the other one, because
// the two agree on every answer and only the naive one is the language anyone would write first.
value(src: string) -> string = answer(src, false)

// The two programs the memory checks are about, and the reason there are two: the first defines one
// function and calls it eleven times, the second defines two and calls them five hundred more. If
// what leaks were proportional to the calls, they would not agree.
fact() -> string = "(define (fact n) (if (= n 0) 1 (* n (fact (- n 1))))) (fact 10)"

repeated() -> string =
    "(define (fact n) (if (= n 0) 1 (* n (fact (- n 1)))))" +
        " (define (rep k) (if (= k 0) (fact 10) (rep (- k 1)))) (rep 500)"

// `n` opening parens, an atom, and `n` closing ones — the deepest thing the reader will be asked
// for, built rather than typed so the limit and the check cannot drift apart.
nest(n: int) -> string
    var out = ""
    var i = 0

    while i < n
        out = out + "("
        i += 1

    out = out + "1"
    i = 0

    while i < n
        out = out + ")"
        i += 1

    out
end nest

print("-- reading and writing")
check("an integer", value("42"), "42")
check("a negative one", value("-7"), "-7")
check("the empty list", value("()"), "()")
check("a boolean", value("true"), "true")
check("a builtin names itself", value("cons"), "#<cons>")
check("a lambda does not", value("(lambda (x) x)"), "#<lambda>")
check("whitespace is not a token", value("(  +\n   1\t2  )"), "3")
check("an empty program is the empty list", value(""), "()")

print("-- arithmetic, and the values it works on")
check("addition", value("(+ 2 3)"), "5")
check("subtraction", value("(- 2 3)"), "-1")
check("multiplication", value("(* 6 7)"), "42")
check("nesting", value("(* (+ 1 2) (- 10 4))"), "18")
check("equality", value("(= 3 3)"), "true")
check("and its negative", value("(= 3 4)"), "false")
check("order", value("(< 3 4)"), "true")
check("a subtraction sign is not a number", value("(- 0 5)"), "-5")
check("but a signed literal is", value("(+ -5 0)"), "-5")

// The Lisp's integer is sysl's, so it is sysl's overflow too — `00 §5` and `11` both say arithmetic
// wraps at the declared width rather than trapping, and a language built on it inherits that whether
// it wants to or not. It is also why there are no bignums here: making one would be a different
// program's axis, and pretending the limit is not there would be worse than stating it.
check("one past the widest integer is the narrowest",
      value("(+ (+ (* 8 (* 1000000000 1000000000)) 999999999999999999) 223372036854775809)"),
      "-9223372036854775808")

print("-- lists")
check("cons makes a pair", value("(cons 1 ())"), "(1)")
check("and pairs make a list", value("(cons 1 (cons 2 (cons 3 ())))"), "(1 2 3)")
check("a tail that is not a list is written as one", value("(cons 1 2)"), "(1 . 2)")
check("car", value("(car (cons 1 (cons 2 ())))"), "1")
check("cdr", value("(cdr (cons 1 (cons 2 ())))"), "(2)")
check("the empty list is null", value("(null? ())"), "true")
check("and a pair is not", value("(null? (cons 1 ()))"), "false")
check("nor is an integer", value("(null? 0)"), "false")
check("lists nest", value("(cons (cons 1 ()) (cons 2 ()))"), "((1) 2)")

print("-- functions, and recursion")
check("a lambda applies", value("((lambda (x) (* x x)) 7)"), "49")
check("of two parameters", value("((lambda (x y) (- x y)) 10 4)"), "6")
check("of none", value("((lambda () 5))"), "5")
check("a definition answers with its name", value("(define x 1)"), "x")
check("and binds it", value("(define x 41) (+ x 1)"), "42")
check("a definition may be replaced", value("(define x 1) (define x 2) x"), "2")
check("a function shorthand binds a lambda", value("(define (f x) (+ x 1)) (f 1)"), "2")
check("recursion", value(fact()), "3628800")
check("a closure sees where it was written",
      value("(define (adder n) (lambda (x) (+ x n))) (define add3 (adder 3)) (add3 4)"), "7")
check("and keeps seeing it after the call returns",
      value("(define (adder n) (lambda (x) (+ x n))) (define a2 (adder 2)) (define a9 (adder 9))" +
                " (+ (a2 1) (a9 1))"), "13")
check("a parameter shadows a global",
      value("(define n 1) (define (f n) n) (f 99)"), "99")
check("and the global is still there", value("(define n 1) (define (f n) n) (f 99) n"), "1")
check("only false is false", value("(if () 1 2)"), "1")
check("and false is", value("(if false 1 2)"), "2")

print("-- what the reader refuses")
check("an unclosed list", value("(+ 1"), "error: unclosed list at 0")
check("a stray close", value(")"), "error: unbalanced ')' at 0")
check("one nested inside", value("(1 (2)"), "error: unclosed list at 0")
check("a value that is not there", value("("), "error: unclosed list at 0")
check("a digit run that does not end", value("12x"), "error: a delimiter expected at 2")
check("a number too wide for the integer", value("1234567890123456789"), "error: number too large at 0")
check("but eighteen digits are not", value("123456789012345678"), "123456789012345678")

// The depth limit is the reader's, and it is the only one: nothing else in the interpreter builds a
// nested value, so a form the reader accepted is a form `render` can write and `eval` can walk. The
// deepest legal one is read and written back to prove exactly that — evaluating it is impossible,
// since `(1)` applies an integer, which is why `reads_back` exists at all.
check("the deepest form there is survives a round trip", reads_back(nest(128)), nest(128))
check("and one deeper is refused instead of overflowing a stack",
      reads_back(nest(129)), "error: nested too deeply at 129")

// ------------------------------------------------------------------------------------------------
// The axis. A closure has to see the environment it was written in, and a recursive definition puts
// the closure into that environment, so the reference count on it can never reach zero. Nothing
// counts objects here: every number below is a weak reference being asked whether it still answers.
// ------------------------------------------------------------------------------------------------

print("-- the cycle a reference count cannot reclaim")

var naive = after_run(fact(), false)

check("the run made twelve environments", str(made(naive)), "12")
check("and one of them outlived the interpreter", str(alive(naive)), "1")
check("which is the globals, holding the closure that holds it back",
      str(during_run(fact(), false)), "1")

// The number that decides whether a naive interpreter is usable: if the cycle were per *call* this
// would be five hundred and one rather than one.
var many = after_run(repeated(), false)

check("five hundred more calls make five hundred more environments", str(made(many)), "513")
check("and leave exactly the same one behind", str(alive(many)), "1")
check("calling something else many times leaks nothing more",
      str(alive(after_run("(define (id x) x) (id 1) (id 2) (id 3)", false))), "1")
check("a program that defines nothing leaks nothing",
      str(alive(after_run("(+ 1 2)", false))), "0")
check("nor does one whose lambda is never bound where it can see itself",
      str(alive(after_run("((lambda (x) x) 1)", false))), "0")

// **What the counts above are actually saying, and it is not "one per program".** The leak is one
// environment per environment a definition lands in — which at the top level is one however long the
// run, because every top-level `define` lands in the same globals. Move the definition inside a
// function and the same rule reads the other way: each call makes a frame and each frame gets its
// own closure pointing back at it. Three calls, three frames, and not one of the four environments
// this run made comes back.
var nested = after_run("(define (outer) (define (inner) (inner))) (outer) (outer) (outer)", false)

check("a definition inside a function is a definition per call", str(made(nested)), "4")
check("and every one of those frames is trapped with it", str(alive(nested)), "4")
check("which the owning interpreter reclaims like any other",
      str(alive(after_run("(define (outer) (define (inner) (inner))) (outer) (outer) (outer)", true))),
      "0")

print("-- the same interpreter with the edge weakened")

var weakened = after_run(fact(), true)

check("the same program makes the same environments", str(made(weakened)), "12")
check("and none of them outlives the interpreter", str(alive(weakened)), "0")
check("because the interpreter owned every one of them until it went",
      str(during_run(fact(), true)), "12")
check("the answers are the same either way", answer(fact(), true), answer(fact(), false))
check("and so is the closure that made the trouble",
      answer("(define (adder n) (lambda (x) (+ x n))) ((adder 3) 4)", true),
      answer("(define (adder n) (lambda (x) (+ x n))) ((adder 3) 4)", false))

print("-- scale")

// Two Lisp functions that tail-call themselves a hundred thousand times each, and a hundred thousand
// pairs built and taken apart in between. `eval` loops rather than recursing, so this runs in one
// sysl frame; the list comes apart on a worklist rather than on the stack.
check("a hundred thousand tail calls, and the list they build",
      value("(define (build n acc) (if (= n 0) acc (build (- n 1) (cons n acc))))" +
                " (define (count xs n) (if (null? xs) n (count (cdr xs) (+ n 1))))" +
                " (count (build 100000 ()) 0)"), "100000")
check("and the sum of it, which is what says the cells were right",
      value("(define (build n acc) (if (= n 0) acc (build (- n 1) (cons n acc))))" +
                " (define (total xs acc) (if (null? xs) acc (total (cdr xs) (+ acc (car xs)))))" +
                " (total (build 100000 ()) 0)"), "5000050000")
