module sysl.fmt
@tests

import sysl.text.from_utf8_unchecked

// What a string under a specifier renders as; the compiler's `tests_fms_format_str.sysl` compares
// every case against C's `snprintf`.

@test("a width pads on the left, and '-' pads on the right")
str_width_pads()
    assert_eq(format_str("ab", "%6s", 0, -1), "    ab")
    assert_eq(format_str("ab", "%-6s", 0, -1), "ab    ")
    assert_eq(format_str("abcdef", "%3s", 0, -1), "abcdef")

@test("a width counts bytes, not characters")
str_width_counts_bytes()
    assert_eq(format_str("zoë", "%6s", 0, -1), "  zoë")

@test("a precision cuts the text to that many bytes")
str_precision_cuts()
    assert_eq(format_str("abcdef", "%.2s", 0, -1), "ab")
    assert_eq(format_str("abcdef", "%-5.3s", 0, -1), "abc  ")
    assert_eq(format_str("zoë", "%.0s", 0, -1), "")
    assert_eq(format_str("zoë", "%.3s", 0, -1).bytes.len, 3)

@test("a run-time width and precision are read as C's '*' reads them")
str_counts_are_stars()
    assert_eq(format_str("ab", "%*s", -5, -1), "ab   ")
    assert_eq(format_str("abc", "%*.*s", 4, 2), "  ab")
    assert_eq(format_str("abc", "%.*s", 0, -3), "abc")

@test("'0' pads a right-justified field with zeros, and the other flags change nothing")
str_flags()
    assert_eq(format_str("ab", "%05s", 0, -1), "000ab")
    assert_eq(format_str("ab", "%-05s", 0, -1), "ab   ")
    assert_eq(format_str("ab", "%+#5s", 0, -1), "   ab")

@test("an interior NUL ends the text, as it ends a C string")
str_nul_ends_the_text()
    var b: [3]u8 = [97, 0, 98]

    assert_eq(format_str(from_utf8_unchecked(b[..]), "%-3s", 0, -1), "a  ")
