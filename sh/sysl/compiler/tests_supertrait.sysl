module sh.sysl.compiler
@tests

import sysl.text.Search

// A trait that **requires** another (`reference/traits.md § A trait may require another trait`),
// as the reference's `SupertraitTests` pins it. A bound wants the economy — `[T: Word]` licensing
// what `Word` requires — and a trait object wants what is otherwise unwritable: an erased value
// still answering a second trait's members, through slots laid out in the one table.
//
// **Every output and every diagnostic here was read out of the reference compiler (0.0.152)** by
// handing the installed `sysl` the same program; the vtable lines are its `emit-llvm`. The harness
// is `tests_xvr_extern_var.sysl`'s: `xvr_ran` builds, links and runs a tree and answers with the
// build's refusal where there is one.

private sup_main(text: string) -> []const (string, string) = [("main.sysl", text)]

private sup_ran(text: string) -> string = xvr_ran(sup_main(text))

// A refusal carries this message, anchored at this `file:line:column`.
private sup_refused(said: string, message: string, at: string) =
    assert(said.contains(s"error: $message\n"), said)
    assert(said.contains(s"/$at\n"), said)

private sup_greet() -> string = raw"""
    trait Named
        name(self) -> string
    trait Greet: Named
        greet(self) -> string = "hello, " + self.name()
    struct P
        n: string
    impl Named for P
        name(self) -> string = self.n
    impl Greet for P
    """

private sup_shape() -> string = raw"""
    trait Shape: Display
        area(self) -> int
    struct Rect
        w: int
        h: int
    impl Shape for Rect
        area(self) -> int = self.w * self.h
    impl Display for Rect
        display(self, out: *Writer, fmt: FormatSpec) = display_pad("a rect".bytes, out, fmt)
    """

private sup_sink() -> string = raw"""
    trait Sink[T]
        take(self, v: T) -> int
    struct S
        v: int
    impl Sink[int] for S
        take(self, v: int) -> int = self.v + v
    """

// -- what a bound reaches -------------------------------------------------------------------------

@test("a bound licenses the members of the traits its trait requires")
sup_bound_licenses_required_members()
    if xvr_no_library() then return

    assert_eq(sup_ran(sup_greet() + "f[T: Greet](x: T) -> string = x.name()\nprint(f(P(\"ed\")))\n"), "ed\n")

@test("and its own, so the two are one promise")
sup_bound_licenses_its_own()
    if xvr_no_library() then return

    assert_eq(sup_ran(sup_greet() + "f[T: Greet](x: T) -> string = x.greet()\nprint(f(P(\"ed\")))\n"),
              "hello, ed\n")

// Entailment: `T: Greet` is accepted where `U: Named` is asked for, so a requirement is a fact the
// whole constraint system knows rather than a lookup rule for member names.
@test("and a bound on a required trait is satisfied by one on the trait that requires it")
sup_bound_entails_the_required_bound()
    if xvr_no_library() then return

    assert_eq(sup_ran(sup_greet() + raw"""
        g[U: Named](y: U) -> string = y.name()
        f[T: Greet](x: T) -> string = g(x)
        print(f(P("ed")))
        """), "ed\n")

@test("a default body may call a required trait's method")
sup_default_body_calls_required()
    if xvr_no_library() then return

    assert_eq(sup_ran(sup_greet() + "print(P(\"ed\").greet())\n"), "hello, ed\n")

@test("a required trait's operator works on a bounded parameter")
sup_required_operator()
    if xvr_no_library() then return

    assert_eq(sup_ran(raw"""
        trait Word: Add + Mul
            width(self) -> int
        f[T: Word](a: T, b: T) -> T = a * b + a
        impl Word for i32
            width(self) -> int = 32
        print(f(3i32, 4i32))
        """), "15\n")

@test("a parameter bounded by the requiring trait satisfies the required one")
sup_requiring_bound_satisfies_required()
    if xvr_no_library() then return

    assert_eq(sup_ran(raw"""
        trait Word: Add
            width(self) -> int
        twice[U: Add](x: U) -> U = x + x
        f[T: Word](x: T) -> T = twice(x)
        impl Word for i32
            width(self) -> int = 32
        print(f(21i32))
        """), "42\n")

@test("the requirement is transitive")
sup_requirement_is_transitive()
    if xvr_no_library() then return

    assert_eq(sup_ran(raw"""
        trait A
            a(self) -> int
        trait B: A
            b(self) -> int
        trait C: B
            c(self) -> int
        struct S
            v: int
        impl A for S
            a(self) -> int = 1
        impl B for S
            b(self) -> int = 2
        impl C for S
            c(self) -> int = 4
        f[T: C](x: T) -> int = x.a() + x.b() + x.c()
        print(f(S(0)))
        """), "7\n")

@test("a required trait may take arguments the requiring trait fixes")
sup_required_takes_fixed_arguments()
    if xvr_no_library() then return

    assert_eq(sup_ran(raw"""
        trait Into[U]
            into(self) -> U
        trait Doubling: Into[int]
            scale(self) -> int
        struct N
            v: int
        impl Into[int] for N
            into(self) -> int = self.v
        impl Doubling for N
            scale(self) -> int = 2
        f[T: Doubling](x: T) -> int = x.into() * x.scale()
        print(f(N(21)))
        """), "42\n")

@test("and the requiring trait may pass its own parameter down")
sup_requiring_passes_its_parameter()
    if xvr_no_library() then return

    assert_eq(sup_ran(raw"""
        trait Into[U]
            into(self) -> U
        trait Convert[U]: Into[U]
            tag(self) -> int
        struct N
            v: int
        impl Into[int] for N
            into(self) -> int = self.v
        impl Convert[int] for N
            tag(self) -> int = 7
        f[T: Convert[int]](x: T) -> int = x.into() + x.tag()
        print(f(N(35)))
        """), "42\n")

// -- what a bound reaches through an object -------------------------------------------------------

@test("a bound on the object's own trait is satisfied by the object")
sup_object_meets_its_own_bound()
    if xvr_no_library() then return

    assert_eq(sup_ran(sup_shape() + raw"""
        area_of[T: Shape](x: T) -> int = x.area()
        var o: &Shape = Rect(3, 4)
        print(area_of(o))
        """), "12\n")

@test("and by a raw one")
sup_raw_object_meets_its_own_bound()
    if xvr_no_library() then return

    assert_eq(sup_ran(sup_shape() + raw"""
        area_of[T: Shape](x: T) -> int = x.area()
        var r = Rect(3, 4)
        var o: *Shape = &r
        print(area_of(o))
        """), "12\n")

@test("so one generic function takes both a concrete type and the object erased from it")
sup_one_function_both_ways()
    if xvr_no_library() then return

    assert_eq(sup_ran(sup_shape() + raw"""
        area_of[T: Shape](x: T) -> int = x.area()
        var o: &Shape = Rect(3, 4)
        print(area_of(Rect(3, 4)))
        print(area_of(o))
        """), "12\n12\n")

@test("a bound on a required trait is satisfied by the object too")
sup_object_meets_required_bound()
    if xvr_no_library() then return

    assert_eq(sup_ran(sup_shape() + raw"""
        show[T: Display](x: T)
            print(x)
        end show
        var o: &Shape = Rect(3, 4)
        show(o)
        """), "a rect\n")

@test("and by a raw object, through the same requirement")
sup_raw_object_meets_required_bound()
    if xvr_no_library() then return

    assert_eq(sup_ran(sup_shape() + raw"""
        show[T: Display](x: T)
            print(x)
        end show
        var r = Rect(3, 4)
        var o: *Shape = &r
        show(o)
        """), "a rect\n")

@test("a type's own bound takes an object")
sup_type_bound_takes_object()
    if xvr_no_library() then return

    assert_eq(sup_ran(sup_shape() + raw"""
        struct Holder[T: Shape]
            held: T
        var o: &Shape = Rect(3, 4)
        var h = Holder(o)
        print(h.held.area())
        """), "12\n")

@test("an object handed on to a bound that only the requirement satisfies")
sup_object_handed_on()
    if xvr_no_library() then return

    assert_eq(sup_ran(sup_shape() + raw"""
        g[U: Display](y: U)
            print(y)
        end g
        f[T: Shape](x: T)
            g(x)
        end f
        var o: &Shape = Rect(3, 4)
        f(o)
        """), "a rect\n")

@test("a bounded call reaches a default body through the object")
sup_default_body_through_object()
    if xvr_no_library() then return

    assert_eq(sup_ran(sup_greet() + raw"""
        hail[T: Greet](x: T) -> string = x.greet()
        var o: &Greet = P("ed")
        print(hail(o))
        """), "hello, ed\n")

@test("no program may write an implementation for the object type itself")
sup_no_impl_for_object_type()
    if xvr_no_library() then return

    sup_refused(sup_ran(sup_shape() + raw"""
        impl Display for &Shape
            display(self, out: *Writer, fmt: FormatSpec) = display_pad("o".bytes, out, fmt)
        """),
        "'&Shape' has forgotten which type it holds, and an 'impl' says how one particular type " +
        "behaves — so it is written for that type, not for an object over it", "main.sysl:10:1")

@test("a for loop walks an erased iterator, the protocol being a trait like any other")
sup_for_walks_erased_iterator()
    if xvr_no_library() then return

    assert_eq(sup_ran(raw"""
        struct Countdown
            n: int

        impl Iterate for Countdown
            type Item = int
            next(*self) -> Option[int]
                if self.n <= 0 then None else
                    self.n -= 1
                    Some(self.n)
        end Countdown

        var c = Countdown(3)
        var it: *Iterate[int] = &c
        var total = 0

        for x in it do total += x

        print(total)
        """), "3\n")

@test("a multi-trait bound is met entry by entry")
sup_multi_trait_bound()
    if xvr_no_library() then return

    assert_eq(sup_ran(sup_shape() + raw"""
        both[T: Shape + Display](x: T) -> int
            print(x)
            x.area()
        end both
        var o: &Shape = Rect(3, 4)
        print(both(o))
        """), "a rect\n12\n")

    sup_refused(sup_ran(sup_shape() + raw"""
        trait Weighed
            weight(self) -> int
        both[T: Shape + Weighed](x: T) -> int = x.area() + x.weight()
        var o: &Shape = Rect(3, 4)
        print(both(o))
        """),
        "'both' requires its type parameter 'T' to implement 'Weighed', but &Shape does not",
        "main.sysl:14:7")
end sup_multi_trait_bound

@test("a weak reference to an object does not satisfy the bound")
sup_weak_object_fails_bound()
    if xvr_no_library() then return

    sup_refused(sup_ran(sup_shape() + raw"""
        area_of[T: Shape](x: T) -> int = x.area()
        var o: &Shape = Rect(3, 4)
        var w: weak Shape = o
        print(area_of(w))
        """),
        "'area_of' requires its type parameter 'T' to implement 'Shape', but weak Shape does not",
        "main.sysl:13:7")

@test("a bounded body may still not read a field, and the object changes nothing about it")
sup_bounded_body_reads_no_field()
    if xvr_no_library() then return

    sup_refused(sup_ran(sup_shape() + "wide[T: Shape](x: T) -> int = x.w\n"),
                "'T' is a type parameter, so it has no fields to read — a field is layout, and no " +
                "trait declares a property 'w' that a bound could promise instead", "main.sysl:10:33")

@test("a bounded generic recurses at the object")
sup_recurses_at_object()
    if xvr_no_library() then return

    assert_eq(sup_ran(sup_shape() + raw"""
        repeat[T: Shape](x: T, n: int) -> int
            if n <= 0 then 0 else x.area() + repeat(x, n - 1)
        end repeat
        var o: &Shape = Rect(3, 4)
        print(repeat(o, 3))
        """), "36\n")

@test("an object comes back out of a bounded function")
sup_object_comes_back()
    if xvr_no_library() then return

    assert_eq(sup_ran(sup_shape() + raw"""
        same[T: Shape](x: T) -> T = x
        var o: &Shape = Rect(3, 4)
        print(same(o).area())
        """), "12\n")

@test("a conditional implementation's condition is met by an object")
sup_conditional_condition_met_by_object()
    if xvr_no_library() then return

    assert_eq(sup_ran(sup_shape() + raw"""
        struct Box[T]
            v: T
        impl[T: Shape] Display for Box[T]
            display(self, out: *Writer, fmt: FormatSpec) = display_pad(str(self.v.area()).bytes, out, fmt)
        var o: &Shape = Rect(3, 4)
        print(Box(o))
        """), "12\n")

@test("an object over a generic trait satisfies that trait at its own arguments")
sup_generic_trait_object_own_arguments()
    if xvr_no_library() then return

    assert_eq(sup_ran(sup_sink() + raw"""
        feed[U: Sink[int]](x: U) -> int = x.take(5)
        var o: &Sink[int] = S(2)
        print(feed(o))
        """), "7\n")

    sup_refused(sup_ran(sup_sink() + raw"""
        feed[U: Sink[string]](x: U) -> int = 0
        var o: &Sink[int] = S(2)
        print(feed(o))
        """),
        "'feed' requires its type parameter 'U' to implement 'Sink[string]', but &Sink[int] does not",
        "main.sysl:9:7")
end sup_generic_trait_object_own_arguments

// -- what an object reaches -----------------------------------------------------------------------

@test("an object answers the trait's own members")
sup_object_answers_own_members()
    if xvr_no_library() then return

    assert_eq(sup_ran(sup_shape() + "var o: &Shape = Rect(3, 4)\nprint(o.area())\n"), "12\n")

@test("an object printed through print")
sup_object_printed()
    if xvr_no_library() then return

    assert_eq(sup_ran(sup_shape() + "var o: &Shape = Rect(3, 4)\nprint(o)\n"), "a rect\n")

@test("an object rendered by str")
sup_object_rendered_by_str()
    if xvr_no_library() then return

    assert_eq(sup_ran(sup_shape() + "var o: &Shape = Rect(3, 4)\nprint(str(o) + \"!\")\n"), "a rect!\n")

@test("an object padded by a format specifier")
sup_object_padded()
    if xvr_no_library() then return

    assert_eq(sup_ran(sup_shape() + raw"""
        var o: &Shape = Rect(3, 4)
        print(f"${o}%10s|")
        """), "    a rect|\n")

@test("a raw object renders the same way")
sup_raw_object_renders()
    if xvr_no_library() then return

    assert_eq(sup_ran(sup_shape() + "var r = Rect(3, 4)\nvar o: *Shape = &r\nprint(o)\n"), "a rect\n")

@test("a required trait's method is callable on the object by name")
sup_required_method_by_name()
    if xvr_no_library() then return

    assert_eq(sup_ran("import sysl.buf.byte_sink\nimport sysl.text.from_utf8\n\n" + sup_shape() + raw"""
        var o: &Shape = Rect(3, 4)
        var g = byte_sink()
        o.display(&g, FormatSpec(0, -1, false))
        print(from_utf8(g.text()).unwrap())
        """), "a rect\n")

@test("a required trait's property is a slot too")
sup_required_property_slot()
    if xvr_no_library() then return

    assert_eq(sup_ran(raw"""
        trait Sized
            size -> int
        trait Boxed: Sized
            label(self) -> string
        struct B
            v: int
        impl Sized for B
            size -> int = 9
        impl Boxed for B
            label(self) -> string = "b"
        var o: &Boxed = B(0)
        print(o.size)
        print(o.label())
        """), "9\nb\n")

@test("two implementations behind one object type render differently")
sup_two_implementations_render_differently()
    if xvr_no_library() then return

    assert_eq(sup_ran("import sysl.buf.*\n\n" + sup_shape() + raw"""
        struct Dot
            v: int
        impl Shape for Dot
            area(self) -> int = 0
        impl Display for Dot
            display(self, out: *Writer, fmt: FormatSpec) = display_pad("a dot".bytes, out, fmt)
        var xs: &Buf[&Shape] = buf()
        xs.push(Rect(3, 4))
        xs.push(Dot(0))
        for i in 0..<xs.len()
            print(xs.at(i))
        """), "a rect\na dot\n")

// `Display` is required, so its `display` is slot 0 and `Shape`'s `area` slot 1 — the property the
// table and every call site have to agree on.
@test("the required trait's slots come before the requiring trait's own")
sup_required_slots_first()
    if xvr_no_library() then return

    val out = xvr_ir(sup_main(sup_shape() + "var o: &Shape = Rect(3, 4)\nprint(o.area())\nprint(o)\n"))

    assert(out.contains("[2 x ptr] [ptr @vt.adapt.ref.Rect.display, ptr @vt.adapt.ref.Rect.area]"), out)

// -- what the declarations have to satisfy --------------------------------------------------------

@test("a trait cannot require something that is not a trait")
sup_requires_a_non_trait()
    if xvr_no_library() then return

    sup_refused(sup_ran("struct S\n    v: int\ntrait T: S\n    m(self) -> int\n"),
                "trait 'T' requires 'S', which is not a trait", "main.sysl:3:10")

@test("a required trait is held to its arity")
sup_required_arity()
    if xvr_no_library() then return

    sup_refused(sup_ran("trait Into[U]\n    into(self) -> U\ntrait T: Into\n    m(self) -> int\n"),
                "trait 'Into' takes 1 type argument, but 0 type arguments were given", "main.sysl:3:10")

// `Self` in a requirement's arguments is the type implementing the requiring trait, exactly as it
// is in a method signature.
@test("a requirement may name the implementing type")
sup_requirement_names_self()
    if xvr_no_library() then return

    assert_eq(sup_ran(raw"""
        trait Into[U]
            into(self) -> U
        trait T: Into[Self]
            m(self) -> int
        struct P
            v: int
        impl Into[P] for P
            into(self) -> P = P(self.v)
        impl T for P
            m(self) -> int = self.v
        print(P(7).into().m())
        """), "7\n")

@test("written out or left to the default, it is one requirement")
sup_default_argument_is_one_requirement()
    if xvr_no_library() then return

    sup_refused(sup_ran("trait Into[U = Self]\n    into(self) -> U\ntrait T: Into[Self] + Into[int]\n" +
                        "    m(self) -> int\n"),
                "'T' requires both 'Into[Self]' and 'Into[int]', and a type implements one trait once " +
                "— so no type could satisfy both", "main.sysl:3:23")

@test("a trait may not require itself")
sup_requires_itself()
    if xvr_no_library() then return

    sup_refused(sup_ran("trait T: T\n    m(self) -> int\n"), "trait 'T' requires itself, through T -> T",
                "main.sysl:1:10")

// Each trait on the cycle is told, each from its own point of view.
@test("nor around a cycle")
sup_requires_around_a_cycle()
    if xvr_no_library() then return

    val said = sup_ran("trait A: C\n    a(self) -> int\ntrait B: A\n    b(self) -> int\ntrait C: B\n" +
                       "    c(self) -> int\n")

    sup_refused(said, "trait 'C' requires itself, through C -> B -> A -> C", "main.sysl:1:10")
    sup_refused(said, "trait 'A' requires itself, through A -> C -> B -> A", "main.sysl:3:10")
    sup_refused(said, "trait 'B' requires itself, through B -> A -> C -> B", "main.sysl:5:10")
end sup_requires_around_a_cycle

@test("two traits that declare one name cannot both be required")
sup_two_required_declare_one_name()
    if xvr_no_library() then return

    sup_refused(sup_ran("trait L\n    len(self) -> int\ntrait R\n    len(self) -> int\ntrait Both: L + R\n" +
                        "    m(self) -> int\n"),
                "'R' and 'L' both declare 'len', and a trait's members become the implementing type's " +
                "— so 'Both' cannot require both", "main.sysl:5:17")

@test("and neither may a required trait collide with the requiring trait's own member")
sup_required_collides_with_own()
    if xvr_no_library() then return

    sup_refused(sup_ran("trait L\n    len(self) -> int\ntrait Own: L\n    len(self) -> int\n"),
                "'L' and 'Own' both declare 'len', and a trait's members become the implementing type's " +
                "— so 'Own' cannot require both", "main.sysl:3:12")

@test("one trait cannot be required at two argument lists")
sup_required_at_two_argument_lists()
    if xvr_no_library() then return

    sup_refused(sup_ran("trait Into[U]\n    into(self) -> U\ntrait Both: Into[int] + Into[bool]\n" +
                        "    tag(self) -> int\n"),
                "'Both' requires both 'Into[int]' and 'Into[bool]', and a type implements one trait once " +
                "— so no type could satisfy both", "main.sysl:3:25")

@test("and the two are compared as types, not as they were written")
sup_requirements_compared_as_types()
    if xvr_no_library() then return

    assert_eq(sup_ran(raw"""
        trait Into[U]
            into(self) -> U
        trait Both: Into[int] + Into[i32]
            tag(self) -> int
        struct S
            v: int
        impl Into[int] for S
            into(self) -> int = self.v
        impl Both for S
            tag(self) -> int = 1
        print(S(7).into() + S(0).tag())
        """), "8\n")

@test("a trait required directly and transitively is carried once")
sup_required_directly_and_transitively()
    if xvr_no_library() then return

    assert_eq(sup_ran(raw"""
        trait Base
            base(self) -> int
        trait L: Base
            l(self) -> int
        trait D: L + Base
            d(self) -> int
        struct T
            v: int
        impl Base for T
            base(self) -> int = 1
        impl L for T
            l(self) -> int = 2
        impl D for T
            d(self) -> int = 4
        var p: &D = T(0)
        print(p.base() + p.l() + p.d())
        """), "7\n")

@test("a trait required by two routes is carried once")
sup_diamond_carried_once()
    if xvr_no_library() then return

    assert_eq(sup_ran(raw"""
        trait Base
            base(self) -> int
        trait L: Base
            l(self) -> int
        trait R: Base
            r(self) -> int
        trait D: L + R
            d(self) -> int
        struct S
            v: int
        impl Base for S
            base(self) -> int = 1
        impl L for S
            l(self) -> int = 2
        impl R for S
            r(self) -> int = 4
        impl D for S
            d(self) -> int = 8
        var o: &D = S(0)
        print(o.base() + o.l() + o.r() + o.d())
        """), "15\n")

// -- what an implementation has to supply ---------------------------------------------------------

private sup_greet_unmet() -> string = raw"""
    trait Named
        name(self) -> string
    trait Greet: Named
        greet(self) -> string
    struct P
        v: int
    impl Greet for P
        greet(self) -> string = "hi"
    """

@test("an impl of a requiring trait needs the required one too")
sup_impl_needs_required()
    if xvr_no_library() then return

    sup_refused(sup_ran(sup_greet_unmet()),
                "'Greet' requires 'Named', so 'P' has to implement that too — write 'impl Named for P'",
                "main.sysl:7:1")

@test("the implementation that supplies it may be written below the one that needs it")
sup_supplying_impl_below()
    if xvr_no_library() then return

    assert_eq(sup_ran(raw"""
        trait Named
            name(self) -> string
        trait Greet: Named
            greet(self) -> string = "hello, " + self.name()
        struct P
            v: int
        impl Greet for P
        impl Named for P
            name(self) -> string = "ed"
        print(P(0).greet())
        """), "hello, ed\n")

@test("a requirement reaches through a generic impl's own condition")
sup_requirement_through_generic_condition()
    if xvr_no_library() then return

    sup_refused(sup_ran(raw"""
        trait Named
            name(self) -> string
        trait Greet: Named
            greet(self) -> string
        struct Box[T]
            v: T
        impl[T: Named] Named for Box[T]
            name(self) -> string = self.v.name()
        impl[T] Greet for Box[T]
            greet(self) -> string = "hi"
        """),
        "'Greet' requires 'Named', so 'Box' has to implement that too — write an implementation of " +
        "'Named' for Box[T]", "main.sysl:9:1")

@test("and is met when the conditions agree")
sup_met_when_conditions_agree()
    if xvr_no_library() then return

    assert_eq(sup_ran(raw"""
        trait Named
            name(self) -> string
        trait Greet: Named
            greet(self) -> string = "hello, " + self.name()
        struct Box[T]
            v: T
        impl[T: Named] Named for Box[T]
            name(self) -> string = self.v.name()
        impl[T: Named] Greet for Box[T]
        struct P
            v: int
        impl Named for P
            name(self) -> string = "ed"
        print(Box(P(0)).greet())
        """), "hello, ed\n")

@test("a built-in meets a requirement the compiler already provides")
sup_builtin_meets_provided_requirement()
    if xvr_no_library() then return

    assert_eq(sup_ran(raw"""
        trait Word: Add
            width(self) -> int
        impl Word for i32
            width(self) -> int = 32
        print(3i32.width())
        """), "32\n")

@test("a required trait may be supplied by an impl for a shape")
sup_required_supplied_for_a_shape()
    if xvr_no_library() then return

    assert_eq(sup_ran(raw"""
        trait Show
            show(self) -> string
        trait Pretty: Show
            pretty(self) -> string = "pretty " + self.show()
        impl[T] Show for []T
            show(self) -> string = "slice"
        impl[T] Pretty for []T
        var xs: []int = [1, 2, 3]
        print(xs.pretty())
        """), "pretty slice\n")

@test("an empty impl satisfies a requirement whose members are all defaults")
sup_empty_impl_satisfies_defaults()
    if xvr_no_library() then return

    assert_eq(sup_ran(raw"""
        trait Greeting
            hello(self) -> string = "hi"
        trait Polite: Greeting
            please(self) -> string = self.hello() + ", please"
        struct P
            v: int
        impl Greeting for P
        impl Polite for P
        print(P(0).please())
        """), "hi, please\n")

// -- what erasure still refuses -------------------------------------------------------------------

@test("an object may not be erased a second time, into the object of a trait it requires")
sup_object_not_erased_twice()
    if xvr_no_library() then return

    sup_refused(sup_ran(sup_greet() + "var o: &Greet = P(\"ed\")\nvar q: &Named = o\n"),
                "a &Greet has forgotten which type it holds, so there is nothing for a &Named to be " +
                "built from — 'Named' is reachable *through* the value, and a bound on it is satisfied " +
                "by one, but its slots are not a table of their own", "main.sysl:11:17")

    // The reason is erasure rather than the requirement, so it reads the same for a trait the
    // object's own trait says nothing about.
    sup_refused(sup_ran(sup_greet() + raw"""
        trait Other
            other(self) -> int
        var o: &Greet = P("ed")
        var q: &Other = o
        """),
        "a &Greet has forgotten which type it holds, so there is nothing for a &Other to be built " +
        "from — 'Other' is reachable *through* the value, and a bound on it is satisfied by one, but " +
        "its slots are not a table of their own", "main.sysl:13:17")
end sup_object_not_erased_twice

@test("a trait that requires an unerasable one has no object")
sup_requires_unerasable()
    if xvr_no_library() then return

    sup_refused(sup_ran("trait Word: Add\n    width(self) -> int\nvar w: &Word = 1i32\n"),
                "'add' of 'sysl.Add' mentions 'Self' away from its receiver, and an erased value has " +
                "forgotten which type that is — so there is no '&Word' to form", "main.sysl:3:9")

@test("an object over a trait that requires nothing printable is still refused")
sup_unprintable_object_refused()
    if xvr_no_library() then return

    sup_refused(sup_ran(raw"""
        trait Shape
            area(self) -> int
        struct Rect
            w: int
            h: int
        impl Shape for Rect
            area(self) -> int = self.w * self.h
        impl Display for Rect
            display(self, out: *Writer, fmt: FormatSpec) = display_pad("r".bytes, out, fmt)
        var o: &Shape = Rect(3, 4)
        print(o)
        """),
        "cannot print a &Shape value — an object offers what its trait declares and what that trait " +
        "requires, so write 'trait Shape: sysl.Display' to keep the rendering the value had before " +
        "it was erased", "main.sysl:11:1")

@test("a built-in that satisfies a required trait by rule cannot be erased")
sup_builtin_by_rule_not_erased()
    if xvr_no_library() then return

    sup_refused(sup_ran(raw"""
        trait Tagged: Add[int, int]
            tag(self) -> int
        impl Tagged for i32
            tag(self) -> int = 7
        var o: &Tagged = 1i32
        """),
        "int implements 'sysl.Add' by the compiler's own rule rather than through an 'impl', so " +
        "there is no 'add' for a slot of 'Tagged' to point at", "main.sysl:5:18")

@test("while one that satisfies it through an impl erases and dispatches")
sup_builtin_through_impl_erases()
    if xvr_no_library() then return

    assert_eq(sup_ran(raw"""
        trait Tagged: Display
            tag(self) -> int
        impl Tagged for i32
            tag(self) -> int = 7
        var o: &Tagged = 1i32
        print(o, o.tag())
        """), "1 7\n")

@test("and so does one that requires Hash, which used to be the counter-example")
sup_builtin_requiring_hash_erases()
    if xvr_no_library() then return

    assert_eq(sup_ran(raw"""
        trait Tagged: Hash
            tag(self) -> int
        impl Tagged for i32
            tag(self) -> int = 7
        var o: &Tagged = 1i32
        print(o.hash() != 0u64, o.tag())
        """), "true 7\n")

@test("a required trait's '&self' method names both the trait and the sigil to write")
sup_required_ref_self_method()
    if xvr_no_library() then return

    sup_refused(sup_ran(raw"""
        trait Counted
            bump(&self) -> int
        trait Thing: Counted
            id(self) -> int
        struct S
            v: int
        impl Counted for S
            bump(&self) -> int = self.v
        impl Thing for S
            id(self) -> int = 1
        var s = S(2)
        var o: *Thing = &s
        """),
        "'bump' of 'Counted' takes '&self', so it needs its receiver inside a reference-counted box " +
        "— '*Thing' points straight at a value, so write '&Thing' instead", "main.sysl:12:9")

@test("a type missing a required trait is told that, not told about the compiler's rules")
sup_missing_required_trait_told_so()
    if xvr_no_library() then return

    val said = sup_ran(sup_greet_unmet() + "var o: &Greet = P(1)\n")

    sup_refused(said, "'Greet' requires 'Named', and P does not implement it — so there is no 'name' " +
                "for its table to point at", "main.sysl:9:17")
    assert(!said.contains("by the compiler's own rule"), said)
end sup_missing_required_trait_told_so

@test("a method no trait in the closure declares is still refused")
sup_undeclared_method_refused()
    if xvr_no_library() then return

    sup_refused(sup_ran(sup_shape() + "var o: &Shape = Rect(3, 4)\nprint(o.volume())\n"),
                "trait 'Shape' declares no method 'volume' — it has 'display', 'area'", "main.sysl:11:9")

// Reported at the declaration that made the promise, not at the `impl` that cannot keep it. The
// message names the file the private trait is scoped to, which is the temporary tree's.
@test("a trait may not require one that reaches less far than it does")
sup_requirement_less_visible()
    if xvr_no_library() then return

    val said = xvr_ran([("main.sysl", "import m.Open\nprint(1)\n"),
                        ("m/m.sysl", "module m\nprivate trait Hidden\n    secret(self) -> int\n" +
                                     "trait Open: Hidden\n    shown(self) -> int\n")])

    assert(said.contains("error: 'Open' is public, but the trait it requires names 'm.Hidden', which is " +
                         "private to '"), said)
    assert(said.contains("/m/m.sysl', the file that declares it — a declaration may not be more visible " +
                         "than the types it names\n"), said)
    assert(said.contains("/m/m.sysl:4:13\n"), said)
end sup_requirement_less_visible

// -- what it costs a program that requires nothing ------------------------------------------------

@test("a trait with no requirements has the table it always had")
sup_no_requirements_same_table()
    if xvr_no_library() then return

    val out = xvr_ir(sup_main(raw"""
        trait Shape
            area(self) -> int
            perimeter(self) -> int
        struct Rect
            w: int
            h: int
        impl Shape for Rect
            area(self) -> int = self.w * self.h
            perimeter(self) -> int = 2 * (self.w + self.h)
        var o: &Shape = Rect(3, 4)
        print(o.area())
        """))

    assert(out.contains("[2 x ptr] [ptr @vt.adapt.ref.Rect.area, ptr @vt.adapt.ref.Rect.perimeter]"), out)
end sup_no_requirements_same_table
