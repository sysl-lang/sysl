module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture
import sysl.text.Search

// `__VERSION__`: the `version` in the `package.hocon` of the package or program whose file writes it.
// It is per package the way `__FILE__` is per file, so a dependency's files answer with the
// dependency's own version and never with the consumer's; it folds to a string literal, so a `const`
// may hold it; and a file with no manifest above it, or a manifest that declares no version, is
// refused at the use.

private ver_ready() -> bool = std_root().is_ok() && clang_available()

private ver_temp() -> string = absolute_path(make_temp_dir("sysl-ver").unwrap())

private ver_manifest(name: string, version: string, deps: string) -> string
    val stated = if version.is_empty() then "" else s", version = \"$version\""

    s"package { name = \"$name\"$stated }\n" +
    (if deps.is_empty() then "" else s"dependencies { $deps }\n")

// A project with the given manifest (none where it is empty) and one program file at its root.
private ver_app(config: string, program: string) -> string
    val root = ver_temp()

    if !config.is_empty() then write_text(s"$root/package.hocon", config).unwrap()

    write_text(s"$root/main.sysl", program).unwrap()
    root
end ver_app

// A package on disk at `version`, holding one module `engine`.
private ver_dependency(version: string, text: string) -> string
    val root = ver_temp()

    make_dir_all(s"$root/engine").unwrap()
    write_text(s"$root/package.hocon", ver_manifest("engine", version, "")).unwrap()
    write_text(s"$root/engine/engine.sysl", s"module engine\n\n$text\n").unwrap()
    root
end ver_dependency

// What the program a build of `root` makes prints, or what stopped it.
private ver_run(root: string) -> string
    reset_feature_request()

    val out_dir = ver_temp()

    val said = build_native_program(root, None, None, DefaultOptimization, Some(s"$out_dir/program")) match
        Err(why) -> s"refused: ${failure_text(why)}"
        Ok(made) ->
            capture(made, [], "", [], true) match
                Err(_) -> "the program that was built could not be run"
                Ok(out) -> if out.status.ok() then out.text else s"exited badly: ${out.text}"

    remove_dir_all(out_dir).unwrap_or(())
    said
end ver_run

// The first diagnostic `sysl build <root>` renders.
private ver_build_says(root: string) -> string
    var lines: Buf[string] = buf()
    val sink = &lines

    run_cli(["sysl", "build", root], (line) -> sink.push(line))

    if lines.is_empty() then "" else lines.at(0)

// `root` refused with `message` at `main.sysl:line:col`.
private ver_refused(root: string, message: string, line: int, col: int)
    val said = ver_build_says(root)
    val head = s"error: $message\n --> $root/main.sysl:$line:$col\n"

    assert(said.starts_with(head), s"expected\n$head\ngot\n$said")

@test("__VERSION__ is the version in the program's own package.hocon")
ver_the_programs_own_version()
    if !ver_ready() then return

    val root = ver_app(ver_manifest("app", "1.2.3", ""), "print(__VERSION__)\n")

    assert_eq(ver_run(root), "1.2.3\n")
    remove_dir_all(root).unwrap_or(())

@test("a dependency's __VERSION__ is its own version, never the consumer's")
ver_a_dependency_reports_its_own_version()
    if !ver_ready() then return

    val dep = ver_dependency("4.5.6", "tag() -> string = __VERSION__")
    val root = ver_app(ver_manifest("app", "1.2.3", s"engine { path = \"$dep\" }"),
                       "print(engine.tag())\nprint(__VERSION__)\n")

    assert_eq(ver_run(root), "4.5.6\n1.2.3\n")
    remove_dir_all(root).unwrap_or(())
    remove_dir_all(dep).unwrap_or(())

@test("a default of __VERSION__ is the declaring package's, whoever calls it")
ver_a_default_is_the_declaring_packages()
    if !ver_ready() then return

    val dep = ver_dependency("4.5.6", "stamp(v: string = __VERSION__) -> string = v")
    val root = ver_app(ver_manifest("app", "1.2.3", s"engine { path = \"$dep\" }"),
                       "print(engine.stamp())\n")

    assert_eq(ver_run(root), "4.5.6\n")
    remove_dir_all(root).unwrap_or(())
    remove_dir_all(dep).unwrap_or(())

@test("__VERSION__ folds, so a const and a module val may hold it")
ver_folds_into_a_const()
    if !ver_ready() then return

    val dep = ver_dependency("4.5.6", "const V: string = __VERSION__\nval W: string = __VERSION__\n" +
                                      "tag() -> string = V + \"/\" + W")
    val root = ver_app(ver_manifest("app", "1.2.3", s"engine { path = \"$dep\" }"),
                       "const MINE: string = __VERSION__\nprint(MINE)\nprint(engine.tag())\n")

    assert_eq(ver_run(root), "1.2.3\n4.5.6/4.5.6\n")
    remove_dir_all(root).unwrap_or(())
    remove_dir_all(dep).unwrap_or(())

@test("__VERSION__ in a file that is not part of a package is refused at the use")
ver_refused_outside_a_package()
    if !ver_ready() then return

    val root = ver_app("", "print(__VERSION__)\n")

    ver_refused(root, "'__VERSION__' is the 'version' in package.hocon, and this file is not part " +
                      "of a package — no package.hocon stands at the root of its tree", 1, 7)
    remove_dir_all(root).unwrap_or(())

@test("__VERSION__ under a package.hocon that declares no version is refused, naming the manifest")
ver_refused_without_a_version()
    if !ver_ready() then return

    val root = ver_app(ver_manifest("app", "", ""), "val v = 1\nprint(__VERSION__)\n")

    ver_refused(root, s"'__VERSION__' is the 'version' in package.hocon, and $root/package.hocon " +
                      "declares none", 2, 7)
    remove_dir_all(root).unwrap_or(())

@test("a const of __VERSION__ outside a package is refused in the same words, at the use")
ver_a_const_is_refused_in_the_same_words()
    if !ver_ready() then return

    val root = ver_app("", "const V: string = __VERSION__\nprint(V)\n")

    ver_refused(root, "'__VERSION__' is the 'version' in package.hocon, and this file is not part " +
                      "of a package — no package.hocon stands at the root of its tree", 1, 19)
    remove_dir_all(root).unwrap_or(())
