// `m[k] += 1` on an ordered map: `IndexPlace[K, V]` with a non-integer, generic key, answering the
// address of a value in a node's slot storage, and a `ref` naming one.

struct Sorted[K: Ord, V]
    keys: []K
    vals: []V
    len: usize

    at(self, k: K) -> usize
        var i: usize = 0

        while i < self.len && self.keys[i] < k
            i += 1

        if i == self.len || k < self.keys[i] then panic("no such key")
        i
    end at

    @relocates
    put(*self, k: K, v: V)
        slot_place(self.keys, self.len, k)
        slot_place(self.vals, self.len, v)
        self.len += 1
end Sorted

impl[K: Ord, V] IndexPlace[K, V] for Sorted[K, V]
    index_place(*self, k: K) -> *V = &self.vals[self.at(k)]

var m: Sorted[string, int] = Sorted(slot_storage(4), slot_storage(4), 0)

m.put("a", 1)
m.put("b", 2)
m["b"] += 40
print(m["a"], m["b"])

if true
    ref b = m["b"]

    b += 100

print(m["b"])
