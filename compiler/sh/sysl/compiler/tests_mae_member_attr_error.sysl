module sh.sysl.compiler
@tests

import sysl.text.Search

// An annotation written above a member -- a method, an associated function, a field or an enum
// variant. Only the ones about a parameter, and the three about the function a member lowers to,
// may stand there; the rest are about a free function or about a type, and the refusal says so with
// the caret on the '@' itself, since that is the line the reader has to change.
//
// Every message and every 'line:column' here was read out of the reference compiler (0.0.162).

private mae_member() -> string =
    "the only annotations a member may carry are the ones about a parameter — '@crossing', '@borrows', '@lends', '@reads' and '@writes' — and the four about the function it lowers to, '@noinline', '@inline', '@cold' and '@no_alloc'. What the rest say is about a free function or about a type: what 'sysl test' calls, what recurses, what a symbol names, how fields are laid out. A member is neither, so it goes above a free function instead ('06')"

private mae_assert() -> string =
    "'@assert' stands where a declaration stands, and a type's body holds its members — write it beside the type rather than inside it, where 'sizeof' and 'offsetof' still name what it is about"

// -- an annotation above a member is refused with a sentence ------------------------------------

// The '@' follows a field, so the member block had already read a line and ended at the annotation.
@test("a method inside a struct, after a field")
mae_method_after_field()
    val src = "struct S\n    v: int\n\n    @tailrec\n    take(self, n: int) -> int = n\n\nmain() =\n    print(1)\n"

    assert_eq(pf_err(src), mae_member())
    assert_eq(pf_at(src), "4:5")

// With no member read yet the block has nothing to end, and the refusal is still this one.
@test("a method inside a struct, as the block's first line")
mae_method_first_line()
    val src = "struct S\n    @test\n    f(self) -> int = 1\n\nmain() =\n    print(1)\n"

    assert_eq(pf_err(src), mae_member())
    assert_eq(pf_at(src), "2:5")

// A layout annotation above a field is told what the attribute is about instead of the member rule,
// which is about functions (keel FINDINGS 30) -- a deliberate departure from 0.0.162's wording.
@test("'@align(n)' above a field says where a boundary is written, and how a field gets one")
mae_field()
    val src = "struct S\n    @align(8)\n    v: int\n\nmain() =\n    print(1)\n"

    assert_eq(pf_err(src),
        "'@align(n)' is the boundary a whole struct begins on, or one 'var' or 'val''s storage, so it stands above the struct or the binding — a field begins on its own type's boundary, so a field that needs a wider one takes a type declared '@align(n)', which carries the boundary to every value of it, a field included")
    assert_eq(pf_at(src), "2:5")

@test("'@packed' above a field says it lays out a whole struct")
mae_packed_field()
    val src = "struct S\n    @packed\n    v: int\n\nmain() =\n    print(1)\n"

    assert_eq(pf_err(src),
        "'@packed' says how a struct's fields are laid out, so it stands above the struct — a field or another member has no fields of its own to pack")
    assert_eq(pf_at(src), "2:5")

// The ones a member may carry are about a parameter, and a field has none.
@test("one of the three above a field, which has no parameters to name")
mae_parameter_one_above_field()
    val src = "struct S\n    @crossing(v)\n    v: int\n\nmain() =\n    print(1)\n"

    assert_eq(pf_err(src),
        "'@crossing', '@reads' and '@writes' are about a parameter, so they stand above a method or an associated function — a field and a variant have none, and there is nothing for one of them to name there")
    assert_eq(pf_at(src), "3:5")

@test("a member of an enum")
mae_enum_member()
    val src = "enum E\n    A\n    B\n\n    @pure\n    tag(self) -> int = 0\n\nmain() =\n    print(1)\n"

    assert_eq(pf_err(src), mae_member())
    assert_eq(pf_at(src), "5:5")

@test("a variant")
mae_variant()
    val src = "enum E\n    @test\n    A\n\nmain() =\n    print(1)\n"

    assert_eq(pf_err(src), mae_member())
    assert_eq(pf_at(src), "2:5")

@test("a member of a trait")
mae_trait_member()
    val src = "trait T\n    @pure\n    f(self) -> int\n\nmain() =\n    print(1)\n"

    assert_eq(pf_err(src), mae_member())
    assert_eq(pf_at(src), "2:5")

@test("a member of an impl block")
mae_impl_member()
    val src = "trait T\n    f(self) -> int\n\nstruct S\n    v: int\n\nimpl T for S\n    @test\n    f(self) -> int = self.v\n\nmain() =\n    print(1)\n"

    assert_eq(pf_err(src), mae_member())
    assert_eq(pf_at(src), "8:5")

// An indented '#' never reaches the directive pass, so the member rule answers it and names the sigil.
@test("'#' above a member is answered by the member rule, with the sigil named")
mae_hash_above_member()
    val src = "struct S\n    v: int\n\n    #test\n    f(self) -> int = self.v\n\nmain() =\n    print(1)\n"

    assert_eq(pf_err(src),
        mae_member() + ". An annotation is written '@' in any case — '#' opens a directive, which gates lines before the lexer sees them and sits at the margin")
    assert_eq(pf_at(src), "4:5")

// The member rule answers an indented '#' whatever word follows it -- one a member may carry, and
// above a field too.
@test("'#' above a member is refused even before a word a member may carry")
mae_hash_before_a_member_word()
    val src = "struct S\n    v: int\n\n    #inline\n    f(self) -> int = self.v\n\nmain() =\n    print(1)\n"

    assert_eq(pf_err(src),
        mae_member() + ". An annotation is written '@' in any case — '#' opens a directive, which gates lines before the lexer sees them and sits at the margin")
    assert_eq(pf_at(src), "4:5")

    val field = "struct S\n    #test\n    v: int\n\nmain() =\n    print(1)\n"

    assert(pf_err(field).contains("'#' opens a directive"), pf_err(field))
    assert_eq(pf_at(field), "2:5")

// Deleting the annotation is not what the reader wanted, so the sentence says where it goes instead
// -- and names the sigil only where it was the wrong one.
@test("the sentence names where the annotation goes instead")
mae_names_where_it_goes()
    val msg = pf_err("struct S\n    @test\n    f(self) -> int = 1\n\nmain() =\n    print(1)\n")

    assert(msg.contains("above a free function"), msg)
    assert(msg.contains("'sysl test'"), msg)
    assert(msg.contains("'@crossing'"), msg)
    assert(msg.contains("'@reads'"), msg)
    assert(!msg.contains("'#' opens a directive"), msg)

// -- '@assert' inside a type's body is told what it is, not what annotations mark ----------------

@test("inside a struct")
mae_assert_inside_struct()
    val src = "struct S\n    v: int\n\n    @assert(sizeof(S) == 8)\n\nmain() =\n    print(1)\n"

    assert_eq(pf_err(src), mae_assert())
    assert_eq(pf_at(src), "4:5")

@test("inside an impl block")
mae_assert_inside_impl()
    val src = "trait T\n    f(self) -> int\n\nstruct S\n    v: int\n\nimpl T for S\n    @assert(1 == 1)\n    f(self) -> int = self.v\n\nmain() =\n    print(1)\n"

    assert_eq(pf_err(src), mae_assert())
    assert_eq(pf_at(src), "8:5")

// -- the blocks still read what they read before ------------------------------------------------

@test("a struct with fields, a member, an invariant and a visibility modifier")
mae_struct_still_reads()
    val src = "struct S\n    private v: int\n    w: int\n\n    invariant v > 0\n\n    private sum(self) -> int = self.v + self.w\n    scale -> int = self.v\n\nmain() =\n    print(1)\n"

    assert_eq(pf_err(src), "")
    assert(pf_kept(src) == 2)

@test("an impl block still refuses a visibility modifier on its member")
mae_impl_refuses_visibility()
    val src = "trait T\n    f(self) -> int\n\nstruct S\n    v: int\n\nimpl T for S\n    private f(self) -> int = self.v\n\nmain() =\n    print(1)\n"

    assert_eq(pf_err(src),
        "a trait's members and an 'impl' block's carry no visibility of their own — a trait's member is as visible as the trait, and an implementation supplies what the trait asked for")
    assert_eq(pf_at(src), "8:13")

// The caret sits on what the modifier was written in front of: the scoped form's bracket, and a
// trait's own member.
@test("the visibility refusal points past the modifier")
mae_visibility_caret()
    assert_eq(pf_at("trait T\n    f(self) -> int\n\nstruct S\n    v: int\n\nimpl T for S\n    private[sysl] f(self) -> int = self.v\n\nmain() =\n    print(1)\n"), "8:12")
    assert_eq(pf_at("trait T\n    private f(self) -> int\n\nmain() =\n    print(1)\n"), "2:13")

@test("a type's own member still refuses 'override'")
mae_member_refuses_override()
    val src = "struct S\n    v: int\n\n    override f(self) -> int = self.v\n\nmain() =\n    print(1)\n"

    assert_eq(pf_err(src),
        "'override' says a member replaces a body its trait supplied, and it is written on that member inside the 'impl' block — a trait's own member is where a default is written rather than replaced, and a member of a type's body implements no trait")
    assert_eq(pf_at(src), "4:14")
