module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// What a trait **requires** of the types that implement it, checked at the declaration once every
// trait is registered -- `trait Ord: Eq` is ordinary whichever of the two is written first.
//
// Four things are answered, all about the declarations rather than any use: each required trait is
// a trait, applied to as many arguments as it declares; the requirements do not come back around to
// the trait that made them; one trait is not required at two argument lists; and no two traits in
// the closure declare a member of one name. The last two are one rule seen twice -- a trait's members
// become the implementing type's, and a type's members are one namespace.
//
// **Each trait's walk stops at its first complaint**, which is the recovery region the reference
// gives it: a cycle would otherwise be reported once per lap, and a collision once per member.

struct SuperWalk
    root: string
    visited: Buf[(string, Bound)]
    declares: Buf[(string, string)]
end SuperWalk

check_trait_supers(a: &Analysis, key: string, d: TraitDecl)
    var w = SuperWalk(key, buf(), buf())

    w.visited.push((key, plain_bound(key, buf())))

    for method in d.methods
        w.declares.push((method.name, qualified_name(key)))

    var path: Buf[string] = buf()

    path.push(key)
    walk_required(a, &w, key, path, None)
end check_trait_supers

// The requirements `name` writes, each read in the terms of the trait that WROTE it: which trait a
// short name reaches is what that trait's own file imported. False once something was said. `top` is
// the root's own requirement the walk went down through, where a clash between two routes is told.
private walk_required(a: &Analysis, w: *SuperWalk, name: string, path: Buf[string],
                      top: Option[(Scope, Span)]) -> bool
    val found = trait_decl_at(a, name)

    if found.is_none() then return true

    val tr = found.unwrap()
    val scope = trait_scope_of(a, name)

    // `Self` is the type implementing the requiring trait, which nothing here is yet, so it stands in
    // for itself -- enough for the arguments to resolve and for two requirements of one trait to be
    // compared, and the same stand-in whether it was written out or arrived from a default.
    var subst: Buf[Binding] = buf()

    for tparam in tr.tparams
        subst.push(Binding(tparam, Abstract(tparam, buf())))

    subst.push(Binding("Self", Abstract("Self", buf())))

    for s in tr.supers
        val skey = lookup_trait_key(a, scope, s.name)

        if skey.is_none()
            a.fault(scope, s.span, s"trait '${qualified_name(name)}' requires '${s.name}', which is not " +
                    "a trait")
            return false
        end if

        val sk = skey.unwrap()
        val sdecl = trait_decl_at(a, sk).unwrap()

        // A requirement that **fixes** an associated type (`Seq[Item = int]`) is held at every `impl`
        // of the requiring trait (`check_impl_supers`), and a generic body bounded by the requiring
        // trait reads the projection as the fixed type (`abstract_assoc`). One that **bounds** one
        // (`Seq[Item: Render]`) is held at every `impl` too and only adds to what the projection offers.
        var positional: usize = 0

        for arg in s.args
            *arg.kind match
                AssocArgType(_, _) -> ()
                AssocBoundArgType(_, _) -> ()
                _ -> positional += 1

        if positional > sdecl.tparams.len() || positional < least_trait_args(sdecl)
            var unknown: Buf[Type] = buf()

            for k in 0..<positional
                unknown.push(Unknown)

            check_trait_arity_at(a, scope, s.span, s.name, sdecl, unknown)
            return false
        end if

        val mark = a.complaints()
        val bound = resolve_bound(a, scope, s.span, s, subst)

        if a.complaints() != mark then return false

        val at = index_of_name(path, sk)

        if at.is_some()
            var chain = ""

            for k in at.unwrap()..<path.len()
                chain = chain + qualified_name(path[k]) + " -> "

            a.fault(scope, s.span, s"trait '${qualified_name(sk)}' requires itself, through " +
                    chain + qualified_name(sk))
            return false
        end if

        val first = visited_bound(*w, sk)

        if first.is_some()
            if first.unwrap().key() != bound.key()
                a.fault(scope, s.span, s"'${qualified_name(w.root)}' requires both " +
                        s"'${first.unwrap().show()}' and '${bound.show()}', and a type implements one " +
                        "trait once — so no type could satisfy both")
                return false
            end if

            // Two routes to one trait that fix one of its associated types differently ask a type
            // to choose two answers for it.
            val clash = fixed_clash(first.unwrap(), bound)

            if clash.is_some()
                val (n, x, y) = clash.unwrap()
                val (at_scope, at_span) = top.unwrap_or((scope, s.span))

                a.fault(at_scope, at_span, s"'${qualified_name(w.root)}' requires '${qualified_name(sk)}' " +
                        s"with its '$n' fixed both as ${type_show(x)} and as ${type_show(y)}, and a type " +
                        "chooses one type for it — so no type could satisfy both")
                return false
            end if

            w.visited[visited_at(*w, sk)] = (sk, merged_fixes(first.unwrap(), bound))
        else
            w.visited.push((sk, bound))

            for k in 0..<sdecl.methods.len()
                val m = sdecl.methods[k].name
                val other = declared_by(*w, m)

                if other.is_some()
                    a.fault(scope, s.span, s"'${qualified_name(sk)}' and '${other.unwrap()}' both " +
                            s"declare '$m', and a trait's members become the implementing type's — " +
                            s"so '${qualified_name(w.root)}' cannot require both")
                    return false
                end if

                w.declares.push((m, qualified_name(sk)))

            var deeper: Buf[string] = buf()

            for k in 0..<path.len()
                deeper.push(path[k])

            deeper.push(sk)

            if !walk_required(a, w, sk, deeper, Some(top.unwrap_or((scope, s.span)))) then return false

    true
end walk_required

private index_of_name(xs: Buf[string], name: string) -> Option[usize]
    for i in 0..<xs.len()
        if xs[i] == name then return Some(i)

    None
end index_of_name

private visited_at(w: SuperWalk, key: string) -> usize
    for i in 0..<w.visited.len()
        if w.visited[i].0 == key then return i

    0
end visited_at

// The first associated type two bounds on one trait both fix, to types that differ. A type that
// mentions a trait's own parameter is read with the parameter standing for itself, which says nothing
// about the type a use will give it, so only types with none are compared.
private fixed_clash(x: Bound, y: Bound) -> Option[(string, Type, Type)]
    for p in x.assocs
        for q in y.assocs
            if p.0 != q.0 || p.1 == Unknown || q.1 == Unknown then continue
            if mentions_abstract(p.1) || mentions_abstract(q.1) then continue

            if !type_eq(p.1, q.1)
                return Some((p.0, p.1, q.1))

    None
end fixed_clash

// One bound on a trait carrying what either of two routes to it fixed.
private merged_fixes(x: Bound, y: Bound) -> Bound
    var assocs = x.assocs.copy()

    for q in y.assocs
        var held = false

        for p in assocs
            if p.0 == q.0 then held = true

        if !held then assocs.push(q)

    Bound(x.name, x.args, assocs, x.bounded)
end merged_fixes

private visited_bound(w: SuperWalk, key: string) -> Option[Bound]
    for item in w.visited
        if item.0 == key then return Some(item.1)

    None
end visited_bound

private declared_by(w: SuperWalk, member: string) -> Option[string]
    for item in w.declares
        if item.0 == member then return Some(item.1)

    None
end declared_by
