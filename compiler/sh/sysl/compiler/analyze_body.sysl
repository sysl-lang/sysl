module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.container.{Map, map}
import sysl.text.Search

// Typing the body a function's declaration is followed by, whatever the body is made of.
//
// **A body is a block and a block is an expression**, so one entry answers for every function: the
// parameters are bound, the contract clauses at the head are read against the signature, and the
// rest is a value block asked for the declared result. What was a single expression before is that
// same block with one statement in it.

// The functions of a compilation whose bodies this stage types, with what it had to say about them.
struct TypedBodies
    funcs: Buf[TFunc]
    reported: Buf[Placed]

    // How many declarations were read some other way: a generic one, whose bodies are the
    // instantiations below it rather than the heading, and -- kept at zero now that a type default
    // is filled where it is written -- the bodies a signature naming one used to be left for.
    skipped_generic: usize
    skipped_defaults: usize

    // How many of the functions are the ones the sources **declared** at the top level, which are
    // the first of them. What follows are the members each type's declaration lowered to and the
    // instantiations the calls asked for -- functions a program never wrote a heading for, so a test
    // reading "the last body" means the last one somebody typed.
    declared: usize

    // The module storage, in the order the object file lays it down.
    vals: Buf[TVal]

    // The tables the walk filled and the trees it read, so that what a whole program is made of --
    // its tables, its storage, its tests -- can be assembled without reading everything twice.
    an: &Analysis
    units: Buf[Program]

    // The entry point, read while there was still a pass that would go and analyze whatever it
    // reached: an entry wants a library conversion, and marking one as reached after the fixpoint
    // would name a function nothing analyzed.
    entry: Option[TEntry]

    // The statements the program starts with, and the module whose terms they were written in.
    main: Buf[TStmt]
    main_module: string
end TypedBodies

// Whether a lowered member is a copy of a trait default the walk at the trait refused.
private refused_default(a: &Analysis, name: string) -> bool
    val origin = a.tables.members.default_origin.get(name)

    if origin.is_none() then return false

    holds_string(a.tables.members.bad_defaults, origin.unwrap())
end refused_default

// Reads a compilation's declarations and types every body it can.
//
// `also_auto_imported` names modules auto-imported beside the standard one; see
// `Analysis.also_auto_imported`. Every command hands nothing.
analyze_bodies(written: Buf[Program], t: Target, also_auto_imported: Buf[string] = buf()) -> TypedBodies =
    analyze_produced(written, t, buf(), true, None, also_auto_imported)

// The same, told which of the files it was handed are the library's own being **built** rather than
// supplied. Every other caller hands nothing and gets the ordinary reading, where the library's
// bodies are typed only as something reaches them.
analyze_produced(written: Buf[Program], t: Target, producing: Buf[string],
                 has_entry_point: bool = true,
                 index: Option[&DefinitionIndex] = None,
                 also_auto_imported: Buf[string] = buf()) -> TypedBodies
    val a = analysis_producing(t, producing)

    a.index = index
    a.also_auto_imported = also_auto_imported

    val units = read_decls(a, written, has_entry_point)

    // Every declaration is read, so a body can be typed: a `const` call may run from here on.
    a.evaluation.ready = true

    var funcs: Buf[TFunc] = buf()
    var generic: usize = 0
    var defaults: usize = 0

    // **A generic body is checked once, at its definition**, with each type parameter opaque except
    // for what its bounds promise. What separates that from a template is that the body is wrong on
    // its own, so the complaint does not wait for a call site to expose it.
    //
    // It runs before any body is typed, because it is a question about declarations rather than
    // about a program: a mistake in a generic body is the same mistake whichever call reaches it
    // first, and a closure lowered while checking one is a closure this compilation lowered.
    // **A capability is settled by the text of the files alone**, so the clauses are read before
    // any name is resolved: everything downstream needs the answer already.
    read_capabilities(a, units)
    read_link_directives(a, units)

    // **Every `some` result is settled first** -- the one pass that reads a body to learn a type. It
    // waits for every declaration, since such a body may name anything the program declares, and
    // runs before every other body, any of which may ask what an associated type is.
    settle_opaque_results(a)

    check_generic_bodies(a, units)

    // **A module's storage is analyzed before any body is**, because its initializer is code like
    // any other and what it reaches is reached by the program: a `val` whose value is a call brings
    // that call's body in exactly as a function's would.
    val storage = module_storage(a)

    // And every parameter's default, for the reason the storage above is read here: a default is a
    // declaration's expression too, filled at a call but written where the declaration is, so it is
    // checked where it is written and whether or not any call takes it.
    check_value_defaults(a)

    // Every constant at a constrained type against the range it names, used or not.
    check_const_admits(a)

    // The entry file's asserts, once every constant has been folded; every other file's were settled
    // before the eager instantiation.
    check_top_level_asserts(a, units, true)

    // **The library's own functions are held back**: they are analyzed below, and only if
    // something reaches them. That is what keeps a program that never prints from carrying the
    // printing surface, and it is what makes the list of functions a compilation ends with the list
    // of functions it runs.
    var held: HeldQueue[HeldBody] = held_queue()

    // The library's exports that may answer a seam, and the symbols something else already answers
    // (`seam_supply.sysl`).
    var supply = seam_supply()

    for i in 0..<units.len()
        val unit = units.at(i)
        val scope = scope_of_unit(a, unit)
        val library = from_library(a, scope)
        val is_entry = a.tables.entry_src != "" && unit.src.name == a.tables.entry_src

        for j in 0..<unit.body.len()
            val s = unit.body.at(j)

            *s.kind match
                FuncDecl(d) ->
                    if !library && d.tparams.is_empty()
                        exported_symbol(d) match
                            Some(sym) -> supply.claim(sym)
                            None -> ()
                _ -> ()

            // The entry file's own statements are the body the program starts in, and are typed
            // below rather than here -- including the functions of that body, which are nested
            // functions of it and are lowered where they stand.
            if is_entry && !belongs_to_module(s, a.tables.entry_captures) then continue

            *s.kind match
                // **A generic declaration is not a function**, so there is no body to type here:
                // what a program runs is the instantiation a call asked for, and each one is typed
                // below with its parameters fixed.
                FuncDecl(written) ->
                    val d = with_call_bounds(written)

                    if !d.tparams.is_empty() then generic += 1
                    else if library
                        val key = func_key(a, scope, s.span, d)

                        held.hold(key, HeldBody(key, scope, s.span, d, None))

                        exported_symbol(d) match
                            Some(sym) -> supply.offer(key, sym, scope.module_name)
                            None -> ()
                    else
                        // **A closure lowered inside a test body goes when the test does.** It has
                        // no declaration of its own to be marked by, so what marks it is the body
                        // it was written in -- the ones lowered while this one was read.
                        val opened = a.closure_funcs.len()
                        val typed = analyze_body(a, scope, s.span, d)

                        funcs.push(typed)

                        // Asked only of a body that lowered a closure: the search is over every
                        // test-only name, and most bodies have nothing for it to mark.
                        val lowered = a.closure_funcs.len() > opened

                        if lowered && (d.test.is_some() || d.hook.is_some() ||
                                       holds_string(a.tables.test_only, typed.name))
                            for k in opened..<a.closure_funcs.len()
                                a.tables.test_only.push(a.closure_funcs.at(k).name)
                // A `where` predicate and a struct's `invariant` clauses are functions the
                // declaration lowered to, and are typed where the declaration stands -- which is
                // the order every other body is typed in.
                TypeDecl(d) ->
                    if d.pred.is_some() then
                        type_lowered(a, &funcs, &held, scope, library, s.span,
                                     pred_key(module_qualify(scope.module_name, d.name)))
                StructDecl(d) ->
                    if !d.invariants.is_empty() && d.tparams.is_empty() then
                        type_lowered(a, &funcs, &held, scope, library, s.span,
                                     inv_key(module_qualify(scope.module_name, d.name)))
                _ -> ()

    val declared = funcs.len()

    // A member of a concrete type is a function whose body is typed whether or not anything calls
    // it, which is what makes a mistake in one a mistake at its declaration. A **library** member
    // is held back on the same terms a library function is, and for the same reason: a library type
    // with members would otherwise put every one of them into every program.
    val lowered = a.tables.members.lowered

    for i in 0..<lowered.len()
        val m = lowered.at(i)
        val home = a.tables.members.decl_scope.get(m.name).unwrap_or(empty_scope())

        // **A copy of a default the trait refused is not read again.** The body is one body, so its
        // mistake is one diagnostic -- the one the walk at the trait already made -- and reading the
        // copies would say it once per implementing type, in terms the reader never wrote.
        if refused_default(a, m.name) then continue

        if from_library(a, home) then
            held.hold(m.name, HeldBody(m.name, home, span_zero(), m, Some(m)))
        else funcs.push(analyze_instance(a, m.name, m))

    // The statements the program starts with, typed after every declaration's body and before the
    // queue is drained: what they reach is reached by the program.
    val started = entry_body(a, units)

    // The entry point, before the queue is drained, since what it reaches has to be analyzed with
    // everything else a program reaches.
    val entry = declared_entry(a)

    // Then the instantiations, drained until nothing more is asked for: typing one body may reach a
    // call that asks for another.
    drain_pending(a, &funcs)

    // A library function is analyzed only once something has called it, and analyzing one may call
    // another -- `printi` reaches `putbytes`, `printb` reaches `prints` -- so this runs to a
    // fixpoint too. Each round reads only the names reached since the one before -- see `HeldQueue`.
    var reached = true

    while reached
        reached = false

        val before = a.funcs_used().len()

        // A library export answering an `extern` the program reaches is reached too, though nothing
        // calls it -- a seam's supplier is named by no line of the program.
        reach_seam_suppliers(a, supply)

        val bodies = held.take_reached(a.funcs_used())

        for i in 0..<bodies.len()
            reached = true

            val at = bodies.at(i)

            if at.member.is_some() then
                funcs.push(analyze_instance(a, at.name, at.member.unwrap()))
            else funcs.push(analyze_body(a, at.scope, at.span, at.decl, at.name))

        drain_pending(a, &funcs)

        // And again after the drain, which may have reached an `extern` without reaching a function.
        reach_seam_suppliers(a, supply)

        // **DRAINING THE QUEUE REACHES THINGS TOO**, and a round that analyzed no held body may
        // still have found one to analyze: a vtable built while an instantiation was typed names
        // the members its slots point at, and those are library bodies waiting to be asked for. So
        // the round ends when nothing new is reached, not when nothing was held.
        if a.funcs_used().len() > before then reached = true

    // The `call` bodies the closures lowered to, after everything a program declared: a closure has
    // no declaration of its own to sit beside, and one lowered while a later body was typed would
    // otherwise land in the middle of the list.
    for i in 0..<a.closure_funcs.len()
        funcs.push(a.closure_funcs.at(i))

    // What a program is held to once everything it reaches has been typed. It runs here rather than
    // per body because every one of these questions is about the whole compilation.
    //
    // **The entry file's statements are a body and are held to all of it**, which they are not by
    // being in `funcs`: they belong to no declaration, so they travel beside the list rather than
    // in it and have to be put back for the walk. Left out, a `@no_alloc` or a `@no_os` written at
    // the top of a single-file program said nothing about the program's own statements -- the one
    // place a reader of such a program writes anything at all.
    //
    // **The storage is ordered first**, each initializer after what it reads, since that needs every
    // body it could reach to have been typed and the checks below walk it in that order.
    val ordered = init_ordered(a, storage, funcs)

    whole_program_checks(a, units, with_entry_body(funcs, started), ordered)

    TypedBodies(funcs, a.diagnostics(), generic, defaults, declared, ordered, a, units,
                entry, started.0, started.1)
end analyze_produced

// The statements the file the program starts in carries, typed in that file's own terms.
//
// **The entry file is a body**, so this is everything in it that is not a module member -- its
// statements, and also the `val`s and the functions that read what it binds, which belong to that
// body rather than to the module. They arrive in **source order**, which is what makes a `val` there
// an ordinary local: it is initialized where it is written, rather than before every statement in
// the file the way a module member's is.
// The key the entry file's body is filed under for the whole-program checks.
//
// **A space is what keeps it out of the way of everything else**: no identifier may hold one, so
// nothing a program declares can land on this key, where `main` and any name of its own could. It
// reaches no object file -- the body is emitted from `TypedBodies.entry` under the entry point's own
// name, and this list is built for the checks and thrown away.
entry_check_name(module_name: string) -> string = module_qualify(module_name, "entry file")

// The bodies the whole-program checks walk: everything a declaration lowered to, and the entry
// file's statements as one more.
//
// A fresh buffer rather than a push onto the caller's -- **a `Buf` assigned is a second name for one
// buffer**, so growing the list in place would put a function nothing declared into the list the
// emitter goes on to read.
private with_entry_body(funcs: Buf[TFunc], started: (Buf[TStmt], string)) -> Buf[TFunc]
    if started.0.is_empty() then return funcs

    var out: Buf[TFunc] = buf()

    for i in 0..<funcs.len()
        out.push(funcs.at(i))

    out.push(TFunc(span_zero(), entry_check_name(started.1), buf(), Unit,
                   TBlock(started.0, None, Unit), false, buf(), buf(), buf(), false, None, false,
                   None, false, false, None, None, None, None, no_marks(), started.1, false, None))

    out
end with_entry_body

private entry_body(a: &Analysis, units: Buf[Program]) -> (Buf[TStmt], string)
    if a.tables.entry_src == "" then return (buf(), ModuleRoot)

    for i in 0..<units.len()
        val unit = units.at(i)

        if unit.src.name != a.tables.entry_src then continue

        val scope = scope_of_unit(a, unit)
        val cx = analyzer_for(a, scope)
        val written = entry_statements(unit, a.tables.entry_captures)

        // **The body is the platform's `main`, and a `return` in it answers at that function's
        // type**: `return 3` is the process's status, a bare `return` is refused for having none,
        // and anything else is a mismatch against `int` -- the reference's reading, since it lowers
        // the body into the `i32 @main` it emits and types the statements there.
        cx.ret_ty = Some(int_type())
        cx.await_site = AwaitInEntry

        // The file the whole-program checks blame a statement of this body on. The body is not a
        // declaration, so it has no key of its own to be filed under, and one is made here rather
        // than left out -- `func_home` answers with an empty scope for a name it does not know, and
        // a diagnostic anchored in no file is worse than none.
        a.tables.homes.put(entry_check_name(scope.module_name), scope)

        var out: Buf[TStmt] = buf()

        cx.enter()

        // The entry file's statements are a block like any other, so the functions among them are
        // its nested functions and are lowered together where the first of them stands.
        open_block_group(cx, written)

        for j in 0..<written.len()
            push_all(&out, recover_stmt(cx, written.at(j)))

        cx.leave()
        return (out, scope.module_name)

    (buf(), ModuleRoot)
end entry_body

// The body of a function a declaration lowered a condition to, typed where the declaration stands.
//
// The library's are held back on the same terms its own functions are: a program that never makes a
// value of a library subtype never checks one.
private type_lowered(a: &Analysis, funcs: *Buf[TFunc], held: *HeldQueue[HeldBody], scope: Scope,
                     library: bool, span: Span, key: string)
    val at = a.tables.funcs.get(key)

    if at.is_none() then return

    if library then held.hold(key, HeldBody(key, scope, span, at.unwrap().decl, None))
    else funcs.push(analyze_body(a, scope, span, at.unwrap().decl, key))

// Every `@assert` written where a declaration stands, settled in the terms of the file that wrote
// it. A condition may name a constant wherever it was declared, a constant being folded as it is read.
//
// **The entry file's are settled apart from every other file's**, `entry` choosing which: that file
// is a body, so its asserts are settled with the bodies rather than with the declarations, and what
// they make real lands there -- `sizeof(Pair)` in a one-file program puts `Pair` after the library's
// types, where the same assert in a module puts its type ahead of them.
check_top_level_asserts(a: &Analysis, units: Buf[Program], entry: bool)
    for i in 0..<units.len()
        val unit = units.at(i)
        val is_entry = a.tables.entry_src != "" && unit.src.name == a.tables.entry_src

        if is_entry != entry then continue

        val scope = scope_of_unit(a, unit)
        val cx = analyzer_for(a, scope)

        for j in 0..<unit.body.len()
            val s = unit.body.at(j)

            *s.kind match
                AssertDecl(cond, message) -> check_assert(cx, s.span, cond, message)
                _ -> ()
end check_top_level_asserts

// One body waiting for something to reach it: the name it will be analyzed under, the terms it was
// written in, and either the declaration itself or the member it was lowered from.
struct HeldBody
    name: string
    scope: Scope
    span: Span
    decl: FuncDecl
    member: Option[FuncDecl]
end HeldBody

// The bodies held back until something reaches them, filed by name, and how far along the list of
// reached names the fixpoint has read.
//
// **A name read once is answered for good**, which is what lets each round read only the names
// reached since the last one: nothing is held once the fixpoint starts, and the list of reached
// names only grows between rounds. A round reading the whole list again would find every earlier
// name either analyzed or never held, so the bodies come out in the order they did then -- which
// matters, since the order bodies are typed in numbers the closures and orders the registrations.
struct HeldQueue[V]
    private waiting: Map[string, V]
    private read: usize

    // How many reached names have been read, over every round.
    looked: usize

    // Holds a body under a name. **The first body held under a name is the one kept.**
    hold(*self, name: string, body: V)
        if !self.waiting.has(name) then self.waiting.put(name, body)

    // The bodies waiting under the names reached since the last call, in the order the names were
    // reached. Each is handed out once.
    take_reached(*self, names: Buf[string]) -> Buf[V]
        var out: Buf[V] = buf()
        val upto = names.len()

        for i in self.read..<upto
            self.looked += 1

            val body = self.waiting.get(names.at(i))

            if body.is_some()
                self.waiting.remove(names.at(i))
                out.push(body.unwrap())

        self.read = upto
        out
    end take_reached
end HeldQueue

held_queue[V]() -> HeldQueue[V] = HeldQueue(map(), 0, 0)

// Whether a file is one the standard module **supplied**, which is not the same question as whether
// it is the library's. A library file is named for its place in the library rather than for the
// path it was read from, which is what makes the first half answerable wherever the library was
// installed; the second half is what makes a build *of* the library compile all of it rather than
// the fraction its own internal calls reach.
from_library(a: &Analysis, scope: Scope) -> bool =
    scope.src.name.starts_with(s"$StdPrefix/") && !holds_string(a.producing, scope.src.name)

// The instantiations a walk asked for, typed until nothing more is asked. Typing one body may reach
// a call that asks for another, so it runs to a fixpoint.
private drain_pending(a: &Analysis, funcs: *Buf[TFunc])
    var guard: usize = 0

    while !a.tables.members.pending.is_empty() && guard < 4096
        val work = a.tables.members.pending

        a.tables.members.pending = buf()

        for i in 0..<work.len()
            val job = work.at(i)
            val cx = analyzer_for(a, job.scope)

            cx.subst = job.subst

            // An instantiation of a member refused at its definition adds nothing to what was said
            // there (`bad_generics`).
            val mark = a.complaints()

            funcs.push(analyze_instance_in(a, cx, job.name, job.decl))

            if holds_string(a.tables.members.bad_generics, job.decl.name) then a.restore_complaints(mark)

        guard += 1
end drain_pending

// Whether a declaration's symbol is one only its own file can name.
file_local(v: Visibility) -> bool = v match
    File -> true
    _ -> false

// One function: its parameters in scope, its contract read first, and its body as a value block.
// `key` is what the body is filed under, for the declarations that were never written: a `where`
// predicate and a struct's `invariant` clauses lower to functions whose names hold a separator no
// spelling a reader could write does, so the key is handed over rather than composed.
analyze_body(a: &Analysis, scope: Scope, span: Span, d: FuncDecl, key: string = "") -> TFunc
    val reaching = enter_reaching(a, d)

    defer leave_reaching(a, reaching)

    val cx = analyzer_for(a, scope)
    val name = if key == "" then func_key(a, scope, span, d) else key

    note_body_covers(a, name)

    cx.in_variadic = d.variadic
    cx.owner = owner_of(a, d.name, scope)
    cx.bind_site = Some(span)

    var params: Buf[(string, Type)] = buf()

    for i in 0..<d.params.len()
        val p = d.params.at(i)
        val ty = resolve_type(a, scope, p.typ, no_bindings())
        val unique = cx.bind(p.name, ty)

        if p.by_name then cx.by_name.push(unique)

        params.push((unique, ty))

    // **A function that declares no result hands nothing back**, so its body is read with nothing
    // expected and the value it comes to is discarded -- which is why `probe() = 42` is a `unit`
    // function rather than an `int` one.
    val written = d.ret_type.map(w -> resolve_result(a, scope, w, no_bindings()))
    val ret = body_result(d, declared_result_type(written))

    cx.func_name = d.name
    cx.decl_name = d.name
    cx.ret_ty = Some(ret)
    cx.await_site = await_site_of(d)
    cx.ret_is_list = written.is_some() && is_result_list(written.unwrap())
    cx.result_chain = cx.ret_is_list

    val split = contract_length(d.body)
    val contract = analyze_contract(cx, span, d.body, split, ret)
    val rest = statements_from(d.body, split)

    // A function owing no value is where statement position starts: its body block is the outermost
    // one written for effect, and every `if` and `match` that ends it inherits that.
    val body = body_block(cx, rest, ret)

    // **Anchored at the declaration, not at the statement that yields**, as the reference anchors it:
    // the mistake is the signature and the body disagreeing, and the signature is where it is read.
    if ret != Unit && body.result.is_some() && disagree(body.ty, ret) then
        cx.fault(span, body_disagreement(name, ret, body.ty, cx.ret_is_list))

    a.tables.homes.put(name, scope)

    if !d.crossing.is_empty() then a.crossing_params.put(name, d.crossing)
    if d.const_fn then check_const_signature(a, scope, name, d, params, ret)

    // **A file-private declaration's symbol is internal**, since nothing outside the file it was
    // written in can name it -- which is what keeps two files' `private pick` from being one symbol
    // at the link.
    TFunc(span, name, params, ret, body, d.variadic, contract.0, contract.1,
          contract.2, file_local(d.vis), d.conv, d.tailrec, contract.3, d.pure, d.ghost,
          frame_symbols(cx, span, name, d.reads, "reads"),
          frame_symbols(cx, span, name, d.writes, "writes"),
          exported_symbol(d), d.section, d.marks, cx.owner, d.const_fn, Some(scope.src))
end analyze_body

// Whether the declaration wrote the parameter `name` by name (`x: -> T`).
private written_by_name(d: FuncDecl, name: string) -> bool
    for i in 0..<d.params.len()
        if d.params.at(i).name == name && d.params.at(i).by_name then return true

    false

// The module that declared `name`, which is the module whose compilation owns its definition.
//
// It is read off the declaration rather than off the key, and the key cannot answer it: a member of
// a built-in type (`char.is_digit`, `real.nan`) is keyed under the type and names no module at all,
// and an `impl` in one module may be written for a type in another. `scope` is the terms the body is
// read in, whose module is the answer for everything but a trait default copied onto a type.
owner_of(a: &Analysis, name: string, scope: Scope) -> string =
    a.tables.members.decl_owner.get(name).unwrap_or(scope.module_name)

// Every generic declaration's body, read once with its parameters standing in for themselves.
//
// **The tree is thrown away and so is nearly everything the walk said.** An instantiation reads the
// same body again against concrete types and raises the ordinary complaints there, with a position
// in the caller's own terms; what survives is what only this walk can find -- a call a bound does
// not license, and a call that disagrees with the *trait's* signature rather than with any one
// implementation's.
private check_generic_bodies(a: &Analysis, units: Buf[Program])
    for i in 0..<units.len()
        val unit = units.at(i)
        val scope = scope_of_unit(a, unit)

        for j in 0..<unit.body.len()
            *unit.body.at(j).kind match
                FuncDecl(written) ->
                    val d = with_call_bounds(written)

                    if !d.tparams.is_empty() then check_abstract_body(a, scope, d)
                // A generic struct's clauses are a generic function, read at its definition as
                // one is -- so a clause its bounds do not license is refused once, at the struct.
                StructDecl(d) ->
                    if !d.invariants.is_empty() && !d.tparams.is_empty()
                        val f = a.tables.funcs.get(inv_key(module_qualify(scope.module_name, d.name)))

                        if f.is_some() then check_abstract_body(a, scope, f.unwrap().decl)
                _ -> ()

    // A generic type's members and a generic `impl`'s are checkable before anything instantiates
    // them, against the bounds the block wrote on its own parameters -- the same walk. An inherited
    // default is left out: it was checked at the trait, against what the trait promises, which is
    // the whole of what its body may assume wherever it is copied to.
    val generic = a.tables.members.generic

    for i in 0..<generic.len()
        val fd = generic.at(i)

        if !a.tables.members.default_origin.has(fd.name)
            val scope = a.tables.members.decl_scope.get(fd.name).unwrap_or(empty_scope())
            val said = a.kept.len()

            check_abstract_body(a, scope, fd)

            if a.kept.len() > said then a.tables.members.bad_generics.push(fd.name)

    check_trait_default_bodies(a)
end check_generic_bodies

// Every trait's default bodies, read **at the trait**.
//
// A default may assume of its receiver exactly what its own trait declares, so `Self` stands for
// itself under one bound -- the trait, at its own parameters -- and the supertraits that bound
// reaches. That is the whole of what the body may take for granted wherever it is copied to, which
// is what makes this the place to read it: a mistake lands on the line that made it with nothing
// implementing the trait at all, and once however many types inherit it.
//
// **The copies are then not read again.** A default the trait refused is left out of the walk over
// lowered members, or one body's mistake would be reported once per implementing type.
private check_trait_default_bodies(a: &Analysis)
    val types = a.tables.types

    for i in 0..<types.len()
        val key = types.key_at(i)
        val decl = types.at(i)

        decl.kind match
            TraitOf(td) -> check_defaults_of(a, decl.scope, key, td)
            _ -> ()
end check_trait_default_bodies

// One trait's, each in the terms of the file that wrote it.
private check_defaults_of(a: &Analysis, scope: Scope, key: string, td: TraitDecl)
    for i in 0..<td.methods.len()
        val m = td.methods.at(i)

        // A static property carrying one is refused where the trait is hoisted, and reading the body
        // would say a second thing about a declaration that is already wrong.
        if m.body.is_empty() || (m.recv_mode().is_none() && m.is_static) then continue

        val said = a.kept.len()

        check_abstract_body(a, scope, trait_default_decl(td, m), false)

        if a.kept.len() > said then a.tables.members.bad_defaults.push(s"$key.${m.name}")
end check_defaults_of

// The function a trait's default reads as: the receiver becomes a `self` at `Self`, and `Self` is a
// type parameter in front of the trait's own, bounded by the trait at those parameters.
private trait_default_decl(td: TraitDecl, m: MethodDecl) -> FuncDecl
    var params: Buf[Param] = buf()
    val recv = receiver_param(m, named_type(m.span, "Self"))

    if recv.is_some() then params.push(recv.unwrap())

    for i in 0..<m.params.len()
        params.push(m.params.at(i))

    var tparams: Buf[string] = buf()

    tparams.push("Self")

    for i in 0..<td.tparams.len()
        tparams.push(td.tparams.at(i))

    for i in 0..<m.tparams.len()
        tparams.push(m.tparams.at(i))

    // The trait applied to its own parameters, which is what a bound on `Self` has to say for an
    // `Add[T]` to give `self.value() + x` the result the trait promised.
    var args: Buf[TypeRef] = buf()

    for i in 0..<td.tparams.len()
        args.push(named_type(m.span, td.tparams.at(i)))

    var on_self: Buf[BoundRef] = buf()

    on_self.push(BoundRef(m.span, td.name, args))

    var bounds: Buf[NamedBounds] = buf()

    bounds.push(NamedBounds("Self", on_self))

    for i in 0..<td.bounds.len()
        bounds.push(td.bounds.at(i))

    for i in 0..<m.bounds.len()
        bounds.push(m.bounds.at(i))

    FuncDecl(s"${td.name}.${m.name}", tparams, params, m.ret_type, m.body, bounds, m.variadic, File,
             buf(), joined_values(td.tvalues, m.tvalues), m.tpacks, None, None, None, false, false,
             false, m.reads, m.writes,
             None, None, m.crossing, buf(), m.marks, m.named_at, false)
end trait_default_decl

// One such body, in a region everything but a kept complaint is rewound out of.
//
// **A trait's default is read with `keep` off**: the two records below are about a *declaration* the
// program holds, and a default is one body the implementing types carry copies of -- so filing the
// trait's reading beside them would put a function in the tables under a name nothing lowers.
private check_abstract_body(a: &Analysis, scope: Scope, d: FuncDecl, keep: bool = true)
    if d.body.is_empty() then return

    val reaching = enter_reaching(a, d)

    defer leave_reaching(a, reaching)

    val mark = a.complaints()
    val trial = a.sandboxed()
    val queued = a.tables.members.pending.len()
    val tables = a.tables.members.vtables.len()
    val structs = a.tables.struct_insts.len()
    val enums = a.tables.enum_insts.len()
    val constrained = a.tables.constrained_insts.len()
    val outer = a.tables.members.selves.get(d.name).unwrap_or(buf())
    var subst = joined_bindings(outer, abstract_subst(a, scope, d.tparams, d.bounds, d.tvalues,
                                                      d.tpacks, outer))
    val settled_before = a.settled

    // The parameters are final here, so a trait applied to one of them -- in the signature or in a
    // type the body writes, `val g: Option[&Get[Y]]` -- is held to the trait's own bounds at once.
    // The complaint is a kept one, outliving the rewind below. `Self` is not among them.
    a.settled = joined_bindings(subst, buf())

    // On a generic type `Self` is the type applied to its own parameters, which is what the members
    // of one are read under.
    val written = a.tables.members.generic_self.get(d.name)

    if written.is_some() then subst.push(Binding("Self", resolve_type(a, scope, written.unwrap(),
                                                                      subst)))

    val cx = analyzer_for(a, scope)

    cx.subst = subst
    cx.owner = owner_of(a, d.name, scope)
    cx.at_definition = true
    remember_bounds(cx, d)

    for i in 0..<d.params.len()
        val p = d.params.at(i)

        val unique = cx.bind(p.name, resolve_type(a, scope, p.typ, subst))

        if p.by_name then cx.by_name.push(unique)

    var ret = Unit

    if d.ret_type.is_some() then
        ret = body_result(d, declared_result_type(Some(resolve_result(a, scope, d.ret_type.unwrap(),
                                                                      subst))))

    cx.func_name = d.name
    cx.decl_name = d.name
    cx.ret_ty = Some(ret)
    cx.await_site = await_site_of(d)
    cx.ret_is_list = written_result_list(d.ret_type)
    cx.result_chain = cx.ret_is_list

    val split = contract_length(d.body)

    analyze_contract(cx, decl_anchor(d), d.body, split, ret)

    val body = body_block(cx, statements_from(d.body, split), ret)
    var params: Buf[(string, Type)] = buf()

    for i in 0..<d.params.len()
        params.push((d.params.at(i).name, resolve_type(a, scope, d.params.at(i).typ, subst)))

    a.settled = settled_before
    a.release(trial)
    a.restore_complaints(mark)
    rewind_instantiations(a, queued, tables, structs, enums, constrained)

    // **The tree is kept although everything the reading registered is not**, and the two are not in
    // tension: a whole-program check about a module's own conduct is answered by the body a generic
    // was WRITTEN as, and this is the only walk that types one -- an instantiation belongs to
    // whoever chose the type, in a module of their own. Nothing here is lowered, so the
    // instantiations the rewind took back out are names these trees mention and nobody emits.
    //
    // Recorded after the rewind so that neither the entry nor the file it names can be taken back.
    if !keep then return

    // A generic `const` function's signature is answered for once, here, as its body is: a type
    // parameter stands for whatever an instantiation picks, and what it is made of is checked there.
    if d.const_fn then check_const_signature(a, scope, d.name, d, params, ret)

    a.tables.homes.put(d.name, scope)
    a.tables.abstracts.push(TFunc(span_zero(), d.name, params, ret, body, d.variadic, buf(), buf(),
                                  buf(), true, d.conv, false, None, d.pure, d.ghost, None, None,
                                  None, None, no_marks(), cx.owner, d.const_fn, Some(scope.src)))
end check_abstract_body

// What a `some` member's body produces, read speculatively and taken back: the one reading that
// analyzes a body to learn a **type** (`opaque_results.sysl`).
//
// The signature it is read against is the block's own, with the block's parameters standing in for
// themselves -- the same setup the definition-time walk above uses, and for the same reason: a
// generic block's `some` result is one type per instantiation, recorded in the block's terms so that
// a particular subject's arguments substitute into it. The declared result handed down is `Unknown`,
// which is the honest answer, since it is what this reading is trying to find out. **Everything the
// reading said is rewound**: the body is read again, for real, wherever the member is typed, and a
// mistake inside it would otherwise be reported twice. A body that did not read cleanly answers
// `Unknown`, which is the state every other unresolved type reaches and which nothing downstream
// complains about a second time.
opaque_body_type(a: &Analysis, scope: Scope, d: FuncDecl) -> Type
    if d.body.is_empty() then return Unknown

    val reaching = enter_reaching(a, d)

    defer leave_reaching(a, reaching)

    val mark = a.complaints()
    val trial = a.sandboxed()
    val queued = a.tables.members.pending.len()
    val tables = a.tables.members.vtables.len()
    val structs = a.tables.struct_insts.len()
    val enums = a.tables.enum_insts.len()
    val constrained = a.tables.constrained_insts.len()
    val outer = a.tables.members.selves.get(d.name).unwrap_or(buf())
    var subst = joined_bindings(outer, abstract_subst(a, scope, d.tparams, d.bounds, d.tvalues,
                                                      d.tpacks, outer))
    val written = a.tables.members.generic_self.get(d.name)

    if written.is_some() then subst.push(Binding("Self", resolve_type(a, scope, written.unwrap(),
                                                                      subst)))

    val cx = analyzer_for(a, scope)

    cx.subst = subst
    cx.owner = owner_of(a, d.name, scope)
    remember_bounds(cx, d)

    for i in 0..<d.params.len()
        val p = d.params.at(i)

        val unique = cx.bind(p.name, resolve_type(a, scope, p.typ, subst))

        if p.by_name then cx.by_name.push(unique)

    cx.func_name = d.name
    cx.decl_name = d.name
    cx.ret_ty = Some(Unknown)
    cx.await_site = await_site_of(d)
    cx.ret_is_list = false

    val split = contract_length(d.body)

    analyze_contract(cx, decl_anchor(d), d.body, split, Unknown)

    val body = body_block(cx, statements_from(d.body, split), Unknown)
    val clean = a.complaints() == mark

    a.release(trial)
    a.restore_complaints(mark)
    rewind_instantiations(a, queued, tables, structs, enums, constrained)

    if clean then body.ty else Unknown
end opaque_body_type

// The instantiations this reading asked for, taken back out.
//
// **A REGISTRATION LEFT BEHIND IS AN INSTANTIATION NOBODY WILL EVER TYPE.** Asking for one records
// its signature and queues its body, and the two have to be rewound together: dropping the queue
// alone leaves the *name* registered, so a later reading that genuinely wants it finds a signature
// already there, asks for nothing, and the program ends up calling a body no pass analyzed. It cost
// `Buf[string]`, `Buf[sh.sysl.parsing.Span]` and everything each of those reaches, all of them
// first asked for from inside a generic body being read at its own definition.
rewind_instantiations(a: &Analysis, queued: usize, tables: usize, structs: usize = 0,
                      enums: usize = 0, constrained: usize = 0)
    val pending = a.tables.members.pending

    for i in queued..<pending.len()
        a.tables.members.func_insts.remove(pending.at(i).name)

    a.tables.members.pending.truncate(queued)

    // A method table is the same case one step out: built once and found by every later erasure, so
    // one a thrown-away reading built would be a table in the program because of a reading nobody
    // kept -- and in the order that reading happened to run in.
    var made: Buf[string] = buf()

    for i in tables..<a.tables.members.vtables.len()
        made.push(a.tables.members.vtables.key_at(i))

    for i in 0..<made.len()
        a.tables.members.vtables.remove(made.at(i))

    // And the records a reading made real, on the same terms: a type is one a program lays out
    // because something in it asked for one, and a reading nobody kept asked for nothing.
    if structs > 0 then rewind_registered(a.tables.struct_insts, structs)
    if enums > 0 then rewind_registered(a.tables.enum_insts, enums)
    if constrained > 0 then rewind_registered(a.tables.constrained_insts, constrained)
end rewind_instantiations

// What the declaration asked of its type parameters, and which of its own names hold one.
//
// **It is read off the DECLARATION rather than off the substitution**, which is the whole of what it
// is for: at an instantiation `subst` says `T` has become an `int` and nothing left in the body
// remembers that the signature asked that `int` for a `Zero`. Two traits may give one type a member
// of one name, so without this record the body is refused for an ambiguity its own signature
// settled -- and settled somewhere the call has no way to speak to.
//
// Only a parameter written as the **bare** type parameter is recorded: a `Box[T]` is a `Box`, and
// what its members mean is the `Box`'s question rather than the `T`'s.
private remember_bounds(cx: &Analyzer, d: FuncDecl)
    cx.tbounds = d.bounds

    var held: Buf[(string, string)] = buf()

    for i in 0..<d.params.len()
        val p = d.params.at(i)

        *p.typ.kind match
            NamedType(w, args) ->
                if args.is_empty() && named_bounds_of(d.bounds, w).is_some() then held.push((p.name, w))
            _ -> ()

    cx.pbounds = held
end remember_bounds

// The bounds a declaration wrote for one of its type parameters, and nothing for a name that is not
// one of them.
named_bounds_of(bounds: Buf[NamedBounds], written: string) -> Option[Buf[BoundRef]]
    for i in 0..<bounds.len()
        if bounds.at(i).name == written then return Some(bounds.at(i).bounds)

    None
end named_bounds_of

// One function whose signature the tables already hold, under the name they hold it by: a member
// lowered from a type's body or from an `impl` block, or one instantiation of a generic.
//
// **The signature is read back rather than resolved again**, which is what makes the body agree with
// the call that asked for it: the arguments a call solved are what the parameters were made real at,
// and resolving the declaration a second time would have nothing to make them real from.
analyze_instance(a: &Analysis, name: string, d: FuncDecl) -> TFunc
    val scope = a.tables.members.decl_scope.get(name).unwrap_or(empty_scope())
    val cx = analyzer_for(a, scope)
    val outer = a.tables.members.selves.get(name)

    if outer.is_some() then cx.subst = outer.unwrap()

    analyze_instance_in(a, cx, name, d)
end analyze_instance

// The same, on an analyzer whose terms a caller has already set.
analyze_instance_in(a: &Analysis, cx: &Analyzer, name: string, d: FuncDecl) -> TFunc
    val reaching = enter_reaching(a, d)

    defer leave_reaching(a, reaching)

    val sig = a.tables.members.func_insts.get(name)

    // Who declared it is read off the declaration too, so an instantiation belongs to the module of
    // the generic it was made from rather than to whichever module's call asked for it.
    cx.owner = owner_of(a, d.name, cx.scope)

    if sig.is_none() then return TFunc(span_zero(), name, buf(), Unit, empty_block(), false, buf(),
                                       buf(), buf(), false, None, false, None, false, false, None,
                                       None, None, None, no_marks(), cx.owner, false, None)

    remember_bounds(cx, d)

    var params: Buf[(string, Type)] = buf()

    for i in 0..<sig.unwrap().params.len()
        val p = sig.unwrap().params.at(i)
        val unique = cx.bind(p.0, p.1)

        // Matched by written name rather than by position: the instantiation's list is not always
        // the declaration's unchanged.
        if written_by_name(d, p.0) then cx.by_name.push(unique)

        params.push((unique, p.1))

    val ret = body_result(d, sig.unwrap().ret)

    cx.func_name = name
    cx.decl_name = d.name
    note_body_covers(a, name)
    cx.ret_ty = Some(ret)
    cx.await_site = await_site_of(d)
    cx.ret_is_list = written_result_list(d.ret_type)
    cx.result_chain = cx.ret_is_list
    // An instantiation of a variadic generic is as variadic as the declaration, so its body may
    // open the tail.
    cx.in_variadic = d.variadic

    val split = contract_length(d.body)
    val contract = analyze_contract(cx, decl_anchor(d), d.body, split, ret)
    val rest = statements_from(d.body, split)
    val body = body_block(cx, rest, ret)
    val span = body_span(rest, span_zero())

    if ret != Unit && body.result.is_some() && disagree(body.ty, ret) then
        cx.fault(span, body_disagreement(declared_key(a, cx.scope, d), ret, body.ty, cx.ret_is_list))

    // **An instantiation whose name carries a closure's is internal on the same ground the closure
    // itself is.** `sysl.time$resolve.$closure4` is a symbol only the unit that lowered that closure
    // can mean anything by, since the number in it is that unit's counter -- so it may not cross a
    // link. Asked of the emitted name rather than of the substitution, so that a closure reached
    // through a composite argument is covered by the one rule.
    a.tables.homes.put(name, cx.scope)

    if !d.crossing.is_empty() then a.crossing_params.put(name, d.crossing)

    // A member's typed function carries its declaration's span, as a free function's does; an
    // instantiation, declared nowhere under its own name, keeps its body's.
    val declared = a.tables.members.decl_spans.get(name).unwrap_or(span)

    TFunc(declared, name, params, ret, body, d.variadic, contract.0, contract.1, contract.2,
          file_local(d.vis) || mentions_closure(name),
          d.conv, d.tailrec, contract.3, d.pure, d.ghost,
          frame_symbols(cx, span, name, d.reads, "reads"),
          frame_symbols(cx, span, name, d.writes, "writes"),
          exported_symbol(d), d.section, d.marks, cx.owner, d.const_fn, Some(cx.scope.src))
end analyze_instance_in

// The key a declaration was filed under, for a diagnostic naming the declaration an instantiation
// came from rather than the instantiation itself. A member's own name is already a key; a free
// function's is its module and its name.
private declared_key(a: &Analysis, scope: Scope, d: FuncDecl) -> string
    val qualified = module_qualify(scope.module_name, d.name)

    if a.tables.funcs.has(qualified) then return qualified

    d.name
end declared_key

// What a body that does not answer with what its signature declared is told.
//
// **A `where` predicate and a struct `invariant` are lowered to functions the reader never wrote**,
// so the mistake in one is reported as what they did write -- a condition that is not a `bool` --
// rather than as a return type nothing in the source names.
//
// **A result list is quoted as it was written** -- `int, int`, not the tuple it lays out as -- since
// the declaration is what the reader is being pointed at.
body_disagreement(name: string, ret: Type, got: Type, listed: bool) -> string
    if name.ends_with("$pred") then
        return s"a 'where' predicate must be a 'bool', but this one is ${type_show(got)}"

    if name.ends_with("$inv") then
        return s"an 'invariant' must be a 'bool', but this one is ${type_show(got)}"

    val declared = if listed then as_written_results(ret) else ret

    s"function '$name' should return ${type_show(declared)}, but its body yields " +
        s"${type_show(got)}${await_hint(got, ret)}"
end body_disagreement

// The tuple a result list lays out as, given back its written shape for a diagnostic.
private as_written_results(t: Type) -> Type = t match
    Struct(parts) -> Results(parts)
    _ -> t

// A block with nothing in it, for a function whose signature never resolved.
private empty_block() -> TBlock = TBlock(buf(), None, Unit)

// The body itself, asked for the declared result -- or, where the function owes no value, read in
// statement position with what it comes to discarded.
//
// **A body is a recovery region**, so the first refusal in its trailing expression is the one it is
// told about (`Analysis.open_region`). **A body that gave up comes to `Unknown`**, which agrees with
// every signature: what it yields is a consequence of the refusal already told, so a second complaint
// that it disagrees with the declaration is noise the reference does not make.
body_block(cx: &Analyzer, rest: Buf[Stmt], ret: Type) -> TBlock
    val outer = cx.an.open_region()
    val block = if ret == Unit then type_value_block(cx, rest, None, true)
    else type_value_block(cx, rest, Some(ret), false)
    val gave_up = cx.an.poison.is_some()

    cx.an.close_region(outer)

    if gave_up then return TBlock(block.stmts, block.result, Unknown)

    block
end body_block

// What a function hands back: the tuple a result list lays out as, and `unit` where none was
// written.
declared_result_type(written: Option[Type]) -> Type
    if written.is_none() then return Unit

    result_type(written.unwrap())
end declared_result_type

private is_result_list(t: Type) -> bool = t match
    Results(_) -> true
    _ -> false

// Whether what a declaration WROTE is a result list rather than one value.
//
// **It is asked of the written type rather than of a resolved one, because a signature that has been
// through `declared_result_type` no longer says.** A result list is a tuple wearing a second name,
// and the name is what that function takes off -- so `-> T, T` and `-> (T, T)` arrive at the
// instantiation table as the same `Type`. A generic's body is typed from that table, which is why
// both the definition-time walk and the instantiation used to read a list as one value and refuse
// `= a / b, a % b` at the declaration that wrote it.
private written_result_list(written: Option[TypeRef]) -> bool
    if written.is_none() then return false

    *written.unwrap().kind match
        TupleType(_, results) -> results
        _ -> false
end written_result_list

// How many statements at the head of a body are its contract, which is what splits the clauses from
// the code. A clause after that is one written somewhere it may not be, and the statement walk says
// so there.
contract_length(body: Buf[Stmt]) -> usize
    var n: usize = 0

    while n < body.len() && is_contract_clause(body.at(n))
        n = n + 1

    n
end contract_length

private is_contract_clause(s: Stmt) -> bool = *s.kind match
    Require(_, _) -> true
    Ensure(_, _) -> true
    Variant(_) -> true
    _ -> false

statements_from(body: Buf[Stmt], first: usize) -> Buf[Stmt]
    var out: Buf[Stmt] = buf()

    for i in first..<body.len()
        out.push(body.at(i))

    out
end statements_from

// The leading `require`/`ensure`/`variant` clauses. Both conditions must be `bool`; `result` and
// `old(e)` are only in scope inside an `ensure` -- `result` also only where the function returns a
// value -- and the `old` expressions are collected so that the emitter can snapshot them at entry.
//
// **A `variant` is a top-level function's** (`measured`): its measure is checked where a call to the
// same body is written, which a closure, reached through `Fn`, and a nested function, whose calls
// carry an environment, never are. There each clause is refused where it stands and read no further,
// every such clause being told before the body after them is given up.
analyze_contract(cx: &Analyzer, at: Span, body: Buf[Stmt], upto: usize, ret: Type,
                 measured: bool = true) -> (Buf[TClause], Buf[TClause], Buf[TExpr], Option[TExpr])
    var requires: Buf[TClause] = buf()
    var ensures: Buf[TClause] = buf()
    var olds: Buf[TExpr] = buf()
    var measure: Option[TExpr] = None
    var misplaced = false

    for i in 0..<upto
        val c = body.at(i)

        *c.kind match
            Require(cond, msg) -> requires.push(TClause(analyze_bool(cx, cond, at), msg))

            Ensure(cond, msg) ->
                cx.ensure_result = if ret == Unit then None else Some(ret)
                cx.olds = Some(olds)

                val tc = analyze_bool(cx, cond, at)

                olds = cx.olds.unwrap()
                cx.olds = None
                cx.ensure_result = None
                ensures.push(TClause(tc, msg))

            // The measure reads the parameters and nothing else, and **scoping is what enforces
            // it** rather than a rule of this pass: the clause is read before the body, in a scope
            // holding the parameters alone, so a name from the body is undefined here.
            Variant(e) ->
                if measured then measure = function_measure(cx, c.span, e, measure)
                else
                    cx.an.fault_in_place(cx.scope, c.span, unmeasured_variant())
                    misplaced = true

            _ -> ()

    // Every misplaced clause has been told, and the body after them is not read for more.
    if misplaced then cx.an.poison_quietly()

    (requires, ensures, olds, measure)
end analyze_contract

private unmeasured_variant() -> string =
    "a 'variant' is a top-level function's — the measure is checked where a call to the same body " +
    "is written, and neither a closure, which is reached through 'Fn', nor a function nested in " +
    "another, whose calls carry a captured environment, is reached that way"

private function_measure(cx: &Analyzer, span: Span, e: Expr,
                         already: Option[TExpr]) -> Option[TExpr]
    if already.is_some() then
        cx.fault(span, "a function declares one 'variant' — a measure is the thing that " +
                 "decreases, and two of them say nothing about which")

    val te = type_expr_bare(cx, e)

    texpr_type(te) match
        Integer(_, _, _) -> ()
        Unknown -> ()
        other -> cx.fault(span, s"a 'variant' is an integer measure, not ${type_show(other)}")

    Some(te)
end function_measure

// Where a diagnostic about a declaration as a whole goes: the line that declared it, or -- for a
// function the compiler made up, which was written nowhere -- its body.
decl_anchor(d: FuncDecl) -> Span =
    if d.at.end > d.at.start then d.at else body_span(d.body, span_zero())

// A body's last statement, which is the expression the body came to, and `span` for a body with none.
body_span(rest: Buf[Stmt], span: Span) -> Span
    if rest.is_empty() then return span

    rest.at(rest.len() - 1).span
end body_span

// The key the declaration was filed under, which is the plain name for the first declaration of it
// and the numbered slot for every overload after that.
//
// **It is read off the tables rather than composed**, so a call and a definition cannot disagree
// about which of two declarations of one name a key means.
func_key(a: &Analysis, scope: Scope, span: Span, d: FuncDecl) -> string
    val plain = file_private_key(a, scope.src.name, module_qualify(scope.module_name, d.name))
    val keys = overload_keys(a, plain)

    for i in 0..<keys.len()
        val f = a.tables.funcs.get(keys.at(i))

        if f.is_some() && f.unwrap().span.start == span.start &&
                f.unwrap().scope.src.name == scope.src.name then
            return keys.at(i)

    plain
end func_key

// The symbol a function is visible under from C, where it is exported at all: the one the attribute
// named, and the declaration's own bare name where it named none.
private exported_symbol(d: FuncDecl) -> Option[string]
    if d.exported.is_none() then return None

    val named = d.exported.unwrap().symbol

    if named.is_some() then return named

    Some(d.name)
end exported_symbol

// -- what a test asks ------------------------------------------------------------------------------

// Everything the body pass has to say about one source, as text.
stmt_diagnostics(text: string) -> Buf[string] = stmt_diagnostics_for(text, host_target())

// The same, for a machine other than this one -- which a check whose answer is the processor's has
// to be able to ask about.
stmt_diagnostics_for(text: string, t: Target) -> Buf[string]
    val parsed = parse(source_of("test.sysl", text))
    var out: Buf[string] = buf()

    if !parsed.ok()
        for i in 0..<parsed.report.len()
            out.push(parsed.report.at(i).message)

        return out
    end if

    var units: Buf[Program] = buf()

    units.push(parsed.program)

    val done = analyze_bodies(units, t)

    for i in 0..<done.reported.len()
        out.push(done.reported.at(i).diag.message)

    out
end stmt_diagnostics_for

// The same, under the name the expression tests already assert on.
expr_diagnostics(text: string) -> Buf[string] = stmt_diagnostics(text)

// The type the **last** body of a source comes to, rendered the way a diagnostic quotes one.
//
// **It is the seam the typing tests assert on**, and the last function is what they read because a
// test writes whatever it needs above the line it is about.
body_type(text: string) -> string
    val parsed = parse(source_of("test.sysl", text))

    if !parsed.ok() then return parsed.report.at(0).message

    var units: Buf[Program] = buf()

    units.push(parsed.program)

    val done = analyze_bodies(units, host_target())

    if !done.reported.is_empty() then return done.reported.at(0).diag.message
    if done.declared == 0 then return "no body"

    val last = done.funcs.at(done.declared - 1)

    if last.body.result.is_none() then return "no value"

    type_show(texpr_type(last.body.result.unwrap()))
end body_type

// The type the body of one **named** function comes to, which for an instantiation is the mangled
// name a call filed it under and for a member the name its type lowered it to.
//
// **It is the seam a generic's claim is asserted on.** What a generic declaration means is what its
// instantiations turn out to be, and a source that calls one at two types has two answers -- neither
// of them the last body, and neither of them anything the declaration alone could be asked for.
inst_type(text: string, name: string) -> string
    val done = typed_of(text)

    if !done.reported.is_empty() then return done.reported.at(0).diag.message

    for i in 0..<done.funcs.len()
        val f = done.funcs.at(i)

        if f.name == name
            if f.body.result.is_none() then return type_show(f.ret_ty)

            return type_show(texpr_type(f.body.result.unwrap()))

    s"no function named '$name'"
end inst_type

// One named function of a source, printed the reference compiler's way -- which is the seam a claim
// about the **shape** of a typed body is asserted on, as against a claim about its type.
//
// A dispatch is the case that needs it: what `a == b` on a type with an `impl Eq` comes to is a
// `bool` whichever way it got there, so only the tree says whether the comparison reached the
// implementation or the machine's instruction.
body_shown(text: string, name: string) -> string
    val done = typed_of(text)

    if !done.reported.is_empty() then return done.reported.at(0).diag.message

    for i in 0..<done.funcs.len()
        if done.funcs.at(i).name == name then return show_typed_func(done.funcs.at(i))

    s"no function named '$name'"
end body_shown

// The names every function a source came to is filed under, in the order they were typed -- what a
// test asserting which instantiations a program asked for reads.
inst_names(text: string) -> Buf[string]
    var out: Buf[string] = buf()
    val done = typed_of(text)

    for i in 0..<done.funcs.len()
        out.push(done.funcs.at(i).name)

    out
end inst_names

// One source analyzed, which is the seam every test that reads a whole compilation goes through.
typed_of(text: string) -> TypedBodies = typed_of_target(text, host_target())

// The same, for a machine other than the one the compiler is running on -- which is what a claim
// about a calling convention has to be asked of, since a convention is a property of the machine.
typed_of_target(text: string, t: Target) -> TypedBodies
    val parsed = parse(source_of("test.sysl", text), t)

    if !parsed.ok()
        var said: Buf[Placed] = buf()
        val src = source_of("test.sysl", text)

        for i in 0..<parsed.report.len()
            said.push(placed_at(src, parsed.report.at(i)))

        return TypedBodies(buf(), said, 0, 0, 0, buf(), analysis_for(t), buf(), None,
                           buf(), ModuleRoot)
    end if

    var units: Buf[Program] = buf()

    units.push(parsed.program)
    analyze_bodies(units, t)
end typed_of_target

// Everything the trait and generic machinery has to say about one source, which is what an
// error-path test for a bound, an `impl` or a member asserts on.
trait_diagnostics(text: string) -> Buf[string] = stmt_diagnostics(text)

// One function of one source, printed the reference compiler's way. It is the seam a claim about
// what a body *became* is asserted on, where the type alone does not say it.
typed_body_text(text: string, name: string) -> string
    val done = typed_of(text)

    for i in 0..<done.funcs.len()
        if done.funcs.at(i).name == name then return show_typed_func(done.funcs.at(i))

    if !done.reported.is_empty() then return done.reported.at(0).diag.message

    s"no function named '$name'"
end typed_body_text

// The same, under the name the expression tests already assert on.
expr_type(text: string) -> string = body_type(text)

// The same, wrapped in a function so a test may write an expression on its own.
expr_type_of(expr: string) -> string = body_type(s"probe() = $expr\n")

// The type a named binding of the **last** body holds, rendered the way a diagnostic quotes one.
//
// **It is the seam a statement's claim is asserted on**, since what a `val` or a pattern settles is
// a type nothing hands back: a body ending in `print(x)` says nothing about what `x` is, and this
// asks the declaration itself.
binding_type(text: string, name: string) -> string
    val parsed = parse(source_of("test.sysl", text))

    if !parsed.ok() then return parsed.report.at(0).message

    var units: Buf[Program] = buf()

    units.push(parsed.program)

    val done = analyze_bodies(units, host_target())

    if !done.reported.is_empty() then return done.reported.at(0).diag.message
    if done.declared == 0 then return "no body"

    val found = binding_in_block(done.funcs.at(done.declared - 1).body, name)

    if found.is_none() then return s"no binding named '$name'"

    type_show(found.unwrap())
end binding_type

// The type a run of statements binds a name at, looking into the blocks a statement carries so that
// a binding made inside a loop or a branch is reachable too.
private binding_in(stmts: Buf[TStmt], name: string) -> Option[Type]
    for i in 0..<stmts.len()
        stmts.at(i) match
            TVarDecl(bound, ty, _, _) -> if bound == name then return Some(ty)
            TRefDecl(bound, ty, _) -> if bound == name then return Some(ty)
            TExprStmt(e) ->
                val inner = binding_in_expr(e, name)

                if inner.is_some() then return inner
            TDefer(inner) ->
                val found = binding_in(inner, name)

                if found.is_some() then return found
            _ -> ()

    None
end binding_in

private binding_in_expr(e: TExpr, name: string) -> Option[Type] = *e.kind match
    TIf(cond, t, els, _) ->
        binding_in_cond(cond, name).or_else(() -> binding_in_block(t, name))
            .or_else(() -> binding_in_opt_block(els, name))
    TBlockExpr(b) -> binding_in_block(b, name)
    TMatch(_, arms, _) -> binding_in_arms(arms, name)
    TWhile(cond, body, els, _) ->
        binding_in_cond(cond, name).or_else(() -> binding_in(body, name))
            .or_else(() -> binding_in_opt_block(els, name))
    TDoWhile(body, _, els, _) ->
        binding_in(body, name).or_else(() -> binding_in_opt_block(els, name))
    TLoop(body, _) -> binding_in(body, name)
    TFor(bound, var_ty, _, _, _, body, els, _) ->
        if bound == name then Some(var_ty)
        else binding_in(body, name).or_else(() -> binding_in_opt_block(els, name))
    TForEach(bound, elem_ty, _, body, els, _) ->
        if bound == name then Some(elem_ty)
        else binding_in(body, name).or_else(() -> binding_in_opt_block(els, name))
    TCFor(init, _, step, body, els, _) ->
        binding_in(init, name).or_else(() -> binding_in(step, name))
            .or_else(() -> binding_in(body, name))
            .or_else(() -> binding_in_opt_block(els, name))
    TCheckedLoop(_, _, walked) -> binding_in_expr(walked, name)
    TSeq(xs) -> binding_in_exprs(xs, name)
    _ -> None

// A condition's terms, since an `is` binds into the branch the test guards.
private binding_in_cond(cond: Buf[TCondTerm], name: string) -> Option[Type]
    for i in 0..<cond.len()
        cond.at(i) match
            TCondIs(_, patterns, _) ->
                val found = pattern_binding(patterns, name)

                if found.is_some() then return found
            _ -> ()

    None
end binding_in_cond

private binding_in_exprs(xs: Buf[TExpr], name: string) -> Option[Type]
    for i in 0..<xs.len()
        val found = binding_in_expr(xs.at(i), name)

        if found.is_some() then return found

    None
end binding_in_exprs

private binding_in_block(b: TBlock, name: string) -> Option[Type]
    val found = binding_in(b.stmts, name)

    if found.is_some() then return found
    if b.result.is_none() then return None

    binding_in_expr(b.result.unwrap(), name)
end binding_in_block

private binding_in_opt_block(b: Option[TBlock], name: string) -> Option[Type]
    if b.is_none() then return None

    binding_in_block(b.unwrap(), name)
end binding_in_opt_block

private binding_in_arms(arms: Buf[TArm], name: string) -> Option[Type]
    for i in 0..<arms.len()
        val bound = pattern_binding(arms.at(i).patterns, name)

        if bound.is_some() then return bound

        val found = binding_in_block(arms.at(i).body, name)

        if found.is_some() then return found

    None
end binding_in_arms

// The type one of a run of patterns binds a name at, which is what an arm's capture asks.
private pattern_binding(ps: Buf[TPattern], name: string) -> Option[Type]
    for i in 0..<ps.len()
        val found = pattern_binds_name(ps.at(i), name)

        if found.is_some() then return found

    None
end pattern_binding

private pattern_binds_name(p: TPattern, name: string) -> Option[Type] = p match
    TBindPattern(bound, ty) -> if bound == name then Some(ty) else None
    TAtPattern(bound, inner) ->
        if bound == name then Some(tpattern_type(*inner)) else pattern_binds_name(*inner, name)
    TVariantPattern(_, _, args) -> pattern_binding(args, name)
    TStructPattern(_, args) -> pattern_binding(args, name)
    _ -> None

// -- a module's own storage -----------------------------------------------------------------------

// Every `static var` a program declares, then every `val`, each read in its own file's terms.
//
// **The two are one thing under two declarations** -- storage that belongs to a module rather than
// to a call -- and they are kept apart here only because a `var` may be written to and starts at its
// type's zero where nothing was written, which a `val` may not and does not.
private module_storage(a: &Analysis) -> Buf[TVal]
    var out: Buf[TVal] = buf()

    for pass in 0..<2
        for i in 0..<a.tables.vals.len()
            val key = a.tables.vals.key_at(i)
            val writable = holds_string(a.tables.writable, key)

            if (pass == 0) == writable
                val d = a.tables.vals.at(i)
                val cx = analyzer_for(a, d.scope)
                // `stored` is what the storage is declared at, qualifier and all; `ty` is what a read
                // of it hands back, which is what the initializer is held to.
                val stored = if d.typ.is_none() then Unknown
                else resolve_storage(a, d.scope, d.typ.unwrap(), d.name, writable)
                val ty = unqualified(stored)

                var init: Option[TExpr] = None

                if d.init.is_some()
                    init = Some(type_expr(cx, d.init.unwrap(), Some(ty)))

                    // The rule a local binding is held to: the value is fine as an expression, and
                    // the declaration is the mistake.
                    val got = texpr_type(init.unwrap())

                    if disagree(got, ty) then
                        cx.fault(d.span, s"cannot initialize '${d.name}': declared ${type_show(ty)} but " +
                                 s"the value is ${type_show(got)}${await_hint(got, ty)}")

                    refuse_storage_slots(cx, init.unwrap())
                else if !mentions_unknown(ty) && !has_zero(ty)
                    // The rule a local with no initializer is held to, and for the same reason:
                    // there is nothing for the storage to start at.
                    val shown = if d.scope.module_name == "" then d.name
                    else s"${d.scope.module_name}.${d.name}"

                    cx.fault(d.span, s"'$shown' needs a value: storage with no initializer starts at its " +
                        s"type's zero, and ${type_show(ty)} has none — the same rule a local with no " +
                        "initializer is held to. A 'string' and a slice both start empty and need no " +
                        "value written; a reference and an enum need one")
                else if !zero_sized(ty) && has_zero(ty)
                    // A zero that holds a struct carrying clauses is checked as a construction is,
                    // which makes it an initializer that runs rather than an image the object file
                    // carries -- exactly what storage initialized by `Window(2, 10)` already is.
                    val zero = checked_zero(cx, d.span, ty)

                    if !is_zero_expr(zero) then init = Some(zero)

                // What separates a `val` from a `const` is that it has an address, and a value with no
                // representation has nothing to put one on.
                if !writable && !mentions_unknown(ty) && zero_sized(ty)
                    val shown = if d.scope.module_name == "" then d.name
                    else s"${d.scope.module_name}.${d.name}"

                    cx.fault(d.span, s"'$shown' cannot be a 'val': a ${type_show(ty)} value occupies " +
                        "nothing, so there is no storage for the name to stand for — write the call as " +
                        "a statement instead")
                end if

                // An initializer that is constant data but not yet written as literals is written as
                // them, so the object file carries it and nothing runs to fill it in.
                //
                // **A call to a `const` function is run here**, and its value laid down on every
                // target: what would have trapped at startup is refused now (`const_eval.sysl`).
                if init.is_some() && !laid_down(init.unwrap())
                    val run = const_val_image(cx, d.name, init.unwrap())
                    val image = if run.is_some() then run else static_image(cx, init.unwrap())

                    if image.is_some() then init = image

                val computed = init.is_some() && !laid_down(init.unwrap())

                if d.thread_local then check_per_thread(cx, d.span, key, computed)

                out.push(TVal(key, stored, init, computed, writable, storage_align(cx, d), d.section,
                              d.thread_local))

    out
end module_storage

// `&` in front of a value writes it into a hidden local of the scope the `&` stands in, and a module
// initializer runs in a prologue whose frame is gone by the program's first statement -- so the slot
// there would hand the storage a pointer to nothing. Each such `&` is refused where it was written.
private refuse_storage_slots(cx: &Analyzer, init: TExpr)
    walk_texpr(init, expr_walk(true, e -> *e.kind match
        TTempAddr(_, _) ->
            cx.fault(e.span, "'&' in front of a value writes it into a hidden local of the scope the " +
                     "'&' stands in, and module storage has no such scope — the slot would belong to " +
                     "the initializer's own frame, which is gone by the program's first statement. " +
                     "Give the value a name that lasts the run: declare it beside this one, and take " +
                     "the address of that")
        _ -> ()))

// The two things `@thread_local` asks that a plain module `var` does not
// (`reference/attributes.md § @thread_local`).
//
// **The initializer has to be a constant**: every thread's copy is made from one image the object
// file carries, and there is no per-thread prologue for anything else to run in. A thread started
// later never passes through `main`'s, so an initializer that was code would fill exactly one copy
// and leave every other thread reading zeroes.
//
// **And the target has to have thread-local storage at all.** Every target LLVM knows *accepts*
// the keyword, and a freestanding one silently gets the local-exec model, whose offset is read from
// a register nothing on a bare machine has written -- so the alternative to this refusal is a
// program that reads a wild address.
private check_per_thread(cx: &Analyzer, span: Span, key: string, computed: bool)
    val t = cx.an.tables.target

    if !t.thread_local_storage()
        cx.fault(span, s"'${qualified_name(key)}' cannot be '@thread_local' on '${t.name}': there " +
                 "is no loader and no libc on this target, so nothing lays a thread's storage down " +
                 "and nothing writes the thread pointer the offset would be read from. Declare it " +
                 "as a plain module 'var' and let the port's scheduler answer for which task is " +
                 "running, which is what the ownership runtime's reaper slot does")
    // A computed initial value is a fact about how the program lays its storage down, told with no
    // position, as the reference tells it.
    else if computed
        cx.an.fault_unplaced(cx.scope, span, s"'${qualified_name(key)}' is '@thread_local', so its value has to be one " +
                 "the compiler can write down: every thread gets a copy of the initial value, and " +
                 "the copies are made from a single image in the object file rather than by code " +
                 "that runs per thread. A literal, 'null', a 'const' and the arrays and structs " +
                 "built from them are all values; a call is not. Leave the value off to start " +
                 "every thread at the type's zero, and do the work in each thread instead")
end check_per_thread

private is_zero_expr(e: TExpr) -> bool = *e.kind match
    TZero(_) -> true
    _ -> false

// The boundary a declaration asked its storage to start on, where it asked for one.
private storage_align(cx: &Analyzer, d: ValueDecl) -> Option[usize]
    if d.align.is_none() then return None

    const_fold(cx, d.align.unwrap()) match
        Some(ConstInt(n)) -> n.to_long().map(v -> usize(v))
        _ -> None
end storage_align

// Whether a value can be **laid down** rather than worked out: everything about it is known while
// compiling, so the object file carries the bytes and nothing runs to fill them in.
private laid_down(t: TExpr) -> bool = *t.kind match
    TIntLit(_, _) -> true
    TFloatLit(_, _) -> true
    TBoolLit(_) -> true
    TStrLit(_) -> true
    TNullLit(_) -> true
    TArrayLit(elems, _) -> all_laid_down(elems)
    TArrayFill(value, _) -> laid_down(value)
    TStructNew(_, args) -> all_laid_down(args)
    TEnumNew(_, variant, _) -> !variant.carries
    TCast(inner, to) ->
        val pointerish = to match
            Ptr(_) -> true
            CFn(_, _) -> true
            _ -> false

        pointerish && (*inner.kind match
            TIntLit(_, _) -> true
            _ -> false)
    _ -> false

private all_laid_down(xs: Buf[TExpr]) -> bool
    for i in 0..<xs.len()
        if !laid_down(xs.at(i)) then return false

    true
end all_laid_down

// **Constant data**: an initializer whose every scalar is a constant expression -- what a `const`
// may be written as, `reference/modules.md § const — a value` -- and the arrays, structs and variants
// carrying nothing that are built from them, written back as the literals they come to so the
// object file can carry them. `i32(0.6 * 2147483648.0)`, `Q31(R * 2)` over a `const R` and
// `[1 << 4, ~0]` are all constant data; a call is not, whatever its arguments are.
//
// Where any scalar in it would come to something else at run time than the fold says -- an
// overflow, a division by zero (`const_fold_typed`) -- the answer is `None` and the initializer
// stays code, filled before the program's statements as any other computed one.
private static_image(cx: &Analyzer, t: TExpr) -> Option[TExpr] = *t.kind match
    TArrayLit(elems, ty) -> static_images(cx, elems).map(xs -> TExpr(t.span, TArrayLit(xs, ty)))
    TArrayFill(value, ty) -> static_image(cx, value).map(x -> TExpr(t.span, TArrayFill(x, ty)))
    TStructNew(decl, args) -> static_images(cx, args).map(xs -> TExpr(t.span, TStructNew(decl, xs)))
    TCast(inner, to) -> cast_image(t, inner, to)
    TConstrainedCheck(value, target) -> constrained_image(cx, t, value, target)
    _ -> if laid_down(t) then Some(t) else scalar_image(t)

// A constant made into a constrained subtype. **A name-only subtype -- a `new` type, or one with no
// range -- checks nothing**, so `PhysAddr(0)` is the constant it converts and is laid down as one. A
// range is asked of the folded value here, while compiling: a value it admits is laid down, and one
// it does not is refused, the check a startup fill would have trapped on being decidable now. A
// `where` predicate is a function, and storage behind one stays code.
private constrained_image(cx: &Analyzer, t: TExpr, value: TExpr, target: Type) -> Option[TExpr]
    val d = target match
        Constrained(found) -> found
        _ -> return None

    if d.pred_fn.is_some() then return None

    val inner = static_image(cx, value)

    if inner.is_none() then return None

    if d.lo.is_some() || d.hi.is_some()
        val v = const_fold_typed(inner.unwrap())

        if v.is_none() then return None

        if !range_admits(d, v.unwrap())
            cx.fault(t.span, s"${shown_value(v.unwrap(), target)} is not a value '${type_show(target)}' " +
                     "admits — module storage over a constant is laid down while compiling, so the " +
                     "conversion is checked here rather than at startup")
            return None
        end if
    end if

    inner
end constrained_image

// A conversion: to a scalar it is folded like any other operator, and to a pointer it is a device
// address -- written as arithmetic over constants, it is still one number.
private cast_image(t: TExpr, inner: TExpr, to: Type) -> Option[TExpr]
    val pointerish = to match
        Ptr(_) -> true
        CFn(_, _) -> true
        _ -> false

    if !pointerish then return scalar_image(t)

    const_fold_typed(inner) match
        Some(ConstInt(n)) -> Some(TExpr(t.span, TCast(TExpr(inner.span, TIntLit(n, texpr_type(inner))), to)))
        _ -> None
end cast_image

private static_images(cx: &Analyzer, xs: Buf[TExpr]) -> Option[Buf[TExpr]]
    var out: Buf[TExpr] = buf()

    for i in 0..<xs.len()
        val x = static_image(cx, xs.at(i))

        if x.is_none() then return None

        out.push(x.unwrap())

    Some(out)
end static_images

// A scalar initializer as the literal it folds to.
private scalar_image(t: TExpr) -> Option[TExpr]
    val v = const_fold_typed(t)

    if v.is_none() then return None

    val ty = texpr_type(t)

    v.unwrap() match
        ConstInt(n) -> Some(TExpr(t.span, TIntLit(n, ty)))
        ConstBool(b) -> Some(TExpr(t.span, TBoolLit(b)))
        ConstStr(s) -> Some(TExpr(t.span, TStrLit(s)))
        // The literal carries the `double` pattern whatever its width, as every float literal does,
        // and the width it is laid down at is the scalar's own -- a name for a `f64` is still one.
        ConstFloat(f) -> v_float(f) match
            VFloat(bits) -> Some(TExpr(t.span, TFloatLit(bits, underlying(ty))))
            _ -> None
        ConstChar(_) -> None
end scalar_image

