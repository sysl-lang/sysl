// sysl -- the sysl compiler, written in sysl.
//
// **This is the compiler that ships as `sysl`.** It builds itself; the Scala bootstrap compiler
// (github.com/sysl-lang/sysl-bootstrap) is retired. The binary is named for the package, so
// `sysl build .` here produces `./sysl`, the same name the release tarballs install -- the program
// is the product and the repository is only where it is written.
//
// The module is `sh.sysl.compiler` rather than `sh.sysl.sysl`, so that the sources under
// `sh/sysl/compiler/` never share a name with the binary at the root.

package {
  name    = "sysl"
  version = "0.8.4"

  // **There is no `sysl` floor here, and the absence is the point.** A floor names the oldest
  // compiler that may build a tree, and this tree is built by two compilers whose versions say
  // opposite things about it: the bootstrap, which is far above any floor this could state, and the
  // compiler these sources *are*, which reports 0.0.1 and is turned away by every floor there is.
  // Stating the bootstrap's number makes the tree unbuildable by itself, which is the one thing it
  // has to be -- so which bootstrap can build it is recorded where the other facts about the
  // reference compiler are, and not in a field that would refuse the product.
}

dependencies {
  // `Source`, `Span` and `Diagnostic` are the parsing package's, as they are for every reader in
  // the org. The scanner and the parser for sysl's own grammar are written here by hand.
  parsing { git = "github.com/sysl-lang/parsing", version = "0.13.3" }

  // A manifest is HOCON, read into a tree that keeps every number as it was written and says where
  // a refusal stopped. Everything a key means is read off that tree here, in `manifest.sysl`.
  hocon { git = "github.com/sysl-lang/hocon", version = "0.3.3" }

  // `sysl weave` renders a literate source's prose as CommonMark with GitHub's extensions; the
  // program's lines go to it as regions, so the compiler, not the Markdown, decides what is code.
  markdown { git = "github.com/sysl-lang/markdown", version = "0.4.2" }

  // `sysl import-c` reads a header through clang's `-ast-dump=json`, which is a document of tens of
  // megabytes for a header like `uv.h` and is read in a fraction of a second.
  json { git = "github.com/sysl-lang/json", version = "0.2.2" }

  // A freestanding image laid out by a generated linker script is read back after its link: which
  // sections it holds, and, where a region overflowed, what the widened link put in each one.
  elf { git = "github.com/sysl-lang/elf", version = "0.1.1" }
}

// A compiler's working set is the program it is reading, and its size is not known until it has
// been read.
requires {
  heap = true
}
