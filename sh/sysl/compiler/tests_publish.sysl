module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.fs.{entries, is_dir, make_dir_all, make_temp_dir, pending_name, publish_dir, read_text, remove_dir_all, remove_file, write_text}
import sysl.text.Search

// **What a cache writer is held to is that a reader never sees a partial entry**, and that is a
// claim about names: the bytes go to a pending name nobody reads and reach the trusted one in one
// rename. The mechanism is `sysl.fs`'s and is tested there; what is asserted here is this compiler's
// use of it -- the run cache's test list lands whole with nothing beside it, and the loser of a race
// to fetch one package succeeds without disturbing the winner.

private scratch() -> string = make_temp_dir("atc-").unwrap()

@test("atc: the run cache's test list is published whole, and nothing else is left beside it")
atc_the_run_cache_test_list_is_published_whole()
    // A key nothing else will ever ask for: the name the system gave a fresh temporary directory.
    val tmp = scratch()
    val key = s"atc-${basename(tmp)}"

    remove_dir_all(tmp).unwrap_or(())

    // No cache on this machine, or the cache turned off: there is nothing to publish into.
    val list = run_cache_tests(key) match
        Some(p) -> p
        None -> return

    val dir = parent_of(list).unwrap()

    make_dir_all(dir).unwrap()

    var tests: Buf[TTest] = buf()

    tests.push(TTest(module_qualify("m", "adds"), "adds", false, None, "m/t.sysl", 4, no_hooks()))
    tests.push(TTest(module_qualify("m", "two"), "two plus two", false, None, "m/t.sysl", 9,
                     no_hooks()))
    write_test_list(key, tests)

    val read = read_test_list(key).unwrap()

    assert_eq(read.len(), 2)
    assert_eq(read.at(1).display, "two plus two")

    var mine: Buf[string] = buf()

    for name in entries(dir).unwrap().view()
        if name.starts_with(key) then mine.push(name)

    remove_file(list).unwrap_or(())
    assert_eq(mine.len(), 1)
    assert_eq(mine.at(0), s"$key.tests")

@test("atc: the second fetch of one package succeeds and leaves the first one's tree alone")
atc_the_loser_of_a_fetch_race_is_harmless()
    val dir = scratch()
    val dest = join_path(dir, "@v1.0.0")
    val first = pending_name(dest)
    val second = pending_name(dest)

    make_dir_all(first).unwrap()
    write_text(join_path(first, "who"), "first").unwrap()
    make_dir_all(second).unwrap()
    write_text(join_path(second, "who"), "second").unwrap()

    assert(publish_dir(first, dest).is_ok(), "the first publish succeeds")
    assert(publish_dir(second, dest).is_ok(), "the second finds the package there and succeeds too")
    assert_eq(read_text(join_path(dest, "who")).unwrap_or(""), "first")
    assert(!is_dir(second), "the loser's copy is removed")
    assert_eq(entries(dir).unwrap().len(), 1)
    remove_dir_all(dir).unwrap_or(())
