module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture

// A scalar on the LEFT of a vector operator (`reference/vectors.md`, "What the operators do": either
// side may be a scalar that broadcasts). `v * dt` was always the vector product, but `dt * v` with
// nothing around it to name a type was read at the scalar, since the pair took the type of its first
// operand that stood on its own, and was refused as "needs matching types". A bracket list beside a
// vector -- `v * [2.0, 3.0]`, `[dt, 1.0] * v` -- was refused the same way, read as an array.
//
// The axes: every arithmetic and bitwise operator, comparisons yielding a mask, float, integer,
// byte and fixed-point lanes, widths 2, 4 and 8, a named and a literal scalar, a bracket list on
// either side, and the operation as a binding, a `store` argument, a generic argument, a method
// argument and a `return`. The error paths: a scalar of another type, an array VALUE beside a vector,
// a bracket list of the wrong length, a literal that does not fit the lane. Each accepted program
// prints its lanes, which are the test.

private var vsl_library_cache: Buf[Program] = buf()
private var vsl_library_read: bool = false

private vsl_library() -> Buf[Program]
    if vsl_library_read then return vsl_library_cache

    vsl_library_read = true

    std_root() match
        Err(_) -> ()
        Ok(root) -> std_units(root, host_target()) match
            Err(_) -> ()
            Ok(units) -> vsl_library_cache = units

    vsl_library_cache
end vsl_library

private vsl_ready() -> bool
    if vsl_library().is_empty()
        print("skipped: the standard module's source is not on this machine")
        return false
    end if

    if !clang_available()
        print("skipped: there is no clang on this machine")
        return false
    end if

    true
end vsl_ready

// What a program printed, or why it could not be built or run.
private vsl_ran(text: string) -> string
    val root = make_temp_dir("sysl-vector-scalar-left").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", text).unwrap()

    val exe = s"$root/built"

    build_native_program(s"$root/main.sysl", None, None, DefaultOptimization, Some(exe)) match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return failure_text(why)
        Ok(_) -> ()

    val said = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    said match
        Err(_) -> "the program that was built could not be run"
        Ok(out) -> out.text
end vsl_ran

// The first thing the compilation said contains `want`; otherwise the test fails showing all of it.
private vsl_says(text: string, want: string)
    val said = enm_err(text)

    assert(said.contains(want), s"expected it to say: $want\nit said: $said")

// -- the reduction ---------------------------------------------------------------------------------

@test("a named scalar on the left of '/' broadcasts with nothing around it")
vsl_divide_reduction()
    if !vsl_ready() then return

    assert_eq(vsl_ran(raw"""
        f(dt: real, v: <2>real) -> real
            val m = dt / v
            m[1]

        print(f(6.0, [2.0, 3.0]))
        """), "2\n")

@test("every float operator takes a named scalar on the left")
vsl_float_operators()
    if !vsl_ready() then return

    assert_eq(vsl_ran(raw"""
        val dt = 6.0
        val v: <2>real = [2.0, 3.0]
        val a = dt + v
        val b = dt - v
        val c = dt * v
        val d = dt / v
        val n = -dt * v
        print(a[0], a[1], b[0], b[1], c[0], c[1], d[0], d[1], n[1])
        """), "8 9 4 3 12 18 3 2 -18\n")

@test("the scalar on the left is the same value in every lane as on the right")
vsl_left_matches_right()
    if !vsl_ready() then return

    assert_eq(vsl_ran(raw"""
        val dt = 2.5
        val v: <4>f64 = [1, 2, 3, 4]
        val l = dt * v
        val r = v * dt
        print((l == r)[0], (l == r)[3], l[3], r[3])
        """), "true true 10 10\n")

@test("a literal scalar on the left still broadcasts")
vsl_literal_scalar()
    if !vsl_ready() then return

    assert_eq(vsl_ran(raw"""
        val v: <2>real = [2.0, 4.0]
        val a = 2.0 / v
        val b = 2 * v
        print(a[0], a[1], b[0], b[1])
        """), "1 0.5 4 8\n")

@test("a comparison with the scalar on either side yields a mask")
vsl_comparison_mask()
    if !vsl_ready() then return

    assert_eq(vsl_ran(raw"""
        val dt = 3.0
        val v: <4>real = [1, 3, 5, 7]
        val gt = dt > v
        val eq = dt == v
        val lt = v < dt
        print(gt[0], gt[1], gt[2], eq[1], eq[2], lt[0], lt[3])
        """), "true false false true false true false\n")

// -- lane types and widths -------------------------------------------------------------------------

@test("integer lanes take an integer scalar on the left, for every integer operator")
vsl_integer_lanes()
    if !vsl_ready() then return

    assert_eq(vsl_ran(raw"""
        val k: i32 = 10
        val w: <4>i32 = [1, 2, 3, 4]
        val a = k * w
        val b = k - w
        val c = k & w
        val d = k ^ w
        val e = k | w
        val f = k + w
        print(a[0], a[3], b[0], b[3], c[1], d[2], e[0], f[3])
        """), "10 40 9 6 2 9 11 14\n")

@test("an int scalar inferred from a literal binding meets int lanes on the left")
vsl_inferred_int()
    if !vsl_ready() then return

    assert_eq(vsl_ran(raw"""
        val n = 3
        val w: <4>int = [1, 2, 3, 4]
        val m = n - w
        print(m[0], m[3])
        """), "2 -1\n")

@test("byte lanes take an untyped literal on either side")
vsl_byte_lanes()
    if !vsl_ready() then return

    assert_eq(vsl_ran(raw"""
        val bytes: <4>u8 = [1, 2, 3, 4]
        val p = 3 * bytes
        val q = 250 + bytes
        val r = bytes + 250
        print(p[0], p[3], q[0], q[3], r[3])
        """), "3 12 251 254 254\n")

@test("fixed-point lanes take a fixed-point scalar on the left")
vsl_fixed_lanes()
    if !vsl_ready() then return

    assert_eq(vsl_ran(raw"""
        val h: q15 = 0.5
        val fv: <2>q15 = [0.25, 0.5]
        val a = h * fv
        val b = fv * h
        print(a[0], a[1], b[0], b[1])
        """), "0.125 0.25 0.125 0.25\n")

@test("a scalar on the left broadcasts at widths 2, 4 and 8")
vsl_widths()
    if !vsl_ready() then return

    assert_eq(vsl_ran(raw"""
        val dt = 8.0
        val v2: <2>real = [1, 2]
        val v4: <4>f32 = [1, 2, 4, 8]
        val v8: <8>real = [1, 2, 3, 4, 5, 6, 7, 8]
        val x: f32 = 8
        val a = dt / v2
        val b = x / v4
        val c = dt / v8
        print(a[1], b[3], c[0], c[7])
        """), "4 1 8 1\n")

// -- a bracket list beside a vector ----------------------------------------------------------------

@test("a bracket list of literals is read as the vector on either side")
vsl_list_of_literals()
    if !vsl_ready() then return

    assert_eq(vsl_ran(raw"""
        val v: <2>real = [2.0, 3.0]
        val a = v * [2.0, 3.0]
        val b = [2.0, 3.0] * v
        val c = [1.0; 2] - v
        print(a[0], a[1], b[0], b[1], c[0], c[1])
        """), "4 9 4 9 -1 -2\n")

@test("a bracket list holding a name is read as the vector on either side")
vsl_list_of_names()
    if !vsl_ready() then return

    assert_eq(vsl_ran(raw"""
        val dt = 6.0
        val v: <2>real = [2.0, 3.0]
        val a = [dt, 1.0] * v
        val b = v + [dt, dt]
        print(a[0], a[1], b[0], b[1])
        """), "12 3 8 9\n")

// -- positions -------------------------------------------------------------------------------------

@test("a scalar-left operation and a bracket list are each a store's value")
vsl_store_argument()
    if !vsl_ready() then return

    assert_eq(vsl_ran(raw"""
        val dt = 6.0
        val v: <2>real = [2.0, 3.0]
        var out = [0.0, 0.0, 0.0, 0.0]

        out.store(0, dt / v)
        out.store(2, v * [2.0, 3.0])
        print(out[0], out[1], out[2], out[3])
        """), "3 2 4 9\n")

@test("a scalar-left operation is an argument to a generic function and to a method")
vsl_generic_and_method_argument()
    if !vsl_ready() then return

    assert_eq(vsl_ran(raw"""
        struct Acc
            total: <2>real

        impl Acc
            add(*self, x: <2>real)
                self.total = self.total + x

        first[T](x: T) -> T = x

        val dt = 6.0
        val v: <2>real = [2.0, 3.0]
        val g = first(dt * v)
        var acc = Acc([0.0, 0.0])

        acc.add(dt - v)
        print(g[0], g[1], acc.total[0], acc.total[1])
        """), "12 18 4 3\n")

@test("a scalar-left operation is a returned value")
vsl_return()
    if !vsl_ready() then return

    assert_eq(vsl_ran(raw"""
        scaled(dt: real, v: <4>f32) -> <4>f32
            return f32(dt) * v

        less(k: i32, v: <8>i32) -> <8>i32 = k - v

        val s = scaled(2.0, [1.0, 2.0, 3.0, 4.0])
        val e = less(100, [1, 2, 3, 4, 5, 6, 7, 8])
        print(s[0], s[3], e[0], e[7])
        """), "2 8 99 92\n")

// -- what is still refused -------------------------------------------------------------------------

@test("a scalar of another type is refused on the left as on the right")
vsl_wrong_scalar_type()
    if !enm_ready() then return

    val prelude = "val x: f32 = 2\nval v: <2>real = [2.0, 3.0]\n"

    vsl_says(prelude + "val m = x * v\n", "'*' needs matching types, got f32 and <2>real")
    vsl_says(prelude + "val m = v * x\n", "'*' needs matching types, got <2>real and f32")

@test("an integer scalar of another width is refused beside integer lanes")
vsl_wrong_integer_width()
    if !enm_ready() then return

    vsl_says("val k: i64 = 2\nval w: <4>i32 = [1, 2, 3, 4]\nval m = k * w\n",
             "'*' needs matching types, got long and <4>int")

@test("an array value beside a vector is still refused in either order")
vsl_array_value()
    if !enm_ready() then return

    val prelude = "val arr = [1.0, 2.0]\nval v: <2>real = [2.0, 3.0]\n"

    vsl_says(prelude + "val m = arr * v\n", "'*' needs matching types, got [2]real and <2>real")
    vsl_says(prelude + "val m = v * arr\n", "'*' needs matching types, got <2>real and [2]real")

@test("a bracket list of the wrong length is refused in either order")
vsl_list_wrong_length()
    if !enm_ready() then return

    val prelude = "val v: <2>real = [2.0, 3.0]\n"

    vsl_says(prelude + "val m = [1.0, 2.0, 3.0] * v\n", "'*' needs matching types, got [3]real and <2>real")
    vsl_says(prelude + "val m = v / [1.0, 2.0, 3.0]\n", "'/' needs matching types, got <2>real and [3]real")

@test("a literal that does not fit a byte lane is refused on either side")
vsl_literal_does_not_fit()
    if !enm_ready() then return

    val prelude = "val bytes: <4>u8 = [1, 2, 3, 4]\n"

    vsl_says(prelude + "val m = 300 + bytes\n", "the literal 300 does not fit byte")
    vsl_says(prelude + "val m = bytes + 300\n", "the literal 300 does not fit byte")
