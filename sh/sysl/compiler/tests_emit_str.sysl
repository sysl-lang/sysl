              "entry:\n" +
              "  %xs.addr = alloca { ptr, ptr, i64 }\n" +
              "  %a.addr = alloca i64\n" +
              "  %b.addr = alloca i64\n" +
              "  store { ptr, ptr, i64 } %xs.param, ptr %xs.addr\n" +
              "  %t1 = extractvalue { ptr, ptr, i64 } %xs.param, 0\n" +
              "  call void @arc.retain_maybe(ptr %t1)\n" +
              "  store i64 %a.param, ptr %a.addr\n" +
              "  store i64 %b.param, ptr %b.addr\n" +
              "  %t2 = load { ptr, ptr, i64 }, ptr %xs.addr\n" +
              "  %t3 = extractvalue { ptr, ptr, i64 } %t2, 0\n" +
              "  %t4 = extractvalue { ptr, ptr, i64 } %t2, 1\n" +
              "  %t5 = extractvalue { ptr, ptr, i64 } %t2, 2\n" +
              "  %t6 = load i64, ptr %a.addr\n" +
              "  %t7 = load i64, ptr %b.addr\n" +
              "  %t8 = icmp ult i64 %t7, %t5\n" +
              "  br i1 %t8, label %bounds.ok1, label %bounds.bad2\n" +
              "bounds.bad2:\n" +
              "  call void @llvm.trap()\n" +
              "  unreachable\n" +
              "bounds.ok1:\n" +
              "  %t9 = add i64 %t7, 1\n" +
              "  %t10 = icmp ule i64 %t6, %t9\n" +
              "  br i1 %t10, label %bounds.ok3, label %bounds.bad4\n" +
              "bounds.bad4:\n" +
              "  call void @llvm.trap()\n" +
              "  unreachable\n" +
              "bounds.ok3:\n" +
              "  %t11 = getelementptr i32, ptr %t4, i64 %t6\n" +
