@test("--cc keys the run cache: the same clang named by another path is a second entry")
ckg_cc_flag()
    if !ckg_ready() then return

    val clang = find_clang(host_target(), None).unwrap()
    val dir = lbr_temp("sysl-ckg-cc")

    // A wrapper rather than a link: clang finds its own headers beside the path it was started as.
    write_text(s"$dir/clang", "#!/bin/sh\nexec " + clang + " \"$@\"\n").unwrap()
    capture("/bin/chmod", ["+x", s"$dir/clang"], "", [], true).unwrap()

    val root = ckg_featured("fancy = []")
    val got = ckg_flags_seam(root, s"--cc $clang", s"--cc $dir/clang")

    assert(got.starts_with("1 | 1 | 1 | miss miss hit | "), got)
    lbr_drop([root, dir])
