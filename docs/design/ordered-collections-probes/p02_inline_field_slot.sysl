// The same leaf, asking for the empty slots at the construction itself: `slot_empty()` as a field's
// value, which is where a heap node would want it.

struct Leaf[K, const B: usize]
    len: usize
    keys: [B]K

one[K, const B: usize](k: K) -> &Leaf[K, B]
    val l: &Leaf[K, B] = Leaf(0, slot_empty())

    slot_put(&l.keys[0], k)
    l.len = 1
    l

val l = one[string, 6]("a")

print(l.len, l.keys[0])
