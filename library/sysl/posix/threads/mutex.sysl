module sysl.posix.threads
@no_alloc
@requires(posix)

import sysl.sync.*

/** Mutual exclusion that **owns what it protects**, which is the difference `library/threads.md §
 * Mutex[T]` draws against `SpinLock`.
 *
 * A spinlock is a flag beside the data and what the data is stays the programmer's to remember. This
 * holds the `T`, and both of its fields are private -- so there is no way to reach the value that
 * does not go through the lock, and no way to build one that skips the free state.
 *
 * **`with` is the way in**: it takes the lock, hands a closure the address of the value, and releases
 * the lock when the closure returns. The address is lent (`@lends`), so the compiler holds the closure
 * to letting it go -- returning it, storing it, or passing it to something that keeps it is refused,
 * which is the one mistake a returned address could not prevent: using it after the release.
 *
 * ```
 * m.with((n) -> *n += 1)
 * ```
 *
 * `lock_raw` and `unlock_raw` are the hold a block cannot express -- taken in one function and
 * released in another, or handed from one thread to the next. Nothing ties their address to the hold,
 * which is what the name says.
 *
 * **It is not built on `pthread_mutex_t`, and the reason is a build property rather than a
 * preference.** A caller-allocated opaque C type is one of the three things `reference/ffi.md § A
 * library may carry C` names as reachable from C and from nothing else: its size is in a header, it
 * differs between the platforms and between two libcs on the *same* platform -- 64 bytes on Darwin,
 * 40 under glibc on x86-64, 48 on aarch64, 40 again under musl -- and `#if` can ask which operating
 * system this is but not which libc. Transcribing a bound would compile everywhere and be checked
 * nowhere, which is precisely the failure that section is about. The way to read a header is C, and
 * the standard library deliberately includes none: it reaches libc by symbol alone, which is what
 * lets it go on building for any target the toolchain can lower for. So the lock is three atomic
 * operations and a yield, and a binding library that carries its own C shim is where a futex-backed
 * one belongs.
 *
 * **What that costs is a waiter's processor for one scheduling quantum at a time.** The spin is not
 * `SpinLock`'s -- a failed exchange gives the processor up rather than turning round again -- so a
 * waiter cannot starve the holder the way a pure spin can on one core, and the hold may be as long as
 * it likes. What it does not do is *sleep*: there is no wait queue, so a contended lock costs a
 * context switch per attempt where a futex would cost none.
 */
struct Mutex[T]

    // Zero when free, one when held. Private, unlike `SpinLock.held`: a spinlock guards something the
    // programmer names, so its flag is theirs to look at, and this one guards a field of its own
    // struct that nothing outside can see anyway.
    private held: i32

    // What the lock protects. Private is the whole of what "owns" means here -- with it public,
    // `m.value` would be an unsynchronized read of the thing the type exists to synchronize, and the
    // type would be a spinlock with a suggestion attached.
    private value: T

    /** Builds a free lock around a value.
     *
     * The positional constructor names every field in order (`reference/declarations.md §
     * Structs`), so a private field is what makes this the only way in from outside -- which is
     * what keeps `held` starting at zero.
     */
    new(value: T) -> Mutex[T] = Mutex(0, value)

    /** Takes the lock, waiting until it is free, runs `body` with the address of what it protects,
     * releases the lock, and answers what `body` answered.
     *
     * The address is valid only while `body` runs, and the compiler holds `body` to that: it may read
     * and write through the address, and pass it to a callee that only uses it, but not return it,
     * store it, or hand it to something that keeps it (`reference/memory.md § A pointer lent for one
     * call`). A closure is not an allocation here -- the parameter is a type parameter, so each call is
     * a direct call of the closure's own body, and this is usable under `@no_alloc`.
     */
    @lends(body)
    @blocks
    with[R](*self, body: *T -> R) -> R
        self.lock_raw()

        defer self.unlock_raw()
        body(&self.value)

    /** The same, if the lock is free: `Some` of what `body` answered, or `None` without waiting. */
    @lends(body)
    try_with[R](*self, body: *T -> R) -> Option[R]
        if atomic_swap(&self.held, 1, Acquire) != 0 then return None

        defer self.unlock_raw()
        Some(body(&self.value))

    /** Takes the lock, waiting until it is free, and answers the address of what it protects.
     *
     * The address is live until `unlock_raw`, and nothing ties it to the hold -- holding on to it past
     * the release compiles. This is the hold a block cannot express, taken in one function and released
     * in another; where the hold fits a block, `with` is the one to write.
     */
    @blocks
    lock_raw(*self) -> *T
        while atomic_swap(&self.held, 1, Acquire) != 0
            // Spin on a plain load until it looks free, then offer the processor away before trying
            // the exchange again. The load is `SpinLock`'s reason -- a read-modify-write takes the
            // cache line exclusively every time round, so waiters spinning on the exchange fight the
            // holder trying to write the release. The **yield** is this type's own: the holder may
            // not be running at all, and nothing else in the loop would make it so.
            while atomic_load(&self.held, Relaxed) != 0
                yield_now()

        &self.value

    /** Takes the lock if it is free, and answers what it protects where it did. Never waits. */
    try_lock_raw(*self) -> Option[*T] =
        if atomic_swap(&self.held, 1, Acquire) == 0 then Some(&self.value) else None

    /** Releases the lock a `lock_raw` or `try_lock_raw` took.
     *
     * The `Release` is what publishes everything the holder wrote through the address it was given,
     * to whichever thread's `Acquire` takes the lock next. That pairing is the whole of what makes
     * the data safe to touch, and it is why neither of these takes an `Ordering`: a lock's orderings
     * are fixed by what a lock means.
     */
    unlock_raw(*self)
        atomic_store(&self.held, 0, Release)

end Mutex
