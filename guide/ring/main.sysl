// The checks. Every line of output begins `ok`, so the whole of stdout is the assertion.
//
// **Nothing here breaks a contract**, and that is not an oversight. A violated `require` traps, so
// a check that broke one would end the program rather than report a failure — the refusals below
// are all from the total operations (`try_push`, `try_pop`), which answer instead of trapping, and
// the contracts are asserted by the states they permit. What happens when one is violated is
// asserted in the suite, where a trap is an observation rather than the end of the run.
//
// The two implementations are run **side by side everywhere**. `Ring` keeps `head` and `count` and
// computes the end; `Tracked` keeps the end as a field and pays an invariant to keep it honest.
// Every scenario is driven through both and the answers required to be equal, and the last section
// does it for every state a ring of this size has rather than for the states that happened to come
// up — which is what turns "they agree" from an anecdote into a claim.

check(name: string, got: string, want: string)
    if got == want then print(s"ok    $name = $got")
    else print(s"FAIL  $name = $got, wanted $want")
end check

// A buffer whose slot `i` holds `i + 1`, so a state built by hand has contents that say where they
// came from.
numbered() -> [capacity]int
    var b = [0; capacity]

    for i in 0..<capacity do b[i] = int(i) + 1

    b
end numbered

section_the_slot_type()
    print("-- the slot type, and the step it will not take")

    // The bounds come off the declaration: `Slot` excludes its upper end because there is no such
    // slot, and `Count` includes it because a full ring has that many elements.
    check("first slot", str(int(Slot::First)), "0")
    check("last slot", str(int(Slot::Last)), "7")
    check("smallest count", str(int(Count::First)), "0")
    check("largest count", str(int(Count::Last)), "8")

    // `Valid` is total: it answers for a number that is not a slot rather than trapping on it,
    // which is what makes it the test a program can actually use before converting. It is also the
    // one attribute that speaks the **base** rather than the subtype, and for the same reason —
    // asking whether a value is a slot is only a question about something that is not one yet. So
    // the numbers it can be asked about are the ones a `u8` can hold, and no others.
    check("a slot in range is valid", str(Slot::Valid(7)), "true")
    check("one past the end is not", str(Slot::Valid(8)), "false")
    check("nor is the largest byte", str(Slot::Valid(255)), "false")
    check("the count one past a slot is a count", str(Count::Valid(8)), "true")

    // `Succ` and `Pred` step inside the range. Below the top they are exactly the ring's step.
    check("stepping off the front", str(int(Slot::Succ(Slot(0)))), "1")
    check("stepping back", str(int(Slot::Pred(Slot(7)))), "6")
    check("stepping to the last slot", str(int(Slot::Succ(Slot(6)))), "7")

    // And at the top they are not, which is the whole reason `wrap` is written by hand: `Succ` is
    // the step that stays inside the range, and the step a ring is made of leaves it.
    check("the ring's step goes round", str(int(wrap(Slot::Last))), "0")
    check("and elsewhere agrees with Succ", str(int(wrap(Slot(6)))), str(int(Slot::Succ(Slot(6)))))

    // `Range` walks the type itself, which is how a check can say "every slot" without repeating
    // the bound that the declaration already carries.
    var walked = ""

    for s in Slot::Range do walked += str(int(s))

    check("every slot, in order", walked, "01234567")

    var round = ""
    var s = Slot::First

    for i in 0..<10
        round += str(int(s))
        s = wrap(s)

    check("ten steps round an eight-slot ring", round, "0123456701")
end section_the_slot_type

section_an_empty_ring()
    print("-- an empty ring")

    var r = fresh_ring()
    var t = fresh_tracked()

    check("nothing in it", str(r.len()), "0")
    check("it says so", str(r.is_empty()), "true")
    check("and is not full", str(r.is_full()), "false")
    check("its end is where it begins", str(int(r.tail())), str(int(r.head)))
    check("there is nothing to look at", str(r.peek().is_some()), "false")
    check("and nothing to take", str(r.try_pop().is_some()), "false")

    check("the tracked ring agrees on length", str(t.len()), str(r.len()))
    check("and on being empty", str(t.is_empty()), str(r.is_empty()))
    check("and its two ends coincide", str(int(t.tail)), str(int(t.head)))
    check("and it has nothing to take either", str(t.try_pop().is_some()), "false")
end section_an_empty_ring

section_in_and_out()
    print("-- what goes in comes out in order")

    var r = fresh_ring()
    var t = fresh_tracked()

    r.push(1)
    r.push(2)
    r.push(3)
    t.push(1)
    t.push(2)
    t.push(3)

    check("three in", str(r.len()), "3")
    check("in the order they arrived", r.contents(), "123")
    check("the oldest is first", str(r.at(0)), "1")
    check("and the newest is last", str(r.at(2)), "3")
    check("looking does not take", str(r.peek().unwrap()), "1")
    check("and it is still three long", str(r.len()), "3")
    check("the end has moved three slots", str(int(r.tail())), "3")

    check("the tracked ring holds the same", t.contents(), r.contents())
    check("and put its end in the same place", str(int(t.tail)), str(int(r.tail())))

    check("the oldest comes out first", str(r.pop()), "1")
    check("then the next", str(r.pop()), "2")
    check("what is left", r.contents(), "3")
    check("and the beginning has moved", str(int(r.head)), "2")

    check("the tracked ring gives up the same", str(t.pop()), "1")
    check("and the same again", str(t.pop()), "2")
    check("and holds what is left", t.contents(), r.contents())
    check("with both ends where the other's are", s"${int(t.head)},${int(t.tail)}",
        s"${int(r.head)},${int(r.tail())}")
end section_in_and_out

section_filling_it()
    print("-- filling it, and what a full ring refuses")

    var r = fresh_ring()
    var t = fresh_tracked()
    var accepted = 0

    for i in 0..<capacity
        if r.try_push(int(i) + 1) then accepted += 1

    check("it took a whole capacity", str(accepted), "8")
    check("and says it is full", str(r.is_full()), "true")
    check("holding all of them in order", r.contents(), "12345678")

    // A full ring's ends coincide, which is the reason the count is a field at all: the indices
    // alone cannot tell a full ring from an empty one.
    check("its end is back at its beginning", str(int(r.tail())), str(int(r.head)))
    check("which is also true when it is empty", str(int(fresh_ring().tail())), str(int(fresh_ring().head)))
    check("and the count is what tells them apart", s"${fresh_ring().len()},${r.len()}", "0,8")

    check("one more is refused", str(r.try_push(9)), "false")
    check("and nothing was written", r.contents(), "12345678")
    check("and it is still exactly full", str(r.len()), "8")

    for i in 0..<capacity do t.try_push(int(i) + 1)

    check("the tracked ring filled the same way", t.contents(), r.contents())
    check("refuses the same", str(t.try_push(9)), "false")
    check("and is the same length after", str(t.len()), str(r.len()))
end section_filling_it

section_going_round()
    print("-- going round the end")

    var r = fresh_ring()
    var t = fresh_tracked()

    for i in 0..<capacity
        r.try_push(int(i) + 1)
        t.try_push(int(i) + 1)

    for i in 0..<3
        r.pop()
        t.pop()

    check("three taken off the front", r.contents(), "45678")
    check("and the front has moved", str(int(r.head)), "3")

    // Filling it took the end right round to zero, so with three off the front the end now sits
    // *behind* the beginning. That is what a wrapped ring is, and it is the state in which every
    // index computed by subtraction rather than by `%` is wrong.
    check("the end is behind the beginning", s"${int(r.tail())} < ${int(r.head)}", "0 < 3")
    check("and the tracked ring put it there too", str(int(t.tail)), str(int(r.tail())))

    r.push(9)
    t.push(9)

    check("a push lands in a slot already used once", r.contents(), "456789")
    check("and the buffer reused slot zero", str(r.buf[0]), "9")
    check("the tracked ring reused it too", str(t.buf[0]), "9")
    check("and holds the same", t.contents(), r.contents())

    // The element order is what a ring is for, and it survives the seam: the walk from `head`
    // crosses the end of the buffer without the caller ever seeing where that is.
    check("reading across the seam", s"${r.at(0)},${r.at(4)},${r.at(5)}", "4,8,9")
    check("and the tracked ring reads the same", s"${t.at(0)},${t.at(4)},${t.at(5)}",
        s"${r.at(0)},${r.at(4)},${r.at(5)}")
end section_going_round

section_emptying()
    print("-- emptying")

    var r = fresh_ring()
    var t = fresh_tracked()

    for i in 0..<5
        r.push(int(i) + 1)
        t.push(int(i) + 1)

    r.pop()
    t.pop()
    r.clear()
    t.clear()

    check("nothing left", str(r.len()), "0")
    check("and it says so", str(r.is_empty()), "true")
    check("its ends coincide again", str(int(r.tail())), str(int(r.head)))
    check("and there is nothing to take", str(r.try_pop().is_some()), "false")

    // Emptying the tracked ring has to move the end as well, because the end is a field there —
    // one line against `Ring`'s one write, and the clearest single measure of the extra fact.
    check("the tracked ring emptied too", str(t.len()), "0")
    check("with both of its ends together", str(int(t.tail)), str(int(t.head)))

    r.push(7)
    t.push(7)

    check("and it fills again from where it stopped", r.contents(), "7")
    check("the tracked ring the same", t.contents(), r.contents())
end section_emptying

section_a_producer_and_a_consumer()
    print("-- a producer and a consumer over one ring")

    // Every schedule below was worked out on paper before the program was run, which is what makes
    // it an assertion rather than a recording. Each is asserted twice — once against each ring —
    // and the pair is the claim that the second field buys nothing but its price.
    var a = [Put(1), Put(2), Put(3), Take, Take, Take, Take]

    check("what is put is taken, then nothing", run_ring(a), "123123-")
    check("and the tracked ring runs it the same", run_tracked(a), run_ring(a))

    var b = [Put(1), Put(2), Put(3), Put(4), Put(5), Put(6), Put(7), Put(8), Put(9)]

    check("a whole capacity, then a refusal", run_ring(b), "12345678x")
    check("the tracked ring refuses at the same tick", run_tracked(b), run_ring(b))

    var c = [Put(1), Put(2), Put(3), Put(4), Put(5), Put(6), Put(7), Put(8),
             Take, Take, Take, Put(9), Put(9), Put(9), Put(9)]

    check("filled, drained a little, refilled past the seam", run_ring(c), "12345678123999x")
    check("and the tracked ring agrees across the seam", run_tracked(c), run_ring(c))

    var d = [Put(1), Take, Put(2), Take, Put(3), Take]

    check("one at a time never fills it", run_ring(d), "112233")
    check("nor the tracked one", run_tracked(d), run_ring(d))

    var e = [Take, Take, Idle, Put(5), Take, Take]

    check("taking from an empty ring is an answer", run_ring(e), "--.55-")
    check("and it is the same answer either way", run_tracked(e), run_ring(e))

    // A run long enough that the ring goes round several times, with the consumer twice as slow as
    // the producer so it spends most of the run full and refusing.
    var long = [Idle; 40]
    var n = 0

    for i in 0..<30
        long[n] = Put(int(i) % 9 + 1)
        n += 1

        if int(i) % 3 == 2 then
            long[n] = Take
            n += 1

    check("thirty puts and ten takes", str(n), "40")
    check("the two rings run it identically", run_tracked(long), run_ring(long))
    check("with a letter for every tick", str(run_ring(long).len), "40")
end section_a_producer_and_a_consumer

section_a_ceiling_that_only_rises()
    print("-- two fields where ordering the writes is enough")

    // `Watermark`'s invariant relates two fields exactly as `Tracked`'s does, and needs none of the
    // machinery: raising the ceiling before the floor means no state in between is ever illegal.
    var w = Watermark(Count(0), Count(0))

    for i in 0..<5 do w.take()

    check("five taken", str(int(w.count)), "5")
    check("the ceiling followed", str(int(w.high)), "5")

    for i in 0..<3 do w.give()

    check("three given back", str(int(w.count)), "2")
    check("and the ceiling stayed where it was", str(int(w.high)), "5")

    w.take()

    check("taking again does not raise it", str(int(w.high)), "5")
    check("until it passes the mark", str(int(w.count)), "3")

    for i in 0..<5 do w.take()

    check("now it is above the old mark", str(int(w.count)), "8")
    check("and the ceiling rose with it", str(int(w.high)), "8")
    check("which is the whole capacity", str(int(w.high)), str(int(Count::Last)))
end section_a_ceiling_that_only_rises

// Every state a ring of this size can be in — every beginning against every occupancy — rather
// than the states the scenarios above happened to reach. This is what makes "the two agree" a
// claim about the implementations instead of about the examples.
section_every_state()
    print("-- every state a ring of this size has")

    var b = numbered()
    var visited = 0
    var disagreed = 0
    var wrong_len = 0
    var wrong_end = 0

    for h in Slot::Range
        for c in 0..capacity
            var r = Ring(b, h, Count(u8(c)))
            var t = Tracked(b, h, advance(h, Count(u8(c))), Count(u8(c)))

            visited += 1

            if r.contents() != t.contents() then disagreed += 1
            if r.len() != t.len() then wrong_len += 1
            if int(r.tail()) != int(t.tail) then wrong_end += 1

    check("every beginning against every occupancy", str(visited), "72")
    check("and they hold the same elements in all of them", str(disagreed), "0")
    check("the same number of them", str(wrong_len), "0")
    check("and put their ends in the same slot", str(wrong_end), "0")

    // The same sweep, driven rather than constructed: a script whose puts and takes are decided by
    // the tick, so the pair is compared through the operations as well as through the states.
    var mismatched = 0
    var scripts = 0

    for k in 0..<12
        var script = [Idle; 20]

        for i in 0..<20
            if (int(i) * 7 + int(k) * 3) % 5 < 3 then script[i] = Put(int(i) % 9 + 1)
            else script[i] = Take

        scripts += 1

        if run_ring(script) != run_tracked(script) then mismatched += 1

    check("twelve scripts of twenty steps", str(scripts), "12")
    check("and the two rings answered every one alike", str(mismatched), "0")
end section_every_state

section_the_slot_type()
section_an_empty_ring()
section_in_and_out()
section_filling_it()
section_going_round()
section_emptying()
section_a_producer_and_a_consumer()
section_a_ceiling_that_only_rises()
section_every_state()
