module sysl.text

// How much room text takes on a terminal, which is a different question from how many bytes it is
// and from how many characters it is.
//
// Every other measurement in this module answers something about storage: `s.len` is bytes, and a
// `Chars` walk counts scalar values. A program laying anything out in columns -- a table, a
// progress bar, anything with a border on the right -- is asking a third question, and until this
// file there was no way to ask it. `14 §2` records why the `FormatSpec` width could not answer it:
// that field counts bytes, as C's does, so `café` padded to a field of five is short by one column
// and `naïveté` by two, and the error differs between two cells of the same column.
//
// **This is data rather than algorithm**, and that is the whole reason it is here rather than in a
// program that needs it. The rule is two lines long; what makes it right is 499 ranges out of the
// Unicode Character Database, which no program should be carrying its own copy of.
//
// A `no alloc` module may use all of this: the tables are static, the search allocates nothing, and
// a program that never calls either function links neither table (`15 § What is emitted at all`).

// How many terminal columns one character occupies -- **two** for the East Asian wide and fullwidth
// forms, **none** for a combining mark or a format character, and one for everything else.
//
// A control character answers zero, which is the honest answer to a question it does not really
// have: a terminal does not draw `\n` in a column, it acts on it. A caller laying out a field is
// therefore measuring text it has already decided is printable, and one that has not is asking
// about the wrong string rather than getting a wrong number.
char_columns(c: char) -> usize
    val u = u32(c)

    if u < 0x20u32 then
        0usize
    elif u >= 0x7fu32 && u < 0xa0u32 then
        0usize
    elif in_table(zero[..], u) then
        0usize
    elif in_table(wide[..], u) then
        2usize
    else
        1usize
end char_columns

// How many terminal columns a run of UTF-8 occupies, which is the sum of what its characters do.
//
// It takes bytes rather than a `string` so that text being assembled -- what a sink has gathered,
// what a slice of a larger buffer holds -- can be measured without being copied into one first.
// `s.bytes` is the view a caller holding a `string` passes.
columns(text: []const u8) -> usize
    var n = 0usize

    for c in chars_of(text) do n += char_columns(c)

    n
end columns

// Whether `u` falls inside one of a table's ranges.
//
// The tables are sorted by low end and hold no overlaps, which is what lets this be a binary search
// rather than a walk: 499 ranges is nine comparisons rather than an average of 250, and the
// difference shows on every character of every cell of a table being laid out.
private in_table(t: []const (u32, u32), u: u32) -> bool
    var lo = 0usize
    var hi = t.len

    while lo < hi
        val mid = lo + (hi - lo) / 2usize
        val (a, b) = t[mid]

        if u < a then
            hi = mid
        elif u > b then
            lo = mid + 1usize
        else
            return true

    false
end in_table

// The two tables, and where every number in them came from.
//
// **Nothing here was written by hand.** Both are the Unicode Character Database at **17.0.0**,
// filtered by property value, reduced to ranges, and merged so that adjacent entries become one:
//
//   - `wide` is `EastAsianWidth.txt` filtered to the values **`W`** and **`F`** -- the two UAX #11
//     calls double-width -- plus the five blocks whose *unassigned* code points that file's own
//     header says default to `W`: U+3400..U+4DBF, U+4E00..U+9FFF, U+F900..U+FAFF, and the whole of
//     planes 2 and 3. Without those, a code point Unicode has not assigned yet measures as one
//     column while a terminal draws it as two.
//
//   - `zero` is `extracted/DerivedGeneralCategory.txt` filtered to **`Mn`**, **`Me`** and **`Cf`**:
//     the marks that combine with the character before them, and the format characters that are
//     not drawn at all. U+00AD SOFT HYPHEN is taken back out -- it is `Cf`, and terminals draw it
//     as an ordinary character.
//
// A code point cannot be both, so `wide` has `zero` subtracted from it rather than the answer
// depending on which table is consulted first.
//
// **Bringing these up to a later Unicode is re-running that filter over the two files**, which is
// why the derivation is written out in full: they are published at
// `https://www.unicode.org/Public/UCD/latest/ucd/`, and nothing else is consulted.

// The code points a terminal draws in two columns.
private val wide: [124](u32, u32) = [
    (0x01100u32, 0x0115fu32),
    (0x0231au32, 0x0231bu32),
    (0x02329u32, 0x0232au32),
