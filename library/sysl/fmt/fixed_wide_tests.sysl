module sysl.fmt
@tests

import sysl.buf.byte_sink
import sysl.text.from_utf8_unchecked

// A fixed-point value wider than 128 bits under a printf float conversion, rendered from its raw
// integer at its own type. The expected text is the exact decimal expansion worked out by Python's
// `decimal` module at 1200 digits, rounded half to even, and the narrow path (`format_fixed`) is the
// second oracle wherever a value fits in both.

@test("a 256-bit value is exact with the fraction at several positions")
fxw_places_of_the_point()
    // 2^200 units of 2^-100 is 2^100.
    assert_eq(format_fixed_wide(i256(1) << 200, 100, "%.3f", 0, -1), "1267650600228229401496703205376.000")
    // The most negative value is -2^127 at a fraction of 128.
    assert_eq(format_fixed_wide(i256::Min, 128, "%.5f", 0, -1),
              "-170141183460469231731687303715884105728.00000")
    // The finest unit a signed 256-bit value has.
    assert_eq(format_fixed_wide(i256(1), 256, "%.90e", 0, -1),
              "8.636168555094444625386351862800399571116000364436281385023703470168591803162427057971507503e-78")
    assert_eq(format_fixed_wide(-(i256(1) << 40), 40, "%.2f", 0, -1), "-1.00")
end fxw_places_of_the_point

@test("the ends of a 256-bit format")
fxw_min_and_max()
    assert_eq(format_fixed_wide(i256::Max, 255, "%.80f", 0, -1),
              "0.99999999999999999999999999999999999999999999999999999999999999999999999999998273")
    assert_eq(format_fixed_wide(i256::Min, 255, "%f", 0, -1), "-1.000000")
    assert_eq(format_fixed_wide(i256::Min, 1, "%.12e", 0, -1), "-2.894802230933e+76")
    assert_eq(format_fixed_wide(u256::Max, 200, "%.70f", 0, -1),
              "72057594037927935.9999999999999999999999999999999999999999999999999999999999993776984722")
    assert_eq(format_fixed_wide(u256::Max, 256, "%.30f", 0, -1), "1.000000000000000000000000000000")
    assert_eq(format_fixed_wide(u256(0), 7, "%.3f", 0, -1), "0.000")
    assert_eq(format_fixed_wide(i256(0), 7, "%e", 0, -1), "0.000000e+00")
end fxw_min_and_max

@test("a tie at the last digit is rounded half to even on the exact value")
fxw_ties_go_to_even()
    assert_eq(format_fixed_wide(i256(5), 1, "%.0f", 0, -1), "2")
    assert_eq(format_fixed_wide(i256(7), 1, "%.0f", 0, -1), "4")
    assert_eq(format_fixed_wide(i256(-5), 1, "%.0f", 0, -1), "-2")
    assert_eq(format_fixed_wide(i256(-7), 1, "%.0f", 0, -1), "-4")
    assert_eq(format_fixed_wide(i256(-3), 2, "%.1f", 0, -1), "-0.8")
    // One unit past a tie rounds up, one short rounds down.
    assert_eq(format_fixed_wide((i256(1) << 200) + 1, 201, "%.0f", 0, -1), "1")
    assert_eq(format_fixed_wide((i256(1) << 200) - 1, 201, "%.0f", 0, -1), "0")
    assert_eq(format_fixed_wide(i256(1) << 200, 201, "%.0f", 0, -1), "0")
end fxw_ties_go_to_even

@test("%e and %g of a wide value")
fxw_e_and_g()
    assert_eq(format_fixed_wide(i256(3) << 190, 100, "%.10e", 0, -1), "3.7138201179e+27")
    assert_eq(format_fixed_wide(i256(3) << 190, 100, "%g", 0, -1), "3.71382e+27")
    assert_eq(format_fixed_wide(i256::Max, 100, "%.40e", 0, -1), "4.5671926166590716193865151022383844364248e+46")
    assert_eq(format_fixed_wide(i256(1), 256, "%g", 0, -1), "8.63617e-78")
    assert_eq(format_fixed_wide(i256(3) << 190, 100, "%+020.4E", 0, -1), "+0000000003.7138E+27")
    assert_eq(format_fixed_wide(i512::Max, 300, "%.20e", 0, -1), "3.29100911464241208431e+63")
    assert_eq(format_fixed_wide(i512::Max, 300, "%.9f", 0, -1),
              "3291009114642412084309938365114701009965471731267159726697218048.000000000")
end fxw_e_and_g

@test("a wide format agrees with the narrow path on a value both hold")
fxw_agrees_with_the_narrow_path()
    val specs = ["%.25f", "%.20e", "%g", "%12.4f", "%-12.3e", "%+.0f", "%08.2f", "%#.3g"]
    val raws: []i64 = [115292150460684698, -115292150460684698, 1, -1, i64::Max, i64::Min, 0, 5]

    for spec in specs
        for raw in raws
            assert_eq(format_fixed_wide(i256(raw), 60, spec, 0, -1), format_fixed(i128(raw), 64, true, 60, spec, 0, -1))
            assert_eq(format_fixed_wide(i192(raw), 63, spec, 0, -1), format_fixed(i128(raw), 64, true, 63, spec, 0, -1))
end fxw_agrees_with_the_narrow_path

@test("a width and a precision read through '*' place a wide field as a float's")
fxw_counts_read_through_stars()
    assert_eq(format_fixed_wide(i256(1) << 200, 201, "%*.*f", 9, 3), "    0.500")
    assert_eq(format_fixed_wide(i256(1) << 200, 201, "%*.*f", -9, 3), "0.500    ")
    assert_eq(format_fixed_wide(i256(1) << 200, 201, "%.*f", 0, -4), "0.500000")
end fxw_counts_read_through_stars

// What `write_fixed_wide` wrote, or the refusal it answered.
private wrote(raw: i256, frac: int, spec: string, room: usize = 300) -> string
    var sink = byte_sink()
    var scratch: [300]u8

    write_fixed_wide(raw, frac, &sink, spec, 0, -1, scratch[0..<room]) match
        Ok(_) -> from_utf8_unchecked(sink.text())
        Err(why) -> s"refused: $why, wrote '${from_utf8_unchecked(sink.text())}'"
end wrote

@test("write_fixed_wide writes what format_fixed_wide answers, and refuses a short scratch or a bad spec")
fxw_write_fixed_wide()
    assert_eq(wrote(i256::Max, 255, "%.80f"),
              "0.99999999999999999999999999999999999999999999999999999999999999999999999999998273")
    assert_eq(wrote(i256::Max, 255, "%.80f", fixed_scratch_len(256)),
              "0.99999999999999999999999999999999999999999999999999999999999999999999999999998273")
    assert_eq(wrote(i256::Max, 255, "%.80f", 3), "refused: the scratch needs 82 bytes, wrote ''")
    assert_eq(wrote(i256(5), 8, "%d"), "refused: not a float conversion, wrote ''")
    assert_eq(wrote(i256(5), 8, "%a"), "refused: not a float conversion, wrote ''")
    assert_eq(wrote(i256(0), 8, "%e", 0), "0.000000e+00")
end fxw_write_fixed_wide
