    assert_eq(listed(fails), "")
end json_suite_accepts

@test("every n_ case of JSONTestSuite is refused")
json_suite_refuses()
    var fails: Buf[string] = buf()

    refuses(&fails, "n_array_1_true_without_comma", [0x5b, 0x31, 0x20, 0x74, 0x72, 0x75, 0x65, 0x5d])
    refuses(&fails, "n_array_a_invalid_utf8", [0x5b, 0x61, 0xe5, 0x5d])
    refuses(&fails, "n_array_colon_instead_of_comma", [0x5b, 0x22, 0x22, 0x3a, 0x20, 0x31, 0x5d])
    refuses(&fails, "n_array_comma_after_close", [0x5b, 0x22, 0x22, 0x5d, 0x2c])
    refuses(&fails, "n_array_comma_and_number", [0x5b, 0x2c, 0x31, 0x5d])
    refuses(&fails, "n_array_double_comma", [0x5b, 0x31, 0x2c, 0x2c, 0x32, 0x5d])
    refuses(&fails, "n_array_double_extra_comma", [0x5b, 0x22, 0x78, 0x22, 0x2c, 0x2c, 0x5d])
    refuses(&fails, "n_array_extra_close", [0x5b, 0x22, 0x78, 0x22, 0x5d, 0x5d])
    refuses(&fails, "n_array_extra_comma", [0x5b, 0x22, 0x22, 0x2c, 0x5d])
    refuses(&fails, "n_array_incomplete", [0x5b, 0x22, 0x78, 0x22])
    refuses(&fails, "n_array_incomplete_invalid_value", [0x5b, 0x78])
