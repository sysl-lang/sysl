// P12: a full leaf of exactly 32 elements held inline in the node's own box (one allocation), built
// from a run of generic `T` with no fill value, through an empty slot -- in both kinds.

struct Res
    n: int

impl Drop for Res
    drop(self) = print("drop", self.n)

struct Leaf[T]
    items: [32]T

fill[T](src: []const T) -> [32]T
    var out: [32]T = slot_empty()

    for i in 0..<out.len
        out[i] = src[i]

    out

run()
    var xs: []int = [0; 32]

    for i in 0..<32 do xs[i] = i

    val plain: &Leaf[int] = Leaf(fill(xs))
    val shared: &sync Leaf[int] = Leaf(fill(xs))
    var rs: []&Res = slot_storage(32)

    for i in 0..<32 do slot_place(rs, i, Res(i))

    val held: &Leaf[&Res] = Leaf(fill(rs))

    print(plain.items[31], shared.items[30], held.items[29].n, sizeof(Leaf[int]))

run()
print("done")
