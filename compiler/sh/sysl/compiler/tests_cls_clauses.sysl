module sh.sysl.compiler
@tests

import sysl.text.Search
import sysl.fs.{make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture

// Functions given by clauses (`reference/declarations.md § Clauses`, `clauses.sysl`,
// `parse_clauses.sysl`): a signature with no body, then one clause per line, each a pattern per
// parameter and a body or a block of guards, tried in order.
//
// The axes: how many parameters (one, two, three, none tested); what the patterns are (literal,
// range, variant with a payload, nested, struct, `|` alternatives, `_`, a name, a string literal
// matched by a sliced string); guards (on the clause's line, in a block, `| _`, every guard failing
// so the next clause runs); where the function stands (top level, a method with `self`, an `impl`
// method, a trait's default method, a local function capturing nothing and capturing); what the
// parameters are (generic, instantiated twice; a `&T`, whose patterns take apart what it holds; a
// `Drop` type held by a `&T`, on a counted heap; a parameter with a default); recursion (self, mutual,
// and the self call in tail position, which stays a jump); and every refusal: a gap, an unreachable
// clause, an unreachable guard, the wrong number of patterns, a clause named for another function, a
// clause with no signature, a type written in a pattern, a second guard after a one-line guard (both
// layouts), and a signature with no clauses, which keeps the meaning it had.
//
// Not written: separate compilation (a clause function is an ordinary function once read, so a
// `.syslib` sees its body as it sees any other), a bare-metal target (the only new instruction is the
// `unreachable` an exhaustive `match` already emits), `const` functions (their bodies are the same
// `if` chain an ordinary `if` is evaluated as) and the comparison pattern `fib(n < 2)`, which is not
// part of the form.

// -- the harness ----------------------------------------------------------------------------------

private cls_runnable() -> bool
    if std_root().is_err() || !clang_available()
        print("skipped: the standard module's source or clang is not on this machine")
        return false

    true
end cls_runnable

private struct ClsRun
    out: string
    err: string
end ClsRun

// What the program prints, and what it said on standard error, built on a counted heap.
private cls_run(program: string) -> ClsRun
    val root = make_temp_dir("sysl-cls").unwrap()

    write_text(s"$root/main.sysl", program).unwrap()

    val exe = s"$root/built"

    force_alloc_counting(true)

    val made = build_native_program(s"$root/main.sysl", None, None, "0", Some(exe))

    force_alloc_counting(false)

    made match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return ClsRun(s"it did not build: ${failure_text(why)}", "")
        Ok(_) -> ()

    val ran = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    ran match
        Err(_) -> ClsRun("the program that was built could not be run", "")
        Ok(o) -> ClsRun(o.text, o.err.unwrap_or(""))
end cls_run

private cls_prints(program: string, expected: string)
    val r = cls_run(program)

    assert(r.out == expected, s"expected '$expected', got: ${r.out}")
    assert(r.err == "", s"expected nothing on standard error, got: ${r.err}")
end cls_prints

// The LLVM text of the program, or everything said about it.
private cls_report(program: string) -> string
    val root = make_temp_dir("sysl-cls").unwrap()

    write_text(s"$root/main.sysl", program).unwrap()

    val out = emit_llvm_text(s"$root/main.sysl", None) match
        Err(why) -> failure_text(why)
        Ok(made) -> if made.report.is_empty() then made.text else analysis_report(made.report)

    remove_dir_all(root).unwrap_or(())
    out
end cls_report

// The program is refused with exactly this message first, at this line and column.
private cls_refused(program: string, message: string, at: string)
    val out = cls_report(program)
    val first = out.index_of("\n\n") match
        Some(n) -> out[0..<n]
        None -> out

    assert(out.starts_with(s"error: $message\n "), s"expected 'error: $message' first, got: $out")
    assert(first.index_of(s"/main.sysl:$at\n").is_some(), s"expected it first at main.sysl:$at, got: $out")
end cls_refused

private cls_shape() -> string = raw"""
    enum Shape
        Circle(r: int)
        Rect(w: int, h: int)

    """

// == what the reference claims ======================================================================

@test("a one-parameter function tries its clauses in order, guards in a block included")
cls_one_parameter_with_a_guard_block()
    if !cls_runnable() then return

    cls_prints(raw"""
        classify(n: int) -> string
        classify(0) = "zero"
        classify(n)
            | n < 0 = "negative"
            | n < 10 = "small"
            | _ = "large"

        main()
            print(classify(0), classify(-3), classify(5), classify(50))
        """, "zero negative small large\n")

@test("a variant's payload is bound by the clause that takes it apart")
cls_variants_with_payloads()
    if !cls_runnable() then return

    cls_prints(cls_shape() + raw"""
        area(s: Shape) -> int
        area(Circle(r)) = 3 * r * r
        area(Rect(w, h)) = w * h

        main()
            print(area(Circle(2)), area(Rect(2, 5)))
        """, "12 10\n")

@test("two parameters are covered together, as a matrix, not one at a time")
cls_two_parameters_cover_together()
    if !cls_runnable() then return

    cls_prints(raw"""
        both(a: bool, b: bool) -> int
        both(true, true) = 3
        both(true, false) = 2
        both(false, x) = if x then 1 else 0

        main()
            print(both(true, true), both(true, false), both(false, true), both(false, false))
        """, "3 2 1 0\n")

@test("three parameters, a wildcard among them")
cls_three_parameters()
    if !cls_runnable() then return

    cls_prints(raw"""
        pick3(a: int, b: bool, c: Option[int]) -> int
        pick3(0, _, None) = 0
        pick3(0, true, Some(n)) = n
        pick3(0, false, Some(n)) = -n
        pick3(a, _, _) = a * 100

        main()
            print(pick3(0, true, None), pick3(0, true, Some(4)), pick3(0, false, Some(4)), pick3(2, false, None))
        """, "0 4 -4 200\n")

@test("ranges, alternatives, nested and struct patterns stand in a clause as in a match arm")
cls_pattern_kinds()
    if !cls_runnable() then return

    cls_prints(raw"""
        struct Point
            x: int
            y: int

        grade(n: u8) -> string
        grade(0..59) = "F"
        grade(60..69 | 70..79) = "C"
        grade(80..255) = "A"

        nested(o: Option[Option[int]]) -> int
        nested(Some(Some(n))) = n
        nested(Some(None)) = -1
        nested(None) = -2

        pt(p: Point) -> int
        pt(Point { x: 0, y }) = y
        pt(Point { x, y: 0 }) = x
        pt(_) = 99

        main()
            print(grade(10), grade(75), grade(90))
            print(nested(Some(Some(4))), nested(Some(None)), nested(None))
            print(pt(Point(0, 7)), pt(Point(4, 0)), pt(Point(1, 1)))
        """, "F C A\n4 -1 -2\n7 4 99\n")

// A literal is NUL-terminated and a slice of a longer string is not, so the slice is the argument
// that could tell a comparison reading past the length.
@test("a string literal pattern matches a sliced string by its contents")
cls_string_literal_patterns()
    if !cls_runnable() then return

    cls_prints(raw"""
        greet(name: string) -> string
        greet("bob") = "hi bob"
        greet(other) = "hello " + other

        main()
            print(greet("bob"), greet("bobby"[0..<3]), greet("al"[0..<1]))
        """, "hi bob hi bob hello a\n")

@test("a clause whose guards all fail goes on to the next clause")
cls_failed_guard_falls_to_the_next_clause()
    if !cls_runnable() then return

    cls_prints(cls_shape() + raw"""
        describe(s: Shape, limit: int) -> string
        describe(Circle(r), _) | r > 10 = "big circle"
        describe(Rect(w, h), limit)
            | w > limit = "wide"
            | h > limit = "tall"
        describe(Circle(_), _) = "circle"
        describe(Rect(_, _), _) = "rect"

        main()
            print(describe(Circle(20), 0), describe(Circle(2), 0))
            print(describe(Rect(9, 1), 5), describe(Rect(1, 9), 5), describe(Rect(1, 1), 5))
        """, "big circle circle\nwide tall rect\n")

@test("a generic function given by clauses is instantiated at each type it is called with")
cls_generic()
    if !cls_runnable() then return

    cls_prints(raw"""
        choose[T](c: bool, a: T, b: T) -> T
        choose(true, a, _) = a
        choose(false, _, b) = b

        main()
            print(choose(true, 1, 2), choose(false, "a", "b"))
        """, "1 b\n")

@test("a method's clauses match its parameters after 'self', in a type, an impl and a trait default")
cls_methods()
    if !cls_runnable() then return

    cls_prints(raw"""
        struct Point
            x: int
            y: int

            side(self, scale: int) -> string
            side(0) = "none"
            side(s) | self.x * s > 0 = "east"
            side(_) = "west"

        trait Describe
            describe(self, n: int) -> string
            tag(self, n: int) -> string
            tag(0) = "untagged"
            tag(_) = "tagged"

        impl Describe for Point
            describe(self, n: int) -> string
            describe(1) = s"one at ${self.x}"
            describe(_) = "many"

        main()
            val p = Point(2, 5)
            print(p.side(0), p.side(1), Point(-1, 0).side(1))
            print(p.describe(1), p.describe(2), p.tag(0), p.tag(3))
        """, "none east west\none at 2 many untagged tagged\n")

@test("a trait signature with no clauses under it is still a requirement")
cls_trait_requirement_unchanged()
    if !cls_runnable() then return

    cls_refused(raw"""
        trait Describe
            describe(self, n: int) -> string

        struct P
            x: int

        impl Describe for P
            other(self) -> int = 1

        main()
            print(P(1).other())
        """, "'P' does not implement 'Describe': method 'describe' is missing", "7:1")

@test("a local function may be given by clauses, capturing or not")
cls_local_functions()
    if !cls_runnable() then return

    cls_prints(raw"""
        main()
            val k = 3

            near(n: int) -> int
            near(0) = k
