module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.math.bigint.{BigInt, from_int}

// **Module storage**, and the constant expressions that fill it.
//
// A `val`'s initializer is text laid straight into the object file, with no instruction emitted for
// any of it. What cannot be written that way is `computed`, and the entry point fills it -- so the
// global is emitted zeroed and this file has nothing to say about it.

// What a `val`'s storage starts at. A `computed` one is filled by the entry point, so the object
// file carries zeros for it and nothing here has anything to say.
private val_init(e: *Emit, v: TVal) -> Val
    if v.computed then return VZero

    v.init match
        Some(x) -> constant_value(e, x)
        None -> VZero
end val_init

// The storage a program's `val`s come to.
gen_vals(e: *Emit, vals: Buf[TVal]) -> Buf[IrGlobal]
    var out: Buf[IrGlobal] = buf()

    for i in 0..<vals.len()
        val v = vals.at(i)

        val init = val_init(e, v)

        // The binding's own `@align(n)`, or the boundary its type raises -- the greater of the two.
        val own: Option[int] = v.align match
            Some(n) -> Some(int(n))
            None -> None

        val align = wider_align(own, e.layout.storage_align(v.ty))

        out.push(IrGlobal(v.symbol, !(v.computed || v.writable), lty(e, v.ty), Some(init),
                          LinkPrivate, v.section, align, v.thread_local, false))

    out
end gen_vals

// The greater of two boundaries either of which may be unstated.
wider_align(a: Option[int], b: Option[int]) -> Option[int] = b match
    Some(y) ->
        a match
            Some(x) -> if x >= y then Some(x) else Some(y)
            None -> Some(y)
    None -> a

// `@llvm.used` -- the symbols this module places by hand and nothing in it reads. It is what keeps
// the feature from compiling, linking and placing nothing: a table gathered by a linker script has
// no reader inside the program.
gen_used(names: Buf[string]) -> Option[IrGlobal]
    if names.is_empty() then return None

    var elems: Buf[IrArg] = buf()

    for item in names
        elems.push(ir_arg(LPtr, VGlobal(item)))

    Some(IrGlobal(llvm_used(), false, LArr(int(names.len()), LPtr), Some(VArray(elems)),
                  LinkAppending, Some(llvm_metadata_section()), None, false, false))
end gen_used

// A constant integer with its bytes reversed at `bits`, for a field of a `@byte_order` struct laid
// down as data -- the image holds the bytes the format does, exactly as a store at run time would
// have left them. A zero reversed is zero.
private reversed_constant(v: Val, bits: int, ty: Type) -> Val
    if bits == 0 then return v

    val signed = underlying(ty) match
        Integer(_, s, _) -> s
        Fixed(_, _, s) -> s
        Enum(d) -> underlying(d.underlying) match
            Integer(_, s, _) -> s
            _ -> false
        _ -> false

    v match
        VInt(n) -> VInt(swapped_bytes(n, bits, signed))
        _ -> v
end reversed_constant

// A `val`'s initializer as a **constant expression**.
constant_value(e: *Emit, t: TExpr) -> Val = *t.kind match
    TIntLit(v, _) -> VInt(v)

    // A module-level `bool` is written as its bit rather than as `true`, which is what LLVM's own
    // constant grammar takes -- the word is the *instruction* operand's spelling.
    TBoolLit(b) -> VInt(from_int(if b then 1 else 0))
    TFloatLit(bits, ty) -> if ty == real_type() then VFloat(bits) else v_float32(real_of_bits(bits))
    TQuadLit(hi, lo, _) -> VQuad(hi, lo)

    // Three words naming bytes that are never freed. The owner is null, which is what makes the whole
    // value a constant expression rather than something a prologue has to build.
    TStrLit(s) -> string_const(e, s)

    // The same three words over the file's bytes.
    TEmbed(file, bytes, align) -> embed_const(e, file, bytes, align)

    // **`[0; N]` is one word, not N of them.** `zeroinitializer` is what LLVM takes for an aggregate
    // whose every bit is zero, and writing the elements out instead costs the whole array in the
    // module's text for an output that never grows.
    TArrayFill(value, array_ty) ->
        val elem = constant_value(e, value)

        if is_zero_const(elem) then VZero
        else
            val n = underlying(array_ty) match
                Array(len, _) -> len
                _ -> 0

            val ety = underlying(array_ty) match
                Array(_, el) -> *el
                _ -> int_type()

            var elems: Buf[IrArg] = buf()

            for i in 0..<n
                elems.push(ir_arg(lty(e, ety), elem))

            VArray(elems)

    TArrayLit(items, array_ty) ->
        val ety = underlying(array_ty) match
            Array(_, el) -> *el
            _ -> int_type()

        var elems: Buf[IrArg] = buf()

        for item in items
            elems.push(ir_arg(lty(e, ety), constant_value(e, item)))

        VArray(elems)

    // A struct constant lists its fields in the order the type declares them, and skips the ones that
    // occupy nothing -- the initializer has to match the type this module emitted.
    TStructNew(decl, args) ->
        var fields: Buf[IrArg] = buf()

        for i in 0..<args.len()
            val ft = decl.fields.at(i).1

            if !zero_sized(ft)
                val bits = reversed_width(decl, ft, e.target.little_endian())

                fields.push(ir_arg(lty(e, ft), reversed_constant(constant_value(e, args.at(i)), bits, ft)))

        // A raised boundary's gaps are fields of the definition, so they are zeros here. A `@packed`
        // struct's type is LLVM's `<{ }>`, and a constant of it has to be written in the same brackets.
        val laid = gapped_values(fields, struct_gaps(e.layout, decl))

        if decl.packed then VPackedAgg(laid) else VAgg(laid)

    // A device address written as a number: `inttoptr` is a constant expression, so the pointer is in
    // the object file rather than stored into it by a prologue.
    TCast(v, _) -> VIntToPtr(lty_of(e, v), constant_value(e, v))

    // A trait pointer is two words, so its empty value is not the one-word `null`.
    TNullLit(ty) -> if erased(underlying(ty)) then VZero else VNull

    // A variant that carries nothing is a tag and a payload region nothing will read -- except in a
    // simple enum, which is its underlying integer and nothing else, so its constant is the bare tag
    // at that width: the value the program wrote, not a `{ tag, region }` pair.
    TEnumNew(en, variant, _) ->
        if variant.carries then gap_at(e, "a constant enum variant that carries a payload")
        else if variant.tag.is_zero() then VZero
        else
            val d = underlying(en) match
                Enum(decl) -> decl
                _ -> return gap_at(e, "a constant enum of something that is not an enum")

            if d.simple then return VInt(variant.tag)

            val area = payload_area(d, e.layout)

            var fields: Buf[IrArg] = buf()

            fields.push(ir_arg(l_i32(), VInt(variant.tag)))
            fields.push(ir_arg(LArr(area.1, area.0), VZero))
            VAgg(gapped_values(fields, enum_gaps(e.layout, d)))

    _ -> gap_at(e, s"a constant ${texpr_kind_name(t)}")

// **A large array literal of constants is DATA, copied into place with one `memcpy`.** Built element
// by element it is two stores per string and a store per scalar, all in one function, and LLVM's
// passes over a body that size are worse than linear: a 4,000-row table of string pairs took ten
// seconds of `-O1` for a program whose own code is a dozen lines. Laid down as a private constant,
// the same table is one initializer the object file carries and one call -- which is what clang does
// for a `const` aggregate initializer in C. A short literal keeps the stores, which the optimizer
// folds into whatever reads them.
const table_elements: usize = 64

// Whether an array literal is built by copying a constant table: long enough for the stores to
// cost, and every element something `constant_value` lays down exactly as the stores would write it.
is_constant_table(elems: Buf[TExpr]) -> bool = elems.len() >= table_elements && all_constant(elems)

// The constant table an array literal is copied out of, laid down at the alignment its type wants
// so the copy may claim it at both ends.
constant_table(e: *Emit, t: TExpr, ty: Type) -> Val
    e.table_id += 1

    val name = s".table${e.table_id}"
    val image = constant_value(e, t)

    e.globals.push(IrGlobal(name, true, lty(e, ty), Some(image), LinkPrivate, None,
                            Some(int(e.layout.align(ty))), false, false))
    VGlobal(name)
end constant_table

// Whether `constant_value` writes this value as the bytes the element-by-element lowering would
// store. Deliberately narrow: an integer, a `bool`, a `real` or `f32`, a string, a null, and arrays
// and plain structs of those. A bitfield struct packs its fields into one container and an enum
// has a representation of its own, so neither is claimed.
private is_constant_image(t: TExpr) -> bool = *t.kind match
    TIntLit(_, ty) ->
        underlying(ty) match
            Integer(_, _, _) -> true
            _ -> false
    TBoolLit(_) -> true
    TFloatLit(_, ty) -> ty == real_type() || ty == Floating(32, false)
    TQuadLit(_, _, _) -> true
    TStrLit(_) -> true
    TEmbed(_, _, _) -> true
    TNullLit(_) -> true
    TArrayLit(items, _) -> all_constant(items)
    TStructNew(decl, args) -> bitfield_ranges_of(Struct(decl)).is_none() && all_constant(args)
    _ -> false

private all_constant(items: Buf[TExpr]) -> bool
    for item in items
        if !is_constant_image(item) then return false

    true
end all_constant

// A string as a value: the owner nothing frees, the bytes, and how many there are.
string_const(e: *Emit, s: string) -> Val
    var fields: Buf[IrArg] = buf()

    fields.push(ir_arg(LPtr, VNull))
    fields.push(ir_arg(LPtr, string_global(e, s)))
    fields.push(ir_arg(word_lty(e), VInt(from_int(long(s.bytes.len)))))
    VAgg(fields)
end string_const

// An embedded file as a value: the owner nothing frees, its bytes, and how many there are.
//
// **The bytes are laid down once per file and boundary**, however many places name them -- a generic
// instantiated three times, or two functions embedding one image, would otherwise carry the image
// three times. The global's name is made from the path, so a second use finds the first.
embed_const(e: *Emit, file: string, bytes: []u8, align: int) -> Val
    val name = s".embed.${bytes_fingerprint(file.bytes)}.$align"

    if !has_global(e, name)
        var data: Buf[u8] = buf()

        for b in bytes do data.push(b)

        // An empty file is an array of nothing, which LLVM takes as zeros rather than as `c""`.
        val image = if data.is_empty() then VZero else VBytes(data)

        e.globals.push(IrGlobal(name, true, LArr(int(data.len()), LInt(8)), Some(image), LinkPrivate,
                                None, Some(align), false, false))

    var fields: Buf[IrArg] = buf()

    fields.push(ir_arg(LPtr, VNull))
    fields.push(ir_arg(LPtr, VGlobal(name)))
    fields.push(ir_arg(word_lty(e), VInt(from_int(long(bytes.len)))))
    VAgg(fields)
end embed_const

private has_global(e: *Emit, name: string) -> bool
    for g in e.globals
        if g.name == name then return true

    false
end has_global

// Whether a constant is every bit zero, which is the one thing `zeroinitializer` may stand for. A
// float is zero at bit pattern zero alone, so `-0.0` -- whose sign bit is set -- is correctly not
// one.
private is_zero_const(v: Val) -> bool = v match
    VInt(n) -> n == from_int(0)
    VBool(b) -> !b
    VFloat(bits) -> bits == 0
    VQuad(hi, lo) -> hi == 0 && lo == 0
    VNull -> true
    VZero -> true
    VAgg(fields) -> all_zero(fields)
    VPackedAgg(fields) -> all_zero(fields)
    VArray(elems) -> all_zero(elems)
    _ -> false

private all_zero(items: Buf[IrArg]) -> bool
    for item in items
        if !is_zero_const(item.value) then return false

    true
end all_zero
