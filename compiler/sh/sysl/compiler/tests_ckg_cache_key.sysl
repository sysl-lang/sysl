    assert_eq(ran, "10 1.0.0 | 10 1.1.0 | 10 1.0.0 | miss miss hit | different bytes")
end ckg_graph_diamond_bump_same_source

@test("a diamond: a --lib root reading the shared package misses its kept half when the bump moves a constant")
ckg_graph_diamond_bump_reaches_a_root()
    if !ckg_ready() then return

    val d = ckg_diamond(11)
    val lib = ckg_tree([("user/user.sysl", "module user\n\nimport shared\n\nseen() -> int = shared.Answer\n")])
    val low = ckg_manifest("b", "dependencies { shared { git = \"github.com/e/shared\", version = \"1.0.0\" } }\n")
    val high = ckg_manifest("b", d.1)

    ckg_put(d.0, "main.sysl", ckg_main(d.0, "import user", "user.seen()"))

    val kept = ckg_root_seam(d.0, lib, "", "", () -> ckg_put(d.0, "b/package.hocon", low),
                             () -> ckg_put(d.0, "b/package.hocon", high))

    lbr_drop([d.0, lib])
    assert_eq(kept, "10 | 11 | 10 | miss miss hit")
end ckg_graph_diamond_bump_reaches_a_root

// -- what is exempt, held to changing nothing --------------------------------------------------------

@test("description, license, authors and keywords are in no key, and change no output")
ckg_exempt_package_prose()
    if !ckg_ready() then return

    val root = ckg_featured("fancy = []")
    val said = ckg_manifest("app", "features { fancy = [] }\n")
    val prose = "package { name = \"app\", version = \"1.0.0\", description = \"other words\", " +
        "license = \"MIT\", authors = [\"someone\"], keywords = [\"k\"] }\nfeatures { fancy = [] }\n"

    assert_eq(ckg_manifest_seam(root, said, prose), "1 | 1 | 1 | miss hit hit | 1 entries")

    // And compiled from scratch each way, the program answers the same.
    ckg_setenv("SYSL_NO_CACHE", "1")
    ckg_put(root, "package.hocon", said)
    assert_eq(ckg_ran(root, ""), "1")
    ckg_put(root, "package.hocon", prose)
    assert_eq(ckg_ran(root, ""), "1")
    ckg_unsetenv("SYSL_NO_CACHE")
    remove_dir_all(root).unwrap_or(())
end ckg_exempt_package_prose

@test("the test block is in no key: a suite under another timeout replays the binary and still passes")
ckg_exempt_test_block()
    if !ckg_ready() then return

    val root = ckg_tree([("package.hocon", ckg_manifest("app", "")),
                         ("main.sysl", "@test\none()\n    assert_eq(1, 1)\n")])
    val cache = ckg_caches()
    var codes: Buf[string] = buf()
    var how: Buf[string] = buf()

    for step in 0..<2
        if step == 1 then ckg_put(root, "package.hocon", ckg_manifest("app", "test { timeout = 77, jobs = 1 }\n"))

        val before = run_cache_counts()
        val args = ckg_args("test", root, "")

        codes.push(s"${ckg_cli(args.view()).0}")
        how.push(ckg_run_verdict(before, run_cache_counts()))

    ckg_done(cache, [root])
    assert_eq(join(codes.view(), " "), "0 0")
    assert_eq(join(how.view(), " "), "miss hit")
end ckg_exempt_test_block

@test("SYSL_CODEGEN_UNITS is in no key: a program split four ways is the program split one way")
ckg_exempt_codegen_units()
    if !ckg_ready() then return

    val root = ckg_featured("fancy = []")
    val cache = ckg_caches()

    ckg_setenv("SYSL_CODEGEN_UNITS", "1")

    val one = ckg_ran(root, "")

    ckg_setenv("SYSL_CODEGEN_UNITS", "4")

    val before = run_cache_counts()
    val replayed = ckg_ran(root, "")
    val verdict = ckg_run_verdict(before, run_cache_counts())

    ckg_setenv("SYSL_NO_CACHE", "1")

    val four = ckg_ran(root, "")

    ckg_unsetenv("SYSL_NO_CACHE")
    ckg_unsetenv("SYSL_CODEGEN_UNITS")
    ckg_done(cache, [root])
    assert_eq(s"$one $replayed $four $verdict", "1 1 1 hit")
end ckg_exempt_codegen_units

@test("SYSL_TIMINGS, -v and --explain-escapes change no output; the first two replay")
ckg_exempt_reports()
    if !ckg_ready() then return

    val root = ckg_featured("fancy = []")
    val cache = ckg_caches()
    var said: Buf[string] = buf()
    var how: Buf[string] = buf()

    for step in 0..<4
        if step == 1 then ckg_setenv("SYSL_TIMINGS", "1") else ckg_unsetenv("SYSL_TIMINGS")

        val before = run_cache_counts()

        said.push(ckg_ran(root, if step == 2 then "-v" else if step == 3 then "--explain-escapes" else ""))
        how.push(ckg_run_verdict(before, run_cache_counts()))

    ckg_unsetenv("SYSL_TIMINGS")
    ckg_done(cache, [root])
    assert_eq(join(said.view(), " "), "1 1 1 1")
    // `--explain-escapes` compiles again, since a replay could not report, and relinks the same slot.
    assert_eq(join(how.view(), " "), "miss hit hit miss")
end ckg_exempt_reports

@test("--filter, --file, --jobs, --timeout and --fail-fast choose among a binary's tests: each replays it")
ckg_exempt_runner_flags()
    if !ckg_ready() then return

    val root = ckg_tree([("package.hocon", ckg_manifest("app", "")),
                         ("main.sysl", "@test\none()\n    assert_eq(1, 1)\n\n@test\ntwo()\n    assert_eq(2, 2)\n")])
    val cache = ckg_caches()
    val flags = ["", "--filter one", "--file main.sysl", "--jobs 1", "--timeout 30", "--fail-fast"]
    var how: Buf[string] = buf()

    for i in 0..<flags.len
        val before = run_cache_counts()
        val args = ckg_args("test", root, flags[i])

        assert_eq(ckg_cli(args.view()).0, 0)
        how.push(ckg_run_verdict(before, run_cache_counts()))

    ckg_done(cache, [root])
    assert_eq(join(how.view(), " "), "miss hit hit hit hit hit")
end ckg_exempt_runner_flags

@test("a program's own arguments are in no key: one binary, run with two")
ckg_exempt_program_arguments()
    if !ckg_ready() then return

    val root = ckg_with_args("", "args.len")
    val cache = ckg_caches()
    var said: Buf[string] = buf()
    var how: Buf[string] = buf()

    for step in 0..<2
        val before = run_cache_counts()

        said.push(ckg_ran(root, if step == 1 then "-- x y" else ""))
        how.push(ckg_run_verdict(before, run_cache_counts()))

    ckg_done(cache, [root])
    assert_eq(join(said.view(), " "), "1 3")
    assert_eq(join(how.view(), " "), "miss hit")
end ckg_exempt_program_arguments

@test("-o is in no key: a second build writing elsewhere replays the root's kept half and runs the same")
ckg_exempt_output_path()
    if !ckg_ready() then return

    val lib = ckg_tree([("geo/geo.sysl", "module geo\n\nvalue() -> int = 3\n")])
    val root = ckg_project(ckg_manifest("app", ""), "import geo", "geo.value()", [])
    val cache = ckg_caches()
    var said: Buf[string] = buf()
    var how: Buf[string] = buf()

    for step in 0..<2
        val before = root_artifact_counts()

        said.push(ckg_built(root, s"--lib $lib", s"$cache/out$step"))
        how.push(ckg_root_verdict(before, root_artifact_counts()))

    ckg_done(cache, [root, lib])
    assert_eq(join(said.view(), " "), "3 3")
    assert_eq(join(how.view(), " "), "miss hit")
end ckg_exempt_output_path

@test("where the caches and the library are is in no key: HOME, XDG_CACHE_HOME, PATH and SYSL_LIB's spelling")
ckg_exempt_locations()
    if !ckg_ready() then return

    val root = ckg_featured("fancy = []")
    val plain = run_cache_key_for("run", root, None, DefaultOptimization, None)
    val home = env_get("HOME").unwrap_or("")
    val search = env_get("PATH").unwrap_or("")
    val library = std_root().unwrap()

    ckg_setenv("HOME", "/ckg/elsewhere")
    ckg_setenv("XDG_CACHE_HOME", "/ckg/elsewhere")
    ckg_setenv("PATH", s"/ckg/elsewhere:$search")
    ckg_setenv("SYSL_LIB", s"$library/../${basename(library)}/.")

    val moved = run_cache_key_for("run", root, None, DefaultOptimization, None)

    ckg_unsetenv("XDG_CACHE_HOME")
    ckg_setenv("PATH", search)
    ckg_setenv("SYSL_LIB", library)
    ckg_setenv("HOME", home)
    remove_dir_all(root).unwrap_or(())
    assert(plain.is_some() && moved.is_some())
    assert_eq(moved.unwrap(), plain.unwrap())
end ckg_exempt_locations

@test("the commands that keep nothing leave every cache empty, whatever flags they take")
ckg_exempt_commands_keep_nothing()
    if !ckg_ready() then return

    val root = ckg_featured("fancy = []")
    val docs = lbr_temp("sysl-ckg-doc")
    val cache = ckg_caches()
    val lines = [s"emit-llvm --gaps $root", s"emit-typed --tables --no-spans $root",
                 s"emit-ast --no-spans $root/main.sysl", s"doc -o $docs -t T -n N -w 80 -V 1.0.0 --private $root",
                 s"tidy --check $root", "--version", "--help"]

    for i in 0..<lines.len
        var args: Buf[string] = buf()

        args.push("sysl")

        for item in split(lines[i], " ")
            args.push(item)

        ckg_cli(args.view())

    val run_left = ckg_entries(cache).len()
    val root_left = root_artifact_counts()

    ckg_done(cache, [root, docs])
    assert_eq(run_left, 0)
    assert_eq(root_left.1, 0)
end ckg_exempt_commands_keep_nothing

// -- the census --------------------------------------------------------------------------------------

// Every flag `sysl --help` names: each word that starts with a dash, cut at its argument.
private ckg_help_flags() -> Buf[string]
    var out: Buf[string] = buf()

    for line in lines_of(help_text())
        for word in split(line, " ")
            var w = word

            while w.starts_with("[") || w.starts_with("(")
                w = w[1..]

            if !w.starts_with("-") || w.len < 2 then continue

            var end_at = w.len

            for i in 1..<w.len
                val c = w.bytes[i]

                if c == u8('<') || c == u8(']') || c == u8('|') || c == u8(',') || c == u8('=')
                    end_at = i
                    break

            val flag = w[0..<end_at]

            if !holds_string(out, flag) then out.push(flag)

    out
end ckg_help_flags

@test("the census: every flag sysl --help names is classified for the caches, and every classified flag exists")
ckg_census_flags()
    val named = ckg_help_flags()
    var unclassified: Buf[string] = buf()

    for flag in named
        if flag_cache_class(flag).is_none() then unclassified.push(flag)

    assert_eq(join(unclassified.view(), " "), "")

    var stale: Buf[string] = buf()

    for i in 0..<FlagCacheClass.len
        val flag = FlagCacheClass[i].0

        if !holds_string(named, flag) && flag != "--" then stale.push(flag)

    assert_eq(join(stale.view(), " "), "")

    for i in 0..<FlagCacheClass.len
        val how = FlagCacheClass[i].1

        assert(how.starts_with("keyed: ") || how.starts_with("exempt: "), FlagCacheClass[i].0)
end ckg_census_flags

// Whether a manifest holding one key at `place` (a dotted path) keeps it in its canonical part: the key
// is given a block holding `ckg_probe`, which survives only where nothing on the way is exempt.
private ckg_keeps(place: string) -> bool
    val parts = split(place, ".")
    var text = "ckg_probe = 1"
    var i = parts.len

    while i > 0
        i -= 1
        text = s"${parts[i]} { $text }"

    read_conf(text) match
        Ok(c) -> conf_canonical(c).contains("ckg_probe")
        Err(why) -> panic(why)
end ckg_keeps

@test("the census: every key the manifest reader accepts is in the key unless the exempt table names it")
ckg_census_manifest_keys()
    var places: Buf[string] = buf()

    for i in 0..<TopKeys.len
        places.push(TopKeys[i])

    for i in 0..<PackageKeys.len
        places.push(s"package.${PackageKeys[i]}")

    for i in 0..<TargetKeys.len
        places.push(s"targets.t.${TargetKeys[i]}")

    for i in 0..<DependencyKeys.len
        places.push(s"dependencies.d.${DependencyKeys[i]}")

    var wrong: Buf[string] = buf()

    for place in places
        val keyed = ckg_keeps(place)
        val exempt = manifest_exemption(place).is_some()

        if keyed == exempt then wrong.push(place)

    assert_eq(join(wrong.view(), " "), "")

    // And every exemption names a key the reader accepts.
    for i in 0..<ManifestExempt.len
        assert(holds_string(places, ManifestExempt[i].0), ManifestExempt[i].0)
end ckg_census_manifest_keys

// Every environment variable the compiler's own source reads: each upper-case literal on a line that
// asks the environment or declares a constant, among the source files beside this one.
private ckg_source_variables() -> Buf[string]
    var out: Buf[string] = buf()
    val dir = parent_of(__FILE__).unwrap()

    for name in entries(dir).unwrap()
        if !name.ends_with(".sysl") || name.starts_with("tests_") then continue

        for line in lines_of(read_text(s"$dir/$name").unwrap())
            val asks = line.contains("env_var(") || line.contains("get(\"") ||
                (line.contains("const ") && line.contains("_"))

            if !asks then continue

            val pieces = split(line, "\"")

            for i in 0..<pieces.len
                if i % 2 == 1 && ckg_shouts(pieces[i]) && !holds_string(out, pieces[i]) then out.push(pieces[i])

    out
end ckg_source_variables

private ckg_shouts(text: string) -> bool
    if text.len < 4 then return false

    for i in 0..<text.len
        val c = text.bytes[i]

        if !((c >= u8('A') && c <= u8('Z')) || (c >= u8('0') && c <= u8('9')) || c == u8('_')) then return false

    true
end ckg_shouts

@test("the census: every environment variable the compiler reads is classified for the caches")
ckg_census_environment()
    val read = ckg_source_variables()
    var unclassified: Buf[string] = buf()

    for name in read
        if environment_cache_class(name).is_none() then unclassified.push(name)

    assert_eq(join(unclassified.view(), " "), "")
    assert(read.len() >= 10, s"the scan found only ${join(read.view(), " ")}")

    // Every variable `build_environment` keys is classified as keyed.
    for i in 0..<EnvironmentCacheClass.len
        val how = EnvironmentCacheClass[i].1

        assert(how.starts_with("keyed: ") || how.starts_with("exempt: "), EnvironmentCacheClass[i].0)
end ckg_census_environment

// -- the entries themselves: damaged, misplaced, raced --------------------------------------------------

// One run, so the cache holds one entry; then `damage` done to it; then a second run, which must
// print the same and must not have replayed what `damage` left.
private ckg_after_damage(damage: (string, string) -> unit) -> string
    val root = ckg_featured("fancy = []")
    val cache = ckg_caches()
    val first = ckg_ran(root, "")
    val made = ckg_entries(cache)

    damage(made.at(0), cache)

    val before = run_cache_counts()
    val second = ckg_ran(root, "")
    val verdict = ckg_run_verdict(before, run_cache_counts())
    val third_before = run_cache_counts()
    val third = ckg_ran(root, "")
    val third_verdict = ckg_run_verdict(third_before, run_cache_counts())

    ckg_done(cache, [root])
    s"$first $second $verdict $third $third_verdict"
end ckg_after_damage

private ckg_truncate(entry: string, cache: string)
    val bytes = read_bytes(entry).unwrap()

    write_bytes(entry, bytes[0..<bytes.len / 2]).unwrap()
end ckg_truncate

private ckg_flip(entry: string, cache: string)
    val bytes = read_bytes(entry).unwrap()
    var changed: Buf[u8] = buf()

    for i in 0..<bytes.len
        changed.push(if i == bytes.len / 2 then bytes[i] ^ 0xff else bytes[i])

    write_bytes(entry, changed.view()).unwrap()
end ckg_flip

@test("a truncated run-cache entry is rebuilt, never started")
ckg_error_truncated_entry()
    if !ckg_ready() then return

    assert_eq(ckg_after_damage((e, c) -> ckg_truncate(e, c)), "1 1 miss 1 hit")
end ckg_error_truncated_entry

@test("a run-cache entry damaged in place, at its own length, is rebuilt")
ckg_error_damaged_entry()
    if !ckg_ready() then return

    assert_eq(ckg_after_damage((e, c) -> ckg_flip(e, c)), "1 1 miss 1 hit")
end ckg_error_damaged_entry

@test("an entry with no seal -- one an older compiler left -- is rebuilt")
ckg_error_unsealed_entry()
    if !ckg_ready() then return

    assert_eq(ckg_after_damage((e, c) -> remove_file(s"$e$SealSuffix").unwrap_or(())), "1 1 miss 1 hit")
end ckg_error_unsealed_entry

@test("another key's entry copied over this one's slot, seal and all, is rebuilt rather than run")
ckg_error_entry_under_another_key()
    if !ckg_ready() then return

    val root = ckg_featured("fancy = []")
    val cache = ckg_caches()
    val plain = ckg_ran(root, "")
    val plain_entry = ckg_entries(cache).at(0)
    val fancy = ckg_ran(root, "--features fancy")
    var fancy_entry = ""

    for e in ckg_entries(cache)
        if e != plain_entry then fancy_entry = e

    write_bytes(plain_entry, read_bytes(fancy_entry).unwrap()).unwrap()
    write_text(s"$plain_entry$SealSuffix", read_text(s"$fancy_entry$SealSuffix").unwrap()).unwrap()

    val before = run_cache_counts()
    val again = ckg_ran(root, "")
    val verdict = ckg_run_verdict(before, run_cache_counts())

    ckg_done(cache, [root])
    assert_eq(s"$plain $fancy $again $verdict", "1 2 1 miss")
end ckg_error_entry_under_another_key

@test("two builds racing on one key: a binary published over the slot after the seal is not replayed")
ckg_error_raced_publish()
    if !ckg_ready() then return

    val root = ckg_featured("fancy = []")
    val cache = ckg_caches()
    val plain = ckg_ran(root, "")
    val plain_entry = ckg_entries(cache).at(0)

    ckg_ran(root, "--features fancy")

    var fancy_entry = ""

    for e in ckg_entries(cache)
        if e != plain_entry then fancy_entry = e

    // The other build's binary lands on the slot; the seal is still the first build's.
    write_bytes(plain_entry, read_bytes(fancy_entry).unwrap()).unwrap()

    val before = run_cache_counts()
    val again = ckg_ran(root, "")
    val verdict = ckg_run_verdict(before, run_cache_counts())
    val sealed = run_cache_hit(run_cache_key_for("run", root, None, DefaultOptimization, None).unwrap()).is_some()

    ckg_done(cache, [root])
    assert_eq(s"$plain $again $verdict $sealed", "1 1 miss true")
end ckg_error_raced_publish

// The archive of the one kept half in a cache.
private ckg_root_entries(cache: string) -> Buf[string]
    var out: Buf[string] = buf()

    entries(s"$cache/sysl/roots") match
        Err(_) -> ()
        Ok(names) ->
            for item in names
                if item.ends_with(SyslibExtension) then out.push(s"$cache/sysl/roots/$item")

    out
end ckg_root_entries

@test("a root's kept half that is truncated, or another key's copied over it, is rebuilt and links right")
ckg_error_root_entries()
    if !ckg_ready() then return

    val leaf = ckg_leaf(false)
    val entry = (n: int) -> ckg_manifest("app", "dependencies { leaf { git = \"github.com/e/leaf\", " +
                                         s"version = \"1.0.0\", options = { n = $n } } }\n")
    val root = ckg_project(entry(4), "import leaf", "leaf.value()", [])
    val cache = ckg_caches()

    val four = ckg_built(root, s"--lib $leaf", s"$cache/a")
    val four_entry = ckg_root_entries(cache).at(0)

    ckg_put(root, "package.hocon", entry(5))

    val five = ckg_built(root, s"--lib $leaf", s"$cache/b")
    var five_entry = ""

    for e in ckg_root_entries(cache)
        if e != four_entry then five_entry = e

    // Another key's archive and sidecar over the first entry.
    write_bytes(four_entry, read_bytes(five_entry).unwrap()).unwrap()
    write_bytes(s"$four_entry.sum", read_bytes(s"$five_entry.sum").unwrap()).unwrap()
    ckg_put(root, "package.hocon", entry(4))

    val before = root_artifact_counts()
    val copied = ckg_built(root, s"--lib $leaf", s"$cache/c")
    val copied_verdict = ckg_root_verdict(before, root_artifact_counts())

    // And the entry just rebuilt, truncated.
    ckg_truncate(four_entry, cache)

    val again = root_artifact_counts()
    val truncated = ckg_built(root, s"--lib $leaf", s"$cache/d")
    val truncated_verdict = ckg_root_verdict(again, root_artifact_counts())

    ckg_done(cache, [root, leaf])
    assert_eq(s"$four $five $copied $copied_verdict $truncated $truncated_verdict", "4 5 4 miss 4 miss")
end ckg_error_root_entries
