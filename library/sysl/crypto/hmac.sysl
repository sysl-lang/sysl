module sysl.crypto
@no_alloc

import sysl.slices.copy

// HMAC over any of the four, written once.
//
// The interesting part is not the construction — two hashes and two pads — but what it takes to
// say "a hash function" here. A trait would be the obvious way, and it is the wrong one: an
// implementation would have to hand back a *new* hasher, and a bound cannot promise a value any
// more than it can promise a constant. What works instead is that a hasher is an ordinary struct,
// so a started one is a value, and copying it is starting another. `proto` is that value, and the
// three hashes below are three copies of it.

// The tag is written into storage the caller owns, which is the same shape `Sha.finish` has and the
// same reason: an HMAC is a fixed number of bytes the caller almost always already has somewhere to
// put, and a function that allocated one would put this module behind an allocator for no gain.
private[crypto] hmac[T: Word](proto: Sha[T], key: []const u8, msg: []const u8, tag: []u8) -> Result[unit, Fault]
    var bs = proto.block_len()
    var n = proto.dlen

    if n == 0 then return Err(NotStarted)
    if tag.len < n then return Err(DigestTooSmall)

    var k: [128]u8

    // A key longer than a block is replaced by its own digest; a shorter one is padded with the
    // zeroes `k` already holds.
    if key.len > bs
        var h = proto
        var kd: [64]u8

        h.update(key)
        h.finish(kd[0..<n])?

        copy(k[..], kd[0..<n])
    else
        copy(k[..], key)

    var ipad: [128]u8
    var opad: [128]u8

    for i in 0..<bs
        ipad[i] = k[i] ^ 0x36
        opad[i] = k[i] ^ 0x5c

    var inner = proto
    var id: [64]u8

    inner.update(ipad[0..<bs])
    inner.update(msg)
    inner.finish(id[0..<n])?

    var outer = proto

    outer.update(opad[0..<bs])
    outer.update(id[0..<n])
    outer.finish(tag[0..<n])
end hmac

// HMAC over each of the four, answering a tag the size of that digest.
//
// A key longer than a block is replaced by its own digest; a shorter one is padded with zeroes.
hmac224(key: []const u8, msg: []const u8) -> [28]u8
    var tag: [28]u8
    hmac(new_sha224().inner, key, msg, tag[0..<28]).expect("a tag buffer sized from the hasher itself")
    tag

hmac256(key: []const u8, msg: []const u8) -> [32]u8
    var tag: [32]u8
    hmac(new_sha256().inner, key, msg, tag[0..<32]).expect("a tag buffer sized from the hasher itself")
    tag

hmac384(key: []const u8, msg: []const u8) -> [48]u8
    var tag: [48]u8
    hmac(new_sha384().inner, key, msg, tag[0..<48]).expect("a tag buffer sized from the hasher itself")
    tag

hmac512(key: []const u8, msg: []const u8) -> [64]u8
    var tag: [64]u8
    hmac(new_sha512().inner, key, msg, tag[0..<64]).expect("a tag buffer sized from the hasher itself")
    tag
