// P6: decoding a data enum by variant name: var p: c::Payload, p.(f) = …, T::Make(c, p);
// and the same with a payload field that has no zero.
import sysl.buf.{Buf, buf}

enum Shape
    Dot
    Circle(r: int)
    Rect(w: int, h: int)

// stands in for a decoder: the variant's name, then its fields' values in order
from_parts[T](name: string, vals: []const int) -> Option[T]
    for const c in T::Variants
        if name == c.name
            var p: c::Payload

            for const f in c::Fields
                p.(f) = vals[f.index]

            return Some(T::Make(c, p))

    None

show(s: Shape) -> string = s match
    Dot -> "Dot"
    Circle(r) -> s"Circle($r)"
    Rect(w, h) -> s"Rect($w, $h)"

print(show(from_parts[Shape]("Rect", [2, 3]).unwrap()), show(from_parts[Shape]("Circle", [5]).unwrap()),
    show(from_parts[Shape]("Dot", []).unwrap()), from_parts[Shape]("Hex", []).is_none())
