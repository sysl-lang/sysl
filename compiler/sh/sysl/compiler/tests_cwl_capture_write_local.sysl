module sh.sysl.compiler
@tests

import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture

// A local of a closure body bound to a by-value capture's copy carries the write on
// (`reference/expressions.md`): an address of it (`val p = &k`), a writable view of it
// (`val v = out[0..<2]`), a view of such a view, a `ref` naming it, and any of those bound again or
// in a nested block. A write through the local, or the local handed to a call, is a write of the copy,
// asked the two questions a write of the capture is -- through a closure a callee keeps, a `&sync Fn`
// and `sysl.threads.scope`.
//
// Accepted: a local whose target is never written, a `[]const T` view, a view of a `&[N]T` box, an
// address of what a captured `&T` boxes, a local read back with the variable left alone; and a `*self`
// method on a captured handle -- a `Buf`, or any struct whose every field is a counted reference --
// which reaches the storage both sides share. Each accepted cell runs at `-O0`, `-O1` and `-O2`.
//
// The helpers are `tests_enm_enum_run.sysl`'s.

private const cwl_prelude: string = "import sysl.buf.{Buf, buf}\nimport sysl.sync.Atomic\nimport sysl.threads.scope\n\n" +
    "fill(dst: []u8) = dst[0] = 7\n\nshow(v: []const u8) = print(v[0])\n\nbump(p: *int) = *p += 1\n\n" +
    "run(f: &Fn() -> unit) = f()\n\n" +
    "var kept: Option[&Fn() -> unit] = None\n\ncall(f: &Fn() -> unit)\n    kept = Some(f)\n    f()\n\n" +
    "var held: Option[&Fn() -> int] = None\n\nstash(f: &Fn() -> int)\n    held = Some(f)\n    print(f())\n\n" +
    "struct C\n    n: int\n\n    inc(*self) = self.n += 1\n\n" +
    "struct H\n    r: &int\n\n    poke(*self) = *self.r += 1\n\n" +
    "struct G\n    r: &sync Atomic[int]\n\n    poke(*self) = self.r.add(1)\n\n"

// The words after the reason the closure holds its captures by value, for a capture `name` that
// `form` would write the copy of, with the variable used afterwards.
private cwl_lost(name: string, form: string) -> string =
    s", so it holds a copy of '$name' — so $form would reach that copy rather than the variable it " +
    s"came from, and the variable is used afterwards as though it had. Where you mean to change '$name'"

// The same, where nothing in the closure reads the copy back.
private cwl_unread(name: string, form: string) -> string =
    s", so it holds a copy of '$name' — so $form would reach that copy rather than the variable it " +
    s"came from, and nothing in the closure reads it back"

// What a refused program said, checked to hold `want` exactly once.
private cwl_refused(text: string, want: string) -> string
    val said = enm_err(cwl_prelude + text)

    assert(enm_says(said, want), said)

    val first = said.index_of(want).unwrap()

    assert(said[first + want.bytes.len..<said.bytes.len].index_of(want).is_none(), said)
    said
end cwl_refused

// What an accepted program printed, built at `level`.
private cwl_ran_at(text: string, level: string) -> string
    val root = make_temp_dir("sysl-cwl").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", forms_imported(cwl_prelude + text)).unwrap()

    val exe = s"$root/built"

    build_native_program(s"$root/main.sysl", None, None, level, Some(exe)) match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return failure_text(why)
        Ok(_) -> ()

    val said = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    said match
        Err(_) -> "the program that was built could not be run"
        Ok(out) -> if out.status.ok() then out.text else s"it did not exit zero: ${out.text}"
end cwl_ran_at

// The same output at every optimization level.
private cwl_runs(text: string, want: string)
    for level in ["0", "1", "2"]
        assert_eq(cwl_ran_at(text, level), want, s"at -O$level")

// ---- refused: an address of the copy, bound to a local

@test("an address of the copy bound to a local and handed to a call, the variable read afterwards")
cwl_address_handed()
    if !enm_ready() then return

    val said = cwl_refused("main()\n    var k = 0\n    call(() ->\n        val p = &k\n        bump(p))\n" +
                           "    print(k)\n",
                           cwl_lost("k", "'bump', which is handed its address,"))

    assert(enm_says(said, "hold it as a '&int' (a '&sync int' where another thread runs the closure) " +
                          "and hand the callee '&*k'"), said)

@test("written through an address local, never read back")
cwl_address_store_unread()
    if !enm_ready() then return

    cwl_refused("main()\n    var k = 0\n    call(() ->\n        val p = &k\n        *p = 3)\n",
                cwl_unread("k", "assignment"))

@test("a compound assignment through an address local, read back, the variable used afterwards")
cwl_address_update_read_after()
    if !enm_ready() then return

    cwl_refused("main()\n    var k = 0\n    stash(() ->\n        val p = &k\n        *p += 2\n        *p)\n" +
                "    print(k)\n",
                cwl_lost("k", "'+='"))

@test("a field written through an address of a captured struct")
cwl_address_field()
    if !enm_ready() then return

    cwl_refused("main()\n    var c = C(0)\n    call(() ->\n        val q = &c\n        q.n = 4)\n    print(c.n)\n",
                cwl_unread("c", "assignment"))

@test("an element of a captured array written through an address local")
cwl_address_element()
    if !enm_ready() then return

    cwl_refused("main()\n    var out = [0u8; 4]\n    call(() ->\n        val pa = &out\n        pa[1] = 3)\n" +
                "    print(out)\n",
                cwl_unread("out", "assignment"))

@test("a '*self' method called through an address local")
cwl_address_method()
    if !enm_ready() then return

    cwl_refused("main()\n    var c = C(0)\n    call(() ->\n        val q = &c\n        q.inc())\n    print(c.n)\n",
                cwl_lost("c", "'inc', which is handed its address,"))

@test("an address bound again, twice, then handed on")
cwl_rebound_twice()
    if !enm_ready() then return

    cwl_refused("main()\n    var k = 0\n    call(() ->\n        val p = &k\n        val q = p\n        val r = q\n" +
                "        bump(r))\n    print(k)\n",
                cwl_lost("k", "'bump', which is handed its address,"))

@test("a 'var' pointed at another capture's copy is followed to it")
cwl_var_repointed()
    if !enm_ready() then return

    cwl_refused("main()\n    var j = 0\n    var k = 0\n    call(() ->\n        var p = &j\n        print(*p)\n" +
                "        p = &k\n        *p = 1)\n    print(j, k)\n",
                cwl_unread("k", "assignment"))

@test("bound and handed on in a nested block")
cwl_nested_block()
    if !enm_ready() then return

    cwl_refused("main()\n    var k = 0\n    var go = true\n    call(() ->\n        if go\n" +
                "            val p = &k\n            bump(p))\n    print(k)\n",
                cwl_lost("k", "'bump', which is handed its address,"))

@test("a 'ref' naming the copy, assigned")
cwl_ref_assigned()
    if !enm_ready() then return

    cwl_refused("main()\n    var k = 0\n    call(() ->\n        ref r = k\n        r = 5)\n    print(k)\n",
                cwl_unread("k", "assignment"))

// ---- refused: a writable view of the copy, bound to a local

@test("a view of the copy bound to a local and handed to a call")
cwl_view_handed()
    if !enm_ready() then return

    val said = cwl_refused("main()\n    var out = [0u8; 4]\n    call(() ->\n        val v = out[0..<2]\n" +
                           "        fill(v))\n    print(out)\n",
                           cwl_lost("out", "'fill', which is handed a view of it,"))

    assert(enm_says(said, "take the view outside the closure, hold it as a '&[4]byte' and view that"),
           said)

@test("written through a view local, never read back")
cwl_view_written()
    if !enm_ready() then return

    cwl_refused("main()\n    var out = [0u8; 4]\n    call(() ->\n        val v = out[1..]\n        v[0] = 5)\n",
                cwl_unread("out", "assignment"))

@test("the whole array bound where a '[]u8' is wanted, written through")
cwl_view_whole_array()
    if !enm_ready() then return

    cwl_refused("main()\n    var out = [0u8; 4]\n    call(() ->\n        val u: []u8 = out\n        u[0] += 1)\n" +
                "    print(out)\n",
                cwl_unread("out", "'+='"))

@test("a view of a view local, handed on")
cwl_view_of_view()
    if !enm_ready() then return

    cwl_refused("main()\n    var out = [0u8; 4]\n    call(() ->\n        val v = out[..]\n" +
                "        val w = v[1..<3]\n        fill(w))\n    print(out)\n",
                cwl_lost("out", "'fill', which is handed a view of it,"))

@test("a view local in a closure made a '&sync Fn'")
cwl_sync_fn()
    if !enm_ready() then return

    cwl_refused("main()\n    var out = [0u8; 4]\n    val f: &sync Fn() -> unit = () ->\n" +
                "        val v = out[0..<2]\n        fill(v)\n    f()\n    print(out)\n",
                cwl_lost("out", "'fill', which is handed a view of it,"))

@test("an address local in a scoped thread, read after the scope")
cwl_scope_address()
    if !enm_ready() then return

    val said = cwl_refused("main()\n    var k = 0\n    scope((s) -> s.spawn(() ->\n" +
                           "        val p = &k\n        bump(p)).join())\n    print(k)\n",
                           cwl_lost("k", "'bump', which is handed its address,"))

    assert(enm_says(said, "'@scoped'"), said)

@test("a view local in a scoped thread, read after the scope")
cwl_scope_view()
    if !enm_ready() then return

    cwl_refused("main()\n    var out = [0u8; 4]\n    scope((s) -> s.spawn(() ->\n" +
                "        val v = out[0..<2]\n        fill(v)).join())\n    print(out)\n",
                cwl_lost("out", "'fill', which is handed a view of it,"))

// ---- accepted: the local reaches nothing written, or storage both sides share

@test("a local whose target is never written: accepted with the variable read afterwards")
cwl_never_written()
    if !enm_ready() then return

    cwl_runs("main()\n    var k = 3\n    var out = [5u8; 4]\n    call(() ->\n        val p = &k\n" +
             "        print(*p)\n        val v = out[0..<2]\n        print(v[1]))\n    print(k, out[0])\n",
             "3\n5\n3 5\n")

@test("a '[]const u8' view local only reads")
cwl_const_view()
    if !enm_ready() then return

    cwl_runs("main()\n    var out = [5u8; 4]\n    call(() ->\n        val v: []const u8 = out[0..<2]\n" +
             "        show(v))\n    print(out[0])\n",
             "5\n5\n")

@test("a view local of a '&[4]u8' box writes the storage both sides share")
cwl_box_view()
    if !enm_ready() then return

    cwl_runs("main()\n    val out: &[4]u8 = [0u8; 4]\n    call(() ->\n        val v = out[1..<3]\n" +
             "        fill(v))\n    print(*out)\n",
             "[0, 7, 0, 0]\n")

@test("an address of what a captured '&int' boxes writes the box")
cwl_box_address()
    if !enm_ready() then return

    cwl_runs("main()\n    val k: &int = 0\n    call(() ->\n        val p = &*k\n        bump(p))\n    print(*k)\n",
             "1\n")

@test("an address local read back, with the variable left alone: a counter of its own")
cwl_read_back()
    if !enm_ready() then return

    cwl_runs("main()\n    var k = 0\n    stash(() ->\n        val p = &k\n        bump(p)\n        *p)\n" +
             "    print(held.unwrap()())\n",
             "1\n2\n")

@test("a closure called in place holds its captures by reference: the local reaches the variable")
cwl_in_place()
    if !enm_ready() then return

    cwl_runs("main()\n    var k = 0\n    var out = [0u8; 4]\n    run(() ->\n        val p = &k\n" +
             "        bump(p)\n        val v = out[2..]\n        fill(v))\n    print(k, out)\n",
             "1 [0, 0, 7, 0]\n")

// ---- accepted: a '*self' method on a captured handle reaches the storage both sides share

@test("'view_mut' and 'release' on a captured Buf in a kept closure")
cwl_buf_handle_kept()
    if !enm_ready() then return

    cwl_runs("main()\n    var b: Buf[u8] = buf()\n    b.push(0)\n    b.push(0)\n" +
             "    call(() -> b.view_mut()[1] = 4)\n    call(() -> fill(b.view_mut()))\n" +
             "    var c: Buf[u8] = buf()\n    c.push(1)\n    call(() -> c.release())\n" +
             "    print(b[0], b[1], c.len())\n",
             "7 4 1\n")

@test("a '*self' method on a struct whose every field is a counted reference, kept and scoped")
cwl_handle_struct()
    if !enm_ready() then return

    cwl_runs("main()\n    var h = H(0)\n    call(() -> h.poke())\n    run(() -> h.poke())\n" +
             "    var g = G(Atomic(0))\n    scope((s) -> s.spawn(() -> g.poke()).join())\n" +
             "    print(*h.r, g.r.load())\n",
             "2 1\n")

// ---- still refused: a struct holding a value beside its reference is no handle

@test("a '*self' method on a struct with a field held by value is still a write of the copy")
cwl_not_a_handle()
    if !enm_ready() then return

    cwl_refused("struct M\n    r: &int\n    n: int\n\n    poke(*self) = self.n += 1\n\n" +
                "main()\n    var m = M(0, 0)\n    call(() -> m.poke())\n    print(m.n)\n",
                cwl_unread("m", "'poke', which takes '*self',"))
