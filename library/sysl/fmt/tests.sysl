module sysl.fmt
@tests

// What a run-time width or precision comes to: C's `int`, saturated, and C's reading of a negative.

@test("a count inside int's range is itself")
count_in_range()
    assert_eq(format_count(0), 0)
    assert_eq(format_count(12), 12)
    assert_eq(format_count(-12), -12)

@test("a count past int's range saturates rather than wrapping")
count_saturates()
    assert_eq(format_count(4294967296), 2147483647)
    assert_eq(format_count(18446744073709551615), 2147483647)
    assert_eq(format_count(-4294967296), -2147483647)

@test("a negative width left-justifies at its magnitude")
negative_width_left_justifies()
    val f = format_spec_of(-6, 2, false)

    assert_eq(f.width, 6)
    assert_eq(f.prec, 2)
    assert(f.left)

@test("a negative precision is as though none was written")
negative_precision_is_absent()
    val f = format_spec_of(4, -3, false)

    assert_eq(f.width, 4)
    assert_eq(f.prec, -1)
    assert(!f.left)

@test("the '-' flag still left-justifies a positive width")
flag_left_justifies()
    assert(format_spec_of(4, -1, true).left)

// What an integer under a specifier renders as, which C's `snprintf` is the oracle for everywhere it
// has the conversion; the compiler's `tests_fmi_format_int.sysl` compares the two.

@test("a decimal keeps its sign, and the flags place it")
int_decimal_sign()
    assert_eq(format_int(-42, 32, "%d", 0, -1), "-42")
    assert_eq(format_int(42, 32, "%+d", 0, -1), "+42")
    assert_eq(format_int(42, 32, "% d", 0, -1), " 42")
    assert_eq(format_int(-42, 32, "%06d", 0, -1), "-00042")
    assert_eq(format_int(-42, 32, "%-6d", 0, -1), "-42   ")

@test("each width's extremes render whole")
int_extremes()
    assert_eq(format_int(-9223372036854775807 - 1, 64, "%d", 0, -1), "-9223372036854775808")
    assert_eq(format_int(18446744073709551615, 64, "%u", 0, -1), "18446744073709551615")
    assert_eq(format_int(-128, 8, "%d", 0, -1), "-128")

@test("an unsigned conversion reads a negative value at its own width")
int_unsigned_of_negative()
    assert_eq(format_int(-1, 32, "%x", 0, -1), "ffffffff")
    assert_eq(format_int(-6, 8, "%o", 0, -1), "372")
    assert_eq(format_int(-1, 64, "%X", 0, -1), "FFFFFFFFFFFFFFFF")
    assert_eq(format_int(-6, 8, "%b", 0, -1), "11111010")

@test("a precision is a minimum count of digits, and zero renders a zero as nothing")
int_precision()
    assert_eq(format_int(7, 32, "%.3d", 0, -1), "007")
    assert_eq(format_int(0, 32, "%.0d", 0, -1), "")
    assert_eq(format_int(0, 32, "%#.0o", 0, -1), "0")
    assert_eq(format_int(7, 32, "%08.3d", 0, -1), "     007")

@test("'#' prefixes a non-zero hexadecimal or binary, and gives an octal its leading zero")
int_alternate_forms()
    assert_eq(format_int(255, 32, "%#x", 0, -1), "0xff")
    assert_eq(format_int(255, 32, "%#010X", 0, -1), "0X000000FF")
    assert_eq(format_int(0, 32, "%#x", 0, -1), "0")
    assert_eq(format_int(8, 32, "%#o", 0, -1), "010")
    assert_eq(format_int(5, 32, "%#b", 0, -1), "0b101")

@test("a '*' reads the count handed over, a negative width left-justifying")
int_counts()
    assert_eq(format_int(42, 32, "%*d", 5, -1), "   42")
    assert_eq(format_int(42, 32, "%*d", -5, -1), "42   ")
    assert_eq(format_int(42, 32, "%.*d", 0, 4), "0042")
    assert_eq(format_int(42, 32, "%0.*d", 0, -3), "42")

// `hex`, `binary` and `octal` are `format_int` under a specifier they compose, so each is held to what
// the f-string spelling renders.

@test("hex renders every width, lower case by default")
hex_each_width()
    assert_eq(hex(u8(255)), "ff")
    assert_eq(hex(u16(0xbeef)), "beef")
    val w: u32 = 0xdeadbeef
    val q: u64 = 0x0123456789abcdef

    assert_eq(hex(w), "deadbeef")
    assert_eq(hex(q), "123456789abcdef")
    assert_eq(hex(0), "0")

@test("hex pads with zeros to a minimum width and never truncates")
hex_width()
    assert_eq(hex(u64(0xab), 16), "00000000000000ab")
    assert_eq(hex(u8(5), 2), "05")
    assert_eq(hex(u32(0x12345), 2), "12345")
    assert_eq(hex(u32(0), 4), "0000")
    assert_eq(hex(u32(7), 0), "7")
    assert_eq(hex(u32(7), -3), "7")

@test("hex upper-cases the digits")
hex_upper()
    val w: u32 = 0xdeadbeef

    assert_eq(hex(w, 0, true), "DEADBEEF")
    assert_eq(hex(u16(0xab), 6, true), "0000AB")

@test("hex of a negative value is its two's complement at its own width")
hex_negative()
    assert_eq(hex(i8(-1)), "ff")
    assert_eq(hex(i16(-2)), "fffe")
    assert_eq(hex(i32(-1)), "ffffffff")
    assert_eq(hex(i64(-1)), "ffffffffffffffff")
    assert_eq(hex(-1), "ffffffff")
    assert_eq(hex(i64(-1), 20, true), "0000FFFFFFFFFFFFFFFF")

@test("hex, binary and octal agree with the f-string spellings")
radix_matches_fstring()
    val v: u32 = 0xcafe
    val n: i16 = -300

    assert_eq(hex(v, 8), f"$v%08x")
    assert_eq(hex(v, 8, true), f"$v%08X")
    assert_eq(hex(n, 6), f"$n%06x")
    assert_eq(binary(v), format_int(51966, 32, "%b", 0, -1))
    assert_eq(octal(n), f"$n%o")

@test("binary renders every width, zero-padded and two's complement")
binary_forms()
    assert_eq(binary(u8(5)), "101")
    assert_eq(binary(u8(5), 8), "00000101")
    assert_eq(binary(i8(-6)), "11111010")
    assert_eq(binary(i16(-1)), "1111111111111111")
    assert_eq(binary(u64(1) << 63).len, 64)
    assert_eq(binary(0), "0")

@test("octal renders every width, zero-padded and two's complement")
octal_forms()
    assert_eq(octal(u8(8)), "10")
    assert_eq(octal(u16(511), 6), "000777")
    assert_eq(octal(i8(-6)), "372")
    assert_eq(octal(i32(-1)), "37777777777")
    assert_eq(octal(0), "0")
