module sh.sysl.compiler
@include("<sys/ioctl.h>")

// The size of the window the menu draws in: `ioctl(TIOCGWINSZ)`, which is what
// `sysl.posix.tty.window_size` answers from the library. The request's number is the platform's own,
// so the C compiler works it out; `struct winsize` is four `unsigned short`s, rows first, on every
// system the compiler is built for.

c const
    MenuWindowRequest: u64 = "TIOCGWINSZ"

private extern "ioctl" c_menu_ioctl(fd: int, request: u64, ...) -> int

// The rows and columns of the terminal at a descriptor, or `None` where it is no terminal or reports
// no size.
menu_window_size(fd: int) -> Option[(int, int)]
    var ws = [0u16; 4]

    if c_menu_ioctl(fd, MenuWindowRequest, &ws[0]) != 0 then return None

    val rows = int(ws[0])
    val cols = int(ws[1])

    if rows == 0 || cols == 0 then None else Some((rows, cols))
end menu_window_size
