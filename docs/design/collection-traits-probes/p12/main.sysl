// p12: ordering shapes -- a generic reversing wrapper as an Ord, a heap of it, a key-based sort with
// a member type parameter, a derived order on a struct and an enum, and floats through total_lt.
import sysl.slices.{sort, sort_by, is_sorted}
import sysl.container.{Heap, heap}

struct Rev[T]
    v: T

impl[T: Ord] Ord for Rev[T]
    lt(self, rhs: Self) -> bool = rhs.v < self.v

impl[T: Eq] Eq for Rev[T]
    eq(self, rhs: Self) -> bool = self.v == rhs.v

sort_by_key[T, K: Ord](xs: []T, key: T -> K) = sort_by(xs, (a, b) -> key(a) < key(b))

struct P derives Eq, Ord
    a: int
    b: string

enum Shape derives Eq, Ord
    Dot
    Circle(r: int)
    Rect(w: int, h: int)

main()
    var h: Heap[Rev[int]] = heap()
    h.push(Rev(3))
    h.push(Rev(9))
    h.push(Rev(1))
    print(h.pop().unwrap().v)

    var words = ["pear", "fig", "banana"]
    sort_by_key(words[..], w -> w.len)
    print(words[0], words[2])

    var ps = [P(2, "b"), P(1, "z"), P(2, "a")]
    sort(ps[..])
    print(ps[0].b, ps[1].b, ps[2].b, is_sorted(ps[..]))

    var ss = [Shape.Rect(1, 2), Shape.Dot, Shape.Circle(3), Shape.Circle(1)]
    sort(ss[..])
    print(ss[0] == Shape.Dot, ss[1] == Shape.Circle(1))

    var fs = [2.5, real.nan(), -1.0, 0.0]
    sort_by(fs[..], (a, b) -> a.total_lt(b))
    print(fs[0], fs[3].is_nan())
