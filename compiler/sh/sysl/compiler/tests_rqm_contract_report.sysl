module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.fs.{make_temp_dir, remove_dir_all, write_text}
import sysl.process.{capture, Status}

// A contract clause that does not hold reports what failed before it traps (`contract_unless`): its
// word, the message it was written with where it has one, and the condition's line and column --
// `require failed: x must be non-negative (main.sysl:2:13)` -- through the same `sysl_bounds_fail` a
// bounds check reports through, so the exit status is still SIGTRAP's and a `should_trap` test can
// ask for the message. A struct's `invariant` names the struct, the clause that failed and where it is
// written, and the write that broke it. Every cell is built in both modes, since a contract is
// checked in every build, and at `-O0` and the default level, since an optimizer that folded a check
// to its outcome must still make the call.

private rqm_ready() -> bool = std_root().is_ok() && clang_available()

// `text` as `main.sysl`, built in the mode `flag` names at `level`, and run: its status, its standard
// output and its standard error.
private rqm_run(text: string, flag: string, level: string) -> (Status, string, string)
    val root = make_temp_dir("sysl-rqm").unwrap()

    write_text(s"$root/main.sysl", text).unwrap()

    var flags: [1]string = [flag]

    assert_eq(took_search_flag(flags[..], 0), 1)

    val exe = s"$root/built"
    val built = build_native_program(root, None, None, level, Some(exe))

    reset_search_paths()

    built match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return (Status.Exited(-1), "", failure_text(why))
        Ok(_) -> ()

    val said = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    said match
        Err(_) -> (Status.Exited(-1), "", "the program that was built could not be run")
        Ok(out) -> (out.status, out.text, out.err.unwrap_or(""))
end rqm_run

// In both modes and at both levels, the program prints `before` and then stops on SIGTRAP having
// written exactly `report` to standard error.
private rqm_traps_saying(text: string, before: string, report: string)
    if !rqm_ready() then return

    for flag in ["--debug", "--release"]
        for level in ["0", DefaultOptimization]
            val (state, printed, err) = rqm_run(text, flag, level)

            assert_eq(err, report)
            assert_eq(printed, before)
            assert(state == Status.Signalled(5), s"$flag -O$level stopped with $state, having printed '$printed'")
end rqm_traps_saying

private rqm_half() -> string = "half(x: int) -> int\n    require x >= 0, \"x must be non-negative\"\n    x / 2\n\n"

// -- what each clause says ------------------------------------------------------------------------------

@test("a failed require with a message prints the message and the condition's line and column")
rqm_require_with_a_message()
    rqm_traps_saying(rqm_half() + "print(half(4))\nprint(half(-1))\n", "2\n",
                     "require failed: x must be non-negative (main.sysl:2:13)\n")

@test("a failed require with no message still says it was a require, and where")
rqm_require_without_a_message()
    rqm_traps_saying("half(x: int) -> int\n    require x >= 0\n    x / 2\n\nprint(half(-1))\n", "",
                     "require failed (main.sysl:2:13)\n")

@test("a failed ensure with a message prints the message")
rqm_ensure_with_a_message()
    rqm_traps_saying("f(x: int) -> int\n    ensure result > 100, \"result too small\"\n    x\n\nprint(f(1))\n", "",
                     "ensure failed: result too small (main.sysl:2:12)\n")

@test("a failed ensure with no message says it was an ensure, and where, at an early return too")
rqm_ensure_without_a_message()
    rqm_traps_saying("f(x: int) -> int\n    ensure result > 0\n    if x < 0 then return x\n    x\n\n" +
                     "print(f(3))\nprint(f(-3))\n", "3\n",
                     "ensure failed (main.sysl:2:12)\n")

@test("a loop invariant's message is printed when it stops holding")
rqm_loop_invariant_with_a_message()
    rqm_traps_saying("main()\n    var i = 0\n    while i < 5\n        invariant i < 3, \"i stays small\"\n" +
                     "        print(i)\n        i += 1\n", "0\n1\n2\n",
                     "invariant failed: i stays small (main.sysl:4:19)\n")

@test("a struct invariant broken by a write names the struct, the clause and where it is, and the write")
rqm_struct_invariant()
    rqm_traps_saying("struct Window\n    lo: int\n    hi: int\n    invariant lo <= hi\n\n" +
                     "var w = Window(2, 10)\nprint(w.hi)\nw.hi = 1\nprint(w.hi)\n", "10\n",
                     "invariant of 'Window' failed: clause 'lo <= hi' at main.sysl:4:15 (main.sysl:8:1)\n")

// -- which of a struct's clauses failed ---------------------------------------------------------------

private rqm_three_clauses() -> string =
    "struct Window\n    lo: int\n    hi: int\n    invariant lo <= hi\n    invariant hi - lo < 10\n" +
    "    invariant lo >= 0\n\n"

@test("of several clauses, the first failing at construction is the one named")
rqm_struct_invariant_first_clause_at_construction()
    rqm_traps_saying(rqm_three_clauses() + "print(Window(1, 2).lo)\nprint(Window(5, 2).lo)\n", "1\n",
                     "invariant of 'Window' failed: clause 'lo <= hi' at main.sysl:4:15 (main.sysl:9:7)\n")

@test("of several clauses, a later one failing at a field write is the one named")
rqm_struct_invariant_later_clause_at_a_write()
    rqm_traps_saying(rqm_three_clauses() + "var w = Window(1, 2)\nw.hi += 20\nprint(w.hi)\n", "",
                     "invariant of 'Window' failed: clause 'hi - lo < 10' at main.sysl:5:15 (main.sysl:9:1)\n")

@test("where two clauses fail at once, the first written is the one named")
rqm_struct_invariant_two_fail_first_named()
    rqm_traps_saying(rqm_three_clauses() + "var w = Window(1, 2)\nw.lo = -20\nprint(w.lo)\n", "",
                     "invariant of 'Window' failed: clause 'hi - lo < 10' at main.sysl:5:15 (main.sysl:9:1)\n")

@test("the last clause failing is named, through a pointer")
rqm_struct_invariant_last_clause_through_a_pointer()
    rqm_traps_saying(rqm_three_clauses() + "var w = Window(1, 2)\nval p = &w\np.lo = -1\nprint(w.lo)\n", "",
                     "invariant of 'Window' failed: clause 'lo >= 0' at main.sysl:6:15 (main.sysl:10:1)\n")

@test("a clause written with '&&' and odd spacing is named whole, its spacing made single")
rqm_struct_invariant_clause_text_as_written()
    rqm_traps_saying("struct Pair\n    a: int\n    b: usize\n    invariant a  >=   0 && b != \"x\".len\n\n" +
                     "var p = Pair(0, 0)\np.b = 1\nprint(p.b)\n", "",
                     "invariant of 'Pair' failed: clause 'a >= 0 && b != \"x\".len' at main.sysl:4:15 " +
                     "(main.sysl:7:1)\n")

@test("a clause testing a variant with 'is' is named as written")
rqm_struct_invariant_is_clause()
    rqm_traps_saying("struct Held\n    o: Option[int]\n    a: int\n    invariant o is None || a > 0\n\n" +
                     "var h = Held(None, 1)\nh.o = Some(3)\nh.a = 0\nprint(h.a)\n", "",
                     "invariant of 'Held' failed: clause 'o is None || a > 0' at main.sysl:4:15 (main.sysl:8:1)\n")

@test("a generic struct's clause is named from its instantiation")
rqm_struct_invariant_generic()
    rqm_traps_saying("struct Bounded[T: Ord]\n    v: T\n    cap: T\n    invariant v <= cap\n\n" +
                     "var b = Bounded(1, 4)\nprint(b.v)\nb.v = 9\nprint(b.v)\n", "1\n",
                     "invariant of 'Bounded[int]' failed: clause 'v <= cap' at main.sysl:4:15 (main.sysl:8:1)\n")

@test("with the locations dropped, a clause is still named, by its text alone")
rqm_struct_invariant_without_locations()
    use_bounds_locations(false)

    val text = "struct Window\n    lo: int\n    hi: int\n    invariant lo <= hi\n\nvar w = Window(2, 10)\nw.hi = 1\n"
    val ir = xvr_ir([("main.sysl", text)])

    use_bounds_locations(true)
    assert(ir.contains("c\"clause 'lo <= hi'\\00\""), ir)
    assert(ir.contains("c\"invariant of 'Window' failed: \\00\""), ir)
    assert(!ir.contains("main.sysl:"), ir)
end rqm_struct_invariant_without_locations

@test("a require on a method reports its message")
rqm_require_on_a_method()
    rqm_traps_saying("struct C\n    n: int\n\n    take(*self, k: int)\n        require k > 0, \"k must be positive\"\n" +
                     "        self.n += k\n\nvar c = C(0)\nc.take(2)\nprint(c.n)\nc.take(0)\n", "2\n",
                     "require failed: k must be positive (main.sysl:5:17)\n")

@test("a require on a generic function reports its message from the instantiation")
rqm_require_on_a_generic_function()
    rqm_traps_saying("first[T](xs: []const T) -> T\n    require xs.len > 0, \"xs must not be empty\"\n    xs[0]\n\n" +
                     "print(first([7, 8][..]))\nprint(first([1, 2][0..<0]))\n", "7\n",
                     "require failed: xs must not be empty (main.sysl:2:13)\n")

@test("a message holding a percent sign and quotes is printed as written")
rqm_message_is_printed_verbatim()
    rqm_traps_saying("f(x: int) -> int\n    require x > 0, \"x was %s, \\\"not\\\" 100%\"\n    x\n\nprint(f(0))\n", "",
                     "require failed: x was %s, \"not\" 100% (main.sysl:2:13)\n")

@test("clauses that hold report nothing, in either mode")
rqm_clauses_that_hold_say_nothing()
    if !rqm_ready() then return

    for flag in ["--debug", "--release"]
        val (state, printed, err) = rqm_run(rqm_half() + "print(half(8))\n", flag, DefaultOptimization)

        assert_eq(err, "")
        assert_eq(printed, "4\n")
        assert(state.ok(), s"$flag stopped with $state")

// -- while compiling ------------------------------------------------------------------------------------

@test("a require that fails while a constant is evaluated carries its message into the error")
rqm_const_require_carries_its_message()
    if !enm_ready() then return

    assert_eq(isc_diags("const half(x: int) -> int\n    require x >= 0, \"x must be non-negative\"\n    x / 2\n\n" +
                        "const h = half(-1)\n\nprint(h)\n"),
              "5:11 'h' traps while it is being compiled: a 'require' of 'half' failed: x must be non-negative " +
              "(main.sysl:2:13) — inside 'half(-1)', called at main.sysl:5:11\n")

@test("an ensure that fails while a constant is evaluated carries its message into the error")
rqm_const_ensure_carries_its_message()
    if !enm_ready() then return

    assert_eq(isc_diags("const f(x: int) -> int\n    ensure result > 100, \"too small\"\n    x\n\n" +
                        "const h = f(1)\n\nprint(h)\n"),
              "5:11 'h' traps while it is being compiled: an 'ensure' of 'f' failed: too small " +
              "(main.sysl:2:12) — inside 'f(1)', called at main.sysl:5:11\n")

@test("a struct invariant that fails while a constant is evaluated names the clause that failed")
rqm_const_struct_invariant_names_the_clause()
    if !enm_ready() then return

    assert_eq(isc_diags(rqm_three_clauses() + "const lo_of(n: int) -> int = Window(1, n).lo\n\n" +
                        "const L = lo_of(20)\n\nprint(L)\n"),
              "10:11 'L' traps while it is being compiled: the 'invariant' of 'Window' does not hold for " +
              "Window(1, 20): clause 'hi - lo < 10' at main.sysl:5:15 (main.sysl:8:30) — inside 'lo_of(20)', " +
              "called at main.sysl:10:11\n")

// -- under the test runner ------------------------------------------------------------------------------

// The tests of a one-file project, built and run as `sysl test` runs them.
private rqm_outcomes(text: string) -> Option[Buf[Outcome]]
    if !rqm_ready() then return None

    val root = make_temp_dir("sysl-rqm").unwrap()

    write_text(s"$root/main.sysl", text).unwrap()

    val build = test_build_of(root, None) match
        Err(refusal) ->
            remove_dir_all(root).unwrap_or(())
            assert(false, failure_text(refusal))
            return None
        Ok(made) -> made

    val exe = build_test_binary(root, build, None, DefaultOptimization) match
        Err(refusal) ->
            remove_dir_all(root).unwrap_or(())
            assert(false, refusal.message)
            return None
        Ok(built) -> built

    val ran = run_selected(exe, build.tests, TestOptions(None, false, 1, buf()), 0, piece -> ())

    discard_test_binary(exe)
    remove_dir_all(root).unwrap_or(())
    Some(ran)
end rqm_outcomes

@test("should_trap can ask for a require's message, and a different text is not satisfied")
rqm_should_trap_reads_the_message()
    val ran = rqm_outcomes(rqm_half() +
                           "@test(should_trap: \"x must be non-negative\")\nright()\n    print(half(-1))\n\n" +
                           "@test(should_trap: \"require failed (\")\nbare()\n    print(half(-1))\n\n" +
                           "@test(should_trap: \"x must be positive\")\nwrong()\n    print(half(-1))\n")

    if ran.is_none() then return

    val outcomes = ran.unwrap()

    assert_eq(outcomes.len(), 3)

    var passed = 0

    for item in outcomes
        if item.passed() then passed += 1

    assert_eq(passed, 1)
end rqm_should_trap_reads_the_message

// -- a struct invariant written with a message ---------------------------------------------------------

private rqm_window(clauses: string) -> string = "struct Window\n    lo: int\n    hi: int\n" + clauses + "\n"

@test("a struct invariant with a message prints the message and the clause's own line and column")
rqm_struct_invariant_with_a_message()
    rqm_traps_saying(rqm_window("    invariant lo <= hi, \"lo must not pass hi\"\n") +
                     "var w = Window(2, 10)\nprint(w.hi)\nw.hi = 1\nprint(w.hi)\n", "10\n",
                     "invariant of 'Window' failed: lo must not pass hi: clause 'lo <= hi' at main.sysl:4:15 (main.sysl:8:1)\n")

@test("a struct made against an invariant with a message reports it at construction")
rqm_struct_invariant_message_at_construction()
    rqm_traps_saying(rqm_window("    invariant lo <= hi, \"lo must not pass hi\"\n") +
                     "var n = 5\nprint(n)\nval w = Window(n, 1)\nprint(w.hi)\n", "5\n",
                     "invariant of 'Window' failed: lo must not pass hi: clause 'lo <= hi' at main.sysl:4:15 (main.sysl:8:9)\n")

@test("of several messaged clauses the one that failed is the one reported")
rqm_struct_invariant_several_messages()
    val text = rqm_window("    invariant lo <= hi, \"lo must not pass hi\"\n    invariant hi - lo < 100, \"too wide\"\n") +
               "var w = Window(2, 10)\nw.hi = 500\nprint(w.hi)\n"

    rqm_traps_saying(text, "", "invariant of 'Window' failed: too wide: clause 'hi - lo < 100' at main.sysl:5:15 (main.sysl:8:1)\n")

@test("a messaged clause and a bare one mix: each reports as it was written")
rqm_struct_invariant_mixed()
    val head = rqm_window("    invariant lo >= 0\n    invariant lo <= hi, \"lo must not pass hi\"\n")

    rqm_traps_saying(head + "var w = Window(2, 10)\nw.lo = -1\nprint(w.lo)\n", "",
                     "invariant of 'Window' failed: clause 'lo >= 0' at main.sysl:4:15 (main.sysl:8:1)\n")
    rqm_traps_saying(head + "var w = Window(2, 10)\nw.hi = 1\nprint(w.hi)\n", "",
                     "invariant of 'Window' failed: lo must not pass hi: clause 'lo <= hi' at main.sysl:5:15 (main.sysl:8:1)\n")

@test("a struct whose messaged clauses all hold runs on")
rqm_struct_invariant_message_holds()
    if !rqm_ready() then return

    val (state, printed, _) = rqm_run(rqm_window("    invariant lo <= hi, \"lo must not pass hi\"\n") +
                                      "var w = Window(2, 10)\nw.hi = 3\nprint(w.lo, w.hi)\n", "--debug", "0")

    assert_eq(printed, "2 3\n")
    assert_eq(state, Status.Exited(0))

@test("a struct invariant's message may be a constant or an interpolation of constants, as a require's may")
rqm_struct_invariant_computed_message()
    rqm_traps_saying("const WHY: string = \"ordered\"\nconst CAP = 7\n\nstruct Window\n    lo: int\n    hi: int\n" +
                     "    invariant lo <= hi, WHY\n    invariant hi < 100, s\"hi under ${CAP}00\"\n\n" +
                     "var w = Window(2, 10)\nw.hi = 150\nprint(w.hi)\n", "",
                     "invariant of 'Window' failed: hi under 700: clause 'hi < 100' at main.sysl:8:15 (main.sysl:11:1)\n")

@test("a generic struct's invariant reports its message")
rqm_generic_struct_invariant_message()
    rqm_traps_saying("struct Span[T: PartialOrd]\n    lo: T\n    hi: T\n    invariant lo <= hi, \"span runs upward\"\n\n" +
                     "var s = Span(1, 5)\nprint(s.hi)\ns.hi = 0\nprint(s.hi)\n", "5\n",
                     "invariant of 'Span[int]' failed: span runs upward: clause 'lo <= hi' at main.sysl:4:15 (main.sysl:8:1)\n")
