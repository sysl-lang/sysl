module sh.sysl.compiler
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.Search
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture

// What an enum *does* at run time (`reference/types.md § Enums`): the storage a data enum is laid
// out in, matching by variant, destructuring, guards, nesting, and an enum reaching itself through a
// reference.
//
// **Every string quoted here was read out of the reference compiler**, whose `EnumRunTests` these
// are. The helpers below are shared by the other `enm_` files — `EnumMemberRunTests`,
// `EnumConversionRunTests`, `EnumAttrRunTests` and `EnumAttrErrorTests` — and so are public.

private var enm_library_cache: Buf[Program] = buf()
private var enm_library_read: bool = false

private enm_library() -> Buf[Program]
    if enm_library_read then return enm_library_cache

    enm_library_read = true

    std_root() match
        Err(_) -> ()
        Ok(root) -> std_units(root, host_target()) match
            Err(_) -> ()
            Ok(units) -> enm_library_cache = units

    enm_library_cache
end enm_library

// Every claim in these files is about a whole program, so all of them want the library and a
// toolchain.
enm_ready() -> bool
    if enm_library().is_empty()
        print("skipped: the standard module's source is not on this machine")
        return false
    end if

    if !clang_available()
        print("skipped: there is no clang on this machine")
        return false
    end if

    true
end enm_ready

enm_says(text: string, part: string) -> bool = text.index_of(part).is_some()

// What a program printed, on both streams, and whether it exited zero.
enm_outcome(text: string) -> (string, bool)
    val root = make_temp_dir("sysl-enum-run").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", text).unwrap()

    val exe = s"$root/built"

    build_native_program(s"$root/main.sysl", None, None, DefaultOptimization, Some(exe)) match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return (failure_text(why), false)
        Ok(_) -> ()

    val said = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    said match
        Err(_) -> ("the program that was built could not be run", false)
        Ok(out) -> (out.text + out.err.unwrap_or(""), out.status.ok())
end enm_outcome

// **What a program PRINTS**, where it runs to the end.
enm_ran(text: string) -> string
    val out = enm_outcome(text)

    if !out.1 then return s"it did not exit zero: ${out.0}"

    out.0
end enm_ran

// **That a program STOPS ITSELF**: it built, and its status is not zero. Answers what is wrong, or
// the empty string.
enm_exits(text: string) -> string
    val out = enm_outcome(text)

    if out.1 then return s"it exited cleanly: ${out.0}"
    if out.0.contains("error:") then return s"it did not build: ${out.0}"

    ""
end enm_exits

// What a program that stops itself said as it went.
enm_panic_text(text: string) -> string
    val out = enm_outcome(text)

    if out.1 then return s"it exited cleanly: ${out.0}"

    out.0
end enm_panic_text

// The LLVM text a program lowers to, or whatever the compiler had to say instead.
enm_ir(text: string) -> string
    val root = make_temp_dir("sysl-enum-run").unwrap()
    val src = s"$root/main.sysl"

    make_dir_all(root).unwrap()
    write_text(src, text).unwrap()

    val out = emit_llvm_text(src, None) match
        Err(why) -> failure_text(why)
        Ok(made) -> if made.report.is_empty() then made.text else analysis_report(made.report)

    remove_dir_all(root).unwrap_or(())
    out
end enm_ir

// Everything a source has to say for itself, taken the whole way the reference's own `err` takes it
// -- through the lowering, so a refusal a pass after the analysis makes is one of these too.
enm_err(text: string) -> string
    val root = make_temp_dir("sysl-enum-run").unwrap()
    val src = s"$root/main.sysl"

    make_dir_all(root).unwrap()
    write_text(src, text).unwrap()

    val out = emit_llvm_text(src, None) match
        Err(why) -> why.message
        Ok(made) -> if made.report.is_empty() then "" else analysis_report(made.report)

    remove_dir_all(root).unwrap_or(())
    out
end enm_err

// Four variants carrying one scalar each, and the function that reads every one of them back.
private enm_step() -> string = raw"""
    enum Step
        Work(n: int)
        Lock(m: u8)
        Unlock(m: u8)
        Sleep(n: int)
    code(s: Step) -> int
        s match
            Work(n) -> n
            Lock(m) -> 100 + int(m)
            Unlock(m) -> 200 + int(m)
            Sleep(n) -> 300 + n
    """

@test("the storage of a data enum is the tag and one region every variant shares")
enm_storage_is_the_tag_and_one_region()
    if !enm_ready() then return

    val out = enm_ir(enm_step() + "print(code(Work(1)))\n")

    assert(enm_says(out, "%enum.Step = type { i32, [1 x i32] }"), out)

@test("the storage is counted in whatever unit the strictest variant must be aligned to")
enm_storage_is_counted_in_the_strictest_unit()
    if !enm_ready() then return

    val out = enm_ir(raw"""
        enum Wide
            Pair(x: i64, y: i64)
            Small(c: u8)
            Empty
        what(w: Wide) -> int
            w match
                Pair(x, y) -> int(x + y)
                Small(c) -> int(c)
                Empty -> -1
        print(what(Pair(1i64, 2i64)))
        """)

    assert(enm_says(out, "%enum.Wide = type { i32, [2 x i64] }"), out)

@test("the storage is wide enough for a variant whose payload is itself an enum")
enm_storage_holds_an_enum_payload()
    if !enm_ready() then return

    val out = enm_ir(enm_step() + "var o: Option[Step] = Some(Lock(1u8))\nprint(o.is_some())\n")

    assert(enm_says(out, "%enum.sysl$Option.Step = type { i32, [2 x i32] }"), out)

@test("so a table of them holds each variant's own payload")
enm_a_table_holds_each_variants_payload()
    if !enm_ready() then return

    assert_eq(enm_ran(enm_step() + raw"""
        var t: [4]Step = [Sleep(0); 4]
        t[0usize] = Work(11)
        t[1usize] = Lock(3u8)
        t[2usize] = Unlock(4u8)
        t[3usize] = Sleep(5)
        for i in 0..<4
            print(code(t[usize(i)]))
        """), "11\n103\n204\n305\n")

@test("a literal payload pattern never fires for another variant")
enm_a_literal_payload_pattern_never_fires_for_another_variant()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        enum Step
            Work(n: int)
            Lock(m: u8)
            Sleep(n: int)
        code(s: Step) -> int
            s match
                Work(0) -> 1
                Work(n) -> 2
                Lock(m) -> 3
                Sleep(n) -> 4
        print(code(Lock(0u8)), code(Sleep(0)), code(Work(0)), code(Work(9)))
        """), "3 4 1 2\n")

@test("a nested pattern reaches through both regions")
enm_a_nested_pattern_reaches_through_both_regions()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        enum Step
            Work(n: int)
            Lock(m: u8)
        what(o: Option[Step]) -> int
            o match
                Some(Work(n)) -> n
                Some(Lock(m)) -> 100 + int(m)
                None -> -1
        print(what(Some(Work(7))), what(Some(Lock(3u8))), what(None))
        """), "7 103 -1\n")

@test("a payload that occupies nothing still round-trips")
enm_a_payload_that_occupies_nothing_round_trips()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        enum E
            Nothing(n: unit)
            Something
        which(e: E) -> int
            e match
                Nothing(n) -> 1
                Something -> 2
        print(which(Nothing(())), which(Something))
        """), "1 2\n")

@test("a data enum still moves by copy")
enm_a_data_enum_moves_by_copy()
    if !enm_ready() then return

    assert_eq(enm_ran(enm_step() + raw"""
        var a = Work(1)
        var b = a
        a = Sleep(2)
        print(code(a), code(b))
        """), "302 1\n")

@test("a nullary variant leaves nothing of the one before it")
enm_a_nullary_variant_leaves_nothing_behind()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        enum Wide
            Pair(x: i64, y: i64)
            Small(c: u8)
            Empty
        what(w: Wide) -> int
            w match
                Pair(x, y) -> int(x + y)
                Small(c) -> int(c)
                Empty -> -1
        var w = Pair(1i64, 2i64)
        print(what(w))
        w = Small(9u8)
        print(what(w))
        w = Empty
        print(what(w))
        """), "3\n9\n-1\n")

@test("a simple enum matches by variant name, bare and qualified")
enm_a_simple_enum_matches_by_variant_name()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        enum Color
            Red
            Green
            Blue = 10

        name(c: Color) -> string
            c match
                Red -> "red"
                Green -> "green"
                Blue -> "blue"
        print(name(Red), name(Green), name(Color.Blue))
        """), "red green blue\n")

@test("a data enum destructures its variants")
enm_a_data_enum_destructures_its_variants()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        enum Shape
            Circle(radius: int)
            Rect(w: int, h: int)
            Empty

        area(s: Shape) -> int
            s match
                Circle(r) -> r * r * 3
                Rect(w, h) -> w * h
                Empty -> 0
        print(area(Circle(5)), area(Rect(3, 4)), area(Empty))
        """), "75 12 0\n")

@test("a guard reads a variant binding, with a catch-all binding arm")
enm_a_guard_reads_a_variant_binding()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        enum Shape
            Circle(radius: int)
            Rect(w: int, h: int)

        describe(s: Shape) -> string
            s match
                Circle(r) if r > 10 -> "big circle"
                Circle(r) -> "small circle"
                other -> "not a circle"
        print(describe(Circle(20)), describe(Circle(2)), describe(Rect(1, 1)))
        """), "big circle small circle not a circle\n")

@test("nested variant patterns bind through two levels")
enm_nested_variant_patterns_bind_through_two_levels()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        enum Inner
            Val(x: int)
            Nil

        enum Outer
            Wrap(i: Inner)
            Nothing

        unwrap(o: Outer) -> int
            o match
                Wrap(Val(v)) -> v
                Wrap(Nil) -> -1
                else -2
        print(unwrap(Wrap(Val(42))), unwrap(Wrap(Nil)), unwrap(Nothing))
        """), "42 -1 -2\n")

@test("an enum flows through a variable and a function that returns one")
enm_an_enum_flows_through_a_variable_and_a_function()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        enum Shape
            Circle(radius: int)
            Rect(w: int, h: int)

        pick(big: bool) -> Shape
            if big then Rect(10, 10) else Circle(1)

        var s = pick(true)
        var answer = s match
            Circle(r) -> r
            Rect(w, h) -> w * h
        print(answer)
        """), "100\n")

@test("an enum reaches itself through '&T', and a walk takes the reference apart")
enm_an_enum_reaches_itself_through_a_reference()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        enum Node
            Lit(ch: char)
            Seq(left: &Node, right: &Node)
            Star(inner: &Node)

        size(n: &Node) -> int = *n match
            Lit(_) -> 1
            Seq(l, r) -> size(l) + size(r)
            Star(i) -> size(i) + 1

        var a: &Node = Lit('a')
        var b: &Node = Lit('b')
        var s: &Node = Seq(a, b)
        var t: &Node = Star(s)

        print(size(t))
        """), "3\n")

@test("a shared subtree is reached down both edges")
enm_a_shared_subtree_is_reached_down_both_edges()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        enum Node
            Lit(ch: char)
            Seq(left: &Node, right: &Node)

        size(n: &Node) -> int = *n match
            Lit(_) -> 1
            Seq(l, r) -> size(l) + size(r)

        var pair: &Node = Seq(Lit('a'), Lit('b'))
        var both: &Node = Seq(pair, pair)

        print(size(both))
        """), "4\n")
