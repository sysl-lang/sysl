// p14b inside a tree: the value lives in a NODE that a search finds, so the place is an element of a
// node a `*self` call answers as a `&Leaf`. The index comes back from the same search through a
// field, since a call answers one value.

struct Leaf
    keys: []string
    vals: []int
    len: usize

struct Tree
    root: &Leaf
    found: usize

    // Answers the leaf holding `k` -- putting it there with `init` first if it is absent -- and
    // leaves its index in `found`.
    leaf_for(*self, k: string, init: int) -> &Leaf
        val l = self.root

        for i in 0..<l.len
            if l.keys[i] == k
                self.found = i
                return l

        slot_place(l.keys, l.len, k)
        slot_place(l.vals, l.len, init)
        l.len += 1
        self.found = l.len - 1
        l
    end leaf_for

    entry(*self, k: string, init: int) -> ref int = self.leaf_for(k, init).vals[self.found]
end Tree

var t = Tree(Leaf(slot_storage(4), slot_storage(4), 0), 0)

for w in ["a", "b", "a", "a"]
    t.entry(w, 0) += 1

print(t.root.len, t.root.vals[0], t.root.vals[1])
