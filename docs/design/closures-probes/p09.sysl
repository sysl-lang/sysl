// Under @no_alloc: a closure handed to a generic parameter (no box) and to a '&Fn' parameter (a box).
each(xs: []int, f: int -> unit)
    for x in xs do f(x)

@no_alloc
sum(xs: []int) -> int
    var p: [1]int = [0]
    val q = &p[0]

    each(xs, n -> *q += n)
    p[0]

@no_alloc
apply(f: &Fn() -> int) -> int = f()

@no_alloc
boxed() -> int = apply(() -> 1)

val xs = [1, 2, 3]
print(sum(xs[..]), boxed())
