module sysl.buf

// The growable sequence and the sink built on it.
//
// A module of its own because nothing in the language reaches either: an array literal makes a `[]T`
// and a `for` walks whatever implements `Iterate`, so a program that wants a sequence that grows is
// asking for one, and asks with an `import`. What renders into a buffer without a program naming a
// sink is `str(x)`, and that goes through storage the compiler lays out rather than through
// `ByteSink` -- which is why the sink can sit here beside the buffer it wraps.

// A sequence that grows, over a `[]T` it replaces when it runs out.
//
// It is ordinary sysl rather than a built-in because a `[]T` that can be sized while running is all
// it needs: `push` allocates a slice twice the size and copies, so the amortized cost is the one a
// growable sequence has anywhere, and none of it is underneath the language.
//
// The bounds-checked members panic rather than returning an `Option`, which is the same bargain
// `unwrap` makes -- an index past the end is a mistake in the program, not a value it meant to
// handle -- while `pop` returns one, because taking from an empty sequence is a question a caller
// asks on purpose.
struct Buf[T]
    elems: []T
    count: usize

    len(self) -> usize = self.count

    cap(self) -> usize = self.elems.len

    is_empty(self) -> bool = self.count == 0

    at(self, i: usize) -> T
        if i >= self.count
            print("panic: index", i, "past the", self.count, "elements of a Buf")
            exit(1)
        self.elems[i]

    set(*self, i: usize, v: T)
        if i >= self.count
            print("panic: index", i, "past the", self.count, "elements of a Buf")
            exit(1)
        self.elems[i] = v

    push(*self, v: T)
        if self.count == self.elems.len
            var bigger: []T = [v; if self.elems.len == 0 then 8usize else self.elems.len * 2]

            for i in 0..<self.count do bigger[i] = self.elems[i]

            self.elems = bigger

        self.elems[self.count] = v
        self.count += 1
    end push

    // Every element of a slice appended at once, which is what `push` in a loop was costing more
    // than it looked like. A run of n elements pushed one at a time asks the capacity question n
    // times and may reallocate several times along the way; this asks once, grows once to a size
    // that fits the whole run, and copies.
    //
    // The growth stays geometric rather than sizing exactly to what is needed, so that a caller
    // extending repeatedly still pays amortized constant time per element -- sizing to fit would
    // make a loop of `extend` calls quadratic in the same way `+=` on a string is.
    //
    // The fill for the new storage is `xs[0]`, which is why the empty case leaves early: an array
    // is made by repeating a value (`07`) and a generic `T` has no zero to repeat when there is no
    // element in hand. Nothing is written to those slots afterwards anyway -- `count` is what says
    // which of them are real.
    extend(*self, xs: []const T)
        if xs.len == 0 then return

        var need = self.count + xs.len

        if need > self.elems.len
            var bigger_len: usize = if self.elems.len == 0 then 8 else self.elems.len

            while bigger_len < need
                bigger_len *= 2

            var bigger: []T = [xs[0]; bigger_len]

            for i in 0..<self.count do bigger[i] = self.elems[i]

            self.elems = bigger

        for i in 0..<xs.len do self.elems[self.count + i] = xs[i]

        self.count = need
    end extend

    pop(*self) -> Option[T]
        if self.count == 0 then return None

        self.count -= 1
        Some(self.elems[self.count])

    truncate(*self, n: usize)
        if n < self.count then self.count = n

    clear(*self)
        self.truncate(0)

    // An element put at `i`, with everything from there on moved up one. `remove`'s other half, and
    // the reason it is worth having is that hand-rolling it is a shift written backwards -- a loop
    // walking up overwrites the element it is about to read, so the copy has to start at the end and
    // that is where the off-by-one lives.
    //
    // Inserting at `len` is a `push`, and is allowed for that reason: a loop inserting at a cursor
    // reaches the end of the sequence on its last step, and refusing there would make the caller
    // write the case that this one already handles. Anything past `len` is a gap, which a sequence
    // has no way to represent, and panics the way every other index past the end does.
    insert(*self, i: usize, v: T)
        if i > self.count
            print("panic: index", i, "past the", self.count, "elements of a Buf")
            exit(1)

        self.push(v)

        var j = self.count - 1

        while j > i
            self.elems[j] = self.elems[j - 1]
            j -= 1

        self.elems[i] = v
    end insert

    remove(*self, i: usize) -> T
        if i >= self.count
            print("panic: index", i, "past the", self.count, "elements of a Buf")
            exit(1)

        var gone = self.elems[i]

        for j in i..<self.count - 1
            self.elems[j] = self.elems[j + 1]

        self.truncate(self.count - 1)
        gone
    end remove

    // The elements as a slice, which is what everything reading a `Buf` in bulk goes through. It is
    // a view of the storage rather than a copy, so it is only valid while nothing pushes.
    view(self) -> []T = self.elems[..<self.count]
end Buf

// Subscripting reaches the bounds-checked members rather than the storage, so `b[i]` on a `Buf`
// means what `b.at(i)` means and cannot read a slot past the count that the backing slice still has.
impl[T] Index[usize, T] for Buf[T]
    index(self, i: usize) -> T = self.at(i)

impl[T] IndexSet[usize, T] for Buf[T]
    index_set(*self, i: usize, v: T) = self.set(i, v)

buf[T]() -> Buf[T]
    var b: Buf[T] = Buf([], 0)

    b

// A buffer that has already been given room for `n` elements, for a caller that knows roughly how
// many are coming. What it saves is the reallocation-and-copy at each doubling on the way up, which
// is the one cost a growable sequence has that an exactly-sized array does not.
//
// **The fill is a parameter because a generic `T` has no zero**, and an array is made by repeating a
// value. It is written rather than inferred for the same reason the language asks for it anywhere
// else: nothing about `T` says what an unused slot should hold, and none of these slots is read --
// `count` starts at zero, so every one of them is written before anything can see it.
buf_with_capacity[T](n: usize, fill: T) -> Buf[T]
    var b: Buf[T] = Buf([fill; n], 0)

    b

// A writer that gathers, and the reason it is supplied rather than left to each program is the rule
// that a specifier describes the field the *whole* value occupies (`library/core.md § A specifier
// is the whole value's field`): an implementation rendering more than one part has to gather them
// before it can pad what they came to, and gathering needs somewhere to put them.
//
// It is one of the library's two writers; the other is `Stdout`, in the standard module, which
// stands for standard output and holds no state at all.
struct ByteSink
    bytes: &Buf[u8]

    text(self) -> []u8 = self.bytes.view()

byte_sink() -> ByteSink = ByteSink(buf())

// A buffer that grows has nothing to fail at, so the whole of implementing the latch is opting into
// it: every member of `Fallible` has a default, and a trait like that needs no block
// (`reference/traits.md § Conformance is explicit, always`).
impl Fallible for ByteSink

impl Writer for ByteSink
    write(*self, bytes: []const u8) = self.bytes.extend(bytes)
