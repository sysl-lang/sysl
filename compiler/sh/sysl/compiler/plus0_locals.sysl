module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.container.{Map, map, Set, set}
import sysl.ByAddress

// **A local that only walks storage holds no count** (`docs/design/borrow-inference.md` §3, §4.1;
// `tests_bli_borrowed_locals.sysl`).
//
// A counted value read out of storage is alive for as long as the storage holds it: its referents
// are held by the edge it was read along, and that edge by the root the walk started from. So a
// local -- a `var`, a `val`, a `match` arm's binding, an `is` binding -- whose every value is read
// that way, and whose chain nothing can cut while it is alive, needs no count of its own. Taking one
// could never be what keeps the object alive, so leaving it out changes nothing a program prints or
// when a destructor runs; it only removes a retain and a release, which LLVM cannot cancel across a
// loop (`x_tail = xt.next` retains in one trip and releases in the next).
//
// **Backing.** Each candidate's values get a provenance: `Fresh` (a call's answer, a box, module
// storage -- anything that arrives with a count), or backed by **roots** along **edge keys**
// (`EdgeKey`, the summary's own): a field read through a reference adds `(owner, field)`, a payload
// bound out of a value that is not in the frame adds the payload's key, a value built on the spot is
// backed by its parts, and a copy of another +0 local is backed as that local is. A value still in
// a root's own slot (`frame`) adds no key: nothing but writing the root can change it.
//
// **Roots** are the slots only this frame can change and whose changes it sees: a parameter (the
// caller holds it for the activation -- unless the body jumps back to its own entry, which writes
// them), and a local of the function's top block (alive to the end of the body). Neither may have its
// address taken or a `ref` bound to it, nor be promoted to the heap. An owned one -- a local, or a
// parameter the body owns -- must also not be used where its count could move (handed to a call,
// copied into a counted local, matched on): only read through.
//
// **Validity** is checked over the candidate's whole scope (its block from the declaration on, an
// arm, an `if`'s or `while`'s body after its condition): a store or a callee's edge-write summary
// (`edge_writes`) meeting a key, code nobody can see (a closure or table call, a function value, a
// foreign call not trusted, a suspension, a destructor -- any value in the scope whose release may
// run one), a slot form that reads a count of a chain type, and the root written or used where its
// count could move. One kill anywhere in the scope keeps the count -- a local is +0 for the whole of
// its life or not at all (decision 5), so no merge of differently-counted values is ever needed.
//
// **Keeping** a +0 value takes the count where it is kept (decision 6): a store, `return`, `break`,
// a copy into a counted local, an owned argument, a value built from it -- each goes through
// `retain_moving`, which finds no slot of the frame's to take the count over from, exactly as for a
// lent `for` variable (`lent_element`) and a borrowed parameter. A candidate named in a `defer`, a
// compound assignment, a multiple assignment, or whose address is taken, is counted.
//
// The answer is the set of +0 names, which the emitter reads through `e.lent_decls`: a declaration
// and a binding of one take no count and register no slot, and an assignment to one is a plain
// store (`store_over`).

// Where a candidate's values come from: roots, the edge keys between them and the value, and whether
// the value still sits in a root's own slot.
private struct Back
    roots: Set[string]
    keys: Buf[EdgeKey]
    named: Set[string]
    frame: bool
end Back

private back_empty() -> Back = Back(set(), buf(), set(), true)

private back_root(name: string) -> Back
    var roots: Set[string] = set()

    roots.add(name)
    Back(roots, buf(), set(), true)
end back_root

private back_copy(b: Back) -> Back
    var roots: Set[string] = set()
    var keys: Buf[EdgeKey] = buf()
    var named: Set[string] = set()

    for item in b.roots
        roots.add(item)

    for item in b.keys
        keys.push(item)
        named.add(item.text)

    Back(roots, keys, named, b.frame)
end back_copy

private back_key(b: Back, k: EdgeKey) -> Back
    val out = back_copy(b)

    if !out.named.has(k.text)
        out.named.add(k.text)
        out.keys.push(k)

    Back(out.roots, out.keys, out.named, false)
end back_key

// Both: every root and key of either, in the frame only where both are.
private back_join(a: Back, b: Back) -> Back
    val out = back_copy(a)

    for item in b.roots
        out.roots.add(item)

    for item in b.keys
        if !out.named.has(item.text)
            out.named.add(item.text)
            out.keys.push(item)

    Back(out.roots, out.keys, out.named, a.frame && b.frame)
end back_join

private back_size(b: Option[Back]) -> usize = b match
    Some(x) -> x.roots.len() + x.keys.len() + (if x.frame then 0usize else 1usize) + 1
    None -> 0

// One way a candidate is given a value: an expression it is assigned (`var x = v`, `x = v`), or a
// part bound out of a subject along `steps`, each the edge key of a payload field or struct field. A
// rewritten parameter has two more: the value it arrived with (`DEntry`, backed by its entry root),
// and each argument a self-jump stages for it (`DJump`).
private enum Def
    DValue(x: TExpr)
    DPart(subject: TExpr, steps: Buf[EdgeKey])
    DEntry(name: string)
    DJump(x: TExpr)

// The root that stands for the value parameter `name` arrived with: the caller's, held for the whole
// activation, jumps included, however often the parameter's own slot is written.
private entry_root(name: string) -> string = name + "@entry"

private is_entry_root(r: string) -> bool = r.ends_with("@entry")

// What can cut a candidate's chain inside its scope: a store or a call's summary (`w`, with `what`
// naming it for the report), or a root's slot written or used where its count could move (`root`). A
// root's use that is the value of a candidate's own definition (`def_of`) is harmless where that
// candidate is +0 -- the copy takes no count -- and moves the count otherwise.
private struct Event
    w: EdgeWrites
    root: string
    written: bool
    def_of: string
    what: string
    at: Span
end Event

// A candidate's scope is the statements of its list (`list`) from `from` on, then `extra` -- an arm's
// guard, the terms of a condition after an `is` -- then the list's result: a suffix of a list every
// candidate of the list shares (`Scoped`), and a few expressions of its own.
private struct Cand
    name: string
    at: Span
    defs: Buf[Def]
    list: usize
    from: usize
    extra: Buf[TExpr]
end Cand

// Gathers the candidates of one body, the names disqualified, the definitions, and the statement lists
// the candidates' scopes are suffixes of.
private struct Gather
    cands: Buf[Cand]
    index: Map[string, usize]
    barred: Set[string]
    stores: Buf[(string, TExpr)]
    lists: Buf[Buf[TStmt]]
    results: Buf[Option[TExpr]]
    // The function's parameters, the self-calls it jumps at (by span, as the emitter finds them), and
    // what each jump stages for each parameter.
    params: Buf[(string, Type)]
    sites: Buf[Span]
    jumps: Buf[(string, TExpr)]

    list(*self, stmts: Buf[TStmt], result: Option[TExpr]) -> usize
        self.lists.push(stmts)
        self.results.push(result)
        self.lists.len() - 1

    add(*self, c: Cand)
        if self.index.has(c.name) then return

        self.index.put(c.name, self.cands.len())
        self.cands.push(c)

    bar(*self, name: string)
        self.barred.add(name)

    store(*self, name: string, value: TExpr)
        self.stores.push((name, value))
end Gather

// One +0 local's or counted candidate's line of the `--explain-borrows` report, for the driver to say
// once the program is lowered.
struct LocalNote
    file: string
    start: usize
    text: string
end LocalNote

private var pzl_notes: Buf[LocalNote] = buf()
private var pzl_seen: Set[string] = set()

// **What the analysis has done since the last call**: the events its walks made and the +0 locals it
// answered -- the work a test holds to the size of the bodies it reads (`tests_pzg_plus0_growth.sysl`).
private var pzl_events_made: usize = 0
private var pzl_plus0_found: usize = 0

take_plus0_work() -> (usize, usize)
    val out = (pzl_events_made, pzl_plus0_found)

    pzl_events_made = 0
    pzl_plus0_found = 0
    out
end take_plus0_work

// The local lines gathered since the last call, handed over once.
take_local_notes() -> Buf[LocalNote]
    val out = pzl_notes

    pzl_notes = buf()
    pzl_seen = set()
    out
end take_local_notes

// What the analysis answers for one body: the names that hold no count -- locals, and rewritten
// parameters borrowed throughout -- and the rewritten parameters that are counted but every one of
// whose self-jump arguments arrives with a count of its own, which a peel can borrow on entry
// (`borrow-inference.md` §4.3 (b)).
struct Plus0
    names: Set[string]
    fresh: Set[string]
end Plus0

// **The +0 locals of `f`**, emitted with the parameters `owned` owns, `jumps` where the body jumps
// back to its own entry.
//
// **A rewritten parameter** (`rewritten`: one the body assigns or jumps with, which `owning` would
// own) is a candidate as a local is, its definitions the value it arrived with -- backed by its entry
// root, the caller's for the whole activation -- every assignment, and every argument a self-jump
// stages for it. Borrowed throughout where every one is backed by entry roots (or, in a body that
// never jumps, by another parameter) and nothing in the body cuts the chain: no entry retain, no exit
// release, a plain store at each assignment and no count staged at a jump. Never a local root: a
// jump gives up the frame's locals, and the parameter outlives each one.
//
// `peelable` is whether the function may be peeled at all (`emit_func.sysl`'s `peel_shape`); only then
// is a parameter answered in `fresh`, and only one whose type cannot run a destructor -- such a one
// keeps its entry retain, as the design leaves it.
plus0_locals(e: *Emit, f: TFunc, owned: Set[string], jumps: bool, rewritten: Set[string] = set(),
             peelable: bool = false) -> Plus0
    var out: Set[string] = set()
    var fresh: Set[string] = set()
    val g: &Gather = Gather(buf(), map(), set(), buf(), buf(), buf(), f.params, tail_calls_of(f), buf())

    // A rewritten parameter's scope is the whole body, from its first statement.
    if !rewritten.is_empty()
        val whole = g.list(f.body.stmts, f.body.result)

        for p in f.params
            if rewritten.has(p.0)
                var defs: Buf[Def] = buf()

                defs.push(DEntry(p.0))
                g.add(Cand(p.0, f.span, defs, whole, 0, buf()))
        end for
    end if

    e.held_args = held_args_for(f, owned)
    gather_body(e, g, f)

    if g.cands.is_empty() then return Plus0(out, fresh)

    // Every definition an assignment makes, and the candidates that cannot be +0 whatever their values.
    for item in g.stores
        g.index.get(item.0) match
            Some(i) -> g.cands[i].defs.push(DValue(item.1))
            None -> ()

    for item in g.jumps
        g.index.get(item.0) match
            Some(i) -> if rewritten.has(item.0) then g.cands[i].defs.push(DJump(item.1))
            None -> ()

    // **Only a local that is read through is a candidate** -- a field read off it, a deref of it, a
    // `match` on it, an `is` test of it. One that is only passed along is better counted: its count
    // moves from what it was built of to where it is handed, and a +0 one would take a count there. A
    // rewritten parameter is the exception: counted, it pays at entry and at exit whatever it does.
    val read = read_through(f)
    var alive: Buf[bool] = buf()

    for c in g.cands
        alive.push(!g.barred.has(c.name) && !c.defs.is_empty() && (read.has(c.name) || rewritten.has(c.name)) &&
                   eligible(e, c.name))

    // The roots: parameters a body that never jumps back holds for the whole activation, and the
    // locals of its top block, alive to its end.
    val aliases = ref_names(f)
    var params: Set[string] = set()
    var tops: Set[string] = set()
    val unrooted = unrootable(f, aliases)

    for p in f.params
        if !jumps && !unrooted.has(p.0) then params.add(p.0)

    for s in f.body.stmts
        s match
            TVarDecl(name, _, _, _) -> if !unrooted.has(name) && !is_promoted(e, name) then tops.add(name)
            _ -> ()

    // Each scope's events, once: they do not depend on which candidates are +0. **A list is walked once
    // for all its candidates** (`Scoped`) and each candidate's own expressions once, so the work is the
    // size of the body, not the size times the candidates.
    val drops = drop_memo(e)
    var scoped: Buf[Option[Scoped]] = buf()
    var extras: Buf[Buf[Event]] = buf()

    for k in 0..<g.lists.len()
        scoped.push(None)

    for i in 0..<g.cands.len()
        val c = g.cands[i]

        if alive[i] && scoped[c.list].is_none()
            scoped[c.list] = Some(scope_list(e, g, drops, c.list, aliases, params, tops))

        extras.push(if alive[i] then extra_events(e, g, drops, c.extra, aliases, params, tops) else buf())

    val parts = parts_memo()

    var shaped: Buf[bool] = buf()
    var why: Buf[string] = buf()
    var backs: Buf[Option[Back]] = buf()

    for i in 0..<g.cands.len()
        shaped.push(false)
        why.push("")
        backs.push(None)

    var moved = true

    while moved
        moved = false
        settle(g, alive, params, tops, &backs)

        for i in 0..<g.cands.len()
            if !alive[i] then continue

            var said = refusal(e, g, alive, backs, scoped[g.cands[i].list].unwrap(), extras[i], parts, params,
                               owned, tops, i)

            if said == "" && rewritten.has(g.cands[i].name) then said = local_root(backs[i], params)

            if said != ""
                alive[i] = false
                why[i] = said
                moved = true
    end while

    // The report speaks of the candidates read out of storage: the +0 ones, and the counted ones one of
    // whose values is read from a root -- never of a local each value of which arrives with a count or
    // is a constant.
    for i in 0..<g.cands.len()
        if alive[i]
            out.add(g.cands[i].name)
            pzl_plus0_found += 1

        if why[i] != ""
            for d in g.cands[i].defs
                def_back(g, alive, backs, params, tops, d) match
                    Some(b) -> if !b.roots.is_empty() then shaped[i] = true
                    None -> ()

        shaped[i] = shaped[i] || alive[i]

    // A counted parameter that only self-jumps, every argument it is staged arriving with a count of
    // its own: the peel's (§4.3 (b)). One the body also assigns stays owned, the assignment needing a
    // slot that holds a count.
    if jumps && peelable
        for i in 0..<g.cands.len()
            val c = g.cands[i]

            if alive[i] || !rewritten.has(c.name) || g.barred.has(c.name) then continue

            var drops = false

            for p in f.params
                if p.0 == c.name && may_run_drop(p.1, e.untouched.dropping) then drops = true

            if drops then continue

            var jumped = false
            var all_fresh = true

            for d in c.defs
                d match
                    DJump(x) ->
                        jumped = true

                        if !fresh_arg(x) then all_fresh = false
                    DValue(_) -> all_fresh = false
                    DPart(_, _) -> all_fresh = false
                    DEntry(_) -> ()

            if jumped && all_fresh then fresh.add(c.name)
    end if

    if explaining_borrows() then note_locals(f, g, alive, shaped, why, backs, rewritten, fresh)

    Plus0(out, fresh)
end plus0_locals

// Why a rewritten parameter may not be borrowed although its chain is intact: a value of it is backed
// by a local of the frame, which a jump gives up and the parameter outlives. Empty where every root is
// an entry root or a parameter.
private local_root(b: Option[Back], params: Set[string]) -> string
    if b.is_none() then return ""

    for r in b.unwrap().roots
        if !is_entry_root(r) && !params.has(r) then return s"it is assigned a value borrowed from the local '${shown(r)}'"

    ""
end local_root

// Whether a self-jump's argument arrives with a count of its own: anything but a value read out of a
// place -- a call's answer, a box, a literal -- or a value built on the spot of such parts.
private fresh_arg(x: TExpr) -> bool = *x.kind match
    TLoad(_, _) -> false
    TField(_, _, _) -> false
    TDeref(_, _) -> false
    TIndex(_, _, _) -> false
    TEnumNew(_, _, args) -> all_fresh_args(args)
    TStructNew(_, args) -> all_fresh_args(args)
    _ -> true

private all_fresh_args(args: Buf[TExpr]) -> bool
    for item in args
        if contains_counted(texpr_type(item)) && !fresh_arg(item) then return false

    true

// A local whose storage the emitter lays down in a way of its own is never a candidate: a promoted
// one, a frame array's, the one built in the caller's result storage, a large one, a `@unique` one.
private eligible(e: *Emit, name: string) -> bool
    if is_promoted(e, name) || e.frame_slots.has(name) then return false

    e.return_slot match
        Some(plan) -> if plan.name == name then return false
        None -> ()

    true
end eligible

private counted_local(e: *Emit, ty: Type) -> bool =
    contains_counted(ty) && !zero_sized(ty) && !e.layout.indirect(ty) && !value_drops(e, ty)

// -- the candidates ---------------------------------------------------------------------------------

private gather_body(e: *Emit, g: &Gather, f: TFunc)
    gather_list(e, g, g.list(f.body.stmts, f.body.result))
    walk_block_stmts(f.body, TWalk(true, x -> gather_node(e, g, x), w -> gather_write(g, w),
                                   s -> gather_stmt(g, s)))
end gather_body

// Each `var`/`val` of a list, its scope the statements after it and the list's result.
private gather_list(e: *Emit, g: &Gather, id: usize)
    val stmts = g.lists[id]

    for k in 0..<stmts.len()
        stmts[k] match
            TVarDecl(name, ty, init, align) ->
                if align.is_none() && counted_local(e, ty)
                    var defs: Buf[Def] = buf()

                    defs.push(DValue(init))
                    g.add(Cand(name, init.span, defs, id, k + 1, buf()))
            _ -> ()
end gather_list

private gather_block(e: *Emit, g: &Gather, b: Option[TBlock])
    if b.is_some() then gather_list(e, g, g.list(b.unwrap().stmts, b.unwrap().result))

private gather_node(e: *Emit, g: &Gather, x: TExpr) = *x.kind match
    TIf(cond, then_block, else_block, _) ->
        val id = g.list(then_block.stmts, then_block.result)

        gather_terms(e, g, cond, id)
        gather_list(e, g, id)
        gather_block(e, g, else_block)
    TMatch(scrutinee, arms, _) ->
        for arm in arms
            val id = g.list(arm.body.stmts, arm.body.result)

            if arm.patterns.len() == 1
                var extra: Buf[TExpr] = buf()

                if arm.guard.is_some() then extra.push(arm.guard.unwrap())

                gather_binds(e, g, scrutinee, arm.patterns[0], buf(), id, extra)

            gather_list(e, g, id)
    TBlockExpr(block) -> gather_list(e, g, g.list(block.stmts, block.result))
    TWhile(cond, body, else_block, _) ->
        val id = g.list(body, None)

        gather_terms(e, g, cond, id)
        gather_list(e, g, id)
        gather_block(e, g, else_block)
    TDoWhile(body, _, else_block, _) ->
        gather_list(e, g, g.list(body, None))
        gather_block(e, g, else_block)
    TLoop(body, _) -> gather_list(e, g, g.list(body, None))
    TFor(_, _, _, _, _, body, else_block, _) ->
        gather_list(e, g, g.list(body, None))
        gather_block(e, g, else_block)
    TForEach(_, _, _, body, else_block, _) ->
        gather_list(e, g, g.list(body, None))
        gather_block(e, g, else_block)
    TIterate(_, _, _, _, _, body, else_block, _) ->
        gather_list(e, g, g.list(body, None))
        gather_block(e, g, else_block)
    TStore(place, value, _, _) -> gather_place(g, place, value, true)
    // A self-call `tail_calls_of` names is a jump: it stages each argument into its parameter's slot.
    TCall(_, args, _, _) ->
        if is_tail_call(g.sites, x.span)
            for j in 0..<args.len()
                if j < g.params.len() then g.jumps.push((g.params[j].0, args[j]))
    TUpdate(place, _, _, _, _, _, _) -> bar_place(g, place)
    TIncDec(place, _, _, _, _) -> bar_place(g, place)
    TAddrOf(place, _) -> bar_place(g, place)
    _ -> ()

// The `is` bindings of a condition, each one's scope the terms after it and the body it guards (list
// `id`).
private gather_terms(e: *Emit, g: &Gather, cond: Buf[TCondTerm], id: usize)
    for k in 0..<cond.len()
        cond[k] match
            TCondIs(subject, patterns, negated) ->
                if !negated && patterns.len() == 1
                    var extra: Buf[TExpr] = buf()

                    for j in k + 1..<cond.len()
                        cond[j] match
                            TCondTest(c) -> extra.push(c)
                            TCondIs(s, _, _) -> extra.push(s)

                    gather_binds(e, g, subject, patterns[0], buf(), id, extra)
            TCondTest(_) -> ()
end gather_terms

// The names a pattern binds out of `subject`, each through the payload and struct fields that lead to
// it, each one's scope the whole of list `id` and `extra`. A binding under a `ref` pattern or an `@` is
// not followed: those are counted as today.
private gather_binds(e: *Emit, g: &Gather, subject: TExpr, p: TPattern, steps: Buf[EdgeKey], id: usize,
                     extra: Buf[TExpr]) -> unit = p match
    TBindPattern(name, ty) ->
        if counted_local(e, ty)
            var defs: Buf[Def] = buf()

            defs.push(DPart(subject, steps))
            g.add(Cand(name, subject.span, defs, id, 0, extra))
    TVariantPattern(enum_ty, variant, args) ->
        for i in 0..<args.len()
            if i < variant.fields.len()
                val field = variant.fields[i]

                gather_binds(e, g, subject, args[i], steps_with(steps, edge_key(enum_ty, s"${variant.name}.${field.0}",
                                                                                  field.1)),
                             id, extra)
    TStructPattern(decl, args) ->
        for i in 0..<args.len()
            field_key(Struct(decl), int(i)) match
                Some(k) -> gather_binds(e, g, subject, args[i], steps_with(steps, k), id, extra)
                None -> ()
    _ -> ()

private steps_with(steps: Buf[EdgeKey], k: EdgeKey) -> Buf[EdgeKey]
    var out: Buf[EdgeKey] = buf()

    for item in steps
        out.push(item)

    out.push(k)
    out
end steps_with

private gather_write(g: &Gather, w: TWrite)
    if w.op == "=" then gather_place(g, w.place, w.value, true) else bar_place(g, w.place)

private gather_stmt(g: &Gather, s: TStmt) = s match
    TMultiAssign(writes) ->
        for item in writes
            bar_place(g, item.place)
    TRefDecl(_, _, place) -> bar_place(g, place)
    TDefer(stmts, _) -> walk_stmts(stmts, expr_walk(true, x -> bar_load(g, x)))
    _ -> ()

// An assignment to a candidate is one of its definitions; one to a part of it bars it.
private gather_place(g: &Gather, place: TExpr, value: TExpr, plain: bool) = *place.kind match
    TLoad(name, _) -> if plain then g.store(name, value) else g.bar(name)
    _ -> bar_place(g, place)

private bar_place(g: &Gather, place: TExpr) = place_base(place) match
    Some(name) -> g.bar(name)
    None -> ()

private bar_load(g: &Gather, x: TExpr) = *x.kind match
    TLoad(name, _) -> g.bar(name)
    _ -> ()

// The local a place is part of, reached without a dereference.
private place_base(place: TExpr) -> Option[string] = *place.kind match
    TLoad(name, _) -> Some(name)
    TField(r, _, _) -> place_base(r)
    TIndex(r, _, _) -> repr(texpr_type(r)) match
        Array(_, _, _) -> place_base(r)
        _ -> None
    _ -> None

// The locals the body reads through: a field or a deref of one, a `match` on one, an `is` test of one.
private read_through(f: TFunc) -> Set[string]
    val out = name_sink()

    walk_block_stmts(f.body, expr_walk(true, x -> read_node(out, x)))
    out.names
end read_through

private read_node(out: &NameSink, x: TExpr) = *x.kind match
    TField(r, _, _) -> read_load(out, r)
    TDeref(r, _) -> read_load(out, r)
    TMatch(scrutinee, _, _) -> read_load(out, scrutinee)
    TIf(cond, _, _, _) -> read_terms(out, cond)
    TWhile(cond, _, _, _) -> read_terms(out, cond)
    _ -> ()

private read_terms(out: &NameSink, cond: Buf[TCondTerm])
    for item in cond
        item match
            TCondIs(subject, _, _) -> read_load(out, subject)
            TCondTest(_) -> ()

private read_load(out: &NameSink, r: TExpr) = *r.kind match
    TLoad(name, _) -> out.add(name)
    _ -> ()

// The names no root may be: one whose address is taken, or a `ref` is bound to, anywhere in the body.
private unrootable(f: TFunc, aliases: Set[string]) -> Set[string]
    val out = name_sink()

    for item in aliases
        out.add(item)

    walk_block_stmts(f.body, TWalk(true, x -> unroot_node(out, x), w -> (), s -> unroot_stmt(out, s)))
    out.names
end unrootable

private unroot_node(out: &NameSink, x: TExpr) = *x.kind match
    TAddrOf(place, _) -> place_base(place) match
        Some(name) -> out.add(name)
        None -> ()
    _ -> ()

private unroot_stmt(out: &NameSink, s: TStmt) = s match
    TRefDecl(_, _, place) -> place_base(place) match
        Some(name) -> out.add(name)
        None -> ()
    _ -> ()

// -- what a scope can do to a chain -----------------------------------------------------------------

// The nodes a walk has met, found by identity: a load read through or stored to (`benign`), and the
// value of a candidate's definition (`defs`).
private struct EventSink
    events: Buf[Event]
    benign: Set[ByAddress[TExprKind]]
    defs: Map[ByAddress[TExprKind], string]
    drops: &DropMemo

    mark(*self, k: &TExprKind)
        self.benign.add(ByAddress(k))

    def(*self, k: &TExprKind, name: string)
        val at = ByAddress(k)

        if !self.defs.has(at) then self.defs.put(at, name)

    is_benign(self, k: &TExprKind) -> bool = self.benign.has(ByAddress(k))

    def_of(self, k: &TExprKind) -> string = self.defs.get(ByAddress(k)).unwrap_or("")
end EventSink

private event_sink(drops: &DropMemo) -> &EventSink = EventSink(buf(), set(), map(), drops)

// **Whether letting go of a value of a type may run a destructor, once per type** (`may_run_drop`): a
// body asks it of every node it walks, and a few types recur across all of them.
private struct DropMemo
    dropping: Buf[Type]
    known: Map[string, bool]

    runs(*self, t: Type) -> bool
        val spelling = mangle(t)

        self.known.get(spelling) match
            Some(b) -> return b
            None -> ()

        val b = may_run_drop(t, self.dropping)

        self.known.put(spelling, b)
        b
end DropMemo

private drop_memo(e: *Emit) -> &DropMemo = DropMemo(e.untouched.dropping, map())

// **The by-value parts of an edge's held type, once per edge** (`writes_edge`).
private struct PartsMemo
    known: Map[string, Buf[Type]]

    of(*self, k: EdgeKey) -> Buf[Type]
        self.known.get(k.text) match
            Some(ps) -> return ps
            None -> ()

        var ps: Buf[Type] = buf()

        by_value_parts(k.held, &ps)
        self.known.put(k.text, ps)
        ps
end PartsMemo

private parts_memo() -> &PartsMemo = PartsMemo(map())

// **One statement list's events, walked once for every candidate whose scope is a suffix of it**, with
// where each statement's begin (`starts`, then the result's), and for each thing that refuses a
// candidate the last event that does it, one past, so that whether a suffix holds one is a comparison:
// code nobody can see (`opaque_last`), an edge key named, a type written through a pointer or whose
// count is read, a root written, a root used where its count may move, and the uses that are the value
// of a candidate's definition (`defs_*`, a chain newest first), harmless while that candidate is +0.
private struct Scoped
    events: Buf[Event]
    starts: Buf[usize]
    opaque_last: usize
    keys_last: Map[string, usize]
    within: Buf[Type]
    within_at: TypeIndex
    within_last: Buf[usize]
    counts: Buf[Type]
    counts_at: TypeIndex
    counts_last: Buf[usize]
    written_last: Map[string, usize]
    used_last: Map[string, usize]
    defs_first: Map[string, usize]
    defs_next: Buf[usize]
    defs_event: Buf[usize]
end Scoped

private scope_list(e: *Emit, g: &Gather, drops: &DropMemo, id: usize, aliases: Set[string], params: Set[string],
                   tops: Set[string]) -> Scoped
    val sink = event_sink(drops)
    val walk = event_walk(e, g, sink, aliases, params, tops)
    val stmts = g.lists[id]
    var starts: Buf[usize] = buf()

    for s in stmts
        starts.push(sink.events.len())
        walk_stmt(s, walk)

    starts.push(sink.events.len())

    if g.results[id].is_some() then walk_texpr(g.results[id].unwrap(), walk)

    pzl_events_made += sink.events.len()

    var out = Scoped(sink.events, starts, 0, map(), buf(), type_index(), buf(), buf(), type_index(), buf(), map(),
                     map(), map(), buf(), buf())

    for j in 0..<out.events.len()
        val ev = out.events[j]
        val past = j + 1

        if ev.root != ""
            if ev.written then out.written_last.put(ev.root, past)
            else if ev.def_of == "" then out.used_last.put(ev.root, past)
            else
                out.defs_next.push(out.defs_first.get(ev.root).unwrap_or(0))
                out.defs_event.push(j)
                out.defs_first.put(ev.root, out.defs_event.len())
            end if

            continue
        end if

        if ev.w.opaque != "" then out.opaque_last = past

        for k in ev.w.keys
            out.keys_last.put(k.text, past)

        for i in 0..<ev.w.within.len()
            last_at(&out.within, &out.within_at, &out.within_last, ev.w.within[i], ev.w.within_at.spelled[i], past)

        for i in 0..<ev.w.counts.len()
            last_at(&out.counts, &out.counts_at, &out.counts_last, ev.w.counts[i], ev.w.counts_at.spelled[i], past)

    out
end scope_list

// Records that the event one before `past` names `t`.
private last_at(items: *Buf[Type], at: *TypeIndex, last: *Buf[usize], t: Type, spelling: string, past: usize)
    at.find(*items, t, spelling) match
        Some(i) -> (*last)[i] = past
        None ->
            at.add(spelling, items.len())
            items.push(t)
            last.push(past)

// Whether an event at or after `from` names `t` (`last` as `last_at` keeps it).
private named_since(items: Buf[Type], at: TypeIndex, last: Buf[usize], t: Type, from: usize) -> bool =
    at.find(items, t, mangle(t)) match
        Some(i) -> last[i] > from
        None -> false

// A candidate's own expressions' events.
private extra_events(e: *Emit, g: &Gather, drops: &DropMemo, exprs: Buf[TExpr], aliases: Set[string],
                     params: Set[string], tops: Set[string]) -> Buf[Event]
    if exprs.is_empty() then return buf()

    val sink = event_sink(drops)
    val walk = event_walk(e, g, sink, aliases, params, tops)

    for x in exprs
        walk_texpr(x, walk)

    pzl_events_made += sink.events.len()
    sink.events
end extra_events

private event_walk(e: *Emit, g: &Gather, sink: &EventSink, aliases: Set[string], params: Set[string],
                   tops: Set[string]) -> &TWalk =
    TWalk(true, x -> event_node(e, g, sink, aliases, params, tops, x),
          w -> event_write(e, g, sink, aliases, params, tops, w),
          s -> event_stmt(e, g, sink, s))

private hidden_event(sink: &EventSink, why: string, at: Span)
    var w = edge_writes_none()

    w.hide(why, "")
    sink.events.push(Event(w, "", false, "", why, at))
end hidden_event

private root_name(n: string, params: Set[string], tops: Set[string]) -> bool = params.has(n) || tops.has(n)

private event_stmt(e: *Emit, g: &Gather, sink: &EventSink, s: TStmt) = s match
    TVarDecl(name, ty, init, _) ->
        if sink.drops.runs(ty) then
            hidden_event(sink, s"a destructor of '${type_show(ty)}'", init.span)

        if g.index.has(name) then sink.def(init.kind, name)
    TAsm(_, _, clobbers, span) ->
        for item in clobbers
            if item == "memory" then hidden_event(sink, "inline assembly that may write memory", span)
    _ -> ()

private event_write(e: *Emit, g: &Gather, sink: &EventSink, aliases: Set[string], params: Set[string],
                    tops: Set[string], w: TWrite)
    event_store(e, g, sink, aliases, params, tops, w.place, w.value)

    if w.dispatch.is_some() then event_call(e, sink, w.dispatch.unwrap().name, w.place.span)

    for item in w.check
        event_call(e, sink, item.inv_fn, w.place.span)
end event_write

// A store: to a local of the frame's own it writes no edge, but it writes that local -- a root's
// death where the local is one. Anywhere else, the edges `note_store` names.
private event_store(e: *Emit, g: &Gather, sink: &EventSink, aliases: Set[string], params: Set[string],
                    tops: Set[string], place: TExpr, value: TExpr)
    *place.kind match
        TLoad(name, _) ->
            sink.mark(place.kind)

            if g.index.has(name) then sink.def(value.kind, name)
        _ -> ()

    if own_base(place, aliases)
        place_base(place) match
            Some(name) ->
                if root_name(name, params, tops) then
                    sink.events.push(Event(edge_writes_none(), name, true, "", s"the root '${shown(name)}' is written",
                                           place.span))
            None -> ()

        return
    end if

    val es = edge_sink()

    note_store(es, aliases, place)

    val w = edge_finish(es.w, e.untouched.edge_casts)

    sink.events.push(Event(w, "", false, "", "a store", place.span))
end event_store

private event_call(e: *Emit, sink: &EventSink, name: string, at: Span)
    val w = edge_writes(&e.untouched, name)

    sink.events.push(Event(w, "", false, "", s"'${qualified_name(name)}'", at))
end event_call

private event_node(e: *Emit, g: &Gather, sink: &EventSink, aliases: Set[string], params: Set[string],
                   tops: Set[string], x: TExpr)
    if sink.drops.runs(texpr_type(x)) then
        hidden_event(sink, s"a destructor of '${type_show(texpr_type(x))}'", x.span)

    *x.kind match
        TField(r, _, _) -> mark_load(sink, r)
        TDeref(r, _) -> mark_load(sink, r)
        TLoad(name, _) ->
            if root_name(name, params, tops) && !sink.is_benign(x.kind)
                sink.events.push(Event(edge_writes_none(), name, false, sink.def_of(x.kind),
                                       s"'${shown(name)}' is used where its count may move", x.span))
        TStore(place, value, _, _) -> event_store(e, g, sink, aliases, params, tops, place, value)
        TIncDec(place, _, _, _, _) -> event_store(e, g, sink, aliases, params, tops, place, place)
        TUpdate(place, _, _, _, dispatch, _, _) ->
            event_store(e, g, sink, aliases, params, tops, place, place)

            if dispatch.is_some() then event_call(e, sink, dispatch.unwrap().name, x.span)
        TCall(name, _, _, _) -> event_call(e, sink, name, x.span)
        TCompare(_, cmps) ->
            for cmp in cmps
                if cmp.dispatch.is_some() then event_call(e, sink, cmp.dispatch.unwrap().name, x.span)
        TRecheck(_, _, _, inv_fn) -> event_call(e, sink, inv_fn, x.span)
        TStructInvCheck(_, _, inv_fn) -> event_call(e, sink, inv_fn, x.span)
        TTry(_, _, _, _, _, _, convert) -> if convert.is_some() then event_call(e, sink, convert.unwrap(), x.span)
        TRender(_, method, _, slot) ->
            if slot.is_none() then event_call(e, sink, method, x.span)
            else hidden_event(sink, "a rendering through a trait object's table", x.span)
        TVCall(recv, _, _, _, _) ->
            hidden_event(sink, if closure_table(texpr_type(recv)) then "a call through a closure"
                               else "a call through a trait object's table", x.span)
        TCallPtr(_, _, _, _) -> hidden_event(sink, "a call through a function value", x.span)
        TSlots(op, _, elem, _) ->
            val es = edge_sink()

            note_slots(es, op, elem)
            sink.events.push(Event(es.w, "", false, "", s"'$op'", x.span))
        TAtomic(op, _, _, _, at, _) ->
            if op != "load"
                val es = edge_sink()

                es.pointer(at)
                sink.events.push(Event(edge_finish(es.w, e.untouched.edge_casts), "", false, "", "an atomic store", x.span))
        TVecStore(_, _, _) -> hidden_event(sink, "a vector store", x.span)
        TAwait(_, _) -> hidden_event(sink, "an await", x.span)
        TBlockOn(_, _) -> hidden_event(sink, "a suspension", x.span)
        TStep(_, _) -> hidden_event(sink, "a suspension", x.span)
        TPark(_) -> hidden_event(sink, "a fiber switch", x.span)
        TYieldNow -> hidden_event(sink, "a fiber switch", x.span)
        _ -> ()
end event_node

// A root read through keeps its count where it is. One matched on is not marked: an owned local's
// count may be handed into the arm that binds it, and given back where that arm ends.
private mark_load(sink: &EventSink, r: TExpr) = *r.kind match
    TLoad(_, _) -> sink.mark(r.kind)
    _ -> ()

// -- the fixed point -------------------------------------------------------------------------------

// Every alive candidate's backing, the least fixed point over their definitions: each starts empty and
// grows, and one that meets a fresh value is `None` from then on.
private settle(g: &Gather, alive: Buf[bool], params: Set[string], tops: Set[string], backs: *Buf[Option[Back]])
    for i in 0..<g.cands.len()
        (*backs)[i] = if alive[i] then Some(back_empty()) else None

    var moved = true

    while moved
        moved = false

        for i in 0..<g.cands.len()
            if !alive[i] || (*backs)[i].is_none() then continue

            var b: Option[Back] = Some(back_empty())

            for d in g.cands[i].defs
                if b.is_none() then break

                val one = def_back(g, alive, *backs, params, tops, d)

                b = if one.is_none() then None else Some(back_join(b.unwrap(), one.unwrap()))

            // Each answer only grows (a fresh value is absorbing), so a size that did not change is an
            // answer that did not.
            if back_size(b) != back_size((*backs)[i])
                moved = true
                (*backs)[i] = b
end settle

private def_back(g: &Gather, alive: Buf[bool], backs: Buf[Option[Back]], params: Set[string], tops: Set[string],
                 d: Def) -> Option[Back] = d match
    DValue(x) -> backing(g, alive, backs, params, tops, x)
    DJump(x) -> backing(g, alive, backs, params, tops, x)
    DEntry(name) -> Some(back_root(entry_root(name)))
    DPart(subject, steps) ->
        var b = backing(g, alive, backs, params, tops, subject)

        if b.is_some() && !b.unwrap().frame
            for k in steps
                b = Some(back_key(b.unwrap(), k))

        b

// Where the value of `x` comes from, or `None` where it arrives with a count of its own.
private backing(g: &Gather, alive: Buf[bool], backs: Buf[Option[Back]], params: Set[string], tops: Set[string],
                x: TExpr) -> Option[Back] = *x.kind match
    // A candidate of the top block that is about to be refused for a fresh value of its own is a root:
    // counted, it holds what it holds until it is written. In the round that settles, every alive
    // candidate has an answer, so this stands in only for one this round refuses.
    TLoad(name, _) ->
        g.index.get(name) match
            Some(i) -> if alive[i] && (backs[i].is_some() || !tops.has(name)) then return backs[i]
            None -> ()

        if root_name(name, params, tops) then Some(back_root(name)) else None
    // Through a `&sync` another domain may write the chain, so nothing read through one is backed.
    TDeref(operand, _) -> underlying(texpr_type(operand)) match
        Ref(_, sync) ->
            if sync then return None

            backing(g, alive, backs, params, tops, operand).map(b -> Back(b.roots, b.keys, b.named, false))
        _ -> None
    TField(r, i, _) ->
        val b = backing(g, alive, backs, params, tops, r)

        if b.is_none() || b.unwrap().frame then return b

        field_key(texpr_type(r), i).map(k -> back_key(b.unwrap(), k))
    TEnumNew(_, _, args) -> built_back(g, alive, backs, params, tops, args)
    TStructNew(_, args) -> built_back(g, alive, backs, params, tops, args)
    _ -> None

// A value built on the spot is backed by the union of its counted parts; one with none holds nothing.
private built_back(g: &Gather, alive: Buf[bool], backs: Buf[Option[Back]], params: Set[string], tops: Set[string],
                   args: Buf[TExpr]) -> Option[Back]
    var b = back_empty()

    for item in args
        if !contains_counted(texpr_type(item)) then continue

        val one = backing(g, alive, backs, params, tops, item)

        if one.is_none() then return None

        b = back_join(b, one.unwrap())

    Some(b)
end built_back

// Why candidate `i` must keep its count, or empty where it need not. **Whether it must is answered from
// the list's last events** (`Scoped`), in time for the roots and keys of its backing whatever the length
// of its scope; the event that does it is looked for in order only where the report names it.
private refusal(e: *Emit, g: &Gather, alive: Buf[bool], backs: Buf[Option[Back]], scoped: Scoped,
                extra: Buf[Event], parts: &PartsMemo, params: Set[string], owned: Set[string], tops: Set[string],
                i: usize) -> string
    val c = g.cands[i]

    if backs[i].is_none() then return fresh_reason(e, g, alive, backs, params, tops, c)

    val b = backs[i].unwrap()

    if !refused_since(g, alive, b, scoped, scoped.starts[c.from], parts, owned, tops) &&
       first_refusal(e, g, alive, b, extra, owned, tops) == "" then
        return ""

    if !explaining_borrows() then return "counted"

    // The scope in order: the list's statements from the candidate's on, its own expressions, the
    // list's result.
    var events: Buf[Event] = buf()
    val result_at = scoped.starts[scoped.starts.len() - 1]

    for j in scoped.starts[c.from]..<result_at
        events.push(scoped.events[j])

    for ev in extra
        events.push(ev)

    for j in result_at..<scoped.events.len()
        events.push(scoped.events[j])

    val said = first_refusal(e, g, alive, b, events, owned, tops)

    if said == "" then "counted" else said
end refusal

// Whether an event of the list at or after `from` refuses a candidate backed by `b`: the event-for-event
// test of `first_refusal`, asked of the list's last events.
private refused_since(g: &Gather, alive: Buf[bool], b: Back, s: Scoped, from: usize, parts: &PartsMemo,
                      owned: Set[string], tops: Set[string]) -> bool
    for r in b.roots
        if s.written_last.get(r).unwrap_or(0) > from then return true

        if tops.has(r) || owned.has(r)
            if s.used_last.get(r).unwrap_or(0) > from then return true

            var at = s.defs_first.get(r).unwrap_or(0)

            while at > 0 && s.defs_event[at - 1] >= from
                val d = s.events[s.defs_event[at - 1]].def_of

                if !g.index.get(d).map(j -> alive[j]).unwrap_or(false) then return true

                at = s.defs_next[at - 1]

    if s.opaque_last > from then return true

    for k in b.keys
        if s.keys_last.get(k.text).unwrap_or(0) > from then return true

        for p in parts.of(k)
            if named_since(s.within, s.within_at, s.within_last, p, from) then return true

        if named_since(s.counts, s.counts_at, s.counts_last, k.owner, from) ||
           named_since(s.counts, s.counts_at, s.counts_last, underlying(k.held), from) then
            return true

    false
end refused_since

// The first of `events` that refuses a candidate backed by `b`, as the report names it, or empty.
private first_refusal(e: *Emit, g: &Gather, alive: Buf[bool], b: Back, events: Buf[Event], owned: Set[string],
                      tops: Set[string]) -> string
    for r in b.roots
        val owns = tops.has(r) || owned.has(r)

        for ev in events
            if ev.root != r then continue

            if ev.written then return s"${ev.what} at ${line_col(e, ev.at)}"

            if owns
                val harmless = ev.def_of != "" && g.index.get(ev.def_of).map(j -> alive[j]).unwrap_or(false)

                if !harmless then return s"${ev.what} at ${line_col(e, ev.at)}"

    for ev in events
        if ev.root != "" then continue

        if ev.w.opaque != "" then return s"${ev.what} at ${line_col(e, ev.at)} runs code nobody can see (${ev.w.opaque})"

        for k in b.keys
            if writes_edge(ev.w, k) then return s"${ev.what} at ${line_col(e, ev.at)} may write ${edge_text(k)}"

            if ev.w.holds_count_of(k.owner) || ev.w.has_count(k.held) then
                return s"${ev.what} at ${line_col(e, ev.at)} may read the count of ${type_show(k.held)}"

    ""
end first_refusal

private fresh_reason(e: *Emit, g: &Gather, alive: Buf[bool], backs: Buf[Option[Back]], params: Set[string],
                     tops: Set[string], c: Cand) -> string
    // A value that arrives with a count by itself names the cause better than one read out of another
    // candidate that was refused for it.
    for d in c.defs
        val x = d match
            DValue(v) -> Some(v)
            DJump(v) -> Some(v)
            _ -> None

        if x.is_some() && fresh_arg(x.unwrap()) && def_back(g, alive, backs, params, tops, d).is_none() then
            return s"it is assigned a value with a count of its own at ${line_col(e, x.unwrap().span)}"
    end for

    for d in c.defs
        if def_back(g, alive, backs, params, tops, d).is_none()
            val at = d match
                DValue(x) -> x.span
                DJump(x) -> x.span
                DEntry(_) -> c.at
                DPart(subject, _) -> subject.span

            return s"it is assigned a value with a count of its own at ${line_col(e, at)}"

    "it is assigned a value with a count of its own"
end fresh_reason

private line_col(e: *Emit, at: Span) -> string = e.src match
    Some(src) ->
        val where = src.locate(at.start)

        s"${where.line}:${where.col + literate_shift(src)}"
    None -> "?"

// A local's name as the program wrote it.
private shown(name: string) -> string
    var n = 0usize

    for b in name.bytes
        if b == u8('$') || b == u8('#') || b == u8('%') || b == u8('.') || b == u8('@') then break

        n += 1

    if n == name.len then name else name[0..<n]
end shown

// -- the report --------------------------------------------------------------------------------------

// One line per candidate whose values are read out of storage: the +0 ones with their roots and
// edges, and the counted ones with the first thing that keeps them counted.
//
// A rewritten parameter's line names its function: borrowed throughout, borrowed on entry and owned
// after the first jump (the peel), or counted and why.
private note_locals(f: TFunc, g: &Gather, alive: Buf[bool], shaped: Buf[bool], why: Buf[string],
                    backs: Buf[Option[Back]], rewritten: Set[string], fresh: Set[string])
    if f.src.is_none() || is_closure_body(f) || std_module(f.declared_in) then return

    val src = f.src.unwrap()

    for i in 0..<g.cands.len()
        val c = g.cands[i]
        val param = rewritten.has(c.name)

        if !shaped[i] && !(param && fresh.has(c.name)) then continue

        val at = src.locate(c.at.start)
        val place = s"${src.name}:${at.line}:${at.col + literate_shift(src)}: "
        val head = if param then s"$place'${module_bare(f.name)}' parameter '${shown(c.name)}'" else s"$place'${shown(c.name)}'"
        val text = if alive[i] then s"$head holds no count: ${borrowed_from(backs[i])}"
                   else if param && fresh.has(c.name) then s"$head borrowed on entry; owned after the self-call at ${line_col_of(src, g.sites)} (fresh arguments)"
                   else s"$head is counted: ${why[i]}"

        // A generic body is lowered once per instance; its first instance speaks for the line.
        if pzl_seen.has(head) then continue

        pzl_seen.add(head)
        pzl_notes.push(LocalNote(src.name, c.at.start, text))
end note_locals

// Where the first of a body's self-jumps was written.
private line_col_of(src: Source, sites: Buf[Span]) -> string
    if sites.is_empty() then return "?"

    val where = src.locate(sites[0].start)

    s"${where.line}:${where.col + literate_shift(src)}"
end line_col_of

private borrowed_from(b: Option[Back]) -> string
    if b.is_none() then return "borrowed"

    var roots = ""

    for item in b.unwrap().roots
        roots = if roots == "" then s"'${shown(item)}'" else s"$roots, '${shown(item)}'"

    if roots == "" then return "it holds nothing counted"

    var keys = ""

    for item in b.unwrap().keys
        keys = if keys == "" then edge_text(item) else s"$keys, ${edge_text(item)}"

    if keys == "" then s"borrowed from $roots" else s"borrowed from $roots through $keys"
end borrowed_from

// -- held arguments ----------------------------------------------------------------------------------

// **An argument read out of storage needs no count of its own for its call** (`docs/design/
// borrow-inference.md` §4.4, decision 10; `tests_bla_held_args.sysl`).
//
// A caller takes a guarantee count for an argument its frame does not hold -- a field or an element
// read through a reference (`held`) -- only because the call might overwrite the storage the value was
// read out of and let it go. Where the argument is backed (§3) -- read along edge keys from roots the
// frame holds for the whole call: a local or parameter whose slot nothing reaches, a statement's
// temporary, or what a pointer parameter points at -- and neither the callee's edge-write summary
// (`edge_writes`, which follows everything it calls) nor the arguments worked out after it meet one
// of those keys, read a count of a type on the chain, or run code nobody can see, the edge still
// holds the value when the callee reads it, so the count could never have been the one keeping it
// alive. Leaving it out changes nothing a program prints or when anything is freed.
//
// **Only a borrowed parameter of a direct call** is asked: one the callee owns is handed a count,
// which it keeps (the count is genuine); an `async` callee's task and an `@abandons` callee outlive
// the frame; and a call through a table, a closure or a function value, or into C, has no summary.
// An argument crossing by address is a by-value promise about every byte, not only the counted ones,
// so it keeps today's snapshot.
//
// **A place call on the argument's spine is read with no count** (`place_entry.sysl`): its answer is
// backed by its argument along the path its one-expression body names (`place_back`), and the call is
// recorded for `gen_place_call` in `HeldArgs.lent_calls` while the argument is worked out. A call that
// answers a value of its own is a root: the statement's temporary holds it to after the call.
//
// **A pointer parameter's pointee is a root** only where nothing in the window can write an edge or
// hand over a value whose type reaches the pointee's: unlike a borrowed reference, the caller holds no
// count of it, so what keeps it alive is storage this frame cannot name.

// What the body being written lets an argument stand on: whether it was asked (`ready`, never in a
// task's body), the names no root may be and the `ref`-bound ones, its parameters, the pointer ones,
// the ones it owns, and the place calls of the argument being worked out that take no count.
struct HeldArgs
    ready: bool
    unrooted: Set[string]
    aliases: Set[string]
    params: Set[string]
    pointers: Set[string]
    owned: Set[string]
    lent_calls: Buf[(Span, string)]
end HeldArgs

held_args_none() -> HeldArgs = HeldArgs(false, set(), set(), set(), set(), set(), buf())

private held_args_for(f: TFunc, owned: Set[string]) -> HeldArgs
    val aliases = ref_names(f)
    var params: Set[string] = set()
    var pointers: Set[string] = set()

    for p in f.params
        params.add(p.0)

        repr(p.1) match
            Ptr(_, _) -> pointers.add(p.0)
            _ -> ()

    HeldArgs(true, unrootable(f, aliases), aliases, params, pointers, owned, buf())
end held_args_for

// Whether the place call to `name` at `at` is on the spine of an argument held for its call.
lent_place_call(e: *Emit, at: Span, name: string) -> bool
    for item in e.held_args.lent_calls
        if item.0 == at && item.1 == name then return true

    false
end lent_place_call

// What one argument's backing gathers beside the roots and keys: the types pointer roots point at,
// the place calls read with no count, and what the call's arguments assign.
private struct ArgWalk
    pointees: Buf[Type]
    calls: Buf[(Span, string)]
    written: Set[string]
end ArgWalk

private temp_back() -> Back = Back(set(), buf(), set(), false)

// **The `i`th argument of a direct call to `callee` held for the call with no count of its own**:
// the place calls on its spine to read with none, or `None` where it keeps the guarantee count.
// `borrows` is whether the parameter is one the callee borrows. Where `--explain-borrows` is on, an
// argument read through storage gets its line either way.
held_backed(e: *Emit, args: Buf[TExpr], i: usize, callee: string, written: Set[string],
            borrows: bool) -> Option[Buf[(Span, string)]]
    if !e.held_args.ready then return None

    val w: &ArgWalk = ArgWalk(buf(), buf(), written)
    val b = arg_back(e, w, args[i])?

    // A value with no edge between it and its roots is what `held` already judges.
    if b.keys.is_empty() && w.pointees.is_empty() then return None

    val why = arg_refusal(e, w, b, args, i, callee, borrows)

    if explaining_borrows() then note_argument(e, args[i], callee, why)

    if why != "" then None else Some(w.calls)
end held_backed

// Where an argument's value comes from at the moment it is read, or `None` where it is not read out of
// storage the frame can stand on. Only the spine is followed: a field, a dereference, an element at an
// index that changes nothing, a place call; anything that arrives with a count is a root of its own.
private arg_back(e: *Emit, w: &ArgWalk, x: TExpr) -> Option[Back] = *x.kind match
    TLoad(name, _) ->
        if e.held_args.unrooted.has(name) || !held_unless(e, x, w.written) then None else Some(back_root(name))
    TDeref(operand, _) -> repr(texpr_type(operand)) match
        Ref(_, sync) ->
            if sync then return None

            arg_back(e, w, operand).map(b -> Back(b.roots, b.keys, b.named, false))
        Ptr(inner, _) -> pointer_back(e, w, operand, *inner)
        _ -> None
    TField(r, i, _) ->
        val b = arg_back(e, w, r)?

        if b.frame then Some(b) else field_key(texpr_type(r), i).map(k -> back_key(b, k))
    TIndex(r, index, _) ->
        if !changes_nothing(index) then return None

        repr(texpr_type(r)) match
            Array(_, _, _) -> arg_back(e, w, r)
            Slice(elem, _) -> arg_back(e, w, r).map(b -> back_key(b, slot_key(*elem)))
            _ -> None
    TCall(name, args, _, _) -> call_back(e, w, x, name, args)
    TVCall(_, _, _, _, _) -> Some(temp_back())
    TCallPtr(_, _, _, _) -> Some(temp_back())
    TBox(_, _) -> Some(temp_back())
    _ -> None

// What a pointer parameter points at, as a root: nothing in this frame counts it.
private pointer_back(e: *Emit, w: &ArgWalk, operand: TExpr, pointee: Type) -> Option[Back] = *operand.kind match
    TLoad(name, _) ->
        if !e.held_args.pointers.has(name) || e.held_args.unrooted.has(name) || !held_unless(e, operand, w.written) then
            return None

        w.pointees.push(underlying(pointee))
        Some(Back(back_root(name).roots, buf(), set(), false))
    _ -> None

// A call on the spine: read through its place entry where the call will use one and its body's place
// is backed, the value the statement's temporary holds otherwise.
private call_back(e: *Emit, w: &ArgWalk, x: TExpr, name: string, args: Buf[TExpr]) -> Option[Back]
    val c = place_call_target(e, name, args) match
        Some(found) -> found
        None -> return Some(temp_back())

    val mark = w.calls.len()
    val inner = arg_back(e, w, args[c.1])

    if inner.is_some()
        var env: Buf[(string, Back)] = buf()

        env.push((c.0.params[c.1].0, inner.unwrap()))

        val b = place_back(e, c.0.body.result.unwrap(), env)

        if b.is_some()
            w.calls.push((x.span, name))
            return b
    end if

    while w.calls.len() > mark
        w.calls.pop()

    Some(temp_back())
end call_back

// The backing of a place body's answer, its parameters' backings in `env` (`place_entry.sysl`'s
// `place_shape`): a field chain, an element of a fixed array, a referent, a payload a `match` binds,
// or another place call.
private place_back(e: *Emit, x: TExpr, env: Buf[(string, Back)]) -> Option[Back] = *x.kind match
    TLoad(name, _) ->
        var k = env.len()

        while k > 0
            k -= 1

            if env[k].0 == name then return Some(env[k].1)

        None
    TField(r, i, _) ->
        val b = place_back(e, r, env)?

        if b.frame then Some(b) else field_key(texpr_type(r), i).map(k -> back_key(b, k))
    TIndex(r, _, _) -> repr(texpr_type(r)) match
        Array(_, _, _) -> place_back(e, r, env)
        _ -> None
    TDeref(operand, _) -> repr(texpr_type(operand)) match
        Ref(_, sync) -> if sync then None else place_back(e, operand, env).map(b -> Back(b.roots, b.keys, b.named, false))
        _ -> None
    TBlockExpr(b) -> if b.stmts.is_empty() && b.result.is_some() then place_back(e, b.result.unwrap(), env) else None
    TCall(name, args, _, _) ->
        val c = e.places.get(name)?
        val inner = place_back(e, args[c.1], env)?
        var next: Buf[(string, Back)] = buf()

        next.push((c.0.params[c.1].0, inner))
        place_back(e, c.0.body.result.unwrap(), next)
    TMatch(scrutinee, arms, _) ->
        val s = place_back(e, scrutinee, env)?
        var out: Option[Back] = None

        for arm in arms
            if ends_program(arm.body.ty) then continue
            if arm.patterns.len() != 1 || arm.body.result.is_none() then return None

            var inner: Buf[(string, Back)] = buf()

            for item in env
                inner.push(item)

            bind_back(s, arm.patterns[0], &inner)

            val one = place_back(e, arm.body.result.unwrap(), inner)?

            out = if out.is_none() then Some(one) else Some(back_join(out.unwrap(), one))

        out
    _ -> None

private ends_program(t: Type) -> bool = t match
    Never -> true
    _ -> false

// The names a flat pattern binds out of a subject backed by `s`: the whole of it, or a payload field.
private bind_back(s: Back, p: TPattern, env: *Buf[(string, Back)]) = p match
    TBindPattern(name, _) -> env.push((name, s))
    TVariantPattern(enum_ty, variant, args) ->
        for i in 0..<args.len()
            if i >= variant.fields.len() then break

            val field = variant.fields[i]

            args[i] match
                TBindPattern(name, _) ->
                    env.push((name, if s.frame then s else back_key(s, edge_key(enum_ty, s"${variant.name}.${field.0}",
                                                                                 field.1))))
                _ -> ()
    _ -> ()

// Why the argument must keep its count, or empty where it need not.
private arg_refusal(e: *Emit, w: &ArgWalk, b: Back, args: Buf[TExpr], i: usize, callee: string,
                    borrows: bool) -> string
    val f = callee_shown(callee)

    if !borrows
        if e.asyncs.has(callee) then return s"'$f' is async: its task outlives the call"
        if e.abandoning.has(callee) then return s"'$f' abandons the frame"

        return s"'$f' keeps it"
    end if

    // A root handed over to the callee by another argument may be let go inside the call; so may what
    // a pointer root points at, through a value handed over whose type reaches it.
    for j in 0..<args.len()
        if j == i || !e.owned_params.has(owned_key(callee, j)) then continue

        for r in b.roots
            if mentions(args[j], r) then return s"the root '${shown(r)}' is handed to '$f'"

        for t in w.pointees
            if type_reaches(texpr_type(args[j]), t) then return s"a value reaching ${type_show(t)} is handed to '$f'"

    val said = kills(e, w, b, edge_writes(&e.untouched, callee), s"'$f'")

    if said != "" then return said

    // What the arguments after it do between the read and the call.
    for j in i + 1..<args.len()
        val g: &Gather = Gather(buf(), map(), set(), buf())
        val sink: &EventSink = EventSink(buf(), buf(), buf())
        val walk = TWalk(true, x -> event_node(e, g, sink, e.held_args.aliases, b.roots, set(), x),
                         w2 -> event_write(e, g, sink, e.held_args.aliases, b.roots, set(), w2),
                         s -> event_stmt(e, g, sink, s))

        walk_texpr(args[j], walk)

        for ev in sink.events
            if ev.root != ""
                val counted = !e.held_args.params.has(ev.root) || e.held_args.owned.has(ev.root)

                if ev.written || counted && !e.lent_decls.has(ev.root) then return s"${ev.what} at ${line_col(e, ev.at)}"

                continue
            end if

            val one = kills(e, w, b, ev.w, s"${ev.what} at ${line_col(e, ev.at)}")

            if one != "" then return one

    ""
end arg_refusal

// What a summary `cw` (a callee's, or a later argument's store or call, named `what`) does to the chain.
private kills(e: *Emit, w: &ArgWalk, b: Back, cw: EdgeWrites, what: string) -> string
    if cw.opaque != "" then return s"$what runs code nobody can see (${cw.opaque})"

    for k in b.keys
        if writes_edge(cw, k) then return s"$what may write ${edge_text(k)}"

        if has_type(cw.counts, k.owner) || has_type(cw.counts, underlying(k.held)) then
            return s"$what may read the count of ${type_show(k.held)}"

    for t in w.pointees
        for k in cw.keys
            if type_reaches(k.held, t) then return s"$what may write ${edge_text(k)}, which may reach ${type_show(t)}"

        for item in cw.within
            if type_reaches(item, t) then return s"$what may write through a pointer to ${type_show(item)}"

        for item in cw.counts
            if type_reaches(item, t) then return s"$what may read the count of ${type_show(item)}"

    ""
end kills

// Whether `x` names the local `name` anywhere inside it.
private mentions(x: TExpr, name: string) -> bool
    val v: &Verdict = Verdict(true)

    walk_texpr(x, expr_walk(true, n -> *n.kind match
        TLoad(m, _) -> if m == name then v.refuse()
        _ -> ()))

    !v.ok
end mentions

// Whether a value of `from` may hold, or reach through what it refers to, storage of type `target`.
// A type nobody can see inside -- a trait object, a closure, a generic parameter -- may reach anything.
private type_reaches(from: Type, target: Type) -> bool
    val goal = underlying(target)
    var seen: Buf[Type] = buf()
    var todo: Buf[Type] = buf()

    todo.push(underlying(from))

    while !todo.is_empty()
        val t = todo.pop().unwrap()

        if has_type(seen, t) then continue
        if seen.len() > 256 then return true

        seen.push(t)

        var parts: Buf[Type] = buf()

        by_value_parts(t, &parts)

        for p in parts
            if p == goal then return true

            p match
                Ref(inner, _) -> todo.push(underlying(*inner))
                Ptr(inner, _) -> todo.push(underlying(*inner))
                Weak(inner) -> todo.push(underlying(*inner))
                Volatile(inner) -> todo.push(underlying(*inner))
                Slice(elem, _) -> todo.push(underlying(*elem))
                Trait(_, _, _) -> return true
                Abstract(_, _) -> return true
                Unknown -> return true
                _ -> ()
    end while

    false
end type_reaches

// The argument's `--explain-borrows` line: held, or the first thing that keeps its count.
private note_argument(e: *Emit, x: TExpr, callee: string, why: string)
    val f = e.body_func match
        Some(found) -> found
        None -> return

    if f.src.is_none() || is_closure_body(f) || std_module(f.declared_in) then return

    val src = f.src.unwrap()
    val at = src.locate(x.span.start)
    val name = callee_shown(callee)
    val head = s"${src.name}:${at.line}:${at.col + literate_shift(src)}: argument '${arg_text(x)}' of '$name'"
    val text = if why == "" then s"$head needs no count: '$name' writes no field on its way"
               else s"$head takes a count: $why"

    if pzl_seen.has(head) then return

    pzl_seen.add(head)
    pzl_notes.push(LocalNote(src.name, x.span.start, text))
end note_argument

// An argument as the report shows it: the names and fields it reads, `[_]` for an element.
private arg_text(x: TExpr) -> string = *x.kind match
    TLoad(name, _) -> shown(name)
    TField(r, i, _) -> s"${arg_text(r)}.${field_label(texpr_type(r), i)}"
    TDeref(r, _) -> arg_text(r)
    TIndex(r, _, _) -> s"${arg_text(r)}[_]"
    TCall(name, args, _, _) ->
        val receiver = if args.is_empty() then "…" else arg_text(args[0])

        if receiver == "…" then s"${callee_shown(name)}(…)" else s"$receiver.${callee_shown(name)}()"
    _ -> "…"

// A callee as the program wrote it: a function the entry file's statements reach through their
// environment is lowered as `$env0.both`, and a reader wrote `both`.
private callee_shown(name: string) -> string
    val b = name.bytes

    for k in 0..<b.len
        if b[k] == u8('$') && name[k..<name.len].starts_with("$env")
            var j = k + 4

            while j < b.len && b[j] >= u8('0') && b[j] <= u8('9')
                j += 1

            if j < b.len && b[j] == u8('.') then return method_name(name[j + 1..<name.len])

    method_name(name)
end callee_shown

private field_label(t: Type, i: int) -> string = underlying(t) match
    Struct(d) -> if i >= 0 && usize(i) < d.fields.len() then d.fields[usize(i)].0 else s"$i"
    Results(d) -> if i >= 0 && usize(i) < d.fields.len() then d.fields[usize(i)].0 else s"$i"
    _ -> s"$i"
