module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.math.bigint.{BigInt, from_int}
import sysl.slices.sort_by

// **What a pattern tests, and what it binds** -- the two halves of an arm, kept apart because they
// happen at different moments: a binding is established only once the arm has been taken, and a
// guard runs between the two.

// The `i1` result of testing a pattern against a value. Every pattern node carries the type it tests
// at, so the value's type does not have to be passed alongside it.
//
// A variant's payload is tested **behind** its tag rather than beside it. The payload is only this
// variant's while the tag says so, so reading it out of a value that turned out to be another
// variant reinterprets whatever that other variant stored.
pattern_test(e: *Emit, p: TPattern, value: Val) -> Val = p match
    TWildPattern(_) -> VBool(true)
    TBindPattern(_, _) -> VBool(true)

    // The binding is established later; what decides the arm is the inner test alone, since naming a
    // value says nothing about whether it matched.
    TAtPattern(_, inner) -> pattern_test(e, *inner, value)
    TLitPattern(v) -> compare_value(e, "==", underlying(texpr_type(v)), value, gen_expr(e, v))
    TRangePattern(lo, hi, inclusive) ->
        val lo_ok = compare_value(e, ">=", underlying(texpr_type(lo)), value, gen_expr(e, lo))
        val hi_ok = compare_value(e, if inclusive then "<=" else "<", underlying(texpr_type(hi)),
                                  value, gen_expr(e, hi))

        and_i1(e, lo_ok, hi_ok)
    TVariantPattern(enum_ty, variant, args) -> variant_test(e, enum_ty, variant, args, value)

    // A struct has no tag, so the test is just its refutable fields' tests ANDed together.
    TStructPattern(decl, args) ->
        var acc: Val = VBool(true)

        for i in 0..<args.len()
            if refutable(args.at(i))
                acc = and_i1(e, acc, pattern_test(e, args.at(i), struct_field(e, decl, value, i)))

        acc

private variant_test(e: *Emit, enum_ty: Type, variant: EnumVariant, args: Buf[TPattern],
                     value: Val) -> Val
    val d = enum_decl(enum_ty) match
        Some(decl) -> decl
        None -> return gap_at(e, "a variant pattern on something that is not an enum")

    val tag_val = tag_of(e, d, value)

    val tag_ok = fresh_reg(e)

    emit(e, InIntCmp(tag_ok, IEq, enum_tag_lty(d, e.word_bits), tag_val, VInt(variant.tag)))

    if !any_refutable(args) then return tag_ok

    // The tag decides whether the payload may be read at all, so its test is a branch and not an
    // operand of an `and`: the block below runs only for a value of this variant.
    val answer = alloca(e, fresh_reg(e), l_i1())
    val test_l = fresh_label(e, "pat.payload")
    val done_l = fresh_label(e, "pat.done")

    emit(e, InStore(l_i1(), VBool(false), answer, AccPlain, None))
    emit_term(e, InCondBr(tag_ok, test_l, done_l))
    emit_label(e, test_l)

    val payload = enum_payload(e, d, variant, value)

    var inner: Val = VBool(true)

    for i in 0..<args.len()
        if refutable(args.at(i))
            inner = and_i1(e, inner, pattern_test(e, args.at(i),
                                                  payload_field(e, d, variant, payload, i)))

    emit(e, InStore(l_i1(), inner, answer, AccPlain, None))
    emit_term(e, InBr(done_l))
    emit_label(e, done_l)

    val r = fresh_reg(e)

    emit(e, InLoad(r, l_i1(), answer, AccPlain, None))
    r
end variant_test

// A value's tag: the value itself where the enum is simple, and the first slot otherwise.
private tag_of(e: *Emit, d: &EnumType, value: Val) -> Val
    if d.simple then return value

    extracted_tag(e, d, value)
end tag_of

private extracted_tag(e: *Emit, d: &EnumType, value: Val) -> Val
    val t = fresh_reg(e)

    emit(e, InExtract(t, enum_lty(d), value, index_list(0)))
    t
end extracted_tag

// Establishes the bindings a pattern introduces, once its arm has been taken. Only binding and
// (nested) variant patterns carry bindings; the rest do nothing.
pattern_bind(e: *Emit, p: TPattern, value: Val) = p match
    // A zero-sized binding is not a slot, exactly as a `var` of one is not. The name is still in
    // scope for the arm; every read of it yields nothing.
    //
    // The name takes a share of what it is bound to and the arm gives it back where it ends, which
    // is what makes a `&T` destructured out of a variant outlive the value it was read from.
    TBindPattern(name, bty) ->
        if !zero_sized(bty)
            val home = local_alloca(e, name, lty(e, bty))

            retain_value(e, bty, value)
            emit(e, InStore(lty(e, bty), value, home, AccPlain, None))
            own_slot(e, name, bty)

    // `n @ pat` binds the whole value and then whatever the inner pattern binds, both off the same
    // value -- so a `&T` matched this way is retained once for the outer name and once for each
    // inner one, which is what every other pattern that names a value more than once already does.
    TAtPattern(name, inner) ->
        pattern_bind(e, TBindPattern(name, tpattern_type(*inner)), value)
        pattern_bind(e, *inner, value)

    TVariantPattern(enum_ty, variant, args) ->
        if any_binds(args)
            enum_decl(enum_ty) match
                Some(d) ->
                    val payload = enum_payload(e, d, variant, value)

                    for i in 0..<args.len()
                        pattern_bind(e, args.at(i), payload_field(e, d, variant, payload, i))
                None -> gap_here(e, "a variant binding on something that is not an enum")

    TStructPattern(decl, args) ->
        for i in 0..<args.len()
            if binds_any(args.at(i))
                pattern_bind(e, args.at(i), struct_field(e, decl, value, i))

    _ -> ()

// One field of a variant's payload, or nothing where the field is zero-sized -- the same skipping
// the layout does, seen from the reading side.
private payload_field(e: *Emit, d: &EnumType, v: EnumVariant, payload: Val, i: usize) -> Val
    if zero_sized(v.fields.at(i).1) then return VNothing

    val fv = fresh_reg(e)

    emit(e, InExtract(fv, variant_lty(d, v), payload, index_list(variant_field_index(e.layout, v, v.slot(i)))))
    fv
end payload_field

// One field of a struct being destructured -- a bit range of the container where the struct is a
// bitfield struct, and a slot of the aggregate otherwise.
private struct_field(e: *Emit, d: &StructType, value: Val, i: usize) -> Val
    if zero_sized(d.fields.at(i).1) then return VNothing

    bitfield_ranges(d) match
        Some(ranges) ->
            val c = fresh_reg(e)

            emit(e, InExtract(c, struct_lty(d), value, index_list(0)))
            read_bits(e, ranges, ranges.at(d.slot(i)), reordered(e, container_reversal(d, e.target.little_endian()), c))
        None ->
            val fv = fresh_reg(e)

            emit(e, InExtract(fv, struct_lty(d), value, index_list(struct_field_index(e.layout, d, d.slot(i)))))
            reordered(e, reversed_width(d, d.fields.at(i).1, e.target.little_endian()), fv)
end struct_field

// Whether a pattern introduces a name.
binds_any(p: TPattern) -> bool = p match
    TBindPattern(_, _) -> true
    TAtPattern(_, _) -> true
    TVariantPattern(_, _, args) -> any_binds(args)
    TStructPattern(_, args) -> any_binds(args)
    _ -> false

private any_binds(args: Buf[TPattern]) -> bool
    for arg in args
        if binds_any(arg) then return true

    false
end any_binds

// Whether any of a pattern's parts needs a run-time test. `refutable` in `pattern.sysl` is the one
// that answers for a single pattern, and this is its list form -- the exhaustiveness check and the
// emitter ask the same question of the same tree.
private any_refutable(args: Buf[TPattern]) -> bool
    for arg in args
        if refutable(arg) then return true

    false
end any_refutable

// -- a whole `match` ---------------------------------------------------------------------------------

// A `match`: one `switch` where the scrutinee's tag alone decides the arm, and every arm tested in
// turn otherwise.
//
// `into` is the storage a large value is going to, where it has one, which each arm builds its value
// in (`Merge`). `held` is the address the scrutinee was already written at and is owned at, by a
// caller that needed it before the `match` ran (`match_in_place`); `in_place` is that caller's
// destination being the moved payload inside it.
gen_match(e: *Emit, scrutinee: TExpr, arms: Buf[TArm], ty: Type, into: Option[Val] = None,
          held: Option[Val] = None, in_place: bool = false) -> Val
    // An arm that hands a large payload back unchanged reads it through the scrutinee's address
    // (`payload_move`), so that address is taken where some arm can use it. A local's is free, and no
    // arm writes anything before it reads. A large call's or branch's result is written into a slot
    // and owned there (`address`) -- the one copy of it there has to be -- instead of being produced
    // as a value, stored again for a payload to be read out of, and bound a third time.
    val sty = texpr_type(scrutinee)
    val moving = e.layout.indirect(sty) && any_moves(e, arms, into.is_some())
    var sv: Val = VNothing
    var at: Option[Val] = held

    held match
        Some(h) -> sv = load_held(e, h, sty, arms, into.is_some())
        None ->
            if moving && is_load(scrutinee)
                sv = gen_expr(e, scrutinee)
                at = Some(address(e, scrutinee))
            else if moving && makes_owned(scrutinee)
                val h = address(e, scrutinee)

                sv = load_held(e, h, sty, arms, into.is_some())
                at = Some(h)
            else
                sv = gen_expr(e, scrutinee)

    val end_l = fresh_label(e, "match.end")
    val slot = merge_for(e, ty, into, in_place)

    tag_switch(arms) match
        Some(d) -> gen_tag_switch(e, d, sv, at, ty, slot, end_l)
        None -> gen_arm_chain(e, arms, sv, at, ty, slot, end_l)

    emit_label(e, end_l)
    ends_nowhere(e, ty)

    // The arms each took a count for what they stored, so what comes out of the slot is a value the
    // enclosing statement owns and releases where its region ends.
    merged_value(e, slot, ty)
end gen_match

private is_load(x: TExpr) -> bool = *x.kind match
    TLoad(_, _) -> true
    _ -> false

// Whether an arm writes its payload through the scrutinee's address rather than binding it: one that
// is boxed always does, and an unboxed one where the `match` has a destination to write it to.
private moves(e: *Emit, arm: TArm, into: bool) -> bool = moved_payload(e, arm) match
    Some(m) -> m.boxed_as.is_some() || into
    None -> false

private any_moves(e: *Emit, arms: Buf[TArm], into: bool) -> bool
    for item in arms
        if moves(e, item, into) then return true

    false
end any_moves

// The scrutinee as the value the pattern tests read, out of the slot that owns it: borrowed, the
// slot's count being the one released.
//
// Where no arm reads anything but the tag -- each one moves its payload through the address, or tests
// a variant without binding or testing what it carries -- only the tag is loaded, into an otherwise
// empty value of the enum's type: loading the whole of it would be the second copy of the result this
// exists to avoid, left to the optimizer to notice it is dead.
private load_held(e: *Emit, at: Val, ty: Type, arms: Buf[TArm], into: bool) -> Val
    val r = fresh_reg(e)

    enum_decl(ty) match
        Some(d) ->
            if !d.simple && tags_only(e, arms, into)
                val tag = fresh_reg(e)

                emit(e, InLoad(tag, l_i32(), at, AccPlain, None))
                emit(e, InInsert(r, enum_lty(d), VPoison, l_i32(), tag, index_list(0)))
                return r
            end if
        None -> ()

    emit(e, InLoad(r, lty(e, ty), at, AccPlain, None))
    r
end load_held

private tags_only(e: *Emit, arms: Buf[TArm], into: bool) -> bool
    for arm in arms
        if !moves(e, arm, into)
            for j in 0..<arm.patterns.len()
                if !tag_only(arm.patterns.at(j)) then return false

    true
end tags_only

private tag_only(p: TPattern) -> bool = p match
    TWildPattern(_) -> true
    TVariantPattern(_, _, args) -> !any_binds(args) && !any_refutable(args)
    _ -> false

// What an arm that hands back one large payload unchanged moves: `V(x) -> x`, or `V(x) -> x` boxed
// into a `&T` by the type the `match` was expected at. Nothing in such an arm runs between the binding
// and the read, so no binding is visible to miss -- an arm that does anything else with `x` (takes
// its address, binds a `ref` to it, passes it on) is not this shape and binds it.
struct Moved
    d: &EnumType
    variant: EnumVariant
    index: usize
    boxed_as: Option[Type]

moved_payload(e: *Emit, arm: TArm) -> Option[Moved]
    if arm.guard.is_some() || !arm.body.stmts.is_empty() || arm.patterns.len() != 1 ||
       arm.body.result.is_none() then
        return None

    var boxed_as: Option[Type] = None

    val x = *arm.body.result.unwrap().kind match
        TLoad(n, _) -> n
        TBox(value, ref_ty) -> *value.kind match
            TLoad(n, _) ->
                boxed_as = Some(ref_ty)
                n
            _ -> return None
        _ -> return None

    arm.patterns.at(0) match
        TVariantPattern(enum_ty, variant, args) ->
            val d = enum_decl(enum_ty) match
                Some(found) -> found
                None -> return None

            if d.simple then return None

            var named: Option[usize] = None

            for i in 0..<args.len()
                args.at(i) match
                    TBindPattern(n, _) ->
                        if n != x || named.is_some() then return None

                        named = Some(i)
                    TWildPattern(_) -> ()
                    _ -> return None

            if named.is_none() then return None

            val i = named.unwrap()

            if !e.layout.indirect(variant.fields.at(i).1) then return None

            Some(Moved(d, variant, i, boxed_as))
        _ -> None
end moved_payload

// The address of the moved payload inside the scrutinee's storage at `src`, named `p`.
payload_at(e: *Emit, m: Moved, src: Val, p: Val)
    var idx: Buf[IrArg] = buf()

    idx.push(ir_arg(l_i32(), VInt(from_int(0))))
    idx.push(ir_arg(l_i32(), VInt(from_int(long(variant_field_index(e.layout, m.variant,
                                                                     m.variant.slot(m.index)))))))
    emit(e, InGep(p, variant_lty(m.d, m.variant), payload_ptr(e, m.d, src), idx))
end payload_at

// What a `match` is when the scrutinee's discriminant alone decides the arm: the enum it is read
// off, each arm with the tags that select it, and a trailing catch-all where there is one.
struct TagDispatch
    en: &EnumType
    arms: Buf[(TArm, Buf[BigInt])]
    catch_all: Option[TArm]
end TagDispatch

// Recognises the `match` that lowers to ONE `switch`, and answers `None` for every other shape --
// which then goes through `gen_arm_chain`.
//
// The chain tests one arm at a time, so the arm an input selects is decided by a run of comparisons
// whose length is the arm's position in the source. For a match over a tag that is not even true --
// the tag names the arm outright -- and folding the chain back into a `switch` is left to an
// optimizer with a budget, so an arm written late enough pays an extra unpredictable branch on
// every execution. Emitting the `switch` outright says what the match means in one instruction.
//
// **The form is recognised rather than assumed, and the conditions are what make the tag
// sufficient.** Every arm must test a variant's tag and nothing else, so that no arm can fail after
// the switch has branched to it -- a refutable payload pattern or a guard can, and those need the
// chain's fall-through. Two arms claiming one tag would need source order to break the tie. Any of
// the three falls back to the chain.
private tag_switch(arms: Buf[TArm]) -> Option[TagDispatch]
    if arms.is_empty() then return None

    for item in arms
        if item.guard.is_some() then return None

    val last = arms.at(arms.len() - 1)
    val catch_all = if last.patterns.len() == 1 && !refutable(last.patterns.at(0)) then Some(last)
    else None

    val tagged_n = if catch_all.is_some() then arms.len() - 1 else arms.len()

    if tagged_n == 0 then return None

    var en: Option[Type] = None
    var seen: Buf[BigInt] = buf()
    var out: Buf[(TArm, Buf[BigInt])] = buf()

    for i in 0..<tagged_n
        val arm = arms.at(i)
        var tags: Buf[BigInt] = buf()

        for item in arm.patterns
            val v = switch_variant(item) match
                Some(found) -> found
                None -> return None

            if en.is_none() then en = Some(v.0)
            else if en.unwrap() != v.0 then return None

            for k in 0..<seen.len()
                if seen.at(k) == v.1 then return None

            seen.push(v.1)
            tags.push(v.1)

        out.push((arm, tags))

    val d = enum_decl(en.unwrap()) match
        Some(decl) -> decl
        None -> return None

    Some(TagDispatch(d, out, catch_all))
end tag_switch

// The enum and tag a pattern decides on, where the tag is the whole of the test. `n @ V(x)` decides
// on the same tag `V(x)` does; the outer name is bound off the whole value after the branch.
private switch_variant(p: TPattern) -> Option[(Type, BigInt)] = p match
    TVariantPattern(enum_ty, variant, args) ->
        if any_refutable(args) then None else Some((enum_ty, variant.tag))
    TAtPattern(_, inner) -> switch_variant(*inner)
    _ -> None

// One `switch` on the discriminant, and one block per arm. The default edge carries what the chain's
// fallthrough carried: the catch-all arm where the match has one, and otherwise the `unreachable` an
// exhaustive match ends in -- for a statement match too, wherever the table names every variant.
private gen_tag_switch(e: *Emit, d: TagDispatch, sv: Val, at: Option[Val], ty: Type, slot: Merge,
                       end_l: string)
    val tag_val = tag_of(e, d.en, sv)

    var arm_ls: Buf[string] = buf()

    for i in 0..<d.arms.len()
        arm_ls.push(fresh_label(e, "match.arm"))

    val none_l = if d.catch_all.is_some() then fresh_label(e, "match.arm")
    else if no_value(ty) && !every_variant(d) then end_l
    else fresh_label(e, "match.none")

    var table: Buf[(BigInt, string)] = buf()

    for i in 0..<d.arms.len()
        val tags = d.arms.at(i).1

        for item in tags
            table.push((item, arm_ls.at(i)))

    emit_term(e, InSwitch(enum_tag_lty(d.en, e.word_bits), tag_val, none_l, table))

    for i in 0..<d.arms.len()
        emit_label(e, arm_ls.at(i))
        gen_arm_body(e, d.arms.at(i).0, sv, at, ty, slot, end_l)

    d.catch_all match
        Some(arm) ->
            emit_label(e, none_l)
            gen_arm_body(e, arm, sv, at, ty, slot, end_l)
        None ->
            if none_l != end_l
                emit_label(e, none_l)
                emit_term(e, InUnreachable)
end gen_tag_switch

// Whether the switch has a case for every variant of its enum, so that its default edge can only be
// taken by a value holding no variant at all. A match over an enum is held to exhaustiveness
// wherever it stands, so a statement match with no catch-all names every variant and its default is
// exactly as impossible as a value match's. The coverage is read off the table rather than trusted,
// so a switch that somehow lacks a variant keeps its fall-through.
private every_variant(d: TagDispatch) -> bool
    if d.en.variants.is_empty() then return false

    for item in d.en.variants
        val tag = item.tag
        var covered = false

        for j in 0..<d.arms.len()
            val tags = d.arms.at(j).1

            for k in 0..<tags.len()
                if tags.at(k) == tag then covered = true

        if !covered then return false

    true
end every_variant

// An arm's bindings and body, in the block the branch to it has already opened. Only a single
// pattern may bind, which is what makes one block serve several tags.
private gen_arm_body(e: *Emit, arm: TArm, sv: Val, at: Option[Val], ty: Type, slot: Merge,
                     end_l: string)
    push_owned(e)

    if !payload_move(e, arm, slot, at)
        if arm.patterns.len() == 1 then pattern_bind(e, arm.patterns.at(0), sv)

        if no_value(ty) then gen_block_void(e, arm.body)
        else store_merged(e, arm.body, ty, slot)

    pop_owned(e)
    emit_term(e, InBr(end_l))
end gen_arm_body

// Every other `match`: each arm tested in turn, falling through to the next one when its pattern or
// its guard says no. The pattern decides whether the arm is entered, the bindings are made once it
// is, and a guard runs between the two.
private gen_arm_chain(e: *Emit, arms: Buf[TArm], sv: Val, at: Option[Val], ty: Type, slot: Merge,
                      end_l: string)
    var i: usize = 0

    while i < arms.len()
        val run = string_run(arms, i)

        if run >= table_threshold()
            gen_string_table(e, arms, i, i + run, sv, at, ty, slot, end_l)
            i += run
        else
            gen_chain_arm(e, arms.at(i), sv, at, ty, slot, end_l)
            i += 1

    // Fallthrough with no matching arm: a value or enum match is exhaustive, so this point is
    // unreachable; a plain scalar statement match simply proceeds.
    if no_value(ty) then emit_term(e, InBr(end_l)) else emit_term(e, InUnreachable)
end gen_arm_chain

// One arm of the chain: its test, its guard where it has one, and its body, ending at the label the
// next arm is tested under.
private gen_chain_arm(e: *Emit, arm: TArm, sv: Val, at: Option[Val], ty: Type, slot: Merge,
                      end_l: string)
    val body_l = fresh_label(e, "match.arm")
    val next_l = fresh_label(e, "match.next")

    var pat_cond: Val = pattern_test(e, arm.patterns.at(0), sv)

    for j in 1..<arm.patterns.len()
        pat_cond = or_i1(e, pat_cond, pattern_test(e, arm.patterns.at(j), sv))

    // **An arm's bindings are its own ownership region.** A name bound out of the scrutinee holds a
    // share of what it names, and the arm is where that share goes back -- so the region opens where
    // the bindings are made and closes where the arm hands its value over.
    //
    // An arm that only hands a payload back has done all of its work once it is written.
    var moved = false

    arm.guard match
        None ->
            emit_term(e, InCondBr(pat_cond, body_l, next_l))
            emit_label(e, body_l)
            push_owned(e)

            moved = payload_move(e, arm, slot, at)

            if !moved && arm.patterns.len() == 1 then pattern_bind(e, arm.patterns.at(0), sv)
        Some(g) ->
            val guard_l = fresh_label(e, "match.guard")

            emit_term(e, InCondBr(pat_cond, guard_l, next_l))
            emit_label(e, guard_l)
            push_owned(e)

            if arm.patterns.len() == 1 then pattern_bind(e, arm.patterns.at(0), sv)

            push_temps(e)

            val gv = gen_expr(e, g)

            pop_temps(e)

            // A guard that fails leaves an arm whose bindings were already made, so they are given
            // back before falling through to the next one.
            val unbind_l = fresh_label(e, "match.unbind")

            emit_term(e, InCondBr(gv, body_l, unbind_l))
            emit_label(e, unbind_l)
            release_owned(e)
            emit_term(e, InBr(next_l))
            emit_label(e, body_l)

    if !moved
        if no_value(ty) then gen_block_void(e, arm.body)
        else store_merged(e, arm.body, ty, slot)

    pop_owned(e)
    emit_term(e, InBr(end_l))
    emit_label(e, next_l)
end gen_chain_arm

// **A long run of string-literal arms is one search and one `switch`, not a chain of comparisons.**
// The chain asks `==` once per arm, so an input reaching the last of N arms pays N comparisons, and
// LLVM's passes over a body holding thousands of them are worse than linear: 4,000 arms took twelve
// seconds of `-O1`. Laid down as a sorted constant table, the run is one binary search
// (`sysl.str.search`, asking the comparison `==` asks) answering the entry's position, and one
// `switch` on that position to the arm it belongs to -- which LLVM makes a jump table.
//
// **The meaning is the chain's.** Only arms whose every pattern is a string literal and which carry
// no guard are taken, so nothing in the run can fail after the branch to it; the arms around the run
// keep their order, the switch's default edge going on to whatever follows. An input written in two
// arms of the run is the first one's, as the chain tested the first one first. A short run keeps the
// chain, whose few comparisons the optimizer folds.
const string_table_arms: usize = 16

// A run length a test stands in for `string_table_arms` with (`pin_string_table_arms`; `None` puts
// the constant back). The own-tree sweep pins it past every run this tree writes, so this compiler
// lowers its own sources with the chain the reference emits and the comparison stays exact.
private var string_table_pinned: Option[usize] = None

private table_threshold() -> usize = string_table_pinned match
    Some(n) -> n
    None -> string_table_arms

pin_string_table_arms(n: Option[usize])
    string_table_pinned = n

// How many arms from `from` on form a run the table can answer.
private string_run(arms: Buf[TArm], from: usize) -> usize
    var n: usize = 0

    while from + n < arms.len() && table_arm(arms.at(from + n))
        n += 1

    n
end string_run

private table_arm(arm: TArm) -> bool
    if arm.guard.is_some() then return false

    for item in arm.patterns
        if string_literal(item).is_none() then return false

    true
end table_arm

// The string a pattern compares against, where it is a string literal and nothing else.
private string_literal(p: TPattern) -> Option[string] = p match
    TLitPattern(v) ->
        if underlying(texpr_type(v)) != Str then None
        else *v.kind match
            TStrLit(s) -> Some(s)
            _ -> None
    _ -> None

// The arms `from..<to` dispatched through one table. Each string is entered once, for the first arm
// that names it; an arm none of whose strings survives is unreachable, and its label is opened with
// nothing branching to it, so emission stays suppressed through its body as it would for any other
// block nothing reaches.
private gen_string_table(e: *Emit, arms: Buf[TArm], from: usize, to: usize, sv: Val,
                         at: Option[Val], ty: Type, slot: Merge, end_l: string)
    var entries: Buf[(string, usize)] = buf()

    for k in from..<to
        val arm = arms.at(k)

        for item in arm.patterns
            entries.push((string_literal(item).unwrap(), k - from))

    sort_by(entries.view(), (a, b) -> a.0 < b.0 || (a.0 == b.0 && a.1 < b.1))

    var keys: Buf[IrArg] = buf()
    var owners: Buf[usize] = buf()
    var last: Option[string] = None

    for entry in entries
        if last.is_none() || last.unwrap() != entry.0
            keys.push(ir_arg(lty(e, Str), string_const(e, entry.0)))
            owners.push(entry.1)
            last = Some(entry.0)

    e.table_id += 1

    val name = s".table${e.table_id}"

    e.globals.push(IrGlobal(name, true, LArr(int(keys.len()), lty(e, Str)), Some(VArray(keys)),
                            LinkPrivate, None, Some(int(e.layout.align(Str))), false, false))

    val found = str_search(e, VGlobal(name), keys.len(), sv)

    var arm_ls: Buf[string] = buf()

    for k in from..<to
        arm_ls.push(fresh_label(e, "match.arm"))

    val next_l = fresh_label(e, "match.next")

    var cases: Buf[(BigInt, string)] = buf()

    for k in 0..<owners.len()
        cases.push((from_int(long(k)), arm_ls.at(owners.at(k))))

    emit_term(e, InSwitch(word_lty(e), found, next_l, cases))

    for k in from..<to
        emit_label(e, arm_ls.at(k - from))
        gen_arm_body(e, arms.at(k), sv, at, ty, slot, end_l)

    emit_label(e, next_l)
end gen_string_table

// An arm that hands back one large payload unchanged (`moved_payload`), written straight from where
// the scrutinee holds it (`at`) to where the value is going, rather than bound into a slot of its own
// and copied a second time. `Result.unwrap` and `Option.unwrap` are this arm.
//
//   - **Into a destination** -- the payload is copied there and owned there. Where the destination is
//     the payload itself (`Merge.in_place`), nothing is copied at all.
//   - **Into a box** -- `V(x) -> x` where the `match` is expected as a `&T`: the box is allocated and
//     the payload copied straight into it, so no stack slot ever holds it.
//
// Either way the destination takes a count of its own of everything the payload holds, and the
// scrutinee's storage keeps the counts it had -- a local's until its scope ends, a temporary's until
// the statement does -- so the payload is owned by each exactly once, and released by each once.
//
// Answers whether it wrote the arm.
private payload_move(e: *Emit, arm: TArm, slot: Merge, at: Option[Val]) -> bool
    val m = moved_payload(e, arm) match
        Some(found) -> found
        None -> return false

    val src = at match
        Some(a) -> a
        None -> return false

    val fty = m.variant.fields.at(m.index).1

    m.boxed_as match
        None ->
            if !slot.into then return false

            if slot.in_place then retain_at(e, fty, slot.at) else move_payload_into(e, m, src, slot.at)
        Some(ref_ty) ->
            if slot.into then return false

            // The box is handed out with a count of its own, as a branch's value always is
            // (`gen_block_value`), and the region it was made in lets go of the one it was made with.
            push_temps(e)

            val opened = open_box(e, ref_inner(ref_ty))

            move_payload_into(e, m, src, opened.1)

            val b = own_temp(e, opened.0, ref_ty)

            retain_value(e, ref_ty, b)
            pop_temps(e)
            emit(e, InStore(lty(e, ref_ty), b, slot.at, AccPlain, None))

    true
end payload_move

// The moved payload copied from the scrutinee at `src` to `dest`, which takes its own counts.
private move_payload_into(e: *Emit, m: Moved, src: Val, dest: Val)
    val fty = m.variant.fields.at(m.index).1
    val p = fresh_reg(e)

    payload_at(e, m, src, p)
    emit_memcpy(e, dest, p, int(e.layout.size(fty)), int(e.layout.claim(fty)))
    retain_at(e, fty, dest)
end move_payload_into
