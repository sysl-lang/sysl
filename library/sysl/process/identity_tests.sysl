module sysl.process
@requires(posix)
@tests

import sysl.buf.{Buf, buf}
import sysl.posix.time.sleep
import sysl.time.millis
import sysl.fs.{IoError, executable, link_metadata, make_temp_dir, metadata, remove_dir_all}
import sysl.fs.{set_link_owner, set_owner, set_permissions, space, symlink, unchanged, write_text}
import sysl.process.sys as psys
import sysl.slices.as_mut_ptr
import sysl.testing.skip

// Who the program is, over `sysl.process.sys`'s `get_id` and `set_id` hooks as `sysl.process.hosted`
// answers them, checked against what the filesystem says of a file the program made and against
// `id`, the system's own answer. The refusals are the unprivileged ones, so the suite skips them when
// it is run as user 0.

private id_of(flag: string) -> u32
    val out = capture("id", [flag]).unwrap()

    assert(out.status.ok(), s"id $flag failed")

    var n: u32 = 0

    for b in out.text.bytes
        if b >= u8('0') && b <= u8('9') then n = n * 10 + u32(b - u8('0'))

    n
end id_of

@test("user and group are the effective ids the system reports, and the real ones match them")
id_answers_what_id_says()
    assert_eq(user(), id_of("-u"))
    assert_eq(group(), id_of("-g"))
    assert_eq(real_user(), id_of("-ru"))
    assert_eq(real_group(), id_of("-rg"))

@test("a file the program made is its own: Meta.owner == user()")
id_owns_what_it_makes()
    val dir = make_temp_dir("sysl-proc-id").unwrap()
    val path = s"$dir/mine"

    write_text(path, "x").unwrap()

    val m = metadata(path).unwrap()

    assert(m.owner == user(), s"owner ${m.owner}, user ${user()}")

    // And it may be given to the owner it has, which is the one change nobody needs privilege for.
    set_owner(path, user(), m.group).unwrap()
    assert_eq(metadata(path).unwrap().owner, user())

    remove_dir_all(dir)
end id_owns_what_it_makes

@test("a file given to root by a program that is not root is refused with NotPermitted")
id_chown_to_root_is_refused()
    if user() == 0 then skip("run as root, so giving a file away is allowed")

    val dir = make_temp_dir("sysl-proc-id").unwrap()
    val path = s"$dir/mine"

    write_text(path, "x").unwrap()

    val refused = set_owner(path, 0, metadata(path).unwrap().group)

    assert_eq(metadata(path).unwrap().owner, user())
    remove_dir_all(dir)

    refused match
        Ok(_) -> assert(false, "a file was given to root")
        Err(e) -> assert_eq(e, IoError.NotPermitted)
end id_chown_to_root_is_refused

@test("set_user and set_group to the ids the program already has succeed and change nothing")
id_set_to_itself()
    val u = user()
    val g = group()

    set_group(g).unwrap()
    set_user(u).unwrap()

    assert_eq(user(), u)
    assert_eq(group(), g)

@test("set_user and set_group to root from a program that is not root are refused with NotPermitted")
id_set_to_root_is_refused()
    if user() == 0 then skip("run as root, so becoming root is allowed")

    set_user(0) match
        Ok(_) -> assert(false, "the program became root")
        Err(e) -> assert_eq(e, IoError.NotPermitted)

    if real_group() != 0
        set_group(0) match
            Ok(_) -> assert(false, "the program joined group 0")
            Err(e) -> assert_eq(e, IoError.NotPermitted)

    assert(user() != 0, "the refusal changed the user anyway")
end id_set_to_root_is_refused

@test("hostname is the name `uname -n` reports, and is not empty")
hostname_matches_uname()
    val name = hostname().unwrap()
    val out = capture("uname", ["-n"]).unwrap()

    assert(out.status.ok(), "uname -n failed")
    assert(name.len > 0, "the host name is empty")
    assert_eq(name, out.text.trim())

@test("a host name that does not fit the room it is given is a failure, never a cut-short success")
hostname_refuses_a_short_room()
    var raw: []u8 = [0; 1]

    val n = psys.hostname(as_mut_ptr(raw), 0)

    assert(n < 0, s"a room of zero bytes was answered with $n")

    val whole = hostname().unwrap()
    var one: []u8 = [0; 1]

    if whole.len > 1 then assert(psys.hostname(as_mut_ptr(one), 1) < 0, "a one-byte room held a longer name")

@test("pid is this program's process id: the parent a child it starts reports")
id_pid_is_the_childs_parent()
    val out = capture("sh", ["-c", "echo $PPID"]).unwrap()

    assert(out.status.ok(), "sh -c failed")
    assert_eq(out.text, s"${pid()}\n")
    assert(pid() > 0, "a hosted program has a process id")

@test("a child's pid is not the program's own")
id_pid_is_not_a_childs()
    var child = start("sh", ["-c", "exit 0"]).unwrap()

    assert(child.pid() != int(pid()), "the child has a process of its own")
    child.wait().unwrap()

@test("the process id is asked, never set")
id_the_process_is_not_set()
    assert(psys.set_id(psys.id_process, 1) < 0, "set_id took the process id")

@test("total_memory is the machine's memory: positive, and more than this program holds")
mem_total_exceeds_own_resident()
    val total = total_memory().unwrap()
    val own = resident_bytes(int(pid())).unwrap()

    assert(total > 0, "the machine has no memory")
    assert(own > 0, "this program has no resident memory")
    assert(total >= own, s"total $total is less than own resident $own")

#if bsd
private system_total() -> string = capture("sysctl", ["-n", "hw.memsize"]).unwrap().text.trim()
#else
private system_total() -> string =
    capture("sh", ["-c", "awk '/MemTotal/ {printf \"%.0f\", $2 * 1024}' /proc/meminfo"]).unwrap().text.trim()
#endif

@test("total_memory agrees with the system's own answer")
mem_total_matches_the_system()
    assert_eq(system_total(), s"${total_memory().unwrap()}")

@test("resident_bytes of this program grows by about what it allocates and touches")
mem_resident_grows_when_touched()
    val before = resident_bytes(int(pid())).unwrap()
    val size: usize = 64 * 1024 * 1024
    var block: []u8 = [0; 64 * 1024 * 1024]

    var i: usize = 0

    loop
        if i >= size then break
        block[i] = u8(1)
        i += 4096
    end loop

    val after = resident_bytes(int(pid())).unwrap()

    assert(after >= before + 32 * 1024 * 1024, s"resident went from $before to $after")
    assert_eq(block[4096], u8(1))

@test("resident_bytes reads a live child, and a reaped child is an error")
mem_resident_of_a_child()
    var child = start("sleep", ["5"]).unwrap()
    val id = child.pid()

    assert(resident_bytes(id).unwrap() > 0, "a live child has resident memory")
    child.kill().unwrap()
    child.wait().unwrap()
    assert_eq(resident_bytes(id).unwrap_err(), IoError.NotFound)

@test("resident_bytes of a pid no process can have is an error")
mem_resident_of_no_process()
    assert(resident_bytes(0).is_err(), "pid 0")
    assert(resident_bytes(-1).is_err(), "pid -1")
    assert(resident_bytes(-2147483647).is_err(), "a very negative pid")
    assert_eq(resident_bytes(2147483647).unwrap_err(), IoError.NotFound)

@test("resident_bytes of a process the program may not look at is NotPermitted, or a size where the host allows it")
mem_resident_of_pid_one()
    resident_bytes(1) match
        Ok(n) -> assert(n > 0, "pid 1 resident")
        Err(e) -> assert_eq(e, IoError.NotPermitted)

// ## Who is in a group, and whose child a process is

private has(found: Buf[int], id: int) -> bool
    for v in found.view()
        if v == id then return true

    false
end has

// Other tests can start children of the same program while this one runs, so the count is not
// checked here; the tests on a group of its own pin an exact membership.
@test("children lists every child the program started, and not the program itself")
tree_children_lists_each_child()
    var a = spawn("sleep", ["5"]).unwrap()
    var b = spawn("sleep", ["5"]).unwrap()
    var c = spawn("sleep", ["5"]).unwrap()
    val mine = children(int(pid())).unwrap()

    assert(has(mine, a.pid()), "the first child")
    assert(has(mine, b.pid()), "the second child")
    assert(has(mine, c.pid()), "the third child")
    assert(!has(mine, int(pid())), "the program is not its own child")

    a.kill(9).unwrap()
    b.kill(9).unwrap()
    c.kill(9).unwrap()
    a.wait().unwrap()
    b.wait().unwrap()
    c.wait().unwrap()

@test("children does not list a grandchild")
tree_children_skips_grandchildren()
    var child = spawn("sh", ["-c", "sleep 5 & wait"]).unwrap()
    val own = children(int(pid())).unwrap()

    assert(has(own, child.pid()), "the shell is a child")

    var grand: Buf[int] = buf()

    for _ in 0..<100
        grand = children(child.pid()).unwrap()
        if grand.len() > 0 then break
        sleep(millis(20))

    assert(grand.len() > 0, "the shell's own child never appeared")
    assert(!has(own, grand[0]), "a grandchild is not this program's child")
    assert(!has(grand, child.pid()), "a process is not its own child")

    child.kill(9).unwrap()
    child.wait().unwrap()

@test("a child started in a group of its own leads it, and group_members lists it there alone")
tree_new_group_has_the_child()
    var child = spawn("sleep", ["5"], group = Group.New).unwrap()
    val members = group_members(child.group()).unwrap()

    assert_eq(child.group(), child.pid())
    assert_eq(members.len(), 1)
    assert(has(members, child.pid()), "the leader")

    child.kill(9).unwrap()
    child.wait().unwrap()

@test("a child left in this program's group is listed in it beside the program")
tree_inherited_group_holds_the_child()
    var child = spawn("sleep", ["5"]).unwrap()
    val members = group_members(process_group()).unwrap()

    assert(has(members, child.pid()), "the child")
    assert(has(members, int(pid())), "this program")

    child.kill(9).unwrap()
    child.wait().unwrap()

@test("a child that joins another's group is listed in it with the leader")
tree_joined_group_holds_both()
    var leader = spawn("sleep", ["5"], group = Group.New).unwrap()
    var member = spawn("sleep", ["5"], group = Group.Join(leader.group())).unwrap()
    val members = group_members(leader.group()).unwrap()

    assert_eq(members.len(), 2)
    assert(has(members, leader.pid()), "the leader")
    assert(has(members, member.pid()), "the member")

    leader.kill(9).unwrap()
    member.kill(9).unwrap()
    leader.wait().unwrap()
    member.wait().unwrap()

@test("a child reaped by wait_pid is in neither list afterwards")
tree_reaped_child_is_gone()
    var child = spawn("sleep", ["5"], group = Group.New).unwrap()
    val id = child.pid()
    val group = child.group()

    assert(has(children(int(pid())).unwrap(), id), "listed while it runs")
    child.kill(9).unwrap()

    val gone = child.detach()

    assert_eq(gone, id)
    wait_pid(id).unwrap()
    assert(!has(children(int(pid())).unwrap(), id), "still a child after the wait")
    assert_eq(group_members(group).unwrap().len(), 0)

@test("a pid or group nothing has answers an empty list, not an error")
tree_unused_is_empty()
    assert_eq(children(2147483647).unwrap().len(), 0)
    assert_eq(group_members(2147483647).unwrap().len(), 0)

@test("a process with no children answers an empty list")
tree_leaf_has_no_children()
    var child = spawn("sleep", ["5"]).unwrap()

    assert_eq(children(child.pid()).unwrap().len(), 0)
    child.kill(9).unwrap()
    child.wait().unwrap()

@test("a pid or group of zero or less is Other(22), whatever the sign")
tree_non_positive_is_an_error()
    assert_eq(children(0).unwrap_err(), IoError.Other(22))
    assert_eq(children(-1).unwrap_err(), IoError.Other(22))
    assert_eq(children(-2147483647).unwrap_err(), IoError.Other(22))
    assert_eq(group_members(0).unwrap_err(), IoError.Other(22))
    assert_eq(group_members(-1).unwrap_err(), IoError.Other(22))
    assert_eq(group_members(-2147483647).unwrap_err(), IoError.Other(22))

@test("pid 1's children, or its group, are answered where the host lets the program see them")
tree_pid_one_is_listed_or_empty()
    assert(children(1).is_ok(), "children of pid 1")
    assert(group_members(1).is_ok(), "group of pid 1")

@test("more members than the first guess holds are all listed")
tree_a_long_list_is_complete()
    var kids: Buf[&Spawned] = buf()

    for _ in 0..<90
        kids.push(spawn("sleep", ["5"], group = Group.Join(process_group())).unwrap())

    val mine = children(int(pid())).unwrap()
    val group = group_members(process_group()).unwrap()

    for k in kids.view()
        assert(has(mine, k.pid()), "a child is missing from children")
        assert(has(group, k.pid()), "a child is missing from group_members")

    for i in 0..<kids.len()
        kids[i].kill(9).unwrap()
        kids[i].wait().unwrap()

@test("user_name of this program's user is the name `id -un` reports")
user_name_matches_id()
    val out = capture("id", ["-un"]).unwrap()

    assert(out.status.ok(), "id -un failed")
    assert_eq(user_name(user()).unwrap(), out.text.trim())

@test("user_name of 0 is root, and an id nobody has is NotFound")
user_name_root_and_absent()
    assert_eq(user_name(0).unwrap(), "root")
    assert_eq(user_name(4_000_000_001).unwrap_err(), IoError.NotFound)

@test("user_name of the real user agrees with the effective one when they are the same")
user_name_real_user()
    if real_user() == user() then assert_eq(user_name(real_user()).unwrap(), user_name(user()).unwrap())

@test("a user name that does not fit the room it is given is a failure, never a cut-short success")
user_name_refuses_a_short_room()
    var raw: []u8 = [0; 1]

    assert(psys.user_name(0, as_mut_ptr(raw), 0) < 0, "a room of zero bytes held a name")
    assert(psys.user_name(0, as_mut_ptr(raw), 1) < 0, "a one-byte room held 'root'")

// -- groups by id, and both databases by name ---------------------------------------------------------

@test("group_name of this program's group is the name `id -gn` reports")
group_name_matches_id()
    val out = capture("id", ["-gn"]).unwrap()

    assert(out.status.ok(), "id -gn failed")
    assert_eq(group_name(group()).unwrap(), out.text.trim())

@test("group_name of 0 is the system's first group, and an id nobody has is NotFound")
group_name_zero_and_absent()
#if bsd
    assert_eq(group_name(0).unwrap(), "wheel")
#else
    assert_eq(group_name(0).unwrap(), "root")
#endif
    assert_eq(group_name(4_000_000_001).unwrap_err(), IoError.NotFound)

@test("a group name that does not fit the room it is given is a failure, never a cut-short success")
group_name_refuses_a_short_room()
    var raw: []u8 = [0; 1]

    assert(psys.group_name(0, as_mut_ptr(raw), 0) < 0, "a room of zero bytes held a name")
    assert(psys.group_name(0, as_mut_ptr(raw), 1) < 0, "a one-byte room held group 0's name")

@test("user_id is user_name's reverse: the program's own name, and root's, round trip")
user_id_round_trips()
    assert_eq(user_id(user_name(user()).unwrap()).unwrap(), user())
    assert_eq(user_id("root").unwrap(), 0)
    assert_eq(user_name(user_id(user_name(user()).unwrap()).unwrap()).unwrap(), user_name(user()).unwrap())

@test("group_id is group_name's reverse, for every group `id -G` says the program is in")
group_id_round_trips()
    assert_eq(group_id(group_name(group()).unwrap()).unwrap(), group())
    assert_eq(group_id(group_name(0).unwrap()).unwrap(), 0)

    val out = capture("id", ["-G"]).unwrap()

    assert(out.status.ok(), "id -G failed")

    for word in out.text.fields()
        var g: u32 = 0

        for b in word.bytes do g = g * 10 + u32(b - u8('0'))

        // A group the program is in may have no entry of its own (a container's bare gid): only one
        // that has a name is asked back.
        group_name(g) match
            Ok(name) -> assert_eq(group_id(name).unwrap(), g)
            Err(e) -> assert_eq(e, IoError.NotFound)
    end for
end group_id_round_trips

@test("a name nobody has, an empty name and a name holding a zero byte are all NotFound")
names_absent()
    for name in ["sysl-no-such-account-x7", "", "root\0", "\0root"]
        assert_eq(user_id(name).unwrap_err(), IoError.NotFound)
        assert_eq(group_id(name).unwrap_err(), IoError.NotFound)

/** Nothing is folded or trimmed on this side; what the database does with case is its own. macOS's
 * Directory Services matches a name whatever its case, and Linux's files backend matches it exactly.
 */
@test("a name is handed to the database as given: no space trimmed, and a slice names only its own bytes")
names_exact()
    assert_eq(user_id(" root").unwrap_err(), IoError.NotFound)
    assert_eq(user_id("root ").unwrap_err(), IoError.NotFound)
    assert_eq(group_id(" root").unwrap_err(), IoError.NotFound)

#if macos
    assert_eq(user_id("ROOT").unwrap(), 0)
    assert_eq(group_id("WHEEL").unwrap(), 0)
#else
    assert_eq(user_id("ROOT").unwrap_err(), IoError.NotFound)
#endif

    // Not followed by a zero: a shim that read past the slice would look up `rootless-sysl`.
    val longer = "rootless-sysl"

    assert_eq(user_id(longer[0..<4]).unwrap(), 0)
    assert_eq(user_id(longer).unwrap_err(), IoError.NotFound)

    val zero_group = group_name(0).unwrap()
    val padded = zero_group + "-sysl"

    assert_eq(group_id(padded[0..<zero_group.len]).unwrap(), 0)
    assert_eq(group_id(padded).unwrap_err(), IoError.NotFound)
end names_exact

// -- what the filesystem says of the program's own files ----------------------------------------------

/** A new file's group is the program's group (`getgid`'s effective twin) on Linux, and the directory's
 * on a BSD -- POSIX allows both, and a directory with its setgid bit set asks for the second on Linux
 * too -- so the expected group is worked out from the directory rather than assumed.
 */
@test("a file the program made carries its ids: Meta.owner is user(), Meta.group the group POSIX gives it")
id_meta_ids_are_the_programs()
    val dir = make_temp_dir("sysl-proc-ids").unwrap()
    val path = s"$dir/mine"

    write_text(path, "x").unwrap()

    val m = metadata(path).unwrap()
    val parent = metadata(dir).unwrap()

    assert_eq(m.owner, user())
    assert_eq(m.owner, id_of("-u"))

#if bsd
    assert_eq(m.group, parent.group)
#else
    assert_eq(m.group, if (parent.mode & 0o2000) != 0 then parent.group else group())
#endif

    remove_dir_all(dir)
end id_meta_ids_are_the_programs

@test("executable(path) asks for this program: another class's execute bit does not let the owner run it")
id_executable_is_the_programs()
    if user() == 0 then skip("run as root, who may execute a file with any execute bit set")

    val dir = make_temp_dir("sysl-proc-exec").unwrap()
    val path = s"$dir/script"

    write_text(path, "#!/bin/sh\nexit 0\n").unwrap()

    val cases: [](u32, bool) = [(0o700, true), (0o100, true), (0o070, false), (0o007, false),
                                (0o001, false), (0o600, false)]

    for (mode, runs) in cases
        set_permissions(path, mode).unwrap()

        // The bits say "a program" whenever any execute bit is set; the system answers for the owner.
        assert_eq(metadata(path).unwrap().executable(), (mode & 0o111) != 0)
        assert_eq(executable(path), runs)
    end for

    remove_dir_all(dir)
end id_executable_is_the_programs

/** The link is the program's and what it names is root's, so giving the link to the program succeeds
 * while giving the target to it is refused -- which is the target left alone, told from outside.
 */
@test("set_link_owner leaves the target: a link to root's file is the program's to set, the file not")
id_link_owner_leaves_the_target()
    if user() == 0 then skip("run as root, so the target could be given away too")

    val dir = make_temp_dir("sysl-proc-lchown").unwrap()
    val link = s"$dir/sh"
    val target = "/bin/sh"

    symlink(target, link).unwrap()

    val theirs = metadata(target).unwrap()

    assert_eq(theirs.owner, 0)
    assert_eq(link_metadata(link).unwrap().owner, user())

    set_link_owner(link, user(), group()).unwrap()

    val refused = set_owner(link, user(), group())

    assert_eq(metadata(target).unwrap().owner, theirs.owner)
    assert_eq(metadata(target).unwrap().group, theirs.group)
    assert_eq(link_metadata(link).unwrap().owner, user())
    assert_eq(link_metadata(link).unwrap().group, group())
    remove_dir_all(dir)

    refused match
        Ok(_) -> assert(false, "root's file was given to the program through a link")
        Err(e) -> assert_eq(e, IoError.NotPermitted)
end id_link_owner_leaves_the_target

@test("set_link_owner giving a file to root, by a program that is not root, is NotPermitted")
id_link_owner_to_root_is_refused()
    if user() == 0 then skip("run as root, so giving a file away is allowed")

    val dir = make_temp_dir("sysl-proc-lchown").unwrap()
    val path = s"$dir/mine"

    write_text(path, "x").unwrap()

    val refused = set_link_owner(path, 0, metadata(path).unwrap().group)

    assert_eq(metadata(path).unwrap().owner, user())
    remove_dir_all(dir)

    refused match
        Ok(_) -> assert(false, "a file was given to root")
        Err(e) -> assert_eq(e, IoError.NotPermitted)
end id_link_owner_to_root_is_refused

/** A group of the program's own, other than `not` -- one `chgrp` an unprivileged program may make --
 * or `unchanged` when it belongs to no other.
 */
private other_group(not: u32) -> u32
    val out = capture("id", ["-G"]).unwrap()

    assert(out.status.ok(), "id -G failed")

    var found: u32 = unchanged
    var n: u32 = 0
    var digits = false

    for b in out.text.bytes
        if b >= u8('0') && b <= u8('9')
            n = n * 10 + u32(b - u8('0'))
            digits = true
        else
            if digits && n != not && found == unchanged then found = n

            n = 0
            digits = false

    if digits && n != not && found == unchanged then found = n

    found
end other_group

@test("unchanged is 4294967295, the (uid_t)-1 that chown(2) reads as no change")
id_unchanged_is_minus_one()
    assert_eq(unchanged, 0xFFFFFFFF)
    assert_eq(unchanged, 4294967295)
end id_unchanged_is_minus_one

@test("set_owner with unchanged for the owner keeps the owner and sets the group")
id_set_owner_unchanged_owner()
    val dir = make_temp_dir("sysl-proc-unch").unwrap()
    val path = s"$dir/f"

    write_text(path, "x").unwrap()

    val before = metadata(path).unwrap()
    val other = other_group(before.group)

    if other == unchanged
        remove_dir_all(dir)
        skip("the program has no group but the file's own")

    set_owner(path, unchanged, other).unwrap()

    val after = metadata(path).unwrap()

    remove_dir_all(dir)
    assert_eq(after.owner, before.owner)
    assert_eq(after.group, other)
end id_set_owner_unchanged_owner

@test("set_owner with unchanged for the group keeps the group and sets the owner")
id_set_owner_unchanged_group()
    val dir = make_temp_dir("sysl-proc-unch").unwrap()
    val path = s"$dir/f"

    write_text(path, "x").unwrap()

    val other = other_group(metadata(path).unwrap().group)

    if other != unchanged then set_owner(path, user(), other).unwrap()

    val before = metadata(path).unwrap()

    set_owner(path, user(), unchanged).unwrap()

    val after = metadata(path).unwrap()

    remove_dir_all(dir)
    assert_eq(after.owner, user())
    assert_eq(after.group, before.group)
end id_set_owner_unchanged_group

@test("set_owner with unchanged for both changes nothing, and a missing path is still NotFound")
id_set_owner_unchanged_both()
    val dir = make_temp_dir("sysl-proc-unch").unwrap()
    val path = s"$dir/f"

    write_text(path, "x").unwrap()

    val before = metadata(path).unwrap()

    set_owner(path, unchanged, unchanged).unwrap()

    val after = metadata(path).unwrap()
    val missing = set_owner(s"$dir/missing", unchanged, unchanged)
    val missing_link = set_link_owner(s"$dir/missing", unchanged, unchanged)

    remove_dir_all(dir)
    assert_eq(after.owner, before.owner)
    assert_eq(after.group, before.group)
    assert_eq(missing.unwrap_err(), IoError.NotFound)
    assert_eq(missing_link.unwrap_err(), IoError.NotFound)
end id_set_owner_unchanged_both

@test("set_link_owner with unchanged for the owner sets the link's group and leaves the target alone")
id_set_link_owner_unchanged_owner()
    val dir = make_temp_dir("sysl-proc-unch").unwrap()
    val path = s"$dir/f"
    val link = s"$dir/l"

    write_text(path, "x").unwrap()
    symlink(path, link).unwrap()

    val target = metadata(path).unwrap()
    val before = link_metadata(link).unwrap()
    val other = other_group(before.group)

    if other == unchanged
        remove_dir_all(dir)
        skip("the program has no group but the file's own")

    set_link_owner(link, unchanged, other).unwrap()

    val after = link_metadata(link).unwrap()
    val target_after = metadata(path).unwrap()

    remove_dir_all(dir)
    assert_eq(after.owner, before.owner)
    assert_eq(after.group, other)
    assert_eq(target_after.owner, target.owner)
    assert_eq(target_after.group, target.group)
end id_set_link_owner_unchanged_owner

@test("set_link_owner with unchanged for the group sets the link's owner and keeps its group")
id_set_link_owner_unchanged_group()
    val dir = make_temp_dir("sysl-proc-unch").unwrap()
    val path = s"$dir/f"
    val link = s"$dir/l"

    write_text(path, "x").unwrap()
    symlink(path, link).unwrap()

    val target = metadata(path).unwrap()
    val other = other_group(target.group)

    if other != unchanged then set_link_owner(link, user(), other).unwrap()

    val before = link_metadata(link).unwrap()

    set_link_owner(link, user(), unchanged).unwrap()

    val after = link_metadata(link).unwrap()
    val target_after = metadata(path).unwrap()

    remove_dir_all(dir)
    assert_eq(after.owner, user())
    assert_eq(after.group, before.group)
    assert_eq(target_after.owner, target.owner)
    assert_eq(target_after.group, target.group)
end id_set_link_owner_unchanged_group

/** `df -P -k` prints the size in 1024-byte blocks in the format POSIX fixes, read off the same
 * `statvfs`, so the total agrees to the kilobyte -- a reading multiplied by `f_bsize` rather than
 * `f_frsize`, or a count read from the wrong field, would not. It is here rather than beside `space`
 * because `sysl.fs`'s own tests may not start a child.
 */
@test("space's total is what df reports for the same path, to the kilobyte")
id_space_matches_df()
    val dir = make_temp_dir("sysl-proc-df").unwrap()
    val out = capture("df", ["-P", "-k", dir]).unwrap()

    assert(out.status.ok(), "df failed")

    // The second line's second field: the total in 1024-byte blocks.
    val lines = out.text.lines()

    assert(lines.len >= 2, s"df printed '${out.text}'")

    val fields = lines[1].fields()

    assert(fields.len >= 2, s"df printed '${lines[1]}'")

    var blocks: u64 = 0

    for b in fields[1].bytes do blocks = blocks * 10 + u64(b - u8('0'))

    val kib = space(dir).unwrap().total / 1024

    assert(kib == blocks || kib + 1 == blocks || kib == blocks + 1, s"space ${kib}K, df ${blocks}K")

    remove_dir_all(dir)
end id_space_matches_df
