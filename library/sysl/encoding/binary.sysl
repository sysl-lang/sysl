module sysl.encoding

import sysl.buf.Buf

/** Fixed-width integers to and from bytes, at both byte orders.
 *
 * **These are free functions at concrete widths, and that is exactly why they can exist.**
 * `math/integer.sysl` deliberately leaves `swap_bytes` out of the `Bits` trait, because every member
 * of that trait must be total over every integer type and a `u24` or a `u4` has no byte order at all
 * -- a member working at `u32` and not at `u24` would turn a bound that was supposed to have proven
 * an operation into a failure at somebody else's instantiation. Nothing here is a trait member, so
 * nothing here reopens that: `get_u32_le` names its width, and the widths that have a whole number of
 * bytes are the only ones written.
 *
 * **Unsigned only.** The signed read of the same bytes is a cast at the call site, and doubling a
 * twelve-function surface to spare one cast is not a trade worth making.
 *
 * **Reading answers `Option` and writing answers `bool`**, rather than trapping on a slice that is
 * too short. Walking a buffer whose length came from somewhere else is the ordinary use, and running
 * off the end of one is an expected condition there rather than a program's mistake.
 */

// -- 16 bits --------------------------------------------------------------------------------------

get_u16_le(b: []const u8) -> Option[u16] =
    if b.len < 2 then None else Some(u16(b[0]) | u16(b[1]) << 8)

get_u16_be(b: []const u8) -> Option[u16] =
    if b.len < 2 then None else Some(u16(b[0]) << 8 | u16(b[1]))

// The low eight bits of `v`, which is what every byte written below is: the mask says the rest is
// meant to go, so the conversion holds its value in every build.
private low_byte[T: Integer + BitAnd](v: T) -> u8 = u8(v & T(0xff))

put_u16_le(b: []u8, v: u16) -> bool
    if b.len < 2 then return false

    b[0] = low_byte(v)
    b[1] = low_byte(v >> 8)

    true

put_u16_be(b: []u8, v: u16) -> bool
    if b.len < 2 then return false

    b[0] = low_byte(v >> 8)
    b[1] = low_byte(v)

    true

// -- 32 bits --------------------------------------------------------------------------------------

get_u32_le(b: []const u8) -> Option[u32] =
    if b.len < 4 then
        None
    else
        Some(u32(b[0]) | u32(b[1]) << 8 | u32(b[2]) << 16 | u32(b[3]) << 24)

get_u32_be(b: []const u8) -> Option[u32] =
    if b.len < 4 then
        None
    else
        Some(u32(b[0]) << 24 | u32(b[1]) << 16 | u32(b[2]) << 8 | u32(b[3]))

put_u32_le(b: []u8, v: u32) -> bool
    if b.len < 4 then return false

    for i in 0..<4
        b[i] = low_byte(v >> (i * 8))

    true

put_u32_be(b: []u8, v: u32) -> bool
    if b.len < 4 then return false

    for i in 0..<4
        b[i] = low_byte(v >> ((3 - i) * 8))

    true

// -- 64 bits --------------------------------------------------------------------------------------

get_u64_le(b: []const u8) -> Option[u64]
    if b.len < 8 then return None

    var v: u64 = 0

    for i in 0..<8
        v = v | u64(b[i]) << (i * 8)

    Some(v)

get_u64_be(b: []const u8) -> Option[u64]
    if b.len < 8 then return None

    var v: u64 = 0

    for i in 0..<8
        v = v << 8 | u64(b[i])

    Some(v)

put_u64_le(b: []u8, v: u64) -> bool
    if b.len < 8 then return false

    for i in 0..<8
        b[i] = low_byte(v >> (i * 8))

    true

put_u64_be(b: []u8, v: u64) -> bool
    if b.len < 8 then return false

    for i in 0..<8
        b[i] = low_byte(v >> ((7 - i) * 8))

    true

// -- appending to a growing buffer ----------------------------------------------------------------

/** The `put_` family's other half: where a `put_` writes into storage that is already the right
 * size and answers `bool`, a `push_` appends to a `Buf[u8]` and so cannot run out of room.
 *
 * **Free functions taking the `Buf` by value**, because a `Buf` is a handle and `push`/`extend` on it
 * are `const` members -- the caller's buffer grows through the copy, so `push_u32_be(out, v)` needs
 * no `&`. Each answers nothing, since appending has no short-slice case to report.
 */

push_u16_le(out: Buf[u8], v: u16) = out.extend([low_byte(v), low_byte(v >> 8)])

push_u16_be(out: Buf[u8], v: u16) = out.extend([low_byte(v >> 8), low_byte(v)])

push_u32_le(out: Buf[u8], v: u32)
    out.extend([low_byte(v), low_byte(v >> 8), low_byte(v >> 16), low_byte(v >> 24)])

push_u32_be(out: Buf[u8], v: u32)
    out.extend([low_byte(v >> 24), low_byte(v >> 16), low_byte(v >> 8), low_byte(v)])

push_u64_le(out: Buf[u8], v: u64)
    var b: [8]u8

    for i in 0..<8
        b[i] = low_byte(v >> (i * 8))

    out.extend(b[0..<8])

push_u64_be(out: Buf[u8], v: u64)
    var b: [8]u8

    for i in 0..<8
        b[i] = low_byte(v >> ((7 - i) * 8))

    out.extend(b[0..<8])
