// P08b: the node promises `@unchecked(Share)`: its fields are private, and its own members write a
// slot only when the caller's edit token matches the one it was made under.

@unchecked(Share)
struct SNode
    private edit: usize
    private items: [4]int

    get(self, i: usize) -> int = self.items[i]

    set_owned(*self, token: usize, i: usize, v: int) -> bool
        if self.edit != token then return false

        self.items[i] = v
        true

main()
    val n: &sync SNode = SNode(7, [1, 2, 3, 4])

    print(n.set_owned(7, 0, 10), n.set_owned(8, 1, 20), n.get(0), n.get(1))
