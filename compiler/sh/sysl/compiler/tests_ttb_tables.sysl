module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.text.{split, Search}
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}

// `emit-typed --tables` is the lowered program read by its tables: every section, always, and what
// the program reached -- the library's functions and storage among it -- rather than what its own
// files declare. Every expected row here was read off the reference compiler's output for the same
// program.

private ttb_library_here() -> bool = std_root().is_ok()

private ttb_program() -> string =
    "struct Point\n    x: int\n    y: int\n\nenum Color\n    Red\n    Green\n\n" +
    "enum Shape\n    Circle(r: int)\n    Square(s: int)\n\ntrait Area\n    area(self) -> int\n\n" +
    "impl Area for Shape\n    area(self) -> int = self match\n        Circle(r) -> r * r * 3\n" +
    "        Square(s) -> s * s\n\nextern \"abs\" c_abs(n: int) -> int\n\n" +
    "unused(n: int) -> int = n + 1\n\nsum(p: Point) -> int = p.x + p.y\n\n" +
    "val a: &Area = Square(2)\nprint(sum(Point(1, 2)) + c_abs(-3) + a.area())\n"

// The tables of one program, written into a directory of its own.
private ttb_tables(files: Buf[(string, string)]) -> string
    val root = make_temp_dir("sysl-ttb").unwrap()

    for i in 0..<files.len()
        val place = s"$root/${files.at(i).0}"

        parent_of(place) match
            Some(dir) -> make_dir_all(dir).unwrap()
            None -> ()

        write_text(place, files.at(i).1).unwrap()

    val out = emit_typed_text(root, None, true) match
        Ok(e) -> e.text
        Err(f) -> s"refused: ${failure_text(f)}"

    remove_dir_all(root).unwrap_or(())
    out
end ttb_tables

private ttb_main(text: string) -> Buf[(string, string)]
    var out: Buf[(string, string)] = buf()

    out.push(("main.sysl", text))
    out
end ttb_main

// The lines that open a section, in the order printed.
private ttb_sections(text: string) -> string
    var out = ""

    for line in split(text, "\n")
        if line != "" && !line.starts_with(" ") then out = out + line + "\n"

    out
end ttb_sections

@test("--tables prints all seven sections, in the reference's order, whatever the program holds")
ttb_every_section_is_printed()
    if !ttb_library_here() then return

    val want = "structs:\nenums:\ntraits:\nimpls:\nexterns:\nconsts:\nfuncs:\n"

    assert_eq(ttb_sections(ttb_tables(ttb_main(ttb_program()))), want)
    assert_eq(ttb_sections(ttb_tables(ttb_main("print(1)\n"))), want)

@test("--tables files a program's own declarations under each section, fields and variants below")
ttb_own_rows()
    if !ttb_library_here() then return

    val text = ttb_tables(ttb_main(ttb_program()))

    assert(text.contains("\n  Point\n    x: int\n    y: int\n"), "a struct and its fields")
    assert(text.contains("\n  Shape\n    Circle = 0 (r: int)\n    Square = 1 (s: int)\n"),
           "an enum and its variants by tag")
    assert(text.contains("\ntraits:\n  Area\nimpls:\n  Area for Shape\n    Shape.area() -> int\n" +
                         "externs:\n  c_abs(int) -> int\n"), "a trait, its impl's slots, an extern")
    assert(text.contains("\n  Shape.area(self: Shape) -> int\n  sum(p: Point) -> int\n"),
           "a member lowered to a function, and a function")
    assert(text.contains("\n  unused(n: int) -> int\n"), "a function the program declared and never calls")

@test("--tables carries what the program reached, not only what it declared")
ttb_reached_rows()
    if !ttb_library_here() then return

    val text = ttb_tables(ttb_main(ttb_program()))

    assert(text.contains("\n  sysl$printi(n: long) -> unit\n"), "a library function the program calls")
    assert(text.contains("\n  sysl.sys$sysl_stdout_write(*byte, usize) -> usize\n"),
           "an extern the library reaches")
    assert(text.contains("\n  sysl$sink: *sysl.Stdout\n"), "the library's module storage")
    assert(!text.contains("\n  Color\n"), "and a simple enum is its integer, with no row of its own")

@test("--tables files a tuple under its parentheses, and its fields under their positions")
ttb_tuple_rows()
    if !ttb_library_here() then return

    val text = ttb_tables(ttb_main(ttb_program()))

    assert(text.starts_with("structs:\n  (&sysl.regex.Node, int)\n    0: &sysl.regex.Node\n    1: int\n"),
           "a tuple sorts by its parentheses, ahead of every named struct")
    assert(!text.contains("$tuple"), "and never by the name the compiler declares it under")

// The reference's golden fixture: a real analysis of two functions and a struct, cut back to the
// rows those declarations resolved to so that the text is exact without pinning the library's.
@test("prints the golden declaration tables for the same small program, exactly")
ttb_golden_tables()
    if !ttb_library_here() then return

    val root = make_temp_dir("sysl-ttb").unwrap()

    write_text(s"$root/main.sysl",
               "struct Point\n    x: int\n    y: int\n\nadd(a: int, b: int) -> int = a + b\n\n" +
               "f(p: Point) -> int =\n    if p.x > 0 then add(p.x, p.y) else 0\n").unwrap()

    val c = packaged_compilation_of(root, host_target()).unwrap()
    val done = analyze_bodies(c.units, c.target)
    val whole = program_of(done, done.main_module)

    remove_dir_all(root).unwrap_or(())

    var structs: Buf[Type] = buf()
    var funcs: Buf[TFunc] = buf()

    for i in 0..<whole.structs.len()
        if type_show(whole.structs.at(i)) == "Point" then structs.push(whole.structs.at(i))

    for i in 0..<whole.funcs.len()
        val name = whole.funcs.at(i).name

        if name == "add" || name == "f" then funcs.push(whole.funcs.at(i))

    val fixture = whole with { structs = structs, enums = buf(), vtables = buf(), externs = buf(),
                               vals = buf(), funcs = funcs }
    val golden = "structs:\n  Point\n    x: int\n    y: int\nenums:\ntraits:\nimpls:\nexterns:\n" +
                 "consts:\nfuncs:\n  add(a: int, b: int) -> int\n  f(p: Point) -> int\n"

    assert_eq(show_tables(fixture), golden)
    assert_eq(show_tables(fixture), show_tables(fixture))
end ttb_golden_tables

@test
ttb_package_rows()
    if !ttb_library_here() then return

    var files: Buf[(string, string)] = buf()
    val here = "vendor/github.com/e/geom/@v1.0.0"

    files.push((s"$here/package.hocon", "package { name = \"geom\" }\n"))
    files.push((s"$here/geom/g.sysl",
                "module geom\n\nstruct Pair\n    a: int\n    b: int\n\ntrait Twice\n    twice(self) -> int\n\n" +
                "impl Twice for Pair\n    twice(self) -> int = (self.a + self.b) * 2\n\n" +
                "add(a: int, b: int) -> int = a + b\n\ndouble(p: Pair) -> int = p.twice()\n\n" +
                "never_called() -> int = 4\n"))
    files.push(("package.hocon", "dependencies { geom { git = \"github.com/e/geom\", version = \"1.0.0\" } }\n"))
    files.push(("main.sysl", "import geom.{add, double, Pair, Twice}\n\nval t: &Twice = Pair(1, 2)\n" +
                             "print(add(1, 2) + double(Pair(3, 4)) + t.twice())\n"))

    val text = ttb_tables(files)

    assert(text.contains("\n  github.com.e.geom.geom$Pair\n    a: int\n    b: int\n"), "the package's struct")
    assert(text.contains("\ntraits:\n  github.com.e.geom.geom$Twice\nimpls:\n" +
                         "  github.com.e.geom.geom$Twice for github.com.e.geom.geom.Pair\n" +
                         "    github.com.e.geom.geom$Pair.twice() -> int\n"), "its trait and impl")
    assert(text.contains("\n  github.com.e.geom.geom$Pair.twice(self: github.com.e.geom.geom.Pair) -> int\n" +
                         "  github.com.e.geom.geom$add(a: int, b: int) -> int\n" +
                         "  github.com.e.geom.geom$double(p: github.com.e.geom.geom.Pair) -> int\n" +
                         "  github.com.e.geom.geom$never_called() -> int\n"),
           "and every function the package declared, reached or not")
