module sh.sysl.compiler

import sh.sysl.parsing.source_of
import sysl.buf.{Buf, buf}
import sysl.fs.read_text
import sysl.prints
import sysl.text.Search

// The driver: what the shell asked for, and what it hears back.
//
// **`main` is a few lines that bind the real arguments and the real terminal to `run_cli`**, which
// is where every decision lives, so that each one is reachable from a test that touches neither.

// What the shell hears. Three outcomes and not two: a program the compiler refused is the program's
// news, and a command line the compiler could not read is the caller's own bug.
val Fine: int = 0
val Failed: int = 1
val Misused: int = 2

// What `sysl --version` answers. Written here as well as in `package.hocon`, because a program is
// handed nothing about its own manifest; the test beside this file keeps the two in step.
const Version: string = "0.0.1"

// The answer to a command line: the lines to say, and the status to exit with.
run_cli(args: []string, say: string -> unit) -> int
    if args.len < 2
        say(usage())
        return Misused

    // **Where things are on this machine is read afresh for every command line.** One process
    // answering two of them -- which is what a test does -- must not have the first's paths in the
    // second, and nothing else in the compiler writes this.
    reset_search_paths()
    reset_feature_request()

    // A flag that named a `.syslib` is refused by every command in one sentence, before any of them
    // reads its own flags -- none of them takes it, whatever it was handed.
    if names_std_lib(args[1..<args.len])
        say(s"error: ${std_lib_refusal()}")
        return Misused
    end if

    args[1] match
        "--version" ->
            say(s"sysl ${Version}")
            Fine
        "--help" ->
            say(usage())
            Fine
        "emit-ast" -> emit_ast_command(args, say)
        "emit-typed" -> emit_typed_command(args, say)
        "emit-llvm" -> emit_llvm_command(args, say)
        "build" -> build_command(args, say)
        "build-lib" -> build_lib_command(args, say)
        "build-c" -> build_c_command(args, say)
        "emit-header" -> emit_header_command(args, say)
        "run" -> run_command(args, say)
        "test" -> test_command(args, say)
        "add" -> add_command(args, say)
        "doc" -> doc_command(args, say)
        other ->
            say(s"sysl: `${other}` is not a command this compiler can carry out yet")
            say(usage())
            Misused

// `sysl emit-ast [--no-spans] <file>` -- one file's untyped parse tree, written out as deterministic
// text.
//
// **It exists so that two compilers can be diffed rather than compared by hand.** The reference
// compiler answers the same command line with the same tree in the same notation, so agreement
// between them is one `diff` over whatever corpus is to hand, and a disagreement names the node.
// Nothing is analyzed: this stops where the parser does.
private emit_ast_command(args: []string, say: string -> unit) -> int
    var spans = true
    var file = ""

    for i in 2..<args.len
        if args[i] == "--no-spans"
            spans = false
        else
            file = args[i]

    if file == ""
        say("usage: sysl emit-ast [--no-spans] <file>")
        return Misused

    read_text(file) match
        Err(_) ->
            say(s"sysl: '${file}' cannot be read")
            Failed
        Ok(text) ->
            val parsed = parse(source_of(file, text))

            if !parsed.ok()
                say(parse_report(parsed))
                return Failed

            // Every node's line ends in a newline of its own, and `say` ends the line it is given,
            // so the last one is dropped rather than written twice.
            val text = emit_ast(parsed.program, spans)

            say(if text.ends_with("\n") then text[0..<(text.len - 1)] else text)
            Fine
end emit_ast_command

// `sysl emit-typed [--no-spans] [--tables] [--target <name>] [--lib <dir>] <path>` -- one whole program's typed
// tree, or its declaration tables.
//
// **The path is a program and not a file.** A directory is the project root and everything below it
// is compiled; a single file is compiled alone, as the root module. Either way the standard module
// is read from source and analyzed with the program, so a free `print` and an `Option` mean what the
// library says they mean.
private emit_typed_command(args: []string, say: string -> unit) -> int
    var tables = false
    var named: Option[string] = None
    var file = ""
    var i: usize = 2

    while i < args.len
        // The typed tree of a program is the tree of everything it was handed, so a source root and
        // the paths a `c const` is measured under are read here as every compiling command reads
        // them.
        val took = took_search_flag(args, i)

        if took == 0
            say(emit_typed_usage())
            return Misused
        end if

        if took > 0
            if took == 2 then i += 1
        else if args[i] == "--tables"
            tables = true
        else if args[i] == "--no-spans"
            // The typed tree carries no spans yet, so the flag is taken and changes nothing. It is
            // accepted rather than refused because the whole point of this command is that two
            // compilers answer one command line.
            tables = tables
        else if args[i] == "--target"
            if i + 1 >= args.len
                say(emit_typed_usage())
                return Misused
            end if

            i += 1
            named = Some(args[i])
        else
            file = args[i]

        i += 1

    if file == ""
        say(emit_typed_usage())
        return Misused
    end if

    emit_typed_text(file, named, tables) match
        Err(why) ->
            say_failure(why, say)
            Failed
        Ok(emitted) ->
            // An analysis error is reported exactly as any other compiling command reports one,
            // with nothing on standard output.
            if !emitted.report.is_empty()
                say(analysis_report(emitted.report))
                return Failed
            end if

            say(if emitted.text.ends_with("\n") then emitted.text[0..<(emitted.text.len - 1)]
                else emitted.text)
            Fine
end emit_typed_command

// `sysl emit-llvm [--gaps] [--target <name>] [-O<level>] <path>` -- one whole program's LLVM text.
//
// **The level changes which standard-module archive is resolved, not the text**: the reference
// prints the same bytes at every level and builds or reuses the archive at the one named, so a
// level clang has no answer for is refused here exactly as a build refuses it.
//
// **The reference compiler answers this command line with the text it hands to the back end**, so
// the two are diffed rather than compared by hand. The path is a program on the same terms
// `emit-typed`'s is.
//
// **`--gaps` prints the bodies this lowering left out instead of the text**, one to a line as the
// symbol and the form it reached. A partial lowering owes a census of what it did not say, and the
// difference between the two texts is only readable next to it: a symbol the reference defines and
// this compiler does not is an absence, and this is what names the reason.
private emit_llvm_command(args: []string, say: string -> unit) -> int
    var named: Option[string] = None
    var level: Option[string] = None
    var gaps = false
    var file = ""
    var i: usize = 2

    while i < args.len
        val took = took_search_flag(args, i)

        if took == 0
            say(emit_llvm_usage())
            return Misused
        end if

        if took > 0
            if took == 2 then i += 1
        else if args[i] == "--target"
            if i + 1 >= args.len
                say(emit_llvm_usage())
                return Misused
            end if

            i += 1
            named = Some(args[i])
        else if args[i] == "--gaps"
            gaps = true
        else if took_level(args, i).0 != 0
            val given = took_level(args, i)

            if given.0 < 0
                say(emit_llvm_usage())
                return Misused
            end if

            level = Some(given.1)

            if given.0 == 2 then i += 1
        else
            file = args[i]

        i += 1

    if file == ""
        say(emit_llvm_usage())
        return Misused
    end if

    val at = build_level(file, level) match
        Err(why) ->
            say_failure(why, say)
            return Failed
        Ok(resolved) -> resolved

    emit_llvm_text(file, named, at) match
        Err(why) ->
            say_failure(why, say)
            Failed
        Ok(emitted) ->
            if !emitted.report.is_empty()
                say(analysis_report(emitted.report))
                return Failed
            end if

            if gaps
                for i in 0..<emitted.gaps.len()
                    say(s"${emitted.gaps.at(i).0}\t${emitted.gaps.at(i).1}")

                return Fine
            end if

            say(if emitted.text.ends_with("\n") then emitted.text[0..<(emitted.text.len - 1)]
                else emitted.text)
            Fine
end emit_llvm_command

private emit_llvm_usage() -> string =
    "usage: sysl emit-llvm [--gaps] [--target <name>] [-O<level>] " + where_flags() + " <path>"

// `sysl build [--target <name>] [--cc <path>] [-O<level>] [-o <exe>] <path>` -- one program, made
// into something the machine will run.
//
// **The text is exactly what `emit-llvm` prints**, so a build and a diff are the same lowering seen
// twice; what this adds is the toolchain the text is handed to. `--cc` names the clang instead of
// searching for one, and a person who wrote one down is owed an error rather than a different
// compiler.
private build_command(args: []string, say: string -> unit) -> int
    var named: Option[string] = None
    var cc: Option[string] = None
    var out: Option[string] = None
    var level: Option[string] = None
    var file = ""
    var i: usize = 2

    while i < args.len
        val took = took_search_flag(args, i)

        if took == 0
            say(build_usage())
            return Misused
        end if

        val featured = took_feature_flag(args, i)

        if featured == 0
            say(build_usage())
            return Misused
        end if

        if took > 0
            if took == 2 then i += 1
        else if featured > 0
            if featured == 2 then i += 1
        else if args[i] == "--target" || args[i] == "--cc" || args[i] == "-o"
            if i + 1 >= args.len
                say(build_usage())
                return Misused
            end if

            val flag = args[i]

            i += 1

            if flag == "--target" then named = Some(args[i])
            else if flag == "--cc" then cc = Some(args[i])
            else out = Some(args[i])
        else if took_level(args, i).0 != 0
            val given = took_level(args, i)

            if given.0 < 0
                say(build_usage())
                return Misused
            end if

            level = Some(given.1)

            if given.0 == 2 then i += 1
        else
            file = args[i]

        i += 1

    if file == ""
        say(build_usage())
        return Misused
    end if

    if refused_features(say) then return Failed

    val at = build_level(file, level) match
        Err(why) ->
            say_failure(why, say)
            return Failed
        Ok(resolved) -> resolved

    build_native_program(file, named, cc, at, out) match
        Err(why) ->
            say_failure(why, say)
            Failed
        Ok(exe) ->
            say(s"wrote $exe")
            Fine
end build_command

// The one place a command's failure becomes output, and the two kinds are printed differently
// **because only one of them is a sentence**: a refusal about the project has no `error: ` on it and
// takes one here, where an analysis report is already rendered and every diagnostic in it carries
// its own. Prefixing both is what printed `error: error:`.
private say_failure(why: Failure, say: string -> unit)
    why match
        Said(refusal) -> say(s"error: ${refusal.message}")
        Reported(report) -> say(report)

// An optimization level at `args[i]`, spelled the way clang spells it -- `-O2` joined, `-O 2` apart
// -- or as `--optimize 2`: how many arguments it took and the level they named. `0` is "not a level
// flag", and `-1` a separate spelling with nothing after it. **Only a capital `O`**, since `-o` is
// the output path and neither may quietly answer for the other.
took_level(args: []string, i: usize) -> (int, string)
    if args[i] == "-O" || args[i] == "--optimize"
        return if i + 1 < args.len then (2, args[i + 1]) else (-1, "")
    end if

    if args[i].len > 2 && args[i].starts_with("-O") then return (1, args[i][2..<args[i].len])

    (0, "")
end took_level

private build_usage() -> string =
    "usage: sysl build [--target <name>] [--cc <path>] [-O<level>] [-o <exe>] " + where_flags() +
    " " + feature_flags() + " <path>"

// The one refusal a feature request is given before any manifest is read: `--all-features` beside
// either of the flags that say something narrower. Whether it fired.
private refused_features(say: string -> unit) -> bool = feature_conflict() match
    Some(why) ->
        say(s"error: $why")
        true
    None -> false

// `sysl build-c [--target <name>] [--cc <path>] [-O<level>] [-o <archive>] [--header <path>] <path>`
// -- a module compiled to a static archive and a C header, for a C project to link against.
//
// **It is what CMake and Gradle call**, which is why the two paths it writes are both reported: a
// build script names one of them and has to be able to find the other.
private build_c_command(args: []string, say: string -> unit) -> int
    var named: Option[string] = None
    var cc: Option[string] = None
    var out: Option[string] = None
    var header: Option[string] = None
    var level: Option[string] = None
    var lto: Option[string] = None
    var file = ""
    var i: usize = 2

    while i < args.len
        val took = took_search_flag(args, i)

        val featured = took_feature_flag(args, i)

        if took == 0 || featured == 0
            say(build_c_usage())
            return Misused
        end if

        if took > 0
            if took == 2 then i += 1
        else if featured > 0
            if featured == 2 then i += 1
        else if args[i] == "--target" || args[i] == "--cc" || args[i] == "-o" || args[i] == "--header" ||
                args[i] == "--lto"
            if i + 1 >= args.len
                say(build_c_usage())
                return Misused
            end if

            val flag = args[i]

            i += 1

            if flag == "--target" then named = Some(args[i])
            else if flag == "--cc" then cc = Some(args[i])
            else if flag == "--header" then header = Some(args[i])
            else if flag == "--lto"
                // A mode clang does not have is the command line's mistake, told before anything is
                // read, as the reference's parser tells it.
                if args[i] != "thin" && args[i] != "full"
                    say(s"sysl: error: '--lto ${args[i]}' names no kind of link-time optimization " +
                        "clang has — it is thin or full")
                    say(build_c_usage())
                    return Misused
                end if

                lto = Some(args[i])
            else out = Some(args[i])
        else if took_level(args, i).0 != 0
            val given = took_level(args, i)

            if given.0 < 0
                say(build_c_usage())
                return Misused
            end if

            level = Some(given.1)

            if given.0 == 2 then i += 1
        else
            file = args[i]

        i += 1

    if file == ""
        say(build_c_usage())
        return Misused
    end if

    if refused_features(say) then return Failed

    val at = build_level(file, level) match
        Err(why) ->
            say_failure(why, say)
            return Failed
        Ok(resolved) -> resolved

    // The two paths written are said by the build, ahead of the advice about what to link them with.
    build_c_archive(file, named, cc, at, out, header, say, lto) match
        Err(why) ->
            say_failure(why, say)
            Failed
        Ok(_) -> Fine
end build_c_command

private build_c_usage() -> string =
    "usage: sysl build-c [--target <name>] [--cc <path>] [-O<level>] [-o <archive>] " +
    "[--header <path>] [--lto thin|full] " + where_flags() + " " + feature_flags() + " <path>\n" +
    "  --lto <mode>  make the archive's members LLVM bitcode for this mode of link-time " +
    "optimization, 'thin' or 'full', so a host linking with clang and lld can optimize across the " +
    "boundary. Without it the members are native objects any C toolchain links, and the project's " +
    "'lto' key does not change that"

// `sysl emit-header <path>` -- the header `build-c` would write, printed, with nothing built.
private emit_header_command(args: []string, say: string -> unit) -> int
    var named: Option[string] = None
    var file = ""
    var i: usize = 2

    while i < args.len
        val took = took_search_flag(args, i)

        if took == 0
            say(emit_header_usage())
            return Misused
        end if

        if took > 0
            if took == 2 then i += 1
        else if args[i] == "--target"
            if i + 1 >= args.len
                say(emit_header_usage())
                return Misused
            end if

            i += 1
            named = Some(args[i])
        else
            file = args[i]

        i += 1

    if file == ""
        say(emit_header_usage())
        return Misused
    end if

    c_header_of(file, named) match
        Err(why) ->
            say_failure(why, say)
            Failed
        Ok(text) ->
            say(text.trim_end())
            Fine
end emit_header_command

private emit_header_usage() -> string =
    "usage: sysl emit-header [--target <name>] " + where_flags() + " <path>"

// `sysl run [--target <name>] [--cc <path>] [-O<level>] <path> [-- <args>]` -- one program, built and
// then run, with whatever it exits with passed straight back to the shell.
//
// **Everything after `--` is the program's**, which is what keeps a program free to take an option
// this compiler also takes. The program is handed its own path as its first argument, as a program
// started any other way is.
private run_command(args: []string, say: string -> unit) -> int
    var named: Option[string] = None
    var cc: Option[string] = None
    var level: Option[string] = None
    var file = ""
    var forwarding = false
    var program_args: Buf[string] = buf()
    var i: usize = 2

    while i < args.len
        if forwarding
            program_args.push(args[i])
        else if args[i] == "--"
            forwarding = true
        else
            val took = took_search_flag(args, i)

            val featured = took_feature_flag(args, i)

            if took == 0 || featured == 0
                say(run_usage())
                return Misused
            end if

            if took > 0
                if took == 2 then i += 1
            else if featured > 0
                if featured == 2 then i += 1
            else if args[i] == "--target" || args[i] == "--cc"
                if i + 1 >= args.len
                    say(run_usage())
                    return Misused
                end if

                val flag = args[i]

                i += 1

                if flag == "--target" then named = Some(args[i]) else cc = Some(args[i])
            else if took_level(args, i).0 != 0
                val given = took_level(args, i)

                if given.0 < 0
                    say(run_usage())
                    return Misused
                end if

                level = Some(given.1)

                if given.0 == 2 then i += 1
            else
                file = args[i]

        i += 1

    if file == ""
        say(run_usage())
        return Misused
    end if

    if refused_features(say) then return Failed

    val at = build_level(file, level) match
        Err(why) ->
            say_failure(why, say)
            return Failed
        Ok(resolved) -> resolved

    run_native_program(file, named, cc, at, program_args) match
        Err(why) ->
            say_failure(why, say)
            Failed
        Ok(code) -> code
end run_command

private run_usage() -> string =
    "usage: sysl run [--target <name>] [--cc <path>] [-O<level>] " + where_flags() + " " +
    feature_flags() + " <path> [-- <args>]"

// The flags every command that compiles a program takes, written once so that seven usage lines
// cannot come to disagree about them. `--lib` names a source **directory** and may be given more
// than once.
private where_flags() -> string =
    "[--lib <dir>] [--include-path <dir>|<name>=<dir>] [--link-path <dir>] [-D <macro>]"

private emit_typed_usage() -> string =
    "usage: sysl emit-typed [--no-spans] [--tables] [--target <name>] " + where_flags() + " <path>"

// `sysl test [--filter <text>] [--fail-fast] [--target <name>] [--cc <path>] [-O<level>] <path>` --
// the `@test` functions of a tree, built into one binary and run one process each.
//
// **The report is written as the run goes rather than at the end**, which is why it does not go
// through `say`: a suite that takes half an hour is watched from a log file while it runs, and a run
// that is killed partway still has a report of everything up to the kill. Every decision the command
// makes is still somewhere a test can reach -- `run_selected` takes the sink it writes through, and
// the four pieces it writes are each a function of their own.
private test_command(args: []string, say: string -> unit) -> int
    var named: Option[string] = None
    var cc: Option[string] = None
    var filter: Option[string] = None
    var fail_fast = false
    var std = false
    var named_level: Option[string] = None
    var file = ""
    var i: usize = 2

    while i < args.len
        val took = took_search_flag(args, i)
        val featured = took_feature_flag(args, i)

        if took == 0 || featured == 0
            say(test_usage())
            return Misused
        end if

        if took > 0
            if took == 2 then i += 1
        else if featured > 0
            if featured == 2 then i += 1
        else if args[i] == "--target" || args[i] == "--cc" || args[i] == "--filter"
            if i + 1 >= args.len
                say(test_usage())
                return Misused
            end if

            val flag = args[i]

            i += 1

            if flag == "--target" then named = Some(args[i])
            else if flag == "--cc" then cc = Some(args[i])
            else filter = Some(args[i])
        else if args[i] == "--fail-fast"
            fail_fast = true
        else if args[i] == "--std"
            std = true
        else if took_level(args, i).0 != 0
            val given = took_level(args, i)

            if given.0 < 0
                say(test_usage())
                return Misused
            end if

            named_level = Some(given.1)

            if given.0 == 2 then i += 1
        else
            file = args[i]

        i += 1

    if file == ""
        say(test_usage())
        return Misused
    end if

    if refused_features(say) then return Failed

    // A silent request under test turns on every feature the root declares: gated code the ordinary
    // build never compiles is code the suite would otherwise never see.
    set_feature_testing()

    val level = build_level(file, named_level) match
        Err(why) ->
            say_failure(why, say)
            return Failed
        Ok(resolved) -> resolved

    // **What was built last time, where nothing that can reach the bytes has changed**
    // (`run_cache.sysl`). It is asked before anything is analyzed, because the compile is the whole
    // of what a second `sysl test` over an unchanged tree costs.
    // A `--std` build keeps its own entries: the tree is compiled as the library rather than against
    // one, so the same sources at the same machine come to different bytes.
    val key = run_cache_key_for(if std then "test --std" else "test", file, named, level, cc)

    cached_test_build(key) match
        Some(hit) -> return tests_run(file, hit.0, hit.1, filter, fail_fast, false, say)
        None -> ()

    val made_build = if std then std_test_build_of(file, named)
    else test_build_of(file, named, level)

    val build = made_build match
        Err(why) ->
            say_failure(why, say)
            return Failed
        Ok(made) -> made

    if !build.emitted.report.is_empty()
        say(analysis_report(build.emitted.report))
        return Failed
    end if

    // Asked before anything is linked, so a tree with nothing to run pays for no toolchain.
    nothing_to_run(file, build.tests, filter, say) match
        Some(code) -> return code
        None -> ()

    val made = build_test_binary_cached(file, build, cc, level, key) match
        Err(refusal) ->
            say(s"error: ${refusal.message}")
            return Failed
        Ok(built) -> built

    // The list is written **after** the binary and read back before either is used, so a run that
    // died between the two leaves a slot the next one rebuilds rather than one it half believes.
    if made.1 then write_test_list(key.unwrap(), build.tests)

    tests_run(file, made.0, build.tests, filter, fail_fast, !made.1, say)
end test_command

// Nothing to run is not nothing to say. A tree with no tests at all and a filter that matched none of
// the tests there are lead to the same empty report and are different mistakes, so each is named.
// Neither is a failure: a program is allowed to have no tests.
private nothing_to_run(file: string, all: Buf[TTest], filter: Option[string],
                       say: string -> unit) -> Option[int]
    if all.is_empty()
        say(s"no '@test' functions in $file")
        return Some(Fine)
    end if

    if selected_tests(all, filter).is_empty()
        say(s"no test matches '${filter.unwrap_or("")}' — ${all.len()} to choose from")
        return Some(Fine)
    end if

    None
end nothing_to_run

// The chosen tests, run and reported. `discard` is false for a binary in the cache, which is the
// whole point of it being there.
private tests_run(file: string, exe: string, all: Buf[TTest], filter: Option[string],
                  fail_fast: bool, discard: bool, say: string -> unit) -> int
    nothing_to_run(file, all, filter, say) match
        Some(code) -> return code
        None -> ()

    val chosen = selected_tests(all, filter)
    val outcomes = run_selected(exe, chosen, TestOptions(filter, fail_fast),
                                all.len() - chosen.len(), piece -> stream_out(piece))

    if discard then discard_test_binary(exe)

    var failed: usize = 0

    for j in 0..<outcomes.len()
        if !outcomes.at(j).passed() then failed += 1

    if failed == 0 then Fine else Failed
end tests_run

private test_usage() -> string = "usage: sysl test [--filter <text>] [--fail-fast] [--std] " +
    "[--target <name>] [--cc <path>] [-O<level>] " + where_flags() + " " + feature_flags() + " <path>"

// `sysl build-lib [--std] [--target <name>] <path>` -- a library held to being a library for one
// machine.
//
// **`--std` says the tree is sysl's own standard module**, which is the one thing an ordinary
// compilation may not declare and is therefore written down rather than inferred: nothing is
// prepended, no artifact is linked, and the artifact lands in the cache where a compilation looks.
//
// **Without it the tree is an ordinary library**, compiled against the standard module, and nothing
// is written: `checked <root>` is the whole answer. What the command is run for is the analysis --
// it type-checks a package for a machine this one is not, which is the only check a board package
// gets.
private build_lib_command(args: []string, say: string -> unit) -> int
    var named: Option[string] = None
    var level: Option[string] = None
    var std = false
    var file = ""
    var i: usize = 2

    while i < args.len
        val took = took_search_flag(args, i)

        if took == 0
            say(build_lib_usage())
            return Misused
        end if

        if took > 0
            if took == 2 then i += 1
        else if args[i] == "-o" || args[i] == "--output"
            say(s"error: ${build_lib_output_refusal()}")
            return Misused
        else if args[i] == "--target"
            if i + 1 >= args.len
                say(build_lib_usage())
                return Misused
            end if

            i += 1
            named = Some(args[i])
        else if args[i] == "--std"
            std = true
        else if took_level(args, i).0 != 0
            val given = took_level(args, i)

            if given.0 < 0
                say(build_lib_usage())
                return Misused
            end if

            level = Some(given.1)

            if given.0 == 2 then i += 1
        else
            file = args[i]

        i += 1

    if file == ""
        say(build_lib_usage())
        return Misused
    end if

    val at = build_level(file, level) match
        Err(why) ->
            say_failure(why, say)
            return Failed
        Ok(resolved) -> resolved

    if !std
        return build_library_of(file, named, at) match
            Err(why) ->
                say_failure(why, say)
                Failed
            Ok(root) ->
                say(s"checked $root")
                Fine
    end if

    build_std_artifact_of(file, named, None, at) match
        Err(refusal) ->
            say(s"error: ${refusal.message}")
            Failed
        Ok(where) ->
            say(s"wrote $where")
            Fine
end build_lib_command

private build_lib_usage() -> string =
    "usage: sysl build-lib [--std] [--target <name>] [-O<level>] " + where_flags() + " <path>"

// What is said of `-o` given to `build-lib`, which is refused before anything is read.
//
// **The command writes nothing anybody names**: it checks a library, and what it compiled on the way
// is this compiler's cache -- a `--std` build fills the standard module's entry there, found by every
// compilation after it without being named. A path to write to is a promise of a file somebody will
// hand to something, and nothing takes one any more.
build_lib_output_refusal() -> string =
    "build-lib writes nothing anybody names — it checks a library, and what it compiles is this " +
    "compiler's cache, found by the compiler alone — so it takes no -o"

// One piece of a report, written and **flushed**, so that a run followed through a log file shows each
// verdict as it lands rather than only once the process exits. The pieces carry their own newlines,
// which is what makes the concatenation of them the whole report.
private stream_out(piece: string)
    prints(piece)
    c_flush_all(null)

// Standard output is buffered when it is not a terminal, which is exactly the case a streaming report
// is for. There is no flush in the library's printing surface, so the C one is named here.
private extern "fflush" c_flush_all(stream: *u8) -> int

// `sysl add <coordinate>[@<version>] [<path>]` -- one dependency written into a project's manifest.
//
// The version is what the repository's newest release tag says where the command line pins none, and
// the manifest is rewritten by changing the smallest run of bytes that has to change. Nothing is
// fetched: the next build is what goes and gets it.
private add_command(args: []string, say: string -> unit) -> int
    var spec = ""
    var root = "."
    var extra: usize = 0
    var i: usize = 2

    while i < args.len
        if spec.is_empty() then spec = args[i]
        else if extra == 0
            root = args[i]
            extra += 1
        else
            say(add_usage())
            return Misused

        i += 1

    if spec.is_empty()
        say(add_usage())
        return Misused

    add_to_project(root, spec) match
        Err(why) ->
            say(s"error: $why")
            Failed
        Ok(said) ->
            say(said)
            Fine
end add_command

private add_usage() -> string = "usage: sysl add <coordinate>[@<version>] [<path>]"

usage() -> string = "usage: sysl --version | --help | emit-ast [--no-spans] <file> | " +
    "emit-typed [--no-spans] [--tables] [--target <name>] <path> | " +
    "emit-llvm [--target <name>] [-O<level>] <path> | " +
    "build [--target <name>] [--cc <path>] [-O<level>] [-o <exe>] <path> | " +
    "build-c [--target <name>] [--cc <path>] [-O<level>] [-o <archive>] [--header <path>] " +
    "[--lto thin|full] <path> | emit-header [--target <name>] <path> | " +
    "run [--target <name>] [--cc <path>] [-O<level>] <path> [-- <args>] | " +
    "test [--filter <text>] [--fail-fast] [--target <name>] [--cc <path>] [-O<level>] <path> | " +
    "add <coordinate>[@<version>] [<path>] | " +
    "doc [-o <dir>] [-t <title>] [-n <note>] [-w <n>] [-V <version>] [--private] [--check] [<dir>]\n" +
    "build, build-c, run and test, which resolve a package graph, also take " + feature_flags() +
    ": a feature of the root project to turn on beside 'default', comma-separated and repeatable; " +
    "leave the root's 'default' feature off; turn on every feature the root's manifest declares"

main(args: []string)
    val code = run_cli(args, line -> print(line))

    if code != Fine then exit(code)
