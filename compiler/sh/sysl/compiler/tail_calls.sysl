module sh.sysl.compiler

import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}

// Which of a function's calls to itself are the last thing it does, and so can be a jump back to its
// own entry instead of a second frame.
//
// The whole of the transformation is here and in the function emitter, and the division is the usual
// one: this pass decides, codegen emits. A call named here is one where replacing the frame is
// invisible — the caller's locals are already released along the same edge a `return` would release
// them on, and what the callee does with the frame is what the caller was going to do with the value
// it handed back, which is return it.
//
// **Missing a tail call costs nothing; naming one wrongly costs everything.** So the walk below is
// deliberately incomplete rather than deliberately clever: it recognizes the shapes a recursive
// function is actually written in — the body's trailing expression, a `return`, and the arms of the
// `if` and `match` those reach through — and says no to anything it has not thought about.

// The self-calls in `f` that codegen may lower as a jump to its entry, by where each was written.
//
// The reference compares them by **identity**, which is the same thing said of a tree whose nodes
// are shared: what is wanted is *this* call and not another written alike. A span is what this tree
// has that says which occurrence a node is, and two calls to one function at one span are one call.
tail_calls_of(f: TFunc) -> Buf[Span]
    var out: Buf[Span] = buf()

    for item in self_calls_in_tail(f)
        if !may_reach_frame(f, item.args) then out.push(item.span)

    out
end tail_calls_of

// A self-call in tail position and the arguments it passes, before the arguments are asked whether
// they may point into the frame the jump would reuse.
private struct TailSite
    span: Span
    args: Buf[TExpr]

private self_calls_in_tail(f: TFunc) -> Buf[TailSite]
    if tailrec_disqualified(f).is_some() then return buf()

    // A call of an async function makes a task rather than running the body, so nothing in one is a
    // jump back to its own top.
    if f.marks.is_async() then return buf()

    var out: Buf[TailSite] = buf()

    tail_block(f, f.body, false, &out)
    out
end self_calls_in_tail

// Whether the call at this span is one the walk named.
is_tail_call(found: Buf[Span], at: Span) -> bool
    for item in found
        if item == at then return true

    false
end is_tail_call

// Why a function is not a candidate at all, as the sentence `@tailrec` reports. These are properties
// of the *declaration*, so they are answered once rather than at each call, and they are the cases
// where a jump would change what the program does rather than only what it costs.
tailrec_disqualified(f: TFunc) -> Option[string]
    // A variadic function's tail is read relative to its last named argument, and the arguments a
    // jump rebinds are the named ones — so the second iteration would walk the first call's tail.
    if f.variadic
        return Some("it is variadic, and a jump back to the entry cannot rebind the tail the " +
                    "first call was passed")

    // A `va_list` parameter's slot may be the caller's own storage rather than one of this frame's,
    // so a jump would write the next walk over the one it was handed.
    for p in f.params
        if underlying(p.1) == VaList then
            return Some(s"'${p.0}' is a va_list, received where the caller's walk is, and a jump " +
                        "back to the entry would write the next call's walk over it")

    // A postcondition is checked **when a call returns**, and a tail call never returns: the frame
    // that would have checked it is the frame being replaced.
    if !f.ensures.is_empty()
        return Some("it has an 'ensures', which is checked when a call returns — a tail call " +
                    "never returns, so the postcondition of every frame but the last would go " +
                    "unchecked")

    None
end tailrec_disqualified

// The tail positions of a block: everything its statements can return from, and its trailing
// expression.
//
// `deferred` arrives true where some enclosing scope has already registered a `defer`, and turns
// true at the first one this block registers. A deferred statement runs on the way *out* of the
// scope, which for an ordinary call is after the callee has returned and for a jump would be before
// it is even entered.
private tail_block(f: TFunc, b: TBlock, deferred: bool, out: *Buf[TailSite])
    val after = tail_stmts(f, b.stmts, deferred, out)

    b.result match
        Some(r) -> tail_expr(f, r, after, out)
        None -> ()
end tail_block

// Walks a statement list in order, answering whether a `defer` was registered along the way — which
// the caller needs, because the block's trailing expression sits after all of them.
private tail_stmts(f: TFunc, ss: Buf[TStmt], deferred: bool, out: *Buf[TailSite]) -> bool
    var d = deferred

    for item in ss
        item match
            // Registering one puts every tail position after it — in this block and in every block
            // it encloses — out of reach.
            TDefer(inner) ->
                tail_stmts(f, inner, true, out)
                d = true
            TReturn(value) ->
                value match
                    Some(e) -> tail_expr(f, e, d, out)
                    None -> ()

            // A block-bearing expression in statement position yields no value, so nothing in it is
            // in tail position. What it can still hold is a `return`.
            TExprStmt(e) -> nested_returns(f, e, d, out)
            _ -> ()

    d
end tail_stmts

// What an expression in tail position contributes: itself, where it is a self-call the jump can
// replace, and whatever its arms hold where it is a form that has arms.
private tail_expr(f: TFunc, e: TExpr, deferred: bool, out: *Buf[TailSite])
    *e.kind match
        TCall(name, args, ty, _) ->
            if !deferred && is_self_call(f, name, args, ty) then out.push(TailSite(e.span, args))

        // Both arms end the function, so both are tail positions — and they are independent, so a
        // function may jump back from one and return from the other.
        TIf(_, t, els, _) ->
            tail_block(f, t, deferred, out)

            els match
                Some(b) -> tail_block(f, b, deferred, out)
                None -> ()
        TMatch(_, arms, _) ->
            for arm in arms
                tail_block(f, arm.body, deferred, out)
        _ -> nested_returns(f, e, deferred, out)
end tail_expr

// The `return`s inside an expression whose own value is **not** in tail position. Only the forms
// that carry statements are followed: a `return` is a statement, so it can be nowhere else.
private nested_returns(f: TFunc, e: TExpr, deferred: bool, out: *Buf[TailSite])
    *e.kind match
        TIf(_, t, els, _) ->
            tail_stmts(f, t.stmts, deferred, out)

            els match
                Some(b) -> tail_stmts(f, b.stmts, deferred, out)
                None -> ()
        TMatch(_, arms, _) ->
            for arm in arms
                tail_stmts(f, arm.body.stmts, deferred, out)

        // A copy of an unrolled `for const` may `return`, and its own value is not in tail position:
        // the copies are a sequence, so only the last of them could be.
        TBlockExpr(b) -> tail_stmts(f, b.stmts, deferred, out)

        // A loop's body may return, and none of it is in tail position however the loop ends: the
        // value a `break` carries is the loop's, and the loop's value is what the expression around
        // it goes on to use.
        TWhile(_, body, els, _) -> loop_returns(f, body, els, deferred, out)
        TDoWhile(body, _, els, _) -> loop_returns(f, body, els, deferred, out)
        TLoop(body, _) -> loop_returns(f, body, None, deferred, out)
        TFor(_, _, _, _, _, body, els, _) -> loop_returns(f, body, els, deferred, out)
        TCFor(_, _, _, body, els, _) -> loop_returns(f, body, els, deferred, out)
        TForEach(_, _, _, body, els, _) -> loop_returns(f, body, els, deferred, out)
        TIterate(_, _, _, _, _, body, els, _) -> loop_returns(f, body, els, deferred, out)
        _ -> ()
end nested_returns

private loop_returns(f: TFunc, body: Buf[TStmt], els: Option[TBlock], deferred: bool,
                     out: *Buf[TailSite])
    tail_stmts(f, body, deferred, out)

    els match
        Some(b) -> tail_stmts(f, b.stmts, deferred, out)
        None -> ()
end loop_returns

// Whether a call in tail position is one to the very function it stands in, at the shape a jump can
// rebind.
//
// The name is the mangled one on both sides, so a generic's instantiation matches its own recursive
// call and not the instantiation beside it. The result type is checked rather than assumed: a call
// whose result is wrapped reaches here as the wrapper's operand and not as the tail expression.
private is_self_call(f: TFunc, name: string, args: Buf[TExpr], ty: Type) -> bool =
    name == f.name && type_eq(ty, f.ret_ty) && args.len() == f.params.len()

// Whether an argument of this self-call may point into the caller's own frame.
//
// A jump keeps the frame: the locals are released on the way to it, exactly as a `return` would
// release them, and every slot is the one the next round writes. So an argument holding the address
// of a local, a parameter or a temporary would be read after its storage was disposed of and then
// overwritten — `decl(&sub, …)` hands the next round a `P` whose buffer is already freed. A real call
// keeps the storage alive until the callee is done with it, so such a call stays a call.
//
// The question is answered from the whole body rather than from the argument's spelling, because an
// address can be taken in one place and passed in another (`val q = &sub` and later `decl(q, …)`): a
// body that never takes the address of its own storage cannot hand any out, and one that does keeps
// every self-call whose arguments could carry an address.
private may_reach_frame(f: TFunc, args: Buf[TExpr]) -> bool
    var carried = false

    for item in args
        if may_hold_address(texpr_type(item)) then carried = true

    carried && takes_frame_address(f)
end may_reach_frame

// Whether a value of this type could hold an address: a pointer, a view, or something made of one.
// A reference, a weak reference and a string are counted heap objects, so they hold none that a
// frame owns.
private may_hold_address(t: Type) -> bool = nameless(underlying(t)) match
    Ptr(_) -> true
    Slice(_, _) -> true
    Array(_, elem) -> may_hold_address(*elem)
    Pack(elems) -> any_holds_address(elems)
    Struct(d) -> field_holds_address(d.fields)
    Enum(d) -> variant_holds_address(d.variants)
    _ -> false

private any_holds_address(ts: Buf[Type]) -> bool
    for item in ts
        if may_hold_address(item) then return true

    false

private field_holds_address(fields: Buf[(string, Type)]) -> bool
    for item in fields
        if may_hold_address(item.1) then return true

    false

private variant_holds_address(vs: Buf[EnumVariant]) -> bool
    for item in vs
        if field_holds_address(item.fields) then return true

    false

// Whether the body anywhere takes the address of storage in its own frame: `&` of a place, or a
// slice of an array, rooted in a local, a parameter or a temporary. A place reached through a
// dereference, a global, or the element of a slice is storage somebody else owns.
private takes_frame_address(f: TFunc) -> bool
    val found: &FrameAddress = FrameAddress(false)

    walk_block_stmts(f.body, expr_walk(false, e -> note_frame_address(found, e)))
    found.taken
end takes_frame_address

private struct FrameAddress
    taken: bool

private note_frame_address(found: &FrameAddress, e: TExpr)
    *e.kind match
        TAddrOf(place, _) -> if frame_rooted(place) then found.taken = true
        TSlice(base, _, _, _, _) ->
            nameless(underlying(texpr_type(base))) match
                Array(_, _) -> if frame_rooted(base) then found.taken = true
                _ -> ()
        _ -> ()

// Whether a place lives in the frame. Anything that is not a recognised path into other storage is
// answered yes: a temporary is frame storage too, and missing a jump costs nothing.
private frame_rooted(place: TExpr) -> bool = *place.kind match
    TGlobal(_, _, _) -> false
    TDeref(_, _) -> false
    TField(r, _, _) -> frame_rooted(r)
    TIndex(r, _, _) -> nameless(underlying(texpr_type(r))) match
        Array(_, _) -> frame_rooted(r)
        _ -> false
    TSlice(b, _, _, _, _) -> nameless(underlying(texpr_type(b))) match
        Array(_, _) -> frame_rooted(b)
        _ -> false
    _ -> true

// -- what `@tailrec` earns ----------------------------------------------------------------------------

// The refusals `@tailrec` earns across a whole program: one sentence per function that asked for the
// jump and did not get it.
//
// The attribute is an assertion rather than a request — the optimization applies wherever it
// applies, written or not — so what it buys is exactly this diagnostic.
check_tail_calls(a: &Analysis, funcs: Buf[TFunc])
    for i in 0..<funcs.len()
        val f = funcs.at(i)

        if f.tailrec
            tailrec_disqualified(f) match
                Some(why) ->
                    a.fault(func_home(a, f.name), f.span,
                            s"'${qualified_name(f.name)}' is marked '@tailrec' but $why")
                None ->
                    if !tail_calls_of(f).is_empty() then continue

                    if !self_calls_in_tail(f).is_empty()
                        a.fault(func_home(a, f.name), f.span,
                                s"'${qualified_name(f.name)}' is marked '@tailrec' but its tail " +
                                "call may pass an address in its own frame — a jump reuses the " +
                                "frame, so what the argument points at would be released and " +
                                "written over before the next round reads it")
                    else
                        a.fault(func_home(a, f.name), f.span,
                                s"'${qualified_name(f.name)}' is marked '@tailrec' but calls itself " +
                                "nowhere the jump can replace — a tail call is the last thing the " +
                                "function does, so nothing may wait on its result and no 'defer' " +
                                "may be in scope where it stands")
end check_tail_calls
