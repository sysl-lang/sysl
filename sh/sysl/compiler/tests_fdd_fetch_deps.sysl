module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.fs.{entries, exists, make_dir_all, make_temp_dir, pending_name, publish_dir, read_text, remove_dir_all, write_text}
import sysl.text.{join, Search}

// Getting a package's source onto this machine, and what it is checked against on the way; the graph
// `sysl deps` prints; and the analysis answering whether a file is clean. The reference's
// `FetchTests`, `DepsCliTests` and `DefinitionIndexTests`.
//
// **Every cache here is built by hand in a directory of its own**, as a fetch would have left it: the
// clone itself is one `git` invocation and the decisions are all either side of it -- whether a
// populated cache may be trusted, what a `sysl.sum` disagreement says, and what happens to a
// directory nothing vouches for. **Every string quoted was read out of the reference compiler.**

private fdd_cache() -> string = make_temp_dir("sysl-fdd-cache").unwrap()

private fdd_digest(of: string) -> string
    var out = DigestPrefix

    for i in 0..<64
        out = out + of

    out
end fdd_digest

private fdd_manifest(name: string, version: string, deps: string) -> string =
    s"package { name = \"$name\", version = \"$version\" }\n" +
    (if deps.is_empty() then "" else s"dependencies { $deps }\n")

private fdd_dep(label: string, coordinate: string, version: string) -> string =
    s"$label { git = \"$coordinate\", version = \"$version\" }"

// A package in the cache holding one module, as a fetch would have left it, with no hash beside it.
private fdd_published(cache: string, coordinate: string, version: Release, module_name: string,
                      deps: string) -> string
    val dir = fetch_directory(cache, coordinate, version)

    make_dir_all(s"$dir/$module_name").unwrap()
    write_text(join_path(dir, ManifestName), fdd_manifest(module_name, release_shown(version), deps))
        .unwrap()
    write_text(s"$dir/$module_name/$module_name.sysl", s"module $module_name\n").unwrap()
    dir
end fdd_published

// The hash a fetch writes beside the directory it verified.
private fdd_record(dir: string) -> string
    val hash = tree_hash(dir).unwrap()

    write_text(s"$dir.hash", s"$hash\n").unwrap()
    hash
end fdd_record

// A project on disk, holding only its manifest -- or nothing at all where the text is empty.
private fdd_project(config: string) -> string
    val root = make_temp_dir("sysl-fdd-project").unwrap()

    if !config.is_empty() then write_text(join_path(root, ManifestName), config).unwrap()

    root
end fdd_project

// A path dependency: a project with one module of its own, so that it offers a name.
private fdd_helper(config: string) -> string
    val root = fdd_project(config)

    make_dir_all(s"$root/helper").unwrap()
    write_text(s"$root/helper/helper.sysl", "module helper\n").unwrap()
    root
end fdd_helper

private fdd_json() -> Dependency =
    plain_dependency("json", Git("github.com/e/json", Release(1, 4, 0)), None)

private fdd_v140() -> Release = Release(1, 4, 0)

// -- where a package lands, and whether a populated cache may be trusted ----------------------------

@test("fdd: where a package lands")
fdd_where_a_package_lands()
    assert_eq(fetch_directory("/cache", "github.com/e/json/v2", Release(2, 1, 0)),
              "/cache/github.com/e/json/v2/@v2.1.0")

@test("fdd: a cached package is used where nothing records what it should hash to")
fdd_used_where_nothing_records()
    val cache = fdd_cache()
    val dir = fdd_published(cache, "github.com/e/json", fdd_v140(), "json", "")
    val got = fetch_ensure(fdd_json(), empty_sums(), cache)

    assert_eq(got.unwrap().root, dir)
    assert(got.unwrap().hash.is_none())
    remove_dir_all(cache).unwrap_or(())
end fdd_used_where_nothing_records

// Otherwise a project depending on something another project had already fetched would write no
// `sysl.sum` line at all, and so would never be checked afterwards.
@test("fdd: a cached package answers with what was recorded, so a project that did not fetch it can still record it")
fdd_answers_with_what_was_recorded()
    val cache = fdd_cache()
    val hash = fdd_record(fdd_published(cache, "github.com/e/json", fdd_v140(), "json", ""))

    assert_eq(fetch_ensure(fdd_json(), empty_sums(), cache).unwrap().hash.unwrap(), hash)
    remove_dir_all(cache).unwrap_or(())
end fdd_answers_with_what_was_recorded

@test("fdd: a cached package is refused when the record and sysl.sum disagree")
fdd_refused_when_the_two_disagree()
    val cache = fdd_cache()

    fdd_record(fdd_published(cache, "github.com/e/json", fdd_v140(), "json", ""))

    val sums = sums_recording(empty_sums(), "github.com/e/json", fdd_v140(), fdd_digest("a"))
    val said = fetch_ensure(fdd_json(), sums, cache).unwrap_err()

    assert(said.index_of("does not hash to what sysl.sum records").is_some(), said)
    assert(said.index_of("A version's content is not supposed to change").is_some(), said)
    remove_dir_all(cache).unwrap_or(())
end fdd_refused_when_the_two_disagree

// An interrupted fetch, or something a person put there: it is evidence about nothing, so it is
// neither trusted nor silently replaced.
@test("fdd: a directory with nothing vouching for it is refused rather than trusted")
fdd_nothing_vouching_is_refused()
    val cache = fdd_cache()
    val dir = fdd_published(cache, "github.com/e/json", fdd_v140(), "json", "")
    val sums = sums_recording(empty_sums(), "github.com/e/json", fdd_v140(), fdd_digest("a"))

    assert_eq(fetch_ensure(fdd_json(), sums, cache).unwrap_err(),
              s"'$dir' holds github.com/e/json v1.4.0 but nothing recording what it hashed to, so " +
              "sysl.sum cannot be checked against it — remove that directory and build again")
    remove_dir_all(cache).unwrap_or(())
end fdd_nothing_vouching_is_refused

@test("fdd: and is not refused for a package no line covers, whatever is beside it")
fdd_not_refused_where_no_line_covers()
    val cache = fdd_cache()

    fdd_published(cache, "github.com/e/json", fdd_v140(), "json", "")

    val sums = sums_recording(empty_sums(), "github.com/e/other", fdd_v140(), fdd_digest("a"))

    assert_eq(fetch_ensure(fdd_json(), sums, cache).unwrap().root,
              fetch_directory(cache, "github.com/e/json", fdd_v140()))
    remove_dir_all(cache).unwrap_or(())
end fdd_not_refused_where_no_line_covers

// -- a path dependency ---------------------------------------------------------------------------------

@test("fdd: a path dependency is the directory it names")
fdd_path_dependency_is_its_directory()
    val dir = fdd_project(fdd_manifest("local", "0.1.0", ""))
    val got = fetch_ensure(plain_dependency("local", Local(dir), None), empty_sums(), fdd_cache())

    assert_eq(got.unwrap().root, dir)
    assert(got.unwrap().hash.is_none())
    remove_dir_all(dir).unwrap_or(())
end fdd_path_dependency_is_its_directory

// A directory beside the consumer is expected to change, which is what it is for.
@test("fdd: a path dependency is never checked against sysl.sum")
fdd_path_dependency_is_never_checked()
    val dir = fdd_project(fdd_manifest("local", "0.1.0", ""))
    val sums = sums_recording(empty_sums(), "local", Release(0, 1, 0), fdd_digest("a"))
    val got = fetch_ensure(plain_dependency("local", Local(dir), None), sums, fdd_cache())

    assert(got.unwrap().hash.is_none())
    remove_dir_all(dir).unwrap_or(())
end fdd_path_dependency_is_never_checked

@test("fdd: a path dependency that is not there says so")
fdd_path_dependency_not_there()
    val d = plain_dependency("local", Local("/no/such/directory"), None)

    assert_eq(fetch_ensure(d, empty_sums(), fdd_cache()).unwrap_err(),
              "'local' is a path dependency, and '/no/such/directory' is not a directory")

// -- two fetches of one package ------------------------------------------------------------------------

// What a clone leaves at its own pending name: one module whose source says which clone it was.
private fdd_cloned(dir: string, marker: string) -> string
    val pending = pending_name(dir)

    make_dir_all(s"$pending/sh/demo").unwrap()
    write_text(s"$pending/sh/demo/demo.sysl", marker).unwrap()
    pending
end fdd_cloned

// Each clones under a name of its own: a fixed `<dir>.partial` had each clearing the other's clone.
@test("fdd: two fetches of one package clone apart")
fdd_two_fetches_clone_apart()
    val dir = s"${fdd_cache()}/github.com/e/json/@v1.4.0"

    assert(pending_name(dir) != pending_name(dir))

@test("fdd: and the second to finish succeeds, leaving the first one's package untouched")
fdd_second_to_finish_succeeds()
    val cache = fdd_cache()
    val dir = s"$cache/github.com/e/json/@v1.4.0"
    val first = fdd_cloned(dir, "first")
    val second = fdd_cloned(dir, "second")

    assert(publish_dir(first, dir).is_ok())
    assert(publish_dir(second, dir).is_ok())
    assert_eq(read_text(s"$dir/sh/demo/demo.sysl").unwrap(), "first")
    assert(!exists(first))
    assert(!exists(second))
    assert_eq(entries(s"$cache/github.com/e/json").unwrap().len(), 1)
    remove_dir_all(cache).unwrap_or(())
end fdd_second_to_finish_succeeds

@test("fdd: but a directory that cannot be put in place at all is a refusal, with the clone removed")
fdd_cannot_be_put_in_place()
    val cache = fdd_cache()
    val pending = fdd_cloned(s"$cache/nowhere/@v1.4.0", "x")

    assert(publish_dir(pending, s"$cache/no/such/parent/@v1.4.0").is_err())
    assert(!exists(pending))
    remove_dir_all(cache).unwrap_or(())
end fdd_cannot_be_put_in_place

@test("fdd: removing a tree takes what is under it")
fdd_removing_a_tree()
    val root = fdd_project("")

    make_dir_all(s"$root/a/b/c").unwrap()
    write_text(s"$root/a/b/c/x", "x").unwrap()
    remove_dir_all(root).unwrap()
    assert(!exists(root))

// -- `sysl deps` -----------------------------------------------------------------------------------------

// What the command prints for a graph resolved against a cache of its own -- the printer the driver
// reaches, one frame lower, since the claim is about the graph and not about the build.
private fdd_shown(root: string, cache: string) -> string
    val m = manifest_of_package(root).unwrap()

    deps_listing(m, resolve_graph(root, m, empty_sums(), cache).unwrap())
end fdd_shown

// The whole driver, for the cases that need no package cache: the status and every line said.
private fdd_ran(args: []string) -> (int, string)
    var lines: Buf[string] = buf()
    val sink = &lines
    val code = run_cli(args, (line) -> sink.push(line))

    (code, join(lines.view(), "\n"))
end fdd_ran

@test("fdd: deps names a command and takes a path")
fdd_deps_takes_a_path()
    val root = fdd_project(fdd_manifest("app", "0.1.0", ""))
    val (code, said) = fdd_ran(["sysl", "deps", root])

    assert_eq(code, Fine)
    assert(said.starts_with("app 0.1.0\n"), said)
    remove_dir_all(root).unwrap_or(())
end fdd_deps_takes_a_path

// Unlike `targets`, which stands alone -- this one is a question about a particular project.
@test("fdd: and will not stand without one")
fdd_deps_will_not_stand_alone()
    assert_eq(fdd_ran(["sysl", "deps"]).0, Misused)

@test("fdd: the project first, by the name and version its own manifest gives")
fdd_deps_project_first()
    val root = fdd_project(fdd_manifest("app", "0.1.0", ""))

    assert(fdd_shown(root, fdd_cache()).starts_with("app 0.1.0\n"))
    remove_dir_all(root).unwrap_or(())

@test("fdd: and says so rather than printing an empty list where there is nothing")
fdd_deps_says_nothing()
    val root = fdd_project(fdd_manifest("app", "0.1.0", ""))

    assert_eq(fdd_shown(root, fdd_cache()), "app 0.1.0\n\nthis project depends on nothing\n")
    remove_dir_all(root).unwrap_or(())

@test("fdd: a dependency, the version settled on, and who asked")
fdd_deps_who_asked()
    val cache = fdd_cache()

    fdd_published(cache, "github.com/e/buf", fdd_v140(), "buf", "")

    val root = fdd_project(fdd_manifest("app", "0.1.0", fdd_dep("buf", "github.com/e/buf", "1.4.0")))

    assert_eq(fdd_shown(root, cache), "app 0.1.0\n\ngithub.com/e/buf  1.4.0\n    app asks for 1.4.0\n")
    remove_dir_all(root).unwrap_or(())
    remove_dir_all(cache).unwrap_or(())
end fdd_deps_who_asked

// `buf` at 1.2.0 and at 1.4.0, `a` asking for the first and `b` for the second, and a project naming
// `a` and `b` -- the shape where the manifest's 1.2.0 is not what the build uses.
private fdd_overtaken(cache: string) -> string
    fdd_published(cache, "github.com/e/buf", Release(1, 2, 0), "buf", "")
    fdd_published(cache, "github.com/e/buf", fdd_v140(), "buf", "")
    fdd_published(cache, "github.com/e/a", Release(1, 0, 0), "a",
                  fdd_dep("buf", "github.com/e/buf", "1.2.0"))
    fdd_published(cache, "github.com/e/b", Release(1, 0, 0), "b",
                  fdd_dep("buf", "github.com/e/buf", "1.4.0"))

    fdd_project(fdd_manifest("app", "0.1.0", s"${fdd_dep("a", "github.com/e/a", "1.0.0")}, " +
                                             fdd_dep("b", "github.com/e/b", "1.0.0")))
end fdd_overtaken

// The whole point of the command: the line that explains a version belongs to a package this
// project never named.
@test("fdd: a coordinate somebody was overtaken at, with both claims and a marker")
fdd_deps_overtaken()
    val cache = fdd_cache()
    val root = fdd_overtaken(cache)

    assert_eq(fdd_shown(root, cache),
              "app 0.1.0\n\n" +
              "github.com/e/a    1.0.0\n    app asks for 1.0.0\n" +
              "github.com/e/b    1.0.0\n    app asks for 1.0.0\n" +
              "github.com/e/buf  1.4.0  (raised)\n" +
              "    github.com/e/a asks for 1.2.0\n    github.com/e/b asks for 1.4.0\n")
    remove_dir_all(root).unwrap_or(())
    remove_dir_all(cache).unwrap_or(())
end fdd_deps_overtaken

// The marker is about a claim losing, not about the graph being deep.
@test("fdd: and no marker where everybody got what they asked for")
fdd_deps_no_marker()
    val cache = fdd_cache()

    fdd_published(cache, "github.com/e/buf", fdd_v140(), "buf", "")
    fdd_published(cache, "github.com/e/a", Release(1, 0, 0), "a",
                  fdd_dep("buf", "github.com/e/buf", "1.4.0"))

    val root = fdd_project(fdd_manifest("app", "0.1.0", fdd_dep("a", "github.com/e/a", "1.0.0")))
    val said = fdd_shown(root, cache)

    assert(said.index_of("(raised)").is_none(), said)
    remove_dir_all(root).unwrap_or(())
    remove_dir_all(cache).unwrap_or(())
end fdd_deps_no_marker

// Wider than the note a build prints, which fires only where the root's own manifest was overtaken.
@test("fdd: including where the root never named the coordinate that moved")
fdd_deps_root_never_named_it()
    val cache = fdd_cache()
    val root = fdd_overtaken(cache)
    val said = fdd_shown(root, cache)

    assert(said.index_of("github.com/e/buf  1.4.0  (raised)").is_some(), said)
    remove_dir_all(root).unwrap_or(())
    remove_dir_all(cache).unwrap_or(())
end fdd_deps_root_never_named_it

// A coordinate is full of dots, so the canonical name cannot be turned back into one.
@test("fdd: a coordinate as its manifest wrote it, slashes and all")
fdd_deps_coordinate_as_written()
    val cache = fdd_cache()

    fdd_published(cache, "github.com/e/sysl-json", fdd_v140(), "json", "")

    val root = fdd_project(fdd_manifest("app", "0.1.0",
                                        fdd_dep("j", "github.com/e/sysl-json", "1.4.0")))
    val said = fdd_shown(root, cache)

    assert(said.index_of("github.com/e/sysl-json  1.4.0").is_some(), said)
    remove_dir_all(root).unwrap_or(())
    remove_dir_all(cache).unwrap_or(())
end fdd_deps_coordinate_as_written

// It has no version, and the directory is the only thing that says which tree it is.
@test("fdd: a path dependency prints its directory where a coordinate would print a version")
fdd_deps_path_prints_its_directory()
    val other = fdd_helper(fdd_manifest("helper", "0.1.0", ""))
    val root = fdd_project(s"package { name = \"app\", version = \"0.1.0\" }\n" +
                           s"dependencies { h { path = \"$other\" } }\n")
    val (code, said) = fdd_ran(["sysl", "deps", root])

    assert_eq(code, Fine)
    assert(said.starts_with("app 0.1.0\n"), said)
    assert(s"$said\n".index_of(s"h  $other\n").is_some(), said)
    remove_dir_all(root).unwrap_or(())
    remove_dir_all(other).unwrap_or(())
end fdd_deps_path_prints_its_directory

// The label is the only name a package with no coordinate has.
@test("fdd: and the floors it raises are attributed to its label")
fdd_deps_path_floors_by_label()
    val cache = fdd_cache()

    fdd_published(cache, "github.com/e/buf", fdd_v140(), "buf", "")

    val other = fdd_helper(fdd_manifest("helper", "0.1.0", fdd_dep("buf", "github.com/e/buf", "1.4.0")))
    val root = fdd_project(s"package { name = \"app\", version = \"0.1.0\" }\n" +
                           s"dependencies { h { path = \"$other\" } }\n")
    val said = fdd_shown(root, cache)

    assert(said.index_of("    h asks for 1.4.0\n").is_some(), said)
    remove_dir_all(root).unwrap_or(())
    remove_dir_all(other).unwrap_or(())
    remove_dir_all(cache).unwrap_or(())
end fdd_deps_path_floors_by_label

@test("fdd: a project with no dependencies is answered rather than refused")
fdd_deps_driver_no_dependencies()
    val root = fdd_project(fdd_manifest("app", "0.1.0", ""))
    val (code, said) = fdd_ran(["sysl", "deps", root])

    assert_eq(code, Fine)
    assert_eq(said, "app 0.1.0\n\nthis project depends on nothing")
    remove_dir_all(root).unwrap_or(())
end fdd_deps_driver_no_dependencies

// A heading reading as though nobody owned the project is worse than a stand-in.
@test("fdd: a project whose manifest names no package still has a heading")
fdd_deps_driver_no_name()
    val root = fdd_project("")
    val (code, said) = fdd_ran(["sysl", "deps", root])

    assert_eq(code, Fine)
    assert_eq(said, "this project\n\nthis project depends on nothing")
    remove_dir_all(root).unwrap_or(())
end fdd_deps_driver_no_name

// The command asks nothing of a machine, so a project pinned to one this machine cannot build for
// is still inspectable.
@test("fdd: a project whose default target is not this machine")
fdd_deps_driver_foreign_target()
    val root = fdd_project("package { name = \"app\", version = \"0.1.0\", target = \"thumb-freestanding\" }\n")

    assert_eq(fdd_ran(["sysl", "deps", root]).0, Fine)
    remove_dir_all(root).unwrap_or(())

// -- whether a file is clean, which is the half of the definition index this compiler answers ----------

// One file analyzed against the standard module: the report, empty where the file is clean.
private fdd_analyzed(text: string) -> Option[string]
    val root = make_temp_dir("sysl-fdd-index").unwrap()

    write_text(s"$root/t.sysl", text).unwrap()

    val out = emit_typed_text(s"$root/t.sysl", None, false) match
        Err(why) -> Some(why.message)
        Ok(made) -> if made.report.is_empty() then None else Some(analysis_report(made.report))

    remove_dir_all(root).unwrap_or(())
    out
end fdd_analyzed

private fdd_has_library() -> bool
    if std_root().is_ok() then return true

    print("skipped: the standard module's source is not on this machine")
    false
end fdd_has_library

@test("fdd: a file with a mistake in it reports the diagnostic")
fdd_index_diagnostic_reported()
    if !fdd_has_library() then return

    val said = fdd_analyzed("var x = 1\nprint(x)\nprint(nope)\n")

    assert(said.is_some())
    assert(said.unwrap().index_of("undefined name 'nope'").is_some(), said.unwrap())
end fdd_index_diagnostic_reported

@test("fdd: a clean file says so")
fdd_index_clean_file()
    if !fdd_has_library() then return

    assert(fdd_analyzed("var x = 1\nprint(x)\n").is_none())

@test("fdd: and a file with a mistake does not")
fdd_index_mistaken_file()
    if !fdd_has_library() then return

    assert(fdd_analyzed("var x = 1\nprint(nope)\n").is_some())

// The definition index itself -- every name a file writes traced back to the declaration it stands
// for, as a line and a column -- is a facility this compiler does not have (the reference's
// `Analyzer.indexed`, the go-to-definition half of a language server). Each case below names the
// claim it would make; building the index is a walk over the typed tree recording a reference per
// resolved name with its declaration's position, a feature of two to three days.

@test("fdd: a local, from its use back to its binding", ignore: "no definition index (Analyzer.indexed); 2-3 days")
fdd_index_local()
    ()

@test("fdd: a parameter, which is a binding with no statement of its own", ignore: "no definition index (Analyzer.indexed); 2-3 days")
fdd_index_parameter()
    ()

@test("fdd: a function, from the call back to the declaration", ignore: "no definition index (Analyzer.indexed); 2-3 days")
fdd_index_function()
    ()

@test("fdd: module storage, which is a different table from a local", ignore: "no definition index (Analyzer.indexed); 2-3 days")
fdd_index_module_storage()
    ()

@test("fdd: a call to a generic reaches the generic, not the instantiation it was compiled as", ignore: "no definition index (Analyzer.indexed); 2-3 days")
fdd_index_generic()
    ()

@test("fdd: an inner binding shadows an outer one, and the reference follows the inner", ignore: "no definition index (Analyzer.indexed); 2-3 days")
fdd_index_shadowing()
    ()

@test("fdd: a reference into the standard library points into the library's own file", ignore: "no definition index (Analyzer.indexed); 2-3 days")
fdd_index_into_library()
    ()

@test("fdd: a literal has no reference", ignore: "no definition index (Analyzer.indexed); 2-3 days")
fdd_index_literal()
    ()

@test("fdd: and a type name, which this index does not reach", ignore: "no definition index (Analyzer.indexed); 2-3 days")
fdd_index_type_name()
    ()

@test("fdd: the same name written twice gives two references", ignore: "no definition index (Analyzer.indexed); 2-3 days")
fdd_index_twice()
    ()

@test("fdd: and the references around a mistake are still answered", ignore: "no definition index (Analyzer.indexed); 2-3 days")
fdd_index_around_a_mistake()
    ()
