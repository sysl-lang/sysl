module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// `&f` -- the address of a declared function, which is what C's function pointer holds.
//
// The `&` is the same one every other address is written with, and it is deliberate that no bare `f`
// reaches here: a bare function name already means the capture-free closure, and a spelling that
// meant a sysl callable in one slot and a C address in another would be a silent choice between two
// representations that share nothing. Nothing here can take the address of a closure, for the same
// reason: a closure is a struct and a body, and what C calls is the body alone.

// Whether a written name in `&name` position is a declared function rather than a place.
names_a_declared_function(cx: &Analyzer, operand: Expr) -> Option[string] = *operand.kind match
    Ident(n) ->
        if reads_before_a_function(cx, n) then None
        else if !function_keys(cx, n).is_empty() then Some(n)
        else if extern_key(cx, n).is_some() then Some(n)
        else None
    // **A function named through its module** is a chain of member reads after parsing, and it is
    // the same declaration the imported spelling names. A head bound to a value makes the chain a
    // member read and nothing else: the nearest binding wins, as it does for every qualified form.
    Field(_, _, _) -> dotted_name_written(cx, operand) match
        Some(dotted) -> if names_a_function(cx, dotted) then Some(dotted) else None
        None -> None
    // **`&f[T]` is the spelling the refusal below tells a reader to write**, and brackets in an
    // expression are indexing, so a generic function addressed at written type arguments arrives
    // as an index over its own name. A name that is a place indexes as one, the `Ident` arm above
    // being what says which of the two this is.
    Index(head, _, _) -> names_a_declared_function(cx, head)
    TypeArgs(head, _, _) -> names_a_declared_function(cx, head)
    _ -> None

// The type arguments `&f[…]` wrote, as the expressions the bracket grammar read.
addressed_type_args(operand: Expr) -> Buf[Expr] = *operand.kind match
    Index(_, one, _) ->
        var out: Buf[Expr] = buf()

        out.push(one)
        out
    TypeArgs(_, inner, _) -> inner
    _ -> buf()

// The address itself.
function_address(cx: &Analyzer, span: Span, written: string, targ_exprs: Buf[Expr],
                 expected: Option[Type]) -> TExpr
    val named = function_keys(cx, written)

    if named.is_empty() || extern_over_library(cx, written, named).is_some()
        val foreign = extern_key(cx, written)

        if foreign.is_some()
            val chosen = addressed_extern(cx, span, written, foreign.unwrap(), expected)

            if chosen == "" then return bad_expr(span)

            return extern_address(cx, span, written, chosen, targ_exprs)
        end if
    end if

    val key = addressed_overload(cx, span, written, expected)

    if key == "" then return bad_expr(span)

    val f = cx.an.tables.funcs.get(key)

    if f.is_none() then return bad_expr(span)

    val decl = f.unwrap().decl

    // Which copy of it? A generic function is not code until its arguments are settled, so there is
    // no single body to name until they are -- but the expected type settles them wherever there is
    // one, exactly as a call's arguments do.
    var inst = key

    if decl.tparams.is_empty() && !targ_exprs.is_empty() then
        return cx.err(span, s"'$written' is not generic, so it has no type arguments to write — " +
                      s"its address is '&$written'")

    if !decl.tparams.is_empty()
        // **Written arguments say which copy outright**, which is what the refusal below asks for
        // where nothing else does; with none written the type the context wants is what settles
        // them, exactly as a call's arguments would.
        var made = ""

        if targ_exprs.is_empty()
            made = addressed_instantiation(cx, span, written, f.unwrap(), expected)
        else made = written_instantiation(cx, span, written, key, f.unwrap(), targ_exprs)

        if made == "" then return bad_expr(span)

        inst = made
    end if

    // A `...` is read relative to the last named argument, so a caller has to know where the named
    // ones stop. A `*extern` says only what it is called with, and there is nothing in that to hold
    // a tail.
    if decl.variadic then
        return cx.err(span, s"'$written' is variadic, and a '*extern' fixes the arguments a call " +
                      "passes — a tail has no width a signature could state, so a variadic " +
                      "function is reached by calling it")

    if decl.test.is_some() then
        return cx.err(span, s"'$written' is a '@test' function, which 'sysl test' calls and " +
                      "nothing else does — every other build leaves it out, so its address would " +
                      "be of a definition the program does not have")

    var ptypes: Buf[Type] = buf()
    var ret = Unit

    // An instantiation's signature is the one the tables hold; a function with no type parameters
    // has none there, and its own declaration is what says what it takes.
    val sig = cx.an.tables.members.func_insts.get(inst)

    if sig.is_some()
        for i in 0..<sig.unwrap().params.len()
            ptypes.push(sig.unwrap().params.at(i).1)

        ret = sig.unwrap().ret
    else
        for param in decl.params
            ptypes.push(param_type(cx, f.unwrap(), param))

        ret = declared_result(cx, f.unwrap().scope, decl.ret_type, decl.needs)

    // The address is of **code**, and the code has to be the code C would call. Where every part of
    // the signature crosses as itself the two conventions agree and the function's own symbol is
    // the answer; where one does not, sysl emitted the aggregate its own way and C would read the
    // wrong registers. An `extern` and a function carrying `@export` are past this rather than
    // exempted from it: neither is code this compiler laid out its own way.
    val c_convention = cx.an.tables.externs.has(inst) || decl.exported.is_some()

    if !c_convention && !crosses_whole(cx, span, written, ptypes, ret) then return bad_expr(span)

    cx.an.uses(inst)
    note_func_reference(cx, span, key)

    if cx.an.tables.externs.has(inst) then cx.an.uses_extern(inst)

    TExpr(span, TFuncAddr(inst, inst, CFn(ptypes, ret)))
end function_address

// Whether every part of a signature crosses to C as itself, reporting the first that does not.
//
// The address is of **code**, and the code has to be the code C would call. Where every part crosses
// as itself the two conventions agree and the function's own symbol is the answer; where one does
// not, sysl emitted the aggregate its own way and C would read the wrong registers.
private crosses_whole(cx: &Analyzer, span: Span, written: string, ptypes: Buf[Type],
                      ret: Type) -> bool
    for i in 0..<(ptypes.len() + 1)
        val t = if i < ptypes.len() then ptypes.at(i) else ret

        // A part nobody could type -- a result read off a body that was itself refused -- has been
        // told where it was refused, and is no aggregate to name here.
        if mentions_unknown(t) then return false

        if !crosses_as_itself(t)
            var which = "the result"

            if i < ptypes.len() then which = s"the ${ordinal(i + 1)} parameter"

            cx.fault(span, s"$which of '$written' is ${type_show(t)}, an aggregate, and an " +
                     "aggregate crosses to C in whichever registers that machine's convention " +
                     "names rather than the ones a sysl call uses — so this address would be of a " +
                     "function C cannot call correctly. A wrapper taking the parts behind a '*T', " +
                     "or '@export' on this one, is what has an address")
            return false
        end if

    true
end crosses_whole

// `&T.f` -- the address of an associated function, which is the address of a module function one
// name over: a method's receiver is its first parameter, as it is in the code the member compiled
// to, so `&Counter.bump` over `bump(*self)` is a `*extern(*Counter) -> …`.
//
// **Nothing where the operand is not a member read off a type's name**, which leaves every other
// `&a.b` -- a field of a value, a variant, a property -- to the reading it always had, and that
// reading's refusals.
associated_address(cx: &Analyzer, span: Span, operand: Expr,
                   expected: Option[Type]) -> Option[TExpr]
    val (receiver, name) = *operand.kind match
        Field(r, n, _) -> (r, n)
        _ -> return None

    var ty = Unknown
    var shown = ""
    val applied = written_on_generic_type(cx, receiver)

    if applied.is_some()
        val head = applied.unwrap().0

        shown = head.1

        val targs = written_type_args_for(cx, head.0, applied.unwrap().1)

        for t in targs
            if t == Unknown then return Some(bad_expr(span))

        ty = reinstantiate_at(cx.an, cx.scope, span, head.0, targs)

        if ty == Unknown then return Some(bad_expr(span))
    else
        val written = written_type_name(cx, receiver)

        if written.is_none() then return None

        shown = written.unwrap()

        val key = lookup_type_key(cx.an, cx.scope, shown)

        var is_trait = false

        if key.is_some()
            cx.an.tables.types.get(key.unwrap()) match
                Some(d) -> d.kind match
                    TraitOf(_) -> is_trait = true
                    _ -> ()
                None -> ()
        end if

        if is_trait then
            return Some(cx.err(span, s"'$shown' is a trait, and '&$shown.$name' would be the " +
                               s"address of whichever '$name' a value's type implements — a trait's " +
                               s"member has one body per type and none of its own. The address is " +
                               s"of one type's: '&T.$name' with 'T' a type implementing '$shown'"))

        val named = subject_named(cx, receiver)

        if named.is_some()
            ty = named.unwrap()
        else
            val generic = generic_type_head(cx, receiver)

            if generic.is_none() then return None

            val inferred = inferred_subject(cx, span, generic.unwrap().0, shown, name, expected)

            if inferred.is_none() then return None

            ty = inferred.unwrap()

            if ty == Unknown then return Some(bad_expr(span))
        end if
    end if

    // **A type parameter's member is addressed at each instantiation**, where the parameter is a
    // concrete type and this is that type's `f` -- static, as the call `T.f()` there is. Read at the
    // generic's definition there is no one type's code to name, only the bound's promise of one per
    // type; that reading's complaints are the definition's own and are not kept, so this one stands
    // only where a parameter would otherwise reach the member tables as itself.
    ty match
        Abstract(_, _) ->
            return Some(cx.err(span, s"'$shown' is a type parameter, and '&$shown.$name' would be " +
                               s"the address of whichever '$name' its type argument has — reached " +
                               "through the bound, which is a trait, it has one body per type and " +
                               "none of its own. A '*extern' parameter the caller fills with the " +
                               "address at a concrete type is what has one"))
        _ -> ()

    val found = member_key(cx.an, ty, name)
    var picked = name

    if cx.an.tables.members.alts.has(member_key_of(found.0, name))
        val chosen = addressed_member(cx, span, ty, found.0, s"$shown.$name", name, expected)

        if chosen == "" then return Some(bad_expr(span))

        picked = chosen
    end if

    val m = member_at(cx.an, found.0, picked)

    if m.is_none() then return None

    val decl = m.unwrap()

    // A property is read rather than called, and the reading it always had says so.
    if decl.is_property then return None

    val generic = cx.an.tables.members.generic.get(member_key_of(found.0, picked))

    if generic.is_some() && generic.unwrap().tparams.len() > found.1.len() then
        return Some(cx.err(span, s"'$name' has type parameters of its own, so '&$shown.$name' does " +
                           "not say which copy of it is meant — and an address has no arguments " +
                           "to settle them. A module function calling it at the types meant is " +
                           "what has an address"))

    if decl.variadic then
        return Some(cx.err(span, s"'$shown.$name' is variadic, and a '*extern' fixes the arguments " +
                           "a call passes — a tail has no width a signature could state, so a " +
                           "variadic function is reached by calling it"))

    val before = cx.an.complaints()

    check_member_visible(cx, span, found.0, picked, decl)

    if cx.an.complaints() != before then return Some(bad_expr(span))

    val fname = member_func_name(cx, span, ty, picked)

    if fname == "" then return Some(bad_expr(span))

    val sig = member_sig(cx.an, fname)

    if sig.is_none() then return Some(bad_expr(span))

    var ptypes: Buf[Type] = buf()

    for i in 0..<sig.unwrap().params.len()
        ptypes.push(sig.unwrap().params.at(i).1)

    val ret = sig.unwrap().ret

    if !crosses_whole(cx, span, s"$shown.$name", ptypes, ret) then return Some(bad_expr(span))

    note_member_reference(cx, span, fname, decl)
    cx.an.uses(fname)

    Some(TExpr(span, TFuncAddr(fname, fname, CFn(ptypes, ret))))
end associated_address

// Which of the members filed under one name an address is of -- a type's own overloads, or the
// members several traits gave it -- chosen as a module function's overload is: by the parameter
// list the context's type states, among the ones this file may reach. A member with type parameters
// of its own has no signature until a call settles them, and is no candidate.
private addressed_member(cx: &Analyzer, span: Span, ty: Type, base: string, written: string,
                         name: string, expected: Option[Type]) -> string
    val alts = cx.an.tables.members.alts.get(member_key_of(base, name)).unwrap()
    val wanted = if expected.is_none() then None else cfn_of(expected.unwrap())
    var cands: Buf[string] = buf()

    for item in alts
        if member_reachable(cx, base, item, implicit = true) then cands.push(item)

    // None in reach is told why by the visibility check the chosen member goes through anyway.
    if cands.is_empty() then return alts.at(0)
    if cands.len() == 1 then return cands.at(0)

    var fits: Buf[string] = buf()
    var declared = ""

    for item in cands
        val generic = cx.an.tables.members.generic.get(member_key_of(base, item))

        if generic.is_some() && generic.unwrap().tparams.len() > member_key(cx.an, ty, name).1.len() then
            continue

        val mark = cx.an.complaints()
        val fname = member_func_name(cx, span, ty, item)

        cx.an.restore_complaints(mark)

        val sig = if fname == "" then None else member_sig(cx.an, fname)

        if sig.is_none() then continue

        var ps: Buf[Type] = buf()

        for j in 0..<sig.unwrap().params.len()
            ps.push(sig.unwrap().params.at(j).1)

        declared = declared + s"\n    $written: ${type_show(CFn(ps, sig.unwrap().ret))}"

        if wanted.is_some() && types_eq(ps, wanted.unwrap().0) then fits.push(item)

    the_one_addressed(cx, span, written, cands.len(), fits, declared, expected)
end addressed_member

// Which instantiation a generic type's bare name stands for in `&Box.get`, read off the address's
// own type the way a call reads it off its result.
//
// **A method's receiver is the first parameter, so that is where its type's arguments are** --
// `*extern(*Box[int]) -> int` says `Box[int]` outright. A member without one is settled the way the
// call `Box.of(…)` is by what receives it: through a result that mentions every parameter. Anything
// else has nothing to go on, and the refusal names the written form.
private inferred_subject(cx: &Analyzer, span: Span, key: string, shown: string, name: string,
                         expected: Option[Type]) -> Option[Type]
    val m = member_at(cx.an, key, name)

    if m.is_none() || m.unwrap().is_property then return None

    val want = if expected.is_none() then None else cfn_of(expected.unwrap())

    if want.is_some()
        if m.unwrap().recv_mode().is_some() && !want.unwrap().0.is_empty()
            val first = want.unwrap().0.at(0)
            val subject = underlying(first) match
                Ptr(inner) -> *inner
                Ref(inner, _) -> *inner
                _ -> first

            if instantiation_of(subject, key) then return Some(repr(subject))
        else if instantiation_of(want.unwrap().1, key) && result_settles_type(cx, key, m.unwrap())
            return Some(repr(want.unwrap().1))
        end if
    end if

    cx.fault(span, s"'$shown' is generic, so which copy of '$name' this addresses depends on its " +
             s"type arguments, and nothing here says what they are — write them, as " +
             s"'&$shown[…].$name', or write the type this is stored in")
    Some(Unknown)
end inferred_subject

// A call through a C function pointer, which goes through the pointer rather than through a table.
//
// **The type is the only thing describing what it takes**: a function pointer's parameters have no
// names and no defaults, so the count is exact, a mismatch names the position, and the callee the
// refusal names is the type itself. The positions are the written ones -- a zero-sized parameter is
// dropped from the emitted call and still counts here.
call_pointer(cx: &Analyzer, span: Span, recv: TExpr, ty: Type, params: Buf[Type], ret: Type,
             args: Buf[Expr]) -> TExpr
    if args.len() != params.len()
        val noun = if params.len() == 1 then "argument" else "arguments"

        return cx.err(span, s"a ${type_show(ty)} is called with ${params.len()} $noun, and " +
                      s"${args.len()} were given")
    end if

    val before = cx.an.complaints()
    var ts: Buf[TExpr] = buf()

    for i in 0..<args.len()
        ts.push(type_expr(cx, args.at(i), Some(params.at(i))))

    // An argument that could not be read has been told already, and is the call's one mistake.
    if cx.an.complaints() > before
        for item in ts
            if texpr_type(item) == Unknown then return bad_expr(span)

    for i in 0..<ts.len()
        val got = texpr_type(ts.at(i))

        if disagree(got, params.at(i)) then
            return cx.err(args.at(i).span, s"the ${ordinal(i + 1)} argument of ${type_show(ty)} is " +
                          s"${type_show(params.at(i))}, but ${type_show(got)} was given")

    TExpr(span, TCallPtr(recv, ts, params, ret))
end call_pointer

// The address of an `extern`, which is the symbol the linker resolves.
//
// **Nothing about its signature is asked**: the rule that refuses an aggregate is a statement about
// code this compiler laid out its own way, and a C function is code it neither compiled nor chose a
// convention for. Its type is what the declaration transcribed from the header, parameter by
// parameter, and the address is of exactly that.
private extern_address(cx: &Analyzer, span: Span, written: string, key: string,
                       targ_exprs: Buf[Expr]) -> TExpr
    if !reachable_key(cx.an, key, cx.scope) && !refused_at_import(cx.scope, written, key) then
        return cx.err(span, out_of_reach(cx.an, key))

    val d = cx.an.tables.externs.get(key).unwrap()
    val scope = extern_scope(cx, key)

    if !targ_exprs.is_empty() then
        return cx.err(span, s"'$written' is not generic, so it has no type arguments to write — " +
                      s"its address is '&$written'")

    // An intrinsic names an instruction the back end lays down in place, not a symbol anything links.
    if is_intrinsic_name(extern_symbol(d)) then
        return cx.err(span, s"'$written' is an intrinsic, which the back end lowers to an instruction " +
                      "rather than a function anything calls — there is no body for an address to " +
                      "name. A sysl function that calls it is what has one")

    if d.variadic then
        return cx.err(span, s"'$written' is variadic, and a '*extern' fixes the arguments a call " +
                      "passes — a tail has no width a signature could state, so a variadic " +
                      "function is reached by calling it")

    var ptypes: Buf[Type] = buf()

    for param in d.params
        ptypes.push(signature_type(cx.an, d.needs, scope, param.typ, no_bindings()))

    cx.an.uses_extern(key)

    TExpr(span, TFuncAddr(key, key, CFn(ptypes, declared_result(cx, scope, d.ret_type, d.needs))))
end extern_address

// Which declaration of an overloaded name an address is of.
//
// **The expected type decides, and it is the same mechanism a generic function's arguments are read
// off**: an address is handed to something whose signature is already fixed, so the signature is
// there to be matched. What is compared is the parameter list -- a `*extern` states exactly what a
// call through it passes, and that is what tells two overloads apart. The result is deliberately not
// compared, since a pair differing only in it is refused where they are declared.
//
// **With no expected type there is nothing to read**, and this reports rather than guessing: an
// address is one word with no context of its own, and taking the first declaration would be
// choosing silently between functions that share nothing but a name.
private addressed_overload(cx: &Analyzer, span: Span, written: string,
                           expected: Option[Type]) -> string
    val keys = function_keys(cx, written)

    if keys.is_empty()
        cx.fault(span, s"undefined function '$written'")
        return ""
    end if

    if keys.len() == 1 then return keys.at(0)

    val wanted = if expected.is_none() then None else cfn_of(expected.unwrap())
    var fits: Buf[string] = buf()
    var declared = ""

    // **A declaration with no type parameters has no instantiation in the tables**, so what it takes
    // is read off the declaration itself -- which is every member of an ordinary overload set.
    for item in keys
        val sig = cx.an.tables.members.func_insts.get(item)
        val f = cx.an.tables.funcs.get(item)
        var ps: Buf[Type] = buf()
        var ret = Unit

        if sig.is_some()
            for j in 0..<sig.unwrap().params.len()
                ps.push(sig.unwrap().params.at(j).1)

            ret = sig.unwrap().ret
        else if f.is_some() && f.unwrap().decl.tparams.is_empty()
            for j in 0..<f.unwrap().decl.params.len()
                ps.push(param_type(cx, f.unwrap(), f.unwrap().decl.params.at(j)))

            ret = declared_result(cx, f.unwrap().scope, f.unwrap().decl.ret_type,
                                  f.unwrap().decl.needs)
        else continue

        declared = declared + s"\n    $written: ${type_show(CFn(ps, ret))}"

        if wanted.is_some() && types_eq(ps, wanted.unwrap().0) then fits.push(item)

    the_one_addressed(cx, span, written, keys.len(), fits, declared, expected)
end addressed_overload

// Which `extern` of an overloaded name an address is of, chosen the way a function's is: the
// parameter list the context's type states is matched against what each declaration transcribed.
//
// A name with one declaration answers with it whatever the context wants, as it always has -- the
// address of a C function is what it is, and a disagreement with where it is stored is that
// position's to report.
private addressed_extern(cx: &Analyzer, span: Span, written: string, base: string,
                         expected: Option[Type]) -> string
    if extern_overloads(cx.an, base).len() < 2 then return base

    val keys = extern_keys_in_reach(cx, base)

    if keys.is_empty() then return base
    if keys.len() == 1 then return keys.at(0)

    val wanted = if expected.is_none() then None else cfn_of(expected.unwrap())
    var fits: Buf[string] = buf()
    var declared = ""

    for item in keys
        val d = cx.an.tables.externs.get(item).unwrap()
        val scope = extern_scope(cx, item)
        var ps: Buf[Type] = buf()

        for j in 0..<d.params.len()
            ps.push(signature_type(cx.an, d.needs, scope, d.params.at(j).typ, no_bindings()))

        val shape = CFn(ps, declared_result(cx, scope, d.ret_type, d.needs))

        declared = declared + s"\n    $written: ${type_show(shape)}"

        if wanted.is_some() && types_eq(ps, wanted.unwrap().0) then fits.push(item)

    the_one_addressed(cx, span, written, keys.len(), fits, declared, expected)
end addressed_extern

// The declaration an address settled on, or the refusal where it settled on none: nothing to read
// the choice off, nothing that matched what was read, or more than one that did.
private the_one_addressed(cx: &Analyzer, span: Span, written: string, count: usize,
                          fits: Buf[string], declared: string, expected: Option[Type]) -> string
    if fits.len() == 1 then return fits.at(0)

    if expected.is_none() || cfn_of(expected.unwrap()).is_none()
        cx.fault(span, s"'$written' names $count functions, and an address is of one of " +
                 "them — which is read off the type the context wants, and there is none here. " +
                 "Annotate what this address is being stored in or passed as")
        return ""
    end if

    if fits.is_empty()
        cx.fault(span, s"no '$written' has the parameters " +
                 s"'${type_show(expected.unwrap())}' asks for — the declarations of that name " +
                 s"are:$declared")
        return ""
    end if

    cx.fault(span, s"'$written' is ambiguous as an address — ${fits.len()} of its declarations " +
             s"match '${type_show(expected.unwrap())}'")
    ""
end the_one_addressed

// Which copy of a generic function this address names, said outright.
//
// It is the same reading a call's own `f[T](…)` gets -- the arguments are expressions, since that is
// what a bracket holds, and each is read back as the type it names.
private written_instantiation(cx: &Analyzer, span: Span, written: string, key: string, f: Func,
                              targ_exprs: Buf[Expr]) -> string
    val decl = f.decl

    // **A bare arrow's parameter has no written form and no argument here to read it off**, which
    // leaves an address with nothing to instantiate. A call is the other case and does not come
    // through here: there the arguments answer it, which is where it came from.
    if authored_tparams(decl.tparams).len() != decl.tparams.len()
        cx.fault(span, s"'$written' takes a bare arrow, so it is generic in the callable's own " +
                 "type — and an address has no arguments to read that from, nor any way to write " +
                 "it. Declare the parameter as a counted callable, '&Fn(…) -> …', to give it a " +
                 "type that can be named")
        return ""
    end if

    if decl.tparams.len() != targ_exprs.len()
        var names = ""

        for i in 0..<decl.tparams.len()
            names = names + (if i == 0 then "" else ", ") + s"'${decl.tparams.at(i)}'"

        val were = if targ_exprs.len() == 1 then "was" else "were"

        cx.fault(span, s"'$written' takes ${quantity(decl.tparams.len(), "type argument")} " +
                 s"($names), and ${targ_exprs.len()} $were written")
        return ""
    end if

    // A pack stands for a list of types rather than one, so no written argument stands against it.
    if !decl.tpacks.is_empty()
        cx.fault(span, s"'${decl.tpacks.at(0)}' is a type pack, which stands for a list of types " +
                 "rather than one, so it has no written form here — a declaration taking one has " +
                 "its instantiation read off the type its address is wanted at")
        return ""
    end if

    var targs: Buf[Type] = buf()

    for targ_expr in targ_exprs
        targs.push(address_type_arg(cx, targ_expr))

    if !check_param_bounds(cx.an, f.scope, span, key, decl.tparams, decl.bounds, targs, buf(),
                           "type parameter", cx.scope) then return ""

    asked(cx, span, instantiate_func(cx.an, f.scope, decl, targs, false))
end written_instantiation

// Which copy of a generic function this address names, read off the type the context wants.
//
// The match is against the **signature as declared**, so it solves exactly what a call site's
// arguments would. A parameter the signature does not mention cannot be solved here, and the message
// says so.
private addressed_instantiation(cx: &Analyzer, span: Span, written: string, f: Func,
                                expected: Option[Type]) -> string
    val decl = f.decl
    val want = if expected.is_none() then None else cfn_of(expected.unwrap())

    if want.is_none()
        cx.fault(span, s"'$written' is generic, so which copy of it this addresses depends on its " +
                 "type arguments, and nothing here says what they are — write them, as " +
                 s"'&$written[${joined(decl.tparams, ", ")}]', or write the type this is stored " +
                 s"in, as 'var f: *extern(…) -> … = &$written'")
        return ""
    end if

    val ps = want.unwrap().0

    if ps.len() != decl.params.len()
        cx.fault(span, s"'$written' takes ${quantity(decl.params.len(), "parameter")}, and the " +
                 s"${type_show(expected.unwrap())} wanted here takes ${ps.len()}")
        return ""
    end if

    var sub: Buf[Binding] = buf()

    val covered = enter_signature(cx.an, decl.needs)

    for i in 0..<decl.params.len()
        unify(cx.an, f.scope, decl.params.at(i).typ, ps.at(i), decl.tparams, &sub)

    if decl.ret_type.is_some() then
        unify(cx.an, f.scope, decl.ret_type.unwrap(), want.unwrap().1, decl.tparams, &sub)

    leave_reaching(cx.an, covered)

    var targs: Buf[Type] = buf()
    var unsolved: Buf[string] = buf()

    for tparam in decl.tparams
        val found = bound_type(sub, tparam)

        if found.is_none() then unsolved.push(s"'${tparam}'")
        else targs.push(found.unwrap())

    if !unsolved.is_empty()
        cx.fault(span, s"'$written' is generic, and the ${type_show(expected.unwrap())} wanted " +
                 s"here does not say what ${joined(unsolved, " or ")} should be — a type " +
                 "parameter the signature does not mention cannot be settled by the type of the " +
                 s"address. Write it: '&$written[${joined(decl.tparams, ", ")}]'")
        return ""
    end if

    asked(cx, span, instantiate_func(cx.an, f.scope, decl, targs, false))
end addressed_instantiation

// Whether a type is handed over to C as the thing it is, so a sysl definition of that signature is
// already one the other side can call.
//
// The test is by **shape** rather than by asking the calling convention, and deliberately: the
// classification is a property of the target and this runs before one is chosen, so a rule that
// consulted it would let a program compile for one machine and not another. What every convention
// agrees about is the boundary drawn here -- a value that occupies one register crosses as itself
// everywhere, and an aggregate is what each of them has its own reading of.
private crosses_as_itself(t: Type) -> bool = underlying(t) match
    Integer(_, _, _) -> true
    Fixed(_, _, _) -> true
    Floating(_, _) -> true
    Bool -> true
    Char -> true
    Unit -> true
    Never -> true
    CFn(_, _) -> true
    // A trait object is a pair of words on either mode, so it is an aggregate however it is spelled.
    Weak(inner) -> !is_trait(*inner)
    Ptr(_) -> !erased(t)
    Ref(_, _) -> !erased(t)
    // A simple enum is its underlying integer and nothing else; a data enum is a tag beside a union.
    Enum(d) -> d.simple
    _ -> false

// The C function pointer a type is, where it is one.
cfn_of(t: Type) -> Option[(Buf[Type], Type)] = underlying(t) match
    CFn(ps, r) -> Some((ps, *r))
    _ -> None
