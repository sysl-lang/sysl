// p20: the same bound written in a `where` clause on the member.
trait It
    type Item
    next(*self) -> Option[Self::Item]

    apply[U, F](self, f: F) -> Option[U] where F: Fn1[Self::Item, U]
        var cur = self
        cur.next() match
            Some(x) -> Some(f(x))
            None -> None
    end apply

struct Count
    n: int

impl It for Count
    type Item = int
    next(*self) -> Option[int] = Some(self.n)

main()
    print(Count(4).apply(x -> x * 10).unwrap())
