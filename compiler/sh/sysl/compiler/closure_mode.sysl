module sh.sysl.compiler

import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}
import sysl.container.{Map, map, Set, set}

// Whether a closure literal holds each `var` it captures by reference or by value
// (`docs/design/closures.md`).
//
// **A closure that cannot outlive the variables it captures holds their addresses**, so a write in it
// reaches the variable and a write made outside is seen by it: `call(() -> hit = true)` sets `hit`.
// One that may be reached after the block declaring a captured variable has ended -- returned, stored
// in module storage or through a parameter, kept by a callee, kept in a local of an enclosing block,
// run by another thread or as a scoped child -- holds a copy, as every closure did before.
//
// **The decision is the escape analysis asked about the closure literal** (`keeps.sysl`'s
// `probe_frame`, `keeps_block.sysl`'s `probe_blocks`): a closure escapes exactly where the rule would
// refuse it if each of its captures were the address of the variable. Nothing is declared, and
// nothing reaches a signature: the callee is handed a value it calls, whatever that value's fields
// hold.
//
// **The mode is decided where the closure goes, never by what the body does to that place later**: a
// keep the rule would let a later overwrite take back -- a second call storing over the same static, a
// `defer` clearing it -- still decides the mode when what was kept is a closure literal
// (`keeps_flow.sysl`'s `note_taken_back`, `keeps.sysl`'s `probe_frame`). Otherwise the same line in a
// closure would write the variable or only a copy depending on code written after it. The box is
// decided by where the closure is at a way out, as before: nothing reaches a box taken back.
//
// The mode is a property of the literal, and of each capture: a scalar `val`, a by-name parameter
// and a value with no storage are copied whatever the literal's mode, since a copy of a scalar costs
// no more than its address; a `val` aggregate is held by address where the literal holds its
// captures so, since nothing but the saving tells the two apart (`closure.sysl`'s
// `referable_captures`). **A scoped child is the exception both ways**: it copies every `var`, which
// the body or a sibling could write under it, and holds by address each `val` aggregate it shares
// with the frame that opened the scope (`closure.sysl`'s `scoped_val_refs`).
//
// **The typed tree is read in the by-value form until every check has run**, and only then turned into
// the by-reference one (`apply_closure_modes`): the field becomes a `*T`, the construction takes the
// variable's address, and a read of the capture in the body is `*self.f` -- the form a nested
// function's environment already has, which everything after the analysis knows how to lower.

// Decides every closure literal's mode once the keeps answers are settled, and says the writes that
// reach only a copy of a capture the literal holds by value.
//
// A closure built in an `async` body is decided as any other is: a variable it holds by reference
// has its address taken, so the coroutine lowering lays it in the task's promise, which lives as long
// as the frame and across every `await` (`emit_async.sysl`'s `frame_locals`). Its box, if it is
// handed on as a `&Fn`, stays on the heap (`async_box_why`). One built in a module
// value's initializer holds its captures by value, since nothing follows that frame.
//
// **What keeps a closure is remembered with it**, the first reason found, in words that follow
// "since" -- `it is returned from 'make' on line 4` -- so the refusal of a write that reaches only its
// copy says why it holds one.
decide_closure_modes(cx: &KeepsCx, funcs: Buf[TFunc], vals: Buf[TVal])
    val a = cx.an
    var built: Buf[string] = buf()
    var escaped: Map[string, string] = map()

    // What keeps each boxed closure's box out of the frame, the same questions asked of it.
    var unframed: Map[string, string] = map()
    var boxes: Buf[BoxSite] = buf()

    // Where each closure literal is written, for `--explain-escapes`.
    var sites: Buf[ClosureSite] = buf()

    for f in funcs
        gather_boxes(a, f, &boxes)

    for f in funcs
        val here = closures_built_in(walk_body_of(f))

        if here.is_empty() then continue

        closure_sites(f, &sites)

        var probing = false

        for base in here
            if !holds_string(built, base) then built.push(base)
            if is_followed(a, base) then probing = true
        end for

        if !probing then continue

        val frame = probe_frame(cx, f)

        for item in frame.0
            if is_probe_candidate(a, item.0) then escape(escaped, item.0, item.1)

            escape(unframed, item.0, item.1)
        end for

        // Kept, and taken back later: the capture mode is the keep's, and the box may stay.
        for item in frame.1
            if is_probe_candidate(a, item.0) then escape(escaped, item.0, item.1)

        val blocks = probe_blocks(cx, f)

        for item in blocks.0
            if is_probe_candidate(a, item.0) then escape(escaped, item.0, item.1)

            escape(unframed, item.0, item.1)
        end for

        for item in blocks.1
            escape(unframed, item.0, item.1)

        if f.marks.is_async()
            for base in here
                escape(unframed, base, async_box_why(a, f))
    end for

    // **A generic's own body answers for its boxes too**: `@no_alloc` holds the body a generic was
    // written as (`no_alloc.sysl`), which no instantiation is, so its closures are probed for their
    // box alone -- that body is never emitted, and its closures' modes are no question.
    for f in a.tables.abstracts
        var any = false

        for b in boxes_of(a, f)
            boxes.push(b)
            any = true
        end for

        if !any then continue

        if f.marks.is_async()
            for base in closures_built_in(walk_body_of(f))
                escape(unframed, base, async_box_why(a, f))

            continue
        end if

        for item in probe_frame(cx, f).0
            escape(unframed, item.0, item.1)

        val blocks = probe_blocks(cx, f)

        for item in blocks.0
            escape(unframed, item.0, item.1)

        for item in blocks.1
            escape(unframed, item.0, item.1)
    end for

    for v in vals
        if v.init.is_none() then continue

        for base in closures_built_in(v.init.unwrap())
            if !holds_string(built, base) then built.push(base)

            val why = s"it is built in the initializer of '${shown_name(a, v.symbol)}', whose frame " +
                "nothing follows"

            escape(escaped, base, why)
            escape(unframed, base, why)
        end for
    end for

    for base in built
        if is_probe_candidate(a, base) && !escaped.has(base) then a.by_ref_closures.add(base)

    // A scoped child shares a `val` with the frame around its body only where that frame is known to
    // outlive the scope (`shares_outlive_scope`); anywhere else it copies, as it did.
    for base in built
        if a.scoped_val_refs.has(base) && !shares_outlive_scope(cx, funcs, base) then
            a.scoped_val_refs.remove(base)

    explain_modes(a, sites, escaped)

    // **A scoped child holds the `val`s it shares with the frame that opened the scope by address**,
    // and copies everything else, whatever the probe said of it (`closure.sysl`'s `scoped_val_refs`).
    for base in built
        a.scoped_val_refs.get(base) match
            Some(shared) ->
                a.by_ref_closures.add(base)
                a.closure_refs.put(base, shared)
            None -> ()
    end for

    frame_boxes(a, boxes, unframed)
    say_lost_writes(a, built, escaped)
end decide_closure_modes

// -- what a scoped child may share ------------------------------------------------------------------

// **Whether the `val`s a scoped child captures from the body it is written in outlive the scope it
// runs on.** Each is a capture of that body, so it lives in the frame that built the body or in the
// body's own environment, and either lasts as long as the call the body was handed to. The child may
// run until the scope ends, so that call has to be the one the scope ends inside:
//
// - at a `@bounded` parameter the child is finished before the call it is handed to returns, inside
//   the body, so the body's captures are alive throughout;
// - at a `@scoped` one the body has to be a closure literal handed straight to a call none of whose
//   other arguments -- the receiver among them -- can reach the scope's type, and the body may
//   capture nothing that can either. That call cannot have been handed the scope, so it opened it,
//   and joins it before it returns: `scope((s) -> s.spawn(() -> xs[0]))`. A body handed to a helper
//   along with the scope, or a closure inside the body that captures the scope, is not that body,
//   and its child copies.
private shares_outlive_scope(cx: &KeepsCx, funcs: Buf[TFunc], child: string) -> bool
    var body = ""
    var held: Option[(TFunc, usize, TExpr)] = None

    for f in funcs
        if body == "" && f.name.ends_with(".call")
            val at = call_holding(f, child)

            if at.is_some()
                body = f.name[0..<f.name.bytes.len - ".call".bytes.len]
                held = at
            end if
        end if
    end for

    if held.is_none() then return false

    val call = held.unwrap()
    val callee = *call.2.kind match
        TCall(name, _, _, _) -> cx.find(name)
        _ -> None

    if callee.is_none() then return false
    if bounded_at(callee.unwrap(), call.1) then return true
    if !scoped_at(callee.unwrap(), call.1) then return false

    val scope_base = *call.2.kind match
        TCall(_, args, _, _) -> if args.is_empty() then "" else struct_behind(texpr_type(args[0]))
        _ -> ""

    if scope_base == "" then return false

    // The body: handed straight to a call that was not handed the scope, and holding nothing of it.
    var opened = 0

    for f in funcs
        val at = call_holding(f, body)

        if at.is_none() then continue

        opened += 1

        *at.unwrap().2.kind match
            TCall(_, args, _, _) ->
                for i in 0..<args.len()
                    if i != at.unwrap().1 && reaches_struct(texpr_type(args[i]), scope_base) then return false
            _ -> return false
    end for

    if opened != 1 then return false

    cx.an.tables.struct_insts.get(body) match
        Some(Struct(st)) ->
            for fd in st.fields
                if reaches_struct(fd.1, scope_base) then return false
        _ -> return false

    true
end shares_outlive_scope

// The call in `f` handed the closure literal `base` as an argument, by position, with the call itself.
private call_holding(f: TFunc, base: string) -> Option[(TFunc, usize, TExpr)]
    var found: Buf[(usize, TExpr)] = buf()
    val into = &found

    walk_texpr(walk_body_of(f), expr_walk(true, x -> *x.kind match
        TCall(_, args, _, _) ->
            for i in 0..<args.len()
                if literal_handed(args[i]) == base then into.push((i, x))
        _ -> ()))

    if found.len() != 1 then None else Some((f, found[0].0, found[0].1))
end call_holding

// The closure literal an argument is, through the box and the erasure a `&Fn` or `&sync Fn` wraps it
// in.
private literal_handed(e: TExpr) -> string = *e.kind match
    TStructNew(st, _) -> if is_closure_literal(Struct(st)) then st.base else ""
    TBox(v, _) -> literal_handed(v)
    TErase(v, _, _) -> literal_handed(v)
    TCast(v, _) -> literal_handed(v)
    _ -> ""

// The struct a pointer or reference leads to, by its base.
private struct_behind(t: Type) -> string = underlying(t) match
    Ptr(inner, _) -> struct_behind(*inner)
    Ref(inner, _) -> struct_behind(*inner)
    Struct(d) -> d.base
    _ -> ""

// Whether a value of type `t` can lead to a value of the struct `base`. Anything whose contents the
// type does not say -- a trait object, a type parameter, a C function -- is taken to.
private reaches_struct(t: Type, base: string) -> bool
    var seen: Set[string] = set()

    reaches_struct_within(t, base, &seen)
end reaches_struct

// The same, with the structs and enums already asked about, which a type reaching itself through a
// pointer answers nothing new for.
private reaches_struct_within(t: Type, base: string, seen: *Set[string]) -> bool = underlying(t) match
    Ptr(inner, _) -> reaches_struct_within(*inner, base, seen)
    Ref(inner, _) -> reaches_struct_within(*inner, base, seen)
    Weak(inner) -> reaches_struct_within(*inner, base, seen)
    Volatile(inner) -> reaches_struct_within(*inner, base, seen)
    Slice(elem, _) -> reaches_struct_within(*elem, base, seen)
    Array(_, elem, _) -> reaches_struct_within(*elem, base, seen)
    Vector(_, elem, _) -> reaches_struct_within(*elem, base, seen)
    Struct(d) ->
        if d.base == base then return true

        val key = type_show(underlying(t))

        if seen.has(key) then return false

        seen.add(key)

        for fd in d.fields
            if reaches_struct_within(fd.1, base, seen) then return true

        for ta in d.targs
            if reaches_struct_within(ta, base, seen) then return true

        false
    Results(d) ->
        for fd in d.fields
            if reaches_struct_within(fd.1, base, seen) then return true

        false
    Enum(d) ->
        val key = type_show(underlying(t))

        if seen.has(key) then return false

        seen.add(key)

        for v in d.variants
            for fd in v.fields
                if reaches_struct_within(fd.1, base, seen) then return true

        for ta in d.targs
            if reaches_struct_within(ta, base, seen) then return true

        false
    Trait(_, _, _) -> true
    Abstract(_, _) -> true
    CFn(_, _, _) -> true
    Pack(_) -> true
    Unknown -> true
    _ -> false

// -- what `--explain-escapes` says of each closure ----------------------------------------------------

// A closure literal as written: its struct, the function that builds it, where, and its captures.
private struct ClosureSite
    base: string
    func: string
    at: Span
    fields: Buf[string]
end ClosureSite

// Every closure literal a body builds, where it is written.
private closure_sites(f: TFunc, out: *Buf[ClosureSite])
    val into = out

    walk_texpr(walk_body_of(f), expr_walk(true, x -> *x.kind match
        TStructNew(st, _) ->
            if is_closure_literal(Struct(st))
                var fields: Buf[string] = buf()

                for fd in st.fields
                    fields.push(fd.0)

                into.push(ClosureSite(st.base, f.name, x.span, fields))
            end if
        _ -> ()))
end closure_sites

// **Each closure that could hold a capture by reference says which way it holds them, and why**: by
// reference where nothing it is handed to or stored in keeps it, by value with the first keep found.
// A scoped child says first the `val`s it shares with the frame that opened the scope. A closure
// whose every capture is copied whatever its mode -- a scalar `val`, a by-name parameter -- has no
// choice to explain. A generic body built twice says it once. The lines are in source order.
private explain_modes(a: &Analysis, sites: Buf[ClosureSite], escaped: Map[string, string])
    var said: Buf[(string, usize, string)] = buf()

    for s in sites
        val shared = a.scoped_val_refs.get(s.base).unwrap_or(buf())

        // A scoped child says the `val`s it shares first, then what it copies.
        if !shared.is_empty()
            place_said(&said, say_mode(a, said, s, mode_names(s, shared, buf()), scoped_shared_why))

        if !is_probe_candidate(a, s.base) then continue

        val names = mode_names(s, a.closure_refs.get(s.base).unwrap(), shared)

        if names.is_empty() then continue

        val why = if a.by_ref_closures.has(s.base) then by_reference_why else escaped.get(s.base) match
            Some(w) -> s"by value, because $w"
            None -> "by value"

        place_said(&said, say_mode(a, said, s, names, why))
    end for

    for s in said
        a.closure_box_notes.push((s.0, s.2))
end explain_modes

// The captures a mask marks, less those `except` marks.
private mode_names(s: ClosureSite, refs: Buf[bool], except: Buf[bool]) -> Buf[string]
    var names: Buf[string] = buf()

    for i in 0..<s.fields.len()
        if i < refs.len() && refs[i] && !(i < except.len() && except[i]) then names.push(s.fields[i])

    names
end mode_names

// One line of `--explain-escapes` about a closure's captures, in its place among the lines of its
// file, and said once however many times a generic body builds the closure.
private say_mode(a: &Analysis, said: Buf[(string, usize, string)], s: ClosureSite, names: Buf[string],
                 why: string) -> Option[(string, usize, string)]
    val scope = func_home(a, s.func)
    val at = scope.src.locate(s.at.start)
    val line = s"${scope.src.name}:${at.line}:${at.col + literate_shift(scope.src)}: a closure holds " +
        s"${quoted_and(names)} $why"

    for s2 in said
        if s2.2 == line then return None

    Some((scope.src.name, s.at.start, line))
end say_mode

// Each line goes after every one before it in its file.
private place_said(said: *Buf[(string, usize, string)], line: Option[(string, usize, string)])
    if line.is_none() then return

    val item = line.unwrap()
    var all = *said
    var j = all.len()

    all.push(item)

    while j > 0 && all[j - 1].0 == item.0 && all[j - 1].1 > item.1
        all[j] = all[j - 1]
        j -= 1
    end while

    all[j] = item
    *said = all
end place_said

private const by_reference_why: string = "by reference, because nothing it is handed to or stored in keeps it"

private const scoped_shared_why: string =
    "by reference, because it is a scoped child and each is a 'val' from outside the body it is " +
        "written in, which outlives the scope"

// -- the box of a `&Fn` -----------------------------------------------------------------------------

// A closure literal put behind a counted reference: the closure, the function that builds it, and
// where.
private struct BoxSite
    base: string
    func: string
    at: Span
    shown: string
end BoxSite

// The boxes a body builds around a closure literal -- the `&Fn` a literal is erased to, or a `&` of
// its own type. A `&sync` one is not among them: another domain may hold it, and the box is counted
// atomically on the heap (decision 9).
//
// The walk is outermost first, so an erasure is met before the box inside it, and names the type the
// closure is handed on as.
private gather_boxes(a: &Analysis, f: TFunc, into: *Buf[BoxSite])
    val name = f.name

    walk_block_stmts(f.body, expr_walk(true, x -> *x.kind match
        TErase(v, _, ty) -> *v.kind match
            TBox(inner, ref_ty) -> note_box(a, into, inner, ref_ty, name, x.span, type_show(ty))
            _ -> ()
        TBox(v, ref_ty) -> note_box(a, into, v, ref_ty, name, x.span, "")
        _ -> ()))
end gather_boxes

private boxes_of(a: &Analysis, f: TFunc) -> Buf[BoxSite]
    var out: Buf[BoxSite] = buf()

    gather_boxes(a, f, &out)
    out
end boxes_of

private note_box(a: &Analysis, into: *Buf[BoxSite], v: TExpr, ref_ty: Type, func: string, at: Span,
                 shown: string)
    val base = boxed_closure(v, ref_ty)

    if base.is_none() then return

    for b in *into
        if b.base == base.unwrap() then return

    a.boxed_closures.add(base.unwrap())
    into.push(BoxSite(base.unwrap(), func, at, shown))
end note_box

// The closure literal a box is built around, unless the box is counted for another domain.
private boxed_closure(v: TExpr, ref_ty: Type) -> Option[string]
    val shared = ref_ty match
        Ref(_, sync) -> sync
        _ -> true

    if shared then return None

    *v.kind match
        TStructNew(st, _) -> if is_closure_literal(Struct(st)) then Some(st.base) else None
        _ -> None
end boxed_closure

// **A boxed closure nothing reaches after its frame -- or after the turn of a loop that builds it --
// is boxed in that frame** (`docs/design/closures.md` decision 8): the probes answer the question for
// the box exactly as for the captures, since the box goes wherever the closure does. Every other box
// is on the heap, and `--explain-escapes` says why.
private frame_boxes(a: &Analysis, boxes: Buf[BoxSite], unframed: Map[string, string])
    for b in boxes
        unframed.get(b.base) match
            None -> a.frame_closures.add(b.base)
            Some(why) ->
                val scope = func_home(a, b.func)
                val at = scope.src.locate(b.at.start)
                val what = if b.shown == "" then "a closure" else s"a closure erased to '${b.shown}'"

                a.closure_box_notes.push((scope.src.name,
                    s"${scope.src.name}:${at.line}:${at.col + literate_shift(scope.src)}: $what is " +
                    s"boxed on the heap, because $why"))
end frame_boxes

// **A box built in an `async` body is on the heap**: the coroutine lowering lays a declared local in
// the task's promise when its address is taken (`emit_async.sysl`'s `frame_locals`), but a box's slot
// is no declared local, and a slot left to LLVM's coroutine split is not sure to outlive an `await`.
private async_box_why(a: &Analysis, f: TFunc) -> string
    s"it is built in the 'async' body of '${shown_name(a, f.name)}', whose frame keeps no box " +
        "across an 'await'"

// Whether the emitter lays this box in the frame: one built around a closure literal that the probes
// found nothing keeps past its frame, or past the turn of a loop that builds it.
framed_box(a: &Analysis, v: TExpr, ref_ty: Type) -> bool = boxed_closure(v, ref_ty) match
    Some(base) -> a.frame_closures.has(base)
    None -> false

// A closure found to escape, with the first reason found.
private escape(escaped: Map[string, string], base: string, why: string) =
    if !escaped.has(base) then escaped.put(base, why)

// A body as one expression, for a walk that takes one.
private walk_body_of(f: TFunc) -> TExpr = TExpr(f.span, TBlockExpr(f.body))

// The closure literals an expression builds, by their structs, each once.
private closures_built_in(e: TExpr) -> Buf[string]
    var out: Buf[string] = buf()
    val into = &out

    walk_texpr(e, expr_walk(true, x -> *x.kind match
        TStructNew(st, _) -> if is_closure_literal(Struct(st)) && !holds_string(*into, st.base) then into.push(st.base)
        _ -> ()))

    out
end closures_built_in

// **A lost write is said where the closure holds that capture by value** -- and only for a closure the
// program builds: one a reading lowered and then threw away is no closure of the program's, and the
// reading the program got owes its own. Two readings of one closure owe one write twice, and a call
// of a closure held in a `val` owes one for each capture it writes; each is said once.
//
// **The reason is named where one was found**: a scoped child that borrows views is held by value
// whatever becomes of it, and any other closure no probe decides -- one with no capture it could hold
// by reference -- is held by value for no reason but that.
private say_lost_writes(a: &Analysis, built: Buf[string], escaped: Map[string, string])
    var said: Buf[(Span, string)] = buf()

    for item in a.lost_writes
        if !holds_string(built, item.base) then continue
        if holds_by_reference(a, item.base, item.capture) then continue
        var copied_nearer = false

        for v in item.via
            if !holds_by_reference(a, v.0, v.1) then copied_nearer = true

        if copied_nearer then continue

        var again = false

        for s in said
            if s.0 == item.at && s.1 == item.head then again = true

        if again then continue

        said.push((item.at, item.head))

        val why = escaped.get(item.base) match
            Some(w) -> item.lead + w
            None -> if item.base.ends_with(borrowing_closure_suffix()) then item.lead + scoped_child else ""

        a.fault(item.scope, item.at, item.head + why + item.tail)
    end for
end say_lost_writes

private const scoped_child: string =
    "it is a child written at a '@scoped' or '@bounded' parameter, which settles its captures there"

// A refusal owed until the closure's mode is known (`Analysis.lost_writes`): where it is said, and
// its words around the reason the closure holds its captures by value -- `head`, then `lead` and
// the reason where one is known, then `tail`. `via` names the closures written inside this one that
// the write passes through on its way to this one's capture: it is said only where each of them
// holds its capture by reference, since one holding a copy loses the write first, and says so itself.
struct OwedWrite
    scope: Scope
    at: Span
    head: string
    lead: string
    tail: string
    base: string
    capture: usize
    via: Buf[(string, usize)]
end OwedWrite

// Whether a closure holds its capture at `i` by reference.
holds_by_reference(a: &Analysis, base: string, i: usize) -> bool
    if !a.by_ref_closures.has(base) then return false

    a.closure_refs.get(base) match
        Some(refs) -> i < refs.len() && refs[i]
        None -> false
end holds_by_reference

// -- the by-reference form --------------------------------------------------------------------------

// What one closure held by reference had before it was turned: each capture it holds by reference,
// by the field's slot, with the type it held by value.
private struct Turned
    slots: Buf[int]
    types: Buf[Type]
end Turned

// Turns every closure held by reference into the by-reference form, once every check has run: its
// field holds the variable's address, its construction takes it, and its body reads through it.
//
// **The tree is changed in place**, since a node is shared by every list that holds it -- the body the
// emitter reads, the entry file's statements -- and the struct's record is shared by every type
// naming it, so a layout measured after this sees the addresses.
apply_closure_modes(a: &Analysis, funcs: Buf[TFunc], vals: Buf[TVal])
    if a.by_ref_closures.is_empty() then return

    var turned: Map[string, &Turned] = map()
    var seen: Set[usize] = set()

    for i in 0..<a.tables.struct_insts.len()
        val base = a.tables.struct_insts.key_at(i)

        if !a.by_ref_closures.has(base) then continue

        a.tables.struct_insts.at(i) match
            Struct(st) ->
                turned.put(base, turn_fields(a, st))
                seen.add(record_address(st))
            _ -> ()
    end for

    for i in 0..<a.tables.struct_insts.len()
        turn_stale(a, seen, a.tables.struct_insts.at(i))

    for i in 0..<a.tables.enum_insts.len()
        turn_stale(a, seen, a.tables.enum_insts.at(i))

    for f in funcs
        turn_body(a, turned, f)

    for v in vals
        if v.init.is_some() then turn_constructions(a, turned, v.init.unwrap())
end apply_closure_modes

// The struct's by-reference fields become addresses.
private turn_fields(a: &Analysis, st: &StructType) -> &Turned
    val t: &Turned = Turned(buf(), buf())
    val refs = a.closure_refs.get(st.base).unwrap()

    for i in 0..<st.fields.len()
        if i >= refs.len() || !refs[i] then continue

        val field = st.fields[i]

        t.slots.push(int(st.slot(i)))
        t.types.push(field.1)
        st.fields[i] = (field.0, Ptr(field.1, false))
    end for

    t
end turn_fields

private record_address(st: &StructType) -> usize
    val p: *StructType = &*st

    usize(p)
end record_address

// **A closure literal a trial typed has a record of its own**, under the same name as the one the
// reading kept: the trial is thrown away, but an instantiation it made around the closure's type --
// `Option[$closure0]` for `Some(() -> …)` handed to a call -- outlives it and still holds that record,
// which a layout measures. Every such record reached from an instantiation is turned too, so the
// payload holds the addresses the struct now does.
private turn_stale(a: &Analysis, seen: Set[usize], t: Type)
    t match
        Struct(st) ->
            val at = record_address(st)

            if seen.has(at) then return

            seen.add(at)

            if a.by_ref_closures.has(st.base) then turn_fields(a, st)

            for item in st.fields
                turn_stale(a, seen, item.1)
        Results(st) -> turn_stale(a, seen, Struct(st))
        Enum(e) ->
            val p: *EnumType = &*e
            val at = usize(p)

            if seen.has(at) then return

            seen.add(at)

            for v in e.variants
                for item in v.fields
                    turn_stale(a, seen, item.1)
        Array(_, elem, _) -> turn_stale(a, seen, *elem)
        Vector(_, elem, _) -> turn_stale(a, seen, *elem)
        _ -> ()
end turn_stale

private turn_body(a: &Analysis, turned: Map[string, &Turned], f: TFunc)
    turn_constructions(a, turned, walk_body_of(f))

    // A closure's own body reads its captures out of `*self`.
    if !f.name.ends_with(".call") then return

    val base = f.name[0..<f.name.bytes.len - ".call".bytes.len]
    val t = turned.get(base)

    if t.is_none() then return

    var reads: Buf[TExpr] = buf()
    val into = &reads
    val walk = expr_walk(true, x -> *x.kind match
        TField(recv, _, _) -> if reads_environment(recv) then into.push(x)
        _ -> ())

    walk_texpr(walk_body_of(f), walk)

    for c in f.requires
        walk_texpr(c.cond, walk)

    for c in f.ensures
        walk_texpr(c.cond, walk)

    for o in f.olds
        walk_texpr(o, walk)

    if f.variant.is_some() then walk_texpr(f.variant.unwrap(), walk)

    for x in reads
        turn_read(t.unwrap(), x)
end turn_body

// `self.f` becomes `*self.f`, where the field now holds the address. **A node met twice is turned
// once**: the first turning leaves no field read of the by-value type behind.
private turn_read(t: &Turned, x: TExpr)
    *x.kind match
        TField(recv, slot, ty) ->
            for j in 0..<t.slots.len()
                if t.slots[j] != slot || !type_eq(t.types[j], ty) then continue

                val field = TExpr(x.span, TField(recv, slot, Ptr(ty, false)))

                *x.kind = TDeref(field, ty)
                return
            end for
        _ -> ()
end turn_read

// Whether a field is read out of the closure's own environment, `(*self).f`.
private reads_environment(recv: TExpr) -> bool = *recv.kind match
    TDeref(inner, _) -> *inner.kind match
        TLoad(name, _) -> name == "self"
        _ -> false
    _ -> false

// Every construction of a closure held by reference takes the address of what it holds by reference.
private turn_constructions(a: &Analysis, turned: Map[string, &Turned], e: TExpr)
    var built: Buf[TExpr] = buf()
    val into = &built

    walk_texpr(e, expr_walk(true, x -> *x.kind match
        TStructNew(st, _) -> if turned.has(st.base) then into.push(x)
        _ -> ()))

    for x in built
        *x.kind match
            TStructNew(st, args) ->
                val refs = a.closure_refs.get(st.base).unwrap()

                for i in 0..<args.len()
                    if i >= refs.len() || !refs[i] then continue

                    val arg = args[i]

                    // A construction met twice is turned once.
                    val done = *arg.kind match
                        TAddrOf(_, _) -> true
                        _ -> false

                    if !done then args[i] = TExpr(arg.span, TAddrOf(arg, Ptr(texpr_type(arg), false)))
                end for
            _ -> ()
end turn_constructions
