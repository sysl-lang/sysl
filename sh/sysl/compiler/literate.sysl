module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.{Search, StrBuilder, str_builder, from_utf8_unchecked}

// Literate sysl: a source file that is a **Markdown document whose indented blocks are the
// program**.
//
// **The rule is the indent, and nothing else.** A line indented four columns or more is program
// text; every other line is prose and is not compiled. Nothing marks where a block begins or ends,
// there is no name to declare and no chunk to reference, and a file with no prose in it is a `.sysl`
// file with four spaces down the left.
//
// This is Knuth's WEB with its most famous half deliberately left out: there is no reordering, so
// the code appears in the order it runs and the tangler only removes prose.
//
// **Prose is blanked rather than removed, and that is why positions still work.** The text handed
// to the lexer has exactly as many lines as the file, and each line of program text sits on the line
// it was written on. The one coordinate that moves is the column, by the four that made the line
// code, and it is added back where a position is reported.

// The suffix that says a file is written this way.
const LiterateExtension: string = ".lsysl"

// How far a line has to be indented to be program text. Markdown's own threshold, so that what this
// compiles and what a renderer sets in a code block are the same lines.
const LiterateIndent: usize = 4

// Whether a file of this name is literate.
//
// **Asked of the name**, because there is nothing inside the text that says which it is: a `.sysl`
// file full of indented lines is an ordinary program whose author likes whitespace, and it has to
// stay one.
is_literate(name: string) -> bool = name.ends_with(LiterateExtension)

// The program a literate file holds, as a `Source` the rest of the compiler cannot tell from an
// ordinary one -- or the first thing wrong with the file.
//
// A file that is not literate comes back unchanged.
tangle(src: Source) -> Result[Source, Diagnostic]
    if !is_literate(src.name) then return Ok(src)

    var out = str_builder()
    var fence = ""
    var fence_at: usize = 0
    var list_margin: usize = 0
    var in_list = false

    for line in 1..src.line_count()
        val text = from_utf8_unchecked(src.line_text(line))

        if line > 1 then out.push_char('\n')

        // Inside an illustration. It ends at a line whose own fence is at least as long as the one
        // that opened it and made of the same character, which is Markdown's rule and matters here
        // for one reason: a fenced block may quote a fence, and the longer opener is how.
        if fence != ""
            if closes_fence(text, fence) then fence = ""

            continue
        end if

        val margin = leading_blank(text)
        val bare = text[margin..<text.len]

        // **A tab is refused before the four-column test rather than by failing it.** Asked after, a
        // tab-indented line would answer "not four columns", become prose, and be dropped from the
        // program in silence -- the author's function quietly missing a statement.
        if bare != ""
            tab_in(text, margin) match
                Some(i) -> return Err(error(point(src.line_span(line).start + i),
                    "a tab in the indentation of a literate file — what makes a line program text is four columns of indent, and a tab is as wide as whatever happens to be displaying it, so this line is code in one editor and prose in another"))
                None -> ()
        end if

        // An open list item ends at the first line with content no further in than the marker was. A
        // blank line does not end one -- a list may be written with air between its items.
        if in_list && bare != "" && margin <= list_margin then in_list = false

        if in_list then continue

        if margin < LiterateIndent && opens_fence(bare)
            fence = fence_run(bare)
            fence_at = line
            continue
        end if

        if margin >= LiterateIndent
            out.push(text[LiterateIndent..<text.len])
            continue
        end if

        // Only asked where the line is too shallow to be program text, which is why a `-` or a `*`
        // opening a sysl line can never be read as a bullet: at four columns in, the line was code
        // before this was consulted.
        if is_marker(bare)
            in_list = true
            list_margin = margin
        end if

    // Markdown lets an unclosed fence run to the end of the document, and for a document that is
    // the harmless reading. For a *program* it means every declaration below the opening fence is
    // quietly not compiled, and what the reader is told is that something further up is incomplete.
    if fence != ""
        return Err(error(point(src.line_span(fence_at).start),
            "this fence is never closed, so everything below it is an illustration and none of it is compiled — close it, or indent the lines that are meant to run"))

    Ok(source_of(src.name, out.finish()))
end tangle

// How many bytes of blanks a line opens with. Every one of them is a space, a tab having been
// refused above, so the count is also the column the line's content begins at.
private leading_blank(text: string) -> usize
    val bs = text.bytes
    var i: usize = 0

    loop
        if i >= bs.len then break
        if bs[i] != u8(' ') && bs[i] != u8('\t') then break

        i += 1

    i
end leading_blank

// Where the first tab of a line's indentation is, if there is one.
private tab_in(text: string, margin: usize) -> Option[usize]
    val bs = text.bytes

    for i in 0..<margin
        if bs[i] == u8('\t') then return Some(i)

    None
end tab_in

private opens_fence(bare: string) -> bool = bare.starts_with("```") || bare.starts_with("~~~")

// The run of fence characters a line opens with, which is what a closing fence has to be at least
// as long as.
private fence_run(bare: string) -> string
    val bs = bare.bytes
    val head = bs[0]
    var i: usize = 0

    loop
        if i >= bs.len then break
        if bs[i] != head then break

        i += 1

    bare[0..<i]
end fence_run

// Whether a line closes the fence `open` opened: the same character, at least as many of them, and
// nothing else on the line. Trailing spaces are allowed, since they are invisible and a file that
// failed to close on account of one would be maddening.
private closes_fence(text: string, open: string) -> bool
    val bare = text.trim()

    if !bare.starts_with(open) then return false

    val bs = bare.bytes
    val head = open.bytes[0]

    for i in 0..<bs.len
        if bs[i] != head then return false

    true
end closes_fence

// Whether a line begins a list item: a bullet, or a number and its punctuation, followed by a
// space. What follows one is prose however far it is indented, so this is the question that keeps
// an example written under a bullet out of the program.
private is_marker(bare: string) -> bool
    val bs = bare.bytes

    if bs.len < 2 then return false

    for b in ["-", "*", "+"]
        if bs[0] == b.bytes[0] then return bs[1] == u8(' ')

    var digits: usize = 0

    loop
        if digits >= bs.len then break
        if bs[digits] < u8('0') || bs[digits] > u8('9') then break

        digits += 1

    if digits == 0 then return false
    if bs.len <= digits + 1 then return false
    if bs[digits] != u8('.') && bs[digits] != u8(')') then return false

    bs[digits + 1] == u8(' ')
end is_marker
