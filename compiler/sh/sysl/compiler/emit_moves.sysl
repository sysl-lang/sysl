module sh.sysl.compiler

import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}
import sysl.container.{Map, map, Set, set}

// **Inferred moves**: at a value's last use, the storage it lands in takes over the count this frame
// already holds instead of taking one of its own (`reference/memory.md § T — values`).
//
// A destination -- a binding's slot, a field written, a function's result, a branch's value -- owns
// what is written into it, so it takes a count of everything the value refers to. Where that value
// is something the frame was going to give back anyway, the count and the give-back cancel, and
// this file is what notices. Two kinds of thing qualify:
//
// - **A temporary of the statement being emitted**: a fresh box, a call's result. It is taken out of
//   the statement's region, so the release at the statement's end is never emitted.
// - **A local the frame owns, at its last use**: its slot is taken out of the scope's list, so the
//   release where the scope ends is never emitted.
//
// A struct or enum built on the spot is neither: building one takes no count, so what it holds is
// whatever its parts were. It is taken over **field by field**, each part taken where it can be and
// retained where it cannot -- which is exactly the walk the type's copy helper would have made.
//
// **Nothing observable changes, which is what bounds every rule here.** Copying is always correct,
// so each question that cannot be answered for certain is answered "copy":
//
// - A local moves only from the **innermost scope** being emitted. A use inside a branch, a loop
//   body or a short-circuit is in a scope of its own (each of those opens one, for the release
//   dominance their own releases need), so a local is only ever moved by a use that every path from
//   its declaration to its scope's end passes through -- and no other path can still be holding it.
// - "Last use" is read off the block's statement list: the local is named exactly once in the
//   statement, and not at all in any statement after it or in the block's value. A name in a
//   `defer` is used at every exit, and a name a `ref` or an address was taken of can be read through
//   the alias, so neither ever moves; nor does a local whose address a call could reach, nor one an
//   array of which a view may still be standing on.
// - A `@pinned` value is never read whole once it has landed (`pinned.sysl` refuses the copy), so it
//   never reaches a destination this file is asked about.
//
// **A local whose release can run a destructor lives to its scope's end** (`return_slot.sysl`'s
// `runs_code`: a `Drop` type, or anything holding one). A destination that lasts at least as long
// -- a binding of the same scope, a store, the function's result, a branch's value -- may take it
// over, since its life then ends where the destination's does. One that may be gone first may not:
// an owned parameter (`owned_params.sysl`), whose callee may keep it only in the call's result, and a
// box being built, which may be a temporary of the statement. `chunk.column(0).i64s()` hands a view
// of what the chunk owns; the column holding the chunk is gone at the statement's end, and the chunk
// must not go with it. Nor is such a local handed into a branch's arms (`hand_in`), which would end
// it where the arm does. A plain counted value has no such reader, so its last use still ends it.
//
// What a borrowing call is handed is not here: a by-value argument is borrowed (`borrowing.sysl`),
// so a call takes no count at its edge to be taken over.

// One function's state. `last_uses` is the statement being emitted's; `parts` the value each struct
// or enum built in this function was made from, by the register it is in and the node that built it.
//
// `dying` is the locals the statement being emitted names for the last time however often it names
// them, where that statement is a branch (`hand_in`).
struct Moves
    ready: bool
    last_uses: Set[string]
    no_move: Set[string]
    parts: Map[string, (Span, Buf[Val])]
    source: Option[TExpr]
    dying: Set[string]
end Moves

moves_none() -> Moves = Moves(false, set(), set(), map(), None, set())

// The names a walk collected.
private struct Names
    seen: Set[string]
    order: Buf[string]
    counts: Map[string, int]
end Names

private names_none() -> &Names = Names(set(), buf(), map())

private note_name(into: &Names, name: string)
    if !into.seen.has(name)
        into.seen.add(name)
        into.order.push(name)

    into.counts.put(name, into.counts.get(name).unwrap_or(0) + 1)
end note_name

// Every local a node reads or writes, each as often as it is named.
private loads_into(into: &Names) -> &TWalk = expr_walk(true, x -> *x.kind match
    TLoad(name, _) -> note_name(into, name)
    _ -> ())

// Readies a body for moves: the locals that may never move, whatever their last use looks like.
begin_moves(e: *Emit, stmts: Buf[TStmt], result: Option[TExpr])
    val held = names_none()
    val aliased = TWalk(true, x -> addressed(held, x), w -> (), s -> deferred_or_aliased(held, s))

    walk_stmts(stmts, aliased)

    if result.is_some() then walk_texpr(result.unwrap(), aliased)

    e.moves.no_move = held.seen
    e.moves.ready = true
end begin_moves

private addressed(held: &Names, x: TExpr) = *x.kind match
    TAddrOf(place, _) -> walk_texpr(place, loads_into(held))
    _ -> ()

private deferred_or_aliased(held: &Names, s: TStmt) = s match
    TDefer(body, _) -> walk_stmts(body, loads_into(held))
    TRefDecl(_, _, place) -> walk_texpr(place, loads_into(held))
    _ -> ()

// For each statement of a block, the locals it uses for the last time; and the same for the block's
// value. Read backwards, so each statement is walked once. The second pair is the same question
// without "exactly once" -- the locals nothing after the statement names (`dying`).
last_uses_of(e: *Emit, xs: Buf[TStmt], tail: Option[TExpr]) -> (Buf[Set[string]], Set[string], Buf[Set[string]], Set[string])
    var lasts: Buf[Set[string]] = buf()
    var dying: Buf[Set[string]] = buf()

    if !e.moves.ready then return (lasts, set(), dying, set())

    val later = names_none()
    val at_tail = names_none()

    if tail.is_some() then walk_texpr(tail.unwrap(), loads_into(at_tail))

    val tail_dying = named_last(e, at_tail, later)
    val tail_lasts = named_once(e, at_tail, later)
    var backwards: Buf[Set[string]] = buf()
    var backwards_dying: Buf[Set[string]] = buf()

    for j in 0..<xs.len()
        val at = names_none()

        walk_stmt(xs.at(xs.len() - 1 - j), loads_into(at))
        backwards_dying.push(named_last(e, at, later))
        backwards.push(named_once(e, at, later))

    for j in 0..<backwards.len()
        lasts.push(backwards.at(backwards.len() - 1 - j))
        dying.push(backwards_dying.at(backwards.len() - 1 - j))

    (lasts, tail_lasts, dying, tail_dying)
end last_uses_of

// The names used here, however often, and never after. Asked before `named_once` adds them to what
// comes after.
private named_last(e: *Emit, here: &Names, later: &Names) -> Set[string]
    var out: Set[string] = set()

    for name in here.order
        if !later.seen.has(name) && !e.moves.no_move.has(name) then out.add(name)

    out
end named_last

// The dying set a statement or a block's value hands to the branch it is (`hand_in`): only a branch
// takes one, and only as the whole of what is being emitted.
dying_for(x: TExpr, dying: Set[string]) -> Set[string] = *x.kind match
    TIf(_, _, _, _) -> dying
    _ -> set()

dying_for_stmt(s: TStmt, dying: Set[string]) -> Set[string] = s match
    TExprStmt(x) -> dying_for(x, dying)
    _ -> set()

// **A local whose life ends inside a branch is handed into each of its arms.** Its slot leaves the
// scope that declared it and joins the scope of every arm, so an arm that uses it last moves it, and
// one that does not gives it back where that arm ends -- each path giving back exactly one count, as
// the scope's end would have, only sooner. A local the condition names is not handed in: the condition
// runs while the local is still the declaring scope's.
//
// It applies only where the branch is the whole statement (or the block's value), so nothing beside it
// in the statement can still read the local; where every arm is there to take it (an `if` with an
// `else`); and where the local's slot is the innermost scope's own, exactly as a move's must be.
hand_in(e: *Emit, cond: Buf[TCondTerm]) -> Buf[(Val, Type)]
    var out: Buf[(Val, Type)] = buf()
    val dying = e.moves.dying

    e.moves.dying = set()

    if dying.is_empty() || e.owned_marks.is_empty() then return out

    val named = names_none()

    for term in cond
        term match
            TCondTest(c) -> walk_texpr(c, loads_into(named))
            TCondIs(subject, _, _) -> walk_texpr(subject, loads_into(named))

    for name in dying
        if named.seen.has(name) then continue
        if e.caller_exposed.has(OPAQUE) || e.caller_exposed.has(name) || is_promoted(e, name) then continue

        val slot = reg_of(local_slot(e, name))
        var found: Option[usize] = None

        for j in e.owned_marks.at(e.owned_marks.len() - 1)..<e.owned_slots.len()
            val s = e.owned_slots.at(j)

            if reg_of(s.0) == slot && movable_type(s.1) && !runs_code(e, s.1) then found = Some(j)

        if found.is_some()
            out.push(e.owned_slots.at(found.unwrap()))
            forget_slot(e, found.unwrap())
        end if

    out
end hand_in

// An arm's scope, just opened, takes the slots handed into it.
inherit_slots(e: *Emit, slots: Buf[(Val, Type)])
    for s in slots
        e.owned_slots.push(s)

// The names used exactly once here and never after, which then join what comes after.
private named_once(e: *Emit, here: &Names, later: &Names) -> Set[string]
    var out: Set[string] = set()

    for name in here.order
        if here.counts.get(name).unwrap_or(0) == 1 && !later.seen.has(name) && !e.moves.no_move.has(name)
            out.add(name)

    for name in here.order
        later.seen.add(name)

    out
end named_once

// Records what a struct or enum built at `at` into `made` was made from.
note_parts(e: *Emit, at: Span, made: Val, vals: Buf[Val])
    if e.moves.ready && reg_of(made) != "" then e.moves.parts.put(reg_of(made), (at, vals))

// The count a destination of type `ty` needs for `v`, the value of `x`: taken over where `x` is
// something this frame was going to give back, and retained otherwise. A destination that may be
// gone before the scope ends is not `lasting`, and takes no local whose release runs a destructor.
retain_moving(e: *Emit, x: TExpr, ty: Type, v: Val, lasting: bool = true)
    if e.moves.ready && !e.layout.indirect(ty) && texpr_type(x) == ty then take_over(e, x, ty, v, lasting)
    else retain_value(e, ty, v)
end retain_moving

// The same for a store, whose value `gen_write` named before the store was emitted.
retain_stored(e: *Emit, ty: Type, v: Val)
    val from = e.moves.source

    e.moves.source = None

    from match
        Some(x) -> retain_moving(e, x, ty, v)
        None -> retain_value(e, ty, v)
end retain_stored

// **Nothing at all to take over is one copy**, through the type's own helper, so a value built only
// of things the frame does not hold costs exactly what it cost before; anything to take is taken,
// and the rest of the value retained beside it.
private take_over(e: *Emit, x: TExpr, ty: Type, v: Val, lasting: bool)
    if !contains_counted(ty) || holds_nothing(x, ty) then return

    if !takes_any(e, x, ty, v, lasting)
        retain_value(e, ty, v)
        return
    end if

    *x.kind match
        TLoad(name, _) -> forget_slot(e, local_at(e, name, ty, lasting).unwrap())
        TStructNew(_, args) -> take_fields(e, x, v, args, built_fields(x, ty).unwrap(), lasting)
        TEnumNew(_, _, args) -> take_fields(e, x, v, args, built_fields(x, ty).unwrap(), lasting)
        _ -> forget_temp(e, temp_at(e, v, ty).unwrap())
end take_over

// The scope no longer gives this slot back: its count is the destination's now.
private forget_slot(e: *Emit, at: usize)
    e.owned_slots.remove(at)

// Nor does the statement give back this temporary.
private forget_temp(e: *Emit, at: usize)
    e.temps.remove(at)

// Whether `x` is a variant or struct built here with no counted field at all -- `None` of an
// `Option[&T]` -- whose copy is known to retain nothing, so none is emitted.
private holds_nothing(x: TExpr, ty: Type) -> bool
    val b = built_fields(x, ty)

    if b.is_none() then return false

    for item in b.unwrap().fields
        if contains_counted(item.1) then return false

    true
end holds_nothing

// Whether taking over `x` would take anything, asked before any of it is done.
private takes_any(e: *Emit, x: TExpr, ty: Type, v: Val, lasting: bool) -> bool
    if !contains_counted(ty) then return false

    *x.kind match
        TLoad(name, _) -> local_at(e, name, ty, lasting).is_some()
        TStructNew(_, args) -> parts_take_any(e, x, ty, v, args, lasting)
        TEnumNew(_, _, args) -> parts_take_any(e, x, ty, v, args, lasting)
        _ -> temp_at(e, v, ty).is_some()
end takes_any

private parts_take_any(e: *Emit, x: TExpr, ty: Type, v: Val, args: Buf[TExpr], lasting: bool) -> bool
    val fields = built_fields(x, ty)
    val parts = parts_of(e, x, v, args)

    if fields.is_none() || parts.is_none() || fields.unwrap().fields.len() != args.len() then return false

    for i in 0..<args.len()
        val fty = fields.unwrap().fields.at(i).1

        if walked_part(e, fields.unwrap(), args.at(i), fty) && takes_any(e, args.at(i), fty, parts.unwrap().at(i), lasting)
            return true

    false
end parts_take_any

// The fields of what `x` builds, as the type's copy helper walks them, and the struct they are a
// struct's own (a variant's have none).
private struct Built
    fields: Buf[(string, Type)]
    holder: Option[&StructType]
end Built

private built_fields(x: TExpr, ty: Type) -> Option[Built] = *x.kind match
    TStructNew(_, _) -> underlying(ty) match
        Struct(d) -> Some(Built(d.fields, Some(d)))
        _ -> None
    TEnumNew(_, variant, _) -> enum_decl(ty) match
        Some(d) -> variant_fields(d, variant.name) match
            Some(fields) -> Some(Built(fields, None))
            None -> None
        None -> None
    _ -> None

// The values `x` was built from, where it was built in this function into `v`.
private parts_of(e: *Emit, x: TExpr, v: Val, args: Buf[TExpr]) -> Option[Buf[Val]]
    val got = e.moves.parts.get(reg_of(v))

    if got.is_none() then return None

    val parts = got.unwrap()

    if !(parts.0 == x.span) || parts.1.len() != args.len() then return None

    Some(parts.1)
end parts_of

// Whether a field is one the copy helper walks, and one whose part may be asked about on its own.
private walked_part(e: *Emit, b: Built, arg: TExpr, fty: Type) -> bool =
    contains_counted(fty) && (b.holder.is_none() || !borrowed_capture(b.holder.unwrap(), fty)) &&
        texpr_type(arg) == fty && !e.layout.indirect(fty)

private variant_fields(d: &EnumType, name: string) -> Option[Buf[(string, Type)]]
    for variant in d.variants
        if variant.name == name then return Some(variant.fields)

    None
end variant_fields

// A value built on the spot, taken over part by part: each counted field its part's own question,
// and one this frame cannot hand over retained as the type's copy helper would have retained it.
private take_fields(e: *Emit, x: TExpr, v: Val, args: Buf[TExpr], b: Built, lasting: bool)
    val parts = parts_of(e, x, v, args).unwrap()

    for i in 0..<args.len()
        val fty = b.fields.at(i).1
        val walked = contains_counted(fty) && (b.holder.is_none() || !borrowed_capture(b.holder.unwrap(), fty))

        if !walked then continue

        if walked_part(e, b, args.at(i), fty) then take_over(e, args.at(i), fty, parts.at(i), lasting)
        else retain_value(e, fty, parts.at(i))
end take_fields

// Where `v` sits among the temporaries of the innermost region, which is the statement being emitted.
private temp_at(e: *Emit, v: Val, ty: Type) -> Option[usize]
    val r = reg_of(v)

    if r == "" || e.temp_marks.is_empty() || e.temp_slots.has(r) then return None

    for j in e.temp_marks.at(e.temp_marks.len() - 1)..<e.temps.len()
        val t = e.temps.at(j)

        if reg_of(t.0) == r && t.1 == ty then return Some(j)

    None
end temp_at

// Where a local at its last use sits among the slots the innermost scope owns. A destination that
// is not `lasting` takes no local whose release can run a destructor: that one lives to its scope's
// end.
private local_at(e: *Emit, name: string, ty: Type, lasting: bool) -> Option[usize]
    if !e.moves.last_uses.has(name) || !movable_type(ty) || e.owned_marks.is_empty() then return None
    if !lasting && runs_code(e, ty) then return None
    if e.caller_exposed.has(OPAQUE) || e.caller_exposed.has(name) || is_promoted(e, name) then return None

    val slot = reg_of(local_slot(e, name))

    for j in e.owned_marks.at(e.owned_marks.len() - 1)..<e.owned_slots.len()
        val s = e.owned_slots.at(j)

        if reg_of(s.0) == slot && s.1 == ty then return Some(j)

    None
end local_at

// Whether a local of this type may hand its count over: anything but an array held by value, which a
// view taken earlier may still be standing on.
movable_type(t: Type) -> bool = underlying(t) match
    Array(_, _) -> false
    Struct(d) -> fields_movable(d.fields)
    Enum(d) ->
        for variant in d.variants
            if !fields_movable(variant.fields) then return false

        true
    _ -> true

private fields_movable(fields: Buf[(string, Type)]) -> bool
    for item in fields
        if !movable_type(item.1) then return false

    true
end fields_movable

private reg_of(v: Val) -> string = v match
    VReg(n) -> n
    _ -> ""
