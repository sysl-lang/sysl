module sh.sysl.compiler
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.{Search, str_builder}
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture

// `sysl.math` — the `Float` trait, the constants, and the comparisons, ported from the reference's
// `MathTests.scala` case for case.
//
// The module is a **trait over the built-in float widths** rather than two sets of free functions,
// which is what a language with no overloading has available. So the first thing these assert is
// that one spelling reaches both widths and that the width is really still the width — a `.sqrt()`
// that quietly widened everything to binary64 would pass every value test below and be wrong.
//
// The second thing they assert is the split the trait is built around: what libm computes is
// required of each width, and what is arithmetic over it is a default written once. A default is
// only worth having if it is the *same* body both times, so the tests that matter run the inherited
// methods against both `real` and `f32`.
//
// Nothing here arrives unasked-for: `sysl.math` is a submodule, so a program says so. `mt_ran` and
// `mt_err` prepend the wildcard the way the reference's own `run` override does, and the `_plain`
// pair is the reference's `super.run` — a file that deliberately wrote no import.

private var mt_library_cache: Buf[Program] = buf()
private var mt_library_read: bool = false

private mt_library() -> Buf[Program]
    if mt_library_read then return mt_library_cache

    mt_library_read = true

    std_root() match
        Err(_) -> ()
        Ok(root) -> std_units(root, host_target()) match
            Err(_) -> ()
            Ok(units) -> mt_library_cache = units

    mt_library_cache
end mt_library

private mt_no_library() -> bool
    if mt_library().is_empty()
        print("skipped: the standard module's source is not on this machine")
        return true

    false
end mt_no_library

private mt_import() -> string = "import sysl.math.*\n\n"

// Everything a source read beside the library has to say about itself, joined — the library's own
// complaints left out, since they are not what a test about a program is asking.
private mt_err_plain(text: string) -> string
    val parsed = parse(source_of("test.sysl", text))

    if !parsed.ok() then return parsed.report.at(0).message

    var units: Buf[Program] = buf()
    val library = mt_library()

    for i in 0..<library.len()
        units.push(library.at(i))

    units.push(parsed.program)

    val done = analyze_bodies(units, host_target())
    var out = str_builder()

    for i in 0..<done.reported.len()
        if !done.reported.at(i).src.name.starts_with("library/")
            out.push(done.reported.at(i).diag.message)
            out.push_char('\n')

    out.finish()
end mt_err_plain

private mt_err(text: string) -> string = mt_err_plain(mt_import() + text)

// **What a program PRINTS**, which is the one claim nothing short of building and running it makes.
private mt_ran_plain(text: string) -> string
    val root = make_temp_dir("sysl-math").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", text).unwrap()

    val exe = s"$root/built"

    build_native_program(s"$root/main.sysl", None, None, DefaultOptimization, Some(exe)) match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return failure_text(why)
        Ok(_) -> ()

    val said = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    said match
        Err(_) -> "the program that was built could not be run"
        Ok(out) -> out.text
end mt_ran_plain

private mt_ran(text: string) -> string = mt_ran_plain(mt_import() + text)

// The emitted text of a whole program, for the two claims that are about what was lowered rather
// than about what it computes.
private mt_llvm(text: string) -> string
    val dir = make_temp_dir("sysl-math-ir").unwrap()
    val scratch = s"$dir/main.sysl"

    write_text(scratch, mt_import() + text).unwrap()

    val out = emit_llvm_text(scratch, None) match
        Err(why) ->
            remove_dir_all(dir).unwrap_or(())
            return why.message
        Ok(emitted) -> emitted.text

    remove_dir_all(dir).unwrap_or(())
    out
end mt_llvm

private mt_can_run() -> bool
    if mt_no_library() then return false

    if !clang_available()
        print("skipped: there is no clang on this machine")
        return false

    true
end mt_can_run

// -- the trait reaches both widths ----------------------------------------------------------------

@test("one spelling, two receivers")
mt_one_spelling_two_receivers()
    if !mt_can_run() then return

    assert_eq(mt_ran(raw"""
        var x: real = 9.0
        var y: f32 = 16.0f32
        print(x.sqrt(), y.sqrt())
        """), "3 4\n")

// The test that would catch a `Float` that had quietly become binary64 everywhere: `1e20` squared is
// `1e40`, which binary32 cannot hold and binary64 can. If the `f32` impl were not really operating at
// its own width, both answers here would be `false`.
@test("an f32 computes at f32's width, not real's")
mt_an_f32_computes_at_f32s_width()
    if !mt_can_run() then return

    assert_eq(mt_ran(raw"""
        var small: f32 = 1.0e20f32
        var big: real = 1.0e20
        print(small.square().is_infinite(), big.square().is_infinite())
        """), "true false\n")

@test("a default body is inherited by both")
mt_a_default_body_is_inherited_by_both()
    if !mt_can_run() then return

    assert_eq(mt_ran(raw"""
        var x: real = 3.0
        var y: f32 = 3.0f32
        print(x.square(), y.square(), x.is_nan(), y.is_nan())
        """), "9 9 false false\n")

// -- a type's own width ---------------------------------------------------------------------------
//
// `T.width()` — the receiverless member whose answer is read off the type rather than stated. It is
// `zero()`'s sibling and the tests below are the two halves that could come apart: the number has to
// be the *subject's* width, and the result has to be at the *declaration's* type rather than the
// subject's. A `width` built at `Self` would make `u8.width()` a `u8`, which cannot hold `256`.

@test("each width answers with its own")
mt_each_width_answers_with_its_own_width()
    if !mt_can_run() then return

    assert_eq(mt_ran("import sysl.math.Bits\nprint(u8.width(), u32.width(), i64.width())"), "8 32 64\n")

// The answer is a `u32` whatever the subject, which is what lets a narrow type state a width its own
// range could not hold. At `Self` this would print `0`, having wrapped.
@test("the answer is a u32 and not the subject's type")
mt_the_answer_is_a_u32()
    if !mt_can_run() then return

    assert_eq(mt_ran("import sysl.math.Bits\nprint(u8.width() + 248, i8.width() == u8.width())"),
              "256 true\n")

@test("a bound reaches it, so one body serves every width")
mt_a_bound_reaches_the_width()
    if !mt_can_run() then return

    assert_eq(mt_ran(raw"""
        import sysl.math.Bits
        w[T: Bits]() -> u32 = T.width()
        print(w[u16](), w[u64]())
        """), "16 64\n")

// The expression the member exists for: reversing the low `n` bits needs the width, and without one
// a body bounded by `Bits` knows every operation on its width and not the width itself.
@test("the shift a generic body could not otherwise write")
mt_the_shift_a_generic_body_could_not_write()
    if !mt_can_run() then return

    assert_eq(mt_ran(raw"""
        import sysl.math.Bits
        low[T: Bits + Shr](v: T, n: u32) -> T = v.reverse_bits() >> T(T.width() - n)
        print(low(u8(0b001), 3), low(u32(0b001), 3))
        """), "4 4\n")

@test("it takes no arguments")
mt_width_takes_no_arguments()
    if mt_no_library() then return

    val said = mt_err("import sysl.math.Bits\nprint(u32.width(1))")

    assert(said.contains("associated function 'Bits.width' takes no arguments"), said)

@test("an unbounded type parameter is refused, naming the bound that would license it")
mt_an_unbounded_type_parameter_is_refused()
    if mt_no_library() then return

    val said = mt_err(raw"""
        import sysl.math.Bits
        w[T]() -> u32 = T.width()
        print(w[u8]())
        """)

    assert(said.contains("'width' needs 'T: sysl.math.Bits'"), said)

// A float has a width and no bit surface, which is `Bits`' membership rather than an oversight:
// there is no bit pattern a float agrees to be treated as.
@test("a float has no width, because it has no bit surface")
mt_a_float_has_no_width()
    if mt_no_library() then return

    val said = mt_err("import sysl.math.Bits\nprint(real.width())")

    assert(said.contains("no associated function 'width'"), said)

// -- the type's own values ------------------------------------------------------------------------
//
// The members with no receiver, which is what lets a body shared by two widths name a value of
// whichever width it was instantiated at.

@test("each width answers with its own")
mt_each_width_answers_with_its_own_values()
    if !mt_can_run() then return

    assert_eq(mt_ran("print(real.zero(), real.one(), f32.zero(), f32.one())"), "0 1 0 1\n")

// The two the width really decides. Binary32's largest finite value is far below binary64's, so a
// `max_value` that had quietly become one number would be caught here and nowhere else.
@test("the largest finite value is the width's, not the widest one's")
mt_the_largest_finite_value_is_the_widths()
    if !mt_can_run() then return

    assert_eq(mt_ran(
        "print(real.max_value() > 1.0e308, f32.max_value() < 1.0e39, f32.max_value() > 1.0e38)"),
        "true true true\n")

@test("epsilon is the step above one at each width")
mt_epsilon_is_the_step_above_one()
    if !mt_can_run() then return

    assert_eq(mt_ran(
        "print(real.one() + real.epsilon() > real.one(), f32.one() + f32.epsilon() > f32.one())"),
        "true true\n")

@test("the two values no literal spells")
mt_the_two_values_no_literal_spells()
    if !mt_can_run() then return

    assert_eq(mt_ran(raw"""
        print(real.infinity().is_infinite(), f32.infinity().is_infinite(),
              real.nan().is_nan(), f32.nan().is_nan())
        """), "true true true true\n")

// The free `infinity()` is the `real` one and answers the same value, which is what keeps the
// definition in one place rather than in two that could drift.
@test("the module's own infinity is the real width's")
mt_the_modules_own_infinity()
    if !mt_can_run() then return

    assert_eq(mt_ran("print(infinity() == real.infinity(), nan().is_nan())"), "true true\n")

@test("pi is at the width asked for")
mt_pi_is_at_the_width_asked_for()
    if !mt_can_run() then return

    assert_eq(mt_ran("print(real.pi() == pi, (f32.pi() - f32(pi)).abs() < f32.epsilon())"),
              "true true\n")

// The point of all of it: one body, two widths, and a value of the width made inside it.
@test("a routine generic over the width builds values of that width")
mt_a_routine_generic_over_the_width()
    if !mt_can_run() then return

    assert_eq(mt_ran(raw"""
        smallest[T: Float](xs: []const T) -> T
            var best = T.infinity()

            for i in 0..<xs.len do if xs[i] < best then best = xs[i]

            best

        main()
            var wide: [3]real = [4.0, -2.0, 9.0]
            var narrow: [3]f32 = [1.5f32, 8.0f32, 0.25f32]
            print(smallest(wide[..]), smallest(narrow[..]))
        """), "-2 0.25\n")

// An empty sequence is what a running minimum started at infinity is *for*: there is nothing to
// replace the start, and the answer is the start.
@test("the start of a running minimum survives an empty sequence")
mt_the_start_of_a_running_minimum_survives_an_empty_sequence()
    if !mt_can_run() then return

    assert_eq(mt_ran(raw"""
        smallest[T: Float](xs: []const T) -> T
            var best = T.infinity()

            for i in 0..<xs.len do if xs[i] < best then best = xs[i]

            best

        main()
            var none: [0]f32 = []
            print(smallest(none[..]).is_infinite())
        """), "true\n")

@test("the defaults that needed a literal are now one body serving both widths")
mt_the_defaults_that_needed_a_literal()
    if !mt_can_run() then return

    assert_eq(mt_ran(raw"""
        var x: real = -4.0
        var y: f32 = -4.0f32
        print(x.signum(), y.signum(), x.recip(), y.recip())
        """), "-1 -1 -0.25 -0.25\n")

// `signum` answering a zero with that zero rather than with a one is what the comparison pair buys,
// and it has to keep holding now that the one it does not answer with comes from `one()`.
@test("signum still hands a zero back unchanged and a NaN back unchanged")
mt_signum_hands_a_zero_back_unchanged()
    if !mt_can_run() then return

    assert_eq(mt_ran("print((0.0).signum(), (-0.0).signum(), nan().signum().is_nan())"),
              "0 -0 true\n")

// -- roots, exponentials and logarithms -------------------------------------------------------------

@test("square and cube roots")
mt_square_and_cube_roots()
    if !mt_can_run() then return

    assert_eq(mt_ran("print((144.0).sqrt(), (27.0).cbrt())"), "12 3\n")

// The reason `cbrt` is required rather than left to `pow(1.0 / 3.0)`, which is NaN here: a real cube
// root of a negative number exists and a fractional power of one does not.
@test("a cube root is defined for a negative operand where a fractional power is not")
mt_a_cube_root_of_a_negative_operand()
    if !mt_can_run() then return

    assert_eq(mt_ran("print((-27.0).cbrt(), (-27.0).pow(1.0 / 3.0).is_nan())"), "-3 true\n")

@test("the exponential and its inverse undo each other")
mt_the_exponential_and_its_inverse()
    if !mt_can_run() then return

    assert_eq(mt_ran(
        "print(((5.0).ln().exp() - 5.0).abs() < 1.0e-12, ((5.0).exp().ln() - 5.0).abs() < 1.0e-12)"),
        "true true\n")

@test("the two based exponentials and the three based logarithms")
mt_the_based_exponentials_and_logarithms()
    if !mt_can_run() then return

    assert_eq(mt_ran(
        "print((10.0).exp2(), (1024.0).log2(), (1000.0).log10(), (2.718281828459045).ln())"),
        "1024 10 3 1\n")

// -- powers ---------------------------------------------------------------------------------------

@test("raising to a power")
mt_raising_to_a_power()
    if !mt_can_run() then return

    assert_eq(mt_ran("print((2.0).pow(10.0), (9.0).pow(0.5), (2.0).pow(-2.0))"), "1024 3 0.25\n")

@test("the length of a two-dimensional vector")
mt_the_length_of_a_two_dimensional_vector()
    if !mt_can_run() then return

    assert_eq(mt_ran("print((3.0).hypot(4.0), (5.0).hypot(12.0))"), "5 13\n")

// Why `hypot` is required of each width rather than written as a default over `square` and `sqrt`:
// the squares overflow long before the answer does. The naive form is the second half of this line,
// and it is infinite where the library's is not.
@test("hypot survives operands whose squares overflow")
mt_hypot_survives_operands_whose_squares_overflow()
    if !mt_can_run() then return

    assert_eq(mt_ran(raw"""
        var big: real = 1.0e200
        print(big.hypot(big).is_finite(), (big.square() + big.square()).sqrt().is_finite())
        """), "true false\n")

// -- trigonometry ---------------------------------------------------------------------------------

@test("the circular functions at the quarter turn")
mt_the_circular_functions_at_the_quarter_turn()
    if !mt_can_run() then return

    assert_eq(mt_ran(raw"""
        print(((tau / 4.0).sin() - 1.0).abs() < 1.0e-15,
              (0.0).cos(),
              ((tau / 8.0).tan() - 1.0).abs() < 1.0e-15)
        """), "true 1 true\n")

@test("the inverse circular functions")
mt_the_inverse_circular_functions()
    if !mt_can_run() then return

    assert_eq(mt_ran(raw"""
        print(((1.0).asin() - pi / 2.0).abs() < 1.0e-15,
              (1.0).acos(),
              ((1.0).atan() - pi / 4.0).abs() < 1.0e-15)
        """), "true 0 true\n")

// What the two-argument form buys, and the reason the receiver is the vertical coordinate: a ratio
// cannot tell the second quadrant from the fourth, and `atan2` can. The second and third answers
// here would both be `-pi / 4` had the ratio been taken first.
@test("atan2 tells the quadrants apart where a ratio cannot")
mt_atan2_tells_the_quadrants_apart()
    if !mt_can_run() then return

    assert_eq(mt_ran(raw"""
        var q1 = (1.0).atan2(1.0)
        var q2 = (1.0).atan2(-1.0)
        var q4 = (-1.0).atan2(1.0)
        print((q1 - pi / 4.0).abs() < 1.0e-15,
              (q2 - 3.0 * pi / 4.0).abs() < 1.0e-15,
              (q4 + pi / 4.0).abs() < 1.0e-15)
        """), "true true true\n")

// -- hyperbolic trigonometry ----------------------------------------------------------------------

@test("at zero, and in the limit")
mt_at_zero_and_in_the_limit()
    if !mt_can_run() then return

    assert_eq(mt_ran("print((0.0).sinh(), (0.0).cosh(), (0.0).tanh(), (30.0).tanh())"), "0 1 0 1\n")

@test("the hyperbolic identity holds")
mt_the_hyperbolic_identity_holds()
    if !mt_can_run() then return

    assert_eq(mt_ran(raw"""
        var t: real = 1.3
        print((t.cosh().square() - t.sinh().square() - 1.0).abs() < 1.0e-12)
        """), "true\n")

@test("each inverse undoes its own function")
mt_each_inverse_undoes_its_own_function()
    if !mt_can_run() then return

    assert_eq(mt_ran(raw"""
        var t: real = 1.3
        print((t.sinh().asinh() - t).abs() < 1.0e-12,
              (t.cosh().acosh() - t).abs() < 1.0e-12,
              (t.tanh().atanh() - t).abs() < 1.0e-12)
        """), "true true true\n")

// The closed forms, which are what a complex `asinh` would otherwise have to be written from — and
// the check that the bindings are the entry points they claim rather than each other.
@test("each inverse agrees with the logarithm it is")
mt_each_inverse_agrees_with_the_logarithm_it_is()
    if !mt_can_run() then return

    assert_eq(mt_ran(raw"""
        var x: real = 2.5
        var h: real = 0.4
        print(((x + (x.square() + 1.0).sqrt()).ln() - x.asinh()).abs() < 1.0e-12,
              ((x + (x.square() - 1.0).sqrt()).ln() - x.acosh()).abs() < 1.0e-12,
              (0.5 * ((1.0 + h) / (1.0 - h)).ln() - h.atanh()).abs() < 1.0e-12)
        """), "true true true\n")

// `asinh` is odd and total; the other two are not, and where they have no answer libm hands back a
// NaN rather than trapping — so a program that can reach outside a domain is told nothing unless it
// asks. The boundaries themselves *do* have answers, and both are zero.
@test("the two with domains answer NaN outside them, and zero at the boundary")
mt_the_two_with_domains_answer_nan_outside_them()
    if !mt_can_run() then return

    assert_eq(mt_ran(raw"""
        print((-2.5).asinh() + (2.5).asinh(),
              (0.5).acosh().is_nan(), (1.0).acosh(),
              (1.0).atanh().is_infinite(), (1.5).atanh().is_nan(), (0.0).atanh())
        """), "0 true 0 true true 0\n")

@test("and every one of them is bound at f32 too")
mt_and_every_one_of_them_is_bound_at_f32_too()
    if !mt_can_run() then return

    assert_eq(mt_ran(raw"""
        var t: f32 = 1.3f32
        print((t.sinh().asinh() - t).abs() < 1.0e-5f32,
              (t.cosh().acosh() - t).abs() < 1.0e-5f32,
              (t.tanh().atanh() - t).abs() < 1.0e-5f32,
              (0.5f32).acosh().is_nan())
        """), "true true true true\n")

// -- rounding to an integral value ----------------------------------------------------------------

// Positive operands make all four agree except at the half, so the negative row is the one that says
// which is which: `floor` goes down, `ceil` goes up, `trunc` goes towards zero.
@test("the four differ on a negative operand")
mt_the_four_differ_on_a_negative_operand()
    if !mt_can_run() then return

    assert_eq(mt_ran("print((-2.5).floor(), (-2.5).ceil(), (-2.5).trunc(), (-2.5).round())"),
              "-3 -2 -2 -3\n")

// C's rule, and deliberately not the banker's rounding a *printed* float gets: a half goes away from
// zero, so `2.5` is `3` and not the `2` that round-half-to-even would give.
@test("a half rounds away from zero")
mt_a_half_rounds_away_from_zero()
    if !mt_can_run() then return

    assert_eq(mt_ran("print((0.5).round(), (1.5).round(), (2.5).round(), (3.5).round())"),
              "1 2 3 4\n")

@test("an operand that is already integral is left alone")
mt_an_operand_that_is_already_integral()
    if !mt_can_run() then return

    assert_eq(mt_ran("print((7.0).floor(), (7.0).ceil(), (-7.0).trunc(), (-7.0).round())"),
              "7 7 -7 -7\n")

// -- the floating-point remainder -----------------------------------------------------------------

// It keeps the sign of the *receiver*, which is truncating division's rule and the one C's `fmod`
// follows. A Euclidean remainder would answer `0.5` for the second of these.
@test("it keeps the receiver's sign")
mt_fmod_keeps_the_receivers_sign()
    if !mt_can_run() then return

    assert_eq(mt_ran("print((7.5).fmod(2.0), (-7.5).fmod(2.0), (7.5).fmod(-2.0))"),
              "1.5 -1.5 1.5\n")

@test("an exact division leaves nothing")
mt_an_exact_division_leaves_nothing()
    if !mt_can_run() then return

    assert_eq(mt_ran("print((8.0).fmod(2.0), (-8.0).fmod(2.0))"), "0 -0\n")

// -- sign -----------------------------------------------------------------------------------------

@test("absolute value and signum")
mt_absolute_value_and_signum()
    if !mt_can_run() then return

    assert_eq(mt_ran("print((-2.5).abs(), (2.5).abs(), (-2.5).signum(), (2.5).signum(), (0.0).signum())"),
              "2.5 2.5 -1 1 0\n")

// The three sign operations answer differently at the edges, which is why there are three. A
// comparison cannot see the sign of a zero; `copysign` reads the bit and can.
@test("copysign sees a signed zero where signum cannot")
mt_copysign_sees_a_signed_zero()
    if !mt_can_run() then return

    assert_eq(mt_ran("print((1.0).copysign(-0.0), (1.0).copysign(0.0), (-0.0).signum())"),
              "-1 1 -0\n")

@test("a NaN keeps itself through abs and signum")
mt_a_nan_keeps_itself_through_abs_and_signum()
    if !mt_can_run() then return

    assert_eq(mt_ran("print(nan().abs().is_nan(), nan().signum().is_nan())"), "true true\n")

// A magnitude is never negative, and a negative zero is the operand that says whether the
// implementation knows it. `if x < 0 then -x else x` fails here — no comparison tells the two zeroes
// apart, so the negation never runs and `-0` comes back out of an absolute value.
@test("a magnitude is never negative, not even for a negative zero")
mt_a_magnitude_is_never_negative()
    if !mt_can_run() then return

    assert_eq(mt_ran("print((-0.0).abs(), (0.0).abs(), (-0.0f32).abs())"), "0 0 0\n")

@test("the reciprocal")
mt_the_reciprocal()
    if !mt_can_run() then return

    assert_eq(mt_ran("print((4.0).recip(), (-0.25).recip(), infinity().recip())"), "0.25 -4 0\n")

// -- classification -------------------------------------------------------------------------------

@test("the three questions over the four kinds of value")
mt_the_three_questions_over_the_four_kinds_of_value()
    if !mt_can_run() then return

    assert_eq(mt_ran(raw"""
        print(nan().is_nan(), nan().is_infinite(), nan().is_finite())
        print(infinity().is_nan(), infinity().is_infinite(), infinity().is_finite())
        print((-infinity()).is_infinite(), (0.0).is_finite(), (1.0e308).is_finite())
        """), "true false false\nfalse true false\ntrue true true\n")

// The one that a `self != self` test written for `is_infinite` would get wrong, and the reason the
// body is a magnitude comparison: a NaN fails every comparison, so it is not infinite.
@test("a NaN is not infinite")
mt_a_nan_is_not_infinite()
    if !mt_can_run() then return

    assert_eq(mt_ran("print(nan().is_infinite(), (nan() * 0.0).is_infinite())"), "false false\n")

@test("an overflow is infinite and a value at the top of the range is not")
mt_an_overflow_is_infinite()
    if !mt_can_run() then return

    assert_eq(mt_ran(
        "print((1.7976931348623157e308).is_finite(), (1.7976931348623157e308 * 2.0).is_infinite())"),
        "true true\n")

// -- degrees and radians --------------------------------------------------------------------------

@test("the two conversions")
mt_the_two_conversions()
    if !mt_can_run() then return

    assert_eq(mt_ran("print((180.0).to_radians() == pi, pi.to_degrees(), (90.0).to_radians() == pi / 2.0)"),
              "true 180 true\n")

@test("a whole turn either way")
mt_a_whole_turn_either_way()
    if !mt_can_run() then return

    assert_eq(mt_ran("print((360.0).to_radians() == tau, tau.to_degrees())"), "true 360\n")

// -- what the trait answers for itself ------------------------------------------------------------

// The reason `square` is worth a name at all: `x * x` written over a call evaluates the call twice,
// and this evaluates its receiver once. Asserted on the emitted text rather than by counting side
// effects, because one call and two calls to a pure function are indistinguishable from inside the
// program.
@test("square evaluates its receiver once")
mt_square_evaluates_its_receiver_once()
    if mt_no_library() then return

    if !clang_available()
        print("skipped: there is no clang on this machine")
        return

    val text = mt_llvm("side() -> real = 3.0\n\nprint(side().square())")
    val lines = lines_of(text)
    var calls = 0

    for i in 0..<lines.len()
        if lines.at(i).contains("@side(") && lines.at(i).contains("call ") then calls += 1

    assert_eq(calls, 1)

@test("a logarithm in an arbitrary base")
mt_a_logarithm_in_an_arbitrary_base()
    if !mt_can_run() then return

    assert_eq(mt_ran("print((81.0).log(3.0), (32.0).log(2.0), (1.0).log(7.0))"), "4 5 0\n")

@test("the arbitrary base agrees with the two dedicated ones")
mt_the_arbitrary_base_agrees()
    if !mt_can_run() then return

    assert_eq(mt_ran(raw"""
        var x: real = 37.5
        print((x.log(2.0) - x.log2()).abs() < 1.0e-12, (x.log(10.0) - x.log10()).abs() < 1.0e-12)
        """), "true true\n")

@test("interpolation")
mt_interpolation()
    if !mt_can_run() then return

    assert_eq(mt_ran("print((0.0).lerp(10.0, 0.25), (10.0).lerp(20.0, 0.5), (2.0).lerp(-2.0, 0.75))"),
              "2.5 15 -1\n")

// The reason for `a + (b - a) * t` over `a * (1 - t) + b * t`, and the price. This form returns the
// start exactly at `t = 0` for every pair of operands; it does *not* always return the end exactly
// at `t = 1`, and these operands are a pair where it does not — the difference swallows the smaller
// value whole, so adding it back lands on zero rather than on `1.0`.
@test("interpolation is exact at the start, and not always at the end")
mt_interpolation_is_exact_at_the_start()
    if !mt_can_run() then return

    assert_eq(mt_ran(raw"""
        var from: real = 1.0e300
        var to: real = 1.0
        print(from.lerp(to, 0.0) == from, from.lerp(to, 1.0) == to, from.lerp(to, 1.0))
        """), "true false 0\n")

// -- the constants --------------------------------------------------------------------------------

@test("pi, tau and e")
mt_pi_tau_and_e()
    if !mt_can_run() then return

    assert_eq(mt_ran("print(pi, tau, e)"), "3.14159 6.28319 2.71828\n")

// Doubling a binary64 is exact, so this is an equality rather than a tolerance — and it is worth
// asserting because the two are written out as separate digit strings rather than derived.
@test("tau is exactly twice pi")
mt_tau_is_exactly_twice_pi()
    if !mt_can_run() then return

    assert_eq(mt_ran("print(tau == pi * 2.0, pi == tau / 2.0)"), "true true\n")

@test("the derived constants agree with the functions they name")
mt_the_derived_constants_agree()
    if !mt_can_run() then return

    assert_eq(mt_ran(raw"""
        print((sqrt2 - (2.0).sqrt()).abs() < 1.0e-15,
              (ln2 - (2.0).ln()).abs() < 1.0e-15,
              (ln10 - (10.0).ln()).abs() < 1.0e-15,
              (e.ln() - 1.0).abs() < 1.0e-15)
        """), "true true true true\n")

// What the module says an `f32` program does instead of a second set of constants.
@test("a narrower program converts rather than declaring its own")
mt_a_narrower_program_converts()
    if !mt_can_run() then return

    assert_eq(mt_ran(raw"""
        var half: f32 = f32(pi) / 2.0f32
        print((half.sin() - 1.0f32).abs() < 1.0e-6f32)
        """), "true\n")

// -- the values no literal spells -----------------------------------------------------------------

@test("infinity")
mt_infinity()
    if !mt_can_run() then return

    assert_eq(mt_ran("print(infinity().is_infinite(), (-infinity()).is_infinite(), infinity() > 1.0e308)"),
              "true true true\n")

@test("not-a-number is equal to nothing, itself included")
mt_not_a_number_is_equal_to_nothing()
    if !mt_can_run() then return

    assert_eq(mt_ran("print(nan() == nan(), nan() != nan(), nan() < 1.0, nan() > 1.0)"),
              "false true false false\n")

@test("the arithmetic that produces each")
mt_the_arithmetic_that_produces_each()
    if !mt_can_run() then return

    assert_eq(mt_ran(
        "print((1.0 / 0.0).is_infinite(), (0.0 / 0.0).is_nan(), (infinity() - infinity()).is_nan())"),
        "true true true\n")

// -- min, max and clamp ---------------------------------------------------------------------------

@test("over the integers, the floats and the strings")
mt_over_the_integers_the_floats_and_the_strings()
    if !mt_can_run() then return

    assert_eq(mt_ran(raw"""
        print(min(3, 7), max(3, 7), min(2.5, 1.5), max(2.5, 1.5), min("b", "a"), max("b", "a"))
        """), "3 7 1.5 2.5 a b\n")

@test("over a type the program ordered itself")
mt_over_a_type_the_program_ordered_itself()
    if !mt_can_run() then return

    assert_eq(mt_ran(raw"""
        struct Pair
            key: int
            tag: string

        impl Ord for Pair
            lt(self, rhs: Pair) -> bool = self.key < rhs.key

        print(min(Pair(2, "low"), Pair(5, "high")).tag, max(Pair(2, "low"), Pair(5, "high")).tag)
        """), "low high\n")

// Which of two values that compare equal comes back is observable whenever equality is not identity,
// and both answer with the *first*. A `min` written `if a < b` and a `max` written `if b < a` would
// each answer "second" here, which is what makes a fold over a sequence shuffle its ties.
@test("a tie answers with the first argument")
mt_a_tie_answers_with_the_first_argument()
    if !mt_can_run() then return

    assert_eq(mt_ran(raw"""
        struct Pair
            key: int
            tag: string

        impl Ord for Pair
            lt(self, rhs: Pair) -> bool = self.key < rhs.key

        print(min(Pair(1, "first"), Pair(1, "second")).tag,
              max(Pair(1, "first"), Pair(1, "second")).tag)
        """), "first first\n")

@test("clamp holds a value to its range")
mt_clamp_holds_a_value_to_its_range()
    if !mt_can_run() then return

    assert_eq(mt_ran("print(clamp(9, 0, 5), clamp(-3, 0, 5), clamp(3, 0, 5), clamp(0, 0, 5), clamp(5, 0, 5))"),
              "5 0 3 0 5\n")

// The low end is tested first, so an inverted range answers with it. Pinned because it is the one
// input for which the name stops describing the result, and a later rewrite that tested the high end
// first would change it silently.
@test("an inverted range answers with its low end")
mt_an_inverted_range_answers_with_its_low_end()
    if !mt_can_run() then return

    assert_eq(mt_ran("print(clamp(3, 10, 1), clamp(30, 10, 1))"), "10 1\n")

// Documented rather than relied on: a NaN loses every comparison, so the single comparison each of
// these makes is false either way and both keep the *first* argument. This is the behaviour C's
// `fmin` was criticised for, and a program that must reject a NaN tests for one.
@test("a NaN survives in the first argument and is dropped from the second")
mt_a_nan_survives_in_the_first_argument()
    if !mt_can_run() then return

    assert_eq(mt_ran(
        "print(min(nan(), 1.0).is_nan(), min(1.0, nan()), max(nan(), 1.0).is_nan(), max(1.0, nan()))"),
        "true 1 true 1\n")

// The comparison a test of a computation actually wants: binary floating point does not hold
// `0.1 + 0.2 == 0.3`, and asserting it does is how a correct program fails its own suite.
@test("approx_eq holds two values to an absolute tolerance")
mt_approx_eq_holds_two_values_to_an_absolute_tolerance()
    if !mt_can_run() then return

    assert_eq(mt_ran(
        "print(approx_eq(0.1 + 0.2, 0.3, 1e-12), approx_eq(1.0, 1.5, 0.1), approx_eq(1.0, 1.5, 0.6))"),
        "true false true\n")

// Both of these come from the equality test in front of the subtraction, and both would be wrong
// without it: `inf - inf` is a NaN, so the difference alone calls a value unequal to itself, and an
// exact match would depend on the tolerance rather than on being exact.
@test("identical infinities are close, and a NaN is close to nothing")
mt_identical_infinities_are_close()
    if !mt_can_run() then return

    assert_eq(mt_ran("print(approx_eq(infinity(), infinity(), 0.0), approx_eq(nan(), nan(), 1.0), " +
                     "approx_eq(nan(), 1.0, 1e9))"), "true false false\n")

// The test to use when the magnitude is not known in advance: a thousand is nothing beside a
// quintillion and everything beside a one, and only the relative form says so.
@test("approx_eq_rel scales the tolerance to the larger operand")
mt_approx_eq_rel_scales_the_tolerance()
    if !mt_can_run() then return

    assert_eq(mt_ran("print(approx_eq_rel(1e18, 1e18 + 1000.0, 1e-6), approx_eq_rel(1.0, 1.5, 1e-6))"),
              "true false\n")

// Scaled by the larger of the two, so the answer cannot depend on which was written first.
@test("and does not depend on the order of its arguments")
mt_approx_eq_rel_does_not_depend_on_the_order()
    if !mt_can_run() then return

    assert_eq(mt_ran("print(approx_eq_rel(100.0, 100.001, 1e-4), approx_eq_rel(100.001, 100.0, 1e-4))"),
              "true true\n")

// -- outside the domain ---------------------------------------------------------------------------
//
// What the module does where the mathematics runs out. None of these is an error: IEEE 754 says what
// each answer is, and a library that trapped instead would be taking a decision away from the caller
// who can see which of them matters.

@test("a root and a logarithm of a negative operand are not numbers")
mt_a_root_and_a_logarithm_of_a_negative_operand()
    if !mt_can_run() then return

    assert_eq(mt_ran("print((-1.0).sqrt().is_nan(), (-1.0).ln().is_nan(), (-2.0).asin().is_nan())"),
              "true true true\n")

@test("the logarithm of zero is the infinity it tends to")
mt_the_logarithm_of_zero()
    if !mt_can_run() then return

    assert_eq(mt_ran("print((0.0).ln(), (0.0).log2(), (0.0).log10())"), "-inf -inf -inf\n")

@test("a remainder by zero is not a number, where an integer remainder would trap")
mt_a_remainder_by_zero_is_not_a_number()
    if !mt_can_run() then return

    assert_eq(mt_ran("print((1.0).fmod(0.0).is_nan(), (0.0).fmod(1.0))"), "true 0\n")

// The three corners C fixes by fiat rather than by limit, and a program is entitled to rely on them:
// nothing raised to nothing is one, and a negative power of zero is the infinity.
@test("the corners of a power")
mt_the_corners_of_a_power()
    if !mt_can_run() then return

    assert_eq(mt_ran("print((0.0).pow(0.0), (0.0).pow(-1.0), (-8.0).pow(2.0), (-8.0).pow(0.5).is_nan())"),
              "1 inf 64 true\n")

// What the default's division does when the base has no logarithm to divide by. Worth pinning
// because it is the one place a *derived* member can go wrong in a way its parts cannot.
@test("a logarithm in base one")
mt_a_logarithm_in_base_one()
    if !mt_can_run() then return

    assert_eq(mt_ran("print((2.0).log(1.0), (1.0).log(1.0).is_nan())"), "inf true\n")

@test("the top of binary32's range")
mt_the_top_of_binary32s_range()
    if !mt_can_run() then return

    assert_eq(mt_ran(raw"""
        var top: f32 = 3.4028234663852886e38f32
        print(top.is_finite(), (top * 2.0f32).is_infinite(), top.recip().is_finite())
        """), "true true true\n")

// -- width-generic mathematics --------------------------------------------------------------------
//
// The payoff of the trait being a trait rather than two sets of functions: a program can bound a
// type parameter by it and write the mathematics once. The supertraits are what make the body below
// legal — `+` inside a generic needs `Add`, and `Float` requires it so that a caller does not have
// to write the bound out.

@test("a program may bound a type parameter by the trait")
mt_a_program_may_bound_a_type_parameter_by_the_trait()
    if !mt_can_run() then return

    assert_eq(mt_ran(raw"""
        length[T: Float](x: T, y: T) -> T = (x.square() + y.square()).sqrt()

        print(length(3.0, 4.0), length(3.0f32, 4.0f32))
        """), "5 5\n")

// A default is a copy per implementing type rather than one shared body, so the two widths get their
// own `square` and neither is emitted through the other. Counted on the whole module, since these
// are library members and not the program's own.
@test("a default is materialized once per width")
mt_a_default_is_materialized_once_per_width()
    if mt_no_library() then return

    if !clang_available()
        print("skipped: there is no clang on this machine")
        return

    val text = mt_llvm("var x: real = 3.0\nvar y: f32 = 3.0f32\nprint(x.square(), y.square())")
    val lines = lines_of(text)
    var defined = 0

    for i in 0..<lines.len()
        if lines.at(i).starts_with("define") && lines.at(i).contains(".square(") then defined += 1

    assert_eq(defined, 2)

@test("and reach the defaults through the bound")
mt_and_reach_the_defaults_through_the_bound()
    if !mt_can_run() then return

    assert_eq(mt_ran(raw"""
        decibels[T: Float](power: T, reference: T) -> T = (power / reference).log10()

        print(decibels(100.0, 1.0), decibels(100.0f32, 1.0f32))
        """), "2 2\n")

// -- the error path -------------------------------------------------------------------------------

// What the import gates, which is one answer for both halves of the module. A *name* — `pi`, `min`,
// `nan` — lives in a submodule and has to be asked for, which is `reference/modules.md`'s rule and
// the reason `sysl.math` is a submodule at all.
@test("a name from the module has to be asked for")
mt_a_name_from_the_module_has_to_be_asked_for()
    if mt_no_library() then return

    assert(mt_err_plain("print(pi)").contains("pi"), mt_err_plain("print(pi)"))
    assert(mt_err_plain("print(min(1, 2))").contains("min"), mt_err_plain("print(min(1, 2))"))
    assert(mt_err_plain("print(nan())").contains("nan"), mt_err_plain("print(nan())"))

// A **member** is asked for the same way: it is reachable where its **trait** is, so `Float` giving
// `real` a `sqrt` reaches only the files that named `Float`. Pinned in both directions because the
// symmetry is what a reader is owed.
@test("and so does a member, which is the same rule and not an exception to it")
mt_and_so_does_a_member()
    if !mt_can_run() then return

    assert_eq(mt_ran("print((2.0).sqrt() > 1.414)"), "true\n")

    val said = mt_err_plain("print((144.0).sqrt())")

    assert(said.contains("'sqrt'"), said)
    assert(said.contains("sysl.math.Float"), said)
    assert(said.contains("not in scope"), said)

// Naming the trait by hand reaches it exactly as a wildcard does, which is what makes the rule about
// the trait rather than about the module: `cbrt` comes with `Float` and not with `tau`.
@test("naming the trait alone is enough to reach its members")
mt_naming_the_trait_alone_is_enough()
    if !mt_can_run() then return

    assert_eq(mt_ran_plain("import sysl.math.Float\nprint((144.0).sqrt(), (8.0).cbrt())"), "12 2\n")

@test("a width the trait was not implemented for")
mt_a_width_the_trait_was_not_implemented_for()
    if mt_no_library() then return

    val said = mt_err_plain("import sysl.math.*\nprint((2).sqrt())")

    assert(said.contains("sqrt"), said)

@test("an argument of the other width")
mt_an_argument_of_the_other_width()
    if mt_no_library() then return

    val said = mt_err_plain("import sysl.math.*\nvar x: real = 2.0\nprint(x.pow(2.0f32))")

    assert(said.contains("f32"), said)

@test("an ordering the type does not have")
mt_an_ordering_the_type_does_not_have()
    if mt_no_library() then return

    val said = mt_err_plain(raw"""
        import sysl.math.*

        struct Blob
            n: int

        print(min(Blob(1), Blob(2)).n)
        """)

    assert(said.contains("Ord"), said)

// What `sysl.sys` being the library's own is for: the libm bindings under `sysl.math` are not a
// surface a program may reach, whether or not it imports the module that uses them.
@test("the C bindings underneath are the library's own")
mt_the_c_bindings_underneath_are_the_librarys_own()
    if mt_no_library() then return

    val said = mt_err_plain("import sysl.math.*\nprint(sysl_sqrt(2.0))")

    assert(said.contains("sysl_sqrt"), said)

// The library claims no names. A trait's members are reachable where the **trait** is in scope, so
// `Float` giving `real` a `sqrt` leaves the name free for anyone else's trait to give it another —
// which is what keeps a shipped library implementing a wide trait for a built-in from spending those
// names on every program that will ever compile.
@test("a program may give a float a member the trait already names")
mt_a_program_may_give_a_float_a_member_the_trait_names()
    if !mt_can_run() then return

    assert_eq(mt_ran_plain(raw"""
        trait Mine
            sqrt(self) -> real

        impl Mine for real
            sqrt(self) -> real = 42.0

        main()
            var x: real = 9.0
            print(x.sqrt())
        """), "42\n")

// And with both in scope the call is the thing that cannot be resolved — reported where it happens,
// naming both traits, rather than one of them silently winning.
@test("a call reaching both traits' member is refused, not silently resolved")
mt_a_call_reaching_both_traits_member_is_refused()
    if mt_no_library() then return

    val said = mt_err_plain(raw"""
        import sysl.math.*

        trait Mine
            sqrt(self) -> real

        impl Mine for real
            sqrt(self) -> real = 42.0

        main()
            var x: real = 9.0
            print(x.sqrt())
        """)

    assert(said.contains("'sqrt'"), said)
    assert(said.contains("which was meant"), said)

// `real` and `f64` are one type under one owner key, so the library's implementation is already
// there under both spellings and a program cannot add a second. The diagnostic renders the key,
// which is why it says `real` for an `impl` written `for f64`.
@test("the widths cannot be implemented for a second time under their other spelling")
mt_the_widths_cannot_be_implemented_a_second_time()
    if mt_no_library() then return

    val said = mt_err("impl Float for f64\n    sqrt(self) -> f64 = 0.0")

    assert(said.contains("'real' already implements 'sysl.math.Float'"), said)

// The trait is not object-safe, and it is its **supertraits** that decide that: `Eq::eq` takes a
// second `Self`, which an erased value has forgotten. So `Float` is for bounds and receivers and
// there is no `&Float` to pass around.
@test("there is no trait object over it")
mt_there_is_no_trait_object_over_it()
    if mt_no_library() then return

    val said = mt_err("report(f: &Float) -> real = f.sqrt()")

    assert(said.contains("no '&sysl.math.Float' to form"), said)

// And the other side of it: a *name* is only the module's inside the module, so a program is free to
// declare its own `min` — and while it does, the import cannot also be offering one.
@test("a program may declare a name the module offers, so long as it does not import it too")
mt_a_program_may_declare_a_name_the_module_offers()
    if !mt_can_run() then return

    assert_eq(mt_ran("print(3.0.hypot(4.0))"), "5\n")

    assert_eq(mt_ran_plain(raw"""
        min(a: string, b: string) -> string = if b < a then b else a

        print(min("pear", "apple"))
        """), "apple\n")
