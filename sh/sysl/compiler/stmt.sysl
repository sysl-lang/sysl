module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.math.bigint.BigInt

// Statements, and the blocks they live in.
//
// **A block is an expression.** It has a type, taken from its trailing expression, or `never` where
// it ends in a jump and control does not arrive at the bottom at all. That is what lets
// `if c then 1 else return 0` be an `int`: the jump is still not an expression, but the block
// around it is one, and its type says control does not arrive.
//
// **A statement in statement position has no value, whatever its last expression yields.** There is
// no terminator to write "and throw this away" with, so a trailing call or an assignment would
// otherwise make a block plainly written for its effect claim a value nobody asked for -- and two
// such blocks under one `if` would then be made to agree on it.

// A block whose trailing expression, where it has one, is its value -- a function body or a branch.
// Its statements share one lexical scope with that expression.
type_value_block(cx: &Analyzer, stmts: Buf[Stmt], expected: Option[Type],
                 discarded: bool) -> TBlock
    cx.enter()

    val b = type_block_body(cx, stmts, expected, discarded)

    cx.leave()
    b
end type_value_block

// The body of a value block, in whatever scope the caller has established -- a match arm runs this
// after declaring its pattern bindings, so they are visible to the body.
type_block_body(cx: &Analyzer, stmts: Buf[Stmt], expected: Option[Type],
                discarded: bool) -> TBlock
    val last = trailing_kind(stmts)

    if last == TrailingValue
        var init: Buf[TStmt] = buf()

        for i in 0..<stmts.len() - 1
            push_all(&init, recover_stmt(cx, stmts.at(i)))

        val e = trailing_expr(stmts.at(stmts.len() - 1))

        // A block whose value *is* the enclosing function's result is the third place a result list
        // may stand, which is what lets a branch or a nested block forward one.
        val tr = trailing_value(cx, e, expected, discarded)
        val ty = if discarded && texpr_type(tr) != Never then Unit else texpr_type(tr)

        return TBlock(init, Some(tr), ty)
    end if

    var out: Buf[TStmt] = buf()

    for i in 0..<stmts.len()
        push_all(&out, recover_stmt(cx, stmts.at(i)))

    TBlock(out, None, if last == TrailingJump then Never else Unit)
end type_block_body

// A block's trailing expression. A block whose value *is* the enclosing function's result is the
// third place a result list may stand, which is what lets a branch or a nested block forward one.
private trailing_value(cx: &Analyzer, e: Expr, expected: Option[Type], discarded: bool) -> TExpr
    if wants_results(cx, expected) then return type_expr_multi(cx, e, expected)

    type_expr_discarded(cx, e, expected, discarded)
end trailing_value

// What the last statement of a block says about the block's type.
enum Trailing
    // An expression, whose value the block's is.
    TrailingValue

    // `return`, `break` or `continue` -- control does not arrive at the bottom.
    TrailingJump

    // Anything else, which yields nothing.
    TrailingNone
end Trailing

private trailing_kind(stmts: Buf[Stmt]) -> Trailing
    if stmts.is_empty() then return TrailingNone

    *stmts.at(stmts.len() - 1).kind match
        ExprStmt(_) -> TrailingValue
        Return(_) -> TrailingJump
        Break(_, _) -> TrailingJump
        Continue(_) -> TrailingJump
        _ -> TrailingNone
end trailing_kind

private trailing_expr(s: Stmt) -> Expr = *s.kind match
    ExprStmt(e) -> e
    _ -> Expr(s.span, UnitLit)

// A statement sequence used only for its effects -- a loop body: a fresh scope, no value.
type_stmts(cx: &Analyzer, stmts: Buf[Stmt]) -> Buf[TStmt]
    cx.enter()

    val out = loop_stmts(cx, stmts)

    cx.leave()
    out
end type_stmts

// A loop body: the `invariant` and `variant` clauses at its head, then the rest.
//
// The clauses are read **in the loop's own scope**, before anything the body declares, which is
// what lets one read the loop variable and stops one reading a local declared under it. The split
// is by position, exactly as a function's contract block is -- so a clause that reaches
// `recover_stmt` is one written somewhere it may not be, and says so there.
loop_stmts(cx: &Analyzer, stmts: Buf[Stmt]) -> Buf[TStmt]
    var out: Buf[TStmt] = buf()
    var i: usize = 0

    while i < stmts.len() && is_loop_clause(stmts.at(i))
        out.push(loop_clause(cx, stmts.at(i)))
        i = i + 1

    // The rest is read BEFORE the measure is handed up, so a loop nested inside this one has
    // already taken its own and put it back.
    val slot = cx.pending_variant

    cx.pending_variant = None

    while i < stmts.len()
        push_all(&out, recover_stmt(cx, stmts.at(i)))
        i = i + 1

    cx.pending_variant = slot
    out
end loop_stmts

private is_loop_clause(s: Stmt) -> bool = *s.kind match
    Invariant(_, _) -> true
    Variant(_) -> true
    _ -> false

// One `invariant` or `variant` at the head of a loop's body.
private loop_clause(cx: &Analyzer, c: Stmt) -> TStmt = *c.kind match
    Invariant(cond, msg) -> TInvariant(analyze_bool(cx, cond), msg)
    Variant(e) ->
        if cx.pending_variant.is_some() then
            cx.fault(c.span, "a loop declares one 'variant' — a measure is the thing that " +
                     "decreases, and two of them say nothing about which")

        val te = type_expr_bare(cx, e)
        val ty = integer_measure(cx, c.span, texpr_type(te))

        cx.variant_seq = cx.variant_seq + 1

        val slot = s"variant${cx.variant_seq}"

        cx.pending_variant = Some((slot, ty))
        TVariantCheck(slot, ty, te)
    _ -> TExprStmt(TExpr(c.span, TUnitLit))

private integer_measure(cx: &Analyzer, span: Span, t: Type) -> Type = t match
    Integer(_, _, _) -> t
    Unknown -> t
    other ->
        cx.fault(span, s"a 'variant' is an integer measure, not ${type_show(other)}")
        Unknown

// A loop that declared a `variant`, wrapped so its slots are set up once per entry.
checked_loop(ctx: &LoopCtx, span: Span, walked: TExpr) -> TExpr
    if ctx.variant.is_none() then return walked

    val v = ctx.variant.unwrap()

    TExpr(span, TCheckedLoop(v.0, v.1, walked))
end checked_loop

// Opens a loop, so that `break` and `continue` inside its body reach this one and every `break`
// value is collected for its result type.
open_loop(cx: &Analyzer, span: Span, expected: Option[Type],
          label: Option[string]) -> &LoopCtx
    if label.is_some()
        for i in 0..<cx.loops.len()
            if cx.loops.at(i).label == label then
                cx.fault(span, s"label '${label.unwrap()} is already in scope")
    end if

    val ctx = loop_ctx(expected, label)
    var kept: Buf[&LoopCtx] = buf()

    kept.push(ctx)

    for i in 0..<cx.loops.len()
        kept.push(cx.loops.at(i))

    cx.loops = kept
    ctx
end open_loop

// Closes it, taking whatever measure its body declared.
close_loop(cx: &Analyzer, ctx: &LoopCtx)
    var kept: Buf[&LoopCtx] = buf()

    for i in 1..<cx.loops.len()
        kept.push(cx.loops.at(i))

    cx.loops = kept
    ctx.variant = cx.pending_variant
    cx.pending_variant = None

// The result type of a loop: every `break` value and the `else` value meet at one type.
//
// With no `else`, finishing normally yields `unit`, so a value-carrying `break` has nothing to meet
// on that path -- a clear error rather than a silent mismatch.
loop_result_type(cx: &Analyzer, span: Span, ctx: &LoopCtx, else_block: Option[TBlock]) -> Type
    var tys: Buf[Type] = buf()

    for i in 0..<ctx.break_tys.len()
        tys.push(ctx.break_tys.at(i))

    tys.push(if else_block.is_none() then Unit else else_block.unwrap().ty)

    val joined = meet_all(tys)

    if joined.is_some() then return joined.unwrap()

    if else_block.is_none()
        val v = first_value(ctx.break_tys)

        cx.fault(span, s"this loop breaks with a ${type_show(v)} but has no 'else' to give a " +
                 "value when it finishes normally — add an 'else'")

        return Unknown
    end if

    cx.fault(span, s"a loop's break values and its 'else' must have the same type, but got " +
             s"${type_list_show(tys)}")
    Unknown
end loop_result_type

// The result type of a `loop`, which has no `else` and so nothing on the normal-completion path for
// its breaks to meet: they decide it between them.
//
// A `loop` nothing breaks out of is `never`. That is the one thing `while true` could not say, and
// it is what lets one stand as the last thing a function returning a value does.
endless_result_type(cx: &Analyzer, span: Span, ctx: &LoopCtx) -> Type
    if ctx.break_tys.is_empty() then return Never

    val joined = meet_all(ctx.break_tys)

    if joined.is_some() then return joined.unwrap()

    cx.fault(span, s"a loop's break values must have the same type, but got " +
             s"${type_list_show(ctx.break_tys)}")
    Unknown
end endless_result_type

private meet_all(tys: Buf[Type]) -> Option[Type]
    if tys.is_empty() then return None

    var acc: Option[Type] = Some(tys.at(0))

    for i in 1..<tys.len()
        if acc.is_none() then return None

        acc = join_types(acc.unwrap(), tys.at(i))

    acc
end meet_all

private first_value(tys: Buf[Type]) -> Type
    for i in 0..<tys.len()
        if !no_value(tys.at(i)) then return tys.at(i)

    Unit
end first_value

// The distinct types of a list, as a diagnostic joins them.
private type_list_show(tys: Buf[Type]) -> string
    var seen: Buf[string] = buf()

    for i in 0..<tys.len()
        val text = type_show(tys.at(i))
        var have = false

        for j in 0..<seen.len()
            if seen.at(j) == text then have = true

        if !have then seen.push(text)

    var out = ""

    for i in 0..<seen.len()
        if i > 0 then out = out + " and "

        out = out + seen.at(i)

    out
end type_list_show

// -- one statement -----------------------------------------------------------------------------

// One statement, read so that a mistake costs the statement it is in and nothing after it.
//
// **There is nothing here to recover from, and that is the point.** The reference compiler's `err`
// throws and a `recover` catches it, so a statement that fails is abandoned part-way and its scopes
// and loops have to be wound back; here every refusal records its diagnostic and answers with a
// fallback, so the walk never leaves a statement half-read. What the reference's recovery buys --
// a `var` whose initializer failed still binding its name, at `Unknown`, so that one bad
// initializer does not turn every later use into an "undefined name" of its own -- each rule below
// does for itself, by binding before it returns.
//
// It is named for what the reference calls it because every caller is a place the reference calls
// it, and the two walks are read side by side.
recover_stmt(cx: &Analyzer, stmt: Stmt) -> Buf[TStmt] = type_stmt(cx, stmt)

// Most statements are one statement. The two comma forms are the exception, and the only reason
// this hands back a list: a binding that names several things is several declarations.
type_stmt(cx: &Analyzer, stmt: Stmt) -> Buf[TStmt] = *stmt.kind match
    MultiAssign(op, targets, values) -> multi_assign(cx, stmt.span, op, targets, values)
    MultiDecl(names, mutable, values) -> multi_decl(cx, stmt.span, names, mutable, values)
    PatternDecl(pat, mutable, value) -> pattern_decl(cx, stmt.span, pat, mutable, value)

    VarDecl(name, typ, init, _, align, section) ->
        var_decl(cx, stmt.span, name, typ, init, align, section)

    // A local `val` is a `var` that may not be assigned to again -- same frame, same lifetime, same
    // code. Only the binding differs, so the read-only half is enforced where an assignment target
    // is checked rather than here.
    ValDecl(name, typ, value, _, align, section) ->
        val_decl(cx, stmt.span, name, typ, value, align, section)

    RefDecl(name, place) -> ref_decl(cx, stmt.span, name, place)

    // A statement's value is nobody's, so whatever branching it contains is read knowing that.
    ExprStmt(e) -> one_stmt(TExprStmt(type_expr_discarded(cx, e, None, true)))

    Return(value) -> return_stmt(cx, stmt.span, value)
    Become(call) -> become_stmt(cx, stmt.span, call)
    Break(label, value) -> break_stmt(cx, stmt.span, label, value)
    Continue(label) -> continue_stmt(cx, stmt.span, label)
    Defer(inner) -> defer_stmt(cx, stmt.span, inner)

    AsmStmt(arms) -> one_stmt(type_asm(cx, stmt.span, arms))

    // An import binds a name for the statements after it and emits nothing. A block-scoped import
    // is the declaration pass's to record, so what is left here is the empty statement it lowers to.
    ImportDecl(_) -> one_stmt(TExprStmt(TExpr(stmt.span, TUnitLit)))

    // A `const` written at the top of a file is folded into its uses before anything runs, so it
    // never reaches the statement walk. One that reaches here was written **inside a body**, where
    // there is nothing to hoist it into.
    ConstDecl(_, _, _, _) ->
        refuse(cx, stmt.span, "a constant is a module member and is declared at the top level — " +
               "it is folded into its uses before the program runs, so there is no block for one " +
               "written here to belong to. A name bound to a value inside a body is a 'val'")

    CConstBlock(_) ->
        refuse(cx, stmt.span, "a 'c const' block is declared at the top level of a file — the C " +
               "in it is compiled against that file's '@include' headers, and a block inside a " +
               "body would be asking the same question from a place that cannot answer it")

    CTypeBlock(_) ->
        refuse(cx, stmt.span, "a 'c type' block is declared at the top level of a file — the C in " +
               "it is compiled against that file's '@include' headers, and what it declares is a " +
               "type, which is a module member rather than something a body can hold")

    StaticDecl(_) ->
        refuse(cx, stmt.span, "'static' marks a declaration at the top of the file the program " +
               "starts in, saying it belongs to the module rather than to that file's body. A " +
               "declaration inside a block is local to that block and there is no module member " +
               "for it to be instead")

    // The leading clauses of a function body are split off before the body is read, so any that
    // reach here sit after another statement or inside an inner block -- both disallowed.
    Require(_, _) -> refuse(cx, stmt.span, clause_out_of_place())
    Ensure(_, _) -> refuse(cx, stmt.span, clause_out_of_place())

    Invariant(_, _) ->
        refuse(cx, stmt.span, "an 'invariant' belongs at the head of a loop's body — it is a " +
               "condition that holds on every entry to that body, and one written after some of " +
               "the work has already been done is not that. A condition over a struct's fields is " +
               "written in the struct, and one over a function's arguments is a 'require'")

    Variant(_) ->
        refuse(cx, stmt.span, "a 'variant' belongs at the head of a loop's body, where it is what " +
               "decreases from one iteration to the next, or in a function's contract block, " +
               "where it is what decreases at each recursive call")

    StructDecl(_) -> refuse(cx, stmt.span, top_level_only())
    EnumDecl(_) -> refuse(cx, stmt.span, top_level_only())
    TraitDecl(_) -> refuse(cx, stmt.span, top_level_only())
    ImplDecl(_) -> refuse(cx, stmt.span, top_level_only())
    ExternDecl(_) -> refuse(cx, stmt.span, top_level_only())
    ExternVarDecl(_, _, _, _) -> refuse(cx, stmt.span, top_level_only())
    TypeDecl(_) -> refuse(cx, stmt.span, top_level_only())

    // A function declared inside a body is a nested function, and lifting a block's into an
    // environment belongs with the rest of closure lowering.
    FuncDecl(_) ->
        refuse(cx, stmt.span, "a function declared inside a body is not lowered yet")

    // `@assert` settles while compiling and emits nothing either way: a true assertion is not code,
    // and a false one has already stopped the compilation.
    AssertDecl(_, _) -> buf()

    Bad -> one_stmt(TExprStmt(TExpr(stmt.span, TUnitLit)))

private clause_out_of_place() -> string =
    "'require'/'ensure' clauses must come before any other statement in a function body"

private top_level_only() -> string =
    "structs, enums, traits, impls, externs, and types may only be declared at the top level"

private refuse(cx: &Analyzer, span: Span, message: string) -> Buf[TStmt]
    cx.fault(span, message)
    one_stmt(TExprStmt(TExpr(span, TUnitLit)))
end refuse

// A list holding one statement, which is what most of the forms hand back.
one_stmt(s: TStmt) -> Buf[TStmt]
    var out: Buf[TStmt] = buf()

    out.push(s)
    out
end one_stmt

push_all(out: *Buf[TStmt], xs: Buf[TStmt])
    for i in 0..<xs.len()
        out.push(xs.at(i))

// -- the bindings ---------------------------------------------------------------------------------

private var_decl(cx: &Analyzer, span: Span, name: string, typ: Option[TypeRef],
                 init: Option[Expr], align: Option[Expr], section: Option[string]) -> Buf[TStmt]
    no_section(cx, span, name, section)

    val declared = typ.map(w -> resolve_type(cx.an, cx.scope, w, cx.subst))

    if init.is_none()
        if declared.is_none()
            cx.fault(span, s"'$name' needs either a type or an initial value")

            return one_stmt(TVarDecl(cx.bind(name, Unknown), Unknown, TExpr(span, TZero(Unknown)), None))
        end if

        val ty = declared.unwrap()

        if !has_zero(ty) then
            cx.fault(span, s"${type_show(ty)} has no zero value, so '$name' needs an initial value")

        return one_stmt(TVarDecl(cx.bind(name, ty), ty, TExpr(span, TZero(ty)),
                            boundary(cx, name, align)))
    end if

    val ti = type_expr(cx, init.unwrap(), declared)
    val decl_ty = settled_binding_type(declared, ti)

    check_binding(cx, init.unwrap().span, name, declared, decl_ty, ti)
    one_stmt(TVarDecl(cx.bind(name, decl_ty), decl_ty, ti, boundary(cx, name, align)))
end var_decl

private val_decl(cx: &Analyzer, span: Span, name: string, typ: Option[TypeRef], value: Expr,
                 align: Option[Expr], section: Option[string]) -> Buf[TStmt]
    no_section(cx, span, name, section)

    val declared = typ.map(w -> resolve_type(cx.an, cx.scope, w, cx.subst))
    val ti = type_expr(cx, value, declared)
    val decl_ty = settled_binding_type(declared, ti)

    check_binding(cx, value.span, name, declared, decl_ty, ti)
    one_stmt(TVarDecl(cx.bind_read_only(name, decl_ty), decl_ty, ti, boundary(cx, name, align)))
end val_decl

// The type a binding holds: the one it was declared with, and the value's where it was not.
private settled_binding_type(declared: Option[Type], ti: TExpr) -> Type
    if declared.is_some() then return declared.unwrap()

    texpr_type(ti)
end settled_binding_type

// A binding needs a value to hold, and an initializer that does not finish never produces one --
// the code after it is unreachable, so the declaration is a mistake rather than a clever way to
// spell divergence.
private check_binding(cx: &Analyzer, span: Span, name: string, declared: Option[Type],
                      decl_ty: Type, ti: TExpr)
    if texpr_type(ti) == Never then
        cx.fault(span, s"cannot bind '$name' to an expression that never returns")

    if declared.is_some() && disagree(texpr_type(ti), decl_ty) then
        cx.fault(span, s"cannot initialize '$name': declared ${type_show(decl_ty)} but the value " +
                 s"is ${type_show(texpr_type(ti))}")

// `ref name = place` -- another name for storage that already exists. The place is read once, here,
// and what the name means afterwards is the storage it found.
private ref_decl(cx: &Analyzer, span: Span, name: string, place: Expr) -> Buf[TStmt]
    val tp = type_expr_bare(cx, place)

    // Rule one, and the message says what a place is rather than that this is not one: the mistake
    // is nearly always a call, and "it has no address" explains every case at once.
    if !is_place(tp) && texpr_type(tp) != Unknown then
        cx.fault(span, s"'ref' names a place — a local, a field, an element, or a dereference — " +
                 s"and this expression has no address for '$name' to name. Bind it with 'val' to " +
                 "hold the value it produces")

    if texpr_type(tp) == Never then
        cx.fault(span, s"cannot bind '$name' to an expression that never returns")

    one_stmt(TRefDecl(cx.bind(name, texpr_type(tp)), texpr_type(tp), tp))
end ref_decl

// `@section("…")` above a **local**, which is refused here rather than in the grammar: a local's
// storage is the frame, laid down by whichever call is running, and a section is a region of the
// image decided once at the link.
private no_section(cx: &Analyzer, span: Span, name: string, section: Option[string])
    if section.is_none() then return

    cx.fault(span, s"'$name' is a local, so it cannot be placed in section " +
             s"\"${section.unwrap()}\" — its storage is the frame of whichever call is running, " +
             "and a section is a region of the image the linker decides once. Declare it as " +
             "module storage, outside every function, for a section to be about")

// `@align(n)` above a binding, folded to the boundary it named. A refusal costs the annotation and
// not the declaration, which is what lets the rest of the function still be read.
private boundary(cx: &Analyzer, name: string, align: Option[Expr]) -> Option[usize]
    if align.is_none() then return None

    val folded = const_fold(cx, align.unwrap())

    folded match
        Some(c) -> c match
            ConstInt(n) ->
                val v = n.to_long().unwrap_or(0)

                if v > 0 && (v & (v - 1)) == 0 && v <= (1 << 29) then return Some(usize(v))

                cx.fault(align.unwrap().span, s"'@align($v)' on '$name' is not an alignment — a " +
                         "boundary is a power of two, since an address is aligned by having low " +
                         "bits clear")
                None
            _ -> not_a_boundary(cx, align.unwrap().span, name)
        None -> not_a_boundary(cx, align.unwrap().span, name)
end boundary

private not_a_boundary(cx: &Analyzer, span: Span, name: string) -> Option[usize]
    cx.fault(span, s"'@align' on '$name' needs a constant — a literal, a 'const', or the " +
             "arithmetic over them. A layout is fixed while compiling and is part of what this " +
             "module publishes, so it cannot wait on a value")
    None
end not_a_boundary
// -- the jumps ------------------------------------------------------------------------------------

private return_stmt(cx: &Analyzer, span: Span, value: Option[Expr]) -> Buf[TStmt]
    val want = cx.ret_ty.unwrap_or(Unit)

    if value.is_none()
        if want != Unit then
            cx.fault(span, s"this function must return a ${type_show(want)} value")

        return one_stmt(TReturn(None))
    end if

    val tv = returned_value(cx, value.unwrap(), want)

    if want == Unit then
        cx.fault(span, "cannot return a value from a function with no return type")
    else if disagree(texpr_type(tv), want) then
        cx.fault(span, s"return type mismatch: expected ${type_show(want)}, got " +
                 s"${type_show(texpr_type(tv))}")

    one_stmt(TReturn(Some(tv)))
end return_stmt

// What a `return` hands back, read in the one position a function's own result list may stand.
private returned_value(cx: &Analyzer, e: Expr, want: Type) -> TExpr
    if cx.ret_is_list then return type_expr_multi(cx, e, Some(want))

    type_expr(cx, e, Some(want))
end returned_value

// `become f(…)` -- `return f(…)` with the jump guaranteed. What is settled here is that there is a
// call at all; whether the frame can be replaced needs the whole program and is a later pass.
private become_stmt(cx: &Analyzer, span: Span, call: Expr) -> Buf[TStmt]
    val want = cx.ret_ty.unwrap_or(Unit)
    val t = type_expr(cx, call, Some(want))

    if !is_call(t) && texpr_type(t) != Unknown then
        cx.fault(span, "'become' replaces this frame with a call's, so what follows it has to be " +
                 "a call — 'return' is what hands a value back without replacing anything")

    if disagree(texpr_type(t), want) then
        cx.fault(span, s"'become' hands on this function's result, so the call has to answer " +
                 s"${type_show(want)} — this one answers ${type_show(texpr_type(t))}")

    one_stmt(TBecome(t))
end become_stmt

private is_call(t: TExpr) -> bool = *t.kind match
    TCall(_, _, _, _) -> true
    TCallPtr(_, _, _, _) -> true
    _ -> false

// `break value` records its type against the loop it targets, which unites it with that loop's
// other breaks and its `else` to fix the loop's result type. The value is read at the target loop's
// expected type, so a `break &T` boxes the same way a `break` in a `&T` context asks.
private break_stmt(cx: &Analyzer, span: Span, label: Option[string],
                   value: Option[Expr]) -> Buf[TStmt]
    val found = resolve_loop(cx, span, "break", label)

    if found.is_none()
        if value.is_some() then type_expr_bare(cx, value.unwrap())

        return one_stmt(TBreak(None, 0))
    end if

    val ctx = found.unwrap().0
    val tv = value.map(e -> type_expr(cx, e, ctx.expected))

    ctx.break_tys.push(if tv.is_none() then Unit else texpr_type(tv.unwrap()))
    one_stmt(TBreak(tv, found.unwrap().1))
end break_stmt

private continue_stmt(cx: &Analyzer, span: Span, label: Option[string]) -> Buf[TStmt]
    val found = resolve_loop(cx, span, "continue", label)

    one_stmt(TContinue(if found.is_none() then 0 else found.unwrap().1))
end continue_stmt

// Resolves a `break`/`continue` to the loop it targets and that loop's distance out from the
// innermost. An absent label is the nearest loop; a `'name` is the nearest loop carrying it.
private resolve_loop(cx: &Analyzer, span: Span, keyword: string,
                     label: Option[string]) -> Option[(&LoopCtx, int)]
    if label.is_none()
        if !cx.loops.is_empty() then return Some((cx.loops.at(0), 0))

        if cx.in_const_for then return not_in_an_unrolled_loop(cx, span, keyword)

        cx.fault(span, s"'$keyword' is only allowed inside a loop")
        return None
    end if

    for i in 0..<cx.loops.len()
        if cx.loops.at(i).label == label then return Some((cx.loops.at(i), int(i)))

    if cx.in_const_for then return not_in_an_unrolled_loop(cx, span, keyword)

    cx.fault(span, s"no enclosing loop is labeled '${label.unwrap()}")
    None
end resolve_loop

// Why a `for const` body takes neither `break` nor `continue`: there is no loop at run time for
// either to act on. The copies are straight-line code in the enclosing function, so a `break` here
// would leave whatever loop the `for const` happens to sit inside, silently and one copy at a time.
private not_in_an_unrolled_loop(cx: &Analyzer, span: Span,
                                keyword: string) -> Option[(&LoopCtx, int)]
    cx.fault(span, s"a 'for const' is unrolled into one copy of its body per value, so there is " +
             s"no loop for '$keyword' to act on — a loop that is walked at run time is the " +
             "ordinary 'for'")
    None
end not_in_an_unrolled_loop

// `defer stmt`. The statement is read here, where it is written, so it sees exactly the names in
// scope at that point -- and it is handed to the block rather than emitted, so nothing runs until
// the block is left.
//
// What may be deferred is bounded by what teardown can mean, and each refusal is a different
// mistake so each is named on its own.
private defer_stmt(cx: &Analyzer, span: Span, inner: Stmt) -> Buf[TStmt]
    *inner.kind match
        Return(_) ->
            cx.fault(span, "a deferred statement runs while its block is being left, so it cannot " +
                     "'return' — there is no exit left to take. Compute what the function returns " +
                     "before the block ends")
        Break(_, _) -> cx.fault(span, deferred_jump())
        Continue(_) -> cx.fault(span, deferred_jump())
        Defer(_) ->
            cx.fault(span, "'defer' schedules a statement, and scheduling a scheduling has " +
                     "nothing to run: write the statement itself after this 'defer'")
        VarDecl(_, _, _, _, _, _) -> cx.fault(span, deferred_declaration())
        ValDecl(_, _, _, _, _, _) -> cx.fault(span, deferred_declaration())
        MultiDecl(_, _, _) -> cx.fault(span, deferred_declaration())
        ConstDecl(_, _, _, _) -> cx.fault(span, deferred_declaration())
        _ -> ()

    var body: Buf[Stmt] = buf()

    body.push(inner)

    val t = type_stmts(cx, body)

    // A `?` leaves the function, which is the same exit a `return` would take and is refused for
    // the same reason. It is read out of the analyzed body rather than the written statement,
    // because `?` is an operator inside an expression at whatever depth the expression has.
    if stmts_try(t) then
        cx.fault(span, "a deferred statement runs while its block is being left, so a '?' in it " +
                 "has nowhere to return to. Check the result and handle the failure in the " +
                 "deferred statement itself")

    one_stmt(TDefer(t))
end defer_stmt

private deferred_jump() -> string =
    "a deferred statement runs while its block is being left, so it cannot 'break' or 'continue' " +
        "— the loop edge it would take is the one already being taken"

private deferred_declaration() -> string =
    "a deferred declaration binds a name that dies the moment the statement finishes, so nothing " +
        "could read it — defer what uses the value instead of what declares it"
