module sysl.container
@tests

/** `Deque.get`: `Some` for an index counted from the front inside the length, `None` at and past it,
 * for a negative one, and on a deque that has never held anything.
 */

@test("Deque.get answers from the front, None at and past the length")
deque_get_in_and_out_of_range()
    var d: Deque[int] = deque()

    d.push_back(2)
    d.push_back(3)
    d.push_front(1)

    assert_eq(d.get(0), Some(1))
    assert_eq(d.get(2), Some(3))
    assert_eq(d.get(3), None)

@test("Deque.get on a deque that never held anything is None")
deque_get_empty()
    var d: Deque[int] = deque()

    assert_eq(d.get(0), None)

@test("Deque.get is None for a negative index of any signed width")
deque_get_negative()
    var d: Deque[int] = deque()

    d.push_back(1)

    val a: i8 = -1
    val b: i64 = -5

    assert_eq(d.get(a), None)
    assert_eq(d.get(b), None)
    assert_eq(d.get(i64(0)), Some(1))

@test("Deque.get after the ring has wrapped still counts from the front")
deque_get_wrapped()
    var d: Deque[int] = deque()

    for i in 0..<8
        d.push_back(i)

    for i in 0..<5
        d.pop_front()

    for i in 8..<12
        d.push_back(i)

    // 5 6 7 8 9 10 11, with the head off zero and the tail wrapped past the end of the storage.
    assert_eq(d.get(0), Some(5))
    assert_eq(d.get(2), Some(7))
    assert_eq(d.get(6), Some(11))
    assert_eq(d.get(7), None)
    assert_eq(d[3], 8)

@test("d[i] = v writes through the wrapped ring")
deque_subscript_set()
    var d: Deque[int] = deque()

    d.push_back(1)
    d.push_back(2)
    d[1] = 20

    assert_eq(d[1], 20)
