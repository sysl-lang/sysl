module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.container.{Map, map, Set, set}

// **Owned parameters**: a counted parameter a function keeps is handed over with a count of its own
// (`reference/memory.md § T — values`).
//
// A by-value argument is otherwise borrowed for the call (`borrowing.sysl`): the caller holds a count
// for its length, and a callee that stores the value takes one of its own. Where the callee always
// keeps what it is handed -- `push` putting it in a buffer, a constructor putting it in a box -- the
// two counts are one too many: the caller lets go of its own as soon as the call returns. So such a
// parameter is **owned**. The callee receives a count and is responsible for it, so it moves the value
// into its destination at its last use instead of retaining it, and gives the count back at its exit
// where it did not. The caller hands its own count over where the argument is at its last use -- a
// temporary, a local named for the last time (`emit_moves.sysl`) -- and takes one for the callee
// otherwise.
//
// **What "keeps" means here is what lets the callee move it**: the parameter, or a local or a value
// built around it, lands somewhere that outlives the call -- a store outside the frame's own locals, a
// box (a closure's environment among them), a buffer's slot, the function's result -- or is handed to
// another function's owned parameter -- **on every way out of the body**. A parameter kept on some
// paths only stays borrowed, and the path that keeps it takes its count where it stores it (`every way
// out`, below). The answer is a fixed point, so recursion settles on what the body does. A wrong
// answer either way is still correct code, only slower, since both conventions are complete; what has
// to hold is that caller and callee AGREE.
//
// **That agreement is why the answer reads nothing but the function's own body and its callees'
// answers.** A library's functions are compiled once, into the artifact, and each program that calls
// one works the answer out again from the same source: anything the program alone knows -- which
// addresses it takes, which tables it builds -- would make the two disagree. So nothing reached any
// way but a direct call relies on the convention at all: an owned function is emitted twice over, its
// body under `<symbol>.owned` and, under its own symbol, an entry that takes the count a borrowing
// caller did not hand over and then calls it (`owned_entry`). A table slot, a destructor hook, a
// closure and every other call the compiler writes for itself reach that entry, so they go on
// borrowing; only a call written in the program, to a function named directly, reaches the owned body.
//
// What never owns: a body something outside the program may call (`@export`, a `@section`, a foreign
// convention), a variadic one, a task (whose frame outlives the call anyway), a body that jumps back
// to its own entry, a closure's body, a parameter a contract names (its clauses read it after the body
// is done with it), a `@scoped` parameter, and a parameter that crosses as an address.

// Every parameter of the program a direct call hands a count to, as `<function>|<position>`.
owned_params(e: *Emit, p: TProgram) -> Set[string]
    var owned: Set[string] = set()
    var asks: Buf[(TFunc, usize)] = buf()

    for i in 0..<p.funcs.len()
        val f = p.funcs.at(i)

        if !may_own(f) then continue

        for j in 0..<f.params.len()
            if may_own_param(e, f, j) then asks.push((f, j))

    // Every candidate starts owned and is let go once some way out of its body is found not to keep
    // it. An answer only turns off as the answers it reads do, so the rounds settle -- on the largest
    // agreeing answer, which is what lets a recursive call that hands the parameter on count as keeping
    // it: `ping` calling `pong` calling `ping`, with a store at the bottom, owns all the way down.
    for item in asks
        owned.add(owned_key(item.0.name, item.1))

    var moved = true

    while moved
        moved = false

        for item in asks
            val key = owned_key(item.0.name, item.1)

            if owned.has(key) && !keeps_counted(item.0, item.1, owned)
                owned.remove(key)
                moved = true

    owned
end owned_params

// The key an owned parameter is filed under.
owned_key(name: string, i: usize) -> string = s"$name|$i"

// The functions among `owned` that own at least one parameter.
owning_funcs(p: TProgram, owned: Set[string]) -> Set[string]
    var out: Set[string] = set()

    for i in 0..<p.funcs.len()
        val f = p.funcs.at(i)

        for j in 0..<f.params.len()
            if owned.has(owned_key(f.name, j)) then out.add(f.name)

    out
end owning_funcs

private may_own(f: TFunc) -> bool =
    !f.ghost && !f.variadic && f.exported.is_none() && f.section.is_none() && f.conv.is_none() &&
        !f.marks.is_async() && f.variant.is_none() && !is_closure_body(f) && tail_calls_of(f).is_empty()

private may_own_param(e: *Emit, f: TFunc, j: usize) -> bool
    val ty = f.params.at(j).1

    contains_counted(ty) && movable_type(ty) && !e.layout.indirect(ty) && underlying(ty) != VaList &&
        !scoped_at(f, j) && !contract_reads(f, f.params.at(j).0)
end may_own_param

private struct Seen
    yes: bool

// Whether a contract clause or an `old` capture names the parameter. An `ensure` is checked after the
// body, and a parameter the body has handed on is no longer the frame's to read there; a contract
// that names only other things (`self`, the result) leaves the parameter free to own.
private contract_reads(f: TFunc, name: string) -> bool
    val seen: &Seen = Seen(false)
    val walk = expr_walk(true, x -> *x.kind match
        TLoad(n, _) -> if n == name then seen.yes = true
        _ -> ())

    for c in f.requires
        walk_texpr(c.cond, walk)

    for c in f.ensures
        walk_texpr(c.cond, walk)

    for x in f.olds
        walk_texpr(x, walk)

    seen.yes
end contract_reads

// One walk's state: the locals that may hold the parameter or something built around it, the refs
// (whose writes land in somebody else's storage), whether the body lets it outlive the call, and
// whether some way out of the body leaves without having done so (`lost`).
private struct OwnTrack
    held: Set[string]
    refs: Set[string]
    owned: Set[string]
    kept: bool
    changed: bool
    lost: bool
    loops: Buf[&KeepLoop]

    hold(*self, name: string)
        if !self.held.has(name)
            self.held.add(name)
            self.changed = true
    end hold
end OwnTrack

// Whether `f` keeps its parameter at `j` on every way out, given the parameters already known to be
// owned.
private keeps_counted(f: TFunc, j: usize, owned: Set[string]) -> bool
    val t: &OwnTrack = OwnTrack(set(), set(), owned, false, true, false, buf())

    t.held.add(f.params.at(j).0)

    walk_block_stmts(f.body, stmt_walk(false, s -> s match
        TRefDecl(n, _, _) -> t.refs.add(n)
        _ -> ()))

    // A fixpoint over the locals, since a body may pass the value along a chain of them first.
    while t.changed && !t.kept
        t.changed = false

        walk_block_stmts(f.body, TWalk(false, x -> own_expr(t, x), w -> own_write(t, w.place, w.value),
                                       s -> own_stmt(t, s)))

    if f.body.result.is_some() && carries_count(t, f.body.result.unwrap()) then t.kept = true

    if !t.kept then return false

    // Kept somewhere: now every way out has to have kept it, or the parameter stays borrowed.
    keep_exit(t, keep_block(t, f.body, keep_live(false), true))

    !t.lost
end keeps_counted

private own_stmt(t: &OwnTrack, s: TStmt) = s match
    TVarDecl(name, _, init, _) -> if carries_count(t, init) then t.hold(name)
    TReturn(v) -> if v.is_some() && carries_count(t, v.unwrap()) then t.kept = true
    _ -> ()

private own_expr(t: &OwnTrack, x: TExpr) = *x.kind match
    TStore(place, v, _, _) -> own_write(t, place, v)
    _ -> if keeps_at(t, x) then t.kept = true

// Whether the node itself keeps what is tracked -- hands it to an owned parameter, a slot, a box or a
// buffer literal. A store is `own_write`'s, since a store into a local only binds it.
private keeps_at(t: &OwnTrack, x: TExpr) -> bool = *x.kind match
    TCall(name, args, _, _) ->
        for k in 0..<args.len()
            if t.owned.has(owned_key(name, k)) && carries_count(t, args.at(k)) then return true

        false
    TSlots(op, args, _, _) ->
        op == "slot_place" && args.len() == 3 && carries_count(t, args.at(2)) ||
            op == "slot_put" && args.len() == 2 && carries_count(t, args.at(1))
    TBox(v, _) -> carries_count(t, v)
    TBufLit(elems, _) -> any_carries_count(t, elems)
    _ -> false

// Whether a write keeps what is tracked: it is written somewhere other than a local's own storage.
private write_keeps(t: &OwnTrack, place: TExpr, v: TExpr) -> bool =
    carries_count(t, v) && own_root(t, place).is_none()

// A write of what is tracked: into a local's own storage it binds the local; anywhere else it is kept.
private own_write(t: &OwnTrack, place: TExpr, v: TExpr)
    if !carries_count(t, v) then return

    own_root(t, place) match
        Some(n) -> t.hold(n)
        None -> t.kept = true
end own_write

// The local a place is inside of by value, where it is one.
private own_root(t: &OwnTrack, place: TExpr) -> Option[string] = *place.kind match
    TLoad(n, _) -> if t.refs.has(n) then None else Some(n)
    TField(r, _, _) -> underlying(texpr_type(r)) match
        Struct(_) -> own_root(t, r)
        _ -> None
    TIndex(r, _, _) -> underlying(texpr_type(r)) match
        Array(_, _) -> own_root(t, r)
        _ -> None
    _ -> None

// Whether a value is what is tracked, whole, or built around it -- which is what a destination can take
// over at its last use. A part of it (a field, an element) is not: taking a part out of a value the
// frame still owns would be a partial move.
private carries_count(t: &OwnTrack, x: TExpr) -> bool = *x.kind match
    TLoad(n, _) -> t.held.has(n)
    TStructNew(_, args) -> any_carries_count(t, args)
    TEnumNew(_, _, args) -> any_carries_count(t, args)
    TArrayLit(elems, _) -> any_carries_count(t, elems)
    TErase(o, _, _) -> carries_count(t, o)
    TCast(o, _) -> carries_count(t, o)
    TViewAs(o, _) -> carries_count(t, o)
    TBlockExpr(b) -> block_carries_count(t, b)
    TIf(_, tb, eb, _) -> block_carries_count(t, tb) || eb.is_some() && block_carries_count(t, eb.unwrap())
    TMatch(_, arms, _) ->
        for arm in arms
            if block_carries_count(t, arm.body) then return true

        false
    _ -> false

private any_carries_count(t: &OwnTrack, xs: Buf[TExpr]) -> bool
    for item in xs
        if carries_count(t, item) then return true

    false
end any_carries_count

private block_carries_count(t: &OwnTrack, b: TBlock) -> bool = b.result.is_some() && carries_count(t, b.result.unwrap())

// -- every way out ---------------------------------------------------------------------------------
//
// **A parameter is owned only where every way out of the body has kept it.** One kept on some paths
// only -- a cache's miss, the arm of a `match` that inserts -- stays borrowed, and the path that keeps
// it takes a count where it stores it. Owning it would charge every call the count's round trip (taken
// by the caller, given back by the callee) to save one retain on the path that keeps, and the paths
// that keep nothing are, as often as not, the ones that run: an interning table's hits, a set's
// duplicates. Borrowed, those cost nothing at all.
//
// The walk runs in the order the body does, carrying whether every path to the point has kept the
// parameter. The ways out are a `return`, a `?` that fails, and the end of the body. A branch counts
// where every arm keeps; a loop where every `break` has kept and, unless only a `break` ends it, where
// the state it started in had, since its body may run no times. A path that cannot go on -- a trap,
// a `break`, a `continue`, a `return` -- joins as keeping everything.

// What holds at one point: whether it is reached at all, and whether every path to it has kept.
private struct KeepFlow
    dead: bool
    kept: bool

private keep_live(kept: bool) -> KeepFlow = KeepFlow(false, kept)

private keep_dead() -> KeepFlow = KeepFlow(true, true)

private keep_join(a: KeepFlow, b: KeepFlow) -> KeepFlow
    if a.dead then return b
    if b.dead then return a

    KeepFlow(false, a.kept && b.kept)
end keep_join

private keep_mark(f: KeepFlow, keeps: bool) -> KeepFlow = if keeps && !f.dead then keep_live(true) else f

// A way out of the body: where it is reached without the parameter kept, the parameter is lost.
private keep_exit(t: &OwnTrack, f: KeepFlow) = if !f.dead && !f.kept then t.lost = true

// A block, and with `answer` its value is what the function hands back -- which keeps the parameter
// on the paths whose value carries it.
private keep_block(t: &OwnTrack, b: TBlock, f: KeepFlow, answer: bool) -> KeepFlow
    val g = keep_stmts(t, b.stmts, f)

    if b.result.is_none() then return g
    if answer then return keep_result(t, b.result.unwrap(), g)

    keep_expr(t, b.result.unwrap(), g)
end keep_block

// A value handed back to the caller. Only the arms of an `if` or a `match` that answer with the
// parameter keep it, so the question is put to each arm's value rather than to the whole.
private keep_result(t: &OwnTrack, x: TExpr, f: KeepFlow) -> KeepFlow = *x.kind match
    TIf(cond, then_block, else_block, _) -> keep_if(t, cond, then_block, else_block, f, true)
    TMatch(scrutinee, arms, _) -> keep_match(t, scrutinee, arms, f, true)
    TBlockExpr(b) -> keep_block(t, b, f, true)
    _ -> keep_mark(keep_expr(t, x, f), carries_count(t, x))

// The branch not taken is left from wherever the condition failed, which is after any of its terms.
private keep_if(t: &OwnTrack, cond: Buf[TCondTerm], then_block: TBlock, else_block: Option[TBlock],
                f: KeepFlow, answer: bool) -> KeepFlow
    var g = f
    var failed = keep_dead()

    for term in cond
        g = keep_term(t, term, g)
        failed = keep_join(failed, g)

    keep_join(keep_block(t, then_block, g, answer),
              if else_block.is_some() then keep_block(t, else_block.unwrap(), failed, answer) else failed)
end keep_if

private keep_match(t: &OwnTrack, scrutinee: TExpr, arms: Buf[TArm], f: KeepFlow, answer: bool) -> KeepFlow
    var into = keep_expr(t, scrutinee, f)
    var joined = keep_dead()

    for arm in arms
        var a = into

        if arm.guard.is_some()
            a = keep_expr(t, arm.guard.unwrap(), a)
            into = keep_join(into, a)
        end if

        joined = keep_join(joined, keep_block(t, arm.body, a, answer))

    joined
end keep_match

private keep_stmts(t: &OwnTrack, stmts: Buf[TStmt], f: KeepFlow) -> KeepFlow
    var g = f

    for s in stmts
        g = keep_stmt(t, s, g)

    g
end keep_stmts

private keep_stmt(t: &OwnTrack, s: TStmt, f: KeepFlow) -> KeepFlow = s match
    TVarDecl(_, _, init, _) -> keep_expr(t, init, f)
    TExprStmt(x) -> keep_expr(t, x, f)
    TRefDecl(_, _, place) -> keep_expr(t, place, f)
    TWriteStmt(w) -> keep_mark(keep_expr(t, w.value, keep_expr(t, w.place, f)), write_keeps(t, w.place, w.value))
    TMultiAssign(writes) ->
        var g = f

        for w in writes
            g = keep_expr(t, w.value, keep_expr(t, w.place, g))

        for w in writes
            g = keep_mark(g, write_keeps(t, w.place, w.value))

        g
    TReturn(value) ->
        keep_exit(t, if value.is_some() then keep_result(t, value.unwrap(), f) else f)
        keep_dead()
    TBecome(call) ->
        keep_exit(t, keep_expr(t, call, f))
        keep_dead()
    TBreak(value, depth) ->
        val g = if value.is_some() then keep_expr(t, value.unwrap(), f) else f

        if depth >= 0 && usize(depth) < t.loops.len()
            val frame = t.loops.at(t.loops.len() - 1 - usize(depth))

            frame.breaks = keep_join(frame.breaks, g)
        end if

        keep_dead()
    TContinue(_) -> keep_dead()
    _ -> f

private keep_expr(t: &OwnTrack, x: TExpr, f: KeepFlow) -> KeepFlow
    val out = *x.kind match
        TStore(place, v, _, _) -> keep_mark(keep_expr(t, v, keep_expr(t, place, f)), write_keeps(t, place, v))
        TRecheck(after, _, _, _) -> keep_expr(t, after, f)
        TLogical(_, left, right) ->
            val l = keep_expr(t, left, f)

            keep_join(l, keep_expr(t, right, l))
        TIf(cond, then_block, else_block, _) -> keep_if(t, cond, then_block, else_block, f, false)
        TMatch(scrutinee, arms, _) -> keep_match(t, scrutinee, arms, f, false)
        TBlockExpr(b) -> keep_block(t, b, f, false)
        TTry(operand, _, _, _, _, _, _) ->
            val g = keep_expr(t, operand, f)

            keep_exit(t, g)
            g
        TWhile(_, _, _, _) -> keep_loop(t, x, f)
        TDoWhile(_, _, _, _) -> keep_loop(t, x, f)
        TLoop(_, _) -> keep_loop(t, x, f)
        TFor(_, _, _, _, _, _, _, _) -> keep_loop(t, x, f)
        TCFor(_, _, _, _, _, _) -> keep_loop(t, x, f)
        TForEach(_, _, _, _, _, _) -> keep_loop(t, x, f)
        TIterate(_, _, _, _, _, _, _, _) -> keep_loop(t, x, f)
        TCheckedLoop(_, _, loop_expr) -> keep_expr(t, loop_expr, f)
        TQuantifier(_, _, _, _, _, _, _) -> f
        _ ->
            var g = f

            for item in texpr_children(x)
                g = keep_expr(t, item, g)

            g

    if texpr_type(x) == Never then return keep_dead()

    keep_mark(out, keeps_at(t, x))
end keep_expr

private keep_term(t: &OwnTrack, term: TCondTerm, f: KeepFlow) -> KeepFlow = term match
    TCondTest(c) -> keep_expr(t, c, f)
    TCondIs(subject, _, _) -> keep_expr(t, subject, f)

// One loop being walked: what its `break`s have brought out of it.
private struct KeepLoop
    breaks: KeepFlow

// A loop: its ways out are looked for from the state it starts in, which is a lower bound on every
// turn's, since a path only ever gains a keep. What comes after it is every `break`'s state joined with
// the way it ends on its own -- which is from the state it started in, through its `else` where it has
// one, since the body may not have run at all. A `loop` ends only by its `break`s.
private keep_loop(t: &OwnTrack, x: TExpr, f: KeepFlow) -> KeepFlow
    val head = *x.kind match
        TFor(_, _, lo, hi, _, _, _, _) -> keep_expr(t, hi, keep_expr(t, lo, f))
        TCFor(init, _, _, _, _, _) -> keep_stmts(t, init, f)
        TForEach(_, _, seq, _, _, _) -> keep_expr(t, seq, f)
        TIterate(_, _, init, _, _, _, _, _) -> keep_expr(t, init, f)
        _ -> f
    val frame: &KeepLoop = KeepLoop(keep_dead())

    t.loops.push(frame)

    *x.kind match
        TWhile(cond, body, _, _) ->
            var g = head

            for term in cond
                g = keep_term(t, term, g)

            keep_stmts(t, body, g)
        TDoWhile(body, cond, _, _) -> keep_expr(t, cond, keep_stmts(t, body, head))
        TLoop(body, _) -> keep_stmts(t, body, head)
        TFor(_, _, _, _, _, body, _, _) -> keep_stmts(t, body, head)
        TCFor(_, cond, step, body, _, _) ->
            if cond.is_some() then keep_expr(t, cond.unwrap(), head)

            keep_stmts(t, step, keep_stmts(t, body, head))
        TForEach(_, _, _, body, _, _) -> keep_stmts(t, body, head)
        TIterate(_, _, _, next, _, body, _, _) -> keep_stmts(t, body, keep_expr(t, next, head))
        _ -> head

    t.loops.pop()

    val else_block = *x.kind match
        TWhile(_, _, else_block, _) -> else_block
        TDoWhile(_, _, else_block, _) -> else_block
        TFor(_, _, _, _, _, _, else_block, _) -> else_block
        TCFor(_, _, _, _, else_block, _) -> else_block
        TForEach(_, _, _, _, else_block, _) -> else_block
        TIterate(_, _, _, _, _, _, else_block, _) -> else_block
        _ -> None
    val ended = *x.kind match
        TLoop(_, _) -> keep_dead()
        _ -> if else_block.is_some() then keep_block(t, else_block.unwrap(), head, false) else head

    keep_join(frame.breaks, ended)
end keep_loop

// -- emitting the convention ----------------------------------------------------------------------

// The symbol an owning function's body is defined under; its own symbol is the borrowing entry.
owned_symbol(symbol: string) -> string = s"$symbol.owned"

// The caller's half, once every argument is in hand: each owned one handed over with a count, which is
// the one this frame holds where the argument is a temporary or a local at its last use, and one taken
// for the callee otherwise. Answers the symbol the call names.
//
// It runs after the last argument is worked out, so a later argument that leaves early -- a `?` --
// finds every count still where the frame gives it back.
hand_over_args(e: *Emit, name: string, args: Buf[TExpr], staged: Buf[(int, Val)]) -> string
    if !e.split_funcs.has(name) then return symbol_of(e, name)

    for k in 0..<args.len()
        if e.owned_params.has(owned_key(name, k)) && k < staged.len()
            val a = args.at(k)

            retain_moving(e, a, texpr_type(a), staged.at(k).1, false)

    owned_symbol(symbol_of(e, name))
end hand_over_args

// An owning function's borrowing entry not yet emitted: the function, the signature its definition
// was built with, and whether the module carries only an `available_externally` copy of it.
struct PendingEntry
    f: TFunc
    sig: IrFuncSig
    copy: bool
end PendingEntry

// A defined body as the functions it is emitted as: itself where it owns nothing, and otherwise the body
// under `owned_symbol` beside the entry every other caller reaches under the function's own symbol.
//
// **The body keeps the name `<symbol>.owned` whether or not an entry is emitted beside it.** A direct
// call names the body from the analysis alone, and the analysis is the one thing a library and its
// user agree on; whether an entry exists turns on what the whole module names, which a separately
// compiled caller cannot know.
//
// **In a program the entry is only a candidate** (`lazy`): it is filed in `pending` and emitted by
// `settle_entries` only where something in the finished module names the function's own symbol -- a
// function value, a closure's thunk, a table slot, a hook the compiler calls, storage holding its
// address. Only direct calls reach most owning functions, and those name the body. **An artifact
// keeps every entry**, since the program that links it may take the address of any of its functions.
//
// **A function lent a parameter by address (`borrowing.sysl`'s `read_by_address`) is split the same
// way**, for the same reason: its body's signature takes the address, and the entry is built with the
// ordinary one, taking the value and lending the body a slot of its own.
owned_split(e: *Emit, f: TFunc, built: IrFunc, lazy: bool, copy: bool, pending: Buf[PendingEntry]) -> Buf[IrFunc]
    var out: Buf[IrFunc] = buf()

    if !e.split_funcs.has(f.name)
        out.push(built)
        return out
    end if

    val body = built with { sig = built.sig with { name = owned_symbol(built.sig.name) } }
    val entry_sig = built.sig with { ty = entry_type(e, f, built.sig.ty) }

    if lazy then pending.push(PendingEntry(f, entry_sig, copy)) else out.push(owned_entry(e, f, entry_sig))

    out.push(body)
    out
end owned_split

// The pending entries something in the module names, in the order they were filed, each taken out of
// `pending`.
named_entries(pending: Buf[PendingEntry], funcs: Buf[IrFunc], helpers: Buf[IrRuntime], globals: Buf[IrGlobal],
              asm_lines: Buf[string]) -> Buf[PendingEntry]
    var out: Buf[PendingEntry] = buf()

    if pending.is_empty() then return out

    var wanted: Set[string] = set()
    var names: Buf[string] = buf()

    for item in pending
        wanted.add(item.sig.name)
        names.push(item.sig.name)

    var hits: Set[string] = set()

    for f in funcs
        func_names(f, wanted, names, &hits)

    for h in helpers
        h match
            RtEmitted(f) -> func_names(f, wanted, names, &hits)
            RtTemplate(_, llvm) -> text_names(llvm, names, &hits)

    for g in globals
        if g.value.is_some() then val_names(g.value.unwrap(), wanted, &hits)

    for line in asm_lines
        text_names(line, names, &hits)

    var kept: Buf[PendingEntry] = buf()

    for item in pending
        if hits.has(item.sig.name) then out.push(item) else kept.push(item)

    pending.clear()

    for item in kept
        pending.push(item)

    out
end named_entries

// The entry a pending one is emitted as.
pending_entry(e: *Emit, item: PendingEntry) -> IrFunc = owned_entry(e, item.f, item.sig)

private func_names(f: IrFunc, wanted: Set[string], names: Buf[string], hits: *Set[string])
    for b in f.blocks
        for i in b.instrs
            inst_names(i, wanted, names, hits)

        if b.terminator.is_some() then inst_names(b.terminator.unwrap(), wanted, names, hits)
end func_names

private inst_names(i: Inst, wanted: Set[string], names: Buf[string], hits: *Set[string]) = i match
    InBin(_, _, _, a, b) ->
        val_names(a, wanted, hits)
        val_names(b, wanted, hits)
    InNeg(_, _, v) -> val_names(v, wanted, hits)
    InIntCmp(_, _, _, a, b) ->
        val_names(a, wanted, hits)
        val_names(b, wanted, hits)
    InFloatCmp(_, _, _, a, b) ->
        val_names(a, wanted, hits)
        val_names(b, wanted, hits)
    InCast(_, _, _, v, _) -> val_names(v, wanted, hits)
    InLoad(_, _, ptr, _, _) -> val_names(ptr, wanted, hits)
    InStore(_, v, ptr, _, _) ->
        val_names(v, wanted, hits)
        val_names(ptr, wanted, hits)
    InGep(_, _, ptr, idx) ->
        val_names(ptr, wanted, hits)
        arg_names(idx, wanted, hits)
    InExtract(_, _, agg, _) -> val_names(agg, wanted, hits)
    InInsert(_, _, agg, _, v, _) ->
        val_names(agg, wanted, hits)
        val_names(v, wanted, hits)
    InSelect(_, c, _, a, b, _) ->
        val_names(c, wanted, hits)
        val_names(a, wanted, hits)
        val_names(b, wanted, hits)
    InInsertElement(_, _, vec, _, v, idx) ->
        val_names(vec, wanted, hits)
        val_names(v, wanted, hits)
        val_names(idx.value, wanted, hits)
    InExtractElement(_, _, vec, idx) ->
        val_names(vec, wanted, hits)
        val_names(idx.value, wanted, hits)
    InShuffle(_, _, a, b, mask) ->
        val_names(a, wanted, hits)
        val_names(b, wanted, hits)
        val_names(mask.value, wanted, hits)
    InAsm(_, _, text, _, args) ->
        text_names(text, names, hits)
        arg_names(args, wanted, hits)
    InCall(_, _, callee, args, _, _, _, _) ->
        val_names(callee, wanted, hits)
        arg_names(args, wanted, hits)
    InVaArg(_, v, _) -> val_names(v, wanted, hits)
    InAtomicRmw(_, _, ptr, _, v, _) ->
        val_names(ptr, wanted, hits)
        val_names(v, wanted, hits)
    InCmpXchg(_, ptr, _, a, b, _) ->
        val_names(ptr, wanted, hits)
        val_names(a, wanted, hits)
        val_names(b, wanted, hits)
    InCondBr(c, _, _) -> val_names(c, wanted, hits)
    InRet(_, v) -> if v.is_some() then val_names(v.unwrap(), wanted, hits)
    InSwitch(_, v, _, _) -> val_names(v, wanted, hits)
    _ -> ()

private arg_names(args: Buf[IrArg], wanted: Set[string], hits: *Set[string])
    for a in args
        val_names(a.value, wanted, hits)
end arg_names

private val_names(v: Val, wanted: Set[string], hits: *Set[string])
    v match
        VGlobal(n) -> if wanted.has(n) then hits.add(n)
        VSplat(_, _, x) -> val_names(*x, wanted, hits)
        VAgg(fs) -> arg_names(fs, wanted, hits)
        VPackedAgg(fs) -> arg_names(fs, wanted, hits)
        VArray(fs) -> arg_names(fs, wanted, hits)
        VVector(fs) -> arg_names(fs, wanted, hits)
        VIntToPtr(_, x) -> val_names(*x, wanted, hits)
        VPtrToInt(_, x) -> val_names(*x, wanted, hits)
        VConstArith(_, _, l, r) ->
            val_names(*l, wanted, hits)
            val_names(*r, wanted, hits)
        VGep(_, b, idx) ->
            val_names(*b, wanted, hits)
            arg_names(idx, wanted, hits)
        _ -> ()
end val_names

// A symbol written in text -- a hand-written runtime block, an `asm` -- is a name, and a name that
// appears at all keeps its entry: an extra entry costs a few bytes, a missing one a link error.
private text_names(text: string, names: Buf[string], hits: *Set[string])
    for n in names
        if !hits.has(n) && text.contains(n) then hits.add(n)
end text_names

// The ordinary convention's function type for a split function's entry, made from its body's: each
// parameter the body is lent by address taken back as the value its type crosses as, with none of the
// attributes the body's address carries.
private entry_type(e: *Emit, f: TFunc, body: IrFnType) -> IrFnType
    var by_name: Map[string, Type] = map()

    for j in 0..<f.params.len()
        if e.lent_params.has(owned_key(f.name, j)) then by_name.put(s"${f.params.at(j).0}.param", f.params.at(j).1)

    if by_name.is_empty() then return body

    var params: Buf[IrParam] = buf()

    for p in body.params
        val ty = p.name match
            Some(VReg(n)) -> by_name.get(n)
            _ -> None

        if ty.is_some() then params.push(IrParam(lty(e, ty.unwrap()), no_ir_attrs(), p.name))
        else params.push(p)

    body with { params = params }
end entry_type

// The entry a borrowing caller reaches: a count taken for each owned parameter, then the owned body
// called with everything exactly as it arrived, but for a parameter the body is lent, which it lends.
private owned_entry(e: *Emit, f: TFunc, sig: IrFuncSig) -> IrFunc
    start_function(e)
    push_temps(e)
    push_owned(e)

    // A parameter the body is lent by address arrives here as a value, and is put in a slot of the
    // entry's own -- storage nothing else can name, which is all the body's reading in place needs.
    var lent: Map[string, Val] = map()

    for j in 0..<f.params.len()
        val p = f.params.at(j)

        if e.owned_params.has(owned_key(f.name, j)) then retain_value(e, p.1, VReg(s"${p.0}.param"))

        if e.lent_params.has(owned_key(f.name, j))
            val slot = alloca(e, VReg(s"${p.0}.lent"), lty(e, p.1))

            emit(e, InStore(lty(e, p.1), VReg(s"${p.0}.param"), slot, AccPlain, None))
            lent.put(s"${p.0}.param", slot)
        end if

    var args: Buf[IrArg] = buf()

    for p in sig.ty.params
        val slot = p.name match
            Some(VReg(n)) -> lent.get(n)
            _ -> None

        if slot.is_some() then args.push(ir_arg(LPtr, slot.unwrap()))
        else args.push(IrArg(p.ty, p.name.unwrap_or(VUndef), p.attrs))

    val callee = VGlobal(owned_symbol(sig.name))
    val nothing = sig.ty.ret match
        LVoid -> true
        _ -> false

    if nothing
        emit(e, InCall(None, LVoid, callee, args, sig.ty.ret_attrs, None, no_fast_math(), false))
        emit_term(e, InRet(None, None))
    else
        val r = fresh_reg(e)

        emit(e, InCall(Some(r), sig.ty.ret, callee, args, sig.ty.ret_attrs, None, no_fast_math(), false))
        emit_term(e, InRet(Some(sig.ty.ret), Some(r)))
    end if

    var bare: Buf[string] = buf()

    finish_func(e, sig with { bare = bare })
end owned_entry
