module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.process.capture
import sysl.fs.{make_temp_dir, remove_dir_all, write_text}
import sysl.text.{replace_all, Search}

// **`llvm.coro.end` answers `i1` before LLVM 22 and nothing from it**, and neither spelling is
// accepted by the other: an older clang says "Intrinsic has incorrect return type", a newer one
// "intrinsic return type expected void, but got i1". Apple's clang and Homebrew's are a version
// apart on one machine, so the text is emitted in the newer spelling (`emit_async.sysl`) and turned
// into the older one on its way into a clang that wants it -- which is asked of the clang itself,
// once per path, by handing it the newer spelling.

private var coro_end_answers: Buf[(string, bool)] = buf()

// The text a clang is handed, in the coroutine dialect that clang reads. It is applied after
// `toolchain.sysl`'s `for_clang`, which marks the definitions for the target.
in_coro_dialect(cc: string, ir: string) -> string
    if !ir.contains("@llvm.coro.end(") || coro_end_is_void(cc) then return ir

    coro_end_as_i1(ir)
end in_coro_dialect

// The text with `llvm.coro.end`'s calls and declaration answering `i1`, and every other byte as it was.
//
// **Only a line BEGINNING with the instruction or the declaration changes**, and that is what keeps a
// string constant out of reach: a constant is a `c"..."` on a global's line, which begins with `@`,
// and no quoted string in the module holds a raw newline -- a constant writes one as `\0A`, as an
// `asm` template does between its lines -- so the text of an instruction inside a literal is never at
// the start of a line, however the literal spells it. A literal's value is its bytes, and a program
// printing `"call void @llvm.coro.end("` prints exactly that through either dialect.
coro_end_as_i1(ir: string) -> string
    val call = "  call void @llvm.coro.end("
    val decl = "declare void @llvm.coro.end("
    val body = replace_all(replace_all(ir, "\n" + call, "\n  call i1 @llvm.coro.end("),
                           "\n" + decl, "\ndeclare i1 @llvm.coro.end(")

    // A codegen unit is a cut of the module, so its first line may be the declaration.
    if body.starts_with(decl) then "declare i1 @llvm.coro.end(" + body[decl.bytes.len..<body.bytes.len]
    else body
end coro_end_as_i1

// Whether this clang reads `llvm.coro.end` as answering nothing.
coro_end_is_void(cc: string) -> bool
    for i in 0..<coro_end_answers.len()
        if coro_end_answers.at(i).0 == cc then return coro_end_answers.at(i).1

    val answer = probe_coro_end(cc)

    coro_end_answers.push((cc, answer))
    answer
end coro_end_is_void

private probe_coro_end(cc: string) -> bool
    val dir = make_temp_dir("sysl-coro") match
        Ok(d) -> d
        Err(_) -> return true

    val ll = s"$dir/probe.ll"
    val probe = "define void @probe(ptr %h) {\n" +
                "entry:\n" +
                "  call void @llvm.coro.end(ptr %h, i1 false, token none)\n" +
                "  ret void\n" +
                "}\n" +
                "\n" +
                "declare void @llvm.coro.end(ptr, i1, token)\n"

    var answer = true

    if write_text(ll, probe).is_ok()
        answer = capture(cc, ["-c", "-x", "ir", ll, "-o", s"$dir/probe.o"], "", [], true) match
            Ok(out) -> out.status.ok()
            Err(_) -> true

    remove_dir_all(dir).unwrap_or(())
    answer
end probe_coro_end
