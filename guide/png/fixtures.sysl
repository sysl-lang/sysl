// The files this program reads.
//
// A guide program has no way to open one — the outside world is another problem's axis — so every
// image here is the real bytes of a real PNG, written out in hex and unpacked into a buffer at the
// start of each check. They were produced by a different encoder than the one that reads them,
// which is the only reason any of this proves anything: a decoder tested against its own encoder
// tests that two mistakes agree.
//
// Hex rather than a list of numbers is a decision the language made. A string literal cannot span
// lines and there is no line continuation, so a 128-byte array literal is one very long line or a
// hundred short ones; a string built up with `+=` is neither, and reads as what it is — a file.

private nibble(c: u8) -> u8 = if c >= 97u8 then c - 87u8 else c - 48u8

// Unpack a hex string into bytes, answering how many there were. The one direction that works:
// bytes cannot be turned into a string, but a string's bytes can always be read.
// Two counters advancing at different rates — the source by two characters and the output by one
// byte — which is what the three-clause `for` is for.
unhex(s: string, out: []u8) -> usize
    var n = 0usize

    for var i = 0usize; i + 1 < s.len; i += 2usize
        out[n] = nibble(s[i]) << 4u8 | nibble(s[i + 1])
        n += 1usize

    n
end unhex

// A 2x2 truecolour image: red, green on the first row, blue, yellow on the second.
rgb() -> string
    var s = "89504e470d0a1a0a0000000d4948445200000002000000020802000000fdd49a"

    s += "730000001449444154789c63f8cfc0c000c20cffffff6700001eef04fca3c8b4"
    s += "f70000000049454e44ae426082"
    s
end rgb

// 4x4 greyscale, every pixel a multiple of 17 in reading order.
gray() -> string
    var s = "89504e470d0a1a0a0000000d49484452000000040000000408000000008c9ac1"

    s += "a20000001d49444154789c63601054326670094d2b67e898b96a37c399bbeffe"
    s += "030033e007f9c0f536f00000000049454e44ae426082"
    s
end gray

// 4x4 through a four-entry palette, the index cycling along each diagonal.
paletted() -> string
    var s = "89504e470d0a1a0a0000000d49484452000000040000000408030000009e2f6e"

    s += "4c0000000c504c5445000000ff000000ff000000ff9bc013dc00000014494441"
    s += "54789c636060646206630610cd0062030001040019427b918c0000000049454e"
    s += "44ae426082"
    s
end paletted

// 2x2 with an alpha channel, transparent through to opaque.
rgba() -> string
    var s = "89504e470d0a1a0a0000000d494844520000000200000002080600000072b60d"

    s += "240000001549444154789c63f8cf0004ff194241e4aaff400000338907f91e86"
    s += "b0160000000049454e44ae426082"
    s
end rgba

// 2x2 greyscale with an alpha channel.
grayalpha() -> string
    var s = "89504e470d0a1a0a0000000d4948445200000002000000020804000000d8bfc5"

    s += "af0000001249444154789c6360f81fba8a6155e87f060013f603fd3a2f75c600"
    s += "00000049454e44ae426082"
    s
end grayalpha

// 8x8 greyscale, black and white in a checkerboard — small enough to print.
checker() -> string
    var s = "89504e470d0a1a0a0000000d4948445200000008000000080800000000e164e1"

    s += "570000001349444154789c63f8cf00810c0cffd1204922007c041fe1a91bcce4"
    s += "0000000049454e44ae426082"
    s
end checker

// 4x5 truecolour, encoded with a different filter on every row: none, sub, up, average, Paeth.
filtered() -> string
    var s = "89504e470d0a1a0a0000000d4948445200000004000000050802000000edcfda"

    s += "8c0000002a49444154789c636060e763e61264e315e1141067e4119662860126"
    s += "1e24c02c2123cf01032c200118000050f3025397509ded0000000049454e44ae"
    s += "426082"
    s
end filtered

// The same 2x2 image, its compressed data cut across three IDAT chunks.
split() -> string
    var s = "89504e470d0a1a0a0000000d4948445200000002000000020802000000fdd49a"

    s += "730000000749444154789c63f8cfc0c0ab586406000000074944415400c20cff"
    s += "ffff67f0e9b20f000000064944415400001eef04fcf2e9d5c20000000049454e"
    s += "44ae426082"
    s
end split

// The same 2x2 image again, with a gAMA chunk before the pixels and a tEXt chunk after them.
extra() -> string
    var s = "89504e470d0a1a0a0000000d4948445200000002000000020802000000fdd49a"

    s += "730000000467414d410000b18f0bfc61050000001449444154789c63f8cfc0c0"
    s += "00c20cffffff6700001eef04fca3c8b4f70000001774455874436f6d6d656e74"
    s += "00612067756964652070726f626c656d9fc13a160000000049454e44ae426082"
    s
end extra

// 8x1 greyscale whose pixel data was deflated with compression turned off, so its one block is
// stored rather than coded.
stored() -> string
    var s = "89504e470d0a1a0a0000000d4948445200000008000000010800000000c66bb0"

    s += "9f00000014494441547801010900f6ff000010203040506070054901c17496a2"
    s += "480000000049454e44ae426082"
    s
end stored

// The 2x2 image again, its first row claiming a filter the format does not have.
badfilter() -> string
    var s = "89504e470d0a1a0a0000000d4948445200000002000000020802000000fdd49a"

    s += "730000001449444154789c63fdcfc0c000c20cffffff6700001f350501b5d330"
    s += "180000000049454e44ae426082"
    s
end badfilter

// Bare zlib streams, one for each kind of deflate block.

// A stored block: "hello, world" verbatim.
zstored() -> string = "7801010c00f3ff68656c6c6f2c20776f726c641d540489"

// A fixed-code block: "abracadabra abracadabra", short enough that a table of its own would cost
// more than it saved.
zfixed() -> string = "78da4b4c2a4a4c4e4c4904520a89083600695508c9"

// A dynamic-code block: the squares of 0 through 59, separated by spaces. Digits and spaces only,
// so the distribution is skewed enough that carrying a table pays for itself.
zdyn() -> string
    var s = "78da158ec101c0300802576104516b74ffc50a2f1205bc00d13870901f6ad087"

    s += "692cc10830a5dddaca71b2c8939f740f952dbfd2f2754bb7f1e5e17b83916fa4"
    s += "4fffa7f96a7ff2ddb85741861a4855d19d4c95b37ca57deef3dd31c098e48988"
    s += "db661061862968e28c435634b283225322c7afe7d97a7bf29513a57e438bbcd4"
    s += "57bdfc01ea2d2e92"
    s
end zdyn

// Three hundred copies of one byte, which the encoder wrote as a single back-reference of
// distance one.
zrun() -> string = "78daabaa1a05c4020012e48ef9"

// A bare deflate block — no zlib wrapper — holding one literal byte and then a match five bytes
// back, which is four bytes before the stream began. Written by hand: no encoder emits this.
faraway() -> string = "4b041200"

// A match whose distance is spelled with the one five-bit pattern the fixed distance table leaves
// undefined, there being thirty distances and room for thirty-two. The two bytes on the end are
// there so that the decoder runs out of *table* before it runs out of *stream*: a code that stands
// for nothing is indistinguishable from a code still being read until fifteen bits have gone by.
nosuchcode() -> string = "4b047effff"

// A length symbol two past the last one the format defines.
toolong() -> string = "1b03"

// A block that says it carries 288 literal codes, two more than there are.
toomany() -> string = "fd0000"
