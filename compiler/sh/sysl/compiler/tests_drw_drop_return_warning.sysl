module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.text.Search
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}

// The refusal of a declaration handing back a type with a `Drop` by value, said where somebody can
// see it: on the command line (`reference/memory.md § A type with a destructor is a reference
// type`). `run`, `build` and `emit-llvm` print it on standard error, at the declaration, and fail.

// What one command line came to: the status, each line said on the output channel, each note, and
// the file the program was written to. The directory is removed. `None` without the library.
private drw_run(command: string, text: string) -> Option[(int, Buf[string], Buf[string], string)]
    if xvr_no_library() then return None

    val root = make_temp_dir("sysl-drw").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", text).unwrap()

    var lines: Buf[string] = buf()
    val sink = &lines
    var notes: Buf[string] = buf()
    val noted = &notes
    val file = s"$root/main.sysl"
    var args: Buf[string] = buf()

    args.push("sysl")
    args.push(command)

    // A build's executable goes inside the directory that is removed, never beside the suite.
    if command == "build"
        args.push("-o")
        args.push(s"$root/main")
    end if

    args.push(file)

    val code = run_cli_noted(args.view(), (line) -> sink.push(line), (line) -> noted.push(line))

    remove_dir_all(root).unwrap_or(())
    Some((code, lines, notes, file))
end drw_run

// The page's own example, with a statement for the program to run.
private drw_encoder() -> string =
    "struct Encoder\n    state: *u8\n\nimpl Drop for Encoder\n    drop(self) = print(\"closing\")\n\n"

private drw_bad() -> string = "open_bad() -> Encoder = Encoder(null)"

private drw_good() -> string = "open_good() -> Result[&Encoder, string] = Ok(Encoder(null))"

private drw_carets(n: usize) -> string
    var out = ""

    for i in 0..<n
        out = out + "^"

    out
end drw_carets

// The whole report for `open_bad` on line 7 of `file`.
private drw_open_bad_report(file: string) -> string =
    "error: 'open_bad' hands back 'Encoder' by value and 'Encoder' has a 'Drop' — a type with a " +
    "destructor is a reference type, and building one makes a '&Encoder'. Write '&Encoder' in its " +
    "place\n" + s" --> $file:7:1\n  |\n7 | ${drw_bad()}\n  | ${drw_carets(drw_bad().bytes.len)}"

// Every note joined, since a report may be said in more than one piece.
private drw_said(notes: Buf[string]) -> string
    var out = ""

    for item in notes
        out = out + item + "\n"

    out
end drw_said

@test("emit-llvm refuses the program, saying the page's refusal at the declaration")
drw_emit_llvm_says_the_refusal()
    drw_run("emit-llvm", drw_encoder() + drw_bad() + "\n" + drw_good() + "\nprint(1)\n") match
        None -> ()
        Some((code, _, notes, file)) ->
            assert(code != Fine, "the program is refused")

            val said = drw_said(notes)

            assert(said.contains(drw_open_bad_report(file)), said)
            assert_eq(said.count_of("error: "), usize(1), said)
end drw_emit_llvm_says_the_refusal

@test("a build refuses it and says the same")
drw_build_says_the_refusal()
    drw_run("build", drw_encoder() + drw_bad() + "\n" + drw_good() + "\nprint(1)\n") match
        None -> ()
        Some((code, _, notes, file)) ->
            assert(code != Fine, "the program is refused")
            assert(drw_said(notes).contains(drw_open_bad_report(file)), drw_said(notes))
end drw_build_says_the_refusal

@test("a constructor handing back the box says nothing")
drw_a_boxed_return_says_nothing()
    drw_run("emit-llvm", drw_encoder() + "\n" + drw_good() + "\nprint(1)\n") match
        None -> ()
        Some((code, _, notes, _)) ->
            assert_eq(code, Fine)
            assert_eq(notes.len(), usize(0), s"noted ${notes.len()}")
end drw_a_boxed_return_says_nothing

@test("two refusals are two errors, in source order")
drw_two_refusals_in_source_order()
    val text = raw"""
        struct Thing
            n: int

        impl Drop for Thing
            drop(self) = print("d")

        make(n: int) -> Thing = Thing(n)

        pair(n: int) -> (int, Thing) = (n, Thing(n))

        print(1)
        """

    drw_run("emit-llvm", text) match
        None -> ()
        Some((code, _, notes, _)) ->
            assert(code != Fine, "the program is refused")

            val said = drw_said(notes)
            val first = said.index_of("error: 'make' hands back 'Thing' by value")
            val second = said.index_of("error: 'pair' hands back 'Thing' by value, inside '(int, Thing)'")

            assert(first.is_some() && second.is_some(), said)
            assert(first.unwrap() < second.unwrap(), said)
end drw_two_refusals_in_source_order
