module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.container.{Map, map}

// What may leave a struct through the members that guard one of its fields.
//
// **`@guards(value)` above a struct says its own members are the only way to `value`** -- the field
// is file-private and the struct's members take a lock (or whatever the struct is) before they touch
// it. That is what lets a `Mutex[Map[string, int]]` cross into a `&sync` while the `Map` inside it
// could not: `sharing.sysl`'s walk leaves a guarded field out, so sharing the lock does not share
// what it guards.
//
// **The other half of the bargain is checked here, at each call of such a member.** A value a member
// hands back has left the guard, and the lock is let go by the time the caller holds it, so whatever
// counts it shares with the guarded value are touched from two domains at once -- the same race the
// walk was spared, one call later. So what a call answers is held to the `&sync` rule a capture is:
// an `int`, a `bool`, a `*T`, a `&sync T` pass on their type alone. A value whose type carries a
// count that is not atomic passes only where the body that made it can be read and every way it
// answers is **fresh** -- a string literal (immortal), a `.copy()` of a string (which allocates an
// owner of its own and copies the bytes), a `.copy()` of a `Buf` whose elements hold no count, a call
// handed nothing that shares a count, a local built fresh and let go nowhere else (`answers_fresh`),
// or a branch, a block, a variant or a struct built of those.
//
// **The rule fires only where the guarded field itself reaches such a count**: a `Mutex[int]` hands
// nothing out that could share one.
//
// **What this does not see**: a body that STORES something read out of the guarded value somewhere
// that outlives the call -- a module `var`, a `Buf` reached through a captured pointer -- has let it
// leave too, and no walk here follows a counted value from the field to the store. Module storage
// reached from another domain is still held to `sharing.sysl`'s own rule where it is reached.

// Holds every call of a member that guards a field to letting nothing shared leave through it.
check_guarded_results(a: &Analysis, funcs: Buf[TFunc])
    var index: Map[string, usize] = map()
    var any = false

    for i in 0..<funcs.len()
        if !index.has(funcs.at(i).name) then index.put(funcs.at(i).name, i)
        if guard_of(funcs.at(i)).is_some() then any = true

    if !any then return

    val an = a

    for f in funcs
        val scope = func_home(a, f.name)
        val own = guard_of(f)

        walk_block_stmts(f.body, expr_walk(false, e -> guarded_call(an, funcs, index, scope, own, e)))
end check_guarded_results

// The guarding struct a member is a member of, where its receiver is one that guards a field.
private guard_of(f: TFunc) -> Option[&StructType]
    if f.params.is_empty() || f.params.at(0).0 != "self" then return None

    guarding(f.params.at(0).1)

private guarding(t: Type) -> Option[&StructType] = t match
    Ptr(inner) -> guarding(*inner)
    Ref(inner, _) -> guarding(*inner)
    Struct(d) -> if d.guarded.is_empty() then None else Some(d)
    _ -> None

private guarded_call(a: &Analysis, funcs: Buf[TFunc], index: Map[string, usize], scope: Scope,
                     own: Option[&StructType], e: TExpr)
    *e.kind match
        TCall(name, args, ty, _) -> guarded_result(a, funcs, index, scope, own, e, name, args, ty)
        _ -> ()

private guarded_result(a: &Analysis, funcs: Buf[TFunc], index: Map[string, usize], scope: Scope,
                       own: Option[&StructType], e: TExpr, name: string, args: Buf[TExpr], ty: Type)
    val at = index.get(name)

    if at.is_none() then return

    val guard = guard_of(funcs.at(at.unwrap()))

    if guard.is_none() then return

    val d = guard.unwrap()

    // A guarding struct's members call one another inside the guard, which is where they may -- and
    // so do the members of a struct whose guarded field IS such a struct (`Mutex[T]` over a
    // `Guarded[SleepLock, T]`), since what they answer is checked again at their own calls.
    if own.is_some() && guards_within(own.unwrap(), d) then return

    val inside = guarded_unshareable(d)

    if inside.is_none() then return

    val leaving = unshareable(ty)

    if leaving.is_none() then return

    val body = answering_body(funcs, index, args)

    if body.is_some() && answers_fresh(body.unwrap()) then return

    val shown = qualified_name(a.tables.members.func_origin.get(name).unwrap_or(name))

    a.fault(scope, e.span, guarded_complaint(shown, inside.unwrap(), leaving.unwrap(), ty))
end guarded_result

// Whether `own` is the guarding struct `d`, or guards a field of type `d`.
private guards_within(own: &StructType, d: &StructType) -> bool
    if own.base == d.base then return true

    for item in own.fields
        if holds_string(own.guarded, item.0)
            val inner = item.1 match
                Struct(s) -> s.base == d.base
                _ -> false

            if inner then return true

    false
end guards_within

// The body that makes what a call answers: the closure or named function handed to it.
private answering_body(funcs: Buf[TFunc], index: Map[string, usize], args: Buf[TExpr]) -> Option[TFunc]
    for arg in args
        val named: Option[string] = texpr_type(arg) match
            Struct(d) -> if is_closure_literal(texpr_type(arg)) then Some(s"${d.base}.call") else None
            _ -> *arg.kind match
                TFuncAddr(n, _, _) -> Some(n)
                _ -> None

        if named.is_some()
            val at = index.get(named.unwrap())

            if at.is_some() then return Some(funcs.at(at.unwrap()))
    end for

    None
end answering_body

// What the freshness walk of one body carries: the locals it built fresh, one entry in `cleared` for
// every mention of one that was seen to be harmless, and whether anything wrote a shared value into
// one.
private struct Fresh
    locals: Buf[string]
    cleared: Buf[string]
    spoiled: bool
end Fresh

// Whether every way a body answers is a value made fresh, sharing no count with anything.
//
// **A local counts as fresh where everything it ever holds was built inside the body, and the body
// lets it go nowhere but out through the answer.** Its initializer and every value written into it
// must be fresh, and every mention of it must be one of the harmless shapes: the answer itself (or a
// part of one being built), a member of the library's `Buf` called on it -- which keeps nothing but
// copies of what it is given -- or a read that comes to a value holding no count and no address
// (`copy.len()`, `copy[0]`, a loop over its elements). Any other mention -- passed to a function,
// captured, bound to a second name, its address taken -- could leave it reachable from something that
// outlives the call, so the whole body is refused rather than followed there. Locals are named
// uniquely within a body (a shadowing one is renamed), so a name is one local.
private answers_fresh(f: TFunc) -> bool
    var st = Fresh(buf(), buf(), false)
    val p = &st

    walk_block_stmts(f.body, stmt_walk(false, s -> fresh_local(p, s)))

    var fresh = fresh_block(p, f.body)
    val sink = &fresh

    walk_block_stmts(f.body, stmt_walk(false, s -> fresh_return(p, sink, s)))

    if !fresh then return false

    var mentions: Buf[string] = buf()
    val seen = &mentions

    walk_block_stmts(f.body, TWalk(false, e -> fresh_use(p, seen, e), w -> fresh_write(p, w.place, w.value),
                                   s -> ()))

    if st.spoiled then return false

    for name in st.locals
        if occurrences(mentions, name) != occurrences(st.cleared, name) then return false

    true
end answers_fresh

private occurrences(names: Buf[string], name: string) -> int
    var n = 0

    for item in names
        if item == name then n += 1

    n
end occurrences

// A local whose type shares a count, and whose initializer is fresh, is one the walk follows.
private fresh_local(st: *Fresh, s: TStmt)
    s match
        TVarDecl(name, ty, init, _) ->
            if unshareable(ty).is_some() && tentative(st, init) then st.locals.push(name)
        _ -> ()

private fresh_return(st: *Fresh, sink: *bool, s: TStmt)
    s match
        TReturn(v) -> if v.is_some() && !fresh_value(st, v.unwrap()) then *sink = false
        _ -> ()

// One node of the body, asked about the fresh locals it mentions.
private fresh_use(st: *Fresh, seen: *Buf[string], e: TExpr)
    *e.kind match
        TLoad(name, _) -> if holds_string(st.locals, name) then seen.push(name)
        TStore(place, value, _, _) -> fresh_write(st, place, value)
        TForEach(_, elem, seq, _, _, _) -> if inert(elem) then clear_chain(st, seq)
        _ -> if inert(texpr_type(e)) then clear_read(st, e)
end fresh_use

// A node that comes to a value holding no count and no address, read straight out of a fresh local
// -- a field, an element, a length, a `Buf` member's answer -- lets nothing of the local go.
private clear_read(st: *Fresh, e: TExpr)
    val inner: Option[TExpr] = *e.kind match
        TField(r, _, _) -> Some(r)
        TIndex(r, _, _) -> Some(r)
        TLen(r, _) -> Some(r)
        TDeref(r, _) -> Some(r)
        TCall(name, args, _, _) ->
            if !args.is_empty() && rooted_fresh(st, args.at(0)) && call_keeps_nothing(st, name, args) then Some(args.at(0))
            else None
        _ -> None

    if inner.is_some() then clear_chain(st, inner.unwrap())
end clear_read

// A write into a place rooted at a fresh local has to write something fresh, or the local now shares
// it. A write of a whole value, or of a part that holds a count, is itself a harmless mention.
private fresh_write(st: *Fresh, place: TExpr, value: TExpr)
    if !rooted_fresh(st, place) then return

    if !fresh_arg(st, value)
        st.spoiled = true
        return

    if !inert(texpr_type(place)) then clear_chain(st, place)
end fresh_write

// Follows a chain of reads down to the fresh local it starts from, through nodes that still hold a
// count or an address, and clears that one mention. A chain that does not start from one is left
// alone before anything in it is asked: what its calls are handed goes into something else.
private clear_chain(st: *Fresh, start: TExpr)
    if !rooted_fresh(st, start) then return

    var at = start

    loop
        if inert(texpr_type(at)) then return

        val next: Option[TExpr] = *at.kind match
            TLoad(name, _) ->
                if holds_string(st.locals, name) then st.cleared.push(name)
                return
            _ -> chain_step(st, at)

        if next.is_none() then return

        at = next.unwrap()
end clear_chain

private rooted_fresh(st: *Fresh, e: TExpr) -> bool
    val root = chain_root(e)

    root.is_some() && holds_string(st.locals, root.unwrap())

// The local a chain of reads or a place starts from, where it is one.
private chain_root(start: TExpr) -> Option[string]
    var at = start

    loop
        val next: Option[TExpr] = *at.kind match
            TLoad(name, _) -> return Some(name)
            TCall(name, args, _, _) -> if is_buf_member(name) && !args.is_empty() then Some(args.at(0)) else None
            _ -> chain_step_shape(at)

        if next.is_none() then return None

        at = next.unwrap()
end chain_root

// One step down a chain of reads, where the node only reads what it is handed.
private chain_step(st: *Fresh, e: TExpr) -> Option[TExpr] = *e.kind match
    TCall(name, args, _, _) ->
        if is_buf_member(name) && !args.is_empty() && call_keeps_nothing(st, name, args) then Some(args.at(0))
        else None
    _ -> chain_step_shape(e)

private chain_step_shape(e: TExpr) -> Option[TExpr] = *e.kind match
    TAddrOf(p, _) -> Some(p)
    TDeref(p, _) -> Some(p)
    TField(r, _, _) -> Some(r)
    TIndex(r, _, _) -> Some(r)
    TLen(r, _) -> Some(r)
    TSlice(base, _, _, _, _) -> Some(base)
    TConstView(arg) -> Some(arg)
    _ -> None

// Whether a call handed a fresh local first can keep nothing of what it is handed: every other
// argument is fresh or holds no count and no address -- or the call is the library `Buf`'s own
// member over elements that hold no count, which copies what it is given and keeps nothing of
// itself anywhere. Every argument is asked either way, so the fresh locals in them are cleared.
private call_keeps_nothing(st: *Fresh, name: string, args: Buf[TExpr]) -> bool
    var all = true

    for i in 1..<args.len()
        if !fresh_arg(st, args.at(i)) then all = false

    all || is_buf_member(name) && plain_elements(texpr_type(args.at(0)))
end call_keeps_nothing

// The library's `Buf`, whose members keep nothing of the buffer they are called on.
private is_buf_member(name: string) -> bool = name.starts_with(module_qualify("sysl.buf", "Buf") + ".")

// Whether a `Buf` (or a pointer to one) holds elements that share no count.
private plain_elements(t: Type) -> bool = t match
    Ptr(inner) -> plain_elements(*inner)
    Struct(d) -> d.base == module_qualify("sysl.buf", "Buf") && d.targs.len() == 1 &&
                 unshareable(d.targs.at(0)).is_none()
    _ -> false

// A value that holds no count and no address, so nothing about it can be shared with anything.
private inert(t: Type) -> bool = unshareable(t).is_none() && !holds_address(t)

private holds_address(t: Type) -> bool = t match
    Ptr(_) -> true
    Ref(_, _) -> true
    Weak(_) -> true
    Array(_, elem) -> holds_address(*elem)
    Constrained(d) -> holds_address(d.base)
    Struct(d) -> any_address(d.fields)
    Enum(d) -> variants_address(d.variants)
    _ -> false

private any_address(fields: Buf[(string, Type)]) -> bool
    for item in fields
        if holds_address(item.1) then return true

    false

private variants_address(vs: Buf[EnumVariant]) -> bool
    for item in vs
        if any_address(item.fields) then return true

    false

// An argument that may go into a call without sharing anything: one holding no count and no
// address, or a fresh value.
private fresh_arg(st: *Fresh, e: TExpr) -> bool =
    inert(texpr_type(e)) || (unshareable(texpr_type(e)).is_some() && tentative(st, e))

// Whether a value is fresh, keeping the mentions it cleared only where it is.
private tentative(st: *Fresh, e: TExpr) -> bool
    val mark = st.cleared.len()

    if fresh_value(st, e) then return true

    st.cleared.truncate(mark)
    false

private fresh_block(st: *Fresh, b: TBlock) -> bool = b.result match
    Some(r) -> fresh_value(st, r)
    None -> true

// A value that shares no count that is not atomic: one whose type carries none, a literal, a copy of
// a string, a call handed only fresh or inert arguments, a `.copy()` of a `Buf` whose elements hold
// no count, a fresh local, or something built of those.
private fresh_value(st: *Fresh, e: TExpr) -> bool
    if unshareable(texpr_type(e)).is_none() then return true

    *e.kind match
        TStrLit(_) -> true
        TFromBytes(_) -> true
        TLoad(name, _) ->
            if !holds_string(st.locals, name) then return false

            st.cleared.push(name)
            true
        TCall(name, args, ty, _) -> fresh_call(st, name, args, ty)
        TConstView(arg) -> fresh_value(st, arg)
        TIf(_, then_block, else_block, _) ->
            fresh_block(st, then_block) && (else_block.is_none() || fresh_block(st, else_block.unwrap()))
        TMatch(_, arms, _) -> fresh_arms(st, arms)
        TBlockExpr(b) -> fresh_block(st, b)
        TEnumNew(_, _, parts) -> all_fresh(st, parts)
        TStructNew(_, parts) -> all_fresh(st, parts)
        _ -> false
end fresh_value

// A call answers something fresh where nothing it is handed can be in what it answers: every
// argument is fresh or holds no count and no address. A `Buf`'s `.copy()` is fresh whatever it is
// called on, where the elements it copies hold no count.
private fresh_call(st: *Fresh, name: string, args: Buf[TExpr], ty: Type) -> bool
    if name.starts_with(module_qualify("sysl.buf", "Buf") + ".copy.") && plain_elements(ty)
        if !args.is_empty() then tentative(st, args.at(0))

        return true

    for arg in args
        if !fresh_arg(st, arg) then return false

    true
end fresh_call

private fresh_arms(st: *Fresh, arms: Buf[TArm]) -> bool
    for arm in arms
        if !fresh_block(st, arm.body) then return false

    true

private all_fresh(st: *Fresh, parts: Buf[TExpr]) -> bool
    for part in parts
        if !fresh_value(st, part) then return false

    true

// What a call answering something shared out of a guard is told: what left, what it reaches, and the
// spelling that makes it fresh.
private guarded_complaint(shown: string, inside: Unshareable, p: Unshareable, whole: Type) -> string
    val field = inside.path.at(0)
    val head = s"'$shown' answers a value out of the '$field' it guards, and once the guard is let go " +
               "that value is shared with whoever holds it next, so every count it reaches has to be " +
               "atomic — "

    head + s"${leaving_where(p, whole)}, ${leaving_remedy(p.ty)}"
end guarded_complaint

private leaving_where(p: Unshareable, whole: Type) -> string
    if p.path.is_empty() && p.ty == whole then return s"but this answers a '${type_show(p.ty)}'"

    if p.path.is_empty() then return s"but this answers a '${type_show(whole)}' holding a '${type_show(p.ty)}'"

    s"but this answers a '${type_show(whole)}', whose '${joined(p.path, ".")}' reaches a '${type_show(p.ty)}'"

private leaving_remedy(ty: Type) -> string
    if ty == Str
        return "which may share its bytes' count with the guarded one. Answer a fresh string " +
               "instead — '.copy()' inside the closure gives the string an owner of its own, and a " +
               "literal is immortal"

    "whose count is not atomic. Answer what the caller needs from it — a count, a flag, a " +
    "'.copy()' of a string, a value built fresh inside the closure — rather than the value itself"
end leaving_remedy
