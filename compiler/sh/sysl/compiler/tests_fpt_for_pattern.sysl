module sh.sysl.compiler
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.{Search, replace_all}
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture

// `for (k, v) in pairs` -- a loop that takes its element apart (`reference/statements.md`).
//
// The pattern is the one a `val` or a `var` binding takes, which is the whole rule: a `for` binds
// what a binding binds. So these assert that the existing pattern grammar is reachable from a loop
// header -- a nested tuple, a part skipped with `_`, a struct by field name, the whole element kept
// beside its parts with `n @` -- that the loop is still a loop, that the headers a pattern must not
// disturb still read as they did, and the refusals.
//
// **Every output and every report quoted here was read out of the reference compiler**, whose
// `ForPatternTests` these are; a report is quoted whole, with the scratch directory written `@`.

private var fpt_library_cache: Buf[Program] = buf()
private var fpt_library_read: bool = false

private fpt_library() -> Buf[Program]
    if fpt_library_read then return fpt_library_cache

    fpt_library_read = true

    std_root() match
        Err(_) -> ()
        Ok(root) -> std_units(root, host_target()) match
            Err(_) -> ()
            Ok(units) -> fpt_library_cache = units

    fpt_library_cache
end fpt_library

// Every claim here is about a whole program, so all of them want the library and a toolchain.
private fpt_ready() -> bool
    if fpt_library().is_empty()
        print("skipped: the standard module's source is not on this machine")
        return false

    if !clang_available()
        print("skipped: there is no clang on this machine")
        return false

    true
end fpt_ready

// **What a program PRINTS**, which is the one claim nothing short of building and running it makes.
private fpt_ran(text: string) -> string
    val root = make_temp_dir("sysl-for-pattern").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", text).unwrap()

    val exe = s"$root/built"

    build_native_program(s"$root/main.sysl", None, None, DefaultOptimization, Some(exe)) match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return failure_text(why)
        Ok(_) -> ()

    val said = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    said match
        Err(_) -> "the program that was built could not be run"
        Ok(out) -> out.text
end fpt_ran

// The whole report a program is refused with, its scratch directory written `@`.
private fpt_err(text: string) -> string
    // `$TMPDIR` ends in a slash, and a diagnostic names the file by its normalized path.
    val root = replace_all(make_temp_dir("sysl-for-pattern").unwrap(), "//", "/")
    val src = s"$root/main.sysl"

    make_dir_all(root).unwrap()
    write_text(src, text).unwrap()

    val out = emit_llvm_text(src, None) match
        Err(why) -> failure_text(why)
        Ok(made) -> if made.report.is_empty() then "" else analysis_report(made.report)

    remove_dir_all(root).unwrap_or(())
    replace_all(out, root, "@")
end fpt_err

// ---------------------------------------------------------------------------------------------
// An element, taken apart.

@test("a pair")
fpt_a_pair()
    if !fpt_ready() then return

    assert_eq(fpt_ran(raw"""
        show() =
            for (a, b) in [(1, 2), (3, 4)]
                print(a, b)

        show()
        """), "1 2\n3 4\n")

@test("parts of different types")
fpt_parts_of_different_types()
    if !fpt_ready() then return

    assert_eq(fpt_ran(raw"""
        show() =
            for (n, s) in [(1, "one"), (2, "two")]
                print(n, s)

        show()
        """), "1 one\n2 two\n")

// What a list of names could not reach, which is the argument for the pattern form here as much as
// it is at a binding.
@test("a nested tuple")
fpt_a_nested_tuple()
    if !fpt_ready() then return

    assert_eq(fpt_ran(raw"""
        show() =
            for ((a, b), c) in [((1, 2), 3), ((4, 5), 6)]
                print(a, b, c)

        show()
        """), "1 2 3\n4 5 6\n")

@test("a part skipped with a wildcard")
fpt_a_part_skipped_with_a_wildcard()
    if !fpt_ready() then return

    assert_eq(fpt_ran(raw"""
        show() =
            var total = 0

            for (_, v) in [("a", 1), ("b", 2)]
                total += v

            print(total)

        show()
        """), "3\n")

@test("a struct, by field name")
fpt_a_struct_by_field_name()
    if !fpt_ready() then return

    assert_eq(fpt_ran(raw"""
        struct Point
            x: int
            y: int

        show() =
            for Point{x, y} in [Point(1, 2), Point(3, 4)]
                print(x * y)

        show()
        """), "2\n12\n")

@test("the whole element beside its parts, with 'n @'")
fpt_the_whole_element_beside_its_parts()
    if !fpt_ready() then return

    assert_eq(fpt_ran(raw"""
        show() =
            for whole @ (a, _) in [(7, 8)]
                print(a, whole.1)

        show()
        """), "7 8\n")

// The parts are `var` because the loop variable itself is: taking the element apart should not
// quietly take away what a plain `for` allows.
@test("a part may be assigned to, exactly as a loop variable may")
fpt_a_part_may_be_assigned_to()
    if !fpt_ready() then return

    assert_eq(fpt_ran(raw"""
        show() =
            for (n, _) in [(1, 0), (2, 0)]
                n += 10
                print(n)

        show()
        """), "11\n12\n")

@test("one loop inside another, each with its own pattern")
fpt_one_loop_inside_another()
    if !fpt_ready() then return

    assert_eq(fpt_ran(raw"""
        show() =
            for (n, inner) in [(1, [(10, 20), (30, 40)])]
                for (a, b) in inner
                    print(n + a + b)

        show()
        """), "31\n71\n")

// ---------------------------------------------------------------------------------------------
// The loop is still a loop.

@test("a label, a 'continue', a 'break' and the value it carries")
fpt_a_label_a_continue_a_break()
    if !fpt_ready() then return

    assert_eq(fpt_ran(raw"""
        show() =
            val pairs = [(1, 2), (3, 4), (5, 6)]

            val found = 'walk for (a, b) in pairs
                if a == 1
                    continue 'walk

                if b == 6
                    break 'walk a
            else
                0

            print(found)

        show()
        """), "5\n")

@test("the 'else' runs when the walk finishes on its own")
fpt_the_else_runs_when_the_walk_finishes()
    if !fpt_ready() then return

    assert_eq(fpt_ran(raw"""
        show() =
            val n = for (a, _) in [(1, 2)]
                if a == 99
                    break a
            else
                -1

            print(n)

        show()
        """), "-1\n")

// What the feature was asked for. A map has no entry to hand back a reference to, so `walk` yields
// a pair and every loop over one used to pay a line for it.
@test("a map, walked by pattern")
fpt_a_map_walked_by_pattern()
    if !fpt_ready() then return

    assert_eq(fpt_ran(raw"""
        import sysl.container.{map}

        show() =
            var m = map[string, int]()

            m.put("a", 1)
            m.put("b", 2)

            var total = 0

            for (_, v) in m.walk()
                total += v

            print(total)

        show()
        """), "3\n")

// ---------------------------------------------------------------------------------------------
// What a pattern must not disturb. Every alternative of the pattern grammar needs a `(` or a `{`
// where a plain loop has its `in`, so the two forms cannot be confused for one another.

@test("a plain loop over a range")
fpt_a_plain_loop_over_a_range()
    if !fpt_ready() then return

    assert_eq(fpt_ran(raw"""
        show() =
            for i in 0..<3
                print(i)

        show()
        """), "0\n1\n2\n")

@test("a three-clause loop whose init declares several names")
fpt_a_three_clause_init_declares_several()
    if !fpt_ready() then return

    assert_eq(fpt_ran(raw"""
        show() =
            for var i, j = 0, 6; i < j; i += 2
                print(i)

        show()
        """), "0\n2\n4\n")

// The header the comma refusal below has to leave alone: `for a, b = …` is a legal init clause, and
// it is the same first three tokens as the spelling being refused.
@test("a three-clause loop whose init assigns to several names")
fpt_a_three_clause_init_assigns_several()
    if !fpt_ready() then return

    assert_eq(fpt_ran(raw"""
        show() =
            var a = 0
            var b = 6

            for a, b = 0, 6; a < b; a += 3
                print(a)

        show()
        """), "0\n3\n")

// ---------------------------------------------------------------------------------------------
// The refusals.

// The message names the form that works, spelled with the reader's own names, and never an
// operator the program did not contain.
@test("the comma spelling is answered with the form that works")
fpt_the_comma_spelling_is_answered()
    if !fpt_ready() then return

    val said = fpt_err(raw"""
        show() =
            for k, v in [(1, 2)]
                print(k, v)

        show()
        """)

    assert_eq(said,
        "error: a 'for' names one thing, and a pattern is what takes it apart — write 'for (k, v) in …'\n" +
        " --> @/main.sysl:2:14\n" +
        "  |\n" +
        "2 |     for k, v in [(1, 2)]\n" +
        "  |              ^^")
    assert(!said.contains(">>="), said)

@test("and it names however many parts were written")
fpt_and_it_names_however_many_parts()
    if !fpt_ready() then return

    assert_eq(fpt_err(raw"""
        show() =
            for a, b, c in [(1, 2, 3)]
                print(a)

        show()
        """),
        "error: a 'for' names one thing, and a pattern is what takes it apart — write 'for (a, b, c) in …'\n" +
        " --> @/main.sysl:2:17\n" +
        "  |\n" +
        "2 |     for a, b, c in [(1, 2, 3)]\n" +
        "  |                 ^^")

// The pattern is checked against the element, so a range answers with what a range has -- and
// nothing after it: the names the pattern writes are still bound, so the body reads them quietly.
@test("a range has nothing to take apart")
fpt_a_range_has_nothing_to_take_apart()
    if !fpt_ready() then return

    assert_eq(fpt_err(raw"""
        show() =
            for (a, b) in 0..<3
                print(a, b)

        show()
        """),
        "error: one int is not something to take apart — only a tuple is\n" +
        " --> @/main.sysl:2:9\n" +
        "  |\n" +
        "2 |     for (a, b) in 0..<3\n" +
        "  |         ^")

@test("a pattern with the wrong number of parts")
fpt_a_pattern_with_the_wrong_number_of_parts()
    if !fpt_ready() then return

    assert_eq(fpt_err(raw"""
        show() =
            for (a, b) in [(1, 2, 3)]
                print(a, b)

        show()
        """),
        "error: this pattern takes 2 parts, and a (int, int, int) has 3 parts to give it\n" +
        " --> @/main.sysl:2:9\n" +
        "  |\n" +
        "2 |     for (a, b) in [(1, 2, 3)]\n" +
        "  |         ^")

// A loop is a binding, and a binding has no other arm to take when the value has another shape. The
// reference leaves the variant's names unbound, so the body's use of one is reported too.
@test("a variant, which is a choice among shapes")
fpt_a_variant_which_is_a_choice_among_shapes()
    if !fpt_ready() then return

    assert_eq(fpt_err(raw"""
        enum Shape
            Circle(r: int)
            Square(s: int)

        show() =
            for Circle(r) in [Shape.Circle(1)]
                print(r)

        show()
        """),
        "error: a binding cannot choose among variants — this pattern matches one of several shapes, " +
        "and a binding has no other arm to take when the value has another\n" +
        " --> @/main.sysl:6:9\n" +
        "  |\n" +
        "6 |     for Circle(r) in [Shape.Circle(1)]\n" +
        "  |         ^^^^^^\n" +
        "\n" +
        "error: undefined name 'r'\n" +
        " --> @/main.sysl:7:15\n" +
        "  |\n" +
        "7 |         print(r)\n" +
        "  |               ^")

// The unrolled loop counts a range, so there is never anything there to take apart.
@test("'for const' takes a name and nothing else")
fpt_for_const_takes_a_name_and_nothing_else()
    if !fpt_ready() then return

    assert_eq(fpt_err(raw"""
        show() =
            for const (a, b) in 0..<2
                print(a)

        show()
        """),
        "error: identifier expected\n" +
        " --> @/main.sysl:2:15\n" +
        "  |\n" +
        "2 |     for const (a, b) in 0..<2\n" +
        "  |               ^")
