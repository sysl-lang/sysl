module sysl

/** The two kinds of count a counted reference comes in, which is what a `count K` parameter stands
 * for: the ordinary count of a `&T`, and the atomic count of a `&sync T`.
 *
 * A program does not name this type or its variants. It writes `[count K]` in a declaration's
 * parameter list, `&K T` for a reference whose kind is the parameter, and `plain` or `sync` where an
 * instance is spelled: `Node[int, sync]`.
 */
enum CountKind
    PlainCount
    SyncCount
