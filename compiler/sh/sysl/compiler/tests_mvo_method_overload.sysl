module sh.sysl.compiler
@tests

import sysl.text.Search

// A type's own members overload by the rule functions do (`reference/declarations.md § Overloading
// a member`): one name, several parameter lists, and each call meaning exactly one of them.

private mvo_ran(src: string) -> string = xvr_ran([("main.sysl", src)])

// What analysis says of a program, or the IR where it says nothing.
private mvo_said(src: string) -> string = xvr_ir([("main.sysl", src)])

@test("a method overloads by type and by arity, and each call reaches its own body")
mvo_by_type_and_arity()
    if xvr_no_library() then return

    assert_eq(mvo_ran(raw"""
        struct S
            n: int

            f(self, x: int) -> int = x + self.n
            f(self, x: string) -> int = int(x.len)
            f(self, x: int, y: int) -> int = x * y

        val s = S(10)
        print(s.f(1), s.f("abc"), s.f(3, 4))
        """), "11 3 12\n")

@test("an associated function overloads, and so does a method taking '*self'")
mvo_associated_and_pointer_receiver()
    if xvr_no_library() then return

    assert_eq(mvo_ran(raw"""
        struct C
            n: int

            make(n: int) -> C = C(n)
            make(s: string) -> C = C(int(s.len))
            bump(*self, by: int) = self.n += by
            bump(*self, by: string) = self.n += int(by.len)

        var c = C.make("ab")
        c.bump(3)
        c.bump("xyz")
        print(c.n, C.make(7).n)
        """), "8 7\n")

@test("an enum's members overload, a bare one beside one taking an argument")
mvo_enum_members()
    if xvr_no_library() then return

    assert_eq(mvo_ran(raw"""
        enum E
            A
            B(n: int)

            tag(self) -> string = "none"
            tag(self, x: int) -> string = s"int $x"

        print(A.tag(), B(1).tag(2))
        """), "none int 2\n")

@test("a generic type's overloads are chosen at the receiver's instantiation, and in a generic body")
mvo_generic_receiver()
    if xvr_no_library() then return

    assert_eq(mvo_ran(raw"""
        struct Box[T]
            v: T

            put(self, x: T) -> string = "same"
            put(self, x: string, y: int) -> string = "pair"

        g[T](b: Box[T], x: T) -> string = b.put(x)

        val b = Box(1)
        print(b.put(2), b.put("x", 3), g(b, 7), g(Box("s"), "t"))
        """), "same pair same same\n")

@test("the literal tie-break a function's overloads use chooses a member's too")
mvo_literal_tie_break()
    if xvr_no_library() then return

    assert_eq(mvo_ran(raw"""
        struct W
            n: int

            pick(self, x: long) -> string = "long"
            pick(self, x: u64) -> string = "u64"

        val w = W(0)
        print(w.pick(3), w.pick(3u64))
        """), "long u64\n")

@test("two members a call could not tell apart are refused at the second, and its body is not read")
mvo_indistinguishable_pair()
    if xvr_no_library() then return

    val said = mvo_said(raw"""
        struct D
            n: int

            h(self, x: int) -> string = "s"
            h(self, x: int, y: int = 0) -> int = 1

        print(D(0).h(1))
        """)

    assert(said.contains("error: type 'D' already has a member named 'h' with parameters this one " +
                         "could not be told from — a call passing 1 argument would fit both, and " +
                         "which declaration a call means is decided by its arguments and never by " +
                         "what it returns. Two declarations of one name have to differ in a way a " +
                         "call site can show"), said)
    assert_eq(xvr_count(said, "error:"), 1, said)

@test("a pair differing only in what they return is the same refusal")
mvo_result_only()
    if xvr_no_library() then return

    val said = mvo_said(raw"""
        struct D
            n: int

            h(self, x: int) -> string = "s"
            h(self, x: int) -> int = 1
        """)

    assert(said.contains("type 'D' already has a member named 'h' with parameters this one could " +
                         "not be told from — a call passing 1 argument would fit both"), said)
    assert_eq(xvr_count(said, "error:"), 1, said)

@test("a call several members take equally is ambiguous, and the message carries the roster")
mvo_ambiguous_call()
    if xvr_no_library() then return

    val said = mvo_said(raw"""
        struct W
            n: int

            width(self, x: u8) -> string = "u8"
            width(self, x: u16) -> string = "u16"

        print(W(0).width(1))
        """)

    assert(said.contains("error: 'W.width' is ambiguous here — 2 of its declarations take these " +
                         "arguments:\n    W.width(x: u8)\n    W.width(x: u16)\nAnnotate an " +
                         "argument, or name the type a literal is meant at"), said)

@test("a call no member takes is refused with the roster")
mvo_no_member_fits()
    if xvr_no_library() then return

    val said = mvo_said(raw"""
        struct K
            n: int

            k(self, x: int) -> string = "a"
            k(self, x: string) -> string = "b"

        print(K(0).k(1.5))
        """)

    assert(said.contains("error: no 'K.k' takes these arguments — the declarations of that name " +
                         "are:\n    K.k(x: int)\n    K.k(x: string)"), said)

@test("where one member alone takes that many arguments, its own complaint is the message")
mvo_one_plausible()
    if xvr_no_library() then return

    val said = mvo_said(raw"""
        struct K
            n: int

            k(self, x: int) -> string = "a"
            k(self, x: int, y: int) -> string = "b"

        print(K(0).k(1, "no"))
        """)

    // Quoted under the name it was written with, never the slot the second is filed under.
    assert(said.contains("error: 'y' of 'K.k' is int, but string was given"), said)

@test("an overloaded method read without a call is told to call it, as a single one is")
mvo_read_without_call()
    if xvr_no_library() then return

    val said = mvo_said(raw"""
        struct C
            n: int

            get(self, x: int) -> int = x
            get(self, x: string) -> int = 0

        val g = C(1).get
        """)

    assert(said.contains("error: 'get' is a method of 'C' — call it with 'get(…)'"), said)

@test("a property still shares its name with nothing")
mvo_property_not_overloaded()
    if xvr_no_library() then return

    val said = mvo_said(raw"""
        struct P
            n: int

            size -> int = self.n
            size(self, x: int) -> int = x
        """)

    assert(said.contains("error: type 'P' already has a member named 'size'"), said)
    assert(!said.contains("could not be told from"), said)

@test("an inherent member and a trait's member of one name still collide, whatever their parameters")
mvo_trait_and_inherent_collide()
    if xvr_no_library() then return

    val said = mvo_said(raw"""
        trait Show2
            show(self) -> string

        struct T1
            n: int

            show(self, x: int) -> string = "inherent"

        impl Show2 for T1
            show(self) -> string = "trait"
        """)

    assert(said.contains("error: type 'T1' already has a member named 'show'"), said)
    assert(!said.contains("could not be told from"), said)

@test("a trait declares each member name once, and a second declaration is refused rather than kept")
mvo_trait_declares_a_name_once()
    if xvr_no_library() then return

    val said = mvo_said(raw"""
        trait Tr
            f(self, x: int) -> string
            f(self, x: string) -> string
        """)

    assert(said.contains("error: trait 'Tr' already declares a member named 'f' — an " +
                         "implementation supplies a trait's members by name, so a trait declares " +
                         "each name once; give this one a name of its own"), said)
