module sh.sysl.compiler
@tests

import sh.sysl.parsing.source_of
import sysl.buf.{Buf, buf}
import sysl.text.{from_utf8_unchecked, join, Search}

// The library this compiler resolved, and what it is wherever it was found -- the rest of the
// reference's `StdLibraryTests`: each file named by its place, the fingerprint the artifact is keyed
// by, and the module every file's header names.

private lfb_root() -> Option[string] = std_root() match
    Ok(r) -> Some(r)
    Err(_) ->
        print("skipped: the standard module's source is not on this machine")
        None

private lfb_sources(root: string) -> Buf[Found] = std_sources(root, Some(host_target().os)).unwrap()

// A file's place in the library: the module directories it sits under, then its own name.
private lfb_place(f: Found) -> string =
    if f.dir.is_empty() then basename(f.src.name) else s"${join(f.dir.view(), "/")}/${basename(f.src.name)}"

private lfb_file(name: string, dir: []string) -> Found
    var d: Buf[string] = buf()

    for x in dir do d.push(x)
    Found(source_of(name, "x"), d)
end lfb_file

// ---- the library this compiler resolved ----

@test("is the one in this checkout")
lfb_the_resolved_library_is_this_checkouts()
    val root = lfb_root() match
        None -> return
        Some(r) -> r

    // Compared by place and by text, so a file in the tree the compiler did not see fails here.
    val on_disk = collect(root, Some(host_target().os)).unwrap()
    val seen = lfb_sources(root)

    assert_eq(seen.len(), on_disk.len())

    for i in 0..<on_disk.len()
        val place = lfb_place(on_disk.at(i))
        var matched = false

        for j in 0..<seen.len()
            if lfb_place(seen.at(j)) == place
                assert(from_utf8_unchecked(seen.at(j).src.bytes) == from_utf8_unchecked(on_disk.at(i).src.bytes),
                       place)
                matched = true

        assert(matched, s"$place is on disk and not in what the compiler read")

@test("and names each file by its place in the library rather than by where it was read from")
lfb_each_file_is_named_by_its_place()
    val root = lfb_root() match
        None -> return
        Some(r) -> r

    val seen = lfb_sources(root)

    for i in 0..<seen.len()
        assert_eq(seen.at(i).src.name, s"$StdPrefix/${lfb_place(seen.at(i))}")

@test("the same name whether it was read from a checkout or from an install")
lfb_the_same_name_from_a_checkout_or_an_install()
    val checkout = std_named(lfb_file("library/sysl/print.sysl", ["sysl"]))
    val installed = std_named(lfb_file("/opt/homebrew/Cellar/sysl/0.0.3/share/sysl/library/sysl/print.sysl", ["sysl"]))

    assert_eq(checkout.src.name, "library/sysl/print.sysl")
    assert_eq(installed.src.name, checkout.src.name)

@test("and the same name out of a tree that still has the old directory name")
lfb_the_same_name_out_of_the_old_directory()
    assert_eq(std_named(lfb_file("lib/sysl/print.sysl", ["sysl"])).src.name, "library/sysl/print.sysl")

@test("in a fixed order, decided by the library rather than by a directory listing")
lfb_in_a_fixed_order()
    val root = lfb_root() match
        None -> return
        Some(r) -> r

    val seen = lfb_sources(root)

    for i in 1..<seen.len()
        assert(lfb_place(seen.at(i - 1)) <= lfb_place(seen.at(i)),
               s"${lfb_place(seen.at(i - 1))} before ${lfb_place(seen.at(i))}")

@test("with every file in the module its own location says, however deep")
lfb_every_file_in_the_module_its_location_says()
    val root = lfb_root() match
        None -> return
        Some(r) -> r

    val seen = lfb_sources(root)
    var deepest: usize = 0

    for i in 0..<seen.len()
        val f = seen.at(i)

        assert(f.src.name.ends_with(lfb_place(f)), f.src.name)
        assert_eq(f.dir.at(0), StdModule)

        if f.dir.len() > deepest then deepest = f.dir.len()

    // `sysl.math.complex` is two below the standard module, so the claim is not met by a flat tree.
    assert(deepest >= 3, s"the deepest file is $deepest directories down")
