// The calendar: a date and a time of day with no zone attached, and the arithmetic that turns one
// into the other.
//
// A **local** date-time is a reading on a wall clock. It is not a point on the timeline and it does
// not become one until somebody says where the wall is — which is the whole subject of `zone.sysl`.
// Kept apart from `Instant` it is an ordinary, boring value: a day number and a count of
// microseconds since midnight, both of them plain integers with no calendar hidden inside.
//
// **A day number, not packed civil fields.** The alternative — year, month, day, hour, minute and
// so on as bit fields inside one word — is the design most people reach for, and the arithmetic
// says no. Packing to the nanosecond needs 30 bits for the nanosecond, 17 for the time of day and
// 9 for the day and month, which is 56, leaving 8 bits of year: a range of ±128 years, which is
// not a calendar. Dropping to microseconds leaves 18 bits of year and does fit. But a *count*
// fits more comfortably at the same width — microseconds within a day need 37 bits, leaving 27 for
// the day number and a range of ±183,000 years — and it costs nothing to compute with, because
// comparing, subtracting, and adding a length of time are one instruction each on a count and an
// unpack-recompute-repack on packed fields. Only "what month is it" wants the fields, and that is
// the rare question, paid for below where it is asked.

// Proleptic Gregorian, which means the Gregorian rules run backwards through the years before
// anybody agreed to them. That is a decision and not an oversight: the alternative is a calendar
// with a ten-day hole in it whose position depends on which country you ask.
struct Civil
    year: int
    month: int
    day: int
end Civil

// Days since 1970-01-01. Signed, so dates before the epoch are ordinary values rather than a
// special case — the algorithm below never branches on the sign.
struct LocalDate
    day: int
end LocalDate

// Microseconds since midnight, in the range 0 up to but not including a whole day.
struct LocalTime
    us: long
end LocalTime

// A wall clock reading. Two independent counts rather than one, because they are added and
// compared far more often than they are combined.
struct LocalDateTime
    date: LocalDate
    time: LocalTime
end LocalDateTime

enum Weekday
    Sunday
    Monday
    Tuesday
    Wednesday
    Thursday
    Friday
    Saturday
end Weekday

// Division that rounds toward minus infinity, which is the only kind a calendar can use: the day
// containing an instant is `floor(us / us_per_day)`, and a `/` that truncates toward zero puts
// every moment of the day before the epoch into the day after it.
floor_div(a: long, b: long) -> long
    var q = a / b

    if a % b != 0i64 && (a < 0i64) != (b < 0i64) then q - 1i64 else q
end floor_div

floor_mod(a: long, b: long) -> long = a - floor_div(a, b) * b

// Howard Hinnant's civil-from-days pair, which is the standard way to do this and is worth using
// rather than rediscovering. It works by shifting the epoch to the start of a 400-year era, after
// which every quantity in it is non-negative and the leap rules become one exact division apiece.
//
// `days_from_civil` is its own inverse over the whole `int` range, which is the property the
// round-trip checks assert rather than any particular date.
days_from_civil(c: Civil) -> LocalDate
    var y = if c.month <= 2 then c.year - 1 else c.year
    var era = floor_div(long(y), 400i64)
    var yoe = long(y) - era * 400i64
    var mp = if c.month > 2 then c.month - 3 else c.month + 9
    var doy = long(153 * mp + 2) / 5i64 + long(c.day) - 1i64
    var doe = yoe * 365i64 + yoe / 4i64 - yoe / 100i64 + doy

    LocalDate(int(era * 146097i64 + doe - 719468i64))
end days_from_civil

civil_from_days(d: LocalDate) -> Civil
    var z = long(d.day) + 719468i64
    var era = floor_div(z, 146097i64)
    var doe = z - era * 146097i64
    var yoe = (doe - doe / 1460i64 + doe / 36524i64 - doe / 146096i64) / 365i64
    var doy = doe - (365i64 * yoe + yoe / 4i64 - yoe / 100i64)
    var mp = (5i64 * doy + 2i64) / 153i64
    var day = doy - (153i64 * mp + 2i64) / 5i64 + 1i64
    var month = if mp < 10i64 then mp + 3i64 else mp - 9i64
    var year = yoe + era * 400i64 + (if month <= 2i64 then 1i64 else 0i64)

    Civil(int(year), int(month), int(day))
end civil_from_days

// 1970-01-01 was a Thursday, so shifting by four puts Sunday at zero. Nothing here needs to know
// which day a week starts on; it only needs the seven to be in the order the world uses them.
//
// A weekday is a **simple** enum, so it converts to its number and back, and both directions are
// used: the arithmetic wants a number to take a remainder of, and everything else wants a name. The
// remainder is in range by construction, which is what makes the conversion back a total function
// rather than something that has to be checked.
weekday(d: LocalDate) -> Weekday = Weekday(int(floor_mod(long(d.day) + 4i64, 7i64)))

weekday_name(w: Weekday) -> string = w match
    Sunday -> "Sunday"
    Monday -> "Monday"
    Tuesday -> "Tuesday"
    Wednesday -> "Wednesday"
    Thursday -> "Thursday"
    Friday -> "Friday"
    Saturday -> "Saturday"

// The first date on or after `d` that falls on the given weekday, which is what "every Tuesday"
// means when a rule is first given a starting point.
on_or_after(d: LocalDate, w: Weekday) -> LocalDate =
    LocalDate(d.day + int(floor_mod(long(int(w) - int(weekday(d))), 7i64)))

date_at(y: int, m: int, d: int) -> LocalDate = days_from_civil(Civil(y, m, d))

time_at(h: int, m: int, s: int) -> LocalTime =
    LocalTime(long(h) * us_per_hour + long(m) * us_per_minute + long(s) * us_per_second)

datetime_at(y: int, mo: int, d: int, h: int, mi: int, s: int) -> LocalDateTime =
    LocalDateTime(date_at(y, mo, d), time_at(h, mi, s))

hour_of(t: LocalTime) -> int = int(t.us / us_per_hour)
minute_of(t: LocalTime) -> int = int(t.us % us_per_hour / us_per_minute)
second_of(t: LocalTime) -> int = int(t.us % us_per_minute / us_per_second)

// A wall clock reading as a single count, measured from the same origin as an `Instant` but
// **not** an instant: it is what the count would be if the zone's offset happened to be zero. Every
// conversion in `zone.sysl` starts here and then asks what the offset actually is.
wall_us(ldt: LocalDateTime) -> long = long(ldt.date.day) * us_per_day + ldt.time.us

wall_of(us: long) -> LocalDateTime =
    LocalDateTime(LocalDate(int(floor_div(us, us_per_day))), LocalTime(floor_mod(us, us_per_day)))

// Adding days to a wall clock reading is not adding a length of time to it. Seven days later is
// the same clock face seven rows down the calendar, whatever the timeline did in between — which
// is exactly the distinction the checks in `main.sysl` are about.
plus_days(ldt: LocalDateTime, n: int) -> LocalDateTime =
    LocalDateTime(LocalDate(ldt.date.day + n), ldt.time)

impl Eq for LocalDate
    eq(self, rhs: LocalDate) -> bool = self.day == rhs.day
end LocalDate

impl Ord for LocalDate
    lt(self, rhs: LocalDate) -> bool = self.day < rhs.day
end LocalDate

impl Eq for LocalTime
    eq(self, rhs: LocalTime) -> bool = self.us == rhs.us
end LocalTime

impl Eq for LocalDateTime
    eq(self, rhs: LocalDateTime) -> bool = self.date == rhs.date && self.time == rhs.time
end LocalDateTime

date_text(d: LocalDate) -> string
    var c = civil_from_days(d)

    f"${c.year}%04d-${c.month}%02d-${c.day}%02d"
end date_text

// Seconds appear only when there are any. A meeting at half past nine is written `09:30` by every
// human being who has ever written one down, and a renderer that insists on `09:30:00` is reporting
// its representation rather than its value.
// The microseconds appear on the same terms, because a renderer that shows a value to the second
// and drops what is below it is reporting something the value does not say. A reading either has a
// fraction or it does not, and if it has one it is written down.
time_text(t: LocalTime) -> string
    var base = f"${hour_of(t)}%02d:${minute_of(t)}%02d"

    if t.us % us_per_minute == 0i64 then return base

    var withsec = f"$base%s:${second_of(t)}%02d"

    if t.us % us_per_second == 0i64 then withsec else f"$withsec%s.${t.us % us_per_second}%06d"
end time_text

datetime_text(ldt: LocalDateTime) -> string = f"${date_text(ldt.date)}%s ${time_text(ldt.time)}%s"

impl Display for LocalDate
    display(self, out: *Writer, fmt: FormatSpec) = display_str(date_text(self), out, fmt)
end LocalDate

impl Display for LocalTime
    display(self, out: *Writer, fmt: FormatSpec) = display_str(time_text(self), out, fmt)
end LocalTime

impl Display for LocalDateTime
    display(self, out: *Writer, fmt: FormatSpec) = display_str(datetime_text(self), out, fmt)
end LocalDateTime
