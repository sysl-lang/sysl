module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.text.from_utf8_unchecked

// How a declaration's module and its own name are held as one string.
//
// **Every table in the analyzer is keyed by one string rather than by a pair**, because a key is
// compared, hashed and printed in dozens of places and a pair would have to be threaded through all
// of them. The separator is `$`, which no identifier may contain and which LLVM accepts in a symbol
// name -- so the key a table uses is also the symbol the object file carries, and there is no second
// naming scheme to keep in step with the first.

// The character that joins a module to a name.
const ModuleSep: char = '$'

// The module a file with no `module` clause belongs to. It is the empty string, so a top-level name
// is its own key and a program of one file has no prefix on anything.
const ModuleRoot: string = ""

// The key for a name in a module.
module_qualify(module_name: string, name: string) -> string =
    if module_name == "" then llvm_guard(name) else s"$module_name${ModuleSep}${llvm_guard(name)}"

// The module a key belongs to, and the bare name inside it.
module_split(key: string) -> (string, string)
    val bytes = key.bytes

    for i in 0..<bytes.len
        if bytes[i] == u8(ModuleSep) then
            return (from_utf8_unchecked(bytes[0..<i]), from_utf8_unchecked(bytes[i + 1..<bytes.len]))

    (ModuleRoot, key)
end module_split

// The module half of a key.
module_of(key: string) -> string = module_split(key).0

// How a refusal about a call names the function it is about.
//
// **The DECLARATION is quoted, not the spelling** — `'b' of 'sysl.text.from_utf8'` where the call
// wrote a bare `from_utf8`. Every module below the standard one is auto-imported, so the name a
// caller writes says nothing about which module answered, and a reader with the bare name has
// nowhere to go and read the signature. A function of the caller's own root module has no module to
// put in front, so the two spellings are the same word there and every single-file program reads as
// it always did. **A call that already wrote the module (`m.use()`) is quoted from the key too**, so
// the module is not put in front a second time.
qualified_callee(key: string, written: string) -> string =
    if module_of(key) == "" then written else readable_name(key)

// The name half of a key.
module_bare(key: string) -> string = module_split(key).1

// A key as a person writes it: the separator shown as the dot the source used.
module_show(key: string) -> string
    val bytes = key.bytes
    var out: Buf[u8] = buf()

    for i in 0..<bytes.len
        out.push(if bytes[i] == u8(ModuleSep) then u8('.') else bytes[i])

    from_utf8_unchecked(out.view())
end module_show

// A name with nothing in it that LLVM would read as the separator.
//
// Only `$` is at risk, since it is the one character an identifier may not hold and a *symbol* may:
// a name that already carries one came from somewhere other than an identifier, and escaping it
// keeps `module_split` able to find the real separator.
llvm_guard(name: string) -> string
    val bytes = name.bytes
    var found = false

    for i in 0..<bytes.len
        if bytes[i] == u8('$') then found = true

    if !found then return name

    var out: Buf[u8] = buf()

    for i in 0..<bytes.len
        if bytes[i] == u8('$') then
            out.push(u8('$'))
            out.push(u8('2'))
            out.push(u8('4'))
        else
            out.push(bytes[i])

    from_utf8_unchecked(out.view())
end llvm_guard

// A key with the segments the compiler added to it taken off -- an overload's number and a
// file-private slot -- so that what is left is the qualified name a file actually wrote.
//
// They come off in turn because a private slot can carry an overload suffix: a file that declares
// one spelling twice, privately, while a sibling file holds the plain key, has its second
// declaration at `m$pick.private1.1`.
spelled_key(key: string) -> string
    val cut = last_dot(key)

    if cut <= 0 || cut >= isize(key.bytes.len) - 1 then return key

    val last = from_utf8_unchecked(key.bytes[usize(cut) + 1..<key.bytes.len])

    if !all_digits(last) && !private_slot(last) then return key

    spelled_key(from_utf8_unchecked(key.bytes[0..<usize(cut)]))
end spelled_key

// The same, with an **overload's** number off and a private slot left on -- the key the declarations
// of one spelling in one file share.
overload_plain(key: string) -> string
    val cut = last_dot(key)

    if cut <= 0 || cut >= isize(key.bytes.len) - 1 then return key

    if !all_digits(from_utf8_unchecked(key.bytes[usize(cut) + 1..<key.bytes.len])) then return key

    from_utf8_unchecked(key.bytes[0..<usize(cut)])
end overload_plain

// The qualified name a file wrote, which is what a diagnostic says when it names a declaration.
qualified_name(key: string) -> string = readable_name(spelled_key(key))

// One key, standing alone, written as the qualified name a reader would write: `m$P.get` is
// `m.P.get`, `m$hid.private1` is `m.hid`, `m$f.2` is `m.f`, and a `$24` is a `$` the name itself
// held, read as one again. A root-module name has no module to show and prints bare.
readable_name(key: string) -> string
    val bytes = key.bytes
    var out: Buf[u8] = buf()
    var i: usize = 0

    while i < bytes.len
        if !key_byte(bytes[i])
            out.push(bytes[i])
            i += 1
            continue

        var j = i

        while j < bytes.len && key_byte(bytes[j])
            j += 1

        push_readable(&out, bytes[i..<j])
        i = j

    from_utf8_unchecked(out.view())
end readable_name

// A diagnostic's text with every declaration key it quotes written as the qualified name a reader
// would write (`readable_name`).
//
// **This is the one place a message is made readable, so no refusal has to remember to.** A key
// is whatever a table was keyed by, and dozens of refusals interpolate one straight into their text;
// doing it here means a key cannot reach a reader however the message was put together. **What
// counts as a key is narrow on purpose, and is the reference's**: a WHOLE span between two single
// quotes that is a module path -- name segments joined by dots -- then the separator and a letter or
// an underscore. So `'$'`, `'$name'`, `'a b$c'`, an unclosed `'m$use` and text outside quotes are
// left as written, and so is `'m$24x'`, whose `$24` is a guard mark rather than a name's first
// character.
//
// **A TYPE is quoted through `type_show`, which has already dotted the key** -- `m.Log.private1`,
// `m.Box[m.Log.private1]` -- so a private slot is taken out of every dotted run too, quoted or not.
// `type_show` itself keeps the slot, being what `emit-typed` prints and the reference's own
// rendering: the rule lives here, at the one boundary every diagnostic crosses, rather than in a
// mode of the printer that forty refusals would each have to ask for. A slot is never the first
// segment of a run, and text with neither a `$` nor a `.private` in it is not touched at all.
readable_keys(message: string) -> string
    val bytes = message.bytes
    var marked = false

    for k in 0..<bytes.len
        if bytes[k] == u8('$') || slot_at(bytes, k) then marked = true

    if !marked then return message

    var keyed: Buf[u8] = buf()
    var i: usize = 0

    while i < bytes.len
        val close = if bytes[i] == u8('\'') then closing_quote(bytes, i + 1) else -1

        if close > isize(i) && quoted_key(bytes[i + 1..<usize(close)])
            keyed.push(u8('\''))

            for b in readable_name(from_utf8_unchecked(bytes[i + 1..<usize(close)])).bytes
                keyed.push(b)

            keyed.push(u8('\''))
            i = usize(close) + 1
        else
            keyed.push(bytes[i])
            i += 1

    val text = keyed.view()
    var out: Buf[u8] = buf()
    var k: usize = 0

    while k < text.len
        if !key_byte(text[k])
            out.push(text[k])
            k += 1
            continue

        var j = k

        while j < text.len && key_byte(text[j])
            j += 1

        for b in drop_private_slots(from_utf8_unchecked(text[k..<j])).bytes
            out.push(b)

        k = j

    from_utf8_unchecked(out.view())
end readable_keys

// The next `'` at or after `from`, or -1.
private closing_quote(bytes: []const u8, from: usize) -> isize
    for k in from..<bytes.len
        if bytes[k] == u8('\'') then return isize(k)

    -1
end closing_quote

// Whether a quoted span is a key: a module path, the separator, and a name after it.
private quoted_key(s: []const u8) -> bool
    var at: isize = -1

    for k in 0..<s.len
        if s[k] == u8('\n') then return false
        if at < 0 && s[k] == u8('$') then at = isize(k)

    if at <= 0 || usize(at) >= s.len - 1 || !name_start(s[usize(at) + 1]) then return false

    var start = true

    for k in 0..<usize(at)
        if s[k] == u8('.')
            if start then return false

            start = true
        else if start
            if !name_start(s[k]) then return false

            start = false
        else if !name_start(s[k]) && !c_digit(s[k])
            return false

    !start
end quoted_key

// One run of name characters, written into `out` as a reader would spell it.
private push_readable(out: *Buf[u8], run: []const u8)
    val sep = key_separator(run)

    if sep < 0
        push_unguarded(out, drop_private_slots(from_utf8_unchecked(run)).bytes)
        return

    val at = usize(sep)

    for k in 0..<at
        out.push(run[k])

    out.push(u8('.'))

    val name = from_utf8_unchecked(run[at + 1..<run.len])

    push_unguarded(out, drop_private_slots(spelled_key(name)).bytes)
end push_readable

// Where the module ends in a run, or -1 where the run is not a key: the first `$` that is not a
// guarded one, with a module in front of it that begins with a name character and does not end in
// a dot.
private key_separator(run: []const u8) -> isize
    if run.len == 0 || !name_start(run[0]) then return -1

    for k in 0..<run.len
        if run[k] == u8('$') && !guarded_at(run, k)
            if k == 0 || run[k - 1] == u8('.') || k + 1 >= run.len then return -1

            return isize(k)

    -1
end key_separator

// Whether a `.private` begins at `k` -- the one thing a dotted run with no `$` in it may need
// taken out.
private slot_at(bytes: []const u8, k: usize) -> bool
    val mark = ".private"

    if k + mark.bytes.len > bytes.len then return false

    for j in 0..<mark.bytes.len
        if bytes[k + j] != mark.bytes[j] then return false

    true
end slot_at

// Whether the `$` at `k` is the start of a `$24`, a dollar the name held rather than a separator.
private guarded_at(run: []const u8, k: usize) -> bool =
    k + 2 < run.len && run[k + 1] == u8('2') && run[k + 2] == u8('4')

// A run with each `$24` turned back into the `$` it stands for.
private push_unguarded(out: *Buf[u8], run: []const u8)
    var k: usize = 0

    while k < run.len
        if run[k] == u8('$') && guarded_at(run, k)
            out.push(u8('$'))
            k += 3
        else
            out.push(run[k])
            k += 1
end push_unguarded

// A member name with a file-private slot taken out of its middle -- `P.private1.get` is `P.get`;
// `spelled_key` has already taken the ones at the end.
private drop_private_slots(name: string) -> string
    val bytes = name.bytes
    var out: Buf[u8] = buf()
    var start: usize = 0
    var k: usize = 0

    while k <= bytes.len
        if k == bytes.len || bytes[k] == u8('.')
            val segment = from_utf8_unchecked(bytes[start..<k])

            if start == 0 || !private_slot(segment)
                if start > 0 then out.push(u8('.'))

                for b in segment.bytes
                    out.push(b)

            start = k + 1

        k += 1

    from_utf8_unchecked(out.view())
end drop_private_slots

private key_byte(b: u8) -> bool =
    c_letter(b) || c_digit(b) || b == u8('_') || b == u8('.') || b == u8('$') || b == u8('-')

private name_start(b: u8) -> bool = c_letter(b) || b == u8('_')

private last_dot(key: string) -> isize
    val bytes = key.bytes
    var at: isize = -1

    for i in 0..<bytes.len
        if bytes[i] == u8('.') then at = isize(i)

    at
end last_dot

private all_digits(s: string) -> bool
    val bytes = s.bytes

    if bytes.len == 0 then return false

    for i in 0..<bytes.len
        if bytes[i] < u8('0') || bytes[i] > u8('9') then return false

    true
end all_digits

private private_slot(s: string) -> bool
    val bytes = s.bytes
    val head = "private"

    if bytes.len <= head.bytes.len then return false

    for i in 0..<head.bytes.len
        if bytes[i] != head.bytes[i] then return false

    all_digits(from_utf8_unchecked(bytes[head.bytes.len..<bytes.len]))
end private_slot

// Whether a spelling is one a C declaration could use: a letter or `_`, then letters, digits and
// `_`, all of them ASCII.
c_identifier(s: string) -> bool
    val bytes = s.bytes

    if bytes.len == 0 then return false

    if !c_letter(bytes[0]) && bytes[0] != u8('_') then return false

    for i in 1..<bytes.len
        if !c_letter(bytes[i]) && !c_digit(bytes[i]) && bytes[i] != u8('_') then return false

    true
end c_identifier

private c_letter(b: u8) -> bool =
    (b >= u8('a') && b <= u8('z')) || (b >= u8('A') && b <= u8('Z'))

private c_digit(b: u8) -> bool = b >= u8('0') && b <= u8('9')
