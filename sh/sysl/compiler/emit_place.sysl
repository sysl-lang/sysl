module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.math.bigint.{BigInt, from_int, mul, pow, sub}

// **Where a value lives**, and the walks that reach it.
//
// A place bottoms out either in a local's stack slot or in a pointer the program already holds, so
// the field chain is walked with `getelementptr` rather than read out with `extractvalue`. What a
// computed value gets instead is a slot of its own, which is the one case that is not a place at
// all and is only ever reached on the way to a read.

// Whether an access through this storage reaches the device rather than a register the back end may
// keep for itself.
access_of(t: Type) -> IrAccess = if volatile_in(t) then AccVolatile else AccPlain

// The same asked of the node a place came from.
place_access(x: TExpr) -> IrAccess = access_of(place_ty(x))

// The type the storage behind a place is declared at, which is not always the type of the values
// read out of it -- a qualifier lives on the storage, and a read through it yields a plain value.
// So this asks what the storage was **declared** as rather than what the node's type is.
place_ty(x: TExpr) -> Type = *x.kind match
    TDeref(operand, t) -> pointee(texpr_type(operand)).unwrap_or(t)
    TIndex(receiver, _, t) -> element(texpr_type(receiver)).unwrap_or(t)
    TField(receiver, i, t) -> underlying(texpr_type(receiver)) match
        Struct(d) -> if i >= 0 && usize(i) < d.fields.len() then d.fields.at(usize(i)).1 else t
        _ -> t
    _ -> texpr_type(x)

// The address of a place, as a `ptr` register or an existing slot name.
address(e: *Emit, place: TExpr) -> Val = *place.kind match
    TLoad(name, _) -> VReg(s"$name.addr")

    // A `val`'s storage is the global itself, so its address needs no instruction to compute -- it
    // is what makes indexing one reach into the table rather than copy it out first.
    TGlobal(symbol, _, _) -> VGlobal(symbol)
    TDeref(operand, _) -> payload_addr(e, operand)

    // A zero-sized field occupies nothing, so it is wherever its receiver is: the address is never
    // read or written through, and handing back the receiver's keeps the walk to it exactly as it is
    // for every other field.
    TField(receiver, index, ty) ->
        if zero_sized(ty) then return address(e, receiver)

        val rty = texpr_type(receiver)

        if bitfield_ranges_of(rty).is_some()
            return gap_at(e, "address of a bitfield")

        val base = address(e, receiver)
        val r = fresh_reg(e)

        var idx: Buf[IrArg] = buf()

        idx.push(ir_arg(l_i32(), VInt(from_int(0))))
        idx.push(ir_arg(l_i32(), VInt(from_int(long(field_slot_of(rty, index))))))
        emit(e, InGep(r, lty(e, rty), base, idx))
        r

    TIndex(receiver, index, _) -> element_addr(e, receiver, index)

    // A computed value has no address of its own, so reaching into one means giving it a slot first.
    _ ->
        val ty = texpr_type(place)
        val slot = alloca(e, fresh_reg(e), lty(e, ty))

        if e.layout.indirect(ty)
            gap_here(e, "a large temporary's address")
        else
            emit(e, InStore(lty(e, ty), gen_expr(e, place), slot, AccPlain, None))

        slot

// Where the `i`th declared field of a receiver lands among the stored ones.
field_slot_of(recv_ty: Type, index: int) -> usize = underlying(recv_ty) match
    Struct(d) -> d.slot(usize(index))
    _ -> usize(index)

// The ranges of the bitfield struct this type is one of, through whatever qualifies it.
bitfield_ranges_of(t: Type) -> Option[Buf[BitRange]] = underlying(t) match
    Struct(d) -> bitfield_ranges(d)
    _ -> None

// What a `&T` points at, which is the payload inside the box rather than the box itself. A `*T`
// addresses its value directly.
payload_addr(e: *Emit, operand: TExpr) -> Val
    val p = gen_expr(e, operand)

    box_payload_addr(e, p, texpr_type(operand))
end payload_addr

// The address of one element, after checking that it exists. An array is indexed from its own
// storage; a view is indexed from the pointer it carries; a `*T` has no length, so no check.
element_addr(e: *Emit, receiver: TExpr, index: TExpr) -> Val
    val rty = texpr_type(receiver)

    val parts = rty match
        Array(n, elem) -> (address(e, receiver), Some(VInt(from_int(long(n)))), *elem)
        Slice(elem, _) -> view_parts(e, receiver, *elem)
        Str -> view_parts(e, receiver, byte_type())
        Ptr(elem) -> (gen_expr(e, receiver), None, *elem)
        other ->
            gap_here(e, s"index into ${type_show(other)}")
            (VUndef, None, int_type())

    val i = widen_index(e, index)

    parts.1 match
        Some(l) -> bounds_check(e, i, l)
        None -> ()

    val r = fresh_reg(e)

    var idx: Buf[IrArg] = buf()

    idx.push(ir_arg(word_lty(e), i))
    emit(e, InGep(r, lty(e, parts.2), parts.0, idx))
    r
end element_addr

// A view's pointer and its length, lifted out of the three words it is.
private view_parts(e: *Emit, receiver: TExpr, elem: Type) -> (Val, Option[Val], Type)
    val wty = lty(e, texpr_type(receiver))
    val v = gen_expr(e, receiver)
    val p = fresh_reg(e)

    emit(e, InExtract(p, wty, v, index_list(1)))

    val l = fresh_reg(e)

    emit(e, InExtract(l, wty, v, index_list(2)))
    (p, Some(l), elem)
end view_parts

index_list(n: int) -> Buf[int]
    var out: Buf[int] = buf()

    out.push(n)
    out
end index_list

// An index brought to the address width. A wider one is checked to fit first, since truncating it
// would turn an index past the end into one inside.
widen_index(e: *Emit, index: TExpr) -> Val = underlying(texpr_type(index)) match
    Integer(bits, signed, _) ->
        if bits <= e.word_bits then convert_int(e, bits, signed, e.word_bits, gen_expr(e, index))
        else
            val v = gen_expr(e, index)
            val wide = LInt(bits)
            val limit = sub(pow(from_int(2), usize(e.word_bits)), from_int(1))
            val fits = fresh_reg(e)

            emit(e, InIntCmp(fits, IUle, wide, v, VInt(limit)))
            trap_unless(e, fits, "bounds")
            convert_int(e, bits, signed, e.word_bits, v)
    other -> gap_at(e, s"index of type ${type_show(other)}")

// Traps unless `i` names an element that exists. The comparison is unsigned at the address width, so
// a negative index arrives as a very large one and fails the same test.
bounds_check(e: *Emit, i: Val, len: Val)
    val ok = fresh_reg(e)

    emit(e, InIntCmp(ok, IUlt, word_lty(e), i, len))
    trap_unless(e, ok, "bounds")
end bounds_check

// -- reading and writing through a place -------------------------------------------------------------

// Where a write to this place goes: a bitfield's **container**, since the field itself has no
// address at all, and the place's own otherwise.
place_addr(e: *Emit, place: TExpr) -> Val = bit_place(place) match
    Some(p) -> address(e, p.0)
    None -> address(e, place)

// A place that is a bit range of a bitfield struct: the receiver holding the container, the struct's
// ranges, and this field's one -- or nothing for every other place, which is nearly all of them.
bit_place(place: TExpr) -> Option[(TExpr, Buf[BitRange], BitRange)] = *place.kind match
    TField(receiver, index, _) -> bitfield_ranges_of(texpr_type(receiver)) match
        Some(ranges) ->
            val s = underlying(texpr_type(receiver)) match
                Struct(d) -> d.slot(usize(index))
                _ -> usize(index)

            Some((receiver, ranges, ranges.at(s)))
        None -> None
    _ -> None

// What is in the place now -- one load of the container and a shift for a bitfield.
load_place(e: *Emit, place: TExpr, p: Val) -> Val = bit_place(place) match
    Some(b) -> read_bits(e, b.1, b.2, load_container(e, b.1, b.0, p))
    None ->
        val t = fresh_reg(e)

        emit(e, InLoad(t, lty(e, texpr_type(place)), p, place_access(place), None))
        t

private load_container(e: *Emit, ranges: Buf[BitRange], receiver: TExpr, addr: Val) -> Val
    val t = fresh_reg(e)

    emit(e, InLoad(t, container_lty(ranges), addr, access_of(place_ty(receiver)), None))
    t
end load_container

// Puts `v` in the place, giving up whatever was there at the address.
store_place(e: *Emit, place: TExpr, p: Val, v: Val) = store_over(e, place, p, v, None)

// The same, where a compound form has already read what was there: the release is of **that** value
// rather than of a second load.
//
// A bitfield needs neither: every field of a bitfield struct is an integer, so nothing there carries
// a count. **Its container is re-read here** rather than reused, because two arms of one statement
// may be two fields of one container and the second has to see what the first left behind.
store_over(e: *Emit, place: TExpr, p: Val, v: Val, cur: Option[Val]) = bit_place(place) match
    Some(b) ->
        val acc = access_of(place_ty(b.0))
        val c = load_container(e, b.1, b.0, p)

        emit(e, InStore(container_lty(b.1), write_bits(e, b.1, b.2, c, v), p, acc, None))
    None ->
        val ty = texpr_type(place)
        val acc = place_access(place)

        cur match
            None -> store_into(e, ty, p, v, acc)
            Some(old) ->
                if contains_counted(ty)
                    retain_value(e, ty, v)
                    emit(e, InStore(lty(e, ty), v, p, acc, None))
                    release_value(e, ty, old)
                else emit(e, InStore(lty(e, ty), v, p, acc, None))

// Writes `v` into the storage at `p`. A slot that holds a count takes one for the value arriving
// and lets go of the one leaving, **in that order**, so assigning something to itself never briefly
// drops the last count.
store_into(e: *Emit, ty: Type, p: Val, v: Val, acc: IrAccess)
    if !contains_counted(ty)
        emit(e, InStore(lty(e, ty), v, p, acc, None))
        return

    // A large aggregate gives its old contents back at the address rather than out of a value read
    // for the purpose: there is nothing to load one into that would not be the whole-aggregate load
    // lowering it through memory exists to avoid.
    if e.layout.indirect(ty) && is_plain(acc)
        retain_value(e, ty, v)
        release_at(e, ty, p)
        emit(e, InStore(lty(e, ty), v, p, AccPlain, None))
        return

    val old = fresh_reg(e)

    emit(e, InLoad(old, lty(e, ty), p, acc, None))
    retain_value(e, ty, v)
    emit(e, InStore(lty(e, ty), v, p, acc, None))
    release_value(e, ty, old)
end store_into

// Whether an access says nothing beyond "read it" -- which is the only one an aggregate written at
// its address may be, since the other two are per-instruction and there is no one instruction here.
private is_plain(acc: IrAccess) -> bool = acc match
    AccPlain -> true
    _ -> false

// -- the bit ranges of a bitfield struct's container --------------------------------------------------

// The bits of a container that this range does **not** occupy, which is what a write has to
// preserve. The range's own bits are a subset of the container's, so taking them away is the same
// answer a complement and an `and` would give.
clear_mask(r: BitRange, bits: int) -> BigInt
    val full = sub(pow(from_int(2), usize(bits)), from_int(1))
    val mine = mul(sub(pow(from_int(2), usize(r.width)), from_int(1)),
                   pow(from_int(2), usize(r.offset)))

    sub(full, mine)
end clear_mask

// The container type a bitfield struct's fields are ranges of.
container_lty(ranges: Buf[BitRange]) -> LType = LInt(bitfield_bits(ranges))

// A field's value at the container's own width, which a field occupying the whole of it already is.
private widened_to(e: *Emit, ranges: Buf[BitRange], r: BitRange, v: Val, ct: LType) -> Val
    if r.width == bitfield_bits(ranges) then return v

    val t = fresh_reg(e)

    emit(e, InCast(t, CastZExt, LInt(r.width), v, ct))
    t
end widened_to

// The container with this range's bits at the bottom.
private shifted_down(e: *Emit, r: BitRange, c: Val, ct: LType) -> Val
    if r.offset == 0 then return c

    val t = fresh_reg(e)

    emit(e, InBin(t, OpLShr, ct, c, VInt(from_int(long(r.offset)))))
    t
end shifted_down

// A field's value widened to the container and shifted to where it belongs.
place_bits(e: *Emit, ranges: Buf[BitRange], r: BitRange, v: Val) -> Val
    val ct = container_lty(ranges)

    val wide = widened_to(e, ranges, r, v, ct)

    if r.offset == 0 then return wide

    val t = fresh_reg(e)

    emit(e, InBin(t, OpShl, ct, wide, VInt(from_int(long(r.offset)))))
    t
end place_bits

// One range lifted out of the container. No sign fixup is needed and none is emitted: an `i5` field
// *is* an LLVM `i5`, so truncating the shifted container to the field's own width lands the
// two's-complement value already in place.
read_bits(e: *Emit, ranges: Buf[BitRange], r: BitRange, c: Val) -> Val
    val ct = container_lty(ranges)

    val shifted = shifted_down(e, r, c, ct)

    if r.width == bitfield_bits(ranges) then return shifted

    val t = fresh_reg(e)

    emit(e, InCast(t, CastTrunc, ct, shifted, LInt(r.width)))
    t
end read_bits

// The container `c` with one range replaced by `v` -- the read-modify-write a bitfield write is,
// with the read already done by the caller.
write_bits(e: *Emit, ranges: Buf[BitRange], r: BitRange, c: Val, v: Val) -> Val
    val ct = container_lty(ranges)
    val bits = bitfield_bits(ranges)
    val shifted = place_bits(e, ranges, r, v)

    // A field occupying the whole container has nothing to preserve.
    if r.width == bits then return shifted

    val clear = clear_mask(r, bits)
    val cleared = fresh_reg(e)

    emit(e, InBin(cleared, OpAnd, ct, c, VInt(clear)))

    val merged = fresh_reg(e)

    emit(e, InBin(merged, OpOr, ct, cleared, shifted))
    merged
end write_bits

// A whole container built from one value per field, which is what constructing a bitfield struct is.
// It ors the placed ranges together rather than folding a write over a zero, because there is
// nothing to preserve: every bit of the result is being written.
build_bits(e: *Emit, ranges: Buf[BitRange], vals: Buf[Val]) -> Val
    val ct = container_lty(ranges)

    // **Every range is placed before any of them is ored in.** The two phases are what the register
    // numbering says: the shifts belong to the fields and the ors to the container, and interleaving
    // them numbers the whole expression differently.
    var placed: Buf[Val] = buf()

    for i in 0..<vals.len()
        placed.push(place_bits(e, ranges, ranges.at(i), vals.at(i)))

    var acc: Option[Val] = None

    for i in 0..<placed.len()
        acc = acc match
            None -> Some(placed.at(i))
            Some(prev) ->
                val t = fresh_reg(e)

                emit(e, InBin(t, OpOr, ct, prev, placed.at(i)))
                Some(t)

    acc match
        Some(v) -> v
        None -> VInt(from_int(0))
end build_bits

// -- taking a view of some of what a place holds ------------------------------------------------------

// The dereference a place walk bottoms out at, following **receivers only**.
private spine_root(place: TExpr) -> Option[TExpr] = *place.kind match
    TField(r, _, _) -> spine_root(r)
    TIndex(r, _, _) -> underlying(texpr_type(r)) match
        Array(_, _) -> spine_root(r)
        _ -> None
    TDeref(_, _) -> Some(place)
    _ -> None

// Whatever keeps an array place's storage alive where the place is not rooted at a reference: the
// buffer a promotion moved it to, or nothing at all for storage on the frame.
//
// A `ref` names storage it did not declare, so the box belongs to whatever its place was rooted at.
// Without this step a view taken through a ref would own nothing, and the buffer the array was
// promoted into would be released while the view still pointed into it.
private promoted_owner(e: *Emit, base: TExpr) -> Val = *base.kind match
    TLoad(name, _) ->
        for i in 0..<e.promoted_boxes.len()
            if e.promoted_boxes.at(i).0 == name then return e.promoted_boxes.at(i).1

        for i in 0..<e.ref_places.len()
            if e.ref_places.at(i).0 == name then return promoted_owner(e, e.ref_places.at(i).1)

        VNull
    TIndex(r, _, _) -> promoted_owner(e, r)
    _ -> VNull

// The address of an array place together with whatever keeps its storage alive: the box it lives
// inside, the buffer a promotion moved it to, or nothing at all for storage on the frame.
//
// A place rooted at a **counted reference** is the box's, so the reference is evaluated once here and
// the walk to the field continues from the payload it addresses -- which is what lets a view of a
// fixed array inside a `&Struct` name that box as its owner. Reaching for it structurally rather than
// watching what the ordinary walk happened to compute is what keeps a `&Struct` inside another one
// honest: the box that owns the storage is the **innermost** one on the chain, and the ordinary walk
// evaluates the outermost first.
address_owned(e: *Emit, place: TExpr) -> (Val, Val)
    val root = spine_root(place)

    if root.is_some()
        *root.unwrap().kind match
            TDeref(operand, inner) ->
                if is_counted_ref(texpr_type(operand))
                    val box = gen_expr(e, operand)
                    val at = fresh_reg(e)

                    var idx: Buf[IrArg] = buf()

                    idx.push(ir_arg(l_i32(), VInt(from_int(0))))
                    idx.push(ir_arg(l_i32(), VInt(from_int(long(header_fields())))))
                    emit(e, InGep(at, box_lty(e, inner), box, idx))
                    return (box, address_under(e, place, root.unwrap(), at))
            _ -> ()

    (promoted_owner(e, place), address(e, place))
end address_owned

// The rest of a place walk, once its root has been evaluated and reached. Every step is the one
// `address` takes; what differs is only where the chain starts.
private address_under(e: *Emit, place: TExpr, root: TExpr, at: Val) -> Val
    if same_node(place, root) then return at

    *place.kind match
        TField(r, index, ty) ->
            if zero_sized(ty) then return address_under(e, r, root, at)

            val rty = texpr_type(r)
            val base = address_under(e, r, root, at)
            val x = fresh_reg(e)

            var idx: Buf[IrArg] = buf()

            idx.push(ir_arg(l_i32(), VInt(from_int(0))))
            idx.push(ir_arg(l_i32(), VInt(from_int(long(field_slot_of(rty, index))))))
            emit(e, InGep(x, lty(e, rty), base, idx))
            x

        TIndex(r, index, _) ->
            val parts = underlying(texpr_type(r)) match
                Array(n, elem) -> (long(n), *elem)
                _ -> (long(0), int_type())
            val base = address_under(e, r, root, at)
            val i = widen_index(e, index)

            bounds_check(e, i, VInt(from_int(parts.0)))

            val x = fresh_reg(e)

            var idx: Buf[IrArg] = buf()

            idx.push(ir_arg(word_lty(e), i))
            emit(e, InGep(x, lty(e, parts.1), base, idx))
            x

        _ -> address(e, place)
end address_under

// Whether the operand of a dereference is a counted reference, which is what makes the box behind it
// the owner of everything the place reaches.
private is_counted_ref(t: Type) -> bool = t match
    Ref(_, _) -> true
    _ -> false

// Whether two nodes are the same occurrence, which a span answers here where the reference compares
// by identity.
private same_node(a: TExpr, b: TExpr) -> bool = a.span == b.span && texpr_kind_name(a) == texpr_kind_name(b)

// **Takes a view of some of an array's, a slice's, or a string's elements.** The base is evaluated
// once and gives up three things -- what keeps the elements alive, where the first of them is, and
// how many there are -- and the view is built by narrowing the last two and taking a share of the
// first.
gen_slice(e: *Emit, base: TExpr, lo: Option[TExpr], hi: Option[TExpr], inclusive: bool,
          slice_ty: Type) -> Val
    val elem = element(slice_ty).unwrap_or(byte_type())
    val parts = slice_base(e, base)
    val owner = parts.0
    val first = parts.1
    val len = parts.2

    val start = lo match
        Some(l) -> widen_index(e, l)
        None -> VInt(from_int(0))

    // The check is on the half-open interval the view ends up naming. An inclusive high end
    // additionally has to name an element that exists, which is also what stops `hi + 1` from
    // wrapping past the end.
    val end = hi match
        None -> len.unwrap_or(VUndef)
        Some(h) ->
            val v = widen_index(e, h)

            if !inclusive then v
            else
                len match
                    Some(l) ->
                        val within = fresh_reg(e)

                        emit(e, InIntCmp(within, IUlt, word_lty(e), v, l))
                        trap_unless(e, within, "bounds")
                    None -> ()

                val one = fresh_reg(e)

                emit(e, InBin(one, OpAdd, word_lty(e), v, VInt(from_int(1))))
                one

    if hi.is_some() && !inclusive
        len match
            Some(l) ->
                val fits = fresh_reg(e)

                emit(e, InIntCmp(fits, IUle, word_lty(e), end, l))
                trap_unless(e, fits, "bounds")
            None -> ()

    val ordered = fresh_reg(e)

    emit(e, InIntCmp(ordered, IUle, word_lty(e), start, end))
    trap_unless(e, ordered, "bounds")

    // A substring has to be a string, so both ends must fall between characters. This runs after the
    // bounds checks, which is what makes reading the byte at either end safe.
    if slice_ty == Str
        len match
            Some(l) ->
                trap_unless(e, str_boundary(e, first, l, start), "boundary")
                trap_unless(e, str_boundary(e, first, l, end), "boundary")
            None -> ()

    val p = fresh_reg(e)

    var idx: Buf[IrArg] = buf()

    idx.push(ir_arg(word_lty(e), start))
    emit(e, InGep(p, lty(e, elem), first, idx))

    val n = fresh_reg(e)

    emit(e, InBin(n, OpSub, word_lty(e), end, start))

    var args: Buf[IrArg] = buf()

    args.push(ir_arg(LPtr, owner))
    emit(e, ir_call(None, LVoid, VGlobal("arc.retain_maybe"), args))

    e.maybe_heap = true
    e.heap = true

    val lt = lty(e, slice_ty)
    val with_owner = fresh_reg(e)

    emit(e, InInsert(with_owner, lt, VZero, LPtr, owner, index_list(0)))

    val with_ptr = fresh_reg(e)

    emit(e, InInsert(with_ptr, lt, with_owner, LPtr, p, index_list(1)))

    val whole = fresh_reg(e)

    emit(e, InInsert(whole, lt, with_ptr, word_lty(e), n, index_list(2)))
    own_temp(e, whole, slice_ty)
end gen_slice

// What a slice's base gives up: what keeps the elements alive, where the first of them is, and how
// many there are -- which a `*T` region does not know.
private slice_base(e: *Emit, base: TExpr) -> (Val, Val, Option[Val]) = texpr_type(base) match
    Ref(inner, _) -> underlying(*inner) match
        Array(n, _) ->
            val r = gen_expr(e, base)
            val p = fresh_reg(e)

            var idx: Buf[IrArg] = buf()

            idx.push(ir_arg(l_i32(), VInt(from_int(0))))
            idx.push(ir_arg(l_i32(), VInt(from_int(long(header_fields())))))
            emit(e, InGep(p, box_lty(e, *inner), r, idx))
            (r, p, Some(VInt(from_int(long(n)))))
        other ->
            gap_here(e, s"slice of ${type_show(other)}")
            (VNull, VUndef, None)

    Slice(_, _) -> view_base(e, base)
    Str -> view_base(e, base)

    // Storage this frame owns, storage inside a box the walk went through, or a `*T` region. A
    // frame-backed array has no owner, so counting it is a no-op -- unless the escape analysis moved
    // it to the heap, in which case the buffer it moved into is exactly what a view of it must count
    // against. Nothing makes a `*T` region safe; that is what `*T` is.
    Array(n, _) ->
        val owned = address_owned(e, base)

        (owned.0, owned.1, Some(VInt(from_int(long(n)))))

    Ptr(inner) -> underlying(*inner) match
        Array(n, _) -> (VNull, gen_expr(e, base), Some(VInt(from_int(long(n)))))

        // A `*T` region: no owner to count and no length to check the end against. The analyzer has
        // already insisted the end be written, since there is nothing here to supply one.
        _ -> (VNull, gen_expr(e, base), None)

    other ->
        gap_here(e, s"slice of ${type_show(other)}")
        (VNull, VUndef, None)

private view_base(e: *Emit, base: TExpr) -> (Val, Val, Option[Val])
    val wty = lty(e, texpr_type(base))
    val v = gen_expr(e, base)
    val o = fresh_reg(e)

    emit(e, InExtract(o, wty, v, index_list(0)))

    val p = fresh_reg(e)

    emit(e, InExtract(p, wty, v, index_list(1)))

    val l = fresh_reg(e)

    emit(e, InExtract(l, wty, v, index_list(2)))
    (o, p, Some(l))
end view_base
