module sh.sysl.compiler

import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}
import sysl.math.bigint.from_int

// **Automatic reference counting**: where a count is taken, where it is given back, and what the
// heap object looks like while it is held.
//
// The placement is uniform rather than clever, because that is what makes it checkable -- every
// named slot holds one count, every temporary holds one until its region ends, and every function
// retains its parameters and returns its result with a count already taken. Nothing here elides a
// redundant pair; that is a later pass over the same placement.

// Where a box's own contents begin, once the three header words -- the strong count, the
// destruction hook and the weak count -- are behind them. A buffer's element count sits here and
// its elements one further on.
header_fields() -> int = 3

// -- taking and giving back a share ----------------------------------------------------------------

// Takes a share of everything a value refers to. A bare reference is one refcount; an aggregate
// delegates to a per-type helper that walks its reference-carrying fields.
retain_value(e: *Emit, ty: Type, v: Val) = arc_value(e, ty, v, true)

// Gives back a share of everything a value refers to.
release_value(e: *Emit, ty: Type, v: Val) = arc_value(e, ty, v, false)

private arc_value(e: *Emit, ty: Type, v: Val, retain: bool) = ty match
    // A `&Trait` counts exactly as the `&T` it was made from does: the box carries its own
    // destructor, so letting go of one needs no more knowledge of the payload than this has.
    Ref(inner, sync) ->
        e.heap = true

        if sync then e.sync_heap = true

        val subject = if is_trait(*inner) then erased_box(e, v) else v

        arc_call(e, s"arc.${if retain then "retain" else "release"}${if sync then "_sync" else ""}",
                 subject)
    Weak(inner) ->
        e.weak_heap = true

        val subject = if is_trait(*inner) then erased_box(e, v) else v

        arc_call(e, s"arc.weak_${if retain then "retain" else "release"}", subject)
    Slice(_, _) ->
        arc_call(e, s"arc.${if retain then "retain" else "release"}_maybe", view_owner(e, ty, v))
    Str ->
        arc_call(e, s"arc.${if retain then "retain" else "release"}_maybe", view_owner(e, ty, v))
    _ ->
        if contains_counted(ty)
            val name = value_helper(e, ty, retain)

            var args: Buf[IrArg] = buf()

            args.push(ir_arg(lty(e, ty), v))
            emit(e, ir_call(None, LVoid, VGlobal(name), args))

private arc_call(e: *Emit, name: string, p: Val)
    var args: Buf[IrArg] = buf()

    args.push(ir_arg(LPtr, p))
    emit(e, ir_call(None, LVoid, VGlobal(name), args))
end arc_call

// The box a counted trait object holds, which is its second word -- the first is the method table,
// a constant that owns nothing.
erased_box(e: *Emit, v: Val) -> Val
    val b = fresh_reg(e)

    emit(e, InExtract(b, l_fat(), v, index_list(1)))
    b
end erased_box

// The owner word of a view -- the reference that keeps its elements alive, or null when they are
// static (every string literal), on a frame, or reached through a `*T`.
view_owner(e: *Emit, ty: Type, v: Val) -> Val
    e.heap = true
    e.maybe_heap = true

    val o = fresh_reg(e)

    emit(e, InExtract(o, lty(e, ty), v, index_list(0)))
    o
end view_owner

// Takes a share of everything the value **at an address** refers to, and gives one back.
//
// The pair exists for a type the layout calls large, which never becomes a first-class value: there
// is nothing to hand `retain_value`, and loading one so that there were would undo the whole point
// of lowering it through memory. Everything smaller is read out and walked as before, so the two
// forms agree on what they count -- only on where they read it from.
// The retaining half is what a **large** parameter takes at entry, where the value never exists as a
// register to hand the value form.
retain_at(e: *Emit, ty: Type, p: Val) = walk_at(e, ty, p, true)

release_at(e: *Emit, ty: Type, p: Val) = walk_at(e, ty, p, false)

private walk_at(e: *Emit, ty: Type, p: Val, retain: bool)
    if !contains_counted(ty) then return

    if e.layout.indirect(ty)
        val name = slot_helper(e, ty, retain)

        arc_call(e, name, p)
        return

    val v = fresh_reg(e)

    emit(e, InLoad(v, lty(e, ty), p, AccPlain, None))
    arc_value(e, ty, v, retain)
end walk_at

// -- the helpers a walk becomes ----------------------------------------------------------------------

// The retain / release helper an aggregate takes as a value, and the one it takes at its address.
// Emitted once per type rather than inlined, since a data enum needs a tag test per
// reference-carrying variant.
private value_helper(e: *Emit, ty: Type, retain: bool) -> string
    val name = s"arc.${if retain then "copy" else "dispose"}.${mangle(ty)}"

    request_helper(e, name, HrValue(ty, retain))
end value_helper

private slot_helper(e: *Emit, ty: Type, retain: bool) -> string
    val name = s"arc.${if retain then "copy_at" else "dispose_at"}.${mangle(ty)}"

    request_helper(e, name, HrSlot(ty, retain))
end slot_helper

// Asks for a helper once, and hands back the name -- which is what a caller wants, since it asked in
// order to call the thing. Generating one may ask for another, so it is a queue rather than a
// recursion: nothing is built until every body is.
request_helper(e: *Emit, name: string, what: HelperReq) -> string
    for i in 0..<e.requested.len()
        if e.requested.at(i) == name then return name

    e.requested.push(name)
    e.queue.push(what)
    name
end request_helper

// A runtime helper's signature: `private`, `void`, and parameters named as the body reads them.
//
// Every helper the ownership runtime writes has this shape, which is not a coincidence -- a helper
// is reached only from emitted code, so nothing outside may name it, and it works through the
// addresses it is handed rather than answering with anything.
helper_sig(name: string, params: Buf[(string, LType)]) -> IrFuncSig
    var ps: Buf[IrParam] = buf()

    for i in 0..<params.len()
        ps.push(IrParam(params.at(i).1, no_ir_attrs(), Some(VReg(params.at(i).0))))

    var attrs: Buf[(string, string)] = buf()

    IrFuncSig(name, ir_fn_type(LVoid, ps), LinkPrivate, None, attrs, None)
end helper_sig

private one_param(name: string, ty: LType) -> Buf[(string, LType)]
    var out: Buf[(string, LType)] = buf()

    out.push((name, ty))
    out
end one_param

private hook_params() -> Buf[(string, LType)]
    var out: Buf[(string, LType)] = buf()

    out.push(("p", LPtr))
    out.push(("storage", l_i1()))
    out
end hook_params

// -- the walks themselves -------------------------------------------------------------------------

// Walks the reference-carrying fields of an aggregate **value**, reaching each with `extractvalue`.
//
// A zero-sized field holds no reference, so it is skipped by the test already -- but the index has
// to be the slot it landed in rather than the one it was written at, or a field after one would be
// walked at the wrong offset.
private each_value(e: *Emit, fields: Buf[(string, Type)], aggregate: LType, value: Val, retain: bool)
    for i in 0..<fields.len()
        val fty = fields.at(i).1

        if contains_counted(fty)
            val f = fresh_reg(e)

            emit(e, InExtract(f, aggregate, value, index_list(int(field_slot(fields, i)))))
            arc_value(e, fty, f, retain)
end each_value

// The same over an aggregate at an address, reaching each member with `getelementptr` instead of
// lifting it out of an aggregate the caller would have had to materialize first.
private each_slot(e: *Emit, fields: Buf[(string, Type)], aggregate: LType, base: Val, retain: bool)
    for i in 0..<fields.len()
        val fty = fields.at(i).1

        if contains_counted(fty)
            val f = fresh_reg(e)

            var idx: Buf[IrArg] = buf()

            idx.push(ir_arg(l_i32(), VInt(from_int(0))))
            idx.push(ir_arg(l_i32(), VInt(from_int(long(field_slot(fields, i))))))
            emit(e, InGep(f, aggregate, base, idx))
            walk_at(e, fty, f, retain)
end each_slot

// The body of `arc.copy.T` / `arc.dispose.T`: the walk over a value of `T` held in `%v`.
private walk_value(e: *Emit, ty: Type, v: Val, retain: bool) = underlying(ty) match
    Struct(d) -> each_value(e, d.fields, struct_lty(d), v, retain)

    // An array is walked with a loop rather than an unrolled chain: the element count is a
    // compile-time constant, but it can be very large, and the code for one element is not.
    Array(n, elem) ->
        val holder = alloca(e, fresh_reg(e), lty(e, ty))

        emit(e, InStore(lty(e, ty), v, holder, AccPlain, None))
        arc_array(e, *elem, holder, VInt(from_int(long(n))), retain, true)

    Enum(d) ->
        val tag = fresh_reg(e)

        emit(e, InExtract(tag, enum_lty(d), v, index_list(0)))
        arc_enum(e, d, tag, v, VNothing, retain, false)

    _ -> ()

// The body of `arc.copy_at.T` / `arc.dispose_at.T`: the walk over a `T` at `%p`.
private walk_slot(e: *Emit, ty: Type, p: Val, retain: bool) = underlying(ty) match
    Struct(d) -> each_slot(e, d.fields, struct_lty(d), p, retain)

    Array(n, elem) -> arc_array(e, *elem, p, VInt(from_int(long(n))), retain, false)

    Enum(d) ->
        val tag = fresh_reg(e)

        emit(e, InLoad(tag, l_i32(), p, AccPlain, None))
        arc_enum(e, d, tag, VNothing, p, retain, true)

    _ -> ()

// The loop an array's elements are walked with, whether they are read out of storage or walked in
// place.
private arc_array(e: *Emit, elem: Type, data: Val, n: Val, retain: bool, by_value: bool)
    val i = alloca(e, fresh_reg(e), word_lty(e))

    emit(e, InStore(word_lty(e), VInt(from_int(0)), i, AccPlain, None))

    val cond_l = fresh_label(e, "arc.each")
    val body_l = fresh_label(e, "arc.elem")
    val end_l = fresh_label(e, "arc.done")

    emit_term(e, InBr(cond_l))
    emit_label(e, cond_l)

    val iv = fresh_reg(e)

    emit(e, InLoad(iv, word_lty(e), i, AccPlain, None))

    val more = fresh_reg(e)

    emit(e, InIntCmp(more, IUlt, word_lty(e), iv, n))
    emit_term(e, InCondBr(more, body_l, end_l))
    emit_label(e, body_l)

    val ep = fresh_reg(e)

    var idx: Buf[IrArg] = buf()

    idx.push(ir_arg(word_lty(e), iv))
    emit(e, InGep(ep, lty(e, elem), data, idx))

    if by_value
        val ev = fresh_reg(e)

        emit(e, InLoad(ev, lty(e, elem), ep, AccPlain, None))
        arc_value(e, elem, ev, retain)
    else
        walk_at(e, elem, ep, retain)

    val nxt = fresh_reg(e)

    emit(e, InBin(nxt, OpAdd, word_lty(e), iv, VInt(from_int(1))))
    emit(e, InStore(word_lty(e), nxt, i, AccPlain, None))
    emit_term(e, InBr(cond_l))
    emit_label(e, end_l)
end arc_array

// The tag test per reference-carrying variant, and the walk over that variant's payload.
private arc_enum(e: *Emit, d: &EnumType, tag: Val, value: Val, p: Val, retain: bool, at: bool)
    val end_l = fresh_label(e, "arc.done")

    for i in 0..<d.variants.len()
        val variant = d.variants.at(i)

        if fields_hold_counted(variant.fields)
            val hit_l = fresh_label(e, "arc.variant")
            val next_l = fresh_label(e, "arc.next")
            val is = fresh_reg(e)

            emit(e, InIntCmp(is, IEq, l_i32(), tag, VInt(from_int(long(variant.tag)))))
            emit_term(e, InCondBr(is, hit_l, next_l))
            emit_label(e, hit_l)

            if at then each_slot(e, variant.fields, variant_lty(d, variant), payload_ptr(e, d, p),
                                 retain)
            else each_value(e, variant.fields, variant_lty(d, variant),
                            enum_payload(e, d, variant, value), retain)

            emit_term(e, InBr(end_l))
            emit_label(e, next_l)

    emit_term(e, InBr(end_l))
    emit_label(e, end_l)
end arc_enum

// Whether any field of a variant carries a count, which is what says the variant needs a test.
private fields_hold_counted(fields: Buf[(string, Type)]) -> bool
    for i in 0..<fields.len()
        if contains_counted(fields.at(i).1) then return true

    false
end fields_hold_counted

// -- the boxes -------------------------------------------------------------------------------------

// The LLVM type of the box that holds a `T` on the heap: the two counts, the deallocation hook, and
// the payload.
box_lty(e: *Emit, payload: Type) -> LType
    e.heap = true

    val n = s"%arc.${mangle(payload)}"

    remember_box(&e.boxes, n, payload)
    LNamed(n)
end box_lty

// The box that holds elements the program sized while running: the refcount, the deallocation hook,
// how many elements there are, and then the elements. The count has to be *in* the box because the
// hook is what destroys them and the hook is reached with no static type in sight.
buf_lty(e: *Emit, elem: Type) -> LType
    e.heap = true

    val n = s"%arc.buf.${mangle(elem)}"

    remember_box(&e.bufs, n, elem)
    LNamed(n)
end buf_lty

private remember_box(into: *Buf[(string, Type)], name: string, ty: Type)
    for i in 0..<into.len()
        if into.at(i).0 == name then return

    into.push((name, ty))
end remember_box

// The function that destroys a box of this payload type: it lets go of whatever the payload holds
// and then returns the storage. Installed in the box at construction, which is what makes releasing
// a reference type-erased -- a slice's owner has no static type to consult.
drop_fn(e: *Emit, payload: Type) -> Val
    // A type with a destructor needs a hook of its own even when nothing in it is counted: the walk
    // has nothing to do and the `drop` still has to be called, so the plain hook -- which is shared
    // by every payload that holds nothing -- cannot serve.
    if !contains_counted(payload) && destructor_of(e, payload).is_none() then return plain_drop_fn(e)

    VGlobal(request_helper(e, s"arc.drop.${mangle(payload)}", HrDrop(payload)))
end drop_fn

// The function that destroys a buffer of this element type. Elements that hold nothing need no
// walk, so the plain hook is enough -- it still gives the bytes back, which is the phase every box
// needs whatever it holds.
drop_buf_fn(e: *Emit, elem: Type) -> Val
    if !contains_counted(elem) then return plain_drop_fn(e)

    VGlobal(request_helper(e, s"arc.dropbuf.${mangle(elem)}", HrDropBuf(elem)))
end drop_buf_fn

// The hook for a box whose payload holds nothing: there is no walk to make, so the only phase that
// does anything is the one that gives the storage back.
//
// One per module rather than one per payload type, because nothing in it depends on the payload --
// which keeps the commonest box of all, the one holding a plain number, from costing a function.
plain_drop_fn(e: *Emit) -> Val = VGlobal(request_helper(e, "arc.drop.plain", HrPlainDrop))

// The destructor a type is filed under, where it has one.
destructor_of(e: *Emit, t: Type) -> Option[string]
    val key = mangle(t)

    for i in 0..<e.destructors.len()
        if e.destructors.at(i).0 == key then return Some(e.destructors.at(i).1)

    None
end destructor_of

// -- generating a helper ----------------------------------------------------------------------------

// One queued helper, built. The queue may grow while this runs -- a destructor releases the
// references its payload holds -- which is why the drain that calls this reads its length again
// each time round.
gen_helper(e: *Emit, what: HelperReq, name: string) -> Option[IrFunc]
    start_function(e)
    push_temps(e)
    push_owned(e)

    val sig = what match
        HrValue(ty, _) -> helper_sig(name, one_param("v", lty(e, ty)))
        HrSlot(_, _) -> helper_sig(name, one_param("p", LPtr))
        HrDrop(_) -> helper_sig(name, hook_params())
        HrDropBuf(_) -> helper_sig(name, hook_params())
        HrPlainDrop -> helper_sig(name, hook_params())

        // A hand-written block is text rather than a function: the drain writes it down as it
        // stands, so nothing brings one here.
        HrText(_) -> helper_sig(name, hook_params())

        HrAdapter(_, slot) -> adapter_sig(e, name, slot)

    what match
        HrValue(ty, retain) ->
            walk_value(e, ty, VReg("v"), retain)
            emit_term(e, InRet(None, None))
        HrSlot(ty, retain) ->
            walk_slot(e, ty, VReg("p"), retain)
            emit_term(e, InRet(None, None))
        HrDrop(payload) -> gen_drop_hook(e, payload)
        HrDropBuf(elem) -> gen_drop_buf_hook(e, elem)
        HrPlainDrop -> gen_plain_hook(e)
        HrText(_) -> gap_here(e, "a hand-written runtime block asked of the generator")
        HrAdapter(table, slot) -> gen_adapter(e, table, slot)

    if has_gap(e) then return None

    Some(finish_func(e, sig))
end gen_helper

private gen_plain_hook(e: *Emit)
    val give = fresh_label(e, "arc.give")
    val over = fresh_label(e, "arc.over")

    emit_term(e, InCondBr(VReg("storage"), give, over))
    emit_label(e, over)
    emit_term(e, InRet(None, None))
    emit_label(e, give)
    emit_free(e)
    emit_term(e, InRet(None, None))
end gen_plain_hook

private gen_drop_hook(e: *Emit, payload: Type)
    val bn = box_lty(e, payload)
    val give = fresh_label(e, "arc.give")
    val over = fresh_label(e, "arc.over")

    emit_term(e, InCondBr(VReg("storage"), give, over))
    emit_label(e, over)

    val pa = fresh_reg(e)

    var idx: Buf[IrArg] = buf()

    idx.push(ir_arg(l_i32(), VInt(from_int(0))))
    idx.push(ir_arg(l_i32(), VInt(from_int(long(header_fields())))))
    emit(e, InGep(pa, bn, VReg("p"), idx))

    val v = fresh_reg(e)

    emit(e, InLoad(v, lty(e, payload), pa, AccPlain, None))

    // **Before the walk, not after.** The destructor is handed the value as it stands, so it may
    // read a field to close what that field names; releasing first would hand it a value whose
    // references had already been let go of. It takes `self` **borrowed** -- no count is taken for
    // the call -- because the count is already zero and taking one would resurrect the object into
    // a second teardown.
    destructor_of(e, payload) match
        Some(d) ->
            var args: Buf[IrArg] = buf()

            if e.layout.indirect(payload) then args.push(ir_arg(LPtr, pa))
            else args.push(ir_arg(lty(e, payload), v))

            emit(e, ir_call(None, LVoid, VGlobal(d), args))
        None -> ()

    release_value(e, payload, v)
    emit_term(e, InRet(None, None))
    emit_label(e, give)
    emit_free(e)
    emit_term(e, InRet(None, None))
end gen_drop_hook

private gen_drop_buf_hook(e: *Emit, elem: Type)
    val bn = buf_lty(e, elem)
    val give = fresh_label(e, "arc.give")
    val over = fresh_label(e, "arc.over")

    emit_term(e, InCondBr(VReg("storage"), give, over))
    emit_label(e, over)

    val lenp = fresh_reg(e)

    var idx: Buf[IrArg] = buf()

    idx.push(ir_arg(l_i32(), VInt(from_int(0))))
    idx.push(ir_arg(l_i32(), VInt(from_int(long(header_fields())))))
    emit(e, InGep(lenp, bn, VReg("p"), idx))

    val n = fresh_reg(e)

    emit(e, InLoad(n, word_lty(e), lenp, AccPlain, None))

    val data = fresh_reg(e)

    var didx: Buf[IrArg] = buf()

    didx.push(ir_arg(l_i32(), VInt(from_int(0))))
    didx.push(ir_arg(l_i32(), VInt(from_int(long(header_fields() + 1)))))
    emit(e, InGep(data, bn, VReg("p"), didx))
    each_element_release(e, elem, data, n)
    emit_term(e, InRet(None, None))
    emit_label(e, give)
    emit_free(e)
    emit_term(e, InRet(None, None))
end gen_drop_buf_hook

// The one place `free` is **called**. It sits inside a hook, so it reaches a module only where that
// module builds a box -- which is a module that has already called `malloc`, and therefore has an
// allocator to give the bytes back to.
private emit_free(e: *Emit)
    var args: Buf[IrArg] = buf()

    args.push(ir_arg(LPtr, VReg("p")))
    emit(e, ir_call(None, LVoid, VGlobal(free_symbol()), args))
end emit_free

// -- elements a buffer holds --------------------------------------------------------------------------

// Walks `n` elements starting at `data`, letting go of each. A loop rather than a straight line for
// the reason the ARC walk over an array gives: the count is exactly the thing that may be large.
private each_element_release(e: *Emit, elem: Type, data: Val, n: Val)
    val ep = each_element_begin(e, elem, data, n)
    val ev = fresh_reg(e)

    emit(e, InLoad(ev, lty(e, elem), ep.0, AccPlain, None))
    release_value(e, elem, ev)
    each_element_end(e, ep.1, ep.2, ep.3)
end each_element_release

// Puts one value in every one of `n` slots, taking a share for each -- the elements belong to the
// buffer, and it is the hook that eventually lets them go.
fill_elements(e: *Emit, elem: Type, data: Val, n: Val, v: Val)
    val ep = each_element_begin(e, elem, data, n)

    retain_value(e, elem, v)
    emit(e, InStore(lty(e, elem), v, ep.0, AccPlain, None))
    each_element_end(e, ep.1, ep.2, ep.3)
end fill_elements

// The head of an element walk: the counter slot, the test, and the address of the element the body
// is about to work on. It answers with everything the tail needs to close the loop.
each_element_begin(e: *Emit, elem: Type, data: Val, n: Val) -> (Val, Val, Val, string)
    val i = alloca(e, fresh_reg(e), word_lty(e))
    val cond_l = fresh_label(e, "buf.test")
    val body_l = fresh_label(e, "buf.elem")
    val end_l = fresh_label(e, "buf.done")

    emit(e, InStore(word_lty(e), VInt(from_int(0)), i, AccPlain, None))
    emit_term(e, InBr(cond_l))
    emit_label(e, cond_l)

    val iv = fresh_reg(e)

    emit(e, InLoad(iv, word_lty(e), i, AccPlain, None))

    val more = fresh_reg(e)

    emit(e, InIntCmp(more, IUlt, word_lty(e), iv, n))
    emit_term(e, InCondBr(more, body_l, end_l))
    emit_label(e, body_l)

    val ep = fresh_reg(e)

    var idx: Buf[IrArg] = buf()

    idx.push(ir_arg(word_lty(e), iv))
    emit(e, InGep(ep, lty(e, elem), data, idx))
    (ep, i, iv, s"$cond_l|$end_l")
end each_element_begin

// The tail of one: step the counter, go round, and open the block after the loop.
each_element_end(e: *Emit, i: Val, iv: Val, labels: string)
    val parts = split_labels(labels)
    val nxt = fresh_reg(e)

    emit(e, InBin(nxt, OpAdd, word_lty(e), iv, VInt(from_int(1))))
    emit(e, InStore(word_lty(e), nxt, i, AccPlain, None))
    emit_term(e, InBr(parts.0))
    emit_label(e, parts.1)
end each_element_end

private split_labels(s: string) -> (string, string)
    for i in 0..<s.bytes.len
        if s.bytes[i] == u8('|') then return (s[0..<i], s[(i + 1)..<s.bytes.len])

    (s, s)
end split_labels

// -- the payload behind a pointer ----------------------------------------------------------------------

// Where a pointer's pointee actually lives. A `*T` addresses its value directly; a `&T` addresses
// the box, whose payload sits after the refcount and the deallocation hook.
box_payload_addr(e: *Emit, p: Val, ty: Type) -> Val = underlying(ty) match
    Ref(inner, _) ->
        val r = fresh_reg(e)

        var idx: Buf[IrArg] = buf()

        idx.push(ir_arg(l_i32(), VInt(from_int(0))))
        idx.push(ir_arg(l_i32(), VInt(from_int(long(header_fields())))))
        emit(e, InGep(r, box_lty(e, *inner), p, idx))
        r
    _ -> p

// -- ownership regions ---------------------------------------------------------------------------------

// Opens a region for the temporaries an expression owns.
push_temps(e: *Emit)
    e.temp_marks.push(e.temps.len())

// Records a value the expression owns outright -- a fresh box, or a call result, which every
// function returns with a count already taken.
own_temp(e: *Emit, v: Val, ty: Type) -> Val
    if contains_counted(ty) && !e.temp_marks.is_empty() then e.temps.push((v, ty))

    v
end own_temp

// Releases the innermost region's temporaries and pops it.
pop_temps(e: *Emit)
    release_temps(e)
    drop_temps(e)
end pop_temps

// Emits the releases for the innermost region without popping it, and drops the region without
// emitting them -- the pair a caller needs when more than one edge leaves the region and each has
// to let go for itself. An iterating loop is the case: what `next` gave back is released on the way
// into the body and again on the way out of the loop, and those are different blocks.
release_temps(e: *Emit) = release_values(e, temps_here(e))

drop_temps(e: *Emit)
    val mark = e.temp_marks.pop().unwrap_or(0)

    e.temps.truncate(mark)
end drop_temps

// Empties the innermost region without closing it, for an edge that has already emitted its
// releases and must not have them emitted a second time -- while leaving the stack at the height
// every recorded depth was measured against.
clear_temps_here(e: *Emit)
    if e.temp_marks.is_empty() then return

    e.temps.truncate(e.temp_marks.at(e.temp_marks.len() - 1))
end clear_temps_here

// What the innermost temp region holds, for an edge that has to give those counts back somewhere
// other than where the region is closed -- a condition term that branches before it can release,
// because the branch it guards retains out of the very value being held.
temps_here(e: *Emit) -> Buf[(Val, Type)]
    var out: Buf[(Val, Type)] = buf()

    if e.temp_marks.is_empty() then return out

    for i in e.temp_marks.at(e.temp_marks.len() - 1)..<e.temps.len()
        out.push(e.temps.at(i))

    out
end temps_here

// Every value in a list let go of, last taken first.
release_values(e: *Emit, vs: Buf[(Val, Type)])
    for i in 0..<vs.len()
        val v = vs.at(vs.len() - 1 - i)

        release_value(e, v.1, v.0)
end release_values

// Opens a lexical scope: the slots it will own, and the statements it will defer.
push_owned(e: *Emit)
    e.owned_marks.push(e.owned_slots.len())
    e.defer_marks.push(e.defers.len())
end push_owned

// Records a slot that holds a count of its own, after it has been written.
own_slot(e: *Emit, name: string, ty: Type) = own_at(e, VReg(s"$name.addr"), ty)

// The same, for a slot with no name in the program -- the storage a `&value` materializes. The
// scope registered in is the innermost one *at the point the value is written*, which is what makes
// the release land on a path the store dominates.
own_at(e: *Emit, slot: Val, ty: Type)
    if contains_counted(ty) && !e.owned_marks.is_empty() then e.owned_slots.push((slot, ty))

// Registers the buffer a promoted array lives in, so the scope that declared it gives back its
// share on the way out. A buffer is what a `&T` points at, so it is registered as one and the
// ordinary release path emits the `arc.release` -- the only reason it needs a slot of its own is
// that everything owned is a place to load from rather than a value.
//
// The count is what makes promotion work: a view of the array retains this box when it is returned
// or stored, so the release below takes the declaration's share and the storage outlives the frame
// exactly as long as some view of it does.
own_box(e: *Emit, name: string, box: Val, elem: Type)
    emit_alloca(e, VReg(s"$name.box"), LPtr, None)
    emit(e, InStore(LPtr, box, VReg(s"$name.box"), AccPlain, None))

    if !e.owned_marks.is_empty() then e.owned_slots.push((VReg(s"$name.box"), Ref(elem, false)))
end own_box

// Hands a statement to the scope being emitted. Nothing is emitted here -- the `defer` itself costs
// no instruction, and the statement is laid down at each edge that leaves the block.
defer_stmts(e: *Emit, stmts: Buf[TStmt])
    if e.defer_marks.is_empty() then return

    for i in 0..<stmts.len()
        e.defers.push(stmts.at(i))
end defer_stmts

// Emits the releases for the innermost scope without popping it -- the guard-failure path out of a
// match arm, where the bindings have been made but the arm is not taken.
release_owned(e: *Emit) = release_slots(e, owned_here(e))

// What the innermost scope holds, for a path that has to give those counts back somewhere other
// than where the scope ends.
owned_here(e: *Emit) -> Buf[(Val, Type)] = scope_slots(e, e.owned_marks.len() - 1)

// The slots one scope owns, which is the run of them from its own start to the next scope's.
private scope_slots(e: *Emit, k: usize) -> Buf[(Val, Type)]
    var out: Buf[(Val, Type)] = buf()

    if e.owned_marks.is_empty() || k >= e.owned_marks.len() then return out

    val stop = if k + 1 < e.owned_marks.len() then e.owned_marks.at(k + 1) else e.owned_slots.len()

    for i in e.owned_marks.at(k)..<stop
        out.push(e.owned_slots.at(i))

    out
end scope_slots

// The statements one scope deferred, read the same way.
private scope_defers(e: *Emit, k: usize) -> Buf[TStmt]
    var out: Buf[TStmt] = buf()

    if e.defer_marks.is_empty() || k >= e.defer_marks.len() then return out

    val stop = if k + 1 < e.defer_marks.len() then e.defer_marks.at(k + 1) else e.defers.len()

    for i in e.defer_marks.at(k)..<stop
        out.push(e.defers.at(i))

    out
end scope_defers

// Every slot in a list let go of, last written first -- each read back out of its storage, since
// what a scope owns is a place rather than a value.
release_slots(e: *Emit, slots: Buf[(Val, Type)])
    for i in 0..<slots.len()
        val s = slots.at(slots.len() - 1 - i)
        val v = fresh_reg(e)

        emit(e, InLoad(v, lty(e, s.1), s.0, AccPlain, None))
        release_value(e, s.1, v)
end release_slots

// Leaves the innermost scope: what it deferred, then what it owns.
pop_owned(e: *Emit)
    val k = e.owned_marks.len() - 1

    run_deferrals(e, k)
    release_owned(e)

    val slot_mark = e.owned_marks.pop().unwrap_or(0)
    val defer_mark = e.defer_marks.pop().unwrap_or(0)

    e.owned_slots.truncate(slot_mark)
    e.defers.truncate(defer_mark)
end pop_owned

// Runs one scope's deferred statements, last registered first.
//
// They go **before** that scope's releases, so every local the statement names is still alive while
// it runs -- including the one holding the resource it is closing, which is the whole point of the
// form. Registration order is written order, so the walk backwards is the LIFO a `defer` promises.
private run_deferrals(e: *Emit, k: usize)
    val ds = scope_defers(e, k)

    for i in 0..<ds.len()
        gen_stmt(e, ds.at(ds.len() - 1 - i))
end run_deferrals

// Lets go of everything the function holds, for a `return` that leaves from the middle of it.
// Nothing is popped: the block is terminated straight afterwards, so the scopes that follow this one
// lexically emit their own releases into unreachable code and are dropped.
release_all(e: *Emit) = release_down_to(e, 0, 0)

// Lets go of everything accrued since a loop was entered, for a `break`/`continue` that leaves from
// the middle of the body -- the ownership analogue of `release_all`, bounded to the loop's regions
// (whose depths the loop recorded) rather than the whole function.
release_to_depth(e: *Emit, owned_depth: usize, temp_depth: usize) =
    release_down_to(e, owned_depth, temp_depth)

private release_down_to(e: *Emit, owned_depth: usize, temp_depth: usize)
    // The regions are contiguous and outermost-first, so the tail from the bounding region's start
    // walked backwards is every frame innermost-first with each one's own values reversed.
    if temp_depth < e.temp_marks.len()
        var vs: Buf[(Val, Type)] = buf()

        for i in e.temp_marks.at(temp_depth)..<e.temps.len()
            vs.push(e.temps.at(i))

        release_values(e, vs)

    // **The scope indices are fixed before anything runs, and it is load-bearing.** A deferred
    // statement is emitted by `gen_stmt`, and one containing an `if` or a `match` pushes and pops
    // the very regions this is walking -- so which scopes are being left has to be settled before
    // any of them runs.
    var scopes: Buf[usize] = buf()

    for j in 0..<e.owned_marks.len()
        val k = e.owned_marks.len() - 1 - j

        if k >= owned_depth then scopes.push(k)

    // Outward, one scope at a time, each running what it deferred before giving up its counts -- so
    // a statement deferred in an inner block still sees the outer block's locals, which are let go
    // only once the scope that owns them is itself being left.
    for j in 0..<scopes.len()
        run_deferrals(e, scopes.at(j))
        release_slots(e, scope_slots(e, scopes.at(j)))
end release_down_to

// -- what a name's storage is -----------------------------------------------------------------------

// The whole program's promoted temporaries, recorded once for the module.
set_promotions(e: *Emit, promotions: Promotions)
    e.promoted_temps.clear()

    for i in 0..<promotions.temporaries.len()
        e.promoted_temps.push(promotions.temporaries.at(i))
end set_promotions

// The arrays the body about to be lowered must move, which the escape analysis settled.
set_promoted(e: *Emit, names: Buf[string])
    e.promoted.clear()

    for i in 0..<names.len()
        e.promoted.push(names.at(i))
end set_promoted

// Whether the temporary at this span is one given storage of its own. It is the seam a view of a
// whole array literal reads: the escape analysis has already decided, and what is left is for the
// lowering of that view to ask.
is_promoted_temp(e: *Emit, at: Span) -> bool
    for i in 0..<e.promoted_temps.len()
        if e.promoted_temps.at(i) == at then return true

    false
end is_promoted_temp

// Whether an array declared under this name lives in a buffer rather than a slot.
is_promoted(e: *Emit, name: string) -> bool
    for i in 0..<e.promoted.len()
        if e.promoted.at(i) == name then return true

    false
end is_promoted

// The box a promoted array's storage is, where the name has one -- the owner a view of that array
// counts against, which is the other half of the seam above.
promoted_box(e: *Emit, name: string) -> Option[Val]
    for i in 0..<e.promoted_boxes.len()
        if e.promoted_boxes.at(i).0 == name then return Some(e.promoted_boxes.at(i).1)

    None
end promoted_box

// -- what the heap is called -----------------------------------------------------------------------

// The allocator this compilation reaches. A package may name its own pair; nothing here reads a
// package's configuration yet, so both are libc's.
malloc_symbol() -> string = "malloc"

free_symbol() -> string = "free"
