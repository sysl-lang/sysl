module sh.sysl.compiler

import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}
import sysl.math.bigint.from_int
import sysl.text.parse_real

// **The register file.** A vector is a value with no address, so every form here is an instruction
// over registers -- the two exceptions being `load` and `store`, which are the only vector
// operations that reach memory and the only ones that can fail.

// A vector built lane by lane with `insertelement`, which is the array literal's `insertvalue` chain
// in the register file -- and never through a slot, however wide it is: a value that is not storage
// cannot be built in storage. LLVM folds a chain of constant lanes into a literal, so a splat of
// constants costs nothing at run time.
gen_vector_lit(e: *Emit, lanes: Buf[TExpr], vec_ty: Type) -> Val
    var vals: Buf[Val] = buf()

    for item in lanes
        vals.push(gen_expr(e, item))

    val vty = lty(e, vec_ty)
    val ety = lty(e, element(vec_ty).unwrap_or(Unknown))
    var acc: Val = VZero

    for i in 0..<vals.len()
        val r = fresh_reg(e)

        emit(e, InInsertElement(r, vty, acc, ety, vals[i],
                                ir_arg(l_i32(), VInt(from_int(long(i))))))
        acc = r

    acc
end gen_vector_lit

// The splat, in LLVM's own idiom: put the value in lane zero and shuffle it across with an all-zero
// mask. `shufflevector` with a zero mask is the pattern every back end recognises, and it lowers to
// one broadcast instruction where the machine has one.
gen_splat(e: *Emit, value: TExpr, vec_ty: Type) -> Val
    val v = gen_expr(e, value)
    val vty = lty(e, vec_ty)
    val one = fresh_reg(e)

    emit(e, InInsertElement(one, vty, VPoison, lty(e, element(vec_ty).unwrap_or(Unknown)), v,
                            ir_arg(l_i32(), VInt(from_int(0)))))

    val n = repr(vec_ty) match
        Vector(k, _) -> k
        _ -> 0

    val r = fresh_reg(e)

    emit(e, InShuffle(r, vty, one, VPoison, ir_arg(LVec(n, l_i32()), VZero)))
    r
end gen_splat

// A vector's lanes laid into an array, or an array's elements gathered into a vector: one
// `extractelement` and one `insertvalue` per lane, or the other way about. It is never a store of the
// whole register and a load of the array: a `<N>bool` is packed into bits in memory and a `[N]bool`
// is not, and a vector of three lanes is stored as four. Lane by lane says what the conversion is,
// and LLVM merges the chain into whatever moves the machine has.
gen_lanes_as(e: *Emit, value: TExpr, ty: Type) -> Val
    val from = texpr_type(value)
    val v = gen_expr(e, value)
    val to_vector = repr(ty) match
        Vector(_, _) -> true
        _ -> false
    val n = if to_vector then vector_lanes(ty) else vector_lanes(from)
    val (fty, tty) = (lty(e, from), lty(e, ty))
    val ety = lty(e, element(repr(ty)).unwrap_or(Unknown))
    var acc: Val = VZero

    for i in 0..<n
        val lane = fresh_reg(e)
        val r = fresh_reg(e)

        if to_vector
            emit(e, InExtract(lane, fty, v, index_list(i)))
            emit(e, InInsertElement(r, tty, acc, ety, lane, ir_arg(l_i32(), VInt(from_int(long(i))))))
        else
            emit(e, InExtractElement(lane, fty, v, ir_arg(l_i32(), VInt(from_int(long(i))))))
            emit(e, InInsert(r, tty, acc, ety, lane, index_list(i)))
        end if

        acc = r

    acc
end gen_lanes_as

// `<4>f32(v)`: every lane converted as `convert` converts one scalar, and **as ONE instruction over
// the whole register** wherever the scalar's is one LLVM instruction -- `sitofp`, `uitofp`, `zext`,
// `sext` (a mask's `zext` among them), `trunc`, `fpext`, `fptrunc`, or the `.sat` intrinsic a float becomes an integer through,
// which is what makes a NaN zero and an out-of-range lane the width's end rather than poison. An
// integer narrowed wraps at the lane width, as vector arithmetic does: a register traps as a whole or
// not at all, so the debug build's check on a written narrowing is the scalar's alone.
//
// What has no instruction of its own is converted lane by lane by the scalar path: an integer past
// 128 bits to or from a float, a fixed-point lane (which rescales, rounds and saturates), and a
// `char` checked as it is made.
gen_lane_convert(e: *Emit, from: Type, to: Type, v: Val) -> Val
    val (n, a) = from match
        Vector(k, x) -> (k, underlying(*x))
        _ -> (0, Unknown)
    val b = to match
        Vector(_, x) -> underlying(*x)
        _ -> Unknown

    if type_eq(a, b) then return v

    (a, b) match
        (Integer(a_bits, a_signed, _), Integer(b_bits, _, _)) ->
            if a_bits == b_bits then return v

            val op = if b_bits < a_bits then CastTrunc else if a_signed then CastSExt else CastZExt

            return cast_to(e, op, from, to, v)
        // A mask lane is an `i1` read as unsigned, so `true` is `1` at a signed width too.
        (Bool, Integer(b_bits, _, _)) ->
            if b_bits == 1 then return v

            return cast_to(e, CastZExt, from, to, v)
        (Char, Integer(b_bits, _, _)) ->
            if b_bits == 32 then return v

            return cast_to(e, if b_bits < 32 then CastTrunc else CastZExt, from, to, v)
        (Integer(a_bits, a_signed, _), Floating(_, _)) ->
            if a_bits <= 128 then return cast_to(e, if a_signed then CastSIToFP else CastUIToFP, from, to, v)
        (Floating(_, _), Integer(b_bits, b_signed, _)) ->
            if b_bits <= 128 then return saturating_to_int(e, from, to, b_signed, v)
        // `f16` and `bf16` are the one pair neither of which is wider, so the pair goes through `f32`,
        // which holds both exactly, as the scalar's does.
        (Floating(a_bits, _), Floating(b_bits, _)) ->
            if a_bits == b_bits
                val wide = Vector(n, Floating(32, false))

                return gen_lane_convert(e, wide, to, gen_lane_convert(e, from, wide, v))
            end if

            return cast_to(e, if b_bits > a_bits then CastFPExt else CastFPTrunc, from, to, v)
        _ -> ()

    val (fty, tty) = (lty(e, from), lty(e, to))
    var acc: Val = VPoison

    for i in 0..<n
        val lane = fresh_reg(e)
        val r = fresh_reg(e)
        val at = ir_arg(l_i32(), VInt(from_int(long(i))))

        emit(e, InExtractElement(lane, fty, v, at))
        emit(e, InInsertElement(r, tty, acc, lty(e, b), convert(e, a, b, lane), at))
        acc = r

    acc
end gen_lane_convert

// One lane, read straight out of the register. There is no address and so no bounds test: the index
// was held to a constant in range where it was written.
gen_lane(e: *Emit, receiver: TExpr, lane: int) -> Val
    val v = gen_expr(e, receiver)
    val r = fresh_reg(e)

    emit(e, InExtractElement(r, lty(e, texpr_type(receiver)), v,
                             ir_arg(l_i32(), VInt(from_int(long(lane))))))
    r
end gen_lane

// A lane-wise comparison is the scalar instruction at the register's width -- `fcmp olt <4 x float>`
// yields the `<4 x i1>` that is this language's `<4>bool`. The predicate is chosen exactly as the
// scalar path chooses it, from the lane's own type and signedness.
gen_vec_compare(e: *Emit, op: string, l: TExpr, r: TExpr) -> Val
    val lv = gen_expr(e, l)
    val rv = gen_expr(e, r)
    val vty = lty(e, texpr_type(l))
    val lane = underlying(element(repr(texpr_type(l))).unwrap_or(Unknown))
    val res = fresh_reg(e)

    lane match
        Floating(_, _) -> emit(e, InFloatCmp(res, float_pred(e, op), vty, lv, rv))
        _ -> emit(e, InIntCmp(res, int_pred(e, op, lane), vty, lv, rv))

    res
end gen_vec_compare

// Both sides are evaluated and the mask picks between them, which is the whole difference from an
// `if` and is why this is not one.
gen_select(e: *Emit, mask: TExpr, when_true: TExpr, when_false: TExpr, ty: Type) -> Val
    val m = gen_expr(e, mask)
    val a = gen_expr(e, when_true)
    val b = gen_expr(e, when_false)
    val r = fresh_reg(e)

    emit(e, InSelect(r, m, lty(e, ty), a, b, lty(e, texpr_type(mask))))
    r
end gen_select

// Lanes rearranged: one `shufflevector`, whose list of constant lane numbers is the instruction's own
// operand -- so it is the one instruction at every optimisation level, chosen by instruction
// selection rather than recovered by a pass. A one-input shuffle hands `poison` as the second
// vector, which no lane of the list names.
gen_shuffle(e: *Emit, receiver: TExpr, second: Option[TExpr], lanes: Buf[int]) -> Val
    val a = gen_expr(e, receiver)
    val b = if second.is_some() then gen_expr(e, second.unwrap()) else VPoison
    var picks: Buf[IrArg] = buf()

    for lane in lanes
        picks.push(ir_arg(l_i32(), VInt(from_int(long(lane)))))

    val r = fresh_reg(e)

    emit(e, InShuffle(r, lty(e, texpr_type(receiver)), a, b,
                      ir_arg(LVec(int(lanes.len()), l_i32()), VVector(picks))))
    r
end gen_shuffle

// A vector with lanes written, as one instruction where one lane is named and as one merging
// `shufflevector` where several are.
//
// **One lane is an `insertelement`.** Several are the receiver merged with the value: the mask takes
// lane `lanes[j]` of the result from lane `j` of the value and every other lane from the receiver. The
// value has to be as wide as the receiver to be a shuffle input, so a narrower one is widened first
// -- except where the value is itself a one-input shuffle of a vector the receiver's width
// (`q.xy = p.zw`), whose own list is folded into the merge's, so the whole write is the one
// instruction.
gen_lane_set(e: *Emit, receiver: TExpr, lanes: Buf[int], value: TExpr) -> Val
    val vec_ty = texpr_type(receiver)
    val vty = lty(e, vec_ty)
    val cur = gen_expr(e, receiver)
    val n = repr(vec_ty) match
        Vector(k, _) -> k
        _ -> 0

    if lanes.len() == 1
        val v = gen_expr(e, value)
        val r = fresh_reg(e)

        emit(e, InInsertElement(r, vty, cur, lty(e, texpr_type(value)), v,
                                ir_arg(l_i32(), VInt(from_int(long(lanes[0]))))))
        return r
    end if

    // Where each result lane comes from, as a position in the input's own lanes.
    var from = value
    var folded = false
    var sources: Buf[int] = buf()

    for j in 0..<lanes.len()
        sources.push(int(j))

    *value.kind match
        TShuffle(inner, second, listed, _) ->
            if second.is_none() && type_eq(repr(texpr_type(inner)), repr(vec_ty))
                from = inner
                folded = true
                sources = listed
        _ -> ()

    var input = gen_expr(e, from)

    // A value narrower than the receiver is widened by a shuffle whose extra lanes are never read.
    if !folded && int(lanes.len()) < n
        var widen: Buf[IrArg] = buf()

        for i in 0..<n
            widen.push(ir_arg(l_i32(), VInt(from_int(long(if i < int(lanes.len()) then i else 0)))))

        val wide = fresh_reg(e)

        emit(e, InShuffle(wide, lty(e, texpr_type(from)), input, VPoison,
                          ir_arg(LVec(n, l_i32()), VVector(widen))))
        input = wide
    end if

    var picks: Buf[IrArg] = buf()

    for i in 0..<n
        var at = n + i

        for j in 0..<lanes.len()
            if lanes[j] == i then at = sources[j]

        picks.push(ir_arg(l_i32(), VInt(from_int(long(at)))))

    val r = fresh_reg(e)

    emit(e, InShuffle(r, vty, input, cur, ir_arg(LVec(n, l_i32()), VVector(picks))))
    r
end gen_lane_set

// A vector folded to one lane.
//
// **The float sum takes a starting accumulator and the others do not**, which is not a symmetry LLVM
// chose lightly: floating addition is not associative, so the intrinsic makes you say what to start
// from and whether the order may be changed. `-0.0` is the identity -- `0.0` would turn a sum of
// nothing but negative zeros positive -- and `reassoc` is what licenses the tree that makes this
// worth doing at all rather than a left fold in disguise.
gen_reduce(e: *Emit, op: string, receiver: TExpr, ty: Type) -> Val
    val v = gen_expr(e, receiver)
    val vty = lty(e, texpr_type(receiver))
    val ety = lty(e, element(repr(texpr_type(receiver))).unwrap_or(Unknown))
    val rty = lty(e, ty)
    // The suffix is the **vector's** type rather than the lane's.
    val name = llvm_reduce_entry(op).unwrap().at([vty])

    var params: Buf[IrParam] = buf()
    var ops: Buf[IrArg] = buf()
    var fast: Buf[FastMath] = buf()

    if op == "fadd"
        params.push(ir_param(ety))
        ops.push(ir_arg(ety, VFloat(neg_zero_bits())))
        fast.push(FmReassoc)
    end if

    params.push(ir_param(vty))
    ops.push(ir_arg(vty, v))
    request_intrinsic(e, ir_sig(name, ir_fn_type(rty, params)))

    val r = fresh_reg(e)

    emit(e, InCall(Some(r), rty, VGlobal(name), ops, no_ir_attrs(), None, fast, false))
    r
end gen_reduce

// The bit pattern of negative zero. The value is read from
// text rather than written as `-0.0`, which a fold is free to answer as a positive zero.
private neg_zero_bits() -> long = signed_bits(parse_real("-0.0").unwrap_or(0.0).bits())

// **The alignment is the element's, not the register's, and that is what a slice can promise.** A
// `[]f32` says its elements are four-byte-aligned and says nothing whatever about where the run
// begins -- a slice of one is a slice of any of them. Claiming the vector's own alignment would be a
// promise the type does not make, and an over-aligned `load` is not a slow load but undefined
// behaviour the moment it is wrong. Every machine sysl targets has an unaligned vector load that
// costs the same as the aligned one on aligned data, so the honest number is also the free one.
//
// **A lane narrower than its element's storage is moved as the storage and converted in the
// register.** An array of `u12` gives each element two bytes, but LLVM packs a `<8 x i12>` into
// twelve contiguous bits per lane, so loading the run as the vector type would read the padding as
// lanes. The run is read as `<N x i16>` and truncated; a store widens with `zext`, whatever the
// lane's signedness, because a scalar `i12` store leaves its padding bits zero and a scalar load
// relies on that. `bool` (an `i1` in a byte) and every width that is not a whole power-of-two
// number of bytes (`u24`, `i56`, `u100`) take the same path.
gen_vec_load(e: *Emit, receiver: TExpr, index: TExpr, vec_ty: Type, site: Span) -> Val
    val elem = element(repr(vec_ty)).unwrap_or(Unknown)
    val n = vector_lanes(vec_ty)
    val p = run_addr(e, receiver, index, n, site)
    val r = fresh_reg(e)
    val align = Some(int(e.layout.align(elem)))

    storage_lane(e, elem) match
        None -> emit(e, InLoad(r, lty(e, vec_ty), p, AccPlain, align))
        Some(st) ->
            val wide = fresh_reg(e)

            emit(e, InLoad(wide, LVec(n, st), p, AccPlain, align))
            emit(e, InCast(r, CastTrunc, LVec(n, st), wide, lty(e, vec_ty)))

    r
end gen_vec_load

// The integer a lane is stored as in an array when that differs from the lane's own type: `i16`
// for a `u12`, `i8` for a `bool`, `i32` for an `i24`. `None` when the element fills its storage
// exactly, which is every float, `char` and power-of-two integer.
private storage_lane(e: *Emit, elem: Type) -> Option[LType] = lty(e, elem) match
    LInt(bits) ->
        val stored = int(e.layout.size(elem)) * 8

        if stored != bits && stored > 0 then Some(LInt(stored)) else None
    _ -> None

// The value first and the address second, which is the order an assignment uses -- this *is* an
// assignment to a run of elements, and the two spellings must not differ in when a side effect in
// the value happens relative to the bounds check on the run.
gen_vec_store(e: *Emit, receiver: TExpr, index: TExpr, value: TExpr, site: Span) -> Val
    val vec_ty = texpr_type(value)
    val elem = element(repr(vec_ty)).unwrap_or(Unknown)
    val v = gen_expr(e, value)
    val n = vector_lanes(vec_ty)
    val p = run_addr(e, receiver, index, n, site)
    val align = Some(int(e.layout.align(elem)))

    storage_lane(e, elem) match
        None -> emit(e, InStore(lty(e, vec_ty), v, p, AccPlain, align))
        Some(st) ->
            val wide = fresh_reg(e)

            emit(e, InCast(wide, CastZExt, lty(e, vec_ty), v, LVec(n, st)))
            emit(e, InStore(LVec(n, st), wide, p, AccPlain, align))

    VNothing
end gen_vec_store

// How many lanes a vector type has.
private vector_lanes(t: Type) -> int = repr(t) match
    Vector(n, _) -> n
    _ -> 0

// A lane-wise operation that is one intrinsic over the whole register: `fabs`, `abs`, `fma`,
// `maximum`, `minimum`, `sqrt` or one of the four roundings. The suffix is the vector's type, so the machine's own instruction is
// selected -- there is no loop over the lanes. `llvm.abs` is told the most negative lane is *not*
// poison, so it answers itself, which is what the scalar `abs` answers in every build.
gen_vec_op(e: *Emit, op: string, operands: Buf[TExpr], ty: Type, site: Span) -> Val
    if op == "bits" && is_mask_bits(operands) then return gen_mask_bits(e, operands[0], ty)
    if op == "lookup" then return gen_lookup(e, operands[0], operands[1], ty)
    if op == "compress" then return gen_compress(e, operands[0], operands[1], ty)
    if op == "gather" || op == "gather_unchecked" then
        return gen_gather(e, operands[0], operands[1], ty, op == "gather", site)

    val lt = lty(e, ty)

    // `bits()` and `from_bits` are one `bitcast` of the register between its floats and the unsigned
    // integers of their width -- the same number of bits, so no lane moves and none is converted.
    if op == "bits" || op == "from_bits"
        val from = lty(e, texpr_type(operands[0]))
        val v = gen_expr(e, operands[0])
        val r = fresh_reg(e)

        emit(e, InCast(r, CastBitCast, from, v, lt))
        return r
    end if

    val lane_float = llvm_lane_float_entry(op)
    val fn = if lane_float.is_ok() then lane_float.unwrap().at([lt])
             else if op == "fma" then llvm_fma_entry().at([lt])
             else if op == "fabs" then llvm_fabs_entry().at([lt])
             else if op == "maximum" then llvm_maximum_entry().at([lt])
             else if op == "minimum" then llvm_minimum_entry().at([lt])
             else llvm_abs_entry().at([lt])

    var params: Buf[IrParam] = buf()
    var args: Buf[IrArg] = buf()

    for x in operands
        params.push(ir_param(lt))
        args.push(ir_arg(lt, gen_expr(e, x)))

    if op == "abs"
        params.push(ir_param(l_i1()))
        args.push(ir_arg(l_i1(), VBool(false)))
    end if

    request_intrinsic(e, ir_sig(fn, ir_fn_type(lt, params)))

    val r = fresh_reg(e)

    emit(e, ir_call(Some(r), lt, VGlobal(fn), args))
    r
end gen_vec_op

// The integer width of a lane, or 0 where it is not an integer.
private lane_int_bits(t: Type) -> int = element(repr(t)) match
    Some(x) -> underlying(x) match
        Integer(bits, _, _) -> bits
        Fixed(bits, _, _) -> bits
        _ -> 0
    None -> 0

private lane_index(k: int) -> IrArg = ir_arg(l_i32(), VInt(from_int(long(k))))

// `m.bits()`: a mask is `<N x i1>`, and **its bitcast to `iN` is the whole operation** -- the
// back end selects `pmovmskb` on x86 and the narrow-and-add idiom on AArch64 for it. LLVM numbers a
// vector's elements from the low end of the integer on a little-endian machine and from the high end
// on a big-endian one, so there the bits are reversed, which keeps lane `i` at bit `i` on every target.
gen_mask_bits(e: *Emit, mask: TExpr, ty: Type) -> Val
    val m = gen_expr(e, mask)
    val it = lty(e, ty)
    val r = fresh_reg(e)

    emit(e, InCast(r, CastBitCast, lty(e, texpr_type(mask)), m, it))

    if e.target.little_endian() then return r

    val fn = llvm_bits_entry("bitreverse").unwrap().at([it])
    var params: Buf[IrParam] = buf()
    var args: Buf[IrArg] = buf()

    params.push(ir_param(it))
    args.push(ir_arg(it, r))
    request_intrinsic(e, ir_sig(fn, ir_fn_type(it, params)))

    val turned = fresh_reg(e)

    emit(e, ir_call(Some(turned), it, VGlobal(fn), args))
    turned
end gen_mask_bits

// `table.lookup(idx)`: lane `k` of the answer is lane `idx[k]` of the table, or zero where `idx[k]`
// is past the table's end.
//
// **Sixteen byte lanes on AArch64 are one `tbl`**, whose own answer out of range is zero, so nothing
// is added around it. **Everywhere else it is the shape back ends recognise as a variable permute**:
// the positions are clamped once over the register, each lane is an `extractelement` at a position
// read out of that one vector, and one `select` zeroes the lanes that were out of range. x86 turns
// that shape into `pshufb` wherever the processor has SSSE3; a machine with no such instruction gets
// the lane moves it would have needed anyway.
gen_lookup(e: *Emit, table: TExpr, idx: TExpr, ty: Type) -> Val
    val tt = texpr_type(table)
    val it = texpr_type(idx)
    val n = vector_lanes(tt)
    val m = vector_lanes(it)
    val ib = lane_int_bits(it)
    val tv = gen_expr(e, table)
    val iv = gen_expr(e, idx)
    val rt = lty(e, ty)

    if e.target.cpu == Aarch64 && n == 16 && (m == 16 || m == 8) && ib == 8 && lane_int_bits(tt) == 8
        val fn = llvm_aarch64_tbl1_entry().at([rt])
        var params: Buf[IrParam] = buf()
        var args: Buf[IrArg] = buf()

        params.push(ir_param(lty(e, tt)))
        params.push(ir_param(lty(e, it)))
        args.push(ir_arg(lty(e, tt), tv))
        args.push(ir_arg(lty(e, it), iv))
        request_intrinsic(e, ir_sig(fn, ir_fn_type(rt, params)))

        val r = fresh_reg(e)

        emit(e, ir_call(Some(r), rt, VGlobal(fn), args))
        return r
    end if

    val ivt = lty(e, it)
    val tvt = lty(e, tt)
    val ety = lty(e, element(repr(ty)).unwrap_or(Unknown))

    // Only a position type that can name a lane past the end needs the test: a `<4>u1` index into a
    // table of four has none.
    val can_miss = ib >= 31 || (1 << ib) > n
    var at = iv
    var inside = VNothing

    if can_miss
        val ok = fresh_reg(e)

        emit(e, InIntCmp(ok, IUlt, ivt, iv, VSplat(m, LInt(ib), VInt(from_int(long(n))))))

        val clamped = fresh_reg(e)

        emit(e, InSelect(clamped, ok, ivt, iv, VZero, LVec(m, l_i1())))
        at = clamped
        inside = ok
    end if

    var out = VZero

    for k in 0..<m
        val pos = fresh_reg(e)

        emit(e, InExtractElement(pos, ivt, at, lane_index(k)))

        val x = fresh_reg(e)

        emit(e, InExtractElement(x, tvt, tv, ir_arg(LInt(ib), pos)))

        val next = fresh_reg(e)

        emit(e, InInsertElement(next, rt, out, ety, x, lane_index(k)))
        out = next
    end for

    if !can_miss then return out

    val r = fresh_reg(e)

    emit(e, InSelect(r, inside, rt, out, VZero, LVec(m, l_i1())))
    r
end gen_lookup

// `v.compress(m)`: the kept lanes written one after another from lane 0 into a register of zeros.
// No machine sysl targets by default has the instruction (AVX-512's `vpcompress` and SVE's `compact`
// are extensions), so it is a lane move per lane with no branch: each lane is inserted at the count
// kept so far and the insertion kept only where the mask's lane is true. The position never passes
// the lane being placed, so it is always a lane the register has.
gen_compress(e: *Emit, value: TExpr, mask: TExpr, ty: Type) -> Val
    val vt = lty(e, ty)
    val mt = lty(e, texpr_type(mask))
    val ety = lty(e, element(repr(ty)).unwrap_or(Unknown))
    val n = vector_lanes(ty)
    val v = gen_expr(e, value)
    val m = gen_expr(e, mask)

    var out = VZero
    var pos = VInt(from_int(0))

    for k in 0..<n
        val x = fresh_reg(e)

        emit(e, InExtractElement(x, vt, v, lane_index(k)))

        val keep = fresh_reg(e)

        emit(e, InExtractElement(keep, mt, m, lane_index(k)))

        val put = fresh_reg(e)

        emit(e, InInsertElement(put, vt, out, ety, x, ir_arg(l_i32(), pos)))

        val chosen = fresh_reg(e)

        emit(e, InSelect(chosen, keep, vt, put, out, l_i1()))
        out = chosen

        if k + 1 < n
            val step = fresh_reg(e)

            emit(e, InCast(step, CastZExt, l_i1(), keep, l_i32()))

            val moved = fresh_reg(e)

            emit(e, InBin(moved, OpAdd, l_i32(), pos, step))
            pos = moved
        end if
    end for

    out
end gen_compress
