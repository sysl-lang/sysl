module sysl

/** What a program does when something it was sure of turns out not to hold.
 *
 * These are the *runtime* half of the language's checking, and they sit beside rather than inside the
 * half `16-constrained-types-and-contracts.md` describes. A `require` clause is a promise about a
 * call, checked where the call arrives and nowhere else; these are a promise about a moment, checked
 * where the moment is. A function whose fifth statement has just computed something it can verify has
 * no contract to hang that on -- the contract was about the arguments, four statements ago.
 *
 * Both stop the program the way `unwrap` does: a line on standard error naming what happened and
 * where, then `abort` (below, at `panic_begin`). That is deliberately not `llvm.trap`. A trap is
 * what the compiler emits for a check the *language* makes -- a bounds violation, a broken contract
 * -- and its one line says which check it was, since the source line says the rest. These are checks
 * a *program* makes, about things it knows and the compiler does not, so the message is the whole
 * point of them. Every one of them, trap or panic, is reported through the `sysl_trap` hook first.
 *
 * **`trap` is that same instruction, for a program that wants it.** Use it where there is nothing
 * to say or nowhere to say it -- a bare-metal `abort`, a fault handler that must not print, a path
 * that reaches the machine in a state no message could be written from -- and use `assert` or
 * `panic` everywhere else. It needs no capability, allocates nothing and prints nothing.
 *
 * Under `sysl test` either one fails the test it is written in, since a test's verdict is whether it
 * came back and neither of these comes back.
 */

private extern "llvm.trap" llvm_trap() -> never

/** Stops the program at once, silently, with the target's trap instruction: `udf` on Thumb, `brk`
 * on AArch64, `unimp` on RISC-V, `ud2` on x86-64. It never returns, runs no `defer` and flushes nothing, which is what
 * a compiler-inserted check does, and it is legal on every target and under `@no_alloc`.
 */
trap() -> never = llvm_trap()

/** **An index past a container's count stops the program exactly as one past an array's length
 * does**: the failure is reported through `sysl_bounds_fail` -- the default's message on standard
 * error, or a program's own `@export("sysl_bounds_fail")` -- and then the program traps, so the exit
 * status is SIGTRAP's and an override that returns still stops it. `Buf`, `Frozen`, `Deque` and
 * `Ring` all report through here, which is what makes `b[5]` on a three-element `Buf` say what
 * `a[5]` on a three-element array says.
 *
 * **It names the caller's line, as an array's check does.** It is `@track_caller`, and so is every
 * member that reaches it -- `at`, `set`, `insert`, `remove` and the `Index` members that call them --
 * so the location it reports is the subscript or the call the program wrote, handed down the chain
 * (`reference/attributes.md § @track_caller`). A build that dropped locations hands down null, and
 * the message ends at the values.
 *
 * Out of line and cold, so what a bounds-checked member keeps at the check is a compare and a
 * branch.
 */
@noinline
@cold
@track_caller
private[sysl] index_past(i: usize, n: usize) -> never
    bounds_report(BoundsIndex, i, 0, n, __CALLER__)
    trap()

/** The same report for an insertion, which may stand at the count itself and no further. */
@noinline
@cold
@track_caller
private[sysl] insert_past(i: usize, n: usize) -> never
    bounds_report(BoundsInsertPastLength, i, 0, n, __CALLER__)
    trap()

// The forms the two reports take, as `sysl_bounds_fail` numbers them -- the compiler's
// `bounds_fail.sysl` holds the whole list, and the numbers are part of the C surface.
private const BoundsIndex: u32 = 0
private const BoundsInsertPastLength: u32 = 14

// The hook every failed bounds check reports through: the compiler's weak default, or a program's
// own definition. Its C signature is `void (uint32_t kind, size_t a, size_t b, size_t length,
// const char *at)`.
private extern "sysl_bounds_fail" bounds_report(kind: u32, a: usize, b: usize, n: usize, at: *u8)

// Where the caller was. Every assertion here is `@track_caller`, so the line it names is the one that
// called it -- and where that call is itself in a `@track_caller` function, the line that called
// THAT, which is how a program's own checking helper reports its caller's line rather than its own
// (`reference/attributes.md § @track_caller`). `file` and `line` stay, empty, for a caller that has a
// location of its own to name instead; given one, that is what is printed.
//
// **This is why `assert`'s message is optional.** A check that names its own line does not need to
// be told in prose which check it was.

/** The location is **streamed** rather than interpolated, and that is not a style choice: an
 * f-string builds a string, and building one makes heap storage, which would put `panic` and
 * everything through it out of reach of a module that declared `@no_alloc` (`reference/modules.md §
 * Capabilities are a module property`). An assertion is exactly what an allocator-free module wants
 * most, so it is composed out of `prints` and `printi`, each of which goes straight to `putbytes`.
 * Caught by the `@no_alloc` test that already existed.
 */
@track_caller
panic(msg: string, file: string = "", line: long = 0) -> never
    panic_begin()
    panic_says(msg)
    report_tail(file, line, msg)

// -- how a panic is written, and how it stops --------------------------------------------------------
//
// **A panic is written to standard error and stops the program with `abort`**, on a hosted target,
// whatever was built -- a program, a test, or a library a C host links (`sysl build-c`). Standard
// error because a panic is a diagnostic, and a program whose output another reads must not have one
// land in the middle of its answer. `abort` rather than `exit(1)` because a failure is not a way of
// finishing: `exit` runs every `atexit` handler and every C++ static destructor in the process --
// the host's, where sysl is a library inside it -- against a state the panic has just said is wrong,
// which is the reason a trap runs no `defer` (`reference/errors.md § Traps`). What the program had
// printed is flushed first, so it still comes out before the panic line; the process then ends by
// SIGABRT, which a shell reports as status 134.
//
// **Before it stops, the panic is reported through `sysl_trap`**, the hook every compiler check
// reports through, with the message's bytes and count and the location: a host or a board that
// overrides the hook to log failures logs panics too. The default does nothing with a panic, whose
// report is already written. A target with no operating system writes the report through `putchar`,
// as everything it prints goes, and stops with `exit(1)`, which its board supplies.

// The hook, as the compiler's checks call it (`bounds_fail.sysl`); a panic is its form 21.
private extern "sysl_trap" trap_report(kind: u32, a: usize, b: usize, n: usize, at: *u8)

private const TrapPanic: u32 = 21

private extern "abort" c_abort() -> never

// The start of every panic's report: what the program printed so far, out first, then the word.
private[sysl] panic_begin()
#if hosted
    flush()
#endif
    panic_says("panic: ")
end panic_begin

// Where a panic's report is written: standard error, or `putchar` where there is no operating system.
private[sysl] panic_put(b: []const u8)
#if hosted
    eputbytes(b)
#else
    putbytes(b)
#endif
end panic_put

private[sysl] panic_says(s: string) = panic_put(s.bytes)

private[sysl] panic_int(n: long)
    var buf: [24]u8
    val at = digits_long(n, buf[0..<24])
    panic_put(buf[at..<24])

private[sysl] panic_uint(n: ulong)
    var buf: [24]u8
    val at = digits_ulong(n, buf[0..<24])
    panic_put(buf[at..<24])

// The same stream as a `Writer`, for a value a report shows through its own `Debug`.
private[sysl] panic_out() -> *Writer
#if hosted
    stderr()
#else
    stdout()
#endif
end panic_out

/** The end of every panic, its report written: the hook told, then the stop. `msg` is the panic's
 * own words, which an override is handed, and `at` the location, or null.
 */
@noinline
@cold
private[sysl] panic_stop(msg: string, at: *u8) -> never
    val text = if msg.len == 0 then usize(0) else usize(&msg.bytes[0])

    trap_report(TrapPanic, text, msg.len, 0, at)
#if hosted
    c_abort()
#else
    exit(1)
#endif
end panic_stop

/** The condition is checked and nothing else is: a false one names where it was written, and the
 * message if it was given one.
 *
 * `panic` is tracked as this is, so the location travels to it with nothing written here.
 */
@track_caller
assert(cond: bool, msg: string = "", file: string = "", line: long = 0)
    if !cond then
        if msg.len == 0 then panic("assertion failed", file, line)
        else panic(msg, file, line)

// What an equality assertion adds over `assert(a == b)` is the two **values**, and that is the whole
// of why it is worth a function. A failed `assert` names the line, which says *which* check broke; a
// reader then has to run the thing again to find out what the values were, and running it again is
// exactly what the report could have saved them.
//
// The message could be written by hand -- `assert(a == b, s"got $a, want $b")` -- and that is the
// form this replaces. It evaluates each side twice, and it builds a string, which makes heap
// storage and so is unavailable to the modules that want an assertion most (`reference/modules.md §
// Capabilities are a module property`). Rendering through `Debug` into `stdout()` costs neither.
//
// One function rather than one per type: `Eq` says the comparison means something and `Debug` -- which
// every type has -- says how the value is shown, which together are the whole of what a report needs.

/** The head and the tail of a report, shared by the three below so that one failure reads like
 * another. They are separate because what goes between them is each assertion's own -- a pair of
 * values, a pair of lengths, an index -- and none of it can be handed over as a `string` without
 * building one.
 */
private[sysl] report_head(msg: string)
    panic_begin()

    if msg.len > 0 then
        panic_says(msg)
        panic_says(": ")

//
// The tail names `file:line` where the caller gave one, and otherwise the line that called the
// tracked assertion -- nothing at all where the build laid no location down. The hook is handed the
// same place: the caller's own `file:line`, composed into storage on the stack, which lasts until
// the program stops.
@track_caller
private[sysl] report_tail(file: string, line: long, msg: string) -> never
    if file.len > 0
        var place: [256]u8
        var n: usize = 0

        for b in file.bytes
            if n < 230
                place[n] = b
                n += 1

        place[n] = u8(':')
        n += 1

        var digits: [24]u8
        val at = digits_long(line, digits[0..<24])

        for i in at..<24
            place[n] = digits[i]
            n += 1

        place[n] = 0
        panic_says(" (")
        panic_put(place[0..<n])
        panic_says(")\n")
        panic_stop(msg, &place[0])
    end if

    val loc = caller_location()

    if loc.known()
        panic_says(" (")
        panic_put(loc.file_bytes())
        panic_says(":")
        panic_uint(ulong(loc.line()))
        panic_says(")")

    panic_says("\n")
    panic_stop(msg, loc.at)
end report_tail

// Each side of a failed comparison is shown through its `Debug`, which every type has: a string
// keeps its quotes, so `got "1", want 1` cannot read as two equal values.
private[sysl] show[T: Debug](v: T) = v.debug(panic_out(), FormatSpec(0, -1, false))

/** `got` and `want` in that order, which is Go's and the order a failure is read in: what happened,
 * then what was meant to.
 */
@track_caller
assert_eq[T: Eq + Debug](got: T, want: T, msg: string = "", file: string = "", line: long = 0)
    if got != want then
        report_head(msg)
        panic_says("got ")
        show(got)
        panic_says(", want ")
        show(want)
        report_tail(file, line, msg)

/** The same for a slice, which needs more than `==` to be useful: a report saying two slices differ
 * sends its reader to find out where, and finding out where is a loop nobody wants to write at each
 * call. Length first, since a length mismatch explains every index after the shorter one.
 */
@track_caller
assert_slice_eq[T: Eq + Debug](got: []const T, want: []const T, msg: string = "",
                               file: string = "", line: long = 0)
    if got.len != want.len then
        report_head(msg)
        panic_says("got ")
        panic_uint(ulong(got.len))
        panic_says(" elements, want ")
        panic_uint(ulong(want.len))
        report_tail(file, line, msg)

    for i in 0..<got.len
        if got[i] != want[i] then
            report_head(msg)
            panic_says("got ")
            show(got[i])
            panic_says(", want ")
            show(want[i])
            panic_says(" at index ")
            panic_uint(ulong(i))
            report_tail(file, line, msg)
