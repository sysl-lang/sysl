module sh.sysl.compiler
@tests

import sh.sysl.parsing.source_of
import sysl.buf.{Buf, buf}
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.{capture, Status}
import sysl.text.Search

// **A struct with an `invariant`, built from constants in a module initializer, is constant data**:
// the clauses are run over the fields while compiling (`const_eval.sysl`'s `const_invariant_holds`),
// so the object file carries the value and nothing is left to check when the program starts -- which
// is what lets a bare machine, with no loader to run an initializer, read it.
//
// - Where the clauses do not hold, the construction is refused: its fields are constants, so the trap
//   is certain.
// - Where the clauses cannot be run -- they read a module `var`, or call a function that does -- the
//   storage stays code, filled and checked at startup, and a bare machine's refusal says the
//   invariant is what kept it there. A function nobody marked `const` is run where its body can be,
//   as one in an initializer is; where clauses calling one do not hold, the call keeps its meaning
//   and the trap is left for startup.
// - The zero a declaration with no initializer starts at is asked the same question; one the clauses
//   do not hold for is left to trap at startup.
// - A construction in a function body is untouched: checked when it runs.
//
// The axes: `val` and `var`; a clause over one field, over several, calling a `const` function,
// calling an unmarked one, reading a module `var`, carrying a message; the struct at the top, inside
// an array inside a struct, as a variant's payload, generic at two types; a private value, a value
// of another module; a field that does not fold; the zero, holding and not; a bare archive
// (`thumbv7em-freestanding`) and a hosted program in debug and release.
//
// Skipped, with the reason: a `build-lib` `.syslib` and codegen units -- the storage is decided in
// analysis, before either exists, and `tests_fsl_`/`tests_xst_` hold that seam for data in general;
// `@thread_local` and exported storage -- both read the same `computed` answer this decides, with
// nothing of their own about a clause.

// The units a bare archive is analysed from: the library's, then the program's own modules.
private icd_units(t: Target, modules: Buf[(string, string)]) -> Result[Buf[Program], string]
    var units: Buf[Program] = buf()

    std_root() match
        Err(_) -> ()
        Ok(root) -> std_units(root, t) match
            Err(_) -> ()
            Ok(found) -> units = found

    for item in modules
        val parsed = parse(source_of(item.0, item.1), t)

        if !parsed.ok() then return Err(parsed.report.at(0).message)

        units.push(parsed.program)

    Ok(units)
end icd_units

private icd_first_of(said: Buf[Placed]) -> string
    for item in said
        if !item.src.name.starts_with("library/") then return item.diag.message

    ""
end icd_first_of

// A `thumbv7em-freestanding` archive of a program and one more module, as `build-c` makes one: the
// first thing the compilation had to say, or the LLVM text it lowered to.
private icd_built_with(other: string, text: string) -> string
    val t = target_named("thumbv7em-freestanding").unwrap()
    var modules: Buf[(string, string)] = buf()

    modules.push(("tables/tables.sysl", other))
    modules.push(("main.sysl", text))

    val units = icd_units(t, modules) match
        Err(why) -> return why
        Ok(found) -> found

    val done = analyze_produced(units, t, buf(), false)
    val early = icd_first_of(done.reported)

    if early != "" then return early

    val whole = program_of(done, done.main_module) with { entry_point = false, c_artifact = true }
    var own: Buf[string] = buf()

    own.push("")
    own.push("tables")

    val pr = post_analysis_checks(done.an, whole, own)
    val late = icd_first_of(done.an.diagnostics())

    if late != "" then return late

    ir_print_module(codegen_with_gaps(prune(strip_tests(whole), own), t, pr).0)
end icd_built_with

// What a refusal says after the refusal itself: why the storage stayed code.
private icd_refused(out: string, name: string, why: string)
    assert(out.contains(s"is exported and reaches '$name', which is module storage an initializer fills"), out)
    assert(out.ends_with(s"which is laid straight into the object file. $why"), out)
end icd_refused

private icd_ready() -> bool = std_root().is_ok() && clang_available()

// `text` as `main.sysl`, with `other` as the module `tables` beside it where there is one, built in
// the mode `flag` names and run: its status, and what it printed on both streams.
private icd_run(text: string, other: string, flag: string) -> (Status, string)
    val root = make_temp_dir("sysl-icd").unwrap()

    write_text(s"$root/main.sysl", text).unwrap()

    if other != ""
        make_dir_all(s"$root/tables").unwrap()
        write_text(s"$root/tables/tables.sysl", other).unwrap()
    end if

    var flags: [1]string = [flag]

    assert_eq(took_search_flag(flags[..], 0), 1)

    val exe = s"$root/built"
    val built = build_native_program(root, None, None, DefaultOptimization, Some(exe))

    reset_search_paths()

    built match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return (Status.Exited(-1), s"it did not build: ${failure_text(why)}")
        Ok(_) -> ()

    val said = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    said match
        Err(_) -> (Status.Exited(-1), "the program that was built could not be run")
        Ok(out) -> (out.status, out.text + out.err.unwrap_or(""))
end icd_run

// In debug and in release, the program prints exactly `want` and exits cleanly.
private icd_runs(text: string, other: string, want: string)
    if !icd_ready() then return

    for flag in ["--debug", "--release"]
        val (state, printed) = icd_run(text, other, flag)

        assert_eq(printed, want)
        assert(state.ok(), s"$flag stopped with $state, having printed '$printed'")

    var back: [1]string = ["--debug"]

    assert_eq(took_search_flag(back[..], 0), 1)
end icd_runs

// In debug and in release, the program builds, prints `before`, and stops on a trap saying `report`.
private icd_traps(text: string, before: string, report: string)
    if !icd_ready() then return

    for flag in ["--debug", "--release"]
        val (state, printed) = icd_run(text, "", flag)

        assert(printed.starts_with(before), s"$flag: $printed")
        assert(printed.contains(report), s"$flag: $printed")
        assert(state == Status.Signalled(5), s"$flag stopped with $state, having printed '$printed'")

    var back: [1]string = ["--debug"]

    assert_eq(took_search_flag(back[..], 0), 1)
end icd_traps

// In debug and in release, the program is refused with a diagnostic holding `said`.
private icd_refuses(text: string, said: string)
    if !icd_ready() then return

    for flag in ["--debug", "--release"]
        val (_, printed) = icd_run(text, "", flag)

        assert(printed.starts_with("it did not build: "), s"$flag: $printed")
        assert(printed.contains(said), s"$flag: $printed")

    var back: [1]string = ["--debug"]

    assert_eq(took_search_flag(back[..], 0), 1)
end icd_refuses

private val icd_sink: string = "struct Sink\n    buf: [4]u8\n    len: u32\n    cap: u32\n    invariant len <= cap\n\n"
private val icd_cell: string = "struct Cell\n    n: u8\n    invariant n < 10\n\n"
private val icd_main: string = "\n\n@export(\"main\")\nmain_entry() -> int = "

// -- constant data on a bare machine -------------------------------------------------------------------

// guards: a module var of a struct with an invariant, built from constants, is constant data
@test("a 'var' of a struct with an invariant, built from constants, is laid down with nothing to run")
icd_a_var_is_laid_down()
    if cfv_skip() then return

    val out = cfv_built(icd_sink + "var S = Sink([0; 4], 0, 4)" + icd_main + "int(S.len + S.cap)\n")

    cfv_laid_down(out, "@S = private global %struct.Sink { [4 x i8] zeroinitializer, i32 0, i32 4 }\n")
    assert(!out.contains("Sink.inv"), out)
end icd_a_var_is_laid_down

@test("a 'val' of one is a constant of the object file")
icd_a_val_is_laid_down()
    if cfv_skip() then return

    val out = cfv_built(icd_sink + "val V: Sink = Sink([1, 2, 3, 4], 1 + 1, 2 * 2)" + icd_main + "int(V.len)\n")

    cfv_laid_down(out, "@V = private constant %struct.Sink { [4 x i8] [i8 1, i8 2, i8 3, i8 4], i32 2, i32 4 }\n")
end icd_a_val_is_laid_down

@test("clauses over several fields, one calling a 'const' function and one with a message, are all run")
icd_several_clauses_and_a_const_call()
    if cfv_skip() then return

    val out = cfv_built("const fits(n: u32, cap: u32) -> bool = n <= cap\n\n" +
                        "struct Gate\n    lo: i32\n    hi: i32\n    invariant fits(u32(hi - lo), 100)\n" +
                        "    invariant lo <= hi, \"lo must not pass hi\"\n\n" +
                        "val G = Gate(-5, 5)" + icd_main + "G.hi\n")

    cfv_laid_down(out, "@G = private constant %struct.Gate { i32 -5, i32 5 }\n")
end icd_several_clauses_and_a_const_call

@test("a struct with an invariant inside an array inside a struct is data at that depth")
icd_nested_in_an_array_in_a_struct()
    if cfv_skip() then return

    val out = cfv_built(icd_cell + "struct Row\n    cells: [3]Cell\n    tag: u8\n\n" +
                        "val R = Row([Cell(1), Cell(2), Cell(9)], 7)" + icd_main + "int(R.cells[2].n)\n")

    cfv_laid_down(out, "@R = private constant %struct.Row { [3 x %struct.Cell] [%struct.Cell { i8 1 }, " +
                       "%struct.Cell { i8 2 }, %struct.Cell { i8 9 }], i8 7 }\n")
end icd_nested_in_an_array_in_a_struct

@test("a generic struct's clauses are run at each type it is made at")
icd_a_generic_struct()
    if cfv_skip() then return

    val out = cfv_built("struct Span[T: PartialOrd]\n    lo: T\n    hi: T\n    invariant lo <= hi\n\n" +
                        "val SI = Span[i32](-1, 1)\nval SU = Span[u8](3, 3)" + icd_main + "SI.hi + int(SU.lo)\n")

    cfv_laid_down(out, "@SI = private constant %struct.Span.int { i32 -1, i32 1 }\n")
    cfv_laid_down(out, "@SU = private constant %struct.Span.byte { i8 3, i8 3 }\n")
end icd_a_generic_struct

@test("a variant's payload holding such a struct is data, in a 'val' and in a 'var'")
icd_a_variant_payload()
    if cfv_skip() then return

    val out = cfv_built(icd_sink + icd_cell + "enum Slot\n    Empty\n    Full(c: Cell)\n    Wide(s: Sink)\n\n" +
                        "val E: Slot = Full(Cell(4))\nvar W: Slot = Wide(Sink([0; 4], 1, 2))\n\n" +
                        "@export(\"main\")\nmain_entry() -> int\n    val e = E match\n        Full(c) -> int(c.n)\n" +
                        "        _ -> 0\n    val w = W match\n        Wide(s) -> int(s.cap)\n        _ -> 0\n\n" +
                        "    e + w\n")

    cfv_laid_down(out, "@E = private constant %enum.Slot { i32 1, [3 x i32] [i32 4, i32 0, i32 0] }\n")
    cfv_laid_down(out, "@W = private global %enum.Slot { i32 2, [3 x i32] [i32 0, i32 1, i32 2] }\n")
end icd_a_variant_payload

@test("a private module value of one is data as a public one is")
icd_a_private_value()
    if cfv_skip() then return

    val out = cfv_built(icd_cell + "private val P = Cell(3)" + icd_main + "int(P.n)\n")

    cfv_laid_down(out, "@P = private constant %struct.Cell { i8 3 }\n")
end icd_a_private_value

@test("a value of another module is data where an export of this one reads it")
icd_a_value_of_another_module()
    if cfv_skip() then return

    val out = icd_built_with("module tables\n\n" + icd_cell + "val LIMIT = Cell(7)\nvar count = Cell(2)\n",
                             "import tables\n\n@export(\"main\")\n" +
                             "main_entry() -> int = int(tables.LIMIT.n + tables.count.n)\n")

    assert(out.contains("@tables$LIMIT = private constant %struct.tables$Cell { i8 7 }\n"), out)
    assert(out.contains("@tables$count = private global %struct.tables$Cell { i8 2 }\n"), out)
    assert(!out.contains("module_init"), out)
    assert(!out.contains("llvm.global_ctors"), out)
end icd_a_value_of_another_module

// -- the zero ------------------------------------------------------------------------------------------

// guards: module storage starting at a zero its invariant holds for needs no initializer
@test("storage that starts at a zero the clauses hold for is zeroed storage, with nothing to run")
icd_a_zero_that_holds()
    if cfv_skip() then return

    val out = cfv_built(icd_sink + "struct Pair\n    a: Sink\n    b: [2]Sink\n\nvar Z: Sink\nvar ZZ: Pair" + icd_main +
                        "int(Z.len + ZZ.b[1].cap)\n")

    cfv_laid_down(out, "@Z = private global %struct.Sink zeroinitializer\n")
    cfv_laid_down(out, "@ZZ = private global %struct.Pair zeroinitializer\n")
end icd_a_zero_that_holds

@test("a zero the clauses do not hold for stays code, and a bare archive says the invariant is why")
icd_a_zero_that_does_not_hold()
    if cfv_skip() then return

    val out = cfv_built("struct Open\n    lo: u32\n    hi: u32\n    invariant lo < hi\n\nvar Z: Open" + icd_main +
                        "int(Z.lo)\n")

    icd_refused(out, "Z", "'Z' starts at its zero, and what keeps it code is the 'invariant' of 'Open', " +
                          "which a zero is checked against as any other value is — and the zero does not " +
                          "satisfy it, so the check is left to trap when the program starts")
end icd_a_zero_that_does_not_hold

@test("and a hosted program with such a zero builds, and traps when it starts, as before")
icd_a_broken_zero_traps_at_startup()
    icd_traps("struct Open\n    lo: u32\n    hi: u32\n    invariant lo < hi\n\nvar Z: Open\n\n" +
              "main()\n    print(\"reached\", Z.lo)\n",
              "", "invariant of 'Open' failed: clause 'lo < hi'")

// -- clauses the compiler cannot run -------------------------------------------------------------------

// A call needs no mark to be run while compiling (`reference/ffi.md § What constant data is`), in a
// clause as in an initializer.
@test("clauses calling a function nobody marked 'const' are run where its body can be, and the value is data")
icd_an_unmarked_call_that_runs()
    if cfv_skip() then return

    val out = cfv_built("fits(n: u32, cap: u32) -> bool = n <= cap\n\n" +
                        "struct Sink\n    len: u32\n    cap: u32\n    invariant fits(len, cap)\n\n" +
                        "val K = Sink(1, 4)" + icd_main + "int(K.len)\n")

    cfv_laid_down(out, "@K = private constant %struct.Sink { i32 1, i32 4 }\n")
end icd_an_unmarked_call_that_runs

@test("clauses calling a function that cannot run while compiling leave the storage code, naming the invariant")
icd_an_unmarked_call_that_cannot_run()
    if cfv_skip() then return

    val out = cfv_built("var limit: u32 = 16\n\nfits(n: u32) -> bool = n <= limit\n\n" +
                        "struct Sink\n    len: u32\n    invariant fits(len)\n\n" +
                        "val K = Sink(1)" + icd_main + "int(K.len)\n")

    icd_refused(out, "K", "'K' is built from constants, and what keeps it code is the 'invariant' of 'Sink', " +
                          "which is checked where the value is made — 'K' cannot be computed while " +
                          "compiling: 'limit' is filled when the program runs (main.sysl:3:29) — inside " +
                          "'fits(1)', called at main.sysl:7:15; inside 'Sink.inv(1)', called at main.sysl:9:9")
end icd_an_unmarked_call_that_cannot_run

@test("clauses that do not hold, calling an unmarked function, are left to trap at startup, and a bare archive says so")
icd_unmarked_clauses_that_do_not_hold()
    if cfv_skip() then return

    val out = cfv_built("small(n: u8) -> bool = n < 10\n\nstruct Cell\n    n: u8\n    invariant small(n)\n\n" +
                        "val C = Cell(12)" + icd_main + "int(C.n)\n")

    icd_refused(out, "C", "'C' is built from constants, and what keeps it code is the 'invariant' of 'Cell', " +
                          "which is checked where the value is made — the clauses do not hold for it, and " +
                          "they call 'small', which nobody marked 'const', so the check is left to trap " +
                          "when the program starts")
end icd_unmarked_clauses_that_do_not_hold

@test("a field worked out by an unmarked call, breaking the clauses, is left to trap at startup the same way")
icd_an_unmarked_field_that_breaks_the_clauses()
    if cfv_skip() then return

    val out = cfv_built(icd_cell + "twelve() -> u8 = 12\n\nval C = Cell(twelve())" + icd_main + "int(C.n)\n")

    icd_refused(out, "C", "'C' is built from constants, and what keeps it code is the 'invariant' of 'Cell', " +
                          "which is checked where the value is made — the clauses do not hold for it, and " +
                          "it is built over a call nobody marked 'const', so the check is left to trap " +
                          "when the program starts")
end icd_an_unmarked_field_that_breaks_the_clauses

@test("and the same field, holding, is data")
icd_an_unmarked_field_that_holds()
    if cfv_skip() then return

    val out = cfv_built(icd_cell + "seven() -> u8 = 7\n\nval C = Cell(seven())" + icd_main + "int(C.n)\n")

    cfv_laid_down(out, "@C = private constant %struct.Cell { i8 7 }\n")
end icd_an_unmarked_field_that_holds

@test("clauses reading a module 'var' leave the storage code, and the refusal names the invariant and the 'var'")
icd_a_clause_reading_a_var_stays_code()
    if cfv_skip() then return

    val out = cfv_built("var limit: u32 = 16\n\nstruct Lim\n    len: u32\n    invariant len <= limit\n\n" +
                        "val M = Lim(3)" + icd_main + "int(M.len)\n")

    icd_refused(out, "M", "'M' is built from constants, and what keeps it code is the 'invariant' of 'Lim', " +
                          "which is checked where the value is made — 'M' cannot be computed while " +
                          "compiling: 'limit' is filled when the program runs (main.sysl:5:22) — inside " +
                          "'Lim.inv(3)', called at main.sysl:7:9")
end icd_a_clause_reading_a_var_stays_code

@test("a field that does not fold keeps the storage code for the field's own reason, not the invariant's")
icd_a_field_that_does_not_fold()
    if cfv_skip() then return

    val out = cfv_built("var limit: u32 = 16\n\nstruct Sink\n    len: u32\n    cap: u32\n    invariant len <= cap\n\n" +
                        "val N = Sink(limit, 32)" + icd_main + "int(N.len)\n")

    icd_refused(out, "N", "'N' reads 'limit', a module 'var', whose value is whatever the program last wrote to it")
end icd_a_field_that_does_not_fold

@test("one element whose clauses cannot be run keeps the whole array code")
icd_one_element_keeps_the_array_code()
    if cfv_skip() then return

    val out = cfv_built("var parity: u8 = 1\n\nstruct Odd\n    n: u8\n    invariant n % 2 == parity\n\n" +
                        icd_cell + "struct Mix\n    c: Cell\n    o: Odd\n\n" +
                        "val X: [2]Mix = [Mix(Cell(1), Odd(3)), Mix(Cell(2), Odd(5))]" + icd_main + "int(X[1].o.n)\n")

    assert(out.contains("is exported and reaches 'X', which is module storage an initializer fills"), out)
    assert(out.contains("'X' is built from constants, and what keeps it code is the 'invariant' of 'Odd', " +
                        "which is checked where the value is made — 'X' cannot be computed while " +
                        "compiling: 'parity' is filled when the program runs"), out)
end icd_one_element_keeps_the_array_code

// -- a construction the clauses do not hold for --------------------------------------------------------

// guards: a module construction from constants that breaks its invariant is refused while compiling
@test("a 'val' built from constants its clauses do not hold for is refused, naming the clause and the fields")
icd_a_broken_val_is_refused()
    icd_refuses("struct Sink\n    buf: [2]u8\n    len: u32\n    cap: u32\n    invariant len <= cap, \"len must fit\"\n\n" +
                "val S = Sink([0; 2], 17, 16)\n\nmain()\n    print(S.len)\n",
                "'S' traps while it is being compiled: the 'invariant' of 'Sink' does not hold for " +
                "Sink([0, 0], 17, 16): len must fit: clause 'len <= cap' at main.sysl:5:15 (main.sysl:7:9)")

@test("and so is a 'var', at the element of the array inside it that broke its own clause")
icd_a_broken_element_is_refused()
    icd_refuses(icd_cell + "struct Row\n    cells: [2]Cell\n\nvar R = Row([Cell(1), Cell(12)])\n\n" +
                "main()\n    print(R.cells[0].n)\n",
                "'R' traps while it is being compiled: the 'invariant' of 'Cell' does not hold for Cell(12): " +
                "clause 'n < 10' at main.sysl:3:15 (main.sysl:8:23)")

@test("a bare archive refuses the same construction the same way")
icd_a_broken_val_is_refused_on_a_bare_machine()
    if cfv_skip() then return

    assert_eq(cfv_built(icd_cell + "val C = Cell(10)" + icd_main + "int(C.n)\n"),
              "'C' traps while it is being compiled: the 'invariant' of 'Cell' does not hold for Cell(10): " +
              "clause 'n < 10' at main.sysl:3:15 (main.sysl:5:9)")
end icd_a_broken_val_is_refused_on_a_bare_machine

@test("a generic struct's broken construction is refused at the type it was made at")
icd_a_broken_generic_is_refused()
    icd_refuses("struct Span[T: PartialOrd]\n    lo: T\n    hi: T\n    invariant lo <= hi\n\n" +
                "val OK = Span[i32](1, 2)\nval BAD = Span[u8](4, 3)\n\nmain()\n    print(OK.lo, BAD.lo)\n",
                "'BAD' traps while it is being compiled: the 'invariant' of 'Span[")

@test("a broken construction over a call nobody marked keeps its meaning: it builds, and traps at startup")
icd_a_broken_construction_over_an_unmarked_call()
    icd_traps(icd_cell + "twelve() -> u8 = 12\n\nval C = Cell(twelve())\n\nmain()\n    print(\"reached\", C.n)\n",
              "", "invariant of 'Cell' failed: clause 'n < 10'")

@test("a broken construction whose clauses call an unmarked function builds, and traps at startup")
icd_a_broken_construction_with_unmarked_clauses()
    icd_traps("small(n: u8) -> bool = n < 10\n\nstruct Cell\n    n: u8\n    invariant small(n)\n\n" +
              "val C = Cell(12)\n\nmain()\n    print(\"reached\", C.n)\n",
              "", "invariant of 'Cell' failed: clause 'small(n)'")

// -- a function body, and a hosted program -------------------------------------------------------------

@test("the same construction in a function body is checked when it runs, and traps there")
icd_a_local_construction_traps_at_run_time()
    icd_traps(icd_cell + "main()\n    print(\"before\")\n\n    val c = Cell(12)\n\n    print(\"not reached\", c.n)\n",
              "before\n", "invariant of 'Cell' failed: clause 'n < 10'")

@test("a local 'var' built from the same constants runs, and a write that breaks the clause still traps")
icd_a_local_write_still_traps()
    icd_traps(icd_cell + "main()\n    var c = Cell(9)\n\n    print(\"before\", c.n)\n    c.n += 1\n" +
              "    print(\"not reached\", c.n)\n",
              "before 9\n", "invariant of 'Cell' failed: clause 'n < 10'")

@test("module values laid down as data read the same in debug and release, at every shape")
icd_hosted_values_are_right()
    icd_runs(icd_sink + icd_cell +
             "const fits(n: u32, cap: u32) -> bool = n <= cap\n\n" +
             "struct Gate\n    lo: i32\n    hi: i32\n    invariant fits(u32(hi - lo), 100)\n\n" +
             "struct Row\n    cells: [3]Cell\n    tag: u8\n\n" +
             "struct Span[T: PartialOrd]\n    lo: T\n    hi: T\n    invariant lo <= hi\n\n" +
             "enum Slot\n    Empty\n    Full(c: Cell)\n    Wide(s: Sink)\n\n" +
             "var S = Sink([0; 4], 0, 4)\nval V: Sink = Sink([1, 2, 3, 4], 2, 4)\nval G = Gate(-5, 5)\n" +
             "val R = Row([Cell(1), Cell(2), Cell(9)], 7)\nval SI = Span[i32](-1, 1)\nval SU = Span[u8](3, 3)\n" +
             "val E: Slot = Full(Cell(4))\nprivate val P = Cell(3)\nvar Z: Sink\n\n" +
             "main()\n    val e = E match\n        Full(c) -> int(c.n)\n        _ -> 0\n\n" +
             "    S.len += 3\n    Z.cap = 8\n    Z.len = 8\n" +
             "    print(S.len, S.cap, V.buf[3], V.len, G.lo, G.hi, R.cells[2].n, R.tag, SI.lo, SU.hi, e, P.n, Z.len)\n",
             "", "3 4 4 2 -5 5 9 7 -1 3 4 3 8\n")
end icd_hosted_values_are_right

@test("a module 'var' laid down as data is still checked at every write")
icd_a_module_write_still_traps()
    icd_traps(icd_sink + "var S = Sink([0; 4], 0, 4)\n\nmain()\n    print(\"before\", S.len)\n    S.len = 5\n" +
              "    print(\"not reached\")\n",
              "before 0\n", "invariant of 'Sink' failed: clause 'len <= cap'")

@test("a value of another module reads the same in a hosted program, in debug and release")
icd_another_modules_value_runs()
    icd_runs("import tables\n\nmain()\n    tables.count.n += 1\n    print(tables.LIMIT.n, tables.count.n)\n",
             "module tables\n\n" + icd_cell + "val LIMIT = Cell(7)\nvar count = Cell(2)\n",
             "7 3\n")
