module sh.sysl.compiler

import sh.sysl.parsing.Source
import sysl.buf.{Buf, buf}
import sysl.text.{str_builder, Search}
import sysl.fs.{make_temp_dir, remove_dir_all, remove_file}
import sysl.process.{run as run_child, Status}

// What one invocation compiles: the program's files, the packages it depends on, and the standard
// module every program is compiled against.
//
// **A program is not a file, and this is where that becomes true.** Everything below the parser is
// handed a list of trees; here is where the list is assembled, in the order the questions can be
// answered in -- the manifest first, because it says which machine and which packages, then the
// files under the path the command line named, then the library.

// A whole compilation, ready to be analyzed.
struct Compilation
    // The library's trees first, then the packages', then the program's. Nothing depends on the
    // order -- a module's declarations are one set however many files they came from -- but a report
    // about the program's own files is easier to find at the end of a list than in the middle.
    units: Buf[Program]

    // The modules the program declares of its own, which is what tells a row the program filed from
    // one the library did.
    own: Buf[string]

    target: Target
end Compilation

// What a compilation could not be assembled from: a path that will not read, a manifest that will
// not parse, a library that is not on this machine, a dependency nobody fetched.
//
// **It is not a diagnostic**, because none of these has a source position to point at: they are
// statements about the *project* rather than about a line somebody wrote.
struct Refusal
    message: string
end Refusal

// Everything one invocation reads, given the path the command line named and the machine it is for.
//
// **A dependency's modules keep the names they were written with here**, which is what `emit-typed`
// and `sysl prove` read: both stop at the typed tree, and what they are for is comparing what a
// module *means* rather than what it links against. The canonical prefix is what `emit-llvm` and a
// build read, and `packaged_compilation_of` is that.
compilation_of(path: string, t: Target) -> Result[Compilation, Refusal] =
    assembled(path, t, false)

// The same, with each fetched package's modules under the canonical prefix its coordinate gives
// them -- which is what makes two consumers naming one package differently link one copy of it, and
// is therefore what everything that emits a symbol reads.
packaged_compilation_of(path: string, t: Target) -> Result[Compilation, Refusal] =
    assembled(path, t, true)

private assembled(path: string, t: Target, packaged: bool) -> Result[Compilation, Refusal]
    val root = if is_directory(path) then path else parent_of(path).unwrap_or(".")
    val manifest = manifest_at(root)?

    // What the package says it cannot be built without, asked of the machine it is being built for.
    // Answered here rather than in the analyzer because it is a statement about the project: there
    // is no source position to point at, and a build that cannot mean anything should stop before
    // it parses a line.
    unmet_requirement(manifest, t) match
        None -> ()
        Some(why) -> return Err(Refusal(why))

    val mine = collect(path, Some(t.os)) match
        Err(e) -> return Err(Refusal(e.message))
        Ok(f) -> f

    if mine.is_empty()
        return Err(Refusal(s"$path holds no sysl source files"))

    var units: Buf[Program] = buf()

    // The library first, so that every name a program's free identifier reaches is declared before
    // the program is read. It is read from **source**, for the target being built for: which files
    // the library has at all is a per-target question.
    val library = std_root() match
        Err(why) -> return Err(Refusal(why))
        Ok(dir) -> dir

    val std = std_units(library, t) match
        Err(why) -> return Err(Refusal(why))
        Ok(u) -> u

    for i in 0..<std.len()
        units.push(std.at(i))

    // Then the packages, each read off disk from where a fetch would have put it.
    val fetched = package_units(root, manifest, t, packaged)?

    for i in 0..<fetched.len()
        units.push(fetched.at(i))

    // What the project's own files mean by the paths at the head of their import lines. The project
    // itself has no prefix -- its modules keep the names they were written with -- and what it has
    // instead is the table its manifest's `dependencies` block built.
    var mine_pkg = no_packaging()

    if packaged then mine_pkg = Packaging("", package_mounts(root, manifest))

    var own: Buf[string] = buf()

    // Then the program's own files, its `@tests` files among them. A test body is analyzed like
    // every other -- it is code somebody wrote, held to the same rules -- and what a `@tests` file
    // declares is *marked* rather than dropped, so that an ordinary body reaching one of those names
    // is something to report about rather than a name that was never there.
    for i in 0..<mine.len()
        val parsed = parse(mine.at(i).src, t)

        if !parsed.ok()
            return Err(Refusal(s"${mine.at(i).src.name}:${parsed.at()}: ${parsed.first().message}"))

        var unit = parsed.program

        unit.pkg = mine_pkg
        units.push(unit)
        own.push(module_written(unit))

    Ok(Compilation(units, own, t))
end assembled

// The module a file contributes to: what its header says, or the anonymous root module where it
// declares none.
module_written(unit: Program) -> string =
    if unit.module_name.is_none() then "" else unit.module_name.unwrap().show()

// A module is a directory, and its name is that directory's path below the project root -- so a
// file's header has to agree with where the file sits.
//
// **Checking the header against the location subsumes checking a directory's files against each
// other**: they are each held to the same derived name, so a file edited without its siblings is
// reported on its own line rather than as a disagreement with whichever sibling was read first.
check_locations(found: Buf[Found], units: Buf[Program]) -> Buf[string]
    var out: Buf[string] = buf()

    for i in 0..<found.len()
        val expected = dotted(found.at(i).dir)
        val declared = module_written(units.at(i))

        if declared != expected
            val theirs = if declared == "" then "declares no module" else s"declares '$declared'"
            val here = if expected == "" then "sits at the project root" else s"sits in '$expected'"

            out.push(s"${found.at(i).src.name} $theirs, but it $here -- a module is a directory, " +
                "so the two must agree")

    out
end check_locations

private dotted(parts: Buf[string]) -> string
    var out = ""

    for i in 0..<parts.len()
        if i > 0 then out = out + "."

        out = out + parts.at(i)

    out
end dotted

// `sysl emit-typed [--no-spans] [--tables] [--target <name>] <path>` -- one program's typed tree,
// written out as deterministic text, or its declaration tables under `--tables`.
//
// **It stops at the same typed tree a proof reads, and for the same reason**: analysis has already
// checked every rule that could fail, and nothing past this point -- pruning, lowering, codegen --
// is needed to answer whether two compilers agree on what a program means.
//
// The path is a **program** rather than a file: a directory is the project root and everything below
// it is compiled, and a single file is compiled alone as the root module. Either way the standard
// module is read from source and analyzed with it, so the library's declarations are in scope
// exactly as they are for a build.
emit_typed_text(path: string, named_target: Option[string],
                tables: bool) -> Result[Emitted, Refusal]
    val root = if is_directory(path) then path else parent_of(path).unwrap_or(".")
    val manifest = manifest_at(root)?

    val chosen = named_target match
        Some(name) -> name
        None -> manifest.default_target

    val t = if chosen == "" then host_target()
    else target_resolved(chosen) match
        Err(why) -> return Err(Refusal(why))
        Ok(found) -> found

    check_floor(who_of(manifest, path), manifest.floor, Version) match
        None -> ()
        Some(why) -> return Err(Refusal(why))

    val program = compilation_of(path, t)?

    if tables then Ok(Emitted(tables_text(program), buf(), buf())) else Ok(typed_text(program))
end emit_typed_text

// `sysl emit-llvm [--target <name>] <path>` -- one program's LLVM text.
//
// **It is the same command line the reference compiler answers**, so agreement between the two is
// one `diff` and a disagreement names the line. What this compiler lowers today is the module
// header and the named types a program's values are stored at; the sections a function body fills
// are empty, which is what makes the comparison one of a section rather than of a whole.
emit_llvm_text(path: string, named_target: Option[string]) -> Result[Emitted, Refusal]
    val t = target_for(path, named_target)?
    val program = packaged_compilation_of(path, t)?
    val done = analyze_bodies(program.units, program.target)

    // Everything a program is held to on the way to being lowered runs on the **unpruned** tree: a
    // declaration nothing can reach is still one the program declared, and checking it is what makes
    // a mistake in it a mistake at all.
    val whole = program_of(done, done.main_module)

    val promotions = post_analysis_checks(done.an, whole, program.own)

    // The tests go next, and they go **after** the analysis rather than instead of it: a `@test`
    // that does not compile is an error in a build that would never have run it, which is what makes
    // it safe to leave one beside the code it tests. Pruning is then the last thing that happens to
    // the tree and the only thing between the checks and the lowering.
    val kept = prune(strip_tests(whole), program.own)

    // **What the library already compiled**, so this module declares those rather than defining them
    // a second time; their bodies arrive from the artifact at link time. It is asked after the
    // pruning and not before: a library function this program never calls is dropped exactly as it
    // was, and what `precompiled` changes is only what happens to the ones it does call.
    val linked = std_artifact(t) match
        Err(why) -> return Err(Refusal(why))
        Ok(found) -> found

    val lowered = codegen_with_gaps(kept with { precompiled = linked.precompiled }, t, promotions)

    // Read back out of the analysis rather than off the snapshot the body pass answered with: the
    // checks above have just added to it.
    Ok(Emitted(ir_print_module(lowered.0), errors_of(done.an.diagnostics()), lowered.1))
end emit_llvm_text

// The machine a command line asked for: the one it named, the manifest's default, or this host --
// with the floor the manifest states checked before anything is read.
private target_for(path: string, named_target: Option[string]) -> Result[Target, Refusal]
    val root = if is_directory(path) then path else parent_of(path).unwrap_or(".")
    val manifest = manifest_at(root)?

    val chosen = named_target match
        Some(name) -> name
        None -> manifest.default_target

    val t = if chosen == "" then host_target()
    else target_resolved(chosen) match
        Err(why) -> return Err(Refusal(why))
        Ok(found) -> found

    check_floor(who_of(manifest, path), manifest.floor, Version) match
        None -> ()
        Some(why) -> return Err(Refusal(why))

    Ok(t)
end target_for

// What `emit-typed` came to: the text to print, and what the analyzer had to say. A program the
// compiler refused prints nothing on standard output, exactly as every compiling command does.
struct Emitted
    text: string
    report: Buf[Placed]

    // The bodies the lowering left out, each as its key and the form it reached. It is empty for
    // every command but `emit-llvm`, and there only while some form is still unbuilt -- what a
    // partial lowering owes is a census of what it did not say, so that the differential proof can
    // tell an absence from a wrong answer.
    gaps: Buf[(string, string)]
end Emitted

// What the reader has to act on when a floor refuses a build: a package's name and version, or the
// path itself where the manifest named neither.
private who_of(m: Manifest, path: string) -> string =
    if m.name == "" then s"'$path'"
    else if m.version == "" then s"'${m.name}'"
    else s"'${m.name}' ${m.version}"

// The typed tree: every body this compilation could type, in the `funcs:` section the reference
// compiler prints them in.
//
// **The sections around it are what reachability decides**, which is the stage above this one: a
// reference tree holds only the structs, enums and functions a program *reaches*, so printing the
// whole set here would be printing a different question's answer.
private typed_text(c: Compilation) -> Emitted
    val done = analyze_bodies(c.units, c.target)

    Emitted(show_typed_program(program_of(done, done.main_module)), errors_of(done.reported), buf())
end typed_text

// Whether a body is one a program **emits**, which is the question a printed tree answers.
//
// An instantiation at a **type parameter** is a diagnostic shape rather than a laid-out one: the
// walk that reads a generic body once at its own definition builds one, and no value at run time
// has that type. It has no layout to emit, so it is left out here rather than reaching a back end
// that would have to invent one.
private emitted_body(f: TFunc) -> bool
    for i in 0..<f.params.len()
        if mentions_abstract(f.params.at(i).1) then return false

    !mentions_abstract(f.ret_ty)
end emitted_body

// The declaration tables, for the modules this program declares of its own.
private tables_text(c: Compilation) -> string
    val a = analysis_for(c.target)

    read_decls(a, c.units)
    show_funcs_table_of(a, c.own)
end tables_text

// `sysl build [--target <name>] [--cc <path>] [-O<level>] [-o <exe>] <path>` -- one program,
// compiled and linked into something the machine will run.
//
// **Emission ends at LLVM text and a build does not.** What is decided here is the whole of the rest:
// which clang, what C the tree carried, and what is on the link line. The text itself is exactly what
// `emit-llvm` prints, so a build and a diff are the same lowering seen twice.
//
// The library's own C is compiled beside the program's, because this compiler defines the library's
// functions rather than declaring them against an artifact somebody already built -- so whatever
// those definitions call into has to be here too.
build_native_program(path: string, named_target: Option[string], cc: Option[string], level: string,
                     out: Option[string]) -> Result[string, Refusal]
    val t = target_for(path, named_target)?

    // Asked **before** anything is lowered: the reader asked for a build of a machine that cannot be
    // built, which is one mistake with one answer, and a failure deep in the toolchain would
    // describe the last step rather than the first.
    if !t.builds_with_clang() then return Err(Refusal(t.no_toolchain()))

    val emitted = emit_llvm_text(path, named_target)?

    if !emitted.report.is_empty() then return Err(Refusal(analysis_report(emitted.report)))

    val exe = out match
        Some(named) -> named
        None -> default_executable(path)

    link_lowered_text(path, emitted.text, t, cc, level, exe)?
    Ok(exe)
end build_native_program

// The tail every command that produces a binary shares: the clang, the tree's own C, the standard
// module's archive, and the link.
//
// **It is one function because a test build and an ordinary one have to link the same way.** A
// package's tests are exactly what exercises the C it ships, so a test run that got a different link
// line would fail on the one tree most likely to have one -- which is the tree whose author is
// running `sysl test`.
private link_lowered_text(path: string, text: string, t: Target, cc: Option[string], level: string,
                          exe: string) -> Result[unit, Refusal]
    val clang = find_clang(t, cc) match
        Err(why) -> return Err(Refusal(why))
        Ok(found) -> found

    val objects = native_objects(clang, path, exe, t, level)?

    // **The standard module is linked rather than compiled**, which is `precompiled` seen from the
    // other end: the text above declares the library's determined half, and the archive is where
    // those bodies -- and the library's own C, compiled when the artifact was -- come from. A
    // `.syslib` **is** an archive, so it goes on the link line as it stands and the linker takes only
    // the members that resolve something.
    var link_with = objects

    std_artifact(t) match
        Err(why) ->
            discard_objects(objects)
            return Err(Refusal(why))
        Ok(found) -> link_with.push(found.archive)

    build_native(clang, text, link_with, exe, t, level) match
        Err(why) ->
            discard_objects(objects)
            return Err(Refusal(why))
        Ok(_) -> ()

    discard_objects(objects)
    Ok(())
end link_lowered_text

// `sysl run [--target <name>] [--cc <path>] [-O<level>] <path> [-- <args>]` -- one program, built and
// then executed, with the shell hearing whatever the program exited with.
//
// **A build for a machine that is not this one is refused here rather than built and then found
// unrunnable**: what the reader asked for cannot be carried out, and the answer names the command
// that can.
//
// The binary is a temporary of this run. The reference keeps what it built in a cache keyed over
// everything that can reach the bytes; this compiler rebuilds, which costs time and cannot hand back
// a binary made by a compiler that has since changed.
run_native_program(path: string, named_target: Option[string], cc: Option[string], level: string,
                   args: Buf[string]) -> Result[int, Refusal]
    val t = target_for(path, named_target)?

    not_this_machine(t, "run")?

    val emitted = emit_llvm_text(path, named_target)?

    if !emitted.report.is_empty() then return Err(Refusal(analysis_report(emitted.report)))

    val staging = make_temp_dir("sysl-run-") match
        Err(_) -> return Err(Refusal("no directory to build in"))
        Ok(dir) -> dir

    val exe = join_path(staging, "program")

    link_lowered_text(path, emitted.text, t, cc, level, exe) match
        Err(why) ->
            remove_dir_all(staging).unwrap_or(())
            return Err(why)
        Ok(_) -> ()

    // `run` rather than `capture`, and the difference is the whole of what this command is for: the
    // child shares this program's streams, so its input is the reader's and what it writes is read as
    // it is written.
    val state = run_child(exe, args.view(), "", []) match
        Err(_) ->
            remove_dir_all(staging).unwrap_or(())
            return Err(Refusal(s"$exe could not be run"))
        Ok(how) -> how

    remove_dir_all(staging).unwrap_or(())
    Ok(shell_status(state))
end run_native_program

// What a shell hears when a child ends. A signal has no exit status of its own, and `128 + n` is what
// every shell reports for one -- so it is what a caller reading this number will already be
// expecting.
shell_status(state: Status) -> int = state match
    Exited(code) -> code
    Signalled(signal) -> 128 + signal

// The refusal `run` and `test` share, and the reason they share it: both execute what they build, and
// only this machine can execute anything.
private not_this_machine(t: Target, command: string) -> Result[unit, Refusal]
    if t.name == host_target().name then return Ok(())

    val does = if command == "run" then "executes" else "runs"

    Err(Refusal(s"'$command' $does what it builds, and '${t.name}' is not this machine — use " +
        s"'sysl build --target ${t.name}'"))
end not_this_machine

// What a test build comes to: the text to link, the tests the binary can be asked for by name, and
// the machine it was built for.
struct TestBuild
    emitted: Emitted
    tests: Buf[TTest]
    target: Target
end TestBuild

// `sysl test [--target <name>] <path>` -- the same program lowered as a **test build**.
//
// **It keeps the `@test` functions every other build drops, and it lowers a different entry point**:
// the dispatcher that runs one test by name, which is what lets a runner pay one process per test and
// so learn the verdict of every one of them rather than of the first that traps.
//
// The analysis in front of it is the analysis every other build gets, and that is deliberate: a test
// is code somebody wrote and is held to the same rules.
test_build_of(path: string, named_target: Option[string]) -> Result[TestBuild, Refusal]
    val t = target_for(path, named_target)?

    not_this_machine(t, "test")?

    if !t.builds_with_clang() then return Err(Refusal(t.no_toolchain()))

    val program = packaged_compilation_of(path, t)?
    val done = analyze_bodies(program.units, program.target)
    val whole = program_of(done, done.main_module)
    val promotions = post_analysis_checks_of_tests(done.an, whole, program.own)
    val kept = tests_only(whole, program.own)

    val linked = std_artifact(t) match
        Err(why) -> return Err(Refusal(why))
        Ok(found) -> found

    val lowered = codegen_with_gaps(kept with { precompiled = linked.precompiled }, t, promotions)
    val emitted = Emitted(ir_print_module(lowered.0), errors_of(done.an.diagnostics()), lowered.1)

    Ok(TestBuild(emitted, kept.tests, t))
end test_build_of

// A test binary, linked exactly as a program is, in a directory of its own.
//
// **It is a temporary of this run and the runner outlives the link**, since a process is started per
// test: what is handed back is the path, and `discard_test_binary` is what takes the directory away
// once the last test has had its verdict.
build_test_binary(path: string, build: TestBuild, cc: Option[string],
                  level: string) -> Result[string, Refusal]
    val staging = make_temp_dir("sysl-test-") match
        Err(_) -> return Err(Refusal("no directory to build the tests in"))
        Ok(dir) -> dir

    val exe = join_path(staging, "tests")

    link_lowered_text(path, build.emitted.text, build.target, cc, level, exe) match
        Err(why) ->
            remove_dir_all(staging).unwrap_or(())
            return Err(why)
        Ok(_) -> Ok(exe)
end build_test_binary

// The directory a test binary was built in, taken away. The binary is the only thing in it, so the
// directory is what there is to remove.
discard_test_binary(exe: string)
    parent_of(exe) match
        Some(dir) -> remove_dir_all(dir).unwrap_or(())
        None -> remove_file(exe)

// Where a build puts what it made, when nothing said: the program is the product, so it is named for
// the directory it was written in, and a single file for the file itself.
private default_executable(path: string) -> string
    val name = basename(path)

    if !is_sysl_file(name) then return s"./$name"

    var at = name.bytes.len

    for i in 0..<name.bytes.len
        if name.bytes[i] == u8('.') then at = i

    s"./${name[0..<at]}"
end default_executable

// Every `.c` the program's own tree carries, compiled for this machine.
//
// **The library's is not here, because the artifact carries it already compiled.** Each of a
// library's C files is a member of its `.syslib`, put there when the artifact was built, so the
// linker pulls one in the way it pulls anything else in: because something left its symbol
// undefined.
private native_objects(clang: string, path: string, exe: string, t: Target,
                       level: string) -> Result[Buf[string], Refusal]
    var trees: Buf[string] = buf()

    if is_directory(path) then trees.push(path)

    // And every package this project takes, which carries its own `.c` on the same terms the program
    // does -- a binding is a sysl surface over C, so the C is part of what was fetched. A manifest
    // that will not read is not a refusal here: whatever needed it has already said so, and a build
    // that got this far read one.
    val root = if is_directory(path) then path else parent_of(path).unwrap_or(".")

    manifest_at(root) match
        Ok(m) ->
            val roots = package_roots(root, m)

            for i in 0..<roots.len()
                trees.push(roots.at(i))
        Err(_) -> ()

    var objects: Buf[string] = buf()
    var n = 0

    for i in 0..<trees.len()
        val found = c_sources(trees.at(i), Some(t.os)) match
            Err(e) -> return Err(Refusal(e.message))
            Ok(cs) -> cs

        for j in 0..<found.len()
            val obj = s"$exe.$n.o"

            n += 1

            compile_c(clang, found.at(j), obj, t, level) match
                Err(why) ->
                    discard_objects(objects)
                    return Err(Refusal(why))
                Ok(_) -> objects.push(obj)

    Ok(objects)
end native_objects

private discard_objects(objects: Buf[string])
    for i in 0..<objects.len()
        remove_file(objects.at(i))
