module sysl.softfloat.binary64
@tests

import sysl.rand.{Rng, rng}

// The binary64 routines' arithmetic, called on encodings.
//
// **The oracle is the host's own double unit**, which had nothing to do with this file: thousands of
// random pairs over the whole encoding -- every exponent, both signs, subnormals, infinities, NaNs --
// must come back bit for bit what the hardware answers, a NaN matching a NaN. A board runs the same
// routines through the exports (`tests_qmu_qemu_run.sysl`); this is where every case is affordable.

private same(a: u64, b: real) -> bool = a == b.bits() || (real.from_bits(a) != real.from_bits(a) && b != b)

private any_double(g: *Rng) -> real = real.from_bits(g.next_u64())

@test("+ - * / of random doubles agree with the double unit")
random_pairs_agree_with_hardware()
    var g = rng(64, 7)

    for step in 0..<20000
        val a = any_double(&g)
        val b = any_double(&g)

        assert(same(add(a.bits(), b.bits()), a + b), s"$a + $b")
        assert(same(sub(a.bits(), b.bits()), a - b), s"$a - $b")
        assert(same(mul(a.bits(), b.bits()), a * b), s"$a * $b")
        assert(same(div(a.bits(), b.bits()), a / b), s"$a / $b")

@test("and so do pairs close in magnitude, where subtraction cancels and rounding ties")
random_near_pairs_agree_with_hardware()
    var g = rng(65, 7)

    for step in 0..<20000
        val a = any_double(&g)
        val b = real.from_bits(a.bits() ^ (g.next_u64() & 0xFFFF))

        assert(same(sub(a.bits(), b.bits()), a - b), s"$a - $b")
        assert(same(add(a.bits(), b.bits()), a + b), s"$a + $b")
        assert(same(div(a.bits(), b.bits()), a / b), s"$a / $b")
        assert(same(mul(a.bits(), b.bits()), a * b), s"$a * $b")

@test("small operands, whose products and quotients land among the subnormals")
random_subnormal_results_agree_with_hardware()
    var g = rng(66, 7)

    for step in 0..<20000
        // Exponents near the bottom of the range, so results underflow into the subnormals.
        val a = real.from_bits(g.next_u64() & 0x81FF_FFFF_FFFF_FFFF)
        val b = real.from_bits((g.next_u64() & 0x803F_FFFF_FFFF_FFFF) | 0x3C00_0000_0000_0000)

        assert(same(mul(a.bits(), b.bits()), a * b), s"$a * $b")
        assert(same(div(a.bits(), b.bits()), a / b), s"$a / $b")
        assert(same(add(a.bits(), b.bits()), a + b), s"$a + $b")

@test("comparisons agree with the double unit, NaN and the two zeros included")
random_comparisons_agree_with_hardware()
    var g = rng(67, 7)

    for step in 0..<20000
        val a = if step % 7 == 0 then 0.0 else any_double(&g)
        val b = if step % 11 == 0 then -0.0 else if step % 13 == 0 then a else any_double(&g)

        assert((compare(a.bits(), b.bits(), 1) < 0) == (a < b), s"$a < $b")
        assert((compare(a.bits(), b.bits(), 1) <= 0) == (a <= b), s"$a <= $b")
        assert((compare(a.bits(), b.bits(), -1) > 0) == (a > b), s"$a > $b")
        assert((compare(a.bits(), b.bits(), -1) >= 0) == (a >= b), s"$a >= $b")
        assert((compare(a.bits(), b.bits(), 1) == 0) == (a == b), s"$a == $b")
        assert(unordered(a.bits(), b.bits()) == (a != a || b != b), s"$a unordered $b")

@test("to and from the integers agree with the double unit")
random_integers_agree_with_hardware()
    var g = rng(68, 7)

    for step in 0..<20000
        val n = i64(g.next_u64() >> (1 + g.next_u64() % 63))
        val m = if step % 2 == 0 then n else -n
        val u = g.next_u64() >> (g.next_u64() % 64)

        assert(from_signed(m) == real(m).bits(), s"long $m")
        assert(from_unsigned(u) == real(u).bits(), s"ulong $u")
        assert(single_from_signed(m) == f32(m).bits(), s"long $m as f32")
        assert(single_from_unsigned(u) == f32(u).bits(), s"ulong $u as f32")

        val x = any_double(&g)

        if x == x && x > -9.0e18 && x < 9.0e18 then assert(to_signed(x.bits(), 64) == long(x), s"$x")
        if x == x && x > -2.0e9 && x < 2.0e9 then assert(to_signed(x.bits(), 32) == i64(int(x)), s"$x")
        if x == x && x >= 0.0 && x < 1.8e19 then assert(to_unsigned(x.bits(), 64) == ulong(x), s"$x")
        if x == x && x >= 0.0 && x < 4.0e9 then assert(to_unsigned(x.bits(), 32) == u64(uint(x)), s"$x")

@test("to and from f32 agree with the double unit")
random_singles_agree_with_hardware()
    var g = rng(69, 7)

    for step in 0..<20000
        val f = f32.from_bits(u32(g.next_u64() >> 32))
        val wide = widen_single(f.bits())

        assert(same(wide, real(f)), s"f32 ${f.bits()} widened")

        val x = any_double(&g)
        val narrow = narrow_single(x.bits())

        assert(narrow == f32(x).bits() || (x != x && f32.from_bits(narrow) != f32.from_bits(narrow)),
               s"$x narrowed")

private half_to_single(x: u16) -> u32 = narrow_single(widen_half(x))

private single_to_half(x: u32) -> u16 = narrow_half(widen_single(x))

private double_to_half(x: u64) -> u16 = narrow_half(x)

@test("every binary16 encoding widens to the double and the f32 the host widens it to")
every_half_widens_as_the_host_does()
    for b in 0..<65536
        val h = f16.from_bits(u16(b))
        val d = real(h)
        val f = f32(h)

        assert(same(widen_half(u16(b)), d), s"half $b widened")
        assert(half_to_single(u16(b)) == f.bits() || (f != f && f32.from_bits(half_to_single(u16(b))) != f32.from_bits(half_to_single(u16(b)))),
               s"half $b to f32")

@test("a double and an f32 narrow to the binary16 the host rounds them to")
random_doubles_and_singles_narrow_to_half_as_the_host_does()
    var g = rng(71, 9)

    for step in 0..<40000
        val x = any_double(&g)
        val h = f16(x)
        val got = f16.from_bits(double_to_half(x.bits()))

        assert(got.bits() == h.bits() || (x != x && got != got), s"$x narrowed to half")

        val f = f32.from_bits(u32(g.next_u64() >> 32))
        val hf = f16(f)
        val gotf = f16.from_bits(single_to_half(f.bits()))

        assert(gotf.bits() == hf.bits() || (f != f && gotf != gotf), s"f32 ${f.bits()} narrowed to half")

@test("binary16 edges: ties to even, the subnormal and normal boundary, overflow and underflow")
half_edges()
    // 2049 sits halfway between 2048 and 2050 (spacing 2): ties to the even 2048; 2051 to 2052.
    assert(double_to_half(2049.0.bits()) == 0x6800)
    assert(double_to_half(2051.0.bits()) == 0x6802)
    // 65504 is the largest half; 65520 is halfway to 65536 and rounds up to infinity.
    assert(double_to_half(65504.0.bits()) == 0x7BFF)
    assert(double_to_half(65519.0.bits()) == 0x7BFF)
    assert(double_to_half(65520.0.bits()) == 0x7C00)
    assert(double_to_half((-65520.0).bits()) == 0xFC00)
    // The smallest subnormal is 2^-24, and half of it is a tie to even zero; just over rounds up.
    assert(double_to_half(0x3E70_0000_0000_0000) == 0x0001)
    assert(double_to_half(0x3E60_0000_0000_0000) == 0x0000)
    assert(double_to_half(0x3E60_0000_0000_0001) == 0x0001)
    // Halfway between the largest subnormal and the smallest normal rounds to the even one, the normal.
    assert(double_to_half(0x3F0F_FC00_0000_0000) == 0x0400)
    assert(double_to_half(0x3F0F_FBFF_FFFF_FFFF) == 0x03FF)
    assert(double_to_half(0x3F10_0000_0000_0000) == 0x0400)
    assert(double_to_half((-0.0).bits()) == 0x8000)
    assert(double_to_half(0x7FF0_0000_0000_0000) == 0x7C00)
    assert(double_to_half(0x7FF0_0000_0000_0001) == 0x7E00)
    assert((half_to_single(0x7C01) & 0x7FC0_0000) == 0x7FC0_0000)

@test("the edges: zeros, infinities, NaNs, the ends of the range, and a tie rounded to even")
edges()
    val inf: u64 = 0x7FF0_0000_0000_0000
    val nan: u64 = 0x7FF8_0000_0000_0000
    val one = 1.0.bits()

    // Infinity minus itself and zero times infinity have no value; a NaN operand comes back quiet with
    // its payload.
    assert(sub(inf, inf) == nan)
    assert(mul(inf, 0) == nan)
    assert(div(0, 0) == nan)
    assert(add(0x7FF0_0000_0000_0001, one) == 0x7FF8_0000_0000_0001)

    // The two zeros: a sum is negative only where both are, and a difference that cancels is positive.
    assert(add((-0.0).bits(), (-0.0).bits()) == (-0.0).bits())
    assert(add((-0.0).bits(), 0) == 0)
    assert(sub(one, one) == 0)

    // Past the largest finite value is an infinity; the least subnormal halved is a tie to zero.
    assert(mul(0x7FEF_FFFF_FFFF_FFFF, 2.0.bits()) == inf)
    assert(mul(1, 0.5.bits()) == 0)
    assert(mul(3, 0.5.bits()) == 2)

    // 1 + 2^-53 is exactly half way to the next double, and rounds to the even neighbour: 1.
    assert(add(one, 0x3CA0_0000_0000_0000) == one)
    assert(add(0x3FF0_0000_0000_0001, 0x3CA0_0000_0000_0000) == 0x3FF0_0000_0000_0002)

    assert(add(0.1.bits(), 0.2.bits()) == 0x3FD3_3333_3333_3334)

    // Beyond the integer types: the ends, a NaN, and a negative value into an unsigned one.
    assert(to_signed(inf, 64) == 0x7FFF_FFFF_FFFF_FFFF)
    assert(to_signed((-1.0e300).bits(), 32) == -2147483648)
    assert(to_unsigned((-1.0).bits(), 64) == 0)
    assert(to_unsigned(1.0e300.bits(), 32) == 0xFFFF_FFFF)
    assert(from_signed(-0x7FFF_FFFF_FFFF_FFFF - 1) == 0xC3E0_0000_0000_0000)
    assert(from_unsigned(0xFFFF_FFFF_FFFF_FFFF) == 0x43F0_0000_0000_0000)
    assert(from_signed(0) == 0)

// -- binary32, between a widening and a narrowing ----------------------------------------------------

private same_single(a: u32, b: f32) -> bool =
    a == b.bits() || (f32.from_bits(a) != f32.from_bits(a) && b != b)

// Any encoding, and one near it: every exponent, both signs, subnormals, infinities, NaNs, and the
// pairs where subtraction cancels and rounding ties.
@test("+ - * / of random f32 pairs agree with the float unit")
random_single_pairs_agree_with_hardware()
    var g = rng(66, 7)

    for step in 0..<40000
        val a = f32.from_bits(u32(g.next_u64() >> 32))
        val b = if step % 2 == 0 then f32.from_bits(u32(g.next_u64() >> 32))
                else f32.from_bits(a.bits() ^ u32(g.next_u64() & 0xFF))

        assert(same_single(add_single(a.bits(), b.bits()), a + b), s"$a + $b")
        assert(same_single(sub_single(a.bits(), b.bits()), a - b), s"$a - $b")
        assert(same_single(mul_single(a.bits(), b.bits()), a * b), s"$a * $b")
        assert(same_single(div_single(a.bits(), b.bits()), a / b), s"$a / $b")

@test("f32 at the edges: ties to even, the subnormals, overflow, and the 32-bit integer conversions")
single_edges()
    val one: u32 = 0x3F80_0000

    // 1 + 2^-24 is half way to the next float, and rounds to the even neighbour: 1.
    assert(add_single(one, 0x3380_0000) == one)
    assert(add_single(0x3F80_0001, 0x3380_0000) == 0x3F80_0002)

    // The largest finite value doubled is an infinity; the least subnormal halved ties to zero.
    assert(mul_single(0x7F7F_FFFF, 0x4000_0000) == 0x7F80_0000)
    assert(mul_single(1, 0x3F00_0000) == 0)
    assert(mul_single(3, 0x3F00_0000) == 2)
    assert(div_single(0, 0) & 0x7FC0_0000 == 0x7FC0_0000)

    assert(single_from_signed(i64(-0x7FFF_FFFF - 1)) == 0xCF00_0000)
    assert(single_from_unsigned(u64(0xFFFF_FFFF)) == 0x4F80_0000)
    assert(to_signed(widen_single(0x4F00_0000), 32) == 2147483647)
    assert(to_signed(widen_single(0xC2F6_E979), 32) == -123)
    assert(to_unsigned(widen_single(0xBF80_0000), 32) == 0)

// -- the fused multiply-add -------------------------------------------------------------------------
//
// The oracle is the host's own fused instruction, reached as the intrinsic: AArch64's `fmadd` is
// correctly rounded at both widths, and no part of it is this file's.

private const NEGATIVE: u64 = 0x8000_0000_0000_0000
private const POSITIVE_INFINITY: u64 = 0x7FF0_0000_0000_0000
private const DEFAULT_NAN: u64 = 0x7FF8_0000_0000_0000
private const ONE_POINT_ZERO: u64 = 0x3FF0_0000_0000_0000

private extern "llvm.fma" hardware_fma(a: real, b: real, c: real) -> real
private extern "llvm.fma" hardware_fmaf(a: f32, b: f32, c: f32) -> f32

@test("a fused multiply-add of random doubles agrees with the fused instruction")
random_fused_agree_with_hardware()
    var g = rng(68, 7)

    for step in 0..<40000
        val a = any_double(&g)
        val b = any_double(&g)

        // Every third addend is the negated rounded product nudged, so the sum cancels most of it
        // and what is left is the product's low bits -- the case a fused operation exists for.
        val c = if step % 3 == 0 then real.from_bits((a * b).bits() ^ NEGATIVE ^ (g.next_u64() & 0xF))
                else if step % 3 == 1 then any_double(&g)
                else real.from_bits(g.next_u64() & 0x81FF_FFFF_FFFF_FFFF)

        assert(same(fused(a.bits(), b.bits(), c.bits(), false), hardware_fma(a, b, c)), s"fma($a, $b, $c)")

@test("and of operands near the bottom of the range, whose sums are subnormal")
random_fused_subnormal_agree_with_hardware()
    var g = rng(69, 7)

    for step in 0..<20000
        val a = real.from_bits(g.next_u64() & 0x81FF_FFFF_FFFF_FFFF)
        val b = real.from_bits((g.next_u64() & 0x803F_FFFF_FFFF_FFFF) | 0x3C00_0000_0000_0000)
        val c = real.from_bits(g.next_u64() & 0x801F_FFFF_FFFF_FFFF)

        assert(same(fused(a.bits(), b.bits(), c.bits(), false), hardware_fma(a, b, c)), s"fma($a, $b, $c)")

@test("a binary32 fused multiply-add of random floats agrees with the fused instruction")
random_fused_single_agree_with_hardware()
    var g = rng(70, 7)

    for step in 0..<40000
        val a = f32.from_bits(u32(g.next_u64() >> 32))
        val b = f32.from_bits(u32(g.next_u64() >> 32))
        val c = if step % 2 == 0 then f32.from_bits((a * b).bits() ^ 0x8000_0000 ^ u32(g.next_u64() & 0xF))
                else f32.from_bits(u32(g.next_u64() >> 32))

        assert(same_single(fused_single(a.bits(), b.bits(), c.bits()), hardware_fmaf(a, b, c)),
               s"fmaf($a, $b, $c)")

@test("the fused results a multiply and an add would get wrong")
fused_known_values()
    // (1 + 2^-30)^2 - (1 + 2^-29) is 2^-60 exactly; the rounded product has already lost it.
    val x: u64 = 0x3FF0_0000_0040_0000
    val c: u64 = 0xBFF0_0000_0080_0000

    assert(fused(x, x, c, false) == 0x3C30_0000_0000_0000)
    assert(add(mul(x, x), c) == 0)

    // 2^-12 (1 + 2^-15) times 2^-12 (1 - 2^-15) is 2^-24 - 2^-54, and plus 1 + 2^-23 it is a hair
    // below the half-way point to the next float up: the answer is 1 + 2^-23. Rounded to nearest at
    // binary64 first, the hair is gone, the tie goes to even, and the answer is one float too high --
    // the double rounding that rounding to odd at binary64 exists to prevent.
    val a: u32 = 0x3980_0100
    val b: u32 = 0x397F_FE00
    val d: u32 = 0x3F80_0001

    assert(fused_single(a, b, d) == 0x3F80_0001)
    assert(narrow_single(fused(widen_single(a), widen_single(b), widen_single(d), false)) == 0x3F80_0002)
    assert(hardware_fmaf(f32.from_bits(a), f32.from_bits(b), f32.from_bits(d)).bits() == 0x3F80_0001)

    // An infinity times zero, opposite infinities, and the zeros signed as `add` signs them.
    assert(fused(POSITIVE_INFINITY, 0, 1, false) == DEFAULT_NAN)
    assert(fused(POSITIVE_INFINITY, ONE_POINT_ZERO, POSITIVE_INFINITY | NEGATIVE, false) == DEFAULT_NAN)
    assert(fused(NEGATIVE, ONE_POINT_ZERO, NEGATIVE, false) == NEGATIVE)
    assert(fused(NEGATIVE, ONE_POINT_ZERO, 0, false) == 0)
    assert(fused(0x3FF0_0000_0000_0000, 0x3FF0_0000_0000_0000, 0xBFF0_0000_0000_0000, false) == 0)

    // The largest finite value squared overflows, whatever is added; an addend alone survives a
    // product far below it.
    assert(fused(0x7FEF_FFFF_FFFF_FFFF, 0x7FEF_FFFF_FFFF_FFFF, 0xFFEF_FFFF_FFFF_FFFF, false) == POSITIVE_INFINITY)
    assert(fused(1, 1, 0x3FF0_0000_0000_0000, false) == 0x3FF0_0000_0000_0000)
end fused_known_values
