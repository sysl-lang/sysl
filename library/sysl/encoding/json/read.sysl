module sysl.encoding.json

import sysl.buf.{Buf, buf}
import sysl.text.{from_utf8, from_utf8_unchecked, parse_real}
import sysl.codec as codec
import sysl.codec.{CodecError, Decoder, Token}

// Reading: RFC 8259's grammar, exactly -- no comments, no trailing commas, no single quotes, no
// leading `+` or leading zero, no `NaN`. Every refusal names the byte it happened at.

/** How deep arrays and objects may nest before a document is refused.
 *
 * The reader is recursive, so without a bound a hostile document of a hundred thousand `[` would
 * exhaust the stack. 128 is far past what a real document nests and small enough for a board's
 * stack.
 */
const max_depth: usize = 128

/** What was wrong at the place a `JsonError` names. */
enum Fault derives Eq
    /** Something else was found where this was expected. */
    Expected(what: string)
    /** The text ended where this was expected. */
    Ended(what: string)
    /** A whole value was read and more text follows it. */
    Trailing
    LeadingZero
    /** A backslash followed by something that is not one of JSON's escapes. */
    BadEscape
    /** A `\u` not followed by four hexadecimal digits. */
    BadHex
    /** A `\u` escape naming half of a surrogate pair without the other half. */
    LoneSurrogate
    /** A byte below a space inside a string, which JSON requires to be escaped. */
    Control
    /** A string opened at this quote and never closed. */
    Unclosed
    /** A string whose bytes are not UTF-8. */
    NotUtf8
    /** Arrays and objects nested past `max_depth`. */
    TooDeep

impl Display for Fault
    display(self, out: *Writer, fmt: FormatSpec)
        val text = self match
            Expected(what) -> s"$what expected"
            Ended(what) -> s"the text ends where $what was expected"
            Trailing -> "more text after the value"
            LeadingZero -> "a number may not have a leading zero"
            BadEscape -> "not one of JSON's escapes: \\\" \\\\ \\/ \\b \\f \\n \\r \\t \\uXXXX"
            BadHex -> "a \\u escape is four hexadecimal digits"
            LoneSurrogate -> "half of a surrogate pair, without the other half"
            Control -> "a control character has to be escaped inside a string"
            Unclosed -> "this string is never closed"
            NotUtf8 -> "this string is not UTF-8"
            TooDeep -> s"arrays and objects nested more than $max_depth deep"

        display_str(text, out, fmt)
    end display

/** Why a document was refused, and where.
 *
 * `line` and `col` count from one; a column counts characters, not bytes, so it is what an editor
 * shows. `offset` is the byte offset from the start of the text, counting from zero.
 */
struct JsonError derives Eq
    fault: Fault
    line: usize
    col: usize
    offset: usize

/** `line:col: what`, the shape a compiler's diagnostic has. */
impl Display for JsonError
    display(self, out: *Writer, fmt: FormatSpec) =
        display_str(s"${self.line}:${self.col}: ${self.fault}", out, fmt)

/** One whole JSON text read into a value, or why it is not one.
 *
 * Whitespace may surround the value; anything else after it is refused. A number too large for a
 * `real` reads as an infinity.
 */
parse(text: string) -> Result[Json, JsonError] = parse_bytes(text.bytes)

/** The same over bytes that may not be text, which is what arrives from a socket or a file: a string
 * holding bytes that are not UTF-8 is refused with `NotUtf8` rather than taken.
 */
parse_bytes(b: []const u8) -> Result[Json, JsonError]
    var r = json_decoder(b)

    blank(&r)

    val v = value(&r)?

    blank(&r)

    if r.at < b.len then return Err(fail(&r, r.at, Trailing))

    Ok(v)
end parse_bytes

/** A pull reader over one JSON text: `sysl.codec`'s `Decoder` for JSON, which `from_json` reads a
 * value through, and the reader `parse` builds its tree with. It reads the bytes it is given in
 * place and allocates only for a string it hands back.
 */
struct JsonDecoder
    private b: []const u8
    private at: usize
    private depth: usize
    // Whether the next member or element is the first of its object or array, so no comma is due.
    private first: bool

/** A decoder at the start of `b`. */
json_decoder(b: []const u8) -> JsonDecoder = JsonDecoder(b, 0, 0, true)

// The error at a byte offset, with its line and column counted from the start.
private fail(r: *JsonDecoder, at: usize, fault: Fault) -> JsonError
    var line: usize = 1
    var col: usize = 1

    for i in 0..<at
        val c = r.b[i]

        if c == u8('\n')
            line += 1
            col = 1
        elif c & 0xC0 != 0x80
            col += 1

    JsonError(fault, line, col, at)
end fail

// `what` expected at the reader's position, told apart from the text having ended there.
private missing(r: *JsonDecoder, what: string) -> JsonError =
    fail(r, r.at, if r.at >= r.b.len then Ended(what) else Expected(what))

private blank(r: *JsonDecoder)
    while r.at < r.b.len
        val c = r.b[r.at]

        if c != u8(' ') && c != u8('\t') && c != u8('\n') && c != u8('\r') then return

        r.at += 1
end blank

private peek_is(r: *JsonDecoder, c: u8) -> bool = r.at < r.b.len && r.b[r.at] == c

private is_digit(c: u8) -> bool = c >= u8('0') && c <= u8('9')

private value(r: *JsonDecoder) -> Result[Json, JsonError]
    if r.at >= r.b.len then return Err(missing(r, "a value"))

    val c = r.b[r.at]

    if c == u8('{') then object(r)
    elif c == u8('[') then array(r)
    elif c == u8('"') then Ok(Str(text(r)?))
    elif c == u8('-') || is_digit(c) then number(r)
    elif word(r, "true") then Ok(Bool(true))
    elif word(r, "false") then Ok(Bool(false))
    elif word(r, "null") then Ok(Null)
    else Err(missing(r, "a value"))
end value

// Whether `w` is written at the reader's position, stepping over it where it is.
private word(r: *JsonDecoder, w: string) -> bool
    if r.at + w.bytes.len > r.b.len then return false

    for i in 0..<w.bytes.len
        if r.b[r.at + i] != w.bytes[i] then return false

    r.at += w.bytes.len
    true
end word

private digits(r: *JsonDecoder, what: string) -> Result[unit, JsonError]
    if r.at >= r.b.len || !is_digit(r.b[r.at]) then return Err(missing(r, what))

    while r.at < r.b.len && is_digit(r.b[r.at]) do r.at += 1

    Ok(())
end digits

private number(r: *JsonDecoder) -> Result[Json, JsonError]
    val start = r.at
    val negative = peek_is(r, u8('-'))

    if negative then r.at += 1

    val first = r.at

    digits(r, "a digit")?

    if r.b[first] == u8('0') && r.at - first > 1 then return Err(fail(r, first, LeadingZero))

    var whole = true

    if peek_is(r, u8('.'))
        r.at += 1
        digits(r, "a digit after the decimal point")?
        whole = false

    if peek_is(r, u8('e')) || peek_is(r, u8('E'))
        r.at += 1

        if peek_is(r, u8('+')) || peek_is(r, u8('-')) then r.at += 1

        digits(r, "a digit in the exponent")?
        whole = false

    val run = r.b[start..<r.at]

    if !whole then return Ok(Real(parse_real(run).unwrap()))

    // The magnitude in a `ulong`, or the digits themselves where it would overflow. The most
    // negative `long` is the one magnitude past the largest positive that still fits.
    var v: ulong = 0

    for i in first..<r.at
        val d = ulong(r.b[i] - u8('0'))

        if v > (18446744073709551615 - d) / 10 then return Ok(Big(from_utf8_unchecked(run)))

        v = v * 10 + d

    val most: ulong = 9223372036854775807

    if v <= most then Ok(Int(if negative then -long(v) else long(v)))
    elif negative && v == most + 1 then Ok(Int(-9223372036854775807 - 1))
    else Ok(Big(from_utf8_unchecked(run)))
end number

// A quoted string, decoded. A run with no escape in it is copied out whole; an escape writes the
// bytes of the character it names. The gathered bytes are checked as UTF-8 once, at the end.
private text(r: *JsonDecoder) -> Result[string, JsonError]
    val open = r.at

    r.at += 1

    var out: Buf[u8] = buf()
    var run = r.at

    loop
        if r.at >= r.b.len then return Err(fail(r, open, Unclosed))

        val c = r.b[r.at]

        if c == u8('"')
            out.extend(r.b[run..<r.at])
            r.at += 1
            break
        elif c == u8('\\')
            out.extend(r.b[run..<r.at])
            escape(r, &out)?
            run = r.at
        elif c < 32
            return Err(fail(r, r.at, Control))
        else
            r.at += 1

    from_utf8(out.view()) match
        Ok(s) -> Ok(s)
        Err(e) -> Err(fail(r, open + 1 + bad_byte(r.b[open + 1..<r.at], e.offset), NotUtf8))
end text

// Where in the input the `n`th gathered byte came from is not tracked through escapes, which only
// ever produce valid UTF-8; so the bad byte is found again in the raw run, where it stands as itself.
private bad_byte(raw: []const u8, fallback: usize) -> usize
    from_utf8(raw) match
        Err(e) -> e.offset
        Ok(_) -> fallback

// One escape, the backslash under the reader; its character's bytes go into `out`.
private escape(r: *JsonDecoder, out: *Buf[u8]) -> Result[unit, JsonError]
    val at = r.at

    if at + 1 >= r.b.len then return Err(fail(r, at, BadEscape))

    val e = r.b[at + 1]

    r.at += 2

    val simple = simple_escape(e)

    if simple != 0
        out.push(simple)
        return Ok(())

    if e != u8('u') then return Err(fail(r, at, BadEscape))

    var cp = hex4(r, at)?

    if cp >= 0xDC00 && cp < 0xE000 then return Err(fail(r, at, LoneSurrogate))

    if cp >= 0xD800 && cp < 0xDC00
        if !(peek_is(r, u8('\\')) && r.at + 1 < r.b.len && r.b[r.at + 1] == u8('u')) then
            return Err(fail(r, at, LoneSurrogate))

        val second = r.at

        r.at += 2

        val low = hex4(r, second)?

        if low < 0xDC00 || low >= 0xE000 then return Err(fail(r, at, LoneSurrogate))

        cp = 0x10000 + ((cp - 0xD800) << 10) + (low - 0xDC00)

    var tmp: [4]u8

    out.extend(tmp[0..<encode_utf8(char(cp), tmp[0..<4])])
    Ok(())
end escape

// The four hexadecimal digits after a `\u` whose backslash is at `at`.
private hex4(r: *JsonDecoder, at: usize) -> Result[u32, JsonError]
    if r.at + 4 > r.b.len then return Err(fail(r, at, BadHex))

    var v: u32 = 0

    for i in 0usize..<4
        val d = hex_digit(r.b[r.at + i])

        if d > 15 then return Err(fail(r, at, BadHex))

        v = v * 16 + d

    r.at += 4
    Ok(v)
end hex4

// A hexadecimal digit's value, or 16 for a byte that is not one.
private hex_digit(c: u8) -> u32
    if is_digit(c) then return u32(c - u8('0'))
    if c >= u8('a') && c <= u8('f') then return u32(c - u8('a')) + 10
    if c >= u8('A') && c <= u8('F') then return u32(c - u8('A')) + 10

    16
end hex_digit

// The byte a one-letter escape stands for, or 0 for a letter that is not one of them (`\u` included).
private simple_escape(e: u8) -> u8
    if e == u8('"') || e == u8('\\') || e == u8('/') then return e
    if e == u8('b') then return 8
    if e == u8('f') then return 12
    if e == u8('n') then return u8('\n')
    if e == u8('r') then return u8('\r')
    if e == u8('t') then return u8('\t')

    0
end simple_escape

private enter(r: *JsonDecoder) -> Result[unit, JsonError]
    if r.depth >= max_depth then return Err(fail(r, r.at, TooDeep))

    r.depth += 1
    r.at += 1
    Ok(())

private array(r: *JsonDecoder) -> Result[Json, JsonError]
    enter(r)?
    blank(r)

    var items: Buf[Json] = buf()

    if peek_is(r, u8(']'))
        r.at += 1
    else
        loop
            items.push(value(r)?)
            blank(r)

            if peek_is(r, u8(','))
                r.at += 1
                blank(r)
            elif peek_is(r, u8(']'))
                r.at += 1
                break
            else
                return Err(missing(r, "',' or ']'"))

    r.depth -= 1
    Ok(Arr(items))
end array

private object(r: *JsonDecoder) -> Result[Json, JsonError]
    enter(r)?
    blank(r)

    var members: Buf[Member] = buf()

    if peek_is(r, u8('}'))
        r.at += 1
    else
        loop
            if !peek_is(r, u8('"')) then return Err(missing(r, "a member name"))

            val key = text(r)?

            blank(r)

            if !peek_is(r, u8(':')) then return Err(missing(r, "':'"))

            r.at += 1
            blank(r)
            members.push(Member(key, value(r)?))
            blank(r)

            if peek_is(r, u8(','))
                r.at += 1
                blank(r)
            elif peek_is(r, u8('}'))
                r.at += 1
                break
            else
                return Err(missing(r, "',' or '}'"))

    r.depth -= 1
    Ok(Obj(members))
end object

// -- reading into a caller's type -----------------------------------------------------------------

/** A value of type `T` read from one JSON text, through `T`'s `Decode` (derived, or the library's
 * own for a scalar, a string, an `Option`, a `Buf`, a `Map` or a `Set`).
 *
 * Whitespace may surround the value; anything else after it is refused. Every refusal names the
 * byte it was found at and the path to it, `users[3].home.zip: an integer expected (byte 214)`;
 * where the text breaks JSON's grammar, the words are the ones `parse` uses.
 */
from_json[T](text: string) -> Result[T, CodecError] = from_json_bytes[T](text.bytes)

/** The same over bytes that may not be text: a string that is not UTF-8 is refused. */
from_json_bytes[T](b: []const u8) -> Result[T, CodecError]
    var d = json_decoder(b)
    val v = codec.decode[T, JsonDecoder](&d)?

    blank(&d)

    if d.at < b.len then return Err(lift(fail(&d, d.at, Trailing)))

    Ok(v)
end from_json_bytes

// A refusal of JSON's grammar, in the codec's terms: the same words, at the same byte.
private lift(e: JsonError) -> CodecError = codec.refusal(codec.Fault.Syntax(e.fault.to_string()), e.offset)

// `what` expected where the reader stands: JSON's own refusal where the text has ended there, the
// codec's `Expected` where a value of another shape stands.
private wanted(r: *JsonDecoder, what: string) -> CodecError =
    if r.at >= r.b.len then lift(missing(r, what)) else codec.refusal(codec.Fault.Expected(what), r.at)

private starts_number(r: *JsonDecoder) -> bool = r.at < r.b.len && (r.b[r.at] == u8('-') || is_digit(r.b[r.at]))

// The digits of a number too large for a `long`, held to the range of an `i128`: past it, the
// nearest end, which every type the codec reads into refuses as out of range.
private big_int(digits: string) -> i128
    val bs = digits.bytes
    val neg = bs[0] == u8('-')
    var v: i128 = 0

    for i in (if neg then 1 else 0)..<bs.len
        if v > 1000000000000000000000000000000000000 then return if neg then i128::Min else i128::Max

        v = v * 10 + i128(bs[i] - u8('0'))

    if neg then -v else v
end big_int

impl Decoder for JsonDecoder
    type Mark = (usize, usize, bool)

    mark(*self) -> (usize, usize, bool) = (self.at, self.depth, self.first)

    rewind(*self, m: (usize, usize, bool))
        self.at = m.0
        self.depth = m.1
        self.first = m.2

    // A comma still to be read belongs to no one, so the offset is the key or item after it, which
    // is looked at without being read.
    offset(*self) -> usize
        blank(self)

        if self.first || self.depth == 0 || !peek_is(self, u8(',')) then return self.at

        val m = self.mark()

        self.at += 1
        blank(self)

        val at = self.at

        self.rewind(m)
        at
    end offset

    peek(*self) -> Result[Token, CodecError]
        blank(self)

        if self.at >= self.b.len then return Err(wanted(self, "a value"))

        val c = self.b[self.at]

        if c == u8('{') then Ok(Token.Struct)
        elif c == u8('[') then Ok(Token.Seq)
        elif c == u8('"') then Ok(Token.Text)
        elif starts_number(self) then Ok(Token.Number)
        elif c == u8('t') || c == u8('f') then Ok(Token.Bool)
        elif c == u8('n') then Ok(Token.Null)
        else Err(lift(missing(self, "a value")))
    end peek

    none(*self) -> Result[bool, CodecError]
        blank(self)
        Ok(word(self, "null"))

    bool(*self) -> Result[bool, CodecError]
        blank(self)

        if word(self, "true") then Ok(true)
        elif word(self, "false") then Ok(false)
        else Err(wanted(self, "true or false"))

    int(*self) -> Result[i128, CodecError]
        blank(self)

        if !starts_number(self) then return Err(wanted(self, "an integer"))

        val at = self.at

        number(self) match
            Ok(Int(n)) -> Ok(i128(n))
            Ok(Big(digits)) -> Ok(big_int(digits))
            Ok(_) ->
                self.at = at
                Err(codec.refusal(codec.Fault.Expected("an integer"), at))
            Err(e) -> Err(lift(e))
    end int

    real(*self) -> Result[real, CodecError]
        blank(self)

        if !starts_number(self) then return Err(wanted(self, "a number"))

        number(self) match
            Ok(Int(n)) -> Ok(real(n))
            Ok(Real(x)) -> Ok(x)
            Ok(Big(digits)) -> Ok(parse_real(digits.bytes).unwrap())
            Ok(_) -> Err(wanted(self, "a number"))
            Err(e) -> Err(lift(e))
    end real

    str(*self) -> Result[string, CodecError]
        blank(self)

        if !peek_is(self, u8('"')) then return Err(wanted(self, "a string"))

        text(self).map_err(lift)

    begin_seq(*self) -> Result[unit, CodecError]
        blank(self)

        if !peek_is(self, u8('[')) then return Err(wanted(self, "an array"))

        enter(self).map_err(lift)?
        self.first = true
        Ok(())

    next_item(*self) -> Result[bool, CodecError]
        blank(self)

        if peek_is(self, u8(']'))
            self.at += 1
            self.depth -= 1
            self.first = false
            return Ok(false)

        if !self.first
            if !peek_is(self, u8(',')) then return Err(lift(missing(self, "',' or ']'")))

            self.at += 1
            blank(self)

            // A comma promises an item, so a close after one breaks the grammar rather than the shape.
            if peek_is(self, u8(']')) then return Err(lift(missing(self, "a value")))

        self.first = false
        Ok(true)
    end next_item

    begin_struct(*self) -> Result[unit, CodecError]
        blank(self)

        if !peek_is(self, u8('{')) then return Err(wanted(self, "an object"))

        enter(self).map_err(lift)?
        self.first = true
        Ok(())

    next_key(*self) -> Result[Option[string], CodecError]
        blank(self)

        if peek_is(self, u8('}'))
            self.at += 1
            self.depth -= 1
            self.first = false
            return Ok(None)

        if !self.first
            if !peek_is(self, u8(',')) then return Err(lift(missing(self, "',' or '}'")))

            self.at += 1
            blank(self)

        if !peek_is(self, u8('"')) then return Err(lift(missing(self, "a member name")))

        val key = text(self).map_err(lift)?

        blank(self)

        if !peek_is(self, u8(':')) then return Err(lift(missing(self, "':'")))

        self.at += 1
        self.first = false
        Ok(Some(key))
    end next_key

    /** Reads the value and throws it away, refusing it where it is not JSON. */
    skip_value(*self) -> Result[unit, CodecError]
        blank(self)
        value(self).map_err(lift)?
        Ok(())
end JsonDecoder
