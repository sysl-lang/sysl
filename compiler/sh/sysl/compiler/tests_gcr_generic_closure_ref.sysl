module sh.sysl.compiler
@tests

import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.{capture, Var}
import sysl.text.cstring

// **A closure literal handed to a generic call that answers it is typed by a trial whose record of
// its struct the instantiation keeps in its signature** (`closure_mode.sysl`'s `apply_closure_modes`).
// Turned only where the struct and enum tables reached it, `pass[F]`'s and `each`'s signatures kept
// by-value fields, so the copy and dispose built from them retained and released the ADDRESS of a
// by-reference capture: the closure then read its capture through a bumped pointer, and the heap was
// handed back a block it never gave out.
//
// The axes: how many captures (one, two); how the answer is reached (one generic call, a generic call
// nested in another, a generic method); and whether the closure is held by reference at all (stored
// in a `&Fn` field it captures by value, so its box's drop must still release them). Each cell
// asserts its output, the counted heap's net 0, that a by-reference closure has no copy or dispose
// and a kept one a releasing drop, and a clean run under AddressSanitizer.
//
// Skipped cells, and why: a generic that answers the closure inside a struct or enum
// (`Some(f)`) is a record the enum table already reaches; a closure that is not a literal at the call
// is typed by its binding, not by a trial.

// -- the harness ----------------------------------------------------------------------------------

private struct GcrRun
    out: string
    err: string
end GcrRun

private extern "setenv" gcr_c_setenv(name: *u8, value: *u8, overwrite: int) -> int
private extern "unsetenv" gcr_c_unsetenv(name: *u8) -> int

// The program built on the counted heap, or with `flags` handed to clang, and run.
private gcr_run(text: string, flags: string = "") -> GcrRun
    val root = make_temp_dir("sysl-gcr").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", forms_imported(text)).unwrap()

    val exe = s"$root/built"

    if flags != ""
        val n = cstring("SYSL_EXTRA_CFLAGS")
        val v = cstring(flags)

        gcr_c_setenv(n.ptr, v.ptr, 1)
    end if

    force_alloc_counting(flags == "")

    val made = build_native_program(s"$root/main.sysl", None, None, DefaultOptimization, Some(exe))

    force_alloc_counting(false)

    if flags != ""
        val n = cstring("SYSL_EXTRA_CFLAGS")

        gcr_c_unsetenv(n.ptr)
    end if

    made match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return GcrRun(failure_text(why), "")
        Ok(_) -> ()

    val ran = capture(exe, [], "", [Var(alloc_bytes_variable(), "1")], true)

    remove_dir_all(root).unwrap_or(())

    ran match
        Err(_) -> GcrRun("could not be started", "")
        Ok(o) -> GcrRun(o.text, o.err.unwrap_or(""))
end gcr_run

private gcr_ir(text: string) -> string
    val root = make_temp_dir("sysl-gcr").unwrap()

    write_text(s"$root/main.sysl", forms_imported(text)).unwrap()

    val out = emit_llvm_text(s"$root/main.sysl", None) match
        Err(why) -> failure_text(why)
        Ok(made) -> if made.report.is_empty() then made.text else analysis_report(made.report)

    remove_dir_all(root).unwrap_or(())
    out
end gcr_ir

// The program printed `want` and gave back everything it took, and the closure's copy and dispose
// exist exactly when it is `counted`; then the same under AddressSanitizer.
private gcr_check(name: string, text: string, want: string, counted: bool)
    val got = gcr_run(text)

    assert_eq(got.out, want)
    assert_eq(got.err.index_of("was taken as"), None)
    assert_eq(alloc_count_reported(got.err), 0)

    val ir = gcr_ir(text)

    if counted
        // Moved into its `&Fn` box, whose drop releases the captures it holds by value.
        assert(ir.contains("@arc.drop.$closure0("), s"$name: the closure's box releases nothing")
    else
        assert(!ir.contains("@arc.copy.$closure0("), s"$name: the closure's copy retains a capture's address")
        assert(!ir.contains("@arc.dispose.$closure0("), s"$name: the closure's dispose releases a capture's address")
    end if

    val asan = gcr_run(text, "-fsanitize=address -g")

    assert_eq(asan.out, want)
    assert(asan.err == "", s"$name: ${asan.err}")
end gcr_check

// -- the programs ---------------------------------------------------------------------------------

private const gcr_pool: string = raw"""
    struct Node
        n: int

    struct Pool
        last: Option[&Node]
        count: int

        keep(&self, a: &Node)
            self.last = Some(a)
            self.count += 1

    struct Sink
        held: Option[&Pool]

    struct Relay
        tag: int

        hand[F](self, f: F) -> F = f

    pool() -> &Pool = Pool(None, 0)

    pass[F](f: F) -> F = f

    each(xs: []int, f: int -> unit) =
        for x in xs
            f(x)
    """

private const gcr_two: string = raw"""
    fill(xs: []int, s: *Sink, pl: &Pool) = each(xs, pass((x: int) ->
        pl.count += x
        s.held = Some(pl)))

    main()
        var s = Sink(None)
        val pl = pool()

        fill([1, 2, 3], &s, pl)
        print(s.held.unwrap().count)
    """

private const gcr_one: string = raw"""
    fill(xs: []int, pl: &Pool) = each(xs, pass((x: int) -> pl.count += x))

    main()
        val pl = pool()

        fill([1, 2, 3, 4], pl)
        print(pl.count)
    """

private const gcr_nested: string = raw"""
    fill(xs: []int, s: *Sink, pl: &Pool) = each(xs, pass(pass((x: int) ->
        pl.count += x
        s.held = Some(pl))))

    main()
        var s = Sink(None)
        val pl = pool()

        fill([1, 2, 3], &s, pl)
        print(s.held.unwrap().count)
    """

private const gcr_method: string = raw"""
    fill(xs: []int, a: &Node, pl: &Pool) = each(xs, Relay(0).hand((x: int) -> pl.keep(a)))

    main()
        val a: &Node = Node(4)
        val pl = pool()

        fill([1, 2, 3], a, pl)
        print(pl.count + pl.last.unwrap().n)
    """

private const gcr_by_value: string = raw"""
    struct Holder
        f: &Fn(int) -> unit

    make(a: &Node, pl: &Pool) -> Holder = Holder(pass((x: int) -> pl.keep(a)))

    main()
        val a: &Node = Node(4)
        val pl = pool()
        val h = make(a, pl)

        h.f(1)
        h.f(2)
        print(pl.count + pl.last.unwrap().n)
    """

private gcr_with(rest: string) -> string = gcr_pool + rest

// -- the cells ------------------------------------------------------------------------------------

@test("a closure held by reference and passed through a generic answer copies no capture's address as a count")
gcr_generic_answer_turns_the_trial_record()
    if !enm_ready() then return

    gcr_check("gcr_two", gcr_with(gcr_two), "6\n", false)
end gcr_generic_answer_turns_the_trial_record

@test("one capture, a generic answer nested in another, and a generic method answer are turned too")
gcr_generic_answer_shapes()
    if !enm_ready() then return

    gcr_check("gcr_one", gcr_with(gcr_one), "10\n", false)
    gcr_check("gcr_nested", gcr_with(gcr_nested), "6\n", false)
    gcr_check("gcr_method", gcr_with(gcr_method), "7\n", false)
end gcr_generic_answer_shapes

@test("a closure kept in a field and passed through a generic answer still counts its captures")
gcr_kept_closure_still_counts()
    if !enm_ready() then return

    gcr_check("gcr_by_value", gcr_with(gcr_by_value), "6\n", true)
end gcr_kept_closure_still_counts
