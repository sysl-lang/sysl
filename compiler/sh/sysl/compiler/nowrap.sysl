module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.container.{Set, set}
import sysl.math.bigint.{cmp, from_int}

// **An unsigned add the body has proved cannot wrap is said to LLVM as `add nuw`.**
//
// Plain `+` on an unsigned integer wraps, which is the language's meaning and not something the
// lowering may narrow. But a bounds test on `out[n + k]` can only be folded by an optimizer that knows
// `n + k` is the arithmetic sum: a guard `n + len <= out.len` written with a wrapping add says nothing
// about a later index, because a huge `n` wraps the guard's sum small and passes it. So the flag is
// laid down only where the body itself proves the sum fits, and in two shapes:
//
// - **Both operands are bounded by half the word**: a `.len` of a view whose elements take storage
//   (no object reaches past half the address space, so no such length does either), an integer
//   literal at most `isize::MAX`, a narrower unsigned value widened, a bitwise `&` with one of these, a
//   `%` by one, a right shift or a division by a literal, or an immutable local or loop variable
//   bounded by one of them. Two such values add to less than the word's range.
// - **A dominating guard in the non-wrapping form** `if n > L || len > L - n then <leave>`, with `L` a
//   view's `.len` and the then-block leaving (`return`, `break`, `continue`, `become`). Past it,
//   `n <= L` and `len <= L - n`, so `n + len` fits and so does `n + k` for a loop variable `k` running
//   below (or up to) `len` in a loop entered past the guard. The fact holds until the first statement
//   that writes `n`, `len` or the view; a local whose address is taken anywhere in the function never
//   takes part.
//
// The guard's fact is also said again as an `llvm.assume` at the start of the fall-through, so it
// survives the optimizer splitting the guard into copies -- which the inlined count handling of a
// retained view does -- where no single copy dominates the loop any longer.
//
// One more guard proves no add but is kept the same way: `if xs.len != ys.len then <leave>` (or a
// `||` with that comparison among its sides). Past it the two views are one length, so a subscript
// `ys[j]` with `j` running below `xs.len` is checked by the loop's own condition as surely as `xs[j]`
// is, and `bounds_hoist.sysl` copies no loop for it.

// One guard in force: the operand `a`, the length `b` and the view `x` whose length bounds their sum,
// the order it was established in, and whether a write since has ended it. A `same` guard is the
// equal-length one instead: `a` and `b` are the two views, and `x` is `b` again.
struct NoWrapGuard
    a: string
    b: string
    x: string
    id: int
    live: bool
    same: bool
end NoWrapGuard

// One counted loop being lowered: its variable, its upper bound, and the guard count at its entry
// (a guard established after the loop began says nothing about the bound it was entered with).
struct NoWrapFor
    name: string
    hi: TExpr
    epoch: int

// What one function's lowering knows about its unsigned adds.
struct NoWrap
    // Locals whose address is taken, or that a `ref`, an `asm` operand or a `va_list` reaches: any
    // write to one can happen behind a name the body does not spell.
    escaped: Set[string]

    // Locals declared once and never written afterwards.
    once: Set[string]

    // Of those, the ones whose value is bounded by half the word, filled as their declarations are
    // lowered.
    bounded: Set[string]

    guards: Buf[NoWrapGuard]
    fors: Buf[NoWrapFor]
    next_id: int

    // Deferred statements are laid down at exits, out of the order the guards were proved in.
    suspended: int

    // Whether the body was scanned. One that was not (an entry point, a synthesised body) proves
    // nothing beyond what its operands' own forms say.
    ready: bool

    // The parameters and the locals a `val` or `var` declares: the names a read of which is the
    // value in the name's own slot, and nothing behind it (`bounds_hoist.sysl`).
    plain: Set[string]

    // The subscripts, by `node_id` of the index, that the copy of a counted loop being lowered has
    // proved in range before the loop began (`bounds_hoist.sysl`).
    proven: Set[usize]

    // The guards in force over two fields of one struct (`NoWrapFieldGuard`).
    field_guards: Buf[NoWrapFieldGuard]
end NoWrap

no_wrap_none() -> NoWrap = NoWrap(set(), set(), set(), buf(), buf(), 0, 0, false, set(), set(), buf())

// **One guard in force over two fields of one struct**: `if k >= s.hi - s.lo then <leave>`, where the
// struct's invariant orders `lo` at or below `hi` (`nowrap_sub`), so the difference is exact and, past
// the guard, `k + s.lo` is below `s.hi` and cannot wrap. `recv` is the place both fields were read
// from, `root` the local it starts at. The fact holds while nothing can write either field, `k` or
// `root`: the first statement that could -- one that calls, stores, or holds anything else outside a
// short list of reads (`nw_inert`) -- ends it.
struct NoWrapFieldGuard
    k: string
    recv: TExpr
    root: string
    hi: int
    lo: int
    live: bool
end NoWrapFieldGuard

// What a walk over a body found.
private struct NwScan
    escaped: Set[string]
    written: Set[string]
    decls: Buf[string]
    twice: Set[string]

private nw_scan() -> &NwScan = NwScan(set(), set(), buf(), set())

// The local a write to `place` changes, where it changes a local's own value.
private nw_root(place: TExpr) -> Option[string] = *place.kind match
    TLoad(name, _) -> Some(name)
    TField(r, _, _) -> nw_root(r)
    TIndex(r, _, _) -> underlying(texpr_type(r)) match
        Array(_, _, _) -> nw_root(r)
        _ -> None
    _ -> None

private nw_wrote(s: &NwScan, place: TExpr)
    val r = nw_root(place)

    if r.is_some() then s.written.add(r.unwrap())
end nw_wrote

private nw_escape(s: &NwScan, place: TExpr)
    val r = nw_root(place)

    if r.is_some() then s.escaped.add(r.unwrap())
end nw_escape

private nw_on_expr(s: &NwScan, x: TExpr)
    *x.kind match
        TStore(place, _, _, _) -> nw_wrote(s, place)
        TUpdate(place, _, _, _, _, _, _) -> nw_wrote(s, place)
        TIncDec(place, _, _, _, _) -> nw_wrote(s, place)
        TAddrOf(place, _) -> nw_escape(s, place)
        TVaStart(ap) -> nw_escape(s, ap)
        TVaEnd(ap) -> nw_escape(s, ap)
        TVaArg(ap, _) -> nw_escape(s, ap)
        TVaCopy(dst, src) ->
            nw_escape(s, dst)
            nw_escape(s, src)
        _ -> ()
end nw_on_expr

private nw_on_stmt(s: &NwScan, st: TStmt)
    st match
        TVarDecl(name, _, _, _) ->
            for d in s.decls
                if d == name then s.twice.add(name)

            s.decls.push(name)
        TRefDecl(_, _, place) -> nw_escape(s, place)
        TAsm(_, operands, _, _) ->
            for item in operands
                s.escaped.add(item.name)
                s.escaped.add(item.into)
        _ -> ()
end nw_on_stmt

private nw_walker(s: &NwScan) -> &TWalk =
    TWalk(true, x -> nw_on_expr(s, x), w -> nw_wrote(s, w.place), st -> nw_on_stmt(s, st))

// Whether a scan saw `name` written, declared or reached by address.
private nw_touches(s: &NwScan, name: string) -> bool
    if s.written.has(name) || s.escaped.has(name) then return true

    for d in s.decls
        if d == name then return true

    false
end nw_touches

// Sets up what is known for the function about to be lowered.
nowrap_begin(e: *Emit, f: TFunc)
    val s = nw_scan()

    walk_block_stmts(f.body, nw_walker(s))
    e.nowrap = no_wrap_none()
    e.nowrap.escaped = s.escaped
    e.nowrap.ready = true

    for d in s.decls
        if !s.twice.has(d) && !s.written.has(d) && !s.escaped.has(d) then e.nowrap.once.add(d)

        e.nowrap.plain.add(d)

    for p in f.params
        e.nowrap.plain.add(p.0)
end nowrap_begin

// Whether `name` holds one value for the whole of a loop whose body is `body`: a parameter or a
// declared local, or the variable of a counted loop around this one, that nothing reaches by address
// and that the body neither writes nor declares.
nowrap_steady(e: *Emit, name: string, body: Buf[TStmt]) -> bool
    if !e.nowrap.ready || e.nowrap.escaped.has(name) then return false

    var known = e.nowrap.plain.has(name)

    for f in e.nowrap.fors
        if f.name == name then known = true

    if !known then return false

    for st in body
        if nw_touches(nw_writes(st), name) then return false

    true
end nowrap_steady

// Whether a counted loop's own variable runs untouched by its body, so takes exactly the values its
// range gives it.
nowrap_untouched(e: *Emit, name: string, body: Buf[TStmt]) -> bool
    if !e.nowrap.ready || e.nowrap.escaped.has(name) then return false

    for st in body
        if nw_touches(nw_writes(st), name) then return false

    true
end nowrap_untouched

// What one statement writes, declares or takes the address of, anywhere inside it.
private nw_writes(st: TStmt) -> &NwScan
    val s = nw_scan()

    walk_stmt(st, nw_walker(s))
    s
end nw_writes

// Before the value a list ends with, which the guards its statements proved hold for as well
// (`gen_stmts_with`'s `hold`): every guard it could invalidate is ended, as before a statement.
nowrap_before_tail(e: *Emit, x: TExpr) = nowrap_before(e, TExprStmt(x), true)

// Before a statement of a list: every guard it could invalidate is ended. `tail` says it is the
// list's value, after which nothing the list proved is asked again.
nowrap_before(e: *Emit, st: TStmt, tail: bool = false)
    nw_field_before(e, st, tail)

    var any = false

    for g in e.nowrap.guards
        if g.live then any = true

    if !any then return

    val w = nw_writes(st)

    for i in 0..<e.nowrap.guards.len()
        val g = e.nowrap.guards[i]

        if g.live && (nw_touches(w, g.a) || nw_touches(w, g.b) || nw_touches(w, g.x))
            e.nowrap.guards[i] = NoWrapGuard(g.a, g.b, g.x, g.id, false, g.same)
    end for
end nowrap_before

// After a statement of a list: a declaration may bound its local, and a guard proves its fact.
nowrap_after(e: *Emit, st: TStmt)
    st match
        TVarDecl(name, ty, init, _) ->
            if e.nowrap.once.has(name) && nw_word_unsigned(e, ty) && nw_half(e, init, e.word_bits)
                e.nowrap.bounded.add(name)
        TExprStmt(x) ->
            if !e.terminated
                nw_guard(e, x)
                nw_same_guard(e, x)
                nw_field_guard(e, x)
        _ -> ()
end nowrap_after

// The counts of guards a list began with, which its end truncates back to.
nowrap_mark(e: *Emit) -> (usize, usize) = (e.nowrap.guards.len(), e.nowrap.field_guards.len())

nowrap_release(e: *Emit, mark: (usize, usize))
    e.nowrap.guards.truncate(mark.0)
    e.nowrap.field_guards.truncate(mark.1)
end nowrap_release

nowrap_suspend(e: *Emit)
    e.nowrap.suspended += 1
end nowrap_suspend

nowrap_resume(e: *Emit)
    e.nowrap.suspended -= 1
end nowrap_resume

// A counted loop's body is about to be lowered: its variable runs below `hi` (or up to it), unless
// the body writes it or takes its address. Answers whether it was recorded.
nowrap_enter_for(e: *Emit, name: string, hi: TExpr, body: Buf[TStmt]) -> bool
    if !e.nowrap.ready || e.nowrap.escaped.has(name) then return false

    for st in body
        if nw_touches(nw_writes(st), name) then return false

    e.nowrap.fors.push(NoWrapFor(name, hi, e.nowrap.next_id))
    true
end nowrap_enter_for

nowrap_leave_for(e: *Emit)
    e.nowrap.fors.pop()
end nowrap_leave_for

private nw_word_unsigned(e: *Emit, t: Type) -> bool = underlying(t) match
    Integer(bits, signed, _) -> !signed && bits == e.word_bits
    _ -> false

// Whether every value `x` can produce is at most `isize::MAX` for a `bits`-wide unsigned.
private nw_half(e: *Emit, x: TExpr, bits: int) -> bool = *x.kind match
    TIntLit(v, _) -> cmp(v, from_int(0)) >= 0 && cmp(v, max_of(bits, true)) <= 0
    TLen(r, _) -> bits == e.word_bits && nw_len_half(e, texpr_type(r))
    TCast(operand, _) -> underlying(texpr_type(operand)) match
        Integer(b, signed, _) -> !signed && b < bits
        Bool -> true
        _ -> false
    TLoad(name, _) -> e.nowrap.bounded.has(name) || nw_for_half(e, name, bits)
    TBinary(op, l, r, _) ->
        if op == "&" then nw_half(e, l, bits) || nw_half(e, r, bits)
        else if op == "%" then nw_half(e, r, bits)
        else if op == ">>" then nw_literal_at_least(r, 1)
        else if op == "/" then nw_literal_at_least(r, 2)
        else false
    _ -> false

private nw_literal_at_least(x: TExpr, n: long) -> bool = *x.kind match
    TIntLit(v, _) -> cmp(v, from_int(n)) >= 0
    _ -> false

// A view's length is at most half the address space where each element takes storage.
private nw_len_half(e: *Emit, t: Type) -> bool = underlying(t) match
    Array(n, _, _) -> cmp(from_int(long(n)), max_of(e.word_bits, true)) <= 0
    Slice(elem, _) -> e.layout.size(*elem) > 0
    Str -> true
    _ -> false

// A loop variable runs below its bound (or up to it), so it is bounded where the bound is.
private nw_for_half(e: *Emit, name: string, bits: int) -> bool
    for f in e.nowrap.fors
        if f.name == name then return nw_half(e, f.hi, bits)

    false
end nw_for_half

private nw_load_name(x: TExpr) -> Option[string] = *x.kind match
    TLoad(name, _) -> Some(name)
    _ -> None

// Whether `l + r` at `ty` is proved not to wrap.
nowrap_add(e: *Emit, l: TExpr, r: TExpr, ty: Type) -> bool
    if !nw_word_unsigned(e, ty) then return false
    if nw_half(e, l, e.word_bits) && nw_half(e, r, e.word_bits) then return true
    if e.nowrap.suspended > 0 then return false

    if nw_field_room(e, l, r) || nw_field_room(e, r, l) then return true

    val p = nw_load_name(l)
    val q = nw_load_name(r)

    if p.is_none() || q.is_none() then return false

    for g in e.nowrap.guards
        if g.live && !g.same
            if (p.unwrap() == g.a && q.unwrap() == g.b) || (p.unwrap() == g.b && q.unwrap() == g.a)
                return true

            if p.unwrap() == g.a && nw_runs_below(e, q.unwrap(), g) then return true
            if q.unwrap() == g.a && nw_runs_below(e, p.unwrap(), g) then return true
        end if

    false
end nowrap_add

// Whether `k` is a loop variable bounded by the guard's length and entered after the guard.
private nw_runs_below(e: *Emit, k: string, g: NoWrapGuard) -> bool
    for f in e.nowrap.fors
        if f.name == k && g.id < f.epoch
            nw_load_name(f.hi) match
                Some(b) -> return b == g.b
                None -> return false
    end for

    false
end nw_runs_below

// `x > L`, or `L < x`, with `x` a local read: the local and the other side.
private nw_greater(c: TExpr) -> Option[(TExpr, TExpr)] = *c.kind match
    TCompare(operands, cmps) ->
        if operands.len() != 2 || cmps.len() != 1 || cmps[0].dispatch.is_some()
            None
        else if cmps[0].op == ">"
            Some((operands[0], operands[1]))
        else if cmps[0].op == "<"
            Some((operands[1], operands[0]))
        else
            None
    _ -> None

// `L` as `x.len` of a local view: the view's name.
private nw_len_of(x: TExpr) -> Option[string] = *x.kind match
    TLen(r, _) -> nw_load_name(r)
    _ -> None

// Whether a block always leaves: its last statement is a jump out.
private nw_leaves(b: TBlock) -> bool
    if b.result.is_some() || b.stmts.is_empty() then return false

    b.stmts[b.stmts.len() - 1] match
        TReturn(_) -> true
        TBreak(_, _) -> true
        TContinue(_) -> true
        TBecome(_) -> true
        _ -> false
end nw_leaves

// The two sides of the `||` of an `if` with no `else` whose then-block leaves.
private nw_disjuncts(x: TExpr) -> Option[(TExpr, TExpr)] = *x.kind match
    TIf(cond, then_block, else_block, _) ->
        if else_block.is_some() || cond.len() != 1 || !nw_leaves(then_block)
            None
        else
            cond[0] match
                TCondTest(c) -> *c.kind match
                    TLogical(op, c1, c2) -> if op == "||" then Some((c1, c2)) else None
                    _ -> None
                _ -> None
    _ -> None

// Whether `x` is `L - n`, with `L` the length of `view` and `n` the local `a`.
private nw_room(x: TExpr, view: string, a: string) -> bool = *x.kind match
    TBinary(op, l, r, _) ->
        if op != "-" then false
        else
            val lv = nw_len_of(l)
            val rv = nw_load_name(r)

            lv.is_some() && rv.is_some() && lv.unwrap() == view && rv.unwrap() == a
    _ -> false

// `if n > L || len > L - n then <leave>`, just lowered: records the fact, and says it again as an
// assumption at the start of the fall-through.
private nw_guard(e: *Emit, x: TExpr)
    if !e.nowrap.ready || e.nowrap.suspended > 0 then return

    val found = nw_disjuncts(x)

    if found.is_none() then return

    val first = nw_greater(found.unwrap().0)
    val second = nw_greater(found.unwrap().1)

    if first.is_none() || second.is_none() then return

    val a_x = first.unwrap().0
    val len_x = first.unwrap().1
    val b_x = second.unwrap().0
    val a = nw_load_name(a_x)
    val view = nw_len_of(len_x)
    val b = nw_load_name(b_x)

    if a.is_none() || view.is_none() || b.is_none() then return
    if !nw_word_unsigned(e, texpr_type(a_x)) || !nw_word_unsigned(e, texpr_type(b_x)) then return

    // The right side has to be `L - n` over the same view and the same local.
    if !nw_room(second.unwrap().1, view.unwrap(), a.unwrap()) then return

    val esc = e.nowrap.escaped

    if esc.has(a.unwrap()) || esc.has(b.unwrap()) || esc.has(view.unwrap()) then return

    push_temps(e)

    val w = lty(e, texpr_type(a_x))
    val av = gen_expr(e, a_x)
    val bv = gen_expr(e, b_x)
    val lv = gen_expr(e, len_x)
    val sum = fresh_reg(e)
    val fits = fresh_reg(e)

    emit(e, InBin(sum, OpAddNuw, w, av, bv))
    emit(e, InIntCmp(fits, IUle, w, sum, lv))
    e.uses_assume = true

    var args: Buf[IrArg] = buf()

    args.push(ir_arg(l_i1(), fits))
    emit(e, ir_call(None, LVoid, VGlobal(llvm_assume()), args))
    pop_temps(e)
    e.nowrap.guards.push(NoWrapGuard(a.unwrap(), b.unwrap(), view.unwrap(), e.nowrap.next_id, true,
                                     false))
    e.nowrap.next_id += 1
end nw_guard

// `x.len != y.len` over two views, alone or as a side of an `||` chain: the two views.
private nw_unequal_lens(c: TExpr) -> Option[(string, string)]
    *c.kind match
        TCompare(operands, cmps) ->
            if operands.len() != 2 || cmps.len() != 1 || cmps[0].dispatch.is_some() then return None
            if cmps[0].op != "!=" then return None

            val x = nw_len_of(operands[0])
            val y = nw_len_of(operands[1])

            if x.is_none() || y.is_none() || x.unwrap() == y.unwrap() then return None

            Some((x.unwrap(), y.unwrap()))
        TLogical(op, l, r) ->
            if op != "||" then return None

            val left = nw_unequal_lens(l)

            if left.is_some() then left else nw_unequal_lens(r)
        _ -> None
end nw_unequal_lens

// `if xs.len != ys.len then <leave>`, just lowered: records that the two views are one length, for as
// long as neither is written. Both must be a parameter or a local, whose length nothing behind the
// body's back can change.
private nw_same_guard(e: *Emit, x: TExpr)
    if !e.nowrap.ready || e.nowrap.suspended > 0 then return

    val c = *x.kind match
        TIf(cond, then_block, else_block, _) ->
            if else_block.is_some() || cond.len() != 1 || !nw_leaves(then_block) then return

            cond[0] match
                TCondTest(t) -> t
                _ -> return
        _ -> return

    nw_unequal_lens(c) match
        Some(views) ->
            val (xs, ys) = views
            val plain = e.nowrap.plain
            val esc = e.nowrap.escaped

            if !plain.has(xs) || !plain.has(ys) || esc.has(xs) || esc.has(ys) then return

            e.nowrap.guards.push(NoWrapGuard(xs, ys, ys, e.nowrap.next_id, true, true))
            e.nowrap.next_id += 1
        None -> ()
end nw_same_guard

// Whether a guard in force has shown the views `xs` and `ys` to be one length.
nowrap_same_len(e: *Emit, xs: string, ys: string) -> bool
    for g in e.nowrap.guards
        if g.live && g.same && ((g.a == xs && g.b == ys) || (g.a == ys && g.b == xs)) then return true

    false
end nowrap_same_len

// -- two fields of one struct ---------------------------------------------------------------------

// **A difference of two fields an invariant orders cannot wrap.** `s.hi - s.lo`, both read from one
// place `s` of a struct whose invariant has a conjunct putting `lo` at or below `hi`
// (`invariant_orders`), is the arithmetic difference: every value of the type passed the clause at its
// construction, its zero and every write since, so the one reading of `s` the two loads make finds the
// fields in that order. The operands are read one after the other with nothing between, so no write
// can come between them either. What the checking cannot see is outside it, as it is for the member
// entry's assumption (`contract_assume.sysl`): bytes put into the struct through a pointer of another
// type, or by C. A volatile field is never one -- what is behind it can change between two reads.
nowrap_sub(e: *Emit, l: TExpr, r: TExpr, ty: Type) -> bool
    underlying(ty) match
        Integer(_, signed, _) -> if signed then return false
        _ -> return false

    val (rl, hi) = *l.kind match
        TField(recv, i, _) -> (recv, i)
        _ -> return false

    val (rr, lo) = *r.kind match
        TField(recv, i, _) -> (recv, i)
        _ -> return false

    if !nw_pure_place(rl) || !nw_same_place(rl, rr) then return false

    val d = unqualified(texpr_type(rl)) match
        Struct(d) -> d
        _ -> return false

    if volatile_in(Struct(d)) then return false

    for o in invariant_orders(e, *d)
        if o.0 == lo && o.1 == hi then return true

    false
end nowrap_sub

// A place read with nothing run along the way: a local, a field of one, or what a pointer or a
// reference held in one points at -- none through a volatile.
private nw_pure_place(x: TExpr) -> bool = *x.kind match
    TLoad(_, t) -> !volatile_in(t)
    TField(r, _, t) -> !volatile_in(t) && nw_pure_place(r)
    TDeref(op, _) ->
        val through = pointee(texpr_type(op))

        if through.is_none() || volatile_in(through.unwrap()) then false else nw_pure_place(op)
    _ -> false

// Whether two pure places are one place: the same local, through the same steps.
private nw_same_place(a: TExpr, b: TExpr) -> bool = *a.kind match
    TLoad(n, _) -> *b.kind match
        TLoad(m, _) -> n == m
        _ -> false
    TField(ra, i, _) -> *b.kind match
        TField(rb, j, _) -> i == j && nw_same_place(ra, rb)
        _ -> false
    TDeref(oa, _) -> *b.kind match
        TDeref(ob, _) -> nw_same_place(oa, ob)
        _ -> false
    _ -> false

// The local a pure place starts at.
private nw_place_root(x: TExpr) -> Option[string] = *x.kind match
    TLoad(n, _) -> Some(n)
    TField(r, _, _) -> nw_place_root(r)
    TDeref(op, _) -> nw_place_root(op)
    _ -> None

// `if k >= s.hi - s.lo then <leave>` (or `s.hi - s.lo <= k`), just lowered, where the difference is
// one `nowrap_sub` proves: records that `k + s.lo` stays below `s.hi` from here.
private nw_field_guard(e: *Emit, x: TExpr)
    if !e.nowrap.ready || e.nowrap.suspended > 0 then return

    val c = *x.kind match
        TIf(cond, then_block, else_block, _) ->
            if else_block.is_some() || cond.len() != 1 || !nw_leaves(then_block) then return

            cond[0] match
                TCondTest(t) -> t
                _ -> return
        _ -> return

    val (k_x, d_x) = *c.kind match
        TCompare(operands, cmps) ->
            if operands.len() != 2 || cmps.len() != 1 || cmps[0].dispatch.is_some() then return

            if cmps[0].op == ">=" then (operands[0], operands[1])
            else if cmps[0].op == "<=" then (operands[1], operands[0])
            else return
        _ -> return

    val k = nw_load_name(k_x)

    if k.is_none() || !e.nowrap.plain.has(k.unwrap()) || e.nowrap.escaped.has(k.unwrap()) then return
    if !nw_word_unsigned(e, texpr_type(k_x)) || texpr_type(k_x) != texpr_type(d_x) then return

    val (hi_x, lo_x) = *d_x.kind match
        TBinary(op, l, r, _) -> if op == "-" then (l, r) else return
        _ -> return

    if !nowrap_sub(e, hi_x, lo_x, texpr_type(d_x)) then return

    val (recv, hi) = *hi_x.kind match
        TField(rv, i, _) -> (rv, i)
        _ -> return

    val lo = *lo_x.kind match
        TField(_, i, _) -> i
        _ -> return

    val root = nw_place_root(recv)

    if root.is_none() || !e.nowrap.plain.has(root.unwrap()) || e.nowrap.escaped.has(root.unwrap()) then
        return

    e.nowrap.field_guards.push(NoWrapFieldGuard(k.unwrap(), recv, root.unwrap(), hi, lo, true))
end nw_field_guard

// Whether `l + r` is `k + s.lo` under a field guard in force.
private nw_field_room(e: *Emit, l: TExpr, r: TExpr) -> bool
    val k = nw_load_name(l)

    if k.is_none() then return false

    val (recv, lo) = *r.kind match
        TField(rv, i, _) -> (rv, i)
        _ -> return false

    for g in e.nowrap.field_guards
        if g.live && g.k == k.unwrap() && g.lo == lo && nw_same_place(g.recv, recv) then return true

    false
end nw_field_room

// Before a statement, or the list's value: a field guard ends at anything that is not one of a short
// list of reads, and at a write or a declaration of its `k` or of the local its place starts at.
private nw_field_before(e: *Emit, st: TStmt, tail: bool)
    var any = false

    for g in e.nowrap.field_guards
        if g.live then any = true

    if !any then return

    val inert = nw_inert_stmt(st, tail)
    val w = nw_writes(st)

    for i in 0..<e.nowrap.field_guards.len()
        val g = e.nowrap.field_guards[i]

        if g.live && (!inert || nw_touches(w, g.k) || nw_touches(w, g.root))
            e.nowrap.field_guards[i] = NoWrapFieldGuard(g.k, g.recv, g.root, g.hi, g.lo, false)
    end for
end nw_field_before

// **A statement that can write nothing and run nothing**: a declaration or an expression built only of
// literals, reads of locals, fields, pointees, elements and lengths, and the built-in arithmetic,
// comparisons and conversions over them. Anything else -- a call, a store, a block, a branch, an
// allocation -- might write a field behind a pointer, and is not one. In a statement, a local read
// must hold nothing counted: one read for the last time is let go of where the statement ends, and
// letting go of a count can run a destructor. The list's value is let go of after it is computed,
// so there it may, and may build an enum value as well.
private nw_inert_stmt(st: TStmt, tail: bool) -> bool = st match
    TExprStmt(x) -> nw_inert(x, tail)
    TVarDecl(_, _, init, _) -> nw_inert(init, tail)
    _ -> false

private nw_inert(x: TExpr, tail: bool) -> bool = *x.kind match
    TIntLit(_, _) -> true
    TBoolLit(_) -> true
    TFloatLit(_, _) -> true
    TLoad(_, t) -> tail || !contains_counted(t)
    TField(r, _, _) -> nw_inert(r, tail)
    TDeref(op, _) -> nw_inert(op, tail)
    TIndex(r, i, _) -> nw_inert(r, tail) && nw_inert(i, tail)
    TLen(r, _) -> nw_inert(r, tail)
    TCast(op, _) -> nw_inert(op, tail)
    TBinary(_, l, r, _) -> nw_inert(l, tail) && nw_inert(r, tail)
    TUnary(_, op, _) -> nw_inert(op, tail)
    TLogical(_, l, r) -> nw_inert(l, tail) && nw_inert(r, tail)
    TCompare(operands, cmps) ->
        for c in cmps
            if c.dispatch.is_some() then return false

        for o in operands
            if !nw_inert(o, tail) then return false

        true
    TEnumNew(_, _, args) ->
        if !tail then return false

        for a in args
            if !nw_inert(a, tail) then return false

        true
    _ -> false
