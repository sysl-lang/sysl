module sh.sysl.compiler

import sh.sysl.parsing.Source
import sysl.buf.{Buf, buf}
import sysl.text.{join, str_builder, Search}
import sysl.fs.{exists, make_temp_dir, remove_dir_all, remove_file, current_dir, make_dir_all, pending_name, publish_file, write_text}
import sysl.process.{run as run_child, Status}
import sysl.env.{get as env_var}

// What one invocation compiles: the program's files, the packages it depends on, and the standard
// module every program is compiled against.
//
// **A program is not a file, and this is where that becomes true.** Everything below the parser is
// handed a list of trees; here is where the list is assembled, in the order the questions can be
// answered in -- the manifest first, because it says which machine and which packages, then the
// files under the path the command line named, then the library.

// A whole compilation, ready to be analyzed.
struct Compilation
    // The library's trees first, then the packages', then the program's. Nothing depends on the
    // order -- a module's declarations are one set however many files they came from -- but a report
    // about the program's own files is easier to find at the end of a list than in the middle.
    units: Buf[Program]

    // The modules the program declares of its own, which is what tells a row the program filed from
    // one the library did.
    own: Buf[string]

    target: Target
end Compilation

// What a compilation could not be assembled from: a path that will not read, a manifest that will
// not parse, a library that is not on this machine, a dependency nobody fetched.
//
// **It is not a diagnostic**, because none of these has a source position to point at: they are
// statements about the *project* rather than about a line somebody wrote.
struct Refusal
    message: string
end Refusal

// Why a whole command could not finish, and the two are two because they PRINT differently.
//
// A `Refusal` is a sentence about the project with no `error: ` on it, so the command line puts one
// there. An analysis report is already rendered -- every diagnostic in it carries its own `error: `,
// its source line and its caret -- so a second one in front of it is a word the reference does not
// print. Carrying both as one string is what put it there, and no amount of reading the string tells
// the two apart afterwards.
//
// **A file that does not parse is `Reported`, not `Said`**: its complaint has a line to point at, so
// it is rendered exactly as an analysis error is, and one shape serves every error a reader sees.
enum Failure
    Said(refusal: Refusal)
    Reported(report: string)

    // What it has to say, as `failure_text` reads it.
    message -> string = failure_text(self)
end Failure

// A step's refusal on its way out of a command, which is what `.map_err(said)?` writes.
said(r: Refusal) -> Failure = Said(r)

// And what `?` writes, where a step that can only refuse feeds one that can also report.
impl From[Refusal] for Failure
    from(r: Refusal) -> Failure = Said(r)

// What a failure has to say, with no decision about a prefix in it: the command line adds the word
// where it is owed, and this is what anything else -- a test, the documentation sweep -- reads.
failure_text(f: Failure) -> string = f match
    Said(r) -> r.message
    Reported(report) -> report

// A compilation whose tree **is** the standard module, which is what `--std` says.
//
// **It is written down rather than inferred from the module names in the tree**, and that is the
// reference's own rule: guessing it would turn a clear refusal -- you cannot add to the module every
// program is compiled against -- into a compilation that succeeds and then collides with the
// built-in copy at whatever link tried to use it.
//
// So nothing is prepended and nothing is fetched: there is no library beside this tree, because this
// tree is the library, and a manifest is not read because the library has none. What the files
// declare is what the compilation holds.
std_compilation_of(path: string, t: Target) -> Result[Compilation, Failure]
    val files = std_sources(path, Some(t.os)) match
        Err(why) -> return Err(said(Refusal(why)))
        Ok(found) -> found

    var units: Buf[Program] = buf()

    for i in 0..<files.len()
        val parsed = parse(files.at(i).src, t)

        if !parsed.ok() then return Err(Reported(parse_report(parsed)))

        units.push(parsed.program)

    Ok(Compilation(units, modules_written(units), t))
end std_compilation_of

// What is said of a `--lib` that names a compiled artifact rather than a source tree.
//
// **A `.syslib` is this compiler's cache and not a file anybody names.** What is handed over is the
// directory a library is written in; what was compiled from it is kept where the compiler keeps
// everything it can make again, and found there by the compiler alone. Told by the name rather than
// by reading the file, so that one which is not there at all gets the same answer.
syslib_named_refusal(given: string) -> string =
    s"--lib takes the directory a library's source is in, and '$given' is a '.syslib' — a library " +
    "is handed over as the tree it is written in, and the compiler keeps its own cache of what it " +
    "compiled from one, which nobody names"

// The files of every source root a `--lib` named, parsed for this machine, in the order the roots
// were written (`reference/modules.md § Source roots`).
//
// **A root is simply more modules**: its files join the compilation under the names they wrote,
// with no prefix of their own, which is the whole difference between a root and a package. They
// are marked as handed to the compilation, so what the target provides is the program's to state
// and not the root's.
//
// **A root is a tree**, so each file's header is held to where the file sits exactly as the
// project's are.
private lib_root_units(t: Target) -> Result[Buf[Program], Failure]
    var out: Buf[Program] = buf()
    val libs = lib_roots()

    for i in 0..<libs.len()
        val given = libs.at(i)

        if is_artifact(given) then return Err(said(Refusal(syslib_named_refusal(given))))

        if !exists(given)
            return Err(said(Refusal(s"cannot read a library: '$given' does not exist")))

        val found = collect(given, Some(t.os)) match
            Err(e) -> return Err(said(Refusal(e.message)))
            Ok(f) -> f

        if found.is_empty() then return Err(said(Refusal(s"$given holds no sysl source files")))

        var theirs: Buf[Program] = buf()
        var unparsed: Buf[string] = buf()

        for j in 0..<found.len()
            val parsed = parse(found.at(j).src, t)

            if !parsed.ok() then unparsed.push(parse_report(parsed))
            else theirs.push(parsed.program)

        if !unparsed.is_empty() then return Err(Reported(joined_reports(unparsed)))

        if is_directory(given)
            val strayed = location_reports(found, theirs)

            if !strayed.is_empty() then return Err(Reported(joined_reports(strayed)))

        // A root's own manifest is what `__NAME__` and `__VERSION__` answer with in its files. One
        // that will not read is refused where the graph reads the roots' `dependencies`, so it is not
        // refused here.
        val theirs_said = manifest_of_package(given).unwrap_or(empty_manifest())
        val (manifest, name, version) = manifest_of_tree(given, theirs_said.name, theirs_said.version)

        for j in 0..<theirs.len()
            var unit = theirs.at(j)

            unit.pkg = Packaging("", buf(), true, manifest, name, version)
            out.push(unit)

    Ok(out)
end lib_root_units

// The modules a set of files declares, each once.
private modules_written(units: Buf[Program]) -> Buf[string]
    var out: Buf[string] = buf()

    for i in 0..<units.len()
        val name = module_written(units.at(i))

        if !holds_string(out, name) then out.push(name)

    out
end modules_written

// Everything one invocation reads, given the path the command line named and the machine it is for,
// with each fetched package's modules under the canonical prefix its coordinate gives them -- which
// is what makes two consumers naming one package differently link one copy of it.
//
// **Every command reads this one compilation, `emit-typed` included**, so a dependency has the name
// in the typed tree that it has in the build: two commands answering about one program agree about
// what it is.
packaged_compilation_of(path: string, t: Target) -> Result[Compilation, Failure]
    val root = if is_directory(path) then path else parent_of(path).unwrap_or(".")
    val manifest = manifest_at(root)?

    // What the package says it cannot be built without, asked of the machine it is being built for.
    // Answered here rather than in the analyzer because it is a statement about the project: there
    // is no source position to point at, and a build that cannot mean anything should stop before
    // it parses a line.
    unmet_requirement(manifest, t) match
        None -> ()
        Some(why) -> return Err(said(Refusal(why)))

    val mine = collect(path, Some(t.os)) match
        Err(e) -> return Err(said(Refusal(e.message)))
        Ok(f) -> f

    if mine.is_empty()
        return Err(said(Refusal(s"$path holds no sysl source files")))

    // What each `--lib` named, read before anything is resolved on its account: a root that is not
    // there is a mistake on the command line, and says so ahead of whatever the graph would.
    val handed = lib_root_units(t)?

    var units: Buf[Program] = buf()

    // The library first, so that every name a program's free identifier reaches is declared before
    // the program is read. It is read from **source**, for the target being built for: which files
    // the library has at all is a per-target question.
    val library = std_root() match
        Err(why) -> return Err(said(Refusal(why)))
        Ok(dir) -> dir

    val parsed_std = std_units(library, t) match
        Err(why) -> return Err(said(Refusal(why)))
        Ok(u) -> u

    val std = std_measured(parsed_std, t) match
        Err(why) -> return Err(said(Refusal(why)))
        Ok(u) -> u

    for i in 0..<std.len()
        units.push(std.at(i))

    // Then the packages -- the graph resolved, fetched, and read off disk. They join the compilation
    // once the project's own modules are known, below, which is what decides whose tests are read.
    val fetched = package_sources(root, manifest, t)?

    var theirs: Buf[Program] = buf()

    for i in 0..<fetched.units.len()
        theirs.push(fetched.units.at(i))

    // Then the source roots. **Their modules are not the project's own**: `own` is what decides
    // whose tests a test build keeps, so a root's tests run exactly where the project declares the
    // same module and nowhere else.
    // A root's files read an import line through the project's table, which is where its own
    // manifest's `dependencies` were bound -- a root's modules being filed under the project's names.
    for i in 0..<handed.len()
        var unit = handed.at(i)

        unit.pkg = Packaging("", fetched.root_mounts, true, unit.pkg.manifest, unit.pkg.name,
                             unit.pkg.version)
        theirs.push(unit)

    // What the project's own files mean by the paths at the head of their import lines. The project
    // itself has no prefix -- its modules keep the names they were written with -- and what it has
    // instead is the table the graph built for it.
    val (own_manifest, own_name, own_version) = manifest_of_tree(root, manifest.name, manifest.version)
    val mine_pkg = Packaging("", fetched.root_mounts, false, own_manifest, own_name, own_version)

    var own: Buf[string] = buf()

    // Then the program's own files, its `@tests` files among them. A test body is analyzed like
    // every other -- it is code somebody wrote, held to the same rules -- and what a `@tests` file
    // declares is *marked* rather than dropped, so that an ordinary body reaching one of those names
    // is something to report about rather than a name that was never there.
    //
    // **Every file is parsed before any refusal is made**, so a syntax error in one file does not hide
    // one in another: each file's first complaint is reported, in the order the files were found.
    var mine_units: Buf[Program] = buf()
    var unparsed: Buf[string] = buf()

    for i in 0..<mine.len()
        val parsed = parse(mine.at(i).src, t, fetched.root_features)

        if !parsed.ok() then unparsed.push(parse_report(parsed))
        else mine_units.push(parsed.program)

    if !unparsed.is_empty() then return Err(Reported(joined_reports(unparsed)))

    // A module is a directory, so where the project is a tree each file's header is held to where the
    // file sits. A file named on its own has nothing to be measured against, its header being the
    // whole of what says which module it is in.
    if is_directory(path)
        val strayed = location_reports(mine, mine_units)

        if !strayed.is_empty() then return Err(Reported(joined_reports(strayed)))

    for i in 0..<mine_units.len()
        own.push(module_written(mine_units.at(i)))

    // What the compilation was handed goes in with its scaffolding already out, unless the project
    // declares the same module (`handed_source`).
    for i in 0..<theirs.len()
        val unit = theirs.at(i)

        if holds_string(own, module_written(unit)) then units.push(unit)
        else handed_source(unit) match
            Some(kept) -> units.push(kept)
            None -> ()

    for i in 0..<mine_units.len()
        var unit = mine_units.at(i)

        unit.pkg = mine_pkg
        units.push(unit)

    Ok(Compilation(units, own, t))
end packaged_compilation_of

// A file a compilation is handed -- a `--lib` root's, a fetched package's -- with that library's
// **test scaffolding taken out before anything reads it**: a `@tests` file is nothing, and an
// ordinary file loses every `@test` function and hook written in it.
//
// **Those belong to `sysl test` of the library that wrote them, and to no build of a consumer.**
// Dropping them after analysis is too late: by then a dependency's test file has been name-resolved
// against the *consumer's* machine, and `sysl.fs` declares no `make_temp_dir` on one with no
// operating system -- so a library whose tests made a scratch directory could not be linked by a
// board program at all, refused over a file no build of that program keeps
// (`reference/modules.md § A @tests file states its own capabilities`). A test file's type errors
// reached the consumer the same way, and so would an import of the library's own
// `dev_dependencies`, which a consumer never resolves.
//
// It is sound because every reference into the scaffolding has to come from scaffolding, so what
// is left names nothing that went. **A module the project also declares keeps its tests**: those run
// with the project's own, where the module is the project's to test.
private handed_source(unit: Program) -> Option[Program]
    if unit.test_only then return None

    var kept: Buf[Stmt] = buf()

    for i in 0..<unit.body.len()
        val s = unit.body.at(i)

        val scaffolding = *s.kind match
            FuncDecl(f) -> f.test.is_some() || f.hook.is_some()
            _ -> false

        if !scaffolding then kept.push(s)

    var out = unit

    out.body = kept
    Some(out)
end handed_source

// The module a file contributes to: what its header says, or the anonymous root module where it
// declares none.
module_written(unit: Program) -> string =
    if unit.module_name.is_none() then "" else unit.module_name.unwrap().show()

// A module is a directory, and its name is that directory's path below the project root -- so a
// file's header has to agree with where the file sits.
//
// **Checking the header against the location subsumes checking a directory's files against each
// other**: they are each held to the same derived name, so a file edited without its siblings is
// reported on its own line rather than as a disagreement with whichever sibling was read first.
check_locations(found: Buf[Found], units: Buf[Program]) -> Buf[string]
    var out: Buf[string] = buf()

    for i in 0..<found.len()
        location_refusal(found.at(i), units.at(i)) match
            Some(said) -> out.push(said)
            None -> ()

    out
end check_locations

// What one file's header and location have to say about each other, where they disagree.
private location_refusal(found: Found, unit: Program) -> Option[string]
    val expected = dotted(found.dir)
    val declared = module_written(unit)

    if declared == expected then return None

    val theirs = if declared == "" then "declares no module" else s"declares '$declared'"
    val here = if expected == "" then "sits at the project root" else s"sits in '$expected'"

    Some(s"${found.src.name} $theirs, but it $here — a module is a directory, so the two must agree")
end location_refusal

// The same, rendered: at the header where the file wrote one, at its first statement where it wrote
// none, and with no location at all for a file with nothing in it, there being nothing to point at.
private location_reports(found: Buf[Found], units: Buf[Program]) -> Buf[string]
    var out: Buf[string] = buf()

    for i in 0..<found.len()
        val unit = units.at(i)

        location_refusal(found.at(i), unit) match
            None -> ()
            Some(said) ->
                var one: Buf[Placed] = buf()

                if unit.module_name.is_some() then
                    one.push(placed_error(unit.src, unit.module_name.unwrap().span, said))
                else if !unit.body.is_empty() then
                    one.push(placed_error(unit.src, unit.body.at(0).span, said))

                out.push(if one.is_empty() then s"error: $said" else analysis_report(one))

    out
end location_reports

// Several rendered reports, one blank line between each, as an analysis report separates them.
joined_reports(all: Buf[string]) -> string
    var out = ""

    for i in 0..<all.len()
        if i > 0 then out = out + "\n\n"

        out = out + all.at(i)

    out
end joined_reports

private dotted(parts: Buf[string]) -> string
    var out = ""

    for i in 0..<parts.len()
        if i > 0 then out = out + "."

        out = out + parts.at(i)

    out
end dotted

// `sysl emit-typed [--no-spans] [--tables] [--target <name>] <path>` -- one program's typed tree,
// written out as deterministic text, or its declaration tables under `--tables`.
//
// **It stops at the same typed tree a proof reads, and for the same reason**: analysis has already
// checked every rule that could fail, and nothing past this point -- pruning, lowering, codegen --
// is needed to answer whether two compilers agree on what a program means.
//
// The path is a **program** rather than a file: a directory is the project root and everything below
// it is compiled, and a single file is compiled alone as the root module. Either way the standard
// module is read from source and analyzed with it, so the library's declarations are in scope
// exactly as they are for a build.
emit_typed_text(path: string, named_target: Option[string],
                tables: bool) -> Result[Emitted, Failure] =
    Ok(typed_text(typed_compilation(path, named_target)?, tables))

// The compilation `emit-typed` and `prove` read: the program at `path`, with its packages, for the
// target it names or its manifest's default.
typed_compilation(path: string, named_target: Option[string]) -> Result[Compilation, Failure]
    val root = if is_directory(path) then path else parent_of(path).unwrap_or(".")
    val manifest = manifest_at(root)?

    val chosen = named_target match
        Some(name) -> name
        None -> manifest.default_target

    val registered = if chosen == "" then host_target()
    else target_resolved(chosen) match
        Err(why) -> return Err(said(Refusal(why)))
        Ok(found) -> found

    val t = as_declared(manifest, registered)

    root_floor_refusal(manifest.floor) match
        None -> ()
        Some(why) -> return Err(said(Refusal(why)))

    packaged_compilation_of(path, t)
end typed_compilation

// `sysl emit-llvm [--target <name>] [-O<level>] <path>` -- one program's LLVM text.
//
// **It is the same command line the reference compiler answers**, so agreement between the two is
// one `diff` and a disagreement names the line. What this compiler lowers today is the module
// header and the named types a program's values are stored at; the sections a function body fills
// are empty, which is what makes the comparison one of a section rather than of a whole.
//
// **The level decides which standard-module archive is resolved** -- the text declares the same
// symbols at every level, but the archive a later link takes them from is the level's own.
emit_llvm_text(path: string, named_target: Option[string],
               level: string = DefaultOptimization,
               also_auto_imported: Buf[string] = buf()) -> Result[Emitted, Failure]
    val t = target_for(path, named_target)?
    val program = packaged_compilation_of(path, t)?
    val done = analyze_bodies(program.units, program.target, also_auto_imported)

    // Everything a program is held to on the way to being lowered runs on the **unpruned** tree: a
    // declaration nothing can reach is still one the program declared, and checking it is what makes
    // a mistake in it a mistake at all.
    val whole = program_of(done, done.main_module)

    val promotions = post_analysis_checks(done.an, whole, program.own)

    explain_promotions(promotions, program, done.an)

    // The tests go next, and they go **after** the analysis rather than instead of it: a `@test`
    // that does not compile is an error in a build that would never have run it, which is what makes
    // it safe to leave one beside the code it tests. Pruning is then the last thing that happens to
    // the tree and the only thing between the checks and the lowering.
    val kept = prune(strip_tests(whole), program.own)

    // **What the library already compiled**, so this module declares those rather than defining them
    // a second time; their bodies arrive from the artifact at link time. It is asked after the
    // pruning and not before: a library function this program never calls is dropped exactly as it
    // was, and what `precompiled` changes is only what happens to the ones it does call.
    // **A machine with no toolchain has no artifact, and that is the one target this command is the
    // whole story for.** CRAFT's back end is out of tree, so `sysl emit-llvm --target
    // craft-freestanding` is how a program for it is produced at all -- refusing here for want of an
    // archive nothing was going to link would refuse the command in the only case it is essential.
    // Nothing is precompiled, so the library's bodies are lowered into the text with the program's.
    // **`--no-std-lib` is the same answer asked for on purpose**: nothing is looked for, and the
    // library's bodies are lowered here while its C is compiled beside the program's.
    var linked = StdArtifact(buf(), "")

    std_linked(t, level, !t.builds_with_clang()) match
        Err(why) -> return Err(said(Refusal(why)))
        Ok(Some(found)) -> linked = found
        Ok(None) -> ()

    val lowered = codegen_with_gaps(kept with { precompiled = linked.precompiled }, t, promotions)

    // Read back out of the analysis rather than off the snapshot the body pass answered with: the
    // checks above have just added to it.
    Ok(Emitted(ir_print_module(lowered.0), errors_of(done.an.diagnostics()), lowered.1,
              link_required(program.units)))
end emit_llvm_text

// What `--explain-escapes` reports about the program's own files: one line per array the escape
// analysis moved to the heap. A program that failed to compile reports nothing, since it was never
// going to allocate anything.
private explain_promotions(pr: Promotions, program: Compilation, an: &Analysis)
    if !errors_of(an.diagnostics()).is_empty() then return

    // The files of the modules the program declared, which is what a note is about.
    var files: Buf[string] = buf()

    for i in 0..<program.units.len()
        val unit = program.units.at(i)

        for j in 0..<program.own.len()
            if program.own.at(j) == module_written(unit)
                files.push(unit.src.name)
                break

    var lines: Buf[string] = buf()

    for i in 0..<pr.notes.len()
        for j in 0..<files.len()
            if files.at(j) == pr.notes.at(i).0
                lines.push(pr.notes.at(i).1)
                break

    explain_escapes(lines)
end explain_promotions

// The machine a command line asked for: the one it named, the manifest's default, or this host --
// with the floor the manifest states checked before anything is read.
target_for(path: string, named_target: Option[string]) -> Result[Target, Refusal]
    val root = if is_directory(path) then path else parent_of(path).unwrap_or(".")
    val manifest = manifest_at(root)?

    val chosen = named_target match
        Some(name) -> name
        None -> manifest.default_target

    val t = if chosen == "" then host_target()
    else target_resolved(chosen) match
        Err(why) -> return Err(Refusal(why))
        Ok(found) -> found

    root_floor_refusal(manifest.floor) match
        None -> ()
        Some(why) -> return Err(Refusal(why))

    // **And the heap it allocates through**, settled here because this is the one funnel every
    // command that lowers anything comes through, and it comes through before the standard module's
    // artifact is looked for -- whose path, metadata and object half are all the pair's. Two packages
    // naming different pairs are refused on every target rather than only where no libc stands in.
    choose_allocator(allocator_claims(root, manifest)) match
        Err(why) -> return Err(Refusal(why))
        Ok(pair) -> use_allocator(pair)

    // The machine as the project describes it, which is what the analysis holds a module to.
    Ok(as_declared(manifest, t))
end target_for

// The level every clang a build drives is handed: what the command line named, then the ROOT
// manifest's `optimization`, then `DefaultOptimization`.
//
// **Naming none and naming the default are two answers**, which is why the flag arrives as an
// `Option`: a build that typed `-O1` typed it, and no key may overrule it. **A dependency's key is
// never consulted** -- a library that could set the level would be deciding how its consumer's whole
// program is compiled -- and is not an error either, since it is simply not the project being built.
// A manifest that will not read answers the default here, the build that follows refusing it in its
// own words.
//
// **A level the command line named is refused here, before anything reaches the cache**, since every
// command that builds comes through this call before it reads the manifest or looks for the standard
// module's artifact -- and the level names that artifact's directory. Left to clang, `-O7` and `-O-1`
// were not refused at all: clang warns that it is using `-O3` instead, nobody is shown the warning,
// and a whole standard module was built and kept under a key that says something else.
build_level(path: string, given: Option[string]) -> Result[string, Failure]
    given match
        Some(level) ->
            for i in 0..<CommandLineLevels.len
                if CommandLineLevels[i] == level then return Ok(level)

            return Err(Said(Refusal(s"'-O$level' names no level clang has — it is one of " +
                                    join(CommandLineLevels, ", "))))
        None -> ()

    val root = if is_directory(path) then path else parent_of(path).unwrap_or(".")

    manifest_at(root) match
        Ok(m) -> Ok(m.optimization.unwrap_or(DefaultOptimization))
        Err(_) -> Ok(DefaultOptimization)
end build_level

// The levels a command line may name: the manifest's six, and the two more clang has that a person
// reaches for at a build rather than writes into a file every consumer reads.
val CommandLineLevels: []const string = ["0", "1", "2", "3", "s", "z", "fast", "g"]

// **A heap the machine has no libc to supply, said before the linker is asked.** A package requiring
// one, built for a freestanding target by a command that links, has asked for `malloc` and `free`
// from a machine that has neither -- and what a reader got was one `undefined symbol` line per
// allocation, from a toolchain that already knew the answer.
//
// **It cannot be folded into `unmet_requirement`, and the reason is the point**: a capability the
// manifest does not take away is provided, so a freestanding target answers "I have a heap" and that
// test is empty. **So the discriminator is who does the link**: only the commands that link call
// this, `build-c` and `build-lib` leaving the allocator to CMake or Gradle, which the compiler cannot
// see. **Naming an allocator is the way out, and naming libc's own pair is not** -- the symbols still
// have to come from somewhere -- so what is tested is the pair the program ends up with, the
// project's own claim folded in beside every package's.
private heap_refusal(path: string, t: Target) -> Result[unit, Refusal]
    if os_hosted(t.os) then return Ok(())

    val root = if is_directory(path) then path else parent_of(path).unwrap_or(".")
    val manifest = manifest_at(root)?
    var wants = false

    for i in 0..<manifest.requires.len()
        if manifest.requires.at(i) == "heap" then wants = true

    if !wants then return Ok(())

    val pair = choose_allocator(allocator_claims(root, manifest)) match
        Err(why) -> return Err(Refusal(why))
        Ok(chosen) -> chosen

    if pair.0 != "malloc" || pair.1 != "free" then return Ok(())

    Err(Refusal(s"this package requires a heap and '${t.name}' is freestanding, so nothing supplies " +
        s"'${pair.0}' and '${pair.1}' — the link would answer with an undefined symbol for each. " +
        "Name a heap of your own in package.hocon's 'allocator' block, or build for a target that " +
        "has a libc"))
end heap_refusal

// Every allocator a program's packages named, the project's own first under "this project".
//
// **A `--lib` source root's claim is read too, named as the root was given**: a heap is a property
// of the package and not of the road it arrived by, so the same directory settles the program's heap
// whether a coordinate or the flag handed it over (`reference/packages.md § One heap`). Read from a
// coordinate alone, the package's own objects came out of its heap and every string beside them out
// of libc's, with nothing said. A root with no `package.hocon` has nothing to claim.
private allocator_claims(root: string, m: Manifest) -> Buf[(string, (string, string))]
    var claims: Buf[(string, (string, string))] = buf()

    m.allocator match
        Some(pair) -> claims.push(("this project", pair))
        None -> ()

    val trees = handed_trees(root, m)

    for i in 0..<trees.len()
        manifest_at(trees.at(i).dir) match
            Ok(theirs) -> theirs.allocator match
                Some(pair) -> claims.push((trees.at(i).who, pair))
                None -> ()
            Err(_) -> ()

    claims
end allocator_claims

// What `emit-typed` came to: the text to print, and what the analyzer had to say. A program the
// compiler refused prints nothing on standard output, exactly as every compiling command does.
struct Emitted
    text: string
    report: Buf[Placed]

    // The bodies the lowering left out, each as its key and the form it reached. It is empty for
    // every command but `emit-llvm`, and there only while some form is still unbuilt -- what a
    // partial lowering owes is a census of what it did not say, so that the differential proof can
    // tell an absence from a wrong answer.
    gaps: Buf[(string, string)]

    // What the result has to be linked against: every `@link` directive of every unit that went in,
    // the standard module's included. **It is here rather than inside the IR because it is not a
    // property of the code** -- it is a property of the *build*, and the only pass that can answer it
    // is the one holding every unit. A driver with the text alone could not work it out by reading
    // it: an `extern` says which symbol it wants and never which library has it.
    links: Buf[string]
end Emitted

// The typed tree: every body this compilation could type, in the `funcs:` section the reference
// compiler prints them in.
//
// **The sections around it are what reachability decides**, which is the stage above this one: a
// reference tree holds only the structs, enums and functions a program *reaches*, so printing the
// whole set here would be printing a different question's answer.
//
// **What the compilation was handed has its tests stripped, and the program's own keep theirs**
// (`strip_handed`): the build strips every test after analysis and this stops before that, so the
// program's own `@test` functions are part of what it declares, where a dependency's never are in
// any build of this program.
//
// **`--tables` is the same program read by its tables** (`show_tables`), so the two views of one
// compilation cannot disagree about what it reached.
private typed_text(c: Compilation, tables: bool) -> Emitted
    val (shown, report) = typed_program(c)
    val text = if tables then show_tables(shown) else show_typed_program(shown)

    Emitted(text, report, buf(), buf())
end typed_text

// The typed tree a compilation answers with, and what its analysis reported -- the tree `emit-typed`
// prints and `prove` translates.
typed_program(c: Compilation) -> (TProgram, Buf[Placed])
    val done = analyze_bodies(c.units, c.target)

    (strip_handed(program_of(done, done.main_module), c.own), errors_of(done.reported))
end typed_program

// Whether a body is one a program **emits**, which is the question a printed tree answers.
//
// An instantiation at a **type parameter** is a diagnostic shape rather than a laid-out one: the
// walk that reads a generic body once at its own definition builds one, and no value at run time
// has that type. It has no layout to emit, so it is left out here rather than reaching a back end
// that would have to invent one.
private emitted_body(f: TFunc) -> bool
    for i in 0..<f.params.len()
        if mentions_abstract(f.params.at(i).1) then return false

    !mentions_abstract(f.ret_ty)
end emitted_body

// `sysl build [--target <name>] [--cc <path>] [-O<level>] [-o <exe>] <path>` -- one program,
// compiled and linked into something the machine will run.
//
// **Emission ends at LLVM text and a build does not.** What is decided here is the whole of the rest:
// which clang, what C the tree carried, and what is on the link line. The text itself is exactly what
// `emit-llvm` prints, so a build and a diff are the same lowering seen twice.
//
// The library's own C is compiled beside the program's, because this compiler defines the library's
// functions rather than declaring them against an artifact somebody already built -- so whatever
// those definitions call into has to be here too.
//
// `also_auto_imported` is `Analysis.also_auto_imported`, and no command line fills it.
build_native_program(path: string, named_target: Option[string], cc: Option[string], level: string,
                     out: Option[string],
                     also_auto_imported: Buf[string] = buf()) -> Result[string, Failure]
    val t = target_for(path, named_target).map_err(said)?

    heap_refusal(path, t).map_err(said)?

    // Asked **before** anything is lowered: the reader asked for a build of a machine that cannot be
    // built, which is one mistake with one answer, and a failure deep in the toolchain would
    // describe the last step rather than the first.
    if !t.builds_with_clang() then return Err(Said(Refusal(t.no_toolchain())))

    val emitted = emit_llvm_text(path, named_target, level, also_auto_imported)?

    if !emitted.report.is_empty() then return Err(Reported(analysis_report(emitted.report)))

    val exe = out match
        Some(named) -> named
        None -> default_executable(path)

    // **The output being a directory is caught here rather than by the linker.** A project named for
    // its own module directory is the obvious layout and reaches this without trying: the executable
    // takes the package's name, the module directory has the same one, and `ld` answers
    // `open() failed, errno=21 (Is a directory)` -- an errno naming neither the package nor the
    // directory, from a tool the reader did not invoke.
    if is_directory(exe)
        if out.is_some() then return Err(Said(Refusal(
            s"'-o $exe' names a directory, and an executable cannot be written over one")))

        return Err(Said(Refusal(s"this project builds an executable named '${basename(exe)}', and " +
            s"'$exe' is a directory — the two cannot both have that name. Rename the package or " +
            "the directory, or say where the binary goes with '-o <path>'")))
    end if

    link_lowered_text(path, emitted.text, t, cc, level, exe, false, emitted.links).map_err(said)?
    Ok(exe)
end build_native_program

// `sysl build-c [--target <name>] [--cc <path>] [-O<level>] [-o <archive>] [--header <path>] <path>`
// -- the static archive and the C header a C project is handed.
//
// **This is a build with a different ending.** The compilation is the ordinary one rather than a
// library build, because what is wanted is a module lowered for *this* target with its calls
// resolved, not a tree of declarations somebody else will compile. What differs from `build` is the
// entry point, which is suppressed, and the ending: an archive rather than a link.
//
// **The standard module is compiled into the archive**, always, and this is the one thing `build-c`
// decides differently from every other command. A `.syslib` is not something a C project can link:
// an archive referring to code no reachable file contains fails at the C link naming `sysl$prints`,
// which is a symbol its author has no way to place. So the archive stands alone or it is not an
// artifact.
//
// **What is NOT in the archive is what this build's own libraries supply** -- `libm`, and whatever
// `@link` named -- and the report says so rather than leaving it to be discovered at the C project's
// link. Those are libraries the author chose and can be given to a linker, which is exactly the
// distinction the standard module fails.
//
// **`lto` makes every member LLVM bitcode, and only the command line asks for it.** The manifest's
// `lto` key is how the project's OWN link is done, and `build-c` does no link: the archive is for a C
// project whose linker may be GNU ld, which refuses bitcode as "file format not recognized". So a
// host linking with clang and lld opts in with `--lto`, and is told how the archive must be linked.
build_c_archive(path: string, named_target: Option[string], cc: Option[string], level: string,
                out: Option[string], header_at: Option[string],
                say: string -> unit, lto: Option[string] = None) -> Result[(string, string), Failure]
    val t = target_for(path, named_target).map_err(said)?

    if !t.builds_with_clang() then return Err(Said(Refusal(t.no_toolchain())))

    // Before the compile rather than after: the archiver is not needed until the end, so discovering
    // it late would make "there is no llvm-ar" a thing somebody waited the whole build for.
    val archiver = find_ar(None) match
        Err(why) -> return Err(Said(Refusal(why)))
        Ok(found) -> found

    val lowered = lower_for_c(path, t)?

    if !lowered.emitted.report.is_empty()
        return Err(Reported(analysis_report(lowered.emitted.report)))

    val archive_at = out match
        Some(named) -> named
        None -> s"${default_executable(path)}.a"

    val header_out = header_at match
        Some(named) -> named
        None -> s"$archive_at.h"

    val clang = find_clang(t, cc) match
        Err(why) -> return Err(Said(Refusal(why)))
        Ok(found) -> found

    val probed = supplied_or_refused(path, t).map_err(said)?

    val staging = make_temp_dir("sysl-c-") match
        Err(_) -> return Err(Said(Refusal("cannot make a directory to build the archive in")))
        Ok(dir) -> dir

    var members: Buf[string] = buf()

    val made = build_c_members(clang, archiver, staging, path, archive_at, lowered.emitted.text,
                               &members, t, level, probed, lto)

    discard_objects(members)
    remove_dir_all(staging)

    made match
        Err(why) -> return Err(Said(why))
        Ok(_) -> ()

    make_dir_all(parent_of(header_out).unwrap_or("."))

    write_text(header_out, c_header_render(lowered.exports, header_name(path))) match
        Err(_) -> return Err(Said(Refusal(s"cannot write $header_out")))
        Ok(_) -> ()

    say(s"wrote $archive_at")
    say(s"wrote $header_out")

    // A build that exported nothing produced an archive with no way in, and the author almost
    // certainly meant to mark something. It is a warning rather than a refusal because an archive of
    // pure C shims is a real thing to want, and because the header says the same on its face.
    if lowered.exports.is_empty()
        say("sysl: warning: nothing in this module is marked '@export', so the archive has no C " +
            "entry point")

    // The libraries this object still needs, which the C project's link line has to carry. Said here
    // because nothing downstream will say it: an unresolved sysl symbol at that link reads as a
    // missing definition rather than as a missing archive.
    if !lowered.emitted.links.is_empty()
        say(s"sysl: link this against: ${joined(lowered.emitted.links, ", ")}")

    // **A package binds an installed library through `pkg_config` and need say `@link` nowhere**, so
    // the directives alone are not the link line: the C author would meet the library's symbols as
    // undefined. `pkg-config` itself is what answers for them, so that is what is named.
    val required = pkg_config_names(path)

    if !required.is_empty()
        say("sysl: and against what the packages require, which pkg-config answers for: " +
            s"pkg-config --libs ${joined(required, " ")}")

    if lto.is_some()
        say("sysl: this archive is LLVM bitcode: link it with clang and lld (-fuse-ld=lld), or with " +
            "a linker that carries LLVM's plugin")

    Ok((archive_at, header_out))
end build_c_archive

// What a header's include guard is named for: the project's manifest name, and the directory it is
// in where it has none.
private header_name(path: string) -> string
    val root = if is_directory(path) then path else parent_of(path).unwrap_or(".")

    manifest_at(root) match
        Ok(m) -> if m.name == "" then basename(root) else m.name
        Err(_) -> basename(root)
end header_name

// Every `pkg_config` name the project, its packages and its `--lib` roots require, each once, in the
// order met -- an archive carries a root's C as it does a package's.
private pkg_config_names(path: string) -> Buf[string]
    var names: Buf[string] = buf()

    pkg_config_needs(path, true) match
        Err(_) -> ()
        Ok(needs) ->
            for i in 0..<needs.len()
                val pc = needs.at(i).pc
                var seen = false

                for j in 0..<names.len()
                    if names.at(j) == pc then seen = true

                if !seen then names.push(pc)

    names
end pkg_config_names

// `sysl emit-header <path>` -- the header `build-c` writes, with nothing compiled or archived.
c_header_of(path: string, named_target: Option[string]) -> Result[string, Failure]
    val t = target_for(path, named_target).map_err(said)?
    val lowered = lower_for_c(path, t)?

    if !lowered.emitted.report.is_empty()
        return Err(Reported(analysis_report(lowered.emitted.report)))

    Ok(c_header_render(lowered.exports, header_name(path)))
end c_header_of

// What the archive is made of, kept apart from the call above so that the staging members are
// discarded whichever step failed.
private build_c_members(clang: string, archiver: string, staging: string, path: string,
                        out: string, ir: string, members: *Buf[string], t: Target, level: string,
                        probed: PkgAnswer, lto: Option[string]) -> Result[unit, Refusal]
    val code = s"$staging/$SyslibCodeMember"

    // A bitcode archive is one module: its units would be merged by a relocatable link, which reads
    // objects and not bitcode, and the link that reads it splits the work again anyway.
    val compiled = if lto.is_some() then compile_object(clang, ir, code, t, level, lto)
    else compile_object_in_units(clang, ir, code, t, level)

    compiled match
        Err(why) -> return Err(Refusal(why))
        Ok(_) -> ()

    members.push(code)

    // **Every tree the compilation walked, not the project's own.** A source root named with `--lib`
    // and a package a `dependencies` block brought in answer the same way the project itself does:
    // their C is compiled and reaches the link. The standard module's is here too, which an ordinary
    // build takes from the artifact -- an object the archive left out is one the C author has no way
    // to supply and no way to hear about, since the sysl half compiled cleanly and only the C
    // project's linker ever notices.
    val trees = c_trees_of(path)

    for i in 0..<trees.len()
        val root = trees.at(i)

        val found = c_sources(root, Some(t.os)) match
            Err(e) -> return Err(Refusal(e.message))
            Ok(cs) -> cs

        val declared: &Manifest = manifest_at(root).unwrap_or(empty_manifest())

        carried_defines(declared, found) match
            Err(why) ->
                return Err(Refusal(defines_refusal(
                    if is_directory(path) then path else parent_of(path).unwrap_or("."), root, why)))
            Ok(_) -> ()

        for j in 0..<found.len()
            val obj = s"$staging/${native_member(root, found.at(j))}"

            make_dir_all(parent_of(obj).unwrap_or("."))

            compile_c(clang, found.at(j), obj, t, level, probed,
                      defines_for(declared, found.at(j)), lto) match
                Err(why) -> return Err(Refusal(why))
                Ok(_) -> ()

            members.push(obj)

    make_dir_all(parent_of(out).unwrap_or("."))

    archive(archiver, *members, out) match
        Err(why) -> Err(Refusal(why))
        Ok(_) -> Ok(())
end build_c_members

// A `defines` block that names C its tree does not carry, as the refusal reads: where the tree is a
// package's, its canonical prefix goes in front, since the consumer meets the mistake and has to be
// told whose manifest made it.
private defines_refusal(project: string, tree: string, why: string) -> string
    val said = manifest_refusal(why)

    manifest_at(project) match
        Err(_) -> said
        Ok(m) ->
            val trees = handed_trees(project, m)

            // A package is named; a source root is not, its manifest being read where it stands as
            // the project's is.
            for i in 0..<trees.len()
                if trees.at(i).dir == tree && !trees.at(i).from_lib
                    return s"'${trees.at(i).who}': $said"

            said
end defines_refusal

// Every tree whose C belongs in the archive: the project's own, each package it takes, each source
// root it was handed, and the standard module's.
private c_trees_of(path: string) -> Buf[string]
    var trees: Buf[string] = buf()
    val root = if is_directory(path) then path else parent_of(path).unwrap_or(".")

    if is_directory(path) then trees.push(path)

    manifest_at(root) match
        Ok(m) ->
            val roots = handed_trees(root, m)

            for i in 0..<roots.len()
                trees.push(roots.at(i).dir)
        Err(_) -> ()

    std_root() match
        Ok(library) -> trees.push(library)
        Err(_) -> ()

    trees
end c_trees_of

// What a `build-c` lowering answers with: the text, and the exports the header is written from.
struct LoweredForC
    emitted: Emitted
    exports: Buf[TFunc]
end LoweredForC

// The lowering an archive gets, which differs from a program's in exactly two places: there is no
// entry point, and nothing is precompiled.
//
// **`c_artifact` is `!entry_point` here and only here.** A `.syslib` also has no entry point and is
// not a C artifact: it is linked by a program that has one, and the library build has already
// deferred every function reaching computed storage to it. An archive has nobody to defer to, so it
// carries a constructor of its own where the platform runs one.
private lower_for_c(path: string, t: Target) -> Result[LoweredForC, Failure]
    val program = packaged_compilation_of(path, t)?

    // **Told there is no entry point before a declaration is read, and that is not a detail.** A
    // file with no `module` header holding a `val` is a program's entry file, whose declarations are
    // that body's locals -- so an archive analyzed as an ordinary program has its `@export`s renamed
    // into nested functions of a body nothing emits, and the header comes out empty. There is no
    // beginning here for a binding to be local to.
    val done = analyze_produced(program.units, program.target, buf(), false)
    //
    // **Which build this is is set on the tree before the checks read it**, since one of them asks
    // whether anything will fill this artifact's module storage -- and read off the default it would
    // be asking about a program that is not being built.
    val whole = program_of(done, done.main_module) with { entry_point = false, c_artifact = true }
    val promotions = post_analysis_checks(done.an, whole, program.own)

    explain_promotions(promotions, program, done.an)

    val kept = prune(strip_tests(whole), program.own)
    val lowered = codegen_with_gaps(kept, t, promotions)

    Ok(LoweredForC(Emitted(ir_print_module(lowered.0), errors_of(done.an.diagnostics()), lowered.1,
                           link_required(program.units)),
                   exports_by_symbol(kept.funcs)))
end lower_for_c

// The tail every command that produces a binary shares: the clang, the tree's own C, the standard
// module's archive, and the link.
//
// **It is one function because a test build and an ordinary one have to link the same way.** A
// package's tests are exactly what exercises the C it ships, so a test run that got a different link
// line would fail on the one tree most likely to have one -- which is the tree whose author is
// running `sysl test`.
private link_lowered_text(path: string, text: string, t: Target, cc: Option[string], level: string,
                          exe: string, standalone: bool,
                          links: Buf[string]) -> Result[unit, Refusal]
    val clang = find_clang(t, cc) match
        Err(why) -> return Err(Refusal(why))
        Ok(found) -> found

    // **What this machine says about the libraries the packages named**, asked once for the whole
    // build. It answers both halves of one fact: the `--cflags` a binding's own C is compiled with,
    // and the `-L`, `-l` and `-Wl,-rpath` its archive is linked with.
    val probed = supplied_or_refused(path, t)?

    val objects = native_objects(clang, path, exe, t, level, probed)?

    // **The standard module is linked rather than compiled**, which is `precompiled` seen from the
    // other end: the text above declares the library's determined half, and the archive is where
    // those bodies -- and the library's own C, compiled when the artifact was -- come from. A
    // `.syslib` **is** an archive, so it goes on the link line as it stands and the linker takes only
    // the members that resolve something.
    var link_with = objects

    // **Nothing is linked where the tree being built IS the library**, which is `--std`: its bodies
    // are in the text above rather than in an archive, and an artifact on the line would put a
    // second copy of every one of them in front of the linker.
    // **Nor where the build was told to compile it from source** (`--no-std-lib`): its bodies are in
    // the text too, and its C is among the objects above.
    std_linked(t, level, standalone) match
        Err(why) ->
            discard_objects(objects)
            return Err(Refusal(why))
        Ok(Some(found)) -> link_with.push(found.archive)
        Ok(None) -> ()

    build_native(clang, text, link_with, exe, t, level, links, probed) match
        Err(why) ->
            discard_objects(objects)
            return Err(Refusal(why))
        Ok(_) -> ()

    discard_objects(objects)
    Ok(())
end link_lowered_text

// `sysl run [--target <name>] [--cc <path>] [-O<level>] <path> [-- <args>]` -- one program, built and
// then executed, with the shell hearing whatever the program exited with.
//
// **A build for a machine that is not this one is refused here rather than built and then found
// unrunnable**: what the reader asked for cannot be carried out, and the answer names the command
// that can.
//
// **What was built last time is what is run**, where the key over everything that can reach the
// bytes matches (`run_cache.sysl`). The check is here rather than beside the link, and that is the
// whole of what it buys: the lowering below is the expensive half, so a cache consulted after it
// would have saved the linker's second and paid the analyzer's minutes.
run_native_program(path: string, named_target: Option[string], cc: Option[string], level: string,
                   args: Buf[string]) -> Result[int, Failure]
    val t = target_for(path, named_target).map_err(said)?

    heap_refusal(path, t).map_err(said)?
    not_this_machine(t, "run").map_err(said)?

    val key = run_cache_key_for("run", path, named_target, level, cc)

    // A cached build was compiled without the question being asked, so one that wants the report
    // compiles again.
    key match
        Some(one) -> run_cache_hit(one) match
            Some(built) ->
                if !explaining() then return started(built, args, None).map_err(said)
            None -> ()
        None -> ()

    val emitted = emit_llvm_text(path, named_target, level)?

    if !emitted.report.is_empty() then return Err(Reported(analysis_report(emitted.report)))

    // A slot in the cache where there is one, and a temporary of this run where there is not -- a
    // machine with no cache directory, or a reader who turned the cache off.
    val slot = key match
        Some(one) -> run_cache_reserve(one)
        None -> None

    slot match
        Some(kept) ->
            link_into_cache(path, emitted.text, t, cc, level, kept, false, emitted.links).map_err(said)?
            started(kept, args, None).map_err(said)
        None ->
            val dir = make_temp_dir("sysl-run-") match
                Err(_) -> return Err(Said(Refusal("no directory to build in")))
                Ok(made) -> made

            val staging = Some(dir)
            val exe = join_path(dir, "program")

            link_lowered_text(path, emitted.text, t, cc, level, exe, false, emitted.links) match
                Err(why) ->
                    discard_staging(staging)
                    return Err(Said(why))
                Ok(_) -> ()

            started(exe, args, staging).map_err(said)
end run_native_program

// A link whose product is a cache entry: made under a pending name beside the slot and published
// onto it (`sysl.fs.publish_file`), so another run that finds the slot finds a whole executable or none.
//
// **The linker still writes the file**, which is what the cache has always relied on for the
// executable bit -- a rename moves a name and leaves the mode the linker gave the file alone.
private link_into_cache(path: string, text: string, t: Target, cc: Option[string], level: string,
                        slot: string, standalone: bool,
                        links: Buf[string]) -> Result[unit, Refusal]
    val pending = pending_name(slot)

    link_lowered_text(path, text, t, cc, level, pending, standalone, links) match
        Err(why) ->
            remove_file(pending)
            return Err(why)
        Ok(_) -> ()

    publish_file(pending, slot) match
        Err(_) -> Err(Refusal(s"cannot put the program it built at $slot"))
        Ok(_) -> Ok(())
end link_into_cache

// The child, with whatever this run has to take away once it has ended.
//
// `run` rather than `capture`, and the difference is the whole of what this command is for: the child
// shares this program's streams, so its input is the reader's and what it writes is read as it is
// written.
private started(exe: string, args: Buf[string], staging: Option[string]) -> Result[int, Refusal]
    val state = run_child(exe, args.view(), "", []) match
        Err(_) ->
            discard_staging(staging)
            return Err(Refusal(s"$exe could not be run"))
        Ok(how) -> how

    discard_staging(staging)
    Ok(shell_status(state))
end started

private discard_staging(staging: Option[string])
    staging match
        Some(dir) -> remove_dir_all(dir).unwrap_or(())
        None -> ()

// `sysl build-lib <path> --std` -- the standard module built into an artifact for one machine.
//
// The machine is asked about before anything is read, because a library artifact is object code and
// a target with no toolchain has nothing an artifact could be.
// `sysl build-lib [--target <name>] <path>` -- one library held to being a library for one machine,
// and the answer is the root it checked.
//
// **It writes nothing anybody names.** A `.syslib` is this compiler's cache, so what the check
// assembles is discarded; what the command is run for is that the whole of it went through, which
// for a board package is the only check it gets.
//
// **It compiles the tree it is given and fetches nothing**, which is the one thing about the command
// a reader has to be told: a `dependencies` block every other command honours is refused here by
// name, and what the tree depends on is handed over as a source root of its own.
build_library_of(path: string, named_target: Option[string],
                 level: string = DefaultOptimization) -> Result[string, Failure]
    val t = target_for(path, named_target)?

    if !t.builds_with_clang() then return Err(said(Refusal(t.no_toolchain())))

    val root = if is_directory(path) then path else parent_of(path).unwrap_or(".")
    val manifest = manifest_at(root)?

    if !manifest.dependencies.is_empty()
        var labels = ""

        for i in 0..<manifest.dependencies.len()
            if i > 0 then labels = labels + ", "

            labels = labels + s"'${manifest.dependencies.at(i).label}'"

        return Err(said(Refusal("build-lib compiles the tree it is given and fetches nothing, so this " +
            s"package's dependencies reach it through --lib rather than through 'dependencies' — " +
            s"supply $labels as --lib <dir>")))
    end if

    // A source root's `dependencies` are refused on the same terms: a root is there to type-check
    // against, and what it depends on reaches `build-lib` as a root of its own.
    val libs = lib_roots()

    for i in 0..<libs.len()
        if !is_directory(libs.at(i)) then continue

        val theirs = manifest_of_package(libs.at(i)) match
            Err(why) -> return Err(said(Refusal(why)))
            Ok(got) -> got

        if theirs.dependencies.is_empty() then continue

        var labels = ""

        for j in 0..<theirs.dependencies.len()
            if j > 0 then labels = labels + ", "

            labels = labels + s"'${theirs.dependencies.at(j).label}'"

        return Err(said(Refusal(s"build-lib compiles the trees it is given and fetches nothing, so " +
            s"the source root '${libs.at(i)}' has its dependencies reach it through --lib rather " +
            s"than through 'dependencies' — supply $labels as --lib <dir> too")))

    // The two requirements a command line answers, asked before anything is compiled: a package
    // whose C cannot be reached has nothing to gain from the ten seconds of analysis in front of it.
    // A `--lib` root is there to type-check against, its C not compiled, so its own are not asked.
    val probed = supplied_or_refused(path, t, false)?
    val c = packaged_compilation_of(path, t)?
    val named = if manifest.name == "" then basename(root) else manifest.name

    build_library(root, t, c.units, c.own, s"'$named'", probed, level)?
    Ok(root)
end build_library_of

build_std_artifact_of(path: string, named_target: Option[string], out: Option[string],
                      level: string = DefaultOptimization) -> Result[string, Refusal]
    val t = target_for(path, named_target)?

    if !t.builds_with_clang() then return Err(Refusal(t.no_toolchain()))

    build_std_library(path, t, out, level) match
        Err(why) -> Err(Refusal(why))
        Ok(where) -> Ok(where)
end build_std_artifact_of

// The key for one command over one tree, or nothing where the machine it names cannot be settled --
// in which case the compilation this stands in front of is about to say so in its own words.
run_cache_key_for(command: string, path: string, named_target: Option[string], level: string,
                  cc: Option[string]) -> Option[string] = target_for(path, named_target) match
    Ok(t) -> run_cache_key_of(command, path, t, level, cc)
    Err(_) -> None

// What a shell hears when a child ends. A signal has no exit status of its own, and `128 + n` is what
// every shell reports for one -- so it is what a caller reading this number will already be
// expecting. A child stopped for outstaying its timeout is `124`, the status `timeout(1)` reports
// for the same thing, so a caller can tell "it took too long" from "something killed it".
shell_status(state: Status) -> int = state match
    Exited(code) -> code
    Signalled(signal) -> 128 + signal
    TimedOut -> 124

// The refusal `run` and `test` share, and the reason they share it: both execute what they build, and
// only this machine can execute anything.
private not_this_machine(t: Target, command: string) -> Result[unit, Refusal]
    if t.name == host_target().name then return Ok(())

    val does = if command == "run" then "executes" else "runs"

    Err(Refusal(s"'$command' $does what it builds, and '${t.name}' is not this machine — use " +
        s"'sysl build --target ${t.name}'"))
end not_this_machine

// What a test build comes to: the text to link, the tests the binary can be asked for by name, and
// the machine it was built for.
struct TestBuild
    emitted: Emitted
    tests: Buf[TTest]
    target: Target

    // Whether the tree being tested is itself the standard module, in which case there is no
    // artifact to link: the bodies the tests call are in the text above.
    standalone: bool
end TestBuild

// `sysl test [--target <name>] <path>` -- the same program lowered as a **test build**.
//
// **It keeps the `@test` functions every other build drops, and it lowers a different entry point**:
// the dispatcher that runs one test by name, which is what lets a runner pay one process per test and
// so learn the verdict of every one of them rather than of the first that traps.
//
// The analysis in front of it is the analysis every other build gets, and that is deliberate: a test
// is code somebody wrote and is held to the same rules.
test_build_of(path: string, named_target: Option[string],
              level: string = DefaultOptimization) -> Result[TestBuild, Failure]
    val t = test_target_of(path, named_target)?

    Ok(test_build_from(packaged_compilation_of(path, t)?, false, level)?)
end test_build_of

// The same for a tree that **is** the standard module (`sysl test <root> --std`), which is how the
// library's own tests are run: there is no library beside it and no artifact to link, because the
// bodies the tests call are the ones being compiled.
std_test_build_of(path: string, named_target: Option[string]) -> Result[TestBuild, Failure]
    val t = test_target_of(path, named_target)?

    Ok(test_build_from(std_compilation_of(path, t)?, true, DefaultOptimization)?)
end std_test_build_of

// What both ask of the machine before anything is read: it has to be this one, because a test run
// executes what it builds, and it has to have a toolchain.
private test_target_of(path: string, named_target: Option[string]) -> Result[Target, Refusal]
    val t = target_for(path, named_target)?

    heap_refusal(path, t)?
    not_this_machine(t, "test")?

    if !t.builds_with_clang() then return Err(Refusal(t.no_toolchain()))

    Ok(t)
end test_target_of

private test_build_from(program: Compilation, standalone: bool,
                        level: string) -> Result[TestBuild, Refusal]
    val t = program.target

    // **Every body the library declares is typed when the library is what is being built**, not only
    // the ones a test happens to reach. It is the same reading `library_build` asks for, and the
    // reason is the same: a tree that declares `sysl` is a compilation *producing* those modules
    // rather than one being handed them.
    val done = if standalone then analyze_produced(program.units, t, file_names(program.units))
    else analyze_bodies(program.units, t)

    val whole = program_of(done, done.main_module)
    val promotions = post_analysis_checks_of_tests(done.an, whole, program.own)
    val kept = tests_only(whole, program.own)

    var precompiled: Buf[string] = buf()

    std_linked(t, level, standalone) match
        Err(why) -> return Err(Refusal(why))
        Ok(Some(found)) -> precompiled = found.precompiled
        Ok(None) -> ()

    val lowered = codegen_with_gaps(kept with { precompiled = precompiled }, t, promotions)
    val emitted = Emitted(ir_print_module(lowered.0), errors_of(done.an.diagnostics()), lowered.1,
                          link_required(program.units))

    Ok(TestBuild(emitted, kept.tests, t, standalone))
end test_build_from

// A test binary, linked exactly as a program is, in a directory of its own.
//
// **It is a temporary of this run and the runner outlives the link**, since a process is started per
// test: what is handed back is the path, and `discard_test_binary` is what takes the directory away
// once the last test has had its verdict.
build_test_binary(path: string, build: TestBuild, cc: Option[string],
                  level: string) -> Result[string, Refusal]
    val staging = make_temp_dir("sysl-test-") match
        Err(_) -> return Err(Refusal("no directory to build the tests in"))
        Ok(dir) -> dir

    val exe = join_path(staging, "tests")

    link_lowered_text(path, build.emitted.text, build.target, cc, level, exe, build.standalone,
                      build.emitted.links) match
        Err(why) ->
            remove_dir_all(staging).unwrap_or(())
            return Err(why)
        Ok(_) -> Ok(exe)
end build_test_binary

// The same, into the cache where this run has a slot in it -- with `true` for a binary that is a
// cache entry and outlives the run, and `false` for a temporary the caller has to take away.
//
// **The link goes to a pending name beside the slot and is renamed onto it** (`link_into_cache`),
// never straight into the slot: another suite may be starting the binary already there.
build_test_binary_cached(path: string, build: TestBuild, cc: Option[string], level: string,
                         key: Option[string]) -> Result[(string, bool), Refusal]
    val slot = key match
        Some(one) -> run_cache_reserve(one)
        None -> None

    slot match
        Some(exe) ->
            link_into_cache(path, build.emitted.text, build.target, cc, level, exe,
                            build.standalone, build.emitted.links)?
            Ok((exe, true))
        None ->
            val made = build_test_binary(path, build, cc, level)?

            Ok((made, false))
end build_test_binary_cached

// The directory a test binary was built in, taken away. The binary is the only thing in it, so the
// directory is what there is to remove.
discard_test_binary(exe: string)
    parent_of(exe) match
        Some(dir) -> remove_dir_all(dir).unwrap_or(())
        None -> remove_file(exe)

// Where a build puts what it made, when nothing said: the program is the product, so it is named for
// the **package** and written inside the root that names it, and a single file for the file itself.
//
// **The root is the one place that names the program without depending on where the caller happened
// to be standing**, which is why `sysl build .` in a project called `sqlite-repl` writes
// `./sqlite-repl` rather than a binary named for a dot. The directory's own last segment is the
// fallback where the manifest named nothing, since a directory with no manifest still has a name.
default_executable(path: string) -> string
    if is_directory(path)
        val named = manifest_at(path) match
            Ok(m) -> m.name
            Err(_) -> ""

        val name = if named != "" then named else directory_name(path)

        return s"$path/$name"
    end if

    val name = basename(path)

    if !is_sysl_file(name) then return s"./$name"

    var at = name.bytes.len

    for i in 0..<name.bytes.len
        if name.bytes[i] == u8('.') then at = i

    s"./${name[0..<at]}"
end default_executable

// The last segment of a directory's path, with `.` and a trailing separator resolved against where
// the caller is standing -- so that a project built as `.` is named for the directory it is in
// rather than for the dot that named it.
private directory_name(path: string) -> string
    val here = if path == "." || path == "" then current_dir().unwrap_or(".") else path
    val name = basename(here)

    if name == "" || name == "." || name == ".." then "a.out" else name
end directory_name

// Every `.c` the program's own tree carries, compiled for this machine.
//
// **The library's is not here, because the artifact carries it already compiled.** Each of a
// library's C files is a member of its `.syslib`, put there when the artifact was built, so the
// linker pulls one in the way it pulls anything else in: because something left its symbol
// undefined.
private native_objects(clang: string, path: string, exe: string, t: Target,
                       level: string, probed: PkgAnswer) -> Result[Buf[string], Refusal]
    var trees: Buf[string] = buf()

    if is_directory(path)
        trees.push(path)

        // The project's own C that nothing compiles is named here, where the rest is gathered.
        val strays = stray_c_warnings(path)

        for i in 0..<strays.len()
            eprints(s"sysl: warning: ${strays.at(i)}\n")
    end if

    // And every package this project takes and every source root it was handed, which carry their
    // own `.c` on the same terms the program does -- a binding is a sysl surface over C, so the C is
    // part of what was fetched. A manifest that will not read is not a refusal here: whatever needed
    // it has already said so, and a build that got this far read one.
    val root = if is_directory(path) then path else parent_of(path).unwrap_or(".")

    manifest_at(root) match
        Ok(m) ->
            val roots = handed_trees(root, m)

            for i in 0..<roots.len()
                trees.push(roots.at(i).dir)
        Err(_) -> ()

    // And the standard module's, where it is compiled from source rather than linked from an
    // artifact, whose C would otherwise have come with it. A tree that **is** the library already
    // stands first in the list.
    if std_from_source()
        std_root() match
            Ok(library) -> if library != path then trees.push(library)
            Err(_) -> ()

    var objects: Buf[string] = buf()
    var n = 0

    for i in 0..<trees.len()
        val found = c_sources(trees.at(i), Some(t.os)) match
            Err(e) -> return Err(Refusal(e.message))
            Ok(cs) -> cs

        val declared: &Manifest = manifest_at(trees.at(i)).unwrap_or(empty_manifest())

        carried_defines(declared, found) match
            Err(why) ->
                discard_objects(objects)
                return Err(Refusal(defines_refusal(root, trees.at(i), why)))
            Ok(_) -> ()

        for j in 0..<found.len()
            val obj = s"$exe.$n.o"

            n += 1

            compile_c(clang, found.at(j), obj, t, level, probed,
                      defines_for(declared, found.at(j))) match
                Err(why) ->
                    discard_objects(objects)
                    return Err(Refusal(why))
                Ok(_) -> objects.push(obj)

    Ok(objects)
end native_objects

// The installed libraries this build's packages named, the project's own first and then each
// dependency's, in the order a refusal should mention them.
//
// **A dependency's need is the consumer's problem**, which is why it is collected here rather than
// left to whoever wrote the package: the archive goes on *this* link line, so a machine without it
// stops *this* build. Sorted within a manifest by the `.pc` name so that which library a build
// complains about first does not depend on the order a HOCON block happened to be written in.
//
// **A `--lib` source root's need is collected as a coordinate's is, named as the root was given** --
// its C goes on this link line exactly the same, so a binding handed over by the flag would otherwise
// link without its library. `roots` is false for `build-lib`, where a root is there to type-check
// against and none of its C is compiled.
private pkg_config_needs(path: string, roots: bool) -> Result[Buf[LibNeed], Refusal]
    var out: Buf[LibNeed] = buf()

    val root = if is_directory(path) then path else parent_of(path).unwrap_or(".")
    val mine = manifest_at(root)?

    add_needs(&out, "this project", mine)

    val trees = handed_trees(root, mine)

    for i in 0..<trees.len()
        if trees.at(i).from_lib && !roots then continue

        manifest_at(trees.at(i).dir) match
            Err(_) -> ()
            Ok(m) -> add_needs(&out, trees.at(i).who, m)

    Ok(out)
end pkg_config_needs

private add_needs(out: *Buf[LibNeed], who: string, m: Manifest)
    for i in 0..<m.pkg_config.len()
        val row = m.pkg_config.at(i)

        out.push(LibNeed(who, row.0, row.1))

// One package's declared need of headers it does not carry: who declared it, the name a consumer
// answers under, the prose quoted back at them, and the variable the path conventionally lives in.
struct HeaderNeed
    who: string
    name: string
    why: string
    env: string
end HeaderNeed

// Every header requirement this compilation is answerable for -- this project's, then each package
// it reaches. **A dependency's need is the consumer's problem** for the same reason a library's is:
// the header is included by C compiled into *this* build, so a machine without it stops this build.
// A `--lib` source root's requirement is asked the same way, named as the root was given, except
// where `roots` is false: `build-lib` compiles none of a root's C, so it has no header to ask for.
header_needs(path: string, roots: bool = true) -> Result[Buf[HeaderNeed], Refusal]
    var out: Buf[HeaderNeed] = buf()

    val root = if is_directory(path) then path else parent_of(path).unwrap_or(".")
    val mine = manifest_at(root)?

    add_header_needs(&out, "this project", mine)

    val trees = handed_trees(root, mine)

    for i in 0..<trees.len()
        if trees.at(i).from_lib && !roots then continue

        manifest_at(trees.at(i).dir) match
            Err(_) -> ()
            Ok(m) -> add_header_needs(&out, trees.at(i).who, m)

    Ok(out)
end header_needs

private add_header_needs(out: *Buf[HeaderNeed], who: string, m: Manifest)
    for i in 0..<m.headers.len()
        val row = m.headers.at(i)

        out.push(HeaderNeed(who, row.0, row.1, row.2))

// The header requirements answered by an environment variable the package named, taken as the
// include paths a `--include-path` would have added.
//
// **This is not reading the consumer's shell.** A variable is consulted only where nothing on the
// command line named that requirement, and where it is unset the build stops with the refusal it
// stopped with before -- so the environment can turn a failure into a success and can never turn one
// success into a different one. An explicit flag wins, always.
//
// **An empty variable is unset.** `PICO_SDK_PATH=` in a shell profile is somebody clearing it, not
// somebody naming the root directory; treating it as a path would hand clang an empty `-I` and fail
// somewhere with no connection to the variable.
answer_headers_from_env(needs: Buf[HeaderNeed])
    for i in 0..<needs.len()
        val need = needs.at(i)

        if need.env != "" && !supplied_include(need.name)
            env_var(need.env) match
                None -> ()
                Some(dir) -> if dir.trim() != "" then add_include_path(s"${need.name}=${dir.trim()}")

// The header requirement nothing on this command line answered, as the one line a build stops on.
//
// **Why the message is this long.** Every other requirement in a manifest is answered by something
// the reader already has: a capability is provided by the target or it is not, and there is nothing
// to go and do. This one is answered by a path on a machine the package has never seen, so the
// reader is being asked to find something -- and a refusal that only names what is missing leaves
// them to work out *what* it is, *where* it lives and *how* to say so. All three are known here.
//
// **One at a time, in the order they were declared.** A consumer satisfying them one flag at a time
// is the same walk either way, and a list of four would be four things to look up before anything
// can be tried.
unmet_headers(needs: Buf[HeaderNeed]) -> Option[string]
    for i in 0..<needs.len()
        val need = needs.at(i)

        if supplied_include(need.name) then continue

        // **Where the package named a variable, that is the thing to say first.** Setting it is
        // done once and answers every build in that tree; the flag is what somebody types every
        // time. A reader who has arrived here has neither, so they are owed both and in that order.
        val how = if need.env == ""
            s"Say where they are with '--include-path ${need.name}=<dir>'"
        else
            s"Set ${need.env}, which is where this package's own ecosystem looks for it, or say " +
            s"where they are with '--include-path ${need.name}=<dir>'"

        return Some(s"${need.who} needs the '${need.name}' headers and nothing supplied them — " +
            s"${need.why}. $how")

    None
end unmet_headers

// The two requirements a command line answers, checked together and in the order a reader can act
// on: the headers a package's C includes, then the installed libraries it links. `roots` says whether
// the `--lib` source roots' own requirements are this command's to answer, which they are wherever
// their C is compiled -- everywhere but `build-lib`.
private supplied_or_refused(path: string, t: Target, roots: bool = true) -> Result[PkgAnswer, Refusal]
    val headers = header_needs(path, roots)?

    answer_headers_from_env(headers)

    unmet_headers(headers) match
        Some(why) -> return Err(Refusal(why))
        None -> ()

    probe_libs(pkg_config_needs(path, roots)?, t) match
        Err(why) -> Err(Refusal(why))
        Ok(found) -> Ok(found)
end supplied_or_refused

private discard_objects(objects: Buf[string])
    for i in 0..<objects.len()
        remove_file(objects.at(i))
