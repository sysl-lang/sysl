module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.container.{Map, map, Set, set}

// **What a program can arrive at**, and the declarations that go when nothing can.
//
// Pruning is the last thing that happens to a typed tree and the only thing between the checks and
// the lowering: a declaration nothing can reach is still one the program declared, and checking it
// is what makes a mistake in it a mistake at all.
//
// **The roots are not only what the program runs.** Four kinds of function are reached from
// somewhere no walk can see -- an interrupt handler, entered by the processor; an `@export`, called
// by something outside; a `@section` definition, found by a linker script; and a destructor, called
// by the release hook the emitter builds. Each is a root, and each is a root only where the program
// reaches its module: a handed source root is compiled whole rather than by what the program
// imports, so an unconditional root would put an unimported module's contribution into the output.

// What one walk found: every function it can arrive at and every `val` it reads.
//
// Each list is in the order its names first arrived, and each has a set beside it that answers
// membership. **The set is what keeps a walk linear**: a program of `n` functions asks "have I seen
// this one" once per name every body holds, and a scan of the list for each of those is the whole
// walk again per name.
struct Live
    calls: Buf[string]
    vals: Buf[string]
    erased: Buf[string]
    call_set: Set[string]
    val_set: Set[string]
    erased_set: Set[string]
end Live

// The program with everything nothing can reach dropped.
prune(p: TProgram, own: Buf[string]) -> TProgram
    val live = walk_program(p, own)

    var externs: Buf[TExtern] = buf()

    for i in 0..<p.externs.len()
        if live.call_set.has(p.externs.at(i).name) then externs.push(p.externs.at(i))

    var funcs: Buf[TFunc] = buf()

    for i in 0..<p.funcs.len()
        if live.call_set.has(p.funcs.at(i).name) then funcs.push(p.funcs.at(i))

    with_declarations(p, externs, funcs)
end prune

// The whole walk, including the one root kind that cannot be decided before it has run.
//
// **An `@export` whose symbol answers an `extern` the program actually calls is a root.** It is the
// fifth kind, and it is the only one that is not a property of the function alone: what a
// capability-free module declares and defines nowhere is supplied by whoever links the program, and
// the consumer never names the supplier -- so asking whether the program reached the supplier's
// module answers no for precisely the case the seam exists to serve.
private walk_program(p: TProgram, own: Buf[string]) -> &Live
    val entries = entry_points(p, own)
    val index = func_index(p)

    var exports: Buf[TFunc] = buf()

    for i in 0..<p.funcs.len()
        if p.funcs.at(i).exported.is_some() then exports.push(p.funcs.at(i))

    var extra: Buf[TFunc] = buf()
    var live = no_reached()
    var more = true

    while more
        live = reached_from(p, index, roots_of(p, entries, extra))

        for entrie in entries
            add_call(live, entrie.name)

        for item in extra
            add_call(live, item.name)

        more = false

        for i in 0..<p.externs.len()
            val x = p.externs.at(i)

            if live.call_set.has(x.name)
                for f in exports
                    if f.exported == Some(x.symbol) && !holds_func(extra, f.name)
                        extra.push(f)
                        more = true

    live
end walk_program

private holds_func(fs: Buf[TFunc], name: string) -> bool
    for item in fs
        if item.name == name then return true

    false
end holds_func

// The trees a walk starts from: the program's own statements, the storage it lays down, the tables
// it built, the entry point, and every function nothing in the program names.
private roots_of(p: TProgram, entries: Buf[TFunc], extra: Buf[TFunc]) -> &Live
    val out = no_reached()

    walk_stmts(p.main, expr_walk(false, e -> take_node(out, e)))

    for i in 0..<p.vals.len()
        p.vals.at(i).init match
            Some(x) -> walk_texpr(x, expr_walk(false, e -> take_node(out, e)))
            None -> ()

    for i in 0..<p.vtables.len()
        val t = p.vtables.at(i)

        for item in t.slots
            add_call(out, item.target)

    p.entry match
        Some(en) ->
            add_call(out, en.func)

            en.args_fn match
                Some(n) -> add_call(out, n)
                None -> ()

            en.result_fn match
                Some(n) -> add_call(out, n)
                None -> ()
        None -> ()

    for entrie in entries
        add_call(out, entrie.name)

    for item in extra
        add_call(out, item.name)

    out
end roots_of

// Everything a set of roots can arrive at, following each call into the body it lands in.
//
// A plain reachability walk rather than a fixpoint: what is being accumulated is a set, and a
// function already visited adds nothing a second time. A **dynamic** call is answered with every
// table for the trait, since a table is a constant the program can read a function out of and a
// definition it points at has to survive.
private reached_from(p: TProgram, index: FuncIndex, root: &Live) -> &Live
    val out = no_reached()
    val none = p.funcs.len()

    var queue: Buf[string] = buf()

    take_all(out, root, &queue)

    while !queue.is_empty()
        val name = queue.at(queue.len() - 1)

        queue.truncate(queue.len() - 1)

        var at = index.first.get_or(name, none)

        while at < none
            take_all(out, body_refs(p, p.funcs.at(at)), &queue)

            at = index.next.at(at)

    out
end reached_from

// The module storage one function reaches, directly or through anything it calls -- the walk an
// export is held to, since the storage may be several calls down from the function that named it.
vals_reached_from(p: TProgram, f: TFunc) -> Buf[string]
    val root = no_reached()

    add_call(root, f.name)
    reached_from(p, func_index(p), root).vals
end vals_reached_from

// The module storage an initializer reads, directly or through anything it calls -- which is what
// settles the order computed storage is filled in. It is asked while the analysis is still running,
// so there is no program yet, only the bodies typed so far and the tables built for them.
vals_read_by(init: TExpr, funcs: Buf[TFunc], vtables: Buf[TVtable]) -> Buf[string]
    val p = TProgram(buf(), buf(), vtables, buf(), buf(), funcs, buf(), None, buf(), true, false, buf(),
                     buf(), "", buf(), buf(), buf(), buf(), buf(), buf(), buf(), None, buf())
    val root = no_reached()

    walk_texpr(init, expr_walk(false, e -> take_node_of(p, root, e)))
    reached_from(p, func_index(p), root).vals
end vals_read_by

// Where each function of a program is, by name: the first index holding a name, and from each index
// the next one holding the same name, so a name held twice is visited at both places and in the
// order the program lists them.
private struct FuncIndex
    first: Map[string, usize]
    next: Buf[usize]

private func_index(p: TProgram) -> FuncIndex
    val n = p.funcs.len()

    var first: Map[string, usize] = map()
    var next: Buf[usize] = buf()

    for i in 0..<n
        next.push(n)

    var i = n

    while i > 0
        i -= 1

        val name = p.funcs.at(i).name

        first.get(name) match
            Some(j) -> next.set(i, j)
            None -> ()

        first.put(name, i)

    FuncIndex(first, next)
end func_index

private take_all(out: &Live, from: &Live, queue: *Buf[string])
    for i in 0..<from.vals.len()
        add_val(out, from.vals.at(i))

    for item in from.erased
        add_erased(out, item)

    for item in from.calls
        if add_call(out, item) then queue.push(item)
end take_all

// Every function of a compilation that reads module storage, directly or through anything it calls.
//
// **It is the whole set at once rather than a question asked once per function**, and that is not a
// convenience. The question is asked of every function a library declares, and each answer on its
// own is a walk of the call graph from that function -- taken one at a time, the graph is walked
// once per node in it. What this costs instead is one summary per body and then a sweep back along
// the calls until nothing more changes, which is a handful of passes however deep the library is.
//
// The storage is what makes the question worth asking: a module-level `val` is filled by the entry
// point, and a library has none, so a function that reads one cannot be compiled ahead of time and
// is left to the program that will fill it.
storage_reaching(p: TProgram) -> Buf[string]
    var index: Map[string, usize] = map()

    for i in 0..<p.funcs.len()
        index.put(p.funcs.at(i).name, i)

    var reaches: Buf[bool] = buf()
    var edges: Buf[(usize, usize)] = buf()

    for i in 0..<p.funcs.len()
        reaches.push(false)

    for i in 0..<p.funcs.len()
        val refs = body_refs(p, p.funcs.at(i))

        if !refs.vals.is_empty() then reaches.set(i, true)

        for item in refs.calls
            index.get(item) match
                None -> ()
                Some(j) -> edges.push((i, j))

    var moved = true

    while moved
        moved = false

        for edge in edges
            if reaches.at(edge.1) && !reaches.at(edge.0)
                reaches.set(edge.0, true)
                moved = true

    var out: Buf[string] = buf()

    for i in 0..<p.funcs.len()
        if reaches.at(i) then out.push(p.funcs.at(i).name)

    out
end storage_reaching

// Every function a library artifact can neither define nor declare, grown from the ones its
// lowering could not finish.
//
// A gapped body is not emitted, and where its symbol is **`internal`** it cannot be declared either:
// internal linkage is the promise that no other object defines that name, so there is nothing for a
// declaration of one to resolve to. Every caller of such a body is therefore uncompilable here as
// well, and the set has to be closed under that -- a caller that is itself internal carries the
// same problem to *its* callers, and one that is not is simply declared and left to the program.
//
// The calls are summarized once and the closure is a sweep back along them, for the reason
// `storage_reaching` gives.
gap_closure(p: TProgram, gapped: Buf[string]) -> Buf[string]
    var index: Map[string, usize] = map()

    for i in 0..<p.funcs.len()
        index.put(p.funcs.at(i).name, i)

    var absent: Buf[bool] = buf()
    var deferred: Buf[bool] = buf()
    var edges: Buf[(usize, usize)] = buf()

    for i in 0..<p.funcs.len()
        val gone = holds_string(gapped, p.funcs.at(i).name)

        deferred.push(gone)
        absent.push(gone && p.funcs.at(i).internal)

        val refs = body_refs(p, p.funcs.at(i))

        for item in refs.calls
            index.get(item) match
                None -> ()
                Some(j) -> edges.push((i, j))

    var moved = true

    while moved
        moved = false

        for edge in edges
            if absent.at(edge.1) && !deferred.at(edge.0)
                deferred.set(edge.0, true)
                moved = true

                if p.funcs.at(edge.0).internal then absent.set(edge.0, true)

    var out: Buf[string] = buf()

    for i in 0..<p.funcs.len()
        if deferred.at(i) then out.push(p.funcs.at(i).name)

    out
end gap_closure

// What one body names, without following any of it.
private body_refs(p: TProgram, f: TFunc) -> &Live
    val out = no_reached()

    walk_block_stmts(f.body, TWalk(true, e -> take_node_of(p, out, e), w -> take_write(out, w),
                                   s -> ()))

    for item in f.requires
        walk_texpr(item.cond, expr_walk(true, e -> take_node_of(p, out, e)))

    for item in f.ensures
        walk_texpr(item.cond, expr_walk(true, e -> take_node_of(p, out, e)))

    for item in f.olds
        walk_texpr(item, expr_walk(true, e -> take_node_of(p, out, e)))

    out
end body_refs

private take_node(out: &Live, e: TExpr) = node_names(out, e, None)

private take_node_of(p: TProgram, out: &Live, e: TExpr) = node_names(out, e, Some(p.vtables))

// The names one node holds, as a call, as storage, or as a table it erased a value into.
//
// The names a node carries as **data** rather than as a child are read out here -- a dispatched
// operator, an invariant a write has to re-establish, the conversion a `?` widens through, a
// constrained subtype's predicate -- because nothing about the shape of the tree tells those from
// any other string.
private node_names(out: &Live, e: TExpr, tables: Option[Buf[TVtable]])
    *e.kind match
        TGlobal(symbol, _, _) -> add_val(out, symbol)
        TCall(name, _, _, _) -> add_call(out, name)
        TFuncAddr(name, _, _) -> add_call(out, name)
        TTry(_, _, _, _, _, _, convert) ->
            if convert.is_some() then add_call(out, convert.unwrap())
        TStructInvCheck(_, _, inv_fn) -> add_call(out, inv_fn)
        TRecheck(_, _, _, inv_fn) -> add_call(out, inv_fn)
        TConstrainedCheck(_, target) -> take_predicate(out, target)
        TUpdate(_, _, _, _, dispatch, check) ->
            take_dispatch(out, dispatch)

            if check.is_some() then take_predicate(out, check.unwrap())
        TIncDec(_, _, _, _, check) -> if check.is_some() then take_predicate(out, check.unwrap())
        TCompare(_, cmps) ->
            for cmp in cmps
                take_dispatch(out, cmp.dispatch)
        TErase(_, vtable, _) -> add_erased(out, vtable)
        TVCall(receiver, slot, _, _, _) -> take_dynamic(out, tables, texpr_type(receiver), slot)
        TRender(value, method, _, slot) ->
            if slot.is_some() then take_dynamic(out, tables, texpr_type(value), slot.unwrap())
            else add_call(out, method)
        _ -> ()
end node_names

private take_write(out: &Live, w: TWrite)
    take_dispatch(out, w.dispatch)

    for item in w.check
        add_call(out, item.inv_fn)

    if w.constraint.is_some() then take_predicate(out, w.constraint.unwrap())
end take_write

private take_dispatch(out: &Live, d: Option[TDispatch])
    if d.is_some() then add_call(out, d.unwrap().name)

private take_predicate(out: &Live, t: Type) = t match
    Constrained(d) ->
        if d.pred_fn.is_some() then add_call(out, d.pred_fn.unwrap())
    _ -> ()

// A call at a slot is answered with the functions every implementation of the trait put there.
private take_dynamic(out: &Live, tables: Option[Buf[TVtable]], recv: Type, slot: int)
    if tables.is_none() then return

    val name = recv match
        Ptr(inner) -> trait_name_of(*inner)
        Ref(inner, _) -> trait_name_of(*inner)
        _ -> None

    if name.is_none() then return

    val ts = tables.unwrap()

    for t in ts
        if t.trait_name == name.unwrap() && usize(slot) < t.slots.len()
            add_call(out, t.slots.at(usize(slot)).target)
end take_dynamic

private trait_name_of(t: Type) -> Option[string] = t match
    Trait(n, _, _) -> Some(n)
    _ -> None

private no_reached() -> &Live = Live(buf(), buf(), buf(), set(), set(), set())

private add_call(out: &Live, name: string) -> bool = add_named(&out.calls, &out.call_set, name)

private add_val(out: &Live, name: string) -> bool = add_named(&out.vals, &out.val_set, name)

private add_erased(out: &Live, name: string) -> bool = add_named(&out.erased, &out.erased_set, name)

// Adds a name to a list and the set beside it, answering whether it was new.
private add_named(xs: *Buf[string], seen: *Set[string], name: string) -> bool
    if name == "" || !seen.add(name) then return false

    xs.push(name)
    true
end add_named

// -- the roots nothing in the program names -----------------------------------------------------------

// The functions that are roots because **nothing in the program names them**, whatever the walk
// starts from.
//
// **A root the program did not write counts only where the program reaches its module**, and that is
// the one qualification on any of the four -- the same qualification on each of them, since a rule
// told per kind turns into a rule about which attributes a function carries together.
entry_points(p: TProgram, own: Buf[string]) -> Buf[TFunc]
    val reached = reached_modules(p, own)

    var destructors: Set[string] = set()

    for item in p.destructors
        destructors.add(item.1)

    var out: Buf[TFunc] = buf()

    for i in 0..<p.funcs.len()
        val f = p.funcs.at(i)
        val kind = f.conv.is_some() || f.exported.is_some() || f.section.is_some() ||
                   destructors.has(f.name)

        if kind && contributes(reached, f.name) then out.push(f)

    out
end entry_points

// The exports this compilation is answerable for: the ones it will emit, which is what every pass
// that reads the emitted program's symbol table should read.
exported_funcs(p: TProgram, own: Buf[string]) -> Buf[TFunc]
    val reached = reached_modules(p, own)
    val supplies = walk_program(p, own)

    var out: Buf[TFunc] = buf()

    for i in 0..<p.funcs.len()
        val f = p.funcs.at(i)

        if f.exported.is_some() && (contributes(reached, f.name) ||
                                    supplies.call_set.has(f.name))
            out.push(f)

    out
end exported_funcs

// Whether the module a function is in contributes roots to this compilation at all.
private contributes(reached: Option[Set[string]], name: string) -> bool
    if reached.is_none() then return true

    reached.unwrap().has(module_of(name))
end contributes

// Which modules a root in counts, or nothing where every module's does. The referring is asked of
// the graph name resolution built, which records an `import` as readily as a call.
private reached_modules(p: TProgram, own: Buf[string]) -> Option[Set[string]]
    if own.is_empty() then return None

    var order: Buf[string] = buf()
    var reached: Set[string] = set()

    for item in own
        add_module(&order, &reached, item)

    // **A supplied file with no module header is in the root module and is therefore treated as the
    // program's own**, since the root module is the one name two trees can share -- the answer that
    // keeps a symbol is the safe one to be wrong with.
    add_module(&order, &reached, ModuleRoot)

    // **A module whose top-of-file `asm` is laid down is reached**, whether or not anything imports
    // it. The block is never pruned, and its instructions call by symbol -- a `_start` doing
    // `bl finish` names an `@export` of its own module that no import line leads to -- so a module
    // contributing instructions to the image contributes its roots too, or the image calls what it
    // does not define.
    for item in p.module_asm
        add_module(&order, &reached, item.home)

    var i: usize = 0

    while i < order.len()
        val from = order.at(i)

        i += 1

        for module_dep in p.module_deps
            if module_dep.0 == from
                val to = module_dep.1

                for k in 0..<to.len()
                    add_module(&order, &reached, to.at(k))

    Some(reached)
end reached_modules

// A module name added to a set, where **the root module's name is the empty string and is a name
// like any other**. `add_named` refuses one, which is right for a call graph -- nothing is called
// by no name -- and wrong here: refused, the root module is not among the ones a compilation counts
// roots in, so a program's own destructor, `@export`, `@section` or interrupt handler written with
// no module header is pruned before it can be emitted -- and a destructor pruned is a symbol the
// release hook calls and nothing defines.
private add_module(order: *Buf[string], seen: *Set[string], name: string)
    if seen.add(name) then order.push(name)

// -- one program with something taken out of it -------------------------------------------------------

// The same program with a different set of declarations, which is what pruning answers with.
private with_declarations(p: TProgram, externs: Buf[TExtern], funcs: Buf[TFunc]) -> TProgram =
    TProgram(p.structs, p.enums, p.vtables, externs, p.vals, funcs, p.main, p.entry, p.precompiled,
             p.entry_point, p.c_artifact, p.no_alloc_modules, p.no_alloc_test_modules,
             p.main_module, p.tests, p.hooks, p.extern_vars, p.test_only, p.destructors,
             p.warnings, p.module_deps, p.main_src, p.module_asm)

// **The same program lowered AS a test build: the tests kept, and the program's own entry point put
// aside.**
//
// A program's top-level statements and its `main` are what it does when it is run, and running it is
// not what a test build does -- so they go, and what stands in their place is the dispatcher the
// emitter lays down instead.
//
// **The tests are the roots**, in place of the `main` that is no longer there, so that everything one
// of them calls survives and nothing else does. The hooks are roots beside them and for the same
// reason: the dispatcher lays down an arm that calls each by name, so a hook nothing reaches from a
// test -- which is every one of them, since nothing calls a hook -- would be pruned out from under
// its own arm.
//
// **The roots nothing in the program names are roots here too.** A handler, an export and a
// destructor are each reached from somewhere no walk can see, so replacing the roots does not make
// them reachable from the tests instead: it makes them reachable from nothing, and a destructor
// dropped that way leaves the release hook calling a function the tree no longer holds.
//
// **Only the program's own tests are kept** (`strip_handed`): a dependency's suite is not the
// consumer's to run, and a failing test in it would otherwise fail the consumer's `sysl test`. With
// the dependency's tests gone every root is in an `own` module, which is why `entry_points` is asked
// about `own` and nothing wider.
tests_only(p: TProgram, own: Buf[string]) -> TProgram
    val kept = without_program_entry(strip_handed(p, own))
    val entries = entry_points(kept, own)
    val root = roots_of(kept, entries, buf())

    for item in kept.tests
        add_call(root, item.func)

    for item in kept.hooks
        add_call(root, item.func)

    val live = reached_from(kept, func_index(kept), root)

    for entrie in entries
        add_call(live, entrie.name)

    var externs: Buf[TExtern] = buf()

    for i in 0..<kept.externs.len()
        if live.call_set.has(kept.externs.at(i).name) then externs.push(kept.externs.at(i))

    var funcs: Buf[TFunc] = buf()

    for i in 0..<kept.funcs.len()
        if live.call_set.has(kept.funcs.at(i).name) then funcs.push(kept.funcs.at(i))

    with_declarations(kept, externs, funcs)
end tests_only

// The same program with nothing left of what it does when it is run. The module-level `val`s stay:
// they are storage the program reads rather than work it performs, and a test that reads one would
// otherwise find it empty.
private without_program_entry(p: TProgram) -> TProgram =
    TProgram(p.structs, p.enums, p.vtables, p.externs, p.vals, p.funcs, buf(), None, p.precompiled,
             p.entry_point, p.c_artifact, p.no_alloc_modules, p.no_alloc_test_modules,
             p.main_module, p.tests, p.hooks, p.extern_vars, p.test_only, p.destructors,
             p.warnings, p.module_deps, p.main_src, p.module_asm)

// **The scaffolding a module's tests are written against, taken out of the build that runs none.**
//
// A hook goes with the tests it brackets, and is read from the program rather than from the tests
// because a module may declare one and no tests -- a hook left behind is a function nothing calls in
// a build that runs nothing. Everything declared in a file that said `@tests` goes with them.
strip_tests(p: TProgram) -> TProgram
    var gone: Set[string] = set()

    for item in p.tests
        gone.add(item.func)

    for item in p.hooks
        gone.add(item.func)

    for item in p.test_only
        gone.add(item)

    // An `asm` block a `@tests` file wrote is scaffolding too. It names nothing, so it is told by
    // where it was written rather than by a name in `gone`.
    var kept_asm: Buf[TModuleAsm] = buf()

    for item in p.module_asm
        if !item.scaffolding then kept_asm.push(item)

    val program = if kept_asm.len() == p.module_asm.len() then p
    else p with { module_asm = kept_asm }

    if gone.is_empty() then return program

    without_scaffolding(program, gone)
end strip_tests

// **The same program with a DEPENDENCY's tests taken out and the project's own kept** -- what a test
// build runs, since a package's suite is run by `sysl test` over the package and no build of the
// consumer keeps it. It is also what `emit-typed` reads: that stops before a build strips anything,
// which is right for the program's own `@test` functions -- they are part of what the module
// declares -- and wrong for a dependency's, which no build of this program ever keeps.
//
// **A test and its hook are handed by the module they are declared in; the rest of the scaffolding is
// not, and is judged by what the kept tests reach.** `test_only` also holds what a test *body* made --
// a closure, filed as `$closureN` in the root module, and an instantiation, filed under the generic's
// own module, which may well be a dependency's. Neither name says whose test made it, so dropping by
// module would take the closure out from under the project's own test that wrote it. What the kept
// tests and hooks reach stays; everything else in the scaffolding goes with the handed tests.
//
// **No `own` at all means every module is the program's**, as it does for `entry_points`: a caller
// that names no module is not saying that nothing is its own.
strip_handed(p: TProgram, own: Buf[string]) -> TProgram
    if own.is_empty() then return p

    var gone: Set[string] = set()
    var kept: Buf[string] = buf()

    for item in p.tests
        sort_by_owner(item.func, own, &gone, &kept)

    for item in p.hooks
        sort_by_owner(item.func, own, &gone, &kept)

    if gone.is_empty() then return p

    val reached = reached_by(p, kept)

    for name in p.test_only
        if !reached.call_set.has(name) && !reached.val_set.has(name) then gone.add(name)

    without_scaffolding(p, gone)
end strip_handed

private sort_by_owner(func: string, own: Buf[string], gone: *Set[string], kept: *Buf[string])
    val home = module_of(func)

    if home == ModuleRoot || holds_string(own, home) then kept.push(func)
    else gone.add(func)

// Every function and module `val` the named entries reach, taking the initializer of each `val` they
// read as a root too, until nothing new is reached.
private reached_by(p: TProgram, entries: Buf[string]) -> &Live
    val index = func_index(p)
    var inits: Set[string] = set()

    loop
        val root = no_reached()

        for entrie in entries
            add_call(root, entrie)

        for i in 0..<p.vals.len()
            val v = p.vals.at(i)

            if inits.has(v.symbol)
                v.init match
                    Some(x) -> walk_texpr(x, expr_walk(false, e -> take_node(root, e)))
                    None -> ()

        val live = reached_from(p, index, root)
        var more = false

        for i in 0..<live.vals.len()
            if inits.add(live.vals.at(i)) then more = true

        if !more then return live
end reached_by

// The removal both of the above make: every declaration `gone` names, and what names only those --
// the tests and hooks it holds, a table with a slot pointing at one, and the scaffolding list's own
// entries for them.
private without_scaffolding(p: TProgram, gone: Set[string]) -> TProgram
    var vtables: Buf[TVtable] = buf()

    for i in 0..<p.vtables.len()
        if !fills_a_slot(gone, p.vtables.at(i)) then vtables.push(p.vtables.at(i))

    var funcs: Buf[TFunc] = buf()

    for i in 0..<p.funcs.len()
        if !gone.has(p.funcs.at(i).name) then funcs.push(p.funcs.at(i))

    var vals: Buf[TVal] = buf()

    for i in 0..<p.vals.len()
        if !gone.has(p.vals.at(i).symbol) then vals.push(p.vals.at(i))

    var externs: Buf[TExtern] = buf()

    for i in 0..<p.externs.len()
        if !gone.has(p.externs.at(i).name) then externs.push(p.externs.at(i))

    var tests: Buf[TTest] = buf()

    for item in p.tests
        if !gone.has(item.func) then tests.push(item)

    var hooks: Buf[THook] = buf()

    for item in p.hooks
        if !gone.has(item.func) then hooks.push(item)

    var only: Buf[string] = buf()

    for item in p.test_only
        if !gone.has(item) then only.push(item)

    TProgram(p.structs, p.enums, vtables, externs, vals, funcs, p.main, p.entry, p.precompiled,
             p.entry_point, p.c_artifact, p.no_alloc_modules, p.no_alloc_test_modules,
             p.main_module, tests, hooks, p.extern_vars, only, p.destructors,
             p.warnings, p.module_deps, p.main_src, p.module_asm)
end without_scaffolding

private fills_a_slot(gone: Set[string], t: TVtable) -> bool
    for item in t.slots
        if gone.has(item.target) then return true

    false
end fills_a_slot
