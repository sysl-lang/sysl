module sh.sysl.compiler

import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}
import sysl.math.bigint.from_int
import sysl.text.parse_real

// **The register file.** A vector is a value with no address, so every form here is an instruction
// over registers -- the two exceptions being `load` and `store`, which are the only vector
// operations that reach memory and the only ones that can fail.

// A vector built lane by lane with `insertelement`, which is the array literal's `insertvalue` chain
// in the register file -- and never through a slot, however wide it is: a value that is not storage
// cannot be built in storage. LLVM folds a chain of constant lanes into a literal, so a splat of
// constants costs nothing at run time.
gen_vector_lit(e: *Emit, lanes: Buf[TExpr], vec_ty: Type) -> Val
    var vals: Buf[Val] = buf()

    for item in lanes
        vals.push(gen_expr(e, item))

    val vty = lty(e, vec_ty)
    val ety = lty(e, element(vec_ty).unwrap_or(Unknown))
    var acc: Val = VZero

    for i in 0..<vals.len()
        val r = fresh_reg(e)

        emit(e, InInsertElement(r, vty, acc, ety, vals.at(i),
                                ir_arg(l_i32(), VInt(from_int(long(i))))))
        acc = r

    acc
end gen_vector_lit

// The splat, in LLVM's own idiom: put the value in lane zero and shuffle it across with an all-zero
// mask. `shufflevector` with a zero mask is the pattern every back end recognises, and it lowers to
// one broadcast instruction where the machine has one.
gen_splat(e: *Emit, value: TExpr, vec_ty: Type) -> Val
    val v = gen_expr(e, value)
    val vty = lty(e, vec_ty)
    val one = fresh_reg(e)

    emit(e, InInsertElement(one, vty, VPoison, lty(e, element(vec_ty).unwrap_or(Unknown)), v,
                            ir_arg(l_i32(), VInt(from_int(0)))))

    val n = repr(vec_ty) match
        Vector(k, _) -> k
        _ -> 0

    val r = fresh_reg(e)

    emit(e, InShuffle(r, vty, one, VPoison, ir_arg(LVec(n, l_i32()), VZero)))
    r
end gen_splat

// A vector's lanes laid into an array, or an array's elements gathered into a vector: one
// `extractelement` and one `insertvalue` per lane, or the other way about. It is never a store of the
// whole register and a load of the array: a `<N>bool` is packed into bits in memory and a `[N]bool`
// is not, and a vector of three lanes is stored as four. Lane by lane says what the conversion is,
// and LLVM merges the chain into whatever moves the machine has.
gen_lanes_as(e: *Emit, value: TExpr, ty: Type) -> Val
    val from = texpr_type(value)
    val v = gen_expr(e, value)
    val to_vector = repr(ty) match
        Vector(_, _) -> true
        _ -> false
    val n = if to_vector then vector_lanes(ty) else vector_lanes(from)
    val (fty, tty) = (lty(e, from), lty(e, ty))
    val ety = lty(e, element(repr(ty)).unwrap_or(Unknown))
    var acc: Val = VZero

    for i in 0..<n
        val lane = fresh_reg(e)
        val r = fresh_reg(e)

        if to_vector
            emit(e, InExtract(lane, fty, v, index_list(i)))
            emit(e, InInsertElement(r, tty, acc, ety, lane, ir_arg(l_i32(), VInt(from_int(long(i))))))
        else
            emit(e, InExtractElement(lane, fty, v, ir_arg(l_i32(), VInt(from_int(long(i))))))
            emit(e, InInsert(r, tty, acc, ety, lane, index_list(i)))
        end if

        acc = r

    acc
end gen_lanes_as

// One lane, read straight out of the register. There is no address and so no bounds test: the index
// was held to a constant in range where it was written.
gen_lane(e: *Emit, receiver: TExpr, lane: int) -> Val
    val v = gen_expr(e, receiver)
    val r = fresh_reg(e)

    emit(e, InExtractElement(r, lty(e, texpr_type(receiver)), v,
                             ir_arg(l_i32(), VInt(from_int(long(lane))))))
    r
end gen_lane

// A lane-wise comparison is the scalar instruction at the register's width -- `fcmp olt <4 x float>`
// yields the `<4 x i1>` that is this language's `<4>bool`. The predicate is chosen exactly as the
// scalar path chooses it, from the lane's own type and signedness.
gen_vec_compare(e: *Emit, op: string, l: TExpr, r: TExpr) -> Val
    val lv = gen_expr(e, l)
    val rv = gen_expr(e, r)
    val vty = lty(e, texpr_type(l))
    val lane = underlying(element(repr(texpr_type(l))).unwrap_or(Unknown))
    val res = fresh_reg(e)

    lane match
        Floating(_, _) -> emit(e, InFloatCmp(res, float_pred(e, op), vty, lv, rv))
        _ -> emit(e, InIntCmp(res, int_pred(e, op, lane), vty, lv, rv))

    res
end gen_vec_compare

// Both sides are evaluated and the mask picks between them, which is the whole difference from an
// `if` and is why this is not one.
gen_select(e: *Emit, mask: TExpr, when_true: TExpr, when_false: TExpr, ty: Type) -> Val
    val m = gen_expr(e, mask)
    val a = gen_expr(e, when_true)
    val b = gen_expr(e, when_false)
    val r = fresh_reg(e)

    emit(e, InSelect(r, m, lty(e, ty), a, b, lty(e, texpr_type(mask))))
    r
end gen_select

// Lanes rearranged: one `shufflevector`, whose list of constant lane numbers is the instruction's own
// operand -- so it is the one instruction at every optimisation level, chosen by instruction
// selection rather than recovered by a pass. A one-input shuffle hands `poison` as the second
// vector, which no lane of the list names.
gen_shuffle(e: *Emit, receiver: TExpr, second: Option[TExpr], lanes: Buf[int]) -> Val
    val a = gen_expr(e, receiver)
    val b = if second.is_some() then gen_expr(e, second.unwrap()) else VPoison
    var picks: Buf[IrArg] = buf()

    for lane in lanes
        picks.push(ir_arg(l_i32(), VInt(from_int(long(lane)))))

    val r = fresh_reg(e)

    emit(e, InShuffle(r, lty(e, texpr_type(receiver)), a, b,
                      ir_arg(LVec(int(lanes.len()), l_i32()), VVector(picks))))
    r
end gen_shuffle

// A vector with lanes written, as one instruction where one lane is named and as one merging
// `shufflevector` where several are.
//
// **One lane is an `insertelement`.** Several are the receiver merged with the value: the mask takes
// lane `lanes[j]` of the result from lane `j` of the value and every other lane from the receiver. The
// value has to be as wide as the receiver to be a shuffle input, so a narrower one is widened first
// -- except where the value is itself a one-input shuffle of a vector the receiver's width
// (`q.xy = p.zw`), whose own list is folded into the merge's, so the whole write is the one
// instruction.
gen_lane_set(e: *Emit, receiver: TExpr, lanes: Buf[int], value: TExpr) -> Val
    val vec_ty = texpr_type(receiver)
    val vty = lty(e, vec_ty)
    val cur = gen_expr(e, receiver)
    val n = repr(vec_ty) match
        Vector(k, _) -> k
        _ -> 0

    if lanes.len() == 1
        val v = gen_expr(e, value)
        val r = fresh_reg(e)

        emit(e, InInsertElement(r, vty, cur, lty(e, texpr_type(value)), v,
                                ir_arg(l_i32(), VInt(from_int(long(lanes.at(0)))))))
        return r
    end if

    // Where each result lane comes from, as a position in the input's own lanes.
    var from = value
    var folded = false
    var sources: Buf[int] = buf()

    for j in 0..<lanes.len()
        sources.push(int(j))

    *value.kind match
        TShuffle(inner, second, listed, _) ->
            if second.is_none() && type_eq(repr(texpr_type(inner)), repr(vec_ty))
                from = inner
                folded = true
                sources = listed
        _ -> ()

    var input = gen_expr(e, from)

    // A value narrower than the receiver is widened by a shuffle whose extra lanes are never read.
    if !folded && int(lanes.len()) < n
        var widen: Buf[IrArg] = buf()

        for i in 0..<n
            widen.push(ir_arg(l_i32(), VInt(from_int(long(if i < int(lanes.len()) then i else 0)))))

        val wide = fresh_reg(e)

        emit(e, InShuffle(wide, lty(e, texpr_type(from)), input, VPoison,
                          ir_arg(LVec(n, l_i32()), VVector(widen))))
        input = wide
    end if

    var picks: Buf[IrArg] = buf()

    for i in 0..<n
        var at = n + i

        for j in 0..<lanes.len()
            if lanes.at(j) == i then at = sources.at(j)

        picks.push(ir_arg(l_i32(), VInt(from_int(long(at)))))

    val r = fresh_reg(e)

    emit(e, InShuffle(r, vty, input, cur, ir_arg(LVec(n, l_i32()), VVector(picks))))
    r
end gen_lane_set

// A vector folded to one lane.
//
// **The float sum takes a starting accumulator and the others do not**, which is not a symmetry LLVM
// chose lightly: floating addition is not associative, so the intrinsic makes you say what to start
// from and whether the order may be changed. `-0.0` is the identity -- `0.0` would turn a sum of
// nothing but negative zeros positive -- and `reassoc` is what licenses the tree that makes this
// worth doing at all rather than a left fold in disguise.
gen_reduce(e: *Emit, op: string, receiver: TExpr, ty: Type) -> Val
    val v = gen_expr(e, receiver)
    val vty = lty(e, texpr_type(receiver))
    val ety = lty(e, element(repr(texpr_type(receiver))).unwrap_or(Unknown))
    val rty = lty(e, ty)
    // The suffix is the **vector's** type rather than the lane's.
    val name = llvm_reduce_entry(op).unwrap().at([vty])

    var params: Buf[IrParam] = buf()
    var ops: Buf[IrArg] = buf()
    var fast: Buf[FastMath] = buf()

    if op == "fadd"
        params.push(ir_param(ety))
        ops.push(ir_arg(ety, VFloat(neg_zero_bits())))
        fast.push(FmReassoc)
    end if

    params.push(ir_param(vty))
    ops.push(ir_arg(vty, v))
    request_intrinsic(e, ir_sig(name, ir_fn_type(rty, params)))

    val r = fresh_reg(e)

    emit(e, InCall(Some(r), rty, VGlobal(name), ops, no_ir_attrs(), None, fast, false))
    r
end gen_reduce

// The bit pattern of negative zero. The value is read from
// text rather than written as `-0.0`, which a fold is free to answer as a positive zero.
private neg_zero_bits() -> long = signed_bits(parse_real("-0.0").unwrap_or(0.0).bits())

// **The alignment is the element's, not the register's, and that is what a slice can promise.** A
// `[]f32` says its elements are four-byte-aligned and says nothing whatever about where the run
// begins -- a slice of one is a slice of any of them. Claiming the vector's own alignment would be a
// promise the type does not make, and an over-aligned `load` is not a slow load but undefined
// behaviour the moment it is wrong. Every machine sysl targets has an unaligned vector load that
// costs the same as the aligned one on aligned data, so the honest number is also the free one.
gen_vec_load(e: *Emit, receiver: TExpr, index: TExpr, vec_ty: Type, site: Span) -> Val
    val elem = element(repr(vec_ty)).unwrap_or(Unknown)
    val p = run_addr(e, receiver, index, vector_lanes(vec_ty), site)
    val r = fresh_reg(e)

    emit(e, InLoad(r, lty(e, vec_ty), p, AccPlain, Some(int(e.layout.align(elem)))))
    r
end gen_vec_load

// The value first and the address second, which is the order an assignment uses -- this *is* an
// assignment to a run of elements, and the two spellings must not differ in when a side effect in
// the value happens relative to the bounds check on the run.
gen_vec_store(e: *Emit, receiver: TExpr, index: TExpr, value: TExpr, site: Span) -> Val
    val vec_ty = texpr_type(value)
    val elem = element(repr(vec_ty)).unwrap_or(Unknown)
    val v = gen_expr(e, value)
    val p = run_addr(e, receiver, index, vector_lanes(vec_ty), site)

    emit(e, InStore(lty(e, vec_ty), v, p, AccPlain, Some(int(e.layout.align(elem)))))
    VNothing
end gen_vec_store

// How many lanes a vector type has.
private vector_lanes(t: Type) -> int = repr(t) match
    Vector(n, _) -> n
    _ -> 0

// A lane-wise operation that is one intrinsic over the whole register: `fabs`, `abs`, `fma`,
// `maximum` or `minimum`. The suffix is the vector's type, so the machine's own instruction is
// selected -- there is no loop over the lanes. `llvm.abs` is told the most negative lane is *not*
// poison, so it answers itself, which is what the scalar `abs` answers in every build.
gen_vec_op(e: *Emit, op: string, operands: Buf[TExpr], ty: Type) -> Val
    val lt = lty(e, ty)
    val fn = if op == "fma" then llvm_fma_entry().at([lt])
             else if op == "fabs" then llvm_fabs_entry().at([lt])
             else if op == "maximum" then llvm_maximum_entry().at([lt])
             else if op == "minimum" then llvm_minimum_entry().at([lt])
             else llvm_abs_entry().at([lt])

    var params: Buf[IrParam] = buf()
    var args: Buf[IrArg] = buf()

    for x in operands
        params.push(ir_param(lt))
        args.push(ir_arg(lt, gen_expr(e, x)))

    if op == "abs"
        params.push(ir_param(l_i1()))
        args.push(ir_arg(l_i1(), VBool(false)))
    end if

    request_intrinsic(e, ir_sig(fn, ir_fn_type(lt, params)))

    val r = fresh_reg(e)

    emit(e, ir_call(Some(r), lt, VGlobal(fn), args))
    r
end gen_vec_op
