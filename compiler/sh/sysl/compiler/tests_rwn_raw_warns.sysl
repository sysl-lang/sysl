module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.fs.{make_dir_all, remove_dir_all, write_text}
import sysl.process.capture

// A raw form written without its import -- `ptr_cast`, `str_cast` or `str_alias` without
// `import sysl.raw.…`, a `va_` form without `import sysl.c.…` -- is a WARNING in 0.6.x, and the
// form answers as it did before it moved behind an import; it is refused from 0.7.0. A file is told
// once per form, at its first use, however many uses follow (`expr_call.sysl`'s `form_not_imported`,
// `decls.sysl`'s `caution_once`). These go through the command line, which is where a warning is
// said, and run what it built.

// -- the harness ----------------------------------------------------------------------------------

// The files are written exactly as given -- no import is added for a form -- beside an empty
// manifest, so a directory build reads them as one project.
private rwn_project(files: Buf[(string, string)]) -> string
    val root = lbr_temp("sysl-rwn")

    for item in files
        val at = s"$root/${item.0}"

        make_dir_all(parent_of(at).unwrap_or(root)).unwrap()
        write_text(at, item.1).unwrap()

    write_text(manifest_file(root), "").unwrap()
    root
end rwn_project

// What `sysl build` of the project said, and what the program it made printed -- or, where it was
// refused, the status and nothing run.
rwn_built(files: Buf[(string, string)]) -> (int, string, string)
    val root = rwn_project(files)
    val exe = s"$root/built"
    val got = lbr_cli(["sysl", "build", root, "-o", exe])
    var ran = ""

    if got.0 == Fine
        capture(exe, [], "", [], true) match
            Ok(out) -> ran = out.text
            Err(_) -> ran = "the program that was built could not be run"
    end if

    remove_dir_all(root).unwrap_or(())
    (got.0, got.1, ran)
end rwn_built

// A one-file program, built and run.
rwn_main(text: string) -> (int, string, string) = rwn_built(lbr_one("main.sysl", text))

// The line a file is told for a form left out.
rwn_line(form: string, home: string) -> string =
    s"warning: '$form' is in $home: add 'import $home.$form' (this is refused from 0.7.0)"

private val rwn_word: string = "var a: [4]u8 = [1, 0, 0, 0]\nval p: *u32 = ptr_cast(&a[0])\nprint(*p)\n"

// -- one warning per file per form ----------------------------------------------------------------

@test("an unimported ptr_cast builds, runs as before, and is warned about at its use")
rwn_one_use()
    if !lbr_ready() then return

    val got = rwn_main(rwn_word)

    assert_eq(got.0, Fine, got.1)
    assert_eq(got.2, "1\n")
    assert(got.1.contains(rwn_line("ptr_cast", "sysl.raw")), got.1)
    assert(got.1.contains("/main.sysl:2:15"), got.1)
    assert_eq(got.1.count_of("warning: "), 1)

@test("a file using ptr_cast many times, bare and with a written type, is warned once, at the first")
rwn_many_uses_one_warning()
    if !lbr_ready() then return

    var text = "var a: [4]u8 = [3, 0, 0, 0]\nvar total: u32 = 0\n\n" +
               "low(p: *u32) -> u8 = *ptr_cast[*u8](p)\n\n"

    for i in 0..<6
        text = text + s"val p$i: *u32 = ptr_cast(&a[0])\ntotal += *p$i\n"

    val got = rwn_main(text + "print(total, low(p0))\n")

    assert_eq(got.0, Fine, got.1)
    assert_eq(got.2, "18 3\n")
    assert_eq(got.1.count_of("warning: "), 1)
    assert(got.1.contains(rwn_line("ptr_cast", "sysl.raw")), got.1)
    assert(got.1.contains("/main.sysl:4:23"), got.1)

@test("two different forms left out are two warnings, one each, in source order")
rwn_two_forms_two_warnings()
    if !lbr_ready() then return

    val got = rwn_main(rwn_word + "var b: [2]u8 = [104, 105]\nprint(str_cast(b[..]), str_cast(b[0..<1]))\n" +
                       "val q: *u8 = ptr_cast(&a[0])\nprint(*q)\n")

    assert_eq(got.0, Fine, got.1)
    assert_eq(got.2, "1\nhi h\n1\n")
    assert_eq(got.1.count_of("warning: "), 2)

    val first = got.1.index_of(rwn_line("ptr_cast", "sysl.raw"))
    val second = got.1.index_of(rwn_line("str_cast", "sysl.raw"))

    assert(first.is_some() && second.is_some() && first.unwrap() < second.unwrap(), got.1)

@test("str_cast and str_alias left out each warn and answer as before")
rwn_str_cast_and_str_alias()
    if !lbr_ready() then return

    val got = rwn_main("var b: [5]u8 = [104, 105, 33, 33, 33]\nprint(str_cast(b[0..<3]))\n" +
                       "val s = str_alias(b[0..<2])\nprint(s, s.len, str_alias(b[0..<1]))\n")

    assert_eq(got.0, Fine, got.1)
    assert_eq(got.2, "hi!\nhi 2 h\n")
    assert_eq(got.1.count_of("warning: "), 2)
    assert(got.1.contains(rwn_line("str_cast", "sysl.raw")), got.1)
    assert(got.1.contains(rwn_line("str_alias", "sysl.raw")), got.1)
    assert(got.1.contains("/main.sysl:3:9"), got.1)

@test("two files of one module that both leave the form out are each told, once")
rwn_each_file_told()
    if !lbr_ready() then return

    var files = lbr_two(
        "demo/a.sysl", "module demo\n\nlow(p: *u32) -> u8 = *ptr_cast[*u8](p)\nlow2(p: *u32) -> u8 = *ptr_cast[*u8](p)\n",
        "demo/b.sysl", "module demo\n\nhigh(p: *u32) -> u8\n    val b: *u8 = ptr_cast(p)\n    b[1]\n")

    files.push(("main.sysl", "import demo.{low, low2, high}\n\nvar x: u32 = 260\nprint(low(&x), low2(&x), high(&x))\n"))

    val got = rwn_built(files)

    assert_eq(got.0, Fine, got.1)
    assert_eq(got.2, "4 4 1\n")
    assert_eq(got.1.count_of("warning: "), 2)
    assert(got.1.contains("/demo/a.sysl:3:23"), got.1)
    assert(got.1.contains("/demo/b.sysl:4:18"), got.1)

// -- what is not warned about ---------------------------------------------------------------------

@test("an imported form, by name, alias, wildcard or path, is not warned about")
rwn_imported_is_quiet()
    if !lbr_ready() then return

    val by_name = rwn_main("import sysl.raw.ptr_cast\n\n" + rwn_word)

    assert_eq(by_name.0, Fine, by_name.1)
    assert_eq(by_name.2, "1\n")
    assert_eq(by_name.1.count_of("warning: "), 0)

    val others = rwn_main("import sysl.raw.{str_cast as sc}\nimport sysl.raw.*\nimport sysl.raw\n\n" +
                          "var a: [4]u8 = [104, 105, 0, 0]\nval p: *u8 = raw.ptr_cast(&a[0])\n" +
                          "print(*p, sc(a[0..<2]), str_alias(a[0..<1]))\n")

    assert_eq(others.0, Fine, others.1)
    assert_eq(others.2, "104 hi h\n")
    assert_eq(others.1.count_of("warning: "), 0)

@test("an aliased import still leaves the bare spelling warned about, and both answer")
rwn_alias_beside_the_bare_name()
    if !lbr_ready() then return

    val got = rwn_main("import sysl.raw.ptr_cast as pc\n\nvar a: [4]u8 = [1, 0, 0, 0]\n" +
                       "val p: *u32 = ptr_cast(&a[0])\nval q: *u32 = pc(&a[0])\nprint(*p, *q)\n")

    assert_eq(got.0, Fine, got.1)
    assert_eq(got.2, "1 1\n")
    assert_eq(got.1.count_of("warning: "), 1)
    assert(got.1.contains("/main.sysl:4:15"), got.1)

@test("a function the reader calls ptr_cast or str_cast is called, with no warning")
rwn_own_function_is_quiet()
    if !lbr_ready() then return

    val got = rwn_main("ptr_cast(n: int) -> int = n + 1\nstr_cast[T](n: T) -> T = n\n\n" +
                       "print(ptr_cast(41), str_cast[int](7))\n")

    assert_eq(got.0, Fine, got.1)
    assert_eq(got.2, "42 7\n")
    assert_eq(got.1.count_of("warning: "), 0)

@test("a program over the standard library, which uses the forms with their imports, is told nothing")
rwn_std_is_quiet()
    if !lbr_ready() then return

    // `sysl.buf`, `sysl.print` and `sysl.text.utf8`, which these reach, use the forms inside, imported.
    val got = rwn_main("import sysl.text.replace_all\n\n" +
                       "print(replace_all(\"xyx\", \"y\", \"z\"), s\"${41 + 1}\")\n")

    assert_eq(got.0, Fine, got.1)
    assert_eq(got.2, "xzx 42\n")
    assert_eq(got.1.count_of("warning: "), 0)

// -- the va_ forms ----------------------------------------------------------------------------------

@test("the va_ forms unimported in a variadic @export each warn once and walk the tail")
rwn_va_in_an_export()
    if !lbr_ready() then return

    val text = "@export(\"rwn_sum\")\nsum(n: int, ...) -> int\n    var ap: va_list\n    var again: va_list\n\n" +
        "    va_start(ap)\n    va_copy(again, ap)\n\n    var total = 0\n\n" +
        "    for i in 0..<n do total += va_arg(ap)\n    for i in 0..<n do total += va_arg(again)\n\n" +
        "    va_end(again)\n    va_end(ap)\n    total\nend sum\n\nprint(sum(3, 1, 2, 3))\n"
    val got = rwn_main(text)

    assert_eq(got.0, Fine, got.1)
    assert_eq(got.2, "12\n")
    assert_eq(got.1.count_of("warning: "), 4)

    for form in ["va_start", "va_copy", "va_arg", "va_end"]
        assert(got.1.contains(rwn_line(form, "sysl.c")), got.1)

    // Imported, the same export is quiet.
    val quiet = rwn_main("import sysl.c.{va_start, va_arg, va_copy, va_end}\n\n" + text)

    assert_eq(quiet.0, Fine, quiet.1)
    assert_eq(quiet.2, "12\n")
    assert_eq(quiet.1.count_of("warning: "), 0)
end rwn_va_in_an_export

// -- a warning is never a failure -----------------------------------------------------------------

@test("a warning beside a real error: the build fails on the error and says only the error")
rwn_error_still_fails()
    if !lbr_ready() then return

    val got = rwn_main(rwn_word + "val n: int = \"no\"\n")

    assert(got.0 != Fine, got.1)
    assert(got.1.contains("error: "), got.1)
    assert_eq(got.1.count_of("warning: "), 0)
