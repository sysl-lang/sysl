// Matrices over the reals — the other half of the vector space, and the two products whose results
// are different types.
//
// `A * v` gives a vector and `A * B` gives a matrix, so one type carries three implementations of one
// trait: `Mul[Vector, Vector]`, `Mul[Matrix, Matrix]` and `Mul[real, Matrix]`. Each is selected by the
// type of the right operand, and each declares what it hands back. Nothing here is a method that
// wanted to be an operator, which is the whole point of the exercise.
//
// The cells are stored row-major in one `&Buf[real]`, so a matrix is a handle exactly as a vector is:
// the operators build fresh matrices and `copy` is how a caller stops sharing.

import sysl.buf.{Buf, buf}

struct Matrix
    rows: int
    cols: int
    cells: &Buf[real]

    at(self, i: int, j: int) -> real = self.cells.at(usize(i * self.cols + j))

    set(*self, i: int, j: int, v: real) = self.cells.set(usize(i * self.cols + j), v)

    is_square(self) -> bool = self.rows == self.cols

    row(self, i: int) -> Vector
        var out = zeros(self.cols)

        for j in 0..<self.cols do out.set(j, self.at(i, j))

        out
    end row

    col(self, j: int) -> Vector
        var out = zeros(self.rows)

        for i in 0..<self.rows do out.set(i, self.at(i, j))

        out
    end col

    copy(self) -> Matrix
        var out = zero_matrix(self.rows, self.cols)

        for i in 0..<self.rows
            for j in 0..<self.cols do out.set(i, j, self.at(i, j))

        out
    end copy

    transpose(self) -> Matrix
        var out = zero_matrix(self.cols, self.rows)

        for i in 0..<self.rows
            for j in 0..<self.cols do out.set(j, i, self.at(i, j))

        out
    end transpose

    // Exchanging two rows in place — what the pivot search does, and the one operation on a matrix
    // that is not a fresh value.
    swap_rows(*self, a: int, b: int)
        if a == b then return

        for j in 0..<self.cols
            var t = self.at(a, j)

            self.set(a, j, self.at(b, j))
            self.set(b, j, t)
    end swap_rows

    near(self, rhs: Matrix, tol: real) -> bool
        if self.rows != rhs.rows || self.cols != rhs.cols then return false

        for i in 0..<self.rows
            for j in 0..<self.cols
                if magnitude(self.at(i, j) - rhs.at(i, j)) > tol then return false

        true
    end near

    text(self) -> string
        var out = ""

        for i in 0..<self.rows
            if i > 0 then out += "; "
            out += self.row(i).text()

        out
    end text
end Matrix

zero_matrix(rows: int, cols: int) -> Matrix
    var cells: Buf[real] = buf()

    for i in 0..<rows * cols do cells.push(0.0)

    Matrix(rows, cols, cells)

// A matrix from the numbers a program wrote, read row by row.
matrix(rows: int, cols: int, xs: []real) -> Matrix
    require int(xs.len) == rows * cols, "a matrix needs exactly rows * cols cells"

    var out = zero_matrix(rows, cols)

    for i in 0..<rows
        for j in 0..<cols do out.set(i, j, xs[i * cols + j])

    out

identity(n: int) -> Matrix
    var out = zero_matrix(n, n)

    for i in 0..<n do out.set(i, i, 1.0)

    out

impl Add for Matrix
    add(self, rhs: Matrix) -> Matrix
        require self.rows == rhs.rows && self.cols == rhs.cols, "matrices added must have the same shape"

        var out = zero_matrix(self.rows, self.cols)

        for i in 0..<self.rows
            for j in 0..<self.cols do out.set(i, j, self.at(i, j) + rhs.at(i, j))

        out
    end add

impl Sub for Matrix
    sub(self, rhs: Matrix) -> Matrix
        require self.rows == rhs.rows && self.cols == rhs.cols, "matrices subtracted must have the same shape"

        var out = zero_matrix(self.rows, self.cols)

        for i in 0..<self.rows
            for j in 0..<self.cols do out.set(i, j, self.at(i, j) - rhs.at(i, j))

        out
    end sub

impl Neg for Matrix
    neg(self) -> Matrix
        var out = zero_matrix(self.rows, self.cols)

        for i in 0..<self.rows
            for j in 0..<self.cols do out.set(i, j, -self.at(i, j))

        out
    end neg

// A matrix applied to a vector: the result is a **vector**, which is neither operand's type. Written
// as `self.row(i) * rhs`, so the dot product in `vec.sysl` is what actually computes each component —
// one operator whose result is a scalar, inside one whose result is a vector.
impl Mul[Vector, Vector] for Matrix
    mul(self, rhs: Vector) -> Vector
        require self.cols == rhs.n, "a matrix applied to a vector needs as many columns as it has entries"

        var out = zeros(self.rows)

        for i in 0..<self.rows do out.set(i, self.row(i) * rhs)

        out
    end mul

impl Mul[Matrix, Matrix] for Matrix
    mul(self, rhs: Matrix) -> Matrix
        require self.cols == rhs.rows, "a product needs the left columns to match the right rows"

        var out = zero_matrix(self.rows, rhs.cols)

        for i in 0..<self.rows
            var r = self.row(i)

            for j in 0..<rhs.cols do out.set(i, j, r * rhs.col(j))

        out
    end mul

impl Mul[real, Matrix] for Matrix
    mul(self, k: real) -> Matrix
        var out = zero_matrix(self.rows, self.cols)

        for i in 0..<self.rows
            for j in 0..<self.cols do out.set(i, j, self.at(i, j) * k)

        out
    end mul

// A pair as the index, which `14 §7` settled with tuples: a subscript takes one argument and a matrix
// wants two, so the one argument is a pair.
impl Index[(int, int), real] for Matrix
    index(self, ij: (int, int)) -> real = self.at(ij.0, ij.1)

impl IndexSet[(int, int), real] for Matrix
    index_set(*self, ij: (int, int), v: real) = self.set(ij.0, ij.1, v)
