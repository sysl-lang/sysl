module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.text.{split, str_builder, Search}

// Putting a dependency into a `package.hocon` **by rewriting the smallest run of bytes that has to
// change**, which is the whole design of `sysl add`.
//
// A manifest is data, so the obvious rewrite -- read it, add a member, print it back -- is available
// and is wrong. Printing back a parsed value emits the value and nothing else, and the manifests in
// this org are about three fifths comment. All of that goes the first time a tool touches the file,
// and a tool that eats the reasoning out of a file is a tool people stop running.
//
// **The file's own style is followed rather than imposed.** A new entry takes the indent its
// siblings have and lines its coordinate up with theirs where they are lined up; nothing already in
// the file moves. That last point is a rule rather than an omission -- reflowing the siblings to fit
// a longer name would turn a one-line addition into a diff over the whole block, which is the same
// objection as the reprint, one size down.
//
// Nothing here writes a file or asks a network anything: it is text in and text out, so what it
// decides can be asserted without either.

// A manifest with one dependency added, or a sentence saying why it could not be.
//
// The result is not written anywhere by this -- `sysl add` re-reads it through the manifest reader
// before it goes to disk, so a rewrite that produced something the compiler cannot read fails with
// the manifest untouched.
add_dependency(text: string, label: string, coordinate: string,
               version: string) -> Result[string, string]
    block_of(text, "dependencies") match
        Some(span) ->
            val body = text[span.0..<span.1]

            val already = entry_names(body)

            for i in 0..<already.len()
                if already.at(i) == label
                    return Err(s"'$label' is already a dependency of this project — change its " +
                        s"version in $ManifestName, or remove the entry and add it again")

            Ok(inserted(text, span.0, span.1, label, coordinate, version))

        None ->
            // A project with no dependencies at all: the block goes at the end, where a reader
            // looking for what a project takes will find it, and where it cannot land inside
            // something else.
            val entry = s"  $label { git = \"$coordinate\", version = \"$version\" }"
            val sep = separator_before(text)

            Ok(s"$text${sep}dependencies {\n$entry\n}\n")
end add_dependency

// What goes between a manifest and a `dependencies` block added at the end of it: nothing where the
// file already ends in a blank line, one newline where it ends in a line, and two where it does not
// end in one at all.
private separator_before(text: string) -> string
    if text.ends_with("\n\n") then return ""
    if text.ends_with("\n") then return "\n"

    "\n\n"
end separator_before

// The half-open span of a top-level block's body -- from just after its `{` to just before the `}`
// that closes it.
//
// The scan skips strings and both comment forms, because a `}` inside either closes nothing and a
// counter that did not know the difference would stop in the middle of a sentence. A manifest is
// small enough that walking it a character at a time costs nothing worth measuring.
block_of(text: string, name: string) -> Option[(usize, usize)]
    val head = header_of(text, name)

    if head.is_none() then return None

    var open = text.bytes.len
    var i = head.unwrap()

    while i < text.bytes.len && open == text.bytes.len
        if text.bytes[i] == u8('{') then open = i

        i += 1

    if open == text.bytes.len then return None

    matching_brace(text, open + 1) match
        None -> None
        Some(close) -> Some((open + 1, close))
end block_of

// Where a top-level `name {` header starts, ignoring one written inside a comment or a string.
//
// **Top-level means at brace depth zero**, which is what keeps `dependencies` from being found
// inside some other block that happened to contain the word.
private header_of(text: string, name: string) -> Option[usize]
    var i: usize = 0
    var depth: int = 0

    while i < text.bytes.len
        skip_past(text, i) match
            Some(next) -> i = next
            None ->
                if text.bytes[i] == u8('{')
                    depth += 1
                    i += 1
                else if text.bytes[i] == u8('}')
                    depth -= 1
                    i += 1
                else if depth == 0 && header_starts(text, i, name) then return Some(i)
                else i += 1

    None
end header_of

// Whether `name` sits at `at` as a whole word with only spaces between it and a `{`.
private header_starts(text: string, at: usize, name: string) -> bool
    if at > 0 && word_byte(text.bytes[at - 1]) then return false

    val end = at + name.bytes.len

    if end > text.bytes.len || text[at..<end] != name then return false

    var j = end

    while j < text.bytes.len && (text.bytes[j] == u8(' ') || text.bytes[j] == u8('\t'))
        j += 1

    j < text.bytes.len && text.bytes[j] == u8('{')
end header_starts

private word_byte(c: u8) -> bool =
    (c >= u8('a') && c <= u8('z')) || (c >= u8('A') && c <= u8('Z')) ||
    (c >= u8('0') && c <= u8('9')) || c == u8('_') || c == u8('-') || c == u8('.') || c >= 128

// The index of the `}` closing a block whose body starts at `from`.
private matching_brace(text: string, from: usize) -> Option[usize]
    var i = from
    var depth: int = 0

    while i < text.bytes.len
        skip_past(text, i) match
            Some(next) -> i = next
            None ->
                if text.bytes[i] == u8('{')
                    depth += 1
                    i += 1
                else if text.bytes[i] == u8('}')
                    if depth == 0 then return Some(i)

                    depth -= 1
                    i += 1
                else i += 1

    None
end matching_brace

// Past a string or a comment starting at `at`, or nothing where `at` starts neither.
//
// HOCON writes `//` and `#` line comments and `/* */` block ones, and sysl's manifests use the
// first. All three are skipped, since a rewrite that understood only the form this org happens to
// write would fail on a file somebody else wrote.
private skip_past(text: string, at: usize) -> Option[usize]
    val c = text.bytes[at]

    if c == u8('"')
        var j = at + 1

        while j < text.bytes.len && text.bytes[j] != u8('"')
            j += if text.bytes[j] == u8('\\') then 2 else 1

        return Some(if j + 1 > text.bytes.len then text.bytes.len else j + 1)

    if c == u8('#') then return Some(past(text, at, "\n"))

    if c == u8('/') && at + 1 < text.bytes.len
        if text.bytes[at + 1] == u8('/') then return Some(past(text, at, "\n"))
        if text.bytes[at + 1] == u8('*') then return Some(past(text, at, "*/"))

    None
end skip_past

private past(text: string, from: usize, of: string) -> usize
    text.index_of_from(of, from) match
        None -> text.bytes.len
        Some(at) -> at + of.bytes.len
end past

// The labels a block's body already declares, read off the text rather than off a parse.
//
// It is the text because this runs *before* the rewrite, on a file the caller may not have parsed --
// and because what matters here is whether the name is written, not what it resolves to.
entry_names(body: string) -> Buf[string]
    var out: Buf[string] = buf()

    val lines = entry_lines(body)

    for n in 0..<lines.len()
        val text = lines.at(n).trim()
        var cut = text.bytes.len

        for i in 0..<text.bytes.len
            val c = text.bytes[i]

            if cut == text.bytes.len && (c == u8(' ') || c == u8('\t') || c == u8('{') ||
                                         c == u8('='))
                cut = i

        if cut > 0 then out.push(text[0..<cut])

    out
end entry_names

// The lines of a block's body that declare something, which is every line that is not blank and not
// wholly a comment.
private entry_lines(body: string) -> Buf[string]
    var out: Buf[string] = buf()

    for line in split(body, "\n")
        val text = line.trim()

        if !text.is_empty() && !text.starts_with("//") && !text.starts_with("#")
            out.push(without_trailing_blanks(line))

    out
end entry_lines

private without_trailing_blanks(line: string) -> string
    var end = line.bytes.len

    while end > 0 && (line.bytes[end - 1] == u8(' ') || line.bytes[end - 1] == u8('\t'))
        end -= 1

    line[0..<end]
end without_trailing_blanks

// The new line put in, with the block's own indent and -- where its entries are lined up -- its own
// column for the coordinate.
private inserted(text: string, open: usize, close: usize, label: string, coordinate: string,
                 version: string) -> string
    val body = text[open..<close]
    val lines = entry_lines(body)
    val indent = if lines.is_empty() then "  " else leading_blanks(lines.at(0))

    // The column the siblings put their `{` at, taken only when they all agree about it: a block
    // that is already ragged gets one space, since there is no column to line up with.
    var column = indent.bytes.len + label.bytes.len + 1
    var agreed: Option[usize] = None
    var ragged = false

    for i in 0..<lines.len()
        lines.at(i).index_of("{") match
            None -> ()
            Some(at) ->
                if at == 0 then ()
                else if agreed.is_none() then agreed = Some(at)
                else if agreed.unwrap() != at then ragged = true

    if !ragged && agreed.is_some() && agreed.unwrap() > indent.bytes.len + label.bytes.len
        column = agreed.unwrap()

    var pad = ""
    var written = indent.bytes.len + label.bytes.len

    while written < column
        pad = pad + " "
        written += 1

    if pad.is_empty() then pad = " "

    val entry = s"$indent$label$pad{ git = \"$coordinate\", version = \"$version\" }"

    // Before the closing brace, on a line of its own, and after whatever indent that brace sits on
    // -- a one-line `dependencies { … }` therefore becomes three, which is the only case where
    // anything already in the file moves, and it moves by gaining line breaks rather than by being
    // reflowed.
    val kept = without_trailing_blanks(body)
    val trailing = body[kept.bytes.len..<body.bytes.len]
    val lead = if kept.is_empty() || kept.ends_with("\n") then "" else "\n"

    var out = str_builder()

    out.push(text[0..<open])
    out.push(kept)
    out.push(lead)
    out.push(entry)
    out.push("\n")
    out.push(trailing)
    out.push(text[close..<text.bytes.len])
    out.finish()
end inserted

private leading_blanks(line: string) -> string
    var at: usize = 0

    while at < line.bytes.len && (line.bytes[at] == u8(' ') || line.bytes[at] == u8('\t'))
        at += 1

    line[0..<at]
end leading_blanks
