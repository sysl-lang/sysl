// A first sysl program. Run it with:
//   sbt "syslJVM/run run examples/hello.sysl"

print("Hello, sysl!")

var width = 6
var height = 7
print("area =", width * height)

// Sum the numbers 1 through 10 with a loop.
var sum = 0
var i = 1
while i <= 10 do
    sum = sum + i
    i++
print("sum 1..10 =", sum)

// Branch on a computed value.
if sum % 2 == 0 then print(sum, "is even")
else print(sum, "is odd")

print(if sum % 2 == 0 then "even" else "odd")

// Floating point, and a chained comparison as a boolean.
var pi = 3.14159
print("pi is about", pi)
print("is 1 < sum < 100?", 1 < sum && sum < 100)
