// p06b: the same default, the bound written as a member type parameter tied to the projection.
trait It
    type Item
    next(*self) -> Option[Self::Item]

    max[E: Ord](self) -> Option[E] where Self: It[Item = E]
        var cur = self
        var best: Option[E] = None
        loop
            cur.next() match
                Some(x) -> best = best match
                    Some(b) -> if b < x then Some(x) else Some(b)
                    None -> Some(x)
                None -> break
        best
    end max

struct Count
    n: int
    stop: int

impl It for Count
    type Item = int
    next(*self) -> Option[int]
        if self.n >= self.stop then return None
        val v = self.n
        self.n += 1
        Some(v)

main()
    print(Count(0, 4).max().unwrap())
