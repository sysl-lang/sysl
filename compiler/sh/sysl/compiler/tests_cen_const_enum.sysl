module sh.sysl.compiler
@tests

// **A simple enum's variant is a valid `const`** (`reference/modules.md § const`): the type is a
// scalar, as Rust's `const W: Access = Access::Write` is. An enum whose variants carry data is storage
// and keeps its refusal. The helpers are `tests_enm_enum_run.sysl`'s.

import sysl.fs.{make_temp_dir, remove_dir_all, write_text}
import sysl.text.replace_all

private cen_access()-> string = raw"""
    enum Access
        Read
        Write
        Both

    enum Level: i16
        Low = -5
        High = 300
    """

private cen_fn() -> string = raw"""

    name(a: Access) -> string = a match
        Read -> "read"
        Write -> "write"
        Both -> "both"
    """

@test("a module-level const of a simple enum, typed and inferred")
cen_module_level()
    if !enm_ready() then return

    assert_eq(enm_ran(cen_access() + cen_fn() + raw"""

        const W = Access.Write
        const R: Access = Access.Read

        print(name(W), name(R))
        """), "write read\n")
end cen_module_level

@test("a local const of a simple enum")
cen_local()
    if !enm_ready() then return

    assert_eq(enm_ran(cen_access() + cen_fn() + raw"""

        run()
            const W = Access.Write
            const R: Access = Access.Read

            print(name(W), name(R))

        run()
        """), "write read\n")
end cen_local

@test("a const compares with == and !=")
cen_equality()
    if !enm_ready() then return

    assert_eq(enm_ran(cen_access() + raw"""

        const W = Access.Write
        val a = Access.Write
        val b = Access.Read

        print(a == W, b == W, b != W)
        """), "true false true\n")
end cen_equality

@test("a const is a pattern in a match")
cen_pattern()
    if !enm_ready() then return

    assert_eq(enm_ran(cen_access() + raw"""

        const W = Access.Write

        f(a: Access) -> string = a match
            W -> "w"
            _ -> "other"

        print(f(Access.Write), f(Access.Read))
        """), "w other\n")
end cen_pattern

@test("a const in a generic function and an array of them")
cen_generic_and_array()
    if !enm_ready() then return

    assert_eq(enm_ran(cen_access() + raw"""

        const W = Access.Write

        pick[T](x: T, y: T, first: bool) -> T = if first then x else y

        val all: [2]Access = [W, Access.Both]

        print(pick(W, Access.Read, true) == W, all[1] == Access.Both)
        """), "true true\n")
end cen_generic_and_array

@test("a const of an enum with explicit discriminants keeps them")
cen_discriminants()
    if !enm_ready() then return

    assert_eq(enm_ran(cen_access() + raw"""

        const H = Level.High
        const L: Level = Level.Low

        print(i16(H), i16(L))
        """), "300 -5\n")
end cen_discriminants

@test("a const initialised from another const, and used in an array length")
cen_chain()
    if !enm_ready() then return

    assert_eq(enm_ran(cen_access() + raw"""

        const A = Access.Both
        const B = A
        const N = int(B)

        val xs: [N]u8 = [7; N]

        print(B == Access.Both, xs.len)
        """), "true 2\n")
end cen_chain

@test("a const initialised by a const function")
cen_const_fn()
    if !enm_ready() then return

    assert_eq(enm_ran(cen_access() + raw"""

        const next(a: Access) -> Access = if a == Access.Read then Access.Write else Access.Both

        const W = next(Access.Read)

        print(W == Access.Write)
        """), "true\n")
end cen_const_fn

@test("an enum with a payload is still no 'const', and the refusal says why")
cen_payload_refused()
    if !enm_ready() then return

    val said = enm_outcome(raw"""
        enum Shape
            Dot
            Circle(r: int)

        const S: Shape = Shape.Dot
        print(1)
        """).0

    assert(said.contains("a constant is a scalar, and Shape carries data in 'Circle', so it is storage — write 'S' as a 'val'"), said)
end cen_payload_refused

@test("the same, with the type left to the value")
cen_payload_inferred_refused()
    if !enm_ready() then return

    val said = enm_outcome(raw"""
        enum Shape
            Dot
            Circle(r: int)

        const S = Shape.Dot
        print(1)
        """).0

    assert(said.contains("a constant is a scalar, and Shape is storage — write 'S' as a 'val'"), said)
end cen_payload_inferred_refused

@test("a const of an enum type given an integer is a mismatch")
cen_wrong_kind()
    if !enm_ready() then return

    val said = enm_outcome(cen_access() + "\nconst m: Access = 1\nprint(1)\n").0

    assert(said.contains("error"), said)
end cen_wrong_kind

@test("a const of an enum type given a non-constant value is refused")
cen_not_constant()
    if !enm_ready() then return

    val said = enm_outcome(cen_access() + raw"""

        f() -> Access
            print(1)
            Access.Read

        const m: Access = f()
        print(1)
        """).0

    assert(said.contains("'m' cannot be computed while compiling"), said)
end cen_not_constant

@test("a module-level const of a simple enum folds for a bare-metal target")
cen_bare_metal()
    if !(std_root().is_ok() && clang_available()) then return

    val root = replace_all(make_temp_dir("sysl-cen").unwrap(), "//", "/")

    write_text(s"$root/sysl.hocon", "package { name = \"cen\" }\n").unwrap()
    write_text(s"$root/main.sysl", raw"""
        enum Access
            Read
            Write

        const W = Access.Write
        const R: Access = Access.Read

        @export("main")
        main_c() -> int = if W == Access.Write && R != W then 1 else 0
        """).unwrap()

    val (code, out, err) = clx_ran(["sysl", "build-c", root, "--target", "thumb-freestanding", "-o",
                                    s"$root/cen.a"])

    remove_dir_all(root).unwrap_or(())
    assert_eq(code, Fine, s"$out$err")
end cen_bare_metal
