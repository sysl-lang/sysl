module sh.sysl.compiler

import sh.sysl.markdown.{Region, gfm, gfm_html, heading_ids, parse_with_regions, to_html_with}
import sh.sysl.parsing.{Source, Span}
import sysl.buf.{Buf, buf}
import sysl.text.{Search, from_utf8_unchecked, str_builder}

// A literate source rendered as the document it already is -- what `sysl weave` writes.
//
// **A `.lsysl` file is Markdown before anything touches it** (`literate.sysl`), and this is the half
// of a literate system that turns it into something to look at. The other half is `tangle`, which
// hands back the program; a build tangles too.
//
// **The compiler says which lines are code, and the Markdown is read around them.** `program_lines`
// is the reading a compilation makes; each run of program lines becomes a region of the
// `sysl-lang/markdown` package's `parse_with_regions`, which closes every Markdown block open where
// the region begins and sets it as a code block of the document. An indent is Markdown's own spelling
// of a code block, but it carries no *language*; a region carries `sysl`. Consecutive runs of program
// text are one region even with blank lines between them, as they are one function to the compiler.
// Everything else is the document's prose, read as one CommonMark document with GitHub's extensions
// (`gfm()`: tables, strikethrough, bare links, task lists, footnotes, emoji, alerts, mathematics,
// mermaid) and heading ids, so a link reference defined anywhere reaches a link anywhere.
//
// **Mathematics is the one thing the reader's browser does.** Prose writes `$…$` and `$$…$$`, the
// document carries them as `\(…\)` and `\[…\]`, and the page links KaTeX's auto-render to set them.
// That needs the network, and it is the only thing that does: the prose, the code and its colouring
// are markup in the file, so a document read offline loses its equations to TeX source and nothing
// else.

// The info string a woven program block carries, and the language its colouring is for.
const WeaveLanguage: string = "sysl"

// Where KaTeX comes from, pinned to an exact version: a document woven today is meant to render the
// same way years from now, and a floating version is a promise nobody made.
private const KatexBase: string = "https://cdn.jsdelivr.net/npm/katex@0.16.11/dist"

weave_usage() -> string = "usage: sysl weave [-o <path>] <path>"

// `sysl weave [-o <path>] <path>` -- each literate source as its own HTML document. **One source is
// one document**: a woven document is a leaf artifact somebody opens, so a tree rendered end to end
// would put five modules under one title. Where the path is a directory, `-o` names a directory and
// each document is written into it under its own name (`weave_document_name`), however many there
// are. The document goes to `say`; a refusal, a mistake and what was written go to `note`.
weave_command(args: []string, say: string -> unit, note: string -> unit) -> int
    val (path, output) = literate_arguments(args) match
        Ok(read) -> read
        Err(said) ->
            note(if said == "" then weave_usage() else said)
            return Misused

    val sources = literate_sources(path, "weave") match
        Ok(s) -> s
        Err(why) ->
            note(refused(why))
            return Failed

    var documents: Buf[(string, string)] = buf()

    for src in sources
        weave_render(src) match
            Ok(html) -> documents.push((src.name, html))
            Err(why) ->
                note(refused(why))
                return Failed

    output match
        None ->
            if documents.len() > 1
                note(refused(s"$path holds ${documents.len()} literate sources — 'weave' writes one " +
                    "document each, so give '-o' a directory to write them into"))
                return Failed
            end if

            val html = documents.at(0).1

            say(if html.ends_with("\n") then html[0..<html.bytes.len - 1] else html)
            Fine
        Some(to) ->
            if !is_directory(path) then return literate_write(to, documents.at(0).1, note)

            literate_directory(to) match
                Some(why) ->
                    note(refused(why))
                    return Failed
                None -> ()

            for item in documents
                val (name, html) = item
                val code = literate_write(join_path(to, weave_document_name(name)), html, note)

                if code != Fine then return code

            Fine
end weave_command

// The document a literate source holds, or the first thing wrong with the file.
//
// **A file the compiler refuses is not woven**: a document that rendered cleanly out of a file the
// compiler will not read would be documentation of a program that does not exist, so the refusals
// are the tangle's own, rendered against the document.
weave_render(src: Source) -> Result[string, string]
    if !is_literate(src.name)
        return Err(s"${src.name} is an ordinary sysl program — 'weave' renders the prose of a " +
            s"'${LiterateExtension}' file, and a program that is all code has none")
    end if

    val program = program_lines(src) match
        Ok(p) -> p
        Err(d) -> return Err(literate_diagnostic(src, d))

    val opts = gfm()

    opts.exts.add(heading_ids())

    val doc = parse_with_regions(from_utf8_unchecked(src.bytes), opts, weave_regions(src, program)) match
        Ok(d) -> d
        Err(e) -> return Err(s"${src.name}: $e")

    val code: &Fn(string, string) -> Option[string] = (info, text) ->
        if weave_language(info) == WeaveLanguage then Some(weave_code_block(text)) else None

    Ok(weave_page(basename(src.name), to_html_with(doc, gfm_html() with { highlight = Some(code) })))
end weave_render

// The runs of program text, each as a region holding its code with the four columns taken off. A run
// goes on through blank lines as far as more program text follows, and stops before them otherwise.
private weave_regions(src: Source, program: Buf[bool]) -> Buf[Region]
    var out: Buf[Region] = buf()
    val n = src.line_count()
    var line: usize = 1

    while line <= n
        if !program.at(line - 1)
            line += 1
            continue
        end if

        var code = str_builder()
        var last = line
        var through = line

        while last <= n
            if program.at(last - 1)
                val text = from_utf8_unchecked(src.line_text(last))

                code.push(text[LiterateIndent..<text.bytes.len])
                code.push_char('\n')
                through = last
                last += 1
                continue
            end if

            var ahead = last

            while ahead <= n && !program.at(ahead - 1) && weave_blank(src, ahead)
                ahead += 1

            if ahead > n || !program.at(ahead - 1) then break

            while last < ahead
                code.push_char('\n')
                last += 1

        out.push(Region(Span(src.line_span(line).start, src.line_span(through).end), WeaveLanguage, code.finish()))
        line = last

    out
end weave_regions

private weave_blank(src: Source, line: usize) -> bool = from_utf8_unchecked(src.line_text(line)).trim().is_empty()

// An info string's language: its first word, as CommonMark reads one.
private weave_language(info: string) -> string = info.index_of(" ") match
    Some(i) -> info[0..<i]
    None -> info

// A block of sysl, coloured. Every block whose language is sysl is set this way -- the program's
// regions and any illustration fenced as sysl alike -- so the document reads one way throughout.
private weave_code_block(text: string) -> string =
    s"<pre><code class=\"language-${WeaveLanguage}\">${hl_sysl(text)}</code></pre>\n"

// What a source's document is called when a tree is woven into a directory: the file's own name with
// the document's extension in place of the source's, its directories dropped so a nested tree lands
// flat.
weave_document_name(name: string) -> string
    val base = basename(name)
    val stem = if base.ends_with(LiterateExtension) then base[0..<base.bytes.len - LiterateExtension.bytes.len] else base

    s"$stem.html"

// The rendered body wrapped in the page that carries it. **The styling is in the file rather than
// beside it**: a woven document is a leaf artifact -- something to open, move or mail -- so one file
// that works by itself beats a directory that has to stay together.
private weave_page(name: string, body: string) -> string =
    "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n" +
    "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n" +
    s"<title>${hl_escape(name)}</title>\n" +
    s"<link rel=\"stylesheet\" href=\"${KatexBase}/katex.min.css\">\n" +
    "<style>\n" + weave_style() + "</style>\n</head>\n<body>\n<main>\n" + body + "</main>\n" +
    s"<script defer src=\"${KatexBase}/katex.min.js\"></script>\n" +
    s"<script defer src=\"${KatexBase}/contrib/auto-render.min.js\"\n" + weave_katex_onload() +
    "</body>\n</html>\n"

private weave_katex_onload() -> string = raw"""
            onload="renderMathInElement(document.body, { delimiters: [
              { left: '\\[', right: '\\]', display: true },
              { left: '\\(', right: '\\)', display: false }
            ] })"></script>
    """

// The document's stylesheet.
//
// **A colour is named once, as a custom property, and the dark palette re-answers the same names**,
// so the rules say what a thing *is* rather than what colour it is and the two palettes cannot drift
// into disagreeing. Every class the colouring writes has its rule here.
//
// The prose is set to a measure rather than to the window, and the code is allowed past that
// measure, because a program wrapped to a prose column is harder to read rather than easier.
private weave_style() -> string = raw"""
    :root {
      --bg: #fdfdfc; --fg: #1a1a18; --muted: #6b6b66; --rule: #e2e2dd;
      --code-bg: #f6f6f4; --accent: #4a5f8a;
      --hl-keyword: #8a3d6b; --hl-string: #3f6b40; --hl-comment: #86867e;
      --hl-number: #9a5b23; --hl-type: #3d6478; --hl-function: #4a4a8a;
      --hl-variable: #1a1a18; --hl-punctuation: #6b6b66;
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #16161a; --fg: #e6e6e2; --muted: #9a9a94; --rule: #2c2c33;
        --code-bg: #1e1e24; --accent: #9db2dd;
        --hl-keyword: #d69ac4; --hl-string: #9ccb9d; --hl-comment: #7e7e88;
        --hl-number: #e0a86a; --hl-type: #8fc0d6; --hl-function: #a8a8e0;
        --hl-variable: #e6e6e2; --hl-punctuation: #9a9a94;
      }
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--fg);
      font-family: ui-serif, Georgia, "Times New Roman", serif;
      font-size: 18px;
      line-height: 1.65;
      -webkit-text-size-adjust: 100%;
    }

    main { max-width: 34em; margin: 0 auto; padding: 4rem 1.25rem 8rem; }

    h1, h2, h3, h4 {
      font-family: ui-sans-serif, system-ui, -apple-system, "Helvetica Neue", sans-serif;
      line-height: 1.25;
      margin: 2.5em 0 0.6em;
    }
    h1 { font-size: 1.9em; margin-top: 0; letter-spacing: -0.015em; }
    h2 { font-size: 1.4em; }
    h3 { font-size: 1.15em; }
    h4 { font-size: 1em; color: var(--muted); }

    p, ul, ol, dl, blockquote { margin: 0 0 1.15em; }

    a { color: var(--accent); text-decoration-thickness: 1px; text-underline-offset: 2px; }

    blockquote {
      margin-left: 0;
      padding-left: 1.1em;
      border-left: 2px solid var(--rule);
      color: var(--muted);
    }

    hr { border: 0; border-top: 1px solid var(--rule); margin: 3em 0; }

    /* The program is the reason the document exists, so it is given the room the prose is denied
       -- it breaks out of the measure and scrolls rather than wrapping. */
    pre {
      background: var(--code-bg);
      border: 1px solid var(--rule);
      border-radius: 5px;
      padding: 0.9em 1.1em;
      overflow-x: auto;
      margin: 0 0 1.15em;
      width: 100%;
    }
    @media (min-width: 60em) {
      pre { width: calc(100% + 6rem); margin-left: -3rem; }
    }

    code, pre, kbd {
      font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
      font-size: 0.82em;
    }
    pre code { font-size: inherit; background: none; padding: 0; border: 0; }

    /* Inline code sits in a sentence, so it is toned down rather than boxed -- a border on every
       mention of an identifier turns a paragraph into a fence. */
    code {
      background: var(--code-bg);
      padding: 0.12em 0.34em;
      border-radius: 3px;
    }

    .hl-keyword     { color: var(--hl-keyword); }
    .hl-string      { color: var(--hl-string); }
    .hl-comment     { color: var(--hl-comment); font-style: italic; }
    .hl-number      { color: var(--hl-number); }
    .hl-type        { color: var(--hl-type); }
    .hl-function    { color: var(--hl-function); }
    .hl-variable    { color: var(--hl-variable); }
    .hl-punctuation { color: var(--hl-punctuation); }

    table { border-collapse: collapse; width: 100%; margin: 0 0 1.15em; font-size: 0.94em; }
    th, td { text-align: left; padding: 0.4em 0.7em; border-bottom: 1px solid var(--rule); }
    th { font-weight: 600; }
    td[align="center"], th[align="center"] { text-align: center; }
    td[align="right"], th[align="right"] { text-align: right; }

    img { max-width: 100%; height: auto; }

    /* Display mathematics scrolls on its own rather than widening the page: an equation nobody
       anticipated is the one thing on a page that has no natural maximum width. */
    .math-display { overflow-x: auto; overflow-y: hidden; padding: 0.4em 0; }

    .markdown-alert { padding: 0.2em 1.1em; border-left: 3px solid var(--accent); margin: 0 0 1.15em; }
    .markdown-alert-title { font-weight: 600; margin-bottom: 0.4em; }

    .footnotes { font-size: 0.9em; color: var(--muted); border-top: 1px solid var(--rule);
                 margin-top: 3em; padding-top: 1em; }
    """
