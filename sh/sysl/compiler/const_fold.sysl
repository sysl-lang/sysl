module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.math.bigint.{BigInt, add, cmp, div_rem, from_int, mul, negate, pow, sub, to_string,
                         and as big_and, or as big_or, xor as big_xor, not as big_not,
                         from_real as big_of_real, to_real as big_to_real, zero as big_zero}
import sysl.text.parse_real

// What an expression comes to while compiling, where it comes to anything.
//
// **Two positions in the language need this and neither of them is an optimization**: an array's
// bound is part of its type, and a vector's lane index is part of the instruction that reads it. So
// a count that does not fold is a mistake to report rather than a value to compute later, which is
// why the answer is an `Option` and not a best effort.

// A value settled while compiling.
enum Const
    ConstInt(value: BigInt)
    ConstBool(value: bool)
    ConstChar(value: char)
    ConstStr(value: string)
    ConstFloat(value: real)
end Const

// The integer an expression comes to, where it comes to one.
const_int(cx: &Analyzer, e: Expr) -> Option[BigInt] = const_fold(cx, e) match
    Some(v) -> v match
        ConstInt(n) -> Some(n)
        _ -> None
    None -> None

// What an expression comes to while compiling.
const_fold(cx: &Analyzer, e: Expr) -> Option[Const] = *e.kind match
    IntLit(digits, base, _) -> Some(ConstInt(literal_value(digits, base)))
    BoolLit(v) -> Some(ConstBool(v))
    CharLit(c) -> Some(ConstChar(c))
    StrLit(s) -> Some(ConstStr(s))
    FloatLit(text, _) -> Some(ConstFloat(parse_real(text).unwrap_or(0.0)))

    // A **value parameter** is asked before a declared constant, and shadows one of the same name
    // for the same reason a type parameter shadows a type: the nearer binding is the one written
    // where the name is. During the walk that checks a generic body there is no argument bound yet,
    // so the name simply is not in the substitution and falls through -- which a caller reads as
    // awaiting instantiation, exactly as it already does for `sizeof(T)`.
    //
    // A declared constant folds to what it was written equal to, read in its own file's terms.
    //
    // `__NAME__` and `__VERSION__` are facts about the package the constant was written in, settled
    // before a line is read, so they fold -- refused here in the words a use outside a constant is
    // refused in. In a default argument each is the calling package's, as `builtin` answers it.
    Ident(name) ->
        if name == "__NAME__" || name == "__VERSION__"
            return manifest_builtin(call_site(cx).unwrap().pkg, name) match
                Err(why) -> refuse(cx, e.span, why)
                Ok(value) -> Some(ConstStr(value))

        val bound = const_arg_bound(cx.subst, name)

        if bound.is_some() then return bound

        const_of_name(cx, name)

    // `A.len` -- how many types a **pack** stands for, which is a compile-time integer and folds as
    // one. It is here as well as in the analyzer because the range of a `for const` is read *before*
    // anything is analyzed: the loop has to know how many copies to make before it can make one.
    //
    // A module-qualified constant -- `c.limit` -- is the other thing this shape is. A `const` is
    // registered under its dotted path, so the same declaration is a constant whether it was
    // imported unqualified or reached through its module.
    Field(receiver, name) ->
        val packed = pack_length(cx.subst, receiver, name)

        if packed.is_some() then return packed

        dotted_name(receiver, name).and_then(n -> const_of_name(cx, n))

    Unary(op, operand) -> const_unary(cx, op, operand)
    Binary(op, l, r) -> const_binary(cx, e.span, op, l, r)
    Compare(operands, ops) ->
        if operands.len() == 2 && ops.len() == 1 then
            const_binary(cx, e.span, ops.at(0), operands.at(0), operands.at(1))
        else
            None

    // A conversion is written, so what it does while compiling is what it does while running: a
    // narrowing wraps and a float-to-integer truncates toward zero.
    Call(callee, args) -> const_conversion(cx, e.span, callee, args)

    // `sizeof(T)` and `alignof(T)` are compile-time constants, so they fold exactly as a literal
    // does -- which is what makes them usable in an array bound and in a `const`.
    LayoutOf(what, t) -> layout_bytes(cx, what, resolve_type(cx.an, cx.scope, t, cx.subst))
    OffsetOf(t, field) -> offset_bytes(cx, e.span, resolve_type(cx.an, cx.scope, t, cx.subst), field)

    // `T::Min` and `T::Max` on a built-in integer are constants for the reason `sizeof` is: the
    // answer is a property of the type and is known once the type is.
    TypeAttr(receiver, attr) -> const_type_attr(cx, receiver, attr)

    _ -> None

// How many types the pack `A` stands for, where `A.len` is what was written.
private pack_length(subst: Buf[Binding], receiver: Expr, name: string) -> Option[Const]
    if name != "len" then return None

    *receiver.kind match
        Ident(n) -> bound_type(subst, n) match
            Some(Pack(elems)) -> Some(ConstInt(from_int(long(elems.len()))))
            _ -> None
        _ -> None
end pack_length

// What a value parameter stands for, where the name is bound to one.
//
// The argument travels as a `BigInt` because that is what a type's identity needs -- something that
// compares and mangles -- and the declared type is what says how to read it back. A `bool` whose
// parameter folded to an integer would be a `0` where the body wrote `B`, so the type is not
// decoration here: it is the half of the pair that makes the number mean something.
private const_arg_bound(subst: Buf[Binding], name: string) -> Option[Const]
    bound_type(subst, name) match
        Some(ConstArg(v, ty)) -> underlying(*ty) match
            Bool -> Some(ConstBool(v != from_int(0)))
            Char -> Some(ConstChar(char(u32(v.to_long().unwrap_or(0)))))
            _ -> Some(ConstInt(v))
        _ -> None
end const_arg_bound

private const_of_name(cx: &Analyzer, name: string) -> Option[Const]
    if cx.lookup(name).is_some() then return None

    val key = lookup_value_key(cx, cx.an.tables.consts, name)

    if key.is_none() then return None

    val d = cx.an.tables.consts.get(key.unwrap()).unwrap()

    if d.init.is_none() then return None
    // A constant written in terms of itself is a loop the fold would follow for ever, so it is cut
    // here as well as where a use of one is typed.
    if const_cycle_at(cx, key.unwrap()) then return None

    val inner = analyzer_for(cx.an, d.scope)

    cx.an.consts_in_progress.push(key.unwrap())

    val out = const_fold(inner, d.init.unwrap())

    cx.an.consts_in_progress.truncate(cx.an.consts_in_progress.len() - 1)
    out
end const_of_name

// The dotted spelling a `Field` over a chain of plain names comes to, where it is one.
private dotted_name(receiver: Expr, name: string) -> Option[string] = *receiver.kind match
    Ident(head) -> Some(s"$head.$name")
    Field(inner, mid) -> dotted_name(inner, mid).map(head -> s"$head.$name")
    _ -> None

private const_unary(cx: &Analyzer, op: string, operand: Expr) -> Option[Const]
    val v = const_fold(cx, operand)

    if v.is_none() then return None

    v.unwrap() match
        ConstInt(n) ->
            if op == "-" then Some(ConstInt(negate(n)))
            else if op == "~" then Some(ConstInt(big_not(n)))
            else None
        ConstFloat(f) -> if op == "-" then Some(ConstFloat(0.0 - f)) else None
        ConstBool(b) -> if op == "!" then Some(ConstBool(!b)) else None
        _ -> None
end const_unary

private const_binary(cx: &Analyzer, span: Span, op: string, l: Expr, r: Expr) -> Option[Const]
    val a = const_fold(cx, l)
    val b = const_fold(cx, r)

    if a.is_none() || b.is_none() then return None

    a.unwrap() match
        ConstInt(x) -> b.unwrap() match
            ConstInt(y) -> int_binary(cx, span, op, x, y)
            _ -> None
        ConstFloat(x) -> b.unwrap() match
            ConstFloat(y) -> float_binary(op, x, y)
            _ -> None
        ConstBool(x) -> b.unwrap() match
            ConstBool(y) -> bool_binary(op, x, y)
            _ -> None
        ConstChar(x) -> b.unwrap() match
            ConstChar(y) -> compared(op, cmp(from_int(long(u32(x))), from_int(long(u32(y)))))
            _ -> None
        ConstStr(x) -> b.unwrap() match
            ConstStr(y) -> str_binary(op, x, y)
            _ -> None
end const_binary

// A comparison's verdict from the sign of the difference, where the operator is a comparison.
private compared(op: string, sign: int) -> Option[Const]
    if op == "==" then return Some(ConstBool(sign == 0))
    if op == "!=" then return Some(ConstBool(sign != 0))
    if op == "<" then return Some(ConstBool(sign < 0))
    if op == "<=" then return Some(ConstBool(sign <= 0))
    if op == ">" then return Some(ConstBool(sign > 0))
    if op == ">=" then return Some(ConstBool(sign >= 0))

    None
end compared

// Two string literals joined are a third, which is the one operator on strings that produces a
// value rather than a verdict -- and at compile time it is text beside text, with none of the
// allocating `sysl.str.concat` a run-time `+` lowers to. It is what lets a long constant be written
// in pieces, one line per source line; without it such a value could not be a `const` at all.
private str_binary(op: string, x: string, y: string) -> Option[Const]
    if op == "+" then return Some(ConstStr(x + y))
    if op == "==" then return Some(ConstBool(x == y))
    if op == "!=" then return Some(ConstBool(x != y))

    None
end str_binary

// Floating-point arithmetic is the machine's, done once while compiling.
private float_binary(op: string, x: real, y: real) -> Option[Const]
    if op == "+" then return Some(ConstFloat(x + y))
    if op == "-" then return Some(ConstFloat(x - y))
    if op == "*" then return Some(ConstFloat(x * y))
    if op == "/" then return Some(ConstFloat(x / y))

    compared(op, if x < y then -1 else if x > y then 1 else 0)
end float_binary

// A fold that cannot go on, said at the sub-expression that stopped it -- the division, the shift,
// the conversion -- and counted in `Analysis.const_refusals` whether or not the report already
// holds it. Every read of a refused constant arrives here again with the same sentence at the same
// place, so the report keeps one and the count is what tells the reader the fold refused.
private refuse(cx: &Analyzer, span: Span, message: string) -> Option[Const]
    cx.fault(span, message)
    cx.an.const_refusals += 1
    None
end refuse

// Whether a fold begun when the count stood at `mark` refused, rather than meeting something that is
// simply not a constant -- which is what a reader asks before saying so itself.
const_refused_since(a: &Analysis, mark: usize) -> bool = a.const_refusals != mark

private int_binary(cx: &Analyzer, span: Span, op: string, x: BigInt, y: BigInt) -> Option[Const]
    if op == "+" then return Some(ConstInt(add(x, y)))
    if op == "-" then return Some(ConstInt(sub(x, y)))
    if op == "*" then return Some(ConstInt(mul(x, y)))
    if op == "&" then return Some(ConstInt(big_and(x, y)))
    if op == "|" then return Some(ConstInt(big_or(x, y)))
    if op == "^" then return Some(ConstInt(big_xor(x, y)))

    // A division by zero is a mistake in what was written rather than something to answer, and the
    // compiler is the one dividing, so it is the one to say so.
    if op == "/" || op == "%"
        if cmp(y, from_int(0)) == 0 then return refuse(cx, span, "a constant divided by zero")

        val q = div_rem(x, y)

        return Some(ConstInt(if op == "/" then q.0 else q.1))
    end if

    if op == "<<" || op == ">>" then return shifted(cx, span, op, x, y)

    compared(op, cmp(x, y))
end int_binary

// A constant shift, done as a multiplication or a division by a power of two, since these are
// numbers with no width to shift bits inside of.
//
// **The ceiling on the distance is the widest integer a type may be and not 64**, because a shift
// past 64 places is meaningful the moment a type is wider than that: `1 << 200` is an ordinary
// constant at `u256`. A distance beyond every possible width is refused -- it cannot be a shift of
// anything, and the number it would produce is unbounded.
private shifted(cx: &Analyzer, span: Span, op: string, x: BigInt, places: BigInt) -> Option[Const]
    if cmp(places, from_int(0)) < 0 || cmp(places, from_int(long(MaxIntegerBits))) > 0 then
        return refuse(cx, span, s"a constant shifted by ${to_string(places)} places")

    val n = places.to_long()

    if n.is_none() then return None

    val scale = pow(from_int(2), usize(n.unwrap()))

    if op == "<<" then return Some(ConstInt(mul(x, scale)))

    // **A right shift rounds DOWN and a division rounds toward zero**, and the two disagree on
    // every negative value that does not divide exactly: `-3 >> 1` is `-2` and `-3 / 2` is `-1`.
    // The shift is the arithmetic one, so a negative left over takes the quotient one further down.
    val q = div_rem(x, scale)

    if cmp(x, from_int(0)) < 0 && cmp(q.1, from_int(0)) != 0 then
        return Some(ConstInt(sub(q.0, from_int(1))))

    Some(ConstInt(q.0))
end shifted

private bool_binary(op: string, x: bool, y: bool) -> Option[Const]
    if op == "&&" then return Some(ConstBool(x && y))
    if op == "||" then return Some(ConstBool(x || y))
    if op == "==" then return Some(ConstBool(x == y))
    if op == "!=" then return Some(ConstBool(x != y))

    None
end bool_binary

// How many bytes `sizeof` or `alignof` answers with, where the type is one this compilation has a
// layout for. A type parameter is not measured: its width is fixed at each instantiation.
layout_bytes(cx: &Analyzer, what: string, t: Type) -> Option[Const]
    if t == Unknown || mentions_abstract(t) then return None

    if what == "sizeof" then return Some(ConstInt(from_int(long(cx.an.tables.layout.size(t)))))
    if what == "alignof" then return Some(ConstInt(from_int(long(cx.an.tables.layout.align(t)))))

    None
end layout_bytes

// Where a field sits in a struct, in bytes.
//
// The two silent `None`s are a parameter awaiting its instantiation and a type already complained
// about; **every other way to have no answer is refused here, in its own words**, and counted, so the
// `const` or the `@assert` around it says nothing more. A misspelled field is the one that matters
// most -- the form exists to be told when a mirror and its original disagree -- so the refusal lists
// what the struct does have. **A bitfield has no byte offset**, being a range of bits inside the one
// integer its struct is, and rounding down to the byte it begins in would be a number that is not
// where it is; and a zero-sized field lands nowhere.
offset_bytes(cx: &Analyzer, span: Span, t: Type, field: string) -> Option[Const]
    if t == Unknown || mentions_abstract(t) then return None

    underlying(t) match
        Struct(d) ->
            val shown = type_show(t)
            val ranges = bitfield_ranges(d)

            if ranges.is_some()
                val rs = ranges.unwrap()

                for i in 0..<rs.len()
                    val r = rs.at(i)

                    if r.name == field
                        return refuse(cx, span, s"'$shown.$field' is a bitfield — it starts at bit ${r.offset} " +
                            s"of the struct and is ${r.width} bits wide, so it has no byte offset. 'offsetof' " +
                            "answers in bytes, and the byte it begins in is not where it is")
            end if

            val at = cx.an.tables.layout.field_offset(d, field)

            if at.is_some() then return Some(ConstInt(from_int(long(at.unwrap()))))

            if d.field_index(field) >= 0
                return refuse(cx, span, s"'$shown.$field' occupies no storage, so it has no offset — a " +
                    "zero-sized field lands nowhere, and a C struct that is being mirrored has no member " +
                    "matching it either")

            refuse(cx, span, s"'$shown' has no field '$field'" + stored_names(d))
        _ -> refuse(cx, span, s"'offsetof' measures a field of a struct, and ${type_show(t)} is not one")
end offset_bytes

// The fields a struct declares, quoted, as the tail of a refusal naming one it does not.
private stored_names(d: &StructType) -> string
    val fields = d.fields

    if fields.len() == 0 then return ""

    var out = " — it stores "

    for i in 0..<fields.len()
        if i > 0 then out = out + ", "
        out = out + s"'${fields.at(i).0}'"

    out
end stored_names

// A width family name, measured with nothing to say about a spelling that is not one.
private width_of(cx: &Analyzer, name: string) -> Option[Type] =
    width_type(cx.an, cx.scope, Span(0, 0), name)

// `T::Min` and `T::Max` on a built-in integer -- written by name, or reached through a type parameter
// the instantiation bound to one, which is the nearer binding and so is asked first.
private const_type_attr(cx: &Analyzer, receiver: Expr, attr: string) -> Option[Const]
    val name = *receiver.kind match
        Ident(n) -> Some(n)
        _ -> None

    if name.is_none() then return None

    val written = scalar_named(name.unwrap(), word_bits(cx)).or_else(() -> width_of(cx, name.unwrap()))
    val t = bound_type(cx.subst, name.unwrap()).or_else(() -> written)

    if t.is_none() then return None

    t.unwrap() match
        Integer(bits, signed, _) ->
            if attr == "Min" then Some(ConstInt(min_of(bits, signed)))
            else if attr == "Max" then Some(ConstInt(max_of(bits, signed)))
            else None
        _ -> None
end const_type_attr

// A written conversion to a scalar -- `u8(300)`, `real(3)`, `char(65)` -- over a value that folds.
private const_conversion(cx: &Analyzer, span: Span, callee: Expr, args: Buf[Expr]) -> Option[Const]
    if args.len() != 1 then return None

    val written = *callee.kind match
        Ident(n) -> Some(n)
        _ -> None

    if written.is_none() || cx.lookup(written.unwrap()).is_some() then return None

    val name = written.unwrap()
    val target = scalar_named(name, word_bits(cx)).or_else(() -> width_of(cx, name))

    if target.is_none() then return None

    val value = const_fold(cx, args.at(0))

    if value.is_none() then return None

    converted(cx, span, value.unwrap(), target.unwrap())
end const_conversion

private converted(cx: &Analyzer, span: Span, v: Const, target: Type) -> Option[Const] = v match
    ConstInt(n) -> target match
        Integer(bits, signed, _) -> Some(ConstInt(wrap(n, bits, signed)))
        Floating(_, _) -> Some(ConstFloat(big_to_real(n)))
        Char ->
            val max = from_int(0x10FFFF)

            if cmp(n, from_int(0)) < 0 || cmp(n, max) > 0 ||
               (cmp(n, from_int(0xD800)) >= 0 && cmp(n, from_int(0xDFFF)) <= 0)
                return refuse(cx, span, s"${to_string(n)} is not a Unicode scalar value")

            Some(ConstChar(char(u32(n.to_long().unwrap_or(0)))))
        _ -> None
    ConstFloat(f) -> target match
        Integer(bits, signed, _) -> Some(ConstInt(wrap(big_of_real(f).unwrap_or(big_zero()), bits, signed)))
        Floating(_, _) -> Some(ConstFloat(f))
        _ -> None
    ConstChar(c) -> target match
        Integer(bits, signed, _) -> Some(ConstInt(wrap(from_int(long(u32(c))), bits, signed)))
        _ -> None
    _ -> None

// -- `@assert` -----------------------------------------------------------------------------------

// What an `@assert` says when its condition does not hold, is not a condition, or does not settle.
//
// **It is settled while compiling and emits nothing either way**: a true assertion is not code, and
// a false one has already stopped the compilation. So the whole of the form is what is said about
// it here.
//
// Inside a generic body the folding is done against the substitution the instantiation supplied,
// which is the only moment `sizeof(T)` is a number -- and a condition that is still waiting for one
// is not a mistake, since a later instantiation settles it.
check_assert(cx: &Analyzer, span: Span, cond: Expr, message: Option[string])
    val refusals = cx.an.const_refusals

    const_fold(cx, cond) match
        Some(ConstBool(true)) -> ()
        Some(ConstBool(false)) ->
            val head = assertion_head(message)

            cx.fault(span, head + compared_note(cx, cond) + instantiation_note(cx))
        Some(other) ->
            cx.fault(span, s"'@assert' takes a condition, and this is ${const_kind(other)} — an " +
                     "assertion is something that can be true or false")
        // A fold that refused has already said why, at the part that stopped it.
        None ->
            if !awaits_instantiation(cx, cond) && !const_refused_since(cx.an, refusals) then
                cx.fault(span, "'@assert' is settled while compiling, so its condition has to be " +
                         "a constant expression — a literal, a 'const', 'sizeof', 'alignof', " +
                         "'offsetof', or the arithmetic and comparisons over them, and never a call")
end check_assert

private assertion_head(message: Option[string]) -> string
    if message.is_none() then return "assertion failed"

    s"assertion failed: ${message.unwrap()}"
end assertion_head

// What a failed **comparison** adds: the value each side folded to, for a side the reader did not
// write out as a literal. The compiler folded both to decide the comparison, so it is holding the
// two numbers that explain the answer.
private compared_note(cx: &Analyzer, cond: Expr) -> string
    var left: Option[string] = None
    var right: Option[string] = None

    *cond.kind match
        Compare(operands, ops) ->
            if operands.len() == 2 && ops.len() == 1
                left = folded_side(cx, operands.at(0))
                right = folded_side(cx, operands.at(1))
        _ -> ()

    if left.is_some() && right.is_some() then
        return s" — the left side is ${left.unwrap()} and the right side is ${right.unwrap()}"

    if left.is_some() then return s" — the left side is ${left.unwrap()}"
    if right.is_some() then return s" — the right side is ${right.unwrap()}"

    ""
end compared_note

// One side of the comparison, as text, unless the reader wrote it out as a literal -- in which case
// reporting it back says nothing they cannot already see.
private folded_side(cx: &Analyzer, e: Expr) -> Option[string]
    if written_literal(e) then return None

    const_fold(cx, e).map(v -> const_text(v))
end folded_side

// Whether an operand is a literal the reader **wrote**. A negative number is written `-1` and parses
// as a unary minus over a literal, so it counts too -- otherwise the shape a bound is most often
// compared against would be the one reported back.
private written_literal(e: Expr) -> bool = *e.kind match
    IntLit(_, _, _) -> true
    FloatLit(_, _) -> true
    BoolLit(_) -> true
    CharLit(_) -> true
    StrLit(_) -> true
    Unary(op, operand) -> op == "-" && written_literal(operand)
    _ -> false

// A folded value as it should appear inside a sentence, spelled the way it would be written.
private const_text(v: Const) -> string = v match
    ConstInt(n) -> to_string(n)
    ConstBool(b) -> if b then "true" else "false"
    ConstChar(c) -> s"'$c'"
    ConstStr(s) -> s"\"$s\""
    ConstFloat(f) -> str(f)

// What a value that is not a condition is, said the way the refusal names it.
const_kind(v: Const) -> string = v match
    ConstInt(_) -> "an integer"
    ConstBool(_) -> "a boolean"
    ConstChar(_) -> "a character"
    ConstStr(_) -> "a string"
    ConstFloat(_) -> "a float"

// Whether the condition is one a later instantiation settles rather than one that cannot settle at
// all: a measurement of a type parameter, or a value parameter standing in for itself.
private awaits_instantiation(cx: &Analyzer, e: Expr) -> bool = *e.kind match
    LayoutOf(_, t) -> is_abstract_underlying(resolve_type(cx.an, cx.scope, t, cx.subst))
    OffsetOf(t, _) -> is_abstract_underlying(resolve_type(cx.an, cx.scope, t, cx.subst))
    Ident(n) -> binding_is_abstract(cx.subst, n)
    TypeAttr(receiver, _) -> awaits_instantiation(cx, receiver)
    Unary(_, operand) -> awaits_instantiation(cx, operand)
    Binary(_, l, r) -> awaits_instantiation(cx, l) || awaits_instantiation(cx, r)
    Compare(operands, _) ->
        operands.len() == 2 && (awaits_instantiation(cx, operands.at(0)) ||
                                awaits_instantiation(cx, operands.at(1)))
    Call(callee, args) -> args.len() == 1 && is_bare_name(callee) && awaits_instantiation(cx, args.at(0))
    _ -> false

private is_bare_name(e: Expr) -> bool = *e.kind match
    Ident(_) -> true
    _ -> false

private is_abstract_underlying(t: Type) -> bool = underlying(t) match
    Abstract(_, _) -> true
    _ -> false

private binding_is_abstract(subst: Buf[Binding], name: string) -> bool
    for i in 0..<subst.len()
        if subst.at(i).name == name
            return subst.at(i).ty match
                Abstract(_, _) -> true
                _ -> false

    false
end binding_is_abstract

// -- the typed tree, for module storage --------------------------------------------------------------

// What a TYPED scalar expression comes to while compiling -- the question a module `val`'s
// initializer asks before it can be laid into the object file rather than computed by a prologue
// (`laid_down`). It is the arithmetic `const_fold` does over the written tree, done over the tree
// the analyzer built from it, so a `const` read inside it is already its literal.
//
// **It holds itself to one promise `const_fold` does not need**: the answer is the value the
// expression produces at run time. A `const` that overflows is a mistake to report; an initializer
// that overflows is code that traps, and the trap belongs to the program. So wherever run time could
// say something else -- an integer result its type does not hold, a division by zero, a shift by the
// width or more, a float conversion out of the integer's range, a character outside Unicode -- the
// answer is `None`, the initializer stays code, and nothing is said. A `f32` is rounded at every step,
// as the machine rounds it.
const_fold_typed(t: TExpr) -> Option[Const]
    val ty = folded_scalar(texpr_type(t))

    if ty.is_none() then return None

    val v = *t.kind match
        TIntLit(n, _) -> Some(ConstInt(n))
        TBoolLit(b) -> Some(ConstBool(b))
        TStrLit(s) -> Some(ConstStr(s))
        TFloatLit(bits, _) -> Some(ConstFloat(real_of_bits(bits)))
        TUnary(op, operand, _) -> typed_unary(op, operand, ty.unwrap())
        TBinary(op, l, r, _) -> typed_binary(op, l, r)
        TLogical(op, l, r) -> typed_binary(op, l, r)
        TCompare(operands, cmps) ->
            if operands.len() == 2 && cmps.len() == 1 && cmps.at(0).dispatch.is_none() then
                typed_binary(cmps.at(0).op, operands.at(0), operands.at(1))
            else
                None
        TCast(inner, _) -> typed_conversion(inner, ty.unwrap())
        _ -> None

    if v.is_none() then return None

    held_at(v.unwrap(), ty.unwrap())
end const_fold_typed

// The scalar a typed node is, where it is one this fold answers for: an integer, a `f32` or `f64`,
// a `bool`, a `char` or a `string`, or a name for one that checks nothing. A subtype with a range or
// a predicate runs its check at run time, so it is not one.
private folded_scalar(t: Type) -> Option[Type] = t match
    Constrained(d) -> if name_only(d) then folded_scalar(underlying(t)) else None
    Integer(_, _, _) -> Some(t)
    Floating(bits, brain) -> if !brain && (bits == 32 || bits == 64) then Some(t) else None
    Bool -> Some(t)
    Char -> Some(t)
    Str -> Some(t)
    _ -> None

// A settled value as its type holds it, or `None` where the type cannot hold it as it stands.
private held_at(v: Const, ty: Type) -> Option[Const] = v match
    ConstInt(n) -> ty match
        Integer(bits, signed, _) -> if fits(n, bits, signed) then Some(v) else None
        Char -> if scalar_value(n) then Some(v) else None
        _ -> None
    // A NaN's bits are the machine's choice -- x86 and Arm make different ones -- so one is not
    // written down for it.
    ConstFloat(f) -> ty match
        Floating(bits, _) -> if f != f then None else Some(ConstFloat(if bits == 32 then real(f32(f)) else f))
        _ -> None
    ConstBool(_) -> if ty == Bool then Some(v) else None
    ConstStr(_) -> if ty == Str then Some(v) else None
    ConstChar(_) -> None

// Whether a number is a Unicode scalar value -- what `char(u)` checks at run time.
private scalar_value(n: BigInt) -> bool =
    cmp(n, from_int(0)) >= 0 && cmp(n, from_int(0x10FFFF)) <= 0 &&
    !(cmp(n, from_int(0xD800)) >= 0 && cmp(n, from_int(0xDFFF)) <= 0)

private typed_unary(op: string, operand: TExpr, ty: Type) -> Option[Const]
    val v = const_fold_typed(operand)

    if v.is_none() then return None

    v.unwrap() match
        ConstInt(n) -> ty match
            Integer(bits, signed, _) ->
                if op == "-" then Some(ConstInt(negate(n)))
                // `~` is the complement within the width, which is the only reading a width has.
                else if op == "~" then Some(ConstInt(wrap(big_not(n), bits, signed)))
                else None
            _ -> None
        // `0.0 - f` is the fold's negation, and it is not the machine's at zero, whose sign it flips.
        ConstFloat(f) -> if op == "-" && f != 0.0 then Some(ConstFloat(0.0 - f)) else None
        ConstBool(b) -> if op == "!" then Some(ConstBool(!b)) else None
        _ -> None
end typed_unary

private typed_binary(op: string, l: TExpr, r: TExpr) -> Option[Const]
    val a = const_fold_typed(l)
    val b = const_fold_typed(r)

    if a.is_none() || b.is_none() then return None

    a.unwrap() match
        ConstInt(x) -> b.unwrap() match
            ConstInt(y) -> typed_int_binary(op, x, y, folded_scalar(texpr_type(l)).unwrap())
            _ -> None
        // A NaN compares unequal to everything, itself included, which `float_binary`'s sign of the
        // difference cannot say.
        ConstFloat(x) -> b.unwrap() match
            ConstFloat(y) -> if x != x || y != y then None else float_binary(op, x, y)
            _ -> None
        ConstBool(x) -> b.unwrap() match
            ConstBool(y) -> bool_binary(op, x, y)
            _ -> None
        ConstStr(x) -> b.unwrap() match
            ConstStr(y) -> str_binary(op, x, y)
            _ -> None
        ConstChar(_) -> None
end typed_binary

// The integer operators, answered only where run time answers the same: never a division by zero,
// never `%` by `-1` (whose quotient is the one a signed width cannot hold), never a shift by a
// negative count or by the operand's whole width.
private typed_int_binary(op: string, x: BigInt, y: BigInt, lt: Type) -> Option[Const]
    if op == "/" || op == "%"
        if cmp(y, from_int(0)) == 0 || (op == "%" && cmp(y, from_int(-1)) == 0) then return None

        val q = div_rem(x, y)

        return Some(ConstInt(if op == "/" then q.0 else q.1))
    end if

    if op == "<<" || op == ">>"
        val bits = lt match
            Integer(w, _, _) -> w
            _ -> 0

        if cmp(y, from_int(0)) < 0 || cmp(y, from_int(long(bits))) >= 0 then return None

        val scale = pow(from_int(2), usize(y.to_long().unwrap_or(0)))

        if op == "<<" then return Some(ConstInt(mul(x, scale)))

        val q = div_rem(x, scale)

        if cmp(x, from_int(0)) < 0 && cmp(q.1, from_int(0)) != 0 then
            return Some(ConstInt(sub(q.0, from_int(1))))

        return Some(ConstInt(q.0))
    end if

    if op == "+" then return Some(ConstInt(add(x, y)))
    if op == "-" then return Some(ConstInt(sub(x, y)))
    if op == "*" then return Some(ConstInt(mul(x, y)))
    if op == "&" then return Some(ConstInt(big_and(x, y)))
    if op == "|" then return Some(ConstInt(big_or(x, y)))
    if op == "^" then return Some(ConstInt(big_xor(x, y)))

    compared(op, cmp(x, y))
end typed_int_binary

// A written conversion between scalars, where run time converts to the same value. An integer
// narrowed wraps, as `converted` says; a float becomes an integer only where the integer holds it,
// so the answer never depends on what an out-of-range conversion does.
private typed_conversion(inner: TExpr, to: Type) -> Option[Const]
    val from = folded_scalar(texpr_type(inner))
    val v = const_fold_typed(inner)

    if from.is_none() || v.is_none() then return None

    v.unwrap() match
        ConstInt(n) -> to match
            Integer(bits, signed, _) -> from.unwrap() match
                Integer(_, _, _) -> Some(ConstInt(wrap(n, bits, signed)))
                // A `char` read as an integer is its code point, and only where the width holds it.
                Char -> if fits(n, bits, signed) then Some(ConstInt(n)) else None
                _ -> None
            Char -> if scalar_value(n) then Some(ConstInt(n)) else None
            // Past 2^53 the integer is rounded on its way to a `real`, and rounding it again to a
            // `f32` is two roundings where the machine does one.
            Floating(bits, _) ->
                if bits == 32 && cmp(big_abs(n), pow(from_int(2), 53)) > 0 then None
                else Some(ConstFloat(big_to_real(n)))
            _ -> None
        ConstFloat(f) -> to match
            Integer(bits, signed, _) -> big_of_real(f) match
                Some(n) -> if fits(n, bits, signed) then Some(ConstInt(n)) else None
                None -> None
            Floating(_, _) -> Some(ConstFloat(f))
            _ -> None
        ConstBool(b) -> if to == Bool then Some(ConstBool(b)) else None
        ConstStr(s) -> if to == Str then Some(ConstStr(s)) else None
        ConstChar(_) -> None
end typed_conversion

private big_abs(n: BigInt) -> BigInt = if cmp(n, from_int(0)) < 0 then negate(n) else n

// Which type parameters the body was compiled against, where it was compiled against any.
//
// The mistake is at the call that asked while the sentence explaining why is at the declaration, so
// a report carrying only one of the two sends the reader to the wrong file. `Self` is named
// alongside the parameters rather than filtered out as the compiler's own word: in an inherited
// default body -- one text shared by every implementing type -- it is the whole of the answer.
private instantiation_note(cx: &Analyzer) -> string
    if cx.subst.is_empty() then return ""

    var names: Buf[string] = buf()

    for i in 0..<cx.subst.len()
        names.push(cx.subst.at(i).name)

    val sorted = sort_names(names)
    var out = " — where "

    for i in 0..<sorted.len()
        for j in 0..<cx.subst.len()
            if cx.subst.at(j).name == sorted.at(i)
                out = out + (if i > 0 then ", " else "") +
                      s"${sorted.at(i)} = ${type_show(cx.subst.at(j).ty)}"

    out
end instantiation_note
