module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.fs.is_file
import sysl.process.capture
import sysl.text.Search
import sysl.testing.skip

// **A box or a buffer of a type aligned beyond what `malloc` promises.**
//
// `malloc` promises two words -- sixteen bytes on a 64-bit machine (`target.sysl`'s
// `heap_boundary`). Under libc's pair, storage of a type asking for more is taken from
// `sysl.heap.alloc_aligned(size, align)` and given back through `sysl.heap.free_aligned(p)`, written
// over `posix_memalign` (or `_aligned_malloc` on Windows); its payload is laid after the header on
// the boundary (`emit_box.sysl`'s `heap_take`, `emit_arc.sysl`'s `box_pad`). A pair a manifest names
// is handed every block's boundary itself, `alloc(size, align)` and `free(p, size, align)`, so it
// needs nothing more; under libc's pair on a machine with no C library the program is refused
// (`tests_lic_libc_capability.sysl`). Found by the keel kernel (FINDINGS 20): a box of an
// `@align(4096)` struct landed at an address 88 past a page.

private aah_page() -> string = "@align(4096)\nstruct Page\n    e: [512]u64\n\n"

private aah_line() -> string = "@align(16)\nstruct Line\n    a: u64\n\n"

// -- a hosted program, libc's pair -------------------------------------------------------------------

@test("a hosted box of an @align(4096) struct is on its boundary and every access claims it")
aah_a_hosted_box_lands_on_the_boundary()
    if !enm_ready() then return

    val src = aah_page() + "main()\n    var t: Page\n    t.e[3] = 9\n    val b: &Page = t\n" +
        "    var u: Page = *b\n    print(usize(&*b) % 4096, u.e[3], b.e[3])\n"
    val ir = enm_ir(src)

    // The header's three words and the run of bytes that puts the payload on the page.
    assert(enm_says(ir, "%arc.Page = type { i64, ptr, i64, [4072 x i8], %struct.Page }"), ir)
    assert(enm_says(ir, "@sysl.heap.alloc_aligned(i64 %"), ir)
    assert(enm_says(ir, ", i64 4096)"), ir)
    assert(enm_says(ir, "define weak ptr @sysl.heap.alloc_aligned("), ir)
    assert(enm_says(ir, "call i32 @posix_memalign("), ir)
    assert(enm_says(ir, "ptr align 4096"), ir)

    // Its drop hook gives the block back through the aligned free, `free` underneath.
    assert(enm_says(ir, "define weak void @sysl.heap.free_aligned(ptr %p)"), ir)
    assert(enm_says(ir, "call void @sysl.heap.free_aligned(ptr %p)"), ir)
    assert_eq(enm_ran(src), "0 9 9\n")

@test("a task holding an @align(4096) local across a suspension finds it on its boundary resumed")
aah_a_task_frame_lands_on_the_boundary()
    if !enm_ready() then return

    val src = aah_page() + "async hold(n: u64) -> int\n    var t: Page\n    t.e[1] = n\n" +
        "    await yield_now()\n    val at = usize(&t) % 4096\n    t.e[2] = n + 1\n" +
        "    int(at) * 1000 + int(t.e[1]) * 10 + int(t.e[2])\n\nprint(block_on(hold(6)))\n"
    val ir = enm_ir(src)

    // The frame goes to the task hooks told its boundary, whose default hands a page to the aligned
    // allocation and gives it back the same way.
    assert(enm_says(ir, "call ptr @sysl_task_alloc(i64 %"), ir)
    assert(enm_says(ir, ", i64 4096)"), ir)
    assert(enm_says(ir, "call void @sysl_task_free(ptr %"), ir)
    assert(enm_says(ir, "define weak ptr @sysl_task_alloc(i64 %size, i64 %align)"), ir)
    assert(enm_says(ir, "call ptr @sysl.heap.alloc_aligned(i64 %size, i64 %align)"), ir)
    assert(enm_says(ir, "call void @sysl.heap.free_aligned(ptr %p)"), ir)
    assert_eq(enm_ran(src), "67\n")

@test("a task holding nothing over-aligned asks sysl_task_alloc on the word's boundary")
aah_an_ordinary_task_frame_is_unchanged()
    if !enm_ready() then return

    val src = "async inc(n: int) -> int\n    await yield_now()\n    n + 1\n\nprint(block_on(inc(41)))\n"
    val ir = enm_ir(src)

    assert(enm_says(ir, "call ptr @sysl_task_alloc("), ir)
    assert(enm_says(ir, ", i64 8)"), ir)
    assert(!enm_says(ir, ", i64 4096)"), ir)
    assert_eq(enm_ran(src), "42\n")

// -- Windows, read off the text -----------------------------------------------------------------------

// One source lowered for a named machine, with no library: what the module says about the heap.
private aah_lowered_for(text: string, target_name: string) -> string
    val t = target_named(target_name).unwrap()
    val done = typed_of_target(text, t)

    if !done.reported.is_empty() then return done.reported[0].diag.message

    val p = strip_tests(program_of(done, done.main_module))

    ir_print_module(codegen_with_gaps(p, t, check_escapes(done.an, p)).0)
end aah_lowered_for

@test("on Windows the aligned allocation is _aligned_malloc and _aligned_free")
aah_windows_defaults_to_aligned_malloc()
    val ir = aah_lowered_for(aah_page() + "keep(n: u64) -> u64\n    var t: Page\n    t.e[1] = n\n" +
        "    val b: &Page = t\n    b.e[1]\n", "x86_64-windows")

    assert(ir.contains("define weak ptr @sysl.heap.alloc_aligned(i64 %size, i64 %align)"), ir)
    assert(ir.contains("call ptr @_aligned_malloc(i64 %size, i64 %align)"), ir)
    assert(ir.contains("declare ptr @_aligned_malloc(i64, i64)"), ir)
    assert(ir.contains("define weak void @sysl.heap.free_aligned(ptr %p)"), ir)
    assert(ir.contains("call void @_aligned_free(ptr %p)"), ir)
    assert(ir.contains("declare void @_aligned_free(ptr)"), ir)
    assert(ir.contains("call void @sysl.heap.free_aligned(ptr %p)"), ir)
    assert(!ir.contains("posix_memalign"), ir)
    assert(unaligned_heap().is_none(), "Windows was refused")

@test("a hosted buffer of an @align(4096) struct puts every element on its boundary")
aah_a_hosted_buffer_lands_on_the_boundary()
    if !enm_ready() then return

    val src = aah_page() + "main()\n    var t: Page\n    t.e[1] = 4\n    val xs: []Page = [t, t, t]\n" +
        "    val a: *Page = &xs[0]\n    val c: *Page = &xs[2]\n" +
        "    print(usize(a) % 4096, usize(c) % 4096, xs[2].e[1], xs.len)\n"
    val ir = enm_ir(src)

    assert(enm_says(ir, "%arc.buf.Page = type { i64, ptr, i64, i64, [4064 x i8], [0 x %struct.Page] }"), ir)
    assert_eq(enm_ran(src), "0 0 4 3\n")

@test("a box of a type at malloc's boundary takes malloc, its payload still on its boundary")
aah_a_type_at_the_threshold_takes_the_pair()
    if !enm_ready() then return

    val src = aah_line() + "main()\n    var l: Line\n    l.a = 7\n    val b: &Line = l\n" +
        "    print(usize(&*b) % 16, b.a)\n"
    val ir = enm_ir(src)

    // Raised, so laid on its sixteen past the header -- the count alone, nothing weakening a line --
    // but sixteen is what malloc promises.
    assert(enm_says(ir, "%arc.Line = type { i64, [8 x i8], %struct.Line }"), ir)
    assert(enm_says(ir, "call ptr @malloc("), ir)
    assert(!enm_says(ir, "sysl.heap.alloc_aligned"), ir)
    assert(!enm_says(ir, "posix_memalign"), ir)
    assert_eq(enm_ran(src), "0 7\n")

@test("a program boxing nothing over-aligned names no aligned allocation")
aah_an_ordinary_box_is_unchanged()
    if !enm_ready() then return

    val src = "struct P\n    x: u64\n    y: u64\n\nmain()\n    val b: &P = P(1, 2)\n    print(b.x + b.y)\n"
    val ir = enm_ir(src)

    assert(enm_says(ir, "%arc.P = type { i64, %struct.P }"), ir)
    assert(!enm_says(ir, "sysl.heap.alloc_aligned"), ir)
    assert(!enm_says(ir, "sysl.heap.free_aligned"), ir)
    assert_eq(enm_ran(src), "3\n")

@test("a raised boundary behind the full header of a weakened box is padded past all three words")
aah_a_weakened_box_pads_past_the_full_header()
    if !enm_ready() then return

    val src = aah_line() + "main()\n    var l: Line\n    l.a = 7\n    val b: &Line = l\n" +
        "    val w: weak Line = b\n    print(usize(&*b) % 16, b.a)\n"
    val ir = enm_ir(src)

    // Laid on its sixteen past the header's 24.
    assert(enm_says(ir, "%arc.Line = type { i64, ptr, i64, [8 x i8], %struct.Line }"), ir)
    assert_eq(enm_ran(src), "0 7\n")

// -- a pair the manifest named -----------------------------------------------------------------------

// A hosted project whose heap is its own pair, over libc's aligned allocation.
private aah_own_pair() -> string =
    "package { name = \"own\", version = \"0.0.1\" }\nallocator {\n  alloc = \"own_alloc\"\n" +
    "  free  = \"own_free\"\n}\n"

private aah_pair_runtime() -> string =
    "extern \"free\" c_free(p: *u8)\n" +
    "extern \"posix_memalign\" c_memalign(out: **u8, align: usize, n: usize) -> int\n\n" +
    "@export(\"own_alloc\")\nown_alloc(n: usize, a: usize) -> *u8\n" +
    "    var p: *u8 = null\n    if c_memalign(&p, if a < 16 then 16 else a, n) != 0 then return null\n" +
    "    p\n\n" +
    "@export(\"own_free\")\nown_free(p: *u8, n: usize, a: usize) = c_free(p)\n\n"

private aah_project(program: string) -> string =
    lbr_tree(lbr_two("main.sysl", program, "package.hocon", aah_own_pair()))

// What a project's program prints, or what refused it.
private aah_ran(p: string) -> string = aah_ran_ending(p).0

// What a project's program prints, and whether it ended by exiting zero. A refused build and a
// program that could not be run both answer false.
private aah_ran_ending(p: string) -> (string, bool)
    val out = lbr_temp("sysl-aah-exe")
    val said = lbr_cli(["sysl", "build", "-o", s"$out/program", p])

    if said.0 != 0
        lbr_drop([out])
        return (s"refused: ${said.1}", false)
    end if

    val ran = capture(s"$out/program", [], "", [], true) match
        Ok(o) -> (o.text, o.status.ok())
        Err(_) -> ("the program that was built could not be run", false)

    lbr_drop([out])
    ran
end aah_ran_ending

@test("a manifest-named pair boxes an ordinary type through itself, told its size and boundary")
aah_a_named_pair_still_works()
    if !lbr_ready() then return

    val p = aah_project(aah_pair_runtime() +
        "struct P\n    x: u64\n\nmain()\n    val b: &P = P(41)\n    print(b.x + 1)\n")
    val ir = lbr_text(p, [])

    assert(ir.contains("call ptr @own_alloc(i64 %"), ir)
    assert(ir.contains("call void @own_free(ptr %"), ir)
    assert(ir.contains(", i64 8)"), ir)
    assert(!ir.contains("sysl.heap.alloc_aligned"), ir)
    assert(!ir.contains("arc.drop.plain"), ir)
    assert_eq(aah_ran(p), "42\n")
    lbr_drop([p])

@test("a box whose allocator answers null traps rather than being stored through")
aah_a_failed_box_allocation_traps()
    if !lbr_ready() then return

    val refusing = "@export(\"own_alloc\")\nown_alloc(n: usize, a: usize) -> *u8 = null\n\n" +
        "@export(\"own_free\")\nown_free(p: *u8, n: usize, a: usize) = ()\n\n"
    val p = aah_project(refusing +
        "struct P\n    x: u64\n\nmain()\n    print(\"before\")\n    val b: &P = P(41)\n    print(b.x + 1)\n")
    val ir = lbr_text(p, [])

    assert(ir.contains("call ptr @own_alloc("), ir)
    assert(ir.contains("icmp ne ptr"), ir)

    val ran = aah_ran_ending(p)
    val said = ran.0

    assert(!said.starts_with("refused: "), said)
    assert(!said.contains("42"), said)
    assert(!ran.1, "the program ended by exiting zero instead of trapping: " + said)
    lbr_drop([p])

@test("a manifest-named pair is handed an over-aligned box's boundary and needs nothing more")
aah_a_named_pair_takes_the_boundary()
    if !lbr_ready() then return

    val p = aah_project(aah_pair_runtime() + aah_page() +
        "main()\n    var t: Page\n    t.e[2] = 5\n    val b: &Page = t\n" +
        "    print(usize(&*b) % 4096, b.e[2])\n")
    val ir = lbr_text(p, [])

    assert(ir.contains(", i64 4096)"), ir)
    assert(ir.contains("call void @own_free(ptr %"), ir)
    assert(!ir.contains("sysl.heap.alloc_aligned"), ir)
    assert_eq(aah_ran(p), "0 5\n")
    lbr_drop([p])

@test("a manifest-named pair written in the old one-word shapes is refused at its definitions")
aah_an_old_shaped_pair_is_refused()
    if !lbr_ready() then return

    val old = "extern \"malloc\" c_malloc(n: usize) -> *u8\nextern \"free\" c_free(p: *u8)\n\n" +
        "@export(\"own_alloc\")\nown_alloc(n: usize) -> *u8 = c_malloc(n)\n\n" +
        "@export(\"own_free\")\nown_free(p: *u8) = c_free(p)\n\n"
    val p = aah_project(old + "struct P\n    x: u64\n\nmain()\n    val b: &P = P(41)\n    print(b.x + 1)\n")
    val said = aah_ran(p)

    assert(said.starts_with("refused: "), said)
    assert(said.contains("'own_alloc' is exported as 'own_alloc', the half of the program's heap taking " +
        "every block, which is called as 'alloc(size: usize, align: usize) -> *u8' — answering a block " +
        "of 'size' bytes on 'align'. This one takes 1 parameter"), said)
    assert(said.contains("'own_free' is exported as 'own_free', the half of the program's heap giving " +
        "back every block, which is called as 'free(p: *u8, size: usize, align: usize)' — told the size " +
        "and boundary the block was taken with. This one takes 1 parameter"), said)
    lbr_drop([p])

@test("a free half taking the size but not the boundary is refused too")
aah_a_free_without_the_boundary_is_refused()
    if !lbr_ready() then return

    val half = "extern \"free\" c_free(p: *u8)\n" +
        "extern \"posix_memalign\" c_memalign(out: **u8, align: usize, n: usize) -> int\n\n" +
        "@export(\"own_alloc\")\nown_alloc(n: usize, a: usize) -> *u8\n" +
        "    var p: *u8 = null\n    if c_memalign(&p, 16, n) != 0 then return null\n    p\n\n" +
        "@export(\"own_free\")\nown_free(p: *u8, n: usize) = c_free(p)\n\n"
    val p = aah_project(half + "main()\n    val s = \"a\" + \"b\"\n    print(s)\n")
    val said = aah_ran(p)

    assert(said.starts_with("refused: "), said)
    assert(said.contains("This one takes 2 parameters"), said)
    assert(!said.contains("'own_alloc' is exported"), said)
    lbr_drop([p])

// -- a freestanding image ----------------------------------------------------------------------------

private val aah_target: string = "aarch64-freestanding"
private val aah_nm: string = "/opt/homebrew/opt/llvm/bin/llvm-nm"

private val aah_script: string =
    "ENTRY(kstart)\nSECTIONS\n{\n    . = 0x40080000;\n    .text : { KEEP(*(.text.boot)) *(.text .text.*) }\n" +
    "    .rodata : { *(.rodata .rodata.*) }\n    .data : { *(.data .data.*) }\n" +
    "    .bss (NOLOAD) : { *(.bss .bss.*) *(COMMON) }\n}\n"

private val aah_manifest: string =
    "package { name = \"img\", version = \"0.0.1\" }\n" +
    "allocator {\n  alloc = \"img_alloc\"\n  free  = \"img_free\"\n}\n" +
    s"targets {\n  $aah_target {\n    linker_script = \"link.ld\"\n    entry = \"kstart\"\n  }\n}\n"

// The image's start, its heap and the memory functions LLVM calls with no C library under it.
private val aah_runtime: string = raw"""
    @export("kstart")
    kstart() -> never
        val n = run()

        loop
            ()

    @export("img_alloc")
    img_alloc(n: usize, a: usize) -> *u8 = null

    @export("img_free")
    img_free(p: *u8, n: usize, a: usize) = ()

    @export("memset")
    mem_set(dst: *u8, c: int, n: usize) -> *u8
        val d: *volatile u8 = ptr_cast(dst)

        for i in 0..<n do d[i] = u8(c)

        dst

    @export("memcpy")
    mem_copy(dst: *u8, src: *u8, n: usize) -> *u8
        val d: *volatile u8 = ptr_cast(dst)

        for i in 0..<n do d[i] = src[i]

        dst

    @export("memmove")
    mem_move(dst: *u8, src: *u8, n: usize) -> *u8 = mem_copy(dst, src, n)

    @export("memcmp")
    mem_compare(a: *u8, b: *u8, n: usize) -> int = 0
    """

// What the image runs: a box of a page-sized struct, aligned to the page or not.
private aah_run(aligned: bool) -> string = (if aligned then "@align(4096)\n" else "") + raw"""
    struct Page
        e: [512]u64

    run() -> int
        var t: Page
        t.e[1] = 3
        val b: &Page = t

        int(b.e[1])
    end run
    """

// A task holding a page-aligned local across a suspension, driven from the image.
private val aah_async_run: string = raw"""
    @align(4096)
    struct Page
        e: [512]u64

    async hold(n: u64) -> int
        var t: Page
        t.e[1] = n
        await yield_now()
        int(t.e[1])

    run() -> int = block_on(hold(3))
    """

private aah_image(program: string) -> string
    var files = lbr_two("main.sysl", program, "package.hocon", aah_manifest)

    files.push(("link.ld", aah_script))
    lbr_tree(files)
end aah_image

private aah_build(p: string) -> ((int, string), string)
    val out = lbr_temp("sysl-aah-elf")

    // Unoptimized, so a hook the program calls stays a call: a freestanding image keeps only the
    // exports its entry reaches, and one inlined into its caller is reached by nothing.
    (lbr_cli(["sysl", "build", "-O0", "--target", aah_target, "-o", s"$out/img.elf", p]), out)
end aah_build

private aah_link_ready() -> bool
    if !lbr_ready() then return false

    val lld = capture("ld.lld", ["--version"], "", [], true) match
        Ok(o) -> o.status.ok()
        Err(_) -> false

    if !lld then skip("ld.lld is not installed, so no image can be linked")
    if !is_file(aah_nm) then skip(s"there is no llvm-nm at $aah_nm to read the image")

    true
end aah_link_ready

// The image's symbols, as llvm-nm lists them.
private aah_listing(out: string) -> string = capture(aah_nm, [s"$out/img.elf"], "", [], true) match
    Ok(o) -> o.text
    Err(_) -> "llvm-nm could not be run"

@test("a freestanding image's own pair is handed a page-aligned box's boundary, and the image links")
aah_freestanding_pair_takes_the_boundary()
    if !aah_link_ready() then return

    val p = aah_image(aah_runtime + aah_run(true))
    val (said, out) = aah_build(p)

    assert(said.0 == 0, said.1)

    val listing = aah_listing(out)

    assert(listing.contains(" T img_alloc"), listing)
    assert(!listing.contains("posix_memalign"), listing)
    assert(!listing.contains("sysl.heap"), listing)

    val ir = lbr_cli(["sysl", "emit-llvm", "--target", aah_target, p])

    assert(ir.1.contains("@img_alloc(i64 %"), ir.1)
    assert(ir.1.contains(", i64 4096)"), ir.1)
    lbr_drop([p, out])

@test("a freestanding task holding a page-aligned local hands its frame's boundary to the image's pair")
aah_freestanding_task_frame_takes_the_boundary()
    if !aah_link_ready() then return

    val p = aah_image(aah_runtime + aah_async_run)
    val (said, out) = aah_build(p)

    assert(said.0 == 0, said.1)

    val ir = lbr_cli(["sysl", "emit-llvm", "--target", aah_target, p])

    assert(ir.1.contains("call ptr @sysl_task_alloc(i64 %"), ir.1)
    assert(ir.1.contains("call ptr @img_alloc(i64 %size, i64 %align)"), ir.1)
    assert(ir.1.contains("call void @img_free(ptr %p, i64 %size, i64 %align)"), ir.1)
    lbr_drop([p, out])

@test("a freestanding image boxing nothing over-aligned names no aligned allocation")
aah_freestanding_without_over_aligned_storage_is_unchanged()
    if !aah_link_ready() then return

    val p = aah_image(aah_runtime + aah_run(false))
    val (said, out) = aah_build(p)

    assert(said.0 == 0, said.1)

    val listing = aah_listing(out)

    assert(!listing.contains("sysl.heap"), listing)
    assert(!listing.contains("posix_memalign"), listing)
    lbr_drop([p, out])
