// The lock example of the design (§ 11) with '@unique' and the 'Drop' taken out and the unlock
// written by hand: checks that everything else in it is sysl that compiles today.
import sysl.sync.SpinLock

struct Lock[T]
    raw: SpinLock
    value: T

    lock(*self) -> Guard[T]
        self.raw.lock()
        Guard(&self.raw, &self.value)

struct Guard[T]
    raw: *SpinLock
    data: *T

    get(self) -> ref T = *self.data

var counter = Lock(SpinLock(0), 0)

@no_alloc
bump() -> int
    val g = counter.lock()
    ref n = g.get()

    n += 1
    g.raw.unlock()
    n

main()
    print(bump(), bump())
