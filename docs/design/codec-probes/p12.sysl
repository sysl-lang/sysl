// P12: a derive member with no receiver (a decoder builds a value; it has none to start from)
trait Source
    next(*self) -> int

trait Decode
    decode(s: *Source) -> Self

    derive[T] decode(s: *Source) -> T
        var out: T

        for const f in T::Fields
            out.(f) = s.next()

        out

struct Count
    n: int

impl Source for Count
    next(*self) -> int
        self.n += 1
        self.n

struct P derives Decode
    x: int
    y: int

var c = Count(0)
val p = P.decode(&c)
print(p.x, p.y)
