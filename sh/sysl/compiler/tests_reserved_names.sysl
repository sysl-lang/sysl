rsv_fn_type_parameters()
    if !rsv_ready() then return

    rsv_refused("then[T](x: T) -> T = x\nprint(1)\n", "then", "a function's name", 1, 1)

@test("every declaration-leading word as a function's name is refused at the word")
rsv_fn_each_leading_word()
    if !rsv_ready() then return

    val words = rsv_leading_words()

    for i in 0..<words.len
        rsv_refused(s"${words[i]}() -> int = 1\nprint(1)\n", words[i], "a function's name", 1, 1)

@test("a declaration-leading word as a function with parameters and a block body")
rsv_fn_leading_word_block_body()
    if !rsv_ready() then return

    rsv_refused("print(1)\nstruct(x: int) -> int\n    x\n", "struct", "a function's name", 2, 1)

@test("a declaration-leading word as a function with type parameters")
rsv_fn_leading_word_type_parameters()
    if !rsv_ready() then return

    rsv_refused("type[T](x: T) -> T = x\nprint(1)\n", "type", "a function's name", 1, 1)

