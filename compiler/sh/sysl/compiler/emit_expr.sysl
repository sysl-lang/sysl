module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.math.bigint.{BigInt, from_int, sub as big_sub}
import sysl.math.decimal.{Decimal, rescale, Rounding}

// **One expression, lowered.** The register or immediate holding its value comes back; whatever it
// had to do to get there has been emitted into the block that is open.
//
// A form nothing here lowers yet records a gap and answers `undef`, and the function it was reached
// from is left out of the module altogether -- so a partial lowering is a smaller module rather than
// a different one.

gen_expr(e: *Emit, x: TExpr) -> Val = *x.kind match
    TIntLit(v, _) -> VInt(v)
    TBoolLit(b) -> VInt(from_int(if b then 1 else 0))
    TUnitLit -> VNothing
    TNullLit(ty) -> zero_of(e, ty)
    TZero(ty) -> zero_of(e, ty)
    TCStrLit(s) -> string_global(e, s)

    // Three words naming bytes that are never freed: the owner is null, so counting the value costs
    // nothing at run time and there is nothing for the statement around it to release.
    TStrLit(s) -> string_value(e, s)

    // An embedded file is a constant on the same terms: its owner is null.
    TEmbed(file, bytes, align) -> embed_const(e, file, bytes, align)

    // Rendering a value. A `string` is itself and everything else lands in a fresh buffer, which is
    // why only the second case is a temporary the statement owns.
    TStr(arg) ->
        val v = gen_str(e, arg)

        if underlying(texpr_type(arg)) == Str then v else own_temp(e, v, Str)

    TFormat(arg, spec, counts) -> own_temp(e, gen_format(e, arg, spec, counts), Str)
    TRender(value, method, spec, slot) -> gen_render(e, value, method, spec, slot)
    TFromBytes(arg) -> gen_from_bytes(e, arg)

    // A string and a `[]u8` are the same three words, so looking at one as the other is nothing at
    // all -- the guarantee that was given up is the analyzer's business, not the machine's. Dropping
    // the ability to write is a fact about the type in exactly the same way.
    TBytes(receiver) -> gen_expr(e, receiver)
    TConstView(arg) -> gen_expr(e, arg)

    // The raw tier's other direction: the same three words taken as a string, sharing the slice's
    // owner. Nothing to emit, exactly as for `s.bytes` -- a string that is kept takes its own share
    // of that owner where it is stored, as any view does.
    TStrView(arg) -> gen_expr(e, arg)

    // A float constant is the `double` bit pattern whatever the type is, so a narrower one is that
    // constant rounded down to it -- which costs nothing at run time.
    TFloatLit(bits, ty) ->
        if ty == real_type() then VFloat(bits)
        else
            val r = fresh_reg(e)

            emit(e, InCast(r, CastFPTrunc, LFloat(64, false), VFloat(bits), lty(e, ty)))
            r

    // A constrained operand converts from its base representation.
    TCast(operand, ty) -> convert(e, underlying(texpr_type(operand)), ty, gen_expr(e, operand))

    // Nothing is stored for a zero-sized binding, so there is nothing to read back.
    TLoad(name, ty) ->
        if zero_sized(ty) then return VNothing

        val r = fresh_reg(e)

        emit(e, InLoad(r, lty(e, ty), local_slot(e, name), ref_access(e, name, ty), None))
        r

    // `result` in a postcondition is the value about to be returned, which is a register the return
    // is already holding rather than anything read back.
    TResult(_) -> e.result_ssa match
        Some(v) -> v
        None -> gap_at(e, "'result' outside a postcondition")

    TOld(index, ty) ->
        val r = fresh_reg(e)

        emit(e, InLoad(r, lty(e, ty), VReg(s"old.$index.addr"), AccPlain, None))
        r

    TGlobal(symbol, ty, _) ->
        val r = fresh_reg(e)

        emit(e, InLoad(r, lty(e, ty), VGlobal(symbol), access_of(ty), None))
        r

    TDeref(operand, ty) ->
        val p = payload_addr(e, operand)
        val r = fresh_reg(e)

        emit(e, InLoad(r, lty(e, ty), p, place_access(e, x), None))
        r

    TAddrOf(place, _) -> address(e, place)

    // `o::Id` -- the first word of the table the object points at. The table is a constant global, so
    // this is a load from read-only storage and nothing else.
    TTypeId(receiver, _) ->
        val obj = gen_expr(e, receiver)
        val table = fresh_reg(e)

        emit(e, InExtract(table, l_fat(), obj, index_list(0)))

        val r = fresh_reg(e)

        emit(e, InLoad(r, word_lty(e), table, AccPlain, None))
        r

    // `&value` -- the storage a computed value has no address for. The slot is an ordinary alloca,
    // so it belongs to the **frame** rather than to the block that wrote it, and the count it takes
    // is the one a `var`'s slot takes: registered with the scope being emitted, released where that
    // scope ends. Everything about the pointer afterwards is what a `*T` always is.
    TTempAddr(value, _) ->
        val slot = alloca(e, fresh_reg(e), lty_of(e, value))

        gen_into(e, slot, value)
        own_at(e, slot, texpr_type(value))
        slot

    TField(receiver, index, ty) -> gen_field(e, x, receiver, index, ty)

    TIndex(receiver, index, ty) ->
        val p = element_addr(e, receiver, index, x.span)
        val r = fresh_reg(e)

        emit(e, InLoad(r, lty(e, ty), p, place_access(e, x), None))
        r

    TLen(receiver, _) -> gen_len(e, receiver)

    TSeq(exprs) ->
        for item in exprs
            gen_expr(e, item)

        VNothing

    TBinary(op, l, r, ty) -> gen_binary(e, op, l, r, ty)
    TUnary(op, operand, ty) -> gen_unary(e, op, operand, ty)
    TLogical(op, l, r) -> gen_logical(e, op, l, r)
    TCompare(operands, cmps) -> gen_compare(e, operands, cmps)

    TStore(place, value, ty) -> gen_store(e, place, value, ty)
    TUpdate(place, op, value, ty, dispatch, check) ->
        gen_update(e, place, op, value, ty, dispatch, check)
    TIncDec(place, op, pre, ty, check) -> gen_inc_dec(e, place, op, pre, ty, check)

    TCall(name, args, ty, _) ->
        if e.tail_target != "" && is_tail_call(e.tail_calls, x.span) then gen_tail_self_call(e, args)
        else gen_call(e, name, args, ty)
    TAtomic(op, addr, ops, ordering, at, ty) -> gen_atomic(e, op, addr, ops, ordering, at, ty)
    TFence(ordering) -> gen_fence(e, ordering)
    TSlots(op, args, elem, ty) -> gen_slots(e, op, args, elem, ty)
    TSysOp(op, name, args) -> gen_sysop(e, op, name, args)

    // **A call through a `*extern` pointer is a foreign call whose callee is a register.** The
    // convention is the C one on both sides -- the value came from a `&f` or from C itself and may
    // only hold something C can call -- so nothing about the argument classification differs from a
    // call to a named `extern`, and the two go through one function. A driver whose transport is a
    // struct of function pointers is the shape that wants it.
    TCallPtr(callee, args, _, ty) ->
        gen_foreign_call(e, foreign_result(e, ty), gen_expr(e, callee), args, ty)

    // An address is the C-callable entry rather than the definition, since a `*extern` may only
    // hold something C can call.
    TFuncAddr(_, entry, _) -> VGlobal(entry_of(e, entry))

    TBlockExpr(b) ->
        if zero_sized(b.ty)
            gen_block_void(e, b)
            VNothing
        else gen_block_value(e, b)

    TIf(cond, then_block, else_block, ty) -> gen_if(e, cond, then_block, else_block, ty)
    TWhile(cond, body, else_block, ty) -> gen_while(e, cond, body, else_block, ty)
    TLoop(body, ty) -> gen_loop(e, body, ty)
    TFor(name, var_ty, lo, hi, inclusive, body, else_block, ty) ->
        gen_for(e, name, var_ty, lo, hi, inclusive, body, else_block, ty)
    TCFor(init, cond, step, body, else_block, ty) ->
        gen_cfor(e, init, cond, step, body, else_block, ty)
    TForEach(name, elem_ty, seq, body, else_block, ty) ->
        gen_for_each(e, name, elem_ty, seq, body, else_block, ty)
    TIterate(cursor, cursor_ty, init, next, bind, body, else_block, ty) ->
        gen_iterate(e, cursor, cursor_ty, init, next, bind, body, else_block, ty)
    TDoWhile(body, cond, else_block, ty) -> gen_do_while(e, body, cond, else_block, ty)

    // The tail walk is the ABI's, so all three are LLVM's own: two intrinsic calls and the one
    // instruction whose lowering every back end supplies for it.
    TVaStart(ap) -> gen_va_intrinsic(e, llvm_va_start(), ap)
    TVaEnd(ap) -> gen_va_intrinsic(e, llvm_va_end(), ap)

    TVaArg(ap, ty) ->
        val r = fresh_reg(e)

        emit(e, InVaArg(r, gen_expr(e, ap), lty(e, ty)))
        r

    // The one place the C ABI is not the same on every machine, so the one place codegen reads the
    // target. All three answers are a `ptr`, and all three start from the address of the walk -- what
    // differs is whether the callee is handed that address, the value in it, or the address of a copy
    // of it.
    TVaPass(ap) ->
        val addr = gen_expr(e, ap)

        e.target.va_list match
            VaAddress -> addr
            VaLoaded ->
                val r = fresh_reg(e)

                emit(e, InLoad(r, LPtr, addr, AccPlain, None))
                r
            VaCopied ->
                val copy = alloca(e, fresh_reg(e), lty(e, VaList))

                emit_memcpy(e, copy, addr, e.target.va_list_bytes, 8)
                copy

    TVaCopy(dst, src) ->
        e.uses_va_copy = true

        // Both addresses are produced before either is used, so a copy onto a list read out of the
        // same expression cannot see a half-written destination.
        val d = gen_expr(e, dst)
        val s = gen_expr(e, src)

        var args: Buf[IrArg] = buf()

        args.push(ir_arg(LPtr, d))
        args.push(ir_arg(LPtr, s))
        emit(e, InCall(None, LVoid, VGlobal(llvm_va_copy()), args, no_ir_attrs(), None,
                       no_fast_math(), false))
        VNothing

    TQuantifier(universal, name, var_ty, lo, hi, inclusive, pred) ->
        gen_quantifier(e, universal, name, var_ty, lo, hi, inclusive, pred)
    TCheckedLoop(slot, var_ty, loop_expr) -> gen_checked_loop(e, slot, var_ty, loop_expr)

    TConstrainedCheck(value, target) ->
        val v = gen_expr(e, value)

        emit_constraint_checks(e, v, target)
        v

    TConstrainedValid(value, c) -> gen_constrained_valid(e, value, c)
    TConstrainedStep(value, c, up, _) -> gen_constrained_step(e, value, c, up)

    // A reference is made by putting the value on the heap, and the expression owns the count it
    // comes back with.
    TBox(value, ref_ty) -> gen_box(e, value, ref_ty)

    // An array literal is an `insertvalue` chain over the zero, which is what makes a literal of
    // constants fold to one in the object file. A large one is built in storage instead and read
    // back, since an aggregate that crosses by address has no business being a register at all.
    TArrayLit(elems, array_ty) ->
        if e.layout.indirect(array_ty) then return through_slot(e, x)

        // **Every element is produced before any of them is laid in.** The two phases are what the
        // register numbering says: an element that emits anything of its own would otherwise have
        // its instructions interleaved with the chain that collects them.
        var vals: Buf[Val] = buf()

        for item in elems
            vals.push(gen_expr(e, item))

        var acc: Val = VZero

        for i in 0..<vals.len()
            val r = fresh_reg(e)

            emit(e, InInsert(r, lty(e, array_ty), acc,
                             lty(e, element(array_ty).unwrap_or(int_type())), vals.at(i),
                             index_list(int(i))))
            acc = r

        acc

    // **Every element is a copy of one evaluation**, so the value is generated once, above the loop
    // -- and generated even where there are no elements, because one evaluation is what the form
    // promises and an empty array does not take that back.
    //
    // It is built in storage rather than as a chain of `insertvalue`, whatever its width: a loop is
    // what makes `[0; 4096]` four instructions instead of four thousand, and there is no length at
    // which the two forms would want to swap.
    TArrayFill(value, array_ty) ->
        if array_len_of(array_ty) == 0
            gen_expr(e, value)
            return VZero
        end if

        val slot = alloca(e, fresh_reg(e), lty(e, array_ty))
        val v = gen_expr(e, value)

        fill_array(e, slot, array_ty, v)

        val r = fresh_reg(e)

        emit(e, InLoad(r, lty(e, array_ty), slot, AccPlain, None))
        r

    // The same two forms, sized and owned rather than laid out in a frame. Each element the buffer
    // takes is a share of its own -- the box holds them until its hook lets them go -- so the value
    // that lands in one is retained as it is stored, exactly as a slot that binds an array is.
    //
    // An empty view has no storage to make, so it is the zero value of its own representation:
    // `{owner = null, data = null, len = 0}`. It is not owned either -- there is no box for a
    // release to let go of, and a null owner is what a view that owns nothing already carries.
    TBufLit(elems, slice_ty) -> gen_buf_lit(e, elems, slice_ty)

    // The value is generated once, above the loop, which is what makes `[tick(); n]` one call whose
    // result lands in n places -- and the reason the count may be zero and the call still happen.
    TBufFill(value, count, slice_ty) ->
        val elem = element(slice_ty).unwrap_or(int_type())
        val v = gen_expr(e, value)
        val n = widen_index(e, count, x.span, BoundsCountTooWide)
        val made = gen_buffer(e, elem, n)

        fill_elements(e, elem, made.1, n, v)
        buffer_view(e, slice_ty, made.0, made.1, n)

    // **A view of some of what a place holds.** A whole temporary array whose view *escapes* is the
    // one case that is not a narrowing: the value the frame just computed is written into a buffer
    // instead of into the slot it would otherwise have had, and the view counts against that buffer.
    // The two literal forms are the same case done better -- built straight into the buffer rather
    // than produced and copied -- and everything else has no such form, so the value is made and
    // moved.
    TSlice(base, lo, hi, inclusive, slice_ty) ->
        if lo.is_none() && hi.is_none() && is_promoted_temp(e, x.span)
            return gen_promoted_slice(e, base, slice_ty)

        gen_slice(e, base, lo, hi, inclusive, slice_ty, x.span)

    TTry(operand, ok, fail, ret_enum, ret_fail, _, convert) ->
        gen_try(e, operand, ok, fail, ret_enum, ret_fail, convert)

    // The task forms (`emit_async.sysl`).
    TAwait(operand, ty) -> gen_await(e, operand, ty)
    TBlockOn(operand, ty) -> gen_block_on(e, operand, ty)
    TYieldNow -> gen_yield_now(e)
    TStep(task, wake) -> gen_step(e, task, wake)
    TPark(register) -> gen_park(e, register)

    TErase(operand, vtable, _) -> gen_erase(e, operand, vtable)
    TVCall(receiver, slot, args, ty, _) -> gen_vcall(e, receiver, slot, args, ty)

    TDowngrade(value, weak_ty) -> gen_downgrade(e, value, weak_ty)
    TUpgrade(value, opt_ty, some, none) -> gen_upgrade(e, value, opt_ty, some, none)
    TEnumAttr(kind, en, arg, _) -> gen_enum_attr(e, kind, en, arg)
    TIntOp(op, operand, amount, width, ty) -> gen_int_op(e, op, operand, amount, width, ty)

    // A large one is built where it is going to live and read back out only because this caller
    // asked for a value -- the same rule a large array literal is under, and for the same reason: an
    // aggregate that crosses by address has no business being a register. A simple enum is an
    // integer however many variants it has, so the rule never reaches one.
    TEnumNew(enum_ty, variant, args) ->
        if e.layout.indirect(enum_ty) then return through_slot(e, x)

        gen_enum_new(e, enum_ty, variant, args)

    TEnumFromInt(value, en) -> gen_enum_from_int(e, value, en)

    TEnumTry(value, en, opt_ty, some, none) -> gen_enum_try(e, value, en, opt_ty, some, none)

    TStructNew(decl, args) ->
        if e.layout.indirect(Struct(decl)) then return through_slot(e, x)

        gen_struct_new(e, decl, args)

    TStructInvCheck(value, decl, inv_fn) ->
        val v = gen_expr(e, value)

        emit_inv_check(e, v, decl, inv_fn)
        v

    // The write or the call runs first, yielding the value the expression is, and then the struct it
    // could have changed is re-read so the invariant sees the new fields.
    TRecheck(after, recv, decl, inv_fn) ->
        val v = gen_expr(e, after)

        emit_inv_check(e, gen_expr(e, recv), decl, inv_fn)
        v
    TMatch(scrutinee, arms, ty) -> gen_match(e, scrutinee, arms, ty)

    TVectorLit(lanes, vec_ty) -> gen_vector_lit(e, lanes, vec_ty)
    TSplat(value, vec_ty) -> gen_splat(e, value, vec_ty)
    TLane(receiver, lane, _) -> gen_lane(e, receiver, lane)
    TVecCompare(op, l, r, _) -> gen_vec_compare(e, op, l, r)
    TSelect(mask, when_true, when_false, ty) -> gen_select(e, mask, when_true, when_false, ty)
    TReduce(op, receiver, ty) -> gen_reduce(e, op, receiver, ty)
    TVecLoad(receiver, index, vec_ty) -> gen_vec_load(e, receiver, index, vec_ty, x.span)
    TVecStore(receiver, index, value) -> gen_vec_store(e, receiver, index, value, x.span)

    _ -> gap_at(e, texpr_kind_name(x))

// One field of a bitfield struct lifted out of its container, and nothing more: an enum field's bits
// are not held to its variants here. `gen_field` holds them; `E.try(s.field)` answers instead.
bitfield_field_bits(e: *Emit, receiver: TExpr, index: int, ranges: Buf[BitRange]) -> Val
    val rty = texpr_type(receiver)
    val acc = access_of(place_ty(receiver))
    val ct = container_lty(ranges)
    val at_address = has_address(receiver) && (e.layout.indirect(rty) || volatile_in(place_ty(receiver)))

    val c = container_read(e, receiver, rty, ct, acc, at_address)

    val s = underlying(rty) match
        Struct(d) -> d.slot(usize(index))
        _ -> usize(index)

    read_bits(e, ranges, ranges.at(s), c)
end bitfield_field_bits

// A field read.
//
// A **bitfield** is read out of its container, and the container is reached the way the *receiver*
// is: at its address where it has one, so that a field of a `volatile` register block is one
// volatile load of the whole register -- and out of the value otherwise.
//
// A register is reached at its own address, because the ordinary lowering would read the whole block
// to get at one field of it -- and reading a register block is not a way of reading one register. So
// is a field of a **large** struct, for a reason that is arithmetic rather than hardware: lifting one
// field out of a value means producing the whole value first.
private gen_field(e: *Emit, x: TExpr, receiver: TExpr, index: int, ty: Type) -> Val
    if zero_sized(ty)
        gen_expr(e, receiver)
        return VNothing

    val rty = texpr_type(receiver)

    bitfield_ranges_of(rty) match
        Some(ranges) ->
            val bits = bitfield_field_bits(e, receiver, index, ranges)

            // An enum field is bits nothing has checked, so it is held to its variants here.
            check_variant(e, ty, bits, x.span)
            return bits
        None -> ()

    if volatile_in(place_ty(x)) && has_address(receiver)
        val p = address(e, x)
        val r = fresh_reg(e)

        emit(e, InLoad(r, lty(e, ty), p, AccVolatile, None))
        return r

    if e.layout.indirect(rty) && has_address(receiver)
        val p = address(e, x)
        val r = fresh_reg(e)

        emit(e, InLoad(r, lty(e, ty), p, AccPlain, None))
        return r

    val v = gen_expr(e, receiver)
    val r = fresh_reg(e)

    emit(e, InExtract(r, lty(e, rty), v, index_list(field_index_of(e, rty, index))))
    r
end gen_field

private container_read(e: *Emit, receiver: TExpr, rty: Type, ct: LType, acc: IrAccess,
                       at_address: bool) -> Val
    if at_address then return loaded_container(e, receiver, ct, acc)

    extracted_container(e, receiver, rty)
end container_read

private loaded_container(e: *Emit, receiver: TExpr, ct: LType, acc: IrAccess) -> Val
    val p = address(e, receiver)
    val t = fresh_reg(e)

    emit(e, InLoad(t, ct, p, acc, None))
    t
end loaded_container

private extracted_container(e: *Emit, receiver: TExpr, rty: Type) -> Val
    val rv = gen_expr(e, receiver)
    val t = fresh_reg(e)

    emit(e, InExtract(t, lty(e, rty), rv, index_list(0)))
    t
end extracted_container

// Whether a node names storage rather than a value, which is what says `address` can walk to it.
has_address(x: TExpr) -> bool = *x.kind match
    TLoad(_, _) -> true
    TGlobal(_, _, _) -> true
    TDeref(_, _) -> true
    TField(receiver, _, _) -> has_address(receiver)
    TIndex(_, _, _) -> true
    _ -> false

// How many elements something has. An array's length is its type's, so the receiver is evaluated for
// its effects and the constant answered.
private gen_len(e: *Emit, receiver: TExpr) -> Val = underlying(texpr_type(receiver)) match
    Array(n, _) ->
        gen_expr(e, receiver)
        VInt(from_int(long(n)))
    Slice(_, _) -> view_len(e, receiver)
    Str -> view_len(e, receiver)
    other -> gap_at(e, s"length of ${type_show(other)}")

private gen_buf_lit(e: *Emit, elems: Buf[TExpr], slice_ty: Type) -> Val
    if elems.is_empty() then return VZero

    val elem = element(slice_ty).unwrap_or(int_type())

    var vals: Buf[Val] = buf()

    for item in elems
        vals.push(gen_expr(e, item))

    val n = VInt(from_int(long(vals.len())))
    val made = gen_buffer(e, elem, n)

    for i in 0..<vals.len()
        retain_value(e, elem, vals.at(i))

        val ep = fresh_reg(e)

        var idx: Buf[IrArg] = buf()

        idx.push(ir_arg(word_lty(e), VInt(from_int(long(i)))))
        emit(e, InGep(ep, lty(e, elem), made.1, idx))
        emit(e, InStore(lty(e, elem), vals.at(i), ep, AccPlain, None))

    buffer_view(e, slice_ty, made.0, made.1, n)
end gen_buf_lit

// A whole temporary array viewed where the view **escapes**: the storage is the buffer form's rather
// than the frame's. Everything else about the node is unchanged -- it is the same elements at the
// same slice type, laid somewhere that outlives the frame.
//
// The two literal forms are built straight into the buffer rather than produced and copied. Any
// other whole array has no such form, so the value the frame just computed is written into a buffer
// instead of into the slot it would otherwise have had -- the same three steps a promoted
// *declaration* takes, with the retain that path takes and for the same reason: the value is still
// the statement's to release, and the buffer is a second holder of whatever it counts.
private gen_promoted_slice(e: *Emit, base: TExpr, slice_ty: Type) -> Val
    *base.kind match
        TArrayLit(elems, _) -> return gen_buf_lit(e, elems, slice_ty)
        TArrayFill(value, array_ty) ->
            val elem = element(slice_ty).unwrap_or(int_type())
            val v = gen_expr(e, value)
            val n = VInt(from_int(long(array_len_of(array_ty))))
            val made = gen_buffer(e, elem, n)

            fill_elements(e, elem, made.1, n, v)
            return buffer_view(e, slice_ty, made.0, made.1, n)
        _ -> ()

    val base_ty = texpr_type(base)
    val elem = element(base_ty).unwrap_or(int_type())
    val n = VInt(from_int(long(array_len_of(base_ty))))
    val v = gen_expr(e, base)
    val made = gen_buffer(e, elem, n)

    retain_value(e, base_ty, v)
    emit(e, InStore(lty(e, base_ty), v, made.1, AccPlain, None))
    buffer_view(e, slice_ty, made.0, made.1, n)
end gen_promoted_slice

private array_len_of(ty: Type) -> int = underlying(ty) match
    Array(n, _) -> n
    _ -> 0

private view_len(e: *Emit, receiver: TExpr) -> Val
    val wty = lty(e, texpr_type(receiver))
    val v = gen_expr(e, receiver)
    val r = fresh_reg(e)

    emit(e, InExtract(r, wty, v, index_list(2)))
    r
end view_len

// -- arithmetic ---------------------------------------------------------------------------------

private gen_binary(e: *Emit, op: string, l: TExpr, r: TExpr, ty: Type) -> Val
    if underlying(ty) == Str then
        return own_temp(e, str_concat(e, gen_expr(e, l), gen_expr(e, r)), Str)

    val lt = underlying(texpr_type(l))

    lt match
        Ptr(_) ->
            if op == "-" then return gen_ptr_diff(e, l, r, lt)
        _ -> ()

    val bt = lt
    val lv = gen_expr(e, l)
    val rv0 = gen_expr(e, r)

    // A fixed-point operation reads both operands' formats and the result's: a product or a quotient
    // may mix formats and be given a third, and a `wrapping` type's arithmetic wraps.
    if is_fixed(texpr_type(l)) || is_fixed(texpr_type(r)) then
        return fixed_binary(e, op, texpr_type(l), texpr_type(r), ty, lv, rv0)

    // A shift's count may be any integer width, so it is brought to the shifted value's own here:
    // every instruction below takes two operands of one type.
    val rv = if op == "<<" || op == ">>" then shift_amount(e, bt, texpr_type(r), rv0) else rv0

    bt match
        Integer(bits, signed, _) ->
            if op == "<<" && is_ranged(texpr_type(l)) then return checked_shl(e, bits, signed, lv, rv)
            if overflow_checked(op, l, r, bits, signed) then return checked_arith(e, op, bits, signed, lv, rv)
        _ -> ()

    arith(e, op, bt, lv, rv)
end gen_binary

// `p - q`, C's `ptrdiff_t`. The bytes between the two addresses, divided by the pointee's size so
// the answer counts elements. The divide is skipped for a one-byte pointee.
private gen_ptr_diff(e: *Emit, l: TExpr, r: TExpr, lt: Type) -> Val
    val stride = lt match
        Ptr(inner) -> e.layout.size(*inner)
        _ -> usize(1)

    val ity = LInt(e.word_bits)
    val lv = gen_expr(e, l)
    val rv = gen_expr(e, r)
    val la = fresh_reg(e)

    emit(e, InCast(la, CastPtrToInt, LPtr, lv, ity))

    val ra = fresh_reg(e)

    emit(e, InCast(ra, CastPtrToInt, LPtr, rv, ity))

    val bytes = fresh_reg(e)

    emit(e, InBin(bytes, OpSub, ity, la, ra))

    if stride <= 1 then return bytes

    val n = fresh_reg(e)

    emit(e, InBin(n, OpSDiv, ity, bytes, VInt(from_int(long(stride)))))
    n
end gen_ptr_diff

private gen_unary(e: *Emit, op: string, operand: TExpr, ty: Type) -> Val
    val v = gen_expr(e, operand)
    val ety = lty(e, ty)
    val r = fresh_reg(e)

    if op == "!"
        emit(e, InBin(r, OpXor, l_i1(), v, VBool(true)))
        return r

    if op == "~"
        underlying(ty) match
            Vector(_, elem) ->
                emit(e, InBin(r, OpXor, ety, v, VSplat(lty(e, underlying(*elem)), VInt(from_int(-1)))))
            _ -> emit(e, InBin(r, OpXor, ety, v, VInt(from_int(-1))))

        return r

    if op == "-"
        // Negating the most negative fixed-point value saturates, as every fixed-point operation
        // does, rather than wrapping back to itself -- except in a `wrapping` type, which wraps.
        if is_fixed(vector_lane_of(ty)) then return fixed_neg(e, vector_lane_of(ty), fixed_wraps(ty), v)

        vector_lane_of(ty) match
            Integer(_, _, _) ->
                underlying(ty) match
                    Vector(_, _) -> emit(e, InBin(r, OpSub, ety, VZero, v))
                    _ -> emit(e, InBin(r, OpSub, ety, VInt(from_int(0)), v))
            Floating(_, _) -> emit(e, InNeg(r, ety, v))
            other -> gap_here(e, s"negation of ${type_show(other)}")

        return r

    gap_at(e, s"unary '$op'")
end gen_unary

// The lane a vector's operation is chosen from, or the type itself where it is not one.
vector_lane_of(t: Type) -> Type = underlying(t) match
    Vector(_, elem) -> underlying(*elem)
    other -> other

// `&&` and `||`, which do not evaluate their right operand unless they must.
private gen_logical(e: *Emit, op: string, l: TExpr, r: TExpr) -> Val
    val lv = gen_expr(e, l)
    val slot = alloca(e, fresh_reg(e), l_i1())

    emit(e, InStore(l_i1(), lv, slot, AccPlain, None))

    val rhs_l = fresh_label(e, "sc.rhs")
    val end_l = fresh_label(e, "sc.end")

    if op == "&&" then emit_term(e, InCondBr(lv, rhs_l, end_l))
    else emit_term(e, InCondBr(lv, end_l, rhs_l))

    emit_label(e, rhs_l)

    // **The right side gets a temp region of its own**: anything it makes is released before the
    // merge, and where the branch is skipped that code never runs at all.
    //
    // **And an ownership region of its own, which is the half that is not tidiness.** A slot
    // registered here is written only where the branch is taken, while the region it is registered
    // with is released on every path out of it -- so a value owned in a short-circuited operand
    // would have its release emitted on the edge its store never happened on, naming a register
    // that does not dominate it. Where nothing is owned, which is nearly always, the pop emits
    // nothing at all.
    push_temps(e)
    push_owned(e)

    val rv = gen_expr(e, r)

    emit(e, InStore(l_i1(), rv, slot, AccPlain, None))
    pop_owned(e)
    pop_temps(e)
    emit_term(e, InBr(end_l))
    emit_label(e, end_l)

    val res = fresh_reg(e)

    emit(e, InLoad(res, l_i1(), slot, AccPlain, None))
    res
end gen_logical

// One comparison has nothing to short-circuit, so it stays straight-line -- which is what the
// overwhelming majority of comparisons are. A **chain** stops at the first comparison that fails,
// with each operand still evaluated exactly once.
private gen_compare(e: *Emit, operands: Buf[TExpr], cmps: Buf[TCmp]) -> Val
    if cmps.len() == 1
        val lv = gen_expr(e, operands.at(0))

        return comparison(e, cmps.at(0), texpr_type(operands.at(0)), lv, gen_expr(e, operands.at(1)))

    val slot = alloca(e, fresh_reg(e), l_i1())

    var exits: Buf[string] = buf()

    for k in 0..<cmps.len()
        exits.push(fresh_label(e, "cmp.exit"))

    val end_l = fresh_label(e, "cmp.end")

    var left: Val = VNothing

    // **Each link is a region of its own, closed at its exit label** -- the same reason as the right
    // side of `&&`. An operand a later link builds exists only on the edges that reached that link,
    // so a release of it placed after the merge would name a register that does not dominate it on
    // the edge where an earlier comparison failed. The regions nest: link k's is closed at exit k,
    // after every later link's has been closed on the way through.
    for k in 0..<cmps.len()
        push_temps(e)
        push_owned(e)

        if k == 0 then left = gen_expr(e, operands.at(0))

        val right = gen_expr(e, operands.at(k + 1))
        val c = comparison(e, cmps.at(k), texpr_type(operands.at(k)), left, right)

        emit(e, InStore(l_i1(), c, slot, AccPlain, None))

        if k == cmps.len() - 1 then emit_term(e, InBr(exits.at(k)))
        else
            val next_l = fresh_label(e, "cmp.next")

            emit_term(e, InCondBr(c, next_l, exits.at(k)))
            emit_label(e, next_l)

        left = right

    for j in 0..<cmps.len()
        val k = cmps.len() - 1 - j

        emit_label(e, exits.at(k))
        pop_owned(e)
        pop_temps(e)
        emit_term(e, InBr(if k == 0 then end_l else exits.at(k - 1)))

    emit_label(e, end_l)

    val res = fresh_reg(e)

    emit(e, InLoad(res, l_i1(), slot, AccPlain, None))
    res
end gen_compare

// One comparison over two values the caller is holding: an instruction where the operand type has
// one, the method its `Eq`/`Ord` supplies otherwise.
comparison(e: *Emit, c: TCmp, ty: Type, av: Val, bv: Val) -> Val = c.dispatch match
    Some(d) -> dispatch_value(e, d, ty, ty, av, bv, Bool)
    None -> compare_value(e, c.op, underlying(ty), av, bv)

// **An operator the type supplies rather than the machine**: one call to the member its `impl`
// lowered to, with the operands in the order the block declared them and the answer negated where
// the operator is the mirror of the one that was written.
dispatch_value(e: *Emit, d: TDispatch, aty: Type, bty: Type, av: Val, bv: Val,
               result_ty: Type) -> Val
    val left = if d.swap then bv else av
    val left_ty = if d.swap then bty else aty
    val right = if d.swap then av else bv
    val right_ty = if d.swap then aty else bty

    var args: Buf[IrArg] = buf()

    args.push(operand_arg(e, left_ty, left))
    args.push(operand_arg(e, right_ty, right))

    val res = gen_sysl_call(e, VGlobal(symbol_of(e, d.name)), args, result_ty)

    if !d.negate then return res

    val n = fresh_reg(e)

    emit(e, InBin(n, OpXor, l_i1(), res, VBool(true)))
    n
end dispatch_value

// One operand of a dispatched operator, in the form the callee receives it: itself where it is a
// first-class value, and the address of a slot holding it where it is not.
//
// The slot is staging and nothing more -- a fresh slot nothing else can name, so it is storage the
// call cannot change, which is all a callee reading its parameter in place needs (`indirect_arg`).
// It holds a count of nothing, so nothing here releases it.
private operand_arg(e: *Emit, ty: Type, v: Val) -> IrArg
    if !e.layout.indirect(ty) then return ir_arg(lty(e, ty), v)

    val slot = alloca(e, fresh_reg(e), lty(e, ty))

    emit(e, InStore(lty(e, ty), v, slot, AccPlain, None))
    ir_arg(LPtr, slot)
end operand_arg

// -- writing --------------------------------------------------------------------------------------

private gen_store(e: *Emit, place: TExpr, value: TExpr, ty: Type) -> Val
    if zero_sized(ty)
        gen_expr(e, value)
        address(e, place)
        return VNothing

    val v = gen_expr(e, value)
    val p = place_addr(e, place)

    store_place(e, place, p, v)
    v
end gen_store

private gen_update(e: *Emit, place: TExpr, op: string, value: TExpr, ty: Type,
                   dispatch: Option[TDispatch], check: Option[Type]) -> Val
    val p = place_addr(e, place)
    val cur = load_place(e, place, p)
    val v = gen_expr(e, value)
    val updated = combine(e, op, ty, texpr_type(value), dispatch, cur, v)

    check match
        Some(c) -> emit_constraint_checks(e, updated, c)
        None -> ()

    store_over(e, place, p, updated, Some(cur))
    updated
end gen_update

private gen_inc_dec(e: *Emit, place: TExpr, op: string, pre: bool, ty: Type,
                    check: Option[Type]) -> Val
    val p = place_addr(e, place)
    val cur = load_place(e, place, p)
    val nv = fresh_reg(e)

    emit(e, InBin(nv, if op == "++" then OpAdd else OpSub, lty(e, ty), cur, VInt(from_int(1))))

    check match
        Some(c) -> emit_constraint_checks(e, nv, c)
        None -> ()

    store_over(e, place, p, nv, Some(cur))
    if pre then nv else cur
end gen_inc_dec

// What a compound assignment stores: what its operator makes of the place's current value and the
// value on the right. A constrained slot is arithmetic at the type it is laid out as, and it detects
// overflow on the same terms, so `a += e` computes what `a = a + e` computes.
combine(e: *Emit, op: string, ty: Type, value_ty: Type, dispatch: Option[TDispatch], cur: Val,
        v: Val) -> Val
    // The dispatched call owns its own result, the way every other call to sysl does -- an
    // `own_temp` here as well would put one value in the region twice and release it twice.
    dispatch match
        Some(d) -> return dispatch_value(e, d, ty, value_ty, cur, v, ty)
        None -> ()

    // A slot that holds a count builds a fresh value the slot will take a count for; a slot of
    // anything else is arithmetic.
    if underlying(ty) == Str then return own_temp(e, str_concat(e, cur, v), Str)

    val bin = op[0..<(op.bytes.len - 1)]

    if is_fixed(ty) then return fixed_binary(e, bin, ty, value_ty, ty, cur, v)

    val bt = underlying(ty)
    val rv = if bin == "<<" || bin == ">>" then shift_amount(e, bt, value_ty, v) else v

    bt match
        Integer(bits, signed, _) ->
            if bin == "<<" && is_ranged(ty) then return checked_shl(e, bits, signed, cur, rv)

            if (bin == "+" || bin == "-" || bin == "*") && is_ranged(ty)
                return checked_arith(e, bin, bits, signed, cur, rv)
        _ -> ()

    arith(e, bin, bt, cur, rv)
end combine

// -- what a constrained subtype asks of its values -------------------------------------------------

// Everything a constrained subtype asks of a value: the `within` range, then the `where` predicate
// -- a synthesised `i1`-returning function over the base value, which traps exactly as the range
// does when it answers false.
emit_constraint_checks(e: *Emit, v: Val, c: Type)
    c match
        Constrained(d) ->
            val base = underlying(d.base)

            base match
                // A float range is compared at `double` whatever the width, the ends being `double`
                // constants: a narrower value is widened first, which is exact.
                Floating(bits, _) ->
                    val wide = real_type()
                    val x = if bits == 64 then v else cast_to(e, CastFPExt, base, wide, v)

                    // An infinite end is still compared: `x >= -infinity` is false for a NaN alone,
                    // which is the whole of what `-infinity..infinity` refuses.
                    d.lo match
                        Some(lo) ->
                            trap_unless(e, compare_value(e, ">=", wide, x, VFloat(end_bits(lo))),
                                        "within")
                        None -> ()

                    d.hi match
                        Some(hi) ->
                            val op = if d.exclusive_hi then "<" else "<="

                            trap_unless(e, compare_value(e, op, wide, x, VFloat(end_bits(hi))),
                                        "within")
                        None -> ()
                // A fixed-point range is compared on the raw value, each end brought to the scale
                // inward -- the smallest raw value at or above the lower end, the largest at or below
                // the upper -- so no value outside the written range passes for one inside it.
                Fixed(_, frac, _) ->
                    d.lo match
                        Some(lo) ->
                            trap_unless(e, compare_value(e, ">=", base, v,
                                                         VInt(fixed_bound_raw(finite_end(lo), frac, FixCeil))),
                                        "within")
                        None -> ()

                    d.hi match
                        Some(hi) ->
                            // `x < hi` on the reals is `raw < hi·2^F`, which over integers is
                            // `raw < ceil(hi·2^F)`.
                            val op = if d.exclusive_hi then "<" else "<="
                            val mode: FixRound = if d.exclusive_hi then FixCeil else FixFloor

                            trap_unless(e, compare_value(e, op, base, v,
                                                         VInt(fixed_bound_raw(finite_end(hi), frac, mode))),
                                        "within")
                        None -> ()
                _ ->
                    d.lo match
                        Some(lo) ->
                            trap_unless(e, compare_value(e, ">=", base, v,
                                                         VInt(decimal_int(finite_end(lo)))),
                                        "within")
                        None -> ()

                    d.hi match
                        Some(hi) ->
                            val op = if d.exclusive_hi then "<" else "<="

                            trap_unless(e, compare_value(e, op, base, v,
                                                         VInt(decimal_int(finite_end(hi)))),
                                        "within")
                        None -> ()

            d.pred_fn match
                Some(pf) ->
                    val r = fresh_reg(e)

                    var args: Buf[IrArg] = buf()

                    args.push(ir_arg(lty(e, base), v))
                    emit(e, ir_call(Some(r), l_i1(), VGlobal(pf), args))
                    trap_unless(e, r, "where")
                None -> ()
        _ -> ()
end emit_constraint_checks

private gen_constrained_valid(e: *Emit, value: TExpr, c: Type) -> Val
    val v = gen_expr(e, value)

    c match
        Constrained(d) ->
            val base = underlying(d.base)
            val lo = d.lo match
                Some(x) -> decimal_int(finite_end(x))
                None -> from_int(0)
            val hi = d.hi match
                Some(x) -> decimal_int(finite_end(x))
                None -> from_int(0)

            val ge_lo = compare_value(e, ">=", base, v, VInt(lo))
            val le_hi = compare_value(e, if d.exclusive_hi then "<" else "<=", base, v, VInt(hi))
            val r = fresh_reg(e)

            emit(e, InBin(r, OpAnd, l_i1(), ge_lo, le_hi))
            r
        _ -> VBool(true)
end gen_constrained_valid

private gen_constrained_step(e: *Emit, value: TExpr, c: Type, up: bool) -> Val
    val v = gen_expr(e, value)

    c match
        Constrained(d) ->
            val base = underlying(d.base)

            if up
                val h = d.hi match
                    Some(x) -> decimal_int(finite_end(x))
                    None -> from_int(0)
                val last = if d.exclusive_hi then big_sub(h, from_int(1)) else h

                trap_unless(e, compare_value(e, "<", base, v, VInt(last)), "succ")
            else
                val first = d.lo match
                    Some(x) -> decimal_int(finite_end(x))
                    None -> from_int(0)

                trap_unless(e, compare_value(e, ">", base, v, VInt(first)), "pred")

            val r = fresh_reg(e)

            emit(e, InBin(r, if up then OpAdd else OpSub, lty(e, base), v, VInt(from_int(1))))
            r
        _ -> v
end gen_constrained_step

// -- enums ------------------------------------------------------------------------------------------

// An enum value built from a variant and what it carries.
private gen_enum_new(e: *Emit, enum_ty: Type, variant: EnumVariant, args: Buf[TExpr]) -> Val
    val d = enum_decl(enum_ty) match
        Some(decl) -> decl
        None -> return gap_at(e, "an enum construction of something that is not an enum")

    var vals: Buf[Val] = buf()

    for item in args
        vals.push(gen_expr(e, item))

    enum_value(e, enum_ty, d, variant, vals)
end gen_enum_new

// A struct built from its field values: an `insertvalue` chain over an undefined aggregate, with the
// fields that occupy nothing skipped exactly as the layout skips them. A **bitfield** struct is one
// integer instead, and its fields are ranges of it.
private gen_struct_new(e: *Emit, decl: &StructType, args: Buf[TExpr]) -> Val
    bitfield_ranges(decl) match
        Some(ranges) ->
            var vals: Buf[Val] = buf()

            for i in 0..<args.len()
                val v = gen_expr(e, args.at(i))

                if !zero_sized(decl.fields.at(i).1) then vals.push(v)

            val c = build_bits(e, ranges, vals)
            val r = fresh_reg(e)

            emit(e, InInsert(r, struct_lty(decl), VUndef, container_lty(ranges), c, index_list(0)))
            return r
        None -> ()

    var vals: Buf[Val] = buf()

    for item in args
        vals.push(gen_expr(e, item))

    var acc: Val = VUndef

    for i in 0..<vals.len()
        if !zero_sized(decl.fields.at(i).1)
            val r = fresh_reg(e)

            emit(e, InInsert(r, struct_lty(decl), acc, lty(e, decl.fields.at(i).1), vals.at(i),
                             index_list(struct_field_index(e.layout, decl, decl.slot(i)))))
            acc = r

    acc
end gen_struct_new

// -- calls ----------------------------------------------------------------------------------------

// A call the function makes to itself as the last thing it does, lowered as a jump back to its own
// entry rather than a second frame.
//
// **The order is the whole of the correctness, and it is the order a `return` already uses.** Each
// argument is computed while the frame is still whole -- it may well read the very slots about to be
// overwritten -- and a count is taken for it there, so what it names cannot reach zero when the old
// bindings let go. Only then does the frame give up everything it holds, and only then do the new
// values land. Written the other way round, `go(next, list)` would free the list at the moment the
// parameter holding it was reassigned and pass the second argument a dangling reference.
//
// The jump is a `br` and the block ends there, which is all any caller needs to know: this returns
// no register because there is no value.
gen_tail_self_call(e: *Emit, args: Buf[TExpr]) -> Val
    // What each argument left behind for the landing below: `StagedNothing` where there was nothing
    // to move, `StagedSlot` where it is bytes to copy, `StagedValue` where it is a register to
    // store.
    var staged: Buf[(int, Val)] = buf()

    // A large argument is staged in a slot of its own rather than a register, because that is how a
    // large value moves at all here. The staging slot is what makes it safe as well: the address of
    // an argument that is simply a parameter is that parameter's own slot, so writing straight
    // through would have the first argument's landing change what the second one reads.
    for i in 0..<e.tail_params.len()
        val ty = e.tail_params.at(i).1

        if zero_sized(ty)
            gen_expr(e, args.at(i))
            staged.push((StagedNothing, VNothing))
        else if e.layout.indirect(ty)
            val slot = alloca(e, fresh_reg(e), lty(e, ty))

            gen_into(e, slot, args.at(i))
            staged.push((StagedSlot, slot))
        else
            val v = gen_expr(e, args.at(i))

            retain_value(e, ty, v)
            staged.push((StagedValue, v))

    // The measure is checked while the frame is still whole, since it reads the parameters and the
    // jump below is about to overwrite them. A tail call survives this where an `ensure` does not:
    // the check happens *before* the call, and a tail call's problem is that it never returns.
    if checks_variant(e, e.self_name) then gen_variant_at_call(e, staged)

    release_all(e)

    for i in 0..<e.tail_params.len()
        val p = e.tail_params.at(i)
        val s = staged.at(i)

        // The count came with the bytes and stays with them: what the staging slot took is now the
        // parameter's, so nothing is retained here and nothing released.
        if s.0 == StagedSlot
            emit_memcpy(e, VReg(s"${p.0}.addr"), s.1, int(e.layout.size(p.1)),
                        int(e.layout.claim(p.1)))
        else if s.0 == StagedValue
            emit(e, InStore(lty(e, p.1), s.1, VReg(s"${p.0}.addr"), AccPlain, None))

    emit_term(e, InBr(e.tail_target))
    VNothing
end gen_tail_self_call

const StagedNothing: int = 0
const StagedSlot: int = 1
const StagedValue: int = 2

private gen_call(e: *Emit, name: string, args: Buf[TExpr], ty: Type) -> Val
    // A foreign result may be named by a type the sysl signature never mentions -- a coerced
    // aggregate, or `void` where the value comes back through an out-parameter -- and a variadic
    // callee is named by its whole function type, since the argument list alone does not say where
    // the declared parameters stop and the ellipsis begins.
    if is_foreign(e, name)
        val form = foreign_result(e, ty)

        return gen_foreign_call(e, CallForm(form.ret, form.ret_attrs, variadic_type_of(e, name)),
                                VGlobal(symbol_of(e, name)), args, ty)

    var arg_vals: Buf[IrArg] = buf()
    val staged = staged_args(e, args, &arg_vals, e.inert.has(name))

    // A call the compiler can see is a call to the same body checks that the measure has gone down.
    // It sits before the call rather than inside the callee, which is what lets it be made out of
    // values already in hand.
    if checks_variant(e, name) then gen_variant_at_call(e, staged)

    // A sysl definition's tail is named the way a foreign one's is: by the callee's whole function
    // type, since the argument list alone does not say where the declared parameters stop.
    val r = if is_variadic(e, name) then
        gen_sysl_call_at(e, VGlobal(symbol_of(e, name)), arg_vals, ty, variadic_type_of(e, name))
    else
        gen_sysl_call(e, VGlobal(symbol_of(e, name)), arg_vals, ty)

    // What the callee promised, said again where the caller's own code can be folded against it
    // (`contract_assume.sysl`). It goes after the call because a postcondition is about the state the
    // call left behind.
    val answered = r match
        VNothing -> None
        _ -> Some(r)

    assume_ensures(e, name, args, answered)
    r
end gen_call

// One end of a varargs walk: the intrinsic call, and the flag that declares the pair.
private gen_va_intrinsic(e: *Emit, symbol: string, ap: TExpr) -> Val
    e.uses_varargs = true

    var args: Buf[IrArg] = buf()

    args.push(ir_arg(LPtr, gen_expr(e, ap)))
    emit(e, InCall(None, LVoid, VGlobal(symbol), args, no_ir_attrs(), None, no_fast_math(), false))
    VNothing
end gen_va_intrinsic

// One call's arguments, in step with the parameters: what each one came out as, beside the list the
// call itself is written with. The two differ exactly where a parameter is zero-sized, which is an
// argument evaluated and not passed -- so a check reading the parameters needs the first and the call
// needs the second.
staged_args(e: *Emit, args: Buf[TExpr], out: *Buf[IrArg],
            callee_inert: bool) -> Buf[(int, Val)]
    var staged: Buf[(int, Val)] = buf()

    for a in args
        val aty = texpr_type(a)
        val v = guaranteed_arg(e, a, callee_inert)

        if e.layout.indirect(aty)
            out.push(ir_arg(LPtr, v))
            staged.push((StagedSlot, v))
        else if zero_sized(aty) then staged.push((StagedNothing, VNothing))
        else
            out.push(ir_arg(lty(e, aty), v))
            staged.push((StagedValue, v))

    staged
end staged_args

// One argument, in whatever form the boundary takes it: a large value crosses as the address of
// storage the caller holds, and a zero-sized one is evaluated and not passed.
arg_value(e: *Emit, a: TExpr, out: *Buf[IrArg])
    val ty = texpr_type(a)
    val v = guaranteed_arg(e, a, false)

    if e.layout.indirect(ty) then out.push(ir_arg(LPtr, v))
    else if !zero_sized(ty) then out.push(ir_arg(lty(e, ty), v))
end arg_value

// The address a large argument crosses at: storage nothing can change for the length of the call.
//
// **This is the whole of the by-value promise for a value that crosses in memory**, because the
// callee reads its parameter where it lies rather than copying it in (`reads_in_place`). Where
// `still` -- a temporary, a local nobody else can name, or a callee that can write nothing at all --
// the argument's own storage already is that, and it goes over as it stands. Anything else is a
// place a call is free to change while the callee is still reading it, so it is staged into a slot
// of this frame's first: the snapshot `self` promises, with a count taken for what it refers to and
// given back, at its address, with the scope.
indirect_arg(e: *Emit, a: TExpr, still: bool) -> Val
    if still then return address(e, a)

    val ty = texpr_type(a)
    val slot = alloca(e, fresh_reg(e), lty(e, ty))

    gen_into(e, slot, a)
    own_at(e, slot, ty)
    slot
end indirect_arg

// One argument evaluated, with the caller's side of the convention discharged (`borrowing.sysl`):
// the callee reads it through a count somebody holds for the length of the call, and where that is
// not already this frame -- a field, a global, a local whose address got out -- a count is taken
// here. What it is taken AT is the only difference between the two forms: a small one's loaded
// value is already a snapshot, so the count goes on it and comes back with the statement's other
// temporaries; a large one never becomes a register, so the snapshot is a slot of this frame's,
// written with counts taken and released where the scope holding it ends.
private guaranteed_arg(e: *Emit, a: TExpr, callee_inert: bool) -> Val
    val ty = texpr_type(a)
    val still = callee_inert || held(e, a)
    val guarantee = contains_counted(ty) && !still

    if e.layout.indirect(ty) then return indirect_arg(e, a, still)


    val v = gen_expr(e, a)

    if guarantee
        retain_value(e, ty, v)
        own_temp(e, v, ty)

    v
end guaranteed_arg

// Emits a call from sysl to sysl and hands back the register holding its result.
gen_sysl_call(e: *Emit, callee: Val, arg_vals: Buf[IrArg], ty: Type) -> Val =
    gen_sysl_call_into(e, callee, arg_vals, ty, None, None)

// The same, where the callee's parameter list is open at the end. **A variadic call names the whole
// function type**, since the argument list alone does not say where the declared parameters stop and
// the ellipsis begins -- and a call written without it is a call to a function of a different type.
gen_sysl_call_at(e: *Emit, callee: Val, arg_vals: Buf[IrArg], ty: Type,
                 fnty: Option[IrFnType]) -> Val =
    gen_sysl_call_into(e, callee, arg_vals, ty, None, fnty)

// The same, where the caller has storage a **large** result is to land in -- its own, named in front
// of every argument, so the value is never an LLVM value at either end. A caller with nowhere to put
// one makes a slot here and reads the value back out of it, which is correct and is exactly the
// shape `gen_into` exists to save the callers that *do* have somewhere.
gen_sysl_call_into(e: *Emit, callee: Val, arg_vals: Buf[IrArg], ty: Type, dest: Option[Val],
                   fnty: Option[IrFnType]) -> Val
    if e.layout.indirect(ty)
        val slot = if dest.is_some() then dest.unwrap() else alloca(e, fresh_reg(e), lty(e, ty))

        var all: Buf[IrArg] = buf()

        all.push(IrArg(LPtr, slot, sret_attrs(lty(e, ty), int(e.layout.claim(ty)))))

        for arg_val in arg_vals
            all.push(arg_val)

        emit(e, InCall(None, LVoid, callee, all, no_ir_attrs(), fnty, no_fast_math(), false))

        if dest.is_some() then return VNothing

        val r = fresh_reg(e)

        emit(e, InLoad(r, lty(e, ty), slot, AccPlain, None))
        return own_temp(e, r, ty)

    if no_value(ty)
        emit(e, InCall(None, LVoid, callee, arg_vals, no_ir_attrs(), fnty, no_fast_math(), false))

        if ty == Never then emit_term(e, InUnreachable)

        return VNothing

    val r = fresh_reg(e)

    emit(e, InCall(Some(r), lty(e, ty), callee, arg_vals, c_extension(ty, e.target), fnty,
                   no_fast_math(), false))
    own_temp(e, r, ty)
end gen_sysl_call_into

no_fast_math() -> Buf[FastMath]
    var out: Buf[FastMath] = buf()

    out
end no_fast_math

// -- conversions and zeros ----------------------------------------------------------------------------

// One scalar type read as another.
convert(e: *Emit, from: Type, to: Type, v: Val) -> Val
    if type_eq(from, to) then return v

    val ut = underlying(to)

    // Every conversion into or out of a fixed-point type rescales, rounds and saturates.
    if is_fixed(from) || is_fixed(ut) then return fixed_convert(e, underlying(from), ut, v)

    (from, ut) match
        (Integer(a_bits, a_signed, _), Integer(b_bits, _, _)) ->
            convert_int(e, a_bits, a_signed, b_bits, v)
        (Integer(_, a_signed, _), Floating(_, _)) ->
            cast_to(e, if a_signed then CastSIToFP else CastUIToFP, from, ut, v)
        (Floating(_, _), Integer(_, b_signed, _)) -> saturating_to_int(e, from, ut, b_signed, v)
        // `f16` and `bf16` are the one pair of floating types neither of which is wider, and LLVM
        // has no instruction turning one into the other -- `fptrunc` and `fpext` both require the
        // widths to differ. So the pair goes through `f32`, which holds both exactly: the
        // intermediate rounds nothing and the only rounding is the destination's own.
        (Floating(a_bits, _), Floating(b_bits, _)) ->
            if a_bits == b_bits
                val wide = Floating(32, false)

                return convert(e, wide, ut, convert(e, from, wide, v))

            cast_to(e, if b_bits > a_bits then CastFPExt else CastFPTrunc, from, ut, v)
        (Char, Integer(b_bits, _, _)) -> convert_int(e, 32, false, b_bits, v)
        (Integer(a_bits, a_signed, _), Char) -> checked_char(e, a_bits, a_signed, v)
        (Enum(d), Integer(_, _, _)) -> convert(e, underlying(d.underlying), ut, v)
        (Ptr(_), Ptr(_)) -> v
        // Only `is_null` writes this one -- `ptr_cast` refuses a reference -- and it reads the address
        // to compare it with null, taking no share of what it names.
        (Ref(_, _), Ptr(_)) -> v
        (Ptr(_), Integer(_, _, _)) -> cast_to(e, CastPtrToInt, from, ut, v)
        (Integer(_, _, _), Ptr(_)) -> cast_to(e, CastIntToPtr, from, ut, v)
        (Ptr(_), CFn(_, _)) -> v
        (CFn(_, _), Ptr(_)) -> v
        (CFn(_, _), CFn(_, _)) -> v
        (CFn(_, _), Integer(_, _, _)) -> cast_to(e, CastPtrToInt, from, ut, v)
        (Integer(_, _, _), CFn(_, _)) -> cast_to(e, CastIntToPtr, from, ut, v)
        _ -> gap_at(e, s"a conversion from ${type_show(from)} to ${type_show(to)}")
end convert

// A float read as an integer, **saturating** rather than trapping or wrapping.
//
// `fptoui`/`fptosi` are poison for a value the integer cannot hold, and a NaN is poison for both --
// so a conversion written in a program cannot be either of them. LLVM's `.sat` family is the whole
// answer: it clamps to the widest and narrowest the target holds and answers zero for a NaN, which
// is what every language that defines this conversion at all settles on.
private saturating_to_int(e: *Emit, from: Type, to: Type, signed: bool, v: Val) -> Val
    val ft = lty(e, from)
    val it = lty(e, to)
    val entry = if signed then llvm_fptosi_sat_entry() else llvm_fptoui_sat_entry()
    val name = entry.at([it, ft])

    var params: Buf[IrParam] = buf()

    params.push(ir_param(ft))
    request_intrinsic(e, ir_sig(name, ir_fn_type(it, params)))

    var ops: Buf[IrArg] = buf()

    ops.push(ir_arg(ft, v))

    val r = fresh_reg(e)

    emit(e, ir_call(Some(r), it, VGlobal(name), ops))
    r
end saturating_to_int

private cast_to(e: *Emit, op: CastOp, from: Type, to: Type, v: Val) -> Val
    val r = fresh_reg(e)

    emit(e, InCast(r, op, lty(e, from), v, lty(e, to)))
    r
end cast_to

// `char(u)` -- the one conversion that can fail, and so the one that checks.
//
// A Unicode scalar value is at most `0x10FFFF` and is never a surrogate; anything else traps, in
// the same runtime-safety category as a bounds check. **The test runs at 64 bits** so that a wider
// source cannot smuggle a value past it.
private checked_char(e: *Emit, from_bits: int, from_signed: bool, v: Val) -> Val
    val wide = convert_int(e, from_bits, from_signed, 64, v)
    val i64 = LInt(64)
    val in_range = fresh_reg(e)

    emit(e, InIntCmp(in_range, IUle, i64, wide, VInt(from_int(1114111))))

    val below_low = fresh_reg(e)

    emit(e, InIntCmp(below_low, IUlt, i64, wide, VInt(from_int(55296))))

    val above_top = fresh_reg(e)

    emit(e, InIntCmp(above_top, IUgt, i64, wide, VInt(from_int(57343))))

    val scalar = fresh_reg(e)

    emit(e, InBin(scalar, OpOr, l_i1(), below_low, above_top))

    val ok = fresh_reg(e)

    emit(e, InBin(ok, OpAnd, l_i1(), in_range, scalar))
    trap_unless(e, ok, "char")

    val r = fresh_reg(e)

    emit(e, InCast(r, CastTrunc, i64, wide, LInt(32)))
    r
end checked_char

// The zero value of a type: what a declaration with no initializer starts at.
zero_of(e: *Emit, ty: Type) -> Val
    if zero_sized(ty) then return VNothing

    ty match
        Constrained(_) -> return zero_of(e, underlying(ty))
        Volatile(inner) -> return zero_of(e, *inner)
        _ -> ()

    underlying(ty) match
        Integer(_, _, _) -> VInt(from_int(0))
        Fixed(_, _, _) -> VInt(from_int(0))
        Floating(_, _) -> v_float(0.0)
        Char -> VInt(from_int(0))
        Bool -> VInt(from_int(0))
        Ptr(_) -> if erased(underlying(ty)) then VZero else VNull
        Ref(_, _) -> if erased(underlying(ty)) then VZero else VNull
        Weak(inner) -> if is_trait(*inner) then VZero else VNull
        CFn(_, _) -> VNull
        Struct(_) -> VZero
        Array(_, _) -> VZero
        Vector(_, _) -> VZero
        Slice(_, _) -> VZero
        Str -> VZero
        VaList -> VZero
        Enum(d) -> if d.simple then VInt(from_int(0)) else VZero
        other -> gap_at(e, s"the zero of ${type_show(other)}")
end zero_of

// A range bound as a whole number. Every bound an integer type carries is one; a float base's
// bounds are read by `emit_constraint_checks`' float arm instead, in double precision.
decimal_int(d: Decimal) -> BigInt = rescale(d, 0, Rounding.Down).coefficient()

// A float base's range end as the `double` it is compared at -- an infinity included, which is the
// one end no decimal spells.
private end_bits(r: RangeEnd) -> long = r match
    EndAt(d) -> double_bits(str(d))
    EndInfinite(negative) -> if negative then NegInfinityBits else InfinityBits

// -- `?` --------------------------------------------------------------------------------------------

// **`expr?`** -- on success the payload becomes the expression's value; on failure the function
// returns immediately with the failure re-wrapped in its own return type, carrying the error payload
// across unchanged.
private gen_try(e: *Emit, operand: TExpr, ok: EnumVariant, fail: EnumVariant, ret_enum: Type,
                ret_fail: EnumVariant, convert: Option[string]) -> Val
    val d = enum_decl(texpr_type(operand))
    val rd = enum_decl(ret_enum)

    if d.is_none() || rd.is_none() then return gap_at(e, "'?' on something that is not an enum")

    val en = d.unwrap()
    val v = gen_expr(e, operand)
    val tag = fresh_reg(e)

    emit(e, InExtract(tag, enum_lty(en), v, index_list(0)))

    val is_ok = fresh_reg(e)

    emit(e, InIntCmp(is_ok, IEq, l_i32(), tag, VInt(from_int(long(ok.tag)))))

    val ok_l = fresh_label(e, "try.ok")
    val fail_l = fresh_label(e, "try.fail")

    emit_term(e, InCondBr(is_ok, ok_l, fail_l))
    emit_label(e, fail_l)

    // **The conversion happens here and nowhere else**, which is why `?` carries a name rather than
    // a node: what it converts is the failure payload, and the payload exists only inside this
    // branch. Everything else about the early return is unchanged.
    val failed = convert match
        None ->
            val f = enum_value(e, ret_enum, rd.unwrap(), ret_fail,
                               payload_values(e, en, fail, v))

            // The payload was borrowed out of the operand, so the value leaving the function takes a
            // count of its own.
            retain_value(e, ret_enum, f)
            f
        Some(fn) ->
            // **A converted failure arrives owned and is NOT retained again.** The conversion is a
            // call, and a call's result is a share of its own -- so the count the early return
            // carries out is the one `from` already took.
            val payload = payload_values(e, en, fail, v)
            val from_ty = type_arg_at(texpr_type(operand), 1)
            val to_ty = type_arg_at(ret_enum, 1)

            var made: Buf[Val] = buf()

            made.push(gen_conversion(e, fn, payload.at(0), from_ty, to_ty))
            enum_value(e, ret_enum, rd.unwrap(), ret_fail, made)

    // **A large result leaves through the caller's storage, and `?` is a `return` like any other.**
    // The convention has already made this function `void` and given it an out-pointer, so handing
    // the value back directly would emit a `ret` of an aggregate out of a `void` function.
    if e.coro.is_some()
        coro_deliver(e, failed)
    else if e.layout.indirect(ret_enum)
        emit(e, InStore(lty(e, ret_enum), failed, sret_param(), AccPlain, None))
        release_all(e)
        emit_term(e, InRet(None, None))
    else
        release_all(e)
        emit_term(e, InRet(Some(lty(e, ret_enum)), Some(failed)))

    emit_label(e, ok_l)

    val got = payload_values(e, en, ok, v)

    if got.is_empty() then VNothing else got.at(0)
end gen_try

// One type argument of a generic named type, where it has one.
private type_arg_at(t: Type, i: usize) -> Type = underlying(t) match
    Enum(d) -> if i < d.targs.len() then d.targs.at(i) else Unknown
    Struct(d) -> if i < d.targs.len() then d.targs.at(i) else Unknown
    _ -> Unknown

// One call to a conversion function whose argument is a value already in hand.
//
// The ordinary call path takes typed **expressions**, so it can ask each argument for its address
// where the convention wants one. Here the argument is a register, so a value passed indirectly has
// to be given storage first -- which is the whole of what this does beyond the call itself.
//
// **Emitted rather than sent through `gen_sysl_call`, because the result must NOT be a temporary.** A
// temporary is released where the surrounding statement ends, and this call happens inside the branch
// that returns -- so the release would be emitted in a block the value does not reach.
private gen_conversion(e: *Emit, fn: string, arg: Val, from: Type, to: Type) -> Val
    val passed =
        if !e.layout.indirect(from) then ir_arg(lty(e, from), arg)
        else
            val slot = alloca(e, fresh_reg(e), lty(e, from))

            emit(e, InStore(lty(e, from), arg, slot, AccPlain, None))
            ir_arg(LPtr, slot)

    val callee = VGlobal(symbol_of(e, fn))

    if e.layout.indirect(to)
        val slot = alloca(e, fresh_reg(e), lty(e, to))

        var args: Buf[IrArg] = buf()

        args.push(IrArg(LPtr, slot, sret_attrs(lty(e, to), int(e.layout.claim(to)))))
        args.push(passed)
        emit(e, InCall(None, LVoid, callee, args, no_ir_attrs(), None, no_fast_math(), false))

        val r = fresh_reg(e)

        emit(e, InLoad(r, lty(e, to), slot, AccPlain, None))
        return r
    end if

    var args: Buf[IrArg] = buf()

    args.push(passed)

    val r = fresh_reg(e)

    emit(e, InCall(Some(r), lty(e, to), callee, args, c_extension(to, e.target), None,
                   no_fast_math(), false))
    r
end gen_conversion

// Runs the store once per element of an array laid down at `base`, with the element's address.
// The same, for storage a value is being written into rather than a slot made for it. An array of no
// elements has nothing to walk, and the one evaluation the form promises has already happened.
fill_at(e: *Emit, base: Val, array_ty: Type, v: Val)
    if array_len_of(array_ty) > 0 then fill_array(e, base, array_ty, v)

fill_array(e: *Emit, base: Val, array_ty: Type, v: Val)
    val elem = element(array_ty).unwrap_or(int_type())
    val i = alloca(e, fresh_reg(e), word_lty(e))
    val cond_l = fresh_label(e, "fill.test")
    val body_l = fresh_label(e, "fill.elem")
    val end_l = fresh_label(e, "fill.done")

    emit(e, InStore(word_lty(e), VInt(from_int(0)), i, AccPlain, None))
    emit_term(e, InBr(cond_l))
    emit_label(e, cond_l)

    val iv = fresh_reg(e)

    emit(e, InLoad(iv, word_lty(e), i, AccPlain, None))

    val more = fresh_reg(e)

    emit(e, InIntCmp(more, IUlt, word_lty(e), iv, VInt(from_int(long(array_len_of(array_ty))))))
    emit_term(e, InCondBr(more, body_l, end_l))
    emit_label(e, body_l)

    val ep = fresh_reg(e)

    var idx: Buf[IrArg] = buf()

    idx.push(ir_arg(word_lty(e), iv))
    emit(e, InGep(ep, lty(e, elem), base, idx))
    emit(e, InStore(lty(e, elem), v, ep, AccPlain, None))

    val nxt = fresh_reg(e)

    emit(e, InBin(nxt, OpAdd, word_lty(e), iv, VInt(from_int(1))))
    emit(e, InStore(word_lty(e), nxt, i, AccPlain, None))
    emit_term(e, InBr(cond_l))
    emit_label(e, end_l)
end fill_array

// -- the atomics ---------------------------------------------------------------------------------

// **An atomic access is an ordinary access with a keyword on it**, which is why the ordering has to
// be written at the call rather than held in a variable: it becomes part of the instruction rather
// than an operand the instruction reads. The analyzer has already held it to being one of
// `sysl.sync.Ordering`'s variants written out, so what arrives here is a word.
//
// The alignment is the type's own and is stated: LLVM defaults an atomic access to the ABI alignment
// anyway, and saying it is what makes the text the same as the reference's.
private gen_atomic(e: *Emit, op: string, addr: TExpr, ops: Buf[TExpr], ordering: string, at: Type,
                   ty: Type) -> Val
    val ord = atomic_ordering_of(ordering)
    val lt = lty(e, at)
    val align = int(e.layout.align(at))
    val p = gen_expr(e, addr)

    if op == "atomic_load"
        val r = fresh_reg(e)

        emit(e, InLoad(r, lt, p, AccAtomic(ord), Some(align)))
        return own_temp(e, r, ty)
    end if

    val v = gen_expr(e, ops.at(0))

    if op == "atomic_store"
        emit(e, InStore(lt, v, p, AccAtomic(ord), Some(align)))
        return VNothing
    end if

    // **A compare-and-swap answers the value it FOUND**, which is what a caller loops on: the
    // instruction gives back a pair of the old value and whether it was taken, and only the first
    // half is the form's result. The ordering on a failed exchange is the success one weakened,
    // since a failure performs no store and LLVM refuses a release on it.
    if op == "atomic_cas"
        val d = gen_expr(e, ops.at(1))
        val pair = fresh_reg(e)

        emit(e, InCmpXchg(pair, p, lt, v, d, ord))

        var fields: Buf[LType] = buf()

        fields.push(lt)
        fields.push(l_i1())

        val r = fresh_reg(e)

        emit(e, InExtract(r, LStruct(fields), pair, index_list(0)))
        return own_temp(e, r, ty)
    end if

    val r = fresh_reg(e)

    emit(e, InAtomicRmw(r, rmw_of(op), p, lt, v, ord))
    own_temp(e, r, ty)
end gen_atomic

// A barrier with no address, ordering everything around it rather than one access.
private gen_fence(e: *Emit, ordering: string) -> Val
    emit(e, InFence(atomic_ordering_of(ordering)))
    VNothing
end gen_fence

// An AArch64 system register or barrier, as the intrinsic LLVM's back end turns into the one
// instruction. A register travels as a metadata string; a barrier's option as its CRm encoding.
private gen_sysop(e: *Emit, op: string, name: string, args: Buf[TExpr]) -> Val
    val wide = LInt(64)
    val meta = LNamed("metadata")

    if op == "read_sysreg"
        var params: Buf[IrParam] = buf()

        params.push(ir_param(meta))
        request_intrinsic(e, ir_sig(llvm_sysreg_read(), ir_fn_type(wide, params)))

        var ops: Buf[IrArg] = buf()

        ops.push(ir_arg(meta, VMetaString(name)))

        val r = fresh_reg(e)

        emit(e, ir_call(Some(r), wide, VGlobal(llvm_sysreg_read()), ops))
        return r

    if op == "write_sysreg"
        val v = gen_expr(e, args.at(0))

        var params: Buf[IrParam] = buf()

        params.push(ir_param(meta))
        params.push(ir_param(wide))
        request_intrinsic(e, ir_sig(llvm_sysreg_write(), ir_fn_type(LVoid, params)))

        var ops: Buf[IrArg] = buf()

        ops.push(ir_arg(meta, VMetaString(name)))
        ops.push(ir_arg(wide, v))
        emit(e, ir_call(None, LVoid, VGlobal(llvm_sysreg_write()), ops))
        return VNothing

    if op == "tlbi" || op == "dc" || op == "ic" || op == "at" then return gen_maintenance(e, op, name, args)

    val symbol = llvm_aarch64_barrier_entry(op).unwrap().base
    var params: Buf[IrParam] = buf()

    params.push(ir_param(LInt(32)))
    request_intrinsic(e, ir_sig(symbol, ir_fn_type(LVoid, params)))

    var ops: Buf[IrArg] = buf()

    ops.push(ir_arg(LInt(32), VInt(from_int(long(barrier_option(name).unwrap_or(15))))))
    emit(e, ir_call(None, LVoid, VGlobal(symbol), ops))
    VNothing
end gen_sysop

// A maintenance instruction -- `tlbi`, `dc`, `ic`, `at` -- as one block of inline assembly, LLVM having
// no intrinsic for most of them. The block is `sideeffect` and clobbers memory, so it is neither moved
// across a load or store nor merged with an identical one beside it. `at` reads its answer out of
// PAR_EL1 in the same block, behind the `isb` the architecture asks for before that read.
private gen_maintenance(e: *Emit, op: string, name: string, args: Buf[TExpr]) -> Val
    var ops: Buf[IrArg] = buf()

    if !args.is_empty()
        val v = gen_expr(e, args.at(0))

        ops.push(ir_arg(lty(e, texpr_type(args.at(0))), v))

    if op == "at"
        val r = fresh_reg(e)

        emit(e, InAsm(Some(r), LInt(64), "at " + name + ", $1\\0Aisb\\0Amrs $0, par_el1",
                      "=r,r,~{memory}", ops))
        return r

    if ops.is_empty()
        emit(e, InAsm(None, LVoid, op + " " + name, "~{memory}", ops))
    else
        emit(e, InAsm(None, LVoid, op + " " + name + ", $0", "r,~{memory}", ops))

    VNothing
end gen_maintenance

// The variant a written ordering names. `SeqCst` is what an unrecognised word falls to, which cannot
// happen: the analyzer refuses anything that is not one of the five by name, so this is the total
// function the match needs rather than a decision.
private atomic_ordering_of(ordering: string) -> IrOrdering =
    if ordering == "Relaxed" then OrdRelaxed
    else if ordering == "Acquire" then OrdAcquire
    else if ordering == "Release" then OrdRelease
    else if ordering == "AcqRel" then OrdAcqRel
    else OrdSeqCst

// Which read-modify-write a form names. `atomic_swap` is LLVM's `xchg`, and the four arithmetic ones
// keep their own words.
private rmw_of(op: string) -> RmwOp =
    if op == "atomic_swap" then RmwXchg
    else if op == "atomic_add" then RmwAdd
    else if op == "atomic_sub" then RmwSub
    else if op == "atomic_and" then RmwAnd
    else if op == "atomic_or" then RmwOr
    else RmwXor
