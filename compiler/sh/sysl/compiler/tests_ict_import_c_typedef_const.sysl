module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.fs.{make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture
import sysl.text.join

// `sysl import-c`: a bitfield declared through a typedef of an integer, and a `static const` number.
//
// A bitfield's unit is judged by the integer under the typedef, so `Flags b : 8` over
// `typedef uint32_t Flags` is `u8 in u32` as `uint32_t b : 8` is. A `static const` has no symbol, so
// it is a `c const` the C compiler works out, with the typedef's name kept; a `static` that is not a
// const number is said not to be generated, and is never an extern. Each case generates a module
// from a small header, then builds and runs a program using it.

private ict_ready() -> bool
    if std_root().is_err()
        print("skipped: the standard module's source is not on this machine")
        return false
    end if

    if !clang_available()
        print("skipped: there is no clang on this machine")
        return false
    end if

    true
end ict_ready

private ict_generated(dir: string, header: string) -> IcOutput
    write_text(s"$dir/t.h", header).unwrap()
    import_c_generate(s"$dir/t.h", IcOptions("", "", "", "", None, buf(), "")).unwrap()

// The generated module with `uses` appended as the program, built and run: what it printed, or the
// build's complaint.
private ict_run(header: string, uses: string) -> Result[string, string]
    val dir = make_temp_dir("sysl-ict").unwrap()
    val out = ict_generated(dir, header)

    write_text(s"$dir/package.hocon", "package {\n  name = \"ict\"\n  version = \"0.0.1\"\n}\n").unwrap()
    write_text(s"$dir/main.sysl", out.text + "\n" + uses).unwrap()

    val (code, _, err) = clx_ran(["sysl", "build", dir, "-o", s"$dir/ict"])
    val result = if code != Fine then Err(err) else Ok(capture(s"$dir/ict", [], "", [], true).unwrap().text)

    remove_dir_all(dir).unwrap_or(())
    result

private ict_refused(header: string) -> (string, string)
    val dir = make_temp_dir("sysl-ict").unwrap()
    val out = ict_generated(dir, header)

    remove_dir_all(dir).unwrap_or(())
    (out.text, join(out.refused.view(), "\n"))

// ## Bitfields over a typedef

private val ict_bits: string = raw"""
    #include <stdint.h>
    #include <stdbool.h>
    typedef uint32_t Flags;
    typedef Flags Flags2;
    typedef int16_t Small;
    typedef Small Small2;
    struct two { uint32_t a : 24; Flags b : 8; };
    struct deep { Flags2 a : 5; Flags2 b : 11; };
    struct signedbits { Small2 a : 4; Small b : 12; };
    struct flagbit { bool on : 1; unsigned rest : 7; };
    """

@test("a bitfield declared through a typedef of an integer has that integer for its unit")
ict_typedef_bitfield()
    if !ict_ready() then return

    val (text, why) = ict_refused(ict_bits)

    assert(text.contains("a: u24 in u32"), text)
    assert(text.contains("b: u8 in u32"), text)
    assert(!why.contains("two"), why)

    ict_run(ict_bits, "var t = Two(1, 2)\nt.b += 3\nprint(sizeof(Two), t.a, t.b)\n") match
        Ok(got) -> assert_eq(got.trim(), "4 1 5")
        Err(e) -> assert(false, e)

@test("a typedef of a typedef, and a signed one, resolve the same way")
ict_typedef_chain_and_signed()
    if !ict_ready() then return

    val (text, why) = ict_refused(ict_bits)

    assert(text.contains("a: u5 in u32"), text)
    assert(text.contains("b: u11 in u32"), text)
    assert(text.contains("a: i4 in i16"), text)
    assert(text.contains("b: i12 in i16"), text)
    assert(!why.contains("deep") && !why.contains("signedbits"), why)

    ict_run(ict_bits, "var s = Signedbits(-3, -100)\nprint(sizeof(Deep), sizeof(Signedbits), s.a, s.b)\n") match
        Ok(got) -> assert_eq(got.trim(), "4 2 -3 -100")
        Err(e) -> assert(false, e)

@test("a bool bitfield is as it was")
ict_bool_bitfield()
    if !ict_ready() then return

    val (text, _) = ict_refused(ict_bits)

    assert(text.contains("on: bool in bool"), text)

@test("a typedef of an enum is judged as it was, by the same reader")
ict_typedef_non_integer_refused()
    if !ict_ready() then return

    val (text, why) = ict_refused("typedef enum { Ea, Eb } Mode; struct fl { Mode r : 3; };\n")

    assert(why.contains("bitfield") || text.contains("r:"), why)

// ## `static const`

private val ict_consts: string = raw"""
    #include <stdint.h>
    typedef uint64_t Usage;
    static const Usage Usage_MapRead = 0x1;
    static const Usage Usage_Vertex = 0x20;
    static const Usage Usage_Both = Usage_MapRead | Usage_Vertex;
    static const int8_t k_i8 = -5;
    static const uint8_t k_u8 = 200;
    static const int16_t k_i16 = -300;
    static const uint16_t k_u16 = 60000;
    static const int32_t k_i32 = -70000;
    static const uint32_t k_u32 = 4000000000u;
    static const int64_t k_i64 = -5000000000;
    static const uint64_t k_u64 = 10000000000000000000ull;
    static const int k_shift = 1 << 3;
    """

@test("a 'static const' typedef'd integer is a 'c const', and not an extern, so a program using it links and runs")
ict_static_const_typedef()
    if !ict_ready() then return

    val (text, why) = ict_refused(ict_consts)

    assert(!text.contains("extern"), text)
    assert(text.contains("c const"), text)
    assert(text.contains("USAGE_MAP_READ: Usage = \"Usage_MapRead\""), text)
    assert_eq(why, "")

    ict_run(ict_consts, "print(USAGE_MAP_READ | USAGE_VERTEX, USAGE_BOTH)\n") match
        Ok(got) -> assert_eq(got.trim(), "33 33")
        Err(e) -> assert(false, e)

@test("a 'static const' of every integer width, signed, negative, or an expression, reads back its value")
ict_static_const_widths()
    if !ict_ready() then return

    ict_run(ict_consts, "print(K_I8, K_U8, K_I16, K_U16, K_I32, K_U32, K_I64, K_U64, K_SHIFT)\n") match
        Ok(got) -> assert_eq(got.trim(), "-5 200 -300 60000 -70000 4000000000 -5000000000 10000000000000000000 8")
        Err(e) -> assert(false, e)

private val ict_other: string = raw"""
    typedef struct { int x; } Pt;
    static const Pt origin = { 3 };
    static int counter = 4;
    static const float half = 0.5f;
    extern const int shared_count;
    """

@test("a 'static const' struct, and a 'static' that is not const, are said not to be generated")
ict_static_non_number_skipped()
    if !ict_ready() then return

    val (text, why) = ict_refused(ict_other)

    assert(!text.contains("extern origin") && !text.contains("ORIGIN"), text)
    assert(!text.contains("extern counter") && !text.contains("COUNTER"), text)
    assert(why.contains("origin"), why)
    assert(why.contains("counter"), why)

@test("a 'static const' float is measured, and a 'const' with no 'static' stays an extern")
ict_static_float_and_extern_const()
    if !ict_ready() then return

    val (text, _) = ict_refused(ict_other)

    assert(text.contains("extern shared_count: i32"), text)
    assert(!text.contains("extern half"), text)

@test("a 'static const' float built into a program reads back its value")
ict_static_float_runs()
    if !ict_ready() then return

    ict_run("static const float half = 0.5f;\nstatic const double third = 0.25;\n", "print(HALF, THIRD)\n") match
        Ok(got) -> assert_eq(got.trim(), "0.5 0.25")
        Err(e) -> assert(false, e)
