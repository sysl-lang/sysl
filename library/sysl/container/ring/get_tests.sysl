module sysl.container.ring
@tests

/** `get` on the two rings: `Some` from the front inside the length, `None` at and past it and for a
 * negative index, and the same after the ring has wrapped.
 */

@test("Ring.get answers from the front, None at and past the length")
ring_get_in_and_out_of_range()
    var slots: [4]int = [0; 4]
    var r = ring(slots[..])

    assert_eq(r.get(0), None)

    r.push_back(1)
    r.push_back(2)

    assert_eq(r.get(0), Some(1))
    assert_eq(r.get(1), Some(2))
    assert_eq(r.get(2), None)

@test("Ring.get is None for a negative index of any signed width")
ring_get_negative()
    var slots: [4]int = [0; 4]
    var r = ring(slots[..])

    r.push_back(1)

    val a: i8 = -1
    val b: i128 = -1

    assert_eq(r.get(a), None)
    assert_eq(r.get(b), None)
    assert_eq(r.get(i16(0)), Some(1))

@test("Ring.get on a ring that has wrapped counts from the front")
ring_get_wrapped()
    var slots: [4]int = [0; 4]
    var r = ring(slots[..])

    for i in 1..4
        r.push_back(i)

    r.pop_front()
    r.pop_front()
    r.push_back(5)
    r.push_back(6)

    // 3 4 5 6 with the head at slot two.
    assert_eq(r.get(0), Some(3))
    assert_eq(r.get(3), Some(6))
    assert_eq(r.get(4), None)
    assert_eq(r[1], 4)

    r.overwrite(7)

    assert_eq(r.get(0), Some(4))
    assert_eq(r.get(3), Some(7))

@test("r[i] = v writes through a wrapped Ring")
ring_subscript_set_wrapped()
    var slots: [3]int = [0; 3]
    var r = ring(slots[..])

    r.push_back(1)
    r.push_back(2)
    r.push_back(3)
    r.pop_front()
    r.push_back(4)
    r[0] = 20
    r[2] = 40

    assert_eq(r.get(0), Some(20))
    assert_eq(r.get(1), Some(3))
    assert_eq(r.get(2), Some(40))

@test("InlineRing.get answers from the front, None at and past the length and below zero")
inline_ring_get()
    var r = inline_ring[int, 4]()

    assert_eq(r.get(0), None)

    r.push_back(1)
    r.push_back(2)

    val neg: i32 = -1

    assert_eq(r.get(0), Some(1))
    assert_eq(r.get(1), Some(2))
    assert_eq(r.get(2), None)
    assert_eq(r.get(neg), None)

@test("InlineRing.get on a ring that has wrapped counts from the front")
inline_ring_get_wrapped()
    var r = inline_ring[int, 3]()

    r.push_back(1)
    r.push_back(2)
    r.push_back(3)
    r.pop_front()
    r.push_back(4)

    assert_eq(r.get(0), Some(2))
    assert_eq(r.get(2), Some(4))
    assert_eq(r.get(3), None)

    r[1] = 30

    assert_eq(r.get(1), Some(30))
    assert_eq(r[2], 4)
