module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.container.{Map, map}
import sysl.env.get
import sysl.text.from_utf8_unchecked
import sysl.time.monotonic

// **Where every value may point, field by field, and what each function does with what it is handed**
// (`reference/memory.md § A borrowed pointer cannot escape`).
//
// One forward walk over each body, callees first, says for every value what it may be made of: a
// parameter's value or something read along a path through it (`p0.*.1`), the address of a local's
// storage, a heap object the body made, or module storage. From the walk each function gets a
// summary, per parameter:
//
// - the paths through it that may be **kept** -- stored somewhere that outlives the call;
// - the paths through it that may flow to the **result**, with where in the result they sit;
// - what it may **write** through another parameter, which is the caller's to place, and where: the
//   path through that parameter the store went along (`p0.0`, the pointer a handle holds).
//
// **Paths are field-sensitive**: `keep(s: S) = G = s.a` keeps `s.a` and nothing of `s.b`, and a value
// read along `.a` is told apart from one along `.b`. **A path stops at the first type that repeats
// along it**: a step landing on a struct or enum the path already went through goes back to where it
// first did, so `n.*.next.*` is `n.*` and every summary is finite -- no longer than the number of
// distinct types it crosses -- with no count of steps anywhere. A path stands for everything below
// it, so a cut path answers for every depth of the list or tree it walked. **A path also stops at a
// `&T` box**: it is followed only through what is held in place -- struct fields, tuple parts, raw
// pointers, views -- and a box's whole interior is one heap cell, so keeping a box keeps everything
// in it.
//
// **A view or an address put into a heap object the function answers is lent back, not kept**: the
// summary says where in the result it sits (`*.0`), and the caller follows the result as it follows
// the argument, so a later store of the object is caught where the caller makes it.
//
// **A call with no body in sight is answered by its signature**: an `extern` keeps what `@keeps`
// names and answers what `@answers` names; a call through a `&Fn` keeps what the callable type marks
// `@keeps` and may answer with any argument; a call through any other trait object keeps what the
// trait method declares `@keeps`, every argument where it answers a task; a function pointer keeps
// nothing and may answer with any argument.
//
// Each body is walked until what its locals and heap objects hold stops growing -- a value only ever
// gains members, and there are finitely many -- and a body whose summary grew sends its callers back
// to be walked again. Nothing is asked on demand.

// One step of a path: a field (`.3`, or `.Some:0` for a variant's), the pointee or the element a view
// reaches (`*`), an element of an array held in place (`[]`), or somewhere at or below here (`~`); with
// the struct or enum the step lands on, which is what a path is cut at. `id` names the pair `s`, `n`
// in the analysis's step table (`step`), so a path is compared and looked up by integers.
struct FStep
    s: string
    n: string
    id: u32

// What a value may be made of: `root` along `path`, sitting at `off` within the value. A root is a
// parameter's value (`p<i>`), the address of a local's storage (`l:<name>`), a heap object made in
// the body (`h:<site>`), or module storage (`g`). For an address, `path` is where in the storage it
// points. `rid`, `pid` and `oid` name the root, the path and the offset in the analysis's tables,
// and `key` the three together: two atoms are one exactly when their keys are equal.
struct FAtom
    off: Buf[FStep]
    root: string
    path: Buf[FStep]
    rid: u32
    pid: u32
    oid: u32
    key: u64
end FAtom

// One function's summary: per parameter, the paths kept and the paths answered with where in the
// answer they sit; what is written through one parameter out of another -- `(dest, src, path, at)`:
// what `src` holds along `path`, stored where `dest`'s value along `at` points; and where in the
// answer a heap object made inside the call sits.
struct FpaSum
    kept: Buf[Buf[Buf[FStep]]]
    answers: Buf[Buf[(Buf[FStep], Buf[FStep])]]
    writes: Buf[(usize, usize, Buf[FStep], Buf[FStep])]
    fresh: Buf[Buf[FStep]]
    seen: Map[u64, bool]
    size: int
    lent: Buf[Buf[Buf[FStep]]]

    // **Where module storage's address is written through a parameter** -- `(dest, at)`: the caller's
    // place where `dest`'s value along `at` points afterwards points at storage that outlives every
    // frame, as after `redirect(pp) = *pp = &slot`, or after handing `pp` to C.
    foreign: Buf[(usize, Buf[FStep])]
end FpaSum

// The analysis of a whole program, with the tables that name steps, paths, roots and pairs of them by
// integers: a path is a walk down `paths` from the empty path (0), one step id at a time. `places`,
// `reach_of`, `type_ids` and `named` remember what a place can hold by its type (`place_reach`).
struct Fpa
    an: &Analysis
    funcs: Buf[TFunc]
    index: Map[string, usize]
    sums: Buf[&FpaSum]
    holds: Map[string, bool]
    mistaken: Map[string, bool]
    walks: int
    tracing: bool
    bodies: Map[usize, &FBody]
    steps: Map[string, u32]
    paths: Map[u64, u32]
    roots: Map[string, u32]
    pairs: Map[u64, u32]
    reach: Map[string, Map[string, bool]]
    lent: Map[string, Buf[string]]
    fits: Map[string, bool]
    fits_at: Map[u64, bool]
    places: Map[u64, Map[u32, Option[Buf[Map[string, bool]]]]]
    reach_of: Map[u64, Option[Buf[Map[string, bool]]]]
    type_ids: Map[string, u32]
    named: Map[string, Buf[(Type, string)]]
end Fpa

// What one cell may hold, with the atoms already in it by key, the parameter paths already in it
// somewhere inside (by root and path), and the walk that last read it.
struct FCell
    atoms: Buf[FAtom]
    has: Map[u64, bool]
    under: Map[u64, bool]
    read: int
end FCell

// One walk of one body: what every cell may hold -- a local (`l:<name>`), a heap object (`h:<site>`),
// the answer (`$ret`), what a loop breaks with (`$brk`), what is kept (`$kept`) and what is stored
// through a parameter (`$thr<i>:<at>`, one cell for each parameter and path through it stored at) --
// with which cells were read in the walk under way, since a cell that grows after it was read sends
// the body round again. `kept` and `thru` are the parameter paths already kept, and already stored
// through another parameter; `dests` names each `$thr` cell by parameter and path id, and `dest_list`
// holds them in the order they were first stored into. `held` is what each parameter holds in place,
// by type (`param_fits`), and `reach` what a place through one can hold (`param_reach`).
struct FBody
    fx: &Fpa
    f: TFunc
    cells: Map[string, &FCell]
    kept: Map[u64, bool]
    thru: Map[u64, bool]
    refs: Map[string, TExpr]
    changed: bool
    count: int
    names: Buf[string]
    driven: Map[usize, bool]
    dests: Map[u64, string]
    dest_list: Buf[(string, usize, Buf[FStep])]
    held: Map[usize, Buf[string]]
    reach: Map[u64, Option[Buf[Map[string, bool]]]]
end FBody

// -- the whole program ----------------------------------------------------------------------------

// Every function's summary, callees first; a function whose summary grows sends its callers round
// again until none does.
fpa_analyze(a: &Analysis, funcs: Buf[TFunc]) -> &Fpa
    var index: Map[string, usize] = map()

    for i in 0..<funcs.len()
        if !index.has(funcs[i].name) then index.put(funcs[i].name, i)

    // One box every walk shares, so the walk counter a cell's `read` is stamped with is one count.
    val fx: &Fpa = Fpa(a, funcs, index, buf(), map(), map(), 0, fpa_tracing(), map(), map(), map(), map(), map(), map(), map(), map(), map(), map(), map(), map(), map())

    // The steps every walk takes, first, so the constants below name them.
    step_in(fx, "~", "")
    step_in(fx, "*", "")
    step_in(fx, "[]", "")
    var callees: Buf[Buf[usize]] = buf()
    var callers: Buf[Buf[usize]] = buf()

    for f in funcs
        fx.sums.push(empty_sum(f.params.len()))
        callers.push(buf())

        if mistaken(f) then fx.mistaken.put(f.name, true)

    for i in 0..<funcs.len()
        val cs = fpa_callees(fx, funcs[i])

        callees.push(cs)

        for c in cs
            callers[c].push(i)

    var comp_of: Buf[usize] = buf()
    var rank: Buf[usize] = buf()

    for _ in 0..<funcs.len()
        comp_of.push(0)
        rank.push(0)

    val comps = callee_components(callees)

    for ci in 0..<comps.len()
        for r in 0..<comps[ci].len()
            comp_of[comps[ci][r]] = ci
            rank[comps[ci][r]] = r

    // A component at a time, callees' components first: a body is walked again only for a callee in its
    // own component, since every other callee's summary is final before it is first walked. Within one,
    // the next body walked is always the first waiting in callees-first order, so a caller waits for
    // the callees that are still growing.
    for ci in 0..<comps.len()
        val members = comps[ci]
        var pending: Buf[bool] = buf()

        for _ in 0..<members.len()
            pending.push(true)

        var at: usize = 0

        loop
            while at < members.len() && !pending[at]
                at += 1

            if at >= members.len() then break

            val fi = members[at]

            pending[at] = false

            if fx.mistaken.has(funcs[fi].name) then continue

            val sum = walk_func(fx, fi)

            if fx.tracing && sum.size > 100 then eprints(s"FPA-SUM ${funcs[fi].name} ${sum.size} writes ${sum.writes.len()}\n")

            if sum.size > fx.sums[fi].size
                fx.sums[fi] = sum

                for c in callers[fi]
                    if comp_of[c] == ci
                        pending[rank[c]] = true

                        if rank[c] < at then at = rank[c]
            end if
        end loop
    end for

    fx
end fpa_analyze

private empty_sum(n: usize) -> &FpaSum
    var kept: Buf[Buf[Buf[FStep]]] = buf()
    var answers: Buf[Buf[(Buf[FStep], Buf[FStep])]] = buf()
    var lent: Buf[Buf[Buf[FStep]]] = buf()

    for _ in 0..<n
        kept.push(buf())
        answers.push(buf())
        lent.push(buf())

    FpaSum(kept, answers, buf(), buf(), map(), 0, lent, buf())
end empty_sum

// The functions a body calls by name, as indices, once each.
private struct FCallees
    fx: &Fpa
    seen: Map[usize, bool]
    out: Buf[usize]
end FCallees

private fpa_callees(fx: &Fpa, f: TFunc) -> Buf[usize]
    val c: &FCallees = FCallees(fx, map(), buf())

    walk_block_stmts(f.body, expr_walk(false, e -> note_fpa_callee(c, e)))
    c.out
end fpa_callees

private note_fpa_callee(c: &FCallees, e: TExpr)
    *e.kind match
        TCall(name, _, _, _) -> c.fx.index.get(name) match
            Some(i) ->
                if !c.seen.has(i)
                    c.seen.put(i, true)
                    c.out.push(i)
            None -> ()
        _ -> ()
end note_fpa_callee

// **The functions that call each other in a circle, a component at a time, each component after every
// component it calls** (Tarjan's strongly connected components, depth first on a stack of its own).
// Within a component, the functions come in the order the walk finished them, which puts a callee
// before its caller wherever the circle allows.
private callee_components(callees: Buf[Buf[usize]]) -> Buf[Buf[usize]]
    val n = callees.len()
    var order: Buf[int] = buf()
    var low: Buf[int] = buf()
    var on_stack: Buf[bool] = buf()

    for _ in 0..<n
        order.push(-1)
        low.push(0)
        on_stack.push(false)

    var open: Buf[usize] = buf()
    var finished: Buf[usize] = buf()
    var comp_id: Buf[usize] = buf()
    var count: usize = 0
    var counter = 0

    for _ in 0..<n
        comp_id.push(0)

    for start in 0..<n
        if order[start] >= 0 then continue

        var work: Buf[(usize, usize)] = buf()

        order[start] = counter
        low[start] = counter
        counter += 1
        open.push(start)
        on_stack[start] = true
        work.push((start, 0))

        while !work.is_empty()
            val top = work[work.len() - 1]
            val v = top.0
            val cs = callees[v]

            if top.1 < cs.len()
                work[work.len() - 1] = (v, top.1 + 1)

                val w = cs[top.1]

                if order[w] < 0
                    order[w] = counter
                    low[w] = counter
                    counter += 1
                    open.push(w)
                    on_stack[w] = true
                    work.push((w, 0))
                else if on_stack[w] && order[w] < low[v]
                    low[v] = order[w]
                end if
            else
                work.pop()
                finished.push(v)

                if !work.is_empty()
                    val u = work[work.len() - 1].0

                    if low[v] < low[u] then low[u] = low[v]

                if low[v] == order[v]
                    loop
                        val w = open.pop().unwrap()

                        on_stack[w] = false
                        comp_id[w] = count

                        if w == v then break

                    count += 1
                end if
            end if
        end while
    end for

    var out: Buf[Buf[usize]] = buf()

    for _ in 0..<count
        out.push(buf())

    for v in finished
        out[comp_id[v]].push(v)

    out
end callee_components

// -- one body -------------------------------------------------------------------------------------

// The body walked until no cell it read grows, and its summary read off what the walk found.
//
// **A body walked again starts from what its last walk settled on**: it is walked again only because a
// callee's summary grew, and summaries only grow, so everything it held then it holds now.
private walk_func(fx: &Fpa, fi: usize) -> &FpaSum
    val fb = fx.bodies.get(fi) match
        Some(was) -> settle(was)
        None -> settle_body(fx, fx.funcs[fi])

    fx.bodies.put(fi, fb)
    summarize(fb)
end walk_func

private settle_body(fx: &Fpa, f: TFunc) -> &FBody =
    settle(FBody(fx, f, map(), map(), map(), map(), false, 0, buf(), map(), map(), buf(), map(), map()))

// Walks a body until no cell it read grows. A cell counts as read in this walk when its `read` is this
// walk's number, `fx.walks`.
private settle(fb: &FBody) -> &FBody
    val fx = fb.fx
    val f = fb.f

    loop
        fb.changed = false
        fb.refs = map()
        fx.walks += 1

        val t0 = monotonic().us

        for i in 0..<f.params.len()
            if fpa_holds(fx, f.params[i].1) then add_to(fb, s"l:${f.params[i].0}", single(atom(fb, buf(), s"p$i", buf())))

        add_to(fb, "$ret", eval_block(fb, f.body))

        if fx.tracing
            eprints(s"FPA-TRACE ${f.name} walk ${fx.walks} atoms ${fb.count} changed ${fb.changed} us ${monotonic().us - t0}\n")

            if fb.count > 3000
                for n in fb.names
                    val c = fb.cells.get(n).unwrap().atoms

                    if c.len() > 300
                        eprints(s"FPA-CELL ${f.name} $n ${c.len()} ${atom_text(c[0])} ${atom_text(c[c.len() / 2])} ${atom_text(c[c.len() - 1])}\n")
            end if
        end if

        if !fb.changed then break

    fb
end settle

// The summary of a settled body: what is kept, with everything a kept heap object or local holds; what
// the answer is made of, through every heap object it holds; and what is stored through each
// parameter.
private summarize(fb: &FBody) -> &FpaSum
    val f = fb.f
    val sum = empty_sum(f.params.len())

    for i in 0..<f.params.len()
        if is_ptr_type(f.params[i].1) && holds_string(f.marks.copies, f.params[i].0)
            sum_kept(fb.fx, sum,i, buf())

    var visited: Map[string, bool] = map()
    var work: Buf[FAtom] = buf()

    for a in cell(fb, "$kept")
        work.push(a)

    for d in fb.dest_list
        written_through(fb, sum, d.0, d.1, d.2, &work)

    var at: usize = 0

    while at < work.len()
        val a = work[at]

        at += 1

        if a.root.starts_with("p")
            sum_kept(fb.fx, sum,param_of(a.root), a.path)
        else if (a.root.starts_with("h:") || a.root.starts_with("l:")) && !visited.has(a.root)
            visited.put(a.root, true)

            for b in cell(fb, a.root)
                work.push(b)
        end if

    summarize_lent(fb, sum)

    var seen: Map[string, bool] = map()

    if fpa_holds(fb.fx, f.ret_ty) then answer_from(fb, sum, cell(fb, "$ret"), buf(), &seen)
    sum
end summarize

// **What is stored through parameter `dest` where its value along `at` points**, from its cell `name`:
// a parameter's path is written there; what a heap object stored there holds is written inside it
// (`at~`), at every depth of heap objects, since the object now lives where the caller placed it and
// is the caller's to keep or not, except a parameter's own value the place cannot hold by its type;
// a parameter's own value stored back inside what it points at is not written, as `store_at` leaves
// it. The address of a local stored there lets the local's storage
// out, so it goes to `work`, to be kept with what it holds.
private written_through(fb: &FBody, sum: &FpaSum, name: string, dest: usize, at: Buf[FStep], work: *Buf[FAtom])
    val inside = extend(at, tilde_step())

    // A parameter's own value held in a heap object stored there is written only where the place's
    // type can hold it (M44): the object may have been filled from a box's whole interior. The type
    // is asked the first time it matters.
    var reach: Option[Buf[Map[string, bool]]] = None
    var asked = false
    var visited: Map[string, bool] = map()
    var todo: Buf[(FAtom, bool)] = buf()

    for a in cell(fb, name)
        todo.push((a, false))

    var i: usize = 0

    while i < todo.len()
        val a = todo[i].0
        val deep = todo[i].1

        i += 1

        if a.root == "g"
            if !deep then sum_foreign(fb.fx, sum, dest, at)
        else if a.root.starts_with("p")
            val src = param_of(a.root)

            if !deep
                sum_write(fb.fx, sum, dest, src, a.path, at)
            else if src != dest
                if a.path.is_empty() && !asked && dest < fb.f.params.len()
                    reach = reach_at(fb.fx, fb.f.params[dest].1, at)
                    asked = true
                end if

                if !a.path.is_empty() || reach.is_none() || param_fits(fb, src, reach.unwrap())
                    sum_write(fb.fx, sum, dest, src, a.path, inside)
            end if
        else if a.root.starts_with("h:")
            if !visited.has(a.root)
                visited.put(a.root, true)

                for b in cell(fb, a.root)
                    todo.push((b, true))
        else
            work.push(a)
        end if
end written_through

// The parameter paths handed where no body answers for a view (`lend`), through every local and heap
// object that holds them.
private summarize_lent(fb: &FBody, sum: &FpaSum)
    var visited: Map[string, bool] = map()
    var work = copy_of(cell(fb, "$lent"))
    var at: usize = 0

    while at < work.len()
        val a = work[at]

        at += 1

        if a.root.starts_with("p")
            val i = param_of(a.root)

            if i < sum.lent.len() && !covered(fb.fx, &sum.seen, SEEN_LENT | (u64(i) << 32), without_tilde(a.path))
                sum.lent[i].push(a.path)
                sum.size += 1
        else if (a.root.starts_with("h:") || a.root.starts_with("l:")) && !visited.has(a.root)
            visited.put(a.root, true)

            for b in cell(fb, a.root)
                work.push(b)
        end if
end summarize_lent

// What the answer is made of: a parameter's value where it sits, and through each heap object it
// holds, what that object holds, one `*` further in. Inside a heap object the place is the object
// itself, whatever deeper: its interior is one cell (M28) -- except a raw-pointer or view field of a
// heap object the answer holds in place, which keeps its place (`.0*.0`), with the object it points at
// one `*` further in (M40).
private answer_from(fb: &FBody, sum: &FpaSum, atoms: Buf[FAtom], prefix: Buf[FStep], seen: *Map[string, bool])
    val inside = has_deref(prefix)
    val first = inside && first_inside(prefix)

    for a in atoms
        val at_raw = first && a.off.len() == 1 && is_raw_field_step(a.off[0])
        val o = if at_raw then concat(prefix, a.off) else if inside then prefix else concat(prefix, a.off)

        if a.root.starts_with("p")
            sum_answer(fb.fx, sum, param_of(a.root), a.pid, a.path, o)
        else if a.root.starts_with("h:")
            sum_fresh(fb.fx, sum, o)

            if !seen.has(a.root)
                seen.put(a.root, true)

                val deeper = if inside && !at_raw then o else concat(o, one_step(star_step()))

                answer_from(fb, sum, cell(fb, a.root), deeper, seen)
            end if
        end if
end answer_from

// The tag of each kind of entry in a summary's `seen`, in its top bits.
private val SEEN_KEPT: u64 = 1 << 60
private val SEEN_ANSWER: u64 = 2 << 60
private val SEEN_WRITE: u64 = 3 << 60
private val SEEN_FRESH: u64 = 4 << 60
private val SEEN_LENT: u64 = 5 << 60
private val SEEN_FOREIGN: u64 = 6 << 60

private sum_kept(fx: &Fpa, sum: &FpaSum, i: usize, path: Buf[FStep])
    if covered(fx, &sum.seen, SEEN_KEPT | (u64(i) << 32), without_tilde(path)) then return

    sum.kept[i].push(path)
    sum.size += 1
end sum_kept

// **Whether a path, or one it extends, is already in a set**, since a path stands for everything below
// it: a kept `*.0` holds every `*.0.…` there is. A path that is not is added. An entry is the path's
// id under `tag`, which says what the set is of.
private covered(fx: &Fpa, seen: *Map[u64, bool], tag: u64, path: Buf[FStep]) -> bool
    var id: u32 = 0

    if seen.has(tag) then return true

    for st in path
        id = path_child(fx, id, st)

        if seen.has(tag | u64(id)) then return true

    seen.put(tag | u64(id), true)
    false
end covered

private sum_answer(fx: &Fpa, sum: &FpaSum, i: usize, pid: u32, path: Buf[FStep], off: Buf[FStep])
    if i >= sum.answers.len() then return

    val k = SEEN_ANSWER | (u64(i) << 32) | u64(pair_id(fx, pid, path_id(fx, off)))

    if sum.seen.has(k) then return

    sum.seen.put(k, true)
    sum.answers[i].push((path, off))
    sum.size += 1
end sum_answer

private sum_write(fx: &Fpa, sum: &FpaSum, dest: usize, src: usize, path: Buf[FStep], at: Buf[FStep])
    val k = SEEN_WRITE | (u64(pair_id(fx, pair_id(fx, u32(dest), u32(src)), path_id(fx, at))) << 32) |
        u64(path_id(fx, path))

    if sum.seen.has(k) then return

    sum.seen.put(k, true)
    sum.writes.push((dest, src, path, at))
    sum.size += 1
end sum_write

private sum_foreign(fx: &Fpa, sum: &FpaSum, dest: usize, at: Buf[FStep])
    val k = SEEN_FOREIGN | (u64(dest) << 32) | u64(path_id(fx, at))

    if sum.seen.has(k) then return

    sum.seen.put(k, true)
    sum.foreign.push((dest, at))
    sum.size += 1
end sum_foreign

private sum_fresh(fx: &Fpa, sum: &FpaSum, off: Buf[FStep])
    val k = SEEN_FRESH | u64(path_id(fx, off))

    if sum.seen.has(k) then return

    sum.seen.put(k, true)
    sum.fresh.push(off)
    sum.size += 1
end sum_fresh

// -- cells ----------------------------------------------------------------------------------------

// A cell, made empty the first time it is asked for.
private cell_of(fb: &FBody, name: string) -> &FCell
    fb.cells.get(name) match
        Some(c) -> return c
        None -> ()

    // The box the table holds is the one handed back, so a read stamped on it here is seen there.
    val c: &FCell = FCell(buf(), map(), map(), 0)

    fb.cells.put(name, c)
    fb.names.push(name)
    c
end cell_of

// What a cell holds, which counts as reading it.
private cell(fb: &FBody, name: string) -> Buf[FAtom]
    val c = cell_of(fb, name)

    c.read = fb.fx.walks
    c.atoms
end cell

// Adds what a cell may hold. A cell the walk under way already read sends the body round again.
private add_to(fb: &FBody, name: string, atoms: Buf[FAtom])
    if atoms.is_empty() then return

    val c = cell_of(fb, name)
    var grew = false

    for a in atoms
        if c.has.has(a.key) then continue

        // A parameter's path somewhere inside a value stands for every path it begins.
        if !a.off.is_empty() && a.off[0].id == TILDE && a.root.starts_with("p") &&
           covered(fb.fx, &c.under, u64(a.rid) << 32, without_tilde(a.path))
            continue

        c.has.put(a.key, true)
        c.atoms.push(a)
        fb.count += 1
        grew = true

    if grew && c.read == fb.fx.walks then fb.changed = true
end add_to

// Notes what is kept: let out of the call, through anything that holds it.
//
// Where in a value a kept part sat says nothing more, and a parameter's path already kept, or one it
// extends, holds this one too.
private keep(fb: &FBody, atoms: Buf[FAtom])
    var out: Buf[FAtom] = buf()

    for a in atoms
        if a.root.starts_with("p")
            if !covered(fb.fx, &fb.kept, u64(a.rid) << 32, without_tilde(a.path)) then out.push(at_place(fb, buf(), a, a.path))
        else
            out.push(at_place(fb, buf(), a, a.path))

    add_to(fb, "$kept", out)
end keep

// Notes what is handed where no body answers for a view: a call through a `&Fn` or a function pointer
// that does not mark it `@keeps`, a form the compiler supplies, or an async call whose task is not
// driven where it is made. None of these is a keep, but a view handed to one is not known to stay put
// until callable types answer for views by their signature, so the escape analysis counts it as let
// out (`fpa_lets_out_whole`).
private lend(fb: &FBody, atoms: Buf[FAtom])
    var out: Buf[FAtom] = buf()

    for a in atoms
        out.push(at_place(fb, buf(), a, a.path))

    add_to(fb, "$lent", out)
end lend

// -- atoms and paths ------------------------------------------------------------------------------

// The step ids every walk takes, entered first (`fpa_analyze`).
private val TILDE: u32 = 1
private val STAR: u32 = 2
private val ELEM: u32 = 3

// The slots `place_reach` keeps a call's answer and a store under, beside an argument's index.
private val PLACE_ANSWER: usize = 254
private val PLACE_STORE: usize = 255

private tilde_step() -> FStep = FStep("~", "", TILDE)
private star_step() -> FStep = FStep("*", "", STAR)
private elem_step() -> FStep = FStep("[]", "", ELEM)

// The step `s` landing on `n`, by its id in the step table.
private step_in(fx: &Fpa, s: string, n: string) -> FStep
    val k = s + "@" + n

    fx.steps.get(k) match
        Some(id) -> FStep(s, n, id)
        None ->
            val id = u32(fx.steps.len() + 1)

            fx.steps.put(k, id)
            FStep(s, n, id)
end step_in

private step(fb: &FBody, s: string, n: string) -> FStep = step_in(fb.fx, s, n)

// The path one step below the path `parent`, by id.
private path_child(fx: &Fpa, parent: u32, st: FStep) -> u32
    val k = (u64(parent) << 32) | u64(st.id)

    fx.paths.get(k) match
        Some(id) -> id
        None ->
            val id = u32(fx.paths.len() + 1)

            fx.paths.put(k, id)
            id
end path_child

private path_id(fx: &Fpa, p: Buf[FStep]) -> u32
    var id: u32 = 0

    for st in p
        id = path_child(fx, id, st)

    id
end path_id

// One id for two.
private pair_id(fx: &Fpa, a: u32, b: u32) -> u32
    val k = (u64(a) << 32) | u64(b)

    fx.pairs.get(k) match
        Some(id) -> id
        None ->
            val id = u32(fx.pairs.len() + 1)

            fx.pairs.put(k, id)
            id
end pair_id

private root_id(fx: &Fpa, root: string) -> u32
    fx.roots.get(root) match
        Some(id) -> id
        None ->
            val id = u32(fx.roots.len() + 1)

            fx.roots.put(root, id)
            id
end root_id

private atom(fb: &FBody, off: Buf[FStep], root: string, path: Buf[FStep]) -> FAtom =
    made_atom(fb.fx, off, root, root_id(fb.fx, root), path, path_id(fb.fx, path))

// `a`'s root along `path`, sitting at `off`.
private at_place(fb: &FBody, off: Buf[FStep], a: FAtom, path: Buf[FStep]) -> FAtom =
    made_atom(fb.fx, off, a.root, a.rid, path, path_id(fb.fx, path))

// `a` itself, sitting at `off`.
private moved(fb: &FBody, off: Buf[FStep], a: FAtom) -> FAtom = made_atom(fb.fx, off, a.root, a.rid, a.path, a.pid)

private made_atom(fx: &Fpa, off: Buf[FStep], root: string, rid: u32, path: Buf[FStep], pid: u32) -> FAtom
    val o = if off.len() > 1 then cut_offset(off) else off
    val oid = path_id(fx, o)

    FAtom(o, root, path, rid, pid, oid, (u64(pair_id(fx, rid, pid)) << 32) | u64(oid))
end made_atom

// An atom as the trace prints it.
private atom_text(a: FAtom) -> string = s"${a.root}|${fpa_path_text(a.path)}|${fpa_path_text(a.off)}"

// **Where a part sits in a value is cut the way a path is** (M25): at the second step landing on a
// type the offset already went through, it becomes "somewhere at or below the first" (`~`). A `~`
// already stands for everything below it.
private cut_offset(off: Buf[FStep]) -> Buf[FStep]
    var out: Buf[FStep] = buf()

    for i in 0..<off.len()
        val st = off[i]

        out.push(st)

        if st.s == "~" then return out

        val key = cut_key(st.n)

        if key != ""
            for j in 0..<i
                if cut_key(off[j].n) == key
                    var cut: Buf[FStep] = buf()

                    for k in 0..<j + 1
                        cut.push(off[k])

                    cut.push(tilde_step())
                    return cut
                end if
        end if

    out
end cut_offset

// A path as a summary says it: the steps alone.
fpa_path_text(p: Buf[FStep]) -> string
    var out = ""

    for st in p
        out = out + st.s

    out
end fpa_path_text

private one_step(st: FStep) -> Buf[FStep]
    var out: Buf[FStep] = buf()

    out.push(st)
    out
end one_step

private concat(a: Buf[FStep], b: Buf[FStep]) -> Buf[FStep]
    var out: Buf[FStep] = buf()

    for st in a
        out.push(st)

    for st in b
        out.push(st)

    out
end concat

private tail(p: Buf[FStep]) -> Buf[FStep]
    var out: Buf[FStep] = buf()

    for i in 1..<p.len()
        out.push(p[i])

    out
end tail

// **One step further along a path, cut at the first type that repeats along it**: a step landing on a
// struct or enum the path already went through goes back to where it first did.
//
// **A path stops at a `&T` box** (M28): it is followed only through what is held in place -- fields,
// tuple parts, raw pointers, views -- and a box's whole interior is one heap cell, so `p0.*` into a box
// stands for every field of it at every depth, and keeping the box keeps everything inside it. A path
// ending in `~` stands for everything below it too.
private extend(p: Buf[FStep], st: FStep) -> Buf[FStep]
    if ends_whole(p) then return p

    var out: Buf[FStep] = buf()
    val key = cut_key(st.n)

    for item in p
        out.push(item)

        if key != "" && cut_key(item.n) == key then return out

    out.push(st)
    out
end extend

// Whether a path stands for everything below it: it ends at `~`, or inside a box.
private ends_whole(p: Buf[FStep]) -> bool
    if p.is_empty() then return false

    val last = p[p.len() - 1]

    last.s == "~" || is_box_step(last)
end ends_whole

// A field step onto a raw pointer or a view (`field_nominal`).
private is_raw_field_step(st: FStep) -> bool = is_field_step(st.s) && st.n.starts_with("#")

// The step into a `&T` box (`deref_step`).
private is_box_step(st: FStep) -> bool = st.s == "*" && st.n.starts_with("&")

private without_tilde(p: Buf[FStep]) -> Buf[FStep]
    if p.is_empty() || p[p.len() - 1].s != "~" then return p

    var out: Buf[FStep] = buf()

    for i in 0..<p.len() - 1
        out.push(p[i])

    out
end without_tilde

// A variant's field is named by its variant and its position (`.Some:0`): two variants' fields are
// two fields.
private variant_step(v: EnumVariant, k: usize) -> string = s".${v.name}:$k"

private is_field_step(s: string) -> bool = s.starts_with(".")

private param_of(root: string) -> usize
    var n: usize = 0
    val b = root.bytes

    for i in 1..<b.len
        n = n * 10 + usize(b[i] - u8('0'))

    n
end param_of

// The value one step into each atom: the field, element or pointee `st` names.
private project(fb: &FBody, v: Buf[FAtom], st: FStep) -> Buf[FAtom]
    if v.is_empty() then return v

    var out: Buf[FAtom] = buf()

    out.reserve(v.len())

    for a in v
        project_one(fb, a, st, &out)

    distinct(out)
end project

// Each atom once: a value reached two ways is still one value, and a step taken from both would take
// it twice, and the next step four times.
private distinct(v: Buf[FAtom]) -> Buf[FAtom]
    if v.len() < 2 then return v

    var out: Buf[FAtom] = buf()

    out.reserve(v.len())

    // A short value is checked atom against atom, which allocates nothing.
    if v.len() <= 16
        for a in v
            var dup = false

            for b in out
                if b.key == a.key
                    dup = true
                    break

            if !dup then out.push(a)

        return out
    end if

    var seen: Map[u64, bool] = map()

    for a in v
        if !seen.has(a.key)
            seen.put(a.key, true)
            out.push(a)

    out
end distinct

private project_one(fb: &FBody, a: FAtom, st: FStep, out: *Buf[FAtom])
    if !a.off.is_empty()
        val h = a.off[0]

        if h.s == "~"
            // Somewhere at or below here: still below, or exactly here and so stepped into.
            out.push(a)

            // A parameter's value is not followed into: what is there is anything at or below it.
            if a.root.starts_with("p") then out.push(at_place(fb, buf(), a, extend(a.path, tilde_step())))
            else project_one(fb, moved(fb, buf(), a), st, out)
        else if h.s == st.s
            out.push(moved(fb, tail(a.off), a))
        else if !is_field_step(h.s) || !is_field_step(st.s)
            out.push(a)
        end if

        return
    end if

    if a.root.starts_with("p")
        out.push(at_place(fb, buf(), a, extend(a.path, st)))
    else if a.root == "g"
        out.push(a)
    else
        // An address: what the storage it points at holds, at the place it points.
        if st.s == "*"
            for b in along(fb, cell(fb, a.root), a.path)
                out.push(b)
        else
            // A step into an address that is not through it: typed code takes none, and the address is
            // followed whole.
            out.push(a)
        end if
    end if
end project_one

// The value along a path, a step at a time.
private along(fb: &FBody, v: Buf[FAtom], p: Buf[FStep]) -> Buf[FAtom]
    var cur = v

    for st in p
        cur = project(fb, cur, st)

    cur
end along

// `along`, with the value at every beginning of the path kept for the next path to start from.
private along_shared(fb: &FBody, v: Buf[FAtom], p: Buf[FStep], memo: *Map[u32, Buf[FAtom]]) -> Buf[FAtom]
    var cur = v
    var at: u32 = 0

    for st in p
        at = path_child(fb.fx, at, st)

        memo.get(at) match
            Some(got) -> cur = got
            None ->
                cur = project(fb, cur, st)
                memo.put(at, cur)

    cur
end along_shared

// The same atoms, sitting further into a value.
private placed(fb: &FBody, v: Buf[FAtom], at: Buf[FStep]) -> Buf[FAtom]
    if at.is_empty() then return v

    var out: Buf[FAtom] = buf()

    for a in v
        out.push(moved(fb, concat(at, a.off), a))

    out
end placed

private placed_step(fb: &FBody, v: Buf[FAtom], s: string, n: string) -> Buf[FAtom] =
    if v.is_empty() then v else placed(fb, v, one_step(step(fb, s, n)))

// Somewhere inside a value: what a call no body answers for may hand back.
private anywhere_in(fb: &FBody, v: Buf[FAtom]) -> Buf[FAtom]
    var out: Buf[FAtom] = buf()
    val here = one_step(tilde_step())

    // An atom already anywhere inside is the one asked for.
    for a in v
        if a.off.len() == 1 && a.off[0].id == TILDE then out.push(a) else out.push(moved(fb, here, a))

    out
end anywhere_in

private join_into(out: *Buf[FAtom], v: Buf[FAtom])
    out.reserve(v.len())

    for a in v
        out.push(a)
end join_into

// An address one step further into the storage it points at. A parameter's value stands for every
// address inside what it points at.
private addr_step(fb: &FBody, v: Buf[FAtom], st: FStep) -> Buf[FAtom]
    var out: Buf[FAtom] = buf()

    for a in v
        if a.off.is_empty() && (a.root.starts_with("l:") || a.root.starts_with("h:"))
            out.push(at_place(fb, buf(), a, extend(a.path, st)))
        else
            out.push(a)

    out
end addr_step

// -- types ----------------------------------------------------------------------------------------

// The struct or enum a step lands on, which is what a path is cut at.
private nominal(t: Type) -> string = t match
    Struct(d) -> last_segment(d.base)
    Enum(d) -> last_segment(d.base)
    Ptr(inner) -> pointer_nominal(*inner)
    Ref(inner, _) -> pointer_nominal(*inner)
    Weak(inner) -> pointer_nominal(*inner)
    _ -> ""

// The type a field step lands on, marked `#` where the field is a raw pointer or a view: the one kind
// of field whose place is kept inside a heap object a call answers (M40, `answer_from`). The mark is
// not part of the type a path is cut at (`cut_key`).
private field_nominal(t: Type) -> string = t match
    Ptr(_) -> "#" + nominal(t)
    Slice(_, _) -> "#" + nominal(t)
    _ -> nominal(t)

// The type a step lands on, as a path is cut at it: without a raw field's `#`.
private cut_key(n: string) -> string
    if !n.starts_with("#") then return n

    val b = n.bytes

    from_utf8_unchecked(b[1..<b.len])
end cut_key

// A pointer to a struct or an enum is a type a path can repeat too: a field holding `&Type` inside a
// `Type` reached through another such field.
private pointer_nominal(inner: Type) -> string
    val n = nominal(inner)

    if n == "" then "" else "^" + n
end pointer_nominal

// A type's name without its module: two types of one name in two modules are cut as one, which only
// cuts a path sooner.
private last_segment(name: string) -> string
    val b = name.bytes
    var from: usize = 0

    for i in 0..<b.len
        if b[i] == u8('$') || b[i] == u8('.') then from = i + 1

    if from == 0 then name else from_utf8_unchecked(b[from..<b.len])
end last_segment

private pointee_of(t: Type) -> Option[Type] = t match
    Ptr(inner) -> Some(*inner)
    Ref(inner, _) -> Some(*inner)
    Weak(inner) -> Some(*inner)
    Volatile(inner) -> pointee_of(*inner)
    Slice(elem, _) -> Some(*elem)
    _ -> None

private is_ptr_type(t: Type) -> bool = t match
    Ptr(_) -> true
    _ -> false

private is_array_t(t: Type) -> bool = t match
    Array(_, _) -> true
    _ -> false

private deref_step(fb: &FBody, t: Type) -> FStep = t match
    Ref(inner, _) -> step(fb, "*", "&" + nominal(*inner))
    Weak(inner) -> step(fb, "*", "&" + nominal(*inner))
    _ -> pointee_of(t) match
        Some(inner) -> step(fb, "*", nominal(inner))
        None -> step(fb, "*", "")

// Whether a value of this type can hold an address: what a body passes around that is followed at all.
// A string is not followed -- it outlives every frame -- nor is an integer, whatever it was made from.
fpa_holds(fx: &Fpa, t: Type) -> bool = t match
    Ptr(inner) -> !is_opaque_struct_t(*inner)
    Trait(_, _, _) -> true
    Abstract(_, _) -> true
    Ref(_, _) -> true
    Weak(inner) -> fpa_holds(fx, *inner)
    Volatile(inner) -> fpa_holds(fx, *inner)
    Array(_, elem) -> fpa_holds(fx, *elem)
    Slice(_, _) -> true
    Struct(d) -> aggregate_fpa_holds(fx, t, d.base)
    Enum(d) -> aggregate_fpa_holds(fx, t, d.base)
    _ -> false

private is_opaque_struct_t(t: Type) -> bool = t match
    Struct(d) -> d.opaque
    _ -> false

private aggregate_fpa_holds(fx: &Fpa, t: Type, base: string) -> bool
    val key = type_show(t)

    fx.holds.get(key) match
        Some(v) -> return v
        None -> ()

    // Asked again while its own answer is being worked out, a type answers what its other fields say.
    fx.holds.put(key, false)

    val out = t match
        Struct(d) -> any_field_holds(fx, d.fields)
        Enum(d) ->
            var found = false

            for v in d.variants
                if any_field_holds(fx, v.fields) then found = true

            found
        _ -> false

    fx.holds.put(key, out)
    out
end aggregate_fpa_holds

private any_field_holds(fx: &Fpa, fields: Buf[(string, Type)]) -> bool
    for item in fields
        if fpa_holds(fx, item.1) then return true

    false
end any_field_holds

// `answer_may_hold` for argument `k` of the call `e`, asked once for each call and argument.
private fits_at(fx: &Fpa, e: TExpr, k: usize, answer: Type, arg: Type) -> bool
    val key = (u64(node_id(e)) << 8) | u64(k)

    fx.fits_at.get(key) match
        Some(v) -> return v
        None -> ()

    val out = answer_may_hold(fx, answer, arg)

    fx.fits_at.put(key, out)
    out
end fits_at

// **Whether a call's answer can be made of an argument, by their types** (M35). An answer of type
// `R` can hold an argument of type `A` only if a value of `A`, or an address into storage `A` holds in
// place, can be reached from `R` through fields, payloads, boxes, pointers and views: a `Type` cannot
// hold an `&Analysis`, so `resolve_type(a, …)` does not answer `a`. What an argument holds in place
// is followed through its fields, raw pointers and views, and stops at a `&T` box, whose interior is
// one heap cell (M28): a value read out of a box is not the caller's storage. A type parameter, a
// trait object or an unsettled type can hold anything, and so can an answer that is itself a raw
// pointer, which a cast may have made of any address.
private answer_may_hold(fx: &Fpa, answer: Type, arg: Type) -> bool
    if !fpa_holds(fx, answer) || !fpa_holds(fx, arg) || task_result(answer).is_some() then return true
    if is_ptr_type(answer) then return true

    val key = s"${type_show(answer)}|${type_show(arg)}"

    fx.fits.get(key) match
        Some(v) -> return v
        None -> ()

    val from = reached_from(fx, answer)
    var out = from.has("?")

    if !out
        for k in held_in_place(fx, arg)
            if k == "?" || from.has(k)
                out = true
                break

    fx.fits.put(key, out)
    out
end answer_may_hold

private reached_from(fx: &Fpa, t: Type) -> Map[string, bool]
    val top = type_show(t)

    fx.reach.get(top) match
        Some(got) -> return got
        None -> ()

    var seen: Map[string, bool] = map()
    var names: Buf[string] = buf()

    types_reached(t, false, &seen, &names)
    fx.reach.put(top, seen)
    seen
end reached_from

private held_in_place(fx: &Fpa, t: Type) -> Buf[string]
    val top = type_show(t)

    fx.lent.get(top) match
        Some(got) -> return got
        None -> ()

    var seen: Map[string, bool] = map()
    var names: Buf[string] = buf()

    types_reached(t, true, &seen, &names)
    fx.lent.put(top, names)
    names
end held_in_place

// Every type a value of `t` can reach, by name, with `addr:<T>` for every raw pointer or view to a
// `T` among them and `?` where one is open. `in_place` stops at a box, and then also names an address
// of each type reached, since an address into what an argument holds in place may be answered.
private types_reached(t: Type, in_place: bool, seen: *Map[string, bool], names: *Buf[string])
    var work: Buf[Type] = buf()

    work.push(t)

    loop
        val next = work.pop()

        if next.is_none() then break

        val cur = next.unwrap()
        val key = type_show(cur)

        if seen.has(key) then continue

        name_type(seen, names, key)

        if in_place then name_type(seen, names, s"addr:$key")

        cur match
            Abstract(_, _) -> name_type(seen, names, "?")
            Trait(_, _, _) -> name_type(seen, names, "?")
            Unknown -> name_type(seen, names, "?")
            Ptr(inner) ->
                name_type(seen, names, s"addr:${type_show(*inner)}")
                work.push(*inner)
            Slice(elem, _) ->
                name_type(seen, names, s"addr:${type_show(*elem)}")
                work.push(*elem)
            Ref(inner, _) ->
                if !in_place then work.push(*inner)
            Weak(inner) ->
                if !in_place then work.push(*inner)
            Volatile(inner) -> work.push(*inner)
            Array(_, elem) -> work.push(*elem)
            Vector(_, elem) -> work.push(*elem)
            Pack(elems) ->
                for x in elems
                    work.push(x)
            Struct(d) ->
                for item in d.fields
                    work.push(item.1)
            Results(d) ->
                for item in d.fields
                    work.push(item.1)
            Enum(d) ->
                for v in d.variants
                    for item in v.fields
                        work.push(item.1)
            Constrained(d) -> work.push(d.base)
            _ -> ()
    end loop
end types_reached

private name_type(seen: *Map[string, bool], names: *Buf[string], key: string)
    if seen.has(key) then return

    seen.put(key, true)
    names.push(key)
end name_type

// **What a place can hold, by its type** (M44): for each type the place may have, the names
// `reached_from` gives for it. `None` says nothing -- every value may land there -- and is the answer
// wherever the types cannot tell: the path is one the types do not follow, the place is a raw pointer
// (a cast may have made it of any address), or an open type is reached. Asked once per place: `slot`
// is the argument written through, or `PLACE_ANSWER` / `PLACE_STORE`, and `site` the call or the store.
private place_reach(fx: &Fpa, site: TExpr, slot: usize, base: Type, at: Buf[FStep]) -> Option[Buf[Map[string, bool]]]
    val outer = (u64(node_id(site)) << 8) | u64(slot)
    val pid = path_id(fx, at)

    fx.places.get(outer) match
        Some(inner) ->
            inner.get(pid) match
                Some(r) -> return r
                None -> ()
        None -> ()

    val r = reach_at(fx, base, at)

    fx.places.get(outer) match
        Some(inner) -> inner.put(pid, r)
        None ->
            var inner: Map[u32, Option[Buf[Map[string, bool]]]] = map()

            inner.put(pid, r)
            fx.places.put(outer, inner)

    r
end place_reach

// The same from a value of type `base`, once per type and path.
private reach_at(fx: &Fpa, base: Type, at: Buf[FStep]) -> Option[Buf[Map[string, bool]]]
    val key = (u64(enter_types(fx, base)) << 32) | u64(path_id(fx, at))

    fx.reach_of.get(key) match
        Some(r) -> return r
        None -> ()

    val r = reach_of_types(fx, types_along(fx, base, at))

    fx.reach_of.put(key, r)
    r
end reach_at

private reach_of_types(fx: &Fpa, found: Option[Buf[Type]]) -> Option[Buf[Map[string, bool]]]
    if found.is_none() then return None

    var out: Buf[Map[string, bool]] = buf()

    for t in found.unwrap()
        if !fpa_holds(fx, t) || is_ptr_type(t) || task_result(t).is_some() then return None

        val from = reached_from(fx, t)

        if from.has("?") then return None

        out.push(from)
    end for

    Some(out)
end reach_of_types

// **The types the place at the end of `path` may have**, from a value of type `root`: a field by its
// index, a variant's field by its variant, the pointee of a pointer, box or view, an array's element,
// each step held to the name it says it lands on. A `~` stands for anywhere at or below where it is,
// which the type there already covers.
//
// **A path may have been cut** (`extend`): a step landing on a name the path already went through
// went back to where it first did, so the steps after a named landing may be a deeper value's of
// that name -- `BufCore[Stmt]` inside `BufCore[Program]`, or a type of the same name in another
// module. So at every named landing each type of that name the root can reach is a candidate too, and
// the steps after it keep only the candidates whose names agree.
private types_along(fx: &Fpa, root: Type, path: Buf[FStep]) -> Option[Buf[Type]]
    var from: Option[Map[string, bool]] = None
    var cur: Buf[Type] = buf()

    cur.push(root)

    for st in path
        if st.s == "~" then break

        var next: Buf[Type] = buf()

        for t in cur
            val got = step_type(t, st.s)

            if got.is_some() && step_named(t, st, got.unwrap()) then next.push(got.unwrap())

        val key = cut_key(st.n)

        if key != ""
            if from.is_none() then from = Some(reached_from(fx, root))

            named_in(fx, key, from.unwrap(), &next)

            if st.s == "*" && key.starts_with("&") then named_in(fx, without_box_mark(key), from.unwrap(), &next)
        end if

        if next.is_empty() then return None

        cur = next
    end for

    Some(cur)
end types_along

// A box step's name without its `&`: the name of the type inside the box.
private without_box_mark(key: string) -> string
    val b = key.bytes

    from_utf8_unchecked(b[1..<b.len])
end without_box_mark

// Whether a step from a value of type `t` onto `landed` names what it lands on as `st` does, as
// `deref_step` and `field_nominal` name it. A step that names nothing agrees with every type.
private step_named(t: Type, st: FStep, landed: Type) -> bool
    if st.n == "" then return true

    val key = cut_key(st.n)
    val n = nominal(landed)

    if st.s == "*" then key == n || key == "&" + n else key == cut_key(field_nominal(landed))
end step_named

// The types of each name a cut path may have landed on (`types_along`): every type named so far, by
// name, with how each is shown. Entering a type enters everything it can reach, through boxes too, so
// once `t` is entered the types of a name `t` can reach are among those listed under it, told from the
// rest by `reached_from`. Answers `t`'s number, by which a place's answer is remembered.
private enter_types(fx: &Fpa, t: Type) -> u32
    val top = type_show(t)

    fx.type_ids.get(top) match
        Some(id) -> return id
        None -> ()

    var work: Buf[Type] = buf()

    work.push(t)

    loop
        val next = work.pop()

        if next.is_none() then break

        val cur = next.unwrap()
        val key = type_show(cur)

        if fx.type_ids.has(key) then continue

        fx.type_ids.put(key, u32(fx.type_ids.len()))

        val n = nominal(cur)

        if n != ""
            var list: Buf[(Type, string)] = fx.named.get(n).unwrap_or(buf())

            list.push((cur, key))
            fx.named.put(n, list)
        end if

        cur match
            Ptr(inner) -> work.push(*inner)
            Slice(elem, _) -> work.push(*elem)
            Ref(inner, _) -> work.push(*inner)
            Weak(inner) -> work.push(*inner)
            Volatile(inner) -> work.push(*inner)
            Array(_, elem) -> work.push(*elem)
            Vector(_, elem) -> work.push(*elem)
            Pack(elems) ->
                for x in elems
                    work.push(x)
            Struct(d) ->
                for item in d.fields
                    work.push(item.1)
            Results(d) ->
                for item in d.fields
                    work.push(item.1)
            Enum(d) ->
                for v in d.variants
                    for item in v.fields
                        work.push(item.1)
            Constrained(d) -> work.push(d.base)
            _ -> ()
    end loop

    fx.type_ids.get(top).unwrap_or(0)
end enter_types

// Every type entered under the name `key` (`enter_types`) that the root can reach (`from`), added to
// `out`.
private named_in(fx: &Fpa, key: string, from: Map[string, bool], out: *Buf[Type])
    fx.named.get(key) match
        Some(list) ->
            for t in list
                if from.has(t.1) then out.push(t.0)
        None -> ()
end named_in

private step_type(t: Type, s: string) -> Option[Type] = t match
    Volatile(inner) -> step_type(*inner, s)
    Constrained(d) -> step_type(d.base, s)
    Array(_, elem) -> if s == "[]" then Some(*elem) else None
    Struct(d) -> field_by_step(d.fields, s)
    Results(d) -> field_by_step(d.fields, s)
    Enum(d) ->
        for v in d.variants
            for k in 0..<v.fields.len()
                if variant_step(v, k) == s then return Some(v.fields[k].1)

        None
    _ -> if s == "*" then pointee_of(t) else None

private field_by_step(fields: Buf[(string, Type)], s: string) -> Option[Type]
    for k in 0..<fields.len()
        if s == s".$k" then return Some(fields[k].1)

    None
end field_by_step

// What is written at a place, less each parameter's own value whose type the place cannot hold: an
// `&Analysis` read out of the box of an analyzer that holds it is not stored into a `Type`'s list,
// whatever else was read out of that box (M28 makes a box's interior one cell). Only a parameter's
// value itself is told apart, since its type is the parameter's.
private held_by_place(fb: &FBody, v: Buf[FAtom], reach: Option[Buf[Map[string, bool]]]) -> Buf[FAtom]
    if reach.is_none() then return v

    val from = reach.unwrap()
    var out: Buf[FAtom] = buf()
    var dropped = false

    for x in v
        if x.path.is_empty() && x.root.starts_with("p") && !param_fits(fb, param_of(x.root), from)
            dropped = true
            continue
        end if

        out.push(x)
    end for

    if dropped then out else v
end held_by_place

// What parameter `i` can hold where its value along `at` points (`reach_at`), once per body.
private param_reach(fb: &FBody, i: usize, at: Buf[FStep], at_id: u32) -> Option[Buf[Map[string, bool]]]
    val key = (u64(i) << 32) | u64(at_id)

    fb.reach.get(key) match
        Some(r) -> return r
        None -> ()

    val r = reach_at(fb.fx, fb.f.params[i].1, at)

    fb.reach.put(key, r)
    r
end param_reach

// Whether a parameter's own value is among `v`: the one thing `held_by_place` tells apart, so the
// place's type is asked only then.
private has_param_value(v: Buf[FAtom]) -> bool
    for x in v
        if x.path.is_empty() && x.root.starts_with("p") then return true

    false
end has_param_value

// Whether a place that can reach the types `from` can hold parameter `i`'s value, or an address into
// what it holds in place (`answer_may_hold`'s rule, for a place rather than an answer).
private param_fits(fb: &FBody, i: usize, froms: Buf[Map[string, bool]]) -> bool
    if i >= fb.f.params.len() then return true

    val names = fb.held.get(i) match
        Some(got) -> got
        None ->
            val t = fb.f.params[i].1
            val got: Buf[string] = if fpa_holds(fb.fx, t) then held_in_place(fb.fx, t) else buf()

            fb.held.put(i, got)
            got

    for k in names
        if k == "?" then return true

        for from in froms
            if from.has(k) then return true
    end for

    false
end param_fits

// An argument's atoms where the answer's type can hold it, and none where it cannot.
private answered_arg(fx: &Fpa, answer: Type, args: Buf[TExpr], k: usize, v: Buf[FAtom]) -> Buf[FAtom] =
    if k >= args.len() || answer_may_hold(fx, answer, texpr_type(args[k])) then v else buf()

// -- expressions ----------------------------------------------------------------------------------

private eval_block(fb: &FBody, b: TBlock) -> Buf[FAtom]
    for s in b.stmts
        eval_stmt(fb, s)

    if b.result.is_some() then eval(fb, b.result.unwrap()) else buf()
end eval_block

private eval_stmts(fb: &FBody, stmts: Buf[TStmt])
    for s in stmts
        eval_stmt(fb, s)
end eval_stmts

private eval_opt_block(fb: &FBody, b: Option[TBlock]) -> Buf[FAtom] =
    if b.is_some() then eval_block(fb, b.unwrap()) else buf()

private eval_stmt(fb: &FBody, s: TStmt)
    s match
        TVarDecl(name, ty, init, _) ->
            val v = eval(fb, init)

            if fpa_holds(fb.fx, ty) then add_to(fb, s"l:$name", v)
        TExprStmt(e) -> eval(fb, e)
        TInvariant(cond, _) -> eval(fb, cond)
        TVariantCheck(slot, _, e) -> add_to(fb, s"l:$slot", eval(fb, e))
        TRefDecl(name, _, place) ->
            fb.refs.put(name, place)
            addr(fb, place)
        TWriteStmt(w) -> store(fb, w.place, eval(fb, w.value))
        TMultiAssign(writes) ->
            var vals: Buf[Buf[FAtom]] = buf()

            for w in writes
                vals.push(eval(fb, w.value))

            for i in 0..<writes.len()
                store(fb, writes[i].place, vals[i])
        TReturn(value) -> if value.is_some() then add_to(fb, "$ret", eval(fb, value.unwrap()))
        TBecome(call) -> add_to(fb, "$ret", eval(fb, call))
        TBreak(value, _) -> if value.is_some() then add_to(fb, "$brk", eval(fb, value.unwrap()))
        TDefer(stmts, _) -> eval_stmts(fb, stmts)
        _ -> ()
end eval_stmt

// What a value may be made of, with every store and call on the way noted.
private eval(fb: &FBody, e: TExpr) -> Buf[FAtom]
    val v = eval_kind(fb, e)

    if v.is_empty() then v else if fpa_holds(fb.fx, texpr_type(e)) then distinct(v) else buf()
end eval

private eval_kind(fb: &FBody, e: TExpr) -> Buf[FAtom] = *e.kind match
    TLoad(name, _) -> fb.refs.get(name) match
        Some(place) -> eval(fb, place)
        None -> copy_of(cell(fb, s"l:$name"))
    TGlobal(_, ty, _) -> if fpa_holds(fb.fx, ty) then single(atom(fb, buf(), "g", buf())) else buf()
    TAddrOf(place, _) -> addr(fb, place)
    TTempAddr(value, _) ->
        val name = s"l:$$t${node_id(e)}"

        add_to(fb, name, eval(fb, value))
        single(atom(fb, buf(), name, buf()))
    TDeref(op, _) -> project(fb, eval(fb, op), deref_step(fb, texpr_type(op)))
    TField(recv, index, ty) ->
        val rt = texpr_type(recv)
        var v = eval(fb, recv)

        if pointee_of(rt).is_some() && !is_slice_t(rt) then v = project(fb, v, deref_step(fb, rt))

        project(fb, v, step(fb, s".$index", field_nominal(ty)))
    TIndex(recv, index, ty) ->
        eval(fb, index)

        val rt = texpr_type(recv)
        val v = eval(fb, recv)

        if is_array_t(rt) then project(fb, v, step(fb, "[]", nominal(ty)))
        else project(fb, v, step(fb, "*", nominal(ty)))
    TSlice(base, lo, hi, _, _) ->
        if lo.is_some() then eval(fb, lo.unwrap())
        if hi.is_some() then eval(fb, hi.unwrap())

        val bt = texpr_type(base)

        if is_array_t(bt) then addr_step(fb, addr(fb, base), elem_step()) else eval(fb, base)
    TBox(value, _) ->
        val name = heap_site(e)

        add_to(fb, name, eval(fb, value))
        single(atom(fb, buf(), name, buf()))
    TBufLit(elems, _) -> fresh_of(fb, e, eval_all(fb, elems))
    TBufFill(value, count, _) ->
        eval(fb, count)
        fresh_of(fb, e, eval(fb, value))
    TStructNew(_, args) ->
        var out: Buf[FAtom] = buf()

        for k in 0..<args.len()
            join_into(&out, placed_step(fb, eval(fb, args[k]), s".$k", field_nominal(texpr_type(args[k]))))

        made(fb, e, out)
    TEnumNew(_, variant, args) ->
        var out: Buf[FAtom] = buf()

        for k in 0..<args.len()
            join_into(&out, placed_step(fb, eval(fb, args[k]), variant_step(variant, k), field_nominal(texpr_type(args[k]))))

        made(fb, e, out)
    TArrayLit(elems, _) -> placed_step(fb, eval_all(fb, elems), "[]", "")
    TArrayFill(value, _) -> placed_step(fb, eval(fb, value), "[]", "")
    TStore(place, value, _, yields) ->
        val v = eval(fb, value)

        store(fb, place, v)
        if yields then v else buf()
    TUpdate(place, _, value, _, _, _, _) ->
        val v = eval(fb, value)
        val old = eval(fb, place)

        store(fb, place, v)

        var out = copy_of(old)

        join_into(&out, v)
        out
    TSlots(op, args, _, _) ->
        val vals = eval_each(fb, args)

        if op == "slot_storage" then fresh_of(fb, e, buf())
        else
            if op == "slot_place" && vals.len() > 2 then store_at(fb, vals[0], vals[2])

            buf()
    TAtomic(_, address, ops, _, _, _) ->
        val at = eval(fb, address)
        val vals = eval_all(fb, ops)

        store_at(fb, at, vals)

        var out = project(fb, at, deref_step(fb, texpr_type(address)))

        join_into(&out, vals)
        out
    TCall(name, args, _, _) -> call(fb, e, name, args, eval_each(fb, args))
    TVCall(recv, slot, args, ty, _) -> vcall(fb, recv, slot, args, eval_each(fb, args), ty)
    TCallPtr(callee, args, _, _) ->
        eval(fb, callee)

        val argv = eval_each(fb, args)
        var out: Buf[FAtom] = buf()

        for k in 0..<argv.len()
            lend(fb, argv[k])
            join_into(&out, anywhere_in(fb, answered_arg(fb.fx, texpr_type(e), args, k, argv[k])))

        out
    TStep(task, wake) ->
        eval(fb, task)
        keep(fb, eval(fb, wake))
        buf()
    TPark(register) ->
        keep(fb, eval(fb, register))
        buf()
    TTry(operand, ok, _, _, _, ty, _) ->
        val v = eval(fb, operand)

        add_to(fb, "$ret", anywhere_in(fb, v))
        project(fb, v, step(fb, variant_step(ok, 0), field_nominal(ty)))
    TSeq(exprs) ->
        var last: Buf[FAtom] = buf()

        for x in exprs
            last = eval(fb, x)

        last
    TIf(cond, then_block, else_block, _) ->
        eval_conds(fb, cond)

        var out = eval_block(fb, then_block)

        join_into(&out, eval_opt_block(fb, else_block))
        out
    TMatch(scrutinee, arms, _) ->
        val st = texpr_type(scrutinee)
        val v = eval(fb, scrutinee)
        var out: Buf[FAtom] = buf()

        for arm in arms
            for p in arm.patterns
                bind(fb, p, v, st)

            if arm.guard.is_some() then eval(fb, arm.guard.unwrap())

            join_into(&out, eval_block(fb, arm.body))

        out
    TBlockExpr(block) -> eval_block(fb, block)
    TWhile(cond, body, else_block, _) ->
        eval_conds(fb, cond)
        eval_stmts(fb, body)
        loop_result(fb, else_block)
    TDoWhile(body, cond, else_block, _) ->
        eval_stmts(fb, body)
        eval(fb, cond)
        loop_result(fb, else_block)
    TLoop(body, _) ->
        eval_stmts(fb, body)
        loop_result(fb, None)
    TFor(_, _, lo, hi, _, body, else_block, _) ->
        eval(fb, lo)
        eval(fb, hi)
        eval_stmts(fb, body)
        loop_result(fb, else_block)
    TCFor(init, cond, step, body, else_block, _) ->
        eval_stmts(fb, init)
        if cond.is_some() then eval(fb, cond.unwrap())
        eval_stmts(fb, body)
        eval_stmts(fb, step)
        loop_result(fb, else_block)
    TForEach(name, elem_ty, seq, body, else_block, _) ->
        val st = texpr_type(seq)
        val v = eval(fb, seq)

        if fpa_holds(fb.fx, elem_ty)
            val elems = if is_array_t(st) then project(fb, v, step(fb, "[]", nominal(elem_ty)))
            else if pointee_of(st).is_some() then project(fb, v, step(fb, "*", nominal(elem_ty)))
            else reachable(fb, v)

            add_to(fb, s"l:$name", elems)
        end if

        eval_stmts(fb, body)
        loop_result(fb, else_block)
    TIterate(cursor, _, init, next, pattern, body, else_block, _) ->
        add_to(fb, s"l:$cursor", eval(fb, init))

        val got = eval(fb, next)

        add_to(fb, s"l:$cursor", reachable(fb, got))
        bind(fb, pattern, got, texpr_type(next))
        eval_stmts(fb, body)
        loop_result(fb, else_block)
    TQuantifier(_, _, _, lo, hi, _, pred) ->
        eval(fb, lo)
        eval(fb, hi)
        eval(fb, pred)
        buf()
    TCheckedLoop(_, _, loop_expr) -> eval(fb, loop_expr)
    TCast(operand, _) -> eval(fb, operand)

    // A task driven where its call is written ends before the expression does, so what its call was
    // handed is not lent past it.
    TAwait(task, _) ->
        fb.driven.put(node_id(task), true)
        eval(fb, task)
    TBlockOn(task, _) ->
        fb.driven.put(node_id(task), true)
        eval(fb, task)
    TFuncAddr(_, _, _) -> buf()

    // Bytes made into a string in place have left the call: a string outlives every frame
    // (`escape.sysl`'s `carries_view`), so what they view is kept, and the string holds nothing to
    // follow.
    TStrView(v) ->
        keep(fb, eval(fb, v))
        buf()
    _ ->
        var out: Buf[FAtom] = buf()

        for c in texpr_children(e)
            join_into(&out, eval(fb, c))

        out
end eval_kind

private is_slice_t(t: Type) -> bool = t match
    Slice(_, _) -> true
    _ -> false

private single(a: FAtom) -> Buf[FAtom]
    var out: Buf[FAtom] = buf()

    out.push(a)
    out
end single

private copy_of(v: Buf[FAtom]) -> Buf[FAtom]
    var out: Buf[FAtom] = buf()

    join_into(&out, v)
    out
end copy_of

private eval_all(fb: &FBody, es: Buf[TExpr]) -> Buf[FAtom]
    var out: Buf[FAtom] = buf()

    for x in es
        join_into(&out, eval(fb, x))

    out
end eval_all

private eval_each(fb: &FBody, es: Buf[TExpr]) -> Buf[Buf[FAtom]]
    var out: Buf[Buf[FAtom]] = buf()

    for x in es
        out.push(eval(fb, x))

    out
end eval_each

// A value constructed: in place, or -- a type with a destructor, whose construction yields `&T` -- in
// a heap object made here.
private made(fb: &FBody, e: TExpr, parts: Buf[FAtom]) -> Buf[FAtom] = texpr_type(e) match
    Ref(_, _) -> fresh_of(fb, e, parts)
    _ -> parts

// A heap object made here, holding `held` as what it points at.
private fresh_of(fb: &FBody, e: TExpr, held: Buf[FAtom]) -> Buf[FAtom]
    val name = heap_site(e)

    add_to(fb, name, held)
    single(atom(fb, buf(), name, buf()))
end fresh_of

// **A heap object is named by the node that makes it** (`node_id`), never by where it was written: a
// default's reading, a chain of calls and a generic instantiation put many nodes at one place. The
// name is compared and looked up, never printed or ordered.
private heap_site(e: TExpr) -> string = s"h:${node_id(e)}"

// What a loop yields: whatever any `break` in the body carried, or its `else`.
private loop_result(fb: &FBody, else_block: Option[TBlock]) -> Buf[FAtom]
    var out = copy_of(cell(fb, "$brk"))

    join_into(&out, eval_opt_block(fb, else_block))
    out
end loop_result

private eval_conds(fb: &FBody, terms: Buf[TCondTerm])
    for t in terms
        t match
            TCondTest(c) -> eval(fb, c)
            TCondIs(subject, patterns, _) ->
                val st = texpr_type(subject)
                val v = eval(fb, subject)

                for p in patterns
                    bind(fb, p, v, st)
end eval_conds

// Everything a value may reach: itself anywhere inside, and what any address it holds points at.
private reachable(fb: &FBody, v: Buf[FAtom]) -> Buf[FAtom]
    var out: Buf[FAtom] = buf()
    var seen: Map[u64, bool] = map()
    var work = copy_of(v)
    var at: usize = 0

    while at < work.len()
        val a = work[at]

        at += 1

        if seen.has(a.key) then continue

        seen.put(a.key, true)

        if a.root.starts_with("p")
            out.push(at_place(fb, buf(), a, extend(a.path, tilde_step())))
        else if a.root.starts_with("l:") || a.root.starts_with("h:")
            out.push(moved(fb, buf(), a))

            for b in cell(fb, a.root)
                work.push(b)
        end if

    out
end reachable

// The names a pattern binds, each to the part of the value it matched. `vt` is the type of the value
// matched: a struct or variant pattern matched against a pointer to one looks through it first, at
// every depth -- a field holding `&T` matched by `T`'s own pattern included.
private bind(fb: &FBody, p: TPattern, v: Buf[FAtom], vt: Type)
    p match
        TBindPattern(name, ty) -> if fpa_holds(fb.fx, ty) then add_to(fb, s"l:$name", v)
        TAtPattern(name, inner) ->
            add_to(fb, s"l:$name", v)
            bind(fb, *inner, v, vt)
        TVariantPattern(_, variant, args) ->
            val sv = through_pointer(fb, v, vt)

            for k in 0..<args.len()
                val ft = field_type(variant.fields, k, tpattern_type(args[k]))

                bind(fb, args[k], project(fb, sv, step(fb, variant_step(variant, k), field_nominal(ft))), ft)
        TStructPattern(decl, args) ->
            val sv = through_pointer(fb, v, vt)

            for k in 0..<args.len()
                val ft = field_type(decl.fields, k, tpattern_type(args[k]))

                bind(fb, args[k], project(fb, sv, step(fb, s".$k", field_nominal(ft))), ft)
        _ -> ()
end bind

// A value matched by a destructuring pattern: what it points at, where it is a pointer.
private through_pointer(fb: &FBody, v: Buf[FAtom], vt: Type) -> Buf[FAtom] =
    if pointee_of(vt).is_some() && !is_slice_t(vt) then project(fb, v, deref_step(fb, vt)) else v

private field_type(fields: Buf[(string, Type)], k: usize, otherwise: Type) -> Type =
    if k < fields.len() then fields[k].1 else otherwise

// -- places ---------------------------------------------------------------------------------------

// The addresses a place may be at.
private addr(fb: &FBody, place: TExpr) -> Buf[FAtom] = *place.kind match
    TLoad(name, _) -> fb.refs.get(name) match
        Some(p) -> addr(fb, p)
        None -> single(atom(fb, buf(), s"l:$name", buf()))
    TGlobal(_, _, _) -> single(atom(fb, buf(), "g", buf()))
    TField(recv, index, ty) ->
        val rt = texpr_type(recv)
        val st = step(fb, s".$index", field_nominal(ty))

        if pointee_of(rt).is_some() && !is_slice_t(rt) then addr_step(fb, eval(fb, recv), st)
        else addr_step(fb, addr(fb, recv), st)
    TIndex(recv, index, ty) ->
        eval(fb, index)

        if is_array_t(texpr_type(recv)) then addr_step(fb, addr(fb, recv), step(fb, "[]", nominal(ty)))
        else eval(fb, recv)
    TDeref(op, _) -> eval(fb, op)
    _ -> eval(fb, place)
end addr

// A value stored into a place.
private store(fb: &FBody, place: TExpr, v: Buf[FAtom])
    val at = addr(fb, place)
    val held = if !has_param_value(v) then v
    else held_by_place(fb, v, place_reach(fb.fx, place, PLACE_STORE, texpr_type(place), buf()))

    if !held.is_empty() then store_at(fb, at, held)
end store

// A value stored at each address: into what a local or a heap object holds there, through a
// parameter, or into module storage.
private store_at(fb: &FBody, at: Buf[FAtom], v: Buf[FAtom])
    if v.is_empty() then return

    for a in at
        // An address held somewhere inside a value -- at an offset in it (`.0` of a buffer, a variant's
        // payload), or anywhere at or below one (`~`) -- is still the address of its own root's
        // storage, though which of the value's pointers the store went through is not told apart:
        // stored into anywhere there.
        val inside = !a.off.is_empty()

        if a.root.starts_with("l:") || a.root.starts_with("h:")
            add_to(fb, a.root, if inside then anywhere_in(fb, v) else placed(fb, v, a.path))
        else if a.root.starts_with("p")
            // Stored through a parameter, which is the caller's to place, where the parameter's value
            // along the address's path points (`.0` for the pointer a handle holds in its first
            // field), or anywhere inside that; a value of the parameter stored back into what it points
            // at is not kept by that.
            val at_path = if inside then extend(a.path, tilde_step()) else a.path
            val at_id = path_id(fb.fx, at_path)
            var out: Buf[FAtom] = buf()

            for b in v
                if b.rid != a.rid
                    if !b.root.starts_with("p") || !covered(fb.fx, &fb.thru, u64(pair_id(fb.fx, pair_id(fb.fx, a.rid, b.rid), at_id)) << 32, without_tilde(b.path))
                        out.push(moved(fb, buf(), b))

            // What the parameter can hold there, by its own type, bounds what lands (M44): the place may
            // have been reached through a box's whole interior, where a store into one field of the
            // box is a store into every value the box holds.
            val dest = param_of(a.root)
            val held = if !has_param_value(out) || dest >= fb.f.params.len() then out
            else held_by_place(fb, out, param_reach(fb, dest, at_path, at_id))

            add_to(fb, dest_cell(fb, dest, at_path, at_id), held)
        else
            keep(fb, v)
end store_at

// The cell of what is stored through parameter `dest` where its value along `at` points.
private dest_cell(fb: &FBody, dest: usize, at: Buf[FStep], at_id: u32) -> string
    val k = (u64(dest) << 32) | u64(at_id)

    fb.dests.get(k) match
        Some(name) -> return name
        None -> ()

    val name = s"$$thr$dest:$at_id"

    fb.dests.put(k, name)
    fb.dest_list.push((name, dest, at))
    name
end dest_cell

// -- calls ----------------------------------------------------------------------------------------

// A call by name: its summary applied to the arguments, or its declaration where no body is in sight.
private call(fb: &FBody, e: TExpr, name: string, args: Buf[TExpr], argv: Buf[Buf[FAtom]]) -> Buf[FAtom]
    val ty = texpr_type(e)

    fb.fx.index.get(name) match
        Some(i) ->
            if fb.fx.funcs[i].marks.is_async() && !fb.driven.has(node_id(e))
                for v in argv
                    lend(fb, v)

            return apply(fb, e, fb.fx.sums[i], args, argv)
        None -> ()

    fb.fx.an.tables.externs.get(name) match
        Some(d) ->
            var out: Buf[FAtom] = buf()

            // **C may point what a pointer argument points at anywhere**: where the pointee can itself
            // hold an address (`zap(pp: ***int)`), the caller's place there may afterwards point at
            // storage that outlives every frame, as `redirect(pp) = *pp = &slot` would.
            for k in 0..<argv.len()
                val pt = if k < args.len() then pointee_of(texpr_type(args[k])) else None

                if pt.is_some() && fpa_holds(fb.fx, pt.unwrap())
                    var memo: Map[u32, Buf[FAtom]] = map()

                    store_at(fb, written_at(fb, argv[k], buf(), &memo), single(atom(fb, buf(), "g", buf())))
                end if

            for k in 0..<argv.len()
                if k < d.params.len() && holds_string(d.keeps, d.params[k].name) then keep(fb, argv[k])
                if k < d.params.len() && holds_string(d.answers, d.params[k].name)
                    join_into(&out, anywhere_in(fb, answered_arg(fb.fx, ty, args, k, argv[k])))

            return out
        None -> ()

    var out: Buf[FAtom] = buf()

    for k in 0..<argv.len()
        lend(fb, argv[k])
        join_into(&out, anywhere_in(fb, answered_arg(fb.fx, ty, args, k, argv[k])))

    out
end call

// A summary applied at a call: what it keeps of each argument is kept, what it writes through one
// argument is stored where that argument points, and its answer is made of the arguments where the
// summary says. A heap object the call made is one object per call site, holding everything the
// summary places inside one.
private apply(fb: &FBody, e: TExpr, sum: &FpaSum, args: Buf[TExpr], argv: Buf[Buf[FAtom]]) -> Buf[FAtom]
    if !fb.fx.tracing then return apply_inner(fb, e, sum, args, argv)

    val t0 = monotonic().us
    val r = apply_inner(fb, e, sum, args, argv)
    val dt = monotonic().us - t0

    if dt > 50000
        var na = 0

        for v in argv
            na += int(v.len())

        eprints(s"FPA-APPLY ${fb.f.name} at ${e.span.start} us $dt size ${sum.size} writes ${sum.writes.len()} argatoms $na\n")
    end if

    r
end apply

private apply_inner(fb: &FBody, e: TExpr, sum: &FpaSum, args: Buf[TExpr], argv: Buf[Buf[FAtom]]) -> Buf[FAtom]
    val blob = heap_site(e)
    val ty = texpr_type(e)
    var out: Buf[FAtom] = buf()
    val n = if argv.len() < sum.kept.len() then argv.len() else sum.kept.len()

    // What is written through each argument, gathered by where it is written, so each place is found
    // once and stored into once.
    var group_of: Map[u64, usize] = map()
    var groups: Buf[(usize, Buf[FStep], Buf[FAtom])] = buf()

    for w in sum.writes
        if w.0 < argv.len() && w.1 < argv.len()
            val gk = (u64(w.0) << 32) | u64(path_id(fb.fx, w.3))

            if !group_of.has(gk)
                group_of.put(gk, groups.len())
                groups.push((w.0, w.3, buf()))
            end if

    for k in 0..<n
        // The paths of one parameter share their beginnings, so each is followed once.
        var memo: Map[u32, Buf[FAtom]] = map()

        // What one path of the argument reaches is the same for every place it is written to.
        var reached: Map[u32, Buf[FAtom]] = map()

        for w in sum.writes
            if w.1 == k && w.0 < argv.len()
                val g = group_of.get((u64(w.0) << 32) | u64(path_id(fb.fx, w.3))).unwrap()
                val pid = path_id(fb.fx, w.2)
                val got = reached.get(pid) match
                    Some(v) -> v
                    None ->
                        val v = anywhere_in(fb, summary_along(fb, argv[k], w.2, &memo))

                        reached.put(pid, v)
                        v

                // A buffer copied is a second name for the one buffer, so this adds to the group's.
                var into = groups[g].2

                // A parameter's own value lands only where the place's type can hold it (M44).
                val held = if !has_param_value(got) || argv.len() != args.len() || w.0 >= args.len() then got
                else held_by_place(fb, got, place_reach(fb.fx, e, w.0, texpr_type(args[w.0]), w.3))

                join_into(&into, held)
            end if

        for p in sum.kept[k]
            keep(fb, summary_along(fb, argv[k], p, &memo))

        for p in sum.lent[k]
            lend(fb, summary_along(fb, argv[k], p, &memo))

        // What the answer cannot hold by its type is not answered (M35). A path through a pointer is
        // left as the summary says: through a box it reaches what the box holds, whose type is not the
        // argument's, and a raw pointer may point into a box too -- `Buf`'s `&*self.core` is the
        // address of its core's interior, and its storage is read through it.
        val fits = k >= args.len() || fits_at(fb.fx, e, k, ty, texpr_type(args[k]))

        for item in sum.answers[k]
            if !fits && !has_deref(item.0) then continue

            // A parameter's own value read out of a box along the path is answered only where the
            // answer's type can hold it there (M44).
            val read = summary_along(fb, argv[k], item.0, &memo)
            val got = if !has_param_value(read) then read
            else held_by_place(fb, read, place_reach(fb.fx, e, PLACE_ANSWER, ty, item.1))

            if has_deref(item.1) then into_made(fb, blob, item.1, got) else join_into(&out, placed(fb, got, item.1))

    // Each place written is stored into once, with everything written there: the places reached along
    // different paths are often one place -- a box's whole interior above all.
    var place_of: Map[u64, usize] = map()
    var places: Buf[FAtom] = buf()
    var held: Buf[Buf[FAtom]] = buf()

    for d in 0..<argv.len()
        var memo: Map[u32, Buf[FAtom]] = map()

        for g in groups
            if g.0 != d || g.2.is_empty() then continue

            for a in written_at(fb, argv[d], g.1, &memo)
                if !place_of.has(a.key)
                    place_of.put(a.key, places.len())
                    places.push(a)
                    held.push(buf())

                val at = place_of.get(a.key).unwrap()

                // A buffer copied is a second name for the one buffer, so this adds to the place's.
                var into = held[at]

                join_into(&into, g.2)
            end for
        end for

    for i in 0..<places.len()
        store_at(fb, single(places[i]), distinct(held[i]))

    // A place the callee pointed at module storage, itself or through a call of its own.
    for w in sum.foreign
        if w.0 < argv.len()
            var memo: Map[u32, Buf[FAtom]] = map()

            store_at(fb, written_at(fb, argv[w.0], w.1, &memo), single(atom(fb, buf(), "g", buf())))
        end if

    for o in sum.fresh
        val k = inside_kind(o)

        if k.0 == 0 then out.push(atom(fb, o, blob, buf()))
        else if k.0 == 1 then raw_object(fb, blob, o, k.1)
        else if k.0 == 2
            val inner = raw_object(fb, blob, o, k.1)

            add_to(fb, inner, single(atom(fb, one_step(tilde_step()), inner, buf())))
        else
            add_to(fb, blob, single(atom(fb, one_step(tilde_step()), blob, buf())))
        end if

    out
end apply_inner

// **What a call's answer holds inside a heap object it made, placed in the caller** (M40). The
// objects a call makes are one heap cell, `blob`, except what a raw-pointer or view field of one of
// them points at -- a `Buf` core's storage -- which is a cell of its own, held at that field: a value
// at the field sits there, one inside what it points at sits anywhere in that cell, and anything
// else anywhere in `blob`.
private into_made(fb: &FBody, blob: string, off: Buf[FStep], v: Buf[FAtom])
    val k = inside_kind(off)

    if k.0 == 1 then add_to(fb, blob, placed(fb, v, one_step(off[k.1 - 1])))
    else if k.0 == 2 then add_to(fb, raw_object(fb, blob, off, k.1), anywhere_in(fb, v))
    else add_to(fb, blob, anywhere_in(fb, v))
end into_made

// The cell of what the raw field at `off`'s first `n` steps points at, held in `blob` at that field.
private raw_object(fb: &FBody, blob: string, off: Buf[FStep], n: usize) -> string
    val name = s"$blob#${path_id(fb.fx, prefix_of(off, n))}"

    add_to(fb, blob, single(atom(fb, one_step(off[n - 1]), name, buf())))
    name
end raw_object

// **What a summary's path names in an argument.** A path that stops inside a box (M28) names the box's
// whole interior at every depth, so in the caller it is what the interior holds, each part sitting
// anywhere -- never at its own place, which the callee did not tell apart. What those parts reach
// further in is followed from them where it is read (`project_one`), and kept with them where kept.
private summary_along(fb: &FBody, v: Buf[FAtom], p: Buf[FStep], memo: *Map[u32, Buf[FAtom]]) -> Buf[FAtom]
    val got = along_shared(fb, v, p, memo)

    if ends_whole(p) then anywhere_in(fb, got) else got
end summary_along

// **Where a callee's store through a parameter lands in the caller**: the argument read along the
// path the callee stored through, which is the address it stored at -- anywhere inside it, where that
// path ends at `~`.
private written_at(fb: &FBody, v: Buf[FAtom], at: Buf[FStep], memo: *Map[u32, Buf[FAtom]]) -> Buf[FAtom]
    if at.is_empty() then return v

    if at[at.len() - 1].id == TILDE then return anywhere_in(fb, along_shared(fb, v, without_tilde(at), memo))

    along_shared(fb, v, at, memo)
end written_at

private has_box_step(p: Buf[FStep]) -> bool
    for st in p
        if is_box_step(st) then return true

    false
end has_box_step

// Whether a place in an answer is just inside a heap object the answer holds in place: its one `*` is
// its last step.
private first_inside(p: Buf[FStep]) -> bool
    if p.is_empty() || p[p.len() - 1].s != "*" then return false

    for i in 0..<p.len() - 1
        if p[i].s == "*" then return false

    true
end first_inside

// **Where in a call's answer a place inside a heap object sits** (M40), with the length of the place
// of the raw field it is at or under: `0` held in place, outside every heap object; `1` at a raw
// field of a heap object held in place (`q*f`); `2` inside what that field points at (`q*f*`); `3`
// anywhere else inside the object.
private inside_kind(p: Buf[FStep]) -> (int, usize)
    for i in 0..<p.len()
        if p[i].s == "*"
            if i + 1 < p.len() && is_raw_field_step(p[i + 1])
                if i + 2 == p.len() then return (1, i + 2)
                if p[i + 2].s == "*" then return (2, i + 2)
            end if

            return (3, 0)
        end if

    (0, 0)
end inside_kind

// The prefix of a path, its first `n` steps.
private prefix_of(p: Buf[FStep], n: usize) -> Buf[FStep]
    var out: Buf[FStep] = buf()

    for i in 0..<n
        out.push(p[i])

    out
end prefix_of

private has_deref(p: Buf[FStep]) -> bool
    for st in p
        if st.s == "*" then return true

    false
end has_deref

// A call through an object, answered by the object's type: a callable keeps what its type marks
// `@keeps`, any other trait what its method declares `@keeps` -- every argument where the call
// answers a task. The answer may be made of any argument, or of what the object holds.
private vcall(fb: &FBody, recv: TExpr, slot: int, args: Buf[TExpr], argv: Buf[Buf[FAtom]], ty: Type) -> Buf[FAtom]
    val rv = eval(fb, recv)
    val rt = texpr_type(recv)
    var assocs: Buf[(string, Type)] = buf()
    var callable = false

    erased_trait(rt) match
        Some(Trait(name, _, marks)) ->
            callable = is_call_trait(module_bare(name))
            assocs = marks
        _ -> ()

    val task = task_result(ty).is_some()
    var out = anywhere_in(fb, reachable(fb, rv))

    for k in 0..<argv.len()
        val kept = if callable then marks_kept(assocs, k) else task || object_declares_kept(fb.fx.an, rt, slot, k + 1)

        if kept then keep(fb, argv[k])
        else if callable then lend(fb, argv[k])

        join_into(&out, anywhere_in(fb, answered_arg(fb.fx, ty, args, k, argv[k])))

    out
end vcall

// -- answers --------------------------------------------------------------------------------------

private fpa_index(fx: &Fpa, name: string) -> Option[usize]
    fx.index.get(name) match
        Some(i) -> return Some(i)
        None -> ()

    for i in 0..<fx.funcs.len()
        if fx.funcs[i].name.ends_with(s".$name") then return Some(i)

    None
end fpa_index

// Whether `name` keeps its parameter `i` itself, or a field of it held in place -- what the keeps
// analysis asks (`keeps.sysl`'s `keeps_of`): a path with no `*` on it, or a store of it through
// another parameter.
fpa_keeps(fx: &Fpa, name: string, i: usize) -> bool
    val fi = fpa_index(fx, name)

    if fi.is_none() then return false

    val sum = fx.sums[fi.unwrap()]

    if i < sum.kept.len()
        for p in sum.kept[i]
            if !has_deref(p) then return true

    fpa_writes(fx, name, i)
end fpa_keeps

// **Whether `name` lets what parameter `i` holds outlive the call** -- what the escape analysis asks
// of a view (`escape.sysl`'s `kept_by`): a path of it kept, or stored through another parameter,
// that stays out of a box, or handed back inside a heap object the call made. What is inside a box
// is one heap cell (M28), never the caller's storage.
fpa_lets_out_whole(fx: &Fpa, name: string, i: usize) -> bool
    val fi = fx.index.get(name)

    if fi.is_none() then return true

    val sum = fx.sums[fi.unwrap()]

    if i < sum.kept.len()
        for p in sum.kept[i]
            if !has_box_step(p) then return true

    if i < sum.lent.len()
        for p in sum.lent[i]
            if !has_box_step(p) then return true

    for w in sum.writes
        if w.1 == i && !has_box_step(w.2) then return true

    // Handed back inside a heap object the call made -- a closure's environment, a box -- is out of
    // the escape analysis's sight: it follows a view through what a value holds in place, never into a
    // `&T` or a `&Fn` (`carries_view`), so the caller could not see the view leave with the object.
    if i < sum.answers.len()
        for item in sum.answers[i]
            if has_deref(item.1) && !has_box_step(item.0) then return true

    false
end fpa_lets_out_whole

// Whether every one of these bodies has a summary.
fpa_covers(fx: &Fpa, funcs: Buf[TFunc]) -> bool
    for f in funcs
        if !fx.index.has(f.name) then return false

    true
end fpa_covers

// Whether `name` stores its parameter `i` through another parameter, and nothing more.
fpa_writes(fx: &Fpa, name: string, i: usize) -> bool
    val fi = fpa_index(fx, name)

    if fi.is_none() then return false

    for w in fx.sums[fi.unwrap()].writes
        if w.1 == i && !has_deref(w.2) then return true

    false
end fpa_writes

// Whether `name` lets out anything of parameter `i`: the value, or anything read through it.
fpa_lets_out(fx: &Fpa, name: string, i: usize) -> bool
    val fi = fpa_index(fx, name)

    if fi.is_none() then return false

    val sum = fx.sums[fi.unwrap()]

    if i < sum.kept.len() && !sum.kept[i].is_empty() then return true

    for w in sum.writes
        if w.1 == i then return true

    false
end fpa_lets_out

// Whether what `name` answers can be made of parameter `i` itself: a path with no `*` on it.
fpa_answers(fx: &Fpa, name: string, i: usize) -> bool
    val fi = fpa_index(fx, name)

    if fi.is_none() then return false

    val sum = fx.sums[fi.unwrap()]

    if i < sum.answers.len()
        for item in sum.answers[i]
            if !has_deref(item.0) then return true

    false
end fpa_answers

// Whether `name` answers parameter `i` only from inside a heap object it made.
fpa_answers_boxed(fx: &Fpa, name: string, i: usize) -> bool
    val fi = fpa_index(fx, name)

    if fi.is_none() then return false

    val sum = fx.sums[fi.unwrap()]

    if i < sum.answers.len()
        for item in sum.answers[i]
            if has_deref(item.1) then return true

    false
end fpa_answers_boxed

// The paths `name` keeps of parameter `i`, in order, as `ε` for the value itself.
fpa_kept_text(fx: &Fpa, name: string, i: usize) -> string
    val fi = fpa_index(fx, name)

    if fi.is_none() then return "?"

    val sum = fx.sums[fi.unwrap()]
    var parts: Buf[string] = buf()

    if i < sum.kept.len()
        for p in sum.kept[i]
            parts.push(shown_path(p))

    for w in sum.writes
        if w.1 == i then parts.push(s"${shown_path(w.2)}>p${w.0}${fpa_path_text(w.3)}")

    sorted_text(parts)
end fpa_kept_text

// Where `name`'s answer holds parameter `i`, as `path@offset`.
fpa_answers_text(fx: &Fpa, name: string, i: usize) -> string
    val fi = fpa_index(fx, name)

    if fi.is_none() then return "?"

    val sum = fx.sums[fi.unwrap()]
    var parts: Buf[string] = buf()

    if i < sum.answers.len()
        for item in sum.answers[i]
            parts.push(s"${shown_path(item.0)}@${shown_path(item.1)}")

    sorted_text(parts)
end fpa_answers_text

// What a local of `name` may point to once its body has settled, which is the per-expression answer
// for every read of it.
fpa_local_text(fx: &Fpa, name: string, local: string) -> string
    val fi = fpa_index(fx, name)

    if fi.is_none() then return "?"

    val fb = settle_body(fx, fx.funcs[fi.unwrap()])

    atoms_text(cell(fb, s"l:$local"))
end fpa_local_text

// What the answer of `name` may point to.
fpa_result_text(fx: &Fpa, name: string) -> string
    val fi = fpa_index(fx, name)

    if fi.is_none() then return "?"

    val fb = settle_body(fx, fx.funcs[fi.unwrap()])

    atoms_text(cell(fb, "$ret"))
end fpa_result_text

private atoms_text(v: Buf[FAtom]) -> string
    var parts: Buf[string] = buf()

    for a in v
        val root = if a.root.starts_with("h:") then "heap"
        else if a.root.starts_with("l:$t") then "&temp"
        else if a.root.starts_with("l:") then s"&${local_name(a.root)}"
        else a.root

        val path = if a.path.is_empty() then "" else fpa_path_text(a.path)
        val off = if a.off.is_empty() then "" else s"@${fpa_path_text(a.off)}"

        parts.push(root + path + off)

    sorted_text(parts)
end atoms_text

private local_name(root: string) -> string
    val b = root.bytes

    from_utf8_unchecked(b[2..<b.len])
end local_name

private shown_path(p: Buf[FStep]) -> string = if p.is_empty() then "ε" else fpa_path_text(p)

private sorted_text(parts: Buf[string]) -> string
    var out = ""

    for x in sorted_labels(parts)
        if out != "" then out = out + " "

        out = out + x

    out
end sorted_text

// How many walks the analysis took, all bodies together.
fpa_walks(fx: &Fpa) -> int = fx.walks

// -- held to the keeps analysis -------------------------------------------------------------------

// Whether `SYSL_FPA_COMPARE=1` asks for the comparison with the keeps analysis.
private fpa_tracing() -> bool = get("SYSL_FPA_TRACE").unwrap_or("") == "1"

fpa_comparing() -> bool = get("SYSL_FPA_COMPARE").unwrap_or("") == "1"

// **Every place this analysis and the keeps analysis (`keeps.sysl`) answer differently**, as
// `<kind> <function>|<position>`, over every parameter that can hold an address. The kinds say which
// side keeps or answers and the likely reason: a value kept only inside a heap object the function
// answers (`boxed-answer`, the M24 rule), a closure body, a store through another parameter. A
// parameter both keep, where this one keeps only some of its fields, is said as `field-narrowed`.
//
// **A body held to a promise is compared by what the body itself keeps** (`body_keeps_of`): the keeps
// analysis answers every caller of a closure, a method a trait dispatches to, or a function whose
// address is taken with the promise to borrow, and refuses the body where it breaks it. This analysis
// summarizes bodies, so the promise is not a disagreement about what the body does.
fpa_compare(cx: &KeepsCx, fx: &Fpa) -> Buf[string]
    var out: Buf[string] = buf()

    for f in fx.funcs
        if cx.mistaken.has(f.name) || fx.mistaken.has(f.name) then continue

        for i in 0..<f.params.len()
            if !may_hold_pointer(cx, f.params[i].1) then continue

            val at = s"${f.name}|$i"
            val old = body_keeps_of(cx, f.name, i)
            val ok = old.kept
            val nk = fpa_keeps(fx, f.name, i)

            if ok && !nk
                val why = if fpa_answers_boxed(fx, f.name, i) then "boxed-answer"
                else if is_closure_body(f) then "closure"
                else "other"

                out.push(s"keeps-old-only:$why $at -- old: ${old.how}")
            else if nk && !ok
                val why = if fpa_writes(fx, f.name, i) then "through-param"
                else if is_closure_body(f) then "closure"
                else "other"

                out.push(s"keeps-new-only:$why $at -- new keeps ${fpa_kept_text(fx, f.name, i)}")
            else if ok && field_narrowed(fx, f.name, i)
                out.push(s"agree:field-narrowed $at")
            end if

            if !may_hold_pointer(cx, f.ret_ty) then continue

            val oa = answers_of(cx, f.name, i)
            val na = fpa_answers(fx, f.name, i)

            if oa && !na then out.push(s"answers-old-only $at")
            if na && !oa then out.push(s"answers-new-only $at")

    out
end fpa_compare

// Whether every path kept of a parameter is a field of it held in place, none the value whole.
private field_narrowed(fx: &Fpa, name: string, i: usize) -> bool
    val fi = fpa_index(fx, name)

    if fi.is_none() then return false

    val sum = fx.sums[fi.unwrap()]

    if i >= sum.kept.len() || sum.kept[i].is_empty() || fpa_writes(fx, name, i) then return false

    for p in sum.kept[i]
        if p.is_empty() || has_deref(p) then return false

    true
end field_narrowed

// The comparison said on standard error: each disagreement, then how many of each kind.
fpa_report(lines: Buf[string])
    var kinds: Buf[string] = buf()
    var counts: Map[string, int] = map()

    for line in lines
        eprints(s"FPA-DIFF $line\n")

        val kind = first_word(line)

        counts.get(kind) match
            Some(n) -> counts.put(kind, n + 1)
            None ->
                kinds.push(kind)
                counts.put(kind, 1)

    for k in sorted_labels(kinds)
        eprints(s"FPA-SUMMARY $k=${counts.get(k).unwrap_or(0)}\n")
end fpa_report

private first_word(line: string) -> string
    val b = line.bytes

    for i in 0..<b.len
        if b[i] == u8(' ') then return from_utf8_unchecked(b[0..<i])

    line
end first_word

// The comparison of one compilation, from the outside: what a test asks of a source.
fpa_disagreements(a: &Analysis, funcs: Buf[TFunc]) -> Buf[string] =
    fpa_compare(settled_keeps(a, funcs, reached_vtables(a)), fpa_analyze(a, funcs))
