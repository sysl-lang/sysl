// A B-tree leaf whose keys live INSIDE the node, as Rust's do: an inline [B]K of which only the
// first `len` are live. A node is made holding one key, so B - 1 slots start with nothing in them.

struct Leaf[K, const B: usize]
    len: usize
    keys: [B]K

one[K, const B: usize](k: K) -> &Leaf[K, B]
    var ks: [B]K = slot_empty()

    ks[0] = k

    Leaf(1, ks)

val l = one[string, 6]("a")

print(l.len, l.keys[0])
