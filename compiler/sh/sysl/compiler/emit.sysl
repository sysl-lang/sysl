module sh.sysl.compiler

import sh.sysl.parsing.{Source, Span}
import sysl.buf.{Buf, buf}
import sysl.container.{Map, map, Set, set}
import sysl.math.bigint.from_int

// **The substrate a body is written into**: registers, basic blocks, the entry-block prologue, and
// the module-level constants a body lays down as it goes.
//
// This file holds *how* intermediate representation is written down and none of what it says. The
// rules live in the files around it -- `emit_scalar.sysl` for what an operator becomes,
// `emit_place.sysl` for what an address is, `emit_flow.sysl` for the blocks a branch needs, and
// `emit_func.sysl` for the frame all three are emitted into.
//
// **A form nothing here lowers yet is recorded rather than guessed at.** `gap` holds the first one
// a body reached, and a body that reached one is left out of the module altogether: an answer this
// compiler cannot give is worth nothing beside the reference's, and a *wrong* one costs the diff
// its meaning. So a partial lowering is a smaller module rather than a different one, which is what
// makes it provable a function at a time.

// Everything one function's lowering needs, plus the module-level lists a body contributes to.
struct Emit
    target: Target
    layout: TargetLayout
    word_bits: int

    // The module-level storage bodies laid down -- the interned strings, and the constant tables a
    // large array literal is copied out of (`emit_static.sysl`'s `constant_table`).
    globals: Buf[IrGlobal]
    str_id: int
    table_id: int

    // The LLVM intrinsics the module turned out to need. Each is declared once under its
    // overload-mangled name, which is why this is a list rather than a flag: the name carries the
    // width, so a program using one at three widths needs three declarations.
    sat_decls: Buf[IrFuncSig]

    // Whether anything stopped the program, copied a block of storage, or asked for the checked
    // arithmetic a size computation needs.
    traps: bool
    uses_memcpy: bool
    checked: bool

    // Whether anything rendered a `bool` or laid a codepoint's bytes down. Each decides one thing the
    // module carries -- the two immortal words a `bool` renders to, and the encoder -- which is why
    // they are two flags rather than one.
    bool_strs: bool
    char_buf: bool

    // Whether a body began or ended a varargs walk, and whether one duplicated a walk. They are two
    // flags because the pair and the copy are declared separately -- a program that never writes
    // `va_copy` should not carry its declaration.
    uses_varargs: bool
    uses_va_copy: bool

    // How many assembly blocks the module has emitted, which is what lets each one's labels be its
    // own.
    asm_site: int

    // The blocks of the function being built. `prologue` is kept apart because a stack slot is
    // hoisted to the top of the entry block from wherever it was needed, so the two halves of that
    // block are built at different times and joined only when the function is finished.
    prologue: Buf[Inst]
    blocks: Buf[IrBlock]
    current: Buf[Inst]
    current_end: Option[Inst]
    current_label: string
    temp: int
    label: int
    terminated: bool

    // Every label an emitted terminator names, which is what opening a block asks to decide whether
    // the block can be reached at all.
    reached: Buf[string]

    // Where each label stands in `reached`, so asking costs one lookup rather than a walk of every
    // label the function has named. An entry is believed only while `reached` still holds that label
    // at that position, which is what lets a rewind truncate `reached` alone.
    reached_at: Map[string, usize]

    // The enclosing loops, innermost last, so a `break`/`continue` knows where to jump and what
    // result slot to store into.
    loops: Buf[GenLoop]

    // One stack slot per LLVM type per function, for the type punning a union needs: a value goes in
    // written as one type and comes back out read as another.
    scratch: Buf[(string, Val)]

    // What the module knows about the functions a body calls: the keys whose emitted symbol differs
    // from the key itself, the `extern`s -- which cross under C's convention rather than sysl's --
    // and the ones whose parameter list is open at the end.
    symbols: Buf[(string, string)]
    foreigns: Buf[string]
    variadics: Buf[string]

    // The whole LLVM function type of every `extern` whose parameter list is open at the end, which
    // is what a call to one names instead of a result type: the argument list alone does not say
    // where the declared parameters stop and the ellipsis begins.
    variadic_types: Buf[(string, IrFnType)]

    // The exported symbol of each function that has one, which is the **thunk's** rather than the
    // definition's. It is what an *address* of the function names, since the thunk is the one entry
    // point callable under the machine's C convention.
    export_symbols: Buf[(string, string)]

    // The postconditions the function being lowered states, and what `result` stands for while one
    // of them is being emitted. A return owes nothing beyond the `ret` where there are none.
    ensures: Buf[TClause]
    result_ssa: Option[Val]

    // Where a tail self-call jumps, and which calls are the ones that jump.
    //
    // The target sits just after the parameter slots are written, so the jump lands where a fresh
    // call would have landed: the preconditions are checked again and each `old(e)` is snapshotted
    // again, because a tail call *is* a call and those belong to the invocation rather than to the
    // frame. It is empty in a function with no tail call, which is what keeps a label out of every
    // other function in the module.
    tail_target: string
    tail_calls: Buf[Span]

    // The parameters a jump rebinds, in declaration order -- every one of them, so that they line up
    // with the arguments a call was written with.
    tail_params: Buf[(string, Type)]

    // What the function being emitted is called, what its parameters are, and the `variant` it
    // declared -- the three things a self-call needs to check the measure.
    self_name: string
    self_params: Buf[(string, Type)]
    self_variant: Option[TExpr]

    // The `@ghost` functions of this program, which nothing emitted may name. A clause that calls one
    // is a proof obligation rather than something to lay down, and is dropped whole.
    ghost_funcs: Buf[string]

    // -- the ownership runtime ---------------------------------------------------------------

    // The destructor each type that has one is filed under, read straight off the program. A hook
    // is built from a type with no call site anywhere near it, so this has to be here rather than
    // handed down from a caller.
    destructors: Buf[(string, string)]

    // Whether anything in this module put an object on the heap, took an atomic count, held a weak
    // reference, or counted against an owner that may be absent. Each decides one block of the
    // runtime, which is why they are four flags rather than one.
    heap: bool
    sync_heap: bool
    weak_heap: bool
    maybe_heap: bool

    // The boxes and buffers the module turned out to need, keyed by their LLVM name so that two
    // instantiations mangling to one name are one definition.
    boxes: Buf[(string, Type)]
    bufs: Buf[(string, Type)]

    // The runtime helpers asked for, by name, and what each is to be built from. A helper is named
    // where it is called and generated afterwards, because generating one may ask for another. The
    // list keeps the order helpers are drained in, which is part of the output; the set beside it is
    // what membership is asked against.
    requested: Buf[string]
    requested_set: Set[string]
    queue: Buf[HelperReq]

    // The scopes a value's count is given back at: the slots a lexical block owns, the values a
    // statement or sub-expression region owns, and the statements a block runs on the way out.
    //
    // **Each is one flat list with a list of region starts beside it**, rather than a list of
    // lists. A `Buf` copied out of another `Buf` shares the storage it views and carries its own
    // length, so pushing into one read back by `at` writes into the shared elements and leaves the
    // outer list's idea of the length behind -- a nesting that looks right and records nothing. A
    // start index is the whole of what a region is, so this says the same thing with no copy in it.
    temps: Buf[(Val, Type)]
    temp_marks: Buf[usize]
    owned_slots: Buf[(Val, Type)]
    owned_marks: Buf[usize]
    defers: Buf[TStmt]
    defer_marks: Buf[usize]

    // Beside each entry of `defers`, how many entries `owned_slots` had when it was registered: the
    // slots below that index were written above the `defer`, the ones from it on below. Leaving a
    // block undoes both in one reverse order by position (`emit_arc.sysl`'s `leave_scope`), and a
    // slot taken out of the list (`emit_moves.sysl`'s `forget_slot`) moves every later position down.
    defer_at: Buf[usize]

    // The registers this body has named for a local's storage, and the locals whose address has been
    // named more than once: a deferred statement is laid down at every edge that leaves its block,
    // so a local it declares is declared once per edge. A slot is shared by every laying; an address
    // an instruction computes cannot be, and a pair is the name the program's tree uses and the name
    // the latest laying's address has.
    declared: Set[string]
    relaid: Buf[(string, string)]

    // The locals of an async body that live in its promise, so in the frame (`emit_async.sysl`'s
    // `frame_locals`): each one's slot is named once, after `llvm.coro.begin`, and no other
    // declaration may name it again.
    frame_slots: Set[string]

    // The names whose array lives in a buffer rather than a slot, because a view of it gets out of
    // this frame, and the box each of those buffers is. The **temporaries** are whole-program rather
    // than per-function, since a span already says which body a node is in.
    promoted: Buf[string]
    promoted_boxes: Buf[(string, Val)]
    promoted_temps: Buf[Span]

    // The place each `ref` name stands for. A ref names storage it did not declare, so what keeps
    // that storage alive is whatever the place was rooted at -- which is a question asked long after
    // the declaration is out of sight.
    ref_places: Buf[(string, TExpr)]

    // The two sides of the argument convention (`borrowing.sysl`). What the body being lowered let
    // the address of out, which is what a call it makes could change under it; the functions whose
    // bodies can release nothing, so a place handed to one needs no count; and the functions whose
    // address the program takes, which a caller outside sysl's convention may reach.
    caller_exposed: Set[string]
    inert: Set[string]
    address_taken: Set[string]

    // Each large by-value parameter a function reads where its caller put them, as `<function>` and
    // `<parameter>` on two lines (`borrowing.sysl`'s `reads_in_place`), and the functions whose
    // receiver is one -- which a trait object's adapter has to stage a snapshot for.
    in_place: Set[string]
    in_place_receivers: Set[string]

    // What a contract tells the optimizer (`contract_assume.sysl`): every function whose `ensure` a
    // call site may repeat, with the parameters its own body may have rebound before the check ran;
    // every struct's synthesised `invariant` function by the name it is emitted under; and whether
    // anything was said, which is what `llvm.assume` is declared for.
    contracted: Map[string, (TFunc, Set[string])]
    inv_funcs: Map[string, TFunc]
    uses_assume: bool

    // The local of the body being emitted that lives in the caller's result storage rather than in a
    // slot of its own (`return_slot.sysl`), where it has one; the temporaries that were written into a
    // slot rather than produced as a value, by register name, which are given back at their address
    // (`own_temp_at`); and the program's types that have a destructor, which a view's owner could be.
    return_slot: Option[ReturnPlan]
    temp_slots: Set[string]
    dropping: Buf[Type]

    // The first form this body reached that nothing here lowers. A body that has one is not emitted.
    gap: Option[string]

    // The coroutine the body being emitted is, where it is an `async` function's; and whether any
    // body is one, which is what the coroutine intrinsics are declared for (`emit_async.sysl`).
    coro: Option[CoroCtx]
    uses_coro: bool

    // The file the body being written came from, which a failed bounds check names; whether any
    // check here reports through `sysl_bounds_fail`; and the locations it names, one constant each
    // (`bounds_fail.sysl`).
    src: Option[Source]
    bounds_fails: bool
    locs: Buf[string]
    locs_at: Map[string, usize]

    // The table of an enum's variant names a failed `x.(c)` reads the held one from, by the enum's
    // LLVM type: one per enum in the module, however many sites read it (`bounds_fail.sysl`).
    variant_names: Map[string, string]

    // The boundary each named LLVM type holding a raised `@align(n)` is stored on, by its name: a
    // stack slot is created from an LLVM type, and this is how it states the boundary
    // (`slot_align`, filled by `note_raised_types`).
    raised_types: Map[string, int]

    // The module storage marked `@per_cpu`, by symbol: an access to one is made at this core's
    // offset from the global, which is the `.percpu` image (`emit_place.sysl`'s `per_cpu_address`).
    per_cpu: Set[string]

    // The first storage on the heap this module asked the aligned hook for -- what it was, the
    // function that made it, and the boundary -- or nothing where every block came from the pair
    // (`emit_box.sysl`'s `heap_call`). It is what the hook is declared for, and what the refusal names
    // where nothing answers it (`unaligned_heap`).
    aligned_heap: Buf[(string, string, usize)]

    // The functions and `extern`s declared `@abandons`: a call to one gives back everything this frame
    // holds, deferred statements first, once its arguments are in hand and before the call is made.
    abandoning: Set[string]

    // The module storage marked `@main_thread`, by symbol; the bodies that may run in another domain,
    // where an access to one is checked to be on the main thread; and whether the body being written
    // is one of them (`emit_place.sysl`'s `global_address`).
    main_thread: Set[string]
    off_main: Set[string]
    main_thread_checks: bool

    // What each body can do to memory it does not own, and the functions found unable to change a
    // value of each type a call has asked about (`borrowing.sysl`'s `untouched_by`).
    untouched: Untouched

    // The async functions: a temporary handed to one moves into the task's frame, which keeps a count
    // of every parameter, so the caller gives its own back as soon as the call returns.
    asyncs: Set[string]

    // What the body being lowered has proved about its unsigned adds (`nowrap.sysl`).
    nowrap: NoWrap

    // Every named LLVM type of the program by its printed name: its size, its boundary and its
    // members (`emit_large.sysl`, which copies a large one as bytes).
    shapes: Map[string, TypeShape]

    // The array literals the body being lowered lays in its frame rather than in a buffer of their
    // own, which the escape analysis settled (`Promotions.framed_for`).
    framed_lits: Buf[Span]

    // How the function is being left while a way out lays its deferred statements down, which is
    // what decides whether an `errdefer` among them runs (`emit_arc.sysl`'s `leave_scope`).
    exit: ExitMode

    // The error return trace (`error_trace.sysl`): whether this module records into it, so it declares
    // the three functions it calls; the function being lowered, as a site names it; the `Err(...)`
    // constructors that are its results; and the trace's length saved by each statement being lowered
    // that handles a failure, outermost first.
    traces: bool
    trace_fn: string
    trace_origins: Set[string]
    trace_marks: Buf[Val]

    // The function each closure of the program was written in, by key, which is what a site in a
    // closure is named after.
    trace_owners: Map[string, string]

    // The arithmetic operator methods of the program by name, whose calls are read as their bodies
    // for contraction (`fp_operators.sysl`), and the count the names that reading binds are drawn
    // from -- never reset, so no two of a module are spelled alike.
    operators: Map[string, TFunc]
    op_temps: int

    // Which counts this frame already holds a destination may take over instead of retaining
    // (`emit_moves.sysl`). One function's, reset with the rest.
    moves: Moves

    // The parameters a direct call hands a count to, as `<function>|<position>`, and the functions
    // owning any (`owned_params.sysl`). The whole program's, read once.
    owned_params: Set[string]
    owning_funcs: Set[string]

    // The functions whose floating point follows the dynamic environment (`emit_strict_fp.sysl`):
    // every one marked `@strict_fp` and every closure and nested function written inside one. Beside
    // them, the functions whose whole body is an LLVM intrinsic over their parameters -- `f32.sqrt` --
    // which a strict caller calls as that intrinsic, by key; and the count the rewritten bodies'
    // registers are drawn from, never reset, so no two are spelled alike.
    strict_fns: Set[string]
    forwarders: Map[string, string]
    strict_temps: int

    // The `self` methods emitted with a body that takes its receiver at a table's data word, and
    // whether that word addresses a counted object's box (`emit_vtable.sysl`'s `split_self`).
    self_entries: Map[string, bool]

    // `inert` as the symbols a lowered call names (`symbol_of`), which is what the count elision
    // reads off an emitted call: a root function's key is `count`, and its call is to `count$$sysl`.
    inert_symbols: Set[string]

    // The functions declared `@track_caller`, by key, each taking one parameter past its declared
    // ones: the address of the `file:line:column` text of the call that reached it, or null where the
    // build dropped locations (`track_caller.sysl`). `in_tracked` says the body being written is one
    // of them, so the location it hands on -- to a tracked callee, to a failed check, to
    // `__CALLER__` -- is the one it was handed. A function pointer or a trait object's table holds a
    // stand-in for one instead, which passes the definition's own location (`caller_shim`).
    tracked: Map[string, TrackedFn]
    in_tracked: bool
end Emit

// What a runtime helper is built from. A helper is asked for by name while a body is being written
// and generated once every body is, so what it is to be made of travels as a description rather
// than as a function of its own.
enum HelperReq
    // The retain / release walk over a value of a type, and the same over one at an address.
    HrValue(ty: Type, retain: bool)
    HrSlot(ty: Type, retain: bool)

    // The hook that destroys a box of this payload, a buffer of this element, and the one shared by
    // every box whose payload holds nothing.
    HrDrop(payload: Type)
    HrDropBuf(elem: Type)
    HrPlainDrop

    // The hook installed in a task's promise whose result holds a count (`emit_async.sysl`): it lets
    // go of the result a finished task still holds, and destroys the frame.
    HrTaskDrop(result: Type)

    // The hook of storage `slot_storage` made: the buffer walk under a `weak_odr` symbol, so its
    // address -- which is how the slot forms recognise such storage -- is one address everywhere.
    HrSlotBuf(elem: Type)

    // What a `slot_place` of an element holding a count does anywhere but the first free slot of such
    // storage (`slots.sysl`'s `gen_slot_place_rest`), out of line, `noinline` and `cold`.
    HrSlotPlace(elem: Type)

    // What a by-value `@crossing` argument goes through (`emit_cross.sysl`): every view in the `T` at
    // an address replaced by a copy of its own, the share the old one held given back.
    HrCross(ty: Type)

    // A block written out by hand as LLVM, which is text and can only be **named** by anything that
    // is not LLVM. It shares the queue with the generated ones so that a module writes its helpers
    // down in the order they were first needed.
    HrText(llvm: string)

    // The forwarder one slot of a method table holds, where what the table promises and what the
    // implementation declared are not already the same handover.
    HrAdapter(table: TVtable, slot: TVSlot)

    // What a function pointer to a `@track_caller` function holds: a stand-in calling it with the
    // location of its own declaration (`track_caller.sysl`).
    HrCallerShim(target: string)
end HelperReq

// What a definition and every call to it name.
symbol_of(e: *Emit, name: string) -> string
    for item in e.symbols
        if item.0 == name then return item.1

    name
end symbol_of

// Whether a key names an `extern` rather than a function of this program's own.
is_foreign(e: *Emit, name: string) -> bool
    for foreign in e.foreigns
        if foreign == name then return true

    false
end is_foreign

// The symbol an **address** of this function names -- the one entry point that is callable under
// the machine's C convention, since that is the only thing a `*extern` may hold.
//
// For an ordinary function the two are the same and this is `symbol_of`: its signature is all
// scalars, or the address would have been refused, and a scalar crosses as itself. For an exported
// one they are not -- the definition keeps sysl's lowering and the thunk in front of it is what C
// can call -- so the address is the thunk's, which is what makes `&f` on an exported function mean
// anything.
entry_of(e: *Emit, name: string) -> string
    for export_symbol in e.export_symbols
        if export_symbol.0 == name then return export_symbol.1

    symbol_of(e, name)
end entry_of

// The whole function type a call to a variadic callee names, where the callee is one.
variadic_type_of(e: *Emit, name: string) -> Option[IrFnType]
    for variadic_type in e.variadic_types
        if variadic_type.0 == name then return Some(variadic_type.1)

    None
end variadic_type_of

// Whether a key names something whose parameter list is open at the end.
is_variadic(e: *Emit, name: string) -> bool
    for item in e.variadics
        if item == name then return true

    false
end is_variadic

// Where a `break` and a `continue` in the innermost loop go, and where a `break` with a value puts
// it.
struct GenLoop
    break_label: string
    continue_label: string
    slot: Val
    has_slot: bool

    // How deep the ownership regions were when the loop was entered, which is what bounds the
    // unwinding a `break` or a `continue` from the middle of the body owes. Recorded before the
    // condition's own bindings: each term of a condition closes its own region, so by the time the
    // body runs there is nothing of the test left outstanding for the loop to give back.
    owned_depth: usize
    temp_depth: usize

    // How many statements handling a failure were open when the loop was entered: a `break` or a
    // `continue` completes every one opened since, so it puts the trace back to the first of them.
    trace_depth: usize
end GenLoop

// An emitter for one module, with no function open, and no program behind it -- which is what a
// test asserting on one instruction wants.
emitter(t: Target) -> Emit
    var none: Buf[(string, string)] = buf()

    emitter_for(t, none)
end emitter

// The same, over a program whose destructors a hook has to be able to ask about.
emitter_for(t: Target, destructors: Buf[(string, string)]) -> Emit
    var globals: Buf[IrGlobal] = buf()
    var sat_decls: Buf[IrFuncSig] = buf()
    var prologue: Buf[Inst] = buf()
    var blocks: Buf[IrBlock] = buf()
    var current: Buf[Inst] = buf()
    var reached: Buf[string] = buf()
    var loops: Buf[GenLoop] = buf()
    var scratch: Buf[(string, Val)] = buf()
    var symbols: Buf[(string, string)] = buf()
    var foreigns: Buf[string] = buf()
    var variadics: Buf[string] = buf()
    var tail_calls: Buf[Span] = buf()
    var tail_params: Buf[(string, Type)] = buf()
    var self_params: Buf[(string, Type)] = buf()
    var ghost_funcs: Buf[string] = buf()
    var ensures: Buf[TClause] = buf()

    var boxes: Buf[(string, Type)] = buf()
    var bufs: Buf[(string, Type)] = buf()
    var requested: Buf[string] = buf()
    var requested_set: Set[string] = set()
    var queue: Buf[HelperReq] = buf()
    var temps: Buf[(Val, Type)] = buf()
    var temp_marks: Buf[usize] = buf()
    var owned_slots: Buf[(Val, Type)] = buf()
    var owned_marks: Buf[usize] = buf()
    var defers: Buf[TStmt] = buf()
    var defer_marks: Buf[usize] = buf()
    var relaid: Buf[(string, string)] = buf()
    var promoted: Buf[string] = buf()
    var promoted_boxes: Buf[(string, Val)] = buf()
    var promoted_temps: Buf[Span] = buf()
    var ref_places: Buf[(string, TExpr)] = buf()
    var variadic_types: Buf[(string, IrFnType)] = buf()
    var export_symbols: Buf[(string, string)] = buf()

    Emit(t, memo_layout_for(t), int(t.pointer_bits()), globals, 0, 0, sat_decls, false, false, false,
         false, false, false, false, 0,
         prologue, blocks, current, None, "entry", 0, 0, false, reached, map(), loops, scratch, symbols,
         foreigns, variadics, variadic_types, export_symbols, ensures, None, "", tail_calls, tail_params,
         "", self_params, None, ghost_funcs, destructors, false, false, false,
         false, boxes, bufs, requested, requested_set, queue, temps, temp_marks, owned_slots, owned_marks, defers,
         defer_marks, buf(), set(), relaid, set(), promoted, promoted_boxes, promoted_temps, ref_places, exposed_unknown(),
         set(), set(), set(), set(), map(), map(), false, None, set(), buf(), None, None, false,
         None, false, buf(), map(), map(), map(), set(), buf(), set(), set(), set(), false, untouched_none(), set(),
         no_wrap_none(), map(), buf(), Leaving, false, "", set(), buf(), map(), map(), 0, moves_none(), set(), set(),
         set(), map(), 0, map(), set(), map(), false)
end emitter_for

// -- what a body could not say --------------------------------------------------------------------

// Records that this body reached a form nothing lowers yet, and answers a value standing where the
// one it could not compute would have gone. The first reached is the one kept: it is the one a
// reader can act on, and everything after it is downstream of a value that was never computed.
gap_at(e: *Emit, what: string) -> Val
    if e.gap.is_none() then e.gap = Some(what)

    VUndef
end gap_at

// The same, for a caller with nothing to answer with.
gap_here(e: *Emit, what: string)
    if e.gap.is_none() then e.gap = Some(what)

// Whether this body has already given up.
has_gap(e: *Emit) -> bool = e.gap.is_some()

// -- the function under construction ---------------------------------------------------------------

// Resets everything that is one function's, which is everything but the module-level lists.
start_function(e: *Emit)
    e.nowrap = no_wrap_none()
    e.src = None
    e.in_tracked = false
    e.prologue.clear()
    e.blocks.clear()
    e.current.clear()
    e.current_end = None
    e.current_label = "entry"
    e.temp = 0
    e.label = 0
    e.terminated = false
    e.reached.clear()
    e.reached_at.clear()
    e.loops.clear()
    e.scratch.clear()
    e.ensures.clear()
    e.result_ssa = None
    e.tail_target = ""
    e.tail_calls.clear()
    e.tail_params.clear()
    e.self_name = ""
    e.self_params.clear()
    e.self_variant = None
    e.temps.clear()
    e.temp_marks.clear()
    e.owned_slots.clear()
    e.owned_marks.clear()
    e.defers.clear()
    e.defer_marks.clear()
    e.defer_at.clear()
    e.declared.clear()
    e.frame_slots.clear()
    e.relaid.clear()
    e.promoted_boxes.clear()
    e.ref_places.clear()
    e.caller_exposed = exposed_unknown()
    e.return_slot = None
    e.temp_slots = set()
    e.gap = None
    e.coro = None
    e.exit = Leaving
    e.trace_fn = ""
    e.trace_origins = set()
    e.trace_marks = buf()
    e.moves = moves_none()
end start_function

// A register nothing else in this function uses.
fresh_reg(e: *Emit) -> Val
    e.temp += 1

    VReg(s"t${e.temp}")
end fresh_reg

// A label nothing else in this function uses.
fresh_label(e: *Emit, stem: string) -> string
    e.label += 1

    s"$stem${e.label}"
end fresh_label

// Emits a plain instruction, unless the current block is already terminated.
emit(e: *Emit, i: Inst)
    if !e.terminated then e.current.push(i)

// Emits a stack slot into the function's entry block rather than where it is needed. Every name is
// unique within a function, so hoisting is safe -- and it keeps a slot inside a loop from growing
// the stack on every iteration.
//
// A slot of a type holding a raised `@align(n)` is created on that boundary, LLVM's own being only
// the widest member's.
emit_alloca(e: *Emit, name: Val, ty: LType, align: Option[int]) -> Val
    e.prologue.push(InAlloca(name, ty, wider_align(align, slot_align(e, ty))))
    name
end emit_alloca

// The boundary a raised `@align(n)` asks of a slot of this LLVM type, where it asks one.
slot_align(e: *Emit, ty: LType) -> Option[int] = ty match
    LNamed(n) -> e.raised_types.get(n)
    LArr(_, elem) -> slot_align(e, *elem)
    _ -> None

// Records the boundary of every struct and data enum of the program that holds a raised
// `@align(n)`, under the name LLVM knows it by.
note_raised_types(e: *Emit, p: TProgram)
    for item in p.structs
        item match
            Struct(d) ->
                if e.layout.struct_holds_raised(d)
                    e.raised_types.put(l_render(struct_lty(d)), int(e.layout.align(Struct(d))))
            _ -> ()

    for item in p.enums
        item match
            Enum(d) ->
                if !d.simple && e.layout.enum_holds_raised(d)
                    e.raised_types.put(l_render(enum_lty(d)), int(e.layout.align(Enum(d))))
            _ -> ()
end note_raised_types

// A slot with whatever boundary the type it holds already asks for.
alloca(e: *Emit, name: Val, ty: LType) -> Val = emit_alloca(e, name, ty, None)

// -- a local's storage, by name ---------------------------------------------------------------------

// A name is unique within a function, so a local's storage is simply named for it. **A declaration
// can be lowered more than once**, though: a deferred statement is laid down at every edge that
// leaves its block, and each laying declares the statement's locals again. Two definitions of one
// name are not a function, and the two kinds of storage answer that differently.

// A slot named for something the program declared, laid down once however many times the
// declaration is lowered. Every laying of a deferred statement stores into the one slot: a body
// runs on one edge at a time and each laying writes the local before it reads it, so they never
// need two.
named_alloca(e: *Emit, slot: string, ty: LType, align: Option[int]) -> Val
    if e.declared.add(slot) then emit_alloca(e, VReg(slot), ty, align)

    VReg(slot)
end named_alloca

// The slot a local's own declaration lays down, `%name.addr`.
local_alloca(e: *Emit, name: string, ty: LType) -> Val = named_alloca(e, s"$name.addr", ty, None)

// Names a local whose address is a register an instruction defines where it stands -- a `ref`, and
// an array moved to a buffer. A register is defined once, so every laying after the first takes a
// name of its own -- `r.d1`, `r.d2` -- and the uses that follow it, which belong to the same
// laying, read that.
declare_local(e: *Emit, name: string) -> string
    if e.declared.add(s"$name.addr") then return name

    var n = 1

    for item in e.relaid
        if item.0 == name then n += 1

    val own = s"$name.d$n"

    e.relaid.push((name, own))
    own
end declare_local

// The storage name a use of a local means: the one its most recent declaration took. Layings are
// lowered one after another and never inside one another, so the most recent is the use's own.
local_name(e: *Emit, name: string) -> string
    for i in 0..<e.relaid.len()
        val r = e.relaid.at(e.relaid.len() - 1 - i)

        if r.0 == name then return r.1

    name
end local_name

// The address a local lives at, for a use of it.
local_slot(e: *Emit, name: string) -> Val = VReg(s"${local_name(e, name)}.addr")

// The one overload of `llvm.memcpy` this compiler emits, so the two sites that name it -- the
// declaration and the call -- cannot spell it differently. Both pointers are in the default address
// space and the length is 64 bits on every target, whatever the machine's word is.
memcpy_symbol() -> string = llvm_memcpy_entry().at([LPtr, LPtr, LInt(64)])

// A block of storage copied, at a boundary both ends are known to satisfy.
//
// The one call in the module the intrinsic is declared for, so the flag that declares it is set here
// rather than at each site that copies -- a caller that stops copying stops declaring it, and one
// that starts brings the declaration with it.
emit_memcpy(e: *Emit, dst: Val, src: Val, bytes: int, align: int) =
    emit(e, memcpy_inst(e, dst, src, bytes, align))

// The copy itself, for a pass that places it rather than emitting it where the body is.
memcpy_inst(e: *Emit, dst: Val, src: Val, bytes: int, align: int) -> Inst
    e.uses_memcpy = true

    var args: Buf[IrArg] = buf()
    var dst_attrs: Buf[IrAttr] = buf()
    var src_attrs: Buf[IrAttr] = buf()

    dst_attrs.push(AttrAlign(align))
    src_attrs.push(AttrAlign(align))
    args.push(IrArg(LPtr, dst, dst_attrs))
    args.push(IrArg(LPtr, src, src_attrs))
    args.push(ir_arg(LInt(64), VInt(from_int(long(bytes)))))
    args.push(ir_arg(LInt(1), VBool(false)))
    InCall(None, LVoid, VGlobal(memcpy_symbol()), args, no_ir_attrs(), None, no_fast_math(), false)
end memcpy_inst

// Emits a block terminator, marks the block closed, and records wherever it sends control -- which
// is what makes the labels it names reachable.
emit_term(e: *Emit, i: Inst)
    if !e.terminated
        e.current_end = Some(i)
        e.terminated = true

        i match
            InBr(l) -> mark_reached(e, l)
            InCondBr(_, t, f) ->
                mark_reached(e, t)
                mark_reached(e, f)
            InSwitch(_, _, d, cs) ->
                mark_reached(e, d)

                for item in cs
                    mark_reached(e, item.1)
            _ -> ()
end emit_term

private mark_reached(e: *Emit, l: string)
    if is_reached(e, l) then return

    e.reached_at.put(l, e.reached.len())
    e.reached.push(l)

private is_reached(e: *Emit, l: string) -> bool = e.reached_at.get(l) match
    Some(i) -> i < e.reached.len() && e.reached[i] == l
    None -> false

// Opens a block under `l`.
//
// **A label nothing has branched to is unreachable, and emission stays suppressed through it.** LLVM
// has no fall-through -- a block is entered only by a terminator naming it -- so a label opened
// while no emitted branch mentions it can be reached at most by a back edge from the region it
// opens, which is unreachable from the entry by the same argument.
emit_label(e: *Emit, l: string)
    close_block(e)
    e.current_label = l
    e.terminated = !is_reached(e, l)
end emit_label

// Files the block being built and starts a fresh one. A block still marked closed at the moment it
// is filed never had a terminator of its own, because everything emitted into it was dropped -- it
// is unreachable code, and `unreachable` is what it says.
private close_block(e: *Emit)
    val end = e.current_end match
        Some(t) -> Some(t)
        None -> if e.terminated then Some(InUnreachable) else None

    var instrs: Buf[Inst] = buf()

    for item in e.current
        instrs.push(item)

    e.blocks.push(IrBlock(e.current_label, instrs, end))
    e.current.clear()
    e.current_end = None
end close_block

// The function just emitted: its header, and the blocks it is made of. The hoisted slots go at the
// front of the entry block, which is where they were always printed.
finish_func(e: *Emit, sig: IrFuncSig) -> IrFunc
    close_block(e)

    var out: Buf[IrBlock] = buf()

    for i in 0..<e.blocks.len()
        val b = e.blocks.at(i)

        if i == 0
            var instrs: Buf[Inst] = buf()

            for item in e.prologue
                instrs.push(item)

            for instr in b.instrs
                instrs.push(instr)

            out.push(IrBlock(b.label, instrs, b.terminator))
        else
            out.push(b)

    // The pairs are cancelled while every value is still a register, and only then is a large one
    // turned into the bytes it is copied as.
    IrFunc(sig, lower_large_values(e, elide_arc_pairs(out, e.inert_symbols)))
end finish_func

// -- the constants a body folds against ------------------------------------------------------------

// The two widths written often enough to be worth naming: a condition, and the index a
// `getelementptr` steps with.
l_i1() -> LType = LInt(1)
l_i32() -> LType = LInt(32)

// The LLVM integer exactly one address wide, which is what a length, a size or an index must be
// spelled as.
word_lty(e: *Emit) -> LType = LInt(e.word_bits)

// Whether every symbol this module names is bound inside the one image it links into -- a bare ELF
// machine -- so each one it makes is `dso_local` (`Target.symbols_bind_locally`).
binds_locally(e: *Emit) -> bool = e.target.symbols_bind_locally()

// The constant a folded condition is tested against, which is by shape rather than by an equality
// `Val` does not have.
private is_yes(v: Val) -> bool = v match
    VBool(b) -> b
    _ -> false

// Folding `and` / `or` over `i1`s, with the constant cases collapsed rather than emitted -- a test
// that cannot fail contributes `true`, and ANDing that in would be an instruction saying nothing.
and_i1(e: *Emit, a: Val, b: Val) -> Val
    if is_yes(a) then return b
    if is_yes(b) then return a

    val r = fresh_reg(e)

    emit(e, InBin(r, OpAnd, l_i1(), a, b))
    r
end and_i1

or_i1(e: *Emit, a: Val, b: Val) -> Val
    if is_yes(a) || is_yes(b) then return VBool(true)

    val r = fresh_reg(e)

    emit(e, InBin(r, OpOr, l_i1(), a, b))
    r
end or_i1

not_i1(e: *Emit, a: Val) -> Val
    if is_yes(a) then return VBool(false)

    val r = fresh_reg(e)

    emit(e, InBin(r, OpXor, l_i1(), a, VBool(true)))
    r
end not_i1

// -- storage a lowering borrows ----------------------------------------------------------------------

// One stack slot per LLVM type per function, for the type punning a union needs. Sharing the slot
// is safe because every use of it stores and immediately loads with nothing emitted in between.
scratch_slot(e: *Emit, ty: LType) -> Val
    val key = l_render(ty)

    for item in e.scratch
        if item.0 == key then return item.1

    val slot = alloca(e, fresh_reg(e), ty)

    e.scratch.push((key, slot))
    slot
end scratch_slot

// A string's bytes as an interned constant holds them: UTF-8, with the terminator a C caller reads
// by -- which a `string`, knowing its own length, has never had a use for.
string_global(e: *Emit, s: string) -> Val
    e.str_id += 1

    val name = s".str${e.str_id}"

    var bytes: Buf[u8] = buf()

    for i in 0..<s.bytes.len
        bytes.push(s.bytes[i])

    bytes.push(u8(0))

    e.globals.push(ir_global(name, true, LArr(int(bytes.len()), LInt(8)), VBytes(bytes)))
    VGlobal(name)
end string_global

// -- the LLVM form of a type, as a body writes it ----------------------------------------------------

// What a value of this type is held in. A type nothing lowers is a gap rather than a guess.
lty(e: *Emit, t: Type) -> LType = type_lty(t, e.word_bits) match
    Some(l) -> l
    None ->
        gap_here(e, s"type ${type_show(t)}")
        LVoid

// The type an address is stepped over by: an element's own, except that one occupying nothing is
// the empty struct, which LLVM can step over by zero bytes where `void` is no type to step by.
stride_lty(e: *Emit, t: Type) -> LType = if zero_sized(t) then LStruct(buf()) else lty(e, t)

// The type a `load` or a `store` names, which is the same question.
lty_of(e: *Emit, x: TExpr) -> LType = lty(e, texpr_type(x))
