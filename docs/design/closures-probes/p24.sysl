// Drop order and defer: a guard made first, a later local, and a defer. sysl runs the defer, then
// releases the block's references (memory.md § Where defer sits).
struct Noisy
    name: string

impl Drop for Noisy
    drop(self) = print("drop " + self.name)

run()
    val a = Noisy("a")
    defer print("defer")
    val b = Noisy("b")

    print("body " + a.name + b.name)

run()
