module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.env.get as env_get
import sysl.fs.{entries, is_file, make_dir_all, read_bytes, read_text, remove_dir_all, remove_file, write_bytes,
                write_text}
import sysl.process.capture
import sysl.text.{cstring, join, split, Search}

// **Every setting that can change what a build makes keys every cache that keeps what it made**
// (`config_key.sysl`, `run_cache.sysl`, `root_artifact.sysl`).
//
// Each seam case builds a real project through the command line three times -- under one setting,
// under another, and under the first again -- and reads back what the program wrote and what the cache
// did: the second build must print what its setting says and must miss, and the third must hit the
// first's entry. A setting that cannot change the output (`-O`, `--lto`) is held to a miss onto an
// entry whose bytes differ. An exempt one is held to the opposite: the output is the same, and the
// entry is replayed.
//
// The graph cases do the same over real packages -- path dependencies, a `--lib` root standing in for
// a coordinate, and packages vendored at two versions -- because a key is only as good as what the
// build that consults it would have produced.
//
// Every case keeps its entries in directories of its own; nothing here reads or leaves an entry in the
// machine's run, root or C object caches.

private extern "setenv" ckg_c_setenv(name: *u8, value: *u8, overwrite: int) -> int
private extern "unsetenv" ckg_c_unsetenv(name: *u8) -> int

private ckg_setenv(name: string, value: string)
    val n = cstring(name)
    val v = cstring(value)

    ckg_c_setenv(n.ptr, v.ptr, 1)
end ckg_setenv

private ckg_unsetenv(name: string)
    val n = cstring(name)

    ckg_c_unsetenv(n.ptr)
end ckg_unsetenv

private ckg_ready() -> bool = std_root().is_ok() && clang_available()

// -- trees ------------------------------------------------------------------------------------------

private ckg_put(root: string, at: string, text: string)
    make_dir_all(parent_of(s"$root/$at").unwrap()).unwrap()
    write_text(s"$root/$at", text).unwrap()
end ckg_put

// A fresh directory holding these files.
private ckg_tree(files: []const (string, string)) -> string
    val root = lbr_temp("sysl-ckg")

    for f in files
        ckg_put(root, f.0, f.1)

    root
end ckg_tree

// A program whose answer is `expr`, written to `out.txt` beside it rather than printed -- `sysl run`
// hands its child this process's own standard output.
private ckg_main(root: string, head: string, expr: string) -> string =
    s"import sysl.fs.write_text\n$head\n\nwrite_text(\"$root/out.txt\", str($expr)).unwrap_or(())\n"

// A project at a fresh directory: its manifest, its main file over `expr`, and any other files.
private ckg_project(manifest: string, head: string, expr: string, files: []const (string, string)) -> string
    val root = ckg_tree(files)

    ckg_put(root, "package.hocon", manifest)
    ckg_put(root, "main.sysl", ckg_main(root, head, expr))
    root
end ckg_project

private ckg_manifest(name: string, rest: string) -> string =
    s"package { name = \"$name\", version = \"1.0.0\" }\n$rest"

// -- the command line ---------------------------------------------------------------------------------

private ckg_cli(args: []string) -> (int, string)
    var said: Buf[string] = buf()
    val sink = &said
    val code = run_cli(args, piece -> sink.push(piece))

    (code, join(said.view(), "\n"))
end ckg_cli

// `sysl <command> <path> <flags>`, the flags written as one string separated by spaces.
private ckg_args(command: string, path: string, flags: string) -> Buf[string]
    var args: Buf[string] = buf()

    args.push("sysl")
    args.push(command)
    args.push(path)

    for item in split(flags, " ")
        if !item.is_empty() then args.push(item)

    args
end ckg_args

// What the program `sysl run` built wrote, or `refused` where the command failed.
private ckg_ran(root: string, flags: string) -> string
    remove_file(s"$root/out.txt").unwrap_or(())

    val args = ckg_args("run", root, flags)

    if ckg_cli(args.view()).0 != 0 then return "refused"

    read_text(s"$root/out.txt").unwrap_or("nothing written")
end ckg_ran

// What the program `sysl build` made writes when it is run, or `refused`.
private ckg_built(root: string, flags: string, exe: string) -> string
    remove_file(s"$root/out.txt").unwrap_or(())

    val args = ckg_args("build", root, s"-o $exe $flags")

    if ckg_cli(args.view()).0 != 0 then return "refused"

    capture(exe, [], "", [], true) match
        Err(_) -> "could not run"
        Ok(_) -> read_text(s"$root/out.txt").unwrap_or("nothing written")
end ckg_built

// -- the caches -----------------------------------------------------------------------------------

// Every cache this process consults, in a directory of the case's own, with the counts cleared.
private ckg_caches() -> string
    val cache = lbr_temp("sysl-ckg-cache")

    use_run_cache_dir(Some(cache))
    use_root_cache_dir(Some(cache))
    use_c_object_cache_dir(Some(cache))
    clear_run_cache_counts()
    clear_root_artifact_counts()
    cache
end ckg_caches

private ckg_done(cache: string, trees: []string)
    use_run_cache_dir(None)
    use_root_cache_dir(None)
    use_c_object_cache_dir(None)
    reset_search_paths()
    reset_feature_request()
    remove_dir_all(cache).unwrap_or(())

    for t in trees
        remove_dir_all(t).unwrap_or(())
end ckg_done

// The executables a run cache holds, without their test lists and seals.
private ckg_entries(cache: string) -> Buf[string]
    var out: Buf[string] = buf()

    entries(s"$cache/sysl/run") match
        Err(_) -> ()
        Ok(names) ->
            for item in names
                if !item.ends_with(".tests") && !item.ends_with(SealSuffix) && !item.ends_with(ReadsSuffix) &&
                        !item.starts_with(".")
                    out.push(s"$cache/sysl/run/$item")

    out
end ckg_entries

// Whether two executables are one program. **The linker's ad-hoc signature is set aside first**: it
// names the file the link wrote, which is a fresh pending name each time, so two links of one program
// differ there and nowhere else.
private ckg_same(a: string, b: string) -> bool
    val dir = lbr_temp("sysl-ckg-cmp")

    write_bytes(s"$dir/a", read_bytes(a).unwrap()).unwrap()
    write_bytes(s"$dir/b", read_bytes(b).unwrap()).unwrap()
    capture("/usr/bin/codesign", ["--remove-signature", s"$dir/a"], "", [], true).unwrap()
    capture("/usr/bin/codesign", ["--remove-signature", s"$dir/b"], "", [], true).unwrap()

    val same = ckg_same_bytes(s"$dir/a", s"$dir/b")

    remove_dir_all(dir).unwrap_or(())
    same
end ckg_same

private ckg_same_bytes(a: string, b: string) -> bool
    val x = read_bytes(a).unwrap()
    val y = read_bytes(b).unwrap()

    if x.len != y.len then return false

    // The one difference two links of one program have once the signature is gone is the 16-byte
    // `LC_UUID` the linker draws afresh; any difference outside one such window is a different program.
    var first: usize = x.len

    for i in 0..<x.len
        if x[i] != y[i]
            if first == x.len then first = i
            if i >= first + 16 then return false

    true
end ckg_same_bytes

// What the run cache did between two counts.
// A slot reserved is a build, whatever the lookup before it found.
private ckg_run_verdict(before: (int, int), after: (int, int)) -> string =
    if after.1 > before.1 then "miss" else if after.0 > before.0 then "hit" else "none"

// What the root cache did between two counts.
private ckg_root_verdict(before: (int, int, int), after: (int, int, int)) -> string =
    if after.0 > before.0 then "hit" else if after.1 > before.1 then "miss"
    else if after.2 > before.2 then "source" else "none"

private ckg_nothing() = ()

// **The seam, through `sysl run`**: the first setting, the second, the first again. It reads
// `first | second | back | verdicts | entries`, the last saying whether the two entries' bytes differ.
private ckg_seam(root: string, a: string, b: string, to_a: () -> unit, to_b: () -> unit) -> string
    val cache = ckg_caches()
    var said: Buf[string] = buf()
    var how: Buf[string] = buf()

    for step in 0..<3
        if step == 1 then to_b() else to_a()

        val before = run_cache_counts()

        said.push(ckg_ran(root, if step == 1 then b else a))
        how.push(ckg_run_verdict(before, run_cache_counts()))

    val bytes = ckg_entries_compared(ckg_entries(cache))

    ckg_done(cache, [])
    s"${said.at(0)} | ${said.at(1)} | ${said.at(2)} | ${join(how.view(), " ")} | $bytes"
end ckg_seam

// Two entries' bytes compared, or how many entries there were where there were not two.
private ckg_entries_compared(made: Buf[string]) -> string
    if made.len() != 2 then return s"${made.len()} entries"

    if ckg_same(made.at(0), made.at(1)) then "same bytes" else "different bytes"
end ckg_entries_compared

// The same seam over flags alone.
private ckg_flags_seam(root: string, a: string, b: string) -> string =
    ckg_seam(root, a, b, () -> ckg_nothing(), () -> ckg_nothing())

// The same seam over a manifest: `a`'s text, `b`'s, `a`'s again.
private ckg_manifest_seam(root: string, a: string, b: string) -> string =
    ckg_seam(root, "", "", () -> ckg_put(root, "package.hocon", a), () -> ckg_put(root, "package.hocon", b))

// **The seam, through `sysl build` and a `--lib` root's kept half**: `first | second | back |
// verdicts`, each verdict the root cache's.
private ckg_root_seam(root: string, lib: string, a: string, b: string, to_a: () -> unit,
                      to_b: () -> unit) -> string
    val cache = ckg_caches()
    val exe = s"$cache/program"
    var said: Buf[string] = buf()
    var how: Buf[string] = buf()

    for step in 0..<3
        if step == 1 then to_b() else to_a()

        val before = root_artifact_counts()

        said.push(ckg_built(root, s"--lib $lib ${if step == 1 then b else a}", exe))
        how.push(ckg_root_verdict(before, root_artifact_counts()))

    ckg_done(cache, [])
    s"${said.at(0)} | ${said.at(1)} | ${said.at(2)} | ${join(how.view(), " ")}"
end ckg_root_seam

// -- the feature request and the manifest's features -------------------------------------------------

private ckg_featured(features: string) -> string =
    ckg_project(ckg_manifest("app", s"features { $features }\n"),
                "#if feature_fancy\nval v = 2\n#else\nval v = 1\n#endif", "v", [])

@test("--features keys the run cache: a feature turned on is a miss, and off again a hit")
ckg_features_flag()
    if !ckg_ready() then return

    val root = ckg_featured("fancy = []")

    assert_eq(ckg_flags_seam(root, "", "--features fancy"), "1 | 2 | 1 | miss miss hit | different bytes")
    remove_dir_all(root).unwrap_or(())
end ckg_features_flag

@test("--no-default-features keys the run cache")
ckg_no_default_features_flag()
    if !ckg_ready() then return

    val root = ckg_featured("default = [fancy], fancy = []")

    assert_eq(ckg_flags_seam(root, "", "--no-default-features"), "2 | 1 | 2 | miss miss hit | different bytes")
    remove_dir_all(root).unwrap_or(())
end ckg_no_default_features_flag

@test("--all-features keys the run cache")
ckg_all_features_flag()
    if !ckg_ready() then return

    val root = ckg_featured("fancy = []")

    assert_eq(ckg_flags_seam(root, "", "--all-features"), "1 | 2 | 1 | miss miss hit | different bytes")
    remove_dir_all(root).unwrap_or(())
end ckg_all_features_flag

@test("the manifest's default features key the run cache")
ckg_default_features_in_the_manifest()
    if !ckg_ready() then return

    val root = ckg_featured("fancy = []")

    assert_eq(ckg_manifest_seam(root, ckg_manifest("app", "features { fancy = [] }\n"),
                                ckg_manifest("app", "features { default = [fancy], fancy = [] }\n")),
              "1 | 2 | 1 | miss miss hit | different bytes")
    remove_dir_all(root).unwrap_or(())
end ckg_default_features_in_the_manifest

// -- a dependency's options and features, set by the root -------------------------------------------

// A package `leaf` with an option `n` and a feature `fancy` (its default where `default` is true):
// `value()` is `n`, plus 100 with `fancy` on.
private ckg_leaf(default_on: bool) -> string =
    ckg_tree([("package.hocon", ckg_manifest("leaf", "options { n { type = int, default = 1 } }\n" +
               (if default_on then "features { default = [fancy], fancy = [] }\n" else "features { fancy = [] }\n"))),
              ("leaf/leaf.sysl", "module leaf\n\nvalue() -> int\n    var v = option_n\n#if feature_fancy\n" +
               "    v += 100\n#endif\n    v\n")])

// A project depending on `leaf` at `dir` through an entry carrying `extra`.
private ckg_on_leaf(dir: string, extra: string) -> string =
    ckg_project(ckg_manifest("app", s"dependencies { leaf { path = \"$dir\"$extra } }\n"), "import leaf",
                "leaf.value()", [])

private ckg_leaf_entry(dir: string, extra: string) -> string =
    ckg_manifest("app", s"dependencies { leaf { path = \"$dir\"$extra } }\n")

@test("an option value the root's entry sets keys the run cache")
ckg_root_sets_an_option()
    if !ckg_ready() then return

    val leaf = ckg_leaf(false)
    val root = ckg_on_leaf(leaf, "")

    assert_eq(ckg_manifest_seam(root, ckg_leaf_entry(leaf, ", options = { n = 2 }"),
                                ckg_leaf_entry(leaf, ", options = { n = 3 }")),
              "2 | 3 | 2 | miss miss hit | different bytes")
    lbr_drop([root, leaf])
end ckg_root_sets_an_option

@test("the features the root's entry asks of a dependency key the run cache")
ckg_root_asks_a_feature()
    if !ckg_ready() then return

    val leaf = ckg_leaf(false)
    val root = ckg_on_leaf(leaf, "")

    assert_eq(ckg_manifest_seam(root, ckg_leaf_entry(leaf, ""), ckg_leaf_entry(leaf, ", features = [\"fancy\"]")),
              "1 | 101 | 1 | miss miss hit | different bytes")
    lbr_drop([root, leaf])
end ckg_root_asks_a_feature

@test("default_features = false in the root's entry keys the run cache")
ckg_root_turns_defaults_off()
    if !ckg_ready() then return

    val leaf = ckg_leaf(true)
    val root = ckg_on_leaf(leaf, "")

    assert_eq(ckg_manifest_seam(root, ckg_leaf_entry(leaf, ""), ckg_leaf_entry(leaf, ", default_features = false")),
              "101 | 1 | 101 | miss miss hit | different bytes")
    lbr_drop([root, leaf])
end ckg_root_turns_defaults_off

// -- targets.<t>.features ----------------------------------------------------------------------------

@test("a root's targets.<t>.features block keys the run cache: taking os away under a feature refuses")
ckg_root_target_feature_block()
    if !ckg_ready() then return

    val host = host_target().name
    val root = ckg_featured("lean = []")
    val plain = ckg_manifest("app", "features { lean = [] }\n")
    val lean = ckg_manifest("app", s"features { lean = [] }\ntargets { $host { features { lean { " +
                             "capabilities { os = false } } } } }\n")

    assert_eq(ckg_seam(root, "--features lean", "--features lean", () -> ckg_put(root, "package.hocon", plain),
                       () -> ckg_put(root, "package.hocon", lean)),
              "1 | refused | 1 | miss none hit | 1 entries")
    remove_dir_all(root).unwrap_or(())
end ckg_root_target_feature_block

@test("a dependency's targets.<t>.features block is not applied, and changing it still misses rather than replay")
ckg_dependency_target_feature_block()
    if !ckg_ready() then return

    val host = host_target().name
    val leaf = ckg_leaf(false)
    val root = ckg_on_leaf(leaf, "")
    val plain = ckg_manifest("leaf", "options { n { type = int, default = 1 } }\nfeatures { fancy = [] }\n")
    val blocked = plain + s"targets { $host { features { fancy { capabilities { os = false } } } } }\n"

    // The root turns `fancy` on, so the block would bite if a dependency's applied.
    ckg_put(root, "package.hocon", ckg_leaf_entry(leaf, ", features = [\"fancy\"]"))

    assert_eq(ckg_seam(root, "", "", () -> ckg_put(leaf, "package.hocon", plain),
                       () -> ckg_put(leaf, "package.hocon", blocked)),
              "101 | 101 | 101 | miss miss hit | same bytes")
    lbr_drop([root, leaf])
end ckg_dependency_target_feature_block

// -- the C a build compiles ---------------------------------------------------------------------------

// A project whose answer comes from the C beside its module `cv`, which reads `CKG_D`, `CKG_X` and the
// header `ckg.h` where each is there.
private ckg_c_project(header: bool) -> string =
    ckg_project(ckg_manifest("app", ""), "import cv", "cv.value()",
                [("cv/cv.sysl", "module cv\n\nextern \"ckg_value\" value() -> int\n"),
                 ("cv/cv.c", (if header then "#include \"ckg.h\"\n" else "") +
                  "int ckg_value(void) {\n#if defined(CKG_H)\n  return CKG_H;\n#elif defined(CKG_D)\n" +
                  "  return CKG_D;\n#elif defined(CKG_X)\n  return CKG_X;\n#else\n  return 1;\n#endif\n}\n")])

@test("-D keys the run cache")
ckg_define_flag()
    if !ckg_ready() then return

    val root = ckg_c_project(false)

    // One macro against another of the same name, so only the value tells the two keys apart.
    assert_eq(ckg_flags_seam(root, "-D CKG_D=5", "-D CKG_D=6"), "5 | 6 | 5 | miss miss hit | different bytes")
    remove_dir_all(root).unwrap_or(())
end ckg_define_flag

@test("--include-path keys the run cache: the same header name in two directories is two programs")
ckg_include_path_flag()
    if !ckg_ready() then return

    val four = ckg_tree([("ckg.h", "#define CKG_H 4\n")])
    val five = ckg_tree([("ckg.h", "#define CKG_H 5\n")])
    val root = ckg_c_project(true)

    assert_eq(ckg_flags_seam(root, s"--include-path $four", s"--include-path $five"),
              "4 | 5 | 4 | miss miss hit | different bytes")
    lbr_drop([root, four, five])
end ckg_include_path_flag

@test("SYSL_EXTRA_CFLAGS keys the run cache")
ckg_extra_cflags()
    if !ckg_ready() then return

    val root = ckg_c_project(false)
    val got = ckg_seam(root, "", "", () -> ckg_unsetenv("SYSL_EXTRA_CFLAGS"),
                       () -> ckg_setenv("SYSL_EXTRA_CFLAGS", "-DCKG_X=7"))

    ckg_unsetenv("SYSL_EXTRA_CFLAGS")
    assert_eq(got, "1 | 7 | 1 | miss miss hit | different bytes")
    remove_dir_all(root).unwrap_or(())
end ckg_extra_cflags

@test("a header edited inside a dependency keys the run cache")
ckg_dependency_header_edit()
    if !ckg_ready() then return

    val dep = ckg_tree([("package.hocon", ckg_manifest("cdep", "")),
                        ("cdep/cdep.sysl", "module cdep\n\nextern \"cdep_value\" value() -> int\n"),
                        ("cdep/cdep.c", "#include \"cdep.h\"\nint cdep_value(void) { return CDEP; }\n"),
                        ("cdep/cdep.h", "#define CDEP 3\n")])
    val root = ckg_project(ckg_manifest("app", s"dependencies { cdep { path = \"$dep\" } }\n"), "import cdep",
                           "cdep.value()", [])

    assert_eq(ckg_seam(root, "", "", () -> ckg_put(dep, "cdep/cdep.h", "#define CDEP 3\n"),
                       () -> ckg_put(dep, "cdep/cdep.h", "#define CDEP 8\n")),
              "3 | 8 | 3 | miss miss hit | different bytes")
    lbr_drop([root, dep])
end ckg_dependency_header_edit

@test("a header requirement answered from the variable a package names keys the run cache")
ckg_header_variable()
    if !ckg_ready() then return

    val four = ckg_tree([("ckg.h", "#define CKG_H 4\n")])
    val five = ckg_tree([("ckg.h", "#define CKG_H 5\n")])
    val root = ckg_c_project(true)

    ckg_put(root, "package.hocon", ckg_manifest("app", "requires { headers { ckg = { note = \"the ckg " +
            "headers\", env = \"CKG_SDK_ROOT\" } } }\n"))

    val got = ckg_seam(root, "", "", () -> ckg_setenv("CKG_SDK_ROOT", four), () -> ckg_setenv("CKG_SDK_ROOT", five))

    ckg_unsetenv("CKG_SDK_ROOT")
    assert_eq(got, "4 | 5 | 4 | miss miss hit | different bytes")
    lbr_drop([root, four, five])
end ckg_header_variable

// -- a header outside every tree, by what the build's C read -------------------------------------------

// The seam over an edit to `ckg.h` in `dir`: `CKG_H` 4, then 5, then 4 again.
private ckg_header_seam(root: string, dir: string, flags: string) -> string =
    ckg_seam(root, flags, flags, () -> ckg_put(dir, "ckg.h", "#define CKG_H 4\n"),
             () -> ckg_put(dir, "ckg.h", "#define CKG_H 5\n"))

@test("a header edited in an --include-path directory outside the project keys the run cache")
ckg_outside_header_edit()
    if !ckg_ready() then return

    val dir = ckg_tree([("ckg.h", "#define CKG_H 4\n")])
    val root = ckg_c_project(true)

    assert_eq(ckg_header_seam(root, dir, s"--include-path $dir"), "4 | 5 | 4 | miss miss hit | different bytes")
    lbr_drop([root, dir])
end ckg_outside_header_edit

@test("a header outside every tree that a dependency's C includes, edited, keys the run cache")
ckg_outside_header_edit_through_a_dependency()
    if !ckg_ready() then return

    val dir = ckg_tree([("ckg.h", "#define CKG_H 4\n")])
    val dep = ckg_tree([("package.hocon", ckg_manifest("cdep", "")),
                        ("cdep/cdep.sysl", "module cdep\n\nextern \"cdep_value\" value() -> int\n"),
                        ("cdep/cdep.c", "#include \"ckg.h\"\nint cdep_value(void) { return CKG_H; }\n")])
    val root = ckg_project(ckg_manifest("app", s"dependencies { cdep { path = \"$dep\" } }\n"), "import cdep",
                           "cdep.value()", [])

    assert_eq(ckg_header_seam(root, dir, s"--include-path $dir"), "4 | 5 | 4 | miss miss hit | different bytes")
    lbr_drop([root, dep, dir])
end ckg_outside_header_edit_through_a_dependency

// A module whose answer is a `c const` measured from `ckg.h`, wherever the include path finds it.
private ckg_measured(module_name: string) -> string =
    s"module $module_name\n@include(\"ckg.h\")\n\nc const\n    H: int = \"CKG_H\"\n\nvalue() -> int = H\n"

@test("a header outside every tree that a c const block was measured from, edited, keys the run cache")
ckg_outside_header_edit_through_c_const()
    if !ckg_ready() then return

    val dir = ckg_tree([("ckg.h", "#define CKG_H 4\n")])
    val root = ckg_project(ckg_manifest("app", ""), "import cm", "cm.value()", [("cm/cm.sysl", ckg_measured("cm"))])

    assert_eq(ckg_header_seam(root, dir, s"--include-path $dir"), "4 | 5 | 4 | miss miss hit | different bytes")
    lbr_drop([root, dir])
end ckg_outside_header_edit_through_c_const

@test("a header outside every tree that a --lib root's c const was measured from, edited, misses its kept half")
ckg_outside_header_edit_reaches_a_root()
    if !ckg_ready() then return

    val dir = ckg_tree([("ckg.h", "#define CKG_H 4\n")])
    val lib = ckg_tree([("geo/geo.sysl", ckg_measured("geo"))])
    val root = ckg_project(ckg_manifest("app", ""), "import geo", "geo.value()", [])

    val kept = ckg_root_seam(root, lib, s"--include-path $dir", s"--include-path $dir",
                             () -> ckg_put(dir, "ckg.h", "#define CKG_H 4\n"),
                             () -> ckg_put(dir, "ckg.h", "#define CKG_H 5\n"))

    lbr_drop([root, lib, dir])
    assert_eq(kept, "4 | 5 | 4 | miss miss hit")
end ckg_outside_header_edit_reaches_a_root

