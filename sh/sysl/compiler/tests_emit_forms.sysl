                  "\n" +
                  "mag(x: i32) -> i32 = x.abs()\n" +
                  "\n" +
                  "sgn(x: i32) -> i32 = x.signum()\n" +
                  "\n" +
                  "rev(x: u32) -> u32 = x.reverse_bits()\n" +
                  "\n" +
                  "rotl(x: u32, n: u32) -> u32 = x.rotate_left(n)\n" +
                  "\n" +
                  "rotr(x: u32) -> u32 = x.rotate_right(3)\n" +
                  "\n" +
