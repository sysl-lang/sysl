module sysl.reflect

/** One field of a struct, a tuple or a union, as `T::Fields` lists it while compiling.
 *
 * `index` is the field's position among the ones the type declares, and `offset` is where it
 * begins, in bytes from the start of the value. A tuple's parts are named `"0"`, `"1"`, and so on.
 * `public` says whether code outside the type's own file may name the field.
 */
struct Field
    name: string
    index: usize
    offset: usize
    public: bool

/** One variant of an enum, as `T::Variants` lists it while compiling: its name, and its position
 * among the enum's variants.
 */
struct Variant
    name: string
    index: usize
