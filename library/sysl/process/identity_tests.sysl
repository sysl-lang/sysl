module sysl.process
@requires(posix)
@tests

import sysl.buf.{Buf, buf}
import sysl.posix.time.sleep
import sysl.time.millis
import sysl.fs.{IoError, make_temp_dir, metadata, remove_dir_all, set_owner, write_text}
import sysl.process.sys as psys
import sysl.slices.as_mut_ptr
import sysl.testing.skip

// Who the program is, over `sysl.process.sys`'s `get_id` and `set_id` hooks as `sysl.process.hosted`
// answers them, checked against what the filesystem says of a file the program made and against
// `id`, the system's own answer. The refusals are the unprivileged ones, so the suite skips them when
// it is run as user 0.

private id_of(flag: string) -> u32
    val out = capture("id", [flag]).unwrap()

    assert(out.status.ok(), s"id $flag failed")

    var n: u32 = 0

    for b in out.text.bytes
        if b >= u8('0') && b <= u8('9') then n = n * 10 + u32(b - u8('0'))

    n
end id_of

@test("user and group are the effective ids the system reports, and the real ones match them")
id_answers_what_id_says()
    assert_eq(user(), id_of("-u"))
    assert_eq(group(), id_of("-g"))
    assert_eq(real_user(), id_of("-ru"))
    assert_eq(real_group(), id_of("-rg"))

@test("a file the program made is its own: Meta.owner == user()")
id_owns_what_it_makes()
    val dir = make_temp_dir("sysl-proc-id").unwrap()
    val path = s"$dir/mine"

    write_text(path, "x").unwrap()

    val m = metadata(path).unwrap()

    assert(m.owner == user(), s"owner ${m.owner}, user ${user()}")

    // And it may be given to the owner it has, which is the one change nobody needs privilege for.
    set_owner(path, user(), m.group).unwrap()
    assert_eq(metadata(path).unwrap().owner, user())

    remove_dir_all(dir)
end id_owns_what_it_makes

@test("a file given to root by a program that is not root is refused with NotPermitted")
id_chown_to_root_is_refused()
    if user() == 0 then skip("run as root, so giving a file away is allowed")

    val dir = make_temp_dir("sysl-proc-id").unwrap()
    val path = s"$dir/mine"

    write_text(path, "x").unwrap()

    val refused = set_owner(path, 0, metadata(path).unwrap().group)

    assert_eq(metadata(path).unwrap().owner, user())
    remove_dir_all(dir)

    refused match
        Ok(_) -> assert(false, "a file was given to root")
        Err(e) -> assert_eq(e, IoError.NotPermitted)
end id_chown_to_root_is_refused

@test("set_user and set_group to the ids the program already has succeed and change nothing")
id_set_to_itself()
    val u = user()
    val g = group()

    set_group(g).unwrap()
    set_user(u).unwrap()

    assert_eq(user(), u)
    assert_eq(group(), g)

@test("set_user and set_group to root from a program that is not root are refused with NotPermitted")
id_set_to_root_is_refused()
    if user() == 0 then skip("run as root, so becoming root is allowed")

    set_user(0) match
        Ok(_) -> assert(false, "the program became root")
        Err(e) -> assert_eq(e, IoError.NotPermitted)

    if real_group() != 0
        set_group(0) match
            Ok(_) -> assert(false, "the program joined group 0")
            Err(e) -> assert_eq(e, IoError.NotPermitted)

    assert(user() != 0, "the refusal changed the user anyway")
end id_set_to_root_is_refused

@test("hostname is the name `uname -n` reports, and is not empty")
hostname_matches_uname()
    val name = hostname().unwrap()
    val out = capture("uname", ["-n"]).unwrap()

    assert(out.status.ok(), "uname -n failed")
    assert(name.len > 0, "the host name is empty")
    assert_eq(name, out.text.trim())

@test("a host name that does not fit the room it is given is a failure, never a cut-short success")
hostname_refuses_a_short_room()
    var raw: []u8 = [0; 1]

    val n = psys.hostname(as_mut_ptr(raw), 0)

    assert(n < 0, s"a room of zero bytes was answered with $n")

    val whole = hostname().unwrap()
    var one: []u8 = [0; 1]

    if whole.len > 1 then assert(psys.hostname(as_mut_ptr(one), 1) < 0, "a one-byte room held a longer name")

@test("pid is this program's process id: the parent a child it starts reports")
id_pid_is_the_childs_parent()
    val out = capture("sh", ["-c", "echo $PPID"]).unwrap()

    assert(out.status.ok(), "sh -c failed")
    assert_eq(out.text, s"${pid()}\n")
    assert(pid() > 0, "a hosted program has a process id")

@test("a child's pid is not the program's own")
id_pid_is_not_a_childs()
    var child = start("sh", ["-c", "exit 0"]).unwrap()

    assert(child.pid() != int(pid()), "the child has a process of its own")
    child.wait().unwrap()

@test("the process id is asked, never set")
id_the_process_is_not_set()
    assert(psys.set_id(psys.id_process, 1) < 0, "set_id took the process id")

@test("total_memory is the machine's memory: positive, and more than this program holds")
mem_total_exceeds_own_resident()
    val total = total_memory().unwrap()
    val own = resident_bytes(int(pid())).unwrap()

    assert(total > 0, "the machine has no memory")
    assert(own > 0, "this program has no resident memory")
    assert(total >= own, s"total $total is less than own resident $own")

#if bsd
private system_total() -> string = capture("sysctl", ["-n", "hw.memsize"]).unwrap().text.trim()
#else
private system_total() -> string =
    capture("sh", ["-c", "awk '/MemTotal/ {printf \"%.0f\", $2 * 1024}' /proc/meminfo"]).unwrap().text.trim()
#endif

@test("total_memory agrees with the system's own answer")
mem_total_matches_the_system()
    assert_eq(system_total(), s"${total_memory().unwrap()}")

@test("resident_bytes of this program grows by about what it allocates and touches")
mem_resident_grows_when_touched()
    val before = resident_bytes(int(pid())).unwrap()
    val size: usize = 64 * 1024 * 1024
    var block: []u8 = [0; 64 * 1024 * 1024]

    var i: usize = 0

    loop
        if i >= size then break
        block[i] = u8(1)
        i += 4096
    end loop

    val after = resident_bytes(int(pid())).unwrap()

    assert(after >= before + 32 * 1024 * 1024, s"resident went from $before to $after")
    assert_eq(block[4096], u8(1))

@test("resident_bytes reads a live child, and a reaped child is an error")
mem_resident_of_a_child()
    var child = start("sleep", ["5"]).unwrap()
    val id = child.pid()

    assert(resident_bytes(id).unwrap() > 0, "a live child has resident memory")
    child.kill().unwrap()
    child.wait().unwrap()
    assert_eq(resident_bytes(id).unwrap_err(), IoError.NotFound)

@test("resident_bytes of a pid no process can have is an error")
mem_resident_of_no_process()
    assert(resident_bytes(0).is_err(), "pid 0")
    assert(resident_bytes(-1).is_err(), "pid -1")
    assert(resident_bytes(-2147483647).is_err(), "a very negative pid")
    assert_eq(resident_bytes(2147483647).unwrap_err(), IoError.NotFound)

@test("resident_bytes of a process the program may not look at is NotPermitted, or a size where the host allows it")
mem_resident_of_pid_one()
    resident_bytes(1) match
        Ok(n) -> assert(n > 0, "pid 1 resident")
        Err(e) -> assert_eq(e, IoError.NotPermitted)

// ## Who is in a group, and whose child a process is

private has(found: Buf[int], id: int) -> bool
    for v in found.view()
        if v == id then return true

    false
end has

@test("children lists every child the program started, and only those")
tree_children_lists_each_child()
    val before = children(int(pid())).unwrap().len()
    var a = spawn("sleep", ["5"]).unwrap()
    var b = spawn("sleep", ["5"]).unwrap()
    var c = spawn("sleep", ["5"]).unwrap()
    val mine = children(int(pid())).unwrap()

    assert(has(mine, a.pid()), "the first child")
    assert(has(mine, b.pid()), "the second child")
    assert(has(mine, c.pid()), "the third child")
    assert(!has(mine, int(pid())), "the program is not its own child")
    assert_eq(mine.len(), before + 3)

    a.kill(9).unwrap()
    b.kill(9).unwrap()
    c.kill(9).unwrap()
    a.wait().unwrap()
    b.wait().unwrap()
    c.wait().unwrap()

@test("children does not list a grandchild")
tree_children_skips_grandchildren()
    var child = spawn("sh", ["-c", "sleep 5 & wait"]).unwrap()
    val own = children(int(pid())).unwrap()

    assert(has(own, child.pid()), "the shell is a child")

    var grand: Buf[int] = buf()

    for _ in 0..<100
        grand = children(child.pid()).unwrap()
        if grand.len() > 0 then break
        sleep(millis(20))

    assert(grand.len() > 0, "the shell's own child never appeared")
    assert(!has(own, grand[0]), "a grandchild is not this program's child")
    assert(!has(grand, child.pid()), "a process is not its own child")

    child.kill(9).unwrap()
    child.wait().unwrap()

@test("a child started in a group of its own leads it, and group_members lists it there alone")
tree_new_group_has_the_child()
    var child = spawn("sleep", ["5"], group = Group.New).unwrap()
    val members = group_members(child.group()).unwrap()

    assert_eq(child.group(), child.pid())
    assert_eq(members.len(), 1)
    assert(has(members, child.pid()), "the leader")

    child.kill(9).unwrap()
    child.wait().unwrap()

@test("a child left in this program's group is listed in it beside the program")
tree_inherited_group_holds_the_child()
    var child = spawn("sleep", ["5"]).unwrap()
    val members = group_members(process_group()).unwrap()

    assert(has(members, child.pid()), "the child")
    assert(has(members, int(pid())), "this program")

    child.kill(9).unwrap()
    child.wait().unwrap()

@test("a child that joins another's group is listed in it with the leader")
tree_joined_group_holds_both()
    var leader = spawn("sleep", ["5"], group = Group.New).unwrap()
    var member = spawn("sleep", ["5"], group = Group.Join(leader.group())).unwrap()
    val members = group_members(leader.group()).unwrap()

    assert_eq(members.len(), 2)
    assert(has(members, leader.pid()), "the leader")
    assert(has(members, member.pid()), "the member")

    leader.kill(9).unwrap()
    member.kill(9).unwrap()
    leader.wait().unwrap()
    member.wait().unwrap()

@test("a child reaped by wait_pid is in neither list afterwards")
tree_reaped_child_is_gone()
    var child = spawn("sleep", ["5"], group = Group.New).unwrap()
    val id = child.pid()
    val group = child.group()

    assert(has(children(int(pid())).unwrap(), id), "listed while it runs")
    child.kill(9).unwrap()

    val gone = child.detach()

    assert_eq(gone, id)
    wait_pid(id).unwrap()
    assert(!has(children(int(pid())).unwrap(), id), "still a child after the wait")
    assert_eq(group_members(group).unwrap().len(), 0)

@test("a pid or group nothing has answers an empty list, not an error")
tree_unused_is_empty()
    assert_eq(children(2147483647).unwrap().len(), 0)
    assert_eq(group_members(2147483647).unwrap().len(), 0)

@test("a process with no children answers an empty list")
tree_leaf_has_no_children()
    var child = spawn("sleep", ["5"]).unwrap()

    assert_eq(children(child.pid()).unwrap().len(), 0)
    child.kill(9).unwrap()
    child.wait().unwrap()

@test("a pid or group of zero or less is Other(22), whatever the sign")
tree_non_positive_is_an_error()
    assert_eq(children(0).unwrap_err(), IoError.Other(22))
    assert_eq(children(-1).unwrap_err(), IoError.Other(22))
    assert_eq(children(-2147483647).unwrap_err(), IoError.Other(22))
    assert_eq(group_members(0).unwrap_err(), IoError.Other(22))
    assert_eq(group_members(-1).unwrap_err(), IoError.Other(22))
    assert_eq(group_members(-2147483647).unwrap_err(), IoError.Other(22))

@test("pid 1's children, or its group, are answered where the host lets the program see them")
tree_pid_one_is_listed_or_empty()
    assert(children(1).is_ok(), "children of pid 1")
    assert(group_members(1).is_ok(), "group of pid 1")

@test("more members than the first guess holds are all listed")
tree_a_long_list_is_complete()
    var kids: Buf[&Spawned] = buf()

    for _ in 0..<90
        kids.push(spawn("sleep", ["5"], group = Group.Join(process_group())).unwrap())

    val mine = children(int(pid())).unwrap()
    val group = group_members(process_group()).unwrap()

    for k in kids.view()
        assert(has(mine, k.pid()), "a child is missing from children")
        assert(has(group, k.pid()), "a child is missing from group_members")

    for i in 0..<kids.len()
        kids[i].kill(9).unwrap()
        kids[i].wait().unwrap()
