module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.{str_builder, StrBuilder}

// Calling a member on a receiver whose type is not yet a concrete one.
//
// **A generic body is checked once, at its definition**, with each type parameter opaque except for
// what its bounds promise: the call is looked up in the traits the bounds name and checked against
// the *trait's* signature, which is what lets one walk stand in for every instantiation. An `impl`
// conforms to its trait exactly, so a call the trait's signature accepts is one every implementation
// accepts.
//
// **Nothing else will ever check these.** An instantiation resolves the same call against a concrete
// implementation, so a mistake in what a bound licenses is caught here or nowhere -- which is why the
// complaints survive a walk that is otherwise thrown away.

// The first member of that name one of a parameter's bounds declares, with the substitution its
// signature is read under.
//
// That substitution is the whole of what a bound's *arguments* buy. `Self` is the parameter itself,
// which is what makes an `add` yield a `T` and an `lt` a `bool` inside a body that has not met a
// concrete type yet; the trait's own parameters are the arguments the bound applied it to, so a
// `T: From[int]` has a `from` that takes an `int`.
bound_member(a: &Analysis, subject: Type, bounds: Buf[Bound],
             mname: string) -> Option[(Bound, Buf[Binding], MethodDecl)]
    for item in bounds
        val closure = trait_closure(a, item, self_binding(subject))

        for j in 0..<closure.len()
            val b = closure.at(j)
            val d = trait_decl_at(a, b.name)

            if d.is_some()
                val m = trait_method(d.unwrap(), mname)

                if m.is_some()
                    var subst = self_binding(subject)

                    // Padded rather than zipped, because a bound whose own resolution failed is
                    // recorded with whatever survived of its arguments -- and reading a member
                    // against a short list would report the trait's signature as unresolvable.
                    for k in 0..<d.unwrap().tparams.len()
                        val arg = if k < b.args.len() then b.args.at(k) else Unknown

                        subst.push(Binding(d.unwrap().tparams.at(k), arg))

                    return Some((b, subst, m.unwrap()))

    None
end bound_member

// `x.m(…)` where `x` is a type parameter.
call_bound_method(cx: &Analyzer, span: Span, receiver: TExpr, subject: Type, name: string,
                  bounds: Buf[Bound], args: Buf[Expr],
                  targs: Buf[Expr] = no_written_members()) -> TExpr
    val found = bound_member(cx.an, subject, bounds, name)

    if found.is_none() then return unlicensed(cx, span, subject, name)

    val tr = found.unwrap().0
    val m = found.unwrap().2
    // **A list written at the call settles the member's own parameters outright**, as it does on a
    // concrete receiver: `o.one[int]()` through `[O: Out]` names the `A` of `Out.one[A]`, which no
    // argument may mention at all. Put first, so that every reading below finds it before the
    // stand-in or the open slot it replaces.
    val mine = authored_tparams(m.tparams)

    if !targs.is_empty() && mine.is_empty() then
        return kept_error(cx, span, s"'$name' is not generic, so it has no type arguments to write " +
                          s"— the call is '$name(…)'")

    if !targs.is_empty() && mine.len() != targs.len() then
        return kept_error(cx, span, s"'$name' takes ${quantity(mine.len(), "type argument")} " +
                          s"(${quoted_names(mine)}), and ${targs.len()} " +
                          s"${if targs.len() == 1 then "was" else "were"} written")

    var listed: Buf[Binding] = buf()

    for i in 0..<targs.len()
        listed.push(Binding(mine.at(i), written_type_arg(cx, targs.at(i))))

    val subst = joined_bindings(listed, found.unwrap().1)
    val fname = s"${tr.name}.$name"
    val shown = s"method '${qualified_name(tr.name)}.$name'"

    if m.is_property then
        cx.an.bound_fault(cx.scope, span, s"'$name' is a property of '${tr.show()}' — read it as " +
                          s"'value.$name', without '()'")

    if m.recv_mode().is_none() then
        cx.an.bound_fault(cx.scope, span, s"'$name' is an associated function of '${tr.show()}', so " +
                          "it has no receiver — a value cannot be the thing it is called on")

    val scope = trait_scope_of(cx.an, tr.name)
    // **A member's own type parameters stand in for themselves, carrying what it asked of them.**
    // A bare arrow in the signature became one of them, so without this a closure standing at
    // `f: int -> int` is read against a name nothing here answers for and comes back unknown.
    val terms = joined_bindings(subst, abstract_subst(cx.an, scope, m.tparams, m.bounds, m.tvalues,
                                                      m.tpacks, subst))
    // **What a written type SAYS about one is open until the call settles it**, which is the other
    // half of the same rule: `f: &Fn(int) -> U` tells a closure what it takes and nothing about what
    // it yields, so `U` stands at nothing and the body is what answers. A parameter that *is* one of
    // those names is the exception -- there the bound is the whole of what was said.
    var open_terms = subst

    for tparam in m.tparams
        if bound_type(listed, tparam).is_none() then
            open_terms = joined_bindings(open_terms, one_binding(tparam, Unknown))

    var params: Buf[(string, Type)] = buf()

    for param in m.params
        val written = param.typ
        val at = if names_own_tparam(written, m.tparams) then terms else open_terms

        // **A tuple of the member's own pack is open at ANY arity**: the call is what says how many
        // parts there are, so the argument is read bare rather than held to the two stand-ins.
        val ty = if spreads_own_pack(written, m.tpacks) then Unknown
        else resolve_type(cx.an, scope, written, at)

        params.push((param.name, ty))

    // **A call through a bound binds what was written exactly as a call on the type does**: a name
    // says which parameter it fills, and a parameter nothing filled takes the trait's default
    // (`reference/declarations.md § Default parameters and named arguments` makes no exception).
    val bound = bind_member_args(cx, span, shown, m, args, true)

    if bound.is_none() then return bad_expr(span)

    val slots = bound.unwrap()

    // **A callable is read once the others have said what it takes**, exactly as it is on a concrete
    // receiver: in `s.fold(0, (a, n) -> a + n)` through `[S: Sequence[int]]` the `0` settles the
    // member's own `A`, and only then does the closure know its `a` is an `int`. Read first, against
    // the stand-in, `a` was the bare `A` and `+` on it was refused. The closure read here is the one
    // kept: reading it again would lower a second closure for the one the program wrote.
    val prov = if m.tparams.is_empty() then None
    else Some(provisional_of(cx, span, scope, m.tparams, m.params, m.ret_type, m.bounds, slots, subst, None,
                             buf()))
    var ts: Buf[TExpr] = buf()

    ts.push(receiver)

    // A default is filled once the call is solved, below, so it takes no part in solving it.
    for i in 0..<slots.len()
        val kept = if prov.is_some() && i < prov.unwrap().kept.len() then prov.unwrap().kept.at(i) else None

        ts.push(slots.at(i) match
            Some(e) -> if kept.is_some() then kept.unwrap() else type_expr(cx, e, Some(params.at(i).1))
            None -> bad_expr(span))

    for e in variadic_tail(m, args)
        ts.push(type_expr(cx, e, None))

    // **The member's own type parameters are solved from what the call supplied**, exactly as a
    // generic function's are: `apply[U](self, f: &Fn(int) -> U) -> U` learns what `U` is from the
    // closure that arrived, and the result the call yields is that.
    var solved = subst

    if !m.tparams.is_empty()
        var param_refs: Buf[TypeRef] = buf()

        for param in m.params
            param_refs.push(param.typ)

        val own = solve(cx.an, scope, cx.scope, span, fname, m.tparams, param_refs, prov.unwrap().tys, None, None,
                        prov.unwrap().soft, m.bounds, subst, left_to_default(slots))

        for i in 0..<m.tparams.len()
            if i < own.len() && own.at(i) != Unknown then
                solved = joined_bindings(solved, one_binding(m.tparams.at(i), own.at(i)))
    end if

    // **Each argument is held to its parameter once the member's own parameters are solved**, and
    // put into the shape it asks for: a closure at `f: &Fn(int) -> U` arrives as its own struct and
    // is read against a result nothing had settled, so the `&Fn` it stands at is only nameable now.
    // A parameter standing in for itself is held to its **bounds** and not to being the same type as
    // what arrived: that is the whole of what a bound licenses.
    var settled = solved

    for tparam in m.tparams
        if bound_type(solved, tparam).is_none() then
            settled = joined_bindings(settled, one_binding(tparam, Unknown))

    for i in 0..<slots.len()
        val written = m.params.at(i).typ
        val want = walk_wanted(m.params.at(i),
                               if m.tparams.is_empty() || names_own_tparam(written, m.tparams) ||
                                  spreads_own_pack(written, m.tpacks) then params.at(i).1
                               else resolve_type(cx.an, scope, written, settled))

        slots.at(i) match
            Some(e) ->
                var t = ts.at(i + 1)

                if !stands_for_itself(want) && disagree(texpr_type(t), want) then t = coerce(cx, t, want)

                if !stands_for_itself(want) && disagree(texpr_type(t), want) then
                    cx.an.bound_fault(cx.scope, e.span,
                                      s"'${params.at(i).0}' of '${qualified_name(tr.name)}.$name' is " +
                                      s"${type_show(want)}, but ${type_show(texpr_type(t))} was given")

                ts.set(i + 1, handed_walk(m.params.at(i), Some(e), t))
            None -> ts.set(i + 1, bound_default(cx, span, scope, settled, m, i, want))

    val ret =
        if m.ret_type.is_some() then declared_result_type(Some(resolve_result(cx.an, scope, m.ret_type.unwrap(), solved)))
        else Unit

    cx.an.uses(fname)
    TExpr(span, TCall(fname, ts, ret, false))
end call_bound_method

// **A default a call through a bound left out is read where the trait wrote it**, with the trait's
// parameters and the member's own standing for what this call settled them to -- the reading a call
// on a concrete type gives the same default, at the one type that is not yet known.
private bound_default(cx: &Analyzer, span: Span, scope: Scope, settled: Buf[Binding], m: MethodDecl,
                      i: usize, want: Type) -> TExpr
    val inner = analyzer_for(cx.an, scope)

    inner.here = Some(call_site(cx, span))
    inner.subst = settled
    inner.tbounds = m.bounds
    handed_walk(m.params.at(i), None, type_expr(inner, m.params.at(i).default.unwrap(), Some(want)))
end bound_default

// The arguments a C-variadic member's tail took: every positional one past its parameters.
private variadic_tail(m: MethodDecl, args: Buf[Expr]) -> Buf[Expr]
    var out: Buf[Expr] = buf()

    if !m.variadic then return out

    var seen: usize = 0

    for a in args
        *a.kind match
            NamedArg(_, _) -> ()
            _ ->
                if seen >= m.params.len() then out.push(a)

                seen += 1
    end for

    out
end variadic_tail

// Whether a written type is one of the member's own parameters, named bare -- which is what a bare
// arrow in a signature became.
private names_own_tparam(t: TypeRef, tparams: Buf[string]) -> bool = *t.kind match
    NamedType(n, args) -> args.is_empty() && holds_string(tparams, n)
    _ -> false

// Whether a written type is `(..A)` over one of the member's own packs.
private spreads_own_pack(t: TypeRef, tpacks: Buf[string]) -> bool = *t.kind match
    TupleType(parts, _) -> parts.len() == 1 && is_own_pack(parts.at(0), tpacks)
    _ -> false

private is_own_pack(t: TypeRef, tpacks: Buf[string]) -> bool = *t.kind match
    PackType(n) -> holds_string(tpacks, n)
    _ -> false

// One binding, as a list of one.
private one_binding(name: string, t: Type) -> Buf[Binding]
    var out: Buf[Binding] = buf()

    out.push(Binding(name, t))
    out
end one_binding

// Whether a type is a parameter standing in for itself, which is what a bound's argument is while a
// call through the bound is being read.
private stands_for_itself(t: Type) -> bool = t match
    Abstract(_, _) -> true
    _ -> false

// `T.f(…)` where `T` is a type parameter and `f` is an associated function one of its bounds
// declares -- what a bound method call is to a value, asked of the type itself.
//
// Checked against the trait's signature and discarded, exactly as a bound method call is: the name it
// carries is the trait's, and which implementation runs is settled once a concrete type is known.
call_bound_associated(cx: &Analyzer, span: Span, subject: Type, name: string, bounds: Buf[Bound],
                      args: Buf[Expr], targs: Buf[Expr] = no_written_members()) -> TExpr
    val found = bound_member(cx.an, subject, bounds, name)

    if found.is_none() then return unlicensed_associated(cx, span, subject, name)

    val tr = found.unwrap().0
    val subst = found.unwrap().1
    val m = found.unwrap().2
    val shown = s"associated function '${qualified_name(tr.name)}.$name'"

    // A **static** property belongs to the type, so `T.count` is the read and there is no value to
    // reach it on. It arrives here because a read with no parentheses is analyzed as the call it is.
    //
    // **A member needing a value is the one mistake**, so nothing is read past it: its arguments
    // weighed against a receiverless shape it does not have would be a second complaint about the
    // same call, and an instantiation does not tell it again (`associated_on`).
    if m.is_property && !m.is_static
        cx.an.bound_fault(cx.scope, span, s"'$name' is a property of '${tr.show()}' — read it on a " +
                          s"value, as 'value.$name'")
        return bad_expr(span)
    end if

    if m.recv_mode().is_some()
        cx.an.bound_fault(cx.scope, span, s"'$name' is an instance method of '${tr.show()}' — call " +
                          s"it on a value of '${type_show(subject)}', not the type")
        return bad_expr(span)
    end if

    val scope = trait_scope_of(cx.an, tr.name)
    // **A list written at the call settles the member's own parameters outright**, as it does on
    // a concrete type: counted, each read against the parameter it fills, and held to that
    // parameter's bounds.
    val mine = authored_tparams(m.tparams)

    if !targs.is_empty() && mine.is_empty() then
        return kept_error(cx, span, s"'$name' is not generic, so it has no type arguments to write " +
                          s"— the call is '$name(…)'")

    if !targs.is_empty() && mine.len() != targs.len() then
        return kept_error(cx, span, s"'$name' takes ${quantity(mine.len(), "type argument")} " +
                          s"(${quoted_names(mine)}), and ${targs.len()} " +
                          s"${if targs.len() == 1 then "was" else "were"} written")

    var listed: Buf[Binding] = buf()

    for i in 0..<targs.len()
        listed.push(Binding(mine.at(i), member_arg_for(cx, m, scope, mine.at(i), targs.at(i), false)))

    for item in listed
        if item.ty == Unknown then return bad_expr(span)

    if !targs.is_empty() && mine.len() == m.tparams.len()
        var own: Buf[Type] = buf()

        for item in listed
            own.push(item.ty)

        if !check_param_bounds(cx.an, scope, span, s"${tr.name}.$name", m.tparams, m.bounds, own, subst,
                               "type parameter", cx.scope) then return bad_expr(span)
    end if

    // **A member's own type parameters stand in for themselves, carrying what it asked of them.**
    // A bare arrow in the signature became one of them, so without this a closure standing at
    // `f: int -> int` is read against a name nothing here answers for and comes back unknown.
    val terms = joined_bindings(joined_bindings(listed, subst),
                                abstract_subst(cx.an, scope, m.tparams, m.bounds, m.tvalues,
                                               m.tpacks, joined_bindings(listed, subst)))
    var params: Buf[(string, Type)] = buf()

    for param in m.params
        params.push((param.name, resolve_type(cx.an, scope, param.typ, terms)))

    val bound = bind_member_args(cx, span, shown, m, args, true)

    if bound.is_none() then return bad_expr(span)

    val slots = bound.unwrap()
    var ts: Buf[TExpr] = buf()

    for i in 0..<slots.len()
        ts.push(slots.at(i) match
            Some(e) -> type_expr(cx, e, Some(params.at(i).1))
            None -> bound_default(cx, span, scope, terms, m, i, params.at(i).1))

    for e in variadic_tail(m, args)
        ts.push(type_expr(cx, e, None))

    val ret =
        if m.ret_type.is_some() then declared_result_type(Some(resolve_result(cx.an, scope, m.ret_type.unwrap(), terms)))
        else Unit

    cx.an.uses(s"${tr.name}.$name")
    TExpr(span, TCall(s"${tr.name}.$name", ts, ret, false))
end call_bound_associated

// `T.f` -- a member selected from a type **parameter's own name**, where the parameter stands for
// itself. What a bound licenses under the type's name is an associated function, so the parentheses
// are what is missing -- except for a **static property**, which belongs to the type and is the one
// associated member a read resolves rather than being told to add them to.
//
// Everything else is left to the call form, whose complaints each say the right thing about a read
// as well: a property is read on a value, a method is called on one, and a name no bound licenses is
// told which bound would license it.
bound_type_member(cx: &Analyzer, span: Span, subject: Type, bounds: Buf[Bound], written: string,
                  name: string) -> TExpr
    val found = bound_member(cx.an, subject, bounds, name)

    if found.is_some() && !found.unwrap().2.is_static && found.unwrap().2.recv_mode().is_none() then
        return kept_error(cx, span, s"'$name' is an associated function of " +
                          s"'${found.unwrap().0.show()}' — call it with '$written.$name()'")

    call_bound_associated(cx, span, subject, name, bounds, buf())
end bound_type_member

private unlicensed_associated(cx: &Analyzer, span: Span, subject: Type, name: string) -> TExpr
    val named = declaring_traits(cx, name, false, true)

    if named.is_empty() then
        return kept_error(cx, span, s"'${type_show(subject)}' is a type parameter, and no trait " +
                          s"declares an associated function '$name' that a bound could promise")

    if named.len() == 1 then
        return kept_error(cx, span, s"'$name' needs '${type_show(subject)}: ${named.at(0)}'")

    kept_error(cx, span, s"'$name' needs a bound on '${type_show(subject)}' — it is declared by " +
               quoted_list(named))
end unlicensed_associated

// `x.p` where `x` is a type parameter and `p` is a property one of its bounds declares -- the read a
// bound method call is to a call, checked the same way and for the same reason.
//
// A **field** would be refused here whatever the bounds said, because a field is layout and no
// promise about behaviour reaches one. A property is the opposite case: it is behaviour that happens
// to be spelled like a field, so a trait can promise it.
read_bound_property(cx: &Analyzer, span: Span, receiver: TExpr, subject: Type, name: string,
                    bounds: Buf[Bound]) -> TExpr
    val found = bound_member(cx.an, subject, bounds, name)

    if found.is_none() then return unlicensed_property(cx, span, subject, name)

    val tr = found.unwrap().0
    val subst = found.unwrap().1
    val m = found.unwrap().2

    if !m.is_property then
        cx.an.bound_fault(cx.scope, span, s"'$name' is a method of '${tr.show()}' — call it with " +
                          s"'$name(…)'")

    val scope = trait_scope_of(cx.an, tr.name)
    val ret =
        if m.ret_type.is_some() then declared_result_type(Some(resolve_result(cx.an, scope, m.ret_type.unwrap(), subst)))
        else Unit

    var ts: Buf[TExpr] = buf()

    ts.push(receiver)
    cx.an.uses(s"${tr.name}.$name")
    TExpr(span, TCall(s"${tr.name}.$name", ts, ret, false))
end read_bound_property

// -- what to say when no bound licenses the name -----------------------------------------------------

// The traits a file can name that declare a member of this name, which is what the fix is written
// out of: with one, the bound to add; with several, the choice the reader has to make.
private declaring_traits(cx: &Analyzer, name: string, want_property: bool,
                         want_associated: bool) -> Buf[string]
    var out: Buf[string] = buf()

    for i in 0..<cx.an.tables.types.len()
        val key = cx.an.tables.types.key_at(i)
        val d = trait_decl_at(cx.an, key)

        if d.is_some() && reachable_key(cx.an, key, cx.scope)
            val m = trait_method(d.unwrap(), name)

            if m.is_some()
                var fits = true

                if want_property then fits = m.unwrap().is_property
                else if want_associated then fits = m.unwrap().recv_mode().is_none()

                if fits then out.push(module_show(key))

    out
end declaring_traits

private unlicensed(cx: &Analyzer, span: Span, subject: Type, name: string) -> TExpr
    val named = declaring_traits(cx, name, false, false)

    if named.is_empty() then
        return kept_error(cx, span, s"no trait declares a method '$name', so no bound on " +
                          s"'${type_show(subject)}' could license this call")

    if named.len() == 1 then
        return kept_error(cx, span, s"'$name' needs '${type_show(subject)}: ${named.at(0)}'")

    kept_error(cx, span, s"'$name' needs a bound on '${type_show(subject)}' — it is declared by " +
               quoted_list(named))
end unlicensed

private unlicensed_property(cx: &Analyzer, span: Span, subject: Type, name: string) -> TExpr
    val named = declaring_traits(cx, name, true, false)

    if named.is_empty() then
        return kept_error(cx, span, s"'${type_show(subject)}' is a type parameter, so it has no " +
                          "fields to read — a field is layout, and no trait declares a property " +
                          s"'$name' that a bound could promise instead")

    if named.len() == 1 then
        return kept_error(cx, span, s"'$name' needs '${type_show(subject)}: ${named.at(0)}'")

    kept_error(cx, span, s"'$name' needs a bound on '${type_show(subject)}' — it is declared by " +
               quoted_list(named))
end unlicensed_property

// A complaint the walk keeps, and the node a caller carries on with.
private kept_error(cx: &Analyzer, span: Span, message: string) -> TExpr
    cx.an.bound_fault(cx.scope, span, message)
    bad_expr(span)
end kept_error

private quoted_list(names: Buf[string]) -> string
    var b = str_builder()

    for i in 0..<names.len()
        if i > 0 then b.push(", ")

        b.push(s"'${names.at(i)}'")

    b.finish()
end quoted_list
