module sh.sysl.compiler
@tests

import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture

// The variable of a `for` over a range whose bounds are both bare integer literals takes its type
// from its first use that fixes one, as a literal binding does (`var_first_use.sysl`,
// `reference/declarations.md § A literal binding takes its type from its first use`), and the bounds
// are read at that type: one that does not fit is told at the bound. Only an integer type fixes it;
// with no fixing use it is `int`, as before. `for all` and `for some` read their ranges the same way.
// A range held in a binding, or one with a bound of a type of its own, keeps the type it already has.
//
// Each variable's type is shown by `val z: bool = <name>`, which fixes nothing (a `bool` is no number)
// and is told the type the name has.

private fvf_ready() -> bool
    if std_root().is_err()
        print("skipped: the standard module's source is not on this machine")
        return false

    if !clang_available()
        print("skipped: there is no clang on this machine")
        return false

    true
end fvf_ready

// The functions every program here calls: a use at each of two integer widths and at a float.
private fvf_fns() -> string = raw"""
    wide(n: u64) -> u64 = n
    narrow(n: u8) -> u8 = n
    half(x: f64) -> f64 = x / 2.0
    signed(n: i8) -> i8 = n

    """

// What a program prints, built and run.
private fvf_ran(text: string) -> string
    val root = make_temp_dir("sysl-fvf").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", text).unwrap()

    val exe = s"$root/built"

    build_native_program(s"$root/main.sysl", None, None, DefaultOptimization, Some(exe)) match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return failure_text(why)
        Ok(_) -> ()

    val said = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    said match
        Err(_) -> "the program that was built could not be run"
        Ok(out) -> out.text
end fvf_ran

// Everything a source has to say for itself.
private fvf_err(text: string) -> string
    val root = make_temp_dir("sysl-fvf").unwrap()
    val src = s"$root/main.sysl"

    make_dir_all(root).unwrap()
    write_text(src, text).unwrap()

    val out = emit_llvm_text(src, None) match
        Err(why) -> why.message
        Ok(made) -> if made.report.is_empty() then "" else analysis_report(made.report)

    remove_dir_all(root).unwrap_or(())
    out
end fvf_err

// Whether a report carries a diagnostic, pointed at a line and column of `main.sysl`.
private fvf_says(report: string, message: string, at: string) -> bool =
    report.contains(s"error: $message") && report.contains(s"main.sysl:$at\n")

// Whether a report says the binding `z<name>` was handed is of a type.
private fvf_is(report: string, name: string, ty: string) -> bool =
    report.contains(s"error: cannot initialize 'z$name': declared bool but the value is $ty\n")

// How many diagnostics a report carries.
private fvf_count(report: string) -> usize
    var seen: usize = 0
    var rest = report

    loop
        rest.index_of("error: ") match
            None -> break
            Some(at) ->
                seen += 1
                rest = rest[(at + 7)..<rest.bytes.len]

    seen
end fvf_count

@test("an argument fixes a literal range's variable at the parameter's type, at either width")
fvf_argument_fixes()
    if !fvf_ready() then return

    assert_eq(fvf_ran(fvf_fns() + raw"""
        main()
            for seed in 1..3
                print(wide(seed) * 2)
            for b in 0..<3
                print(narrow(b))
        """), "2\n4\n6\n0\n1\n2\n")

    val report = fvf_err(fvf_fns() + raw"""
        main()
            for a in 1..3
                print(wide(a))
                val za: bool = a
            for b in 0..<3
                val zb: bool = b
                print(narrow(b))
            for c in -3..3
                print(signed(c))
                val zc: bool = c
        """)

    assert(fvf_is(report, "a", "ulong"), report)
    assert(fvf_is(report, "b", "byte"), report)
    assert(fvf_is(report, "c", "i8"), report)
    assert_eq(fvf_count(report), 3)

@test("a use through arithmetic or a comparison fixes the variable as it fixes a literal binding")
fvf_arithmetic_and_comparison_fix()
    if !fvf_ready() then return

    val report = fvf_err(fvf_fns() + raw"""
        main()
            val xs = [10, 20, 30]
            val b: u8 = 2
            for i in 0..<3
                print(wide(i + 1))
                val zi: bool = i
            for j in 0..<3
                print(j < xs.len)
                val zj: bool = j
            for k in 0..<3
                print(k == b)
                val zk: bool = k
        """)

    assert(fvf_is(report, "i", "ulong"), report)
    assert(fvf_is(report, "j", "usize"), report)
    assert(fvf_is(report, "k", "byte"), report)
    assert_eq(fvf_count(report), 3)

@test("with no use that fixes it, or only an index or a float, the variable stays int")
fvf_no_fixing_use_stays_int()
    if !fvf_ready() then return

    assert_eq(fvf_ran(fvf_fns() + raw"""
        main()
            val xs = [10, 20, 30]
            for a in 0..<3
                print(xs[a], half(a))
        """), "10 0\n20 0.5\n30 1\n")

    val report = fvf_err(fvf_fns() + raw"""
        main()
            val xs = [10, 20, 30]
            for a in 0..<3
                print(xs[a])
                val za: bool = a
            for b in 0..<3
                print(half(b))
                val zb: bool = b
            for c in 0..<3
                print(c)
                val zc: bool = c
        """)

    assert(fvf_is(report, "a", "int"), report)
    assert(fvf_is(report, "b", "int"), report)
    assert(fvf_is(report, "c", "int"), report)
    assert_eq(fvf_count(report), 3)

@test("a bound that does not fit the type a use fixed is told at the bound, the top inclusive bound included")
fvf_bound_does_not_fit()
    if !fvf_ready() then return

    assert_eq(fvf_ran(fvf_fns() + raw"""
        main()
            var last = 0
            for i in 250..255
                last = narrow(i)
            print(last)
        """), "255\n")

    val report = fvf_err(fvf_fns() + raw"""
        main()
            for i in 0..256
                print(narrow(i))
        """)

    assert(fvf_says(report, "the literal 256 does not fit byte", "7:17"), report)
    assert_eq(fvf_count(report), 1)

    // An exclusive top bound is still a value of the range's type, so 256 is refused there too.
    val exclusive = fvf_err(fvf_fns() + raw"""
        main()
            for i in 0..<256
                print(narrow(i))
        """)

    assert(fvf_says(exclusive, "the literal 256 does not fit byte", "7:18"), exclusive)
    assert_eq(fvf_count(exclusive), 1)

    val negative = fvf_err(fvf_fns() + raw"""
        main()
            for i in -3..3
                print(narrow(i))
        """)

    assert(fvf_says(negative, "the literal -3 does not fit byte", "7:14"), negative)
    assert_eq(fvf_count(negative), 1)

@test("the first fixing use wins, and a second that disagrees is told as a written type would be")
fvf_second_use_disagrees()
    if !fvf_ready() then return

    val report = fvf_err(fvf_fns() + raw"""
        main()
            for j in 0..<3
                print(wide(j))
                print(narrow(j))
        """)

    assert(fvf_says(report, "'n' of 'narrow' is byte, but ulong was given", "9:22"), report)
    assert_eq(fvf_count(report), 1)

    val written = fvf_err(fvf_fns() + raw"""
        main()
            for j in 0u64..<3
                print(wide(j))
                print(narrow(j))
        """)

    assert(fvf_says(written, "'n' of 'narrow' is byte, but ulong was given", "9:22"), written)
    assert_eq(fvf_count(written), 1)

@test("a body read twice reports its own errors once")
fvf_body_errors_once()
    if !fvf_ready() then return

    val report = fvf_err(fvf_fns() + raw"""
        main()
            for i in 0..<3
                val q: bool = 1
                print(narrow(i))
        """)

    assert(fvf_says(report, "cannot initialize 'q': declared bool but the value is int", "8:9"),
           report)
    assert_eq(fvf_count(report), 1)

@test("a range in a binding, a typed bound, or a bound of a type of its own keeps the type it has")
fvf_not_a_literal_range()
    if !fvf_ready() then return

    val report = fvf_err(fvf_fns() + raw"""
        main()
            val r = 0..<3
            for a in r
                print(narrow(a))
            for b in 0u16..<3
                print(narrow(b))
        """)

    assert(fvf_says(report, "'n' of 'narrow' is byte, but int was given", "9:22"), report)
    assert(fvf_says(report, "'n' of 'narrow' is byte, but ushort was given", "11:22"), report)
    assert_eq(fvf_count(report), 2)

    val bounded = fvf_err(fvf_fns() + raw"""
        main()
            val n: u8 = 3
            for c in 0..<n
                print(wide(c))
                val zc: bool = c
        """)

    assert(fvf_is(bounded, "c", "byte"), bounded)

@test("a closure's use, a nested function's use, and a binding assigned from the variable are fixed by it")
fvf_closure_nested_and_assigned()
    if !fvf_ready() then return

    assert_eq(fvf_ran(fvf_fns() + raw"""
        main()
            for i in 0..<2
                val f = () -> narrow(i)
                print(f())
            for j in 0..<2
                twice() -> u64 = wide(j) * 2
                print(twice())
            var seen = 0
            for k in 1..3
                seen = k
                print(narrow(k))
            print(seen)
        """), "0\n1\n0\n2\n1\n2\n3\n3\n")

    val report = fvf_err(fvf_fns() + raw"""
        main()
            for i in 0..<2
                val f = () -> wide(i)
                print(narrow(i))
            var seen = 0
            for k in 1..3
                seen = k
                print(narrow(k))
            val zseen: bool = seen
        """)

    assert(fvf_says(report, "'n' of 'narrow' is byte, but ulong was given", "9:22"), report)
    assert(fvf_is(report, "seen", "byte"), report)
    assert_eq(fvf_count(report), 2)

@test("nested loops are fixed each on its own, through a labeled continue and a loop's break value")
fvf_nested_labels_and_break()
    if !fvf_ready() then return

    assert_eq(fvf_ran(fvf_fns() + raw"""
        main()
            'outer for i in 0..<3
                for j in 0..<3
                    if wide(j) == 1 then continue 'outer
                    print(narrow(i), j)
            val none: u8 = 99
            val found = for k in 0..<10
                if narrow(k) == 7 then break k
            else none
            print(found)
        """), "0 0\n1 0\n2 0\n7\n")

    val report = fvf_err(fvf_fns() + raw"""
        main()
            for i in 0..<3
                for j in 0..<3
                    print(wide(i), narrow(j))
                    val zj: bool = j
                val zi: bool = i
        """)

    assert(fvf_is(report, "i", "ulong"), report)
    assert(fvf_is(report, "j", "byte"), report)
    assert_eq(fvf_count(report), 2)

@test("'for all' and 'for some' fix their variable by its use, and tell a bound that does not fit")
fvf_quantifiers()
    if !fvf_ready() then return

    assert_eq(fvf_ran(fvf_fns() + raw"""
        main()
            print(for all k in 0..<4 do wide(k) < 10)
            print(for some k in 250..255 do narrow(k) == 255)
            print(for all k in 0..<3 do k < 3)
        """), "true\ntrue\ntrue\n")

    val report = fvf_err(fvf_fns() + raw"""
        main()
            print(for all k in 0..256 do narrow(k) == 1)
            print(for some k in -1..<3 do narrow(k) == 1)
        """)

    assert(fvf_says(report, "the literal 256 does not fit byte", "7:27"), report)
    assert(fvf_says(report, "the literal -1 does not fit byte", "8:25"), report)
    assert_eq(fvf_count(report), 2)

    val disagree = fvf_err(fvf_fns() + raw"""
        main()
            print(for all k in 0..<3 do wide(k) == narrow(k))
        """)

    assert(fvf_says(disagree, "'n' of 'narrow' is byte, but ulong was given", "7:51"), disagree)
    assert_eq(fvf_count(disagree), 1)

@test("a generic body and the entry file's statements fix a literal range's variable")
fvf_generic_and_entry()
    if !fvf_ready() then return

    assert_eq(fvf_ran(fvf_fns() + raw"""
        sum[T](x: T) -> u64
            var total: u64 = 0
            for i in 1..3
                total += wide(i)
            total

        print(sum(1), sum("a"))
        for i in 0..<2
            print(narrow(i))
        """), "6 6\n0\n1\n")

@test("a literal range's variable at a narrow type wraps where int would not have")
fvf_narrow_type_wraps()
    if !fvf_ready() then return

    // The behaviour change: the variable is a u8 now, so `i + 10` wraps past 255.
    assert_eq(fvf_ran(raw"""
        main()
            val limit: u8 = 252
            for i in 250..<255
                if i == limit then print("at the limit")
                print(i + 10)
        """), "4\n5\nat the limit\n6\n7\n8\n")
