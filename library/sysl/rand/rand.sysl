module sysl.rand

import sysl.slices.swap

// Pseudo-random numbers: a named, seedable, reproducible generator, and the distributions that are
// easy to get wrong.
//
// **This is NOT a source of unpredictability, and nothing here should be used as one.** The generator
// is fast, small and completely determined by its seed -- which is exactly what a test that must
// reproduce, a simulation that must replay and a shuffle all want, and exactly what a key, a token, a
// nonce or a password reset must not have. Anyone who can see a handful of outputs can compute the
// state and every output that follows. A cryptographic generator is a different thing with a
// different implementation, and it is not in this module under any name.
//
// **The algorithm is named so it can be checked.** A generator nobody can identify is one nobody can
// verify against published output, so this is PCG32 -- specifically PCG-XSH-RR with a 64-bit state
// and 32-bit output, M. E. O'Neill, *PCG: A Family of Simple Fast Space-Efficient Statistically Good
// Algorithms for Random Number Generation*, 2014 -- and `tests.sysl` pins it against the reference
// implementation's own first outputs. It was chosen over xoshiro because its state is two words, its
// multiplier and increment are published constants a reader can check against the paper, and it has a
// canonical reference implementation to take a vector from.
//
// **Seeding is the caller's, and that is what keeps this module portable.** Nothing here reads a
// clock or asks the operating system for anything, so it compiles and runs on a freestanding target.
// Taking a seed from the host is `sysl.posix.rand`, a module of its own, so that importing the
// generator cannot drag an operating system in behind it.

/** The multiplier from the reference implementation. Not a number to adjust: the generator's
 * statistical properties are a property of this constant with this state size.
 */
private const MULTIPLIER: u64 = 6364136223846793005

/** A generator: sixty-four bits of state, and the odd increment that selects one of 2^63 distinct
 * streams.
 *
 * A copy of an `Rng` is an independent generator continuing from the same point, which is a useful
 * thing rather than an accident -- it is how a simulation replays a branch from a saved position.
 */
struct Rng
    state: u64
    inc: u64

    /** The next 32 bits.
     *
     * The state advances by an ordinary linear congruential step, and the *output* is a permutation
     * of the state's high bits rather than the state itself: an xorshift folds the high bits down,
     * and the result is then rotated by an amount taken from bits the xorshift did not use. That
     * second step is what a bare congruential generator lacks and is why its low bits are notoriously
     * poor -- here every bit of the output is the product of the whole state.
     */
    next_u32(*self) -> u32
        val old = self.state

        self.state = old * MULTIPLIER + self.inc

        val xorshifted = u32((old >> 18 ^ old) >> 27)
        val rot = u32(old >> 59)

        // The rotation amount is masked to the width, so a rotation of zero shifts by zero rather
        // than by 32, which is undefined.
        xorshifted >> rot | xorshifted << (0 - rot & 31)
    end next_u32

    /** Sixty-four bits, as two draws with the first taken as the high half. Written down because the
     * order matters to reproducibility: the other order gives a different, equally valid sequence,
     * and a caller comparing two runs needs to know which this is.
     */
    next_u64(*self) -> u64 = u64(self.next_u32()) << 32 | u64(self.next_u32())

    /** One bit, taken from the **top** of a draw rather than the bottom. Either is sound here, since
     * the permutation above makes every bit good, but the high bit is the one that stays good if the
     * generator is ever changed.
     */
    boolean(*self) -> bool = self.next_u32() >> 31 == 1

    /** A uniform value in `[0, n)`, with **no modulo bias**.
     *
     * **This is the function the module exists for.** The obvious `next_u64() % n` is not uniform
     * whenever `n` does not divide 2^64: the low residues come up more often, by a margin that is
     * invisible in a handful of draws and is a real defect in a simulation or a shuffle.
     *
     * The fix is to reject the unfair part of the range. `threshold` is `2^64 mod n`, computed as
     * `(0 - n) % n` because unsigned arithmetic wraps (`01`) and `0 - n` is exactly `2^64 - n`.
     * Draws below it are discarded, leaving a span that `n` divides evenly. It terminates with
     * probability one and takes under two draws on average -- and for the overwhelmingly common case
     * of a small `n` the threshold is tiny and the first draw is nearly always taken.
     *
     * `below(0)` has no value to answer and gives `0`, which is the one input a caller should not
     * write.
     */
    below(*self, n: u64) -> u64
        if n == 0 then return 0

        val threshold = (0 - n) % n
        var r = self.next_u64()

        while r < threshold
            r = self.next_u64()

        r % n
    end below

    /** A uniform value in `[lo, hi)`, empty when `hi` is not above `lo`. */
    range(*self, lo: i64, hi: i64) -> i64 =
        if hi <= lo then lo else lo + i64(self.below(u64(hi - lo)))

    /** A uniform value in `[0, 1)`, from **53** bits.
     *
     * Fifty-three because that is the width of a `real`'s mantissa: fewer would leave representable
     * values that can never come back, and more would be bits thrown away by the division. Half-open
     * at the top, so `1.0` never appears -- which is the property every caller scaling by a range
     * depends on, and the one an implementation dividing by `2^53 - 1` quietly breaks.
     */
    unit(*self) -> real = real(self.next_u64() >> 11) / 9007199254740992.0

    /** The elements rearranged, every permutation equally likely.
     *
     * **Fisher-Yates, walking down**: each position from the end takes a uniformly chosen element
     * from those at or below it. The whole difficulty is drawing that index without bias, which is
     * `below`'s job -- the loop itself is three lines.
     *
     * It lives here rather than in `sysl.slices` because it is a fact about a *generator*, and
     * because `sysl.slices` is the module a C binding reaches into for `as_ptr`: acquiring a
     * random-number generator by asking for a slice operation would be a poor trade.
     */
    shuffle[T](*self, xs: []T)
        if xs.len < 2 then return

        var i = xs.len

        while i > 1
            i -= 1

            val j = usize(self.below(u64(i) + 1))

            swap(xs, i, j)
    end shuffle
end Rng

/** A generator from a seed and a stream selector.
 *
 * **Two arguments, because the stream is not the seed.** Two generators with the same seed and
 * different `seq` produce different, equally good sequences -- which is what a program wanting
 * several independent streams from one seed needs, and what seeding several generators from
 * consecutive seeds does *not* reliably give.
 *
 * The initialization is the reference implementation's: the increment is made odd, the state is
 * advanced once, the seed is added, and the state is advanced again. The two steps are what stop a
 * seed of zero from being a special case.
 */
rng(seed: u64, seq: u64) -> Rng
    var g = Rng(0, seq << 1 | 1)

    g.next_u32()
    g.state = g.state + seed
    g.next_u32()

    g
