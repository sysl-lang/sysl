module sysl

// The core trait catalog (`14 §2`).
//
// These are ordinary trait declarations. A program can read them, and can call their methods by
// name -- `5.add(3)` is exactly `5 + 3` -- because what makes them an *operator* catalog is not
// anything written here. The compiler adds the identity: which operator token means which trait,
// and which built-in types are members. That part cannot be written in sysl at all, because the
// open `iN` / `uN` families have no finite list of scalars an `impl` could be written for.
//
// **Each trait requires exactly one method**, and that is the point. Implementing a comparison
// means writing `lt` and nothing else, so there is no way for four functions to disagree with each
// other: `a > b` is `lt(b, a)`, `a <= b` is `!lt(b, a)`, and the compiler derives the rest.
//
// The ten binary traits take `[Rhs = Self, Out = Self]` so that an implementation may accept an
// operand of another type and yield a third, while the overwhelmingly common case -- a type closed
// under its own operator -- writes neither argument. A use writes neither either: `a * b` fixes the
// operands and asks to be told the result, so the operands select the implementation and the result
// is whatever that one supplies.

trait Add[Rhs = Self, Out = Self]
    add(self, rhs: Rhs) -> Out

trait Sub[Rhs = Self, Out = Self]
    sub(self, rhs: Rhs) -> Out

trait Mul[Rhs = Self, Out = Self]
    mul(self, rhs: Rhs) -> Out

trait Div[Rhs = Self, Out = Self]
    div(self, rhs: Rhs) -> Out

trait Rem[Rhs = Self, Out = Self]
    rem(self, rhs: Rhs) -> Out

trait BitAnd[Rhs = Self, Out = Self]
    bitand(self, rhs: Rhs) -> Out

trait BitOr[Rhs = Self, Out = Self]
    bitor(self, rhs: Rhs) -> Out

trait BitXor[Rhs = Self, Out = Self]
    bitxor(self, rhs: Rhs) -> Out

trait Shl[Rhs = Self, Out = Self]
    shl(self, rhs: Rhs) -> Out

trait Shr[Rhs = Self, Out = Self]
    shr(self, rhs: Rhs) -> Out

trait Neg
    neg(self) -> Self

trait Not
    not(self) -> Self

trait Eq
    eq(self, rhs: Self) -> bool

trait Ord
    lt(self, rhs: Self) -> bool

// A tuple is comparable, hashable and printable exactly when its parts are, which is what these
// rows say: the membership is *structural*, so nothing has to be written per tuple type.
//
// One block each, at every arity, because a tuple's parts are a **type pack** (`10 §10`) and the
// loop that walks them is unrolled -- so `self.i` is an ordinary part selection at whatever type
// that part has, and one written line covers all of them. These were eight blocks over `(A, B)` and
// `(A, B, C)` before the pack existed, and a tuple of four parts implemented none of them.

impl[..A: Eq] Eq for (..A)
    eq(self, rhs: Self) -> bool
        for const i in 0..<A.len
            if self.i != rhs.i then return false

        true

// Lexicographic, and written as a ladder rather than as `<` on each part in turn because deciding a
// position takes *two* comparisons: this one is less, or it is greater, or the two agree and the
// next position decides. Every position runs the same ladder and all-tied ends `false` -- a tuple is
// not less than one it agrees with everywhere. Written per arity this needed a last position that
// ended with a bare `<`, having no next position to fall through to; the loop has no such case.
impl[..A: Ord] Ord for (..A)
    lt(self, rhs: Self) -> bool
        for const i in 0..<A.len
            if self.i < rhs.i then return true
            if rhs.i < self.i then return false

        false
    end lt

// Mixed with the same FNV prime the string hash uses, so that the parts' order matters -- `(1, 2)`
// and `(2, 1)` are different keys, and a plain XOR would make them the same one. The fold starts at
// the FNV offset basis rather than at the first part's hash, which is what lets one loop cover every
// arity rather than treating the first position as the seed.
impl[..A: Hash] Hash for (..A)
    hash(self) -> u64
        var h = 0xcbf29ce484222325u64

        for const i in 0..<A.len
            h = h * 0x100000001b3u64 ^ self.i.hash()

        hash_u64(h)
    end hash

// Rendered as one field, which is why the parts are gathered before anything is padded: `14 §2`'s
// rule is that a specifier describes the field the *whole* value occupies, so `%8s` on a pair pads
// the pair and not its first element.
impl[..A: Display] Display for (..A)
    display(self, out: *Writer, fmt: FormatSpec)
        var s = "("

        for const i in 0..<A.len
            if i > 0 then s = s + ", "

            s = s + str(self.i)

        display_pad((s + ")").bytes, out, fmt)
    end display

// A sink that keeps the length of what it was given and drops the bytes, which is how a slice
// honours a width without gathering: the elements are rendered twice and stored nowhere, rather
// than once into a buffer that has to be allocated. `sysl` cannot reach `sysl.buf` -- that module
// is built on this one -- so a growable buffer is not available here even if one were wanted.
//
// Module-private rather than file-private because measuring this way is what every composite
// renderer here does: `Option` and `Result` honour a width the same way, from their own files.
private[sysl] struct Counting
    n: usize

impl Fallible for Counting

impl Writer for Counting
    write(*self, bytes: []const u8)
        self.n = self.n + bytes.len

// The elements between brackets, written straight through to wherever they are going. Each element
// gets a plain specifier, because `14 §2`'s field is the whole slice and not its parts.
private render_slice[T: Display](xs: []T, out: *Writer)
    out.write("[".bytes)

    for i in 0..<xs.len
        if i > 0 then out.write(", ".bytes)

        xs[i].display(out, FormatSpec(0, -1, false))

    out.write("]".bytes)
end render_slice

impl[T: Display] Display for []T
    display(self, out: *Writer, fmt: FormatSpec)
        var pad = 0

        // Measured only when a width was asked for, so the ordinary print costs one pass.
        if fmt.width > 0
            var count = Counting(0)
            var sink: *Writer = &count

            render_slice(self, sink)
            pad = fmt.width - int(count.n)

            if pad < 0 then pad = 0

        if !fmt.left then display_fill(out, 32, pad)

        render_slice(self, out)

        if fmt.left then display_fill(out, 32, pad)
    end display
end []T

// Every array of a printable element, at every length -- one block, because a length is a value
// parameter (`10 §9`) and so an argument to the shape rather than part of it. Before that, one
// `impl` per length was the only way to write this and no library could write them all.
//
// The whole-array view is the elements a slice would have walked, so the block above renders it and
// this one is a delegation rather than a second copy of the padding.
impl[const N: usize, T: Display] Display for [N]T
    display(self, out: *Writer, fmt: FormatSpec) = self[..].display(out, fmt)

// -- The identities of the two operators above -------------------------------------------------------
//
// **A generic body cannot spell a zero.** `0` and `0.0` are literals of particular types, so a
// routine bounded by `[T: Add]` has an addition and nothing to start an accumulator at, and one
// bounded by `[T: Mul]` has a multiplication and nothing to start a product at. That is the whole of
// what these two say, and `sysl.math.Float` had been making the argument for them since it was
// written: *"a signum needs a one to answer with and a reciprocal needs a one to divide, and neither
// can be written in a body shared by two widths unless there is a way to ask a type for its own
// one."* The reasoning never stopped at floats, so the two members left `Float` and became the
// traits they always were.
//
// **They are here, in the standard module, and that is not a filing decision.** A trait outside it is
// reachable only where a file has named it (`13 §2`), so declaring these in `sysl.math` would mean
// every caller of `real.zero()` gaining an import — including ones that never mention the trait,
// because a member moved out of a type and into a trait is reached through that trait. Beside the
// operators whose identities they are, they cost a reader nothing and a program no import.
//
// **Two traits rather than one**, because a sum wants `Add + Zero` and a product wants `Mul + One`:
// splitting them is what lets a bound ask for exactly what its body uses, where a `Ring` naming both
// would make every accumulator claim a multiplication it never performs.
//
// **Both members have no receiver**: there is no value of `T` to hand a `zero()` before the
// accumulator exists, which is the entire situation. So they are reached through the type —
// `T.zero()` in a generic body, `real.zero()` at a concrete one.
//
// **The integers are compiler-provided, and there is no block below for them.** An `impl` can only
// name types that exist and the `iN`/`uN` families are **open** — a program may write `u256` and get
// an integer no library file listed — so integer membership is not something a block can supply
// however long the list is. It is the argument `Signed` and `Bits` are compiler-provided for, and it
// is the same answer: every integer type is a member of both, and `T.zero()` at one lowers to the
// literal rather than to a call. So `[T: Add + Zero]` takes an `int` and a `u256` beside the `real`,
// the `f32` and the `Complex` the blocks below cover.
//
// **A constrained subtype is deliberately not a member**, which is the one place this parts company
// with `Signed` and `Bits`. Those promise an operation, and `16 §3` gives a subtype its base's
// operations; these promise a **value**, and a range written to exclude zero does not have one.
//
// **What it cost to get, since the next member of this shape will want to know**: a provided
// membership used to have to be a method with a **receiver**, lowered from the value it was called
// on, and a `zero()` has no value to lower from. A receiverless one is reached through the type
// instead, and what it lowers to is stated in the compiler rather than read off anything.

// The value `x + zero() == x` holds for.
trait Zero
    zero() -> Self

// The value `x * one() == x` holds for.
trait One
    one() -> Self

impl Zero for real
    zero() -> real = 0.0

impl One for real
    one() -> real = 1.0

impl Zero for f32
    zero() -> f32 = 0.0f32

impl One for f32
    one() -> f32 = 1.0f32
