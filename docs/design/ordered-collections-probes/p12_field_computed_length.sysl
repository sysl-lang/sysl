// A node with B keys has B + 1 children. generics.md § "What may be written with N" says a FIELD may
// compute a struct's value argument (`Buf[N + 1]`); is the same computation allowed as the field's
// own array length? Two spellings of one thing, side by side.

struct Arr[T, const N: usize]
    a: [N]T

struct ViaStruct[const B: usize]
    kids: Arr[int, B + 1]

val s: ViaStruct[3] = ViaStruct(Arr([0; 4]))

print(s.kids.a.len)
