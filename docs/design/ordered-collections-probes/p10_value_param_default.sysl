// Fan-out as a value parameter with a default: `OrderedMap[K, V]` means `OrderedMap[K, V, 6]`, and a
// caller may still write `OrderedMap[K, V, 16]`.

struct Tree[K: Ord, V, const B: usize = 6]
    len: usize

    fanout(self) -> usize = B

val a: Tree[int, string] = Tree(0)
val b: Tree[int, string, 16] = Tree(0)

print(a.fanout(), b.fanout())
