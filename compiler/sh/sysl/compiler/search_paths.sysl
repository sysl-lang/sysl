module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.text.Search

// Where on **this** machine a build is to look for what it was not given (`reference/packages.md §
// Capabilities`, `reference/ffi.md § @link`).
//
// A package says *which* library it binds and never where the library is: the file is committed and
// describes the package, and where a prefix lives on somebody's laptop is not a property of it. So
// the two halves are asked for on the command line -- `--include-path <dir>` for a header the C
// beside a module includes, `--link-path <dir>` for the archive a `@link` directive names, and
// `-D <macro>` for the definitions the C project a shim joins is configured with.
//
// **Both halves, because half is unusable.** A binding to a library outside the default prefix needs
// its headers to compile and its archive to link, and neither is reachable without a flag. Nothing
// is guessed at either: `/opt/homebrew/lib` is the obvious candidate to add by default and is not
// added, because a compiler that ruled on where a platform keeps its libraries would be wrong about
// a machine nobody here has, and the cost of being wrong is a link that fails somewhere the author
// cannot reach.
//
// ## Why this is module storage rather than a value carried down
//
// Every other decision a compilation makes is a value it carries, and this one is not, because of
// **where it has to arrive**: a `c const` block is measured by clang from inside the analysis, which
// holds no project and no command line. The reference threads a record through every call that can
// reach a toolchain; the same threading here would put a parameter on some forty signatures and
// then depend on nobody forgetting it at a call. What is stored is written **once**, by the command
// that parsed the flags, before a line of source is read -- so nothing observes it changing, which
// is the property that makes a global answerable at all.

// Every directory a bare `--include-path` named, in the order they were written.
private var sp_include: Buf[string] = buf()

// Every directory a `--link-path` named.
private var sp_link: Buf[string] = buf()

// Every macro a `-D`/`--define` named, as written -- `NAME` or `NAME=value`.
private var sp_defines: Buf[string] = buf()

// The names a `--include-path <name>=<dir>` answered, paired with the directory. A name satisfies a
// package's declared `headers` requirement or stands in for a `pkg_config` probe; the directory also
// reaches the C compiler exactly as a bare one does, which is why both lists carry it.
private var sp_named: Buf[(string, string)] = buf()

// What a run that was given no flags looks for, which is what every command starts from.
//
// **Called by the CLI before each command's flags are read**, so that one process running two
// commands -- a test does exactly this -- never inherits the first's paths.
reset_search_paths()
    sp_include = buf()
    sp_link = buf()
    sp_defines = buf()
    sp_named = buf()
    sp_libs = buf()
    sp_std_from_source = false
    sp_verbose = false
    sp_explain = false
    sp_cc = None
    sp_say = None
    sp_link_mode = None
    sp_no_bounds_locations = false
    sp_general_regs_only = false
    sp_strict_align = false
    forget_link_notes()
    reset_pipeline()
end reset_search_paths

// Whether `--no-bounds-locations` was given: a failed bounds check names no `file:line:column`. It
// beats the root manifest's `bounds_locations` key.
private var sp_no_bounds_locations: bool = false

no_bounds_locations_flag() -> bool = sp_no_bounds_locations

// Whether `--general-regs-only` and `--strict-align` were given. Each turns its setting on whatever
// the root manifest's `codegen` block says (`codegen_features.sysl`); there is no flag to turn one off.
private var sp_general_regs_only: bool = false
private var sp_strict_align: bool = false

general_regs_only_flag() -> bool = sp_general_regs_only

strict_align_flag() -> bool = sp_strict_align

// What `--link` typed, where it was given: which of the build's `pkg_config` libraries come from
// their archives. It beats the root manifest's `link` key (`chosen_link`).
private var sp_link_mode: Option[LinkMode] = None

link_flag() -> Option[LinkMode] = sp_link_mode

// The refusal for a `--link` whose operand names an empty library, said before any command reads its
// own flags -- every command takes the flag, so every command refuses it the same way. Arguments
// after a `--` are the program's and are not looked at.
link_flag_refusal(args: []string) -> Option[string]
    for i in 0..<args.len
        if args[i] == "--" then return None

        if args[i] == "--link" && i + 1 < args.len
            parse_link_mode(args[i + 1]) match
                Err(why) -> return Some(why)
                Ok(_) -> ()
        end if

    None
end link_flag_refusal

// The names a `--include-path <name>=<dir>` answered.
supplied_names() -> Buf[string]
    var out: Buf[string] = buf()

    for item in sp_named
        out.push(item.0)

    out
end supplied_names

// Every `--link-path` directory, in the order written.
link_paths() -> Buf[string]
    var out: Buf[string] = buf()

    for item in sp_link
        out.push(item)

    out
end link_paths

// Whether `--explain-escapes` was given: the build says, one line per array, which local arrays it
// moved to the heap and the view that forced it -- or that there were none.
private var sp_explain: bool = false

// Where those lines go. The command line's own output channel is handed over by `run_cli`, so the
// lines arrive in the order they were found, ahead of anything the command says when it finishes.
private var sp_say: Option[&Fn(string) -> unit] = None

explaining() -> bool = sp_explain

// One line a command says beside its output rather than in it -- a manifest key this compiler does
// not understand, say. It goes where `--explain-escapes` reports, which `main` points at standard
// error, and to standard error where no command line set a channel.
say_note(line: string)
    sp_say match
        Some(say) -> say(line)
        None -> eprints(s"$line\n")

// Hands the command's output channel to the report `--explain-escapes` asks for.
set_explain_sink(say: &Fn(string) -> unit)
    sp_say = Some(say)

// Takes the channel back once the command line that handed it over has been answered, so a later
// build in the same process neither reports nor calls a closure its caller has let go.
close_explain_sink()
    sp_explain = false
    sp_say = None

// Says each line of the report, where one was asked for. Nothing otherwise.
explain_escapes(lines: Buf[string])
    if !sp_explain then return

    sp_say match
        None -> ()
        Some(say) ->
            if lines.is_empty() then say("no arrays were promoted to the heap")

            for item in lines
                say(item)
end explain_escapes

// Every source root a `--lib` named, as it was written and in the order it was written.
//
// **A root is more modules for the compilation in front of the compiler** (`reference/modules.md §
// Source roots`): its files join under the names they wrote, with no prefix of their own, and the C
// beside them is compiled with the program's. It is here with the search paths because it is the
// same kind of fact -- where something is on this machine, which no committed file can say -- and
// because it has to reach the same places: the compilation, the C walk and the run cache's key.
private var sp_libs: Buf[string] = buf()

// One `--lib`, as written. A refusal about it names it this way, so nothing is normalized here.
add_lib_root(dir: string) = sp_libs.push(dir)

// The source roots this command was handed, in the order they were written.
lib_roots() -> Buf[string]
    var out: Buf[string] = buf()

    for sp_lib in sp_libs
        out.push(sp_lib)

    out
end lib_roots

// Whether `--verbose` (`-v`) was given: a build says on standard error the whole command line it
// handed the linker, which is the one place the level it was built at is written down.
private var sp_verbose: bool = false

verbose() -> bool = sp_verbose

// One line of what `--verbose` reports, said beside the command's output under the reference's
// `sysl: ` lead -- on standard error from the terminal, and on the note channel a test hands over.
// Nothing without the flag.
trace(line: string)
    if sp_verbose then say_note(s"sysl: $line")

// What `--verbose` says about where a build looks and what it allocates through: every `--lib`, link
// path, include path and macro as written, then the heap -- said even when it is libc's, since "which
// allocator is this program using" has an answer whatever the answer is.
trace_search_paths()
    for sp_lib in sp_libs
        trace(s"library: ${sp_lib}")

    for item in sp_link
        trace(s"link path: ${item}")

    for item in sp_include
        trace(s"include path: ${item}")

    for sp_define in sp_defines
        trace(s"define: ${sp_define}")

    val who = allocator_named_by() match
        Some(name) -> s" (named by $name)"
        None -> " (the C default)"

    trace(s"allocator: ${malloc_symbol()} / ${free_symbol()}$who")
end trace_search_paths

// The clang a `--cc` named, read once per command line wherever it was written.
//
// **Held here because one build reaches clang by roads no argument list travels** -- the standard
// module rebuilt underneath it, a library's own C -- and a flag honoured by the program's link and
// dropped by those would change compiler halfway through one build.
private var sp_cc: Option[string] = None

name_cc(cc: Option[string])
    sp_cc = cc

named_cc() -> Option[string] = sp_cc

// The operand of the last `--cc` in a command line, up to a `--`, past which the arguments are a
// program's.
named_cc_of(args: []string) -> Option[string]
    var found: Option[string] = None

    for i in 1..<args.len
        if args[i] == "--" then return found

        if args[i] == "--cc" && i + 1 < args.len then found = Some(args[i + 1])

    found
end named_cc_of

// Whether `--no-std-lib` was given: the standard module is compiled from its source into this build
// rather than linked from a prebuilt artifact, and whatever artifact is on disk is not looked for.
private var sp_std_from_source: bool = false

std_from_source() -> bool = sp_std_from_source

// What is said of `--std-lib`, whatever it names and whichever command it was given to.
//
// **It named a `.syslib`, and a `.syslib` is this compiler's cache, which nobody names** -- the same
// reason `--lib` takes a directory. What it was for, compiling against a standard module other than
// the one beside the compiler, is said by naming that module's SOURCE: `SYSL_LIB` points at a library
// root, and the cache keeps what was compiled from it under that root's fingerprint.
std_lib_refusal() -> string =
    "--std-lib names a '.syslib', and a '.syslib' is this compiler's cache, which nobody names — " +
    "to compile against another standard module, set SYSL_LIB to the root its source is in"

// Whether a command line carries `--std-lib` among the compiler's own arguments: everything before a
// `--`, which is where a program's own arguments begin. Asked before any command reads its flags, so
// no command can take it and every command refuses it in the same words.
names_std_lib(args: []string) -> bool
    for i in 0..<args.len
        if args[i] == "--" then return false

        if args[i] == "--std-lib" then return true

    false
end names_std_lib

// `--include-path` written as `<name>=<dir>`, which answers a package's declared header requirement,
// or nothing where it is the ordinary bare directory.
//
// **The two forms share a flag, so the split has to be decidable by looking rather than by
// guessing.** A name is what `pkg_config_name` allows -- letters, digits, `_`, `-`, `.` and `+`,
// starting with a letter -- so a directory read as one would have to hold an `=`, be a single
// segment with no separator before it, and have a non-empty remainder. Where the text before the
// first `=` is not a name the whole string is a directory, which is what an absolute path, a
// relative one and `.` all are.
//
// **The wider of the two requirement kinds, because the flag serves both.** A `headers` name is
// invented by the package's author and a `.pc` name is not -- `yaml-0.1`, `glib-2.0`, `gtk+-3.0` --
// so a flag reading only the narrow spelling would leave those requirements declarable and
// unanswerable.
named_include(text: string) -> Option[(string, string)]
    var at: usize = 0
    var found = false

    for i in 0..<text.bytes.len
        if !found && text.bytes[i] == u8('=')
            at = i
            found = true

    if !found then return None

    val name = text[0..<at]
    val dir = text[at + 1..<text.bytes.len]

    if dir == "" || !pkg_config_name(name) then return None

    Some((name, dir))
end named_include

// One `--include-path`, in whichever of its two forms it was written.
add_include_path(text: string)
    named_include(text) match
        None -> sp_include.push(text)
        Some(pair) ->
            sp_include.push(pair.1)
            sp_named.push(pair)
end add_include_path

// One `--link-path`.
add_link_path(dir: string) = sp_link.push(dir)

// One `-D`/`--define`, as written.
add_define(macro: string) = sp_defines.push(macro)

// One argument of a command line, where it is one of the flags saying **where things are on this
// machine**: `--include-path`, `--link-path`, `-D`/`--define` and `--lib`.
//
// Every command that can reach a C compiler takes all three and decides nothing about them, so they
// are read here once rather than in each command's own loop. The answer is how many arguments were
// taken -- `1` for `-DNAME`, `2` for a flag and its operand -- with `0` for a flag whose operand is
// missing, which is the caller's usage error, and `-1` for an argument that is none of them.
took_search_flag(args: []string, i: usize) -> int
    val arg = args[i]

    if arg == "-D" || arg == "--define" || arg == "--include-path" || arg == "--link-path" ||
            arg == "--lib"
        if i + 1 >= args.len then return 0

        if arg == "--include-path" then add_include_path(args[i + 1])
        else if arg == "--link-path" then add_link_path(args[i + 1])
        else if arg == "--lib" then add_lib_root(args[i + 1])
        else add_define(args[i + 1])

        return 2
    end if

    // Where the standard module comes from, which every command reaching a link is asked the same
    // way: its source, compiled into this build, rather than an artifact looked for in the cache.
    if arg == "--no-std-lib"
        sp_std_from_source = true
        return 1
    end if

    if arg == "--no-bounds-locations"
        sp_no_bounds_locations = true
        return 1
    end if

    if arg == "--general-regs-only"
        sp_general_regs_only = true
        return 1
    end if

    if arg == "--strict-align"
        sp_strict_align = true
        return 1
    end if

    // Which libraries come from their archives. A malformed operand was refused before the command
    // ran (`link_flag_refusal`), so one reaching here is the command line's usage error.
    if arg == "--link"
        if i + 1 >= args.len then return 0

        parse_link_mode(args[i + 1]) match
            Ok(mode) -> sp_link_mode = Some(mode)
            Err(_) -> return 0

        return 2
    end if

    if arg == "--verbose" || arg == "-v"
        sp_verbose = true
        return 1
    end if

    if arg == "--explain-escapes"
        sp_explain = true
        return 1
    end if

    // The attached spelling, which is how a `-D` is written by hand and by most build systems.
    if arg.len > 2 && arg.starts_with("-D")
        add_define(arg[2..<arg.len])
        return 1
    end if

    // What the build asks of LLVM beyond the level (`pipeline.sysl`).
    took_pipeline_flag(args, i)
end took_search_flag

// Whether a requirement of this name was answered on the command line -- a `headers` name or a
// `pkg_config` module's, which the one flag serves.
supplied_include(name: string) -> bool
    for item in sp_named
        if item.0 == name then return true

    false
end supplied_include

// The directories a build's own C is compiled with, as clang spells them.
//
// **A header path is what makes a shim compile at all**, and it goes on every command line that
// reads a header as this target: the objects a package carries, and the translation unit a `c const`
// block is measured in.
include_flags() -> Buf[string]
    var out: Buf[string] = buf()

    for item in sp_include
        out.push(s"-I${item}")

    out
end include_flags

// The macros the C is compiled with, as clang spells them -- `-DNAME` or `-DNAME=value`.
//
// **A header path is not enough to compile a header**, which is why this is here beside the
// directories. A C project of any size configures its own headers with macros, and one that has not
// been given them does not miss quietly: pico-sdk's `pico/cyw43_arch.h` answers a build with no
// `CYW43_LWIP` by `#error`ing on the spot. So a shim reachable at its path and compiled without the
// definitions its project builds with is a shim that fails one step *after* the include path was
// fixed.
define_flags() -> Buf[string]
    var out: Buf[string] = buf()

    for sp_define in sp_defines
        out.push(s"-D${sp_define}")

    out
end define_flags

// Everything a command line said about where headers are, which is what a C compile and a probe are
// both handed: the directories, then the macros.
supplied_cflags() -> Buf[string]
    var out = include_flags()
    val macros = define_flags()

    for item in macros
        out.push(item)

    out
end supplied_cflags

// Where the linker is told to look, as clang spells it. These go **before** everything they could
// affect: a search path is where the scan looks rather than an input being scanned, and `-L` is
// order-sensitive on GNU ld, which does not apply one to a `-l` that appeared before it.
link_search_flags() -> Buf[string]
    var out: Buf[string] = buf()

    for item in sp_link
        out.push(s"-L${item}")

    out
end link_search_flags

// A run-time search path for each directory `--link-path` named, so that a shared library found at
// build time is found again when the program runs.
//
// **Not on a freestanding target.** `wasm-ld` and `ld.lld` accept `-rpath` for a bare-metal link
// without complaint, and what they write is a run-time search path for a dynamic loader that does
// not exist on such a machine -- there is nothing to find it, so there is nothing to say.
//
// The directory is made absolute, because a relative one would be resolved against whatever
// directory the program was started in rather than the one it was built in.
rpath_flags(t: Target) -> Buf[string]
    var out: Buf[string] = buf()

    if t.os == Freestanding then return out

    for item in sp_link
        out.push(s"-Wl,-rpath,${absolute_path(item)}")

    out
end rpath_flags
