module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.math.bigint.{BigInt, add, cmp, div_rem, from_int, mul, negate, pow, sub, to_string}

// What an expression comes to while compiling, where it comes to anything.
//
// **Two positions in the language need this and neither of them is an optimization**: an array's
// bound is part of its type, and a vector's lane index is part of the instruction that reads it. So
// a count that does not fold is a mistake to report rather than a value to compute later, which is
// why the answer is an `Option` and not a best effort.

// A value settled while compiling.
enum Const
    ConstInt(value: BigInt)
    ConstBool(value: bool)
    ConstChar(value: char)
    ConstStr(value: string)
end Const

// The integer an expression comes to, where it comes to one.
const_int(cx: &Analyzer, e: Expr) -> Option[BigInt] = const_fold(cx, e) match
    Some(v) -> v match
        ConstInt(n) -> Some(n)
        _ -> None
    None -> None

// What an expression comes to while compiling.
const_fold(cx: &Analyzer, e: Expr) -> Option[Const] = *e.kind match
    IntLit(digits, base, _) -> Some(ConstInt(literal_value(digits, base)))
    BoolLit(v) -> Some(ConstBool(v))
    CharLit(c) -> Some(ConstChar(c))
    StrLit(s) -> Some(ConstStr(s))

    // A **value parameter** is asked before a declared constant, and shadows one of the same name
    // for the same reason a type parameter shadows a type: the nearer binding is the one written
    // where the name is. During the walk that checks a generic body there is no argument bound yet,
    // so the name simply is not in the substitution and falls through -- which a caller reads as
    // awaiting instantiation, exactly as it already does for `sizeof(T)`.
    //
    // A declared constant folds to what it was written equal to, read in its own file's terms.
    Ident(name) ->
        val bound = const_arg_bound(cx.subst, name)

        if bound.is_some() then return bound

        const_of_name(cx, name)

    // `A.len` -- how many types a **pack** stands for, which is a compile-time integer and folds as
    // one. It is here as well as in the analyzer because the range of a `for const` is read *before*
    // anything is analyzed: the loop has to know how many copies to make before it can make one.
    //
    // A module-qualified constant -- `c.limit` -- is the other thing this shape is. A `const` is
    // registered under its dotted path, so the same declaration is a constant whether it was
    // imported unqualified or reached through its module.
    Field(receiver, name) ->
        val packed = pack_length(cx.subst, receiver, name)

        if packed.is_some() then return packed

        dotted_name(receiver, name).and_then(n -> const_of_name(cx, n))

    Unary(op, operand) -> const_unary(cx, op, operand)
    Binary(op, l, r) -> const_binary(cx, op, l, r)
    Compare(operands, ops) ->
        if operands.len() == 2 && ops.len() == 1 then
            const_binary(cx, ops.at(0), operands.at(0), operands.at(1))
        else
            None

    // `sizeof(T)` and `alignof(T)` are compile-time constants, so they fold exactly as a literal
    // does -- which is what makes them usable in an array bound and in a `const`.
    LayoutOf(what, t) -> layout_bytes(cx, what, resolve_type(cx.an, cx.scope, t, cx.subst))
    OffsetOf(t, field) -> offset_bytes(cx, resolve_type(cx.an, cx.scope, t, cx.subst), field)

    // `T::Min` and `T::Max` on a built-in integer are constants for the reason `sizeof` is: the
    // answer is a property of the type and is known once the type is.
    TypeAttr(receiver, attr) -> const_type_attr(cx, receiver, attr)

    _ -> None

// How many types the pack `A` stands for, where `A.len` is what was written.
private pack_length(subst: Buf[Binding], receiver: Expr, name: string) -> Option[Const]
    if name != "len" then return None

    *receiver.kind match
        Ident(n) -> bound_type(subst, n) match
            Some(Pack(elems)) -> Some(ConstInt(from_int(long(elems.len()))))
            _ -> None
        _ -> None
end pack_length

// What a value parameter stands for, where the name is bound to one.
//
// The argument travels as a `BigInt` because that is what a type's identity needs -- something that
// compares and mangles -- and the declared type is what says how to read it back. A `bool` whose
// parameter folded to an integer would be a `0` where the body wrote `B`, so the type is not
// decoration here: it is the half of the pair that makes the number mean something.
private const_arg_bound(subst: Buf[Binding], name: string) -> Option[Const]
    bound_type(subst, name) match
        Some(ConstArg(v, ty)) -> underlying(*ty) match
            Bool -> Some(ConstBool(v != from_int(0)))
            Char -> Some(ConstChar(char(u32(v.to_long().unwrap_or(0)))))
            _ -> Some(ConstInt(v))
        _ -> None
end const_arg_bound

private const_of_name(cx: &Analyzer, name: string) -> Option[Const]
    if cx.lookup(name).is_some() then return None

    val key = lookup_value_key(cx, cx.an.tables.consts, name)

    if key.is_none() then return None

    val d = cx.an.tables.consts.get(key.unwrap()).unwrap()

    if d.init.is_none() then return None
    // A constant written in terms of itself is a loop the fold would follow for ever, so it is cut
    // here as well as where a use of one is typed.
    if const_cycle_at(cx, key.unwrap()) then return None

    val inner = analyzer_for(cx.an, d.scope)

    cx.an.consts_in_progress.push(key.unwrap())

    val out = const_fold(inner, d.init.unwrap())

    cx.an.consts_in_progress.truncate(cx.an.consts_in_progress.len() - 1)
    out
end const_of_name

// The dotted spelling a `Field` over a chain of plain names comes to, where it is one.
private dotted_name(receiver: Expr, name: string) -> Option[string] = *receiver.kind match
    Ident(head) -> Some(s"$head.$name")
    Field(inner, mid) -> dotted_name(inner, mid).map(head -> s"$head.$name")
    _ -> None

private const_unary(cx: &Analyzer, op: string, operand: Expr) -> Option[Const]
    val v = const_fold(cx, operand)

    if v.is_none() then return None

    v.unwrap() match
        ConstInt(n) ->
            if op == "-" then Some(ConstInt(negate(n)))
            else None
        ConstBool(b) -> if op == "!" then Some(ConstBool(!b)) else None
        _ -> None
end const_unary

// A conversion is written, so what it does while compiling is what it does while running.
private const_binary(cx: &Analyzer, op: string, l: Expr, r: Expr) -> Option[Const]
    val a = const_fold(cx, l)
    val b = const_fold(cx, r)

    if a.is_none() || b.is_none() then return None

    a.unwrap() match
        ConstInt(x) -> b.unwrap() match
            ConstInt(y) -> int_binary(op, x, y)
            _ -> None
        ConstBool(x) -> b.unwrap() match
            ConstBool(y) -> bool_binary(op, x, y)
            _ -> None
        _ -> None
end const_binary

private int_binary(op: string, x: BigInt, y: BigInt) -> Option[Const]
    if op == "+" then return Some(ConstInt(add(x, y)))
    if op == "-" then return Some(ConstInt(sub(x, y)))
    if op == "*" then return Some(ConstInt(mul(x, y)))
    if op == "==" then return Some(ConstBool(cmp(x, y) == 0))
    if op == "!=" then return Some(ConstBool(cmp(x, y) != 0))
    if op == "<" then return Some(ConstBool(cmp(x, y) < 0))
    if op == "<=" then return Some(ConstBool(cmp(x, y) <= 0))
    if op == ">" then return Some(ConstBool(cmp(x, y) > 0))
    if op == ">=" then return Some(ConstBool(cmp(x, y) >= 0))

    // A division by zero is a mistake in what was written rather than something to answer, and it
    // is left to the reading that asked for the fold to say so.
    if op == "/" then
        if cmp(y, from_int(0)) == 0 then return None
        else return Some(ConstInt(div_rem(x, y).0))

    if op == "%" then
        if cmp(y, from_int(0)) == 0 then return None
        else return Some(ConstInt(div_rem(x, y).1))

    if op == "<<" || op == ">>" then return shifted(op, x, y)

    None
end int_binary

// A constant shift, done as a multiplication or a division by a power of two, since these are
// numbers with no width to shift bits inside of.
//
// **The ceiling on the distance is the widest integer a type may be and not 64**, because a shift
// past 64 places is meaningful the moment a type is wider than that: `1 << 200` is an ordinary
// constant at `u256`. A distance beyond every possible width is refused -- it cannot be a shift of
// anything, and the number it would produce is unbounded.
private shifted(op: string, x: BigInt, places: BigInt) -> Option[Const]
    if cmp(places, from_int(0)) < 0 || cmp(places, from_int(long(MaxIntegerBits))) > 0 then
        return None

    val n = places.to_long()

    if n.is_none() then return None

    val scale = pow(from_int(2), usize(n.unwrap()))

    if op == "<<" then return Some(ConstInt(mul(x, scale)))

    // **A right shift rounds DOWN and a division rounds toward zero**, and the two disagree on
    // every negative value that does not divide exactly: `-3 >> 1` is `-2` and `-3 / 2` is `-1`.
    // The shift is the arithmetic one, so a negative left over takes the quotient one further down.
    val q = div_rem(x, scale)

    if cmp(x, from_int(0)) < 0 && cmp(q.1, from_int(0)) != 0 then
        return Some(ConstInt(sub(q.0, from_int(1))))

    Some(ConstInt(q.0))
end shifted

private bool_binary(op: string, x: bool, y: bool) -> Option[Const]
    if op == "&&" then return Some(ConstBool(x && y))
    if op == "||" then return Some(ConstBool(x || y))
    if op == "==" then return Some(ConstBool(x == y))
    if op == "!=" then return Some(ConstBool(x != y))

    None
end bool_binary

// How many bytes `sizeof` or `alignof` answers with, where the type is one this compilation has a
// layout for. A type parameter is not measured: its width is fixed at each instantiation.
layout_bytes(cx: &Analyzer, what: string, t: Type) -> Option[Const]
    if t == Unknown || mentions_abstract(t) then return None

    if what == "sizeof" then return Some(ConstInt(from_int(long(cx.an.tables.layout.size(t)))))
    if what == "alignof" then return Some(ConstInt(from_int(long(cx.an.tables.layout.align(t)))))

    None
end layout_bytes

// Where a field sits in a struct, in bytes.
offset_bytes(cx: &Analyzer, t: Type, field: string) -> Option[Const]
    if t == Unknown || mentions_abstract(t) then return None

    underlying(t) match
        Struct(d) -> cx.an.tables.layout.field_offset(d, field)
                       .map(n -> ConstInt(from_int(long(n))))
        _ -> None
end offset_bytes

// A width family name, measured with nothing to say about a spelling that is not one.
private width_of(cx: &Analyzer, name: string) -> Option[Type] =
    width_type(cx.an, cx.scope, Span(0, 0), name)

// `T::Min` and `T::Max` on a built-in integer.
private const_type_attr(cx: &Analyzer, receiver: Expr, attr: string) -> Option[Const]
    val name = *receiver.kind match
        Ident(n) -> Some(n)
        _ -> None

    if name.is_none() then return None

    val t = scalar_named(name.unwrap(), word_bits(cx)).or_else(() -> width_of(cx, name.unwrap()))

    if t.is_none() then return None

    t.unwrap() match
        Integer(bits, signed, _) ->
            if attr == "Min" then Some(ConstInt(min_of(bits, signed)))
            else if attr == "Max" then Some(ConstInt(max_of(bits, signed)))
            else None
        _ -> None
end const_type_attr

// -- `@assert` -----------------------------------------------------------------------------------

// What an `@assert` says when its condition does not hold, is not a condition, or does not settle.
//
// **It is settled while compiling and emits nothing either way**: a true assertion is not code, and
// a false one has already stopped the compilation. So the whole of the form is what is said about
// it here.
//
// Inside a generic body the folding is done against the substitution the instantiation supplied,
// which is the only moment `sizeof(T)` is a number -- and a condition that is still waiting for one
// is not a mistake, since a later instantiation settles it.
check_assert(cx: &Analyzer, span: Span, cond: Expr, message: Option[string])
    const_fold(cx, cond) match
        Some(ConstBool(true)) -> ()
        Some(ConstBool(false)) ->
            val head = assertion_head(message)

            cx.fault(span, head + compared_note(cx, cond) + instantiation_note(cx))
        Some(other) ->
            cx.fault(span, s"'@assert' takes a condition, and this is ${const_kind(other)} — an " +
                     "assertion is something that can be true or false")
        None ->
            if !awaits_instantiation(cx, cond) then
                cx.fault(span, "'@assert' is settled while compiling, so its condition has to be " +
                         "a constant expression — a literal, a 'const', 'sizeof', 'alignof', " +
                         "'offsetof', or the arithmetic and comparisons over them, and never a call")
end check_assert

private assertion_head(message: Option[string]) -> string
    if message.is_none() then return "assertion failed"

    s"assertion failed: ${message.unwrap()}"
end assertion_head

// What a failed **comparison** adds: the value each side folded to, for a side the reader did not
// write out as a literal. The compiler folded both to decide the comparison, so it is holding the
// two numbers that explain the answer.
private compared_note(cx: &Analyzer, cond: Expr) -> string
    var left: Option[string] = None
    var right: Option[string] = None

    *cond.kind match
        Compare(operands, ops) ->
            if operands.len() == 2 && ops.len() == 1
                left = folded_side(cx, operands.at(0))
                right = folded_side(cx, operands.at(1))
        _ -> ()

    if left.is_some() && right.is_some() then
        return s" — the left side is ${left.unwrap()} and the right side is ${right.unwrap()}"

    if left.is_some() then return s" — the left side is ${left.unwrap()}"
    if right.is_some() then return s" — the right side is ${right.unwrap()}"

    ""
end compared_note

// One side of the comparison, as text, unless the reader wrote it out as a literal -- in which case
// reporting it back says nothing they cannot already see.
private folded_side(cx: &Analyzer, e: Expr) -> Option[string]
    if written_literal(e) then return None

    const_fold(cx, e).map(v -> const_text(v))
end folded_side

// Whether an operand is a literal the reader **wrote**. A negative number is written `-1` and parses
// as a unary minus over a literal, so it counts too -- otherwise the shape a bound is most often
// compared against would be the one reported back.
private written_literal(e: Expr) -> bool = *e.kind match
    IntLit(_, _, _) -> true
    FloatLit(_, _) -> true
    BoolLit(_) -> true
    CharLit(_) -> true
    StrLit(_) -> true
    Unary(op, operand) -> op == "-" && written_literal(operand)
    _ -> false

// A folded value as it should appear inside a sentence, spelled the way it would be written.
private const_text(v: Const) -> string = v match
    ConstInt(n) -> to_string(n)
    ConstBool(b) -> if b then "true" else "false"
    ConstChar(c) -> s"'$c'"
    ConstStr(s) -> s"\"$s\""

// What a value that is not a condition is, said the way the refusal names it.
private const_kind(v: Const) -> string = v match
    ConstInt(_) -> "an integer"
    ConstBool(_) -> "a boolean"
    ConstChar(_) -> "a character"
    ConstStr(_) -> "a string"

// Whether the condition is one a later instantiation settles rather than one that cannot settle at
// all: a measurement of a type parameter, or a value parameter standing in for itself.
private awaits_instantiation(cx: &Analyzer, e: Expr) -> bool = *e.kind match
    LayoutOf(_, t) -> is_abstract_underlying(resolve_type(cx.an, cx.scope, t, cx.subst))
    OffsetOf(t, _) -> is_abstract_underlying(resolve_type(cx.an, cx.scope, t, cx.subst))
    Ident(n) -> binding_is_abstract(cx.subst, n)
    Unary(_, operand) -> awaits_instantiation(cx, operand)
    Binary(_, l, r) -> awaits_instantiation(cx, l) || awaits_instantiation(cx, r)
    Compare(operands, _) ->
        operands.len() == 2 && (awaits_instantiation(cx, operands.at(0)) ||
                                awaits_instantiation(cx, operands.at(1)))
    Call(callee, args) -> args.len() == 1 && is_bare_name(callee) && awaits_instantiation(cx, args.at(0))
    _ -> false

private is_bare_name(e: Expr) -> bool = *e.kind match
    Ident(_) -> true
    _ -> false

private is_abstract_underlying(t: Type) -> bool = underlying(t) match
    Abstract(_, _) -> true
    _ -> false

private binding_is_abstract(subst: Buf[Binding], name: string) -> bool
    for i in 0..<subst.len()
        if subst.at(i).name == name
            return subst.at(i).ty match
                Abstract(_, _) -> true
                _ -> false

    false
end binding_is_abstract

// Which type parameters the body was compiled against, where it was compiled against any.
//
// The mistake is at the call that asked while the sentence explaining why is at the declaration, so
// a report carrying only one of the two sends the reader to the wrong file. `Self` is named
// alongside the parameters rather than filtered out as the compiler's own word: in an inherited
// default body -- one text shared by every implementing type -- it is the whole of the answer.
private instantiation_note(cx: &Analyzer) -> string
    if cx.subst.is_empty() then return ""

    var names: Buf[string] = buf()

    for i in 0..<cx.subst.len()
        names.push(cx.subst.at(i).name)

    val sorted = sort_names(names)
    var out = " — where "

    for i in 0..<sorted.len()
        for j in 0..<cx.subst.len()
            if cx.subst.at(j).name == sorted.at(i)
                out = out + (if i > 0 then ", " else "") +
                      s"${sorted.at(i)} = ${type_show(cx.subst.at(j).ty)}"

    out
end instantiation_note
