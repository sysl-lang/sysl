module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.text.{join, Search}

// Version selection, the import tables built over it, and the claims kept beside the answer -- the
// cases `tests_deps.sysl` does not already answer.
//
// **Every graph here is built in a cache of its own**, populated by hand as a fetch would have left
// it, so the answers are about the resolver rather than about what this machine fetched before.

private rvx_cache() -> string = make_temp_dir("sysl-rvx-cache").unwrap()

private rvx_manifest(name: string, version: string, deps: string) -> string =
    s"package { name = \"$name\", version = \"$version\" }\n" +
    (if deps.is_empty() then "" else s"dependencies { $deps }\n")

private rvx_dep(label: string, coordinate: string, version: string) -> string =
    s"$label { git = \"$coordinate\", version = \"$version\" }"

private rvx_mounted(label: string, coordinate: string, version: string, mount: string) -> string =
    s"$label { git = \"$coordinate\", version = \"$version\", mount = \"$mount\" }"

// A package placed in the cache at a coordinate and version, holding only its manifest.
private rvx_published(cache: string, coordinate: string, version: Release, config: string) -> string
    val dir = fetch_directory(cache, coordinate, version)

    make_dir_all(dir).unwrap()
    write_text(join_path(dir, ManifestName), config).unwrap()
    dir
end rvx_published

// One module of source at `module_path` below a directory, which is what makes the path a module.
private rvx_source(dir: string, module_path: string)
    make_dir_all(s"$dir/$module_path").unwrap()
    write_text(s"$dir/$module_path/${rvx_leaf(module_path)}.sysl",
               s"module ${rvx_dotted(module_path)}\n").unwrap()

// A package in the cache holding one module, under a package name that need not be the module's.
private rvx_module(cache: string, coordinate: string, version: Release, module_path: string,
                   name: string, deps: string) -> string
    val dir = rvx_published(cache, coordinate, version,
                            rvx_manifest(name, release_shown(version), deps))

    rvx_source(dir, module_path)
    dir
end rvx_module

private rvx_leaf(dir: string) -> string
    var at: usize = 0

    for i in 0..<dir.bytes.len
        if dir.bytes[i] == u8('/') then at = i + 1

    dir[at..<dir.bytes.len]
end rvx_leaf

private rvx_dotted(dir: string) -> string
    var out = ""

    for i in 0..<dir.bytes.len
        out = out + (if dir.bytes[i] == u8('/') then "." else dir[i..<(i + 1)])

    out
end rvx_dotted

// A project on disk with a manifest and, where `own` is not empty, one module of its own there.
private rvx_project(config: string, own: string) -> string
    val root = make_temp_dir("sysl-rvx-project").unwrap()

    if !config.is_empty() then write_text(join_path(root, ManifestName), config).unwrap()

    if !own.is_empty() then rvx_source(root, own)

    root
end rvx_project

// A project with a directory of that name holding no source, which is therefore not a module.
private rvx_bare(config: string, dir: string) -> string
    val root = rvx_project(config, "")

    make_dir_all(s"$root/$dir").unwrap()
    root
end rvx_bare

private rvx_resolved(root: string, cache: string) -> Graph
    val m = manifest_of_package(root).unwrap()

    resolve_graph(root, m, empty_sums(), cache).unwrap()
end rvx_resolved

private rvx_refused(root: string, cache: string) -> string
    val m = manifest_of_package(root).unwrap()

    resolve_graph(root, m, empty_sums(), cache) match
        Err(why) -> why
        Ok(_) -> ""
end rvx_refused

// What selection chose for every fetched package, as sorted `canonical=version` words.
private rvx_selected(g: &Graph) -> string
    var rows: Buf[string] = buf()

    for i in 0..<g.packages.len()
        val p = g.packages.at(i)

        p.version match
            None -> ()
            Some(v) -> rows.push(s"${p.canonical}=${release_shown(v)}")

    join(sorted_labels(rows).view(), " ")
end rvx_selected

private rvx_imports(g: &Graph, canonical: string) -> string
    for i in 0..<g.packages.len()
        if g.packages.at(i).canonical != canonical then continue

        var rows: Buf[string] = buf()

        for j in 0..<g.packages.at(i).imports.len()
            val row = g.packages.at(i).imports.at(j)

            rows.push(s"${row.0}->${row.1}")

        return join(sorted_labels(rows).view(), " ")

    "no such package"
end rvx_imports

// The claims on one coordinate, in the order they were made, as `asker=version` words.
private rvx_claimed(g: &Graph, coordinate: string) -> string
    var rows: Buf[string] = buf()

    for i in 0..<g.claims.len()
        val c = g.claims.at(i)

        if c.coordinate == coordinate then rows.push(s"${c.asker}=${release_shown(c.version)}")

    join(rows.view(), " ")
end rvx_claimed

// Every coordinate anything made a claim on, once each, sorted.
private rvx_claim_keys(g: &Graph) -> string
    var keys: Buf[string] = buf()

    for i in 0..<g.claims.len()
        val k = g.claims.at(i).coordinate
        var seen = false

        for j in 0..<keys.len()
            if keys.at(j) == k then seen = true

        if !seen then keys.push(k)

    join(sorted_labels(keys).view(), " ")
end rvx_claim_keys

private rvx_v100() -> Release = Release(1, 0, 0)

private rvx_cleanup(a: string, b: string)
    remove_dir_all(a).unwrap_or(())
    remove_dir_all(b).unwrap_or(())

// -- the highest minimum wins, not the newest that exists ------------------------------------------

// 1.10.0 is higher than 1.9.0, which is the case a comparison done on the text gets wrong -- asked of
// a whole graph rather than of two versions alone.
@test("versions are compared as numbers")
rvx_versions_are_compared_as_numbers()
    val cache = rvx_cache()

    rvx_module(cache, "github.com/e/buf", Release(1, 9, 0), "buf", "buf", "")
    rvx_module(cache, "github.com/e/buf", Release(1, 10, 0), "buf", "buf", "")
    rvx_module(cache, "github.com/e/a", rvx_v100(), "a", "a", rvx_dep("buf", "github.com/e/buf", "1.10.0"))

    val root = rvx_project(rvx_manifest("app", "0.1.0",
                                        rvx_dep("a", "github.com/e/a", "1.0.0") + ", " +
                                        rvx_dep("buf", "github.com/e/buf", "1.9.0")), "")

    assert_eq(rvx_selected(rvx_resolved(root, cache)), "github.com.e.a=1.0.0 github.com.e.buf=1.10.0")
    rvx_cleanup(cache, root)

// -- what a name at the head of an import line means -----------------------------------------------

// The package is the unit of distribution and the module the unit of code: sqlite3's package is
// `sqlite3` and its module is `sqlite`, and a consumer reaching the second need not say the first.
@test("and not the name the package calls itself")
rvx_not_the_name_the_package_calls_itself()
    val cache = rvx_cache()

    rvx_module(cache, "github.com/e/sqlite3", rvx_v100(), "sqlite", "sqlite3", "")

    val root = rvx_project(rvx_manifest("app", "0.1.0",
                                        rvx_dep("s", "github.com/e/sqlite3", "1.0.0")), "")

    assert_eq(rvx_imports(rvx_resolved(root, cache), ""), "sqlite->github.com.e.sqlite3.sqlite")
    rvx_cleanup(cache, root)

@test("every module a package has, where there is more than one")
rvx_every_module_a_package_has()
    val cache = rvx_cache()
    val dir = rvx_published(cache, "github.com/e/two", rvx_v100(), rvx_manifest("two", "1.0.0", ""))

    rvx_source(dir, "alpha")
    rvx_source(dir, "beta")

    val root = rvx_project(rvx_manifest("app", "0.1.0", rvx_dep("t", "github.com/e/two", "1.0.0")), "")

    assert_eq(rvx_imports(rvx_resolved(root, cache), ""),
              "alpha->github.com.e.two.alpha beta->github.com.e.two.beta")
    rvx_cleanup(cache, root)

// Per-consumer, which is the whole of the two-layer identity: two projects may write different words
// and still link one copy of the package.
@test("is per-package, so a dependency's own table is its own")
rvx_a_table_is_per_package()
    val cache = rvx_cache()

    rvx_module(cache, "github.com/e/buf", rvx_v100(), "buf", "buf", "")
    rvx_module(cache, "github.com/e/a", rvx_v100(), "a", "a", rvx_dep("b", "github.com/e/buf", "1.0.0"))

    val root = rvx_project(rvx_manifest("app", "0.1.0",
                                        rvx_dep("a", "github.com/e/a", "1.0.0") + ", " +
                                        rvx_mounted("buf", "github.com/e/buf", "1.0.0", "bytes")), "")
    val graph = rvx_resolved(root, cache)

    assert_eq(rvx_imports(graph, ""), "a->github.com.e.a.a bytes->github.com.e.buf")
    assert_eq(rvx_imports(graph, "github.com.e.a"), "buf->github.com.e.buf.buf")
    rvx_cleanup(cache, root)

// However far down it is: what a program can name is the whole graph, not the first layer of it.
@test("and one reached through two of them")
rvx_one_reached_through_two()
    val cache = rvx_cache()

    rvx_module(cache, "github.com/e/buf", rvx_v100(), "buf", "buf", "")
    rvx_module(cache, "github.com/e/ui", rvx_v100(), "ui", "ui", rvx_dep("buf", "github.com/e/buf", "1.0.0"))
    rvx_module(cache, "github.com/e/driver", rvx_v100(), "driver", "driver",
               rvx_dep("ui", "github.com/e/ui", "1.0.0"))

    val root = rvx_project(rvx_manifest("app", "0.1.0",
                                        rvx_dep("d", "github.com/e/driver", "1.0.0")), "")

    assert_eq(rvx_imports(rvx_resolved(root, cache), ""),
              "buf->github.com.e.buf.buf driver->github.com.e.driver.driver ui->github.com.e.ui.ui")
    rvx_cleanup(cache, root)

// What a manifest declared beats what arrived through something else, which is what makes a mount
// worth writing: the nearer name is the one in front of the person reading the file.
@test("a declared name beats an inherited one")
rvx_a_declared_name_beats_an_inherited_one()
    val cache = rvx_cache()

    rvx_module(cache, "github.com/e/json", rvx_v100(), "json", "json", "")
    rvx_module(cache, "github.com/e/driver", rvx_v100(), "driver", "driver",
               rvx_dep("j", "github.com/e/json", "1.0.0"))

    val root = rvx_project(rvx_manifest("app", "0.1.0",
                                        rvx_dep("d", "github.com/e/driver", "1.0.0") + ", " +
                                        rvx_mounted("j", "github.com/e/json", "1.0.0", "ejson")), "")

    assert_eq(rvx_imports(rvx_resolved(root, cache), ""),
              "driver->github.com.e.driver.driver ejson->github.com.e.json")
    rvx_cleanup(cache, root)

// -- a collision is an error and never a silent winner ---------------------------------------------

// The same collision one layer further away, refused in the same words, with the fix stated as what
// a consumer can actually do about it.
@test("two inherited packages wanting one name")
rvx_two_inherited_packages_wanting_one_name()
    val cache = rvx_cache()

    rvx_module(cache, "github.com/e/one", rvx_v100(), "json", "one", "")
    rvx_module(cache, "github.com/e/two", rvx_v100(), "json", "two", "")
    rvx_module(cache, "github.com/e/a", rvx_v100(), "a", "a", rvx_dep("j", "github.com/e/one", "1.0.0"))
    rvx_module(cache, "github.com/e/b", rvx_v100(), "b", "b", rvx_dep("j", "github.com/e/two", "1.0.0"))

    val root = rvx_project(rvx_manifest("app", "0.1.0",
                                        rvx_dep("a", "github.com/e/a", "1.0.0") + ", " +
                                        rvx_dep("b", "github.com/e/b", "1.0.0")), "")
    val said = rvx_refused(root, cache)

    assert(said.index_of("claim the same module").is_some(), said)
    assert(said.index_of("mount").is_some(), said)
    rvx_cleanup(cache, root)

// ...and naming one of them is what settles it, because a declared name beats an inherited one.
@test("which naming one of them settles")
rvx_naming_one_of_them_settles()
    val cache = rvx_cache()

    rvx_module(cache, "github.com/e/one", rvx_v100(), "json", "one", "")
    rvx_module(cache, "github.com/e/two", rvx_v100(), "json", "two", "")
    rvx_module(cache, "github.com/e/a", rvx_v100(), "a", "a", rvx_dep("j", "github.com/e/one", "1.0.0"))
    rvx_module(cache, "github.com/e/b", rvx_v100(), "b", "b", rvx_dep("j", "github.com/e/two", "1.0.0"))

    val root = rvx_project(rvx_manifest("app", "0.1.0",
                                        rvx_dep("a", "github.com/e/a", "1.0.0") + ", " +
                                        rvx_dep("b", "github.com/e/b", "1.0.0") + ", " +
                                        rvx_dep("one", "github.com/e/one", "1.0.0")), "")

    assert_eq(rvx_imports(rvx_resolved(root, cache), ""),
              "a->github.com.e.a.a b->github.com.e.b.b json->github.com.e.one.json")
    rvx_cleanup(cache, root)

// Two packages that are not one library keep the plainer sentence, because reading them as one would
// send somebody looking for a version they do not have.
@test("and two unrelated packages do not")
rvx_two_unrelated_packages_do_not()
    val cache = rvx_cache()

    rvx_module(cache, "github.com/e/one", rvx_v100(), "json", "one", "")
    rvx_module(cache, "github.com/e/two", rvx_v100(), "json", "two", "")

    val root = rvx_project(rvx_manifest("app", "0.1.0",
                                        rvx_dep("a", "github.com/e/one", "1.0.0") + ", " +
                                        rvx_dep("b", "github.com/e/two", "1.0.0")), "")
    val said = rvx_refused(root, cache)

    assert(!said.is_empty(), "the two still collide")
    assert(said.index_of("major versions").is_none(), said)
    rvx_cleanup(cache, root)

@test("and a mount settles it")
rvx_and_a_mount_settles_it()
    val cache = rvx_cache()

    rvx_module(cache, "github.com/e/one", rvx_v100(), "json", "one", "")
    rvx_module(cache, "github.com/e/two", rvx_v100(), "json", "two", "")

    val root = rvx_project(rvx_manifest("app", "0.1.0",
                                        rvx_dep("a", "github.com/e/one", "1.0.0") + ", " +
                                        rvx_mounted("b", "github.com/e/two", "1.0.0", "json2")), "")

    assert_eq(rvx_imports(rvx_resolved(root, cache), ""),
              "json->github.com.e.one.json json2->github.com.e.two")
    rvx_cleanup(cache, root)

@test("and a directory that is not a module does not collide with anything")
rvx_a_directory_that_is_not_a_module()
    val cache = rvx_cache()

    rvx_module(cache, "github.com/e/one", rvx_v100(), "json", "one", "")

    val root = rvx_bare(rvx_manifest("app", "0.1.0", rvx_dep("a", "github.com/e/one", "1.0.0")), "json")

    assert_eq(rvx_imports(rvx_resolved(root, cache), ""), "json->github.com.e.one.json")
    rvx_cleanup(cache, root)

@test("nor does a dot directory, which is never walked at all")
rvx_nor_does_a_dot_directory()
    val cache = rvx_cache()

    rvx_module(cache, "github.com/e/one", rvx_v100(), "json", "one", "")

    val root = rvx_project(rvx_manifest("app", "0.1.0", rvx_dep("a", "github.com/e/one", "1.0.0")),
                           ".git")

    assert_eq(rvx_imports(rvx_resolved(root, cache), ""), "json->github.com.e.one.json")
    rvx_cleanup(cache, root)

// A project namespacing itself the way packages do is held to the same rule at the same depth: its
// own `sh/sysl/table` collides, and an unrelated `sh/sysl/other` does not.
@test("a project's own namespaced module collides only at the path it actually declares")
rvx_own_namespaced_module_collides_only_at_its_path()
    val cache = rvx_cache()

    rvx_module(cache, "github.com/sysl-lang/table", Release(0, 1, 2), "sh/sysl/table", "table", "")

    val config = rvx_manifest("app", "0.1.0", rvx_dep("table", "github.com/sysl-lang/table", "0.1.2"))
    val clash = rvx_project(config, "sh/sysl/table")
    val said = rvx_refused(clash, cache)

    assert(said.index_of("is both a module of this project").is_some(), said)

    val fine = rvx_project(config, "sh/sysl/other")

    assert_eq(rvx_imports(rvx_resolved(fine, cache), ""),
              "sh.sysl.table->github.com.sysl-lang.table.sh.sysl.table")
    rvx_cleanup(cache, clash)
    remove_dir_all(fine).unwrap_or(())

// -- a path dependency ------------------------------------------------------------------------------

// A manifest saying `path = "../helper"` means nothing until it is joined to the directory holding
// the manifest that wrote it -- never to the process's working directory, which here is elsewhere.
@test("a relative one is read against the directory of the manifest that wrote it")
rvx_a_relative_path_is_read_against_its_manifest()
    val cache = rvx_cache()
    val parent = make_temp_dir("sysl-rvx-relative").unwrap()
    val helper = s"$parent/helper"

    make_dir_all(helper).unwrap()
    write_text(join_path(helper, ManifestName), rvx_manifest("helper", "0.1.0", "")).unwrap()
    rvx_source(helper, "helper")

    val root = s"$parent/app"

    make_dir_all(root).unwrap()
    write_text(join_path(root, ManifestName),
               "package { name = \"app\", version = \"0.1.0\" }\n" +
               "dependencies { h { path = \"../helper\" } }\n").unwrap()

    val graph = rvx_resolved(root, cache)

    assert_eq(rvx_imports(graph, ""), "helper->h.helper")

    var at = "no such package"

    for i in 0..<graph.packages.len()
        if graph.packages.at(i).canonical == "h" then at = graph.packages.at(i).root

    assert_eq(at, helper)
    rvx_cleanup(cache, parent)

// Its git dependencies still take part in selection, so a floor it raises is a floor.
@test("raises the floors its own manifest asks for")
rvx_a_path_dependency_raises_floors()
    val cache = rvx_cache()

    rvx_module(cache, "github.com/e/buf", Release(1, 4, 0), "buf", "buf", "")

    val other = rvx_project(rvx_manifest("helper", "0.1.0", rvx_dep("buf", "github.com/e/buf", "1.4.0")),
                            "helper")
    val root = rvx_project("package { name = \"app\", version = \"0.1.0\" }\n" +
                           s"dependencies { h { path = \"$other\" } }\n", "")

    assert_eq(rvx_selected(rvx_resolved(root, cache)), "github.com.e.buf=1.4.0")
    rvx_cleanup(cache, root)
    remove_dir_all(other).unwrap_or(())

// -- every claim is recorded, whether or not it won ------------------------------------------------

@test("the floor that lost is kept, which selection alone cannot say")
rvx_the_floor_that_lost_is_kept()
    val cache = rvx_cache()

    rvx_module(cache, "github.com/e/buf", Release(1, 2, 0), "buf", "buf", "")
    rvx_module(cache, "github.com/e/buf", Release(1, 4, 0), "buf", "buf", "")
    rvx_module(cache, "github.com/e/a", rvx_v100(), "a", "a", rvx_dep("buf", "github.com/e/buf", "1.2.0"))
    rvx_module(cache, "github.com/e/b", rvx_v100(), "b", "b", rvx_dep("buf", "github.com/e/buf", "1.4.0"))

    val root = rvx_project(rvx_manifest("app", "0.1.0",
                                        rvx_dep("a", "github.com/e/a", "1.0.0") + ", " +
                                        rvx_dep("b", "github.com/e/b", "1.0.0")), "")

    assert_eq(rvx_claimed(rvx_resolved(root, cache), "github.com/e/buf"),
              "github.com/e/a=1.2.0 github.com/e/b=1.4.0")
    rvx_cleanup(cache, root)

// The manifest of the version that was passed over is dropped, so nothing in the finished graph could
// answer this by being scanned -- which is the whole argument for carrying it.
@test("so a losing claim survives its own manifest leaving the graph")
rvx_a_losing_claim_survives()
    val cache = rvx_cache()

    rvx_module(cache, "github.com/e/buf", Release(1, 2, 0), "early", "early", "")
    rvx_module(cache, "github.com/e/buf", Release(1, 4, 0), "later", "later", "")
    rvx_module(cache, "github.com/e/a", rvx_v100(), "a", "a", rvx_dep("buf", "github.com/e/buf", "1.2.0"))

    val root = rvx_project(rvx_manifest("app", "0.1.0",
                                        rvx_dep("a", "github.com/e/a", "1.0.0") + ", " +
                                        rvx_dep("buf", "github.com/e/buf", "1.4.0")), "")
    val graph = rvx_resolved(root, cache)

    assert(rvx_selected(graph).index_of("1.2.0").is_none(), rvx_selected(graph))
    assert(rvx_claimed(graph, "github.com/e/buf").index_of("github.com/e/a=1.2.0").is_some(),
           rvx_claimed(graph, "github.com/e/buf"))
    rvx_cleanup(cache, root)

@test("the root asks under the name its manifest gives it")
rvx_the_root_asks_under_its_name()
    val cache = rvx_cache()

    rvx_module(cache, "github.com/e/buf", Release(1, 4, 0), "buf", "buf", "")

    val root = rvx_project(rvx_manifest("app", "0.1.0", rvx_dep("buf", "github.com/e/buf", "1.4.0")), "")
    val graph = rvx_resolved(root, cache)

    assert_eq(rvx_claim_keys(graph), "github.com/e/buf")
    assert_eq(rvx_claimed(graph, "github.com/e/buf"), "app=1.4.0")
    rvx_cleanup(cache, root)

// A manifest need not name its package, and a claim attributed to the empty string would read as
// though nobody had asked for it.
@test("and under a stand-in where it names none")
rvx_and_under_a_stand_in()
    val cache = rvx_cache()

    rvx_module(cache, "github.com/e/buf", Release(1, 4, 0), "buf", "buf", "")

    val root = rvx_project(s"dependencies { ${rvx_dep("buf", "github.com/e/buf", "1.4.0")} }\n", "")

    assert_eq(rvx_claimed(rvx_resolved(root, cache), "github.com/e/buf"), "this project=1.4.0")
    rvx_cleanup(cache, root)

// A path dependency has no coordinate, so it is attributed by the label its consumer wrote.
@test("a path dependency's demands are attributed to its label")
rvx_a_path_dependencys_demands_go_to_its_label()
    val cache = rvx_cache()

    rvx_module(cache, "github.com/e/buf", Release(1, 4, 0), "buf", "buf", "")

    val other = rvx_project(rvx_manifest("helper", "0.1.0", rvx_dep("buf", "github.com/e/buf", "1.4.0")),
                            "helper")
    val root = rvx_project("package { name = \"app\", version = \"0.1.0\" }\n" +
                           s"dependencies { h { path = \"$other\" } }\n", "")
    val graph = rvx_resolved(root, cache)

    assert_eq(rvx_claim_keys(graph), "github.com/e/buf")
    assert_eq(rvx_claimed(graph, "github.com/e/buf"), "h=1.4.0")
    rvx_cleanup(cache, root)
    remove_dir_all(other).unwrap_or(())

// Keyed as a manifest writes the coordinate, so no round trip through the dotted form is needed --
// which would not survive the trip anyway, a coordinate being full of dots.
@test("and the key is the coordinate as a manifest writes it")
rvx_the_key_is_the_written_coordinate()
    val cache = rvx_cache()

    rvx_module(cache, "github.com/e/buf", Release(1, 4, 0), "buf", "buf", "")

    val root = rvx_project(rvx_manifest("app", "0.1.0", rvx_dep("buf", "github.com/e/buf", "1.4.0")), "")

    assert_eq(rvx_claim_keys(rvx_resolved(root, cache)), "github.com/e/buf")
    rvx_cleanup(cache, root)

@test("a project with no dependencies claims nothing")
rvx_no_dependencies_claims_nothing()
    val cache = rvx_cache()
    val root = rvx_project(rvx_manifest("app", "0.1.0", ""), "")

    assert_eq(rvx_resolved(root, cache).claims.len(), 0)
    rvx_cleanup(cache, root)

// -- a dependency states the oldest compiler it builds with ----------------------------------------

// Asked against a release-line compiler, since this one makes no claim against its own number
// (`OnTheReleaseLine`).
@test("and one too new for the compiler in hand is refused by name")
rvx_a_dependency_too_new_is_refused_by_name()
    val cache = rvx_cache()
    val dir = rvx_published(cache, "github.com/e/future", rvx_v100(),
                            "package { name = \"future\", version = \"1.0.0\", sysl = \"99.0.0\" }\n")

    rvx_source(dir, "future")

    val root = rvx_project(rvx_manifest("app", "0.1.0", rvx_dep("f", "github.com/e/future", "1.0.0")), "")
    val graph = rvx_resolved(root, cache)

    assert_eq(dependency_floor_refusal(graph.packages, "0.0.145").unwrap_or("(nothing)"),
              "package future v1.0.0 cannot be built because it requires sysl 99.0.0 or newer, while " +
              "the compiler in hand is 0.0.145")
    rvx_cleanup(cache, root)

@test("and one this compiler satisfies is nothing at all")
rvx_a_satisfied_dependency_floor_is_nothing()
    val cache = rvx_cache()
    val dir = rvx_published(cache, "github.com/e/past", rvx_v100(),
                            "package { name = \"past\", version = \"1.0.0\", sysl = \"0.0.1\" }\n")

    rvx_source(dir, "past")

    val root = rvx_project(rvx_manifest("app", "0.1.0", rvx_dep("p", "github.com/e/past", "1.0.0")), "")
    val graph = rvx_resolved(root, cache)

    assert_eq(rvx_selected(graph), "github.com.e.past=1.0.0")
    assert(dependency_floor_refusal(graph.packages, "0.0.145").is_none(), "0.0.145 is past 0.0.1")
    rvx_cleanup(cache, root)

// -- a fetch -----------------------------------------------------------------------------------------

// `.invalid` is reserved by RFC 2606 so that it never resolves, which makes this a refusal rather than
// a network round trip.
@test("a package the cache has not got, and nothing can fetch")
rvx_a_package_nothing_can_fetch()
    val cache = rvx_cache()
    val root = rvx_project(rvx_manifest("app", "0.1.0",
                                        rvx_dep("j", "sysl.invalid/e/nothing-here", "1.0.0")), "")
    val said = rvx_refused(root, cache)

    assert(said.index_of("cannot fetch sysl.invalid/e/nothing-here").is_some(), said)
    rvx_cleanup(cache, root)
