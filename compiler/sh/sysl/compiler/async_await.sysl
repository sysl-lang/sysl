module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.Search

// `async` and `await`, as far as the front end goes: what an async function's call hands back,
// where an `await` may stand, and what it may wait for.
//
// **Stackless async, written on the function.** `async load(dev: &Codec) -> Result[Frame, Error]`
// declares a function whose CALL does not run it: the call makes a task, of the compiler's own type
// `Task[T]`, and the body runs only when the task is awaited or handed to something that drives it.
// So the parser rewrites the written result to `Task[T]` (`async_result`) and every caller, through
// every path a call is typed by, reads the task; the body alone is read against `T`
// (`body_result`), which is what its `return`s and its `?`s answer.
//
// **`await e` needs `e : Task[T]` and is `T`.** It binds looser than a call and tighter than `?`,
// so `await dev.read(512)?` propagates out of the awaited `Result`. It may stand only in an async
// function's own body: a closure is not itself async, even one written inside an async function,
// and the entry file's body is the program's `main`, which C calls directly.
//
// The reference compiler has neither word, so nothing here is checked against it; the design is the
// user's, and `tests_asy_async.sysl` asserts it.

// The base a task's type is filed under, and the name the parser writes for one. It holds a `$`,
// which no identifier may, so a program's own `Task` is never this one.
const TaskBase: string = "$task"

// `Task[T]`. A struct the compiler supplies: opaque, with no fields a program can read, and equal to
// another task exactly where the two `T`s are equal.
task_type(result: Type) -> Type
    var args: Buf[Type] = buf()

    args.push(result)
    Struct(StructType(TaskBase, args, buf(), false, None, None, true, None, buf()))
end task_type

// The `T` of a `Task[T]`, or nothing where the type is not a task.
task_result(t: Type) -> Option[Type] = t match
    Struct(d) -> if d.base == TaskBase && d.targs.len() == 1 then Some(d.targs.at(0)) else None
    _ -> None

// `Task[T]` written by a program, where nothing it can see declares a `Task` of its own.
written_task(a: &Analysis, scope: Scope, span: Span, targs: Buf[Type]) -> Type
    if targs.len() != 1
        a.fault(scope, span, s"'Task' takes one type argument — the type the task ends with — and " +
                s"${targs.len()} were written")
        return Unknown
    end if

    task_type(targs.at(0))
end written_task

// The base a written name is filed under where it names the compiler's `Task` -- the parser's own
// `$task`, or `Task` where nothing the program can see declares one, which is the reading
// `resolve_named` gives it. No table holds that base, so a lookup of the name answers nothing, and a
// generic parameter written `Task[T]` is matched against an argument's task by this instead.
task_key(a: &Analysis, scope: Scope, name: string) -> Option[string]
    if name == TaskBase then return Some(TaskBase)

    if name != "Task" then return None

    val rivals = offered_by(a, scope, name, k -> a.tables.types.has(k))

    if rivals.is_empty() then Some(TaskBase) else None
end task_key

// What a body is read against: the declared result, or for an async function the `T` of the
// `Task[T]` the parser made its declared result into.
body_result(d: FuncDecl, declared: Type) -> Type
    if !d.marks.is_async() then return declared

    task_result(declared).unwrap_or(declared)
end body_result

// -- where an `await` stands ----------------------------------------------------------------------

enum AwaitSite
    AwaitOutside
    AwaitInAsync
    AwaitInClosure
    AwaitInEntry

// The site a function's own body is, by whether the function is async.
await_site_of(d: FuncDecl) -> AwaitSite = if d.marks.is_async() then AwaitInAsync else AwaitOutside

// The site a closure's body is, written where `outer` is. **A closure is not itself async**, so
// inside an async function it is a site of its own, refused in words that say so.
closure_await_site(outer: AwaitSite) -> AwaitSite =
    if outer == AwaitInAsync || outer == AwaitInClosure then AwaitInClosure else AwaitOutside

// `await e`.
//
// The operand is read first and whatever is wrong inside it is told; then where the `await` stands,
// at the word; then what it was handed, at the operand.
await_expr(cx: &Analyzer, span: Span, inner: Expr) -> TExpr
    val t = if awaits_yield(cx, inner) then yield_now_task(cx, inner) else type_expr_bare(cx, inner)
    val word = Span(span.start, span.start + 5)

    if cx.await_site == AwaitInClosure then
        return cx.err(word, "'await' cannot be written in a closure: a closure is not itself " +
                      "async, even inside an 'async' function, so there is no task of its own for " +
                      "it to wait in. Await in the enclosing function's body and hand the closure " +
                      "the value")

    if cx.await_site == AwaitInEntry then
        return cx.err(word, "'await' may only be written in the body of an 'async' function, and " +
                      "this is the entry file's body — the program's 'main', which C calls " +
                      "directly and cannot drive a task through. Move the work into an 'async' " +
                      "function")

    if cx.await_site == AwaitOutside then
        return cx.err(word, "'await' may only be written in the body of an 'async' function, and " +
                      "the function it stands in is not one — write 'async' in front of its name " +
                      "to make it one")

    val ty = texpr_type(t)

    if ty == Unknown then return t

    task_result(ty) match
        Some(r) -> TExpr(span, TAwait(t, r))
        None -> cx.err(inner.span, s"'await' needs a Task, which is what calling an 'async' " +
                       s"function hands back, but this value is ${type_show(ty)}" +
                       shadowed_form(cx, inner))
end await_expr

// Where an awaited call names a task form a declaration has taken the name of, what the call
// reached instead -- or nothing. **A declaration the program can see is the nearer name**, which is
// the rule, so `import sysl.posix.threads.*` makes `yield_now()` the thread's: the refusal that
// follows is about a `bool`, and without this it never says where the `bool` came from.
private shadowed_form(cx: &Analyzer, inner: Expr) -> string
    val name = *inner.kind match
        Call(callee, _) -> *callee.kind match
            Ident(n) -> n
            _ -> ""
        _ -> ""

    if name != "yield_now" && name != "park" then return ""

    var from = "a local binding"
    var kind = "binding"

    if cx.lookup(name).is_none()
        kind = "declaration"

        val keys = function_keys(cx, name)

        if keys.is_empty() then return ""

        val decl = qualified_name(keys.at(0))
        val cut = decl.bytes.len - name.bytes.len

        from = if cut > 1 && decl.ends_with(s".$name") then s"'$decl', declared in '${decl[0..<cut - 1]}'"
        else "the program's own declaration"
    end if

    s" — the '$name' called here resolved to $from, and a $kind of that name stands in front of the " +
    s"task form '$name(…)', so the task form is shadowed"
end shadowed_form

// -- the forms the compiler supplies ---------------------------------------------------------------
//
// **The executor contract is two forms and a closure type, and nothing else.** An executor is
// ordinary code holding tasks; what it needs from the compiler is a way to run a task as far as its
// next suspension, and a way for a task to wait on something outside it and say when to run again:
//
//     step(t: Task[T], wake: &Fn() -> unit) -> bool      // resume once; true where `t` is finished
//     await park(register: &Fn(&Fn() -> unit) -> unit)   // hand `register` a waker, then wait on it
//
// A WAKER IS A `&Fn() -> unit`, so there is no type to learn: an executor hands `step` a closure that
// queues the task it is stepping, and a library leaf hands `park` a closure that keeps the waker it
// is given wherever the event it waits for will find it. Calling the waker calls the executor's
// closure -- the first time; every later call, and every call once the `park` has returned or its
// task has been dropped, does nothing. `yield_now()` is `park` with a registrar that wakes at once.
// `block_on(t)` is `step` in a loop, refusing (with a trap) a task that suspended unwoken, which
// nothing could ever run again.

// Whether a name in call position is one of the four forms and nothing the program can see claims it
// -- the library's `sysl.posix.threads.yield_now`, imported, is the nearer name. They are the
// compiler's because the standard module is also compiled by a compiler that has no tasks.
task_form(cx: &Analyzer, name: string) -> bool =
    (name == "block_on" || name == "yield_now" || name == "step" || name == "park") &&
        cx.lookup(name).is_none() && function_keys(cx, name).is_empty()

// `block_on(t)` or `step(t, wake)`, or `yield_now()`/`park(…)` written somewhere it is not awaited.
task_form_call(cx: &Analyzer, span: Span, name: string, args: Buf[Expr]) -> TExpr
    if name == "yield_now" then
        return cx.err(span, "'yield_now()' is a task that suspends once, and it can only be " +
                      "awaited — write 'await yield_now()' in the body of an 'async' function")

    if name == "park" then
        return cx.err(span, "'park(…)' is a task that waits on the waker it hands its registrar, " +
                      "and it can only be awaited — write 'await park(…)' in the body of an " +
                      "'async' function")

    if name == "step" then return step_call(cx, span, args)

    if args.len() != 1 then
        return cx.err(span, s"'block_on' takes one task — the one it runs to its end — but " +
                      supplied(args.len(), "argument"))

    val t = type_expr_bare(cx, args.at(0))
    val ty = texpr_type(t)

    if ty == Unknown then return t

    task_result(ty) match
        Some(r) -> TExpr(span, TBlockOn(t, r))
        None -> cx.err(args.at(0).span, s"'block_on' needs a Task, which is what calling an " +
                       s"'async' function hands back, but this value is ${type_show(ty)}")
end task_form_call

// `step(t, wake)`: any task, and the executor's closure for the parks it reaches.
private step_call(cx: &Analyzer, span: Span, args: Buf[Expr]) -> TExpr
    if args.len() != 2 then
        return cx.err(span, s"'step' takes the task it resumes and the waker its parks are to call, " +
                      s"but ${supplied(args.len(), "argument")}")

    val t = type_expr_bare(cx, args.at(0))
    val ty = texpr_type(t)
    val wake_ty = waker_type(cx)
    val w = read_callable(cx, args.at(1), wake_ty)

    if ty == Unknown || texpr_type(w) == Unknown then return bad_expr(span)

    if task_result(ty).is_none() then
        return cx.err(args.at(0).span, s"'step' needs a Task, which is what calling an 'async' " +
                      s"function hands back, but this value is ${type_show(ty)}")

    if !type_eq(texpr_type(w), wake_ty) then
        return cx.err(args.at(1).span, s"'step' needs the waker as a '&Fn() -> unit', the closure " +
                      s"a park in the task calls to say the task can run again, but this value is " +
                      type_show(texpr_type(w)))

    TExpr(span, TStep(t, w))
end step_call

// `&Fn() -> unit`: what a waker is.
waker_type(cx: &Analyzer) -> Type = waker_type_in(cx.an)

// The same, asked of the whole compilation rather than of a body being read.
waker_type_in(an: &Analysis) -> Type
    var args: Buf[Type] = buf()

    args.push(Unit)
    Ref(Trait(catalog_key(an, "Fn0").unwrap_or("Fn0"), args, buf()), false)
end waker_type_in

// `&Fn(&Fn() -> unit) -> unit`: what `park` hands its waker to.
private registrar_type(cx: &Analyzer) -> Type
    var takes: Buf[Type] = buf()

    takes.push(waker_type(cx))
    callable_type(cx, "Fn1", takes)
end registrar_type

private callable_type(cx: &Analyzer, spelling: string, takes: Buf[Type]) -> Type
    var args: Buf[Type] = buf()

    for item in takes
        args.push(item)

    args.push(Unit)
    Ref(Trait(catalog_key(cx.an, spelling).unwrap_or(spelling), args, buf()), false)
end callable_type

// An argument read at a callable type, a closure written there boxed and erased into it.
private read_callable(cx: &Analyzer, e: Expr, want: Type) -> TExpr
    val t = type_expr(cx, e, Some(want))

    if texpr_type(t) == Unknown then return t

    coerce(cx, t, want)
end read_callable

// Whether an awaited operand is the compiler's `yield_now()` or `park(…)`.
private awaits_yield(cx: &Analyzer, inner: Expr) -> bool = *inner.kind match
    Call(callee, _) -> *callee.kind match
        Ident(name) -> (name == "yield_now" || name == "park") && task_form(cx, name)
        _ -> false
    _ -> false

private yield_now_task(cx: &Analyzer, inner: Expr) -> TExpr = *inner.kind match
    Call(callee, args) ->
        val parks = *callee.kind match
            Ident(name) -> name == "park"
            _ -> false

        if parks then return park_task(cx, inner.span, args)

        if !args.is_empty() then
            return cx.err(inner.span, s"'yield_now' takes no arguments, but " +
                          supplied(args.len(), "argument"))

        TExpr(inner.span, TYieldNow)
    _ -> bad_expr(inner.span)

// `park(register)`, awaited.
private park_task(cx: &Analyzer, span: Span, args: Buf[Expr]) -> TExpr
    if args.len() != 1 then
        return cx.err(span, s"'park' takes one registrar — the closure handed the waker — but " +
                      supplied(args.len(), "argument"))

    val want = registrar_type(cx)
    val before = cx.reading_registrar

    cx.reading_registrar = true

    val r = read_callable(cx, args.at(0), want)

    cx.reading_registrar = before

    if texpr_type(r) == Unknown then return bad_expr(span)

    if !type_eq(texpr_type(r), want) then
        return cx.err(args.at(0).span, s"'park' needs its registrar as a " +
                      s"'${type_show(want)}', which is handed the waker of the task being stepped, " +
                      s"but this value is ${type_show(texpr_type(r))}")

    TExpr(span, TPark(r))
end park_task

// Whether `name`, read here, holds the waker a `park` handed its registrar.
holds_waker(cx: &Analyzer, name: string) -> bool
    val l = cx.lookup(name)

    if l.is_none() then return false

    val unique = l.unwrap().unique

    for item in cx.wakers
        if item == unique then return true

    false
end holds_waker

// Why a closure erased into a `&sync Fn` may not capture what it captured, where what is in the way
// is a waker -- or nothing, leaving the ordinary refusal.
//
// **The ordinary refusal's advice cannot be taken here.** It says to hold the capture as a `&sync`
// reference, but `park` hands its registrar a `&Fn() -> unit` and `step` refuses a `&sync` waker,
// so nothing the program writes makes this one atomic. What is true instead is where the waker
// belongs: to the executor stepping the task, which is the one to call it.
waker_capture_complaint(cx: &Analyzer, inner: Type) -> Option[string]
    if !is_closure_literal(inner) then return None

    val part = unshareable(inner)

    if part.is_none() then return None

    val p = part.unwrap()

    if p.path.len() != 1 || !holds_waker(cx, p.path.at(0)) then return None

    Some("a closure shared between two domains may be called from either, so every count it " +
         s"captures has to be atomic — but the '${p.path.at(0)}' it captures is the waker 'park' " +
         s"handed its registrar, a '${type_show(p.ty)}' belonging to the domain whose executor " +
         "steps the task, and no spelling makes it atomic. Keep the waker in that domain: let the " +
         "other domain — an interrupt, another thread — signal the executor, and have the executor " +
         "call the waker")
end waker_capture_complaint

// What a mismatch adds where a `Task[T]` stands where its `T` was wanted: the `await` left out. Each
// position keeps its own sentence -- it names the parameter, the binding, the result -- and this is
// appended to it, or nothing is where the two types are not a task and its value.
await_hint(got: Type, wanted: Type) -> string
    val awaited = task_result(got)

    if awaited.is_none() || task_result(wanted).is_some() then return ""
    if !type_eq(awaited.unwrap(), wanted) then return ""

    " — calling an 'async' function hands back its task rather than running it, so write 'await' " +
        s"in front to run it and take the ${type_show(wanted)} it ends with"
end await_hint
