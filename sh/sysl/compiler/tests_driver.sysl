module sh.sysl.compiler
@tests

import sh.sysl.parsing.source_of
import sysl.buf.{Buf, buf}
import sysl.text.Search
import sysl.fs.{make_dir_all, make_temp_dir, metadata, remove_dir_all, write_text}

// What one invocation compiles, and what it says when it cannot.

private library_here() -> bool = std_root().is_ok()

private project_of(shape: Buf[(string, string)]) -> string
    val root = make_temp_dir("sysl-proj").unwrap()

    for i in 0..<shape.len()
        val at = s"$root/${shape.at(i).0}"

        make_dir_all(parent_of(at).unwrap()).unwrap()
        write_text(at, shape.at(i).1).unwrap()

    root
end project_of

private pair(a: string, b: string) -> Buf[(string, string)]
    var out: Buf[(string, string)] = buf()

    out.push((a, b))
    out
end pair

@test("a module is a directory, so a header and a location are two statements of one fact")
a_header_and_a_location_must_agree()
    var found: Buf[Found] = buf()
    var units: Buf[Program] = buf()

    found.push(Found(source_of("main.sysl", ""), buf()))
    units.push(parse(source_of("main.sysl", "module geom\n")).program)

    val said = check_locations(found, units)

    assert_eq(said.len(), 1)
    assert(said.at(0).index_of("declares 'geom', but it sits at the project root").is_some(),
           said.at(0))
    assert(said.at(0).index_of("a module is a directory").is_some(), said.at(0))

@test("and a file that sits in a directory and declares nothing is the same mistake the other way")
a_file_in_a_directory_must_name_it()
    var dir: Buf[string] = buf()
    var found: Buf[Found] = buf()
    var units: Buf[Program] = buf()

    dir.push("geom")
    found.push(Found(source_of("geom/point.sysl", ""), dir))
    units.push(parse(source_of("geom/point.sysl", "f() -> int = 1\n")).program)

    val said = check_locations(found, units)

    assert_eq(said.len(), 1)
    assert(said.at(0).index_of("declares no module, but it sits in 'geom'").is_some(), said.at(0))

@test("a file whose header agrees with where it sits has nothing to answer for")
a_file_that_agrees_says_nothing()
    var dir: Buf[string] = buf()
    var found: Buf[Found] = buf()
    var units: Buf[Program] = buf()

    dir.push("geom")
    dir.push("plane")
    found.push(Found(source_of("geom/plane/p.sysl", ""), dir))
    units.push(parse(source_of("geom/plane/p.sysl", "module geom.plane\n")).program)

    assert(check_locations(found, units).is_empty(), "the two agree")

@test("the module a file contributes to is what its header says, or the anonymous root module")
the_module_a_file_is_in()
    assert_eq(module_written(parse(source_of("a.sysl", "module a.b\n")).program), "a.b")
    assert_eq(module_written(parse(source_of("a.sysl", "f() = ()\n")).program), "")

@test("a compilation reads the library, the packages and the program, and knows which is which")
a_compilation_is_three_things()
    if !library_here() then return

    val root = project_of(pair("main.sysl", "main()\n    print(\"hi\")\n"))
    val made = compilation_of(root, host_target()).unwrap()

    assert(made.units.len() > 100, s"the library is in it: ${made.units.len()} files")
    assert_eq(made.own.len(), 1)
    assert_eq(made.own.at(0), "")
    remove_dir_all(root).unwrap_or(())

@test("a program's own '@tests' file is one of its files, marked rather than dropped")
a_test_file_is_part_of_the_compilation()
    if !library_here() then return

    var shape: Buf[(string, string)] = buf()

    shape.push(("main.sysl", "main()\n    print(\"hi\")\n"))
    shape.push(("tests.sysl", "@tests\n\nf() -> int = 1\n"))

    val root = project_of(shape)
    val made = compilation_of(root, host_target()).unwrap()

    assert_eq(made.own.len(), 2)
    remove_dir_all(root).unwrap_or(())

@test("a directory holding no sysl is not a program, and says so before anything is parsed")
an_empty_directory_is_not_a_program()
    val root = project_of(pair("README.md", "nothing here\n"))
    val said = compilation_of(root, host_target()).unwrap_err()

    assert(said.message.index_of("holds no sysl source files").is_some(), said.message)
    remove_dir_all(root).unwrap_or(())

// A capability the manifest does not mention is provided, so what a project asks for is unmet only
// where the same file has taken it away -- which is the rule `unmet_requirement` is held to, tested
// at its own seam in `tests_manifest.sysl`. What this adds is that the refusal stops the build
// before a line of source is read.
@test("what a package cannot be built without stops the build before a line of it is read")
an_unmet_requirement_stops_a_build()
    val root = project_of(pair("package.hocon",
                               "capabilities { os = false }\nrequires { os = true }\n"))
    val board = target_named("aarch64-freestanding").unwrap()
    val said = compilation_of(root, board).unwrap_err()

    assert(said.message.index_of("requires 'os'").is_some(), said.message)
    remove_dir_all(root).unwrap_or(())

// **A vendored directory is the cache moved into the project**, so a package put there by hand is a
// package already fetched -- which is what lets a driver-level assertion about the package layer be
// made with nothing reaching the network.
@test("a dependency the project vendored is read, and its modules are what the program imports")
a_vendored_dependency_is_read()
    var shape: Buf[(string, string)] = buf()

    shape.push(("package.hocon",
                "dependencies { side { git = \"github.com/e/side\", version = \"1.2.3\" } }\n"))
    shape.push(("vendor/github.com/e/side/@v1.2.3/package.hocon",
                "package { name = \"side\", version = \"1.2.3\" }\n"))
    shape.push(("vendor/github.com/e/side/@v1.2.3/side/side.sysl",
                "module side\n\ntwice(n: int) -> int = n * 2\n"))
    shape.push(("main.sysl", "import side.twice\n\nmain()\n    print(twice(2))\n"))

    val root = project_of(shape)

    val built = compilation_of(root, host_target()) match
        Err(refusal) ->
            assert(false, refusal.message)
            return
        Ok(got) -> got

    var found = false

    for i in 0..<built.units.len()
        if built.units.at(i).src.name.ends_with("side.sysl") then found = true

    assert(found, "the vendored package's source is part of the compilation")
    remove_dir_all(root).unwrap_or(())
end a_vendored_dependency_is_read

@test("a manifest naming a machine this compiler has no entry for is refused as itself")
an_unknown_target_is_refused()
    var shape: Buf[(string, string)] = buf()

    shape.push(("package.hocon", "targets { default = \"pdp11-unix\" }\n"))
    shape.push(("main.sysl", "main()\n    print(\"hi\")\n"))

    val root = project_of(shape)
    val said = emit_typed_text(root, None, false) match
        Err(refusal) -> refusal.message
        Ok(_) -> ""

    assert(said != "", "a machine nobody has is not guessed at")
    remove_dir_all(root).unwrap_or(())

// **A floor states the oldest *released* compiler a package builds with, and this compiler has never
// been released under that line** -- it reports 0.0.1 and is numbered from its own beginning. So it
// makes no claim, which is the reference's own answer for a version it cannot read as a release, and
// a project stating any floor at all is read rather than turned away. The refusal itself is still
// what it was: the test below asks `check_floor` directly, which is the seam a compiler that *is* on
// the line uses.
@test("a floor makes no claim against a compiler that is not on the line floors are written against")
a_floor_makes_no_claim_here()
    var shape: Buf[(string, string)] = buf()

    shape.push(("package.hocon", "package { name = \"later\", version = \"1.0.0\", sysl = \"99.0.0\" }\n"))
    shape.push(("main.sysl", "main()\n    print(\"hi\")\n"))

    val root = project_of(shape)

    assert(floor_refusal("'later' 1.0.0", "99.0.0").is_none(), "nothing to compare it against")
    assert_eq(check_floor("'later' 1.0.0", "99.0.0", "0.0.113").unwrap(),
              "'later' 1.0.0 cannot be built because it requires sysl 99.0.0 or newer, while the " +
              "compiler in hand is 0.0.113")

    val said = emit_typed_text(root, None, false) match
        Err(refusal) -> refusal.message
        Ok(_) -> ""

    assert_eq(said, "")
    remove_dir_all(root).unwrap_or(())

@test("the declaration tables of a program hold the program's rows and not the library's")
the_tables_are_the_programs_own()
    if !library_here() then return

    val root = project_of(pair("main.sysl", "add(a: int, b: int) -> int = a + b\n"))

    emit_typed_text(root, None, true) match
        Err(refusal) -> assert(false, refusal.message)
        Ok(emitted) ->
            assert(emitted.text.index_of("  add(a: int, b: int) -> int").is_some(), emitted.text)
            assert(emitted.text.index_of("sysl.buf").is_none(),
                   "the library's rows are not this program's")

    remove_dir_all(root).unwrap_or(())

@test("the typed tree of a whole program holds the library's own bodies as well as the program's")
the_tree_holds_the_librarys_bodies()
    if !library_here() then return

    val root = project_of(pair("main.sysl", "main()\n    print(\"hi\")\n"))

    emit_typed_text(root, None, false) match
        Err(refusal) -> assert(false, refusal.message)
        Ok(emitted) ->
            assert(emitted.text.index_of("name: \"main\"").is_some(), "the program's own")
            assert(emitted.text.index_of("name: \"sysl$prints\"").is_some(),
                   "and the library function 'print' desugared into")

    remove_dir_all(root).unwrap_or(())

@test("a tree is walked from an absolute root, so every file is named from the root of the filesystem")
a_tree_names_its_files_absolutely()
    var shape: Buf[(string, string)] = buf()

    shape.push(("a.sysl", "f() -> int = 1\n"))

    val root = project_of(shape)
    val found = collect(root, None).unwrap()

    assert_eq(found.len(), 1)
    assert(found.at(0).src.name.starts_with("/"), found.at(0).src.name)

@test("and naming a single file keeps the path the reader wrote")
a_named_file_keeps_its_path()
    var shape: Buf[(string, string)] = buf()

    shape.push(("a.sysl", "f() -> int = 1\n"))

    val root = project_of(shape)
    val found = collect(s"$root/a.sysl", None).unwrap()

    assert_eq(found.len(), 1)
    assert_eq(found.at(0).src.name, s"$root/a.sysl")

@test("a '.' and a '..' are resolved away and no symlink is followed")
an_absolute_path_is_textual()
    assert_eq(absolute_path("/a/b/../c/./d"), "/a/c/d")
    assert_eq(absolute_path("/"), "/")

@test("a compilation holds its '@tests' files, and marks what they declare")
a_compilation_holds_its_tests_files()
    if !library_here() then return

    var shape: Buf[(string, string)] = buf()

    shape.push(("package.hocon", "package {\n  name = \"probe\"\n}\n"))
    shape.push(("a.sysl", "helper() -> int = 1\n\nmain() -> unit = ()\n"))
    shape.push(("tests_a.sysl", "@tests\n\nscaffolding() -> int = helper()\n"))

    val root = project_of(shape)
    val out = emit_typed_text(root, None, false)

    assert(out.is_ok(), "the program compiles")

    val text = out.unwrap().text

    assert(text.index_of("\"scaffolding\"").is_some(), "the test file's body is analyzed")
    assert(text.index_of("testOnly: [\"scaffolding\"]").is_some(),
           "and what it declares is marked as scaffolding")

@test("a program carries its entry point, and the arguments the platform fills")
a_program_carries_its_entry()
    if !library_here() then return

    var shape: Buf[(string, string)] = buf()

    shape.push(("package.hocon", "package {\n  name = \"probe\"\n}\n"))
    shape.push(("a.sysl", "main(args: []string) -> unit = ()\n"))

    val root = project_of(shape)
    val text = emit_typed_text(root, None, false).unwrap().text

    assert(text.index_of("entry: TEntry").is_some(), text_head(text))
    assert(text.index_of("func: \"main\"").is_some(), text_head(text))
    assert(text.index_of("argsFn: \"sysl.args$args_of\"").is_some(), text_head(text))

@test("and the tests it declared, each with the hooks its own module wrote")
a_program_carries_its_tests()
    if !library_here() then return

    var shape: Buf[(string, string)] = buf()

    shape.push(("package.hocon", "package {\n  name = \"probe\"\n}\n"))
    shape.push(("a.sysl", "@test(\"it holds\")\nit_holds() -> unit = ()\n\nmain() -> unit = ()\n"))

    val root = project_of(shape)
    val text = emit_typed_text(root, None, false).unwrap().text

    assert(text.index_of("- TTest").is_some(), text_head(text))
    assert(text.index_of("display: \"it holds\"").is_some(), text_head(text))
    assert(text.index_of("func: \"it_holds\"").is_some(), text_head(text))

@test("two files that each keep a helper of one spelling to themselves get a key each")
two_private_helpers_of_one_name()
    var shape: Buf[(string, string)] = buf()

    shape.push(("package.hocon", "package {\n  name = \"probe\"\n}\n"))
    shape.push(("m/a.sysl", "module m\n\nprivate pick() -> int = 1\n\nfrom_a() -> int = pick()\n"))
    shape.push(("m/b.sysl", "module m\n\nprivate pick() -> int = 2\n\nfrom_b() -> int = pick()\n"))

    val root = project_of(shape)
    val text = emit_typed_text(root, None, false).unwrap().text

    assert(text.index_of("\"m$pick\"").is_some(), "the first file keeps the plain key")
    assert(text.index_of("\"m$pick.private1\"").is_some(), "and the second takes a slot of its own")

private text_head(text: string) -> string =
    if text.bytes.len < 400 then text else text[0..<400]

@test("a directory project's binary is named for the package and written inside the root")
a_directory_project_is_named_for_its_package()
    var shape: Buf[(string, string)] = buf()

    shape.push(("package.hocon", "package {\n  name = \"sqlite-repl\"\n}\n"))
    shape.push(("main.sysl", "print(1)\n"))

    val root = project_of(shape)

    assert_eq(default_executable(root), s"$root/sqlite-repl")

    // A root that names no package is named for the directory it is, which is what a project with
    // no manifest still has.
    var bare: Buf[(string, string)] = buf()

    bare.push(("main.sysl", "print(1)\n"))

    val plain = project_of(bare)

    assert_eq(default_executable(plain), s"$plain/${basename(plain)}")

@test("and a single file's binary is the file's own name with the extension taken off")
a_single_file_is_named_for_itself()
    assert_eq(default_executable("hello.sysl"), "./hello")
    assert_eq(default_executable("a/b/hello.lsysl"), "./hello")
