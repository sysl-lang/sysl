module sh.sysl.compiler

import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}

// Which written argument fills which parameter -- by position, then by the name a call wrote --
// and a parameter's default standing where no argument was written
// (`reference/declarations.md § Default parameters and named arguments`).
//
// **Every call form that reaches a declaration with named parameters binds through here**: a
// function, a nested function, an `extern` and a variant's payload alike, so the arity check, the
// type check and the emitter all see the call written out in full and in declared order.

// What a named argument is told where nothing it could name is being called.
named_nowhere(name: string) -> string =
    s"'$name = …' names an argument, and this is not a call to a declaration that names its " +
    s"parameters — write the value on its own, or '($name = …)' for the assignment"

// A call through a value -- a `&Fn`, a function's address -- carries types and no names, so a name
// written there has nothing to be matched against. Says so about the first one and answers whether
// there was one.
refuse_named_args(cx: &Analyzer, args: Buf[Expr]) -> bool
    for i in 0..<args.len()
        *args.at(i).kind match
            NamedArg(name, _) ->
                cx.fault(args.at(i).span, named_nowhere(name))
                return true
            _ -> ()

    false
end refuse_named_args

// Slots for a parameter list, one per parameter, holding what the call wrote there, or `None` where
// a refusal has been made. A parameter nothing filled must have a default.
bind_params(cx: &Analyzer, span: Span, subject: string, params: Buf[Param], variadic: bool,
            written_args: Buf[Expr], report: bool) -> Option[Buf[Option[Expr]]]
    val before = cx.an.complaints()
    val args = pack_rest(cx, subject, params, written_args, report)

    // A tail written wrongly has been told so, and the packed tail placed beside a name that also
    // named the rest parameter would be reported a second time as a parameter given twice.
    if cx.an.complaints() > before then return None

    var names: Buf[string] = buf()

    for i in 0..<params.len()
        names.push(params.at(i).name)

    var slots: Buf[Option[Expr]] = buf()
    val placed = place_by_name(cx, subject, names, args, report, &slots)

    if placed.is_none() then return None

    val extra = placed.unwrap()
    var missing = false
    var named_seen = false

    for i in 0..<params.len()
        if slots.at(i).is_none() && params.at(i).default.is_none() then missing = true

    for i in 0..<args.len()
        if is_named(args.at(i)) then named_seen = true

    // A variadic definition reads whatever follows its parameters through `va_start`, so arguments
    // past the last one are its tail rather than a miscount.
    if missing || (extra > 0 && !variadic)
        if report then
            cx.fault(span, arity_refusal(subject, params, args, slots, named_seen, extra, variadic))
        else
            cx.fault(span, "wrong arity")

        return None
    end if

    Some(slots)
end bind_params

// A variant's payload fields, which a call may name as it names a function's parameters: the
// arguments put back into the order the fields were declared in. **A field nothing filled is NAMED**,
// as a function's parameter is where the arguments chose their own slots — a count would not say
// which one was left out. Where arguments also ran past the end, the count the caller checks next is
// what answers.
by_field_name(cx: &Analyzer, span: Span, subject: string, fields: Buf[(string, Type)],
              args: Buf[Expr]) -> Option[Buf[Expr]]
    var any = false

    for i in 0..<args.len()
        if is_named(args.at(i)) then any = true

    if !any then return Some(args)

    var names: Buf[string] = buf()

    for i in 0..<fields.len()
        names.push(fields.at(i).0)

    var slots: Buf[Option[Expr]] = buf()

    val extra = place_by_name(cx, subject, names, args, true, &slots)

    if extra.is_none() then return None

    if extra.unwrap() == 0
        for i in 0..<slots.len()
            if slots.at(i).is_none()
                cx.fault(span, s"$subject was given no value for '${names.at(i)}', and that parameter " +
                         "declares no default")
                return None
    end if

    var out: Buf[Expr] = buf()

    for i in 0..<slots.len()
        if slots.at(i).is_some() then out.push(slots.at(i).unwrap())

    Some(out)
end by_field_name

// Places each argument at the parameter it fills: the positional ones in order, then each named one
// at the parameter it names. A name is written after every positional argument, may name only a
// parameter no positional argument filled, and may name it once -- each checked in that order, the
// first refusal being the one reported. Answers how many positional arguments ran past the last
// parameter, or `None` where it refused.
private place_by_name(cx: &Analyzer, subject: string, names: Buf[string], args: Buf[Expr],
                      report: bool, slots: *Buf[Option[Expr]]) -> Option[usize]
    for i in 0..<names.len()
        slots.push(None)

    // **A trailing block is a written argument with no position of its own**, so it is set aside
    // before any rule below reads a position: a name written before it must not strand it, since
    // `column(spacing = 4):` is exactly what a caller reaches for. It is placed last, below.
    var n = args.len()
    val has_block = n > 0 && is_block(args.at(n - 1))

    if has_block then n -= 1

    // A named argument gives up its position, so nothing after one has a position left to mean
    // anything. Told at the positional argument, since that is the one to move.
    var first_named = n

    for i in 0..<n
        if first_named == n && is_named(args.at(i)) then first_named = i

    for i in first_named..<n
        if !is_named(args.at(i))
            cx.fault(args.at(i).span, if !report then "misplaced argument" else
                     "this argument comes after one written by name, so there is no position left " +
                     "for it to stand at — give it its parameter's name too")
            return None
    end for

    var extra: usize = 0

    for i in 0..<first_named
        if i < names.len() then slots.set(i, Some(args.at(i))) else extra += 1

    for i in first_named..<n
        val a = args.at(i)

        *a.kind match
            NamedArg(name, value) ->
                val idx = index_of_name(names, name)

                if idx < 0
                    cx.fault(a.span, if !report then "no such parameter" else
                             s"$subject declares no parameter named '$name'${names_phrase(names)}")
                    return None
                end if

                if usize(idx) < first_named
                    cx.fault(a.span, if !report then "given by position" else
                             s"'$name' was already given by position, so this is a second value " +
                             "for one parameter")
                    return None
                end if

                if slots.at(usize(idx)).is_some()
                    cx.fault(a.span, if !report then "given twice" else s"'$name' is given twice")
                    return None
                end if

                slots.set(usize(idx), Some(value))
            _ -> ()

    // **The block fills the first parameter no written argument filled** — the last argument
    // wherever the call wrote no names. With every parameter already written it is one argument
    // too many, and the arity refusal says so.
    if has_block
        var free: int = -1

        for i in 0..<slots.len()
            if free < 0 && slots.at(i).is_none() then free = int(i)

        if free < 0 then extra += 1 else slots.set(usize(free), Some(args.at(n)))
    end if

    Some(extra)
end place_by_name

// The parameters a declaration takes, as a refusal lists them -- nothing at all where it takes none.
private names_phrase(names: Buf[string]) -> string
    if names.is_empty() then return ""

    var out = " — it takes "

    for i in 0..<names.len()
        if i > 0 then
            out = out + (if i + 1 == names.len() then " and " else ", ")

        out = out + s"'${names.at(i)}'"

    out
end names_phrase

private is_named(e: Expr) -> bool = *e.kind match
    NamedArg(_, _) -> true
    _ -> false

private is_block(e: Expr) -> bool = *e.kind match
    BlockArg(_) -> true
    _ -> false

private index_of_name(names: Buf[string], name: string) -> int
    for i in 0..<names.len()
        if names.at(i) == name then return int(i)

    -1
end index_of_name

// A parameter's default, spliced in where the argument was not written. It is analyzed in the
// declaration's own terms and with nothing local in scope, which is what makes it mean the same thing
// from every module that calls the function -- and what makes a default of `__LINE__` name the
// caller's line.
//
// **Filling one may call the declaration that asked for it**, directly or through another default,
// and following that would never end: `owner` is held while its default is read, and a call that
// asks for it again is refused rather than recursed into.
fill_default(cx: &Analyzer, span: Span, owner: string, scope: Scope, p: Param, want: Type) -> TExpr =
    fill_default_in(cx, span, owner, scope, p, want, false)

// A nested function's default. It is read with nothing local in scope like any other, and the block
// it is written in goes with it: a local that block binds is the one name such a default is likely
// to have meant, and the refusal says why it could not be reached.
fill_nested_default(cx: &Analyzer, span: Span, owner: string, p: Param, want: Type) -> TExpr =
    fill_default_in(cx, span, owner, cx.scope, p, want, true)

private fill_default_in(cx: &Analyzer, span: Span, owner: string, scope: Scope, p: Param, want: Type,
                        carry: bool) -> TExpr
    if holds_string(cx.an.defaults_filling, owner)
        cx.fault(span, "filling this default calls something that asks for it again — a default " +
                 "cannot stand in for an argument that is still being worked out")
        return bad_expr(span)
    end if

    val inner = analyzer_for(cx.an, scope)

    inner.reported = Some(span)
    inner.here_src = caller_source(cx)

    if carry then carry_declares(cx, inner)

    cx.an.defaults_filling.push(owner)

    val t = type_expr(inner, p.default.unwrap(), Some(want))

    cx.an.defaults_filling.truncate(cx.an.defaults_filling.len() - 1)
    t
end fill_default_in
