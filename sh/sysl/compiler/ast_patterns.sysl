module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// A pattern, with where it was written.
struct Pattern
    span: Span
    kind: &PatKind
end Pattern

// What a pattern matches.
enum PatKind
    // `1`, `'x'`, `"s"`, `true`, `-3` -- a literal, held as the expression that spells it.
    LitPattern(value: Expr)

    // `1..9` and `1..<9`.
    RangePattern(lo: Expr, hi: Expr, inclusive: bool)

    // `_`.
    WildcardPattern

    // A bare name: it binds whatever stood there, or names a variant that takes no fields.
    IdentPattern(name: string)

    // `` `n` `` -- a quoted name, which is a *reference* to what that name already holds rather
    // than a binding of it. The quoting is the whole of the difference.
    EqPattern(name: string)

    // `Circle(r)`.
    VariantPattern(name: string, args: Buf[Pattern])

    // `Point { x, y: b }`.
    StructPattern(name: string, fields: Buf[FieldPattern])

    // `(a, b)` -- two or more parts.
    TuplePattern(args: Buf[Pattern])

    // `n @ 1..9` -- a name bound to whatever the inner pattern matched.
    BindPattern(name: string, inner: Pattern)
end PatKind

// One field of a struct pattern. `Point { x }` is the field `x` against `IdentPattern("x")`, which
// is what makes the short form the long one with the name written once.
struct FieldPattern
    name: string
    pat: Pattern
end FieldPattern

// One arm of a `match`: the patterns it answers for, the guard that further narrows them, and the
// body it runs.
//
// `patterns` holds the `|`-alternatives, which share one answer and so may bind nothing.
struct MatchArm
    span: Span
    patterns: Buf[Pattern]
    guard: Option[Expr]
    body: Buf[Stmt]
end MatchArm

pattern_of(span: Span, kind: PatKind) -> Pattern = Pattern(span, kind)
