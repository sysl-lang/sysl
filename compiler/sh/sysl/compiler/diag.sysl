module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.{str_builder, Search}

// What the analyzer says, and how a compilation's worth of it is printed.
//
// **A diagnostic and its rendering are `sh.sysl.parsing`'s**, because every reader in the org wants
// the same `-->`, the same quoted line and the same caret. What is here is the part that is this
// compiler's: which **file** a complaint is about, in what order a compilation's complaints are
// read, and how many of them are shown.
//
// **A complaint carries its source rather than an index into a list of them**, which is the
// reference compiler's `Pos` and is what lets a diagnostic be rendered by whoever is holding it. An
// analysis reads many files at once, so a span alone says nothing.

// One complaint, and the file it is about.
//
// **A complaint about the program as a whole has no place in it** (`at_place` false): two exports
// claiming one C name collide in the header, not at either declaration, so the reference prints the
// message alone -- no `-->` line, no quoted source, no caret. Its span is still kept, since a
// report is ordered by where its complaints sit.
struct Placed
    src: Source
    diag: Diagnostic
    at_place: bool

    is_error(self) -> bool = self.diag.is_error()

    // The whole thing rendered against the file it is about. **The column is the document's**: a
    // literate file's source is the tangled program, four columns short of what the reader has open,
    // so the `-->` line adds them back, and the quoted line and caret stay the text that was read --
    // which is what the reference prints.
    render(self) -> string
        if !self.at_place
            val kind = if self.is_error() then "error" else "warning"

            return s"$kind: ${self.diag.message}\n"

        self.diag.render(self.src, literate_shift(self.src))
    end render

    // Where it is, in the one-line form a build log wants.
    location(self) -> string
        if !self.at_place then return self.src.name

        val at = self.src.locate(self.diag.span.start)

        s"${self.src.name}:${at.line}:${at.col + literate_shift(self.src)}"
    end location
end Placed

// A complaint as the parsing package hands it out, about a place in a file.
placed_at(src: Source, d: Diagnostic) -> Placed = Placed(src, d, true)

// An error about a place in a file.
//
// **A declaration is named by its qualified name, module and all** -- `'m.P.get'`, `'sysl.Result'`
// -- never by the key a table holds it under, and this is where that is settled for every
// complaint the analysis makes (`readable_keys`).
placed_error(src: Source, span: Span, message: string) -> Placed =
    Placed(src, error(span, readable_keys(message)), true)

// An error about the program as a whole, which is rendered with no position at all. `span` only
// orders it among the rest of the report.
unplaced_error(src: Source, span: Span, message: string) -> Placed =
    Placed(src, error(span, readable_keys(message)), false)

// A warning about one, which is not a reason to stop.
placed_warning(src: Source, span: Span, message: string) -> Placed =
    Placed(src, Diagnostic(Warning, span, readable_keys(message), "", ""), true)

// How many errors one compilation reports.
//
// Five is already more than anyone fixes before compiling again, and the further down a broken file
// a diagnostic is, the likelier it is to be a consequence of one further up rather than a mistake of
// its own. A wall of them is not more information.
//
// **It is the renderer's rule and not the list's.** A caller reading diagnostics as data wants all
// of them -- an editor underlines every mistake in the file, and five would leave the rest unmarked
// -- so nothing truncates until the report does.
const DiagnosticLimit: usize = 5

// The order a reader reads a compilation in: by file, then by line, then by column.
//
// Every pass that collects more than one owes this, so it lives here rather than in whichever pass
// happened to need it first. **Two complaints about one place keep the order they were made in**,
// which is the order that reads as an explanation.
in_source_order(all: Buf[Placed]) -> Buf[Placed]
    var order: Buf[(string, usize, usize)] = buf()

    for i in 0..<all.len()
        order.push((all.at(i).src.name, all.at(i).diag.span.start, i))

    var out: Buf[Placed] = buf()
    var taken: Buf[bool] = buf()

    for _i in 0..<all.len()
        taken.push(false)

    for _n in 0..<all.len()
        var best = all.len()

        for i in 0..<all.len()
            if !taken.at(i) then
                if best == all.len() then best = i
                else if earlier(order.at(i), order.at(best)) then best = i

        taken.set(best, true)
        out.push(all.at(best))

    out
end in_source_order

private earlier(a: (string, usize, usize), b: (string, usize, usize)) -> bool
    if a.0 != b.0 then return a.0 < b.0
    if a.1 != b.1 then return a.1 < b.1

    a.2 < b.2
end earlier

// One rendering, without the newline that ended it.
//
// **A report is what a caller PRINTS, and printing supplies the last newline**, so a rendering that
// keeps its own leaves a blank line behind every report and two blank lines between any pair of
// them. The reference separates one diagnostic from the next by exactly one blank line and ends the
// last one at its caret; the newline is dropped here rather than in the renderer, which is the
// parsing package's and is right to end a diagnostic it hands out on its own.
private ended(where: Placed) -> string = ended_text(where.render())

private ended_text(text: string) -> string = if text.ends_with("\n") then text[0..<text.bytes.len - 1] else text

// A compilation's diagnostics, assembled: at most the limit of them, separated by a blank line, with
// a closing count where there were more. The ones kept are the **first** -- the list arrives in
// source order, and an error early in a file is the one worth reading.
analysis_report(all: Buf[Placed]) -> string
    val ordered = in_source_order(all)
    var b = str_builder()
    val shown = if ordered.len() < DiagnosticLimit then ordered.len() else DiagnosticLimit

    for i in 0..<shown
        if i > 0 then b.push("\n\n")

        b.push(ended(ordered.at(i)))

    if ordered.len() > DiagnosticLimit then
        b.push(s"\n\nshowing the first ${DiagnosticLimit} of ${ordered.len()} errors")

    b.finish()
end analysis_report

// One warning, as a compilation that succeeded prints it: the same shape an error has, with no
// blank line after it -- the reference prints each on its own, one under the next.
warning_report(where: Placed) -> string = ended(where)

// A file that did not parse, reported in the one shape every error has: `error:`, the `-->` line,
// the quoted line and a caret. **Every line recovery could not read is reported**, in source order
// and separated by a blank line, as the reference's build is handed them: the first is the grammar's
// own reaction, and each after it a line further down that recovery skipped. **A line is reported
// once**: a complaint on the line of the one before it is the same mistake's echo (`(1 +` at the end
// of a file is an expression and a `)` both missing at one point), which the reference, recovering a
// statement at a time, never says twice. Each **points at a position rather than an extent**: the
// caret covers the token that begins there, which is what the reference underlines, and is one
// column wide where no written token does -- at a line's layout, the end of the file, or inside a
// token the lexer itself refused -- and where the conditional gate refused a line (`Parsed.pointed`),
// whose position is a column of a line rather than a token. **The column is shifted by the `Parsed`'s own `col_shift`**, not
// asked of the file's name: a literate file's tangle refusal (an unclosed fence, a tab in the
// indent) is placed in the DOCUMENT, which nothing removed four columns from.
parse_report(p: Parsed) -> string
    var b = str_builder()
    var last_line: usize = 0

    for i in 0..<p.report.len()
        val d = p.report.at(i)
        val line = p.src.locate(d.span.start).line

        if i > 0 && line <= last_line then continue

        if i > 0 then b.push("\n\n")

        last_line = line
        val at = if p.pointed then point(d.span.start)
        else token_at(p.src, d.span.start, d.message == "dedent expected")

        b.push(ended_text(error(at, d.message).render(p.src, p.col_shift)))

    b.finish()
end parse_report

// The written token that begins at `at`, or the point itself where none does. **An indent or a
// dedent in front of a line's first word starts where the word does and is stepped over**, the
// complaint being about the word -- `^^^^^^` under a stray `123456` after a block has closed, or as
// a body's first line. The one exception is an indent that was itself the complaint: a line
// indented where nothing opened a block is `dedent expected` AT the indent, and the reference draws
// that one column wide rather than under the word (`indent_complained`). A line's end and the end
// of the file are one column too.
private token_at(src: Source, at: usize, indent_complained: bool) -> Span
    val tokens = lex(src) match
        Ok(ts) -> ts
        Err(_) -> return point(at)

    for t in tokens
        if t.span.start == at
            if t.value == Indent && indent_complained then return point(at)
            if is_layout(t.value) then continue
            if t.value == Eof || t.span.end <= at then return point(at)

            return t.span
        end if

    point(at)
end token_at

// The tokens a line's layout makes, stepped over on the way to the word they stand in front of. A
// block that closes is a `Dedent` and a `Newline` both placed at the next line's first word, while a
// line's own `Newline` sits at its end, where no word begins -- which is what leaves that one a point.
private is_layout(t: Tok) -> bool = t match
    Newline -> true
    Indent -> true
    Dedent -> true
    _ -> false

// A note rather than a complaint: the location first, in the one-line form a build log wants, since
// these are printed by the handful and not read one at a time.
explain(msg: string, where: Placed) -> string = s"${where.location()}: $msg"

// Whether anything in a list is an error, which is what decides an exit status -- a list of
// warnings alone is a successful run.
any_errors(all: Buf[Placed]) -> bool
    for item in all
        if item.is_error() then return true

    false
end any_errors

// The errors of a list, and the warnings, kept apart because they are answered differently.
errors_of(all: Buf[Placed]) -> Buf[Placed]
    var out: Buf[Placed] = buf()

    for item in all
        if item.is_error() then out.push(item)

    out
end errors_of

warnings_of(all: Buf[Placed]) -> Buf[Placed]
    var out: Buf[Placed] = buf()

    for item in all
        if !item.is_error() then out.push(item)

    out
end warnings_of
