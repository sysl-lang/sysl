@test("the recursive division agrees with algorithm D, and with the identity, across its threshold")
recursive_division_against_algorithm_d()
    var g = rng(42, 17)
    val sizes = sizes_around(dc_threshold)

    for bn in sizes
        if bn < 2 then continue

        for extra in [dc_threshold - 1, dc_threshold, dc_threshold + 3, bn, bn * 2 + 5]
            val a = random_big(&g, bn + extra, false)
            val b = random_big(&g, bn, false)
            val (q, r) = divmod_mag(a.mag, b.mag)
            val (lq, lr) = long_divide(a.mag, b.mag)

            assert_eq(cmp_mag(q, lq), 0)
            assert_eq(cmp_mag(r, lr), 0)
            assert(cmp_mag(r, b.mag) < 0)
            assert_eq(add(mul(normalized(false, q), b), normalized(false, r)), a)
end recursive_division_against_algorithm_d

@test("a quotient of every limb set takes the recursive division's capped guess at every level")
recursive_division_capped_guess()
    var g = rng(9, 9)

    // `b B^m - 1` over `b` is `B^m - 1` with remainder `b - 1`: every quotient limb is the largest
    // there is, so the top of each partial dividend equals the divisor's top and the guess has to be
    // capped rather than divided for.
    for bn in [dc_threshold, dc_threshold * 2 + 1, dc_threshold * 4 - 3]
        val b = random_big(&g, bn, false)

        for m in [dc_threshold, bn + 1, bn * 2]
            val a = sub(shl(b, m * limb_bits), one())
            val (q, r) = div_rem(a, b)

            assert_eq(q, sub(shl(one(), m * limb_bits), one()))
            assert_eq(r, sub(b, one()))
end recursive_division_capped_guess

@test("division by a single limb takes every normalization shift")
short_division_shifts()
    var g = rng(3, 1)
    val a = random_big(&g, 30, false)

    for s in 0..<limb_bits
        val d = Limb(1) << s | Limb(g.next_u64()) >> (limb_bits - s)

        if d == 0 then continue

        val b = normalized(false, mag_of_u64(u64(d)))
        val (q, r) = div_rem(a, b)

        assert_eq(add(naive_mul(q, b), r), a)
        assert(cmp(r, b) < 0)
end short_division_shifts

/** Base ten the slow way: eighteen digits at a time off the bottom with `div_rem_long`, which is a
 * short division and nothing else.
 */
private slow_decimal(x: BigInt) -> string
    var parts: Buf[long] = buf()
    var v = abs(x)

    while !v.is_zero()
        val (q, r) = div_rem_long(v, 1000000000000000000)

        parts.push(r)
        v = q

    if parts.len() == 0 then return "0"

    var out = s"${parts[parts.len() - 1]}"
    var i = parts.len() - 1

    while i > 0
        i -= 1

        val piece = s"${parts[i]}"

        for _ in piece.len..<18 do out = out + "0"
        out = out + piece

    if x.minus then "-" + out else out
end slow_decimal

@test("the divide-and-conquer conversions agree with a digit-chunk loop across their threshold")
text_against_slow()
    var g = rng(77, 2)

    for n in [text_threshold - 1, text_threshold, text_threshold + 1, text_threshold * 2 + 1,
              text_threshold * 7]
        val x = random_big(&g, n, n % 2 == 1)
        val s = to_string(x)

        assert_eq(s, slow_decimal(x))
        assert_eq(parse(s).unwrap(), x)
        assert_eq(parse_radix(to_string_radix(x, 7), 7).unwrap(), x)
        assert_eq(parse_radix(to_string_radix(x, 36), 36).unwrap(), x)
end text_against_slow

@test("a remainder with leading zeros keeps them as digits of the whole")
text_inner_zeros()
    // `10^k` and its neighbours put long runs of zeros wherever a split falls.
    val places: []usize = [800, 1500, 4000]

    for k in places
        val p = pow(from_int(10), k)
        val s = to_string(p)

        assert_eq(s.len, k + 1)
        assert_eq(parse(s).unwrap(), p)
        assert_eq(to_string(add(p, one())), slow_decimal(add(p, one())))
        assert_eq(to_string(sub(p, one())), slow_decimal(sub(p, one())))
end text_inner_zeros

@test("3^50000 has the digits an independent implementation gives")
text_large_pinned()
    // Python's own integers, which share no code with this: 23857 digits, these at each end.
    val s = to_string(pow(from_int(3), 50000))

    assert_eq(s.len, 23857)
    assert_eq(s[0..<25], "1155409630490589891144596")
    assert_eq(s[s.len - 25..], "0618632083774432761000001")
    assert_eq(parse(s).unwrap(), pow(from_int(3), 50000))
end text_large_pinned

/** Euclid the plain way, a full division per step. */
private plain_gcd(a: BigInt, b: BigInt) -> BigInt
    var x = abs(a)
    var y = abs(b)

    while !y.is_zero()
        val r = rem(x, y)

        x = y
        y = r

    x
end plain_gcd

@test("Lehmer's gcd agrees with plain Euclid over generated pairs of every shape")
lehmer_against_plain()
    var g = rng(1234, 8)

    for n in 0..<60
        val an = 1 + usize(n % 13) * 3
        val bn = if n % 4 == 0 then an else 1 + usize(n % 11)
        val c = random_big(&g, 1 + usize(n % 3), false)

        // A shared factor, so the answer is not almost always one.
        val a = mul(random_big(&g, an, n % 2 == 0), c)
        val b = mul(random_big(&g, bn, n % 5 == 0), c)

        assert_eq(gcd(a, b), plain_gcd(a, b))
end lehmer_against_plain

@test("gcd of two Fibonacci numbers is the Fibonacci number at the gcd of their places")
lehmer_fibonacci()
    // Consecutive Fibonacci numbers are Euclid's worst case: every quotient is one, which is the
    // case Lehmer's leading-bit steps take the most of at once.
    var fib: Buf[BigInt] = buf()

    fib.push(zero())
    fib.push(one())

    for i in 2..<4501 do fib.push(add(fib[i - 1], fib[i - 2]))

    assert_eq(gcd(fib[4500], fib[3000]), fib[1500])
    assert_eq(gcd(fib[4500], fib[4499]), one())
    assert_eq(gcd(fib[2310], fib[1001]), fib[77])
end lehmer_fibonacci
