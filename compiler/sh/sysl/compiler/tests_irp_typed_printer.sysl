module sh.sysl.compiler
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.math.bigint.from_int
import sysl.text.{str_builder, Search}

// `sysl emit-typed`'s printer (`show_typed.sysl`, `show_program.sysl`): the typed tree as
// deterministic text in the reference compiler's notation. **The golden text is the reference's
// (0.0.162) `TypedAstPrinterTests` fixture as its printer wrote it**, and its two functions read the
// same in the reference's `emit-typed` of the same file.

private irp_typed_fixture() -> string = raw"""
    struct Point
        x: int
        y: int

    add(a: int, b: int) -> int = a + b

    f(p: Point) -> int =
        if p.x > 0 then add(p.x, p.y) else 0
    """

// The fixture's own declarations, with the standard module's carried by every ordinary compilation
// left out -- which is how the reference's golden was taken.
private irp_typed_program() -> TProgram
    val root = make_temp_dir("sysl-irp-typed").unwrap()
    val file = s"$root/fixture.sysl"

    make_dir_all(root).unwrap()
    write_text(file, irp_typed_fixture()).unwrap()

    val (whole, _) = typed_program(typed_compilation(file, None).unwrap())

    remove_dir_all(root).unwrap_or(())

    var structs: Buf[Type] = buf()
    var funcs: Buf[TFunc] = buf()

    for item in whole.structs
        if type_show(item) == "Point" then structs.push(item)

    for name in ["add", "f"]
        for i in 0..<whole.funcs.len()
            if whole.funcs.at(i).name == name then funcs.push(whole.funcs.at(i))

    TProgram(structs, buf(), buf(), buf(), buf(), funcs, buf(), None, buf(), true, false, buf(), buf(), "",
             buf(), buf(), buf(), buf(), buf(), buf(), buf(), None, buf())
end irp_typed_program

@test("prints the golden text for a small program, exactly, with spans off")
irp_typed_golden()
    if xvr_no_library() then return

    assert_eq(show_typed_program(irp_typed_program()), irp_restore_colons(irp_typed_golden_bare()))

@test("is deterministic: the same tree prints the same text twice")
irp_typed_deterministic()
    if xvr_no_library() then return

    val p = irp_typed_program()

    assert_eq(show_typed_program(p), show_typed_program(p))

private irp_spanned(p: TProgram) -> string
    val was = set_typed_spans(true)
    val text = show_typed_program(p)

    set_typed_spans(was)
    text
end irp_spanned

// `text` with every ` line:col-line:col` taken out.
private irp_strip_spans(text: string) -> string
    var out = ""
    var i: usize = 0

    loop
        if i >= text.len then break

        if text.bytes[i] == u8(' ') && irp_span_at(text, i + 1)
            i += 1

            loop
                if i >= text.len then break

                val c = text.bytes[i]

                if !(c == u8(':') || c == u8('-') || (c >= u8('0') && c <= u8('9'))) then break

                i += 1
        else
            out = out + text[i..<(i + 1)]
            i += 1

    out
end irp_strip_spans

@test("with spans on, an expression's line carries one, as 'line:col-line:col'; with spans off, none does")
irp_typed_spans_on()
    if xvr_no_library() then return

    val p = irp_typed_program()
    val spanned = irp_spanned(p)

    // `if p.x > 0 then add(p.x, p.y) else 0` on line 8, from column 5.
    assert(irp_lines_of_typed("TIf", spanned) == "8", spanned)
    assert(irp_lines_of_typed("TFunc", spanned) == "5, 7", spanned)
    assert(!irp_any_span(show_typed_program(p)), "spans off prints none")

// The command line answers the same: spans by default, none under `--no-spans`.
@test("--no-spans drops spans and nothing else: the two texts agree once spans are stripped")
irp_typed_no_spans_flag()
    if xvr_no_library() then return

    val p = irp_typed_program()
    val spanned = irp_spanned(p)

    assert(irp_any_span(spanned), "the spanned text carries spans")
    assert_eq(irp_strip_spans(spanned), show_typed_program(p))

private irp_lines_of_typed(kind: string, printed: string) -> string
    val lines = irp_lines(printed)
    var out = ""

    for l in lines
        l.index_of(kind + " ") match
            Some(at) ->
                val start = at + kind.len + 1

                if irp_span_at(l, start)
                    var n: usize = 0

                    loop
                        if start + n >= l.len || l.bytes[start + n] == u8(':') then break

                        n += 1

                    val line = l[start..<(start + n)]

                    out = if out == "" then line else s"$out, $line"
            None -> ()

    out
end irp_lines_of_typed

// `int`'s diagnostic spelling is `int`; its structure (`bits`, `signed`) never appears.
@test("an expression's type is the compiler's own diagnostic text, not the type's structure")
irp_typed_type_text()
    if xvr_no_library() then return

    val printed = show_typed_program(irp_typed_program())

    assert(printed.contains("ty: int"), printed)
    assert(!printed.contains("bits: 32"), printed)
    assert(!printed.contains("signed: true"), printed)

@test("--tables is deterministic")
irp_typed_tables_deterministic()
    if xvr_no_library() then return

    val p = irp_typed_program()

    assert_eq(show_tables(p), show_tables(p))

// -- the command line -------------------------------------------------------------------------------

@test("an analysis error exits non-zero, prints the ordinary diagnostic on stderr, and nothing on stdout")
irp_typed_analysis_error()
    if xvr_no_library() then return

    val r = irp_cli("emit-typed", "f(n: int) -> int = n + \"s\"\n")

    assert(r.0 != 0, "the exit code")
    assert_eq(r.1, "")
    assert(r.2.contains("error: "), r.2)

@test("a parse error is reported the same way")
irp_typed_parse_error()
    if xvr_no_library() then return

    val r = irp_cli("emit-typed", "f(n: int -> int\n")

    assert(r.0 != 0, "the exit code")
    assert_eq(r.1, "")
    assert(r.2.contains("error: ')' expected"), r.2)

@test("prints the tree on standard output, with no diagnostic, for a clean file")
irp_typed_clean_file()
    if xvr_no_library() then return

    val r = irp_cli("emit-typed", irp_typed_fixture())

    assert_eq(r.0, 0)
    assert(r.1.contains("TFunc"), "a function is printed")
    assert(r.1.contains("name: \"add\""), "and it is 'add'")
    assert_eq(r.2, "")

// -- every typed node kind is reachable -------------------------------------------------------------

// The reference's 107 -- its `TExpr` (86), `TStmt` (12), `TPattern` (7) and `TCondTerm` (2) -- and the
// nine this tree adds: `TStrView`, `TSlots`, a write as a statement of its own (`TWrite`), the five
// `async` lowers through (`TAwait`, `TBlockOn`, `TYieldNow`, `TStep`, `TPark`), and AArch64's
// system registers and barriers (`TSysOp`), all decided additions the reference has not got.
private irp_typed_kinds() -> []const string = [
    "TIntLit", "TFloatLit", "TStrLit", "TBoolLit", "TUnitLit", "TNullLit", "TBox", "TDowngrade",
    "TUpgrade", "TZero", "TArrayLit", "TArrayFill", "TVectorLit", "TSplat", "TLane", "TVecCompare",
    "TSelect", "TReduce", "TVecLoad", "TVecStore", "TBufLit", "TBufFill", "TIndex", "TLen",
    "TBytes", "TSlice", "TCast", "TConstrainedCheck", "TConstrainedValid", "TConstrainedStep",
    "TLoad", "TResult", "TOld", "TGlobal", "TDeref", "TTypeId", "TAddrOf", "TTempAddr", "TStore",
    "TUpdate", "TIncDec", "TBinary", "TUnary", "TIntOp", "TAtomic", "TFence", "TLogical",
    "TCompare", "TSeq", "TStr", "TFromBytes", "TConstView", "TFormat", "TRender", "TCStrLit",
    "TCall", "TFuncAddr", "TCallPtr", "TErase", "TVCall", "TVaStart", "TVaEnd", "TVaArg", "TVaCopy",
    "TVaPass", "TStructNew", "TStructInvCheck", "TRecheck", "TEnumNew", "TEnumFromInt", "TEnumTry",
    "TEnumAttr", "TTry", "TField", "TIf", "TMatch", "TBlockExpr", "TWhile", "TDoWhile", "TLoop",
    "TFor", "TCFor", "TQuantifier", "TCheckedLoop", "TForEach", "TIterate",
    "TVarDecl", "TExprStmt", "TInvariant", "TVariantCheck", "TRefDecl", "TMultiAssign", "TReturn",
    "TBecome", "TBreak", "TContinue", "TDefer", "TAsm",
    "TWildPattern", "TBindPattern", "TAtPattern", "TLitPattern", "TRangePattern", "TVariantPattern",
    "TStructPattern",
    "TCondTest", "TCondIs",
    "TStrView", "TSlots", "TWrite", "TAwait", "TBlockOn", "TYieldNow", "TStep", "TPark", "TSysOp"]

private irp_t(k: TExprKind) -> TExpr = TExpr(Span(0, 0), k)

private irp_int() -> Type = Integer(32, true, false)

private irp_x() -> TExpr = irp_t(TLoad("x", irp_int()))

private irp_xs() -> Buf[TExpr]
    var out: Buf[TExpr] = buf()

    out.push(irp_x())
    out
end irp_xs

private irp_body() -> Buf[TStmt]
    var out: Buf[TStmt] = buf()

    out.push(TExprStmt(irp_x()))
    out
end irp_body

private irp_blk() -> TBlock = TBlock(irp_body(), Some(irp_x()), irp_int())

private irp_variant() -> EnumVariant = EnumVariant("A", from_int(0), buf(), false)

private irp_struct() -> &StructType = StructType("S", buf(), buf(), false, None, None, false, None)

private irp_pats(p: TPattern) -> Buf[TPattern]
    var out: Buf[TPattern] = buf()

    out.push(p)
    out
end irp_pats

private irp_write() -> TWrite
    var checks: Buf[TInvCheck] = buf()

    checks.push(TInvCheck(irp_x(), irp_struct(), "S$inv"))
    TWrite(irp_x(), "=", irp_x(), Some(TDispatch("add", false, false)), checks, None)
end irp_write

// One expression of every kind, built directly: a real `TAtomic` or `TIterate` would need real
// hardware and a real `Iterate` implementation, which is syntax risk for no benefit -- this is about
// the printer's coverage of the tree, not about what the analyzer accepts.
private irp_every_expr() -> Buf[TExpr]
    val x = irp_x()
    val i = irp_int()
    val v = irp_variant()
    val s = irp_struct()
    var cmps: Buf[TCmp] = buf()
    var cond: Buf[TCondTerm] = buf()
    var arms: Buf[TArm] = buf()
    var out: Buf[TExpr] = buf()

    cmps.push(TCmp("<", None))
    cond.push(TCondTest(x))
    cond.push(TCondIs(x, irp_pats(TWildPattern(i)), false))
    arms.push(TArm(irp_pats(TBindPattern("y", i)), Some(x), irp_blk()))
    arms.push(TArm(irp_pats(TAtPattern("z", TLitPattern(x))), None, irp_blk()))
    arms.push(TArm(irp_pats(TRangePattern(x, x, true)), None, irp_blk()))
    arms.push(TArm(irp_pats(TVariantPattern(i, v, irp_pats(TWildPattern(i)))), None, irp_blk()))
    arms.push(TArm(irp_pats(TStructPattern(s, irp_pats(TWildPattern(i)))), None, irp_blk()))

    for k in [TIntLit(from_int(1), i), TFloatLit(0, Floating(64, false)), TStrLit("s"), TBoolLit(true),
              TUnitLit, TNullLit(Ptr(i)), TBox(x, i), TDowngrade(x, i), TUpgrade(x, i, v, v), TZero(i),
              TArrayLit(irp_xs(), i), TArrayFill(x, i), TVectorLit(irp_xs(), i), TSplat(x, i),
              TLane(x, 0, i), TVecCompare("<", x, x, i), TSelect(x, x, x, i), TReduce("add", x, i),
              TVecLoad(x, x, i), TVecStore(x, x, x), TBufLit(irp_xs(), i), TBufFill(x, x, i),
              TIndex(x, x, i), TLen(x, i), TBytes(x), TSlice(x, Some(x), None, false, i), TCast(x, i),
              TConstrainedCheck(x, i), TConstrainedValid(x, i), TConstrainedStep(x, i, true, i),
              TLoad("x", i), TResult(i), TOld(0, i), TGlobal("g", i, false), TDeref(x, i),
              TTypeId(x, i), TAddrOf(x, i), TTempAddr(x, i), TStore(x, x, i),
              TUpdate(x, "+", x, i, None, None), TIncDec(x, "++", true, i, None), TBinary("+", x, x, i),
              TUnary("-", x, i), TIntOp("count_ones", x, None, i, i),
              TAtomic("load", x, irp_xs(), "seq_cst", i, i), TFence("seq_cst"),
              TSlots("take", irp_xs(), i, i), TSysOp("dsb", "sy", irp_xs()),
              TLogical("&&", x, x), TCompare(irp_xs(), cmps),
              TSeq(irp_xs()), TStr(x), TFromBytes(x), TStrView(x), TConstView(x),
              TFormat(x, "%d", irp_xs()), TRender(x, "fmt", x, None), TCStrLit("s"),
              TCall("f", irp_xs(), i, false), TFuncAddr("f", "f", i), TCallPtr(x, irp_xs(), buf(), i),
              TErase(x, "vt", i), TVCall(x, 0, irp_xs(), i, false), TVaStart(x), TVaEnd(x),
              TVaArg(x, i), TVaCopy(x, x), TVaPass(x), TStructNew(s, irp_xs()),
              TStructInvCheck(x, s, "S$inv"), TRecheck(x, x, s, "S$inv"), TEnumNew(i, v, irp_xs()),
              TEnumFromInt(x, i), TEnumTry(x, i, i, v, v), TEnumAttr("count", i, x, i),
              TTry(x, v, v, i, v, i, None), TAwait(x, i), TBlockOn(x, i), TYieldNow, TStep(x, x),
              TPark(x), TField(x, 0, i), TIf(cond, irp_blk(), Some(irp_blk()), i), TMatch(x, arms, i),
              TBlockExpr(irp_blk()), TWhile(cond, irp_body(), None, i),
              TDoWhile(irp_body(), x, None, i), TLoop(irp_body(), i),
              TFor("k", i, x, x, false, irp_body(), None, i), TCFor(irp_body(), Some(x), irp_body(),
              irp_body(), None, i), TQuantifier(true, "k", i, x, x, false, x),
              TCheckedLoop("slot", i, x), TForEach("k", i, x, irp_body(), None, i),
              TIterate("c", i, x, x, TBindPattern("k", i), irp_body(), None, i)]
        out.push(irp_t(k))

    out
end irp_every_expr

// One statement of every kind, every expression above as a statement of its own.
private irp_every_stmt() -> Buf[TStmt]
    val x = irp_x()
    val i = irp_int()
    val exprs = irp_every_expr()
    var out: Buf[TStmt] = buf()
    var writes: Buf[TWrite] = buf()
    var operands: Buf[TAsmOperand] = buf()
    var lines: Buf[string] = buf()

    writes.push(irp_write())
    operands.push(TAsmOperand(In, "a", "a.1", i, None))
    lines.push("nop")

    for expr in exprs
        out.push(TExprStmt(expr))

    out.push(TVarDecl("v", i, x, None))
    out.push(TInvariant(x, None))
    out.push(TVariantCheck("slot", i, x))
    out.push(TRefDecl("r", i, x))
    out.push(TWriteStmt(irp_write()))
    out.push(TMultiAssign(writes))
    out.push(TReturn(Some(x)))
    out.push(TBecome(x))
    out.push(TBreak(None, 0))
    out.push(TContinue(0))
    out.push(TDefer(irp_body()))
    out.push(TAsm(lines, operands, buf(), Span(0, 0)))
    out
end irp_every_stmt

private irp_typed_coverage() -> string
    var out = str_builder()

    show_typed_stmt_list(&out, "", "body", irp_every_stmt())
    out.finish()
end irp_typed_coverage

@test("the reference count is 107, the same total the typed-tree files themselves grep to")
irp_typed_reference_count()
    val kinds = irp_typed_kinds()

    // 107 of the reference's and the nine this tree adds, every one named once.
    assert_eq(kinds.len, 116)

    for i in 0..<kinds.len
        for j in (i + 1)..<kinds.len
            assert(kinds[i] != kinds[j], kinds[i])

@test("the reachable set is exactly the 107 node kinds the typed tree can hold")
irp_typed_every_kind_reachable()
    val printed = irp_typed_coverage()
    val kinds = irp_typed_kinds()
    var missing = ""

    for i in 0..<kinds.len
        if !irp_holds_word(printed, kinds[i]) then missing = missing + kinds[i] + " "

    assert_eq(missing, "")
    // And nothing fell through to the printer's catch-all.
    assert(!printed.contains("TUnprinted"), "a node the printer does not know")
end irp_typed_every_kind_reachable

// The reference's golden, written without the trailing space a field name with children ends in.
private irp_typed_golden_bare() -> string = raw"""
    TProgram
      structs: [Point]
      enums: []
      vtables: []
      externs: []
      vals: []
      funcs:
        - TFunc
            name: "add"
            params:
              - Tuple2
                  _1: "a"
                  _2: int
              - Tuple2
                  _1: "b"
                  _2: int
            retTy: int
            body: TBlock
              stmts: []
              result: TBinary
                op: "+"
                left: TLoad
                  name: "a"
                  ty: int
                right: TLoad
                  name: "b"
                  ty: int
                ty: int
              ty: int
            variadic: false
            requires: []
            ensures: []
            olds: []
            internal: false
            conv: None
            tailrec: false
            variant: None
            pure: false
            ghost: false
            reads: None
            writes: None
            exported: None
            section: None
            noinline: false
            cold: false
            inline: false
            module: ""
        - TFunc
            name: "f"
            params:
              - Tuple2
                  _1: "p"
                  _2: Point
            retTy: int
            body: TBlock
              stmts: []
              result: TIf
                cond:
                  - TCondTest
                      cond: TCompare
                        operands:
                          - TField
                              receiver: TLoad
                                name: "p"
                                ty: Point
                              index: 0
                              ty: int
                          - TIntLit
                              value: 0
                              ty: int
                        cmps:
                          - TCmp
                              op: ">"
                              dispatch: None
                thenBlock: TBlock
                  stmts: []
                  result: TCall
                    name: "add"
                    args:
                      - TField
                          receiver: TLoad
                            name: "p"
                            ty: Point
                          index: 0
                          ty: int
                      - TField
                          receiver: TLoad
                            name: "p"
                            ty: Point
                          index: 1
                          ty: int
                    ty: int
                    results: false
                  ty: int
                elseBlock: TBlock
                  stmts: []
                  result: TIntLit
                    value: 0
                    ty: int
                  ty: int
                ty: int
              ty: int
            variadic: false
            requires: []
            ensures: []
            olds: []
            internal: false
            conv: None
            tailrec: false
            variant: None
            pure: false
            ghost: false
            reads: None
            writes: None
            exported: None
            section: None
            noinline: false
            cold: false
            inline: false
            module: ""
      main: []
      entry: None
      precompiled: []
      entryPoint: true
      cArtifact: false
      noAllocModules: []
      noAllocTestModules: []
      mainModule: ""
      tests: []
      hooks: []
      externVars: []
      testOnly: []
      destructors: {}
      warnings: []
      moduleDeps: {}
    """
