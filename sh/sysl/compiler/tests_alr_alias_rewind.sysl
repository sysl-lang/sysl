module sh.sysl.compiler
@tests

import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.text.str_builder

// An alias read inside a trial reading that is rewound, and read again afterwards.
//
// `instantiate_named_subtype` marks a name `broken` while its base is followed, so a chain leading
// back to itself is refused rather than followed for ever. A trial rewinds the answer
// (`constrained_insts`) and not the mark, so a mark left on after the answer was recorded made the
// next reading of the alias come back `Unknown`: `idles: Box[Callback]` resolved to `Box[?]`, and
// every use of the field was a refusal the reference does not make (`sysl-lang/kairos`).

private alr_ready() -> bool
    std_root() match
        Ok(_) -> true
        Err(_) ->
            print("skipped: the standard module's source is not on this machine")
            false

// Every diagnostic a one-file program earns, one message to a line in source order.
private alr_diags(text: string) -> string
    val root = make_temp_dir("sysl-alr").unwrap()
    val src = s"$root/main.sysl"

    make_dir_all(root).unwrap()
    write_text(src, text).unwrap()

    var b = str_builder()

    emit_llvm_text(src, None) match
        Err(why) -> b.push(s"refused: ${why.message}")
        Ok(made) ->
            val ordered = in_source_order(made.report)

            for i in 0..<ordered.len()
                if i > 0 then b.push("\n")

                b.push(ordered.at(i).diag.message)

    remove_dir_all(root).unwrap_or(())
    b.finish()
end alr_diags

@test("an alias naming a struct still being read answers at its second use too")
alr_an_alias_answers_at_its_second_use()
    if !alr_ready() then return

    assert_eq(alr_diags("type Callback = *Loop\n\nstruct Box[T]\n    item: T\n\nstruct TimerState\n" +
                        "    cb: Callback\n\nstruct Loop\n    timers: Box[TimerState]\n" +
                        "    idles: Box[Callback]\n\nvar l = Loop(Box(TimerState(null)), Box(null))\n" +
                        "print(1)\n"), "")

@test("and a callable alias, held in a generic container of the struct it names")
alr_a_callable_alias_in_a_container()
    if !alr_ready() then return

    assert_eq(alr_diags("import sysl.buf.{Buf, buf}\n\ntype Callback = &Fn(*Loop) -> unit\n\n" +
                        "struct Slot[T]\n    item: Option[T]\n\nstruct Slots[T]\n    entries: Buf[Slot[T]]\n\n" +
                        "struct TimerState\n    cb: Callback\n\nstruct Loop\n    timers: Slots[TimerState]\n" +
                        "    idles: Slots[Callback]\n\nvar l = Loop(Slots(buf()), Slots(buf()))\nprint(1)\n"), "")
