module sh.sysl.compiler

import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}
import sysl.text.{Search, from_utf8_unchecked}

// The checks a whole program is held to once every body it reaches has been typed.
//
// **What separates these from everything in `analyze_body.sysl` is the question they ask.** Typing a
// body asks whether each expression means anything; these ask whether the program a compilation
// came to is one the reader is allowed to have written -- which cannot be answered until the last
// body a call reached has been read, because the answer is about what a body *reaches* rather than
// about what it says.

// Everything a program has to answer for, run in the order the reference runs them.
whole_program_checks(a: &Analysis, funcs: Buf[TFunc], vals: Buf[TVal])
    check_conventions(a)
    check_exports(a)
    check_drop_returns(a)
    check_ghost(a, funcs)
    check_no_alloc(a, funcs, vals, reached_vtables(a))
    check_decl_capabilities(a, funcs, vals, reached_vtables(a))
    check_purity(a, funcs, reached_externs(a))
    check_frames(a, funcs, reached_externs(a))
    check_self_aliasing(a, funcs)
    check_test_scope(a, funcs)
end whole_program_checks

// The file a typed body was written in, or an empty one where the body has no source of its own.
func_home(a: &Analysis, name: string) -> Scope = a.tables.homes.get(name).unwrap_or(empty_scope())

// -- `@ghost` --------------------------------------------------------------------------------

// Reports every call to a `@ghost` function from somewhere that runs.
//
// **The rule that makes erasing a ghost declaration sound is a rule about who may mention it.**
// Nothing executable may call one, since erasing it would then change what the program computes; a
// clause that calls one is a clause that does not run, and is the one place a call is allowed.
//
// So the clauses are not walked: a function's `require`, `ensure` and `variant` are held beside the
// body, and a loop's `invariant` and `variant` are statements the walk stops at. Everything else is
// executable. A ghost function's own body is where real state is read, so it may call whatever it
// likes.
private check_ghost(a: &Analysis, funcs: Buf[TFunc])
    var ghost: Buf[string] = buf()

    for i in 0..<funcs.len()
        if funcs.at(i).ghost then ghost.push(funcs.at(i).name)

    if ghost.is_empty() then return

    for i in 0..<funcs.len()
        val f = funcs.at(i)

        if !f.ghost
            val scope = func_home(a, f.name)
            val an = a
            val named = ghost

            walk_block_stmts(f.body, expr_walk(false, e -> ghost_call(an, scope, named, e)))
end check_ghost

private ghost_call(a: &Analysis, scope: Scope, ghost: Buf[string], e: TExpr)
    *e.kind match
        TCall(name, _, _, _) ->
            if holds_string(ghost, name) then
                a.fault(scope, e.span, s"'${module_show(name)}' is '@ghost', so it exists for the " +
                        "specification and is not there when the program runs — it may be called " +
                        "from a 'require', an 'ensure', a loop's 'invariant' or 'variant', or from " +
                        "another '@ghost' function, and from nowhere else")
        _ -> ()
end ghost_call

// A block's statements and the value it comes to, walked as one body.
walk_block_stmts(b: TBlock, v: &TWalk)
    walk_stmts(b.stmts, v)

    if b.result.is_some() then walk_texpr(b.result.unwrap(), v)
end walk_block_stmts

// -- a value with a destructor, handed back by value ---------------------------------------------

// The types this compilation declared a destructor for, by the key their members are filed under.
//
// **It is read off the `impl` blocks rather than off the instantiated types**, because a block for a
// generic type is one block covering a family: what has a destructor is the family.
drops_declared(a: &Analysis) -> Buf[string]
    var out: Buf[string] = buf()
    val drop_trait = catalog_key(a, "Drop")

    if drop_trait.is_none() then return out

    val from = a.tables.members.from_trait

    for i in 0..<from.len()
        val key = from.key_at(i)

        if from.at(i) == drop_trait.unwrap() && member_filed_as(key) == "drop"
            out.push(member_owner_of(key))

    out
end drops_declared

// The two halves of a member key, which is an owner and the name the member is filed under.
private member_split(key: string) -> (string, string)
    val bytes = key.bytes

    for i in 0..<bytes.len
        if bytes[i] == u8('\t') then
            return (from_utf8_unchecked(bytes[0..<i]), from_utf8_unchecked(bytes[i + 1..<bytes.len]))

    (key, "")
end member_split

private member_owner_of(key: string) -> string = member_split(key).0
private member_filed_as(key: string) -> string = member_split(key).1

// Warns about every declaration that hands back a value whose type has a destructor.
//
// **A destructor runs when a box's count reaches zero**, so a value handed back by value has nothing
// that will ever call it. Returning one stays legal -- a caller may take the value apart, or hand it
// straight into something that boxes it -- which is why this is a warning: what the compiler can see
// is that the usual reading of the declaration is wrong.
//
// The check is over what a program **declared** rather than over what it instantiated, so that a
// constructor nobody has called yet is exactly the one told.
private check_drop_returns(a: &Analysis)
    val drops = drops_declared(a)

    if drops.is_empty() then return

    val funcs = a.tables.funcs

    for i in 0..<funcs.len()
        val key = funcs.key_at(i)

        // The `drop` a `Drop` block declares takes `self` by value and answers `unit`, so it never
        // trips this; and the block itself is not the place to complain about a member of the
        // dropping type that legitimately hands one back.
        if module_bare(key) != "drop" && !key.ends_with(".drop")
            val f = funcs.at(i)

            if f.decl.ret_type.is_some()
                val saved = a.complaints()
                val ty = resolve_type(a, f.scope, f.decl.ret_type.unwrap(), no_bindings())

                a.restore_complaints(saved)

                val held = drop_by_value(drops, ty)

                if held.is_some() then
                    val name = module_bare(held.unwrap())

                    a.caution(f.scope, f.span, s"'${module_show(key)}' hands back " +
                              s"'${module_show(held.unwrap())}' by value, and " +
                              s"'${module_show(held.unwrap())}' has a 'Drop' — a destructor runs " +
                              "when a box's count reaches zero, so nothing here will ever call " +
                              s"it. Return '&$name' instead, or take the resource apart before " +
                              "returning it")
end check_drop_returns

// The first type carried **by value** in this one that declares a destructor.
//
// **`&T` and `*T` both stop the walk, for opposite reasons.** A `&T` is the boxed form, which is the
// whole answer the warning asks for; a raw pointer owns nothing and never did, so a binding handing
// one back is making no claim about who frees it. A slice and an array stop it too: their elements
// are not destructed either, which is a real question and a different one.
private drop_by_value(drops: Buf[string], t: Type) -> Option[string] = t match
    Ref(_, _) -> None
    Ptr(_) -> None
    Weak(_) -> None
    Slice(_, _) -> None
    Array(_, _) -> None
    Struct(d) -> drops_or_args(drops, d.base, d.targs)
    Enum(d) -> drops_or_args(drops, d.base, d.targs)
    Volatile(inner) -> drop_by_value(drops, *inner)
    _ -> None

private drops_or_args(drops: Buf[string], base: string, targs: Buf[Type]) -> Option[string]
    if holds_string(drops, base) then return Some(base)

    for i in 0..<targs.len()
        val held = drop_by_value(drops, targs.at(i))

        if held.is_some() then return held

    None
end drops_or_args

// -- a calling convention, and what a processor makes of it ---------------------------------------

// The one convention there is. Named rather than assumed, so that the refusal for an unknown one can
// list what there is.
const InterruptConv: string = "interrupt"

// The privilege modes RISC-V distinguishes, in the spelling its attribute takes. `machine` is the
// default because a handler with no mode written is the one a bare-metal program means.
private riscv_modes() -> Buf[string]
    var out: Buf[string] = buf()

    out.push("machine")
    out.push("supervisor")
    out.push("user")
    out
end riscv_modes

const DefaultRiscvMode: string = "machine"

// How a processor spells an interrupt handler.
//
// **`interrupt` is one concept with several answers, and a processor without one is without it for
// its own reason.** On x86-64 it is a calling convention and the ABI insists the handler take a
// pointer to the frame the hardware pushed; on RISC-V it is a function attribute and the handler
// must take nothing at all. The rest carry their reason here, because a shared sentence could only
// be true of one of them.
enum InterruptForm
    // An LLVM calling convention, written on the definition -- x86-64's.
    FormConvention

    // An LLVM function attribute, written after the signature -- RISC-V's.
    FormAttribute

    // This processor has none, and this is why.
    FormAbsent(why: string)
end InterruptForm

interrupt_form(cpu: Cpu) -> InterruptForm = cpu match
    X86_64 -> FormConvention

    // Both RISC-V widths spell it the same way, because it is the same attribute: the privilege
    // modes are the architecture's rather than the register width's.
    Riscv64 -> FormAttribute
    Riscv32 -> FormAttribute

    Aarch64 -> FormAbsent("its exception entry goes through a vector table of fixed-size " +
                          "instruction slots, so a handler is assembly and there is nothing here " +
                          "for a convention to describe")

    // A Cortex-M handler is an ordinary function, and that is the whole answer rather than a gap:
    // the processor stacks the caller-saved registers itself and puts `EXC_RETURN` in the link
    // register, so a plain function returning normally is already correct.
    Thumb -> FormAbsent("a Cortex-M exception is entered with the caller-saved registers already " +
                        "stacked by the processor and 'EXC_RETURN' in the link register, so an " +
                        "ordinary function is already a correct handler and there is no prologue " +
                        "for a convention to arrange — write one, and give it the name the vector " +
                        "table holds with '@export(\"SysTick_Handler\")'")

    // WebAssembly has no interrupts to have a form for, which is a different kind of absence: the
    // others are machines whose entry a convention cannot usefully describe, and this is a machine
    // with no asynchronous entry at all.
    Wasm32 -> FormAbsent("a wasm module is only ever entered by its embedder calling an exported " +
                         "function, so nothing arrives asynchronously and there is no handler for " +
                         "a convention to describe")

    // CRAFT has traps and still has nothing for a convention to describe: it enters every one at a
    // single vector, so what the hardware reaches is the kernel's decoder rather than a handler.
    Craft -> FormAbsent("CRAFT enters every trap at one vector with the reason in 'cause', so what " +
                        "the hardware reaches is the kernel's own decoder rather than a handler — " +
                        "write that entry in assembly, and let it call an ordinary function for " +
                        "each cause it decodes")

    X86 -> FormAbsent("sysl cannot lower for i386 at all, for want of a measured C ABI, so its " +
                      "interrupt convention is not something this compiler implements")

// Whether this processor's interrupt form takes a mode. Only RISC-V's does -- x86-64's convention
// describes the frame the hardware pushed and has no privilege level to name.
private takes_mode(cpu: Cpu) -> bool = cpu match
    Riscv64 -> true
    _ -> false

// Holds every declaration carrying a convention to what this processor allows.
//
// **A declaration pass, not part of the body walk.** Every rule is about the signature, and the
// signature exists whether or not the body is ever analyzed -- a generic handler nothing
// instantiates has no body walked at all, and it is exactly as wrong as one that does.
private check_conventions(a: &Analysis)
    val funcs = a.tables.funcs

    for i in 0..<funcs.len()
        val f = funcs.at(i)

        if f.decl.conv.is_some() then check_convention(a, f, f.decl.conv.unwrap())
end check_conventions

private check_convention(a: &Analysis, f: Func, c: CallConv)
    if c.name != InterruptConv then
        a.fault(f.scope, c.span, s"'${c.name}' is not a calling convention — '$InterruptConv' is " +
                "what there is")

    val cpu = a.tables.target.cpu

    interrupt_form(cpu) match
        // The reason comes from the table rather than from here, because the processors without an
        // interrupt form are without one for unrelated reasons.
        FormAbsent(why) ->
            a.fault(f.scope, c.span, s"'${c.name}' is not something ${cpu_symbol(cpu)} has: $why")
        form ->
            check_convention_mode(a, f, c, cpu)

            // Generic is refused before anything is resolved, because a type parameter has nothing
            // to resolve *to* out here.
            if !f.decl.tparams.is_empty() then
                a.fault(f.scope, c.span, "an interrupt handler is a single entry point the " +
                        s"processor jumps to, so '${f.decl.name}' cannot be generic — there would " +
                        "be no way to say which instantiation the vector holds")

            check_convention_shape(a, f, c, form)
end check_convention

// The parenthesised word, which only RISC-V has anything to put in.
//
// A mode on a processor with none is refused rather than dropped, because a reader who wrote
// `interrupt(supervisor)` believed it was saying something.
private check_convention_mode(a: &Analysis, f: Func, c: CallConv, cpu: Cpu)
    if c.arg.is_none() then return

    val mode = c.arg.unwrap()

    if takes_mode(cpu)
        if !holds_string(riscv_modes(), mode) then
            a.fault(f.scope, c.span, s"'$mode' is not a privilege mode — RISC-V has 'machine', " +
                    s"'supervisor', 'user', and an unwritten one is '$DefaultRiscvMode'")
    else
        a.fault(f.scope, c.span, s"'${c.name}($mode)' names a privilege mode, and " +
                s"${cpu_symbol(cpu)} has none to name — its interrupt convention describes the " +
                "frame the processor pushed, not the level it was pushed at. Write 'interrupt' alone")
end check_convention_mode

// The signature the ABI demands, which the two processors that have interrupts disagree about.
//
// Neither rule is sysl's invention and neither is negotiable: clang refuses an x86-64 handler
// without the frame pointer in as many words, and a RISC-V handler is entered with nothing in the
// argument registers that a parameter could have come from.
private check_convention_shape(a: &Analysis, f: Func, c: CallConv, form: InterruptForm)
    val ret = declared_result_type(f.decl.ret_type.map(t -> resolve_type(a, f.scope, t,
                                                                        no_bindings())))

    // Nothing returns to. A handler is left through the processor's own return-from-interrupt,
    // which restores the interrupted context and has nowhere to put a value.
    if !no_value(ret) then
        a.fault(f.scope, c.span, "an interrupt handler returns to whatever it interrupted, so it " +
                s"yields nothing — '${f.decl.name}' declares ${type_show(ret)}")

    if f.decl.variadic then
        a.fault(f.scope, c.span, "an interrupt handler is entered by the processor with a fixed " +
                s"frame, so '${f.decl.name}' cannot be variadic")

    var params: Buf[Type] = buf()

    for i in 0..<f.decl.params.len()
        params.push(resolve_type(a, f.scope, f.decl.params.at(i).typ, no_bindings()))

    form match
        // RISC-V enters the handler with the interrupted program's registers still live; there is
        // no argument to read, and a parameter would be whatever the interrupted code left behind.
        FormAttribute ->
            if !params.is_empty() then
                a.fault(f.scope, c.span, "a RISC-V interrupt handler is entered with no arguments, " +
                        s"so '${f.decl.name}' takes none — what the handler needs is read from the " +
                        "machine's own registers")

        // x86-64 pushes a frame and the ABI hands the handler its address; some vectors push an
        // error code after it. Clang refuses any other shape.
        FormConvention ->
            if params.is_empty() then
                a.fault(f.scope, c.span, "an x86-64 interrupt handler is handed the frame the " +
                        s"processor pushed, so '${f.decl.name}' takes a pointer to it — " +
                        s"'interrupt ${f.decl.name}(frame: *Frame)'")
            else if !frame_shaped(params) then
                a.fault(f.scope, c.span, "an x86-64 interrupt handler takes a pointer to the frame " +
                        "the processor pushed, optionally followed by the error code some vectors " +
                        "push after it — so at most '*T' and one integer, which is not what " +
                        s"'${f.decl.name}' declares")
        _ -> ()
end check_convention_shape

// A pointer to the frame, optionally followed by one integer, and nothing else.
private frame_shaped(params: Buf[Type]) -> bool
    val head = params.at(0) match
        Ptr(_) -> true
        _ -> false

    if !head || params.len() > 2 then return false

    if params.len() == 1 then return true

    params.at(1) match
        Integer(_, _, _) -> true
        _ -> false
end frame_shaped

// -- `@export`, and what C could name -------------------------------------------------------------

// Whether a declaration is one anything importing the module may name.
private is_public(v: Visibility) -> bool = v match
    Public -> true
    _ -> false

// Holds every declaration carrying `@export` -- a free function, and a struct naming itself for a
// generated header.
//
// **A free function and a struct are the whole of it, and that is the grammar's doing rather than a
// choice made here.** An attribute is read at statement position only, so none reaches a struct
// member, an enum member or an `impl` member -- a rule refusing `@export` on a method would be a
// rule nothing could reach, and the refusal a reader meets comes from the parser.
private check_exports(a: &Analysis)
    val funcs = a.tables.funcs

    for i in 0..<funcs.len()
        val f = funcs.at(i)

        if f.decl.exported.is_some() then
            check_export(a, funcs.key_at(i), f, f.decl.exported.unwrap())

    val types = a.tables.types

    for i in 0..<types.len()
        types.at(i).kind match
            StructOf(d) ->
                if d.cname.is_some() then
                    check_struct_export(a, types.key_at(i), types.at(i), d, d.cname.unwrap())
            _ -> ()
end check_exports

// Refuses a C name a header could not declare, or a struct that has no one name to give.
//
// **The rules are the function's, arrived at from a different direction.** A symbol and a type name
// are both spellings a C reader writes, so what C can name is the same question -- but a `typedef`
// has no linkage, so `private` is not the contradiction here that it is on a function. It is
// refused anyway, and for a reason worth reading: the visibility rule already stops a public
// declaration naming a type less visible than itself, and an exported function is public.
private check_struct_export(a: &Analysis, key: string, at: Decl, d: StructDecl, e: ExportAttr)
    if e.symbol.is_some() && !c_identifier(e.symbol.unwrap()) then
        a.fault(at.scope, e.span, s"'${e.symbol.unwrap()}' is not a name C can declare — a type's " +
                "name in a header is a C identifier, so it is a letter or '_' followed by letters, " +
                "digits and '_'")

    // Checked against the declared name, since that is what an unwritten one becomes. A
    // backtick-quoted declaration is the case: it may hold anything the reader wanted.
    if e.symbol.is_none() && !c_identifier(module_bare(spelled_key(key))) then
        a.fault(at.scope, e.span, s"'${qualified_name(key)}' is not a name C can declare, so " +
                "naming it after itself would put a spelling in the header no C declaration could " +
                "use — name it instead, '@export(\"...\")'")

    if !is_public(d.vis) then
        a.fault(at.scope, e.span, s"'${qualified_name(key)}' is private, so no exported function " +
                "may name it — an export is public, and a declaration may not be more visible " +
                "than the types it names. No header can carry this type at all, so there is no " +
                "name in one for it to take")

    // Generic is refused for the reason an exported generic function is, and the argument is even
    // shorter here: every instantiation is a struct of its own, so one written name would be
    // claimed by all of them at once.
    if !d.tparams.is_empty() then
        a.fault(at.scope, e.span, s"a header names one type at one shape, so " +
                s"'${qualified_name(key)}' cannot be generic — each instantiation is a struct of " +
                "its own and they would all claim this one name. Wrap the instantiation the header " +
                "carries in a struct of its own and name that")
end check_struct_export

// Refuses an export whose symbol C could not name, or whose function C could not call.
private check_export(a: &Analysis, key: string, f: Func, e: ExportAttr)
    if e.symbol.is_some() && !c_identifier(e.symbol.unwrap()) then
        a.fault(f.scope, e.span, s"'${e.symbol.unwrap()}' is not a name C can call — an exported " +
                "symbol is a C identifier, so it is a letter or '_' followed by letters, digits " +
                "and '_'")

    // **An overload exported under its own name is refused here**, and it is worth catching by name
    // rather than leaving to the rule below: an overload's key carries a numbered segment, which is
    // not a C identifier, so the rule below would refuse it quoting a spelling the source does not
    // contain. C has no overloading at all -- two exports of one name are two definitions of one
    // symbol, which is a link error rather than anything a reader of either line could act on.
    if e.symbol.is_none() && overload_keys(a, overload_plain(key)).len() > 1 then
        a.fault(f.scope, e.span, s"'${qualified_name(key)}' is declared more than once, and C has " +
                "no overloading — two exports of one name would be two definitions of one symbol. " +
                "Give each export a symbol of its own, '@export(\"...\")'")

    // Checked against the **declared** name, since that is what an unwritten symbol becomes.
    if e.symbol.is_none() && !c_identifier(module_bare(spelled_key(overload_plain(key)))) then
        a.fault(f.scope, e.span, s"'${qualified_name(key)}' is not a name C can call, so exporting " +
                "it under its own name would publish a symbol no C declaration could spell — name " +
                "the symbol instead, '@export(\"...\")'")

    // Generic is refused before anything is resolved, for the reason a convention's is: a type
    // parameter has nothing to resolve *to* out here.
    if !f.decl.tparams.is_empty() then
        a.fault(f.scope, e.span, "an exported symbol is one function at one signature, so " +
                s"'${f.decl.name}' cannot be generic — there would be no way to say which " +
                "instantiation the linker holds. Export a wrapper per instantiation, each naming " +
                "its own symbol")

    // `private` emits the symbol internal, which is the promise that every caller is inside this
    // module. An export is the opposite promise, and a definition cannot make both.
    if !is_public(f.decl.vis) then
        a.fault(f.scope, e.span, s"'${module_show(key)}' is private, which promises every caller " +
                "is inside its own module — and an export promises the opposite. A definition " +
                "cannot make both claims")

    if f.decl.ghost then
        a.fault(f.scope, e.span, s"'${module_show(key)}' is '@ghost', so it is erased before " +
                "codegen and there is no symbol for C to link against")

    if f.decl.test.is_some() then
        a.fault(f.scope, e.span, s"'${module_show(key)}' is a '@test', which only 'sysl test' " +
                "builds — an exported symbol has to be in the artifact a C project links, and a " +
                "test is not")

    // A variadic sysl definition reads its tail through `va_start`/`va_arg`, which is C's own
    // mechanism -- but the *promotions* a C caller applies to the tail are the caller's, and nothing
    // here has seen that caller's prototype.
    if f.decl.variadic then
        a.fault(f.scope, e.span, s"'${module_show(key)}' is variadic, and what a C caller promotes " +
                "into the tail is decided by the prototype it compiled against rather than by this " +
                "declaration — take a 'va_list' parameter instead, which states the same thing and " +
                "is what C's own 'v' variants do")
end check_export
