module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.text.Search

// What pruning costs as a program grows.
//
// **The walk has to be linear in the functions it reaches**, because every program is pruned and a
// large one is exactly the program somebody is waiting on. Each reached name is looked up once and
// each "have I seen this" is one set lookup; a walk that scans the function list per reached name,
// or scans its visited list per name a body holds, is quadratic, and on a hundred-thousand-line
// program that was most of the compile.
//
// The claim is a ratio rather than a bound, so it holds on a slow machine as well as a fast one: a
// program eight times larger may cost eight times as much to prune and not sixty-four times. How the
// two are measured under a loaded suite is `tests_lgr_linear_growth.sysl`'s.

// A chain of `n` functions `main` reaches, beside a chain of `n` nothing reaches.
private chain_program(n: usize) -> string
    var lines: Buf[string] = buf()

    lines.push("main()\n    val n = f0(1)\n\n")

    for i in 0..<n
        if i + 1 < n
            lines.push(s"f$i(n: int) -> int = f${i + 1}(n + 1)\n\n")
            lines.push(s"g$i(n: int) -> int = g${i + 1}(n + 1)\n\n")
        else
            lines.push(s"f$i(n: int) -> int = n\n\n")
            lines.push(s"g$i(n: int) -> int = n\n\n")

    var text = ""

    for item in lines
        text = text + item

    text
end chain_program

// One prune of a program of two chains of `n`, analysed once beforehand, as a run to measure: its
// processor time, having checked that `main` and the chain it reaches survived and nothing else did.
private pruning(n: usize) -> &Fn() -> long
    val done = typed_of(chain_program(n))

    assert(done.reported.is_empty(), "the generated program is sound")

    val p = strip_tests(program_of(done, done.main_module))

    () -> processor_micros(() -> assert_eq(prune(p, buf()).funcs.len(), n + 1))
end pruning

// Four thousand to start from because a scan of the visited list per name, put back, is still a small
// part of a prune at a few hundred functions; from four thousand it is most of it, and fails the bound.
@test("pruning a program eight times larger costs about eight times as much, not sixty-four")
pruning_is_linear()
    val g = growth_of(pruning(4000), pruning(4000 * GrowthFactor))

    assert(g.linear(), g.said("pruning"))
end pruning_is_linear

// The modules a compilation is answerable for, as the driver hands them to `prune`: every unit's
// own module except the library's. **A helper that lowers "the way the driver does" passes this
// rather than an empty list** -- an empty list says every module's roots count, which keeps every
// library `@export` and `@section` a program never reaches.
program_own(units: Buf[Program]) -> Buf[string]
    var own: Buf[string] = buf()

    own.push(ModuleRoot)

    for item in units
        val m = module_written(item)

        if m != "sysl" && !m.starts_with("sysl.") then own.push(m)

    own
end program_own
