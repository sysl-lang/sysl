module sh.sysl.compiler
@tests

import sysl.text.Search

// The reference's `GenericFuncAddressTests`: the address of a GENERIC function, its instantiation
// read off the expected type or written out as `&f[T]` -- the one position in the language that
// takes type arguments. The written form is what lets a library ship a callback trampoline whose
// state type belongs to the application: a C interface fixes the callback to untyped pointers, so
// nothing in the expected type can settle `T`.
//
// **Every diagnostic and every output here was read out of the reference compiler (0.0.162)** by
// handing the installed `sysl` the same program. The harness is `tests_xvr_extern_var.sysl`'s:
// `xvr_ran` for a program linked and run, `xvr_ir` for the analysis's report.

private gfa_main(text: string) -> []const (string, string) = [("main.sysl", text)]

private gfa_ran(text: string) -> string = xvr_ran(gfa_main(text))

private gfa_ir(text: string) -> string = xvr_ir(gfa_main(text))

// A refusal carries this message, anchored at this `file:line:column`.
private gfa_refused(said: string, message: string, at: string) =
    assert(said.contains(s"error: $message\n --> $at\n"), said)

// The declaration every `qsort` program here begins with.
private gfa_qsort() -> string =
    "extern qsort(base: *u8, n: usize, size: usize, cmp: *extern(*u8, *u8) -> i32)\n\n"

// -- an instantiation is read off the expected type ------------------------------------------------

@test("at a val's written type")
gfa_at_a_vals_written_type()
    if xvr_no_library() then return

    assert_eq(gfa_ran(raw"""
        ident[T](x: T) -> T = x

        val f: *extern(i32) -> i32 = &ident
        print(f(7))
        """), "7\n")
end gfa_at_a_vals_written_type

// The shape a callback actually takes: the state type appears only behind a pointer.
@test("through a pointer parameter")
gfa_through_a_pointer_parameter()
    if xvr_no_library() then return

    assert_eq(gfa_ran(raw"""
        struct State
            n: i32

        read_it[S](s: *S, bump: i32) -> i32 = bump

        val f: *extern(*State, i32) -> i32 = &read_it
        var st = State(3)
        print(f(&st, 9))
        """), "9\n")
end gfa_through_a_pointer_parameter

@test("at an extern's parameter, which is where a real callback is handed over")
gfa_at_an_externs_parameter()
    if xvr_no_library() then return

    assert_eq(gfa_ran(gfa_qsort() + raw"""
        ascending[T](a: *T, b: *T) -> i32
            var pa: *i32 = ptr_cast(a)
            var pb: *i32 = ptr_cast(b)
            *pa - *pb

        var xs = [30i32, 10i32, 20i32]
        qsort(ptr_cast(&xs[0]), 3, 4, &ascending)
        print(xs[0], xs[1], xs[2])
        """), "10 20 30\n")
end gfa_at_an_externs_parameter

// Two instantiations of one generic are two bodies, and both have to be reachable at once.
@test("two instantiations of the same function are two addresses")
gfa_two_instantiations_are_two_addresses()
    if xvr_no_library() then return

    assert_eq(gfa_ran(raw"""
        ident[T](x: T) -> T = x

        val f: *extern(i32) -> i32 = &ident
        val g: *extern(u8) -> u8 = &ident
        print(f(7), g(u8(3)))
        """), "7 3\n")
end gfa_two_instantiations_are_two_addresses

// -- the arguments written out: `&f[T]` -----------------------------------------------------------

// The case the form exists for: the trampoline's own type parameter appears nowhere in the
// signature C fixes, so there is nothing for an expected type to solve.
@test("a trampoline over '*u8', which no expected type can settle")
gfa_a_trampoline_over_u8_pointers()
    if xvr_no_library() then return

    assert_eq(gfa_ran(gfa_qsort() + raw"""
        compare[T: Ord](a: *u8, b: *u8) -> i32
            var pa: *T = ptr_cast(a)
            var pb: *T = ptr_cast(b)
            if *pa < *pb then -1 else if *pa > *pb then 1 else 0

        var xs = [30i32, 10i32, 20i32]
        qsort(ptr_cast(&xs[0]), 3, 4, &compare[i32])
        print(xs[0], xs[1], xs[2])
        """), "10 20 30\n")
end gfa_a_trampoline_over_u8_pointers

// The same trampoline reached from inside a generic, which is how a library offers one: the written
// `T` is the enclosing instantiation's argument, so it resolves in the substitution in force.
@test("a written argument that is the enclosing generic's own parameter")
gfa_the_enclosing_generics_own_parameter()
    if xvr_no_library() then return

    assert_eq(gfa_ran(gfa_qsort() + raw"""
        private compare[T: Ord](a: *u8, b: *u8) -> i32
            var pa: *T = ptr_cast(a)
            var pb: *T = ptr_cast(b)
            if *pa < *pb then -1 else if *pa > *pb then 1 else 0

        sort_libc[T: Ord](xs: []T)
            qsort(ptr_cast(sysl.slices.as_mut_ptr(xs)), xs.len, sizeof(T), &compare[T])

        var xs = [30i32, 10i32, 20i32]
        sort_libc(xs[..])
        print(xs[0], xs[1], xs[2])
        """), "10 20 30\n")
end gfa_the_enclosing_generics_own_parameter

@test("with no expected type at all, which is what the inferred form cannot do")
gfa_with_no_expected_type_at_all()
    if xvr_no_library() then return

    assert_eq(gfa_ran(raw"""
        ident[T](x: T) -> T = x

        var f = &ident[i32]
        print(f(7))
        """), "7\n")
end gfa_with_no_expected_type_at_all

// More than one thing in the brackets was never an index, but it is still only a type-argument list
// at an address.
@test("more than one argument")
gfa_more_than_one_argument()
    if xvr_no_library() then return

    assert_eq(gfa_ran(raw"""
        first_of[A, B](a: *A, b: *B) -> i32 = 1

        var f = &first_of[i32, u8]
        var x = 5i32
        var y = u8(9)
        print(f(&x, &y))
        """), "1\n")
end gfa_more_than_one_argument

// The shapes a type and an expression spell identically all survive the trip out of the expression
// grammar.
@test("a pointer, a reference and an applied generic as arguments")
gfa_a_pointer_a_reference_and_an_applied_generic()
    if xvr_no_library() then return

    assert_eq(gfa_ran(raw"""
        struct Box[T]
            v: T

        shape[A, B, C](a: *A, b: *B, c: *C) -> i32 = 3

        var f = &shape[*i32, &Box[i32], Box[u8]]
        print(1)
        """), "1\n")
end gfa_a_pointer_a_reference_and_an_applied_generic

// A declaration's parameters are one list whichever kind each is, so a value parameter is written
// like any other -- and a value generic's parameter may be absent from the signature entirely.
@test("a value argument")
gfa_a_value_argument()
    if xvr_no_library() then return

    assert_eq(gfa_ran(raw"""
        scaled[const N: usize](x: i32) -> i32 = x * i32(N)

        var f = &scaled[3]
        print(f(4))
        """), "12\n")
end gfa_a_value_argument

// Writing them wins outright: the expected type is not consulted.
@test("the written arguments beat an expected type that would have solved differently")
gfa_the_written_arguments_win()
    if xvr_no_library() then return

    assert_eq(gfa_ran(raw"""
        ident[T](x: T) -> T = x

        val f: *extern(i32) -> i32 = &ident[i32]
        print(f(7))
        """), "7\n")
end gfa_the_written_arguments_win

// -- what the written form refuses ----------------------------------------------------------------

// Writing the arguments does not exempt them from the bound the body was compiled against.
@test("a type argument that does not satisfy the bound")
gfa_a_type_argument_outside_the_bound()
    if xvr_no_library() then return

    gfa_refused(gfa_ir(raw"""
        struct Blob
            n: i32

        compare[T: Ord](a: *u8, b: *u8) -> i32 = 0

        var f = &compare[Blob]
        print(1)
        """),
                "'compare' requires its type parameter 'T' to implement 'sysl.Ord', but Blob does not",
                "main.sysl:6:9")
end gfa_a_type_argument_outside_the_bound

@test("more arguments than the declaration has parameters")
gfa_more_arguments_than_parameters()
    if xvr_no_library() then return

    gfa_refused(gfa_ir("ident[T](x: T) -> T = x\n\nvar f = &ident[i32, u8]\nprint(1)\n"),
                "'ident' takes 1 type argument ('T'), and 2 were written", "main.sysl:3:9")
end gfa_more_arguments_than_parameters

@test("fewer arguments than the declaration has parameters")
gfa_fewer_arguments_than_parameters()
    if xvr_no_library() then return

    gfa_refused(gfa_ir("pair[A, B](a: *A, b: *B) -> i32 = 0\n\nvar f = &pair[i32]\nprint(1)\n"),
                "'pair' takes 2 type arguments ('A', 'B'), and 1 was written", "main.sysl:3:9")
end gfa_fewer_arguments_than_parameters

// A pack stands for a list of types rather than one, so no written argument can stand against it.
@test("a type pack, which no written argument can stand against")
gfa_a_type_pack()
    if xvr_no_library() then return

    gfa_refused(gfa_ir("joined[..A: Display](p: *u8) -> i32 = 0\n\nvar f = &joined[i32]\nprint(1)\n"),
                "'A' is a type pack, which stands for a list of types rather than one, so it has no " +
                "written form here — a declaration taking one has its instantiation read off the " +
                "type its address is wanted at",
                "main.sysl:3:9")
end gfa_a_type_pack

@test("a name that is not generic")
gfa_a_name_that_is_not_generic()
    if xvr_no_library() then return

    gfa_refused(gfa_ir("plain(x: i32) -> i32 = x\n\nvar f = &plain[i32]\nprint(1)\n"),
                "'plain' is not generic, so it has no type arguments to write — its address is " +
                "'&plain'",
                "main.sysl:3:9")
end gfa_a_name_that_is_not_generic

// An `extern` is never generic either, and is told so in the same words.
@test("an extern, which is not generic either")
gfa_an_extern_is_not_generic()
    if xvr_no_library() then return

    gfa_refused(gfa_ir("extern abs(x: int) -> int\n\nvar f = &abs[i32]\nprint(1)\n"),
                "'abs' is not generic, so it has no type arguments to write — its address is '&abs'",
                "main.sysl:3:9")
end gfa_an_extern_is_not_generic

// The brackets read their contents out of the expression grammar, so an expression that is not a
// type reaches the analyzer and is named as one.
@test("an expression that is not a type")
gfa_an_expression_that_is_not_a_type()
    if xvr_no_library() then return

    gfa_refused(gfa_ir("count[T](p: *u8) -> i32 = 0\n\nvar f = &count[1 + 2]\nprint(1)\n"),
                "this is not a type — what is written in the brackets is a type argument, and they " +
                "read it out of the expression grammar, so a slice, a 'weak', a 'volatile', a vector " +
                "and a callable have no spelling here. Write the type on the binding instead: " +
                "'var f: *extern(…) -> … = &…'",
                "main.sysl:3:16")
end gfa_an_expression_that_is_not_a_type

// The honest hole in the form: a slice has a spelling the expression grammar has no production
// for, so the parser refuses it in its own words.
@test("a slice, which the expression grammar has no production for")
gfa_a_slice_is_refused_by_the_parser()
    assert_eq(gfa_ir("count[T](p: *u8) -> i32 = 0\n\nvar f = &count[[]int]\nprint(1)\n"),
              "']' expected")
end gfa_a_slice_is_refused_by_the_parser

// The discrimination is by name resolution, so a local wins and keeps the ordinary reading.
@test("a local shadowing the function keeps the index reading")
gfa_a_local_keeps_the_index_reading()
    if xvr_no_library() then return

    assert_eq(gfa_ran(raw"""
        ident[T](x: T) -> T = x

        var ident = [7i32, 8i32]
        print(ident[1])
        """), "8\n")
end gfa_a_local_keeps_the_index_reading

// A list of things in brackets is a type-argument list wherever it is written, and an address is
// the only place it may be.
@test("a comma in brackets anywhere but an address")
gfa_a_comma_in_brackets_anywhere_else()
    if xvr_no_library() then return

    gfa_refused(gfa_ir("var xs = [7, 8]\nprint(xs[0, 1])\n"),
                "a subscript takes one index, and 2 were written — a list of types in brackets is a " +
                "type-argument list, and the only place one is written is at an address, as " +
                "'&f[A, B]'. Everywhere else a generic's arguments are inferred, from the arguments " +
                "at a call or from the type the result is read into",
                "main.sysl:2:9")
end gfa_a_comma_in_brackets_anywhere_else

// -- what it still refuses ------------------------------------------------------------------------

@test("no expected type to read the arguments off")
gfa_no_expected_type()
    if xvr_no_library() then return

    gfa_refused(gfa_ir("ident[T](x: T) -> T = x\n\nvar f = &ident\nprint(1)\n"),
                "'ident' is generic, so which copy of it this addresses depends on its type " +
                "arguments, and nothing here says what they are — write them, as '&ident[T]', or " +
                "write the type this is stored in, as 'var f: *extern(…) -> … = &ident'",
                "main.sysl:3:9")
end gfa_no_expected_type

// A parameter the signature does not mention cannot be settled by anything in the expected type.
@test("a type parameter the signature never mentions")
gfa_a_parameter_the_signature_never_mentions()
    if xvr_no_library() then return

    gfa_refused(gfa_ir("size_of[T](n: i32) -> i32 = n\n\nval f: *extern(i32) -> i32 = &size_of\nprint(1)\n"),
                "'size_of' is generic, and the *extern(int) -> int wanted here does not say what " +
                "'T' should be — a type parameter the signature does not mention cannot be settled " +
                "by the type of the address. Write it: '&size_of[T]'",
                "main.sysl:3:30")
end gfa_a_parameter_the_signature_never_mentions

@test("an arity that does not match")
gfa_an_arity_that_does_not_match()
    if xvr_no_library() then return

    gfa_refused(gfa_ir("ident[T](x: T) -> T = x\n\nval f: *extern(i32, i32) -> i32 = &ident\nprint(1)\n"),
                "'ident' takes 1 parameter, and the *extern(int, int) -> int wanted here takes 2",
                "main.sysl:3:35")
end gfa_an_arity_that_does_not_match

// A nested function's environment is the frame it was declared in, so it has no address whether or
// not it is generic.
@test("a nested function, generic or not")
gfa_a_nested_function()
    if xvr_no_library() then return

    gfa_refused(gfa_ir(raw"""
        outer() -> int
            inner(n: int) -> int = n
            val f: *extern(int) -> int = &inner
            0
        print(outer())
        """),
                "'inner' is a nested function, so it has no address to take — what would have to " +
                "travel beside the address is the frame it reads, and a '*extern' is one word. A " +
                "top-level function is what has an address",
                "main.sysl:3:34")
end gfa_a_nested_function
