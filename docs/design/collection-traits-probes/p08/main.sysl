// p07b: the erased iterator handed to a generic consumer bounded by the trait, whose trait carries an
// adapter member with type parameters of its own.
trait It
    type Item
    next(*self) -> Option[Self::Item]

    map[U, F: Fn1[Self::Item, U]](self, f: F) -> MapIt[Self, F, U] = MapIt(self, f)

struct Count
    n: int
    stop: int

impl It for Count
    type Item = int
    next(*self) -> Option[int]
        if self.n >= self.stop then return None
        val v = self.n
        self.n += 1
        Some(v)

struct MapIt[I, F, U]
    src: I
    f: F

impl[I: It, F: Fn1[I::Item, U], U] It for MapIt[I, F, U]
    type Item = U
    next(*self) -> Option[U]
        self.src.next() match
            Some(x) -> Some(self.f(x))
            None -> None

count_all[I: It](it: I) -> int
    var n = 0
    var cur = it
    loop
        cur.next() match
            Some(_) -> n += 1
            None -> break
    n
end count_all

main()
    val o: &It[int] = Count(0, 3)
    print(count_all(o))
