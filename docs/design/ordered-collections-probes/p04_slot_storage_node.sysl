// The representation that works today: a node's keys and values in slot storage of their own, with
// an insert in the middle (place at the end of the live run, shift by assignment) and a removal from
// the middle (shift down, vacate the last). A Drop key shows a removed key is let go of at once.

struct Tag
    n: int

impl Drop for Tag
    drop(self) = print("drop", self.n)

struct Leaf[K: Ord]
    len: usize
    keys: []K

    insert(*self, k: K)
        var i: usize = 0

        while i < self.len && self.keys[i] < k
            i += 1

        if i == self.len
            slot_place(self.keys, i, k)
        else
            slot_place(self.keys, self.len, self.keys[self.len - 1])

            var j = self.len - 1

            while j > i
                self.keys[j] = self.keys[j - 1]
                j -= 1

            self.keys[i] = k

        self.len += 1
    end insert

    remove_at(*self, i: usize)
        for j in i + 1..<self.len
            self.keys[j - 1] = self.keys[j]

        self.len -= 1
        slot_vacate(self.keys, self.len)
end Leaf

impl Ord for Tag
    lt(self, rhs: Self) -> bool = self.n < rhs.n

val l: &Leaf[&Tag] = Leaf(0, slot_storage(4))

l.insert(Tag(5))
l.insert(Tag(1))
l.insert(Tag(3))
print(l.keys[0].n, l.keys[1].n, l.keys[2].n)
l.remove_at(1)
print("after remove", l.len, l.keys[0].n, l.keys[1].n)
