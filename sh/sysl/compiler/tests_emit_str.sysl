@test("a view of storage this frame holds counts against nothing, and the count call is still made")
a_slice_of_a_frame_array_owns_nothing()
    if no_str_library() then return

    assert_eq(str_lowered(
                  "part(xs: [4]int) -> usize = xs[1..<3].len\n" +
                  "main() = print(part([1, 2, 3, 4]))\n",
              "part"),
              "define i64 @part([4 x i32] %xs.param) {\n" +
              "entry:\n" +
              "  %xs.addr = alloca [4 x i32]\n" +
              "  store [4 x i32] %xs.param, ptr %xs.addr\n" +
              "  %t1 = icmp ule i64 3, 4\n" +
              "  br i1 %t1, label %bounds.ok1, label %bounds.bad2\n" +
              "bounds.bad2:\n" +
              "  call void @llvm.trap()\n" +
              "  unreachable\n" +
              "bounds.ok1:\n" +
              "  %t2 = icmp ule i64 1, 3\n" +
              "  br i1 %t2, label %bounds.ok3, label %bounds.bad4\n" +
              "bounds.bad4:\n" +
              "  call void @llvm.trap()\n" +
              "  unreachable\n" +
              "bounds.ok3:\n" +
              "  %t3 = getelementptr i32, ptr %xs.addr, i64 1\n" +
              "  %t4 = sub i64 3, 1\n" +
              "  call void @arc.retain_maybe(ptr null)\n" +
              "  %t5 = insertvalue { ptr, ptr, i64 } zeroinitializer, ptr null, 0\n" +
              "  %t6 = insertvalue { ptr, ptr, i64 } %t5, ptr %t3, 1\n" +
              "  %t7 = insertvalue { ptr, ptr, i64 } %t6, i64 %t4, 2\n" +
              "  %t8 = extractvalue { ptr, ptr, i64 } %t7, 2\n" +
              "  %t9 = extractvalue { ptr, ptr, i64 } %t7, 0\n" +
              "  call void @arc.release_maybe(ptr %t9)\n" +
              "  ret i64 %t8\n" +
              "}\n")
end a_slice_of_a_frame_array_owns_nothing

@test("a view of a view keeps the owner and narrows the pointer and the length")
a_slice_of_a_slice_narrows_and_shares_the_owner()
