module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.container.{Map, map, Set, set}
import sysl.text.Search

// What the program is made of, as the analyzer holds it.
//
// **Every declaration the sources wrote, filed under one key.** A key is the module and the name
// joined by `$` (`modules.sysl`), which is also the symbol an object file will carry, so there is no
// second naming scheme to keep in step with the first.
//
// **A table keeps the order things were written in.** Two compilations of one program have to say
// the same things in the same order -- a diagnostic list, a symbol order, a test order -- and a hash
// table alone does not promise that. So every table is a hash for the lookup and a list for the
// walk, which is the reference compiler's `LinkedHashMap` in the two parts sysl spells separately.

// A table of declarations, keyed by the key and walked in the order they were registered.
struct Table[V]
    order: Buf[string]
    by_key: Map[string, V]

    put(*self, key: string, v: V)
        if !self.by_key.has(key) then self.order.push(key)

        self.by_key.put(key, v)

    get(self, key: string) -> Option[V] = self.by_key.get(key)

    // Takes an entry back out, for a reading that is being rewound. The walk order loses its place
    // rather than keeping a name nothing answers for.
    remove(*self, key: string)
        if !self.by_key.has(key) then return

        self.by_key.remove(key)

        var kept: Buf[string] = buf()

        for item in self.order
            if item != key then kept.push(item)

        self.order = kept
    end remove

    has(self, key: string) -> bool = self.by_key.has(key)

    len(self) -> usize = self.order.len()

    key_at(self, i: usize) -> string = self.order.at(i)

    at(self, i: usize) -> V = self.by_key.get(self.order.at(i)).unwrap()
end Table

// A table with nothing in it.
table[V]() -> &Table[V] = Table(buf(), map())

// What one file's `import` clauses brought into scope.
//
// **Three kinds, because an import says three different things.** A selector binds one name; a
// module import binds a name that stands for a module and is written before a dot; a wildcard makes
// everything a module declares reachable unqualified.
struct Imports
    names: Buf[(string, string)]
    modules: Buf[(string, string)]
    wildcards: Buf[string]

    // **Where each open block's imports begin in the three lists, outermost first** -- only a block
    // that has imported something has one. A name is asked of each block's imports, innermost first,
    // and of the file's last, so a block's wildcard is asked before a name the file imported by name.
    levels: Buf[(usize, usize, usize)]

    is_empty(self) -> bool =
        self.names.is_empty() && self.modules.is_empty() && self.wildcards.is_empty()

    // How many levels a name is asked of: every block that has imported, and then the file.
    depth(self) -> usize = self.levels.len() + 1

    // The imports of one level on their own, 0 being the innermost block's and the last the file's.
    level(self, i: usize) -> Imports
        if self.levels.is_empty() then return self

        val from = self.level_start(self.levels.len() - i)
        val to = self.level_start(self.levels.len() - i + 1)
        var names: Buf[(string, string)] = buf()
        var modules: Buf[(string, string)] = buf()
        var wildcards: Buf[string] = buf()

        names.extend(self.names.view()[from.0..<to.0])
        modules.extend(self.modules.view()[from.1..<to.1])
        wildcards.extend(self.wildcards.view()[from.2..<to.2])
        Imports(names, modules, wildcards, buf())
    end level

    // Where the k-th level counted from the file's begins, the one past the innermost ending the lists.
    private level_start(self, k: usize) -> (usize, usize, usize) =
        if k == 0 then (0, 0, 0)
        else if k <= self.levels.len() then self.levels.at(k - 1)
        else (self.names.len(), self.modules.len(), self.wildcards.len())

    // The key a bound name stands for.
    name_key(self, name: string) -> Option[string] = lookup_pair(self.names, name)

    // The module a bound name stands for.
    module_as(self, name: string) -> Option[string] = lookup_pair(self.modules, name)

    binds(self, name: string) -> bool = self.name_key(name).is_some() || self.module_as(name).is_some()
end Imports

// **The LAST binding of a name answers**, because a block's imports are appended after the file's and
// taken back off at its dedent: an import inside a block shadows what the file bound under the same
// name, for the rest of that block. Within one file or one block a name is bound once, a second import
// of it being refused.
private lookup_pair(pairs: Buf[(string, string)], name: string) -> Option[string]
    var i = pairs.len()

    while i > 0
        i -= 1

        if pairs.at(i).0 == name then return Some(pairs.at(i).1)

    None
end lookup_pair

// Nothing imported.
no_imports() -> Imports = Imports(buf(), buf(), buf(), buf())

// The terms one file's declarations are read in: the module they contribute to, what the file
// imported, and the file itself -- which is what `private` is measured against, since **`private` is
// file-private and not module-private**.
struct Scope
    module_name: string
    imports: Imports
    src: Source

    // Which package the file came from, and what the module paths it writes mean. A path written
    // inside a package means that package's own tree before it can mean anything else, and a path
    // its manifest bound means what the manifest said -- neither of which the file itself spells.
    pkg: Packaging
end Scope

// Where the reference that made one module depend on another was written.
//
// **The first reference is the one kept**, since that is the line a reader follows a chain from --
// except that a reference resolving a bare name carries no span of its own, so a site that HAS one
// replaces a site that has not. An edge nothing positioned reports at the head of its file, which
// is what the reference does with the `None` its own cursor holds there.
struct ModuleEdge
    from: string
    to: string
    scope: Scope
    span: Span
end ModuleEdge

// One edge of the module graph as the capability check reads it: where it was first written, the
// capabilities the declaration it was written in needs (implications folded in), and whether it was
// written in scaffolding -- a `@tests` file or a `@test` function, which every build but a test run
// drops.
struct CapabilityRef
    from: string
    to: string
    scope: Scope
    span: Span
    needs: Buf[string]
    scaffolding: bool

    // Whether this is the `import` itself rather than a reference through it. An import says which
    // names a file may write, not what the module ships, so it is charged by its uses.
    imported: bool

    // The type this reference only NAMED, or empty where it reaches code. A type is charged for the
    // code it runs -- a method where one is called, its destructor wherever a value of it can die --
    // so naming one in a signature, a field or a variant costs nothing unless the type, or something
    // it holds, has a `Drop`; `check_gated_modules` settles which once every type is laid out, and
    // marks those `dies`.
    named: string
    dies: bool

    // Whether the reference costs its writer what the module it reaches requires.
    charges(self) -> bool = self.named == "" || self.dies
end CapabilityRef

// Where an `extern` was written.
struct ExternHome
    scope: Scope
    span: Span
end ExternHome

// How far a declaration reaches, and from where.
struct Access
    vis: Visibility
    file: string

    // The module the declaration was written in. A `private[M]` names a module the declaration is
    // already inside, so what `M` stands for cannot be read off `M` alone -- it is resolved
    // outward from here, and the same word may name two of the ancestors. Spelled `module_name`
    // because `module` is a reserved word and may not name a field.
    module_name: string
end Access

// A declaration of a type: which kind it is, and enough of it to answer a question about the name
// without reaching for the tree.
enum DeclKind
    StructOf(decl: StructDecl)
    EnumOf(decl: EnumDecl)
    TraitOf(decl: TraitDecl)
    TypeOf(decl: TypeDecl)
    CTypeOf(decl: CTypeDecl)
end DeclKind

// One declaration as the tables hold it: what it is, where it was written, and in whose terms.
struct Decl
    kind: DeclKind
    span: Span
    scope: Scope
end Decl

// A function as the tables hold it.
struct Func
    decl: FuncDecl
    span: Span
    scope: Scope
end Func

// A value declaration -- a `const`, a `val`, or an `extern` variable.
struct ValueDecl
    name: string
    typ: Option[TypeRef]
    vis: Visibility
    span: Span
    scope: Scope

    // What the declaration was written equal to, where anything was.
    //
    // **A constant is folded into its use**, so the expression that gives it its value is read
    // again at every place the name is read -- which is what makes it behave like the value it
    // names rather than like storage. A `val` has none of this: nothing is folded, because it *is*
    // storage, and a `val` in the tables carries its initializer only so that a later pass has one
    // place to find it.
    init: Option[Expr]

    // What the declaration asked of the storage itself: the boundary it is to start on, and the
    // section of the object file it belongs in. Neither means anything to the analysis; both are
    // carried so that what a program says about its storage survives to the stage that lays it out.
    align: Option[Expr]
    section: Option[string]

    // `@thread_local`: one copy of the storage per thread. Only a module `var` carries it.
    thread_local: bool

    // The C symbol an `extern` variable names, where it wrote one: `extern "optind" idx: i32` is
    // read under `optind`, however the module qualifies `idx`. Nothing else carries one.
    link: Option[string]

    // What an `extern` variable's `@needs(...)` says reaching it requires. Nothing else carries one.
    needs: Buf[string]

    // `@export` above module storage: the C symbol it is published under (`reference/ffi.md §
    // Exported storage`). Only a module `var` or `val` carries one.
    export: Option[ExportAttr]
end ValueDecl

// The symbol an `extern` variable is read and declared under: the one it named, and its own name
// otherwise -- never the module-qualified key, which is a sysl name and no linker's.
extern_var_symbol(d: ValueDecl) -> string = d.link match
    Some(sym) -> sym
    None -> d.name

// An `impl` block, kept in the order the sources wrote them, since nothing keys one.
struct Impl
    decl: ImplDecl
    span: Span
    scope: Scope
end Impl

// Everything the declaration pass builds.
//
// **What it deliberately does not hold is the reading of these tables.** Asking what members a type
// has, whether it satisfies a bound and through which implementation, and what to say when it does
// not, is a later stage's.
struct Tables
    target: Target
    layout: TargetLayout

    // The modules this compilation has files for, which is what an `import` is checked against.
    modules: Buf[string]

    // Every type declaration, by key, and how far each reaches.
    types: &Table[Decl]
    access: &Table[Access]

    // The functions, and the keys the overloads of one name were filed under.
    funcs: &Table[Func]
    overloads: &Table[Buf[string]]

    // The key one file's own file-private declaration of a spelling took -- the plain one, or a
    // numbered slot where another file also declares the spelling. Keyed by the file and the
    // spelling together (`file_slot_key`).
    file_private: &Table[string]

    // The storage: `const`, `val`, `static var` and the `extern` variables.
    consts: &Table[ValueDecl]
    vals: &Table[ValueDecl]
    extern_vars: &Table[ValueDecl]

    // The `extern` functions, which are declared rather than defined, and where each was written --
    // the file, because that is where the types in its signature mean what they meant, and the span,
    // because a declaration whose symbol cannot be honoured is reported at the line that wrote it.
    externs: &Table[ExternDecl]
    extern_scopes: &Table[ExternHome]

    // The `impl` blocks, in the order they were written.
    impls: Buf[Impl]

    // Every instantiation the resolution made, so that one `Node[int]` is one type.
    //
    // **A record joins the table once its fields are resolved**, so the walk over it reads a type
    // after everything it is made of -- which is the order a layout can be worked out in, and the
    // order the reference records. What holds the recursion open in the meantime is `in_progress`:
    // a declaration that mentions itself finds the record there and does not recurse for ever.
    in_progress: &Table[Type]
    struct_insts: &Table[Type]
    enum_insts: &Table[Type]
    constrained_insts: &Table[Type]

    // The declarations a mistake was already reported about, so that the mentions of one further
    // down say nothing more.
    broken: &Table[bool]

    // The enum declarations whose discriminants have already been read, by declaration key rather
    // than by instantiation. A simple enum's values are written in its declaration and no type
    // argument reaches them, so every instantiation would otherwise repeat one complaint about one
    // mistake -- once for each type the program happens to name the enum at.
    enum_tags_seen: &Table[bool]

    // What a `@tests` file declared, as keys, since it is asked of several tables at once, and the
    // files that said it -- which is what a declaration is held against, because `@tests` is a
    // property of the FILE and a key alone does not say which file wrote it.
    test_only: Buf[string]
    test_only_files: Buf[string]

    // Which modules each module reached, in the order each edge was first made. It is what an
    // unused-import warning is read out of, and what the acyclicity of the module graph is asked of.
    module_deps: Buf[(string, Buf[string])]

    // Where each of those edges was written, which is a table of its own because an edge is a pair
    // of names and a diagnostic about one has to land in a file. **The reference that MADE the edge
    // is the place a reader has to change**, not the clause the capability was given up in, so the
    // capability check reads this rather than anything about a module's own text.
    module_edges: Buf[ModuleEdge]

    // The keys in `vals` a program may write to, which is what a `var` declares and a `val` does
    // not. Held beside the table rather than on the declaration, because the two forms are one
    // record everywhere else and only a read of the name asks this.
    writable: Buf[string]

    // What each module's capability clauses left behind: the capabilities it gave up, the ones it
    // requires, and what its `@tests` files say instead -- as (module, capability) pairs, each with
    // the capabilities that come with it folded in.
    //
    // **The tests' set is an OVERRIDE per capability rather than a set of its own**, which is what
    // keeps the silent case meaning what it always meant: a `@tests` file writing no clause records
    // the module's. `module_test_own` is the half that file wrote itself, which is what tells a
    // reader which line to go and look at.
    module_narrows: Buf[(string, string)]
    module_requires: Buf[(string, string)]
    module_test_narrows: Buf[(string, string)]
    module_test_own: Buf[(string, string)]

    // The modules the program's author did not write: the standard module's and every one a library
    // or a package handed over. **A target's set is asked of the program's own modules and not of
    // these** -- a library's clause is its author's, and holding it to the machine would let one
    // module of a library decide whether the whole library may be used there at all.
    supplied_modules: Buf[string]

    // The file the program starts in, where this compilation has one, and which of that file's
    // functions belong to its body rather than to its module. Both are settled before anything is
    // hoisted, because they decide what the hoisting passes are given.
    entry_src: string
    entry_captures: Buf[string]

    // The functions whose `@reads` or `@writes` named something that is not module storage, by the
    // name the typed function carries. A frame that could not be read is no frame at all: the
    // function is not held to one, and neither is anything that calls it -- what a reader is told
    // is the name that did not resolve, and nothing that follows from it.
    broken_frames: Buf[string]

    // What each `impl` of a trait that requires others still owes, held until every block is
    // registered: the block that supplies a required trait may be written below the one that needs
    // it, so the question cannot be answered where it is asked.
    super_checks: Buf[SuperCheck]

    // The file each body was analyzed in, by the name the typed function carries.
    //
    // **A check that reads a body back needs the file the body was written in**, and nothing on the
    // typed node says: a function's key names its module and an instantiation's names its receiver,
    // neither of which is a file. It is recorded where the body is typed, which is the one place
    // that knows.
    homes: &Table[Scope]

    // What the members and the traits amount to, which is the stage after this one's. It is a record
    // of its own because the declaration pass deliberately does not read it: asking what members a
    // type has, whether it satisfies a bound and through which implementation, and what to say when
    // it does not, is that stage's question and not this one's.
    members: &MemberTables

    // Every generic declaration's body as the definition-time pass typed it, kept although the
    // tables that reading filled were rewound.
    //
    // **A generic is answered for by the body it was written as**, so a whole-program check about a
    // module's own conduct -- what it allocates, what it reaches -- has to read this rather than the
    // instantiations, which belong to whoever chose the type. Nothing here is emitted: the trees
    // name instantiations the rewind took back out, and they are read for what a body *does* and
    // never lowered.
    abstracts: Buf[TFunc]

    // Every variant name any enum declaration or instantiation has carried, which is what lets a
    // bare name that no enum has as a variant skip the walks over `types` and `enum_insts` that look
    // for one. **It only ever grows**: a rewind takes a registration back out of those tables and
    // leaves its names here, so this is a superset of what they hold, and every answer is still read
    // from the tables themselves. A name absent from it is a name no walk could have found.
    variant_names: &Table[bool]

    // Every spelling some declaration makes nameable beyond its own file -- public, or `private[M]`
    // -- by its plain key, and again by the plain key held with each file that declares it
    // (`file_slot_key`). **Filled from the parsed files before anything is hoisted**, since the
    // question `decl_key` asks of it is about declarations that may not be registered yet.
    wider: &Table[bool]

    // Every canonical prefix a package's files arrived under, which is how a module name is told
    // apart from the package it came in under. Empty for a compilation with no dependencies.
    package_prefixes: Buf[string]

    // Where the reference being resolved was written, for a lookup that is handed a name and no
    // position. **An edge of the module graph is made by whichever lookup first finds a name in
    // another module**, and most of those are asked by spelling alone; the form that wrote the name
    // says where it is around the lookup and takes it back afterwards, so it is empty everywhere a
    // form has not said.
    reference_at: Span

    // What the declaration whose body is being read asked for in its `@needs(...)`, with the
    // capabilities each implies, and whether that declaration is a test. **A reference made there is
    // charged to whoever reaches the declaration, not to its module** -- so an edge it makes says
    // nothing about what the module needs. Set where a function's body is read and put back after.
    reaching_needs: Buf[string]
    reaching_test: bool

    // Every edge of the module graph again, told apart by what the code that made it is: one entry
    // per edge, per set of capabilities its declaration needs, per whether it was scaffolding. **What
    // a module requires is read from these rather than from `module_edges`**, which keep only the
    // first reference to each edge and so cannot say whether every reference to it was made inside a
    // `@needs` declaration or a test.
    capability_refs: Buf[CapabilityRef]

    // Every lowered body read inside a declaration that wrote `@needs(...)`, by the name it was
    // lowered under, with what that declaration needs. The declaration check leaves such a body alone
    // for those capabilities.
    body_covers: Buf[(string, Buf[string])]

    // The modules filed under the **project's** names rather than under a package's prefix: the
    // project's own and every `--lib` source root's, the standard library's left out. They are the
    // first level of the *project's* precedence and of no other package's (`reference/packages.md
    // § Imports are transitive`), so a dependency's file may not reach one by writing its name --
    // only through a binding its own manifest made, which is how a root standing in for a
    // coordinate reaches the packages that named it (`packages.sysl`'s `in_package`).
    project_modules: Buf[string]

    // Every block marked `override`, held until every `impl` is registered: the block it replaces may
    // be written below it or in a module hoisted after it, so whether there is one is asked once the
    // table is whole (`hoist_impl.sysl`'s `check_impl_overrides`).
    override_checks: Buf[OverrideCheck]

    // Every lowered body read inside a `@test` or hook declaration, by the name it was lowered under:
    // a test written beside what it tests is scaffolding, and answers to the tests' clause as a
    // `@tests` file's body does.
    test_bodies: Buf[string]

    // Every function written `const`, by the name its body is typed under: a declaration's key, a
    // member's lowered name, a nested function's, and each instantiation of a generic one. **Filed
    // where the name is made and never taken back** -- a rewound reading of a generic body still
    // names instantiations, and whether one of them is `const` is a fact about its declaration.
    const_fns: &Table[bool]

    // Every type a `@tests` file declares, as `file` and `name` joined by a NUL: an `impl` in such a
    // file is allowed only for a type this table holds under that same file, since a type no build
    // but a test build keeps cannot answer differently in the program that ships.
    test_file_types: Buf[string]

    // Every `asm` block written at the top of a file, its arm chosen for the target, in the order the
    // files were read (`asm.sysl`'s `check_module_asm`).
    module_asm: Buf[TModuleAsm]

    // Every generic nested function, by the name its group lowered it under and by the name of each
    // instantiation a call made of it (`nested.sysl`'s `NestedGeneric`).
    nested_generics: &Table[&NestedGeneric]

    // Whether a key is one this compilation has a declaration for, whatever kind.
    declares_type(self, key: string) -> bool = self.types.has(key)

    // Which module a key belongs to.
    module_of_key(self, key: string) -> string = module_of(key)

    // Whether this compilation has files for a module.
    has_module(self, name: string) -> bool
        for item in self.modules
            if item == name then return true

        false
    end has_module
end Tables

// Empty tables for one target.
tables_for(t: Target) -> &Tables =
    Tables(t, layout_for(t), buf(), table(), table(), table(), table(), table(), table(), table(),
           table(), table(), table(), buf(), table(), table(), table(), table(), table(), table(),
           buf(),
           buf(), buf(), buf(), buf(), buf(), buf(), buf(), buf(), buf(), "", buf(), buf(), buf(),
           table(),
           member_tables(),
           buf(),
           table(),
           table(),
           buf(),
           span_zero(),
           buf(), false, buf(), buf(),
           buf(),
           buf(),
           buf(),
           table(),
           buf(),
           buf(),
           table())

// One `override impl` still to be held to there being something for it to override: the type as a
// reader spelled it, the promise the block makes, the type it covers, and where to point.
struct OverrideCheck
    label: string
    bound: Bound
    subject: Type
    span: Span
    scope: Scope

// One trait a registered `impl` block still owes the implementing type, and everything a refusal
// about it has to name: the type as a reader spelled it, the trait that asked, the trait it asked
// for, the type the block covers, and where to point.
struct SuperCheck
    label: string
    required: string
    sup: Bound
    subject: Type
    span: Span
    scope: Scope
    // Empty for a required trait; otherwise the associated type whose supplied type `subject` is,
    // held to the bound the trait wrote on it (`type W: Word`) -- the same question, one step over,
    // and held for the same reason: the block answering it may be written below.
    assoc: string
end SuperCheck

// The names a compilation has produced, held behind a reference so that the undo log can put a
// trial's back.
//
// **The list is the order and the set is the question**: a walk over what was reached reads the
// names in the order they were first produced, and "was this one produced" is asked at every call
// the analysis types, so it has to be one lookup rather than a scan of everything produced so far.
// The two hold exactly the same names, and `forget_past` is what keeps them so across a rewind.
struct Reached
    names: Buf[string]
    seen: Set[string]

    holds(self, name: string) -> bool = self.seen.has(name)

    // Puts the names back to the first `mark`, taking the ones past it out of the set as well -- a
    // rewound reading that left one in the set would have a later reading find a name reached that no
    // reading reached.
    forget_past(*self, mark: usize)
        for i in mark..<self.names.len()
            self.seen.remove(self.names.at(i))

        self.names.truncate(mark)
    end forget_past
end Reached

// Nothing reached yet.
private reached_none() -> &Reached = Reached(buf(), set())

// Records a name in one of the reached sets, through the undo log when a trial is open. A name is
// kept once.
private note_reached(names: &Reached, journal: &Journal, name: string)
    if !names.seen.add(name) then return

    val mark = names.names.len()

    if journal.recording() then journal.record(() -> names.forget_past(mark))

    names.names.push(name)
end note_reached

// The analyzer's state while the declarations are being read: the tables, what it has to say, and
// the undo log a speculative walk rewinds through.
//
// **There are no exceptions in sysl, so a failure is recorded and answered with a fallback** rather
// than thrown and caught. The reference compiler's `err` throws an `AnalyzerError` that `recover`
// turns into a recorded diagnostic and a fallback value; here `fault` records the same diagnostic
// and the caller answers with the same fallback, which is the same control flow written out. What
// is kept exactly is the *set*: a diagnostic is recorded once however many times it is reached.
struct Analysis
    tables: &Tables
    found: Buf[Placed]
    warned: Buf[Placed]
    journal: &Journal

    // What a trial that is thrown away still says. See `bound_fault`.
    kept: Buf[Placed]

    // How many closures have been lowered, which is what makes each one's name its own.
    //
    // **It counts over the whole compilation, and a thrown-away trial does not put it back.** A
    // closure's name has to be unique among everything the compilation lowered, and a walk that was
    // rewound still asked for one -- so the counter runs forward whatever becomes of the tree that
    // walk built.
    closure_count: usize

    // How many environments have been built, which is what makes each block's own name unique.
    env_count: usize

    // How many indirections the resolution being run has crossed, and how many type-argument lists
    // it is inside. **A type reached again through a pointer, a reference, a weak reference or a
    // slice is a finite type**, and one reached again by value is not -- so the two counts, compared
    // against where the type was entered, are the whole of what tells a legal cycle from a shape
    // with no size. `resolving` records where each in-progress instantiation was entered.
    indirection: usize
    type_arg_depth: usize
    resolving: Buf[(string, usize, usize)]

    // The constants being folded, outermost first. **A `const` is its value**, so reading one reads
    // whatever it was written in terms of -- and one written in terms of itself would be followed
    // for ever. This is what makes the loop something to report rather than something to run out of
    // stack on.
    consts_in_progress: Buf[string]

    // The declarations whose parameter defaults are being filled, outermost first. A default may call
    // the declaration it belongs to, or one whose default calls back -- and filling it would fill it
    // again for ever. See `fill_default`.
    defaults_filling: Buf[string]

    // The `call` bodies those closures lowered to, in the order they were lowered. They are
    // functions of the compilation like any other, and go after everything a program declared.
    closure_funcs: Buf[TFunc]

    // The closures whose body only READS its captures, by the struct's name. `call` takes `*self`
    // for every closure alike, and the address is what a call on a `val` would be refused for -- but
    // a body with no store through `self` uses it for nothing but reading, so a closure bound by a
    // `val` is callable exactly when it is in here.
    read_only_closures: Set[string]

    // Every function name this compilation has **produced** -- at a call, at an address, or as the
    // entry the platform runs. It is what says which of the library's bodies the program reaches:
    // the library is analyzed on demand, so nothing reaches its printing surface in a program that
    // never prints.
    //
    // **It is written through the undo log**, which is what keeps a trial from reaching anything: a
    // reading that was thrown away asked a question, and the call it wrote down while asking is not
    // one the program makes.
    reached: &Reached

    // The library files this compilation is **producing** rather than being handed.
    //
    // **A library is read from source and named for its place in the library**, so what usually
    // says a declaration is the standard module's is the file it came from -- and that answer is
    // the wrong one for the one compilation whose subject *is* the library. A build of the library
    // itself has to type every body it declares, not only the ones something in the library
    // happens to reach, or the artifact it produces would hold whatever the library's own internal
    // calls happened to ask for.
    producing: Buf[string]

    // The `extern`s something in this compilation actually calls, **in the order they were first
    // reached**, which is neither the order they were written nor the order the names above are in.
    //
    // It is a set of its own because it is filled at a different moment: a call records the extern
    // it is *about to* make before it analyzes its arguments, so `take(give())` reaches `take`
    // first. That order is the order the `declare` lines come out in, so it is a fact about the
    // emitted text rather than bookkeeping.
    externs_reached: &Reached

    // The `extern` **variables** something reads or writes, on the same terms. Storage the linker
    // supplies is declared rather than laid down, and only the ones a body reaches are declared, so
    // it is the same accounting the calls above get and a set of its own for the same reason.
    extern_vars_reached: &Reached

    // How many times a constant's fold has refused -- a division by zero, a shift out of range, a
    // conversion that fails -- counting a refusal said again as much as one said first.
    //
    // **A refused constant is one mistake however many places read it**, and the complaint is placed
    // at the sub-expression that made it, so every later read raises the very same complaint and the
    // report keeps one. What that leaves a reader of the fold unable to see is *whether* it refused:
    // the report did not grow. This is what it compares instead, so a use -- or a constant written in
    // terms of the refused one -- says nothing of its own about a value that is not constant.
    const_refusals: usize

    // Every constant found in a loop of definitions, with the one the loop was told at and what it was
    // told: `(member, told at, message)`. A loop is one mistake, told once where the walk closed it, so
    // a later read of any of its members raises that same complaint rather than one of its own.
    const_cycles: Buf[(string, string, string)]

    // How many **recovery regions** are open -- a function's body, and each statement of a block.
    // Outside every one of them (a signature, a module's storage) a mistake abandons nothing.
    regions: usize

    // Where the innermost open region made its first mistake, if it has: how many complaints there
    // were just before it, and how many just after. See `open_region`.
    poison: Option[(usize, usize)]

    // Whether every type's fields are in, which is when what a `&sync T` promises about its pointee
    // can be asked. **A type that reaches itself through a `&sync` field is resolved while its own
    // field list is still being filled**, so asking then would find nothing in the way of anything.
    types_hoisted: bool

    // The pointees of the `&sync T`s written before that question could be answered, each with where
    // it was written. Drained once, as soon as the answer is available. See `check_shared`.
    shared_checks: Buf[(Type, Scope, Span)]

    // Set while a trait implementation's member signature is resolved. **That signature is the
    // trait's promise restated**, and the trait's own signature is where a `&sync T` in it is held to
    // the rule -- so the restatement is not asked again, as the reference does not ask it.
    shares_asked_at_trait: bool

    // The definition index an editor asked for, and nothing for every build -- which is the whole of
    // what it costs a build. See `definition_index.sysl`.
    index: Option[&DefinitionIndex]

    // Modules auto-imported beside the standard one, each a wildcard every file gets with no `import`
    // written -- and only where the compilation holds that module, so a program compiled without it is
    // untouched. **Nothing a command line says fills this**: a shipped compiler auto-imports the
    // standard module alone, and the list exists so that the mechanism can be proved on a library
    // nothing else depends on (`tests_dlb_dev_library.sysl`).
    also_auto_imported: Buf[string]

    // The declaration's own parameters standing in for themselves **carrying every bound they were
    // given**, while the declaration's signature, members or fields are read at them -- empty
    // everywhere else. A trait applied there to one of them (`f[Y](x: &Get[Y])`) is held to the
    // trait's own bounds at once, since a stand-in equal to the one here is final rather than
    // scaffolding. See `check_trait_arg_bounds`.
    settled: Buf[Binding]

    // Every value that crossed into another concurrency domain holding a task, noted where it crossed
    // and answered once every body is typed, a task's frame being a fact about a body. See
    // `task_domains.sysl`.
    task_crossings: Buf[TaskCross]

    // The parameters each typed body's declaration names in `@crossing`, by the body's key: a task
    // read from one has been held to the rule by every caller.
    crossing_params: &Table[Buf[string]]

    // What running `const` functions while compiling keeps: the bodies typed for it and what each
    // call came to (`const_eval.sysl`).
    evaluation: &ConstEvaluation

    // Whether the fields being laid out belong to an instantiation whose arguments failed the
    // declaration's own bounds. That failure was refused where the arguments were written, so an
    // application inside those fields failing too is the same mistake seen from inside the type --
    // and reported there it would land on a declaration that is not wrong. See `applied_bounds`.
    quiet_bounds: bool

    // The same question while it cannot be answered yet: the held check of the instantiation whose
    // fields are being laid out, which every application met in them is held after
    // (`DeferredBound.after`).
    bound_after: Option[usize]

    // Records a name as produced. The set is what matters and not the order, but the order is what
    // a walk over it reads, so a name is kept once.
    uses(*self, name: string) = note_reached(self.reached, self.journal, name)

    // Records an `extern` as reached, on the same terms and through the same undo log.
    uses_extern(*self, name: string) = note_reached(self.externs_reached, self.journal, name)

    // Records an `extern` variable as reached, on the same terms and through the same undo log.
    uses_extern_var(*self, name: string) = note_reached(self.extern_vars_reached, self.journal, name)

    // The externs reached so far, in the order they were first reached.
    externs_used(self) -> Buf[string] = self.externs_reached.names

    // The `extern` variables reached so far, in the order they were first reached.
    extern_vars_used(self) -> Buf[string] = self.extern_vars_reached.names

    // Whether a name has been produced.
    used(self, name: string) -> bool = self.reached.holds(name)

    // The names produced so far, in the order they were first reached.
    funcs_used(self) -> Buf[string] = self.reached.names

    // Records an error about a place that a **thrown-away trial must keep**, which is the one kind
    // of complaint the walk over a generic body at its own definition makes.
    //
    // Nothing else will ever check those: an instantiation resolves the same call against a concrete
    // implementation instead, so a mistake in what a bound licenses is caught at the definition or
    // nowhere. Every other complaint that walk makes is one an instantiation raises again, and is
    // dropped with the rest of the trial.
    bound_fault(*self, scope: Scope, span: Span, message: string)
        if self.poison.is_some() then return

        val d = placed_error(scope.src, span, message)

        if !already_said(self.kept, d) && !already_said(self.found, d) then self.kept.push(d)
    end bound_fault

    // Records an error about a place, unless the same thing has already been said about it.
    //
    // Inside a recovery region the first one is also where that region gives up: it is still
    // recorded, and so is anything after it, because a trial reading counts complaints to learn
    // whether it failed -- but `close_region` takes back everything the region said after it.
    fault(*self, scope: Scope, span: Span, message: string)
        val d = placed_error(scope.src, span, message)
        val before = self.found.len()

        if !already_said(self.found, d) then self.found.push(d)

        if self.regions > 0 && self.poison.is_none() then self.poison = Some((before, self.found.len()))
    end fault

    // Records an error about the program as a whole, which is printed with no position: `span`
    // orders it in the report and is never shown. Nothing that calls it is inside a region.
    fault_unplaced(*self, scope: Scope, span: Span, message: string)
        val d = unplaced_error(scope.src, span, message)

        if !already_said(self.found, d) then self.found.push(d)

    // Records a mistake about where something was WRITTEN rather than about what it means, which
    // abandons nothing: the region carries on reading, so a second such clause in it is told too.
    fault_in_place(*self, scope: Scope, span: Span, message: string)
        val d = placed_error(scope.src, span, message)

        if !already_said(self.found, d) then self.found.push(d)

    // Gives up on the region being read without saying anything, because what led here already did:
    // a value whose type could not be worked out -- a name whose declaration failed, a call refused
    // over its arguments -- is a consequence of a mistake reported where it was made.
    //
    // **Nothing is recorded**, so a trial reading that counts complaints does not see it: the
    // abandonment is about what the region goes on to say, and a trial is asking a different question.
    // Its two lengths are equal, which is what tells it from a mistake that was recorded.
    poison_quietly(*self)
        if self.regions == 0 || self.poison.is_some() then return

        self.poison = Some((self.found.len(), self.found.len()))

    // Opens a recovery region, answering what the enclosing one had found so `close_region` can put
    // it back.
    //
    // **A region is what one mistake costs.** Its first refusal abandons the rest of it, so a second
    // refusal later in the same statement -- another operand, a later argument, the other branch of
    // an `if`, another arm of a `match` -- is not told. What starts afresh is a region inside it: a
    // block's statements are each one, and a block's trailing expression belongs to whatever the
    // block is the value of. A region opened after the enclosing one gave up is given up with it.
    open_region(*self) -> Option[(usize, usize)]
        val outer = self.poison

        self.regions += 1
        self.poison = None
        outer
    end open_region

    // Closes a region: everything it said after its first mistake is taken back, and the enclosing
    // region carries on as it was.
    close_region(*self, outer: Option[(usize, usize)])
        if self.poison.is_some() && self.found.len() > self.poison.unwrap().1 then
            self.found.truncate(self.poison.unwrap().1)

        self.regions -= 1
        self.poison = outer
    end close_region

    // The same, for something that is not a reason to stop.
    caution(*self, scope: Scope, span: Span, message: string)
        val d = placed_warning(scope.src, span, message)

        if !already_said(self.warned, d) then self.warned.push(d)

    // How many complaints have been recorded, which is what an attempt compares across a trial.
    complaints(self) -> usize = self.found.len()

    // Whether this message has already been said about a place that ENCLOSES this one -- a rule
    // asked once of a whole declaration and again of each type in it as the type is resolved says
    // one thing, at the declaration, rather than the same sentence twice.
    said_around(self, scope: Scope, span: Span, message: string) -> bool
        for f in self.found
            if f.src.name == scope.src.name && f.diag.message == message &&
                    f.diag.span.start <= span.start && span.end <= f.diag.span.end then return true

        false
    end said_around

    // Everything to say, in the order a reader reads it -- what a walk that was otherwise thrown away
    // kept, and what the walk found.
    //
    // **The kept ones go first because they were SAID first**: a generic body is walked at its
    // definition before any body that calls it, so where that walk and an instantiation complain at
    // one place, the definition's complaint is the earlier one and the source order keeps it so --
    // `T.word_rounds()` in an unbounded body is told about the bound before an instantiation is told
    // that `uint`'s member is private, as the reference tells it.
    diagnostics(self) -> Buf[Placed]
        var all: Buf[Placed] = buf()

        for item in self.kept
            if !already_said(self.found, item) then all.push(item)

        for item in self.found
            all.push(item)

        in_source_order(all)
    end diagnostics

    warnings(self) -> Buf[Placed] = in_source_order(self.warned)

    // Puts the complaints back to what they were, which is what a trial that is thrown away owes.
    //
    // A mistake the trial made is taken back with it, and so is the region's giving up over it. A
    // quiet abandonment at exactly `n` is kept: nothing tells one made inside the trial from one made
    // just before it, and the trial read the same value the region's own reading goes on to read.
    restore_complaints(*self, n: usize)
        self.found.truncate(n)

        if self.poison.is_some()
            val at = self.poison.unwrap()

            if at.0 > n || (at.0 == n && at.1 > at.0) then self.poison = None
        end if
    end restore_complaints

    // Runs a trial with everything it writes recorded, and puts all of it back afterwards.
    //
    // It is the one of the three that is always undone: it is asked to find something out, never to
    // build anything.
    sandboxed(*self) -> usize = self.journal.enter()

    // Closes what `sandboxed` opened, undoing every write made inside it.
    release(*self, mark: usize)
        self.journal.rewind(mark)
        self.journal.leave()

    // Closes it keeping every write, which is what a trial that came out owes: a node carried out
    // of a reading that was thrown away would name instantiations nothing built.
    keep(*self)
        self.journal.leave()
end Analysis

// Whether a report already carries a complaint about the same place.
private already_said(all: Buf[Placed], d: Placed) -> bool
    for a in all
        if a.src.name == d.src.name && a.diag.span.start == d.diag.span.start &&
                a.diag.message == d.diag.message then return true

    false
end already_said

// An analysis over empty tables.
analysis_for(t: Target) -> &Analysis = analysis_producing(t, buf())

// The same, told which library files this compilation is producing rather than being handed. See
// `Analysis.producing`.
analysis_producing(t: Target, producing: Buf[string]) -> &Analysis =
    Analysis(tables_for(t), buf(), buf(), journal(), buf(), 0, 0, 0, 0, buf(), buf(), buf(), buf(),
             set(), reached_none(), producing, reached_none(), reached_none(), 0, buf(), 0, None,
             false, buf(), false, None, buf(), buf(), buf(), table(), const_evaluation(), false,
             None)

// -- how far a declaration reaches ---------------------------------------------------------------

// Whether a declaration is reachable from a file.
//
// **`private` is file-private**, so a module split across files has a public seam between them: a
// helper another file of the same module needs cannot be `private`.
reachable(a: Access, from: Scope) -> bool = a.vis match
    Public -> true
    File -> a.file == from.src.name
    Scoped(name) -> widened_to(a.module_name, name) match
        // A scope naming nothing is refused where it is written, and the declaration it was written
        // on still stands: one mistake is one diagnostic, so every use of the name goes on being
        // read rather than each becoming a second complaint about it.
        None -> true
        Some(m) -> beneath(from.module_name, m)

// Whether a name written bare is one an import clause of this file brought in by name, as `key`.
//
// **Such a name was refused at the clause when it is out of reach** (`import_name`), and the clause is
// the line a reader has to change -- so every use of the name goes on being read as though it were
// reachable, rather than each becoming a second complaint about the one mistake.
refused_at_import(from: Scope, written: string, key: string) -> bool
    val names = from.imports.names

    for item in names
        if item.0 == written && item.1 == key then return true

    false
end refused_at_import

// The module a `private[M]` widens to, read OUTWARD from the module the declaration is in with the
// first hit winning -- so a segment written twice binds to the innermost one, and the declaration's
// own module counts as enclosing itself.
widened_to(declared_in: string, name: string) -> Option[string]
    if declared_in == ModuleRoot then return None

    var at = declared_in

    loop
        val cut = last_dot_in(at)
        val leaf = cut match
            None -> at
            Some(i) -> at[(i + 1)..<at.bytes.len]

        if leaf == name then return Some(at)

        cut match
            None -> return None
            Some(i) -> at = at[0..<i]
end widened_to

// Whether a module is the one named or somewhere under it.
beneath(here: string, top: string) -> bool =
    here == top || here.starts_with(s"$top.")

// What a diagnostic says about a name the reader may not reach.
private_to(key: string, file: string) -> string =
    s"'${qualified_name(key)}' is private to '$file', the file that declares it"

// The same for the wider form, which names a module rather than a file.
private_to_module(key: string, at: string) -> string =
    s"'${qualified_name(key)}' is private to module '$at'"

// The key a **field or a member** of `owner` is filed under, in the same table a top-level
// declaration's reach is. A declaration's own name never holds a dot, so no top-level key can
// collide with one of these.
member_access_key(owner: string, name: string) -> string = s"$owner.$name"

// Whether a field or a member of `owner` is one this scope may name.
member_in_reach(a: &Analysis, owner: string, name: string, from: Scope) -> bool =
    a.tables.access.get(member_access_key(owner, name)) match
        None -> true
        Some(acc) -> reachable(acc, from)

// Why a member may not be named here -- the tail of the sentence, the head being what kind of member
// it is and whose. The two levels read differently: the file form names the file, the wider one the
// module it widened to.
member_restriction(a: &Analysis, owner: string, name: string) -> string =
    a.tables.access.get(member_access_key(owner, name)) match
        None -> "private"
        Some(acc) -> acc.vis match
            Scoped(scoped) -> widened_to(acc.module_name, scoped) match
                None -> s"private to '${acc.file}', the file that declares it"
                Some(m) -> s"private to module '$m'"
            _ -> s"private to '${acc.file}', the file that declares it"

// How far a name reaches, which for a variant is its enum's and for everything else its own.
access_for(a: &Analysis, key: string) -> Option[Access] = a.tables.access.get(key) match
    Some(acc) -> Some(acc)
    None -> enum_of_variant(a, key) match
        None -> None
        Some(owner) -> a.tables.access.get(owner)

// What a reader is told about a name it may not reach, which is a different sentence at each of the
// two levels: the file form names the file, the wider one the module it widened to.
out_of_reach(a: &Analysis, key: string) -> string
    val acc = access_for(a, key).unwrap()

    acc.vis match
        Scoped(name) -> widened_to(acc.module_name, name) match
            None -> private_to(key, acc.file)
            Some(m) -> private_to_module(key, m)
        _ -> private_to(key, acc.file)
end out_of_reach

// What a `private[M]` naming no enclosing module is told, at the declaration that wrote it.
scope_names_nothing(name: string, declared_in: string) -> string =
    if declared_in == ModuleRoot then
        s"this file is at the project root, whose module has no name, so there is no '$name' to " +
        "widen to — 'private' on its own is this file"
    else s"'$name' is not '$declared_in' or one of its ancestors, and 'private[M]' widens to a " +
         "module the declaration is already inside"
