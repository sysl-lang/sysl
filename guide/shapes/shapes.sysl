// A catalogue of shapes behind one trait — the dynamic half of `02`.
//
// Every other program in the set knows the type of everything it computes with. This one does not,
// and that is the whole exercise: a `&Shape` is a fat pointer that has forgotten what it points at,
// and the only thing left to do with it is ask the trait's questions and believe the answers.
//
// The shapes come in two families, and the second is the reason the problem is worth writing. Four
// of them are *leaves* — a circle, a rectangle, a triangle, a polygon — and each answers out of its
// own fields. The other three are *combinators*: a group is a shape made of shapes, and a move and a
// scale each wrap one shape and adjust what it says. A combinator holds `&Shape`, so it holds
// something it cannot name, and a group of groups is dynamic dispatch calling itself.

import sysl.buf.{Buf, byte_sink}
import sysl.math.{max, min, pi, Float}

struct Point
    x: f64
    y: f64

distance(a: Point, b: Point) -> f64
    var dx = a.x - b.x
    var dy = a.y - b.y

    dx.hypot(dy)

// An axis-aligned bounding box. It is a plain struct rather than a shape, because a bound is the
// answer to a question about a shape and not another thing to dispatch on.
struct Box
    x0: f64
    y0: f64
    x1: f64
    y1: f64

    width(self) -> f64 = self.x1 - self.x0

    height(self) -> f64 = self.y1 - self.y0

    // The smallest box containing both, which is what a group's bound is built out of.
    join(self, other: Box) -> Box =
        Box(min(self.x0, other.x0), min(self.y0, other.y0),
            max(self.x1, other.x1), max(self.y1, other.y1))

    // Whether this box is inside that one, allowing for the last bit of a float.
    within(self, other: Box) -> bool =
        self.x0 >= other.x0 - 0.000001 && self.y0 >= other.y0 - 0.000001 &&
        self.x1 <= other.x1 + 0.000001 && self.y1 <= other.y1 + 0.000001
end Box

// What a trait object has forgotten, written down by hand.
//
// There is no way to ask a `&Shape` what it was made from — no cast, no test, no pattern, and no
// syntax that would express one. A catalogue that wants to count its circles therefore has to have
// been told, so the trait asks every shape to say what it is and every implementation answers with
// a constant. It works, and it is a hand-maintained copy of a fact the vtable pointer already
// carries exactly.
enum Kind
    Circular
    Rectangular
    Triangular
    Polygonal
    Composite
    Displaced
    Resized

    name(self) -> string = self match
        Circular -> "circle"
        Rectangular -> "rect"
        Triangular -> "triangle"
        Polygonal -> "polygon"
        Composite -> "group"
        Displaced -> "moved"
        Resized -> "scaled"
end Kind

// The trait the catalogue is built on.
//
// `kind` is a property — a member with no parameter list, read as `s.kind`. `02` says a property is
// object-safe because it carries a receiver it never spells, and this is where that is spent: the
// read goes through the object's table exactly as a call does.
//
// `Shape` **requires** `Display`, and that one word is what makes a catalogue of erased values
// printable. A bound may name several traits because a bound is a list; a trait-object type names
// one because it is a type, so without the requirement a `&Shape` would offer the four members
// below and nothing else — and every shape here implements `Display` perfectly well. The
// requirement is also what puts `display` in the object's table, so `print(s)` on a `&Shape` is one
// indirect call and no different from `s.area()`.
//
// `render` is the shape's parts with no field around them. It stays a member of its own because
// `Display` is *those parts placed in the field the specifier asked for* — two operations, and the
// padding is worth writing once rather than seven times.
trait Shape: Display
    area(self) -> f64
    perimeter(self) -> f64
    bounds(self) -> Box
    kind -> Kind
    render(self, out: *Writer)

// A number as text, to six decimals. This is the one thing on the rendering path that still builds a
// string: `%.6f` is a fixed-point conversion and the sink family renders a real as `%g`, which is
// significant digits. `14 §2` decided that the conversion letter does not cross into a `Display` —
// only a width, a precision, and a justification do — so a fixed-point rendering into a sink has
// nowhere to be asked for.
six(x: f64) -> string = f"$x%.6f"

// The specifier a part is rendered with: no width, no precision, no justification. `14 §2` is
// explicit that a part gets the neutral one and the whole value gets the caller's.
plain() -> FormatSpec = FormatSpec(0, -1, false)

// A `Display` for a shape is its rendering put in the field the specifier asked for. `14 §2` says
// the field belongs to the whole value rather than to each part, so the parts are gathered before
// any padding is applied — which is what `sysl.buf`'s `byte_sink` is for.
//
// It is written **once, over the bound**, because the gather-and-pad is the same for every shape.
// Note what is no longer here: this program used to carry a `describe(s: &Shape) -> string` beside
// it, doing the same gathering a second time, because an erased shape could not be handed to `str`.
// It can now — the requirement put `display` in the object's table — so `str(s)` is the whole of it.
display_shape[T: Shape](x: T, out: *Writer, fmt: FormatSpec)
    var g = byte_sink()

    x.render(&g)
    display_pad(g.text(), out, fmt)

// -- the leaves ------------------------------------------------------------------------------

struct Circle
    cx: f64
    cy: f64
    r: f64

impl Shape for Circle
    area(self) -> f64 = pi * self.r * self.r
    perimeter(self) -> f64 = 2.0 * pi * self.r
    bounds(self) -> Box = Box(self.cx - self.r, self.cy - self.r, self.cx + self.r, self.cy + self.r)
    kind -> Kind = Circular
    render(self, out: *Writer)
        out.write("circle(r=".bytes)
        out.write(six(self.r).bytes)
        out.write(")".bytes)

struct Rect
    x: f64
    y: f64
    w: f64
    h: f64

impl Shape for Rect
    area(self) -> f64 = self.w * self.h
    perimeter(self) -> f64 = 2.0 * (self.w + self.h)
    bounds(self) -> Box = Box(self.x, self.y, self.x + self.w, self.y + self.h)
    kind -> Kind = Rectangular
    render(self, out: *Writer)
        out.write("rect(".bytes)
        out.write(six(self.w).bytes)
        out.write("x".bytes)
        out.write(six(self.h).bytes)
        out.write(")".bytes)

struct Tri
    a: Point
    b: Point
    c: Point

impl Shape for Tri
    // Twice the signed area is the cross product of two edges; the sign says which way round the
    // vertices were given, and a shape has no opinion about that.
    area(self) -> f64
        var twice = (self.b.x - self.a.x) * (self.c.y - self.a.y) -
                    (self.c.x - self.a.x) * (self.b.y - self.a.y)

        if twice < 0.0 then -twice / 2.0 else twice / 2.0

    perimeter(self) -> f64 =
        distance(self.a, self.b) + distance(self.b, self.c) + distance(self.c, self.a)

    bounds(self) -> Box
        var b = Box(self.a.x, self.a.y, self.a.x, self.a.y)

        b = b.join(Box(self.b.x, self.b.y, self.b.x, self.b.y))
        b.join(Box(self.c.x, self.c.y, self.c.x, self.c.y))

    kind -> Kind = Triangular
    render(self, out: *Writer) = out.write("triangle".bytes)

// A closed polygon through its vertices, in order.
struct Poly
    pts: &Buf[Point]

impl Shape for Poly
    // The shoelace formula: twice the signed area is the sum of the cross products of consecutive
    // vertices taken around the loop.
    area(self) -> f64
        var twice = 0.0

        for i in 0..<self.pts.len()
            var p = self.pts[i]
            var q = self.pts[(i + 1) % self.pts.len()]

            twice += p.x * q.y - q.x * p.y

        if twice < 0.0 then -twice / 2.0 else twice / 2.0
    end area

    perimeter(self) -> f64
        var t = 0.0

        for i in 0..<self.pts.len()
            t += distance(self.pts[i], self.pts[(i + 1) % self.pts.len()])

        t
    end perimeter

    bounds(self) -> Box
        var p = self.pts[0]
        var b = Box(p.x, p.y, p.x, p.y)

        for i in 1..<self.pts.len()
            var q = self.pts[i]

            b = b.join(Box(q.x, q.y, q.x, q.y))

        b
    end bounds

    kind -> Kind = Polygonal
    render(self, out: *Writer)
        out.write("polygon(".bytes)
        self.pts.len().display(out, plain())
        out.write(")".bytes)

// -- the combinators -------------------------------------------------------------------------

// A shape made of shapes. Its own answers are computed by asking each part, and a part may itself
// be a group, so the recursion goes through the object's table and not through a name.
struct Group
    parts: &Buf[&Shape]

impl Shape for Group
    area(self) -> f64
        var t = 0.0

        for i in 0..<self.parts.len() do t += self.parts[i].area()

        t
    end area

    perimeter(self) -> f64
        var t = 0.0

        for i in 0..<self.parts.len() do t += self.parts[i].perimeter()

        t
    end perimeter

    bounds(self) -> Box
        var b = self.parts[0].bounds()

        for i in 1..<self.parts.len() do b = b.join(self.parts[i].bounds())

        b
    end bounds

    kind -> Kind = Composite

    // The concatenation this used to be was quadratic — a fresh string per part, each copying
    // everything already gathered. Writing into the caller's sink is linear, and the recursion is
    // unchanged: a part is a `&Shape`, so `render` on it goes through the object's table.
    render(self, out: *Writer)
        out.write("group(".bytes)

        for i in 0..<self.parts.len()
            if i > 0 then out.write(", ".bytes)

            self.parts[i].render(out)

        out.write(")".bytes)
    end render

// A shape moved. Area and perimeter are what they were; only the bound moves.
struct Moved
    inner: &Shape
    dx: f64
    dy: f64

impl Shape for Moved
    area(self) -> f64 = self.inner.area()
    perimeter(self) -> f64 = self.inner.perimeter()

    bounds(self) -> Box
        var b = self.inner.bounds()

        Box(b.x0 + self.dx, b.y0 + self.dy, b.x1 + self.dx, b.y1 + self.dy)

    kind -> Kind = Displaced
    render(self, out: *Writer)
        out.write("moved(".bytes)
        self.inner.render(out)
        out.write(")".bytes)

// A shape scaled about the origin. Area goes as the square of the factor and perimeter as the
// factor itself, which is the one law in this program that holds for every shape there could ever
// be — so it is checked through the object, over the whole catalogue, in `main.sysl`.
struct Scaled
    inner: &Shape
    k: f64

impl Shape for Scaled
    area(self) -> f64 = self.inner.area() * self.k * self.k
    perimeter(self) -> f64 = self.inner.perimeter() * self.k

    bounds(self) -> Box
        var b = self.inner.bounds()

        Box(b.x0 * self.k, b.y0 * self.k, b.x1 * self.k, b.y1 * self.k)

    kind -> Kind = Resized
    render(self, out: *Writer)
        out.write("scaled(".bytes)
        out.write(six(self.k).bytes)
        out.write(", ".bytes)
        self.inner.render(out)
        out.write(")".bytes)

// -- rendering ---------------------------------------------------------------------------------
//
// `Shape` requires `Display`, so these seven are not optional: an implementation that left one out
// would be told at the `impl` that it cannot keep the trait's promise. Each is the same one line
// because the work is in `display_shape` — the gathering and the padding are the same whatever the
// shape, and what differs is `render`.

impl Display for Circle
    display(self, out: *Writer, fmt: FormatSpec) = display_shape(self, out, fmt)

impl Display for Rect
    display(self, out: *Writer, fmt: FormatSpec) = display_shape(self, out, fmt)

impl Display for Tri
    display(self, out: *Writer, fmt: FormatSpec) = display_shape(self, out, fmt)

impl Display for Poly
    display(self, out: *Writer, fmt: FormatSpec) = display_shape(self, out, fmt)

impl Display for Group
    display(self, out: *Writer, fmt: FormatSpec) = display_shape(self, out, fmt)

impl Display for Moved
    display(self, out: *Writer, fmt: FormatSpec) = display_shape(self, out, fmt)

impl Display for Scaled
    display(self, out: *Writer, fmt: FormatSpec) = display_shape(self, out, fmt)
