module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.fs.{cache_dir, is_dir, is_file, make_dir_all, make_temp_dir, pending_name, publish_dir, read_text, remove_dir_all, write_text, write_text_atomic}
import sysl.process.capture
import sysl.text.{join, split, Search}

// Getting a package's source onto this machine.
//
// A coordinate is a git repository and a version is a tag on it, so fetching is a clone at a tag and
// nothing more -- there is no registry to ask, no account to have, and no service that has to be up.
// What that costs is two things worth stating rather than glossing: there is nowhere central to
// search, and a repository that disappears takes its package with it. Vendoring answers the second.
//
// **The cache is content-addressed by promise, not by hash.** A fetched package lands under
// `<cache>/sysl/pkg/<coordinate>/@v<version>/`, which is one directory per package and version and
// is shared by every project on the machine. Beside it sits a file holding the tree hash that was
// computed when it was written, so a project whose `sysl.sum` covers a package that some *other*
// project fetched first is still checked, and is checked without walking the tree again. Trusting a
// populated cache blindly is the hole that would make `sysl.sum` a formality on any machine with
// more than one project on it.
//
// The hash file is a **sibling** of the package directory rather than a file inside it, because
// anything inside would be part of what the tree hash covers and the hash cannot cover itself.

// Where a package's source is once it is here, and what it is checked against.
struct Fetched
    root: string
    hash: Option[string]
end Fetched

// The directory every fetched package lives under.
//
// **Under the cache rather than in the project**, because a package at a version is the same bytes
// for every project on the machine and the alternative is one copy each. A project that vendored its
// packages holds them itself, and that answer comes first -- vendoring is for a build that must not
// depend on a cache being warm.
cache_root(project_root: string) -> Result[string, string]
    val vendored = join_path(project_root, VendorDir)

    if project_root != "" && is_directory(vendored) then return Ok(vendored)

    machine_cache_root()
end cache_root

// The machine's own package cache, whether or not some project has a `vendor/` -- what `sysl vendor`
// copies out of.
machine_cache_root() -> Result[string, string] =
    cache_dir() match
        None -> Err("cannot find a cache directory to fetch packages into — set XDG_CACHE_HOME, " +
            "or vendor the dependencies so that nothing has to be fetched")
        Some(dir) -> Ok(s"$dir/sysl/pkg")

// Where this coordinate at this version sits, fetched or not.
fetch_directory(cache: string, coordinate: string, version: Release) -> string =
    s"$cache/$coordinate/@${release_tag(version)}"

// The package's source on disk, cloning it if this machine has not got it, and checked against
// `sums` either way.
//
// Answers with **the hash however it was arrived at** -- computed from the clone, or read from what
// was recorded beside a package already here. Returning it only for a fresh clone would have meant
// that a project depending on a package some other project had already fetched wrote no `sysl.sum`
// line at all, and so was never checked afterwards. Whether the line is *new* is the caller's
// question, and it can only be answered against the sums it holds.
fetch_ensure(dep: &Dependency, sums: &Sums, cache: string) -> Result[Fetched, string]
    if fetches_refused && is_git_dependency(dep) then return Err(not_fetched_here(dep))

    dep.origin match
        // Nothing to fetch and nothing to check: no entry is kept for a directory that is expected
        // to change under you, which is the whole point of developing a package beside its consumer.
        Local(dir) ->
            if is_directory(dir) then Ok(Fetched(dir, None))
            else Err(s"'${dep.label}' is a path dependency, and '$dir' is not a directory")

        // A member is a directory too, found by the workspace rather than written; an unbound one is
        // a manifest nobody read through `bind_members`, which every resolver read does.
        Member(dir, _) ->
            if is_directory(dir) then Ok(Fetched(dir, None))
            else Err(s"'${dep.label}' is a workspace dependency that was never found in a workspace")

        Git(coordinate, version) ->
            val dir = fetch_directory(cache, coordinate, version)

            if is_directory(dir)
                Ok(Fetched(dir, verify_cached(dep, coordinate, version, dir, sums)?))
            else
                Ok(Fetched(dir, Some(clone_at_tag(dep, coordinate, version, dir, sums)?)))
end fetch_ensure

// **Whether the command running reaches the network at all**, which `build-lib` does not: it compiles
// the trees it is handed, so a coordinate no directory stands in for is refused where it would have
// been fetched -- and a copy already in the cache is refused too, being a tree nobody handed it.
// Module storage, set and cleared around the one compilation it governs, for the reason the feature
// request is (`features.sysl`).
private var fetches_refused: bool = false

refuse_fetches(on: bool) = fetches_refused = on

private not_fetched_here(dep: &Dependency) -> string
    val coordinate = dependency_coordinate(dep).unwrap_or(dep.label)

    s"build-lib compiles the trees it is given and fetches nothing, so $coordinate reaches it through " +
        s"a directory — supply a checkout of it as --lib <dir>, or name one with 'path'; either stands " +
        s"in for the coordinate when its $ManifestName names it '${repository_name(coordinate)}'"
end not_fetched_here

// A cache entry checked against `sysl.sum`, by way of the hash recorded when it was written.
//
// **The tree is not walked again.** What is being asked is whether *this* project's record agrees
// with what was verified when the directory was populated, and that question is answered by two
// strings -- walking the tree would answer a different and weaker question, since a cache someone
// had edited would simply hash to whatever it now holds.
private verify_cached(dep: &Dependency, coordinate: string, version: Release, dir: string,
                      sums: &Sums) -> Result[Option[string], string]
    val want = sum_of(sums, coordinate, version)
    val got = recorded_hash(dir)

    if want.is_none() then return Ok(got)

    // A directory with no hash beside it was not written by this compiler -- an interrupted fetch,
    // or something a person put there. It is not evidence about anything, so it is refused rather
    // than trusted or silently replaced.
    if got.is_none()
        return Err(s"'$dir' holds $coordinate ${release_tag(version)} but nothing recording what " +
            s"it hashed to, so $SumsName cannot be checked against it — remove that directory and " +
            "build again")

    if want.unwrap() != got.unwrap()
        return Err(hash_mismatch(dep, coordinate, version, want.unwrap(), got.unwrap()))

    Ok(got)
end verify_cached

// Clones at the tag, checks what arrived, and only then puts it where the build will read it.
//
// The clone goes to a sibling directory and is moved into place, so nothing ever reads a directory
// that is half a package: an interrupted fetch leaves the partial one, which is refused on the next
// run rather than compiled. It is a sibling rather than a temporary somewhere else so that the move
// is a rename within one filesystem instead of a copy that can fail halfway.
//
// **The sibling's name is this fetch's own** (`pending_name`): two builds fetching one package at once
// would otherwise clone into one directory, each removing the other's half. Both finish, one rename
// wins, and the other finds the package already there -- the same tag, so the same tree.
private clone_at_tag(dep: &Dependency, coordinate: string, version: Release, dir: string,
                     sums: &Sums) -> Result[string, string]
    val partial = pending_name(dir)
    val url = clone_url(coordinate)
    val tag = release_tag(version)

    make_dir_all(parent_of(dir).unwrap_or(".")).unwrap_or(())
    eprints(s"fetching $coordinate $tag\n")

    // `--depth 1` at the tag: a package is read at one version and its history is not part of what
    // is compiled, so fetching the rest of it is bytes nobody asks for. It also keeps the clone out
    // of the tree hash's way, since `.git` is excluded from that either way.
    //
    // A pinned commit is fetched by its sha the same way, one commit deep: `clone --branch` takes
    // only a ref, so the repository is begun empty and the one commit asked for by name.
    val fetched = fetch_tree(coordinate, version, url, partial)

    if fetched.is_err()
        remove_dir_all(partial).unwrap_or(())
        return Err(fetched.unwrap_err())
    end if

    val hash = tree_hash(partial) match
        Err(why) ->
            remove_dir_all(partial).unwrap_or(())
            return Err(why)
        Ok(got) -> got

    sum_of(sums, coordinate, version) match
        None -> ()
        Some(want) ->
            if want != hash
                remove_dir_all(partial).unwrap_or(())
                return Err(hash_mismatch(dep, coordinate, version, want, hash))

    write_text_atomic(s"$dir.hash", s"$hash\n").unwrap_or(())

    publish_dir(partial, dir) match
        Err(_) ->
            return Err(s"cannot fetch $coordinate $tag: what was cloned could not be moved into " +
                s"'$dir'")
        Ok(_) -> ()

    Ok(hash)
end clone_at_tag

// The whole sha a pin names, which is what selection, the cache and `sysl.sum` all carry.
//
// A whole one is its own answer. A shortened one is lengthened from `sysl.sum` where a recorded pin
// of the coordinate starts with it -- so only the first build asks the network -- and otherwise
// against the repository's own commits. **Several commits starting with it is refused rather than
// one picked**, since which was meant is exactly what the shortening threw away.
full_rev(label: string, coordinate: string, rev: string, sums: &Sums) -> Result[string, string]
    if rev.bytes.len == 40 then return Ok(rev)

    var found = recorded_revs(sums, coordinate, rev)
    val url = clone_url(coordinate)

    if found.is_empty()
        val scratch = make_temp_dir("sysl-rev") match
            Err(_) -> return Err(s"cannot look up '$rev' in $coordinate: no temporary directory")
            Ok(d) -> d

        val listed = commits_of(coordinate, rev, url, s"$scratch/repo")

        remove_dir_all(scratch).unwrap_or(())

        for sha in listed?
            if sha.starts_with(rev) then found.push(sha)
    end if

    if found.len() == 1 then return Ok(found.at(0))

    if found.is_empty()
        return Err(s"'$label' pins $coordinate at '$rev', and no commit of $url starts with it")

    Err(s"'$label' pins $coordinate at '$rev', which starts ${found.len()} commits " +
        s"(${join(found.view(), ", ")}) — write more of the sha")
end full_rev

// Every commit a repository's refs reach, read from a clone with no checkout.
private commits_of(coordinate: string, rev: string, url: string,
                   into: string) -> Result[Buf[string], string]
    git_step(["clone", "--quiet", "--bare", url, into], coordinate, rev, url)?

    val answer = capture("git", ["-C", into, "rev-list", "--all"], "", [], true) match
        Err(_) -> return Err(s"cannot fetch $coordinate $rev: git is not on this machine")
        Ok(got) -> got

    if !answer.status.ok()
        return Err(s"cannot list the commits of $url:\n${answer.err.unwrap_or("").trim()}")

    var out: Buf[string] = buf()

    for line in split(answer.text, "\n")
        if !line.trim().is_empty() then out.push(line.trim())

    Ok(out)
end commits_of

// The tree at a tag or a pinned commit, into `partial`.
private fetch_tree(coordinate: string, version: Release, url: string,
                   partial: string) -> Result[unit, string]
    val tag = release_tag(version)

    if !is_rev(version)
        return git_step(["clone", "--quiet", "--depth", "1", "--branch", tag, url, partial],
                        coordinate, tag, url)

    git_step(["init", "--quiet", partial], coordinate, tag, url)?
    git_step(["-C", partial, "fetch", "--quiet", "--depth", "1", url, version.rev], coordinate, tag,
             url)?
    git_step(["-C", partial, "checkout", "--quiet", "--detach", "FETCH_HEAD"], coordinate, tag, url)
end fetch_tree

// One `git` command of a fetch, or what it said on the way out.
private git_step(args: []const string, coordinate: string, tag: string,
                 url: string) -> Result[unit, string]
    val answer = capture("git", args, "", [], true) match
        Err(_) -> return Err(s"cannot fetch $coordinate $tag: git is not on this machine")
        Ok(got) -> got

    if answer.status.ok() then return Ok(())

    Err(s"cannot fetch $coordinate $tag from $url:\n${answer.err.unwrap_or("").trim()}")
end git_step

// The one diagnostic that says the fetch was not the package that was promised.
//
// It says what to do about it, because the honest answer depends on something the compiler cannot
// know: either the upstream moved and the record should follow it, or the record is right and what
// arrived is not the package.
private hash_mismatch(dep: &Dependency, coordinate: string, version: Release, want: string,
                      got: string) -> string =
    s"'${dep.label}' does not hash to what $SumsName records for $coordinate " +
        s"${release_tag(version)}\n  recorded: $want\n  fetched:  $got\n" +
        "A version's content is not supposed to change. Either the tag was moved and the recorded " +
        "line should be replaced deliberately, or what was fetched is not the package that was " +
        "published."

// The hash written beside a cached package when it was fetched, where there is one.
recorded_hash(dir: string) -> Option[string]
    if !is_file(s"$dir.hash") then return None

    read_text(s"$dir.hash") match
        Err(_) -> None
        Ok(text) ->
            val trimmed = text.trim()

            if trimmed.is_empty() then None else Some(trimmed)
end recorded_hash

// The sums a project carries, or nothing where it carries none.
sums_at(root: string) -> Result[Sums, string]
    val file = join_path(root, SumsName)

    if !is_file(file) then return Ok(empty_sums())

    read_text(file) match
        Err(_) -> Err(s"cannot read $file")
        Ok(text) -> sums_read(text)
end sums_at

// The sums written back where a package was fetched that no line covered.
//
// **Writing it is not fatal.** A read-only checkout should still build, and the alternative is
// refusing to compile over a file that exists to be compared against next time.
write_sums(root: string, sums: &Sums)
    write_text(join_path(root, SumsName), sums_render(sums)) match
        Err(_) -> eprints(s"warning: cannot write $SumsName\n")
        Ok(_) -> ()
end write_sums
