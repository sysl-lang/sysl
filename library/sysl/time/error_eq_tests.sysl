module sysl.time
@tests

@test("eqe: TimeParseError is equal variant by variant and payload by payload")
eqe_time_parse_error()
    assert(TimeParseError.BadShape(1) == TimeParseError.BadShape(1))
    assert(TimeParseError.BadShape(1) != TimeParseError.BadShape(2))
    assert(TimeParseError.Trailing(1) == TimeParseError.Trailing(1))
    assert(TimeParseError.Trailing(1) != TimeParseError.Trailing(2))
    assert(TimeParseError.Trailing(1) != TimeParseError.BadShape(1))
    assert(TimeParseError.OutOfRange("month") == TimeParseError.OutOfRange("month"))
    assert(TimeParseError.OutOfRange("month") != TimeParseError.OutOfRange("day"))
    assert(TimeParseError.OutOfRange("month") != TimeParseError.BadShape(0))

@test("eqe: Result and Option[Result] over TimeParseError compare with ==")
eqe_time_parse_result()
    val r: Result[int, TimeParseError] = Err(TimeParseError.OutOfRange("hour"))
    assert(r == Err(TimeParseError.OutOfRange("hour")))
    assert(r != Err(TimeParseError.OutOfRange("day")))
    assert(r != Ok(24))
    val o: Option[Result[int, TimeParseError]] = Some(r)
    assert(o == Some(Err(TimeParseError.OutOfRange("hour"))))
    assert(o != Some(Err(TimeParseError.Trailing(0))))
