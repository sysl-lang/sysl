module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.math.bigint.from_int

// **A `string` in a body**: what a literal is, what its bytes are, and the runtime calls that join
// two, order two, render a value into one, and ask whether an offset falls between characters.
//
// A `string` *is* an immutable validated `[]u8`, so most of what can be done to one is already the
// view's: its ownership is `emit_arc.sysl`'s and reaching an element or taking a substring is
// `emit_place.sysl`'s. What is here is the part where the bytes have a meaning rather than a length.

// A literal as a value: three words naming bytes that are never freed, so the owner is null and
// counting it costs nothing at run time.
//
// The length leaves out the NUL the interned constant carries. That byte is there so a literal can
// be handed to C without a copy -- it is not where the string ends, which is why a NUL can also
// appear *inside* one as an ordinary byte.
string_value(e: *Emit, s: string) -> Val = string_const(e, s)

// -- the one reader ------------------------------------------------------------------------------
//
// **Every read of a string's first-byte pointer (word 1) and its length (word 2) is made here**, in
// the lowering and in the runtime text alike. A string's owner word (word 0) is ARC's and is read
// where ARC reads it; the other two words say where the bytes are, and the representation is free to
// change what they hold only because no other file reads them. `tests_ssx_a_one_string_reader.sysl`
// holds every other file to that, so a new reader is routed through these or is listed there with
// the reason it can never see a string.
//
// A view that may be either a string or a slice (`[]T`) is read through `view_data`, `view_len` and
// `view_ptr`, which send a string here and read a slice's words directly.

// The bytes of a string and how many there are -- what every operation on its content needs.
str_data(e: *Emit, v: Val) -> (Val, Val)
    val p = str_ptr(e, v)
    val n = str_len(e, v)
    (p, n)
end str_data

// The address of a string's first byte.
//
// **A short string's bytes are in the value, which has no address**, so the value is spilled to a
// slot of its own and the bytes are read at the slot's second word. The slot is this read's alone: two
// strings read for one call (`a == b`) must not share one, and a view taken of the bytes keeps
// pointing at them while the frame lasts. Where the value is long the spill is dead and LLVM drops it.
str_ptr(e: *Emit, v: Val) -> Val
    val p = fresh_reg(e)

    emit(e, InExtract(p, lty(e, Str), v, index_list(1)))

    if !short_strings_on() then return p

    val st = lty(e, Str)
    val slot = alloca(e, fresh_reg(e), st)

    emit(e, InStore(st, v, slot, AccPlain, None))

    val held_at = fresh_reg(e)

    var idx: Buf[IrArg] = buf()

    idx.push(ir_arg(l_i32(), VInt(from_int(long(e.word_bits / 8)))))
    emit(e, InGep(held_at, LInt(8), slot, idx))

    val r = fresh_reg(e)

    emit(e, InSelect(r, str_is_short(e, v), LPtr, held_at, p, l_i1()))
    r
end str_ptr

// How many bytes a string holds.
str_len(e: *Emit, v: Val) -> Val
    val n = fresh_reg(e)

    emit(e, InExtract(n, lty(e, Str), v, index_list(2)))

    if !short_strings_on() then return n

    val top = fresh_reg(e)

    emit(e, InBin(top, OpLShr, word_lty(e), n, VInt(from_int(long(e.word_bits - 8)))))

    val held = fresh_reg(e)

    emit(e, InBin(held, OpAnd, word_lty(e), top, VInt(from_int(127))))

    val r = fresh_reg(e)

    emit(e, InSelect(r, str_is_short(e, v), word_lty(e), held, n, l_i1()))
    r
end str_len

// Whether a string holds its bytes in the value: the top bit of its length word, which no long
// string's length can reach. Only asked where the short form is on.
str_is_short(e: *Emit, v: Val) -> Val
    val n = fresh_reg(e)

    emit(e, InExtract(n, lty(e, Str), v, index_list(2)))

    val sh = fresh_reg(e)

    emit(e, InIntCmp(sh, ISlt, word_lty(e), n, VInt(from_int(0))))
    sh
end str_is_short

// **A string's bytes as a `[]u8` view** -- what `s.bytes` is. With the short form off it is the value
// itself, the same three words.
//
// **Where a string may be short, a view of its bytes that may be kept needs them at an address that
// lasts**, and a short string's bytes have none: they are the value. So the view is made by
// `sysl.str.unshort`, which copies a short string into a `StrBuf` and takes a share of a long one, and
// the statement owns that count like any other temporary -- a binding, a field or a `return` that
// keeps the view takes a share of its own, exactly as it would of a substring. The reads that only
// lend the bytes for the length of one operation -- an index, a length, a `for` over them -- never
// come here: they read the string itself (`bytes_receiver`). Copying only the views that escape is the
// escape analysis's (`docs/design/short-strings.md § 5.4`).
str_bytes_view(e: *Emit, v: Val, ty: Type) -> Val
    if !short_strings_on() then return v

    e.heap = true
    e.maybe_heap = true

    val st = lty(e, Str)
    val fn = request_text(e, "sysl.str.unshort", str_unshort_text(e, str_llvm(e)))
    val r = fresh_reg(e)

    var args: Buf[IrArg] = buf()

    args.push(ir_arg(st, v))
    emit(e, ir_call(Some(r), st, VGlobal(fn), args))
    own_temp(e, r, ty)
end str_bytes_view

// **`sysl.str.unshort`**, the view `str_bytes_view` makes: the string's words as a view that owns a
// count of its own, which the statement gives back. A long string is its own view, with a share
// taken; a short one is copied into a `StrBuf`, whose one count is that share.
private str_unshort_text(e: *Emit, str: string) -> string
    val word = s"i${e.word_bits}"

    request_text(e, "sysl.str.heap", str_heap_text(e, str))

    val read = str_read_text(str, e.word_bits, "%s")
    val p = str_ptr_text(str, "%s")
    val n = str_len_text(str, e.word_bits, "%s")

    s"""
    define private $str @sysl.str.unshort($str %s) {
    entry:
    ${read}  br i1 %s.sh, label %copy, label %keep
    copy:
      %from = $p
      %n = $n
      %made = call $str @sysl.str.heap(ptr %from, $word %n)
      ret $str %made
    keep:
      %owner = extractvalue $str %s, 0
      call void @arc.retain_maybe(ptr %owner)
      ret $str %s
    }
    """
end str_unshort_text

// The string whose bytes `x` reads, where `x` is `s.bytes` and the short form is on: a read that only
// lends them for one operation takes them from the string directly (`str_data`), so it neither
// copies a short string nor takes a share of a long one.
bytes_receiver(x: TExpr) -> Option[TExpr]
    if !short_strings_on() then return None

    *x.kind match
        TBytes(r) -> Some(r)
        _ -> None
end bytes_receiver

// **A short string made of a long one's run of bytes, `n` of them from byte `start`**, without a call
// or a loop: the two words after the owner read as one integer, shifted down by the start and masked
// to the length, with the tag laid in the top byte. Only a run of a short string is ever given here
// (`gen_slice_of` selects this where the source is short and the run is not empty), so the shift and
// the mask are clamped to the capacity rather than trusted to stay inside the integer.
str_short_run(e: *Emit, v: Val, start: Val, n: Val) -> Val
    val st = lty(e, Str)
    val w = word_lty(e)
    val bits = e.word_bits
    val pair = LInt(2 * bits)

    val p1 = fresh_reg(e)

    emit(e, InExtract(p1, st, v, index_list(1)))

    val lo = fresh_reg(e)

    emit(e, InCast(lo, CastPtrToInt, LPtr, p1, w))

    val hi = fresh_reg(e)

    emit(e, InExtract(hi, st, v, index_list(2)))

    val lo2 = fresh_reg(e)

    emit(e, InCast(lo2, CastZExt, w, lo, pair))

    val hi2 = fresh_reg(e)

    emit(e, InCast(hi2, CastZExt, w, hi, pair))

    val hi_up = fresh_reg(e)

    emit(e, InBin(hi_up, OpShl, pair, hi2, VInt(from_int(long(bits)))))

    val both = fresh_reg(e)

    emit(e, InBin(both, OpOr, pair, hi_up, lo2))

    // The start and the length, clamped to what a short string can hold.
    val cap = short_string_capacity(bits)
    val start_c = fresh_reg(e)

    emit(e, InBin(start_c, OpAnd, w, start, VInt(from_int(long(cap)))))

    val n_c = fresh_reg(e)

    emit(e, InBin(n_c, OpAnd, w, n, VInt(from_int(long(cap)))))

    val start2 = fresh_reg(e)

    emit(e, InCast(start2, CastZExt, w, start_c, pair))

    val shift = fresh_reg(e)

    emit(e, InBin(shift, OpShl, pair, start2, VInt(from_int(3))))

    val down = fresh_reg(e)

    emit(e, InBin(down, OpLShr, pair, both, shift))

    val n2 = fresh_reg(e)

    emit(e, InCast(n2, CastZExt, w, n_c, pair))

    val nbits = fresh_reg(e)

    emit(e, InBin(nbits, OpShl, pair, n2, VInt(from_int(3))))

    val one_up = fresh_reg(e)

    emit(e, InBin(one_up, OpShl, pair, VInt(from_int(1)), nbits))

    val mask = fresh_reg(e)

    emit(e, InBin(mask, OpSub, pair, one_up, VInt(from_int(1))))

    val kept = fresh_reg(e)

    emit(e, InBin(kept, OpAnd, pair, down, mask))

    // The tag: `0x80 | n` in the top byte.
    val tag = fresh_reg(e)

    emit(e, InBin(tag, OpOr, pair, n2, VInt(from_int(128))))

    val tag_up = fresh_reg(e)

    emit(e, InBin(tag_up, OpShl, pair, tag, VInt(from_int(long(2 * bits - 8)))))

    val whole = fresh_reg(e)

    emit(e, InBin(whole, OpOr, pair, kept, tag_up))

    val new_lo = fresh_reg(e)

    emit(e, InCast(new_lo, CastTrunc, pair, whole, w))

    val new_p = fresh_reg(e)

    emit(e, InCast(new_p, CastIntToPtr, w, new_lo, LPtr))

    val shifted = fresh_reg(e)

    emit(e, InBin(shifted, OpLShr, pair, whole, VInt(from_int(long(bits)))))

    val new_hi = fresh_reg(e)

    emit(e, InCast(new_hi, CastTrunc, pair, shifted, w))
    str_view(e, VNull, new_p, new_hi)
end str_short_run

// Whether a view of type `ty` is a string rather than a slice.
private is_string_view(ty: Type) -> bool = underlying(unqualified(ty)) == Str

// The first element and the length of the view `v` of type `ty`, a string's through `str_data`.
view_data(e: *Emit, v: Val, ty: Type) -> (Val, Val)
    if is_string_view(ty) then return str_data(e, v)

    val p = view_ptr(e, v, ty)
    val n = view_len(e, v, ty)
    (p, n)
end view_data

// The first element of the view `v` of type `ty`.
view_ptr(e: *Emit, v: Val, ty: Type) -> Val
    if is_string_view(ty) then return str_ptr(e, v)

    val p = fresh_reg(e)

    emit(e, InExtract(p, lty(e, ty), v, index_list(1)))
    p
end view_ptr

// The length of the view `v` of type `ty`.
view_len(e: *Emit, v: Val, ty: Type) -> Val
    if is_string_view(ty) then return str_len(e, v)

    val n = fresh_reg(e)

    emit(e, InExtract(n, lty(e, ty), v, index_list(2)))
    n
end view_len

// The runtime's hand-written IR reads a string through these spellings, so what a template says
// about the two words is said here too. `str_ptr_text(str, "%b")` is the right-hand side of an
// instruction that reads the pointer of the string value `%b` of LLVM type `str`.
//
// **Where the short form is on, the two need lines of their own first** (`str_read_text`), laid down
// before either is used; they name their registers after `v`, so a template reads one string this
// way once.
str_ptr_text(str: string, v: string) -> string =
    if short_strings_on() then s"select i1 ${v}.sh, ptr ${v}.held, ptr ${v}.p1" else s"extractvalue $str $v, 1"

str_len_text(str: string, bits: int, v: string) -> string =
    if short_strings_on() then s"select i1 ${v}.sh, i$bits ${v}.n7, i$bits ${v}.w2"
    else s"extractvalue $str $v, 2"

// The lines `str_ptr_text` and `str_len_text` read, each ending in a newline and indented as a
// template's body is; nothing at all where the short form is off. The spill is an `alloca`, so a
// template lays these down in its entry block. `bits` is the machine's word.
str_read_text(str: string, bits: int, v: string) -> string
    if !short_strings_on() then return ""

    val top = bits - 8
    val wb = bits / 8

    s"  ${v}.w2 = extractvalue $str $v, 2\n" +
    s"  ${v}.sh = icmp slt i$bits ${v}.w2, 0\n" +
    s"  ${v}.top = lshr i$bits ${v}.w2, $top\n" +
    s"  ${v}.n7 = and i$bits ${v}.top, 127\n" +
    s"  ${v}.slot = alloca $str\n" +
    s"  store $str $v, ptr ${v}.slot\n" +
    s"  ${v}.held = getelementptr i8, ptr ${v}.slot, i32 $wb\n" +
    s"  ${v}.p1 = extractvalue $str $v, 1\n"
end str_read_text

// The same two words of element `at` of an array of strings at `table`, as the address of each: the
// right-hand side of a `getelementptr`, to be loaded as a `ptr` and as a `word`.
str_ptr_at_text(str: string, word: string, table: string, at: string) -> string =
    s"getelementptr $str, ptr $table, $word $at, i32 1"

str_len_at_text(str: string, word: string, table: string, at: string) -> string =
    s"getelementptr $str, ptr $table, $word $at, i32 2"

// A string's bytes as a call's two arguments. Every helper in the runtime takes them in that order
// and at those types, which is what makes this worth naming once.
private str_args(e: *Emit, p: Val, n: Val) -> Buf[IrArg]
    var out: Buf[IrArg] = buf()

    out.push(ir_arg(LPtr, p))
    out.push(ir_arg(word_lty(e), n))
    out
end str_args

// Asks for a hand-written block once, and hands back the name -- the same queue every generated
// helper is asked for through, so the order a module writes them down is the order they were needed.
request_text(e: *Emit, name: string, text: string) -> string = request_helper(e, name, HrText(text))

// Joins two strings into a fresh one. The result owns a new `StrBuf` -- an ordinary heap object
// whose payload is the two halves' bytes laid end to end -- so it carries a count of its own and
// returns its storage through the hook like every other heap object. Both operands are copied out,
// so neither is retained; the caller records the result as an owned temporary.
str_concat(e: *Emit, av: Val, bv: Val) -> Val
    e.heap = true

    val a = str_data(e, av)
    val b = str_data(e, bv)
    e.traps = true

    val fn = request_text(e, "sysl.str.concat", str_concat_text(e, str_llvm(e)))
    val r = fresh_reg(e)

    var args = str_args(e, a.0, a.1)

    val more = str_args(e, b.0, b.1)

    for item in more
        args.push(item)

    emit(e, ir_call(Some(r), lty(e, Str), VGlobal(fn), args))
    r
end str_concat

// Compares two strings by their bytes, yielding the usual -1 / 0 / 1 so that every comparison
// operator is one `icmp` against the result.
str_cmp(e: *Emit, av: Val, bv: Val) -> Val
    val a = str_data(e, av)
    val b = str_data(e, bv)
    val fn = request_text(e, "sysl.str.cmp", str_cmp_text(word_llvm_of(e)))
    val r = fresh_reg(e)

    var args = str_args(e, a.0, a.1)

    val more = str_args(e, b.0, b.1)

    for item in more
        args.push(item)

    emit(e, ir_call(Some(r), l_i32(), VGlobal(fn), args))
    r
end str_cmp

// Whether two strings hold the same bytes, as an `i1` -- what `==` and `!=` lower to, rather than
// `str_cmp`'s order read against zero (`str_eq_text` says why).
str_eq(e: *Emit, av: Val, bv: Val) -> Val
    val a = str_data(e, av)
    val b = str_data(e, bv)
    val fn = request_text(e, "sysl.str.eq", str_eq_text(word_llvm_of(e)))
    val r = fresh_reg(e)

    var args = str_args(e, a.0, a.1)

    for item in str_args(e, b.0, b.1)
        args.push(item)

    emit(e, ir_call(Some(r), l_i1(), VGlobal(fn), args))
    r
end str_eq

// The position of a string in a sorted constant table of `count` strings, or `count` where it is not
// there -- one call, whose search asks `str_cmp`'s comparison, so the comparison is requested first.
str_search(e: *Emit, table: Val, count: usize, v: Val) -> Val
    val s = str_data(e, v)

    request_text(e, "sysl.str.cmp", str_cmp_text(word_llvm_of(e)))

    val fn = request_text(e, "sysl.str.search", str_search_text(word_llvm_of(e), str_llvm(e)))
    val r = fresh_reg(e)

    var args: Buf[IrArg] = buf()

    args.push(ir_arg(LPtr, table))
    args.push(ir_arg(word_lty(e), VInt(from_int(long(count)))))

    val more = str_args(e, s.0, s.1)

    for item in more
        args.push(item)

    emit(e, ir_call(Some(r), word_lty(e), VGlobal(fn), args))
    r
end str_search

// Whether a byte offset falls between characters rather than inside one. The caller has already
// checked that the offset is within the string, so this only has to look at the byte it names.
str_boundary(e: *Emit, p: Val, n: Val, i: Val) -> Val
    val fn = request_text(e, "sysl.str.boundary", str_boundary_text(word_llvm_of(e)))
    val r = fresh_reg(e)

    var args = str_args(e, p, n)

    args.push(ir_arg(word_lty(e), i))
    emit(e, ir_call(Some(r), l_i1(), VGlobal(fn), args))
    r
end str_boundary

// The word and the string's own text, as the templates spell them.
private word_llvm_of(e: *Emit) -> string = s"i${e.word_bits}"

private str_llvm(e: *Emit) -> string = l_render(lty(e, Str))

// A view over bytes nothing owns -- what a `bool` renders to, since the two words it may be are
// immortal constants.
private str_view(e: *Emit, owner: Val, ptr: Val, len: Val) -> Val
    val lt = lty(e, Str)
    val v0 = fresh_reg(e)

    emit(e, InInsert(v0, lt, VUndef, LPtr, owner, index_list(0)))

    val v1 = fresh_reg(e)

    emit(e, InInsert(v1, lt, v0, LPtr, ptr, index_list(1)))

    val v2 = fresh_reg(e)

    emit(e, InInsert(v2, lt, v1, word_lty(e), len, index_list(2)))
    v2
end str_view

// **`str(x)` of a scalar.** A `string` is itself, since the value is already the three words a
// string is; every other type is rendered into a fresh owning buffer, so the result is an owned
// temporary the enclosing statement releases. A `bool` renders to one of two immortal literals and
// needs no allocation at all.
gen_str(e: *Emit, arg: TExpr) -> Val
    val ty = underlying(texpr_type(arg))

    if ty == Str then return gen_expr(e, arg)
    if ty == Bool then return gen_bool_str(e, arg)
    if ty == Char then return gen_char_str(e, arg)

    ty match
        Integer(bits, signed, _) -> gen_int_str(e, arg, bits, signed)
        Fixed(bits, frac, signed) -> gen_fixed_str(e, arg, bits, frac, signed)
        Floating(_, _) -> gen_float_str(e, arg, ty)
        other -> gap_at(e, s"str of ${type_show(other)}")
end gen_str

private gen_bool_str(e: *Emit, arg: TExpr) -> Val
    e.bool_strs = true

    val v = gen_expr(e, arg)
    val p = fresh_reg(e)

    emit(e, InSelect(p, v, LPtr, VGlobal(".true"), VGlobal(".false"), l_i1()))

    val n = fresh_reg(e)

    emit(e, InSelect(n, v, word_lty(e), VInt(from_int(4)), VInt(from_int(5)), l_i1()))
    str_view(e, VNull, p, n)
end gen_bool_str

private gen_char_str(e: *Emit, arg: TExpr) -> Val
    e.char_buf = true
    e.heap = true

    request_from_bytes(e)

    val fn = request_text(e, "sysl.str.char", str_char_text(word_llvm_of(e), str_llvm(e)))
    val cp = gen_expr(e, arg)
    val r = fresh_reg(e)

    var args: Buf[IrArg] = buf()

    args.push(ir_arg(l_i32(), cp))
    emit(e, ir_call(Some(r), lty(e, Str), VGlobal(fn), args))
    r
end gen_char_str

// Rendered at a width that holds the value, which for anything past 64 bits is **the value's own**.
// Up to 64 it goes through the renderer every program has always used -- one instance, shared, and
// the overwhelmingly common case.
//
// **Beyond that the width may not be clamped.** Rendering an `i256` through a 128-bit renderer would
// not be a lossy answer, it would be the wrong number: the conversion below narrows first and the
// digits printed are of the truncated value. A renderer is generated per width instead.
private gen_int_str(e: *Emit, arg: TExpr, bits: int, signed: bool) -> Val
    e.heap = true

    request_from_bytes(e)

    val wide_bits = if bits > 64 then bits else 64
    val fn = request_text(e, str_int_name(wide_bits),
                          str_int_text(wide_bits, word_llvm_of(e), str_llvm(e)))
    val wide = convert(e, underlying(texpr_type(arg)), Integer(wide_bits, signed, false),
                       gen_expr(e, arg))
    val r = fresh_reg(e)

    var args: Buf[IrArg] = buf()

    args.push(ir_arg(LInt(wide_bits), wide))
    args.push(ir_arg(l_i1(), VInt(from_int(if signed then 1 else 0))))
    emit(e, ir_call(Some(r), lty(e, Str), VGlobal(fn), args))
    r
end gen_int_str

// **A float never arrives here**: the analysis sends `str` of one, and a plain hole, to the library's
// `sysl.fmt.format_real` (`expr_call.sysl`'s `float_format_call`), which renders it in sysl. Only a
// compilation given no standard module reaches this, and it has nothing to render the float with.
private gen_float_str(e: *Emit, arg: TExpr, from: Type) -> Val =
    gap_at(e, "str of a float, with no 'sysl.fmt.format_real' to render it")

// The copy every rendering finishes through, asked for wherever one is.
request_from_bytes(e: *Emit) -> string
    e.traps = true

    request_text(e, "sysl.str.from_bytes", str_from_bytes_text(e, str_llvm(e)))

// The bytes are copied into a string that owns them rather than viewed in place: a `[]u8` can be
// written through afterwards, and a `string` whose bytes could change is not one that was ever
// validated. The same copy is what `str(x)` finishes through, so both spend one allocation.
gen_from_bytes(e: *Emit, arg: TExpr) -> Val
    e.heap = true

    val fn = request_from_bytes(e)

    // `s.copy()` is the bytes of `s` copied, and the copy only reads them: from the string itself.
    val (p, n) = bytes_receiver(arg) match
        Some(s) -> str_data(e, gen_expr(e, s))
        None -> view_data(e, gen_expr(e, arg), texpr_type(arg))
    val r = fresh_reg(e)

    emit(e, ir_call(Some(r), lty(e, Str), VGlobal(fn), str_args(e, p, n)))
    own_temp(e, r, Str)
end gen_from_bytes

// **A hole under a specifier, `f"${x}%…"`** -- one value rendered through a printf specifier, into a fresh owning string.
// **Every specifier is the library's to render, so none is lowered here**: the analysis sends an
// integer to `sysl.fmt.format_int`, a string to `sysl.fmt.format_str` and a float to `format_real`
// or `format_f32` (`expr_call.sysl`'s `library_format_call`), so a specifier renders the same on a
// target with no C library as on a hosted one. What arrives here is a specifier the analysis found
// no renderer for -- a library too old to carry one -- and it is left out as a gap naming the
// renderer it wanted.
gen_format(e: *Emit, arg: TExpr, spec: string, counts: Buf[TExpr]) -> Val
    val c = spec_conversion(spec)

    if spec_is_int(c) then gap_at(e, "an integer specifier, with no 'sysl.fmt.format_int' to render it")
    else if spec_is_float(c) then gap_at(e, "a float specifier, with no 'sysl.fmt.format_real' to render it")
    else gap_at(e, "a string specifier, with no 'sysl.fmt.format_str' to render it")
end gen_format

// -- a printf-style specifier ----------------------------------------------------------------------

// The conversion letter, which the lexer guarantees is the last character of a well-formed spec.
spec_conversion(spec: string) -> char
    var last = '%'

    for c in spec.chars
        last = c

    last
end spec_conversion

// How many counts a specifier reads at run time: one per `*`, each a hole the reader wrote where a
// width or a precision goes.
spec_stars(spec: string) -> usize
    var n: usize = 0

    for c in spec.chars
        if c == '*' then n += 1

    n
end spec_stars

spec_is_int(c: char) -> bool = one_of("diouxXb", c)

spec_is_float(c: char) -> bool = one_of("eEfgG", c)

private one_of(set: string, c: char) -> bool
    for x in set.chars
        if x == c then return true

    false
end one_of

spec_is_str(c: char) -> bool = c == 's'

// What a conversion says it renders, in the words a refusal quotes back.
spec_expects(c: char) -> string =
    if spec_is_int(c) then "an integer"
    else if spec_is_float(c) then "a float"
    else "a string"

// The three parts of a specifier a `Display` implementation is handed: the minimum field width, the
// precision, and whether the field is left-justified (`library/core.md § A specifier is the whole
// value's field`).
//
// **A width of `0` and a precision of `-1` mean neither was written**, which is the reading `%s` and
// `%.0s` would otherwise be confused by. Only these three cross the boundary: the numeric flags
// belong to a conversion the library's own renderers apply, and a type rendering itself has no
// conversion letter to interpret.
//
// A `0` is a flag and a digit both, and the flags are taken first, so `%08.2f` is width 8 rather
// than width zero followed by an 8 -- which is the reading the reference's `takeWhile` gives it.
spec_parts(spec: string) -> (int, int, bool)
    val b = spec.bytes
    val last = if b.len > 0 then b.len - 1 else 0
    var i: usize = if b.len > 0 then 1 else 0
    var left = false

    while i < last && is_spec_flag(b[i])
        if b[i] == u8('-') then left = true

        i += 1

    var width = 0

    while i < last && is_spec_digit(b[i])
        width = width * 10 + int(b[i] - u8('0'))
        i += 1

    if i >= last || b[i] != u8('.') then return (width, -1, left)

    i += 1

    var prec = 0

    while i < last && is_spec_digit(b[i])
        prec = prec * 10 + int(b[i] - u8('0'))
        i += 1

    (width, prec, left)
end spec_parts

private is_spec_flag(c: u8) -> bool =
    c == u8('-') || c == u8('+') || c == u8('0') || c == u8(' ') || c == u8('#')

private is_spec_digit(c: u8) -> bool = c >= u8('0') && c <= u8('9')


// -- rendering into a buffer -------------------------------------------------------------------------

// **A value written into a growable buffer, and what landed there as a string.** A stack slot -- a
// zeroed header and `buffer_scratch()` bytes of frame storage the first bytes land in -- becomes the
// sink, the value writes itself into it, and the bytes are copied into a string the statement owns.
// The header is re-zeroed on every arrival rather than once, since an alloca is hoisted to the entry
// block and a render inside a loop meets the same one each time round; the scratch needs no zeroing,
// as nothing reads it past the length the header counts.
gen_render(e: *Emit, value: TExpr, method: string, spec: TExpr, vslot: Option[int]) -> Val
    e.heap = true

    request_from_bytes(e)

    val table = buffer_table(e)

    // **A large receiver crosses as the address of storage nothing can change during the call**
    // (`indirect_arg`), exactly as it does at any other call -- a value past the indirect boundary is
    // passed and received through memory, so its parameter is a pointer. Producing it as a first-class aggregate and handing that over
    // instead puts the struct's first word where the callee reads an address.
    val big = e.layout.indirect(texpr_type(value))
    val lent = changes_nothing(spec) && lends_in_place(e, method, texpr_type(value))
    val v = if big then indirect_arg(e, value, held(e, value) || lent)
    else gen_expr(e, value)
    val s = gen_expr(e, spec)
    val slot = alloca(e, fresh_reg(e), buffer_lty(e))

    // The slot holds a frame's worth of scratch, and its address goes into a trait object, so the
    // lifetime pass never bounds it; it is bounded here instead, by the rendering itself -- nothing
    // points into it once `finish` has copied the bytes out -- so that a body with many holes, or a
    // recursion through one, does not keep a scratch per hole alive across the whole frame.
    mark_slot_life(e, lifetime_start_symbol(), slot)
    emit(e, InStore(buffer_header_lty(e), VZero, slot, AccPlain, None))

    val a = fresh_reg(e)

    emit(e, InInsert(a, l_fat(), VUndef, LPtr, VGlobal(table), index_list(0)))

    val w = fresh_reg(e)

    emit(e, InInsert(w, l_fat(), a, LPtr, slot, index_list(1)))

    var args: Buf[IrArg] = buf()

    // A trait object renders through the table it carries, so the callee and the receiver both come
    // out of the value: the data word is the receiver a slot's entry expects, exactly as it is for
    // any other call through one.
    val callee = vslot match
        Some(n) ->
            val vt = fresh_reg(e)

            emit(e, InExtract(vt, l_fat(), v, index_list(0)))

            val data = fresh_reg(e)

            emit(e, InExtract(data, l_fat(), v, index_list(1)))

            val fn = vtable_entry(e, vt, n)

            args.push(ir_arg(LPtr, data))
            fn
        // A zero-sized receiver -- `unit` -- has no parameter in the callee, so it has no argument.
        None ->
            if !zero_sized(texpr_type(value)) then
                args.push(ir_arg(if big then LPtr else lty(e, texpr_type(value)), v))

            VGlobal(symbol_of(e, method))

    args.push(ir_arg(l_fat(), w))
    args.push(ir_arg(lty(e, texpr_type(spec)), s))

    if vslot.is_none() then push_caller_unplaced(e, method, &args)

    emit(e, ir_call(None, LVoid, callee, args))

    val r = fresh_reg(e)

    var finish: Buf[IrArg] = buf()

    finish.push(ir_arg(LPtr, slot))
    emit(e, ir_call(Some(r), lty(e, Str), VGlobal("sysl.w.buf.finish"), finish))
    mark_slot_life(e, lifetime_end_symbol(), slot)
    own_temp(e, r, Str)
end gen_render

// One lifetime marker over the whole of `slot`, with the module told it declares the pair.
private mark_slot_life(e: *Emit, symbol: string, slot: Val)
    var args: Buf[IrArg] = buf()

    args.push(ir_arg(LInt(64), VInt(from_int(-1))))
    args.push(ir_arg(LPtr, slot))
    emit(e, ir_call(None, LVoid, VGlobal(symbol), args))
    e.uses_lifetime = true
end mark_slot_life
