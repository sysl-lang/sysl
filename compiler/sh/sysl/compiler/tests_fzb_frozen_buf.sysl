module sh.sysl.compiler
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture
import sysl.text.Search

// `Buf.freeze()`, `&Frozen[T]` and `&sync Frozen[T]` -- read-only heap data, which every thread reads
// at once where the position asked for the shared form (`reference/memory.md § A frozen buffer
// crosses`). The sharing rule asks a shared frozen buffer's ELEMENT type where a `&sync` struct's
// fields would be asked, and asks it at the call that froze it; and a
// generic type's destructor is made real for every type of its family the program makes, which a
// frozen buffer's storage depends on and which no generic type had before.

private fzb_ready() -> bool
    std_root() match
        Err(_) ->
            print("skipped: the standard module's source is not on this machine")
            false
        Ok(_) -> true

// What a program built from these files does: what it printed, and whether it built, ran and exited
// zero. A refused build answers the driver's whole report.
private fzb_outcome(files: []const (string, string)) -> (string, bool)
    val root = make_temp_dir("sysl-fzb").unwrap()

    for i in 0..<files.len
        val at = s"$root/${files[i].0}"
        val slash = at.last_index_of("/")

        if slash.is_some() then make_dir_all(at[0..<slash.unwrap()]).unwrap()

        write_text(at, files[i].1).unwrap()

    val exe = s"$root/built"

    build_native_program(root, None, None, DefaultOptimization, Some(exe)) match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return (failure_text(why), false)
        Ok(_) -> ()

    val said = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    said match
        Err(_) -> ("the program that was built could not be run", false)
        Ok(out) -> (out.text + out.err.unwrap_or(""), out.status.ok())
end fzb_outcome

private fzb_importing() -> string = "import sysl.buf.{Buf, buf, Frozen}\n\n"

private fzb_ran(text: string) -> string
    val out = fzb_outcome([("main.sysl", fzb_importing() + text)])

    if !out.1 then return s"it did not run to the end: ${out.0}"

    out.0
end fzb_ran

private fzb_err(text: string) -> string
    val out = fzb_outcome([("main.sysl", fzb_importing() + text)])

    if out.1 then return s"it was not refused, and printed: ${out.0}"

    out.0
end fzb_err

// -- what it is --------------------------------------------------------------------------------------

@test("a frozen buffer is indexed, measured, walked and viewed, and the buffer is left empty")
fzb_reads_and_empties()
    if !fzb_ready() then return

    assert_eq(fzb_ran(raw"""
        var b: Buf[int] = buf()

        for i in 0..<5
            b.push(i * 10)

        val alias = b
        val f = b.freeze()
        var sum = 0

        for x in f
            sum += x

        val v = f.view()

        print(f[2], f.len(), f.is_empty(), sum, v, v.len)
        print(b.len(), alias.len())
        b.push(7)
        print(b.len(), f.len())
        """), "20 5 false 100 [0, 10, 20, 30, 40] 5\n0 0\n1 5\n")

@test("an empty buffer freezes to an empty frozen buffer, whose view is empty")
fzb_empty()
    if !fzb_ready() then return

    assert_eq(fzb_ran(raw"""
        var b: Buf[u8] = buf()
        val f = b.freeze()
        var n = 0

        for x in f
            n += 1

        print(f.len(), f.is_empty(), n, f.view().len)
        """), "0 true 0 0\n")

@test("an index past the end traps, with an array's report")
fzb_past_end()
    if !fzb_ready() then return

    val out = fzb_outcome([("main.sysl", fzb_importing() +
                            "var b: Buf[int] = buf()\nb.push(5)\nval f = b.freeze()\nprint(f[3])\n")])

    assert(!out.1, out.0)
    assert(out.0.contains("index 3 out of bounds for length 1"), out.0)

// A view earlier than the freeze keeps the old storage, which the frozen buffer shares nothing with.
@test("a view taken before the freeze still reads what it read, and the frozen storage is its own")
fzb_earlier_view()
    if !fzb_ready() then return

    assert_eq(fzb_ran(raw"""
        var b: Buf[int] = buf()

        b.push(1)
        b.push(2)

        val before = b.view()
        val f = b.freeze()

        print(before, f[0], f[1])
        """), "[1, 2] 1 2\n")

// -- lifetimes ---------------------------------------------------------------------------------------

// Each element's destructor runs once, when the last share of the frozen buffer goes -- and a view
// outlives every name of the frozen buffer through the box it holds.
@test("counted elements are let go of once, when the last share -- a view's among them -- goes")
fzb_elements_dropped_once()
    if !fzb_ready() then return

    assert_eq(fzb_ran(raw"""
        struct Cell
            n: int

        impl Drop for Cell
            drop(self) = print("drop", self.n)

        view_of() -> []const &sync Cell
            var b: Buf[&sync Cell] = buf()

            for i in 1..3
                val c: &sync Cell = Cell(i)
                b.push(c)

            val f = b.freeze()

            f.view()

        run()
            val v = view_of()

            print("held", v.len, v[2].n)

        run()
        print("after")
        """), "held 3 3\ndrop 1\ndrop 2\ndrop 3\nafter\n")

@test("a frozen buffer with no view goes with its last name")
fzb_dropped_with_last_name()
    if !fzb_ready() then return

    assert_eq(fzb_ran(raw"""
        struct Cell
            n: int

        impl Drop for Cell
            drop(self) = print("drop", self.n)

        make()
            var b: Buf[&sync Cell] = buf()
            val c: &sync Cell = Cell(7)

            b.push(c)

            val f = b.freeze()

            print("in", f[0].n)

        make()
        print("after")
        """), "in 7\ndrop 7\nafter\n")

// -- crossing ---------------------------------------------------------------------------------------

// The raytrace shape: a `&sync` struct holding frozen pixels and a frozen list of `&sync` trait
// objects, read by eight threads at once, each also taking a view.
@test("a '&sync' struct holding frozen buffers is read from eight threads")
fzb_eight_threads()
    if !fzb_ready() then return

    assert_eq(fzb_ran(raw"""
        import sysl.threads.{spawn, Thread}

        trait Shape
            area(self) -> int

        struct Square
            side: int

        impl Shape for Square
            area(self) -> int = self.side * self.side

        struct Texture
            width: usize
            pixels: &sync Frozen[u8]

        struct Scene
            texture: &sync Texture
            shapes: &sync Frozen[&sync Shape]

        struct Work
            scene: &sync Scene
            from: usize
            sum: int
            areas: int

        work(w: *Work)
            val px = w.scene.texture.pixels
            var s = 0

            for i in w.from..<w.from + 25000
                s += int(px[i % px.len()])

            for sh in w.scene.shapes
                w.areas += sh.area()

            val v = px.view()

            w.sum = s + int(v[299])

        var px: Buf[u8] = buf()

        for i in 0..<300
            px.push(u8(i % 251))

        var shapes: Buf[&sync Shape] = buf()

        for i in 1..4
            val sq: &sync Square = Square(i)
            shapes.push(sq)

        val scene: &sync Scene = Scene(Texture(300, px.freeze()), shapes.freeze())
        var jobs: [8]Work = [Work(scene, 0, 0, 0); 8]

        for i in 0..<8
            jobs[i].from = usize(i) * 25000

        var started: Buf[Thread] = buf()

        for i in 0..<8
            started.push(spawn(&work, &jobs[i]).unwrap())

        for t in started
            t.join()

        var total = 0
        var areas = 0

        for j in jobs
            total += j.sum
            areas += j.areas

        print(total, areas)
        """), "21699250 240\n")

@test("a '&sync Fn' may capture a frozen buffer")
fzb_captured()
    if !fzb_ready() then return

    assert_eq(fzb_ran(raw"""
        var b: Buf[int] = buf()

        b.push(5)

        val f: &sync Frozen[int] = b.freeze()
        val job: &sync Fn() -> unit = () -> print(f[0], f.len())

        job()
        """), "5 1\n")

// -- what is refused ---------------------------------------------------------------------------------

@test("freezing plain references where a shared frozen buffer is expected is refused, naming the element")
fzb_plain_reference_refused()
    if !fzb_ready() then return

    val out = fzb_err(raw"""
        struct Cell
            n: int

        take(f: &sync Frozen[&Cell]) -> usize = f.len()

        var b: Buf[&Cell] = buf()

        b.push(Cell(1))
        print(take(b.freeze()))
        """)

    assert(out.contains("'&sync Frozen[&Cell]' may be reached from two domains at once, " +
                        "so every count inside it has to be atomic — but it holds a '&Cell', whose " +
                        "count is not. Hold it as a '&sync Cell' ('06')"), out)
    assert(!out.contains("buf.sysl"), out)

// The annotation is what is refused there, where the reader wrote it -- once, the freeze that
// answers it being the same choice rather than a second one.
@test("a binding annotated as a shared frozen buffer of plain references is refused at the annotation")
fzb_annotated_reference_refused()
    if !fzb_ready() then return

    val out = fzb_err("struct Cell\n    n: int\n\nvar b: Buf[&Cell] = buf()\n\nb.push(Cell(1))\n\n" +
                      "val f: &sync Frozen[&Cell] = b.freeze()\n")

    assert(out.contains("'&sync Frozen[&Cell]' may be reached from two domains at once"), out)
    assert(out.contains("main.sysl:10:8"), out)
    assert_eq(out.index_of("may be reached from two domains"), out.last_index_of("may be reached from two domains"))

@test("freezing strings or buffers where a shared frozen buffer is expected is refused for each count")
fzb_strings_and_bufs_refused()
    if !fzb_ready() then return

    val strings = fzb_err("shared(f: &sync Frozen[string]) = ()\nvar b: Buf[string] = buf()\nshared(b.freeze())\n")

    assert(strings.contains("but it holds a 'string', which owns its bytes through a count that is not atomic"),
           strings)

    val bufs = fzb_err("shared(f: &sync Frozen[Buf[u8]]) = ()\nvar b: Buf[Buf[u8]] = buf()\nshared(b.freeze())\n")

    assert(bufs.contains("but it holds a 'Buf[byte]', which is shared through a count that " +
                         "is not atomic. Hold its elements as a '&sync Frozen[byte]', built with " +
                         "'.freeze()' (reference: memory, 'A frozen buffer crosses'), or guard the " +
                         "buffer in a 'Mutex' ('06')"), bufs)

@test("a field written as a frozen buffer of plain references is refused where it is written")
fzb_field_refused()
    if !fzb_ready() then return

    val out = fzb_err("struct Cell\n    n: int\n\nstruct Holder\n    f: &sync Frozen[&Cell]\n")

    assert(out.contains("'&sync Frozen[&Cell]' may be reached from two domains at once"), out)
    assert(out.contains("main.sysl:7:8"), out)

@test("nothing writes a frozen buffer: no subscript store, no push, no store through its view")
fzb_writes_refused()
    if !fzb_ready() then return

    val head = "var b: Buf[int] = buf()\nb.push(1)\nval f = b.freeze()\n"

    assert(fzb_err(head + "f[0] = 2\n").contains("assignment needs a variable, a field, an element, " +
                                                 "or a dereference — something with an address"))
    assert(fzb_err(head + "f.push(2)\n").contains("type 'Frozen' has no method 'push'"))
    assert(fzb_err(head + "val v = f.view()\nv[0] = 2\n").contains("this element belongs to a " +
                                                                  "'[]const int', which views elements it may not write"))

@test("an allocator-free module may not freeze, the freeze making storage")
fzb_no_alloc_refused()
    if !fzb_ready() then return

    val out = fzb_outcome([("main.sysl", "@no_alloc\n\nimport sysl.buf.{Buf, Frozen}\n\n" +
                            "freeze_it(b: Buf[int]) -> &Frozen[int] = b.freeze()\n\nprint(1)\n")])

    assert(!out.1, out.0)
    assert(out.0.contains("this reaches 'sysl.buf.Buf.freeze.int', which makes heap storage through " +
                          "'sysl.buf.freeze_buf.int', and this module declared '@no_alloc'"), out.0)

// -- a generic type's destructor ----------------------------------------------------------------------

// Before, the release hook of a `&G[int]` called `G.int.drop`, which nothing made real, and the build
// failed in clang on an undefined symbol.
@test("a generic type's destructor runs, through '&T' and '&sync T', at each instantiation")
fzb_generic_drop()
    if !fzb_ready() then return

    assert_eq(fzb_ran(raw"""
        struct G[T]
            v: T

        impl[T: Display] Drop for G[T]
            drop(self) = print("gone", self.v)

        plain() -> &G[string] = G("s")
        shared() -> &sync G[int] = G(3)

        do_it()
            val a = plain()
            val b = shared()

            print(a.v, b.v)

        do_it()
        print("after")
        """), "s 3\ngone 3\ngone s\nafter\n")

// -- the count kind follows the position ------------------------------------------------------------

// `freeze()` answers a `&Frozen[T]` for any `T`, and allocates the shared form only where the position
// expects a `&sync Frozen[T]` -- as a construction does (`frozen_count.sysl`). Each cell below reads,
// measures, indexes, walks and views one element kind, on the counted heap, and must give back every
// allocation it took.

// What a program built on the counted heap printed, where it ran to the end and gave everything back.
private fzb_counted(text: string) -> string
    force_alloc_counting(true)

    val out = fzb_outcome([("main.sysl", fzb_importing() + text)])

    force_alloc_counting(false)

    if !out.1 then return s"it did not run to the end: ${out.0}"

    if alloc_count_reported(out.0) != 0 then return s"it did not give back everything it took: ${out.0}"

    out.0
end fzb_counted

@test("an unannotated freeze of a scalar is a '&Frozen', read every way, and let go of entirely")
fzb_local_scalar()
    if !fzb_ready() then return

    assert_eq(fzb_counted(raw"""
        var b: Buf[int] = buf()

        for i in 0..<4
            b.push(i * 3)

        val f = b.freeze()
        val same: &Frozen[int] = f
        var sum = 0

        for x in f
            sum += x

        print(f[1], f.len(), f.get(3).unwrap(), f.get(4).is_none(), sum, f.view(), same.len())
        """), "3 4 9 true 18 [0, 3, 6, 9] 4\n")

@test("a '&Frozen' of strings holds each string's count, and gives each back")
fzb_local_strings()
    if !fzb_ready() then return

    assert_eq(fzb_counted(raw"""
        var b: Buf[string] = buf()

        b.push("ab")
        b.push("cde")

        val f = b.freeze()
        var n = 0

        for s in f
            n += s.len

        print(f[1], f.len(), n, f.view())
        """), "cde 2 5 [ab, cde]\n")

// The tekton shape: a tree whose node holds its children as a frozen buffer of plain references, in a
// single-threaded program. Each node goes once, after the last read.
@test("a struct field '&Frozen[&Node]' holds plain references, read, viewed and dropped once each")
fzb_local_references_tree()
    if !fzb_ready() then return

    assert_eq(fzb_counted(raw"""
        struct Node
            id: int
            children: &Frozen[&Node]

        impl Drop for Node
            drop(self) = print("drop", self.id)

        leaf(id: int) -> &Node
            var none: Buf[&Node] = buf()

            Node(id, none.freeze())

        run()
            var b: Buf[&Node] = buf()

            b.push(leaf(1))
            b.push(leaf(2))

            val n = Node(0, b.freeze())
            var ids = 0

            for c in n.children
                ids += c.id

            val v = n.children.view()

            print(n.children.len(), n.children[1].id, n.children.get(2).is_none(), ids, v.len, v[0].id)

        run()
        print("after")
        """), "2 2 true 3 2 1\ndrop 0\ndrop 1\ndrop 2\nafter\n")

// A view of a `&Frozen` holds the storage itself: it outlives every name of the frozen buffer, and
// the elements go when it does.
@test("a view of a '&Frozen' of references outlives the frozen buffer, and its elements go with it")
fzb_local_view_outlives()
    if !fzb_ready() then return

    assert_eq(fzb_counted(raw"""
        struct Cell
            n: int

        impl Drop for Cell
            drop(self) = print("drop", self.n)

        view_of() -> []const &Cell
            var b: Buf[&Cell] = buf()

            for i in 1..3
                b.push(Cell(i))

            val f = b.freeze()

            f.view()

        run()
            val v = view_of()

            print("held", v.len, v[2].n)

        run()
        print("after")
        """), "held 3 3\ndrop 1\ndrop 2\ndrop 3\nafter\n")

@test("a '&Frozen' of a struct holding '&T' walks, views and drops each member once")
fzb_local_struct_of_references()
    if !fzb_ready() then return

    assert_eq(fzb_counted(raw"""
        struct Cell
            n: int

        impl Drop for Cell
            drop(self) = print("drop", self.n)

        struct Pair
            tag: int
            cell: &Cell

        run()
            var b: Buf[Pair] = buf()

            b.push(Pair(1, Cell(10)))
            b.push(Pair(2, Cell(20)))

            val f = b.freeze()
            var s = 0

            for p in f
                s += p.tag * p.cell.n

            print(f.len(), f[1].cell.n, s, f.view().len)

        run()
        print("after")
        """), "2 20 50 2\ndrop 10\ndrop 20\nafter\n")

// Every allocation the cells above make is given back: the storage, the box, a view's share.
@test("freezing, viewing and dropping either kind leaves the counted heap balanced")
fzb_counted_heap_balanced()
    if !fzb_ready() then return

    val out = fzb_counted(raw"""
        struct Cell
            n: int

        run()
            var a: Buf[&Cell] = buf()

            a.push(Cell(1))

            val f = a.freeze()
            val v = f.view()
            var b: Buf[int] = buf()

            b.push(2)

            val g: &sync Frozen[int] = b.freeze()
            val w = g.view()
            var s: Buf[string] = buf()

            s.push("x")

            val h = s.freeze()

            print(v[0].n, w[0], h.view())

        run()
        """)

    assert_eq(out, "1 2 [x]\n")

// -- the position chooses the shared form ----------------------------------------------------------

@test("an annotation, a parameter, a field and a return each allocate the shared form, read across threads")
fzb_shared_positions()
    if !fzb_ready() then return

    assert_eq(fzb_counted(raw"""
        import sysl.threads.spawn

        struct Hold
            f: &sync Frozen[int]

        struct Work
            hold: &sync Hold
            sum: int

        work(w: *Work)
            for x in w.hold.f
                w.sum += x

            w.sum += w.hold.f.view()[0]

        made(n: int) -> &sync Frozen[int]
            var b: Buf[int] = buf()

            for i in 0..<n
                b.push(i + 1)

            b.freeze()

        count(f: &sync Frozen[int]) -> usize = f.len()

        var b: Buf[int] = buf()

        b.push(4)

        val a: &sync Frozen[int] = b.freeze()
        val hold: &sync Hold = Hold(made(3))
        var w = Work(hold, 0)

        spawn(&work, &w).unwrap().join()

        var c: Buf[int] = buf()

        print(a[0], w.sum, count(c.freeze()), count(made(2)))
        """), "4 7 0 2\n")

@test("a branch, an 'Option' payload and a block tail take the shared form from the position")
fzb_shared_through_branches()
    if !fzb_ready() then return

    assert_eq(fzb_counted(raw"""
        either(c: bool) -> &sync Frozen[int]
            var b: Buf[int] = buf()
            var d: Buf[int] = buf()

            b.push(7)

            if c then b.freeze() else d.freeze()

        maybe() -> Option[&sync Frozen[int]]
            var b: Buf[int] = buf()

            b.push(3)

            Some(b.freeze())

        val job: &sync Fn() -> unit = () -> print(either(true).len(), either(false).len(), maybe().unwrap()[0])

        job()
        """), "1 0 3\n")

// A module `val` made while compiling is laid down as data, in either kind.
@test("a module 'val' frozen while compiling is data, as a '&Frozen' and as a '&sync Frozen'")
fzb_module_values()
    if !fzb_ready() then return

    assert_eq(fzb_counted(raw"""
        squares(n: int) -> &Frozen[int]
            var b: Buf[int] = buf()

            for i in 0..<n
                b.push(i * i)

            b.freeze()

        cubes(n: int) -> &sync Frozen[int]
            var b: Buf[int] = buf()

            for i in 0..<n
                b.push(i * i * i)

            b.freeze()

        val SQ: &Frozen[int] = squares(4)
        val CU: &sync Frozen[int] = cubes(3)

        print(SQ[3], SQ.view(), CU[2], CU.view())
        """), "9 [0, 1, 4, 9] 8 [0, 1, 8]\n")

// -- inference ---------------------------------------------------------------------------------------

@test("'buf().freeze()' as an argument takes its element from the parameter, in either kind")
fzb_infers_from_parameter()
    if !fzb_ready() then return

    assert_eq(fzb_counted(raw"""
        struct Holder
            f: &Frozen[string]

        shared(f: &sync Frozen[int]) -> usize = f.len()
        local(f: &Frozen[u8]) -> usize = f.len()

        val h = Holder(buf().freeze())

        print(shared(buf().freeze()), local(buf().freeze()), h.f.len())
        """), "0 0 0\n")

@test("'buf().freeze()' with nothing to say what it holds is still asked for its element")
fzb_infers_nothing_unexpected()
    if !fzb_ready() then return

    assert(fzb_err("val f = buf().freeze()\n").contains("cannot infer the type argument 'T' of 'sysl.buf.buf'"))

// -- what is refused ---------------------------------------------------------------------------------

@test("a '&Frozen' captured by a '&sync Fn' is refused, naming the count and the shared form")
fzb_local_capture_refused()
    if !fzb_ready() then return

    val out = fzb_err("var b: Buf[int] = buf()\nb.push(1)\nval f = b.freeze()\n" +
                      "val job: &sync Fn() -> unit = () -> print(f[0])\njob()\n")

    assert(out.contains("a closure shared between two domains may be called from either, so every count it " +
                        "captures has to be atomic — but the 'f' it captures reaches a '&Frozen[int]', whose " +
                        "count is not. Hold it as a '&sync Frozen[int]' ('06')"), out)

@test("a '&Frozen' sent to another thread is refused at the crossing")
fzb_local_send_refused()
    if !fzb_ready() then return

    val out = fzb_err(raw"""
        import sysl.threads.spawn

        struct W
            f: &Frozen[int]

        work(w: *W) = print(w.f[0])

        var b: Buf[int] = buf()

        b.push(1)

        var w = W(b.freeze())

        spawn(&work, &w).unwrap().join()
        """)

    assert(out.contains("reaches another concurrency domain, so every count inside it has to be atomic — but " +
                        "its 'f' reaches a '&Frozen[int]', whose count is not. Hold it as a " +
                        "'&sync Frozen[int]' ('06')"), out)

@test("'&Frozen' and '&sync Frozen' do not convert, either way")
fzb_kinds_do_not_convert()
    if !fzb_ready() then return

    val up = fzb_err("var b: Buf[int] = buf()\nval f = b.freeze()\nval g: &sync Frozen[int] = f\n")

    assert(up.contains("'&Frozen[int]' and '&sync Frozen[int]' are distinct types, and neither converts to " +
                       "the other"), up)
    assert(up.contains("Allocate Frozen[int] as a '&sync Frozen[int]' where it is constructed"), up)

    val down = fzb_err("var b: Buf[int] = buf()\nval f: &sync Frozen[int] = b.freeze()\nval g: &Frozen[int] = f\n")

    assert(down.contains("'&Frozen[int]' and '&sync Frozen[int]' are distinct types"), down)
    assert(down.contains("Allocate Frozen[int] as a '&Frozen[int]' where it is constructed"), down)

    val handed = fzb_err("take(f: &sync Frozen[int]) = ()\nvar b: Buf[int] = buf()\nval f = b.freeze()\ntake(f)\n")

    assert(handed.contains("'&Frozen[int]' and '&sync Frozen[int]' are distinct types"), handed)

@test("the shared twins the compiler calls are not the program's to name")
fzb_twins_private()
    if !fzb_ready() then return

    assert(fzb_err("var b: Buf[int] = buf()\nval f = b.freeze_shared()\n")
           .contains("method 'freeze_shared' of 'Buf' is private to module 'sysl.buf'"))
    assert(fzb_err("var b: Buf[int] = buf()\nval f: &sync Frozen[int] = b.freeze()\nval v = f.view_shared()\n")
           .contains("method 'view_shared' of 'Frozen' is private to module 'sysl.buf'"))
