module sh.sysl.compiler
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.slices.as_ptr
import sysl.sync.Atomic
import sysl.text.{Search, join}

// A name is found in constant time however many are in scope. The analyzer keeps the bindings in
// scope innermost last (`Analyzer.locals`) and an index beside them -- the innermost binding of each
// name and of each unique name, the outermost of each unique name, the `ref`s, and the open bindings
// a first use is still to type (`push_local`, `cut_locals`, `push_open`, `cut_open`). A search from
// the end of the list for every name read made a body of `n` locals cost `n^2` to read, and the open
// bindings and the `ref`s were searched the same way at every read and every assignment.
//
// The index is a cache of the list, so each test below is a program whose answer is decided by which
// binding a name finds: the innermost where scopes nest, the one before it again once a scope closes
// or a reading is thrown away, none where the name is bound below its use. Each was checked against
// the compiler before the index (0.13.5), which said exactly the same, down to the IR.

private lsi_ready() -> bool
    if std_root().is_err()
        print("skipped: the standard module's source is not on this machine")
        return false

    if !clang_available()
        print("skipped: there is no clang on this machine")
        return false

    true
end lsi_ready

// -- which binding a name finds -------------------------------------------------------------------

@test("lsi: a name finds the innermost of three nested bindings, and the outer ones once each closes")
lsi_nested_shadowing()
    if !lsi_ready() then return

    azc_main_prints(raw"""
        main()
            val x = 1

            if x > 0
                val x = "inner"

                if x.len > 0
                    val x = 3.5

                    print(x)

                print(x)

            print(x)
        """, "3.5\ninner\n1\n")

@test("lsi: a second binding of a name in the same block reads the first on its right side")
lsi_same_block_again()
    if !lsi_ready() then return

    azc_main_prints("main()\n    val x = 1\n    val x = x + 10\n\n    print(x)\n", "11\n")

@test("lsi: a for variable hides an outer binding of its name, and a nested for hides it in turn")
lsi_for_variable()
    if !lsi_ready() then return

    azc_main_prints(raw"""
        main()
            val i = "outer"
            var sum = 0

            for i in 0..<4
                sum += i

                for i in 10..<12
                    sum += i

            print(i, sum)
        """, "outer 90\n")

@test("lsi: a closure captures the binding in scope where it is written, and its parameter hides one")
lsi_closure_capture()
    if !lsi_ready() then return

    azc_main_prints(raw"""
        apply(f: &Fn(int) -> int, v: int) -> int = f(v)

        main()
            val x = 100
            var got = 0

            if x > 0
                val x = 7

                got = apply((n) -> n + x, 1)

            val x2 = apply((x) -> x * 2, 21)

            print(got, x2, x)
        """, "8 42 100\n")

@test("lsi: a binding inside a closure's body hides the outer one only inside it")
lsi_closure_body_binding()
    if !lsi_ready() then return

    azc_main_prints(raw"""
        apply(f: &Fn(int) -> int, v: int) -> int = f(v)

        main()
            val x = 3

            val got = apply((n) ->
                val x = n * 100

                x + 1, 2)

            print(got, x)
        """, "201 3\n")

@test("lsi: a closure's parameter and a block's `it` hide the outer name for the call only")
lsi_closure_parameter_then_outer()
    if !lsi_ready() then return

    azc_main_prints(raw"""
        each(xs: []int, f: &Fn(int) -> unit)
            for v in xs
                f(v)

        main()
            val v = 9
            var seen = 0

            each([1, 2, 3], (v) -> seen += v)

            each([4]):
                seen += it * v

            print(seen, v)
        """, "42 9\n")

@test("lsi: a nested block's `it` hides an outer binding named `it` and the outer block's")
lsi_it_nested()
    if !lsi_ready() then return

    azc_main_prints(raw"""
        outer(f: &Fn(int) -> int) -> int = f(1)
        inner(f: &Fn(int) -> int) -> int = f(2)

        main()
            val it = 100

            val n = outer:
                inner:
                    it * 10

            print(n, it)
        """, "20 100\n")

@test("lsi: a nested function's parameter hides an outer name, and its capture is the binding it saw")
lsi_nested_function()
    if !lsi_ready() then return

    azc_main_prints(raw"""
        main()
            val x = 5
            val y = 40

            twice(x: int) -> int = x * 2
            plus_y(n: int) -> int = n + y

            if y > 0
                val y = 1000

                print(twice(y), plus_y(1))

            print(twice(x), plus_y(2), x)
        """, "2000 41\n10 42 5\n")

@test("lsi: a pattern's bindings hide the function's locals inside the arm only")
lsi_pattern_binding()
    if !lsi_ready() then return

    azc_main_prints(raw"""
        enum Shape
            Circle(r: int)
            Rect(w: int, h: int)

        area(s: Shape) -> int
            val r = -1
            val w = -2

            val a = s match
                Circle(r) -> r * r * 3
                Rect(w, h) -> w * h

            a + r + w

        main()
            print(area(Circle(2)), area(Rect(3, 4)))
        """, "9 9\n")

@test("lsi: an arm's own bindings go with the arm, and a guard reads the pattern's binding")
lsi_arm_scopes_and_guard()
    if !lsi_ready() then return

    azc_main_prints(raw"""
        main()
            val o: Option[int] = Some(4)
            val v = 100

            val got = o match
                Some(v) ->
                    val w = v + 1

                    w * 2
                None -> v

            val w = 1

            print(got, v, w)
        """, "10 100 1\n")

    azc_main_prints(raw"""
        pick(o: Option[int]) -> int
            val v = 1000

            o match
                Some(v) if v > 3 -> v
                Some(w) -> w + v
                None -> v

        main()
            print(pick(Some(5)), pick(Some(2)), pick(None))
        """, "5 1002 1000\n")

@test("lsi: one name bound in two sibling scopes, at two types, is two bindings")
lsi_sibling_scopes()
    if !lsi_ready() then return

    azc_main_prints(raw"""
        main()
            var out = ""

            for k in 0..<3
                if k == 1
                    val t = "one"

                    out = out + t
                else
                    val t = k * 10

                    out = out + s"$t"

                out = out + ","

            print(out)
        """, "0,one,20,\n")

@test("lsi: a multi-name binding reads its right side before any of its names hides the outer ones")
lsi_multi_name_swap()
    if !lsi_ready() then return

    azc_main_prints(raw"""
        main()
            val a, b = 1, 2

            if a < b
                val b, a = a, b

                print(a, b)

            print(a, b)
        """, "2 1\n1 2\n")

@test("lsi: a deferred statement reads the binding in scope where it is written, not a later one")
lsi_defer_reads_its_own()
    if !lsi_ready() then return

    azc_main_prints(raw"""
        main()
            val x = "outer"

            if x.len > 0
                defer print(x)

                val x = "inner"

                print(x)

            print(x)
        """, "inner\nouter\nouter\n")

@test("lsi: a while body's binding hides the loop's variable after the write that ends the loop")
lsi_while_and_loop_scopes()
    if !lsi_ready() then return

    azc_main_prints(raw"""
        main()
            var i = 0
            var acc = 0

            while i < 3
                val j = i

                i += 1

                var i = j * 2

                i += 100
                acc += i

            loop
                val acc = -1

                if acc < 0 then break

            print(i, acc)
        """, "3 306\n")

@test("lsi: a generic body's shadowing reads the same at each instantiation")
lsi_generic_twins()
    if !lsi_ready() then return

    azc_main_prints(raw"""
        struct Pair[T]
            a: T
            b: T

            swapped(self) -> Pair[T]
                val a = self.b

                if true
                    val a = self.a

                    return Pair(self.b, a)

                Pair(a, self.a)
        end Pair

        first[T](xs: []T) -> T
            val x = xs[0]

            for x in xs
                if true then return x

            x

        main()
            print(Pair(1, 2).swapped().a, Pair("p", "q").swapped().b)
            print(first([7, 8]), first(["s", "t"]))
        """, "2 p\n7 s\n")

@test("lsi: the entry file's binding hidden in a block is still the one a function of the file reads")
lsi_entry_bindings()
    if !lsi_ready() then return

    azc_main_prints(raw"""
        val count = 3
        var hits = 0

        bump(n: int) = hits += n

        if count > 0
            val count = 10

            bump(count)

        bump(count)
        print(hits, count)
        """, "13 3\n")

    azc_main_prints(raw"""
        val count = 3

        show() = print(count)

        if count > 0
            val count = 10

            show()
            print(count)

        show()
        """, "3\n10\n3\n")

// -- what a name finds no binding for -------------------------------------------------------------

@test("lsi: a name read above its binding is refused as declared below")
lsi_use_before_declaration_refused()
    if !lsi_ready() then return

    azc_refuses("main()\n    print(y)\n\n    val y = 1\n",
                "error: 'y' is declared below this, and a name is in scope from where it is bound onward")

@test("lsi: a name bound in a block that has closed is undefined")
lsi_closed_block_refused()
    if !lsi_ready() then return

    azc_refuses("main()\n    val a = 1\n\n    if a > 0\n        val z = 2\n\n        print(z)\n\n    print(z)\n",
                "error: undefined name 'z'")

// -- what is known of the binding a name finds ----------------------------------------------------

@test("lsi: the value an int is known to hold is the innermost binding's, inside the block")
lsi_known_value_innermost()
    if !lsi_ready() then return

    azc_refuses(raw"""
        main()
            val xs = [1, 2, 3]
            val k: int = 2

            if k > 0
                val k: int = -1

                print(xs.len + k)

            print(xs.len + k)
        """, "error: '+' needs matching types, got usize and int — an int and a usize meet only " +
             "where the value of one is known to fit the other's type")

    azc_main_prints(raw"""
        main()
            val xs = [1, 2, 3]
            val k: int = 2

            if k > 0
                val k: int = 5

                print(xs.len + k)

            print(xs.len + k)
        """, "8\n5\n")

@test("lsi: a diagnostic quotes the type as the binding the name finds wrote it")
lsi_spelled_type_of_the_binding_found()
    if !lsi_ready() then return

    val decls = "type Meters = int\ntype Grams = int\n\ntake(s: string) = print(s)\n\n"

    azc_refuses(decls + "main()\n    val v: Meters = 1\n\n    if v > 0\n        val v: Grams = 2\n\n" +
                "        take(v)\n",
                "error: 's' of 'take' is string, but Grams (aka int) was given")
    azc_refuses(decls + "main()\n    val v: Meters = 1\n\n    if v > 0\n        val v: Grams = 2\n\n" +
                "        print(v)\n\n    take(v)\n",
                "error: 's' of 'take' is string, but Meters (aka int) was given")

// -- the bindings a first use types, and the readings thrown away ---------------------------------

@test("lsi: an open binding hidden in a block is fixed by the use after the block, not the one inside")
lsi_open_binding_shadowed()
    if !lsi_ready() then return

    azc_main_prints(raw"""
        main()
            val b: u8 = 7
            val n = 3

            if b > 0
                val n = 300

                print(n)

            print(n + b)
        """, "300\n10\n")

    azc_refuses(raw"""
        main()
            val b: u8 = 7
            val n = 3

            if b > 0
                val n = 300

                print(n + b)

            print(n)
        """, "error: the literal 300 does not fit byte")

@test("lsi: a block read again binds its names afresh, and the first reading's answer no lookup")
lsi_reread_block_rebinds()
    if !lsi_ready() then return

    azc_main_prints(raw"""
        main()
            val b: u8 = 200
            var s = 0

            if b > 0
                val s = 5

                print(s + 1)

            s += b
            print(s)
        """, "6\n200\n")

    azc_main_prints(raw"""
        main()
            val b: u8 = 2
            var total = 0

            for k in 0..<3
                var acc = 1
                val k = k * 1

                acc += b
                total += k

            print(total)
        """, "3\n")

@test("lsi: a counted for's variable hidden in its own body is fixed by the use outside the binding")
lsi_counted_for_shadowed()
    if !lsi_ready() then return

    azc_main_prints(raw"""
        main()
            val b: u8 = 1
            var total: u8 = 0

            for i in 0..<5
                val i = i + b

                total += i

            for i in 0..<3
                total += i

            print(total)
        """, "18\n")

@test("lsi: a closure's parameter read in a thrown-away trial is bound again by the reading kept")
lsi_trial_closure_rebinds()
    if !lsi_ready() then return

    azc_main_prints(raw"""
        apply(f: &Fn(u8) -> u8, v: u8) -> u8 = f(v)

        main()
            val b: u8 = 9
            var s = 0

            s = apply((q) -> q + 1, b)

            val q = 40

            print(s, q)
        """, "10 40\n")

@test("lsi: an open binding a closure or a nested function captures is fixed by the use inside it")
lsi_open_binding_captured()
    if !lsi_ready() then return

    azc_main_prints(raw"""
        apply(f: &Fn(u8) -> u8, v: u8) -> u8 = f(v)

        main()
            val k = 250

            print(apply((b) -> b + k, 3))

            twice(b: u8) -> u8 = b + k

            print(twice(1))
        """, "253\n251\n")

    azc_main_prints(raw"""
        main()
            val k = 7

            if k > 0
                val k = 250

                add(b: u8) -> u8 = b + k

                print(add(3))

            print(k)
        """, "253\n7\n")

// -- a `ref`, while it is live and once its scope has closed --------------------------------------

private lsi_table(body: string) -> string =
    "struct Table\n    cell: []int\n\n    swap(*self, b: u8)\n" + body +
    "end Table\n\nvar t = Table([1, 2, 3])\n\nt.swap(4)\n"

@test("lsi: an assignment under a live ref is refused, also where a val hides the ref's name")
lsi_ref_live_refused()
    if !lsi_ready() then return

    val said = "error: 'e' is a 'ref' standing on storage this assignment would release"

    azc_refuses(lsi_table("        ref e = self.cell[0]\n\n        self.cell = [0; 8]\n        print(e)\n"),
                said)
    azc_refuses(lsi_table("        ref e = self.cell[0]\n\n        if e > 0\n            val e = 5\n\n" +
                          "            print(e)\n\n        self.cell = [0; 8]\n        print(e)\n"),
                said)

@test("lsi: an assignment after the ref's block has closed is accepted")
lsi_ref_scope_closed()
    if !lsi_ready() then return

    azc_main_prints(lsi_table("        if self.cell.len > 0\n            ref e = self.cell[0]\n\n" +
                              "            print(e)\n\n        self.cell = [0; 8]\n" +
                              "        print(self.cell.len)\n"),
                    "1\n8\n")

@test("lsi: a ref in a block read again is refused once, and is gone when the block closes")
lsi_ref_in_reread_block()
    if !lsi_ready() then return

    val said = azc_reports([("main.sysl", lsi_table("        var s = 0\n        ref e = self.cell[0]\n\n" +
                                                    "        s += b\n        self.cell = [0; 8]\n" +
                                                    "        print(e, s)\n"))])

    assert_eq(said.count_of("'e' is a 'ref' standing on storage"), 1)

    azc_main_prints(lsi_table("        var s = 0\n\n        if b > 0\n            ref e = self.cell[0]\n\n" +
                              "            s += b\n            print(e)\n\n        self.cell = [0; 8]\n" +
                              "        print(s, self.cell.len)\n"),
                    "1\n4 8\n")

// -- a view's holder, by the position of the binding a name finds ---------------------------------

private lsi_owner() -> string =
    "extern \"malloc\" c_malloc(n: usize) -> *u8\nextern \"free\" c_free(p: *u8)\n\n" +
    "struct Owner\n    p: *u8\n    n: usize\n\n" +
    "    @views(self)\n    view(&self) -> []const u8 = self.p[0..<self.n]\n\n" +
    "impl Drop for Owner\n    drop(self)\n        print(\"freed\")\n        c_free(self.p)\n\n" +
    "open(n: usize) -> &Owner\n    val p = c_malloc(n)\n\n    for i in 0..<n do p[i] = u8(65 + i)\n\n" +
    "    Owner(p, n)\n\n"

@test("lsi: a view of a binding hidden in a block, stored in a holder bound before it, is refused")
lsi_view_holder_of_inner_refused()
    if !lsi_ready() then return

    azc_refuses(lsi_owner() + "run()\n    val o = open(3)\n    var keep: []const u8 = []\n\n" +
                "    if true\n        val o = open(2)\n\n        keep = o.view()\n\n    print(keep.len)\n\nrun()\n",
                "error: 'keep' is bound before 'o', so it outlives it")

@test("lsi: a view of the outer binding, stored in a holder that hides an older one, is accepted")
lsi_view_holder_of_outer_accepted()
    if !lsi_ready() then return

    azc_main_prints(lsi_owner() + "run()\n    val o = open(3)\n    var keep: []const u8 = []\n\n" +
                    "    if true\n        val o = open(2)\n\n        print(o.view().len)\n\n" +
                    "    print(keep.len)\n\n    if true\n        var keep: []const u8 = []\n\n" +
                    "        keep = o.view()\n        print(keep[2])\n\nrun()\n",
                    "2\nfreed\n0\n67\nfreed\n")

// -- the work a body of many names takes ----------------------------------------------------------
//
// The analysis counts the bindings it looks at to answer which one a name is (`binding_probes`): one
// a question, where the search from the end of the scope stack looked at every binding above the one
// it found -- `n^2 / 2` for `n` locals each read once more at the end. The count is exact, so the test
// holds the growth to linear with no clock: doubling the locals at most doubles it.

private var lsi_library_cache: Buf[Program] = buf()
private var lsi_library_read: bool = false

private lsi_library() -> Buf[Program]
    if lsi_library_read then return lsi_library_cache

    lsi_library_read = true

    std_root() match
        Err(_) -> ()
        Ok(root) -> std_units(root, host_target()) match
            Err(_) -> ()
            Ok(units) -> lsi_library_cache = units

    lsi_library_cache
end lsi_library

// How many bindings analysing `text` looked at, beside the standard module's own bodies.
private lsi_probes(text: string) -> usize
    val parsed = parse(source_of("t.sysl", text))

    assert(parsed.ok(), "the program did not parse")

    var units: Buf[Program] = buf()

    for item in lsi_library()
        units.push(item)

    units.push(parsed.program)

    val done = analyze_bodies(units, host_target())

    if !done.reported.is_empty() then assert(false, s"the program was refused: ${done.reported[0].diag.message}")

    done.an.binding_probes
end lsi_probes

// The bindings a program of `n` looked at, less those of the same program of none.
private lsi_growth(shape: &Fn(int) -> string, n: int) -> usize = lsi_probes(shape(n)) - lsi_probes(shape(0))

private lsi_linear(shape: &Fn(int) -> string)
    val one = lsi_growth(shape, 1000)
    val two = lsi_growth(shape, 2000)
    val four = lsi_growth(shape, 4000)

    assert(one > 0, "nothing was looked up")
    assert(two <= 2 * one + 64, s"1000 names looked at $one bindings, 2000 looked at $two")
    assert(four <= 2 * two + 64, s"2000 names looked at $two bindings, 4000 looked at $four")
end lsi_linear

@test("lsi: locals each read once more at the end are looked up in work linear in their number")
lsi_reads_linear_work()
    if lsi_library().is_empty() then return

    lsi_linear((n) -> lsi_reads(n))

@test("lsi: locals fixed by their uses, the body read twice, are looked up in linear work")
lsi_fixed_reads_linear_work()
    if lsi_library().is_empty() then return

    lsi_linear((n) -> lsi_fixed_reads(n))

@test("lsi: sibling blocks each hiding one name are looked up in linear work")
lsi_shadowing_blocks_linear_work()
    if lsi_library().is_empty() then return

    lsi_linear((n) -> lsi_shadowing_blocks(n))

// -- the time a body of many names takes ----------------------------------------------------------
//
// The same bodies built whole, at sizes whose search took minutes: 32000 locals each read once more
// at the end spent 221 seconds reading the body in a release build of 0.13.5, against half a second
// now. Each builds on the stack the compiler gives its own work, as `main` does.

// `n` locals bound to literals -- each an open binding, typed by its first use -- and each read once
// more at the end, into a sum.
private lsi_reads(n: int) -> string
    var lines: Buf[string] = buf()

    lines.push("main()")

    for i in 0..<n
        lines.push(s"    val v$i = $i")

    lines.push("    var s = 0")

    for i in 0..<n
        lines.push(s"    s += v$i")

    lines.push("    print(s)\n")
    join(lines.view(), "\n")
end lsi_reads

// The same, with every binding fixed at `u64` by its use beside a typed sum, so that the body is read
// a second time with the types the first reading found.
private lsi_fixed_reads(n: int) -> string
    var lines: Buf[string] = buf()

    lines.push("main()")

    for i in 0..<n
        lines.push(s"    val v$i = 1")

    lines.push("    var s: u64 = 0")

    for i in 0..<n
        lines.push(s"    s += v$i")

    lines.push("    print(s)\n")
    join(lines.view(), "\n")
end lsi_fixed_reads

// `n` sibling blocks, each hiding `x` and reading both its own and the sum outside it.
private lsi_shadowing_blocks(n: int) -> string
    var lines: Buf[string] = buf()

    lines.push("main()\n    val x = 1\n    var s = 0\n")

    for i in 0..<n
        lines.push(s"    if x > 0\n        val x = $i\n\n        s += x\n")

    lines.push("    print(s + x)\n")
    join(lines.view(), "\n")
end lsi_shadowing_blocks

private struct LsiJob
    texts: *string
    passed: Atomic[i32]

private lsi_build_here(job: *LsiJob)
    val r = azc_ran([("main.sysl", job.texts[0])])

    if r.built && r.ok && r.out == job.texts[1] then job.passed.store(1)
    else print(s"built ${r.built}, exited zero ${r.ok}: ${r.said()}")

// `text` builds on the stack the compiler gives its own work, runs, and prints `want`.
private lsi_big_prints(text: string, want: string)
    if !lsi_ready() then return

    var texts: Buf[string] = buf()

    texts.push(text)
    texts.push(want)

    val job: &sync LsiJob = LsiJob(as_ptr(texts.view()), Atomic(0))

    on_compiler_stack(&lsi_build_here, &*job)
    assert(job.passed.load() == 1, "the program of many names did not build, run and print what it owes")
end lsi_big_prints

@test("lsi: 32000 locals, each read once more at the end, build in time")
lsi_reads_32000() = lsi_big_prints(lsi_reads(32000), "511984000\n")

@test("lsi: 16000 locals fixed by their uses, the body read twice, build in time")
lsi_fixed_reads_16000() = lsi_big_prints(lsi_fixed_reads(16000), "16000\n")

@test("lsi: 8000 sibling blocks each hiding one name build in time and read the right binding")
lsi_shadowing_blocks_8000() = lsi_big_prints(lsi_shadowing_blocks(8000), "31996001\n")
