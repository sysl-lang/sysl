module sysl.container

/** A sequence that grows and that is cheap to take from at **either** end.
 *
 * **The reason this exists beside `Buf` is one line of cost.** A queue written over a growable
 * sequence takes from the front with `remove(0)`, which shifts every remaining element down one --
 * so a loop that pushes n things and pops them all is quadratic, and reads as though it were linear.
 * That is the shape of every breadth-first walk, every work list and every scheduler run queue, and
 * it is the one place the library was quietly teaching an accident.
 *
 * **The elements live in a ring**: `head` says where the first one is, `count` says how many follow,
 * and both ends wrap around the end of the storage rather than moving anything. Taking from the
 * front advances `head` and touches nothing else; adding to the front steps it backwards into the
 * space that leaves. Neither end shifts, which is the whole point.
 *
 * **A slot the ring is not using holds `None`**, which holds nothing. That is what lets the storage
 * be made before there is anything to put in it, and what makes taking an element out let go of it
 * there and then: the slot it leaves is written `None`, so a destructor behind the element runs when
 * the deque gives it up rather than when the storage goes. `Buf` keeps its spare slots empty a
 * different way -- a buffer's live slots are a *prefix*, which `slot_storage` and `slot_vacate`
 * describe -- and a ring's are not, since `push_front` writes the far end of the storage first.
 *
 * **The storage length is always a power of two**, because it starts at eight and only ever doubles,
 * so wrapping is a mask rather than a division. That invariant is worth stating because it is what
 * every index calculation here assumes -- there is no `%` anywhere below, and a growth path that
 * produced a non-power-of-two length would break all of them at once rather than visibly.
 *
 * **A `Deque` is a reference to its ring, not the ring.** Assigning one, passing it, capturing it in a
 * closure or reading it out of another container gives a second name for the same deque: a
 * `push_front` through either is seen by both, a growth included. A destructor behind an element runs
 * when the element is taken out, or when the last name for the deque goes.
 *
 * The bounds-checked members panic rather than answering an `Option`, which is the bargain `Buf`
 * makes for the same reason: an index past the end is a mistake in the program. `pop_front` and
 * `pop_back` answer an `Option`, because taking from an empty sequence is a question a caller asks
 * on purpose.
 */
struct Deque[T]
    private core: &DequeCore[T]

    /** Where the first element sits in the storage. Read-only: the ring is the core's to move. */
    head -> usize = self.core.head

    /** How many elements there are -- `len()` under the name the field had. */
    count -> usize = self.core.count

    len(self) -> usize = self.core.count

    cap(self) -> usize = self.core.elems.len

    is_empty(self) -> bool = self.core.count == 0

    @inline
    at(self, i: usize) -> T = self.core.at(i)

    set(self, i: usize, v: T) = self.core.set(i, v)

    first(self) -> Option[T] = self.core.first()

    last(self) -> Option[T] = self.core.last()

    @inline
    push_back(self, v: T) = self.core.push_back(v)

    /** The end `Buf` has no answer for at all. */
    @inline
    push_front(self, v: T) = self.core.push_front(v)

    @inline
    pop_front(self) -> Option[T] = self.core.pop_front()

    @inline
    pop_back(self) -> Option[T] = self.core.pop_back()

    /** The elements dropped and the head put back at the start. The storage is kept, which is what
     * makes a deque reused across passes of a loop allocate once rather than once per pass.
     */
    clear(self) = self.core.clear()

    walk(self) -> DequeCursor[T] = DequeCursor(self.core.elems, self.core.head, self.core.count, 0)

    /** A second deque holding the same elements in the same order, the front put back at the start
     * of its storage -- the one way to get a deque that is not this one, every other way of handing a
     * `Deque` on handing on this one.
     */
    copy(self) -> Deque[T]
        var slots: []Option[T] = [None; self.core.elems.len]

        for i in 0..<self.core.count
            slots[i] = Some(self.core.at(i))

        Deque(DequeCore(slots, 0, self.core.count))
end Deque

/** The ring itself, which every `Deque` naming it shares. Everything that moves the head, the count
 * or the storage lives here, so a push through one handle -- a growth included -- is what every other
 * handle reads next.
 */
private[container] struct DequeCore[T]
    elems: []Option[T]
    head: usize
    count: usize

    /** Where the `i`th element from the front actually lives. Every accessor goes through this, which
     * is what keeps the wrapping in one place instead of at each end.
     */
    seat(self, i: usize) -> usize = (self.head + i) & (self.elems.len - 1)

    at(self, i: usize) -> T
        if i >= self.count
            print("panic: index", i, "past the", self.count, "elements of a Deque")
            exit(1)
        self.elems[self.seat(i)].unwrap()

    set(*self, i: usize, v: T)
        if i >= self.count
            print("panic: index", i, "past the", self.count, "elements of a Deque")
            exit(1)
        val s = self.seat(i)
        self.elems[s] = Some(v)
    end set

    first(self) -> Option[T] = if self.count == 0 then None else self.elems[self.head]

    last(self) -> Option[T] = if self.count == 0 then None else self.elems[self.seat(self.count - 1)]

    /** Storage twice the size with the elements laid down **unwrapped**, so the new ring starts at
     * zero and the head is back at the beginning. Every slot of the new storage starts as `None`. The
     * rare half of both pushes, kept out of line so a push that has room is a store and a count.
     */
    @noinline
    @cold
    grow(*self)
        val bigger_len = if self.elems.len == 0 then 8usize else self.elems.len * 2
        var bigger: []Option[T] = [None; bigger_len]

        for i in 0..<self.count
            bigger[i] = self.elems[self.seat(i)]

        self.elems = bigger
        self.head = 0
    end grow

    @inline
    push_back(*self, v: T)
        if self.count == self.elems.len then self.grow()

        val s = self.seat(self.count)

        self.elems[s] = Some(v)
        self.count += 1
    end push_back

    /** `head` steps backwards by adding the storage length before subtracting one, so that the
     * arithmetic never goes below zero on the way -- a `usize` that wraps would name a slot at the far
     * end of memory rather than the far end of the ring.
     */
    @inline
    push_front(*self, v: T)
        if self.count == self.elems.len then self.grow()

        self.head = (self.head + self.elems.len - 1) & (self.elems.len - 1)
        self.elems[self.head] = Some(v)
        self.count += 1
    end push_front

    pop_front(*self) -> Option[T]
        if self.count == 0 then return None

        val v = self.elems[self.head]

        self.elems[self.head] = None
        self.head = (self.head + 1) & (self.elems.len - 1)
        self.count -= 1
        v
    end pop_front

    pop_back(*self) -> Option[T]
        if self.count == 0 then return None

        self.count -= 1

        val s = self.seat(self.count)
        val v = self.elems[s]

        self.elems[s] = None
        v
    end pop_back

    clear(*self)
        for i in 0..<self.count
            self.elems[self.seat(i)] = None

        self.head = 0
        self.count = 0
    end clear
end DequeCore

/** Subscripting reaches the bounds-checked members rather than the storage, so `d[i]` counts from the
 * **front** of the deque and cannot read a slot the ring is not currently using.
 */
impl[T] Index[usize, T] for Deque[T]
    index(self, i: usize) -> T = self.at(i)

impl[T] IndexSet[usize, T] for Deque[T]
    index_set(*self, i: usize, v: T) = self.set(i, v)

deque[T]() -> Deque[T] = Deque(DequeCore([], 0, 0))

/** A deque with room for `n` elements already under it. Every slot starts as `None`, so `fill` is
 * not stored anywhere; the parameter stays because callers write it, and because it is what lets a
 * call say the element type without brackets.
 *
 * The storage is rounded **up** to a power of two, because the mask every index goes through is only
 * correct for those lengths.
 */
deque_with_capacity[T](n: usize, fill: T) -> Deque[T]
    var want: usize = 8

    while want < n
        want *= 2

    val slots: []Option[T] = [None; want]

    Deque(DequeCore(slots, 0, 0))
end deque_with_capacity

// ------------------------------------------------------------------------------------- walking

/** A walk from the front to the back. It holds the storage rather than the deque, so pushing onto the
 * deque while a cursor is live leaves the cursor reading the ring it started on; an element the deque
 * gives up meanwhile is a slot that reads `None`, and the walk ends there.
 */
struct DequeCursor[T]
    private elems: []Option[T]
    head: usize
    count: usize
    at: usize

impl[T] Iterate for DequeCursor[T]
    type Item = T
    next(*self) -> Option[T]
        if self.at >= self.count then return None

        val v = self.elems[(self.head + self.at) & (self.elems.len - 1)]

        self.at += 1
        v
    end next
