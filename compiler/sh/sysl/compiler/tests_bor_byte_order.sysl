module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.fs.{make_temp_dir, remove_dir_all, write_text}
import sysl.process.{capture, Status}
import sysl.text.{join, Search}

// **A value's bytes in a stated order** -- `sysl.math.ByteOrder`'s members on every whole-byte
// integer, and `@byte_order(big)`/`@byte_order(little)` on a struct, whose integer fields are stored in
// that order and read and written as plain integers (`byte_order.sysl`). `reference/attributes.md §
// @byte_order` and `library/math.md § ByteOrder` are the spec.

private bor_ready() -> bool = std_root().is_ok() && clang_available()

// The program built at `level` and run: its status, what it printed, and what it wrote to standard
// error -- the refusal, where the build was refused.
private bor_run(text: string, level: string) -> (Status, string, string)
    val root = make_temp_dir("sysl-bor").unwrap()

    write_text(s"$root/main.sysl", text).unwrap()

    val exe = s"$root/built"

    build_native_program(root, None, None, level, Some(exe)) match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return (Status.Exited(-1), "", failure_text(why))
        Ok(_) -> ()

    val said = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    said match
        Err(_) -> (Status.Exited(-1), "", "the program that was built could not be run")
        Ok(out) -> (out.status, out.text, out.err.unwrap_or(""))
end bor_run

// At both levels, the program exits cleanly having printed `printed` and nothing on standard error.
private bor_prints(text: string, printed: string)
    if !bor_ready() then return

    for level in ["0", DefaultOptimization]
        val (state, out, err) = bor_run(text, level)

        assert_eq(err, "")
        assert_eq(out, printed)
        assert(state == Status.Exited(0), s"-O$level stopped with $state")
end bor_prints

// The program is refused with exactly one diagnostic, this message at this position.
private bor_refused(text: string, message: string, line: int, col: int)
    if !bor_ready() then return

    val (_, _, err) = bor_run(text, "0")
    val head = s"error: $message\n"
    val at = s"/main.sysl:$line:$col\n"

    assert(err.contains(head), s"expected\n$head\nin\n$err")
    assert(err.contains(at), s"expected\n$at\nin\n$err")
    assert_eq(err.count_of("error: "), 1)
end bor_refused

// The bytes a value is stored as, read through its address, as decimal numbers with a space after each.
private val bor_bytes_of: string = raw"""
    bytes_of[T](v: *T, n: usize) -> string
        val p: *u8 = ptr_cast(v)
        var out = ""

        for i in 0..<n
            out = out + s"${p[i]} "

        out

    """

// -- ByteOrder ---------------------------------------------------------------------------------------

@test("swap_bytes reverses every whole-byte width, one, three and five bytes included")
bor_swap_bytes_every_whole_byte_width()
    bor_prints(raw"""
        import sysl.math.ByteOrder

        val k: u32 = 0x11223344
        val w: u40 = 0x0102030405

        print(0x1234u16.swap_bytes() == 0x3412, k.swap_bytes() == 0x44332211, u8(7).swap_bytes())
        print(u24(0x010203).swap_bytes() == 0x030201, w.swap_bytes() == 0x0504030201)
        print(i16(-2).swap_bytes(), u64(1).swap_bytes() == 1 << 56, k.swap_bytes().swap_bytes() == k)
        """, "true true 7\ntrue true\n-257 true true\n")
end bor_swap_bytes_every_whole_byte_width

@test("on a little-endian machine to_be and from_be reverse, and to_le and from_le are the value")
bor_the_directions_follow_the_machine()
    bor_prints(raw"""
        import sysl.math.ByteOrder

        val k: u32 = 0x11223344

        print(k.to_be() == 0x44332211, k.from_be() == 0x44332211, k.to_be().from_be() == k)
        print(k.to_le() == k, k.from_le() == k, i64(-1).to_be())
        """, "true true true\ntrue true -1\n")
end bor_the_directions_follow_the_machine

@test("a width that is not a whole number of bytes is not a member, and the trait has to be imported")
bor_membership_is_whole_bytes()
    bor_refused(raw"""
        import sysl.math.ByteOrder

        val n: u12 = 5

        print(n.swap_bytes())
        """, "type 'u12' has no method 'swap_bytes'", 5, 9)

    bor_refused(raw"""
        val n: u32 = 5

        print(n.to_be())
        """, "type 'uint' has no method 'to_be'", 3, 9)
end bor_membership_is_whole_bytes

@test("a reordered constant folds: in a const, through a const function, and as module storage")
bor_byte_order_folds()
    bor_prints(raw"""
        import sysl.math.ByteOrder

        const PORT: u16 = 0x0035u16.to_be()
        const NEG: i16 = i16(-2).swap_bytes()

        const be(v: u32) -> u32 = v.to_be()

        const ADDR: u32 = be(0x0a00020f)

        val image: u32 = 0x0a00020fu32.to_be()

        print(PORT, NEG, ADDR == 0x0f02000a, image == ADDR)
        """, "13568 -257 true true\n")
end bor_byte_order_folds

// -- @byte_order on a struct --------------------------------------------------------------------------

private val bor_udp: string = raw"""
    @packed
    @byte_order(big)
    struct Udp
        src: u16
        dst: u16
        len: u16
        sum: u16

    """

@test("a big-endian struct stores its fields most significant byte first and reads them as integers")
bor_big_endian_fields_round_trip()
    bor_prints(bor_udp + bor_bytes_of + raw"""
        var h = Udp(5353, 53, 8, 0)

        h.len += 4
        h.sum = 0xBEEF

        print(h.src, h.dst, h.len, h.sum)
        print(bytes_of(&h, sizeof(Udp)))

        val p: *Udp = &h

        p.dst -= 1
        p.len = p.len * 2

        print(h.dst, h.len, bytes_of(&h, sizeof(Udp)))
        """, "5353 53 12 48879\n20 233 0 53 0 12 190 239 \n52 24 20 233 0 52 0 24 190 239 \n")
end bor_big_endian_fields_round_trip

@test("every kind of field: an enum, a new type, a negative i32, a u24, a bool, bytes and a nested struct")
bor_every_kind_of_field()
    bor_prints(bor_bytes_of + raw"""
        enum Kind: u16
            File = 1
            Dir = 0x0203

        type Ip = new u32

        @byte_order(big)
        struct Inner
            a: u16

        @packed
        @byte_order(big)
        struct Rec
            kind: Kind
            ip: Ip
            neg: i32
            mid: u24
            flag: bool
            tag: [2]u8
            inner: Inner

        var r = Rec(Kind.Dir, Ip(0x0a00020f), -2, 0x010203, true, [7, 8], Inner(0x1122))

        // Thirteen bytes: the u24's storage has a fourth byte no field writes.
        print(bytes_of(&r, 13))
        print(Kind::Image(r.kind), u32(r.ip), r.neg, r.mid, r.flag, r.tag[1], r.inner.a)

        r.neg -= 1
        r.mid += 1
        r.inner.a = 0x3344
        r.ip = Ip(0x01020304)

        print(bytes_of(&r, 13))

        r match
            Rec(k, ip, n, m, f, _, i) -> print(Kind::Image(k), u32(ip), n, m, f, i.a)
        """, "2 3 10 0 2 15 255 255 255 254 1 2 3 \n" +
             "Dir 167772687 -2 66051 true 8 4386\n" +
             "2 3 1 2 3 4 255 255 255 253 1 2 4 \n" +
             "Dir 16909060 -3 66052 true 13124\n")
end bor_every_kind_of_field

@test("module storage of a byte-ordered struct is laid down in the struct's order")
bor_module_storage_image()
    bor_prints(bor_udp + bor_bytes_of + raw"""
        val fixed = Udp(0x0102, 0x0304, 0, 0xFFFE)

        var copy = fixed

        print(bytes_of(&copy, sizeof(Udp)), fixed.src, fixed.sum)
        """, "1 2 3 4 0 0 255 254  258 65534\n")
end bor_module_storage_image

@test("a @packed struct in module storage is laid down as a packed constant, ordered or not")
bor_packed_module_storage()
    bor_prints(bor_udp + raw"""
        @packed
        struct H
            a: u8
            b: u16

        static val h: H = H(1, 0x0203)
        static val u: Udp = Udp(0x0102, 53, 8, 0)

        print(h.a, h.b, sizeof(H), u.src, u.dst)
        """, "1 515 3 258 53\n")
end bor_packed_module_storage

@test("a little-endian struct, a generic one, a large one, and an invariant all read the value")
bor_little_generic_large_invariant()
    bor_prints(bor_bytes_of + raw"""
        @byte_order(little)
        struct Le
            v: u32

        @byte_order(big)
        struct Be[T]
            v: T

        @byte_order(big)
        struct Large
            pad: [64]u8
            x: u32

        @byte_order(big)
        struct Small
            n: u16
            invariant n < 300

        var le = Le(0x01020304)
        var be = Be[u32](0x01020304)
        var neg = Be(i16(-2))
        var large = Large([0; 64], 0xA0B0C0D0)

        large.x += 1

        var small = Small(258)

        small.n += 1

        print(bytes_of(&le, 4), bytes_of(&be, 4), be.v, bytes_of(&neg, 2), neg.v)
        print(bytes_of(&large, sizeof(Large))[128..], large.x, bytes_of(&small, 2), small.n)
        """, "4 3 2 1  1 2 3 4  16909060 255 254  -2\n160 176 192 209  2695938257 1 3  259\n")
end bor_little_generic_large_invariant

@test("a bitfield struct with a byte order keeps its container in that order")
bor_bitfield_container_is_ordered()
    bor_prints(bor_bytes_of + raw"""
        @packed
        @byte_order(big)
        struct Frag
            offset: u13
            more: u1
            dont: u1
            reserved: u1

        @packed
        @byte_order(big)
        struct Tail
            ident: u16
            frag: Frag
            ttl: u8

        var t = Tail(0x1c46, Frag(0x123, 0, 1, 0), 64)

        print(bytes_of(&t, sizeof(Tail)), t.frag.dont, t.frag.offset, t.frag.bits)

        t.frag.more = 1
        t.frag.offset += 1

        print(bytes_of(&t, sizeof(Tail)), Frag::Bits(0x8001).reserved, Frag::Bits(0x8001).offset)

        t.frag match
            Frag(o, m, d, _) -> print(o, m, d)
        """, "28 70 65 35 64  1 291 16675\n28 70 97 36 64  1 1\n292 1 1\n")
end bor_bitfield_container_is_ordered

// -- refusals -----------------------------------------------------------------------------------------

@test("the address of an ordered field, and a ref to one, are refused")
bor_no_pointer_into_an_ordered_field()
    val head = raw"""
        @byte_order(big)
        struct Hdr
            len: u16

        var h = Hdr(1)
        """

    bor_refused(head + "val p = &h.len\n\nprint(1)\n",
                "'&' here would reach a 'ushort' inside Hdr, which is '@byte_order(big)' — the field " +
                "holds its bytes most significant first whatever the machine does, and a '*ushort' is " +
                "read in the machine's order. Read or write the field through the struct, which is " +
                "where the order is applied, or take the address of the Hdr itself", 6, 9)
    bor_refused(head + "ref r = h.len\n\nprint(r)\n",
                "'ref' here would reach a 'ushort' inside Hdr, which is '@byte_order(big)' — the field " +
                "holds its bytes most significant first whatever the machine does, and a '*ushort' is " +
                "read in the machine's order. Read or write the field through the struct, which is " +
                "where the order is applied, or take the address of the Hdr itself", 6, 1)
end bor_no_pointer_into_an_ordered_field

@test("a field with no byte order to keep is refused, each saying what to hold instead")
bor_unordered_fields_are_refused()
    bor_refused("@byte_order(big)\nstruct S\n    level: f32\n\nprint(sizeof(S))\n",
                "'S.level' is f32, and 'S' is '@byte_order(big)' — a float is put in an order through " +
                "its bits, which the language does not do behind a field read. Hold it as the unsigned " +
                "integer of its width and convert with '.bits()' and 'from_bits'", 1, 1)
    bor_refused("@byte_order(big)\nstruct S\n    slots: [4]u16\n\nprint(sizeof(S))\n",
                "'S.slots' is [4]ushort, and 'S' is '@byte_order(big)' — an element is reached by index " +
                "rather than read as a field, and the order is applied where a field is read. Hold it as " +
                "bytes, '[N]u8', or make the element a '@byte_order' struct of its own", 1, 1)
    bor_refused("struct P\n    a: u16\n\n@byte_order(big)\nstruct S\n    p: P\n\nprint(sizeof(S))\n",
                "'S.p' is P, and 'S' is '@byte_order(big)' — 'P' keeps its integers in the machine's " +
                "order, so a field of it would be read in the wrong one. Mark it '@byte_order' too", 4, 1)
    bor_refused("@byte_order(big)\nstruct S\n    next: *u8\n\nprint(sizeof(S))\n",
                "'S.next' is *byte, and 'S' is '@byte_order(big)' — an address means nothing outside " +
                "the memory it points into, and a struct with a byte order is laid out to be written " +
                "somewhere else. Hold an offset or an index instead", 1, 1)
    bor_refused("@byte_order(little)\nstruct S\n    c: char\n\nprint(sizeof(S))\n",
                "'S.c' is char, and 'S' is '@byte_order(little)' — a 'char' is a Unicode scalar value " +
                "rather than a number of a width. Hold it as a 'u32' and convert with 'char(...)', which " +
                "checks it", 1, 1)
    bor_refused("enum E\n    A(x: int)\n    B\n\n@byte_order(big)\nstruct S\n    e: E\n\nprint(sizeof(S))\n",
                "'S.e' is E, and 'S' is '@byte_order(big)' — an enum that carries data is a tag beside " +
                "a payload rather than one integer, so there is no one value to put in an order. Hold " +
                "the tag as an integer field and the payload as fields of their own", 5, 1)
    bor_refused("@byte_order(big)\nstruct S\n    a: u12\n    b: u20\n\nprint(sizeof(S))\n",
                "'S.a' is u12, and 'S' is '@byte_order(big)' — a value that is not a whole number of " +
                "bytes has no byte order to keep. Widen it to the whole bytes it occupies, or hold the " +
                "bits in a '@packed' struct of their own", 1, 1)
end bor_unordered_fields_are_refused

@test("a bitfield struct needs an order of its own inside an ordered one; a partial last byte is fine")
bor_bitfield_refusals()
    bor_refused("@packed\nstruct F\n    a: u4\n    b: u12\n\n@byte_order(big)\nstruct S\n    f: F\n\n" +
                "print(sizeof(S))\n",
                "'S.f' is F, and 'S' is '@byte_order(big)' — 'F' is a bitfield struct, one integer in " +
                "the machine's order, so its ranges would be taken from the wrong one. Mark it " +
                "'@byte_order' too, which orders that integer", 6, 1)

    // Twelve bits are held in a sixteen-bit container, and the container is what is ordered.
    bor_prints("@packed\n@byte_order(big)\nstruct F\n    a: u4\n    b: u8\n\nvar f = F(1, 0x23)\n" +
               "val p: *u8 = ptr_cast(&f)\n\nprint(sizeof(F), p[0], p[1], f.b)\n", "2 2 49 35\n")
end bor_bitfield_refusals

@test("the order is one of two words, and the attribute marks a struct and nothing else")
bor_attribute_refusals()
    bor_refused("@byte_order(middle)\nstruct S\n    a: u16\n\nprint(1)\n",
                "'@byte_order' names the order in parentheses — '@byte_order(big)' for a network " +
                "header, which keeps the most significant byte first, or '@byte_order(little)' for a " +
                "format that keeps the least significant first", 1, 13)
    bor_refused("@byte_order\nstruct S\n    a: u16\n\nprint(1)\n",
                "'@byte_order' names the order in parentheses — '@byte_order(big)' for a network " +
                "header, which keeps the most significant byte first, or '@byte_order(little)' for a " +
                "format that keeps the least significant first", 1, 12)
    bor_refused("@byte_order(big)\nvar n: u16 = 1\n\nprint(n)\n",
                "'@byte_order(...)' is the order a struct's integer fields keep their bytes in, so it " +
                "can only mark a struct — and this declares none. A lone value is put in an order with " +
                "'to_be' and 'from_be', the members 'sysl.math.ByteOrder' gives every whole-byte integer",
                2, 1)
    bor_refused("struct S\n    @byte_order(big)\n    a: u16\n\nprint(1)\n",
                "'@byte_order(...)' is the order every integer field of a struct keeps its bytes in, so " +
                "it stands above the struct — a format whose fields disagree is two structs, one of " +
                "them held as a field of the other", 2, 5)
end bor_attribute_refusals
