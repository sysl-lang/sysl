module sh.sysl.compiler
@tests

import sh.sysl.parsing.*
import sysl.text.Search
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}

// An application whose arguments fail a type's bounds is refused where it is written -- and ONLY
// there. Laying the type out at those arguments meets its own fields, and an application inside them
// failing too is the same mistake seen from inside the type: reported there, it lands on a
// declaration that is right (`struct L[D: Dr]` blamed for `D` not being bounded by `Dr`).
//
// The reference (0.0.162) reports each program here once, at T2's field. Each is a whole program
// compiled against the standard module, so every test here wants `SYSL_LIB`.

private bsl_ready() -> bool
    if std_root().is_err()
        print("skipped: the standard module's source is not on this machine")
        return false
    end if

    true
end bsl_ready

// What a program that must be refused is told, every diagnostic in one report.
private bsl_err(text: string) -> string
    val root = make_temp_dir("sysl-bound-scope-leak").unwrap()
    val src = s"$root/main.sysl"

    make_dir_all(root).unwrap()
    write_text(src, text).unwrap()

    val out = emit_llvm_text(src, None) match
        Err(why) -> why.message
        Ok(made) -> if made.report.is_empty() then "" else analysis_report(made.report)

    remove_dir_all(root).unwrap_or(())
    out
end bsl_err

private bsl_message() -> string =
    "'L' requires its type parameter 'D' to implement 'Dr', but 'D' is not bounded by it"

// Exactly one refusal, and it is T2's.
private bsl_only_t2(said: string, own_line: string, t2_line: string)
    assert_eq(said.count_of(bsl_message()), 1)
    assert(said.index_of(t2_line).is_some(), s"expected T2's field «$t2_line» in:\n$said")
    assert(said.index_of(own_line).is_none(), s"L's own field «$own_line» was blamed:\n$said")

@test("a type applied to itself in its own field is not blamed for another type's unbounded argument")
bsl_a_self_application_is_not_blamed()
    if !bsl_ready() then return

    val said = bsl_err(raw"""
        trait Dr
            tick(self) -> int

        struct L[D: Dr]
            next: *L[D]

        struct T2[D]
            cb: *L[D]

        print("hi")
        """)

    bsl_only_t2(said, "next: *L[D]", "cb: *L[D]")

@test("nor where the self-application sits inside a callable inside an Option")
bsl_inside_a_callable_is_not_blamed()
    if !bsl_ready() then return

    val said = bsl_err(raw"""
        trait Dr
            tick(self) -> int

        struct L[D: Dr]
            f: Option[&Fn(*L[D]) -> unit]

        struct T2[D]
            cb: &Fn(*L[D]) -> unit

        print("hi")
        """)

    bsl_only_t2(said, "f: Option[&Fn(*L[D]) -> unit]", "cb: &Fn(*L[D]) -> unit")

@test("nor an enum whose variant carries the self-application")
bsl_an_enum_variant_is_not_blamed()
    if !bsl_ready() then return

    val said = bsl_err(raw"""
        trait Dr
            tick(self) -> int

        enum L[D: Dr]
            Node(next: *L[D])
            End

        struct T2[D]
            cb: *L[D]

        print("hi")
        """)

    bsl_only_t2(said, "Node(next: *L[D])", "cb: *L[D]")

// The quiet reading covers only the refused instantiation's own fields: a type reached from inside
// them that is wrong on its own account is still refused at its own declaration.
@test("a declaration reached from inside the refused one is still held to its own bounds")
bsl_a_wrong_declaration_inside_is_still_refused()
    if !bsl_ready() then return

    val said = bsl_err(raw"""
        trait Dr
            tick(self) -> int

        struct T2[D]
            cb: *L[D]

        struct L[D: Dr]
            g: *B[D]

        struct B[Y]
            h: *M[Y]

        struct M[X: Dr]
            x: X

        print("hi")
        """)

    val own = "'M' requires its type parameter 'X' to implement 'Dr', but 'Y' is not bounded by it"

    assert_eq(said.count_of(bsl_message()), 1)
    assert(said.index_of(own).is_some(), s"B's own refusal is missing:\n$said")
    assert(said.index_of("g: *B[D]").is_none(), s"L's own field was blamed:\n$said")
