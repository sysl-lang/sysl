module sh.sysl.compiler
@tests

import sh.sysl.parsing.source_of
import sysl.buf.{Buf, buf}
import sysl.text.Search

// **What a `const` function's declaration accepts, its evaluation runs.** The declaration check
// (`const_check.sysl`) passes a discard, a `?` and the simple-enum conversions and attributes, so the
// evaluator (`const_eval.sysl`) has to run each of them: a `const` asked for one reports it as a
// compile error, and a module `val` initialized by one is quietly filled at startup instead of laid
// down as data -- which shuts it out of a freestanding image.
//
// **A discard needs no zero.** `_ = e` keeps its value in a hidden local the lowering empties to the
// type's zero before and after the statement, and a `Result` has no zero the evaluation holds. The
// local is left holding nothing, refused only where it is read, and nothing reads it.
//
// Every positive case prints the same calls twice -- once as constants, once made at run time -- and
// the two lines must agree.

private cdz_ready() -> bool = enm_ready()

// A freestanding archive's LLVM text, or the first thing the compilation said.
private cdz_archive(text: string) -> string
    val t = target_named("thumbv6m-freestanding").unwrap()
    var units: Buf[Program] = buf()

    std_root() match
        Err(_) -> return "skipped"
        Ok(root) -> std_units(root, t) match
            Err(_) -> return "skipped"
            Ok(read) -> units = read

    val parsed = parse(source_of("main.sysl", forms_imported(text)), t)

    if !parsed.ok() then return parsed.report.at(0).message

    units.push(parsed.program)

    val done = analyze_produced(units, t, buf(), false)

    for item in done.reported
        if !item.src.name.starts_with("library/") then return item.diag.message

    val whole = program_of(done, done.main_module) with { entry_point = false, c_artifact = true }
    var own: Buf[string] = buf()

    own.push("")

    val pr = post_analysis_checks(done.an, whole, own)

    for item in done.an.diagnostics()
        if !item.src.name.starts_with("library/") then return item.diag.message

    ir_print_module(codegen_with_gaps(prune(strip_tests(whole), own), t, pr).0)
end cdz_archive

// The storage is the constant the object file carries, and nothing runs before `main` to fill it.
private cdz_laid_down(out: string, global: string)
    if out == "skipped" then return

    assert(out.contains(global), out)
    assert(!out.contains("llvm.global_ctors"), out)
end cdz_laid_down

// Both lines a differential program prints, which must be the same line.
private cdz_agree(text: string, expected: string)
    assert_eq(enm_ran(text), s"$expected\n$expected\n")

private cdz_refused(text: string, part: string)
    val out = enm_outcome(text)

    assert(!out.1, out.0)
    assert(out.0.contains(part), out.0)
end cdz_refused

private val cdz_r: string = "const r(x: int) -> Result[int, string] = if x > 0 then Ok(x) else Err(\"no\")\n\n"

// -- the discard ---------------------------------------------------------------------------------------

@test("'_ =' of a Result inside a 'const' function runs while compiling")
cdz_discard_of_a_result()
    if !cdz_ready() then return

    cdz_agree(cdz_r + "const one() -> int\n    _ = r(3)\n    1\n\nconst first = one()\n\n" +
              "print(first)\nprint(one())\n", "1")
end cdz_discard_of_a_result

// guards: a module val from a discarding const call is laid down, freestanding
@test("and a module 'val' it initializes is laid down as data for a freestanding archive")
cdz_discard_val_laid_down()
    if !cdz_ready() then return

    cdz_laid_down(cdz_archive(cdz_r + "const one() -> int\n    _ = r(3)\n    1\n\nval FIRST = one()\n\n" +
                              "@export(\"main\")\nmain_entry() -> int = FIRST\n"),
                  "@FIRST = private constant i32 1\n")
end cdz_discard_val_laid_down

@test("a discard in a loop, of a struct holding a Result, of an Option of one, and of a failure")
cdz_discard_shapes()
    if !cdz_ready() then return

    cdz_agree(cdz_r + "struct Pair\n    a: int\n    b: Result[int, string]\n\n" +
              "const looped(n: int) -> int\n    var t = 0\n\n    for i in 0..<n\n        _ = r(i)\n" +
              "        t += i\n\n    t\n\n" +
              "const pair() -> int\n    _ = Pair(4, r(4))\n    5\n\n" +
              "const opt() -> int\n    _ = Some(r(2))\n    6\n\n" +
              "const failed() -> int\n    _ = r(-1)\n    7\n\n" +
              "const A = looped(4)\nconst B = pair()\nconst C = opt()\nconst D = failed()\n\n" +
              "print(A, B, C, D)\nprint(looped(4), pair(), opt(), failed())\n", "6 5 6 7")
end cdz_discard_shapes

@test("a discarded part beside a kept one, written apart and taken out of a tuple")
cdz_discard_beside_a_kept_part()
    if !cdz_ready() then return

    cdz_agree(cdz_r + "const apart() -> int\n    var b = 0\n    _, b = r(1), 2\n    b\n\n" +
              "const taken() -> int\n    var b = 0\n    _, b = (r(1), 3)\n    b\n\n" +
              "const A = apart()\nconst B = taken()\n\nprint(A, B)\nprint(apart(), taken())\n", "2 3")
end cdz_discard_beside_a_kept_part

// -- `?` -----------------------------------------------------------------------------------------------

private val cdz_try: string =
    "struct Big\n    code: usize\n\nimpl From[string] for Big\n    const from(s: string) -> Big = Big(s.len)\n\n" +
    "const add(a: int, b: int) -> Result[int, string]\n    val x = r(a)?\n    val y = r(b)?\n    Ok(x + y)\n\n" +
    "const widened(a: int) -> Result[int, Big]\n    val x = r(a)?\n    Ok(x * 10)\n\n" +
    "const opt(a: int) -> Option[int]\n    val x = (if a > 0 then Some(a) else None)?\n    Some(x + 1)\n\n" +
    "const in_loop(n: int) -> Result[int, string]\n    var t = 0\n\n    for i in 0..<n\n" +
    "        t += r(3 - i)?\n\n    Ok(t)\n\n" +
    "const show(v: Result[int, string]) -> int = v match\n    Ok(x) -> x\n    Err(s) -> -int(s.len)\n\n" +
    "const show_big(v: Result[int, Big]) -> int = v match\n    Ok(x) -> x\n    Err(b) -> -int(b.code)\n\n" +
    "const show_opt(v: Option[int]) -> int = v match\n    Some(x) -> x\n    None -> -1\n\n"

@test("'?' runs while compiling: the success's payload, or the failure handed back, as at run time")
cdz_try_both_ways()
    if !cdz_ready() then return

    cdz_agree(cdz_r + cdz_try +
              "const A = show(add(2, 3))\nconst B = show(add(2, -3))\nconst C = show_opt(opt(5))\n" +
              "const D = show_opt(opt(0))\nconst E = show(in_loop(3))\nconst F = show(in_loop(5))\n\n" +
              "print(A, B, C, D, E, F)\n" +
              "print(show(add(2, 3)), show(add(2, -3)), show_opt(opt(5)), show_opt(opt(0)), " +
              "show(in_loop(3)), show(in_loop(5)))\n", "5 -2 6 -1 6 -2")
end cdz_try_both_ways

@test("a failure widened through a 'const' conversion is converted while compiling")
cdz_try_through_a_conversion()
    if !cdz_ready() then return

    cdz_agree(cdz_r + cdz_try + "const A = show_big(widened(4))\nconst B = show_big(widened(-4))\n\n" +
              "print(A, B)\nprint(show_big(widened(4)), show_big(widened(-4)))\n", "40 -2")
end cdz_try_through_a_conversion

@test("a conversion that is not marked runs too, and one that prints is refused at the declaration")
cdz_try_through_a_plain_conversion()
    if !cdz_ready() then return

    val unmarked = cdz_try.replace_all("    const from(", "    from(")

    cdz_agree(cdz_r + unmarked + "const B = show_big(widened(-4))\n\nprint(B)\nprint(show_big(widened(-4)))\n", "-2")

    val plain = cdz_try.replace_all("    const from(s: string) -> Big = Big(s.len)",
                                    "    from(s: string) -> Big\n        print(s)\n        Big(s.len)")

    cdz_refused(cdz_r + plain + "const A = show_big(widened(4))\n\nprint(A)\n",
                "'widened' is 'const', so it runs while compiling, and it calls 'Big.from', which prints")
end cdz_try_through_a_plain_conversion

// guards: const-decoded table is laid down as data, not built at run time
@test("a table decoded by a generic 'const' function that discards a '?'-built Result is laid down")
cdz_decoded_table_laid_down()
    if !cdz_ready() then return

    cdz_laid_down(cdz_archive("import sysl.encoding.hex_decode\n\n" +
                              "const hex[const N: usize](s: string) -> [N]u8\n    var out: [N]u8 = [0; N]\n" +
                              "    _ = hex_decode(s.bytes, out)\n    out\n\n" +
                              "val ABC = hex[4](\"ba7816bf\")\n\n" +
                              "@export(\"main\")\nmain_entry() -> int = int(ABC[3])\n"),
                  "@ABC = private constant [4 x i8] [i8 186, i8 120, i8 22, i8 191]\n")
end cdz_decoded_table_laid_down

// -- a simple enum and its integers ----------------------------------------------------------------

private val cdz_colour: string =
    "enum Colour\n    Red = 4\n    Green = 9\n    Blue = 2\n\n" +
    "const cast(n: int) -> int = Colour::Pos(Colour(n))\n" +
    "const tried(n: int) -> int = Colour.try(n) match\n    Some(c) -> Colour::Pos(c)\n    None -> -1\n" +
    "const succ(n: int) -> int = Colour::Pos(Colour::Succ(Colour(n)))\n" +
    "const pred(n: int) -> int = Colour::Pos(Colour::Pred(Colour(n)))\n" +
    "const image(n: int) -> string = Colour::Image(Colour(n))\n" +
    "const at(p: int) -> int = int(Colour::Val(p))\n" +
    "const named(s: string) -> int = Colour::Pos(Colour::Value(s))\n\n"

@test("an enum read out of an integer, checked or not, and each attribute, run while compiling")
cdz_enum_both_ways()
    if !cdz_ready() then return

    cdz_agree(cdz_colour +
              "const A = cast(2)\nconst B = tried(9)\nconst C = tried(7)\nconst D = succ(4)\n" +
              "const E = pred(2)\nconst F = at(1)\nconst G = named(\"Blue\")\n\n" +
              "print(A, B, C, D, E, F, G, image(4))\n" +
              "print(cast(2), tried(9), tried(7), succ(4), pred(2), at(1), named(\"Blue\"), image(4))\n",
              "2 1 -1 1 1 9 2 Red")
end cdz_enum_both_ways

// guards: an enum-derived module val name is laid down as constant data
@test("and a name it gives a module 'val' is laid down as data")
cdz_enum_image_laid_down()
    if !cdz_ready() then return

    val out = cdz_archive(cdz_colour + "val NAME = image(9)\n\n" +
                          "@export(\"main\")\nmain_entry() -> int = int(NAME.len)\n")

    if out == "skipped" then return

    assert(out.contains("@NAME = private constant"), out)
    assert(!out.contains("llvm.global_ctors"), out)
end cdz_enum_image_laid_down

@test("every way it has no answer traps while compiling, as the program would")
cdz_enum_traps()
    if !cdz_ready() then return

    cdz_refused(cdz_colour + "const X = cast(7)\n\nprint(X)\n", "no variant of 'Colour' has the value 7")
    cdz_refused(cdz_colour + "const X = succ(2)\n\nprint(X)\n", "there is no variant after 'Blue' in 'Colour'")
    cdz_refused(cdz_colour + "const X = pred(4)\n\nprint(X)\n", "there is no variant before 'Red' in 'Colour'")
    cdz_refused(cdz_colour + "const X = at(3)\n\nprint(X)\n", "'Colour' has no variant at position 3")
    cdz_refused(cdz_colour + "const X = named(\"Pink\")\n\nprint(X)\n", "no variant of 'Colour' is named \"Pink\"")
end cdz_enum_traps
