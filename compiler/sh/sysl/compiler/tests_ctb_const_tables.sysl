module sh.sysl.compiler
@tests

import sh.sysl.parsing.source_of
import sysl.buf.{Buf, buf}
import sysl.text.Search

// **A table a `const` function fills in a loop is constant data**: the evaluator holds a fixed array
// by value, runs the loop, and the module `val` is laid down as the literal the elements make -- so a
// Cortex-M image carries a sine table in `.rodata` with nothing run before `main`. Fixed-point
// arithmetic is run with the run-time rules over exact values, so every element is the one the
// program would compute. Where the function cannot be run -- an `extern`, storage filled at run time,
// more steps than the bound -- a freestanding artifact's refusal of the storage says why.

private ctb_target() -> Target = target_named("thumbv7em-freestanding").unwrap()

private ctb_library() -> Buf[Program]
    var out: Buf[Program] = buf()

    std_root() match
        Err(_) -> ()
        Ok(root) -> std_units(root, ctb_target()) match
            Err(_) -> ()
            Ok(units) -> out = units

    out
end ctb_library

ctb_skip() -> bool
    if ctb_library().is_empty()
        print("skipped: the standard module's source is not on this machine")
        return true
    end if

    false
end ctb_skip

private ctb_first_of(said: Buf[Placed]) -> string
    for item in said
        if !item.src.name.starts_with("library/") then return item.diag.message

    ""
end ctb_first_of

// A freestanding archive for a Cortex-M4, as `build-c` makes one: every error the compilation said,
// one per line, or the LLVM text it lowered to.
ctb_freestanding(text: string) -> string
    val t = ctb_target()
    var units = ctb_library()
    val parsed = parse(source_of("main.sysl", text), t)

    if !parsed.ok() then return parsed.report.at(0).message

    units.push(parsed.program)

    val done = analyze_produced(units, t, buf(), false)
    val early = ctb_first_of(done.reported)

    if early != "" then return early

    val whole = program_of(done, done.main_module) with { entry_point = false, c_artifact = true }
    var own: Buf[string] = buf()

    own.push("")

    val pr = post_analysis_checks(done.an, whole, own)
    val late = ctb_first_of(done.an.diagnostics())

    if late != "" then return late

    ir_print_module(codegen_with_gaps(prune(strip_tests(whole), own), t, pr).0)
end ctb_freestanding

ctb_laid_down(out: string, head: string)
    assert(out.contains(head), out)
    assert(!out.contains("module_init"), out)
    assert(!out.contains("llvm.global_ctors"), out)
end ctb_laid_down

val ctb_refusal: string =
    "'main_entry' is exported and reaches 'T', which is module storage an initializer fills before the " +
    "program's own statements run. This artifact has no entry point to fill it in, and " +
    "'thumbv7em-freestanding' is freestanding — there is no loader to run a constructor either, so the " +
    "function would read whatever the image left. Build for a hosted target, where the storage is " +
    "filled before any export can run, or make the initializer constant data, which is laid straight " +
    "into the object file. "

val ctb_main: string = "\n\n@export(\"main\")\nmain_entry() -> int = "

// A sine by its series, a `const` helper the table calls: `+`, `-`, `*` and `/` are exactly specified,
// so the compiler computes the same bits the board does.
private val ctb_sine: string =
    "const pi: real = 3.141592653589793\n\n" +
    "const sine(x: real) -> real\n" +
    "    var term = x\n    var sum = x\n\n" +
    "    for k in 1..<8\n" +
    "        term = -term * x * x / real((2 * k) * (2 * k + 1))\n" +
    "        sum += term\n\n" +
    "    sum\n\n" +
    "const table() -> [256]q15\n" +
    "    var t: [256]q15 = [q15(0.0); 256]\n\n" +
    "    for i in 0..<256\n" +
    "        t[i] = q15(sine(2.0 * pi * real(i) / 256.0 - pi))\n\n" +
    "    t\n\n"

@test("a sine table a 'const' function fills in a loop is laid down for a Cortex-M4")
ctb_a_sine_table_is_laid_down()
    if ctb_skip() then return

    val out = ctb_freestanding(ctb_sine + "val T: [256]q15 = table()" + ctb_main + "int(T[64].bits)\n")

    ctb_laid_down(out, "@T = private constant [256 x i16] [i16 0, ")
    assert(out.contains(", i16 -32768, "), out)
    assert(out.contains(", i16 32767, "), out)
end ctb_a_sine_table_is_laid_down

@test("an 'f32' table is laid down at its own width")
ctb_an_f32_table()
    if ctb_skip() then return

    ctb_laid_down(ctb_freestanding("const ramp() -> [4]f32\n    var w: [4]f32 = [0.0; 4]\n\n" +
                                   "    for i in 0..<4\n        w[i] = f32(i) / 3.0f32\n\n    w\n\n" +
                                   "val T: [4]f32 = ramp()" + ctb_main + "int(T[1] * 3.0f32)\n"),
                  "@T = private constant [4 x float] [float 0x0000000000000000, float 0x3FD5555560000000, " +
                  "float 0x3FE5555560000000, float 0x3FF0000000000000]")
end ctb_an_f32_table

@test("a nested table, written by element, swapped and walked, is laid down")
ctb_a_nested_table()
    if ctb_skip() then return

    ctb_laid_down(ctb_freestanding("const grid() -> [2][3]int\n" +
                                   "    var g: [2][3]int = [[1, 2, 3], [4, 5, 6]]\n" +
                                   "    val copy = g\n\n" +
                                   "    g[0][1], g[1][2] = g[1][2], g[0][1]\n" +
                                   "    g[1][0] += copy[0][0] * 10\n\n" +
                                   "    for row in copy\n        g[0][0] += row[2]\n\n" +
                                   "    g\n\n" +
                                   "val T: [2][3]int = grid()" + ctb_main + "T[1][0]\n"),
                  "@T = private constant [2 x [3 x i32]] [[3 x i32] [i32 10, i32 6, i32 3], " +
                  "[3 x i32] [i32 14, i32 5, i32 2]]")
end ctb_a_nested_table

@test("the laid-down tables are the values the same calls compute at run time")
ctb_the_values_are_the_run_time_values()
    if !enm_ready() then return

    val prog = ctb_sine +
               "const window() -> [16]f32\n" +
               "    var w: [16]f32 = [0.0; 16]\n\n" +
               "    for i in 0..<16\n" +
               "        val x = f32(i) / 15.0f32\n" +
               "        w[i] = 0.5f32 - 0.5f32 * f32(sine(real(x) * 2.0 * pi - pi)) * x\n\n" +
               "    w\n\n" +
               "const mixed() -> [12]i32\n" +
               "    val a: q15 = 0.7\n    val b: q15 = -0.3\n    val c: q31 = 0.123456789\n" +
               "    var out: [12]i32 = [0; 12]\n" +
               "    out[0] = i32((a + b).bits)\n    out[1] = i32((a * b).bits)\n" +
               "    out[2] = i32((b / a).bits)\n    out[3] = i32((a << 2).bits)\n" +
               "    out[4] = i32((b >> 3).bits)\n    out[5] = i32((-q15::Min).bits)\n" +
               "    out[6] = i32(q15(c).bits)\n    out[7] = int(q15(-0.75) * 3)\n" +
               "    out[8] = i32((a * 5).bits)\n    out[9] = i32((a / 3).bits)\n" +
               "    out[10] = int(f32(b) * 1000.0f32)\n" +
               "    val p: q31 = a * b\n    out[11] = p.bits\n" +
               "    out\n\n" +
               "static val SINE: [256]q15 = table()\n" +
               "static val W: [16]f32 = window()\n" +
               "static val M: [12]i32 = mixed()\n\n" +
               "val live = table()\nvar same = 0\n\n" +
               "for i in 0..<256\n    if live[i].bits == SINE[i].bits then same += 1\n\n" +
               "val lw = window()\nvar wsame = 0\n\n" +
               "for i in 0..<16\n    if lw[i] == W[i] then wsame += 1\n\n" +
               "print(same, wsame, SINE[64].bits, SINE[192].bits)\n" +
               "print(M)\nprint(mixed())\n"

    assert_eq(enm_ran(prog),
              "256 16 -32768 32767\n" +
              "[13108, -6881, -14043, 32767, -1229, 32767, 4045, -1, 32767, 7646, -299, -450961080]\n" +
              "[13108, -6881, -14043, 32767, -1229, 32767, 4045, -1, 32767, 7646, -299, -450961080]\n")
end ctb_the_values_are_the_run_time_values

@test("a table whose loop needs more than the step bound is refused, naming the loop")
ctb_the_step_limit()
    if ctb_skip() then return

    assert_eq(ctb_freestanding("const t() -> [4]int\n    var a: [4]int = [0; 4]\n    var n = 0\n\n" +
                               "    while n < 20000000\n        n += 1\n\n    a[0] = n\n    a\n\n" +
                               "val T: [4]int = t()" + ctb_main + "T[0]\n"),
              ctb_refusal + "'T' did not finish within 16,000,000 steps while compiling — the loop at " +
              "main.sysl:5:5 was still running; '--const-steps <n>' allows a longer run")
end ctb_the_step_limit

@test("an array too large for the steps left is refused, naming its size")
ctb_the_size_limit()
    if ctb_skip() then return

    assert_eq(ctb_freestanding("const t() -> [4]int\n    var big: [20000000]u8 = [0; 20000000]\n" +
                               "    var a: [4]int = [0; 4]\n    a[0] = int(big[3])\n    a\n\n" +
                               "val T: [4]int = t()" + ctb_main + "T[0]\n"),
              ctb_refusal + "'T' did not finish within 16,000,000 steps while compiling — an array of " +
              "20000000 elements at main.sysl:2:29 is past the steps that were left; '--const-steps <n>' allows a " +
              "longer run")
end ctb_the_size_limit

@test("an index past the table traps at the initializer")
ctb_an_index_past_the_end_traps()
    if ctb_skip() then return

    assert_eq(ctb_freestanding("const t() -> [4]int\n    var a: [4]int = [0; 4]\n\n" +
                               "    for i in 0..<5\n        a[i] = i\n\n    a\n\n" +
                               "val T: [4]int = t()" + ctb_main + "T[0]\n"),
              "'T' traps while it is being compiled: index 4 is out of bounds for an array of 4 elements " +
              "(main.sysl:5:11) — inside 't()', called at main.sysl:9:17")
end ctb_an_index_past_the_end_traps

@test("a table over an 'extern' is still storage, and the refusal says which call stopped it")
ctb_an_extern_is_refused()
    if ctb_skip() then return

    val said = ctb_freestanding("extern \"sinf\" c_sin(x: f32) -> f32\n\n" +
                                "const t() -> [4]f32\n    var a: [4]f32 = [0.0; 4]\n\n" +
                                "    for i in 0..<4\n        a[i] = c_sin(f32(i))\n\n    a\n\n" +
                                "val T: [4]f32 = t()" + ctb_main + "int(T[0])\n")

    assert(said.contains("it calls 'c_sin', which is the C library's 'sinf' — its last bit differs " +
                         "between C libraries"), said)
end ctb_an_extern_is_refused

@test("a table over a 'var' is still storage, and the refusal says which read stopped it")
ctb_a_var_is_refused()
    if ctb_skip() then return

    assert_eq(ctb_freestanding("const t(k: int) -> [4]int\n    var a: [4]int = [0; 4]\n\n" +
                               "    for i in 0..<4\n        a[i] = i * k\n\n    a\n\n" +
                               "var gain: int = 3\n\nval T: [4]int = t(gain)" + ctb_main + "T[0]\n"),
              ctb_refusal + "'T' cannot be computed while compiling: 'gain' is filled when the program " +
              "runs (main.sysl:11:19)")
end ctb_a_var_is_refused
