module sysl.posix.threads
@requires(posix, libc)
@tests

// The older name reaches the same API: what `sysl.threads`'s own tests check of each piece is not
// repeated, only that every name here is one there.

private struct Count
    m: Mutex[int]

private bump(c: *Count) -> unit = c.m.with((n) -> *n += 1)

@test("the names under sysl.posix.threads are sysl.threads's")
the_old_name_reaches_the_new_module() -> unit
    var c = Count(Mutex.new(0))
    var t: Thread = spawn(&bump, &c).unwrap()

    assert(t.join())
    assert_eq(c.m.with((n) -> *n), 1)

    var slots: [2]int = [0; 2]
    var ch: Channel[int] = channel(slots[..])

    assert(ch.try_send(3))
    assert(ch.try_receive() == Some(3))
    assert(yield_now())
    assert(current().id != 0)

    var l: Lock = Lock.new()
    var cv: Condvar = Condvar.new()

    assert(l.try_lock())
    l.unlock()
    cv.notify_all()
