// p06c: the free-function form the trait default would fall back to: a bound on the associated type
// in the parameter's own bound, and a default that hands itself to it.
trait It
    type Item
    next(*self) -> Option[Self::Item]

max_of[I: It[Item: Ord]](it: I) -> Option[I::Item]
    var cur = it
    var best: Option[I::Item] = None
    loop
        cur.next() match
            Some(x) -> best = best match
                Some(b) -> if b < x then Some(x) else Some(b)
                None -> Some(x)
            None -> break
    best
end max_of

struct Count
    n: int
    stop: int

impl It for Count
    type Item = int
    next(*self) -> Option[int]
        if self.n >= self.stop then return None
        val v = self.n
        self.n += 1
        Some(v)

main()
    print(max_of(Count(0, 4)).unwrap())
