module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.{capture, Status}

// **`sysl.container.ring.InlineRing[T, N]` builds for a bare Thumb machine**: it is allocation-free
// (`@no_alloc`), its storage is an `[N]T` inside the value, and a struct holding one needs no heap and
// no runtime. The behaviour is `library/sysl/container/ring/inline_tests.sysl`; this file is the
// target axis, for a power-of-two and a non-power-of-two capacity, one slot, a struct field, and the
// walk and subscript traits.

private irg_ready() -> bool = std_root().is_ok() && clang_available()

private irg_build_c(text: string, target: string) -> (int, string)
    val root = make_temp_dir("sysl-irg-c").unwrap()

    write_text(s"$root/package.hocon", "package {\n  name = \"probe\"\n}\n").unwrap()
    write_text(s"$root/main.sysl", forms_imported(text)).unwrap()

    var said: Buf[string] = buf()
    val sink = &said
    var args: [7]string = ["sysl", "build-c", "--target", target, "-o", s"$root/probe.a", root]
    val code = run_cli(args[..], piece -> sink.push(piece))

    reset_search_paths()
    remove_dir_all(root).unwrap_or(())

    var text_out = ""

    for piece in said
        text_out = text_out + piece

    (code, text_out)
end irg_build_c

@test("an inline ring held in a struct builds for a bare Thumb machine, at a power of two, an odd size and one slot")
irg_builds_on_thumb()
    if !irg_ready() then return

    val (code, said) = irg_build_c(raw"""
        import sysl.container.ring.{InlineRing, inline_ring}

        struct Dev
            rx: InlineRing[u8, 16]
            tx: InlineRing[u32, 5]
            one: InlineRing[u8, 1]

        var dev: Dev

        @export("main")
        probe() -> u32
            dev.rx.push_back(1)
            dev.tx.push_front(2)
            dev.one.overwrite(3)

            var local = inline_ring[u16, 3]()

            local.overwrite(4)

            var sum = u32(local[0])

            for x in dev.tx do sum += x

            sum + u32(dev.rx[0]) + u32(dev.rx.pop_front().unwrap_or(0)) + u32(dev.one.len())
        """, "thumb-freestanding-softfp")

    assert(!said.contains("error"), said)
    assert_eq(code, 0)
end irg_builds_on_thumb

// -- the trap -----------------------------------------------------------------------------------------
//
// An index past the count stops the program as `Ring`'s does (`tests_ctr_container_trap.sysl`): the
// report goes through `sysl_bounds_fail` and the program traps with SIGTRAP, at -O0 and at the default
// level.

private irg_run(files: []const (string, string), level: string) -> (Status, string, string)
    val root = make_temp_dir("sysl-irg").unwrap()

    for i in 0..<files.len
        val at = s"$root/${files[i].0}"

        make_dir_all(parent_of(at).unwrap()).unwrap()
        write_text(at, files[i].1).unwrap()

    val exe = s"$root/built"

    build_native_program(root, None, None, level, Some(exe)) match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return (Status.Exited(-1), "", failure_text(why))
        Ok(_) -> ()

    val said = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    said match
        Err(_) -> (Status.Exited(-1), "", "the program that was built could not be run")
        Ok(out) -> (out.status, out.text, out.err.unwrap_or(""))
end irg_run

// A ring of four slots, wrapped so its run does not start at slot zero, holding 10, 20, 30.
private val IrgRing: string =
    "import sysl.container.ring.{InlineRing, inline_ring}\n\nvar r = inline_ring[int, 4]()\n" +
    "r.push_back(0)\nr.push_back(0)\nr.pop_front()\nr.pop_front()\nr.push_back(10)\nr.push_back(20)\n" +
    "r.push_back(30)\nval i: usize = 5\n"

private irg_traps(files: []const (string, string), printed: string, said: string)
    if !irg_ready() then return

    for level in ["0", DefaultOptimization]
        val (state, out, err) = irg_run(files, level)

        assert_eq(err, said)
        assert_eq(out, printed)
        assert(state == Status.Signalled(5), s"-O$level stopped with $state, having printed '$out'")
end irg_traps

private irg_main(body: string, printed: string, said: string)
    var files: [1](string, string) = [("main.sysl", body)]

    irg_traps(files[..], printed, said)
end irg_main

@test("a wrapped InlineRing's subscript, at and set past the count trap with an array's report")
irg_index_past()
    irg_main(IrgRing + "print(r[2])\nprint(r[i])\n", "30\n", "index 5 out of bounds for length 3\n")
    irg_main(IrgRing + "r[0] = 1\nprint(r[0])\nr[3] = 1\n", "1\n", "index 3 out of bounds for length 3\n")
    irg_main(IrgRing + "print(r.at(i))\n", "", "index 5 out of bounds for length 3\n")
    irg_main(IrgRing + "r.set(i, 1)\n", "", "index 5 out of bounds for length 3\n")
end irg_index_past

@test("an empty InlineRing traps on index zero, and one in a struct field traps the same")
irg_index_past_empty()
    irg_main("import sysl.container.ring.{InlineRing, inline_ring}\n\nvar r = inline_ring[int, 2]()\nprint(r[0])\n",
             "", "index 0 out of bounds for length 0\n")
    irg_main("import sysl.container.ring.InlineRing\n\nstruct H\n    q: InlineRing[int, 3]\n\nvar h: H\n" +
             "h.q.push_back(1)\nprint(h.q[0])\nprint(h.q[1])\n", "1\n", "index 1 out of bounds for length 1\n")
end irg_index_past_empty

private val IrgReport: string =
    "module report\n\n@export(\"sysl_bounds_fail\")\n" +
    "on_bounds(kind: u32, a: usize, b: usize, n: usize, at: *u8)\n" +
    "    val place = if usize(at) == 0 then \"-\" else \"located\"\n\n" +
    "    eprints(s\"override $kind $a $b $n $place\\n\")\n"

@test("an exported sysl_bounds_fail is handed an InlineRing's failure, with no location, and the trap follows")
irg_override()
    var files: [2](string, string) = [("main.sysl", "import report\n" + IrgRing + "print(r.at(i))\n"),
                                      ("report/report.sysl", IrgReport)]

    irg_traps(files[..], "", "override 0 5 0 3 -\n")
end irg_override
