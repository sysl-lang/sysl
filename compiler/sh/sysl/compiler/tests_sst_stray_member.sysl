module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.fs.{make_temp_dir, remove_dir_all, write_text}
import sysl.text.{repeat}

// A line under a type's body that no member can begin with is where the body ENDED, so what is
// missing is the dedent that closes it: `dedent expected`, at the stray token. Every message and
// location here is the reference's own output (sysl 0.0.150) for the same file, with the scratch
// directory put back in for its path.
//
// **The caret is as wide as the token under it** -- `^^^^^^` under `123456`, `^^^^` under `"hi"` --
// which is how the reference draws every parse diagnostic; `width` is that token's length.

private sst_ready() -> bool = std_root().is_ok()

// What `sysl build <dir>` says about a project holding one `main.sysl`, and the directory.
private sst_run(text: string) -> (string, string, int)
    val root = make_temp_dir("sysl-sst").unwrap()

    write_text(s"$root/main.sysl", text).unwrap()

    var lines: Buf[string] = buf()
    val sink = &lines
    val code = run_cli(["sysl", "build", root], (line) -> sink.push(line))
    val out = if lines.is_empty() then "" else lines.at(0)

    remove_dir_all(root).unwrap_or(())
    (out, absolute_path(root), code)

// `quoted` is the line the diagnostic quotes; the caret stands under column `col`, `width` wide.
private sst_expect(text: string, message: string, line: int, col: int, quoted: string,
                   width: int = 1)
    val (out, root, code) = sst_run(text)
    val pad = repeat(" ", usize(col - 1))
    val carets = repeat("^", usize(width))

    assert_eq(code, 1)
    assert_eq(out, s"error: $message\n --> $root/main.sysl:$line:$col\n  |\n$line | $quoted\n  | $pad$carets")

private sst_dedent(text: string, line: int, col: int, quoted: string, width: int = 1) =
    sst_expect(text, "dedent expected", line, col, quoted, width)

// -- a struct's body ----------------------------------------------------------------------------

@test("a stray number under a struct's fields is 'dedent expected' at the number")
sst_struct_number()
    if !sst_ready() then return

    sst_dedent("struct P\n    x: int\n    123456\n", 3, 5, "    123456", 6)

@test("a stray string under a struct's fields is 'dedent expected' at the string")
sst_struct_string()
    if !sst_ready() then return

    sst_dedent("struct P\n    x: int\n    \"hi\"\n", 3, 5, "    \"hi\"", 4)

@test("a stray operator under a struct's fields is 'dedent expected' at the operator")
sst_struct_operator()
    if !sst_ready() then return

    sst_dedent("struct P\n    x: int\n    +\n", 3, 5, "    +")

@test("a statement word under a struct's fields is 'dedent expected' at the word")
sst_struct_keyword()
    if !sst_ready() then return

    sst_dedent("struct P\n    x: int\n    return\n", 3, 5, "    return", 6)
    sst_dedent("struct P\n    x: int\n    if\n", 3, 5, "    if", 2)
    sst_dedent("struct P\n    x: int\n    true\n", 3, 5, "    true", 4)

@test("'type' begins nothing in a struct's body, so it ends the body there")
sst_struct_type_word()
    if !sst_ready() then return

    sst_dedent("struct P\n    x: int\n    type\n", 3, 5, "    type", 4)

@test("an opening bracket under a struct's fields is 'dedent expected' at the bracket")
sst_struct_bracket()
    if !sst_ready() then return

    sst_dedent("struct P\n    x: int\n    (1)\n", 3, 5, "    (1)")
    sst_dedent("struct P\n    x: int\n    [1]\n", 3, 5, "    [1]")

@test("a stray line after a method's own block is 'dedent expected' at the stray line")
sst_struct_after_method()
    if !sst_ready() then return

    sst_dedent("struct P\n    x: int\n    f(self) -> int\n        val y = 1\n        y\n    123456\n",
               6, 5, "    123456", 6)
    sst_dedent("struct P\n    x: int\n    f(self) -> int = 1\n    123456\n", 4, 5, "    123456", 6)

@test("a struct written inside a struct's body ends the body at its 'struct'")
sst_struct_nested_struct()
    if !sst_ready() then return

    sst_dedent("struct P\n    x: int\n    struct Q\n        y: int\n        123456\n", 3, 5,
               "    struct Q", 6)

// The first line of a body is read as a member whatever it is, a body holding at least one, so
// there the refusal is about the name it lacks.
@test("a stray line as a body's FIRST line is still 'identifier expected'")
sst_first_line_wants_a_name()
    if !sst_ready() then return

    sst_expect("struct P\n    123456\n", "identifier expected", 2, 5, "    123456", 6)
    sst_expect("enum E\n    123456\n", "identifier expected", 2, 5, "    123456", 6)
    sst_expect("trait T\n    123456\n", "identifier expected", 2, 5, "    123456", 6)

// A reserved word followed by a `:` is a field misnamed, not a stray line.
@test("a reserved word written as a later field's name is refused in the field rule's words")
sst_reserved_field_name()
    if !sst_ready() then return

    sst_expect("struct P\n    x: int\n    return: int\nmain() -> unit\n    print(1)\n",
               "'return' is a reserved word, so it cannot stand as a parameter's name or a field's — write it '`return`' if that is the name you want, which is what the backticks are for: a quoted word is an ordinary name wherever one may be written",
               3, 5, "    return: int", 6)

@test("a later line beginning with 'static' or 'private' is still read as a member")
sst_later_modifier_is_a_member()
    if !sst_ready() then return

    sst_expect("struct P\n    x: int\n    static 5\n", "identifier expected", 3, 12, "    static 5")
    sst_expect("struct P\n    x: int\n    private 5\n", "identifier expected", 3, 13,
               "    private 5")

// -- an enum's body -----------------------------------------------------------------------------

@test("a stray number, string, operator or statement word under an enum's variants")
sst_enum_strays()
    if !sst_ready() then return

    sst_dedent("enum E\n    A\n    123456\n", 3, 5, "    123456", 6)
    sst_dedent("enum E\n    A\n    \"hi\"\n", 3, 5, "    \"hi\"", 4)
    sst_dedent("enum E\n    A\n    +\n", 3, 5, "    +")
    sst_dedent("enum E\n    A\n    return\n", 3, 5, "    return", 6)
    sst_dedent("enum E\n    A\n    if\n", 3, 5, "    if", 2)

@test("a stray operator after a variant carrying a payload")
sst_enum_after_payload()
    if !sst_ready() then return

    sst_dedent("enum E\n    A(x: int)\n    +\n", 3, 5, "    +")

// -- a trait's body -----------------------------------------------------------------------------

@test("a stray number, string, operator or statement word under a trait's members")
sst_trait_strays()
    if !sst_ready() then return

    sst_dedent("trait T\n    f(self) -> int\n    123456\n", 3, 5, "    123456", 6)
    sst_dedent("trait T\n    f(self) -> int\n    \"hi\"\n", 3, 5, "    \"hi\"", 4)
    sst_dedent("trait T\n    f(self) -> int\n    +\n", 3, 5, "    +")
    sst_dedent("trait T\n    f(self) -> int\n    return\n", 3, 5, "    return", 6)

@test("'type' in a trait's body begins an associated type, and is read as one")
sst_trait_type_is_a_member()
    if !sst_ready() then return

    sst_expect("trait T\n    f(self) -> int\n    type 5\n", "identifier expected", 3, 10, "    type 5")

// -- an impl block's body -----------------------------------------------------------------------

private sst_impl(stray: string) -> string =
    s"trait T\n    f(self) -> int\nstruct P\n    x: int\nimpl T for P\n    f(self) -> int = 1\n    $stray\n"

@test("a stray number, string, operator or statement word under an impl block's members")
sst_impl_strays()
    if !sst_ready() then return

    sst_dedent(sst_impl("123456"), 7, 5, "    123456", 6)
    sst_dedent(sst_impl("\"hi\""), 7, 5, "    \"hi\"", 4)
    sst_dedent(sst_impl("+"), 7, 5, "    +")
    sst_dedent(sst_impl("return"), 7, 5, "    return", 6)

// -- a type declared inside a block -------------------------------------------------------------

@test("a stray line under a struct or an enum declared inside a function's body")
sst_nested_block()
    if !sst_ready() then return

    sst_dedent("f() -> int\n    struct P\n        x: int\n        123456\n    1\n", 4, 9,
               "        123456", 6)
    sst_dedent("f() -> int\n    enum E\n        A\n        \"hi\"\n    1\n", 4, 9, "        \"hi\"", 4)

// -- a name followed by something no member continues with ---------------------------------------
//
// A name that begins a member line and is followed by neither a field's `:` nor a method's `(`,
// `[` or a property's `->` is read as the member the body holds most of: under a type's body a
// field missing its `:`, under a trait's or an `impl` block's a property missing its `->`. Every
// message, position and caret is the reference's (sysl 0.0.150).

@test("a name followed by a value under a struct's fields is a field missing its ':'")
sst_struct_name_missing_colon()
    if !sst_ready() then return

    sst_expect("struct P\n    x: int\n    y 5\n\nprint(1)\n", "':' expected", 3, 7, "    y 5")
    sst_expect("struct P\n    x: int\n    y \"s\"\n\nprint(1)\n", "':' expected", 3, 7, "    y \"s\"", 3)
    sst_expect("struct P\n    x: int\n    y int\n\nprint(1)\n", "':' expected", 3, 7, "    y int", 3)
    sst_expect("struct P\n    x: int\n    y = 3\n\nprint(1)\n", "':' expected", 3, 7, "    y = 3")

@test("the first line of a struct's body is read the same way")
sst_struct_first_name_missing_colon()
    if !sst_ready() then return

    sst_expect("struct P\n    y 5\n    x: int\n\nprint(1)\n", "':' expected", 2, 7, "    y 5")
    sst_expect("struct P\n    y int\n\nprint(1)\n", "':' expected", 2, 7, "    y int", 3)

@test("a name after a method in a struct's body is still a field missing its ':'")
sst_struct_after_method_missing_colon()
    if !sst_ready() then return

    sst_expect("struct P\n    x: int\n    f(self) -> int = 1\n    y 5\n\nprint(1)\n", "':' expected", 4,
               7, "    y 5")

@test("a name followed by a value in a trait's body is a property missing its '->'")
sst_trait_name_missing_arrow()
    if !sst_ready() then return

    val head = "trait T\n    f(self) -> int\n"

    sst_expect(s"${head}    y 5\n\nprint(1)\n", "'->' expected", 3, 7, "    y 5")
    sst_expect(s"${head}    y \"s\"\n\nprint(1)\n", "'->' expected", 3, 7, "    y \"s\"", 3)
    sst_expect(s"${head}    y int\n\nprint(1)\n", "'->' expected", 3, 7, "    y int", 3)
    sst_expect(s"${head}    y = 3\n\nprint(1)\n", "'->' expected", 3, 7, "    y = 3")
    sst_expect("trait T\n    y 5\n\nprint(1)\n", "'->' expected", 2, 7, "    y 5")

@test("a name followed by a value in an impl block's body is a property missing its '->'")
sst_impl_name_missing_arrow()
    if !sst_ready() then return

    val head = "trait T\n    f(self) -> int\nstruct P\n    x: int\nimpl T for P\n"

    sst_expect(s"${head}    f(self) -> int = 1\n    y 5\n\nprint(1)\n", "'->' expected", 7, 7, "    y 5")
    sst_expect(s"${head}    f(self) -> int = 1\n    y \"s\"\n\nprint(1)\n", "'->' expected", 7, 7,
               "    y \"s\"", 3)
    sst_expect(s"${head}    f(self) -> int = 1\n    y int\n\nprint(1)\n", "'->' expected", 7, 7,
               "    y int", 3)
    sst_expect(s"${head}    f(self) -> int = 1\n    y = 3\n\nprint(1)\n", "'->' expected", 7, 7,
               "    y = 3")
    sst_expect(s"${head}    y 5\n\nprint(1)\n", "'->' expected", 6, 7, "    y 5")

@test("a variant followed by a value is where an enum's body ended")
sst_enum_variant_then_value()
    if !sst_ready() then return

    sst_dedent("enum E\n    A\n    B 5\n\nprint(1)\n", 3, 7, "    B 5")
    sst_dedent("enum E\n    A\n    B x\n\nprint(1)\n", 3, 7, "    B x")
    sst_dedent("enum E\n    A\n    B \"s\"\n\nprint(1)\n", 3, 7, "    B \"s\"", 3)
    sst_dedent("enum E\n    B 5\n    A\n\nprint(1)\n", 2, 7, "    B 5")
    sst_dedent("enum E\n    B x\n\nprint(1)\n", 2, 7, "    B x")

@test("anything after a variant's payload or its value is where an enum's body ended")
sst_enum_after_variant_tail()
    if !sst_ready() then return

    sst_dedent("enum E\n    A\n    B(x: int) 5\n\nprint(1)\n", 3, 15, "    B(x: int) 5")
    sst_dedent("enum E\n    A\n    B = 1 x\n\nprint(1)\n", 3, 11, "    B = 1 x")

@test("a variant's bracket holding no field is owed its ')'")
sst_enum_variant_open_bracket()
    if !sst_ready() then return

    sst_expect("enum E\n    A\n    B(5\n\nprint(1)\n", "')' expected", 3, 7, "    B(5")
    sst_expect("enum E\n    B(5\n\nprint(1)\n", "')' expected", 2, 7, "    B(5")

@test("a variant with a written value is an enum's ordinary variant")
sst_enum_variant_value_compiles()
    if !sst_ready() then return

    val (_, _, code) = sst_run("enum E\n    A\n    B = 1\n\nprint(1)\n")

    assert_eq(code, 0)
