module sh.sysl.compiler
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.env.{get as env_var}
import sysl.fs.{make_temp_dir, metadata, read_text, remove_file, walk, write_text}
import sysl.process.capture
import sysl.text.{split, str_builder, Search}

// The differential proof: this parser's tree against the reference compiler's, on the same input.
//
// **A suite of shapes says the parser does what somebody thought to ask for. This says the two
// parsers agree.** Both compilers answer `emit-ast --no-spans <file>` with the same deterministic
// rendering of the untyped tree, so a disagreement anywhere in a file is a line of `diff` naming
// the node -- and the corpora below are every `.sysl` file on the machine plus every `sysl` block
// the reference pages show, which between them exercise constructs no hand-written test covers.
//
// **The oracle is a binary this repository does not carry**, since it is thirty megabytes and is
// built out of the other compiler's tree. `SYSL_ORACLE` names it; with the variable unset every
// test here returns at once and says so, which is what keeps `sysl test .` green on a machine that
// has no such binary. The project's own file says how to build one.

// Where the reference compiler is, or nothing where this machine has no copy of it.
private oracle() -> Option[string] = env_var("SYSL_ORACLE")

// Where a sweep leaves the line it counted, for a reader who wants the numbers rather than a pass.
//
// **The test runner shows what a test says only when it fails**, so a sweep that agrees prints its
// counts into a report nobody sees. `SYSL_ORACLE_SUMMARY` names a file to append them to; with the
// variable unset nothing is written, which is what keeps a run that only wants a verdict silent.
private record_summary(line: string)
    val where = env_var("SYSL_ORACLE_SUMMARY")

    if where.is_none() then return

    val held = read_text(where.unwrap()).unwrap_or("")

    write_text(where.unwrap(), s"$held$line\n").unwrap_or(())
end record_summary

private present(path: string) -> bool = metadata(path).is_ok()

private is_sysl_source(path: string) -> bool = path.ends_with(".sysl") || path.ends_with(".lsysl")

// The trailing newline `say` adds to what it is given, taken off both sides before they are
// compared: the tree's own last line ends in one either way.
private without_trailing_newlines(text: string) -> string
    var end = text.len

    while end > 0 && text.bytes[end - 1] == u8('\n')
        end -= 1

    text[0..<end]
end without_trailing_newlines

// What the reference compiler printed for one file, and whether it was willing to parse it at all.
struct Answer
    ok: bool
    text: string
    message: string
end Answer

// The reference compiler's answer for one file.
private ask_oracle(binary: string, path: string) -> Answer
    capture(binary, ["emit-ast", "--no-spans", path], "", [], true) match
        Err(_) -> Answer(false, "", "the oracle could not be run")
        Ok(answer) ->
            Answer(answer.status.ok(), without_trailing_newlines(answer.text),
                   first_error(answer.err.unwrap_or("")))
end ask_oracle

// The one message out of a refusal the reference compiler wrote, without the frame around it.
private first_error(text: string) -> string
    for line in split(text, "\n")
        if line.starts_with("error: ") then return line[7..]

    ""
end first_error

// This compiler's answer for the same file, computed in process.
private ask_ourselves(path: string, text: string) -> Answer
    val parsed = parse(source_of(path, text))

    if !parsed.ok() then return Answer(false, "", parsed.first().message)

    Answer(true, without_trailing_newlines(emit_ast(parsed.program, false)), "")
end ask_ourselves

// The first line at which two renderings of a tree part company, quoted from both.
private first_difference(theirs: string, ours: string) -> string
    val a = split(theirs, "\n")
    val b = split(ours, "\n")
    var i: usize = 0

    while i < a.len && i < b.len
        if a[i] != b[i] then return s"line ${i + 1}: reference [${a[i]}] ours [${b[i]}]"

        i += 1

    if a.len != b.len then return s"the trees are ${a.len} and ${b.len} lines long"

    ""
end first_difference

// -- every file of the three corpora ---------------------------------------------------------

// What a sweep found: how many files it compared, and the first file the two disagreed about.
struct Agreement
    files: usize
    mismatches: usize
    first_bad: string
end Agreement

private sweep_against(binary: string, root: string, found: *Agreement)
    for item in walk(root)
        item match
            Err(_) -> ()
            Ok(entry) ->
                if is_sysl_source(entry.path)
                    read_text(entry.path) match
                        Err(_) -> ()
                        Ok(text) -> compare_one(binary, entry.path, entry.path, text, found)
end sweep_against

private compare_one(binary: string, path: string, label: string, text: string,
                    found: *Agreement)
    val ours = ask_ourselves(path, text)
    val theirs = ask_oracle(binary, path)

    found.files += 1

    if ours.ok != theirs.ok
        found.mismatches += 1

        if found.first_bad == ""
            found.first_bad = s"${label}: the reference compiler ${if theirs.ok then "read" else "refused"} it and this one ${if ours.ok then "read" else "refused"} it"

        return
    end if

    if !ours.ok
        if ours.message != theirs.message
            found.mismatches += 1

            if found.first_bad == ""
                found.first_bad = s"${label}: the reference compiler said [${theirs.message}] and this one said [${ours.message}]"

        return
    end if

    val where = first_difference(theirs.text, ours.text)

    if where != ""
        found.mismatches += 1

        if found.first_bad == "" then found.first_bad = s"${label}: ${where}"
end compare_one

@test("the two compilers build the same tree for every sysl file on this machine")
the_trees_agree_over_every_corpus()
    oracle() match
        None ->
            print("skipped: SYSL_ORACLE names no reference compiler on this machine")
            return
        Some(binary) ->
            var found = Agreement(0, 0, "")

            sweep_against(binary, "sh", &found)

            for root in ["../sysl-bootstrap/library", "../parsing"]
                if present(root) then sweep_against(binary, root, &found)

            assert(found.files >= 30, s"the walk found the corpora: ${found.files} files")
            assert_eq(found.first_bad, "")
            assert_eq(found.mismatches, 0)
end the_trees_agree_over_every_corpus

// -- every block the reference pages show ------------------------------------------------------

// Every ```sysl block of a page, in order.
//
// **The blocks that carry a setting after the fence are left out**, since `target=` picks a machine
// other than this one and what is being compared here is one reading of one input rather than the
// conditional-compilation pass.
private sysl_blocks(page: string) -> Buf[string]
    var out: Buf[string] = buf()
    var held = str_builder()
    var inside = false

    for line in split(page, "\n")
        if inside
            if line == "```"
                out.push(held.finish())

                held = str_builder()
                inside = false
            else
                held.push(line)
                held.push_char('\n')
        else if line == "```sysl"
            inside = true

    out
end sysl_blocks

@test("and on every sysl block the reference pages show, accepted and refused alike")
the_two_agree_on_the_reference_pages()
    val root = "../sysl.sh/docs/content/reference"

    oracle() match
        None ->
            print("skipped: SYSL_ORACLE names no reference compiler on this machine")
            return
        Some(binary) ->
            if !present(root)
                print("skipped: the reference pages are not on this machine")
                return
            end if

            val dir = make_temp_dir("sysl-oracle").unwrap()
            val scratch = dir + "/block.sysl"

            var found = Agreement(0, 0, "")

            for item in walk(root)
                item match
                    Err(_) -> ()
                    Ok(entry) ->
                        if entry.path.ends_with(".md")
                            read_text(entry.path) match
                                Err(_) -> ()
                                Ok(page) ->
                                    val blocks = sysl_blocks(page)

                                    for i in 0..<blocks.len()
                                        write_text(scratch, blocks.at(i)).unwrap()
                                        compare_one(binary, scratch,
                                            s"${entry.path} block ${i + 1}", blocks.at(i), &found)

            remove_file(scratch)

            assert(found.files >= 500, s"the pages showed the blocks: ${found.files} of them")
            assert_eq(found.first_bad, "")
            assert_eq(found.mismatches, 0)
end the_two_agree_on_the_reference_pages

// -- the typed tree, one single-expression body at a time ------------------------------------------

// **`emit-typed` takes a file that stands on its own**, since a module is a directory and a module
// file cannot be handed to it -- so the corpus for the typed diff is the reference pages' blocks
// and the root-level programs, which is exactly what those are.
//
// **A function is compared only where this compiler produced one with nothing to say about it.**
// The block is analyzed on its own, without the standard module, because reading two hundred
// library files again for every block would cost more than the whole proof is worth; so a body that
// names anything the library declares is *skipped* rather than compared, and counted by reason.
// What is left is every function whose body is one expression over its own parameters, its own
// file's declarations, and the language -- which is the whole of what this stage builds.

// What a typed sweep found.
struct TypedAgreement
    matched: usize
    mismatched: usize
    skipped_generic: usize
    skipped_unresolved: usize
    skipped_absent: usize
    skipped_defaults: usize
    first_bad: string

    // The first few blocks this compiler had something to say about, with what it said. A block it
    // complains about is skipped rather than compared -- which is the safe direction for a proof and
    // the blind one for whoever has to make the count go down, so the reasons are carried out.
    first_unresolved: string
end TypedAgreement

// The reference compiler's typed tree for one file, or nothing where it would not analyze it.
private ask_oracle_typed(binary: string, path: string) -> Option[string]
    capture(binary, ["emit-typed", "--no-spans", path], "", [], true) match
        Err(_) -> None
        Ok(answer) -> if answer.status.ok() then Some(answer.text) else None
end ask_oracle_typed

// The `funcs:` section of one such answer, split into the block each function printed, by name.
private printed_funcs(text: string) -> Buf[(string, string)]
    var out: Buf[(string, string)] = buf()
    var held = str_builder()
    var name = ""
    var inside = false
    var open = false

    for line in split(text, "\n")
        if !inside
            if line == "  funcs: " || line == "  funcs:" then inside = true
        else if line == "    - TFunc"
            if open then out.push((name, held.finish()))

            held = str_builder()
            name = ""
            open = true

            held.push(line)
            held.push_char('\n')
        else if starts_with_spaces(line, 4) && open
            held.push(line)
            held.push_char('\n')

            if name == "" && line.starts_with("        name: \"") then
                name = line[15..<line.bytes.len - 1]
        else
            if open then out.push((name, held.finish()))

            open = false
            inside = false

    if open then out.push((name, held.finish()))

    out
end printed_funcs

private starts_with_spaces(line: string, n: usize) -> bool
    if line.bytes.len < n then return false

    for i in 0..<n
        if line.bytes[i] != u8(' ') then return false

    true
end starts_with_spaces

// One file compared, function by function.
private compare_typed(binary: string, path: string, label: string, text: string,
                      found: *TypedAgreement)
    val parsed = parse(source_of(path, text))

    if !parsed.ok() then return

    var units: Buf[Program] = buf()

    units.push(parsed.program)
    write_text("/tmp/d6probe.txt", s"$label\n---\n$text").unwrap()

    val ours = analyze_bodies(units, host_target())

    found.skipped_generic += ours.skipped_generic
    found.skipped_defaults += ours.skipped_defaults

    if ours.funcs.is_empty() then return

    // A file this compiler had anything to say about is not evidence either way, so it is counted
    // and left alone -- and asked about before the reference is run, since running it is the whole
    // cost of the sweep.
    if !ours.reported.is_empty()
        found.skipped_unresolved += ours.funcs.len()

        if found.skipped_unresolved <= 40 then
            found.first_unresolved = s"${found.first_unresolved}\n$label: " +
                                     ours.reported.at(0).diag.message

        return
    end if

    val theirs = ask_oracle_typed(binary, path)

    if theirs.is_none()
        found.skipped_absent += ours.funcs.len()

        return
    end if

    val printed = printed_funcs(theirs.unwrap())

    for i in 0..<ours.funcs.len()
        val f = ours.funcs.at(i)

        // A body this compiler could not finish is not evidence either way, so it is counted and
        // left alone: the stage that fills in the seam is what will compare it.
        if said_anything_about(ours.reported, f.name)
            found.skipped_unresolved += 1
        else
            val block = block_named(printed, f.name)

            if block.is_none()
                found.skipped_absent += 1
            else
                val mine = show_typed_func(f)
                val where = first_difference(without_trailing_newlines(block.unwrap()),
                                             without_trailing_newlines(mine))

                if where == ""
                    found.matched += 1
                else
                    found.mismatched += 1

                    if found.mismatched <= 12 then
                        found.first_bad = s"${found.first_bad}\n$label ${f.name}: $where"
end compare_typed

private block_named(printed: Buf[(string, string)], name: string) -> Option[string]
    for i in 0..<printed.len()
        if printed.at(i).0 == name then return Some(printed.at(i).1)

    None
end block_named

// Whether the analyzer had anything to say about a body -- asked of the whole file, since a
// diagnostic carries a place rather than a function.
//
// **It is deliberately coarse**: one complaint anywhere in a file takes every function of it out of
// the comparison. That errs towards skipping, which is the safe direction for a proof.
private said_anything_about(reported: Buf[Placed], name: string) -> bool = !reported.is_empty()

@test("the two analyzers build the same typed tree for every body they both read")
the_typed_trees_agree()
    oracle() match
        None ->
            print("skipped: SYSL_ORACLE names no reference compiler on this machine")
            return
        Some(binary) ->
            val root = "../sysl.sh/docs/content/reference"

            if !present(root)
                print("skipped: the reference pages are not on this machine")
                return
            end if

            val dir = make_temp_dir("sysl-typed").unwrap()
            val scratch = dir + "/block.sysl"

            var found = TypedAgreement(0, 0, 0, 0, 0, 0, "", "")

            for item in walk(root)
                item match
                    Err(_) -> ()
                    Ok(entry) ->
                        if entry.path.ends_with(".md")
                            read_text(entry.path) match
                                Err(_) -> ()
                                Ok(page) ->
                                    val blocks = sysl_blocks(page)

                                    for i in 0..<blocks.len()
                                        write_text(scratch, blocks.at(i)).unwrap()
                                        compare_typed(binary, scratch,
                                            s"${entry.path} block ${i + 1}", blocks.at(i), &found)

            remove_file(scratch)

            val summary = s"typed bodies: ${found.matched} matched, " +
                s"${found.mismatched} mismatched, ${found.skipped_generic} generic declarations " +
                "read through their instantiations, " +
                s"${found.skipped_defaults} skipped for type defaults, " +
                s"${found.skipped_unresolved} this stage could not finish, " +
                s"${found.skipped_absent} the reference did not print"

            print(summary)
            record_summary(s"$summary${found.first_bad}${found.first_unresolved}")
            assert(found.matched > 0, "the sweep compared something")
            assert(found.first_bad == "", s"$summary${found.first_bad}")
            assert(found.mismatched == 0, summary)
end the_typed_trees_agree

// -- the declaration tables, which is 3a's own proof ------------------------------------------------

// What a tables sweep found.
struct TableAgreement
    files: usize
    mismatched: usize
    skipped: usize
    first_bad: string
end TableAgreement

// The reference compiler's declaration tables for one file.
private ask_oracle_tables(binary: string, path: string) -> Option[string]
    capture(binary, ["emit-typed", "--tables", path], "", [], true) match
        Err(_) -> None
        Ok(answer) -> if answer.status.ok() then Some(answer.text) else None
end ask_oracle_tables

// The `funcs:` section of such an answer, as one row per key.
//
// **The reference's table is written after lowering and after reachability**, so it holds rows this
// stage has no counterpart for -- the library functions a program reached, and the environment form
// a function that writes module storage was lowered into (`$env0.bump(self: *.env0)`). The
// comparison is therefore per key: a key this compiler filed is looked for there, and one it does
// not carry is counted rather than compared.
private funcs_rows(text: string) -> Buf[(string, string)]
    var out: Buf[(string, string)] = buf()
    var inside = false

    for line in split(text, "\n")
        if !inside
            if line == "funcs:" then inside = true
        else if line.starts_with("  ")
            val row = line[2..]
            val open = row.index_of("(")

            if open.is_some() then out.push((row[0..<open.unwrap()], row))

    out
end funcs_rows

// The rows this compiler files for a file's own declarations, by key.
private our_rows(a: &Analysis) -> Buf[(string, string)]
    var out: Buf[(string, string)] = buf()

    for line in split(show_funcs_table(a), "\n")
        if line.starts_with("  ")
            val row = line[2..]
            val open = row.index_of("(")

            if open.is_some() then out.push((row[0..<open.unwrap()], row))

    out
end our_rows

// Whether a file declares something whose function table this stage does not build the same way: a
// **generic**, which the reference files once per instantiation and this pass files not at all,
// since nothing here calls one.
//
// A member and an `impl`'s member used to be on this list and are not any more: both are lowered to
// ordinary functions under the names the reference gives them, so both are rows of the table the
// comparison already reads per key.
private declares_beyond_this_stage(unit: Program) -> bool
    for i in 0..<unit.body.len()
        *unit.body.at(i).kind match
            FuncDecl(d) -> if !d.tparams.is_empty() then return true
            StructDecl(d) -> if !d.tparams.is_empty() then return true
            EnumDecl(d) -> if !d.tparams.is_empty() then return true
            _ -> ()

    false
end declares_beyond_this_stage

private compare_tables(binary: string, path: string, label: string, text: string,
                       found: *TableAgreement)
    val parsed = parse(source_of(path, text))

    if !parsed.ok() then return

    if declares_beyond_this_stage(parsed.program)
        found.skipped += 1

        return
    end if

    val a = analysis_for(host_target())
    var units: Buf[Program] = buf()

    units.push(parsed.program)
    read_decls(a, units)

    if !a.diagnostics().is_empty()
        found.skipped += 1

        return
    end if

    val ours = our_rows(a)

    if ours.is_empty()
        found.skipped += 1

        return
    end if

    val theirs = ask_oracle_tables(binary, path)

    if theirs.is_none()
        found.skipped += ours.len()

        return
    end if

    val rows = funcs_rows(theirs.unwrap())

    for i in 0..<ours.len()
        val mine = ours.at(i)
        val theirs_row = row_named(rows, mine.0)

        if theirs_row.is_none() then found.skipped += 1
        else
            found.files += 1

            if theirs_row.unwrap() != mine.1
                found.mismatched += 1

                if found.mismatched <= 12 then
                    found.first_bad = s"${found.first_bad}\n$label: reference " +
                                      s"[${theirs_row.unwrap()}] ours [${mine.1}]"
end compare_tables

private row_named(rows: Buf[(string, string)], key: string) -> Option[string]
    for i in 0..<rows.len()
        if rows.at(i).0 == key then return Some(rows.at(i).1)

    None
end row_named

@test("the two compilers file the same functions under the same keys, with the same signatures")
the_declaration_tables_agree()
    oracle() match
        None ->
            print("skipped: SYSL_ORACLE names no reference compiler on this machine")
            return
        Some(binary) ->
            val root = "../sysl.sh/docs/content/reference"

            if !present(root)
                print("skipped: the reference pages are not on this machine")
                return
            end if

            val dir = make_temp_dir("sysl-tables").unwrap()
            val scratch = dir + "/block.sysl"

            var found = TableAgreement(0, 0, 0, "")

            for item in walk(root)
                item match
                    Err(_) -> ()
                    Ok(entry) ->
                        if entry.path.ends_with(".md")
                            read_text(entry.path) match
                                Err(_) -> ()
                                Ok(page) ->
                                    val blocks = sysl_blocks(page)

                                    for i in 0..<blocks.len()
                                        write_text(scratch, blocks.at(i)).unwrap()
                                        compare_tables(binary, scratch,
                                            s"${entry.path} block ${i + 1}", blocks.at(i), &found)

            remove_file(scratch)

            val tables = s"declaration tables: ${found.files} files compared, " +
                         s"${found.mismatched} mismatched, ${found.skipped} skipped"

            print(tables)
            record_summary(s"$tables${found.first_bad}")

            assert(found.files > 0, "the sweep compared something")
            assert_eq(found.first_bad, "")
            assert_eq(found.mismatched, 0)
end the_declaration_tables_agree

// -- the same tree, over a WHOLE PROGRAM ----------------------------------------------------------

// **A block compiled on its own has no library, so what a free `print` or an `Option` means is
// whatever the block itself declares -- which is nothing.** Compiled *with* the standard module the
// same block is a program: its names resolve to the library's declarations, the calls it makes reach
// the library's own bodies, and the reference compiler's answer for it holds those bodies too. That
// is what this sweep compares, and it is what nothing in this repository could reach until the
// driver could assemble a compilation.

// The library's trees, parsed once for the whole sweep.
//
// **Parsing 152 files is most of what one comparison costs**, so doing it per block would turn a
// four-minute sweep into an hour's. What is cached is the parse; the analysis is per block, because
// that is the thing being compared.
private var library_cache: Buf[Program] = buf()
private var library_read: bool = false

private library_units() -> Buf[Program]
    if library_read then return library_cache

    library_read = true

    std_root() match
        Err(_) -> ()
        Ok(root) -> std_units(root, host_target()) match
            Err(_) -> ()
            Ok(units) -> library_cache = units

    library_cache
end library_units

// The modules a diagnostic came from, which are the modules whose bodies are not evidence.
//
// **A library file this compiler had something to say about has a body it did not finish**, and
// comparing that body would report a difference whose cause is already known and already counted.
// The module is read off the file's place under the library root, which is the same key its header
// declares.
private complaining_modules(reported: Buf[Placed]) -> Buf[string]
    var out: Buf[string] = buf()

    for i in 0..<reported.len()
        val name = module_of_source(reported.at(i).src.name)
        var seen = false

        for j in 0..<out.len()
            if out.at(j) == name then seen = true

        if !seen then out.push(name)

    out
end complaining_modules

// The module a library file belongs to, read off the name a diagnostic calls it: `library/sysl/text/
// find.sysl` is `sysl.text`. A file outside the library is the block itself, which is the anonymous
// root module -- so a complaint anywhere in the block takes every function it declared out of the
// comparison, which is the same coarse rule the single-file sweep uses.
private module_of_source(name: string) -> string
    if !name.starts_with("library/") then return ""

    var parts = split(name[8..], "/")
    var out = ""
    var held: Buf[string] = buf()

    for piece in parts
        held.push(piece)

    if held.len() < 2 then return ""

    for i in 0..<(held.len() - 1)
        if i > 0 then out = out + "."

        out = out + held.at(i)

    out
end module_of_source

private in_set(names: Buf[string], name: string) -> bool
    for i in 0..<names.len()
        if names.at(i) == name then return true

    false
end in_set

// One block compiled as a whole program, function by function.
private compare_whole(binary: string, path: string, label: string, text: string,
                      found: *TypedAgreement)
    val parsed = parse(source_of(path, text))

    if !parsed.ok() then return

    val library = library_units()

    if library.is_empty() then return

    var units: Buf[Program] = buf()

    for i in 0..<library.len()
        units.push(library.at(i))

    units.push(parsed.program)

    val ours = analyze_bodies(units, host_target())
    val blocked = complaining_modules(ours.reported)

    // The block's own module is the anonymous root one, so a complaint anywhere in the block takes
    // every function it declared out of the comparison -- which is the same coarse rule the
    // single-file sweep uses, and errs towards skipping.
    val theirs = ask_oracle_typed(binary, path)

    if theirs.is_none()
        found.skipped_absent += 1

        return
    end if

    val printed = printed_funcs(theirs.unwrap())

    for i in 0..<ours.funcs.len()
        val f = ours.funcs.at(i)
        val block = block_named(printed, f.name)

        // A function the reference did not print is one this program does not reach, which is the
        // stage above this one -- there is nothing to compare it against.
        if block.is_none() then continue

        if in_set(blocked, module_of(f.name))
            found.skipped_unresolved += 1
            continue
        end if

        val mine = show_typed_func(f)
        val where = first_difference(without_trailing_newlines(block.unwrap()),
                                     without_trailing_newlines(mine))

        if where == ""
            found.matched += 1
        // **A `TZero` on this side is the walk's own fallback, not an answer.** Where an expression
        // could not be typed the analyzer answers with the zero of its type and carries on, so a
        // difference at one is a body this stage could not finish -- the same thing a diagnostic
        // would have said, from a walk that produced a value instead of saying it.
        else if names_a_fallback(where)
            found.skipped_unresolved += 1
        else
            found.mismatched += 1

            if found.mismatched <= 12 then
                found.first_bad = s"${found.first_bad}\n$label ${f.name}: $where"
end compare_whole

private names_a_fallback(where: string) -> bool
    val at = where.index_of("ours [")

    if at.is_none() then return false

    where[at.unwrap()..].index_of("TZero").is_some()
end names_a_fallback

@test("the two analyzers agree on a whole program, with the library's own bodies in it")
the_typed_trees_agree_over_whole_programs()
    oracle() match
        None ->
            print("skipped: SYSL_ORACLE names no reference compiler on this machine")
            return
        Some(binary) ->
            if library_units().is_empty()
                print("skipped: the standard module's source is not on this machine")
                return
            end if

            val root = "../sysl.sh/docs/content/reference"

            if !present(root)
                print("skipped: the reference pages are not on this machine")
                return
            end if

            val dir = make_temp_dir("sysl-whole").unwrap()
            val scratch = dir + "/block.sysl"

            var found = TypedAgreement(0, 0, 0, 0, 0, 0, "", "")

            for item in walk(root)
                item match
                    Err(_) -> ()
                    Ok(entry) ->
                        if entry.path.ends_with(".md")
                            read_text(entry.path) match
                                Err(_) -> ()
                                Ok(page) ->
                                    val blocks = sysl_blocks(page)

                                    for i in 0..<blocks.len()
                                        write_text(scratch, blocks.at(i)).unwrap()
                                        compare_whole(binary, scratch,
                                            s"${entry.path} block ${i + 1}", blocks.at(i), &found)

            remove_file(scratch)

            val summary = s"whole programs: ${found.matched} bodies matched, " +
                s"${found.mismatched} mismatched, " +
                s"${found.skipped_unresolved} in modules this stage could not finish, " +
                s"${found.skipped_absent} blocks the reference refused"

            print(summary)
            record_summary(s"$summary${found.first_bad}")
            assert(found.matched > 0, "the sweep compared something")
            assert(found.mismatched == 0, s"$summary${found.first_bad}")
end the_typed_trees_agree_over_whole_programs
