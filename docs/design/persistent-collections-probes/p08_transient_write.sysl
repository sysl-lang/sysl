// P08: a transient writes a node in place when the node belongs to it (Clojure's edit token). On a
// `&sync` node a field write is refused, so the node type has to promise `@unchecked(Share)` over
// private fields. Part (a) is the refusal; part (b), in p08b, is the promise.

struct SNode
    edit: usize
    items: [4]int

main()
    val n: &sync SNode = SNode(7, [1, 2, 3, 4])

    if n.edit == 7 then n.items[0] = 10
    print(n.items[0])
