module sh.sysl.compiler
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.Search

// **What `sysl build-c` writes beside the archive**, and the one thing an archive's analysis has to
// be told before a declaration is read.
//
// These need the library, since an exported signature is spelled in types the standard module
// declares, so each returns and says so where it is not on the machine.

private var library_cache: Buf[Program] = buf()
private var library_read: bool = false

private library_trees() -> Buf[Program]
    if library_read then return library_cache

    library_read = true

    std_root() match
        Err(_) -> ()
        Ok(root) -> std_units(root, host_target()) match
            Err(_) -> ()
            Ok(units) -> library_cache = units

    library_cache
end library_trees

private no_library() -> bool
    if library_trees().is_empty()
        print("skipped: the standard module's source is not on this machine")
        return true

    false
end no_library

// One source read as a C archive would read it -- no entry point, so no file of it is a body -- and
// the header that would be written for it.
//
// The file carries **no `module` header and a module-level `val`**, which is the archive projects'
// own shape: `androidkit/main.sysl` and the four beside it are exactly this.
private header_for(text: string, has_entry_point: bool) -> string
    val parsed = parse(source_of("main.sysl", text))

    if !parsed.ok() then return parsed.report.at(0).message

    var units: Buf[Program] = buf()
    val library = library_trees()

    for i in 0..<library.len()
        units.push(library.at(i))

    units.push(parsed.program)

    val done = analyze_produced(units, host_target(), buf(), has_entry_point)
    val whole = program_of(done, done.main_module)
    var own: Buf[string] = buf()

    own.push("")

    val kept = prune(strip_tests(whole), own)

    c_header_render(exports_by_symbol(kept.funcs), "demo")
end header_for

// The shape every archive project in the org has: a module-level binding, and exports beside it in
// the same file.
private archive_source() -> string = raw"""
    var bar_top: i32 = 0

    @export("demo_add")
    add(a: int, b: int) -> int = a + b

    @export("SDL_main")
    start(argc: int, argv: **u8) -> int
        bar_top = i32(argc)

        add(int(bar_top), 1)
    """

// **A file with no `module` header holding a `val` is a program's entry file, whose declarations are
// that body's locals -- and an archive has no entry file at all.** Read as one, an `@export` beside
// module storage becomes a nested function of a body nothing emits: it is renamed, the attribute
// goes with it, and the header comes out empty while the build reports success.
//
// This is what `androidkit` warns about in its own source, and it is why `build-c` has to say there
// is no entry point *before* a declaration is read rather than patching the flag afterwards.
@test("an archive's exports survive because nothing in it is an entry file")
exports_survive_with_no_entry_point()
    if no_library() then return

    val header = header_for(archive_source(), false)

    assert(header.contains("int32_t demo_add(int32_t a, int32_t b);"), header)
    assert(header.contains("int32_t SDL_main(int32_t argc, uint8_t * * argv);"), header)

    // Sorted by the C symbol, so that two builds of one tree write one header.
    assert(header.index_of("SDL_main(").unwrap() < header.index_of("demo_add(").unwrap(),
           "the prototypes are in symbol order")

// **And the same file read as a program loses the export that touches the storage** -- which is the
// half that makes this worth pinning, because it is not all of them. `demo_add` reads nothing the
// body binds and stays the module's; `SDL_main` writes `bar_top`, so it becomes a nested function of
// a body nothing emits, is renamed, and takes its `@export` with it. A header missing one prototype
// out of two is what a build reports success over.
@test("and read as a program instead, the export that touches the storage is lost")
exports_are_lost_when_the_file_is_a_body()
    if no_library() then return

    val header = header_for(archive_source(), true)

    assert(!header.contains("SDL_main"), header)
    assert(header.contains("demo_add"), header)

@test("the header is the reference's, guard and includes and all")
the_header_is_the_references()
    if no_library() then return

    val header = header_for(archive_source(), false)

    assert(header.starts_with(
        "/* Generated by sysl. The declarations a C project needs to call into this module. */\n" +
        "#ifndef SYSL_DEMO_H\n#define SYSL_DEMO_H\n\n" +
        "#include <stdbool.h>\n#include <stdint.h>\n#include <stddef.h>\n\n" +
        "#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n"), header)

    assert(header.ends_with("#ifdef __cplusplus\n}\n#endif\n\n#endif /* SYSL_DEMO_H */\n"), header)

// A `never` result is the only thing that puts the macro in a header, and a `unit` one is not --
// both spell as `void`, and the annotation is the only thing that tells them apart on C's side.
@test("a 'never' export brings the no-return macro with it and a 'unit' one does not")
a_never_export_is_annotated()
    if no_library() then return

    val plain = header_for(raw"""
        @export("demo_quiet")
        quiet(n: int) -> unit = ()
        """, false)

    assert(plain.contains("void demo_quiet(int32_t n);"), plain)
    assert(!plain.contains("SYSL_NORETURN"), plain)

    val stopping = header_for(raw"""
        @export("demo_stop")
        stop() -> never = exit(1)
        """, false)

    assert(stopping.contains("SYSL_NORETURN void demo_stop(void);"), stopping)
    assert(stopping.contains("#define SYSL_NORETURN _Noreturn"), stopping)
