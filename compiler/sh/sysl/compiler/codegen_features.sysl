module sh.sysl.compiler

import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}
import sysl.text.Search
import sysl.fs.{make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture

// What the generated code may use of the machine: the project's `codegen` block and the two flags
// beside it.
//
// **Two settings, both a kernel's**: `general_regs_only` keeps every value in the general-purpose
// registers -- no floating-point or SIMD register is read or written, so exception entry and a
// context switch need not save that file, and code that runs before the unit is enabled cannot
// trap on it -- and `strict_align` makes every access naturally aligned, which is what memory mapped
// as Device (an MMU that is off) demands. They are clang's `-mgeneral-regs-only` and `-mstrict-align`.
//
// **And one list, `extensions`**: the processor's optional instructions the code may use beyond what
// the row's architecture guarantees -- `lse`, so an atomic read-modify-write is one `ldadd`/`swp`/
// `cas` rather than a load-exclusive/store-exclusive loop, `rcpc`, `crc`, a RISC-V `zbb`. Each name is
// LLVM's feature name, checked against the back end that will compile it (`extension_refusal`); it
// is a list rather than a setting per extension because the set is the back end's, not this file's.
//
// **A setting is a property of the whole image, so only the root project's applies**: a dependency
// cannot turn the registers back on under its consumer, and the standard module is compiled under
// the same answer. It reaches every place code is generated: the LLVM text's function attributes,
// every clang that compiles that text or a package's carried C or measures a `c const`, the standard
// module's artifact (whose cache directory carries `codegen_features_key`), the C object cache and
// codegen-unit cache (both keyed over the arguments), and the run cache.
//
// **A setting that means nothing on a machine is refused rather than dropped**, naming what the
// machine does instead -- a build that silently ignored `general_regs_only` would be the one result
// worse than a refusal.

// The settings, as one value.
struct CodegenFeatures
    general_regs_only: bool
    strict_align: bool
    extensions: Buf[string]
end CodegenFeatures

// The settings a build asked for nothing of.
no_codegen_features() -> CodegenFeatures = CodegenFeatures(false, false, buf())

// Whether `word` names a setting a `codegen` block may hold as `true` or `false`; `extensions`, the
// one list, is read on its own.
is_codegen_setting(word: string) -> bool = word == "general_regs_only" || word == "strict_align"

// What this process is building under. **Settled by `target_for`**, the one funnel every building
// command comes through, before the standard module's artifact is looked for -- the artifact's
// directory is named by it.
private var cf_general_regs_only: bool = false
private var cf_strict_align: bool = false
private var cf_extensions: Buf[string] = buf()

codegen_features() -> CodegenFeatures =
    CodegenFeatures(cf_general_regs_only, cf_strict_align, cf_extensions)

use_codegen_features(f: CodegenFeatures)
    cf_general_regs_only = f.general_regs_only
    cf_strict_align = f.strict_align
    cf_extensions = f.extensions
end use_codegen_features

// What the settings add to a cache key: nothing where both are off, so an ordinary build's paths are
// unchanged.
codegen_features_key() -> string
    var out = ""

    if cf_general_regs_only then out = out + "-gro"
    if cf_strict_align then out = out + "-sa"
    if cf_thread_pointer != "" then out = out + s"-tp.$cf_thread_pointer"
    if cf_per_cpu_offset != "" then out = out + s"-pc.$cf_per_cpu_offset"

    if !cf_extensions.is_empty()
        out = out + "-ext"

        for name in cf_extensions
            out = out + "+" + name
    end if

    out
end codegen_features_key

// -- the registers a bare image owns ----------------------------------------------------------------

// **Two more settings, both naming a register the program writes itself**: `thread_pointer`, the
// register a `@thread_local`'s local-exec offset is read from, and `per_cpu_offset`, the register
// holding this core's offset from the `.percpu` image (`reference/attributes.md § @thread_local`,
// `§ @per_cpu`). On a hosted machine the loader and the operating system own the thread pointer and
// move threads between cores at will, so both are AArch64 and freestanding only.
struct MachineRegisters
    thread_pointer: Option[string]
    per_cpu_offset: Option[string]
end MachineRegisters

no_machine_registers() -> MachineRegisters = MachineRegisters(None, None)

// Whether `word` names a register setting a `codegen` block may hold.
is_register_setting(word: string) -> bool = word == "thread_pointer" || word == "per_cpu_offset"

// The registers either setting may name: the four software thread-ID registers, by the name
// `mrs` and LLVM's `-mtp` both take, and the read-only one EL0 cannot write.
private register_names() -> Buf[string]
    var out: Buf[string] = buf()

    out.push("tpidr_el0")
    out.push("tpidrro_el0")
    out.push("tpidr_el1")
    out.push("tpidr_el2")
    out.push("tpidr_el3")
    out
end register_names

// Why `name` cannot be what a register setting names, or nothing where it can.
register_name_refusal(where: string, name: string) -> Option[string]
    for known in register_names()
        if known == name then return None

    Some(s"'$where' is '$name', which is not a register a program can keep a pointer in — the " +
         "five are 'tpidr_el0', 'tpidrro_el0', 'tpidr_el1', 'tpidr_el2' and 'tpidr_el3'")
end register_name_refusal

private var cf_thread_pointer: string = ""
private var cf_per_cpu_offset: string = ""

// The register a `@thread_local`'s offset is read from where the program owns it, or nothing.
thread_pointer_register() -> Option[string] =
    if cf_thread_pointer == "" then None else Some(cf_thread_pointer)

// The register holding this core's offset from the `.percpu` image, or nothing.
per_cpu_register() -> Option[string] = if cf_per_cpu_offset == "" then None else Some(cf_per_cpu_offset)

use_machine_registers(r: MachineRegisters)
    cf_thread_pointer = r.thread_pointer.unwrap_or("")
    cf_per_cpu_offset = r.per_cpu_offset.unwrap_or("")
end use_machine_registers

// Why `r` cannot be built for `t`, or nothing where it can.
machine_register_refusal(t: Target, r: MachineRegisters) -> Option[string]
    var named: Buf[(string, string)] = buf()

    if r.thread_pointer.is_some() then named.push(("thread_pointer", r.thread_pointer.unwrap()))
    if r.per_cpu_offset.is_some() then named.push(("per_cpu_offset", r.per_cpu_offset.unwrap()))

    for setting in named
        if t.cpu != Aarch64
            return Some(s"'codegen.${setting.0}' names an AArch64 register, and '${t.name}' is not " +
                "an AArch64 machine")

        if t.os != Freestanding
            return Some(s"'codegen.${setting.0}' does not apply to '${t.name}': a hosted machine's " +
                "operating system owns the thread registers and moves threads between cores, so " +
                "'@thread_local' already works there and nothing the program writes would stay put")

    if r.thread_pointer.is_some() && r.thread_pointer.unwrap() == r.per_cpu_offset.unwrap_or("")
        return Some(s"'codegen.thread_pointer' and 'codegen.per_cpu_offset' both name " +
            s"'${r.thread_pointer.unwrap()}', and one register cannot hold a thread's block and a " +
            "core's offset at once — a thread moves between cores. Give each its own")

    None
end machine_register_refusal

// What clang's `-mtp` calls the register, which is also how the back end's feature is spelled.
private mtp_word(register: string) -> string =
    if register == "tpidrro_el0" then "tpidrro_el0" else register[6..<register.bytes.len]

// The target feature that moves the back end's thread pointer, or nothing for its default.
private thread_pointer_feature() -> Option[string]
    if cf_thread_pointer == "" || cf_thread_pointer == "tpidr_el0" then return None

    if cf_thread_pointer == "tpidrro_el0" then return Some("+tpidrro-el0")

    Some(s"+tpidr-${mtp_word(cf_thread_pointer)}")
end thread_pointer_feature

// Why `f` cannot be built for `t`, or nothing where it can.
//
// | | `general_regs_only` | `strict_align` |
// |---|---|---|
// | aarch64 | `-fp-armv8,-neon` | `+strict-align` |
// | x86_64 | `-x87,-mmx,-sse` | refused: x86 has no strict mode |
// | thumb | refused: pick a row with no unit | `-mno-unaligned-access` |
// | riscv | refused: the float ABI is the triple's | `-mstrict-align` |
// | wasm32, craft | refused | refused |
//
// **Thumb and RISC-V are refused rather than mapped for `general_regs_only`** because their
// floating-point unit is part of the calling convention the row names: turning it off under a
// hard-float row would change where every float argument travels, which is a different machine --
// and the registry already has it (`thumb-freestanding-soft`, `thumbv6m-freestanding`).
codegen_feature_refusal(t: Target, f: CodegenFeatures) -> Option[string]
    if f.general_regs_only
        val why: Option[string] = t.cpu match
            Aarch64 -> None
            X86_64 -> None
            Thumb -> Some(s"an Arm row names its floating-point unit as part of its calling " +
                "convention, so turning the unit off is a different machine — build for one with no " +
                "unit ('thumb-freestanding-soft', 'thumbv6m-freestanding'), whose code never touches a " +
                "floating-point register")
            Riscv64 -> Some(riscv_general_regs())
            Riscv32 -> Some(riscv_general_regs())
            _ -> Some("the machine has no separate floating-point or vector register file to keep out of")

        if why.is_some()
            return Some(s"'general_regs_only' does not apply to '${t.name}': ${why.unwrap()}")
    end if

    if f.strict_align
        val why: Option[string] = t.cpu match
            Aarch64 -> None
            Thumb -> None
            Riscv64 -> None
            Riscv32 -> None
            X86_64 -> Some("x86 has no strict-alignment mode — every access may be unaligned there, " +
                "and the hardware performs it")
            _ -> Some("the machine has no strict-alignment mode to select")

        if why.is_some() then return Some(s"'strict_align' does not apply to '${t.name}': ${why.unwrap()}")
    end if

    if !f.extensions.is_empty() && !t.builds_with_clang()
        return Some(s"'extensions' does not apply to '${t.name}': its code is not generated by LLVM, " +
            "whose names for a processor's extensions are what the list holds")

    None
end codegen_feature_refusal

private riscv_general_regs() -> string =
    "the F and D extensions are part of the ABI the row's triple names, so turning them off is a " +
    "different machine — a 'riscv32-freestanding' build already has none"

// What clang is told on every command line producing code for `t`, under the settings in force:
// the sysl text's compile, a package's carried C, the `c const` probe and the link.
codegen_feature_flags(t: Target) -> Buf[string]
    var out: Buf[string] = buf()

    if cf_general_regs_only && (t.cpu == Aarch64 || t.cpu == X86_64)
        out.push("-mgeneral-regs-only")

    if cf_strict_align
        if t.cpu == Thumb
            out.push("-mno-unaligned-access")
        elif t.cpu == Aarch64 || t.cpu == Riscv64 || t.cpu == Riscv32
            out.push("-mstrict-align")

    // An extension is added to the feature string the row's flags built, which is what
    // `-target-feature` does on every machine -- where `-march=<arch>+<ext>` would restate the
    // architecture a Thumb row already names.
    for name in cf_extensions
        out.push("-Xclang")
        out.push("-target-feature")
        out.push("-Xclang")
        out.push(s"+$name")

    // A package's carried C is compiled against the same thread pointer, so a `_Thread_local` there
    // and a `@thread_local` here read one block.
    if cf_thread_pointer != "" && t.cpu == Aarch64 then out.push(s"-mtp=${mtp_word(cf_thread_pointer)}")

    out
end codegen_feature_flags

// The `"target-features"` function attribute every sysl definition carries under the settings, or
// nothing.
//
// **Only where the machine's features come from its processor**: aarch64 and x86_64. An LLVM
// function's `target-features` REPLACES the feature string the command line built rather than adding
// to it, and on Thumb the string carries the unit `-mfpu` named and on RISC-V the extensions the
// triple names -- replaced, a function would lose them. There the clang flag alone carries the
// setting, applying to every function, none of which then carries an attribute of its own.
//
// **The extensions come first and `general_regs_only` last**, since a later entry wins: an extension
// that brings the SIMD unit with it (`sve`) is turned back off by `-neon` rather than reopening the
// registers the setting closed.
codegen_feature_attribute(t: Target) -> Option[string]
    var parts: Buf[string] = buf()

    if t.cpu == Aarch64 || t.cpu == X86_64
        for name in cf_extensions
            parts.push(s"+$name")

    if cf_strict_align && t.cpu == Aarch64 then parts.push("+strict-align")

    if t.cpu == Aarch64
        thread_pointer_feature() match
            Some(f) -> parts.push(f)
            None -> ()

    if cf_general_regs_only
        if t.cpu == Aarch64
            parts.push("-fp-armv8")
            parts.push("-neon")
        elif t.cpu == X86_64
            parts.push("-x87")
            parts.push("-mmx")
            parts.push("-sse")

    if parts.is_empty() then return None

    var text = ""

    for i in 0..<parts.len()
        if i > 0 then text = text + ","

        text = text + parts.at(i)

    Some(s"\"target-features\"=\"$text\"")
end codegen_feature_attribute

// -- the extensions, asked of the back end ---------------------------------------------------------

// What each probe answered this process, keyed by the clang, the triple and the name: `true` where
// the back end knows the extension.
private var cf_known: Buf[(string, bool)] = buf()

// Why one of `names` cannot be built for `t` with `clang`, or nothing where every one can.
//
// **The back end is the authority, as it is for a system register's name** (`sysreg.sysl`): LLVM's
// table of each processor's features moves with every release, and a name it does not know is only a
// warning on clang's standard error -- `'+lsee' is not a recognized feature for this target (ignoring
// feature)` -- after which the build goes on without the extension its author asked for. So each name
// is compiled once, in an empty function, and that warning is the refusal.
extension_refusal(t: Target, clang: string, names: Buf[string]) -> Option[string]
    for name in names
        val key = s"$clang|${t.triple}|$name"
        var known: Option[bool] = None

        for row in cf_known
            if row.0 == key then known = Some(row.1)

        if known.is_none()
            val asked = extension_known(t, clang, name)

            if asked.is_err() then return Some(asked.unwrap_err())

            known = Some(asked.unwrap())
            cf_known.push((key, asked.unwrap()))
        end if

        if !known.unwrap()
            return Some(s"'codegen.extensions' names '$name', which the ${cpu_symbol(t.cpu)} back end " +
                s"does not know — an extension is spelled as LLVM spells the feature ('lse' or " +
                "'rcpc' on AArch64, 'popcnt' on x86_64, 'zbb' on RISC-V)")
    end for

    None
end extension_refusal

// Whether `clang`'s back end for `t` takes `+name` without complaint.
private extension_known(t: Target, clang: string, name: string) -> Result[bool, string]
    val dir = make_temp_dir("sysl-ext") match
        Err(_) -> return Err("cannot make a directory to check the extensions in")
        Ok(made) -> made

    val src = join_path(dir, "probe.ll")

    write_text(src, "define void @probe() {\n  ret void\n}\n") match
        Err(_) ->
            remove_dir_all(dir).unwrap_or(())
            return Err(s"cannot write $src")
        Ok(_) -> ()

    var args: Buf[string] = buf()

    args.push(s"--target=${t.triple}")
    args.push("-S")
    args.push("-o")
    args.push("-")
    args.push("-Xclang")
    args.push("-target-feature")
    args.push("-Xclang")
    args.push(s"+$name")
    args.push(src)

    val said = capture(clang, args.view(), "", [], true)

    remove_dir_all(dir).unwrap_or(())

    said match
        Err(_) -> Err(s"cannot run '$clang' to check the extensions")
        Ok(got) -> Ok(got.status.ok() && !got.err.unwrap_or("").contains("is not a recognized feature"))
end extension_known

// The `extensions` named in `codegen` blocks: the target's own list over the project's, and none
// where neither says anything. A target's empty list takes the project's away.
codegen_extensions(m: &Manifest, target: string) -> Buf[string]
    for row in m.target_extensions
        if row.0 == target then return row.1

    m.extensions.unwrap_or(buf())
end codegen_extensions

// -- floating point under `general_regs_only` ---------------------------------------------------------

// Every body that computes with a floating-point value, refused where the build keeps to the general
// registers.
//
// **LLVM does not refuse it, and that is why this does.** With the unit's features off it quietly
// lowers every float to the soft-float convention: an `f64` parameter moves to an integer register, a
// multiply becomes a call to `__muldf3`, and the image either fails to link for want of a runtime a
// kernel does not carry or links against code compiled for the other convention. clang refuses the
// same C in its front end ("requires 'double' type support"), so the sysl refusal is the C one, said
// at the first thing in the body that has a floating type.
//
// **One complaint per body**, at its signature where a parameter or the result is a float and
// otherwise at the outermost floating expression the walk meets first; every function the build emits
// is asked, the standard module's included, since a library body computing with a float is code in
// this image too. A build OF a library is not asked: it is compiled for whichever program reaches it,
// and that program is held to this.
check_general_regs(a: &Analysis, p: TProgram)
    if !cf_general_regs_only || !a.producing.is_empty() then return

    for i in 0..<p.funcs.len()
        val f = p.funcs.at(i)

        float_use_in(a, func_home(a, f.name), s"'${qualified_name(f.name)}'", f.params, f.ret_ty,
                     f.span, f.body.stmts, f.body.result)

    float_use_in(a, entry_home(a), "the program's statements", buf(), Unit, Span(0, 0), p.main, None)
end check_general_regs

private float_use_in(a: &Analysis, home: Scope, who: string, params: Buf[(string, Type)],
                     result: Type, at: Span, stmts: Buf[TStmt], tail: Option[TExpr])
    for param in params
        if floating_value(param.1)
            a.fault(home, at, general_regs_refusal(s"$who takes '${param.0}' as " +
                s"'${type_show(param.1)}'"))
            return
        end if

    if floating_value(result)
        a.fault(home, at, general_regs_refusal(s"$who returns '${type_show(result)}'"))
        return
    end if

    var found: Buf[TExpr] = buf()
    val sink = &found

    val walk = expr_walk(false, (e) -> note_floating(sink, e))

    walk_stmts(stmts, walk)

    if tail.is_some() then walk_texpr(tail.unwrap(), walk)

    if found.is_empty() then return

    val e = found.at(0)

    a.fault(home, e.span, general_regs_refusal(s"$who computes with '${type_show(texpr_type(e))}' here"))
end float_use_in

// The first floating expression a walk meets, kept; the rest are inside it or later.
private note_floating(sink: *Buf[TExpr], e: TExpr)
    if sink.is_empty() && floating_value(texpr_type(e)) then sink.push(e)

// Whether a value of `t` lives in a floating-point register: a float, or a vector of them.
floating_value(t: Type) -> bool = op_subject(t) match
    Floating(_, _) -> true
    _ -> false

private general_regs_refusal(what: string) -> string =
    s"$what, and this build keeps to the general-purpose registers ('codegen.general_regs_only' in " +
    "package.hocon, or '--general-regs-only') — a floating-point value has no register to live in. " +
    "Compute in integers or fixed point, or build without the setting"
