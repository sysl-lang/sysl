// A program's arguments reach it through a declared `main` (`13 §7`), as a slice of strings. The
// zeroth is the program's own path, which is what the platform passes; the rest are the words it was
// started with.
//
//     ./run-example.sh examples/args.sysl -- -n one two
//
// This is the whole of what the platform hands over, and it is deliberately all this program does
// with it: reading *options* out of those words -- that `-n` is an option and `one` is not, that
// `-abc` is three of them -- is `sysl.args`'s, and `options.sysl` beside this is that. Walking the
// slice by hand is right only when what a program wants is the words themselves.

main(args: []string)
    print("started as:", args[0])
    print(args.len - 1, "argument(s) given")

    for i in 1..<args.len
        print(f"  ${i}%2d: ${args[i]}%s")
