module sh.sysl.compiler

import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}

// What a whole program is made of, assembled once every body has been typed.
//
// **The typed tree is one function at a time and a program is not**: what a back end is handed is
// the layouts, the tables, the storage, the entry point and the scaffolding a test run needs, and
// every one of those is a question about the compilation rather than about any one body. This is
// where they are answered.

// The entry point a program declared, where it declared one.
//
// **Read after the bodies are typed and before the held ones are**, because the conversion an entry
// wants is a library function: marking one as reached has to happen while there is still a pass that
// will go and analyze it.
declared_entry(a: &Analysis) -> Option[TEntry]
    var found: Option[string] = None

    for i in 0..<a.tables.funcs.len()
        val key = a.tables.funcs.key_at(i)

        if module_bare(key) == "main" && !a.tables.externs.has(key)
            // **A program starts in one place, so it declares one `main`.** The first is the
            // program's and every one after it is told which declaration already holds the name.
            if found.is_none() then found = Some(key)
            else
                val other = a.tables.funcs.get(key).unwrap()

                a.fault(other.scope, other.span, "'main' is where a program starts, so there is " +
                        s"one — ${module_show(found.unwrap())} already declares it")

    if found.is_none() then return None

    val key = found.unwrap()
    val f = a.tables.funcs.get(key).unwrap()
    val ret = if f.decl.ret_type.is_none() then Unit
    else resolve_type(a, f.scope, f.decl.ret_type.unwrap(), no_bindings())

    // **The first of these ends the reading**, because everything after it is a question about a
    // signature the platform has already been told it cannot call.
    if !f.decl.tparams.is_empty()
        a.fault(f.scope, f.span, "'main' is called by the platform, which has no type arguments " +
                "to give it")
        return None
    end if

    // **A `main` either yields nothing or answers with a `Result[unit, E]`**, and the second is what
    // lets `?` reach the top of a program. Nothing else is admitted: an exit status is one byte and
    // a result is a value, so mapping one onto the other is the program's own business -- and the
    // refusal names the answer, since `exit` is how a program chooses its own status.
    val fallible = result_entry(a, ret)

    if fallible.is_none() && !no_value(ret)
        a.fault(f.scope, f.span, "'main' yields nothing or a 'Result[unit, E]', so it may not " +
                s"result in ${type_show(ret)} — a program's exit status is not something a " +
                "signature can say. 'exit(code)' is how a program chooses its own, and prints " +
                "nothing")
        return None
    end if

    if f.decl.variadic
        a.fault(f.scope, f.span, "'main' is called with the arguments the platform has, not a " +
                "list it reads")
        return None
    end if

    val reporter = entry_reporter(a, fallible)

    if f.decl.params.is_empty() then return Some(TEntry(key, None, reporter, fallible))

    // The one parameter a platform can fill: the program's arguments, which the library reads.
    // Written either way: the arguments are the platform's and a program that only reads them may
    // say so, since the two views are one layout.
    val first = resolve_type(a, f.scope, f.decl.params.at(0).typ, no_bindings())
    val args_fn = a_library_key(a, "args_of")

    if f.decl.params.len() == 1 && takes_args(first)
        if args_fn.is_none() then return Some(TEntry(key, None, reporter, fallible))

        a.uses(args_fn.unwrap())

        return Some(TEntry(key, args_fn, reporter, fallible))
    end if

    a.fault(f.scope, f.span, "'main' takes either nothing or one '[]string' of the program's " +
            s"arguments, not (${entry_params(a, f)})")

    None
end declared_entry

// What a `main` declares that the platform cannot fill, as the refusal names them.
private entry_params(a: &Analysis, f: Func) -> string
    var out = ""

    for i in 0..<f.decl.params.len()
        val t = resolve_type(a, f.scope, f.decl.params.at(i).typ, no_bindings())

        out = out + (if i > 0 then ", " else "") + type_show(t)

    out
end entry_params

// Whether a parameter is the `[]string` a platform fills with the program's arguments.
private takes_args(t: Type) -> bool = t match
    Slice(elem, _) -> *elem match
        Str -> true
        _ -> false
    _ -> false

// The `Result[unit, E]` a fallible entry answers with, where that is what it answers with.
private result_entry(a: &Analysis, ret: Type) -> Option[Type] = ret match
    Enum(d) ->
        if d.base == library_key("Result") && !d.targs.is_empty() && no_value(d.targs.at(0)) then
            Some(ret)
        else None
    _ -> None

// The library function an entry's failure is reported through, instantiated at what the entry
// carries. It is a function the program never wrote, so reaching it is recorded here.
private entry_reporter(a: &Analysis, fallible: Option[Type]) -> Option[string]
    if fallible.is_none() then return None

    val key = a_library_key(a, "main_result")

    if key.is_none() then return None

    fallible.unwrap() match
        Enum(d) ->
            if d.targs.len() < 2 then return None

            val f = a.tables.funcs.get(key.unwrap())

            if f.is_none() then return None

            var targs: Buf[Type] = buf()

            targs.push(d.targs.at(1))

            val sym = instantiate_func(a, f.unwrap().scope, f.unwrap().decl, targs, false)

            a.uses(sym)
            Some(sym)
        _ -> None
end entry_reporter

// The key the library files one of its own names under, looked up rather than composed.
private a_library_key(a: &Analysis, name: string) -> Option[string]
    val direct = module_qualify(StdModule, name)

    if a.tables.funcs.has(direct) then return Some(direct)

    for i in 0..<a.tables.funcs.len()
        val key = a.tables.funcs.key_at(i)
        val bare = library_spelling(key)

        if bare.is_some() && bare.unwrap() == name then return Some(key)

    None
end a_library_key

// Everything one compilation amounts to, once every body it reaches has been typed.
program_of(done: TypedBodies, main_module: string) -> TProgram
    val a = done.an

    TProgram(reached_structs(a), reached_enums(a), reached_vtables(a), reached_externs(a),
             done.vals, emitted_funcs(done.funcs), done.main, done.entry, buf(), true, false,
             no_alloc_modules(done.units, false), no_alloc_modules(done.units, true), main_module,
             declared_tests(done), declared_hooks(done), buf(),
             a.tables.test_only, destructors_of(a), a.warnings(), a.tables.module_deps)
end program_of

// Every type this compilation made real that has a destructor, paired with the symbol of it.
//
// **Asked of the INSTANTIATED types rather than of the `impl` blocks**, because a block for a
// generic type is one block covering a family and the hook is a function per concrete payload. A
// type the program never made needs no entry: nothing can release a box of it.
private destructors_of(a: &Analysis) -> Buf[(string, string)]
    val drops = drops_declared(a)
    var out: Buf[(string, string)] = buf()

    if drops.is_empty() then return out

    val made = reached_structs(a)
    val enums = reached_enums(a)

    for i in 0..<made.len()
        push_destructor(a, drops, &out, made.at(i))

    for i in 0..<enums.len()
        push_destructor(a, drops, &out, enums.at(i))

    out
end destructors_of

private push_destructor(a: &Analysis, drops: Buf[string], out: *Buf[(string, string)], t: Type)
    val owner = owner_key(t)

    if !holds_string(drops, owner) then return

    val filed = a.tables.members.funcs.get(member_key_of(owner, "drop"))

    out.push((mangle(t), filed.unwrap_or(s"${member_symbol(t)}.drop")))
end push_destructor

// The bodies a program **emits**, which is the question a printed tree answers.
//
// An instantiation at a **type parameter** is a diagnostic shape rather than a laid-out one: the
// walk that reads a generic body once at its own definition builds one, and no value at run time has
// that type. It has no layout to emit, so it is left out here rather than reaching a back end that
// would have to invent one.
private emitted_funcs(funcs: Buf[TFunc]) -> Buf[TFunc]
    var out: Buf[TFunc] = buf()

    for i in 0..<funcs.len()
        if emitted_shape(funcs.at(i)) then out.push(funcs.at(i))

    out
end emitted_funcs

private emitted_shape(f: TFunc) -> bool
    for i in 0..<f.params.len()
        if mentions_abstract(f.params.at(i).1) then return false

    !mentions_abstract(f.ret_ty)
end emitted_shape

// The struct types a program laid out, in the order they were made real. One made at a type
// parameter names the family a generic covers rather than a type, so nothing has that layout.
reached_structs(a: &Analysis) -> Buf[Type]
    var out: Buf[Type] = buf()

    for i in 0..<a.tables.struct_insts.len()
        val t = a.tables.struct_insts.at(i)

        if !instantiated_abstract(t) then out.push(t)

    out
end reached_structs

// The enums, on the same terms, less the **simple** ones: an enum with nothing in any variant is its
// underlying integer and has no layout of its own to record.
reached_enums(a: &Analysis) -> Buf[Type]
    var out: Buf[Type] = buf()

    for i in 0..<a.tables.enum_insts.len()
        val t = a.tables.enum_insts.at(i)
        val simple = t match
            Enum(d) -> d.simple
            _ -> false

        if !simple && !instantiated_abstract(t) then out.push(t)

    out
end reached_enums

// Whether a named type was made real at something that is not a type -- a parameter standing in for
// itself while a generic body was read at its own definition, or a type nothing settled.
//
// **The second is as much "not a type" as the first**, and leaving it out put a hundred layouts in
// a program's list that no value has: reading a generic container's body at its own definition can
// leave a parameter as `Unknown` rather than as itself, and the `Buf[?]`, `Map[?, bool]` and
// `Option[?]` that came of it were recorded as instantiations. The reference compiler's list holds
// neither kind.
private instantiated_abstract(t: Type) -> bool = t match
    Struct(d) -> any_stands_in(d.targs)
    Enum(d) -> any_stands_in(d.targs)
    _ -> false

private any_stands_in(ts: Buf[Type]) -> bool
    for i in 0..<ts.len()
        if mentions_abstract(ts.at(i)) || mentions_unknown(ts.at(i)) then return true

    false
end any_stands_in

reached_vtables(a: &Analysis) -> Buf[TVtable]
    var out: Buf[TVtable] = buf()

    for i in 0..<a.tables.members.vtables.len()
        out.push(a.tables.members.vtables.at(i))

    out
end reached_vtables

// The `extern` functions a program calls, with their signatures as the tables resolved them. An
// `extern` nothing reaches is a declaration and not a link.
reached_externs(a: &Analysis) -> Buf[TExtern]
    var out: Buf[TExtern] = buf()

    // In the order the **calls** reached them, which is not the order they were written: a call
    // records the extern it is about to make before it analyzes its arguments, so `take(give())`
    // declares `take` first.
    val used = a.externs_used()

    for i in 0..<used.len()
        val key = used.at(i)
        val d = a.tables.externs.get(key)

        if d.is_some()
            val scope = extern_home(a, key)
            var params: Buf[Type] = buf()

            for j in 0..<d.unwrap().params.len()
                params.push(resolve_type(a, scope, d.unwrap().params.at(j).typ, no_bindings()))

            var ret = Unit

            if d.unwrap().ret_type.is_some() then
                ret = resolve_type(a, scope, d.unwrap().ret_type.unwrap(), no_bindings())

            out.push(TExtern(key, extern_symbol(d.unwrap()), params, ret, d.unwrap().variadic))

    out
end reached_externs


// The file an `extern` was written in, which is where the types in its signature mean what they
// meant.
private extern_home(a: &Analysis, key: string) -> Scope =
    a.tables.extern_scopes.get(key).unwrap_or(empty_scope())

// The `@test` functions the sources declared, in the order they were written, each carrying the
// hooks its own module declared.
//
// **Only the ones whose bodies survived analysis.** A test that was reported is not one a runner
// could run, and listing it would put a name in the report that no dispatcher arm matches -- which
// reads as a test that vanished rather than as the error already printed.
private declared_tests(done: TypedBodies) -> Buf[TTest]
    val hooks = declared_hooks(done)
    var out: Buf[TTest] = buf()

    for i in 0..<done.units.len()
        val unit = done.units.at(i)
        val scope = scope_of_unit(unit)

        for j in 0..<unit.body.len()
            val s = unit.body.at(j)

            *s.kind match
                FuncDecl(written) ->
                    val d = with_call_bounds(written)

                    if d.test.is_some() && d.tparams.is_empty()
                        val key = func_key(done.an, scope, s.span, d)
                        val attr = d.test.unwrap()

                        if analyzed_body(done.funcs, key)
                            out.push(TTest(key, attr.display.unwrap_or(module_bare(key)),
                                           attr.should_trap, attr.expected, unit.src.name,
                                           int(unit.src.locate(attr.span.start).line),
                                           module_hooks(hooks, module_of(key))))
                _ -> ()

    out
end declared_tests

// The hooks every module declared, on the same terms.
private declared_hooks(done: TypedBodies) -> Buf[THook]
    var out: Buf[THook] = buf()

    for i in 0..<done.units.len()
        val unit = done.units.at(i)
        val scope = scope_of_unit(unit)

        for j in 0..<unit.body.len()
            val s = unit.body.at(j)

            *s.kind match
                FuncDecl(written) ->
                    val d = with_call_bounds(written)

                    if d.hook.is_some() && d.tparams.is_empty()
                        val key = func_key(done.an, scope, s.span, d)
                        val attr = d.hook.unwrap()

                        if analyzed_body(done.funcs, key)
                            out.push(THook(attr.kind, key, unit.src.name,
                                           int(unit.src.locate(attr.span.start).line)))
                _ -> ()

    out
end declared_hooks

// Every test is handed its own module's hooks, which is what lets a runner work from a list of tests
// alone -- a cached suite arrives with no program behind it at all.
private module_hooks(hooks: Buf[THook], module_name: string) -> THooks
    var mine: Buf[THook] = buf()

    for i in 0..<hooks.len()
        if module_of(hooks.at(i).func) == module_name then mine.push(hooks.at(i))

    hooks_of(mine)
end module_hooks

private analyzed_body(funcs: Buf[TFunc], name: string) -> bool
    for i in 0..<funcs.len()
        if funcs.at(i).name == name then return true

    false
end analyzed_body

// The modules that gave the allocator up, and the same asked of what each module's TESTS may do --
// two lists, because a `@tests` file may take the allocator back for the scaffolding alone.
//
// **A module's clauses are read off the first file that ships it**, since the header is one
// statement about the module however many files repeat it, and a test file's clause is an override
// rather than a second opinion.
private no_alloc_modules(units: Buf[Program], for_tests: bool) -> Buf[string]
    var named: Buf[string] = buf()
    var out: Buf[string] = buf()

    for i in 0..<units.len()
        val unit = units.at(i)
        val module_name = module_of_unit(unit)

        if module_name != "" && !holds_string(named, module_name)
            val clauses = module_clauses(units, module_name, for_tests)

            named.push(module_name)

            if gives_up_heap(clauses) then out.push(module_name)

    out
end no_alloc_modules

// The clauses a module is held to: its own, or -- on the test side, where its `@tests` file says
// anything at all about a capability -- that file's instead.
private module_clauses(units: Buf[Program], module_name: string,
                       for_tests: bool) -> Buf[CapabilityClause]
    var mine: Buf[CapabilityClause] = buf()
    var theirs: Buf[CapabilityClause] = buf()
    var found_mine = false
    var found_theirs = false

    for i in 0..<units.len()
        val unit = units.at(i)

        if module_of_unit(unit) == module_name && !unit.capabilities.is_empty()
            if unit.test_only
                if !found_theirs
                    theirs = unit.capabilities
                    found_theirs = true
            else if !found_mine
                mine = unit.capabilities
                found_mine = true

    if for_tests && found_theirs then theirs else mine
end module_clauses

// Whether a module's clauses give up the allocator. `no alloc` is the word a module writes for it.
private gives_up_heap(clauses: Buf[CapabilityClause]) -> bool
    for i in 0..<clauses.len()
        val c = clauses.at(i)
        val narrows = c.direction match
            Narrows -> true
            Requires -> false

        if narrows && c.name == "alloc" then return true

    false
end gives_up_heap
