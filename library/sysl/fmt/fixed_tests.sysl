module sysl.fmt
@tests

import sysl.buf.byte_sink
import sysl.text.from_utf8_unchecked

// A fixed-point value under a printf float conversion, rendered from its raw integer. Two oracles: the
// host's own `snprintf` (`float_tests.sysl`'s `c_format`) for every format whose values a `double`
// holds exactly -- 53 bits or fewer -- and, past that, the exact decimal expansion worked out by
// Python's `decimal` module at 400 digits, rounded half to even, beside what the value's nearest
// `double` would have printed, so each of those cases is one a rendering through `real` gets wrong.

// `raw · 2^-frac` as a `real`, exact for a raw integer of 53 bits or fewer.
private scaled(raw: long, frac: int) -> real
    var x = real(raw)

    for _ in 0..<frac
        x *= 0.5

    x
end scaled

// A deterministic stream of 64-bit patterns (xorshift64*).
private struct Draws
    state: u64

    next(*self) -> u64
        self.state ^= self.state >> 12
        self.state ^= self.state << 25
        self.state ^= self.state >> 27
        self.state *% 0x2545f4914f6cdd1d
end Draws

// A raw integer of `bits` bits drawn from `g`, sign-extended where the format is signed.
private draw(g: *Draws, bits: int, signed: bool) -> long
    val m = g.next() & ((u64(1) << bits) - 1)

    if signed && m >= u64(1) << (bits - 1) then long(m) - (long(1) << bits) else long(m)

@test("a fixed-point value renders as C renders the same exact double, under every float conversion")
ffx_matches_c_where_a_double_is_exact()
    val formats: [8](int, int, bool) = [(8, 7, true), (16, 15, true), (32, 31, true), (16, 16, false),
                                         (32, 16, true), (32, 32, false), (48, 20, true), (24, 3, false)]
    val specs = ["%f", "%.0f", "%.10f", "%e", "%.3e", "%g", "%.12g", "%+12.4f", "%-12.4f", "%012.4f",
                 "%#.0f", "% f", "%E", "%G", "%.30f", "%#g", "%+.0e", "%-+14.6e"]
    var g = Draws(0x9e3779b97f4a7c15)
    var bad = 0
    var said = ""

    for fmt in formats
        val lo = if fmt.2 then -(long(1) << (fmt.0 - 1)) else long(0)
        val hi = if fmt.2 then (long(1) << (fmt.0 - 1)) - 1 else (long(1) << fmt.0) - 1

        for i in 0..<400
            val raw = if i == 0 then lo else if i == 1 then hi else if i == 2 then 0
            else if i == 3 then 1 else if i == 4 && fmt.2 then -1 else draw(&g, fmt.0, fmt.2)

            for spec in specs
                val want = c_format(scaled(raw, fmt.1), spec)
                val got = format_fixed(i128(raw), fmt.0, fmt.2, fmt.1, spec, 0, -1)

                if got != want
                    bad += 1

                    if bad <= 5 then said = said + s"[${fmt.0}q${fmt.1} raw $raw $spec: C '$want', '$got'] "
        end for
    end for

    assert(bad == 0, s"$bad disagreements: $said")
end ffx_matches_c_where_a_double_is_exact

@test("a tie is rounded half to even on the exact value")
ffx_ties_go_to_even()
    assert_eq(format_fixed(5, 8, false, 1, "%.0f", 0, -1), "2")
    assert_eq(format_fixed(7, 8, false, 1, "%.0f", 0, -1), "4")
    assert_eq(format_fixed(-5, 8, true, 1, "%.0f", 0, -1), "-2")
    assert_eq(format_fixed(1, 16, true, 15, "%.14f", 0, -1), "0.00003051757812")
    assert_eq(format_fixed(3, 16, true, 15, "%.14f", 0, -1), "0.00009155273438")
end ffx_ties_go_to_even

@test("a format past a double's 53 bits prints its exact digits, not its nearest double's")
ffx_wide_formats_are_exact()
    // 0.1 at i64q60 is 115292150460684698 units; its nearest double prints 0.1000000000000000055511151.
    val tenth: i128 = 115292150460684698

    assert_eq(format_fixed(tenth, 64, true, 60, "%.25f", 0, -1), "0.1000000000000000003469447")
    assert_eq(format_fixed(tenth, 64, true, 60, "%.20e", 0, -1), "1.00000000000000000347e-01")

    // q63's largest value is 1 - 2^-63; a double rounds it to 1.
    assert_eq(format_fixed(i128(i64::Max), 64, true, 63, "%.25f", 0, -1), "0.9999999999999999998915798")
    assert_eq(format_fixed(i128(i64::Min), 64, true, 63, "%.3f", 0, -1), "-1.000")

    // u64q64's largest is 1 - 2^-64, and u128q64's 2^64 - 2^-64 -- a u128 above i128's maximum
    // arriving as its two's complement.
    assert_eq(format_fixed(i128(u64::Max), 64, false, 64, "%.22f", 0, -1), "0.9999999999999999999458")
    assert_eq(format_fixed(-1, 128, false, 64, "%.22f", 0, -1),
              "18446744073709551615.9999999999999999999458")

    // A 128-bit format, at both ends and at its smallest unit.
    assert_eq(format_fixed(i128::Min, 128, true, 100, "%.12e", 0, -1), "-1.342177280000e+08")
    assert_eq(format_fixed(i128::Max, 128, true, 100, "%.35f", 0, -1),
              "134217727.99999999999999999999999999999921114")
    assert_eq(format_fixed(1, 128, true, 120, "%.40e", 0, -1),
              "7.5231638452626400509999138382223723380395e-37")
end ffx_wide_formats_are_exact

@test("a width and a precision read through '*' place a fixed-point field as a float's")
ffx_counts_read_through_stars()
    assert_eq(format_fixed(16384, 16, true, 15, "%*.*f", 9, 3), "    0.500")
    assert_eq(format_fixed(16384, 16, true, 15, "%*.*f", -9, 3), "0.500    ")
    assert_eq(format_fixed(16384, 16, true, 15, "%.*f", 0, -4), "0.500000")
    assert_eq(format_fixed(0, 16, true, 15, "%+08.2f", 0, -1), "+0000.00")
end ffx_counts_read_through_stars

// What `write_fixed` wrote, or the refusal it answered.
private wrote(raw: i128, bits: int, signed: bool, frac: int, spec: string, room: usize = 800) -> string
    var sink = byte_sink()
    var scratch: [800]u8

    write_fixed(raw, bits, signed, frac, &sink, spec, 0, -1, scratch[0..<room]) match
        Ok(_) -> from_utf8_unchecked(sink.text())
        Err(why) -> s"refused: $why, wrote '${from_utf8_unchecked(sink.text())}'"
end wrote

@test("write_fixed writes what format_fixed answers, and refuses a short scratch or a non-float spec")
ffx_write_fixed()
    assert_eq(wrote(i128(i32::Max), 32, true, 31, "%.12f"), "0.999999999534")
    assert_eq(wrote(i128(i64::Max), 64, true, 63, "%.25f"), "0.9999999999999999998915798")
    assert_eq(wrote(-1, 128, false, 64, "%.22f", float_scratch_len),
              "18446744073709551615.9999999999999999999458")
    assert_eq(wrote(i128(i64::Max), 64, true, 63, "%.25f", 3), "refused: the scratch needs 27 bytes, wrote ''")
    assert_eq(wrote(5, 8, true, 7, "%d"), "refused: not a float conversion, wrote ''")
    assert_eq(wrote(0, 16, true, 15, "%e", 0), "0.000000e+00")
end ffx_write_fixed
