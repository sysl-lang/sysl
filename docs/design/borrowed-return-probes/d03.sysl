// Leaving from the middle: an early `return` and a `break` out of a loop body. Today each block runs
// its defers, then its releases, innermost first.
struct Noisy
    name: string

impl Drop for Noisy
    drop(self) = print("drop " + self.name)

run(stop: bool) -> int
    val a: &Noisy = Noisy("a")
    defer print("defer outer")

    for i in 0..<3
        val b: &Noisy = Noisy(s"b$i")
        defer print("defer loop")
        val c: &Noisy = Noisy(s"c$i")

        if i == 1 then break
        if stop then return i

    print("after loop " + a.name)
    0

run(false)
print("--")
run(true)
