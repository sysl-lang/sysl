module sh.sysl.compiler
@tests

import sysl.text.Search
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture

// Coverage computed through NESTED patterns (`reference/patterns.md § Exhaustiveness`): arms cover a
// type together, so `Some(Halt)`, `Some(Push)` and `None` cover an `Option[Op]` between them, while
// `Some(0)` still does not discharge `Some`, the values a literal leaves behind having no name. What is
// missing is named at the depth it is missing, and an accepted match leaves an `unreachable`
// fallthrough, so a match wrongly accepted would miscompile rather than mis-diagnose.
//
// **Every output, message and location here was read out of the reference compiler** (0.0.157) on
// the same program.

// -- the harness ----------------------------------------------------------------------------------

private ncv_skip() -> bool
    if std_root().is_err()
        print("skipped: the standard module's source is not on this machine")
        return true

    false
end ncv_skip

private ncv_skip_run() -> bool
    if ncv_skip() then return true

    if !clang_available()
        print("skipped: there is no clang on this machine")
        return true

    false
end ncv_skip_run

private ncv_write(main: string) -> string
    val root = make_temp_dir("sysl-ncv").unwrap()

    make_dir_all(root).unwrap()
    write_text(root + "/package.hocon", "package {\n  name = \"probe\"\n}\n").unwrap()
    write_text(root + "/main.sysl", main).unwrap()
    root
end ncv_write

// What the program PRINTS, or what the build had to say about it.
private ncv_ran(main: string) -> string
    val root = ncv_write(main)
    val exe = root + "/built"

    build_native_program(root, None, None, DefaultOptimization, Some(exe)) match
        Err(why) ->
            val said = failure_text(why)

            remove_dir_all(root).unwrap_or(())
            return said
        Ok(_) -> ()

    val said = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    said match
        Err(_) -> "the program that was built could not be run"
        Ok(out) -> out.text
end ncv_ran

// The LLVM text of the program, or everything the analysis had to say about it.
private ncv_report(main: string) -> string
    val root = ncv_write(main)

    val out = emit_llvm_text(root, None) match
        Err(why) -> failure_text(why)
        Ok(made) -> if made.report.is_empty() then made.text else analysis_report(made.report)

    remove_dir_all(root).unwrap_or(())
    out
end ncv_report

// The program is refused with exactly this message, first, at this line and column of `main.sysl`.
private ncv_refused(main: string, message: string, at: string)
    val out = ncv_report(main)
    val first = out.index_of("\n\n") match
        Some(n) -> out[0..<n]
        None -> out

    assert(out.starts_with(s"error: $message\n "), s"expected 'error: $message' first, got: $out")
    assert(first.index_of(s"/main.sysl:$at\n").is_some(), s"expected it first at main.sysl:$at, got: $out")
end ncv_refused

private ncv_prints(main: string, expected: string)
    val out = ncv_ran(main)

    assert(out == expected, s"expected '$expected', got: $out")

// The customer's shape: a two-variant enum inside an `Option`.
private ncv_op() -> string = "enum Op: u8\n    Halt\n    Push\n"

private ncv_pair() -> string = ncv_op() + "struct Pair\n    a: Op\n    b: Op\nend Pair\n"

private ncv_point() -> string = "struct Point\n    x: int\n    y: int\nend Point\n"

// The three arms that cover an `Option[Op]` between them.
private ncv_read_op() -> string =
    "read(o: Option[Op]) -> int\n    o match\n        Some(Halt) -> 0\n        Some(Push) -> 1\n" +
    "        None -> -1\n"

// == what the documents claim =====================================================================

@test("the arms of a nested match cover the type between them")
ncv_nested_arms_cover_between_them()
    if ncv_skip_run() then return

    ncv_prints(ncv_op() + ncv_read_op() +
               "var some: Option[Op] = Some(Push)\nvar halt: Option[Op] = Some(Halt)\n" +
               "var gone: Option[Op] = None\nprint(read(some), read(halt), read(gone))", "1 0 -1\n")

// The complement of one literal has no name to write, so the report names the variant.
@test("a literal sub-pattern still does not discharge its variant")
ncv_literal_does_not_discharge()
    if ncv_skip() then return

    ncv_refused("read(o: Option[int]) -> int\n    o match\n        Some(0) -> 0\n        None -> -1",
                "match on 'sysl.Option[int]' is not exhaustive; missing Some (add an 'else' arm)", "2:5")

@test("a gap inside a payload is named at the depth it is missing")
ncv_gap_named_at_its_depth()
    if ncv_skip() then return

    ncv_refused(ncv_op() + "read(o: Option[Op]) -> int\n    o match\n        Some(Halt) -> 0\n        None -> -1",
                "match on 'sysl.Option[Op]' is not exhaustive; missing Some(Push) (add an 'else' arm)", "5:5")

@test("a flat enum still names every missing variant")
ncv_flat_enum_names_every_missing()
    if ncv_skip() then return

    ncv_refused("enum Shape\n    Circle(r: int)\n    Rect(w: int, h: int)\n    Dot\n" +
                "area(s: Shape) -> int\n    s match\n        Dot -> 0",
                "match on 'Shape' is not exhaustive; missing Circle, Rect (add an 'else' arm)", "6:5")

// A guard is not proof, nested or not (`reference/patterns.md § Guards`).
@test("a guarded arm discharges nothing, nested or not")
ncv_guarded_arm_discharges_nothing()
    if ncv_skip() then return

    ncv_refused(ncv_op() + "read(o: Option[Op], n: int) -> int\n    o match\n" +
                "        Some(Halt) if n > 0 -> 0\n        Some(Push) -> 1\n        None -> -1",
                "match on 'sysl.Option[Op]' is not exhaustive; missing Some(Halt) (add an 'else' arm)", "5:5")

@test("alternatives in one arm cover together")
ncv_alternatives_cover_together()
    if ncv_skip_run() then return

    ncv_prints(ncv_op() + "seen(o: Option[Op]) -> bool\n    o match\n        Some(Halt) | Some(Push) -> true\n" +
               "        None -> false\nvar some: Option[Op] = Some(Push)\nvar gone: Option[Op] = None\n" +
               "print(seen(some), seen(gone))", "true false\n")

@test("a struct nested in a variant covers it")
ncv_struct_in_variant_covers()
    if ncv_skip_run() then return

    ncv_prints(ncv_point() + "sum(o: Option[Point]) -> int\n    o match\n        Some(Point(x, y)) -> x + y\n" +
               "        None -> 0\nvar here: Option[Point] = Some(Point(3, 4))\nvar gone: Option[Point] = None\n" +
               "print(sum(here), sum(gone))", "7 0\n")

@test("a bool payload is covered by its two values")
ncv_bool_payload_covered()
    if ncv_skip_run() then return

    ncv_prints("word(o: Option[bool]) -> string\n    o match\n        Some(true) -> \"yes\"\n" +
               "        Some(false) -> \"no\"\n        None -> \"?\"\nvar t: Option[bool] = Some(true)\n" +
               "var f: Option[bool] = Some(false)\nvar n: Option[bool] = None\nprint(word(t), word(f), word(n))",
               "yes no ?\n")

// A type with no set of values to complete is covered only by a catch-all, and the complaint says
// just that -- no witness list.
@test("a scalar match still needs an else")
ncv_scalar_match_needs_else()
    if ncv_skip() then return

    ncv_refused("var x = 1 match\n    1 -> 10\n    2 -> 20",
                "a 'match' that yields a value must be exhaustive — add an 'else' arm", "1:9")

@test("an enum match for effect is covered by nested arms as well")
ncv_effect_match_covered()
    if ncv_skip_run() then return

    ncv_prints(ncv_op() + "var n = 0\nvar o: Option[Op] = Some(Push)\no match\n    Some(Halt) -> n = 1\n" +
               "    Some(Push) -> n = 2\n    None -> n = 3\nprint(n)", "2\n")

// == what the edges do ============================================================================

@test("coverage reaches through two levels of nesting")
ncv_two_levels_of_nesting()
    if ncv_skip_run() then return

    ncv_prints(ncv_op() + "read(o: Option[Option[Op]]) -> int\n    o match\n        Some(Some(Halt)) -> 0\n" +
               "        Some(Some(Push)) -> 1\n        Some(None) -> 2\n        None -> 3\n" +
               "var deep: Option[Option[Op]] = Some(Some(Push))\nvar mid: Option[Option[Op]] = Some(None)\n" +
               "var out: Option[Option[Op]] = None\nprint(read(deep), read(mid), read(out))", "1 2 3\n")

@test("a gap two levels down is named in full")
ncv_gap_two_levels_down()
    if ncv_skip() then return

    ncv_refused(ncv_op() + "read(o: Option[Option[Op]]) -> int\n    o match\n        Some(Some(Halt)) -> 0\n" +
                "        Some(None) -> 2\n        None -> 3",
                "match on 'sysl.Option[sysl.Option[Op]]' is not exhaustive; missing Some(Some(Push)) " +
                "(add an 'else' arm)", "5:5")

@test("a wildcard sub-pattern covers the rest of a payload")
ncv_wildcard_covers_rest()
    if ncv_skip_run() then return

    ncv_prints("read(o: Option[int]) -> int\n    o match\n        Some(0) -> 100\n        Some(_) -> 1\n" +
               "        None -> -1\nvar z: Option[int] = Some(0)\nvar n: Option[int] = Some(7)\n" +
               "var g: Option[int] = None\nprint(read(z), read(n), read(g))", "100 1 -1\n")

@test("a bound sub-pattern covers as a wildcard does")
ncv_binding_covers()
    if ncv_skip_run() then return

    ncv_prints("read(o: Option[int]) -> int\n    o match\n        Some(n) -> n\n        None -> -1\n" +
               "var s: Option[int] = Some(7)\nprint(read(s))", "7\n")

@test("a struct of enums leaves a gap named in full")
ncv_struct_of_enums_gap()
    if ncv_skip() then return

    ncv_refused(ncv_pair() + "read(p: Pair) -> int\n    p match\n        Pair(Halt, Halt) -> 0\n" +
                "        Pair(Halt, Push) -> 1\n        Pair(Push, Halt) -> 2",
                "match on 'Pair' is not exhaustive; missing Pair(Push, Push) (add an 'else' arm)", "9:5")

@test("a struct of enums is covered by its combinations")
ncv_struct_of_enums_covered()
    if ncv_skip_run() then return

    ncv_prints(ncv_pair() + "read(p: Pair) -> int\n    p match\n        Pair(Halt, Halt) -> 0\n" +
               "        Pair(Halt, Push) -> 1\n        Pair(Push, Halt) -> 2\n        Pair(Push, Push) -> 3\n" +
               "print(read(Pair(Halt, Push)), read(Pair(Push, Push)))", "1 3\n")

@test("a named struct pattern covers the fields it omits")
ncv_named_struct_covers_omitted()
    if ncv_skip_run() then return

    ncv_prints(ncv_pair() + "read(p: Pair) -> int\n    p match\n        Pair{a: Halt} -> 0\n" +
               "        Pair{a: Push} -> 1\nprint(read(Pair(Halt, Push)), read(Pair(Push, Halt)))", "0 1\n")

// Ten variants, one handled: eight named and the cut reported, `J` never reached.
@test("a report long enough to be cut says that it was")
ncv_long_report_says_cut()
    if ncv_skip() then return

    ncv_refused("enum Wide\n    A\n    B\n    C\n    D\n    E\n    F\n    G\n    H\n    I\n    J\n" +
                "read(w: Wide) -> int\n    w match\n        A -> 0",
                "match on 'Wide' is not exhaustive; missing B, C, D, E, F, G, H, I, and more (add an 'else' arm)",
                "13:5")

private ncv_list() -> string = "enum List\n    Empty\n    Cons(head: int, tail: &List)\n"

// A pattern does not reach through a memory mode, so the split ends at the `&List`.
@test("a recursive enum terminates the split")
ncv_recursive_enum_terminates()
    if ncv_skip_run() then return

    ncv_prints(ncv_list() + "len(l: &List) -> int\n    *l match\n        Empty -> 0\n" +
               "        Cons(_, t) -> 1 + len(t)\nvar one: &List = Cons(1, Empty)\n" +
               "var two: &List = Cons(2, one)\nprint(len(two))", "2\n")

@test("a recursive enum with a gap reports it")
ncv_recursive_enum_gap()
    if ncv_skip() then return

    ncv_refused(ncv_list() + "len(l: &List) -> int\n    *l match\n        Empty -> 0",
                "match on 'List' is not exhaustive; missing Cons (add an 'else' arm)", "5:5")

@test("an else beside full coverage is still accepted")
ncv_else_beside_full_coverage()
    if ncv_skip_run() then return

    ncv_prints(ncv_op() + "read(o: Option[Op]) -> int\n    o match\n        Some(Halt) -> 0\n" +
               "        Some(Push) -> 1\n        None -> -1\n        else -2\n" +
               "var s: Option[Op] = Some(Halt)\nprint(read(s))", "0\n")

@test("a one-variant enum is covered by its only variant")
ncv_one_variant_enum()
    if ncv_skip_run() then return

    ncv_prints("enum Only\n    One(n: int)\nread(o: Only) -> int\n    o match\n        One(n) -> n\n" +
               "print(read(One(5)))", "5\n")

@test("a struct scrutinee is covered by destructuring it")
ncv_struct_scrutinee_destructured()
    if ncv_skip_run() then return

    ncv_prints(ncv_point() + "sum(p: Point) -> int\n    p match\n        Point(x, y) -> x + y\n" +
               "print(sum(Point(3, 4)))", "7\n")

// The gap is a number's complement, which has no pattern to name it.
@test("a refutable struct scrutinee still needs an else")
ncv_refutable_struct_needs_else()
    if ncv_skip() then return

    ncv_refused(ncv_point() + "var r = Point(1, 2) match\n    Point(0, 0) -> 1",
                "a 'match' that yields a value must be exhaustive — add an 'else' arm", "5:9")

@test("a bool covering one value keeps its own diagnostic")
ncv_bool_one_value()
    if ncv_skip() then return

    ncv_refused("var x = true match\n    true -> 1",
                "a 'match' on 'bool' that yields a value must cover both 'true' and 'false' — add the missing " +
                "arm or an 'else'", "1:9")

@test("a nested payload of a simple enum narrower than int is covered")
ncv_narrow_simple_enum_payload()
    if ncv_skip_run() then return

    ncv_prints(ncv_op() + "read(o: Option[Op]) -> string\n    Op.try(0u8) match\n        Some(Halt) -> \"halt\"\n" +
               "        Some(Push) -> \"push\"\n        None -> \"?\"\nvar s: Option[Op] = None\nprint(read(s))",
               "halt\n")

// With the arms covering, `read`'s fallthrough after the last arm is `unreachable`.
@test("a fully covered match leaves no reachable fallthrough")
ncv_no_reachable_fallthrough()
    if ncv_skip() then return

    val out = ncv_report(ncv_op() + ncv_read_op() + "var s: Option[Op] = None\nprint(read(s))")
    val lines = lines_of(out)
    var inside = false
    var seen = false

    for line in lines
        if line.starts_with("define")
            inside = line.index_of("@read(").is_some()
        else if inside && line.index_of("unreachable").is_some()
            seen = true

    assert(seen, s"expected 'unreachable' in read's body, got: $out")
end ncv_no_reachable_fallthrough

// A failed guard falls through to the later overlapping arm, which also covers for it.
@test("a failed guard falls through to the arm that covered for it")
ncv_failed_guard_falls_through()
    if ncv_skip_run() then return

    ncv_prints(ncv_op() + "read(o: Option[Op], n: int) -> int\n    o match\n        Some(Halt) if n > 0 -> 100\n" +
               "        Some(Halt) -> 0\n        Some(Push) -> 1\n        None -> -1\n" +
               "var h: Option[Op] = Some(Halt)\nprint(read(h, 1), read(h, 0))", "100 0\n")

@test("a diverging nested arm still covers its case")
ncv_diverging_arm_covers()
    if ncv_skip_run() then return

    ncv_prints(ncv_op() + "read(o: Option[Op]) -> int\n    o match\n        Some(Halt) -> exit(3)\n" +
               "        Some(Push) -> 1\n        None -> -1\nvar p: Option[Op] = Some(Push)\nprint(read(p))", "1\n")

// Dropping the `else` changes which blocks the releases land in; a list rebuilt and walked in a loop
// is what a missing or doubled release shows up as.
@test("a nested match over a counted payload neither leaks nor frees twice")
ncv_counted_payload_balanced()
    if ncv_skip_run() then return

    ncv_prints("struct Node\n    value: int\n    next: Option[&Node]\nend Node\n" +
               "walk(n: Option[&Node], acc: int) -> int\n    n match\n" +
               "        Some(node) -> walk(node.next, acc + node.value)\n        None -> acc\n" +
               "var total = 0\nfor i in 0..<200\n    var head: Option[&Node] = None\n    for j in 1..10 do\n" +
               "        head = Some(Node(j, head))\n    total += walk(head, 0)\nprint(total)", "11000\n")

@test("a Result is covered through its error's variants")
ncv_result_through_error_variants()
    if ncv_skip_run() then return

    ncv_prints("enum Fault\n    Late\n    Lost\ngrade(r: Result[int, Fault]) -> int\n    r match\n" +
               "        Ok(n) -> n\n        Err(Late) -> -1\n        Err(Lost) -> -2\n" +
               "var good: Result[int, Fault] = Ok(7)\nvar late: Result[int, Fault] = Err(Late)\n" +
               "var lost: Result[int, Fault] = Err(Lost)\nprint(grade(good), grade(late), grade(lost))",
               "7 -1 -2\n")

@test("coverage descends through an enum, a struct, and an enum again")
ncv_enum_struct_enum()
    if ncv_skip_run() then return

    ncv_prints(ncv_op() + "struct Step\n    op: Op\n    hot: bool\nend Step\nread(o: Option[Step]) -> int\n" +
               "    o match\n        Some(Step(Halt, true)) -> 0\n        Some(Step(Halt, false)) -> 1\n" +
               "        Some(Step(Push, true)) -> 2\n        Some(Step(Push, false)) -> 3\n        None -> 4\n" +
               "var a: Option[Step] = Some(Step(Push, true))\nvar b: Option[Step] = None\nprint(read(a), read(b))",
               "2 4\n")

// Twenty-six uncovered combinations reported as six shapes: a column no arm narrowed stays a `_`.
@test("a wide product of enums is reported as a minimal set of shapes")
ncv_wide_product_minimal_shapes()
    if ncv_skip() then return

    ncv_refused("enum Dir\n    N\n    E\n    S\nstruct Turn\n    a: Dir\n    b: Dir\n    c: Dir\nend Turn\n" +
                "read(t: Turn) -> int\n    t match\n        Turn(N, N, N) -> 0",
                "match on 'Turn' is not exhaustive; missing Turn(N, N, E), Turn(N, N, S), Turn(N, E, _), " +
                "Turn(N, S, _), Turn(E, _, _), Turn(S, _, _) (add an 'else' arm)", "11:5")

// Inside a generic the payload's type is a parameter, which has no values to list.
@test("a payload of a type parameter is covered by binding it")
ncv_type_parameter_payload()
    if ncv_skip_run() then return

    ncv_prints("first[T](o: Option[T], fallback: T) -> T\n    o match\n        Some(v) -> v\n" +
               "        None -> fallback\nvar n: Option[int] = Some(7)\nvar s: Option[string] = None\n" +
               "print(first(n, 0), first(s, \"-\"))", "7 -\n")

@test("a named struct pattern inside a variant covers it")
ncv_named_struct_in_variant()
    if ncv_skip_run() then return

    ncv_prints(ncv_point() + "side(o: Option[Point]) -> int\n    o match\n        Some(Point{x}) -> x\n" +
               "        None -> -1\nvar here: Option[Point] = Some(Point(3, 4))\nprint(side(here))", "3\n")

@test("a qualified nested variant pattern covers the same case")
ncv_qualified_nested_variant()
    if ncv_skip_run() then return

    ncv_prints(ncv_op() + "read(o: Option[Op]) -> int\n    o match\n        Some(Op.Halt) -> 0\n" +
               "        Some(Push) -> 1\n        None -> -1\nvar h: Option[Op] = Some(Halt)\n" +
               "var p: Option[Op] = Some(Push)\nprint(read(h), read(p))", "0 1\n")

// A `const` in a pattern compares rather than binds, so nested it narrows as `Some(0)` does.
@test("a const in a nested pattern narrows without discharging")
ncv_const_narrows_without_discharging()
    if ncv_skip() then return

    ncv_refused("const Z: int = 0\nread(o: Option[int]) -> int\n    o match\n        Some(Z) -> 0\n        None -> -1",
                "match on 'sysl.Option[int]' is not exhaustive; missing Some (add an 'else' arm)", "3:5")

@test("a zero-sized payload is covered by binding it")
ncv_zero_sized_payload()
    if ncv_skip_run() then return

    ncv_prints("enum Done\n    Fine(u: unit)\n    Late\nread(d: Done) -> int\n    d match\n        Fine(u) -> 1\n" +
               "        Late -> 2\nprint(read(Fine(())), read(Late))", "1 2\n")
