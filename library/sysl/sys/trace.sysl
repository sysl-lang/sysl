module sysl.sys
@no_alloc

/** What the library reads the error return trace with. The trace itself is the C beside this file
 * (`trace.c`); `sysl.debug` is what a program reads it through, and `main_result`, `unwrap`, `expect`
 * and `test_result` report it with `trace_report`.
 *
 * A build with traces off (`error_traces = false`, `--no-error-traces`) answers each of these where
 * it is called, without a call -- no length, no site, nothing to clear or report -- so the C is never
 * linked.
 */
private[sysl] extern "sysl_error_trace_len" trace_len() -> u32
private[sysl] extern "sysl_error_trace_site" trace_site(i: u32) -> *u8
private[sysl] extern "sysl_error_trace_clear" trace_clear()
private[sysl] extern "sysl_error_trace_report" trace_report()
