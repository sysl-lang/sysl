module sh.sysl.compiler
@tests

import sh.sysl.parsing.source_of
import sysl.text.Search

// The reference's `DiagnosticTests` § "a node's anchor and its extent are separate": its nodes carry
// two positions, an ANCHOR a diagnostic is rendered against (a call at its callee, a field selection at
// its member) and an extent, and `emit-ast` prints the anchor. Every node here carries one span, the
// extent -- the open divergence CLAUDE.md names -- so these three wait for an anchor of this tree's
// own. Each asserts what the reference's `emit-ast` prints for the node.

private azd_an_node(text: string, line_start: string) -> string
    val tree = emit_ast(parse(source_of("t.sysl", text)).program, true)

    val all = lines_of(tree)

    for i in 0..<all.len()
        if all.at(i).contains(line_start) then return all.at(i)

    ""
end azd_an_node

@test("a call still points a diagnostic at its callee", ignore: "spans are extents here, the reference's anchor is the open divergence")
azd_an_call_at_its_callee()
    assert(azd_an_node("var x = 1\nprint(alpha)\n", "expr: Call").ends_with("expr: Call 2:1-2:6"))

@test("a field selection points at the member and covers the receiver too", ignore: "spans are extents here, the reference's anchor is the open divergence")
azd_an_field_at_its_member()
    assert(azd_an_node("var p = 1\nprint(p.missing)\n", "expr: Field").ends_with("expr: Field 2:9-2:16"))

@test("a node with no extent of its own falls back to where it points", ignore: "spans are extents here, the reference's anchor is the open divergence")
azd_an_no_extent_falls_back()
    assert(azd_an_node("x\n", "expr: Ident").ends_with("expr: Ident 1:1-1:2"))
