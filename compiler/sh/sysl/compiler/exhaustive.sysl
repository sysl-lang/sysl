module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.math.bigint.{BigInt, cmp, from_int}

// Whether a set of match arms leaves any value unhandled, and if so what one of those values looks
// like.
//
// **The rule is a question about *values***: a match is exhaustive when every value of the
// scrutinee's type is guaranteed handled. Reading a single arm at a time cannot answer that,
// because arms cover a type *together* -- `Some(Halt)`, `Some(Push)` and `None` leave nothing of an
// `Option[Op]` behind even though not one of them covers a variant on its own.
//
// So coverage is computed over all the arms at once, as a matrix: one row per unguarded pattern (an
// arm's alternatives are separate rows, since either may match), one column per value still being
// discriminated. A column whose type has a **known, finite** set of constructors -- an enum's
// variants, a struct's single shape, `bool`'s two values -- is split constructor by constructor,
// each split narrowing the matrix and widening the row by that constructor's fields. A column of
// any other type has no set to complete, so only a wildcard covers it and the rows headed by
// literals or ranges drop out.
//
// The recursion answers with **witnesses**: values the matrix does not match, written the way a
// pattern is, so the diagnostic can name what is missing rather than say only that something is.

// How many witnesses are worth reporting. Nested splits multiply -- a struct of three enums leaves
// a gap for every combination -- so the search stops once there is plainly enough to act on. One
// more than this is computed, which is what lets the report say it stopped.
const WitnessLimit: usize = 8

// A cap on how deep the split descends. Every constructible type is finite -- one that contains
// itself does so through a memory mode, which has no constructor set and therefore ends the descent
// -- so this only ever bounds a diagnostic's precision, never its correctness.
const MaxSplitDepth: int = 12

// One position of a witness.
enum Wit
    // Every value of this position's type is unmatched.
    WitAny

    // Some value is unmatched but not all of them: the column carried literals or ranges, and the
    // complement of a set of literals has no name to write.
    WitUnknown

    WitCtor(name: string, args: Buf[Wit])
end Wit

// A constructor of a closed type: the thing a column is split on.
enum Con
    ConVariant(name: string, tag: BigInt)
    ConWhole

    ConBool(value: bool)

    // A literal or a range, which stands for one value of a type with no finite constructor set. It
    // never equals a constructor a split enumerates, so a row headed by one is dropped from every
    // split -- the conservative direction, and the one the rule already takes when it says
    // `Some(0)` does not discharge `Some`.
    ConOpaque
end Con

// The gap in a match's coverage: the values named the way a pattern is written, and whether those
// names are the whole truth.
//
// A name is **exact** when the split reached the bottom on constructors alone, so the name and the
// gap are the same set of values. Where a column carried literals they are a generalization instead
// -- `Some` stands for "every `Some` but `Some(0)`", which is honest as a to-do list and misleading
// as a pattern to paste in.
struct Gap
    names: Buf[string]
    exact: bool
end Gap

// The gap in a match's coverage, or none where the arms cover the type between them.
//
// A guarded arm is left out: a guard cannot discharge anything, since the compiler cannot prove it
// holds.
coverage_gap(scrut: Type, arms: Buf[TArm]) -> Option[Gap]
    var rows: Buf[Buf[TPattern]] = buf()

    for arm in arms
        if arm.guard.is_none() then
            for j in 0..<arm.patterns.len()
                var row: Buf[TPattern] = buf()

                row.push(arm.patterns.at(j))
                rows.push(row)

    var tys: Buf[Type] = buf()

    tys.push(scrut)

    if covers(rows, tys, 0) then return None

    val ws = witnesses(rows, tys, 0, WitnessLimit + 1)

    if ws.is_empty() then return None

    var names: Buf[string] = buf()
    var exact = true

    for item in ws
        val head = item.at(0)
        val text = wit_show(head)

        if !wit_exact(head) then exact = false

        if !holds_name(names, text) && names.len() <= WitnessLimit then names.push(text)

    Some(Gap(names, exact))
end coverage_gap

private holds_name(names: Buf[string], text: string) -> bool
    for item in names
        if item == text then return true

    false
end holds_name

// How a list of missing values reads in a diagnostic. A list long enough to have been cut off says
// so, rather than presenting a prefix as the whole of what is left to do.
describe_gap(names: Buf[string]) -> string
    val cut = names.len() > WitnessLimit
    var out = ""

    for i in 0..<names.len()
        if i >= WitnessLimit then break

        if i > 0 then out = out + ", "

        out = out + names.at(i)

    if cut then out + ", and more" else out
end describe_gap

// What a witness is called. An argument list that says nothing is left off, so a variant no arm
// mentions reads as `Circle` rather than `Circle(_, _)`, and one that has been narrowed reads as
// `Some(Push)`.
private wit_show(w: Wit) -> string = w match
    WitAny -> "_"
    WitUnknown -> "_"
    WitCtor(name, args) ->
        if all_anonymous(args) then name
        else
            var out = name + "("

            for i in 0..<args.len()
                if i > 0 then out = out + ", "

                out = out + wit_show(args.at(i))

            out + ")"

private all_anonymous(args: Buf[Wit]) -> bool
    for arg in args
        arg match
            WitAny -> ()
            WitUnknown -> ()
            _ -> return false

    true
end all_anonymous

private wit_exact(w: Wit) -> bool = w match
    WitUnknown -> false
    WitAny -> true
    WitCtor(_, args) -> all_exact(args)

private all_exact(args: Buf[Wit]) -> bool
    for arg in args
        if !wit_exact(arg) then return false

    true
end all_exact

// One constructor of a closed type: what it is called, and the types of its fields.
struct Ctor
    con: Con
    name: string
    args: Buf[Type]
end Ctor

// The constructors of a closed type, or none for a type whose values cannot be enumerated.
private space(t: Type) -> Option[Buf[Ctor]] = repr(t) match
    Enum(d) ->
        var out: Buf[Ctor] = buf()

        // A variant whose payload cannot hold a value is never built, so there is nothing for an arm
        // to cover: `Result[int, never]` is covered by `Ok` alone. An arm that names it anyway
        // stays legal, and matches nothing.
        for v in d.variants
            if !uninhabited_fields(v.fields)
                out.push(Ctor(ConVariant(v.name, v.tag), v.name, field_types(v.fields)))

        Some(out)

    Struct(d) ->
        var out: Buf[Ctor] = buf()

        out.push(Ctor(ConWhole, last_segment(module_show(d.base)), field_types(d.fields)))
        Some(out)

    Bool ->
        var out: Buf[Ctor] = buf()

        out.push(Ctor(ConBool(true), "true", buf()))
        out.push(Ctor(ConBool(false), "false", buf()))
        Some(out)

    _ -> None

private field_types(fields: Buf[(string, Type)]) -> Buf[Type]
    var out: Buf[Type] = buf()

    for item in fields
        out.push(item.1)

    out
end field_types

// A pattern with its bindings taken off -- what it *tests for*, which is the only thing coverage is
// about. `n @ Circle(r)` covers exactly what `Circle(r)` covers.
private unbound(p: TPattern) -> TPattern = p match
    TAtPattern(_, inner) -> unbound(*inner)
    _ -> p

// The constructor a pattern tests for, or none where it matches whatever is there.
private head_con(p: TPattern) -> Option[Con] = unbound(p) match
    TWildPattern(_) -> None
    TBindPattern(_, _) -> None
    TVariantPattern(_, v, _) -> Some(ConVariant(v.name, v.tag))
    TStructPattern(_, _) -> Some(ConWhole)
    TLitPattern(value) -> *value.kind match
        TBoolLit(b) -> Some(ConBool(b))
        _ -> Some(ConOpaque)
    _ -> Some(ConOpaque)

private con_eq(a: Con, b: Con) -> bool = a match
    ConVariant(n, t) -> b match
        ConVariant(m, u) -> n == m && t == u
        _ -> false
    ConWhole -> b match
        ConWhole -> true
        _ -> false
    ConBool(x) -> b match
        ConBool(y) -> x == y
        _ -> false
    ConOpaque -> false

// The row a constructor's split leaves behind, or none where the row tests for a different one. A
// wildcard fits every constructor and passes its fields on unconstrained.
private specialize(c: Con, arg_tys: Buf[Type], row: Buf[TPattern]) -> Option[Buf[TPattern]]
    val head = unbound(row.at(0))
    val rest = tail_of(row)

    head match
        TWildPattern(_) -> Some(join_rows(wildcards(arg_tys), rest))
        TBindPattern(_, _) -> Some(join_rows(wildcards(arg_tys), rest))
        TVariantPattern(_, _, args) ->
            if matches_head(head, c) then Some(join_rows(args, rest)) else None
        TStructPattern(_, args) ->
            if con_eq(ConWhole, c) then Some(join_rows(args, rest)) else None
        TLitPattern(_) ->
            if matches_head(head, c) then Some(rest) else None
        _ -> None
end specialize

private matches_head(p: TPattern, c: Con) -> bool
    val h = head_con(p)

    h.is_some() && con_eq(h.unwrap(), c)
end matches_head

private wildcards(tys: Buf[Type]) -> Buf[TPattern]
    var out: Buf[TPattern] = buf()

    for ty in tys
        out.push(TWildPattern(ty))

    out
end wildcards

private join_rows(a: Buf[TPattern], b: Buf[TPattern]) -> Buf[TPattern]
    var out: Buf[TPattern] = buf()

    for item in a
        out.push(item)

    for item in b
        out.push(item)

    out
end join_rows

private tail_of(row: Buf[TPattern]) -> Buf[TPattern]
    var out: Buf[TPattern] = buf()

    for i in 1..<row.len()
        out.push(row.at(i))

    out
end tail_of

private tail_types(tys: Buf[Type]) -> Buf[Type]
    var out: Buf[Type] = buf()

    for i in 1..<tys.len()
        out.push(tys.at(i))

    out
end tail_types

private join_types_list(a: Buf[Type], b: Buf[Type]) -> Buf[Type]
    var out: Buf[Type] = buf()

    for item in a
        out.push(item)

    for item in b
        out.push(item)

    out
end join_types_list

// Whether the rows cover the types between them -- exactly when `witnesses` would answer an empty
// list, split cap included, but without naming anything.
//
// A constructor no row heads is not split on. Every row it keeps is a wildcard row, so its fields
// arrive as wildcard columns, and a wildcard column rules nothing out: all it can change is the
// depth the rest of the columns are read at, since each column read counts toward the split cap.
// Reading deeper only ever takes rows away, so the question for every such constructor at once is
// one question -- the wildcard rows' tails, read at the deepest point any of those constructors
// reaches. That is the default matrix, and it is what keeps a column nobody narrowed from
// multiplying the work by every value of its type.
private covers(rows: Buf[Buf[TPattern]], tys: Buf[Type], depth: int) -> bool
    if tys.is_empty() then return !rows.is_empty()

    if rows.is_empty() then return false

    val rest = tail_types(tys)
    val cons = if depth < MaxSplitDepth then space(tys.at(0)) else None

    if cons.is_none() then return covers(wild_tails(rows), rest, depth + 1)

    val list = cons.unwrap()
    var absent = false
    var reach = -1

    for c in list
        if heads_with(rows, c.con)
            if !covers(narrow(c, rows), join_types_list(c.args, rest), depth + 1) then return false
        else
            absent = true

            if !rest.is_empty()
                val e = seq_end(c.args, depth + 1)

                if e.is_some() && e.unwrap() > reach then reach = e.unwrap()

    if !absent then return true

    val wild = wild_tails(rows)

    if wild.is_empty() then return false

    // With nothing after this column a surviving row is the whole answer; and where every missing
    // constructor has a field with no value at all, a wildcard row is never tested against anything.
    if rest.is_empty() || reach < 0 then return true

    covers(wild, rest, reach)
end covers

// The depth the column after one of type `t` is read at, when `t`'s column holds only wildcards and
// is read at `depth` -- the deepest over every way the split can descend -- or none where every way
// meets a closed type with no constructors, which no value reaches.
private end_of(t: Type, depth: int) -> Option[int]
    val cons = if depth < MaxSplitDepth then space(t) else None

    if cons.is_none() then return Some(depth + 1)

    val list = cons.unwrap()
    var best: Option[int] = None

    for item in list
        val e = seq_end(item.args, depth + 1)

        if e.is_some() && (best.is_none() || e.unwrap() > best.unwrap()) then best = e

    best
end end_of

private seq_end(tys: Buf[Type], depth: int) -> Option[int]
    var at = depth

    for ty in tys
        // Past the cap nothing is split, so no column is empty and every depth reads the same.
        if at >= MaxSplitDepth then return Some(at)

        val e = end_of(ty, at)

        if e.is_none() then return None

        at = e.unwrap()

    Some(at)
end seq_end

// Whether any row is headed by this constructor.
private heads_with(rows: Buf[Buf[TPattern]], c: Con) -> bool
    for item in rows
        if matches_head(item.at(0), c) then return true

    false
end heads_with

// The rows a constructor's split keeps.
private narrow(c: Ctor, rows: Buf[Buf[TPattern]]) -> Buf[Buf[TPattern]]
    var out: Buf[Buf[TPattern]] = buf()

    for item in rows
        val kept = specialize(c.con, c.args, item)

        if kept.is_some() then out.push(kept.unwrap())

    out
end narrow

// The tails of the rows that match whatever heads them -- the default matrix.
private wild_tails(rows: Buf[Buf[TPattern]]) -> Buf[Buf[TPattern]]
    var out: Buf[Buf[TPattern]] = buf()

    for item in rows
        if head_con(item.at(0)).is_none() then out.push(tail_of(item))

    out
end wild_tails

// Witnesses for a matrix: value vectors of the given types that no row matches, the first `room` of
// them in the order the split enumerates. An empty list means the rows cover the types between them.
//
// A constructor whose narrowed matrix `covers` is passed over without descending into it, so the
// search only walks the branches that answer something, and stops once it has `room` answers.
private witnesses(rows: Buf[Buf[TPattern]], tys: Buf[Type], depth: int, room: usize) -> Buf[Buf[Wit]]
    var out: Buf[Buf[Wit]] = buf()

    if tys.is_empty()
        if rows.is_empty() then out.push(buf())

        return out
    end if

    if rows.is_empty()
        var all: Buf[Wit] = buf()

        for i in 0..<tys.len()
            all.push(WitAny)

        out.push(all)
        return out
    end if

    val rest = tail_types(tys)
    val cons = if depth < MaxSplitDepth then space(tys.at(0)) else None

    if cons.is_some()
        val list = cons.unwrap()

        for item in list
            if out.len() >= room then break

            val c = item
            val narrowed = narrow(c, rows)
            val wider = join_types_list(c.args, rest)

            if covers(narrowed, wider, depth + 1) then continue

            val deeper = witnesses(narrowed, wider, depth + 1, room - out.len())

            for j in 0..<deeper.len()
                if out.len() < room then out.push(lift(c.name, c.args.len(), deeper.at(j)))

        return out
    end if

    // Nothing here can be completed by listing, so what survives is the rows that match anything. A
    // column that carried a literal leaves a gap with no name, which is what keeps the diagnostic
    // from claiming the literal's own value is unhandled.
    var gap: Wit = WitAny

    for item in rows
        if head_con(item.at(0)).is_some() then gap = WitUnknown

    val deeper = witnesses(wild_tails(rows), rest, depth + 1, room)

    for item in deeper
        var row: Buf[Wit] = buf()

        row.push(gap)

        for k in 0..<item.len()
            row.push(item.at(k))

        out.push(row)

    out
end witnesses

// The first `n` positions of a witness gathered under the constructor they came from, with the rest
// left where they were.
private lift(name: string, n: usize, w: Buf[Wit]) -> Buf[Wit]
    var args: Buf[Wit] = buf()

    for i in 0..<n
        if i < w.len() then args.push(w.at(i))

    var out: Buf[Wit] = buf()

    out.push(WitCtor(name, args))

    for i in n..<w.len()
        out.push(w.at(i))

    out
end lift

// -- dead arms -------------------------------------------------------------------------------------
//
// **An arm is dead when every value its pattern matches is already matched by the arms above it**,
// which is Rust's `unreachable_patterns` question, asked of the same matrix the coverage question
// is: a pattern is *useful* against the rows before it when some value matches it and none of
// them. Here a useless one is an error rather than a lint.
//
// The answer has to agree with coverage, so a match can always be written that is neither dead nor
// short: a column of an open type -- a number, a string -- is never completed by its literals or
// ranges, so a wildcard after any number of them is never dead, just as no number of them makes
// the match exhaustive. Within that column the literals and ranges are compared as the values they
// are: `3` after `1..5` is dead, and so is `2..7` after `1..4` and `5..9` together.
//
// Only what the compiler can see is known. A pattern that compares against storage -- `` `limit` ``
// naming a `val` -- holds a value nobody knows yet, so it covers nothing below it, and is dead
// only where something above it matches *every* value.

// How deep the usefulness search descends before it gives up and calls the pattern useful: the
// direction that refuses nothing. The pattern being asked about drives the descent, so this bounds
// only a pathological nesting.
const UsefulDepth: int = 64

// One pattern no value can reach: which arm, which of its `|` alternatives, and the earlier arms
// that between them match every value it does. An earlier alternative of the same arm counts as the
// arm itself.
struct DeadPattern
    arm: usize
    alt: usize
    by: Buf[usize]
end DeadPattern

// The patterns of a match's arms that can never match, in source order.
//
// An alternative is read against every alternative of the unguarded arms above it and the
// alternatives before it in its own arm. A guarded arm above covers nothing.
//
// Within a guarded arm the earlier alternatives cover the later ones only when the arm binds no
// name. The guard is asked again for each alternative that matches, with that alternative's
// bindings, so in `Rect(v, _) | Rect(_, v) if v > 10` the second alternative runs whenever the
// first one's `v` failed the guard -- the reference's `(x, _) | (_, x) if x == 42`. With nothing
// bound the guard sees the same thing each time, so `Red | Red if b` is still dead at the second.
dead_patterns(scrut: Type, arms: Buf[TArm], m: FoldMachine) -> Buf[DeadPattern]
    var out: Buf[DeadPattern] = buf()

    for i in 0..<arms.len()
        val arm = arms.at(i)
        var apart = false

        if arm.guard.is_some()
            for alt in arm.patterns
                if pattern_binds(alt) then apart = true

        for j in 0..<arm.patterns.len()
            var owners: Buf[usize] = buf()
            var pats: Buf[TPattern] = buf()

            for k in 0..<i
                if arms.at(k).guard.is_none()
                    for alt in arms.at(k).patterns
                        owners.push(k)
                        pats.push(alt)

            if !apart
                for k in 0..<j
                    owners.push(i)
                    pats.push(arm.patterns.at(k))

            if !useful_among(scrut, owners, pats, buf(), arm.patterns.at(j), m) then
                out.push(DeadPattern(i, j, least_cover(scrut, owners, pats, arm.patterns.at(j), m)))

    out
end dead_patterns

// The alternatives of one `x is A | B` that the ones before them already match, as arm 0.
dead_alternatives(scrut: Type, pats: Buf[TPattern], m: FoldMachine) -> Buf[DeadPattern]
    var out: Buf[DeadPattern] = buf()

    for j in 0..<pats.len()
        var owners: Buf[usize] = buf()
        var earlier: Buf[TPattern] = buf()

        for k in 0..<j
            owners.push(0)
            earlier.push(pats.at(k))

        if !useful_among(scrut, owners, earlier, buf(), pats.at(j), m)
            var by: Buf[usize] = buf()

            by.push(0)
            out.push(DeadPattern(0, j, by))

    out
end dead_alternatives

// Whether `q` is useful against the patterns whose owning arm is not in `without`.
private useful_among(scrut: Type, owners: Buf[usize], pats: Buf[TPattern], without: Buf[usize],
                     q: TPattern, m: FoldMachine) -> bool
    var rows: Buf[Buf[TPattern]] = buf()

    for i in 0..<pats.len()
        if !holds_index(without, owners.at(i))
            var row: Buf[TPattern] = buf()

            row.push(pats.at(i))
            rows.push(row)

    var qs: Buf[TPattern] = buf()
    var tys: Buf[Type] = buf()

    qs.push(q)
    tys.push(scrut)
    useful(rows, qs, tys, 0, m)
end useful_among

// The arms a dead pattern needs: every owner, then each one that can be left out while the pattern
// stays dead is, in order. What is left is a set no member of which is idle -- the arms to point at.
private least_cover(scrut: Type, owners: Buf[usize], pats: Buf[TPattern], q: TPattern,
                    m: FoldMachine) -> Buf[usize]
    var all: Buf[usize] = buf()

    for o in owners
        if !holds_index(all, o) then all.push(o)

    var dropped: Buf[usize] = buf()

    for o in all
        dropped.push(o)

        if useful_among(scrut, owners, pats, dropped, q, m)
            val _ = dropped.pop()

    var out: Buf[usize] = buf()

    for o in all
        if !holds_index(dropped, o) then out.push(o)

    out
end least_cover

private holds_index(xs: Buf[usize], x: usize) -> bool
    for item in xs
        if item == x then return true

    false
end holds_index

// What a pattern in a column of an open type stands for, as far as the compiler can tell.
enum Head
    // A wildcard or a binding.
    HeadAny

    // An integer or a `char` from `lo` to `hi`, both included: a literal is a range of one.
    HeadSpan(lo: BigInt, hi: BigInt)

    HeadText(value: string)

    HeadReal(value: real)

    // A value no one knows while compiling: storage compared against, a float range, an `f128`.
    HeadOpaque
end Head

private scalar_val(p: TPattern, m: FoldMachine) -> Head = unbound(p) match
    TWildPattern(_) -> HeadAny
    TBindPattern(_, _) -> HeadAny
    TLitPattern(t) -> const_fold_typed(t, m) match
        Some(ConstInt(n)) -> HeadSpan(n, n)
        Some(ConstChar(c)) -> HeadSpan(from_int(long(u32(c))), from_int(long(u32(c))))
        Some(ConstStr(s)) -> HeadText(s)
        Some(ConstFloat(r)) -> HeadReal(r)
        _ -> HeadOpaque
    TRangePattern(lo, hi, inclusive) -> range_val(lo, hi, inclusive, m)
    _ -> HeadOpaque

private range_val(lo: TExpr, hi: TExpr, inclusive: bool, m: FoldMachine) -> Head
    val a = int_of(lo, m)
    val b = int_of(hi, m)

    if a.is_none() || b.is_none() then return HeadOpaque

    val top = if inclusive then b.unwrap() else b.unwrap() - from_int(1)

    // An empty range matches nothing, so there is no value for it to be dead or alive about.
    if cmp(a.unwrap(), top) > 0 then HeadOpaque else HeadSpan(a.unwrap(), top)
end range_val

private int_of(t: TExpr, m: FoldMachine) -> Option[BigInt] = const_fold_typed(t, m) match
    Some(ConstInt(n)) -> Some(n)
    Some(ConstChar(c)) -> Some(from_int(long(u32(c))))
    _ -> None

// Whether some value vector of the types matches `q` and none of the rows: Maranget's usefulness,
// over the same splits `covers` makes.
private useful(rows: Buf[Buf[TPattern]], q: Buf[TPattern], tys: Buf[Type], depth: int,
               m: FoldMachine) -> bool
    if tys.is_empty() then return rows.is_empty()
    if rows.is_empty() || depth >= UsefulDepth then return true

    val rest = tail_types(tys)
    val head = unbound(q.at(0))
    val qrest = tail_of(q)
    val cons = space(tys.at(0))

    if cons.is_some() then return useful_closed(cons.unwrap(), rows, head, q, qrest, rest, depth, m)

    scalar_val(head, m) match
        HeadSpan(lo, hi) -> useful_span(rows, lo, hi, qrest, rest, depth, m)
        HeadText(s) -> useful(kept_rows(rows, HeadText(s), m), qrest, rest, depth + 1, m)
        HeadReal(r) -> useful(kept_rows(rows, HeadReal(r), m), qrest, rest, depth + 1, m)

        // A wildcard -- or a value nobody knows, which could be any of them -- is useful where some
        // value no literal names is: and an open type always has one.
        _ -> useful(wild_tails(rows), qrest, rest, depth + 1, m)
end useful

private useful_closed(list: Buf[Ctor], rows: Buf[Buf[TPattern]], head: TPattern, q: Buf[TPattern],
                      qrest: Buf[TPattern], rest: Buf[Type], depth: int, m: FoldMachine) -> bool
    val hc = head_con(head)

    if names_con(hc)
        for c in list
            if con_eq(c.con, hc.unwrap())
                val sq = specialize(c.con, c.args, q).unwrap()

                return useful(narrow(c, rows), sq, join_types_list(c.args, rest), depth + 1, m)

        // A variant whose payload holds no value is matched by nothing, and naming one stays legal.
        return true
    end if

    // A type with no constructor at all has no value for anything to match; the arm is left alone.
    if list.is_empty() then return true

    var complete = true

    for c in list
        if !heads_with(rows, c.con) then complete = false

    if !complete then return useful(wild_tails(rows), qrest, rest, depth + 1, m)

    for c in list
        val sq = join_rows(wildcards(c.args), qrest)

        if useful(narrow(c, rows), sq, join_types_list(c.args, rest), depth + 1, m) then return true

    false
end useful_closed

// Whether a pattern's head names one constructor -- not a wildcard, and not a value nobody knows.
private names_con(hc: Option[Con]) -> bool = hc match
    Some(ConOpaque) -> false
    Some(_) -> true
    None -> false

// A range of integers against the rows: cut where any row's range begins or ends inside it, so
// each piece is wholly inside or wholly outside every row, and ask each piece in turn.
private useful_span(rows: Buf[Buf[TPattern]], lo: BigInt, hi: BigInt, qrest: Buf[TPattern],
                    rest: Buf[Type], depth: int, m: FoldMachine) -> bool
    var cuts: Buf[BigInt] = buf()

    cuts.push(lo)

    for row in rows
        scalar_val(row.at(0), m) match
            HeadSpan(a, b) ->
                if cmp(a, lo) > 0 && cmp(a, hi) <= 0 && !holds_big(cuts, a) then cuts.push(a)

                val after = b + from_int(1)

                if cmp(after, lo) > 0 && cmp(after, hi) <= 0 && !holds_big(cuts, after) then
                    cuts.push(after)
            _ -> ()

    // Each piece starts at a cut, and every row holds all of it or none of it, so its first value
    // speaks for the whole piece.
    for start in cuts
        if useful(kept_rows(rows, HeadSpan(start, start), m), qrest, rest, depth + 1, m) then
            return true

    false
end useful_span

private holds_big(xs: Buf[BigInt], x: BigInt) -> bool
    for item in xs
        if cmp(item, x) == 0 then return true

    false
end holds_big

// The tails of the rows that match the value `v` -- one point of a span, a string, a float.
private kept_rows(rows: Buf[Buf[TPattern]], v: Head, m: FoldMachine) -> Buf[Buf[TPattern]]
    var out: Buf[Buf[TPattern]] = buf()

    for row in rows
        if head_holds(scalar_val(row.at(0), m), v) then out.push(tail_of(row))

    out
end kept_rows

private head_holds(row: Head, v: Head) -> bool = row match
    HeadAny -> true
    HeadSpan(a, b) -> v match
        HeadSpan(x, _) -> cmp(a, x) <= 0 && cmp(x, b) <= 0
        _ -> false
    HeadText(s) -> v match
        HeadText(t) -> s == t
        _ -> false
    HeadReal(r) -> v match
        HeadReal(t) -> r == t
        _ -> false
    HeadOpaque -> false
