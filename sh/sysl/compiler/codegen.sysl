module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.text.{str_builder, StrBuilder, Search}

// Lowering a whole program to a module of intermediate representation.
//
// **What is built here is what a program's declarations amount to, plus every body this compiler can
// lower**: the machine it is for, the named types every value of it is stored at, the storage its
// `val`s come to, and the functions.
//
// **A type is defined once per LLVM name.** Two instantiations that mangle to one name are one
// layout -- the only thing mangling collapses is a subtype into the base it is stored as -- and
// defining it twice is a module the back end refuses rather than one it chooses for.
//
// **A body that reaches a form nothing lowers yet is left out rather than approximated.** What a
// partial lowering owes the differential proof is that everything it does say is what the reference
// says; a body it cannot finish is a smaller module, and the census beside the module is the list of
// them.

// The module a program lowers to.
codegen_module(p: TProgram, t: Target) -> IrModule
    var e = emitter_for(t, p.destructors)

    codegen_into(&e, p, t, no_promotions()).0
end codegen_module

// The same, with the census of the bodies that were left out beside it: each one's key and the form
// it reached.
codegen_with_gaps(p: TProgram, t: Target, pr: Promotions) -> (IrModule, Buf[(string, string)])
    var e = emitter_for(t, p.destructors)

    codegen_into(&e, p, t, pr)
end codegen_with_gaps

private codegen_into(e: *Emit, p: TProgram, t: Target, pr: Promotions) -> (IrModule, Buf[(string, string)])
    val layout = layout_for(t)
    val word_bits = int(t.pointer_bits())

    record_symbols(e, p)
    set_promotions(e, pr)

    var funcs: Buf[IrFunc] = buf()
    var gaps: Buf[(string, string)] = buf()

    // A `@ghost` function is not emitted at all: nothing executable may call one, and the clauses
    // that may are the ones a body never reaches.
    for i in 0..<p.funcs.len()
        val f = p.funcs.at(i)

        if !f.ghost && !declared_elsewhere(p, f)
            set_promoted(e, pr.for_func(f.name))

            gen_function(e, f) match
                Some(built) -> funcs.push(built)
                None -> gaps.push((f.name, gap_text(e)))

    // The C-callable entry each `@export` publishes, in front of the definition it calls. Every one
    // of them is built after the definitions, which is the order the reference's text has them in.
    //
    // **Only this compilation's own functions get one**: a precompiled function's thunk was emitted
    // into the artifact that defined it, and a second copy here would be the duplicate symbol every
    // other cross-artifact declaration is careful to avoid.
    var thunks: Buf[IrFunc] = buf()

    for i in 0..<p.funcs.len()
        val f = p.funcs.at(i)

        if !f.ghost && f.exported.is_some() && !declared_elsewhere(p, f)
            gen_export_thunk(e, f, symbol_of(e, f.name)) match
                Some(built) -> thunks.push(built)
                None -> gaps.push((s"${f.name} thunk", gap_text(e)))

    // Storage the linker supplies and storage this module lays down, held apart from the two words a
    // `bool` renders as -- which go in front of both and are not known to be needed until the last
    // body has been written.
    var declared_globals: Buf[IrGlobal] = buf()

    for i in 0..<p.extern_vars.len()
        declared_globals.push(ir_extern_global(p.extern_vars.at(i).symbol,
                                               lty(e, p.extern_vars.at(i).ty)))

    val vals = gen_vals(e, p.vals)

    for i in 0..<vals.len()
        declared_globals.push(vals.at(i))

    // A library has no entry point. Emitting one would put a second `main` in every program that
    // linked against it, which the linker reports as a duplicate symbol and nothing else explains.
    // It is built **before** the helpers are, because it is a body like any other and may ask for
    // one.
    var entry: Option[IrFunc] = None

    if p.entry_point
        set_promoted(e, pr.for_func(""))

        val built = if p.tests.is_empty() then gen_main(e, p) else gen_test_main(e, p)

        built match
            Some(f) -> entry = Some(f)
            None -> gaps.push(("main", gap_text(e)))

    // The tables come after the bodies because a table only exists for a type something erased, and
    // it may ask for an adapter, which the drain below is what emits.
    var vtables: Buf[IrGlobal] = buf()

    for i in 0..<p.vtables.len()
        vtables.push(gen_vtable(e, p.vtables.at(i)))

    // Emitting a runtime helper may ask for another -- a destructor releases the references its
    // payload holds -- so this runs until nothing new is requested. **A helper that reaches the
    // allocator asks for the plain hook, and it is asked here rather than at the several places
    // that request one**: every box a helper builds carries a hook that gives its storage back, so
    // reading it off the helper itself keeps that from being a list somebody has to remember.
    var built_helpers: Buf[IrRuntime] = buf()
    var made: usize = 0

    while made < e.queue.len()
        val what = e.queue.at(made)
        val name = e.requested.at(made)

        made += 1

        what match
            HrText(llvm) ->
                if text_allocates(llvm, malloc_symbol()) then plain_drop_fn(e)

                built_helpers.push(RtTemplate(name, llvm))
            _ ->
                gen_helper(e, what, name) match
                    Some(built) ->
                        if allocates(built, malloc_symbol()) then plain_drop_fn(e)

                        built_helpers.push(RtEmitted(built))
                    None -> gaps.push((name, gap_text(e)))

    // The hand-written blocks go in front of the generated ones, and which of them the module needs
    // is settled only once every helper has been written -- a helper is as much a reason to hold the
    // runtime as a body is.
    var helpers = runtime_bundles(e, t)

    for i in 0..<built_helpers.len()
        helpers.push(built_helpers.at(i))

    // The two words a `bool` renders as, laid down once for the whole module and in front of
    // everything else it stores.
    var globals: Buf[IrGlobal] = buf()

    if e.bool_strs
        globals.push(bool_constant("true"))
        globals.push(bool_constant("false"))

    for i in 0..<declared_globals.len()
        globals.push(declared_globals.at(i))

    // The interned strings a helper laid down are in the same list every body's are, so this is
    // read **after** the drain.
    for i in 0..<e.globals.len()
        globals.push(e.globals.at(i))

    for i in 0..<vtables.len()
        globals.push(vtables.at(i))

    val m = IrModule(t.triple, declares(e, p), struct_defs(p, word_bits), enum_defs(p, layout),
                     box_defs(e, word_bits), imported_sigs(e, p), globals, helpers, funcs, thunks,
                     entry, used_of(p, funcs), None)

    (m, gaps)
end codegen_into

// A box is the strong count, the function that destroys it, the weak count, and the payload -- so
// ARC works the same everywhere, and an object frees itself into whichever heap made it. The two
// counts are the machine's word, and must stay in step with `%arc.header`: the runtime reads these
// very fields through that type, so a disagreement is not a type error anywhere, it is a count read
// at the wrong width.
//
// A buffer is the same box with the element count in front of elements there may be any number of,
// so the hook -- which is reached with no static type -- can still find them all.
private box_defs(e: *Emit, word_bits: int) -> Buf[IrTypeDef]
    var out: Buf[IrTypeDef] = buf()

    for i in 0..<e.boxes.len()
        var fields: Buf[LType] = buf()

        fields.push(LInt(word_bits))
        fields.push(LPtr)
        fields.push(LInt(word_bits))
        fields.push(lty(e, e.boxes.at(i).1))
        out.push(IrTypeDef(e.boxes.at(i).0, fields, false))

    for i in 0..<e.bufs.len()
        var fields: Buf[LType] = buf()

        fields.push(LInt(word_bits))
        fields.push(LPtr)
        fields.push(LInt(word_bits))
        fields.push(LInt(word_bits))
        fields.push(LArr(0, lty(e, e.bufs.at(i).1)))
        out.push(IrTypeDef(e.bufs.at(i).0, fields, false))

    out
end box_defs

// The parts of the runtime the module turned out to need, each a hand-written template and so
// reachable to anything that is not LLVM only by name.
private runtime_bundles(e: *Emit, t: Target) -> Buf[IrRuntime]
    var out: Buf[IrRuntime] = buf()

    if e.char_buf then out.push(RtTemplate("sysl.utf8", utf8_encoder()))
    if e.heap then out.push(RtTemplate("arc.core", arc_core(t)))
    if e.sync_heap then out.push(RtTemplate("arc.atomic", arc_atomic(t)))
    if e.maybe_heap then out.push(RtTemplate("arc.maybe", arc_maybe()))
    if e.weak_heap then out.push(RtTemplate("arc.weak", arc_weak(t)))

    out
end runtime_bundles

// One of the two words a `bool` renders as, as the constant a module lays down.
private bool_constant(word: string) -> IrGlobal
    var bytes: Buf[u8] = buf()

    for i in 0..<word.bytes.len
        bytes.push(word.bytes[i])

    bytes.push(u8(0))
    ir_global(s".$word", true, LArr(int(bytes.len()), LInt(8)), VBytes(bytes))
end bool_constant

// The same question `allocates` asks of a generated helper, asked of a hand-written one -- which is
// still text, and still answered by looking for the call in it.
private text_allocates(llvm: string, symbol: string) -> bool =
    llvm.index_of(s"call ptr @$symbol(").is_some()

// Whether a generated helper reaches the allocator, and so needs the hook that gives storage back.
// Its calls are instructions, so the question is whether one of them names the allocating symbol.
private allocates(f: IrFunc, symbol: string) -> bool
    for i in 0..<f.blocks.len()
        val b = f.blocks.at(i)

        for j in 0..<b.instrs.len()
            b.instrs.at(j) match
                InCall(_, _, callee, _, _, _, _, _) ->
                    callee match
                        VGlobal(n) -> if n == symbol then return true
                        _ -> ()
                _ -> ()

    false
end allocates

// Whether a function's body is in an artifact somebody already compiled, so that this module
// declares it rather than defining it a second time -- which would be a duplicate symbol at the
// link.
//
// **An `internal` one is never that, whatever the list says.** Internal linkage is the promise that
// the symbol does not leave the object file, so there is nothing for a declaration of one to resolve
// to and no duplicate for a definition of one to be. A declaration is therefore not the careful
// choice here but the unsound one: it would be satisfied by whatever *other* object file happens to
// define that name, which for a closure -- whose name is a counter in the compilation that lowered
// it -- is a different closure's body under the same signature.
private declared_elsewhere(p: TProgram, f: TFunc) -> bool =
    !f.internal && holds_string(p.precompiled, f.name)

// The declarations a library's already-compiled functions get, in the order the program filed them.
//
// They are **not** up with the `extern`s, and they have to be after the type definitions: a named
// struct used before its `= type` line is opaque at that point, and an opaque type cannot be passed
// by value. Their signatures are built the way the *definition* would have built them rather than
// through the C convention, because these are sysl's convention and not C's -- getting that wrong
// passes arguments the other way, which is a corrupt run rather than a link error.
private imported_sigs(e: *Emit, p: TProgram) -> Buf[IrFuncSig]
    var out: Buf[IrFuncSig] = buf()

    for i in 0..<p.funcs.len()
        val f = p.funcs.at(i)

        if declared_elsewhere(p, f)
            out.push(ir_sig(symbol_of(e, f.name),
                            sysl_fn_type(e, f.ret_ty, f.params, f.variadic, None)))

    out
end imported_sigs

// The symbols this module places by hand and nothing in it reads, which is what keeps a section a
// linker script gathers from being discarded.
private used_of(p: TProgram, funcs: Buf[IrFunc]) -> Option[IrGlobal]
    var names: Buf[string] = buf()

    for i in 0..<p.vals.len()
        if p.vals.at(i).section.is_some() then names.push(p.vals.at(i).symbol)

    for i in 0..<funcs.len()
        if funcs.at(i).sig.section.is_some() then names.push(funcs.at(i).sig.name)

    gen_used(names)
end used_of

private gap_text(e: *Emit) -> string = e.gap match
    Some(w) -> w
    None -> "nothing"

// What a call names, where the key and the emitted symbol are two different things: an `extern` under
// a link name of its own, a definition displaced by an export that claimed its name, and the entry
// point, which is defined under a name of the compiler's.
private record_symbols(e: *Emit, p: TProgram)
    for i in 0..<p.externs.len()
        val x = p.externs.at(i)

        if x.symbol != x.name then e.symbols.push((x.name, x.symbol))

        e.foreigns.push(x.name)

        if x.variadic
            e.variadics.push(x.name)
            e.variadic_types.push((x.name, foreign_signature(e, x.ret_ty, x.params, true)))

    for i in 0..<p.funcs.len()
        val f = p.funcs.at(i)

        f.exported match
            Some(sym) -> e.export_symbols.push((f.name, sym))
            None -> ()

    // **A symbol C has claimed is not available to a sysl definition.** A key is normally
    // `module$name`, which no exported symbol can be -- `$` is not a C identifier character. A
    // function in the **root** module has no such qualification, so its key *is* the bare name, and
    // an export under its own name there claims the very symbol the definition would be emitted
    // under: two definitions of one symbol, which clang reports as an invalid redefinition of a
    // function nobody wrote twice.
    //
    // **Renaming the definition rather than the thunk keeps the promise the right way round**: the
    // exported symbol is the one somebody outside has written down, and a mangled key is this
    // compiler's own business.
    for i in 0..<p.funcs.len()
        val f = p.funcs.at(i)

        if is_displaced(e, f.name) then e.symbols.push((f.name, s"${f.name}${ModuleSep}${ModuleSep}sysl"))

        if f.variadic then e.variadics.push(f.name)

    p.entry match
        Some(en) -> e.symbols.push((en.func, "$$main"))
        None -> ()
end record_symbols

// Whether an export elsewhere in the program has claimed this key as its symbol -- whoever else
// wanted it.
private is_displaced(e: *Emit, name: string) -> bool
    for i in 0..<e.export_symbols.len()
        if e.export_symbols.at(i).1 == name then return true

    false
end is_displaced

// The declarations the module turned out to need: LLVM's own first, then the `extern`s, then the
// intrinsics a body asked for by name.
//
// **An aggregate does not cross to a foreign callee as itself**: the convention the other side was
// compiled against says which registers it arrives in, so that is what the declaration names
// (`emit_foreign.sysl`).
private declares(e: *Emit, p: TProgram) -> Buf[IrFuncSig]
    var out: Buf[IrFuncSig] = buf()

    if e.traps then out.push(ir_sig(llvm_trap(), ir_fn_type(LVoid, no_params())))

    if e.heap
        var alloc_params: Buf[IrParam] = buf()

        alloc_params.push(ir_param(word_lty(e)))
        out.push(ir_sig(malloc_symbol(), ir_fn_type(LPtr, alloc_params)))

        var free_params: Buf[IrParam] = buf()

        free_params.push(ir_param(LPtr))
        out.push(ir_sig(free_symbol(), ir_fn_type(LVoid, free_params)))

    // The two steps a buffer's size is computed in, which are the checked forms and carry their
    // width in the **name** as well as in the signature. They are declared from the flag rather than
    // asked for where they are called, so that they sit here -- among the declarations the module
    // writes for itself -- rather than after the `extern`s a program wrote.
    if e.checked
        val w = word_lty(e)

        var pair_fields: Buf[LType] = buf()

        pair_fields.push(w)
        pair_fields.push(l_i1())

        var overflow_params: Buf[IrParam] = buf()

        overflow_params.push(ir_param(w))
        overflow_params.push(ir_param(w))

        val both = LStruct(pair_fields)

        out.push(ir_sig(llvm_with_overflow("mul", false, w), ir_fn_type(both, overflow_params)))
        out.push(ir_sig(llvm_with_overflow("add", false, w), ir_fn_type(both, overflow_params)))

    // C's own formatting, which a float and a specifier are rendered through. Its size argument is
    // the machine's word rather than eight bytes, and it is open at the end.
    if e.uses_snprintf
        var pr_params: Buf[IrParam] = buf()

        pr_params.push(ir_param(LPtr))
        pr_params.push(ir_param(word_lty(e)))
        pr_params.push(ir_param(LPtr))
        out.push(ir_sig("snprintf", IrFnType(l_i32(), pr_params, true, no_ir_attrs())))

    // The test dispatcher's one dependency, and the only thing in a test build that is not also in
    // an ordinary one. It is declared from the shape of the program rather than from a flag set
    // while emitting, because the entry point is emitted after this list is read.
    if p.entry_point && !p.tests.is_empty()
        var cmp_params: Buf[IrParam] = buf()

        cmp_params.push(ir_param(LPtr))
        cmp_params.push(ir_param(LPtr))
        out.push(ir_sig("strcmp", ir_fn_type(l_i32(), cmp_params)))

    // What the dispatcher tells the runner with, and only where there is a hook for it to say
    // anything about. It is the same primitive the library prints with, at the signature the
    // standard module already binds it at.
    if dispatcher_marks(p)
        var write_params: Buf[IrParam] = buf()

        write_params.push(ir_param(l_i32()))
        write_params.push(ir_param(LPtr))
        write_params.push(ir_param(word_lty(e)))
        out.push(ir_sig("write", ir_fn_type(word_lty(e), write_params)))

    if e.uses_memcpy
        var copy_params: Buf[IrParam] = buf()

        copy_params.push(ir_param(LPtr))
        copy_params.push(ir_param(LPtr))
        copy_params.push(ir_param(LInt(64)))
        copy_params.push(ir_param(l_i1()))
        out.push(ir_sig(memcpy_symbol(), ir_fn_type(LVoid, copy_params)))

    // **A symbol this module has already stated is not stated again**, whether the first statement
    // was a declaration or a definition: LLVM refuses a second `declare` of a name at a signature of
    // its own with `invalid redefinition of function`.
    //
    // The two ways that happens are different and both are here. **An `@export` in this same
    // compilation counts as declaring it**: one module declares a symbol and another defines it, so
    // a library lowered whole lands both, and the definition is the stronger statement to keep -- a
    // caller reaching the `extern` resolves to it exactly as the linker would have. **And an
    // `extern` may name something this module already declares for itself**: the library binds
    // `snprintf` under its own name and a body that renders a float asks for the same symbol, which
    // is one function and must be one line.
    var seen: Buf[string] = buf()

    seen.push(llvm_trap())

    if e.heap
        seen.push(malloc_symbol())
        seen.push(free_symbol())

    if e.uses_snprintf then seen.push("snprintf")

    if p.entry_point && !p.tests.is_empty() then seen.push("strcmp")

    if dispatcher_marks(p) then seen.push("write")

    for i in 0..<p.funcs.len()
        p.funcs.at(i).exported match
            Some(s) -> seen.push(s)
            None -> ()

    for i in 0..<p.externs.len()
        val x = p.externs.at(i)

        if !holds(seen, x.symbol)
            seen.push(x.symbol)
            out.push(ir_sig(x.symbol, foreign_signature(e, x.ret_ty, x.params, x.variadic)))

    for i in 0..<e.sat_decls.len()
        out.push(e.sat_decls.at(i))

    out
end declares

// A whole module as LLVM text, which is what `emit-llvm` prints.
codegen_text(p: TProgram, t: Target) -> string = ir_print_module(codegen_module(p, t))

// The struct definitions, in the order the program made them real and one per LLVM name.
private struct_defs(p: TProgram, word_bits: int) -> Buf[IrTypeDef]
    var out: Buf[IrTypeDef] = buf()
    var seen: Buf[string] = buf()

    for i in 0..<p.structs.len()
        p.structs.at(i) match
            Struct(d) ->
                val name = l_render(struct_lty(d))

                if !holds(seen, name)
                    seen.push(name)

                    struct_type_def(d, word_bits) match
                        Some(def) -> out.push(def)
                        None -> ()
            _ -> ()

    out
end struct_defs

// The enum definitions: each data variant's payload aggregate, and then the enum itself. A simple
// enum is its underlying integer and is not in this list at all.
private enum_defs(p: TProgram, layout: TargetLayout) -> Buf[IrTypeDef]
    var out: Buf[IrTypeDef] = buf()
    var seen: Buf[string] = buf()

    for i in 0..<p.enums.len()
        p.enums.at(i) match
            Enum(d) ->
                val name = l_render(enum_lty(d))

                if !holds(seen, name)
                    seen.push(name)

                    val defs = enum_type_defs(d, layout)

                    for j in 0..<defs.len()
                        out.push(defs.at(j))
            _ -> ()

    out
end enum_defs

private holds(names: Buf[string], name: string) -> bool
    for i in 0..<names.len()
        if names.at(i) == name then return true

    false
end holds

private no_funcs() -> Buf[IrFunc]
    var out: Buf[IrFunc] = buf()

    out
end no_funcs

// -- reading one section back out of a module's text ----------------------------------------------

// The **type definition** lines of a module's LLVM text, in order.
//
// **It is what makes a partial lowering provable.** Two compilers' whole outputs cannot be diffed
// until both lower everything; one section of each can be diffed the moment either builds it, and a
// section is a run of lines told apart by their shape rather than by where they sit. A definition is
// the only line that reads `<name> = type <body>`.
type_def_lines(text: string) -> Buf[string]
    var out: Buf[string] = buf()

    val all = lines_of(text)

    for i in 0..<all.len()
        if is_type_def(all.at(i)) then out.push(all.at(i))

    out
end type_def_lines

private is_type_def(line: string) -> bool
    if line.bytes.len == 0 || line.bytes[0] != u8('%') then return false

    holds_text(line, " = type ")
end is_type_def

// Whether one string holds another.
holds_text(text: string, needle: string) -> bool
    val n = needle.bytes.len

    if n > text.bytes.len then return false

    for i in 0..(text.bytes.len - n)
        if text[i..<(i + n)] == needle then return true

    false
end holds_text

// A text's lines, without the newlines that ended them. A trailing newline ends the last line
// rather than beginning an empty one.
lines_of(text: string) -> Buf[string]
    var out: Buf[string] = buf()
    var start: usize = 0

    for i in 0..<text.bytes.len
        if text.bytes[i] == u8('\n')
            out.push(text[start..<i])
            start = i + 1

    if start < text.bytes.len then out.push(text[start..<text.bytes.len])

    out
end lines_of

// -- the functions of a module's text, for the differential proof ----------------------------------

// Each `define`d function of a module's text, as its symbol and the whole of its body.
//
// **A partial lowering is proved a function at a time**, which is what this makes possible: a body
// this compiler has not built is absent rather than wrong, so a symbol in one text and not in the
// other is a count to drive down, while a symbol in both whose text differs is a defect.
func_texts(text: string) -> Buf[(string, string)]
    var out: Buf[(string, string)] = buf()

    val all = lines_of(text)

    var name = ""
    var body = str_builder()
    var inside = false

    for i in 0..<all.len()
        val line = all.at(i)

        if !inside
            if starts_with_text(line, "define ")
                inside = true
                name = define_symbol(line)
                body = str_builder()
                body.push(line)
                body.push_char('\n')
        else
            body.push(line)
            body.push_char('\n')

            if line == "}"
                inside = false
                out.push((name, body.finish()))

    out
end func_texts

private starts_with_text(line: string, prefix: string) -> bool
    if prefix.bytes.len > line.bytes.len then return false

    line[0..<prefix.bytes.len] == prefix
end starts_with_text

// The symbol a `define` line names, which is the last `@` up to the parenthesis that opens its
// parameter list.
private define_symbol(line: string) -> string
    var at: usize = 0
    var found = false

    for i in 0..<line.bytes.len
        if !found && line.bytes[i] == u8('@')
            at = i + 1
            found = true

    if !found then return ""

    for i in at..<line.bytes.len
        if line.bytes[i] == u8('(') then return line[at..<i]

    line[at..<line.bytes.len]
end define_symbol

// Every symbol a module **calls** and neither defines nor declares.
//
// **A module that names a symbol it never states is one the back end refuses**, in a message counted
// in the lines of generated text rather than in anything a reader wrote. Asking here is what turns
// that into a sentence naming the function -- and for a library artifact it is the difference
// between a diagnostic and an archive that would not assemble.
//
// It is read off the text for the reason `func_texts` is: what a module states is the text it came
// to, and a walk of the representation would be a second answer to hold in step with the first.
undefined_calls(text: string) -> Buf[string]
    var stated: Buf[string] = buf()
    var called: Buf[string] = buf()

    val all = lines_of(text)

    for i in 0..<all.len()
        val line = all.at(i)

        if starts_with_text(line, "define ") || starts_with_text(line, "declare ")
            val name = define_symbol(line)

            if name != "" && !holds(stated, name) then stated.push(name)
        else
            val name = call_symbol(line)

            if name != "" && !holds(called, name) then called.push(name)

    var out: Buf[string] = buf()

    for i in 0..<called.len()
        if !holds(stated, called.at(i)) then out.push(called.at(i))

    out
end undefined_calls

// The symbol a `call` names, which is the `@` after the last `call` on the line up to the
// parenthesis that opens its arguments. A call through a register names no symbol and answers with
// nothing.
private call_symbol(line: string) -> string
    val at = index_of_text(line, "call ")

    if at.is_none() then return ""

    var from = at.unwrap()
    var found = false
    var start: usize = 0

    for i in from..<line.bytes.len
        if !found && line.bytes[i] == u8('@')
            start = i + 1
            found = true

    if !found then return ""

    for i in start..<line.bytes.len
        if line.bytes[i] == u8('(') then return line[start..<i]

    ""
end call_symbol

private index_of_text(line: string, what: string) -> Option[usize]
    if what.bytes.len > line.bytes.len then return None

    for i in 0..<(line.bytes.len - what.bytes.len + 1)
        var same = true

        for k in 0..<what.bytes.len
            if line.bytes[i + k] != what.bytes[k] then same = false

        if same then return Some(i)

    None
end index_of_text

// -- the seams a test asserts on ------------------------------------------------------------------

// One source lowered, and the LLVM text of the function named -- the whole `define` line to the
// brace that closes it, or an empty string where the body was not lowered.
//
// **It is what a lowering test reads**, since what a body becomes is text and nothing about the
// intermediate representation says whether it is the reference's text.
emit_func_text(text: string, symbol: string) -> string
    val done = typed_of(text)

    if !done.reported.is_empty() then return done.reported.at(0).diag.message

    // **Nothing is pruned here**, because a test writes the one body it is about and a walk from a
    // program's roots would drop it before it could be read.
    val p = strip_tests(program_of(done, done.main_module))
    val lowered = codegen_with_gaps(p, done.an.tables.target, check_escapes(done.an, p))
    val fs = func_texts(ir_print_module(lowered.0))

    for i in 0..<fs.len()
        if fs.at(i).0 == symbol then return fs.at(i).1

    ""
end emit_func_text

// One source lowered **for a named machine**, and every `declare` line of the module -- which is
// where a calling convention is written down, since a declaration is the whole of what one side of
// a foreign call agrees to.
//
// The target is a name rather than a row because that is what a command line writes, and an unknown
// one answers with a sentence rather than nothing at all. Every line comes back from one
// compilation, so a test asking about both directions of one shape pays for one.
emit_declare_lines(text: string, target_name: string) -> Buf[string]
    var out: Buf[string] = buf()

    val t = target_named(target_name) match
        Some(row) -> row
        None ->
            out.push(s"no target named '$target_name'")
            return out

    val done = typed_of_target(text, t)

    if !done.reported.is_empty()
        out.push(done.reported.at(0).diag.message)
        return out
    end if

    val p = strip_tests(program_of(done, done.main_module))
    val lowered = codegen_with_gaps(p, t, check_escapes(done.an, p))
    val lines = lines_of(ir_print_module(lowered.0))

    for i in 0..<lines.len()
        if holds_text(lines.at(i), "declare ") then out.push(lines.at(i))

    out
end emit_declare_lines

// One source lowered as a program compiled **against an artifact somebody else built**: the keys
// named are the library's already-compiled half, so the module declares each of them and defines
// neither the body nor the C-callable entry an `@export` on one would have published.
//
// It is the seam the `imports` section is asserted on, since what a declaration says is text and
// nothing about the representation says whether it is the reference's.
emit_imported_text(text: string, precompiled: Buf[string]) -> string
    val done = typed_of(text)

    if !done.reported.is_empty() then return done.reported.at(0).diag.message

    val p = strip_tests(program_of(done, done.main_module))
    val linked = p with { precompiled = precompiled }

    ir_print_module(codegen_with_gaps(linked, done.an.tables.target, check_escapes(done.an, p)).0)
end emit_imported_text

// Why the function named was not lowered, or an empty string where it was.
emit_gap_for(text: string, name: string) -> string
    val done = typed_of(text)

    if !done.reported.is_empty() then return done.reported.at(0).diag.message

    val p = strip_tests(program_of(done, done.main_module))
    val gaps = codegen_with_gaps(p, done.an.tables.target, check_escapes(done.an, p)).1

    for i in 0..<gaps.len()
        if gaps.at(i).0 == name then return gaps.at(i).1

    ""
end emit_gap_for

// The symbols a program is left with once nothing it can reach has been dropped.
emit_kept_funcs(text: string) -> Buf[string] = emit_kept_funcs_in(text, buf())

// The same, for a compilation that names the modules it is answerable for -- which is what a driver
// hands the walk, and what decides whether a root the program did not write counts at all.
emit_kept_funcs_in(text: string, own: Buf[string]) -> Buf[string]
    val done = typed_of(text)

    var out: Buf[string] = buf()

    if !done.reported.is_empty() then return out

    val p = prune(strip_tests(program_of(done, done.main_module)), own)

    for i in 0..<p.funcs.len()
        out.push(p.funcs.at(i).name)

    out
end emit_kept_funcs_in

// What the checks between the analyzer and the lowering refuse, in the order they say it.
//
// **They run on the way to `emit-llvm` and nowhere else**, so a test that asked the ordinary
// analysis seam would be asking a pass that never runs them.
emit_diagnostics(text: string) -> Buf[string]
    val done = typed_of(text)

    var out: Buf[string] = buf()

    if !done.reported.is_empty()
        for i in 0..<done.reported.len()
            out.push(done.reported.at(i).diag.message)

        return out
    end if

    post_analysis_checks(done.an, program_of(done, done.main_module), buf())

    val said = done.an.diagnostics()

    for i in 0..<said.len()
        out.push(said.at(i).diag.message)

    out
end emit_diagnostics
