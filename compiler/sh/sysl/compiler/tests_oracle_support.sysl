module sh.sysl.compiler
@tests

import sysl.env.{get as env_var}
import sysl.fs.{entries, IoError, make_dir_all, make_temp_dir, metadata, read_text, remove_dir_all, write_text}
import sysl.process.{capture, Output, Var}
import sysl.text.{split, Search}

// What the remaining per-test reference checks call to run the reference compiler: the binary
// `SYSL_ORACLE` names, against its own library. The differential sweeps that once lived beside these
// are gone; these stay only until the last caller of them is.

// The library the reference compiles against: what `SYSL_ORACLE_LIB` names, or else the one installed
// beside it, `<prefix>/share/sysl/library` for a reference at `<prefix>/bin/sysl`. Nothing where
// neither is there, which leaves the reference with whatever `SYSL_LIB` this suite was run under.
oracle_library(binary: string) -> Option[string]
    val named = env_var("SYSL_ORACLE_LIB")

    if named.is_some() then return named

    val bin = parent_of(binary)

    if bin.is_none() || basename(bin.unwrap()) != "bin" then return None

    val prefix = parent_of(bin.unwrap())

    if prefix.is_none() then return None

    val installed = s"${prefix.unwrap()}/share/sysl/library"

    if present(s"$installed/sysl") then Some(installed) else None
end oracle_library

/** Runs the reference compiler with `args`, handing back what it printed and how it ended.
 *
 * **Every call of the reference goes through here, so the reference is run against ITS OWN library
 * rather than this compiler's.** This suite runs under the `SYSL_LIB` that names the library in this
 * repository, and a child inherits it; a library edited here would then reach the reference too, and
 * the two compilers would agree about a library neither of them shipped with. `oracle_library` says
 * which one the reference gets, set outright because a child's environment can be added to and never
 * taken from.
 */
capture_oracle(binary: string, args: []const string) -> Result[Output, IoError]
    oracle_library(binary) match
        Some(lib) -> capture(binary, args, "", [Var("SYSL_LIB", lib)], true)
        None -> capture(binary, args, "", [], true)

private present(path: string) -> bool = metadata(path).is_ok()

private is_sysl_source(path: string) -> bool = path.ends_with(".sysl") || path.ends_with(".lsysl")

// A source root holding a copy of every file `scripts/library_patches.tsv` lists that the reference's
// own library has not got -- a module `library/` ADDS rather than changes -- for the reference to
// compile this tree with (`--lib`). Nothing where the reference's library is unknown or nothing is
// added. The caller removes the directory.
//
// **A new FILE is not a new MODULE.** A module's files are its directory's, so a file listed beside
// files the reference's library already has in that directory (`sysl/math/nextafter.sysl` in
// `sysl.math`) adds to a module the reference has -- and the reference refuses a `--lib` root
// declaring a standard module at all. Such a file is left out, as a changed file is.
reference_overlay(binary: string) -> Option[string] = oracle_library(binary) match
    None -> None
    Some(lib) -> reference_overlay_from(lib, "../scripts/library_patches.tsv", "../library")

reference_overlay_from(lib: string, patches: string, library: string) -> Option[string]
    val text = read_text(patches) match
        Err(_) -> return None
        Ok(t) -> t

    val rows = lines_of(text)
    var root: Option[string] = None

    for i in 0..<rows.len()
        val row = rows.at(i)

        if row == "" || row.starts_with("#") then continue

        val file = split(row, "\t")[0]

        if present(s"$lib/$file") || !present(s"$library/$file") then continue

        val dir = parent_of(file).unwrap_or("")

        if dir != "" && holds_sources(s"$lib/$dir") then continue

        if root.is_none() then root = make_temp_dir("sysl-overlay").ok()

        if root.is_none() then return None

        val dest = s"${root.unwrap()}/$file"

        parent_of(dest) match
            Some(dir) -> make_dir_all(dir).unwrap_or(())
            None -> ()

        write_text(dest, read_text(s"$library/$file").unwrap_or("")).unwrap_or(())

    root
end reference_overlay_from

// Whether `dir` holds a source file of its own -- a module lives there -- rather than only the
// directories of the modules nested under it.
private holds_sources(dir: string) -> bool
    val names = entries(dir) match
        Err(_) -> return false
        Ok(n) -> n

    for i in 0..<names.len()
        if is_sysl_source(names.at(i)) then return true

    false
end holds_sources

// -- the reference's source root for this tree ------------------------------------------------------

@test("the reference's overlay holds the modules library/ adds, and none it changes")
rov_the_overlay_holds_only_added_modules()
    val dir = make_temp_dir("sysl-rov").unwrap()
    val lib = s"$dir/theirs"
    val ours = s"$dir/ours"

    make_dir_all(s"$lib/sysl/buf").unwrap()
    write_text(s"$lib/sysl/buf/buf.sysl", "module sysl.buf\n").unwrap()
    make_dir_all(s"$ours/sysl/buf").unwrap()
    make_dir_all(s"$ours/sysl/testing").unwrap()
    write_text(s"$ours/sysl/buf/buf.sysl", "module sysl.buf\n// patched\n").unwrap()
    write_text(s"$ours/sysl/testing/testing.sysl", "module sysl.testing\n").unwrap()
    write_text(s"$dir/patches.tsv", "# a comment\n\nsysl/buf/buf.sysl\tsysl.buf\tchanged\n" +
               "sysl/testing/testing.sysl\tsysl.testing\tadded\n").unwrap()

    val root = reference_overlay_from(lib, s"$dir/patches.tsv", ours)

    assert(root.is_some(), "no overlay was made for an added module")
    assert_eq(read_text(s"${root.unwrap()}/sysl/testing/testing.sysl").unwrap_or(""), "module sysl.testing\n")
    assert(!present(s"${root.unwrap()}/sysl/buf/buf.sysl"), "a changed module reached the reference")
    remove_dir_all(root.unwrap()).unwrap_or(())
    remove_dir_all(dir).unwrap_or(())
end rov_the_overlay_holds_only_added_modules

@test("a new file in a module the reference already has is not overlaid, and a new module beside it is")
rov_a_new_file_in_an_existing_module_is_left_out()
    val dir = make_temp_dir("sysl-rov").unwrap()
    val lib = s"$dir/theirs"
    val ours = s"$dir/ours"

    make_dir_all(s"$lib/sysl/math").unwrap()
    write_text(s"$lib/sysl/math/math.sysl", "module sysl.math\n").unwrap()
    make_dir_all(s"$ours/sysl/math/rational").unwrap()
    write_text(s"$ours/sysl/math/math.sysl", "module sysl.math\n").unwrap()
    write_text(s"$ours/sysl/math/nextafter.sysl", "module sysl.math\n").unwrap()
    write_text(s"$ours/sysl/math/rational/rational.sysl", "module sysl.math.rational\n").unwrap()
    write_text(s"$dir/patches.tsv", "sysl/math/nextafter.sysl\tsysl.math\tnew file\n" +
               "sysl/math/rational/rational.sysl\tsysl.math.rational\tnew module\n").unwrap()

    val root = reference_overlay_from(lib, s"$dir/patches.tsv", ours)

    assert(root.is_some(), "no overlay was made for the added module")
    assert(present(s"${root.unwrap()}/sysl/math/rational/rational.sysl"), "the added module was left out")
    assert(!present(s"${root.unwrap()}/sysl/math/nextafter.sysl"),
           "a file adding to sysl.math reached the reference, which refuses a --lib root declaring it")
    remove_dir_all(root.unwrap()).unwrap_or(())

    write_text(s"$dir/only.tsv", "sysl/math/nextafter.sysl\tsysl.math\tnew file\n").unwrap()
    assert(reference_overlay_from(lib, s"$dir/only.tsv", ours).is_none())
    remove_dir_all(dir).unwrap_or(())
end rov_a_new_file_in_an_existing_module_is_left_out

@test("with nothing added there is no overlay")
rov_nothing_added_is_no_overlay()
    val dir = make_temp_dir("sysl-rov").unwrap()

    make_dir_all(s"$dir/theirs/sysl/buf").unwrap()
    make_dir_all(s"$dir/ours/sysl/buf").unwrap()
    write_text(s"$dir/theirs/sysl/buf/buf.sysl", "module sysl.buf\n").unwrap()
    write_text(s"$dir/ours/sysl/buf/buf.sysl", "module sysl.buf\n").unwrap()
    write_text(s"$dir/patches.tsv", "sysl/buf/buf.sysl\tsysl.buf\tchanged\n").unwrap()

    assert(reference_overlay_from(s"$dir/theirs", s"$dir/patches.tsv", s"$dir/ours").is_none())
    assert(reference_overlay_from(s"$dir/theirs", s"$dir/missing.tsv", s"$dir/ours").is_none())
    remove_dir_all(dir).unwrap_or(())
