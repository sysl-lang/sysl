              "  call void @arc.retain_maybe(ptr %t3)\n" +
              "  %t13 = insertvalue { ptr, ptr, i64 } zeroinitializer, ptr %t3, 0\n" +
              "  %t14 = insertvalue { ptr, ptr, i64 } %t13, ptr %t11, 1\n" +
              "  %t15 = insertvalue { ptr, ptr, i64 } %t14, i64 %t12, 2\n" +
              "  %t16 = extractvalue { ptr, ptr, i64 } %t15, 0\n" +
              "  call void @arc.retain_maybe(ptr %t16)\n" +
              "  %t17 = extractvalue { ptr, ptr, i64 } %t15, 0\n" +
              "  call void @arc.release_maybe(ptr %t17)\n" +
              "  %t18 = load { ptr, ptr, i64 }, ptr %xs.addr\n" +
              "  %t19 = extractvalue { ptr, ptr, i64 } %t18, 0\n" +
              "  call void @arc.release_maybe(ptr %t19)\n" +
              "  ret { ptr, ptr, i64 } %t15\n" +
              "}\n")
