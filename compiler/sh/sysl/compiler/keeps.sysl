module sh.sysl.compiler

import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}
import sysl.container.{Map, map}
import sysl.text.from_utf8_unchecked
// **A borrowed pointer cannot escape** (`reference/memory.md § A borrowed pointer cannot escape`).
//
// `&place` yields a `*T`, and a `*T` is an ordinary type: nothing in it says how long the storage it
// points at lives. What the compiler can see instead is what every function DOES with each pointer it
// is handed, so it works that out once per function and parameter -- the function **keeps** the
// parameter when it lets it outlive the call:
//
// - it stores it somewhere the call does not own: a field reached through a pointer or a reference, a
//   module's storage, a buffer's slot -- which is where a box, a closure and a `Buf` all end up;
// - it passes it to another function's parameter that keeps it.
//
// Handing it back is not keeping it: `field(s: *S) -> *int = &s.x` answers a pointer lent for as long
// as the argument is, and the caller follows that answer as it follows the argument -- and so is
// `address(p: *int) -> usize = usize(p)`, whose integer is the address itself. An integer COMPUTED
// from an address (`usize(p) + 8`) is a number, and keeps nothing.
// The answers are worked out to a fixed point, so a recursive function settles on what its body
// does rather than on an assumption.
//
// **Then one rule, at the call**: the address of storage that is not the program's to give away -- a
// local, a parameter's place, a field of a value in the frame, a value made in place -- may not be
// passed to a parameter that keeps it. Every `*self` method called on a local is checked this way.
//
// **Where no body is visible the answer is a default**: a trait's method borrows its parameters for
// the call, and so does a function pointer or a closure; an `extern` borrows unless its declaration
// says `@keeps(p)`. A default is a promise, so a body that is reached ONLY by way of one -- a method
// a trait object dispatches to, a closure, a function whose address is taken -- is held to it: one
// that keeps what it is handed is refused where it is written.

// Why a function keeps a parameter, once it does: the end of the sentence a refusal quotes, and where
// the body lets the pointer go.
//
// `locs` is every location the parameter may still be held at once the call returns
// (`keeps_flow.sysl`): one through another parameter is the caller's to say, and one through the
// parameter's own pointee -- a node pointing at itself -- is not kept at all, since that storage
// ends exactly when what it points at does. For what a function overwrites on every way out, `locs`
// is those locations instead.
struct KeptWhy
    kept: bool
    how: string
    at: Span
    locs: Buf[KeptAt]

    // What a pass compares, to know whether an answer moved.
    sig(self) -> string
        var out = if self.kept then "1" else "0"

        for item in self.locs
            out = out + ";" + item.loc

        out
    end sig
end KeptWhy

private not_kept() -> KeptWhy = KeptWhy(false, "", span_zero(), buf())

// What a function overwrites, assumed while its own answer is being worked out: everything, which the
// rounds then narrow to what its body really does.
private clears_all() -> KeptWhy
    var locs: Buf[KeptAt] = buf()

    locs.push(KeptAt("*", "", span_zero()))
    KeptWhy(false, "", span_zero(), locs)
end clears_all

// What the walk over a program keeps between bodies.
//
// **The answers are a fixed point.** A function asked about while its own answer is still being
// worked out -- recursion -- is answered with what the last pass settled on, starting from "keeps
// nothing", and every answer that leaned on such an assumption is held open. The open answers are
// worked out again, a component of them at a time (`settle_components`), until a pass changes none
// of them: every walk only turns more of its answer on as the answers it reads grow, so they settle.
struct KeepsCx
    an: &Analysis
    funcs: Buf[TFunc]
    index: Map[string, usize]

    // The answers that rested on nothing assumed, by `<name>|<position>` for what a function keeps and
    // `=<name>|<position>` for what its answer can be made of.
    settled: Map[string, KeptWhy]

    // This round's answers that leaned on an assumption, the last round's, and the keys of the first.
    round: Map[string, KeptWhy]
    prev: Map[string, KeptWhy]
    assumed: Buf[string]

    busy: Buf[string]
    taint: bool

    // How many answers were read while their own question was still being worked out, by the walk
    // under way rather than by any question it worked out on the way (`round_handles`).
    busy_reads: int

    // The bodies a call may reach with no body visible to the caller, so whose parameters are borrowed
    // by rule: the methods a trait object dispatches to, by the trait's key, and the functions whose
    // address is taken.
    dispatched: Map[string, string]
    addressed: Map[string, bool]

    // Every function whose address is taken, by the pointer type it is taken at, and the pointer
    // types C may call through or that are reinterpreted as something else (`note_escape`).
    by_type: Buf[(string, string)]
    escaped: Map[string, bool]

    // The symbols of the variables `extern` declarations name.
    c_vars: Buf[string]

    // Whether a struct or an enum may hold a raw pointer, by its name (`may_hold_pointer`).
    pointerish: Map[string, bool]

    // What each body's locals point into (`keeps_flow.sysl`'s `origins_of`), by function, for the
    // round under way.
    origins: Map[string, &Origins]

    // Where each body binds its thread handles (`keeps_join.sysl`'s `handles_of`), by function, for
    // the round under way, with whether gathering them leaned on this round's answers -- only those
    // every later gathering in the round would find again (`round_handles`).
    handles: Map[string, (&Handles, bool)]

    // Every table the program reaches, which is every body a call through an object may land in.
    vtables: Buf[TVtable]

    // Where the program's integers go, for an address as an integer leaving a frame
    // (`keeps_cast.sysl`).
    casts: &CastGraph

    // The bodies holding an expression that was refused where it was read (`mistaken`), by name.
    mistaken: Map[string, bool]

    // Every open answer read by the walks under way, in order (`leaned_on`); for each answer the first
    // round left open, the open answers its walk read and the question it answers; and for each
    // gathering of origins or handles that read open answers, which ones, by function.
    reads: Buf[string]
    deps: Map[string, Buf[string]]
    questions: Map[string, (string, usize, string)]
    origin_deps: Map[string, Buf[string]]
    handle_deps: Map[string, Buf[string]]
    leaning: Buf[string]

    // While the open answers are settled a component at a time (`settle_components`): the members of
    // the one under way, and whether a walk read an open answer outside it.
    resolving: bool
    members: Map[string, bool]
    strayed: bool

    find(self, name: string) -> Option[TFunc] = self.index.get(name) match
        Some(i) -> Some(self.funcs.at(i))
        None -> None
end KeepsCx

// The refusals the calls are held to, gathered so that each site is told once.
struct KeepFaults
    items: Buf[(Scope, Span, string)]
end KeepFaults

// -- the whole program ----------------------------------------------------------------------------

// Holds every call in the program to the rule, and every body a default promised for to its promise.
check_keeps(a: &Analysis, funcs: Buf[TFunc], vtables: Buf[TVtable], vals: Buf[TVal])
    var index: Map[string, usize] = map()

    for i in 0..<funcs.len()
        if !index.has(funcs.at(i).name) then index.put(funcs.at(i).name, i)

    val cx: &KeepsCx = KeepsCx(a, funcs, index, map(), map(), map(), buf(), buf(), false, 0, map(),
                               map(), buf(), map(), buf(), map(), map(), map(), vtables, cast_graph_new(),
                               map(), buf(), map(), map(), map(), map(), buf(), false, map(), false)

    for i in 0..<a.tables.extern_vars.len()
        cx.c_vars.push(extern_var_symbol(a.tables.extern_vars.at(i)))

    // Every method an `impl` of a trait brought, by the function it was lowered to, and every slot of
    // every table -- an instance of a generic one among them.
    val members = a.tables.members

    for i in 0..<members.from_trait.len()
        val trait_name = members.from_trait.at(i)

        if is_call_trait(module_bare(trait_name)) then continue

        members.funcs.get(members.from_trait.key_at(i)) match
            Some(lowered) -> if !cx.dispatched.has(lowered) then cx.dispatched.put(lowered, trait_name)
            None -> ()

    for vt in vtables
        if is_call_trait(module_bare(vt.trait_name)) then continue

        for slot in vt.slots
            if !cx.dispatched.has(slot.target) then cx.dispatched.put(slot.target, vt.trait_name)

    for f in funcs
        if mistaken(f) then cx.mistaken.put(f.name, true)

        walk_block_stmts(f.body, TWalk(false, e -> note_addressed(cx, e),
                                       w -> if in_c_storage(cx, w.place) then escape_types(cx, texpr_type(w.value), 0),
                                       s -> ()))

        // C calls an exported function with pointers of its own, and gets back what it answers.
        if f.exported.is_some()
            escape_types(cx, f.ret_ty, 0)

            for p in f.params
                escape_types(cx, p.1, 0)
        end if

    // The first round asks every question, and settles every answer that leaned on no assumption.
    // The ones it left open are settled a component at a time, callees first; a walk that strays
    // outside its component -- it read an open answer the first round never saw it lean on -- sends
    // the whole program back to rounds over everything.
    warm_callees_first(cx)

    if !round_settled(cx)
        settle_components(cx)

        if cx.strayed then settle_by_rounds(cx)
    end if

    if explaining_borrows() then note_borrows(cx)

    // The answers a call may read through a place entry (`place_entry.sysl`), handed to the lowering.
    note_places(cx)

    // Each closure literal's capture mode is the same question asked about the literal
    // (`closure_mode.sysl`).
    decide_closure_modes(cx, funcs, vals)

    // **The calls are held to the rule once every answer is settled**, since only those refusals
    // are told. Every question was asked by the warming, so holding the calls reads answers and
    // changes none of them.
    val faults: &KeepFaults = KeepFaults(buf())

    for f in funcs
        check_calls(cx, faults, f)
        check_blocks(cx, faults, f)
        refuse_promised(cx, faults, f)
        refuse_spread(cx, faults, f)

    var said: Buf[Span] = buf()

    for item in faults.items
        var again = false

        // One refusal per site: a pointer kept two ways is refused once, for the first.
        for s in said
            if s == item.1 then again = true

        if again then continue

        said.push(item.1)
        a.fault(item.0, item.1, item.2)
end check_keeps

private note_addressed(cx: &KeepsCx, e: TExpr)
    *e.kind match
        TFuncAddr(name, _, ty) ->
            cx.addressed.put(name, true)

            val key = fn_key(ty)
            var seen = false

            for item in cx.by_type
                if item.0 == key && item.1 == name then seen = true

            if !seen then cx.by_type.push((key, name))
        _ -> ()

    note_escape(cx, e)
end note_addressed

// The type of a function pointer, as the calls through it are matched with the functions it may
// reach, or nothing for any other type.
private fn_key(t: Type) -> string = t match
    CFn(_, _) -> type_show(t)
    _ -> ""

// **A function pointer C can reach may be called with anything**: one handed to a call with no body
// here -- C's, or a form the compiler supplies -- or answered by one, which is storage C made, or
// stored in a variable C declares. A pointer turned into an integer and back is the raw tier's
// bargain, as it is for data: a function is called through the type its address was taken at, and
// calling it through another is undefined in C as it is here.
private note_escape(cx: &KeepsCx, e: TExpr)
    *e.kind match
        TCall(name, args, ty, _) ->
            if cx.find(name).is_none()
                escape_types(cx, ty, 0)

                for a in args
                    escape_types(cx, texpr_type(a), 0)
            end if
        TStore(place, v, _, _) -> if in_c_storage(cx, place) then escape_types(cx, texpr_type(v), 0)
        _ -> ()
end note_escape

// Whether a place is, or is reached through, a variable an `extern` declares.
private in_c_storage(cx: &KeepsCx, place: TExpr) -> bool = *place.kind match
    TGlobal(symbol, _, _) -> holds_string(cx.c_vars, symbol)
    TField(r, _, _) -> in_c_storage(cx, r)
    TIndex(r, _, _) -> in_c_storage(cx, r)
    TDeref(x, _) -> in_c_storage(cx, x)
    TCast(x, _) -> in_c_storage(cx, x)
    _ -> false

// Every function pointer type a value of `t` holds, in place or behind a pointer.
private escape_types(cx: &KeepsCx, t: Type, depth: int)
    if depth > 6 then return

    t match
        CFn(params, ret) ->
            cx.escaped.put(type_show(t), true)

            for p in params
                escape_types(cx, p, depth + 1)

            escape_types(cx, *ret, depth + 1)
        Ptr(inner) -> escape_types(cx, *inner, depth + 1)
        Ref(inner, _) -> escape_types(cx, *inner, depth + 1)
        Volatile(inner) -> escape_types(cx, *inner, depth + 1)
        Array(_, elem) -> escape_types(cx, *elem, depth + 1)
        Slice(elem, _) -> escape_types(cx, *elem, depth + 1)
        Struct(d) ->
            for item in d.fields
                escape_types(cx, item.1, depth + 1)
        Enum(d) ->
            for v in d.variants
                for item in v.fields
                    escape_types(cx, item.1, depth + 1)
        _ -> ()
end escape_types

// **A function whose address is taken only at pointer types C cannot reach answers through its
// body**: every call through such a pointer is in this program, and is held to what each function it
// may reach keeps (`pointer_keeps`). The one thing such a function may keep a pointer it is handed in
// is what another of its parameters points at -- which the call says what it is.
private relays(cx: &KeepsCx, name: string) -> bool
    var any = false

    for item in cx.by_type
        if item.1 != name then continue
        if item.0 == "" || cx.escaped.has(item.0) then return false

        any = true

    any
end relays

// Whether a location is one held through a parameter of the function it is said in.
private through_param(loc: string) -> bool
    val b = loc.bytes

    if b.len < 3 || b[0] != u8('p') then return false

    var i: usize = 1

    while i < b.len && b[i] >= u8('0') && b[i] <= u8('9')
        i += 1

    i > 1 && i < b.len && b[i] == u8(':')
end through_param

// What a function reached through a pointer keeps, said to a call: only what it holds through its
// parameters, since anywhere else is refused where its body is written.
private held_through_params(w: KeptWhy, i: usize) -> KeptWhy
    var locs: Buf[KeptAt] = buf()
    var first: Option[KeptAt] = None

    for item in w.locs
        if !through_param(item.loc) then continue

        locs.push(item)

        if first.is_none() && !item.loc.starts_with(s"p$i:") then first = Some(item)

    if first.is_none() then return KeptWhy(false, "", span_zero(), locs)

    KeptWhy(true, first.unwrap().how, first.unwrap().at, locs)
end held_through_params

// **A call through a function pointer may land in any function whose address was taken at that
// pointer's type**, and keeps what any of them keeps -- each location with the function that keeps
// it there. A type C may call through reaches bodies held to the default instead (`refuse_promised`).
pointer_keeps(cx: &KeepsCx, callee: TExpr, j: usize) -> Buf[(string, KeptAt)]
    var out: Buf[(string, KeptAt)] = buf()
    val key = fn_key(texpr_type(callee))

    if key == "" || cx.escaped.has(key) then return out

    for item in cx.by_type
        if item.0 != key then continue

        for k in keeps_of(cx, item.1, j).locs
            out.push((item.1, k))

    out
end pointer_keeps

// Whether the round just made is the last: every answer that leaned on an assumption came out as it
// was assumed.
private round_settled(cx: &KeepsCx) -> bool
    for key in cx.assumed
        val now = cx.round.get(key).unwrap_or(assumed_answer(key)).sig()
        val was = cx.prev.get(key).unwrap_or(assumed_answer(key)).sig()

        if now != was then return false

    true
end round_settled

// The next round assumes what this one found, and works out everything that leaned afresh.
private next_round(cx: &KeepsCx)
    cx.prev = cx.round
    cx.round = map()
    cx.assumed = buf()
    cx.origins = map()
    cx.handles = map()
    cx.origin_deps = map()
    cx.handle_deps = map()
    cx.leaning = buf()
end next_round

// **The answers the first round left open are settled a component at a time.** Each open answer
// leaned on others (`deps`), and those that lean on each other in a ring are one component: a
// recursion, or a chain of calls that comes back to where it started. The components are settled
// callees first, so every answer a component leans on outside itself is settled before it starts,
// and only the component's own answers are worked out again until they stop moving. An open answer
// in no ring leaned only on answers settled before it, and is worked out once.
//
// Rounds over everything (`settle_by_rounds`) do the same work once per round for every answer that
// leaned on any recursion anywhere below it -- most of a program, through its callers -- however far
// away the recursion is.
private settle_components(cx: &KeepsCx)
    val comps = open_components(cx)

    cx.resolving = true

    for comp in comps
        settle_component(cx, comp)

        if cx.strayed then break

    cx.resolving = false
    cx.members = map()
    forget_leaning(cx)
end settle_components

// A component's answers, worked out again -- each one asked while it was still being worked out
// answered with the last pass's -- until a pass changes none of them. A clear assumed of a recursive
// callee narrows as the keeps it undoes grow, so the passes are not monotone in both at once; a
// component that has not settled by the twelfth (the first round's among them) is one whose answers
// swing between two, and the last pass's is as good as either.
private settle_component(cx: &KeepsCx, comp: Buf[string])
    cx.members = map()

    for key in comp
        cx.members.put(key, true)

    var passes = 1

    loop
        passes += 1

        // Whatever was gathered from an answer still open is gathered again from this pass's.
        forget_leaning(cx)
        cx.reads = buf()

        for key in comp
            cx.prev.put(key, cx.round.get(key).unwrap_or(assumed_answer(key)))
            cx.round.remove(key)

        for key in comp
            if cx.settled.has(key) || cx.round.has(key) then continue

            val q = cx.questions.get(key).unwrap()

            summary(cx, q.0, q.1, q.2)

        if cx.strayed then return

        // A member that leaned on no other this pass came out settled. The pass is the last when none
        // leaned, or when none of those that did moved.
        var open = false
        var moved = false

        for key in comp
            if cx.settled.has(key) then continue

            val now = cx.round.get(key).unwrap_or(assumed_answer(key)).sig()

            open = true

            if now != cx.prev.get(key).unwrap_or(assumed_answer(key)).sig() then moved = true

        if !open || !moved || passes >= 12
            for key in comp
                cx.round.get(key) match
                    Some(v) ->
                        cx.settled.put(key, v)
                        cx.round.remove(key)
                    None -> ()

            return
        end if
    end loop
end settle_component

// Drops every gathering of origins or handles that read an answer still open.
private forget_leaning(cx: &KeepsCx)
    for name in cx.leaning
        if cx.origin_deps.has(name)
            cx.origins.remove(name)
            cx.origin_deps.remove(name)
        end if

        if cx.handle_deps.has(name)
            cx.handles.remove(name)
            cx.handle_deps.remove(name)
        end if

    cx.leaning = buf()
end forget_leaning

// The open answers' components, each one after every component it leans on (Tarjan's, on a stack of
// its own: a chain of open answers may be as long as the program). Each component lists its answers
// with the ones found last -- the callees -- first.
private open_components(cx: &KeepsCx) -> Buf[Buf[string]]
    var out: Buf[Buf[string]] = buf()
    var index: Map[string, usize] = map()
    var low: Map[string, usize] = map()
    var on: Map[string, bool] = map()
    var stack: Buf[string] = buf()
    var count: usize = 0

    for root in cx.assumed
        if index.has(root) || !cx.round.has(root) then continue

        var names: Buf[string] = buf()
        var next: Buf[usize] = buf()

        index.put(root, count)
        low.put(root, count)
        count += 1
        stack.push(root)
        on.put(root, true)
        names.push(root)
        next.push(0)

        while names.len() > 0
            val top = names.len() - 1
            val v = names.at(top)
            val at = next.pop().unwrap_or(0)
            val succ = cx.deps.get(v).unwrap_or(buf())

            if at < succ.len()
                next.push(at + 1)

                val w = succ.at(at)

                if !cx.round.has(w) then continue

                if !index.has(w)
                    index.put(w, count)
                    low.put(w, count)
                    count += 1
                    stack.push(w)
                    on.put(w, true)
                    names.push(w)
                    next.push(0)
                else if on.has(w)
                    val iw = index.get(w).unwrap()

                    if iw < low.get(v).unwrap() then low.put(v, iw)
                end if
            else
                names.truncate(top)

                val lv = low.get(v).unwrap()

                if top > 0
                    val u = names.at(top - 1)

                    if lv < low.get(u).unwrap() then low.put(u, lv)
                end if

                if lv == index.get(v).unwrap()
                    var comp: Buf[string] = buf()

                    loop
                        val w = stack.pop().unwrap()

                        on.remove(w)
                        comp.push(w)

                        if w == v then break

                    out.push(comp)
                end if
            end if
        end while

    out
end open_components

// The rounds over everything: every answer that leaned on an assumption is worked out again, a round
// at a time, until a round changes none of them -- or, swinging between two, by the twelfth.
private settle_by_rounds(cx: &KeepsCx)
    cx.settled = map()
    cx.round = map()
    cx.prev = map()
    cx.assumed = buf()
    cx.origins = map()
    cx.handles = map()
    cx.origin_deps = map()
    cx.handle_deps = map()
    cx.leaning = buf()
    cx.reads = buf()

    var rounds = 0

    loop
        warm_callees_first(cx)

        rounds += 1

        if round_settled(cx) || rounds >= 12 then break

        next_round(cx)
end settle_by_rounds

// **Every body's questions are asked callees first**, so that answering one never nests a walk per
// call down a chain as long as the program: a body is asked after every body it calls has been, and
// each call it reads is then answered from the memo. Asked only on demand from the top, a chain of
// thirty-two thousand calls nested four frames of walking per call and overflowed the compiler's
// stack. The order is a depth-first walk of the calls kept on a stack of its own; a call back into
// a body still on that stack is the recursion `summary` already answers by assumption.
private warm_callees_first(cx: &KeepsCx)
    var done: Map[string, bool] = map()

    for root in cx.funcs
        if done.has(root.name) then continue

        done.put(root.name, true)

        var names: Buf[string] = buf()
        var calls: Buf[Buf[string]] = buf()
        var next: Buf[usize] = buf()

        names.push(root.name)
        calls.push(callees_of(root))
        next.push(0)

        while names.len() > 0
            val top = names.len() - 1
            val at = next.pop().unwrap_or(0)
            val list = calls.at(top)

            if at < list.len()
                next.push(at + 1)

                val callee = list.at(at)

                if done.has(callee) then continue

                done.put(callee, true)

                cx.find(callee) match
                    Some(g) ->
                        names.push(callee)
                        calls.push(callees_of(g))
                        next.push(0)
                    None -> ()
            else
                cx.find(names.at(top)) match
                    Some(f) -> ask_every_question(cx, f)
                    None -> ()

                names.truncate(top)
                calls.truncate(top)
            end if
        end while
end warm_callees_first

// Every question a call may ask of `f`, so that the answers are in the memo before a caller reads them.
private ask_every_question(cx: &KeepsCx, f: TFunc)
    clears_of(cx, f.name)

    for i in 0..<f.params.len()
        keeps_of(cx, f.name, i)
        answers_of(cx, f.name, i)
        raw_answers_of(cx, f.name, i)
        borrow_of(cx, f.name, i)
end ask_every_question

// The functions `f`'s body calls by name, in the order they are written, a name once for each call.
private struct Callees
    names: Buf[string]
end Callees

private callees_of(f: TFunc) -> Buf[string]
    val out: &Callees = Callees(buf())

    walk_block_stmts(f.body, expr_walk(false, e -> note_callee(out, e)))
    out.names
end callees_of

private note_callee(out: &Callees, e: TExpr)
    *e.kind match
        TCall(name, _, _, _) -> out.names.push(name)
        _ -> ()
end note_callee

// What a question is answered with before any round has worked it out: nothing kept, nothing an
// answer is made of -- and everything overwritten, which is the one that narrows.
private assumed_answer(key: string) -> KeptWhy = if key.starts_with("!") then clears_all() else not_kept()

// -- the summaries --------------------------------------------------------------------------------

// The seven questions asked of a body, by the mark its answers are filed under. The fifth is the
// borrow summary (`borrow_summary.sysl`), which the lowering reads to choose a place entry; the last
// two ask of what a body READS through a pointer or a view it is handed (`through_of`).
private val KeepsQ = ""
private val AnswersQ = "="
private val RawAnswersQ = "~"
private val ClearsQ = "!"
private val BorrowQ = "^"
private val ThroughQ = "&"
private val ThroughAnswersQ = "%"
private val ReadQ = "#"
private val ReadAnswersQ = "+"
private val DeepQ = "@"

// Whether `name` keeps the argument at position `i`, why, and every location it may be held at.
keeps_of(cx: &KeepsCx, name: string, i: usize) -> KeptWhy = summary(cx, name, i, KeepsQ)

// Whether what `name` answers can be made of the argument at position `i`.
answers_of(cx: &KeepsCx, name: string, i: usize) -> bool = summary(cx, name, i, AnswersQ).kept

// The same, following an address through the integers it is computed with -- which is where a store
// through the answer lands, not what the answer keeps.
raw_answers_of(cx: &KeepsCx, name: string, i: usize) -> bool = summary(cx, name, i, RawAnswersQ).kept

// The locations `name` overwrites on every way out, in terms of its own parameters.
clears_of(cx: &KeepsCx, name: string) -> KeptWhy = summary(cx, name, 0, ClearsQ)

// Whether what `name` answers is a place of, or +0 from, the argument at position `i`
// (`borrow_summary.sysl`): kept with the paths where it is, not kept with the reason where not.
borrow_of(cx: &KeepsCx, name: string, i: usize) -> KeptWhy = summary(cx, name, i, BorrowQ)

// **What a body lets out of what it reads through the pointer or view at `i`**: every location a
// value read through the parameter -- a field of its pointee, an element of its view, anything
// reached from there -- may still be held at once the call returns, as `keeps_of` says of the pointer
// itself. `install(p: *S) = kept.push(p.f)` keeps nothing of `p` and lets `p.f` out. The pointer
// handed on counts too, since whoever holds it may read through it later. Asked only of a parameter
// something can be read through (`read_through`); a body with nothing to read lets nothing out. A
// promise to borrow (`lent_by_rule`) is a promise about the pointer, not about what it points at, so
// it answers nothing here.
through_of(cx: &KeepsCx, name: string, i: usize) -> KeptWhy = summary(cx, name, i, ThroughQ)

// Whether what `name` answers can be made of a value it read through the parameter at `i`.
through_answers_of(cx: &KeepsCx, name: string, i: usize) -> bool = summary(cx, name, i, ThroughAnswersQ).kept

// **What a body lets out of what it reads EXACTLY `steps` steps through the pointer or view at `i`**
// -- one step: the pointee's own fields and elements; two: what is read through an address one of
// those holds -- which is the borrow rule's question (`read_cores`): `stash(p: *H) = kept.push(p.p)`
// lets out, one step in, the address the caller's `h` holds, and `deep(w: *W) = kept.push(w.s.f)`
// lets out only what sits two steps in. A pointer on the way handed on, or stored, counts, as for
// `through_of`, since whoever holds it may read on; a value read `steps` in and handed on counts only
// where the callee keeps it. Where no body is in sight the answer is the rule's own default for the
// pointer: an `extern` borrows unless its `@keeps` names the parameter, and a call through an object
// of no known trait, or a function pointer C may call, is held to the default (`vcall_reads`,
// `pointer_reads`). **Past `MaxReadSteps` it is what the body lets out of anything it reads through
// the parameter** (`deep_of`), which holds everything read that deep and more: a question deeper
// than the summaries tell apart is answered conservatively, never let through.
read_of(cx: &KeepsCx, name: string, i: usize, steps: int) -> KeptWhy =
    if steps > MaxReadSteps then deep_of(cx, name, i) else summary(cx, name, i, s"$ReadQ$steps")

// **What a body lets out of anything it reads through the parameter at `i`, as the borrow rule asks
// it**: `through_of`'s walk, where a callee with no body in sight is held to the rule's own default --
// an `extern` borrows what it reads unless its `@keeps` names the parameter, and a call through an
// object of no known trait or a function pointer C may call lets nothing out -- as `read_of` holds it
// at every step it tells apart. `through_of` itself takes C to keep what it reads, which is the
// question a closure's placement asks: a closure handed to C inside a struct may be a callback C
// registers. A self-referential value (one holding the address of its own storage) reaches past
// `MaxReadSteps` at once, so asking `through_of` here refused it handed through a wrapper to C.
deep_of(cx: &KeepsCx, name: string, i: usize) -> KeptWhy = summary(cx, name, i, DeepQ)

// Whether what `name` answers can be made of a value it read `steps` steps through the parameter at
// `i` -- past `MaxReadSteps`, of anything it read through it.
read_answers_of(cx: &KeepsCx, name: string, i: usize, steps: int) -> bool =
    if steps > MaxReadSteps then through_answers_of(cx, name, i) else summary(cx, name, i, s"$ReadAnswersQ$steps").kept

// The deepest step a read question tells apart from the ones around it.
private val MaxReadSteps = 8

// The steps a read question asks about, out of its mark (`#2` is two).
private steps_of(q: string) -> int
    var n = 0

    for b in q.bytes[1..<q.bytes.len]
        n = n * 10 + int(b) - int(u8('0'))

    n
end steps_of

private summary(cx: &KeepsCx, name: string, i: usize, q: string) -> KeptWhy
    val key = s"$q$name|$i"
    val keeping = q == KeepsQ
    val reading = q.starts_with(ReadQ)
    val read_answering = q.starts_with(ReadAnswersQ)
    val deep = q == DeepQ
    val through = q == ThroughQ || q == ThroughAnswersQ || reading || read_answering || deep

    cx.settled.get(key) match
        Some(v) -> return v
        None -> ()

    cx.round.get(key) match
        Some(v) ->
            cx.taint = true
            leaned_on(cx, key)
            return v
        None -> ()

    if holds_string(cx.busy, key)
        cx.taint = true
        cx.busy_reads += 1
        leaned_on(cx, key)
        return cx.prev.get(key).unwrap_or(assumed_answer(key))
    end if

    val found = cx.find(name)

    if found.is_none()
        if keeping then return extern_kept(cx, name, i)
        if q == ThroughQ then return extern_through(cx, name, i)
        if reading || deep then return extern_kept(cx, name, i)
        if q == ClearsQ then return not_kept()
        if q == BorrowQ then return KeptWhy(false, s"'$name' has no body in sight", span_zero(), buf())

        val said = extern_answers(cx, name, i)

        if said.is_some() then return if said.unwrap() then unseen_answer() else not_kept()

        return unseen_answer()
    end if

    val f = found.unwrap()

    // **A body that was refused where it was read answers nothing it is asked**: an expression the
    // reading gave up on stands where a value should be, so a store through it lands nowhere anyone
    // can say. Its refusal has been told, and every keep worked out from it would be a second
    // refusal about a body nobody could read. It keeps nothing, its answer is made of nothing, and it
    // overwrites nothing, as a body with nothing visible does; the caller's own stores are still
    // told, as they are around any call.
    if cx.mistaken.has(name) then return not_kept()

    if q != ClearsQ && i >= f.params.len() then return not_kept()
    if keeping && lent_by_rule(cx, f, i) then return not_kept()
    if through && !read_through(f.params.at(i).1, 0) then return not_kept()

    if q == KeepsQ || q == ThroughQ || reading || deep
        val crossed = crossing_kept(f, i)

        if crossed.is_some() then return crossed.unwrap()
    end if

    // Settling a component walks only its own members: any other question still open is one the
    // first round never saw a walk lean on.
    if cx.resolving && !cx.members.has(key) then cx.strayed = true

    cx.busy.push(key)

    val outer = cx.taint
    val reads = cx.busy_reads
    val logged = cx.reads.len()

    cx.taint = false

    val walked = if keeping && pointer_reached(cx, f, i) then held_through_params(walk_kept(cx, f, i), i)
    else if keeping then walk_kept(cx, f, i)
    else if q == ClearsQ then walk_clears(cx, f)
    else if q == BorrowQ then walk_borrow(cx, f, i)
    else if q == ThroughQ then walk_through(cx, f, i)
    else if deep then walk_deep(cx, f, i)
    else if q == ThroughAnswersQ then walk_answers_through(cx, f, i)
    else if reading then walk_track(track_as(cx, f, i, false, true, steps_of(q)), i)
    else if read_answering then answered(track_as(cx, f, i, false, true, steps_of(q)), f)
    else walk_answers(cx, f, i, q == RawAnswersQ)

    val held_on = keeping || q == ThroughQ || reading || deep
    val out = if held_on && f.marks.is_async() then task_held(walked) else walked

    val leaned = cx.taint

    cx.busy_reads = reads
    cx.busy.truncate(cx.busy.len() - 1)

    if leaned
        cx.round.put(key, out)
        cx.assumed.push(key)
        cx.deps.put(key, logged_since(cx, logged))
        cx.questions.put(key, (name, i, q))
    end if

    cx.reads.truncate(logged)

    if leaned
        leaned_on(cx, key)
    else
        cx.settled.put(key, out)
    end if

    cx.taint = outer || leaned
    out
end summary

// A read of an answer still open, logged against every walk under way: what each one leaned on is
// what the log gained while it ran.
leaned_on(cx: &KeepsCx, key: string)
    if cx.resolving && !cx.members.has(key) then cx.strayed = true

    cx.reads.push(key)
end leaned_on

// The open answers read since the log stood at `from`, each once.
logged_since(cx: &KeepsCx, from: usize) -> Buf[string]
    var out: Buf[string] = buf()
    var seen: Map[string, bool] = map()

    for at in from..<cx.reads.len()
        val key = cx.reads.at(at)

        if seen.has(key) then continue

        seen.put(key, true)
        out.push(key)

    out
end logged_since

// **A call through an object lands in the slot of every table made against its trait.** A raw pointer
// it hands over is borrowed by the trait's promise, each such body held to it where it is written;
// an object it hands over -- a callback among them -- is kept wherever any of those bodies keeps it.
// Each location comes with the body that keeps it there. `k` numbers the parameter as the body does,
// the receiver first (`with_receiver`): an object kept through `self` is kept as surely as an argument.
vcall_keeps(cx: &KeepsCx, recv: TExpr, slot: int, k: usize) -> Buf[(string, KeptAt)]
    var out: Buf[(string, KeptAt)] = buf()
    val tr = erased_trait(texpr_type(recv))

    if tr.is_none() || slot < 0 then return out

    val name = tr.unwrap() match
        Trait(n, _, _) -> n
        _ -> ""

    for vt in cx.vtables
        if vt.trait_name != name || usize(slot) >= vt.slots.len() then continue

        val target = vt.slots.at(usize(slot)).target

        for item in keeps_of(cx, target, k).locs
            out.push((target, item))

    out
end vcall_keeps

// **Whether a call through an object may answer with what it is handed at `k`** (the receiver first):
// wherever any body its slot lands in does, as `vcall_keeps` asks of keeping. A trait the receiver's
// type does not name is answered yes, since no body can say otherwise.
vcall_answers(cx: &KeepsCx, recv: TExpr, slot: int, all: Buf[TExpr], k: usize, ty: Type) -> bool
    val tr = erased_trait(texpr_type(recv))

    if tr.is_none() || slot < 0 then return true

    val name = tr.unwrap() match
        Trait(n, _, _) -> n
        _ -> ""

    for vt in cx.vtables
        if vt.trait_name != name || usize(slot) >= vt.slots.len() then continue
        if answers_arg(cx, vt.slots.at(usize(slot)).target, all, k, ty, false) then return true

    false
end vcall_answers

// **What a call through an object lets out of what it reads through its argument at `k`** (the
// receiver first), each location with the body that holds it there, as `vcall_keeps` says of keeping.
// A receiver whose type names no trait is answered with a location nothing can name.
vcall_through(cx: &KeepsCx, recv: TExpr, slot: int, k: usize) -> Buf[(string, KeptAt)]
    var out: Buf[(string, KeptAt)] = buf()
    val tr = erased_trait(texpr_type(recv))

    if tr.is_none() || slot < 0
        out.push(("a call through an object", KeptAt("", "no body says what it does with it", span_zero())))
        return out
    end if

    val name = tr.unwrap() match
        Trait(n, _, _) -> n
        _ -> ""

    for vt in cx.vtables
        if vt.trait_name != name || usize(slot) >= vt.slots.len() then continue

        val target = vt.slots.at(usize(slot)).target

        for item in through_of(cx, target, k).locs
            out.push((target, item))

    out
end vcall_through

// The same as the borrow rule asks it (`deep_of`): nothing where the receiver's type names no trait.
private vcall_deep(cx: &KeepsCx, recv: TExpr, slot: int, k: usize) -> Buf[(string, KeptAt)]
    var out: Buf[(string, KeptAt)] = buf()
    val tr = erased_trait(texpr_type(recv))

    if tr.is_none() || slot < 0 then return out

    val name = tr.unwrap() match
        Trait(n, _, _) -> n
        _ -> ""

    for vt in cx.vtables
        if vt.trait_name != name || usize(slot) >= vt.slots.len() then continue

        val target = vt.slots.at(usize(slot)).target

        for item in deep_of(cx, target, k).locs
            out.push((target, item))

    out
end vcall_deep

// What a call through an object lets out of what it reads `steps` steps through its argument at `k`
// (`read_of`): nothing where the receiver's type names no trait, which the rule holds to the default.
vcall_reads(cx: &KeepsCx, recv: TExpr, slot: int, k: usize, steps: int) -> Buf[(string, KeptAt)]
    var out: Buf[(string, KeptAt)] = buf()
    val tr = erased_trait(texpr_type(recv))

    if tr.is_none() || slot < 0 then return out

    val name = tr.unwrap() match
        Trait(n, _, _) -> n
        _ -> ""

    for vt in cx.vtables
        if vt.trait_name != name || usize(slot) >= vt.slots.len() then continue

        val target = vt.slots.at(usize(slot)).target

        for item in read_of(cx, target, k, steps).locs
            out.push((target, item))

    out
end vcall_reads

// Whether a call through an object may answer with a value it read through its argument at `k`.
vcall_through_answers(cx: &KeepsCx, recv: TExpr, slot: int, k: usize) -> bool
    val tr = erased_trait(texpr_type(recv))

    if tr.is_none() || slot < 0 then return true

    val name = tr.unwrap() match
        Trait(n, _, _) -> n
        _ -> ""

    for vt in cx.vtables
        if vt.trait_name != name || usize(slot) >= vt.slots.len() then continue
        if through_answers_of(cx, vt.slots.at(usize(slot)).target, k) then return true

    false
end vcall_through_answers

// What a call through a function pointer lets out of what it reads through its argument at `j`:
// whatever any function it may land in does (`pointer_keeps`), and a location nothing can name where
// C may call through the type, or no function is known to be taken at it.
pointer_through(cx: &KeepsCx, callee: TExpr, j: usize) -> Buf[(string, KeptAt)]
    var out: Buf[(string, KeptAt)] = buf()
    val key = fn_key(texpr_type(callee))

    if key == "" || cx.escaped.has(key)
        out.push(("a call through a function pointer", KeptAt("", "no body says what it does with it", span_zero())))
        return out
    end if

    for item in cx.by_type
        if item.0 != key then continue

        for k in through_of(cx, item.1, j).locs
            out.push((item.1, k))

    out
end pointer_through

// The same as the borrow rule asks it (`deep_of`): nothing where C may call through the type.
private pointer_deep(cx: &KeepsCx, callee: TExpr, j: usize) -> Buf[(string, KeptAt)]
    var out: Buf[(string, KeptAt)] = buf()
    val key = fn_key(texpr_type(callee))

    if key == "" || cx.escaped.has(key) then return out

    for item in cx.by_type
        if item.0 != key then continue

        for k in deep_of(cx, item.1, j).locs
            out.push((item.1, k))

    out
end pointer_deep

// What a call through a function pointer lets out of what it reads `steps` steps through its argument
// at `j` (`read_of`): nothing where C may call through the type, which the rule holds to the default.
pointer_reads(cx: &KeepsCx, callee: TExpr, j: usize, steps: int) -> Buf[(string, KeptAt)]
    var out: Buf[(string, KeptAt)] = buf()
    val key = fn_key(texpr_type(callee))

    if key == "" || cx.escaped.has(key) then return out

    for item in cx.by_type
        if item.0 != key then continue

        for k in read_of(cx, item.1, j, steps).locs
            out.push((item.1, k))

    out
end pointer_reads

// Whether a call through a function pointer may answer with a value it read through its argument at
// `j`.
private pointer_through_answers(cx: &KeepsCx, callee: TExpr, j: usize) -> bool
    val key = fn_key(texpr_type(callee))

    if key == "" || cx.escaped.has(key) then return true

    for item in cx.by_type
        if item.0 == key && through_answers_of(cx, item.1, j) then return true

    false
end pointer_through_answers

// **Whether something can be read through a value of this type**: a pointer to storage with a layout,
// a view, or an aggregate holding one in place. A box (`&T`) is not one here -- what is read out of a
// box is the box's own, and every walk follows it already (`carries`).
read_through(t: Type, depth: int) -> bool
    if depth > 6 then return false

    t match
        Ptr(inner) -> !is_opaque_struct(*inner)
        Slice(_, _) -> true
        Volatile(inner) -> read_through(*inner, depth + 1)
        Array(_, elem) -> read_through(*elem, depth + 1)
        Struct(d) ->
            if is_closure_literal(t) then return false

            for item in d.fields
                if read_through(item.1, depth + 1) then return true

            false
        Enum(d) ->
            for v in d.variants
                for item in v.fields
                    if read_through(item.1, depth + 1) then return true

            false
        _ -> false
end read_through

// **What C lets out of what it reads through a pointer is unknown**: an `extern` may copy it anywhere.
// Only an argument something holding an address can be read through asks (`asks_through`), so one
// handed bytes -- `*u8`, a `[]u8` -- is never taken to.
private extern_through(cx: &KeepsCx, name: string, i: usize) -> KeptWhy
    cx.an.tables.externs.get(name) match
        Some(d) ->
            if i >= d.params.len() then return not_kept()

            return anywhere("it is handed to C, which may keep what it reads through it", span_zero())
        None -> ()

    anywhere("no body says what it does with what it reads through it", span_zero())
end extern_through

// **Whether a call is asked what it lets out of what it reads through an argument of this type**: one
// something can be read through, where what is read may hold an address.
asks_through(cx: &KeepsCx, t: Type) -> bool = read_through(t, 0) && reads_an_address(cx, t)

private reads_an_address(cx: &KeepsCx, t: Type) -> bool = t match
    Ptr(inner) -> may_hold_pointer(cx, *inner)
    Slice(elem, _) -> may_hold_pointer(cx, *elem)
    _ -> true

// A method call's arguments as its body numbers its parameters: the receiver first.
with_receiver(recv: TExpr, args: Buf[TExpr]) -> Buf[TExpr]
    var out: Buf[TExpr] = buf()

    out.push(recv)

    for a in args
        out.push(a)

    out
end with_receiver

// What a call answers, where no body is here to read and no `extern` says (`extern_answers`): it may
// be made of anything it was handed.
private unseen_answer() -> KeptWhy = KeptWhy(true, "", span_zero(), buf())

// An `extern` keeps only what its `@keeps(...)` names -- a C function is handed a pointer for the
// call, which is C's own convention.
private extern_kept(cx: &KeepsCx, name: string, i: usize) -> KeptWhy
    cx.an.tables.externs.get(name) match
        Some(d) ->
            if i < d.params.len() && holds_string(d.keeps, d.params.at(i).name)
                return anywhere(s"its declaration says '@keeps(${d.params.at(i).name})'", span_zero())
        None -> ()

    not_kept()
end extern_kept

// **A `*T` a written `@crossing` names is kept: it reaches another concurrency domain, which may go on
// reading it after the call returns.** A body is no evidence here, since a written `@crossing` is a
// boundary the body does not show -- `spawn` hands its argument to C. `@joined` says how long: the
// thread the call starts holds the pointer until the handle the call answers is joined, the location
// `j` (`joined_loc`), which a join of that handle takes back. A crossing a body was found to make
// (`crossing.sysl`) is the body's own to answer for, through the call that makes it.
private crossing_kept(f: TFunc, i: usize) -> Option[KeptWhy]
    val name = f.params.at(i).0

    if !is_raw_pointer(f.params.at(i).1) then return None

    if holds_string(f.marks.joined, name)
        val how = "the thread it starts holds it until that thread is joined"
        var locs: Buf[KeptAt] = buf()

        locs.push(KeptAt("j", how, span_zero()))
        return Some(KeptWhy(true, how, span_zero(), locs))
    end if

    if holds_string(f.marks.copies, name) then return Some(anywhere("it reaches another concurrency domain", span_zero()))

    None
end crossing_kept

// **A task holds its arguments until it ends.** Calling an `async` function runs none of its body: the
// call answers a task that holds every parameter, and the body reads them when the task is driven --
// after the call has returned. So an async function keeps every parameter at `j`, the location a
// thread's pointer is held at (`keeps_join.sysl`): the task is the handle, and an `await` or a
// `block_on` of it -- of the call itself, or of a local or field it was kept in -- ends it and takes
// the pointer back. A task answered keeps it on for the caller; one stored where no place names it,
// or still held at a way out, holds it past the frame. Whatever the body itself keeps it in -- module
// storage, say -- holds it as well, and no `await` takes that back.
private task_held(w: KeptWhy) -> KeptWhy
    val how = "the task it answers holds it until that task is awaited"
    var locs: Buf[KeptAt] = buf()

    for item in w.locs
        locs.push(item)

    locs.push(KeptAt("j", how, span_zero()))

    if w.kept then KeptWhy(true, w.how, w.at, locs) else KeptWhy(true, how, span_zero(), locs)
end task_held

// Kept somewhere nothing can name, so nothing can take it back.
private anywhere(how: string, at: Span) -> KeptWhy
    var locs: Buf[KeptAt] = buf()

    locs.push(KeptAt("", how, at))
    KeptWhy(true, how, at, locs)
end anywhere

// The parameters a call keeps by promise rather than by what its body does: a `@scoped` member's
// receiver and what it runs, which finish before the call that lent them returns; and every parameter
// of a body reached through a default -- whose own body is held to the default instead
// (`refuse_promised`).
private lent_by_rule(cx: &KeepsCx, f: TFunc, i: usize) -> bool
    if scoped_at(f, i) then return true
    if is_closure_body(f) then return i >= 1

    // An object -- a callback among them -- is not an address anyone lent, so a body that stores one
    // says so to a call that sees it, whatever reaches it besides.
    if !holds_raw_pointer(f.params.at(i).1, 0) then return false

    // **A task cannot keep a trait's promise to borrow**: an async method's body runs after the call
    // that lent it a pointer has returned, so a call through the object is held to what the task
    // holds instead (`task_held`), and an `await` of it takes it back.
    if f.marks.is_async() then return false

    trait_of(cx, f.name).is_some() || (cx.addressed.has(f.name) && !relays(cx, f.name))
end lent_by_rule

// Whether `f` is reached through a function pointer whose calls are all in sight, so what it keeps
// at `i` is held to each of them (`relays`).
private pointer_reached(cx: &KeepsCx, f: TFunc, i: usize) -> bool =
    !is_closure_body(f) && trait_of(cx, f.name).is_none() && holds_raw_pointer(f.params.at(i).1, 0) &&
        relays(cx, f.name)

// The trait a function implements a method of, whether it is that method's own lowering or an
// instance of a generic one.
private trait_of(cx: &KeepsCx, name: string) -> Option[string]
    val own = cx.dispatched.get(name)

    if own.is_some() then return own

    cx.an.tables.members.func_origin.get(name) match
        Some(origin) -> cx.dispatched.get(origin)
        None -> None
end trait_of

// Whether a call of `f` lets go of the argument at a position by `f`'s `@scoped` promise: each
// parameter the annotation names, and the receiver where it names a call -- what a scoped member runs
// finishes before the call that lent its `*self` returns.
scoped_at(f: TFunc, i: usize) -> bool
    if f.marks.scoped.is_empty() then return false

    val name = f.params.at(i).0

    if holds_string(f.marks.scoped, name) then return true

    i == 0 && name == "self" && scopes_a_call(f)
end scoped_at

// Whether `@scoped` names a parameter that is a call rather than a pointer.
private scopes_a_call(f: TFunc) -> bool
    for item in f.params
        if holds_string(f.marks.scoped, item.0) && !is_raw_pointer(item.1) then return true

    false
end scopes_a_call

private is_raw_pointer(t: Type) -> bool = t match
    Ptr(_) -> true
    _ -> false

// A closure, or an object behind a trait: a body somebody may run later, holding what it captured.
private is_object(t: Type) -> bool = t match
    Trait(_, _, _) -> true
    Ref(inner, _) -> is_object(*inner)
    _ -> is_closure_literal(t)

// The `*T` parameters `@scoped` names: held by this body's own promise, which a callee it hands one
// to does not share.
private scoped_pointers(f: TFunc) -> Buf[usize]
    var out: Buf[usize] = buf()

    if f.marks.scoped.is_empty() then return out

    for i in 0..<f.params.len()
        if holds_string(f.marks.scoped, f.params.at(i).0) && is_raw_pointer(f.params.at(i).1) then out.push(i)

    out
end scoped_pointers

// The function a closure literal's body lowered to: its environment first, then what it is called with.
is_closure_body(f: TFunc) -> bool =
    !f.params.is_empty() && is_closure_literal(env_type(f.params.at(0).1)) && f.name.ends_with(".call")

private env_type(t: Type) -> Type = t match
    Ptr(inner) -> *inner
    _ -> t

// Whether a body holds an expression its reading refused: the node a complaint leaves where the value
// would have been (`bad_expr`).
private mistaken(f: TFunc) -> bool
    var found: Buf[bool] = buf()
    val sink = &found

    walk_block_stmts(f.body, expr_walk(true, x -> *x.kind match
        TZero(Unknown) -> sink.push(true)
        _ -> ()))

    !found.is_empty()
end mistaken

// -- one body, asked about one parameter -------------------------------------------------------------

// What one walk follows: the locals that may hold the parameter -- or something built around it --
// and the first place the body lets it outlive the call.
//
// `raw` follows an address through the integers it is computed with, which is the question of where
// a store through it lands rather than of what it keeps.
struct Track
    cx: &KeepsCx
    scope: Scope
    held: Buf[string]
    refs: Buf[(string, TExpr)]
    changed: bool
    why: KeptWhy
    org: &Origins
    raw: bool

    // A walk of what is READ through the parameter (`through_of`): a value reached through it -- a
    // field of its pointee, an element of its view -- is followed as the parameter itself is.
    through: bool

    // A walk of what is read EXACTLY `steps` steps through the parameter (`read_of`), where it is not
    // zero: a value read fewer steps in is a pointer on the way (`ptrs`, with its step), followed as
    // the parameter is, and a step through a value read `steps` in reads storage nobody asked about.
    steps: int
    ptrs: Buf[(string, int)]

    // Every local the body declares, with its initializer (`read_back_loc`).
    decls: Buf[(string, TExpr)]

    // A walk of a `@scoped` pointer, which follows only what the body's promise does not cover: the
    // pointer handed to a callee that keeps it, or captured by an object that is stored.
    promised: bool

    hs: &Handles

    // The body walked, whose integers `keeps_cast.sysl` follows to a `ptr_cast`.
    func: TFunc

    // A walk of what is read through the parameter as the borrow rule asks it (`deep_of`): a callee
    // handed what is read is asked `deep_of` in its turn rather than `through_of`.
    deep: bool

    holds(self, name: string) -> bool = holds_string(self.held, name)
end Track

// A walk following the parameter at `i`, or nothing at all where `i` is past the parameters -- which
// is how what a body overwrites is asked.
private track(cx: &KeepsCx, f: TFunc, i: usize, raw: bool) -> &Track = track_as(cx, f, i, raw, false, 0)

private track_as(cx: &KeepsCx, f: TFunc, i: usize, raw: bool, through: bool, steps: int) -> &Track
    val org = origins_of(cx, f)
    val t: &Track = Track(cx, func_home(cx.an, f.name), buf(), buf(), false, not_kept(), org, raw, through,
                          steps, buf(), buf(), false, round_handles(cx, org, f), f, false)

    if i < f.params.len()
        t.held.push(f.params.at(i).0)
        t.ptrs.push((f.params.at(i).0, 0))
    end if

    track_locals(t, f.body)
    t
end track_as

// Where `f` binds its thread handles, gathered once a round rather than once a question.
//
// **A gathering is kept only if it read no answer whose question was still being worked out.** Every
// other answer it read is in the memo for the rest of the round -- settled, this round's, or worked
// out on the way and filed -- so a later gathering would read the same answers and find exactly the
// same handles. An answer read while its own question was open is the last round's guess, which a
// later gathering would read as this round's instead: that gathering is made afresh each time, as
// every question did before. A kept one that leaned on this round's answers marks each question it
// serves as leaning, as gathering it afresh would have.
//
// Each walk gets a `Handles` of its own around what was gathered, since a walk marks on it the
// statement it is saying (`at`, `why`), and a walk of a recursive body asks its own questions in the
// middle of one of its statements.
private round_handles(cx: &KeepsCx, org: &Origins, f: TFunc) -> &Handles
    cx.handles.get(f.name) match
        Some(kept) ->
            if kept.1 then cx.taint = true

            for key in cx.handle_deps.get(f.name).unwrap_or(buf())
                leaned_on(cx, key)

            return handles_copy(kept.0)
        None -> ()

    val outer = cx.taint
    val reads = cx.busy_reads
    val logged = cx.reads.len()

    cx.taint = false

    val hs = handles_of(org, f)
    val leaned = cx.taint

    if cx.busy_reads == reads
        cx.handles.put(f.name, (handles_copy(hs), leaned))

        val deps = logged_since(cx, logged)

        if !deps.is_empty()
            cx.handle_deps.put(f.name, deps)
            cx.leaning.push(f.name)
        end if
    end if

    cx.taint = outer || leaned
    hs
end round_handles

private handles_copy(hs: &Handles) -> &Handles =
    Handles(hs.org, hs.sources, hs.chained, hs.answers, hs.scrutinized, hs.at, hs.why, hs.fan_at,
            hs.fan_whys, hs.fan_hooks)

// Whether `f` lets its parameter at `i` outlive the call, where, and every location it may still be
// held at when the call returns.
private walk_kept(cx: &KeepsCx, f: TFunc, i: usize) -> KeptWhy = walk_kept_as(cx, f, i, false)

private walk_kept_as(cx: &KeepsCx, f: TFunc, i: usize, promised: bool) -> KeptWhy
    val t = track(cx, f, i, false)

    t.promised = promised
    walk_track(t, i)
end walk_kept_as

// Every location a value `f` reads through its parameter at `i` may still be held at once it returns.
private walk_through(cx: &KeepsCx, f: TFunc, i: usize) -> KeptWhy =
    walk_track(track_as(cx, f, i, false, true, 0), i)

// The same, as the borrow rule asks it (`deep_of`).
private walk_deep(cx: &KeepsCx, f: TFunc, i: usize) -> KeptWhy
    val t = track_as(cx, f, i, false, true, 0)

    t.deep = true
    walk_track(t, i)
end walk_deep

// Whether what `f` answers can be made of a value it reads through its parameter at `i`.
private walk_answers_through(cx: &KeepsCx, f: TFunc, i: usize) -> KeptWhy =
    answered(track_as(cx, f, i, false, true, 0), f)

private walk_track(t: &Track, i: usize) -> KeptWhy
    val f = t.func
    val w = flow_walk(t.org, s -> track_stmt_events(t, s), e -> track_expr_events(t, e),
                      (x, p, matched) -> arm_clears(t.hs, x, p, matched))

    flow_body(w, f.body)

    val pending = if t.steps > 0 then read_back_locs(t, w.out_pending) else w.out_pending
    var first: Option[KeptAt] = None

    for item in pending
        if first.is_none() && !item.loc.starts_with(s"p$i:") then first = Some(item)

    if first.is_none() then return KeptWhy(false, "", span_zero(), pending)

    KeptWhy(true, first.unwrap().how, first.unwrap().at, pending)
end walk_track

// **A store through a local holding a pointer on the way is a store through the parameter**, for a walk
// of what is read some steps in: `val vm = s.vm` then `vm.con = old` is held at `d:@vm.con`, the local's
// own name, which the caller cannot say -- so it is said as the pointer it was read from
// (`d:p0:.vm>{*VM}.con`), which the caller can tell is reached through what it handed over
// (`frame_read_locs`).
private read_back_locs(t: &Track, locs: Buf[KeptAt]) -> Buf[KeptAt]
    var out: Buf[KeptAt] = buf()

    for item in locs
        out.push(KeptAt(read_back_loc(t, item.loc, 0), item.how, item.at))

    out
end read_back_locs

private read_back_loc(t: &Track, loc: string, depth: int) -> string
    if !loc.starts_with("d:@") || depth > 8 then return loc

    val n = local_of(loc[1..<loc.bytes.len])

    if !bound_step(t, n) then return loc

    for item in t.decls
        if item.0 != n then continue

        val at = place_loc(t.org, item.1)
        val key = type_show(texpr_type(item.1))

        if at == "" || at.index_of("?").is_some() || key.index_of("?").is_some() then return loc

        val root = if at.starts_with("d:") then read_back_loc(t, at, depth + 1) else s"d:$at"
        val rest = loc["d:@".bytes.len + n.bytes.len..<loc.bytes.len]

        return s"$root>{$key}$rest"
    end for

    loc
end read_back_loc

// The locations `f` overwrites on every way out.
private walk_clears(cx: &KeepsCx, f: TFunc) -> KeptWhy
    val t = track(cx, f, f.params.len(), false)
    val w = flow_walk(t.org, s -> track_stmt_events(t, s), e -> track_expr_events(t, e),
                      (x, p, matched) -> arm_clears(t.hs, x, p, matched))

    flow_body(w, f.body)

    var locs: Buf[KeptAt] = buf()

    if w.exited
        for c in w.out_cleared
            locs.push(KeptAt(c, "", span_zero()))
    else
        // A body that never comes back overwrites everything by the time it does.
        locs.push(KeptAt("*", "", span_zero()))
    end if

    KeptWhy(false, "", span_zero(), locs)
end walk_clears

// What one statement does to what is tracked: the locations it overwrites at its top -- a store, or a
// call whose callee overwrites them -- and every location it stores what is tracked at.
private track_stmt_events(t: &Track, s: TStmt) -> Buf[FlowEv]
    val evs: &EvBuf = EvBuf(buf())

    stmt_moves(t.cx, evs, s)
    t.hs.at = stmt_handle(t.hs, s)

    s match
        TWriteStmt(w) -> clear_store(t, evs, w.place, w.value)
        TMultiAssign(writes) ->
            for item in writes
                clear_store(t, evs, item.place, item.value)
        TExprStmt(e) -> top_clears(t, evs, e)
        TVarDecl(_, _, init, _) -> top_clears(t, evs, init)
        _ -> ()

    walk_stmt(s, TWalk(false, e -> kept_at(t, evs, e), w -> stored(t, evs, w.place, w.value), x -> ()))
    fan_stmt_events(t.hs, evs, s)
    t.hs.at = ""
    evs.items
end track_stmt_events

private track_expr_events(t: &Track, e: TExpr) -> Buf[FlowEv]
    val evs: &EvBuf = EvBuf(buf())

    piece_moves(t.cx, evs, e)
    t.hs.at = expr_handle(t.hs, e)
    top_clears(t, evs, e)
    walk_texpr(e, TWalk(false, x -> kept_at(t, evs, x), w -> stored(t, evs, w.place, w.value), s -> ()))
    fan_events(t.hs, evs, e.span)
    t.hs.at = ""
    evs.items
end track_expr_events

struct EvBuf
    items: Buf[FlowEv]

// **What a piece may do to a pointer a location is named through, said before anything it stores or
// overwrites** (`keeps_flow.sysl`'s `deref_name`): a call or an atomic may write any pointer held in
// memory, a store one of its value's type, and a declaration binds its local afresh.
private stmt_moves(cx: &KeepsCx, evs: &EvBuf, s: TStmt)
    stmt_decl_moves(cx, evs, s)
    walk_stmt(s, TWalk(false, x -> expr_moves(cx, evs, x), w -> value_moves(cx, evs, texpr_type(w.value)),
                       x -> stmt_decl_moves(cx, evs, x)))
end stmt_moves

private piece_moves(cx: &KeepsCx, evs: &EvBuf, e: TExpr)
    expr_moves(cx, evs, e)
    walk_texpr(e, TWalk(false, x -> expr_moves(cx, evs, x), w -> value_moves(cx, evs, texpr_type(w.value)),
                        x -> stmt_decl_moves(cx, evs, x)))
end piece_moves

private stmt_decl_moves(cx: &KeepsCx, evs: &EvBuf, s: TStmt)
    s match
        TVarDecl(n, ty, _, _) ->
            moved(evs, s"@$n")
            value_moves(cx, evs, ty)
        _ -> ()
end stmt_decl_moves

private expr_moves(cx: &KeepsCx, evs: &EvBuf, e: TExpr)
    *e.kind match
        TCall(_, _, _, _) -> moved(evs, "*")
        TVCall(_, _, _, _, _) -> moved(evs, "*")
        TCallPtr(_, _, _, _) -> moved(evs, "*")
        TAtomic(_, _, _, _, _, _) -> moved(evs, "*")
        TSlots(_, _, _, _) -> moved(evs, "*")
        TStore(_, v, _, _) -> value_moves(cx, evs, texpr_type(v))
        _ -> ()
end expr_moves

private value_moves(cx: &KeepsCx, evs: &EvBuf, t: Type)
    if !may_hold_pointer(cx, t) then return

    t match
        Ptr(_) -> moved(evs, s"{${type_show(t)}}")
        _ -> moved(evs, "*")
end value_moves

private moved(evs: &EvBuf, what: string)
    val loc = ">" + what

    for ev in evs.items
        if ev.clear && ev.loc == loc then return

    evs.items.push(FlowEv(true, loc, "", span_zero()))
end moved

private top_clears(t: &Track, evs: &EvBuf, e: TExpr)
    *e.kind match
        TStore(place, v, _, _) -> clear_store(t, evs, place, v)
        TCall(name, args, _, _) ->
            for c in clears_of(t.cx, name).locs
                val loc = translate_loc(t.org, args, c.loc)

                if loc != "" && !loc.starts_with("l:") then evs.items.push(FlowEv(true, loc, "", e.span))
        _ -> ()
end top_clears

// A store of something not tracked overwrites what its place held.
private clear_store(t: &Track, evs: &EvBuf, place: TExpr, v: TExpr)
    if carries(t, v) then return

    val loc = place_loc(t.org, place)

    if loc != "" && !loc.starts_with("l:") then evs.items.push(FlowEv(true, loc, "", v.span))
end clear_store

// Whether what `f` answers can be made of its parameter at `i`.
private walk_answers(cx: &KeepsCx, f: TFunc, i: usize, raw: bool) -> KeptWhy = answered(track(cx, f, i, raw), f)

private answered(t: &Track, f: TFunc) -> KeptWhy
    walk_block_stmts(f.body, stmt_walk(false, s -> s match
        TReturn(v) -> if v.is_some() && carries(t, v.unwrap()) then keep(t, "", v.unwrap().span)
        _ -> ()))

    if f.body.result.is_some() && carries(t, f.body.result.unwrap())
        keep(t, "", f.body.result.unwrap().span)

    t.why
end answered

private keep(t: &Track, how: string, at: Span)
    if !t.why.kept then t.why = KeptWhy(true, how, at, buf())

private kept_hard(evs: &EvBuf, how: string, at: Span) = evs.items.push(FlowEv(false, "", how, at))

// **An address as an integer handed to a callee is kept only where the callee may put it in storage
// that outlives the call and a `ptr_cast` may turn it back from there** (`image_passed` for a
// frame's own). Whether the argument was one is the answer; one the cast cannot reach is a number.
private image_kept(t: &Track, evs: &EvBuf, call: TExpr, name: string, j: usize, arg: TExpr) -> bool
    if t.promised || !is_integer_type(texpr_type(arg)) || !carries(t, arg) then return false

    cast_reach_arg(t.cx, t.func, call, name, j) match
        Some(turned) ->
            kept_hard(evs, s"it is passed as an integer to '${shown_name(t.cx.an, name)}', which may store " +
                s"it where '${shown_name(t.cx.an, turned)}' turns it back into a pointer with 'ptr_cast'",
                arg.span)
        None -> ()

    true
end image_kept

// Where a body lets what it tracks go: a store outside its own locals, a buffer's slot, an atomic
// store, and an argument the callee keeps -- at each location the callee may hold it, said in this
// body's terms. One the callee holds in what this frame's own local points at binds that local
// instead (`track_locals`).
private kept_at(t: &Track, evs: &EvBuf, e: TExpr)
    *e.kind match
        TStore(place, v, _, _) -> stored(t, evs, place, v)
        TSlots(op, args, _, _) ->
            if t.promised then return

            if op == "slot_place" && args.len() == 3 && carries(t, args.at(2))
                kept_hard(evs, "it is stored in a buffer's slot", args.at(2).span)
            else if op == "slot_put" && args.len() == 2 && carries(t, args.at(1))
                kept_hard(evs, "it is stored in a buffer's slot", args.at(1).span)
        TAtomic(_, _, ops, _, _, _) ->
            if t.promised then return

            for op in ops
                if carries(t, op) then kept_hard(evs, "it is stored through a pointer by an atomic", op.span)
        TAwait(task, _) -> await_clear(t.hs, evs, task, e.span)
        TBlockOn(task, _) -> await_clear(t.hs, evs, task, e.span)
        TStep(_, wake) ->
            if !t.promised && hands_on(t, wake)
                kept_hard(evs, "it is the waker handed to 'step', which the task keeps for its parks", wake.span)
        TCall(name, args, _, _) ->
            join_clear(t.hs, evs, name, args, e.span)

            for j in 0..<args.len()
                if image_kept(t, evs, e, name, j, args.at(j)) then continue
                if !hands_on(t, args.at(j)) then continue

                val held = track_call_locs(t, name, j, args.at(j))
                val kept_n = keeps_of(t.cx, name, j).locs.len()

                for at in 0..<held.len()
                    val item = held.at(at)
                    val how = s"it is passed to '${shown_name(t.cx.an, name)}', which " +
                        (if at < kept_n then "keeps it" else "lets what it reads through it out")

                    if item.loc == "j" && has_span(t.hs.chained, e.span) then continue

                    val loc = if item.loc == "j" then joined_loc(t.hs, true) else translate_loc(t.org, args, item.loc)

                    if loc.starts_with("j:") && said_already(evs, loc, args.at(j).span) then continue
                    if !loc.starts_with("l:") then evs.items.push(FlowEv(false, loc, how, args.at(j).span))
        TVCall(recv, slot, args, _, _) ->
            val all = with_receiver(recv, args)

            for k in 0..<all.len()
                if !hands_on(t, all.at(k)) then continue

                val held = track_vcall_locs(t, recv, slot, k, all.at(k))
                val kept_n = vcall_keeps(t.cx, recv, slot, k).len()

                for at in 0..<held.len()
                    val item = held.at(at)

                    if item.1.loc == "j" && has_span(t.hs.chained, e.span) then continue

                    val loc = if item.1.loc == "j" then joined_loc(t.hs, true) else translate_loc(t.org, all, item.1.loc)

                    if loc.starts_with("j:") && said_already(evs, loc, all.at(k).span) then continue

                    val how = s"it is passed to '${shown_name(t.cx.an, item.0)}', which " +
                        (if at < kept_n then "keeps it" else "lets what it reads through it out")

                    if !loc.starts_with("l:") then evs.items.push(FlowEv(false, loc, how, all.at(k).span))
        TCallPtr(callee, args, _, _) ->
            for j in 0..<args.len()
                if !hands_on(t, args.at(j)) then continue

                val held = track_pointer_locs(t, callee, j, args.at(j))
                val kept_n = pointer_keeps(t.cx, callee, j).len()

                for at in 0..<held.len()
                    val item = held.at(at)
                    val loc = translate_loc(t.org, args, item.1.loc)
                    val how = s"it is passed through a function pointer to '${shown_name(t.cx.an, item.0)}', " +
                        (if at < kept_n then "which keeps it" else "which lets what it reads through it out")

                    if !loc.starts_with("l:") then evs.items.push(FlowEv(false, loc, how, args.at(j).span))
        _ -> ()
end kept_at

// **Where a call may hold what a walk follows in an argument**: what the callee keeps of it, and for a
// walk of what is read through a parameter (`through_of`), what the callee lets out of what it reads
// through it -- the argument may be the pointer itself, handed on, or one read out of it.
private track_call_locs(t: &Track, name: string, j: usize, arg: TExpr) -> Buf[KeptAt]
    val kept = keeps_of(t.cx, name, j).locs

    if !reads_on(t, arg) then return kept

    var out: Buf[KeptAt] = buf()

    for item in kept
        out.push(item)

    if t.steps == 0
        for item in (if t.deep then deep_of(t.cx, name, j) else through_of(t.cx, name, j)).locs
            out.push(item)
    end if

    for k in steps_left(t, arg)
        for item in read_of(t.cx, name, j, k).locs
            out.push(item)

    out
end track_call_locs

private track_vcall_locs(t: &Track, recv: TExpr, slot: int, k: usize, arg: TExpr) -> Buf[(string, KeptAt)]
    val kept = vcall_keeps(t.cx, recv, slot, k)

    if !reads_on(t, arg) then return kept

    var out: Buf[(string, KeptAt)] = buf()

    for item in kept
        out.push(item)

    if t.steps == 0
        for item in (if t.deep then vcall_deep(t.cx, recv, slot, k) else vcall_through(t.cx, recv, slot, k))
            out.push(item)
    end if

    for left in steps_left(t, arg)
        for item in vcall_reads(t.cx, recv, slot, k, left)
            out.push(item)

    out
end track_vcall_locs

private track_pointer_locs(t: &Track, callee: TExpr, j: usize, arg: TExpr) -> Buf[(string, KeptAt)]
    val kept = pointer_keeps(t.cx, callee, j)

    if !reads_on(t, arg) then return kept

    var out: Buf[(string, KeptAt)] = buf()

    for item in kept
        out.push(item)

    if t.steps == 0
        for item in (if t.deep then pointer_deep(t.cx, callee, j) else pointer_through(t.cx, callee, j))
            out.push(item)
    end if

    for left in steps_left(t, arg)
        for item in pointer_reads(t.cx, callee, j, left)
            out.push(item)

    out
end track_pointer_locs

// Whether a callee handed `arg` is asked what it lets out of what it reads through it: in a walk of
// what is read through the parameter, an argument something can be read through -- and in a walk of
// what is read `steps` in, only a pointer on the way handed on, of which the callee is asked the steps
// left (`steps_left`); a value read `steps` in and handed on is followed by what the callee keeps of it.
private reads_on(t: &Track, arg: TExpr) -> bool =
    t.through && asks_through(t.cx, texpr_type(arg)) && (t.steps == 0 || !ptr_steps(t, arg).is_empty())

// The steps a callee handed `arg` is asked about: what is still to be read past each step it may
// have been read at -- more than the walk's own where it points at a pointer on the way (`&q`, `q`
// bound to the parameter, reads two steps to what the parameter reads one).
private steps_left(t: &Track, arg: TExpr) -> Buf[int]
    var out: Buf[int] = buf()

    for s in ptr_steps(t, arg)
        push_step(&out, t.steps - s)

    out
end steps_left

// **Every step through the parameter a pointer on the way may have been read at** in a walk of what is
// read `steps` in, or none for a value that is no such pointer: 0 for the parameter and a name bound
// to it, one more for each step through one (`p.s`, `p[i]` of a view), the same for a field or
// element in place, a view or a cast of it, and one fewer for an address taken of a place holding one
// (`&p.x` reads, a step in, what `p` does; `&q`, where `q` is bound to the parameter, is a step
// further out than the parameter). The address of a place holding the value read `steps` in is a
// pointer on the way one step short of it. A local given values read at different steps has them all
// (`ptrs`); so does a branch, and a call answering a value it read through a pointer on the way
// (`call_steps`). A value read `steps` in is what is followed, not a pointer on the way.
private ptr_steps(t: &Track, e: TExpr) -> Buf[int]
    var out: Buf[int] = buf()

    if t.steps > 0 then gather_steps(t, e, &out, 0)

    out
end ptr_steps

private gather_steps(t: &Track, e: TExpr, out: *Buf[int], depth: int)
    // An expression nested past what is followed may be a pointer at any step on the way.
    if depth > 64
        for s in 0..<t.steps
            push_step(out, s)

        return
    end if

    *e.kind match
        TLoad(n, _) ->
            for item in t.ptrs
                if item.0 == n then push_step(out, item.1)
        TAddrOf(place, _) ->
            var inner: Buf[int] = buf()

            gather_steps(t, place, &inner, depth + 1)

            for s in inner
                push_step(out, s - 1)

            if carries(t, place) then push_step(out, t.steps - 1)
        TDeref(x, _) -> steps_on(t, x, out, depth)
        TField(r, _, _) -> gather_steps(t, r, out, depth + 1)
        TIndex(r, _, _) -> texpr_type(r) match
            Array(_, _) -> gather_steps(t, r, out, depth + 1)
            _ -> steps_on(t, r, out, depth)
        TCast(v, _) -> gather_steps(t, v, out, depth + 1)
        TSlice(base, _, _, _, _) -> gather_steps(t, base, out, depth + 1)
        TConstView(v) -> gather_steps(t, v, out, depth + 1)
        TViewAs(v, _) -> gather_steps(t, v, out, depth + 1)
        TSeq(exprs) -> if !exprs.is_empty() then gather_steps(t, exprs.at(exprs.len() - 1), out, depth + 1)
        TBlockExpr(b) -> if b.result.is_some() then gather_steps(t, b.result.unwrap(), out, depth + 1)
        TIf(_, then_block, else_block, _) ->
            if then_block.result.is_some() then gather_steps(t, then_block.result.unwrap(), out, depth + 1)

            if else_block.is_some() && else_block.unwrap().result.is_some()
                gather_steps(t, else_block.unwrap().result.unwrap(), out, depth + 1)
        TMatch(_, arms, _) ->
            for arm in arms
                if arm.body.result.is_some() then gather_steps(t, arm.body.result.unwrap(), out, depth + 1)
        TCall(name, args, ty, _) -> if may_hold_pointer(t.cx, ty) then call_steps(t, name, args, ty, out, depth)
        TVCall(recv, _, args, ty, _) -> if may_hold_pointer(t.cx, ty) then any_steps(t, with_receiver(recv, args), out, depth)
        TCallPtr(_, args, _, ty) -> if may_hold_pointer(t.cx, ty) then any_steps(t, args, out, depth)
        _ -> ()
end gather_steps

// One step further through a pointer read some steps in: still a pointer on the way short of `steps`.
private steps_on(t: &Track, x: TExpr, out: *Buf[int], depth: int)
    var inner: Buf[int] = buf()

    gather_steps(t, x, &inner, depth + 1)

    for s in inner
        if s + 1 < t.steps then push_step(out, s + 1)
end steps_on

// **What a call answers, read through a pointer on the way**: the pointer itself where the answer is
// made of the argument, and a pointer `k` steps further in where the callee answers what it reads
// `k` steps through it (`read_answers_of`) -- `get_s(w)` answering `w.s` hands back what the walk
// reads one step through `w`.
private call_steps(t: &Track, name: string, args: Buf[TExpr], ty: Type, out: *Buf[int], depth: int)
    for i in 0..<args.len()
        var inner: Buf[int] = buf()

        gather_steps(t, args.at(i), &inner, depth + 1)

        if inner.is_empty() then continue

        val itself = answers_arg(t.cx, name, args, i, ty, false)

        for s in inner
            if itself then push_step(out, s)

            if !asks_through(t.cx, texpr_type(args.at(i))) then continue

            var k = 1

            while s + k < t.steps
                if read_answers_of(t.cx, name, i, k)
                    // An answer read past the steps a summary tells apart may be any of them.
                    if k > MaxReadSteps
                        for m in s + k..<t.steps
                            push_step(out, m)
                    else
                        push_step(out, s + k)
                    end if
                end if

                k += 1
            end while
        end for
    end for
end call_steps

// A call through an object or a function pointer may answer any pointer on the way it was handed, or
// anything further in.
private any_steps(t: &Track, args: Buf[TExpr], out: *Buf[int], depth: int)
    for a in args
        var inner: Buf[int] = buf()

        gather_steps(t, a, &inner, depth + 1)

        for s in inner
            for m in s..<t.steps
                push_step(out, m)
    end for
end any_steps

private push_step(out: *Buf[int], s: int)
    for item in *out
        if item == s then return

    out.push(s)
end push_step

// A step through `x` reads what is followed: anything for a walk of what is read through the
// parameter; for a walk of what is read `steps` in, the last step, or one that reads a pointer on the
// way.
private steps_in(t: &Track, x: TExpr) -> bool = t.through && (t.steps == 0 || !ptr_steps(t, x).is_empty())

// A store: into this frame's own storage it binds the local (`track_locals`); anywhere else it is
// held at the location the place names.
private stored(t: &Track, evs: &EvBuf, place: TExpr, v: TExpr)
    if local_root(t.refs, place).is_some() then return

    val loc = place_loc(t.org, place)

    if loc.starts_with("l:") then return

    // **A `@scoped` body's promise covers what it stores itself** -- the pointer, or a value built
    // around it, which the body takes back before its caller's scope ends. An object that captured
    // it is a callback somebody else runs, when the body cannot say.
    if t.promised
        if carries(t, v) && is_object(texpr_type(v))
            evs.items.push(FlowEv(false, loc, s"it is captured by what is stored in '${place_said(t.scope, place)}'",
                                  v.span))
        end if

        return
    end if

    if !carries(t, v) then return

    // **An address stored as an integer is a number until a `ptr_cast` may turn it back into a
    // pointer**, as a frame's own is (`frame_stored`). One that can be is held where the integer is,
    // as the pointer would be: one stored in the storage it points into ends with that storage, and
    // one stored anywhere the call does not own is kept.
    var back = ""

    if is_integer_type(texpr_type(v))
        var turned = ""

        for k in cast_keys_of(t.cx, t.func, place)
            if turned == "" then turned = cast_reach(t.cx, k, false).unwrap_or("")

        if turned == "" then return

        back = s", which '${shown_name(t.cx.an, turned)}' turns back into a pointer with 'ptr_cast'"
    end if

    evs.items.push(FlowEv(false, loc, s"it is stored in '${place_said(t.scope, place)}'$back", v.span))
end stored

// A place as the reader wrote it, rebuilt from the tree: module storage by its name, a field after
// what it is a field of, a step through a pointer as the dot that wrote it.
// A whole place written through a pointer is the pointer's target, `*out`.
private place_said(scope: Scope, place: TExpr) -> string = *place.kind match
    // A nested function reaches its enclosing function's local through the address its environment
    // holds, and the reader wrote the local's name.
    TDeref(x, _) -> capture_name(x).unwrap_or(s"*${place_path(scope, x)}")
    _ -> place_path(scope, place)

private capture_name(x: TExpr) -> Option[string] = *x.kind match
    TField(r, index, _) ->
        val env = pointee_or(texpr_type(r))

        if is_environment(env) then Some(field_label(env, index)) else None
    _ -> None

private is_environment(t: Type) -> bool = t match
    Struct(d) -> d.base.starts_with(s"${ModuleSep}env")
    _ -> false

private pointee_or(t: Type) -> Type = t match
    Ptr(inner) -> *inner
    _ -> t

private place_path(scope: Scope, place: TExpr) -> string = *place.kind match
    TGlobal(symbol, _, _) -> bare_name(qualified_name(symbol))
    TDeref(x, _) -> place_path(scope, x)
    TField(r, index, _) -> texpr_type(r) match
        Struct(d) ->
            // A closure's capture is read out of its environment, and the reader wrote its name.
            if is_closure_literal(texpr_type(r)) && index >= 0 && usize(index) < d.fields.len()
                d.fields.at(usize(index)).0
            else if index >= 0 && usize(index) < d.fields.len()
                s"${place_path(scope, r)}.${d.fields.at(usize(index)).0}"
            else source_text(scope, whole_place(place))
        _ -> source_text(scope, whole_place(place))
    TIndex(r, _, _) -> s"${place_path(scope, r)}[…]"
    _ -> source_text(scope, place.span)

// The last part of a dotted name.
private bare_name(written: string) -> string = written.last_index_of(".") match
    Some(at) -> written[at + 1..<written.bytes.len]
    None -> written

// Where a place is written in full: a field's own span is its name, and the receiver it is a field of
// was written before it.
private whole_place(place: TExpr) -> Span
    val inner = *place.kind match
        TField(r, _, _) -> Some(r)
        TIndex(r, _, _) -> Some(r)
        TDeref(x, _) -> Some(x)
        _ -> None

    if inner.is_none() then return place.span

    val from = whole_place(inner.unwrap())

    if from.start < place.span.start && from.end <= place.span.end then Span(from.start, place.span.end)
    else place.span
end whole_place

// Which locals hold what is tracked. A fixpoint, because a body may pass it along a chain of locals
// before letting it go; nothing shrinks, so it settles.
private track_locals(t: &Track, body: TBlock)
    walk_block_stmts(body, stmt_walk(false, s -> s match
        TRefDecl(n, _, place) -> t.refs.push((n, place))
        TVarDecl(n, _, init, _) -> if t.steps > 0 then t.decls.push((n, init))
        _ -> ()))

    t.changed = true

    while t.changed
        t.changed = false

        walk_block_stmts(body, TWalk(false, e -> bind_expr(t, e), w -> bind_store(t, w.place, w.value),
                                     s -> bind_stmt(t, s)))
end track_locals

private bind_stmt(t: &Track, s: TStmt)
    s match
        TVarDecl(n, _, init, _) -> bind(t, n, init)
        TRefDecl(n, _, place) -> bind(t, n, place)
        _ -> ()
end bind_stmt

// A store into this frame's own storage -- by name, or through a pointer that points into it.
private bind_store(t: &Track, place: TExpr, v: TExpr)
    local_root(t.refs, place) match
        Some(n) -> bind(t, n, v)
        None ->
            val loc = place_loc(t.org, place)

            if loc.starts_with("l:") then bind(t, local_of(loc), v)
end bind_store

// A callee that stores what it is handed into what another of its arguments points at, where that
// argument points into this frame: the local holds it.
private bind_call(t: &Track, name: string, args: Buf[TExpr])
    for j in 0..<args.len()
        if !hands_on(t, args.at(j)) then continue

        for item in track_call_locs(t, name, j, args.at(j))
            val loc = translate_loc(t.org, args, item.loc)

            if loc.starts_with("l:") then bind_name(t, local_of(loc))
end bind_call

private bind_ptr_call(t: &Track, callee: TExpr, args: Buf[TExpr])
    for j in 0..<args.len()
        if !hands_on(t, args.at(j)) then continue

        for item in track_pointer_locs(t, callee, j, args.at(j))
            val loc = translate_loc(t.org, args, item.1.loc)

            if loc.starts_with("l:") then bind_name(t, local_of(loc))
end bind_ptr_call

// The forms that bind names from a value: a store, a `match`'s arms, an `is` test, a `for` over a
// sequence and an iteration's cursor.
private bind_expr(t: &Track, e: TExpr)
    *e.kind match
        TStore(place, v, _, _) -> bind_store(t, place, v)
        TCall(name, args, _, _) -> bind_call(t, name, args)
        TCallPtr(callee, args, _, _) -> bind_ptr_call(t, callee, args)
        TMatch(scrutinee, arms, _) ->
            if carries(t, scrutinee)
                val steps = ptr_steps(t, scrutinee)

                for arm in arms
                    for p in arm.patterns
                        bind_pattern(t, p, steps)
            end if
        TIf(cond, _, _, _) -> bind_terms(t, cond)
        TWhile(cond, _, _, _) -> bind_terms(t, cond)
        TForEach(name, _, seq, _, _, _) ->
            if carries(t, seq)
                bind_steps(t, name, element_steps(t, seq))
                bind_name(t, name)
            end if
        TIterate(cursor, _, init, _, pat, _, _, _) ->
            if carries(t, init)
                val steps = ptr_steps(t, init)

                bind_steps(t, cursor, steps)
                bind_name(t, cursor)

                // What the cursor hands out may sit in it, or be read through it.
                var each = element_steps(t, init)

                for s in steps
                    push_step(&each, s)

                bind_pattern(t, pat, each)
            end if
        _ -> ()
end bind_expr

// The steps an element of a sequence is read at: those of an array itself, one further through a view
// or a pointer.
private element_steps(t: &Track, seq: TExpr) -> Buf[int]
    val steps = ptr_steps(t, seq)

    if is_array_type(texpr_type(seq)) then return steps

    var out: Buf[int] = buf()

    for s in steps
        if s + 1 < t.steps then push_step(&out, s + 1)

    out
end element_steps

private bind_terms(t: &Track, cond: Buf[TCondTerm])
    for term in cond
        term match
            TCondIs(subject, patterns, _) ->
                if carries(t, subject)
                    for p in patterns
                        bind_pattern(t, p, ptr_steps(t, subject))
            _ -> ()
end bind_terms

// A name a pattern binds holds what its subject does, at the steps the subject was read at: a payload
// sits in place in the value matched.
private bind_pattern(t: &Track, p: TPattern, steps: Buf[int])
    var names: Buf[string] = buf()

    pattern_names(p, &names)

    for n in names
        bind_steps(t, n, steps)
        bind_name(t, n)
end bind_pattern

private bind(t: &Track, name: string, value: TExpr)
    if !carries(t, value) then return

    bind_steps(t, name, ptr_steps(t, value))
    bind_name(t, name)
end bind

// **A name bound to a pointer on the way is read through as that pointer is** -- at every step it may
// have been read at, since a local given a pointer read one step in and then one read two steps in
// holds either afterwards.
private bind_steps(t: &Track, name: string, steps: Buf[int])
    for s in steps
        if !has_step(t, name, s)
            t.ptrs.push((name, s))
            t.changed = true
        end if
end bind_steps

private has_step(t: &Track, name: string, s: int) -> bool
    for item in t.ptrs
        if item.0 == name && item.1 == s then return true

    false
end has_step

private bound_step(t: &Track, name: string) -> bool
    for item in t.ptrs
        if item.0 == name then return true

    false
end bound_step

private bind_name(t: &Track, name: string)
    if t.holds(name) then return

    t.held.push(name)
    t.changed = true
end bind_name

// The names a pattern binds.
pattern_names(p: TPattern, out: *Buf[string])
    p match
        TBindPattern(n, _) -> out.push(n)
        TAtPattern(n, inner) ->
            out.push(n)
            pattern_names(*inner, out)
        TVariantPattern(_, _, args) ->
            for a in args
                pattern_names(a, out)
        TStructPattern(_, args) ->
            for a in args
                pattern_names(a, out)
        _ -> ()
end pattern_names

// The local whose own storage a place is: a chain of field and element steps from it, never through a
// pointer or a reference, and a `ref` followed to what it names.
local_root(refs: Buf[(string, TExpr)], place: TExpr) -> Option[string]
    *place.kind match
        TLoad(n, _) ->
            for item in refs
                if item.0 == n then return local_root(refs, item.1)

            Some(n)
        TField(r, _, _) -> local_root(refs, r)
        TIndex(r, _, _) -> texpr_type(r) match
            Array(_, _) -> local_root(refs, r)
            _ -> None
        _ -> None
end local_root

// Whether a value carries what is tracked -- itself, or something built around it: a struct, a
// variant, a box, a closure's environment, a branch that yields it, an answer made of it.
//
// **Only a value that can hold an address carries one** -- a number, a flag, an enum or a struct with
// no pointer inside is never made of the argument, whatever it was computed from. A raw walk is the
// one exception: it follows an address through the integers it is computed with.
private carries(t: &Track, e: TExpr) -> bool = *e.kind match
    TLoad(n, ty) -> t.holds(n) && (t.raw || may_hold_pointer(t.cx, ty))

    // An address INTO the pointee is the same pointer moved along; the address of a local that holds
    // it is a pointer to it, one step further away.
    TAddrOf(place, _) -> into_pointee(t, place) || holds_local(t, place)
    TTempAddr(v, _) -> carries(t, v)
    TStructNew(_, args) -> holds_it(t, e) && any_carries(t, args)
    TEnumNew(_, _, args) -> holds_it(t, e) && any_carries(t, args)
    TArrayLit(elems, _) -> holds_it(t, e) && any_carries(t, elems)
    TArrayFill(v, _) -> holds_it(t, e) && carries(t, v)
    TBufLit(elems, _) -> holds_it(t, e) && any_carries(t, elems)
    TBufFill(v, _, _) -> holds_it(t, e) && carries(t, v)
    TBox(v, _) -> carries(t, v)
    TErase(v, _, _) -> carries(t, v)
    TDowngrade(v, _) -> carries(t, v)

    // **The address as an integer is the address**: `usize(p)` handed back or stored, or a call's
    // answer that is one, is held as `p` would be. An integer anything is done with after that -- put
    // in a local, converted again, `usize(p) + 8` -- is a number, which is the raw tier's.
    TCast(v, ty) -> (t.raw || may_hold_pointer(t.cx, ty) || (is_integer_type(ty) && address_of_it(v))) && carries(t, v)
    TFloorCast(v, ty) -> (t.raw || may_hold_pointer(t.cx, ty)) && carries(t, v)
    TStore(_, v, _, _) -> carries(t, v)
    TBinary(_, left, right, ty) ->
        (t.raw || may_hold_pointer(t.cx, ty)) && (carries(t, left) || carries(t, right))

    // What a call answers may be made of what it was handed. A callee with a body here says which of
    // its arguments its answer is made of; one through an object or a pointer may be made of any. An
    // integer is followed only through a body: a C function's number is not made of an address.
    // An answer that is a pointer on the way, read further in than what the walk follows, carries it
    // too (`call_steps`).
    TCall(name, args, ty, _) ->
        (may_hold_pointer(t.cx, ty) || (is_integer_type(ty) && t.cx.find(name).is_some())) &&
            (call_carries(t, name, args, ty) || (t.steps > 0 && !ptr_steps(t, e).is_empty()))
    TVCall(recv, _, args, ty, _) ->
        may_hold_pointer(t.cx, ty) && (carries(t, recv) || any_carries(t, args))
    TCallPtr(callee, args, _, ty) ->
        may_hold_pointer(t.cx, ty) && (carries(t, callee) || any_carries(t, args))
    TTry(operand, _, _, _, _, _, _) -> carries(t, operand)

    // A field of a value that carries it may be it, and so may a closure's capture read inside its
    // body. A field read through a pointer is somebody else's storage -- but one read out of a box
    // that carries it is the box's own, and for a walk of what is read through a parameter, anything
    // read through what carries it is what is followed.
    TField(r, _, ty) -> may_hold_pointer(t.cx, ty) && carries(t, r)
    TDeref(x, ty) -> may_hold_pointer(t.cx, ty) && (steps_in(t, x) || boxed(texpr_type(x))) && carries(t, x)
    TIndex(r, _, ty) -> may_hold_pointer(t.cx, ty) && (steps_in(t, r) || is_array_type(texpr_type(r))) && carries(t, r)

    // A view cut from, or seen as, what is read through is read through as well.
    TSlice(base, _, _, _, ty) -> t.through && may_hold_pointer(t.cx, ty) && carries(t, base)
    TConstView(v) -> t.through && carries(t, v)
    TViewAs(v, ty) -> t.through && may_hold_pointer(t.cx, ty) && carries(t, v)
    TRecheck(after, _, _, _) -> carries(t, after)
    TSeq(exprs) -> !exprs.is_empty() && carries(t, exprs.at(exprs.len() - 1))
    TIf(_, then_block, else_block, _) ->
        block_carries(t, then_block) || (else_block.is_some() && block_carries(t, else_block.unwrap()))
    TBlockExpr(b) -> block_carries(t, b)
    TMatch(_, arms, _) ->
        var any = false

        for arm in arms
            if block_carries(t, arm.body) then any = true

        any

    // A loop's value comes from its `break`s and its `else`.
    TWhile(_, body, else_block, _) -> loop_carries(t, body, else_block)
    TDoWhile(body, _, else_block, _) -> loop_carries(t, body, else_block)
    TLoop(body, _) -> loop_carries(t, body, None)
    TFor(_, _, _, _, _, body, else_block, _) -> loop_carries(t, body, else_block)
    TForEach(_, _, _, body, else_block, _) -> loop_carries(t, body, else_block)
    TIterate(_, _, _, _, _, body, else_block, _) -> loop_carries(t, body, else_block)
    TCFor(_, _, _, body, else_block, _) -> loop_carries(t, body, else_block)
    _ -> false

// A step through the tracked pointer into what it points at: `&p.x`, `&p[i]`, `&*p`.
private into_pointee(t: &Track, place: TExpr) -> bool = *place.kind match
    TDeref(x, _) -> carries(t, x)
    TField(r, _, _) -> into_pointee(t, r)
    // An element in place is inside the pointee; one of a view or a pointer read out of it is in
    // whatever storage that points at, which is not the pointee's.
    TIndex(r, _, _) -> texpr_type(r) match
        Array(_, _) -> into_pointee(t, r)
        Ptr(_) -> carries(t, r)
        _ -> false
    _ -> false

// Whether a value turned into an integer is an address, rather than a number already.
private address_of_it(v: TExpr) -> bool = !is_integer_type(texpr_type(v))

// Whether an argument hands what is tracked to the callee's keeps. **An integer parameter is not
// asked what it keeps**: a number a callee stores is how nearly every integer is used, so an address
// handed on as one is followed to a `ptr_cast` instead (`image_kept`, `image_passed`,
// `keeps_cast.sysl`).
private hands_on(t: &Track, arg: TExpr) -> bool = !is_integer_type(texpr_type(arg)) && carries(t, arg)

// Whether a value built around what is tracked can hold it: a struct with no pointer inside, built of
// `usize(p)`, is a number like any other.
private holds_it(t: &Track, e: TExpr) -> bool = t.raw || may_hold_pointer(t.cx, texpr_type(e))

private holds_local(t: &Track, place: TExpr) -> bool = *place.kind match
    TLoad(n, _) -> t.holds(n)
    _ -> false

private boxed(ty: Type) -> bool = ty match
    Ref(_, _) -> true
    _ -> false

is_array_type(ty: Type) -> bool = ty match
    Array(_, _) -> true
    _ -> false

private call_carries(t: &Track, name: string, args: Buf[TExpr], ty: Type) -> bool
    for i in 0..<args.len()
        if !carries(t, args.at(i)) then continue
        if answers_arg(t.cx, name, args, i, ty, t.raw) then return true
        if reads_on(t, args.at(i)) && answers_read(t, name, args, i) then return true

    false
end call_carries

private answers_read(t: &Track, name: string, args: Buf[TExpr], i: usize) -> bool
    if t.steps == 0 then return through_answers_of(t.cx, name, i)

    for k in steps_left(t, args.at(i))
        if read_answers_of(t.cx, name, i, k) then return true

    false
end answers_read

private any_carries(t: &Track, es: Buf[TExpr]) -> bool
    for item in es
        if carries(t, item) then return true

    false
end any_carries

private block_carries(t: &Track, b: TBlock) -> bool = b.result.is_some() && carries(t, b.result.unwrap())

private loop_carries(t: &Track, body: Buf[TStmt], else_block: Option[TBlock]) -> bool
    for v in own_break_values(body)
        if carries(t, v) then return true

    else_block.is_some() && block_carries(t, else_block.unwrap())
end loop_carries

// Whether a value of this type can hold a raw pointer, through a box as well as in place: a box of a
// struct that holds one holds it too, and an object behind a trait -- a closure behind a `&Fn` among
// them -- may hold anything, its type saying nothing of what it captured.
//
// Asked of nearly every value a body passes around, so a struct's or an enum's answer is worked out
// once per compilation.
//
// **A pointer to an `opaque struct` is a handle, never an address of anybody's frame**: a type with
// no layout cannot be a local, a field or an element, so the storage it points at is C's. Making one
// out of a local's address takes a `ptr_cast`, which is the raw tier.
may_hold_pointer(cx: &KeepsCx, t: Type) -> bool = t match
    Ptr(inner) -> !is_opaque_struct(*inner)
    Trait(_, _, _) -> true
    Ref(inner, _) -> may_hold_pointer(cx, *inner)
    Weak(inner) -> may_hold_pointer(cx, *inner)
    Volatile(inner) -> may_hold_pointer(cx, *inner)
    Array(_, elem) -> may_hold_pointer(cx, *elem)
    Slice(elem, _) -> may_hold_pointer(cx, *elem)
    Struct(d) -> aggregate_holds(cx, t, if d.targs.is_empty() then d.base else type_show(t))
    Enum(d) -> aggregate_holds(cx, t, if d.targs.is_empty() then d.base else type_show(t))
    _ -> false

private aggregate_holds(cx: &KeepsCx, t: Type, key: string) -> bool
    cx.pointerish.get(key) match
        Some(v) -> return v
        None -> ()

    var seen: Buf[string] = buf()
    val out = holds_pointer_within(t, &seen)

    cx.pointerish.put(key, out)
    out
end aggregate_holds

// The same, with the structs and enums already being asked about, which a type reaching itself
// through a box answers nothing new for.
private holds_pointer_within(t: Type, seen: *Buf[string]) -> bool = t match
    Ptr(inner) -> !is_opaque_struct(*inner)
    Trait(_, _, _) -> true
    Ref(inner, _) -> holds_pointer_within(*inner, seen)
    Weak(inner) -> holds_pointer_within(*inner, seen)
    Volatile(inner) -> holds_pointer_within(*inner, seen)
    Array(_, elem) -> holds_pointer_within(*elem, seen)
    Slice(elem, _) -> holds_pointer_within(*elem, seen)
    // **A closure literal with captures may hold the address of each `var` it captures** (`closure_mode.sysl`),
    // and whether it does is what this analysis is asked to decide -- so its value is followed
    // wherever it goes, whatever its fields say before the decision.
    Struct(d) -> (is_closure_literal(t) && !d.fields.is_empty()) ||
        (first_visit(t, seen) && fields_hold_pointer(d.fields, seen))
    Enum(d) -> first_visit(t, seen) && variants_hold_pointer(d.variants, seen)
    _ -> false

private is_opaque_struct(t: Type) -> bool = t match
    Struct(d) -> d.opaque
    _ -> false

// Whether a value of this type can BE, or hold in place, an address somebody lent -- as against an
// object behind a reference, which holds only what was captured or stored into it when it was made,
// and is checked there.
private holds_raw_pointer(t: Type, depth: int) -> bool
    if depth > 6 then return false

    t match
        Ptr(inner) -> !is_opaque_struct(*inner)
        Volatile(inner) -> holds_raw_pointer(*inner, depth + 1)
        Array(_, elem) -> holds_raw_pointer(*elem, depth + 1)
        Slice(elem, _) -> holds_raw_pointer(*elem, depth + 1)
        Struct(d) ->
            if is_closure_literal(t) then return false

            for item in d.fields
                if holds_raw_pointer(item.1, depth + 1) then return true

            false
        Enum(d) ->
            for v in d.variants
                for item in v.fields
                    if holds_raw_pointer(item.1, depth + 1) then return true

            false
        _ -> false
end holds_raw_pointer

private first_visit(t: Type, seen: *Buf[string]) -> bool
    val key = type_show(t)

    if holds_string(*seen, key) then return false

    seen.push(key)
    true
end first_visit

private fields_hold_pointer(fields: Buf[(string, Type)], seen: *Buf[string]) -> bool
    for item in fields
        if holds_pointer_within(item.1, seen) then return true

    false
end fields_hold_pointer

private variants_hold_pointer(vs: Buf[EnumVariant], seen: *Buf[string]) -> bool
    for v in vs
        if fields_hold_pointer(v.fields, seen) then return true

    false
end variants_hold_pointer

// -- the rule at the call ---------------------------------------------------------------------------

// What one body's check follows: the locals that hold the address of the frame's own storage, and
// what that storage is, as the refusal says it.
struct FrameTrack
    cx: &KeepsCx
    faults: &KeepFaults
    scope: Scope
    owner: string
    params: Buf[(string, Type)]
    held: Buf[(string, string)]
    refs: Buf[(string, TExpr)]
    changed: bool
    org: &Origins
    hs: &Handles
    func: TFunc

    // The locals bound once to a pointer, each with what it was bound to (`frame_lasting`).
    inits: Buf[(string, TExpr)]

    // **What a read through an argument reaches of this frame** (`read_cores`, `frame_closed`): every
    // value put into a local's own storage -- its initializer, each store into it or a field or element
    // of it, a name a pattern or a loop binds (`true`: an element of the value, or one read through it)
    // -- every store through a pointer, and every call, which may store what it reads through one
    // argument into what another reaches. `points` is what they come to, worked out the first time a
    // walk asks (`settle_points`): each local's storage, with every local whose address it may hold
    // and how the refusal says that address -- `?` for an address from anywhere else. `flat` is the
    // locals whose type holds no address, which nothing is put into.
    binds: Buf[(string, TExpr, bool)]
    flat: Buf[string]
    stores: Buf[(TExpr, TExpr)]
    calls: Buf[TExpr]
    points: Buf[(string, string, string)]
    pointed: bool

    // Whether this walk is the probe that decides closures' capture modes (`probe_frame`): what it
    // follows is the closure literals rather than the frame's addresses.
    probe: bool

    // What a local holds. **A probe joins everything it was bound to**, since each closure a local
    // may hold is decided on its own; the rule's own walk names the first thing, as its refusal does.
    core_of(self, name: string) -> Option[string]
        var all = ""

        for item in self.held
            if item.0 == name
                if !self.probe then return Some(item.1)

                all = all + item.1
            end if
        end for

        if all == "" then None else Some(all)
    end core_of
end FrameTrack

// Every call in one body that hands a keeping parameter the address of this frame's storage.
//
// **The entry file's statements are the one body passed over**: their frame is the program's, laid
// down before anything else runs and given back only as the program ends, so nothing kept from it can
// outlive it.
private check_calls(cx: &KeepsCx, faults: &KeepFaults, f: TFunc) = frame_walk(cx, faults, f, false)

// Where each closure literal a body builds may be reached after the frame, or a block, it was built
// in: the closures whose value the rule would refuse to let out if each held the address of the
// variables it captures (`docs/design/closures.md` §3.1). **This is the rule's own walk** with the
// closure literal as the thing followed, so it reaches everything the rule reaches -- a keeping
// callee, a return, module storage, a parameter's storage, a task held at a way out -- and three
// things the rule does not refuse a pointer for, which a closure is still held by value at: a
// `@scoped`, `@crossing` or `@joined` parameter, a thread, and a conversion to `&sync`.
//
// **The entry file's statements are walked too**: their frame outlives every call, but a closure
// stored where something may run it after them is still one that escapes.
//
// **Each closure comes back with the reason it escapes**, in words that follow "since": what a probe
// gathers is the closures it followed, each by its marker, and then the reason (`probe_why`).
probe_frame(cx: &KeepsCx, f: TFunc) -> Buf[(string, string)]
    val faults: &KeepFaults = KeepFaults(buf())

    frame_walk(cx, faults, f, true)

    var out: Buf[(string, string)] = buf()

    for item in faults.items
        val why = probe_reason(item.2)

        for base in closure_markers_in(item.2)
            var again = false

            for o in out
                if o.0 == base then again = true

            if !again then out.push((base, why))
        end for
    end for

    out
end probe_frame

// How a probe names a closure literal in what it gathers: brackets no identifier can hold.
closure_marker(base: string) -> string = s"«$base»"

// What a probe gathers about the closures `core` names: their markers, then why they escape.
probe_why(core: string, why: string) -> string = core + why

// The reason in what a probe gathered: everything after its last marker.
probe_reason(text: string) -> string = text.last_index_of("»") match
    Some(at) -> text[at + "»".bytes.len..<text.bytes.len]
    None -> text

// Where a probe found a closure escaping, as its reason says it.
probe_line(scope: Scope, at: Span) -> string = s"on line ${scope.src.locate(at.start).line}"

// Every closure a probe's text names.
closure_markers_in(text: string) -> Buf[string]
    var out: Buf[string] = buf()
    var rest = text

    loop
        val open = rest.index_of("«")

        if open.is_none() then return out

        rest = rest[open.unwrap() + "«".bytes.len..<rest.bytes.len]

        val close = rest.index_of("»")

        if close.is_none() then return out

        out.push(rest[0..<close.unwrap()])
        rest = rest[close.unwrap() + "»".bytes.len..<rest.bytes.len]
    end loop
end closure_markers_in

private frame_walk(cx: &KeepsCx, faults: &KeepFaults, f: TFunc, probe: bool)
    if !probe && module_bare(f.name) == "entry file" then return

    val org = origins_of(cx, f)
    val ft: &FrameTrack = FrameTrack(cx, faults, func_home(cx.an, f.name), shown_name(cx.an, f.name),
                                     f.params, buf(), buf(), false, org, round_handles(cx, org, f), f, buf(),
                                     buf(), buf(), buf(), buf(), buf(), false, probe)

    walk_block_stmts(f.body, stmt_walk(false, s -> s match
        TRefDecl(n, _, place) -> ft.refs.push((n, place))
        TVarDecl(n, ty, init, _) -> if may_hold_pointer(cx, ty) && stable_name(org, n) != "" then ft.inits.push((n, init))
        _ -> ()))

    if !probe
        walk_block_stmts(f.body, TWalk(false, e -> note_point_expr(ft, e), w -> note_point_store(ft, w.place, w.value),
                                       s -> s match
            TVarDecl(n, ty, init, _) ->
                if may_hold_pointer(cx, ty) then ft.binds.push((n, init, false)) else ft.flat.push(n)
            _ -> ()))

        for p in f.params
            if !may_hold_pointer(cx, p.1) then ft.flat.push(p.0)
    end if

    ft.changed = true

    while ft.changed
        ft.changed = false

        walk_block_stmts(f.body, TWalk(false, e -> frame_bind_expr(ft, e),
                                       w -> frame_bind_store(ft, w.place, w.value),
                                       s -> frame_bind_stmt(ft, s)))

    // What is handed somewhere that a clear may yet take back is refused only if it is still there
    // at a way out.
    val w = flow_walk(ft.org, s -> frame_stmt_events(ft, s), e -> frame_expr_events(ft, e),
                      (x, p, matched) -> arm_clears(ft.hs, x, p, matched))

    flow_body(w, f.body)

    for item in w.out_pending
        ft.faults.items.push((ft.scope, item.at, item.how))

    // **Only an answer that can hold an address hands one back**: a body whose last expression is a
    // call answering a pointer, in a function that answers nothing, throws the pointer away. An
    // integer answer may be an address as an integer (`returned_image`).
    if !may_hold_pointer(cx, f.ret_ty) && !is_integer_type(f.ret_ty) then return

    walk_block_stmts(f.body, stmt_walk(false, s -> s match
        TReturn(v) -> if v.is_some() then returned_frame(ft, v.unwrap())
        _ -> ()))

    if f.body.result.is_some() then returned_frame(ft, f.body.result.unwrap())
end frame_walk

// **A pointer handed back is lent for as long as what it was made of**, so a function may not hand
// back one made of its own frame's storage -- through a local that holds the address, a struct built
// around it, or a call whose answer is made of it. The address written in place (`&n`) is the escape
// check's (`escape.sysl`'s `refuse_dangling`), which this leaves to it.
private returned_frame(ft: &FrameTrack, v: TExpr)
    val image = is_integer_type(texpr_type(v))

    *v.kind match
        TAddrOf(_, _) -> ()
        TTempAddr(_, _) -> ()
        TCast(x, _) ->
            // A pointer made of an integer is a pointer, whatever the integer was made of.
            if image || is_integer_type(texpr_type(x)) then returned_core(ft, v, image) else returned_frame(ft, x)
        TBlockExpr(b) -> returned_block(ft, b)
        TIf(_, then_block, else_block, _) ->
            returned_block(ft, then_block)

            if else_block.is_some() then returned_block(ft, else_block.unwrap())
        TMatch(_, arms, _) ->
            for arm in arms
                returned_block(ft, arm.body)
        _ -> returned_core(ft, v, image)
end returned_frame

private returned_core(ft: &FrameTrack, v: TExpr, image: bool)
    val core = frame_core(ft, v)

    if core.is_none() then return

    if ft.probe
        ft.faults.items.push((ft.scope, v.span, probe_why(core.unwrap(),
            s"it is returned from '${ft.owner}' ${probe_line(ft.scope, v.span)}")))
        return
    end if

    if !image
        ft.faults.items.push((ft.scope, v.span,
            s"'${value_text(ft.scope, v)}' is returned, but it holds ${core.unwrap()}, whose storage ends " +
            s"when '${ft.owner}' returns — return the value itself, or take the storage from the caller " +
            "as a '*T' parameter"))
        return
    end if

    // **An address as an integer handed back is a number until something turns it back into a
    // pointer**: measuring a stack by `usize(&marker)` is the integer's whole use. Only one a
    // `ptr_cast` may make a pointer of again is refused, since that pointer is into a frame that is gone.
    val cast = cast_reach(ft.cx, s"r:${ft.func.name}", false)

    if cast.is_none() then return

    ft.faults.items.push((ft.scope, v.span,
        s"'${value_text(ft.scope, v)}' is returned, but it holds ${core.unwrap()} as an integer, which " +
        s"'${shown_name(ft.cx.an, cast.unwrap())}' turns back into a pointer with 'ptr_cast' after the " +
        s"storage has ended with '${ft.owner}' — return the value itself, or take the storage from the " +
        "caller as a '*T' parameter"))
end returned_core

private returned_block(ft: &FrameTrack, b: TBlock) =
    if b.result.is_some() then returned_frame(ft, b.result.unwrap())

private frame_bind_stmt(ft: &FrameTrack, s: TStmt)
    s match
        TVarDecl(n, _, init, _) -> frame_bind(ft, n, init)
        _ -> ()
end frame_bind_stmt

private frame_bind_expr(ft: &FrameTrack, e: TExpr)
    *e.kind match
        TStore(place, v, _, _) -> frame_bind_store(ft, place, v)
        TCall(name, args, _, _) -> frame_bind_call(ft, name, args)
        TCallPtr(callee, args, _, _) -> frame_bind_ptr_call(ft, callee, args)
        TVCall(recv, slot, args, _, _) -> frame_bind_vcall(ft, recv, slot, args)
        _ -> if ft.probe then probe_bind_patterns(ft, e)
end frame_bind_expr

// For a probe, a call through an object that keeps what it is handed (the receiver first) in what
// another of them points at, where that one points into this frame or is reached through its local.
private frame_bind_vcall(ft: &FrameTrack, recv: TExpr, slot: int, args: Buf[TExpr])
    if !ft.probe then return

    val all = with_receiver(recv, args)

    for k in 0..<all.len()
        val arg = all.at(k)

        if !may_hold_pointer(ft.cx, texpr_type(arg)) then continue

        val core = frame_core(ft, arg)

        if core.is_none() then continue

        for item in frame_vcall_locs(ft, recv, slot, k, arg)
            if item.1.loc == "j" then continue

            val loc = translate_loc(ft.org, all, item.1.loc)

            if loc.starts_with("l:") then frame_hold(ft, local_of(loc), core.unwrap())
            else probe_hold_kept(ft, all, item.1.loc, core.unwrap())
    end for
end frame_bind_vcall

// **A name a pattern binds holds what its subject holds**, for a probe: a closure matched out of an
// `Option` and handed on is the closure literal going there (`Some(g) -> install(g)`). The forms are
// the ones `bind_expr` reads -- a `match`'s arms, an `is` test, a `for` over a sequence, an
// iteration's cursor -- and each name is taken to hold every closure the subject does.
private probe_bind_patterns(ft: &FrameTrack, e: TExpr)
    *e.kind match
        TMatch(scrutinee, arms, _) ->
            for arm in arms
                for p in arm.patterns
                    probe_bind_pattern(ft, p, scrutinee)
        TIf(cond, _, _, _) -> probe_bind_terms(ft, cond)
        TWhile(cond, _, _, _) -> probe_bind_terms(ft, cond)
        TForEach(name, _, seq, _, _, _) -> frame_bind(ft, name, seq)
        TIterate(cursor, _, init, _, pat, _, _, _) ->
            frame_bind(ft, cursor, init)
            probe_bind_pattern(ft, pat, init)
        _ -> ()
end probe_bind_patterns

private probe_bind_terms(ft: &FrameTrack, cond: Buf[TCondTerm])
    for term in cond
        term match
            TCondIs(subject, patterns, _) ->
                for p in patterns
                    probe_bind_pattern(ft, p, subject)
            _ -> ()

private probe_bind_pattern(ft: &FrameTrack, p: TPattern, subject: TExpr)
    var names: Buf[string] = buf()

    pattern_names(p, &names)

    for n in names
        frame_bind(ft, n, subject)
end probe_bind_pattern

private frame_bind_ptr_call(ft: &FrameTrack, callee: TExpr, args: Buf[TExpr])
    for j in 0..<args.len()
        val arg = args.at(j)

        if !may_hold_pointer(ft.cx, texpr_type(arg)) then continue

        val core = frame_core(ft, arg)

        if core.is_none() then continue

        for item in frame_pointer_locs(ft, callee, j, arg)
            val loc = translate_loc(ft.org, args, item.1.loc)

            if loc.starts_with("l:") then frame_hold(ft, local_of(loc), core.unwrap())
            else if ft.probe then probe_hold_kept(ft, args, item.1.loc, core.unwrap())
end frame_bind_ptr_call

// A store into this frame's own storage -- by name, or through a pointer that points into it.
private frame_bind_store(ft: &FrameTrack, place: TExpr, v: TExpr)
    local_root(ft.refs, place) match
        Some(n) -> frame_bind(ft, n, v)
        None ->
            val loc = place_loc(ft.org, place)

            if loc.starts_with("l:") then frame_bind(ft, local_of(loc), v)
            else if ft.probe then probe_hold_through(ft, place, v)
end frame_bind_store

// **For a probe, a closure stored into what a local points at is held by that local**: a heap object
// this frame made (`r.p = Some(keep(f))`), an element of a `Buf` it holds. Where the object goes, the
// closure goes -- returned, stored, handed to a keeper -- so the local is followed as holding it. A
// parameter's pointee is storage that outlasts the frame already (`frame_stored`).
private probe_hold_through(ft: &FrameTrack, place: TExpr, v: TExpr)
    val root = pointee_root(ft, place)

    if root.is_some() then frame_bind(ft, root.unwrap(), v)
end probe_hold_through

// The local whose pointer a place is reached through, past fields, elements and dereferences; not a
// parameter.
private pointee_root(ft: &FrameTrack, place: TExpr) -> Option[string]
    *place.kind match
        TLoad(n, _) ->
            for item in ft.refs
                if item.0 == n then return pointee_root(ft, item.1)

            for p in ft.params
                if p.0 == n then return None

            Some(n)
        TField(r, _, _) -> pointee_root(ft, r)
        TIndex(r, _, _) -> pointee_root(ft, r)
        TDeref(x, _) -> pointee_root(ft, x)
        _ -> None
end pointee_root

// A callee that stores an argument into what another argument points at, where that one points into
// this frame: the local it points into holds the first.
private frame_bind_call(ft: &FrameTrack, name: string, args: Buf[TExpr])
    for j in 0..<args.len()
        val arg = args.at(j)

        if !may_hold_pointer(ft.cx, texpr_type(arg)) then continue

        val core = frame_core(ft, arg)

        if core.is_some()
            for pair in frame_call_locs(ft, name, j, arg)
                val loc = translate_loc(ft.org, args, pair.0.loc)

                if loc.starts_with("l:") then frame_hold(ft, local_of(loc), core.unwrap())
                else if ft.probe then probe_hold_kept(ft, args, pair.0.loc, core.unwrap())
        end if

        // What the callee copies out of what it reads through the argument into a local's storage --
        // `copy(&into, &h)` -- makes that local hold what was read.
        for r in frame_read_locs(ft, name, j, arg)
            val loc = translate_loc(ft.org, args, r.1.loc)

            if loc.starts_with("l:") then frame_hold(ft, local_of(loc), r.2)
    end for
end frame_bind_call

// **For a probe, a callee keeping an argument in what another argument points at, where that one is
// reached through a local, makes the local hold it** (`r.items.push(f)`, `install(r, f)`).
private probe_hold_kept(ft: &FrameTrack, args: Buf[TExpr], callee_loc: string, core: string)
    for k in 0..<args.len()
        if !callee_loc.starts_with(s"p$k:") && !callee_loc.starts_with(s"d:p$k:") then continue

        pointee_root(ft, args.at(k)) match
            Some(n) -> frame_hold(ft, n, core)
            None -> ()
    end for
end probe_hold_kept

// What one statement does with this frame's storage: the locations it overwrites at its top, and
// every location outside the frame an address of its storage is handed to.
private frame_stmt_events(ft: &FrameTrack, s: TStmt) -> Buf[FlowEv]
    val evs: &EvBuf = EvBuf(buf())

    stmt_moves(ft.cx, evs, s)
    ft.hs.at = stmt_handle(ft.hs, s)

    s match
        TWriteStmt(w) -> frame_clear_store(ft, evs, w.place, w.value)
        TMultiAssign(writes) ->
            for item in writes
                frame_clear_store(ft, evs, item.place, item.value)
        TExprStmt(e) -> frame_top_clears(ft, evs, e)
        TVarDecl(_, _, init, _) -> frame_top_clears(ft, evs, init)
        _ -> ()

    walk_stmt(s, TWalk(false, e -> frame_event_at(ft, evs, e), w -> frame_stored(ft, evs, w.place, w.value),
                       x -> ()))
    fan_stmt_events(ft.hs, evs, s)
    ft.hs.at = ""
    evs.items
end frame_stmt_events

private frame_expr_events(ft: &FrameTrack, e: TExpr) -> Buf[FlowEv]
    val evs: &EvBuf = EvBuf(buf())

    piece_moves(ft.cx, evs, e)
    ft.hs.at = expr_handle(ft.hs, e)
    frame_top_clears(ft, evs, e)
    walk_texpr(e, TWalk(false, x -> frame_event_at(ft, evs, x), w -> frame_stored(ft, evs, w.place, w.value),
                        s -> ()))
    fan_events(ft.hs, evs, e.span)
    ft.hs.at = ""
    evs.items
end frame_expr_events

private frame_top_clears(ft: &FrameTrack, evs: &EvBuf, e: TExpr)
    *e.kind match
        TStore(place, v, _, _) -> frame_clear_store(ft, evs, place, v)
        TCall(name, args, _, _) ->
            for c in clears_of(ft.cx, name).locs
                val loc = translate_loc(ft.org, args, c.loc)

                if loc != "" && !loc.starts_with("l:") then evs.items.push(FlowEv(true, loc, "", e.span))
        _ -> ()
end frame_top_clears

private frame_clear_store(ft: &FrameTrack, evs: &EvBuf, place: TExpr, v: TExpr)
    if may_hold_pointer(ft.cx, texpr_type(v)) && frame_core(ft, v).is_some() then return

    val loc = place_loc(ft.org, place)

    if loc != "" && !loc.starts_with("l:") then evs.items.push(FlowEv(true, loc, "", v.span))
end frame_clear_store

private frame_event_at(ft: &FrameTrack, evs: &EvBuf, e: TExpr)
    *e.kind match
        TStore(place, v, _, _) -> frame_stored(ft, evs, place, v)
        TAwait(task, _) -> await_clear(ft.hs, evs, task, e.span)
        TBlockOn(task, _) -> await_clear(ft.hs, evs, task, e.span)
        TCall(_, _, _, _) -> call_at(ft, evs, e)
        TVCall(_, _, _, _, _) -> call_at(ft, evs, e)
        TCallPtr(_, _, _, _) -> call_at(ft, evs, e)
        TStep(_, wake) -> step_waker_at(ft, wake)
        TErase(v, _, ty) -> if ft.probe then probe_synced(ft, e.span, v, ty)
        TBox(v, ty) -> if ft.probe then probe_synced(ft, e.span, v, ty)
        _ -> ()
end frame_event_at

// **The waker handed to `step` is kept by the task**: every `park` in it, this step's or one woken
// long after the step returned, calls that waker, so it outlives the frame that built it whatever
// becomes of the step's answer.
private step_waker_at(ft: &FrameTrack, wake: TExpr)
    val core = frame_core(ft, wake)

    if core.is_none() then return

    var said = s"'step' keeps its waker for the task's parks, and ${argument_said(ft, wake, core.unwrap())} — " +
        "hand it storage that lasts"

    if ft.probe
        said = probe_why(core.unwrap(), s"it is handed to 'step' ${probe_line(ft.scope, wake.span)} as the " +
                         "waker, which the task keeps for its parks")
    end if

    ft.faults.items.push((ft.scope, wake.span, said))
end step_waker_at

// **An address of this frame's storage written through a parameter or into module storage outlives
// the frame**, unless it is overwritten before every way out. **Written anywhere the frame cannot show
// is its own** -- through a pointer a call answered, one read out of a `Buf` or a heap object someone
// else made -- it may outlive the frame whatever the frame does next, so it is refused at the store.
private frame_stored(ft: &FrameTrack, evs: &EvBuf, place: TExpr, v: TExpr)
    val image = is_integer_type(texpr_type(v))

    if !may_hold_pointer(ft.cx, texpr_type(v)) && !image then return

    val core = frame_core(ft, v)

    if core.is_none() then return

    val loc = place_loc(ft.org, place)

    if !frame_lasting(ft, loc, 0)
        if image || probe_own_place(ft, place) then return

        if ft.probe
            if loc.starts_with("l:") then return

            ft.faults.items.push((ft.scope, v.span, probe_why(core.unwrap(),
                s"it is stored in '${place_written(ft.scope, place)}' ${probe_line(ft.scope, v.span)}, which " +
                s"'${ft.owner}' cannot show is its own storage")))
            return
        end if

        // The rule asks the place's shape, not its location: a location names a call's answer by the
        // argument it may be made of (`pick(&s).p` is `l:s.p`), which says nothing of what else it may
        // answer.
        if rule_own_place(ft, place) then return

        ft.faults.items.push((ft.scope, v.span, s"${argument_said(ft, v, core.unwrap())}, and it is stored in " +
            s"'${place_written(ft.scope, place)}', which '${ft.owner}' cannot show is its own storage — store " +
            "the value itself, or storage that lasts"))
        return
    end if

    // **An address as an integer stored where it outlives the frame is a number** -- a stack's top
    // remembered to measure its depth by -- **until a `ptr_cast` may turn it back into a pointer**.
    var turned = ""

    if image
        val keys = cast_keys_of(ft.cx, ft.func, place)

        for k in keys
            if turned == "" then turned = cast_reach(ft.cx, k, false).unwrap_or("")

        if turned == "" then return
    end if

    val back = if image then s" and '${shown_name(ft.cx.an, turned)}' turns back into a pointer with 'ptr_cast'" else ""
    var said = s"${argument_said(ft, v, core.unwrap())}, and it is stored in " +
        s"'${place_said(ft.scope, place)}', which outlives '${ft.owner}'$back — store the value itself, or " +
        "storage that lasts"

    if ft.probe
        said = probe_why(core.unwrap(), s"it is stored in '${place_said(ft.scope, place)}' " +
                         s"${probe_line(ft.scope, v.span)}, which outlives '${ft.owner}'")
    end if

    if loc.index_of("?").is_some() then ft.faults.items.push((ft.scope, v.span, said))
    else evs.items.push(FlowEv(false, loc, said, v.span))
end frame_stored

// **For a probe, a closure stored anywhere but this frame's own storage outlives the frame**: through
// a pointer a call answered (`current().sink = f`), one read out of a field or a global, a `Buf` or a
// slice -- storage that someone else may hold, whatever the frame does next. A place is the frame's
// own when it is reached, by fields and array elements only, from a local bound once to an object
// this frame made (`val r: &R = R(…)`), which `probe_hold_through` follows as holding what is stored.
private probe_own_place(ft: &FrameTrack, place: TExpr) -> bool
    *place.kind match
        TField(r, _, _) -> probe_own_place(ft, r)
        TIndex(r, _, _) -> is_array_type(texpr_type(r)) && probe_own_place(ft, r)
        TDeref(x, _) -> *x.kind match
            TLoad(_, _) -> probe_own_place(ft, x)
            _ -> false
        TLoad(n, _) ->
            for item in ft.refs
                if item.0 == n then return probe_own_place(ft, item.1)

            for item in ft.inits
                if item.0 == n
                    return *item.1.kind match
                        TBox(_, _) -> true
                        TStructNew(_, _) -> true
                        _ -> false
                end if
            end for

            false
        _ -> false
end probe_own_place

// **For the rule, a place is also the frame's own when it is reached through a pointer the frame
// took to its own storage**: a local, a field or element of one in place, or what a local bound once
// to `&place` of such storage points at (`val q = &s` then `q.p = &n`), at any depth of such locals.
// A call's answer is not -- even one answering its argument, since what else it may answer is no
// question the summaries ask -- nor a parameter's contents, module storage, or a `Buf`'s elements.
private rule_own_place(ft: &FrameTrack, place: TExpr) -> bool
    *place.kind match
        TLoad(n, _) ->
            for item in ft.refs
                if item.0 == n then return rule_own_place(ft, item.1)

            true
        TField(r, _, _) -> rule_own_place(ft, r)
        TIndex(r, _, _) -> is_array_type(texpr_type(r)) && rule_own_place(ft, r)
        TDeref(x, _) -> rule_own_through(ft, x, 0)
        _ -> false
end rule_own_place

private rule_own_through(ft: &FrameTrack, x: TExpr, depth: int) -> bool
    if depth > 8 then return false

    *x.kind match
        TAddrOf(place, _) -> rule_own_place(ft, place)
        TLoad(n, _) ->
            for item in ft.refs
                if item.0 == n then return rule_own_place(ft, item.1)

            for item in ft.inits
                if item.0 == n
                    return *item.1.kind match
                        TBox(_, _) -> true
                        TStructNew(_, _) -> true
                        _ -> rule_own_through(ft, item.1, depth + 1)
                end if
            end for

            false
        _ -> false
end rule_own_through

// A place reached through calls as the reader wrote it, with the bracket closing a subscript that
// ends it.
private place_written(scope: Scope, place: TExpr) -> string
    val at = written_through(scope, place)
    val closes = at.end < scope.src.bytes.len && scope.src.bytes[at.end] == u8(']')

    source_text(scope, if closes then Span(at.start, at.end + 1) else at)
end place_written

// Where a place reached through calls is written in full: a field's span is its name, a method call's
// is its name and arguments, and a `Buf` element's is its subscript, so the receiver each is reached
// through is joined in (`world().vm_of().sink`, `current().fs[0]`).
private written_through(scope: Scope, place: TExpr) -> Span
    var parts: Buf[TExpr] = buf()

    *place.kind match
        TField(r, _, _) -> parts.push(r)
        TIndex(r, i, _) ->
            parts.push(r)
            parts.push(i)
        TDeref(x, _) -> parts.push(x)
        TCall(_, args, _, _) -> written_args(scope, place.span, args, &parts)
        TVCall(recv, _, args, _, _) ->
            parts.push(recv)
            written_args(scope, place.span, args, &parts)
        _ -> ()

    var start = place.span.start
    var stop = place.span.end

    for part in parts
        val at = written_through(scope, part)

        if at.start < start then start = at.start
        if at.end > stop then stop = at.end
    end for

    Span(start, stop)
end written_through

// **The arguments a call's text holds**: those overlapping its span, and those written against it -- a
// receiver just before (`world().items` before `[`) or a subscript just after (`0` after `[`), joined
// by nothing, a dot or spaces. One the compiler supplies is neither -- a call in a file with no `main`
// is handed a `self` spanning the callee's declaration -- and is no part of the place as written.
private written_args(scope: Scope, call: Span, args: Buf[TExpr], parts: *Buf[TExpr])
    for a in args
        val written = written_through(scope, a)

        val inside = written.start < call.end && written.end > call.start
        val before = written.end <= call.start && only_joiners(scope, written.end, call.start)
        val after = written.start >= call.end && only_joiners(scope, call.end, written.start)

        if inside || before || after then parts.push(a)
    end for
end written_args

// Whether the source between two offsets holds nothing but what joins a receiver to its member, or a
// call's name to its arguments: dots, parentheses and spaces (a call's span is its name alone, so
// `world` is joined to `.s_of` by `().`).
private only_joiners(scope: Scope, from: usize, to: usize) -> bool
    for at in from..<to
        val b = scope.src.bytes[at]

        if b != u8('.') && b != u8(' ') && b != u8('(') && b != u8(')') then return false
    end for

    true
end only_joiners

// **Storage outlives the frame when it is module storage or reached through a parameter** -- by a
// path the body names (`p0:.next`), or through a pointer read out of one (`d:p0:.vm>{*M}.con`), the
// same storage whichever local the pointer was first read into (`d:@vm`, `frame_inits`).
private frame_lasting(ft: &FrameTrack, loc: string, depth: int) -> bool
    if loc.starts_with("g:") || loc.starts_with("p") || loc.starts_with("d:g:") || loc.starts_with("d:p") then return true
    if !loc.starts_with("d:@") || depth > 8 then return false

    val n = local_of(loc[1..<loc.bytes.len])

    for item in ft.inits
        if item.0 != n then continue

        val at = *item.1.kind match
            TLoad(m, _) -> stable_name(ft.org, m)
            _ -> place_loc(ft.org, item.1)

        return frame_lasting(ft, at, depth + 1)
    end for

    false
end frame_lasting

private frame_bind(ft: &FrameTrack, name: string, v: TExpr)
    if !ft.probe && ft.core_of(name).is_some() then return

    frame_core(ft, v) match
        Some(core) -> frame_hold(ft, name, core)
        None -> ()
end frame_bind

// `name` holds `core`. The rule's walk keeps the first thing a local holds; a probe keeps each closure
// it may hold, and stops once a round adds none.
private frame_hold(ft: &FrameTrack, name: string, core: string)
    if !ft.probe
        if ft.core_of(name).is_some() then return

        ft.held.push((name, core))
        ft.changed = true
        return
    end if

    val had = ft.core_of(name).unwrap_or("")

    for base in closure_markers_in(core)
        if had.index_of(closure_marker(base)).is_none()
            ft.held.push((name, closure_marker(base)))
            ft.changed = true
        end if
end frame_hold

// A call handing the address of this frame's storage to a parameter the callee keeps. Where the
// callee holds it in module storage or in what this function's own parameter points at, a clear
// before every way out may yet take it back; anywhere else it is refused here.
private call_at(ft: &FrameTrack, evs: &EvBuf, e: TExpr)
    *e.kind match
        TCall(name, args, _, _) ->
            join_clear(ft.hs, evs, name, args, e.span)

            for j in 0..<args.len()
                val arg = args.at(j)

                if is_integer_type(texpr_type(arg))
                    image_passed(ft, e, name, j, arg)
                    continue
                end if

                if !may_hold_pointer(ft.cx, texpr_type(arg)) then continue

                val core = frame_core(ft, arg)
                val reads = frame_read_locs(ft, name, j, arg)

                if core.is_none() && reads.is_empty() then continue

                if ft.probe
                    val apart = probe_held_apart(ft, e, name, j)

                    if apart.is_some()
                        ft.faults.items.push((ft.scope, arg.span, probe_why(core.unwrap(),
                            s"it is handed to '${shown_name(ft.cx.an, name)}' ${probe_line(ft.scope, arg.span)}, " +
                            apart.unwrap())))
                        continue
                    end if
                end if

                // Where the callee holds the argument (or, for a probe, what it reads through it), and
                // where it holds the frame storage the argument reaches, with that storage as said.
                var held: Buf[(KeptAt, bool, string)] = buf()

                if core.is_some()
                    for pair in frame_call_locs(ft, name, j, arg)
                        held.push((pair.0, pair.1, ""))

                for r in reads
                    held.push((r.1, true, r.2))

                for h in held
                    val item = h.0
                    val read = h.2 != ""

                    if item.loc == "j" && has_span(ft.hs.chained, e.span) then continue

                    var loc = if item.loc == "j" then joined_loc(ft.hs, false) else translate_loc(ft.org, args, item.loc)

                    if loc.starts_with("l:") then continue

                    // **A thread whose handle no place names is held for good -- but only once the
                    // function returns**: one that never does (`-> never`, a kernel's loop) leaves its
                    // frame to every thread it started. So it is held along the ways as a location no
                    // clear can name (`?`), one per argument, and refused at a way out.
                    if item.loc == "j" && loc == "" then loc = s"j?${arg.span.start}"

                    // A thread holds it until it is joined, so the cure is a join on every way out; a
                    // task, until it is awaited.
                    val ending = if task_result(texpr_type(e)).is_some() then "await that task" else "join that thread"
                    val cure = if item.loc == "j" then s" — $ending on every way out of '${ft.owner}', " +
                        s"or hand it storage that lasts${ft.hs.why}" else ""
                    var said = if read
                        read_said(ft, name, param_name(ft.cx, name, j), item.how, arg, h.2, false) + cure
                    else
                        s"'${shown_name(ft.cx.an, name)}' keeps its parameter " +
                            s"'${param_name(ft.cx, name, j)}' (${item.how}), and " +
                            argument_said(ft, arg, core.unwrap()) + cure

                    if ft.probe then said = probe_kept(ft, core.unwrap(), arg, name, param_name(ft.cx, name, j), item.how, h.1)

                    if loc == "" || (loc.index_of("?").is_some() && !loc.starts_with("j?"))
                        ft.faults.items.push((ft.scope, arg.span, said))
                        break
                    end if

                    // A statement that writes its value walks that value twice -- as an expression
                    // and as what it writes -- and one call starts one thread.
                    if loc.starts_with("j:") && said_already(evs, loc, arg.span) then continue

                    evs.items.push(FlowEv(false, loc, said, arg.span))
        TVCall(recv, slot, args, _, _) ->
            val all = with_receiver(recv, args)

            // The receiver is handed over as surely as an argument: `reactive(() -> …).on_tap(f)`
            // gives the object that holds the closure to a default method that keeps `self`.
            for k in 0..<all.len()
                val arg = all.at(k)

                if !may_hold_pointer(ft.cx, texpr_type(arg)) then continue

                val core = frame_core(ft, arg)
                val reads = frame_vread_locs(ft, recv, slot, k, arg)

                if core.is_none() && reads.is_empty() then continue

                var held: Buf[(string, KeptAt, bool, string)] = buf()

                if core.is_some()
                    for triple in frame_vcall_locs(ft, recv, slot, k, arg)
                        held.push((triple.0, triple.1, triple.2, ""))

                for r in reads
                    held.push((r.0, r.1, true, r.2))

                for h in held
                    val item = (h.0, h.1)
                    val read = h.3 != ""

                    if item.1.loc == "j" && has_span(ft.hs.chained, e.span) then continue

                    val loc = if item.1.loc == "j" then joined_loc(ft.hs, false) else translate_loc(ft.org, all, item.1.loc)

                    if loc.starts_with("l:") then continue
                    if loc.starts_with("j:") && said_already(evs, loc, arg.span) then continue

                    // An async method's task holds it until that task is awaited.
                    val cure = if item.1.loc == "j" then s" — await that task on every way out of '${ft.owner}', " +
                        s"or hand it storage that lasts" else ""
                    var said = if read
                        read_said(ft, item.0, param_name(ft.cx, item.0, k), item.1.how, arg, h.3, false) + cure
                    else
                        s"'${shown_name(ft.cx.an, item.0)}' keeps its parameter " +
                            s"'${param_name(ft.cx, item.0, k)}' (${item.1.how}), and " +
                            argument_said(ft, arg, core.unwrap()) + cure

                    if ft.probe
                        said = probe_kept(ft, core.unwrap(), arg, item.0, param_name(ft.cx, item.0, k),
                                          item.1.how, h.2)
                    end if

                    if loc == "" || loc.index_of("?").is_some()
                        ft.faults.items.push((ft.scope, arg.span, said))
                        break
                    end if

                    evs.items.push(FlowEv(false, loc, said, arg.span))
        TCallPtr(callee, args, _, _) ->
            for j in 0..<args.len()
                val arg = args.at(j)

                if !may_hold_pointer(ft.cx, texpr_type(arg)) then continue

                val core = frame_core(ft, arg)
                val reads = frame_pread_locs(ft, callee, j, arg)

                if core.is_none() && reads.is_empty() then continue

                var held: Buf[(string, KeptAt, bool, string)] = buf()

                if core.is_some()
                    for triple in frame_pointer_locs(ft, callee, j, arg)
                        held.push((triple.0, triple.1, triple.2, ""))

                for r in reads
                    held.push((r.0, r.1, true, r.2))

                for h in held
                    val item = (h.0, h.1)
                    val read = h.3 != ""
                    val loc = translate_loc(ft.org, args, item.1.loc)

                    if loc.starts_with("l:") then continue

                    val through = s"a call through '${type_show(texpr_type(callee))}' may reach "
                    var said = if read
                        through + read_said(ft, item.0, param_name(ft.cx, item.0, j), item.1.how, arg, h.3, true)
                    else
                        through + s"'${shown_name(ft.cx.an, item.0)}', which keeps its parameter " +
                            s"'${param_name(ft.cx, item.0, j)}' (${item.1.how}), and " + argument_said(ft, arg, core.unwrap())

                    if ft.probe
                        said = probe_kept(ft, core.unwrap(), arg, item.0, param_name(ft.cx, item.0, j), item.1.how,
                                          h.2)
                    end if

                    if loc == "" || loc.index_of("?").is_some()
                        ft.faults.items.push((ft.scope, arg.span, said))
                        break
                    end if

                    evs.items.push(FlowEv(false, loc, said, arg.span))
        _ -> ()
end call_at

// **Where a closure is held by value whatever becomes of it** (`docs/design/closures.md` decision 9):
// an argument a `@scoped`, `@crossing` or `@joined` annotation names -- the callee runs it in another
// domain or as a child whose captures were settled where it was written -- and one a thread the call
// starts holds. A task the call answers is not one: it is driven in this domain, and an `await` of it
// takes it back.
//
// The answer is the reason, in words that follow the call's, naming the domain the closure goes to:
// `whose parameter 'f' is '@crossing', so another domain may run it`.
private probe_held_apart(ft: &FrameTrack, call: TExpr, name: string, j: usize) -> Option[string]
    val found = ft.cx.find(name)

    if found.is_some()
        val f = found.unwrap()

        if j < f.params.len()
            val p = f.params.at(j).0

            val how =
                if scoped_at(f, j) then "'@scoped', so another domain may run it before the scope ends"
                else if holds_string(f.marks.copies, p) then "'@crossing', so another domain may run it"
                else if holds_string(f.marks.joined, p) then "'@joined', so a thread of its own runs it"
                else ""

            if how != "" then return Some(s"whose parameter '$p' is $how")
        end if
    end if

    if task_result(texpr_type(call)).is_some() then return None

    for item in keeps_of(ft.cx, name, j).locs
        if item.loc == "j" then return Some("which runs it on a thread of its own")

    None
end probe_held_apart

// A closure handed to a parameter its callee keeps -- or one reached through a pointer or a view the
// callee lets what it reads through out of (`through`) -- as a probe gathers it.
private probe_kept(ft: &FrameTrack, core: string, arg: TExpr, callee: string, param: string,
                   how: string, through: bool) -> string =
    probe_why(core, s"it is handed to '${shown_name(ft.cx.an, callee)}' ${probe_line(ft.scope, arg.span)}, " +
              (if through then s"which lets what it reads through its parameter '$param' outlive the call ($how)"
               else s"which keeps its parameter '$param' ($how)"))

// **Where a call may hold a closure an argument reaches** (for a probe): what the callee keeps of the
// argument, and where the argument is a pointer or a view -- `install(&s)`, `run_all([f, g])` --
// what the callee lets out of what it reads through it (`through_of`), each marked `true`. A callee
// that only calls or reads the elements lets nothing out, and the closures stay in the frame; one
// that copies one out holds it wherever it copies it. The rule's own walk asks what is kept here, and
// what is read through an argument by the steps it takes (`frame_read_locs`).
private frame_call_locs(ft: &FrameTrack, name: string, j: usize, arg: TExpr) -> Buf[(KeptAt, bool)]
    var out: Buf[(KeptAt, bool)] = buf()

    for item in keeps_of(ft.cx, name, j).locs
        out.push((item, false))

    if ft.probe && asks_through(ft.cx, texpr_type(arg))
        for item in through_of(ft.cx, name, j).locs
            out.push((item, true))
    end if

    out
end frame_call_locs

private frame_vcall_locs(ft: &FrameTrack, recv: TExpr, slot: int, k: usize, arg: TExpr) -> Buf[(string, KeptAt, bool)]
    var out: Buf[(string, KeptAt, bool)] = buf()

    for item in vcall_keeps(ft.cx, recv, slot, k)
        out.push((item.0, item.1, false))

    if ft.probe && asks_through(ft.cx, texpr_type(arg))
        for item in vcall_through(ft.cx, recv, slot, k)
            out.push((item.0, item.1, true))
    end if

    out
end frame_vcall_locs

private frame_pointer_locs(ft: &FrameTrack, callee: TExpr, j: usize, arg: TExpr) -> Buf[(string, KeptAt, bool)]
    var out: Buf[(string, KeptAt, bool)] = buf()

    for item in pointer_keeps(ft.cx, callee, j)
        out.push((item.0, item.1, false))

    if ft.probe && asks_through(ft.cx, texpr_type(arg))
        for item in pointer_through(ft.cx, callee, j)
            out.push((item.0, item.1, true))
    end if

    out
end frame_pointer_locs

// **The rule's own walk asks what a callee lets out of what it reads through an argument, step by
// step, where the storage the argument reaches holds an address of this frame** (`read_cores`,
// `read_of`): `stash(&h)`, where `h` holds `&x` and `stash` pushes `h.p`, lets `&x` out as surely as
// `stash(&x)` would. Each address is asked of the step it sits at -- `&x` in `h` one step through
// `&h`; in `s`, where `w` holds `&s`, two steps through `&w` -- so a callee letting out what sits at
// another step lets out somebody else's storage, or a copy. Each comes back with the frame storage it
// lets out, as the refusal says it. Where no body is in sight it keeps to what the rule says of the
// pointer itself (`read_of`, `vcall_reads`, `pointer_reads`).
//
// **What the callee puts back into storage reached through the same argument stays where the argument
// reaches** -- `old = s.vm.con`, then `s.vm.con = old` -- so it lets nothing out where all of that is
// this frame's own (`frame_closed`). Where any of it may be somebody else's -- a pointer the frame was
// handed, made, or read -- it is held there as anywhere else.
private frame_read_locs(ft: &FrameTrack, name: string, j: usize, arg: TExpr) -> Buf[(string, KeptAt, string)]
    var out: Buf[(string, KeptAt, string)] = buf()

    if ft.probe || !asks_through(ft.cx, texpr_type(arg)) then return out

    val closed = frame_closed(ft, arg)

    for r in read_cores(ft, arg)
        for item in read_of(ft.cx, name, j, r.0).locs
            if !(closed && put_back(item.loc, j)) then out.push((name, item, r.1))

    out
end frame_read_locs

private frame_vread_locs(ft: &FrameTrack, recv: TExpr, slot: int, k: usize, arg: TExpr) -> Buf[(string, KeptAt, string)]
    var out: Buf[(string, KeptAt, string)] = buf()

    if ft.probe || !asks_through(ft.cx, texpr_type(arg)) then return out

    val closed = frame_closed(ft, arg)

    for r in read_cores(ft, arg)
        for item in vcall_reads(ft.cx, recv, slot, k, r.0)
            if !(closed && put_back(item.1.loc, k)) then out.push((item.0, item.1, r.1))

    out
end frame_vread_locs

private frame_pread_locs(ft: &FrameTrack, callee: TExpr, j: usize, arg: TExpr) -> Buf[(string, KeptAt, string)]
    var out: Buf[(string, KeptAt, string)] = buf()

    if ft.probe || !asks_through(ft.cx, texpr_type(arg)) then return out

    val closed = frame_closed(ft, arg)

    for r in read_cores(ft, arg)
        for item in pointer_reads(ft.cx, callee, j, r.0)
            if !(closed && put_back(item.1.loc, j)) then out.push((item.0, item.1, r.1))

    out
end frame_pread_locs

// Whether a callee's location is storage reached through its own parameter at `j`.
private put_back(loc: string, j: usize) -> bool = loc.starts_with(s"p$j:") || loc.starts_with(s"d:p$j:")

// **Whether everything a pointer argument reaches is this frame's own storage**: the locals it points
// at, and everything their storage holds the address of, at any depth, with no address in any of it
// that came from anywhere else -- a parameter, a call, module storage, a heap object (`points`).
private frame_closed(ft: &FrameTrack, arg: TExpr) -> bool
    settle_points(ft)

    var first: Buf[(string, string)] = buf()

    addrs(ft, arg, &first, 0)

    if first.is_empty() then return false

    for p in first
        if !own_point(p.0) then return false

    for p in reach(ft, first)
        if !own_point(p.0) then return false

    true
end frame_closed

// Whether a point is storage of this frame: a local, a parameter's copy, or a value made in place --
// not an address from anywhere else, nor a heap object. A box (`%b`) and a buffer literal (`%l`) are
// heap objects: a `[x; n]` is always a buffer of its own, and a `[a, b]` is laid in the frame only
// where it is handed straight to a call that keeps nothing of it, so no address of it is ever kept.
private own_point(name: string) -> bool = name != "?" && !name.starts_with("%b") && !name.starts_with("%l")

// What a conversion to `&sync` makes of a closure: one held by value, as every closure that crosses
// a domain is.
private probe_synced(ft: &FrameTrack, at: Span, v: TExpr, ty: Type)
    val synced = ty match
        Ref(_, sync) -> sync
        _ -> false

    if !synced then return

    val core = frame_core(ft, v)

    if core.is_none() then return

    ft.faults.items.push((ft.scope, at, probe_why(core.unwrap(),
        s"it becomes a '${type_show(ty)}' ${probe_line(ft.scope, at)}, which another thread may run")))
end probe_synced

// **An address as an integer handed to a callee** is refused only where the callee may put it in
// storage that outlives the call and something turns it back into a pointer from there; one the
// callee turns back while it runs reaches a frame that is still there.
private image_passed(ft: &FrameTrack, call: TExpr, name: string, j: usize, arg: TExpr)
    val core = frame_core(ft, arg)

    if core.is_none() then return

    val cast = cast_reach_arg(ft.cx, ft.func, call, name, j)

    if cast.is_none() then return

    if ft.probe
        ft.faults.items.push((ft.scope, arg.span, probe_why(core.unwrap(),
            s"it is handed as an integer to '${shown_name(ft.cx.an, name)}' ${probe_line(ft.scope, arg.span)}, " +
            s"which may store it where it outlives the call")))
        return
    end if

    ft.faults.items.push((ft.scope, arg.span,
        s"'${shown_name(ft.cx.an, name)}' may store its parameter '${param_name(ft.cx, name, j)}' where it " +
        s"outlives the call, and ${argument_said(ft, arg, core.unwrap())} as an integer, which " +
        s"'${shown_name(ft.cx.an, cast.unwrap())}' turns back into a pointer with 'ptr_cast' — store the " +
        "value itself, or hand it storage that lasts"))
end image_passed

// What an argument is, as the refusal says it: an address written `&n` IS the address of the storage,
// a receiver a method was called on is the storage itself, and anything else HOLDS the address.
private argument_said(ft: &FrameTrack, arg: TExpr, core: string) -> string
    val written = value_text(ft.scope, arg)

    *arg.kind match
        TAddrOf(place, _) ->
            if !written.starts_with("&") && core.starts_with("the address of ")
                return s"'${source_text(ft.scope, whole_place(place))}' is " +
                    core["the address of ".bytes.len..<core.bytes.len]
            end if

            s"'$written' is $core"
        TTempAddr(_, _) -> s"'$written' is $core"
        _ -> s"'$written' holds $core"
end argument_said

// What frame storage a value is, or holds the address of, as the refusal says it -- or, for a probe,
// every closure literal it is or holds.
private frame_core(ft: &FrameTrack, e: TExpr) -> Option[string] =
    if ft.probe then probe_core(ft, e) else rule_core(ft, e)

// The closure literals a value is, or is built around, each by its marker. **Every one is named**,
// not the first, since each is decided on its own -- and a closure capturing another holds it, by
// value or by address, so the inner one goes wherever the outer one does.
private probe_core(ft: &FrameTrack, e: TExpr) -> Option[string]
    val text = probe_text(ft, e)

    if text == "" then None else Some(text)
end probe_core

private probe_text(ft: &FrameTrack, e: TExpr) -> string = *e.kind match
    TStructNew(st, args) ->
        val own = if is_followed(ft.cx.an, st.base) then closure_marker(st.base) else ""

        own + probe_all(ft, args)
    TLoad(n, _) -> ft.core_of(n).unwrap_or("")

    // The address of a local holding a closure reaches the closure through it.
    TAddrOf(place, _) -> local_root(ft.refs, place) match
        Some(n) -> ft.core_of(n).unwrap_or("")
        None -> ""
    TEnumNew(_, _, args) -> probe_all(ft, args)
    TArrayLit(elems, _) -> probe_all(ft, elems)
    TArrayFill(v, _) -> probe_text(ft, v)
    TBufLit(elems, _) -> probe_all(ft, elems)
    TBufFill(v, _, _) -> probe_text(ft, v)
    TBox(v, _) -> probe_text(ft, v)
    TErase(v, _, _) -> probe_text(ft, v)
    TCast(v, _) -> probe_text(ft, v)
    TField(r, _, _) -> probe_text(ft, r)
    TDeref(r, _) -> probe_text(ft, r)
    TSeq(exprs) -> if exprs.is_empty() then "" else probe_text(ft, exprs.at(exprs.len() - 1))
    TBlockExpr(b) -> probe_block(ft, b)
    TIf(_, then_block, else_block, _) ->
        probe_block(ft, then_block) + (if else_block.is_some() then probe_block(ft, else_block.unwrap()) else "")
    TMatch(_, arms, _) ->
        var all = ""

        for arm in arms
            all = all + probe_block(ft, arm.body)

        all
    TCall(name, args, ty, _) ->
        var all = ""

        for i in 0..<args.len()
            if answers_arg(ft.cx, name, args, i, ty, false) || probe_answers_through(ft, name, args.at(i), i)
                all = all + probe_text(ft, args.at(i))
        end for

        all

    // A call through an object answers with its receiver as readily as a direct one with an argument:
    // `reactive(() -> …).on_tap(f)` hands back the object holding the closure.
    TVCall(recv, slot, args, ty, _) ->
        val handed = with_receiver(recv, args)
        var all = ""

        for k in 0..<handed.len()
            val through = asks_through(ft.cx, texpr_type(handed.at(k))) && vcall_through_answers(ft.cx, recv, slot, k)

            if through || vcall_answers(ft.cx, recv, slot, handed, k, ty) then all = all + probe_text(ft, handed.at(k))
        end for

        all
    TCallPtr(callee, args, _, ty) ->
        var all = ""

        for j in 0..<args.len()
            val read = may_hold_pointer(ft.cx, ty) && asks_through(ft.cx, texpr_type(args.at(j)))

            if read && pointer_through_answers(ft.cx, callee, j) then all = all + probe_text(ft, args.at(j))
        end for

        all
    _ -> ""

// **A call answering with a value it read through a pointer or a view it was handed answers with the
// closures that argument reaches** (for a probe): `first([f, g])`, `get(&s)`.
private probe_answers_through(ft: &FrameTrack, name: string, arg: TExpr, i: usize) -> bool =
    asks_through(ft.cx, texpr_type(arg)) && through_answers_of(ft.cx, name, i)

private probe_all(ft: &FrameTrack, es: Buf[TExpr]) -> string
    var all = ""

    for item in es
        all = all + probe_text(ft, item)

    all
end probe_all

private probe_block(ft: &FrameTrack, b: TBlock) -> string =
    if b.result.is_some() then probe_text(ft, b.result.unwrap()) else ""

// Whether a closure literal is one a probe decides: one with a capture it could hold by reference.
is_probe_candidate(a: &Analysis, base: string) -> bool = a.closure_refs.get(base) match
    Some(refs) ->
        for r in refs
            if r then return true

        false
    None -> false

// Whether a probe follows a closure literal: one whose mode it decides, or one put behind a `&Fn`,
// whose box is built in the frame where nothing reaches it after the frame (`closure_mode.sysl`).
is_followed(a: &Analysis, base: string) -> bool =
    is_probe_candidate(a, base) || a.boxed_closures.has(base)

private rule_core(ft: &FrameTrack, e: TExpr) -> Option[string] = *e.kind match
    TAddrOf(place, _) -> frame_place(ft, place)
    TTempAddr(_, _) -> Some(s"the address of a value made in place in '${ft.owner}'")
    TLoad(n, ty) -> if may_hold_pointer(ft.cx, ty) || is_integer_type(ty) then ft.core_of(n) else None
    TStructNew(_, args) -> if may_hold_pointer(ft.cx, texpr_type(e)) then first_core(ft, args) else None
    TEnumNew(_, _, args) -> if may_hold_pointer(ft.cx, texpr_type(e)) then first_core(ft, args) else None
    TArrayLit(elems, _) -> if may_hold_pointer(ft.cx, texpr_type(e)) then first_core(ft, elems) else None
    TBox(v, _) -> frame_core(ft, v)
    TErase(v, _, _) -> frame_core(ft, v)

    // The address as an integer is still the address (`returned_image`); one computed from it is a
    // number.
    TCast(v, ty) -> if may_hold_pointer(ft.cx, ty) || is_integer_type(ty) then frame_core(ft, v) else None
    TFloorCast(v, ty) -> if is_integer_type(ty) then frame_core(ft, v) else None
    TField(r, _, ty) -> if may_hold_pointer(ft.cx, ty) then frame_core(ft, r) else None
    TSeq(exprs) -> if exprs.is_empty() then None else frame_core(ft, exprs.at(exprs.len() - 1))
    TBlockExpr(b) -> block_core(ft, b)
    TIf(_, then_block, else_block, _) ->
        val c = block_core(ft, then_block)

        if c.is_some() || else_block.is_none() then c else block_core(ft, else_block.unwrap())
    TMatch(_, arms, _) ->
        var found: Option[string] = None

        for arm in arms
            if found.is_none() then found = block_core(ft, arm.body)

        found
    TCall(name, args, ty, _) ->
        val image = is_integer_type(ty) && ft.cx.find(name).is_some()

        if may_hold_pointer(ft.cx, ty) || image then answer_core(ft, name, args, ty) else None
    TVCall(recv, slot, args, ty, _) ->
        if !may_hold_pointer(ft.cx, ty) then return None

        val handed = with_receiver(recv, args)

        for k in 0..<handed.len()
            val c = frame_core(ft, handed.at(k))

            if c.is_some() && vcall_answers(ft.cx, recv, slot, handed, k, ty) then return c

        None
    _ -> None

// The frame storage a call's answer may be made of: an argument's, where the callee answers with it,
// or what the storage an argument points at holds, where the callee answers with what it reads
// through it (`get(&h)` answering `h.p`).
private answer_core(ft: &FrameTrack, name: string, args: Buf[TExpr], ty: Type) -> Option[string]
    for i in 0..<args.len()
        val c = frame_core(ft, args.at(i))

        if c.is_some() && answers_arg(ft.cx, name, args, i, ty, false) then return c

        if !asks_through(ft.cx, texpr_type(args.at(i))) || ft.cx.find(name).is_none() then continue

        for r in read_cores(ft, args.at(i))
            if read_answers_of(ft.cx, name, i, r.0) then return Some(r.1)
    end for

    None
end answer_core

// **Every address of this frame's storage that a read through an argument reaches, with the steps it
// takes** (the rule's walk). The argument points at some of this frame's storage (`addrs`); what that
// storage holds the address of is read one step in, what THAT storage holds two steps in, and so on
// (`points`, which follows a value however it got there -- built in place, copied out of a field into
// a local, read through a pointer, stored by a callee). `&h`, where `h` holds `&x`, reaches `&x` one
// step in; `&w`, where `w` holds `&h`, reaches it two steps in. What this frame's own walk says a local
// holds (`core_of`) is read at the same step as the rest of its storage. **Past `MaxReadSteps`
// everything still reachable is gathered at one step further**, which the callee answers for anything
// it reads that deep or deeper (`read_of`) -- so a chain longer than the summaries tell apart, or a
// cycle, is never let through.
private read_cores(ft: &FrameTrack, arg: TExpr) -> Buf[(int, string)]
    var out: Buf[(int, string)] = buf()

    if ft.probe then return out

    settle_points(ft)

    var level: Buf[(string, string)] = buf()

    addrs(ft, arg, &level, 0)

    var k = 1

    while k <= MaxReadSteps + 1 && !level.is_empty()
        var next = deref_level(ft, level)

        for p in level
            held_core(ft, &out, k, p.0)

        if k > MaxReadSteps
            for p in reach(ft, next)
                push_point(&next, p)

            for p in next
                held_core(ft, &out, k, p.0)
        end if

        for p in next
            if own_point(p.0) && p.1 != "" then push_core(&out, k, p.1)

        level = next
        k += 1
    end while

    out
end read_cores

// What this frame's own walk says the storage of `name` holds, read `k` steps in.
private held_core(ft: &FrameTrack, out: *Buf[(int, string)], k: int, name: string)
    if !own_point(name) then return

    val c = ft.core_of(name)

    if c.is_some() then push_core(out, k, c.unwrap())
end held_core

private push_core(out: *Buf[(int, string)], k: int, core: string)
    for item in *out
        if item.0 == k && item.1 == core then return

    out.push((k, core))
end push_core

// -- what this frame's storage holds the address of ----------------------------------------------

// A value stored into storage that may hold an address: into a local's own, a binding; anywhere else,
// a store through a pointer, which may land in this frame's storage (`store_targets`).
private note_point_store(ft: &FrameTrack, place: TExpr, v: TExpr)
    if !may_hold_pointer(ft.cx, texpr_type(v)) then return

    local_root(ft.refs, place) match
        Some(n) -> ft.binds.push((n, v, false))
        None -> ft.stores.push((place, v))
end note_point_store

// The forms that put a value somewhere this frame's storage can be read: a store, a call, a pattern's
// names, a loop's, and storage made in place -- a value whose address is taken, a box, a view's
// elements -- named by where it is written (`made_point`).
private note_point_expr(ft: &FrameTrack, e: TExpr)
    *e.kind match
        TStore(place, v, _, _) -> note_point_store(ft, place, v)
        TCall(_, _, _, _) -> ft.calls.push(e)
        TVCall(_, _, _, _, _) -> ft.calls.push(e)
        TCallPtr(_, _, _, _) -> ft.calls.push(e)
        TMatch(scrutinee, arms, _) ->
            for arm in arms
                for p in arm.patterns
                    note_pattern(ft, p, scrutinee, false)
        TIf(cond, _, _, _) -> note_terms(ft, cond)
        TWhile(cond, _, _, _) -> note_terms(ft, cond)
        TForEach(name, _, seq, _, _, _) -> ft.binds.push((name, seq, true))
        TIterate(cursor, _, init, _, pat, _, _, _) ->
            ft.binds.push((cursor, init, false))
            note_pattern(ft, pat, init, true)
        TTempAddr(v, _) -> ft.binds.push((made_point("%t", e), v, false))
        TBox(v, _) -> ft.binds.push((made_point("%b", e), v, false))
        TBufLit(elems, _) ->
            for item in elems
                ft.binds.push((made_point("%l", e), item, false))
        TBufFill(v, _, _) -> ft.binds.push((made_point("%l", e), v, false))
        TSlice(base, _, _, _, _) -> note_made_array(ft, base)
        TConstView(v) -> note_made_array(ft, v)
        TViewAs(v, _) -> note_made_array(ft, v)
        _ -> ()
end note_point_expr

// An array made in place to be seen as a view holds its elements where the view points.
private note_made_array(ft: &FrameTrack, v: TExpr)
    if is_array_type(texpr_type(v)) && !is_place(ft, v) then ft.binds.push((made_point("%a", v), v, false))

private note_terms(ft: &FrameTrack, cond: Buf[TCondTerm])
    for term in cond
        term match
            TCondIs(subject, patterns, _) ->
                for p in patterns
                    note_pattern(ft, p, subject, false)
            _ -> ()
end note_terms

private note_pattern(ft: &FrameTrack, p: TPattern, subject: TExpr, element: bool)
    var names: Buf[string] = buf()

    pattern_names(p, &names)

    for n in names
        ft.binds.push((n, subject, element))
end note_pattern

// The name of storage made in place where `e` is written.
private made_point(kind: string, e: TExpr) -> string = s"$kind${e.span.start}"

// Whether an expression names storage -- a local, a field or element of one, what a pointer points at
// -- rather than making a value.
private is_place(ft: &FrameTrack, e: TExpr) -> bool = *e.kind match
    TLoad(_, _) -> true
    TGlobal(_, _, _) -> true
    TDeref(_, _) -> true
    TField(r, _, _) -> is_place(ft, r)
    TIndex(r, _, _) -> !is_array_type(texpr_type(r)) || is_place(ft, r)
    _ -> false

// **What every local's storage may hold the address of**, worked out once a walk asks: a fixpoint over
// every value put into it, every store through a pointer, and every call, which only adds, so it
// settles. A parameter's storage holds what its caller handed over, which is `?`.
private settle_points(ft: &FrameTrack)
    if ft.pointed then return

    ft.pointed = true

    for p in ft.params
        if may_hold_pointer(ft.cx, p.1) then add_point(ft, p.0, ("?", ""))

    var changed = true

    while changed
        changed = false

        for b in ft.binds
            var vals: Buf[(string, string)] = buf()

            addrs(ft, b.1, &vals, 0)

            if b.2
                for p in deref_level(ft, vals)
                    push_point(&vals, p)
            end if

            for v in vals
                if add_point(ft, b.0, v) then changed = true
        end for

        for s in ft.stores
            var vals: Buf[(string, string)] = buf()

            addrs(ft, s.1, &vals, 0)

            for target in store_targets(ft, s.0)
                for v in vals
                    if add_point(ft, target, v) then changed = true
        end for

        for c in ft.calls
            if call_points(ft, c) then changed = true
    end while
end settle_points

private add_point(ft: &FrameTrack, holder: string, p: (string, string)) -> bool
    for item in ft.points
        if item.0 == holder && item.1 == p.0 then return false

    ft.points.push((holder, p.0, p.1))
    true
end add_point

private push_point(out: *Buf[(string, string)], p: (string, string))
    for item in *out
        if item.0 == p.0 then return

    out.push(p)
end push_point

// What the storage of each point holds the address of: one step further in. An address from anywhere
// else reaches somewhere else again.
private deref_level(ft: &FrameTrack, level: Buf[(string, string)]) -> Buf[(string, string)]
    var out: Buf[(string, string)] = buf()

    for p in level
        if p.0 == "?"
            push_point(&out, p)
            continue
        end if

        for item in ft.points
            if item.0 == p.0 then push_point(&out, (item.1, item.2))
    end for

    out
end deref_level

// Everything reachable from what the points hold, at any depth past them.
private reach(ft: &FrameTrack, start: Buf[(string, string)]) -> Buf[(string, string)]
    var out: Buf[(string, string)] = buf()
    var level = start

    while !level.is_empty()
        var next: Buf[(string, string)] = buf()

        for p in deref_level(ft, level)
            var seen = false

            for item in out
                if item.0 == p.0 then seen = true

            if !seen
                out.push(p)
                next.push(p)
            end if
        end for

        level = next
    end while

    out
end reach

// **The storage a value may hold the address of** -- this frame's, by local, with how the refusal
// says it, and `?` for an address from anywhere else. A field or element in place holds what its
// value does; a read through a pointer holds what the storage it points at does; a call answers what
// its summaries say it answers (`answer_points`).
private addrs(ft: &FrameTrack, e: TExpr, out: *Buf[(string, string)], depth: int)
    if depth > 32
        push_point(out, ("?", ""))
        return
    end if

    *e.kind match
        TAddrOf(place, _) -> place_points(ft, place, out, depth + 1)
        TTempAddr(_, _) -> push_point(out, (made_point("%t", e), s"the address of a value made in place in '${ft.owner}'"))
        TBox(_, _) -> push_point(out, (made_point("%b", e), ""))
        TBufLit(_, _) -> push_point(out, (made_point("%l", e), ""))
        TBufFill(_, _, _) -> push_point(out, (made_point("%l", e), ""))
        TLoad(n, ty) ->
            if !may_hold_pointer(ft.cx, ty) then return

            for item in ft.refs
                if item.0 == n
                    val root = local_root(ft.refs, e)

                    if root.is_some() then contents_into(ft, root.unwrap(), out) else addrs(ft, item.1, out, depth + 1)

                    return
                end if
            end for

            contents_into(ft, n, out)
        TGlobal(_, ty, _) -> if may_hold_pointer(ft.cx, ty) then push_point(out, ("?", ""))
        TField(r, _, ty) -> if may_hold_pointer(ft.cx, ty) then addrs(ft, r, out, depth + 1)
        TIndex(r, _, ty) ->
            if !may_hold_pointer(ft.cx, ty) then return

            if is_array_type(texpr_type(r)) then addrs(ft, r, out, depth + 1) else read_points(ft, r, out, depth)
        TDeref(x, ty) -> if may_hold_pointer(ft.cx, ty) then read_points(ft, x, out, depth)
        TSlice(base, _, _, _, _) -> view_points(ft, base, out, depth)
        TConstView(v) -> view_points(ft, v, out, depth)
        TViewAs(v, _) -> view_points(ft, v, out, depth)
        TStructNew(_, args) -> all_addrs(ft, args, out, depth)
        TEnumNew(_, _, args) -> all_addrs(ft, args, out, depth)
        TArrayLit(elems, _) -> all_addrs(ft, elems, out, depth)
        TArrayFill(v, _) -> addrs(ft, v, out, depth + 1)
        TDowngrade(v, _) -> addrs(ft, v, out, depth + 1)
        TUpgrade(v, _, _, _) -> addrs(ft, v, out, depth + 1)
        TErase(v, _, _) -> addrs(ft, v, out, depth + 1)
        TCast(v, _) -> addrs(ft, v, out, depth + 1)
        TFloorCast(v, _) -> addrs(ft, v, out, depth + 1)
        TTry(operand, _, _, _, _, _, _) -> addrs(ft, operand, out, depth + 1)
        TRecheck(after, _, _, _) -> addrs(ft, after, out, depth + 1)
        TStore(_, v, _, _) -> addrs(ft, v, out, depth + 1)
        TSeq(exprs) -> if !exprs.is_empty() then addrs(ft, exprs.at(exprs.len() - 1), out, depth + 1)
        TBlockExpr(b) -> block_addrs(ft, b, out, depth)
        TIf(_, then_block, else_block, _) ->
            block_addrs(ft, then_block, out, depth)

            if else_block.is_some() then block_addrs(ft, else_block.unwrap(), out, depth)
        TMatch(_, arms, _) ->
            for arm in arms
                block_addrs(ft, arm.body, out, depth)
        TBinary(_, left, right, ty) ->
            if may_hold_pointer(ft.cx, ty)
                addrs(ft, left, out, depth + 1)
                addrs(ft, right, out, depth + 1)
            end if
        TCall(name, args, ty, _) -> if may_hold_pointer(ft.cx, ty) then answer_points(ft, name, args, ty, out, depth)
        TVCall(recv, _, args, ty, _) -> if may_hold_pointer(ft.cx, ty) then any_points(ft, with_receiver(recv, args), out, depth)
        TCallPtr(_, args, _, ty) -> if may_hold_pointer(ft.cx, ty) then any_points(ft, args, out, depth)
        TIntLit(_, _) -> ()
        TStrLit(_) -> ()
        TCStrLit(_) -> ()
        TBoolLit(_) -> ()
        TNullLit(_) -> ()
        TZero(_) -> ()
        TFuncAddr(_, _, _) -> ()
        _ -> if may_hold_pointer(ft.cx, texpr_type(e)) then push_point(out, ("?", ""))
end addrs

private all_addrs(ft: &FrameTrack, es: Buf[TExpr], out: *Buf[(string, string)], depth: int)
    for item in es
        addrs(ft, item, out, depth + 1)

private block_addrs(ft: &FrameTrack, b: TBlock, out: *Buf[(string, string)], depth: int) =
    if b.result.is_some() then addrs(ft, b.result.unwrap(), out, depth + 1)

private contents_into(ft: &FrameTrack, name: string, out: *Buf[(string, string)])
    for item in ft.points
        if item.0 == name then push_point(out, (item.1, item.2))

// What is read through a pointer or a view: what the storage it points at holds.
private read_points(ft: &FrameTrack, x: TExpr, out: *Buf[(string, string)], depth: int)
    var ps: Buf[(string, string)] = buf()

    addrs(ft, x, &ps, depth + 1)

    for p in deref_level(ft, ps)
        push_point(out, p)
end read_points

// A view of an array points at the array's storage; one of a view or a pointer, where that points.
private view_points(ft: &FrameTrack, v: TExpr, out: *Buf[(string, string)], depth: int)
    if !is_array_type(texpr_type(v)) then addrs(ft, v, out, depth + 1)
    else if is_place(ft, v) then place_points(ft, v, out, depth + 1)
    else push_point(out, (made_point("%a", v), s"the address of a value made in place in '${ft.owner}'"))
end view_points

// The storage an address taken of a place is: a local's own (as the refusal says it), what a pointer
// the place is reached through points at, or module storage.
private place_points(ft: &FrameTrack, place: TExpr, out: *Buf[(string, string)], depth: int)
    local_root(ft.refs, place) match
        Some(n) ->
            push_point(out, (n, frame_place(ft, place).unwrap_or(s"the address of a local of '${ft.owner}'")))
            return
        None -> ()

    *place.kind match
        TLoad(n, _) ->
            for item in ft.refs
                if item.0 == n
                    place_points(ft, item.1, out, depth + 1)
                    return
                end if
            end for

            push_point(out, ("?", ""))
        TField(r, _, _) -> place_points(ft, r, out, depth + 1)
        TIndex(r, _, _) -> if is_array_type(texpr_type(r)) then place_points(ft, r, out, depth + 1) else addrs(ft, r, out, depth + 1)
        TDeref(x, _) -> addrs(ft, x, out, depth + 1)
        _ -> push_point(out, ("?", ""))
end place_points

// The locals a store through a pointer may land in.
private store_targets(ft: &FrameTrack, place: TExpr) -> Buf[string]
    var ps: Buf[(string, string)] = buf()
    var out: Buf[string] = buf()

    place_points(ft, place, &ps, 0)

    for p in ps
        if p.0 != "?" then out.push(p.0)

    out
end store_targets

// **What a call answers**: an argument, where the callee answers with it, and what is read some steps
// through an argument, where the callee answers with what it reads that far in (`read_answers_of`).
// A callee with no body here answers only what it is said to; an object's or a function pointer's
// answers anything it was handed (`any_points`).
private answer_points(ft: &FrameTrack, name: string, args: Buf[TExpr], ty: Type, out: *Buf[(string, string)],
                      depth: int)
    for i in 0..<args.len()
        val arg = args.at(i)
        var level: Buf[(string, string)] = buf()

        addrs(ft, arg, &level, depth + 1)

        if answers_arg(ft.cx, name, args, i, ty, false)
            for p in level
                push_point(out, p)
        end if

        if !asks_through(ft.cx, texpr_type(arg)) || ft.cx.find(name).is_none() then continue

        var k = 1

        while k <= MaxReadSteps + 1 && !level.is_empty()
            var next = deref_level(ft, level)

            if k > MaxReadSteps
                for p in reach(ft, next)
                    next.push(p)
            end if

            if read_answers_of(ft.cx, name, i, k)
                for p in next
                    push_point(out, p)
            end if

            level = next
            k += 1
        end while
    end for
end answer_points

private any_points(ft: &FrameTrack, args: Buf[TExpr], out: *Buf[(string, string)], depth: int)
    push_point(out, ("?", ""))

    for a in args
        var level: Buf[(string, string)] = buf()

        addrs(ft, a, &level, depth + 1)

        for p in level
            push_point(out, p)

        for p in reach(ft, level)
            push_point(out, p)
    end for
end any_points

// **What a call may store into this frame's storage**: where a callee keeps an argument in what
// another one -- or the same one -- reaches (`into.p = from`), or puts what it reads some steps
// through one there (`into.p = from.p`, `w.a = w.b.c`), everything the second reaches may hold the
// first, or what was read that far in (`read_of`). Coarse about where it lands -- any of the storage
// the argument reaches -- but it only adds.
private call_points(ft: &FrameTrack, c: TExpr) -> bool
    var handed: Buf[TExpr] = buf()

    *c.kind match
        TCall(_, args, _, _) -> handed = args
        TVCall(recv, _, args, _, _) -> handed = with_receiver(recv, args)
        TCallPtr(_, args, _, _) -> handed = args
        _ -> return false

    var changed = false

    for j in 0..<handed.len()
        val arg = handed.at(j)

        if !may_hold_pointer(ft.cx, texpr_type(arg)) then continue

        var level: Buf[(string, string)] = buf()

        addrs(ft, arg, &level, 0)

        if level.is_empty() then continue

        for loc in call_locs(ft, c, j, 0)
            if into_handed(ft, handed, loc, level) then changed = true

        if !asks_through(ft.cx, texpr_type(arg)) then continue

        var k = 1

        while k <= MaxReadSteps + 1 && !level.is_empty()
            var next = deref_level(ft, level)

            if k > MaxReadSteps
                for p in reach(ft, next)
                    push_point(&next, p)
            end if

            for loc in call_locs(ft, c, j, k)
                if into_handed(ft, handed, loc, next) then changed = true

            level = next
            k += 1
        end while
    end for

    changed
end call_points

// Where a call holds its argument at `j` (`steps` 0), or what it reads `steps` steps through it.
private call_locs(ft: &FrameTrack, c: TExpr, j: usize, steps: int) -> Buf[string]
    var out: Buf[string] = buf()

    *c.kind match
        TCall(name, _, _, _) ->
            for item in (if steps == 0 then keeps_of(ft.cx, name, j) else read_of(ft.cx, name, j, steps)).locs
                out.push(item.loc)
        TVCall(recv, slot, _, _, _) ->
            for item in (if steps == 0 then vcall_keeps(ft.cx, recv, slot, j) else vcall_reads(ft.cx, recv, slot, j, steps))
                out.push(item.1.loc)
        TCallPtr(callee, _, _, _) ->
            for item in (if steps == 0 then pointer_keeps(ft.cx, callee, j) else pointer_reads(ft.cx, callee, j, steps))
                out.push(item.1.loc)
        _ -> ()

    out
end call_locs

// Every value given lands in all the storage of this frame the argument a callee location is reached
// through reaches.
private into_handed(ft: &FrameTrack, handed: Buf[TExpr], loc: string, vals: Buf[(string, string)]) -> bool
    val i = param_of_loc(loc)

    if i < 0 || usize(i) >= handed.len() || vals.is_empty() then return false

    var first: Buf[(string, string)] = buf()

    addrs(ft, handed.at(usize(i)), &first, 0)

    var targets = reach(ft, first)

    for p in first
        targets.push(p)

    var changed = false

    for t in targets
        if t.0 == "?" || flat_local(ft, t.0) then continue

        for v in vals
            if add_point(ft, t.0, v) then changed = true
    end for

    changed
end into_handed

// A local whose type holds no address -- unless a local of the same name elsewhere in the body does.
private flat_local(ft: &FrameTrack, name: string) -> bool
    if !holds_string(ft.flat, name) then return false

    for b in ft.binds
        if b.0 == name then return false

    true
end flat_local

// The parameter a callee location is reached through (`p2:.f`, `d:p0:.s>{*S}.f`), or -1.
private param_of_loc(loc: string) -> int
    val rest = if loc.starts_with("d:") then loc["d:".bytes.len..<loc.bytes.len] else loc

    if !rest.starts_with("p") then return -1

    var n = 0
    var at = 1
    val bytes = rest.bytes

    while at < bytes.len && bytes[at] >= u8('0') && bytes[at] <= u8('9')
        n = n * 10 + int(bytes[at]) - int(u8('0'))
        at += 1

    if at == 1 || at >= bytes.len || bytes[at] != u8(':') then -1 else n
end param_of_loc

// A refusal of a call that lets out what it reads through an argument whose pointee holds the
// address of this frame's storage, in the words of the rule's other refusals.
private read_said(ft: &FrameTrack, callee: string, param: string, how: string, arg: TExpr, inside: string,
                  which: bool) -> string
    val named = s"'${shown_name(ft.cx.an, callee)}'" + (if which then ", which" else "")

    // A slice is written from its base to its closing bracket; a receiver's address taken by a method
    // call is written as the receiver (`argument_said`).
    val text = value_text(ft.scope, arg)
    val written = *arg.kind match
        TSlice(base, _, _, _, _) -> source_text(ft.scope, Span(base.span.start, bracket_end(ft.scope, base.span.end)))
        TAddrOf(place, _) -> if text.starts_with("&") then text else source_text(ft.scope, whole_place(place))
        _ -> text

    s"$named lets what it reads through its parameter '$param' outlive the call ($how), and what is " +
        s"read through '$written' holds $inside"
end read_said

// Where the bracket that opens at `at` closes, one past it; `at` itself where none opens there.
private bracket_end(scope: Scope, at: usize) -> usize
    val bytes = scope.src.bytes

    if at >= bytes.len || bytes[at] != u8('[') then return at

    var depth = 0
    var i = at

    while i < bytes.len
        if bytes[i] == u8('[') then depth += 1

        if bytes[i] == u8(']')
            depth -= 1

            if depth == 0 then return i + 1
        end if

        i += 1

    at
end bracket_end

private first_core(ft: &FrameTrack, es: Buf[TExpr]) -> Option[string]
    for item in es
        val c = frame_core(ft, item)

        if c.is_some() then return c

    None
end first_core

private block_core(ft: &FrameTrack, b: TBlock) -> Option[string] =
    if b.result.is_some() then frame_core(ft, b.result.unwrap()) else None

// The frame storage an address names: a local, a parameter's place, or a field or element of one.
private frame_place(ft: &FrameTrack, place: TExpr) -> Option[string]
    val root = frame_root_of(ft.refs, place)

    if root.is_none() then return None

    val (name, at) = root.unwrap()
    val shown = source_text(ft.scope, at)
    val direct = *place.kind match
        TLoad(_, _) -> true
        _ -> false

    var param = false

    for item in ft.params
        if item.0 == name then param = true

    if param && direct then return Some(s"the address of the parameter '$shown' of '${ft.owner}', a copy in its frame")
    if param then return Some(s"the address of a field of the parameter '$shown' of '${ft.owner}'")
    if direct then return Some(s"the address of a local of '${ft.owner}'")

    Some(s"the address of a field of '$shown', a local of '${ft.owner}'")
end frame_place

// The binding a place's storage belongs to, when that storage is the frame's own, with where its
// name is written.
frame_root_of(refs: Buf[(string, TExpr)], place: TExpr) -> Option[(string, Span)]
    *place.kind match
        TLoad(name, _) ->
            for item in refs
                if item.0 == name then return frame_root_of(refs, item.1)

            Some((name, place.span))
        TField(r, _, _) -> frame_root_of(refs, r)
        TIndex(r, _, _) -> texpr_type(r) match
            Array(_, _) -> frame_root_of(refs, r)
            _ -> None
        _ -> None
end frame_root_of

// -- a body reached through a default ------------------------------------------------------------------

// A body a call reaches with no body in sight -- a closure, a method a trait object dispatches to, a
// function whose address is taken -- borrows every pointer it is handed, because that is all its
// callers were promised. One that keeps one is refused where it is written.
private refuse_promised(cx: &KeepsCx, faults: &KeepFaults, f: TFunc)
    if cx.mistaken.has(f.name) then return

    val closure = is_closure_body(f)
    val trait_name = trait_of(cx, f.name)
    val addressed = cx.addressed.has(f.name)

    if !closure && trait_name.is_none() && !addressed then return

    val first: usize = if closure then 1 else 0
    val scope = func_home(cx.an, f.name)

    for i in first..<f.params.len()
        if !may_hold_pointer(cx, f.params.at(i).1) || scoped_at(f, i) then continue

        // **A stored callback keeps only what it captured**, and the call that made it is where that
        // is checked: an object -- a closure behind a `&Fn` among them -- is not itself an address
        // anyone lent.
        if !holds_raw_pointer(f.params.at(i).1, 0) then continue

        val w = walk_kept(cx, f, i)

        if !w.kept then continue

        // A function every call through a pointer to is in sight may hold what it is handed in what
        // another parameter points at, which each of those calls is held to (`pointer_keeps`).
        if !closure && trait_name.is_none() && relays(cx, f.name)
            for item in w.locs
                if through_param(item.loc) then continue

                faults.items.push((scope, item.at, promise_broken(cx, f, f.params.at(i).0, item.how, false, None)))
                break

            continue
        end if

        faults.items.push((scope, w.at, promise_broken(cx, f, f.params.at(i).0, w.how, closure, trait_name)))
end refuse_promised

// **A `@scoped` promise is the body's own and does not spread**: the body that says it may hold the
// pointer, but a callee it hands the pointer to that keeps it, or an object that captured it and is
// stored, promised nothing. Each is refused where it is written.
private refuse_spread(cx: &KeepsCx, faults: &KeepFaults, f: TFunc)
    if cx.mistaken.has(f.name) then return

    val ps = scoped_pointers(f)

    if ps.is_empty() then return

    val scope = func_home(cx.an, f.name)

    for i in ps
        val w = walk_kept_as(cx, f, i, true)

        if !w.kept then continue

        val pname = f.params.at(i).0

        faults.items.push((scope, w.at, s"'${shown_name(cx.an, f.name)}' says '@scoped($pname)', a promise " +
            s"to let go of '$pname' before its caller's scope ends that only its own body keeps, and " +
            s"${w.how} — the pointer may be handed on only to a parameter that says '@scoped' too, and " +
            "never captured by something stored"))
end refuse_spread

private promise_broken(cx: &KeepsCx, f: TFunc, pname: string, how: string, closure: bool,
                       trait_name: Option[string]) -> string
    // A function named where a closure is wanted is wrapped in one whose parameters nobody wrote.
    val what = if pname.starts_with("$") then "what it is handed" else s"its parameter '$pname'"

    if closure
        return s"a closure borrows what it is handed for the call, and this one keeps $what ($how) — " +
            "whoever calls it may hand it the address of their own storage. Copy what this needs into " +
            "storage of its own"
    end if

    val shown = shown_name(cx.an, f.name)

    if trait_name.is_some()
        return s"'$shown' keeps its parameter '$pname' ($how), but a method of " +
            s"'${qualified_name(trait_name.unwrap())}' borrows its parameters for the call — a call " +
            "through an object sees no body, so it may hand this the address of the caller's own " +
            "storage. Copy what this needs into storage of its own"
    end if

    s"'$shown' keeps its parameter '$pname' ($how), and its address is taken — a call through a " +
        "function pointer sees no body and borrows what it hands over, so it may hand this the " +
        "address of the caller's own storage. Copy what this needs into storage of its own"
end promise_broken

// -- how a refusal names things ------------------------------------------------------------------------

// A function as a reader wrote it: a member by its own name, a free function by its name.
private[compiler] shown_name(a: &Analysis, name: string) -> string =
    bare_name(qualified_name(a.tables.members.func_origin.get(name).unwrap_or(name)))

// The name of a callee's parameter at a position: from its body, or from its `extern` declaration.
private param_name(cx: &KeepsCx, name: string, i: usize) -> string
    cx.find(name) match
        Some(f) -> if i < f.params.len() then return f.params.at(i).0
        None -> ()

    cx.an.tables.externs.get(name) match
        Some(d) -> if i < d.params.len() then return d.params.at(i).name
        None -> ()

    s"#${i + 1}"
end param_name

// What the reader wrote at a span, or a description where the span is not this file's.
private source_text(scope: Scope, at: Span) -> string
    if at.end > scope.src.bytes.len || at.start >= at.end then return "it"

    from_utf8_unchecked(scope.src.text(at))
end source_text

// What the reader wrote for a value: a call's or a constructor's node is its name, so its arguments
// are read on to the parenthesis that closes them.
value_text(scope: Scope, e: TExpr) -> string
    val called = *e.kind match
        TCall(_, _, _, _) -> true
        TStructNew(_, _) -> true
        TEnumNew(_, _, _) -> true
        TCast(_, _) -> true
        TFloorCast(_, _) -> true
        _ -> false

    val at = e.span
    val bytes = scope.src.bytes

    if !called || at.end >= bytes.len || bytes[at.end] != u8('(') then return source_text(scope, at)

    var depth = 0
    var i = at.end

    while i < bytes.len
        if bytes[i] == u8('(') then depth += 1

        if bytes[i] == u8(')')
            depth -= 1

            if depth == 0 then return source_text(scope, Span(at.start, i + 1))
        end if

        i += 1

    source_text(scope, at)
end value_text

// -- what `@scoped` may name ----------------------------------------------------------------------------

// What `@scoped` may name, and what it may stand above (`docs/design/scope.md § 1`): a method whose
// receiver is `*self` -- the pointer the call lent the body that calls it -- and, once each, a
// parameter that is a call. The call is usually a `&sync Fn`, since what is named crosses into another
// domain; a bare arrow and a type parameter bounded by a call trait are calls too, and the crossing
// rule `@scoped` implies decides what may be passed there. A free function and a field are refused
// by the parser, before a declaration exists.
//
// **A `*T` parameter it may name above any function**: the promise is that the body holds the pointer
// only while its caller waits -- a join, an `await`, a kernel's wake -- and lets go of it before the
// caller's scope ends, which the compiler cannot see and trusts. A call it names needs the receiver.
check_scoped_names(a: &Analysis, scope: Scope, span: Span, d: FuncDecl, shown: string, method: bool)
    val ss = d.marks.scoped

    if ss.is_empty() then return

    val ps = d.params
    var calls = false

    for item in ps
        if holds_string(ss, item.name) && (callable_param(d, item) || erased_call(item)) then calls = true

    if calls && !method
        a.fault(scope, span, scoped_on_free_function())
        return
    end if

    val receiver = if calls then scoped_receiver(ps) else ""

    if receiver != ""
        a.fault(scope, span, s"'@scoped' promises that what '$shown' runs finishes before the " +
                "call that lent its receiver returns, so the receiver is the pointer that call " +
                s"lent, written '*self' — this one $receiver")

    for i in 0..<ss.len()
        var found: Option[Param] = None

        for item in ps
            if item.name == ss.at(i) then found = Some(item)

        var twice = false

        for j in 0..<i
            if ss.at(j) == ss.at(i) then twice = true

        if found.is_none()
            var listed = ""

            for j in 0..<ps.len()
                listed = if j == 0 then s"'${ps.at(j).name}'" else s"$listed, '${ps.at(j).name}'"

            val tail = if ps.is_empty() then " — it takes none" else s" — its parameters are $listed"

            a.fault(scope, span, s"'@scoped' names '${ss.at(i)}', which is not a parameter of " +
                    s"'$shown'$tail")
        else if twice
            a.fault(scope, span, s"'@scoped' names '${ss.at(i)}' twice, and a parameter is waited " +
                    "for or it is not — the second says nothing the first does not")
        else if !param_is_pointer(found.unwrap()) && !callable_param(d, found.unwrap()) &&
                !erased_call(found.unwrap())
            a.fault(scope, span, s"'@scoped' names '${ss.at(i)}', which is neither a call nor a " +
                    "pointer — what it promises is that a body a member runs in another domain " +
                    "finishes before the scope does, written '" + ss.at(i) + ": &sync Fn() -> R', " +
                    "or that a pointer the function holds is let go of before its caller's scope " +
                    s"ends, written '${ss.at(i)}: *T'")
end check_scoped_names

private param_is_pointer(p: Param) -> bool = *p.typ.kind match
    PtrType(_) -> true
    _ -> false

// What is wrong with a scoped member's receiver, as the end of a sentence, or nothing where it is the
// `*self` the promise is about.
private scoped_receiver(ps: Buf[Param]) -> string
    if ps.is_empty() || ps.at(0).name != "self" then return "has no receiver"

    *ps.at(0).typ.kind match
        PtrType(_) -> ""
        RefType(_, _) -> "takes '&self', a share of a value rather than the pointer a call lends"
        _ -> "takes 'self' by value, a copy rather than the pointer a call lends"
end scoped_receiver

// A call behind a reference, `&Fn(…)` or `&sync Fn(…)`: one body chosen at run time, which is what a
// member that hands its parameter to another domain usually holds.
private erased_call(p: Param) -> bool = *p.typ.kind match
    RefType(inner, _) -> *inner.kind match
        FnType(_, _, _) -> true
        _ -> false
    _ -> false

// A bare arrow, before the declaration's rewrite or after it: a type parameter of this declaration
// bounded by a call trait.
private callable_param(d: FuncDecl, p: Param) -> bool = *p.typ.kind match
    FnType(_, _, bare) -> bare
    NamedType(n, _) -> holds_string(d.tparams, n) && call_bounded(d.bounds, n)
    _ -> false

private call_bounded(bounds: Buf[NamedBounds], name: string) -> bool
    for nb in bounds
        if nb.name == name
            for b in nb.bounds
                if is_call_trait(module_bare(b.name)) then return true

    false
end call_bounded

// `Fn0` through the widest arity, which are the call traits a bound may name.
is_call_trait(name: string) -> bool
    for n in 0..<FnMaxArity + 1
        if name == fn_base(n) then return true

    false
end is_call_trait
