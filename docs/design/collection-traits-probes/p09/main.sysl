// p09: one impl for every cursor at once -- a blanket block over a bounded parameter.
trait Adapt
    twice_count(self) -> int

impl[I: Iterate] Adapt for I
    twice_count(self) -> int
        var n = 0
        var cur = self
        loop
            cur.next() match
                Some(_) -> n += 2
                None -> break
        n
    end twice_count

main()
    print((0..<3).twice_count())
