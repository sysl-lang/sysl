module sh.sysl.compiler
@tests

import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture

// Two writes of a by-value closure's copy that reach it from further off (`reference/expressions.md`).
//
// **A closure written inside one that holds a copy, capturing that one's local bound to the copy**
// (`val p = &k; run(() -> *p = 1)`): what it writes through the local is the outer closure's copy,
// however it holds the local itself -- by reference, by value in a closure it keeps, two levels deep,
// as a `&sync Fn`. Asked the same two questions a write in the outer body is, said where it is made.
//
// **A `*self` method on a captured handle that re-points the handle** (`self.r = other`, `*self = h`,
// directly or through a `*self` method of its own it calls) writes the closure's copy, as a method on
// any other struct does. One that writes only through the handle's references -- `Buf.view_mut`,
// `release` of a `Buf`, a `Map` and a `Deque`, a user handle's -- stays accepted.
//
// Each accepted cell runs at `-O0` and `-O2`. The helpers are `tests_enm_enum_run.sysl`'s.

private const cwz_prelude: string = "import sysl.buf.{Buf, buf}\nimport sysl.container.{Map, map, Deque, deque}\n\n" +
    "fill(dst: []u8) = dst[0] = 7\n\nbump(p: *int) = *p += 1\n\n" +
    "run(f: &Fn() -> unit) = f()\n\n" +
    "var kept: Option[&Fn() -> unit] = None\n\ncall(f: &Fn() -> unit)\n    kept = Some(f)\n    f()\n\n" +
    "struct R\n    r: &int\n\n    poke(*self) = *self.r += 1\n\n    nudge(*self) = self.poke()\n\n" +
    "    repoint(*self, o: &int) = self.r = o\n\n    reset(*self) = self.repoint(9)\n\n" +
    "    renew(*self)\n        *self = R(1)\n\n"

private cwz_lost(name: string, form: string) -> string =
    s", so it holds a copy of '$name' — so $form would reach that copy rather than the variable it " +
    s"came from, and the variable is used afterwards as though it had. Where you mean to change '$name'"

private cwz_unread(name: string, form: string) -> string =
    s", so it holds a copy of '$name' — so $form would reach that copy rather than the variable it " +
    s"came from, and nothing in the closure reads it back"

// What a refused program said, checked to hold `want` exactly once.
private cwz_refused(text: string, want: string) -> string
    val said = enm_err(cwz_prelude + text)

    assert(enm_says(said, want), said)

    val first = said.index_of(want).unwrap()

    assert(said[first + want.bytes.len..<said.bytes.len].index_of(want).is_none(), said)
    said
end cwz_refused

// What an accepted program printed, built at `level`.
private cwz_ran_at(text: string, level: string) -> string
    val root = make_temp_dir("sysl-cwz").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", forms_imported(cwz_prelude + text)).unwrap()

    val exe = s"$root/built"

    build_native_program(s"$root/main.sysl", None, None, level, Some(exe)) match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return failure_text(why)
        Ok(_) -> ()

    val said = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    said match
        Err(_) -> "the program that was built could not be run"
        Ok(out) -> if out.status.ok() then out.text else s"it did not exit zero: ${out.text}"
end cwz_ran_at

private cwz_runs(text: string, want: string)
    for level in ["0", "2"]
        assert_eq(cwz_ran_at(text, level), want, s"at -O$level")

// ---- refused: a closure inside the one holding the copy writes through its local

@test("a nested closure writing through an address local of the outer closure's copy")
cwz_nested_store()
    if !enm_ready() then return

    cwz_refused("main()\n    var k = 0\n    call(() ->\n        val p = &k\n        run(() -> *p = 1))\n" +
                "    print(k)\n",
                cwz_unread("k", "assignment"))

@test("a nested closure the callee keeps, writing through the address local")
cwz_nested_kept()
    if !enm_ready() then return

    cwz_refused("main()\n    var k = 0\n    call(() ->\n        val p = &k\n        call(() -> *p += 2))\n" +
                "    print(k)\n",
                cwz_unread("k", "'+='"))

@test("two levels deep, the address handed on, the variable read afterwards")
cwz_two_deep()
    if !enm_ready() then return

    val said = cwz_refused("main()\n    var k = 0\n    call(() ->\n        val p = &k\n" +
                           "        run(() -> run(() -> bump(p))))\n    print(k)\n",
                           cwz_lost("k", "'bump', which is handed its address,"))

    assert(enm_says(said, "hand the callee '&*k'"), said)

@test("a nested closure writing through a view local")
cwz_nested_view()
    if !enm_ready() then return

    cwz_refused("main()\n    var out = [0u8; 4]\n    call(() ->\n        val v = out[0..<2]\n" +
                "        run(() -> v[1] = 7))\n    print(out)\n",
                cwz_unread("out", "assignment"))

@test("a nested closure handing on a view local, the variable read afterwards")
cwz_nested_view_handed()
    if !enm_ready() then return

    cwz_refused("main()\n    var out = [0u8; 4]\n    call(() ->\n        val v = out[0..<2]\n" +
                "        run(() -> fill(v)))\n    print(out)\n",
                cwz_lost("out", "'fill', which is handed a view of it,"))

@test("a nested '&sync Fn' handing on the address local")
cwz_nested_sync_fn()
    if !enm_ready() then return

    cwz_refused("main()\n    var k = 0\n    call(() ->\n        val p = &k\n" +
                "        val f: &sync Fn() -> unit = () -> bump(p)\n        f())\n    print(k)\n",
                cwz_lost("k", "'bump', which is handed its address,"))

@test("a local of the nested closure bound from the carried address, written through")
cwz_nested_rebound()
    if !enm_ready() then return

    cwz_refused("main()\n    var k = 0\n    call(() ->\n        val p = &k\n        run(() ->\n" +
                "            val q = p\n            *q = 4))\n    print(k)\n",
                cwz_unread("k", "assignment"))

// ---- refused: a handle's '*self' method re-pointing the handle

@test("a handle's '*self' method assigning its own reference field, in a kept closure")
cwz_handle_repoint()
    if !enm_ready() then return

    cwz_refused("main()\n    var h = R(0)\n    val o: &int = 5\n    call(() -> h.repoint(o))\n    print(*h.r)\n",
                cwz_unread("h", "'repoint', which takes '*self',"))

@test("a handle's '*self' method re-pointing through a '*self' method of its own")
cwz_handle_repoint_callee()
    if !enm_ready() then return

    cwz_refused("main()\n    var h = R(0)\n    call(() -> h.reset())\n    print(*h.r)\n",
                cwz_unread("h", "'reset', which takes '*self',"))

@test("a handle's '*self' method assigning the whole of 'self'")
cwz_handle_renew()
    if !enm_ready() then return

    cwz_refused("main()\n    var h = R(0)\n    call(() -> h.renew())\n    print(*h.r)\n",
                cwz_unread("h", "'renew', which takes '*self',"))

// ---- accepted

@test("a nested closure that only reads through the address local")
cwz_nested_reads()
    if !enm_ready() then return

    cwz_runs("main()\n    var k = 3\n    call(() ->\n        val p = &k\n        run(() -> print(*p)))\n" +
             "    print(k)\n",
             "3\n3\n")

@test("a nested closure writing through an address of what a captured '&int' boxes")
cwz_nested_box()
    if !enm_ready() then return

    cwz_runs("main()\n    val k: &int = 0\n    call(() ->\n        val p = &*k\n        run(() -> bump(p)))\n" +
             "    print(*k)\n",
             "1\n")

@test("'*self' methods of Buf, Map and Deque in kept closures reach the storage both sides share")
cwz_library_handles()
    if !enm_ready() then return

    cwz_runs("main()\n    var b: Buf[u8] = buf()\n    b.push(0)\n    b.push(0)\n" +
             "    call(() -> b.view_mut()[1] = 4)\n    call(() -> fill(b.view_mut()))\n" +
             "    var c: Buf[u8] = buf()\n    c.push(1)\n    call(() -> c.release())\n" +
             "    var m: Map[int, int] = map()\n    call(() -> m.put(1, 2))\n" +
             "    var n: Map[int, int] = map()\n    call(() -> n.release())\n" +
             "    var d: Deque[int] = deque()\n    d.push_back(0)\n    call(() -> d[0] = 3)\n" +
             "    var e: Deque[int] = deque()\n    call(() -> e.release())\n" +
             "    print(b[0], b[1], m.len(), d[0])\n",
             "7 4 1 3\n")

@test("a user handle's '*self' methods writing only through its reference, directly and by a callee")
cwz_handle_through()
    if !enm_ready() then return

    cwz_runs("main()\n    var h = R(0)\n    call(() -> h.poke())\n    call(() -> h.nudge())\n    print(*h.r)\n",
             "2\n")
