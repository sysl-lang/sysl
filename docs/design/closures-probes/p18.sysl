// A generator shape accepted today: the closure advances its own copy of a cursor through a '*self'
// call and answers what it read. Made twice over one 'cur', by value each starts from 0; by reference
// the second continues where the first stopped.
struct Cursor
    i: int

    next(*self) -> int
        self.i += 1
        self.i

take2(f: &Fn() -> int) -> int = f() * 10 + f()

run()
    var cur = Cursor(0)

    print(take2(() -> cur.next()))
    print(take2(() -> cur.next()))

run()
