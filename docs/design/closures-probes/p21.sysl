// The Task an async call makes holds its arguments until it is run. Answering that Task out of the
// frame whose local a closure argument points at is the escape that must be refused.
async work(f: &Fn() -> unit) -> int
    f()
    1

make() -> Task[int]
    var n = 0
    val p = &n

    work(() -> *p += 1)

print(block_on(make()))
