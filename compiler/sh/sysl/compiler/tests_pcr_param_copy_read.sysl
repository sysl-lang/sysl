@test("a copy overwritten, then put back through its address kept by a callee")
pcr_put_back_through_a_kept_address()
    pcr_refused(raw"""
        var stash: **int = null

        keep_it(p: **int)
            stash = p

        key(a: *int)
            var b = a
            keep_it(&b)
            b = &spare
            *stash = a
            f1(&b)
            stash = null

        other()
            var y = 5
            key(&y)

        main()
            other()
            print(*held)
        """, "keeps its parameter 'a'")

