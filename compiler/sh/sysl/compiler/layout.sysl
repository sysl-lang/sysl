module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.container.{Map, map}

// How much room a value takes, and on what boundary it sits.
//
// **It is a model of what the backend will do, kept beside the types rather than inside them.** A
// size depends on the target -- an address is four bytes or eight -- so it is asked of a `Layout`
// made for one machine, and two of them can be asked side by side, which is what makes a
// cross-compilation testable without one.
//
// **The rules are LLVM's and are mirrored rather than reasoned about.** An odd integer width costs
// what LLVM makes it cost: `u12` is two bytes aligned to two, `u96` is sixteen aligned to sixteen.
// A struct pads every field onto its own alignment and then pads its end onto the widest of them, so
// that an array of it steps by its size.

// A run of bits inside a packed struct's container.
struct BitRange
    name: string
    ty: Type
    offset: int
    width: int
end BitRange

// How wide the bits of a field are, where the field is one that can be packed into a container.
bitfield_width(t: Type) -> Option[int] = underlying(t) match
    Integer(bits, _, _) -> Some(bits)
    Enum(d) -> if d.simple then simple_enum_bits(d) else None
    _ -> None

private simple_enum_bits(d: &EnumType) -> Option[int] = d.underlying match
    Integer(bits, _, _) -> Some(bits)
    _ -> None

// The ranges a packed struct's fields occupy, where it is one whose fields are bit-sized.
//
// A `@packed` struct whose every field is a whole number of bytes is laid out end to end and is not
// a bitfield container; one with a field of an odd width is.
bitfield_ranges(s: &StructType) -> Option[Buf[BitRange]]
    if !s.packed then return None

    val fields = s.stored()
    var any_odd = false
    var all_known = true

    for item in fields
        bitfield_width(item.1) match
            Some(w) -> if w % 8 != 0 then any_odd = true
            None -> all_known = false

    if !any_odd || !all_known then return None

    var out: Buf[BitRange] = buf()
    var offset = 0

    for item in fields
        val w = bitfield_width(item.1).unwrap()

        out.push(BitRange(item.0, item.1, offset, w))
        offset += w

    Some(out)
end bitfield_ranges

// How wide the container holding a run of ranges is, in bits: a whole number of bytes, and never
// fewer than one.
bitfield_bits(ranges: Buf[BitRange]) -> int
    var used = 0

    for range in ranges
        used += range.width

    val bytes = (used + 7) / 8 * 8

    if bytes < 8 then 8 else bytes
end bitfield_bits

// The most bytes a value may be handed to a function in before it goes by address instead.
const DirectBytes: usize = 128

// What one target has already measured, keyed by the address of the declaration record.
//
// **A struct's size is asked of every struct holding it, so without this the work grows as three to
// the power of the nesting depth** -- each member is asked for its alignment and its size, and each
// answer rebuilds the member's own layout from its fields. Each entry holds the record itself, so
// the record cannot be freed and its address handed to a different one while the entry stands.
//
// **It is only safe once the records are finished**: a record's fields are filled in after it is
// registered, so the analysis measures without one and code generation, which runs over a finished
// program, measures with one. `computed` counts the layouts worked out from their fields.
struct LayoutMemo
    structs: Map[usize, (&StructType, usize, usize)]
    enums: Map[usize, (&EnumType, usize, usize)]
    computed: usize

    // Whether a struct or enum record holds a raised boundary in its own bytes (`holds_raised`).
    raised: Map[usize, bool]
end LayoutMemo

// A memo with nothing measured in it.
layout_memo() -> &LayoutMemo = LayoutMemo(map(), map(), 0, map())

// The measurements one target makes.
//
// **It is `TargetLayout` and not `Layout`, which is the one name in this compiler that its
// reference does not share**: `sh.sysl.parsing.Layout` is the lexer's indentation state, this module
// imports that package wholesale, and the two would collide. A memo belongs to the one target it
// was made for, so two targets never share an answer.
struct TargetLayout
    word_bits: usize
    memo: Option[&LayoutMemo]

    pointer_bytes(self) -> usize = self.word_bits / 8

    // A pointer that carries a table beside it.
    private fat(self) -> usize = self.pointer_bytes() * 2

    // How many bytes a value of the type takes.
    size(self, t: Type) -> usize = underlying(t) match
        Bool -> 1
        Char -> 4
        Integer(bits, _, _) -> int_alloc(bits)
        Fixed(bits, _, _) -> int_alloc(bits)
        Floating(bits, _) -> usize(bits / 8)
        Unit -> 0
        Never -> 0
        Unknown -> 0
        VaList -> self.pointer_bytes() * 4
        Ptr(_) -> if erased(underlying(t)) then self.fat() else self.pointer_bytes()
        Ref(_, _) -> if erased(underlying(t)) then self.fat() else self.pointer_bytes()
        Weak(inner) -> if is_trait(*inner) then self.fat() else self.pointer_bytes()
        CFn(_, _) -> self.pointer_bytes()
        Slice(_, _) -> self.pointer_bytes() * 3
        Str -> self.pointer_bytes() * 3
        Array(n, elem) -> usize(n) * self.size(*elem)
        Vector(n, elem) -> self.vector_size(n, *elem)
        Struct(d) -> if d.base == TaskBase then self.pointer_bytes() else self.struct_layout(d).0
        Enum(d) -> self.enum_size_of(d)
        _ -> 0

    private vector_size(self, n: int, elem: Type) -> usize =
        if underlying(elem) == Bool then usize(n + 7) / 8 else usize(n) * self.size(elem)

    private enum_size_of(self, d: &EnumType) -> usize =
        if d.simple then self.size(d.underlying) else self.enum_size(d)

    // Whether a value of the type is handed to a function by address rather than in registers.
    indirect(self, t: Type) -> bool = underlying(t) match
        Struct(_) -> self.size(t) > DirectBytes
        Array(_, _) -> self.size(t) > DirectBytes
        Enum(d) -> !d.simple && self.size(t) > DirectBytes
        _ -> false

    // The boundary a value of the type sits on.
    align(self, t: Type) -> usize = underlying(t) match
        Bool -> 1
        Char -> 4
        Integer(bits, _, _) -> int_align(bits)
        Fixed(bits, _, _) -> int_align(bits)
        Floating(bits, _) -> usize(bits / 8)
        Unit -> 1
        Never -> 1
        Unknown -> 1
        VaList -> self.pointer_bytes()
        Ptr(_) -> self.pointer_bytes()
        Ref(_, _) -> self.pointer_bytes()
        Weak(_) -> self.pointer_bytes()
        CFn(_, _) -> self.pointer_bytes()
        Slice(_, _) -> self.pointer_bytes()
        Str -> self.pointer_bytes()
        Array(_, elem) -> self.align(*elem)
        Vector(n, elem) -> highest_one_bit(max_usize(self.vector_size(n, *elem) * 2 - 1, 1))
        Struct(d) -> if d.base == TaskBase then self.pointer_bytes() else self.struct_layout(d).1
        Enum(d) -> self.enum_align_of(d)
        _ -> 1

    private enum_align_of(self, d: &EnumType) -> usize =
        if d.simple then self.align(d.underlying) else self.enum_align(d)

    // The size and the alignment a run of members end to end comes to.
    private aggregate(self, members: Buf[Type]) -> (usize, usize)
        var offset: usize = 0
        var widest: usize = 1

        for m in members
            val a = self.align(m)

            widest = max_usize(widest, a)
            offset = round_up(offset, a) + self.size(m)

        (round_up(offset, widest), widest)
    end aggregate

    private struct_layout(self, s: &StructType) -> (usize, usize)
        val memo = self.memo match
            Some(m) -> m
            None -> return self.struct_computed(s)

        val p: *StructType = &*s
        val key = usize(p)

        memo.structs.get(key) match
            Some(hit) -> return (hit.1, hit.2)
            None -> ()

        val both = self.struct_computed(s)

        memo.computed += 1
        memo.structs.put(key, (s, both.0, both.1))
        both
    end struct_layout

    private struct_computed(self, s: &StructType) -> (usize, usize)
        var members: Buf[Type] = buf()
        val fields = s.stored()

        for item in fields
            members.push(item.1)

        var bytes: usize = 0
        var alignment: usize = 0

        bitfield_ranges(s) match
            Some(ranges) ->
                bytes = usize(bitfield_bits(ranges) / 8)
                alignment = 1
            None ->
                if s.packed then
                    var total: usize = 0

                    for item in members
                        total += self.size(item)

                    bytes = max_usize(total, 1)
                    alignment = 1
                else
                    val both = self.aggregate(members)

                    bytes = both.0
                    alignment = both.1

        s.min_align match
            Some(n) -> if n > alignment then (max_usize(round_up(bytes, n), n), n) else (bytes, alignment)
            None -> (bytes, alignment)
    end struct_computed

    // Where a field begins inside its struct.
    field_offset(self, s: &StructType, field: string) -> Option[usize]
        var offset: usize = 0
        val fields = s.stored()

        for item in fields
            val name = item.0
            val ty = item.1

            if !s.packed then offset = round_up(offset, self.align(ty))

            if name == field then return Some(offset)

            offset += self.size(ty)

        None
    end field_offset

    // How much room the widest variant of an enum needs, and on what boundary it sits.
    payload_size(self, e: &EnumType) -> usize = self.payload(e).0

    payload_align(self, e: &EnumType) -> usize = self.payload(e).1

    // The payload's size and alignment, measured once per enum where there is a memo.
    private payload(self, e: &EnumType) -> (usize, usize)
        val memo = self.memo match
            Some(m) -> m
            None -> return self.payload_computed(e)

        val p: *EnumType = &*e
        val key = usize(p)

        memo.enums.get(key) match
            Some(hit) -> return (hit.1, hit.2)
            None -> ()

        val both = self.payload_computed(e)

        memo.computed += 1
        memo.enums.put(key, (e, both.0, both.1))
        both
    end payload

    // Every carrying variant's members laid end to end, the widest size and the widest alignment
    // among them. An enum where no variant carries anything has a payload of nothing, aligned to one.
    private payload_computed(self, e: &EnumType) -> (usize, usize)
        var bytes: usize = 0
        var widest: usize = 1

        for item in e.variants
            if item.carries then
                val both = self.variant_aggregate(item)

                bytes = max_usize(bytes, both.0)
                widest = max_usize(widest, both.1)

        (bytes, widest)
    end payload_computed

    private variant_aggregate(self, v: EnumVariant) -> (usize, usize)
        var members: Buf[Type] = buf()
        val fields = v.stored()

        for item in fields
            members.push(item.1)

        self.aggregate(members)
    end variant_aggregate

    private enum_size(self, e: &EnumType) -> usize
        val both = self.payload(e)

        round_up(round_up(4, both.1) + both.0, max_usize(4, both.1))
    end enum_size

    private enum_align(self, e: &EnumType) -> usize = max_usize(4, self.payload_align(e))

    // -- a boundary `@align(n)` raises -------------------------------------------------------------
    //
    // LLVM's textual types carry no alignment: a named struct is aligned to the widest of its members
    // and nothing can say more. So where `@align(n)` asks for more than a struct's fields give it,
    // LLVM's layout and this one part company -- everywhere the type is held, not only at its own
    // storage. `ir_lower.sysl` writes the gaps out for every type that holds one (`gapped_fields`),
    // and storage of one states the boundary where it is created.

    // Whether `@align(n)` on this struct asks for more than its fields already give it.
    raises(self, d: &StructType) -> bool
        if d.base == TaskBase then return false

        val n = d.min_align match
            Some(k) -> k
            None -> return false

        var natural: usize = 1

        if !d.packed && bitfield_ranges(d).is_none()
            val fields = d.stored()

            for item in fields
                natural = max_usize(natural, self.align(item.1))

        n > natural
    end raises

    // Whether a value of the type holds a raised struct anywhere in its own bytes -- the struct
    // itself, a struct, tuple or array holding one, a data enum one of whose variants does.
    holds_raised(self, t: Type) -> bool = underlying(t) match
        Struct(d) -> self.struct_holds_raised(d)
        Array(_, elem) -> self.holds_raised(*elem)
        Enum(d) -> !d.simple && self.enum_holds_raised(d)
        _ -> false

    struct_holds_raised(self, d: &StructType) -> bool
        if d.base == TaskBase then return false

        val p: *StructType = &*d
        val key = usize(p)

        self.memo match
            Some(m) ->
                m.raised.get(key) match
                    Some(hit) -> return hit
                    None -> ()
            None -> ()

        var answer = self.raises(d)
        val fields = d.stored()

        for item in fields
            if !answer && self.holds_raised(item.1) then answer = true

        self.memo match
            Some(m) -> m.raised.put(key, answer)
            None -> ()

        answer
    end struct_holds_raised

    enum_holds_raised(self, d: &EnumType) -> bool
        val p: *EnumType = &*d
        val key = usize(p)

        self.memo match
            Some(m) ->
                m.raised.get(key) match
                    Some(hit) -> return hit
                    None -> ()
            None -> ()

        var answer = false

        for item in d.variants
            if self.variant_holds_raised(item) then answer = true

        self.memo match
            Some(m) -> m.raised.put(key, answer)
            None -> ()

        answer
    end enum_holds_raised

    variant_holds_raised(self, v: EnumVariant) -> bool
        if !v.carries then return false

        val fields = v.stored()

        for item in fields
            if self.holds_raised(item.1) then return true

        false
    end variant_holds_raised

    // The boundary storage of the type is CREATED on -- a slot or a global -- where LLVM's own would
    // be less: only a type holding a raised struct needs saying.
    storage_align(self, t: Type) -> Option[int] =
        if self.holds_raised(t) then Some(int(self.align(t))) else None

    // The boundary an access may CLAIM through an address of a value of the type: the type's whole
    // boundary. An address may be into a box or a buffer, and those are the heap's -- but a type
    // aligned beyond what the allocating pair promises (`heap_align`) is boxed through the aligned
    // hook and laid after its header on its boundary (`emit_box.sysl`, `emit_arc.sysl`'s `box_pad`),
    // so no storage of the type is ever placed short of it.
    claim(self, t: Type) -> usize = self.align(t)

    // The boundary a block from the allocating pair begins on (`target.sysl`'s `heap_boundary`).
    heap_align(self) -> usize = heap_boundary(self.word_bits)

    // Whether a value of the type on the heap needs more than the allocating pair promises, and so
    // the aligned hook.
    beyond_heap(self, t: Type) -> bool = self.align(t) > self.heap_align()
end TargetLayout

// The layout a target measures with, remembering nothing: the one the analysis uses, while the
// records it measures are still being filled in.
layout_for(t: Target) -> TargetLayout = TargetLayout(t.pointer_bits(), None)

// The layout a target measures with over a finished program, remembering every struct and enum it
// has measured.
memo_layout_for(t: Target) -> TargetLayout = TargetLayout(t.pointer_bits(), Some(layout_memo()))

// An integer's alignment: the next power of two at or above its byte count, capped at sixteen.
int_align(bits: int) -> usize
    var a: usize = 1

    while a < 16 && a * 8 < usize(bits)
        a *= 2

    a
end int_align

// The room an integer takes: its bytes rounded up onto its own alignment.
int_alloc(bits: int) -> usize = round_up(usize(bits + 7) / 8, int_align(bits))

// The next multiple of `to` at or above `n`.
round_up(n: usize, to: usize) -> usize = (n + to - 1) / to * to

private max_usize(a: usize, b: usize) -> usize = if a > b then a else b

// The highest power of two at or below `n`.
private highest_one_bit(n: usize) -> usize
    if n == 0 then return 0

    var bit: usize = 1

    while bit <= n / 2
        bit *= 2

    bit
end highest_one_bit
