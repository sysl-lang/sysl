module sh.sysl.compiler

import sh.sysl.parsing.Span
import sysl.math.bigint.from_int
import sysl.buf.{Buf, buf}

// The forms the compiler answers to by name, and implements no part of.
//
// **`print` is a DESUGARING and not a builtin.** The compiler knows a handful of *names* the way it
// already knows `Option`'s variants, and the printing itself is the library's: a scalar reaches the
// library renderer for its width, and everything else reaches its own `Display`. Putting the seam at
// a name is what keeps the printing surface out of the compiler.

// `print(a, b, ...)` -- each value rendered by the library function its type reaches, a space
// between and a newline at the end.
//
// **The space and the newline go out as characters rather than one-character strings**, so printing
// a number reaches nothing that allocates: a `string` is reference-counted, and a single
// `prints(" ")` would pull the whole reference-counting runtime and an allocator into a program
// whose own code asks for neither.
print_call(cx: &Analyzer, span: Span, args: Buf[Expr]) -> TExpr
    var parts: Buf[TExpr] = buf()

    for i in 0..<args.len()
        if i > 0 then parts.push(print_char(cx, span, ' '))

        val v = through_ref(cx, type_expr_bare(cx, args.at(i)))

        warn_placeholder(cx, args.at(i).span, args.at(i), v)
        parts.push(print_one(cx, span, v))

    parts.push(print_char(cx, span, '\n'))
    TExpr(span, TSeq(parts))
end print_call

// **A reference renders as what it refers to**, through the one level a member call reaches through
// to find an `impl` -- which is why no block may be written for `&T` itself. Every rendering form
// (`print`, `str`, an interpolation hole, a `format` hole) takes its value through here first, so a
// `&P`, a `&sync P` and a `&Buf[int]` print exactly as the `P` or the `Buf` would. A pointer is not
// reached through: an address is not a value that renders the same on every run. An object keeps its
// reference, since the reference is what carries its table.
through_ref(cx: &Analyzer, t: TExpr) -> TExpr = texpr_type(t) match
    Ref(_, _) -> auto_deref(cx, t)
    _ -> t

// One value, rendered by the library function that takes its type.
//
// **Every integer is widened to the one width its renderer takes** -- `long` or `ulong` -- so the
// library needs one function per *kind* rather than one per type, which sysl has no overloading to
// hide anyway. A float is the exception: each width has a renderer of its own, the digits that read
// back being a property of the width. A scalar keeps this direct path rather than
// going through its `Display`: the two render identically, and the one that does not build a sink
// is the one to emit.
private print_one(cx: &Analyzer, span: Span, t: TExpr) -> TExpr
    val ty = texpr_type(t)

    if ty == Unknown then return t

    // **An `f128` renders at its own width**, in the fewest digits that read back as it: widening the
    // other floats to a `real` is exact, but narrowing this one would print a number the program does
    // not hold.
    if is_quad(ty) then return library_call(cx, span, "printq", widened(span, t, Floating(128, false)))

    // **A fixed-point value renders itself**, as the shortest decimal that reads back as the same
    // value -- C has no conversion for one -- into a buffer on the caller's stack, and goes out as a
    // view of those characters. It is a scalar, so printing one allocates nothing, exactly as
    // printing the integer it is stored as does not; `str(x)` writes the same characters into a
    // string. A subtype over one renders as its base.
    if is_fixed(ty) then
        return library_call(cx, span, "putbytes",
                            TExpr(span, TIntOp("fixed_text", t, None, ty, Slice(byte_type(), true))))

    ty match
        // A width past 64 bits has no printf conversion to be widened to, so it renders itself
        // first and goes out as the string that came back. That is the one scalar whose printing
        // allocates, and it allocates because C cannot be asked to do this one.
        Integer(bits, signed, _) ->
            if bits > 64 then return library_call(cx, span, "prints", TExpr(span, TStr(t)))

            if signed then library_call(cx, span, "printi", widened(span, t, Integer(64, true, false)))
            else library_call(cx, span, "printu", widened(span, t, Integer(64, false, false)))
        // Widening an `f32` is exact, but the widened value needs more digits than the `f32` did,
        // so `f32(0.1)` would print as `0.10000000149011612`.
        Floating(32, _) -> library_call(cx, span, "printf32", t)
        Floating(16, true) -> library_call(cx, span, "printbf16", t)
        Floating(16, _) -> library_call(cx, span, "printf16", t)
        Floating(_, _) -> library_call(cx, span, "printr", widened(span, t, Floating(64, false)))
        Bool -> library_call(cx, span, "printb", t)
        Char -> library_call(cx, span, "printc", t)
        Str -> library_call(cx, span, "prints", t)
        // Everything else writes itself into standard output through the trait, which is the same
        // dispatch `str` takes with a growable buffer in place of the sink.
        _ -> print_display(cx, span, t)
end print_one

// One value written to standard output through its `Display`. An object dispatches through the slot
// of its own table; every other value names the block that was written for it.
private print_display(cx: &Analyzer, span: Span, t: TExpr) -> TExpr =
    plan_call(span, renderer(cx, span, t, "print", "print"), stdout_call(cx, span), format_spec(cx, span))

// A rendering written into `out` under `spec`: an object through the slot of its own table, every
// other value through the function the plan names, handed the value the plan says.
private plan_call(span: Span, plan: (TExpr, string, Option[int]), out: TExpr, spec: TExpr) -> TExpr
    var args: Buf[TExpr] = buf()

    args.push(out)
    args.push(spec)

    plan.2 match
        Some(slot) -> TExpr(span, TVCall(plan.0, slot, args, Unit, false))
        None ->
            var all: Buf[TExpr] = buf()

            all.push(plan.0)

            for item in args
                all.push(item)

            TExpr(span, TCall(plan.1, all, Unit, false))
end plan_call

// The sink a bare `print` writes into, which the library names and this compiler only calls.
private stdout_call(cx: &Analyzer, span: Span) -> TExpr
    val key = library_key(cx, "stdout")

    if key.is_none()
        return cx.err(span, "'print' is written in terms of the library's 'stdout', which the " +
                      "standard module this compilation was given does not declare")

    val f = cx.an.tables.funcs.get(key.unwrap())

    if f.is_none() then return bad_expr(span)

    cx.an.uses(key.unwrap())
    TExpr(span, TCall(key.unwrap(), buf(),
                      declared_result(cx, f.unwrap().scope, f.unwrap().decl.ret_type,
                                      f.unwrap().decl.needs), false))
end stdout_call

// Whether a value renders through a printf conversion rather than through an `impl`: the five types
// the library has a renderer of its own for.
scalar_render(t: Type) -> bool = t match
    Integer(_, _, _) -> true
    Floating(_, _) -> true
    // A fixed-point value, and a subtype over one, renders through the compiler's own renderer --
    // there is no `Display` for one to reach.
    Fixed(_, _, _) -> true
    Constrained(_) -> is_fixed(t)
    Bool -> true
    Char -> true
    Str -> true
    _ -> false

// `str(x)` on a value that renders itself -- and, since an interpolation's holes are `str` calls,
// every `s"${value}"` over one too.
//
// **A scalar is not this**: an integer, a float, a bool, a char and a `string` each have a direct
// path that does not build a sink, and this is what everything else takes. The value writes itself
// into a growable buffer through its `Display`, and the bytes that land there become the string.
str_render(cx: &Analyzer, span: Span, t: TExpr) -> TExpr
    val found = renderer(cx, span, t, "make a string of", "str")

    TExpr(span, TRender(found.0, found.1, format_spec(cx, span), found.2))
end str_render

// Whether a value has a rendering of its own for a `%s` to hand it to -- a type parameter its
// bounds promised one, an object, anything else implementing `Display` or `Debug`, which every
// struct and enum does. A value with none is a mistake in the specifier rather than a missing
// implementation, so a `%s` hole over one is refused in the specifier's words.
renders_itself(cx: &Analyzer, ty: Type) -> bool
    val tr = display_bound(cx)
    val here = if !impls_of(cx.an, tr.name, owner_key(ty)).is_empty() then ty else underlying(ty)

    if erased(here) then return true

    here match
        Abstract(_, _) -> satisfies(cx.an, tr, here) || satisfies(cx.an, debug_bound(), here)
        _ -> conforms(cx.an, tr, here) || satisfies(cx.an, tr, here) || shows(cx, ty)
end renders_itself

// Whether a concrete value has a `Debug` rendering: its own or the one supplied for it, or the
// compiler's for a pointer, a callable and a weak reference.
private shows(cx: &Analyzer, ty: Type) -> bool
    if shown_by_rule(ty) then return true

    val dbg = debug_bound()
    val here = if !impls_of(cx.an, dbg.name, owner_key(ty)).is_empty() then ty else underlying(ty)

    is_fixed(here) || conforms(cx.an, dbg, here) || satisfies(cx.an, dbg, here)
end shows

// The values the compiler shows by rule, since no block may be written for them: a raw pointer
// (`reference/traits.md § Any type may carry an impl` refuses a memory mode as a subject), and every
// value `debug_by_rule` names.
private shown_by_rule(ty: Type) -> bool = ty match
    Ptr(inner) -> !is_trait(*inner) || slotless_debug(trait_bound_of(*inner).name)
    Ref(inner, _) -> is_trait(*inner) && slotless_debug(trait_bound_of(*inner).name)
    // A `volatile` value a program prints is read and printed as it always was; only a structure
    // shown around one leaves it unread (`debugger`).
    _ -> debug_by_rule(ty) && !is_device(ty)

// The types that are `Debug` by the compiler's rule rather than through a block, as a bound reads it
// and as `x.debug(…)` on one is answered (`rule_debug`): a callable, a C function pointer, a weak
// reference (shown without being followed), `unit`, a task, and device memory -- a `volatile`
// value, or an array or a view of them, which is shown by its type and never read: reading a
// register is an act with consequences, and printing a struct must not perform it.
debug_by_rule(ty: Type) -> bool = ty match
    CFn(_, _) -> true
    Weak(_) -> true
    Unit -> true
    _ -> is_closure_literal(ty) || task_result(ty).is_some() || is_device(ty)

private is_device(ty: Type) -> bool = ty match
    Volatile(_) -> true
    Array(_, elem) -> is_device(*elem)
    Slice(elem, _) -> is_device(*elem)
    _ -> false

// `x.debug(out, fmt)` on a value that is `Debug` by rule, answered with what the rule shows.
rule_debug(cx: &Analyzer, span: Span, receiver: TExpr, args: Buf[Expr]) -> TExpr
    if args.len() != 2 then return cx.err(span, "'debug' takes a sink and a specifier")

    plan_call(span, debugger(cx, span, through_ref(cx, receiver), "show", "debug"),
              type_expr_bare(cx, args.at(0)), type_expr_bare(cx, args.at(1)))
end rule_debug

// Which `display` a value reaches, and the table slot to read it out of where the value is an
// object rather than a type -- or, where it has no `Display`, which `debug`: **every value prints**,
// and `Display` is the override rather than the requirement. The plan names the value handed over
// too, since a pointer is handed over as its address.
//
// **A subtype renders exactly as its base does** -- a number or a character -- so it reaches the
// base's renderer rather than needing a `Display` of its own, which is what keeps a
// `type Percent = int :: 0..100` printing like the integer it is. Unless it has said otherwise: a
// block written for the subtype itself is an override, and collapsing first would find the base's
// and make that block compile and do nothing.
//
// `asked` is what the refusal of a concrete type says the program tried to do, and `form` is the
// special form a bound's refusal names -- the reference's `'str' needs 'T: Display'`, the form a
// reader wrote (an interpolation hole is a `str` call) rather than a description of it.
private renderer(cx: &Analyzer, span: Span, t: TExpr, asked: string,
                 form: string) -> (TExpr, string, Option[int])
    val vt = texpr_type(t)

    // A value with no type is one whose mistake was already told -- a constant in a loop of
    // definitions, a name that was refused -- and rendering it is not a second one.
    if vt == Unknown then return (t, "", None)

    if shown_by_rule(vt) then return debugger(cx, span, t, asked, form)

    val tr = display_bound(cx)
    val here = if !impls_of(cx.an, tr.name, owner_key(vt)).is_empty() then vt else underlying(vt)

    // An object has forgotten which type it holds, so the renderer is a word read out of its own
    // table: its `Display` where the trait it was erased at requires one, and otherwise the `Debug`
    // every table carries.
    if erased(here)
        val slot = display_slot(cx, here)

        if slot.is_none() then return debugger(cx, span, t, asked, form)

        return (t, s"${tr.name}.display", slot)
    end if

    // A type parameter renders through whatever its bounds promised, which is a dispatch to the
    // trait's own member rather than to a lowered one.
    //
    // **The complaint is one a thrown-away walk keeps**, exactly as an unlicensed call is: what a
    // parameter may be rendered by is settled by its bounds, so an instantiation -- which meets a
    // concrete type that renders perfectly well -- raises nothing and the bound nobody wrote is
    // asked for here or nowhere.
    here match
        Abstract(_, _) ->
            // The bound is asked for in the name of the form that was written -- `print` or
            // `str` -- rather than in the verb a concrete type's refusal reads with.
            val form = if asked == "print" then "print" else "str"

            // A parameter bounded by `Debug` alone prints through it, as a concrete type with no
            // `Display` does.
            if !satisfies(cx.an, tr, here) && satisfies(cx.an, debug_bound(), here) then
                return (t, s"${debug_bound().name}.debug", None)

            if !satisfies(cx.an, tr, here) then
                cx.an.bound_fault(cx.scope, span, s"'$form' needs '${type_show(here)}: ${tr.show()}'")

            return (t, s"${tr.name}.display", None)
        _ -> ()

    if !conforms(cx.an, tr, here) && !satisfies(cx.an, tr, here) then
        return debugger(cx, span, t, asked, form)

    val fname = member_func_name(cx, span, here, "display")

    cx.an.uses(fname)
    (t, fname, None)
end renderer

// Which `debug` a value reaches -- `renderer`'s answer for the other trait, which `f"${x}%?"`,
// `debug(x)` and a supplied `Debug`'s fields always take.
//
// **What no block may be written for is shown by rule**: a raw pointer as its address (an `impl` for
// a memory mode is refused, and a member call would reach through to the pointee), a callable as
// `<fn>`, a weak reference as `weak(…)` without following it. A fixed-point value renders itself as
// it does for `print`. Everything else has a `Debug`, its own or the one supplied for it.
private debugger(cx: &Analyzer, span: Span, t: TExpr, asked: string,
                 form: string) -> (TExpr, string, Option[int])
    val vt = texpr_type(t)

    if vt == Unknown then return (t, "", None)

    val dbg = debug_bound()

    if is_device(vt) then return (shown_text(span, s"<${type_show(vt)}>"), lib_fn(cx, "display_str"), None)

    if shown_by_rule(vt)
        vt match
            Ptr(inner) ->
                if !is_trait(*inner) then
                    return (TExpr(span, TCast(t, usize_type(word_bits(cx)))),
                            lib_fn(cx, "debug_address"), None)
            Weak(_) -> return (shown_after(span, t, "weak(…)"), lib_fn(cx, "display_str"), None)
            Unit -> return (shown_after(span, t, "()"), lib_fn(cx, "display_str"), None)
            _ -> ()

        val text = if task_result(vt).is_some() then "<task>" else slotless_text(vt)

        return (shown_after(span, t, text), lib_fn(cx, "display_str"), None)
    end if

    var shown = t
    var here = if !impls_of(cx.an, dbg.name, owner_key(vt)).is_empty() then vt else underlying(vt)

    // **An integer narrower than 64 bits is shown at 64**, by the one renderer each signedness has:
    // the value is the same, a field of a bitfield's `u3` is shown as the number it holds, and a
    // program printing a dozen widths carries one renderer rather than a dozen.
    here match
        Integer(bits, signed, _) ->
            if bits < 64
                here = Integer(64, signed, false)
                shown = TExpr(span, TCast(t, here))
            end if
        _ -> ()

    if erased(here)
        val slot = debug_slot(cx, here)

        if slot.is_none()
            cx.fault(span, s"cannot $asked a ${type_show(vt)} value — its table carries no " +
                     s"'${dbg.show()}'")
            return (t, "", None)
        end if

        return (t, s"${dbg.name}.debug", slot)
    end if

    // A parameter is asked for its bound where a program wrote the form. A supplied `Debug`'s field
    // (`asked` is "show") asks nothing: its bounds name the type's parameters, not a projection such
    // as `C::Label`, and each instantiation is read again with the field's type known.
    here match
        Abstract(_, _) ->
            if asked != "show" && !satisfies(cx.an, dbg, here) then
                cx.an.bound_fault(cx.scope, span, s"'$form' needs '${type_show(here)}: ${dbg.show()}'")

            return (t, s"${dbg.name}.debug", None)
        _ -> ()

    if is_fixed(here) then
        return (TExpr(span, TIntOp("fixed_text", t, None, vt, Slice(byte_type(), true))),
                lib_fn(cx, "display_pad"), None)

    // A `never` is not a value at all -- the expression does not finish -- so there is nothing to
    // show, and asking is the mistake.
    if here == Never
        cx.fault(span, s"cannot $asked a never value — it does not implement " +
                 s"'${module_show(library_key("Display"))}'")
        return (t, "", None)
    end if

    // **Nothing is refused for having no `Debug`**: a value whose type has none -- an opaque handle
    // held by value where its layout is private, a generic shape whose part has none -- is shown as
    // its type, in angle brackets, which is all that can be said about it from here.
    if !conforms(cx.an, dbg, here) && !satisfies(cx.an, dbg, here) then
        return (shown_after(span, t, s"<${type_show(here)}>"), lib_fn(cx, "display_str"), None)

    // Through the trait's own implementation, whose member carries a suffix where the type keeps the
    // name `debug` for a field or a member of its own.
    val fname = member_func_name(cx, span, here, "debug" + impl_alt(cx.an, dbg, here))

    cx.an.uses(fname)
    (shown, fname, None)
end debugger

// What a value shown by rule with no table slot writes: `<writer>` for a sink, `<fn>` otherwise.
private slotless_text(t: Type) -> string = erased_trait(t) match
    Some(o) -> if trait_bound_of(o).name == library_key("Writer") then "<writer>" else "<fn>"
    None -> "<fn>"

// `f.debug(out, fmt)` on an object whose table carries no `Debug` slot, which a generic `Debug` body
// reaches for an `Option[&Fn…]` or a `Buf` of callables: what `print(f)` writes, under the specifier.
callable_debug(cx: &Analyzer, span: Span, rty: Type, args: Buf[Expr]) -> TExpr
    if args.len() != 2 then return cx.err(span, "'debug' takes a sink and a specifier")

    var all: Buf[TExpr] = buf()

    all.push(shown_text(span, slotless_text(Ptr(rty))))
    all.push(type_expr_bare(cx, args.at(0)))
    all.push(type_expr_bare(cx, args.at(1)))
    TExpr(span, TCall(lib_fn(cx, "display_str"), all, Unit, false))
end callable_debug

// -- a value whose whole printed form is a placeholder ---------------------------------------------
//
// **Printing one directly is told, as a warning**: the program still builds and prints the
// placeholder, but a `print(w)` that shows `<writer>` was almost certainly meant to show something.
// Only the forms a program wrote are asked -- `print`, `str` and an interpolation hole, a `format`
// hole, `debug(x)`, and an argument meeting a `T: Debug` bound such as `assert_eq`'s -- and never a
// field, an element or a payload, which a supplied `Debug` shows as part of something larger.

// The placeholder a value's whole rendering would be, and why, where it is one.
placeholder_of(cx: &Analyzer, ty: Type) -> Option[(string, string)]
    if ty == Unknown || ty == Never then return None

    if shown_by_rule(ty)
        ty match
            Ptr(inner) -> if !is_trait(*inner) then return None
            Weak(_) -> return None
            Unit -> return None
            _ -> ()

        if task_result(ty).is_some() then
            return Some(("<task>", "a task has nothing to show until it is awaited — print what " +
                         "awaiting it answers"))

        if slotless_text(ty) == "<writer>" then
            return Some(("<writer>", "a Writer object carries no Debug; print the concrete sink, or " +
                         "ask for 'Writer + Debug'"))

        return Some(("<fn>", "a callable carries nothing to show; print what calling it answers"))
    end if

    if is_device(ty) || erased(ty) then return None

    val dbg = debug_bound()
    val here = if !impls_of(cx.an, dbg.name, owner_key(ty)).is_empty() then ty else underlying(ty)

    here match
        Abstract(_, _) -> return None
        Integer(_, _, _) -> return None
        _ -> ()

    if is_fixed(here) || conforms(cx.an, dbg, here) || satisfies(cx.an, dbg, here) then return None

    // A type with a `Display` of its own prints through it wherever a placeholder would be asked.
    val tr = display_bound(cx)

    if conforms(cx.an, tr, here) || satisfies(cx.an, tr, here) then return None

    Some((s"<${type_show(here)}>", s"'${type_show(here)}' has no Debug to show it with — an opaque " +
          "type's layout is its own module's; print it through that module, or hold it by pointer"))
end placeholder_of

// Tells a top-level rendering of `e` whose whole form is a placeholder, at `e`.
warn_placeholder(cx: &Analyzer, span: Span, e: Expr, t: TExpr)
    val written = *e.kind match
        Ident(n) -> s"'$n'"
        _ -> "this value"

    warn_placeholder_named(cx, span, written, t)
end warn_placeholder

// The same, with the value already named the way the caution names it.
warn_placeholder_named(cx: &Analyzer, span: Span, written: string, t: TExpr)
    val found = placeholder_of(cx, texpr_type(t))

    if found.is_none() then return

    cx.an.caution(cx.scope, span, s"printing $written shows only '${found.unwrap().0}': " +
                  found.unwrap().1)
end warn_placeholder_named

// A literal standing in for a value that is shown by rule.
private shown_text(span: Span, text: string) -> TExpr = TExpr(span, TStrLit(text))

// The same, after the value has been computed: **what is shown by rule is still evaluated**, since
// `print(str(print(1)))` prints the `1` whatever the `()` it shows. Device memory alone is not, being
// the one value whose reading is the act.
private shown_after(span: Span, t: TExpr, text: string) -> TExpr
    var stmts: Buf[TStmt] = buf()

    stmts.push(TExprStmt(t))
    TExpr(span, TBlockExpr(TBlock(stmts, Some(shown_text(span, text)), Str)))
end shown_after

// A library function a plan calls, marked reached; empty where the compilation has no library.
private lib_fn(cx: &Analyzer, name: string) -> string
    val key = library_key(cx, name)

    if key.is_none() then return ""

    cx.an.uses(key.unwrap())
    key.unwrap()
end lib_fn

// The library's `Display`, as the bound every rendering is asked about.
private display_bound(cx: &Analyzer) -> Bound = Bound(library_key("Display"), buf())

// The library's `Debug`, which every type has.
private debug_bound() -> Bound = Bound(library_key("Debug"), buf())

// Which slot of an object's table holds the renderer, where the trait it was erased at requires one.
private display_slot(cx: &Analyzer, ty: Type) -> Option[int] = trait_slot(cx, ty, display_bound(cx), "display")

// Which slot holds `debug`, which every table carries (`slotted_members`).
private debug_slot(cx: &Analyzer, ty: Type) -> Option[int] = trait_slot(cx, ty, debug_bound(), "debug")

private trait_slot(cx: &Analyzer, ty: Type, tr: Bound, member: string) -> Option[int]
    val obj = erased_trait(ty)

    if obj.is_none() then return None

    val members = slotted_members(cx.an, trait_bound_of(obj.unwrap()), self_binding(ty))

    for i in 0..<members.len()
        if members.at(i).0.name == tr.name && members.at(i).1.name == member then return Some(int(i))

    None
end trait_slot

// The specifier a bare rendering carries: no width, no precision, not left-aligned. A `f"…"` hole
// is the same node with the three the reader wrote.
private format_spec(cx: &Analyzer, span: Span) -> TExpr = spec_value(cx, span, 0, -1, false)

// The `FormatSpec` a rendering is handed, built from the three parts that cross the boundary.
//
// **The whole specifier is the value's to apply, not the string's**, which is what makes a width and
// a precision mean anything on a type that renders itself: a vector pads once around all of its
// components and hands the precision to each of them. Rendering with an empty specifier and applying
// the written one to the bytes that came out is the other reading, and it truncates -- `%.3s` over a
// vector answered `(0.` rather than `(0.333, -0.667)`, three characters of the text instead of three
// digits of each number.
spec_value(cx: &Analyzer, span: Span, width: int, prec: int, left: bool) -> TExpr
    val spec = reinstantiate(cx.an, library_key("FormatSpec"), buf())

    spec match
        Struct(d) ->
            var args: Buf[TExpr] = buf()

            args.push(TExpr(span, TIntLit(from_int(long(width)), d.fields.at(0).1)))
            args.push(TExpr(span, TIntLit(from_int(long(prec)), d.fields.at(1).1)))
            args.push(TExpr(span, TBoolLit(left)))
            TExpr(span, TStructNew(d, args))
        _ -> bad_expr(span)
end spec_value

// `str(x)` with a specifier of the reader's own -- the node `str_render` makes, at a `f"…"` hole's
// width, precision and justification instead of at none.
//
// **A width or a precision a hole computed is read at run time** (`counts`, one per `*` in the
// specifier), so the `FormatSpec` is then built by the library's `format_spec_of`, which applies C's
// reading of a negative count. A specifier written out in full is still a constant.
spec_render(cx: &Analyzer, span: Span, t: TExpr, spec: string, counts: Buf[TExpr]) -> TExpr
    val found = if spec_conversion(spec) == '?' then debugger(cx, span, t, "make a string of", "debug")
    else renderer(cx, span, t, "make a string of", "str")
    val parts = spec_parts(spec)
    val fmt = if counts.is_empty() then spec_value(cx, span, parts.0, parts.1, parts.2)
    else counted_spec(cx, span, spec, parts, counts)

    TExpr(span, TRender(found.0, found.1, fmt, found.2))
end spec_render

// The form a supplied `Debug` shows each field through. Its name has a space in it, so no program
// can call it by accident: it is the compiler's, written only by the library's `derive` body for
// `Debug` (`library/sysl/debug.sysl`).
const DebugPart: string = "debug part"

// `debug(x)` -- the string `x`'s `Debug` writes, which is `f"${x}%?"` with no width.
debug_string(cx: &Analyzer, span: Span, args: Buf[Expr]) -> TExpr
    if args.len() != 1 then return cx.err(span, "debug takes exactly one value")

    val v = through_ref(cx, type_expr_bare(cx, args.at(0)))

    warn_placeholder(cx, args.at(0).span, args.at(0), v)

    debug_of(cx, span, v)
end debug_string

// The `Debug` string of a value already read -- what `debug(x)` and `x.debug_string()` both become.
debug_of(cx: &Analyzer, span: Span, v: TExpr) -> TExpr
    val found = debugger(cx, span, v, "make a string of", "debug")

    TExpr(span, TRender(found.0, found.1, format_spec(cx, span), found.2))

// `debug part`(value, out, spec) -- one field of a supplied `Debug`, written through the field's own
// `Debug` or the rule for what has none; a reference is followed to what it refers to.
debug_part(cx: &Analyzer, span: Span, args: Buf[Expr]) -> TExpr
    if args.len() != 3 then return cx.err(span, s"'$DebugPart' takes a value, a sink and a specifier")

    val found = debugger(cx, span, through_ref(cx, type_expr_bare(cx, args.at(0))), "show", "debug")

    plan_call(span, found, type_expr_bare(cx, args.at(1)), type_expr_bare(cx, args.at(2)))
end debug_part

// Whether `debug` in call position is the form: like `embed`, it is an ordinary enough word to be
// somebody's own, so a function or a local of the name is what a call reaches.
debug_form(cx: &Analyzer, name: string) -> bool =
    name == "debug" && cx.lookup(name).is_none() && function_keys(cx, name).is_empty()

// The `FormatSpec` of a specifier with a `*` for its width, its precision or both: each `*` is the
// next count, and a part written in digits is the constant it always was.
private counted_spec(cx: &Analyzer, span: Span, spec: string, parts: (int, int, bool),
                     counts: Buf[TExpr]) -> TExpr
    val int_ty = texpr_type(counts.at(0))
    var seen_dot = false
    var width_star = false
    var prec_star = false

    for c in spec.chars
        if c == '.' then seen_dot = true

        if c == '*'
            if seen_dot then prec_star = true else width_star = true

    var next: usize = 0
    var args: Buf[TExpr] = buf()

    if width_star
        args.push(counts.at(next))
        next += 1
    else
        args.push(TExpr(span, TIntLit(from_int(long(parts.0)), int_ty)))

    if prec_star then args.push(counts.at(next))
    else args.push(TExpr(span, TIntLit(from_int(long(parts.1)), int_ty)))

    args.push(TExpr(span, TBoolLit(parts.2)))
    library_result_call_of(cx, span, "format_spec_of", args)
end counted_spec

// The separator and the terminator `print` puts around its values.
private print_char(cx: &Analyzer, span: Span, c: char) -> TExpr =
    library_call(cx, span, "printc", TExpr(span, TIntLit(from_int(long(int(c))), Char)))

// A value at the width its renderer takes, and the value itself where it is already that width.
private widened(span: Span, t: TExpr, to: Type) -> TExpr =
    if texpr_type(t) == to then t else TExpr(span, TCast(t, to))

// A call to a library function, built from an already-typed argument.
//
// **This is the one place the compiler calls a function it named itself** rather than one a program
// wrote, so it is the one place the translation from the library's own spelling to the key it is
// filed under belongs.
private library_call(cx: &Analyzer, span: Span, name: string, arg: TExpr) -> TExpr
    val key = library_key(cx, name)

    if key.is_none()
        return cx.err(span, s"'print' is written in terms of the library's '$name', which the " +
                      "standard module this compilation was given does not declare")

    var args: Buf[TExpr] = buf()

    args.push(arg)
    cx.an.uses(key.unwrap())
    TExpr(span, TCall(key.unwrap(), args, Unit, false))
end library_call

// The key the library files one of its own names under. It is looked up rather than composed, so
// that a library which moved a function between its modules is followed rather than guessed at --
// `prints` is `sysl$prints` and `chars_of` is `sysl.text$chars_of`, and nothing here should have to
// know which.
library_key(cx: &Analyzer, name: string) -> Option[string]
    val direct = module_qualify(StdModule, name)

    if cx.an.tables.funcs.has(direct) then return Some(direct)

    for i in 0..<cx.an.tables.funcs.len()
        val key = cx.an.tables.funcs.key_at(i)
        val bare = library_spelling(key)

        if bare.is_some() && bare.unwrap() == name then return Some(key)

    None
end library_key

// A call to a library function the compiler named for itself, at the result the library declares
// for it -- which is what a member the compiler provides but does not implement comes to.
library_result_call(cx: &Analyzer, span: Span, name: string, arg: TExpr) -> TExpr
    var args: Buf[TExpr] = buf()

    args.push(arg)
    library_result_call_of(cx, span, name, args)
end library_result_call

// The same, over any number of arguments.
library_result_call_of(cx: &Analyzer, span: Span, name: string, args: Buf[TExpr]) -> TExpr
    val key = library_key(cx, name)

    if key.is_none()
        return cx.err(span, s"this is written in terms of the library's '$name', which the " +
                      "standard module this compilation was given does not declare")

    val f = cx.an.tables.funcs.get(key.unwrap())

    if f.is_none() then return bad_expr(span)

    cx.an.uses(key.unwrap())
    TExpr(span, TCall(key.unwrap(), args,
                      declared_result(cx, f.unwrap().scope, f.unwrap().decl.ret_type,
                                      f.unwrap().decl.needs), false))
end library_result_call_of

// The same for a library function that is generic, made real at `targs`: the instantiation is
// registered and the call goes to it. Used where a renderer is generic over an integer type the
// hole's value has, which no declared parameter list can spell for a direct call by key.
library_generic_call_of(cx: &Analyzer, span: Span, name: string, targs: Buf[Type],
                        args: Buf[TExpr]) -> TExpr
    val key = library_key(cx, name)

    if key.is_none()
        return cx.err(span, s"this is written in terms of the library's '$name', which the " +
                      "standard module this compilation was given does not declare")

    val f = cx.an.tables.funcs.get(key.unwrap())

    if f.is_none() then return bad_expr(span)

    val inst = asked(cx, span, instantiate_func(cx.an, f.unwrap().scope, f.unwrap().decl, targs, false))

    cx.an.uses(inst)
    TExpr(span, TCall(inst, args,
                      declared_result(cx, f.unwrap().scope, f.unwrap().decl.ret_type,
                                      f.unwrap().decl.needs), false))
end library_generic_call_of

// `str_cast(bytes)` -- the bytes taken as a string, with nothing checked.
//
// **A program does not write this; it writes `sysl.text.from_utf8_unchecked`**, which is an
// ordinary library function over this form. Keeping the primitive under a raw-tier name rather than
// the readable one is what lets the two halves of the pair -- validating and not -- sit beside each
// other in `sysl.text`.
str_cast_call(cx: &Analyzer, span: Span, args: Buf[Expr]) -> TExpr
    if args.len() != 1
        return cx.err(span, "'str_cast' takes exactly one value, the bytes to take as a string")

    val t = type_expr_bare(cx, args.at(0))

    underlying(texpr_type(t)) match
        // Either view will do: making a string out of bytes reads them, and a `[]const u8` is the
        // shape `s.bytes` hands over, which is the commonest thing anyone validates.
        Slice(inner, _) ->
            if *inner != Integer(8, false, false)
                return cx.err(span, s"'str_cast' takes a []u8, but the value has type " +
                              s"${type_show(texpr_type(t))}")

            TExpr(span, TFromBytes(t))
        // An array of bytes is a view of itself here, on the same terms every other position takes
        // one on: this form asks for a `[]u8` and is one of the places that asks.
        Array(_, elem) ->
            if *elem != Integer(8, false, false)
                return cx.err(span, s"'str_cast' takes a []u8, but the value has type " +
                              s"${type_show(texpr_type(t))}")

            TExpr(span, TFromBytes(coerce(cx, t, Slice(elem, true))))
        Str -> cx.err(span, "'str_cast' makes a string out of bytes, and this value is already a " +
                      "string")
        other -> cx.err(span, s"'str_cast' takes a []u8, but the value has type ${type_show(other)}")
end str_cast_call

// `str_alias(bytes)` -- a `[]u8` taken as a `string` without looking at it **and without copying
// it**: the string is the slice's three words, sharing its owner the way `s[a..b]` shares a string's.
//
// `str_cast` copies because a `[]u8` can be written afterwards; this is the form for the program
// that needs the string to see those writes -- a buffer grown in place, whose text is read back as a
// `string` at every step without paying for a copy of the whole of it each time. What it gives up is
// therefore more than `str_cast` does: the caller also owes that nothing writes the viewed bytes
// while the string is alive. **A program does not write this either; it writes
// `sysl.text.str_view`**, which says so where a reader will look.
//
// The storage is still the compiler's business. A string outlives every frame, so a view of an array
// the frame owns moves that array to the heap (`escape.sysl`), and a view with no counted owner -- a
// `*T` region -- is the programmer's problem exactly as every `*T` is.
str_alias_call(cx: &Analyzer, span: Span, args: Buf[Expr]) -> TExpr
    if args.len() != 1
        return cx.err(span, "'str_alias' takes exactly one value, the bytes to view as a string")

    val t = type_expr_bare(cx, args.at(0))

    underlying(texpr_type(t)) match
        Slice(inner, _) ->
            if *inner != byte_type()
                return cx.err(span, s"'str_alias' takes a []u8, but the value has type " +
                              s"${type_show(texpr_type(t))}")

            TExpr(span, TStrView(t))
        Array(_, elem) ->
            if *elem != byte_type()
                return cx.err(span, s"'str_alias' takes a []u8, but the value has type " +
                              s"${type_show(texpr_type(t))}")

            TExpr(span, TStrView(coerce(cx, t, Slice(elem, true))))
        Str -> cx.err(span, "'str_alias' makes a string out of bytes, and this value is already a " +
                      "string")
        other -> cx.err(span, s"'str_alias' takes a []u8, but the value has type ${type_show(other)}")
end str_alias_call

// `va_start(ap)`, `va_end(ap)`, `va_copy(dst, src)` and `va_arg(ap)` -- the C variadic cursor, which
// no sysl body could implement and which the language therefore spells as forms.
va_form(cx: &Analyzer, span: Span, name: string, args: Buf[Expr],
        expected: Option[Type]) -> Option[TExpr]
    if name == "va_start"
        if !cx.in_variadic
            return Some(cx.err(span, "'va_start' is only allowed in a function declared with " +
                               "'...' — there is no tail here"))

        return Some(TExpr(span, TVaStart(va_list_of(cx, span, "va_start", args))))

    if name == "va_end" then return Some(TExpr(span, TVaEnd(va_list_of(cx, span, "va_end", args))))

    if name == "va_copy"
        if args.len() != 2
            return Some(cx.err(span, "'va_copy' takes two arguments, the va_list to start and the " +
                               "one to copy"))

        return Some(TExpr(span, TVaCopy(va_list_arg(cx, span, "va_copy", args.at(0)),
                                        va_list_arg(cx, span, "va_copy", args.at(1)))))

    if name == "va_arg"
        val ap = va_list_of(cx, span, "va_arg", args)

        if expected.is_none()
            return Some(cx.err(span, "'va_arg' reads the next argument as some type, and nothing " +
                               "here says which — annotate the variable it is read into"))

        return Some(TExpr(span, TVaArg(ap, va_arg_type(cx, span, expected.unwrap()))))

    None
end va_form

private va_list_of(cx: &Analyzer, span: Span, what: string, args: Buf[Expr]) -> TExpr
    if args.len() != 1
        return cx.err(span, s"'$what' takes exactly one argument, the va_list it walks")

    va_list_arg(cx, span, what, args.at(0))
end va_list_of

// A `va_list` reaches these by address: the walk advances the cursor, so what is handed over is
// where the cursor is and never a copy of it.
private va_list_arg(cx: &Analyzer, span: Span, what: string, arg: Expr) -> TExpr
    val t = type_expr_bare(cx, arg)

    texpr_type(t) match
        Ptr(inner) ->
            if *inner == VaList then t
            else cx.err(span, s"'$what' needs a va_list, not ${type_show(texpr_type(t))}")
        VaList ->
            TExpr(span, TAddrOf(require_place(cx, t, arg, s"'$what'", false), Ptr(VaList)))
        other -> cx.err(span, s"'$what' needs a va_list, not ${type_show(other)}")
end va_list_arg

// What a variadic argument may be read as. C promotes every one of them, so the narrow types are
// refused with the type to read instead rather than being read at a width the caller never sent.
//
// A subtype that checks nothing -- a measured `c type` above all -- is read as its base is, at the
// width the base has on the target being built for, which is the rule the passing side follows
// (`expr_call.sysl`'s `tail_peeled`): `long` is read as four bytes on a 32-bit Arm machine and eight
// on an LP64 one. A subtype with a range or a predicate is refused, since C hands back a bare value
// its check would never see. What is refused is quoted as the program wrote it.
private va_arg_type(cx: &Analyzer, span: Span, ty: Type) -> Type
    va_readable(cx, span, ty, ty)
    ty
end va_arg_type

private va_readable(cx: &Analyzer, span: Span, ty: Type, written: Type)
    ty match
        Constrained(d) ->
            if constraint_free(d)
                va_readable(cx, span, d.base, written)
                return

            cx.fault(span, s"a variadic argument cannot be read as ${type_show(written)} — it checks " +
                     s"its values, and C hands back a bare ${type_show(underlying(d.base))} that " +
                     "check would never see; read it as that and convert")
        Integer(bits, signed, _) ->
            if (bits >= 32 && bits <= 64) || bits == 128 then return

            if bits < 32
                cx.fault(span, s"a variadic argument is promoted to at least 32 bits, so it cannot be " +
                         s"read as ${va_shown(ty, written)} — read it as " +
                         s"${if signed then "'int'" else "'uint'"} and convert")
            else if bits < 128
                cx.fault(span, s"a variadic argument wider than 64 bits is promoted to 128, so it cannot " +
                         s"be read as ${va_shown(ty, written)} — read it as " +
                         s"${if signed then "'i128'" else "'u128'"} and convert")
            else
                cx.fault(span, s"a variadic argument is at most 128 bits wide, so it cannot be read as " +
                         s"${va_shown(ty, written)} — C passes a wider integer by address")
        Floating(bits, _) ->
            // A binary128 value is not promoted -- C passes a `long double` and a `__float128` as
            // itself -- so it is read at its own width, by the walk `emit_va_arg.sysl` writes for it.
            if bits == 64 || bits == 128 then return

            cx.fault(span, s"a variadic argument is promoted to double, so it cannot be read as " +
                     s"${va_shown(ty, written)} — read it as 'real' and convert")
        Char -> return
        Ptr(_) -> return
        CFn(_, _) -> return
        other ->
            cx.fault(span, s"a variadic argument cannot be read as ${va_shown(other, written)} — it " +
                     "may be an integer, a real, a char, a raw pointer, or the address of a function, " +
                     "or a type that is one of those under another name, such as a 'c type'")
end va_readable

// The type a refusal quotes: as written, with what it turned out to be beside it where the two differ.
private va_shown(ty: Type, written: Type) -> string =
    if ty == written then type_show(ty) else s"${type_show(written)} (${type_show(ty)} here)"
