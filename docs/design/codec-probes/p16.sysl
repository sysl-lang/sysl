// P16: `derives Codec` where Codec only joins two derivable traits
trait Enc
    enc(self) -> string

    derive[T] enc(self: T) -> string
        var out = ""
        for const f in T::Fields
            out = out + f.name
        out

trait Dec
    dec(self) -> int

    derive[T] dec(self: T) -> int = T::Fields.len

trait Codec: Enc + Dec

struct P derives Codec
    x: int
    y: int

print(P(1, 2).enc(), P(1, 2).dec())
