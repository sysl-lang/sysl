/** What an `f"…"` hole's computed width or precision comes to — `${x}%.${n}f`, `${s}%${w}s` — and
 * what an integer under a specifier renders as — `${n}%08x`.
 *
 * A program does not call these; the compiler does, at a specifier whose width or precision is a
 * hole of its own, and at every integer conversion. They read a count the way C's `*` does, which is
 * the one rule both halves of a specifier follow: a value C formats is handed the count, and a type
 * rendering itself through `Display` is handed the `FormatSpec` the same count makes.
 */

module sysl.fmt

import sysl.text.from_utf8_unchecked
import sysl.buf.byte_sink
import sysl.{FloatField, FloatValue, f32_value, quad_value, real_value, shortest_f32, shortest_quad,
             shortest_real, write_float_field, float_scratch_need, plain_real, plain_f32, plain_f16, plain_bf16, plain_quad}

/** An integer rendered through a printf specifier, written here rather than handed to C's
 * `snprintf`, so a target with no C library formats `${n}%d` exactly as a hosted one does.
 *
 * `n` is the value at `i128`, and `bits` is the width of the type it came from, up to 128: a `u128`
 * above `i128`'s maximum arrives as its two's complement, which an unsigned conversion reads at `bits`. `spec` is the whole specifier, `%` to conversion letter; a `*` in it
 * reads `width` or `precision`, as C's `*` does — a negative width left-justifies at its magnitude
 * and a negative precision is as though none was written.
 *
 * The rendering is C's, flag for flag: a precision is a minimum count of digits, and a precision of
 * zero renders a zero as nothing; `0` pads with zeros after the sign and the base prefix, and gives
 * way to `-` or to a precision; `+` and a space mark a non-negative signed value; `#` puts a leading
 * zero on an octal and `0x`, `0X` or `0b` on a non-zero hexadecimal or binary. A signed conversion
 * (`d`, `i`) keeps the value's sign, and an unsigned one (`u`, `o`, `x`, `X`, `b`) reads the value at
 * its own width, so `%x` of an `i32 -1` is `ffffffff` and of a `u8 255` is `ff`.
 */
format_int(n: i128, bits: int, spec: string, width: int, precision: int) -> string
    val b = spec.bytes
    val last = b.len - 1
    val conv = b[last]
    var i: usize = 1
    var left = false
    var plus = false
    var space = false
    var zero = false
    var alt = false

    while i < last && is_flag(b[i])
        if b[i] == u8('-') then left = true
        if b[i] == u8('+') then plus = true
        if b[i] == u8(' ') then space = true
        if b[i] == u8('0') then zero = true
        if b[i] == u8('#') then alt = true

        i += 1

    var w = 0

    if i < last && b[i] == u8('*')
        w = width
        i += 1
    else
        while i < last && is_digit(b[i])
            w = w * 10 + int(b[i] - u8('0'))
            i += 1
    end if

    if w < 0
        left = true
        w = -w
    end if

    var p = -1

    if i < last && b[i] == u8('.')
        i += 1

        if i < last && b[i] == u8('*')
            p = if precision < 0 then -1 else precision
        else
            p = 0

            while i < last && is_digit(b[i])
                p = p * 10 + int(b[i] - u8('0'))
                i += 1
        end if
    end if

    val signed = conv == u8('d') || conv == u8('i')
    val upper = conv == u8('X')
    val base: u32 = if conv == u8('o') then 8
    else if conv == u8('x') || conv == u8('X') then 16
    else if conv == u8('b') then 2
    else 10

    val negative = signed && n < 0
    val mag = magnitude(n, bits, negative)

    // The digits, written from the end of room for the longest: a hundred and twenty-eight binary ones.
    var digits: [128]u8 = [0; 128]
    var at: usize = 128
    var rest = mag

    if !(mag == 0 && p == 0)
        loop
            // Base ten divides; the others shift and mask, so no 128-bit division is called.
            val shift = if base == 16 then 4 else if base == 8 then 3 else 1
            val next = if base == 10 then tenth(rest) else rest >> shift
            val d = if base == 10 then u8(rest - next * 10) else u8(rest - (next << shift))
            val ten = if upper then u8('A') else u8('a')

            at -= 1
            digits[at] = if d < 10 then u8('0') + d else ten + d - 10
            rest = next

            if rest == 0 then break
    end if

    val count = int(128 - at)
    var zeros = if p > count then p - count else 0

    if alt && base == 8 && zeros == 0 && (count == 0 || digits[at] != u8('0')) then zeros = 1

    // The sign and the base's prefix, which zeros pad after and spaces pad before.
    var head: [3]u8 = [0; 3]
    var h: usize = 0

    if negative || (signed && (plus || space))
        head[0] = if negative then u8('-') else if plus then u8('+') else u8(' ')
        h = 1
    end if

    if alt && mag != 0 && (base == 16 || base == 2)
        head[h] = u8('0')
        head[h + 1] = if base == 2 then u8('b') else conv
        h += 2
    end if

    val body = int(h) + zeros + count
    var pad = if w > body then w - body else 0

    if zero && !left && p < 0
        zeros += pad
        pad = 0
    end if

    val field = from_utf8_unchecked(head[0..<h]) + run_of("0", zeros) +
        from_utf8_unchecked(digits[at..])

    if left then field + run_of(" ", pad) else run_of(" ", pad) + field
end format_int

/** A float rendered through a printf specifier, written here rather than handed to C's `snprintf`,
 * so a target with no C library formats `${x}%.3f` exactly as a hosted one does -- and a hosted one
 * prints what it printed before.
 *
 * `spec` is the whole specifier, `%` to conversion letter, which is one of `f`, `e`, `g` or an upper
 * case `F`, `E`, `G`; a `*` in it reads `width` or `precision` as `format_int`'s does. The digits are
 * the exact value's, rounded half to even at the position the conversion names, whatever the
 * precision -- `${0.125}%.2f` is `0.12` and `${2.5}%.0f` is `2` -- and the rest is C's, flag for
 * flag: `%e`'s exponent has at least two digits, `%g` takes the precision as significant digits
 * and drops trailing zeros unless `#` keeps them, `0` pads after the sign, and an infinity or a NaN
 * is `inf` or `nan` (upper case under an upper-case letter), never padded with zeros, a NaN carrying
 * no sign.
 */
format_real(x: real, spec: string, width: int, precision: int) -> string =
    float_text(real_value(x), spec, width, precision)

/** An `f32` under a printf specifier, as `format_real` renders the same value: an `f32` holds nothing
 * a `real` cannot, so the text is the same, and it is taken apart at its own width so that no double
 * arithmetic is asked of a machine that has only single precision.
 */
format_f32(x: f32, spec: string, width: int, precision: int) -> string =
    float_text(f32_value(x), spec, width, precision)

/** An `f128` under a printf specifier, rendered as `format_real` renders a `real` -- every digit the
 * exact value's, rounded half to even where the conversion says -- and taken apart at its own width,
 * so `${x}%.30e` prints thirty digits binary128 really holds rather than a `double`'s seventeen and
 * noise. A value that is not a `double`'s works in wider integers, and the digits buffer holds the
 * 11,563 significant digits the longest one has.
 */
format_f128(x: f128, spec: string, width: int, precision: int) -> string
    var sink = byte_sink()
    var digits: [11600]u8

    write_float_field(&sink, quad_value(x), float_field(spec, width, precision), digits[..])
    from_utf8_unchecked(sink.text())
end format_f128

/** Why `write_real`, `write_f32` or `write_f128` wrote nothing. */
enum FormatError
    /** The specifier is not one float conversion -- see `write_real` for what one is. */
    BadSpec

    /** The scratch is shorter than this request needs, and `needed` bytes would do. */
    Short(needed: usize)

/** The rendering, so that a refusal can be printed without matching on it. */
impl Display for FormatError
    display(self, out: *Writer, fmt: FormatSpec)
        var text = self match
            BadSpec -> "not a float conversion"
            Short(needed) -> s"the scratch needs $needed bytes"

        display_str(text, out, fmt)
    end display

/** A scratch this long is enough for `write_real` and `write_f32` under any specifier: the longest
 * exact `real` runs to 767 significant digits.
 */
const float_scratch_len: usize = 800

/** A scratch this long is enough for `write_f128` under any specifier: an `f128`'s subnormals run to
 * 11,563 significant digits.
 */
const f128_scratch_len: usize = 11600

/** `x` under a printf float conversion, written to `out` -- what `format_real` answers, without the
 * string, so a program that may not allocate, a C library's `printf` among them, prints a float
 * exactly. It allocates nothing: the digits are worked out in `scratch`, which the caller lends.
 *
 * `spec` is the whole specifier, `%` to conversion letter: C's flags (`-`, `+`, space, `#`, `0`), a
 * width, a precision, an `l` or `L` that is read and ignored (so a C format's own specifier can be
 * handed over as it stands), and one of `f F e E g G a A`. A `*` reads `width` or `precision` as
 * `format_real`'s does, and no precision at all is six digits for `%e`, `%f` and `%g` and every digit
 * the value holds for `%a`. The digits are the exact value's, rounded half to even. `%a` writes a
 * first digit of 1 for every value but zero, a subnormal included (`0x1p-1074`), as Apple's and musl's
 * C libraries do.
 *
 * `float_scratch_len` bytes of scratch are always enough, and most requests need far fewer: `%.17g`
 * needs 17, and `%a`, an infinity, a NaN and a zero need none. A scratch that is too short is refused
 * with `Short` before anything is written, naming a length that would do; a specifier that is not a
 * float conversion is `BadSpec`.
 */
write_real(x: real, out: *Writer, spec: string, width: int, precision: int,
           scratch: []u8) -> Result[unit, FormatError] =
    write_float(real_value(x), out, spec, width, precision, scratch)

/** An `f32` under a printf float conversion, written as `write_real` writes the same value -- which is
 * what C prints for a `float`, promoted to `double` -- and taken apart at its own width.
 */
write_f32(x: f32, out: *Writer, spec: string, width: int, precision: int,
          scratch: []u8) -> Result[unit, FormatError] =
    write_float(f32_value(x), out, spec, width, precision, scratch)

/** An `f128` under a printf float conversion, written as `format_f128` renders it: every digit the
 * exact value's, so `%.30Le` prints thirty digits binary128 really holds. `f128_scratch_len` bytes
 * are always enough.
 */
write_f128(x: f128, out: *Writer, spec: string, width: int, precision: int,
           scratch: []u8) -> Result[unit, FormatError] =
    write_float(quad_value(x), out, spec, width, precision, scratch)

private write_float(v: FloatValue, out: *Writer, spec: string, width: int, precision: int,
                    scratch: []u8) -> Result[unit, FormatError]
    if !is_float_spec(spec) then return Err(BadSpec)

    val f = float_field(spec, width, precision)
    val need = float_scratch_need(v, f)

    if scratch.len < need then return Err(Short(need))

    write_float_field(out, v, f, scratch)
    Ok(())
end write_float

// Whether `spec` is one float conversion's whole specifier: `%`, flags, a width (digits or `*`), a
// precision (`.` and digits or `*`), an optional `l` or `L`, and one of `f F e E g G a A`.
private is_float_spec(spec: string) -> bool
    val b = spec.bytes

    if b.len < 2 || b[0] != u8('%') then return false

    val conv = b[b.len - 1] | 0x20

    if conv != u8('f') && conv != u8('e') && conv != u8('g') && conv != u8('a') then return false

    var last = b.len - 1

    if b[last - 1] == u8('l') || b[last - 1] == u8('L') then last -= 1

    var i: usize = 1

    while i < last && is_flag(b[i])
        i += 1

    if i < last && b[i] == u8('*')
        i += 1
    else
        while i < last && is_digit(b[i])
            i += 1
    end if

    if i < last && b[i] == u8('.')
        i += 1

        if i < last && b[i] == u8('*')
            i += 1
        else
            while i < last && is_digit(b[i])
                i += 1
        end if
    end if

    i == last
end is_float_spec

/** A `real` as `str` and a plain hole write it -- what Rust's `{}` writes: the fewest digits that read
 * back as the same `real`, set out positionally, so `0.1`, `1`, `100000000000000000000` and
 * `0.0000001`, never an exponent and never a trailing `.0`; `-0`, `inf`, `-inf` and `NaN` for the rest.
 * The compiler calls it; a program writes `str(x)` or `"$x"`.
 */
format_real_plain(x: real) -> string
    var sink = byte_sink()

    plain_real(x, &sink, FormatSpec(0, -1, false))
    from_utf8_unchecked(sink.text())

/** An `f32` as `str` writes it: `format_real_plain`'s rule in the digits an `f32` needs. */
format_f32_plain(x: f32) -> string
    var sink = byte_sink()

    plain_f32(x, &sink, FormatSpec(0, -1, false))
    from_utf8_unchecked(sink.text())

/** An `f16` as `str` writes it: `format_real_plain`'s rule in the digits an `f16` needs. */
format_f16_plain(x: f16) -> string
    var sink = byte_sink()

    plain_f16(x, &sink, FormatSpec(0, -1, false))
    from_utf8_unchecked(sink.text())

/** A `bf16` as `str` writes it: `format_real_plain`'s rule in the digits a `bf16` needs. */
format_bf16_plain(x: bf16) -> string
    var sink = byte_sink()

    plain_bf16(x, &sink, FormatSpec(0, -1, false))
    from_utf8_unchecked(sink.text())

/** An `f128` as `str` writes it: `format_real_plain`'s rule in the digits an `f128` needs. */
format_f128_plain(x: f128) -> string
    var sink = byte_sink()

    plain_quad(x, &sink, FormatSpec(0, -1, false))
    from_utf8_unchecked(sink.text())

/** An `f128` in the fewest digits that read back as the same `f128`, spelled as `shortest` spells a
 * `real` -- what `shortest(x)` answers for one.
 */
format_f128_shortest(x: f128) -> string
    var buf: [48]u8

    from_utf8_unchecked(buf[0..<shortest_quad(x, buf[..])])

/** The fewest digits that read back as the same `f128` -- `0.1` for `0.1f128`, and up to thirty-six
 * for a value that needs them.
 */
shortest(x: f128) -> string = format_f128_shortest(x)

/** The fewest digits that read back as `x` -- among those, the closest to it, and a tie to the even
 * digit -- spelled as `%g` spells a number: `0.1`, `1e+23`, `5e-324`, `-0`, `inf`, `nan`. It is the
 * text a serializer wants, where `%g`'s six digits lose the value and seventeen print noise. The
 * algorithm is Ryu.
 */
shortest(x: real) -> string
    var buf: [32]u8

    from_utf8_unchecked(buf[0..<shortest_real(x, buf[..])])

/** The fewest digits that read back as the same `f32`, which is shorter than its widened `real`
 * needs: `shortest(f32(0.1))` is `0.1`, and `shortest(real(f32(0.1)))` is `0.10000000149011612`.
 */
shortest(x: f32) -> string
    var buf: [32]u8

    from_utf8_unchecked(buf[0..<shortest_f32(x, buf[..])])

private float_text(v: FloatValue, spec: string, width: int, precision: int) -> string
    var sink = byte_sink()
    var digits: [800]u8

    write_float_field(&sink, v, float_field(spec, width, precision), digits[..])
    from_utf8_unchecked(sink.text())

// A float specifier's flags, width and precision, read as `format_int` reads an integer's.
private float_field(spec: string, width: int, precision: int) -> FloatField
    val b = spec.bytes
    val last = b.len - 1
    var f = FloatField(b[last], 0, -1, false, false, false, false, false)
    var i: usize = 1

    while i < last && is_flag(b[i])
        if b[i] == u8('-') then f.left = true
        if b[i] == u8('+') then f.plus = true
        if b[i] == u8(' ') then f.space = true
        if b[i] == u8('0') then f.zero = true
        if b[i] == u8('#') then f.alt = true

        i += 1

    if i < last && b[i] == u8('*')
        f.width = width
        i += 1
    else
        while i < last && is_digit(b[i])
            f.width = f.width * 10 + int(b[i] - u8('0'))
            i += 1
    end if

    if f.width < 0
        f.left = true
        f.width = -f.width
    end if

    if i < last && b[i] == u8('.')
        i += 1

        if i < last && b[i] == u8('*')
            f.prec = if precision < 0 then -1 else precision
        else
            f.prec = 0

            while i < last && is_digit(b[i])
                f.prec = f.prec * 10 + int(b[i] - u8('0'))
                i += 1
        end if
    end if

    f
end float_field

/** An integer in base sixteen, as the string `f"$v%x"` makes, for code that wants the text without
 * writing an `f"…"`. `width` is a minimum count of digits, padded with zeros on the left, and `upper`
 * picks `A`-`F`. A negative value reads at its own width, two's complement, so `hex(i8(-1))` is
 * `"ff"` and `hex(-1)` (an `int`) is `"ffffffff"`. There is no `0x` prefix. Every integer
 * width is exact, `u128` and `i128` included, with no C library and no 128-bit division.
 */
hex[T: Integer](v: T, width: int = 0, upper: bool = false) -> string =
    radix(v, if upper then "X" else "x", width)

/** An integer in base two, as `f"$v%b"` makes it: `width` zero-pads, and a negative value reads at
 * its own width, so `binary(i8(-6))` is `"11111010"`.
 */
binary[T: Integer](v: T, width: int = 0) -> string = radix(v, "b", width)

/** An integer in base eight, as `f"$v%o"` makes it: `width` zero-pads, and a negative value reads at
 * its own width, so `octal(i8(-6))` is `"372"`.
 */
octal[T: Integer](v: T, width: int = 0) -> string = radix(v, "o", width)

private radix[T: Integer](v: T, conv: string, width: int) -> string =
    format_int(i128(v), int(sizeof(T)) * 8, radix_spec(conv, width), 0, -1)

// The specifier for one conversion letter and a minimum digit count: `%x`, or `%012x` for twelve.
private radix_spec(conv: string, width: int) -> string =
    if width > 0 then "%0" + format_int(i128(width), 32, "%d", 0, -1) + conv else "%" + conv

// The absolute value of a signed negative, or an unsigned conversion's reading of `n` at `bits`. Each
// step keeps to what `i128` holds, so `i128`'s minimum and a `u128`'s maximum (which arrives as -1)
// need no wider type.
private magnitude(n: i128, bits: int, negative: bool) -> u128
    if negative then return u128(-(n + 1)) + 1

    if n >= 0 then return u128(n)

    if bits < 128 then return u128(n + (i128(1) << bits))

    // n + 2^128, as (n + 1 + (2^127 - 1)) + 2^127
    val top = i128(1) << 126
    val most = top - 1 + top

    u128(n + 1 + most) + (u128(1) << 127)
end magnitude

// `x` divided by ten. Under sixty-four bits it is a 64-bit division; above, the number is divided as
// four 32-bit limbs in `u64` arithmetic, so a target with no compiler runtime has no 128-bit
// division to call.
private tenth(x: u128) -> u128
    if (x >> 64) == 0 then return u128(u64(x) / 10)

    var r: u64 = 0
    var out: u128 = 0

    for i in 0..<4
        val limb = u64((x >> (96 - 32 * i)) & 0xffffffff)
        val cur = (r << 32) | limb

        out = (out << 32) | u128(cur / 10)
        r = cur % 10

    out
end tenth

// `n` copies of the one-byte `s`, by doubling, so a wide field costs a handful of joins. It needs no
// buffer that could fail and report it, which is what keeps a bare target's formatting free of
// anything it would have to supply.
private run_of(s: string, n: int) -> string
    var out = ""
    var piece = s
    var k = n

    while k > 0
        if k % 2 == 1 then out = out + piece

        k /= 2

        if k > 0 then piece = piece + piece

    out
end run_of

private is_flag(c: u8) -> bool =
    c == u8('-') || c == u8('+') || c == u8('0') || c == u8(' ') || c == u8('#')

private is_digit(c: u8) -> bool = c >= u8('0') && c <= u8('9')

/** A count as the `int` C's `*` reads, saturated at `int`'s range rather than wrapped into it.
 *
 * The compiler hands every integer over at `i128`, which holds any of them up to 64 bits exactly,
 * so a `usize` past `int` is a very wide field rather than a negative one.
 */
format_count(n: i128) -> int =
    if n > 2147483647 then 2147483647
    else if n < -2147483647 then -2147483647
    else int(n)

/** The `FormatSpec` a run-time width and precision make, read as C reads a `*`: a negative width
 * left-justifies the field at its magnitude, and a negative precision is as though none was written.
 */
format_spec_of(width: int, prec: int, left: bool) -> FormatSpec =
    FormatSpec(if width < 0 then -width else width, if prec < 0 then -1 else prec, left || width < 0)
