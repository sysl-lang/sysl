// Vectors over any field — the half of a vector space whose operators return a *scalar*.
//
// This file exists for one line of the operator rules: an operator trait's result is an argument, so
// `v * w` may be a `T` while `v * 2.0` is a `Vector[T]`. Both are `Mul` on `Vector[T]`, told apart by
// the type of the right operand and by nothing else, and each says what it gives back. Written with
// the result fixed to `Self` the first of them is unspellable, and a dot product becomes a method
// while scaling stays an operator — which is the split this program was chosen to test.
//
// **And every one of them is written once, for every element type at once.** A block whose trait
// arguments are built out of its own parameter says the same thing at every instantiation, so
// `impl[T: Scalar] Mul[Vector[T], T] for Vector[T]` is one dot product for the reals, the complexes
// and whatever else implements `Scalar`.
//
// A `Vector[T]` is a struct of a length and a `&Buf[T]`, so it is a *handle*: assigning one shares
// the numbers and costs a retain. Every operator below therefore builds a fresh vector rather than
// writing into either operand, and the one place that does write in place says so in its name
// (`set`). `copy` is how a caller stops sharing, which is the same bargain a string strikes: the
// operation that copies is named, and the sharing is documented rather than encoded.

import sysl.buf.{Buf, buf}
import sysl.math.Float

struct Vector[T: Scalar]
    n: int
    cells: &Buf[T]

    at(self, i: int) -> T = self.cells.at(usize(i))

    set(*self, i: int, v: T) = self.cells.set(usize(i), v)

    // The dot product of a vector with itself, which is `self * self` — the first place this program
    // relies on a `*` whose result is not its operands' type.
    //
    // **Over the reals this is the squared length, and over the complexes it is not.** `z * z` is a
    // complex number, and a sum of them can be zero for a vector that is nowhere near the origin.
    // That identity is a fact about the reals rather than about vector spaces, and generalising the
    // program is what exposed it — which is why the length below is computed from magnitudes and not
    // from this.
    quadratic_form(self) -> T = self * self

    // The Euclidean length: the root of the sum of the squared *magnitudes*, which is the definition
    // that holds at every element type this program admits.
    len(self) -> real
        var total = 0.0

        for i in 0..<self.n
            var m = self.at(i).magnitude()

            total += m * m

        total.sqrt()
    end len

    copy(self) -> Vector[T]
        var out: Vector[T] = zeros(self.n)

        for i in 0..<self.n do out.set(i, self.at(i))

        out

    // Floating point makes equality the wrong question almost everywhere, so this is the one the
    // checks actually ask. The tolerance is a `real` whatever the elements are, because what is being
    // compared is the *size* of a difference and a size is a magnitude.
    near(self, rhs: Vector[T], eps: real) -> bool
        if self.n != rhs.n then return false

        for i in 0..<self.n
            if (self.at(i) - rhs.at(i)).magnitude() > eps then return false

        true
    end near

    text(self) -> string
        var out = "("

        for i in 0..<self.n
            if i > 0 then out += ", "
            out += str(self.at(i))

        out + ")"
    end text
end Vector

// The zero vector, which needs the element type's own zero and has no other way to get one. This is
// the function `Zero` was added to the library for: `T.zero()` is a value of a type this body has
// never met, and no literal spells it.
//
// **The annotation on `out` is what the concrete version did not need.** `zeros(self.n)` has no
// argument to read `T` off and no expected type in a bare `var`, so the declaration says it once —
// which is where a type belongs when the context cannot supply it.
zeros[T: Scalar](n: int) -> Vector[T]
    var cells: Buf[T] = buf()

    for i in 0..<n do cells.push(T.zero())

    Vector(n, cells)

// A vector from the numbers a program wrote, which is what every check is built out of. The element
// type comes off the slice, so `vector([1.0, 2.0])` is a `Vector[real]` and nothing is written twice.
vector[T: Scalar](xs: []const T) -> Vector[T]
    var out: Vector[T] = zeros(int(xs.len))

    for i in 0..<int(xs.len) do out.set(i, xs[i])

    out

// The `i`th standard basis vector, which is what a matrix's columns are read out with — and the
// second place an identity is asked for rather than written.
basis[T: Scalar](n: int, i: int) -> Vector[T]
    var out: Vector[T] = zeros(n)

    out.set(i, T.one())
    out

impl[T: Scalar] Add for Vector[T]
    add(self, rhs: Vector[T]) -> Vector[T]
        require self.n == rhs.n, "vectors added must have the same length"

        var out: Vector[T] = zeros(self.n)

        for i in 0..<self.n do out.set(i, self.at(i) + rhs.at(i))

        out
    end add

impl[T: Scalar] Sub for Vector[T]
    sub(self, rhs: Vector[T]) -> Vector[T]
        require self.n == rhs.n, "vectors subtracted must have the same length"

        var out: Vector[T] = zeros(self.n)

        for i in 0..<self.n do out.set(i, self.at(i) - rhs.at(i))

        out
    end sub

impl[T: Scalar] Neg for Vector[T]
    neg(self) -> Vector[T]
        var out: Vector[T] = zeros(self.n)

        for i in 0..<self.n do out.set(i, -self.at(i))

        out
    end neg

// The dot product: two vectors in, one **element** out. `Mul[Vector[T], T]` — the operands select the
// implementation and the implementation says the result, so this and the scaling below are one
// operator on one type.
//
// The accumulator starts at `T.zero()`, which is also what makes a zero-length vector's dot product
// the value every other one has rather than a case to special-case.
impl[T: Scalar] Mul[Vector[T], T] for Vector[T]
    mul(self, rhs: Vector[T]) -> T
        require self.n == rhs.n, "vectors multiplied must have the same length"

        var total = T.zero()

        for i in 0..<self.n do total += self.at(i) * rhs.at(i)

        total
    end mul

// Scaling, whose result *is* a vector. Nothing but the right operand's type tells this from the dot
// product above, and nothing needs to.
impl[T: Scalar] Mul[T] for Vector[T]
    mul(self, k: T) -> Vector[T]
        var out: Vector[T] = zeros(self.n)

        for i in 0..<self.n do out.set(i, self.at(i) * k)

        out
    end mul

impl[T: Scalar] Index[int, T] for Vector[T]
    index(self, i: int) -> T = self.at(i)

impl[T: Scalar] IndexSet[int, T] for Vector[T]
    index_set(*self, i: int, v: T) = self.set(i, v)
