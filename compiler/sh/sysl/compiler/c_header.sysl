module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.text.{from_utf8_unchecked, str_builder}

// **What a C header for this program's exports would declare.**
//
// Only the part two checks need is here: which named aggregates the exported signatures reach, and
// what each is called in C. Rendering the file itself belongs to the command that writes one, and
// nothing in `emit-llvm` does.

// Every named aggregate the exported signatures reach, **innermost first**.
//
// A struct is reached through a parameter, a result, a pointer's pointee, a function pointer's own
// signature, another struct's field, or an array's element -- so the walk follows all of them rather
// than only the top level, and a type mentioned twice is defined once.
//
// It is here rather than inside the check that reads it because the header would ask the same
// question -- which types land in the file -- and working that set out a second time is how the two
// would come to disagree about what is in it.
header_aggregates(exports: Buf[TFunc], storage: Buf[TVal] = buf()) -> Buf[Type]
    var seen: Buf[Type] = buf()
    var named: Buf[Type] = buf()

    for f in exports
        for j in 0..<f.params.len()
            header_walk(f.params.at(j).1, &seen, &named)

        header_walk(f.ret_ty, &seen, &named)

    for v in storage
        header_walk(v.ty, &seen, &named)

    named
end header_aggregates

private header_walk(t: Type, seen: *Buf[Type], named: *Buf[Type])
    t match
        // An exported `type` is a `typedef`, and what it stands for goes first for a struct's reason:
        // a pointer to a struct names a type the C compiler must already have met. It is matched
        // before `surface`, which would see straight through a transparent one to its base.
        Constrained(d) ->
            if d.cname.is_some()
                if !first_sight(t, seen) then return

                header_walk(d.base, seen, named)
                named.push(t)
            else header_walk(d.base, seen, named)
        Volatile(inner) -> header_walk(*inner, seen, named)
        _ -> header_aggregate(header_surface(t), seen, named)
end header_walk

private header_aggregate(r: Type, seen: *Buf[Type], named: *Buf[Type])
    if !first_sight(r, seen) then return

    r match
        // The fields go first, so that what this definition lays out is already complete where the
        // C compiler reads it. An opaque struct lays nothing out, so what its fields reach is not
        // the header's business -- and a field type with no C spelling is no obstacle.
        Struct(d) ->
            if !d.opaque
                val fields = d.stored()

                for item in fields
                    header_walk(item.1, seen, named)

            named.push(r)
        Array(_, elem) -> header_walk(*elem, seen, named)
        Ptr(inner) -> header_walk(*inner, seen, named)
        CFn(params, ret) ->
            for param in params
                header_walk(param, seen, named)

            header_walk(*ret, seen, named)
        _ -> ()
end header_aggregate

// Whether the walk meets `t` for the first time, recording it where it does.
private first_sight(t: Type, seen: *Buf[Type]) -> bool
    for item in seen
        if type_eq(item, t) then return false

    seen.push(t)
    true
end first_sight

// A transparent named subtype or a qualifier taken off the top, and every name inside left where it
// was written -- a name there is exactly the thing a header is asked to spell.
private header_surface(t: Type) -> Type = t match
    Constrained(d) -> if d.derived then t else header_surface(d.base)
    Volatile(inner) -> header_surface(*inner)
    _ -> t

// The C name of a named type -- the one the author chose, or the derived one.
//
// **`@export("b2BodyId")` on the struct is what chooses it**, and it exists because everything else
// in a header is either the author's spelling or a C fixed-width name: a binding mirroring a C
// library wants to hand back that library's own type names. The choice is a claim, so the name check
// holds it to the property the derived form gives away -- that no two types in one header answer to
// one name.
//
// Derived, the mangled form is already unique per instantiation -- it is what the emitted module
// names the aggregate -- and the separators it uses are not C identifier characters, so they are
// replaced rather than the name being invented again here.
//
// **The replacement is where uniqueness stops, which is worth knowing before trusting the derived
// form.** The mangling is injective and the map onto `_` is not: a `C` in module `a.b` and a `b_C`
// in module `a` mangle apart and land on `a_b_C` together. The honest statement is that the derived
// name is *ordinarily* unique and the collision rule is what guarantees it.
c_name(t: Type) -> string = t match
    Struct(d) -> d.cname match
        Some(name) -> name
        None -> c_header_name(mangled(d.base, d.targs))
    Constrained(d) -> d.cname.unwrap_or("void")
    _ -> "void"

private c_header_name(name: string) -> string
    var out: Buf[u8] = buf()

    for i in 0..<name.bytes.len
        val b = name.bytes[i]

        out.push(if is_c_ident_byte(b) then b else u8('_'))

    from_utf8_unchecked(out.view())
end c_header_name

private is_c_ident_byte(b: u8) -> bool =
    (b >= u8('a') && b <= u8('z')) || (b >= u8('A') && b <= u8('Z')) ||
    (b >= u8('0') && b <= u8('9'))

// -- the file itself -----------------------------------------------------------------------------

// **The header `sysl build-c` writes**: the aggregates the exported signatures reach, then one
// prototype each, in the order the symbols sort.
//
// `name` is what the include guard is built from -- the project's name, so two headers in one C
// project do not collide. Anything not a C identifier is replaced, since a guard is a macro name
// and a project may be called what it likes.
c_header_render(funcs: Buf[TFunc], name: string, vals: Buf[TVal] = buf()) -> string
    val exports = exports_by_symbol(funcs)
    val storage = storage_by_symbol(vals)
    val guard = s"SYSL_${header_guard_name(name)}_H"
    var out = str_builder()

    out.push("/* Generated by sysl. The declarations a C project needs to call into this module. */\n")
    out.push(s"#ifndef $guard\n#define $guard\n\n")
    out.push("#include <stdbool.h>\n#include <stdint.h>\n#include <stddef.h>\n\n")

    if reaches_never(exports) then out.push(noreturn_macro())
    if per_thread_storage(storage) then out.push(thread_local_macro())

    out.push("#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n")

    // The aggregates the prototypes below name, defined before anything uses one. They come in
    // dependency order -- a struct with a struct in it after what it holds -- because C needs a
    // complete type to lay a member out, and there is nothing here to forward-declare around: a
    // by-value member is the case a forward declaration does not serve.
    val aggregates = header_aggregates(exports, storage)

    for item in aggregates
        out.push(s"${c_aggregate_definition(item)}\n")

    if exports.is_empty() && storage.is_empty()
        // A header with nothing in it is worth writing rather than refusing: a build that exported
        // nothing is a build whose author forgot the attribute, and an empty header says so where a
        // missing file would read as a step that had not run.
        out.push("/* This module exports nothing — no function in it is marked '@export'. */\n\n")
    else
        // The objects first, as a C header writes its `extern` variables above the functions that
        // use them.
        for item in storage
            out.push(s"${c_storage_declaration(item)};\n")

        if !storage.is_empty() && !exports.is_empty() then out.push("\n")

        for item in exports
            out.push(s"${c_prototype(item)};\n")

        out.push("\n")

    out.push("#ifdef __cplusplus\n}\n#endif\n\n")
    out.push(s"#endif /* $guard */\n")
    out.finish()
end c_header_render

// The exported functions of a compilation, in the order their C symbols sort. Sorted because the
// header is an artifact two builds of one tree must agree on byte for byte, and the order
// declarations were read in is the order the files happened to be walked.
//
// **A private export is not among them**: its symbol is for the image it is linked into (module `asm`,
// the package's own C), and a header is the API a C project is handed.
exports_by_symbol(funcs: Buf[TFunc]) -> Buf[TFunc]
    var out: Buf[TFunc] = buf()

    for i in 0..<funcs.len()
        if funcs.at(i).exported.is_some() && !funcs.at(i).export_hidden then out.push(funcs.at(i))

    for i in 1..<out.len()
        var j = i

        while j > 0 && symbol_of(out.at(j)) < symbol_of(out.at(j - 1))
            val held = out.at(j)

            out.set(j, out.at(j - 1))
            out.set(j - 1, held)
            j -= 1

    out
end exports_by_symbol

private symbol_of(f: TFunc) -> string = f.exported.unwrap_or("")

// The exported module storage of a compilation, in the order the symbols sort -- the public ones
// only, for `exports_by_symbol`'s reason.
storage_by_symbol(vals: Buf[TVal]) -> Buf[TVal]
    var out: Buf[TVal] = buf()

    for i in 0..<vals.len()
        if vals.at(i).exported.is_some() && !vals.at(i).export_hidden then out.push(vals.at(i))

    for i in 1..<out.len()
        var j = i

        while j > 0 && out.at(j).exported.unwrap() < out.at(j - 1).exported.unwrap()
            val held = out.at(j)

            out.set(j, out.at(j - 1))
            out.set(j - 1, held)
            j -= 1

    out
end storage_by_symbol

// One exported object as C declares it: `extern`, `const` where it is a `val` -- which C may then
// keep in read-only memory, as the object file does -- `volatile` where the storage is, and the
// thread-local storage class where each thread has its own. The qualifiers go on the declarator,
// beside the name, which is where C reads them as being about the object rather than about what a
// pointer points at: `int32_t const start`, `uint8_t * const banner`.
c_storage_declaration(v: TVal) -> string
    var declared = v.exported.unwrap()

    if !v.writable then declared = s"const $declared"
    if is_volatile(v.ty) then declared = s"volatile $declared"

    val tls = if v.thread_local then "SYSL_THREAD_LOCAL " else ""

    s"extern $tls${c_declare(v.ty, declared)}"
end c_storage_declaration

private is_volatile(t: Type) -> bool = t match
    Volatile(_) -> true
    _ -> false

private per_thread_storage(storage: Buf[TVal]) -> bool
    for item in storage
        if item.thread_local then return true

    false
end per_thread_storage

// C11 spells a thread-local object `_Thread_local` and C++11 `thread_local`, and a header written
// for both says which through a macro, as it does for `noreturn`.
private thread_local_macro() -> string =
    "#ifndef SYSL_THREAD_LOCAL\n" +
    "#if defined(__cplusplus)\n" +
    "#define SYSL_THREAD_LOCAL thread_local\n" +
    "#else\n" +
    "#define SYSL_THREAD_LOCAL _Thread_local\n" +
    "#endif\n" +
    "#endif\n\n"

// Whether any prototype in the header returns `never`, which is the only thing the macro below is
// written for.
private reaches_never(exports: Buf[TFunc]) -> bool
    for item in exports
        if is_never_type(item.ret_ty) then return true

    false
end reaches_never

private is_never_type(t: Type) -> bool = repr(t) match
    Never -> true
    _ -> false

// The no-return annotation, written once per header and only where something needs it.
//
// It is a macro rather than the keyword itself because the header serves two languages: `_Noreturn`
// is C11's spelling and is not valid C++ at all, while the `extern "C"` block says a C++ consumer is
// expected. Guarding on the version leaves an older compiler with an empty definition, which is a
// weaker declaration and not a broken one.
//
// `#ifndef` because a project may include two of these headers, and a macro defined twice is a
// warning where the include guard would not have helped -- that one is per project name.
private noreturn_macro() -> string =
    "#ifndef SYSL_NORETURN\n" +
    "#if defined(__cplusplus) && __cplusplus >= 201103L\n" +
    "#define SYSL_NORETURN [[noreturn]]\n" +
    "#elif defined(__STDC_VERSION__) && __STDC_VERSION__ >= 201112L\n" +
    "#define SYSL_NORETURN _Noreturn\n" +
    "#else\n" +
    "#define SYSL_NORETURN\n" +
    "#endif\n" +
    "#endif\n\n"

// One function, as C declares it. A parameter keeps the name sysl gave it -- a prototype's names are
// documentation and nothing else, and the reader is better served by `count` than by nothing.
//
// **A `never` result is annotated and a `unit` one is not**, though both spell as `void`. That
// difference is the only thing distinguishing the two on this side of the boundary: `never` says
// control does not come back, which lets the caller's compiler drop the code after the call and stop
// asking about paths that end in it. Rendered as a bare `void` it would be the strictly weaker claim
// `unit` already makes.
c_prototype(f: TFunc) -> string
    var params = ""

    if f.params.is_empty() then params = "void"
    else
        for i in 0..<f.params.len()
            if i > 0 then params += ", "

            params += c_declare(f.params.at(i).1, f.params.at(i).0)

    val no_return = if is_never_type(f.ret_ty) then "SYSL_NORETURN " else ""

    // The function's own name and parameter list are the declarator its result type wraps, which is
    // what puts a returned function pointer's `(*` ... `)` around them: `void (*get(void))(int32_t)`.
    s"$no_return${c_declare(f.ret_ty, s"${symbol_of(f)}($params)")}"
end c_prototype

// One aggregate, as C declares it -- a `typedef` of an anonymous struct, so that the name is usable
// without the `struct` keyword and reads the way a C API's own handles do.
//
// **An `opaque` struct is declared incomplete** -- `typedef struct h h;`, a tag with no body -- which
// is exactly C's `struct foo;`: the C caller may hold a `*h` and never see inside. **An exported
// `type` declares its name over what it stands for**, which is the declarator walk with the new name
// where a variable's would go: `typedef int32_t (*on_event)(int32_t);`.
private c_aggregate_definition(t: Type) -> string = t match
    Constrained(d) -> s"typedef ${c_declare(d.base, c_name(t))};\n"
    Struct(d) ->
        if d.opaque then return s"typedef struct ${c_name(t)} ${c_name(t)};\n"

        var fields = ""
        val stored = d.stored()

        for item in stored
            fields += s"\t${c_declare(item.1, item.0)};\n"

        s"typedef struct {\n$fields} ${c_name(t)};\n"
    _ -> ""

// A sysl type declaring `name` -- a parameter, a field, or (with `name` holding the function's own
// name and parameter list) a whole prototype.
//
// **C does not write a type and then a name.** The name is the innermost part of a *declarator* the
// type wraps around it: an array's `[n]` and a function's parameter list go after it, a pointer's
// `*` goes before it, and a function pointer is the two together, `R (*name)(A)`. Spelling the type
// whole and appending the name gives `void (*)(int32_t) f`, which no C compiler accepts. So this
// builds the declarator outward from the name, and `c_spell` is the same walk with no name at all --
// C's *abstract* declarator, `void (*)(int32_t)`.
c_declare(t: Type, name: string) -> string = t match
    // An exported `type` is spelled by its name wherever it appears, which makes it a base type here
    // whatever it stands for -- a `typedef` of a pointer is written `h name`, with the `*` already
    // inside the name. One that is not exported is spelled as what it stands for.
    Constrained(d) ->
        if d.cname.is_some() then (if name == "" then c_name(t) else s"${c_name(t)} $name")
        else c_declare(d.base, name)
    Volatile(inner) -> c_declare(*inner, name)
    _ -> c_declarator(t, name)

private c_declarator(t: Type, name: string) -> string = header_surface(t) match
    CFn(params, ret) ->
        var ps = ""

        if params.is_empty() then ps = "void"
        else
            for i in 0..<params.len()
                if i > 0 then ps += ", "

                ps += c_spell(params.at(i))

        c_declare(*ret, s"(*$name)($ps)")
    // A pointer to something whose declarator binds tighter than `*` -- an array or a function
    // pointer -- needs the parentheses that make the `*` apply first. An exported name is a base
    // type, so a pointer to one takes no parentheses whatever it names.
    Ptr(inner) ->
        if binds_tighter(*inner) && !typedefd(*inner) then c_declare(*inner, s"(*$name)")
        else c_declare(*inner, if name == "" then "*" else s"* $name")
    Array(length, elem) -> c_declare(*elem, s"$name[$length]")
    _ -> if name == "" then c_base(t) else s"${c_base(t)} $name"

private binds_tighter(t: Type) -> bool = header_surface(t) match
    Array(_, _) -> true
    CFn(_, _) -> true
    _ -> false

// Whether `t` is spelled by an exported `type`'s name, looking through a qualifier.
private typedefd(t: Type) -> bool = t match
    Constrained(d) -> d.cname.is_some()
    Volatile(inner) -> typedefd(*inner)
    _ -> false

// A sysl type as C spells it, with no name declared.
c_spell(t: Type) -> string = c_declare(t, "")

// A type that is not built from a declarator -- a scalar, a struct's name, a simple enum's integer.
//
// Only the types the export check admits reach here, so the fallthrough is unreachable rather than a
// default -- and it is written as a refusal in the text it produces, because a header that quietly
// emitted `void*` for something it did not understand would compile on both sides and be wrong in
// between.
private c_base(t: Type) -> string = header_surface(t) match
    Unit -> "void"
    Never -> "void"
    Bool -> "bool"
    // A `char` is a Unicode scalar value, which is four bytes and not C's `char`. `uint32_t` is what
    // it is; C's own name for that idea is `char32_t`, which needs a header C99 does not have.
    Char -> "uint32_t"
    Integer(bits, signed, _) -> s"${if signed then "" else "u"}int${bits}_t"
    // A fixed-point value crosses as the integer it is stored as -- CMSIS's `q31_t` is `int32_t`.
    Fixed(bits, _, signed) -> s"${if signed then "" else "u"}int${bits}_t"
    // The two sixteen-bit formats have C names of their own, and neither of them is a `float`.
    // Spelling either as a wider type would compile on both sides of the header and then pass a
    // value of one width where the callee reads another, which is the single failure a generated
    // header exists to make impossible.
    Floating(16, true) -> "__bf16"
    Floating(16, _) -> "_Float16"
    Floating(bits, _) -> if bits == 32 then "float" else "double"
    // A struct is named rather than written out, and `header_aggregates` is what put the definition
    // above the prototype. A **simple** enum is its underlying integer and is spelled as one: C's own
    // `enum` has an implementation-defined width, so naming the integer is what states the same
    // contract the rest of the header states.
    Struct(_) -> c_name(header_surface(t))
    Enum(d) -> if d.simple then c_spell(d.underlying) else s"/* no C spelling for ${type_show(t)} */ void"
    _ -> s"/* no C spelling for ${type_show(t)} */ void"

// A project's name as an include guard's middle: upper case where it can be, and an underscore
// wherever the name held something a macro may not.
private header_guard_name(name: string) -> string
    var out: Buf[u8] = buf()

    for i in 0..<name.bytes.len
        val b = name.bytes[i]

        out.push(if is_c_ident_byte(b) then upper_ascii(b) else u8('_'))

    from_utf8_unchecked(out.view())
end header_guard_name

private upper_ascii(b: u8) -> u8 = if b >= u8('a') && b <= u8('z') then b - 32 else b
