module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.from_utf8_unchecked
import sysl.time.now

// The names the language keeps for itself.
//
// **`__…__` belongs to the compiler, whether or not it means anything yet.** That is what lets a
// later release add one without breaking a program that guessed it, and it is why the refusal is
// about the *shape* rather than about the eight that are answered today.

// The built-ins the shape currently holds. **What each one answers is an expression**, so the
// answering is a later stage's; what belongs here is the refusal to let a declaration take one.
builtin_names() -> Buf[string]
    var out: Buf[string] = buf()

    out.push("__FILE__")
    out.push("__LINE__")
    out.push("__COLUMN__")
    out.push("__FUNCTION__")
    out.push("__DATE__")
    out.push("__TIME__")
    out.push("__NAME__")
    out.push("__VERSION__")
    out
end builtin_names

// Whether a name has the reserved shape: `__`, capitals and underscores, `__`.
reserved_shape(name: string) -> bool
    val b = name.bytes

    if b.len < 4 then return false
    if b[0] != u8('_') || b[1] != u8('_') then return false
    if b[b.len - 1] != u8('_') || b[b.len - 2] != u8('_') then return false

    for i in 2..<b.len - 2
        val c = b[i]

        if !(c >= u8('A') && c <= u8('Z')) && c != u8('_') then return false

    true
end reserved_shape

// What a declaration taking one is told.
refuse_reserved(name: string, what: string) -> string =
    s"'$name' begins and ends with '__', which is reserved for names the compiler answers for " +
    s"itself — so it is not a name a $what may take. Everything of that shape belongs to the " +
    s"language, whether or not it means anything yet, which is what lets a later release add one " +
    s"without breaking a program that guessed it. Write '${suggest_instead(name)}' instead"

// And what a *use* of one the compiler does not answer is told.
unknown_builtin(name: string) -> string
    val all = builtin_names()
    var list = ""

    for i in 0..<all.len()
        if i > 0 then list = s"$list, "

        list = s"$list${all.at(i)}"

    s"there is no built-in called '$name' — the shape '__…__' is the language's, and what it " +
    s"currently holds is $list"
end unknown_builtin

// The name to write instead: the middle, lowercased, with any leading or trailing underscore off.
private suggest_instead(name: string) -> string
    val b = name.bytes
    var lo: usize = 2
    var hi = b.len - 2

    while lo < hi && b[lo] == u8('_')
        lo += 1

    while hi > lo && b[hi - 1] == u8('_')
        hi -= 1

    if lo >= hi then return "a name of your own"

    var out: Buf[u8] = buf()

    for i in lo..<hi
        val c = b[i]

        out.push(if c >= u8('A') && c <= u8('Z') then c + u8(32) else c)

    from_utf8_unchecked(out.view())
end suggest_instead

// Every reserved-shaped name a declaration takes, with what kind of thing took it and where.
//
// One entry per offending name rather than one per declaration: a struct with two reserved fields
// made two mistakes.
reserved_in(s: Stmt) -> Buf[(string, string, Span)]
    var out: Buf[(string, string, Span)] = buf()

    collect_reserved(&out, s)
    out
end reserved_in

private named_reserved(out: *Buf[(string, string, Span)], name: string, what: string, span: Span)
    if reserved_shape(name) then out.push((name, what, span))

private tparams_reserved(out: *Buf[(string, string, Span)], ns: Buf[string], span: Span)
    for item in ns
        named_reserved(out, item, "type parameter", span)

private params_reserved(out: *Buf[(string, string, Span)], ps: Buf[Param])
    for item in ps
        named_reserved(out, item.name, "parameter", item.span)

private method_reserved(out: *Buf[(string, string, Span)], m: MethodDecl)
    named_reserved(out, m.name, "method", m.span)
    tparams_reserved(out, m.tparams, m.span)

    if m.body.is_empty() then params_reserved(out, m.params)

private collect_reserved(out: *Buf[(string, string, Span)], s: Stmt)
    *s.kind match
        FuncDecl(f) ->
            named_reserved(out, f.name, "function", s.span)
            tparams_reserved(out, f.tparams, s.span)

            if f.body.is_empty() then params_reserved(out, f.params)
        ExternDecl(e) ->
            named_reserved(out, e.name, "declaration", s.span)
            params_reserved(out, e.params)
        ExternVarDecl(name, _, _, _) -> named_reserved(out, name, "declaration", s.span)
        ValDecl(name, _, _, _, _, _) -> named_reserved(out, name, "'val'", s.span)
        VarDecl(name, _, _, _, _, _, _) -> named_reserved(out, name, "'var'", s.span)
        ConstDecl(name, _, _, _) -> named_reserved(out, name, "'const'", s.span)
        TypeDecl(t) -> named_reserved(out, t.name, "type", s.span)
        StructDecl(d) ->
            named_reserved(out, d.name, "type", s.span)
            tparams_reserved(out, d.tparams, s.span)

            for item in d.fields
                named_reserved(out, item.name, "field", item.span)

            for member in d.members
                method_reserved(out, member)
        EnumDecl(d) ->
            named_reserved(out, d.name, "type", s.span)
            tparams_reserved(out, d.tparams, s.span)

            for item in d.variants
                named_reserved(out, item.name, "variant", item.span)
                params_reserved(out, item.fields)

            for member in d.members
                method_reserved(out, member)
        TraitDecl(d) ->
            named_reserved(out, d.name, "trait", s.span)
            tparams_reserved(out, d.tparams, s.span)

            for item in d.methods
                method_reserved(out, item)
        ImplDecl(d) ->
            for item in d.methods
                method_reserved(out, item)
        ImportDecl(d) ->
            if !d.wildcard then named_reserved(out, import_bound(d), "import", s.span)

            for item in d.selectors
                named_reserved(out, selector_bound(item), "import",
                               item.span)
        StaticDecl(inner) -> collect_reserved(out, inner)
        _ -> ()

// The moment `__DATE__` and `__TIME__` report, in milliseconds since the epoch: read once, the first
// time either is asked for, so that two uses in one compilation cannot disagree with each other.
private var stamp_ms: long = 0
private var stamp_read: bool = false

build_stamp() -> long
    if !stamp_read
        stamp_ms = now().us / 1000
        stamp_read = true
    end if

    stamp_ms
end build_stamp

// `__DATE__`'s text for a moment, in C's `Mmm dd yyyy`, read as UTC -- the day padded with a space
// rather than a zero, as C's own is.
stamp_date(ms: long) -> string
    val (y, m, d) = civil_of(floor_div(ms, 86400000))
    val months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    val day = if d < 10 then s" $d" else s"$d"

    s"${months[usize(m - 1)]} $day $y"
end stamp_date

// `__TIME__`'s text for a moment, in C's `hh:mm:ss`, read as UTC.
stamp_time(ms: long) -> string
    val secs = floor_div(ms, 1000) - floor_div(ms, 86400000) * 86400

    s"${two(secs / 3600)}:${two(secs / 60 % 60)}:${two(secs % 60)}"
end stamp_time

private two(n: long) -> string = if n < 10 then s"0$n" else s"$n"

private floor_div(a: long, b: long) -> long
    val q = a / b

    if a % b != 0 && (a < 0) != (b < 0) then q - 1 else q
end floor_div

// The proleptic Gregorian year, month and day of a count of days since 1970-01-01.
private civil_of(days: long) -> (long, long, long)
    val z = days + 719468
    val era = floor_div(z, 146097)
    val doe = z - era * 146097
    val yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    val doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    val mp = (5 * doy + 2) / 153
    val d = doy - (153 * mp + 2) / 5 + 1
    val m = if mp < 10 then mp + 3 else mp - 9
    val y = yoe + era * 400 + (if m <= 2 then 1 else 0)

    (y, m, d)
end civil_of

// The name an import binds, which is its alias where it has one and the last of its path otherwise.
import_bound(d: ImportDecl) -> string = d.alias match
    Some(a) -> a
    None -> if d.path.is_empty() then "" else d.path.at(d.path.len() - 1)

// The name a selector binds, which is its alias where it has one.
selector_bound(s: ImportSelector) -> string = s.alias match
    Some(a) -> a
    None -> s.name
