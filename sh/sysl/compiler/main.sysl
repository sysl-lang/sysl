module sh.sysl.compiler

import sh.sysl.parsing.source_of
import sysl.buf.{Buf, buf}
import sysl.fs.read_text
import sysl.prints
import sysl.text.Search

// The driver: what the shell asked for, and what it hears back.
//
// **`main` is a few lines that bind the real arguments and the real terminal to `run_cli`**, which
// is where every decision lives, so that each one is reachable from a test that touches neither.

// What the shell hears. Three outcomes and not two: a program the compiler refused is the program's
// news, and a command line the compiler could not read is the caller's own bug.
val Fine: int = 0
val Failed: int = 1
val Misused: int = 2

// What `sysl --version` answers. Written here as well as in `package.hocon`, because a program is
// handed nothing about its own manifest; the test beside this file keeps the two in step.
const Version: string = "0.0.1"

// The answer to a command line: the lines to say, and the status to exit with.
run_cli(args: []string, say: string -> unit) -> int
    if args.len < 2
        say(usage())
        return Misused

    args[1] match
        "--version" ->
            say(s"sysl ${Version}")
            Fine
        "--help" ->
            say(usage())
            Fine
        "emit-ast" -> emit_ast_command(args, say)
        "emit-typed" -> emit_typed_command(args, say)
        "emit-llvm" -> emit_llvm_command(args, say)
        "build" -> build_command(args, say)
        "run" -> run_command(args, say)
        "test" -> test_command(args, say)
        other ->
            say(s"sysl: `${other}` is not a command this compiler can carry out yet")
            say(usage())
            Misused

// `sysl emit-ast [--no-spans] <file>` -- one file's untyped parse tree, written out as deterministic
// text.
//
// **It exists so that two compilers can be diffed rather than compared by hand.** The reference
// compiler answers the same command line with the same tree in the same notation, so agreement
// between them is one `diff` over whatever corpus is to hand, and a disagreement names the node.
// Nothing is analyzed: this stops where the parser does.
private emit_ast_command(args: []string, say: string -> unit) -> int
    var spans = true
    var file = ""

    for i in 2..<args.len
        if args[i] == "--no-spans"
            spans = false
        else
            file = args[i]

    if file == ""
        say("usage: sysl emit-ast [--no-spans] <file>")
        return Misused

    read_text(file) match
        Err(_) ->
            say(s"sysl: '${file}' cannot be read")
            Failed
        Ok(text) ->
            val parsed = parse(source_of(file, text))

            if !parsed.ok()
                say(s"${file}:${parsed.at()}: ${parsed.first().message}")
                return Failed

            // Every node's line ends in a newline of its own, and `say` ends the line it is given,
            // so the last one is dropped rather than written twice.
            val text = emit_ast(parsed.program, spans)

            say(if text.ends_with("\n") then text[0..<(text.len - 1)] else text)
            Fine
end emit_ast_command

// `sysl emit-typed [--no-spans] [--tables] [--target <name>] <path>` -- one whole program's typed
// tree, or its declaration tables.
//
// **The path is a program and not a file.** A directory is the project root and everything below it
// is compiled; a single file is compiled alone, as the root module. Either way the standard module
// is read from source and analyzed with the program, so a free `print` and an `Option` mean what the
// library says they mean.
private emit_typed_command(args: []string, say: string -> unit) -> int
    var tables = false
    var named: Option[string] = None
    var file = ""
    var i: usize = 2

    while i < args.len
        if args[i] == "--tables"
            tables = true
        else if args[i] == "--no-spans"
            // The typed tree carries no spans yet, so the flag is taken and changes nothing. It is
            // accepted rather than refused because the whole point of this command is that two
            // compilers answer one command line.
            tables = tables
        else if args[i] == "--target"
            if i + 1 >= args.len
                say("usage: sysl emit-typed [--no-spans] [--tables] [--target <name>] <path>")
                return Misused
            end if

            i += 1
            named = Some(args[i])
        else
            file = args[i]

        i += 1

    if file == ""
        say("usage: sysl emit-typed [--no-spans] [--tables] [--target <name>] <path>")
        return Misused
    end if

    emit_typed_text(file, named, tables) match
        Err(refusal) ->
            say(s"error: ${refusal.message}")
            Failed
        Ok(emitted) ->
            // An analysis error is reported exactly as any other compiling command reports one,
            // with nothing on standard output.
            if !emitted.report.is_empty()
                say(analysis_report(emitted.report))
                return Failed
            end if

            say(if emitted.text.ends_with("\n") then emitted.text[0..<(emitted.text.len - 1)]
                else emitted.text)
            Fine
end emit_typed_command

// `sysl emit-llvm [--gaps] [--target <name>] <path>` -- one whole program's LLVM text.
//
// **The reference compiler answers this command line with the text it hands to the back end**, so
// the two are diffed rather than compared by hand. The path is a program on the same terms
// `emit-typed`'s is.
//
// **`--gaps` prints the bodies this lowering left out instead of the text**, one to a line as the
// symbol and the form it reached. A partial lowering owes a census of what it did not say, and the
// difference between the two texts is only readable next to it: a symbol the reference defines and
// this compiler does not is an absence, and this is what names the reason.
private emit_llvm_command(args: []string, say: string -> unit) -> int
    var named: Option[string] = None
    var gaps = false
    var file = ""
    var i: usize = 2

    while i < args.len
        if args[i] == "--target"
            if i + 1 >= args.len
                say(emit_llvm_usage())
                return Misused
            end if

            i += 1
            named = Some(args[i])
        else if args[i] == "--gaps"
            gaps = true
        else
            file = args[i]

        i += 1

    if file == ""
        say(emit_llvm_usage())
        return Misused
    end if

    emit_llvm_text(file, named) match
        Err(refusal) ->
            say(s"error: ${refusal.message}")
            Failed
        Ok(emitted) ->
            if !emitted.report.is_empty()
                say(analysis_report(emitted.report))
                return Failed
            end if

            if gaps
                for i in 0..<emitted.gaps.len()
                    say(s"${emitted.gaps.at(i).0}\t${emitted.gaps.at(i).1}")

                return Fine
            end if

            say(if emitted.text.ends_with("\n") then emitted.text[0..<(emitted.text.len - 1)]
                else emitted.text)
            Fine
end emit_llvm_command

private emit_llvm_usage() -> string = "usage: sysl emit-llvm [--gaps] [--target <name>] <path>"

// `sysl build [--target <name>] [--cc <path>] [-O<level>] [-o <exe>] <path>` -- one program, made
// into something the machine will run.
//
// **The text is exactly what `emit-llvm` prints**, so a build and a diff are the same lowering seen
// twice; what this adds is the toolchain the text is handed to. `--cc` names the clang instead of
// searching for one, and a person who wrote one down is owed an error rather than a different
// compiler.
private build_command(args: []string, say: string -> unit) -> int
    var named: Option[string] = None
    var cc: Option[string] = None
    var out: Option[string] = None
    var level = DefaultOptimization
    var file = ""
    var i: usize = 2

    while i < args.len
        if args[i] == "--target" || args[i] == "--cc" || args[i] == "-o"
            if i + 1 >= args.len
                say(build_usage())
                return Misused
            end if

            val flag = args[i]

            i += 1

            if flag == "--target" then named = Some(args[i])
            else if flag == "--cc" then cc = Some(args[i])
            else out = Some(args[i])
        else if args[i].len > 2 && args[i].starts_with("-O")
            level = args[i][2..<args[i].len]
        else
            file = args[i]

        i += 1

    if file == ""
        say(build_usage())
        return Misused
    end if

    build_native_program(file, named, cc, level, out) match
        Err(refusal) ->
            say(s"error: ${refusal.message}")
            Failed
        Ok(exe) ->
            say(s"wrote $exe")
            Fine
end build_command

private build_usage() -> string =
    "usage: sysl build [--target <name>] [--cc <path>] [-O<level>] [-o <exe>] <path>"

// `sysl run [--target <name>] [--cc <path>] [-O<level>] <path> [-- <args>]` -- one program, built and
// then run, with whatever it exits with passed straight back to the shell.
//
// **Everything after `--` is the program's**, which is what keeps a program free to take an option
// this compiler also takes. The program is handed its own path as its first argument, as a program
// started any other way is.
private run_command(args: []string, say: string -> unit) -> int
    var named: Option[string] = None
    var cc: Option[string] = None
    var level = DefaultOptimization
    var file = ""
    var forwarding = false
    var program_args: Buf[string] = buf()
    var i: usize = 2

    while i < args.len
        if forwarding
            program_args.push(args[i])
        else if args[i] == "--"
            forwarding = true
        else if args[i] == "--target" || args[i] == "--cc"
            if i + 1 >= args.len
                say(run_usage())
                return Misused
            end if

            val flag = args[i]

            i += 1

            if flag == "--target" then named = Some(args[i]) else cc = Some(args[i])
        else if args[i].len > 2 && args[i].starts_with("-O")
            level = args[i][2..<args[i].len]
        else
            file = args[i]

        i += 1

    if file == ""
        say(run_usage())
        return Misused
    end if

    run_native_program(file, named, cc, level, program_args) match
        Err(refusal) ->
            say(s"error: ${refusal.message}")
            Failed
        Ok(code) -> code
end run_command

private run_usage() -> string =
    "usage: sysl run [--target <name>] [--cc <path>] [-O<level>] <path> [-- <args>]"

// `sysl test [--filter <text>] [--fail-fast] [--target <name>] [--cc <path>] [-O<level>] <path>` --
// the `@test` functions of a tree, built into one binary and run one process each.
//
// **The report is written as the run goes rather than at the end**, which is why it does not go
// through `say`: a suite that takes half an hour is watched from a log file while it runs, and a run
// that is killed partway still has a report of everything up to the kill. Every decision the command
// makes is still somewhere a test can reach -- `run_selected` takes the sink it writes through, and
// the four pieces it writes are each a function of their own.
private test_command(args: []string, say: string -> unit) -> int
    var named: Option[string] = None
    var cc: Option[string] = None
    var filter: Option[string] = None
    var fail_fast = false
    var level = DefaultOptimization
    var file = ""
    var i: usize = 2

    while i < args.len
        if args[i] == "--target" || args[i] == "--cc" || args[i] == "--filter"
            if i + 1 >= args.len
                say(test_usage())
                return Misused
            end if

            val flag = args[i]

            i += 1

            if flag == "--target" then named = Some(args[i])
            else if flag == "--cc" then cc = Some(args[i])
            else filter = Some(args[i])
        else if args[i] == "--fail-fast"
            fail_fast = true
        else if args[i].len > 2 && args[i].starts_with("-O")
            level = args[i][2..<args[i].len]
        else
            file = args[i]

        i += 1

    if file == ""
        say(test_usage())
        return Misused
    end if

    val build = test_build_of(file, named) match
        Err(refusal) ->
            say(s"error: ${refusal.message}")
            return Failed
        Ok(made) -> made

    if !build.emitted.report.is_empty()
        say(analysis_report(build.emitted.report))
        return Failed
    end if

    // Nothing to run is not nothing to say. A tree with no tests at all and a filter that matched none
    // of the tests there are lead to the same empty report and are different mistakes, so each is
    // named. Neither is a failure: a program is allowed to have no tests.
    if build.tests.is_empty()
        say(s"no '@test' functions in $file")
        return Fine
    end if

    val chosen = selected_tests(build.tests, filter)

    if chosen.is_empty()
        say(s"no test matches '${filter.unwrap_or("")}' — ${build.tests.len()} to choose from")
        return Fine
    end if

    val exe = build_test_binary(file, build, cc, level) match
        Err(refusal) ->
            say(s"error: ${refusal.message}")
            return Failed
        Ok(built) -> built

    val outcomes = run_selected(exe, chosen, TestOptions(filter, fail_fast),
                                build.tests.len() - chosen.len(), piece -> stream_out(piece))

    discard_test_binary(exe)

    var failed: usize = 0

    for j in 0..<outcomes.len()
        if !outcomes.at(j).passed() then failed += 1

    if failed == 0 then Fine else Failed
end test_command

private test_usage() -> string = "usage: sysl test [--filter <text>] [--fail-fast] " +
    "[--target <name>] [--cc <path>] [-O<level>] <path>"

// One piece of a report, written and **flushed**, so that a run followed through a log file shows each
// verdict as it lands rather than only once the process exits. The pieces carry their own newlines,
// which is what makes the concatenation of them the whole report.
private stream_out(piece: string)
    prints(piece)
    c_flush_all(null)

// Standard output is buffered when it is not a terminal, which is exactly the case a streaming report
// is for. There is no flush in the library's printing surface, so the C one is named here.
private extern "fflush" c_flush_all(stream: *u8) -> int

usage() -> string = "usage: sysl --version | --help | emit-ast [--no-spans] <file> | " +
    "emit-typed [--no-spans] [--tables] [--target <name>] <path> | " +
    "emit-llvm [--target <name>] <path> | " +
    "build [--target <name>] [--cc <path>] [-O<level>] [-o <exe>] <path> | " +
    "run [--target <name>] [--cc <path>] [-O<level>] <path> [-- <args>] | " +
    "test [--filter <text>] [--fail-fast] [--target <name>] [--cc <path>] [-O<level>] <path>"

main(args: []string)
    val code = run_cli(args, line -> print(line))

    if code != Fine then exit(code)
