module sh.sysl.compiler
@tests

// Slices as programs actually behave (`reference/types.md § Slices`). A slice views elements it does
// not own, so most of what is worth checking is that the view and its buffer agree -- and that the
// buffer outlives every view of it.
//
// **Every output quoted here was read out of the reference compiler** (0.0.157, and unchanged in 0.0.158), whose
// `SliceRunTests` these are. The building and running is `tests_enm_enum_run.sysl`'s.

// ---- ranges ----

@test("the whole thing")
srx_the_whole_thing()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        var buf: &[8]u8 = [1, 2, 3, 4, 5, 6, 7, 8]
        var s = buf[..]
        print(s.len, s[0], s[7])
        """), "8 1 8\n")

@test("an exclusive range stops before its high end")
srx_an_exclusive_range_stops_before_its_high_end()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        var buf: &[8]u8 = [1, 2, 3, 4, 5, 6, 7, 8]
        var s = buf[2..<5]
        print(s.len, s[0], s[2])
        """), "3 3 5\n")

@test("an inclusive range takes its high end too")
srx_an_inclusive_range_takes_its_high_end_too()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        var buf: &[8]u8 = [1, 2, 3, 4, 5, 6, 7, 8]
        var s = buf[2..5]
        print(s.len, s[0], s[3])
        """), "4 3 6\n")

@test("an open high end runs to the last element")
srx_an_open_high_end_runs_to_the_last_element()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        var buf: &[8]u8 = [1, 2, 3, 4, 5, 6, 7, 8]
        var s = buf[6..]
        print(s.len, s[0], s[1])
        """), "2 7 8\n")

@test("an open low end starts at the first")
srx_an_open_low_end_starts_at_the_first()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        var buf: &[8]u8 = [1, 2, 3, 4, 5, 6, 7, 8]
        var s = buf[..<3]
        print(s.len, s[0], s[2])
        """), "3 1 3\n")

@test("a slice of a slice is relative to the slice")
srx_a_slice_of_a_slice_is_relative_to_the_slice()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        var buf: &[8]u8 = [1, 2, 3, 4, 5, 6, 7, 8]
        var s = buf[2..<6]
        var t = s[1..<3]
        print(t.len, t[0], t[1])
        """), "2 4 5\n")

@test("an empty slice is legal, at the end and in the middle")
srx_an_empty_slice_is_legal_at_the_end_and_in_the_middle()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        var buf: &[8]u8 = [1, 2, 3, 4, 5, 6, 7, 8]
        print(buf[8..].len, buf[3..<3].len, buf[..<0].len)
        """), "0 0 0\n")

@test("a zero-valued slice owns nothing and names nothing")
srx_a_zero_valued_slice_owns_nothing_and_names_nothing()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        var s: []int
        print(s.len)
        """), "0\n")

// ---- a view and its buffer ----

@test("a view writes through to the buffer")
srx_a_view_writes_through_to_the_buffer()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        var buf: &[8]u8 = [1, 2, 3, 4, 5, 6, 7, 8]
        var s = buf[2..<5]
        s[0] = 99
        print(buf[2], s[0])
        """), "99 99\n")

@test("a function takes a view without caring where the elements live")
srx_a_function_takes_a_view_without_caring_where_the_elements_live()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        var buf: &[8]u8 = [1, 2, 3, 4, 5, 6, 7, 8]
        total(s: []u8) -> int
            var t = 0
            for b in s do t += int(b)
            t
        end total
        print(total(buf[..]), total(buf[2..<5]), total(buf[8..]))
        """), "36 12 0\n")

@test("a callee filling a view is seen by the caller")
srx_a_callee_filling_a_view_is_seen_by_the_caller()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        fill(s: []int, v: int)
            for i in 0..<s.len do s[i] = v
        end fill
        var buf: &[4]int = [0, 0, 0, 0]
        fill(buf[1..<3], 7)
        print(buf[0], buf[1], buf[2], buf[3])
        """), "0 7 7 0\n")

@test("the buffer outlives every view of it, even when the reference is gone")
srx_the_buffer_outlives_every_view_of_it()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        view() -> []int
            var owned: &[3]int = [4, 5, 6]
            owned[..]
        end view
        var s = view()
        print(s.len, s[0], s[2])
        """), "3 4 6\n")

@test("a slice of references reaches the objects, which stay alive")
srx_a_slice_of_references_reaches_the_objects()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        struct Cell
            n: int
        end Cell
        var cells: &[3]&Cell = [Cell(1), Cell(2), Cell(3)]
        var view = cells[1..]
        print(view.len, view[0].n, view[1].n)
        """), "2 2 3\n")

@test("slicing in a loop neither leaks nor frees twice")
srx_slicing_in_a_loop_neither_leaks_nor_frees_twice()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        var total = 0
        for i in 1..20000 do
            var b: &[4]int = [i, i, i, i]
            var s = b[1..<3]
            total += s[0]
        print(total)
        """), "200010000\n")

@test("a view of an array this frame owns reaches the same elements")
srx_a_view_of_an_array_this_frame_owns_reaches_the_same_elements()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        var xs = [1, 2, 3, 4, 5]
        var mid = xs[1..<4]
        mid[0] = 9
        print(mid.len, mid[0], xs[1], xs[0])
        """), "3 9 9 1\n")

@test("a scratch buffer is filled by a callee and read back, with nothing allocated")
srx_a_scratch_buffer_is_filled_by_a_callee_and_read_back()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        fill(s: []u8, v: u8) -> usize
            for i in 0..<s.len do s[i] = v
            s.len
        end fill

        total(s: []u8) -> int
            var t = 0
            for b in s do t += int(b)
            t
        end total

        format(v: u8) -> int
            var buf: [8]u8
            var n = fill(buf[0..<4], v)
            total(buf[0..<n])
        end format
        print(format(3))
        """), "12\n")

// buf[2..<7] = [3,4,5,6,7]; s[1..<4] = [4,5,6]; writing t[1] must reach the one byte four in from the
// original buffer's start, through two layers of view arithmetic.
@test("a write through a slice of a slice reaches the original buffer")
srx_a_write_through_a_slice_of_a_slice_reaches_the_original_buffer()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        var buf: &[8]u8 = [1, 2, 3, 4, 5, 6, 7, 8]
        var s = buf[2..<7]
        var t = s[1..<4]
        t[1] = 99
        print(t[0], t[1], t[2], s[2], buf[4])
        """), "4 99 6 99 99\n")

// A view retains its heap buffer, so reassigning the only named owner does not free what the view
// sees: it keeps reading the OLD values, where a dangling view would read the new buffer or garbage.
@test("a view keeps its heap buffer alive after the owner is reassigned")
srx_a_view_keeps_its_heap_buffer_alive_after_the_owner_is_reassigned()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        var b: &[4]int = [1, 2, 3, 4]
        var s = b[..]
        b = [5, 6, 7, 8]
        print(s[0], s[1], s[2], s[3])
        """), "1 2 3 4\n")

// The re-slice carries the original buffer as its owner, so the returned sub-view outlives both the
// heap array and the intermediate view that made it.
@test("a returned slice of a slice keeps the buffer alive past the frame")
srx_a_returned_slice_of_a_slice_keeps_the_buffer_alive_past_the_frame()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        keep() -> []int
            var b: &[6]int = [10, 20, 30, 40, 50, 60]
            var s = b[1..<5]
            s[1..<3]
        end keep
        var t = keep()
        print(t.len, t[0], t[1])
        """), "2 30 40\n")

// The old Cell is released and the new one takes its place, seen through the view and the array.
@test("storing a reference through a view replaces that element in the buffer")
srx_storing_a_reference_through_a_view_replaces_that_element()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        struct Cell
            n: int
        end Cell
        var cells: &[3]&Cell = [Cell(10), Cell(20), Cell(30)]
        var v = cells[0..<3]
        v[1] = Cell(99)
        print(cells[0].n, cells[1].n, cells[2].n, v[1].n)
        """), "10 99 30 99\n")

// ---- equality: `impl[T: Eq] Eq for []T` and the array block beside it ----

@test("two slices with the same elements are equal")
srx_two_slices_with_the_same_elements_are_equal()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        var buf: &[8]u8 = [1, 2, 3, 4, 5, 6, 7, 8]
        print(buf[0..<3] == buf[0..<3])
        """), "true\n")

@test("a differing element makes them unequal")
srx_a_differing_element_makes_them_unequal()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        var buf: &[8]u8 = [1, 2, 3, 4, 5, 6, 7, 8]
        print(buf[0..<3] == buf[1..<4], buf[0..<3] != buf[1..<4])
        """), "false true\n")

// The length test runs first, so this never reads an element that is only in one of them.
@test("a differing length makes them unequal whatever the shared prefix is")
srx_a_differing_length_makes_them_unequal()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        var buf: &[8]u8 = [1, 2, 3, 4, 5, 6, 7, 8]
        print(buf[0..<3] == buf[0..<4], buf[0..<4] == buf[0..<3])
        """), "false false\n")

@test("two empty slices are equal, and an empty one differs from a non-empty one")
srx_two_empty_slices_are_equal()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        var buf: &[8]u8 = [1, 2, 3, 4, 5, 6, 7, 8]
        print(buf[3..<3] == buf[5..<5], buf[3..<3] == buf[0..<1])
        """), "true false\n")

// A slice of a type of its own compares through that type's own `eq`, which is what the bound asks
// for.
@test("the element's own equality is what decides")
srx_the_elements_own_equality_is_what_decides()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        struct Cell
            n: int

        impl Eq for Cell
            eq(self, rhs: Cell) -> bool = self.n % 10 == rhs.n % 10
        var a: &[2]Cell = [Cell(1), Cell(2)]
        var b: &[2]Cell = [Cell(11), Cell(22)]
        var c: &[2]Cell = [Cell(11), Cell(23)]
        print(a[..] == b[..], a[..] == c[..])
        """), "true false\n")

// The arrays are values rather than references on purpose: a `&[3]int` compares by address
// (`reference/memory.md § &T — counted references`).
@test("an array compares as the elements a slice of it would have walked")
srx_an_array_compares_as_the_elements_a_slice_would_have_walked()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        var a: [3]int = [1, 2, 3]
        var b: [3]int = [1, 2, 3]
        var c: [3]int = [1, 9, 3]
        print(a == b, a == c, a != c)
        """), "true false true\n")

@test("a reference to an array still compares by address, which the deref is the way past")
srx_a_reference_to_an_array_still_compares_by_address()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        var a: &[3]int = [1, 2, 3]
        var b: &[3]int = [1, 2, 3]
        print(a == b, *a == *b)
        """), "false true\n")

// The blanket is an implementation like any other, so a program wanting its own for a narrower slice
// is writing a second one, and pays the same `override` the printable blanket charges.
@test("a program's own Eq for a slice of its type is the ordinary duplicate until it says override")
srx_a_programs_own_eq_for_a_slice_is_the_ordinary_duplicate()
    if !enm_ready() then return

    val said = enm_err(raw"""
        struct N
            v: int
        impl Eq for []N
            eq(self, rhs: Self) -> bool = self.len == rhs.len
        print(1)
        """)

    assert(enm_says(said, "every slice already implements 'sysl.Eq'"), said)
    assert(enm_says(said, "write 'override impl' to say that replacing it for this one type is what was meant"), said)

// ---- ordering: lexicographic, first element first ----

@test("a slice orders on its first differing element")
srx_a_slice_orders_on_its_first_differing_element()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        var buf: &[8]u8 = [1, 2, 3, 4, 5, 6, 7, 8]
        print(buf[0..<3] < buf[1..<4], buf[1..<4] < buf[0..<3])
        """), "true false\n")

// Length decides only once the shared prefix is exhausted -- the opposite order from `Eq`.
@test("a prefix orders before the slice that extends it")
srx_a_prefix_orders_before_the_slice_that_extends_it()
    if !enm_ready() then return

    assert_eq(enm_ran(raw"""
        var buf: &[8]u8 = [1, 2, 3, 4, 5, 6, 7, 8]
        print(buf[0..<3] < buf[0..<4], buf[0..<4] < buf[0..<3])
        """), "true false\n")

// A hash is a promise about a key and a slice is a view whose storage stays writable by its owner, so
// `[N]T` has the block and `[]T` does not.
@test("a slice still has no hash, which is a decision rather than an omission")
srx_a_slice_still_has_no_hash()
    if !enm_ready() then return

    val said = enm_err(raw"""
        var buf: &[8]u8 = [1, 2, 3, 4, 5, 6, 7, 8]
        print(buf[0..<3].hash())
        """)

    assert(enm_says(said, "type '[]byte' has no method 'hash'"), said)

// ---- bounds ----

@test("a bound past the end stops the program")
srx_a_bound_past_the_end_stops_the_program()
    if !enm_ready() then return

    assert_eq(enm_exits(raw"""
        var buf: &[8]u8 = [1, 2, 3, 4, 5, 6, 7, 8]
        var n = 9
        var s = buf[0..<n]
        print(s.len)
        """), "")

@test("an inclusive high end must name an element that exists")
srx_an_inclusive_high_end_must_name_an_element_that_exists()
    if !enm_ready() then return

    assert_eq(enm_exits(raw"""
        var buf: &[8]u8 = [1, 2, 3, 4, 5, 6, 7, 8]
        var n = 8
        var s = buf[0..n]
        print(s.len)
        """), "")

@test("a low end past the high end stops the program")
srx_a_low_end_past_the_high_end_stops_the_program()
    if !enm_ready() then return

    assert_eq(enm_exits(raw"""
        var buf: &[8]u8 = [1, 2, 3, 4, 5, 6, 7, 8]
        var a = 5
        var b = 2
        var s = buf[a..<b]
        print(s.len)
        """), "")

@test("indexing past a view's end stops the program, even though the buffer is longer")
srx_indexing_past_a_views_end_stops_the_program()
    if !enm_ready() then return

    assert_eq(enm_exits(raw"""
        var buf: &[8]u8 = [1, 2, 3, 4, 5, 6, 7, 8]
        var s = buf[0..<2]
        var i = 2
        print(s[i])
        """), "")
