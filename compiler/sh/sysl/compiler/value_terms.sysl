module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.math.bigint.{BigInt, abs as big_abs, cmp as big_cmp, div_rem, from_int, mul as big_mul, negate,
                         to_string}

// What a value parameter IS while its own declaration is read: a symbol, and an argument computed
// over symbols is a polynomial in them (`docs/content/reference/generics.md § What may be written
// with N`, `docs/design/type-level-consts.md § 5.1`).
//
// **The stand-in zero answers numbers and the term answers identity.** A layout, a `sizeof` or a
// loop bound in a generic body still reads `N` as zero, as it always has, and every instantiation
// reads the body again with `N` bound; what the term adds is that `Buf[N]` and `Buf[M]` are two
// types at the definition, and `Buf[N + M]` and `Buf[M + N]` one.
//
// **The form is canonical**: a sum of monomials with non-zero integer coefficients over unbounded ℤ,
// each a sorted product of factors, the monomials sorted by their factors, so two arguments are equal
// exactly when their forms are. A factor is a value parameter, numbered by its place in the
// declaration -- so the form does not depend on how the parameter is spelled -- or an ATOM: an
// operation the ring does not see into, held as its operator and its operands' own forms. `+`, `-`,
// unary `-` and `*` are the ring operations; `/` and `%` by a constant that divides every coefficient
// are exact division (`(2 * N + 4) / 2` is `N + 2`, and its `%` is `0`); a comparison whose two sides
// differ by a constant is that constant's truth (`N + 1 > N` is `true`); `!`, `&&`, `||` and `if`
// fold a constant operand; `min` and `max` sort, flatten and deduplicate their operands; a call to a
// `const` function is an atom keyed by the function, not by how the call spells it. Anything else
// over a parameter (`N / 2`, `N << 1`, `!B`) is an atom compared by its structure. An argument the
// form cannot describe at all (a `match`, a call to what is not a `const` function) carries no term,
// and is compared as before.

// One factor of a monomial: a value parameter (`param` its place in the declaration, `shown` its
// name), or an atom (`param` -1, `op` its operator -- `/`, `<`, `!`, `&&`, `min`, `if`, `call` --
// `key` the function a `call` runs, `shown` how the call names it, `args` its operands' forms).
// What `shown` holds is for a reader only; two factors are one by everything else.
struct Factor
    param: int
    op: string
    key: string
    shown: string
    args: Buf[Buf[Mono]]

// One monomial: a coefficient times a product of factors, sorted; a factor repeated is a power. The
// constant monomial has no factors.
struct Mono
    coeff: BigInt
    factors: Buf[Factor]

// The most monomials, and the highest degree, a form is built to. Past either, the argument is
// refused where it arises (`value_term`).
private const MaxMonos: usize = 64
private const MaxDegree: usize = 8

// -- equality ----------------------------------------------------------------------------------------

// Whether two value arguments are one: by form where both are symbolic, by value where neither is.
//
// **A stand-in with no form agrees by value, as every stand-in did before**: it is an argument the
// form could not describe, or one whose refusal was already told, and calling it unequal would
// refuse what nothing proved wrong. A symbol against an argument an instantiation gave is a
// mismatch: `N` is every value the instantiations choose, not the one written.
value_args_agree(av: BigInt, astood: bool, aterm: Buf[Mono], bv: BigInt, bstood: bool,
                 bterm: Buf[Mono]) -> bool
    if !aterm.is_empty() && !bterm.is_empty() then return terms_eq(aterm, bterm)
    if !aterm.is_empty() then return bstood && av == bv
    if !bterm.is_empty() then return astood && av == bv

    av == bv
end value_args_agree

// Whether two array lengths, or two lane counts, are one -- by VP1's rule, with one difference: a
// length carrying no form that stands at zero agrees with a symbol, as a stand-in does. A length is
// rebuilt in many places (a lane-wise result, a literal read at an expected type), and one rebuilt
// without its form is the zero it stood at, not a zero anybody wrote; calling that unequal would
// refuse what nothing proved wrong, so it is left to the instantiations, as every length was. A
// written `[0]T` against `[N]T` is therefore answered there too.
extents_agree(an: int, aterm: Buf[Mono], bn: int, bterm: Buf[Mono]) -> bool =
    value_args_agree(from_int(long(an)), true, aterm, from_int(long(bn)), true, bterm)

// A length or lane count as a reader writes it: its form where it has one, its number otherwise.
extent_text(n: int, term: Buf[Mono]) -> string = if term.is_empty() then s"$n" else term_text(term)

// A length as the value argument `term_difference` compares, so a length and a value argument are
// told apart in one voice.
private extent_arg(n: int, term: Buf[Mono]) -> Type =
    ConstArg(from_int(long(n)), int_type(), !term.is_empty(), term)

terms_eq(p: Buf[Mono], q: Buf[Mono]) -> bool = term_cmp(p, q) == 0

// -- the order ---------------------------------------------------------------------------------------

// The total order the form is sorted by: parameters by their place, before atoms; atoms by operator,
// then the function a call runs, then their operands. What a factor is shown as takes no part.
factor_cmp(x: Factor, y: Factor) -> int
    if x.param >= 0 || y.param >= 0
        if x.param < 0 then return 1
        if y.param < 0 then return -1

        return int_order(x.param, y.param)
    end if

    if x.op != y.op then return if x.op < y.op then -1 else 1
    if x.key != y.key then return if x.key < y.key then -1 else 1
    if x.args.len() != y.args.len() then return int_order(int(x.args.len()), int(y.args.len()))

    for i in 0..<x.args.len()
        val c = term_cmp(x.args[i], y.args[i])

        if c != 0 then return c

    0
end factor_cmp

// Two sorted products, factor by factor; a product that is the other's beginning comes first.
factors_cmp(xs: Buf[Factor], ys: Buf[Factor]) -> int
    for i in 0..<xs.len()
        if i == ys.len() then return 1

        val c = factor_cmp(xs[i], ys[i])

        if c != 0 then return c

    if xs.len() < ys.len() then -1 else 0
end factors_cmp

// Two forms, monomial by monomial: by factors, then coefficient; a form that is the other's
// beginning comes first. Zero exactly when the two are one.
term_cmp(p: Buf[Mono], q: Buf[Mono]) -> int
    for i in 0..<p.len()
        if i == q.len() then return 1

        val f = factors_cmp(p[i].factors, q[i].factors)

        if f != 0 then return f

        val c = big_cmp(p[i].coeff, q[i].coeff)

        if c != 0 then return c
    end for

    if p.len() < q.len() then -1 else 0
end term_cmp

private int_order(x: int, y: int) -> int = if x < y then -1 else if x > y then 1 else 0

// -- the ring --------------------------------------------------------------------------------------

// A constant as a form: no monomials for zero.
term_const(c: BigInt) -> Buf[Mono]
    var out: Buf[Mono] = buf()

    if !c.is_zero() then out.push(Mono(c, buf()))

    out
end term_const

private one_factor(f: Factor) -> Buf[Mono]
    var fs: Buf[Factor] = buf()

    fs.push(f)

    var out: Buf[Mono] = buf()

    out.push(Mono(from_int(1), fs))
    out
end one_factor

// The declaration's value parameter at `index`, spelled `name`, as a form of its own.
term_param(index: int, name: string) -> Buf[Mono] = one_factor(Factor(index, "", "", name, buf()))

// An atom as a form of its own: `op` over `args`, for a call the function `key`, spelled `shown`.
term_atom(op: string, key: string, shown: string, args: Buf[Buf[Mono]]) -> Buf[Mono] =
    one_factor(Factor(-1, op, key, shown, args))

// `m` added into the sorted `out`, merged with the monomial of the same factors.
private add_mono(out: *Buf[Mono], m: Mono)
    for i in 0..<out.len()
        val c = factors_cmp(m.factors, out[i].factors)

        if c == 0
            val sum = out[i].coeff + m.coeff

            if sum.is_zero()
                out.remove(i)
            else
                out[i] = Mono(sum, out[i].factors)

            return
        end if

        if c < 0
            out.insert(i, m)
            return
        end if
    end for

    out.push(m)
end add_mono

term_add(p: Buf[Mono], q: Buf[Mono]) -> Buf[Mono]
    var out: Buf[Mono] = buf()

    for m in p
        add_mono(&out, m)

    for m in q
        add_mono(&out, m)

    out
end term_add

term_neg(p: Buf[Mono]) -> Buf[Mono]
    var out: Buf[Mono] = buf()

    for m in p
        out.push(Mono(negate(m.coeff), m.factors))

    out
end term_neg

term_mul(p: Buf[Mono], q: Buf[Mono]) -> Buf[Mono]
    var out: Buf[Mono] = buf()

    for x in p
        for y in q
            add_mono(&out, Mono(big_mul(x.coeff, y.coeff), merged_factors(x.factors, y.factors)))

    out
end term_mul

private merged_factors(xs: Buf[Factor], ys: Buf[Factor]) -> Buf[Factor]
    var out: Buf[Factor] = buf()
    var i: usize = 0
    var j: usize = 0

    while i < xs.len() || j < ys.len()
        if j == ys.len() || (i < xs.len() && factor_cmp(xs[i], ys[j]) <= 0)
            out.push(xs[i])
            i += 1
        else
            out.push(ys[j])
            j += 1
        end if
    end while

    out
end merged_factors

// `p / c` where `c` divides every coefficient, the constant one included -- exact, so it agrees with
// the truncating division an instantiation evaluates at every argument -- or nothing.
private term_div_exact(p: Buf[Mono], c: BigInt) -> Option[Buf[Mono]]
    if c.is_zero() then return None

    var out: Buf[Mono] = buf()

    for m in p
        val qr = div_rem(m.coeff, c)

        if !qr.1.is_zero() then return None

        out.push(Mono(qr.0, m.factors))

    Some(out)
end term_div_exact

// `p / q` or `p % q`: two constants divide as an instantiation would, truncating; a constant divisor
// that divides every coefficient divides exactly; anything else is an atom.
term_div(op: string, p: Buf[Mono], q: Buf[Mono]) -> Buf[Mono]
    val divisor = term_constant(q)

    if divisor.is_some() && !divisor.unwrap().is_zero()
        val dividend = term_constant(p)

        if dividend.is_some()
            val qr = div_rem(dividend.unwrap(), divisor.unwrap())

            return term_const(if op == "/" then qr.0 else qr.1)
        end if

        val exact = term_div_exact(p, divisor.unwrap())

        if exact.is_some() then return if op == "/" then exact.unwrap() else term_const(from_int(0))
    end if

    term_atom(op, "", "", pair(p, q))
end term_div

// A comparison of two forms: the truth of their difference where it is a constant -- `N + 1 > N` is
// `true` over ℤ -- and an atom otherwise.
term_compare(op: string, p: Buf[Mono], q: Buf[Mono]) -> Buf[Mono]
    val gap = term_constant(term_add(p, term_neg(q)))

    if gap.is_none() then return term_atom(op, "", "", pair(p, q))

    val s = gap.unwrap().sign()
    val holds = op match
        "<" -> s < 0
        "<=" -> s <= 0
        ">" -> s > 0
        ">=" -> s >= 0
        "==" -> s == 0
        _ -> s != 0

    truth(holds)
end term_compare

// `!p`, `p && q`, `p || q`: a constant operand folds, and anything else is an atom over the operands
// as written.
term_not(p: Buf[Mono]) -> Buf[Mono]
    val c = term_constant(p)

    if c.is_some() then return truth(c.unwrap().is_zero())

    var args: Buf[Buf[Mono]] = buf()

    args.push(p)
    term_atom("!", "", "", args)
end term_not

term_logic(op: string, p: Buf[Mono], q: Buf[Mono]) -> Buf[Mono]
    val l = term_constant(p)
    val r = term_constant(q)
    val both = op == "&&"

    // `false && x` is false and `true && x` is x; `||` the other way about; either side.
    if l.is_some() then return if l.unwrap().is_zero() == both then truth(!both) else q
    if r.is_some() then return if r.unwrap().is_zero() == both then truth(!both) else p

    term_atom(op, "", "", pair(p, q))
end term_logic

// `if c then p else q`: the branch a constant condition chooses, an atom otherwise.
term_if(c: Buf[Mono], p: Buf[Mono], q: Buf[Mono]) -> Buf[Mono]
    val k = term_constant(c)

    if k.is_some() then return if k.unwrap().is_zero() then q else p

    var args: Buf[Buf[Mono]] = buf()

    args.push(c)
    args.push(p)
    args.push(q)
    term_atom("if", "", "", args)
end term_if

// `min(…)` or `max(…)`: commutative and idempotent, so the operands are flattened through a nested
// call of the same operator, sorted and deduplicated, and one operand left is that operand.
term_min_max(op: string, args: Buf[Buf[Mono]]) -> Buf[Mono]
    var flat: Buf[Buf[Mono]] = buf()

    for arg in args
        val inner = lone_atom(arg)

        if inner.is_some() && inner.unwrap().op == op
            for x in inner.unwrap().args
                add_operand(&flat, x)
        else
            add_operand(&flat, arg)
        end if
    end for

    if flat.len() == 1 then return flat[0]

    term_atom(op, "", op, flat)
end term_min_max

// `x` added into the sorted, duplicate-free `out`.
private add_operand(out: *Buf[Buf[Mono]], x: Buf[Mono])
    for i in 0..<out.len()
        val c = term_cmp(x, out[i])

        if c == 0 then return

        if c < 0
            out.insert(i, x)
            return
        end if
    end for

    out.push(x)
end add_operand

// A call to the `const` function `key`, named `shown` where it was written.
term_call(key: string, shown: string, args: Buf[Buf[Mono]]) -> Buf[Mono] =
    term_atom("call", key, shown, args)

private truth(b: bool) -> Buf[Mono] = term_const(from_int(if b then 1 else 0))

private pair(p: Buf[Mono], q: Buf[Mono]) -> Buf[Buf[Mono]]
    var out: Buf[Buf[Mono]] = buf()

    out.push(p)
    out.push(q)
    out
end pair

term_constant(p: Buf[Mono]) -> Option[BigInt]
    if p.is_empty() then return Some(from_int(0))
    if p.len() == 1 && p[0].factors.is_empty() then return Some(p[0].coeff)

    None
end term_constant

// The one atom a form is, with a coefficient of one, where it is that.
private lone_atom(p: Buf[Mono]) -> Option[Factor] =
    if p.len() == 1 && p[0].coeff == from_int(1) && p[0].factors.len() == 1 && p[0].factors[0].param < 0 then
        Some(p[0].factors[0])
    else
        None

// Whether a form is within the cap.
term_fits(p: Buf[Mono]) -> bool
    if p.len() > MaxMonos then return false

    for m in p
        if m.factors.len() > MaxDegree then return false

    true
end term_fits

// What the cap says of a form past it, or nothing within it.
term_cap_text(p: Buf[Mono]) -> Option[string]
    if p.len() > MaxMonos then return Some(s"over $MaxMonos terms")

    for m in p
        if m.factors.len() > MaxDegree then return Some(s"of degree over $MaxDegree")

    None
end term_cap_text

// -- reading one ------------------------------------------------------------------------------------

// The form of a written value argument over the stand-ins `subst` binds, or nothing where it names
// none, comes to a constant, or holds something the form cannot describe.
//
// **A form past the cap is refused here, where it arises**: the argument is too large to compare,
// and leaving it to be compared by value would accept at the declaration what nothing showed equal.
// A form is read only while a declaration is read in its own terms, which no instantiation reads
// again, so the refusal is one the walk at a definition KEEPS (`bound_fault`).
value_term(a: &Analysis, scope: Scope, e: Expr, subst: Buf[Binding]) -> Buf[Mono]
    var over = ""
    val read = term_of(a, scope, e, subst, &over)

    if over != ""
        a.bound_fault(scope, e.span, s"the type argument '${doc_expr_text(e)}' is too large to compare ($over)")
        return buf()
    end if

    if read.is_none() || term_constant(read.unwrap()).is_some() then return buf()

    read.unwrap()
end value_term

// `p` where it is within the cap; nothing, with what the cap says in `over`, where it is not.
private capped(p: Buf[Mono], over: *string) -> Option[Buf[Mono]]
    val said = term_cap_text(p)

    if said.is_none() then return Some(p)
    if *over == "" then *over = said.unwrap()

    None
end capped

private term_of(a: &Analysis, scope: Scope, e: Expr, subst: Buf[Binding], over: *string) -> Option[Buf[Mono]]
    if !names_stand_in(e, subst) then return folded_term(a, scope, e, subst)

    *e.kind match
        Ident(n) -> bound_type(subst, n) match
            Some(ConstArg(_, _, _, term)) -> if term.is_empty() then None else Some(term)
            _ -> None
        Unary(op, x) ->
            val inner = term_of(a, scope, x, subst, over)

            if inner.is_none() then return None
            if op == "-" then return Some(term_neg(inner.unwrap()))
            if op == "!" then return Some(term_not(inner.unwrap()))

            var args: Buf[Buf[Mono]] = buf()

            args.push(inner.unwrap())
            Some(term_atom(op, "", "", args))
        Binary(op, l, r) -> binary_term(a, scope, op, l, r, subst, over)
        Compare(operands, ops) -> compare_term(a, scope, operands, ops, subst, over)
        Call(callee, args) -> call_term(a, scope, e, callee, args, subst, over)
        IfExpr(cond, then_body, else_body, _) ->
            if else_body.is_none() then return None

            val c = term_of(a, scope, cond, subst, over)
            val p = branch_term(a, scope, then_body, subst, over)
            val q = branch_term(a, scope, else_body.unwrap(), subst, over)

            if c.is_none() || p.is_none() || q.is_none() then return None

            Some(term_if(c.unwrap(), p.unwrap(), q.unwrap()))
        _ -> None
end term_of

private binary_term(a: &Analysis, scope: Scope, op: string, l: Expr, r: Expr, subst: Buf[Binding],
                    over: *string) -> Option[Buf[Mono]]
    val lt = term_of(a, scope, l, subst, over)
    val rt = term_of(a, scope, r, subst, over)

    if lt.is_none() || rt.is_none() then return None

    val p = lt.unwrap()
    val q = rt.unwrap()
    val made = op match
        "+" -> term_add(p, q)
        "-" -> term_add(p, term_neg(q))
        "*" -> term_mul(p, q)
        "/" | "%" -> term_div(op, p, q)
        "&&" | "||" -> term_logic(op, p, q)
        _ -> term_atom(op, "", "", pair(p, q))

    capped(made, over)
end binary_term

// A comparison chain, `a < b < c`, is each link's comparison, joined by `&&`.
private compare_term(a: &Analysis, scope: Scope, operands: Buf[Expr], ops: Buf[string], subst: Buf[Binding],
                     over: *string) -> Option[Buf[Mono]]
    var forms: Buf[Buf[Mono]] = buf()

    for x in operands
        val t = term_of(a, scope, x, subst, over)

        if t.is_none() then return None

        forms.push(t.unwrap())
    end for

    if ops.is_empty() || forms.len() != ops.len() + 1 then return None

    var out = term_compare(ops[0], forms[0], forms[1])

    for i in 1..<ops.len()
        out = term_logic("&&", out, term_compare(ops[i], forms[i], forms[i + 1]))

    Some(out)
end compare_term

// A call: an atom keyed by the `const` function it runs, or, where the name is no function, `min`
// and `max` -- their form is ready for the day a type position may call them.
private call_term(a: &Analysis, scope: Scope, e: Expr, callee: Expr, args: Buf[Expr], subst: Buf[Binding],
                  over: *string) -> Option[Buf[Mono]]
    var forms: Buf[Buf[Mono]] = buf()

    for x in args
        *x.kind match
            NamedArg(_, _) -> return None
            _ -> ()

        val t = term_of(a, scope, x, subst, over)

        if t.is_none() then return None

        forms.push(t.unwrap())
    end for

    val inner = analyzer_for(a, scope)

    inner.subst = subst

    val key = const_callee_key(inner, e)

    if key.is_some() then return Some(term_call(key.unwrap(), doc_expr_text(callee), forms))

    *callee.kind match
        Ident(n) -> if (n == "min" || n == "max") && !forms.is_empty() then Some(term_min_max(n, forms)) else None
        _ -> None
end call_term

// The form of a branch that is one expression; nothing for any other.
private branch_term(a: &Analysis, scope: Scope, body: Buf[Stmt], subst: Buf[Binding],
                    over: *string) -> Option[Buf[Mono]]
    if body.len() != 1 then return None

    *body[0].kind match
        ExprStmt(inner) -> term_of(a, scope, inner, subst, over)
        _ -> None
end branch_term

// A part naming no stand-in, folded as the constant it is.
private folded_term(a: &Analysis, scope: Scope, e: Expr, subst: Buf[Binding]) -> Option[Buf[Mono]]
    val inner = analyzer_for(a, scope)

    inner.subst = subst

    val mark = a.complaints()
    val folded = const_fold(inner, e)

    a.restore_complaints(mark)

    folded match
        Some(ConstInt(v)) -> Some(term_const(v))
        Some(ConstBool(b)) -> Some(truth(b))
        _ -> None
end folded_term

// -- showing one ------------------------------------------------------------------------------------

// A form as a reader writes it: the monomials in order, the constant last -- `N + 1`, `N + M`,
// `2 * N - 3`, `2 * (N / 2)`. An infix atom keeps its parentheses wherever it is not the whole form.
term_text(p: Buf[Mono]) -> string
    if p.is_empty() then return "0"

    var out = ""
    var first = true
    val whole = p.len() == 1 && p[0].coeff == from_int(1) && p[0].factors.len() == 1

    for pass in 0..<2
        for m in p
            if (pass == 0) == m.factors.is_empty() then continue

            val negative = m.coeff.sign() < 0
            val size = big_abs(m.coeff)
            val one = size == from_int(1) && !m.factors.is_empty()
            val after = divides_alone(m) && !(first && negative)
            val shown = if m.factors.is_empty() then to_string(size)
                        else if after && one then factor_text(m.factors[0])
                        else if after then s"${factor_text(m.factors[0])} * ${to_string(size)}"
                        else if one then factors_text(m.factors, whole)
                        else s"${to_string(size)} * ${factors_text(m.factors, false)}"

            out = if first then (if negative then s"-$shown" else shown)
                  else s"$out ${if negative then "-" else "+"} $shown"
            first = false
    end for

    out
end term_text

// Whether a monomial is one `/` or `%` times a constant -- shown with the constant after it, `N / 2 *
// 2`, the way a rounding down is written, and bare after a `+` or `-`, `N - N % 3`; the two operators
// bind as `*` does, so no parentheses are needed and none are read in. A leading minus keeps them:
// `-(N / 2)` is not `-N / 2` under truncation.
private divides_alone(m: Mono) -> bool =
    m.factors.len() == 1 && m.factors[0].param < 0 && (m.factors[0].op == "/" || m.factors[0].op == "%") &&
    m.factors[0].args.len() == 2

private factors_text(fs: Buf[Factor], whole: bool) -> string
    var out = ""

    for i in 0..<fs.len()
        val f = fs[i]
        val one = if infix(f) && !whole then s"(${factor_text(f)})" else factor_text(f)

        out = if i == 0 then one else s"$out * $one"

    out
end factors_text

// Whether an atom is written between or before its operands, and so needs parentheses inside a
// product or an operand.
private infix(f: Factor) -> bool = f.param < 0 && f.op != "call" && f.op != "min" && f.op != "max"

private factor_text(f: Factor) -> string
    if f.param >= 0 then return f.shown

    if f.op == "call" || f.op == "min" || f.op == "max"
        var inside = ""

        for i in 0..<f.args.len()
            inside = if i == 0 then term_text(f.args[i]) else s"$inside, ${term_text(f.args[i])}"

        return s"${f.shown}($inside)"
    end if

    if f.args.len() == 1 then return s"${f.op}${operand_text(f.args[0])}"

    if f.op == "if" then
        return s"if ${term_text(f.args[0])} then ${term_text(f.args[1])} else ${term_text(f.args[2])}"

    s"${operand_text(f.args[0])} ${f.op} ${operand_text(f.args[1])}"
end factor_text

// An atom's operand: bare where it is a constant, a parameter or a call, parenthesized otherwise.
private operand_text(p: Buf[Mono]) -> string
    if term_constant(p).is_some() || bare_symbol(p) then return term_text(p)

    val inner = lone_atom(p)

    if inner.is_some() && !infix(inner.unwrap()) then return term_text(p)

    s"(${term_text(p)})"
end operand_text

// A form as the identity a stand-in's tag carries: parameters by their place, so two forms have one
// key exactly when they are one.
term_key(p: Buf[Mono]) -> string
    var out = ""

    for m in p
        out = s"$out+${to_string(m.coeff)}"

        for f in m.factors
            out = s"$out*${factor_key(f)}"
    end for

    if out == "" then "0" else out
end term_key

private factor_key(f: Factor) -> string
    if f.param >= 0 then return s"#${f.param}"

    var out = s"(${f.op}${f.key}"

    for x in f.args
        out = s"$out;${term_key(x)}"

    s"$out)"
end factor_key

// The value parameters a form names, inside its atoms too, each once, in their declaration's order.
private term_params(p: Buf[Mono], out: *Buf[Factor])
    for m in p
        for f in m.factors
            if f.param < 0
                for x in f.args
                    term_params(x, out)

                continue
            end if

            var at = out.len()
            var seen = false

            for i in 0..<out.len()
                if out[i].param == f.param then seen = true
                if out[i].param > f.param && at == out.len() then at = i

            if !seen then out.insert(at, f)
        end for
    end for
end term_params

// What tells two value arguments apart, said after a refusal that quotes both: they differ by a
// constant, they are two parameters, a parameter is not the constant written, or the two forms
// are simply not one. `want` and `got` are the two `ConstArg`s.
term_difference(want: Type, got: Type) -> string
    val w = term_of_arg(want)
    val g = term_of_arg(got)
    var params: Buf[Factor] = buf()

    term_params(w, &params)
    term_params(g, &params)

    var names: Buf[string] = buf()

    for f in params
        names.push(f.shown)

    val every = if names.is_empty() then "at every instantiation" else s"for every ${spoken_list(names)}"

    if w.is_empty() || g.is_empty()
        val symbolic = if w.is_empty() then got else want
        val fixed = if w.is_empty() then want else got

        return s"'${type_show(symbolic)}' stands for every value an instantiation chooses, not " +
               s"only ${type_show(fixed)}"
    end if

    if bare_symbol(w) && bare_symbol(g) then
        return s"'${term_text(g)}' and '${term_text(w)}' are different value parameters"

    val gap = term_constant(term_add(g, term_neg(w)))

    if gap.is_some() then return s"the two differ by ${to_string(big_abs(gap.unwrap()))} $every"

    // An atom in the difference is what the form does not see into, so it is named: the two may be
    // one at every instantiation (`N / 2 * 2` and `N - N % 2`), and the form cannot show it.
    val atom = first_atom(term_add(g, term_neg(w)))

    if atom.is_some() then
        return s"${atom_said(atom.unwrap())} is compared as written, and '${term_text(g)}' is not " +
               s"'${term_text(w)}' $every"

    s"'${term_text(g)}' and '${term_text(w)}' are not the same value $every"
end term_difference

// The atom a difference turns on: the first of the side that was given (a monomial added), else the
// first of the side asked for, where it holds one at its top.
private first_atom(p: Buf[Mono]) -> Option[Factor]
    for pass in 0..<2
        for m in p
            if (m.coeff.sign() > 0) != (pass == 0) then continue

            for f in m.factors
                if f.param < 0 then return Some(f)
        end for
    end for

    None
end first_atom

// An atom as the reason a comparison stops at it: `'/' by 2`, `'%' by 'M'`, `'double'`, `'min'`.
private atom_said(f: Factor) -> string
    if (f.op == "/" || f.op == "%") && f.args.len() == 2
        val k = term_constant(f.args[1])

        return if k.is_some() then s"'${f.op}' by ${to_string(k.unwrap())}" else s"'${f.op}' by '${term_text(f.args[1])}'"
    end if

    if f.op == "call" then s"'${f.shown}'" else s"'${f.op}'"
end atom_said

private term_of_arg(t: Type) -> Buf[Mono] = t match
    ConstArg(_, _, _, term) -> term
    _ -> buf()

private bare_symbol(p: Buf[Mono]) -> bool =
    p.len() == 1 && p[0].factors.len() == 1 && p[0].coeff == from_int(1) && p[0].factors[0].param >= 0

private spoken_list(xs: Buf[string]) -> string
    var out = ""

    for i in 0..<xs.len()
        out = if i == 0 then xs[i] else if i + 1 == xs.len() then s"$out and ${xs[i]}" else s"$out, ${xs[i]}"

    out
end spoken_list

// -- where two types differ only at a parameter --------------------------------------------------------

// The first pair at which two types part while agreeing everywhere else, where that pair is two
// value arguments, one of them symbolic -- `Buf[N]` and `Buf[N + 1]`, `Pair[Arr[N], M]` and
// `Pair[Arr[M], M]` -- or two of the declaration's own type parameters, `Box[T]` and `Box[U]`.
// `own` names those type parameters. Nothing where the types are one, or part anywhere else: that
// mismatch is not this rule's to tell.
//
// **Two type parameters are a clash only under a type that holds them.** Bare, `T` where `U` was
// asked for is not wrong as written: an instantiation at `[u8, int]` widens the one into the other.
// Nothing converts a `Box[u8]` (or an `Option`, a `[2]`, a `&`) into its `int` twin, so there the two
// parameters must be one.
value_clash(want: Type, got: Type, own: Buf[string]) -> Option[(Type, Type)]
    (want, got) match
        (Abstract(_, _), Abstract(_, _)) -> return None
        _ -> ()

    val found = clash_in(want, got, own)

    found.1 match
        Some(pair) -> if found.0 then Some(pair) else None
        None -> None
end value_clash

// A refusal of `got` where `want` was asked for, KEPT where the walk is a generic's own definition and
// the two part only at a parameter: inside its declaration a parameter is a symbol, so that is wrong
// as written, and an instantiation may never be made. Any other mismatch there is left for the
// instantiations.
//
// **Inside an arm an `if const N == c` guards, `N` is `c`** (`refined_arm`), so the two are compared
// with every refinement in force applied to both: `[0]int` where `[N]int` was asked for agrees there,
// and what still differs is told with the arm's condition.
keep_value_clash(cx: &Analyzer, at: Span, refusal: string, want: Type, got: Type)
    if !cx.at_definition then return

    val own = own_type_params(cx.subst)

    if cx.refined.is_empty()
        val told = value_clash_told(refusal, want, got, own)

        if told.is_some() then cx.an.bound_fault(cx.scope, at, told.unwrap())
        return
    end if

    val w = refine_type(cx.an, want, cx.refined)
    val g = refine_type(cx.an, got, cx.refined)

    if type_eq(w, g) then return

    val arm = s"the arm is taken only where ${refined_text(cx.refined)}, and there"
    val still = value_clash(w, g, own)

    if still.is_some()
        cx.an.bound_fault(cx.scope, at, s"$refusal — $arm ${clash_difference(still.unwrap().0, still.unwrap().1)}")
        return
    end if

    // The two parted at a parameter, and the refinement made both sides constants that still differ:
    // wrong at the one instantiation that takes the arm.
    if value_clash_told(refusal, want, got, own).is_none() then return

    cx.an.bound_fault(cx.scope, at, s"$refusal — $arm they are ${type_show(w)} and ${type_show(g)}")
end keep_value_clash

// -- `if const N == c` --------------------------------------------------------------------------------

// What an arm guarded by `if const N == c` knows: the value parameter at `index` (spelled `name`) is
// `value` there. Decision 10 of `docs/design/type-level-consts.md`: the one refinement that is a
// substitution.
struct Refinement
    index: int
    name: string
    value: BigInt
    said: string

// The refinements, as a reader says them: `N is 0`, `N is 0 and M is 2`.
private refined_text(rs: Buf[Refinement]) -> string
    var parts: Buf[string] = buf()

    for r in rs
        parts.push(s"${r.name} is ${r.said}")

    spoken_list(parts)
end refined_text

// `p` with the parameter at `index` replaced by `c`, normalised again -- so an atom whose operands
// all become constants folds where its operator is one the form folds (`/`, `%`, a comparison, `!`,
// `&&`, `||`, `if`, `min`, `max`), and a call stays the call over its new operands.
term_refine(p: Buf[Mono], index: int, c: BigInt) -> Buf[Mono]
    var out: Buf[Mono] = buf()

    for m in p
        var acc = term_const(m.coeff)

        for f in m.factors
            val one = if f.param == index then term_const(c)
                      else if f.param >= 0 then one_factor(f)
                      else refined_atom(f, index, c)

            acc = term_mul(acc, one)
        end for

        out = term_add(out, acc)
    end for

    out
end term_refine

private refined_atom(f: Factor, index: int, c: BigInt) -> Buf[Mono]
    var args: Buf[Buf[Mono]] = buf()

    for x in f.args
        args.push(term_refine(x, index, c))

    if f.op == "/" || f.op == "%" then return term_div(f.op, args[0], args[1])
    if f.op == "<" || f.op == "<=" || f.op == ">" || f.op == ">=" || f.op == "==" || f.op == "!=" then
        return term_compare(f.op, args[0], args[1])
    if f.op == "!" && args.len() == 1 then return term_not(args[0])
    if f.op == "&&" || f.op == "||" then return term_logic(f.op, args[0], args[1])
    if f.op == "if" then return term_if(args[0], args[1], args[2])
    if f.op == "min" || f.op == "max" then return term_min_max(f.op, args)

    term_atom(f.op, f.key, f.shown, args)
end refined_atom

// `t` with every refinement applied to each value argument, length and lane count it holds. One that
// comes to a constant becomes that constant, as an instantiation would have written it.
refine_type(a: &Analysis, t: Type, rs: Buf[Refinement]) -> Type = t match
    ConstArg(v, ty, stood, term) -> if term.is_empty() then t else refined_arg(v, *ty, stood, refined_term(term, rs))
    Array(n, elem, term) ->
        val r = refined_term(term, rs)
        val k = if term.is_empty() then None else term_constant(r)

        if k.is_some() then Array(int(k.unwrap().to_long().unwrap_or(0)), refine_type(a, *elem, rs), buf())
        else Array(n, refine_type(a, *elem, rs), r)
    Vector(n, elem, term) ->
        val r = refined_term(term, rs)
        val k = if term.is_empty() then None else term_constant(r)

        if k.is_some() then Vector(int(k.unwrap().to_long().unwrap_or(0)), refine_type(a, *elem, rs), buf())
        else Vector(n, refine_type(a, *elem, rs), r)
    Struct(d) ->
        if d.targs.is_empty() then t
        else if is_tuple(d) then Struct(registered_tuple(a, refine_list(a, d.targs, rs)))
        else reinstantiate(a, d.base, refine_list(a, d.targs, rs))
    Enum(d) -> if d.targs.is_empty() then t else reinstantiate(a, d.base, refine_list(a, d.targs, rs))
    Ptr(inner, ro, nn) -> Ptr(refine_type(a, *inner, rs), ro, nn)
    Ref(inner, sync, kind) -> Ref(refine_type(a, *inner, rs), sync, kind)
    Weak(inner) -> Weak(refine_type(a, *inner, rs))
    Slice(elem, ro) -> Slice(refine_type(a, *elem, rs), ro)
    Volatile(inner) -> Volatile(refine_type(a, *inner, rs))
    Trait(n, args, assocs) -> Trait(n, refine_list(a, args, rs), assocs)
    _ -> t

private refined_arg(v: BigInt, ty: Type, stood: bool, r: Buf[Mono]) -> Type
    val k = term_constant(r)

    if k.is_some() then ConstArg(k.unwrap(), ty, false, buf()) else ConstArg(v, ty, stood, r)
end refined_arg

private refined_term(p: Buf[Mono], rs: Buf[Refinement]) -> Buf[Mono]
    var out = p

    for r in rs
        out = term_refine(out, r.index, r.value)

    out
end refined_term

private refine_list(a: &Analysis, ts: Buf[Type], rs: Buf[Refinement]) -> Buf[Type]
    var out: Buf[Type] = buf()

    for t in ts
        out.push(refine_type(a, t, rs))

    out
end refine_list

// The refinement `if const cond` gives its first arm, where `cond` is one of the declaration's own
// value parameters, bare, against a constant (`N == 0`, `0 == N`); nothing for any other condition.
// The parameter is one whose stand-in is a bare symbol -- an integer, a `bool` or a `char` -- and the
// constant one it can hold: an arm guarded by a value the parameter's type never takes is never
// taken, and reading it as if it were would refuse what no instantiation reads.
refinement_of(cx: &Analyzer, cond: Expr) -> Option[Refinement]
    val sides = *cond.kind match
        Compare(operands, ops) -> if ops.len() == 1 && ops[0] == "==" then Some((operands[0], operands[1])) else None
        Binary(op, l, r) -> if op == "==" then Some((l, r)) else None
        _ -> None

    if sides.is_none() then return None

    val l = sides.unwrap().0
    val r = sides.unwrap().1
    val left = refined_side(cx, l, r)

    if left.is_some() then left else refined_side(cx, r, l)
end refinement_of

private refined_side(cx: &Analyzer, param: Expr, other: Expr) -> Option[Refinement]
    val name = *param.kind match
        Ident(n) -> n
        _ -> return None

    val bound = bound_type(cx.subst, name)

    if bound.is_none() then return None

    val found = bound.unwrap() match
        ConstArg(_, ty, true, term) -> if bare_symbol(term) then Some((*ty, term[0].factors[0].param)) else None
        _ -> None

    if found.is_none() || names_stand_in(other, cx.subst) then return None

    val mark = cx.an.complaints()
    val folded = const_fold(cx, other)

    cx.an.restore_complaints(mark)

    val ty = found.unwrap().0
    val value = folded match
        Some(ConstInt(v)) -> v
        Some(ConstBool(b)) -> from_int(if b then 1 else 0)
        Some(ConstChar(c)) -> from_int(long(int(u32(c))))
        _ -> return None

    val fits = underlying(ty) match
        Integer(bits, signed, _, _) -> fits(value, bits, signed)
        Bool -> value == from_int(0) || value == from_int(1)
        Char -> value.sign() >= 0
        _ -> false

    if !fits then return None

    Some(Refinement(found.unwrap().1, name, value, doc_expr_text(other)))
end refined_side

// The type parameters a definition's walk stands in for themselves: each binding of a name to the
// stand-in of that same name. A pack's two stand-ins, an associated type's projection and a `some`
// result's stand-in are not among them -- what those are is settled by an instantiation, so two of
// them, or one of them and a parameter, may turn out to be one type.
own_type_params(subst: Buf[Binding]) -> Buf[string]
    var out: Buf[string] = buf()

    for b in subst
        b.ty match
            Abstract(n, _) -> if n == b.name then out.push(n)
            _ -> ()

    out
end own_type_params

// `refusal` with what tells the two apart after it, where `got` stands where `want` was asked for and
// the two part only at a parameter; nothing otherwise. A value standing where a reference to it was
// asked for is compared with what the reference holds, as boxing would.
value_clash_told(refusal: string, want: Type, got: Type, own: Buf[string]) -> Option[string]
    var found = value_clash(want, got, own)

    if found.is_none()
        want match
            Ref(inner, _, _) -> found = value_clash(*inner, got, own)
            _ -> ()
    end if

    found.map(pair -> s"$refusal — ${clash_difference(pair.0, pair.1)}")
end value_clash_told

private clash_difference(want: Type, got: Type) -> string = (want, got) match
    (Abstract(wn, _), Abstract(gn, _)) -> s"'$gn' and '$wn' are different type parameters"
    (Ref(_, _, wk), Ref(inner, _, gk)) -> kind_difference(wk, gk, *inner)
    _ -> term_difference(want, got)

// What tells two references apart that differ only in kind, one of them a count parameter's.
private kind_difference(want: Buf[Mono], got: Buf[Mono], inner: Type) -> string
    if !want.is_empty() && !got.is_empty() then
        return s"'${term_text(got)}' and '${term_text(want)}' are different count parameters"

    val k = term_text(if want.is_empty() then got else want)
    val t = type_show(inner)

    s"'$k' is a count parameter, ordinary in one instance and atomic in another, so '&$k $t' is " +
        s"neither '&$t' nor '&sync $t'. Write '&$k $t' on both sides, or name one kind on both"
end kind_difference

// (whether the two agree outside the parameters, the first pair of parameters that differs).
private clash_in(want: Type, got: Type, own: Buf[string]) -> (bool, Option[(Type, Type)])
    if type_eq(want, got) then return (true, None)

    (want, got) match
        (ConstArg(_, wt, _, wterm), ConstArg(_, gt, _, gterm)) ->
            if !type_eq(*wt, *gt) then return (false, None)
            if wterm.is_empty() && gterm.is_empty() then return (false, None)

            (true, Some((want, got)))
        (Abstract(wn, _), Abstract(gn, _)) ->
            if holds_string(own, wn) && holds_string(own, gn) then (true, Some((want, got))) else (false, None)
        (Struct(w), Struct(g)) -> if w.base == g.base then clash_list(w.targs, g.targs, own) else (false, None)
        (Enum(w), Enum(g)) -> if w.base == g.base then clash_list(w.targs, g.targs, own) else (false, None)
        (Trait(wn, wa, _), Trait(gn, ga, _)) -> if wn == gn then clash_list(wa, ga, own) else (false, None)
        (Ptr(w, wro, wnn), Ptr(g, gro, gnn)) -> if wro == gro && wnn == gnn then clash_in(*w, *g, own) else (false, None)
        // Two references that part at their KIND, one of them a count parameter's: inside the
        // declaration `&K T` is neither `&T` nor `&sync T` nor another parameter's `&J T`.
        (Ref(w, ws, wk), Ref(g, gs, gk)) ->
            if term_cmp(wk, gk) != 0 then (if type_eq(*w, *g) then (true, Some((want, got))) else (false, None))
            else if ws == gs then clash_in(*w, *g, own)
            else (false, None)
        (Weak(w), Weak(g)) -> clash_in(*w, *g, own)
        (Volatile(w), Volatile(g)) -> clash_in(*w, *g, own)
        (Slice(w, wro), Slice(g, gro)) -> if wro == gro then clash_in(*w, *g, own) else (false, None)
        (Array(wn, w, wterm), Array(gn, g, gterm)) -> extent_clash(wn, wterm, gn, gterm, *w, *g, own)
        (Vector(wn, w, wterm), Vector(gn, g, gterm)) -> extent_clash(wn, wterm, gn, gterm, *w, *g, own)
        _ -> (false, None)
end clash_in

// Two arrays, or two vectors, at their lengths and then their elements: a length that disagrees by
// form is the clash where the elements agree, as a value argument's is.
private extent_clash(wn: int, wterm: Buf[Mono], gn: int, gterm: Buf[Mono], w: Type, g: Type,
                     own: Buf[string]) -> (bool, Option[(Type, Type)])
    if extents_agree(wn, wterm, gn, gterm) then return clash_in(w, g, own)
    if wterm.is_empty() && gterm.is_empty() then return (false, None)

    val inner = clash_in(w, g, own)

    if !inner.0 then return (false, None)

    (true, Some((extent_arg(wn, wterm), extent_arg(gn, gterm))))
end extent_clash

private clash_list(ws: Buf[Type], gs: Buf[Type], own: Buf[string]) -> (bool, Option[(Type, Type)])
    if ws.len() != gs.len() then return (false, None)

    var first: Option[(Type, Type)] = None

    for i in 0..<ws.len()
        val one = clash_in(ws[i], gs[i], own)

        if !one.0 then return (false, None)
        if first.is_none() then first = one.1

    (true, first)
end clash_list
