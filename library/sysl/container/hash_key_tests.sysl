module sysl.container
@tests

import sysl.buf.{Buf, buf}

// Buffers, options and derived structs over them as Map keys and Set members.

key_of(xs: []const int) -> Buf[int]
    var b: Buf[int] = buf()

    for x in xs
        b.push(x)

    b

struct Holder derives Eq, Hash
    items: Buf[int]
    tag: Option[int]

@test("a Buf is a Map key")
buf_map_key()
    var m: Map[Buf[int], string] = map()
    m.put(key_of([1, 2]), "a")
    m.put(key_of([2, 1]), "b")
    m.put(key_of([1, 2]), "c")

    assert_eq(m.len(), 2)
    assert_eq(m.get(key_of([1, 2])).unwrap(), "c")
    assert_eq(m.get(key_of([2, 1])).unwrap(), "b")
    assert(m.get(key_of([1])).is_none())

@test("an Option is a Map key")
option_map_key()
    var m: Map[Option[int], int] = map()
    m.put(None, 1)
    m.put(Some(0), 2)
    m.put(Some(0), 3)

    assert_eq(m.len(), 2)
    assert_eq(m.get(None).unwrap(), 1)
    assert_eq(m.get(Some(0)).unwrap(), 3)

@test("a derived struct over a Buf and an Option is a Set member")
derived_set_members()
    var s: Set[Holder] = set()
    s.add(Holder(key_of([1]), None))
    s.add(Holder(key_of([1]), None))
    s.add(Holder(key_of([1]), Some(1)))

    assert_eq(s.len(), 2)
