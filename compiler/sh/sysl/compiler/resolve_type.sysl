module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.math.bigint.{BigInt, from_int, to_string, mul as big_mul, pow as big_pow,
                         negate as big_negate}
import sysl.math.decimal.{Decimal, of as decimal_of, parse as decimal_parse}
import sysl.text.parse_real
import sysl.text.{join, Search}

// A written type, resolved to the type it means.
//
// **This is where a name stops being a name.** `TypeRef` is what the source wrote and `Type` is what
// it means, and everything between the two is here: which declaration a name reaches, whether the
// reader is allowed to reach it, how many arguments it takes, and what its fields turn out to be
// once those arguments are filled in.
//
// **A named type is registered before its fields are resolved**, which is the whole of how a
// declaration that mentions itself terminates: `struct Node { next: *Node }` asks for `Node` while
// `Node` is still being built, and finds the record that is already there.

// What a type parameter stands for while a declaration is being resolved.
struct Binding
    name: string
    ty: Type
end Binding

// The bindings of no parameters at all.
no_bindings() -> Buf[Binding] = buf()

// What a name stands for in a set of bindings.
bound_type(subst: Buf[Binding], name: string) -> Option[Type]
    for item in subst
        if item.name == name then return Some(item.ty)

    None
end bound_type

// One name in a substitution given a different type, since a substitution answers with the first
// binding of a name and a second appended after it would never be read.
rebind(subst: *Buf[Binding], name: string, ty: Type)
    for i in 0..<subst.len()
        if subst.at(i).name == name
            subst.set(i, Binding(name, ty))
            return

    subst.push(Binding(name, ty))

// The type a written RESULT means -- a function's, a member's, an `extern`'s or a `*extern`'s. It
// is the one position `never` may stand in, saying the call does not come back; everywhere else
// `resolve_type` refuses it, there being no value of it to hold, pass or point at.
resolve_result(a: &Analysis, scope: Scope, t: TypeRef, subst: Buf[Binding]) -> Type = *t.kind match
    NamedType(name, args) ->
        if name == "never" && args.is_empty() && bound_type(subst, name).is_none() then Never
        else resolve_type(a, scope, t, subst)
    _ -> resolve_type(a, scope, t, subst)

// The type a written one means.
resolve_type(a: &Analysis, scope: Scope, t: TypeRef, subst: Buf[Binding]) -> Type = *t.kind match
    NamedType(name, args) -> resolve_named(a, scope, t.span, name, args, subst, "")
    // **A hop is what makes a cycle finite**, so the four forms that point rather than hold are
    // counted -- and the count is what a type reached again is judged against.
    PtrType(inner) -> resolve_ptr(a, scope, t.span, inner, subst)
    RefType(inner, sync) -> resolve_ref(a, scope, t.span, inner, sync, subst)
    WeakType(inner) ->
        Weak(addressable(a, scope, t.span,
                         under_indirection(a, () -> resolve_pointee(a, scope, inner, subst, "weak")), "'weak'"))
    // Everywhere but a field, an element and a pointee, what is being named is a **value** -- what a
    // binding holds, what a parameter receives, what a call hands back -- and a value read out of a
    // volatile place is an ordinary value, so there is nothing left for the qualifier to say.
    VolatileType(inner) ->
        val written = type_text(inner)

        a.fault(scope, t.span, s"'volatile $written' is the type of *storage*, and this is a value — " +
                s"what a read of a volatile place hands back is an ordinary '$written'. The qualifier " +
                "goes where the storage is named: a struct field, an element, or the pointee of a " +
                s"'*T', as '*volatile $written'")
        Unknown
    ArrayType(length, elem, read_only) ->
        resolve_array(a, scope, t.span, length, elem, read_only, subst)
    VectorType(lanes, elem) -> resolve_vector(a, scope, t.span, lanes, elem, subst)
    TupleType(parts, results) -> resolve_tuple(a, scope, parts, results, subst)
    PackType(name) -> bound_type(subst, name).unwrap_or(Pack(buf()))
    CFnType(params, ret) ->
        CFn(resolve_list(a, scope, params, subst), resolve_result(a, scope, ret, subst))
    FnType(params, ret, bare) -> resolve_unboxed_callable(a, scope, t, params, ret, bare, subst)
    // A `some` result that reached resolution is one written where the inference behind it has
    // nothing to read: a type position already refused it at the parse, so what arrives here is a
    // **result** in the two places a result is not an `impl` block's member -- a free function and
    // the trait's own declaration. An `impl` member's has been rewritten to its projection by now.
    SomeType(bounds) ->
        if !bounds.is_empty()
            var shown = ""

            for i in 0..<bounds.len()
                if i > 0 then shown = shown + " + "

                shown = shown + bound_text(bounds.at(i))

            a.fault(scope, t.span, s"'some $shown' says the type is read off the body of a " +
                    "member that supplies a trait's associated type, so it stands only in an 'impl' " +
                    s"block — a trait writes 'type Name: ${bound_text(bounds.at(0))}' among its members " +
                    "and gives the member the result 'Self::Name'")
        end if

        Unknown
    // `T::Item` -- the associated type, which the member tables are what answer. It resolves like
    // anything else the moment the subject is known: the subject is resolved first, and a parameter
    // standing in for itself answers off the bounds it carries.
    AssocType(base, member) ->
        assoc_type(a, scope, t.span, resolve_type(a, scope, base, subst), member)
    AssocArgType(_, inner) -> resolve_type(a, scope, inner, subst)
    ValueArgType(e) -> const_argument(a, scope, t.span, e, subst)

// A type in one of the three positions a `volatile` may stand -- the pointee of a `*T`, an element,
// a struct field. What they share is that the storage named is **somebody else's**: a device's
// registers, reached through an address the program was handed.
resolve_qualified(a: &Analysis, scope: Scope, t: TypeRef, subst: Buf[Binding]) -> Type = *t.kind match
    VolatileType(inner) ->
        val ty = resolve_type(a, scope, inner, subst)

        if volatile_admits(a, scope, t.span, ty) then Volatile(ty) else Unknown
    _ -> resolve_type(a, scope, t, subst)

// The type a module's own storage is declared at -- a module `var`, a `static var` or `val`.
//
// **A module `var` is storage named where it is declared**, so it is the fourth position a
// `volatile` may stand: `var tick: volatile u64` is a word an interrupt handler writes and the
// program polls, and every read of it is one volatile load and every write one volatile store. It
// is held to the scalars a field is, since the promise is one access of the whole width. A `val` is
// a constant -- nothing writes it once it starts -- so there is nothing for the qualifier to say.
resolve_storage(a: &Analysis, scope: Scope, t: TypeRef, name: string, writable: bool) -> Type = *t.kind match
    VolatileType(inner) ->
        val ty = resolve_type(a, scope, inner, no_bindings())

        if !writable
            a.fault(scope, t.span, s"'$name' is a 'val', and a 'val' is a constant: nothing writes it once " +
                    "it starts, so no access to it can be one the program did not make, and 'volatile' " +
                    "has nothing to say. Storage an interrupt handler or a device writes is a 'var'")
            return Unknown
        end if

        val written = type_text(inner)
        val refused = storage_aggregate(ty, inner, written)

        if !refused.is_empty()
            a.fault(scope, t.span, s"'volatile $written' cannot be the type of '$name': a volatile " +
                    "access is one load or one store of the whole width, and " + refused)
            return Unknown
        end if

        if volatile_admits(a, scope, t.span, ty) then Volatile(ty) else Unknown
    _ -> resolve_type(a, scope, t, no_bindings())

// Why module storage of this type may not be volatile as a whole, where it is an aggregate; empty
// where it is not. The way to write it is the register block's: a struct whose fields are qualified.
private storage_aggregate(t: Type, inner: TypeRef, written: string) -> string = underlying(t) match
    Struct(_) ->
        s"'$written' is a struct. Write 'volatile' on its fields instead, as 'n: volatile u64', and " +
        s"declare the storage as a plain '$written'"
    Results(_) -> "a tuple is several. Declare a struct whose fields are volatile, as 'n: volatile u64'"
    Array(n, _) ->
        val elem = *inner.kind match
            ArrayType(_, e, _) -> type_text(e)
            _ -> "T"

        s"an array is several. Qualify the element instead, as '[$n]volatile $elem', or declare a " +
        "struct whose fields are volatile"
    Vector(_, _) -> "a vector is several lanes. Declare a struct whose fields are volatile, as 'n: volatile u64'"
    _ -> ""

// **`unit` is zero-sized and still has no address**: a field, a parameter or a binding of it needs
// none, but a `&T`, a `*T`, a slice and an array all reach what they hold through one, and there is
// nothing there to reach. `what` names the form, quoted as the refusal quotes it.
private addressable(a: &Analysis, scope: Scope, span: Span, t: Type, what: string) -> Type = t match
    Unit ->
        a.fault(scope, span, s"unit occupies no storage, so there is nothing for $what to point at")
        Unknown
    _ -> t

// Whether a `volatile` may qualify this type. The qualifier promises exactly the one load or the one
// store the source wrote, so it means something only where an access is one instruction; a register
// block is qualified one field at a time, and anything counted is refused outright.
private volatile_admits(a: &Analysis, scope: Scope, span: Span, t: Type) -> bool
    val shown = type_show(t)
    val head = s"'volatile $shown' is not a type: "

    // A constrained subtype is the claim that a value has been checked, and a register holds
    // whatever the device put there.
    if volatile_constrains(t)
        a.fault(scope, span, head + s"a register holds whatever the device put in it, and $shown " +
                "is the claim that a value has been checked. Declare the register at " +
                s"${type_show(underlying(t))} and convert what you read")
        return false
    end if

    val why = underlying(t) match
        Unknown -> return false
        Integer(_, _, _) -> return true
        Fixed(_, _, _) -> return true
        Floating(_, _) -> return true
        Char -> return true
        Bool -> return true
        Enum(d) ->
            if d.simple then return true

            s"'$shown' carries a payload beside its tag, so touching one is more than the single " +
            "access the qualifier promises. A register field that is a set of named values is a " +
            "simple enum, which is one integer"
        _ ->
            if erased(t)
                "an object over a trait is a pair of words, so touching one is two accesses whatever " +
                "the source says — and the table beside the value is this program's, not a device's"
            else volatile_refusal(underlying(t), shown)

    if why.is_empty() then return true

    a.fault(scope, span, head + why)
    false
end volatile_admits

// The rest of the refusals, by shape; empty where the shape is admitted.
private volatile_refusal(t: Type, shown: string) -> string = t match
    Ptr(_) -> ""
    CFn(_, _) -> ""
    Ref(_, _) -> volatile_counted()
    Weak(_) -> volatile_counted()
    Slice(_, _) -> volatile_counted()
    Str -> volatile_counted()
    Struct(_) ->
        s"a register block is qualified one field at a time, so write 'volatile' on the fields of " +
        s"'$shown' that are registers — which is also what lets a shadow field in the middle of one " +
        "stay ordinary"
    _ -> "'volatile' qualifies a scalar or a raw pointer, since it promises the one load or the " +
         "one store the source wrote and nothing else"

private volatile_counted() -> string =
    "the qualifier says every access is emitted exactly as written, and a counted value's accesses " +
    "come with retains and releases that no rule here could hold still — device memory is reached " +
    "with a raw pointer"

// Whether a type constrains which VALUES it has, as against merely having an identity of its own: a
// bare `new` derivation asserts nothing about a value.
private volatile_constrains(t: Type) -> bool = t match
    Constrained(d) -> d.lo.is_some() || d.hi.is_some() || d.pred_fn.is_some() || volatile_constrains(d.base)
    _ -> false

// `&T` — and where `T` is a trait, the one place a trait object is formed, so the one place its
// formability is asked about.
//
// **An atomic reference promises that a second domain may hold the object**, which is a promise
// about everything the object holds (`reference/memory.md § Crossing a concurrency domain`). A trait
// object is the one pointee whose contents are not known here -- the type it forgot is settled
// where a value is erased into one, and that is where it is asked.
private resolve_ref(a: &Analysis, scope: Scope, span: Span, inner: TypeRef, sync: bool,
                    subst: Buf[Binding]) -> Type
    val ty = addressable(a, scope, span, under_indirection(a, () -> resolve_pointee(a, scope, inner, subst, "&")),
                         "'&'")

    if check_object_written(a, scope, inner, ty, "&", subst) then return Unknown

    if sync
        ty match
            Trait(_, _, _) -> ()
            _ -> check_shared(a, scope, span, ty)
    end if

    Ref(ty, sync)
end resolve_ref

// `*T` — and where `T` is a trait, a raw object, asked about as the counted one is.
private resolve_ptr(a: &Analysis, scope: Scope, span: Span, inner: TypeRef, subst: Buf[Binding]) -> Type
    val ty = addressable(a, scope, span, under_indirection(a, () -> resolve_pointee(a, scope, inner, subst, "*")),
                         "'*'")

    if check_object_written(a, scope, inner, ty, "*", subst) then return Unknown

    Ptr(ty)
end resolve_ptr

// Every type of a list, in order.
resolve_list(a: &Analysis, scope: Scope, ts: Buf[TypeRef], subst: Buf[Binding]) -> Buf[Type]
    var out: Buf[Type] = buf()

    for item in ts
        out.push(resolve_type(a, scope, item, subst))

    out
end resolve_list

// `<N>T` -- a vector, whose lane count is a constant on the terms an array's length is.
private resolve_vector(a: &Analysis, scope: Scope, span: Span, lanes: Expr, elem: TypeRef,
                       subst: Buf[Binding]) -> Type
    if length_is_type_param(a, scope, span, lanes, subst) then return Unknown

    // The count is settled when the code is generated, so it has to fold, and to something: an
    // array may be empty because it is storage, and a register cannot be.
    val refusals = a.const_refusals

    if !folds_to_extent(a, scope, span, lanes, subst)
        if const_refused_since(a, refusals)
            val inner = analyzer_for(a, scope)

            inner.subst = subst
            const_int(inner, lanes)
            return Unknown
        end if

        // A count over a value parameter stands at zero for the walk of the generic body itself,
        // as an array's length does; each instantiation reads it again with the value bound.
        if awaits_instantiation(a, scope, lanes, subst) then
            return Vector(0, resolve_qualified(a, scope, elem, subst))

        a.fault(scope, span, "a vector's lane count must be a constant — a literal, or a 'const' naming one")
        return Unknown
    end if

    val n = const_extent(a, scope, span, lanes, subst)

    // A count naming a value parameter folds to zero while the generic declaration is read in its
    // own terms, the parameter standing in as a zero there, and is not that mistake. An
    // instantiation made at zero is, and is told so here, at the spelling in the declaration.
    if n == 0 && !names_stand_in(lanes, subst)
        a.fault(scope, span, "a vector of no lanes holds nothing and computes nothing — an array may " +
                "be empty because it is storage, and a register cannot be")
        return Unknown
    end if

    val lane = resolve_qualified(a, scope, elem, subst)

    if !is_lane(lane)
        a.fault(scope, span, s"a vector's lanes are scalars, and ${type_show(lane)} is not one — an " +
                "integer, a float, 'bool' or 'char' may be a lane, and an aggregate has no lane-wise " +
                "arithmetic to give")
        return Unknown
    end if

    Vector(int(n), lane)
end resolve_vector

// Whether a written count or value argument reads a value parameter that is only standing in --
// the generic declaration being read in its own terms rather than instantiated.
private names_stand_in(e: Expr, subst: Buf[Binding]) -> bool = *e.kind match
    Ident(n) -> bound_type(subst, n) match
        Some(ConstArg(_, _, stood)) -> stood
        _ -> false
    Unary(_, operand) -> names_stand_in(operand, subst)
    Binary(_, l, r) -> names_stand_in(l, subst) || names_stand_in(r, subst)
    _ -> false

// Whether a written lane type may be one: `can_be_lane`, or a type not settled yet. A qualifier is
// refused here rather than peeled -- `<4>volatile u32` is the qualifier on the wrong side.
private is_lane(t: Type) -> bool = t match
    Abstract(_, _) -> true
    Unknown -> true
    Volatile(_) -> false
    _ -> can_be_lane(t)

private resolve_array(a: &Analysis, scope: Scope, span: Span, length: Option[Expr], elem: TypeRef,
                      read_only: bool, subst: Buf[Binding]) -> Type
    // A fixed array HOLDS its elements and a slice POINTS at them, which is the whole of why one is
    // an indirection and the other is not.
    if length.is_none() then
        return Slice(addressable(a, scope, span, under_indirection(a, () -> resolve_qualified(a, scope, elem, subst)),
                                 "a slice"), read_only)

    val written = length.unwrap()

    if length_is_type_param(a, scope, span, written, subst) then return Unknown

    val e = resolve_qualified(a, scope, elem, subst)

    // The rule the declaration asks of a written length, asked again of the substitution -- which is
    // what reaches a length written inside a BODY, where the declaration-time walk never looks: a
    // name bound to a value may be the length but not be computed with.
    length_arithmetic(a, scope, span, written, const_arg_names(subst))

    // A length over a type parameter has no value during the walk that checks the generic body
    // itself, there being no `T` yet — and that is not a mistake to report, since the body is
    // analyzed again for each instantiation with the parameter bound. The array stands at length
    // zero for that one walk. Anything else that will not fold is a length settled while the
    // program runs, which an array's cannot be.
    //
    // **A length whose fold REFUSED is not that mistake** -- a division by zero is a constant
    // expression that has no value, and it was told where the division is. The fold is made once
    // more keeping what it says, since the one above put its complaints back, and the array has no
    // type to be rather than a length nobody wrote.
    val refusals = a.const_refusals

    if !folds_to_extent(a, scope, span, written, subst)
        if const_refused_since(a, refusals)
            val inner = analyzer_for(a, scope)

            inner.subst = subst
            const_int(inner, written)
            return Unknown
        end if

        if !awaits_instantiation(a, scope, written, subst) then
            a.fault(scope, span, "an array length must be a constant — a literal, or a 'const' naming one")
    end if

    // A negative length folds, and is a mistake of its own rather than one that does not fold -- it
    // reaches here through a value argument, `Buf[-1]`, as readily as through a literal.
    val negative = negative_extent(a, scope, written, subst)

    if negative.is_some()
        a.fault(scope, span, s"an array cannot have ${str(negative.unwrap())} elements")
        return Unknown
    end if

    Array(int(const_extent(a, scope, span, written, subst)), addressable(a, scope, span, e, "an array"))
end resolve_array

// Whether a written length is a bare name standing for a **type** -- `[T]int` where `T` is a type
// parameter -- which is refused here, where the type is read. A length is a value, and a parameter
// standing for one is declared `const`; such a parameter stands in as a number rather than as a
// type, which is what tells the two apart. Read on, the name would stand at zero and the array
// would quietly be one nobody wrote: `impl[N, T] Tag for [N]T` an implementation for `[0]T`.
//
// **A type's own fields are not asked**: a generic type's fields are read at stand-ins only to
// build the shape its members are checked against, and a length there is judged when something
// instantiates the type.
private length_is_type_param(a: &Analysis, scope: Scope, span: Span, len: Expr,
                             subst: Buf[Binding]) -> bool
    if !a.resolving.is_empty() then return false

    val n = *len.kind match
        Ident(n) -> n
        _ -> return false

    val name = bound_type(subst, n) match
        Some(Abstract(name, _)) -> name
        _ -> return false

    val message = s"'$name' is a type parameter, and an array's length is a value rather than a " +
                  s"type — a parameter that stands for a length is declared 'const $name: usize'"

    // A signature is asked this at its declaration too, from the names alone, and that is where the
    // reader was told.
    if !a.said_around(scope, span, message) then a.fault(scope, span, message)

    // A length with no value, told where it is: counted with the folds that refused, so a reader of
    // the type can tell this from a type that is merely not there.
    a.const_refusals += 1
    true
end length_is_type_param

// The length a written one folds to, where that is below zero.
private negative_extent(a: &Analysis, scope: Scope, e: Expr, subst: Buf[Binding]) -> Option[BigInt]
    *e.kind match
        IntLit(_, _, _) -> return None
        _ -> ()

    val inner = analyzer_for(a, scope)

    inner.subst = subst

    val mark = a.complaints()
    val folded = const_int(inner, e)

    a.restore_complaints(mark)

    if folded.is_none() then return None

    val n = folded.unwrap()

    if n < from_int(0) then Some(n) else None
end negative_extent

// The names a substitution binds to a value -- a value parameter, or the loop variable of a
// `for const`.
private const_arg_names(subst: Buf[Binding]) -> Buf[string]
    var out: Buf[string] = buf()

    for item in subst
        item.ty match
            ConstArg(_, _, _) -> out.push(item.name)
            _ -> ()

    out
end const_arg_names

// Whether this length reads as a constant at all, asked without leaving a complaint behind: the walk
// that answers it is the same one `const_extent` makes, and a length that does not fold is either a
// parameter awaiting its instantiation or the refusal above.
private folds_to_extent(a: &Analysis, scope: Scope, span: Span, e: Expr,
                        subst: Buf[Binding]) -> bool
    *e.kind match
        IntLit(_, _, _) -> return true
        _ -> ()

    val inner = analyzer_for(a, scope)

    inner.subst = subst

    val mark = a.complaints()
    val folded = const_int(inner, e)

    a.restore_complaints(mark)

    folded.is_some()
end folds_to_extent

// Whether a length stands over a type parameter that has not been given a type yet -- a measurement
// of one, `[sizeof(T)]u8`, or the bare name where a type's own fields are read at stand-ins. A value
// parameter is not here: it stands in as a number, and that one folds.
private awaits_instantiation(a: &Analysis, scope: Scope, e: Expr, subst: Buf[Binding]) -> bool =
    *e.kind match
        Ident(n) -> bound_type(subst, n) match
            Some(t) -> t match
                Abstract(_, _) -> true
                _ -> false
            None -> false
        LayoutOf(_, tr) -> abstract_operand(a, scope, tr, subst)
        OffsetOf(tr, _) -> abstract_operand(a, scope, tr, subst)
        TypeAttr(receiver, _, _, _) -> awaits_instantiation(a, scope, receiver, subst)
        Unary(_, operand) -> awaits_instantiation(a, scope, operand, subst)
        Binary(_, l, r) ->
            awaits_instantiation(a, scope, l, subst) || awaits_instantiation(a, scope, r, subst)
        Compare(operands, _) ->
            operands.len() == 2 && (awaits_instantiation(a, scope, operands.at(0), subst) ||
                                    awaits_instantiation(a, scope, operands.at(1), subst))
        Call(callee, args) -> *callee.kind match
            Ident(_) ->
                args.len() == 1 && awaits_instantiation(a, scope, args.at(0), subst)
            _ -> false
        _ -> false

// Whether a measurement's subject is a type parameter standing for itself, which is what makes
// `sizeof(T)` a number this walk cannot have.
private abstract_operand(a: &Analysis, scope: Scope, tr: TypeRef, subst: Buf[Binding]) -> bool =
    underlying(resolve_type(a, scope, tr, subst)) match
        Abstract(_, _) -> true
        _ -> false

// A resolution run one hop further out than the one around it.
under_indirection(a: &Analysis, resolve: &Fn() -> Type) -> Type
    a.indirection += 1

    val out = resolve()

    a.indirection -= 1
    out
end under_indirection

// A resolution run inside a type-argument list, which is not on its own an answer to whether a type
// contains itself: whether `Buf[Node]` holds a `Node` depends on how `Buf` uses its parameter, and
// the question is asked again where the substitution is used.
under_type_arg(a: &Analysis, resolve: &Fn() -> Buf[Type]) -> Buf[Type]
    a.type_arg_depth += 1

    val out = resolve()

    a.type_arg_depth -= 1
    out
end under_type_arg

// Whether reaching an in-progress instantiation again is a legal cycle: it is exactly when at least
// one hop was crossed on the way back to it. Both counts are compared against where the type was
// ENTERED rather than against zero -- an argument list entered after it is what excuses a path, and
// never what a type does to itself.
// Answers whether it fired, because a field whose type is the shape being refused may not be
// RECORDED as that shape: the table would then hold a type that genuinely contains itself, and every
// pass that walks a layout would follow it for ever. What the field gets instead is `Unknown`, which
// is what everything downstream already means by "a mistake was reported here".
cycle_check(a: &Analysis, scope: Scope, span: Span, key: string) -> bool
    var found = false

    for at in a.resolving
        if at.0 == key && a.indirection <= at.1 && a.type_arg_depth <= at.2
            a.fault(scope, span,
                    s"type '${qualified_name(instance_base(key))}' contains itself, so it has no " +
                    "finite size")

            found = true

    found
end cycle_check

// The declared name an instance key was made from, which is what a diagnostic calls the type.
private instance_base(key: string) -> string
    val at = key.index_of("[")

    if at.is_none() then return key

    key[0..<at.unwrap()]
end instance_base

// What a type parameter stands for, asked the containment question the argument position deferred:
// a `T` used **by value** here is the containing type held by value, whatever hop the parameter was
// written behind.
//
// **The question is about what the argument REACHES, not about what it is.** Asking only whether the
// argument is itself in progress answers a mutual cycle wrong, because the other type on the cycle
// has usually finished by the time the generic's field substitutes it.
substituted(a: &Analysis, scope: Scope, span: Span, t: Type) -> Type
    if a.resolving.is_empty() then return t

    var found: Buf[string] = buf()
    var seen: Buf[string] = buf()

    reached_by_value(a, t, &seen, &found)

    var cut = false

    for item in found
        if cycle_check(a, scope, span, item) then cut = true

    if cut then Unknown else t
end substituted

// Every still-resolving type a layout reaches **without crossing a hop**, which is the whole of what
// makes a cycle infinite. A struct's fields, an enum variant's payload, a fixed array's elements and
// a constrained type's base are all held; a pointer, a reference, a weak reference and a slice all
// point, so the walk stops at them.
//
// **Every one of them rather than the first**, because `resolving` records the hop count each type
// was entered at and a walk can reach two entered at different ones.
private reached_by_value(a: &Analysis, t: Type, seen: *Buf[string], found: *Buf[string])
    t match
        Struct(d) ->
            val key = instance_key(d.base, d.targs)

            if is_resolving(a, key)
                if !holds_string(*found, key) then found.push(key)
            else if !holds_string(*seen, key)
                seen.push(key)

                for item in d.fields
                    reached_by_value(a, item.1, seen, found)
        Enum(d) ->
            val key = instance_key(d.base, d.targs)

            if is_resolving(a, key)
                if !holds_string(*found, key) then found.push(key)
            else if !holds_string(*seen, key)
                seen.push(key)

                for v in d.variants
                    for j in 0..<v.fields.len()
                        reached_by_value(a, v.fields.at(j).1, seen, found)
        Array(_, elem) -> reached_by_value(a, *elem, seen, found)
        Constrained(d) -> reached_by_value(a, d.base, seen, found)
        _ -> ()

private is_resolving(a: &Analysis, key: string) -> bool
    for item in a.resolving
        if item.0 == key then return true

    false
end is_resolving

// A tuple is an ordinary struct declared by the compiler, and a result list is that tuple wearing a
// second name -- which is what tells `return a, b` from `return (a, b)`.
private resolve_tuple(a: &Analysis, scope: Scope, parts: Buf[TypeRef], results: bool,
                      subst: Buf[Binding]) -> Type
    // `(..A)` -- the tuple of a pack. The pack is **looked up** rather than resolved, because what
    // stands for it in the substitution is already the list of parts: for the walk that checks a
    // generic body that is the stand-ins, and for an instantiation it is the parts the subject
    // matched. Either way the tuple built here is an ordinary one, so nothing downstream of this
    // point knows a pack was written.
    val packed = sole_pack_parts(subst, parts)

    if packed.is_some()
        val d = registered_tuple(a, packed.unwrap())

        return if results then Results(d) else Struct(d)
    end if

    val ts = resolve_list(a, scope, parts, subst)
    val d = registered_tuple(a, ts)

    if results then Results(d) else Struct(d)
end resolve_tuple

// The parts a one-part tuple reference stands for, where it is written over a pack and that pack is
// bound. A name that stands for anything else is left to the ordinary walk, which reads it as the
// stand-in it is -- a shape mentioning a parameter, and so one nothing lays out.
private sole_pack_parts(subst: Buf[Binding], parts: Buf[TypeRef]) -> Option[Buf[Type]]
    if parts.len() != 1 then return None

    *parts.at(0).kind match
        PackType(n) -> bound_type(subst, n) match
            Some(Pack(elems)) -> Some(elems)
            _ -> None
        _ -> None
end sole_pack_parts

// The struct a tuple of these types is: `$tupleN`, its arguments the parts, its fields numbered.
//
// Nameless for `instantiate_struct`'s reason: `(Size, int)` over a measured `size_t` is `(u64, int)`.
tuple_type(written: Buf[Type]) -> &StructType
    val ts = nameless_all(written)
    var fields: Buf[(string, Type)] = buf()

    for i in 0..<ts.len()
        fields.push((str(i), ts.at(i)))

    StructType(tuple_base(ts.len()), ts, fields, false, None, None, false)
end tuple_type

// The same, recorded -- so that one `(string, string)` is one type wherever it is written, and so
// that a compilation's list of what it laid out holds the tuples as well as the declared records.
//
// **After the parts, like every other record**, since a tuple is a struct the compiler declared and
// what it is made of is laid out before it is.
registered_tuple(a: &Analysis, ts: Buf[Type]) -> &StructType
    val made = tuple_type(ts)
    val key = instance_key(made.base, made.targs)
    val already = a.tables.struct_insts.get(key)

    if already.is_some()
        already.unwrap() match
            Struct(d) -> return d
            _ -> ()
    end if

    a.tables.struct_insts.put(key, Struct(made))
    made
end registered_tuple

// The parameter list of a callable AS IT WAS WRITTEN -- `*u8, *u8`, not the `*byte, *byte` the
// resolved types would show -- for a message about the spelling, which quotes the reader's words.
private written_params(params: Buf[TypeRef]) -> string
    var out = ""

    for i in 0..<params.len()
        if i > 0 then out = out + ", "

        out = out + type_text(params.at(i))

    out
end written_params

// `int -> unit`, `(int, int) -> int` -- a bare arrow as the arrow spelling writes it.
private bare_arrow_show(params: Buf[TypeRef], ret: TypeRef) -> string =
    if params.len() == 1 then s"${type_text(params.at(0))} -> ${type_text(ret)}"
    else s"(${written_params(params)}) -> ${type_text(ret)}"

// What stands behind a mode -- `&`, `*` or `weak` -- which is the one place a callable is a type: the
// trait object of the call trait, whichever of the two spellings wrote it.
// `sigil` is the mode written; a raw pointer's pointee is the one of the three that may be `volatile`.
private resolve_pointee(a: &Analysis, scope: Scope, inner: TypeRef, subst: Buf[Binding],
                        sigil: string) -> Type =
    *inner.kind match
        FnType(params, ret, _) -> resolve_fn_trait(a, scope, inner.span, params, ret, false, subst)
        // A name behind a mode is the one place a trait may be what it names.
        NamedType(name, args) -> resolve_named(a, scope, inner.span, name, args, subst, sigil)
        _ -> if sigil == "*" then resolve_qualified(a, scope, inner, subst) else resolve_type(a, scope, inner, subst)

// **A callable is not a type: it is a trait**, and a trait stands where a type does only behind a
// mode. The bare arrow is a parameter's sugar and has a refusal of its own; `Fn(…) -> r` written
// where a concrete type is required names the box it should have been.
private resolve_unboxed_callable(a: &Analysis, scope: Scope, t: TypeRef, params: Buf[TypeRef],
                                 ret: TypeRef, bare: bool, subst: Buf[Binding]) -> Type
    val made = resolve_fn_trait(a, scope, t.span, params, ret, bare, subst)

    if bare || made == Unknown then return made

    val written = type_text(t)

    a.fault(scope, t.span, s"'$written' is a trait, and a trait is a type only behind a mode — " +
            s"write '&$written' for the boxed callable a concrete slot takes")
    Unknown
end resolve_unboxed_callable

// A written `Fn(a, b) -> r` is the callable trait of that arity, its arguments the parameters with
// the result last.
private resolve_fn_trait(a: &Analysis, scope: Scope, span: Span, params: Buf[TypeRef],
                         ret: TypeRef, bare: bool, subst: Buf[Binding]) -> Type
    // **The library declares four of them and no more**, so a wider one names a trait that is not
    // there — which would be reported as a missing name rather than as the limit it is.
    if params.len() > MaxCallableParams
        a.fault(scope, span, s"a callable takes up to $MaxCallableParams parameters and this one " +
                s"takes ${params.len()} — a call this wide reads better with the arguments named, " +
                "so pass a struct of them")
        return Unknown
    end if

    var args = resolve_list(a, scope, params, subst)

    args.push(resolve_type(a, scope, ret, subst))

    // **A bare arrow is a parameter's form and nothing else**, and by the time a type is resolved
    // every parameter that wrote one has been rewritten into the bound it is sugar for — so an arrow
    // arriving here stands somewhere a concrete type is required, where a callable is a box. Both
    // halves of the message quote the types as WRITTEN, as the reference's does.
    if bare
        val boxed = s"&Fn(${written_params(params)}) -> ${type_text(ret)}"

        a.fault(scope, span, s"'${bare_arrow_show(params, ret)}' is a callable a function is passed and " +
                "does not keep, which only a parameter may be — anywhere a concrete type is " +
                s"required, a callable is boxed, so write '$boxed'")
        return Unknown
    end if

    // **The trait is FOUND rather than composed.** `Fn0` is `sysl$Fn0`, and a trait written under
    // its bare spelling would answer no to every question asked of the key -- so a closure standing
    // at a `&Fn() -> unit` would not be seen to implement the very trait the type names. The bare
    // name is kept only where the library is not there to be found, which is where nothing can
    // implement it either.
    val key = lookup_trait_key(a, scope, fn_base(params.len()))

    Trait(key.unwrap_or(fn_base(params.len())), args, buf())
end resolve_fn_trait

// How long a written extent is.
//
// **A literal is read here and anything else is folded**, because a length may be any constant
// expression: `[addr_bytes]u8` is an array of a hundred and twenty-eight bytes wherever the `const`
// naming that number can be reached. The fold is the same one an expression performs, run against
// the file the type was written in.
//
// **What does not fold stands at zero rather than being guessed at.** A length written in terms of a
// type parameter has no value during the walk that checks a generic declaration itself -- there is no
// `T` yet -- and every array the program actually gets is built again for each instantiation, where
// the measurement answers.
private const_extent(a: &Analysis, scope: Scope, span: Span, e: Expr,
                     subst: Buf[Binding]) -> usize
    *e.kind match
        IntLit(digits, base, _) -> return digits_value(digits, base)
        _ -> ()

    // Read in the terms the type was written in, and with whatever it says put back: a length that
    // does not fold is a length this walk cannot settle, and the walk that can settles it again.
    val inner = analyzer_for(a, scope)

    inner.subst = subst

    val mark = a.complaints()
    val folded = const_int(inner, e)

    a.restore_complaints(mark)

    if folded.is_none() then return 0

    val n = folded.unwrap().to_long().unwrap_or(-1)

    if n < 0 then return 0

    usize(n)
end const_extent

// A written value argument, as the identity a type carries it in: the number it stands for and the
// kind that says how to read it back.
//
// **A `bool` and a `char` are values a type's identity may hold** as much as an integer is -- each
// compares and each mangles -- so folding one to a number and calling it a length would make
// `Flag[true]` and `Flag[false]` one type. The kind is kept beside the number for the same reason
// the declared type is kept beside a constant: it is the half that makes the number mean something.
private const_argument(a: &Analysis, scope: Scope, span: Span, e: Expr,
                       subst: Buf[Binding]) -> Type
    val inner = analyzer_for(a, scope)

    inner.subst = subst

    val mark = a.complaints()
    val folded = const_fold(inner, e)

    a.restore_complaints(mark)

    // An argument written over a parameter that is only standing in is a stand-in too, so a generic
    // declaration naming `Lanes[W]` is not read as one that asked for `Lanes[0]`.
    val stood = names_stand_in(e, subst)

    folded match
        Some(ConstBool(b)) -> ConstArg(from_int(if b then 1 else 0), Bool, stood)
        Some(ConstChar(c)) -> ConstArg(from_int(long(int(u32(c)))), Char, stood)
        Some(ConstInt(v)) -> ConstArg(v, int_type(), stood)
        _ -> ConstArg(from_int(long(const_extent(a, scope, span, e, subst))), int_type(), stood)
end const_argument

private digits_value(digits: string, base: int) -> usize
    var n: usize = 0
    val b = digits.bytes

    for i in 0..<b.len
        val c = b[i]
        var d: usize = 16

        if c >= u8('0') && c <= u8('9') then d = usize(c - u8('0'))
        else if c >= u8('a') && c <= u8('f') then d = usize(c - u8('a')) + 10
        else if c >= u8('A') && c <= u8('F') then d = usize(c - u8('A')) + 10

        if d < usize(base) then n = n * usize(base) + d

    n
end digits_value

// Whether a plain decimal digit string parses as a 32-bit signed int the way the reference's own
// `String.toIntOption` would -- the bootstrap tells a width that merely exceeds the back end's
// ceiling from one so large it never became a number at all, and this is that same line.
private fits_i32(digits: string) -> bool
    val max_i32 = "2147483647"
    val b = digits.bytes

    if b.len < max_i32.len then return true
    if b.len > max_i32.len then return false

    val m = max_i32.bytes

    for i in 0..<b.len
        if b[i] < m[i] then return true
        if b[i] > m[i] then return false

    true
end fits_i32

// -- a name -------------------------------------------------------------------------------------

// The type a written name means, with whatever arguments it was given.
//
// `sigil` is the mode the name was written behind -- `&`, `*` or `weak`, the only place a trait
// stands where a type does -- and empty where it was written bare.
private resolve_named(a: &Analysis, scope: Scope, span: Span, name: string, args: Buf[TypeRef],
                      subst: Buf[Binding], sigil: string) -> Type
    val behind_a_mode = sigil != ""

    // **A bare associated-type name is the mistake to catch before the arguments are read**, because
    // after it the reader is told there is no type of that name -- which is true and is about the
    // wrong thing. `&Seq[Item]` is somebody one `=` short of the form they meant.
    if behind_a_mode && !args.is_empty() && bound_type(subst, name).is_none()
        val tk = lookup_type_key(a, scope, name)

        if tk.is_some() && trait_decl_at(a, tk.unwrap()).is_some()
            if bare_assoc_name(a, scope, span, tk.unwrap(), args, sigil) then return Unknown
    end if

    val read = read_type_args(a, scope, span, name, args, subst)

    if read.is_none() then return Unknown

    val targs = read.unwrap()

    if args.is_empty() then
        val stood_for = bound_type(subst, name)

        // A parameter used here stands where the declaration wrote it, and what it stands for is
        // held exactly as the parameter is -- so this is where the argument position's deferral is
        // paid for.
        if stood_for.is_some() then return substituted(a, scope, span, stood_for.unwrap())

    if name == "never"
        a.fault(scope, span, "'never' is the type of an expression that does not finish, so it can " +
                "only be a result type")
        return Unknown
    end if

    // `Self` is bound by a trait or an `impl`; anywhere else it names nothing, and says why.
    if name == "Self"
        val bound = bound_type(subst, "Self")

        if bound.is_some() then return bound.unwrap()

        a.fault(scope, span, "'Self' names the type a trait is implemented for, so it is only " +
                "meaningful inside a 'trait' or an 'impl'")
        return Unknown
    end if

    // An async function's result, as the parser rewrote it: the name holds a `$`, so nothing a
    // program declares can stand in front of it.
    if name == TaskBase && targs.len() == 1 then return task_type(targs.at(0))

    val scalar = scalar_named(name, int(a.tables.target.pointer_bits()))

    if scalar.is_some() then return plain_type(a, scope, span, name, targs, scalar.unwrap())

    val width = width_type(a, scope, span, name)

    if width.is_some() then return plain_type(a, scope, span, name, targs, width.unwrap())

    // A type named in another module is an edge of the module graph, made at the name.
    a.tables.reference_at = span

    val key = lookup_type_key(a, scope, name)

    a.tables.reference_at = span_zero()

    if key.is_none() then
        val rivals = offered_by(a, scope, name, k -> a.tables.types.has(k))

        // `Task[T]` is the compiler's, and only where nothing the program can see is called `Task`
        // -- a declaration of that name is the nearer binding, as it is for any other type.
        if name == "Task" && rivals.is_empty() then return written_task(a, scope, span, targs)

        if rivals.len() > 1 then a.fault(scope, span, ambiguous_offer(name, rivals))
        else a.fault(scope, span, s"unknown type '$name'")

        return Unknown

    // **An argument that binds an associated type by name is not a type argument**, so it is taken
    // out before the arity is counted: `Keyed[int, Item = int]` applies one argument and binds one
    // associated type, and counting two would report a trait with one parameter as given two.
    val d = trait_decl_at(a, key.unwrap())

    if d.is_some()
        // **A trait describes what a value can do, not how one is laid out**, so it stands where a
        // type is asked for only behind a mode -- and the ways of reaching it are named, since which
        // one a program wants is the whole of the choice it has to make.
        if !behind_a_mode
            a.fault(scope, span, s"'$name' is a trait, so it describes behaviour rather than a " +
                    s"layout — write '*$name' or '&$name' for a trait object, or bound a type " +
                    s"parameter with '[T: $name]'")
            return Unknown
        end if

        var positional: Buf[TypeRef] = buf()
        var named: Buf[(string, Type)] = buf()

        for item in args
            *item.kind match
                AssocArgType(bound, inner) ->
                    named.push((bound, resolve_type(a, scope, inner, subst)))
                _ -> positional.push(item)

        return object_of(a, scope, span, name, key.unwrap(), d.unwrap(),
                         resolve_list(a, scope, positional, subst), named, sigil)
    end if

    // **A raw pointer excuses its own pointee and nothing deeper** -- `*net.Conn` needs no layout,
    // and a `*Holder` does not make `Holder`'s by-value field of an opaque type legal. `&` and `weak`
    // do not excuse it: a counted reference's release has to know what the object holds.
    if sigil != "*" && !layout_known(a, scope, span, key.unwrap(), name) then return Unknown

    instantiate(a, scope, span, name, key.unwrap(),
                at_declared_widths(a, key.unwrap(), targs))
end resolve_named

// A written argument list, read **against the declaration whose parameters it fills** — which
// argument is a value is the declaration's fact and nothing the grammar can see, `Buf[4]` and
// `Buf[int]` being the same shape to a parser. So a value argument carries the type the declaration
// wrote for its parameter rather than the one a literal falls to on its own, and a member reading
// the parameter reads an ordinary value of that type.
private at_declared_widths(a: &Analysis, key: string, targs: Buf[Type]) -> Buf[Type]
    val pair = declared_values(a, key)

    if pair.1.is_empty() then return targs

    var out: Buf[Type] = buf()
    val home = a.tables.types.get(key).unwrap().scope

    for i in 0..<targs.len()
        val written = if i < pair.0.len() then binding_named(pair.1, pair.0.at(i)) else None

        targs.at(i) match
            ConstArg(v, ty, stood) ->
                if written.is_none() then out.push(ConstArg(v, *ty, stood))
                else out.push(ConstArg(v, resolve_type(a, home, written.unwrap(), no_bindings()),
                                       stood))
            other -> out.push(other)

    out
end at_declared_widths

// A written argument list, resolved **against the declaration whose parameters it fills**, because
// which argument is a type and which a value is the declaration's fact and nothing the grammar can
// see: `Buf[4]` and `Buf[int]` are one shape to a parser, and so are `Buf[SIZE]` and `Box[T]`. So a
// bare name in a value position is read as the expression it is -- a constant, an enclosing block's
// value parameter, a simple enum's variant -- and a value in a type position is refused. `None` is
// an argument refused, which makes the whole type nothing rather than one built over a hole.
private read_type_args(a: &Analysis, scope: Scope, span: Span, name: string, args: Buf[TypeRef],
                       subst: Buf[Binding]) -> Option[Buf[Type]]
    a.type_arg_depth += 1

    val out = read_type_args_at(a, scope, span, name, args, subst)

    a.type_arg_depth -= 1
    out
end read_type_args

private read_type_args_at(a: &Analysis, scope: Scope, span: Span, name: string,
                          args: Buf[TypeRef], subst: Buf[Binding]) -> Option[Buf[Type]]
    if args.is_empty() || bound_type(subst, name).is_some() then
        return Some(resolve_list(a, scope, args, subst))

    val key = lookup_type_key(a, scope, name)

    if key.is_none() then return Some(resolve_list(a, scope, args, subst))

    read_args_for(a, scope, span, key.unwrap(), args, subst)
end read_type_args_at

// An argument that is a bare name an enclosing generic declaration stands in for, as its stand-in.
private open_value_param(arg: TypeRef, subst: Buf[Binding]) -> Option[Type] =
    *arg.kind match
        NamedType(n, targs) -> if targs.is_empty() then abstract_bound(subst, n) else None
        _ -> None

private abstract_bound(subst: Buf[Binding], name: string) -> Option[Type] =
    bound_type(subst, name) match
        Some(t) -> t match
            Abstract(_, _) -> Some(t)
            _ -> None
        None -> None

// A **trait's** arguments as written at a bound or an `impl`, each value argument read at the type
// the trait wrote for its `const` parameter. An argument refused stands as `Unknown`, so the list
// keeps the length the arity check is asked about.
trait_args_read(a: &Analysis, scope: Scope, span: Span, key: string, args: Buf[TypeRef],
                subst: Buf[Binding]) -> Buf[Type]
    a.type_arg_depth += 1

    val read = read_args_for(a, scope, span, key, args, subst, true)

    a.type_arg_depth -= 1

    if read.is_some() then return read.unwrap()

    // The refusal has been said. A value parameter stands at zero of its type from here, as it does
    // for the walk over a generic body, so the members the trait supplies are read as they would be
    // with a good argument and say nothing more about the one that was not.
    val pair = declared_values(a, key)
    var out: Buf[Type] = buf()

    for i in 0..<args.len()
        val declared = if i < pair.0.len() then binding_named(pair.1, pair.0.at(i)) else None

        if declared.is_none() then out.push(Unknown)
        else out.push(ConstArg(from_int(0), resolve_type(a, a.tables.types.get(key).unwrap().scope,
                                                         declared.unwrap(), no_bindings()), true))

    out
end trait_args_read

// The arguments of the declaration at `key`, a value argument read where it wrote `const`.
//
// `keep_open` is a trait's: a generic block's own value parameter written as the argument --
// `impl[const M: usize] Bytes[M] for Bits[M]` -- stays the parameter, as a type parameter does, so
// the members the trait supplies read the number each instantiation fixes rather than the zero a
// generic body's walk stands it at.
private read_args_for(a: &Analysis, scope: Scope, span: Span, key: string, args: Buf[TypeRef],
                      subst: Buf[Binding], keep_open: bool = false) -> Option[Buf[Type]]
    val pair = declared_values(a, key)

    if pair.0.is_empty() then return Some(resolve_list(a, scope, args, subst))

    val home = a.tables.types.get(key).unwrap().scope
    var out: Buf[Type] = buf()

    for i in 0..<args.len()
        val arg = args.at(i)
        val written = if i < pair.0.len() then binding_named(pair.1, pair.0.at(i)) else None

        val open = if keep_open && written.is_some() then open_value_param(arg, subst) else None

        if open.is_some()
            out.push(open.unwrap())
        elif written.is_some()
            val ty = resolve_type(a, home, written.unwrap(), no_bindings())
            val v = value_arg(a, scope, span, arg, ty, subst)

            if v.is_none() then return None

            out.push(v.unwrap())
        else
            *arg.kind match
                ValueArgType(_) ->
                    a.fault(scope, span, "a value stands here, and this argument is a type — a value " +
                            "argument belongs where the declaration wrote 'const', and nowhere else")
                    return None
                _ -> out.push(resolve_type(a, scope, arg, subst))
        end if

    Some(out)
end read_args_for

// One **value** argument: the expression it was written as, folded to the constant that goes in the
// type's identity, at the type the declaration wrote for its parameter. An enclosing declaration's
// value parameter stands at zero for the walk that checks a generic body, exactly as a length
// written over one does -- there is no argument yet, and that walk's tree is discarded.
//
// **The value has to be one the declared type holds** -- a value argument is the declaration's
// parameter, so `Buf[-1]` is refused at the argument rather than at the array it would have sized.
// `what` is the subject that sentence is about: the argument, or the default standing in for one.
private value_arg(a: &Analysis, scope: Scope, span: Span, arg: TypeRef, ty: Type,
                  subst: Buf[Binding], what: string = "this argument") -> Option[Type]
    val written = *arg.kind match
        ValueArgType(e) -> Some(e)
        NamedType(n, targs) -> if targs.is_empty() then Some(expr(arg.span, Ident(n))) else None
        _ -> None

    if written.is_none()
        a.fault(scope, span, "this argument stands where the declaration wrote 'const', so a value " +
                s"belongs here rather than a type — one of ${type_show(ty)}")
        return None
    end if

    val e = written.unwrap()
    val folded = const_arg_value(a, scope, e, subst)

    if folded.is_some()
        ty match
            Integer(bits, signed, _) ->
                if !fits(folded.unwrap(), bits, signed)
                    a.fault(scope, span, s"$what does not fit ${type_show(ty)}: ${to_string(folded.unwrap())}")
                    return None
                end if
            _ -> ()

        return Some(ConstArg(folded.unwrap(), ty, names_stand_in(e, subst)))
    end if

    val tag = variant_tag(a, scope, e, ty)

    if tag.is_some() then return Some(ConstArg(from_int(long(tag.unwrap())), ty, false))

    if awaits_instantiation(a, scope, e, subst) then return Some(ConstArg(from_int(0), ty, true))

    // A parameter whose declared type no value parameter may have was refused at the declaration,
    // and that is the one mistake: its arguments stand at zero, as a refused argument's do.
    if value_type_refusal(nameless(ty)).is_some() then return Some(ConstArg(from_int(0), ty, true))

    // A simple enum's parameter takes one of ITS variants; any other name -- another enum's
    // variant, qualified or bare, or a word naming nothing -- is refused with the list it chooses from.
    ty match
        Enum(d) ->
            val named = variant_named(e)

            if d.simple && named.is_some() && lookup_type_key(a, scope, named.unwrap().1).is_none()
                var names: Buf[string] = buf()

                for v in d.variants do names.push(v.name)

                a.fault(scope, span, s"'${expr_text(e)}' is not a variant of ${type_show(ty)} — $what " +
                        s"stands where the declaration wrote 'const' of that enum, so it is one of " +
                        join(names.view(), ", "))
                return None
            end if
        _ -> ()

    // A name that turns out to be a TYPE is the likely mistake in this position, and gets its own
    // sentence: `Buf[int]` reads as a list of types until the declaration says otherwise.
    *e.kind match
        Ident(n) ->
            if lookup_type_key(a, scope, n).is_some() ||
               scalar_named(n, int(a.tables.target.pointer_bits())).is_some()
                a.fault(scope, span, s"'$n' is a type, and this argument stands where the declaration " +
                        s"wrote 'const' — so a value of ${type_show(ty)} belongs here")
                return None
            end if
        _ -> ()

    a.fault(scope, span, "a value argument must be a constant — a literal, or a 'const' naming one")
    None
end value_arg

// A value argument written as an expression -- `f[High]()` on a generic function -- at the simple
// enum its parameter was declared as.
enum_value_arg(a: &Analysis, scope: Scope, span: Span, e: Expr, ty: Type, subst: Buf[Binding]) -> Type =
    value_arg(a, scope, span, type_ref(e.span, ValueArgType(e)), ty, subst).unwrap_or(Unknown)

// A value parameter's default, read as the argument it stands in for -- at the type the declaration
// wrote for the parameter, under the arguments already fixed to its left.
default_value(a: &Analysis, scope: Scope, span: Span, name: string, arg: TypeRef, ty: Type,
              subst: Buf[Binding]) -> Option[Type] =
    value_arg(a, scope, span, arg, ty, subst, s"the default for '$name'")

// The number a value argument folds to, whichever admissible kind it is.
private const_arg_value(a: &Analysis, scope: Scope, e: Expr, subst: Buf[Binding]) -> Option[BigInt]
    val inner = analyzer_for(a, scope)

    inner.subst = subst

    val mark = a.complaints()
    val folded = const_fold(inner, e)

    a.restore_complaints(mark)

    folded match
        Some(ConstBool(b)) -> Some(from_int(if b then 1 else 0))
        Some(ConstChar(c)) -> Some(from_int(long(int(u32(c)))))
        Some(ConstInt(v)) -> Some(v)
        _ -> None
end const_arg_value

// The tag a **simple enum's variant** stands for, where the value parameter's declared type is that
// enum. A simple enum's value IS its identity -- nothing else tells two of its variants apart -- so
// its tag is exactly the number a type's identity wants; a data enum's is not, and gets no case.
//
// The variant may be bare -- the parameter's type says which enum, as an expected type does for an
// ordinary value -- or qualified with the enum's own name; a qualifier naming any other type is no
// variant of this one.
private variant_tag(a: &Analysis, scope: Scope, e: Expr, ty: Type) -> Option[int]
    val named = variant_named(e)

    if named.is_none() then return None

    val (qualifier, n) = named.unwrap()

    ty match
        Enum(d) ->
            if !d.simple then return None

            if qualifier.is_some()
                lookup_type_key(a, scope, qualifier.unwrap()) match
                    Some(k) -> if k != d.base then return None
                    None -> return None
            end if

            val v = d.variant(n)

            if v.is_some() then Some(v.unwrap().tag) else None
        _ -> None
end variant_tag

// A value argument shaped like a variant: `High`, `Level.High` (a type argument's dotted name, one
// string) or the same written as a field of a name. The enum's name, where one was written, and the
// variant's.
private variant_named(e: Expr) -> Option[(Option[string], string)] =
    *e.kind match
        Ident(n) ->
            n.last_index_of(".") match
                Some(i) -> Some((Some(n[0..<i]), n[i + 1..<n.bytes.len]))
                None -> Some((None, n))
        Field(r, n, _) ->
            *r.kind match
                Ident(q) -> Some((Some(q), n))
                _ -> None
        _ -> None

// The words a variant-shaped argument was written as, for a refusal to quote.
private expr_text(e: Expr) -> string =
    variant_named(e) match
        Some((Some(q), n)) -> s"$q.$n"
        Some((None, n)) -> n
        None -> "this argument"

// A nominal declaration's type parameters and the ones of them it wrote a `const` type for.
private declared_values(a: &Analysis, key: string) -> (Buf[string], Buf[TypeBinding]) =
    a.tables.types.get(key) match
        None -> (buf(), buf())
        Some(d) -> d.kind match
            StructOf(sd) -> (sd.tparams, sd.tvalues)
            EnumOf(ed) -> (ed.tparams, ed.tvalues)
            TraitOf(td) -> (td.tparams, td.tvalues)
            _ -> (buf(), buf())

// A type that takes no arguments, told so where any were written.
private plain_type(a: &Analysis, scope: Scope, span: Span, name: string, targs: Buf[Type],
                   ty: Type) -> Type
    if !targs.is_empty() then a.fault(scope, span, s"type '$name' does not take type arguments")

    ty
end plain_type

// The width family: a letter and digits, and nothing else.
//
// **Once the shape matches, the name belongs to the family and a bad width is a diagnostic** --
// never a fall-through to "unknown type", which would send a reader looking for a missing
// declaration when what is wrong is the number they wrote.
width_type(a: &Analysis, scope: Scope, span: Span, name: string) -> Option[Type]
    val b = name.bytes

    if b.len < 2 then return None
    if b[0] != u8('i') && b[0] != u8('u') && b[0] != u8('f') then return None

    // `i32q31` is the width family with a fraction written after it, so it is the same shape read
    // one letter further -- and a bad fraction is told in the same terms a bad width is.
    val q = fixed_q_at(name)

    if q.is_some() then return fixed_width_type(a, scope, span, name, q.unwrap())

    for i in 1..<b.len
        if b[i] < u8('0') || b[i] > u8('9') then return None

    val head = name[0..<1]
    val digits = name[1..<b.len]

    if b[1] == u8('0') then
        if all_zero(digits) then
            a.fault(scope, span, s"'$name' has no bits — the width families start at 1, and a " +
                    s"single bit is '${head}1'")
        else
            a.fault(scope, span, s"'$name' has a leading zero — a width is written plainly, as " +
                    s"'$head${without_leading_zeros(digits)}'")

        return Some(Unknown)

    if !fits_i32(digits) then
        a.fault(scope, span, s"'$name' is far wider than anything can hold")
        return Some(Unknown)

    val bits = int(digits_value(digits, 10))

    if b[0] == u8('f') then
        if bits == 16 || bits == 32 || bits == 64 then return Some(Floating(bits, false))

        // `bf16` is named rather than measured -- it is `f16`'s width and not its format -- so it is
        // not a width this shape could have produced, and the message names it where a reader
        // reaching for a sixteen-bit float would look.
        if bits == 128 then a.fault(scope, span, "'f128' is not lowered yet — the widest float is 'f64'")
        else a.fault(scope, span, s"'$name' is not an IEEE floating-point width; they are f16, f32, " +
                     "and f64, and the other sixteen-bit format is 'bf16'")

        return Some(Unknown)

    if bits >= 1 && bits <= MaxIntegerBits then return Some(Integer(bits, b[0] == u8('i'), false))

    a.fault(scope, span, s"'$name' is wider than the $MaxIntegerBits bits the back end lowers")
    Some(Unknown)
end width_type

// `iWqF` and `uWqF`: a `W`-bit integer counting units of 2^-F. The shape is already known to match
// (`fixed_q_at`), so everything wrong from here is the number that was written: a width or a
// fraction with a leading zero, no fraction at all (which is the integer `iW`), or more fraction than
// the storage has bits.
private fixed_width_type(a: &Analysis, scope: Scope, span: Span, name: string, q: usize) -> Option[Type]
    val b = name.bytes
    val head = name[0..<1]
    val width_digits = name[1..<q]
    val frac_digits = name[(q + 1)..<b.len]
    val plain = s"$head${without_leading_zeros(width_digits)}q${without_leading_zeros(frac_digits)}"

    if (width_digits.bytes.len > 1 && b[1] == u8('0')) ||
       (frac_digits.bytes.len > 1 && b[q + 1] == u8('0')) then
        a.fault(scope, span, s"'$name' has a leading zero — a fixed-point type is written plainly, " +
                s"as '$plain'")
        return Some(Unknown)

    if !fits_i32(width_digits) || !fits_i32(frac_digits) then
        a.fault(scope, span, s"'$name' is far wider than anything can hold")
        return Some(Unknown)

    val bits = int(digits_value(width_digits, 10))
    val frac = int(digits_value(frac_digits, 10))

    if bits == 0 then
        a.fault(scope, span, s"'$name' has no bits — the width families start at 1")
        return Some(Unknown)

    if frac == 0 then
        a.fault(scope, span, s"'$name' has no fractional bits — that is '$head$bits'")
        return Some(Unknown)

    if frac > bits then
        a.fault(scope, span, s"'$name' has more fractional bits than its $bits bits of storage — a " +
                s"fixed-point type's fraction is 1 to its width, so the finest is '${head}${bits}q$bits'")
        return Some(Unknown)

    // A product is computed exactly at twice the width before it is rounded back, so the widest
    // fixed-point type is half the widest integer.
    if bits > MaxIntegerBits / 2 then
        a.fault(scope, span, s"'$name' is wider than the ${MaxIntegerBits / 2} bits a fixed-point " +
                "type may be — its products are computed exactly at twice its width")
        return Some(Unknown)

    Some(Fixed(bits, frac, b[0] == u8('i')))
end fixed_width_type

private all_zero(digits: string) -> bool
    val b = digits.bytes

    for i in 0..<b.len
        if b[i] != u8('0') then return false

    true
end all_zero

private without_leading_zeros(digits: string) -> string
    val b = digits.bytes
    var i: usize = 0

    while i < b.len - 1 && b[i] == u8('0')
        i += 1

    digits[i..<b.len]
end without_leading_zeros

// Which declaration a written name reaches, in the terms of the file that wrote it.
//
// **The order is the reader's**: what they wrote themselves, what they imported by name, what their
// own module declares, and only then what a wildcard brought in.
lookup_type_key(a: &Analysis, scope: Scope, name: string) -> Option[string]
    val found = type_key_of(a, scope, name)

    // **Resolution is where a dependency between two modules is MADE**, so it is where one is
    // recorded: nothing earlier could see it, since which module an unqualified name reaches is the
    // whole question this answered. It is recorded as one that only NAMES the type, which runs none
    // of its code and costs the writer nothing unless a value of it can die there and its destructor
    // is gated (`check_gated_modules`).
    if found.is_some() then depends_on_named(a, scope, found.unwrap(), span_zero())

    found
end lookup_type_key

private type_key_of(a: &Analysis, scope: Scope, name: string) -> Option[string]
    val dotted = last_dot(name)

    if dotted.is_some() then return lookup_qualified(a, scope, name, dotted.unwrap())

    // This file's own file-private declaration of the spelling comes before the module's plain key,
    // where a sibling file took that one first.
    val here = file_private_key(a, scope.src.name, module_qualify(scope.module_name, name))

    if a.tables.types.has(here) && reachable_key(a, here, scope) then return Some(here)

    // **The reader's own module beats an import of the same name**, and a name imported by name beats
    // one a wildcard merely offers.
    // Each is asked of the innermost level of imports that answers, a block's before the file's.
    val im = answering_imports(a, scope, name, k -> a.tables.types.has(k))
    val bound = im.name_key(name)

    if bound.is_some() && a.tables.types.has(bound.unwrap()) then return bound

    // Two wildcards offering the spelling make it ambiguous rather than the first one's; the use
    // reports which.
    if offered_by(a, scope, name, k -> a.tables.types.has(k)).len() > 1 then return None

    var found: Option[string] = None

    // **The library is the one wildcard whose restriction is reported**, being reached without an
    // import and searched after everything else. A type it keeps is out of reach the way a function
    // it keeps is, and the refusal says which -- where every other wildcard offers only what the
    // reader may name, so a type it keeps is simply not there.
    var kept: Option[string] = None

    for at in im.wildcards
        val key = module_qualify(at, name)

        if a.tables.types.has(key)
            if found.is_none() && reachable_key(a, key, scope) then found = Some(key)

            if at == AutoImportedModule && kept.is_none() && !reachable_key(a, key, scope) then
                kept = Some(key)

    if found.is_none() && a.tables.types.has(here) then return Some(here)

    if found.is_none() then return kept

    found
end type_key_of

// A name written with a dot in it: either a module path and a name, or a bound module alias and a
// name.
private lookup_qualified(a: &Analysis, scope: Scope, name: string, cut: usize) -> Option[string]
    val head = name[0..<cut]
    val last = name[cut + 1..<name.bytes.len]
    val aliased = scope.imports.module_as(head)

    if aliased.is_some() then
        val key = module_qualify(aliased.unwrap(), last)

        if a.tables.types.has(key) then return Some(key)

    // The head is a module path, so it is read through the package layer: a file of a fetched
    // package writing its own tree's name means that tree, and a consumer writing the name its
    // manifest bound means the package it bound.
    val key = module_qualify(module_in_package(a, scope.pkg, head, last), last)

    if a.tables.types.has(key) then Some(key) else None
end lookup_qualified

private last_dot(name: string) -> Option[usize]
    val b = name.bytes
    var found: Option[usize] = None

    for i in 0..<b.len
        if b[i] == u8('.') then found = Some(i)

    found
end last_dot

// Whether a key is one the reader's file may name.
reachable_key(a: &Analysis, key: string, from: Scope) -> bool = access_for(a, key) match
    Some(acc) -> reachable(acc, from)
    None -> true

// -- filling in a declaration ---------------------------------------------------------------------

// The type a declaration at these arguments is.
instantiate(a: &Analysis, scope: Scope, span: Span, written: string, key: string,
            targs: Buf[Type]) -> Type
    if !reachable_key(a, key, scope) && !refused_at_import(scope, written, key) then
        a.fault(scope, span, out_of_reach(a, key))
        return Unknown

    val decl = a.tables.types.get(key).unwrap()

    decl.kind match
        StructOf(d) -> instantiate_struct(a, scope, span, written, key, d, decl.scope, targs)
        EnumOf(d) -> instantiate_enum(a, scope, span, written, key, d, decl.scope, targs)
        TraitOf(d) -> instantiate_trait(a, scope, span, written, key, d, targs, buf())
        TypeOf(d) -> instantiate_named_subtype(a, scope, span, written, key, d, decl.scope, targs)
        CTypeOf(_) -> opaque_c_type(a, key)

// A `c type` block declares a name a C header owns: the compiler knows it is a type and nothing
// else about it, which is exactly an empty struct that never has its fields filled in.
private opaque_c_type(a: &Analysis, key: string) -> Type
    val already = a.tables.struct_insts.get(key)

    if already.is_some() then return already.unwrap()

    val made = Struct(StructType(key, buf(), buf(), false, None, None, false))

    a.tables.struct_insts.put(key, made)
    made
end opaque_c_type

// Whether the arity is right, and what to say when it is not.
private check_arity(a: &Analysis, scope: Scope, span: Span, written: string, tparams: Buf[string],
                    tdefaults: Buf[TypeBinding], targs: Buf[Type], noun: string = "type") -> bool
    val least = tparams.len() - tdefaults.len()

    if targs.len() >= least && targs.len() <= tparams.len() then return true

    a.fault(scope, span, s"$noun '$written' ${arity_phrase(tparams.len(), least)}, but " +
            s"${quantity(targs.len(), "type argument")} ${if targs.len() == 1 then "was" else "were"} given")
    false
end check_arity

// How an arity is described when it is wrong. Shared with the trait-arity check, which asks the same
// question of a trait's parameter list.
arity_phrase(most: usize, least: usize) -> string =
    if least == most then s"takes ${quantity(most, "type argument")}"
    else s"takes between $least and $most type arguments"

// `1 type argument`, `2 type arguments`.
quantity(n: usize, noun: string) -> string = s"$n $noun${if n == 1 then "" else "s"}"

// The bindings a declaration's parameters take from the arguments this instantiation was made with.
private bindings_for(tparams: Buf[string], targs: Buf[Type]) -> Buf[Binding]
    var out: Buf[Binding] = buf()

    for i in 0..<tparams.len()
        out.push(Binding(tparams.at(i), if i < targs.len() then targs.at(i) else Unknown))

    out
end bindings_for

// The arguments a declaration was applied to, with the ones it was not given taken from the defaults
// it declares.
//
// They are filled left to right, each resolved under the arguments already fixed, so a later default
// may name an earlier parameter and `[A, B = A]` means what it reads as. A default is written in the
// file that declares it, so it is resolved in **that** file's terms rather than the applying one's.
//
// **Nothing is answered where a default leads back to the declaration being filled**: that is
// reported (`default_cycle`), and the use has no type.
//
// **A value parameter's default is read as the argument it stands for**, at the type the declaration
// wrote for the parameter, so `Ring[int]` and `Ring[int, 4]` are one instantiation.
private filled_targs(a: &Analysis, scope: Scope, span: Span, key: string, home: Scope,
                     tparams: Buf[string], tdefaults: Buf[TypeBinding], tvalues: Buf[TypeBinding],
                     targs: Buf[Type]) -> Option[Buf[Type]]
    if targs.len() >= tparams.len() || tdefaults.is_empty() then return Some(targs)

    val mark = type_filling_mark(key)

    if holds_string(a.defaults_filling, mark)
        default_cycle(a, scope, span, key)
        return None
    end if

    a.defaults_filling.push(mark)

    var filled: Buf[Type] = buf()

    for targ in targs
        filled.push(targ)

    for i in filled.len()..<tparams.len()
        var here: Buf[Binding] = buf()

        for j in 0..<filled.len()
            here.push(Binding(tparams.at(j), filled.at(j)))

        val w = binding_named(tdefaults, tparams.at(i))
        val declared = binding_named(tvalues, tparams.at(i))

        if w.is_none() || declared.is_none()
            filled.push(if w.is_none() then Unknown else resolve_type(a, home, w.unwrap(), here))
            continue
        end if

        val v = default_value(a, home, w.unwrap().span, tparams.at(i), w.unwrap(),
                              resolve_type(a, home, declared.unwrap(), no_bindings()), here)

        filled.push(if v.is_some() then v.unwrap() else Unknown)

    a.defaults_filling.truncate(a.defaults_filling.len() - 1)
    Some(filled)
end filled_targs

// Holds the arguments a generic **type** was applied to -- the ones a default filled included -- to
// what the declaration asked of its parameters, now if that can be answered and once every `impl`
// is registered if it cannot.
//
// A bound is resolved in the declaration's terms and the refusal belongs to the file that wrote the
// application. **Only a settled argument list is asked**, and a type parameter standing in for itself
// is settled: it promises exactly what its own bounds say, so `keep[T](x: T) -> Scored[T]` over a
// `Scored[T: Rank]` is refused where it is written -- the caller has to ask at least what the type
// asks. A type merely built over one (`Scored[Box[T]]`) is left to the body that is read at a type.
//
// **A type made real at no written place is not asked** -- `reinstantiate` substituting through a
// type already resolved, whose application was held to these bounds where it was written. Asked again
// there, the refusal lands at the top of the file and says one mistake twice.
//
// **Nor is an application inside the fields of an instantiation whose own arguments failed**
// (`Analysis.quiet_bounds`): `struct T2[D] { cb: *L[D] }` over `struct L[D: Dr] { next: *L[D] }` is
// refused at T2's field, and laying out `L` at T2's unbounded `D` meets `*L[D]` again at L's own
// field -- where `D` IS bounded, so a refusal there blames a declaration that is right. Such an
// application is still asked, quietly, since whether IT failed decides the same for its own fields.
//
// Answers whether the arguments were refused now, and where the check was held instead, its place
// in the held list -- the two things the fields of this instantiation are laid out under.
private applied_bounds(a: &Analysis, scope: Scope, span: Span, key: string, home: Scope,
                       tparams: Buf[string], bounds: Buf[NamedBounds],
                       targs: Buf[Type]) -> (bool, Option[usize])
    if bounds.is_empty() || tparams.len() != targs.len() then return (false, None)
    if span.start == 0 && span.end == 0 then return (false, None)

    for targ in targs
        if targ == Unknown then return (false, None)

        targ match
            Abstract(_, _) -> ()
            other -> if mentions_abstract(other) then return (false, None)

    if a.tables.members.hoisted
        val met = check_param_bounds(a, home, span, key, tparams, bounds, targs, buf(),
                                     "type parameter", scope, a.quiet_bounds)

        return (!met, None)
    end if

    val at = a.tables.members.deferred.len()

    a.tables.members.deferred.push(DeferredBound(key, tparams, bounds, targs, span, home, scope,
                                                 "type parameter", a.bound_after))
    (false, Some(at))
end applied_bounds

// Lays out an instantiation's fields under what its own check answered (`applied_bounds`).
private enter_fields(a: &Analysis, checked: (bool, Option[usize])) -> (bool, Option[usize])
    val outer = (a.quiet_bounds, a.bound_after)

    a.quiet_bounds = checked.0
    a.bound_after = checked.1
    outer
end enter_fields

private leave_fields(a: &Analysis, outer: (bool, Option[usize]))
    a.quiet_bounds = outer.0
    a.bound_after = outer.1

// A struct at these arguments.
//
// **The record is registered before its fields are resolved**, so a declaration that mentions itself
// finds the record already there rather than recursing for ever.
instantiate_struct(a: &Analysis, scope: Scope, span: Span, written: string, key: string,
                   d: StructDecl, home: Scope, written_targs: Buf[Type]) -> Type
    if !check_arity(a, scope, span, qualified_name(key), d.tparams, d.tdefaults, written_targs) then
        return Unknown

    val fill = filled_targs(a, scope, span, key, home, d.tparams, d.tdefaults, d.tvalues, written_targs)

    if fill.is_none() then return Unknown

    // Made nameless before anything is keyed on it: `Buf[Size]` over a measured `c type` of `u64`
    // IS `Buf[u64]`, one instantiation with one layout and one set of bodies.
    val targs = nameless_all(fill.unwrap())

    val checked = applied_bounds(a, scope, span, key, home, d.tparams, d.bounds, targs)

    val inst = instance_key(key, targs)
    val already = a.tables.struct_insts.get(inst)

    if already.is_some() then return already.unwrap()

    val open = a.tables.in_progress.get(inst)

    if open.is_some()
        if cycle_check(a, scope, span, inst) then return Unknown

        return open.unwrap()

    // **`@align` is part of what the layout IS**, so it is folded here rather than left for whoever
    // asks the size: it is fixed while compiling and is part of what the module publishes.
    //
    // **So is the name a C header declares the aggregate under**, which is what `@export("...")` on
    // a struct chooses; where the attribute is written with no name of its own, the declaration's
    // bare name is what it chose.
    val made: &StructType = StructType(key, targs, buf(), d.packed,
                                       aligned_to(a, scope, span, written, d.alignment),
                                       exported_c_name(d), d.opaque)
    val ty = Struct(made)

    a.tables.in_progress.put(inst, ty)
    a.resolving.push((inst, a.indirection, a.type_arg_depth))

    val subst = bindings_for(d.tparams, targs)
    // An application inside these fields is asked quietly when the arguments were refused -- the
    // refusal is the arguments', made where they were written (see `applied_bounds`).
    val outer = enter_fields(a, checked)

    for f in d.fields
        made.fields.push((f.name, resolve_qualified(a, home, f.typ, subst)))

    leave_fields(a, outer)

    check_bitfields(a, scope, span, made)

    a.resolving.truncate(a.resolving.len() - 1)
    a.tables.in_progress.remove(inst)
    a.tables.struct_insts.put(inst, ty)
    ty
end instantiate_struct

// An enum at these arguments, by the same rule and for the same reason.
instantiate_enum(a: &Analysis, scope: Scope, span: Span, written: string, key: string, d: EnumDecl,
                 home: Scope, written_targs: Buf[Type]) -> Type
    if !check_arity(a, scope, span, qualified_name(key), d.tparams, d.tdefaults, written_targs) then
        return Unknown

    val fill = filled_targs(a, scope, span, key, home, d.tparams, d.tdefaults, d.tvalues, written_targs)

    if fill.is_none() then return Unknown

    // The same, for the same reason.
    val targs = nameless_all(fill.unwrap())

    val checked = applied_bounds(a, scope, span, key, home, d.tparams, d.bounds, targs)

    val inst = instance_key(key, targs)
    val already = a.tables.enum_insts.get(inst)

    if already.is_some() then return already.unwrap()

    val open = a.tables.in_progress.get(inst)

    if open.is_some()
        if cycle_check(a, scope, span, inst) then return Unknown

        return open.unwrap()

    var simple = true

    for item in d.variants
        if !item.fields.is_empty() then simple = false

    // Whether this is the first instantiation of the declaration, which is what the complaints about
    // what was WRITTEN are held against: a discriminant is an integer in the source and no type
    // argument reaches it, so `Pair[int]` and `Pair[bool]` would otherwise say the same thing twice
    // about one line.
    val first = !a.tables.enum_tags_seen.has(key)

    a.tables.enum_tags_seen.put(key, true)

    var underlying = d.underlying match
        Some(t) -> resolve_type(a, home, t, no_bindings())
        None -> int_type()

    // A pinned underlying type is the storage the discriminants are laid in, so it has to be one
    // they can be laid in. A generic enum is turned away before this, at its declaration, since it
    // is never instantiated when nothing names it and the mistake is in the declaration either way.
    if d.underlying.is_some() && d.tparams.is_empty() && first
        if !simple
            a.fault(scope, span, s"only a simple enum has an underlying integer type — " +
                    s"'${d.name}' carries data")
        else
            underlying match
                Integer(_, _, _) -> ()
                _ ->
                    a.fault(scope, span, s"an enum's underlying type must be an integer, not " +
                            type_show(underlying))
                    underlying = int_type()
    end if

    val made: &EnumType = EnumType(key, targs, simple, buf(), underlying)
    val ty = Enum(made)

    a.tables.in_progress.put(inst, ty)
    a.resolving.push((inst, a.indirection, a.type_arg_depth))

    val subst = bindings_for(d.tparams, targs)

    // **A simple enum's tag is its discriminant, which is the value the program wrote.** A data
    // enum's is its position, since nothing may name one. So the two are assigned by different
    // rules, and only the first of them reads what was written after the `=`.
    val cx = analyzer_for(a, home)
    var next_tag = 0

    for v in d.variants
        var fields: Buf[(string, Type)] = buf()

        // Quiet where the arguments were refused, as a struct's fields are.
        val outer = enter_fields(a, checked)

        for j in 0..<v.fields.len()
            fields.push((v.fields.at(j).name, resolve_type(a, home, v.fields.at(j).typ, subst)))

        leave_fields(a, outer)

        var tag = next_tag

        if simple
            v.value match
                // A discriminant is any compile-time integer, so a negative one under a signed
                // underlying type folds from the unary negation the parser gives, and a `const` may
                // stand where a literal does.
                Some(written_value) ->
                    val refusals = a.const_refusals

                    const_int(cx, written_value) match
                        Some(n) -> tag = fitting_tag(a, scope, span, v.name, n, underlying, first)
                        None ->
                            // A constant whose own fold refused has been told once, where the
                            // mistake is; a variant reading it is not a second mistake.
                            if first && !const_refused_since(a, refusals) then
                                a.fault(scope, span,
                                        s"the value of variant '${v.name}' must be a constant integer")
                None -> tag = fitting_tag(a, scope, span, v.name, from_int(long(next_tag)),
                                          underlying, first)
        else if v.value.is_some() && first
            a.fault(scope, span,
                    s"variant '${v.name}' carries data, so it cannot also have an explicit value")

        next_tag = tag + 1
        made.variants.push(EnumVariant(v.name, tag, fields, !v.fields.is_empty()))

    // A simple enum's value *is* its identity -- there is nothing else to tell two variants apart --
    // so two names for one value leave the language unable to keep its own promises: the second
    // variant's `match` arm can never run, and the lowering becomes a switch with a repeated case
    // the assembler rejects outright. A data enum cannot reach this, since its tags are assigned in
    // order and it refuses an explicit value.
    if simple && first then refuse_repeated_tags(a, scope, span, made.variants)

    a.resolving.truncate(a.resolving.len() - 1)
    a.tables.in_progress.remove(inst)
    a.tables.enum_insts.put(inst, ty)

    for item in made.variants
        a.tables.variant_names.put(item.name, true)

    ty
end instantiate_enum

// One discriminant, checked against the storage the `: iN` annotation pinned -- which is the whole
// point of pinning it.
private fitting_tag(a: &Analysis, scope: Scope, span: Span, name: string, n: BigInt,
                    underlying: Type, report: bool) -> int
    underlying match
        Integer(bits, signed, _) ->
            if !fits(n, bits, signed) && report
                a.fault(scope, span, s"discriminant ${to_string(n)} of variant '$name' does not " +
                        s"fit ${type_show(underlying)}")
        _ -> ()

    int(n.to_long().unwrap_or(0))
end fitting_tag

private refuse_repeated_tags(a: &Analysis, scope: Scope, span: Span, variants: Buf[EnumVariant])
    for i in 0..<variants.len()
        for j in 0..<i
            if variants.at(j).tag == variants.at(i).tag
                a.fault(scope, span,
                        s"variants '${variants.at(j).name}' and '${variants.at(i).name}' both " +
                        s"stand for ${variants.at(i).tag}, and a simple enum's values are the " +
                        "whole of what tells its variants apart — a second name for one value is " +
                        "a 'const'")
                return
end refuse_repeated_tags

// The boundary a struct asked to begin on, where it asked for one. A boundary is a power of two,
// since an address is aligned by having low bits clear, and it has to be settled while compiling.
// **A `@packed` struct with a field narrower than a byte IS one integer**, its fields ranges of it,
// so every field has to be an integer too -- a pointer, a float or a `bool` (an `i1` whose storage
// is a byte) has no bit range to occupy. Nesting is the answer and costs nothing: an outer `@packed`
// struct lays a bitfield struct out as an ordinary field of its size. A struct one of whose fields
// did not resolve has been complained about already, and is left alone.
private check_bitfields(a: &Analysis, scope: Scope, span: Span, s: &StructType)
    if !s.packed then return

    val stored = s.stored()
    var narrow = false

    for item in stored
        if underlying(item.1) == Unknown then return

        bitfield_width(item.1) match
            Some(w) -> if w % 8 != 0 then narrow = true
            None -> ()

    if !narrow then return

    val name = type_show(Struct(s))

    for item in stored
        if bitfield_width(item.1).is_none()
            val shown = type_show(item.1)

            a.fault(scope, span, s"'$name.${item.0}' is $shown, and '$name' is '@packed' with a " +
                    "field narrower than a byte — so it is one integer, and every field of it has to be " +
                    "one too. Put the narrow fields in a '@packed' struct of their own and hold that " +
                    s"here: it lays out identically and leaves $shown what it is")
end check_bitfields

private aligned_to(a: &Analysis, scope: Scope, span: Span, written: string,
                   asked: Option[Expr]) -> Option[usize]
    if asked.is_none() then return None

    val cx = analyzer_for(a, scope)

    const_int(cx, asked.unwrap()) match
        None ->
            a.fault(scope, span, s"'@align' on '$written' needs a constant — a literal, a 'const', " +
                    "or the arithmetic over them. A layout is fixed while compiling and is part of " +
                    "what this module publishes, so it cannot wait on a value")
            None
        Some(n) ->
            val bytes = n.to_long().unwrap_or(0)

            if bytes <= 0 || !is_power_of_two(bytes)
                a.fault(scope, span, s"'@align(${to_string(n)})' on '$written' is not an " +
                        "alignment — a boundary is a power of two, since an address is aligned by " +
                        "having low bits clear")
                return None

            Some(usize(bytes))
end aligned_to

private is_power_of_two(n: long) -> bool
    var v = n

    while v > 1
        if v % 2 != 0 then return false

        v /= 2

    v == 1
end is_power_of_two

// A trait used as a type.
private instantiate_trait(a: &Analysis, scope: Scope, span: Span, written: string, key: string,
                          d: TraitDecl, targs: Buf[Type], named: Buf[(string, Type)]) -> Type
    // **An argument on a trait may bind an associated type rather than a parameter.** A trait with
    // no parameters and one associated type has only one thing a bare argument could mean, so
    // `Iterate[char]` and `Iterate[Item = char]` are one type -- which is why a trait with associated
    // types is not told it takes no arguments.
    if d.tparams.is_empty() && !targs.is_empty() then
        if d.assocs.is_empty() then
            a.fault(scope, span, s"trait '$written' does not take type arguments")
            return Unknown

        return Trait(key, buf(), joined_assocs(assoc_bindings(d, targs), named))

    if !d.tparams.is_empty() then
        if !check_arity(a, scope, span, written, d.tparams, d.tdefaults, targs, "trait") then
            return Unknown

    // **What the use leaves out the trait supplies**, exactly as it does at a bound or an `impl` --
    // so `&Sink` over `trait Sink[T = int]` is `&Sink[int]`, one type under either spelling. The one
    // default that cannot be taken is one naming `Self`.
    object_defaults(a, scope, span, key, d, targs.len())

    val args = trait_args_with_defaults(a, scope, span, key, d, targs, buf())

    check_trait_arg_bounds(a, scope, span, key, d, args)
    Trait(key, args, named)
end instantiate_trait

// A trait written behind a mode: the object it forms, its brackets read as the object reads them.
//
// **The one unambiguous case is written without the name**, and it is the common one: a trait with
// no parameters of its own and exactly one associated type has only one thing a bare argument could
// mean, so `*Iterate[string]` is `*Iterate[Item = string]`. Where the trait has parameters too, a
// bare argument means one of *those* and the associated type has to be named.
private object_of(a: &Analysis, scope: Scope, span: Span, written: string, key: string, d: TraitDecl,
                  targs: Buf[Type], named: Buf[(string, Type)], sigil: string) -> Type
    val declared = object_assocs(a, key)
    val sugared = d.tparams.is_empty() && declared.len() == 1 && named.is_empty() && targs.len() == 1

    if sugared
        var fixed: Buf[(string, Type)] = buf()

        fixed.push((declared.at(0).name, targs.at(0)))
        return checked_object(a, scope, span, written, key, d, buf(), fixed, declared, sigil)
    end if

    // **A bare argument too many, on a trait that declares associated types.** The arity refusal is
    // right about the count and says the wrong thing about the cause -- this trait has something
    // open that is simply not fixed by position.
    if !declared.is_empty() && targs.len() > d.tparams.len()
        a.fault(scope, span, too_many_bare(key, d, declared, targs.len(), sigil))
        return Unknown

    checked_object(a, scope, span, written, key, d, targs, named, declared, sigil)
end object_of

private checked_object(a: &Analysis, scope: Scope, span: Span, written: string, key: string,
                       d: TraitDecl, targs: Buf[Type], fixed: Buf[(string, Type)],
                       declared: Buf[AssocDecl], sigil: string) -> Type
    val made = instantiate_trait(a, scope, span, written, key, d, targs, fixed)

    // A refused binding is no object, as a refused erasure is not.
    made match
        Trait(_, args, _) ->
            if check_assoc_args(a, scope, span, key, declared, fixed, sigil, args) then return Unknown
        _ -> ()

    made
end checked_object

private too_many_bare(key: string, d: TraitDecl, declared: Buf[AssocDecl], given: usize,
                     sigil: string) -> string
    val shown = qualified_name(key)
    var fixes: Buf[string] = buf()
    var whole: Buf[string] = buf()
    var quoted: Buf[string] = buf()

    for i in 0..<d.tparams.len()
        whole.push("…")

    for item in declared
        val n = item.name

        fixes.push(s"$n = …")
        whole.push(s"$n = …")
        quoted.push(s"'$n'")

    val owns = if d.tparams.is_empty() then s"'$shown' takes no type arguments of its own"
    else s"'$shown' takes ${quantity(d.tparams.len(), "type argument")} of its own"

    // Why the short form did not apply, and there are two reasons: more than one thing is open, or
    // exactly one is and the count is wrong -- and a reader in the second case has the form right.
    var why = "A bare argument is the short form only for a trait with no parameters of its own and " +
              "exactly one associated type, so here it would not say which"

    if d.tparams.is_empty() && declared.len() == 1
        why = s"One bare argument is the short form for '${joined(fixes, ", ")}', and " +
              s"${quantity(given, "argument")} ${if given == 1 then "is" else "are"} not"

    val what = if declared.len() == 1 then "the associated type" else "the associated types"

    s"$owns, and what it leaves for an object to fix is $what ${joined(quoted, ", ")} — an object " +
    s"fixes one by name, so write '$sigil$shown[${joined(whole, ", ")}]'. $why"
end too_many_bare

private joined_assocs(a: Buf[(string, Type)], b: Buf[(string, Type)]) -> Buf[(string, Type)]
    var out: Buf[(string, Type)] = buf()

    for item in a
        out.push(item)

    for item in b
        out.push(item)

    out
end joined_assocs

// What arguments written on a trait with associated types bind: a named one binds the associated
// type it names, and a bare one binds the trait's only associated type.
private assoc_bindings(d: TraitDecl, targs: Buf[Type]) -> Buf[(string, Type)]
    var out: Buf[(string, Type)] = buf()

    for i in 0..<targs.len()
        val name = if i < d.assocs.len() then d.assocs.at(i).name else ""

        out.push((name, targs.at(i)))

    out
end assoc_bindings

// A named subtype: a constrained type where it narrows anything, and another spelling of its base
// where it does not.
//
// **Following one has to terminate**, so the chain is walked with the names already entered kept: a
// name that leads back to itself is refused where it is declared rather than followed until the
// stack runs out.
instantiate_named_subtype(a: &Analysis, scope: Scope, span: Span, written: string, key: string,
                          d: TypeDecl, home: Scope, targs: Buf[Type]) -> Type
    if !d.tp.names.is_empty() then return instantiate_generic_alias(a, scope, span, key, d, home, targs)

    if !targs.is_empty() then
        a.fault(scope, span, s"'$written' is ${if is_plain_alias(d) then "an alias" else "a constrained subtype"} " +
                "and takes no type arguments")
        return Unknown

    val already = a.tables.constrained_insts.get(key)

    if already.is_some() then return already.unwrap()

    // Entered before the base is resolved, so a chain that leads back here finds the mark rather
    // than the answer. **The mark lets ONE reading back in**: an alias of a pointer to a struct
    // (`type Callback = &Fn(*Loop) -> unit`) makes the struct real while its base is followed, and
    // that struct's own fields may name the alias again (`idles: Slots[Callback]`) -- refused there,
    // the field would keep `Unknown` for good. The second reading finds the struct already in
    // progress and finishes; only a chain that comes round a third time is one that would not end.
    a.tables.broken.get(key) match
        Some(first) ->
            if !first then return Unknown

            a.tables.broken.put(key, false)
        None -> a.tables.broken.put(key, true)

    val base = resolve_type(a, home, d.base, no_bindings())

    if type_eq(base, Unknown) then return Unknown

    // A range, a predicate or a `new` makes a type that is checked or told apart by value, and only a
    // scalar has a value of that kind. A measured `c type` is a typedef whose width C chose, not a
    // narrowing, so it is not asked.
    val at = declared_at(a, key, span)

    if (d.derived || d.range.is_some() || d.pred.is_some()) && !d.from_c && !scalar_base(base)
        a.fault(home, at, "a constrained subtype's base must be an integer, a float, or 'char', not " +
                type_show(base))
        return Unknown
    end if

    // `wrapping` changes what the operators do, so it makes a type of its own -- an alias that
    // wrapped would be the same values as its base computing differently -- and only a fixed-point
    // base saturates to begin with.
    if d.wrapping.is_some()
        val word = d.wrapping.unwrap()

        if !d.derived
            a.fault(home, word, "'wrapping' changes what the operators do, so it makes a type of its own " +
                    s"— write 'type ${d.name} = new ${type_show(base)} wrapping'")
            return Unknown
        end if

        if !is_fixed(base)
            a.fault(home, word, "'wrapping' asks a fixed-point type to wrap rather than saturate, and " +
                    s"${type_show(base)} is not fixed-point")
            return Unknown
        end if
    end if

    var made = base

    // **WHAT THE DECLARATION NARROWED IS PART OF THE TYPE.** `type Age = int within 0..150` is not
    // an `int` wearing a name: its ends are what `Age::Min` and `Age::Max` answer, what `Age::Valid`
    // asks about, and what a literal standing at it is held to. Left off, every one of those reads
    // the base's range and says nothing about the type the reader declared.
    var lo: Option[RangeEnd] = None
    var hi: Option[RangeEnd] = None
    var exclusive = false

    if d.range.is_some()
        val r = d.range.unwrap()

        if bounds_hold(a, home, at, d.name, base, r)
            lo = range_end(a, home, r.lo)
            hi = range_end(a, home, r.hi)
            exclusive = r.exclusive_hi
        end if
    end if

    // A `where` predicate narrows the type without saying where to, which is why the ends are not
    // readable off such a declaration. What is recorded is the function the condition lowered to,
    // which is what a conversion into the type calls to test a value.
    val pred = if d.pred.is_none() then None else Some(pred_key(key))

    // An exported name with no constraint is the one shape that may stand for more than a number:
    // what it asks for is a `typedef`, and C writes one for a pointer as readily as for an integer.
    // Anything C cannot spell that way is refused here, under the export's reading.
    if is_exported_alias(d) && !typedefable(base) then
        a.fault(home, d.cname.unwrap().span,
                s"'${qualified_name(key)}' is exported to a C header as ${type_show(base)}, which C " +
                "has no way to spell as a typedef — a header names an integer, a float, 'bool', " +
                s"'char' or a pointer this way. ${typedef_advice(base)}")

    // Written bare, `@export` gives the header the declared name, as it does a struct's.
    val cname = d.cname match
        Some(e) -> Some(e.symbol.unwrap_or(module_bare(spelled_key(key))))
        None -> None

    if !is_plain_alias(d) then
        made = constrained_exported(key, base, d.derived, lo, hi, exclusive, pred, cname,
                                    d.wrapping.is_some())

    a.tables.constrained_insts.put(key, made)

    // **The mark comes off with the answer in place**, so a reading after a trial that rewound
    // `constrained_insts` (and not `broken`) starts afresh rather than finding a stale mark.
    a.tables.broken.remove(key)
    made
end instantiate_named_subtype

// A generic alias at these arguments: **its right-hand side with the arguments put in**, and nothing
// else. `Callback[Board]` over `type Callback[D] = &Fn(*Loop[D]) -> unit` IS `&Fn(*Loop[Board]) ->
// unit` -- one type, one instantiation of `Loop`, one mangled name -- so no nominal type is made here
// and the answer is filed only so that a second application is not read twice.
//
// The arity, the defaults and the bounds are a generic struct's, by the same functions, so a wrong
// count and an argument that misses a bound are refused in the words a struct's are. A declaration
// that is not a transparent alias, or that takes a pack, was refused where it was declared
// (`read_generic_alias`), and applying one answers nothing more.
//
// **Following one has to terminate** by the plain alias's rule: the mark is keyed on the application,
// so `type L[T] = Option[L[T]]` comes round to `L[T]` again and is refused rather than unrolled.
private instantiate_generic_alias(a: &Analysis, scope: Scope, span: Span, key: string, d: TypeDecl,
                                  home: Scope, written_targs: Buf[Type]) -> Type
    if !is_plain_alias(d) || !d.tp.packs.is_empty() then return Unknown

    if !check_arity(a, scope, span, qualified_name(key), d.tp.names, d.tp.defaults, written_targs,
                    "alias") then
        return Unknown

    val fill = filled_targs(a, scope, span, key, home, d.tp.names, d.tp.defaults, d.tp.values,
                            written_targs)

    if fill.is_none() then return Unknown

    val targs = fill.unwrap()

    val checked = applied_bounds(a, scope, span, key, home, d.tp.names, d.tp.bounds, targs)

    val inst = instance_key(key, targs)
    val already = a.tables.constrained_insts.get(inst)

    if already.is_some() then return already.unwrap()

    a.tables.broken.get(inst) match
        Some(first) ->
            if !first
                a.fault(home, declared_at(a, key, span),
                        s"'${d.name}' is an alias for itself, through a chain of aliases")
                return Unknown
            end if

            a.tables.broken.put(inst, false)
        None -> a.tables.broken.put(inst, true)

    // Read quietly where the arguments were refused, as a struct's fields are (`applied_bounds`).
    val outer = enter_fields(a, checked)
    val made = resolve_type(a, home, d.base, bindings_for(d.tp.names, targs))

    leave_fields(a, outer)
    a.tables.broken.remove(inst)

    if type_eq(made, Unknown) then return Unknown

    a.tables.constrained_insts.put(inst, made)
    made
end instantiate_generic_alias

// The number a written range end stands for, where it settles at all. A `within` may be written over
// floats as well as integers, so a decimal literal is read as the text it is -- `0.1` the decimal
// written rather than the double nearest it -- and everything else is folded.
private range_end(a: &Analysis, scope: Scope, e: Expr) -> Option[RangeEnd]
    val written = literal_end(e)

    if written.is_some() then return written

    val cx = analyzer_for(a, scope)
    val mark = a.complaints()
    val folded = const_fold(cx, e)

    a.restore_complaints(mark)

    // A `char` range is a range over code points, so its ends are the numbers the characters are.
    folded match
        Some(ConstInt(n)) -> Some(EndAt(decimal_of(n, 0)))
        Some(ConstChar(c)) -> Some(EndAt(decimal_of(from_int(long(u32(c))), 0)))
        Some(ConstFloat(f)) -> float_end(f)
        _ -> None
end range_end

// A float literal's text, or the negation of one (`-0.5` is not a literal), where the text is a plain
// decimal; one with an exponent is left to the fold.
private literal_end(e: Expr) -> Option[RangeEnd]
    val parsed = *e.kind match
        FloatLit(text, _) -> decimal_parse(text)
        Unary(op, operand) -> *operand.kind match
            FloatLit(text, _) -> if op == "-" then decimal_parse(text).map((d) -> -d) else None
            _ -> None
        _ -> None

    parsed match
        Some(d) -> Some(EndAt(d))
        None -> None
end literal_end

// A folded float as a range end. An infinity is one of the two infinite ends; a finite value is the
// decimal it is -- its short spelling where that reads back as the same double, and otherwise its
// exact binary expansion, since every double is a finite decimal. A NaN is no end at all, and
// `bound_holds` has refused one before this is asked.
private float_end(f: real) -> Option[RangeEnd]
    if f != f then return None
    // `f - f` is a NaN exactly where `f` is infinite.
    if f - f != f - f then return Some(EndInfinite(f < 0.0))

    val text = str(f)
    val short = decimal_parse(text)
    val back = parse_real(text)

    if short.is_some() && back.is_ok() && back.unwrap() == f then return Some(EndAt(short.unwrap()))

    Some(EndAt(exact_decimal(f)))
end float_end

// The decimal a finite double is exactly: its significand times a power of two, and `2^-k` is
// `5^k / 10^k`, so a power of ten always reaches it.
private exact_decimal(f: real) -> Decimal
    val bits = signed_bits(f.bits())
    val biased = (bits >> 52) & 0x7FF
    val fraction = bits & 0xFFFFFFFFFFFFF
    val significand = if biased == 0 then fraction else fraction | (long(1) << 52)
    // A subnormal's exponent is the smallest normal one's; only the implicit leading bit differs.
    val power = if biased == 0 then long(1) else biased
    val e = power - 1075
    val signed = if bits < 0 then big_negate(from_int(significand)) else from_int(significand)

    if e >= 0 then return decimal_of(big_mul(signed, big_pow(from_int(2), usize(e))), 0)

    decimal_of(big_mul(signed, big_pow(from_int(5), usize(-e))), int(-e))
end exact_decimal

// Where a declared type was written, the whole declaration being what a refusal of it points at.
private declared_at(a: &Analysis, key: string, fallback: Span) -> Span = a.tables.types.get(key) match
    Some(decl) -> decl.span
    None -> fallback

// The bases a subtype may narrow or derive from.
private scalar_base(t: Type) -> bool = underlying(t) match
    Integer(_, _, _) -> true
    Floating(_, _) -> true
    Fixed(_, _, _) -> true
    Char -> true
    _ -> false

// **A `within` is checked where it is declared, one complaint to a declaration**: each end is a
// constant, of the kind the base counts in, and inside the base's range, the lower end first; then
// the two are in order. A bound is a constant expression rather than a literal
// (`reference/errors.md § Ranges`), so what is refused is a bound that does not fold -- and a name
// that does not is named, being the commonest way to write one.
private bounds_hold(a: &Analysis, scope: Scope, at: Span, name: string, base: Type,
                    r: RangeBound) -> bool
    if !bound_holds(a, scope, at, base, r.lo) then return false
    if !bound_holds(a, scope, at, base, r.hi) then return false

    val lo = range_end(a, scope, r.lo)
    val hi = range_end(a, scope, r.hi)

    if lo.is_none() || hi.is_none() then return true

    val order = end_cmp(lo.unwrap(), hi.unwrap())

    if order > 0 || (r.exclusive_hi && order >= 0)
        a.fault(scope, at, s"the lower bound of '$name' is above its upper bound")
        return false
    end if

    true
end bounds_hold

private bound_holds(a: &Analysis, scope: Scope, at: Span, base: Type, e: Expr) -> bool
    val cx = analyzer_for(a, scope)
    val mark = a.complaints()
    val refusals = a.const_refusals
    val folded = const_fold(cx, e)

    // A fold that refused -- `1/0` -- said so at the sub-expression that stopped it, which is the
    // mistake; that it is then not a constant is no second one.
    if folded.is_none() && const_refused_since(a, refusals) then return false

    a.restore_complaints(mark)

    if folded.is_none()
        val what = *e.kind match
            Ident(n) -> s"'$n'"
            _ -> "that"

        a.fault(scope, at, s"a 'within' bound has to be a constant, and $what is not one — a " +
                "literal, a 'const', or an expression over them")
        return false
    end if

    val value = folded.unwrap()
    val b = underlying(base)

    // A float is "a floating-point literal" here whether or not it was written as one, since the
    // kind is what is wrong rather than the spelling.
    val kind = value match
        ConstFloat(_) -> "a floating-point literal"
        _ -> const_kind(value)

    val wanted = b match
        Integer(_, _, _) -> value match
            ConstInt(_) -> None
            _ -> Some("an integer subtype needs integer bounds")
        Floating(_, _) -> value match
            ConstInt(_) -> None
            ConstFloat(_) -> None
            _ -> Some("a floating-point subtype needs numeric bounds")
        Fixed(_, _, _) -> value match
            ConstInt(_) -> None
            ConstFloat(_) -> None
            _ -> Some("a fixed-point subtype needs numeric bounds")
        _ -> value match
            ConstChar(_) -> None
            _ -> Some("a 'char' subtype needs character bounds")

    if wanted.is_some()
        a.fault(scope, at, s"${wanted.unwrap()}, not $kind")
        return false
    end if

    // **An infinity is an end and a NaN is not**: `0.0..infinity` is open above and still refuses a
    // NaN, but every comparison with a NaN is false, so a range ending at one would admit nothing.
    value match
        ConstFloat(f) if f != f ->
            a.fault(scope, at, "a 'within' bound may not be NaN — every comparison with one is " +
                    "false, so a range ending at a NaN admits no value")
            return false
        _ -> ()

    value match
        ConstInt(n) -> b match
            Integer(bits, signed, _) ->
                if !fits(n, bits, signed)
                    a.fault(scope, at, s"the bound ${to_string(n)} does not fit ${type_show(b)}")
                    return false
                end if
            Fixed(bits, frac, signed) ->
                if !fixed_raw_fits(fixed_raw_of(n, 0, frac, FixNearestEven), bits, signed)
                    a.fault(scope, at, s"the bound ${to_string(n)} does not fit ${type_show(b)}")
                    return false
                end if
            _ -> ()
        ConstFloat(f) -> b match
            Fixed(bits, frac, signed) ->
                val raw = fixed_raw_of_double(real_bits(f), frac)

                if raw.is_none() || !fixed_raw_fits(raw.unwrap(), bits, signed)
                    a.fault(scope, at, s"the bound ${str(f)} does not fit ${type_show(b)}")
                    return false
                end if
            _ -> ()
        _ -> ()

    true
end bound_holds

// **Every constant declared at a constrained type holds a value its range admits**, settled while
// compiling -- a constant has no run time to be checked at. It is what makes a range on a constant
// worth writing: a `c const` measured from a header is a number nobody chose, so a range on the type
// it is read into is a claim about the configuration the program was built against. A `new` type
// and a `where` predicate are refused at the declaration (`check_const_named`) and are passed over.
//
// **Every constant is folded where it is declared, used or not** -- a constant is its value, so a
// value that does not fold, does not fit, or is of another kind is a mistake in the declaration and
// not in whichever use happens to read it first. The declared type is asked first: an aggregate is
// storage and is pointed at `val`, which is the answer a reader needs rather than a claim about
// constancy.
check_const_admits(a: &Analysis)
    for i in 0..<a.tables.consts.len()
        val v = a.tables.consts.at(i)
        val key = a.tables.consts.key_at(i)

        if v.typ.is_none() || v.init.is_none() then continue

        val t = resolve_type(a, v.scope, v.typ.unwrap(), no_bindings())

        if const_type_refused(a, v, t) then continue

        // A block under the `=` has statements to run, and a constant is a value with nowhere to run
        // them. A lone expression on the next line never became a block, so it still folds.
        if *v.init.unwrap().kind is Block(_)
            a.fault(v.scope, v.init.unwrap().span, s"'${v.name}' is a 'const', so its value is folded into " +
                    "every use of it — a block is run, and there is nowhere here for it to run. Write a " +
                    "'val', whose initializer is code")
            continue
        end if

        val cx = analyzer_for(a, v.scope)
        val mark = a.complaints()
        val refusals = a.const_refusals

        a.consts_in_progress.push(key)

        val folded = const_fold(cx, v.init.unwrap())

        a.consts_in_progress.truncate(a.consts_in_progress.len() - 1)

        // A fold that stopped at something it had to say -- a division by zero, a loop -- has said it,
        // and so has one that read a constant whose own fold refused: that complaint was made once,
        // where the mistake is, and saying this one would be the same mistake told twice.
        if folded.is_none()
            // A call to a function that is not `const` is told how it could have been one.
            if a.complaints() == mark && !const_refused_since(a, refusals) then
                a.fault(v.scope, anchor_of(v.init.unwrap()), s"the value of '${v.name}' is not a constant " +
                        s"expression${const_call_advice(cx, v.init.unwrap())}")

            continue
        end if

        t match
            Constrained(cd) ->
                if const_fits(a, v, folded.unwrap(), underlying(t)) then const_admitted(a, v, t, cd)
            _ -> const_fits(a, v, folded.unwrap(), t)
end check_const_admits

// Whether a constant's declared type is one it may not be, said where it is. A struct, an enum, a
// `new` type and a `where` predicate are told at the declaration by `check_const_named`, and are only
// passed over here.
private const_type_refused(a: &Analysis, v: ValueDecl, t: Type) -> bool
    val named = *v.typ.unwrap().kind match
        NamedType(_, _) -> true
        _ -> false

    val scalar = t match
        Integer(_, _, _) -> true
        Floating(_, _) -> true
        Bool -> true
        Char -> true
        Str -> true
        _ -> false

    if scalar then return false

    // A fixed-point constant would be folded through every arithmetic the fold knows, and that
    // arithmetic is the integers' and the reals' -- neither of which a fixed-point value has. The
    // `val` it is written as instead is constant data all the same.
    if is_fixed(t)
        a.fault(v.scope, v.span, s"a constant is folded as an integer or a real, and ${type_show(t)} " +
                s"is fixed-point — write '${v.name}' as a 'val', which is laid into the object file " +
                "as constant data")
        return true
    end if

    t match
        Constrained(cd) -> return cd.derived || cd.pred_fn.is_some()
        Unknown -> return true
        _ -> ()

    if named then return true

    val storage = t match
        Array(_, _) -> true
        Vector(_, _) -> true
        Struct(_) -> true
        _ -> false

    if storage then
        a.fault(v.scope, v.span, s"a constant is a scalar, and ${type_show(t)} is storage — write " +
                s"'${v.name}' as a 'val', which is laid into the object file as constant data")
    else
        a.fault(v.scope, v.span, s"a constant is a scalar, and ${type_show(t)} is not — '${v.name}'")

    true
end const_type_refused

// Whether a folded value is one the declared type holds, said at the VALUE where it is not -- the
// value is what does not fit, and it is where a refusal from inside the fold points too.
private const_fits(a: &Analysis, v: ValueDecl, value: Const, t: Type) -> bool
    val at = v.init.unwrap().span

    val kind_fits = value match
        ConstInt(_) -> t match
            Integer(_, _, _) -> true
            _ -> false
        ConstFloat(_) -> t match
            Floating(_, _) -> true
            _ -> false
        ConstBool(_) -> t match
            Bool -> true
            _ -> false
        ConstChar(_) -> t match
            Char -> true
            _ -> false
        ConstStr(_) -> t match
            Str -> true
            _ -> false

    if !kind_fits
        a.fault(v.scope, at, s"'${v.name}' is declared ${type_show(t)} but its value is " +
                const_kind(value))
        return false
    end if

    value match
        ConstInt(n) -> t match
            Integer(bits, signed, _) ->
                if !fits(n, bits, signed)
                    a.fault(v.scope, at, s"'${v.name}' does not fit ${type_show(t)}: ${to_string(n)}")
                    return false
                end if
            _ -> ()
        _ -> ()

    true
end const_fits

private const_admitted(a: &Analysis, v: ValueDecl, t: Type, cd: &ConstrainedType)
    if cd.derived || cd.pred_fn.is_some() || cd.lo.is_none() || cd.hi.is_none() then return

    val value = range_end(a, v.scope, v.init.unwrap())
    val lo = cd.lo.unwrap()
    val hi = cd.hi.unwrap()
    val top = if cd.exclusive_hi then s"under ${end_text(hi)}" else end_text(hi)
    val holds = s"it holds ${end_text(lo)} to $top"

    // A NaN is the one float no range admits, every comparison with it being false -- and the one
    // folded value that is no end of a range, so it is asked after on its own.
    if value.is_none()
        if folds_to_nan(a, v.scope, v.init.unwrap()) then
            a.fault(v.scope, v.init.unwrap().span,
                    s"'${v.name}' is nan, which ${type_show(t)} does not admit — $holds")
        return
    end if

    val n = value.unwrap()
    val above = end_cmp(n, lo) >= 0
    val under = if cd.exclusive_hi then end_cmp(n, hi) < 0 else end_cmp(n, hi) <= 0

    if !above || !under then
        a.fault(v.scope, v.init.unwrap().span,
                s"'${v.name}' is ${end_text(n)}, which ${type_show(t)} does not admit — $holds")
end const_admitted

// Whether a constant's initializer folds to a NaN.
private folds_to_nan(a: &Analysis, scope: Scope, e: Expr) -> bool
    val cx = analyzer_for(a, scope)
    val mark = a.complaints()
    val folded = const_fold(cx, e)

    a.restore_complaints(mark)

    folded match
        Some(ConstFloat(f)) -> f != f
        _ -> false
end folds_to_nan

// Whether a declaration is another spelling of its base rather than a type of its own.
//
// **A measured `c type` is written in exactly this shape and is not one.** It is a distinct scalar
// whose width came from the C compiler, so a signature naming it says `Tick` where a transparent
// alias would have said `uint` -- which is the whole point of writing one: the header owns the width
// and the program names the typedef.
//
// **Nor is an exported one**, for the same reason seen from the header's side: `@export` asks a
// generated header to spell the type by a name of its own, and a name that dissolved into its base
// here would leave nothing there to spell. It is built as a transparent type with no constraint,
// interchangeable with its base in both directions, as before.
is_plain_alias(d: TypeDecl) -> bool =
    !d.derived && d.range.is_none() && d.pred.is_none() && !d.from_c && d.cname.is_none() &&
        d.wrapping.is_none()

// Whether a declaration is an alias a C header is asked to declare as a `typedef`.
private is_exported_alias(d: TypeDecl) -> bool =
    d.cname.is_some() && !d.derived && d.range.is_none() && d.pred.is_none()

// The name a C header declares a struct under, where the declaration asked for one -- the symbol it
// wrote, or its own bare name where it named the attribute and nothing else.
private exported_c_name(d: StructDecl) -> Option[string] = d.cname match
    Some(e) -> e.symbol match
        Some(sym) -> Some(sym)
        None -> Some(module_bare(d.name))
    None -> None
