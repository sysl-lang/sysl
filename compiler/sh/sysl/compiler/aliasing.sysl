module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// What a struct's `invariant` clauses demand of the aliases a program makes.
//
// A clause is discharged by re-checking it at the write, and the write is found by walking outward
// through the **place** being written -- so the whole obligation rests on the place still naming the
// struct. A pointer is where that runs out: `&o.a` is a `*Inner`, and an `Inner` knows nothing of
// the `Outer` whose clause reads `a.n`, so a write through it breaks a promise nothing is left to
// check. No amount of checking at the write closes this; it is a rule about **what may be aliased**.
//
// The rule restricts alias *creation* rather than alias *use*, which is what keeps it a local,
// type-only question: an alias is safe when its type still carries every promise over the memory it
// can reach. Nothing here costs a program that declares no invariants anything -- every entry point
// answers with nothing before it looks at a clause.

// Whether a struct type carries clauses this machinery has to honour.
bears_invariants(a: &Analysis, base: string) -> bool
    val decl = a.tables.types.get(base)

    if decl.is_none() then return false

    decl.unwrap().kind match
        StructOf(d) -> !d.invariants.is_empty()
        _ -> false
end bears_invariants

// Whether an element reached by indexing a value of this type is on the far side of it -- a view's
// element, which has an identity of its own -- rather than storage the value holds, as an array's
// element is.
far_side(t: Type) -> bool = underlying(unqualified(t)) match
    Slice(_, _) -> true
    _ -> false

// The function a check of this struct calls -- the synthesised `<Struct>$inv`, made real at the
// struct's own type arguments where the struct is generic.
//
// **A generic struct's read rule is asked here rather than at its declaration**, because whether a
// clause reads through something the struct does not own depends on what the parameters are: a
// field of type `T` is the struct's own storage at `int` and a pointer's far side at `*Inner`. So
// each instantiation's field types are held to the rule a non-generic struct's are held to where it
// is declared, and the diagnostic is the same one, at the clause.
inv_fn_for(a: &Analysis, s: &StructType) -> string
    val key = inv_key(s.base)
    val decl = a.tables.types.get(s.base)

    if decl.is_none() then return key

    val home = decl.unwrap()

    home.kind match
        StructOf(d) ->
            if d.tparams.is_empty() then return key

            val f = a.tables.funcs.get(key)

            if f.is_none() then return key

            // The first ask registers the instantiation, which is what says it is the first.
            val known = a.tables.members.func_insts.len()
            val name = instantiate_func(a, f.unwrap().scope, f.unwrap().decl, s.targs, false)

            if a.tables.members.func_insts.len() > known then
                check_invariant_reads(a, home.scope, home.span, d, s)

            name
        _ -> key
end inv_fn_for

// The declaration a struct type was made from, where this compilation has one.
private struct_decl_of(a: &Analysis, base: string) -> Option[StructDecl]
    val decl = a.tables.types.get(base)

    if decl.is_none() then return None

    decl.unwrap().kind match
        StructOf(d) -> Some(d)
        _ -> None
end struct_decl_of

// The zero value a declaration with no initializer starts at, checked against every clause it holds
// (`reference/errors.md § Struct invariants`).
//
// **A zero is a construction the program did not spell**, and a struct whose clause the zero does not
// satisfy -- `invariant lo < hi` -- would otherwise begin its life broken with nothing having checked
// it. So each struct carrying clauses that lies inside the zero -- the type itself, a field of it, an
// element of an array -- is checked once, at its own zero. The check is of a constant and folds away
// wherever the zero satisfies it.
checked_zero(cx: &Analyzer, span: Span, ty: Type) -> TExpr
    var owes: Buf[&StructType] = buf()

    zero_owes(cx.an, ty, &owes)

    if owes.is_empty() then return TExpr(span, TZero(ty))

    var checks: Buf[TStmt] = buf()

    for s in owes
        val check = TExpr(span, TStructInvCheck(TExpr(span, TZero(Struct(s))), s, inv_fn_for(cx.an, s)))

        checks.push(TExprStmt(check))

    TExpr(span, TBlockExpr(TBlock(checks, Some(TExpr(span, TZero(ty))), ty)))
end checked_zero

// The structs carrying clauses a zero of this type holds, outermost first, each once.
private zero_owes(a: &Analysis, t: Type, out: *Buf[&StructType])
    unqualified(t) match
        Struct(s) ->
            if bears_invariants(a, s.base)
                var seen = false

                for item in out
                    if item.name() == s.name() then seen = true

                if !seen then out.push(s)

            for item in s.fields
                zero_owes(a, item.1, out)
        Array(n, e) -> if n > 0 then zero_owes(a, *e, out)
        _ -> ()

// Which enclosing structs an alias of this place would be typed **below**, each with the field path
// from that struct down to the place.
//
// The path is what makes the refusal answer about the clause rather than about the struct. It is
// spelled as a clause spells it, so an index step contributes no name and an element stands for its
// array -- `g.items[0]` and `g.items[1]` are one path, since a clause reading the first says nothing
// about which element a dynamic index would reach.
private severing(cx: &Analyzer, place: TExpr) -> Buf[(&StructType, Buf[string])]
    var out: Buf[(&StructType, Buf[string])] = buf()

    sever_walk(cx, place, buf(), &out)
    out
end severing

private sever_walk(cx: &Analyzer, e: TExpr, below: Buf[string],
                   out: *Buf[(&StructType, Buf[string])])
    val a = cx.an

    *e.kind match
        // A field is a *position* in the typed tree and a *name* in the clause, so the receiver's
        // type is what turns one into the other. Anything else under a field step is storage this
        // walk cannot spell, and it stops rather than guessing at a path.
        TField(recv, i, _) ->
            texpr_type(recv) match
                Struct(d) ->
                    if i < int(d.fields.len())
                        var path: Buf[string] = buf()

                        path.push(d.fields.at(usize(i)).0)

                        for item in below
                            path.push(item)

                        if bears_invariants(a, d.base) then out.push((d, path))

                        sever_walk(cx, recv, path, out)
                _ -> ()
        // An alias of a view's element is an alias of the far side, which no struct holding the view
        // owns -- `&b.elems[0]` names storage no clause may read, so it is below no promise.
        TIndex(recv, _, _) -> if !far_side(texpr_type(recv)) then sever_walk(cx, recv, below, out)

        // A `ref` is a shorter spelling of the place it stands for, and the path a clause would be
        // told about is the one through that place -- so `&r` is `&o.a` written one line longer.
        TLoad(name, _) ->
            val stood = ref_place(cx, name)

            if stood.is_some() then sever_walk(cx, stood.unwrap(), below, out)
        _ -> ()

// The field paths a struct's clauses read, as a clause spells them.
//
// A clause is an expression over the fields by name, so the paths are read straight off it: a name
// that is a field roots one, a `.f` extends it, and an index is walked through for the same reason
// the place walk above walks through one. An index *expression* is not part of the path but may read
// fields of its own, so it is collected separately rather than dropped.
//
// A clause that hides an expression inside a **statement** -- the body of an `if` used as a value, a
// `match` arm, a lambda -- is not walked, and the answer for the struct becomes every field it has.
// Reading too much only ever refuses an alias that would have been allowed; reading too little would
// allow one that severs a promise, which is the mistake this whole file exists to prevent.
private inv_reads(a: &Analysis, base: string) -> Buf[Buf[string]]
    var out: Buf[Buf[string]] = buf()
    val decl = struct_decl_of(a, base)

    if decl.is_none() then return out

    val d = decl.unwrap()
    var fields: Buf[string] = buf()

    for item in d.fields
        fields.push(item.name)

    var opaque = false

    for item in d.invariants
        collect_reads(item, fields, &out, &opaque)

    if opaque
        var all: Buf[Buf[string]] = buf()

        for item in fields
            var one: Buf[string] = buf()

            one.push(item)
            all.push(one)

        return all

    out
end inv_reads

private collect_reads(e: Expr, fields: Buf[string], out: *Buf[Buf[string]], opaque: *bool)
    *e.kind match
        Lambda(_, _, _) ->
            *opaque = true
            return
        IfExpr(_, _, _, _) ->
            *opaque = true
            return
        MatchExpr(_, _) ->
            *opaque = true
            return
        _ -> ()

    val path = clause_path(fields, e)

    if path.is_some()
        out.push(path.unwrap())

        var indices: Buf[Expr] = buf()

        chain_indices(e, &indices)

        for indice in indices
            collect_reads(indice, fields, out, opaque)

        return

    var kids: Buf[Expr] = buf()

    clause_kids(e, &kids)

    for kid in kids
        collect_reads(kid, fields, out, opaque)

// The path a clause expression names, when it is a place rooted at one of the struct's fields.
private clause_path(fields: Buf[string], e: Expr) -> Option[Buf[string]] = *e.kind match
    Ident(n) ->
        if holds_string(fields, n)
            var one: Buf[string] = buf()

            one.push(n)
            Some(one)
        else None
    Field(r, n, _) ->
        val inner = clause_path(fields, r)

        if inner.is_none() then None
        else
            var path = inner.unwrap()

            path.push(n)
            Some(path)
    Index(r, _, _) -> clause_path(fields, r)
    _ -> None

// The index expressions along a place chain, which are read but are not part of the path.
private chain_indices(e: Expr, out: *Buf[Expr])
    *e.kind match
        Field(r, _, _) -> chain_indices(r, out)
        Index(r, i, _) ->
            out.push(i)
            chain_indices(r, out)
        _ -> ()

// Every sub-expression a clause node holds **directly** -- the ones reachable without going through
// a statement, which is exactly what the walks above want. What a statement holds is the case they
// fall back to reading every field for.
private clause_kids(e: Expr, out: *Buf[Expr])
    *e.kind match
        Unary(_, x) -> out.push(x)
        PreIncDec(_, x) -> out.push(x)
        PostIncDec(_, x) -> out.push(x)
        Binary(_, l, r) ->
            out.push(l)
            out.push(r)
        Compare(operands, _) -> push_all(operands, out)
        RangeExpr(lo, hi, _) ->
            push_opt(lo, out)
            push_opt(hi, out)
        Assign(_, target, value) ->
            out.push(target)
            out.push(value)
        Call(callee, args) ->
            out.push(callee)
            push_all(args, out)
        NamedArg(_, value) -> out.push(value)
        Spread(value) -> out.push(value)
        DefaultArg(_, value) -> out.push(value)
        Index(receiver, index, _) ->
            out.push(receiver)
            out.push(index)
        Field(receiver, _, _) -> out.push(receiver)
        TypeArgs(receiver, args, _) ->
            out.push(receiver)
            push_all(args, out)
        TypeAttr(receiver, _, _, _) -> out.push(receiver)
        WithExpr(base, _, _) -> out.push(base)
        TryExpr(inner) -> out.push(inner)
        AwaitExpr(inner) -> out.push(inner)
        Tuple(elements) -> push_all(elements, out)
        ArrayLit(elements) -> push_all(elements, out)
        ArrayFill(value, count) ->
            out.push(value)
            out.push(count)
        IsPattern(subject, _, _) -> out.push(subject)
        ResultList(values, _) -> push_all(values, out)
        While(_, cond, _, _) -> out.push(cond)
        DoWhile(_, _, cond, _) -> out.push(cond)
        For(_, _, iter, _, _) -> out.push(iter)
        ConstFor(_, iter, _) -> out.push(iter)
        CFor(_, _, cond, _, _, _) -> push_opt(cond, out)
        Quantifier(_, _, iter, pred) ->
            out.push(iter)
            out.push(pred)
        _ -> ()

private push_all(xs: Buf[Expr], out: *Buf[Expr])
    for item in xs
        out.push(item)

private push_opt(x: Option[Expr], out: *Buf[Expr])
    if x.is_some() then out.push(x.unwrap())

// Whether a write through an alias at one path could change what a clause reading the other sees.
//
// Either path being a prefix of the other is enough, and the two directions are different mistakes:
// an alias of `a` reaches the `a.n` a clause reads, and an alias of `a.n.x` changes the `a.n` a
// clause reads whole. Equal paths are both at once.
private overlaps(alias: Buf[string], read: Buf[string]) -> bool =
    starts_with_path(alias, read) || starts_with_path(read, alias)

private starts_with_path(xs: Buf[string], prefix: Buf[string]) -> bool
    if prefix.len() > xs.len() then return false

    for i in 0..<prefix.len()
        if xs.at(i) != prefix.at(i) then return false

    true
end starts_with_path

private path_shown(path: Buf[string]) -> string = joined(path, ".")

// The first clause an alias of this place would put out of reach, if there is one.
private severed(cx: &Analyzer, place: TExpr) -> Option[(&StructType, Buf[string])]
    val a = cx.an
    val below = severing(cx, place)

    for item in below
        val s = item.0
        val path = item.1
        val reads = inv_reads(a, s.base)

        for j in 0..<reads.len()
            if overlaps(path, reads.at(j)) then return Some((s, reads.at(j)))

    None
end severed

// `&place`, refused where the pointer it makes would be typed below a promise the place carries.
//
// `&o` is left alone -- a `*Outer` names the struct, so a write through it is found by the ordinary
// walk and checked. What is refused is the pointer that drops the name on the way out.
check_addressable(cx: &Analyzer, span: Span, place: TExpr)
    check_packed_field(cx, span, place)

    val cut = severed(cx, place)

    if cut.is_none() then return

    val s = cut.unwrap().0
    val read = path_shown(cut.unwrap().1)
    val shown = type_show(place_type(place))
    val owner = type_show(Struct(s))

    cx.fault(span, s"'&' here makes a '*$shown' pointing inside $owner, whose invariant reads " +
             s"'$read' — and a '*$shown' names no $owner, so a write through it would break the " +
             s"clause with nothing left to re-check it against. Take the address of the $owner " +
             "itself, which keeps the invariant in its type, or make the change through a method")
end check_addressable

// `&` of a field inside a `@packed` struct, refused.
//
// A packed field sits at its declared offset, which is very often not a multiple of its own
// alignment -- the whole point of the attribute. A `*u32` is a `*u32` wherever it came from, and
// every later use of one is entitled to assume the address is aligned: the back end may widen a
// load, choose an instruction that faults on a misaligned address, or hand it to a function that
// does. So the pointer is not merely unusual, it is a promise the storage cannot keep, and the
// mistake surfaces arbitrarily far from the `&` that made it.
//
// **Reading and writing the field are untouched**, because those go through the struct and the back
// end knows the offset is unaligned; it is only the escaped address that loses that.
private check_packed_field(cx: &Analyzer, span: Span, place: TExpr)
    *place.kind match
        TField(receiver, _, ty) ->
            underlying(texpr_type(receiver)) match
                Struct(s) ->
                    if s.packed
                        val shown = type_show(ty)
                        val owner = type_show(Struct(s))

                        cx.fault(span, s"'&' here makes a '*$shown' into $owner, which is " +
                                 s"'@packed' — its fields sit at their declared offsets, so this " +
                                 s"one need not be on a '$shown' boundary, and every use of a " +
                                 s"'*$shown' is entitled to assume that it is. Read or write the " +
                                 "field through the struct, which is where the offset is known, " +
                                 s"or take the address of the $owner itself")
                _ -> ()
        _ -> ()

// The same refusal for the other way to reach storage that outlives the expression: a view of it
// that may be written. A `[]const T` is left alone, since giving up the write is exactly what makes
// the alias carry no promise it could break.
check_sliceable(cx: &Analyzer, span: Span, base: TExpr, view: Type)
    // An array inside a `&sync` box is not viewed at all, whether the view may write or not.
    val box = sync_box_around(cx, base)

    if box.is_some()
        cx.fault(span, "a slice does not record whether its owner's count is atomic, so storage inside " +
                 s"a '${type_show(box.unwrap())}' cannot be sliced — a view of it would take its share " +
                 "of the box with a count update that is not atomic. Read it by index, or walk it with 'for'")
        return
    end if

    // Slicing a view makes a view of **its** storage, which is on the far side and no clause's to
    // read -- `self.elems[..<self.count]` shares the buffer's elements and leaves its length alone.
    if read_only_view(view) || far_side(texpr_type(base)) then return

    val cut = severed(cx, base)

    if cut.is_none() then return

    val s = cut.unwrap().0
    val read = path_shown(cut.unwrap().1)
    val shown = type_show(view)
    val owner = type_show(Struct(s))
    val elem = type_show(element(view).unwrap_or(Unknown))

    cx.fault(span, s"this view may be written, and it views storage inside $owner, whose invariant " +
             s"reads '$read' — a '$shown' names no $owner, so a write through it would break the " +
             s"clause with nothing left to re-check it against. Take it as a '[]const $elem', " +
             "which may not write, or make the change through a method")
end check_sliceable

// Holds a clause to reading storage the struct **owns**.
//
// Everything else here restricts the aliases a program may make, and that only works while the
// clause is a claim about the struct's own bytes. A clause that reads through a pointer, a reference
// or a view is a claim about somebody else's -- the far side of the hop has an identity of its own,
// every other alias of it is out of this struct's sight, and a write through one breaks the clause
// with nothing anywhere that could re-check it. So the clause is refused where it is written rather
// than quietly meaning less than it says.
//
// A view's `len` is the exception, and it is not really one: the three words are stored in the
// struct, so the length is the struct's own and the elements are not.
//
// A struct holding a **register** carries no invariant at all, and the rule is about the struct
// rather than about the clause for a reason worth stating: a check is a call taking *every* field,
// so it reads the whole block however few fields the clause names. On real hardware that is not a
// redundant read -- reading a data register pops a FIFO -- so a clause over the shadow field beside
// the registers would make writing that field an access to every one of them. There is nothing to
// keep the clause true either: a device changes a register between the check and the instruction
// after it, with no alias anywhere for the rule above to restrict.
check_invariant_reads(a: &Analysis, scope: Scope, span: Span, d: StructDecl, fields: &StructType)
    if d.invariants.is_empty() then return

    for f in fields.fields
        if volatile_in(f.1)
            a.fault(scope, span, s"'${d.name}' holds the register '${f.0}', so it carries no " +
                    "invariant — a check reads every field of the struct, so one written over the " +
                    "ordinary fields beside a register would make writing them an access to the " +
                    "device. And a device changes a register between the check and the " +
                    "instruction after it, which is what no clause could hold. Check a register " +
                    "where it is read")

    var names: Buf[string] = buf()

    for item in d.fields
        names.push(item.name)

    for item in d.invariants
        clause_walk(a, scope, item.span, item, names, fields)

// A clause read step by step, refusing the step that leaves the struct's own storage.
private clause_walk(a: &Analysis, scope: Scope, span: Span, e: Expr, names: Buf[string],
                    fields: &StructType)
    if clause_path(names, e).is_some()
        stepped(a, scope, span, e, fields)

        var indices: Buf[Expr] = buf()

        chain_indices(e, &indices)

        for indice in indices
            clause_walk(a, scope, span, indice, names, fields)

        return

    var kids: Buf[Expr] = buf()

    clause_kids(e, &kids)

    for kid in kids
        clause_walk(a, scope, span, kid, names, fields)

// The type a chain step lands on, refusing the step that reads through a hop.
private stepped(a: &Analysis, scope: Scope, span: Span, e: Expr,
                fields: &StructType) -> Option[Type]
    *e.kind match
        Ident(n) -> fields.field_type(n)
        Field(r, n, _) ->
            val recv = stepped(a, scope, span, r, fields)

            if recv.is_none() then return None

            recv.unwrap() match
                Struct(s) -> s.field_type(n)
                Slice(_, _) -> None
                Str -> None
                t ->
                    if indirect_hop(t) then refuse_indirect(a, scope, span, t, s"'$n'")

                    None
        Index(r, _, _) ->
            val recv = stepped(a, scope, span, r, fields)

            if recv.is_none() then return None

            recv.unwrap() match
                Array(_, elem) -> Some(*elem)
                t ->
                    if indirect_hop(t) then refuse_indirect(a, scope, span, t, "an element")

                    None
        _ -> None
end stepped

// Whether a type is reached through a hop of its own -- somebody else's storage, with an identity
// this struct cannot see.
private indirect_hop(t: Type) -> bool = t match
    Ptr(_) -> true
    Ref(_, _) -> true
    Weak(_) -> true
    Slice(_, _) -> true
    _ -> false

private refuse_indirect(a: &Analysis, scope: Scope, span: Span, t: Type, what: string)
    a.fault(scope, span, s"an invariant may only read storage the struct owns, and $what is read " +
            s"through ${type_show(t)} — what is on the far side has an identity of its own, so " +
            "another alias of it could break the clause with nothing left to re-check it against. " +
            "Hold the value in a field of the struct, and state the invariant over that")

// A struct's `invariant` clauses, held to what they may read.
//
// A **generic** struct's are asked per instantiation instead (`inv_fn_for`), since what a field of
// type `T` reaches depends on what `T` turns out to be.
check_invariants_of(a: &Analysis, scope: Scope, span: Span, key: string, d: StructDecl)
    if d.invariants.is_empty() || !d.tparams.is_empty() then return

    val inst = a.tables.struct_insts.get(instance_key(key, buf()))

    if inst.is_none() then return

    inst.unwrap() match
        Struct(st) -> check_invariant_reads(a, scope, span, d, st)
        _ -> ()
