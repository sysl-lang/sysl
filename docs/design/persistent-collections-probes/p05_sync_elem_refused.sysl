// P05: the same `&sync` node instantiated at an element holding an ordinary count. A shared
// persistent vector of `&Cell` must be refused -- this says where and how.

struct Cell
    n: int

struct SNode[T]
    kids: [4]Option[&sync SNode[T]]
    items: [4]T

main()
    val c: &Cell = Cell(1)
    val n: &sync SNode[&Cell] = SNode([None, None, None, None], [c, c, c, c])

    print(n.items[0].n)
