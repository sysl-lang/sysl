module sysl.io.hosted
@requires(libc)

import sysl.sys.{UNSUPPORTED, host_status}

// `sysl.io.sys`'s hooks answered over the platform's C library, which is what every hosted target
// links. **Call `sysl.io` and `sysl.flush` instead** -- nothing here is meant to be called: each
// function below exists to be linked under a hook's symbol. Each is public although an `@export` may
// be `private`: a private export's symbol is hidden, which keeps a Mach-O artifact to one codegen
// unit, and the standard module's artifact is the one every build pays that cost in.
//
// **Nothing imports this module, and nothing has to.** A hook a program reaches is answered by the
// library's own supplier (`reference/ffi.md § A module may supply another module's extern`), and its
// exports are `weak`, so a program answering a hook itself is the one the link keeps. The bodies exist
// only on a hosted target: a freestanding one has no C library to answer with, so there the program
// answers the hooks it reaches, and one it leaves unanswered is refused by name when it is compiled.
//
// **No capability clause, unlike `sysl.fs.hosted`.** Standard input and output are not the
// filesystem, and a hosted program that gave `os` away has always been able to read its input and
// flush its output; requiring `os` here would leave such a program linking against nothing.

#if hosted
// `errno` is a function on every platform this builds for, spelled per C library; see
// `sysl.fs.hosted`, which reads it the same way.
#if bsd
private extern "__error" errno_location() -> *i32
#elif android
private extern "__errno" errno_location() -> *i32
#else
private extern "__errno_location" errno_location() -> *i32
#endif

private extern "read" c_read(fd: int, into: *u8, n: usize) -> isize
private extern "write" c_write(fd: int, from: *u8, n: usize) -> isize

// `NULL` flushes every open output stream rather than naming one: naming `stdout` itself would need an
// `extern` variable, and `stdout` is a `#define` on Darwin that no `extern` reaches.
private extern "fflush" c_fflush(stream: *u8) -> int

/** The code a failed call left behind, negated: what a hook answers for a failure.
 * Asked straight after the call, so nothing can have overwritten it.
 */
private failure() -> isize
    val code = errno_location()[0]

    if code > 0 then isize(host_status(code)) else -5

@export("sysl_io_read")
io_read(fd: int, into: *u8, room: usize) -> isize
    val k = c_read(fd, into, room)

    if k < 0 then failure() else k

@export("sysl_io_write")
io_write(fd: int, from: *u8, len: usize) -> isize
    val k = c_write(fd, from, len)

    if k < 0 then failure() else k

@export("sysl_io_flush")
io_flush(fd: int) -> int = if c_fflush(null) == 0 then 0 else int(failure())

// **The wait is answered by `wait.c` beside this file**, which alone can spell `struct pollfd` and
// `nfds_t` the way each POSIX platform declares them, and which retries an interrupted `poll` for the
// time still owed. A hosted system without `poll` answers `UNSUPPORTED`.
#if posix
private extern "sysl_io_posix_wait" c_wait(fd: int, writable: int, micros: long) -> int

@export("sysl_io_wait")
io_wait(fd: int, writable: int, micros: long) -> int = c_wait(fd, writable, micros)
#else
@export("sysl_io_wait")
io_wait(fd: int, writable: int, micros: long) -> int = UNSUPPORTED
#endif

// **The readiness poller is answered by `poll.c` beside this file**: kqueue on Darwin and the BSDs,
// epoll on Linux, and the host's "no such call" -- `UNSUPPORTED` -- on a POSIX system with neither.
// Each of its functions answers a count, a descriptor or zero, or an `errno` negated, and the hook
// here turns a failure into the contract's status.
#if posix
private extern "sysl_io_posix_poll_open" c_poll_open(wake: *i32) -> int
private extern "sysl_io_posix_poll_control" c_poll_control(poller: int, fd: int, op: int, interest: int,
                                                           mode: int, token: u64) -> int
private extern "sysl_io_posix_poll_wait" c_poll_wait(poller: int, wake: int, into: *u8, room: usize,
                                                     micros: long) -> isize
private extern "sysl_io_posix_poll_wake" c_poll_wake(poller: int, wake: int) -> int
private extern "sysl_io_posix_poll_close" c_poll_close(poller: int, wake: int) -> int

/** A shim's answer as a hook's: what it answered, or the failure's status. */
private polled(k: int) -> int = if k < 0 then host_status(-k) else k

@export("sysl_io_poll_open")
io_poll_open(wake: *i32) -> int = polled(c_poll_open(wake))

@export("sysl_io_poll_control")
io_poll_control(poller: int, fd: int, op: int, interest: int, mode: int, token: u64) -> int =
    polled(c_poll_control(poller, fd, op, interest, mode, token))

@export("sysl_io_poll_wait")
io_poll_wait(poller: int, wake: int, into: *u8, room: usize, micros: long) -> isize
    val k = c_poll_wait(poller, wake, into, room, micros)

    if k < 0 then isize(host_status(int(-k))) else k

@export("sysl_io_poll_wake")
io_poll_wake(poller: int, wake: int) -> int = polled(c_poll_wake(poller, wake))

@export("sysl_io_poll_close")
io_poll_close(poller: int, wake: int) -> int = polled(c_poll_close(poller, wake))
#else
@export("sysl_io_poll_open")
io_poll_open(wake: *i32) -> int = UNSUPPORTED

@export("sysl_io_poll_control")
io_poll_control(poller: int, fd: int, op: int, interest: int, mode: int, token: u64) -> int = UNSUPPORTED

@export("sysl_io_poll_wait")
io_poll_wait(poller: int, wake: int, into: *u8, room: usize, micros: long) -> isize = isize(UNSUPPORTED)

@export("sysl_io_poll_wake")
io_poll_wake(poller: int, wake: int) -> int = UNSUPPORTED

@export("sysl_io_poll_close")
io_poll_close(poller: int, wake: int) -> int = UNSUPPORTED
#endif
#endif
