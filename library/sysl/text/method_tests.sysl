module sysl.text
@tests

// The string functions of `edit.sysl` called as members of the string: `s.split(",")`, `s.lines()`.
// Each method answers exactly what its free function does, so most cells below are written as the
// method beside the free function over the same input, and the inputs are the ones that tell a
// wrong receiver apart from a right one: a slice of a longer string, an empty string, UTF-8.

@test("split as a method cuts like the free function")
mtd_split()
    assert_slice_eq("a,b,c".split(","), ["a", "b", "c"])
    assert_slice_eq(",a,".split(","), ["", "a", ""])
    assert_slice_eq("a::b".split("::"), ["a", "b"])
    assert_slice_eq("abc".split(""), ["abc"])
    assert_slice_eq("".split(","), [""])

@test("split on a slice of a longer string sees only the slice")
mtd_split_slice()
    val long = "x,a,b,c,y"

    assert_slice_eq(long[2..<7].split(","), ["a", "b", "c"])
    assert_slice_eq(long[2..<2].split(","), [""])

@test("split over UTF-8 cuts at the separator and not inside a character")
mtd_split_utf8()
    assert_slice_eq("héllo→wörld→日本".split("→"), ["héllo", "wörld", "日本"])
    assert_slice_eq("日本語".split("本"), ["日", "語"])

@test("fields as a method skips runs of blanks")
mtd_fields()
    assert_slice_eq("  a  b\tc \n".fields(), ["a", "b", "c"])
    assert_slice_eq("".fields(), [])
    assert_slice_eq("   ".fields(), [])
    assert_slice_eq("xx a  b yy"[3..<7].fields(), ["a", "b"])
    assert_slice_eq("é  日".fields(), ["é", "日"])

@test("lines as a method drops the CR of CRLF and the empty line after a final terminator")
mtd_lines()
    assert_slice_eq("a\r\nb\nc".lines(), ["a", "b", "c"])
    assert_slice_eq("a\n".lines(), ["a"])
    assert_slice_eq("".lines(), [])
    assert_slice_eq("héllo\r\n日本語\nnaïve".lines(), ["héllo", "日本語", "naïve"])
    assert_slice_eq("xx a\r\nb\r\nc\nyy"[3..<9].lines(), ["a", "b"])

@test("methods chain")
mtd_chain()
    assert_eq("one\ntwo\nthree\n".lines().len, 3)
    assert_eq("a b c".split(" ").len, 3)
    assert_eq("  a,b ,c ".trim().split(",").len, 3)
    assert_eq("a-b-c".split("-").join("+"), "a+b+c")
    assert_eq("A,B".to_lower().split(",").join(";"), "a;b")
    assert_eq("x".repeat(3).replace_all("x", "ab").to_upper(), "ABABAB")

@test("repeat, replace_all, to_upper and to_lower as methods")
mtd_edit()
    assert_eq("ab".repeat(3), "ababab")
    assert_eq("ab".repeat(0), "")
    assert_eq("".repeat(5), "")
    assert_eq("a-b-c".replace_all("-", "+"), "a+b+c")
    assert_eq("abc".replace_all("", "x"), "abc")
    assert_eq("xx a-b yy"[3..<6].replace_all("-", "+"), "a+b")
    assert_eq("héllo".replace_all("é", "e"), "hello")
    assert_eq("héllo".to_upper(), "HÉLLO")
    assert_eq("HÉLLO".to_lower(), "héllo")
    assert_eq("".to_upper(), "")
    assert_eq("xxabxx"[2..<4].to_upper(), "AB")

@test("the fold family as methods")
mtd_fold()
    assert("Straße".eq_fold("STRASSE"))
    assert(!"abc".eq_fold("abd"))
    assert("".eq_fold(""))
    assert("STRASSENBAHN".starts_with_fold("straße"))
    assert("Hello.TXT".ends_with_fold(".txt"))
    assert("Straße".contains_fold("strasse"))
    assert(!"abc".contains_fold("d"))
    assert("xxHELLOxx"[2..<7].eq_fold("hello"))

@test("each method answers what the free function answers")
mtd_agree()
    val s = "a, b,,c\r\nd é\n"

    assert_slice_eq(s.split(","), split(s, ","))
    assert_slice_eq(s.fields(), fields(s))
    assert_slice_eq(s.lines(), lines(s))
    assert_eq(s.repeat(2), repeat(s, 2))
    assert_eq(s.replace_all(",", ";"), replace_all(s, ",", ";"))
    assert_eq(s.to_upper(), to_upper(s))
    assert_eq(s.to_lower(), to_lower(s))

@test("the members already on a string are unchanged beside the new ones")
mtd_no_collision()
    val s = "a,b"

    assert_eq(s.len, 3)
    assert_eq(s.bytes.len, 3)
    assert(s.contains(","))
    assert(s.starts_with("a"))
    assert_eq(s.split(",").len, 2)
