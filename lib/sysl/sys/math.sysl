module sysl.sys

// What `sysl.math` asks of the machine and of the C mathematics library, and the whole of what it
// asks.
//
// These are here rather than beside their callers for the reason the module exists: a name in
// `sysl.sys` is one the rest of the library may reach and nothing else may, so every declaration in
// the library that is not sysl is in one place and the surface a host has to supply can be read off
// a single file. Each is bound to a `sysl_`-prefixed word for the same reason `putchar` is --
// `sqrt`, `pow` and `floor` are words a program is entitled to declare itself, and `guide/fft` did
// exactly that before there was a module to ask.
//
// **Two kinds of declaration, told apart by the namespace the link name is in.** A name beginning
// `llvm.` is an intrinsic: the back end recognises it and emits the machine's own instruction, and
// there is no symbol for a linker to find. Everything else is libm's, resolved at the link. The
// split is not stylistic -- it is which operations the hardware has. A square root, an absolute
// value, a sign transfer and the four roundings are instructions on every machine sysl targets; a
// sine is not, on any of them, so asking LLVM for `llvm.sin` would produce a call to the same libm
// function this file already names, one indirection later.
//
// **What that buys beyond speed is a program that needs no libc.** A freestanding target has no
// libm to link against, so before this the whole module was hosted-only; the operations above the
// line now work on a bare machine, and only the transcendentals below it do not.
//
// Two entry points per operation either way, because C names the widths apart and sysl has no
// overloading to hide it behind: `sqrt` takes a `double`, `sqrtf` a `float`. The intrinsics are
// spelled the same twice for a different reason -- one base name, two widths, and the compiler
// derives `.f64` or `.f32` from the signature. `sysl.math` is where that stops being visible, and
// it stops there by dispatching on the receiver's type rather than by a caller choosing.
//
// The transcendentals are here and most of the comparisons are not, and the line is what the machine
// can do that sysl's operators cannot. A range-reduced sine is an algorithm; so, less obviously, are
// the two sign operations, which read and write the **sign bit** directly. An absolute value written
// as `if x < 0 then -x else x` is wrong for a negative zero -- no comparison distinguishes it from a
// positive one, so the negation never runs and a magnitude comes back negative. Everything that is a
// comparison and nothing more -- `signum`, `is_finite`, the interpolation -- `sysl.math` writes in
// sysl and calls nothing.

// Roots, exponentials and logarithms. The square root is the machine's own instruction rather than
// a call, which is what the `llvm.` namespace asks for; the cube root has no instruction anywhere
// and stays libm's.
private[sysl] extern "llvm.sqrt" sysl_sqrt(x: f64) -> f64
private[sysl] extern "llvm.sqrt" sysl_sqrtf(x: f32) -> f32
private[sysl] extern "cbrt" sysl_cbrt(x: f64) -> f64
private[sysl] extern "cbrtf" sysl_cbrtf(x: f32) -> f32
private[sysl] extern "exp" sysl_exp(x: f64) -> f64
private[sysl] extern "expf" sysl_expf(x: f32) -> f32
private[sysl] extern "exp2" sysl_exp2(x: f64) -> f64
private[sysl] extern "exp2f" sysl_exp2f(x: f32) -> f32
private[sysl] extern "log" sysl_log(x: f64) -> f64
private[sysl] extern "logf" sysl_logf(x: f32) -> f32
private[sysl] extern "log2" sysl_log2(x: f64) -> f64
private[sysl] extern "log2f" sysl_log2f(x: f32) -> f32
private[sysl] extern "log10" sysl_log10(x: f64) -> f64
private[sysl] extern "log10f" sysl_log10f(x: f32) -> f32

// Powers, and the two-argument length that is written this way to keep the square of a large
// operand off the path.
private[sysl] extern "pow" sysl_pow(x: f64, y: f64) -> f64
private[sysl] extern "powf" sysl_powf(x: f32, y: f32) -> f32
private[sysl] extern "hypot" sysl_hypot(x: f64, y: f64) -> f64
private[sysl] extern "hypotf" sysl_hypotf(x: f32, y: f32) -> f32

// Circular trigonometry. `atan2` takes the two coordinates rather than their ratio, which is what
// makes it able to answer in all four quadrants.
private[sysl] extern "sin" sysl_sin(x: f64) -> f64
private[sysl] extern "sinf" sysl_sinf(x: f32) -> f32
private[sysl] extern "cos" sysl_cos(x: f64) -> f64
private[sysl] extern "cosf" sysl_cosf(x: f32) -> f32
private[sysl] extern "tan" sysl_tan(x: f64) -> f64
private[sysl] extern "tanf" sysl_tanf(x: f32) -> f32
private[sysl] extern "asin" sysl_asin(x: f64) -> f64
private[sysl] extern "asinf" sysl_asinf(x: f32) -> f32
private[sysl] extern "acos" sysl_acos(x: f64) -> f64
private[sysl] extern "acosf" sysl_acosf(x: f32) -> f32
private[sysl] extern "atan" sysl_atan(x: f64) -> f64
private[sysl] extern "atanf" sysl_atanf(x: f32) -> f32
private[sysl] extern "atan2" sysl_atan2(y: f64, x: f64) -> f64
private[sysl] extern "atan2f" sysl_atan2f(y: f32, x: f32) -> f32

// Hyperbolic trigonometry.
private[sysl] extern "sinh" sysl_sinh(x: f64) -> f64
private[sysl] extern "sinhf" sysl_sinhf(x: f32) -> f32
private[sysl] extern "cosh" sysl_cosh(x: f64) -> f64
private[sysl] extern "coshf" sysl_coshf(x: f32) -> f32
private[sysl] extern "tanh" sysl_tanh(x: f64) -> f64
private[sysl] extern "tanhf" sysl_tanhf(x: f32) -> f32

// Rounding to an integral value, all four of which answer in the float's own type: a `floor` that
// returned an integer would be undefined for the operands that do not fit one, and the caller who
// wants an integer is the one who knows the range.
// All four roundings are instructions. `llvm.round` is C's `round` and goes away from zero at a
// half, which is **not** `llvm.roundeven`'s rule — the two differ at exactly the inputs a rounding
// is chosen for, so the one adopted here is pinned by a test rather than assumed from the name.
private[sysl] extern "llvm.floor" sysl_floor(x: f64) -> f64
private[sysl] extern "llvm.floor" sysl_floorf(x: f32) -> f32
private[sysl] extern "llvm.ceil" sysl_ceil(x: f64) -> f64
private[sysl] extern "llvm.ceil" sysl_ceilf(x: f32) -> f32
private[sysl] extern "llvm.round" sysl_round(x: f64) -> f64
private[sysl] extern "llvm.round" sysl_roundf(x: f32) -> f32
private[sysl] extern "llvm.trunc" sysl_trunc(x: f64) -> f64
private[sysl] extern "llvm.trunc" sysl_truncf(x: f32) -> f32

// The remainder has no instruction and stays a call.
private[sysl] extern "fmod" sysl_fmod(x: f64, y: f64) -> f64
private[sysl] extern "fmodf" sysl_fmodf(x: f32, y: f32) -> f32

// The two sign-bit operations: clearing it, and copying one across. Both belong on this side of the
// line because both see a signed zero, which no comparison does.
private[sysl] extern "llvm.fabs" sysl_fabs(x: f64) -> f64
private[sysl] extern "llvm.fabs" sysl_fabsf(x: f32) -> f32
private[sysl] extern "llvm.copysign" sysl_copysign(x: f64, y: f64) -> f64
private[sysl] extern "llvm.copysign" sysl_copysignf(x: f32, y: f32) -> f32
