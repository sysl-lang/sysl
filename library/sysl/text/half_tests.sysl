module sysl.text
@tests

import sysl.{f32_value, float_digits}

// Text to `f16`, rounded once. There is no C reader of half-precision text to hold it against, so the
// expected answers come from the values themselves: every `f16` and every half-way point between two
// of them is written out exactly, and the answer for the point, and for a decimal a hair either side
// of it, is known before anything is read.

private bits16(text: string) -> u16 = f16_prefix(text.bytes).0.bits()

// The significand, with its hidden bit, and the power of two of a finite `f16` with no sign.
private half_parts(b: u16) -> (u128, int)
    val biased = int(b >> 10)
    val fraction = u128(b & 0x3ff)

    if biased == 0 then (fraction, -24) else (fraction | 0x400, biased - 25)

// The point half way between `m * 2^e` and the float after it, written out in full.
private halfway(m: u128, e: int) -> string
    var into: [800]u8 = [0; 800]
    val got = float_digits(2 * m + 1, e - 1, 0, -2000, into[..])
    val digits = from_utf8(into[0..<got.0]).unwrap()

    s"0.${digits}e${got.1 + 1}"

// The decimal `k + 1` digits past the last of `text`'s above it, or below it: one more digit, a one
// after `k` zeros; or the last digit, never a zero, one lower and `k + 1` nines after it.
private nudged(text: string, up: bool, k: usize) -> string
    val e = text.index_of("e").unwrap()
    val head = text[0..<e]

    if up then return head + repeat("0", k) + "1" + text[e..]

    val last = head.bytes[head.bytes.len - 1]

    head[0..<head.bytes.len - 1] + char(u32(last) - 1).to_string() + repeat("9", k + 1) + text[e..]
end nudged

// A deterministic stream of 64-bit patterns (xorshift64*).
private struct Rand
    state: u64

    next(*self) -> u64
        self.state ^= self.state >> 12
        self.state ^= self.state << 25
        self.state ^= self.state >> 27
        self.state *% 0x2545f4914f6cdd1d
end Rand

@test("every finite f16, written at its shortest, reads back as itself and takes the whole text")
hpr_every_f16_round_trips()
    var bad = 0
    var said = ""

    for b in 0..<0x7c00
        for sign in [0, 0x8000]
            val bits = u16(b | sign)
            val text = f16.from_bits(bits).to_string()
            val got = f16_prefix(text.bytes)

            if got.0.bits() != bits || got.1 != text.bytes.len
                bad += 1

                if bad <= 5 then said = said + f"'$text' ${bits}%x read as ${got.0.bits()}%x " +
                                       s"after ${got.1}; "
            end if
        end for

    assert(bad == 0, s"$bad misread: $said")
end hpr_every_f16_round_trips

@test("every point half way between two f16s goes to the even one, and a hair past it to the nearer")
hpr_every_halfway_point()
    var bad = 0
    var said = ""

    // The last one, half way between the largest finite value and the next power of two, is where
    // rounding overflows: its even neighbour is the infinity.
    for b in 0..<0x7c00
        val parts = half_parts(u16(b))
        val h = halfway(parts.0, parts.1)
        val even = if (b & 1) == 0 then u16(b) else u16(b + 1)
        val cases = [(h, even), (nudged(h, true, 21), u16(b + 1)), (nudged(h, false, 21), u16(b)),
                     (nudged(h, true, 40), u16(b + 1)), (nudged(h, false, 40), u16(b)),
                     ("-" + nudged(h, true, 40), u16(b + 1) | 0x8000)]

        for c in cases
            val got = bits16(c.0)

            if got != c.1
                bad += 1

                if bad <= 5 then said = said + f"'${c.0}' read as ${got}%x, not ${c.1}%x; "
            end if
        end for
    end for

    assert(bad == 0, s"$bad misread: $said")
end hpr_every_halfway_point

@test("a long decimal a hair from half way is read as itself, not through a wider float")
hpr_long_digits_round_once()
    // 1 + 2^-11 is half way between 1 and the next f16, and 10^-40 past it is far inside an f128's
    // last bit: read as an f128 first, it lands on the half-way point and then on the even neighbour.
    val above = "1.00048828125" + repeat("0", 28) + "1"
    val below = "1.00048828124" + repeat("9", 29)

    assert_eq(bits16(above), 0x3c01)
    assert_eq(bits16(below), 0x3c00)
    assert_eq(bits16("1.00048828125"), 0x3c00)
    assert_eq(f16(f128_prefix(above.bytes).0).bits(), 0x3c00)

    // Half way between 1 + 2^-10 and 1 + 2^-9, whose even neighbour is the upper one.
    assert_eq(bits16("1.00146484375"), 0x3c02)
    assert_eq(bits16("1.00146484374" + repeat("9", 40)), 0x3c01)

    // Hundreds of digits are read, and a non-zero one past all of them still counts.
    assert_eq(bits16("1.00048828125" + repeat("0", 900) + "1"), 0x3c01)
    assert_eq(bits16("1.00048828125" + repeat("0", 900)), 0x3c00)
    assert_eq(bits16(repeat("0", 500) + "1.5"), 0x3e00)
end hpr_long_digits_round_once

@test("past the largest f16 is infinity, and below half the smallest subnormal is zero")
hpr_the_ends()
    assert_eq(bits16("65504"), 0x7bff)
    assert_eq(bits16("65519.9999999999999999999999999999999999999999"), 0x7bff)
    assert_eq(bits16("65520"), 0x7c00)
    assert_eq(bits16("-65520"), 0xfc00)
    assert_eq(bits16("1e5"), 0x7c00)
    assert_eq(bits16("1e99999999999"), 0x7c00)
    assert_eq(bits16("6.103515625e-5"), 0x0400)
    assert_eq(bits16("6.0975551605224609375e-5"), 0x03ff)
    assert_eq(bits16("5.9604644775390625e-8"), 0x0001)
    // Half way to the smallest subnormal is short enough to be read exactly in nineteen digits, and
    // so is every subnormal tie up to the seventeenth; each goes to the even neighbour, whatever
    // zeros and point it is written with.
    assert_eq(bits16("2.98023223876953125e-8"), 0x0000)
    assert_eq(bits16("0.0000000298023223876953125"), 0x0000)
    assert_eq(bits16("298023223876953125000e-28"), 0x0000)
    assert_eq(bits16("1.4901161193847656250e-7"), 0x0002)
    assert_eq(bits16("2.0861625671386718750e-7"), 0x0004)
    assert_eq(bits16("2.98023223876953125" + repeat("0", 30) + "1e-8"), 0x0001)
    assert_eq(bits16("2.98023223876953124" + repeat("9", 30) + "e-8"), 0x0000)
    assert_eq(bits16("-2.98023223876953125e-8"), 0x8000)
    assert_eq(bits16("8.940696716308594e-8"), 0x0002)
    assert_eq(bits16("1e-28"), 0)
    assert_eq(bits16("1e-99999999999"), 0)
    assert_eq(bits16("-0"), 0x8000)
    assert_eq(bits16("0e999999"), 0)
    assert_eq(bits16("0.1"), 0x2e66)
    assert_eq(bits16("1"), 0x3c00)
    assert_eq(bits16("-2.5"), 0xc100)
end hpr_the_ends

@test("a short decimal reads as the f16 nearest it, as an exact f128 narrowed once agrees")
hpr_short_decimals_match_f128()
    // A decimal of at most nineteen digits is either a half-way point itself, which an f128 holds
    // exactly, or further from one than an f128's last bit, so narrowing an f128 rounds only once.
    var g = Rand(0x9e3779b97f4a7c15)
    var bad = 0
    var said = ""

    for _ in 0..<20000
        val r = g.next()
        val digits = int(r % 19) + 1
        var w = (r >> 8) % 10000000000000000000
        val e = int((r >> 40) % 40) - 32 - digits
        var text = ""

        for _ in 0..<digits
            text = char(u32(w % 10) + 48).to_string() + text
            w /= 10

        text = text + s"e$e"

        val want = f16(f128_prefix(text.bytes).0).bits()
        val got = bits16(text)

        if got != want
            bad += 1

            if bad <= 5 then said = said + f"'$text' read as ${got}%x, not ${want}%x; "
        end if
    end for

    assert(bad == 0, s"$bad misread: $said")
end hpr_short_decimals_match_f128

@test("the grammar is the other widths', and the reading stops where theirs does")
hpr_grammar()
    for t in ["", " ", "x", ".", "+", "-", "+.", ".e1", "1.", ".5", "+.5", "-1.5e3xyz", "  \t\n42",
              "1e", "1e+", "1e-x", "1.5x", "inf", "INF", "infinity", "Infinity", "infin", "-inf",
              "nan", "NaN", "nan(123)", "nan(abc_9)", "nan(0x10)", "nan()", "nan(", "-nan", "0x",
              "0x1", "0x1p", "0x1p3", "0x1.8p3", "0X1.8P-3", "0x.8p1", "0xg", "00012", "1_000",
              "1.2.3", "1e5e5"]
        assert_eq(f16_prefix(t.bytes).1, f32_prefix(t.bytes).1, s"'$t'")

    val signed = f16_prefix("  -1.5e3xyz".bytes)

    assert_eq(signed.0, f16(-1500.0))
    assert_eq(signed.1, 8)
    assert_eq(f16_prefix("x".bytes).1, 0)
    assert_eq(f16_prefix("x".bytes).0.bits(), 0)
    assert_eq(bits16("inf"), 0x7c00)
    assert_eq(bits16("-Infinity"), 0xfc00)
    assert_eq(bits16("nan"), 0x7e00)
    assert_eq(bits16("-nan"), 0xfe00)
    assert_eq(bits16("nan(5)"), 0x7e05)
    // A payload keeps only the bits below the quiet bit.
    assert_eq(bits16("nan(0x7ff)"), 0x7fff)
    assert_eq(bits16("nan(0x400)"), 0x7e00)
    assert_eq(bits16("0x1p-24"), 0x0001)
    assert_eq(bits16("0x1p-25"), 0x0000)
    assert_eq(bits16("0x1.8p-25"), 0x0001)
    assert_eq(bits16("0x1.002p0"), 0x3c00)
    assert_eq(bits16("0x1.0020000001p0"), 0x3c01)
    assert_eq(bits16("0x1.006p0"), 0x3c02)
    assert_eq(bits16("0x1.ffcp15"), 0x7bff)
    assert_eq(bits16("0x1.ffep15"), 0x7c00)
end hpr_grammar

@test("parse_f16 refuses what is left over and an empty field, as parse_real does")
hpr_parse_refuses()
    assert_eq(parse_f16("0.1").unwrap().bits(), 0x2e66)
    assert_eq(parse_f16("65520").unwrap().bits(), 0x7c00)
    assert_eq(refusal(parse_f16("1.5x")), "not a digit at byte 3")
    assert_eq(refusal(parse_f16("1.5 ")), "not a digit at byte 3")
    assert_eq(refusal(parse_f16("")), "no digits to read")
    assert_eq(refusal(parse_f16(".")), "not a digit at byte 0")
    assert_eq(refusal(parse_f16("-")), "not a digit at byte 0")
    assert_eq(parse_f16("1.00048828125".bytes[..]).unwrap().bits(), 0x3c00)

private refusal(r: Result[f16, ParseError]) -> string = r match
    Ok(x) -> s"read as ${x}"
    Err(e) -> e.to_string()

@test("an f32 a long decimal's hair from half way rounds to the nearer f32 too")
hpr_f32_long_halfway()
    var g = Rand(77)
    var bad = 0
    var said = ""

    for _ in 0..<3000
        val x = f32.from_bits(u32(g.next() >> 33))
        val v = f32_value(x)

        if v.kind != Finite || x.bits() == 0x7f7fffff then continue

        val h = halfway(v.m, v.e)
        val b = x.bits()
        val even = if (b & 1) == 0 then b else b + 1
        val cases = [(h, even), (nudged(h, true, 40), b + 1), (nudged(h, false, 40), b)]

        for c in cases
            val got = f32_prefix(c.0.bytes).0.bits()

            if got != c.1
                bad += 1

                if bad <= 5 then said = said + f"'${c.0}' read as ${got}%x, not ${c.1}%x; "
            end if
        end for
    end for

    assert(bad == 0, s"$bad misread: $said")
end hpr_f32_long_halfway
