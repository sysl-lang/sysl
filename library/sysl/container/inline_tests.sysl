module sysl.container
@tests

import sysl.buf.{Buf, buf}

/** What `Inline` promises: `Buf`'s members over `N` slots it carries itself, of which the first
 * `len()` hold a value and the rest hold nothing.
 *
 * The axes: the element (an `int`, a `string` that owns memory, a `&T` whose `Drop` records when it
 * ran, an enum with no variant at zero, a type of no size), the capacity (a literal, a value
 * parameter of the holder, one computed from it, 0, 1), how full it is (empty, one, full), where an
 * insertion or a removal lands (the front, the middle, the end), the holder (a local, a struct's
 * field, two fields of one struct, a box, an element of a `Buf`), and what lets a value go (`pop`,
 * `remove`, `swap_remove`, `truncate`, `clear`, a write over it, the buffer's own end, a copy's end).
 *
 * What stops the program -- a push onto a full buffer, an index past the length -- and the build for
 * a machine with no heap are `tests_ilb_inline_buffer.sysl` in the compiler's tree, which can run a
 * program to its end and read what it said.
 */

// A value whose letting go is written down: `log` is one buffer every `Seen` of a test shares.
private struct Seen
    id: int
    log: Buf[int]

impl Drop for Seen
    drop(self) = self.log.push(self.id)

private inl_ids(log: Buf[int]) -> string
    var out = ""

    for id in log
        out = out + s"$id "

    out
end inl_ids

private inl_ints[const N: usize](b: Inline[int, N]) -> string
    var out = ""

    for x in b
        out = out + s"$x "

    out
end inl_ints

private enum Mode
    Idle = 1
    Busy = 2

@test("a fresh buffer is empty, and its capacity is N")
inl_fresh_is_empty()
    var b = inline[int, 4]()

    assert_eq(b.capacity(), 4)
    assert_eq(b.len(), 0)
    assert(b.is_empty())
    assert(!b.is_full())
    assert_eq(b.first(), None)
    assert_eq(b.last(), None)
    assert_eq(b.pop(), None)
    assert_eq(b.get(0), None)
    assert_eq(b.view().len, 0)
end inl_fresh_is_empty

@test("a plain declaration is an empty buffer where the element has a zero value")
inl_declaration_is_empty()
    var b: Inline[int, 3]
    var s: Inline[string, 2]

    assert(b.is_empty())
    assert(s.is_empty())
    b.push(5)
    s.push("a" + "b")
    assert_eq(b[0], 5)
    assert_eq(s[0], "ab")
end inl_declaration_is_empty

@test("pushes read back in order, and a full buffer hands a tried value back and keeps what it had")
inl_push_to_full()
    var b = inline[int, 3]()

    b.push(1)
    assert_eq(b.len(), 1)
    assert_eq(b.first(), Some(1))
    assert_eq(b.last(), Some(1))
    b.push(2)
    assert(b.try_push(3).is_ok())
    assert(b.is_full())

    val refused = b.try_push(4)

    assert(refused.is_err())
    assert_eq(refused.unwrap_err(), 4)
    assert_eq(inl_ints(b), "1 2 3 ")
    assert_eq(b.len(), 3)
end inl_push_to_full

@test("pop takes from the end until there is nothing, and the buffer is usable again")
inl_pop()
    var b = inline[int, 2]()

    b.push(1)
    b.push(2)
    assert_eq(b.pop(), Some(2))
    assert_eq(b.pop(), Some(1))
    assert_eq(b.pop(), None)
    assert(b.is_empty())
    b.push(9)
    assert_eq(b[0], 9)
end inl_pop

@test("an insertion lands at the front, in the middle and at the length, and a tried one on a full buffer is handed back")
inl_insert()
    var b = inline[int, 5]()

    b.insert(0, 30)
    b.insert(0, 10)
    b.insert(1, 20)
    b.insert(3, 40)
    assert_eq(inl_ints(b), "10 20 30 40 ")
    assert(b.try_insert(4, 50).is_ok())
    assert(b.is_full())
    assert_eq(b.try_insert(0, 5).unwrap_err(), 5)
    assert_eq(b.try_insert(5, 60).unwrap_err(), 60)
    assert_eq(inl_ints(b), "10 20 30 40 50 ")
end inl_insert

@test("a removal takes the front, the middle and the end, keeping the order of the rest")
inl_remove()
    var b = inline[int, 5]()

    for i in 1..5 do b.push(i * 10)

    assert_eq(b.remove(0), 10)
    assert_eq(inl_ints(b), "20 30 40 50 ")
    assert_eq(b.remove(1), 30)
    assert_eq(inl_ints(b), "20 40 50 ")
    assert_eq(b.remove(2), 50)
    assert_eq(inl_ints(b), "20 40 ")
    assert_eq(b.remove(0), 20)
    assert_eq(b.remove(0), 40)
    assert(b.is_empty())
end inl_remove

@test("swap_remove fills the hole with the last value, and taking the last moves nothing")
inl_swap_remove()
    var b = inline[int, 4]()

    for i in 1..4 do b.push(i)

    assert_eq(b.swap_remove(0), 1)
    assert_eq(inl_ints(b), "4 2 3 ")
    assert_eq(b.swap_remove(2), 3)
    assert_eq(inl_ints(b), "4 2 ")
    assert_eq(b.swap_remove(1), 2)
    assert_eq(b.swap_remove(0), 4)
    assert(b.is_empty())
end inl_swap_remove

@test("a buffer of one slot is full after one push, and one of no slots is always full and always empty")
inl_one_and_none()
    var one = inline[int, 1]()

    one.push(7)
    assert(one.is_full())
    assert_eq(one.try_push(8).unwrap_err(), 8)
    one.insert(0, one.remove(0) + 1)
    assert_eq(one.pop(), Some(8))
    assert_eq(one.try_insert(0, 3).is_ok(), true)
    assert_eq(one.swap_remove(0), 3)

    var none = inline[int, 0]()

    assert_eq(none.capacity(), 0)
    assert(none.is_full())
    assert(none.is_empty())
    assert_eq(none.try_push(1).unwrap_err(), 1)
    assert_eq(none.try_insert(0, 2).unwrap_err(), 2)
    assert_eq(none.pop(), None)
    assert_eq(none.view().len, 0)
    none.clear()

    var n = 0

    for x in none do n += 1

    assert_eq(n, 0)
end inl_one_and_none

@test("get answers nothing past the length or below zero, at any integer type, and never a slot that was vacated")
inl_get()
    var b = inline[int, 4]()

    b.push(10)
    b.push(20)
    b.push(30)
    b.pop()
    assert_eq(b.get(0), Some(10))
    assert_eq(b.get(1u8), Some(20))
    assert_eq(b.get(2), None)
    assert_eq(b.get(3), None)
    assert_eq(b.get(-1), None)
    assert_eq(b.get(i64::Min), None)
    assert_eq(b.get(u64::Max), None)
end inl_get

@test("a subscript reads and writes the slot, and a write does not grow the buffer")
inl_subscript()
    var b = inline[string, 3]()

    b.push("a" + "1")
    b.push("b" + "2")
    b[0] = "c" + "3"
    assert_eq(b[0], "c3")
    assert_eq(b[1], "b2")
    assert_eq(b.len(), 2)
end inl_subscript

@test("view is the filled part of the buffer's own storage, and a write through view_mut is a write to the buffer")
inl_views()
    var b = inline[int, 4]()

    b.push(1)
    b.push(2)
    b.push(3)

    // Each view sits in a block that closes before the buffer is next written: a view may not be
    // held across a call that writes what it was taken from.
    if true
        val seen = b.view()

        assert_eq(seen.len, 3)
        assert_eq(seen[0] + seen[1] + seen[2], 6)

    if true
        val written = b.view_mut()

        written[1] = 20

    assert_eq(b[1], 20)
    assert_eq(b.view()[1], 20)

    var total = 0

    for x in b.view() do total += x

    assert_eq(total, 24)
    b.truncate(1)
    assert_eq(b.view().len, 1)
end inl_views

@test("for walks in order, and a cursor keeps reading the buffer as it was when the walk began")
inl_walk()
    var b = inline[int, 3]()

    b.push(1)
    b.push(2)

    var c = b.walk()

    b.push(3)
    b.remove(0)
    assert_eq(c.next(), Some(1))
    assert_eq(c.next(), Some(2))
    assert_eq(c.next(), None)
    assert_eq(inl_ints(b), "2 3 ")
end inl_walk

@test("truncate keeps the front, a longer length changes nothing, and clear leaves a usable buffer")
inl_truncate_and_clear()
    var b = inline[int, 4]()

    for i in 1..4 do b.push(i)

    b.truncate(9)
    b.truncate(4)
    assert_eq(b.len(), 4)
    b.truncate(2)
    assert_eq(inl_ints(b), "1 2 ")
    b.clear()
    assert(b.is_empty())
    b.clear()
    b.push(5)
    assert_eq(inl_ints(b), "5 ")
end inl_truncate_and_clear

private struct Node[K, const B: usize]
    keys: Inline[K, B]
    kids: Inline[usize, B + 1]
    twice: Inline[K, 2 * B]

    room(self) -> usize = self.keys.capacity() + self.kids.capacity() + self.twice.capacity()

private node[K, const B: usize]() -> Node[K, B] = Node(inline(), inline(), inline())

@test("a struct holds buffers sized by its own parameter and by a computation over it, each its own")
inl_struct_fields()
    var n = node[int, 3]()

    assert_eq(n.keys.capacity(), 3)
    assert_eq(n.kids.capacity(), 4)
    assert_eq(n.twice.capacity(), 6)
    assert_eq(n.room(), 13)

    for i in 0..<3 do n.keys.push(i)
    for i in 0..<4 do n.kids.push(usize(i * 10))

    assert(n.keys.is_full())
    assert(n.kids.is_full())
    assert(n.twice.is_empty())
    assert_eq(n.keys.remove(1), 1)
    assert_eq(n.kids[3], 30)
    assert_eq(n.kids.len(), 4)

    val small = node[string, 1]()

    assert_eq(small.room(), 5)

    var none = node[int, 0]()

    assert(none.keys.is_full())
    none.kids.push(1)
    assert(none.kids.is_full())
end inl_struct_fields

@test("a buffer in a box is the box's own storage, and two boxes are two buffers")
inl_in_a_box()
    val a: &Node[int, 2] = node()
    val b: &Node[int, 2] = node()

    a.keys.push(1)
    a.keys.push(2)
    b.keys.push(9)
    assert_eq(a.keys.len(), 2)
    assert_eq(b.keys.len(), 1)
    assert_eq(a.keys.pop(), Some(2))
    assert_eq(b.keys[0], 9)
end inl_in_a_box

@test("a copy is its own buffer, by assignment, as an argument and as a result")
inl_by_value()
    var a = inline[int, 4]()

    a.push(1)
    a.push(2)

    var b = a

    b.pop()
    b.push(99)
    b.push(100)
    assert_eq(inl_ints(a), "1 2 ")
    assert_eq(inl_ints(b), "1 99 100 ")
end inl_by_value

@test("buffers are elements of a Buf, each with its own length")
inl_in_a_buf()
    var rows: Buf[Inline[int, 3]] = buf()

    for r in 0..<3
        var row = inline[int, 3]()

        for i in 0..r do row.push(r * 10 + i)

        rows.push(row)
    end for

    assert_eq(rows[0].len(), 1)
    assert_eq(rows[2].len(), 3)
    assert_eq(rows[2][2], 22)

    // An element read out of the `Buf` is a copy: changing it changes nothing until it is written back.
    var mid = rows[1]

    mid.pop()
    assert_eq(rows[1].len(), 2)
    rows[1] = mid
    assert_eq(rows[1].len(), 1)
    assert_eq(inl_ints(rows[2]), "20 21 22 ")
end inl_in_a_buf

@test("values that own memory are moved in and out and come back whole")
inl_owning_values()
    var b = inline[string, 3]()

    b.push("a" + "1")
    b.push("c" + "3")
    b.insert(1, "b" + "2")
    assert_eq(b.try_push("d" + "4").unwrap_err(), "d4")
    assert_eq(b.remove(0), "a1")
    assert_eq(b[0], "b2")
    assert_eq(b.swap_remove(0), "b2")
    assert_eq(b.pop(), Some("c3"))
    assert(b.is_empty())
end inl_owning_values

@test("an element with no zero value is held, and a slot past the length is never read as one")
inl_no_zero_value()
    var modes = inline[Mode, 3]()

    modes.push(Busy)
    modes.insert(0, Idle)
    assert(modes[0] == Idle)
    assert(modes[1] == Busy)
    assert(modes.get(2).is_none())
    assert(modes.pop().unwrap() == Busy)
    assert_eq(modes.len(), 1)
end inl_no_zero_value

@test("an element of no size is counted like any other")
inl_zero_sized()
    var b = inline[unit, 2]()

    b.push(())
    b.push(())
    assert(b.is_full())
    assert(b.try_push(()).is_err())
    assert(b.pop().is_some())
    b.remove(0)
    assert(b.is_empty())
    assert_eq(sizeof(Inline[unit, 2]), sizeof(usize))
end inl_zero_sized

@test("when the buffer goes it lets go of exactly the values it holds, in order")
inl_drop_at_the_end()
    var log: Buf[int] = buf()

    inl_fill_and_leave(log)
    assert_eq(inl_ids(log), "1 2 3 ")
end inl_drop_at_the_end

private inl_fill_and_leave(log: Buf[int])
    var b = inline[&Seen, 5]()

    b.push(Seen(1, log))
    b.push(Seen(2, log))
    b.push(Seen(3, log))
    assert_eq(log.len(), 0)
end inl_fill_and_leave

@test("a removed value is let go of at the removal, and the rest when the buffer goes")
inl_drop_at_removal()
    var log: Buf[int] = buf()

    inl_remove_some(log)
    assert_eq(inl_ids(log), "2 5 1 4 3 ")
end inl_drop_at_removal

private inl_remove_some(log: Buf[int])
    var b = inline[&Seen, 5]()

    for i in 1..5 do b.push(Seen(i, log))

    b.remove(1)
    assert_eq(inl_ids(log), "2 ")
    b.pop()
    assert_eq(inl_ids(log), "2 5 ")
    b.swap_remove(0)
    assert_eq(inl_ids(log), "2 5 1 ")
    assert_eq(b.len(), 2)
    assert_eq(b[0].id, 4)
    assert_eq(b[1].id, 3)
end inl_remove_some

@test("truncate and clear let go lowest index first, a write over a value lets go of the old one, and nothing twice")
inl_drop_by_truncate()
    var log: Buf[int] = buf()

    inl_truncate_some(log)
    assert_eq(inl_ids(log), "3 4 1 9 2 ")
end inl_drop_by_truncate

private inl_truncate_some(log: Buf[int])
    var b = inline[&Seen, 4]()

    for i in 1..4 do b.push(Seen(i, log))

    b.truncate(2)
    assert_eq(inl_ids(log), "3 4 ")
    b[0] = Seen(9, log)
    assert_eq(inl_ids(log), "3 4 1 ")
    b.clear()
    assert_eq(inl_ids(log), "3 4 1 9 2 ")
    b.clear()
end inl_truncate_some

@test("a value a full buffer hands back is not let go of until its holder is, and an insertion moves without letting go")
inl_drop_and_capacity()
    var log: Buf[int] = buf()

    inl_refuse_one(log)
    assert_eq(inl_ids(log), "7 3 1 2 ")
end inl_drop_and_capacity

private inl_refuse_one(log: Buf[int])
    var b = inline[&Seen, 3]()

    b.push(Seen(1, log))
    b.push(Seen(2, log))
    b.insert(0, Seen(3, log))
    assert_eq(log.len(), 0)

    val back = b.try_push(Seen(7, log))

    assert_eq(log.len(), 0)
    assert_eq(back.unwrap_err().id, 7)
    assert_eq(b[0].id, 3)
    assert_eq(b[2].id, 2)
end inl_refuse_one

@test("a copy holds its own share of each value, which is let go of once, when the last holder is")
inl_drop_through_a_copy()
    var log: Buf[int] = buf()

    inl_copy_and_leave(log)
    assert_eq(inl_ids(log), "2 1 ")
end inl_drop_through_a_copy

private inl_copy_and_leave(log: Buf[int])
    var a = inline[&Seen, 2]()

    a.push(Seen(1, log))
    a.push(Seen(2, log))

    var b = a

    a.clear()
    assert_eq(log.len(), 0)
    b.pop()
    assert_eq(inl_ids(log), "2 ")
end inl_copy_and_leave

private struct Pair[const B: usize]
    left: Inline[&Seen, B]
    right: Inline[&Seen, B + 1]

@test("a struct holding two lets go of each one's values, the first field's first")
inl_drop_two_fields()
    var log: Buf[int] = buf()

    inl_pair_and_leave(log)
    assert_eq(inl_ids(log), "1 2 10 20 30 ")
end inl_drop_two_fields

private inl_pair_and_leave(log: Buf[int])
    val p: &Pair[2] = Pair(inline(), inline())

    p.right.push(Seen(10, log))
    p.left.push(Seen(1, log))
    p.right.push(Seen(20, log))
    p.left.push(Seen(2, log))
    p.right.push(Seen(30, log))
    assert(p.left.is_full())
    assert(p.right.is_full())
end inl_pair_and_leave

@no_alloc
private inl_without_a_heap(n: int) -> int
    var b = inline[int, 4]()

    b.push(n)
    b.push(n + 1)
    b.insert(0, n - 1)

    if b.try_push(n + 2).is_err() then return -1
    if b.try_insert(0, 0).is_ok() then return -2

    var total = b.remove(1) + b.swap_remove(0) + b.pop().unwrap_or(0)

    for x in b do total += x
    for x in b.view() do total += x

    b.view_mut()[0] = 1
    b[0] = b[0] + b.get(0).unwrap_or(0) + b.first().unwrap_or(0) + b.last().unwrap_or(0)
    b.truncate(1)
    total += b[0] + int(b.len()) + int(b.capacity())
    b.clear()

    if b.is_empty() && !b.is_full() then total else -3
end inl_without_a_heap

@test("a function that may not allocate may make one and call every member")
inl_no_alloc()
    // 5, 4 and 6 taken out, the 7 left walked twice, then the 4 written over it, a length of 1 and
    // a capacity of 4.
    assert_eq(inl_without_a_heap(5), 38)
