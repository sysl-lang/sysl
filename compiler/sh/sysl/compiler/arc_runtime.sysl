module sh.sysl.compiler

// **All of the ownership runtime that is the same for every type** -- which, because the destructor
// lives behind the box's hook, is all of it but the hooks themselves.
//
// Taking a share needs no ordering: a count you already hold cannot reach zero underneath you, so
// the atomic form is a relaxed increment. Giving one back publishes with release ordering and
// acquires before destroying, so the thread that frees sees every other domain's writes. The
// `_maybe` pair is for views -- slices and strings -- whose owner is null when the elements are
// static, on a frame, or reached through a `*T`.
//
// **The plain and atomic pairs tolerate a null reference too, and that is not redundant.** A
// reference made by the language is never null, but a struct holding one may live in storage the
// program zeroed itself -- a `calloc`ed block, a collector's arena -- and a `Buf`, a `Map` or a
// `Deque` there is a struct holding a counted handle. Assigning into such a field gives back the
// previous occupant, which is the null the zeroing left, so a release that loaded through it first
// faulted on the first store into perfectly ordinary code. Taking or giving back a share of nothing
// is nothing, exactly as a string's null owner already is; the test is one compare the branch
// predictor settles once.
//
// **Teardown is iterative, not recursive.** A destructor releases the references its payload holds,
// so a chain of `&T` -- a linked list, a degenerate tree -- would otherwise recurse one C stack
// frame per node and overflow the stack on a long one. Instead, when a count reaches zero the object
// is pushed onto a worklist (reusing its now-dead count slot as the link) and the *first* release to
// hit zero drains the list in a loop: each destructor it runs pushes more work rather than
// recursing, so teardown depth is constant regardless of structure depth.
//
// **A hook is handed the drain's slot**, as its third argument, and its walk queues what it lets go
// of there itself (`arc.push`), or frees on the spot a box with nothing in it left to tear down
// (`emit_arc.sysl`'s `gen_push`). The free phase, reached from `arc.unshare`, is handed none.
//
// **The worklist is per thread, because it is scratch space and not shared state.** Two threads
// releasing the last reference to two unrelated `&sync` structures at the same moment both reach
// `arc.reap`, and one list between them would have each overwrite the other's head. So the head and
// the flag travel together as one **slot**, each thread drains its own, and that is what makes the
// flag mean what it says: it asks whether *this* thread is already inside a drain further up its own
// stack.
//
// **Where there is no notion of a current thread, the slot is asked for rather than assumed.** A
// target with thread-local storage reaches its own directly and this costs nothing. A freestanding
// target has no thread pointer, so it calls `__sysl_arc_reaper`, defined `weak` here to return the
// one plain slot. A program with no scheduler defines nothing and gets exactly the single-list
// behaviour it has always had; a port that *does* schedule defines the symbol over this one and
// answers with storage belonging to the running task.
//
// **A port written in sysl defines it with `@export`, and then the default is not emitted at all.**
// Weak yields to strong only between two objects, at the link; two `define`s of one name in one
// module are refused by the IR reader before any linker sees them, and the program's own definition
// lands in the very module this default does.

// The one symbol a freestanding **port** may define to say what the running task's reaper scratch
// is. It is a C name rather than a sysl one because whoever knows the answer is a scheduler written
// in C.
reaper_slot_symbol() -> string = "__sysl_arc_reaper"

// The header, the reaper's scratch, and the four functions every heap module needs.
//
// The two counts are pointer-width. Nothing forces that -- a reference count is not an address --
// but the alternative is a fixed `i64`, which costs sixteen bytes of header on a machine whose whole
// point is having very little memory. What *is* forced is that this agrees with the stores the
// emitter makes into these fields: a count written as one width and read as another is not a type
// error anywhere, it is a leak or a double free.
//
// `reaper_exported` says the module defines `__sysl_arc_reaper` itself, so the slot is still asked
// for but the weak default answering it is left out.
//
// **A drain asks for this thread's slot once, on the way in, and keeps the address.** A thread-local
// global named at each use is worked out again at each use, and on a machine whose thread-locals are
// reached through a call (Darwin's `tlv_get_addr`) every touch of the head or the flag was a call:
// four or five per object a drain tore down, against one push and one pop of real work. The address
// is the thread's own for the whole call, so asking once changes nothing a drain does. `switches`
// says the program may resume a body on another thread (`fiber_switch.sysl`): there the slot is
// still named at each use, as it always was, so nothing about a fiber that moves changes either.
// The module that declares the intrinsic is told by `arc_core_intrinsic`.
//
// **The two functions that call a hook through the header, `arc.destroy` and `arc.unshare`, are never
// inlined**, so the call through a pointer that runs a destructor stays in a function `sysl stack` can
// name and answer with every destructor (`stack_report.sysl`'s `hook_callers`). Both are on
// teardown's path, which is cold.
arc_core(t: Target, reaper_exported: bool, switches: bool = false) -> string
    val tls = if t.thread_local_storage() then "thread_local " else ""
    val supplied = !t.thread_local_storage()
    val word = word_llvm(t)

    val supplier = if !supplied || reaper_exported then "" else
        s"\ndefine weak ${t.preemption()}ptr @${reaper_slot_symbol()}() {\nentry:\n  ret ptr @arc.reaper.self\n}"

    val asked = s"  %s = call ptr @${reaper_slot_symbol()}()\n"
    val hoisted = s"  %s = call ptr @${trace_address_intrinsic()}(ptr @arc.reaper.self)\n"
    val fetch_slot = if supplied then asked else if arc_core_intrinsic(t, switches) then hoisted else ""
    val slot = if fetch_slot != "" then "%s" else "@arc.reaper.self"

    s"%arc.header = type { $word, ptr, $word }\n" +
    "\n" +
    "%arc.reaper = type { ptr, i8 }\n" +
    "\n" +
    s"@arc.reaper.self = internal ${tls}global %arc.reaper zeroinitializer\n" +
    s"$supplier\n" +
    "\n" +
    s"define private void @arc.retain(ptr %p) {\n" +
    "entry:\n" +
    "  %null = icmp eq ptr %p, null\n" +
    "  br i1 %null, label %done, label %live\n" +
    "live:\n" +
    s"  %c = load $word, ptr %p\n" +
    s"  %n = add $word %c, 1\n" +
    s"  store $word %n, ptr %p\n" +
    "  ret void\n" +
    "done:\n" +
    "  ret void\n" +
    "}\n" +
    "\n" +
    "define private void @arc.destroy(ptr %p, ptr %s) noinline {\n" +
    "entry:\n" +
    "  %h = getelementptr %arc.header, ptr %p, i32 0, i32 1\n" +
    "  %f = load ptr, ptr %h\n" +
    "  %none = icmp eq ptr %f, null\n" +
    "  br i1 %none, label %after, label %run\n" +
    "run:\n" +
    "  call void %f(ptr %p, i1 false, ptr %s)\n" +
    "  br label %after\n" +
    "after:\n" +
    "  call void @arc.unshare(ptr %p)\n" +
    "  ret void\n" +
    "}\n" +
    "\n" +
    "define private void @arc.unshare(ptr %p) noinline {\n" +
    "entry:\n" +
    "  %w = getelementptr %arc.header, ptr %p, i32 0, i32 2\n" +
    s"  %c = load $word, ptr %w\n" +
    s"  %n = sub $word %c, 1\n" +
    s"  store $word %n, ptr %w\n" +
    s"  %z = icmp eq $word %n, 0\n" +
    "  br i1 %z, label %gone, label %kept\n" +
    "gone:\n" +
    "  %h = getelementptr %arc.header, ptr %p, i32 0, i32 1\n" +
    "  %f = load ptr, ptr %h\n" +
    "  %none = icmp eq ptr %f, null\n" +
    "  br i1 %none, label %kept, label %give\n" +
    "give:\n" +
    "  call void %f(ptr %p, i1 true, ptr null)\n" +
    "  ret void\n" +
    "kept:\n" +
    "  ret void\n" +
    "}\n" +
    "\n" +
    // **`arc.reap` is kept out of line and declared rare**, which is what makes a release cheap
    // wherever one is emitted: a release is a decrement and a test, and only the test succeeding
    // reaches the worklist. Inlinable, the drain loop would be copied into every release site.
    // **It is `internal`, not `private`, so that it has a symbol**: a private function is a temporary
    // label in the object, and a profile charges its samples to whatever symbol precedes it.
    "define internal void @arc.reap(ptr %p) noinline cold {\n" +
    "entry:\n" +
    s"$fetch_slot  %head = getelementptr %arc.reaper, ptr $slot, i32 0, i32 0\n" +
    s"  %flag = getelementptr %arc.reaper, ptr $slot, i32 0, i32 1\n" +
    "  %w = load ptr, ptr %head\n" +
    "  store ptr %w, ptr %p\n" +
    "  store ptr %p, ptr %head\n" +
    "  %d = load i8, ptr %flag\n" +
    "  %in = icmp ne i8 %d, 0\n" +
    "  br i1 %in, label %inside, label %drain\n" +
    // **A box laid in a frame cannot wait its turn in a drain already running** -- a destructor's own
    // local, let go of as the destructor ends -- since its frame ends before the drain could reach
    // it. Its weak count carries the frame mark (`emit_box.sysl`'s `frame_weak_mark`), which no heap
    // box's ever does, and it is taken back off the list and torn down at once; what its teardown lets
    // go of joins the drain.
    "inside:\n" +
    "  %wk = getelementptr %arc.header, ptr %p, i32 0, i32 2\n" +
    s"  %m = load $word, ptr %wk\n" +
    s"  %framed = icmp eq $word %m, -1\n" +
    "  br i1 %framed, label %now, label %done\n" +
    "now:\n" +
    "  store ptr %w, ptr %head\n" +
    s"  store $word 0, ptr %p\n" +
    s"  call void @arc.destroy(ptr %p, ptr $slot)\n" +
    "  ret void\n" +
    "drain:\n" +
    "  store i8 1, ptr %flag\n" +
    "  br label %loop\n" +
    "loop:\n" +
    "  %q = load ptr, ptr %head\n" +
    "  %e = icmp eq ptr %q, null\n" +
    "  br i1 %e, label %finish, label %step\n" +
    "step:\n" +
    "  %next = load ptr, ptr %q\n" +
    "  store ptr %next, ptr %head\n" +
    s"  store $word 0, ptr %q\n" +
    s"  call void @arc.destroy(ptr %q, ptr $slot)\n" +
    "  %h0 = load ptr, ptr %head\n" +
    "  br label %turn\n" +
    // **What one teardown pushed is turned around before the next is popped**, so the list gives
    // work back in the order it was released: a destructor's own locals before the fields of the
    // value it tears down, the fields in declaration order, the elements in index order, and each
    // one torn down whole before its next sibling starts (Rust's order). The pushes sit between the
    // head and `%next`, last first; reversing that run in place costs one pass over it.
    "turn:\n" +
    "  %prev = phi ptr [ %next, %step ], [ %cur, %turned ]\n" +
    "  %cur = phi ptr [ %h0, %step ], [ %after, %turned ]\n" +
    "  %end = icmp eq ptr %cur, %next\n" +
    "  br i1 %end, label %spliced, label %turned\n" +
    "turned:\n" +
    "  %after = load ptr, ptr %cur\n" +
    "  store ptr %prev, ptr %cur\n" +
    "  br label %turn\n" +
    "spliced:\n" +
    "  store ptr %prev, ptr %head\n" +
    "  br label %loop\n" +
    "finish:\n" +
    "  store i8 0, ptr %flag\n" +
    "  ret void\n" +
    "done:\n" +
    "  ret void\n" +
    "}\n" +
    "\n" +
    "define private void @arc.release(ptr %p) {\n" +
    "entry:\n" +
    "  %null = icmp eq ptr %p, null\n" +
    "  br i1 %null, label %live, label %count\n" +
    "count:\n" +
    s"  %c = load $word, ptr %p\n" +
    s"  %n = sub $word %c, 1\n" +
    s"  store $word %n, ptr %p\n" +
    s"  %z = icmp eq $word %n, 0\n" +
    "  br i1 %z, label %reap, label %live\n" +
    "reap:\n" +
    "  call void @arc.reap(ptr %p)\n" +
    "  ret void\n" +
    "live:\n" +
    "  ret void\n" +
    "}\n" +
    "\n" +
    // **A release made by a hook's own walk is queued on the slot the drain handed the hook.** The
    // drain is running -- that is the only place a hook's walk runs -- so `arc.reap` would find the
    // flag set and do nothing but this push, after asking for the thread's slot again.
    "define private void @arc.push(ptr %p, ptr %s) {\n" +
    "entry:\n" +
    "  %null = icmp eq ptr %p, null\n" +
    "  br i1 %null, label %live, label %count\n" +
    "count:\n" +
    s"  %c = load $word, ptr %p\n" +
    s"  %n = sub $word %c, 1\n" +
    s"  store $word %n, ptr %p\n" +
    s"  %z = icmp eq $word %n, 0\n" +
    "  br i1 %z, label %queue, label %live\n" +
    "queue:\n" +
    "  %w = load ptr, ptr %s\n" +
    "  store ptr %w, ptr %p\n" +
    "  store ptr %p, ptr %s\n" +
    "  ret void\n" +
    "live:\n" +
    "  ret void\n" +
    "}\n" +
    "\n"
end arc_core

// Whether `arc_core` asks `llvm.threadlocal.address` for the reaper's slot, so the module has to
// declare it: where the slot is a thread-local and no body may move to another thread under it.
arc_core_intrinsic(t: Target, switches: bool) -> bool = t.thread_local_storage() && !switches

// The three functions a `weak T` needs, emitted only into a module that holds one.
//
// `upgrade` is the whole of what separates a weak reference from a dangling one: it reads the strong
// count, and a zero there means the object has already been destroyed, so the caller is handed
// nothing instead of an address. A live count is taken, which is why the answer is a reference the
// caller owns rather than one it has to be careful with.
arc_weak(t: Target) -> string
    val word = word_llvm(t)

    "define private void @arc.weak_retain(ptr %p) {\n" +
    "entry:\n" +
    "  %empty = icmp eq ptr %p, null\n" +
    "  br i1 %empty, label %done, label %live\n" +
    "live:\n" +
    "  %w = getelementptr %arc.header, ptr %p, i32 0, i32 2\n" +
    s"  %c = load $word, ptr %w\n" +
    s"  %n = add $word %c, 1\n" +
    s"  store $word %n, ptr %w\n" +
    "  ret void\n" +
    "done:\n" +
    "  ret void\n" +
    "}\n" +
    "\n" +
    "define private void @arc.weak_release(ptr %p) {\n" +
    "entry:\n" +
    "  %empty = icmp eq ptr %p, null\n" +
    "  br i1 %empty, label %done, label %live\n" +
    "live:\n" +
    "  call void @arc.unshare(ptr %p)\n" +
    "  ret void\n" +
    "done:\n" +
    "  ret void\n" +
    "}\n" +
    "\n" +
    "define private ptr @arc.upgrade(ptr %p) {\n" +
    "entry:\n" +
    "  %empty = icmp eq ptr %p, null\n" +
    "  br i1 %empty, label %gone, label %check\n" +
    "check:\n" +
    s"  %c = load $word, ptr %p\n" +
    s"  %z = icmp eq $word %c, 0\n" +
    "  br i1 %z, label %gone, label %live\n" +
    "live:\n" +
    s"  %n = add $word %c, 1\n" +
    s"  store $word %n, ptr %p\n" +
    "  ret ptr %p\n" +
    "gone:\n" +
    "  ret ptr null\n" +
    "}\n" +
    "\n"
end arc_weak

// The atomic pair, emitted only into a module that has a `&sync` in it.
//
// **Under ThreadSanitizer the acquire before the free is a load of the count, not a fence.** TSan
// models orderings through the memory they are attached to and does not model a standalone `fence`,
// so with the fence every `&sync` object freed on another thread than the one that last wrote it is
// reported as a race that cannot happen. An acquire load of the count the release just decremented
// synchronizes with every earlier release of it exactly as the fence does -- it is a little dearer,
// which is why only a thread-sanitized build pays it. Rust's `Arc` makes the same exchange.
arc_atomic(t: Target, tsan: bool = thread_sanitized(extra_cflags())) -> string
    val word = word_llvm(t)
    var acquire = "  fence acquire\n"

    if tsan then acquire = s"  %a = load atomic $word, ptr %p acquire, align ${t.pointer_bits() / 8}\n"

    "define private void @arc.retain_sync(ptr %p) {\n" +
    "entry:\n" +
    "  %null = icmp eq ptr %p, null\n" +
    "  br i1 %null, label %done, label %live\n" +
    "live:\n" +
    s"  %o = atomicrmw add ptr %p, $word 1 monotonic\n" +
    "  ret void\n" +
    "done:\n" +
    "  ret void\n" +
    "}\n" +
    "\n" +
    "define private void @arc.release_sync(ptr %p) {\n" +
    "entry:\n" +
    "  %null = icmp eq ptr %p, null\n" +
    "  br i1 %null, label %live, label %count\n" +
    "count:\n" +
    s"  %o = atomicrmw sub ptr %p, $word 1 release\n" +
    s"  %z = icmp eq $word %o, 1\n" +
    "  br i1 %z, label %reap, label %live\n" +
    "reap:\n" +
    acquire +
    "  call void @arc.reap(ptr %p)\n" +
    "  ret void\n" +
    "live:\n" +
    "  ret void\n" +
    "}\n" +
    "\n"
end arc_atomic

// The null-tolerant pair, emitted only into a module that holds a view of something.
//
// **A view's owner may be SHARED: its count's top bit set, and every change to it atomic.** A string
// placed in an object two domains reach -- captured by a `&sync Fn`, a field of a `&sync T` -- is
// copied there into bytes of its own whose count is marked so (`emit_cross.sysl`'s `share.copy`), and
// every view of those bytes, a slice of the string included, shares that owner. The mark is set once,
// before the object is published, and never cleared while the owner lives, so the test that reads it
// needs no ordering: an unordered load, which is the plain load the count's change reads anyway. A
// count that is not marked is changed as it always was. Taking a share of a marked one is a relaxed
// increment, and giving one back a release decrement with an acquire before the teardown, exactly as a
// `&sync T`'s (`arc_atomic`); the last share is the mark plus one.
//
// **Where the processor cannot change a word indivisibly (Armv6-M) nothing is ever marked**, so the
// pair is the plain one and makes no call no board's runtime defines; `share.copy` still copies there.
arc_maybe(t: Target, tsan: bool = thread_sanitized(extra_cflags())) -> string
    val word = word_llvm(t)

    if !marks_shared(t) then return arc_maybe_plain(word)

    val align = t.pointer_bits() / 8
    val mark = shared_mark(t.pointer_bits())
    val last = shared_last(t.pointer_bits())
    var acquire = "  fence acquire\n"

    if tsan then acquire = s"  %a = load atomic $word, ptr %p acquire, align $align\n"

    "define private void @arc.retain_maybe(ptr %p) {\n" +
    "entry:\n" +
    "  %null = icmp eq ptr %p, null\n" +
    "  br i1 %null, label %done, label %live\n" +
    "live:\n" +
    s"  %c = load atomic $word, ptr %p unordered, align $align\n" +
    s"  %shared = icmp slt $word %c, 0\n" +
    "  br i1 %shared, label %atomic, label %plain\n" +
    "plain:\n" +
    s"  %n = add $word %c, 1\n" +
    s"  store $word %n, ptr %p\n" +
    "  ret void\n" +
    "atomic:\n" +
    s"  %o = atomicrmw add ptr %p, $word 1 monotonic\n" +
    "  ret void\n" +
    "done:\n" +
    "  ret void\n" +
    "}\n" +
    "\n" +
    "define private void @arc.release_maybe(ptr %p) {\n" +
    "entry:\n" +
    "  %null = icmp eq ptr %p, null\n" +
    "  br i1 %null, label %done, label %live\n" +
    "live:\n" +
    s"  %c = load atomic $word, ptr %p unordered, align $align\n" +
    s"  %shared = icmp slt $word %c, 0\n" +
    "  br i1 %shared, label %atomic, label %plain\n" +
    "plain:\n" +
    s"  %n = sub $word %c, 1\n" +
    s"  store $word %n, ptr %p\n" +
    s"  %z = icmp eq $word %n, 0\n" +
    "  br i1 %z, label %reap, label %done\n" +
    "atomic:\n" +
    s"  %o = atomicrmw sub ptr %p, $word 1 release\n" +
    s"  %last = icmp eq $word %o, $last\n" +
    "  br i1 %last, label %acquired, label %done\n" +
    "acquired:\n" +
    acquire +
    "  br label %reap\n" +
    "reap:\n" +
    "  call void @arc.reap(ptr %p)\n" +
    "  ret void\n" +
    "done:\n" +
    "  ret void\n" +
    "}\n" +
    "\n" +
    "define private i1 @arc.share_wanted(ptr %p) {\n" +
    "entry:\n" +
    "  %null = icmp eq ptr %p, null\n" +
    "  br i1 %null, label %no, label %live\n" +
    "live:\n" +
    s"  %c = load atomic $word, ptr %p unordered, align $align\n" +
    s"  %plain = icmp sge $word %c, 0\n" +
    "  ret i1 %plain\n" +
    "no:\n" +
    "  ret i1 false\n" +
    "}\n" +
    "\n" +
    "define private void @arc.mark_shared(ptr %p) {\n" +
    "entry:\n" +
    "  %null = icmp eq ptr %p, null\n" +
    "  br i1 %null, label %done, label %live\n" +
    "live:\n" +
    s"  %c = load $word, ptr %p\n" +
    s"  %m = or $word %c, $mark\n" +
    s"  store $word %m, ptr %p\n" +
    "  ret void\n" +
    "done:\n" +
    "  ret void\n" +
    "}\n" +
    "\n"
end arc_maybe

// Whether a view's owner is ever marked shared on `t`: where a word can be changed indivisibly.
marks_shared(t: Target) -> bool = t.atomic_rmw_bits() >= int(t.pointer_bits())

// The mark, and the count a marked owner's last share leaves, as LLVM spells a word's constant:
// signed, so the top bit alone is the most negative word.
private shared_mark(bits: usize) -> string = bits match
    16 -> "-32768"
    32 -> "-2147483648"
    _ -> "-9223372036854775808"

private shared_last(bits: usize) -> string = bits match
    16 -> "-32767"
    32 -> "-2147483647"
    _ -> "-9223372036854775807"

// The pair where nothing is marked: a null check and a delegation. A copy `share.copy` makes is
// wanted for every view with an owner, and is not marked.
private arc_maybe_plain(word: string) -> string =
    "define private void @arc.retain_maybe(ptr %p) {\n" +
    "entry:\n" +
    "  %null = icmp eq ptr %p, null\n" +
    "  br i1 %null, label %done, label %live\n" +
    "live:\n" +
    "  call void @arc.retain(ptr %p)\n" +
    "  ret void\n" +
    "done:\n" +
    "  ret void\n" +
    "}\n" +
    "\n" +
    "define private void @arc.release_maybe(ptr %p) {\n" +
    "entry:\n" +
    "  %null = icmp eq ptr %p, null\n" +
    "  br i1 %null, label %done, label %live\n" +
    "live:\n" +
    "  call void @arc.release(ptr %p)\n" +
    "  ret void\n" +
    "done:\n" +
    "  ret void\n" +
    "}\n" +
    "\n" +
    "define private i1 @arc.share_wanted(ptr %p) {\n" +
    "entry:\n" +
    "  %some = icmp ne ptr %p, null\n" +
    "  ret i1 %some\n" +
    "}\n" +
    "\n" +
    "define private void @arc.mark_shared(ptr %p) {\n" +
    "entry:\n" +
    "  ret void\n" +
    "}\n" +
    "\n"

// The machine's word, as LLVM spells it.
private word_llvm(t: Target) -> string = s"i${t.pointer_bits()}"
