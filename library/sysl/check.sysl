module sysl

/** What a program does when something it was sure of turns out not to hold.
 *
 * These are the *runtime* half of the language's checking, and they sit beside rather than inside the
 * half `16-constrained-types-and-contracts.md` describes. A `require` clause is a promise about a
 * call, checked where the call arrives and nowhere else; these are a promise about a moment, checked
 * where the moment is. A function whose fifth statement has just computed something it can verify has
 * no contract to hang that on -- the contract was about the arguments, four statements ago.
 *
 * Both stop the program the way `unwrap` does: a line naming what happened, then the hosted exit that
 * `11-error-handling.md` gives a trap under the `os` capability. That is deliberately not
 * `llvm.trap`. A trap is what the compiler emits for a check the *language* makes -- a bounds
 * violation, a broken contract -- and it stops with a signal and no message, because there is nothing
 * it could say that the source line does not already. These are checks a *program* makes, about
 * things it knows and the compiler does not, so the message is the whole point of them.
 *
 * Under `sysl test` either one fails the test it is written in, since a test's verdict is whether it
 * came back and neither of these comes back.
 */

// Where the caller was. Both take these and neither is ever given them: a default is evaluated at
// the call, standing exactly where the argument would have been written (`reference/declarations.md
// § Default parameters and named arguments`), so `__FILE__` and `__LINE__` written here report the
// line that called `assert` rather than this line (`reference/lexical.md § Reserved identifiers`).
//
// **This is why `assert`'s message is now optional, and it used to be required.** The comment that
// stood here said the message could not be defaulted "because the condition's source is not
// available to print" -- true when it was written, and a workaround stated as a principle. A check
// that names its own line does not need to be told in prose which check it was.

/** The location is **streamed** rather than interpolated, and that is not a style choice: an
 * f-string builds a string, and building one makes heap storage, which would put `panic` and
 * everything through it out of reach of a module that declared `@no_alloc` (`reference/modules.md §
 * Capabilities are a module property`). An assertion is exactly what an allocator-free module wants
 * most, so it is composed out of `prints` and `printi`, each of which goes straight to `putbytes`.
 * Caught by the `@no_alloc` test that already existed.
 */
panic(msg: string, file: string = __FILE__, line: long = __LINE__) -> never
    prints("panic: ")
    prints(msg)
    prints(" (")
    prints(file)
    prints(":")
    printi(line)
    prints(")\n")
    exit(1)

/** The condition is checked and nothing else is: a false one names where it was written, and the
 * message if it was given one.
 *
 * **`file` and `line` are passed on explicitly**, which is the one thing about this that is easy to
 * get wrong: letting `panic` fill its own defaults would report *this* line, in this file, for every
 * assertion in every program -- the call that fills them would be the one three lines down rather
 * than the reader's. Forwarding them is how a location travels through a helper.
 */
assert(cond: bool, msg: string = "", file: string = __FILE__, line: long = __LINE__)
    if !cond then
        if msg.len == 0 then panic("assertion failed", file, line)
        else panic(msg, file, line)

// What an equality assertion adds over `assert(a == b)` is the two **values**, and that is the whole
// of why it is worth a function. A failed `assert` names the line, which says *which* check broke; a
// reader then has to run the thing again to find out what the values were, and running it again is
// exactly what the report could have saved them.
//
// The message could be written by hand -- `assert(a == b, s"got $a, want $b")` -- and that is the
// form this replaces. It evaluates each side twice, and it builds a string, which makes heap
// storage and so is unavailable to the modules that want an assertion most (`reference/modules.md §
// Capabilities are a module property`). Rendering through `Display` into `stdout()` costs neither.
//
// One function rather than one per type: `Eq` says the comparison means something and `Display` says
// the value can be shown, which together are the whole of what a report needs.

/** The head and the tail of a report, shared by the three below so that one failure reads like
 * another. They are separate because what goes between them is each assertion's own -- a pair of
 * values, a pair of lengths, an index -- and none of it can be handed over as a `string` without
 * building one.
 */
private[sysl] report_head(msg: string)
    prints("panic: ")

    if msg.len > 0 then
        prints(msg)
        prints(": ")

private[sysl] report_tail(file: string, line: long) -> never
    prints(" (")
    prints(file)
    prints(":")
    printi(line)
    prints(")\n")
    exit(1)

private[sysl] show[T: Display](v: T) = v.display(stdout(), FormatSpec(0, -1, false))

/** `got` and `want` in that order, which is Go's and the order a failure is read in: what happened,
 * then what was meant to.
 */
assert_eq[T: Eq + Display](got: T, want: T, msg: string = "", file: string = __FILE__,
                           line: long = __LINE__)
    if got != want then
        report_head(msg)
        prints("got ")
        show(got)
        prints(", want ")
        show(want)
        report_tail(file, line)

/** The same for a slice, which needs more than `==` to be useful: a report saying two slices differ
 * sends its reader to find out where, and finding out where is a loop nobody wants to write at each
 * call. Length first, since a length mismatch explains every index after the shorter one.
 */
assert_slice_eq[T: Eq + Display](got: []const T, want: []const T, msg: string = "",
                                 file: string = __FILE__, line: long = __LINE__)
    if got.len != want.len then
        report_head(msg)
        prints("got ")
        printu(ulong(got.len))
        prints(" elements, want ")
        printu(ulong(want.len))
        report_tail(file, line)

    for i in 0..<got.len
        if got[i] != want[i] then
            report_head(msg)
            prints("got ")
            show(got[i])
            prints(", want ")
            show(want[i])
            prints(" at index ")
            printu(ulong(i))
            report_tail(file, line)
