module sh.sysl.compiler
@tests

// A count that is not atomic held across a call that can reach `sysl.fiber.switch` is refused
// (`abandons.sysl`'s `check_switch_holds`, `library/fiber.md § A fiber may move between threads`):
// the fiber may come back on another carrier and give the count back there with a plain decrement,
// racing the carrier it was made on.
//
// The axes: the call (the switch itself, a function that reaches it, one that only takes its address,
// one that cannot switch); what is held (a local view, a string, a `&T`, a closure, a temporary, a
// `match` binding, a loop variable, a `&sync T`, a scalar, a `*T`); where it dies (before the call, in
// a block of its own, after it); the body (a function, a member, a closure, a loop body, `main`); and
// the opt-out (`@pinned(thread)` on a function and on a member, its misspellings, and where it may not
// stand). Not here: a generic body, whose instantiations are walked as any other body; a call through
// a value, which is not followed, as for `@abandons` (`tests_nfc_`).

// A fiber scheduler of the smallest kind: `wait` switches back to whoever started the fiber.
private fcr_head() -> string = raw"""
    module sched

    import sysl.fiber.{Context, Stack, switch}

    struct Pair
        home: Context
        away: Context

    var pair = Pair(Context.new(), Context.new())

    wait()
        switch(&pair.away, &pair.home)

    add(a: int, b: int) -> int = a + b

    struct Box
        n: int

    """

// The scheduler is a module of its own, so its `pair` is module storage every body may reach rather
// than the entry file's own.
private fcr_ir(body: string) -> string = xvr_ir([("main.sysl", "import sched.*\nimport sysl.fiber.{Context, Stack, switch}\n\n" + body),
                                               ("sched/sched.sysl", fcr_head())])

private fcr_accepted(body: string)
    if xvr_no_library() then return

    val said = fcr_ir(body)

    assert(!said.contains("error:"), said)

// A refusal names what is held and the call it is held across.
private fcr_refused(body: string, held: string, callee: string)
    if xvr_no_library() then return

    val said = fcr_ir(body)

    assert(said.contains("error: "), said)
    assert(said.contains(s"and this frame holds $held across the call"), said)

    val head = if callee == "sysl.fiber.switch" then "'sysl.fiber.switch' may resume this fiber on another thread"
    else s"'$callee' can reach 'sysl.fiber.switch', which may resume this fiber on another thread"

    assert(said.contains(s"error: $head"), said)
    assert(said.contains("End it before the call (in a block of its own, or in a function that returns first), or hold it as a '&sync' reference, whose count is atomic; a function whose fiber is only ever resumed on the thread it began on says so with '@pinned(thread)'"), said)

@test("a view held across the switch itself is refused, naming the view and the switch")
fcr_view_across_switch()
    fcr_refused(raw"""
        work()
            val bytes: []u8 = [1, 2, 3]
            switch(&pair.away, &pair.home)
            print(bytes.len)
        """, "'bytes'", "sysl.fiber.switch")

@test("a view held across a function that reaches the switch is refused, naming that function")
fcr_view_across_reacher()
    fcr_refused(raw"""
        work()
            val bytes: []u8 = [1, 2, 3]
            wait()
            print(bytes.len)
        """, "'bytes'", "sched.wait")

@test("two calls down is still a reach")
fcr_two_calls_down()
    fcr_refused(raw"""
        settle() = wait()

        work()
            val name = "a" + "b"
            settle()
            print(name)
        """, "'name'", "settle")

@test("a carrier's buffer sliced and held across a wait is refused -- the shape avin's receive had")
fcr_carrier_buffer_view()
    fcr_refused(raw"""
        struct Carrier
            receiving: []u8

        receive(k: &Carrier, want: usize) -> int
            val room: []u8 = k.receiving[0..<want]
            wait()
            int(room.len)
        """, "'room'", "sched.wait")

@test("a counted value held across a call that cannot switch is accepted")
fcr_call_that_cannot_switch()
    fcr_accepted(raw"""
        work()
            val bytes: []u8 = [1, 2, 3]
            print(add(1, 2))
            print(bytes.len)
        """)

@test("a function that only takes the switch's address does not switch by being called")
fcr_address_is_no_call()
    fcr_accepted(raw"""
        entry(p: *Pair) = wait()

        starts(stack: &Stack) -> Context = Context.start(stack, &entry, &pair)

        work(stack: &Stack)
            val name = "a" + "b"
            val c = starts(stack)
            print(c.is_ready())
            print(name)
        """)

@test("a value that dies in a block of its own before the call is accepted")
fcr_dead_before_the_call()
    fcr_accepted(raw"""
        work(flag: bool)
            if flag
                val bytes: []u8 = [1, 2, 3]
                print(bytes.len)
            wait()
        """)

@test("a value declared after the call is accepted")
fcr_declared_after()
    fcr_accepted(raw"""
        work()
            wait()
            val bytes: []u8 = [1, 2, 3]
            print(bytes.len)
        """)

@test("a '&sync' reference held across the call is accepted -- its count is atomic")
fcr_sync_reference()
    fcr_accepted(raw"""
        work()
            val b: &sync Box = Box(1)
            wait()
            print(b.n)
        """)

@test("a plain '&T' held across the call is refused")
fcr_plain_reference()
    fcr_refused(raw"""
        work()
            val b: &Box = Box(1)
            wait()
            print(b.n)
        """, "'b'", "sched.wait")

@test("a scalar, a struct of scalars and a '*T' held across the call are accepted")
fcr_scalars()
    fcr_accepted(raw"""
        struct Point
            x: int
            y: int

        work(p: *Pair)
            val n = 3
            val at = Point(1, 2)
            val q = p
            wait()
            print(n + at.x + at.y)
            print(q != null)
        """)

@test("a value held across a call inside a loop is refused")
fcr_inside_a_loop()
    fcr_refused(raw"""
        work()
            for i in 0..<3
                val s = i.to_string()
                wait()
                print(s)
        """, "'s'", "sched.wait")

@test("a value declared before a loop is held across a call in the loop")
fcr_before_a_loop()
    fcr_refused(raw"""
        work()
            val s = 7.to_string()
            var i = 0
            while i < 3
                wait()
                i += 1
            print(s)
        """, "'s'", "sched.wait")

@test("a loop body whose value dies before the call is accepted")
fcr_loop_value_dies_first()
    fcr_accepted(raw"""
        work()
            for i in 0..<3
                if i > 0
                    val s = i.to_string()
                    print(s)
                wait()
        """)

@test("a closure that captured a counted value is itself a count held across the call")
fcr_closure_capture()
    fcr_refused(raw"""
        printer(s: string) -> &Fn() -> unit = () -> print(s)

        work()
            val f = printer("x" + "y")
            wait()
            f()
        """, "'f'", "sched.wait")

@test("a closure's own body is asked as a function's is")
fcr_closure_body()
    fcr_refused(raw"""
        run(f: &Fn() -> unit) = f()

        work()
            run(() ->
                val s = 1.to_string()
                wait()
                print(s))
        """, "'s'", "sched.wait")

@test("a counted temporary of the enclosing expression is held across a call in a later operand")
fcr_temporary()
    fcr_refused(raw"""
        made() -> string = "a" + "b"

        waited() -> int
            wait()
            1

        take(s: string, n: int) -> int = s.bytes.len + n

        work()
            print(take(made(), waited()))
        """, "a counted temporary the enclosing expression is still holding", "waited")

@test("a binding a 'match' took a share of is held across a call in its arm")
fcr_match_binding()
    fcr_refused(raw"""
        work(o: Option[string])
            o match
                Some(s) ->
                    wait()
                    print(s)
                None -> ()
        """, "a binding this arm took a share of", "sched.wait")

@test("an arm whose variant carries nothing counted holds nothing of the value matched -- avin's receive loop")
fcr_empty_variant_arm()
    fcr_accepted(raw"""
        made(n: int) -> Option[[]u8] = if n > 0 then Some([1, 2, 3]) else None

        receive(n: int) -> int
            loop
                made(n) match
                    Some(out) -> return int(out.len)
                    None -> wait()
        """)

@test("an arm whose variant carries a scalar holds nothing either, and a wildcard arm holds the value")
fcr_scalar_variant_arm()
    fcr_accepted(raw"""
        made(n: int) -> Result[string, int] = if n > 0 then Ok("x" + "y") else Err(n)

        work(n: int)
            made(n) match
                Ok(s) -> print(s)
                Err(code) ->
                    wait()
                    print(code)
        """)

    fcr_refused(raw"""
        made(n: int) -> Result[string, int] = if n > 0 then Ok("x" + "y") else Err(n)

        work(n: int)
            made(n) match
                Err(code) -> print(code)
                _ -> wait()
        """, "a counted temporary the enclosing expression is still holding", "sched.wait")

@test("a binding a shape takes through a '&T' is a share of the referent, held across the call in its arm")
fcr_match_through_reference()
    fcr_refused(raw"""
        struct Holder
            name: string

        work(h: &Holder)
            h match
                Holder(s) ->
                    wait()
                    print(s)
        """, "a binding this arm took a share of", "sched.wait")

    fcr_refused(raw"""
        struct Holder
            name: string

        work(o: Option[&Holder])
            o match
                Some(Holder(s)) ->
                    wait()
                    print(s)
                _ -> ()
        """, "a binding this arm took a share of", "sched.wait")

@test("a shape through a '&T' that binds nothing counted holds nothing across the call")
fcr_match_through_reference_binds_nothing()
    fcr_accepted(raw"""
        struct Holder
            name: string
            n: int

        work(h: &Holder)
            h match
                Holder(_, n) ->
                    wait()
                    print(n)
        """)

@test("a 'defer' holds nothing across a switch")
fcr_defer()
    fcr_accepted(raw"""
        work()
            defer print("done")
            wait()
        """)

@test("a member is asked as a function is")
fcr_member()
    fcr_refused(raw"""
        struct Reader
            n: int

            read(*self)
                val s = self.n.to_string()
                wait()
                print(s)
        """, "'s'", "sched.wait")

@test("'@pinned(thread)' on a function accepts what it holds across the switch")
fcr_pinned_function()
    fcr_accepted(raw"""
        @pinned(thread)
        work()
            val bytes: []u8 = [1, 2, 3]
            wait()
            switch(&pair.away, &pair.home)
            print(bytes.len)
        """)

@test("'@pinned(thread)' on a member accepts what it holds across the switch")
fcr_pinned_member()
    fcr_accepted(raw"""
        struct Reader
            n: int

            @pinned(thread)
            read(*self)
                val s = self.n.to_string()
                wait()
                print(s)
        """)

@test("'@pinned(thread)' covers its own body only: a function it calls is asked on its own")
fcr_pinned_is_per_body()
    fcr_refused(raw"""
        inner()
            val s = 1.to_string()
            wait()
            print(s)

        @pinned(thread)
        outer()
            val s = 2.to_string()
            inner()
            print(s)
        """, "'s'", "sched.wait")

@test("'main' runs on the main thread's own stack and holds what it likes")
fcr_main_is_pinned()
    fcr_accepted(raw"""
        main()
            val stack = Stack.reserve(64 * 1024).unwrap()
            val name = "a" + "b"
            wait()
            print(name)
            print(stack.len() > 0)
        """)

@test("'@pinned' takes no argument but 'thread'")
fcr_pinned_other_argument()
    if xvr_no_library() then return

    val said = fcr_ir(raw"""
        @pinned(core)
        work() = ()
        """)

    assert(said.contains("'@pinned' takes no argument but 'thread' — '@pinned' alone says every caller keeps the function on one core, and '@pinned(thread)' that the fiber it runs on is only ever resumed on the thread it began on"), said)

@test("'@pinned(thread)' does not stand above a struct, which has no body to resume")
fcr_pinned_thread_on_struct()
    if xvr_no_library() then return

    val said = fcr_ir(raw"""
        @pinned(thread)
        struct S
            n: int
        """)

    assert(said.contains("an annotation marks a function, and only a function"), said)

// A view that owns no count of its own, lent to a call that reaches the switch, is held across nothing
// (`memory.md § Views own their heap storage, and a lent view takes no count`): a literal's bytes, a view
// of a frame array, of a raw pointer or of a module `val` array (all with a null owner), a parameter
// passed straight through, and a view of a view parameter, lent while the caller's count holds the
// storage. Each shape is asked with the short string form off and on.
private fcr_lent(body: string)
    force_short_strings(false)
    fcr_accepted(body)
    force_short_strings(true)
    fcr_accepted(body)
    unforce_short_strings()

// The same refusal, asked with the short string form off and on.
private fcr_held_both(body: string, held: string, callee: string)
    force_short_strings(false)
    fcr_refused(body, held, callee)
    force_short_strings(true)
    fcr_refused(body, held, callee)
    unforce_short_strings()

private fcr_send() -> string = raw"""
    send(b: []const u8) -> usize
        wait()
        b.len

    """

@test("a literal's bytes lent to a call that reaches the switch hold no count")
fcr_lent_literal_bytes()
    fcr_lent(fcr_send() + raw"""
        work() -> usize = send("ping".bytes)
        """)

@test("a view of a frame array lent to a call that reaches the switch holds no count")
fcr_lent_frame_array()
    fcr_lent(fcr_send() + raw"""
        work() -> usize
            var a: [16]u8 = [0; 16]
            send(a[0..<16])
        """)

@test("a view of a raw pointer lent to a call that reaches the switch holds no count")
fcr_lent_raw_pointer()
    fcr_lent(fcr_send() + raw"""
        work(p: *u8, n: usize) -> usize = send(p[0..<n])
        """)

@test("a view of a module 'val' array lent to a call that reaches the switch holds no count")
fcr_lent_val_array()
    fcr_lent(fcr_send() + raw"""
        val table: [4]u8 = [1, 2, 3, 4]

        work() -> usize = send(table[1..<3])
        """)

@test("a 'string' parameter passed straight through, and its bytes, hold no count of the frame's")
fcr_lent_string_parameter()
    fcr_lent(raw"""
        send(s: string) -> usize
            wait()
            s.len

        bytes(b: []const u8) -> usize
            wait()
            b.len

        work(s: string) -> usize = send(s) + bytes(s.bytes)
        """)

@test("a slice of a slice parameter, and of a slice of one, lent to a call that reaches the switch holds no count")
fcr_lent_slice_of_parameter()
    fcr_lent(fcr_send() + raw"""
        work(b: []const u8) -> usize = send(b[1..<3]) + send(b[0..<4][1..<2])
        """)

@test("a view of a frame array inside a struct local holds no count")
fcr_lent_array_in_struct()
    fcr_lent(fcr_send() + raw"""
        struct Frame
            data: [8]u8

        work() -> usize
            val f = Frame([0; 8])
            send(f.data[0..<4])
        """)

@test("a call that returns a '&T', lent as a temporary across a later reaching call, is still refused")
fcr_ref_result_temporary()
    fcr_refused(raw"""
        made() -> &Box = Box(1)

        waited() -> int
            wait()
            1

        take(b: &Box, n: int) -> int = b.n + n

        work()
            print(take(made(), waited()))
        """, "a counted temporary the enclosing expression is still holding", "waited")

@test("a fresh heap string built in the argument is still refused")
fcr_fresh_string_argument()
    fcr_refused(raw"""
        send(s: string) -> usize
            wait()
            s.len

        work(a: string) -> usize = send(a + "!")
        """, "a counted temporary the enclosing expression is still holding", "send")

@test("a fresh heap string's bytes, or a view of one, are still refused")
fcr_fresh_string_view()
    fcr_held_both(fcr_send() + raw"""
        work(a: string) -> usize = send((a + "!").bytes[0..<1])
        """, "a counted temporary the enclosing expression is still holding", "send")

// A `Buf` parameter's name does not hold its storage (a growth through any other name gives it up), so
// a view of it takes a count of the storage itself -- a count that is not atomic, held across the call.
@test("a view of a heap 'Buf' lent to a call that reaches the switch is refused")
fcr_buf_view_refused()
    fcr_refused("import sysl.buf.Buf\n\n" + fcr_send() + raw"""
        work(b: Buf[u8]) -> usize = send(b.view()[0..<1])
        """, "a counted temporary the enclosing expression is still holding", "send")

// An array inside the referent of a `&T` parameter, lent as a temporary, is lent while the caller's
// count holds the box -- the view takes none. Behind a second reference it is not: the first referent
// may let go of the second while the fiber is parked.
@test("a view of an array inside a '&T' parameter's referent, lent as a temporary, holds no count")
fcr_lent_reference_parameter_array()
    fcr_lent(fcr_send() + raw"""
        struct Inner
            data: [8]u8

        struct Holder
            data: [8]u8
            inner: Inner
            rows: [2][4]u8

        work(h: &Holder) -> usize = send(h.data[0..<4]) + send(h.inner.data[1..<3]) + send(h.rows[1][0..<2])
        """)

@test("a view of an array behind a second reference, lent as a temporary, is still refused")
fcr_reference_behind_reference_refused()
    fcr_held_both(fcr_send() + raw"""
        struct Inner
            data: [8]u8

        struct Holder
            inner: &Inner

        work(h: &Holder) -> usize = send(h.inner.data[0..<4])
        """, "a counted temporary the enclosing expression is still holding", "send")

// -- a local holding a view that owns no count ---------------------------------------------------------
//
// A local is held only where the frame owns a count through it (`library/fiber.md § A count held
// across a switch is refused`). A view with a null owner -- a literal's bytes, a view of a raw pointer,
// of an array laid in the frame or in module storage, or of another such local -- owns none, so the
// local holding it holds nothing. The local loses that where the rest of its block may make it own one:
// a write of a counted value, its address taken, a `ref` bound to it. A view of a parameter's own
// storage -- a slice of a view parameter, a string parameter's bytes or a cut of it, an array inside a
// `&T` parameter's referent -- takes no count either (`param_views.sysl`, the predicate the emitter
// asks too; its IR and runs are `tests_pvl_`), so long as the parameter stays put and is never used
// whole, and the local is only read or handed to a call.
//
// Cells skipped: a generic body (its instantiations are walked as any other body); a lent local
// captured by a closure (the closure is a count of its own, held as `fcr_closure_capture` pins); a
// write after the call, refused like one before it, since the walk does not order the rest of a block.

@test("a local holding a literal's bytes, or a literal 'string', holds nothing across the call")
fcr_local_literal_bytes()
    fcr_lent(fcr_send() + raw"""
        work() -> usize
            val s = "ping".bytes
            val t = "pong"
            send(s) + send(t.bytes)
        """)

@test("a local holding a view of a frame array, or of one inside a struct local, holds nothing across the call")
fcr_local_frame_array()
    fcr_lent(fcr_send() + raw"""
        struct Frame
            data: [8]u8

        work() -> usize
            var a: [16]u8 = [0; 16]
            val f = Frame([0; 8])
            val s = a[0..<16]
            val t = f.data[0..<4]
            send(s) + send(t)
        """)

@test("a local holding a view of a raw pointer holds nothing across the call -- the reported shape")
fcr_local_raw_pointer()
    fcr_lent(fcr_send() + raw"""
        work(p: *u8, n: usize) -> usize
            val s = p[0..<n]
            send(s)
        """)

@test("a local holding a view of a module 'val' array holds nothing across the call")
fcr_local_val_array()
    fcr_lent(fcr_send() + raw"""
        val table: [4]u8 = [1, 2, 3, 4]

        work() -> usize
            val s = table[1..<3]
            send(s)
        """)

@test("a local holding a view of another such local, or a copy of one, holds nothing across the call")
fcr_local_view_of_local()
    fcr_lent(fcr_send() + raw"""
        work(p: *u8, n: usize) -> usize
            val s = p[0..<n]
            val t = s[0..<1]
            val u = t
            send(u)
        """)

@test("a 'var' view reassigned another view that owns no count before the call holds nothing")
fcr_local_reassigned_before()
    fcr_lent(fcr_send() + raw"""
        work(p: *u8, q: *u8, n: usize) -> usize
            var s: []const u8 = p[0..<n]
            s = q[0..<1]
            if n > 2 then s = "ab".bytes
            send(s)
        """)

@test("a lent local used again after the call, and across a call in a loop, holds nothing")
fcr_local_used_after()
    fcr_lent(fcr_send() + raw"""
        work(p: *u8, n: usize) -> usize
            val s = p[0..<n]
            var k: usize = 0

            for i in 0..<3
                k += send(s) + i

            k + send(s) + s.len
        """)

@test("a local holding a heap string, or its bytes, is still refused")
fcr_local_heap_string_refused()
    fcr_held_both(fcr_send() + raw"""
        work(a: string) -> usize
            val s = a + "!"
            send(s.bytes)
        """, "'s'", "send")
    fcr_held_both(fcr_send() + raw"""
        work(a: string) -> usize
            val s = (a + "!").bytes
            send(s)
        """, "'s'", "send")

@test("a local holding a '&T' or a closure is still refused")
fcr_local_reference_and_closure_refused()
    fcr_held_both(fcr_send() + raw"""
        work() -> usize
            val b: &Box = Box(1)
            send("x".bytes) + usize(b.n)
        """, "'b'", "send")
    fcr_held_both(fcr_send() + raw"""
        work(a: string) -> usize
            val f: &Fn() -> unit = () -> print(a)
            val n = send("x".bytes)
            f()
            n
        """, "'f'", "send")

@test("a local holding a view of a view parameter, handed to a call that reaches the switch, holds nothing")
fcr_local_view_of_parameter()
    fcr_lent(fcr_send() + raw"""
        work(b: []const u8) -> usize
            val s = b[0..<1]
            send(s)
        """)

@test("a local holding a view of a '&T' parameter's array holds nothing -- the caller holds the box")
fcr_local_reference_parameter_array()
    fcr_lent(fcr_send() + raw"""
        struct Holder
            data: [8]u8

        work(h: &Holder) -> usize
            val s = h.data[0..<4]
            send(s)
        """)

@test("a view behind a second reference, bound to a local, is still refused")
fcr_local_second_reference_refused()
    fcr_held_both(fcr_send() + raw"""
        struct Inner
            data: [8]u8

        struct Outer
            inner: &Inner

        work(h: &Outer) -> usize
            val s = h.inner.data[0..<4]
            send(s)
        """, "'s'", "send")

@test("avin's two shapes: a slice of a slice parameter in a loop, and a string parameter's bytes")
fcr_local_avin_shapes()
    fcr_lent(raw"""
        send_all(bytes: []const u8) -> usize
            var at: usize = 0

            while at < bytes.len
                val rest = bytes[at..<bytes.len]
                wait()
                at += rest.len

            at

        prompt(said_from: string) -> usize
            val said = said_from.bytes
            wait()
            said.len
        """)

@test("a slice of such a local, a cut of a string parameter, and a '[]T' the body writes through hold nothing")
fcr_local_parameter_view_shapes()
    fcr_lent(fcr_send() + raw"""
        work(b: []const u8, s: string, w: []u8) -> usize
            val r = b[1..<4]
            val q = r[0..<2]
            val c = s[0..<2]
            val part = w[0..<2]
            w[0] = 1
            wait()
            part[1] = 2
            q.len + c.len + send(r) + part.len
        """)

@test("a view of a parameter reassigned, or whose address is taken, is refused")
fcr_local_parameter_moves_refused()
    fcr_held_both(fcr_send() + raw"""
        work(b: []const u8, c: []const u8) -> usize
            val s = b[0..<1]
            wait()
            b = c
            s.len
        """, "'s'", "sched.wait")
    fcr_held_both(fcr_send() + raw"""
        look(p: *[]const u8) -> usize = (*p).len

        work(b: []const u8) -> usize
            val s = b[0..<1]
            wait()
            s.len + look(&b)
        """, "'s'", "sched.wait")

@test("a view of a parameter that is also used whole is refused")
fcr_local_parameter_used_whole_refused()
    fcr_held_both(fcr_send() + raw"""
        work(b: []const u8) -> usize
            val s = b[0..<1]
            wait()
            s.len + send(b)
        """, "'s'", "sched.wait")

@test("a view of a parameter returned, stored into a field, or captured by a kept closure is refused")
fcr_local_parameter_view_escapes_refused()
    fcr_held_both(fcr_send() + raw"""
        work(b: []const u8) -> []const u8
            val s = b[0..<1]
            wait()
            s
        """, "'s'", "sched.wait")
    fcr_held_both(fcr_send() + raw"""
        struct Keep
            v: []const u8

        work(k: &Keep, b: []const u8) -> usize
            val s = b[0..<1]
            wait()
            k.v = s
            1
        """, "'s'", "sched.wait")
    fcr_held_both(fcr_send() + raw"""
        var kept: Option[&Fn() -> usize] = None

        work(b: []const u8) -> usize
            val s = b[0..<1]
            wait()
            kept = Some(() -> s.len)
            1
        """, "'s'", "sched.wait")

@test("a view of a parameter captured by a closure crossing threads is refused")
fcr_local_parameter_view_sync_capture_refused()
    if xvr_no_library() then return

    val said = fcr_ir(fcr_send() + raw"""
        work(b: []const u8) -> usize
            val s = b[0..<1]
            val f: &sync Fn() -> usize = () -> s.len
            f()
        """)

    assert(said.contains("error:"), said)

@test("a string parameter's bytes handed to a call, or named in a 'defer', are held and refused")
fcr_local_parameter_bytes_handed_refused()
    fcr_held_both(fcr_send() + raw"""
        work(said_from: string) -> usize
            val said = said_from.bytes
            send(said)
        """, "'said'", "send")
    fcr_held_both(fcr_send() + raw"""
        work(b: []const u8) -> usize
            val s = b[0..<1]
            defer print(s.len)
            send("x".bytes)
        """, "'s'", "send")

@test("a lent local written a counted value before the call, even in a branch, is refused")
fcr_local_rebound_counted_refused()
    fcr_held_both(fcr_send() + raw"""
        work(p: *u8, n: usize, a: string) -> usize
            var s: []const u8 = p[0..<n]
            s = (a + "!").bytes
            send(s)
        """, "'s'", "send")
    fcr_held_both(fcr_send() + raw"""
        work(p: *u8, n: usize, a: string) -> usize
            var s: []const u8 = p[0..<n]
            if n > 2 then s = (a + "!").bytes
            send(s)
        """, "'s'", "send")
    fcr_held_both(fcr_send() + raw"""
        work(p: *u8, n: usize, b: []const u8) -> usize
            var s: []const u8 = p[0..<n]
            s = b
            send(s)
        """, "'s'", "send")

@test("a lent local whose address is taken, or that a 'ref' names, is refused")
fcr_local_address_taken_refused()
    fcr_held_both(fcr_send() + raw"""
        put(into: *[]const u8, a: string) = *into = (a + "!").bytes

        work(p: *u8, n: usize, a: string) -> usize
            var s: []const u8 = p[0..<n]
            put(&s, a)
            send(s)
        """, "'s'", "send")
    fcr_held_both(fcr_send() + raw"""
        work(p: *u8, n: usize, a: string) -> usize
            var s: []const u8 = p[0..<n]
            ref r = s
            r = (a + "!").bytes
            send(s)
        """, "'s'", "send")

// -- a frame array promoted to the heap ------------------------------------------------------------
//
// An array a view of which outlives the frame lives in a counted buffer (`escape.sysl`), and the box is
// the frame's own count from the declaration to the end of its block -- released with a plain
// decrement. So the array is held across a reaching call, and a view of it lends nothing, whether it
// is lent as a temporary or bound to a local. The same array the escape analysis leaves in the frame
// holds nothing. Not here: a promoted temporary array (`[0; 16][0..<n]` returned), whose box is made in
// the statement that lets it out, so no call is made across it.

private fcr_promoted() -> string = "the array 'a' (promoted to the heap, because a view of it outlives the frame)"

@test("a promoted frame array lent as a temporary across a reaching call is refused, naming the array")
fcr_promoted_array_inline_refused()
    fcr_held_both(fcr_send() + raw"""
        work(n: usize) -> []u8
            var a: [16]u8 = [0; 16]
            send(a[0..<2])
            a[0..<n]
        """, fcr_promoted(), "send")

@test("a local view of a promoted frame array held across a reaching call is refused, naming the array")
fcr_promoted_array_local_view_refused()
    fcr_held_both(fcr_send() + raw"""
        work(n: usize) -> []u8
            var a: [16]u8 = [0; 16]
            val v = a[0..<2]
            send(v)
            a[0..<n]
        """, fcr_promoted(), "send")

@test("a promoted array is held to the end of its block: a last use before the call is still refused")
fcr_promoted_array_used_before_refused()
    fcr_held_both(fcr_send() + raw"""
        work(n: usize) -> []u8
            var a: [16]u8 = [0; 16]
            val out = a[0..<n]
            send("ping".bytes)
            out
        """, fcr_promoted(), "send")
    fcr_held_both(raw"""
        work(n: usize) -> []u8
            var a: [16]u8 = [0; 16]
            val out = a[0..<n]
            wait()
            out
        """, fcr_promoted(), "sched.wait")

@test("a promoted array of arrays, lent a view of one element across the call, is refused")
fcr_promoted_array_nested_refused()
    fcr_held_both(fcr_send() + raw"""
        work(n: usize) -> []u8
            var a: [2][8]u8 = [[0; 8], [0; 8]]
            send(a[1][0..<2])
            a[0][0..<n]
        """, fcr_promoted(), "send")

@test("the same frame array with no view outliving the frame holds nothing across the call")
fcr_unpromoted_array_accepted()
    fcr_lent(fcr_send() + raw"""
        work(n: usize) -> u8
            var a: [16]u8 = [0; 16]
            send(a[0..<2])
            val v = a[0..<n]
            send(v)
            a[0]
        """)

@test("a promoted array whose block ends before the call holds nothing across it")
fcr_promoted_array_dead_before_accepted()
    fcr_lent(fcr_send() + raw"""
        work(n: usize, b: []u8) -> []u8
            if n > 8
                var a: [16]u8 = [0; 16]
                return a[0..<n]
            send("ping".bytes)
            b
        """)

@test("a promoted array declared after the call holds nothing across it")
fcr_promoted_array_declared_after_accepted()
    fcr_lent(fcr_send() + raw"""
        work(n: usize) -> []u8
            send("ping".bytes)
            var a: [16]u8 = [0; 16]
            a[0..<n]
        """)

@test("'@pinned(thread)' accepts a promoted array held across the switch")
fcr_promoted_array_pinned_accepted()
    fcr_lent(fcr_send() + raw"""
        @pinned(thread)
        work(n: usize) -> []u8
            var a: [16]u8 = [0; 16]
            val v = a[0..<2]
            send(a[0..<2])
            send(v)
            a[0..<n]
        """)

