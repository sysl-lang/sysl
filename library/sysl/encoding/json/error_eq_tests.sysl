module sysl.encoding.json
@tests

@test("eqe: json Fault is equal variant by variant and payload by payload")
eqe_json_fault()
    assert(Fault.Trailing == Fault.Trailing)
    assert(Fault.Expected("a") == Fault.Expected("a"))
    assert(Fault.Expected("a") != Fault.Expected("b"))
    assert(Fault.Ended("a") == Fault.Ended("a"))
    assert(Fault.Ended("a") != Fault.Ended("b"))
    assert(Fault.Ended("a") != Fault.Expected("a"))
    assert(Fault.Trailing != Fault.Ended("a"))

@test("eqe: JsonError is equal when fault, line, column and offset all agree")
eqe_json_error()
    val e = JsonError(Fault.Trailing, 1, 2, 3)
    assert(e == JsonError(Fault.Trailing, 1, 2, 3))
    assert(e != JsonError(Fault.Ended("x"), 1, 2, 3))
    assert(e != JsonError(Fault.Trailing, 2, 2, 3))
    assert(e != JsonError(Fault.Trailing, 1, 3, 3))
    assert(e != JsonError(Fault.Trailing, 1, 2, 4))

@test("eqe: Result and Option[Result] over JsonError compare with ==")
eqe_json_result()
    val bad = parse("[1] x")
    assert(bad.is_err())
    val r: Result[int, JsonError] = Err(JsonError(Fault.Trailing, 1, 2, 3))
    assert(r == Err(JsonError(Fault.Trailing, 1, 2, 3)))
    assert(r != Err(JsonError(Fault.Trailing, 1, 2, 4)))
    assert(r != Ok(1))
    val o: Option[Result[int, JsonError]] = Some(r)
    assert(o == Some(Err(JsonError(Fault.Trailing, 1, 2, 3))))
    assert(o != Some(Err(JsonError(Fault.Ended("x"), 1, 2, 3))))
    assert(o != None)
