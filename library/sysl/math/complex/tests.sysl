module sysl.math.complex
@tests
@requires(heap)

// How a `Complex` renders, asserted in sysl.
//
// The rest of this module's tests are in Scala, and `ComplexTests` says why: nearly every claim here
// is about arithmetic run at two widths, and a compiler that had quietly widened every `f32` to a
// `real` would compile an `f32` expectation into the widened one and agree with itself. **Text is
// not that kind of claim** -- the expectation is a run of bytes either way -- so it belongs in the
// same language as the code, where a reader of the module can see what it renders as.
//
// **The width and the precision are the two halves worth pinning**, because they are the two the
// implementation has to keep apart. A specifier describes the field the *whole* value occupies, so a
// width pads the four pieces once between them and never inside a number. A precision is what each
// renderer reads in its own terms, so it asks for significant digits in each half. That second one
// used to truncate the finished text instead, and `%.3s` on a value near a third answered `0.3`.

@test("a+bi, with the sign of the imaginary part written out")
rendering()
    assert_eq(str(Complex(3.0, 4.0)), "3+4i")
    assert_eq(str(Complex(3.0, -4.0)), "3-4i", "and never a '+-'")
    assert_eq(str(Complex(-3.0, 0.0)), "-3+0i", "a zero imaginary part takes the positive sign")

@test("the width is the whole value's field rather than each part's")
the_width_is_the_whole_values()
    val z = Complex(1.0, -2.0)

    assert_eq(f"[${z}%12s]", "[        1-2i]")
    assert_eq(f"[${z}%-12s]", "[1-2i        ]", "left-justified")
    assert_eq(f"[${z}%3s]", "[1-2i]", "a field narrower than the value is no field at all")

@test("the precision reaches the parts, which is what a precision means for a number")
the_precision_reaches_the_parts()
    val z = Complex(1.0 / 3.0, -2.0 / 3.0)

    assert_eq(f"[${z}%.3s]", "[0.333-0.667i]")
    assert_eq(f"[${z}%20.3s]", "[        0.333-0.667i]", "and the width measures what that came to")
