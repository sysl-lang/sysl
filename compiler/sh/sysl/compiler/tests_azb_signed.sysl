module sh.sysl.compiler
@tests

import sysl.text.Search

// `sysl.math.Signed`, whose membership is the compiler's rather than a written `impl`
// (`reference/expressions.md § Operator dispatch`): the integers are an open family, so `i5` has
// `abs` and `signum` on the same rule as `int`. A membership says which TYPES have a member; it is no
// way round `reference/modules.md § Visibility`, so the trait still has to be in scope.

private val azb_signed: string = "import sysl.math.Signed\n\n"

private val azb_bump: string = raw"""
    bump() -> int
        print("called")
        -5
    end bump

    """

@test("is the value without its sign")
azb_sgn_the_value_without_its_sign()
    if !azb_ready() then return

    azb_prints(azb_main(azb_signed + raw"""
        main()
            var a = -7
            var b = 7
            print(a.abs(), b.abs(), (0).abs())
        """), "7 7 0\n")

@test("reaches every signed width, including ones no impl could have been written for")
azb_sgn_every_signed_width()
    if !azb_ready() then return

    azb_prints(azb_main(azb_signed + raw"""
        main()
            var a: i8 = -128
            var b: i64 = -9000000000
            var c: i16 = -300
            print(a.abs(), b.abs(), c.abs())
        """), "-128 9000000000 300\n")

// Plain integer arithmetic wraps, so the magnitude of the most negative value is what `-` gives.
@test("answers the most negative value with itself, as negation does")
azb_sgn_the_most_negative_value()
    if !azb_ready() then return

    azb_prints(azb_main(azb_signed + raw"""
        main()
            var a: i8 = -128
            print(a.abs() == a, -a == a)
        """), "true true\n")

@test("evaluates its receiver once")
azb_sgn_abs_reads_its_receiver_once()
    if !azb_ready() then return

    azb_prints(azb_main(azb_signed + azb_bump + "main()\n    print(bump().abs())\n"), "called\n5\n")

@test("is minus one, zero, or one, at the receiver's own type")
azb_sgn_signum()
    if !azb_ready() then return

    azb_prints(azb_main(azb_signed + raw"""
        main()
            var a = -7
            print((-7).signum(), (0).signum(), (7).signum(), a.signum() * a)
        """), "-1 0 1 7\n")

@test("evaluates its receiver once too")
azb_sgn_signum_reads_its_receiver_once()
    if !azb_ready() then return

    azb_prints(azb_main(azb_signed + azb_bump + "main()\n    print(bump().signum())\n"), "called\n-1\n")

// An unsigned value has no sign to discard, so the member would be the identity.
@test("an unsigned integer has neither")
azb_sgn_unsigned_has_neither()
    if !azb_ready() then return

    azb_refused(azb_main(azb_signed + "main()\n    var a: u8 = 7\n    print(a.abs())\n"), ["abs"])

// `Float` declares its own `abs` over `fabs`, which sees the sign bit -- so `(-0.0).abs()` is `0`.
@test("a float's magnitude is Float's, and it is the one that sees a negative zero")
azb_sgn_a_float_is_floats()
    if !azb_ready() then return

    azb_refused(azb_main(azb_signed + "main()\n    var x: real = -0.0\n    print(x.abs())\n"), ["abs"])
    azb_prints(azb_main("import sysl.math.Float\n\nmain()\n    var x: real = -0.0\n    print(x.abs())\n"),
               "0\n")

// The operator traits' memberships are supplied the same way and need no import, which is what says
// the gate is about the module and not the mechanism.
@test("the trait still has to be in scope, membership or not")
azb_sgn_the_trait_has_to_be_in_scope()
    if !azb_ready() then return

    azb_refused(azb_main("main()\n    print((-7).abs())\n"), ["abs"])
    azb_prints(azb_main("main()\n    print((5).add(3), 2 + 2)\n"), "8 4\n")

// A membership is a fact the type system holds rather than code: nothing is emitted for the trait.
@test("a membership emits no function")
azb_sgn_a_membership_emits_no_function()
    if !azb_ready() then return

    val cs = azb_compilers()

    for i in 0..<cs.len()
        val out = azb_ir(azb_signed + "main()\n    print((-7).abs())\n", cs.at(i))
        val who = azb_who(cs.at(i))

        assert(!out.contains("@Signed"), who)
        assert(!out.contains("sysl.math$Signed"), who)
        assert(out.contains("select"), s"$who: no select in\n$out")
end azb_sgn_a_membership_emits_no_function
