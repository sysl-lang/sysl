module sysl

/** A value that may be absent. This is an ordinary generic enum rather than anything the analyzer
 * builds: what the compiler knows is that `?` unwraps it and which variant means which, and it asks
 * `Library.tryVariants` for that rather than spelling the names.
 *
 * `unwrap` and `expect` stop the program through `exit`, which is what `11-error-handling.md` says a
 * trap does under the `os` capability -- so neither needs compiler support of its own.
 */
enum Option[T]
    Some(value: T)
    None

    is_some(self) -> bool = self match
        Some(_) -> true
        None -> false

    is_none(self) -> bool = !self.is_some()

    unwrap_or(self, default: T) -> T = self match
        Some(v) -> v
        None -> default

    unwrap(self) -> T = self match
        Some(v) -> v
        None ->
            print("panic: unwrap of a None value")
            exit(1)

    expect(self, msg: string) -> T = self match
        Some(v) -> v
        None ->
            print("panic:", msg)
            exit(1)

    /** The default computed rather than passed, for a default that costs something to make.
     *
     * `unwrap_or` evaluates its argument whether or not it is wanted, which is right for a constant
     * and wrong for anything that reads a file or builds a string.
     */
    unwrap_or_else(self, f: () -> T) -> T = self match
        Some(v) -> v
        None -> f()

    /** The payload transformed, absence carried through.
     *
     * This is the transforming half of the surface, and the reason it is here rather than left to
     * each caller: `o match Some(v) -> Some(g(v)); None -> None` is four lines that say one thing,
     * and written by hand at every call it is four lines somebody can get wrong in one of them.
     */
    map[U](self, f: T -> U) -> Option[U] = self match
        Some(v) -> Some(f(v))
        None -> None

    /** The same for a function that may itself answer nothing, which is what keeps the two from
     * nesting: `map` of an `Option`-returning function is an `Option[Option[U]]` and this is not.
     */
    and_then[U](self, f: T -> Option[U]) -> Option[U] = self match
        Some(v) -> f(v)
        None -> None

    /** Another option where this one is absent -- the first that has something wins. */
    or_else(self, f: () -> Option[T]) -> Option[T] = self match
        Some(v) -> Some(v)
        None -> f()

    /** Absent unless the payload passes -- `Some(4).filter(even)` is `Some(4)` and `Some(5)` is
     * `None`.
     */
    filter(self, pred: T -> bool) -> Option[T] = self match
        Some(v) -> if pred(v) then Some(v) else None
        None -> None

    /** The crossing into the other enum: absence becomes the error the caller names.
     *
     * It is what makes a lookup usable in a body that propagates with `?`, which is the whole reason
     * the two types need a way across at all.
     */
    ok_or[E](self, e: E) -> Result[T, E] = self match
        Some(v) -> Ok(v)
        None -> Err(e)
end Option

/** Two options are equal when they are absent alike, or present with equal payloads -- which is the
 * only reading that keeps `==` agreeing with `match`. The bound is on the payload rather than on the
 * whole, so an `Option` of something incomparable simply is not comparable, and says so at the
 * comparison rather than at the declaration.
 */
impl[T: Eq] Eq for Option[T]
    eq(self, rhs: Self) -> bool
        self match
            Some(a) ->
                rhs match
                    Some(b) -> a == b
                    None -> false
            None -> rhs.is_none()
    end eq

/** The variant, and the payload inside it where there is one, written straight through to wherever
 * it is going. The payload gets a plain specifier, because the field a specifier describes is the
 * whole option and not what it happens to be carrying (`library/core.md § A specifier is the whole
 * value's field`).
 */
private render_option[T: Display](x: Option[T], out: *Writer)
    x match
        Some(v) ->
            out.write("Some(".bytes)
            v.display(out, FormatSpec(0, -1, false))
            out.write(")".bytes)
        None -> out.write("None".bytes)
end render_option

/** An option renders as it is written -- `Some(3)` or `None` -- which is what makes a failed
 * `assert_eq` on one readable at all. `Eq` alone would not have been enough: `assert_eq` is bounded
 * over `Eq + Display`, so a comparable option nothing could render would still have been refused.
 *
 * The width is honoured by rendering twice into a counter first, exactly as a slice does: a field is
 * the whole value, so the padding cannot be decided until the length of the whole is known, and
 * measuring this way costs no allocation.
 */
impl[T: Display] Display for Option[T]
    display(self, out: *Writer, fmt: FormatSpec)
        var pad = 0

        if fmt.width > 0
            var count = Counting(0)
            var sink: *Writer = &count

            render_option(self, sink)
            pad = fmt.width - int(count.n)

            if pad < 0 then pad = 0

        if !fmt.left then display_fill(out, 32, pad)

        render_option(self, out)

        if fmt.left then display_fill(out, 32, pad)
    end display
end Option[T]
