module sh.sysl.compiler
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.Search
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture

// A struct with NO FIELDS, ported from the reference's `FieldlessStructTests` case for case: one
// value carrying no data, written `struct Name` closed by `end Name`. Emptiness is written rather than
// inferred, because a struct with an empty body and one whose body its author forgot to indent look
// identical -- so a lone `struct Name` is still the mistake it always was.
//
// What wants one is a SINK: a value standing for a destination fixed at compile time, which has
// nothing to keep. A sink that is a value rather than a global can be passed, held and chosen.
//
// **Every output and diagnostic quoted here was read out of the reference compiler** (0.0.154) on the
// same program.

private var fpx_library_cache: Buf[Program] = buf()
private var fpx_library_read: bool = false

private fpx_library() -> Buf[Program]
    if fpx_library_read then return fpx_library_cache

    fpx_library_read = true

    std_root() match
        Err(_) -> ()
        Ok(root) -> std_units(root, host_target()) match
            Err(_) -> ()
            Ok(units) -> fpx_library_cache = units

    fpx_library_cache
end fpx_library

private fpx_ready() -> bool
    if fpx_library().is_empty()
        print("skipped: the standard module's source is not on this machine")
        return false
    end if

    if !clang_available()
        print("skipped: there is no clang on this machine")
        return false
    end if

    true
end fpx_ready

private fpx_says(text: string, part: string) -> bool = text.index_of(part).is_some()

// What a program PRINTS.
private fpx_ran(text: string) -> string
    val root = make_temp_dir("sysl-fpx").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", text).unwrap()

    val exe = s"$root/built"

    build_native_program(s"$root/main.sysl", None, None, DefaultOptimization, Some(exe)) match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return failure_text(why)
        Ok(_) -> ()

    val said = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    said match
        Err(_) -> "the program that was built could not be run"
        Ok(out) -> out.text
end fpx_ran

// What a program that is meant to STOP exits with: a trap is `128 + n`, and `-1` is a program that did
// not build, which must not read as a stop.
private fpx_stopped(text: string) -> int
    val root = make_temp_dir("sysl-fpx-stop").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", text).unwrap()

    var args: Buf[string] = buf()

    val code = run_native_program(s"$root/main.sysl", None, None, DefaultOptimization, args) match
        Err(_) -> -1
        Ok(state) -> state

    remove_dir_all(root).unwrap_or(())
    code
end fpx_stopped

// The LLVM text a program lowers to -- or, where it is refused, what it was refused with.
private fpx_ir(text: string) -> string
    val root = make_temp_dir("sysl-fpx-ir").unwrap()
    val src = s"$root/main.sysl"

    make_dir_all(root).unwrap()
    write_text(src, text).unwrap()

    val out = emit_llvm_text(src, None) match
        Err(why) -> failure_text(why)
        Ok(made) -> if made.report.is_empty() then made.text else analysis_report(made.report)

    remove_dir_all(root).unwrap_or(())
    out
end fpx_ir

// Everything a source has to say for itself, taken the whole way through the lowering.
private fpx_err(text: string) -> string
    val root = make_temp_dir("sysl-fpx-err").unwrap()
    val src = s"$root/main.sysl"

    make_dir_all(root).unwrap()
    write_text(src, text).unwrap()

    val out = emit_llvm_text(src, None) match
        Err(why) -> why.message
        Ok(made) -> if made.report.is_empty() then "" else analysis_report(made.report)

    remove_dir_all(root).unwrap_or(())
    out
end fpx_err

// The same, for a program of two files: the module `sq` beside the beginning.
private fpx_err_of(module_text: string, main_text: string) -> string
    val root = make_temp_dir("sysl-fpx-err").unwrap()

    make_dir_all(s"$root/sq").unwrap()
    write_text(s"$root/sq/lib.sysl", module_text).unwrap()
    write_text(s"$root/main.sysl", main_text).unwrap()

    val out = emit_llvm_text(root, None) match
        Err(why) -> why.message
        Ok(made) -> if made.report.is_empty() then "" else analysis_report(made.report)

    remove_dir_all(root).unwrap_or(())
    out
end fpx_err_of

// A writer standing for standard output, and a `show` that renders through it -- the sink the
// language change is for, written entirely in sysl.
private fpx_stdout() -> string =
    "struct Stdout\nend Stdout\n\nimpl Fallible for Stdout\n\nimpl Writer for Stdout\n" +
    "    write(*self, bytes: []const u8) = putbytes(bytes)\nend Stdout\n\n" +
    "show[T: Display](x: T)\n    var out = Stdout()\n\n" +
    "    x.display(&out, FormatSpec(0, -1, false))\n    printc('\\n')\nend show\n"

// A type rendering itself, and a `report` writing it into whatever sink it is handed.
private fpx_point() -> string =
    "struct Point\n    x: int\n    y: int\nend Point\n\nimpl Display for Point\n" +
    "    display(self, out: *Writer, fmt: FormatSpec)\n        display_str(\"pt(\", out, fmt)\n" +
    "        display_int(long(self.x), out, fmt)\n        display_str(\")\", out, fmt)\nend Point\n\n" +
    "report(where: *Writer, p: Point)\n    p.display(where, FormatSpec(0, -1, false))\n" +
    "    where.write(\"\\n\".bytes)\nend report\n"

// -- the declaration ---------------------------------------------------------------------------------

@test("a struct with no fields is written closed by its 'end'")
fpx_a_fieldless_struct_is_closed_by_its_end()
    if !fpx_ready() then return

    assert_eq(fpx_ran("struct Marker\nend Marker\n\nvar m = Marker()\n\nprint(\"made one\")\n"),
        "made one\n")

@test("it takes methods like any other struct")
fpx_it_takes_methods()
    if !fpx_ready() then return

    assert_eq(fpx_ran("struct Marker\n    tag(self) -> int = 5\nend Marker\n\nprint(Marker().tag())\n"),
        "5\n")

@test("a lone 'struct Name' is still the misindented body it usually is")
fpx_a_lone_struct_is_a_misindented_body()
    if !fpx_ready() then return

    val e = fpx_err("struct Empty\n\nprint(1)\n")

    assert(fpx_says(e, "'struct Empty' declares no fields — a struct's body is indented under it, a " +
        "type with no fields at all is written 'struct Empty' closed by 'end Empty', and one with no " +
        "layout of its own is written 'opaque struct Empty'"), e)

@test("and the marker's name is checked, as it is everywhere else")
fpx_the_markers_name_is_checked()
    if !fpx_ready() then return

    val e = fpx_err("struct Empty\nend Other\n\nprint(1)\n")

    assert(fpx_says(e, "'end Other' does not match 'Empty'"), e)

// `opaque struct Name` with no body is C's incomplete type; writing the marker as well says the same
// thing in the spelling every other block uses.
@test("an opaque struct may be closed the same way, and is still opaque")
fpx_an_opaque_struct_may_be_closed_the_same_way()
    if !fpx_ready() then return

    val e = fpx_err_of("module sq\n\nopaque struct Session\nend Session\n",
        "f(p: *u8) -> int = 1\nvar s: *sq.Session = null\nprint(f(s))\n")

    assert(fpx_says(e, "*byte"), e)
    assert(fpx_says(e, "*sq.Session"), e)

// -- the layout --------------------------------------------------------------------------------------

@test("no fields is no bytes")
fpx_no_fields_is_no_bytes()
    if !fpx_ready() then return

    assert_eq(fpx_ran("struct Marker\nend Marker\n\nprint(sizeof(Marker))\nprint(alignof(Marker))\n"),
        "0\n1\n")

@test("so embedding one costs the struct holding it nothing")
fpx_embedding_one_costs_nothing()
    if !fpx_ready() then return

    assert_eq(fpx_ran("struct Marker\nend Marker\n\nstruct Counted\n    mark: Marker\n    n: int\nend Counted\n\n" +
        "print(sizeof(Counted) == sizeof(int))\nprint(Counted(Marker(), 9).n)\n"), "true\n9\n")

@test("and two of them have nothing to tell their storage apart")
fpx_two_of_them_share_storage()
    if !fpx_ready() then return

    assert_eq(fpx_ran("struct Marker\nend Marker\n\nvar a = Marker()\nvar b = Marker()\n\nprint(&a == &b)\n"),
        "true\n")

// A fieldless struct is an ordinary type whose stride happens to be zero, so the array is a real one:
// its length is its own, and the bounds check is still the whole of what an index does.
@test("an array of them is a real array whose elements share their storage")
fpx_an_array_of_them_is_a_real_array()
    if !fpx_ready() then return

    assert_eq(fpx_ran("struct Marker\n    tag(self) -> int = 5\nend Marker\n\n" +
        "var xs: [4]Marker = [Marker(); 4]\n\nprint(xs.len)\nprint(xs[2].tag())\nprint(&xs[0] == &xs[3])\n"),
        "4\n5\ntrue\n")

@test("and the bounds check is what an index of one still gets")
fpx_the_bounds_check_still_applies()
    if !fpx_ready() then return

    assert_eq(fpx_stopped("struct Marker\nend Marker\n\nvar xs: [4]Marker = [Marker(); 4]\nvar i = 9\n\n" +
        "var m = xs[i]\n\nprint(\"reached\")\n"), 133)

@test("one behind the allocator is still a reference, since the header is real")
fpx_one_behind_the_allocator_is_a_reference()
    if !fpx_ready() then return

    assert_eq(fpx_ran("struct Marker\n    tag(self) -> int = 5\nend Marker\n\nvar r: &Marker = Marker()\n\n" +
        "print(r.tag())\n"), "5\n")

@test("and it passes through a generic that carries no data at all")
fpx_it_passes_through_a_generic()
    if !fpx_ready() then return

    assert_eq(fpx_ran("struct Marker\n    tag(self) -> int = 5\nend Marker\n\nid[T](x: T) -> T = x\n\n" +
        "print(id(Marker()).tag())\n"), "5\n")

// -- a sink is what has no fields --------------------------------------------------------------------

@test("it renders a scalar exactly as the compiler's own 'print' does")
fpx_a_sink_renders_a_scalar_as_print_does()
    if !fpx_ready() then return

    assert_eq(fpx_ran(fpx_stdout() + "show(42)\nprint(42)\n"), "42\n42\n")

@test("and a type of the program's own, through the same trait")
fpx_a_sink_renders_a_programs_own_type()
    if !fpx_ready() then return

    val point = "struct Point\n    x: int\n    y: int\nend Point\n\nimpl Display for Point\n" +
        "    display(self, out: *Writer, fmt: FormatSpec)\n        display_str(\"pt(\", out, fmt)\n" +
        "        display_int(long(self.x), out, fmt)\n        display_str(\", \", out, fmt)\n" +
        "        display_int(long(self.y), out, fmt)\n        display_str(\")\", out, fmt)\nend Point\n\n" +
        "show(Point(3, 4))\nprint(Point(3, 4))\n"

    assert_eq(fpx_ran(fpx_stdout() + point), "pt(3, 4)\npt(3, 4)\n")

// The whole path -- the sink, the trait object it is reached through, the rendering that walks it --
// stays inside a module that has given the allocator up.
@test("and the whole path holds inside a module that has given up the allocator")
fpx_the_whole_path_holds_under_no_alloc()
    if !fpx_ready() then return

    assert_eq(fpx_ran("@no_alloc\n\n" + fpx_stdout() + "show(42)\nshow(\"uart\")\n"), "42\nuart\n")

// Without this the test above proves nothing: the same module with one allocating line.
@test("which means something only because that clause is enforced")
fpx_the_no_alloc_clause_is_enforced()
    if !fpx_ready() then return

    val e = fpx_err("@no_alloc\n\n" + fpx_stdout() + "var boxed: &int = 1\n\nshow(*boxed)\n")

    assert(fpx_says(e, "a reference needs an allocator, and this module declared '@no_alloc' — it may " +
        "hold and release storage made elsewhere, and may make none of its own"), e)

// -- the library declares that sink once, and a program may use it ----------------------------------

@test("the sink 'print' uses is one a program can ask for by name")
fpx_the_library_sink_by_name()
    if !fpx_ready() then return

    assert_eq(fpx_ran(fpx_point() + "report(stdout(), Point(1, 2))\n"), "pt(1)\n")

@test("and the type behind it is one a program can build for itself")
fpx_the_library_sink_built_by_the_program()
    if !fpx_ready() then return

    assert_eq(fpx_ran(fpx_point() + "var own = Stdout()\n\nreport(&own, Point(3, 4))\n"), "pt(3)\n")

@test("the two are the same destination, in the order the writes happened")
fpx_the_two_sinks_are_one_destination()
    if !fpx_ready() then return

    assert_eq(fpx_ran(fpx_point() +
        "var own = Stdout()\n\nreport(stdout(), Point(1, 2))\nreport(&own, Point(3, 4))\n"), "pt(1)\npt(3)\n")

// What `print` of a user type emits: a call for the sink rather than two words the compiler laid
// down, and no hand-written table anywhere in the program.
@test("and 'print' reaches it as an ordinary call")
fpx_print_reaches_the_sink_as_a_call()
    if !fpx_ready() then return

    val out = fpx_ir(fpx_point() + "print(Point(1, 2))\n")

    assert(fpx_says(out, "call { ptr, ptr } @sysl$stdout()"), out)
    assert(!fpx_says(out, "@sysl.vt.out"), "no hand-laid table")
    assert(!fpx_says(out, "@sysl.w.out.write"), "no hand-laid write")
