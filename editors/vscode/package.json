{
  "name": "sysl",
  "displayName": "sysl",
  "description": "sysl for Visual Studio Code: highlighting, and diagnostics, hover and go-to-definition from the compiler's own language server (sysl lsp).",
  "version": "0.1.0",
  "publisher": "sysl-lang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sysl-lang/sysl"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": ["Programming Languages", "Linters"],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "sysl",
        "aliases": ["sysl"],
        "extensions": [".sysl"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sysl",
        "scopeName": "source.sysl",
        "path": "./syntaxes/sysl.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "sysl",
      "properties": {
        "sysl.path": {
          "type": "string",
          "default": "sysl",
          "description": "The sysl compiler the language server runs as (`<path> lsp --stdio`): a name looked up on the PATH, or an absolute path."
        },
        "sysl.lib": {
          "type": "string",
          "default": "",
          "description": "The standard library root, passed to the server as SYSL_LIB. Empty leaves the environment as it is, which is what an installed sysl wants."
        },
        "sysl.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Log the messages between the editor and sysl lsp to the 'sysl' output channel."
        }
      }
    },
    "commands": [
      {
        "command": "sysl.restartServer",
        "title": "sysl: Restart Language Server"
      }
    ]
  },
  "scripts": {
    "grammar": "node scripts/grammar.js",
    "vscode:prepublish": "node scripts/grammar.js",
    "test": "node scripts/grammar.js && node test/session.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "vscode-jsonrpc": "^8.2.0"
  }
}
