module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.text.{Search, replace_all}

// The keeps-analysis (`keeps.sysl`) over a chain of calls as long as a program: `f0` calls `f1`, which
// calls `f2`, thirty-two thousand deep. Each body's answers are worked out callees first
// (`warm_callees_first`), so no question nests a walk per call; asked only on demand from the top, the
// chain overflowed the compiler's stack. A verdict still travels the whole chain: what the bottom does
// with the pointer is what the top call is held to.
//
// The cells are the four questions a call asks of its callee -- what it overwrites (a chain of plain
// integer calls), what it keeps (a pointer handed down to a body that stores it), what its answer is
// made of (a pointer handed back up), and an assumption (a recursion at the bottom of the chain) --
// each with its control where the bottom lets the pointer go. Every link states its result or has a
// block body: a chain of results read off `= expr` bodies is the result reading's depth, not this one's.

private val KdcDepth: usize = 32000

private kdc_join(lines: Buf[string]) -> string
    var text = ""

    for item in lines
        text = text + item

    text
end kdc_join

private val kdc_store: string = "var spare = 0\nvar held: *int = &spare\n\nstore(p: *int)\n    held = p\n\nread(p: *int)\n    spare = *p\n\n"

// `head`, then the chain `f0` .. `f<depth - 1>`: each link is `link(i, next)` and the last `last`.
private kdc_chain(head: string, link: &Fn(usize, usize) -> string, last: string) -> string
    var lines: Buf[string] = buf()

    lines.push(head)

    for i in 0..<KdcDepth
        lines.push(if i + 1 < KdcDepth then link(i, i + 1) else s"f$i$last")

    kdc_join(lines)
end kdc_chain

// What the analysis reports of `text`, the first message, or nothing.
private kdc_said(text: string) -> string
    val done = typed_of(text)

    if done.reported.is_empty() then "" else done.reported.at(0).diag.message
end kdc_said

@test("a chain of thirty-two thousand integer calls is analysed, and nothing is refused")
kdc_integer_chain()
    val text = kdc_chain("main()\n    val n = f0(1)\n\n", (i, j) -> s"f$i(n: int) -> int = f$j(n + 1)\n\n",
                         "(n: int) -> int = n\n\n")

    assert_eq(kdc_said(text), "")

@test("a local's address handed down thirty-two thousand calls to a body that stores it is refused at the top")
kdc_kept_at_the_bottom()
    val link = (i: usize, j: usize) -> s"f$i(p: *int)\n    f$j(p)\n\n"
    val head = kdc_store + "main()\n    var n = 1\n    f0(&n)\n\n"
    val kept = kdc_said(kdc_chain(head, link, "(p: *int)\n    store(p)\n\n"))

    assert(kept.contains("'f0' keeps its parameter 'p' (it is passed to 'f1', which keeps it)"), kept)

    val let_go = kdc_said(kdc_chain(head, link, "(p: *int)\n    spare = *p\n\n"))

    assert_eq(let_go, "")

@test("a pointer handed back up thirty-two thousand calls is followed to the body that keeps it")
kdc_answered_from_the_bottom()
    val link = (i: usize, j: usize) -> s"f$i(p: *int) -> *int = f$j(p)\n\n"
    val head = kdc_store + "main()\n    var n = 1\n    store(f0(&n))\n\n"
    val answered = kdc_said(kdc_chain(head, link, "(p: *int) -> *int = p\n\n"))

    assert(answered.contains("'store' keeps its parameter 'p'"), answered)

    val other = kdc_said(kdc_chain(head, link, "(p: *int) -> *int = &spare\n\n"))

    assert_eq(other, "")

@test("a recursion at the bottom of a thirty-two-thousand-call chain is worked out by assumption, and keeps")
kdc_recursion_at_the_bottom()
    val link = (i: usize, j: usize) -> s"f$i(p: *int, k: int)\n    f$j(p, k)\n\n"
    val head = kdc_store + "main()\n    var n = 1\n    f0(&n, 3)\n\n"
    val bottom = "(p: *int, k: int)\n    if k == 0 then store(p) else again(p, k - 1)\n\n" +
                 s"again(p: *int, k: int)\n    f${KdcDepth - 1}(p, k)\n\n"
    val kept = kdc_said(kdc_chain(head, link, bottom))

    assert(kept.contains("'f0' keeps its parameter 'p'"), kept)

    val let_go = kdc_said(kdc_chain(head, link, replace_all(bottom, "store(p)", "read(p)")))

    assert_eq(let_go, "")

// Whether a body may repoint what its parameter points at (`writes_of`) is asked of every call handed a
// local's address, and of every callee a body hands its parameter on to: asked on demand from the top,
// it nested a walk per link and overflowed the stack. A write at the bottom makes every link answer
// yes, and the local whose address went down is given up -- with nothing of it kept, nothing is refused.
@test("a write through a local's address at the bottom of a thirty-two-thousand-call chain is answered up it")
kdc_written_at_the_bottom()
    val link = (i: usize, j: usize) -> s"f$i(p: *int)\n    f$j(p)\n\n"
    val head = kdc_store + "main()\n    var n = 1\n    f0(&n)\n    read(&n)\n\n"

    assert_eq(kdc_said(kdc_chain(head, link, "(p: *int)\n    *p = 2\n\n")), "")

    val kept = kdc_said(kdc_chain(head, link, "(p: *int)\n    *p = *p + 1\n    store(p)\n\n"))

    assert(kept.contains("'f0' keeps its parameter 'p' (it is passed to 'f1', which keeps it)"), kept)

// The same chain handing a pointer to a pointer down: a parameter something is read through asks the
// read questions of each callee -- keyed by the steps and the field path the CALLER reads at, so no
// warming knows to ask them -- and asked on demand they nested a walk per link and overflowed the stack
// (as 0.8.3 did). A question asked `MaxNesting` walks deep is put off and answered from the top.
@test("a pointer to a pointer repointed at the bottom of a thirty-two-thousand-call chain is answered up it")
kdc_repointed_at_the_bottom()
    val link = (i: usize, j: usize) -> s"f$i(pp: ***int)\n    f$j(pp)\n\n"
    val head = "var slot: *int = null\n\nkey(a: *int)\n    var arr: [1]*int = [null]\n" +
               "    var p: **int = &arr[0]\n    f0(&p)\n    *p = a\n\nmain()\n    var x = 5\n    key(&x)\n\n"
    val kept = kdc_said(kdc_chain(head, link, "(pp: ***int)\n    *pp = &slot\n\n"))

    assert(kept.contains("'key' keeps its parameter 'a' (it is stored in '*p')"), kept)

    val read = kdc_said(kdc_chain(head, link, "(pp: ***int)\n    if *pp == null then slot = null\n\n"))

    assert_eq(read, "")

// The steps a callee is asked change down the chain: the first half hands `***int` on, the link at the
// middle hands what it reads one step in, and the second half hands that `**int` on. What the bottom
// reads two steps through the top's argument is the address of the top's own local.
@test("a read two steps in, then one, down a thirty-two-thousand-call chain is held to what the bottom lets out")
kdc_steps_change_down_the_chain()
    val half = KdcDepth / 2
    val link = (i: usize, j: usize) ->
        if j < half then s"f$i(pp: ***int)\n    f$j(pp)\n\n"
        else if j == half then s"f$i(pp: ***int)\n    f$j(*pp)\n\n"
        else s"f$i(p: **int)\n    f$j(p)\n\n"
    val head = kdc_store + "key()\n    var x = 5\n    var arr: [1]*int = [&x]\n    var p: **int = &arr[0]\n    f0(&p)\n\n" +
               "main()\n    key()\n\n"
    val kept = kdc_said(kdc_chain(head, link, "(p: **int)\n    held = *p\n\n"))

    assert(kept.contains("'f0' lets what it reads through its parameter 'pp' outlive the call"), kept)
    assert(kept.contains("what is read through '&p' holds the address of a local of 'key'"), kept)

    val read = kdc_said(kdc_chain(head, link, "(p: **int)\n    if *p == null then spare = 1\n\n"))

    assert_eq(read, "")

// The same through a struct whose field holds the local's address: the bottom letting a field out is
// refused at the top, and one that only compares it lets nothing out.
@test("a field read through a struct pointer at the bottom of a thirty-two-thousand-call chain is answered up it")
kdc_field_read_down_the_chain()
    val link = (i: usize, j: usize) -> s"f$i(w: *H)\n    f$j(w)\n\n"
    val head = kdc_store + "struct H\n    p: *int\n    q: *int\n\nkey()\n    var x = 5\n    var h = H(&x, &spare)\n" +
               "    f0(&h)\n\nmain()\n    key()\n\n"
    val kept = kdc_said(kdc_chain(head, link, "(w: *H)\n    held = w.p\n\n"))

    assert(kept.contains("'f0' lets what it reads through its parameter 'w' outlive the call"), kept)
    assert(kept.contains("what is read through '&h' holds the address of a local of 'key'"), kept)

    val other = kdc_said(kdc_chain(head, link, "(w: *H)\n    if w.p == null then spare = 1\n\n"))

    assert_eq(other, "")
