module sh.sysl.compiler

import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}

// A function declared inside a body, and the environment its block shares.
//
// **They share one environment**, and that is the whole design. A nested function *is* a closure --
// what it captures and how it is represented follow the same rules -- but the block's functions are
// members of one struct rather than one struct each, which is what makes both halves of the rule
// true at once: every name is in scope throughout the block, so two may call each other, while what
// may be *captured* is settled at the position the group is written.
//
// A sibling call and a recursive call are then the same thing -- a call on the receiver the body
// already has -- so neither takes a share of anything and no reference cycle ever forms.
//
// **The environment holds the ADDRESS of every capture rather than a copy**, which is the one
// difference from a closure literal. A closure may outlive the frame it was written in; a nested
// function may not -- nothing outside the body can name one, so it cannot be stored or returned --
// and a body of statements that could not assign to the variable it was written beside would not be
// worth the name it has.

// What the environment shared by one block of nested functions is filed under.
env_base(n: usize) -> string = s"${ModuleSep}env$n"

// One nested function as a name in the block that declared it: the function to call, the environment
// to call it on, and the signature a call is read against.
struct Nested
    fname: string
    env: TExpr
    variadic: bool
    params: Buf[Param]

    // Where the declaration was written, which only the definition index reads.
    declared: Span
end Nested

// Whether a name is one of the nested functions this body may see -- one of the block's own, or one
// of a frame around it, which is a name this body may not reach and is told so rather than told the
// name stands for nothing.
names_a_nested(cx: &Analyzer, name: string) -> bool =
    cx.nested_of(name).is_some() || holds_string(cx.outer_nested, name)

// The name an expression is, where it is a bare one.
nested_ident(e: Expr) -> Option[string] = *e.kind match
    Ident(n) -> Some(n)
    _ -> None

// The nested functions of one block, lowered together.
//
// The environment is built where the first of them is written, which is also where the captures are
// read. Everything a nested function names from around it must therefore be declared above that
// point.
lower_nested_group(cx: &Analyzer, span: Span, group: Buf[FuncDecl]) -> Buf[TStmt]
    var names: Buf[string] = buf()

    for item in group
        names.push(item.name)

    // **A refusal ends the lowering.** What a nested function may not be is a property of the
    // declaration, so a group holding one is not a group: binding the names anyway would report the
    // one mistake and then everything that followed from a body nothing could analyze. The names are
    // remembered instead, so a call to one says nothing more than the refusal already did.
    for item in group
        if refuse_nested_shape(cx, span, item, names)
            for j in 0..<names.len()
                cx.refused_nested.push(names.at(j))

            return buf()

    // A sibling is reached through the shared receiver rather than captured, so the names of the
    // group are bound here and are not free in each other's bodies.
    var captured: Buf[string] = buf()

    for d in group
        var bound: Buf[string] = buf()

        for j in 0..<names.len()
            bound.push(names.at(j))

        for j in 0..<d.params.len()
            bound.push(d.params.at(j).name)

        val reads = captures_where(n -> cx.lookup(n).is_some(), d.body, bound)

        for j in 0..<reads.len()
            if !holds_string(captured, reads.at(j)) then captured.push(reads.at(j))

    // A nested function reads its captures out of an environment as a closure does, so a `ref` is
    // refused here for the same reason -- and the group is not lowered, a body that could not reach
    // the name having nothing left to be analyzed against.
    if refuse_ref_captures(cx, span, captured) then return buf()

    var fields: Buf[(string, Type)] = buf()

    for item in captured
        // The field holds the **address** of the enclosing variable, not a copy of it. That is what
        // makes a nested function assigning to one of the block's locals assign to the block's
        // local, which is the thing the form exists for.
        fields.push((item, Ptr(cx.lookup(item).unwrap().ty)))

    val base = env_base(cx.an.env_count)

    cx.an.env_count += 1

    val st = StructType(base, buf(), fields, false, None, None, false)
    val env = Struct(st)

    cx.an.tables.struct_insts.put(base, env)

    val slot = cx.bind(base, env)
    val here = TExpr(span, TAddrOf(TExpr(span, TLoad(slot, env)), Ptr(env)))
    val inner_self = TExpr(span, TLoad("self", Ptr(env)))

    // Every signature is registered before any body is analyzed, which is what lets one call another
    // whichever order they are written in. A nested function states its parameters and its result,
    // so there is nothing here to infer and nothing to wait for.
    var lowered: Buf[string] = buf()

    for d in group
        val fname = s"${mangle(env)}.${d.name}"

        lowered.push(fname)

        // The environment takes the first slot, but the tail is anchored after what the program
        // wrote, so a nested `...` needs a named parameter of its own as a top-level one does.
        if d.variadic && d.params.is_empty() then
            cx.fault(d.at, s"'${d.name}' needs at least one named parameter before '...'")

        // A generic one has a signature per instantiation, registered where a call settles it.
        if !d.tparams.is_empty() then continue

        var params: Buf[(string, Type)] = buf()

        params.push(("self", Ptr(env)))

        for j in 0..<d.params.len()
            params.push((d.params.at(j).name,
                         resolve_type(cx.an, cx.scope, d.params.at(j).typ, cx.subst)))

        val ret = if d.ret_type.is_none() then Unit
        else resolve_result(cx.an, cx.scope, d.ret_type.unwrap(), cx.subst)

        cx.an.tables.members.func_insts.put(fname, FuncSig(params, ret))

    // The names are bound **before** any body is analyzed, so a body that does not analyze leaves
    // the group callable and the block is told about its one mistake rather than about that one and
    // an undefined name at every call.
    var inside: Buf[(string, &Nested)] = buf()

    for i in 0..<group.len()
        val d = group.at(i)

        inside.push((d.name, Nested(lowered.at(i), inner_self, d.variadic, d.params, d.at)))
        cx.nested.push((d.name, Nested(lowered.at(i), here, d.variadic, d.params, d.at)))

    // **A generic one is kept as a template until a call asks for it**, which is the whole of how a
    // nested function comes to be generic: each instantiation is one more member of the same
    // environment, read in the frame taken here. Every template is filed before any body is read, so
    // a sibling written above one may call it.
    val frame = nested_frame(cx, span, st, captured, inside)

    for i in 0..<group.len()
        val d = group.at(i)

        if !d.tparams.is_empty()
            cx.an.tables.nested_generics.put(lowered.at(i),
                                             NestedGeneric(d, unshadowed(cx.subst, d.tparams), frame))

    for i in 0..<group.len()
        val d = group.at(i)
        val generic = cx.an.tables.nested_generics.get(lowered.at(i))

        if !d.tparams.is_empty() && generic.is_some()
            check_nested_definition(cx.an, generic.unwrap(), lowered.at(i))
        else
            cx.an.closure_funcs.push(nested_body_in(cx.an, frame, lowered.at(i), d, cx.subst,
                                                    cx.at_definition))

    // The environment holds addresses, so nothing in it is counted and nothing is copied: it is a
    // row of pointers into the frame it was built in, which is sound exactly because a nested
    // function cannot leave that frame.
    //
    // Read through the ordinary analysis rather than off the scope, so a name this block itself
    // captured from further out is the field it reaches there, and the address taken is of the one
    // variable rather than of a copy of it.
    var addresses: Buf[TExpr] = buf()

    for item in captured
        val place = capture_source(cx, span, item)

        addresses.push(TExpr(span, TAddrOf(place, Ptr(place_type(place)))))

    var out: Buf[TStmt] = buf()

    out.push(TVarDecl(slot, env, TExpr(span, TStructNew(st, addresses)), None))
    out
end lower_nested_group

// What a nested function may not be, each a consequence of holding a frame rather than of where the
// declaration was written.
private refuse_nested_shape(cx: &Analyzer, span: Span, d: FuncDecl, names: Buf[string]) -> bool
    if file_local(d.vis)
        cx.fault(span, s"'${d.name}' is declared inside a function body, so nothing outside can " +
                 "name it and there is nothing for a visibility modifier to restrict")
        return true

    var seen = 0

    for item in names
        if item == d.name then seen += 1

    if seen > 1
        cx.fault(span, s"'${d.name}' is already declared in this block")
        return true

    false
end refuse_nested_shape

// What the group reads from **this** block, whether or not it has been bound yet.
//
// This is what decides **where** the group is lowered. Asking about the block's whole binding set
// rather than about what is in scope is what lets a nested function read something written below it;
// the environment is then built after the last of them, so every address it holds is of a slot whose
// declaration has run.
group_needs(group: Buf[FuncDecl], candidates: Buf[string]) -> Buf[string]
    var out: Buf[string] = buf()
    var names: Buf[string] = buf()

    for item in group
        names.push(item.name)

    for d in group
        var bound: Buf[string] = buf()

        for j in 0..<names.len()
            bound.push(names.at(j))

        for j in 0..<d.params.len()
            bound.push(d.params.at(j).name)

        val reads = captures_where(n -> holds_string(candidates, n), d.body, bound)

        for j in 0..<reads.len()
            if !holds_string(out, reads.at(j)) then out.push(reads.at(j))

    out
end group_needs

// The names a top-level statement of a block binds, which is what a group may still be waiting for.
block_binds(s: Stmt, out: *Buf[string])
    *s.kind match
        VarDecl(n, _, _, _, _, _, _) -> out.push(n)
        ValDecl(n, _, _, _, _, _) -> out.push(n)
        RefDecl(n, _) -> out.push(n)
        MultiDecl(ns, _, _) ->
            for item in ns
                out.push(item)
        PatternDecl(p, _, _) -> pattern_names(out, p)
        _ -> ()

// A name a block binds: where its statement starts, and whether the block's nested functions had
// begun by then.
struct BlockBind
    name: string
    at: usize
    after_group: bool

// What the blocks around a body bind, handed to the analyzer reading that body. The block around it
// is where a name it could not reach would have been bound, so its bindings are what a use inside
// it is measured against.
carry_declares(cx: &Analyzer, inner: &Analyzer)
    for block_declare in cx.block_declares
        inner.block_declares.push(block_declare)

    inner.carried_declares = inner.block_declares.len()

// What to say of a name that resolved to nothing and that a block in view binds, or nothing where
// the name is simply not one.
//
// **Two mistakes, told apart by where the binding is.** A use written above its declaration is told
// the rule a reader would state. A use below it that still found nothing is a nested function's
// default, which is read with no locals in scope -- and the sentence about the shared environment
// is said only where it is true: the binding was written after the block's nested functions began.
not_yet_bound(cx: &Analyzer, span: Span, name: string) -> Option[string]
    var i = cx.block_declares.len()

    while i > 0
        i -= 1

        val b = cx.block_declares.at(i)

        if b.name != name then continue

        if span.start < b.at then
            return Some(s"'$name' is declared below this, and a name is in scope from where it " +
                        "is bound onward")

        if i < cx.carried_declares && b.after_group then
            return Some(s"'$name' is bound after the nested functions of this block begin, so it " +
                        "is not in this one's environment — they share a single environment, " +
                        "formed where the first of them is written, and what it holds is what " +
                        s"the block had bound by that point. Bind '$name' above them, or make it " +
                        "module storage with 'static'")

        return None

    None
end not_yet_bound

// One nested function's body, read in a frame of its own.
//
// What it keeps from around it is what a reader would expect to keep: the file's terms, what a type
// parameter stands for, and the name `__FUNCTION__` answers with. What it does not keep is the
// enclosing function's scope stack: a body is analyzed against per-function state, and every part of
// that belongs to the function being interrupted.
private nested_body_in(a: &Analysis, f: &NestedFrame, fname: string, d: FuncDecl,
                       subst: Buf[Binding], at_definition: bool) -> TFunc
    val span = f.span
    val inner = analyzer_for(a, f.scope)

    inner.subst = subst
    inner.at_definition = at_definition
    inner.func_name = f.func_name
    inner.decl_name = f.decl_name
    inner.in_variadic = d.variadic
    inner.bind_site = Some(span)
    note_body_covers(a, fname)
    inner.owner = f.owner

    // A generic one's bounds say which trait's member a name on its parameters meant, as a top-level
    // generic's do -- beside whatever the frame's own signature promised.
    if !d.tparams.is_empty()
        remember_bounds(inner, d)

        var bounds: Buf[NamedBounds] = buf()

        for nb in d.bounds
            bounds.push(nb)

        for nb in f.tbounds
            bounds.push(nb)

        inner.tbounds = bounds
    end if

    val env = Struct(f.env)
    val self_ty = Ptr(env)

    var params: Buf[(string, Type)] = buf()

    params.push((inner.bind("self", self_ty), self_ty))

    for param in d.params
        val ty = resolve_type(a, f.scope, param.typ, subst)

        params.push((inner.bind(param.name, ty), ty))

    for i in 0..<f.captured.len()
        val stored = f.env.fields.at(i).1
        val field = TExpr(span, TField(TExpr(span, TDeref(TExpr(span, TLoad("self", self_ty)), env)),
                                       int(f.env.slot(i)), stored))

        // The environment holds the address of the frame's own variable, so what the name reaches is
        // the variable itself -- one dereference further, and a place, which is what lets a nested
        // function assign to it.
        val reached = stored match
            Ptr(pointee) ->
                (bind_capture(inner, f.locals.at(i), f.captured.at(i), *pointee),
                 TExpr(span, TDeref(field, *pointee)))
            _ -> (bind_capture(inner, f.locals.at(i), f.captured.at(i), stored), field)

        // A by-name parameter of the frame is one in the nested function too: a read calls it.
        if f.by_name.at(i) then inner.by_name.push(reached.0)

        inner.captured.push(reached)

    // A sibling is in scope throughout the group, so a body may call one written below it. What a
    // body does *not* reach is a nested function of the frame around it, and remembering their
    // names is what lets that be said rather than reported as a name standing for nothing.
    for item in f.siblings
        inner.nested.push(item)

    for name in f.outer_nested
        inner.outer_nested.push(name)

    for declared in f.declares
        inner.block_declares.push(declared)

    inner.carried_declares = inner.block_declares.len()

    val written = d.ret_type.map(w -> resolve_result(a, f.scope, w, subst))
    val ret = body_result(d, declared_result_type(written))

    inner.ret_ty = Some(ret)
    inner.await_site = await_site_of(d)

    val split = contract_length(d.body)
    val contract = analyze_contract(inner, decl_anchor(d), d.body, split, ret, false)
    val rest = statements_from(d.body, split)
    val block = body_block(inner, rest, ret)

    // A nested function is a closure over its frame, and is told so in a closure's words -- at the
    // line that declared it, as a top-level function's disagreement is.
    if ret != Unit && block.result.is_some() && disagree(block.ty, ret) then
        inner.fault(decl_anchor(d), closure_disagreement(ret, block.ty))

    a.tables.homes.put(fname, f.scope)

    if d.const_fn then a.tables.const_fns.put(fname, true)

    TFunc(span, fname, params, ret, block, d.variadic, contract.0, contract.1, contract.2, true,
          None, false, contract.3, false, false, None, None, None, None, no_marks(), inner.owner,
          d.const_fn, Some(f.scope.src))
end nested_body_in

// What a nested function's body is read against, taken from the frame where its group is written.
//
// **It is taken once, there, and kept.** A generic one's bodies are read where a call asks for them,
// after the block has moved on, while what each capture is, what the block binds and which nested
// functions a body may not reach are facts about the place the group was written.
struct NestedFrame
    span: Span
    scope: Scope
    tbounds: Buf[NamedBounds]
    func_name: string
    decl_name: string
    owner: string
    env: &StructType
    captured: Buf[string]
    locals: Buf[Option[Local]]
    by_name: Buf[bool]
    siblings: Buf[(string, &Nested)]
    outer_nested: Buf[string]
    declares: Buf[BlockBind]
end NestedFrame

private nested_frame(cx: &Analyzer, span: Span, st: &StructType, captured: Buf[string],
                     siblings: Buf[(string, &Nested)]) -> &NestedFrame
    var locals: Buf[Option[Local]] = buf()
    var by_name: Buf[bool] = buf()

    for name in captured
        locals.push(cx.lookup(name))
        by_name.push(reads_by_name(cx, name))

    var declares: Buf[BlockBind] = buf()

    for declared in cx.block_declares
        declares.push(declared)

    var tbounds: Buf[NamedBounds] = buf()

    for nb in cx.tbounds
        tbounds.push(nb)

    NestedFrame(span, cx.scope, tbounds, cx.func_name, cx.decl_name, nested_owner(cx), st,
                captured, locals, by_name, siblings, outer_nested_of(cx, siblings), declares)
end nested_frame

// A generic nested function, kept until a call settles its type parameters: the declaration, what
// the frame's own type parameters stand for (less any it shadows), and the frame its bodies are read
// in. It is filed under the function's name and under each instantiation's.
struct NestedGeneric
    decl: FuncDecl
    outer: Buf[Binding]
    frame: &NestedFrame

// One instantiation's body, which the queue of instantiations asks for as it asks for a top-level
// generic's.
nested_instance_body(a: &Analysis, g: &NestedGeneric, name: string, subst: Buf[Binding]) -> TFunc =
    nested_body_in(a, g.frame, name, g.decl, subst, false)

// A generic nested function's body read once where it is written, its type parameters standing for
// themselves -- the reading a top-level generic gets at its definition -- and everything it
// registered taken back, the instantiations being what the program gets.
private check_nested_definition(a: &Analysis, g: &NestedGeneric, fname: string)
    val d = g.decl

    if d.body.is_empty() then return

    val mark = a.complaints()
    val trial = a.sandboxed()
    val queued = a.tables.members.pending.len()
    val tables = a.tables.members.vtables.len()
    val structs = a.tables.struct_insts.len()
    val enums = a.tables.enum_insts.len()
    val constrained = a.tables.constrained_insts.len()
    val lowered = a.closure_count
    val made = a.closure_funcs.len()
    val subst = abstract_subst(a, g.frame.scope, d.tparams, d.bounds, d.tvalues, d.tpacks, g.outer)
    val settled_before = a.settled

    a.settled = joined_bindings(subst, buf())
    nested_body_in(a, g.frame, fname, d, subst, true)
    a.settled = settled_before
    a.release(trial)
    a.restore_complaints(mark)
    rewind_instantiations(a, queued, tables, structs, enums, constrained)
    a.closure_count = lowered
    a.closure_funcs.truncate(made)
end check_nested_definition

// What a frame's type parameters stand for, less the ones a nested declaration names again: its own
// parameter of the spelling is the nearer binding.
private unshadowed(subst: Buf[Binding], tparams: Buf[string]) -> Buf[Binding]
    var out: Buf[Binding] = buf()

    for b in subst
        if !holds_string(tparams, b.name) then out.push(b)

    out
end unshadowed

// The declaration a call to a generic nested function is solved against: the frame's type
// parameters stand in front of its own, each already answered, so a parameter written in the frame's
// terms is read in them.
private callable_decl(g: &NestedGeneric) -> FuncDecl
    var names: Buf[string] = buf()

    for b in g.outer
        if !holds_string(names, b.name) then names.push(b.name)

    for name in g.decl.tparams
        names.push(name)

    var d = g.decl

    d.tparams = names
    d
end callable_decl

// Binds a capture in the nested function's own scope under the promise the frame made about it: the
// environment reaches the variable itself, so a `val` (or a pattern's binding) is written once here
// exactly as it is in the frame, and a write to it is refused in the frame's words.
private bind_capture(inner: &Analyzer, local: Option[Local], name: string, ty: Type) -> string
    if local.is_some() && local.unwrap().from_pattern then return inner.bind_pattern(name, ty)
    if local.is_some() && local.unwrap().read_only then return inner.bind_read_only(name, ty)

    inner.bind(name, ty)

// A group with nothing in it, which is what a closure has: it is one body and not a block of them.
no_siblings() -> Buf[(string, &Nested)] = buf()

// The nested functions of the frame around a body, which that body may not reach.
carry_outer_nested(cx: &Analyzer, inner: &Analyzer, siblings: Buf[(string, &Nested)])
    for name in outer_nested_of(cx, siblings)
        if !holds_string(inner.outer_nested, name) then inner.outer_nested.push(name)

private outer_nested_of(cx: &Analyzer, siblings: Buf[(string, &Nested)]) -> Buf[string]
    var out: Buf[string] = buf()

    for item in cx.nested
        if !named_sibling(siblings, item.0) && !holds_string(out, item.0) then out.push(item.0)

    for name in cx.outer_nested
        if !named_sibling(siblings, name) && !holds_string(out, name) then out.push(name)

    out
end outer_nested_of

private named_sibling(siblings: Buf[(string, &Nested)], name: string) -> bool
    for item in siblings
        if item.0 == name then return true

    false
end named_sibling

// `f(a)` where `f` is one of the block's nested functions: a call on the receiver the body already
// has, with the arguments a reader wrote after it.
call_nested(cx: &Analyzer, span: Span, n: &Nested, written: string, args: Buf[Expr],
            expected: Option[Type]) -> TExpr
    note_reference(cx, span, cx.scope.src, n.declared, written)

    val generic = cx.an.tables.nested_generics.get(n.fname)

    if generic.is_some() then
        return generic_nested_call(cx, span, n, generic.unwrap(), written, args, expected, buf())

    val sig = cx.an.tables.members.func_insts.get(n.fname)

    if sig.is_none() then return bad_expr(span)

    val params = sig.unwrap().params

    // A nested function takes names and defaults exactly as a function does; its lowered signature
    // has the environment in front of what a call writes.
    val bound = bind_params(cx, span, s"'$written'", n.params, n.variadic, args, true)

    if bound.is_none() then return bad_expr(span)

    val slots = bound.unwrap()
    var supplied: Buf[TExpr] = buf()

    supplied.push(n.env)

    val before = cx.an.complaints()
    var given: Buf[TExpr] = buf()
    var wants: Buf[Type] = buf()

    for i in 0..<slots.len()
        val want = params.at(i + 1).1

        wants.push(want)

        slots.at(i) match
            Some(e) -> given.push(type_expr(cx, e, Some(want)))
            // Read with nothing local in scope, in the terms of the module the block sits in.
            None -> given.push(fill_nested_default(cx, span, n.fname, n.params.at(i), want))

    val refused = refused_argument(cx, span, s"'$written'", n.params, slots, given, wants, before)

    if refused.is_some() then return refused.unwrap()

    for item in given
        supplied.push(item)

    for i in slots.len()..<args.len()
        supplied.push(type_expr(cx, args.at(i), None))

    cx.an.uses(n.fname)
    TExpr(span, TCall(n.fname, supplied, sig.unwrap().ret, false))
end call_nested

// `f(a)` where `f` is a generic nested function: solved and instantiated as a top-level generic's
// call is, its instantiation one more member of the environment the call is made on. `known` is what
// a written type-argument list already answered.
private generic_nested_call(cx: &Analyzer, span: Span, n: &Nested, g: &NestedGeneric, written: string,
                            args: Buf[Expr], expected: Option[Type], known: Buf[Binding]) -> TExpr
    var answered: Buf[Binding] = buf()

    for b in known
        answered.push(b)

    for b in g.outer
        answered.push(b)

    generic_call_with(cx, span, written, written, Func(callable_decl(g), n.declared, g.frame.scope), args,
                      expected, true, answered, Some(n))
end generic_nested_call

// `f[A](a)` where `f` is a nested function: the list fills the parameters it wrote, as it does for a
// top-level generic, and the arguments settle the rest.
written_nested_call(cx: &Analyzer, span: Span, n: &Nested, written: string, targ_exprs: Buf[Expr],
                    args: Buf[Expr], expected: Option[Type]) -> TExpr
    note_reference(cx, span, cx.scope.src, n.declared, written)

    val generic = cx.an.tables.nested_generics.get(n.fname)

    if generic.is_none() then
        return cx.err(span, s"'$written' is not generic, so it has no type arguments to write — " +
                      s"the call is '$written(…)'")

    val authored = authored_tparams(generic.unwrap().decl.tparams)

    if authored.len() != targ_exprs.len() then
        return cx.err(span, s"'$written' takes ${quantity(authored.len(), "type argument")} " +
                      s"(${quoted_names(authored)}), and ${targ_exprs.len()} " +
                      s"${if targ_exprs.len() == 1 then "was" else "were"} written")

    var known: Buf[Binding] = buf()

    for i in 0..<authored.len()
        known.push(Binding(authored.at(i), written_type_arg(cx, targ_exprs.at(i))))

    generic_nested_call(cx, span, n, generic.unwrap(), written, args, expected, known)
end written_nested_call
