module sysl.fs
requires os

import sysl.text.cstring

// What a program can ask and change about a path without opening what is at the end of it.
//
// **Everything here is reached by symbol alone -- no header is included and no C structure is
// transcribed** -- which is the constraint the whole module is written under and the reason the
// surface stops where it does. `stat` would answer more of these questions in one call, and its
// answer arrives in a `struct stat` that each platform's headers lay out differently; a program
// holding a transcription of one is holding numbers nothing checks, and being wrong about them
// reads the wrong bytes rather than failing. So a question that can be answered by a call whose
// signature is all there is to get right is answered here, and one that cannot is absent. `size_of`
// opens and seeks for exactly this reason.
//
// The one thing genuinely missing is **listing a directory**: `readdir` hands back a
// `struct dirent`, and finding the name in one means knowing an offset that differs between the
// platforms. That is the same trade the module refuses everywhere else, so it is not made here
// either.

private[sysl] extern "access" c_access(path: *u8, mode: int) -> int
private[sysl] extern "unlink" c_unlink(path: *u8) -> int
private[sysl] extern "rmdir" c_rmdir(path: *u8) -> int
private[sysl] extern "rename" c_rename(from: *u8, to: *u8) -> int
// A directory stream, which is C's `DIR` and has no layout anybody here knows -- the storage is
// libc's and its shape differs by platform. `opaque struct` is how that is said (`15 §9`): it gives
// `*Dir` a type of its own, so the handle cannot be crossed with the `*u8` paths declared beside it,
// and it withholds a layout there was never one to publish.
private[sysl] opaque struct Dir

private[sysl] extern "opendir" c_opendir(path: *u8) -> *Dir
private[sysl] extern "closedir" c_closedir(d: *Dir) -> int

// `mode_t` is the one argument in this file whose width the two platforms disagree about, and the
// declaration says so rather than passing the wider one and leaving the callee to ignore the top
// half. The gate is on whole declarations, which is what conditional compilation is comfortable
// with -- a call site cannot be half-written twice.
#if macos
private[sysl] extern "mkdir" c_mkdir(path: *u8, mode: u16) -> int

private made_dir(p: *u8) -> int = c_mkdir(p, u16(dir_mode()))
#else
private[sysl] extern "mkdir" c_mkdir(path: *u8, mode: u32) -> int

private made_dir(p: *u8) -> int = c_mkdir(p, u32(dir_mode()))
#endif

// What `access` is being asked. POSIX fixes all four numbers, and they are named here so that no
// call below reads as a bare integer.
private f_ok() -> int = 0
private r_ok() -> int = 4
private w_ok() -> int = 2

// The permissions a new directory asks for -- 0o777, which the process umask narrows to whatever
// the environment has decided new directories should be. Asking for less here would override that
// decision rather than defer to it, which is the wrong way round: a program that wants a private
// directory says so, and one that does not should get the machine's answer.
private dir_mode() -> int = 511

// Whether there is anything at all at this path.
//
// It answers `false` for a path that exists but sits under a directory the program may not search,
// which is the one way this differs from the question it looks like it is asking. That case cannot
// be told from absence without a second call whose answer would already be stale, and every caller
// that matters -- one about to open the file -- gets the truth from the open.
exists(path: string) -> bool = c_access(cstring(path).ptr, f_ok()) == 0

readable(path: string) -> bool = c_access(cstring(path).ptr, r_ok()) == 0

writable(path: string) -> bool = c_access(cstring(path).ptr, w_ok()) == 0

// Whether the path names a directory, asked by opening it as one. `DIR *` is opaque, so this needs
// nothing about the platform beyond the two symbols -- which is what makes it the one question about
// a path's *kind* the module can answer honestly.
is_dir(path: string) -> bool
    var d = c_opendir(cstring(path).ptr)

    if d == null then return false

    c_closedir(d)
    true
end is_dir

// Whether the path names something that is not a directory. A device or a socket answers `true`
// here, which is right for what callers use it for: the question is whether opening it as a file
// could work.
is_file(path: string) -> bool = exists(path) && !is_dir(path)

// How many bytes the file holds. It opens the file to ask, so it reports the same failures an open
// does -- a missing file answers `NotFound` rather than zero, which is the distinction a caller
// sizing a buffer needs and the one a bare number could not carry.
size_of(path: string) -> Result[long, IoError]
    var f = open(path)?

    defer f.close()

    f.size()
end size_of

// Makes one directory. The parent has to be there already: making a chain is a loop over path
// separators, and where a separator *is* is a question about paths rather than about the
// filesystem, which this module does not answer.
make_dir(path: string) -> Result[unit, IoError] = done(made_dir(cstring(path).ptr))

// Removes a file, and refuses a directory rather than removing it: `unlink` is the call that draws
// that line, where C's own `remove` quietly does either. Two names for two intentions is what lets
// a program that meant one of them find out it had the other.
remove_file(path: string) -> Result[unit, IoError] = done(c_unlink(cstring(path).ptr))

// Removes a directory, which has to be empty. A directory with anything in it reports
// `DirectoryNotEmpty` -- the one error code in the set whose number the two platforms disagree
// about, which is why `error.sysl` reads it through a call rather than a literal.
remove_dir(path: string) -> Result[unit, IoError] = done(c_rmdir(cstring(path).ptr))

// Moves a path to another name, replacing whatever was at the destination.
//
// It is one operation as far as anything watching is concerned when both paths are on the same
// filesystem, and it fails rather than copying when they are not -- which is `rename(2)`'s contract
// and worth knowing, since a program moving a file across devices has to read and write it itself.
//
// The two copies are named rather than written into the call, because a `cstring` temporary lives
// for the statement it appears in and this statement needs both of them alive at once.
rename(from: string, to: string) -> Result[unit, IoError]
    var a = cstring(from)
    var b = cstring(to)

    done(c_rename(a.ptr, b.ptr))
end rename

// A C call that reports success as zero, as the `Result` the rest of the module speaks in. It reads
// `errno` here rather than taking a code, so the read happens at the failure -- there is nothing
// between the two that could overwrite it.
private done(rc: int) -> Result[unit, IoError] = if rc != 0 then Err(why()) else Ok(())
