module sh.sysl.compiler

import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}
import sysl.container.{Map, map, Set, set}
import sysl.text.Search

// **What a program can arrive at**, and the declarations that go when nothing can.
//
// Pruning is the last thing that happens to a typed tree and the only thing between the checks and
// the lowering: a declaration nothing can reach is still one the program declared, and checking it
// is what makes a mistake in it a mistake at all.
//
// **The roots are not only what the program runs.** Three kinds of function are reached from
// somewhere no walk can see -- an interrupt handler, entered by the processor; an `@export`, called
// by something outside; and a `@section` definition, found by a linker script. Each is a root, and
// each is a root only where the program reaches its module: a handed source root is compiled whole
// rather than by what the program imports, so an unconditional root would put an unimported module's
// contribution into the output. **A destructor is called by the release hook the emitter builds**,
// and is reached where its type is rather than where its module is (`destructors_reached`).

// What one walk found: every function it can arrive at and every `val` it reads.
//
// Each list is in the order its names first arrived, and each has a set beside it that answers
// membership. **The set is what keeps a walk linear**: a program of `n` functions asks "have I seen
// this one" once per name every body holds, and a scan of the list for each of those is the whole
// walk again per name.
struct Live
    calls: Buf[string]
    vals: Buf[string]
    erased: Buf[string]
    call_set: Set[string]
    val_set: Set[string]
    erased_set: Set[string]
end Live

// The program with everything nothing can reach dropped.
prune(p: TProgram, own: Buf[string]) -> TProgram
    val live = walk_program(p, own)

    var externs: Buf[TExtern] = buf()

    for i in 0..<p.externs.len()
        if live.call_set.has(p.externs.at(i).name) then externs.push(p.externs.at(i))

    var funcs: Buf[TFunc] = buf()

    for i in 0..<p.funcs.len()
        if live.call_set.has(p.funcs.at(i).name) then funcs.push(p.funcs.at(i))

    // A table goes with its bodies: one the walk did not count (`table_counts`) names bodies that
    // are no longer emitted.
    var index: Set[string] = set()

    for i in 0..<p.funcs.len()
        index.add(p.funcs.at(i).name)

    var vtables: Buf[TVtable] = buf()

    for i in 0..<p.vtables.len()
        val t = p.vtables.at(i)
        var whole = true

        for item in t.slots
            if index.has(item.target) && !live.call_set.has(item.target) then whole = false

        if whole then vtables.push(t)

    with_declarations(p, externs, funcs) with { vtables = vtables }
end prune

// The whole walk, including the one root kind that cannot be decided before it has run.
//
// **An `@export` whose symbol answers an `extern` the program actually calls is a root.** It is the
// fifth kind, and it is the only one that is not a property of the function alone: what a
// capability-free module declares and defines nowhere is supplied by whoever links the program, and
// the consumer never names the supplier -- so asking whether the program reached the supplier's
// module answers no for precisely the case the seam exists to serve.
private walk_program(p: TProgram, own: Buf[string]) -> &Live
    val entries = entry_points(p, own)
    val index = func_index(p)
    val exports = exports_of(p)
    val reached = reached_modules(p, own)

    var extra: Buf[TFunc] = buf()
    var live = no_reached()
    var more = true
    val scan = type_scan()

    while more
        live = reached_from(p, index, roots_of(p, entries, extra, reached))

        for entrie in entries
            add_call(live, entrie.name)

        for item in extra
            add_call(live, item.name)

        more = destructors_reached(p, index, live, scan, &extra)

        if suppliers_reached(p, live, exports, &extra) then more = true

    live
end walk_program

// Every function the program's roots arrive at: what `prune` keeps, and in a build that runs tests,
// what `tests_only` keeps as well -- each `@test` and hook is a root there. The question a check asks
// when it is about the image rather than about the source: a body nothing arrives at is not in it.
funcs_reached(p: TProgram, own: Buf[string]) -> Set[string]
    var out = walk_program(p, own).call_set

    if p.tests.is_empty() && p.hooks.is_empty() then return out

    val tested = tests_only(p, own)

    for i in 0..<tested.funcs.len()
        out.add(tested.funcs.at(i).name)

    out
end funcs_reached

// The `@export`s the walk so far makes roots although nothing names them, added to `extra`; true where
// one was new. **A test build asks this too** (`tests_only`): a test reaching `sysl.env.vars` reaches
// the `sysl_env_count` extern, and only this rule keeps `sysl.env.hosted`'s answer to it.
private suppliers_reached(p: TProgram, live: &Live, exports: Buf[TFunc], extra: *Buf[TFunc]) -> bool
    var more = false

    for i in 0..<p.externs.len()
        val x = p.externs.at(i)

        if live.call_set.has(x.name)
            for f in exports
                if f.exported == Some(x.symbol) && !holds_func(*extra, f.name)
                    extra.push(f)
                    more = true

    // **The quad runtime is the sixth kind, and the call is LLVM's**: an `f128` operation lowers
    // to `fadd fp128` and the back end turns it into `__addtf3`, so nothing in any body names the
    // definition. Where a reached body computes with `f128`, the whole runtime is kept -- the
    // linker takes the routines the code asks for and drops the rest -- and where none does it
    // is left out, so a build that may not touch a float register never meets one.
    if runtime_reached(p, live, exports, extra, QuadArithmetic) then more = true

    // **A 32-bit machine's two runtimes are the same kind for the same reason**: a `long` divided
    // lowers to `sdiv i64`, and Arm turns that into `__aeabi_ldivmod` and RISC-V into `__divdi3`; an
    // `f64` operation on a machine with no double-precision unit becomes `__aeabi_dmul` or
    // `__muldf3`. The modules exist only where their `#if` admits the processor, so on every other
    // machine there is nothing here to keep.
    if runtime_reached(p, live, exports, extra, DoubleArithmetic) then more = true
    if runtime_reached(p, live, exports, extra, WideDivision) then more = true

    more
end suppliers_reached

// Every `@export` of the program, the candidates `suppliers_reached` looks among.
private exports_of(p: TProgram) -> Buf[TFunc]
    var exports: Buf[TFunc] = buf()

    for i in 0..<p.funcs.len()
        if p.funcs.at(i).exported.is_some() then exports.push(p.funcs.at(i))

    exports

// The module whose `@export`s are the binary128 routines LLVM calls.
const QuadRuntimeModule: string = "sysl.softfloat"

// The module whose `@export`s are a 32-bit machine's binary64 routines: Arm's `__aeabi_d*` and the
// `__adddf3` family, which a machine without a double-precision unit calls for every `f64` operation.
const DoubleRuntimeModule: string = "sysl.softfloat.binary64"

// The module whose `@export`s are a 32-bit machine's 64-bit division: `__aeabi_uldivmod` and its
// relatives on Arm, `__udivdi3` and its relatives on RISC-V.
const DivisionRuntimeModule: string = "sysl.softint"

// The runtimes LLVM calls into on its own, each kept where a reached body computes what it answers.
private enum Runtime
    QuadArithmetic
    DoubleArithmetic
    WideDivision

private runtime_home(r: Runtime) -> string = r match
    QuadArithmetic -> QuadRuntimeModule
    DoubleArithmetic -> DoubleRuntimeModule
    WideDivision -> DivisionRuntimeModule

// Keeps every `@export` of `r`'s module, where this build has the module at all and something the
// walk reached computes what it answers; true where one was new. The linker takes the routines the
// code asks for and drops the rest.
private runtime_reached(p: TProgram, live: &Live, exports: Buf[TFunc], extra: *Buf[TFunc],
                        r: Runtime) -> bool
    val home = runtime_home(r)

    if !holds_runtime(exports, home) || holds_runtime(*extra, home) || !reaches_runtime(p, live, r)
        return false

    var more = false

    for f in exports
        if f.declared_in == home && !holds_func(*extra, f.name)
            extra.push(f)
            more = true

    more
end runtime_reached

private holds_runtime(fs: Buf[TFunc], home: string) -> bool
    for item in fs
        if item.declared_in == home then return true

    false
end holds_runtime

// Whether anything the walk reached computes what `r` answers: a signature, a value a body computes,
// the program's own statements or its storage. The runtime's own bodies are not asked.
private reaches_runtime(p: TProgram, live: &Live, r: Runtime) -> bool
    // **A core with no divider calls the integer runtime from code that spells none of it**: a
    // constant divided is `__aeabi_uidiv`, a `long` multiplied `__aeabi_lmul`, a `real` normalized
    // `__clzsi2`. No walk could name every such operation, so there it is kept in every build.
    if r == WideDivision && !p.divider then return true

    var hits: Buf[Span] = buf()
    val sink = &hits
    val unit = Units(p.double_unit, p.single_unit)
    val walk = expr_walk(false, (e) -> note_runtime(sink, e, r, unit))
    val home = runtime_home(r)

    for i in 0..<p.funcs.len()
        val f = p.funcs.at(i)

        if live.call_set.has(f.name) && f.declared_in != home
            if runtime_type(f.ret_ty, r, unit) then return true

            for param in f.params
                if runtime_type(param.1, r, unit) then return true

            walk_stmts(f.body.stmts, walk)

            if f.body.result.is_some() then walk_texpr(f.body.result.unwrap(), walk)

            if !hits.is_empty() then return true

    walk_stmts(p.main, walk)

    for i in 0..<p.vals.len()
        val v = p.vals.at(i)

        if runtime_type(v.ty, r, unit) then return true

        v.init match
            Some(x) -> walk_texpr(x, walk)
            None -> ()

    !hits.is_empty()
end reaches_runtime

// The floating-point units a machine has: one computing in double precision, and one at all.
private struct Units
    binary64: bool
    binary32: bool

// Whether holding a value of `t` is itself `r`'s concern: a binary128 value, a binary64 one on a
// machine with no double-precision unit, or a binary32 one on a machine with no unit at all. A wide
// integer is not -- only dividing one is.
private runtime_type(t: Type, r: Runtime, unit: Units) -> bool = r match
    QuadArithmetic -> is_quad(t)
    DoubleArithmetic -> (!unit.binary64 && (is_binary64(t) || is_binary16(t))) ||
                        (!unit.binary32 && is_binary32(t))
    WideDivision -> false

private note_runtime(sink: *Buf[Span], e: TExpr, r: Runtime, unit: Units)
    if sink.is_empty() && runtime_node(e, r, unit) then sink.push(e.span)

// Whether `e` is an operation `r` answers. A binary64 runtime also answers the conversions between
// `f32` and a 64-bit integer, which a single-precision unit has no instruction for either. On a
// machine with a double-precision `unit` an `f64` operation is an instruction, so only the
// conversions between a 64-bit integer and either float width -- which that unit has no
// instruction for -- still need it. A division runtime answers `/` and `%` on anything wider than
// 32 bits, a fixed-point value included, since its quotient is formed in a register twice its width.
// On a machine with no unit at all the binary64 runtime also carries the `f32` routines, and any
// `f32` value asks for it.
private runtime_node(e: TExpr, r: Runtime, unit: Units) -> bool
    if r == QuadArithmetic then return is_quad(texpr_type(e))

    if r == DoubleArithmetic
        if runtime_type(texpr_type(e), r, unit) then return true

        return *e.kind match
            TCast(operand, ty) -> converts_wide_single(texpr_type(operand), ty) ||
                                  (unit.binary64 && converts_wide_double(texpr_type(operand), ty))
            _ -> false

    *e.kind match
        TBinary(op, left, _, ty) -> divides(op) && (divides_wide(ty) || divides_wide(texpr_type(left)))
        TUpdate(_, op, _, ty, _, _, _) -> divides(op) && divides_wide(ty)
        _ -> false
end runtime_node

private converts_wide_single(from: Type, to: Type) -> bool =
    (is_binary32(from) && is_wide_integer(to)) || (is_wide_integer(from) && is_binary32(to))

private converts_wide_double(from: Type, to: Type) -> bool =
    (is_binary64(from) && is_wide_integer(to)) || (is_wide_integer(from) && is_binary64(to))

private divides(op: string) -> bool = op == "/" || op == "%" || op == "/=" || op == "%="

private divides_wide(t: Type) -> bool = underlying(t) match
    Integer(bits, _, _) -> bits > 32
    Fixed(_, _, _) -> true
    _ -> false

private is_wide_integer(t: Type) -> bool = underlying(t) match
    Integer(bits, _, _) -> bits > 32
    _ -> false

private is_binary64(t: Type) -> bool = underlying(t) match
    Floating(bits, _) -> bits == 64
    _ -> false

// An `f16` is computed in `f32` and converted at every store, and Arm's run-time ABI names the
// conversions (`__aeabi_h2f`, `__aeabi_f2h`, `__aeabi_d2h`) that the binary64 runtime carries.
private is_binary16(t: Type) -> bool = underlying(t) match
    Floating(bits, brain) -> bits == 16 && !brain
    _ -> false

private is_binary32(t: Type) -> bool = underlying(t) match
    Floating(bits, brain) -> bits == 32 && !brain
    _ -> false

private holds_func(fs: Buf[TFunc], name: string) -> bool
    for item in fs
        if item.name == name then return true

    false
end holds_func

// The trees a walk starts from: the program's own statements, the storage it lays down, the tables
// it built, the entry point, and every function nothing in the program names.
//
// **A table counts only where the program reaches the module its slots were written in** (`reached`,
// from `reached_modules`; nothing means every module counts). Every closure a dependency's module
// lowered has a table, and that module may be one the program never names: `sh.sysl.pool`'s
// closures, rooted, kept its scheduler -- and through it `sysl.threads`'s futex hooks -- in a board
// build that imports only `sh.sysl.pool.deque`. A slot's module is the function's `declared_in`,
// since a closure's key names none. A module a kept supplier (`extra`) was written in counts; a
// standard-library slot never makes a table a root, and the walk keeps the table instead once a
// reached body erases a value into it.
private roots_of(p: TProgram, entries: Buf[TFunc], extra: Buf[TFunc],
                 reached: Option[Set[string]]) -> &Live
    val out = no_reached()

    walk_stmts(p.main, expr_walk(false, e -> take_node(out, e)))

    for i in 0..<p.vals.len()
        p.vals.at(i).init match
            Some(x) -> walk_texpr(x, expr_walk(false, e -> take_node(out, e)))
            None -> ()

    var homes: Map[string, string] = map()

    if reached.is_some()
        for i in 0..<p.funcs.len()
            homes.put(p.funcs.at(i).name, p.funcs.at(i).declared_in)

    var counted = reached

    if counted.is_some()
        var names = counted.unwrap()

        for item in extra
            names.add(item.declared_in)

        counted = Some(names)

    for i in 0..<p.vtables.len()
        val t = p.vtables.at(i)

        if !table_counts(t, homes, counted) then continue

        for item in t.slots
            add_call(out, item.target)

    p.entry match
        Some(en) ->
            add_call(out, en.func)

            en.args_fn match
                Some(n) -> add_call(out, n)
                None -> ()

            en.result_fn match
                Some(n) -> add_call(out, n)
                None -> ()
        None -> ()

    for entrie in entries
        add_call(out, entrie.name)

    for item in extra
        add_call(out, item.name)

    out
end roots_of

// Whether a table is a root: where every module counts, where one of its slots was written in a
// module that does, or where one names no body here.
//
// **A slot written in the standard module is no reason to keep a table.** The standard library's
// tables are built wherever analysis erased a value into one, whether or not the body that did it
// survives -- `Counting`'s and `Buf`'s `ByteSink` tables, rooted, kept `BufCore.grow` and with it
// `malloc` in a board image that never made a `Buf`. Such a table is kept by the walk instead, once
// a body it reaches erases a value into it (`take_all`).
private table_counts(t: TVtable, homes: Map[string, string], counted: Option[Set[string]]) -> bool
    if counted.is_none() then return true

    for item in t.slots
        val home = homes.get(item.target)

        if home.is_none() then return true

        val m = home.unwrap()

        if m == "sysl" || m.starts_with("sysl.") then continue

        if counted.unwrap().has(m) then return true

    false
end table_counts

// Everything a set of roots can arrive at, following each call into the body it lands in.
//
// A plain reachability walk rather than a fixpoint: what is being accumulated is a set, and a
// function already visited adds nothing a second time. A **dynamic** call is answered with every
// table for the trait, since a table is a constant the program can read a function out of and a
// definition it points at has to survive.
private reached_from(p: TProgram, index: FuncIndex, root: &Live) -> &Live
    val out = no_reached()
    val none = p.funcs.len()

    var tables: Map[string, usize] = map()

    for i in 0..<p.vtables.len()
        tables.put(p.vtables.at(i).name, i)

    var queue: Buf[string] = buf()

    take_all(p, tables, out, root, &queue)

    while !queue.is_empty()
        val name = queue.at(queue.len() - 1)

        queue.truncate(queue.len() - 1)

        var at = index.first.get_or(name, none)

        while at < none
            take_all(p, tables, out, body_refs(p, p.funcs.at(at)), &queue)

            at = index.next.at(at)

    out
end reached_from

// The module storage one function reaches, directly or through anything it calls -- the walk an
// export is held to, since the storage may be several calls down from the function that named it.
vals_reached_from(p: TProgram, f: TFunc) -> Buf[string]
    val root = no_reached()

    add_call(root, f.name)
    reached_from(p, func_index(p), root).vals
end vals_reached_from

// The module storage code running in another concurrency domain reaches from `roots`, each with the
// first function found reading it -- the walk `sharing.sysl`'s `check_shared_storage` holds a `&sync`
// body and an interrupt handler to.
//
// **A dynamic call is answered only with the tables the walk itself erased a value into**, not with
// every table for the trait as `reached_from` answers it. Anything a body in the other domain can call
// through an object reached it as that object, and an object arrives there in one of two ways: made
// inside the domain, which is an erasure this walk sees, or handed across as a `&sync` object, whose
// own erasure is a root of the check already. Answering with every table would charge a job with the
// storage every closure in the program reads.
storage_reached_in_domain(p: TProgram, roots: Buf[string]) -> Buf[(string, string)] =
    domain_walk(p, roots).1

// The same walk answered with the functions it reached rather than the storage they name: every body
// that may run in the domain the roots begin.
funcs_reached_in_domain(p: TProgram, roots: Buf[string]) -> Set[string] =
    domain_walk(p, roots).0.call_set

private domain_walk(p: TProgram, roots: Buf[string]) -> (&Live, Buf[(string, string)])
    val index = func_index(p)
    val none = p.funcs.len()
    val seen = no_reached()

    var tables: Map[string, usize] = map()

    for i in 0..<p.vtables.len()
        tables.put(p.vtables.at(i).name, i)

    var queue: Buf[string] = buf()
    var out: Buf[(string, string)] = buf()

    for item in roots
        if add_call(seen, item) then queue.push(item)

    while !queue.is_empty()
        val name = queue.at(queue.len() - 1)

        queue.truncate(queue.len() - 1)

        var at = index.first.get_or(name, none)

        while at < none
            val f = p.funcs.at(at)
            val refs = domain_refs(f)

            for v in refs.vals
                if add_val(seen, v) then out.push((v, f.name))

            for t in refs.erased
                if add_erased(seen, t)
                    tables.get(t) match
                        Some(k) ->
                            for slot in p.vtables.at(k).slots
                                if add_call(seen, slot.target) then queue.push(slot.target)
                        None -> ()

            for c in refs.calls
                if add_call(seen, c) then queue.push(c)

            at = index.next.at(at)

    (seen, out)
end domain_walk

// What one body names, as `body_refs` reads it, but with a dynamic call left unanswered.
private domain_refs(f: TFunc) -> &Live
    val out = no_reached()

    walk_block_stmts(f.body, TWalk(true, e -> take_node(out, e), w -> take_write(out, w), s -> ()))
    out
end domain_refs

// The module storage an initializer reads, directly or through anything it calls -- which is what
// settles the order computed storage is filled in. It is asked while the analysis is still running,
// so there is no program yet, only the bodies typed so far and the tables built for them.
//
// **The functions are indexed once for every initializer asked about**, not once per initializer: a
// program with many computed values would otherwise index every function it has for each of them.
struct ValsReader
    p: TProgram
    index: FuncIndex

    read(self, init: TExpr) -> Buf[string]
        val root = no_reached()
        val p = self.p

        walk_texpr(init, expr_walk(false, e -> take_node_of(p, root, e)))
        reached_from(p, self.index, root).vals
    end read
end ValsReader

vals_reader(funcs: Buf[TFunc], vtables: Buf[TVtable]) -> ValsReader
    val p = TProgram(buf(), buf(), vtables, buf(), buf(), funcs, buf(), None, buf(), true, false, buf(),
                     buf(), "", buf(), buf(), buf(), buf(), buf(), buf(), buf(), None, buf(), false,
                     false, false, true, map())

    ValsReader(p, func_index(p))
end vals_reader

// Where each function of a program is, by name: the first index holding a name, and from each index
// the next one holding the same name, so a name held twice is visited at both places and in the
// order the program lists them.
struct FuncIndex
    first: Map[string, usize]
    next: Buf[usize]

private func_index(p: TProgram) -> FuncIndex
    val n = p.funcs.len()

    var first: Map[string, usize] = map()
    var next: Buf[usize] = buf()

    for i in 0..<n
        next.push(n)

    var i = n

    while i > 0
        i -= 1

        val name = p.funcs.at(i).name

        first.get(name) match
            Some(j) -> next.set(i, j)
            None -> ()

        first.put(name, i)

    FuncIndex(first, next)
end func_index

// What one body names, added to the walk. **A table a reached body erases a value into has its slots
// reached**: the object can be called through wherever it goes, so whatever the table points at has to
// survive. That is the only thing keeping a standard-library table (`table_counts`).
private take_all(p: TProgram, tables: Map[string, usize], out: &Live, from: &Live,
                 queue: *Buf[string])
    for i in 0..<from.vals.len()
        add_val(out, from.vals.at(i))

    for item in from.erased
        if add_erased(out, item)
            tables.get(item) match
                Some(k) ->
                    for slot in p.vtables.at(k).slots
                        if add_call(out, slot.target) then queue.push(slot.target)
                None -> ()

    for item in from.calls
        if add_call(out, item) then queue.push(item)
end take_all

// Every function of a compilation that reads module storage, directly or through anything it calls.
//
// **It is the whole set at once rather than a question asked once per function**, and that is not a
// convenience. The question is asked of every function a library declares, and each answer on its
// own is a walk of the call graph from that function -- taken one at a time, the graph is walked
// once per node in it. What this costs instead is one summary per body and then a sweep back along
// the calls until nothing more changes, which is a handful of passes however deep the library is.
//
// The storage is what makes the question worth asking: a module-level `val` is filled by the entry
// point, and a library has none, so a function that reads one cannot be compiled ahead of time and
// is left to the program that will fill it.
//
// **`shared` is the storage that is not: constant storage laid down once in its library's own
// half** (`library.sysl`'s `shared_storage`) -- the standard module's, or the library's being built --
// whose image is in the object file and which every program and half names rather than copies.
// Reaching only that is reaching nothing.
storage_reaching(p: TProgram, shared: Set[string]) -> Buf[string]
    var index: Map[string, usize] = map()

    for i in 0..<p.funcs.len()
        index.put(p.funcs.at(i).name, i)

    val tables = table_index(p)
    var reaches: Buf[bool] = buf()
    var edges: Buf[(usize, usize)] = buf()

    for i in 0..<p.funcs.len()
        reaches.push(false)

    for i in 0..<p.funcs.len()
        val refs = body_refs(p, p.funcs.at(i))

        for item in refs.vals
            if !shared.has(item) then reaches.set(i, true)

        push_edges(p, index, tables, refs, i, &edges)

    var moved = true

    while moved
        moved = false

        for edge in edges
            if reaches.at(edge.1) && !reaches.at(edge.0)
                reaches.set(edge.0, true)
                moved = true

    var out: Buf[string] = buf()

    for i in 0..<p.funcs.len()
        if reaches.at(i) then out.push(p.funcs.at(i).name)

    out
end storage_reaching

// Every function a library artifact can neither define nor declare, grown from the ones its
// lowering could not finish.
//
// A gapped body is not emitted, and where its symbol is **`internal`** it cannot be declared either:
// internal linkage is the promise that no other object defines that name, so there is nothing for a
// declaration of one to resolve to. Every caller of such a body is therefore uncompilable here as
// well, and the set has to be closed under that -- a caller that is itself internal carries the
// same problem to *its* callers, and one that is not is simply declared and left to the program.
//
// The calls are summarized once and the closure is a sweep back along them, for the reason
// `storage_reaching` gives.
//
// **A call through a trait object is not an edge here**, though it is one for what a program keeps.
// It names no symbol -- it loads a slot of whichever table the value carries -- so a body making it
// compiles beside a dropped slot target, whose table leaves the half (`tables_without`) and whose
// erasers are deferred by the erase edge. Followed, it dropped every `internal` body that calls
// through a `&Fn` or a `&View` the library's own dropped closure was erased into -- another package's
// private method among them -- while that package's small public method, copied in to be inlined,
// still named it.
gap_closure(p: TProgram, gapped: Buf[string]) -> Buf[string]
    var index: Map[string, usize] = map()

    for i in 0..<p.funcs.len()
        index.put(p.funcs.at(i).name, i)

    val tables = table_index(p)
    var absent: Buf[bool] = buf()
    var deferred: Buf[bool] = buf()
    var edges: Buf[(usize, usize)] = buf()

    for i in 0..<p.funcs.len()
        val gone = holds_string(gapped, p.funcs.at(i).name)

        deferred.push(gone)
        absent.push(gone && p.funcs.at(i).internal)

        push_edges(p, index, tables, body_refs(p, p.funcs.at(i), false), i, &edges)

    var moved = true

    while moved
        moved = false

        for edge in edges
            if absent.at(edge.1) && !deferred.at(edge.0)
                deferred.set(edge.0, true)
                moved = true

                if p.funcs.at(edge.0).internal then absent.set(edge.0, true)

    var out: Buf[string] = buf()

    for i in 0..<p.funcs.len()
        if deferred.at(i) then out.push(p.funcs.at(i).name)

    out
end gap_closure

// The tables of a compilation by name, to their place in `p.vtables`.
private table_index(p: TProgram) -> Map[string, usize]
    var out: Map[string, usize] = map()

    for i in 0..<p.vtables.len()
        out.put(p.vtables.at(i).name, i)

    out
end table_index

// The edges from function `i` to every function of the compilation its body names: the ones it calls,
// and the slots of every table it erases a value into.
//
// **A table's slots are named as surely as a call is**: erasing a closure into `&Fn` builds a value
// whose table is laid down beside the body, and the table's adapter calls the closure's `call`. A
// sweep that followed only the calls left the body erasing a closure standing while the closure's own
// body was taken out -- in a library half, a public `hook()` returning `(a, b) -> self.m(a, b)` over a
// deferred `m` kept a table naming a `call` nothing defined.
private push_edges(p: TProgram, index: Map[string, usize], tables: Map[string, usize], refs: &Live,
                   i: usize, edges: *Buf[(usize, usize)])
    for item in refs.calls
        index.get(item) match
            None -> ()
            Some(j) -> edges.push((i, j))

    for item in refs.erased
        tables.get(item) match
            None -> ()
            Some(k) ->
                for slot in p.vtables.at(k).slots
                    index.get(slot.target) match
                        None -> ()
                        Some(j) -> edges.push((i, j))
end push_edges

// What one body names, without following any of it. With `dynamic`, a call through a trait object
// names the target of that slot in every table of the trait, which is what a program has to keep;
// without it, only what the body names as a symbol.
private body_refs(p: TProgram, f: TFunc, dynamic: bool = true) -> &Live
    val out = no_reached()
    val tables = if dynamic then Some(p.vtables) else None

    walk_block_stmts(f.body, TWalk(true, e -> node_names(out, e, tables), w -> take_write(out, w),
                                   s -> ()))

    for item in f.requires
        walk_texpr(item.cond, expr_walk(true, e -> node_names(out, e, tables)))

    for item in f.ensures
        walk_texpr(item.cond, expr_walk(true, e -> node_names(out, e, tables)))

    for item in f.olds
        walk_texpr(item, expr_walk(true, e -> node_names(out, e, tables)))

    out
end body_refs

private take_node(out: &Live, e: TExpr) = node_names(out, e, None)

private take_node_of(p: TProgram, out: &Live, e: TExpr) = node_names(out, e, Some(p.vtables))

// The names one node holds, as a call, as storage, or as a table it erased a value into.
//
// The names a node carries as **data** rather than as a child are read out here -- a dispatched
// operator, an invariant a write has to re-establish, the conversion a `?` widens through, a
// constrained subtype's predicate -- because nothing about the shape of the tree tells those from
// any other string.
private node_names(out: &Live, e: TExpr, tables: Option[Buf[TVtable]])
    *e.kind match
        TGlobal(symbol, _, _) -> add_val(out, symbol)
        TCall(name, _, _, _) -> add_call(out, name)
        TFuncAddr(name, _, _) -> add_call(out, name)
        TTry(_, _, _, _, _, _, convert) ->
            if convert.is_some() then add_call(out, convert.unwrap())
        TStructInvCheck(_, _, inv_fn) -> add_call(out, inv_fn)
        TRecheck(_, _, _, inv_fn) -> add_call(out, inv_fn)
        TConstrainedCheck(_, target) -> take_predicate(out, target)
        TUpdate(_, _, _, _, dispatch, check, _) ->
            take_dispatch(out, dispatch)

            if check.is_some() then take_predicate(out, check.unwrap())
        TIncDec(_, _, _, _, check) -> if check.is_some() then take_predicate(out, check.unwrap())
        TCompare(_, cmps) ->
            for cmp in cmps
                take_dispatch(out, cmp.dispatch)
        TErase(_, vtable, _) -> add_erased(out, vtable)
        TVCall(receiver, slot, _, _, _) -> take_dynamic(out, tables, texpr_type(receiver), slot)
        TRender(value, method, _, slot) ->
            if slot.is_some() then take_dynamic(out, tables, texpr_type(value), slot.unwrap())
            else add_call(out, method)
        _ -> ()
end node_names

private take_write(out: &Live, w: TWrite)
    take_dispatch(out, w.dispatch)

    for item in w.check
        add_call(out, item.inv_fn)

    if w.constraint.is_some() then take_predicate(out, w.constraint.unwrap())
end take_write

private take_dispatch(out: &Live, d: Option[TDispatch])
    if d.is_some() then add_call(out, d.unwrap().name)

private take_predicate(out: &Live, t: Type) = t match
    Constrained(d) ->
        if d.pred_fn.is_some() then add_call(out, d.pred_fn.unwrap())
    _ -> ()

// A call at a slot is answered with the functions every implementation of the trait put there.
private take_dynamic(out: &Live, tables: Option[Buf[TVtable]], recv: Type, slot: int)
    if tables.is_none() then return

    val name = recv match
        Ptr(inner) -> trait_name_of(*inner)
        Ref(inner, _) -> trait_name_of(*inner)
        _ -> None

    if name.is_none() then return

    val ts = tables.unwrap()

    for t in ts
        if t.trait_name == name.unwrap() && usize(slot) < t.slots.len()
            add_call(out, t.slots.at(usize(slot)).target)
end take_dynamic

private trait_name_of(t: Type) -> Option[string] = t match
    Trait(n, _, _) -> Some(n)
    _ -> None

private no_reached() -> &Live = Live(buf(), buf(), buf(), set(), set(), set())

private add_call(out: &Live, name: string) -> bool = add_named(&out.calls, &out.call_set, name)

private add_val(out: &Live, name: string) -> bool = add_named(&out.vals, &out.val_set, name)

private add_erased(out: &Live, name: string) -> bool = add_named(&out.erased, &out.erased_set, name)

// Adds a name to a list and the set beside it, answering whether it was new.
private add_named(xs: *Buf[string], seen: *Set[string], name: string) -> bool
    if name == "" || !seen.add(name) then return false

    xs.push(name)
    true
end add_named

// -- the destructors of the types the program reaches ------------------------------------------------

// **A destructor is reached exactly where its TYPE is**, not where its module is: the release hook
// that calls it is laid down only for a value of the type, so a program that calls `sysl.process.pid`
// and never makes a `Child` has no use for `Child.drop` -- nor for the hooks it would reach.
//
// A type is reached where anything reached holds one: a reached function's parameters, result,
// locals and every expression of its body; module storage; a table's type; and, from each of those,
// whatever the type holds in turn -- a field, an enum payload, a type argument, the target of a
// `&T`, a `weak T`, a `*T`, the element of an array or a slice. **The question errs on the side of
// keeping**: a destructor wrongly dropped is a silent leak, where one wrongly kept costs a function.
//
// The scan is kept across the rounds of the walk, each function's body being read once however many
// rounds reach it.
private struct TypeScan
    funcs: Set[string]
    keys: Set[string]
    fixed: bool
end TypeScan

private type_scan() -> &TypeScan = TypeScan(set(), set(), false)

// Adds to `extra` the destructor of every type the walk has reached whose destructor it has not,
// answering whether there was one -- which is another round, since a destructor's body reaches
// types of its own.
private destructors_reached(p: TProgram, index: FuncIndex, live: &Live, scan: &TypeScan,
                            extra: *Buf[TFunc]) -> bool
    if p.destructors.is_empty() then return false

    if !scan.fixed
        scan.fixed = true
        walk_stmts(p.main, types_walk(scan))

        for v in p.vals
            take_type(scan, v.ty)

            v.init match
                Some(x) -> walk_texpr(x, types_walk(scan))
                None -> ()

        for t in p.vtables
            take_type(scan, t.for_type)
    end if

    val none = p.funcs.len()

    for name in live.calls
        if !scan.funcs.add(name) then continue

        var at = index.first.get_or(name, none)

        while at < none
            scan_func(scan, p.funcs.at(at))

            at = index.next.at(at)

    var more = false

    for d in p.destructors
        if !scan.keys.has(d.0) || live.call_set.has(d.1) || holds_func(*extra, d.1) then continue

        var at = index.first.get_or(d.1, none)

        while at < none
            extra.push(p.funcs.at(at))
            more = true

            at = index.next.at(at)

    more
end destructors_reached

private scan_func(scan: &TypeScan, f: TFunc)
    for param in f.params
        take_type(scan, param.1)

    take_type(scan, f.ret_ty)
    walk_block_stmts(f.body, types_walk(scan))
end scan_func

private types_walk(scan: &TypeScan) -> &TWalk =
    TWalk(true, e -> take_type(scan, texpr_type(e)), w -> (), s -> take_decl_type(scan, s))

private take_decl_type(scan: &TypeScan, s: TStmt) = s match
    TVarDecl(_, ty, _, _) -> take_type(scan, ty)
    _ -> ()

// A type, and everything a value of it holds.
private take_type(scan: &TypeScan, t: Type) -> unit = t match
    Struct(d) -> if scan.keys.add(mangle(t)) then take_parts(scan, d.targs, d.fields)
    Results(d) -> if scan.keys.add(mangle(t)) then take_parts(scan, d.targs, d.fields)
    Enum(d) ->
        if scan.keys.add(mangle(t))
            for item in d.targs
                take_type(scan, item)

            for v in d.variants
                take_parts(scan, buf(), v.fields)
        end if
    Constrained(d) -> if scan.keys.add(mangle(t)) then take_type(scan, d.base)
    Ref(inner, _) -> take_type(scan, *inner)
    Weak(inner) -> take_type(scan, *inner)
    Ptr(inner) -> take_type(scan, *inner)
    Volatile(inner) -> take_type(scan, *inner)
    Slice(elem, _) -> take_type(scan, *elem)
    Array(_, elem) -> take_type(scan, *elem)
    Vector(_, elem) -> take_type(scan, *elem)
    Pack(es) ->
        for item in es
            take_type(scan, item)
    Trait(_, args, assocs) ->
        for item in args
            take_type(scan, item)

        for item in assocs
            take_type(scan, item.1)
    CFn(params, ret) ->
        for item in params
            take_type(scan, item)

        take_type(scan, *ret)
    _ -> ()

private take_parts(scan: &TypeScan, targs: Buf[Type], fields: Buf[(string, Type)])
    for item in targs
        take_type(scan, item)

    for item in fields
        take_type(scan, item.1)
end take_parts

// -- the roots nothing in the program names -----------------------------------------------------------

// The functions that are roots because **nothing in the program names them**, whatever the walk
// starts from.
//
// **A root the program did not write counts only where the program reaches its module**, and that is
// the one qualification on any of the four -- the same qualification on each of them, since a rule
// told per kind turns into a rule about which attributes a function carries together.
entry_points(p: TProgram, own: Buf[string]) -> Buf[TFunc]
    val reached = reached_modules(p, own)

    var out: Buf[TFunc] = buf()

    for i in 0..<p.funcs.len()
        val f = p.funcs.at(i)
        val kind = f.conv.is_some() || f.exported.is_some() || f.section.is_some()

        if kind && contributes(reached, f.name) then out.push(f)

    out
end entry_points

// The exports this compilation is answerable for: the ones it will emit, which is what every pass
// that reads the emitted program's symbol table should read.
exported_funcs(p: TProgram, own: Buf[string]) -> Buf[TFunc]
    val reached = reached_modules(p, own)
    val supplies = walk_program(p, own)

    var out: Buf[TFunc] = buf()

    for i in 0..<p.funcs.len()
        val f = p.funcs.at(i)

        if f.exported.is_some() && (contributes(reached, f.name) ||
                                    supplies.call_set.has(f.name))
            out.push(f)

    out
end exported_funcs

// Whether the module a function is in contributes roots to this compilation at all.
private contributes(reached: Option[Set[string]], name: string) -> bool
    if reached.is_none() then return true

    reached.unwrap().has(module_of(name))
end contributes

// Which modules a root in counts, or nothing where every module's does. The referring is asked of
// the graph name resolution built, which records an `import` as readily as a call.
private reached_modules(p: TProgram, own: Buf[string]) -> Option[Set[string]]
    if own.is_empty() then return None

    var order: Buf[string] = buf()
    var reached: Set[string] = set()

    for item in own
        add_module(&order, &reached, item)

    // **A supplied file with no module header is in the root module and is therefore treated as the
    // program's own**, since the root module is the one name two trees can share -- the answer that
    // keeps a symbol is the safe one to be wrong with.
    add_module(&order, &reached, ModuleRoot)

    // **A module whose top-of-file `asm` is laid down is reached**, whether or not anything imports
    // it. The block is never pruned, and its instructions call by symbol -- a `_start` doing
    // `bl finish` names an `@export` of its own module that no import line leads to -- so a module
    // contributing instructions to the image contributes its roots too, or the image calls what it
    // does not define.
    for item in p.module_asm
        if !is_runtime_module(item.home) then add_module(&order, &reached, item.home)

    var i: usize = 0

    while i < order.len()
        val from = order.at(i)

        i += 1

        for module_dep in p.module_deps
            if module_dep.0 == from
                val to = module_dep.1

                for k in 0..<to.len()
                    add_module(&order, &reached, to.at(k))

    Some(reached)
end reached_modules

// A module name added to a set, where **the root module's name is the empty string and is a name
// like any other**. `add_named` refuses one, which is right for a call graph -- nothing is called
// by no name -- and wrong here: refused, the root module is not among the ones a compilation counts
// roots in, so a program's own `@export`, `@section` or interrupt handler written with no module
// header is pruned before it can be emitted.
private add_module(order: *Buf[string], seen: *Set[string], name: string)
    if seen.add(name) then order.push(name)

// -- one program with something taken out of it -------------------------------------------------------

// The same program with a different set of declarations, which is what pruning answers with.
private with_declarations(p: TProgram, externs: Buf[TExtern], funcs: Buf[TFunc]) -> TProgram =
    TProgram(p.structs, p.enums, p.vtables, externs, p.vals, funcs, p.main, p.entry, p.precompiled,
             p.entry_point, p.c_artifact, p.no_alloc_modules, p.no_alloc_test_modules,
             p.main_module, p.tests, p.hooks, p.extern_vars, p.test_only, p.destructors,
             p.warnings, p.module_deps, p.main_src, runtime_asm_kept(p.module_asm, funcs), p.c_runtime,
             p.double_unit, p.single_unit, p.divider, p.test_reporters)

// The top-of-file blocks a pruned program lays down. **A runtime's block goes with its routines**:
// Arm's `__aeabi_uldivmod` answers in four registers, which no sysl signature can, so it is a block
// of instructions wrapping an `@export` -- laid down where the division runtime was kept and left
// out where it was not, as the routines are. Every other block is laid down whatever is reached.
private runtime_asm_kept(blocks: Buf[TModuleAsm], funcs: Buf[TFunc]) -> Buf[TModuleAsm]
    var out: Buf[TModuleAsm] = buf()

    for block in blocks
        if !is_runtime_module(block.home) || holds_runtime(funcs, block.home) then out.push(block)

    out
end runtime_asm_kept

private is_runtime_module(home: string) -> bool =
    home == QuadRuntimeModule || home == DoubleRuntimeModule || home == DivisionRuntimeModule

// **The same program lowered AS a test build: the tests kept, and the program's own entry point put
// aside.**
//
// A program's top-level statements and its `main` are what it does when it is run, and running it is
// not what a test build does -- so they go, and what stands in their place is the dispatcher the
// emitter lays down instead.
//
// **The tests are the roots**, in place of the `main` that is no longer there, so that everything one
// of them calls survives and nothing else does. The hooks are roots beside them and for the same
// reason: the dispatcher lays down an arm that calls each by name, so a hook nothing reaches from a
// test -- which is every one of them, since nothing calls a hook -- would be pruned out from under
// its own arm.
//
// **The roots nothing in the program names are roots here too.** A handler and an export are each
// reached from somewhere no walk can see, so replacing the roots does not make them reachable from
// the tests instead: it makes them reachable from nothing. A destructor is reached by its type here
// exactly as in a program, so a test that makes a value keeps the destructor its release calls.
//
// **Only the program's own tests are kept** (`strip_handed`): a dependency's suite is not the
// consumer's to run, and a failing test in it would otherwise fail the consumer's `sysl test`. With
// the dependency's tests gone every root is in an `own` module, which is why `entry_points` is asked
// about `own` and nothing wider.
tests_only(p: TProgram, own: Buf[string]) -> TProgram
    val kept = without_program_entry(strip_handed(p, own))
    val entries = entry_points(kept, own)
    val index = func_index(kept)
    val scan = type_scan()
    val exports = exports_of(kept)

    var extra: Buf[TFunc] = buf()
    var live = no_reached()
    var more = true

    while more
        val root = roots_of(kept, entries, extra, None)

        for item in kept.tests
            add_call(root, item.func)

            // A test answering with a `Result` is handed to its reporter by the dispatcher.
            kept.test_reporters.get(item.func) match
                Some(reported) -> add_call(root, reported.0)
                None -> ()

        for item in kept.hooks
            add_call(root, item.func)

        live = reached_from(kept, index, root)

        for entrie in entries
            add_call(live, entrie.name)

        for item in extra
            add_call(live, item.name)

        more = destructors_reached(kept, index, live, scan, &extra)

        if suppliers_reached(kept, live, exports, &extra) then more = true

    var externs: Buf[TExtern] = buf()

    for i in 0..<kept.externs.len()
        if live.call_set.has(kept.externs.at(i).name) then externs.push(kept.externs.at(i))

    var funcs: Buf[TFunc] = buf()

    for i in 0..<kept.funcs.len()
        if live.call_set.has(kept.funcs.at(i).name) then funcs.push(kept.funcs.at(i))

    with_declarations(kept, externs, funcs)
end tests_only

// The same program with nothing left of what it does when it is run. The module-level `val`s stay:
// they are storage the program reads rather than work it performs, and a test that reads one would
// otherwise find it empty.
private without_program_entry(p: TProgram) -> TProgram =
    TProgram(p.structs, p.enums, p.vtables, p.externs, p.vals, p.funcs, buf(), None, p.precompiled,
             p.entry_point, p.c_artifact, p.no_alloc_modules, p.no_alloc_test_modules,
             p.main_module, p.tests, p.hooks, p.extern_vars, p.test_only, p.destructors,
             p.warnings, p.module_deps, p.main_src, p.module_asm, p.c_runtime, p.double_unit,
             p.single_unit, p.divider, p.test_reporters)

// **The scaffolding a module's tests are written against, taken out of the build that runs none.**
//
// A hook goes with the tests it brackets, and is read from the program rather than from the tests
// because a module may declare one and no tests -- a hook left behind is a function nothing calls in
// a build that runs nothing. Everything declared in a file that said `@tests` goes with them.
strip_tests(p: TProgram) -> TProgram
    var gone: Set[string] = set()

    for item in p.tests
        gone.add(item.func)

    for item in p.hooks
        gone.add(item.func)

    for item in p.test_only
        gone.add(item)

    // An `asm` block a `@tests` file wrote is scaffolding too. It names nothing, so it is told by
    // where it was written rather than by a name in `gone`.
    var kept_asm: Buf[TModuleAsm] = buf()

    for item in p.module_asm
        if !item.scaffolding then kept_asm.push(item)

    val program = if kept_asm.len() == p.module_asm.len() then p
    else p with { module_asm = kept_asm }

    if gone.is_empty() then return program

    without_scaffolding(program, gone)
end strip_tests

// **The same program with a DEPENDENCY's tests taken out and the project's own kept** -- what a test
// build runs, since a package's suite is run by `sysl test` over the package and no build of the
// consumer keeps it. It is also what `emit-typed` reads: that stops before a build strips anything,
// which is right for the program's own `@test` functions -- they are part of what the module
// declares -- and wrong for a dependency's, which no build of this program ever keeps.
//
// **A test and its hook are handed by the module they are declared in; the rest of the scaffolding is
// not, and is judged by what the kept tests reach.** `test_only` also holds what a test *body* made --
// a closure, filed as `$closureN` in the root module, and an instantiation, filed under the generic's
// own module, which may well be a dependency's. Neither name says whose test made it, so dropping by
// module would take the closure out from under the project's own test that wrote it. What the kept
// tests and hooks reach stays; everything else in the scaffolding goes with the handed tests.
//
// **No `own` at all means every module is the program's**, as it does for `entry_points`: a caller
// that names no module is not saying that nothing is its own.
strip_handed(p: TProgram, own: Buf[string]) -> TProgram
    if own.is_empty() then return p

    var gone: Set[string] = set()
    var kept: Buf[string] = buf()

    for item in p.tests
        sort_by_owner(item.func, own, &gone, &kept)

    for item in p.hooks
        sort_by_owner(item.func, own, &gone, &kept)

    if gone.is_empty() then return p

    val reached = reached_by(p, kept)

    for name in p.test_only
        if !reached.call_set.has(name) && !reached.val_set.has(name) then gone.add(name)

    without_scaffolding(p, gone)
end strip_handed

private sort_by_owner(func: string, own: Buf[string], gone: *Set[string], kept: *Buf[string])
    val home = module_of(func)

    if home == ModuleRoot || holds_string(own, home) then kept.push(func)
    else gone.add(func)

// Every function and module `val` the named entries reach, taking the initializer of each `val` they
// read as a root too, until nothing new is reached.
private reached_by(p: TProgram, entries: Buf[string]) -> &Live
    val index = func_index(p)
    var inits: Set[string] = set()

    loop
        val root = no_reached()

        for entrie in entries
            add_call(root, entrie)

        for i in 0..<p.vals.len()
            val v = p.vals.at(i)

            if inits.has(v.symbol)
                v.init match
                    Some(x) -> walk_texpr(x, expr_walk(false, e -> take_node(root, e)))
                    None -> ()

        val live = reached_from(p, index, root)
        var more = false

        for i in 0..<live.vals.len()
            if inits.add(live.vals.at(i)) then more = true

        if !more then return live
end reached_by

// The removal both of the above make: every declaration `gone` names, and what names only those --
// the tests and hooks it holds, a table with a slot pointing at one, and the scaffolding list's own
// entries for them.
private without_scaffolding(p: TProgram, gone: Set[string]) -> TProgram
    var vtables: Buf[TVtable] = buf()

    for i in 0..<p.vtables.len()
        if !fills_a_slot(gone, p.vtables.at(i)) then vtables.push(p.vtables.at(i))

    var funcs: Buf[TFunc] = buf()

    for i in 0..<p.funcs.len()
        if !gone.has(p.funcs.at(i).name) then funcs.push(p.funcs.at(i))

    var vals: Buf[TVal] = buf()

    for i in 0..<p.vals.len()
        if !gone.has(p.vals.at(i).symbol) then vals.push(p.vals.at(i))

    var externs: Buf[TExtern] = buf()

    for i in 0..<p.externs.len()
        if !gone.has(p.externs.at(i).name) then externs.push(p.externs.at(i))

    var tests: Buf[TTest] = buf()

    for item in p.tests
        if !gone.has(item.func) then tests.push(item)

    var hooks: Buf[THook] = buf()

    for item in p.hooks
        if !gone.has(item.func) then hooks.push(item)

    var only: Buf[string] = buf()

    for item in p.test_only
        if !gone.has(item) then only.push(item)

    TProgram(p.structs, p.enums, vtables, externs, vals, funcs, p.main, p.entry, p.precompiled,
             p.entry_point, p.c_artifact, p.no_alloc_modules, p.no_alloc_test_modules,
             p.main_module, tests, hooks, p.extern_vars, only, p.destructors,
             p.warnings, p.module_deps, p.main_src, p.module_asm, p.c_runtime, p.double_unit,
             p.single_unit, p.divider, p.test_reporters)
end without_scaffolding

private fills_a_slot(gone: Set[string], t: TVtable) -> bool
    for item in t.slots
        if gone.has(item.target) then return true

    false
end fills_a_slot
