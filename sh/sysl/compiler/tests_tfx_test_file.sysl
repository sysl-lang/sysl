module sh.sysl.compiler
@tests

import sh.sysl.parsing.source_of
import sysl.buf.{Buf, buf}
import sysl.fs.remove_dir_all
import sysl.process.capture
import sysl.text.{join, Search}

// `@tests` -- a file of a module's test scaffolding, kept by `sysl test` and dropped by every other
// build (`reference/attributes.md § @tests — a file of scaffolding`). The header says two things and
// both are pinned here, because either alone is unsound: it **drops** the file, which keeps a helper
// out of a program and out of a library, and it **restricts** who may name what the file declared,
// which is what makes dropping it safe rather than a link error waiting for whoever writes the
// reference. The restriction is over the referring *declaration*, not the file it sits in, so a
// `@test` written beside what it tests may still call the scaffolding.
//
// Every expected text is the reference's (0.0.159) on the same tree. The reference's `build-lib`
// answers `wrote <root>.syslib`; here it answers `checked <root>` (`tests_lbl_build_lib.sysl` has the
// decision), so only its status and refusals are quoted.

private tfx_ready() -> bool = std_root().is_ok() && clang_available()

// A tree holding these files, each at its path below the root.
private tfx_tree(files: [](string, string)) -> string
    var b: Buf[(string, string)] = buf()

    for i in 0..<files.len
        b.push(files[i])

    lbr_tree(b)
end tfx_tree

// What the program of a tree prints, or what stopped it.
private tfx_ran(root: string) -> string
    val out_dir = lbr_temp("sysl-tfx-exe")

    reset_search_paths()

    val said = build_native_program(root, None, None, DefaultOptimization, Some(s"$out_dir/program")) match
        Err(why) -> s"refused: ${failure_text(why)}"
        Ok(made) ->
            capture(made, [], "", [], true) match
                Err(_) -> "the program that was built could not be run"
                Ok(out) -> if out.status.ok() then out.text else s"exited badly: ${out.text}"

    remove_dir_all(out_dir).unwrap_or(())
    remove_dir_all(root).unwrap_or(())
    said
end tfx_ran

// The LLVM text of the program of a tree.
private tfx_text(root: string) -> string
    reset_search_paths()

    val text = emit_llvm_text(root, None) match
        Err(why) -> s"refused: ${failure_text(why)}"
        Ok(emitted) -> emitted.text

    remove_dir_all(root).unwrap_or(())
    text
end tfx_text

// The display names of the tests a test build of a tree keeps, in order, and the status `sysl test`
// answers for it -- 0 only where every one of them ran and passed.
private tfx_tested(root: string) -> (string, int)
    reset_search_paths()

    val names = test_build_of(root, None) match
        Err(why) -> s"refused: ${failure_text(why)}"
        Ok(built) ->
            var out: Buf[string] = buf()

            for i in 0..<built.tests.len()
                out.push(built.tests.at(i).display)

            join(out.view(), ", ")

    val ran = lbr_cli(["sysl", "test", root])

    remove_dir_all(root).unwrap_or(())

    // What stopped a run is said to the sink and nowhere else, so it goes into the failure.
    assert_eq(ran.0, 0, ran.1)
    (names, ran.0)
end tfx_tested

// What `sysl <command> <root>` says, and its status.
private tfx_cli(command: string, root: string) -> (int, string)
    val got = lbr_cli(["sysl", command, root])

    remove_dir_all(root).unwrap_or(())
    got
end tfx_cli

// Whether a report holds a diagnostic: its message, where it points, and the line it quotes.
private tfx_says(out: string, message: string, at: string, line: string) -> bool =
    out.contains(s"error: $message") && out.contains(s" --> $at") && out.contains(line)

private tfx_refusal(name: string) -> string =
    s"'$name' is declared in a file that said '@tests', so it is there for the module's tests and no " +
    "build but 'sysl test' keeps it — only another such file, or a '@test' function, may name it"

private tfx_header() -> string =
    "this attribute belongs in the file's header, on the lines directly after 'module' and before " +
    "everything else — it is a property of the whole module, not of the statements below it"

private tfx_main() -> string = "import m.*\nprint(double(21))"

private tfx_double() -> string = "module m\n\ndouble(n: int) -> int = n * 2"

private tfx_scaffolding() -> string = "module m\n@tests\n\nquadruple(n: int) -> int = double(double(n))"

private tfx_consumer() -> string =
    "module m\n\ndouble(n: int) -> int = n * 2\n\napply(f: &Fn(int) -> int, n: int) -> int = f(n)"

private tfx_parsed(text: string) -> Program = parse(source_of("<input>", text)).program

// -- the header attribute parses where the others do -----------------------------------------------

@test("under a module header, with the capability clauses")
tfx_under_a_module_header()
    assert(tfx_parsed("module m\n@tests\n\nf() -> int = 1\n").test_only)

@test("beside one, in either order")
tfx_beside_one_in_either_order()
    assert(tfx_parsed("module m\n@no_alloc\n@tests\n\nf() -> int = 1\n").test_only)
    assert(tfx_parsed("module m\n@tests\n@no_alloc\n\nf() -> int = 1\n").test_only)

@test("and it says nothing about the capabilities beside it")
tfx_it_says_nothing_about_the_capabilities()
    val p = tfx_parsed("module m\n@tests\n@no_alloc\n\nf() -> int = 1\n")

    assert_eq(p.capabilities.len(), 1)
    assert_eq(p.capabilities.at(0).name, "alloc")

@test("opening a file that declares no module, where the root module's header would go")
tfx_opening_a_file_that_declares_no_module()
    assert(tfx_parsed("@tests\n\nf() -> int = 1\n").test_only)

@test("and a file that does not write it is not one")
tfx_a_file_that_does_not_write_it()
    assert(!tfx_parsed("module m\n\nf() -> int = 1\n").test_only)

// -- written anywhere but the header, it says where it belongs ---------------------------------------

@test("below the statements it would otherwise seem to cover")
tfx_below_the_statements()
    if !tfx_ready() then return

    val root = tfx_tree([("main.sysl", "f() -> int = 1\n@tests\n")])
    val (code, out) = tfx_cli("build", root)

    assert_eq(code, 1, out)
    assert(tfx_says(out, tfx_header(), s"$root/main.sysl:2:1", "2 | @tests"), out)

@test("and between two declarations, where an annotation would go")
tfx_between_two_declarations()
    if !tfx_ready() then return

    val root = tfx_tree([("main.sysl", "import m.*\nprint(f())"),
                         ("m/m.sysl", "module m\n\nf() -> int = 1\n\n@tests\ng() -> int = 2\n")])
    val (code, out) = tfx_cli("build", root)

    assert_eq(code, 1, out)
    assert(tfx_says(out, tfx_header(), s"$root/m/m.sysl:5:1", "5 | @tests"), out)

// What ends the header is the first statement, not the first blank line.
@test("though a blank line between it and 'module' leaves it in the header")
tfx_a_blank_line_leaves_it_in_the_header()
    assert(tfx_parsed("module m\n\n\n@tests\n\nf() -> int = 1\n").test_only)

// -- what such a file declares is dropped from every build but a test build --------------------------

@test("a helper is not defined in the program that was built beside it")
tfx_a_helper_is_not_defined_in_the_program()
    if !tfx_ready() then return

    val out = tfx_text(tfx_tree([("main.sysl", tfx_main()), ("m/m.sysl", tfx_double()),
                                 ("m/tests.sysl", tfx_scaffolding())]))

    assert(out.contains("@m$double"), out)
    assert(!out.contains("quadruple"), out)

@test("module storage goes with it")
tfx_module_storage_goes_with_it()
    if !tfx_ready() then return

    val out = tfx_text(tfx_tree([("main.sysl", tfx_main()), ("m/m.sysl", tfx_double()),
                                 ("m/tests.sysl", "module m\n@tests\n\nval fixture: int = 7")]))

    assert(out.contains("@m$double"), out)
    assert(!out.contains("fixture"), out)

@test("and the program still runs")
tfx_and_the_program_still_runs()
    if !tfx_ready() then return

    assert_eq(tfx_ran(tfx_tree([("main.sysl", tfx_main()), ("m/m.sysl", tfx_double()),
                                ("m/tests.sysl", tfx_scaffolding())])), "42\n")

// -- and kept by 'sysl test', which is the whole point of writing one --------------------------------

@test("a test in such a file runs, and the helper beside it is there to be called")
tfx_a_test_in_such_a_file_runs()
    if !tfx_ready() then return

    val (names, code) = tfx_tested(tfx_tree([
        ("main.sysl", tfx_main()), ("m/m.sysl", tfx_double()),
        ("m/tests.sysl", tfx_scaffolding() + "\n\n@test\ndoubling_twice_is_quadrupling() =\n" +
                         "    assert(quadruple(3) == 12)\n")]))

    assert_eq(names, "doubling_twice_is_quadrupling")
    assert_eq(code, 0)

@test("a '@test' in an ordinary file may name the scaffolding, since the two are dropped together")
tfx_a_test_in_an_ordinary_file_may_name_the_scaffolding()
    if !tfx_ready() then return

    val (names, code) = tfx_tested(tfx_tree([
        ("main.sysl", tfx_main()),
        ("m/m.sysl", tfx_double() + "\n\n@test\nbeside_what_it_tests() =\n    assert(quadruple(5) == 20)\n"),
        ("m/tests.sysl", tfx_scaffolding())]))

    assert_eq(names, "beside_what_it_tests")
    assert_eq(code, 0)

@test("and one test file may name another's")
tfx_one_test_file_may_name_another()
    if !tfx_ready() then return

    val (names, code) = tfx_tested(tfx_tree([
        ("main.sysl", tfx_main()), ("m/m.sysl", tfx_double()), ("m/fixtures.sysl", tfx_scaffolding()),
        ("m/tests.sysl", "module m\n@tests\n\n@test\nacross_two_test_files() =\n" +
                         "    assert(quadruple(4) == 16)\n")]))

    assert_eq(names, "across_two_test_files")
    assert_eq(code, 0)

// -- a closure is judged by the body it was written in ------------------------------------------------
//
// A closure is lowered to a function of its own under a name no reader wrote, so the rule follows the
// body it was written in rather than the name it was filed under. Both directions are pinned.

@test("a lambda in a test may call what the test file declared")
tfx_a_lambda_in_a_test()
    if !tfx_ready() then return

    val (names, code) = tfx_tested(tfx_tree([
        ("main.sysl", tfx_main()), ("m/m.sysl", tfx_consumer()),
        ("m/tests.sysl", tfx_scaffolding() + "\n\n@test\na_lambda_names_its_own_file() =\n" +
                         "    assert(apply(v -> quadruple(v), 3) == 12)\n")]))

    assert_eq(names, "a_lambda_names_its_own_file")
    assert_eq(code, 0)

@test("and a bare name, which is the capture-free closure and so the same question")
tfx_a_bare_name()
    if !tfx_ready() then return

    val (names, code) = tfx_tested(tfx_tree([
        ("main.sysl", tfx_main()), ("m/m.sysl", tfx_consumer()),
        ("m/tests.sysl", tfx_scaffolding() + "\n\n@test\na_bare_name_from_a_test_file() =\n" +
                         "    assert(apply(quadruple, 3) == 12)\n")]))

    assert_eq(names, "a_bare_name_from_a_test_file")
    assert_eq(code, 0)

@test("and storage it declared, which is the third way a name is reached at all")
tfx_storage_it_declared()
    if !tfx_ready() then return

    val (names, code) = tfx_tested(tfx_tree([
        ("main.sysl", tfx_main()), ("m/m.sysl", tfx_consumer()),
        ("m/tests.sysl", "module m\n@tests\n\nval fixture: int = 7\n\n" +
                         "@test\na_lambda_reads_test_storage() =\n" +
                         "    assert(apply(v -> v + fixture, 3) == 10)\n")]))

    assert_eq(names, "a_lambda_reads_test_storage")
    assert_eq(code, 0)

// A generic taking a callable is instantiated at the closure's own type, so an ordinary function ends
// up calling the test's closure body directly. That is not a use to report.
@test("and a generic instantiated at a test's closure is not a mistake to report")
tfx_a_generic_at_a_test_closure()
    if !tfx_ready() then return

    val (names, code) = tfx_tested(tfx_tree([
        ("main.sysl", tfx_main()),
        ("m/m.sysl", tfx_double() + "\n\nboth[T](f: (T, T) -> T, a: T, b: T) -> T = f(a, b)"),
        ("m/tests.sysl", tfx_scaffolding() + "\n\n@test\na_generic_at_a_test_closure() =\n" +
                         "    assert(both((x, y) -> quadruple(x) + y, 2, 3) == 11)\n")]))

    assert_eq(names, "a_generic_at_a_test_closure")
    assert_eq(code, 0)

@test("and a nested function, which is a closure with a name")
tfx_a_nested_function()
    if !tfx_ready() then return

    val (names, code) = tfx_tested(tfx_tree([
        ("main.sysl", tfx_main()), ("m/m.sysl", tfx_consumer()),
        ("m/tests.sysl", tfx_scaffolding() + "\n\n@test\na_nested_function_in_a_test() =\n" +
                         "    eight_times(n: int) -> int = quadruple(n) * 2\n\n" +
                         "    assert(eight_times(2) == 16)\n")]))

    assert_eq(names, "a_nested_function_in_a_test")
    assert_eq(code, 0)

@test("and a closure inside a closure, which is still inside the test that wrote it")
tfx_a_closure_inside_a_closure()
    if !tfx_ready() then return

    val (names, code) = tfx_tested(tfx_tree([
        ("main.sysl", tfx_main()), ("m/m.sysl", tfx_consumer()),
        ("m/tests.sysl", tfx_scaffolding() + "\n\n@test\na_closure_inside_a_closure() =\n" +
                         "    assert(apply(v -> apply(w -> quadruple(w), v), 3) == 12)\n")]))

    assert_eq(names, "a_closure_inside_a_closure")
    assert_eq(code, 0)

// A default is analyzed outside every body, so which declaration its closure belongs to has to be
// said by that pass itself. Filed as a test's, it would be dropped from the build that ships.
@test("a parameter default's closure belongs to the declaration that wrote it")
tfx_a_default_closure_belongs_to_its_declaration()
    if !tfx_ready() then return

    assert_eq(tfx_ran(tfx_tree([
        ("main.sysl", "import m.*\nprint(with_default(4))"),
        ("m/m.sysl", "module m\n\napply(f: &Fn(int) -> int, n: int) -> int = f(n)\n\n" +
                     "with_default(n: int, f: &Fn(int) -> int = (v: int) -> v * 3) -> int = apply(f, n)"),
        ("m/tests.sysl", "module m\n@tests\n\nval fixture: int = 7")])), "12\n")

@test("an ordinary function's closure may NOT, exactly as the function itself may not")
tfx_an_ordinary_closure_may_not()
    if !tfx_ready() then return

    val root = tfx_tree([("main.sysl", "import m.*\nprint(twice_over(21))"),
                         ("m/m.sysl", tfx_consumer() + "\n\ntwice_over(n: int) -> int = apply(v -> quadruple(v), n)"),
                         ("m/tests.sysl", tfx_scaffolding())])
    val (code, out) = tfx_cli("build", root)

    assert_eq(code, 1, out)
    assert(tfx_says(out, tfx_refusal("m.quadruple"), s"$root/m/m.sysl:7:40",
                    "7 | twice_over(n: int) -> int = apply(v -> quadruple(v), n)"), out)

// The drop reaches the lowered closure too: left behind, it would call a helper no longer there. Its
// type may stay, as a test file's types do; what must not be there is a body.
@test("and what a test's closure lowered to is dropped with the test")
tfx_a_test_closure_is_dropped_with_the_test()
    if !tfx_ready() then return

    val out = tfx_text(tfx_tree([
        ("main.sysl", tfx_main()), ("m/m.sysl", tfx_consumer()),
        ("m/tests.sysl", tfx_scaffolding() + "\n\n@test\na_lambda_names_its_own_file() =\n" +
                         "    assert(apply(v -> quadruple(v), 3) == 12)\n")]))

    assert(!out.contains("quadruple"), out)

    val lines = lines_of(out)

    for i in 0..<lines.len()
        if lines.at(i).starts_with("define") then assert(!lines.at(i).contains("closure"), lines.at(i))

// -- anything else that names one is told so where it wrote the name ---------------------------------

@test("a function of an ordinary file")
tfx_a_function_of_an_ordinary_file()
    if !tfx_ready() then return

    val root = tfx_tree([("main.sysl", "import m.*\nprint(twice_over(21))"),
                         ("m/m.sysl", tfx_double() + "\n\ntwice_over(n: int) -> int = quadruple(n)"),
                         ("m/tests.sysl", tfx_scaffolding())])
    val (code, out) = tfx_cli("build", root)

    assert_eq(code, 1, out)
    assert(tfx_says(out, tfx_refusal("m.quadruple"), s"$root/m/m.sysl:5:29",
                    "5 | twice_over(n: int) -> int = quadruple(n)"), out)

@test("the program's own statements, which no build drops at all")
tfx_the_programs_own_statements()
    if !tfx_ready() then return

    val root = tfx_tree([("main.sysl", "import m.*\nprint(quadruple(21))"), ("m/m.sysl", tfx_double()),
                         ("m/tests.sysl", tfx_scaffolding())])
    val (code, out) = tfx_cli("build", root)

    assert_eq(code, 1, out)
    assert(tfx_says(out, tfx_refusal("m.quadruple"), s"$root/main.sysl:2:7", "2 | print(quadruple(21))"), out)

@test("a read of storage it declared")
tfx_a_read_of_storage()
    if !tfx_ready() then return

    val root = tfx_tree([("main.sysl", "import m.*\nprint(fixture)"), ("m/m.sysl", tfx_double()),
                         ("m/tests.sysl", "module m\n@tests\n\nval fixture: int = 7")])
    val (code, out) = tfx_cli("build", root)

    assert_eq(code, 1, out)
    assert(tfx_says(out, tfx_refusal("m.fixture"), s"$root/main.sysl:2:7", "2 | print(fixture)"), out)

@test("and taking a helper's address, which is a use of it exactly as calling it is")
tfx_taking_a_helpers_address()
    if !tfx_ready() then return

    val root = tfx_tree([("main.sysl", "import m.*\nval f: *extern(int) -> int = &quadruple\nprint(f(21))"),
                         ("m/m.sysl", tfx_double()), ("m/tests.sysl", tfx_scaffolding())])
    val (code, out) = tfx_cli("build", root)

    assert_eq(code, 1, out)
    assert(tfx_says(out, tfx_refusal("m.quadruple"), s"$root/main.sysl:2:30",
                    "2 | val f: *extern(int) -> int = &quadruple"), out)

// -- a name two files of one module contend for is marked by the file that wrote it ------------------
//
// `private` is file-private, so two files of one module may each declare their own `pick`. Which
// declaration a `@tests` header is about follows the file that wrote it, never the spelling.

private tfx_ordinary_pick() -> string = "module m\n\nprivate pick(n: int) -> int = n\n\nuse(n: int) -> int = pick(n)"

private tfx_tests_pick() -> string =
    "module m\n@tests\n\nprivate pick(s: string) -> string = s\n\n" +
    "@test\nthe_tests_file_picks_a_string() =\n    assert(pick(\"x\") == \"x\")\n"

private tfx_use() -> string = "import m.*\nprint(use(3))"

@test("the ordinary file's call answers its own file-private helper")
tfx_the_ordinary_call_answers_its_own_helper()
    if !tfx_ready() then return

    assert_eq(tfx_ran(tfx_tree([("main.sysl", tfx_use()), ("m/a.sysl", tfx_ordinary_pick()),
                                ("m/b.sysl", tfx_tests_pick())])), "3\n")

@test("and the test file's own is still its own, so the test runs")
tfx_the_test_files_own_is_its_own()
    if !tfx_ready() then return

    val (names, code) = tfx_tested(tfx_tree([("main.sysl", tfx_use()), ("m/a.sysl", tfx_ordinary_pick()),
                                             ("m/b.sysl", tfx_tests_pick())]))

    assert_eq(names, "the_tests_file_picks_a_string")
    assert_eq(code, 0)

@test("whichever of the two the walk reaches first")
tfx_whichever_the_walk_reaches_first()
    if !tfx_ready() then return

    assert_eq(tfx_ran(tfx_tree([("main.sysl", tfx_use()), ("m/a_tests.sysl", tfx_tests_pick()),
                                ("m/z.sysl", tfx_ordinary_pick())])), "3\n")

    val (names, code) = tfx_tested(tfx_tree([("main.sysl", tfx_use()), ("m/a_tests.sysl", tfx_tests_pick()),
                                             ("m/z.sysl", tfx_ordinary_pick())]))

    assert_eq(names, "the_tests_file_picks_a_string")
    assert_eq(code, 0)

// The control: nothing says `@tests`, and two files each keeping a `pick` is the ordinary arrangement.
@test("two ordinary files each with one is the control, and compiles")
tfx_two_ordinary_files_is_the_control()
    if !tfx_ready() then return

    assert_eq(tfx_ran(tfx_tree([
        ("main.sysl", "import m.*\nprint(use(3))\nprint(use_s(\"x\"))"), ("m/a.sysl", tfx_ordinary_pick()),
        ("m/b.sysl", "module m\n\nprivate pick(s: string) -> string = s\n\nuse_s(s: string) -> string = pick(s)")])),
        "3\nx\n")

@test("and an overload split across the two is the same question about the same keys")
tfx_an_overload_split_across_the_two()
    if !tfx_ready() then return

    val (names, code) = tfx_tested(tfx_tree([
        ("main.sysl", tfx_use()), ("m/a.sysl", "module m\n\npick(n: int) -> int = n\n\nuse(n: int) -> int = pick(n)"),
        ("m/b.sysl", "module m\n@tests\n\npick(s: string) -> string = s\n\n" +
                     "@test\nan_overload_in_the_tests_file() =\n" +
                     "    assert(pick(\"x\") == \"x\")\n    assert(pick(2) == 2)\n")]))

    assert_eq(names, "an_overload_in_the_tests_file")
    assert_eq(code, 0)

// The restriction is still the file's: a name this file may not reach is no candidate for it at all,
// so the refusal is the privacy rule's rather than the `@tests` one's.
@test("while a test file naming an ordinary file's private helper is still refused")
tfx_a_test_file_naming_a_private_helper()
    if !tfx_ready() then return

    val root = tfx_tree([("main.sysl", tfx_use()),
                         ("m/a.sysl", "module m\n\nprivate helper(n: int) -> int = n\n\nuse(n: int) -> int = helper(n)"),
                         ("m/b.sysl", "module m\n@tests\n\n@test\nreaches_across() =\n    assert(helper(1) == 1)\n")])
    val (code, out) = tfx_cli("build", root)

    assert_eq(code, 1, out)
    assert(tfx_says(out, s"'m.helper' is private to '$root/m/a.sysl', the file that declares it",
                    s"$root/m/b.sysl:6:12", "6 |     assert(helper(1) == 1)"), out)

@test("and a public declaration in a test file shadows nothing an ordinary file kept private")
tfx_a_public_test_declaration_shadows_nothing()
    if !tfx_ready() then return

    assert_eq(tfx_ran(tfx_tree([("main.sysl", tfx_use()), ("m/a.sysl", tfx_ordinary_pick()),
                                ("m/b.sysl", "module m\n@tests\n\npick(s: string) -> string = s")])), "3\n")

// -- an 'impl' block may not sit in one --------------------------------------------------------------

@test("because a test build would keep it and every other build would drop it")
tfx_an_impl_may_not_sit_in_one()
    if !tfx_ready() then return

    val root = tfx_tree([("main.sysl", "import m.*\nprint(1)"),
                         ("m/m.sysl", "module m\n\ntrait Scale\n    scale(self, k: int) -> int\n\nstruct P\n    n: int"),
                         ("m/tests.sysl", "module m\n@tests\n\nimpl Scale for P\n    scale(self, k: int) -> int = self.n * k\n")])
    val (code, out) = tfx_cli("build", root)

    assert_eq(code, 1, out)
    assert(tfx_says(out, "an 'impl' block may not sit in a file that said '@tests' — a test build would " +
                    "keep it and every other build would drop it, so a trait would answer one way while " +
                    "the tests ran and another way in the program that ships. It belongs beside the type",
                    s"$root/m/tests.sysl:4:1", "4 | impl Scale for P"), out)

// -- a library ships none of it ----------------------------------------------------------------------

private tfx_lib() -> string = "module demo\n\ndouble(n: int) -> int = n * 2\n"

// The reference asserts its artifact's names; here a library root is read as source through `--lib`,
// so what a program built against it may name and what its text defines are the same claim.
@test("the artifact advertises what the module declared and not what its tests did")
tfx_the_library_advertises_what_the_module_declared()
    if !tfx_ready() then return

    val lib = tfx_tree([("demo/lib.sysl", tfx_lib()),
                        ("demo/tests.sysl", "module demo\n@tests\n\nquadruple(n: int) -> int = double(double(n))\n")])
    val checked = lbr_cli(["sysl", "build-lib", lib])

    assert_eq(checked.0, 0, checked.1)

    val calls = tfx_tree([("main.sysl", "import demo.*\nprint(quadruple(2))\n")])
    val refused = lbr_cli(["sysl", "build", calls, "--lib", lib])

    assert_eq(refused.0, 1, refused.1)
    assert(tfx_says(refused.1, tfx_refusal("demo.quadruple"), s"$calls/main.sysl:2:7",
                    "2 | print(quadruple(2))"), refused.1)

    val prog = tfx_tree([("main.sysl", "import demo.*\nprint(double(2))\n")])
    val text = lbr_text(s"$prog/main.sysl", [lib])

    assert(text.contains("@demo$double"), text)
    assert(!text.contains("quadruple"), text)
    assert_eq(lbr_run(s"$prog/main.sysl", [lib]), "4\n")
    lbr_drop([lib, calls, prog])

// A library's tests are parsed and never analyzed by `build-lib`: analysis is not a passive reading,
// and an instantiation a test caused would ship.
@test("an undefined name in one is no longer a build error, because it is never analyzed")
tfx_an_undefined_name_in_a_test_file_is_not_a_build_error()
    if !tfx_ready() then return

    val root = tfx_tree([("demo/lib.sysl", tfx_lib()),
                         ("demo/tests.sysl", "module demo\n@tests\n\nbad() -> int = nosuchthing()\n")])
    val (code, out) = tfx_cli("build-lib", root)

    assert_eq(code, 0, out)

// The strip happens after the parse, so a test file that is not well-formed text still stops it.
@test("but a syntax error in one still is, because the strip happens after the parse")
tfx_a_syntax_error_in_a_test_file_still_is()
    if !tfx_ready() then return

    val root = tfx_tree([("demo/lib.sysl", tfx_lib()),
                         ("demo/tests.sysl", "module demo\n@tests\n\n@test\nbad( = )\n")])
    val (code, out) = tfx_cli("build-lib", root)

    assert_eq(code, 1, out)
    assert(tfx_says(out, "')' expected", s"$root/demo/tests.sysl:5:6", "5 | bad( = )"), out)

// The discriminator: a `build-lib` that had stopped analyzing altogether would pass the first.
@test("while an ordinary declaration with the same undefined name still is")
tfx_an_ordinary_undefined_name_still_is()
    if !tfx_ready() then return

    val root = tfx_tree([("demo/lib.sysl", "module demo\n\nordinary() -> int = nosuchthing()\n")])
    val (code, out) = tfx_cli("build-lib", root)

    assert_eq(code, 1, out)
    assert(tfx_says(out, "undefined function 'nosuchthing'", s"$root/demo/lib.sysl:3:21",
                    "3 | ordinary() -> int = nosuchthing()"), out)

// The other end of the trade: a test build still analyzes all of it, including a helper no test
// calls, and reports every mistake rather than the first.
@test("but a test build still analyzes all of it, including a helper nothing calls")
tfx_a_test_build_analyzes_all_of_it()
    if !tfx_ready() then return

    val root = tfx_tree([("demo/lib.sysl", tfx_lib()),
                         ("demo/tests.sysl", "module demo\n@tests\n\nunreached() -> int = nosuchthing()\n\n" +
                                             "@test\nbad() = assert_eq(double(nowhere()), 4)\n")])
    val (code, out) = tfx_cli("test", root)

    assert_eq(code, 1, out)
    assert(tfx_says(out, "undefined function 'nosuchthing'", s"$root/demo/tests.sysl:4:22",
                    "4 | unreached() -> int = nosuchthing()"), out)
    assert(tfx_says(out, "undefined function 'nowhere'", s"$root/demo/tests.sysl:7:26",
                    "7 | bad() = assert_eq(double(nowhere()), 4)"), out)

@test("and a broken '@test' in an ordinary file is not a build error either")
tfx_a_broken_test_in_an_ordinary_file()
    if !tfx_ready() then return

    val root = tfx_tree([("demo/lib.sysl", "module demo\n\ndouble(n: int) -> int = n * 2\n\n@test\nbad() = nosuchthing()\n")])
    val (code, out) = tfx_cli("build-lib", root)

    assert_eq(code, 0, out)

// -- a file-private helper declared in two '@tests' files of one module is scaffolding in both -------
//
// The numbered `scratch` has to call something whose key is plain (`only_here`), or a fixture passes
// with the marking missing.

@test("the second file's helper may name what its own file declares")
tfx_the_second_files_helper()
    if !tfx_ready() then return

    val (names, code) = tfx_tested(tfx_tree([
        ("main.sysl", tfx_main()), ("m/m.sysl", tfx_double()),
        ("m/a_tests.sysl", "module m\n@tests\n\nprivate scratch(n: int) -> int = n + 1\n\n" +
                           "@test\nfirst_file() =\n    assert(scratch(1) == 2)\n"),
        ("m/b_tests.sysl", "module m\n@tests\n\nonly_here(n: int) -> int = n + 10\n\n" +
                           "private scratch(n: int) -> int = only_here(n)\n\n" +
                           "@test\nsecond_file() =\n    assert(scratch(1) == 11)\n")]))

    assert_eq(names, "first_file, second_file")
    assert_eq(code, 0)

@test("and neither file's helper is defined in the program built beside them")
tfx_neither_files_helper_is_defined()
    if !tfx_ready() then return

    val out = tfx_text(tfx_tree([
        ("main.sysl", tfx_main()), ("m/m.sysl", tfx_double()),
        ("m/a_tests.sysl", "module m\n@tests\n\nprivate scratch(n: int) -> int = n + 1"),
        ("m/b_tests.sysl", "module m\n@tests\n\nprivate scratch(n: int) -> int = n + 10")]))

    assert(out.contains("@m$double"), out)
    assert(!out.contains("scratch"), out)
