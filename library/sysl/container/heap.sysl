module sysl.container

import sysl.buf.{Buf, buf, buf_with_capacity}

// A priority queue: the smallest element is always the next one out.
//
// **It is a MIN-heap, and that is a decision rather than a coin toss.** The three things a priority
// queue is actually reached for -- a scheduler ordered by deadline, a shortest-path search ordered
// by distance, an event loop ordered by time -- all want the *smallest* first, and all three would
// otherwise have to negate their keys to get it. A max-heap is a min-heap over a reversed
// comparison, and reversing `Ord` needs a wrapper type the caller would have to declare, so
// whichever way round this goes one set of callers pays. It goes the way the common cases want.
//
// **The shape is a binary heap laid out in a `Buf`**, with no tree and no pointers: the children of
// the element at `i` are at `2i + 1` and `2i + 2`, and its parent is at `(i - 1) / 2`. So the whole
// structure is arithmetic over a growable sequence the library already has, which is why this module
// is short -- `Buf` does the growing and this does the ordering.
//
// The heap property is that no element is smaller than its parent. That is weaker than sorted, which
// is exactly why `push` and `pop` are logarithmic rather than linear: only one path from a leaf to
// the root is ever touched.
//
// **Walking a heap is deliberately not offered.** The storage order is not the priority order --
// only the *first* element is guaranteed to be anything in particular -- so a cursor over it would
// hand back elements in an order that looks meaningful and is not. Draining with `pop` is how a heap
// is read in order, and it is the only way that answers truthfully.
struct Heap[T: Ord]
    elems: Buf[T]

    len(self) -> usize = self.elems.len()

    is_empty(self) -> bool = self.elems.is_empty()

    // The smallest element, left where it is. `None` where there is nothing to look at, since asking
    // an empty queue what is next is an ordinary question rather than a mistake.
    peek(self) -> Option[T] = if self.elems.is_empty() then None else Some(self.elems.at(0))

    // An element added, then carried up past every parent it is smaller than.
    //
    // The walk stops at the first parent it is **not** smaller than, which is correct rather than an
    // approximation: everything above that parent is already no bigger than it, so nothing further
    // up can be bigger than the new element either.
    push(*self, v: T)
        self.elems.push(v)

        var i = self.elems.len() - 1

        while i > 0
            val parent = (i - 1) / 2

            if !(self.elems.at(i) < self.elems.at(parent)) then break

            self.swap(i, parent)
            i = parent
    end push

    // The smallest element removed and returned.
    //
    // The last element is moved to the root and sifted **down** rather than the tree being rebuilt:
    // taking the root leaves a hole at the top, and the only element that can be moved without
    // leaving a second hole is the last one, since it is the only one with no children to orphan.
    pop(*self) -> Option[T]
        if self.elems.is_empty() then return None

        val top = self.elems.at(0)
        val last = self.elems.pop()

        last match
            None -> ()
            Some(v) ->
                if !self.elems.is_empty()
                    self.elems.set(0, v)
                    self.sift_down(0)

        Some(top)
    end pop

    clear(*self) = self.elems.clear()

    private swap(*self, i: usize, j: usize)
        val a = self.elems.at(i)
        val b = self.elems.at(j)

        self.elems.set(i, b)
        self.elems.set(j, a)
    end swap

    // An element carried down past the smaller of its children until neither is smaller than it.
    //
    // **The smaller child is the one to swap with, and picking the wrong one silently breaks the
    // heap** rather than failing: swapping with the larger child leaves it sitting above its own
    // smaller sibling, so the property holds locally at the step that was taken and is violated one
    // level down where nothing looks again.
    private sift_down(*self, from: usize)
        val n = self.elems.len()
        var i = from

        loop
            val left = i * 2 + 1
            val right = left + 1
            var small = i

            if left < n && self.elems.at(left) < self.elems.at(small) then small = left
            if right < n && self.elems.at(right) < self.elems.at(small) then small = right

            if small == i then break

            self.swap(i, small)
            i = small
    end sift_down
end Heap

heap[T: Ord]() -> Heap[T]
    var h: Heap[T] = Heap(buf())

    h
end heap

// A heap whose storage is already big enough for `n` elements. The fill is written for the reason
// `buf_with_capacity`'s is: a generic `T` has no zero, and none of these slots is read.
heap_with_capacity[T: Ord](n: usize, fill: T) -> Heap[T]
    var h: Heap[T] = Heap(buf_with_capacity(n, fill))

    h
end heap_with_capacity

// Every element of a slice heaped at once.
//
// **This is linear where pushing them one at a time is not**, and the difference is the reason it is
// worth having rather than a convenience: sifting down from the last parent to the root touches each
// element once at a depth that halves as it rises, which comes to O(n), while n pushes come to
// O(n log n). The elements go in unordered and the heap property is established afterwards.
heap_of[T: Ord](xs: []const T) -> Heap[T]
    if xs.len == 0 then return heap()

    var h: Heap[T] = Heap(buf_with_capacity(xs.len, xs[0]))

    for i in 0..<xs.len
        h.elems.push(xs[i])

    if h.elems.len() > 1
        var i = h.elems.len() / 2

        while i > 0
            i -= 1
            h.sift_down(i)

    h
end heap_of
