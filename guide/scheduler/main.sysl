// The checks. Every line of output begins `ok`, so the whole of stdout is the assertion.
//
// Almost everything here is asserted against a **schedule** — one letter per tick, `.` for a tick
// nobody could use. A schedule is the only output of a scheduler that says everything: two runs
// that differ in who ran, in what order, or for how long, differ in that string. Every schedule
// below was worked out on paper before the program was run.

import sysl.buf.{Buf, buf}
import sysl.text.from_utf8

check(name: string, got: string, want: string)
    if got == want then print(s"ok    $name = $got")
    else print(s"FAIL  $name = $got, wanted $want")
end check

// Which tick a task first got. Subtracting its arrival gives the latency the run cost it, which is
// the number the two priority-inversion sections are about.
first_at(line: string, c: u8) -> int
    var b = line.bytes

    for i in 0..<b.len
        if b[i] == c then return int(i)

    -1
end first_at

// What a task watched go past between arriving and running. This is the sharpest way to say what
// priority inheritance does: with it the answer is the lock holder and nothing else.
wait_span(s: &Sched, t: &Task) -> string
    var line = s.schedule()

    line[usize(t.arrive)..<usize(first_at(line, t.mark()))]
end wait_span

print("-- the heap keeps its shape")

var q = run_queue()

check("an empty queue", str(q.is_empty()), "true")
check("and nothing comes out of it", str(q.pop().is_none()), "true")

var order: &Buf[&Task] = buf()

for i in 0..<9
    var t = task(s"t$i", (i * 7) % 9, 0, [Work(1)])

    t.seq = i
    q.push(t)
    order.push(t)

check("nine tasks went in", str(q.len()), "9")
check("the heap holds together", str(q.ok()), "true")

var out: &Buf[u8] = buf()

loop
    q.pop() match
        None -> break
        Some(t) -> out.push(48u8 + u8(t.prio))

check("and come out most urgent first", from_utf8(out.view()).unwrap_or("?"), "012345678")
check("leaving the queue empty", str(q.is_empty()), "true")
check("and every task knowing it is out", str(order[0usize].slot.is_none()), "true")

// Equal priorities are broken by the moment a task became ready, so a queue of four tasks that are
// all equally urgent hands them back in the order they joined it whatever order they went in.
var ties = run_queue()

for i in 0..<4
    var t = task(s"e$i", 7, 0, [Work(1)])

    t.seq = 4 - i
    ties.push(t)

var tied: &Buf[u8] = buf()

loop
    ties.pop() match
        None -> break
        Some(t) -> tied.push(t.name.bytes[1usize])

check("equal urgency is broken by which became ready first",
      from_utf8(tied.view()).unwrap_or("?"), "3210")

print("-- a task's place follows it")

var q2 = run_queue()
var five: &Buf[&Task] = buf()

for i in 0..<5
    var t = task(s"p$i", 10 + i, 0, [Work(1)])

    t.seq = i
    q2.push(t)
    five.push(t)

var least = five[4usize]

check("the least urgent is not at the root", str(least.slot.unwrap_or(0usize) != 0usize), "true")

least.prio = 1
q2.reprio(least)

check("lowering its number carried it to the root", str(least.slot.unwrap_or(99usize)), "0")
check("and the heap still holds", str(q2.ok()), "true")
check("so it comes out first", q2.pop().unwrap().name, "p4")

var most = five[0usize]

most.prio = 99
q2.reprio(most)

check("raising it pushed it down", str(most.slot.unwrap_or(0usize) != 0usize), "true")
check("the heap still holds", str(q2.ok()), "true")
check("and somebody else is at the root", q2.pop().unwrap().name, "p1")

// A running task is out of the queue by definition, and it is the common case for the task whose
// priority a lock has just raised — so repricing one has to be allowed and has to do nothing.
var loose = task("x", 5, 0, [Work(1)])

q2.reprio(loose)

check("repricing a task in no queue changes nothing", str(q2.ok()), "true")
check("and leaves it out of one", str(loose.slot.is_none()), "true")

print("-- one task, then two")

var s0 = sched(false)
var r0 = s0.run(50)

check("a machine with nothing to run is over before it starts", describe_outcome(r0), "finished at 0")
check("and its schedule is empty", str(s0.schedule().bytes.len), "0")

var s1 = sched(false)
var alone = s1.add(task("A", 1, 0, [Work(3)]))
var r1 = s1.run(50)

check("a task on its own gets every tick", s1.schedule(), "AAA")
check("and the run ends when it does", describe_outcome(r1), "finished at 3")
check("having done the work it was given", str(alone.ran), "3")
check("with no tick unused", str(s1.idle), "0")

var s2 = sched(false)

s2.add(task("A", 1, 0, [Work(3)]))
s2.add(task("B", 1, 0, [Work(3)]))
s2.run(50)

check("equal priorities share the processor a tick at a time", s2.schedule(), "ABABAB")

var s3 = sched(false)

s3.add(task("A", 1, 0, [Work(2)]))
s3.add(task("B", 2, 0, [Work(2)]))
s3.run(50)

check("an unequal pair does not", s3.schedule(), "AABB")

print("-- the most urgent ready task runs")

var s4 = sched(false)

s4.add(task("A", 1, 0, [Work(2)]))
s4.add(task("B", 2, 0, [Work(2)]))
s4.add(task("C", 3, 0, [Work(2)]))

var r4 = s4.run(50)

check("three tasks run in priority order", s4.schedule(), "AABBCC")
check("finishing together", describe_outcome(r4), "finished at 6")

// The order they were added in is not the order they run in, which is the difference between a
// queue and a heap: nothing about the schedule below comes from insertion order.
var s5 = sched(false)

s5.add(task("C", 3, 0, [Work(2)]))
s5.add(task("B", 2, 0, [Work(2)]))
s5.add(task("A", 1, 0, [Work(2)]))
s5.run(50)

check("and the same three added backwards run the same way", s5.schedule(), "AABBCC")

print("-- arriving in the middle")

var s6 = sched(false)
var low6 = s6.add(task("L", 3, 0, [Work(5)]))
var high6 = s6.add(task("H", 1, 2, [Work(2)]))
var r6 = s6.run(50)

check("an urgent task that arrives takes the processor", s6.schedule(), "LLHHLLL")
check("and gives it back when it is done", describe_outcome(r6), "finished at 7")
check("the interrupted task lost nothing", str(low6.ran), "5")
check("and the urgent one did its own work", str(high6.ran), "2")

var s7 = sched(false)

s7.add(task("A", 1, 3, [Work(2)]))

var r7 = s7.run(50)

check("time before anything arrives is nobody's", s7.schedule(), "...AA")
check("and is counted", str(s7.idle), "3")
check("the run still ends where the work does", describe_outcome(r7), "finished at 5")

print("-- a lock somebody else holds")

var m8 = mutex("m")
var s8 = sched(false)

s8.add(task("L", 2, 0, [Lock(m8), Work(3), Unlock(m8)]))

var high8 = s8.add(task("H", 1, 1, [Lock(m8), Work(2), Unlock(m8)]))
var r8 = s8.run(50)

check("an urgent task waits for a lock it cannot have", s8.schedule(), "LLLHH")
check("and runs the moment it is let go", describe_outcome(r8), "finished at 5")
check("having waited the rest of the critical section",
      str(first_at(s8.schedule(), high8.mark()) - high8.arrive), "2")
check("the lock ends free", str(m8.owner.is_none()), "true")
check("with nobody waiting on it", str(m8.waiters.is_empty()), "true")

// The classic three-task inversion, and the reason a scheduler needs decrease-key at all. `L` takes
// the lock, `M` is more urgent than `L` and wants nothing to do with the lock, and `H` is more
// urgent than both and wants the lock. Everything below is the same run twice with one switch
// changed.
print("-- priority inversion")

var mi = mutex("m")
var si = sched(false)
var low_i = si.add(task("L", 3, 0, [Lock(mi), Work(6), Unlock(mi)]))

si.add(task("M", 2, 2, [Work(4)]))

var high_i = si.add(task("H", 1, 4, [Lock(mi), Work(2), Unlock(mi)]))
var ri = si.run(100)

check("the schedule", si.schedule(), "LLMMMMLLLLHH")
check("the run is as long as the work in it", describe_outcome(ri), "finished at 12")
check("the most urgent task waited this long", str(first_at(si.schedule(), high_i.mark()) - high_i.arrive), "6")
check("and this is what it waited through", wait_span(si, high_i), "MMLLLL")
check("two of those ticks belong to a task less urgent than it", str(low_i.prio), "3")

print("-- what inheritance does about it")

var mh = mutex("m")
var sh = sched(true)
var low_h = sh.add(task("L", 3, 0, [Lock(mh), Work(6), Unlock(mh)]))
var mid_h = sh.add(task("M", 2, 2, [Work(4)]))
var high_h = sh.add(task("H", 1, 4, [Lock(mh), Work(2), Unlock(mh)]))
var rh = sh.run(100)

check("the schedule", sh.schedule(), "LLMMLLLLHHMM")
check("the same twelve ticks of work", describe_outcome(rh), "finished at 12")
check("the most urgent task waited this long", str(first_at(sh.schedule(), high_h.mark()) - high_h.arrive), "4")
check("and every tick of it was the lock holder's", wait_span(sh, high_h), "LLLL")
check("nobody did less work than before", str(low_h.ran) + "/" + str(mid_h.ran) + "/" + str(high_h.ran), "6/4/2")
check("and the lender ended with its own number", str(low_h.prio), "3")

// Watched in the middle rather than at the end, because the lent priority exists only while the
// lock is held and the finished run has no trace of it left.
var mp = mutex("m")
var sp = sched(true)
var low_p = sp.add(task("L", 3, 0, [Lock(mp), Work(6), Unlock(mp)]))

sp.add(task("M", 2, 2, [Work(4)]))

var high_p = sp.add(task("H", 1, 4, [Lock(mp), Work(2), Unlock(mp)]))

for i in 0..<5
    sp.tick()

check("five ticks in, the holder is running at the waiter's priority", str(low_p.prio), "1")
check("while the number it was created with is untouched", str(low_p.base), "3")
check("the waiter is blocked", describe_state(high_p.state), "blocked")
check("on the lock the holder holds", high_p.blocked_on.unwrap().name, "m")
check("and moving the holder left the queue a heap", str(sp.ready.ok()), "true")

sp.run(100)

check("when it lets go it has its own number back", str(low_p.prio), "3")

print("-- a lock several tasks want")

var mw = mutex("m")
var sw = sched(false)

sw.add(task("O", 5, 0, [Lock(mw), Work(3), Unlock(mw)]))
sw.add(task("A", 4, 1, [Lock(mw), Work(1), Unlock(mw)]))
sw.add(task("B", 2, 1, [Lock(mw), Work(1), Unlock(mw)]))
sw.add(task("C", 3, 1, [Lock(mw), Work(1), Unlock(mw)]))

var rw = sw.run(100)

check("a released lock goes to the most urgent waiter, not the longest", sw.schedule(), "OOOBCA")
check("and everybody gets it in the end", describe_outcome(rw), "finished at 6")
check("the lock ends free", str(mw.owner.is_none()), "true")
check("and its wait list empty", str(mw.waiters.is_empty()), "true")

// Lending a priority to a task that was going to run anyway changes nothing, which is worth
// asserting: an optimisation that changed a schedule it had no business changing would be a bug.
var mv = mutex("m")
var sv = sched(true)

sv.add(task("O", 5, 0, [Lock(mv), Work(3), Unlock(mv)]))
sv.add(task("A", 4, 1, [Lock(mv), Work(1), Unlock(mv)]))
sv.add(task("B", 2, 1, [Lock(mv), Work(1), Unlock(mv)]))
sv.add(task("C", 3, 1, [Lock(mv), Work(1), Unlock(mv)]))
sv.run(100)

check("and inheritance changes nothing when the holder was going to run anyway",
      sv.schedule(), "OOOBCA")

print("-- sleeping, and time nobody uses")

var ss = sched(false)
var sleeper = ss.add(task("A", 1, 0, [Work(1), Sleep(3), Work(1)]))

ss.add(task("B", 2, 0, [Work(2)]))

var rs = ss.run(50)

check("a sleeping task gives up the processor", ss.schedule(), "ABBA")
check("and takes it back when the clock reaches it", describe_outcome(rs), "finished at 4")
check("the sleeper finished", describe_state(sleeper.state), "done")
check("and no tick was wasted", str(ss.idle), "0")

var st = sched(false)

st.add(task("A", 1, 0, [Work(1), Sleep(2), Work(1)]))

var rt = st.run(50)

check("with nobody else to run, the processor stands idle", st.schedule(), "A.A")
check("which is counted", str(st.idle), "1")
check("and the run is longer than the work in it", describe_outcome(rt), "finished at 3")

// A sleep of no ticks is the shortest thing a task can ask for and still leave: it gives up what is
// left of the tick and is admitted again by the next one, which is what a yield is.
var su = sched(false)

su.add(task("A", 1, 0, [Work(1), Sleep(0), Work(1)]))

var ru = su.run(50)

check("a sleep of no ticks comes back at the next one", su.schedule(), "AA")
check("costing nothing", describe_outcome(ru), "finished at 2")

// Two tasks, two locks, each taking one and then wanting the other. Nothing here is a language
// question; it is in the set because a scheduler that cannot tell a deadlock from a slow run is
// one that hangs, and because it is the one run in this file that ends with the reference cycle
// still standing.
print("-- two tasks that will not finish")

var d1 = mutex("m1")
var d2 = mutex("m2")
var sd = sched(false)
var da = sd.add(task("A", 1, 0, [Lock(d1), Work(2), Lock(d2), Work(1), Unlock(d2), Unlock(d1)]))
var db = sd.add(task("B", 1, 0, [Lock(d2), Work(2), Lock(d1), Work(1), Unlock(d1), Unlock(d2)]))
var rd = sd.run(100)

check("they get four ticks between them", sd.schedule(), "ABAB")
check("and then the run stops rather than spinning", describe_outcome(rd), "stalled at 4")
check("both are blocked", describe_state(da.state) + "/" + describe_state(db.state), "blocked/blocked")
check("each on the lock the other holds",
      da.blocked_on.unwrap().name + "/" + db.blocked_on.unwrap().name, "m2/m1")
check("and each lock still points back at its owner",
      d1.owner.unwrap().name + "/" + d2.owner.unwrap().name, "A/B")

var e1 = mutex("m1")
var e2 = mutex("m2")
var se = sched(true)

se.add(task("A", 1, 0, [Lock(e1), Work(2), Lock(e2), Work(1), Unlock(e2), Unlock(e1)]))
se.add(task("B", 1, 0, [Lock(e2), Work(2), Lock(e1), Work(1), Unlock(e1), Unlock(e2)]))

var re = se.run(100)

check("lending a priority does not untangle it", describe_outcome(re), "stalled at 4")

// The other way to strand a program, and the one a real system meets more often: a task that runs
// off the end of its work still holding a lock. Nothing is deadlocked — one task simply finished
// without letting go — and the effect on everybody else is the same.
var mz = mutex("m")
var sz = sched(false)
var za = sz.add(task("A", 2, 0, [Lock(mz), Work(1)]))
var zb = sz.add(task("B", 1, 1, [Lock(mz), Work(1), Unlock(mz)]))
var rz = sz.run(100)

check("a task that finishes holding a lock strands whoever wants it", describe_outcome(rz), "stalled at 2")
check("the one that finished is finished", describe_state(za.state), "done")
check("the other is waiting on a task that will never run again", describe_state(zb.state), "blocked")
check("and the lock still names its owner", mz.owner.unwrap().name, "A")

print("-- what a task gets wrong")

var mf = mutex("m")
var sf = sched(false)
var af = sf.add(task("A", 1, 0, [Unlock(mf)]))
var rf = sf.run(10)

check("releasing a lock you never took", describe_fault(af.fault.unwrap()), "released m without holding it")
check("stops the task", describe_state(af.state), "faulted")
check("costing a tick nobody used", sf.schedule(), ".")
check("and the run ends", describe_outcome(rf), "finished at 1")

var mg = mutex("m")
var sg = sched(false)
var ag = sg.add(task("A", 1, 0, [Lock(mg), Lock(mg), Work(1)]))

sg.run(10)

check("taking a lock you already hold", describe_fault(ag.fault.unwrap()), "took m while already holding it")
check("leaves the lock held", str(mg.owner.is_some()), "true")
check("by the task that stopped", mg.owner.unwrap().name, "A")

var mk = mutex("m")
var sk = sched(false)
var ka = sk.add(task("A", 1, 0, [Lock(mk), Work(2)]))
var kb = sk.add(task("B", 2, 0, [Unlock(mk)]))

sk.run(10)

check("releasing a lock somebody else holds", describe_fault(kb.fault.unwrap()), "released m without holding it")
check("does not disturb the holder", describe_state(ka.state), "done")
check("and the schedule shows the tick it cost", sk.schedule(), "AA.")

var sn = sched(false)

sn.add(task("A", 1, 0, [Work(0), Work(2)]))

var rn = sn.run(10)

check("a step of no work is a step, and costs nothing", sn.schedule(), "AA")
check("so the run is the length of the rest", describe_outcome(rn), "finished at 2")

var so = sched(false)
var oa = so.add(task("A", 1, 0, []))
var ro = so.run(10)

check("a task with nothing to do is done as soon as it is looked at", describe_state(oa.state), "done")
check("and the run is over", describe_outcome(ro), "finished at 1")

print("-- many tasks at once")

var sb = sched(true)

for i in 0..<200
    sb.add(task(s"t$i", (i * 37) % 50, i % 10, [Work(1 + i % 3)]))

var rb = sb.run(5000)
var did = 0

for i in 0..<sb.tasks.len()
    did += sb.tasks[i].ran

check("two hundred tasks all finish", describe_outcome(rb), "finished at 399")
check("and the ticks add up to the work", str(did), "399")
check("with none of them idle", str(sb.idle), "0")
check("the schedule is one letter a tick", str(sb.schedule().bytes.len), "399")
check("the queue ends empty", str(sb.ready.is_empty()), "true")
check("and still a heap", str(sb.ready.ok()), "true")

// A scheduler is a graph of objects pointing at each other, and every edge of it is one that ARC
// cannot break on its own: a blocked task holds the lock it waits for while that lock's wait list
// holds the task. What keeps the memory honest is that the machine takes its own graph apart —
// every wait ends in a wakeup, every lock in a release — so a finished run holds nothing.
print("-- the graph comes apart")

var clean = 0

for i in 0..<sh.tasks.len()
    var t = sh.tasks[i]

    if t.holds.is_empty() && t.blocked_on.is_none() && t.slot.is_none() then clean += 1

check("every task let go of everything", str(clean), "3")
check("the lock is unowned", str(mh.owner.is_none()), "true")
check("nobody is waiting on it", str(mh.waiters.is_empty()), "true")
check("the queue is empty", str(sh.ready.is_empty()), "true")
check("and every task is finished", describe_state(sh.tasks[0usize].state), "done")
