module sh.sysl.compiler
@tests

import sh.sysl.parsing.source_of
import sysl.buf.{Buf, buf}
import sysl.text.Search

// The reference's `IntrinsicTests`: the back end's own operations, reached from sysl as `extern`s.
// The library can name one, the width in the emitted name is derived from the signature rather than
// written, and a declaration LLVM would refuse is refused earlier, at the line that wrote it.
//
// **Every diagnostic, output and IR line here was read out of the reference compiler (0.0.162)** by
// handing the installed `sysl` the same program. The harness is `tests_xvr_extern_var.sysl`'s:
// `xvr_ir` for the text (or the analysis's report where there is one), `xvr_ran` for a program
// linked and run.

private itr_main(text: string) -> []const (string, string) = [("main.sysl", text)]

private itr_ir(text: string) -> string = xvr_ir(itr_main(text))

private itr_ran(text: string) -> string = xvr_ran(itr_main(text))

// A refusal carries this message, anchored at the declaration on the first line.
private itr_refused(said: string, message: string) =
    assert(said.contains(s"error: $message\n --> main.sysl:1:1\n"), said)

// The LLVM text of one file lowered for a machine, or the first thing the program itself was told.
private itr_for(t: Target, text: string) -> string
    var units: Buf[Program] = buf()

    std_root() match
        Err(_) -> ()
        Ok(root) -> std_units(root, t) match
            Err(_) -> ()
            Ok(library) -> units = library

    if units.is_empty() then return "the library could not be read for this machine"

    val parsed = parse(source_of("main.sysl", text), t)

    if !parsed.ok() then return parsed.report.at(0).message

    units.push(parsed.program)

    val done = analyze_bodies(units, t)
    val whole = program_of(done, "")
    val promotions = post_analysis_checks(done.an, whole, buf())
    val said = errors_of(done.an.diagnostics())

    for item in said
        if !item.src.name.starts_with("library/") then return item.render()

    ir_print_module(codegen_with_gaps(prune(strip_tests(whole), program_own(units)), t, promotions).0)
end itr_for

// -- the declaration --------------------------------------------------------------------------------

// One base name, two widths, and the suffix comes from the signature: writing the whole name would
// state the width twice and let the two disagree.
@test("derives the width suffix from the types it was declared at")
itr_derives_the_width_suffix()
    if xvr_no_library() then return

    val out = itr_ir(raw"""
        private extern "llvm.sqrt" root(x: f64) -> f64
        private extern "llvm.sqrt" rootf(x: f32) -> f32

        print(root(144.0), rootf(16.0f32))
        """)

    assert(out.contains("declare double @llvm.sqrt.f64(double)"), out)
    assert(out.contains("declare float @llvm.sqrt.f32(float)"), out)
    assert(out.contains("call double @llvm.sqrt.f64("), out)
    assert(out.contains("call float @llvm.sqrt.f32("), out)
end itr_derives_the_width_suffix

@test("reaches the right values at both widths")
itr_reaches_the_right_values()
    if xvr_no_library() then return

    assert_eq(itr_ran(raw"""
        private extern "llvm.sqrt" root(x: f64) -> f64
        private extern "llvm.sqrt" rootf(x: f32) -> f32
        private extern "llvm.fabs" mag(x: f64) -> f64
        private extern "llvm.copysign" signed(x: f64, y: f64) -> f64
        private extern "llvm.floor" down(x: f64) -> f64
        private extern "llvm.ceil" up(x: f64) -> f64
        private extern "llvm.trunc" cut(x: f64) -> f64
        private extern "llvm.round" near(x: f64) -> f64

        print(root(144.0), rootf(16.0f32), mag(-2.5), signed(1.0, -0.0))
        print(down(-2.5), up(-2.5), cut(-2.5), near(-2.5), near(2.5))
        """), "12 4 2.5 -1\n-3 -2 -2 -3 3\n")
end itr_reaches_the_right_values

// The magnitude comes from the sign bit, so it is right for the operand a comparison cannot see.
@test("an intrinsic magnitude is right at a negative zero")
itr_magnitude_at_negative_zero()
    if xvr_no_library() then return

    assert_eq(itr_ran("private extern \"llvm.fabs\" mag(x: f64) -> f64\n\n" +
                      "print(mag(-0.0), mag(0.0), mag(-2.5))\n"), "0 0 2.5\n")

@test("the supported names are all in the namespace that makes them recognisable")
itr_supported_names_are_in_the_namespace()
    val names = supported_intrinsics()

    assert(names.len() > 0)

    for name in names
        assert(is_intrinsic_name(name), name)
end itr_supported_names_are_in_the_namespace

// Two declarations may share one symbol under different sysl names, and the derived suffix does not
// change it: a module declares each symbol once however many names reach it.
@test("two names for one intrinsic declare it once")
itr_two_names_declare_it_once()
    if xvr_no_library() then return

    val out = itr_ir(raw"""
        private extern "llvm.sqrt" root(x: f64) -> f64
        private extern "llvm.sqrt" also(x: f64) -> f64

        print(root(4.0), also(9.0))
        """)

    assert_eq(xvr_count(out, "declare double @llvm.sqrt.f64"), 1)
end itr_two_names_declare_it_once

// The third lowered width, which nothing in the library reaches: the suffix is read off the
// signature rather than off a list of the widths `sysl.math` happens to use.
@test("a width the library does not itself use")
itr_a_width_the_library_does_not_use()
    if xvr_no_library() then return

    val out = itr_ir("private extern \"llvm.fabs\" mag(x: f16) -> f16\n\nprint(mag(-1.5f16))\n")

    assert(out.contains("declare half @llvm.fabs.f16(half)"), out)

// -- the library takes the instruction rather than the call -----------------------------------------

// A program that takes a square root declares the intrinsic and not libm's `sqrt`, so there is no
// symbol left for a linker to resolve and a machine with no libc can run it.
@test("a program that roots a number names no libm symbol for it")
itr_a_root_names_no_libm_symbol()
    if xvr_no_library() then return

    val out = itr_ir("import sysl.math.*\n\nprint((144.0).sqrt())\n")

    assert(out.contains("@llvm.sqrt.f64"), out)
    assert(!out.contains("declare double @sqrt(double)"), out)
end itr_a_root_names_no_libm_symbol

// The complement: no machine sysl targets has a sine instruction, so it stays libm's.
@test("a program that takes a sine still names libm's")
itr_a_sine_still_names_libm()
    if xvr_no_library() then return

    val out = itr_ir("import sysl.math.*\n\nprint((0.5).sin())\n")

    assert(out.contains("declare double @sin(double)"), out)
    assert(!out.contains("@llvm.sin"), out)
end itr_a_sine_still_names_libm

// A bare machine has no libm to link against, so the operations that became instructions are the
// ones that reach a freestanding target -- a claim about the IR, there being no kernel to link here.
@test("the instructions reach a target that has no library to ask")
itr_the_instructions_reach_a_bare_target()
    if xvr_no_library() then return

    val t = target_named("aarch64-freestanding").unwrap()
    val out = itr_for(t, "import sysl.math.*\n\nprint((144.0).sqrt())\n")

    assert(out.contains("@llvm.sqrt.f64"), out)
    assert(!out.contains("declare double @sqrt(double)"), out)
end itr_the_instructions_reach_a_bare_target

// -- the error path ---------------------------------------------------------------------------------

// The list is closed on purpose: an intrinsic's signature is LLVM's to change, and a declaration
// that disagrees is a verifier failure or a miscompile rather than a link error.
@test("an intrinsic sysl does not support is refused by name")
itr_an_unsupported_intrinsic_is_refused_by_name()
    if xvr_no_library() then return

    itr_refused(itr_ir("private extern \"llvm.frobnicate\" f(x: f64) -> f64\n\nprint(f(1.0))\n"),
                "'llvm.frobnicate' is not an intrinsic sysl supports — it has llvm.ceil, " +
                "llvm.copysign, llvm.fabs, llvm.floor, llvm.fma, llvm.maximum, llvm.maxnum, " +
                "llvm.minimum, llvm.minnum, llvm.nearbyint, llvm.rint, llvm.round, llvm.roundeven, llvm.sqrt, llvm.trunc, " +
                "llvm.aarch64.crc32cb, llvm.aarch64.crc32ch, llvm.aarch64.crc32cw, llvm.aarch64.crc32cx, " +
                "llvm.x86.sse42.crc32.32.8, llvm.x86.sse42.crc32.32.16, llvm.x86.sse42.crc32.32.32, " +
                "llvm.x86.sse42.crc32.64.64")

@test("the wrong number of arguments")
itr_the_wrong_number_of_arguments()
    if xvr_no_library() then return

    itr_refused(itr_ir("private extern \"llvm.sqrt\" f(x: f64, y: f64) -> f64\n\nprint(f(1.0, 2.0))\n"),
                "'llvm.sqrt' takes 1 argument, but 2 were declared")
    itr_refused(itr_ir("private extern \"llvm.copysign\" f(x: f64) -> f64\n\nprint(f(1.0))\n"),
                "'llvm.copysign' takes 2 arguments, but 1 were declared")
end itr_the_wrong_number_of_arguments

@test("a type the intrinsic is not overloaded on")
itr_a_type_it_is_not_overloaded_on()
    if xvr_no_library() then return

    itr_refused(itr_ir("private extern \"llvm.sqrt\" f(x: int) -> int\n\nprint(f(1))\n"),
                "'llvm.sqrt' takes and returns one floating-point type, and this declaration " +
                "states int")

// Every operand and the result share one width: this is the declaration that would emit a `.f64`
// intrinsic called with a `float`, which the verifier catches and no one reads.
@test("widths that disagree with each other")
itr_widths_that_disagree()
    if xvr_no_library() then return

    itr_refused(itr_ir("private extern \"llvm.copysign\" f(x: f64, y: f32) -> f64\n\n" +
                       "print(f(1.0, 2.0f32))\n"),
                "'llvm.copysign' takes and returns one floating-point type, and this declaration " +
                "states real and f32")

@test("a tail an intrinsic has nowhere to put")
itr_a_tail_it_has_nowhere_to_put()
    if xvr_no_library() then return

    itr_refused(itr_ir("private extern \"llvm.sqrt\" f(x: f64, ...) -> f64\n\nprint(f(1.0))\n"),
                "an intrinsic takes a fixed argument list, so it may not be declared with '...'")

// The namespace holds code. Left alone this emits `@llvm.x = external global`, which the verifier
// rejects for a reason nobody would connect back to the line that caused it.
@test("an intrinsic name may not be storage")
itr_an_intrinsic_name_may_not_be_storage()
    if xvr_no_library() then return

    itr_refused(itr_ir("private extern \"llvm.sqrt\" x: f64\n\nprint(x)\n"),
                "'llvm.sqrt' is in the namespace the back end's own operations live in, and those " +
                "are code rather than storage — an 'extern' variable names a symbol the linker " +
                "resolves")

// And it is refused where it is written, whether or not anything reads it.
@test("an intrinsic name may not be storage, read or not")
itr_storage_refused_unread()
    if xvr_no_library() then return

    itr_refused(itr_ir("private extern \"llvm.sqrt\" x: f64\n\nprint(1)\n"),
                "'llvm.sqrt' is in the namespace the back end's own operations live in, and those " +
                "are code rather than storage — an 'extern' variable names a symbol the linker " +
                "resolves")

// -- the CRC-32C instructions -----------------------------------------------------------------------

// `#if crc32c`, the refusal of an `extern` naming one of the instructions, and `sysl.checksum`'s
// choice all read `crc32c_instruction`; these pin what it answers and what each reader does with it.

private itr_with_extensions(names: []const string)
    var xs: Buf[string] = buf()

    for name in names
        xs.push(name)

    use_codegen_features(CodegenFeatures(false, false, xs))
end itr_with_extensions

private itr_reset()
    use_codegen_features(no_codegen_features())
    use_cpu("", buf())

private itr_holds(items: Buf[string], word: string) -> bool
    for item in items
        if item == word then return true

    false

private itr_says_crc32c(t: Target) -> bool = itr_holds(defined(t), "crc32c")

// Measured against clang for each row's own triple: `crc32cx` assembles under `arm64-apple-macosx`
// (its default processor is the M1) and is "Cannot select" under `aarch64-unknown-linux-gnu`,
// `aarch64-none-elf` and `aarch64-linux-android24`; SSE 4.2's `crc32` under neither x86-64 triple.
@test("crc32c is true on aarch64-macos alone until the build promises the instruction")
itr_crc32c_symbol_per_target()
    itr_reset()

    for t in all_targets()
        assert_eq(itr_says_crc32c(t), t.name == "aarch64-macos", t.name)
        assert_eq(crc32c_instruction(t), itr_says_crc32c(t), t.name)

    var crc: [1]string = ["crc"]

    itr_with_extensions(crc[..])

    for t in all_targets()
        assert_eq(itr_says_crc32c(t), t.cpu == Aarch64, s"${t.name} with crc")

    var sse: [1]string = ["sse4.2"]

    itr_with_extensions(sse[..])

    for t in all_targets()
        assert_eq(itr_says_crc32c(t), t.cpu == X86_64 || t.name == "aarch64-macos", s"${t.name} with sse4.2")

    // No SSE at all under general_regs_only, and SSE 4.2 is part of it.
    var xs: Buf[string] = buf()

    xs.push("sse4.2")
    use_codegen_features(CodegenFeatures(true, false, xs))
    assert(!itr_says_crc32c(target_named("x86_64-linux").unwrap()), "general_regs_only")
    itr_reset()

    assert(itr_holds(symbols(), "crc32c"), "the vocabulary has it on every machine")
    assert(!itr_holds(directory_symbols(), "crc32c"), "a directory has no processor to ask")
end itr_crc32c_symbol_per_target

@test("crc32c follows --cpu: a named processor alone does not promise it, native's feature list does")
itr_crc32c_follows_the_processor()
    val mac = target_named("aarch64-macos").unwrap()
    val linux = target_named("aarch64-linux").unwrap()

    use_cpu("apple-m4", buf())
    assert(!itr_says_crc32c(mac), "a named processor's features are not known here")

    var features: Buf[string] = buf()

    features.push("+neon")
    features.push("+crc")
    use_cpu("apple-m4", features)
    assert(itr_says_crc32c(mac), "native, with +crc")
    assert(itr_says_crc32c(linux), "native's list on a linux row")

    var without: Buf[string] = buf()

    without.push("+neon")
    use_cpu("cortex-a53", without)
    assert(!itr_says_crc32c(linux), "a list that lacks it")
    itr_reset()
end itr_crc32c_follows_the_processor

private itr_crc_program() -> string =
    "private extern \"llvm.aarch64.crc32cx\" step(crc: u32, w: u64) -> u32\n" +
    "private extern \"llvm.aarch64.crc32cb\" byte(crc: u32, b: u32) -> u32\n\n" +
    "print(step(0xffffffff, 0x3837363534333231), byte(0, 7))\n"

@test("a CRC-32C instruction is emitted under its own name, unsuffixed, where the row has it")
itr_crc32c_reaches_the_text()
    if xvr_no_library() then return

    itr_reset()

    val out = itr_for(target_named("aarch64-macos").unwrap(), itr_crc_program())

    assert(out.contains("declare i32 @llvm.aarch64.crc32cx(i32, i64)"), out)
    assert(out.contains("declare i32 @llvm.aarch64.crc32cb(i32, i32)"), out)
    assert(out.contains("call i32 @llvm.aarch64.crc32cx("), out)
end itr_crc32c_reaches_the_text

@test("SSE 4.2's forms take the value at its own width, and the 64-bit one a 64-bit remainder")
itr_crc32c_x86_forms()
    if xvr_no_library() then return

    var sse: [1]string = ["sse4.2"]

    itr_with_extensions(sse[..])

    val out = itr_for(target_named("x86_64-linux").unwrap(),
        "private extern \"llvm.x86.sse42.crc32.32.8\" b8(crc: u32, b: u8) -> u32\n" +
        "private extern \"llvm.x86.sse42.crc32.32.16\" b16(crc: u32, b: u16) -> u32\n" +
        "private extern \"llvm.x86.sse42.crc32.32.32\" b32(crc: u32, b: u32) -> u32\n" +
        "private extern \"llvm.x86.sse42.crc32.64.64\" b64(crc: u64, b: u64) -> u64\n\n" +
        "print(b8(0, 1), b16(0, 1), b32(0, 1), b64(0, 1))\n")

    itr_reset()
    assert(out.contains("@llvm.x86.sse42.crc32.32.8(i32"), out)
    assert(out.contains("@llvm.x86.sse42.crc32.32.16(i32"), out)
    assert(out.contains("@llvm.x86.sse42.crc32.32.32(i32"), out)
    assert(out.contains("declare i64 @llvm.x86.sse42.crc32.64.64(i64, i64)"), out)
end itr_crc32c_x86_forms

@test("a CRC-32C instruction is refused where the row does not promise it, naming the extension")
itr_crc32c_refused_without_the_feature()
    if xvr_no_library() then return

    itr_reset()

    val arm = itr_for(target_named("aarch64-linux").unwrap(), itr_crc_program())

    assert(arm.contains("'llvm.aarch64.crc32cx' is an instruction 'aarch64-linux' does not promise, so " +
        "the back end could not select it — guard the declaration and its uses with '#if crc32c', or " +
        "name the extension in sysl.hocon: 'codegen { extensions = [\"crc\"] }'"), arm)

    val x86 = itr_for(target_named("x86_64-macos").unwrap(),
        "private extern \"llvm.x86.sse42.crc32.32.8\" b8(crc: u32, b: u8) -> u32\n\nprint(b8(0, 1))\n")

    assert(x86.contains("'llvm.x86.sse42.crc32.32.8' is an instruction 'x86_64-macos' does not promise"), x86)
    assert(x86.contains("extensions = [\"sse4.2\"]"), x86)
end itr_crc32c_refused_without_the_feature

@test("the same declaration under #if crc32c builds where the row lacks it, and its #else is used")
itr_crc32c_guarded_builds_everywhere()
    if xvr_no_library() then return

    itr_reset()

    val text = "#if crc32c\nprivate extern \"llvm.aarch64.crc32cx\" step(crc: u32, w: u64) -> u32\n" +
               "#else\nprivate step(crc: u32, w: u64) -> u32 = crc\n#endif\n\nprint(step(1, 2))\n"
    val linux = itr_for(target_named("aarch64-linux").unwrap(), text)
    val mac = itr_for(target_named("aarch64-macos").unwrap(), text)

    assert(!linux.contains("error") && !linux.contains("crc32cx"), linux)
    assert(mac.contains("@llvm.aarch64.crc32cx("), mac)
end itr_crc32c_guarded_builds_everywhere

@test("an instruction for the other processor is refused, whatever the build promises")
itr_crc32c_wrong_processor()
    if xvr_no_library() then return

    var both: [2]string = ["crc", "sse4.2"]

    itr_with_extensions(both[..])

    val x86 = itr_for(target_named("x86_64-linux").unwrap(), itr_crc_program())
    val arm = itr_for(target_named("aarch64-macos").unwrap(),
        "private extern \"llvm.x86.sse42.crc32.32.32\" b32(crc: u32, b: u32) -> u32\n\nprint(b32(0, 1))\n")
    val board = itr_for(target_named("thumb-freestanding").unwrap(), itr_crc_program())

    itr_reset()
    assert(x86.contains("'llvm.aarch64.crc32cx' is an AArch64 instruction, and this build is for 'x86_64-linux'"), x86)
    assert(arm.contains("'llvm.x86.sse42.crc32.32.32' is an x86-64 instruction, and this build is for 'aarch64-macos'"), arm)
    assert(board.contains("is an AArch64 instruction, and this build is for 'thumb-freestanding'"), board)
end itr_crc32c_wrong_processor

@test("each CRC-32C instruction has exactly one signature, and a different one is refused")
itr_crc32c_signature()
    if xvr_no_library() then return

    itr_reset()

    val mac = target_named("aarch64-macos").unwrap()
    val narrow = itr_for(mac, "private extern \"llvm.aarch64.crc32cx\" f(crc: u32, w: u32) -> u32\n\nprint(f(0, 1))\n")
    val word = itr_for(mac, "private extern \"llvm.aarch64.crc32cx\" f(crc: u32, w: usize) -> u32\n\nprint(f(0, 1))\n")
    val signed = itr_for(mac, "private extern \"llvm.aarch64.crc32cb\" f(crc: i32, b: u32) -> u32\n\nprint(f(0, 1))\n")
    val short = itr_for(mac, "private extern \"llvm.aarch64.crc32cw\" f(crc: u32) -> u32\n\nprint(f(0))\n")
    val byte = itr_for(mac, "private extern \"llvm.aarch64.crc32cb\" f(crc: u32, b: u8) -> u32\n\nprint(f(0, 1))\n")

    // Types are written as diagnostics write them: `u32` is `uint`, `u64` is `ulong`.
    val w = type_show(Integer(32, false, false))
    val x = type_show(Integer(64, false, false))
    val i = type_show(Integer(32, true, false))
    val b = type_show(Integer(8, false, false))

    assert(narrow.contains(s"'llvm.aarch64.crc32cx' is '($w, $x) -> $w', and this declaration states '($w, $w) -> $w'"), narrow)
    assert(word.contains(s"and this declaration states '($w, usize) -> $w'"), word)
    assert(signed.contains(s"'llvm.aarch64.crc32cb' is '($w, $w) -> $w', and this declaration states '($i, $w) -> $w'"), signed)
    assert(short.contains(s"'llvm.aarch64.crc32cw' is '($w, $w) -> $w', and this declaration states '($w) -> $w'"), short)
    assert(byte.contains(s"and this declaration states '($w, $b) -> $w'"), byte)
end itr_crc32c_signature

@test("an instruction's name holds no address, as every intrinsic's does not")
itr_crc32c_has_no_address()
    if xvr_no_library() then return

    itr_reset()

    val out = itr_for(target_named("aarch64-macos").unwrap(),
        "private extern \"llvm.aarch64.crc32cw\" f(crc: u32, w: u32) -> u32\n\nval p = &f\nprint(p(0, 1))\n")

    assert(out.contains("is an intrinsic, which the back end lowers to an instruction"), out)
end itr_crc32c_has_no_address
