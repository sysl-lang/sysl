module sh.sysl.compiler
@tests

import sysl.fs.{is_file, write_text}
import sysl.process.capture
import sysl.text.Search
import sysl.testing.skip

// **`libc`: a C library under the program, granted by the manifest where a freestanding board has
// one.**
//
// No specifier needs it -- every one is rendered by the library, so a string and a float format on a
// bare target with no `snprintf` to call. What it still decides is C's own functions a program asks
// for, such as the `posix_memalign` an over-aligned box defaults to. A hosted target has it; a
// freestanding one has it only where `package.hocon` grants it -- `targets { <t> { capabilities {
// libc = true } } }`, which is what a Pico SDK build linking newlib says. Granting it makes C's own
// functions reachable and nothing more: the library's hooks are about an operating system, so a
// program reaching `sysl.fs` still answers them itself.

private val lic_target: string = "aarch64-freestanding"
private val lic_nm: string = "/opt/homebrew/opt/llvm/bin/llvm-nm"

private val lic_name: string = "package { name = \"probe\", version = \"0.1.0\" }\n"

private val lic_granted: string =
    s"targets {\n  $lic_target {\n    capabilities { libc = true }\n  }\n}\n"

// A string specifier, reached from an export.
private val lic_strings: string = raw"""
    @export("probe")
    probe(n: int) -> usize
        val s = if n > 0 then "pos" else "neg"

        f"${s}%8s".bytes.len
    """

// Every way a float becomes text or text a float: a specifier at each width, a plain hole, `str`,
// `print` and a parse -- none of which asks C for anything.
private val lic_floats: string = raw"""
    import sysl.text.{parse_f32, parse_real}

    @export("probe")
    probe(x: real, y: f32) -> usize
        print(x, y)

        val back = parse_real("2.5") match
            Ok(v) -> v
            Err(_) -> 0.0

        val narrow = parse_f32("0.1") match
            Ok(v) -> v
            Err(_) -> f32(0.0)

        f"${x}%.3f ${y}%e".bytes.len + s"$x $y".bytes.len + str(back).bytes.len + str(narrow).bytes.len
    """

// A program reading one file, which reaches `sysl.fs`'s hooks and answers none of them.
private val lic_reads_a_file: string = raw"""
    import sysl.fs.read_text

    @export("probe")
    probe() -> int = read_text("/hello.txt") match
        Ok(s) -> int(s.bytes.len)
        Err(_) -> -1
    """

private lic_project(program: string, config: string) -> string =
    lbr_tree(lbr_two("main.sysl", program, "package.hocon", lic_name + config))

// What `sysl build-c` answers for the project, and the archive it was asked to write.
private lic_build_c(root: string) -> ((int, string), string)
    val archive = s"$root/probe.a"

    (lbr_cli(["sysl", "build-c", "--target", lic_target, "-o", archive, root]), archive)
end lic_build_c

// The symbols an archive leaves for its linker to find, one per line.
private lic_undefined(archive: string) -> string = capture(lic_nm, ["-u", archive], "", [], true) match
    Ok(o) -> o.text
    Err(_) -> "llvm-nm could not be run"

private lic_names(listing: string, symbol: string) -> bool
    for line in lines_of(listing)
        val word = line.trim()

        if word == symbol || word.ends_with(s" $symbol") then return true

    false
end lic_names

@test("without libc, a freestanding string specifier builds, and the archive asks for no snprintf")
lic_no_libc_builds_strings()
    if !lbr_ready() then return
    if !is_file(lic_nm) then skip(s"there is no llvm-nm at $lic_nm to read the archive")

    val root = lic_project(lic_strings, "")
    val (said, archive) = lic_build_c(root)

    assert(said.0 == 0, said.1)

    val undefined = lic_undefined(archive)

    lbr_drop([root])
    assert(!lic_names(undefined, "snprintf") && !lic_names(undefined, "_snprintf"), undefined)
end lic_no_libc_builds_strings

@test("without libc, every float conversion builds, and the archive asks for no snprintf or strtod")
lic_no_libc_builds_floats()
    if !lbr_ready() then return
    if !is_file(lic_nm) then skip(s"there is no llvm-nm at $lic_nm to read the archive")

    val root = lic_project(lic_floats, "")
    val (said, archive) = lic_build_c(root)

    assert(said.0 == 0, said.1)

    val undefined = lic_undefined(archive)

    lbr_drop([root])

    for c in ["snprintf", "strtod", "strtof", "printf", "sprintf"]
        assert(!lic_names(undefined, c) && !lic_names(undefined, "_" + c), undefined)

    // The float renderer is in the archive rather than left out: the probe reaches it.
    assert(!lic_names(undefined, "sysl.fmt$format_real"), undefined)
end lic_no_libc_builds_floats

@test("a C library granted is not an operating system: a program reaching sysl.fs still answers the hooks")
lic_granted_libc_still_wants_hooks()
    if !lbr_ready() then return

    val root = lic_project(lic_reads_a_file, lic_granted)
    val (said, _) = lic_build_c(root)

    lbr_drop([root])
    assert(said.0 != 0, "built with the filesystem's hooks unanswered")
    assert(said.1.contains(s"this program reaches 'sysl.fs', and '$lic_target' has no operating " +
        "system under it for the standard library to answer a filesystem with — the C library its " +
        "'libc' capability grants is not an operating system — so the program answers it: define "),
        said.1)
end lic_granted_libc_still_wants_hooks

@test("on a hosted target nothing changes: a float hole and specifier run and print")
lic_hosted_is_unchanged()
    if !lbr_ready() then return

    val root = lic_project(raw"""
        val x = 1.5

        print(f"${x}%.2f $x")
        """, "")
    val printed = lbr_run(root, [])

    lbr_drop([root])
    assert_eq(printed, "1.50 1.5\n")
end lic_hosted_is_unchanged

// A box of a page-aligned struct, reached from an export: the lowering asks `sysl_alloc_aligned` for
// it, and the defaults over `posix_memalign` and `free` are written only where a C library stands.
private val lic_aligned_box: string = raw"""
    @align(4096)
    struct Page
        e: [512]u64

    @export("probe")
    probe() -> int
        var t: Page
        t.e[1] = 3
        val b: &Page = t

        int(b.e[1])
    end probe
    """

@test("with libc granted, a freestanding over-aligned box takes the posix_memalign default and is not refused")
lic_granted_libc_defaults_the_aligned_pair()
    if !lbr_ready() then return
    if !is_file(lic_nm) then skip(s"there is no llvm-nm at $lic_nm to read the archive")

    val root = lic_project(lic_aligned_box, lic_granted)
    val (said, archive) = lic_build_c(root)

    assert(said.0 == 0, said.1)

    val undefined = lic_undefined(archive)

    lbr_drop([root])
    assert(lic_names(undefined, "posix_memalign") || lic_names(undefined, "_posix_memalign"), undefined)
    assert(!lic_names(undefined, "sysl_alloc_aligned"), undefined)
    assert(!lic_names(undefined, "sysl_free_aligned"), undefined)
end lic_granted_libc_defaults_the_aligned_pair

@test("without libc, a freestanding over-aligned box is refused, naming both aligned hooks")
lic_no_libc_refuses_the_aligned_box()
    if !lbr_ready() then return

    val root = lic_project(lic_aligned_box, "")
    val (said, _) = lic_build_c(root)

    lbr_drop([root])
    assert(said.0 != 0, "built an over-aligned box with no C library and no aligned hook")
    assert(said.1.contains(s"'$lic_target' has no C library with an aligned allocation to answer it. " +
        "Define 'sysl_alloc_aligned(size: usize, align: usize) -> *u8' and " +
        "'sysl_free_aligned(p: *u8)' with '@export'"), said.1)
end lic_no_libc_refuses_the_aligned_box

@test("the run cache keys a freestanding build with libc granted apart from one without")
lic_libc_changes_the_key()
    if !std_root().is_ok() then return

    val root = lic_project("print(1)\n", "")
    val without = run_cache_key_for("run", root, Some(lic_target), DefaultOptimization, None)

    write_text(s"$root/package.hocon", lic_name + lic_granted).unwrap()

    val with_libc = run_cache_key_for("run", root, Some(lic_target), DefaultOptimization, None)

    write_text(s"$root/package.hocon", lic_name + "capabilities { libc = true }\n").unwrap()

    val project_wide = run_cache_key_for("run", root, Some(lic_target), DefaultOptimization, None)

    lbr_drop([root])
    assert(without.is_some() && with_libc.is_some() && project_wide.is_some())
    assert(without.unwrap() != with_libc.unwrap(), "granting libc is a different program")
    assert_eq(project_wide.unwrap(), with_libc.unwrap())
end lic_libc_changes_the_key
