module sysl.posix.threads
@requires(posix, libc)

import sysl.threads as th

/** `sysl.threads` under the name it had when its threads were pthreads, kept for the programs that
 * import it. **Write `sysl.threads`**: it is the same API, it asks only for `os`, and it reaches a
 * kernel's threads through the hooks of `sysl.threads.sys` where this name asks for POSIX and a C
 * library the threads no longer need.
 *
 * Every name here is the one in `sysl.threads` -- the types as aliases, the functions forwarding --
 * so a value made through either module is the other's.
 */

type Thread = th.Thread
type SleepLock = th.SleepLock
type Mutex[T] = th.Mutex[T]
type Condvar = th.Condvar
type Channel[T] = th.Channel[T]

/** `sysl.threads.spawn`, with the stack it gives a thread where nothing else is asked for. `arg`
 * crosses because the body hands it to `spawn`'s, which the compiler sees.
 */
spawn[T](body: *extern(*T) -> unit, arg: *T) -> Option[Thread] = th.spawn(body, arg)

/** `sysl.threads.spawn_on`. */
spawn_on[T](stack: []u8, body: *extern(*T) -> unit, arg: *T) -> Option[Thread] =
    th.spawn_on(stack, body, arg)

/** `sysl.threads.yield_now`. */
yield_now() -> bool = th.yield_now()

/** `sysl.threads.current`. */
current() -> Thread = th.current()

/** `sysl.threads.channel`. */
channel[T](slots: []T) -> Channel[T] = th.channel(slots)
