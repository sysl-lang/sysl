module sysl.dma
@no_alloc

import sysl.sync.Ordering

/** Memory a device can reach by address, and the handover that makes it safe to share with one.
 *
 * A device reads and writes memory by the address *it* sees -- a physical address, or a bus address
 * where an IOMMU stands between -- in runs that have to be contiguous on its side. A `[]u8` says
 * none of that: it may be a heap block, a stack array or a page of a window mapped from whatever
 * frames were free, and nothing in its type says which. So a driver that puts a caller's slice into
 * a descriptor compiles for every slice and is right for only some of them, and where it is wrong the
 * device writes to memory that is not the buffer.
 *
 * **A `Region` is the other kind of buffer: it carries the device's address of its first byte.** It
 * is made in one place -- `adopt`, called by whatever owns device-reachable memory, usually a
 * kernel's frame allocator behind a `Source` -- and nowhere else: its fields are private, so no
 * program builds one from a slice, and `ptr_cast` cannot make one, a `Region` not being a pointer.
 * A function that hands memory to a device takes a `Region`, and a caller holding an ordinary slice
 * is refused at the call rather than finding out on hardware.
 *
 * ```
 * val r = dma.adopt(frame_va, frame_pa, 8192)     // the one trust point
 * val header = r.part(0, 16)                       // a part is a Region too, and costs nothing
 * desc.addr = header.bus()                         // the device's address, never computed
 * ```
 *
 * **A part of a region is a region**, four words and no count, so cutting one costs what cutting a
 * slice costs and a part crosses a concurrency domain as freely as a `*T` does. **The region does not
 * own its memory** -- the same bargain `Ring` and `*T` make: whoever adopted it frees it, through the
 * `Source` it came from, and after every device that was handed it has finished with it.
 *
 * **The handover is two calls, and they are the cache maintenance.** On a machine whose caches the
 * device does not see, a write the processor made may still be in a cache when the device reads the
 * memory, and a line the processor cached before the device wrote may be read in place of what the
 * device wrote. `to_device` before the device is told about the region and `from_device` after it
 * says it has finished are what make both right; on a coherent region each is only the barrier.
 */

/** Memory a device can reach: `size` bytes at `base` as the processor sees them, which the device
 * sees at `device`.
 */
struct Region
    private base: *u8
    private device: u64
    private size: usize
    private coherent: bool

    /** How many bytes the region holds. */
    len(self) -> usize = self.size

    is_empty(self) -> bool = self.size == 0

    /** The address the device uses for the region's first byte -- what goes into a descriptor, a
     * queue register or a DMA controller's source.
     */
    bus(self) -> u64 = self.device

    /** Whether the device sees the processor's caches, so the handover needs no maintenance. */
    is_coherent(self) -> bool = self.coherent

    /** The region as the processor reads and writes it. */
    bytes(self) -> []u8
        var p = self.base

        p[0..<self.size]

    /** `len` bytes of this region from byte `from`. Reaching past the end is a mistake in the program
     * rather than a question, so it panics -- a part that ran past its region would hand a device
     * memory the region does not cover.
     */
    part(self, from: usize, len: usize) -> Region
        if from > self.size || len > self.size - from then outside(from, len, self.size)

        Region(&self.base[from], self.device + u64(from), len, self.coherent)

    /** Where the device sees the `T` at `p`, which has to lie wholly inside the region -- a field of
     * a struct laid over it, an element of a ring in it. Anything else panics, because it is exactly
     * the address a device must never be handed.
     */
    bus_of[T](self, p: *T) -> u64
        val at = usize(p)
        val first = usize(self.base)

        if at < first || at - first > self.size || sizeof(T) > self.size - (at - first)
            not_inside(sizeof(T), self.size)

        self.device + u64(at - first)

    /** The `T` laid over the region at byte `offset` -- a queue's shared structure, a descriptor
     * table. The `T` has to fit and be aligned, or this panics; that is the check a hand-written
     * `ptr_cast` beside an `@assert` of the size leaves to the reader.
     */
    at[T](self, offset: usize) -> *T
        if offset > self.size || sizeof(T) > self.size - offset
            outside(offset, sizeof(T), self.size)

        if (usize(self.base) + offset) % alignof(T) != 0 then misaligned(offset, alignof(T))

        ptr_cast(&self.base[offset])

    /** Hand the region to the device: whatever the processor wrote reaches memory, and no line of it
     * stays cached to be written back over what the device writes later. Call it before the device is
     * told about the region, whichever way the data is going.
     */
    to_device(self) = handover(self)

    /** Take the region back from the device: whatever the processor reads next comes from memory,
     * not from a line cached while the device was writing. Call it after the device says it has
     * finished.
     */
    from_device(self) = handover(self)
end Region

/** **The one place a device address enters a program**: `len` bytes at `base`, which the device sees
 * at `bus`. The caller is stating a fact no type can check -- that the run is contiguous on the
 * device's side and stays where it is while a device holds it -- which is why it is said once, by
 * whatever owns device memory, rather than at every descriptor.
 *
 * `coherent` says the device sees the processor's caches (or the memory is mapped uncached), so the
 * handover is a barrier and nothing more. **Only AArch64 has its maintenance here**: on any other
 * machine a region that is not coherent is refused, rather than handed over without the maintenance
 * it needs.
 */
adopt(base: *u8, bus: u64, len: usize, coherent: bool = false) -> Region
#if aarch64
    Region(base, bus, len, coherent)
#else
    if !coherent then no_maintenance()

    Region(base, bus, len, coherent)
#endif

/** What hands out device-reachable memory -- a kernel's frame allocator, a reserved carve-out, a
 * user-space driver's pinned pages. A driver written against it allocates its rings and buffers
 * without knowing which.
 */
trait Source
    /** A region of at least `len` bytes, or nothing where there is none. */
    take(*self, len: usize) -> Option[Region]

    /** A region `take` handed out, every device being finished with it. */
    give(*self, r: Region)

/** The processor's half of a handover in either direction. A region that is not coherent has every
 * cache line it touches cleaned and invalidated -- cleaned so the device reads what was written,
 * invalidated so neither a dirty line evicted later nor a clean one read later stands in for the
 * memory. One operation serves both directions, which is what keeps the rule one sentence: **while
 * the device holds a region, the processor writes nothing in the cache lines it touches.** Then the
 * barrier, so the maintenance is finished before the store that tells the device.
 */
private handover(r: Region)
#if aarch64
    if !r.coherent && r.size != 0
        val line = data_line()
        val end = usize(r.base) + r.size
        var at = usize(r.base) / line * line

        while at < end
            dc(civac, u64(at))
            at += line

    dsb(sy)
#else
    atomic_fence(Ordering.SeqCst)
#endif
end handover

#if aarch64
/** The smallest data cache line of any cache this processor has, in bytes: CTR_EL0's DminLine is its
 * log2 in four-byte words. Stepping by the smallest line touches every line of every cache, and a
 * step shorter than the real line is only repetition, never a line missed.
 *
 * **macOS traps a read of CTR_EL0 from a program**, so there the step is 64 bytes, which no Apple
 * processor's line is shorter than.
 */
private data_line() -> usize
#if macos
    64
#else
    4 << usize((read_sysreg("ctr_el0") >> 16) & 15)
#endif
#endif

private outside(from: usize, len: usize, size: usize) -> never
    prints("panic: bytes ")
    printi(long(from))
    prints(" to ")
    printi(long(from + len))
    prints(" are outside a dma.Region of ")
    printi(long(size))
    prints(" bytes\n")
    exit(1)

private not_inside(len: usize, size: usize) -> never
    prints("panic: the ")
    printi(long(len))
    prints(" bytes at that address are not inside this dma.Region of ")
    printi(long(size))
    prints(" bytes\n")
    exit(1)

private misaligned(offset: usize, alignment: usize) -> never
    prints("panic: byte ")
    printi(long(offset))
    prints(" of this dma.Region is not aligned to ")
    printi(long(alignment))
    prints("\n")
    exit(1)

private no_maintenance() -> never
    prints("panic: only AArch64 has the cache maintenance a dma.Region needs, so on this machine one has to be adopted as coherent\n")
    exit(1)
