module sh.sysl.compiler

import sysl.buf.Buf

// A walk over a typed body, node by node.
//
// **Every check that asks "what does this body do?" asks it of the whole tree**, and the tree is a
// hundred and ten expression forms deep. The reference compiler reaches them with reflection over
// its case classes, which is a walk it never has to write down; here the walk is written once and
// every check is a function handed to it.
//
// `clauses` is what separates the part of a body that RUNS from the part that only states
// something. A `require`, an `ensure`, a loop's `invariant` and its `variant` are conditions the
// program is held to, and one of them may name a declaration that is not there when the program
// runs -- so a check about execution walks with `clauses` false and one about the whole text walks
// with it true.

// What one walk is for: whether it enters the clauses, and what it is told about each node.
//
// `on_write` is separate because a write carries names as DATA rather than as nodes -- the
// dispatched operator it goes through, and the invariant it has to re-establish -- so a walk that
// only saw expressions would miss the functions a statement calls.
struct TWalk
    clauses: bool
    on_expr: &Fn(TExpr) -> unit
    on_write: &Fn(TWrite) -> unit
    on_stmt: &Fn(TStmt) -> unit
end TWalk

// A walk that is only interested in the expressions.
expr_walk(clauses: bool, on_expr: &Fn(TExpr) -> unit) -> &TWalk =
    TWalk(clauses, on_expr, w -> (), s -> ())

// One that is only interested in the statements, which is what a question about a body's shape asks.
stmt_walk(clauses: bool, on_stmt: &Fn(TStmt) -> unit) -> &TWalk =
    TWalk(clauses, e -> (), w -> (), on_stmt)

// Visits every expression of a body, outermost first.
walk_stmts(stmts: Buf[TStmt], v: &TWalk)
    for i in 0..<stmts.len()
        walk_stmt(stmts.at(i), v)
end walk_stmts

walk_stmt(s: TStmt, v: &TWalk)
    v.on_stmt(s)

    s match
        TVarDecl(_, _, init, _) -> walk_texpr(init, v)
        TExprStmt(e) -> walk_texpr(e, v)
        TInvariant(cond, _) -> if v.clauses then walk_texpr(cond, v)
        TVariantCheck(_, _, e) -> if v.clauses then walk_texpr(e, v)
        TRefDecl(_, _, place) -> walk_texpr(place, v)
        TWriteStmt(w) -> walk_write(w, v)
        TMultiAssign(writes) ->
            for i in 0..<writes.len()
                walk_write(writes.at(i), v)
        TReturn(value) -> if value.is_some() then walk_texpr(value.unwrap(), v)
        TBecome(call) -> walk_texpr(call, v)
        TBreak(value, _) -> if value.is_some() then walk_texpr(value.unwrap(), v)
        TContinue(_) -> ()
        TDefer(stmts) -> walk_stmts(stmts, v)
        TAsm(_, _, _) -> ()
end walk_stmt

private walk_write(w: TWrite, v: &TWalk)
    v.on_write(w)
    walk_texpr(w.place, v)
    walk_texpr(w.value, v)

    for i in 0..<w.check.len()
        walk_texpr(w.check.at(i).value, v)
end walk_write

private walk_block(b: TBlock, v: &TWalk)
    walk_stmts(b.stmts, v)

    if b.result.is_some() then walk_texpr(b.result.unwrap(), v)
end walk_block

private walk_opt_block(b: Option[TBlock], v: &TWalk)
    if b.is_some() then walk_block(b.unwrap(), v)
end walk_opt_block

private walk_all(es: Buf[TExpr], v: &TWalk)
    for i in 0..<es.len()
        walk_texpr(es.at(i), v)
end walk_all

private walk_opt(e: Option[TExpr], v: &TWalk)
    if e.is_some() then walk_texpr(e.unwrap(), v)
end walk_opt

private walk_terms(cond: Buf[TCondTerm], v: &TWalk)
    for i in 0..<cond.len()
        cond.at(i) match
            TCondTest(c) -> walk_texpr(c, v)
            TCondIs(subject, patterns, _) ->
                walk_texpr(subject, v)

                for j in 0..<patterns.len()
                    walk_tpattern(patterns.at(j), v)
end walk_terms

// A pattern holds expressions where it compares against one: a literal arm, and the ends of a
// range.
walk_tpattern(p: TPattern, v: &TWalk)
    p match
        TWildPattern(_) -> ()
        TBindPattern(_, _) -> ()
        TAtPattern(_, inner) -> walk_tpattern(*inner, v)
        TLitPattern(value) -> walk_texpr(value, v)
        TRangePattern(lo, hi, _) ->
            walk_texpr(lo, v)
            walk_texpr(hi, v)
        TVariantPattern(_, _, args) ->
            for i in 0..<args.len()
                walk_tpattern(args.at(i), v)
        TStructPattern(_, args) ->
            for i in 0..<args.len()
                walk_tpattern(args.at(i), v)
end walk_tpattern

// The expression itself, then everything under it.
walk_texpr(e: TExpr, v: &TWalk)
    v.on_expr(e)

    *e.kind match
        TIntLit(_, _) -> ()
        TFloatLit(_, _) -> ()
        TStrLit(_) -> ()
        TBoolLit(_) -> ()
        TUnitLit -> ()
        TNullLit(_) -> ()
        TBox(value, _) -> walk_texpr(value, v)
        TDowngrade(value, _) -> walk_texpr(value, v)
        TUpgrade(value, _, _, _) -> walk_texpr(value, v)
        TZero(_) -> ()
        TArrayLit(elems, _) -> walk_all(elems, v)
        TArrayFill(value, _) -> walk_texpr(value, v)
        TVectorLit(lanes, _) -> walk_all(lanes, v)
        TSplat(value, _) -> walk_texpr(value, v)
        TLane(receiver, _, _) -> walk_texpr(receiver, v)
        TVecCompare(_, left, right, _) ->
            walk_texpr(left, v)
            walk_texpr(right, v)
        TSelect(mask, when_true, when_false, _) ->
            walk_texpr(mask, v)
            walk_texpr(when_true, v)
            walk_texpr(when_false, v)
        TReduce(_, receiver, _) -> walk_texpr(receiver, v)
        TVecLoad(receiver, index, _) ->
            walk_texpr(receiver, v)
            walk_texpr(index, v)
        TVecStore(receiver, index, value) ->
            walk_texpr(receiver, v)
            walk_texpr(index, v)
            walk_texpr(value, v)
        TBufLit(elems, _) -> walk_all(elems, v)
        TBufFill(value, count, _) ->
            walk_texpr(value, v)
            walk_texpr(count, v)
        TIndex(receiver, index, _) ->
            walk_texpr(receiver, v)
            walk_texpr(index, v)
        TLen(receiver, _) -> walk_texpr(receiver, v)
        TBytes(receiver) -> walk_texpr(receiver, v)
        TSlice(base, lo, hi, _, _) ->
            walk_texpr(base, v)
            walk_opt(lo, v)
            walk_opt(hi, v)
        TCast(operand, _) -> walk_texpr(operand, v)
        TConstrainedCheck(value, _) -> walk_texpr(value, v)
        TConstrainedValid(value, _) -> walk_texpr(value, v)
        TConstrainedStep(value, _, _, _) -> walk_texpr(value, v)
        TLoad(_, _) -> ()
        TResult(_) -> ()
        TOld(_, _) -> ()
        TGlobal(_, _, _) -> ()
        TDeref(operand, _) -> walk_texpr(operand, v)
        TTypeId(receiver, _) -> walk_texpr(receiver, v)
        TAddrOf(place, _) -> walk_texpr(place, v)
        TTempAddr(value, _) -> walk_texpr(value, v)
        TStore(place, value, _) ->
            walk_texpr(place, v)
            walk_texpr(value, v)
        TUpdate(place, _, value, _, _, _) ->
            walk_texpr(place, v)
            walk_texpr(value, v)
        TIncDec(place, _, _, _, _) -> walk_texpr(place, v)
        TBinary(_, left, right, _) ->
            walk_texpr(left, v)
            walk_texpr(right, v)
        TUnary(_, operand, _) -> walk_texpr(operand, v)
        TIntOp(_, operand, amount, _, _) ->
            walk_texpr(operand, v)
            walk_opt(amount, v)
        TAtomic(_, addr, ops, _, _, _) ->
            walk_texpr(addr, v)
            walk_all(ops, v)
        TFence(_) -> ()
        TLogical(_, left, right) ->
            walk_texpr(left, v)
            walk_texpr(right, v)
        TCompare(operands, _) -> walk_all(operands, v)
        TSeq(exprs) -> walk_all(exprs, v)
        TStr(arg) -> walk_texpr(arg, v)
        TFromBytes(arg) -> walk_texpr(arg, v)
        TConstView(arg) -> walk_texpr(arg, v)
        TFormat(arg, _) -> walk_texpr(arg, v)
        TRender(value, _, spec, _) ->
            walk_texpr(value, v)
            walk_texpr(spec, v)
        TCStrLit(_) -> ()
        TCall(_, args, _, _) -> walk_all(args, v)
        TFuncAddr(_, _, _) -> ()
        TCallPtr(callee, args, _, _) ->
            walk_texpr(callee, v)
            walk_all(args, v)
        TErase(operand, _, _) -> walk_texpr(operand, v)
        TVCall(receiver, _, args, _, _) ->
            walk_texpr(receiver, v)
            walk_all(args, v)
        TVaStart(ap) -> walk_texpr(ap, v)
        TVaEnd(ap) -> walk_texpr(ap, v)
        TVaArg(ap, _) -> walk_texpr(ap, v)
        TVaCopy(dst, src) ->
            walk_texpr(dst, v)
            walk_texpr(src, v)
        TVaPass(ap) -> walk_texpr(ap, v)
        TStructNew(_, args) -> walk_all(args, v)
        TStructInvCheck(value, _, _) -> walk_texpr(value, v)
        TRecheck(after, recv, _, _) ->
            walk_texpr(after, v)
            walk_texpr(recv, v)
        TEnumNew(_, _, args) -> walk_all(args, v)
        TEnumFromInt(value, _) -> walk_texpr(value, v)
        TEnumTry(value, _, _, _, _) -> walk_texpr(value, v)
        TEnumAttr(_, _, arg, _) -> walk_texpr(arg, v)
        TTry(operand, _, _, _, _, _, _) -> walk_texpr(operand, v)
        TField(receiver, _, _) -> walk_texpr(receiver, v)
        TIf(cond, then_block, else_block, _) ->
            walk_terms(cond, v)
            walk_block(then_block, v)
            walk_opt_block(else_block, v)
        TMatch(scrutinee, arms, _) ->
            walk_texpr(scrutinee, v)

            for i in 0..<arms.len()
                val arm = arms.at(i)

                for j in 0..<arm.patterns.len()
                    walk_tpattern(arm.patterns.at(j), v)

                walk_opt(arm.guard, v)
                walk_block(arm.body, v)
        TBlockExpr(block) -> walk_block(block, v)
        TWhile(cond, body, else_block, _) ->
            walk_terms(cond, v)
            walk_stmts(body, v)
            walk_opt_block(else_block, v)
        TDoWhile(body, cond, else_block, _) ->
            walk_stmts(body, v)
            walk_texpr(cond, v)
            walk_opt_block(else_block, v)
        TLoop(body, _) -> walk_stmts(body, v)
        TFor(_, _, lo, hi, _, body, else_block, _) ->
            walk_texpr(lo, v)
            walk_texpr(hi, v)
            walk_stmts(body, v)
            walk_opt_block(else_block, v)
        TCFor(init, cond, step, body, else_block, _) ->
            walk_stmts(init, v)
            walk_opt(cond, v)
            walk_stmts(step, v)
            walk_stmts(body, v)
            walk_opt_block(else_block, v)
        TForEach(_, _, seq, body, else_block, _) ->
            walk_texpr(seq, v)
            walk_stmts(body, v)
            walk_opt_block(else_block, v)
        TIterate(_, _, init, next, bind, body, else_block, _) ->
            walk_texpr(init, v)
            walk_texpr(next, v)
            walk_tpattern(bind, v)
            walk_stmts(body, v)
            walk_opt_block(else_block, v)
        TQuantifier(_, _, _, lo, hi, _, pred) ->
            walk_texpr(lo, v)
            walk_texpr(hi, v)
            walk_texpr(pred, v)
        TCheckedLoop(_, _, loop_expr) -> walk_texpr(loop_expr, v)
end walk_texpr
