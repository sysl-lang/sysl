module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.str_builder

// A closure literal, what it captures, and the type it inhabits.
//
// **A closure is a struct and an `impl`, and that is the whole reduction.** The struct's fields are
// the variables the body names from the scope it was written in; the implementation is of the call
// trait for the closure's arity (`Fn2[A, B, R]`, spelled `Fn(A, B) -> R`), and its one member is
// the body with those names reaching the fields instead of the locals. Everything downstream then
// already works: a bound over `Fn(A) -> R` is met by the struct, a trait object is built out of it,
// and a generic parameter written as a bare arrow is solved to it like any other type.
//
// What is genuinely new is only this -- deciding which names a body captures, and binding them
// inside the body so that reading one reaches the field. **Nothing rewrites the body**: a capture
// is bound in the closure's own scope like any other name, with a note saying where it lives, so
// shadowing, assignment and a closure inside a closure are the ordinary cases of rules that already
// hold.

// The name a closure's struct is filed under. It holds the module separator, which no identifier
// and no module name may, so nothing a program can write collides with one.
closure_base(n: usize) -> string = s"${ModuleSep}closure$n"

// The name a **scoped child's** closure is filed under: one written as the argument of a `@scoped`
// parameter that captures a view. Such a view is borrowed from the frame blocked in the scope call
// rather than shared with the child, so it is stored with a null owner and never counted
// (`type_queries.sysl`'s `borrowed_capture`). The difference is in the name because it is a fact
// about the struct, read wherever the struct is -- the share walk, the construction, the ARC walks --
// and none of those is handed anything but the type.
lending_closure_base(n: usize) -> string = closure_base(n) + borrowing_closure_suffix()

// Where an argument was written, as `Analysis.scoped_args` holds it: the file and the two ends.
scoped_arg_key(cx: &Analyzer, span: Span) -> string = s"${cx.scope.src.name}:${span.start}:${span.end}"

// Whether the closure written at `span` with these captures is a scoped child that borrows a view.
private borrows_its_views(cx: &Analyzer, span: Span, fields: Buf[(string, Type)]) -> bool
    if !cx.an.scoped_args.has(scoped_arg_key(cx, span)) then return false

    for item in fields
        item.1 match
            Slice(_, _) -> return true
            _ -> ()

    false
end borrows_its_views

// What a trailing block calls the one value it is passed.
closure_it() -> string = "it"

// Whether a symbol's name **carries** a closure's rather than being one: `$closure4.call` is one,
// and so is `sysl.time$resolve.$closure4`, the instantiation of a bare-arrow parameter made at it.
//
// Both are subject to the same rule: a closure's name is a counter in the compilation that lowered
// it, so two units each lowering a fourth closure produce the same name for two different things.
// Every symbol answering this is therefore emitted `internal` and may not cross a link.
//
// **Segment by segment rather than as a substring**, because the prefix begins with the module
// separator and a module's own declaration called `closure4` is keyed `foo$closure4`. A mangled name
// joins its parts with `.`, and a closure's base is a part in its own right, so a real one always
// starts a segment and that one never does.
mentions_closure(name: string) -> bool
    var at: usize = 0
    val bytes = name.bytes
    val prefix = s"${ModuleSep}closure"
    // A nested function's environment is named by the same kind of counter, so a body filed under
    // it is the same hazard.
    val env = s"${ModuleSep}env"

    while at <= bytes.len
        var end = at

        while end < bytes.len && bytes[end] != u8('.')
            end += 1

        if end - at >= prefix.bytes.len && bytes_at(name, at, prefix) then return true
        if end - at >= env.bytes.len && bytes_at(name, at, env) then return true

        if end >= bytes.len then return false

        at = end + 1

    false
end mentions_closure

// A closure literal, and the closure a trailing block became.
//
// The parameter types come from the context asking for a callable and the result comes from the
// body -- never the other way round, so a closure is analyzed once and what it yields is what it
// yields.
closure_expr(cx: &Analyzer, span: Span, written: Buf[LambdaParam], body: Buf[Stmt],
             implicit: bool, expected: Option[Type]) -> TExpr
    val want = if expected.is_none() then None else callable_signature(cx.an, expected.unwrap())
    val params = if implicit then block_params(span, want) else written

    if want.is_some() && want.unwrap().0.len() != params.len()
        val n = want.unwrap().0.len()

        if implicit then
            cx.fault(span, s"a trailing block binds the one value it is passed as " +
                     s"'${closure_it()}', so it stands at a callable taking one or none — and " +
                     s"what this one is being used as takes $n. Write it as a closure literal, " +
                     s"which names its parameters: '(${letters(n)}) -> …'")
        else
            cx.fault(span, s"this closure takes ${quantity(params.len(), "parameter")}, and what " +
                     s"it is being used as takes $n")
    end if

    // An annotation is read where one is written and the context supplies the rest. A parameter
    // with neither is the one shape a closure cannot be analyzed at all, and it is reported against
    // the parameter rather than against the literal, since that is where the answer would go.
    var ptypes: Buf[Type] = buf()
    var names: Buf[string] = buf()

    for i in 0..<params.len()
        val p = params.at(i)

        names.push(p.name)

        if p.typ.is_some()
            ptypes.push(resolve_type(cx.an, cx.scope, p.typ.unwrap(), cx.subst))
        else if want.is_some() && i < want.unwrap().0.len()
            ptypes.push(want.unwrap().0.at(i))
        // A position whose own type was refused has already said what is wrong, and the closure at
        // it is not a second mistake.
        else if expected.is_some() && expected.unwrap() == Unknown
            ptypes.push(Unknown)
        else
            cx.fault(p.span, missing_parameter_type(p.name))
            ptypes.push(Unknown)

    val result = if want.is_none() then None else want.unwrap().1
    val lowered = lower_closure(cx, span, names, ptypes, result, body)

    *lowered.kind match
        TStructNew(st, _) -> cx.an.closures_written.put(st.base, ClosureWritten(cx.scope, params, ptypes))
        _ -> ()

    lowered
end closure_expr

// What a closure literal wrote for its parameters, and the types they were read at. A closure is
// only ever refused a callable bound because a parameter's written type disagrees with what the
// callee passes there -- an unwritten one takes what the context said, and the result is checked
// against the context as the body is read -- so the parameter is where that refusal belongs.
struct ClosureWritten
    scope: Scope
    params: Buf[LambdaParam]
    ptypes: Buf[Type]

// A bound that a bare-arrow parameter became, refused for what arrived at it.
//
// **The type parameter the sugar added is never named**: a reader wrote `f: (int) -> int` and no
// `$F0`. A closure literal is told at its first written parameter that disagrees with what the
// callee passes there -- the same sentence wherever the call is read, at a generic's definition
// through a bound or at a concrete receiver. Anything else is told what callable was asked for.
call_bound_unmet(a: &Analysis, scope: Scope, span: Span, what: string, tr: Bound, arg: Type,
                 at_definition: bool)
    val parts = fn_parts(tr.name, tr.args)
    val callee = qualified_name(what)

    if parts.is_some()
        val want = parts.unwrap().0
        val written = arg match
            Struct(st) -> a.closures_written.get(st.base)
            _ -> None

        if written.is_some()
            val w = written.unwrap()

            for i in 0..<w.params.len()
                val p = w.params.at(i)

                if p.typ.is_some() && i < want.len() && i < w.ptypes.len() &&
                        !mentions_unknown(want.at(i)) && w.ptypes.at(i) != want.at(i)
                    val message = s"this closure's '${p.name}' is declared ${type_show(w.ptypes.at(i))}, " +
                                  s"but '$callee' passes it ${type_show(want.at(i))}"

                    if at_definition then a.bound_fault(w.scope, p.span, message)
                    else a.fault(w.scope, p.span, message)

                    return
        end if
    end if

    val asked = if parts.is_some() then arrow_shown(parts.unwrap().0, parts.unwrap().1)
    else show_bound(a, tr, arg)

    arg match
        Abstract(n, _) ->
            a.bound_fault(scope, span, s"'$callee' takes a callable $asked here, but '$n' is not " +
                          s"bounded by '${show_bound(a, tr, arg)}'")
        _ ->
            val why = unmet_bound(a, tr, arg)
            val tail = if why.is_some() then s" — ${why.unwrap()}" else ""
            val message = s"'$callee' takes a callable $asked here, but ${type_show(arg)} is not one$tail"

            if at_definition then a.bound_fault(scope, span, message)
            else a.fault(scope, span, message)
end call_bound_unmet

// A callable as the parameter that asked for it was written: `(int, int) -> int`, and `int -> int`
// for one parameter, which is the only way a bare arrow spells that.
private arrow_shown(params: Buf[Type], result: Type) -> string
    var b = str_builder()

    if params.len() == 1
        b.push(type_show(params.at(0)))
    else
        b.push("(")

        for i in 0..<params.len()
            if i > 0 then b.push(", ")

            b.push(type_show(params.at(i)))

        b.push(")")
    end if

    b.push(" -> ")
    b.push(type_show(result))
    b.finish()
end arrow_shown

// -- two closures a refusal names alike ----------------------------------------------------------

// What a mismatch adds where the two types read the same and differ only in a closure: every closure
// literal is a struct of its own, and a reader is shown each one as "a closure", so a refusal saying
// *"is a closure, but a closure was given"* would name nothing that differs. Nothing where the two
// read differently -- the sentence already says what differs.
//
// **Two shapes apart is the difference itself**; two of one shape are apart because each literal is
// its own type, and the boxed callable is what holds either.
closure_mismatch_hint(a: &Analysis, got: Type, wanted: Type) -> string
    if type_show(got) != type_show(wanted) then return ""

    val pair = closures_apart(got, wanted)

    if pair.is_none() then return ""

    val given = closure_shape(a, pair.unwrap().0)
    val asked = closure_shape(a, pair.unwrap().1)

    if given != asked then return s"the closure asked for is '$asked', and the one given is '$given'"

    s"each closure literal is a type of its own, so this one is not the '$asked' the type was made " +
    s"from; to hold either, write the type as '&Fn$asked'"
end closure_mismatch_hint

// The first two closures standing at the same place in two types and not the same closure: the types
// themselves, or a pair inside what both apply or point at.
private closures_apart(got: Type, wanted: Type) -> Option[(Type, Type)]
    if is_closure_literal(got) && is_closure_literal(wanted)
        return if type_eq(got, wanted) then None else Some((got, wanted))

    got match
        Struct(g) -> wanted match
            Struct(w) -> closures_apart_list(g.targs, w.targs)
            _ -> None
        Enum(g) -> wanted match
            Enum(w) -> closures_apart_list(g.targs, w.targs)
            _ -> None
        Ptr(g) -> wanted match
            Ptr(w) -> closures_apart(*g, *w)
            _ -> None
        Ref(g, _) -> wanted match
            Ref(w, _) -> closures_apart(*g, *w)
            _ -> None
        _ -> None
end closures_apart

private closures_apart_list(gs: Buf[Type], ws: Buf[Type]) -> Option[(Type, Type)]
    if gs.len() != ws.len() then return None

    for i in 0..<gs.len()
        val found = closures_apart(gs.at(i), ws.at(i))

        if found.is_some() then return found

    None
end closures_apart_list

// A closure's shape as a callable type spells it -- `(int, int) -> int`, `() -> unit` -- read off the
// `call` its literal was lowered to, whose first parameter is the closure's own environment.
private closure_shape(a: &Analysis, t: Type) -> string
    val base = t match
        Struct(d) -> d.base
        _ -> ""
    val sig = a.tables.members.func_insts.get(s"$base.call")

    if sig.is_none() then return "(…) -> …"

    var b = str_builder()
    val params = sig.unwrap().params

    b.push("(")

    for i in 1..<params.len()
        if i > 1 then b.push(", ")

        b.push(type_show(params.at(i).1))

    b.push(") -> ")
    b.push(type_show(sig.unwrap().ret))
    b.finish()
end closure_shape

// What a parameter with no type of its own and no context is told.
//
// **The type position is an ellipsis and not a `T`.** The place this fires is a call into a generic
// member, whose own signature very likely calls something `T`, so a reader copying the advice would
// write a name that means nothing at the call.
private missing_parameter_type(name: string) -> string
    if is_placeholder(name) then
        return "this '_' has no type here — nothing says what the closure it stands in takes, so " +
               "write that closure with a named parameter: '(x: …) -> …'"

    s"'$name' has no type here — nothing says what this closure takes, so write it: " +
    s"'($name: …) -> …'"
end missing_parameter_type

// The names a diagnostic offers for a parameter list a reader has to write out.
private letters(n: usize) -> string
    var b = str_builder()

    for i in 0..<n
        if i > 0 then b.push(", ")

        b.push(s"${char(u32('a') + u32(i))}")

    b.finish()
end letters

// What a trailing block's closure calls its parameters, which is the arity it stands at and nothing
// the block wrote.
//
// One parameter is `it`. **None is the empty list, and so is anything else** -- a block cannot name
// two, and handing back nothing is what lets the arity check above say so in the sentence a reader
// who wrote no parameters needs.
private block_params(span: Span, want: Option[(Buf[Type], Option[Type])]) -> Buf[LambdaParam]
    var out: Buf[LambdaParam] = buf()

    if want.is_some() && want.unwrap().0.len() == 1 then
        out.push(LambdaParam(span, closure_it(), None))

    out
end block_params

// The signature a type asking for a callable asks for: what it takes, and what it yields where the
// type says so.
//
// The shapes are a bounded type parameter (which is what a bare arrow a parameter wrote became), a
// trait object behind either mode, and the trait itself. A result is `None` where the context
// genuinely does not fix one, which is not the same as fixing it to `unit`.
callable_signature(a: &Analysis, t: Type) -> Option[(Buf[Type], Option[Type])]
    val b = callable_of(a, t)

    if b.is_none() then return None

    val parts = fn_parts(b.unwrap().name, b.unwrap().args)

    if parts.is_none() then return None

    val ret = parts.unwrap().1

    Some((parts.unwrap().0, if ret == Unknown then None else Some(ret)))
end callable_signature

// Whether a closure's asked-for result is a slice whose element nothing has said yet.
private slice_of_something(t: Type) -> bool = t match
    Slice(e, _) -> *e == Unknown
    _ -> false

// Refuses a capture of a `ref`, which is the one construct that would carry one out of its block,
// and answers whether it did.
//
// A `ref` is a **declaration and never a type**, and what that buys is that the compiler still holds
// the place the name stands for, in the body that wrote it. A capture is exactly the thing that
// breaks it: the name would be read from an environment, in a body with no place to walk outward
// through, and an escaping closure would carry the address past the block whose storage it names.
// **It is refused rather than made to work by capturing the place instead**, which would be a second,
// hidden meaning for one word: the path re-walked at whatever its index had become is the
// call-by-name reading a `ref` exists to rule out.
refuse_ref_captures(cx: &Analyzer, span: Span, captured: Buf[string]) -> bool
    for i in 0..<captured.len()
        val local = cx.lookup(captured.at(i))

        if local.is_some() && local.unwrap().stands_for.is_some()
            cx.fault(span, s"'${captured.at(i)}' is a 'ref', which names storage for as long as " +
                     "its own block and no longer — so it cannot be captured, since a closure may " +
                     "outlive that block. Capture the place it names, or read the value into a " +
                     "'val' and capture that")
            return true
        end if

    false
end refuse_ref_captures

// A capture is a copy, so a local whose type is `@pinned` cannot be captured: the closure would carry
// a second value of it, which nothing C holds a pointer into. A pointer to it can be.
private refuse_pinned_captures(cx: &Analyzer, span: Span, captured: Buf[string]) -> bool
    for i in 0..<captured.len()
        val local = cx.lookup(captured.at(i))

        if local.is_some() && pinned_type(cx.an, local.unwrap().ty)
            val held = type_show(local.unwrap().ty)

            cx.fault(span, pinned_refusal(held, s"captures '${captured.at(i)}' by value in a closure",
                                          s"Capture a pointer to it instead ('val p = &${captured.at(i)}')"))
            return true
        end if

    false
end refuse_pinned_captures

// Builds the struct, the implementation and the body of one closure, and yields the struct value
// that *is* the closure -- its captures, in the order the fields hold them. `named` is the function a
// program passed where the closure stands for one, and empty for a closure literal.
lower_closure(cx: &Analyzer, span: Span, names: Buf[string], ptypes: Buf[Type],
              result: Option[Type], body: Buf[Stmt], named: string = "") -> TExpr
    val captured = captures(cx, body, names)

    if refuse_ref_captures(cx, span, captured) then return bad_expr(span)
    if refuse_pinned_captures(cx, span, captured) then return bad_expr(span)

    var fields: Buf[(string, Type)] = buf()

    for item in captured
        fields.push((item, cx.lookup(item).unwrap().ty))

    val lends = borrows_its_views(cx, span, fields)
    val base = if lends then lending_closure_base(cx.an.closure_count) else closure_base(cx.an.closure_count)

    cx.an.closure_count += 1

    // **A scoped child holds its captures by value** whatever else is true of it, so it is no
    // candidate; any other closure may hold each `var` it captures by reference, decided once every
    // body has been typed (`closure_mode.sysl`).
    if !lends && !captured.is_empty() then cx.an.closure_refs.put(base, referable_captures(cx, captured))

    val st = StructType(base, buf(), fields, false, None, None, false, None, buf(), false, buf())

    cx.an.tables.struct_insts.put(base, Struct(st))

    val fname = s"$base.call"
    val lowered = closure_body(cx, span, st, fname, names, ptypes, result, captured, body, named)

    cx.an.tables.members.func_insts.put(fname, FuncSig(lowered.params, lowered.ret_ty))
    cx.an.closure_funcs.push(lowered)

    // **A reading thrown away rewinds the counter**, so the name may already be on the list from a
    // body that is gone; the entry is the answer about THIS body or nothing.
    note_env_writes(cx.an, st, captured.len(), lowered.body)

    register_call_trait(cx, span, st, ptypes, lowered.ret_ty)

    // Every capture is read where the closure is **formed**, so a value is copied in and a `&T`
    // takes a share -- which is what the ordinary field-by-field construction of a struct already
    // does, and the reason capture needed no rule of its own.
    var args: Buf[TExpr] = buf()

    for item in captured
        args.push(capture_source(cx, span, item))

    // Asked after the captures are read, so the closure's own reading of a name is not a read
    // "after" it.
    refuse_lost_writes(cx, span, st, captured, lowered.body)

    TExpr(span, TStructNew(st, args))
end lower_closure

// Which captures a closure may hold by reference: a binding a write may reach -- not a `val`, a
// pattern's binding or a by-name parameter -- of a type that has storage. A `val` is copied whatever
// the closure's mode, since nothing can tell a copy of it from the variable; a value with no storage
// has no address to hold, and changing its field to one would move every field after it.
private referable_captures(cx: &Analyzer, captured: Buf[string]) -> Buf[bool]
    var out: Buf[bool] = buf()

    for item in captured
        val local = cx.lookup(item).unwrap()

        out.push(!local.read_only && local.stands_for.is_none() &&!reads_by_name(cx, item) &&
                 !holds_waker(cx, item) && !zero_sized(local.ty))
    end for

    out
end referable_captures

// -- a write that reaches only the closure's copy ------------------------------------------------

// **A closure that escapes captures by value** (`closure_mode.sysl`), **so a write to a capture
// reaches the closure's own copy** -- which
// is a counter the closure keeps between its calls when the closure reads it back, and a write that
// is lost when nothing does. Two shapes are refused, both at the write:
//
// - **the closure never reads the copy back**: every mention of the capture in the body is the
//   place of a write (`hit = true`, `count += 1`), so no call of the closure, now or later, can
//   observe what was written;
// - **the enclosing body reads the variable after the closure is written**: the program reads it
//   as though the closure's write had reached it, which it never does.
//
// A closure that writes its copy and reads it back (`n += 1; n`), with the variable outside left
// alone, keeps its state between calls, and that is what a closure in a `var` is for.
//
// A write counts when its place is the capture itself or a part of it held by value -- a field of
// a captured struct, an element of a captured array. A write through what a capture refers to (a
// `&T`, a `*T`, a slice's element, a `Buf`) reaches storage the closure shares, and is not one.
//
// **A `*self` method called on such a place is a write of the same kind** (`c.bump()`,
// `xs[0].bump()`): the method is handed the copy's address to write through. A `(self)` or `&self`
// call reads. One whose result is a value hands back what it read of the copy (`it.next()`), so it
// is a read as well as a write; one answering nothing or an address into the copy is only a write.
private refuse_lost_writes(cx: &Analyzer, span: Span, st: &StructType, captured: Buf[string],
                           body: TBlock)
    if captured.is_empty() then return

    val scan = scan_copy_writes(cx.an, st, captured.len(), body, span)

    for i in 0..<captured.len()
        if scan.writes.at(i) == 0 then continue

        val name = captured.at(i)
        val outer = cx.lookup(name)
        val shown = if outer.is_some() then type_show(outer.unwrap().ty) else "T"
        val via = if scan.direct.at(i) == 0 then scan.via.at(i) else ""

        if scan.uses.at(i) == scan.writes.at(i)
            lost_write_owed(cx, scan.at.at(i), name, scan.form.at(i), shown,
                            "and nothing in the closure reads it back", st.base, i, via,
                            scan.via_capture.at(i))
            continue
        end if

        if outer.is_some()
            cx.copy_writes.push(CopyWrite(outer.unwrap().unique, name, span, scan.at.at(i),
                                          scan.form.at(i), shown, st.base, i, via, scan.via_capture.at(i)))
    end for
end refuse_lost_writes

// **A lost write is owed, not said**: it is lost only if the closure holds that capture by value,
// which is known once every body has been typed (`closure_mode.sysl` says the ones still owed, with
// what keeps the closure). A trial thrown away takes back what it owed, as it takes back what it said.
//
// The refusal is in the words the pattern binding's is said in: what was copied, where the write
// lands instead, and the two ways to say what was meant.
private lost_write_owed(cx: &Analyzer, at: Span, name: string, form: string, shown: string, why: string,
                        base: string, capture: usize, via: string, via_capture: usize) =
    cx.an.lost_writes.push(OwedWrite(cx.scope, at, "this closure captures by value", ", since ",
        s", so it holds a copy of '$name' — so $form would reach that copy rather than the variable it " +
        s"came from, $why. Where you mean to change '$name', hold it as a '&$shown' and write through " +
        "it, or have the closure return the value", base, capture, via, via_capture))

// A binding a closure wrote its copy of, kept until the enclosing body reads the binding again.
struct CopyWrite
    unique: string
    name: string
    closure: Span
    write: Span
    form: string
    shown: string
    base: string
    capture: usize
    via: string
    via_capture: usize
end CopyWrite

// **A read of a binding after a closure wrote its own copy of it** is a program expecting the write
// to have reached it: refused once, at the write, where the closure holds that capture by value. The
// closure's own reading of the name, when it is formed, lies inside the closure and is not "after" it.
read_after_copy_write(cx: &Analyzer, span: Span, unique: string)
    if cx.copy_writes.is_empty() then return

    for i in 0..<cx.copy_writes.len()
        val w = cx.copy_writes.at(i)

        if w.unique != unique then continue
        if span.start >= w.closure.start && span.end <= w.closure.end then continue

        lost_write_owed(cx, w.write, w.name, w.form, w.shown,
                        "and the variable is used afterwards as though it had", w.base, w.capture, w.via,
                        w.via_capture)
        cx.copy_writes.remove(i)
        return
    end for
end read_after_copy_write

// **A closure written inside another writes a copy of the outer closure's capture**, and that capture
// is itself a copy of the enclosing body's variable. Nothing in the outer closure read it after the
// inner one, so the record is handed to the enclosing body as a write of ITS variable: a read there
// after the outer closure is a program expecting the write to have reached it, refused as it is for
// a closure written directly in that body. A record of the outer closure's own local stays behind.
private hand_up_copy_writes(cx: &Analyzer, inner: &Analyzer, span: Span, captured: Buf[string])
    if inner.copy_writes.is_empty() then return

    for w in inner.copy_writes
        for i in 0..<inner.captured.len()
            if inner.captured.at(i).0 != w.unique then continue

            val outer = cx.lookup(captured.at(i))

            if outer.is_some()
                cx.copy_writes.push(CopyWrite(outer.unwrap().unique, w.name, span, w.write, w.form,
                                              w.shown, w.base, w.capture))
        end for
    end for
end hand_up_copy_writes

// What one closure body does with each capture: how often it names it, how many of those are the
// place of a write to the closure's copy, and the first such write and its form.
//
// **A closure written inside this one writes this one's copy where it holds the capture by
// reference** (`() -> { val g = () -> n += 1; g() }`): its write is this closure's, but only if it
// turns out to hold its own capture by reference, which is not known until every body is typed. So
// such a write is counted with the inner closure it depends on (`via`, `via_capture`), and `direct`
// counts the writes this body makes itself: a refusal owed for writes that all come through an inner
// closure is said only where that closure holds the capture by reference.
private struct CopyScan
    slots: Buf[int]
    uses: Buf[int]
    writes: Buf[int]
    direct: Buf[int]
    at: Buf[Span]
    form: Buf[string]
    via: Buf[string]
    via_capture: Buf[usize]
end CopyScan

private scan_copy_writes(a: &Analysis, st: &StructType, n: usize, body: TBlock, span: Span) -> &CopyScan
    val scan: &CopyScan = CopyScan(buf(), buf(), buf(), buf(), buf(), buf(), buf(), buf())

    for i in 0..<n
        scan.slots.push(int(st.slot(i)))
        scan.uses.push(0)
        scan.writes.push(0)
        scan.direct.push(0)
        scan.at.push(span)
        scan.form.push("")
        scan.via.push("")
        scan.via_capture.push(0)
    end for

    // `a, b = b, a` is the one write that is not an expression: each of its places is a write of
    // its own, said as the assignment it is.
    walk_block_stmts(body, TWalk(true, e -> note_copy_use(a, scan, e),
                                 w -> note_copy_write(scan, w.place, "assignment", w.place.span), s -> ()))
    scan
end scan_copy_writes

// One node of the body: a mention of a capture, a write, or neither.
private note_copy_use(a: &Analysis, scan: &CopyScan, e: TExpr)
    *e.kind match
        TField(recv, slot, _) -> if env_root(recv) then bump_at(scan.uses, scan.slots, slot)
        TStore(place, _, _, _) -> note_copy_write(scan, place, "assignment", e.span)
        TUpdate(place, op, _, _, _, _, _) -> note_copy_write(scan, place, s"'$op'", e.span)
        TIncDec(place, op, _, _, _) -> note_copy_write(scan, place, s"'$op'", e.span)
        TVecStore(recv, _, _) -> note_copy_write(scan, recv, "assignment", e.span)
        TCall(name, _, ty, _) ->
            val place = self_receiver(a, e)

            if place.is_some() && note_copy_write(scan, place.unwrap(), self_call_form(a, name), e.span)
                // The answer is what the method read of the copy, so the copy is read back.
                if answers_a_value(ty) then
                    bump_at(scan.uses, scan.slots, copy_root(place.unwrap()).unwrap())
            end if
        TStructNew(st, args) -> if is_closure_literal(Struct(st)) then note_inner_writes(a, scan, st, args)
        _ -> ()

// **A closure built here from this closure's captures**: each capture it is handed that it writes is
// a write of this closure's copy where it holds that capture by reference, and one it also reads is
// read back. Its construction already counted as a use of what it is handed.
private note_inner_writes(a: &Analysis, scan: &CopyScan, st: &StructType, args: Buf[TExpr])
    val inner = lowered_closure(a, s"${st.base}.call")

    if inner.is_none() then return

    val seen = scan_copy_writes(a, st, args.len(), inner.unwrap().body, inner.unwrap().span)

    for j in 0..<args.len()
        if seen.writes.at(j) == 0 then continue

        val slot = copy_root(args.at(j))

        if slot.is_none() then continue

        for i in 0..<scan.slots.len()
            if scan.slots.at(i) != slot.unwrap() then continue

            if scan.writes.at(i) == 0
                scan.at.set(i, seen.at.at(j))
                scan.form.set(i, seen.form.at(j))
                scan.via.set(i, st.base)
                scan.via_capture.set(i, j)
            end if

            scan.writes.set(i, scan.writes.at(i) + 1)

            if seen.uses.at(j) > seen.writes.at(j) then scan.uses.set(i, scan.uses.at(i) + 1)
        end for
    end for
end note_inner_writes

// The body a closure literal was lowered to, by its function's name: the last reading of it.
private lowered_closure(a: &Analysis, fname: string) -> Option[TFunc]
    var i = a.closure_funcs.len()

    while i > 0
        i -= 1

        if a.closure_funcs.at(i).name == fname then return Some(a.closure_funcs.at(i))
    end while

    None
end lowered_closure

// Whether the write landed on a capture's copy.
private note_copy_write(scan: &CopyScan, place: TExpr, form: string, at: Span) -> bool
    val slot = copy_root(place)

    if slot.is_none() then return false

    for i in 0..<scan.slots.len()
        if scan.slots.at(i) != slot.unwrap() then continue

        if scan.direct.at(i) == 0
            scan.at.set(i, at)
            scan.form.set(i, form)
            scan.via.set(i, "")
        end if

        scan.writes.set(i, scan.writes.at(i) + 1)
        scan.direct.set(i, scan.direct.at(i) + 1)
        return true
    end for

    false
end note_copy_write

// **The place a `*self` call writes through**, when the call is one: its receiver is an address the
// call itself took (`build_receiver` gives it the call's own span, where a written `&x` has its own),
// of something that is not a closure only reading its captures -- calling one of those writes
// nothing, which is why a `val` may hold it.
private self_receiver(a: &Analysis, e: TExpr) -> Option[TExpr] = *e.kind match
    TCall(_, args, _, _) ->
        if args.is_empty() then return None

        val recv = args.at(0)

        if recv.span.start != e.span.start || recv.span.end != e.span.end then return None

        *recv.kind match
            TAddrOf(place, _) -> texpr_type(place) match
                Struct(st) -> if a.read_only_closures.has(st.base) then None else Some(place)
                _ -> Some(place)
            _ -> None
    _ -> None

// A result that carries what the method read: anything but nothing, or an address back into the copy.
private answers_a_value(t: Type) -> bool = t match
    Unit -> false
    Ptr(_) -> false
    Slice(_, _) -> false
    _ -> true

// How the refusal names a `*self` call: by the member a lowered name was filed under, as the program
// wrote it (`C.bump` is `bump`, an instantiation is read as the declaration it came from), and a
// setter's as the assignment the program wrote.
private self_call_form(a: &Analysis, name: string) -> string
    val stem = a.tables.members.func_origin.get(name).unwrap_or(name)
    val word = stem.last_index_of(".") match
        Some(i) -> stem[i + 1..<stem.bytes.len]
        None -> stem

    if is_setter_name(word) then "assignment" else s"'$word', which takes '*self',"
end self_call_form

private bump_at(counts: Buf[int], slots: Buf[int], slot: int)
    for i in 0..<slots.len()
        if slots.at(i) == slot then counts.set(i, counts.at(i) + 1)

// The capture a place writes the closure's own copy of: the capture itself, or a field or an
// element of it reached without passing through anything that refers elsewhere.
private copy_root(place: TExpr) -> Option[int] = *place.kind match
    TField(recv, slot, _) ->
        if env_root(recv) then Some(slot)
        else if held_by_value(texpr_type(recv)) then copy_root(recv)
        else None
    TIndex(recv, _, _) -> texpr_type(recv) match
        Array(_, _) -> copy_root(recv)
        _ -> None
    _ -> None

private held_by_value(t: Type) -> bool = t match
    Struct(_) -> true
    Array(_, _) -> true
    Vector(_, _) -> true
    _ -> false

// The closure's environment: `*self`, where every capture is a field.
private env_root(recv: TExpr) -> bool = *recv.kind match
    TDeref(inner, _) -> *inner.kind match
        TLoad(name, _) -> name == "self"
        _ -> false
    _ -> false


// **Which captures a closure's body writes its own copy of**, by position: a store, a compound
// assignment, an increment or a lane store whose place is a capture or a part of it held by value,
// and a `*self` method called on one (`c.bump()`). **Asked of the typed tree**, since a write is a
// node and these are all of them. A closure written inside this one is a body of its own with its own
// `self`, reached here only as the struct that builds it, so its writes are its own.
//
// A write through what a capture refers to -- a `&T`, a `*T`, a slice's element -- writes storage the
// closure shares rather than its environment, so a closure doing only that is one a `val` may hold.
//
// **None means the closure writes nothing of its own**, and a call of it only reads
// (`Analysis.read_only_closures`). Any other answer is kept (`Analysis.closure_env_writes`): held by
// reference, those captures are written through the closure rather than in it, and a `val` may hold
// it once that is known (`place.sysl`'s `refuse_written_once_receiver`).
private note_env_writes(a: &Analysis, st: &StructType, n: usize, body: TBlock)
    var at: Buf[usize] = buf()
    var slots: Buf[int] = buf()

    for i in 0..<n
        slots.push(int(st.slot(i)))

    val seen = &at

    // `a, b = b, a` writes its places as a statement rather than as expressions.
    walk_block_stmts(body, TWalk(true, e -> env_roots_at(a, seen, slots, e),
                                 w -> env_root_of(seen, slots, w.place), s -> ()))

    if at.is_empty()
        a.read_only_closures.add(st.base)
        a.closure_env_writes.remove(st.base)
    else
        a.read_only_closures.remove(st.base)
        a.closure_env_writes.put(st.base, at)
    end if
end note_env_writes

private env_roots_at(a: &Analysis, seen: *Buf[usize], slots: Buf[int], e: TExpr)
    *e.kind match
        TStore(place, _, _, _) -> env_root_of(seen, slots, place)
        TUpdate(place, _, _, _, _, _, _) -> env_root_of(seen, slots, place)
        TIncDec(place, _, _, _, _) -> env_root_of(seen, slots, place)
        TVecStore(recv, _, _) -> env_root_of(seen, slots, recv)
        TCall(_, _, _, _) -> self_receiver(a, e) match
            Some(place) -> env_root_of(seen, slots, place)
            None -> ()
        _ -> ()
end env_roots_at

private env_root_of(seen: *Buf[usize], slots: Buf[int], place: TExpr)
    val slot = env_capture(place)

    if slot.is_none() then return

    for i in 0..<slots.len()
        if slots.at(i) == slot.unwrap() && !holds_index(*seen, i) then seen.push(i)
end env_root_of

// The capture a place writes the closure's own storage of: the capture itself, a field or an element
// of it held by value, or an element of a slice taken of a captured array.
private env_capture(place: TExpr) -> Option[int] = *place.kind match
    TSlice(base, _, _, _, _) -> texpr_type(base) match
        Array(_, _) -> env_capture(base)
        _ -> None
    TIndex(recv, _, _) -> texpr_type(recv) match
        Slice(_, _) -> *recv.kind match
            TSlice(_, _, _, _, _) -> env_capture(recv)
            _ -> None
        _ -> copy_root(place)
    _ -> copy_root(place)

private holds_index(xs: Buf[usize], i: usize) -> bool
    for x in xs
        if x == i then return true

    false
end holds_index

// The body itself, read in a frame of its own.
//
// **A closure's body is written in the middle of its enclosing function and analyzed there**,
// because that is where the names it captures are still in scope. But a body is analyzed against
// per-function state -- the scope stack, the unique names, the declared result, the loops a `break`
// may name -- and every one of those belongs to the function being interrupted, so the body gets an
// analyzer of its own. What it keeps from around it is what a reader would expect to keep: the
// file's terms, what a type parameter stands for, and the name `__FUNCTION__` answers with, since a
// closure has no name a reader wrote.
private closure_body(cx: &Analyzer, span: Span, st: &StructType, fname: string,
                     names: Buf[string], ptypes: Buf[Type], result: Option[Type],
                     captured: Buf[string], body: Buf[Stmt], named: string) -> TFunc
    val inner = analyzer_for(cx.an, cx.scope)

    inner.subst = cx.subst
    inner.at_definition = cx.at_definition
    inner.func_name = cx.func_name
    inner.decl_name = cx.decl_name
    inner.body_called = Some("")
    inner.bind_site = Some(span)
    note_body_covers(cx.an, fname)

    // A diagnostic naming the closure says which body it was written in.
    cx.an.tables.closure_homes.put(fname, if in_entry_body(cx) then "" else body_path(cx.an.tables, cx.body))

    inner.body = fname
    inner.owner = nested_owner(cx)
    inner.var_fix_log = cx.var_fix_log

    val self_ty = Ptr(Struct(st))

    var params: Buf[(string, Type)] = buf()

    // The receiver comes first, so the closure's own environment is the argument every call already
    // passes and the parameters after it are the ones a program wrote.
    params.push((inner.bind("self", self_ty), self_ty))

    for i in 0..<names.len()
        val unique = inner.bind(names.at(i), ptypes.at(i))

        params.push((unique, ptypes.at(i)))

        // The registrar a `park` was handed takes the task's waker as its one parameter.
        if cx.reading_registrar && names.len() == 1 && type_eq(ptypes.at(i), waker_type(cx))
            inner.wakers.push(unique)

    for i in 0..<captured.len()
        val stored = st.fields.at(i).1
        val read = TExpr(span, TField(TExpr(span, TDeref(TExpr(span, TLoad("self", self_ty)),
                                                         Struct(st))), int(st.slot(i)), stored))

        val unique = inner.bind(captured.at(i), stored)
        val outer = cx.lookup(captured.at(i))

        // A capture of a binding whose type its first use fixes is that binding, for the use.
        if outer.is_some() then carry_open(cx, inner, outer.unwrap().unique, unique)

        // A by-name parameter captured is still one: the field holds the callable, and a read of
        // the name calls it.
        if reads_by_name(cx, captured.at(i)) then inner.by_name.push(unique)

        // So is a waker: captured, it is still the executor's.
        if holds_waker(cx, captured.at(i)) then inner.wakers.push(unique)

        inner.captured.push((unique, read))

    // A closure is a body of its own, so the nested functions of the body it was written in are
    // names it may not reach -- and it is told so rather than told they stand for nothing.
    carry_outer_nested(cx, inner, no_siblings())
    carry_declares(cx, inner)

    inner.ret_ty = Some(result.unwrap_or(Unknown))
    inner.await_site = closure_await_site(cx.await_site)

    val split = contract_length(body)
    val contract = analyze_contract(inner, span, body, split, result.unwrap_or(Unit), false)
    val rest = statements_from(body, split)

    // **What the call's parameter fixes of the result is handed to the value the body gives**, as it
    // is to an argument: `() -> Ok(1)` at `f: &Fn() -> Result[T, E]` is a `Result[int, E]`.
    if cx.yield_seed.is_some() && !rest.is_empty()
        *rest.at(rest.len() - 1).kind match
            ExprStmt(last) ->
                val seed = cx.yield_seed.unwrap()

                inner.variant_seed = Some(VariantSeed(anchor_of(last), seed.key, seed.known))
            _ -> ()

    // A closure whose result the context did not fix is analyzed with nothing expected, so what its
    // body yields is what it yields -- the only reading under which `x -> x * 2` has a result at
    // all.
    val was = inner.unit_tail

    inner.unit_tail = result.is_none()

    val block = if result.is_some() && result.unwrap() == Unit then
        type_value_block(inner, rest, None, true)
    else type_value_block(inner, rest, result, false)

    inner.unit_tail = was

    check_consumes(inner, block)
    check_counted_pointers(inner, block)
    hand_up_copy_writes(cx, inner, span, captured)

    var ret = Unit

    // **A result asked for as "a slice of something" is told of what by the body** -- the reading
    // a generic call makes of `n -> if c then [n] else [n, n, n]` at `f: T -> []U` before `U` is
    // settled, where the branches meet only at the slice.
    val open = result.is_some() && slice_of_something(result.unwrap())

    if open && block.result.is_some() then ret = block.ty
    else if result.is_some() then ret = result.unwrap()
    else if block.result.is_some() then ret = block.ty

    if result.is_some() && !open && result.unwrap() != Unit && block.result.is_some() &&
       disagree(block.ty, result.unwrap()) then
        inner.fault(span, closure_disagreement(result.unwrap(), block.ty, named))

    // **Internal, always.** Nothing outside this compilation can name a closure, so the symbol has
    // no reason to leave the object file -- and leaving it there is what a per-compilation counter
    // for a name makes unsafe: two units that each lowered a fourth closure both call it
    // `$closure4.call`, and with external linkage the linker is free to resolve one unit's call to
    // the other unit's body.
    cx.an.tables.homes.put(fname, cx.scope)

    TFunc(span, fname, params, ret, block, false, contract.0, contract.1, contract.2, true, None,
          false, contract.3, false, false, None, None, None, None, no_marks(), inner.owner, false,
          Some(cx.scope.src), false)
end closure_body

// A body yielding something other than the result its closure -- or nested function -- promised,
// in the reference's words. It is said where the closure was written, not at the body's last line.
// A named function passed as a callable is a closure only underneath, so it is called what the
// program wrote: a function, by its name, whose result -- not a body anyone sees -- is the mismatch.
closure_disagreement(want: Type, got: Type, named: string = "") -> string =
    if named != "" then s"the function '$named' should yield ${type_show(want)} here, but it yields ${type_show(got)}"
    else s"this closure should yield ${type_show(want)}, but its body yields ${type_show(got)}"

// Who declared a body written inside another: whatever declared the body it is written in, or --
// outside any body, in a module `val`'s initializer -- the module being read.
nested_owner(cx: &Analyzer) -> string = if cx.owner != "" then cx.owner else cx.scope.module_name

// Files the closure's struct as an implementation of the call trait for its arity, so a bound over
// `Fn(A) -> R` is met by it and a `&Fn(A) -> R` may be built out of it.
//
// The block is synthetic and there is no source `impl` behind it, which is exactly right: a closure
// implements the call trait by being one, and nothing about the block is a promise a program made
// and could have made differently.
private register_call_trait(cx: &Analyzer, span: Span, st: &StructType, ptypes: Buf[Type],
                            ret: Type)
    val key = catalog_key(cx.an, fn_base(ptypes.len()))

    if key.is_none()
        cx.fault(span, s"a callable of ${quantity(ptypes.len(), "parameter")} has no call trait")
        return
    end if

    var args: Buf[Type] = buf()

    for ptype in ptypes
        args.push(ptype)

    args.push(ret)

    val subject = TypeRef(span, NamedType(st.base, buf()))
    val block = ImplDecl(key.unwrap(), subject, buf(), buf(), buf(), buf(), buf(), false, buf(),
                         buf(), buf(), false)
    var rows: Buf[TraitImpl] = buf()

    // A closure's call trait declares no associated type, and could not: the shape is synthesized
    // here rather than written, so there is nothing for an implementation to have chosen.
    rows.push(TraitImpl(block, span, cx.scope, args, plain_bound(key.unwrap(), args).key(), "", buf(),
                        false, buf(), buf()))
    cx.an.tables.members.impls.put(impl_key_of(key.unwrap(), st.base), rows)

    // The member is registered as the ordinary method it is, so calling a closure is a method call
    // and needs no path of its own -- its parameters are the signature `func_insts` already holds,
    // so what is recorded here is the shape a call reads: a method, taking its receiver by address.
    var mparams: Buf[Param] = buf()

    for i in 0..<ptypes.len()
        mparams.push(Param(span, s"a$i", TypeRef(span, NamedType("", buf())), Public, None, false, false))

    cx.an.tables.members.decls.put(member_key_of(st.base, "call"),
                                   MethodDecl(span, "call", Some(ByPtr), false, buf(), mparams,
                                              None, buf(), buf(), buf(), Public, false, false,
                                              buf(), buf(), buf(), None, None, false, no_marks(),
                                              span, false))
    cx.an.tables.members.funcs.put(member_key_of(st.base, "call"), s"${st.base}.call")
end register_call_trait

// `xs.map(square)` -- a declared function where a callable is wanted.
//
// **A named function is the capture-free closure**, so it is one: the same struct with no fields,
// whose `call` is a call to the function. There is no function-pointer type beside the call trait
// and no wrapper for a program to write, and the degenerate case costs nothing at run time -- an
// empty environment is an empty struct.
function_as_callable(cx: &Analyzer, span: Span, written: string, ptypes: Buf[Type],
                     result: Option[Type]) -> TExpr
    // The parameters are named where no program can name them, so nothing the function's own body
    // reaches is shadowed by one of them.
    var names: Buf[string] = buf()
    var args: Buf[Expr] = buf()

    for i in 0..<ptypes.len()
        val n = s"${ModuleSep}a$i"

        names.push(n)
        args.push(expr(span, Ident(n)))

    var body: Buf[Stmt] = buf()

    body.push(stmt(span, ExprStmt(expr(span, Call(expr(span, Ident(written)), args)))))
    lower_closure(cx, span, names, ptypes, result, body, written)
end function_as_callable

// -- what a body reads from around it ------------------------------------------------------------

// The names a body reads from the scope it was written in, in the order it first reads them.
//
// This is a walk over what was **written** rather than over what it resolved to, which is what lets
// it run before the body is analyzed -- and it has to, since the body cannot be analyzed until the
// type holding its captures exists. A name is a capture when the enclosing scope has one and the
// body did not declare it: a parameter, a local or a loop variable of the body's own shadows the
// outer name exactly as it would anywhere else, and a name that resolves to a declaration rather
// than to a local is reached the way any other function reaches it.
captures_where(keep: &Fn(string) -> bool, body: Buf[Stmt], bound: Buf[string]) -> Buf[string]
    var found: Buf[string] = buf()

    read_block(keep, body, bound, &found)
    found
end captures_where

// The same, for a closure: what counts is a name the enclosing scope has something under.
private captures(cx: &Analyzer, body: Buf[Stmt], bound: Buf[string]) -> Buf[string] =
    captures_where(n -> cx.lookup(n).is_some(), body, bound)

// A block is its own scope, so what it declares is gone at its end and nothing after it sees one.
//
// A binding is in scope for what comes **after** it, so the shadow starts at the declaration and
// the initializer is still read outside it -- `var n = n` captures the outer `n`.
private read_block(keep: &Fn(string) -> bool, stmts: Buf[Stmt], bound: Buf[string], found: *Buf[string])
    var here = copied(bound)

    for item in stmts
        read_stmt(keep, item, &here, found)
end read_block

private read_stmt(keep: &Fn(string) -> bool, s: Stmt, bound: *Buf[string], found: *Buf[string])
    *s.kind match
        ExprStmt(e) -> read_expr(keep, e, *bound, found)
        VarDecl(name, _, init, _, _, _, _, _) ->
            read_opt(keep, init, *bound, found)
            bound.push(name)
        ValDecl(name, _, value, _, _, _, _, _) ->
            read_expr(keep, value, *bound, found)
            bound.push(name)
        ConstDecl(name, _, value, _) ->
            read_expr(keep, value, *bound, found)
            bound.push(name)
        RefDecl(name, place) ->
            read_expr(keep, place, *bound, found)
            bound.push(name)
        MultiAssign(_, targets, values) ->
            read_each(keep, targets, *bound, found)
            read_each(keep, values, *bound, found)
        MultiDecl(names, _, values, _) ->
            read_each(keep, values, *bound, found)

            for item in names
                bound.push(item)
        PatternDecl(pat, _, value, _, _) ->
            read_expr(keep, value, *bound, found)
            pattern_binds_into(pat, bound)
        Return(value) -> read_opt(keep, value, *bound, found)
        Become(call) -> read_expr(keep, call, *bound, found)
        Break(_, value) -> read_opt(keep, value, *bound, found)
        // An `errdefer`'s binder is a name of the deferred statement's own, so a read of it there
        // captures nothing.
        Defer(inner, when) -> when match
            FailureExit(Some(name)) ->
                var here = copied(*bound)

                here.push(name)
                read_stmt(keep, inner, &here, found)
            _ -> read_stmt(keep, inner, bound, found)
        StaticDecl(inner) -> read_stmt(keep, inner, bound, found)
        CopiedDecl(_, inner) -> read_stmt(keep, inner, bound, found)
        Require(cond, _) -> read_expr(keep, cond, *bound, found)
        Ensure(cond, _) -> read_expr(keep, cond, *bound, found)
        Invariant(cond, _) -> read_expr(keep, cond, *bound, found)
        Variant(measure) -> read_expr(keep, measure, *bound, found)
        AssertDecl(cond, message) ->
            read_expr(keep, cond, *bound, found)

            if message.is_some() then read_expr(keep, message.unwrap(), *bound, found)
        // A function nested in the body is a closure by another spelling, so what it reads from
        // around it is read here too -- and its own parameters shadow, exactly as a closure's do.
        FuncDecl(d) ->
            var inner = copied(*bound)

            for param in d.params
                inner.push(param.name)

            read_block(keep, d.body, inner, found)
            bound.push(d.name)
        _ -> ()
end read_stmt

private read_each(keep: &Fn(string) -> bool, es: Buf[Expr], bound: Buf[string], found: *Buf[string])
    for item in es
        read_expr(keep, item, bound, found)

private read_opt(keep: &Fn(string) -> bool, e: Option[Expr], bound: Buf[string], found: *Buf[string])
    e match
        Some(v) -> read_expr(keep, v, bound, found)
        None -> ()

private read_opt_block(keep: &Fn(string) -> bool, ss: Option[Buf[Stmt]], bound: Buf[string],
                       found: *Buf[string])
    ss match
        Some(b) -> read_block(keep, b, bound, found)
        None -> ()

// A name is a capture where the body did not bind it and the scope around the closure has one.
private read_expr(keep: &Fn(string) -> bool, e: Expr, bound: Buf[string], found: *Buf[string])
    *e.kind match
        Ident(n) ->
            if !names_hold(bound, n) && keep(n) && !names_hold(*found, n) then
                found.push(n)
        // A closure inside this one captures from further out through this one, so what it reads is
        // read here too -- which is what makes capture reach through a nesting.
        Lambda(ps, b, _) ->
            var inner = copied(bound)

            for item in ps
                inner.push(item.name)

            read_block(keep, b, inner, found)
        BlockArg(b) ->
            var inner = copied(bound)

            inner.push(closure_it())
            read_block(keep, b, inner, found)
        Unary(_, operand) -> read_expr(keep, operand, bound, found)
        PreIncDec(_, operand) -> read_expr(keep, operand, bound, found)
        PostIncDec(_, operand) -> read_expr(keep, operand, bound, found)
        Binary(_, left, right) ->
            read_expr(keep, left, bound, found)
            read_expr(keep, right, bound, found)
        Compare(operands, _) -> read_each(keep, operands, bound, found)
        RangeExpr(lo, hi, _) ->
            read_opt(keep, lo, bound, found)
            read_opt(keep, hi, bound, found)
        Assign(_, target, value) ->
            read_expr(keep, target, bound, found)
            read_expr(keep, value, bound, found)
        Call(callee, args) ->
            read_expr(keep, callee, bound, found)
            read_each(keep, args, bound, found)
        NamedArg(_, value) -> read_expr(keep, value, bound, found)
        Spread(value) -> read_expr(keep, value, bound, found)
        DefaultArg(_, value) -> read_expr(keep, value, bound, found)
        Index(receiver, index, _) ->
            read_expr(keep, receiver, bound, found)
            read_expr(keep, index, bound, found)
        Field(receiver, _, _) -> read_expr(keep, receiver, bound, found)
        TypeArgs(receiver, args, _) ->
            read_expr(keep, receiver, bound, found)
            read_each(keep, args, bound, found)
        TypeAttr(receiver, _, _, _) -> read_expr(keep, receiver, bound, found)
        WithExpr(base, fields, _) ->
            read_expr(keep, base, bound, found)

            for item in fields
                read_expr(keep, item.value, bound, found)
        TryExpr(inner) -> read_expr(keep, inner, bound, found)
        AwaitExpr(inner) -> read_expr(keep, inner, bound, found)
        Tuple(elements) -> read_each(keep, elements, bound, found)
        ArrayLit(elements) -> read_each(keep, elements, bound, found)
        ArrayFill(value, count) ->
            read_expr(keep, value, bound, found)
            read_expr(keep, count, bound, found)
        Block(stmts) -> read_block(keep, stmts, bound, found)
        IfExpr(cond, then_body, else_body, _) ->
            read_expr(keep, cond, bound, found)
            read_block(keep, then_body, bound, found)
            read_opt_block(keep, else_body, bound, found)
        ConstIf(cond, then_body, else_body) ->
            read_expr(keep, cond, bound, found)
            read_block(keep, then_body, bound, found)
            read_opt_block(keep, else_body, bound, found)
        MatchExpr(scrutinee, arms) ->
            read_expr(keep, scrutinee, bound, found)

            for arm in arms
                var inner = copied(bound)

                for j in 0..<arm.patterns.len()
                    pattern_binds_into(arm.patterns.at(j), &inner)

                // What the patterns **read**, which is the quoted names: they reference something
                // already declared rather than binding it, and are resolved against what was bound
                // before the arm.
                for j in 0..<arm.patterns.len()
                    pattern_reads(keep, arm.patterns.at(j), bound, found)

                read_opt(keep, arm.guard, inner, found)
                read_block(keep, arm.body, inner, found)
        IsPattern(subject, _, _) -> read_expr(keep, subject, bound, found)
        ResultList(values, _) -> read_each(keep, values, bound, found)
        While(_, cond, body, else_body) ->
            read_expr(keep, cond, bound, found)
            read_block(keep, body, bound, found)
            read_opt_block(keep, else_body, bound, found)
        DoWhile(_, body, cond, else_body) ->
            read_block(keep, body, bound, found)
            read_expr(keep, cond, bound, found)
            read_opt_block(keep, else_body, bound, found)
        Loop(_, body) -> read_block(keep, body, bound, found)
        For(_, name, iter, body, else_body) ->
            read_expr(keep, iter, bound, found)

            var inner = copied(bound)

            inner.push(name)
            read_block(keep, body, inner, found)
            read_opt_block(keep, else_body, bound, found)
        ConstFor(name, iter, body) ->
            read_expr(keep, iter, bound, found)

            var inner = copied(bound)

            inner.push(name)
            read_block(keep, body, inner, found)
        CFor(_, init, cond, step, body, else_body) ->
            var inner = copied(bound)

            init match
                Some(s) -> read_stmt(keep, s, &inner, found)
                None -> ()

            read_opt(keep, cond, inner, found)

            step match
                Some(s) -> read_stmt(keep, s, &inner, found)
                None -> ()

            read_block(keep, body, inner, found)
            read_opt_block(keep, else_body, inner, found)
        // A quantifier binds its name over the predicate and nowhere else, so an outer name of the
        // same spelling is not captured by a clause that only shadows it.
        Quantifier(_, name, iter, pred) ->
            read_expr(keep, iter, bound, found)

            var inner = copied(bound)

            inner.push(name)
            read_expr(keep, pred, inner, found)
        _ -> ()
end read_expr

// Every name a pattern binds, which shadows inside the arm it introduces.
pattern_binds_into(p: Pattern, out: *Buf[string])
    *p.kind match
        IdentPattern(name) -> out.push(name)
        BindPattern(name, inner) ->
            out.push(name)
            pattern_binds_into(inner, out)
        VariantPattern(_, args) ->
            for arg in args
                pattern_binds_into(arg, out)
        TuplePattern(args) ->
            for arg in args
                pattern_binds_into(arg, out)
        StructPattern(_, fields) ->
            for item in fields
                pattern_binds_into(item.pat, out)
        _ -> ()
end pattern_binds_into

// Every name a pattern **reads** -- the quoted ones, which reference something already declared
// rather than binding it.
private pattern_reads(keep: &Fn(string) -> bool, p: Pattern, bound: Buf[string], found: *Buf[string])
    *p.kind match
        EqPattern(name) ->
            if !names_hold(bound, name) && keep(name) &&
               !names_hold(*found, name) then
                found.push(name)
        BindPattern(_, inner) -> pattern_reads(keep, inner, bound, found)
        VariantPattern(_, args) ->
            for arg in args
                pattern_reads(keep, arg, bound, found)
        TuplePattern(args) ->
            for arg in args
                pattern_reads(keep, arg, bound, found)
        StructPattern(_, fields) ->
            for item in fields
                pattern_reads(keep, item.pat, bound, found)
        _ -> ()
end pattern_reads

private copied(xs: Buf[string]) -> Buf[string]
    var out: Buf[string] = buf()

    for item in xs
        out.push(item)

    out
end copied

private names_hold(xs: Buf[string], name: string) -> bool
    for item in xs
        if item == name then return true

    false
end names_hold

// -- the bare arrow a parameter may write --------------------------------------------------------

// The name the sugar gives the type parameter it adds. It holds the module separator, so nothing a
// program can write collides with it and a diagnostic that has to name one reads as the synthetic
// thing it is.
call_bound_name(n: usize) -> string = s"${ModuleSep}F$n"

// Whether a type parameter is one of those.
is_call_bound(name: string) -> bool =
    bytes_at(name, 0, s"${ModuleSep}F")

// Turns each bare-arrow parameter into the bounded type parameter it is sugar for.
//
// `map(self, f: A -> B)` is `map[$F0: Fn(A) -> B](self, f: $F0)`, and the rewrite happens at the
// **declaration** so that everything after it -- resolving the signature, inferring the argument,
// instantiating the body, emitting the direct call -- is the generic machinery that already exists.
// The parameter is a bound and not a type, which is what makes the call direct, and it is the whole
// reason the arrow is available in a parameter and nowhere else.
//
// **It is idempotent**, which is what lets a declaration go through here wherever it is read: a
// rewritten parameter is a written name, and only a bare `FnType` is looked for.
with_call_bounds(d: FuncDecl) -> FuncDecl
    val rewritten = call_bounds(d.tparams, d.params)

    if rewritten.is_none() then return d

    val (tparams, params, bounds) = rewritten.unwrap()

    FuncDecl(d.name, tparams, params, d.ret_type, d.body, joined_bounds(d.bounds, bounds),
             d.variadic, d.vis, d.tdefaults, d.tvalues, d.tpacks, d.test, d.hook, d.conv, d.tailrec,
             d.pure, d.ghost, d.reads, d.writes, d.exported, d.section, d.crossing, d.needs, d.marks,
             d.at, d.const_fn)
end with_call_bounds

// The same for a member, which writes the sugar wherever a function does.
with_member_call_bounds(m: MethodDecl) -> MethodDecl
    val rewritten = call_bounds(m.tparams, m.params)

    if rewritten.is_none() then return m

    val (tparams, params, bounds) = rewritten.unwrap()

    MethodDecl(m.span, m.name, m.receiver, m.is_property, tparams, params, m.ret_type, m.body,
               joined_bounds(m.bounds, bounds), m.tdefaults, m.vis, m.variadic, m.overrides,
               m.tvalues, m.tpacks, m.crossing, m.reads, m.writes, m.is_static, m.marks,
               m.named_at, m.const_fn)
end with_member_call_bounds

// The added parameters, the parameter list with each arrow replaced by the name that stands for it,
// and the bounds those names carry -- or nothing at all where no parameter wrote an arrow, so that
// a declaration which did not use the sugar is left exactly as it was.
private call_bounds(tparams: Buf[string],
                    params: Buf[Param]) -> Option[(Buf[string], Buf[Param], Buf[NamedBounds])]
    var added: Buf[string] = buf()
    var bounds: Buf[NamedBounds] = buf()
    var out: Buf[Param] = buf()

    for p in params
        *p.typ.kind match
            FnType(fparams, ret, bare) ->
                if !bare
                    out.push(p)
                else
                    val tp = call_bound_name(tparams.len() + added.len())
                    var args: Buf[TypeRef] = buf()

                    for j in 0..<fparams.len()
                        args.push(fparams.at(j))

                    args.push(ret)
                    added.push(tp)

                    var bs: Buf[BoundRef] = buf()

                    bs.push(BoundRef(p.typ.span, fn_base(fparams.len()), args))
                    bounds.push(NamedBounds(tp, bs))
                    out.push(Param(p.span, p.name, TypeRef(p.typ.span, NamedType(tp, buf())), p.vis,
                                   p.default, p.by_name, p.rest))
            _ -> out.push(p)

    if added.is_empty() then return None

    var all: Buf[string] = buf()

    for tparam in tparams
        all.push(tparam)

    for item in added
        all.push(item)

    Some((all, out, bounds))
end call_bounds

private joined_bounds(outer: Buf[NamedBounds], added: Buf[NamedBounds]) -> Buf[NamedBounds]
    var out: Buf[NamedBounds] = buf()

    for item in outer
        out.push(item)

    for item in added
        out.push(item)

    out
end joined_bounds

// A trait's members get the same rewrite a type's do, so that a signature written with an arrow
// means the same thing wherever it is read back -- at a call through a bound, at a conformance
// check, and in the default body the trait supplies.
with_trait_call_bounds(d: TraitDecl) -> TraitDecl
    var methods: Buf[MethodDecl] = buf()

    for item in d.methods
        methods.push(with_member_call_bounds(item))

    TraitDecl(d.name, d.tparams, methods, d.bounds, d.supers, d.vis, d.tdefaults, d.assocs, d.tvalues,
              d.derives)
end with_trait_call_bounds

// The same for the three other declaration forms that carry members, so that a signature written
// with an arrow means one thing wherever it is read: at a call, at a conformance check, and in the
// body an `impl` block wrote.
with_impl_call_bounds(d: ImplDecl) -> ImplDecl
    ImplDecl(d.trait_name, d.for_type, lowered_members(d.methods), d.tparams, d.bounds,
             d.trait_args, d.tdefaults, d.overrides, d.tvalues, d.tpacks, d.assocs, d.derived)

with_struct_call_bounds(d: StructDecl) -> StructDecl
    StructDecl(d.name, d.tparams, d.fields, lowered_members(d.members), d.bounds, d.invariants,
               d.vis, d.tdefaults, d.opaque, d.tvalues, d.packed, d.alignment, d.cname, d.deriving,
               d.byte_order, d.guards, d.pinned, d.union_layout, d.anon, d.bits, d.annotation,
               d.annots)

with_enum_call_bounds(d: EnumDecl) -> EnumDecl
    EnumDecl(d.name, d.tparams, d.underlying, d.variants, lowered_members(d.members), d.bounds,
             d.vis, d.tdefaults, d.tvalues, d.deriving, d.annots)

private lowered_members(ms: Buf[MethodDecl]) -> Buf[MethodDecl]
    var out: Buf[MethodDecl] = buf()

    for item in ms
        out.push(with_member_call_bounds(item))

    out
end lowered_members
