module sh.sysl.compiler
@tests

import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.{capture, Var}
import sysl.text.{cstring, Search}

// `defer _ = f()`: one written statement the analyzer reads as three -- the discard's hidden local
// declared empty, written with the call's value, and emptied again. A scope lays what it holds
// last-first, so when the three were held one by one they ran backwards: the emptying store came
// first and read the hidden local before anything had written it, and a counted value's release
// asked that garbage its tag. Held whole, the deferred statement runs in the order it was written.
//
// The same local met a second way out: a `?` lays the deferred statement down on its own edge, and
// the declaration registered the local with the function's scope, so the function's ordinary end
// released it before that end's own laying had written it -- a fault at -O2 since 0.11.1. Each laying
// now owns its locals in a scope of its own, an `errdefer`'s too.
//
// Every program runs on the counted heap at -O0 and -O2 (the right output, nothing left over); the
// reduction also under AddressSanitizer. The cells: a bare `defer`, a `return` before the end, a
// function left by `?` both ways, a loop left by `break`, a `defer` inside a scope with its own, two
// defers in one scope, an `Option` payload, a large (address-form) enum, a failure that holds a
// counted string, a discard in a `match` arm and in an `if` branch of the deferred statement, and two
// discards in one deferred multiple assignment, which must keep their order.
//
// Not crossed, with the reason: an `errdefer` already laid its statements in order (its run holds the
// `TDefer` whole), and bare metal and separate compilation change nothing about where a scope's
// deferred statement is laid.

private extern "setenv" ddz_c_setenv(name: *u8, value: *u8, overwrite: int) -> int
private extern "unsetenv" ddz_c_unsetenv(name: *u8) -> int

private struct DdzRun
    out: string
    err: string
    hooks: usize
end DdzRun

// The program built at `level` and run: on the counted heap, or with `flags` handed to clang.
private ddz_run(text: string, counted: bool, flags: string, level: string) -> DdzRun
    val root = make_temp_dir("sysl-ddz").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", text).unwrap()

    val exe = s"$root/built"

    if flags != ""
        val n = cstring("SYSL_EXTRA_CFLAGS")
        val v = cstring(flags)

        ddz_c_setenv(n.ptr, v.ptr, 1)
    end if

    force_alloc_counting(counted)

    val made = build_native_program(s"$root/main.sysl", None, None, level, Some(exe))

    force_alloc_counting(false)

    if flags != ""
        val n = cstring("SYSL_EXTRA_CFLAGS")

        ddz_c_unsetenv(n.ptr)
    end if

    made match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return DdzRun(failure_text(why), "", 0)
        Ok(_) -> ()

    val hooks = capture("nm", ["-u", exe], "", [], true) match
        Ok(o) -> o.text.count_of("__asan_report")
        Err(_) -> 0

    val ran = capture(exe, [], "", [Var("ASAN_OPTIONS", "detect_stack_use_after_return=1")], true)

    remove_dir_all(root).unwrap_or(())

    ran match
        Err(_) -> DdzRun("could not be started", "", hooks)
        Ok(o) -> DdzRun(o.text, o.err.unwrap_or(""), hooks)
end ddz_run

// The program prints `want` at -O0 and at -O2 on the counted heap, and gives everything back.
private ddz_prints(body: string, want: string)
    if !enm_ready() then return

    for level in ["0", "2"]
        val got = ddz_run(ddz_common() + body, true, "", level)

        assert_eq(got.out, want)
        assert_eq(got.err, "")
end ddz_prints

private ddz_common() -> string = """
    count(n: int) -> Result[int, string]
        print(s"count $n")
        Ok(n)

    fail(n: int) -> Result[int, string]
        print(s"fail $n")
        Err(s"bad $n")

    name_of(n: int) -> Option[string]
        print(s"name $n")
        Some(s"name $n")

    enum Wide
        Many(a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int, s: string)
        Empty

    wide(n: int) -> Wide
        print(s"wide $n")
        Many(n, n, n, n, n, n, n, n, s"wide $n")

    """

// The stack `run` will reuse is filled with ones first, so storage read before it is written holds
// the failure's tag and a pointer no allocation made -- not whatever happened to be left there.
private val ddz_reduction = """
    scribble(k: int) -> int
        val junk = [k; 64]
        var sum = 0

        for i in 0..<64
            sum += junk[i]
        sum

    run()
        defer _ = count(9)
        print("end")

    if scribble(1) == 64 then run()
    """

@test("'defer _ = f()' runs the call once, after the block's last statement")
ddz_bare()
    ddz_prints(ddz_reduction, "end\ncount 9\n")

@test("'defer _ = f()' is clean under AddressSanitizer")
ddz_asan()
    if !enm_ready() then return

    val got = ddz_run(ddz_common() + ddz_reduction, false, "-fsanitize=address -g", DefaultOptimization)

    assert(got.hooks > 0, s"not instrumented: ${got.out}")
    assert_eq(got.out, "end\ncount 9\n")
    assert_eq(got.err, "")

@test("a deferred discard whose failure holds a counted string gives it back")
ddz_counted_failure()
    ddz_prints("""
        run()
            defer _ = fail(3)
            print("end")

        run()
        """, "end\nfail 3\n")

@test("a deferred discard runs on a 'return' before the end and at the end")
ddz_early_return()
    ddz_prints("""
        run(early: bool)
            defer _ = fail(1)
            if early then return
            print("tail")

        run(true)
        run(false)
        """, "fail 1\ntail\nfail 1\n")

@test("a deferred discard runs when '?' leaves the function, and when it does not")
ddz_question()
    ddz_prints("""
        run(n: int) -> Result[int, string]
            defer _ = count(2)
            val v = (if n > 0 then count(n) else fail(n))?
            print(s"got $v")
            Ok(v)

        _ = run(5)
        _ = run(0)
        """, "count 5\ngot 5\ncount 2\nfail 0\ncount 2\n")

@test("an 'errdefer _ = f()' runs only when '?' leaves with the failure")
ddz_errdefer()
    ddz_prints("""
        run(n: int) -> Result[int, string]
            errdefer _ = name_of(3)
            defer _ = count(2)
            val v = (if n > 0 then count(n) else fail(n))?
            Ok(v)

        _ = run(5)
        _ = run(0)
        """, "count 5\ncount 2\nfail 0\ncount 2\nname 3\n")

@test("a deferred discard in a loop body runs every turn, the one left by 'break' too")
ddz_break()
    ddz_prints("""
        run()
            for i in 0..<3
                defer _ = name_of(i)
                if i == 1 then break
                print(s"turn $i")
            print("end")

        run()
        """, "turn 0\nname 0\nname 1\nend\n")

@test("deferred discards in an inner and an outer scope each run as their own scope is left")
ddz_nested()
    ddz_prints("""
        run(flag: bool)
            defer _ = count(1)
            if flag
                defer _ = fail(2)
                print("inner")
            defer _ = wide(3)
            print("end")

        run(true)
        """, "inner\nfail 2\nend\nwide 3\ncount 1\n")

@test("two deferred discards in one scope run last written first, each whole")
ddz_two_in_a_scope()
    ddz_prints("""
        run()
            defer _ = name_of(1)
            defer _ = fail(2)
            print("end")

        run()
        """, "end\nfail 2\nname 1\n")

@test("a deferred discard of an Option payload and of a large enum gives each back")
ddz_option_and_wide()
    ddz_prints("""
        run()
            defer _ = name_of(4)
            defer _ = wide(5)
            print("end")

        run()
        """, "end\nwide 5\nname 4\n")

@test("a discard in a match arm or an if branch of a deferred statement runs in the arm taken")
ddz_in_an_arm()
    ddz_prints("""
        run(flag: bool)
            defer flag match
                true -> _ = fail(6)
                false -> _ = wide(7)
            defer if flag then _ = name_of(8) else _ = count(9)
            print("end")

        run(true)
        run(false)
        """, "end\nname 8\nfail 6\nend\ncount 9\nwide 7\n")

@test("two discards in one deferred multiple assignment are evaluated in the order written")
ddz_multiple()
    ddz_prints("""
        run()
            defer _, _ = fail(1), name_of(2)
            print("end")

        run()
        """, "end\nfail 1\nname 2\n")
