// p19: `Self::Item` inside a member's own type-parameter bound -- which Self does it mean?
trait It
    type Item
    next(*self) -> Option[Self::Item]

    apply[U, F: Fn1[Self::Item, U]](self, f: F) -> Option[U]
        var cur = self
        cur.next() match
            Some(x) -> Some(f(x))
            None -> None
    end apply

struct Count
    n: int

impl It for Count
    type Item = int
    next(*self) -> Option[int] = Some(self.n)

main()
    print(Count(4).apply(x -> x * 10).unwrap())
