module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}

// Typing the body a function's declaration is followed by, whatever the body is made of.
//
// **A body is a block and a block is an expression**, so one entry answers for every function: the
// parameters are bound, the contract clauses at the head are read against the signature, and the
// rest is a value block asked for the declared result. What was a single expression before is that
// same block with one statement in it.

// The functions of a compilation whose bodies this stage types, with what it had to say about them.
struct TypedBodies
    funcs: Buf[TFunc]
    reported: Buf[Placed]

    // How many bodies were left for a later stage, and why.
    skipped_generic: usize
    skipped_defaults: usize

    // How many of the functions are the ones the sources **declared** at the top level, which are
    // the first of them. What follows are the members each type's declaration lowered to and the
    // instantiations the calls asked for -- functions a program never wrote a heading for, so a test
    // reading "the last body" means the last one somebody typed.
    declared: usize
end TypedBodies

// Reads a compilation's declarations and types every body it can.
analyze_bodies(units: Buf[Program], t: Target) -> TypedBodies
    val a = analysis_for(t)

    read_decls(a, units)

    var funcs: Buf[TFunc] = buf()
    var generic: usize = 0
    var defaults: usize = 0

    for i in 0..<units.len()
        val unit = units.at(i)
        val scope = scope_of_unit(unit)

        for j in 0..<unit.body.len()
            val s = unit.body.at(j)

            *s.kind match
                // **A generic declaration is not a function**, so there is no body to type here:
                // what a program runs is the instantiation a call asked for, and each one is typed
                // below with its parameters fixed.
                FuncDecl(d) ->
                    if !d.tparams.is_empty() then generic += 1
                    else if signature_needs_defaults(a, scope, d) then defaults += 1
                    else funcs.push(analyze_body(a, scope, s.span, d))
                _ -> ()

    val declared = funcs.len()

    // **A generic body is checked once, at its definition**, with each type parameter opaque except
    // for what its bounds promise. What separates that from a template is that the body is wrong on
    // its own, so the complaint does not wait for a call site to expose it.
    check_generic_bodies(a, units)

    // A member of a concrete type is a function whose body is typed whether or not anything calls
    // it, which is what makes a mistake in one a mistake at its declaration.
    val lowered = a.tables.members.lowered

    for i in 0..<lowered.len()
        funcs.push(analyze_instance(a, lowered.at(i).name, lowered.at(i)))

    // Then the instantiations, drained until nothing more is asked for: typing one body may reach a
    // call that asks for another.
    var guard: usize = 0

    while !a.tables.members.pending.is_empty() && guard < 4096
        val work = a.tables.members.pending

        a.tables.members.pending = buf()

        for i in 0..<work.len()
            val job = work.at(i)
            val cx = analyzer_for(a, job.scope)

            cx.subst = job.subst
            funcs.push(analyze_instance_in(a, cx, job.name, job.decl))

        guard += 1

    TypedBodies(funcs, a.diagnostics(), generic, defaults, declared)
end analyze_bodies

// Whether a signature names a type declared with **type defaults** -- `struct Pair[A, B = A]`
// written at `Pair[int]`.
//
// Filling the omitted argument in from the declaration's default is the stage that reads a
// declaration's type parameters, so a body whose signature needs one is left for it rather than
// typed against a type this stage would get wrong.
private signature_needs_defaults(a: &Analysis, scope: Scope, d: FuncDecl) -> bool
    var names: Buf[(string, Span)] = buf()

    for i in 0..<d.params.len()
        names_in(&names, d.params.at(i).typ, d.tparams)

    if d.ret_type.is_some() then names_in(&names, d.ret_type.unwrap(), d.tparams)

    for i in 0..<names.len()
        val key = lookup_type_key(a, scope, names.at(i).0)

        if key.is_some() then
            val decl = a.tables.types.get(key.unwrap())

            if decl.is_some() then
                val has = decl.unwrap().kind match
                    StructOf(t) -> !t.tdefaults.is_empty()
                    EnumOf(t) -> !t.tdefaults.is_empty()
                    _ -> false

                if has then return true

    false
end signature_needs_defaults

// One function: its parameters in scope, its contract read first, and its body as a value block.
analyze_body(a: &Analysis, scope: Scope, span: Span, d: FuncDecl) -> TFunc
    val cx = analyzer_for(a, scope)
    var params: Buf[(string, Type)] = buf()

    for i in 0..<d.params.len()
        val p = d.params.at(i)
        val ty = resolve_type(a, scope, p.typ, no_bindings())

        params.push((cx.bind(p.name, ty), ty))

    // **A function that declares no result hands nothing back**, so its body is read with nothing
    // expected and the value it comes to is discarded -- which is why `probe() = 42` is a `unit`
    // function rather than an `int` one.
    val written = d.ret_type.map(w -> resolve_type(a, scope, w, no_bindings()))
    val ret = declared_result_type(written)

    cx.func_name = d.name
    cx.ret_ty = Some(ret)
    cx.ret_is_list = written.is_some() && is_result_list(written.unwrap())

    val split = contract_length(d.body)
    val contract = analyze_contract(cx, d.body, split, ret)
    val rest = statements_from(d.body, split)

    // A function owing no value is where statement position starts: its body block is the outermost
    // one written for effect, and every `if` and `match` that ends it inherits that.
    val body = body_block(cx, rest, ret)

    if ret != Unit && body.result.is_some() && disagree(body.ty, ret) then
        cx.fault(body_span(rest, span), s"function '${d.name}' should return ${type_show(ret)}, " +
                 s"but its body yields ${type_show(body.ty)}")

    TFunc(span, func_key(a, scope, span, d), params, ret, body, d.variadic, contract.0, contract.1,
          contract.2, false, d.conv, d.tailrec, contract.3, d.pure, d.ghost, d.reads, d.writes,
          exported_symbol(d), d.section)
end analyze_body

// Every generic declaration's body, read once with its parameters standing in for themselves.
//
// **The tree is thrown away and so is nearly everything the walk said.** An instantiation reads the
// same body again against concrete types and raises the ordinary complaints there, with a position
// in the caller's own terms; what survives is what only this walk can find -- a call a bound does
// not license, and a call that disagrees with the *trait's* signature rather than with any one
// implementation's.
private check_generic_bodies(a: &Analysis, units: Buf[Program])
    for i in 0..<units.len()
        val unit = units.at(i)
        val scope = scope_of_unit(unit)

        for j in 0..<unit.body.len()
            *unit.body.at(j).kind match
                FuncDecl(d) -> if !d.tparams.is_empty() then check_abstract_body(a, scope, d)
                _ -> ()

    // A generic type's members and a generic `impl`'s are checkable before anything instantiates
    // them, against the bounds the block wrote on its own parameters -- the same walk. An inherited
    // default is left out: it was checked at the trait, against what the trait promises, which is
    // the whole of what its body may assume wherever it is copied to.
    val generic = a.tables.members.generic

    for i in 0..<generic.len()
        val fd = generic.at(i)

        if !a.tables.members.default_origin.has(fd.name)
            val scope = a.tables.members.decl_scope.get(fd.name).unwrap_or(empty_scope())

            check_abstract_body(a, scope, fd)
end check_generic_bodies

// One such body, in a region everything but a kept complaint is rewound out of.
private check_abstract_body(a: &Analysis, scope: Scope, d: FuncDecl)
    if d.body.is_empty() then return

    val mark = a.complaints()
    val queued = a.tables.members.pending.len()
    val outer = a.tables.members.selves.get(d.name).unwrap_or(buf())
    var subst = joined_bindings(outer, abstract_subst(a, scope, d.tparams, d.bounds, d.tvalues,
                                                      d.tpacks, outer))
    // On a generic type `Self` is the type applied to its own parameters, which is what the members
    // of one are read under.
    val written = a.tables.members.generic_self.get(d.name)

    if written.is_some() then subst.push(Binding("Self", resolve_type(a, scope, written.unwrap(),
                                                                      subst)))

    val cx = analyzer_for(a, scope)

    cx.subst = subst

    for i in 0..<d.params.len()
        val p = d.params.at(i)

        cx.bind(p.name, resolve_type(a, scope, p.typ, subst))

    var ret = Unit

    if d.ret_type.is_some() then
        ret = declared_result_type(Some(resolve_type(a, scope, d.ret_type.unwrap(), subst)))

    cx.func_name = d.name
    cx.ret_ty = Some(ret)
    cx.ret_is_list = false

    val split = contract_length(d.body)

    analyze_contract(cx, d.body, split, ret)
    body_block(cx, statements_from(d.body, split), ret)

    a.restore_complaints(mark)
    a.tables.members.pending.truncate(queued)
end check_abstract_body

// One function whose signature the tables already hold, under the name they hold it by: a member
// lowered from a type's body or from an `impl` block, or one instantiation of a generic.
//
// **The signature is read back rather than resolved again**, which is what makes the body agree with
// the call that asked for it: the arguments a call solved are what the parameters were made real at,
// and resolving the declaration a second time would have nothing to make them real from.
analyze_instance(a: &Analysis, name: string, d: FuncDecl) -> TFunc
    val scope = a.tables.members.decl_scope.get(name).unwrap_or(empty_scope())
    val cx = analyzer_for(a, scope)
    val outer = a.tables.members.selves.get(name)

    if outer.is_some() then cx.subst = outer.unwrap()

    analyze_instance_in(a, cx, name, d)
end analyze_instance

// The same, on an analyzer whose terms a caller has already set.
analyze_instance_in(a: &Analysis, cx: &Analyzer, name: string, d: FuncDecl) -> TFunc
    val sig = a.tables.members.func_insts.get(name)

    if sig.is_none() then return TFunc(span_zero(), name, buf(), Unit, empty_block(), false, buf(),
                                       buf(), buf(), false, None, false, None, false, false, None,
                                       None, None, None)

    var params: Buf[(string, Type)] = buf()

    for i in 0..<sig.unwrap().params.len()
        val p = sig.unwrap().params.at(i)

        params.push((cx.bind(p.0, p.1), p.1))

    val ret = sig.unwrap().ret

    cx.func_name = name
    cx.ret_ty = Some(ret)
    cx.ret_is_list = false

    val split = contract_length(d.body)
    val contract = analyze_contract(cx, d.body, split, ret)
    val rest = statements_from(d.body, split)
    val body = body_block(cx, rest, ret)
    val span = body_span(rest, span_zero())

    if ret != Unit && body.result.is_some() && disagree(body.ty, ret) then
        cx.fault(span, s"function '$name' should return ${type_show(ret)}, but its body yields " +
                 s"${type_show(body.ty)}")

    TFunc(span, name, params, ret, body, d.variadic, contract.0, contract.1, contract.2, false,
          d.conv, d.tailrec, contract.3, d.pure, d.ghost, d.reads, d.writes, exported_symbol(d),
          d.section)
end analyze_instance_in

// A block with nothing in it, for a function whose signature never resolved.
private empty_block() -> TBlock = TBlock(buf(), None, Unit)

// The body itself, asked for the declared result -- or, where the function owes no value, read in
// statement position with what it comes to discarded.
private body_block(cx: &Analyzer, rest: Buf[Stmt], ret: Type) -> TBlock
    if ret == Unit then return type_value_block(cx, rest, None, true)

    type_value_block(cx, rest, Some(ret), false)
end body_block

// What a function hands back: the tuple a result list lays out as, and `unit` where none was
// written.
declared_result_type(written: Option[Type]) -> Type
    if written.is_none() then return Unit

    result_type(written.unwrap())
end declared_result_type

private is_result_list(t: Type) -> bool = t match
    Results(_) -> true
    _ -> false

// How many statements at the head of a body are its contract, which is what splits the clauses from
// the code. A clause after that is one written somewhere it may not be, and the statement walk says
// so there.
private contract_length(body: Buf[Stmt]) -> usize
    var n: usize = 0

    while n < body.len() && is_contract_clause(body.at(n))
        n = n + 1

    n
end contract_length

private is_contract_clause(s: Stmt) -> bool = *s.kind match
    Require(_, _) -> true
    Ensure(_, _) -> true
    Variant(_) -> true
    _ -> false

private statements_from(body: Buf[Stmt], first: usize) -> Buf[Stmt]
    var out: Buf[Stmt] = buf()

    for i in first..<body.len()
        out.push(body.at(i))

    out
end statements_from

// The leading `require`/`ensure`/`variant` clauses. Both conditions must be `bool`; `result` and
// `old(e)` are only in scope inside an `ensure` -- `result` also only where the function returns a
// value -- and the `old` expressions are collected so that the emitter can snapshot them at entry.
private analyze_contract(cx: &Analyzer, body: Buf[Stmt], upto: usize,
                         ret: Type) -> (Buf[TClause], Buf[TClause], Buf[TExpr], Option[TExpr])
    var requires: Buf[TClause] = buf()
    var ensures: Buf[TClause] = buf()
    var olds: Buf[TExpr] = buf()
    var measure: Option[TExpr] = None

    for i in 0..<upto
        val c = body.at(i)

        *c.kind match
            Require(cond, msg) -> requires.push(TClause(analyze_bool(cx, cond), msg))

            Ensure(cond, msg) ->
                cx.ensure_result = if ret == Unit then None else Some(ret)
                cx.olds = Some(olds)

                val tc = analyze_bool(cx, cond)

                olds = cx.olds.unwrap()
                cx.olds = None
                cx.ensure_result = None
                ensures.push(TClause(tc, msg))

            // The measure reads the parameters and nothing else, and **scoping is what enforces
            // it** rather than a rule of this pass: the clause is read before the body, in a scope
            // holding the parameters alone, so a name from the body is undefined here.
            Variant(e) -> measure = function_measure(cx, c.span, e, measure)

            _ -> ()

    (requires, ensures, olds, measure)
end analyze_contract

private function_measure(cx: &Analyzer, span: Span, e: Expr,
                         already: Option[TExpr]) -> Option[TExpr]
    if already.is_some() then
        cx.fault(span, "a function declares one 'variant' — a measure is the thing that " +
                 "decreases, and two of them say nothing about which")

    val te = type_expr_bare(cx, e)

    texpr_type(te) match
        Integer(_, _, _) -> ()
        Unknown -> ()
        other -> cx.fault(span, s"a 'variant' is an integer measure, not ${type_show(other)}")

    Some(te)
end function_measure

// Where a complaint about the whole body points: its last statement, which is the expression the
// body came to, and the declaration itself for a body with none.
private body_span(rest: Buf[Stmt], span: Span) -> Span
    if rest.is_empty() then return span

    rest.at(rest.len() - 1).span
end body_span

// The key the declaration was filed under, which is the plain name for the first declaration of it
// and the numbered slot for every overload after that.
//
// **It is read off the tables rather than composed**, so a call and a definition cannot disagree
// about which of two declarations of one name a key means.
private func_key(a: &Analysis, scope: Scope, span: Span, d: FuncDecl) -> string
    val plain = module_qualify(scope.module_name, d.name)
    val keys = overload_keys(a, plain)

    for i in 0..<keys.len()
        val f = a.tables.funcs.get(keys.at(i))

        if f.is_some() && f.unwrap().span.start == span.start &&
                f.unwrap().scope.src.name == scope.src.name then
            return keys.at(i)

    plain
end func_key

// The symbol a function is visible under from C, where it is exported at all: the one the attribute
// named, and the declaration's own bare name where it named none.
private exported_symbol(d: FuncDecl) -> Option[string]
    if d.exported.is_none() then return None

    val named = d.exported.unwrap().symbol

    if named.is_some() then return named

    Some(d.name)
end exported_symbol

// -- what a test asks ------------------------------------------------------------------------------

// Everything the body pass has to say about one source, as text.
stmt_diagnostics(text: string) -> Buf[string]
    val parsed = parse(source_of("test.sysl", text))
    var out: Buf[string] = buf()

    if !parsed.ok()
        for i in 0..<parsed.report.len()
            out.push(parsed.report.at(i).message)

        return out
    end if

    var units: Buf[Program] = buf()

    units.push(parsed.program)

    val done = analyze_bodies(units, host_target())

    for i in 0..<done.reported.len()
        out.push(done.reported.at(i).diag.message)

    out
end stmt_diagnostics

// The same, under the name the expression tests already assert on.
expr_diagnostics(text: string) -> Buf[string] = stmt_diagnostics(text)

// The type the **last** body of a source comes to, rendered the way a diagnostic quotes one.
//
// **It is the seam the typing tests assert on**, and the last function is what they read because a
// test writes whatever it needs above the line it is about.
body_type(text: string) -> string
    val parsed = parse(source_of("test.sysl", text))

    if !parsed.ok() then return parsed.report.at(0).message

    var units: Buf[Program] = buf()

    units.push(parsed.program)

    val done = analyze_bodies(units, host_target())

    if !done.reported.is_empty() then return done.reported.at(0).diag.message
    if done.declared == 0 then return "no body"

    val last = done.funcs.at(done.declared - 1)

    if last.body.result.is_none() then return "no value"

    type_show(texpr_type(last.body.result.unwrap()))
end body_type

// The type the body of one **named** function comes to, which for an instantiation is the mangled
// name a call filed it under and for a member the name its type lowered it to.
//
// **It is the seam a generic's claim is asserted on.** What a generic declaration means is what its
// instantiations turn out to be, and a source that calls one at two types has two answers -- neither
// of them the last body, and neither of them anything the declaration alone could be asked for.
inst_type(text: string, name: string) -> string
    val done = typed_of(text)

    if !done.reported.is_empty() then return done.reported.at(0).diag.message

    for i in 0..<done.funcs.len()
        val f = done.funcs.at(i)

        if f.name == name
            if f.body.result.is_none() then return type_show(f.ret_ty)

            return type_show(texpr_type(f.body.result.unwrap()))

    s"no function named '$name'"
end inst_type

// The names every function a source came to is filed under, in the order they were typed -- what a
// test asserting which instantiations a program asked for reads.
inst_names(text: string) -> Buf[string]
    var out: Buf[string] = buf()
    val done = typed_of(text)

    for i in 0..<done.funcs.len()
        out.push(done.funcs.at(i).name)

    out
end inst_names

// One source, parsed and typed.
private typed_of(text: string) -> TypedBodies
    val parsed = parse(source_of("test.sysl", text))

    if !parsed.ok()
        var said: Buf[Placed] = buf()
        val src = source_of("test.sysl", text)

        for i in 0..<parsed.report.len()
            said.push(Placed(src, parsed.report.at(i)))

        return TypedBodies(buf(), said, 0, 0, 0)
    end if

    var units: Buf[Program] = buf()

    units.push(parsed.program)
    analyze_bodies(units, host_target())
end typed_of

// Everything the trait and generic machinery has to say about one source, which is what an
// error-path test for a bound, an `impl` or a member asserts on.
trait_diagnostics(text: string) -> Buf[string] = stmt_diagnostics(text)

// The same, under the name the expression tests already assert on.
expr_type(text: string) -> string = body_type(text)

// The same, wrapped in a function so a test may write an expression on its own.
expr_type_of(expr: string) -> string = body_type(s"probe() = $expr\n")

// The type a named binding of the **last** body holds, rendered the way a diagnostic quotes one.
//
// **It is the seam a statement's claim is asserted on**, since what a `val` or a pattern settles is
// a type nothing hands back: a body ending in `print(x)` says nothing about what `x` is, and this
// asks the declaration itself.
binding_type(text: string, name: string) -> string
    val parsed = parse(source_of("test.sysl", text))

    if !parsed.ok() then return parsed.report.at(0).message

    var units: Buf[Program] = buf()

    units.push(parsed.program)

    val done = analyze_bodies(units, host_target())

    if !done.reported.is_empty() then return done.reported.at(0).diag.message
    if done.declared == 0 then return "no body"

    val found = binding_in_block(done.funcs.at(done.declared - 1).body, name)

    if found.is_none() then return s"no binding named '$name'"

    type_show(found.unwrap())
end binding_type

// The type a run of statements binds a name at, looking into the blocks a statement carries so that
// a binding made inside a loop or a branch is reachable too.
private binding_in(stmts: Buf[TStmt], name: string) -> Option[Type]
    for i in 0..<stmts.len()
        stmts.at(i) match
            TVarDecl(bound, ty, _, _) -> if bound == name then return Some(ty)
            TRefDecl(bound, ty, _) -> if bound == name then return Some(ty)
            TExprStmt(e) ->
                val inner = binding_in_expr(e, name)

                if inner.is_some() then return inner
            TDefer(inner) ->
                val found = binding_in(inner, name)

                if found.is_some() then return found
            _ -> ()

    None
end binding_in

private binding_in_expr(e: TExpr, name: string) -> Option[Type] = *e.kind match
    TIf(cond, t, els, _) ->
        binding_in_cond(cond, name).or_else(() -> binding_in_block(t, name))
            .or_else(() -> binding_in_opt_block(els, name))
    TBlockExpr(b) -> binding_in_block(b, name)
    TMatch(_, arms, _) -> binding_in_arms(arms, name)
    TWhile(cond, body, els, _) ->
        binding_in_cond(cond, name).or_else(() -> binding_in(body, name))
            .or_else(() -> binding_in_opt_block(els, name))
    TDoWhile(body, _, els, _) ->
        binding_in(body, name).or_else(() -> binding_in_opt_block(els, name))
    TLoop(body, _) -> binding_in(body, name)
    TFor(bound, var_ty, _, _, _, body, els, _) ->
        if bound == name then Some(var_ty)
        else binding_in(body, name).or_else(() -> binding_in_opt_block(els, name))
    TForEach(bound, elem_ty, _, body, els, _) ->
        if bound == name then Some(elem_ty)
        else binding_in(body, name).or_else(() -> binding_in_opt_block(els, name))
    TCFor(init, _, step, body, els, _) ->
        binding_in(init, name).or_else(() -> binding_in(step, name))
            .or_else(() -> binding_in(body, name))
            .or_else(() -> binding_in_opt_block(els, name))
    TCheckedLoop(_, _, walked) -> binding_in_expr(walked, name)
    TSeq(xs) -> binding_in_exprs(xs, name)
    _ -> None

// A condition's terms, since an `is` binds into the branch the test guards.
private binding_in_cond(cond: Buf[TCondTerm], name: string) -> Option[Type]
    for i in 0..<cond.len()
        cond.at(i) match
            TCondIs(_, patterns, _) ->
                val found = pattern_binding(patterns, name)

                if found.is_some() then return found
            _ -> ()

    None
end binding_in_cond

private binding_in_exprs(xs: Buf[TExpr], name: string) -> Option[Type]
    for i in 0..<xs.len()
        val found = binding_in_expr(xs.at(i), name)

        if found.is_some() then return found

    None
end binding_in_exprs

private binding_in_block(b: TBlock, name: string) -> Option[Type]
    val found = binding_in(b.stmts, name)

    if found.is_some() then return found
    if b.result.is_none() then return None

    binding_in_expr(b.result.unwrap(), name)
end binding_in_block

private binding_in_opt_block(b: Option[TBlock], name: string) -> Option[Type]
    if b.is_none() then return None

    binding_in_block(b.unwrap(), name)
end binding_in_opt_block

private binding_in_arms(arms: Buf[TArm], name: string) -> Option[Type]
    for i in 0..<arms.len()
        val bound = pattern_binding(arms.at(i).patterns, name)

        if bound.is_some() then return bound

        val found = binding_in_block(arms.at(i).body, name)

        if found.is_some() then return found

    None
end binding_in_arms

// The type one of a run of patterns binds a name at, which is what an arm's capture asks.
private pattern_binding(ps: Buf[TPattern], name: string) -> Option[Type]
    for i in 0..<ps.len()
        val found = pattern_binds_name(ps.at(i), name)

        if found.is_some() then return found

    None
end pattern_binding

private pattern_binds_name(p: TPattern, name: string) -> Option[Type] = p match
    TBindPattern(bound, ty) -> if bound == name then Some(ty) else None
    TAtPattern(bound, inner) ->
        if bound == name then Some(tpattern_type(*inner)) else pattern_binds_name(*inner, name)
    TVariantPattern(_, _, args) -> pattern_binding(args, name)
    TStructPattern(_, args) -> pattern_binding(args, name)
    _ -> None
