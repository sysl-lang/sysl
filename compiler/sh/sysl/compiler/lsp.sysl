module sh.sysl.compiler

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.encoding.json.{Json, Member as JsonMember, parse as parse_json, quoted as json_quote}
import sysl.fs.{is_file, read_bytes}
import sysl.io.{FdReader, Reader, stdin}
import sysl.io.wait.Wait
import sysl.text.{from_utf8, from_utf8_lossy, parse_uint, split, str_builder, to_lower, Search}
import sysl.time.millis

// `sysl lsp`: the Language Server Protocol over standard input and output, answered by the compiler
// itself.
//
// **Every answer comes from the analysis a build makes**, not from a second reading of the language:
// a diagnostic is the one `sysl build` would print, a hover is the type the analyzer gave the name,
// and a definition is where the analyzer resolved it to (`definition_index.sysl`). What an editor
// holds and has not saved is read in place of the disk (`hold_editor_text`), so nothing is written
// anywhere for the server to read back.
//
// **A change is answered by analyzing again, whole.** The document is parsed first, so a syntax
// error is reported with its place; a file that parses is analyzed with the compilation it belongs
// to -- the package whose manifest is above it, or the file alone -- and the references that
// analysis recorded are kept for hover and definition until the next change.
//
// **Changes are coalesced, because an analysis can take longer than a keystroke.** The server reads
// every message already waiting before it analyzes anything, keeping only each document's latest
// text, and then waits a moment (`LspSettleMillis`) for a newer one; only a quiet input is analyzed.
// Nothing else waits: a request is answered in the order it came, and one that reads the analysis
// (hover, definition) has every held text analyzed first, so no answer is about an older text than
// the editor has sent. `didClose`, `shutdown` and `exit` are taken as they come, and a text still
// waiting at `shutdown` is never analyzed -- nothing is published after it.
//
// **An analysis is published in two tiers, and a newer text stops it.** What the program's own text
// says -- the parse, the declarations, every body it wrote -- is published as soon as it is known, and
// what the whole program decides -- instantiations, module storage evaluated, the whole-program checks
// such as `check_keeps` -- is merged in when it is (`EditorCheck`, `lsp_changed`); the second
// publication is exactly what a whole analysis says. A `didChange` arriving meanwhile stops the
// analysis at its next step, unpublished, and the newer text is analyzed instead.
//
// Positions are the protocol's: a line counted from zero and a character counted in UTF-16 code
// units, converted from the byte offsets the compiler keeps (`lsp_position`, `lsp_offset`).

// The JSON-RPC and protocol error codes the server answers with.
val LspParseError: int = -32700
val LspInvalidRequest: int = -32600
val LspMethodNotFound: int = -32601
val LspServerNotInitialized: int = -32002

// How long the input has to be quiet after a change before the change is analyzed: long enough to
// see the next keystroke of someone typing, short enough not to be noticed after the last one.
val LspSettleMillis: int = 120

// One document the editor has open: where it is, what it says, and what its last analysis found.
// `stale` is a text the editor sent that has not been analyzed yet (`lsp_settle`); its `references`
// are still the previous analysis's until it is.
struct LspDocument
    uri: string
    file: string
    text: string
    references: Buf[Reference]
    stale: bool
end LspDocument

// What the server remembers between messages.
struct LspServer
    initialized: bool
    shut_down: bool

    // Set by `exit`: the status the process ends with -- zero after a `shutdown`, one without.
    exit_code: Option[int]

    documents: Buf[LspDocument]

    // Every file whose last published list was not empty, with the compilation it was published for:
    // what has to be cleared when that compilation's next analysis finds nothing wrong there.
    published: Buf[LspPublished]

    // Every file's second-tier diagnostics as last published (`lsp_changed`).
    held: Buf[LspHeld]
end LspServer

// A file the server last published diagnostics for, and the compilation that found them (`lsp_root`).
struct LspPublished
    root: string
    uri: string
end LspPublished

lsp_server() -> LspServer = LspServer(false, false, None, buf(), buf(), buf())

// What a mistake in `sysl lsp` is answered with, and its line in `sysl --help`.
lsp_usage() -> string = "usage: sysl lsp [--stdio]"

// `sysl lsp [--stdio]`. The flag is what an editor's client library passes to say which transport it
// chose; standard input and output is the only one there is.
lsp_command(args: []string, note: string -> unit) -> int
    var mistakes: Buf[string] = buf()

    for i in 2..<args.len
        if args[i] == "--stdio" then continue

        if args[i].starts_with("-") then mistakes.push(unknown_option(args[i]))
        else mistakes.push(OptionLead + s"Unknown argument '${args[i]}'")

    if mistakes.len() > 0
        note(misused(mistakes, lsp_usage()))
        return Misused
    end if

    // The process analyzes on every change, and the standard module is the same each time.
    keep_std_units(true)

    var input = stdin()

    lsp_serve(&input, stdout(), note, ms -> lsp_arrives(input, ms))
end lsp_command

// Whether `r` has something to read -- a message, or its end -- within `ms` milliseconds. A
// descriptor that cannot be waited on counts as ready, so the read that follows reports what is
// wrong with it instead of the server waiting on it for ever.
lsp_arrives(r: FdReader, ms: int) -> bool = r.readable(millis(ms)).unwrap_or(true)

// Reads messages from `r` and writes the answers to `w` until `exit`, returning the status to end
// with. Input that ends without an `exit`, or a message whose framing cannot be read, ends the
// server with status one: past a broken header there is no telling where the next message starts.
//
// `arrives(ms)` says whether `r` will have something to read within `ms` milliseconds, which is how
// the server takes every message already waiting before it analyzes, and how it lets the input be
// quiet for `LspSettleMillis` after a change. A reader that cannot tell answers `false`: what is
// already read off it is still taken whole.
lsp_serve(r: *Reader, w: *Writer, note: string -> unit, arrives: int -> bool) -> int
    var server = lsp_server()
    var pending: Buf[u8] = buf()

    loop
        // The first message is waited for; every one after it is taken only while it is already here.
        var first = true

        while first || lsp_buffered(pending) || arrives(0)
            first = false

            val body = lsp_read(r, &pending) match
                Err(why) ->
                    note(refused(s"lsp: $why"))
                    return Failed
                Ok(None) -> return Failed
                Ok(Some(text)) -> text

            for out in lsp_take(&server, body)
                lsp_write(w, out)

            server.exit_code match
                Some(code) -> return code
                None -> ()

        // A change is analyzed once the input has been quiet; anything arriving meanwhile is read first.
        if !lsp_any_stale(server) || arrives(LspSettleMillis) then continue

        // Each publication is written as it is made, and a change arriving while the check runs
        // stops it (`lsp_change_waiting`): the loop goes back to read it, and analyzes that instead.
        lsp_settle_as_found(&server, m -> lsp_write(w, m), () -> lsp_change_waiting(r, &pending, arrives))
end lsp_serve

// Whether a message that makes the check in flight stale has arrived: a `didChange`, or the end of
// the session (`shutdown`, `exit`, the input ending). What is waiting is read into `pending` and left
// there, so the loop takes every message in the order it came; nothing is lost by looking.
private lsp_change_waiting(r: *Reader, pending: *Buf[u8], arrives: int -> bool) -> bool
    var chunk: [4096]u8 = [0; 4096]

    while arrives(0)
        val got = r.read(chunk)

        if got.len == 0 then return true

        for b in got do pending.push(b)

    lsp_supersedes_any(*pending)
end lsp_change_waiting

// Whether any whole message in `waiting` is one that makes a check in flight stale.
lsp_supersedes_any(waiting: Buf[u8]) -> bool
    var rest: Buf[u8] = buf()

    for b in waiting do rest.push(b)

    loop
        val head = lsp_header_end(rest) match
            Some(h) -> h
            None -> return false

        val need = lsp_content_length(from_utf8_lossy(rest.view()[0..<head])) match
            Ok(length) -> head + 4 + length
            Err(_) -> return false

        if rest.len() < need then return false

        val body = from_utf8_lossy(rest.view()[(head + 4)..<need])

        parse_json(body) match
            Ok(msg) -> json_text_at(msg, ["method"]) match
                Some(m) ->
                    if m == "textDocument/didChange" || m == "shutdown" || m == "exit" then return true
                None -> ()
            Err(_) -> ()

        var next: Buf[u8] = buf()

        for i in need..<rest.len()
            next.push(rest[i])

        rest = next
end lsp_supersedes_any

// Whether `pending` already holds one whole message, or a header too broken to wait on.
private lsp_buffered(pending: Buf[u8]) -> bool = lsp_header_end(pending) match
    None -> false
    Some(head) -> lsp_content_length(from_utf8_lossy(pending.view()[0..<head])) match
        Ok(length) -> pending.len() >= head + 4 + length
        Err(_) -> true

// One message framed as the protocol frames it: a `Content-Length` header, a blank line, the body.
lsp_frame(body: string) -> string = s"Content-Length: ${body.bytes.len}\r\n\r\n$body"

private lsp_write(w: *Writer, body: string)
    w.write(lsp_frame(body).bytes)
    flush()

// The next message's body, read off `r` past whatever `pending` already holds: `None` where the
// input ended cleanly between two messages.
lsp_read(r: *Reader, pending: *Buf[u8]) -> Result[Option[string], string]
    var chunk: [4096]u8 = [0; 4096]

    loop
        lsp_header_end(*pending) match
            Some(head) ->
                val length = lsp_content_length(from_utf8_lossy(pending.view()[0..<head]))?
                val need = head + 4 + length

                while pending.len() < need
                    val got = r.read(chunk)

                    if got.len == 0 then return Err("the input ended inside a message")

                    for b in got do pending.push(b)

                val body = from_utf8_lossy(pending.view()[(head + 4)..<need])
                var rest: Buf[u8] = buf()

                for i in need..<pending.len()
                    rest.push(pending[i])

                *pending = rest
                return Ok(Some(body))
            None -> ()

        val got = r.read(chunk)

        if got.len == 0
            if pending.len() == 0 then return Ok(None)

            return Err("the input ended inside a message's header")
        end if

        for b in got do pending.push(b)
end lsp_read

// Where the header block ends: the offset of the `\r\n\r\n` that closes it.
private lsp_header_end(b: Buf[u8]) -> Option[usize]
    if b.len() < 4 then return None

    for i in 0..(b.len() - 4)
        if b[i] == u8('\r') && b[i + 1] == u8('\n') && b[i + 2] == u8('\r') && b[i + 3] == u8('\n')
            return Some(i)

    None
end lsp_header_end

// The body's length, from the header block; the header's name is matched without regard to case.
private lsp_content_length(headers: string) -> Result[usize, string]
    for line in split(headers, "\r\n")
        val colon = line.index_of(":") match
            Some(c) -> c
            None -> continue

        if to_lower(line[0..<colon]) != "content-length" then continue

        return parse_uint(line[(colon + 1)..<line.bytes.len].trim()) match
            Ok(n) -> Ok(usize(n))
            Err(_) -> Err(s"'$line' is not a length")

    Err("a message with no Content-Length header")
end lsp_content_length

// What the server says to one message body, a change analyzed at once: the response to a request,
// and any notification the message caused -- in the order they are to be written.
lsp_answer(server: *LspServer, body: string) -> Buf[string]
    var out = lsp_take(server, body)

    for m in lsp_settle(server)
        out.push(m)

    out
end lsp_answer

// The same with a change only held (`lsp_hold`), to be analyzed by the next `lsp_settle`.
lsp_take(server: *LspServer, body: string) -> Buf[string]
    var out: Buf[string] = buf()

    val msg = parse_json(body) match
        Err(why) ->
            out.push(lsp_error(Json.Null, LspParseError, s"the message is not JSON: $why"))
            return out
        Ok(m) -> m

    val id = msg.get("id")

    val method = json_text_at(msg, ["method"]) match
        Some(m) -> m
        None ->
            // A response to something the server asked is the one message with no method, and the
            // server asks nothing.
            if id.is_none() || (msg.get("result").is_none() && msg.get("error").is_none())
                out.push(lsp_error(id.unwrap_or(Json.Null), LspInvalidRequest, "a request names a method"))
            return out

    // A notification has no id and is never answered, an unknown one included.
    val asked = id match
        Some(i) -> i
        None ->
            lsp_notified(server,method, msg, &out)
            return out

    if method != "initialize" && !server.initialized
        out.push(lsp_error(asked, LspServerNotInitialized, s"'$method' before 'initialize'"))
        return out
    end if

    if server.shut_down
        out.push(lsp_error(asked, LspInvalidRequest, s"'$method' after 'shutdown'"))
        return out
    end if

    val params = msg.get("params").unwrap_or(Json.Null)

    // An answer read off an analysis is about the text the editor sent last.
    if method == "textDocument/hover" || method == "textDocument/definition"
        for m in lsp_settle(server)
            out.push(m)

    out.push(method match
        "initialize" ->
            server.initialized = true
            lsp_result(asked, lsp_capabilities())
        "shutdown" ->
            server.shut_down = true
            lsp_result(asked, Json.Null)
        "textDocument/hover" -> lsp_result(asked, lsp_hover(*server,params))
        "textDocument/definition" -> lsp_result(asked, lsp_definition(*server,params))
        _ -> lsp_error(asked, LspMethodNotFound, s"'$method' is not a method sysl lsp answers"))

    out
end lsp_take

// A notification: what it changes, and what a document's closing publishes.
private lsp_notified(server: *LspServer, method: string, msg: Json, out: *Buf[string])
    if method == "exit"
        server.exit_code = Some(if server.shut_down then Fine else Failed)
        return
    end if

    if !server.initialized || server.shut_down then return

    val params = msg.get("params").unwrap_or(Json.Null)
    val uri =json_text_at(params, ["textDocument", "uri"]).unwrap_or("")

    if uri == "" then return

    if method == "textDocument/didOpen"
        json_text_at(params, ["textDocument", "text"]) match
            Some(text) -> lsp_hold(server, uri, text)
            None -> ()
    else if method == "textDocument/didChange"
        // Full synchronization: every change carries the whole text, and the last is what it says now.
        params.get("contentChanges") match
            Some(changes) -> changes match
                Json.Arr(items) ->
                    if items.len() > 0
                        json_text_at(items[items.len() - 1], ["text"]) match
                            Some(text) -> lsp_hold(server, uri, text)
                            None -> ()
                    end if
                _ -> ()
            None -> ()
    else if method == "textDocument/didClose"
        release_editor_text(lsp_uri_file(uri))
        lsp_release_held(server, lsp_uri_file(uri))
        lsp_forget(server,uri)
        lsp_unpublish(server, uri)
        out.push(lsp_publish(uri, buf()))
end lsp_notified

// The capabilities the server announces: full-text synchronization, hover and definition, with
// positions counted in UTF-16, which is the protocol's default and what every client speaks.
private lsp_capabilities() -> Json
    var caps: Buf[JsonMember] = buf()

    json_put(&caps, "positionEncoding", Json.Str("utf-16"))
    json_put(&caps, "textDocumentSync", Json.Int(1))
    json_put(&caps, "hoverProvider", Json.Bool(true))
    json_put(&caps, "definitionProvider", Json.Bool(true))

    var info: Buf[JsonMember] = buf()

    json_put(&info, "name", Json.Str("sysl"))
    json_put(&info, "version", Json.Str(Version))

    var out: Buf[JsonMember] = buf()

    json_put(&out, "capabilities", Json.Obj(caps))
    json_put(&out, "serverInfo", Json.Obj(info))
    Json.Obj(out)
end lsp_capabilities

private lsp_result(id: Json, result: Json) -> string
    var out: Buf[JsonMember] = buf()

    json_put(&out, "jsonrpc", Json.Str("2.0"))
    json_put(&out, "id", id)
    json_put(&out, "result", result)
    Json.Obj(out).to_string()
end lsp_result

private lsp_error(id: Json, code: int, message: string) -> string
    var err: Buf[JsonMember] = buf()

    json_put(&err, "code", Json.Int(long(code)))
    json_put(&err, "message", Json.Str(message))

    var out: Buf[JsonMember] = buf()

    json_put(&out, "jsonrpc", Json.Str("2.0"))
    json_put(&out, "id", id)
    json_put(&out, "error", Json.Obj(err))
    Json.Obj(out).to_string()
end lsp_error

// `textDocument/publishDiagnostics` for one document.
private lsp_publish(uri: string, diagnostics: Buf[Json]) -> string
    var params: Buf[JsonMember] = buf()

    json_put(&params, "uri", Json.Str(uri))
    json_put(&params, "diagnostics", Json.Arr(diagnostics))

    var out: Buf[JsonMember] = buf()

    json_put(&out, "jsonrpc", Json.Str("2.0"))
    json_put(&out, "method", Json.Str("textDocument/publishDiagnostics"))
    json_put(&out, "params", Json.Obj(params))
    Json.Obj(out).to_string()
end lsp_publish

// One member onto an object being built.
json_put(members: *Buf[JsonMember], key: string, v: Json) = members.push(JsonMember(key, v))

// The member under each key in turn: `json_at(m, ["params", "textDocument", "uri"])`.
json_at(j: Json, keys: []const string) -> Option[Json]
    var here = j

    for key in keys
        here = here.get(key) match
            Some(v) -> v
            None -> return None

    Some(here)
end json_at

// The string at `keys`, where a string is there.
json_text_at(j: Json, keys: []const string) -> Option[string] = json_at(j, keys).and_then(v -> v.as_str())

// The integer at `keys`, where one is there and fits an `int`.
json_int_at(j: Json, keys: []const string) -> Option[int]
    json_at(j, keys).and_then(v -> v.as_int()) match
        Some(n) -> if n >= -2147483648 && n <= 2147483647 then Some(int(n)) else None
        None -> None
end json_int_at

// A document's new text: held in place of the disk and remembered, to be analyzed by the next
// `lsp_settle`. A later text for the same document replaces it, so only the last is ever analyzed.
private lsp_hold(server: *LspServer, uri: string, text: string)
    val file = lsp_uri_file(uri)

    hold_editor_text(file, text)
    lsp_release_held(server, file)
    lsp_forget(server, uri)
    server.documents.push(LspDocument(uri, file, text, buf(), true))
end lsp_hold

// Whether any document holds a text not yet analyzed.
private lsp_any_stale(server: LspServer) -> bool
    for d in server.documents
        if d.stale then return true

    false
end lsp_any_stale

// Every held text analyzed, in the order the documents last changed, and what that publishes. After
// `shutdown` nothing is: the client has stopped listening for diagnostics.
lsp_settle(server: *LspServer) -> Buf[string]
    var out: Buf[string] = buf()

    lsp_settle_as_found(server, m -> out.push(m), () -> false)
    out
end lsp_settle

// The same, with each publication handed to `emit` as soon as it is made -- a check's first tier
// before its second is done -- and `superseded` asked between the check's steps whether a newer text
// has arrived. Where it has, the check stops, its document stays waiting, and nothing more is
// analyzed: the answer is false, and the caller reads the input before settling again.
lsp_settle_as_found(server: *LspServer, emit: string -> unit, superseded: () -> bool) -> bool
    if server.shut_down then return true

    var waiting: Buf[string] = buf()

    for d in server.documents
        if d.stale then waiting.push(d.uri)

    for uri in waiting
        if !lsp_changed(server, uri, emit, superseded) then return false

    true
end lsp_settle_as_found

// A held document analyzed, remembered, and the diagnostics published -- the document's own first,
// then every other file the analysis found something wrong in, then an empty list for each file this
// compilation had published for and no longer finds anything wrong in. False where the check was
// told to stop (`lsp_settle_as_found`), which leaves the document waiting.
//
// **The publication comes twice**: once when the check's first tier is done -- the program's own
// text -- and again when the whole check is. **A file's second-tier diagnostics stay up across the
// first publication** (`LspHeld`) while the text they were found in is unchanged, so a keeps refusal
// in one file does not blink out while another is edited; the second publication is the whole
// check's own, exactly what a check from nothing says. **A list the second publication would send
// exactly as the first sent it is not sent again**, so a check whose whole program adds nothing is
// one publication, as it was before there were tiers.
private lsp_changed(server: *LspServer, uri: string, emit: string -> unit, superseded: () -> bool) -> bool
    val text = lsp_document(*server, uri) match
        Some(d) -> d.text
        None -> return true

    val file = lsp_uri_file(uri)
    // What the first tier found, kept to tell the second tier's own diagnostics from it, and what its
    // publication sent.
    var first: Buf[LspFound] = buf()
    var sent: Buf[string] = buf()

    val tell_first = (found: Buf[LspFound], root: string) ->
        for f in found do first.push(f)

        lsp_published(server, uri, file, lsp_with_held(*server, root, found), true, root, emit, buf(), sent)

    val done = lsp_analyze_in_tiers(file, text, tell_first, superseded)

    if done.abandoned then return false

    lsp_forget(server, uri)
    server.documents.push(LspDocument(uri, file, text, done.references, false))

    if done.whole then lsp_hold_second_tier(server, done.root, done.found, first)

    lsp_published(server, uri, file, done.found, done.whole, done.root, emit, sent, buf())
    true
end lsp_changed

// `found` published as what the compilation at `root` says now, and remembered (`published`). A
// message among `told` -- sent already, by this check's first tier -- is not sent again; every message
// this publication makes is pushed onto `sent`.
private lsp_published(server: *LspServer, uri: string, file: string, found: Buf[LspFound], whole: bool,
                      root: string, emit: string -> unit, told: Buf[string], sent: Buf[string])
    var now: Buf[LspPublished] = buf()

    val send = (m: string) ->
        var already = false

        for t in told
            if t == m then already = true

        if !already then emit(m)

        sent.push(m)

    for f in found
        val there = if absolute_path(f.file) == absolute_path(file) then uri else lsp_uri_of(*server, f.file)

        send(lsp_publish(there, f.diagnostics))

        if f.diagnostics.len() > 0 then now.push(LspPublished(root, there))

    // A file is cleared only by an analysis that read it: a syntax error stops before the rest of
    // the compilation is read, so what was published for the other files stands.
    var kept: Buf[LspPublished] = buf()

    for p in server.published
        var still = p.uri == uri

        for n in now
            if n.uri == p.uri then still = true

        if still then continue

        if p.root == root && whole
            send(lsp_publish(p.uri, buf()))
        else
            kept.push(p)

    for n in now
        kept.push(n)

    server.published = kept
end lsp_published

// A file's diagnostics from a check's second tier, as last published, and the compilation that found
// them: what the next check's first publication keeps up for the file while its text is unchanged.
struct LspHeld
    root: string
    file: string
    diagnostics: Buf[Json]
end LspHeld

// `found` with the second-tier diagnostics held for the compilation at `root` added, file by file.
// Nothing in `found` is written to.
private lsp_with_held(server: LspServer, root: string, found: Buf[LspFound]) -> Buf[LspFound]
    var out: Buf[LspFound] = buf()

    for f in found
        var ds: Buf[Json] = buf()

        for d in f.diagnostics do ds.push(d)

        out.push(LspFound(f.file, ds))

    for h in server.held
        if h.root != root then continue

        var k: usize = 0

        while k < out.len() && out[k].file != h.file
            k += 1

        if k == out.len() then out.push(LspFound(h.file, buf()))

        for d in h.diagnostics do out[k].diagnostics.push(d)

    out
end lsp_with_held

// What a completed check at `root` found beyond its first tier, held in place of what the last one
// at `root` held. A check whose first tier was never told -- one that stopped before it -- holds
// nothing, since nothing it found is the second tier's alone.
private lsp_hold_second_tier(server: *LspServer, root: string, found: Buf[LspFound], first: Buf[LspFound])
    var kept: Buf[LspHeld] = buf()

    for h in server.held
        if h.root != root then kept.push(h)

    if !first.is_empty()
        for f in found
            var only: Buf[Json] = buf()

            for d in f.diagnostics
                if !lsp_said_in(first, f.file, d) then only.push(d)

            if !only.is_empty() then kept.push(LspHeld(root, f.file, only))
    end if

    server.held = kept
end lsp_hold_second_tier

// Whether `d` is among what `found` says about `file`.
private lsp_said_in(found: Buf[LspFound], file: string, d: Json) -> bool
    val shown = d.to_string()

    for f in found
        if f.file != file then continue

        for e in f.diagnostics
            if e.to_string() == shown then return true

    false
end lsp_said_in

// A file's held second-tier diagnostics let go: its text has changed, so they are about a text that
// is no longer there.
private lsp_release_held(server: *LspServer, file: string)
    val whole = absolute_path(file)
    var kept: Buf[LspHeld] = buf()

    for h in server.held
        if h.file != whole then kept.push(h)

    server.held = kept
end lsp_release_held

// What one file is told: where it is on disk, and its diagnostics.
struct LspFound
    file: string
    diagnostics: Buf[Json]
end LspFound

// The URI a file is published under: the one the editor opened it by where it is open, so that a
// file has one list whichever analysis found its mistakes.
private lsp_uri_of(server: LspServer, file: string) -> string
    for d in server.documents
        if absolute_path(d.file) == absolute_path(file) then return d.uri

    lsp_file_uri(file)

private lsp_unpublish(server: *LspServer, uri: string)
    var kept: Buf[LspPublished] = buf()

    for p in server.published
        if p.uri != uri then kept.push(p)

    server.published = kept
end lsp_unpublish

private lsp_forget(server: *LspServer, uri: string)
    var kept: Buf[LspDocument] = buf()

    for d in server.documents
        if d.uri != uri then kept.push(d)

    server.documents = kept
end lsp_forget

private lsp_document(server: LspServer, uri: string) -> Option[LspDocument]
    for d in server.documents
        if d.uri == uri then return Some(d)

    None

// The diagnostics an analysis of `file` found, file by file with `file`'s own first; the references
// it recorded; whether it read the whole compilation; and which compilation that is (`lsp_root`).
//
// **A syntax error stops at the parse**, as a build does, and is reported where it is -- the first
// on each line, as `parse_report` shows them. A file that parses is analyzed with the compilation it
// belongs to (`lsp_root`), and every file that analysis found something wrong in is answered for --
// a sibling in the package, or a library file, named where it is on disk. A compilation that cannot
// be assembled at all -- no standard library, an unreadable manifest -- is said once, at the top of
// the file.
lsp_analyze(file: string, text: string) -> (Buf[LspFound], Buf[Reference], bool, string)
    val done = lsp_analyze_in_tiers(file, text, (_, _) -> (), () -> false)

    (done.found, done.references, done.whole, done.root)
end lsp_analyze

// What an editor's check of a file came to (`lsp_analyze_in_tiers`).
struct LspChecked
    found: Buf[LspFound]
    references: Buf[Reference]
    whole: bool
    root: string

    // That the check was told to stop before it was done, so `found` is not its answer.
    abandoned: bool
end LspChecked

// `lsp_analyze`, in the two tiers an editor's check comes in (`EditorCheck`): `first` is told the
// first tier's diagnostics, file by file, and the compilation's root, as soon as they are found; and
// `superseded` is asked between steps whether the text has changed, which stops the check. A syntax
// error, or a compilation that cannot be assembled, has no tiers: nothing is told to `first`.
lsp_analyze_in_tiers(file: string, text: string, first: (Buf[LspFound], string) -> unit,
                     superseded: () -> bool) -> LspChecked
    var found: Buf[LspFound] = buf()
    val src = source(file, text.bytes)
    val parsed = parse(src)

    // Every file is named as it is made absolute and normalized, so a URI spelled `…/T//x` and a
    // problem placed in `…/T/x` are one file.
    found.push(LspFound(absolute_path(file), buf()))

    if !parsed.ok()
        var last_line: usize = 0

        for i in 0..<parsed.report.len()
            val d = parsed.report.at(i)
            val line = src.locate(d.span.start).line

            if i > 0 && line <= last_line then continue

            last_line = line
            found[0].diagnostics.push(lsp_diagnostic(src, d.span, d.severity, d.message))

        return LspChecked(found, buf(), false, lsp_root(file), false)
    end if

    val root = lsp_root(file, module_written(parsed.program))
    val in_std = lsp_std_dir() == Some(root)
    val editor = editor_check(ds -> first(lsp_found_in(file, ds), root), () -> superseded())

    (if in_std then indexed_std(root, Some(editor)) else indexed_file(root, Some(editor))) match
        Err(failure) ->
            found[0].diagnostics.push(lsp_diagnostic(src, Span(0, 0), Error, failure.message))
            LspChecked(found, buf(), false, root, false)
        Ok(ix) ->
            if editor.abandoned then return LspChecked(found, buf(), false, root, true)

            found = lsp_found_in(file, ix.problems)

            if !in_std then return LspChecked(found, ix.references, true, root, false)

            // The library's files are named `library/…` (`StdPrefix`) whatever they were read from;
            // the document's own references are filed back under the file the editor opened.
            val whole_file = absolute_path(file)
            val named = StdPrefix + whole_file[root.bytes.len..<whole_file.bytes.len]
            var mine: Buf[Reference] = buf()

            for r in ix.references
                if r.at_file == named then mine.push(r with { at_file = file })

            LspChecked(found, mine, true, root, false)
end lsp_analyze_in_tiers

// An analysis's diagnostics file by file, with `file`'s own first whether or not it has any -- each
// file named where it is on disk, absolute and normalized.
private lsp_found_in(file: string, problems: Buf[Placed]) -> Buf[LspFound]
    var found: Buf[LspFound] = buf()

    found.push(LspFound(absolute_path(file), buf()))

    for p in problems
        val there = absolute_path(lsp_on_disk(p.src.name))
        val at = if p.at_place then p.diag.span else Span(0, 0)
        var k: usize = 0

        while k < found.len() && found[k].file != there
            k += 1

        if k == found.len() then found.push(LspFound(there, buf()))

        found[k].diagnostics.push(lsp_diagnostic(p.src, at, p.diag.severity, p.diag.message))

    found
end lsp_found_in

// The standard library's root, absolute, where there is one.
private lsp_std_dir() -> Option[string] = std_root() match
    Ok(dir) -> Some(absolute_path(dir))
    Err(_) -> None

// What a file is compiled as, given the module its header `declared` (`""` for none):
//
// - **a file of the standard library is checked as `--std` checks it**, with the library alone, which
//   is the library's root -- the library has no manifest, and is not a package;
// - otherwise the package whose manifest is nearest above it;
// - otherwise, where the file sits where its module's name says, the directory that name is a path
//   below -- a source root, which a `--lib` hands to a compilation -- read as a project;
// - otherwise the file alone.
lsp_root(file: string, declared: string = "") -> string
    val whole_file = absolute_path(file)

    lsp_std_dir() match
        Some(dir) -> if whole_file.starts_with(dir + "/") then return dir
        None -> ()

    var here = parent_of(file)

    while here.is_some() && here.unwrap() != ""
        val dir = here.unwrap()

        if is_file(manifest_file(dir)) then return dir

        val up = parent_of(dir)

        if up.is_some() && up.unwrap() == dir then break

        here = up

    if declared == "" then return file

    // The directory each segment of the name is, innermost first, back to the root above them.
    var dir = parent_of(whole_file).unwrap_or("")
    val segments = split(declared, ".")
    var k = segments.len

    while k > 0
        k -= 1

        if dir == "" || basename(dir) != segments[k] then return file

        dir = parent_of(dir).unwrap_or("")

    if dir == "" then file else dir
end lsp_root

private lsp_diagnostic(src: Source, at: Span, severity: Severity, message: string) -> Json
    var out: Buf[JsonMember] = buf()

    json_put(&out, "range", lsp_range(src, at))
    json_put(&out, "severity", Json.Int(lsp_severity(severity)))
    json_put(&out, "source", Json.Str("sysl"))
    json_put(&out, "message", Json.Str(message))
    Json.Obj(out)
end lsp_diagnostic

private lsp_severity(severity: Severity) -> long = severity match
    Error -> 1
    Warning -> 2
    Note -> 3
    Help -> 4

lsp_range(src: Source, at: Span) -> Json
    var out: Buf[JsonMember] = buf()

    json_put(&out, "start", lsp_position(src, at.start))
    json_put(&out, "end", lsp_position(src, if at.end > at.start then at.end else at.start))
    Json.Obj(out)
end lsp_range

// The protocol's position of a byte offset: the line from zero, and the character as the UTF-16 code
// units before it on its line -- one for each character, two for one outside the Basic Multilingual
// Plane, which is the one whose UTF-8 lead byte is `0xF0` or above.
lsp_position(src: Source, offset: usize) -> Json
    val at = if offset > src.bytes.len then src.bytes.len else offset
    val line = src.locate(at).line
    var units = 0

    for i in src.starts[line - 1]..<at
        val b = src.bytes[i]

        if (b & 0xC0) != 0x80 then units += if b >= 0xF0 then 2 else 1

    var out: Buf[JsonMember] = buf()

    json_put(&out, "line", Json.Int(long(line - 1)))
    json_put(&out, "character", Json.Int(long(units)))
    Json.Obj(out)
end lsp_position

// The byte offset of a protocol position: `lsp_position` turned around. A character past the end of
// its line is the line's end, and a line past the end of the file is the file's end, as the protocol
// asks.
lsp_offset(src: Source, line: int, character: int) -> usize
    if line < 0 then return 0

    if usize(line) >= src.line_count() then return src.bytes.len

    var at = src.starts[usize(line)]
    var units = 0

    while at < src.bytes.len && src.bytes[at] != u8('\n') && units < character
        val b = src.bytes[at]
        val width: usize = if b < 0x80 then 1 else if b < 0xE0 then 2 else if b < 0xF0 then 3 else 4

        units += if width == 4 then 2 else 1
        at += width

    if at > src.bytes.len then src.bytes.len else at
end lsp_offset

// The reference written at `offset` in a document -- the smallest one covering it, so that a cursor
// on an argument is on the argument and not the call around it. A cursor just past a name's last
// character is on that name too, as editors place a cursor after the word it was typed into.
private lsp_reference_at(d: LspDocument, offset: usize) -> Option[Reference]
    var best: Option[Reference] = None

    for pass in 0..<2
        if pass == 1 && (best.is_some() || offset == 0) then break

        val at = if pass == 0 then offset else offset - 1

        for r in d.references
            if r.at_file != d.file || at < r.at_span.start || at >= r.at_span.end then continue

            best = best match
                Some(b) -> if r.at_span.len() < b.at_span.len() then Some(r) else Some(b)
                None -> Some(r)

    best
end lsp_reference_at

// The document and offset a `textDocument/*` request's `params` point at.
private lsp_point(server: LspServer, params: Json) -> Option[(LspDocument, usize)]
    val uri = json_text_at(params, ["textDocument", "uri"]).unwrap_or("")

    val d = lsp_document(server,uri) match
        Some(d) -> d
        None -> return None

    val line = json_int_at(params, ["position", "line"]).unwrap_or(0)
    val character = json_int_at(params, ["position", "character"]).unwrap_or(0)

    Some((d, lsp_offset(source(d.file, d.text.bytes), line, character)))
end lsp_point

// `textDocument/hover`: what the analyzer knew about the name under the cursor, as a sysl code block.
lsp_hover(server: LspServer, params: Json) -> Json
    val (d, offset) = lsp_point(server,params) match
        Some(p) -> p
        None -> return Json.Null

    val r = lsp_reference_at(d, offset) match
        Some(r) -> r
        None -> return Json.Null

    val shown = if r.detail == "" then r.name else r.detail
    var contents: Buf[JsonMember] = buf()

    json_put(&contents, "kind", Json.Str("markdown"))
    json_put(&contents, "value", Json.Str(s"```sysl\n$shown\n```"))

    var out: Buf[JsonMember] = buf()

    json_put(&out, "contents", Json.Obj(contents))
    json_put(&out, "range", lsp_range(source(d.file, d.text.bytes), r.at_span))
    Json.Obj(out)
end lsp_hover

// `textDocument/definition`: where the name under the cursor was declared, its range the declared
// name itself where the declaration spells it.
lsp_definition(server: LspServer, params: Json) -> Json
    val (d, offset) = lsp_point(server,params) match
        Some(p) -> p
        None -> return Json.Null

    val r = lsp_reference_at(d, offset) match
        Some(r) -> r
        None -> return Json.Null

    val file = lsp_on_disk(r.declared_file)
    val text = if file == d.file then d.text else lsp_file_text(file)
    val src = source(file, text.bytes)
    val uri = if file == d.file then d.uri else lsp_file_uri(file)
    var out: Buf[JsonMember] = buf()

    json_put(&out, "uri", Json.Str(uri))
    json_put(&out, "range", lsp_range(src, lsp_name_in(text, r.declared_span, last_segment(r.name))))
    Json.Obj(out)
end lsp_definition

// Where a file the compilation named is on disk. **A library file is named `library/sysl/…`**
// whatever it was read from (`StdPrefix`), which a diagnostic wants and an editor cannot open, so it
// is found again under the library's own root.
lsp_on_disk(file: string) -> string
    if !file.starts_with(s"$StdPrefix/") then return file

    std_root() match
        Ok(root) -> absolute_path(root + file[StdPrefix.bytes.len..<file.bytes.len])
        Err(_) -> file
end lsp_on_disk

// What a file says: an editor's text where it holds one, the disk's otherwise.
private lsp_file_text(file: string) -> string
    editor_text(file) match
        Some(t) -> return t
        None -> ()

    read_bytes(file) match
        Ok(bytes) -> from_utf8_lossy(bytes.view())
        Err(_) -> ""
end lsp_file_text

// A name's last dotted segment, which is how its declaration spells it.
private last_segment(name: string) -> string
    var cut: usize = 0

    for i in 0..<name.bytes.len
        if name.bytes[i] == u8('.') then cut = i + 1

    name[cut..<name.bytes.len]
end last_segment

// Where a declaration spanning `declared` spells `name`: its first occurrence there as a whole word,
// or the declaration's first character where it spells it nowhere.
lsp_name_in(text: string, declared: Span, name: string) -> Span
    val limit = if declared.end > text.bytes.len then text.bytes.len else declared.end
    val n = name.bytes.len

    if n == 0 || declared.start + n > limit then return Span(declared.start, declared.start)

    for i in declared.start..(limit - n)
        if text.bytes[i] != name.bytes[0] then continue

        if text[i..<(i + n)] != name then continue

        val before_ok = i == 0 || !lsp_word_byte(text.bytes[i - 1])
        val after_ok = i + n >= text.bytes.len || !lsp_word_byte(text.bytes[i + n])

        if before_ok && after_ok then return Span(i, i + n)

    Span(declared.start, declared.start)
end lsp_name_in

lsp_word_byte(c: u8) -> bool =
    (c >= u8('a') && c <= u8('z')) || (c >= u8('A') && c <= u8('Z')) || (c >= u8('0') && c <= u8('9')) ||
    c == u8('_') || c >= 0x80

// The file a `file://` URI names, its percent-escapes decoded. Anything else is taken as a path.
lsp_uri_file(uri: string) -> string
    if !uri.starts_with("file://") then return uri

    var out: Buf[u8] = buf()
    val b = uri.bytes
    var i: usize = 7

    while i < b.len
        if b[i] == u8('%') && i + 2 < b.len && lsp_hex(b[i + 1]).is_some() && lsp_hex(b[i + 2]).is_some()
            out.push(lsp_hex(b[i + 1]).unwrap() * 16 + lsp_hex(b[i + 2]).unwrap())
            i += 3
        else
            out.push(b[i])
            i += 1

    from_utf8(out.view()).unwrap_or(uri[7..<uri.bytes.len])
end lsp_uri_file

private lsp_hex(c: u8) -> Option[u8] =
    if c >= u8('0') && c <= u8('9') then Some(c - u8('0'))
    else if c >= u8('a') && c <= u8('f') then Some(c - u8('a') + 10)
    else if c >= u8('A') && c <= u8('F') then Some(c - u8('A') + 10)
    else None

// The `file://` URI of an absolute path: every byte but an unreserved one or a `/` percent-escaped.
lsp_file_uri(file: string) -> string
    val hex = "0123456789ABCDEF"
    var out = str_builder()

    out.push("file://")

    for c in file.bytes
        if lsp_unreserved(c) then out.push_char(char(c))
        else
            val hi = usize(c >> 4)
            val lo = usize(c & 15)

            out.push(s"%${hex[hi..<(hi + 1)]}${hex[lo..<(lo + 1)]}")

    out.finish()
end lsp_file_uri

private lsp_unreserved(c: u8) -> bool =
    (c >= u8('a') && c <= u8('z')) || (c >= u8('A') && c <= u8('Z')) || (c >= u8('0') && c <= u8('9')) ||
    c == u8('-') || c == u8('.') || c == u8('_') || c == u8('~') || c == u8('/')
