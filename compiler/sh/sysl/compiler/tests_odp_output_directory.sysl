module sh.sysl.compiler
@tests

import sysl.fs.{exists, is_file, write_text}
import sysl.text.Search

// **`build -o` makes the directory of its output**, as `build-c` makes its archive's. Left to the
// toolchain a missing directory failed as clang's error, naming an unrelated dependency's object
// file. A file standing where the directory is needed is refused before anything is compiled, naming
// that file.

private odp_program() -> string = "main()\n    print(1)\n"

private odp_project() -> string = lbr_program(odp_program())

private odp_cli(args: []string) -> (int, string) = lbr_cli(args)

@test("odp: build -o into a directory that does not exist makes it and builds")
odp_build_missing_directory()
    if !lbr_ready() then return

    val p = odp_project()
    val base = lbr_temp("sysl-odp")
    val got = odp_cli(["sysl", "build", "-o", s"$base/nope/program", p])

    assert_eq(got.0, Fine)
    assert(is_directory(s"$base/nope"), got.1)
    assert(exists(s"$base/nope/program"), got.1)
    lbr_drop([p, base])
end odp_build_missing_directory

@test("odp: a missing directory several levels deep is made whole")
odp_build_missing_nested()
    if !lbr_ready() then return

    val p = odp_project()
    val base = lbr_temp("sysl-odp")
    val got = odp_cli(["sysl", "build", "-o", s"$base/a/b/c/program", p])

    assert_eq(got.0, Fine)
    assert(exists(s"$base/a/b/c/program"), got.1)
    lbr_drop([p, base])
end odp_build_missing_nested

@test("odp: a parent that is a regular file is refused, naming it, before compiling")
odp_build_parent_is_a_file()
    if !lbr_ready() then return

    val p = odp_project()
    val base = lbr_temp("sysl-odp")

    write_text(s"$base/plain", "x").unwrap()

    val got = odp_cli(["sysl", "build", "-o", s"$base/plain/program", p])

    assert_eq(got.0, Failed)
    assert_eq(got.1, s"sysl: error: cannot make the directory '$base/plain': " +
                     "a file is already there, and a directory is needed")
    assert(is_file(s"$base/plain"), "the file must be left alone")
    lbr_drop([p, base])
end odp_build_parent_is_a_file

@test("odp: a file further up the way is the one named")
odp_build_file_higher_up()
    if !lbr_ready() then return

    val p = odp_project()
    val base = lbr_temp("sysl-odp")

    write_text(s"$base/plain", "x").unwrap()

    val got = odp_cli(["sysl", "build", "-o", s"$base/plain/deeper/program", p])

    assert_eq(got.0, Failed)
    assert(got.1.contains(s"'$base/plain'"), got.1)
    lbr_drop([p, base])
end odp_build_file_higher_up

@test("odp: a program with a library beside it never gets a dependency's file named")
odp_build_with_dependency()
    if !lbr_ready() then return

    val p = lbr_project(lbr_two("main.sysl", "print(odp_dep.one())\n",
                                "odp_dep/lib.sysl", "module odp_dep\n\none() -> int = 1\n"))
    val base = lbr_temp("sysl-odp")
    write_text(s"$base/plain", "x").unwrap()

    val refused = odp_cli(["sysl", "build", "-o", s"$base/plain/program", p])

    assert_eq(refused.0, Failed)
    assert(refused.1.contains("cannot make the directory"), refused.1)
    assert(!refused.1.contains(".o"), refused.1)

    val made = odp_cli(["sysl", "build", "-o", s"$base/fresh/program", p])

    assert_eq(made.0, Fine)
    assert(exists(s"$base/fresh/program"), made.1)
    lbr_drop([p, base])
end odp_build_with_dependency

@test("odp: an existing directory still builds")
odp_build_existing_directory()
    if !lbr_ready() then return

    val p = odp_project()
    val base = lbr_temp("sysl-odp")
    val got = odp_cli(["sysl", "build", "-o", s"$base/program", p])

    assert_eq(got.0, Fine)
    assert(exists(s"$base/program"), got.1)
    lbr_drop([p, base])
end odp_build_existing_directory

@test("odp: a bare name, a ./ name and none need nothing made")
odp_bare_names_pass()
    assert(make_output_directory(Some("x")).is_ok())
    assert(make_output_directory(Some("./x")).is_ok())
    assert(make_output_directory(None).is_ok())
    assert(make_output_directory(Some("/x")).is_ok())
end odp_bare_names_pass
