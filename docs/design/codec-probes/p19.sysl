// P19: a receiverless member reached through a field's type, and a partly written type-argument list
trait Make
    make(n: int) -> Self

impl Make for int
    make(n: int) -> int = n

make_as[V: Make, S](n: int, s: S) -> V = V.make(n)

struct P
    x: int

for const f in P::Fields
    print(f::Type.make(1))
    print(make_as[f::Type](1, "s"))
