// p15: a trait default named `count` on a cursor that has a field named `count` -- what adding
// adapters to an existing trait does to the types that already implement it.
trait It
    type Item
    next(*self) -> Option[Self::Item]

    count(self) -> int
        var n = 0
        var cur = self
        loop
            cur.next() match
                Some(_) -> n += 1
                None -> break
        n
    end count

struct Upto
    count: int
    stop: int

impl It for Upto
    type Item = int
    next(*self) -> Option[int]
        if self.count >= self.stop then return None
        self.count += 1
        Some(self.count)

main()
    print(Upto(0, 3).count())
