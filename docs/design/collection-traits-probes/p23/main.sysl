// p23: collect, return-type driven, as a free function -- the target picks the implementation.
import sysl.buf.{Buf, buf}
import sysl.container.{List, list}

trait It
    type Item
    next(*self) -> Option[Self::Item]

trait FromIt[E]
    from_it[I: It[Item = E]](it: I) -> Self

impl[X] FromIt[X] for Buf[X]
    from_it[I: It[Item = X]](it: I) -> Buf[X]
        var out: Buf[X] = buf()
        var cur = it
        loop
            cur.next() match
                Some(x) -> out.push(x)
                None -> break
        out
    end from_it

impl[X] FromIt[X] for List[X]
    from_it[I: It[Item = X]](it: I) -> List[X]
        var out: List[X] = list()
        var cur = it
        loop
            cur.next() match
                Some(x) -> out = out.prepend(x)
                None -> break
        out.reverse()
    end from_it

collect[C: FromIt[I::Item], I: It](it: I) -> C = C.from_it(it)

struct Count
    n: int
    stop: int

impl It for Count
    type Item = int
    next(*self) -> Option[int]
        if self.n >= self.stop then return None
        val v = self.n
        self.n += 1
        Some(v)

main()
    val b: Buf[int] = collect(Count(0, 4))
    val l: List[int] = collect(Count(5, 8))
    print(b.len(), b[3], l.len(), l.first().unwrap())
    print(collect[Buf[int], Count](Count(0, 3)).len())
