module sh.sysl.compiler

import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}

// What a module says it needs of a machine, and what it gives up in exchange.
//
// **A capability is a property of the MODULE**, not of a file and not of a declaration, so every
// file of a module states the same clauses and its `@tests` files state one thing between them. What
// a clause leaves behind is the module's two sets -- what it requires, and what it narrowed away --
// and it is those the rest of the compiler asks.

const CapHeap: string = "heap"
const CapOs: string = "os"
const CapPosix: string = "posix"

// The capabilities there are, in the order a refusal lists them.
capability_core() -> Buf[string]
    var out: Buf[string] = buf()

    out.push(CapHeap)
    out.push(CapOs)
    out.push(CapPosix)
    out
end capability_core

// **The two directions are asked of different vocabularies.** A `requires` names a FACILITY the
// machine supplies and a narrowing names the CONDUCT a module gives up, and `alloc` and `heap` are
// the one pair where those are different words.
narrowed_by(word: string) -> Option[string] = word match
    "alloc" -> Some(CapHeap)
    "os" -> Some(CapOs)
    "posix" -> Some(CapPosix)
    _ -> None

// The word a narrowing is written with, for a capability named as a facility.
narrow_word(cap: string) -> string = cap match
    "heap" -> "alloc"
    _ -> cap

// Whether a name is a facility a machine supplies.
is_facility(name: string) -> bool = name == CapHeap || name == CapOs || name == CapPosix

// A capability and the ones that come with it: requiring `posix` requires `os`.
capability_closure(cap: string) -> Buf[string]
    var out: Buf[string] = buf()

    out.push(cap)

    if cap == CapPosix then out.push(CapOs)

    out
end capability_closure

// Whether a clause is one the compiler actually enforces, which is what decides whether it is
// recorded at all.
private enforceable(c: CapabilityClause) -> bool = c.direction match
    Requires -> is_facility(c.name)
    Narrows -> narrowed_by(c.name).is_some()

// The capability a clause is about, as against the word it was written with.
private capability_of(c: CapabilityClause) -> string = c.direction match
    Requires -> c.name
    Narrows -> narrowed_by(c.name).unwrap_or(c.name)

// Reads every file's clauses, refuses the ones that are not clauses about anything, and holds the
// files of a module to agreeing.
//
// **The library's own headers are read and not checked.** They were checked when the library was
// built, so a complaint here would point at a file the program's author did not write.
read_capabilities(a: &Analysis, units: Buf[Program])
    for i in 0..<units.len()
        val unit = units.at(i)

        if !from_library(scope_of_unit(unit))
            for j in 0..<unit.capabilities.len()
                check_clause(a, unit, unit.capabilities.at(j))

            check_repeats(a, unit)

    check_module_agreement(a, units)
    record_capabilities(a, units)
end read_capabilities

// Refuses a clause that names nothing, or that names the facility where the conduct belongs.
private check_clause(a: &Analysis, u: Program, c: CapabilityClause)
    val scope = scope_of_unit(u)

    c.direction match
        Requires ->
            if !is_facility(c.name)
                // Naming what a module *does* where a facility belongs. `@requires(alloc)` is the
                // one that happens, since the narrowing beside it is spelled that way.
                if narrowed_by(c.name).is_some() then
                    a.fault(scope, c.span, s"'${c.name}' is what a module does, not something a " +
                            "machine has — a 'requires' names the facility, so this is " +
                            s"'@requires(${narrowed_by(c.name).unwrap()})'")
                else unknown_capability(a, scope, c)
        Narrows ->
            if narrowed_by(c.name).is_none()
                // The mirror image: naming the facility where the conduct belongs. `@no_heap` is
                // what a reader writes once, having seen `heap` in the config.
                if is_facility(c.name) then
                    a.fault(scope, c.span, s"'@no_${c.name}' says a machine has no ${c.name}, " +
                            "which is the project's to say and not this module's — what a module " +
                            "promises is what it does, so this is " +
                            s"'@no_${narrow_word(c.name)}'")
                else unknown_capability(a, scope, c)
end check_clause

private unknown_capability(a: &Analysis, scope: Scope, c: CapabilityClause)
    a.fault(scope, c.span, s"no capability is called '${c.name}' — the set is 'heap', 'os', 'posix'")

// Refuses a file that says the same thing about one capability twice, and one that says both things
// about it.
//
// The two are one check because they are one mistake: the module's set is what the clauses describe,
// and a capability appearing twice means the file's author believed two clauses were doing different
// work. Silently folding them would leave `no alloc` beside `requires alloc` meaning whichever the
// code happened to fold last.
private check_repeats(a: &Analysis, u: Program)
    val scope = scope_of_unit(u)

    for i in 0..<u.capabilities.len()
        val c = u.capabilities.at(i)

        if !enforceable(c) then continue

        // Grouped by the **capability** and not by the word, which is the whole reason this reads
        // the way it does: `@no_alloc` beside `requires heap` is one contradiction written in the
        // two vocabularies, and grouping by what was typed would have let it through.
        val cap = capability_of(c)
        val first = first_clause_about(u, cap)

        if first != i then continue

        val second = second_clause_about(u, cap)

        if second.is_none() then continue

        val other = u.capabilities.at(second.unwrap())

        if same_direction(c.direction, other.direction) then
            a.fault(scope, other.span, s"'${c.name}' is declared twice, and the second says " +
                    "nothing the first did not")
        else
            val both = if c.name != other.name then
                           s" — '@no_${narrow_word(cap)}' and 'requires $cap' are the two " +
                           "directions of one capability"
                       else ""

            a.fault(scope, other.span, s"'$cap' is both given up and required here, and a module " +
                    "cannot do without something it cannot be built without" + both)
end check_repeats

private same_direction(x: CapabilityDirection, y: CapabilityDirection) -> bool = x match
    Requires -> y match
        Requires -> true
        _ -> false
    Narrows -> y match
        Narrows -> true
        _ -> false

private first_clause_about(u: Program, cap: string) -> usize
    for i in 0..<u.capabilities.len()
        val c = u.capabilities.at(i)

        if enforceable(c) && capability_of(c) == cap then return i

    u.capabilities.len()
end first_clause_about

private second_clause_about(u: Program, cap: string) -> Option[usize]
    var seen = false

    for i in 0..<u.capabilities.len()
        val c = u.capabilities.at(i)

        if enforceable(c) && capability_of(c) == cap
            if seen then return Some(i)

            seen = true

    None
end second_clause_about

// Holds the files of one module to declaring the same clauses.
//
// **The files that ship and the files that do not are two groups, held apart.** A `@tests` file is
// dropped by every build but a test run, so the module's clause -- which is a promise about what a
// program linking this module may do -- is not a promise about it. The scaffolding is held to
// agreeing with *itself* for the reason the shipping files are held to agreeing with each other.
//
// The comparison is of the **set** of clauses rather than of the text: order between two clauses
// says nothing, and a file that wrote the same one twice is a separate mistake reported on its own
// line.
private check_module_agreement(a: &Analysis, units: Buf[Program])
    var seen: Buf[string] = buf()

    for i in 0..<units.len()
        val unit = units.at(i)

        if from_library(scope_of_unit(unit)) then continue

        val module_name = module_of_unit(unit)

        if holds_string(seen, module_name) then continue

        seen.push(module_name)

        agree_within(a, units, module_name, true)
        agree_within(a, units, module_name, false)
end check_module_agreement

private agree_within(a: &Analysis, units: Buf[Program], module_name: string, scaffolding: bool)
    var first: Option[Program] = None

    for i in 0..<units.len()
        val unit = units.at(i)

        if from_library(scope_of_unit(unit)) then continue
        if module_of_unit(unit) != module_name || unit.test_only != scaffolding then continue

        if first.is_none()
            first = Some(unit)
            continue
        end if

        if clauses_written(unit) == clauses_written(first.unwrap()) then continue

        // The two groups are held to agreeing for the same reason and are not held to each other,
        // so the sentence has to say which rule was broken -- a reader told that every file of the
        // module states the clause, having just been told a `@tests` file states its own, would
        // take one of the two for a lie.
        val whose = if scaffolding then
                        "the tests of a module are one body of scaffolding, so its '@tests' files " +
                        "state one thing between them"
                    else "a capability is a property of the module, so every one of its files " +
                         "states it"
        val whose_module = if module_name == "" then "the same module" else s"'$module_name'"

        a.fault(scope_of_unit(unit), disagreement_span(unit),
                s"${unit.src.name} and ${first.unwrap().src.name} are both files of " +
                s"$whose_module, and they declare different capabilities — $whose: " +
                s"${spell_clauses(unit)} against ${spell_clauses(first.unwrap())}")
end agree_within

// Where a disagreement is reported: the file's first clause, or its module header where it wrote
// none at all.
private disagreement_span(u: Program) -> Span
    if !u.capabilities.is_empty() then return u.capabilities.at(0).span

    u.module_name match
        Some(m) -> m.span
        None -> span_zero()
end disagreement_span

// One file's clauses as a set, so that the order two of them were written in says nothing.
private clauses_written(u: Program) -> string
    var out: Buf[string] = buf()

    for i in 0..<u.capabilities.len()
        val c = u.capabilities.at(i)
        val d = c.direction match
            Requires -> "requires"
            Narrows -> "narrows"

        out.push(s"$d ${c.name}")

    val sorted = sort_names(out)
    var joined = ""

    for i in 0..<sorted.len()
        joined = joined + sorted.at(i) + ";"

    joined
end clauses_written

// A file's clauses as a reader wrote them, for a message comparing two files.
private spell_clauses(u: Program) -> string
    if u.capabilities.is_empty() then return "none"

    var out = ""

    for i in 0..<u.capabilities.len()
        val c = u.capabilities.at(i)
        val one = c.direction match
            Narrows -> s"'@no_${c.name}'"
            Requires -> s"'@requires(${c.name})'"

        out = out + (if i > 0 then ", " else "") + one

    out
end spell_clauses

// -- what a module's clauses leave behind ----------------------------------------------------------

// Records each module's two sets, read off a file that **ships**: the header is one statement about
// the module however many files repeat it.
//
// Only the clauses the compiler enforces are kept, so a module that wrote something refused is left
// with the set it would have had without it -- which is what makes one mistake report once rather
// than again at every use of what the bad clause was about.
record_capabilities(a: &Analysis, units: Buf[Program])
    var seen: Buf[string] = buf()

    for i in 0..<units.len()
        val module_name = module_of_unit(units.at(i))

        if holds_string(seen, module_name) then continue

        seen.push(module_name)

        val shipped = first_file_of(units, module_name, false)
        val scaffolding = first_file_of(units, module_name, true)

        if shipped.is_some()
            record_module(a, module_name, shipped.unwrap())

        // After the module's own, because what the scaffolding states is an override of it.
        if scaffolding.is_some()
            record_module_tests(a, module_name, shipped, scaffolding.unwrap())
end record_capabilities

private first_file_of(units: Buf[Program], module_name: string, tests: bool) -> Option[Program]
    for i in 0..<units.len()
        val unit = units.at(i)

        if module_of_unit(unit) == module_name && unit.test_only == tests then return Some(unit)

    None
end first_file_of

private record_module(a: &Analysis, module_name: string, u: Program)
    for i in 0..<u.capabilities.len()
        val c = u.capabilities.at(i)

        if !enforceable(c) then continue

        val spread = implied_by(c)

        for j in 0..<spread.len()
            c.direction match
                Narrows -> a.tables.module_narrows.push((module_name, spread.at(j)))
                Requires -> a.tables.module_requires.push((module_name, spread.at(j)))
end record_module

// The tests' set is the module's own with the scaffolding's changes folded in, per capability: a
// `@tests` file writing no clause records the module's, one that requires a capability takes it back
// out of the narrowing, and one that narrows it narrows it whatever the module said.
//
// Only the narrowing is kept. What the scaffolding **requires** is not asked of the target, because
// every build but a test run analyzes a `@tests` file and then drops it.
private record_module_tests(a: &Analysis, module_name: string, shipped: Option[Program], u: Program)
    var taken_back: Buf[string] = buf()
    var narrowed: Buf[string] = buf()

    for i in 0..<u.capabilities.len()
        val c = u.capabilities.at(i)

        if !enforceable(c) then continue

        val spread = implied_by(c)

        for j in 0..<spread.len()
            c.direction match
                Requires -> taken_back.push(spread.at(j))
                Narrows -> narrowed.push(spread.at(j))

    // What the module gave up, less what the scaffolding took back.
    for i in 0..<a.tables.module_narrows.len()
        val pair = a.tables.module_narrows.at(i)

        if pair.0 == module_name && !holds_string(taken_back, pair.1) &&
                !holds_string(narrowed, pair.1) then
            a.tables.module_test_narrows.push(pair)

    for i in 0..<narrowed.len()
        a.tables.module_test_narrows.push((module_name, narrowed.at(i)))
        a.tables.module_test_own.push((module_name, narrowed.at(i)))
end record_module_tests

// A clause's capability and the ones that come with it, in whichever direction it points.
//
// The implication runs opposite ways for the two: **requiring** `posix` requires what `posix` needs,
// and **giving up** `os` gives up everything that needs `os`.
private implied_by(c: CapabilityClause) -> Buf[string]
    val cap = capability_of(c)

    c.direction match
        Requires -> capability_closure(cap)
        Narrows ->
            var out: Buf[string] = buf()

            out.push(cap)

            if cap == CapOs then out.push(CapPosix)

            out
end implied_by

// Whether a module gave a capability up, and the same asked of what its tests may do.
module_narrowed(a: &Analysis, module_name: string, cap: string) -> bool =
    holds_pair(a.tables.module_narrows, module_name, cap)

module_tests_narrowed(a: &Analysis, module_name: string, cap: string) -> bool =
    holds_pair(a.tables.module_test_narrows, module_name, cap)

// Whether the narrowing on the tests' side is one the `@tests` file wrote rather than one it
// inherited, which is what tells a reader which line to go and look at.
module_tests_own_narrowing(a: &Analysis, module_name: string, cap: string) -> bool =
    holds_pair(a.tables.module_test_own, module_name, cap)

private holds_pair(pairs: Buf[(string, string)], a: string, b: string) -> bool
    for i in 0..<pairs.len()
        if pairs.at(i).0 == a && pairs.at(i).1 == b then return true

    false
end holds_pair
