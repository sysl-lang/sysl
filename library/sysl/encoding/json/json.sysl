/** JSON, read and written: a document parsed into a value tree that owns itself, and a value tree
 * written back out compactly or for a person to read.
 *
 * **A document keeps the order it was written in.** An object's members are a sequence rather than
 * a map, so `{"b":1,"a":2}` writes back the way it arrived, and a name written twice keeps both
 * members. That is the only representation that round-trips, and it is the right trade at the sizes
 * JSON is used at -- a configuration file, a request body, a protocol message.
 *
 * **A malformed document is refused with the place it went wrong**: a `JsonError` carries the line,
 * the column and the byte offset, and what was wrong there, so a message can point at it.
 *
 * Nothing here opens or reads anything: `parse` takes text the caller already has, and writing goes
 * into any `Writer`. It needs a heap and nothing else, so it builds for a board that has one.
 */
module sysl.encoding.json

import sysl.buf.Buf
import sysl.text.parse_real

/** One member of an object: the name it was written under, and what was written there. */
struct Member
    key: string
    value: Json

/** A JSON value: one of the things the grammar can produce.
 *
 * **Numbers are three variants rather than one, so that an integer stays an integer.** JSON's
 * grammar has a single numeric production and says nothing about how it is stored. Carrying every
 * number as a `real` loses the exact value of an integer past 2^53, which is where an identifier or
 * a timestamp in milliseconds lives; carrying every number as a `long` cannot hold `0.5`. So:
 *
 * - `Int` is a number written with no fraction and no exponent that fits a `long`;
 * - `Real` is a number written with a fraction or an exponent -- `1.0` is a `Real`, not an `Int`;
 * - `Big` is a whole number past a `long` in either direction, carried as the digits the document
 *   wrote (sign included), so it round-trips exactly. `sysl.math.bigint.parse_radix(d, 10)` computes
 *   with one.
 *
 * A caller that does not care which asks `as_real`.
 *
 * **The tree owns itself.** An array holds a `Buf[Json]` and an object a `Buf[Member]`, with no
 * reference anywhere, so every walk over a document is a plain `match`.
 */
enum Json
    Null
    Bool(b: bool)
    Int(n: long)
    Big(digits: string)
    Real(x: real)
    Str(s: string)
    Arr(items: Buf[Json])
    Obj(members: Buf[Member])

    /** Whether this is `null` -- which is a value here, not the absence of one. `get` on a missing
     * member answers `None`; `get` on one written as `null` answers `Some(Null)`.
     */
    is_null(self) -> bool = self match
        Null -> true
        _ -> false

    /** The boolean this is, or `None` for every other shape.
     *
     * The `as_*` family never converts: a string reading `"true"` is a string, and `Str("1").as_int()`
     * is `None`. What a document meant is the document's business.
     */
    as_bool(self) -> Option[bool] = self match
        Bool(b) -> Some(b)
        _ -> None

    /** The integer this is, only where the document wrote one that fits a `long`. `1.0` is a `Real`
     * and a whole number past a `long` is a `Big`, so both answer `None`.
     */
    as_int(self) -> Option[long] = self match
        Int(n) -> Some(n)
        _ -> None

    /** The number this is, whichever variant carries it -- the one accessor that widens. A `long`
     * past 2^53 and a `Big` round to the nearest `real`, as every reader that has only floats does.
     */
    as_real(self) -> Option[real] = self match
        Real(x) -> Some(x)
        Int(n) -> Some(real(n))
        Big(d) -> parse_real(d) match
            Ok(x) -> Some(x)
            Err(_) -> None
        _ -> None

    as_str(self) -> Option[string] = self match
        Str(s) -> Some(s)
        _ -> None

    /** How many elements an array has, or how many members an object has. Anything else is zero, so
     * `for i in 0..<j.len()` is safe to write against a value whose shape has not been checked.
     */
    len(self) -> usize = self match
        Arr(items) -> items.len()
        Obj(members) -> members.len()
        _ -> 0

    /** The element at a position, for an array; `None` past the end and for anything else. */
    at(self, i: usize) -> Option[Json] = self match
        Arr(items) -> if i < items.len() then Some(items.at(i)) else None
        _ -> None

    /** The member at a position, for an object, in the order the document wrote them -- how an object
     * is walked when its names are not known in advance.
     */
    member(self, i: usize) -> Option[Member] = self match
        Obj(members) -> if i < members.len() then Some(members.at(i)) else None
        _ -> None

    /** The value written under a name, or `None` where there is none.
     *
     * **The scan is linear and the first match wins.** JSON permits a name twice and says nothing
     * about what that means; taking the first agrees with a caller walking the members in order.
     */
    get(self, key: string) -> Option[Json]
        self match
            Obj(members) ->
                for i in 0..<members.len()
                    val m = members.at(i)

                    if m.key == key then return Some(m.value)

                None
            _ -> None
    end get
end Json

/** Two members are equal when they were written under the same name and hold equal values. */
impl Eq for Member
    eq(self, rhs: Member) -> bool = self.key == rhs.key && self.value == rhs.value

/** Two values are equal when they are the same shape holding equal things.
 *
 * **The numeric variants do not meet**: `Int(1)` and `Real(1.0)` are two different texts, and this
 * equality is about two documents saying the same thing. **Objects compare in order**, for the same
 * reason.
 */
impl Eq for Json
    eq(self, rhs: Json) -> bool
        self match
            Null -> rhs.is_null()
            Bool(a) -> rhs match
                Bool(b) -> a == b
                _ -> false
            Int(a) -> rhs match
                Int(b) -> a == b
                _ -> false
            Big(a) -> rhs match
                Big(b) -> a == b
                _ -> false
            Real(a) -> rhs match
                Real(b) -> a == b
                _ -> false
            Str(a) -> rhs match
                Str(b) -> a == b
                _ -> false
            Arr(a) -> rhs match
                Arr(b) ->
                    if a.len() != b.len() then return false

                    for i in 0..<a.len()
                        if a.at(i) != b.at(i) then return false

                    true
                _ -> false
            Obj(a) -> rhs match
                Obj(b) ->
                    if a.len() != b.len() then return false

                    for i in 0..<a.len()
                        if a.at(i) != b.at(i) then return false

                    true
                _ -> false
    end eq
end Json
