@test("an impl method named with a reserved word")
rsv_member_in_an_impl()
    if !rsv_ready() then return

    rsv_refused("trait T\n    f(self) -> int\nstruct S\n    n: int\nimpl T for S\n" +
                "    for(self) -> int = 1\n\nprint(1)\n", "for", "a member's name", 6, 5)

@test("every declaration-leading word as a member, in every body a member is written in")
rsv_member_each_leading_word()
    if !rsv_ready() then return

    val words = rsv_leading_words()

    for i in 0..<words.len
        val w = words[i]

        rsv_refused(s"struct S\n    n: int\n    $w(self) -> int = self.n\n\nprint(1)\n", w,
                    "a member's name", 3, 5)
        rsv_refused(s"enum E\n    A\n    $w(self) -> int = 1\n\nprint(1)\n", w, "a member's name", 3,
                    5)
        rsv_refused(s"trait T\n    $w(self) -> int\n\nprint(1)\n", w, "a member's name", 2, 5)
        rsv_refused(s"trait T\n    $w(self) -> int = 1\n\nprint(1)\n", w, "a member's name", 2, 5)
        rsv_refused(s"trait T\n    f(self) -> int\nstruct S\n    n: int\nimpl T for S\n" +
                    s"    $w(self) -> int = 1\n\nprint(1)\n", w, "a member's name", 6, 5)

@test("a declaration-leading word as a trait property")
rsv_member_leading_word_property()
    if !rsv_ready() then return

    rsv_refused("trait T\n    static -> int\n\nprint(1)\n", "static", "a member's name", 2, 5)

@test("a declaration-leading word as a member with type parameters")
rsv_member_leading_word_type_parameters()
    if !rsv_ready() then return

    rsv_refused("trait T\n    type[U](self, u: U) -> int\n\nprint(1)\n", "type", "a member's name", 2,
                5)

@test("a declaration-leading word as a member under an annotation")
rsv_member_leading_word_under_annotation()
    if !rsv_ready() then return

    rsv_refused("trait T\n    f(self, x: int) -> int\nstruct S\n    n: int\nimpl T for S\n" +
                "    @crossing(x)\n    private(self, x: int) -> int = x\n\nprint(1)\n", "private",
                "a member's name", 7, 5)

@test("the backticked member name the refusal advises is a member like any other")
rsv_member_backticked_is_a_member()
    if !rsv_ready() then return

    val text = "trait T\n    `type`(self) -> int\n    `static`(self) -> int = 2\nstruct S\n    n: int\n" +
               "    `private`(self) -> int = self.n\nimpl T for S\n    `type`(self) -> int = 10\n\n" +
               "val s = S(3)\nprint(s.`type`() + s.`static`() + s.`private`())\n"

    assert_eq(rsv_ran(text), "15\n")

@test("every form the leading words open in a body still reads as itself")
rsv_member_forms_still_read()
    if !rsv_ready() then return

    val text = "trait Holds\n    type Item\n    type Key: Eq\n    static zero -> int\n" +
               "    first(self) -> Self::Item\n    key(self) -> Self::Key\nstruct Box\n    private n: int\n" +
               "    m: int\n    static seven -> int = 7\n    private get(self) -> int = self.n\n" +
               "    total(self) -> int = self.get() + self.m\n    set level(v)\n        self.n = v\n" +
               "    level -> int = self.n\nimpl Holds for Box\n    type Item = int\n    type Key = int\n" +
               "    static zero -> int = 0\n    first(self) -> int = self.total()\n" +
               "    key(self) -> int = 1\n\nvar b = Box(1, 2)\nb.level = 4\n" +
               "print(b.first() + b.key() + Box.seven + Box.zero)\n"

    assert_eq(rsv_ran(text), "14\n")

// A scoped visibility's bracket reads like type parameters, and the member-name refusal must not take
// it for a member called `private`.
@test("a scoped visibility is still a visibility, on a member with and without type parameters")
rsv_member_scoped_visibility()
    val text = "struct P\n    private[geom] x: int\n    private[geom] get(self) -> int = self.x\n" +
               "    private[geom] sum[T](self, t: T) -> int = self.x\nend P\n"
    val parsed = parse(source_of("test.sysl", text))

    assert(parsed.ok(), "the struct parses")

    *parsed.program.body.at(0).kind match
        StructDecl(d) ->
            assert_eq(d.members.len(), 2)
            assert_eq(d.members.at(0).name, "get")
            assert_eq(d.members.at(1).name, "sum")

            for i in 0..<d.members.len()
                d.members.at(i).vis match
                    Scoped(n) -> assert_eq(n, "geom")
                    _ -> assert(false, s"member $i is not scoped")
        _ -> assert(false, "the first statement is not a struct")

