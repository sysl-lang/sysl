module sh.sysl.compiler

import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}
import sysl.math.bigint.from_int

// **The substrate a body is written into**: registers, basic blocks, the entry-block prologue, and
// the module-level constants a body lays down as it goes.
//
// This file holds *how* intermediate representation is written down and none of what it says. The
// rules live in the files around it -- `emit_scalar.sysl` for what an operator becomes,
// `emit_place.sysl` for what an address is, `emit_flow.sysl` for the blocks a branch needs, and
// `emit_func.sysl` for the frame all three are emitted into.
//
// **A form nothing here lowers yet is recorded rather than guessed at.** `gap` holds the first one
// a body reached, and a body that reached one is left out of the module altogether: an answer this
// compiler cannot give is worth nothing beside the reference's, and a *wrong* one costs the diff
// its meaning. So a partial lowering is a smaller module rather than a different one, which is what
// makes it provable a function at a time.

// Everything one function's lowering needs, plus the module-level lists a body contributes to.
struct Emit
    target: Target
    layout: TargetLayout
    word_bits: int

    // The module-level storage bodies laid down -- the interned strings, so far.
    globals: Buf[IrGlobal]
    str_id: int

    // The LLVM intrinsics the module turned out to need. Each is declared once under its
    // overload-mangled name, which is why this is a list rather than a flag: the name carries the
    // width, so a program using one at three widths needs three declarations.
    sat_decls: Buf[IrFuncSig]

    // Whether anything stopped the program, copied a block of storage, or asked for the checked
    // arithmetic a size computation needs.
    traps: bool
    uses_memcpy: bool
    checked: bool

    // How many assembly blocks the module has emitted, which is what lets each one's labels be its
    // own.
    asm_site: int

    // The blocks of the function being built. `prologue` is kept apart because a stack slot is
    // hoisted to the top of the entry block from wherever it was needed, so the two halves of that
    // block are built at different times and joined only when the function is finished.
    prologue: Buf[Inst]
    blocks: Buf[IrBlock]
    current: Buf[Inst]
    current_end: Option[Inst]
    current_label: string
    temp: int
    label: int
    terminated: bool

    // Every label an emitted terminator names, which is what opening a block asks to decide whether
    // the block can be reached at all.
    reached: Buf[string]

    // The enclosing loops, innermost last, so a `break`/`continue` knows where to jump and what
    // result slot to store into.
    loops: Buf[GenLoop]

    // One stack slot per LLVM type per function, for the type punning a union needs: a value goes in
    // written as one type and comes back out read as another.
    scratch: Buf[(string, Val)]

    // What the module knows about the functions a body calls: the keys whose emitted symbol differs
    // from the key itself, the `extern`s -- which cross under C's convention rather than sysl's --
    // and the ones whose parameter list is open at the end.
    symbols: Buf[(string, string)]
    foreigns: Buf[string]
    variadics: Buf[string]

    // The whole LLVM function type of every `extern` whose parameter list is open at the end, which
    // is what a call to one names instead of a result type: the argument list alone does not say
    // where the declared parameters stop and the ellipsis begins.
    variadic_types: Buf[(string, IrFnType)]

    // The exported symbol of each function that has one, which is the **thunk's** rather than the
    // definition's. It is what an *address* of the function names, since the thunk is the one entry
    // point callable under the machine's C convention.
    export_symbols: Buf[(string, string)]

    // The postconditions the function being lowered states, and what `result` stands for while one
    // of them is being emitted. A return owes nothing beyond the `ret` where there are none.
    ensures: Buf[TClause]
    result_ssa: Option[Val]

    // Where a tail self-call jumps, and which calls are the ones that jump.
    //
    // The target sits just after the parameter slots are written, so the jump lands where a fresh
    // call would have landed: the preconditions are checked again and each `old(e)` is snapshotted
    // again, because a tail call *is* a call and those belong to the invocation rather than to the
    // frame. It is empty in a function with no tail call, which is what keeps a label out of every
    // other function in the module.
    tail_target: string
    tail_calls: Buf[Span]

    // The parameters a jump rebinds, in declaration order -- every one of them, so that they line up
    // with the arguments a call was written with.
    tail_params: Buf[(string, Type)]

    // -- the ownership runtime ---------------------------------------------------------------

    // The destructor each type that has one is filed under, read straight off the program. A hook
    // is built from a type with no call site anywhere near it, so this has to be here rather than
    // handed down from a caller.
    destructors: Buf[(string, string)]

    // Whether anything in this module put an object on the heap, took an atomic count, held a weak
    // reference, or counted against an owner that may be absent. Each decides one block of the
    // runtime, which is why they are four flags rather than one.
    heap: bool
    sync_heap: bool
    weak_heap: bool
    maybe_heap: bool

    // The boxes and buffers the module turned out to need, keyed by their LLVM name so that two
    // instantiations mangling to one name are one definition.
    boxes: Buf[(string, Type)]
    bufs: Buf[(string, Type)]

    // The runtime helpers asked for, by name, and what each is to be built from. A helper is named
    // where it is called and generated afterwards, because generating one may ask for another.
    requested: Buf[string]
    queue: Buf[HelperReq]

    // The scopes a value's count is given back at: the slots a lexical block owns, the values a
    // statement or sub-expression region owns, and the statements a block runs on the way out.
    //
    // **Each is one flat list with a list of region starts beside it**, rather than a list of
    // lists. A `Buf` copied out of another `Buf` shares the storage it views and carries its own
    // length, so pushing into one read back by `at` writes into the shared elements and leaves the
    // outer list's idea of the length behind -- a nesting that looks right and records nothing. A
    // start index is the whole of what a region is, so this says the same thing with no copy in it.
    temps: Buf[(Val, Type)]
    temp_marks: Buf[usize]
    owned_slots: Buf[(Val, Type)]
    owned_marks: Buf[usize]
    defers: Buf[TStmt]
    defer_marks: Buf[usize]

    // The names whose array lives in a buffer rather than a slot, because a view of it gets out of
    // this frame, and the box each of those buffers is. The **temporaries** are whole-program rather
    // than per-function, since a span already says which body a node is in.
    promoted: Buf[string]
    promoted_boxes: Buf[(string, Val)]
    promoted_temps: Buf[Span]

    // The first form this body reached that nothing here lowers. A body that has one is not emitted.
    gap: Option[string]
end Emit

// What a runtime helper is built from. A helper is asked for by name while a body is being written
// and generated once every body is, so what it is to be made of travels as a description rather
// than as a function of its own.
enum HelperReq
    // The retain / release walk over a value of a type, and the same over one at an address.
    HrValue(ty: Type, retain: bool)
    HrSlot(ty: Type, retain: bool)

    // The hook that destroys a box of this payload, a buffer of this element, and the one shared by
    // every box whose payload holds nothing.
    HrDrop(payload: Type)
    HrDropBuf(elem: Type)
    HrPlainDrop
end HelperReq

// What a definition and every call to it name.
symbol_of(e: *Emit, name: string) -> string
    for i in 0..<e.symbols.len()
        if e.symbols.at(i).0 == name then return e.symbols.at(i).1

    name
end symbol_of

// Whether a key names an `extern` rather than a function of this program's own.
is_foreign(e: *Emit, name: string) -> bool
    for i in 0..<e.foreigns.len()
        if e.foreigns.at(i) == name then return true

    false
end is_foreign

// The symbol an **address** of this function names -- the one entry point that is callable under
// the machine's C convention, since that is the only thing a `*extern` may hold.
//
// For an ordinary function the two are the same and this is `symbol_of`: its signature is all
// scalars, or the address would have been refused, and a scalar crosses as itself. For an exported
// one they are not -- the definition keeps sysl's lowering and the thunk in front of it is what C
// can call -- so the address is the thunk's, which is what makes `&f` on an exported function mean
// anything.
entry_of(e: *Emit, name: string) -> string
    for i in 0..<e.export_symbols.len()
        if e.export_symbols.at(i).0 == name then return e.export_symbols.at(i).1

    symbol_of(e, name)
end entry_of

// The whole function type a call to a variadic callee names, where the callee is one.
variadic_type_of(e: *Emit, name: string) -> Option[IrFnType]
    for i in 0..<e.variadic_types.len()
        if e.variadic_types.at(i).0 == name then return Some(e.variadic_types.at(i).1)

    None
end variadic_type_of

// Whether a key names something whose parameter list is open at the end.
is_variadic(e: *Emit, name: string) -> bool
    for i in 0..<e.variadics.len()
        if e.variadics.at(i) == name then return true

    false
end is_variadic

// Where a `break` and a `continue` in the innermost loop go, and where a `break` with a value puts
// it.
struct GenLoop
    break_label: string
    continue_label: string
    slot: Val
    has_slot: bool

    // How deep the ownership regions were when the loop was entered, which is what bounds the
    // unwinding a `break` or a `continue` from the middle of the body owes. Recorded before the
    // condition's own bindings: each term of a condition closes its own region, so by the time the
    // body runs there is nothing of the test left outstanding for the loop to give back.
    owned_depth: usize
    temp_depth: usize
end GenLoop

// An emitter for one module, with no function open, and no program behind it -- which is what a
// test asserting on one instruction wants.
emitter(t: Target) -> Emit
    var none: Buf[(string, string)] = buf()

    emitter_for(t, none)
end emitter

// The same, over a program whose destructors a hook has to be able to ask about.
emitter_for(t: Target, destructors: Buf[(string, string)]) -> Emit
    var globals: Buf[IrGlobal] = buf()
    var sat_decls: Buf[IrFuncSig] = buf()
    var prologue: Buf[Inst] = buf()
    var blocks: Buf[IrBlock] = buf()
    var current: Buf[Inst] = buf()
    var reached: Buf[string] = buf()
    var loops: Buf[GenLoop] = buf()
    var scratch: Buf[(string, Val)] = buf()
    var symbols: Buf[(string, string)] = buf()
    var foreigns: Buf[string] = buf()
    var variadics: Buf[string] = buf()
    var tail_calls: Buf[Span] = buf()
    var tail_params: Buf[(string, Type)] = buf()
    var ensures: Buf[TClause] = buf()

    var boxes: Buf[(string, Type)] = buf()
    var bufs: Buf[(string, Type)] = buf()
    var requested: Buf[string] = buf()
    var queue: Buf[HelperReq] = buf()
    var temps: Buf[(Val, Type)] = buf()
    var temp_marks: Buf[usize] = buf()
    var owned_slots: Buf[(Val, Type)] = buf()
    var owned_marks: Buf[usize] = buf()
    var defers: Buf[TStmt] = buf()
    var defer_marks: Buf[usize] = buf()
    var promoted: Buf[string] = buf()
    var promoted_boxes: Buf[(string, Val)] = buf()
    var promoted_temps: Buf[Span] = buf()
    var variadic_types: Buf[(string, IrFnType)] = buf()
    var export_symbols: Buf[(string, string)] = buf()

    Emit(t, layout_for(t), int(t.pointer_bits()), globals, 0, sat_decls, false, false, false, 0,
         prologue, blocks, current, None, "entry", 0, 0, false, reached, loops, scratch, symbols,
         foreigns, variadics, variadic_types, export_symbols, ensures, None, "", tail_calls, tail_params, destructors, false, false, false,
         false, boxes, bufs, requested, queue, temps, temp_marks, owned_slots, owned_marks, defers,
         defer_marks, promoted, promoted_boxes, promoted_temps, None)
end emitter_for

// -- what a body could not say --------------------------------------------------------------------

// Records that this body reached a form nothing lowers yet, and answers a value standing where the
// one it could not compute would have gone. The first reached is the one kept: it is the one a
// reader can act on, and everything after it is downstream of a value that was never computed.
gap_at(e: *Emit, what: string) -> Val
    if e.gap.is_none() then e.gap = Some(what)

    VUndef
end gap_at

// The same, for a caller with nothing to answer with.
gap_here(e: *Emit, what: string)
    if e.gap.is_none() then e.gap = Some(what)

// Whether this body has already given up.
has_gap(e: *Emit) -> bool = e.gap.is_some()

// -- the function under construction ---------------------------------------------------------------

// Resets everything that is one function's, which is everything but the module-level lists.
start_function(e: *Emit)
    e.prologue.clear()
    e.blocks.clear()
    e.current.clear()
    e.current_end = None
    e.current_label = "entry"
    e.temp = 0
    e.label = 0
    e.terminated = false
    e.reached.clear()
    e.loops.clear()
    e.scratch.clear()
    e.ensures.clear()
    e.result_ssa = None
    e.tail_target = ""
    e.tail_calls.clear()
    e.tail_params.clear()
    e.temps.clear()
    e.temp_marks.clear()
    e.owned_slots.clear()
    e.owned_marks.clear()
    e.defers.clear()
    e.defer_marks.clear()
    e.promoted_boxes.clear()
    e.gap = None
end start_function

// A register nothing else in this function uses.
fresh_reg(e: *Emit) -> Val
    e.temp += 1

    VReg(s"t${e.temp}")
end fresh_reg

// A label nothing else in this function uses.
fresh_label(e: *Emit, stem: string) -> string
    e.label += 1

    s"$stem${e.label}"
end fresh_label

// Emits a plain instruction, unless the current block is already terminated.
emit(e: *Emit, i: Inst)
    if !e.terminated then e.current.push(i)

// Emits a stack slot into the function's entry block rather than where it is needed. Every name is
// unique within a function, so hoisting is safe -- and it keeps a slot inside a loop from growing
// the stack on every iteration.
emit_alloca(e: *Emit, name: Val, ty: LType, align: Option[int]) -> Val
    e.prologue.push(InAlloca(name, ty, align))
    name
end emit_alloca

// A slot with whatever boundary the type it holds already asks for.
alloca(e: *Emit, name: Val, ty: LType) -> Val = emit_alloca(e, name, ty, None)

// The one overload of `llvm.memcpy` this compiler emits, so the two sites that name it -- the
// declaration and the call -- cannot spell it differently. Both pointers are in the default address
// space and the length is 64 bits on every target, whatever the machine's word is.
memcpy_symbol() -> string = "llvm.memcpy.p0.p0.i64"

// A block of storage copied, at a boundary both ends are known to satisfy.
//
// The one call in the module the intrinsic is declared for, so the flag that declares it is set here
// rather than at each site that copies -- a caller that stops copying stops declaring it, and one
// that starts brings the declaration with it.
emit_memcpy(e: *Emit, dst: Val, src: Val, bytes: int, align: int)
    e.uses_memcpy = true

    var args: Buf[IrArg] = buf()
    var dst_attrs: Buf[IrAttr] = buf()
    var src_attrs: Buf[IrAttr] = buf()

    dst_attrs.push(AttrAlign(align))
    src_attrs.push(AttrAlign(align))
    args.push(IrArg(LPtr, dst, dst_attrs))
    args.push(IrArg(LPtr, src, src_attrs))
    args.push(ir_arg(LInt(64), VInt(from_int(long(bytes)))))
    args.push(ir_arg(LInt(1), VBool(false)))
    emit(e, InCall(None, LVoid, VGlobal(memcpy_symbol()), args, no_ir_attrs(), None,
                   no_fast_math(), false))
end emit_memcpy

// Emits a block terminator, marks the block closed, and records wherever it sends control -- which
// is what makes the labels it names reachable.
emit_term(e: *Emit, i: Inst)
    if !e.terminated
        e.current_end = Some(i)
        e.terminated = true

        i match
            InBr(l) -> mark_reached(e, l)
            InCondBr(_, t, f) ->
                mark_reached(e, t)
                mark_reached(e, f)
            InSwitch(_, _, d, cs) ->
                mark_reached(e, d)

                for j in 0..<cs.len()
                    mark_reached(e, cs.at(j).1)
            _ -> ()
end emit_term

private mark_reached(e: *Emit, l: string)
    for i in 0..<e.reached.len()
        if e.reached.at(i) == l then return

    e.reached.push(l)
end mark_reached

private is_reached(e: *Emit, l: string) -> bool
    for i in 0..<e.reached.len()
        if e.reached.at(i) == l then return true

    false
end is_reached

// Opens a block under `l`.
//
// **A label nothing has branched to is unreachable, and emission stays suppressed through it.** LLVM
// has no fall-through -- a block is entered only by a terminator naming it -- so a label opened
// while no emitted branch mentions it can be reached at most by a back edge from the region it
// opens, which is unreachable from the entry by the same argument.
emit_label(e: *Emit, l: string)
    close_block(e)
    e.current_label = l
    e.terminated = !is_reached(e, l)
end emit_label

// Files the block being built and starts a fresh one. A block still marked closed at the moment it
// is filed never had a terminator of its own, because everything emitted into it was dropped -- it
// is unreachable code, and `unreachable` is what it says.
private close_block(e: *Emit)
    val end = e.current_end match
        Some(t) -> Some(t)
        None -> if e.terminated then Some(InUnreachable) else None

    var instrs: Buf[Inst] = buf()

    for i in 0..<e.current.len()
        instrs.push(e.current.at(i))

    e.blocks.push(IrBlock(e.current_label, instrs, end))
    e.current.clear()
    e.current_end = None
end close_block

// The function just emitted: its header, and the blocks it is made of. The hoisted slots go at the
// front of the entry block, which is where they were always printed.
finish_func(e: *Emit, sig: IrFuncSig) -> IrFunc
    close_block(e)

    var out: Buf[IrBlock] = buf()

    for i in 0..<e.blocks.len()
        val b = e.blocks.at(i)

        if i == 0
            var instrs: Buf[Inst] = buf()

            for j in 0..<e.prologue.len()
                instrs.push(e.prologue.at(j))

            for j in 0..<b.instrs.len()
                instrs.push(b.instrs.at(j))

            out.push(IrBlock(b.label, instrs, b.terminator))
        else
            out.push(b)

    IrFunc(sig, out)
end finish_func

// -- the constants a body folds against ------------------------------------------------------------

// The two widths written often enough to be worth naming: a condition, and the index a
// `getelementptr` steps with.
l_i1() -> LType = LInt(1)
l_i32() -> LType = LInt(32)

// The LLVM integer exactly one address wide, which is what a length, a size or an index must be
// spelled as.
word_lty(e: *Emit) -> LType = LInt(e.word_bits)

// The constant a folded condition is tested against, which is by shape rather than by an equality
// `Val` does not have.
private is_yes(v: Val) -> bool = v match
    VBool(b) -> b
    _ -> false

// Folding `and` / `or` over `i1`s, with the constant cases collapsed rather than emitted -- a test
// that cannot fail contributes `true`, and ANDing that in would be an instruction saying nothing.
and_i1(e: *Emit, a: Val, b: Val) -> Val
    if is_yes(a) then return b
    if is_yes(b) then return a

    val r = fresh_reg(e)

    emit(e, InBin(r, OpAnd, l_i1(), a, b))
    r
end and_i1

or_i1(e: *Emit, a: Val, b: Val) -> Val
    if is_yes(a) || is_yes(b) then return VBool(true)

    val r = fresh_reg(e)

    emit(e, InBin(r, OpOr, l_i1(), a, b))
    r
end or_i1

not_i1(e: *Emit, a: Val) -> Val
    if is_yes(a) then return VBool(false)

    val r = fresh_reg(e)

    emit(e, InBin(r, OpXor, l_i1(), a, VBool(true)))
    r
end not_i1

// -- storage a lowering borrows ----------------------------------------------------------------------

// One stack slot per LLVM type per function, for the type punning a union needs. Sharing the slot
// is safe because every use of it stores and immediately loads with nothing emitted in between.
scratch_slot(e: *Emit, ty: LType) -> Val
    val key = l_render(ty)

    for i in 0..<e.scratch.len()
        if e.scratch.at(i).0 == key then return e.scratch.at(i).1

    val slot = alloca(e, fresh_reg(e), ty)

    e.scratch.push((key, slot))
    slot
end scratch_slot

// A string's bytes as an interned constant holds them: UTF-8, with the terminator a C caller reads
// by -- which a `string`, knowing its own length, has never had a use for.
string_global(e: *Emit, s: string) -> Val
    e.str_id += 1

    val name = s".str${e.str_id}"

    var bytes: Buf[u8] = buf()

    for i in 0..<s.bytes.len
        bytes.push(s.bytes[i])

    bytes.push(u8(0))

    e.globals.push(ir_global(name, true, LArr(int(bytes.len()), LInt(8)), VBytes(bytes)))
    VGlobal(name)
end string_global

// -- the LLVM form of a type, as a body writes it ----------------------------------------------------

// What a value of this type is held in. A type nothing lowers is a gap rather than a guess.
lty(e: *Emit, t: Type) -> LType = type_lty(t, e.word_bits) match
    Some(l) -> l
    None ->
        gap_here(e, s"type ${type_show(t)}")
        LVoid

// The type a `load` or a `store` names, which is the same question.
lty_of(e: *Emit, x: TExpr) -> LType = lty(e, texpr_type(x))
