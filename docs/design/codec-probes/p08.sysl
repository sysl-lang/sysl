// P8: what an annotation's fields may be — a default value per field, a tagging style per enum
@annotation
struct default_int
    v: int

@annotation
struct tag
    field: string
    content: string

@tag("type", "data")
enum Msg
    Ping
    Move(dx: int)

struct Cfg
    @default_int(8080) port: int
    host: string

for const f in Cfg::Fields
    print(f.name, f::Annotation[default_int].map(d -> d.v).unwrap_or(0))

print(Msg::Annotation[tag].map(t -> t.field).unwrap_or("-"))
