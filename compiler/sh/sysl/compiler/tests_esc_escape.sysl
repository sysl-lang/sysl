module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture
import sysl.text.{split, Search}

// The reference's `EscapeClaimTests`, `EscapeErrorTests` and `EscapePromotionTests`: the escape
// analysis of `reference/memory.md § What happens when a slice escapes`. A slice of an array the
// frame owns has no owner to keep it alive, so every route by which one could be reached after the
// frame returns is found; a local array a view of which gets out is **promoted** to a counted buffer,
// storage the body did not declare is refused, and everything else is left where it was.
//
// Each promotion is checked twice over, as the reference checks it: the program **runs and gives
// the right answer**, which a dangling view would not, and the storage really moved, which a
// promotion that silently did not happen would not show -- it would compile and read a dead frame.
//
// **Every output, diagnostic, note and IR fragment here was read out of the reference compiler
// (0.0.154)** by handing the installed `sysl` the same program. A note is what `--explain-escapes`
// prints; positions are the reference's `line:column`.

// What a program does: what it printed and the status it exited with. A failure to build is its
// message and `-1`, which no program exits with.
private esc_outcome(text: string) -> (string, int)
    val root = make_temp_dir("sysl-esc").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", text).unwrap()

    val exe = s"$root/built"

    build_native_program(root, None, None, DefaultOptimization, Some(exe)) match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return (failure_text(why), -1)
        Ok(_) -> ()

    val said = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    said match
        Err(_) -> ("the program that was built could not be run", -1)
        Ok(out) -> (out.text + out.err.unwrap_or(""), shell_status(out.status))
end esc_outcome

// The program runs to the end and prints exactly this.
private esc_prints(text: string, want: string)
    if xvr_no_library() then return

    val out = esc_outcome(text)

    assert_eq(out.0, want)
    assert_eq(out.1, 0)
end esc_prints

// The build is refused, and what it said. Empty without the library.
private esc_refused(text: string) -> string
    if xvr_no_library() then return ""

    val out = esc_outcome(text)

    assert_eq(out.1, -1)
    out.0
end esc_refused

// The whole lowered program, which has to have been accepted. Empty without the library.
private esc_ir(text: string) -> string
    if xvr_no_library() then return ""

    val root = make_temp_dir("sysl-esc").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", text).unwrap()

    val made = emit_llvm_text(root, None)

    remove_dir_all(root).unwrap_or(())

    made match
        Err(why) ->
            assert(false, failure_text(why))
            ""
        Ok(emitted) ->
            assert(emitted.report.is_empty(), analysis_report(emitted.report))
            emitted.text
end esc_ir

// One function's body, from its `define` to the closing brace.
private esc_func(ir: string, symbol: string) -> string
    val lines = split(ir, "\n")
    var from: usize = 0
    var found = false

    for i in 0..<lines.len
        if !found && lines[i].starts_with("define ") && lines[i].contains(s"@$symbol(")
            found = true
        else if !found
            from += lines[i].len + 1

    if !found then return s"no definition of '$symbol'"

    val rest = ir[from..<ir.len]
    val close = rest.index_of("\n}").unwrap_or(rest.len)

    rest[0..<close]
end esc_func

// An array that was promoted is allocated rather than laid out, and the views of it carry a real
// owner -- a frame-backed array's slice carries `null`, so an owner at all is the difference.
private esc_promotes(text: string)
    if xvr_no_library() then return

    val out = esc_ir(text)

    assert(out.contains("call ptr @malloc"), out)
    assert(out.contains(".addr = getelementptr"), out)
    assert(out.contains(".box = alloca ptr"), out)
end esc_promotes

// The program both prints this and promotes.
private esc_moves(text: string, want: string)
    esc_prints(text, want)
    esc_promotes(text)
end esc_moves

// What `--explain-escapes` says about the program's own file: one line per promoted array. `None`
// without the library.
private esc_notes(text: string) -> Option[Buf[string]]
    if xvr_no_library() then return None

    val root = make_temp_dir("sysl-esc").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", text).unwrap()

    val program = packaged_compilation_of(root, host_target()) match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            assert(false, failure_text(why))
            return None
        Ok(read) -> read

    val done = analyze_bodies(program.units, program.target)
    val whole = program_of(done, done.main_module)
    val moved = post_analysis_checks(done.an, whole, program.own)

    remove_dir_all(root).unwrap_or(())

    assert(errors_of(done.an.diagnostics()).is_empty())

    var out: Buf[string] = buf()

    for i in 0..<moved.notes.len()
        if moved.notes.at(i).0.ends_with("main.sysl") then out.push(moved.notes.at(i).1)

    Some(out)
end esc_notes

// -- EscapeClaimTests: a view rides out in whatever carries it ---------------------------------------

@test("a tuple is a carrier, and the array it views is promoted")
esc_a_tuple_is_a_carrier()
    val src = raw"""
        leak() -> ([]u8, int)
            var buf: [8]u8
            buf[3] = 42u8
            (buf[0..<4], 1)
        var t = leak()
        print(t.0[3], t.1)
        """

    esc_notes(src) match
        None -> return
        Some(notes) ->
            assert_eq(notes.len(), 1)
            assert(notes.at(0).contains("'buf' is promoted to the heap"), notes.at(0))

    esc_prints(src, "42 1\n")
end esc_a_tuple_is_a_carrier

@test("and so is one slot of a multi-result list, which is not a tuple at all")
esc_one_slot_of_a_multi_result_list()
    val src = raw"""
        leak() -> []u8, int
            var buf: [8]u8
            buf[3] = 42u8
            return buf[0..<4], 1
        var v, n = leak()
        print(v[3], n)
        """

    esc_notes(src) match
        None -> return
        Some(notes) ->
            assert_eq(notes.len(), 1)
            assert(notes.at(0).contains("'buf' is promoted to the heap"), notes.at(0))

    esc_prints(src, "42 1\n")
end esc_one_slot_of_a_multi_result_list

// The composition `§ Deferred` claims: the closure's capture is a view of the array, so the array
// moves and nothing is written on either side.
@test("an escaping closure over a local array's slice needs nothing added on either side")
esc_an_escaping_closure_over_a_slice()
    val src = raw"""
        make() -> &Fn() -> u8
            var buf: [8]u8
            buf[3] = 42u8
            var view = buf[0..<4]
            () -> view[3]
        var f = make()
        print(f())
        """

    esc_notes(src) match
        None -> return
        Some(notes) -> assert_eq(notes.len(), 1)

    esc_prints(src, "42\n")
end esc_an_escaping_closure_over_a_slice

// A raw pointer carries no length and no owner, so there is nothing for promotion to serve -- and a
// `*T` into a local may dangle exactly as in C, which is the opt-out the mode is for.
@test("taking a '*T' to a local does NOT promote it, because promotion follows slices")
esc_a_pointer_to_a_local_does_not_promote()
    val src = raw"""
        grab() -> u8
            var buf: [8]u8
            var p = &buf[0]
            *p = 7u8
            buf[0]
        print(grab())
        """

    esc_notes(src) match
        None -> return
        Some(notes) -> assert_eq(notes.len(), 0)

    esc_prints(src, "7\n")
end esc_a_pointer_to_a_local_does_not_promote

// Its length is still a compile-time constant and it is still a value that copies on assignment,
// which is what makes promotion invisible to everything but the allocator.
@test("a promoted array keeps its type, and only its storage moves")
esc_a_promoted_array_keeps_its_type()
    esc_prints(raw"""
        promoted() -> []u8
            var buf: [8]u8
            buf[0] = 1u8
            var copy = buf
            copy[0] = 2u8
            print(buf.len, buf[0], copy[0])
            buf[0..<4]
        var out = promoted()
        print(out.len, out[0])
        """, "8 1 2\n4 1\n")
end esc_a_promoted_array_keeps_its_type

// A `string` owns its bytes, so nothing answering one carries a view of the caller's frame -- and a
// call that answers one must not inherit its arguments' views. The enclosing function's result used
// to decide it: the identical call compiled when the caller answered a `usize`.
private esc_string_fixture() -> string = raw"""
    filled() -> [4]u8
        var out: [4]u8 = [0; 4]
        for i in 0..<out.len do out[i] = u8(i)
        out

    shown(xs: []const u8) -> string = if xs.len == 4 then "yes" else "no"
    counted(xs: []const u8) -> usize = xs.len
    """

@test("a temporary array reaches it from a function answering a string")
esc_a_temporary_reaches_a_string_answer() =
    esc_prints(esc_string_fixture() + "c() -> string = shown(filled())\nprint(c())", "yes\n")

@test("and from a block body, which is the same call written the other way")
esc_and_from_a_block_body() =
    esc_prints(esc_string_fixture() + "c() -> string\n    shown(filled())\nprint(c())", "yes\n")

@test("as it always did from one answering something that is not a view at all")
esc_as_from_one_answering_no_view() =
    esc_prints(esc_string_fixture() + "c() -> usize = counted(filled())\nprint(c())", "4\n")

@test("while a slice answered directly still leaves as a view")
esc_a_slice_answered_directly_still_leaves()
    esc_notes(esc_string_fixture() + "c() -> []const u8\n    var b: [4]u8 = [1; 4]\n    b[..]\nprint(c().len)") match
        None -> ()
        Some(notes) ->
            assert_eq(notes.len(), 1)
            assert(notes.at(0).contains("promoted to the heap"), notes.at(0))

// -- EscapeErrorTests: what promotion does not reach -------------------------------------------------

private esc_not_ours() -> string = "not this body's to move"

// The caller laid the array out and passed a copy of it; moving it would be promoting a parameter.
@test("the array is a parameter passed by value")
esc_the_array_is_a_parameter_by_value()
    if xvr_no_library() then return

    val said = esc_refused("take(a: [4]int) -> []int = a[0..<2]\nprint(take([1, 2, 3, 4]).len)\n")

    assert(said.contains(esc_not_ours()), said)
end esc_the_array_is_a_parameter_by_value

// Moving a field means choosing between the field alone and the struct that holds it, which the
// chapter leaves unspecified -- so it stays refused rather than guessed at.
@test("the array is a field of a local struct")
esc_the_array_is_a_field_of_a_local_struct()
    if xvr_no_library() then return

    val said = esc_refused(raw"""
        struct Frame
            cells: [4]int
        end Frame
        peek() -> []int
            var f: Frame
            f.cells[0..<2]
        end peek
        print(peek().len)
        """)

    assert(said.contains(esc_not_ours()), said)
end esc_the_array_is_a_field_of_a_local_struct

@test("the diagnostic points at the slice rather than at the function")
esc_the_diagnostic_points_at_the_slice()
    if xvr_no_library() then return

    val said = esc_refused("take(a: [4]int) -> []int = a[0..<2]\nprint(take([1, 2, 3, 4]).len)\n")

    assert(said.contains("main.sysl:1:29\n"), said)
end esc_the_diagnostic_points_at_the_slice

// A fixed array inside a counted object: nothing moves, since the storage is on the heap already, and
// the view takes a count of the box the walk to the field went through.
@test("so it may be returned, and reads correctly after the reference is gone")
esc_a_view_into_a_box_may_be_returned() =
    esc_prints(raw"""
        struct Frame
            bytes: [8]u8
            n: int
        view(b: &Frame) -> []u8 = b.bytes[0..<4usize]
        make() -> []u8
            var b: &Frame = Frame([1, 2, 3, 4, 5, 6, 7, 8], 8)
            return view(b)
        end make
        var s = make()
        print(s.len, s[0], s[3])
        """, "4 1 4\n")

// A view that took no count would fault here, and one that took a count nobody gave back would hold
// two hundred thousand structs at once.
@test("and the box comes back when the last view of it does")
esc_the_box_comes_back_with_the_last_view() =
    esc_prints(raw"""
        struct Frame
            bytes: [8]u8
            n: int
        make() -> []u8
            var b: &Frame = Frame([1, 2, 3, 4, 5, 6, 7, 8], 8)
            return b.bytes[0..<4usize]
        end make
        var i = 0
        while i < 200000
            var t = make()
            if t[0] != 1 then
                print("wrong")
                exit(1)
            i += 1
        print("ok")
        """, "ok\n")

@test("a field of a field is the same walk, one step longer")
esc_a_field_of_a_field() =
    esc_prints(raw"""
        struct Inner
            cells: [4]int
        struct Outer
            inner: Inner
        grab() -> []int
            var o: &Outer = Outer(Inner([9, 8, 7, 6]))
            return o.inner.cells[1..<3]
        end grab
        var s = grab()
        print(s.len, s[0], s[1])
        """, "2 8 7\n")

// The owner is named by the root of the walk rather than its last step, so an index on the way to
// the array does not lose it.
@test("and an index step on the way to it keeps the owner")
esc_an_index_step_keeps_the_owner() =
    esc_prints(raw"""
        struct Grid
            rows: [2][3]int
        row(g: &Grid, i: usize) -> []int = g.rows[i][0..<2]
        take() -> []int
            var g: &Grid = Grid([[1, 2, 3], [4, 5, 6]])
            return row(g, 1usize)
        end take
        var s = take()
        print(s[0], s[1])
        """, "4 5\n")

// The view IS the struct's storage rather than a copy of it.
@test("a write through the view lands in the struct")
esc_a_write_through_the_view_lands() =
    esc_prints(raw"""
        struct Frame
            bytes: [4]u8
            n: int
        var b: &Frame = Frame([1, 2, 3, 4], 4)
        var s = b.bytes[..]
        s[0] = 9u8
        print(b.bytes[0])
        """, "9\n")

// The outer struct's field is overwritten, leaving the view as the only thing holding the inner box,
// and two hundred thousand allocations then churn the heap under it.
@test("the owner is the innermost box on the chain, not the first one reached")
esc_the_owner_is_the_innermost_box() =
    esc_prints(raw"""
        struct Inner
            cells: [4]int
        struct Outer
            inner: &Inner
        var o: &Outer = Outer(Inner([9, 8, 7, 6]))
        var s = o.inner.cells[..]
        o.inner = Inner([0, 0, 0, 0])
        var i = 0
        while i < 200000
            var junk: &Inner = Inner([1, 1, 1, 1])
            if junk.cells[0] != 1 then exit(1)
            i += 1
        print(s[0], s[1], s[2], s[3])
        """, "9 8 7 6\n")

// An index expression decides which element, not who owns it.
@test("and a box reached while working out an index does not become the owner")
esc_a_box_in_an_index_is_not_the_owner() =
    esc_prints(raw"""
        struct Pick
            i: usize
        struct Grid
            rows: [2][3]int
        pull() -> []int
            var g: &Grid = Grid([[1, 2, 3], [4, 5, 6]])
            var p: &Pick = Pick(1usize)
            return g.rows[p.i][0..<2]
        end pull
        var s = pull()
        var i = 0
        while i < 200000
            var t = pull()
            if t[0] != 4 then exit(1)
            i += 1
        print(s[0], s[1])
        """, "4 5\n")

@test("while a view of a '*T' region still owns nothing")
esc_a_view_of_a_pointer_region_owns_nothing()
    if xvr_no_library() then return

    val out = esc_ir(raw"""
        struct Frame
            bytes: [4]u8
        peek(p: *Frame) -> []u8 = p.bytes[..]
        var f = Frame([1, 2, 3, 4])
        print(peek(&f).len)
        """)

    assert(out.contains("insertvalue { ptr, ptr, i64 } zeroinitializer, ptr null, 0"), out)
end esc_a_view_of_a_pointer_region_owns_nothing

// -- a view that stays where it was made is allowed ---------------------------------------------------

// Accepted, and the function asked about is lowered, with nothing allocated for the array.
private esc_allowed(text: string, symbol: string)
    if xvr_no_library() then return

    val out = esc_ir(text)
    val body = esc_func(out, symbol)

    assert(body.starts_with("define"), out)
    assert(!body.contains("call ptr @malloc"), body)
end esc_allowed

@test("is only read")
esc_allowed_when_only_read() =
    esc_allowed("var buf: [4]u8\nvar s = buf[..]\nprint(s.len, s[0])\n", "main")

@test("goes to a callee that only reads it")
esc_allowed_to_a_callee_that_reads() =
    esc_allowed(raw"""
        peek(s: []u8) -> usize = s.len
        use() -> usize
            var buf: [4]u8
            peek(buf[..])
        end use
        print(use())
        """, "use")

@test("is filled by a callee and read back here")
esc_allowed_filled_by_a_callee() =
    esc_allowed(raw"""
        fill(s: []int, v: int)
            for i in 0..<s.len do s[i] = v
        use() -> int
            var buf: [4]int
            fill(buf[..], 7)
            buf[0]
        end use
        print(use())
        """, "use")

// The zero-copy parsing pattern: the result views the argument, and both live here.
@test("comes back from a callee as part of a value this frame keeps")
esc_allowed_back_from_a_callee() =
    esc_allowed(raw"""
        struct Header
            body: []u8
        end Header
        parse(s: []u8) -> Header = Header(s)
        use() -> usize
            var buf: [4]u8
            var h = parse(buf[..])
            h.body.len
        end use
        print(use())
        """, "use")

@test("views a buffer on the heap, which has an owner to keep it alive")
esc_allowed_a_heap_buffer()
    if xvr_no_library() then return

    assert(esc_func(esc_ir(raw"""
        view() -> []int
            var buf: &[4]int = [1, 2, 3, 4]
            buf[..]
        end view
        print(view().len)
        """), "view").starts_with("define"))
end esc_allowed_a_heap_buffer

// The slice retains the buffer's owner, so it keeps its storage alive as a returned heap view does.
@test("is broken out of a loop but views a heap buffer")
esc_allowed_a_heap_buffer_out_of_a_loop()
    if xvr_no_library() then return

    assert(esc_func(esc_ir(raw"""
        view() -> []int
            var buf: &[4]int = [1, 2, 3, 4]
            for i in 0..<4
                if i == 2 then break buf[..]
            else buf[0..<0]
        end view
        print(view().len)
        """), "view").starts_with("define"))
end esc_allowed_a_heap_buffer_out_of_a_loop

@test("views a `*T` region, which is outside every guarantee anyway")
esc_allowed_a_pointer_region() =
    esc_allowed(raw"""
        view() -> []int
            var buf: [4]int
            var p = &buf
            p[..]
        end view
        print(view().len)
        """, "view")

// The array is a field of somebody else's struct, reached through a field access on the pointer.
@test("views an array field reached through a `*T`")
esc_allowed_a_field_through_a_pointer() =
    esc_allowed(raw"""
        struct Box
            a: [8]u8
            n: usize
        end Box
        view(b: *Box) -> []u8 = b.a[0..<b.n]
        var b = Box([65u8; 8], 3usize)
        print(view(&b).len)
        """, "view")

@test("views an array field of a `*T` receiver")
esc_allowed_a_field_of_a_pointer_receiver() =
    esc_allowed(raw"""
        struct Box
            a: [8]u8
            n: usize

            view(*self) -> []u8 = self.a[0..<self.n]
        end Box
        var b = Box([65u8; 8], 3usize)
        print(b.view().len)
        """, "Box.view")

// Several steps of a place: a table of structs indexed, then a field of the element.
@test("views an array nested two steps inside a `*T`")
esc_allowed_two_steps_inside_a_pointer() =
    esc_allowed(raw"""
        struct Row
            a: [4]u8
        end Row
        struct Table
            rows: [2]Row
        end Table
        view(t: *Table, i: usize) -> []u8 = t.rows[i].a[..]
        var t = Table([Row([65u8; 4]); 2])
        print(view(&t, 0usize).len)
        """, "view")

// The claim is about escape analysis, read off the extern's declaration -- whose spelling differs
// between AAPCS64 and SysV x86-64, so it holds on the AArch64 host this tree is built on.
@test("a heap-backed view may still be handed to an extern")
esc_a_heap_view_may_go_to_an_extern()
    if xvr_no_library() then return

    val out = esc_ir(raw"""
        extern take(s: []u8)
        use()
            var buf: &[4]u8 = [1, 2, 3, 4]
            take(buf[0..<2])
        end use
        use()
        """)

    assert(out.contains("declare void @take(ptr align 8)"), out)
end esc_a_heap_view_may_go_to_an_extern

@test("a recursive function converges rather than assuming the worst")
esc_a_recursive_function_converges() =
    esc_allowed(raw"""
        walk(s: []int, i: usize) -> int
            if i >= s.len then 0 else s[i] + walk(s, i + 1)
        end walk
        use() -> int
            var buf: [4]int
            walk(buf[..], 0)
        end use
        print(use())
        """, "use")

// -- EscapePromotionTests: a view that gets out is promoted ------------------------------------------

@test("is returned")
esc_promoted_when_returned() =
    esc_moves(raw"""
        view() -> []int
            var buf: [4]int
            buf[0usize] = 7
            buf[0..<2]
        end view
        var v = view()
        print(v.len, v[0usize])
        """, "2 7\n")

@test("is returned from a `return` in the middle")
esc_promoted_from_a_return_in_the_middle() =
    esc_moves(raw"""
        view(c: bool) -> []int
            var buf: [4]int
            buf[1usize] = 9
            if c then return buf[..]
            buf[0..<0]
        end view
        print(view(true).len, view(true)[1usize], view(false).len)
        """, "4 9 0\n")

@test("is returned inside a struct")
esc_promoted_inside_a_struct() =
    esc_moves(raw"""
        struct Header
            body: []u8
        end Header
        make() -> Header
            var buf: [4]u8
            buf[0usize] = 65u8
            Header(buf[..])
        end make
        var h = make()
        print(h.body.len, str(char(h.body[0usize])))
        """, "4 A\n")

@test("is returned by a function that only passed it along")
esc_promoted_through_a_pass_along() =
    esc_moves(raw"""
        pass(s: []int) -> []int = s
        leak() -> []int
            var buf: [4]int
            buf[3usize] = 4
            pass(buf[..])
        end leak
        var v = leak()
        print(v.len, v[3usize])
        """, "4 4\n")

// A loop is an expression, so a `break` of a frame-backed slice out of a loop whose value is
// returned carries it out exactly as a `return` would.
@test("is broken out of a loop that is returned")
esc_promoted_out_of_a_loop() =
    esc_moves(raw"""
        leak() -> []int
            var buf: [4]int
            buf[2usize] = 5
            for i in 0..<4
                if i == 2 then break buf[..]
            else buf[0..<0]
        end leak
        var v = leak()
        print(v.len, v[2usize])
        """, "4 5\n")

// A view of a view still roots at the array, so the array moves and both views count against it.
@test("is a slice of a slice of a frame-local array")
esc_promoted_a_slice_of_a_slice() =
    esc_moves(raw"""
        view() -> []int
            var buf: [8]int
            buf[2usize] = 3
            var s = buf[..]
            s[1..<4]
        end view
        var v = view()
        print(v.len, v[1usize])
        """, "3 3\n")

@test("reaches a local that is returned")
esc_promoted_through_a_local() =
    esc_moves(raw"""
        leak() -> []int
            var buf: [4]int
            buf[0usize] = 1
            var s = buf[..]
            var t = s
            t
        end leak
        print(leak()[0usize])
        """, "1\n")

@test("goes on the heap")
esc_promoted_onto_the_heap() =
    esc_moves(raw"""
        struct Held
            body: []int
        end Held
        stash() -> &Held
            var buf: [4]int
            buf[1usize] = 6
            var h: &Held = Held(buf[..])
            h
        end stash
        var h = stash()
        print(h.body.len, h.body[1usize])
        """, "4 6\n")

@test("is handed to a callee that holds on to it")
esc_promoted_to_a_callee_that_keeps_it() =
    esc_moves(raw"""
        stash(dest: *[]int, s: []int)
            *dest = s
        grab() -> int
            var buf: [4]int
            buf[0usize] = 8
            var out: []int
            stash(&out, buf[..])
            out[0usize]
        end grab
        print(grab())
        """, "8\n")

// The array is a local whichever pointers happen to be in scope beside it.
@test("is a local array declared beside a pointer parameter")
esc_promoted_beside_a_pointer_parameter() =
    esc_moves(raw"""
        struct Box
            a: [8]u8
        end Box
        view(b: *Box) -> []u8
            var mine: [4]u8
            mine[0usize] = 66u8
            mine[..]
        end view
        var b = Box([65u8; 8])
        var v = view(&b)
        print(v.len, str(char(v[0usize])))
        """, "4 B\n")

// An element of a local array of arrays is part of that array's storage, so the whole thing moves.
@test("is an element of a local array of arrays")
esc_promoted_an_element_of_an_array_of_arrays() =
    esc_moves(raw"""
        view(i: usize) -> []u8
            var grid: [2][4]u8
            grid[1usize][0usize] = 67u8
            grid[i][..]
        end view
        var v = view(1usize)
        print(v.len, str(char(v[0usize])))
        """, "4 C\n")

// A body nothing can see is assumed to keep what it is handed.
@test("is handed to an extern, whose body nothing can see")
esc_promoted_to_an_extern() =
    esc_promotes(raw"""
        extern take(s: []u8)
        use()
            var buf: [4]u8
            take(buf[0..<2])
        end use
        use()
        """)

// The tail of a variadic call is passed beside the declared parameters, so the declared one is
// still analyzed.
@test("is the declared parameter of a variadic extern")
esc_promoted_to_a_variadic_extern() =
    esc_promotes(raw"""
        extern take(s: []u8, ...)
        use()
            var buf: [4]u8
            take(buf[0..<2], 1)
        end use
        use()
        """)

@test("is erased into a trait object")
esc_promoted_into_a_trait_object() =
    esc_promotes(raw"""
        trait Sink
            put(self, s: []u8)
        struct Keep
            tag: int
        impl Sink for Keep
            put(self, s: []u8)
                print(s.len)
        use()
            var buf: [4]u8
            var k: &Sink = Keep(1)
            k.put(buf[..])
        end use
        use()
        """)

// `Writer` is the earned exception and `Reader` is not one.
@test("is read into through an erased reader, where a written one would not have been")
esc_promoted_through_an_erased_reader() =
    esc_promotes(raw"""
        import sysl.io.*
        use(r: *Reader) -> usize
            var room: [64]u8
            r.read(room[..]).len
        end use
        var s = stdin()
        print(use(&s))
        """)

// A buffer released once too often is a crash and one released too seldom a leak, and a single
// allocation shows neither.
@test("the buffer's count is right, over enough traffic to show it")
esc_the_buffers_count_is_right() =
    esc_prints(raw"""
        tag(n: int) -> []u8
            var buf: [16]u8
            buf[0usize] = u8(n % 26 + 65)
            buf[0..<1]
        end tag
        var total = 0
        for i in 0..<200000
            var t = tag(i)
            total += int(t[0usize])
        print(total)
        """, "15499928\n")

// -- an array that does not need moving keeps its frame slot -----------------------------------------

@test("one that is only read")
esc_kept_when_only_read() =
    esc_allowed(raw"""
        use() -> int
            var buf: [4]int
            buf[0usize] = 1
            buf[0usize]
        end use
        print(use())
        """, "use")

// A concrete reader is a direct call, so the summary applies and the reader keeps nothing.
@test("and one read into through a reader whose body is known")
esc_kept_through_a_known_reader() =
    esc_allowed(raw"""
        import sysl.io.*
        fill() -> usize
            var r = stdin()
            var room: [64]u8
            r.read(room[..]).len
        end fill
        print(fill())
        """, "fill")

// Monomorphization makes the call a direct one, so the summary applies again.
@test("and one read into through a reader a type parameter stands for")
esc_kept_through_a_generic_reader() =
    esc_allowed(raw"""
        import sysl.io.*
        fill[R: Reader](r: R) -> usize
            var room: [64]u8
            var it = r
            it.read(room[..]).len
        end fill
        print(fill(stdin()))
        """, "fill.sysl.io$FdReader")

@test("and one whose view never leaves")
esc_kept_when_the_view_never_leaves() =
    esc_allowed(raw"""
        sum(s: []int) -> int
            var t = 0
            for i in 0usize..<s.len do t += s[i]
            t
        end sum
        use() -> int
            var buf: [4]int
            sum(buf[..])
        end use
        print(use())
        """, "use")

// -- every promotion can be asked about: `--explain-escapes` ------------------------------------------

@test("the array is named, with the view that forced it")
esc_the_note_names_the_array_and_the_view()
    esc_notes(raw"""
        first() -> []u8
            var buf: [8]u8
            buf[0..<3]
        end first
        print(first().len)
        """) match
        None -> ()
        Some(notes) ->
            assert_eq(notes.len(), 1)
            assert(notes.at(0).ends_with("main.sysl:3:8: 'buf' is promoted to the heap, because " +
                                         "this view of it is returned"), notes.at(0))
end esc_the_note_names_the_array_and_the_view

@test("one line per array, in source order")
esc_one_note_per_array_in_source_order()
    esc_notes(raw"""
        first() -> []u8
            var buf: [8]u8
            buf[0..<3]
        end first
        second() -> []int
            var nums: [4]int
            nums[..]
        end second
        print(first().len + second().len)
        """) match
        None -> ()
        Some(notes) ->
            assert_eq(notes.len(), 2)
            assert(notes.at(0).contains("'buf'"), notes.at(0))
            assert(notes.at(1).contains("'nums'"), notes.at(1))
end esc_one_note_per_array_in_source_order

// The report answers "why did this allocate", and it allocated once.
@test("an array that escapes twice is reported once")
esc_an_array_escaping_twice_is_noted_once()
    esc_notes(raw"""
        both(c: bool) -> []int
            var buf: [4]int
            if c then return buf[0..<1]
            buf[..]
        end both
        print(both(true).len)
        """) match
        None -> ()
        Some(notes) ->
            assert_eq(notes.len(), 1)
            assert(notes.at(0).contains("'buf'"), notes.at(0))
end esc_an_array_escaping_twice_is_noted_once

@test("and a program that promotes nothing has nothing to say")
esc_nothing_promoted_nothing_noted()
    esc_notes(raw"""
        use() -> int
            var buf: [4]int
            buf[0usize]
        end use
        print(use())
        """) match
        None -> ()
        Some(notes) -> assert_eq(notes.len(), 0)

// The reason is the route out, so a program that escapes a different way is told which way.
@test("the route out is named")
esc_the_route_out_is_named()
    esc_notes(raw"""
        stash(dest: *[]int, s: []int)
            *dest = s
        grab() -> int
            var buf: [4]int
            var out: []int
            stash(&out, buf[..])
            out[0usize]
        end grab
        print(grab())
        """) match
        None -> ()
        Some(notes) ->
            assert_eq(notes.len(), 1)
            assert(notes.at(0).contains("is passed to 'stash', which holds on to it"), notes.at(0))
end esc_the_route_out_is_named

// -- a view of module storage leaves the frame without promotion or refusal ---------------------------

@test("because the storage outlives every frame there is")
esc_a_view_of_module_storage_leaves_freely() =
    esc_prints(raw"""
        static val table: [4]u8 = [1, 2, 3, 4]

        head() -> []const u8 = table[0..<2]

        print(head().len, head()[1])
        """, "2 2\n")

// `TVal.writable` is the only thing that distinguishes the two, and nothing about the lifetime does.
@test("and a module 'var' is the same storage, so it answers alike")
esc_a_module_var_answers_alike() =
    esc_prints(raw"""
        static var table: [4]u8 = [1, 2, 3, 4]

        head() -> []const u8 = table[0..<2]

        table[0usize] = 9
        print(head()[0], head().len)
        """, "9 2\n")
