module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture
import sysl.text.Search

// The helpers every `azc_` file shares: a program of one file or of several is written to a tree of
// its own, and handed to a compiler as a reader would hand it -- the file of a one-file program, the
// root of a tree.

// What one command line came to: whether it got as far as a program (for a run), what the command
// or the program wrote on each stream, and whether it came back cleanly.
struct AzcSaid
    built: bool
    out: string
    err: string
    ok: bool

    // Both streams, in the order a reader of a terminal would meet them.
    said(self) -> string = self.out + self.err

// Writes `files` -- each a path below the root and its text -- under a fresh directory, and answers
// the directory.
private azc_tree(files: []const (string, string)) -> string
    val root = make_temp_dir("sysl-azc").unwrap()

    for i in 0..<files.len
        val at = s"$root/${files[i].0}"

        make_dir_all(parent_of(at).unwrap()).unwrap()
        write_text(at, files[i].1).unwrap()

    root
end azc_tree

// What a command is handed: the one file of a one-file program, or the root of a tree.
private azc_subject(root: string, files: []const (string, string)) -> string =
    if files.len == 1 then s"$root/${files[0].0}" else root

// Runs `sysl <command…> <subject>` in process.
azc_cli(command: []const string, files: []const (string, string)) -> AzcSaid
    val root = azc_tree(files)
    var args: Buf[string] = buf()
    var lines: Buf[string] = buf()
    val sink = &lines
    var notes: Buf[string] = buf()
    val noted = &notes

    args.push("sysl")

    for i in 0..<command.len
        args.push(command[i])

    args.push(azc_subject(root, files))

    val code = run_cli_noted(args.view(), (line) -> sink.push(line), (line) -> noted.push(line))

    remove_dir_all(root).unwrap_or(())
    AzcSaid(true, azc_joined(lines), azc_joined(notes), code == 0)
end azc_cli

private azc_joined(lines: Buf[string]) -> string
    var out = ""

    for i in 0..<lines.len()
        out = out + lines.at(i) + "\n"

    out
end azc_joined

// Builds `files` and runs what it made.
azc_ran(files: []const (string, string)) -> AzcSaid
    val root = azc_tree(files)
    val exe = s"$root/built"
    val built = build_native_program(azc_subject(root, files), None, None, DefaultOptimization, Some(exe))

    val ran: AzcSaid = built match
        Err(e) -> AzcSaid(false, "", failure_text(e), false)
        Ok(_) -> capture(exe, [], "", [], true) match
            Err(_) -> AzcSaid(true, "", "the program that was built could not be run", false)
            Ok(o) -> AzcSaid(true, o.text, o.err.unwrap_or(""), o.status.ok())

    remove_dir_all(root).unwrap_or(())
    ran
end azc_ran

// `files` builds, exits zero and prints exactly `want`.
azc_prints(files: []const (string, string), want: string)
    val r = azc_ran(files)

    assert(r.built, s"it did not build: ${r.err}")
    assert(r.ok, s"it did not exit zero: ${r.said()}")
    assert_eq(r.out, want)
end azc_prints

// The same for a program of one file.
azc_main_prints(text: string, want: string) = azc_prints([("main.sysl", text)], want)

// `files` is refused, and what is said contains `part`.
azc_says(files: []const (string, string), part: string)
    val s = azc_cli(["emit-llvm"], files)

    assert(!s.ok, "it compiled")
    assert(s.said().contains(part), s"expected '$part', got: ${s.said()}")
end azc_says

// The same for a program of one file.
azc_refuses(text: string, part: string) = azc_says([("main.sysl", text)], part)

// What was said refusing `files`, for a claim about the whole report.
azc_reports(files: []const (string, string)) -> string = azc_cli(["emit-llvm"], files).said()

// The LLVM text emitted for `files` under `command` (`emit-llvm` and its flags).
azc_texts(command: []const string, files: []const (string, string)) -> string
    val s = azc_cli(command, files)

    assert(s.ok, s"it did not compile: ${s.said()}")
    s.out
end azc_texts

// The one line of `text` that begins with `head`, or nothing.
azc_line(text: string, head: string) -> string
    val at = ("\n" + text).index_of("\n" + head)

    if at.is_none() then return ""

    val rest = text[at.unwrap()..]

    rest.index_of("\n") match
        Some(n) -> rest[0..<n]
        None -> rest
end azc_line
