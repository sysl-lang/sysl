// P03: what strong count does an update see? Read through the raw tier -- the three words before the
// payload, printed as (-24, -16, -8) -- to learn whether `v = v.push(x)` could ever find its root held
// once, i.e. whether a uniqueness question would pay off in the idiomatic spelling. That this has to
// be read through `ptr_cast` at all is the gap (P02).

import sysl.raw.ptr_cast

struct Node
    n: int

static var keep: Option[&Node] = None

words(r: &Node) -> (usize, usize, usize)
    val a: *usize = ptr_cast(usize(&r.n) - 24)
    val b: *usize = ptr_cast(usize(&r.n) - 16)
    val c: *usize = ptr_cast(usize(&r.n) - 8)

    (*a, *b, *c)

struct Vec
    root: &Node

    push(self, x: int) -> Vec
        print("  inside push(self):", words(self.root))
        Vec(Node(self.root.n + x))

    push_ptr(*self, x: int)
        print("  inside push_ptr(*self):", words(self.root))
        self.root = Node(self.root.n + x)

run()
    val a: &Node = Node(1)

    keep = Some(a)
    print("two names (a, keep):", words(a))
    keep = None
    print("one name (a):", words(a))

    var v = Vec(Node(0))

    print("v = v.push(1):")
    v = v.push(1)
    print("v = v.push(2):")
    v = v.push(2)
    val held = v
    print("v = v.push(3) with a second name 'held':")
    v = v.push(3)
    print("v.push_ptr(4):")
    v.push_ptr(4)
    print(v.root.n, held.root.n)

run()
