module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.{capture, Status}
import sysl.text.replace_all

// **`union`** -- storage its fields share, all of them at its first byte, with nothing recording which
// was written last (`union_fields.sysl`; `reference/types.md § Unions`, `docs/design/union.md`). These
// are the declaration, the layout C gives it on every target the design note measured, construction,
// reads and writes, the zero value, `Debug`, and the refusals of the parser and the features.

private uni_ready() -> bool = std_root().is_ok() && clang_available()

private uni_run(text: string, level: string) -> (Status, string, string)
    val root = make_temp_dir("sysl-uni").unwrap()

    write_text(s"$root/main.sysl", text).unwrap()

    val exe = s"$root/built"

    build_native_program(root, None, None, level, Some(exe)) match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return (Status.Exited(-1), "", failure_text(why))
        Ok(_) -> ()

    val said = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    said match
        Err(_) -> (Status.Exited(-1), "", "the program that was built could not be run")
        Ok(out) -> (out.status, out.text, out.err.unwrap_or(""))
end uni_run

private uni_prints(text: string, printed: string)
    if !uni_ready() then return

    for level in ["0", DefaultOptimization]
        val (state, out, err) = uni_run(text, level)

        assert_eq(err, "")
        assert_eq(out, printed)
        assert(state == Status.Exited(0), s"-O$level stopped with $state")
end uni_prints

private uni_refused(text: string, message: string, line: int, col: int)
    if !uni_ready() then return

    val (_, _, err) = uni_run(text, "0")
    val head = s"error: $message\n"
    val at = s"/main.sysl:$line:$col\n"

    assert(err.contains(head), s"expected\n$head\nin\n$err")
    assert(err.contains(at), s"expected\n$at\nin\n$err")
    assert_eq(err.count_of("error: "), 1)
end uni_refused

// What the analysis says of a program built for `target`, all the way through the lowering: empty
// where it is accepted.
private uni_report(text: string, target: string) -> string
    val root = make_temp_dir("sysl-uni-t").unwrap()
    val src = s"$root/main.sysl"

    make_dir_all(root).unwrap()
    write_text(src, text).unwrap()

    val out = emit_llvm_text(src, Some(target)) match
        Err(why) -> failure_text(why)
        Ok(made) -> if made.report.is_empty() then "" else analysis_report(made.report)

    remove_dir_all(root).unwrap_or(())
    out
end uni_report

// `docs/design/union-probes/layout.c`, claim for claim, as compile-time assertions. `P` is a pointer's
// width; an 8-byte integer and a `f64` are 8-aligned on every one of the nine targets.
private val uni_layout: string = raw"""
    union U1
        a: u8
        b: u32

    union U2
        a: [5]u8
        b: u32

    union U3
        a: [3]u8
        b: u16

    union U4
        c: u8

    @packed
    union UP
        a: [5]u8
        b: u32

    @align(16)
    union UA
        a: [5]u8
        b: u32

    union In6
        b8: [16]u8
        b16: [8]u16
        b32: [4]u32

    union Epoll
        ptr: *u8
        fd: i32
        u32_: u32
        u64_: u64

    union IF
        i: u32
        f: f32

    struct N
        tag: u8
        v: IF
        t: u8

    @packed
    struct PS
        tag: u8
        v: IF

    union PI
        p: *u8
        n: u32

    struct MouseEv
        kind: u32
        ts: u32
        x: i32
        y: i32

    struct KeyEv
        kind: u32
        ts: u32
        key: u8

    union Event
        kind: u32
        m: MouseEv
        k: KeyEv
        padding: [128]u8

    struct Holder
        k: KeyEv

    union DU
        d: f64
        w: [2]u32

    @assert(sizeof(U1) == 4 && alignof(U1) == 4, "U1")
    @assert(sizeof(U2) == 8 && alignof(U2) == 4, "U2 rounds 5 up to 8")
    @assert(sizeof(U3) == 4 && alignof(U3) == 2, "U3 rounds 3 up to 4")
    @assert(sizeof(U4) == 1 && alignof(U4) == 1, "U4 one member")
    @assert(offsetof(U2, a) == 0 && offsetof(U2, b) == 0, "offset 0")
    @assert(sizeof(UP) == 5 && alignof(UP) == 1, "packed U2")
    @assert(sizeof(UA) == 16 && alignof(UA) == 16, "aligned U2")
    @assert(sizeof(In6) == 16 && alignof(In6) == 4, "in6_addr")
    @assert(sizeof(Epoll) == 8 && alignof(Epoll) == 8, "epoll_data")
    @assert(offsetof(N, v) == 4 && offsetof(N, t) == 8 && sizeof(N) == 12, "nested")
    @assert(offsetof(PS, v) == 1 && sizeof(PS) == 5, "union in packed struct")
    @assert(sizeof(PI) == sizeof(usize) && alignof(PI) == sizeof(usize), "ptr union")
    @assert(sizeof(Event) == 128 && offsetof(KeyEv, key) == 8, "SDL_Event's shape")
    @assert(sizeof(DU) == 8 && alignof(DU) == 8, "double union")

    main()
        var events: [2]Event
        events[0] = Event(kind = 1)
    """

@test("a union is laid out as C lays it out, on all nine targets the design note measured")
uni_layout_matches_c()
    if !uni_ready() then return

    // The hosted Linux and Windows targets need their C headers to build the standard module, and
    // a union's layout asks only the processor: their freestanding twins answer for them.
    for target in ["aarch64-macos", "aarch64-freestanding", "x86_64-freestanding",
                   "thumbv7em-freestanding", "thumbv7em-freestanding-soft", "riscv32-freestanding",
                   "riscv64-freestanding", "wasm32-freestanding"]
        assert_eq(uni_report(uni_layout, target), "")

@test("the layout assertions can fail: a wrong size is refused")
uni_layout_assertion_can_fail()
    if !uni_ready() then return

    val report = uni_report(replace_all(uni_layout, "sizeof(U2) == 8", "sizeof(U2) == 5"), "riscv32-freestanding")

    assert(report.contains("U2 rounds 5 up to 8"), report)

@test("a union's fields share its first byte: a write through one is read through another")
uni_fields_share_storage()
    uni_prints(raw"""
        union In6
            b8: [16]u8
            b16: [8]u16
            b32: [4]u32

        union Word
            whole: u32
            f: f32

        make() -> Word = Word(f = 1.0)

        main()
            var a = In6(b32 = [0, 0, 0, 0])
            a.b8[15] = 1
            print(a.b32[3], a.b16[7])
            val w = Word(f = 1.0)
            print(w.whole, make().whole)
        """, "16777216 256\n1065353216 1065353216\n")

@test("construction zero-fills the bytes past the field it names")
uni_construction_zero_fills()
    uni_prints(raw"""
        union Wide
            small: u8
            big: u64

        fill() -> u64
            var w = Wide(big = 0xffffffffffffffff)
            w.big
        end fill

        main()
            print(fill())
            print(Wide(small = 7).big)
        """, "18446744073709551615\n7\n")

@test("a write to one field leaves the bytes past it as they were")
uni_write_leaves_the_rest()
    uni_prints(raw"""
        union Wide
            small: u8
            big: u32

        main()
            var w = Wide(big = 0x01020304)
            w.small = 0xff
            print(w.big)
        """, "16909311\n")

@test("a union passes by value, returns, sits in a struct and an array, and has a zero value")
uni_by_value_and_zero()
    uni_prints(raw"""
        union Word
            whole: u32
            f: f32

        struct Box
            tag: u8
            w: Word

        bump(w: Word) -> Word = Word(whole = w.whole + 1)

        main()
            var z: Word
            var arr: [2]Word
            arr[1] = bump(Word(whole = 41))
            val b = Box(1, bump(z))
            print(z.whole, arr[1].whole, b.w.whole, arr[0].whole)
        """, "0 42 1 0\n")

@test("a generic union is built at the argument its field is given, and held to its bound")
uni_generic()
    uni_prints(raw"""
        union Bits[T: AnyBits]
            value: T
            raw: u64

        main()
            print(Bits(value = u8(3)).raw, sizeof(Bits[u8]), Bits[u32](raw = 5).value)
        """, "3 8 5\n")

@test("a generic struct is built by name too, its arguments inferred from the named fields")
uni_generic_struct_by_name()
    uni_prints(raw"""
        struct G[T]
            value: T
            raw: u64

        main()
            print(G(raw = 1, value = u8(3)).value, G(value = 2.5, raw = 0).value)
        """, "3 2.5\n")

@test("a union's Debug is its name and its bytes in hex, honouring a width, and never reads a field")
uni_debug_hex()
    uni_prints(raw"""
        union Word
            whole: u32
            f: f32

        union Key
            raw: u8
            down: bool

        main()
            print(Word(f = 1.0))
            print(f"[${Word(whole = 1)}%20?]")
            print(f"[${Word(whole = 1)}%-20?]")
            print(Key(raw = 2))
        """, "Word(00 00 80 3f)\n[   Word(01 00 00 00)]\n[Word(01 00 00 00)   ]\nKey(02)\n")

@test("an impl Debug and an impl Eq of the program's own are a union's")
uni_own_impls()
    uni_prints(raw"""
        union Word
            whole: u32
            f: f32

        impl Debug for Word
            debug(self, out: *Writer, fmt: FormatSpec)
                out.write("w".bytes)

        impl Eq for Word
            eq(self, rhs: Word) -> bool = self.whole == rhs.whole

        main()
            print(f"${Word(whole = 1)}%?", Word(whole = 1) == Word(whole = 1), Word(whole = 1) == Word(f = 1.0))
        """, "w true false\n")

@test("a function pointer is AnyBits, so it is a union field read freely")
uni_function_pointer_field()
    uni_prints(raw"""
        union F
            f: *extern(i32) -> i32
            n: u64

        ok[T: AnyBits](x: T) -> int = 1

        main()
            val f = F(n = 0)
            print(sizeof(F), f.f == null, ok(f))
        """, "8 true 1\n")

@test("a pointer field beside an integer is accepted, and reads the integer's bits as an address")
uni_pointer_beside_integer()
    uni_prints(raw"""
        union PI
            p: *u8
            n: usize

        main()
            print(PI(n = 0).p == null, PI(n = 16).p == null)
        """, "true false\n")

@test("a union module 'val' is built when the program starts")
uni_module_val()
    uni_prints(raw"""
        union Key
            raw: u8
            down: bool

        val g: Key = Key(down = true)

        main()
            print(g.raw)
        """, "1\n")

@test("'union' stays a function's name where no name follows it")
uni_soft_word()
    uni_prints(raw"""
        union(a: int, b: int) -> int = a + b

        union In
            a: u8

        main()
            print(union(1, 2), In(a = 4).a)
        """, "3 4\n")

@test("a union declaring no fields is refused")
uni_empty_refused()
    uni_refused(raw"""
        union E
        end E

        main()
            print(1)
        """, "'union E' declares no fields — a union is storage its fields share, and one with none has nothing to share (C refuses an empty union too). One with no layout of its own is written 'opaque union E'", 1, 8)

@test("a union states no invariant")
uni_invariant_refused()
    uni_refused(raw"""
        union I
            a: u32
            invariant a > 0

        main()
            print(1)
        """, "a union states no 'invariant' — nothing records which of 'I''s fields was written last, so there is no field a clause could be stated over", 3, 5)

@test("an anonymous member is refused until it is built")
uni_anonymous_member_refused()
    uni_refused(raw"""
        struct P
            tag: u8
            union
                word: u32
                level: f32

        main()
            print(1)
        """, "an anonymous 'union' member is not built yet — declare the union with a name of its own and hold it as a named field", 3, 5)

@test("a union is built by name: a value by position is refused")
uni_positional_refused()
    uni_refused(raw"""
        union Key
            raw: u8
            down: bool

        main()
            val a = Key(1)
        """, "union 'Key' is built from one field, named — 'Key(raw = …)': a value by position would mean another field once one is declared in front of it", 6, 17)

@test("a union is built from exactly one field")
uni_two_fields_refused()
    uni_refused(raw"""
        union Key
            raw: u8
            down: bool

        main()
            val a = Key(raw = 1, down = true)
        """, "union 'Key' is built from exactly one field, named — 'Key(raw = …)' — and 2 values were given", 6, 13)

@test("a union is built from a field it declares")
uni_unknown_field_refused()
    uni_refused(raw"""
        union Key
            raw: u8
            down: bool

        main()
            val a = Key(nope = 1)
        """, "union 'Key' declares no field named 'nope' — it holds 'raw' and 'down'", 6, 17)

@test("a pattern cannot take a union apart, by position or by name")
uni_destructuring_refused()
    uni_refused(raw"""
        union Key
            raw: u8
            down: bool

        main()
            val k = Key(raw = 1)
            val Key(x, y) = k
        """, "a union has no tag to match on, so 'Key' cannot be taken apart by a pattern — read the field you know is there", 7, 5)

    uni_refused(raw"""
        union Key
            raw: u8
            down: bool

        main()
            val k = Key(raw = 1)
            k match
                Key{raw: r} -> print(r)
                _ -> print(2)
        """, "a union has no tag to match on, so 'Key' cannot be taken apart by a pattern — read the field you know is there", 8, 9)

@test("'==' is refused on a union, saying why")
uni_eq_refused()
    uni_refused(raw"""
        union Key
            raw: u8
            down: bool

        main()
            val k = Key(raw = 1)
            print(k == k)
        """, "'==' is not defined for the union Key — comparing its bytes is wrong for a float and for the bytes past a short field. Write 'impl Eq' comparing the field you know is there", 7, 11)

@test("'derives' is refused on a union")
uni_derives_refused()
    uni_refused(raw"""
        union Pt derives Eq
            x: u32
            y: f32

        main()
            print(1)
        """, "a union has no tag to say which field it holds, so a derived 'Eq' would read fields that are not there — write an 'impl' block that reads the field you know is there", 1, 18)

@test("a union as a 'const' is refused until compile-time evaluation reads one")
uni_const_refused()
    uni_refused(raw"""
        union Key
            raw: u8
            down: bool

        const k: Key = Key(raw = 1)

        main()
            print(k.raw)
        """, "a constant is a scalar, and Key is storage — write 'k' as a 'val', which is laid into the object file as constant data", 5, 1)

@test("a union by value at an extern is refused until its calling convention is built")
uni_extern_by_value_refused()
    uni_refused(raw"""
        union Key
            raw: u8
            down: bool

        extern takes(k: Key) -> i32

        main()
            print(takes(Key(raw = 1)))
        """, "'k' of the 'extern' 'takes' is Key, and a union crossing to C by value is not built yet — pass a pointer to it ('*U'), which C reads as the same bytes", 5, 1)

@test("an exported signature holding a union is refused until the header spells one")
uni_export_refused()
    uni_refused(raw"""
        union Key
            raw: u8
            down: bool

        @export("give")
        give(k: *Key) -> u8 = k.raw

        main()
            print(1)
        """, "'k' of the exported 'give' is *Key, and an exported signature holding a union is not built yet — the generated header does not spell one, and a union does not cross to C by value", 5, 1)

    uni_refused(raw"""
        @export("u_t")
        union X
            a: u32

        main()
            print(1)
        """, "'@export' on the union 'X' is not built yet — a generated header does not spell a union, so it would name a type C cannot see. Pass it by pointer, and declare the union on the C side", 1, 1)

@test("'@byte_order' on a union is refused until it is built")
uni_byte_order_refused()
    uni_refused(raw"""
        @byte_order(big)
        union B
            raw: [4]u8
            word: u32

        main()
            print(1)
        """, "'@byte_order' on the union 'B' is not built yet — declare it on the structs its fields hold, which reverse their own integers", 1, 1)
