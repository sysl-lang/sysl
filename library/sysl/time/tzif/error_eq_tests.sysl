module sysl.time.tzif
@tests

@test("eqe: TzifError is equal variant by variant and payload by payload")
eqe_tzif_error()
    assert(TzifError.BadMagic == TzifError.BadMagic)
    assert(TzifError.NoTypes == TzifError.NoTypes)
    assert(TzifError.BadMagic != TzifError.NoTypes)
    assert(TzifError.BadVersion(50) == TzifError.BadVersion(50))
    assert(TzifError.BadVersion(50) != TzifError.BadVersion(51))
    assert(TzifError.Truncated(44) == TzifError.Truncated(44))
    assert(TzifError.Truncated(44) != TzifError.Truncated(45))
    assert(TzifError.Truncated(44) != TzifError.BadMagic)
    assert(TzifError.BadFooter(7) == TzifError.BadFooter(7))
    assert(TzifError.BadFooter(7) != TzifError.BadFooter(8))
    assert(TzifError.BadFooter(0) != TzifError.Truncated(0))

@test("eqe: Result and Option[Result] over TzifError compare with ==")
eqe_tzif_result()
    val r: Result[int, TzifError] = Err(TzifError.Truncated(44))
    assert(r == Err(TzifError.Truncated(44)))
    assert(r != Err(TzifError.Truncated(8)))
    assert(r != Ok(0))
    val o: Option[Result[int, TzifError]] = Some(r)
    assert(o == Some(Err(TzifError.Truncated(44))))
    assert(o != Some(Err(TzifError.NoTypes)))
