module sh.sysl.compiler

import sysl.buf.{Buf, buf}
import sysl.math.bigint.from_int

// **A data enum is a tag and one payload region**, wide enough for whichever variant needs the most.
// The region is a union, so a payload cannot be dropped in with `insertvalue` -- an aggregate value
// has no operation that reinterprets part of itself. It goes through a stack slot instead: written
// at the variant's own type, read back at the enum's.

// The address of the payload region inside an enum sitting at `base`.
payload_ptr(e: *Emit, d: &EnumType, base: Val) -> Val
    val r = fresh_reg(e)

    var idx: Buf[IrArg] = buf()

    idx.push(ir_arg(l_i32(), VInt(from_int(0))))
    idx.push(ir_arg(l_i32(), VInt(from_int(1))))
    emit(e, InGep(r, enum_lty(d), base, idx))
    r
end payload_ptr

// Reads a variant's payload out of an enum value, at that variant's type.
//
// Reading a variant the value is not holding yields whatever the one it *is* holding left there --
// which is what a pattern test does before it knows the tag, and the tag test beside it is what
// makes the answer count.
enum_payload(e: *Emit, d: &EnumType, v: EnumVariant, value: Val) -> Val
    val slot = scratch_slot(e, enum_lty(d))

    emit(e, InStore(enum_lty(d), value, slot, AccPlain, None))

    val p = payload_ptr(e, d, slot)
    val r = fresh_reg(e)

    emit(e, InLoad(r, variant_lty(d, v), p, AccPlain, None))
    r
end enum_payload

// Builds an enum value from already-lowered payload values: the tag, then the variant's payload
// aggregate written into the region every variant shares.
// Whether an integer is one of an enum's discriminants: one comparison per variant, or-ed together,
// **at 64 bits** so that a value wider than the enum's own representation cannot wrap into a tag it
// is not.
enum_membership(e: *Emit, en: Type, vt: Type, v: Val) -> Val
    val d = enum_decl(en)

    if d.is_none() then return VBool(false)

    val signed = vt match
        Integer(_, s, _) -> s
        _ -> true

    val vs = d.unwrap().variants
    val wide = convert(e, vt, Integer(64, signed, false), v)
    var any = VBool(false)

    for i in 0..<vs.len()
        val eq = fresh_reg(e)

        emit(e, InIntCmp(eq, IEq, LInt(64), wide, VInt(from_int(long(vs.at(i).tag)))))

        any = if i == 0 then eq else or_i1(e, any, eq)

    any
end enum_membership

// `Colour.try(n)` — the fallible conversion. The membership test picks the branch: a match builds
// `Some(n as Colour)` and a miss builds `None`, so the result is an ordinary `Option[Colour]` whose
// element carries no count and whose merge slot needs no ownership bookkeeping.
gen_enum_try(e: *Emit, value: TExpr, en: Type, opt_ty: Type, some: EnumVariant,
             none: EnumVariant) -> Val
    val d = enum_decl(opt_ty)
    val ed = enum_decl(en)

    if d.is_none() || ed.is_none() then return gap_at(e, "a try whose option is not an enum")

    val vt = repr(texpr_type(value))
    val v = gen_expr(e, value)
    val ok = enum_membership(e, en, vt, v)
    val slot = alloca(e, fresh_reg(e), lty(e, opt_ty))
    val some_l = fresh_label(e, "try.some")
    val none_l = fresh_label(e, "try.none")
    val end_l = fresh_label(e, "try.end")

    emit_term(e, InCondBr(ok, some_l, none_l))
    emit_label(e, some_l)

    var carried: Buf[Val] = buf()

    carried.push(convert(e, vt, ed.unwrap().underlying, v))
    emit(e, InStore(lty(e, opt_ty), enum_value(e, opt_ty, d.unwrap(), some, carried), slot, AccPlain,
                    None))
    emit_term(e, InBr(end_l))
    emit_label(e, none_l)

    var empty: Buf[Val] = buf()

    emit(e, InStore(lty(e, opt_ty), enum_value(e, opt_ty, d.unwrap(), none, empty), slot, AccPlain,
                    None))
    emit_term(e, InBr(end_l))
    emit_label(e, end_l)

    val r = fresh_reg(e)

    emit(e, InLoad(r, lty(e, opt_ty), slot, AccPlain, None))
    r
end gen_enum_try

enum_value(e: *Emit, en: Type, d: &EnumType, v: EnumVariant, vals: Buf[Val]) -> Val
    if d.simple then return VInt(from_int(long(v.tag)))

    if !v.carries
        val tagged = fresh_reg(e)

        emit(e, InInsert(tagged, enum_lty(d), VUndef, l_i32(), VInt(from_int(long(v.tag))),
                         index_list(0)))
        return tagged

    var payload: Val = VUndef

    for i in 0..<vals.len()
        if !zero_sized(v.fields.at(i).1)
            val r = fresh_reg(e)

            emit(e, InInsert(r, variant_lty(d, v), payload, lty(e, v.fields.at(i).1), vals.at(i),
                             index_list(int(v.slot(i)))))
            payload = r

    val slot = scratch_slot(e, enum_lty(d))

    emit(e, InStore(l_i32(), VInt(from_int(long(v.tag))), slot, AccPlain, None))

    val p = payload_ptr(e, d, slot)

    emit(e, InStore(variant_lty(d, v), payload, p, AccPlain, None))

    val r = fresh_reg(e)

    emit(e, InLoad(r, enum_lty(d), slot, AccPlain, None))
    r
end enum_value

// The declaration behind an enum type, where the type is one.
enum_decl(t: Type) -> Option[&EnumType] = underlying(t) match
    Enum(d) -> Some(d)
    _ -> None

// The values one variant's payload holds, read out of an enum value -- or nothing at all where the
// variant carries none. A zero-sized field is skipped, which is the same skipping the layout does
// seen from the reading side.
payload_values(e: *Emit, d: &EnumType, v: EnumVariant, value: Val) -> Buf[Val]
    var out: Buf[Val] = buf()

    if !v.carries then return out

    val p = enum_payload(e, d, v, value)

    for i in 0..<v.fields.len()
        if zero_sized(v.fields.at(i).1) then out.push(VNothing)
        else
            val f = fresh_reg(e)

            emit(e, InExtract(f, variant_lty(d, v), p, index_list(int(v.slot(i)))))
            out.push(f)

    out
end payload_values
