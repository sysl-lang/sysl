module sh.sysl.compiler
@tests

import sh.sysl.parsing.*
import sysl.buf.{Buf, buf}
import sysl.text.Search
import sysl.fs.{make_dir_all, make_temp_dir, remove_dir_all, write_text}
import sysl.process.capture

// What a constrained type DOES when the program runs (`reference/errors.md § Constrained types`): a
// `within` range or a `where` predicate is checked at every place a value is produced into the type --
// an initializer, an assignment, an argument, a return, a conversion, a struct field -- and a value
// that fails stops the program. Each passing case sits beside the adjacent violation, so a check that
// is too tight and one that is too loose are both caught.
//
// **Every output quoted here was read out of the reference compiler**, whose `SubtypeRunTests` these
// are.

private var sr_library_cache: Buf[Program] = buf()
private var sr_library_read: bool = false

private sr_library() -> Buf[Program]
    if sr_library_read then return sr_library_cache

    sr_library_read = true

    std_root() match
        Err(_) -> ()
        Ok(root) -> std_units(root, host_target()) match
            Err(_) -> ()
            Ok(units) -> sr_library_cache = units

    sr_library_cache
end sr_library

// Every claim here is about a whole program, so all of them want the library and a toolchain.
private sr_ready() -> bool
    if sr_library().is_empty()
        print("skipped: the standard module's source is not on this machine")
        return false
    end if

    if !clang_available()
        print("skipped: there is no clang on this machine")
        return false
    end if

    true
end sr_ready

private sr_age() -> string = "type Age = int within 0..150\n"

private sr_prob() -> string = "type Prob = f64 within 0.0..<1.0\n"

private sr_letter() -> string = "type Letter = char within 'a'..'z'\n"

// **What a program PRINTS**, which only building and running it can say.
private sr_ran(text: string) -> string
    val root = make_temp_dir("sysl-subtype-run").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", text).unwrap()

    val exe = s"$root/built"

    build_native_program(s"$root/main.sysl", None, None, DefaultOptimization, Some(exe)) match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return failure_text(why)
        Ok(_) -> ()

    val said = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    said match
        Err(_) -> "the program that was built could not be run"
        Ok(out) -> out.text
end sr_ran

// **That a program STOPS ITSELF**: the status is not zero. Answers what is wrong, or the empty string.
private sr_exits(text: string) -> string
    val root = make_temp_dir("sysl-subtype-run").unwrap()

    make_dir_all(root).unwrap()
    write_text(s"$root/main.sysl", text).unwrap()

    val exe = s"$root/built"

    build_native_program(s"$root/main.sysl", None, None, DefaultOptimization, Some(exe)) match
        Err(why) ->
            remove_dir_all(root).unwrap_or(())
            return failure_text(why)
        Ok(_) -> ()

    val said = capture(exe, [], "", [], true)

    remove_dir_all(root).unwrap_or(())

    said match
        Err(_) -> "the program that was built could not be run"
        Ok(out) -> if out.status.ok() then s"it exited cleanly: ${out.text}" else ""
end sr_exits

// The LLVM text of a program that must compile.
private sr_ir(text: string) -> string
    val root = make_temp_dir("sysl-subtype-run").unwrap()
    val src = s"$root/main.sysl"

    make_dir_all(root).unwrap()
    write_text(src, text).unwrap()

    val out = emit_llvm_text(src, None) match
        Err(why) -> s"did not compile: ${why.message}"
        Ok(made) ->
            if !made.report.is_empty() then s"did not compile: ${analysis_report(made.report)}"
            else made.text

    remove_dir_all(root).unwrap_or(())
    out
end sr_ir

// How many lines of some LLVM text begin with `head`. The module's first line is its triple, so a
// type definition always follows a newline.
private sr_lines_starting(text: string, head: string) -> usize = text.count_of(s"\n$head")

// ---- a variable initializer

@test("an in-range integer passes and the value reads back through its base")
sr_an_in_range_integer_passes()
    if !sr_ready() then return

    assert_eq(sr_ran(sr_age() + "var a: Age = 30\nprint(a, int(a) + 1)"), "30 31\n")

@test("an out-of-range integer traps")
sr_an_out_of_range_integer_traps()
    if !sr_ready() then return

    assert_eq(sr_exits(sr_age() + "var a: Age = 200\nprint(a)"), "")

@test("the boundary values pass")
sr_the_boundary_values_pass()
    if !sr_ready() then return

    assert_eq(sr_ran(sr_age() + "var lo: Age = 0\nvar hi: Age = 150\nprint(lo, hi)"), "0 150\n")

@test("one past the top traps")
sr_one_past_the_top_traps()
    if !sr_ready() then return

    assert_eq(sr_exits(sr_age() + "var a: Age = 151\nprint(a)"), "")

@test("a float in range passes; the excluded upper endpoint traps")
sr_a_float_in_range_passes()
    if !sr_ready() then return

    assert_eq(sr_ran(sr_prob() + "var p: Prob = 0.0\nprint(p)"), "0\n")

@test("the exclusive upper bound itself traps")
sr_the_exclusive_upper_bound_itself_traps()
    if !sr_ready() then return

    assert_eq(sr_exits(sr_prob() + "var p: Prob = 1.0\nprint(p)"), "")

@test("below the float range traps")
sr_below_the_float_range_traps()
    if !sr_ready() then return

    assert_eq(sr_exits(sr_prob() + "var p: Prob = -0.5\nprint(p)"), "")

// A narrower float is widened to `double` before it meets the ends, which are `double` constants; the
// negative end is a negation rather than a literal, so it has to be read as one to be a bound at all.
@test("an f32 range holds both of its ends, the negative one included")
sr_an_f32_range_holds_both_ends()
    if !sr_ready() then return

    assert_eq(sr_ran("type Span = f32 within -0.5..2.5\nvar lo: Span = -0.5\nvar hi: Span = 2.5\nprint(lo, hi)"),
              "-0.5 2.5\n")

@test("and a value past its upper end traps")
sr_an_f32_range_traps_past_its_end()
    if !sr_ready() then return

    assert_eq(sr_exits("type Span = f32 within -0.5..2.5\nvar bad: Span = 2.75\nprint(bad)"), "")
    assert_eq(sr_exits("type Span = f32 within -0.5..2.5\nvar bad: Span = -0.75\nprint(bad)"), "")

@test("a character in range passes")
sr_a_character_in_range_passes()
    if !sr_ready() then return

    assert_eq(sr_ran(sr_letter() + "var c: Letter = 'q'\nprint(c)"), "q\n")

@test("a character below the range traps")
sr_a_character_below_the_range_traps()
    if !sr_ready() then return

    assert_eq(sr_exits(sr_letter() + "var c: Letter = 'A'\nprint(c)"), "")

@test("a character above the range traps")
sr_a_character_above_the_range_traps()
    if !sr_ready() then return

    assert_eq(sr_exits(sr_letter() + "var c: Letter = '{'\nprint(c)"), "")

// ---- an assignment re-checks the new value

@test("an in-range assignment holds")
sr_an_in_range_assignment_holds()
    if !sr_ready() then return

    assert_eq(sr_ran(sr_age() + "var a: Age = 10\na = 140\nprint(a)"), "140\n")

@test("an out-of-range assignment traps")
sr_an_out_of_range_assignment_traps()
    if !sr_ready() then return

    assert_eq(sr_exits(sr_age() + "var a: Age = 10\na = 200\nprint(a)"), "")

// ---- an argument is checked at the call

@test("an in-range argument passes")
sr_an_in_range_argument_passes()
    if !sr_ready() then return

    assert_eq(sr_ran(sr_age() + "f(a: Age) -> int\n    int(a)\nprint(f(42))"), "42\n")

@test("an out-of-range argument traps")
sr_an_out_of_range_argument_traps()
    if !sr_ready() then return

    assert_eq(sr_exits(sr_age() + "f(a: Age) -> int\n    int(a)\nprint(f(999))"), "")

// ---- a return value is checked

@test("an in-range result passes")
sr_an_in_range_result_passes()
    if !sr_ready() then return

    assert_eq(sr_ran(sr_age() + "g(n: int) -> Age\n    n\nprint(g(120))"), "120\n")

@test("an out-of-range result traps")
sr_an_out_of_range_result_traps()
    if !sr_ready() then return

    assert_eq(sr_exits(sr_age() + "g(n: int) -> Age\n    n\nprint(g(1000))"), "")

// ---- an explicit cast checks its operand

@test("an in-range cast produces the value")
sr_an_in_range_cast_produces_the_value()
    if !sr_ready() then return

    assert_eq(sr_ran(sr_age() + "print(Age(75))"), "75\n")

@test("an out-of-range cast traps")
sr_an_out_of_range_cast_traps()
    if !sr_ready() then return

    assert_eq(sr_exits(sr_age() + "print(Age(300))"), "")

// ---- a transparent subtype's name converts as its base's name does, and the range is still checked
// on the way in: the conversion is a conversion, not a way past the constraint.

@test("from a narrower integer")
sr_from_a_narrower_integer()
    if !sr_ready() then return

    assert_eq(sr_ran(sr_age() + "var n: u8 = 30\nprint(Age(n))"), "30\n")

@test("from a usize, which is a distinct type from the base")
sr_from_a_usize()
    if !sr_ready() then return

    assert_eq(sr_ran(sr_age() + "var n: usize = 42\nprint(Age(n))"), "42\n")

@test("and the range is checked on the value that arrives")
sr_the_range_is_checked_on_the_value_that_arrives()
    if !sr_ready() then return

    assert_eq(sr_exits(sr_age() + "var n: usize = 200\nprint(Age(n))"), "")

@test("from a float, truncating as the base's own conversion does")
sr_from_a_float_truncating()
    if !sr_ready() then return

    assert_eq(sr_ran(sr_age() + "var f: f64 = 7.9\nprint(Age(f))"), "7\n")

@test("and into a character subtype from an integer")
sr_into_a_character_subtype_from_an_integer()
    if !sr_ready() then return

    assert_eq(sr_ran(sr_letter() + "var n: u8 = 99\nprint(Letter(n))"), "c\n")

@test("while a value already at the base still needs no conversion")
sr_a_value_already_at_the_base()
    if !sr_ready() then return

    assert_eq(sr_ran(sr_age() + "var n: int = 12\nprint(Age(n))"), "12\n")

// ---- another subtype over the same base is re-checked

private sr_both_ranges() -> string = sr_age() + "type Small = int within 0..10\nnarrow(a: Age) -> Small\n    a\n"

@test("a value valid in both passes")
sr_a_value_valid_in_both_passes()
    if !sr_ready() then return

    assert_eq(sr_ran(sr_both_ranges() + "print(narrow(Age(5)))"), "5\n")

@test("a value valid in the wider one but not the tighter traps")
sr_valid_in_the_wider_but_not_the_tighter()
    if !sr_ready() then return

    assert_eq(sr_exits(sr_both_ranges() + "print(narrow(Age(100)))"), "")

@test("a subtype value used as its base needs no cast")
sr_a_subtype_value_used_as_its_base()
    if !sr_ready() then return

    assert_eq(sr_ran(sr_age() + "var a: Age = 12\nvar n: int = a\nprint(n + 1)"), "13\n")

// ---- a pattern matches a constrained subtype as the base it narrows

@test("a literal pattern")
sr_a_literal_pattern()
    if !sr_ready() then return

    assert_eq(sr_ran(raw"""
        type Small = int within 1..10
        var n: Small = 5
        n match
            5 -> print("five")
            else print("other")
        """), "five\n")

@test("a range pattern")
sr_a_range_pattern()
    if !sr_ready() then return

    assert_eq(sr_ran(raw"""
        type Small = int within 1..10
        var n: Small = 5
        n match
            1..6 -> print("low")
            else print("high")
        """), "low\n")

// An unsigned base picks a different comparison from a signed one, so the reduction has to reach the
// base rather than stop at any integer.
@test("and one over an unsigned base keeps the unsigned comparison")
sr_an_unsigned_base_keeps_the_unsigned_comparison()
    if !sr_ready() then return

    assert_eq(sr_ran(raw"""
        type Big = u8 within 200..255

        var n: Big = 250
        n match
            240..255 -> print("high")
            else print("low")
        """), "high\n")

@test("which a condition's pattern reaches by the same route")
sr_a_conditions_pattern_reaches_by_the_same_route()
    if !sr_ready() then return

    assert_eq(sr_ran(raw"""
        type Small = int within 1..10
        var n: Small = 5
        if n is 1..6 then print("low") else print("high")
        """), "low\n")

// ---- a constrained struct field is checked wherever it is written, at construction and at every
// later write

private sr_person() -> string = "type Age = int within 0..150\nstruct Person\n    age: Age\n"

@test("a construction in range proceeds")
sr_a_construction_in_range_proceeds()
    if !sr_ready() then return

    assert_eq(sr_ran(sr_person() + "var p = Person(Age(40))\nprint(int(p.age))"), "40\n")

@test("a construction out of range traps")
sr_a_construction_out_of_range_traps()
    if !sr_ready() then return

    assert_eq(sr_exits(sr_person() + "var p = Person(Age(200))\nprint(int(p.age))"), "")

@test("a later write in range proceeds")
sr_a_later_write_in_range_proceeds()
    if !sr_ready() then return

    assert_eq(sr_ran(sr_person() + "var p = Person(Age(40))\np.age = 41\nprint(int(p.age))"), "41\n")

@test("and one out of range traps")
sr_a_later_write_out_of_range_traps()
    if !sr_ready() then return

    assert_eq(sr_exits(sr_person() + "var p = Person(Age(40))\np.age = 200\nprint(int(p.age))"), "")

@test("a where predicate may read a module constant")
sr_a_where_predicate_may_read_a_module_constant()
    if !sr_ready() then return

    assert_eq(sr_ran(raw"""
        const ceiling: int = 150
        type Small = int where value < ceiling
        print(Small(3))
        """), "3\n")

// ---- a within bound may name a const, which makes a table's size and the range of the type
// indexing it one fact. A bound silently read as zero would make every value out of range, and one
// read as unbounded would check nothing, so the edge is what is asserted.

private sr_table() -> string = "const max_tasks: int = 8\ntype Slot = new int within 0..<max_tasks\n"

@test("a value inside the constant's range is accepted")
sr_a_value_inside_the_constants_range()
    if !sr_ready() then return

    assert_eq(sr_ran(sr_table() + "print(int(Slot(7)))"), "7\n")

@test("and the bound is the constant's value, tested at the edge")
sr_the_bound_is_the_constants_value()
    if !sr_ready() then return

    assert_eq(sr_ran(sr_table() + "print(Slot::Valid(7), Slot::Valid(max_tasks))"), "true false\n")

@test("a value the constant's range excludes still traps")
sr_a_value_the_constants_range_excludes()
    if !sr_ready() then return

    assert_eq(sr_exits(sr_table() + "print(int(Slot(8)))"), "")

// An expression over constants: `2..5` accepts 5 and rejects 6.
@test("an expression over constants is a bound")
sr_an_expression_over_constants_is_a_bound()
    if !sr_ready() then return

    assert_eq(sr_ran(raw"""
        const lo: int = 2
        const hi: int = 8
        type Mid = new int within lo..hi - 3
        print(Mid::Valid(2), Mid::Valid(5), Mid::Valid(6), Mid::Valid(1))
        """), "true true false false\n")

@test("a char subtype takes a char constant")
sr_a_char_subtype_takes_a_char_constant()
    if !sr_ready() then return

    val lower = "const first: char = 'a'\ntype Lower = new char within first..'f'\n"

    assert_eq(sr_ran(lower + "print(char(Lower('c')))"), "c\n")
    assert_eq(sr_exits(lower + "print(char(Lower('z')))"), "")

@test("and an array of the size the same constant gives is indexed by it")
sr_an_array_of_the_constants_size()
    if !sr_ready() then return

    assert_eq(sr_ran(raw"""
        const max_tasks: int = 4
        type Slot = new int within 0..<max_tasks
        var table: [max_tasks]int = [0; 4]
        table[int(Slot(3))] = 9
        print(table.len, table[3])
        """), "4 9\n")

// ---- a where predicate is checked at each produce site

private sr_even() -> string = "type Even = int within 0..100 where value % 2 == 0\n"

@test("a value satisfying both the range and the predicate passes")
sr_a_value_satisfying_both_passes()
    if !sr_ready() then return

    assert_eq(sr_ran(sr_even() + "var e: Even = 8\nprint(e)"), "8\n")

@test("a value the predicate rejects traps")
sr_a_value_the_predicate_rejects_traps()
    if !sr_ready() then return

    assert_eq(sr_exits(sr_even() + "print(Even(7))"), "")

@test("a value the range rejects traps before the predicate would even matter")
sr_a_value_the_range_rejects_traps()
    if !sr_ready() then return

    assert_eq(sr_exits(sr_even() + "print(Even(200))"), "")

// A predicate with no range is a legal transparent subtype on its own.
@test("an accepted value passes")
sr_a_predicate_only_subtype_accepts()
    if !sr_ready() then return

    assert_eq(sr_ran("type Positive = int where value > 0\nprint(Positive(5))"), "5\n")

@test("a rejected value traps")
sr_a_predicate_only_subtype_rejects()
    if !sr_ready() then return

    assert_eq(sr_exits("type Positive = int where value > 0\nprint(Positive(0))"), "")

// `char` has no arithmetic, but its predicate may still test equality and ordering.
private sr_hex() -> string = "type HexDigit = char where value >= '0' && value <= '9'\n"

@test("an accepted character passes")
sr_a_char_predicate_accepts()
    if !sr_ready() then return

    assert_eq(sr_ran(sr_hex() + "print(HexDigit('7'))"), "7\n")

@test("a rejected character traps")
sr_a_char_predicate_rejects()
    if !sr_ready() then return

    assert_eq(sr_exits(sr_hex() + "print(HexDigit('x'))"), "")

// ---- a new derived type is nominally distinct

private sr_meters() -> string = "type Meters = new f64\n"

@test("arithmetic between two of the derived type yields the derived type")
sr_arithmetic_between_two_of_the_derived_type()
    if !sr_ready() then return

    assert_eq(sr_ran(sr_meters() + "add(a: Meters, b: Meters) -> Meters\n    a + b\n" +
        "print(f64(add(Meters(3.0), Meters(4.5))))"), "7.5\n")

@test("wrapping and unwrapping round-trips through the base")
sr_wrapping_and_unwrapping_round_trips()
    if !sr_ready() then return

    assert_eq(sr_ran(sr_meters() + "var m: Meters = Meters(2.5)\nprint(f64(m) * 2.0)"), "5\n")

@test("two values of the derived type compare through the base ordering")
sr_two_derived_values_compare()
    if !sr_ready() then return

    assert_eq(sr_ran(sr_meters() + "print(Meters(3.0) < Meters(4.0))"), "true\n")

@test("an in-range wrap passes")
sr_an_in_range_wrap_passes()
    if !sr_ready() then return

    assert_eq(sr_ran("type SafeAge = new int within 0..150\nprint(int(SafeAge(40)) + 1)"), "41\n")

@test("an out-of-range wrap traps")
sr_an_out_of_range_wrap_traps()
    if !sr_ready() then return

    assert_eq(sr_exits("type SafeAge = new int within 0..150\nprint(int(SafeAge(200)))"), "")

@test("a derived char type wraps and prints through its base")
sr_a_derived_char_type_prints_through_its_base()
    if !sr_ready() then return

    assert_eq(sr_ran("type Glyph = new char\nprint(Glyph('a'))"), "a\n")

// ---- the whole of the base's arithmetic arrives with a derived type: a derivation buys the checking
// that two of them cannot be confused, and no say in what one of them means on its own.

private sr_stamp() -> string = "type Stamp = new i64\n"

@test("including operations the derived meaning does not have")
sr_operations_the_derived_meaning_does_not_have()
    if !sr_ready() then return

    assert_eq(sr_ran(sr_stamp() + "print(i64(Stamp(3i64) + Stamp(4i64)))"), "7\n")

@test("and the ones it does")
sr_and_the_ones_it_does()
    if !sr_ready() then return

    assert_eq(sr_ran(sr_stamp() + "print(i64(Stamp(7i64) - Stamp(4i64)))"), "3\n")

@test("equality and ordering come along too")
sr_equality_and_ordering_come_along()
    if !sr_ready() then return

    assert_eq(sr_ran(sr_stamp() + "print(Stamp(3i64) == Stamp(3i64), Stamp(3i64) < Stamp(4i64))"), "true true\n")

@test("and so does rendering, as the base renders")
sr_and_so_does_rendering()
    if !sr_ready() then return

    assert_eq(sr_ran(sr_stamp() + "print(s\"${Stamp(3i64)}\")"), "3\n")

// ---- a subtype's members are its own, not its base's: the two are different implementations of one
// trait, and naming both after the base would give one symbol two definitions.

private sr_describe_both() -> string = sr_age() + raw"""
    trait Describe
        describe(self) -> string

    impl Describe for Age
        describe(self) -> string = "an age"

    impl Describe for int
        describe(self) -> string = "an int"

    """

@test("the subtype and its base may both implement one trait")
sr_the_subtype_and_its_base_both_implement()
    if !sr_ready() then return

    assert_eq(sr_ran(sr_describe_both() + raw"""
        main()
            var a = Age(7)
            var b = 7
            print(a.describe(), b.describe())
        """), "an age an int\n")

@test("and each erases to a table of its own")
sr_each_erases_to_a_table_of_its_own()
    if !sr_ready() then return

    assert_eq(sr_ran(sr_describe_both() + raw"""
        report(d: *Describe) -> string = d.describe()

        main()
            var a = Age(7)
            var b = 7
            print(report(&a), report(&b))
        """), "an age an int\n")

@test("a derived subtype keeps its own too")
sr_a_derived_subtype_keeps_its_own()
    if !sr_ready() then return

    assert_eq(sr_ran(raw"""
        type Stamp = new i64

        trait Describe
            describe(self) -> string

        impl Describe for Stamp
            describe(self) -> string = "a stamp"

        impl Describe for i64
            describe(self) -> string = "an i64"

        main()
            print(Stamp(1i64).describe(), (1i64).describe())
        """), "a stamp an i64\n")

// ---- a generic instantiated at a subtype and at its base: the analyzer keeps two instantiations,
// because only one of them checks what is written into it, and each emitted name is defined once.

private sr_box() -> string = "struct Box[T]\n    value: T\nend Box\n"

private sr_boxes() -> string =
    sr_age() + sr_box() + "var a: Box[Age] = Box(30)\nvar b: Box[int] = Box(300)\nprint(a.value, b.value)"

@test("a struct at both is one type, and each keeps the checking its own arguments asked for")
sr_a_struct_at_both_keeps_its_checking()
    if !sr_ready() then return

    assert_eq(sr_ran(sr_boxes()), "30 300\n")
    assert_eq(sr_exits(sr_age() + sr_box() + "var a: Box[Age] = Box(200)\nprint(a.value)"), "")

@test("and the layout it shares is defined once")
sr_the_layout_it_shares_is_defined_once()
    if !sr_ready() then return

    assert_eq(sr_lines_starting(sr_ir(sr_boxes()), "%struct.Box.int = type"), 1)

private sr_options() -> string = sr_age() + raw"""
    var a: Option[Age] = Some(30)
    var b: Option[int] = Some(300)
    var x = a match
        Some(v) -> int(v)
        None -> -1
    var y = b match
        Some(v) -> v
        None -> -1
    print(x, y)
    """

@test("an enum at both defines its payload aggregate once")
sr_an_enum_at_both_defines_its_payload_once()
    if !sr_ready() then return

    assert_eq(sr_ran(sr_options()), "30 300\n")
    assert_eq(sr_lines_starting(sr_ir(sr_options()), "%sysl$Option.int.Some = type"), 1)

@test("the enum instantiated at the subtype still checks its payload")
sr_the_enum_at_the_subtype_still_checks()
    if !sr_ready() then return

    assert_eq(sr_exits(sr_age() + "var a: Option[Age] = Some(200)\nvar b: Option[int] = Some(300)\nprint(1)"), "")

// A derived subtype is nominally its own type and mangles under its own name, so these are two layouts.
@test("a derived subtype gets a layout of its own")
sr_a_derived_subtype_gets_a_layout_of_its_own()
    if !sr_ready() then return

    val out = sr_ir("type Stamp = new i64\n" + sr_box() +
        "var a: Box[Stamp] = Box(Stamp(1i64))\nvar b: Box[i64] = Box(2i64)\nprint(i64(a.value), b.value)")

    assert_eq(sr_lines_starting(out, "%struct.Box.Stamp = type"), 1)
    assert_eq(sr_lines_starting(out, "%struct.Box.long = type"), 1)
