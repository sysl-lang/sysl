// P7: a payload with a &T field, built generically
enum Expr
    Lit(n: int)
    Add(a: &Expr, b: &Expr)

build[T](name: string, leaf: &Expr) -> Option[T]
    for const c in T::Variants
        if const c.name == "Add"
            if name == c.name
                var p: c::Payload

                for const f in c::Fields
                    p.(f) = leaf

                return Some(T::Make(c, p))

    None

print(build[Expr]("Add", Expr.Lit(1)).is_some())
