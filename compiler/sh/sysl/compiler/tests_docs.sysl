@test("every leak excuse names a runnable block on a page that exists, a count and a reason")
the_leak_excuses_name_real_blocks()
    val root = docs_root()

    if root == ""
        print("skipped: no pages at '../docs/content' (run from 'compiler/') or at what SYSL_SITE names")
        return
    end if

    val excuses = docs_leak_excuses()

    assert(!excuses.is_empty())

    for k in 0..<excuses.len()
        val x = excuses.at(k)
        val blocks = docs_blocks(x.page, read_text(s"$root/${x.page}").unwrap_or(""))
        var found = false

        for i in 0..<blocks.len()
            val b = blocks.at(i)

            if b.nth == x.nth
                found = true
                assert(b.claim == DocsClaim.PagePrints && !b.archive && b.target == "",
                       s"${x.page}, sysl block ${x.nth} is not a runnable block")

        assert(found, s"${x.page} has no sysl block ${x.nth}")
        assert(x.live != 0, s"${x.page}, sysl block ${x.nth} is excused for leaking nothing")
        assert(x.why != "", s"${x.page}, sysl block ${x.nth} is excused with no reason")
end the_leak_excuses_name_real_blocks
