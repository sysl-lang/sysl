// The thing the rest of the program is for: a recurring meeting.
//
// A meeting is not a list of instants. It is a **rule about a wall clock** — every Tuesday at half
// past nine, in New York — and the instants are what comes out of the rule when it is asked. That
// is the shape that forces the distinction: two different people expand the same rule against two
// different walls and have to arrive at the same points on the timeline.
//
// Everything awkward about the subject shows up in one function. Stepping to next week is done on
// the *local* reading and then resolved again, never by adding a length of time to the instant,
// because the two answers are different in the week a zone changes and the local one is the one
// that means "the meeting".

struct Meeting
    day: Weekday
    at: LocalTime
    zone: ZoneId
end Meeting

// The next occurrences on or after a date, written into storage the caller supplies. The count is
// the length of what it was handed: a rule has no end, so what bounds the answer is the room to put
// it in.
expand(m: Meeting, from: LocalDate, out: []Instant) -> usize
    var d = on_or_after(from, m.day)

    for i in 0usize..<out.len
        out[i] = resolve_calendar(LocalDateTime(d, m.at), m.zone)
        d = LocalDate(d.day + 7)

    out.len
end expand

// The same rule stepped a week on, as the calendar means it. The reading is unchanged and the
// instant is recomputed, so the answer is 167, 168 or 169 hours later depending on what the zone
// did in between — and the caller never has to know which.
next_week(m: Meeting, occurrence: LocalDate) -> Instant =
    resolve_calendar(LocalDateTime(LocalDate(occurrence.day + 7), m.at), m.zone)

// Whether a participant in another zone is inside their working day at that instant. This is the
// question a scheduler is actually asked, and it is asked of a wall clock — a person is not free or
// busy at a point on the timeline, they are free or busy at a time of day.
free_at(t: Instant, z: ZoneId, opens: LocalTime, closes: LocalTime) -> bool
    var here = to_local(t, z)

    !(here.local.time.us < opens.us) && here.local.time.us < closes.us
end free_at

// One line of a printed agenda: when the meeting is, as the organiser's wall reads it and as a
// participant's does. The pair is the point — the same instant, two readings, and on one row of the
// agenda they disagree about the hour and on the next they do not.
agenda_line(t: Instant, host: ZoneId, guest: ZoneId) -> string =
    f"${zoned_text(to_local(t, host))}%s / ${zoned_text(to_local(t, guest))}%s"
