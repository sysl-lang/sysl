// P06: a `&sync` node whose elements live in a run-time-sized `[]T` (a leaf of exactly the length it
// needs) rather than a fixed array. Views are `Send` and not `Share`, so this is expected refused.

struct SLeaf[T]
    items: []T

main()
    val xs: []int = [1, 2, 3]
    val l: &sync SLeaf[int] = SLeaf(xs)

    print(l.items[1])
