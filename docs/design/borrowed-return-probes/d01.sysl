// Today's order (memory.md § Where defer sits): every deferred statement of the block, then the
// block's references released in reverse order of declaration. Under one interleaved reverse order
// (C++, D, Rust's guards, Zig) this prints `drop c`, `defer 2`, `drop b`, `defer 1`, `drop a`.
struct Noisy
    name: string

impl Drop for Noisy
    drop(self) = print("drop " + self.name)

run()
    val a: &Noisy = Noisy("a")
    defer print("defer 1")
    val b: &Noisy = Noisy("b")
    defer print("defer 2")
    val c: &Noisy = Noisy("c")

    print("body " + a.name + b.name + c.name)

run()
