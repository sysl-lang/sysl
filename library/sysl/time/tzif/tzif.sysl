module sysl.time.tzif

import sysl.time.{Instant, Offset, us_per_second, Date, YearMonthDay, Weekday}
import sysl.time.{days_from_civil, civil_from_days, days_in_month, leap_year, on_or_after}
import sysl.math.div_floor
import sysl.encoding.get_u32_be
import sysl.text.from_utf8

/** Reading a zone out of the bytes of a TZif file (RFC 8536), which is what the IANA time zone
 * database is distributed as.
 *
 * **This module asks for no capability, and that is the whole reason it is a module of its own.** A
 * zone by name lives in a file, and reading a file needs an operating system -- so a decoder written
 * beside `sysl.fs` would take the whole of `sysl.time` down with it, exactly as a `now()` written
 * beside `Instant` would have. What is here is the *decoding*, which is arithmetic over bytes
 * somebody else supplied; `sysl.posix.time.zone_data` is what fetches them on a host.
 *
 * **The split is not bookkeeping — it is what makes a zone reachable on a bare machine.** A board
 * with an RTC can carry one zone's bytes in flash, the zone it was deployed in, and resolve local
 * time with no filesystem anywhere. Weld the decoder to the file reading and a target with no
 * operating system gets nothing at all.
 *
 * ## Nothing is copied, and nothing is allocated
 *
 * A `Zone` is a handful of offsets **into the caller's bytes**, and every lookup reads the packed
 * arrays where they lie. That is what lets a zone be used with no allocator: the storage is the file,
 * which the caller already has, and this adds a few words beside it.
 *
 * The cost is the ordinary one for a borrowed view: **the bytes must outlive the `Zone`.** A `Zone`
 * whose buffer has been released reads freed memory, exactly as any slice would.
 *
 * ## What is decoded and what is skipped
 *
 * A lookup needs three of the file's arrays -- the transition times, the type index for each, and the
 * types themselves -- and the designations for a name. **Leap seconds are skipped**, because POSIX
 * time ignores them by definition and `Instant` counts the same way, so a table of them describes a
 * timeline this library does not have. The standard/wall and UT/local indicators are skipped for the
 * same reason they exist: they matter to somebody re-interpreting a POSIX `TZ` string, and nothing
 * here does that.
 *
 * **The version 2+ block is the one read**, where the file has one -- its transition times are 8
 * bytes, and a 4-byte time runs out in 2038. A version 1 file is still read, from its only block.
 *
 * ## Past the end of the table, the footer's rule
 *
 * A version 2+ file ends with a POSIX `TZ` string -- `EST5EDT,M3.2.0,M11.1.0` -- and **every instant
 * at or after the last transition is answered by that rule**, as is every instant of a file with no
 * transitions at all (RFC 8536 §3.3). This is not a refinement: since tzdata 2020b `zic` writes
 * "slim" files by default, which stop the table at the last change of *rules* and leave every later
 * daylight-saving switch to the footer, so a reader that answered with the last type would put a
 * whole season of every future year an hour out. A "fat" file runs out the same way in 2037.
 *
 * The rule is checked once, by `parse`, and a footer that is not one is refused as `BadFooter` rather
 * than read as far as it makes sense. A file whose footer is empty, or a version 1 file, which has
 * none, answers past its end with the last type, which is all it says.
 */

/** A zone, as a view of the bytes it was decoded from. */
struct Zone
    data: []const u8
    trans_at: usize
    types_at: usize
    ttinfo_at: usize
    desig_at: usize
    timecnt: usize
    typecnt: usize
    // Whether a transition time is 8 bytes. False only for a version 1 file.
    wide: bool
    // The footer's rule, between its two newlines; empty where the file has no rule.
    footer_at: usize
    footer_end: usize

/** Why a decode refused, at the granularity a caller can act on.
 *
 * The shape is `sysl.encoding.DecodeError`'s and for its reason: the variants are separated by what a
 * caller would **do** about each. `BadMagic` is a file that is not one of these at all -- the usual
 * cause being a path that named something else. `Truncated` carries the length that would have been
 * enough, so a caller reading in pieces knows how much more to get rather than doubling until it
 * fits. `BadFooter` carries where in the footer's rule the reading stopped, counted in bytes from
 * the rule's first character -- `EST5EDT` with no dates after it is `BadFooter(7)`.
 */
enum TzifError derives Eq
    BadMagic
    BadVersion(saw: u8)
    Truncated(needed: usize)
    NoTypes
    BadFooter(at: usize)

impl Display for TzifError
    display(self, out: *Writer, fmt: FormatSpec)
        var text = self match
            BadMagic -> "not a TZif file"
            BadVersion(saw) -> s"TZif version $saw is not one this reads"
            Truncated(needed) -> s"the file is shorter than its header says: $needed bytes needed"
            NoTypes -> "the file declares no local time types, so no time in it has an offset"
            BadFooter(at) -> s"the footer's TZ rule is malformed at byte $at of the rule"

        display_str(text, out, fmt)
    end display
end TzifError

private const header_len: usize = 44
private const ttinfo_len: usize = 6

private u32_at(b: []const u8, at: usize) -> Result[u32, TzifError]
    if at + 4 > b.len then return Err(Truncated(at + 4))

    get_u32_be(b[at..<at + 4]) match
        Some(v) -> Ok(v)
        None -> Err(Truncated(at + 4))
end u32_at

/** A count, as the offset arithmetic wants it. Every count in the header is a `u32` and every use of
 * one is an index, so the conversion happens once here rather than at each of its dozen uses.
 */
private count_at(b: []const u8, at: usize) -> Result[usize, TzifError]
    val v = u32_at(b, at)?

    Ok(usize(v))

/** A signed 32-bit big-endian integer, which is what an offset from UTC is stored as. */
private i32_at(b: []const u8, at: usize) -> Result[int, TzifError]
    val raw = u32_at(b, at)?

    /** `int` is 32 bits, so the wide half of the range is the negative half and the subtraction is
     * done in `long` to reach it. Writing `int(raw)` instead would be a narrowing of a value that
     * does not fit.
     */
    Ok(if raw >= 2147483648 then int(long(raw) - 4294967296) else int(raw))
end i32_at

/** A signed 64-bit big-endian integer, composed from its two halves rather than read as a `u64` and
 * reinterpreted -- the high half read *signed* is what carries the sign, so this is exact two's
 * complement with no cast whose behaviour has to be looked up.
 */
private i64_at(b: []const u8, at: usize) -> Result[long, TzifError]
    val hi = i32_at(b, at)?
    val lo = u32_at(b, at + 4)?

    Ok(long(hi) * 4294967296 + long(lo))

/** The version byte of the header at `at`, having checked that a header is what is there.
 *
 * **The magic is checked before the length, and the order is the whole of what makes the refusal
 * useful.** Five bytes is enough to know whether these are a TZif file at all, and a caller who
 * named the wrong path has bytes that are plentiful and wrong rather than few and right -- so
 * answering `Truncated` first would tell somebody holding a JPEG that their zone file was too short.
 * Length is what is left to say once the magic has agreed.
 */
private magic_at(b: []const u8, at: usize) -> Result[u8, TzifError]
    if at + 5 > b.len then return Err(Truncated(at + header_len))

    // "TZif"
    if b[at] != 84 || b[at + 1] != 90 || b[at + 2] != 105 || b[at + 3] != 102 then
        return Err(BadMagic)

    if at + header_len > b.len then return Err(Truncated(at + header_len))

    Ok(b[at + 4])
end magic_at

/** How long the data block described by the header at `at` is, at the given time width. */
private block_len(b: []const u8, at: usize, time_size: usize) -> Result[usize, TzifError]
    val isutcnt = count_at(b, at + 20)?
    val isstdcnt = count_at(b, at + 24)?
    val leapcnt = count_at(b, at + 28)?
    val timecnt = count_at(b, at + 32)?
    val typecnt = count_at(b, at + 36)?
    val charcnt = count_at(b, at + 40)?

    Ok(timecnt * time_size + timecnt + typecnt * ttinfo_len + charcnt +
        leapcnt * (time_size + 4) + isstdcnt + isutcnt)
end block_len

/** Reads a zone out of the bytes of a TZif file.
 *
 * **The `Zone` borrows `data`** -- see the note above about what that costs.
 *
 * A version 2 or later file carries its table twice: once with 4-byte transition times for a reader
 * that predates the format's second version, and then again with 8-byte ones. The first is stepped
 * over rather than read, which is why the length of it has to be worked out even though nothing in
 * it is wanted.
 */
parse(data: []const u8) -> Result[Zone, TzifError]
    val version = magic_at(data, 0)?

    // '0' is a version 1 file, whose single block is all there is. Anything from '2' on carries the
    // wide block after the narrow one; a version this does not know is refused rather than guessed
    // at, since a later format may put something else where the block is expected.
    if version != 0 && version != 50 && version != 51 && version != 52 then
        return Err(BadVersion(version))

    var at: usize = 0
    var time_size: usize = 4

    if version != 0
        at = header_len + block_len(data, 0, 4)?
        magic_at(data, at)?
        time_size = 8

    val timecnt = count_at(data, at + 32)?
    val typecnt = count_at(data, at + 36)?
    val charcnt = count_at(data, at + 40)?

    // A file with no types cannot answer what any time's offset is, and the arithmetic below would
    // read the designations as though they were one. Refused here, where it can be said plainly.
    if typecnt == 0 then return Err(NoTypes)

    val trans_at = at + header_len
    val types_at = trans_at + timecnt * time_size
    val ttinfo_at = types_at + timecnt
    val desig_at = ttinfo_at + typecnt * ttinfo_len

    if desig_at + charcnt > data.len then return Err(Truncated(desig_at + charcnt))

    var footer_at: usize = 0
    var footer_end: usize = 0

    // The footer is a newline, the rule, and a newline, straight after the wide block. A buffer that
    // stops where the block does has no footer to read, which answers as an empty one would.
    if version != 0
        val block_end = at + header_len + block_len(data, at, 8)?

        if data.len > block_end
            if data[block_end] != u8('\n') then return Err(BadFooter(0))

            footer_at = block_end + 1
            footer_end = footer_at

            while footer_end < data.len && data[footer_end] != u8('\n')
                footer_end += 1

            if footer_end == data.len then return Err(BadFooter(footer_end - footer_at))

            if footer_end > footer_at then rule(data, footer_at, footer_end)?

    Ok(Zone(data, trans_at, types_at, ttinfo_at, desig_at, timecnt, typecnt, time_size == 8,
        footer_at, footer_end))
end parse

// -- the footer's rule --------------------------------------------------------------------------------

/** Where a name sits in the zone's bytes. */
private struct Span
    at: usize
    len: usize

/** One of the rule's two dates: `Jn` (`kind` 'J'), `n` ('n'), or `Mm.w.d` ('M'), each with the time
 * of day the change happens at, in seconds of local time, which RFC 8536 lets run from -167 to 167
 * hours so that a change can be stated on a day other than the one it lands on.
 */
private struct DateRule
    kind: u8
    // The day for `J` and `n`, the month for `M`.
    n: int
    week: int
    day: int
    time: int

/** A footer's rule, decoded. The offsets are seconds EAST of UTC, which is the opposite sign from the
 * one POSIX writes: `EST5` is five hours west.
 */
private struct TzRule
    std_name: Span
    std_off: int
    has_dst: bool
    dst_name: Span
    dst_off: int
    start: DateRule
    stop: DateRule

/** A cursor over the rule; `from` is where it starts, so a refusal can say how far in it got. */
private struct Footer
    b: []const u8
    from: usize
    at: usize
    end: usize

private bad(f: *Footer) -> TzifError = BadFooter(f.at - f.from)

private peek(f: *Footer) -> u8 = if f.at < f.end then f.b[f.at] else 0

private is_digit(c: u8) -> bool = c >= u8('0') && c <= u8('9')

private is_alpha(c: u8) -> bool = (c >= u8('a') && c <= u8('z')) || (c >= u8('A') && c <= u8('Z'))

private expect(f: *Footer, c: u8) -> Result[(), TzifError]
    if peek(f) != c then return Err(bad(f))

    f.at += 1
    Ok(())

/** A name of three or more letters, or the quoted form `<+0530>` that lets a name hold digits and a
 * sign -- which is what the database writes for every zone with no abbreviation of its own.
 */
private zone_name(f: *Footer) -> Result[Span, TzifError]
    if peek(f) == u8('<')
        f.at += 1
        val start = f.at

        while is_alpha(peek(f)) || is_digit(peek(f)) || peek(f) == u8('+') || peek(f) == u8('-')
            f.at += 1

        if f.at - start < 3 || peek(f) != u8('>') then return Err(bad(f))

        f.at += 1
        return Ok(Span(start, f.at - 1 - start))

    val start = f.at

    while is_alpha(peek(f))
        f.at += 1

    if f.at - start < 3 then return Err(bad(f))

    Ok(Span(start, f.at - start))
end zone_name

/** An unsigned decimal no greater than `max`. */
private number(f: *Footer, max: int) -> Result[int, TzifError]
    if !is_digit(peek(f)) then return Err(bad(f))

    var n = 0

    while is_digit(peek(f))
        n = n * 10 + int(peek(f) - u8('0'))

        if n > max then return Err(bad(f))

        f.at += 1

    Ok(n)
end number

/** A number from 1 to `max`, refused where it starts if it is 0. */
private counted(f: *Footer, max: int) -> Result[int, TzifError]
    val start = f.at
    val n = number(f, max)?

    if n == 0 then return Err(BadFooter(start - f.from))

    Ok(n)

/** `[+-]hh[:mm[:ss]]` as seconds -- an offset, where `max_hours` is 24, or a rule's time of day,
 * where it is 167.
 */
private clock(f: *Footer, max_hours: int) -> Result[int, TzifError]
    var sign = 1

    if peek(f) == u8('+')
        f.at += 1
    else if peek(f) == u8('-')
        sign = -1
        f.at += 1

    var secs = number(f, max_hours)? * 3600

    if peek(f) == u8(':')
        f.at += 1
        secs += number(f, 59)? * 60

        if peek(f) == u8(':')
            f.at += 1
            secs += number(f, 59)?

    Ok(sign * secs)
end clock

/** One date of the rule, with its time; a time left out is 02:00, as POSIX says. */
private date_rule(f: *Footer) -> Result[DateRule, TzifError]
    var r = DateRule(u8('n'), 0, 0, 0, 7200)

    if peek(f) == u8('J')
        f.at += 1
        r.kind = u8('J')
        // Day 0 does not exist in the form that skips the 29th of February.
        r.n = counted(f, 365)?
    else if peek(f) == u8('M')
        f.at += 1
        r.kind = u8('M')
        r.n = counted(f, 12)?
        expect(f, u8('.'))?
        r.week = counted(f, 5)?
        expect(f, u8('.'))?
        r.day = number(f, 6)?
    else
        r.n = number(f, 365)?

    if peek(f) == u8('/')
        f.at += 1
        r.time = clock(f, 167)?

    Ok(r)
end date_rule

/** The rule between `from` and `end` in `b`, refused at the first byte that does not fit the grammar.
 *
 * **A daylight name with no dates after it is refused**, though POSIX lets an implementation supply
 * its own default: the default is the implementation's, so a file relying on one would mean different
 * things to different readers, and `zic` never writes one.
 */
private rule(b: []const u8, from: usize, end: usize) -> Result[TzRule, TzifError]
    var f = Footer(b, from, from, end)
    val unused = DateRule(u8('n'), 0, 0, 0, 0)
    val std_name = zone_name(&f)?
    val std_off = -(clock(&f, 24)?)

    if f.at == f.end
        return Ok(TzRule(std_name, std_off, false, Span(0, 0), std_off, unused, unused))

    val dst_name = zone_name(&f)?
    var dst_off = std_off + 3600

    if peek(&f) != u8(',') then dst_off = -(clock(&f, 24)?)

    expect(&f, u8(','))?
    val start = date_rule(&f)?
    expect(&f, u8(','))?
    val stop = date_rule(&f)?

    if f.at != f.end then return Err(bad(&f))

    Ok(TzRule(std_name, std_off, true, dst_name, dst_off, start, stop))
end rule

/** The day, counted from 1970, on which a date of the rule falls in year `y`. */
private rule_day(r: DateRule, y: int) -> int
    val jan1 = days_from_civil(YearMonthDay(y, 1, 1)).day

    if r.kind == u8('n') then return jan1 + r.n

    if r.kind == u8('J') then return jan1 + r.n - 1 + (if leap_year(y) && r.n >= 60 then 1 else 0)

    // The w-th d-day of the month, where the fifth means the last, which some months have only four of.
    var day = on_or_after(days_from_civil(YearMonthDay(y, r.n, 1)), Weekday(r.day)).day + (r.week - 1) * 7
    val last = days_from_civil(YearMonthDay(y, r.n, days_in_month(y, r.n))).day

    while day > last
        day -= 7

    day
end rule_day

/** What the zone's clocks read at `secs` by the footer's rule.
 *
 * **The year is the one standard time is in**, and both changes are worked out in it: the start is
 * stated in standard time and the end in daylight time, so each is taken back to UTC by its own
 * offset. Where the start comes after the end in the year, daylight saving spans the new year -- the
 * southern hemisphere's case -- and is in force outside the interval rather than inside it.
 */
private by_rule(r: TzRule, secs: long) -> Local
    val standard = Local(r.std_off, false, r.std_name)

    if !r.has_dst then return standard

    val y = civil_from_days(Date(int(div_floor(secs + long(r.std_off), 86400)))).year
    val start = long(rule_day(r.start, y)) * 86400 + long(r.start.time) - long(r.std_off)
    val stop = long(rule_day(r.stop, y)) * 86400 + long(r.stop.time) - long(r.dst_off)
    val dst = if start < stop then secs >= start && secs < stop else secs < stop || secs >= start

    if dst then Local(r.dst_off, true, r.dst_name) else standard
end by_rule

// -- lookup -------------------------------------------------------------------------------------------

/** What a zone's clocks read at one instant: seconds east of UTC, whether that is daylight saving, and
 * where the abbreviation is.
 */
private struct Local
    off: int
    dst: bool
    name: Span

private transition(z: Zone, i: usize) -> Result[long, TzifError]
    if z.wide then return i64_at(z.data, z.trans_at + i * 8)

    val narrow = i32_at(z.data, z.trans_at + i * 4)?

    Ok(long(narrow))
end transition

/** Which local time type applies at `secs`, as an index into the type array.
 *
 * **A time before the first transition is the case with a rule of its own.** RFC 8536 says to use the
 * first type that is not daylight saving, and the first type of all where every one of them is -- so
 * a date in 1880, before any zone had a transition to record, reads as that zone's standard time
 * rather than as whatever the first transition happened to leave behind.
 */
private type_index(z: Zone, secs: long) -> Result[usize, TzifError]
    var lo: usize = 0
    var hi = z.timecnt
    var found = false

    // The last transition at or before `secs`. Written as a half-open narrowing rather than with a
    // signed index, because `usize` has no -1 to mean "none" and the flag says it without one.
    while lo < hi
        val mid = lo + (hi - lo) / 2

        if transition(z, mid)? <= secs
            found = true
            lo = mid + 1
        else
            hi = mid

    if found then return Ok(usize(z.data[z.types_at + lo - 1]))

    for k in 0..<z.typecnt
        if z.data[z.ttinfo_at + k * ttinfo_len + 4] == 0 then return Ok(k)

    Ok(0)
end type_index

/** What the clocks read at `secs`: from the footer's rule at or after the last transition, or
 * anywhere in a file that has none, and from the table everywhere else.
 */
private local_at(z: Zone, secs: long) -> Result[Local, TzifError]
    if z.footer_end > z.footer_at && (z.timecnt == 0 || secs >= transition(z, z.timecnt - 1)?)
        return Ok(by_rule(rule(z.data, z.footer_at, z.footer_end)?, secs))

    val k = type_index(z, secs)?
    val at = z.ttinfo_at + k * ttinfo_len
    val off = i32_at(z.data, at)?
    // The designations are one NUL-separated run, and a type names its own by where it starts.
    val start = z.desig_at + usize(z.data[at + 5])

    if start > z.data.len then return Err(Truncated(start))

    var end = start

    while end < z.data.len && z.data[end] != 0
        end += 1

    Ok(Local(off, z.data[at + 4] != 0, Span(start, end - start)))
end local_at

/** How far this zone's clocks were set from UTC at that instant.
 *
 * **This is the rule a `sysl.time.RuledZone` holds**, which is the whole point of it: a zone read from a
 * file, a zone talking to a chip and a zone written out by hand are one thing to everything above.
 */
offset_at(z: Zone, t: Instant) -> Result[Offset, TzifError]
    val local = local_at(z, seconds_of(t))?

    Ok(Offset(local.off / 60))

/** Whether daylight saving was in force at that instant, as the file records it. */
is_dst_at(z: Zone, t: Instant) -> Result[bool, TzifError]
    val local = local_at(z, seconds_of(t))?

    Ok(local.dst)

/** The abbreviation the zone used at that instant -- `EST`, `EDT`, `+0545`.
 *
 * **It is here because the file already carries it**, and it is the one thing a host's `tm_gmtoff`
 * route cannot answer without a second call. It is a display string and nothing else: `CST` names
 * three different offsets around the world, so a timestamp that has to be read back carries the
 * number instead, which is what `timestamp_text` writes.
 */
abbrev_at(z: Zone, t: Instant) -> Result[string, TzifError]
    val span = local_at(z, seconds_of(t))?.name

    from_utf8(z.data[span.at..<span.at + span.len]) match
        Ok(s) -> Ok(s)
        /** The designations are ASCII in every file the database ships, so this is a corrupt one
         * rather than a language question -- and it is reported as the truncation it will look like
         * to whoever is holding the bytes.
         */
        Err(e) -> Err(Truncated(z.data.len))
end abbrev_at

/** The instant as a count of whole seconds, rounding toward minus infinity so that a time before 1970
 * lands in the second it belongs to rather than the one after it.
 */
private seconds_of(t: Instant) -> long =
    if t.us >= 0 then t.us / us_per_second
    else -((-t.us + us_per_second - 1) / us_per_second)
