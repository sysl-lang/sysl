module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.fs.{entries, is_file, make_dir_all, make_temp_dir, read_bytes, remove_dir_all, write_bytes, write_text}
import sysl.process.capture
import sysl.text.{cstring, Search}

// **Every C file a build compiles is compiled once and kept** (`c_object_cache.sysl`). What a case
// observes is the cache's own count of hits and compilations, never a clock, and every case keeps its
// objects in a directory of its own (`use_c_object_cache_dir`) so nothing here reads or leaves an
// entry in the machine's cache.
//
// Two environment variables are part of what is under test -- `SYSL_NO_CACHE` and
// `SYSL_EXTRA_CFLAGS` -- and `sysl.env` deliberately sets nothing, so a case sets them through libc
// and unsets them before it returns.

private extern "setenv" coc_c_setenv(name: *u8, value: *u8, overwrite: int) -> int
private extern "unsetenv" coc_c_unsetenv(name: *u8) -> int

private coc_setenv(name: string, value: string)
    val n = cstring(name)
    val v = cstring(value)

    coc_c_setenv(n.ptr, v.ptr, 1)
end coc_setenv

private coc_unsetenv(name: string)
    val n = cstring(name)

    coc_c_unsetenv(n.ptr)
end coc_unsetenv

// A directory for the case's sources and one for its cache, with the counts cleared.
private coc_begin() -> (string, string)
    val work = absolute_path(make_temp_dir("sysl-coc").unwrap())
    val cache = make_temp_dir("sysl-coc-cache").unwrap()

    use_c_object_cache_dir(Some(cache))
    clear_c_object_counts()
    (work, cache)
end coc_begin

private coc_end(dirs: (string, string))
    use_c_object_cache_dir(None)
    remove_dir_all(dirs.0).unwrap_or(())
    remove_dir_all(dirs.1).unwrap_or(())
end coc_end

private coc_clang() -> string = find_clang(host_target(), None).unwrap()

// `src` compiled into `obj` for the host at `-O1`, with these macros.
private coc_compile(src: string, obj: string, macros: Buf[string] = buf()) -> Result[unit, string] =
    compile_c(coc_clang(), src, obj, host_target(), "1", no_probe(), macros)

private coc_bytes(f: string) -> []u8 = read_bytes(f).unwrap()

private coc_same(a: string, b: string) -> bool
    val x = coc_bytes(a)
    val y = coc_bytes(b)

    if x.len != y.len then return false

    for i in 0..<x.len
        if x[i] != y[i] then return false

    true
end coc_same

private coc_define(d: string) -> Buf[string]
    var out: Buf[string] = buf()

    out.push(d)
    out
end coc_define

// The objects a cache holds.
private coc_objects(cache: string) -> Buf[string]
    var out: Buf[string] = buf()

    entries(s"$cache/sysl/cobj") match
        Err(_) -> ()
        Ok(names) ->
            for i in 0..<names.len()
                if names.at(i).ends_with(".o") then out.push(s"$cache/sysl/cobj/${names.at(i)}")

    out
end coc_objects

@test("a second compilation of an unchanged file reuses the object, byte for byte")
coc_a_second_compile_reuses_the_object()
    if !clang_available() then return

    val dirs = coc_begin()
    val src = s"${dirs.0}/a.c"

    write_text(src, "int coc_a(void) { return 7; }\n").unwrap()
    coc_compile(src, s"${dirs.0}/one.o").unwrap()
    assert_eq(c_object_counts(), (0, 1))

    coc_compile(src, s"${dirs.0}/two.o").unwrap()
    assert_eq(c_object_counts(), (1, 1))
    assert(coc_same(s"${dirs.0}/one.o", s"${dirs.0}/two.o"), "the reused object is the compiled one")
    assert_eq(coc_objects(dirs.1).len(), 1)
    coc_end(dirs)
end coc_a_second_compile_reuses_the_object

@test("an edit to the C file misses")
coc_an_edit_to_the_file_misses()
    if !clang_available() then return

    val dirs = coc_begin()
    val src = s"${dirs.0}/a.c"

    write_text(src, "int coc_a(void) { return 7; }\n").unwrap()
    coc_compile(src, s"${dirs.0}/one.o").unwrap()
    write_text(src, "int coc_a(void) { return 8; }\n").unwrap()
    coc_compile(src, s"${dirs.0}/two.o").unwrap()
    assert_eq(c_object_counts(), (0, 2))
    assert(!coc_same(s"${dirs.0}/one.o", s"${dirs.0}/two.o"), "the edit reached the object")
    coc_end(dirs)
end coc_an_edit_to_the_file_misses

@test("an edit to a header the file includes, two levels down, misses -- and the next build hits again")
coc_an_edit_to_an_included_header_misses()
    if !clang_available() then return

    val dirs = coc_begin()
    val src = s"${dirs.0}/a.c"

    make_dir_all(s"${dirs.0}/inc").unwrap()
    write_text(s"${dirs.0}/inc/deep.h", "#define COC_N 7\n").unwrap()
    write_text(s"${dirs.0}/h.h", "#include \"inc/deep.h\"\n").unwrap()
    write_text(src, "#include \"h.h\"\nint coc_a(void) { return COC_N; }\n").unwrap()
    coc_compile(src, s"${dirs.0}/one.o").unwrap()
    coc_compile(src, s"${dirs.0}/two.o").unwrap()
    assert_eq(c_object_counts(), (1, 1))

    write_text(s"${dirs.0}/inc/deep.h", "#define COC_N 9\n").unwrap()
    coc_compile(src, s"${dirs.0}/three.o").unwrap()
    assert_eq(c_object_counts(), (1, 2))
    assert(!coc_same(s"${dirs.0}/one.o", s"${dirs.0}/three.o"), "the header's edit reached the object")

    coc_compile(src, s"${dirs.0}/four.o").unwrap()
    assert_eq(c_object_counts(), (2, 2))
    assert(coc_same(s"${dirs.0}/three.o", s"${dirs.0}/four.o"), "the new object is the one reused")
    coc_end(dirs)
end coc_an_edit_to_an_included_header_misses

@test("a changed define misses, and the first define hits again")
coc_a_changed_define_misses()
    if !clang_available() then return

    val dirs = coc_begin()
    val src = s"${dirs.0}/a.c"

    write_text(src, "int coc_a(void) { return COC_N; }\n").unwrap()
    coc_compile(src, s"${dirs.0}/one.o", coc_define("COC_N=1")).unwrap()
    coc_compile(src, s"${dirs.0}/two.o", coc_define("COC_N=2")).unwrap()
    assert_eq(c_object_counts(), (0, 2))
    assert(!coc_same(s"${dirs.0}/one.o", s"${dirs.0}/two.o"), "the define reached the object")

    coc_compile(src, s"${dirs.0}/three.o", coc_define("COC_N=1")).unwrap()
    assert_eq(c_object_counts(), (1, 2))
    assert(coc_same(s"${dirs.0}/one.o", s"${dirs.0}/three.o"), "each define keeps its own object")
    coc_end(dirs)
end coc_a_changed_define_misses

@test("a changed flag misses: the optimization level, and SYSL_EXTRA_CFLAGS")
coc_a_changed_flag_misses()
    if !clang_available() then return

    val dirs = coc_begin()
    val src = s"${dirs.0}/a.c"
    val clang = coc_clang()

    write_text(src, "int coc_a(int n) { int s = 0; for (int i = 0; i < n; i++) s += i; return s; }\n").unwrap()
    compile_c(clang, src, s"${dirs.0}/one.o", host_target(), "1", no_probe()).unwrap()
    compile_c(clang, src, s"${dirs.0}/two.o", host_target(), "0", no_probe()).unwrap()
    assert_eq(c_object_counts(), (0, 2))

    coc_setenv("SYSL_EXTRA_CFLAGS", "-DCOC_UNUSED=1")
    compile_c(clang, src, s"${dirs.0}/three.o", host_target(), "1", no_probe()).unwrap()
    coc_unsetenv("SYSL_EXTRA_CFLAGS")
    assert_eq(c_object_counts(), (0, 3))

    compile_c(clang, src, s"${dirs.0}/four.o", host_target(), "1", no_probe()).unwrap()
    assert_eq(c_object_counts(), (1, 3))
    coc_end(dirs)
end coc_a_changed_flag_misses

@test("a different target misses")
coc_a_different_target_misses()
    if !clang_available() then return

    val board = target_named("thumbv6m-freestanding").unwrap()

    val cross = find_clang(board, None) match
        Ok(c) -> c
        Err(_) -> return

    val dirs = coc_begin()
    val src = s"${dirs.0}/a.c"

    write_text(src, "int coc_a(int n) { return n * 3; }\n").unwrap()
    coc_compile(src, s"${dirs.0}/host.o").unwrap()
    compile_c(cross, src, s"${dirs.0}/board.o", board, "1", no_probe()).unwrap()
    assert_eq(c_object_counts(), (0, 2))
    assert(!coc_same(s"${dirs.0}/host.o", s"${dirs.0}/board.o"), "two machines, two objects")

    compile_c(cross, src, s"${dirs.0}/board2.o", board, "1", no_probe()).unwrap()
    assert_eq(c_object_counts(), (1, 2))
    coc_end(dirs)
end coc_a_different_target_misses

@test("SYSL_NO_CACHE=1 compiles afresh, keeps nothing, and makes the same object")
coc_no_cache_compiles_afresh()
    if !clang_available() then return

    val dirs = coc_begin()
    val src = s"${dirs.0}/a.c"

    write_text(src, "int coc_a(void) { return 7; }\n").unwrap()
    coc_compile(src, s"${dirs.0}/cached.o").unwrap()
    clear_c_object_counts()

    coc_setenv("SYSL_NO_CACHE", "1")
    coc_compile(src, s"${dirs.0}/one.o").unwrap()
    coc_compile(src, s"${dirs.0}/two.o").unwrap()
    coc_unsetenv("SYSL_NO_CACHE")

    assert_eq(c_object_counts(), (0, 2))
    assert_eq(coc_objects(dirs.1).len(), 1)
    assert(coc_same(s"${dirs.0}/cached.o", s"${dirs.0}/one.o"),
           "the object the cache keeps is the one an uncached compile makes")
    coc_end(dirs)
end coc_no_cache_compiles_afresh

@test("a truncated or altered cached object is not used: it is recompiled and the build succeeds")
coc_a_corrupt_object_is_not_used()
    if !clang_available() then return

    val dirs = coc_begin()
    val src = s"${dirs.0}/a.c"

    write_text(src, "int coc_a(void) { return 7; }\n").unwrap()
    coc_compile(src, s"${dirs.0}/one.o").unwrap()

    val kept = coc_objects(dirs.1).at(0)
    val whole = coc_bytes(kept)

    write_bytes(kept, whole[0..<whole.len / 2]).unwrap()
    coc_compile(src, s"${dirs.0}/two.o").unwrap()
    assert_eq(c_object_counts(), (0, 2))
    assert(coc_same(s"${dirs.0}/one.o", s"${dirs.0}/two.o"), "the truncated object was not handed on")

    // The same length with one byte changed: only the digest can tell.
    var altered = coc_bytes(kept)

    altered[altered.len - 1] = altered[altered.len - 1] ^ 0xFF
    write_bytes(kept, altered).unwrap()
    coc_compile(src, s"${dirs.0}/three.o").unwrap()
    assert_eq(c_object_counts(), (0, 3))
    assert(coc_same(s"${dirs.0}/one.o", s"${dirs.0}/three.o"), "the altered object was not handed on")

    coc_compile(src, s"${dirs.0}/four.o").unwrap()
    assert_eq(c_object_counts(), (1, 3))
    coc_end(dirs)
end coc_a_corrupt_object_is_not_used

@test("two C files of one name in two packages keep an object each")
coc_one_name_in_two_packages_does_not_collide()
    if !clang_available() then return

    val dirs = coc_begin()
    val a = s"${dirs.0}/one/util.c"
    val b = s"${dirs.0}/two/util.c"

    make_dir_all(s"${dirs.0}/one").unwrap()
    make_dir_all(s"${dirs.0}/two").unwrap()
    write_text(a, "int coc_util(void) { return 1; }\n").unwrap()
    write_text(b, "int coc_util(void) { return 2; }\n").unwrap()
    coc_compile(a, s"${dirs.0}/a1.o").unwrap()
    coc_compile(b, s"${dirs.0}/b1.o").unwrap()
    coc_compile(a, s"${dirs.0}/a2.o").unwrap()
    coc_compile(b, s"${dirs.0}/b2.o").unwrap()

    assert_eq(c_object_counts(), (2, 2))
    assert(coc_same(s"${dirs.0}/a1.o", s"${dirs.0}/a2.o"), "one/util.c got its own object back")
    assert(coc_same(s"${dirs.0}/b1.o", s"${dirs.0}/b2.o"), "two/util.c got its own object back")
    assert(!coc_same(s"${dirs.0}/a1.o", s"${dirs.0}/b1.o"), "the two are different objects")
    coc_end(dirs)
end coc_one_name_in_two_packages_does_not_collide

@test("a whole build's C comes from the cache the second time, and the executable is the same bytes as an uncached build's")
coc_a_build_reuses_its_c_and_links_the_same_executable()
    if !(std_root().is_ok() && clang_available()) then return

    val dirs = coc_begin()

    write_text(s"${dirs.0}/main.sysl", "extern \"coc_seven\" c_seven() -> int\n\nprint(c_seven())\n").unwrap()
    write_text(s"${dirs.0}/seven.c", "int coc_seven(void) { return 7; }\n").unwrap()

    build_native_program(dirs.0, None, None, DefaultOptimization, Some(s"${dirs.0}/first")).unwrap()
    clear_c_object_counts()
    // Both executables share a basename: the linker's ad-hoc signature carries it as the identifier.
    make_dir_all(s"${dirs.0}/cached").unwrap()
    make_dir_all(s"${dirs.0}/uncached").unwrap()
    build_native_program(dirs.0, None, None, DefaultOptimization, Some(s"${dirs.0}/cached/prog")).unwrap()

    val counts = c_object_counts()

    assert(counts.0 >= 1, s"hits ${counts.0}")
    assert_eq(counts.1, 0)

    coc_setenv("SYSL_NO_CACHE", "1")
    build_native_program(dirs.0, None, None, DefaultOptimization, Some(s"${dirs.0}/uncached/prog")).unwrap()
    coc_unsetenv("SYSL_NO_CACHE")

    assert(coc_same(s"${dirs.0}/cached/prog", s"${dirs.0}/uncached/prog"), "a reused object links the same executable")
    coc_end(dirs)
end coc_a_build_reuses_its_c_and_links_the_same_executable

@test("the dependency rule clang writes is read past its target, continuations and escaped spaces")
coc_reads_the_dependency_rule()
    val got = depended_on("/tmp/x.o: /a/x.c /a/my\\ dir/h.h \\\n  /usr/include/stdio.h\n")

    assert_eq(got.len(), 3)
    assert_eq(got.at(0), "/a/x.c")
    assert_eq(got.at(1), "/a/my dir/h.h")
    assert_eq(got.at(2), "/usr/include/stdio.h")
end coc_reads_the_dependency_rule

@test("a relative include directory puts the working directory in the key, and an absolute one does not")
coc_a_relative_include_is_noticed()
    var rel: Buf[string] = buf()

    rel.push("-Iinclude")
    assert(names_relative_directory(rel), "-Iinclude")

    var sep: Buf[string] = buf()

    sep.push("-isystem")
    sep.push("vendor")
    assert(names_relative_directory(sep), "-isystem vendor")

    var abs: Buf[string] = buf()

    abs.push("-I/opt/homebrew/include")
    abs.push("-O1")
    abs.push("-DX=1")
    assert(!names_relative_directory(abs), "all absolute")
end coc_a_relative_include_is_noticed

// Every file in `dir` dated 2020, which is years older than anything a test writes now.
private coc_age(dir: string)
    capture("/bin/sh", ["-c", s"touch -t 202001010000 '$dir'/*"]).unwrap()

// `n` complete entries -- an object and its sidecar -- named `<stem><i>`, with nothing inside them.
private coc_fake_entries(dir: string, stem: string, n: usize)
    for i in 0..<n
        write_text(s"$dir/$stem${i}.o", "x").unwrap()
        write_text(s"$dir/$stem${i}.o.sum", "1:0").unwrap()

@test("eviction keeps what the current build needs, however old, and takes stale entries past the limit")
coc_eviction_keeps_what_the_build_uses()
    if !clang_available() then return

    val dirs = coc_begin()
    val cobj = s"${dirs.1}/sysl/cobj"
    val a = s"${dirs.0}/a.c"
    val b = s"${dirs.0}/b.c"

    write_text(a, "int coc_a(void) { return 1; }\n").unwrap()
    write_text(b, "int coc_b(void) { return 2; }\n").unwrap()
    coc_compile(a, s"${dirs.0}/a1.o").unwrap()

    // a's entry, and a full cache's worth of others, all long past `CacheStale` -- and one fresh entry,
    // which is what `now` is read from.
    coc_fake_entries(cobj, "old", CacheKeep)
    coc_age(cobj)
    coc_fake_entries(cobj, "new", 1)

    coc_compile(a, s"${dirs.0}/a2.o").unwrap()
    assert_eq(c_object_counts(), (1, 1))

    // The miss that keeps b's object is what evicts.
    coc_compile(b, s"${dirs.0}/b1.o").unwrap()
    assert_eq(c_object_counts(), (1, 2))
    assert(!is_file(s"$cobj/old0.o") && !is_file(s"$cobj/old0.o.sum"), "a stale entry is evicted")
    assert(is_file(s"$cobj/new0.o") && is_file(s"$cobj/new0.o.sum"), "a fresh entry is kept")
    assert_eq(coc_objects(dirs.1).len(), 3)

    // a's object was used by this build, so it survived though it is the oldest thing there.
    coc_compile(a, s"${dirs.0}/a3.o").unwrap()
    assert_eq(c_object_counts(), (2, 2))
    coc_end(dirs)
end coc_eviction_keeps_what_the_build_uses

@test("below the limit nothing is evicted for age")
coc_below_the_limit_nothing_is_evicted()
    if !clang_available() then return

    val dirs = coc_begin()
    val cobj = s"${dirs.1}/sysl/cobj"
    val a = s"${dirs.0}/a.c"

    write_text(a, "int coc_a(void) { return 1; }\n").unwrap()
    coc_compile(a, s"${dirs.0}/a1.o").unwrap()
    coc_fake_entries(cobj, "old", 10)
    coc_age(cobj)

    write_text(a, "int coc_a(void) { return 3; }\n").unwrap()
    coc_compile(a, s"${dirs.0}/a2.o").unwrap()
    assert_eq(c_object_counts(), (0, 2))
    assert_eq(coc_objects(dirs.1).len(), 12)
    coc_end(dirs)
end coc_below_the_limit_nothing_is_evicted

@test("a half entry -- an object with no sidecar, or a sidecar with no object -- is removed at any age")
coc_a_half_entry_is_removed()
    if !clang_available() then return

    val dirs = coc_begin()
    val cobj = s"${dirs.1}/sysl/cobj"
    val a = s"${dirs.0}/a.c"
    val b = s"${dirs.0}/b.c"

    write_text(a, "int coc_a(void) { return 1; }\n").unwrap()
    write_text(b, "int coc_b(void) { return 2; }\n").unwrap()
    coc_compile(a, s"${dirs.0}/a1.o").unwrap()

    write_text(s"$cobj/lonely.o", "x").unwrap()
    write_text(s"$cobj/widowed.o.sum", "1:0").unwrap()

    coc_compile(b, s"${dirs.0}/b1.o").unwrap()
    assert(!is_file(s"$cobj/lonely.o"), "an object with no sidecar is removed")
    assert(!is_file(s"$cobj/widowed.o.sum"), "a sidecar with no object is removed")
    assert_eq(coc_objects(dirs.1).len(), 2)

    coc_compile(a, s"${dirs.0}/a2.o").unwrap()
    coc_compile(b, s"${dirs.0}/b2.o").unwrap()
    assert_eq(c_object_counts(), (2, 2))
    coc_end(dirs)
end coc_a_half_entry_is_removed

// The limitation `c_object_cache.sysl` states, shown rather than described: a header added to a
// directory searched ahead of the one the last compilation found it in changes nothing the key reads,
// so the next build hits and links the object made from the header it no longer includes.
// `SYSL_NO_CACHE=1` sees the new one.
@test("a header added ahead of the one found last time is not noticed -- the stated limitation, and its escape hatch")
coc_a_header_added_earlier_on_the_path_is_not_noticed()
    if !clang_available() then return

    val dirs = coc_begin()
    val a = s"${dirs.0}/a.c"

    make_dir_all(s"${dirs.0}/early").unwrap()
    make_dir_all(s"${dirs.0}/late").unwrap()
    write_text(s"${dirs.0}/late/n.h", "#define COC_N 7\n").unwrap()
    write_text(a, "#include <n.h>\nint coc_a(void) { return COC_N; }\n").unwrap()

    coc_setenv("SYSL_EXTRA_CFLAGS", s"-I${dirs.0}/early -I${dirs.0}/late")
    coc_compile(a, s"${dirs.0}/one.o").unwrap()

    write_text(s"${dirs.0}/early/n.h", "#define COC_N 9\n").unwrap()
    coc_compile(a, s"${dirs.0}/two.o").unwrap()
    assert_eq(c_object_counts(), (1, 1))
    assert(coc_same(s"${dirs.0}/one.o", s"${dirs.0}/two.o"), "the object of the header found last time")

    coc_setenv("SYSL_NO_CACHE", "1")
    coc_compile(a, s"${dirs.0}/three.o").unwrap()
    coc_unsetenv("SYSL_NO_CACHE")
    coc_unsetenv("SYSL_EXTRA_CFLAGS")
    assert(!coc_same(s"${dirs.0}/one.o", s"${dirs.0}/three.o"), "with the cache off, the new header is read")
    coc_end(dirs)
end coc_a_header_added_earlier_on_the_path_is_not_noticed
