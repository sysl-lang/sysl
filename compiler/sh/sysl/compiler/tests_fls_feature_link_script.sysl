module sh.sysl.compiler
@tests

import sysl.buf.{Buf, buf}
import sysl.fs.is_file
import sysl.process.capture
import sysl.text.{join, split, Search}
import sysl.testing.skip

// **A target block's keys, set again by a feature** (`target_features.sysl`, `reference/packages.md
// § Linking a freestanding image`): one program built with `--features m7` and with `--features m4`
// is laid out by two scripts; two enabled features setting one key are refused, naming both; a block
// for a feature the package does not declare is refused when the file is read.

private val fls_target: string = "thumb-freestanding"

private fls_manifest(features: string, block: string) -> string =
    s"package { name = \"core\", version = \"0.0.1\" }\nfeatures { $features }\n" +
    s"targets {\n  $fls_target {\n$block  }\n}\n"

// A feature naming the keys it sets in the target the tests build for.
private fls_sets(feature: string, keys: string) -> string = s"$feature { targets.$fls_target { $keys } }"

// The two cores: each feature names its own script, and the target block the M7's by default.
private fls_cores() -> string =
    fls_sets("m7", "linker_script = \"m7.ld\"") + ", " + fls_sets("m4", "linker_script = \"m4.ld\"")

private fls_base() -> string = "    linker_script = \"m7.ld\"\n"

private fls_script(base: string) -> string =
    s"ENTRY(main)\nSECTIONS\n{\n    . = $base;\n    .text : { *(.text .text.*) }\n" +
    "    .rodata : { *(.rodata .rodata.*) }\n    .data : { *(.data .data.*) }\n" +
    "    .bss (NOLOAD) : { *(.bss .bss.*) *(COMMON) }\n}\n"

private val fls_program: string = "@no_os\n\n@export(\"main\")\nprobe_main() -> int = 7\n"

private fls_tree(manifest: string) -> string
    var files = lbr_two("main.sysl", fls_program, "sysl.hocon", manifest)

    files.push(("m7.ld", fls_script("0x08000000")))
    files.push(("m4.ld", fls_script("0x08100000")))
    lbr_tree(files)
end fls_tree

private val fls_readelf: string = "/opt/homebrew/opt/llvm/bin/llvm-readelf"

private fls_lld_present() -> bool = capture("ld.lld", ["--version"], "", [], true) match
    Ok(o) -> o.status.ok()
    Err(_) -> false

// The address `main` sits at in the image `--features <feature>` builds, or what stopped it.
private fls_main_at(p: string, out: string, feature: string) -> string
    reset_feature_request()

    val said = lbr_cli(["sysl", "build", "--target", fls_target, "--features", feature, "-o",
                        s"$out/$feature.elf", p])

    reset_feature_request()

    if said.0 != 0 then return s"refused: ${said.1}"

    val read = capture(fls_readelf, ["-s", s"$out/$feature.elf"], "", [], true).unwrap()

    for line in lines_of(read.text)
        if line.ends_with(" main")
            var words: Buf[string] = buf()

            val parts = split(line, " ")

            for i in 0..<parts.len
                if !parts[i].is_empty() then words.push(parts[i])

            return words.at(1)

    s"no main in: ${read.text}"
end fls_main_at

@test("one program built with --features m7 and --features m4 is laid out by the two scripts")
fls_two_scripts()
    if !lbr_ready() then return
    if !fls_lld_present() then skip("ld.lld is not installed, so no image can be linked")
    if !is_file(fls_readelf) then skip(s"there is no llvm-readelf at $fls_readelf to read the image")

    val p = fls_tree(fls_manifest(fls_cores(), fls_base()))
    val out = lbr_temp("sysl-fls-elf")
    val m7 = fls_main_at(p, out, "m7")
    val m4 = fls_main_at(p, out, "m4")

    lbr_drop([p, out])
    assert(m7.starts_with("0800"), m7)
    assert(m4.starts_with("0810"), m4)
end fls_two_scripts

@test("a feature's block sets only what it names: the entry it leaves alone is the target block's")
fls_layers_over_the_block()
    val m = read_manifest(fls_manifest(fls_sets("m4", "linker_script = \"m4.ld\""),
                                       "    linker_script = \"m7.ld\"\n    entry = \"reset\"\n")).unwrap()

    reset_feature_request()

    val plain = image_for(m, fls_target).unwrap()

    assert_eq(s"${plain.script} ${plain.entry}", "m7.ld reset")

    lbr_cli(["sysl", "build", "/does/not/exist", "--features", "m4"])

    val featured = image_for(m, fls_target).unwrap()

    reset_feature_request()
    assert_eq(s"${featured.script} ${featured.entry}", "m4.ld reset")
end fls_layers_over_the_block

@test("a feature's block reaches every key a target block takes: capabilities and codegen too")
fls_every_key()
    val m = read_manifest(fls_manifest(fls_sets("lean", "capabilities { heap = false }, " +
                                                "codegen { general_regs_only = true }"), "")).unwrap()

    reset_feature_request()

    val before = join(manifest_provides(m, fls_target).view(), ",")
    val regs_before = codegen_given(m, fls_target, "general_regs_only")

    lbr_cli(["sysl", "build", "/does/not/exist", "--features", "lean"])

    val after = join(manifest_provides(m, fls_target).view(), ",")
    val regs_after = codegen_given(m, fls_target, "general_regs_only")

    reset_feature_request()
    assert(before.contains("heap"), before)
    assert(!after.contains("heap"), after)
    assert(!regs_before)
    assert(regs_after)
end fls_every_key

@test("two enabled features setting one key are refused, naming both")
fls_conflict_refused()
    val p = fls_tree(fls_manifest(fls_cores(), fls_base()))

    reset_feature_request()

    val said = lbr_cli(["sysl", "build", "--target", fls_target, "--features", "m7,m4", "-o",
                        s"$p/out.elf", p])

    reset_feature_request()
    lbr_drop([p])
    assert(said.0 != 0)
    assert(said.1.contains(s"the features 'm7' and 'm4' are both on, and both set " +
        s"'targets.$fls_target.linker_script' — 'features.m7.targets.$fls_target' and " +
        s"'features.m4.targets.$fls_target' would each lay out the same key, so turn one of the two " +
        "off, make them a 'choices' group, or set the key in only one of them"), said.1)
end fls_conflict_refused

@test("two features on at once that set different keys are no conflict")
fls_different_keys_agree()
    val m = read_manifest(fls_manifest(fls_sets("a", "linker_script = \"m4.ld\"") + ", " +
                                       fls_sets("b", "entry = \"reset\""), "")).unwrap()

    reset_feature_request()
    lbr_cli(["sysl", "build", "/does/not/exist", "--features", "a,b"])

    val conflict = feature_target_conflict(m, fls_target)
    val img = image_for(m, fls_target).unwrap()

    reset_feature_request()
    assert(conflict.is_none(), conflict.unwrap_or(""))
    assert_eq(s"${img.script} ${img.entry}", "m4.ld reset")
end fls_different_keys_agree

@test("and a conflict in another machine's block is not this build's business")
fls_other_machine_no_conflict()
    val m = read_manifest(fls_manifest(fls_cores(), fls_base())).unwrap()

    reset_feature_request()
    lbr_cli(["sysl", "build", "/does/not/exist", "--features", "m7,m4"])

    val here = feature_target_conflict(m, "aarch64-freestanding")
    val there = feature_target_conflict(m, fls_target)

    reset_feature_request()
    assert(here.is_none())
    assert(there.is_some())
end fls_other_machine_no_conflict

@test("the 0.4.0 spelling is refused, and its fix-it is the feature block that declares the feature")
fls_old_spelling_refused()
    assert_eq(read_manifest(fls_manifest("m7 = []", "    features { m4 { entry = \"x\" } }\n")).unwrap_err(),
              s"'targets.$fls_target.features' is the spelling of 0.4.0, where a target block listed the " +
              "features that changed it — a feature is now one block saying everything it does, so the " +
              s"target block goes inside the feature. Rewrite it as features.m4.targets.$fls_target " +
              s"{ entry = \"x\" }, and drop 'features' from 'targets.$fls_target'")

@test("a feature's targets block shape and its unknown keys are held to the target block's rules")
fls_shape_and_unknown_keys()
    assert_eq(read_manifest(fls_manifest("m4 { targets = 3 }", "")).unwrap_err(),
              "'features.m4.targets' is not a block — it names targets, each with the keys this feature " +
              "sets while it is on, as 'features.m4.targets { thumb-freestanding { linker_script = " +
              "\"m4.ld\" } }'")
    assert_eq(read_manifest(fls_manifest(s"m4 { targets { $fls_target = \"m4.ld\" } }", "")).unwrap_err(),
              s"'features.m4.targets.$fls_target' is not a block — it sets the keys of " +
              s"'targets.$fls_target' this feature changes, as 'linker_script = \"m4.ld\"'")
    assert_eq(read_manifest(fls_manifest(fls_sets("m4", "linker_script = 4"), "")).unwrap_err(),
              s"'features.m4.targets.$fls_target.linker_script' names the linker script this target's " +
              "image is laid out by, as a path relative to sysl.hocon, so it is a non-empty string — " +
              "not a number, a block or a list")

    val m = read_manifest(fls_manifest(fls_sets("m4", "linker_scrpt = \"m4.ld\""), "")).unwrap()

    assert_eq(join(m.warnings.view(), "\n"),
              s"sysl.hocon: 'features.m4.targets.$fls_target.linker_scrpt' is not something this sysl " +
              "understands, and is ignored — either it is a misspelling, or it was added by a newer compiler")

@test("a dependency's feature block setting an image key is refused as its target block's would be")
fls_dependency_refused()
    if !lbr_ready() then return

    val dep = lbr_tree(lbr_two("dep/dep.sysl", "module dep\n\none() -> int = 1\n", "sysl.hocon",
        "package { name = \"dep\" }\n" +
        s"features { ${fls_sets("m4", "linker_script = \"m4.ld\"")} }\n"))
    val p = lbr_tree(lbr_two("main.sysl", "print(dep.one())\n", "sysl.hocon",
                             "package { name = \"app\" }\n"))
    val said = lbr_cli(["sysl", "emit-llvm", p, "--lib", dep])

    lbr_drop([dep, p])
    assert(said.0 != 0, "a dependency's feature block naming a linker script was accepted")
    assert(said.1.contains(s"sets 'features.m4.targets.$fls_target.linker_script' in its sysl.hocon"),
           said.1)
    assert(said.1.contains("Only the root project's sysl.hocon may name them"), said.1)
end fls_dependency_refused
